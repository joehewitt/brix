    (throw (call Panic "A body gave a return type other than the one its header promised") (if (and promises (!= (. ([] (. instances signatures) instance) returns) promised))))
    (blank)
    (call demand-materialized declaration)
    (if in-zone-body
      (call leave-region)
    )
    (call close)
  )
  (fn-do _ check-forwarder _
    (param effect U32)
    ; A door typed under a `do with` that binds a fake to its effect, which calls the fake's method in
    ; place of its body (`Calls.answer-door`).
    (let declared (if-expr (!= declared-return no-type) declared-return (. types void-type)))
    (call (. instances set-returns) instance declared declared .return-declared)
    (call (. calls answer-door) (. frame decl) effect declared)
    (call finish-errors frame)
    (call close)
  )
  (fn-do _ member-type TypeId
    (param owner TypeId)
    (param name Atom)
    (return-if no-type (if (or (== owner no-type) (== owner invalid-type))))
    (blank)
    (let found (call property-named owner name))
    (return-if no-type (if (not found)))
    (blank)
    (let property ([] (. types properties) found))
    (return (if-expr (!= (. property type) no-type) (. property type) (call demand-member property owner name)))
  )
  (fn-do _ check-retest _
    (param clause SyntaxId)
    ; The function a live action runs to test a `whenever` clause again, as the reference compiles
    ; it: the clause's value typed again as the body of a closure that answers nothing, and the
    ; broadcaster's `subscribe` and `unsubscribe`, each given the subscription made where the loop
    ; is written, kept apart from the calls of the clause's nodes (`facts.whenever-calls`). Their
    ; errors are given to the global `unhandled-error` where they are raised (`hands-off-raising`). Where
    ; an object owns the subscription, the tracker kept there is converted to a `Tracker` at the
    ; clause instead, to be added to the trackers of the action that runs the function.
    (call prepare)
    (call (. instances set-returns) instance (. types void-type) (. types void-type) .return-declared)
    (let resolution (call (. bindings resolution-of) (. frame binding) clause))
    (let passed (call infer (call (. tree clause-expr) clause)))
    (let owns (!= (call (. facts owned-subscription-of) (. ([] (. instances rows) instance) enclosing) clause) null))
    (if (or (!= passed (. types bool-type)) (!= (. resolution kind) .resolve-slot))
      (call decline clause)
      (else-if owns
        (let tracker (call (. types well-known-type) "core/tracker" "Tracker"))
        (call demand-live-runtime)
        (if (or (== tracker invalid-type) (== (. instances live add-tracker) no-instance))
          (call decline clause)
          (else
            (call (. conversions convert)
              (block
                (arg clause)
                (arg clause)
                (arg (call (. frame slot-type) (+ (. resolution slot) 1)))
                (arg tracker)
                (arg .reason-argument)
              )
            )
            (+= (. facts whenever-calls) (call WheneverCalls instance true))
          )
        )
      )
      (else
        (let subscription (call (. frame slot-type) (+ (. resolution slot) 1)))
        (let stream (call (. frame slot-type) (+ (. resolution slot) 2)))
        (let subscribable (call (. types well-known-type-of) "core/stream" "Subscribable" (call first-arg stream)))
        (if (== subscribable invalid-type)
          (call decline clause)
          (else
            (call (. conversions convert) clause clause subscription subscribable .reason-argument)
            (let adds
              (call (. calls protocol-call)
                (block
                  (arg stream)
                  (arg (call (. program store-atom) "subscribe"))
                  (arg clause)
                  (arg subscribable)
                  (arg false)
                  (arg no-type)
                  (arg no-type)
                  (arg false)
                )
              )
            )
            (let drops
              (call (. calls protocol-call)
                (block
                  (arg stream)
                  (arg (call (. program store-atom) "unsubscribe"))
                  (arg clause)
                  (arg subscribable)
                  (arg false)
                  (arg no-type)
                  (arg no-type)
                  (arg false)
                )
              )
            )
            (if (or untyped-calls no-facts (not (call hands-off-raising (. adds fact))) (not (call hands-off-raising (. drops fact))))
              (call decline clause)
              (else
                (+= (. facts whenever-calls) (call WheneverCalls instance false (. adds fact) (. drops fact)))
              )
            )
            (lazy untyped-calls (or (== (. adds answer) invalid-type) (== (. drops answer) invalid-type)))
            (lazy no-facts (or (== (. adds fact) no-fact) (== (. drops fact) no-fact)))
          )
        )
      )
    )
    (call finish-errors frame)
    (call close)
  )
  (fn-do _ check-filler _
    (param declaration CheckedDecl)
    ; The function that fills an object with the markup written in its class. It runs the function of
    ; the class above, where that class or one above it writes markup, and then each line of its own
    ; class's markup as content of the object: a line that gives a value is taken by the object's `+=`,
    ; or else its `++=`, as a line of an element's body is. The lines of a root `<This` that assign are
    ; no lines of it: each is the first value of a property; nor are the lines of the class's `• This`
    ; that are the rule's own, where its other lines are the markup (`rule-lines`). Without a root, a
    ; line that assigns is a statement, as one in a function is, unless a class above writes markup: the
    ; reference takes it then for an attribute it drops, and it is declined. Where the markup of a class
    ; above holds slot outlets, its function is given a builder for each slot this one was given one
    ; for, and for each the lines of its own markup give, as an element's lines give the slots of its
    ; class (`supply-slots`), but those this one was given, which win; where it holds the default
    ; outlet, the lines that give the default slot are no lines of this markup, and are dropped where
    ; this one was given that slot. A line that gives a slot of a class above none of whose markup holds
    ; outlets is declined. It answers nothing and raises nothing: an error that leaves it is given to
    ; `unhandled-error`, as the reference gives it (see `hands-off`). Lines with no shape here are
    ; declined, and so is the markup of a class whose lines are linked neither by its own `+=` and `++=`
    ; nor through the markup protocol, but where a class above holds the default slot, which takes them.
    ; The rules of its own class that wait for the markup run after the lines, so it may panic where
    ; there are any, and a `when` or `whenever` rule among them gives the object a live action
    ; (`own-markup-actions`). Its markup sees the styles and style sheets of the markup that made the
    ; object, with its class's (`load-context`), and so does that of the class above. A class whose
    ; markup is only state machines the object keeps needs no way to take lines. A state machine written
    ; beside a root `<This` runs where it is written among the root's lines, as the reference runs it.
    (call prepare)
    (call (. instances set-returns) instance (. types void-type) (. types void-type) .return-declared)
    (let receiver (. frame self-type))
    (let site (call owner-syntax))
    (if (call clashes-element receiver (. declaration syntax))
      (call finish-errors frame)
      (call close)
      (return)
    )
    (if (not (call load-context receiver site))
      (call finish-errors frame)
      (call close)
      (return)
    )
    (let ref (call class-ref types receiver))
    (let owner ([] (. program modules) (. ref module)))
    (= live-owned false)
    (for (in part (call sheet-parts ref))
      (let written ([] (. program modules) (. part module)))
      (for (in member ([] (. written member-pool) (call part-members part)))
        (match? ([] (. written decls) member)
          (case (call .decl-rule rule)
            (if (call waits-for-markup receiver (. part module) (. rule syntax))
              (call (. instances mark-may-panic) instance)
              (if (call (. written tree is-live-rule) (. rule syntax))
                (= live-owned true)
              )
            )
          )
        )
      )
    )
    (call own-markup-actions receiver site)
    (let base (?? (call (. types base-of) receiver) no-type))
    (let given (and (!= base no-type) (call holds-slot base)))
    (let own (and (call is-markup-host receiver) (not given)))
    (if (and takes-nothing (not own) (not given) (not (call only-machines (. declaration body))))
      (call decline site)
      (call finish-errors frame)
      (call close)
      (return)
    )
    (lazy takes-nothing (and (not (call takes-lines receiver)) (not (call takes-hosted receiver))))
    (let above (and (!= base no-type) (call writes-content base)))
    (let body (. declaration body))
    (let rooted (!= (call (. tree root-this) (. frame declaration syntax)) 0))
    (let ruled (is ([] (. tree nodes) (. frame declaration syntax)) .node-rule-syntax))
    (let dropped (if-expr (and above (not rooted) (not ruled)) (call (. tree assigning-line) body) 0u32))
    (let lines (list SyntaxId))
    (if (call wraps-default body)
      (+= lines body)
    )
    (match? ([] (. tree nodes) body)
      (case (call .node-block block)
        (for (in statement ([] (. tree children) (. block body)))
          (if (call binds-slot statement)
            (+= lines statement)
          )
        )
      )
    )
    (let names (list Atom))
    (let wanted (list TypeId))
    (let items (list TypeId))
    (let slots (list Atom))
    (let builders (list TypeId))
    (if (not (call hold-builders receiver site))
      (call finish-errors frame)
      (call close)
      (return)
    )
    (if (and above (call holds-outlets base))
      (let reported (. facts diagnostics length))
      (if (not (call class-outlets base names wanted items))
        (if (== (. facts diagnostics length) reported)
          (call decline site)
        )
        (call finish-errors frame)
        (call close)
        (return)
      )
      (if (and (!= (call (. names find) (call (. program store-atom) "")) null) (call gives-default body ruled))
        (call decline body)
        (call finish-errors frame)
        (call close)
        (return)
      )
      (for (in name names)
        (let argument (call (. instances slot-argument) instance name))
        (if (!= argument (. U32 max))
          (call add-slot name (call (. instances argument-type) instance argument) slots builders)
        )
      )
      (let styles (list TypeId))
      (if (call (. program module-by-name) "core/style")
        (for (in style markup-styles)
          (+= styles style)
        )
        (if (not (call add-visible-styles base styles site))
          (call finish-errors frame)
          (call close)
          (return)
        )
      )
      (let sheets (list TypeId))
      (let levels (list U32))
      (call visible-sheets base sheets levels)
      (let scopes (list ScopeUse))
      (let scoped (and (call scoping-any) (call scopes-known)))
      (for (in position (..< 0 incoming-scopes))
        (+= scopes ([] rule-scopes position))
      )
      (if (and scoped (not (call base-scopes receiver base scopes site)))
        (call finish-errors frame)
        (call close)
        (return)
      )
      (if (not (call give-lines lines names wanted items styles sheets levels slots builders base scopes scoped true))
        (call finish-errors frame)
        (call close)
        (return)
      )
      (else-if (!= (. lines length) 0)
        (call decline ([] lines 0))
        (call finish-errors frame)
        (call close)
        (return)
      )
    )
    (if above
      (let call (call (. calls filler-call) base site slots builders (call content-context)))
      (if (== call no-fact)
        (call decline site)
        (else
          (call (. facts note-filler) instance call)
          (call (. conversions convert) site site receiver base .reason-receiver)
        )
      )
    )
    (let defaulted (!= (call (. names find) (call (. program store-atom) "")) null))
    (let beside
      (scope (+ (. (call (. tree root-machines) (. frame declaration syntax) false) length) machines-after)
        (lazy machines-after (. (call (. tree root-machines) (. frame declaration syntax) true) length))
      )
    )
    (if (and (!= beside 0) (or defaulted (and (== body 0) given)))
      (call decline site)
    )
    (if (or (!= body 0) (and (!= beside 0) (not defaulted) (not given)))
      (if (and (!= dropped 0) (call (. tree binds-line) dropped))
        (call misplaced-binding dropped)
        (else-if (!= dropped 0)
          (call decline dropped)
        )
        (else-if defaulted
          (match? ([] (. tree nodes) body)
            (case (call .node-block block)
              (for (in statement ([] (. tree children) (. block body)))
                (if (or (not ruled) (not (call (. tree rule-part) statement)))
                  (call (. facts note-content-link)
                    (block
                      (arg (call ContentLink instance statement receiver no-type no-fact))
                    )
                  )
                )
              )
            )
          )
        )
        (else-if (or given (not (call is-plain-body body rooted ruled)))
          (if (!= (call (. tree binding-line) body) 0)
            (call misplaced-binding (call (. tree binding-line) body))
            (else
              (call decline body)
            )
          )
        )
        (else
          (let bodied (and (!= body 0) (or rooted (!= (. lines length) 0))))
          (+= content-blocks body)
          (+= content-parents receiver)
          (if bodied
            (+= element-bodies body)
          )
          (= rule-lines (if-expr ruled body 0))
          (for (in machine (call (. tree root-machines) (. frame declaration syntax) false))
            (call check-statement machine)
          )
          (if (!= body 0)
            (call check-statement body)
          )
          (for (in machine (call (. tree root-machines) (. frame declaration syntax) true))
            (call check-statement machine)
          )
          (= rule-lines 0)
          (call (. content-blocks pop))
          (call (. content-parents pop))
          (if bodied
            (call (. element-bodies pop))
          )
        )
      )
    )
    (call hand-off-outgoing site)
    (call finish-errors frame)
    (call close)
  )
  (fn-do _ hand-off-outgoing _
    (param site SyntaxId)
    ; Gives what leaves the function being checked to the global `unhandled-error` (see
    ; `hands-off`), as the reference's function that fills an object with the markup of its class
    ; does, and its function a live action runs a statement again with: the function raises nothing,
    ; and each call that lets errors out lets them out to where they are given, a call whose
    ; callee's errors are not yet known too.
    (if (== (. (call (. scratch outgoing since) (. frame outgoing-start)) length) 0)
      (return)
    )
    (if (not (call hands-off instance))
      (call decline site)
    )
    (for (in row (call (. scratch outgoing since) (. frame outgoing-start)))
      (if (!= (. row call) (. U32 max))
        (= (. ([] (. facts calls) (. row call)) propagates) true)
      )
    )
    (call (. scratch outgoing rewind) (. frame outgoing-start))
  )
  (fn-do _ only-machines Bool
    (param body SyntaxId)
    ; Whether each line of the markup of the class whose object the function being checked fills
    ; is a state machine the object keeps, and there is one.
    (let content (. frame declaration syntax))
    (let machines (call (. tree content-machines) content))
    (match? ([] (. tree nodes) body)
      (case (call .node-block block)
        (for (in statement ([] (. tree children) (. block body)))
          (if (and (call (. tree runs-line) content statement) (== (call (. machines find) statement) null))
            (return false)
          )
        )
        (return (!= (. machines length) 0))
      )
    )
    (return false)
  )
  (fn-expr _ kept-machine Bool
    (param line SyntaxId)
    ; Whether a line is a state machine written in the markup of the class whose object the
    ; function being checked fills, which the object keeps.
    (and (. frame declaration is-content) (!= (call (. (call (. tree content-machines) (. frame declaration syntax)) find) line) null))
  )
  (fn-do _ misplaced-binding _
    (param line SyntaxId)
    (let outlet (is ([] (. tree nodes) (call (. tree attribute-element) line)) .node-slot-outlet))
    (let message (if-expr outlet "A slot outlet cannot bind with \"<->\", since what fills the slot is made elsewhere; bind the property in the element that fills it" "\"<->\" binds a property of a markup element to a place, so it is written in the element's body; to store a value here, write \"=\""))
    (call (. frame diagnose) line .stated (call (. program store-atom) message))
  )
  (fn-do _ demand-filler _
    (param receiver TypeId)
    (param site SyntaxId)
    ; A constructor of a class that writes markup, or is below one that does, runs the function
    ; that fills the object once its own body has: the call is kept for the constructor. The
    ; function is given the builder of each slot the constructor is given one for, which it passes
    ; on, but the function that gives an element's name its object, which the constructor runs
    ; itself, and for the styles and style sheets the constructor is made for.
    (if (or (== receiver no-type) (== receiver invalid-type) (!= (call (. types intrinsic-of) receiver) .class))
      (return)
    )
    (if (not (call writes-content receiver))
      (return)
    )
    (let slots (list Atom))
    (let builders (list TypeId))
    (let given (. ([] (. instances rows) instance) slots count))
    (let first (- (. ([] (. instances signatures) instance) args count) given))
    (let passed (if-expr (call (. instances takes-binder) instance) (- given 1) given))
    (for (in offset (..< 0 passed))
      (+= slots (call (. instances slot-name) instance offset))
      (+= builders (call (. instances argument-type) instance (+ first offset)))
    )
    (let call (call (. calls filler-call) receiver site slots builders (. ([] (. instances rows) instance) context)))
    (if (== call no-fact)
      (call decline site)
      (return)
    )
    (call (. facts note-filler) instance call)
    (call defer-values receiver)
  )
  (fn-do _ runs-later Bool
    (param id SyntaxId)
    ; Whether a node is written in the body of a `whenever` rule of a class on a value, which the
    ; reference runs only where the value changes, never in the run the constructor makes, which
    ; takes the value alone: a member read there is read as it is, as the reference reads it.
    (let unit ([] (. instances rows) instance))
    (if (== (. unit initializer) 0)
      (return false)
    )
    (let tree (. ([] (. program modules) (. unit module)) tree))
    (match? ([] (. ([] (. program modules) (. unit module)) decls) (. unit initializer))
      (case (call .decl-rule row)
        (match? ([] (. tree nodes) (. row syntax))
          (case (call .node-whenever-rule-syntax rule)
            (if (or (!= (. rule kind text) "value") (== (. rule body) 0))
              (return false)
            )
            (return (and (<= (call (. tree subtree-start) (. rule body)) id) (<= id (. rule body))))
          )
        )
      )
    )
    (return false)
  )
  (fn-do _ keeps-whole Bool
    (param name Atom)
    ; Whether a name is the whole value a `whenever` rule of a class keeps. The reference runs such
    ; a rule from the constructor, before the markup has, where an element not yet made reads as no
    ; object, and runs its body only once the element is written, so the rule may read that one.
    (let unit ([] (. instances rows) instance))
    (if (== (. unit initializer) 0)
      (return false)
    )
    (let tree (. ([] (. program modules) (. unit module)) tree))
    (match? ([] (. ([] (. program modules) (. unit module)) decls) (. unit initializer))
      (case (call .decl-rule row)
        (match? ([] (. tree nodes) (. row syntax))
          (case (call .node-whenever-rule-syntax rule)
            (match? ([] (. tree nodes) (. rule expr))
              (case (call .node-identifier read)
                (return (== (. read name) name))
              )
            )
          )
        )
      )
    )
    (return false)
  )
  (fn-do _ constructor-events (list NamedEvent)
    (param receiver TypeId)
    (param chain (list TypeId))
    ; Each event of the object itself that a loop in the body of a constructor of a class of the
    ; chain subscribes to, outside the functions written there.
    (let heard (list NamedEvent))
    (for (in holder chain)
      (let ref (call class-ref types holder))
      (let owner ([] (. program modules) (. ref module)))
      (let tree (. owner tree))
      (match? ([] (. owner decls) (. ref decl))
        (case (call .decl-class class)
          (for (in member ([] (. owner member-pool) (. class members)))
            (match? ([] (. owner decls) member)
              (case (call .decl-function fn)
                (if (or (!= (. fn kind) .constructor-decl) (. fn is-generated) (== (. fn body) 0))
                  (continue)
                )
                (let floor (call (. tree subtree-start) (. fn body)))
                (let node (+ (. fn body) 1))
                (while (> node floor)
                  (-= node 1)
                  (match? ([] (. tree nodes) node)
                    (case .node-function-syntax
                      (= node (call (. tree subtree-start) node))
                    )
                    (case (call .node-for-block block)
                      (match? ([] (. tree nodes) (. block loop))
                        (case (call .node-loop-syntax loop)
                          (if (. loop is-subscriber)
                            (let found
                              (call own-event
                                (block
                                  (arg receiver)
                                  (arg (. ref module))
                                  (arg (. loop container))
                                )
                              )
                            )
                            (if found
                              (+= heard found)
                            )
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
    (return heard)
  )
  (fn-do _ section-loop SyntaxId
    (param module ModuleId)
    (param syntax SyntaxId)
    ; The loop a section of a class writes, or none.
    (let tree (. ([] (. program modules) module) tree))
    (match? ([] (. tree nodes) syntax)
      (case (call .node-subscriber-syntax section)
        (return (. section iterator))
      )
    )
    (return 0)
  )
  (fn-do _ section-event (? NamedEvent)
    (param receiver TypeId)
    (param module ModuleId)
    (param syntax SyntaxId)
    ; The event of the object itself a section of a class subscribes to in a loop of one header,
    ; or none.
    (let tree (. ([] (. program modules) module) tree))
    (let iterator (call section-loop module syntax))
    (if (== iterator 0)
      (return null)
    )
    (match? ([] (. tree nodes) iterator)
      (case (call .node-for-block block)
        (if (!= (. block next) 0)
          (return null)
        )
        (match? ([] (. tree nodes) (. block loop))
          (case (call .node-loop-syntax loop)
            (if (and (. loop is-subscriber) (== (. loop next) 0) (!= (. loop container) 0))
              (return (call own-event receiver module (. loop container)))
            )
          )
        )
      )
    )
    (return null)
  )
  (fn-do _ own-event (? NamedEvent)
    (param receiver TypeId)
    (param module ModuleId)
    (param container SyntaxId)
    ; The event of the object itself a container names: its name alone, read from `this`, or read
    ; from the class that declares an event that bubbles.
    (let tree (. ([] (. program modules) module) tree))
    (match? ([] (. tree nodes) container)
      (case (call .node-identifier row)
        (return (call event-of receiver (. row name) true))
      )
      (case (call .node-get-expression get)
        (match? ([] (. tree nodes) (. get object))
          (case (call .node-identifier row)
            (if (== (. row name text) "this")
              (return (call event-of receiver (. get name) true))
            )
          )
          (case .node-type-identifier
            (return (call bubbling-event-of receiver module tree (. get object) (. get name)))
          )
          (case .node-type-arguments
            (return (call bubbling-event-of receiver module tree (. get object) (. get name)))
          )
        )
      )
    )
    (return null)
  )
  (fn-do _ bubbling-event-of (? NamedEvent)
    (param receiver TypeId)
    (param module ModuleId)
    (param tree AST)
    (param written SyntaxId)
    (param name Atom)
    ; The event a class written in a section of `receiver`'s class declares, where it bubbles: one
    ; that is not private and is published by no key.
    (let declarer invalid-type)
    (match? ([] (. types rows) receiver)
      (case (call .type-class row)
        (let env (call (. types class-env-for) (. row module) (. row decl) (. row args) receiver))
        (= declarer (call (. types evaluate-type) module tree written env))
        (call (. types env-release) env)
      )
    )
    (if (or (== declarer invalid-type) (== declarer no-type))
      (return null)
    )
    (if (and (!= (call (. types intrinsic-of) declarer) .class) (!= (call (. types intrinsic-of) declarer) .interface))
      (return null)
    )
    (let found (call event-of declarer name true))
    (if (or (not found) (. found is-private) (!= (. found key) no-type))
      (return null)
    )
    (return found)
  )
  (fn-do _ query-type TypeId
    (param ref DeclRef)
    (param written SyntaxId)
    (param level TypeId (= no-type))
    ; The type a class writes for a property where it queries the markup an object is in,
    ; `Ancestor'T` or `Descendants'T` of the markup runtime with one argument, or no type: for the
    ; parameters a `level` of the class with type parameters gives it, where one is given.
    (match ([] (. ([] (. program modules) (. ref module)) tree nodes) written)
      (case .node-type-arguments)
      (default
        (return no-type)
      )
    )
    (let owner ([] (. program modules) (. ref module)))
    (let env (call (. types class-env) (. ref module) (. ref decl)))
    (if (!= level no-type)
      (match? ([] (. types rows) level)
        (case (call .type-class row)
          (if (!= (. row args count) 0)
            (call (. types env-release) env)
            (= env (call (. types class-env-for) (. row module) (. row decl) (. row args) level))
          )
        )
      )
    )
    (let type (call (. types evaluate-type) (. ref module) (. owner tree) written env))
    (call (. types env-release) env)
    (match? ([] (. types rows) type)
      (case (call .type-class row)
        (if (and (== (. row args count) 1) (or ancestor-query descendant-query))
          (return type)
        )
        (lazy ancestor-query (call (. types ancestor-decl refers-to) (. row module) (. row decl)))
        (lazy descendant-query (call (. types descendants-decl refers-to) (. row module) (. row decl)))
      )
    )
    (return no-type)
  )
  (fn-do _ query-target TypeId
    (param query TypeId)
    ; The class a query of the markup an object is in looks for: its one argument.
    (match? ([] (. types rows) query)
      (case (call .type-class row)
        (return (call (. types child-type) (. row args) 0))
      )
    )
    (return no-type)
  )
  (fn-do _ note-open-targets _
    (param ref DeclRef)
    (param members (of RowRange DeclId))
    ; Notes the classes a class with type parameters may look for among the descendants of its markup
    ; host once typing makes it for some (`note-class-targets`): the class of each `Descendants'T` it
    ; declares and of each `whenever children T` and `whenever descendants T` rule it writes, or any
    ; class, where `T` is not a class.
    (let owner ([] (. program modules) (. ref module)))
    (let env (call (. types class-env) (. ref module) (. ref decl)))
    (for (in member ([] (. owner member-pool) members))
      (let target no-type)
      (match? ([] (. owner decls) member)
        (case (call .decl-property property)
          (let query
            (scope (if-expr typed (call query-type ref (. property type-syntax)) no-type)
              (lazy typed (!= (. property type-syntax) 0))
            )
          )
          (if (and (!= query no-type) (not (call is-ancestor-query query)))
            (= target (call query-target query))
          )
        )
        (case (call .decl-rule rule)
          (match? ([] (. owner tree nodes) (. rule syntax))
            (case (call .node-whenever-rule-syntax written)
              (if (or (== (. written kind text) "children") (== (. written kind text) "descendants"))
                (= target
                  (call (. types evaluate-type)
                    (block
                      (arg (. ref module))
                      (arg (. owner tree))
                      (arg (. written target-type))
                      (arg env)
                    )
                  )
                )
              )
            )
          )
        )
      )
      (if (or (== target no-type) (== target invalid-type))
        (continue)
      )
      (if (== (call (. types intrinsic-of) target) .class)
        (let key (. (call class-ref types target) key))
        (if (== (call (. caches open-targets find) key) null)
          (+= (. caches open-targets) key)
        )
        (else
          (= (. caches opens-any-target) true)
        )
      )
    )
    (call (. types env-release) env)
  )
  (fn-do _ note-class-targets _
    (param receiver TypeId)
    ; Numbers, after those of the program (`find-query-targets`), the classes each class of an
    ; object with type parameters looks for among the descendants of its markup host, for the
    ; parameters the object's class gives it, base first: those of the properties it declares as
    ; `Descendants'T`, then of its `whenever children T` and `whenever descendants T` rules, as the
    ; reference numbers them when it first makes the class for those parameters, before any of its
    ; objects is made.
    (call find-query-targets)
    (let chain (list TypeId))
    (let level (? TypeId) receiver)
    (while (and level (== (call (. types intrinsic-of) level) .class))
      (+= chain level)
      (= level (call (. types base-of) level))
    )
    (for (in position (..< 0 (. chain length)))
      (let current ([] chain (- (. chain length) 1 position)))
      (match? ([] (. types rows) current)
        (case (call .type-class row)
          (let owner ([] (. program modules) (. row module)))
          (match? ([] (. owner decls) (. row decl))
            (case (call .decl-class class)
              (if (!= (. class type-args count) 0)
                (let ref (call DeclRef (. row module) (. row decl)))
                (for (in member ([] (. owner member-pool) (. class members)))
                  (match? ([] (. owner decls) member)
                    (case (call .decl-property property)
                      (let query
                        (block
                          (case? (!= (. property type-syntax) 0)
                            (call query-type ref (. property type-syntax) current)
                          )
                          (default
                            no-type
                          )
                        )
                      )
                      (let target
                        (scope (if-expr descends (call query-target query) no-type)
                          (lazy descends (and (!= query no-type) (not (call is-ancestor-query query))))
                        )
                      )
                      (if (and (!= target no-type) (== (call (. facts query-targets find) target) null))
                        (+= (. facts query-targets) target)
                      )
                    )
                  )
                )
                (let env (call (. types class-env-for) (. row module) (. row decl) (. row args) current))
                (for (in member ([] (. owner member-pool) (. class members)))
                  (match? ([] (. owner decls) member)
                    (case (call .decl-rule rule)
                      (let target (call rule-target (. row module) (. rule syntax) env))
                      (if (and (!= target no-type) (== (call (. facts query-targets find) target) null))
                        (+= (. facts query-targets) target)
                      )
                    )
                  )
                )
                (call (. types env-release) env)
              )
            )
          )
        )
      )
    )
  )
  (fn-do _ register-queries _
    (param receiver TypeId)
    (param site SyntaxId)
    ; The registrations a constructor makes once the rules of each class of its object have run,
    ; base first, as the reference makes them: each query of the markup the object is in that the
    ; class declares a property for (`markup-query`), given to the markup runtime's
    ; `register-markup-ancestor-query` or `register-markup-descendants-query` with the object as
    ; its host, then, where the class is a markup host that a descendant query may look for
    ; (`may-be-target`), the object as a target of each one whose target is the class or one above
    ; it (`register-markup-descendant-target`), which program tables find once typing has numbered
    ; them all. Each may panic.
    (if (or (== receiver no-type) (== receiver invalid-type) (!= (call (. types intrinsic-of) receiver) .class))
      (return)
    )
    (let markup (. types markup-host-decl))
    (if (and (== (. markup module) 0) (== (. markup decl) 0))
      (return)
    )
    (call find-query-targets)
    (let chain (list TypeId))
    (let level (? TypeId) receiver)
    (while (and level (== (call (. types intrinsic-of) level) .class))
      (+= chain level)
      (= level (call (. types base-of) level))
    )
    (for (in position (..< 0 (. chain length)))
      (let current ([] chain (- (. chain length) 1 position)))
      (let ref (call class-ref types current))
      (let owner ([] (. program modules) (. ref module)))
      (match? ([] (. owner decls) (. ref decl))
        (case (call .decl-class class)
          (for (in member ([] (. owner member-pool) (. class members)))
            (match? ([] (. owner decls) member)
              (case (call .decl-property property)
                (let query
                  (block
                    (case? (!= (. property type-syntax) 0)
                      (call query-type ref (. property type-syntax) current)
                    )
                    (default
                      no-type
                    )
                  )
                )
                (if (!= query no-type)
                  (let index
                    (call markup-query
                      (block
                        (arg current)
                        (arg query)
                        (arg site)
                        (arg (. ref module))
                        (arg (. property syntax))
                        (arg (. property name))
                      )
                    )
                  )
                  (if (or (== index (. U32 max)) (not (call register-query receiver current index site)))
                    (return)
                  )
                )
              )
            )
          )
        )
      )
      (if (and (call is-markup-host current) (call may-be-target current))
        (if (not (call register-target receiver current site))
          (return)
        )
      )
    )
  )
  (fn-do _ may-be-target Bool
    (param level TypeId)
    ; Whether a descendant query may look for a class or one above it: one the program numbers
    ; before typing (`find-query-targets`), or one a class with type parameters may number as typing
    ; makes it for some (`note-open-targets`). Each class a class with type parameters may number is
    ; noted before typing, so this does not depend on the order instances are typed in.
    (return-if true (if (. caches opens-any-target)))
    (blank)
    (let held (? TypeId) level)
    (while (and held (== (call (. types intrinsic-of) held) .class))
      (return-if true (if (!= (call (. facts query-targets find) held) null)))
      (return-if true (if (!= (call (. caches open-targets find) (. (call class-ref types held) key)) null)))
      (blank)
      (= held (call (. types base-of) held))
    )
    (return false)
  )
  (fn-do _ register-query Bool
    (param receiver TypeId)
    (param level TypeId)
    (param index U32)
    (param site SyntaxId)
    ; Types the registration of a markup query by the constructor, as `register-queries` says, and
    ; says whether it has a shape here.
    (let row ([] (. facts markup-queries) index))
    (let ancestor (== (. row target-id) 0))
    (let callback
      (call (. types well-known-type)
        (block
          (arg "core/markup")
          (arg (if-expr ancestor "MarkupAncestorQueryRefresher" "MarkupDescendantsQueryApplier"))
        )
      )
    )
    (if (or (== callback invalid-type) (not (call host-self receiver site)))
      (call decline site)
      (return false)
    )
    (let mark (. scratch types mark))
    (call (. scratch types push) (call derived-interface receiver (. types markup-host-decl)))
    (if (not ancestor)
      (call (. scratch types push) (. types size-type))
      (call (. scratch types push) callback)
    )
    (call (. scratch types push) callback)
    (let register
      (call (. calls demand-runtime-call)
        (block
          (arg (. types markup-host-decl module))
          (arg no-type)
          (arg
            (call (. program store-atom)
              (block
                (arg (if-expr ancestor "register-markup-ancestor-query" "register-markup-descendants-query"))
              )
            )
          )
          (arg mark)
        )
      )
    )
    (call (. scratch types rewind) mark)
    (if (or (== register no-instance) (not (call raises-out site register)))
      (call decline site)
      (return false)
    )
    (call (. instances mark-may-panic) instance)
    (+= (. facts query-registrations) (call QueryRegistration instance site level index register))
    (return true)
  )
  (fn-do _ register-target Bool
    (param receiver TypeId)
    (param level TypeId)
    (param site SyntaxId)
    ; Types the registration by the constructor of the object as a target of the descendant queries
    ; that look for `level` or a class above it, as `register-queries` says, and says whether it has
    ; a shape here.
    (if (not (call host-self receiver site))
      (call decline site)
      (return false)
    )
    (let mark (. scratch types mark))
    (call (. scratch types push) (call derived-interface receiver (. types markup-host-decl)))
    (call (. scratch types push) (. types size-type))
    (let register
      (call (. calls demand-runtime-call)
        (block
          (arg (. types markup-host-decl module))
          (arg no-type)
          (arg (call (. program store-atom) "register-markup-descendant-target"))
          (arg mark)
        )
      )
    )
    (call (. scratch types rewind) mark)
    (if (or (== register no-instance) (not (call raises-out site register)))
      (call decline site)
      (return false)
    )
    (call (. instances mark-may-panic) instance)
    (+= (. facts query-registrations) (call QueryRegistration instance site level (. U32 max) register))
    (return true)
  )
  (fn-do _ host-self Bool
    (param receiver TypeId)
    (param site SyntaxId)
    ; Converts the object a constructor or the function that fills it makes to its markup host at
    ; `site`, once, and says whether its class is one.
    (let host
      (scope (if-expr (call is-markup-host receiver) markup-host no-type)
        (lazy markup-host (call derived-interface receiver (. types markup-host-decl)))
      )
    )
    (if (== host no-type)
      (return false)
    )
    (if (not converted-to-host)
      (= converted-to-host true)
      (call (. conversions convert) site site receiver host .reason-markup-host)
    )
    (return true)
  )
  (fn-expr _ scopes-known Bool
    ; Whether the style rules written in rules that markup written here sees are known here
    ; (`rule-scopes`): where the style sheets it sees are (`sheets-known`), and in a function that
    ; builds markup the markup around it gives them to (`scopes-given`), as for one that builds what a
    ; line gives a slot, with those found on the way to its outlet (`outlet-scopes`), and one that
    ; builds content a style rule generates (`check-content`); not in another that builds what a line
    ; gives a slot.
    (case? (or (. frame declaration is-content) scopes-given)
      true
    )
    (case? (== kind .slot-decl)
      false
    )
    (default
      (and (== (. ([] (. instances rows) instance) enclosing) no-instance) (or (== kind .main-decl) (== kind .function-decl) (== kind .getter-decl) (== kind .setter-decl) (call is-constructor-kind kind)))
    )
    (where
      (lazy kind (. frame declaration kind))
    )
  )
  (fn-do _ place-values Bool
    (param first U32)
    (param valued (list U32))
    (param value-types (list TypeId))
    (param rows (list U32))
    ; Places among the values a context gives, from the `first`th on, those of the rule around each
    ; rule written in a rule in view (`rule-scopes`) that takes some, once each: `valued` has where
    ; each rule's start, or `U32.max` for one around which none takes any, `value-types` their types
    ; and `rows` the values (`ScopeValues`) in turn. False where their types are not known here.
    (let next first)
    (let places (list U32))
    (let known true)
    (for (in use rule-scopes)
      (let place (. U32 max))
      (if (== (. use values) (- (. U32 max) 1))
        (= known false)
        (else-if (!= (. use values) (. U32 max))
          (let found (call (. rows find) (. use values)))
          (if found
            (= place ([] places found))
            (else
              (let taken (call frame-value-types (. use values)))
              (if (not taken)
                (= known false)
                (else
                  (= place next)
                  (+= rows (. use values))
                  (+= places next)
                  (for (in type taken)
                    (+= value-types type)
                  )
                  (+= next (as (. taken length) U32))
                )
              )
            )
          )
        )
      )
      (+= valued place)
    )
    (return known)
  )
  (fn-expr _ frame-value-types (? (list TypeId))
    (param values U32)
    ; The types of the values of the rule around rules written in it (`ScopeValues`), as the class or
    ; style sheet that writes it declares them (`frame-types`).
    (call frame-types (. ([] (. facts scope-values) values) frame))
  )
  (fn-do _ frame-types (? (list TypeId))
    (param frame U32)
    ; The types of the values of the rule of a frame, as the class or style sheet that writes it
    ; declares them; none where they are not known here.
    (let held ([] (. instances frames) frame))
    (match? ([] (. ([] (. program modules) (. held module)) decls) (. held decl))
      (case (call .decl-style-rule rule)
        (return (call written-argument-types (. held module) (. rule owner) (. held decl)))
      )
    )
    (return null)
  )
  (fn-do _ given-values U32
    (param scope RuleScope)
    (param place U32)
    ; The values of the rule around a rule written in a rule that the markup that made the object
    ; gives the function that fills it, from its `place`th on among those its context gives, made
    ; once.
    (let frame (call valued-frame (. scope frames)))
    (for (in index (..< 0 (. facts scope-values length)))
      (let held ([] (. facts scope-values) index))
      (if (and (== (. held instance) instance) (== (. held argument) place) (== (. held frame) frame))
        (return (as index U32))
      )
    )
    (+= (. facts scope-values) (call ScopeValues instance 0 module frame place))
    (return (as (- (. facts scope-values length) 1) U32))
  )
  (fn-do _ valued-frame U32
    (param frames U32)
    ; The frame of a rule that takes values among the rules applied around a rule written in a rule,
    ; or none.
    (let frame frames)
    (while (!= frame (. U32 max))
      (let held ([] (. instances frames) frame))
      (if (== (. held gate) 0)
        (match? ([] (. ([] (. program modules) (. held module)) decls) (. held decl))
          (case (call .decl-style-rule rule)
            (if (!= (call (. ([] (. program modules) (. held module)) tree rule-takes) (. rule syntax)) 0)
              (return frame)
            )
          )
        )
      )
      (= frame (. held outer))
    )
    (return (. U32 max))
  )
  (fn-do _ load-context Bool
    (param receiver TypeId)
    (param site SyntaxId)
    ; Takes, in the function that fills an object with its class's markup, the styles and style
    ; sheets of the markup that made the object, with those of the class after them, as the
    ; reference's `markupStyleContextWithClassUsings` makes the context its content is made under:
    ; the styles, the first to answer a name innermost, and the sheets in their groups; and the rules
    ; written in rules it sees, each under the state cells it is given with (`given-cell`), the
    ; outermost first, and those its own markup brings (`root-scopes`). A rule that reaches only the
    ; markup of the class of the element that brought it into view matches here where that element's
    ; object is the one filled (`scope-pending`), and not where it matched in the markup that made it
    ; (`scope-entered`), as the reference's `markupStyleContextEnteringContent` gives them. False where
    ; a using is declined.
    (let context (. ([] (. instances rows) instance) context))
    (let vocabulary (list TypeId))
    (if (!= context (. U32 max))
      (let held ([] (. instances contexts) context))
      (for (in position (..< (. held first) (+ (. held first) (. held styles))))
        (+= vocabulary ([] (. instances context-types) position))
      )
      (for (in position (..< (+ (. held first) (. held styles)) (+ (. held first) (. held styles) (. held sheets))))
        (+= markup-sheets ([] (. instances context-types) position))
        (+= sheet-levels ([] (. instances context-levels) position))
      )
    )
    (if (and (call (. program module-by-name) "core/style") (not (call add-visible-styles receiver vocabulary site)))
      (return false)
    )
    (for (in position (..< 0 (. vocabulary length)))
      (+= markup-styles ([] vocabulary (- (. vocabulary length) 1 position)))
    )
    (if (!= (call (. types well-known-type) "core/style" "StyleSheetInfo") invalid-type)
      (call add-sheet-groups receiver markup-sheets sheet-levels)
    )
    (let made receiver)
    (let known false)
    (if (!= context (. U32 max))
      (let held ([] (. instances contexts) context))
      (let argument U32)
      (for (in position (..< (. held scope-first) (+ (. held scope-first) (. held scopes))))
        (let given ([] (. instances context-scopes) position))
        (let count ([] (. instances context-cells) position))
        (if (== (. given own) .scope-entered)
          (+= argument count)
          (continue)
        )
        (let scope (. (call entered-use (call ScopeUse given)) scope))
        (let place ([] (. instances context-valued) position))
        (let values (if-expr (== place (. U32 max)) (. U32 max) (call given-values scope place)))
        (if (!= count 0)
          (let links (. U32 max))
          (for (in depth (..< 0 (- count 1)))
            (= links
              (call (. facts scope-link)
                (block
                  (arg (call given-cell scope (+ argument depth) (- count 1 depth)))
                  (arg links)
                )
              )
            )
          )
          (+= rule-scopes
            (call ScopeUse
              (block
                (arg scope)
                (arg (call given-cell scope (- (+ argument count) 1) 0))
                (arg values)
                (arg links)
              )
            )
          )
          (+= argument count)
          (else
            (+= rule-scopes (call ScopeUse scope (. U32 max) values))
          )
        )
      )
      (if (!= (. held made) no-type)
        (= made (. held made))
        (= known true)
      )
    )
    (= incoming-scopes (as (. rule-scopes length) U32))
    (return (call root-scopes receiver made known site))
  )
  (fn-do _ root-scopes Bool
    (param receiver TypeId)
    (param made TypeId)
    (param known Bool)
    (param site SyntaxId)
    ; Brings into view, in the function that fills an object with its class's markup, after the
    ; rules written in rules of the markup that made the object, those the rules a root `<This`
    ; matches bring, each that is not in view already, under whatever state cell, as the reference's
    ; `classContentRootStyleRuleScopes` gathers them (`gather-scopes`), which binds the cells of only
    ; those it brings (`prune-cells`), made where the root is; then those of the rules `• This` of the
    ; chain of the object's class `made` (`default-scopes`), made where the class `receiver` is,
    ; `known` where the markup that made the object said which class it is. The states of the
    ; `when`s around them are then checked (`check-cells`). False where one is declined or reported.
    (let root (call (. tree root-this) (. frame declaration syntax)))
    (match? ([] (. tree nodes) root)
      (case (call .node-markup row)
        (if (call may-scope receiver row)
          (let names (list Atom))
          (for (in name (call implicit-names receiver (. row type-id) 0 tree))
            (+= names (call (. program store-atom) name))
          )
          (let gathered (list ScopeUse))
          (let first (as (. facts scope-cells length) U32))
          (let own-keying keying)
          (= keying (call Keying (. keying discovering) (. keying sheet-self) module root))
          (let gathering
            (call gather-scopes
              (block
                (arg receiver)
                (arg names)
                (arg (. row style-rule-applications))
                (arg 0)
                (arg made)
                (arg gathered)
                (arg tree)
              )
            )
          )
          (= keying own-keying)
          (if (not gathering)
            (call decline root)
            (return false)
          )
          (let added (list ScopeUse))
          (for (in gathered-use gathered)
            (let use (call entered-use gathered-use))
            (let shown false)
            (for (in held rule-scopes)
              (= shown (or shown (call (. instances same-scope) (. held scope) (. use scope))))
            )
            (for (in held added)
              (= shown (or shown (call (. instances same-scope) (. held scope) (. use scope))))
            )
            (if (not shown)
              (+= added use)
            )
          )
          (for (in use (call prune-cells first added))
            (+= rule-scopes use)
          )
        )
      )
    )
    (if (call scoping-any)
      (let ref (call class-ref types receiver))
      (let own-keying keying)
      (match? ([] (. ([] (. program modules) (. ref module)) decls) (. ref decl))
        (case (call .decl-class class)
          (= keying (call Keying (. keying discovering) (. keying sheet-self) (. ref module) (. class syntax)))
        )
      )
      (call default-scopes made 0 rule-scopes true)
      (= keying own-keying)
    )
    (return (call check-cells 0 site made known))
  )
  (fn-do _ base-scopes Bool
    (param receiver TypeId)
    (param base TypeId)
    (param scopes (list ScopeUse))
    (param site SyntaxId)
    ; Adds to `scopes` the rules written in rules that the functions building what the lines of a
    ; class's markup give the slots of the class above see after those of the markup that made the
    ; object, as the reference's `baseSlotOutletStyleContext` holds them: those the rules the root
    ; `<This` of the markup of the class above matches bring, seeing only those of the markup that
    ; made the object, each not in view already, under state cells made where that root is; then
    ; those of the rules `• This` of the chain of the class above, under state cells made where the
    ; class `receiver` is. False where one is declined or reported.
    (let ref (call class-ref types base))
    (let written (. ([] (. program modules) (. ref module)) tree))
    (let root (call (. written root-this) (call class-content base)))
    (let context (. ([] (. instances rows) instance) context))
    (let made receiver)
    (let known false)
    (if (and (!= context (. U32 max)) (!= (. ([] (. instances contexts) context) made) no-type))
      (= made (. ([] (. instances contexts) context) made))
      (= known true)
    )
    (match? ([] (. written nodes) root)
      (case (call .node-markup row)
        (let names (list Atom))
        (for (in text (call implicit-names base (. row type-id) 0 written))
          (+= names (call (. program store-atom) text))
        )
        (let later (list ScopeUse))
        (while (> (. rule-scopes length) incoming-scopes)
          (+= later (call (. rule-scopes pop)))
        )
        (let gathered (list ScopeUse))
        (let first (as (. facts scope-cells length) U32))
        (let own-keying keying)
        (= keying (call Keying (. keying discovering) (. keying sheet-self) (. ref module) root))
        (let gathering
          (call gather-scopes
            (block
              (arg base)
              (arg names)
              (arg (. row style-rule-applications))
              (arg 0)
              (arg made)
              (arg gathered)
              (arg written)
            )
          )
        )
        (= keying own-keying)
        (let added (list ScopeUse))
        (for (in gathered-use gathered)
          (let use (call entered-use gathered-use))
          (let shown false)
          (for (in held rule-scopes)
            (= shown (or shown (call (. instances same-scope) (. held scope) (. use scope))))
          )
          (for (in held added)
            (= shown (or shown (call (. instances same-scope) (. held scope) (. use scope))))
          )
          (if (not shown)
            (+= added use)
          )
        )
        (while (!= (. later length) 0)
          (+= rule-scopes (call (. later pop)))
        )
        (if (not gathering)
          (call decline site)
          (return false)
        )
        (for (in use (call prune-cells first added))
          (+= scopes use)
        )
      )
    )
    (let owner (call class-ref types receiver))
    (let own-keying keying)
    (match? ([] (. ([] (. program modules) (. owner module)) decls) (. owner decl))
      (case (call .decl-class class)
        (= keying (call Keying (. keying discovering) (. keying sheet-self) (. owner module) (. class syntax)))
      )
    )
    (call default-scopes base 0 scopes true)
    (= keying own-keying)
    (return (call check-cells 0 site made known))
  )
  (fn-do _ resolve-slot (tuple TypeId Bool)
    (param made TypeId)
    (param name Atom)
    (param owner ModuleId)
    (param statement SyntaxId)
    ; The style sheet whose slot of a name a markup element of a class sees, as the reference's
    ; `resolveStyleSheetSlot` resolves it: that of the highest group that has one, two in one group
    ; being its error at the line, written at `statement` in a module; or none. False where it is
    ; reported.
    (let sheets (list TypeId))
    (let levels (list U32))
    (call visible-sheets made sheets levels)
    (let found no-type)
    (let group (if-expr (!= (. levels length) 0) (+ ([] levels (- (. levels length) 1)) 1) 0u32))
    (while (and (> group 0) (== found no-type))
      (-= group 1)
      (for (in place (..< 0 (. sheets length)))
        (if (and (== ([] levels place) group) (call sheet-has-slot ([] sheets place) name))
          (if (!= found no-type)
            (call report-at
              (block
                (arg owner)
                (arg statement)
                (arg
                  (paragraph
                    (str "StyleSheet slot \"" (. name text) "\" is ambiguous between visible style sheets " (call type-short-name types found) " and " (call type-short-name types ([] sheets place)))
                  )
                )
              )
            )
            (return (tuple no-type false))
          )
          (= found ([] sheets place))
        )
      )
    )
    (return (tuple found true))
  )
  (fn-do _ report-at _
    (param owner ModuleId)
    (param at SyntaxId)
    (param text String)
    ; Reports the reference's error at a node of a module: of this one through its frame, of another
    ; as an error of a type's own declaration is.
    (if (== owner module)
      (call (. frame diagnose) at .stated (call (. program store-atom) text))
      (else
        (call (. facts record-diagnostic)
          (block
            (arg instance)
            (arg owner)
            (arg at)
            (arg .stated)
            (arg (call (. program store-atom) text))
            (arg no-type)
            (arg no-type)
          )
        )
      )
    )
  )
  (fn-expr _ precedes Bool
    (param module ModuleId)
    (param site SyntaxId)
    (param other-module ModuleId)
    (param other SyntaxId)
    ; Whether a place in the program comes before another in source order: in a module loaded
    ; first, or earlier in the same module.
    (case? (!= module other-module)
      (< module other-module)
    )
    (default
      (or (< (. begin line) (. other-begin line)) earlier-column)
    )
    (where
      (lazy tree (. ([] (. program modules) module) tree))
      (lazy begin (. ([] (. tree nodes loc) site) begin))
      (lazy other-begin (. ([] (. tree nodes loc) other) begin))
      (lazy earlier-column (and (== (. begin line) (. other-begin line)) (< (. begin column) (. other-begin column))))
    )
  )
  (fn-do _ conform-members _
    (param value TypeId)
    (param interface TypeId)
    ; A type whose values are made values of an interface must answer each function the interface
    ; and those it extends declare without a body and with a result: its table has nothing of the
    ; interface's to run for it. The first it does not answer is the error, at the type's
    ; declaration, as a call through the interface reports it. Each instance that makes the witness
    ; reports it, so that it is reported whichever of them a type pass types.
    (let ref (call class-ref types value))
    (if (== (. ref decl) 0)
      (return)
    )
    (let owner ([] (. program modules) (. ref module)))
    (let site
      (match ([] (. owner decls) (. ref decl))
        (case (call .decl-class declared)
          (. declared syntax)
        )
        (default
          0u32
        )
      )
    )
    (if (== site 0)
      (return)
    )
    (let key (/or/ (/lshift/ (as value U64) 32) (as interface U64)))
    (let known ([] (. scratch missing-members) key))
    (let missing (if-expr known known (call missing-member value interface)))
    (= ([] (. scratch missing-members) key) missing)
    (if (== missing 0)
      (return)
    )
    (let module (as (/rshift/ missing 32) ModuleId))
    (let decl (as (/and/ missing 0xffffffff) DeclId))
    (match? ([] (. ([] (. program modules) module) decls) decl)
      (case (call .decl-function fn)
        (let declaring (call declaring-interface interface (call DeclRef module (. fn owner))))
        (let text (call (. program store-atom) (call unanswered-text types value declaring (!! (. fn name)))))
        (call (. facts record-diagnostic) instance (. ref module) site .stated text)
        (call (. facts relate-diagnostic) (call (. program store-atom) "Interface") module (. fn syntax))
      )
    )
  )
  (fn-do _ missing-member U64
    (param value TypeId)
    (param interface TypeId)
    ; The first function an interface, then each it extends, declares without a body and with a
    ; result that a type does not answer, as its module above its declaration, or 0 where the type
    ; answers each. A function with type parameters of its own is left to the calls that give it
    ; arguments, which choose what answers it. A step function written with no steps has no body
    ; either: it is given an empty block only so that it has one to check.
    (let ref (call class-ref types interface))
    (let owner ([] (. program modules) (. ref module)))
    (match? ([] (. owner decls) (. ref decl))
      (case (call .decl-class declared)
        (for (in member ([] (. owner member-pool) (. declared members)))
          (match? ([] (. owner decls) member)
            (case (call .decl-function fn)
              (let own-params (!= (. fn type-args count) 0))
              (let bodiless (or (== (. fn body) 0) (call is-module-empty-block (. ref module) (. fn body))))
              (if (and bodiless (!= (. fn return-type) 0) (not (. fn is-static)) (not own-params) (. fn name))
                (if (not (call answers-required value interface (. ref module) member (. fn kind) (. fn name)))
                  (return (/or/ (/lshift/ (as (. ref module) U64) 32) (as member U64)))
                )
              )
            )
          )
        )
      )
    )
    (for (in extended (call (. types interfaces-of) interface))
      (let missing (call missing-member value extended))
      (if (!= missing 0)
        (return missing)
      )
    )
    (return 0)
  )
  (fn-do _ answers-required Bool
    (param value TypeId)
    (param interface TypeId)
    (param module ModuleId)
    (param decl DeclId)
    (param kind DeclKind)
    (param name Atom)
    ; Whether a type answers a function an interface declares without a body, as the table of the
    ; type finds it: by a member of its own, of a class it is derived from or of an extension that
    ; takes the arguments the interface's function does, by a property it stores or one it
    ; delegates the name to for a getter or a setter, and by what it delegates the interface to.
    ; The signature is read onto the scratch stacks, and taken off them again.
    (let names-mark (. scratch names mark))
    (let items-mark (. scratch types mark))
    (let signature (call signature-into types module decl (call no-type-arguments types) interface true))
    (let answered (call answers-signature value signature module decl kind name))
    (call (. scratch types rewind) items-mark)
    (call (. scratch names rewind) names-mark)
    (return answered)
  )
  (fn-do _ answers-signature Bool
    (param value TypeId)
    (param signature Signature)
    (param module ModuleId)
    (param decl DeclId)
    (param kind DeclKind)
    (param name Atom)
    (for (in arg (. signature args))
      (if (. ([] (. types completions) arg) has-variables)
        (return true)
      )
    )
    (if (and (!= kind .function-decl) (call property-named value name))
      (return true)
    )
    (let busy (call (. calls suspend-ranking)))
    (let ranking (. calls ranking))
    (let caller (. ranking caller))
    (= (. ranking caller) (. (call class-ref types value) module))
    (let shapes-start (. scratch call-arguments mark))
    (let types-start (. scratch types mark))
    (for (in arg (. signature args))
      (call (. scratch call-arguments push) (call CallArgument null false false false false))
      (call (. scratch types push) arg)
    )
    (call (. ranking begin) (call (. scratch call-arguments since) shapes-start) (call (. scratch types since) types-start))
    (let hit (? Hit) null)
    (if (== kind .getter-decl)
      (= hit (call (. ranking dispatch-getter) value name))
      (else-if (== kind .setter-decl)
        (= hit (call (. ranking dispatch-setter) value name))
      )
      (else
        (= hit (call (. ranking dispatch-method) value name))
      )
    )
    (let answered (and hit (or (!= (. hit module) module) (!= (. hit decl) decl) (!= (call (. ranking ambiguity)) null))))
    (let steps (list U32))
    (if (and (not answered) (!= kind .function-decl))
      (let holder (call (. ranking delegated-holder) value name steps))
      (= answered (and (!= holder no-type) (!= (. steps length) 0) (!= (call property-named holder name) null)))
    )
    (call (. ranking release))
    (call (. scratch call-arguments rewind) shapes-start)
    (call (. scratch types rewind) types-start)
    (= (. ranking caller) caller)
    (call (. calls resume-ranking) busy)
    (return answered)
  )
  (fn-do _ check-root-values _
    ; Types the values a style rule applied on the root `<This` of a class's markup is given
    ; (`Instance.root-values`), for the class whose constructor applies the rule, as the reference's
    ; constructor evaluates them there: each typed with nothing expected, the rule chosen for them
    ; under the styles and style sheets of the instance's context as the constructor chooses it
    ; (`choose-written-rule`), and each converted at its node to the type that rule takes it as. It
    ; answers nothing.
    (call prepare)
    (let receiver (. ([] (. instances rows) instance) self-type))
    (let application (. ([] (. instances rows) instance) root-values))
    (= (. frame self-type) receiver)
    (call bind-this receiver)
    (call (. frame close-env))
    (call open-class-env (call holding-type receiver (call DeclRef module (. (call class-ref types receiver) decl))))
    (let context (. ([] (. instances rows) instance) context))
    (if (!= context (. U32 max))
      (let held ([] (. instances contexts) context))
      (for (in position (..< (+ (. held first) (. held styles)) (+ (. held first) (. held styles) (. held sheets))))
        (+= markup-sheets ([] (. instances context-types) position))
        (+= sheet-levels ([] (. instances context-levels) position))
      )
      (for (in position (..< (. held scope-first) (+ (. held scope-first) (. held scopes))))
        (if (and (== ([] (. instances context-cells) position) 0) (== ([] (. instances context-valued) position) (. U32 max)))
          (+= rule-scopes (call ScopeUse ([] (. instances context-scopes) position)))
        )
      )
    )
    (match? ([] (. tree nodes) application)
      (case (call .node-style-rule-application applied)
        (let given (list TypeId))
        (let typed true)
        (for (in value ([] (. tree children) (. applied args)))
          (let type (call infer value))
          (if (or (== type invalid-type) (== type no-type))
            (= typed false)
            (break)
          )
          (+= given type)
        )
        (let levels (list TypeId))
        (let members (list DeclRef))
        (let gates (list U64))
        (let scoped (list ScopeUse))
        (if (and typed (call choose-written-rule receiver application given levels members gates scoped) (!= (+ (. levels length) (. scoped length)) 0))
          (let wanted
            (block
              (case? (!= (. levels length) 0)
                (?? (call rule-argument-types ([] members 0)) (call scope-argument-types (. ([] scoped 0) scope)))
              )
              (default
                (call scope-argument-types (. ([] scoped 0) scope))
              )
            )
          )
          (for (in position (..< 0 (. given length)))
            (let value ([] (. tree children) (+ (. applied args start) position)))
            (call (. conversions convert)
              (block
                (arg value)
                (arg value)
                (arg ([] given position))
                (arg ([] (!! wanted) position))
                (arg .reason-argument)
              )
            )
          )
        )
      )
    )
    (call (. instances set-returns) instance (. types void-type) (. types void-type) .return-declared)
    (call finish-errors frame)
    (call close)
  )
  (fn-do _ scope-argument-types (? (list TypeId))
    (param scope RuleScope)
    ; The types a rule written in a rule takes its values as, as the class that writes it declares
    ; them (`written-argument-types`).
    (match? ([] (. ([] (. program modules) (. scope module)) decls) (. scope decl))
      (case (call .decl-style-rule rule)
        (return (call written-argument-types (. scope module) (. rule owner) (. scope decl)))
      )
    )
    (return null)
  )
  (fn-do _ take-scope ScopeUse
    (param use ScopeUse)
    ; A rule written in a rule that the function building markup sees as the markup it is written in
    ; sees it, as the reference's closures capture the values of its frames: under a state cell this
    ; function keeps of that one (`kept-cell`), or, for one found on the way to the slot outlet that
    ; mounts what it builds, reads from those the outlet holds (`read-cell`), and so for those of the
    ; `when`s further out (`take-links`); with the values of the rule around it that takes some this
    ; function keeps (`kept-values`).
    (let values (if-expr (< (. use values) (- (. U32 max) 1)) (call kept-values (. use values)) (. use values)))
    (if (>= (. use cell) (- (. U32 max) 1))
      (return (call ScopeUse (. use scope) (. use cell) values))
    )
    (return (call ScopeUse (. use scope) (call take-cell (. use cell)) values (call take-links (. use outer-cells))))
  )
  (fn-do _ take-links U32
    (param link U32)
    ; The state cells of a link of `scope-links` the function building markup sees as the markup it
    ; is written in sees them (`take-cell`), made into a link again.
    (if (== link (. U32 max))
      (return (. U32 max))
    )
    (let held ([] (. facts scope-links) link))
    (let outer (call take-links (. held outer)))
    (return (call (. facts scope-link) (call take-cell (. held cell)) outer))
  )
  (fn-do _ kept-values U32
    (param source U32)
    ; The values of a rule around rules written in it that this function keeps of those of the
    ; function it is written in, made once, in the order kept; `U32.max - 1`, values not here, where
    ; their types are not known. It names that one's values, so this function is typed only with that
    ; one (`Instance.with-enclosing`).
    (= (. ([] (. instances rows) instance) with-enclosing) true)
    (let count U32)
    (for (in index (..< 0 (. facts scope-values length)))
      (let held ([] (. facts scope-values) index))
      (if (and (== (. held instance) instance) (!= (. held kept) (. U32 max)))
        (if (== (. held source) source)
          (return (as index U32))
        )
        (+= count 1)
      )
    )
    (let taken (call frame-value-types source))
    (if (not taken)
      (return (- (. U32 max) 1))
    )
    (let first (as (. facts scope-value-types length) U32))
    (for (in type taken)
      (+= (. facts scope-value-types) type)
    )
    (+= (. facts scope-values)
      (call ScopeValues
        (block
          (arg instance)
          (arg 0)
          (arg module)
          (arg (. ([] (. facts scope-values) source) frame))
          (arg (. U32 max))
          (arg count)
          (arg source)
          (arg first)
          (arg (as (. taken length) U32))
        )
      )
    )
    (return (as (- (. facts scope-values length) 1) U32))
  )
  (fn-do _ nested-decl DeclId
    (param owner ModuleId)
    (param outer DeclId)
    (param syntax SyntaxId)
    ; The declaration of a style rule written at a node of the body of another, or of one of its
    ; `when`s: among those its module declares after the other, as it declares them, before the
    ; first that is written in none.
    (let decls (. ([] (. program modules) owner) decls))
    (let index (+ outer 1))
    (while (< index (. decls length))
      (match ([] decls index)
        (case (call .decl-style-rule rule)
          (if (== (. rule outer) 0)
            (return 0)
          )
          (if (== (. rule syntax) syntax)
            (return index)
          )
        )
        (default
          (return 0)
        )
      )
      (+= index 1)
    )
    (return 0)
  )
  (fn-do _ scopes-of (tuple U32 U32)
    (param id SyntaxId)
    ; Where among `scoped-rows` the rules a markup element brings into view are kept, the last kept
    ; for it, or none.
    (let position (. scoped-sites length))
    (while (!= position 0)
      (-= position 1)
      (if (== ([] scoped-sites position) id)
        (return (tuple ([] scoped-starts position) ([] scoped-ends position)))
      )
    )
    (return (tuple 0u32 0u32))
  )
  (fn-do _ may-scope Bool
    (param class TypeId)
    (param row ASTMarkup)
    ; Whether a style rule a markup element of a class applies may bring rules written in rules into
    ; view: whether a name it applies by has a rule that does (`scoping-names`).
    (if (or (not (call scoping-any)) (!= (call (. types intrinsic-of) class) .class))
      (return false)
    )
    (for (in name (call implicit-names class (. row type-id) (. row id) tree))
      (if (call scoping-named (call (. program store-atom) name))
        (return true)
      )
    )
    (for (in application ([] (. tree children) (. row style-rule-applications)))
      (match? ([] (. tree nodes) application)
        (case (call .node-style-rule-application applied)
          (if (call scoping-named (. applied name))
            (return true)
          )
        )
      )
    )
    (return false)
  )
  (fn-do _ gather-scopes Bool
    (param made TypeId)
    (param names (list Atom))
    (param applications (of RowRange SyntaxId))
    (param site SyntaxId)
    (param owner TypeId)
    (param scopes (list ScopeUse))
    (param written AST)
    ; The rules written in rules that the style rules a markup element applies bring into view, as
    ; the reference prepares them before it makes the object (`prepareElementStyleRules`): for the
    ; rules each name it matches by answers, and then each written after `•` in `written`, those they
    ; bring (`gather-name`), each seeing those the ones before brought, with the state cells of the
    ; `when`s around them made at `site` for an object read as of class `owner`. The values a written
    ; one gives are typed here, as the reference evaluates them as it prepares the element, and the
    ; rules it brings read them as the element's rule takes them (`ScopeValues`). One an element
    ; writes with a condition brings none: the reference reports the rules written in what it
    ; applies (`declares-only`). False where one is declined: one written with a condition or with
    ; values where no element is (a root `<This`). While the way to a slot outlet is followed
    ; (`discovering`), one with values is passed over, as the reference leaves out what it brings
    ; there.
    (let none (list TypeId))
    (for (in name names)
      (if (not (call gather-name made name scopes (. U32 max) (. U32 max) site owner scopes none 0 (. U32 max) (. U32 max)))
        (return false)
      )
    )
    (for (in application ([] (. written children) applications))
      (match? ([] (. written nodes) application)
        (case (call .node-style-rule-application applied)
          (if (or (not (call scoping-named (. applied name))) (and (!= (. applied condition) 0) (!= site 0)))
            (continue)
          )
          (if (and (!= (. applied args count) 0) (== (. applied condition) 0) (. keying discovering))
            (continue)
          )
          (if (or (!= (. applied condition) 0) (and (!= (. applied args count) 0) (== site 0)))
            (return false)
          )
          (let given (list TypeId))
          (for (in value ([] (. written children) (. applied args)))
            (let type (call infer value))
            (+= pretyped value)
            (if (or (== type invalid-type) (== type no-type))
              (return false)
            )
            (+= given type)
          )
          (let gives (if-expr (!= (. given length) 0) application 0))
          (if (not (call gather-name made (. applied name) scopes (. U32 max) (. U32 max) site owner scopes given gives (. U32 max) (. U32 max)))
            (return false)
          )
        )
      )
    )
    (return true)
  )
  (fn-do _ gather-name Bool
    (param made TypeId)
    (param name Atom)
    (param seen (list ScopeUse))
    (param frames U32)
    (param cell U32)
    (param site SyntaxId)
    (param owner TypeId)
    (param scopes (list ScopeUse))
    (param given (list TypeId))
    (param gives SyntaxId)
    (param values U32)
    (param outer-cells U32)
    ; Gathers into `scopes` the rules written in rules that the rules a name answers at an element
    ; of a class for values of the types `given` bring into view, as `apply-style-rules` resolves
    ; them: the class's, or else those of the style sheets the element sees, and then the rules
    ; written in rules that the element sees, with those `seen` after them; each within `frames`,
    ; the state cells `cell` and `outer-cells` and the `values` of the rules around, or its own. The
    ; application `gives` the values, or none does. Only a name some rule that brings any has is
    ; resolved. False where one is declined.
    (if (not (call scoping-named name))
      (return true)
    )
    (let pending (list ScopeUse))
    (let level no-type)
    (let member (call DeclRef 0 0))
    (if (== (. given length) 0)
      (let (tuple found chosen named) (call class-style-rule made name))
      (= level found)
      (= member chosen)
      (else
        (let (tuple found chosen taken mismatch) (call match-style-rule made name given))
        (if (== found invalid-type)
          (return false)
        )
        (= level found)
        (= member chosen)
      )
    )
    (if (!= level no-type)
      (if (not (call gather-rule made (. member module) (. member decl) level frames cell seen site owner pending gives values outer-cells))
        (return false)
      )
      (else
        (let sheets (list TypeId))
        (let members (list DeclRef))
        (let gates (list U64))
        (let (tuple status writes missed) (call sheet-rules made name given 0 sheets members gates (. U32 max)))
        (if (!= status 0)
          (return false)
        )
        (for (in position (..< 0 (. sheets length)))
          (if (not (call gather-rule made (. ([] members position) module) (. ([] members position) decl) ([] sheets position) frames cell seen site owner pending gives values outer-cells))
            (return false)
          )
        )
      )
    )
    (let scoped (list ScopeUse))
    (let (tuple scoping found missed) (call scope-rules made name given seen scoped (. U32 max)))
    (if (!= scoping 0)
      (return false)
    )
    (for (in use scoped)
      (let holder (if-expr (== (call (. types intrinsic-of) (. use scope owner)) .style-sheet) (. use scope owner) made))
      (if (not (call gather-rule made (. use scope module) (. use scope decl) holder (. use scope frames) (. use cell) seen site owner pending gives (. use values) (. use outer-cells)))
        (return false)
      )
    )
    (for (in use pending)
      (+= scopes use)
    )
    (return true)
  )
  (fn-do _ default-scopes _
    (param made TypeId)
    (param site SyntaxId)
    (param uses (list ScopeUse))
    (param takes-own Bool)
    ; Adds to `uses` the rules written in the rule `• This` of each class of the chain of the class
    ; `made`, the base first, as the reference's `defaultMarkupStyleRuleScopes` gives them: those of
    ; its body, then those of each of its `when`s, with no rule around them but the `when`'s, under
    ; its state cell, made at a site, the markup element whose slots are given content or none for
    ; the markup a class's content makes. One written `• own` is added matching in the markup being
    ; filled (`scope-entered`) where the markup of the class's own `takes-own`, and else left out.
    (let chain (list TypeId))
    (let level (? TypeId) made)
    (while (and level (== (call (. types intrinsic-of) level) .class))
      (+= chain level)
      (= level (call (. types base-of) level))
    )
    (for (in position (..< 0 (. chain length)))
      (let holder ([] chain (- (. chain length) 1 position)))
      (let ref (call class-ref types holder))
      (let owner ([] (. program modules) (. ref module)))
      (match? ([] (. owner decls) (. ref decl))
        (case (call .decl-class class)
          (for (in member ([] (. owner member-pool) (. class members)))
            (match? ([] (. owner decls) member)
              (case (call .decl-style-rule rule)
                (if (!= (. rule name text) "This")
                  (continue)
                )
                (let body (call (. owner tree rule-body) (. rule syntax)))
                (match? ([] (. owner tree nodes) body)
                  (case (call .node-block block)
                    (for (in statement ([] (. owner tree children) (. block body)))
                      (if (and nested (or takes-own plain))
                        (+= uses
                          (call entered-use
                            (block
                              (arg
                                (call ScopeUse
                                  (block
                                    (arg
                                      (call RuleScope
                                        (block
                                          (arg (. ref module))
                                          (arg (call nested-decl (. ref module) member statement))
                                          (arg holder)
                                          (arg (. U32 max))
                                          (arg (call scope-own (. owner tree) statement))
                                        )
                                      )
                                    )
                                  )
                                )
                              )
                            )
                          )
                        )
                      )
                      (lazy nested (is ([] (. owner tree nodes) statement) .node-rule-syntax))
                      (lazy plain (== (call scope-own (. owner tree) statement) .scope-plain))
                    )
                  )
                )
                (for (in branch (call (. owner tree rule-whens) body))
                  (let gate (. U32 max))
                  (let held (. U32 max))
                  (for (in line (call (. owner tree when-lines) branch))
                    (if (and nested-line (or takes-own plain-line))
                      (if (== gate (. U32 max))
                        (= gate
                          (call (. instances intern-frame)
                            (block
                              (arg (. U32 max))
                              (arg (. ref module))
                              (arg member)
                              (arg holder)
                              (arg branch)
                            )
                          )
                        )
                        (= held (call scope-cell site made (. ref module) branch))
                      )
                      (+= uses
                        (call entered-use
                          (block
                            (arg
                              (call ScopeUse
                                (block
                                  (arg
                                    (call RuleScope
                                      (block
                                        (arg (. ref module))
                                        (arg (call nested-decl (. ref module) member line))
                                        (arg holder)
                                        (arg gate)
                                        (arg (call scope-own (. owner tree) line))
                                      )
                                    )
                                  )
                                  (arg held)
                                )
                              )
                            )
                          )
                        )
                      )
                    )
                    (lazy nested-line (is ([] (. owner tree nodes) line) .node-rule-syntax))
                    (lazy plain-line (== (call scope-own (. owner tree) line) .scope-plain))
                  )
                )
                (break)
              )
            )
          )
        )
      )
    )
  )
  (fn-do _ rule-argument-types (? (list TypeId))
    (param member DeclRef)
    ; The types a style rule a class or a style sheet writes takes its values as, as it declares
    ; them, or none where one is not written or is not known without the class's type arguments.
    (match? ([] (. ([] (. program modules) (. member module)) decls) (. member decl))
      (case (call .decl-style-rule rule)
        (return (call written-argument-types (. member module) (. rule owner) (. member decl)))
      )
    )
    (return null)
  )
  (fn-do _ written-argument-types (? (list TypeId))
    (param module ModuleId)
    (param class DeclId)
    (param member DeclId)
    ; The types a style rule written in a class of a module, or in an extension of a style sheet,
    ; or in a rule of either, takes its values as, as `rule-argument-types` says.
    (let owner ([] (. program modules) module))
    (let taken (list TypeId))
    (match? ([] (. owner decls) member)
      (case (call .decl-style-rule rule)
        (match? ([] (. owner tree nodes) (. rule syntax))
          (case (call .node-rule-syntax row)
            (let env (call holder-env (call DeclRef module class)))
            (for (in arg ([] (. owner tree children) (. row args)))
              (let written (call (. owner tree argument-type-syntax) arg))
              (let type (if-expr (!= written 0) (call (. types evaluate-type) module (. owner tree) written env) invalid-type))
              (if (or (== type invalid-type) (. ([] (. types completions) type) has-variables))
                (call (. types env-release) env)
                (return null)
              )
              (+= taken type)
            )
            (call (. types env-release) env)
          )
        )
      )
    )
    (return taken)
  )
  (fn-do _ implicit-names (list String)
    (param made TypeId)
    (param type-id SyntaxId)
    (param element SyntaxId)
    (param written AST)
    ; The names a style rule that takes no values matches a markup element by, as the reference
    ; applies one without its being written, each once, in its order: the name of each class of
    ; the element's chain, base first, the type written, and the element's id spelled as a
    ; selector, each capital a hyphen and its small letter, as `written`. `This` matches nothing.
    (let chain (list String))
    (let level (? TypeId) made)
    (while (and level (== (call (. types intrinsic-of) level) .class))
      (let ref (call class-ref types level))
      (match? ([] (. ([] (. program modules) (. ref module)) decls) (. ref decl))
        (case (call .decl-class class)
          (+= chain (. class name text))
        )
      )
      (= level (call (. types base-of) level))
    )
    (let names (list String))
    (for (in position (..< 0 (. chain length)))
      (call add-name names ([] chain (- (. chain length) 1 position)))
    )
    (match? ([] (. written nodes) (call written-base written type-id))
      (case (call .node-type-identifier typed)
        (if (not (. typed is-declare))
          (call add-name names (. typed name text))
        )
      )
    )
    (match? ([] (. written nodes) element)
      (case (call .node-identifier named)
        (call add-name names (call selector-name (. named name text)))
      )
    )
    (return names)
  )
  (fn-expr _ written-base SyntaxId
    (param written AST)
    (param id SyntaxId)
    ; A type written with type arguments as the type they are given to.
    (match ([] (. written nodes) id)
      (case (call .node-type-arguments row)
        (call written-base written (. row base))
      )
      (default
        id
      )
    )
  )
  (fn-do _ scoping-from Bool
    (param name Atom)
    (param from ModuleId)
    ; Whether a module sees a name `scoping-names` lists: one a module it shares a case with writes.
    (for (in position (..< 0 (. caches scoping-names length)))
      (if (and (== ([] (. caches scoping-names) position) name) case-shared)
        (return true)
      )
      (lazy case-shared (call (. program shares-case) from ([] (. caches scoping-modules) position)))
    )
    (return false)
  )
  (fn-expr _ scoping-named Bool
    (param name Atom)
    ; Whether the module being typed sees a name `scoping-names` lists.
    (call scoping-from name module)
  )
  (fn-do _ scoping-any Bool
    ; Whether the module being typed sees any name `scoping-names` lists.
    (for (in owner (. caches scoping-modules))
      (if (call (. program shares-case) module owner)
        (return true)
      )
    )
    (return false)
  )
  (fn-do _ nested-any Bool
    ; Whether a module the module being typed shares a case with writes a rule in a rule.
    (for (in owner (. caches nested-modules))
      (if (call (. program shares-case) module owner)
        (return true)
      )
    )
    (return false)
  )
  (fn-do _ demand-event-register _
    ; The event runtime's `event-register-lowered`, which puts a section the reference runs from a
    ; table of its class in that table as the module of the class starts, and its
    ; `event-register-lowered-arrival`, which puts one that hears only what arrives at its object.
    (let matcher (call (. types well-known-alias) "core/event" "EventLoweredOwnerMatcher"))
    (if (== matcher invalid-type)
      (return)
    )
    (let mark (. scratch types mark))
    (call (. scratch types push) (. types size-type))
    (call (. scratch types push) matcher)
    (call (. scratch types push) (call pointer-to (call (. types type-row) .uint8)))
    (call (. scratch types push) (. types size-type))
    (call (. scratch types push) (. types bool-type))
    (= (. facts event-register)
      (call (. calls demand-runtime-call)
        (block
          (arg (. types event-endpoint-decl module))
          (arg no-type)
          (arg (call (. program store-atom) "event-register-lowered"))
          (arg mark)
        )
      )
    )
    (= (. facts event-register-arrival)
      (call (. calls demand-runtime-call)
        (block
          (arg (. types event-endpoint-decl module))
          (arg no-type)
          (arg (call (. program store-atom) "event-register-lowered-arrival"))
          (arg mark)
        )
      )
    )
    (call (. scratch types rewind) mark)
  )
  (fn-do _ defer-values _
    (param receiver TypeId)
    ; The first values a constructor gives only once the markup of its class has run, as the
    ; reference puts them off: a stored property's value that reads by its name alone a property
    ; the markup declares for an element, outside the functions written in it, and then each
    ; that reads a property put off, unless the constructor gives the property its value itself.
    ; Each is given after those it reads, and a value that reads itself that way is reported, as is
    ; one whose type has no value to hold until then.
    (let range (. ([] (. types completions) receiver) properties))
    (let count (. range count))
    (let values ([] SyntaxId count))
    (let owners ([] ModuleId count))
    (let sites ([] SyntaxId count))
    (let deferred ([] Bool count))
    (let given ([] Bool count))
    (let fill (call (. facts latest-fill-of) instance))
    (while (!= fill no-fact)
      (let place (call property-named receiver (. ([] (. facts fills) fill) name)))
      (if (and place (>= (as place U32) (. range start)) (< (as place U32) (+ (. range start) count)))
        (= ([] given (- (as place U32) (. range start))) true)
      )
      (= fill (call (. facts prior-fill) fill))
    )
    (let any false)
    (for (in position (..< 0 count))
      (let property ([] (. types properties) (+ (. range start) position)))
      (if (or (!= (. property storage-kind) .storage-eager) ([] given position) (call names-element types property))
        (continue)
      )
      (let ref (call declaring-decl types property))
      (let member (call valued-property program (. ref module) (. ref decl) (. property name)))
      (match? ([] (. ([] (. program modules) (. ref module)) decls) member)
        (case (call .decl-property row)
          (if (and (!= member 0) (not (. row is-lazy)))
            (= ([] values position) (. row value))
            (= ([] owners position) (. ref module))
            (= ([] sites position) (. row syntax))
          )
        )
      )
      (if (and (!= ([] values position) 0) (call reads-element receiver ref-tree ([] values position)))
        (= ([] deferred position) true)
        (= any true)
      )
      (lazy ref-tree (. ([] (. program modules) (. ref module)) tree))
    )
    (if (not any)
      (return)
    )
    (let grew true)
    (while grew
      (= grew false)
      (for (in position (..< 0 count))
        (if (or (== ([] values position) 0) ([] deferred position))
          (continue)
        )
        (let tree (. ([] (. program modules) ([] owners position)) tree))
        (let value ([] values position))
        (for (in node (.. (call (. tree subtree-start) value) value))
          (let read (call read-place receiver tree node))
          (if (and (!= read (. U32 max)) ([] deferred read))
            (= ([] deferred position) true)
            (= grew true)
            (break)
          )
        )
      )
    )
    (for (in position (..< 0 count))
      (let property ([] (. types properties) (+ (. range start) position)))
      (if (and ([] deferred position) (not (call has-empty-value (call eager-type receiver property) 0)))
        (let message
          (paragraph
            (str "Property \"" (. property name text) "\" initializes after its markup, so its type must be optional")
          )
        )
        (call (. facts record-diagnostic)
          (block
            (arg instance)
            (arg ([] owners position))
            (arg ([] sites position))
            (arg .stated)
            (arg (call (. program store-atom) message))
          )
        )
        (return)
      )
    )
    (let states ([] U8 count))
    (let order (list U32))
    (for (in position (..< 0 count))
      (if (not ([] deferred position))
        (continue)
      )
      (if (not (call order-deferred receiver position values owners sites deferred states order))
        (return)
      )
    )
    (call (. facts note-deferred) instance order)
  )
  (fn-do _ order-deferred Bool
    (param receiver TypeId)
    (param position U32)
    (param values (list SyntaxId))
    (param owners (list ModuleId))
    (param sites (list SyntaxId))
    (param deferred (list Bool))
    (param states (list U8))
    (param order (list U32))
    ; Places a value put off after the values put off that it reads, and then itself, by its
    ; property's place among all properties. A value reached again while those it reads are
    ; being placed depends on itself, and is reported at its property.
    (if (== ([] states position) 2)
      (return true)
    )
    (let start (. ([] (. types completions) receiver) properties start))
    (if (== ([] states position) 1)
      (let name (. ([] (. types properties) (+ start position)) name))
      (let message
        (paragraph
          (str "Property \"" (. name text) "\" depends on itself through properties that initialize after its markup")
        )
      )
      (call (. facts record-diagnostic)
        (block
          (arg instance)
          (arg ([] owners position))
          (arg ([] sites position))
          (arg .stated)
          (arg (call (. program store-atom) message))
        )
      )
      (return false)
    )
    (= ([] states position) 1)
    (let tree (. ([] (. program modules) ([] owners position)) tree))
    (let value ([] values position))
    (for (in node (.. (call (. tree subtree-start) value) value))
      (let read (call read-place receiver tree node))
      (if (and (!= read (. U32 max)) (!= read position) ([] deferred read))
        (if (not (call order-deferred receiver read values owners sites deferred states order))
          (return false)
        )
      )
    )
    (= ([] states position) 2)
    (+= order (+ start position))
    (return true)
  )
  (fn-do _ read-place U32
    (param receiver TypeId)
    (param tree AST)
    (param node SyntaxId)
    ; The place among a class's own properties of the one a node of a value reads as the
    ; reference finds them: by a name alone, or after `this`. `U32.max` for any other node.
    (let name (? Atom) null)
    (match? ([] (. tree nodes) node)
      (case (call .node-identifier row)
        (= name (. row name))
      )
      (case (call .node-get-expression row)
        (match? ([] (. tree nodes) (. row object))
          (case (call .node-identifier object)
            (if (and (. types this-atom) (== (. object name) (. types this-atom)))
              (= name (. row name))
            )
          )
        )
      )
    )
    (if (not name)
      (return (. U32 max))
    )
    (let place (call property-named receiver name))
    (let range (. ([] (. types completions) receiver) properties))
    (if (or (not place) (< (as place U32) (. range start)) (>= (as place U32) (+ (. range start) (. range count))))
      (return (. U32 max))
    )
    (return (- (as place U32) (. range start)))
  )
  (fn-do _ check-rule _
    (param declaration CheckedDecl)
    (param matched SyntaxId)
    ; A rule a module declares, typed for the stream and the arguments a pattern calls it with, as the
    ; reference types the function it makes of it: its pattern is typed as a match of its own over the
    ; buffer of the stream, which holds the stream's items, or the UTF-8 bytes of its characters where
    ; the rule is `encoded` for a pattern on a String, and its arms are joined and converted to the
    ; type the rule states. The function made of it returns an optional of that type, which holds
    ; nothing where no arm passed, and which a call of the rule from its own arms gives where the rule
    ; states its type; one that states none, called from its own arms before its type is known, reports
    ; that it cannot be typed, as the reference does. The type of the buffer is kept at the rule. A
    ; type's constructor that takes a stream is such a rule. Its pattern asks the stream for more input
    ; where it reads past the end of the buffer, through the calls `record-growth` keeps. One typed for
    ; the helper a pattern calls it under runs its pattern under that helper; one given an argument
    ; `ambient-position` finds, under that argument, whatever helper a pattern calls it under, and one
    ; whose helper observes literals or keeps collectors where its storages disagree has no shape here.
    ; A rule marked to roll back, or whose pattern has an arm that is, asks the helper for a mark before
    ; each action of its arms, as the reference does. Another rule that belongs to a type is an
    ; error, and one whose body holds more than its pattern and the lazy locals declared for it has
    ; no shape here.
    (let pattern SyntaxId 0)
    (match? ([] (. tree nodes) matched)
      (case (call .node-stream-match row)
        (= pattern (. row pattern))
      )
    )
    (let declared declared-return)
    (let signature ([] (. instances signatures) instance))
    (let item (if-expr (!= (. signature param-count) 0) (call (. instances param-type) instance 0) no-type))
    (let owned (and (!= (. frame self-type) no-type) (!= (. declaration kind) .constructor-decl)))
    (let given (if-expr (!= item no-type) (call class-over (. types token-stream-decl) item) no-type))
    (let grows
      (scope (or (== pattern 0) (== item no-type) (call record-growth given matched encodes))
        (lazy encodes (. ([] (. instances rows) instance) encoded))
      )
    )
    (let marked false)
    (match? ([] (. tree nodes) (. declaration syntax))
      (case (call .node-function-syntax row)
        (= marked (. row rollback))
      )
    )
    (if (or (== pattern 0) (== item no-type) owned (not grows) (not (call lazies-beside (. declaration body) matched)))
      (if owned
        (call (. frame diagnose)
          (block
            (arg (. declaration syntax))
            (arg .stated)
            (arg (call (. program store-atom) "A rule can't be a method; declare it at module level"))
          )
        )
        (else
          (call decline (. declaration syntax))
        )
      )
      (call (. instances set-returns) instance invalid-type no-type .return-inferred)
      (call finish-errors frame)
      (call close)
      (return)
    )
    (if (!= declared no-type)
      (let stated (call (. types optional-around) declared))
      (call (. instances set-returns) instance stated stated .return-declared)
    )
    (= stream-view (= (. stream-view item) item))
    (= stream-view
      (= (. stream-view buffer)
        (call class-over
          (block
            (arg (. types array-decl))
            (arg (if-expr (. ([] (. instances rows) instance) encoded) (call (. types type-row) .uint8) item))
          )
        )
      )
    )
    (= stream-view (= (. stream-view type) given))
    (if (!= (. ([] (. instances rows) instance) helper) no-type)
      (= helping (= (. helping helper) (call pattern-helper types (. ([] (. instances rows) instance) helper))))
      (if (. ([] (. instances rows) instance) spans)
        (= helping (= (. helping helper) (call spanning-helper (!! (. helping helper)))))
        (= helping (= (. helping span-typing) true))
      )
      (= helping (= (. helping site) matched))
      (= rule-helper-site matched)
      (else-if (!= (call ambient-position types instances instance) (. U32 max))
        (let resolved
          (call pattern-helper
            (block
              (arg types)
              (arg (call (. instances argument-type) instance (call ambient-position types instances instance)))
            )
          )
        )
        (if (or (!= (. resolved problem) null) (!= (. resolved observer) no-type) (== (. resolved storage) invalid-type))
          (call decline (. declaration syntax))
        )
        (= helping (= (. helping helper) resolved))
        (= helping (= (. helping site) matched))
        (= rule-helper-site matched)
      )
    )
    (let closing (call left-call pattern 0 (call (of List SyntaxId))))
    (if (!= closing 0)
      (call report-left-recursion closing)
      (call (. instances set-returns) instance invalid-type no-type .return-inferred)
      (call finish-errors frame)
      (call close)
      (return)
    )
    (= rule-arming (= (. rule-arming capture-base) (. capture-sites length)))
    (= rule-arming (= (. rule-arming capture-root) pattern))
    (= rule-arming (= (. rule-arming texts) (== declared (. types string-type))))
    (let saved-target rule-arming)
    (= rule-arming (= (. rule-arming target) declared))
    (= rule-arming (= (. rule-arming span) (call gives-source-span declared)))
    (= helping (= (. helping explicit) (or marked (call (. tree holds-rollback) pattern))))
    (= helping (= (. helping body) matched))
    (let joined (call arms-type pattern))
    (= helping (= (. helping explicit) false))
    (= helping (= (. helping body) 0))
    (= rule-arming saved-target)
    (= rule-arming (= (. rule-arming texts) false))
    (let result declared)
    (if (== result no-type)
      (= result (if-expr (== joined no-type) (. types string-type) joined))
    )
    (if (!= joined invalid-type)
      (call convert-stream-arms pattern result)
      (if (and (!= declared no-type) (!= declared (. types string-type)))
        (call note-arm-casts pattern declared)
      )
      (call (. facts set-node-type) instance pattern result)
      (call (. facts set-node-type) instance (. declaration syntax) (. stream-view buffer))
    )
    (if (== declared no-type)
      (if (. ([] (. instances signatures) instance) read-in-progress)
        (let reader (. ([] (. instances signatures) instance) read-by))
        (if (or (== reader no-instance) (== reader instance) (not (call (. facts has-diagnostic) reader)))
          (call (. facts record-diagnostic)
            (block
              (arg instance)
              (arg (. frame module))
              (arg (. declaration syntax))
              (arg .return-after-recursion)
            )
          )
        )
        (call (. instances set-returns) instance invalid-type no-type .return-failed)
        (else
          (call (. instances set-returns) instance (call (. types optional-around) result) no-type .return-inferred)
        )
      )
    )
    (call finish-errors frame)
    (call close)
  )
  (fn-do _ lazies-beside Bool
    (param body SyntaxId)
    (param matched SyntaxId)
    ; Whether the body of a rule holds nothing beside its pattern but lazy locals declared for
    ; it, as the reference's `where` holds them.
    (match? ([] (. tree nodes) body)
      (case (call .node-block block)
        (for (in statement ([] (. tree children) (. block body)))
          (if (and (!= statement matched) (not (call (. narrowing is-lazy-declaration) statement)))
            (return false)
          )
        )
      )
    )
    (return true)
  )
  (fn-expr _ lacks-result Bool
    (param declaration CheckedDecl)
    (param declared TypeId)
    (param intrinsic TypeId)
    ; A function written without a body and without `do` gives nothing, unless it declares a type
    ; to construct, states a requirement of an interface, or is one the compiler computes.
    (case? (or (!= (. declaration body) 0) (. declaration is-main) (. declaration is-imperative))
      false
    )
    (case? (or (. declaration is-generated) (call is-constructor-kind (. declaration kind)) (!= intrinsic no-type))
      false
    )
    (case? (and (!= declared no-type) (!= declared (. types void-type)))
      false
    )
    (case? (and (!= self no-type) (!= self invalid-type) (== (call (. types intrinsic-of) self) .interface))
      false
    )
    (default
      (== (. declaration kind) .function-decl)
    )
    (where
      (lazy self (. frame self-type))
    )
  )
  (fn-do _ unwritten-return SyntaxId
    (param declaration CheckedDecl)
    (param declared TypeId)
    (param intrinsic TypeId)
    ; The type a function written without a body and without `do` declares it returns, which
    ; it gives as made with nothing written, as a local declared with no value is, or nothing
    ; where it gives nothing so. A function the compiler computes is none of these.
    (if (or (!= (. declaration body) 0) (. declaration is-main) not-expression)
      (return 0)
    )
    (lazy not-expression (or (. declaration is-imperative) (. declaration is-generated)))
    (if (== module (. types intrinsics-module))
      (return 0)
    )
    (if (or (!= (. declaration kind) .function-decl) (!= intrinsic no-type) gives-nothing)
      (return 0)
    )
    (lazy gives-nothing (or (== declared no-type) (== declared (. types void-type))))
    (let self (. frame self-type))
    (if (and (!= self no-type) (!= self invalid-type) (== (call (. types intrinsic-of) self) .interface))
      (return 0)
    )
    (match? ([] (. ([] (. program modules) module) decls) (. frame decl))
      (case (call .decl-function fn)
        (return (. fn return-type))
      )
    )
    (return 0)
  )
  (fn-do _ refuses-unwritten Bool
    (match? ([] (. ([] (. program modules) module) decls) (. frame decl))
      (case (call .decl-function fn)
        (if (and (== (. fn owner) 0) (. fn name) (== (call (. calls intrinsic-plan) instance) .plan-none))
          (let text
            (paragraph
              (str "Function \"" (. fn name text) "\" has no body, and no compiler intrinsic supplies one")
            )
          )
          (call (. frame diagnose) (. fn syntax) .stated (call (. program store-atom) text))
          (return true)
        )
      )
    )
    (return false)
  )
  (fn-do _ evident-return TypeId
    (param declaration CheckedDecl)
    ; The type an expression function gives when its result constructs a type it names in full:
    ; a function that reads this one's return while it is still being checked reads that type.
    (if (or (. declaration is-main) (. declaration is-imperative) (== (. declaration body) 0))
      (return no-type)
    )
    (let result (. declaration body))
    (match? ([] (. tree nodes) result)
      (case (call .node-block row)
        (= result 0)
        (for (in statement ([] (. tree children) (. row body)))
          (if (not (call (. tree is-lazy-declare) statement))
            (= result statement)
          )
        )
      )
    )
    (if (== result 0)
      (return no-type)
    )
    (match? ([] (. tree nodes) result)
      (case (call .node-call-expression call)
        (match? ([] (. tree nodes) (. call callable))
          (case .node-type-arguments
            (let named (call (. types evaluate-type) module tree (. call callable) (. frame env)))
            (if (and (!= named invalid-type) (not (. ([] (. types completions) named) has-variables)))
              (return named)
            )
          )
        )
      )
    )
    (return no-type)
  )
  (fn-do _ check-unreturned _
    (param declared TypeId)
    ; A `do` function that can run off its end must not finish on a value: a value it means to
    ; give back needs `=`. One that declares a type it must give cannot run off its end at all;
    ; nothing, a truth and an optional each have a value for the end to give. A function a C
    ; header declares has no end to run off, and neither has one an interface requires and
    ; gives no body.
    (let declaration (. frame declaration))
    (let plain (or (== (. declaration kind) .function-decl) (== (. declaration kind) .getter-decl)))
    (if (or (not plain) (not (. declaration is-imperative)) (. giving yields))
      (return)
    )
    (if (or (call (. ([] (. program modules) module) name ends-with) ".h") (call (. narrowing exits) (. declaration body) false true))
      (return)
    )
    (let owner (. frame self-type))
    (if (and (!= owner no-type) (!= owner invalid-type) (call (. tree is-empty-block) (. declaration body)))
      (if (== (call (. types intrinsic-of) owner) .interface)
        (return)
      )
    )
    (let gives (and (!= declared no-type) (!= declared (. types void-type))))
    (let required (and gives (!= declared (. types bool-type)) (not (call (. types is-optional) declared))))
    (if (and (== final-statement 0) (not required))
      (return)
    )
    (let name "")
    (match? ([] (. ([] (. program modules) module) decls) (. frame decl))
      (case (call .decl-function fn)
        (if (. fn name)
          (= name (. fn name text))
        )
      )
      (case (call .decl-converter converter)
        (let target (call (. types type-syntax-name) tree (. converter target-type)))
        (if target
          (= name (str "to " (. target text)))
        )
      )
    )
    (if (!= final-statement 0)
      (let gives-value gives)
      (if (== declared no-type)
        (for (in position (..< (. frame returns-start) (. scratch returns length)))
          (let returned (. ([] (. scratch returns) position) type))
          (if (and (!= returned no-type) (!= returned (. types void-type)))
            (= gives-value true)
          )
        )
      )
      (if gives-value
        (let message (str "Function " name " ends with a value it does not return"))
        (call (. frame diagnose) final-statement .stated (call (. program store-atom) message))
        (return)
      )
      (if (and (call (. tree is-bare-value) final-statement) (== (. frame self-type) no-type))
        (call (. frame diagnose) final-statement .stated (call (. program store-atom) (call bare-value-text)))
        (return)
      )
      (call (. instances set-unreturned) instance final-statement)
    )
    (if required
      (let shown (call type-short-name types declared))
      (let message (str "Function " name " can fall through without returning " shown))
      (call (. frame diagnose) (. declaration syntax) .stated (call (. program store-atom) message) declared)
    )
  )
  (fn-expr _ is-module-empty-block Bool
    (param module ModuleId)
    (param id SyntaxId)
    (match ([] (. ([] (. program modules) module) tree nodes) id)
      (case (call .node-block row)
        (== (. row body count) 0)
      )
      (default
        false
      )
    )
  )
  (fn-expr _ discards-result Bool
    ; A tap's closure runs for its effect: the reference declares it to return nothing.
    (case? (!= (. frame declaration kind) .pipeline-decl)
      false
    )
    (default
      (match ([] (. tree nodes) (. frame declaration syntax))
        (case (call .node-pipeline-expression row)
          (== (. row op) .pipe-repeat-op)
        )
        (case (call .node-binary-expression row)
          (== (. row op) .pipe-repeat-op)
        )
        (default
          false
        )
      )
    )
  )
  (fn-do _ math-intrinsic-return TypeId
    ; What a function the compiler computes gives, where it declares nothing: one of the four of
    ; the math module that take floats, or the intrinsic that calls an event's lowered handler.
    (let name "")
    (match? ([] (. ([] (. program modules) module) decls) (. frame decl))
      (case (call .decl-function fn)
        (if (. fn name)
          (let atom (. fn name))
          (= name (. atom text))
        )
      )
    )
    (if (and (== module (. types intrinsics-module)) (== name "event-invoke-lowered"))
      (return (. types void-type))
    )
    (if (!= (. ([] (. program modules) module) name) "math")
      (return no-type)
    )
    (let signature ([] (. instances signatures) instance))
    (if (== (. signature args count) 0)
      (return no-type)
    )
    (for (in position (..< 0 (. signature args count)))
      (if (!= (call (. instances argument-type) instance position) (. types f64-type))
        (return no-type)
      )
    )
    (if (and (or (== name "sqrt") (== name "abs")) (== (. signature args count) 1))
      (return (. types f64-type))
    )
    (if (and (or (== name "min") (== name "max")) (== (. signature args count) 2))
      (return (. types f64-type))
    )
    (return no-type)
  )
  (fn-do _ generator-return TypeId
    (param declared TypeId)
    (param raised (of RowRange TypeId))
    ; A generator body under a declared return type, its steps raising the errors in `raised`: a
    ; declared generator stays; a declared stream or iterable returns the iterable of its item,
    ; the case of the stream union a generator unifies with, unless the steps raise, when the
    ; reference keeps the concrete generator so its pull carries the errors.
    (if (== declared invalid-type)
      (return declared)
    )
    (let ref (call class-ref types declared))
    (if (call same-decl ref (. types generator-decl))
      (return declared)
    )
    (if (and (not (call same-decl ref (. types stream-decl))) (not (call same-decl ref (. types iterable-decl))))
      (return declared)
    )
    (let item (call first-arg declared))
    (if (== item no-type)
      (return declared)
    )
    (if (!= (. raised count) 0)
      (return (call generator-of item raised))
    )
    (return (call class-over (. types iterable-decl) item))
  )
  (fn-do _ read-return TypeId
    (param declaration CheckedDecl)
    (param declared TypeId)
    ; The return a call back to a function reads while its body is typed. A body that yields
    ; itself gives what `generator-return` settles its declared return to, its steps raising the
    ; errors it states, or none so far, as such a call reads those it infers; one that turns up
    ; later is reported as leaving a recursive generator.
    (if (== declared invalid-type)
      (return declared)
    )
    (let ref (call class-ref types declared))
    (let streams (or (call same-decl ref (. types stream-decl)) (call same-decl ref (. types iterable-decl))))
    (if (or (not streams) (not (call (. tree yields-itself) declaration)))
      (return declared)
    )
    (let signature ([] (. instances signatures) instance))
    (let stated (if-expr (== (. signature error-state) .errors-stated) (. signature errors) (call (of RowRange TypeId))))
    (return (call generator-return declared stated))
  )
  (fn-do _ note-generator _
    ; Says what a function that yields makes and what a step of its body gives, for emission:
    ; the generator of the items it returns a generator or an iterable of, or else of what its
    ; yields unify to. Each yield a statement writes is converted to the type of the items
    ; where it gives another, at the statement, as the reference casts it once the body is
    ; compiled. A function declared to return anything else returns the generator converted to
    ; that, where it is called: the conversion is recorded at the declaration. A generator whose
    ; steps raise carries their errors, and a step gives its item or one of them.
    (let returned (. ([] (. instances signatures) instance) returns))
    (let ref
      (scope (if-expr (and (!= returned no-type) (!= returned invalid-type)) returned-ref (call DeclRef 0 0))
        (lazy returned-ref (call class-ref types returned))
      )
    )
    (let item (. giving yielded))
    (if (or (call same-decl ref (. types generator-decl)) (call same-decl ref (. types iterable-decl)))
      (= item (call first-arg returned))
    )
    (if (or (== item no-type) (== item invalid-type))
      (return)
    )
    (call convert-yields item)
    (let makes (call generator-of item (. ([] (. instances rows) instance) step-errors)))
    (let yields (call step-answer (call (. types optional-around) item)))
    (call (. types complete) makes)
    (call (. types complete) yields)
    (let inferred (== (. ([] (. instances signatures) instance) return-state) .return-inferred))
    (if (and inferred (call same-decl ref (. types generator-decl)) (!= returned makes))
      (call (. instances set-returns) instance makes no-type .return-inferred)
      (= returned makes)
    )
    (if (and (!= returned no-type) (!= returned invalid-type) (!= returned makes) not-interface)
      (let site (. frame declaration syntax))
      (if (not (call relation-legal (call (. conversions compare-held) makes returned)))
        (let message (call (. program store-atom) "Generator return type does not match declared return type"))
        (call (. frame diagnose) site .stated message)
        (return)
      )
      (call (. conversions convert) site site makes returned .reason-return)
    )
    (lazy not-interface (!= (call (. types intrinsic-of) returned) .interface))
    (call (. instances set-generator) instance makes yields (and loops-yields splits-yields))
  )
  (fn-do _ convert-yields _
    (param item TypeId)
    (for (in position (..< (. frame yields-start) (. scratch yields length)))
      (let site ([] (. scratch yields) position))
      (if (!= (. site type) item)
        (let noted (- position (. frame yields-start)))
        (let literal (if-expr (< noted (. yield-literals length)) ([] yield-literals noted) 0))
        (if (and (!= literal 0) (call yield-fits literal item))
          (call (. conversions convert) (. site syntax) literal (. site type) item .reason-return true true)
          (else
            (call (. conversions convert)
              (block
                (arg (. site syntax))
                (arg (call (. tree yielded-syntax) (. site syntax)))
                (arg (. site type))
                (arg item)
                (arg .reason-return)
              )
            )
          )
        )
      )
    )
  )
  (fn-do _ settle-built-list _
    (let item (if-expr (!= built-item no-type) built-item (. giving yielded)))
    (if (or (== item no-type) (== item invalid-type))
      (call (. instances set-returns) instance invalid-type no-type .return-failed)
      (return)
    )
    (call convert-yields item)
    (let list (call list-of item))
    (call (. instances set-returns) instance list no-type .return-inferred)
    (let head (. frame declaration syntax))
    (call (. calls note-list) head list)
    (call (. calls note-append) head list item .call-list-append)
  )
  (fn-do _ generator-of TypeId
    (param item TypeId)
    (param raised (of RowRange TypeId))
    ; The generator a function that yields makes, of its items and of the errors in `raised`, which
    ; a step of its body raises.
    (if (== (. raised count) 0)
      (return (call class-over (. types generator-decl) item))
    )
    (let mark (. scratch types mark))
    (call (. scratch types push) item)
    (let errors-mark (. scratch types mark))
    (for (in offset (..< 0 (. raised count)))
      (call (. scratch types push) ([] (. instances signature-types) (+ (. raised start) offset)))
    )
    (return
      (call (. types intern-raising-class)
        (block
          (arg (. types generator-decl module))
          (arg (. types generator-decl decl))
          (arg mark)
          (arg errors-mark)
        )
      )
    )
  )
  (fn-do _ step-answer TypeId
    (param optional TypeId)
    ; What a step of a function that yields gives: the optional of an item, or that or one of
    ; the errors the step raises.
    (let raised (. ([] (. instances rows) instance) step-errors))
    (if (== (. raised count) 0)
      (return optional)
    )
    (let mark (. scratch types mark))
    (for (in offset (..< 0 (. raised count)))
      (call (. scratch types push) (call (. instances step-error-type) instance offset))
    )
    (return (call result-type types optional mark))
  )
  (fn-do _ class-over TypeId
    (param decl DeclRef)
    (param item TypeId)
    (let mark (. scratch types mark))
    (call (. scratch types push) item)
    (return (call (. types class-with-args) (. decl module) (. decl decl) mark))
  )
  (fn-do _ super-type TypeId
    (let self (. frame self-type))
    (if (or (== self no-type) (== self invalid-type))
      (return self)
    )
    (call (. types complete) self)
    (return (?? (call (. types base-of) self) self))
  )
  (fn-do _ owner-syntax SyntaxId
    (let owner 0u32)
    (match? ([] (. ([] (. program modules) module) decls) (. frame decl))
      (case (call .decl-function fn)
        (= owner (. fn owner))
      )
    )
    (if (== owner 0)
      (return (. frame declaration syntax))
    )
    (match? ([] (. ([] (. program modules) module) decls) owner)
      (case (call .decl-class class)
        (return (. class syntax))
      )
    )
    (return (. frame declaration syntax))
  )
  (fn-do _ states-type Bool
    (param signature Signature)
    (param position U32)
    ; Whether the argument at a position of the function being typed is written with a type
    ; that leaves nothing open.
    (let declared ([] (. signature args) position))
    (if (or (== declared invalid-type) (. ([] (. types completions) declared) has-variables))
      (return false)
    )
    (match? ([] (. ([] (. program modules) module) decls) (. frame decl))
      (case (call .decl-function fn)
        (if (< position (. fn args count))
          (return (!= (. ([] (. ([] (. program modules) module) arg-pool) (+ (. fn args start) position)) type-syntax) 0))
        )
      )
    )
    (return false)
  )
  (fn-do _ demand-own-body _
    (param callee InstanceId)
    ; Types a callee's body in this pass where nothing has typed it yet, for what it records of the
    ; state machines it types, which a pass of a parallel type pass takes in from the others only
    ; as they merge: taken in from another (`adopt`), the callee would have none here. Where one was
    ; taken in already, the parallel pass cannot stand (`SharedTyping.diverge`).
    (if (== (. ([] (. instances rows) callee) state) .instance-unstarted)
      (let checker (call checker-for session callee))
      (call (. checker run))
      (call (. checker retire))
      (else-if (and (. ([] (. instances rows) callee) imported) (. session shared))
        (call (. session shared diverge))
      )
    )
  )
  (fn-do _ check-equality _
    ; Types the comparison of two values of the instance's type, which the function a witness
    ; table holds for equality runs: `==` of two such values, planned in the frame of the type's
    ; module's main at the type's declaration, as anywhere else.
    (call prepare)
    (let value (. ([] (. instances rows) instance) self-type))
    (let site (call equality-site types program value))
    (call infer-binary-values site .equals-op site value site value)
    (call (. instances set-returns) instance (. types bool-type) (. types bool-type) .return-declared)
    (call finish-errors frame)
    (call close)
  )
  (fn-do _ note-unit-errors _
    (param unit InstanceId)
    (param site SyntaxId)
    ; The errors a unit the function runs lets out, which leave the function at a node.
    (if (not (call (. instances errors-known) unit))
      (call defer-outgoing unit site)
      (return)
    )
    (let signature ([] (. instances signatures) unit))
    (for (in offset (..< 0 (. signature errors count)))
      (call note-outgoing ([] (. instances signature-types) (+ (. signature errors start) offset)) site)
    )
  )
  (fn-do _ replay-member _
    (param unit InstanceId)
    ; A constructor runs the values of the properties it is not given, so it may panic where they
    ; do, and makes the calls they make. The calls are those of the property's own module: a
    ; constructor in another module has no place in its own source to put them.
    (let value ([] (. instances rows) unit))
    (let reader ([] (. instances rows) instance))
    (if (and (== (. reader initializer) 0) (== (. reader module) (. value module)) (== (. reader decl) (. value decl)))
      (return)
    )
    (if (. value may-panic)
      (call (. instances mark-may-panic) instance)
    )
    (if (. value polls)
      (call (. instances mark-polls) instance)
    )
    (if (!= (. value module) module)
      (return)
    )
    (call (. facts replay-calls) unit instance)
  )
  (fn-do _ check-field-default _
    (param position U32)
    ; The value a tuple's type writes for a field a call of its constructor leaves out, typed where
    ; the call is, as `check-property-defaults` types every value for a constructor given no field.
    ; The constructor lets out the errors an eager one may raise, at its class.
    (let receiver (. ([] (. instances rows) instance) self-type))
    (if (or (== (. ([] (. instances signatures) instance) args count) 0) (== receiver no-type) (== receiver invalid-type))
      (return)
    )
    (= (. frame declaration) (!! described))
    (call (. conversions attach) this)
    (call (. calls attach) this)
    (let opened (call open-class-env receiver))
    (= (. frame outgoing-start) (. scratch outgoing mark))
    (call (. types complete) receiver)
    (let filled 0u32)
    (for (in property (call (. types properties-of) receiver))
      (if (== (. property slot) (. U32 max))
        (continue)
      )
      (if (and (== filled position) (!= (. property storage-kind) .storage-getter))
        (= last-unit no-instance)
        (call demand-member property receiver (. property name) true)
        (if (and (== (. property storage-kind) .storage-eager) (!= last-unit no-instance) other-unit)
          (call note-unit-errors last-unit (call owner-syntax))
          (call note-default-use last-unit)
        )
        (lazy other-unit (!= last-unit instance))
        (if (== (. property storage-kind) .storage-eager)
          (call construct-default property receiver)
        )
      )
      (+= filled 1)
    )
    (if opened
      (call (. frame close-env))
    )
    (call finish-errors frame)
    (call (. scratch outgoing rewind) (. frame outgoing-start))
  )
  (fn-do _ type-written-defaults _
    ; Types, as the function is checked, each default written as a constant (`written-constant`),
    ; which the reference evaluates as the function's module starts whether or not a call takes
    ; it. Any other default is typed where a call first takes it (`type-default`).
    (let owner-module ([] (. program modules) module))
    (match? ([] (. owner-module decls) (. frame decl))
      (case (call .decl-function fn)
        (for (in position (..< 0 (. fn args count)))
          (let syntax (. ([] (. owner-module arg-pool) (+ (. fn args start) position)) default-syntax))
          (if (and (!= syntax 0) (call written-constant syntax) (call (. instances type-default) instance position))
            (call check-default position)
          )
        )
      )
    )
  )
  (fn-do _ written-constant Bool
    (param syntax SyntaxId)
    ; Whether a default is written as a constant as the reference tells one: a number, a text, a
    ; symbol, a truth, null, an operator on one of those, or a member named on a type.
    (match? ([] (. tree nodes) syntax)
      (case .node-integer-syntax
        (return true)
      )
      (case .node-float-syntax
        (return true)
      )
      (case .node-string-syntax
        (return true)
      )
      (case .node-symbol
        (return true)
      )
      (case (call .node-identifier row)
        (return (or (== (. row name) (. types true-atom)) (== (. row name) (. types false-atom)) (== (. row name) (. types null-atom))))
      )
      (case (call .node-unary-expression row)
        (return (call written-constant (. row operand)))
      )
      (case (call .node-get-expression row)
        (return (and (not (. row is-tracked)) (not (. row is-optional)) (call is-type-syntax tree (. row object))))
      )
    )
    (return false)
  )
  (fn-do _ check-default _
    (param position U32)
    ; Types the default a parameter declares, as the parameter's type expects it. A default that
    ; is no literal and gives another type is converted to the parameter's type where it is
    ; written, for the calls that take it; a literal is converted at each call. One that no
    ; conversion takes to the parameter's type is reported by no call that gives the argument.
    (let owner-module ([] (. program modules) module))
    (match? ([] (. owner-module decls) (. frame decl))
      (case (call .decl-function fn)
        (if (>= position (. fn args count))
          (return)
        )
        (let shape ([] (. owner-module arg-pool) (+ (. fn args start) position)))
        (if (== (. shape default-syntax) 0)
          (return)
        )
        (let slot (call argument-slot position))
        (let expected (if-expr (!= slot no-slot) (call (. frame slot-type) slot) no-type))
        (if (and (call (. tree is-empty-list) (. shape default-syntax)) list-expected)
          (call (. facts set-node-type) instance (. shape default-syntax) expected)
          (call (. calls note-list) (. shape default-syntax) expected)
          (return)
        )
        (lazy list-expected (!= (call (. types ancestor-of) expected (. types list-decl)) no-type))
        (let given (call infer-with-expected (. shape default-syntax) expected))
        (let literal (call literal-type types module tree (. shape default-syntax) (. frame env)))
        (let converts
          (scope (and typed-default (!= given expected) (!= given invalid-type))
            (lazy typed-default (and (== literal invalid-type) (!= expected no-type)))
          )
        )
        (if (and converts (call relation-legal (call (. conversions compare-held) given expected)))
          (call (. conversions convert)
            (block
              (arg (. shape default-syntax))
              (arg (. shape default-syntax))
              (arg given)
              (arg expected)
              (arg .reason-default)
              (arg true)
              (arg true)
            )
          )
        )
      )
    )
  )
  (fn-do _ argument-slot SlotId
    (param position U32)
    (let seen 0u32)
    (let bound ([] (. bindings bindings) (. frame binding)))
    (for (in offset (..< 0 (. bound slots count)))
      (let slot (+ (. bound slots start) offset))
      (if (== (. ([] (. bindings slots) slot) kind) .slot-argument)
        (if (== seen position)
          (return slot)
        )
        (+= seen 1)
      )
    )
    (return no-slot)
  )
  (fn-do _ check-assertion _
    (param id SyntaxId)
    (param exception SyntaxId)
    (param condition SyntaxId)
    ; A condition is typed first, and what is raised under what the condition finds. What typing
    ; the condition left known, as a lazy local it evaluated, holds after it.
    (if (!= condition 0)
      (call note-truthiness condition condition (call infer-tested condition))
    )
    (let mark (. scratch narrowings mark))
    (if (!= condition 0)
      (call (. narrowing narrow-condition) condition true)
    )
    (let saved (. frame surround))
    (= (. frame surround) (= (. frame surround effects) (call exceptional-effects (. saved effects))))
    (let known (call (. frame save-members)))
    (let raised (call infer exception))
    (= (. frame surround) saved)
    (if (!= condition 0)
      (call (. frame restore-members) known)
      (call pop-conditional mark)
    )
    (if (or (== raised invalid-type) (== raised no-type))
      (return)
    )
    (if (call is-subtype types raised (. types panic-type))
      (call (. instances mark-may-panic) instance)
      (return)
    )
    (if (call is-subtype types raised (. types error-type))
      (call note-outgoing raised id)
      (call (. facts set-plan) instance id .plan-raise)
      (return)
    )
    (call (. frame diagnose) id .invalid-bang-return null raised)
  )
  (fn-expr _ is-class Bool
    (param decl DeclId)
    (match ([] (. ([] (. program modules) module) decls) decl)
      (case .decl-class
        (!= decl 0)
      )
      (default
        false
      )
    )
  )
  (fn-do _ check-equality _
    (param unit UnitDecl)
    ; An equality relates two units wherever they meet, so it is public, and each side of it
    ; measures in a unit of its own. The type store declared it before anything was typed; one
    ; it could not evaluate is not a constant, at the first operation that gives no number.
    (if (not (call is-public (. unit access)))
      (call (. frame diagnose) (. unit syntax) .stated (call (. program store-atom) "Equalities must be public"))
      (return)
    )
    (if (or (call misstates-side (. unit number) true) (call misstates-side (. unit value) true))
      (return)
    )
    (let left (call (. types unit-amount) module tree (. unit number)))
    (let right (call (. types unit-amount) module tree (. unit value)))
    (for (in side (list left right))
      (if (and (!= (. side failed) 0) (!= (. side problem) ""))
        (call (. frame diagnose) (. side failed) .stated (call (. program store-atom) (. side problem)))
        (return)
      )
    )
    (if (or (!= (. left failed) 0) (!= (. right failed) 0))
      (let unevaluated (call (. tree unevaluated-operation) (. unit number)))
      (let failed (if-expr (!= unevaluated 0) unevaluated (call (. tree unevaluated-operation) (. unit value))))
      (call (. frame diagnose) (if-expr (!= failed 0) failed (. unit syntax)) .stated (call (. program store-atom) "Invalid constant expression"))
      (return)
    )
    (if (and (== (. left terms length) 0) (== (. right terms length) 0))
      (call (. frame diagnose) (. unit syntax) .stated (call (. program store-atom) "Ambiguous units"))
      (return)
    )
    (if (or (call zero-side left (. unit number)) (call zero-side right (. unit value)))
      (return)
    )
    (for (in term (call added-terms (. left terms) (. right terms) 1))
      (if (. ([] (. types completions) (. term unit)) is-builtin)
        (let shown (call type-short-name types (. term unit)))
        (let message
          (paragraph
            (str "An equality relates units a program declares, and " shown " is a number type of the language; write each side in a unit the program declares")
          )
        )
        (call (. frame diagnose) (. unit syntax) .stated (call (. program store-atom) message))
        (return)
      )
    )
    (if (and (not (call single-unit (. left terms))) (not (call single-unit (. right terms))))
      (let message
        (paragraph
          "An equality declares one unit, alone on one side, as an amount of others; write one side as a single unit, as in \"(unit + 1mps (/ 1meters 1s))\""
        )
      )
      (call (. frame diagnose) (. unit syntax) .stated (call (. program store-atom) message))
      (return)
    )
    (let families (. types unit-families))
    (let declared (call (. families declared-at) module (. unit syntax)))
    (if declared
      (if (not (. declared holds))
        (call disagrees declared)
      )
      (return)
    )
    (let derived (call (. families derived-at) module (. unit syntax)))
    (if derived
      (if (!= (. derived problem) .none)
        (call (. frame diagnose) (. unit syntax) .stated (call (. program store-atom) (call derived-problem derived)))
      )
      (return)
    )
    (call (. frame diagnose) (. unit syntax) .stated (call (. program store-atom) "Invalid constant expression"))
  )
  (fn-expr _ single-unit Bool
    (param terms (list UnitTerm))
    (and (== (. terms length) 1) (== (. ([] terms 0) power) 1))
  )
  (fn-do _ derived-problem String
    (param derived DerivedUnit)
    (let name (call type-short-name types (. derived type)))
    (let families (. types unit-families))
    (if (== (. derived problem) .own-family)
      (let named name)
      (for (in term (. derived terms))
        (if (or (== (. term unit) (. derived type)) (call (. families same-family) (. term unit) (. derived type)))
          (= named (call type-short-name types (. term unit)))
          (break)
        )
      )
      (return (str name " is declared from " named ", a unit of its own family; declare it from units of other families"))
    )
    (if (== (. derived problem) .circular)
      (return (str name " is declared from units that are declared from " name "; declare one of them from units of other families"))
    )
    (return (str name " is declared as " (call terms-text (. derived terms)) ", but other equalities make it one with a unit that measures something else; keep one of them"))
  )
  (fn-do _ terms-text String
    (param terms (list UnitTerm))
    (let above (list String))
    (let below (list String))
    (for (in term terms)
      (let shown (call type-short-name types (. term unit)))
      (for (in _ (..< 0 (if-expr (< (. term power) 0) (- (. term power)) (. term power))))
        (if (< (. term power) 0)
          (+= below shown)
          (else
            (+= above shown)
          )
        )
      )
    )
    (let top (if-expr (== (. above length) 0) "1" (call (. " times " join) above)))
    (return (if-expr (== (. below length) 0) top (str top " per " (call (. " per " join) below))))
  )
  (fn-do _ zero-side Bool
    (param side UnitAmount)
    (param place SyntaxId)
    (if (!= (. side amount) 0.0)
      (return false)
    )
    (let message
      (if-expr (== (. side terms length) 0)
        "A unit cannot be declared as zero, which no number of it would convert from; write a number other than zero"
        "A unit cannot be declared as zero of another, which no number of it would convert from; write a number other than zero"
      )
    )
    (call (. frame diagnose) place .stated (call (. program store-atom) message))
    (return true)
  )
  (fn-expr _ unit-label String
    (param type TypeId)
    (if-expr (== type number-member) "plain numbers" (call type-short-name types type))
  )
  (fn-expr _ amount-in String
    (param amount F64)
    (param type TypeId)
    (if-expr (== type number-member) (str amount) (str amount " " (call type-short-name types type)))
  )
  (fn-do _ disagrees _
    (param edge UnitEdge)
    (let families (. types unit-families))
    (let from (call unit-label (. edge from)))
    (let to (call unit-label (. edge to)))
    (let stated (call ratio-value (. edge ratio)))
    (if (== (. edge from) (. edge to))
      (let message (str "An equality between " from " and itself makes 1 " from " " stated " " from ", but a unit is always 1 of itself; relate " from " to another unit"))
      (call (. frame diagnose) (. edge syntax) .stated (call (. program store-atom) message))
      (return)
    )
    (let implied (call ratio-value (call (. families ratio-between) (. edge from) (. edge to))))
    (let names (list String))
    (for (in step (call (. families path-between) (. edge from) (. edge to)))
      (+= names (call unit-label step))
    )
    (let implied-amount (call amount-in implied (. edge to)))
    (let stated-amount (call amount-in stated (. edge to)))
    (let message
      (if-expr (call (. families joins-directly) (. edge from) (. edge to))
        (str "Equalities between " from " and " to " disagree: one makes 1 " from " " implied-amount ", another " stated-amount "; keep one of them")
        (str "Equalities between " from " and " to " disagree: this one makes 1 " from " " stated-amount ", but through " (call listed-units names) " they make 1 " from " " implied-amount "; keep every path between two units in agreement")
      )
    )
    (call (. frame diagnose) (. edge syntax) .stated (call (. program store-atom) message))
  )
  (fn-expr _ listed-units String
    (param names (list String))
    (case? (< (. names length) 2)
      (call (. ", " join) names)
    )
    (default
      (str (call (. ", " join) ([] names (..< 0 (- (. names length) 1)))) " and " ([] names (- (. names length) 1)))
    )
  )
  (fn-do _ misstates-side Bool
    (param id SyntaxId)
    (param top Bool)
    (match? ([] (. tree nodes) id)
      (case (call .node-binary-expression row)
        (return (or (call misstates-side (. row lhs) false) (call misstates-side (. row rhs) false)))
      )
    )
    (return (call misstates-unit id top))
  )
  (fn-do _ misstates-unit Bool
    (param id SyntaxId)
    (param top Bool)
    ; Reports a side of a unit's declaration written as a number in a unit that names nothing, or
    ; as zero of a unit, which relates no number of one to the other, and says whether it did.
    (let text "")
    (let unit (? Atom) null)
    (match? ([] (. tree nodes) id)
      (case (call .node-integer-syntax row)
        (= text (. row value))
        (= unit (. row unit))
      )
      (case (call .node-float-syntax row)
        (= text (. row value))
        (= unit (. row unit))
      )
    )
    (if (not unit)
      (return false)
    )
    (if (== (call literal-unit id text unit) invalid-type)
      (return true)
    )
    (if (or (not top) (!= (as text F64) 0.0))
      (return false)
    )
    (let message
      (paragraph
        "A unit cannot be declared as zero of another, which no number of it would convert from; write a number other than zero"
      )
    )
    (call (. frame diagnose) id .stated (call (. program store-atom) message))
    (return true)
  )
  (fn-do _ declares-name Bool
    (param owner-module ModuleId)
    (param owner DeclId)
    (param name Atom)
    (param shared-only Bool)
    ; Whether a class or facet declares a member of a name, or one of the name that is not private.
    (let target ([] (. program modules) owner-module))
    (let members
      (match ([] (. target decls) owner)
        (case (call .decl-class row)
          (. row members)
        )
        (case (call .decl-extension row)
          (. row members)
        )
        (default
          (call (of RowRange DeclId))
        )
      )
    )
    (for (in member (call (. target members-named) members name))
      (let (tuple named is-shared _) (call (. target member-name) member))
      (if (and named (== named name) (or is-shared (not shared-only)))
        (return true)
      )
    )
    (return false)
  )
  (fn-expr _ class-name-of String
    (param ref DeclRef)
    (match ([] (. ([] (. program modules) (. ref module)) decls) (. ref decl))
      (case (call .decl-class row)
        (. row name text)
      )
      (default
        "its class"
      )
    )
  )
  (fn-expr _ facet-name-of String
    (param facet U32)
    (match ([] (. ([] (. program modules) ([] (. program facets modules) facet)) decls) ([] (. program facets decls) facet))
      (case (call .decl-extension row)
        (?? (?. (. row facet) text) "a facet")
      )
      (default
        "a facet"
      )
    )
  )
  (fn-do _ event-key Bool
    (param type TypeId)
    ; Whether a type keys an event: an integer, a `Char` or a `Bool`, or a tuple of an integer
    ; `index` and an integer `generation`, or a type named for such a tuple.
    (if (call is-integer-kind (call (. types intrinsic-of) type))
      (return true)
    )
    (let base (?? (call (. types base-of) type) no-type))
    (if (and (is ([] (. types rows) type) .type-class) (!= base no-type) (is ([] (. types rows) base) .type-tuple))
      (return (call event-key base))
    )
    (match? ([] (. types rows) type)
      (case (call .type-tuple row)
        (if (or (!= (. row fields count) 2) (!= (. row names count) 2))
          (return false)
        )
        (if (or (!= (. (call (. types child-name) (. row names) 0) text) "index") not-generation)
          (return false)
        )
        (lazy not-generation (!= (. (call (. types child-name) (. row names) 1) text) "generation"))
        (return
          (scope (and integer-index (call is-integer-kind (call (. types intrinsic-of) (call (. types child-type) (. row fields) 1))))
            (lazy integer-index (call is-integer-kind (call (. types intrinsic-of) (call (. types child-type) (. row fields) 0))))
          )
        )
      )
    )
    (return false)
  )
  (fn-do _ check-closure-rows _
    (param body SyntaxId)
    (return-if (if (or (!= (call (. tree first-unexpressed) body false) 0) (!= (call (. tree first-unexpressed) body true) 0))))
    (blank)
    (let stated (call first-stated body))
    (if (!= stated 0)
      (call (. frame diagnose) stated .stated (call (. program store-atom) (call (. tree requires-do-text) stated)))
    )
  )
  (fn-expr _ first-stated SyntaxId
    (param body SyntaxId)
    (match ([] (. tree nodes) body)
      (case (call .node-block row)
        (call first-stated-row (. row body))
      )
      (default
        0
      )
    )
  )
  (fn-do _ first-stated-row SyntaxId
    (param rows (of RowRange SyntaxId))
    (let result Index (. rows count))
    (for (in position (..< 0 (. rows count)))
      (if (not (call (. tree is-trailing-row) ([] (. tree children) (+ (. rows start) position))))
        (= result position)
      )
    )
    (for (in position (..< 0 (. rows count)))
      (let statement ([] (. tree children) (+ (. rows start) position)))
      (match? ([] (. tree nodes) statement)
        (case .node-assign
          (return statement)
        )
        (case .node-if-block
          (return statement)
        )
        (case .node-call-expression
          (return-if statement (if (< (as position Index) result)))
        )
        (case (call .node-declare row)
          (return-if statement (if (and (. row is-lazy) (< result (. rows count)) comes-first)))
          (blank)
          (lazy comes-first (call precedes module statement module ([] (. tree children) (+ (. rows start) result))))
        )
      )
    )
    (return 0)
  )
  (fn-do _ family-root TypeId
    (param sheet TypeId)
    (let root sheet)
    (while true
      (call (. types complete) root)
      (let base (?? (call (. types base-of) root) no-type))
      (if (not (call is-sheet-type base))
        (return root)
      )
      (= root base)
    )
  )
  (fn-expr _ part-members (of RowRange DeclId)
    (param ref DeclRef)
    ; The members a class, a facet of one, or an extension of a style sheet, declares.
    (match ([] (. ([] (. program modules) (. ref module)) decls) (. ref decl))
      (case (call .decl-class row)
        (. row members)
      )
      (case (call .decl-extension row)
        (. row members)
      )
      (case (call .decl-sheet-extension row)
        (. row members)
      )
      (default
        (call (of RowRange DeclId))
      )
    )
  )
  (fn-do _ holder-env TypeEnv
    (param ref DeclRef)
    ; The types the members of a class, a facet of one, or an extension of a style sheet, are written
    ; under: those of the class, the facet's class, or the sheet it extends.
    (let sheet (call extended-sheet ref))
    (if sheet
      (return (call (. types class-env) (. sheet module) (. sheet decl)))
    )
    (let facets (. program facets))
    (let facet (only-if (call (. facets index-of) (. ref module) (. ref decl)) (if (!= (. facets count) 0))))
    (if facet
      (return (call (. types class-env) ([] (. facets owner-modules) facet) ([] (. facets owner-decls) facet)))
    )
    (return (call (. types class-env) (. ref module) (. ref decl)))
  )
  (fn-do _ written-type-name (? String)
    (param written AST)
    (param id SyntaxId)
    ; A type as the reference names it to tell style rules apart (`getTypeName`): an identifier by its
    ; name, followed by the names of the type arguments written after it; a tuple, a struct and a
    ; list by those of what they hold; nothing written as nothing. None for another way of writing
    ; one.
    (if (== id 0)
      (return "")
    )
    (match? ([] (. written nodes) id)
      (case (call .node-type-identifier row)
        (return (. row name text))
      )
      (case (call .node-type-arguments row)
        (let base (call written-type-name written (. row base)))
        (if (not base)
          (return null)
        )
        (let text base)
        (for (in arg ([] (. written children) (. row args)))
          (let held (call written-type-name written arg))
          (if (not held)
            (return null)
          )
          (+= text (str "'" held))
        )
        (return text)
      )
      (case (call .node-type-tuple row)
        (let names (call written-type-names written (. row field-types)))
        (if (not names)
          (return null)
        )
        (return (if-expr (. row is-struct) (str "struct(" names ")") (str "tuple(" names ")")))
      )
      (case (call .node-type-list row)
        (let names (call written-type-names written (. row patterns)))
        (if (not names)
          (return null)
        )
        (return (str "list(" names ")"))
      )
      (case (call .node-type-capture row)
        (return (call written-type-name written (. row type)))
      )
    )
    (return null)
  )
  (fn-do _ written-type-names (? String)
    (param written AST)
    (param ids (of RowRange SyntaxId))
    ; The names of types written in a row, as `written-type-name` names each, joined by commas.
    (let text "")
    (for (in offset (..< 0 (. ids count)))
      (let held (call written-type-name written ([] (. written children) (+ (. ids start) offset))))
      (if (not held)
        (return null)
      )
      (if (!= offset 0)
        (+= text ",")
      )
      (+= text held)
    )
    (return text)
  )
  (fn-do _ check-statement TypeId
    (param id SyntaxId)
    (param want Want (= (call Want)))
    (if (== id 0)
      (return no-type)
    )
    (let stated (call (. want adding) .want-statement))
    (if (call is-leaving id)
      (call (. facts mark-leaving) instance id)
    )
    (blank)
    (match ([] (. tree nodes) id)
      (case (call .node-block row)
        (return (call check-block id (. row body) (== id quasi-free-block) (call (. want asks) .want-match-statement)))
      )
      (case (call .node-declare row)
        (if (not (. row is-lazy))
          (call require-do id "Immediate declaration requires do")
        )
        (if (call declares-getter (. row left))
          (return no-type)
        )
        (if (or (not (. row is-lazy)) (not (call waits-for-read (. row left))))
          (call check-declare (. row left) (call (. tree machine-or-value) (. row left) (. row right)) (. row is-lazy))
        )
        (if (or (. row is-lazy) (and (not (call (. tree is-plain-name) (. row left))) (not (call is-typed-name (. row left)))))
          (call (. frame doubt-members))
        )
        (return no-type)
      )
      (case (call .node-return row)
        (call note-explicit-return id (. row expr))
        (call check-return id (. row expr) false)
        (return no-type)
      )
      (case (call .node-return-if-true row)
        (call note-explicit-return id (. row expr))
        (call note-truthiness (. row condition) (. row condition) (call infer-tested (. row condition)))
        (let mark (. scratch narrowings mark))
        (call (. narrowing narrow-condition) (. row condition) true)
        (let known (call (. frame save-members)))
        (call check-return id (. row expr) true)
        (call (. frame restore-members) known)
        (call pop-conditional mark)
        (call (. narrowing narrow-condition) (. row condition) false)
        (return no-type)
      )
      (case (call .node-if-block row)
        (if (call is-region id)
          (call decline id)
          (return no-type)
        )
        (call check-if id (. row condition) (. row body) (. row next))
        (return no-type)
      )
      (case (call .node-while-block row)
        (call require-do id "Loop requires do")
        (call check-while id (. row condition) (. row body))
        (return no-type)
      )
      (case (call .node-assertion-syntax row)
        (call check-assertion id (. row exception) (. row condition))
        (if (!= (. row condition) 0)
          (call (. narrowing narrow-condition) (. row condition) false)
        )
        (return no-type)
      )
      (case (call .node-yield row)
        (call require-do id "Yield requires do")
        (call (. frame check-suspends) id)
        (call note-yield (call yielded-value id (. row expr)) id false (call written-literal (. row expr)))
        (call note-escape (. row expr))
        (if (or cleans-up (!= loop-depth 0))
          (call (. frame doubt-members))
        )
        (return no-type)
      )
      (case (call .node-do-block row)
        (if (!= (call nested-decl-of id) 0)
          (call check-region id (. row body))
          (return no-type)
        )
        (let saved (. frame surround))
        (= (. frame surround) (= (. frame surround effects) (call dispatch-effects (/or/ (. saved effects) (. row compilation-effects)))))
        (if (and (== (/and/ (. saved effects) (. CompilationEffect gc-free)) 0) enters-gc-free)
          (= (. frame surround) (= (. frame surround zone-site) id))
        )
        (lazy enters-gc-free (!= (/and/ (. row compilation-effects) (. CompilationEffect gc-free)) 0))
        (+= do-depth 1)
        (call check-steps (. row body))
        (-= do-depth 1)
        (= (. frame surround) saved)
        (return no-type)
      )
      (case .node-noop
        (return no-type)
      )
      (case (call .node-probe-statement row)
        (if (call compiles-probe id)
          (call check-statement (. row body))
        )
        (return no-type)
      )
      (case (call .node-probe-scope row)
        (if (call compiles-probe id)
          (for (in statement ([] (. tree children) (. row body)))
            (call check-statement statement)
          )
        )
        (return no-type)
      )
      (case (call .node-probe row)
        (if (call compiles-probe id)
          (call check-probe id row)
        )
        (return no-type)
      )
      (case (call .node-probe-counter row)
        (if (call compiles-probe id)
          (call check-probe-counter id row)
        )
        (return no-type)
      )
      (case (call .node-probe-group row)
        (if (call compiles-probe id)
          (call check-probe-group id row)
        )
        (return no-type)
      )
      (case (call .node-probe-assign row)
        (if (call compiles-probe id)
          (call check-probe-assign id row)
        )
        (return no-type)
      )
      (case .node-probe-snapshot
        (return no-type)
      )
      (case .node-probe-preview
        (return no-type)
      )
      (case .node-break
        (if (call leaves-cleanup)
          (call report-cleanup-leave id "break")
          (else-if (and (== (. loop-marks length) 0) (call is-subscriber-body))
            (call demand-unsubscribe id)
          )
          (else-if (== (. loop-marks length) 0)
            (call (. frame diagnose) id .stated (call (. program store-atom) "`break` outside a loop"))
          )
        )
        (return no-type)
      )
      (case .node-continue
        (if (call leaves-cleanup)
          (call report-cleanup-leave id "continue")
          (else-if (and (== (. loop-marks length) 0) (not (call is-subscriber-body)))
            (call (. frame diagnose) id .stated (call (. program store-atom) "`continue` outside a loop"))
          )
        )
        (return no-type)
      )
      (case (call .node-for-block row)
        (call require-do id "Loop requires do")
        (call check-for id (. row loop) (. row body) (. row next))
        (call (. frame forget-members))
        (return no-type)
      )
      (case (call .node-do-finally-block row)
        (= cleans-up true)
        (+= do-depth 1)
        (call (. frame doubt-members))
        (let finished (call check-statement (. row body)))
        (call (. frame doubt-members))
        (-= do-depth 1)
        (return finished)
      )
      (case (call .node-use-block row)
        (call check-use id (. row subject))
        (call (. frame doubt-members))
        (= discarding-block (. row body))
        (call check-steps (. row body))
        (call (. frame doubt-members))
        (return no-type)
      )
      (case (call .node-do-task-block row)
        (if (and (!= (. row worker) 0) (. row is-parallel))
          (call (. frame diagnose) id .stated (call (. program store-atom) (call (. tree both-targets-text))))
          (else-if (!= (. row worker) 0)
            (call check-worker id (. row worker))
          )
        )
        (call (. frame doubt-members))
        (call check-task id)
        (return no-type)
      )
      (case (call .node-stack-local-binding-block row)
        (= cleans-up true)
        (call (. frame doubt-members))
        (call check-stack-binding id (. row value) (. row body))
        (call (. frame doubt-members))
        (return no-type)
      )
      (case (call .node-iterator-expression row)
        (if (and (== (. frame declaration syntax) id) (call is-subscriber-body))
          (call check-broadcast id (. row loop) (. row body))
          (return no-type)
        )
        (if (== (. frame declaration syntax) id)
          (call check-comprehension (. row loop) (. row body))
          (return no-type)
        )
        (return (call infer id stated))
      )
      (case (call .node-pipeline-expression row)
        (if (and (== (. frame declaration syntax) id) (== (. row op) .grammar-pipe-op))
          (call check-pattern-pipe id (. row right))
          (return no-type)
        )
        (return (call infer id stated))
      )
      (case (call .node-binary-expression row)
        (if (and (== (. frame declaration syntax) id) (== (. row op) .grammar-pipe-op))
          (call check-pattern-pipe id (. row rhs))
          (return no-type)
        )
        (return (call infer id stated))
      )
      (case .node-feed-expression
        (if (== (. frame declaration syntax) id)
          (call check-feeds id)
          (return no-type)
        )
        (return (call infer id stated))
      )
      (case .node-state-machine
        (do
          (inline (call check-machine-site id))
        )
        (return no-type)
      )
      (default
        (return (call infer id stated))
      )
    )
  )
  (fn-do _ check-stack-binding _
    (param id SyntaxId)
    (param value-syntax SyntaxId)
    (param body SyntaxId)
    (let resolution (call (. bindings resolution-of) (. frame binding) id))
    (if (and (== (. resolution kind) .resolve-global) (is ([] (. ([] (. program modules) (. resolution module)) decls) (. resolution decl)) .decl-effect))
      (call check-effect-binding id value-syntax body (. resolution module) (. resolution decl))
      (return)
    )
    (let declared no-type)
    (if (== (. resolution kind) .resolve-global)
      (= declared (call demand-global id (. resolution module) (. resolution decl)))
    )
    (let value (call infer value-syntax))
    (if (and (== (. resolution kind) .resolve-global) (!= value invalid-type))
      (call (. conversions convert) id value-syntax value declared .reason-assignment)
    )
    (if (== (. resolution kind) .resolve-global)
      (let first (call (. tree subtree-start) body))
      (call (. facts stack-scopes append)
        (block
          (arg (call StackScope instance first body (. resolution module) (. resolution decl) 0))
        )
      )
    )
    (= discarding-block body)
    (call check-steps body)
  )
  (fn-do _ check-effect-binding _
    (param id SyntaxId)
    (param value-syntax SyntaxId)
    (param body SyntaxId)
    (param module ModuleId)
    (param decl DeclId)
    ; `do with` an effect: the body runs with the fake bound to it, an object of a class whose methods
    ; answer the effect's doors that the body reaches. The body is typed as code outside every
    ; binding: each door reads the fake from the effect's slot (`Restrictions` checks the class).
    (let value (call infer value-syntax))
    (let effect (call (. program effects index-of) module decl))
    (let entry U32)
    (if (and (!= value invalid-type) (or (not (call (. types is-class-type) value)) (call (. types is-optional) value)))
      (call (. frame diagnose) value-syntax .stated (call (. program store-atom) (call fake-class-text module decl value)))
      (else-if (and effect (>= effect (call most-effects)))
        (call (. frame diagnose)
          (block
            (arg id)
            (arg .stated)
            (arg
              (call (. program store-atom)
                (block
                  (arg
                    (paragraph
                      (str "A program can bind at most " (call most-effects) " effects, and '" (. ([] (. program effects names) effect) text) "' is past them")
                    )
                  )
                )
              )
            )
          )
        )
      )
      (else-if (and (!= value invalid-type) effect)
        (= entry (call (. instances intern-swap-entry) (call SwapEntry effect value)))
      )
    )
    (call (. facts stack-scopes append) (call StackScope instance (call (. tree subtree-start) body) body module decl entry))
    (= discarding-block body)
    (call check-steps body)
  )
  (fn-do _ fake-class-text String
    (param module ModuleId)
    (param decl DeclId)
    (param value TypeId)
    (let name (. ([] (. program effects names) (?? (call (. program effects index-of) module decl) 0)) text))
    (return (str "A fake bound to '" name "' is an object of a class, not " (call type-short-name types value)))
  )
  (fn-do _ redeclares-in Bool
    (param block SyntaxId)
    ; Whether a block declares a local again that it declared in an earlier statement, which the
    ; binder leaves to the type pass to settle.
    (if (== (. frame binding) no-binding)
      (return false)
    )
    (let range (. ([] (. bindings bindings) (. frame binding)) diagnostics))
    (let start (call (. tree subtree-start) block))
    (for (in diagnostic ([] (. bindings diagnostics) (..< (. range start) (. range end))))
      (if (and (== (. diagnostic kind) .redeclared) (>= (. diagnostic syntax) start) (<= (. diagnostic syntax) block))
        (return true)
      )
    )
    (return false)
  )
  (fn-do _ projects Bool
    ; Whether the reference opens a scope before a statement here (`pushFlowProjectionScope`). It
    ; does where a local that holds an optional, and that nothing assigns, is known by a test to hold
    ; a value, and makes a local of the value in that scope, which the blocks inside see as well
    ; (`materialized`): it opens none for that local again there. An optional of a tuple keeps its
    ; place.
    (let opens false)
    (for (in slot (call (. frame tested-locals)))
      (let known (call slot-known slot))
      (if (or (!= (/and/ (. ([] (. bindings slots) slot) flags) (. SlotFlag slot-assigned)) 0) (not (call (. types is-optional) known)))
        (continue)
      )
      (let inner (call (. types optional-inner) known))
      (if (or (== (call (. types intrinsic-of) inner) .tuple) (!= (call (. frame slot-type) slot) inner) projected)
        (continue)
      )
      (lazy projected (!= (call (. materialized find) slot) null))
      (+= materialized slot)
      (= opens true)
    )
    (return opens)
  )
  (fn-do _ settle-redeclared _
    (param statement SyntaxId)
    (param projected SyntaxId)
    ; A local a statement declares again, where an earlier statement of its block declared it, is
    ; a new one past a scope the reference opened after that statement (`projects`), as the
    ; reference declares it there. With no such scope it is declared twice in one scope.
    (let range (. ([] (. bindings bindings) (. frame binding)) diagnostics))
    (let start (call (. tree subtree-start) statement))
    (for (in diagnostic ([] (. bindings diagnostics) (..< (. range start) (. range end))))
      (if (or (!= (. diagnostic kind) .redeclared) (< (. diagnostic syntax) start) (> (. diagnostic syntax) statement))
        (continue)
      )
      (if (>= (. diagnostic earlier) start)
        (continue)
      )
      (if (or (== projected 0) (<= (call (. tree subtree-start) projected) (. diagnostic earlier)))
        (call (. frame diagnose)
          (block
            (arg (. diagnostic syntax))
            (arg .stated)
            (arg (call (. program store-atom) "Redefining variable in same scope"))
          )
        )
      )
    )
  )
  (fn-do _ check-block TypeId
    (param block SyntaxId)
    (param body (of RowRange SyntaxId))
    (param skips-quasi Bool)
    (param matched Bool (= false))
    ; The value of a block is that of its one statement that gives one. A block whose last
    ; statement leaves, by a raise under no condition, a return, `continue` or `break`, never
    ; ends, and gives none; the block and that statement are noted as leaving. The statements
    ; after one that leaves are not checked, but for lazy locals, as the reference compiles none of
    ; them; in markup content a statement that leaves is an error instead. A statement that
    ; names what it does not call is checked (`check-called`) unless it gives the block its value:
    ; the last of a block the reference keeps the value of, which a `discarding-block` is not. The
    ; arms of a block a match written as a statement runs (`matched`) are that match's. A match whose
    ; value nothing uses, in a body of steps, runs its arms as steps (`runs-steps`). The value of the
    ; body of an arm whose match gives one (`arm-block`) is that of the row it ends on alone, and the
    ; rows before it run as steps.
    (let mark (. scratch narrowings mark))
    (let discards (== block discarding-block))
    (let steps-body (and (== block steps-block) (!= block (. matching arms))))
    (let arm-row (if-expr (== block arm-block) (call (. tree arm-value) block) 0))
    (let valued (if-expr (== block expected-block) block-expected no-type))
    (= steps-block 0)
    (= arm-block 0)
    (= expected-block 0)
    (let last (if-expr (!= (. body count) 0) ([] (. tree children) (- (+ (. body start) (. body count)) 1)) 0))
    (let kept (call (. tree kept-row) body))
    (let value no-type)
    (let values 0)
    (let leaves false)
    (let final-leave SyntaxId 0)
    (let finals (list SyntaxId))
    (let limits (list SyntaxId))
    (let open 0)
    (let parent (call content-parent block))
    (let attributes (and (!= parent no-type) (!= (call (. element-bodies find) block) null)))
    (let awaiting (call await-elements body block))
    (if (!= (. unbuilt length) awaiting)
      (call raise-elements block body)
    )
    (let placing (call awaits-unmade awaiting))
    (let redeclares (call redeclares-in block))
    (let materialized-mark (. materialized length))
    (let projected SyntaxId 0)
    (let dead false)
    (for (in statement ([] (. tree children) body))
      (if (and dead (not (call (. tree is-lazy-declare) statement)))
        (continue)
      )
      (if redeclares
        (if (call projects)
          (= projected statement)
        )
        (call settle-redeclared statement projected)
      )
      (if (and (== block rule-lines) (call (. tree rule-part) statement))
        (continue)
      )
      (if (call (. tree is-finally) statement)
        (+= finals statement)
        (+= limits 0)
        (continue)
      )
      (if (and attributes (or (is ([] (. tree nodes) statement) .node-assign) (call binds-slot statement)))
        (call (. facts note-content-link) (call ContentLink instance statement parent no-type no-fact))
        (continue)
      )
      (if (and (!= parent no-type) (call (. tree element-fill) statement))
        (call (. facts note-content-link) (call ContentLink instance statement parent no-type no-fact))
        (continue)
      )
      (let hosted (. content-blocks length))
      (let reported (. facts diagnostics length))
      (if placing
        (call raise-statement statement)
      )
      (if (!= parent no-type)
        (call host-content statement parent)
      )
      (let calls-before U32 (as (. facts calls length) U32))
      (let declared declared-return)
      (if (and skips-quasi arms-line (!= declared no-type) (!= declared (. types void-type)))
        (call note-returned-match statement declared)
        (= arms-expected declared)
      )
      (lazy arms-line (call (. tree is-arms-syntax) statement))
      (let named
        (scope (and skips-quasi (!= declared no-type) symbolic)
          (lazy symbolic (or (call (. tree calls-symbol) statement) (!= (call (. tree symbol-of) statement) null)))
        )
      )
      (let watches (< open (. finals length)))
      (if watches
        (+= watching-leaves 1)
      )
      (let want (call Want))
      (let steps (and (!= parent no-type) (call runs-content statement)))
      (if (!= parent no-type)
        (= want (call (. want adding) .want-content-line))
      )
      (let stepped (and (== parent no-type) (!= block (. matching arms)) (or discards steps-body (!= statement kept)) (call runs-steps statement) (not (call (. tree is-piped-row) body statement))))
      (if (or steps (and matched (call (. tree is-arms-syntax) statement)) stepped)
        (= want (call (. want adding) .want-match-statement))
      )
      (if skips-quasi
        (= want (call (. want adding) .want-quasi))
      )
      (if (and skips-quasi choice-statement (!= declared no-type) (!= declared (. types void-type)))
        (= want (call (. want asking) .want-choice declared))
      )
      (lazy choice-statement (call (. tree is-choice-syntax) statement))
      (if (or discards (!= statement last))
        (= want (call (. want adding) .want-unused))
      )
      (let expects-row
        (block
          (and (!= valued no-type) (or (call (. tree calls-symbol) statement) (!= (call (. tree symbol-of) statement) null)))
        )
      )
      (let produced
        (block
          (case? named
            (call infer-with-expected statement declared want)
          )
          (case? expects-row
            (call infer-with-expected statement valued want)
          )
          (default
            (call check-line statement parent want)
          )
        )
      )
      (if stepped
        (= produced no-type)
      )
      (if watches
        (-= watching-leaves 1)
      )
      (if (!= parent no-type)
        (while (!= (. content-blocks length) hosted)
          (call (. content-blocks pop))
          (call (. content-parents pop))
        )
        (if (not (call leaves-line statement))
          (if (not steps)
            (call link-content statement produced parent)
          )
          (let settles
            (scope (if-expr element-line attributes (call (. tree content-line) statement))
              (lazy element-line (!= (call (. tree content-element) statement) 0))
            )
          )
          (if (and settles (call is-live-statement statement))
            (call settle-content statement parent produced)
          )
          (else-if (== (. facts diagnostics length) reported)
            (call (. frame diagnose) statement .stated (call (. program store-atom) "Illegal return"))
          )
        )
        (else
          (let named (call named-element statement))
          (if (and named (!= produced invalid-type) (!= produced no-type))
            (call note-named statement (call (. frame slot-type) named))
          )
          (if (or discards (!= statement last))
            (call check-called statement produced (call is-step-position statement kept discards) body)
          )
        )
      )
      (if (and watches (call may-leave calls-before))
        (for (in position (..< open (. finals length)))
          (= ([] limits position) statement)
        )
        (= open (. finals length))
      )
      (let quasi (and skips-quasi (call (. tree is-quasi-syntax) statement)))
      (let counted (or (== arm-row 0) (== statement arm-row)))
      (if (and counted (!= produced no-type) (!= produced (. types void-type)) (not quasi))
        (= value produced)
        (= value-syntax statement)
        (+= values 1)
        (else-if (and counted (== produced (. types void-type)) (not quasi) (or (== declared no-type) (== declared produced)))
          (+= values 1)
        )
      )
      (if (not (call (. tree is-lazy-declare) statement))
        (let valued (and (!= produced no-type) (!= produced (. types void-type))))
        (= final-statement (if-expr (and valued (not (call (. tree is-quasi-syntax) statement))) statement 0))
        (= leaves (call is-leaving statement))
        (= final-leave statement)
        (= dead (and leaves (== parent no-type)))
      )
    )
    (for (in position (..< 0 (. finals length)))
      (call check-finally ([] finals position) ([] limits position))
    )
    (call settle-elements awaiting)
    (if leaves
      (call (. facts mark-leaving) instance block)
      (call (. facts mark-leaving) instance final-leave)
    )
    (let settled (call (. frame assigned-since) mark))
    (call (. frame pop-narrowing) mark)
    (call (. frame keep-assigned) settled)
    (if (!= (. materialized length) materialized-mark)
      (-= ([] materialized (..< materialized-mark (. materialized length))))
    )
    (return (if-expr (and (== values 1) (not leaves)) value no-type))
  )
  (fn-do _ check-called _
    (param statement SyntaxId)
    (param produced TypeId)
    (param is-step Bool (= false))
    (param body (of RowRange SyntaxId) (= (call (of RowRange SyntaxId))))
    ; A statement that only names a function, a closure or a method does nothing with it, and is
    ; the reference's error where nothing takes its value.
    (return-if (if (== produced invalid-type)))
    (blank)
    (let named (or (is ([] (. tree nodes) statement) .node-identifier) (is ([] (. tree nodes) statement) .node-get-expression)))
    (if (and named (!= produced no-type))
      (let kind (call (. types intrinsic-of) produced))
      (if (or (== kind .function) (== kind .closure) (== kind .binding))
        (let written (call description-of tree statement))
        (call (. frame diagnose)
          (block
            (arg statement)
            (arg .stated)
            (arg (call (. program store-atom) (str written " is never called; write " written "() to call it")))
          )
        )
        (return)
      )
    )
    (if (and is-step (call (. tree is-bare-value) statement) (not (call (. tree is-piped-row) body statement)))
      (call (. frame diagnose) statement .stated (call (. program store-atom) (call bare-value-text)))
    )
  )
  (fn-expr _ is-step-position Bool
    (param statement SyntaxId)
    (param kept SyntaxId)
    (param discards Bool)
    (case? (and discards (call is-constructor-kind (. frame declaration kind)))
      false
    )
    (case? (!= statement kept)
      true
    )
    (case? (or (not discards) (. frame declaration is-main))
      false
    )
    (default
      (not (or builds (== (. frame declaration kind) .function-decl) (== (. frame declaration kind) .getter-decl)))
    )
    (where
      (lazy builds (or (. giving yields) (call is-constructor-kind (. frame declaration kind))))
    )
  )
  (fn-expr _ is-leaving Bool
    (param statement SyntaxId)
    ; Whether a statement leaves its block. `=? value` of an optional leaves only where the
    ; optional holds a value, so it does not.
    (match ([] (. tree nodes) statement)
      (case (call .node-assertion-syntax row)
        (== (. row condition) 0)
      )
      (case (call .node-return row)
        (not (call returns-present (. row expr)))
      )
      (case .node-continue
        true
      )
      (case .node-break
        true
      )
      (default
        false
      )
    )
  )
  (fn-do _ returns-present Bool
    (param expr SyntaxId)
    ; Whether a return gives `=? value` of an optional, which leaves only where it holds a value,
    ; as the reference returns what it holds and goes on where it holds none. Before the value is
    ; typed, any `=? value` may be one.
    (if (== expr 0)
      (return false)
    )
    (match? ([] (. tree nodes) expr)
      (case .node-optional-chain
        (let value (call (. facts node-type) instance expr))
        (return (or (== value no-type) (and (!= value invalid-type) (call (. types is-optional) value))))
      )
    )
    (return false)
  )
  (fn-do _ may-leave Bool
    (param calls-before U32)
    ; Whether a statement just checked called something known to panic. A finally block runs
    ; wherever control leaves its block after it, so it sees only the locals declared before the
    ; first statement after it that may leave. A callee is
    ; known to panic once its body is typed, so a statement watched for this types the bodies of
    ; what it calls.
    (let position (call (. facts latest-call-of) instance))
    (while (and (!= position no-fact) (>= position calls-before))
      (let callee (. ([] (. facts calls) position) callee))
      (if (and (!= callee no-instance) (. ([] (. instances rows) callee) may-panic))
        (return true)
      )
      (= position (call (. facts prior-call) position))
    )
    (return false)
  )
  (fn-expr _ leaves-cleanup Bool
    ; Whether a `break` or `continue` here would leave a cleanup for a loop open around it.
    (and (. finally cleaning-up) (!= (. loop-marks length) 0) (== (. loop-marks length) (. finally loops)))
  )
  (fn-do _ report-cleanup-leave _
    (param id SyntaxId)
    (param word String)
    ; Reports a `break` or `continue` that would leave a cleanup, which runs however its block is
    ; left, for the loop around it.
    (let text
      (paragraph
        (str "A cleanup cannot \"" word "\" the loop around it, as it runs however its block is left; write \"" word "\" in the loop's body")
      )
    )
    (call (. frame diagnose) id .stated (call (. program store-atom) text))
  )
  (fn-do _ check-finally _
    (param statement SyntaxId)
    (param limit SyntaxId)
    (let saved finally)
    (= finally (= (. finally limit) limit))
    (= finally (= (. finally loops) (. loop-marks length)))
    (if (. saved cleaning-up)
      (call (. frame diagnose) statement .stated (call (. program store-atom) "Illegal deferred statement"))
    )
    (= finally (= (. finally cleaning-up) true))
    (call check-statement statement)
    (= finally saved)
  )
  (fn-expr _ waits-for-read Bool
    (param left SyntaxId)
    ; A lazy local takes its value where it is first read, under what is known there, and one
    ; nothing reads is never computed. One that gives a property its value is computed with the
    ; object.
    (and (!= slot null) (== (. ([] (. bindings slots) slot) property) 0))
    (where
      (lazy slot (call declaring-slot (call (. tree first-named) left)))
    )
  )
  (fn-expr _ declares-getter Bool
    (param left SyntaxId)
    ; Whether a declaration declares a local of a row of a markup loop region that the reference
    ; reads as a getter: its value is typed where it is read, and not where it is written.
    (and (!= slot null) (!= (. ([] (. bindings slots) slot) getter) 0))
    (where
      (lazy slot (call declaring-slot left))
    )
  )
  (fn-do _ check-declare _
    (param left SyntaxId)
    (param right SyntaxId)
    (param is-lazy Bool)
    (if (and is-lazy (call lazy-known left))
      (return)
    )
    (let value no-type)
    (if (!= right 0)
      (let slot (only-if (call declaring-slot left) (if is-lazy)))
      (if slot
        (call (. frame assign) slot invalid-type)
        (+= lazy-slots slot)
      )
      (call own-anonymous-cases left right)
      (let saved-eager reading)
      (if (and slot (!= (. ([] (. bindings slots) slot) property) 0))
        (= reading (= (. reading eager) true))
      )
      (= value (call infer-declared left right))
      (= reading saved-eager)
      (if slot
        (call (. lazy-slots pop))
      )
      (if (not is-lazy)
        (call note-escape right)
      )
      (if (and (not is-lazy) (not (call (. tree writes-type) left)))
        (call note-loose right)
      )
      (else
        (call construct-declared left)
      )
    )
    (call declare left value right)
  )
  (fn-do _ own-anonymous-cases _
    (param pattern SyntaxId)
    (param root SyntaxId)
    ; Gives the anonymous cases a declaration owns their union: every `..name` under its value
    ; that names this owner, payloads unified by case name, in source order. Payloads written as
    ; numbers with no suffix join others place by place, so `..value(1)` beside `..value(1.5)` holds
    ; a float.
    (let owner (call (. tree identifier-name) (call (. tree pattern-identifier) pattern)))
    (if (or (not owner) (!= (call anonymous-union owner) no-type))
      (return)
    )
    (let sites (list SyntaxId))
    (let held (list TypeId))
    (call hold-payloads root owner owner sites held)
    (let names (list Atom))
    (let payloads (list TypeId))
    (let counts (list U32))
    (let written (list Bool))
    (for (in position (..< 0 (. sites length)))
      (match? ([] (. tree nodes) ([] sites position))
        (case (call .node-anonymous-case row)
          (let payload ([] held position))
          (let literal (call written-payload (. row args)))
          (let known (call (. names find) (. row name)))
          (if (and (!= known null) (!= ([] counts known) (. row args count)))
            (call report-arity ([] sites position) (. row name))
            (else-if (and (!= known null) (!= payload invalid-type))
              (let joined (call (. relations unify) ([] payloads known) payload module))
              (if (call relation-legal joined)
                (= ([] payloads known) (. joined unified))
                (else
                  (let places (call (. relations joined-places) ([] payloads known) payload))
                  (if (and (!= places no-type) kept-written (or literal (== places payload)))
                    (= ([] payloads known) places)
                  )
                  (lazy kept-written (or ([] written known) (== places ([] payloads known))))
                )
              )
              (= ([] written known) (and ([] written known) literal))
            )
            (else-if (and (== known null) (!= payload invalid-type))
              (+= names (. row name))
              (+= payloads payload)
              (+= counts (. row args count))
              (+= written literal)
            )
          )
        )
      )
    )
    (if (== (. names length) 0)
      (return)
    )
    (let mark (. scratch types mark))
    (let names-mark (. scratch names mark))
    (for (in position (..< 0 (. names length)))
      (call (. scratch names push) ([] names position))
      (call (. scratch types push) ([] payloads position))
    )
    (+= owner-names owner)
    (+= owner-unions (call (. types intern-named-union) owner mark names-mark))
    (+= owner-declared true)
  )
  (fn-do _ hold-payloads _
    (param root SyntaxId)
    (param owner (? Atom))
    (param named Atom)
    (param sites (list SyntaxId))
    (param held (list TypeId))
    (let declared (!= owner null))
    (let waits false)
    (for (in id (.. (call (. tree subtree-start) root) root))
      (match? ([] (. tree nodes) id)
        (case (call .node-anonymous-case row)
          (if (call owns-case owner (. row owner))
            (let waiting (and (!= (. row args count) 0) (or (not declared) (call reads-untyped (. row args)))))
            (let reported (. facts diagnostics length))
            (let payload (if-expr waiting no-type (call anonymous-payload (. row args))))
            (if (and (== payload invalid-type) (== (. facts diagnostics length) reported))
              (call report-unheld id (. row name))
            )
            (+= sites id)
            (+= held payload)
            (= waits (or waits waiting))
          )
        )
      )
    )
    (if (not waits)
      (return)
    )
    (call foresee-payloads root named declared sites held)
    (for (in position (..< 0 (. sites length)))
      (if (and (== ([] held position) invalid-type) (== (call (. unheld-cases find) ([] sites position)) null))
        (+= unheld-cases ([] sites position))
      )
    )
  )
  (fn-do _ report-unheld _
    (param id SyntaxId)
    (param name Atom)
    (let message (str "Unable to infer payload type for anonymous case '.." (. name text) "'"))
    (call (. frame diagnose) id .stated (call (. program store-atom) message))
  )
  (fn-do _ reads-untyped Bool
    (param args (of RowRange SyntaxId))
    (let followed (list SlotId))
    (for (in arg ([] (. tree children) args))
      (if (call value-reads-untyped arg followed)
        (return true)
      )
    )
    (return false)
  )
  (fn-do _ value-reads-untyped Bool
    (param value SyntaxId)
    (param followed (list SlotId))
    (for (in id (.. (call (. tree subtree-start) value) value))
      (match? ([] (. tree nodes) id)
        (case .node-identifier
          (let resolution (call (. bindings resolution-of) (. frame binding) id))
          (if (and (== (. resolution kind) .resolve-slot) (call awaits-flow (. resolution slot)))
            (return true)
          )
          (if (and (== (. resolution kind) .resolve-slot) (call lazy-reads-untyped (. resolution slot) followed))
            (return true)
          )
        )
      )
    )
    (return false)
  )
  (fn-do _ lazy-reads-untyped Bool
    (param slot SlotId)
    (param followed (list SlotId))
    (let row ([] (. bindings slots) slot))
    (let unread (and (== (. row kind) .slot-lazy) (not (call (. frame is-captured) slot)) (== (call (. frame known) slot) no-type)))
    (if (or (not unread) (== (. row group) 0) (!= (call (. followed find) slot) null))
      (return false)
    )
    (+= followed slot)
    (match? ([] (. tree nodes) (. row group))
      (case (call .node-declare declaration)
        (return (call value-reads-untyped (. declaration right) followed))
      )
    )
    (return false)
  )
  (fn-do _ awaits-flow Bool
    (param slot SlotId)
    (if (or (call (. frame is-captured) slot) (!= (call (. frame known) slot) no-type))
      (return false)
    )
    (if (or (!= (. ([] (. bindings slots) slot) getter) 0) (call (. bindings is-placed) slot))
      (return false)
    )
    (let kind (. ([] (. bindings slots) slot) kind))
    (let named (or (== kind .slot-local) (== kind .slot-pattern) (== kind .slot-loop-item)))
    (return (or named (== kind .slot-it) (== kind .slot-each)))
  )
  (fn-do _ foresee-payloads _
    (param root SyntaxId)
    (param named Atom)
    (param declared Bool)
    (param sites (list SyntaxId))
    (param held (list TypeId))
    (let listed (list Atom))
    (let mark (. scratch types mark))
    (let names-mark (. scratch names mark))
    (for (in position (..< 0 (. sites length)))
      (match? ([] (. tree nodes) ([] sites position))
        (case (call .node-anonymous-case row)
          (if (== (call (. listed find) (. row name)) null)
            (+= listed (. row name))
            (call (. scratch names push) (. row name))
            (call (. scratch types push) (call first-held (. row name) sites held))
          )
        )
      )
    )
    (let provisional (call (. types intern-named-union) named mark names-mark))
    (let checker (call trial-checker root))
    (for (in position (..< 0 (. owner-names length)))
      (+= (. checker owner-names) ([] owner-names position))
      (+= (. checker owner-unions) ([] owner-unions position))
      (+= (. checker owner-declared) ([] owner-declared position))
    )
    (+= (. checker owner-names) named)
    (+= (. checker owner-unions) provisional)
    (+= (. checker owner-declared) declared)
    (= (. checker foreseen-union) provisional)
    (if (== root (. frame declaration body))
      (= (. checker value-syntax) root)
      (= (. checker quasi-free-block) (if-expr (. frame declaration is-imperative) 0 root))
      (= (. checker discarding-block)
        (scope (if-expr imperative-body root 0)
          (lazy imperative-body (or (. frame declaration is-imperative) builds))
          (lazy builds (== (. frame declaration kind) .constructor-decl))
        )
      )
    )
    (let reported (. facts diagnostics length))
    (+= (. scratch runners) checker)
    (+= (. scratch running) (. checker instance))
    (call (. checker check-statement) root)
    (call (. scratch runners pop))
    (call (. scratch running pop))
    (call (. facts drop-trial-diagnostics) reported (. checker instance))
    (for (in position (..< 0 (. sites length)))
      (if (== ([] held position) no-type)
        (= ([] held position) (call (. checker foreseen-payload) ([] sites position)))
      )
    )
    (call (. checker close))
    (call (. checker retire))
  )
  (fn-do _ foreseen-payload TypeId
    (param site SyntaxId)
    (let payload invalid-type)
    (for (in position (..< 0 (. foreseen-sites length)))
      (if (and (== ([] foreseen-sites position) site) (!= ([] foreseen-payloads position) invalid-type))
        (= payload ([] foreseen-payloads position))
      )
    )
    (return payload)
  )
  (fn-do _ foreseer-of (? Checker)
    (param union TypeId)
    (if (== foreseen-union union)
      (return this)
    )
    (if outer
      (return (call (. outer foreseer-of) union))
    )
    (return null)
  )
  (fn-do _ first-held TypeId
    (param name Atom)
    (param sites (list SyntaxId))
    (param held (list TypeId))
    (for (in position (..< 0 (. sites length)))
      (match? ([] (. tree nodes) ([] sites position))
        (case (call .node-anonymous-case row)
          (if (and (== (. row name) name) (!= ([] held position) no-type) (!= ([] held position) invalid-type))
            (return ([] held position))
          )
        )
      )
    )
    (return (. types void-type))
  )
  (fn-do _ written-payload Bool
    (param args (of RowRange SyntaxId))
    ; Whether each value an anonymous case is given is written as a number with no suffix.
    (return-if false (if (== (. args count) 0)))
    (return (call all ([] (. tree children) args) (:where (!= (call (. conversions literal-of) each) 0))))
  )
  (fn-do _ report-arity _
    (param id SyntaxId)
    (param name Atom)
    ; One anonymous case holds the same number of values wherever its owner names it.
    (let message (str "Anonymous case '.." (. name text) "' has conflicting arity"))
    (call (. frame diagnose) id .stated (call (. program store-atom) message))
  )
  (fn-do _ anonymous-payload TypeId
    (param args (of RowRange SyntaxId))
    (if (== (. args count) 0)
      (return (. types void-type))
    )
    (let mark (. scratch types mark))
    (let names-mark (. scratch names mark))
    (let position 0u32)
    (for (in arg ([] (. tree children) args))
      (let type (call infer arg))
      (if (== type invalid-type)
        (call (. scratch types rewind) mark)
        (call (. scratch names rewind) names-mark)
        (return invalid-type)
      )
      (call (. scratch names push) (call (. types index-atom) position))
      (call (. scratch types push) type)
      (+= position 1)
    )
    (if (== position 1)
      (let single ([] (. scratch types) mark))
      (call (. scratch types rewind) mark)
      (call (. scratch names rewind) names-mark)
      (return single)
    )
    (return (call (. types intern-tuple) mark names-mark))
  )
  (fn-do _ anonymous-union TypeId
    (param owner Atom)
    (for (in position (..< 0 (. owner-names length)))
      (if (== ([] owner-names position) owner)
        (return ([] owner-unions position))
      )
    )
    (if outer
      (return (call (. outer anonymous-union) owner))
    )
    (return no-type)
  )
  (fn-do _ symbol-unions _
    (param name Atom)
    (param found (list TypeId))
    (param owners (list Atom))
    ; The unions of anonymous cases that have a case of a name, among those a declaration typed
    ; so far owns: those of the enclosing functions first, then this one's in the order typed.
    (if outer
      (call (. outer symbol-unions) name found owners)
    )
    (for (in position (..< 0 (. owner-names length)))
      (if (or (not ([] owner-declared position)) (!= (call (. found find) ([] owner-unions position)) null))
        (continue)
      )
      (for (in fact (call (. types cases-of) ([] owner-unions position)))
        (if (and (. fact name) (== (!! (. fact name)) name))
          (+= found ([] owner-unions position))
          (+= owners ([] owner-names position))
          (break)
        )
      )
    )
  )
  (fn-do _ anonymous-symbol TypeId
    (param id SyntaxId)
    (param name Atom)
    ; The union a case named by its symbol alone is of where a declaration owns anonymous cases
    ; of that name: the one union that has it, as the reference picks before any declared type.
    ; Gives no type where none has it, and reports a name that two have.
    (let found (list TypeId))
    (let owners (list Atom))
    (call symbol-unions name found owners)
    (if (== (. found length) 0)
      (return no-type)
    )
    (if (== (. found length) 1)
      (return ([] found 0))
    )
    (let listed "")
    (for (in owner owners)
      (if (!= (. listed length) 0)
        (+= listed ", ")
      )
      (+= listed (str "'" (. owner text) "'"))
    )
    (call (. frame diagnose)
      (block
        (arg id)
        (arg .stated)
        (arg (call (. program store-atom) (str "Anonymous case '." (. name text) "' is ambiguous between " listed)))
      )
    )
    (return invalid-type)
  )
  (fn-do _ function-union TypeId
    ; The union of the anonymous cases a function's body gives that no declaration in it owns:
    ; the function owns them, under its own name.
    (let name (? Atom) null)
    (match? ([] (. ([] (. program modules) module) decls) (. frame decl))
      (case (call .decl-function fn)
        (= name (. fn name))
      )
    )
    (let body (. frame declaration body))
    (if (or (not name) (== body 0))
      (return no-type)
    )
    (let known (call anonymous-union name))
    (if (!= known no-type)
      (return known)
    )
    (let sites (list SyntaxId))
    (let held (list TypeId))
    (call hold-payloads body null name sites held)
    (let names (list Atom))
    (let payloads (list TypeId))
    (let counts (list U32))
    (for (in position (..< 0 (. sites length)))
      (match? ([] (. tree nodes) ([] sites position))
        (case (call .node-anonymous-case row)
          (let payload ([] held position))
          (let found (call (. names find) (. row name)))
          (if (and (!= found null) (!= ([] counts found) (. row args count)))
            (call report-arity ([] sites position) (. row name))
            (else-if (and (!= found null) (!= payload invalid-type))
              (let joined (call (. relations unify) ([] payloads found) payload module))
              (if (call relation-legal joined)
                (= ([] payloads found) (. joined unified))
              )
            )
            (else-if (and (== found null) (!= payload invalid-type))
              (+= names (. row name))
              (+= payloads payload)
              (+= counts (. row args count))
            )
          )
        )
      )
    )
    (if (== (. names length) 0)
      (return no-type)
    )
    (let mark (. scratch types mark))
    (let names-mark (. scratch names mark))
    (for (in position (..< 0 (. names length)))
      (call (. scratch names push) ([] names position))
      (call (. scratch types push) ([] payloads position))
    )
    (let union (call (. types intern-named-union) name mark names-mark))
    (+= owner-names name)
    (+= owner-unions union)
    (+= owner-declared false)
    (return union)
  )
  (fn-do _ infer-anonymous-case TypeId
    (param id SyntaxId)
    (param name Atom)
    (param args (of RowRange SyntaxId))
    (param owner (? Atom))
    ; An anonymous case is a case of the union its owner's cases make, planned by its number.
    ; Each value it is given converts to the field in its place of what the case holds, or one
    ; value to what the case holds. A value that does not convert is reported at the case. One
    ; value given for a case that holds a tuple or a struct is taken by the reference for the
    ; first field, which is reported where it does not convert and has no plan where it does.
    (let union (if-expr owner (call anonymous-union owner) (call function-union)))
    (if (and (== union no-type) (not owner))
      (let message (str "Anonymous match case '.." (. name text) "' needs a stable result owner"))
      (call (. frame diagnose) id .stated (call (. program store-atom) message))
      (return invalid-type)
    )
    (if (== union no-type)
      (call decline id)
      (return invalid-type)
    )
    (let foreseer (call foreseer-of union))
    (if foreseer
      (+= (. foreseer foreseen-sites) id)
      (+= (. foreseer foreseen-payloads) (call anonymous-payload args))
      (return union)
    )
    (let payload no-type)
    (let number (. U32 max))
    (let place 0u32)
    (for (in fact (call (. types cases-of) union))
      (if (and (. fact name) (== (!! (. fact name)) name))
        (= number place)
        (if (not (. fact is-default))
          (= payload (. fact type))
        )
      )
      (+= place 1)
    )
    (let shaped false)
    (if (and (!= payload no-type) (!= payload invalid-type))
      (= shaped (or (== (call (. types intrinsic-of) payload) .tuple) (== (call (. types intrinsic-of) payload) .struct)))
    )
    (let position 0u32)
    (let typed true)
    (for (in arg ([] (. tree children) args))
      (let given (call (. facts node-type) instance arg))
      (if (== given no-type)
        (= given (call infer arg))
      )
      (= typed (and typed (!= given invalid-type)))
      (if (and (!= given invalid-type) (!= payload no-type))
        (let expected (if-expr (or (> (. args count) 1) shaped) (call field-of payload position) payload))
        (if (or (== expected no-type) (== expected invalid-type))
          (call decline id)
          (return invalid-type)
        )
        (let plain (and (!= (call (. types intrinsic-of) given) .closure) (!= (call (. types intrinsic-of) given) .binding)))
        (if (and plain (not (call relation-legal (call (. conversions compare-held) given expected))))
          (call (. frame diagnose) id .illegal-cast null given expected)
          (return invalid-type)
        )
        (if (and (== (. args count) 1) shaped)
          (call decline id)
          (return invalid-type)
        )
        (call (. conversions convert) arg arg given expected .reason-argument)
      )
      (+= position 1)
    )
    (if (and (== number (. U32 max)) typed (!= (call (. unheld-cases find) id) null))
      (call report-unheld id name)
      (return invalid-type)
    )
    (if (and (== number (. U32 max)) typed)
      (let message (str "Anonymous case '.." (. name text) "' was not declared"))
      (call (. frame diagnose) id .stated (call (. program store-atom) message))
      (return invalid-type)
    )
    (if (!= number (. U32 max))
      (let plan (if-expr (> (. args count) 1) (. OperatorPlan plan-case-fields) (. OperatorPlan plan-case)))
      (call (. facts set-case) instance id number plan)
    )
    (return union)
  )
  (fn-do _ infer-declared TypeId
    (param left SyntaxId)
    (param right SyntaxId)
    (let expected no-type)
    (match? ([] (. tree nodes) left)
      (case (call .node-type-capture row)
        (if (!= (. row type) 0)
          (= expected (call (. types evaluate-type) module tree (. row type) (. frame env)))
          (if (and (== expected invalid-type) (call report-missing-type (. row type) (. frame env)))
            (return invalid-type)
          )
        )
      )
    )
    (if (and (!= expected no-type) (!= expected invalid-type) (call is-async-channel expected))
      (let payload (call published-payload right))
      (if (!= payload no-type)
        (let provided (str "[Interface core/stream:Broadcastable'" (call type-display types payload) "]"))
        (let message (str "Event endpoints provide " provided ", not " (call type-display types expected)))
        (call (. frame diagnose) left .stated (call (. program store-atom) message) payload expected)
        (return invalid-type)
      )
    )
    (let place right)
    (match? ([] (. tree nodes) left)
      (case (call .node-type-capture row)
        (if (!= (. row type) 0)
          (= place (. row type))
        )
      )
    )
    (call expect-feeds right expected)
    (call expect-arms right expected)
    (return (call infer-with-expected right expected (call (. (call Want) escaping) expected place)))
  )
  (fn-do _ report-missing-signature _
    (param signature Signature)
    ; Reports the first type written in the signature of the function being typed that names
    ; nothing, among its arguments and then its return.
    (match? ([] (. ([] (. program modules) module) decls) (. frame decl))
      (case (call .decl-function fn)
        (let pool (. ([] (. program modules) module) arg-pool))
        (for (in position (..< 0 (. fn args count)))
          (if (and (< position (. signature args length)) (== ([] (. signature args) position) invalid-type))
            (let written (. ([] pool (+ (. fn args start) position)) type-syntax))
            (if (and (!= written 0) (call report-missing-type written (. frame env)))
              (return)
            )
          )
        )
        (if (and (!= (. fn return-type) 0) (== (. signature returns) invalid-type))
          (call report-missing-type (. fn return-type) (. frame env))
        )
      )
    )
  )
  (fn-do _ report-missing-type Bool
    (param syntax SyntaxId)
    (param env TypeEnv)
    ; Reports where a type written names nothing, as TypeScript reports it (`missing-type`). Says
    ; whether one was reported.
    (let missing (call (. types missing-type) module (. ([] (. program modules) module) tree) syntax env))
    (return-if false (if (== missing 0)))
    (blank)
    (call (. frame diagnose) missing .stated (call (. program store-atom) "Type not found"))
    (return true)
  )
  (fn-expr _ is-async-channel Bool
    (param type TypeId)
    (match ([] (. types rows) type)
      (case (call .type-class row)
        (call (. types async-channel-decl refers-to) (. row module) (. row decl))
      )
      (default
        false
      )
    )
  )
  (fn-do _ fitting-of TypeId
    (param want Want)
    ; The function type a value chosen by a condition is given as, where its context expects one of it
    ; (`want-fitting`).
    (return (if-expr (call (. want asks) .want-fitting) (call expected-function (. want type)) no-type))
  )
  (fn-expr _ armed-want Want
    (param id SyntaxId)
    (param want Want)
    ; What is asked of the value an arm gives where the match expects a type of its arms
    ; (`armed-symbol`) and the value is `if condition then value else other`: that its sides are
    ; joined at that type, unless the block it ends asks that of it already.
    (if-expr (and (== id (. arm-typing symbol)) (not (call (. want asks) .want-choice)) (!= (. arming expected) (. types void-type)) (call (. tree is-choice-syntax) id)) (call (. want asking) .want-choice (. arming expected)) want)
  )
  (fn-do _ expected-function TypeId
    (param expected TypeId)
    ; The function type a value is expected to be, written as it or as an optional of it; no type
    ; for any other.
    (let inner (if-expr (call (. types is-optional) expected) (call (. types optional-inner) expected) expected))
    (call (. types complete) inner)
    (return (if-expr (!= (call function-row types inner) no-type) inner no-type))
  )
  (fn-do _ construct-declared _
    (param pattern SyntaxId)
    (match? ([] (. tree nodes) pattern)
      (case (call .node-type-capture row)
        (if (!= (. row type) 0)
          (let declared (call (. types evaluate-type) module tree (. row type) (. frame env)))
          (if (and (== declared invalid-type) (call report-missing-type (. row type) (. frame env)))
            (return)
          )
          (if (and (!= declared invalid-type) (== (call (. types intrinsic-of) declared) .interface))
            (call (. frame diagnose) (. row type) .stated (call (. program store-atom) "Type can't be null"))
            (return)
          )
          (call construct-value (. row type) declared)
        )
      )
      (case (call .node-type-tuple row)
        (for (in field ([] (. tree children) (. row field-types)))
          (call construct-declared field)
        )
      )
    )
  )
  (fn-expr _ lazy-known Bool
    (param pattern SyntaxId)
    (case? slot
      (!= (call (. frame known) slot) no-type)
    )
    (default
      false
    )
    (where
      (lazy slot (call declaring-slot (call (. tree first-named) pattern)))
    )
  )
  (fn-expr _ declaring-slot (? SlotId)
    (param pattern SyntaxId)
    (case? (== (. resolution kind) .resolve-slot)
      (. resolution slot)
    )
    (default
      null
    )
    (where
      (lazy identifier
        (match ([] (. tree nodes) pattern)
          (case (call .node-type-capture row)
            (. row id)
          )
          (default
            pattern
          )
        )
      )
      (lazy resolution (call (. bindings resolution-of) (. frame binding) identifier))
    )
  )
  (fn-do _ declare _
    (param pattern SyntaxId)
    (param value TypeId)
    (param value-syntax SyntaxId)
    (if (== pattern 0)
      (return)
    )
    (match ([] (. tree nodes) pattern)
      (case (call .node-type-capture row)
        (if (and (!= (. row type) 0) (call reads-name (. row type)))
          (call plan-tested (. row type))
          (call check-pattern pattern value)
          (return)
        )
        (let declared value)
        (if (!= (. row type) 0)
          (let annotation (call (. types evaluate-type) module tree (. row type) (. frame env)))
          (if (and (!= value-syntax 0) (!= value no-type))
            (call note-declared-value pattern 0 value-syntax (. row type) annotation value)
          )
          (if (call bare-generic-annotation annotation value)
            (= annotation (?? (call (. relations complete-from) annotation value) value))
          )
          (= declared annotation)
          (if (call never-fits value annotation)
            (call (. frame diagnose) pattern .no-possible-matches)
            (else-if (!= value no-type)
              (call (. calls note-context-cast) value-syntax annotation .cast-pattern)
              (let chosen
                (call (. conversions convert)
                  (block
                    (arg (. row type))
                    (arg value-syntax)
                    (arg value)
                    (arg annotation)
                    (arg .reason-declaration)
                  )
                )
              )
              (if (or (call (. types is-optional) annotation) (!= value annotation))
                (call (. instances mark-may-panic) instance)
              )
              (if (not (call matches-in-place value annotation))
                (call (. frame forget-members))
              )
              (if (!= chosen invalid-type)
                (= declared chosen)
              )
            )
          )
        )
        (let slot (call declaring-slot pattern))
        (if slot
          (call (. frame assign) slot declared)
        )
      )
      (case .node-identifier
        (let slot (call declaring-slot pattern))
        (if slot
          (call (. frame assign) slot value)
        )
      )
      (case (call .node-type-tuple row)
        (let known (and (!= value no-type) (!= value invalid-type)))
        (let held value)
        (if (and known (call (. types is-optional) value))
          (= held (call (. types optional-inner) value))
          (call (. instances mark-may-panic) instance)
          (call (. facts record-force) instance pattern value held false)
        )
        (if (and known (not (call destructures held (. row field-types count))))
          (call (. frame diagnose) pattern .no-possible-matches)
        )
        (let position 0u32)
        (for (in field ([] (. tree children) (. row field-types)))
          (let item (if-expr (== held no-type) no-type (call field-of held position)))
          (call declare field item (call (. tree place-syntax) value-syntax position (. row field-types count)))
          (+= position 1)
        )
      )
      (case .node-type-wildcard
        (return)
      )
      (case .node-type-list
        (if (and (!= value no-type) (not (call pattern-possible pattern value)))
          (call (. frame diagnose) pattern .no-possible-matches)
          (return)
        )
        (call plan-tested pattern)
        (call check-pattern pattern value)
      )
      (case .node-type-and
        (call plan-tested pattern)
        (call check-pattern pattern value)
      )
      (case .node-type-property
        (if (and (!= value no-type) (not (call pattern-possible pattern value)))
          (call (. frame diagnose) pattern .no-possible-matches)
          (return)
        )
        (call check-pattern pattern value)
      )
      (default
        (call decline pattern)
      )
    )
  )
  (fn-do _ note-declared-value _
    (param pattern SyntaxId)
    (param property DeclId)
    (param value SyntaxId)
    (param annotation SyntaxId)
    (param declared TypeId)
    (param found TypeId)
    ; Records a value written with the type it is declared as, for the rules that read how it is
    ; written (`DeclaredValueFact`).
    (if (not (. lint traces))
      (return)
    )
    (let fact (call DeclaredValueFact instance pattern property value annotation declared found))
    (call (. lint declared-values append) fact)
  )
  (fn-expr _ matches-in-place Bool
    (param value TypeId)
    (param annotation TypeId)
    ; Whether the reference takes a value declared with a type as it is, with no test that panics
    ; where it fails, which would end what is known of properties: a value of that type, of an equal
    ; one, or of an alternative of an `or`.
    (case? (== value annotation)
      true
    )
    (default
      (or (== kind .relation-same) (== kind .relation-equal) (== kind .relation-or-cast))
    )
    (where
      (lazy kind (. (call (. conversions compare-held) value annotation) kind))
    )
  )
  (fn-do _ plan-tested _
    (param pattern SyntaxId)
    ; A pattern a declaration is written with that tests what it is given panics where the test
    ; fails: it is planned as arms that take nothing of what is left. A pattern of items keeps
    ; its own plan, and panics where it is declared with.
    (match? ([] (. tree nodes) pattern)
      (case .node-type-and
        (call (. instances mark-may-panic) instance)
        (call (. facts set-plan) instance pattern .plan-unmatched)
      )
      (case .node-type-list
        (call (. instances mark-may-panic) instance)
      )
    )
  )
  (fn-do _ never-fits Bool
    (param value TypeId)
    (param annotation TypeId)
    ; Whether a value declared under a type can never be of it: the declaration is a pattern, and
    ; one nothing matches. A binding fits a function type, or an optional of one, where what it
    ; calls takes the type's arguments and gives its return.
    (if (or (== value no-type) (== value invalid-type) (== annotation invalid-type) (== value annotation))
      (return false)
    )
    (let kind (call (. types intrinsic-of) value))
    (if (== kind .binding)
      (call (. types complete) annotation)
      (let inner (call (. types optional-inner) annotation))
      (call (. types complete) inner)
      (return (and (!= (call function-row types inner) no-type) (not (call (. conversions binding-takes) value inner))))
    )
    (if (== kind .closure)
      (return false)
    )
    (return (not (call relation-legal (call (. conversions compare-held) value annotation))))
  )
  (fn-do _ bare-generic-annotation Bool
    (param annotation TypeId)
    (param value TypeId)
    (if (or (== annotation no-type) (== annotation invalid-type) (== value no-type) (== value invalid-type))
      (return false)
    )
    (call (. types complete) annotation)
    (if (and (not (. ([] (. types completions) annotation) has-variables)) (not (call has-inference-args annotation)))
      (return false)
    )
    (let declared (call class-ref types annotation))
    (let given (call class-ref types value))
    (if (or (== (. declared decl) 0) (== (. given decl) 0))
      (return false)
    )
    (return (and (== (. declared module) (. given module)) (== (. declared decl) (. given decl))))
  )
  (fn-do _ has-inference-args Bool
    (param id TypeId)
    (match? ([] (. types rows) id)
      (case (call .type-class row)
        (for (in offset (..< 0 (. row args count)))
          (match? ([] (. types rows) (call (. types child-type) (. row args) offset))
            (case .type-inference
              (return true)
            )
          )
        )
      )
    )
    (return false)
  )
  (fn-expr _ destructures Bool
    (param value TypeId)
    (param count U32)
    ; A table or span gives exactly its fields; any other tuple gives its leading ones.
    (case? (== arity (. U32 max))
      false
    )
    (case? (call is-column-receiver (call (. types intrinsic-of) value))
      (== count arity)
    )
    (default
      (<= count arity)
    )
    (where
      (lazy arity (call tuple-arity value))
    )
  )
  (fn-do _ struct-arity U32
    (param value TypeId)
    ; How many fields a named tuple or struct stores. What a getter answers is no field.
    (let kind (call (. types intrinsic-of) value))
    (if (and (!= kind .tuple) (!= kind .struct) (!= kind .array-builder))
      (return (. U32 max))
    )
    (let count U32)
    (for (in field (call (. types properties-of) value))
      (if (!= (. field slot) (. U32 max))
        (+= count 1)
      )
    )
    (return count)
  )
  (fn-do _ struct-field-of TypeId
    (param value TypeId)
    (param position U32)
    (let properties (. ([] (. types completions) value) properties))
    (if (>= position (. properties count))
      (return invalid-type)
    )
    (let field ([] (. types properties) (+ (. properties start) position)))
    (if (== (. field type) no-type)
      (return (call demand-member field value (. field name)))
    )
    (return (. field type))
  )
  (fn-expr _ slot-known TypeId
    (param slot SlotId)
    (case? (and outer (call (. frame is-captured) slot))
      (call (. outer slot-known) slot)
    )
    (default
      (call (. frame known) slot)
    )
  )
  (fn-expr _ key-declared TypeId
    (param key NarrowingKey)
    ; What a local, a property or a path holds before the flow knows more of it: a local its own
    ; type, and a property or a path the type it had where the flow first came to know something of
    ; it, or no type where the flow knows nothing of it.
    (case? (not (call is-member-key key))
      (call slot-known (call key-slot key))
    )
    (case? (call (. frame is-stable-path) key)
      (call (. frame path-declared-type) key)
    )
    (default
      (if-expr (!= index null) ([] (. frame member-declared) index) no-type)
    )
    (where
      (lazy index (call (. frame narrowed-members find) key))
    )
  )
  (fn-do _ read-slot TypeId
    (param slot SlotId)
    (param site SyntaxId (= 0))
    ; A lazy local of a function this one is written in may be evaluated here, by this read: what
    ; its value may do, this function may do. A lazy local's value is typed where it is first
    ; read, which `reading.lazy` keeps while it is, the outermost such read; a later read where a
    ; local the value reads is known otherwise makes it wavering. While the value is typed,
    ; `lazy-marks` keeps where the narrowings stood as it was entered, so that a read in it of a
    ; local a test the value made narrowed is noted as one that holds wherever the value is evaluated
    ; (`note-inside-read`). A later read evaluates nothing where every way to it passed an earlier
    ; one: for a local kept behind a flag, where the flow knows it has its value (`note-evaluated`),
    ; as the reference finds a read whose block an earlier one's dominates, and for any other, whose
    ; reads run in a straight line, always. Such a read neither types the value again nor makes it
    ; waver (`note-dominated-read`). The value of a local kept behind a flag is typed between
    ; `mask-tested` and `close-flagged-value`.
    (if (and outer (call (. frame is-captured) slot))
      (let found (call (. outer read-slot) slot))
      (if (and (== (. ([] (. bindings slots) slot) kind) .slot-lazy) (. ([] (. instances rows) (. (!! outer) instance)) may-panic))
        (call (. instances mark-may-panic) instance)
      )
      (if (== (. ([] (. bindings slots) slot) kind) .slot-lazy)
        (call let-out-lazy slot (if-expr (!= site 0) site (. ([] (. bindings slots) slot) group)))
      )
      (return found)
    )
    (if (!= (call (. lazy-slots find) slot) null)
      (call (. frame diagnose) (call (. bindings lazy-pattern) (. this tree) slot) .circular-reference)
      (return invalid-type)
    )
    (let current (call (. frame slot-type) slot))
    (let row ([] (. bindings slots) slot))
    (let flagged (and (== (. row kind) .slot-lazy) (!= site 0) (call (. bindings lazy-flagged) slot)))
    (if (!= current no-type)
      (if (and (== (. row kind) .slot-lazy) (!= site 0) evaluated-here)
        (call (. facts note-dominated-read) instance site)
        (return current)
      )
      (lazy evaluated-here (or (not (call (. bindings lazy-flagged) slot)) (call (. frame is-evaluated) slot)))
      (if (and (== (. row kind) .slot-lazy) (!= (. row group) 0) (not (call settles slot (. row group))))
        (call (. facts note-wavering) instance slot)
        (if (call (. bindings lazy-flagged) slot)
          (call diagnose-retyped (. row group))
        )
      )
      (if (and (== (. row kind) .slot-lazy) (not (call transforms-agree slot)))
        (call (. facts note-unheld-lazy) instance slot)
      )
      (if (and (== (. row kind) .slot-lazy) (call (. bindings lazy-flagged) slot))
        (call recheck-forces slot)
        (if (!= (call (. forgetting-lazies find) slot) null)
          (call (. frame forget-members))
        )
      )
      (if flagged
        (call note-evaluated slot)
      )
      (return current)
    )
    (if (and (== (. row kind) .slot-lazy) (!= (. row group) 0))
      (let busy (call (. calls suspend-ranking)))
      (let leaving (. scratch outgoing mark))
      (let around reading)
      (if (== (. reading lazy) 0)
        (= reading (= (. reading lazy) site))
      )
      (let typed-mark (. scratch narrowings mark))
      (if (call (. bindings lazy-flagged) slot)
        (call mask-tested (. row group))
      )
      (+= lazy-marks (. scratch narrowings mark))
      (+= typing-lazies slot)
      (let forgotten (. frame forgotten))
      (match? ([] (. tree nodes) (. row group))
        (case (call .node-declare declaration)
          (call note-entered slot (. declaration right))
          (call check-declare
            (block
              (arg (. declaration left))
              (arg (call (. tree machine-or-value) (. declaration left) (. declaration right)))
              (arg true)
            )
          )
          (call claim-lazy slot (. row group) (. declaration right))
          (if (!= (. facts live-statements length) 0)
            (call settle-live-statement (. row group) (. declaration left) (. declaration right) no-type)
          )
        )
      )
      (if (and (call (. bindings lazy-flagged) slot) (!= (. frame forgotten) forgotten))
        (+= forgetting-lazies slot)
      )
      (call (. typing-lazies pop))
      (call (. lazy-marks pop))
      (if (call (. bindings lazy-flagged) slot)
        (call close-flagged-value typed-mark)
      )
      (if flagged
        (call note-evaluated slot)
      )
      (= reading around)
      (call (. calls resume-ranking) busy)
      (if (!= (. scratch outgoing mark) leaving)
        (+= raising-lazies slot)
        (+= lazy-transforms (. frame transforms length))
        (+= raising-starts (. raising-entries length))
        (for (in entry (call (. scratch outgoing since) leaving))
          (+= raising-entries entry)
        )
      )
      (return (call (. frame known) slot))
    )
    (return invalid-type)
  )
  (fn-do _ diagnose-retyped _
    (param group SyntaxId)
    ; The reference types the value of a lazy local kept behind a flag again at a read that no
    ; evaluation of it is passed before, under what is known there. A property the value reads from
    ; a local or a property of the receiver that the flow knew to hold a value where the value was
    ; typed, and not by a test the value made, but that may hold nothing here, is the reference's
    ; error there: the property is read from an optional.
    (let value SyntaxId 0)
    (match? ([] (. tree nodes) group)
      (case (call .node-declare declaration)
        (= value (. declaration right))
      )
    )
    (if (== value 0)
      (return)
    )
    (for (in id (..< (call (. tree subtree-start) value) (+ value 1)))
      (match? ([] (. tree nodes) id)
        (case (call .node-get-expression row)
          (if (or (. row is-optional) (call (. facts is-inside-read) instance (. row object)) retyped)
            (continue)
          )
          (lazy retyped (!= (call (. retyped-reads find) id) null))
          (let recorded (call (. facts node-type) instance (. row object)))
          (let here (call known-here (. row object)))
          (if (or (== recorded no-type) (== recorded invalid-type) plain-here)
            (continue)
          )
          (lazy plain-here (or (== here no-type) (not (call (. types is-optional) here))))
          (if (or (call (. types is-optional) recorded) (!= (call (. types optional-inner) here) recorded))
            (continue)
          )
          (+= retyped-reads id)
          (call (. frame diagnose) id .property-not-found (. row name) here)
        )
      )
    )
  )
  (fn-do _ known-here TypeId
    (param syntax SyntaxId)
    ; What a read of a local of this frame or of a stored property of the receiver would find
    ; here, or no type for any other read.
    (match? ([] (. tree nodes) syntax)
      (case (call .node-identifier named)
        (let resolution (call (. bindings resolution-of) (. frame binding) syntax))
        (if (and (== (. resolution kind) .resolve-slot) (not (call (. frame is-captured) (. resolution slot))))
          (return (call (. frame slot-type) (. resolution slot)))
        )
        (if (== (. resolution kind) .resolve-member)
          (let key (call member-key (. resolution module) (. resolution decl)))
          (if (and (call (. frame knows-member) key) (not (call (. frame is-doubted) key)))
            (let held (call (. frame held-member) key))
            (if (!= held no-type)
              (return held)
            )
          )
          (return (call member-type (. named name)))
        )
      )
    )
    (return no-type)
  )
  (fn-do _ note-evaluated _
    (param slot SlotId)
    ; A read of a lazy local kept behind a flag that runs wherever what follows it runs gives the
    ; local its value there. One in a part of an expression that may not run, where nothing takes
    ; back what is known after it, or where an error may leave for a catch in this function before
    ; it ran, gives it nothing that follows.
    (if (and (== skippable-depth 0) (== (. frame surround catch-depth) 0))
      (call (. frame note-evaluated) slot)
    )
  )
  (fn-do _ mask-tested _
    (param group SyntaxId)
    ; Each local of this frame that the value of a lazy local kept behind a flag tests, which the
    ; flow knows more of than its type, is known as its type while the value is typed. The reference
    ; evaluates such a value at the first of its reads and types it again at each read that is not
    ; passed only after another, under what is known there; a value typed with what it tests as its
    ; type holds at each, whatever each knows of it.
    (let value SyntaxId 0)
    (match? ([] (. tree nodes) group)
      (case (call .node-declare declaration)
        (= value (. declaration right))
      )
    )
    (if (== value 0)
      (return)
    )
    (let tested (list SyntaxId))
    (for (in id (..< (call (. tree subtree-start) value) (+ value 1)))
      (call note-tested id tested)
    )
    (for (in subject tested)
      (if (not (is ([] (. tree nodes) subject) .node-identifier))
        (continue)
      )
      (let resolution (call (. bindings resolution-of) (. frame binding) subject))
      (if (or (!= (. resolution kind) .resolve-slot) (call (. frame is-captured) (. resolution slot)) unnarrowed)
        (continue)
      )
      (lazy unnarrowed (not (call (. frame is-narrowed) (. resolution slot))))
      (call (. frame push-narrowing) (call slot-key (. resolution slot)) (call (. frame known) (. resolution slot)))
    )
  )
  (fn-do _ note-tested _
    (param id SyntaxId)
    (param into (list SyntaxId))
    ; The operands a condition at a node tests of what they hold: the sides of `&&` and `||`, the
    ; condition of `if`, what `!`, `?` and `is` test, and what is compared with `null`.
    (match? ([] (. tree nodes) id)
      (case (call .node-binary-expression row)
        (if (or (== (. row op) .and-op) (== (. row op) .or-op))
          (+= into (. row lhs))
          (+= into (. row rhs))
          (else-if (== (. row op) .if-op)
            (+= into (. row rhs))
          )
          (else-if (and (or (== (. row op) .equals-op) (== (. row op) .not-equals-op)) (call (. narrowing is-null-syntax) (. row rhs)))
            (+= into (. row lhs))
          )
          (else-if (and (or (== (. row op) .equals-op) (== (. row op) .not-equals-op)) (call (. narrowing is-null-syntax) (. row lhs)))
            (+= into (. row rhs))
          )
          (else-if (call is-type-test (. row op))
            (+= into (. row lhs))
          )
        )
      )
      (case (call .node-unary-expression row)
        (if (== (. row op) .not-op)
          (+= into (. row operand))
        )
      )
      (case (call .node-type-predicate row)
        (+= into (. row expr))
      )
      (case (call .node-if-block row)
        (if (!= (. row condition) 0)
          (+= into (. row condition))
        )
      )
    )
  )
  (fn-do _ close-flagged-value _
    (param mark ScratchMark)
    ; What the value of a lazy local kept behind a flag, or `mask-tested` before it, left known holds
    ; only within it, since a read that comes after it may find the flag set and evaluate nothing.
    ; What an assignment in it settled is known after it.
    (let settled (call (. frame assigned-since) mark))
    (call (. frame pop-narrowing) mark)
    (for (in row settled)
      (call (. frame push-assigned) (. row key) (. row type) (. row cases))
    )
  )
  (fn-do _ recheck-forces _
    (param slot SlotId)
    ; The reference evaluates the value of a lazy local it keeps behind a flag again at each read,
    ; under what is known there, where this pass types it at the first: a force in the value that
    ; the flow narrowed before the value was entered is narrowed only where every read still knows
    ; what the force reads to hold a value, and a read that does not ends what is known of
    ; properties, as the reference's panic there makes calls. What the value itself tests it tests
    ; at each read.
    (for (in position (..< 0 (. forcing-lazies length)))
      (if (== ([] forcing-lazies position) slot)
        (let index ([] forcing-facts position))
        (if (not (call known-present (call (. tree force-operand) (. ([] (. facts forces) index) syntax))))
          (= (. ([] (. facts forces) index) operand) ([] forcing-declared position))
          (= (. ([] (. facts forces) index) is-narrowed) false)
          (call (. frame forget-members))
        )
      )
    )
  )
  (fn-do _ known-present Bool
    (param syntax SyntaxId)
    ; Whether the flow knows here that a local, a property of the receiver or a path from one of
    ; those holds a value, as a read of it here would find.
    (match? ([] (. tree nodes) syntax)
      (case (call .node-type-predicate row)
        (return (call known-present (. row expr)))
      )
      (case .node-identifier
        (let resolution (call (. bindings resolution-of) (. frame binding) syntax))
        (if (== (. resolution kind) .resolve-slot)
          (let known (call (. frame slot-type) (. resolution slot)))
          (return (and (!= known no-type) (!= known invalid-type) (not (call (. types is-optional) known))))
        )
        (if (== (. resolution kind) .resolve-member)
          (return (call member-holds (call member-key (. resolution module) (. resolution decl))))
        )
      )
      (case (call .node-get-expression row)
        (if (. row is-optional)
          (return false)
        )
        (let key (call (. narrowing receiver-member) (. row object) (. row name)))
        (let base (call (. narrowing base-key) (. row object)))
        (if (and (not key) base)
          (= key (call (. frame find-path-key) base (. row name)))
        )
        (return (and (!= key null) (call member-holds key)))
      )
    )
    (return false)
  )
  (fn-expr _ member-holds Bool
    (param key NarrowingKey)
    ; Whether the flow knows here that a property or a path holds a value, a read of it that is
    ; counted (`member-reads`).
    (case? (or (not (call (. frame knows-member) key)) (call (. frame is-doubted) key))
      false
    )
    (default
      (and (!= held no-type) (!= held invalid-type) (not (call (. types is-optional) held)))
    )
    (where
      (lazy held (call (. frame narrowed-member) key))
    )
  )
  (fn-do _ lazy-leaving Bool
    (param slot SlotId)
    (param into (list Outgoing))
    ; The errors the value of a lazy local lets out where its first read typed it, added to `into`
    ; by the function that declares it. False where transformers were declared there, which may
    ; take them.
    (for (in position (..< 0 (. raising-lazies length)))
      (if (== ([] raising-lazies position) slot)
        (if (!= ([] lazy-transforms position) 0)
          (return false)
        )
        (let start ([] raising-starts position))
        (let end (. raising-entries length))
        (if (< (+ position 1) (. raising-starts length))
          (= end ([] raising-starts (+ position 1)))
        )
        (for (in index (..< start end))
          (+= into ([] raising-entries index))
        )
        (return true)
      )
    )
    (if (and outer (call (. frame is-captured) slot))
      (return (call (. outer lazy-leaving) slot into))
    )
    (return true)
  )
  (fn-do _ let-out-lazy _
    (param slot SlotId)
    (param site SyntaxId)
    ; A lazy local of a function this one is written in that this read evaluates lets its errors
    ; out of this function too, where its writer calls it in place, as they leave TypeScript's
    ; inline loop; the writer lets them out with the call. Those of a function called elsewhere,
    ; or that meet transformers declared on either side, stay in the writer, and an error that
    ; would leave here has no shape where emitted.
    (if (or (not in-place) (!= (. frame transforms length) 0))
      (return)
    )
    (let leaving (list Outgoing))
    (if (not (call (. (!! outer) lazy-leaving) slot leaving))
      (return)
    )
    (for (in entry leaving)
      (call (. scratch outgoing push) (call Outgoing (. entry type) site (. entry callee) (. U32 max) 0))
    )
  )
  (fn-do _ transforms-agree Bool
    (param slot SlotId)
    ; Whether a lazy local whose value lets errors out is read again where the transformers
    ; declared are those declared where its first read typed it. TypeScript evaluates the value
    ; at each read, so an error leaving it is transformed by those declared there.
    (for (in position (..< 0 (. raising-lazies length)))
      (if (== ([] raising-lazies position) slot)
        (return (== ([] lazy-transforms position) (. frame transforms length)))
      )
    )
    (return true)
  )
  (fn-do _ hold-transforms _
    (param error TypeId)
    (param site SyntaxId)
    ; TypeScript evaluates the exception of a transformer again where each error it takes
    ; leaves, with the names and the flow there, where the type pass typed it once where it is
    ; declared. A transformer that may take an error leaving here, an error not yet known taken
    ; by any, whose exception does not hold here, is marked, and emission refuses it.
    (for (in transform (. frame transforms))
      (if (and (!= error no-type) (== (call caught-rank relations error (. transform source)) null))
        (continue)
      )
      (let row ([] (. facts transforms) (. transform fact)))
      (if (not (call exception-holds (. row site) (. row exception) site))
        (call (. facts note-unheld-transform) (. transform fact))
      )
    )
  )
  (fn-do _ exception-holds Bool
    (param declared SyntaxId)
    (param exception SyntaxId)
    (param site SyntaxId)
    ; Whether a transformer's exception, typed at the raise that declares it, means here what it
    ; meant there: each name it reads names nothing declared since that a scope here holds, a
    ; local it reads is in a scope here and known as it was there, and a property it reads by its
    ; name is known as it was there. The names the catchers bind are its own.
    (let first (call (. tree subtree-start) declared))
    (for (in id (..< (call (. tree subtree-start) exception) (+ exception 1)))
      (match? ([] (. tree nodes) id)
        (case (call .node-identifier name)
          (let resolution (call (. bindings resolution-of) (. frame binding) id))
          (let recorded (call (. facts node-type) instance id))
          (if (call shadowed (. name name) declared site)
            (return false)
          )
          (if (== (. resolution kind) .resolve-slot)
            (let row ([] (. bindings slots) (. resolution slot)))
            (let own (and (>= (. row syntax) first) (<= (. row syntax) declared)))
            (if (and (not own) (not (call (. bindings holds-scope) tree (. row scope) site)))
              (return false)
            )
            (if (and (not own) (!= recorded no-type) (!= recorded (call (. frame slot-type) (. resolution slot))))
              (return false)
            )
          )
          (if (and member-recorded (!= recorded (call member-type (. name name))))
            (return false)
          )
          (lazy member-recorded (and (== (. resolution kind) .resolve-member) (!= recorded no-type)))
        )
      )
    )
    (return true)
  )
  (fn-do _ shadowed Bool
    (param name Atom)
    (param declared SyntaxId)
    (param site SyntaxId)
    ; Whether a local of the function named so is declared after a node and before a site, in a
    ; scope that holds the site.
    (let bound ([] (. bindings bindings) (. frame binding)))
    (for (in slot (..< (. bound slots start) (+ (. bound slots start) (. bound slots count))))
      (let row ([] (. bindings slots) slot))
      (if (and (== (. row name) name) between (call (. bindings holds-scope) tree (. row scope) site))
        (return true)
      )
      (lazy between (and (> (. row syntax) declared) (< (. row syntax) site)))
    )
    (return false)
  )
  (fn-do _ settles Bool
    (param slot SlotId)
    (param group SyntaxId)
    ; Whether the value of a lazy local, typed where it was first read, holds where it is read
    ; again: each local it reads, and each property it reads by its name, is known here as it was
    ; there, or read there as its type. A local the value itself learns more of, by a test it makes, is known there as the
    ; value left it; it holds here where the local is known as it was when the value was
    ; entered, which `note-entered` kept. One not known yet then, a lazy local the value is the
    ; first to read or one it declares, the value knows first as its type. A local the value read
    ; as its type holds anywhere.
    (match? ([] (. tree nodes) group)
      (case (call .node-declare declaration)
        (let value (. declaration right))
        (for (in id (..< (call (. tree subtree-start) value) (+ value 1)))
          (match? ([] (. tree nodes) id)
            (case (call .node-identifier name)
              (let recorded (call (. facts node-type) instance id))
              (let resolution (call (. bindings resolution-of) (. frame binding) id))
              (if (== recorded no-type)
                (continue)
              )
              (if (== (. resolution kind) .resolve-slot)
                (let known (call (. frame slot-type) (. resolution slot)))
                (let entered (call entered-type slot (. resolution slot)))
                (let prior
                  (scope (if-expr (!= entered no-type) entered frame-known)
                    (lazy frame-known (call (. frame known) (. resolution slot)))
                  )
                )
                (if (and (!= recorded known) (!= prior known) stale-record)
                  (return false)
                )
                (lazy stale-record (!= recorded (call (. frame known) (. resolution slot))))
              )
              (if (and member-read (!= recorded (call member-type (. name name))) moved-here)
                (return false)
              )
              (lazy member-read (== (. resolution kind) .resolve-member))
              (lazy moved-here (!= recorded (call known-here id)))
            )
          )
        )
      )
    )
    (return true)
  )
  (fn-do _ note-entered _
    (param slot SlotId)
    (param value SyntaxId)
    ; Keeps, where the value of a lazy local is first typed, what each local it reads is known as
    ; before it, for `settles`.
    (+= entered-lazies slot)
    (+= entered-starts (. entered-slots length))
    (for (in id (..< (call (. tree subtree-start) value) (+ value 1)))
      (if (not (is ([] (. tree nodes) id) .node-identifier))
        (continue)
      )
      (let resolution (call (. bindings resolution-of) (. frame binding) id))
      (if (!= (. resolution kind) .resolve-slot)
        (continue)
      )
      (let known (call (. frame slot-type) (. resolution slot)))
      (if (!= known no-type)
        (+= entered-slots (. resolution slot))
        (+= entered-types known)
      )
    )
  )
  (fn-do _ entered-type TypeId
    (param slot SlotId)
    (param read SlotId)
    ; What a local a lazy local's value reads was known as when the value was first typed, or
    ; none where it was not known yet.
    (let position (call (. entered-lazies find) slot))
    (if (not position)
      (return no-type)
    )
    (let end
      (scope (if-expr (< (+ position 1) (. entered-lazies length)) ([] entered-starts (+ position 1)) slots-end)
        (lazy slots-end (. entered-slots length))
      )
    )
    (for (in index (..< ([] entered-starts position) end))
      (if (== ([] entered-slots index) read)
        (return ([] entered-types index))
      )
    )
    (return no-type)
  )
  (fn-do _ member-type TypeId
    (param name Atom)
    (let found (only-if (call property-named (. frame self-type) name) (if (!= (. frame self-type) no-type))))
    (return (if-expr found (call member-type ([] (. types properties) found) (. frame self-type)) no-type))
  )
  (fn-do _ wavers Bool
    (param slot SlotId)
    ; Whether a local is read as more than its type where that may not hold: by its own
    ; function after a nested function that captures it was typed, or by a nested function at
    ; all, when something assigns it. In a loop the call that types the nested function may be
    ; written after the read and run before it, so there a local a nested function captures
    ; wavers wherever something assigns it. The body of a `do without gc` block runs where it is
    ; written, so a local it reads wavers only as the read would in the function around it.
    (if (and outer (call (. frame is-captured) slot) in-zone-body)
      (return (call (. outer wavers) slot))
    )
    (if (and outer (call (. frame is-captured) slot))
      (return (call (. outer holds-narrowed) slot))
    )
    (if (call (. frame wavers) slot)
      (return true)
    )
    (let shared (/or/ (. SlotFlag slot-captured) (. SlotFlag slot-assigned)))
    (return
      (scope (and (!= (. loop-marks length) 0) shared-flags (call (. frame is-narrowed) slot) (call closes-over slot))
        (lazy shared-flags (== (/and/ (. ([] (. bindings slots) slot) flags) shared) shared))
      )
    )
  )
  (fn-do _ closes-over Bool
    (param slot SlotId)
    ; Whether a nested function of the binding captures a local, other than the body of a
    ; `do without gc` block, which runs where it is written.
    (let row ([] (. bindings bindings) (. frame binding)))
    (for (in offset (..< 0 (. row nested count)))
      (let nested ([] (. bindings nested) (+ (. row nested start) offset)))
      (if (call is-region-body (. nested decl))
        (continue)
      )
      (for (in index (..< 0 (. nested captures count)))
        (if (== (. ([] (. bindings captures) (+ (. nested captures start) index)) slot) slot)
          (return true)
        )
      )
    )
    (return false)
  )
  (fn-expr _ holds-narrowed Bool
    (param slot SlotId)
    (case? (and outer (call (. frame is-captured) slot))
      (call (. outer holds-narrowed) slot)
    )
    (default
      (and (!= (/and/ (. ([] (. bindings slots) slot) flags) (. SlotFlag slot-assigned)) 0) (call (. frame is-narrowed) slot))
    )
  )
  (fn-expr _ holds-tested Bool
    (param slot SlotId)
    ; Whether a local something assigns is held where the type pass stands as what a test found
    ; of it. The reference gives a nested function written there a copy of what the test found,
    ; so what the function assigns does not reach the local. What an assignment left a local as
    ; is no copy, there or here.
    (case? (and outer (call (. frame is-captured) slot))
      (call (. outer holds-tested) slot)
    )
    (default
      (and (!= (/and/ (. ([] (. bindings slots) slot) flags) (. SlotFlag slot-assigned)) 0) (call (. frame is-tested) slot))
    )
  )
  (fn-do _ share-captures _
    (param nested-decl DeclId)
    ; A nested function written in this one is typed for the first time. Each local it
    ; captures that something assigns is shared from here, in the frame that declares it.
    (let row ([] (. bindings bindings) (. frame binding)))
    (for (in offset (..< 0 (. row nested count)))
      (let nested ([] (. bindings nested) (+ (. row nested start) offset)))
      (if (!= (. nested decl) nested-decl)
        (continue)
      )
      (for (in index (..< 0 (. nested captures count)))
        (let slot (. ([] (. bindings captures) (+ (. nested captures start) index)) slot))
        (if (!= (/and/ (. ([] (. bindings slots) slot) flags) (. SlotFlag slot-assigned)) 0)
          (call share slot)
        )
      )
    )
  )
  (fn-do _ share _
    (param slot SlotId)
    (if (and outer (call (. frame is-captured) slot))
      (call (. outer share) slot)
      (else
        (call (. frame share) slot)
      )
    )
  )
  (fn-expr _ precedes-declaration Bool
    (param slot SlotId)
    ; A closure body is checked where the closure is first called, and a local that an enclosing
    ; function declares after that call does not exist yet.
    (case? (or (not outer) (not (call (. frame is-captured) slot)))
      false
    )
    (default
      (call (. outer awaits-declaration) slot)
    )
  )
  (fn-expr _ awaits-declaration Bool
    (param slot SlotId)
    (case? (and outer (call (. frame is-captured) slot))
      (call (. outer awaits-declaration) slot)
    )
    (default
      (and (== (. ([] (. bindings slots) slot) kind) .slot-local) (== (call (. frame known) slot) no-type))
    )
  )
  (fn-do _ is-close-method Bool
    (param declaration CheckedDecl)
    (if (or (== (. frame self-type) no-type) (== (. frame self-type) invalid-type))
      (return false)
    )
    (if (!= (call (. types intrinsic-of) (. frame self-type)) .class)
      (return false)
    )
    (let owner-module ([] (. program modules) module))
    (match? ([] (. owner-module decls) (. frame decl))
      (case (call .decl-function fn)
        (if (and (!= (. fn owner) 0) (== (. fn args count) 0) (. fn name))
          (let atom (. fn name))
          (return (== (. atom text) "close"))
        )
      )
    )
    (return false)
  )
  (fn-do _ has-events Bool
    (param type TypeId)
    ; Whether a class declares an event or inherits one, in its body or in a facet.
    (let cursor type)
    (while (!= cursor no-type)
      (match? ([] (. types rows) cursor)
        (case (call .type-class row)
          (let target ([] (. program modules) (. row module)))
          (match? ([] (. target decls) (. row decl))
            (case (call .decl-class class)
              (return-if true (if (call (. target has-event-member) (. class members))))
            )
          )
          (return-if true (if (call facets-have-events (. row module) (. row decl))))
        )
      )
      (= cursor (?? (call (. types base-of) cursor) no-type))
    )
    (return false)
  )
  (fn-do _ facets-have-events Bool
    (param class-module ModuleId)
    (param class-decl DeclId)
    ; Whether a facet of a class declares an event.
    (let facets (. program facets))
    (return-if false (if (== (. facets count) 0)))
    (blank)
    (let (tuple start end) (call (. facets class-range) class-module class-decl))
    (for (in position (..< start end))
      (let facet ([] (. facets class-facets) position))
      (let home ([] (. program modules) ([] (. facets modules) facet)))
      (match? ([] (. home decls) ([] (. facets decls) facet))
        (case (call .decl-extension row)
          (return-if true (if (and (== ([] (. facets states) facet) .facet-bound) (call (. home has-event-member) (. row members)))))
        )
      )
    )
    (return false)
  )
  (fn-do _ demand-event-close _
    ; The event runtime's `event-close-owner`, which the `close` of a class with events calls as it
    ; leaves, so that what subscribes to the object's events no longer hears them.
    (if (!= (. facts event-close) no-instance)
      (return)
    )
    (let mark (. scratch types mark))
    (call (. scratch types push) (call pointer-to (call (. types type-row) .uint8)))
    (= (. facts event-close)
      (call (. calls demand-runtime-call)
        (block
          (arg (. types event-endpoint-decl module))
          (arg no-type)
          (arg (call (. program store-atom) "event-close-owner"))
          (arg mark)
        )
      )
    )
    (call (. scratch types rewind) mark)
  )
  (fn-do _ is-generator-end Bool
    (param declaration CheckedDecl)
    ; A generator's `end-iterating` closes the generator in the reference, which can panic.
    (if (or (== (. frame self-type) no-type) (== (. frame self-type) invalid-type))
      (return false)
    )
    (if (not (call same-decl (call class-ref types (. frame self-type)) (. types generator-decl)))
      (return false)
    )
    (match? ([] (. ([] (. program modules) module) decls) (. frame decl))
      (case (call .decl-function fn)
        (if (and (!= (. fn owner) 0) (== (. fn args count) 0) (. fn name))
          (let atom (. fn name))
          (return (== (. atom text) "end-iterating"))
        )
      )
    )
    (return false)
  )
  (fn-do _ note-explicit-return _
    (param id SyntaxId)
    (param expr SyntaxId)
    ; Where an explicit return may be written. A cleanup and the body of `main` or of a loop on a
    ; stream have none, a task's body returns no value, and a function that is not imperative
    ; states it needs `do`. In the body of a rule of a class one with no value leaves the body, and
    ; one with a value is reported, as a rule gives none.
    (if (. finally cleaning-up)
      (call (. frame diagnose) id .stated (call (. program store-atom) "Illegal deferred statement"))
      (return)
    )
    (if (call is-rule-unit)
      (if (!= expr 0)
        (let text
          (paragraph
            "A rule gives no value, so its body cannot return one with \"(return …)\"; end it early with \"(return)\""
          )
        )
        (call (. frame diagnose) id .stated (call (. program store-atom) text))
      )
      (return)
    )
    (if (call is-subscriber-body)
      (call (. frame diagnose) id .stated (call (. program store-atom) "Illegal return from subscriber"))
      (return)
    )
    (if (and (== (. frame declaration kind) .task-decl) (!= expr 0))
      (let text
        (paragraph
          "A task gives no value, so its body cannot return one with \"(return …)\"; end it with \"(return)\", or send the value on a channel"
        )
      )
      (call (. frame diagnose) id .stated (call (. program store-atom) text))
      (return)
    )
    (if (. frame declaration is-main)
      (call (. frame diagnose) id .stated (call (. program store-atom) "Illegal return"))
      (return)
    )
    (if (or (. frame declaration is-imperative) (call checks-at-declaration (. frame declaration)))
      (return)
    )
    (call (. frame diagnose) id .explicit-return-requires-do)
  )
  (fn-do _ note-returned-match _
    (param expr SyntaxId)
    (param declared TypeId)
    ; A match that is returned is the value of the declared return type, and so are its arms,
    ; and so is a grammar its body runs beside the lazy locals declared for it.
    (call (. facts set-node-type) instance expr declared)
    (match? ([] (. tree nodes) expr)
      (case (call .node-match-expression row)
        (call (. facts set-node-type) instance (. row body) declared)
        (let streamed (call (. tree stream-statement) (. row body)))
        (if (and (!= streamed 0) (!= streamed (. row body)))
          (call (. facts set-node-type) instance streamed declared)
        )
      )
    )
  )
  (fn-do _ expect-arms Bool
    (param value SyntaxId)
    (param expected TypeId)
    (let arms (call (. tree arms-value) value))
    (let expects (and (!= expected no-type) (!= expected invalid-type) (!= expected (. types void-type))))
    (return-if false (if (or (not expects) (not (call (. tree is-arms-syntax) arms)) (call may-miss arms expected))))
    (blank)
    (call note-returned-match arms expected)
    (= arms-expected expected)
    (return true)
  )
  (fn-do _ may-miss Bool
    (param expr SyntaxId)
    (param declared TypeId)
    ; Whether a returned match runs a grammar no arm of which need pass, in a function
    ; that returns no optional. The reference types such a match as it does one that is not
    ; returned, an optional of what its arms give, and the return converts it as any optional,
    ; at the match and not at its arms.
    (if (or (== declared no-type) (== declared (. types void-type)) (call (. types is-optional) declared))
      (return false)
    )
    (match? ([] (. tree nodes) expr)
      (case (call .node-match-expression row)
        (match? ([] (. tree nodes) (call (. tree stream-statement) (. row body)))
          (case (call .node-stream-match stream)
            (return (not (call always-passes (. stream pattern))))
          )
        )
      )
    )
    (return false)
  )
  (fn-do _ require-do _
    (param id SyntaxId)
    (param message String)
    ; A function that is not `do` is one expression: it has no immediate declarations, loops or
    ; yields outside a `do` block. Generated closures run their own statements and are exempt, and
    ; one the module declares is checked as it is declared (`check-return-mode`).
    (if (or (!= do-depth 0) (. frame declaration is-imperative) (. frame declaration is-main))
      (return)
    )
    (if (and (!= (. frame declaration kind) .function-decl) (!= (. frame declaration kind) .closure-decl))
      (return)
    )
    (if (call checks-at-declaration (. frame declaration))
      (return)
    )
    (call (. frame diagnose) id .stated (call (. program store-atom) message))
  )
  (fn-do _ check-return _
    (param statement SyntaxId)
    (param expr SyntaxId)
    (param is-conditional Bool)
    (if (== expr 0)
      (if is-conditional
        (= giving (= (. giving defaulted) true))
        (if (== default-site 0)
          (= default-site statement)
        )
        (else
          (= giving (= (. giving empty) true))
        )
      )
      (return)
    )
    (let declared declared-return)
    (let missing (call may-miss (call (. tree arms-value) expr) declared))
    (call expect-arms expr declared)
    (let value (if-expr (== declared no-type) (call returned-symbol expr) no-type))
    (if (== value no-type)
      (call expect-feeds expr declared)
      (= value (call infer-with-expected expr declared (call (. (call Want) escaping) declared expr)))
    )
    (if (not is-conditional)
      (= value (call returned-value statement value))
    )
    (let noted value)
    (let whole (and is-conditional (!= value no-type) (!= value invalid-type) (call (. types is-optional) value)))
    (if whole
      (= noted (call (. types optional-inner) value))
    )
    (match? ([] (. tree nodes) expr)
      (case .node-optional-chain
        (if (and (!= value no-type) (!= value invalid-type) (call (. types is-optional) value))
          (= noted (call (. types optional-inner) value))
        )
      )
    )
    ; A conditional return of `null` from a function that returns an optional gives the null of the
    ; return type itself: nothing converts.
    (let returns-optional (and (!= declared no-type) (call (. types is-optional) declared)))
    (let gives-null (and is-conditional (call (. narrowing is-null-syntax) expr) returns-optional))
    ; A conditional return of an optional returns the optional itself: what it holds only counts
    ; toward the type the returns unify to.
    (if (and (!= declared no-type) (!= declared (. types void-type)) (not gives-null))
      (call (. calls note-context-cast) expr declared .cast-return)
      (let located (or (not (call (. tree is-string-syntax) expr)) (call (. types is-optional) declared)))
      (call (. conversions convert)
        (block
          (arg (if-expr missing expr (call (. tree return-site) expr)))
          (arg expr)
          (arg (if-expr whole value noted))
          (arg declared)
          (arg .reason-return)
          (arg located)
        )
      )
      (else-if whole
        (+= whole-returns statement)
        (= giving (= (. giving whole) true))
      )
    )
    (call (. frame note-return) noted statement)
  )
  (fn-do _ refuse-default _
    (param statement SyntaxId)
    ; A return written with only its condition gives nothing, false or an optional that holds
    ; nothing: a function declared to return anything else has none of those to give. A
    ; constructor's leaves it with the object it has made, and a function that yields ends what
    ; it makes there, so the first such return is refused once the body is typed.
    (if (== (. frame declaration kind) .constructor-decl)
      (return)
    )
    (let declared declared-return)
    (if (or (== declared no-type) (== declared invalid-type) plain-return)
      (return)
    )
    (lazy plain-return (or (== declared (. types void-type)) (== declared (. types bool-type))))
    (if (call (. types is-optional) declared)
      (return)
    )
    (let message
      (paragraph
        (str "Condition-only early return cannot return from " (call type-display types declared) "; use an optional, Bool, or Void return type")
      )
    )
    (call (. frame diagnose) statement .stated (call (. program store-atom) message) declared)
  )
  (fn-do _ returned-value TypeId
    (param statement SyntaxId)
    (param value TypeId)
    ; What a return gives of a value that may be an error: the value alone. Each error leaves the
    ; function at the return, in the place of its value.
    (if (or (== value no-type) (== value invalid-type))
      (return value)
    )
    (match? ([] (. types rows) value)
      (case (call .type-result row)
        (for (in offset (..< 0 (. row errors count)))
          (call note-outgoing (call (. types child-type) (. row errors) offset) statement)
        )
        (call (. facts set-plan) instance statement .plan-fused)
        (return (. row value))
      )
    )
    (return value)
  )
  (fn-do _ convert-returns _
    (param unified TypeId)
    (param final TypeId)
    ; Converts what each return gives to the type the returns unify to, and then to the optional
    ; of it where the function may also return nothing. A conditional return of an optional gives
    ; the optional itself, which converts to the type the function returns in one step.
    (let wraps (and (!= final unified) (!= final no-type) (!= final invalid-type) (call (. types is-optional) final)))
    (for (in position (..< (. frame returns-start) (. scratch returns length)))
      (let site ([] (. scratch returns) position))
      (let skipped (or (== (. site type) no-type) (== (. site type) invalid-type) (== (. site type) (. types null-type))))
      (if skipped
        (continue)
      )
      (if (!= (call (. whole-returns find) (. site syntax)) null)
        (let given (call (. types optional-of) (. site type)))
        (let target (if-expr wraps final unified))
        (if (!= given target)
          (call (. conversions convert) (. site syntax) (. site syntax) given target .reason-return)
        )
        (continue)
      )
      (if (!= (. site type) unified)
        (call (. conversions convert) (. site syntax) (. site syntax) (. site type) unified .reason-return)
      )
      (if wraps
        (call (. conversions convert) (. site syntax) (. site syntax) unified final .reason-return)
      )
    )
  )
  (fn-do _ returned-symbol TypeId
    (param expr SyntaxId)
    (let symbol (call (. tree symbol-of) expr))
    (if (not symbol)
      (return no-type)
    )
    (for (in position (..< (. frame returns-start) (. types scratch returns length)))
      (let noted (. ([] (. types scratch returns) position) type))
      (if (and (!= noted no-type) (!= noted invalid-type) (call enum-case-decl types program noted symbol))
        (call note-enum-case noted symbol expr)
        (call (. facts set-node-type) instance expr noted)
        (return noted)
      )
    )
    (return no-type)
  )
  (fn-do _ settle-symbol-returns _
    (let symbolic false)
    (let candidates (list TypeId))
    (let counts (list U32))
    (for (in position (..< (. frame returns-start) (. scratch returns length)))
      (let site ([] (. scratch returns) position))
      (if (call (. tree symbol-of) (call (. tree returned-expr) (. site syntax)))
        (= symbolic true)
      )
      (if (or (== (. site type) no-type) (== (. site type) invalid-type) valueless)
        (continue)
      )
      (lazy valueless (or (== (. site type) (. types null-type)) (== (. site type) (. types void-type))))
      (let found (. U32 max))
      (for (in index (..< 0 (. candidates length)))
        (if (== ([] candidates index) (. site type))
          (= found (as index U32))
        )
      )
      (if (== found (. U32 max))
        (+= candidates (. site type))
        (+= counts 1)
        (else
          (+= ([] counts found) 1)
        )
      )
    )
    (if (or (not symbolic) (< (. candidates length) 2))
      (return)
    )
    (for (in index (..< 1 (. candidates length)))
      (let place index)
      (while (and (> place 0) (< ([] counts (- place 1)) ([] counts place)))
        (let held ([] candidates place))
        (= ([] candidates place) ([] candidates (- place 1)))
        (= ([] candidates (- place 1)) held)
        (let tally ([] counts place))
        (= ([] counts place) ([] counts (- place 1)))
        (= ([] counts (- place 1)) tally)
        (-= place 1)
      )
    )
    (for (in candidate candidates)
      (if (call symbol-returns-fit candidate)
        (call retype-symbol-returns candidate)
        (return)
      )
    )
  )
  (fn-do _ settle-literal-returns TypeId
    (param value TypeId)
    ; Gives an integer a function returns written with no suffix the type of the first other value it
    ; returns, as an integer beside that value takes, so `= 0` beside `= count` returns the type of
    ; `count`, or where each is written with none, that of the first float, so `= 1` beside `= 2.5`
    ; returns a float. Returns what the value the body ends with now has.
    (let tail (if-expr (and (not (. frame declaration is-imperative)) (!= value no-type)) value-syntax 0))
    (let peer no-type)
    (let float no-type)
    (for (in position (..< (. frame returns-start) (. scratch returns length)))
      (let site ([] (. scratch returns) position))
      (let expr (call (. tree returned-expr) (. site syntax)))
      (if (and (== peer no-type) (call returns-peer (. site type)) (== (call (. conversions literal-of) expr) 0))
        (= peer (. site type))
      )
      (if (and (== float no-type) (call returns-peer (. site type)) float-literal)
        (= float (. site type))
      )
      (lazy float-literal (and (!= (call (. conversions literal-of) expr) 0) (is ([] (. tree nodes) expr) .node-float-syntax)))
    )
    (if (and (== peer no-type) (!= tail 0) (call returns-peer value) (== (call (. conversions literal-of) tail) 0))
      (= peer value)
    )
    (if (and (== float no-type) (!= tail 0) (call returns-peer value) float-tail)
      (= float value)
    )
    (lazy float-tail (and (!= (call (. conversions literal-of) tail) 0) (is ([] (. tree nodes) tail) .node-float-syntax)))
    (if (== peer no-type)
      (= peer float)
    )
    (return-if value (if (== peer no-type)))
    (blank)
    (for (in position (..< (. frame returns-start) (. scratch returns length)))
      (let site ([] (. scratch returns) position))
      (let expr (call (. tree returned-expr) (. site syntax)))
      (if (and (!= (. site type) peer) (call returns-peer (. site type)) (!= (call (. conversions literal-of) expr) 0))
        (= ([] (. scratch returns) position)
          (call TypedSite
            (block
              (arg (call (. conversions adapted-literal) expr (. site type) peer))
              (arg (. site syntax))
            )
          )
        )
      )
    )
    (return
      (scope (if-expr literal-tail (call (. conversions adapted-literal) tail value peer) value)
        (lazy literal-tail (and (!= tail 0) (!= (call (. conversions literal-of) tail) 0)))
      )
    )
  )
  (fn-expr _ returns-peer Bool
    (param type TypeId)
    (and (!= type no-type) (!= type invalid-type) (!= type (. types null-type)) (!= type (. types void-type)))
  )
  (fn-do _ symbol-returns-fit Bool
    (param candidate TypeId)
    (for (in position (..< (. frame returns-start) (. scratch returns length)))
      (let site ([] (. scratch returns) position))
      (if (or no-value (== (. site type) (. types void-type)) (== (. site type) candidate))
        (continue)
      )
      (lazy no-value (or (== (. site type) no-type) (== (. site type) invalid-type) (== (. site type) (. types null-type))))
      (let symbol (call (. tree symbol-of) (call (. tree returned-expr) (. site syntax))))
      (if (and symbol (call enum-case-decl types program candidate symbol))
        (continue)
      )
      (if (not (call relation-legal (call (. relations compare) (. site type) candidate)))
        (return false)
      )
    )
    (return true)
  )
  (fn-do _ retype-symbol-returns _
    (param candidate TypeId)
    (for (in position (..< (. frame returns-start) (. scratch returns length)))
      (let site ([] (. scratch returns) position))
      (if (or (== (. site type) candidate) (== (. site type) no-type) (== (. site type) invalid-type))
        (continue)
      )
      (let expr (call (. tree returned-expr) (. site syntax)))
      (let symbol (call (. tree symbol-of) expr))
      (if (and symbol (call enum-case-decl types program candidate symbol))
        (call note-enum-case candidate symbol expr)
        (call (. facts replace-node-type) instance expr candidate)
        (= ([] (. scratch returns) position) (call TypedSite candidate (. site syntax)))
      )
    )
  )
  (fn-do _ yielded-value TypeId
    (param id SyntaxId)
    (param expr SyntaxId)
    ; `<=?` yields only a present value, so the optional it reads unwraps; the reference types the
    ; statement as the optional it tests.
    (let value (call infer expr))
    (match? ([] (. tree nodes) expr)
      (case .node-optional-chain
        (if (call (. types is-optional) value)
          (call (. facts set-node-type) instance id value)
          (return (call (. types optional-inner) value))
        )
      )
    )
    (return value)
  )
  (fn-do _ note-yield _
    (param value TypeId)
    (param site SyntaxId (= 0))
    (param looped Bool (= false))
    (param literal SyntaxId (= 0))
    ; Notes a yield and what it gives. One a statement writes is kept with where it is
    ; written, to be converted to the type of the function's items once that is known. The
    ; items have the type the yields unify to in the order they are written, as the reference
    ; folds them: each with the type the relation before it converted to, so that of two
    ; tuples or two lists neither of which is the wider, the first stays. Nothing is unified
    ; where the function declares its items. The reference folds in the order of its blocks,
    ; which is the order written only outside loops: a fold that gives another type the other
    ; way round is noted, with whether any yield is in a loop (F12b-30). The yields of a list of
    ; feeds are kept until the list is typed, and folded in the order of its blocks, which
    ; visit each branch's failing successor first: a feed that tests before it yields, a `**`
    ; by its loop and a `*?` by its test, yields after everything the feeds after it yield. A
    ; yield written as a number with no suffix, as such numbers or as a range of such integers, is
    ; kept with what it writes, which takes the type of the others as the items of a list do.
    (= giving (= (. giving yields) true))
    (if (or (!= loop-depth 0) looped)
      (= loops-yields true)
    )
    (if (or (== value invalid-type) (== value no-type))
      (return)
    )
    (if (!= site 0)
      (call (. frame note-yielded) value site)
      (+= yield-literals literal)
    )
    (if orders-yields
      (+= ordered-yields value)
      (+= ordered-sites site)
      (+= ordered-literals literal)
      (return)
    )
    (call fold-yield value site false literal)
  )
  (fn-do _ fold-yield _
    (param value TypeId)
    (param site SyntaxId)
    (param ordered Bool)
    (param literal SyntaxId)
    ; Folds a yield into what the yields so far unify to. One written as a number with no suffix
    ; that the others hold is of their type, and where each so far is written so, they are of the
    ; type of one they all fit, or of tuples such numbers write, the tuple they join to place by place.
    (if (== (. giving yielded) no-type)
      (= giving (= (. giving yielded) value))
      (= folded-yield value)
      (= folded-literal (!= literal 0))
      (return)
    )
    (if (call states-items)
      (return)
    )
    (let relation (call (. relations unify) folded-yield value))
    (if (and (not (call relation-legal relation)) (!= literal 0) (call yield-fits literal folded-yield))
      (return)
    )
    (if (and (not (call relation-legal relation)) folded-literal (call literals-fit value))
      (= folded-yield value)
      (= giving (= (. giving yielded) value))
      (= folded-literal (!= literal 0))
      (return)
    )
    (if (and (not (call relation-legal relation)) folded-literal (!= literal 0))
      (let joined (call (. relations joined-places) folded-yield value))
      (if (and (!= joined no-type) (call literals-fit joined))
        (= folded-yield joined)
        (= giving (= (. giving yielded) joined))
        (return)
      )
    )
    (if (== literal 0)
      (= folded-literal false)
    )
    (if (call relation-legal relation)
      (if (and (!= folded-yield value) (not ordered))
        (let back (call (. relations unify) value folded-yield))
        (if (or (not (call relation-legal back)) (!= (. back unified) (. relation unified)))
          (= splits-yields true)
        )
      )
      (= folded-yield (. relation to))
      (= giving (= (. giving yielded) (. relation unified)))
      (else-if (and (!= site 0) (< (. frame yields-start) (. scratch yields length)))
        (let first (. ([] (. scratch yields) (. frame yields-start)) syntax))
        (match? ([] (. tree nodes) first)
          (case (call .node-yield row)
            (= first (. row expr))
          )
        )
        (call (. frame diagnose) first .stated (call (. program store-atom) "Unable to unify generator yield types"))
      )
    )
  )
  (fn-do _ literals-fit Bool
    (param target TypeId)
    ; Whether each yield noted that is written as a number with no suffix is one a type holds.
    (return (call all yield-literals (:where (or (== each 0) (call yield-fits each target)))))
  )
  (fn-do _ yield-fits Bool
    (param literal SyntaxId)
    (param target TypeId)
    ; Whether a yield written as a number with no suffix, as such numbers, or as a range of such
    ; integers is one a type holds.
    (match? ([] (. tree nodes) literal)
      (case (call .node-range-expression row)
        (return
          (scope (and (== (. row increment) 0) (call (. conversions fitting-literal) (. row left) target) right-fits)
            (lazy right-fits (call (. conversions fitting-literal) (. row right) target))
          )
        )
      )
    )
    (return (call (. conversions fitting-literal) literal target))
  )
  (fn-expr _ written-literal SyntaxId
    (param syntax SyntaxId)
    ; What a yield writes where it is a number with no suffix, such numbers, or a range of such
    ; integers, or none.
    (case? (!= (call (. conversions literal-of) syntax) 0)
      syntax
    )
    (default
      (match ([] (. tree nodes) syntax)
        (case (call .node-range-expression row)
          (if-expr (and (== (. row increment) 0) plain-left plain-right) syntax 0)
          (blank)
          (lazy plain-left (call (. conversions is-plain-integer) (. row left)))
          (lazy plain-right (call (. conversions is-plain-integer) (. row right)))
        )
        (default
          0
        )
      )
    )
  )
  (fn-expr _ states-items Bool
    ; Whether the function declares what its yields give, as a generator, a stream, an iterable
    ; or an indexable of it.
    (case? (or (== declared no-type) (== declared invalid-type))
      false
    )
    (case? (or (call same-decl ref (. types generator-decl)) (call same-decl ref (. types stream-decl)))
      true
    )
    (default
      (or (call same-decl ref (. types iterable-decl)) (call same-decl ref (. types indexable-decl)))
    )
    (where
      (lazy declared declared-return)
      (lazy ref (call class-ref types declared))
    )
  )
  (fn-expr _ is-range-type Bool
    (param type TypeId)
    (match ([] (. types rows) type)
      (case (call .type-class row)
        (and (== (. row module) (. types range-decl module)) (== (. row decl) (. types range-decl decl)))
      )
      (default
        false
      )
    )
  )
  (fn-expr _ is-array-type Bool
    (param type TypeId)
    (match ([] (. types rows) type)
      (case (call .type-class row)
        (and (== (. row module) (. types array-decl module)) (== (. row decl) (. types array-decl decl)))
      )
      (default
        false
      )
    )
  )
  (fn-expr _ holds-array-items Bool
    (param type TypeId)
    (match ([] (. types rows) type)
      (case (call .type-class row)
        (or (call (. types array-decl refers-to) (. row module) (. row decl)) (call (. types immutable-array-decl refers-to) (. row module) (. row decl)))
      )
      (default
        false
      )
    )
  )
  (fn-do _ content-parent TypeId
    (param block SyntaxId)
    ; The type of the markup element a block's lines are content of, or no type for a block
    ; that is not such a one.
    (let position (. content-blocks length))
    (while (!= position 0)
      (-= position 1)
      (if (== ([] content-blocks position) block)
        (return ([] content-parents position))
      )
    )
    (return no-type)
  )
  (fn-do _ check-body _
    (param body SyntaxId)
    ; The body of a loop or of an arm of an `if`, a match or a markup branch region. One written as
    ; one line that is content of a markup element runs as a block of that line would: the elements
    ; it names are made first, and the element takes the line's value, but for a match that runs its
    ; arms as content (`runs-content`). Outside markup the body is one of steps (`check-steps`).
    (let parent (call content-parent body))
    (if (== parent no-type)
      (call check-steps body)
      (return)
    )
    (if (is ([] (. tree nodes) body) .node-block)
      (call check-statement body)
      (return)
    )
    (call raise-line body)
    (let hosted (. content-blocks length))
    (call host-content body parent)
    (let steps (call runs-content body))
    (let want
      (block
        (case? steps
          (call (. (call (. (call Want) adding) .want-content-line) adding) .want-match-statement)
        )
        (default
          (call (. (call Want) adding) .want-content-line)
        )
      )
    )
    (let produced (call check-line body parent want))
    (while (!= (. content-blocks length) hosted)
      (call (. content-blocks pop))
      (call (. content-parents pop))
    )
    (if (not (call leaves-line body))
      (if (not steps)
        (call link-content body produced parent)
      )
      (else
        (call (. frame diagnose) body .stated (call (. program store-atom) "Illegal return"))
      )
    )
  )
  (fn-do _ check-steps TypeId
    (param body SyntaxId)
    (= steps-block body)
    (let value
      (call check-statement
        (block
          (arg body)
          (arg (if-expr (call runs-steps body) (call (. (call Want) adding) .want-match-statement) (call Want)))
        )
      )
    )
    (= steps-block 0)
    (return value)
  )
  (fn-do _ check-arm-value TypeId
    (param body SyntaxId)
    ; The value of the body of an arm whose match gives one: that of the row it ends on.
    (= arm-block body)
    (let value (call check-statement body))
    (= arm-block 0)
    (return value)
  )
  (fn-expr _ runs-steps Bool
    (param statement SyntaxId)
    (and (call (. tree is-match-syntax) statement) (call in-steps))
  )
  (fn-expr _ in-steps Bool
    ; Whether what is checked runs as steps: in a `do`, a function or closure that runs steps, or
    ; `main`.
    (or (!= do-depth 0) (. frame declaration is-imperative) (. frame declaration is-main))
  )
  (fn-do _ check-if _
    (param id SyntaxId)
    (param condition SyntaxId)
    (param body SyntaxId)
    (param next SyntaxId)
    (if (== condition 0)
      (call check-body body)
      (call check-statement next)
      (return)
    )
    (= tested-match (call (. tree tested) condition))
    (call note-truthiness condition condition (call infer condition))
    (= tested-match 0)
    (let assigned-mark (. frame assigned-syntax length))
    (let body-mark (. scratch narrowings mark))
    (let dead (call never-holds condition true))
    (let known (call (. frame save-members)))
    (if dead
      (call (. facts set-plan) instance id .plan-never)
      (else
        (call (. narrowing narrow-condition) condition true)
        (call check-body body)
      )
    )
    (let split (. frame assigned-syntax length))
    (let body-settled (call (. frame assigned-since) body-mark))
    (call (. frame pop-narrowing) body-mark)
    (let next-mark (. scratch narrowings mark))
    (let body-known (call (. frame save-members)))
    (call (. frame restore-members) known)
    (call (. frame restore-stores) known)
    (call (. narrowing narrow-condition) condition false)
    (call check-statement next)
    (let body-exits (and (not dead) (call (. narrowing exits) body)))
    (let next-exits (and (!= next 0) (call (. narrowing exits) next)))
    (if (and next-exits (not body-exits))
      (call (. frame restore-members) body-known)
      (call (. frame restore-stores) body-known)
      (else-if (not body-exits)
        (call (. frame merge-members) body-known)
      )
    )
    (if (and body-exits (not next-exits))
      (call (. frame forget-assignments) assigned-mark)
      (return)
    )
    (let next-settled (call (. frame assigned-since) next-mark))
    (call (. frame pop-narrowing) next-mark)
    (if (and next-exits (not body-exits))
      (call (. narrowing narrow-condition) condition true)
      (call (. frame keep-assigned) body-settled)
      (else-if (and (== next 0) (not body-exits))
        (call merge-assignments condition body body-settled)
        (call widen-settled body-settled)
      )
      (else-if (and (not next-exits) (not body-exits) (not dead))
        (call join-branches condition body next assigned-mark split)
        (call widen-settled body-settled)
        (call widen-settled next-settled)
      )
      (else-if (and dead (not next-exits))
        (call (. frame keep-assigned) next-settled)
      )
    )
    (call (. frame forget-assignments) assigned-mark)
  )
  (fn-expr _ settled-now TypeId
    (param key NarrowingKey)
    ; What a key is known as where the type pass stands: the type of a local, or what a member
    ; or a path is narrowed to, which is no type for one that is not narrowed.
    (if-expr (call is-member-key key) (call (. frame held-member) key) (call (. frame key-type) key))
  )
  (fn-do _ widen-settled _
    (param settled (list Narrowed))
    ; After a region that may not have run, a key that an assignment in it left other than it is
    ; known now is known no longer: a local is what its declaration says, and a member or a path
    ; is not narrowed. What the paths through the region agree on is made known before this.
    (for (in row settled)
      (let held (. row type))
      (let plain no-type)
      (if (not (call is-member-key (. row key)))
        (= plain (call slot-known (call key-slot (. row key))))
        (if (== held no-type)
          (= held plain)
        )
      )
      (if (!= held (call settled-now (. row key)))
        (call (. frame push-assigned) (. row key) plain)
      )
    )
  )
  (fn-do _ pop-conditional _
    (param mark ScratchMark)
    ; Ends a region that runs under a condition, which is no statement of its own: what an
    ; assignment in it settled is known no longer where it differs from what was known before.
    (let settled (call (. frame assigned-since) mark))
    (call (. frame pop-narrowing) mark)
    (call widen-settled settled)
  )
  (fn-do _ join-branches _
    (param condition SyntaxId)
    (param body SyntaxId)
    (param next SyntaxId)
    (param mark Size)
    (param split Size)
    ; After an `if` with an `else`, a local both branches leave as one type is that type: the
    ; branch that assigns it leaves what it assigned, and the other what the condition tells of it.
    (let other next)
    (match? ([] (. tree nodes) next)
      (case (call .node-if-block row)
        (if (== (. row condition) 0)
          (= other (. row body))
        )
      )
    )
    (let end (. frame assigned-syntax length))
    (let slots (list SlotId))
    (for (in position (..< mark end))
      (if (== (call (. slots find) ([] (. frame assigned-slots) position)) null)
        (+= slots ([] (. frame assigned-slots) position))
      )
    )
    (for (in slot slots)
      (let left (call branch-end slot condition true body mark split))
      (let right (call branch-end slot condition false other split end))
      (if (and (!= left no-type) (== left right) (!= left (call (. frame slot-type) slot)))
        (call (. frame push-assigned) (call slot-key slot) left)
      )
    )
  )
  (fn-do _ branch-end TypeId
    (param slot SlotId)
    (param condition SyntaxId)
    (param truth Bool)
    (param branch SyntaxId)
    (param from Size)
    (param to Size)
    ; What a local is where a branch ends: what the branch's own statements last assigned it, or
    ; what the condition tells of it when nothing under the branch assigns it. No type when an
    ; assignment nested in the branch may or may not have run.
    (let last no-type)
    (let direct 0)
    (for (in position (..< from to))
      (let written ([] (. frame assigned-syntax) position))
      (if (and (== ([] (. frame assigned-slots) position) slot) (call (. tree is-direct-statement) branch written))
        (= last ([] (. frame assigned-types) position))
        (+= direct 1)
      )
    )
    (let written 0)
    (for (in id (.. (call (. tree subtree-start) branch) branch))
      (match? ([] (. tree nodes) id)
        (case (call .node-assign row)
          (let target (call (. narrowing condition-slot) (. row lhs)))
          (if (and target (== target slot))
            (+= written 1)
          )
        )
      )
    )
    (if (!= written direct)
      (return no-type)
    )
    (if (!= direct 0)
      (return last)
    )
    (let probe (. scratch narrowings mark))
    (call (. narrowing narrow-condition) condition truth)
    (let known (call (. frame slot-type) slot))
    (call (. frame pop-narrowing) probe)
    (return known)
  )
  (fn-do _ never-holds Bool
    (param condition SyntaxId)
    (param truth Bool)
    ; Whether a condition can never take a truth value, because a type test in it asks a local
    ; for a type its own can never be. The reference compiles neither the branch such a condition
    ; guards nor the operand it short-circuits.
    (match? ([] (. tree nodes) condition)
      (case (call .node-type-predicate row)
        (return (call never-holds (. row expr) truth))
      )
      (case (call .node-unary-expression row)
        (if (== (. row op) .not-op)
          (return (call never-holds (. row operand) (not truth)))
        )
      )
      (case (call .node-binary-expression row)
        (if (or (== (. row op) .and-op) (== (. row op) .or-op))
          (let left (call never-holds (. row lhs) truth))
          (let right (call never-holds (. row rhs) truth))
          (return (if-expr (== (== (. row op) .and-op) truth) (or left right) (and left right)))
        )
        (if (call is-type-test (. row op))
          (let negated (call is-negated-test (. row op)))
          (return (and (!= negated truth) (call impossible-test (. row op) (. row lhs) (. row rhs))))
        )
      )
    )
    (return false)
  )
  (fn-do _ impossible-test Bool
    (param op Operator)
    (param lhs SyntaxId)
    (param rhs SyntaxId)
    (let subject no-type)
    (match? ([] (. tree nodes) lhs)
      (case .node-identifier
        (let resolution (call (. bindings resolution-of) (. frame binding) lhs))
        (if (== (. resolution kind) .resolve-slot)
          (= subject (call (. frame slot-type) (. resolution slot)))
        )
      )
    )
    (if (or (== subject no-type) (== subject invalid-type))
      (return false)
    )
    (let target invalid-type)
    (match ([] (. tree nodes) rhs)
      (case .node-symbol
        (return false)
      )
      (case .node-type-case
        (return false)
      )
      (case (call .node-identifier row)
        (= target (call (. types type-named) module (. row name) (. frame env)))
      )
      (default
        (= target (call (. types evaluate-type) module tree rhs (. frame env)))
      )
    )
    (if (or (== target invalid-type) (. ([] (. types completions) target) has-variables))
      (return false)
    )
    (return (not (call could-match subject target (call is-specificity op))))
  )
  (fn-do _ could-match Bool
    (param subject TypeId)
    (param target TypeId)
    (param kind Specificity)
    (if (. ([] (. types completions) subject) has-variables)
      (return true)
    )
    (if (call (. relations holds-as) (call (. relations compare-pattern) subject target) kind)
      (return true)
    )
    (let intrinsic (call (. types intrinsic-of) subject))
    (if (== intrinsic .optional)
      (return (call could-match (call (. types optional-inner) subject) target kind))
    )
    (if (or (== intrinsic .table-row) (== intrinsic .immutable-table-row))
      (return true)
    )
    (if (!= intrinsic .union)
      (return false)
    )
    (for (in fact (call (. types cases-of) subject))
      (if (and (!= (. fact type) no-type) (!= (. fact type) invalid-type) (call (. relations reaches-case) (. fact type) target kind 0 module))
        (return true)
      )
    )
    (return false)
  )
  (fn-do _ note-carried _
    (param id SyntaxId)
    (param slot SlotId)
    ; Notes a read of a local that relies on what was known of it before a loop around the read
    ; began: nothing in the loop has told more of it since. The body of a `do without gc` block notes
    ; a read of a local it captures for the function around it, where it runs.
    (if (and outer (call (. frame is-captured) slot) in-zone-body)
      (call (. outer note-carried) id slot)
      (return)
    )
    (if (or (== (. loop-marks length) 0) (and outer (call (. frame is-captured) slot)))
      (return)
    )
    (if (== (call (. frame slot-type) slot) (call (. frame known) slot))
      (return)
    )
    (for (in index (..< 0 (. loop-marks length)))
      (if (== (call (. scratch narrowed-since) ([] loop-marks index) (call slot-key slot)) no-type)
        (+= carried-slots slot)
        (+= carried-loops index)
        (+= carried-sites id)
      )
    )
  )
  (fn-do _ forget-carried _
    (param id SyntaxId)
    ; A test of whether a local holds a value relies on nothing known of it.
    (if (== (. carried-sites length) 0)
      (return)
    )
    (let kept 0)
    (for (in position (..< 0 (. carried-sites length)))
      (if (!= ([] carried-sites position) id)
        (= ([] carried-slots kept) ([] carried-slots position))
        (= ([] carried-loops kept) ([] carried-loops position))
        (= ([] carried-sites kept) ([] carried-sites position))
        (+= kept 1)
      )
    )
    (-= ([] carried-slots (..< kept (. carried-slots length))))
    (-= ([] carried-loops (..< kept (. carried-loops length))))
    (-= ([] carried-sites (..< kept (. carried-sites length))))
  )
  (fn-do _ infer-found Found
    (param id SyntaxId)
    (param want Want (= (call Want)))
    ; A node typed as `infer` types it, with what else typing it found (`Found`).
    (if (== id 0)
      (return (call Found no-type))
    )
    (let found (call found-node id want))
    (call settle-typed id (. found type))
    (return found)
  )
  (fn-do _ settle-typed TypeId
    (param id SyntaxId)
    (param inferred TypeId)
    ; Keeps the type a node was found to have, where it has one, and ends what is known of
    ; properties where the node may change them (`unsettles`).
    (if (and (. frame members-narrowed) (call unsettles id))
      (call (. frame doubt-members))
    )
    (if (!= inferred no-type)
      (call (. facts set-node-type) instance id inferred)
    )
    (return inferred)
  )
  (fn-do _ found-node Found
    (param id SyntaxId)
    (param want Want)
    ; What typing a node finds, of the nodes that may find more than their type: names, reads of
    ; members, indexes and calls, which may be links of an optional chain or name events. Any other
    ; node finds its type alone. A node that stands for a value already typed (`standing`) finds that.
    (return-if (call Found standing-type) (if (and (== id standing) (!= standing 0))))
    (blank)
    (match? ([] (. tree nodes) id)
      (case (call .node-identifier row)
        (call note-plain id (. row name))
        (if (. row is-tracked)
          (let tracked (call infer-tracked-name id (. row name) want))
          (return (call (. tracked typed) (call note-collection-read id (. tracked type) want)))
        )
        (return (call infer-identifier id (. row name) want))
      )
      (case (call .node-call-expression row)
        (return (call infer-call id (. row callable) (. row params) (. row args) (. row is-curried) 0 no-type want))
      )
      (case (call .node-get-expression row)
        (let got (call infer-get id (. row object) (. row name) (. row is-optional) want))
        (if (and (not (. row is-tracked)) (not (. row is-optional)) (!= (. got type) invalid-type))
          (call plan-array-field id (. row object) (. row name))
        )
        (if (and (. row is-tracked) (!= (. got type) invalid-type))
          (call note-collection-read id (. got type) want)
          (if (not (call pulled-root id (. row object)))
            (call track-root (. row object))
          )
          (let held (call (. facts node-type) instance (. row object)))
          (call track-read
            (block
              (arg id)
              (arg (if-expr (call (. types is-optional) held) (call (. types optional-inner) held) held))
              (arg (. row name))
            )
          )
        )
        (return got)
      )
      (case (call .node-index-expression row)
        (return (call infer-index id (. row object) (. row index) (. row is-optional) want))
      )
      (case (call .node-markup-read-expression row)
        (return (call infer-markup-read id row))
      )
      (case (call .node-style-read-expression row)
        (return (call infer-style-read id row))
      )
    )
    (return (call Found (call infer-node id want)))
  )
  (fn-do _ found-event U32
    (param event NamedEvent)
    ; Keeps an event a node names for what typed it to take (`Found.event`).
    (+= found-events event)
    (return (as (- (. found-events length) 1) U32))
  )
  (fn-expr _ found-event-of (? NamedEvent)
    (param found Found)
    ; The event a node was found to name, or none.
    (only-if ([] found-events (. found event)) (if (!= (. found event) (. U32 max))))
  )
  (fn-do _ unsettles Bool
    (param id SyntaxId)
    ; Whether a node, once its parts are typed, does something that may end what the reference
    ; knows of a property where this pass keeps it. The reference forgets at every call it
    ; emits but a probe's, also the ones no source writes. This pass forgets at the calls it
    ; settles, and the frame sees the calls and conversions it records. What does none of these is
    ; listed here:
    ; among them a literal string or a nested function made, which the reference makes in place,
    ; a cast, whose conversion the frame sees, unless it is one under `catch` that gives an error
    ; where it fails, a `!` of what the flow knows holds a value, which the reference takes as it
    ; is, `type-of`, arithmetic the reference makes in place, division too, an `is` of a type,
    ; whose conversions the frame sees, a comparison it makes
    ; in place (`compares-in-place`), also of optionals whose flags it tests around such a
    ; comparison of what they hold, a read of a field of a tuple or a struct by a constant index,
    ; a read or a write of a style, which ends what is known of properties as a call does, a call
    ; the compiler answers with no call of its own (`answers-in-place`), and a store to a property
    ; of an object read from a local or the receiver, which ends what the reference ends
    ; (`forget-store-root`). Anything else leaves the two in doubt, and a property
    ; read in doubt is declined.
    (match? ([] (. tree nodes) id)
      (case .node-integer-syntax
        (return false)
      )
      (case .node-cast-expression
        (return (== (call (. facts plan-of) instance id) .plan-caught-cast))
      )
      (case .node-function-syntax
        (return false)
      )
      (case .node-float-syntax
        (return false)
      )
      (case .node-string-syntax
        (return false)
      )
      (case .node-identifier
        (return false)
      )
      (case .node-get-expression
        (return false)
      )
      (case .node-index-expression
        (return (and (!= (call (. facts plan-of) instance id) .plan-field) (not (call (. facts answers-in-place) instance id))))
      )
      (case .node-style-read-expression
        (return false)
      )
      (case .node-tuple-syntax
        (return false)
      )
      (case .node-optional-chain
        (return false)
      )
      (case .node-type-predicate
        (return false)
      )
      (case .node-block
        (return false)
      )
      (case .node-assertion-syntax
        (return false)
      )
      (case .node-match-expression
        (return false)
      )
      (case .node-structure-match
        (return false)
      )
      (case .node-call-expression
        (return (not (call (. facts answers-in-place) instance id)))
      )
      (case (call .node-binary-expression row)
        (if (and (or (== (. row op) .is-op) (== (. row op) .is-not-op)) (is ([] (. tree nodes) (. row rhs)) .node-symbol))
          (return false)
        )
        (if (and (call is-type-test (. row op)) (== (call (. facts plan-of) instance id) .plan-is) (call tests-type (. row rhs)))
          (return false)
        )
        (let branches
          (scope (or short-circuits (== (. row op) .if-op) (== (. row op) .else-op))
            (lazy short-circuits (or (== (. row op) .and-op) (== (. row op) .or-op) (== (. row op) .coalesce-op)))
          )
        )
        (let plan (call (. facts plan-of) instance id))
        (let compared (if-expr (== plan .plan-held) (. (call (. facts held-of) instance id) plan) plan))
        (return (and (not branches) (!= compared .plan-builtin) (not (call compares-in-place compared))))
      )
      (case (call .node-unary-expression row)
        (if (and (== (. row op) .optional-force-op) (not (call (. types is-optional) operand-type)))
          (return false)
        )
        (lazy operand-type (call (. facts node-type) instance (. row operand)))
        (if (== (. row op) .type-of-op)
          (return false)
        )
        (return (and (!= (. row op) .not-op) (!= (call (. facts plan-of) instance id) .plan-builtin)))
      )
      (case (call .node-assign row)
        (match? ([] (. tree nodes) (. row lhs))
          (case .node-identifier
            (let kind (. (call (. bindings resolution-of) (. frame binding) (. row lhs)) kind))
            (return (and (!= kind .resolve-slot) (!= kind .resolve-member)))
          )
          (case .node-get-expression
            (return (!= settled-store id))
          )
          (case .node-style-read-expression
            (return false)
          )
        )
      )
    )
    (return true)
  )
  (fn-expr _ tests-type Bool
    (param pattern SyntaxId)
    (match ([] (. tree nodes) pattern)
      (case .node-symbol
        false
      )
      (case .node-type-case
        false
      )
      (case .node-type-list
        false
      )
      (case .node-type-map
        false
      )
      (case .node-type-and
        false
      )
      (default
        true
      )
    )
  )
  (fn-expr _ is-typed-name Bool
    (param pattern SyntaxId)
    ; Whether what a declaration declares is one name with the type written for it, which the
    ; declaration matches as `matches-in-place` says.
    (match ([] (. tree nodes) pattern)
      (case (call .node-type-capture row)
        (and (!= (. row type) 0) (not (call reads-name (. row type))))
      )
      (default
        false
      )
    )
  )
  (fn-do _ infer-latest TypeId
    (param id SyntaxId)
    (param value SyntaxId)
    ; The latest item of a stream, `##` of it, as the reference reads it in a live action: the
    ; stream is made a `Broadcastable` where it is written, cast where it supports one and given
    ; to `publisher` where it only iterates, either converted at the stream's own node, apart from
    ; what converts the item where it is read, and a `BroadcasterTracker` is made of it and the empty
    ; value of its item, recorded at the node, which converts it to a `Tracker` there for the
    ; trackers of the action. The local the node declares keeps it for the function that runs the
    ; action again, which reads its `latest`. The node has the item's type. The statement it is
    ; read in runs in a live action as one a tracked read is in does. An event made a stream, and
    ; a read in any other live action, have no shape here.
    (call demand-live-runtime)
    (let given (call infer value))
    (if (or (== given invalid-type) (== given no-type))
      (return invalid-type)
    )
    (if (== (. types broadcastable-decl module) 0)
      (call decline id)
      (return invalid-type)
    )
    (let stream (call supported given (. types broadcastable-decl)))
    (let mark (. scratch types mark))
    (let publisher no-instance)
    (if (and (== stream no-type) (not (call iterates given)))
      (let shown (call type-display types given))
      (call (. frame diagnose)
        (block
          (arg id)
          (arg .stated)
          (arg (call (. program store-atom) (str "Object is not a broadcastable or iterable: " shown)))
          (arg given)
        )
      )
      (return invalid-type)
    )
    (if (== stream no-type)
      (call (. scratch types push) given)
      (= publisher
        (call (. calls demand-runtime-call)
          (block
            (arg (. types broadcastable-decl module))
            (arg no-type)
            (arg (call (. program store-atom) "publisher"))
            (arg mark)
          )
        )
      )
      (call (. scratch types rewind) mark)
      (if (== publisher no-instance)
        (call decline id)
        (return invalid-type)
      )
      (call (. conversions convert)
        (block
          (arg value)
          (arg value)
          (arg given)
          (arg (call (. instances argument-type) publisher 0))
          (arg .reason-argument)
        )
      )
      (do
        (inline (call (. facts record-call) instance id publisher .call-function (. scratch no-fills) false))
      )
      (= stream (. ([] (. instances signatures) publisher) returns))
      (else
        (call (. conversions convert) value value given stream .reason-argument)
      )
    )
    (let item (call first-arg stream))
    (let tracking
      (block
        (case? (!= item no-type)
          (call (. types well-known-type-of) "core/tracker" "BroadcasterTracker" item)
        )
        (default
          invalid-type
        )
      )
    )
    (let tracker (call (. types well-known-type) "core/tracker" "Tracker"))
    (if (or (== tracking invalid-type) (== tracker invalid-type) (== (. instances live add-tracker) no-instance))
      (call decline id)
      (return invalid-type)
    )
    (call (. scratch types push) stream)
    (call (. scratch types push) item)
    (let made (call (. calls demand-constructor) tracking mark))
    (call (. scratch types rewind) mark)
    (if (== made no-instance)
      (call decline id)
      (return invalid-type)
    )
    (let kept (. ([] (. instances signatures) made) returns))
    (call (. conversions convert) id id kept tracker .reason-argument)
    (+= (. facts latest-reads) (call LatestRead instance id stream made publisher))
    (let resolution (call (. bindings resolution-of) (. frame binding) id))
    (if (== (. resolution kind) .resolve-slot)
      (call (. frame assign) (. resolution slot) kept)
    )
    (call (. instances mark-may-panic) instance)
    (if (!= (. frame declaration kind) .live-decl)
      (if (!= (call live-context (call read-site id)) .live-statement)
        (call decline id)
        (return invalid-type)
      )
      (call note-live-statement (call read-site id))
    )
    (return item)
  )
  (fn-do _ infer-held TypeId
    (param id SyntaxId)
    (param expr SyntaxId)
    ; The middle of a chain of orderings has the type of its expression, which its slot keeps for
    ; the ordering that reads it.
    (let held (call infer expr))
    (let resolution (call (. bindings resolution-of) (. frame binding) id))
    (if (== (. resolution kind) .resolve-slot)
      (call (. frame assign) (. resolution slot) held)
    )
    (return held)
  )
  (fn-do _ infer-held-read TypeId
    (param id SyntaxId)
    ; The ordering after the middle of a chain reads the type the middle's slot keeps. A read
    ; that no middle was held for is declined.
    (let resolution (call (. bindings resolution-of) (. frame binding) id))
    (if (!= (. resolution kind) .resolve-slot)
      (call decline id)
      (return invalid-type)
    )
    (return (call (. frame slot-type) (. resolution slot)))
  )
  (fn-do _ infer-node TypeId
    (param id SyntaxId)
    (param want Want)
    (match ([] (. tree nodes) id)
      (case (call .node-integer-syntax row)
        (return (call infer-integer id (. row value) (. row unit)))
      )
      (case (call .node-float-syntax row)
        (return (if-expr (. row unit) (call infer-unit-float id (. row value) (. row unit)) (. types f64-type)))
      )
      (case (call .node-symbol row)
        (if (== id (. arm-typing symbol))
          (return (call infer-armed-symbol id (. row name)))
        )
        (return (call infer-symbol id (. row name)))
      )
      (case .node-string-syntax
        (return (. types string-type))
      )
      (case .node-identifier
        (return (. (call found-node id want) type))
      )
      (case .node-call-expression
        (return (. (call found-node id want) type))
      )
      (case (call .node-binary-expression row)
        (return (call infer-binary id (. row op) (. row lhs) (. row rhs) (call armed-want id want)))
      )
      (case (call .node-unary-expression row)
        (return (call infer-unary id (. row op) (. row operand)))
      )
      (case (call .node-held-expression row)
        (return (call infer-held id (. row expr)))
      )
      (case .node-held-read
        (return (call infer-held-read id))
      )
      (case (call .node-latest-expression row)
        (return (call infer-latest id (. row expr)))
      )
      (case (call .node-use-expression row)
        (return (call check-use id (. row expr)))
      )
      (case (call .node-catch-optional-expression row)
        (return (call infer-catch-optional id (. row body)))
      )
      (case (call .node-catch-expression row)
        (return (call infer-catch id (. row body) (. row is-raw-result) (. row catchers) want))
      )
      (case (call .node-cast-expression row)
        (return (call infer-cast id (. row lhs) (. row rhs)))
      )
      (case (call .node-range-expression row)
        (return (call infer-range id (. row op) (. row left) (. row right) (. row increment)))
      )
      (case (call .node-tuple-syntax row)
        (return (call infer-tuple (. row items)))
      )
      (case (call .node-header-expression row)
        (return (call infer-header id (. row expr) (. row items)))
      )
      (case (call .node-c-identifier row)
        (let constant (call (. program c-constant-text) module (. row name)))
        (if constant
          (return (call infer-integer id constant null))
        )
        (let bound (call (. calls c-binding) (. row name)))
        (if (== bound no-type)
          (call (. frame diagnose) id .function-not-found (. row name))
          (return invalid-type)
        )
        (return bound)
      )
      (case (call .node-list-syntax row)
        (return (call infer-list id (. row items) want))
      )
      (case .node-get-expression
        (return (. (call found-node id want) type))
      )
      (case (call .node-print row)
        (let printed (call infer-print id (. row body)))
        (if (!= printed invalid-type)
          (call (. calls demand-print) id)
        )
        (return printed)
      )
      (case (call .node-match-expression row)
        (if (call is-region id)
          (call decline id)
          (return invalid-type)
        )
        (return (call infer-match id (. row subject) (. row body) (. row is-optional) (. row helper) (. row is-block) want))
      )
      (case (call .node-stream-match row)
        (return (call infer-stream-match id (. row pattern) (. row is-root)))
      )
      (case (call .node-structure-match row)
        (return (call infer-arms id (. row pattern) want))
      )
      (case (call .node-assign row)
        (let assigned (call infer-assign id (. row op) (. row lhs) (. row rhs) want))
        (if (and (!= assigned invalid-type) (!= (. facts live-statements length) 0))
          (call settle-live-statement id (. row lhs) (. row rhs) (call (. facts node-type) instance (. row rhs)))
        )
        (return assigned)
      )
      (case (all (call .node-property-syntax row) ({} (or (. frame declaration is-content) (== (. frame declaration kind) .live-decl))))
        (return (call infer-content-property id (. row value) want))
      )
      (case (call .node-optional-chain row)
        (return (call infer (. row expr)))
      )
      (case (call .node-type-predicate row)
        (return (call infer (. row expr)))
      )
      (case (call .node-block row)
        (let diagnosed (. facts diagnostics length))
        (let valued (call check-block id (. row body) false))
        (if (and (== valued no-type) (== (. facts diagnostics length) diagnosed))
          (let printed (call (. tree final-print) id))
          (if (!= printed 0)
            (call (. frame diagnose) printed .stated (call (. program store-atom) (call print-block-text)))
            (else
              (call (. frame diagnose) id .stated (call (. program store-atom) "Illegal statement"))
            )
          )
          (return invalid-type)
        )
        (return valued)
      )
      (case .node-function-syntax
        (return (call closure-type id))
      )
      (case (call .node-do-task-block row)
        (if (and (!= (. row worker) 0) (not (. row is-parallel)))
          (call check-worker id (. row worker))
        )
        (call (. frame doubt-members))
        (call check-task id)
        (return (call (. calls demand-task-value) id))
      )
      (case .node-type-identifier
        (let named (call (. types evaluate-type) module tree id (. frame env)))
        (if (and (== named invalid-type) (call report-missing-type id (. frame env)))
          (return invalid-type)
        )
        (return (call type-info-of id named))
      )
      (case .node-core-type-identifier
        (return (call type-info-of id (call (. types evaluate-type) module tree id (. frame env))))
      )
      (case (call .node-assertion-syntax row)
        (call check-assertion id (. row exception) (. row condition))
        (if (== (. row condition) 0)
          (call (. facts mark-leaving) instance id)
        )
        (return no-type)
      )
      (case (call .node-ref-identifier row)
        (let referred (. (call infer-identifier id (. row name) want) type))
        (if (== referred (. types void-type))
          (call (. frame diagnose) id .stated (call (. program store-atom) "Void has no physical address"))
          (return invalid-type)
        )
        (return (call pointer-to referred))
      )
      (case .node-index-expression
        (return (. (call found-node id want) type))
      )
      (case (call .node-iterator-expression row)
        (return (call infer-comprehension id (. row loop) (. row body) (. row next)))
      )
      (case (call .node-iterable-expression row)
        (return (call infer-stream id (. row expr)))
      )
      (case (call .node-argument row)
        (return (call infer-argument-value id row))
      )
      (case .node-feed-expression
        (return (call infer-feeds id 0))
      )
      (case (call .node-pipeline-expression row)
        (return (call infer-pipeline id (. row op) (. row left) (. row right)))
      )
      (case (call .node-anonymous-case row)
        (return (call infer-anonymous-case id (. row name) (. row args) (. row owner)))
      )
      (case .node-type-arguments
        (return (call type-info-of id (call (. types evaluate-type) module tree id (. frame env))))
      )
      (case .node-type-associated
        (return (call type-info-of id (call (. types evaluate-type) module tree id (. frame env))))
      )
      (case .node-pattern-helper-syntax
        (call (. frame diagnose)
          (block
            (arg id)
            (arg .stated)
            (arg (call (. program store-atom) "with helper must be the first clause of a stream match"))
          )
        )
        (return invalid-type)
      )
      (case (call .node-markup row)
        (return (call infer-markup id row want))
      )
      (case (call .node-slot-outlet row)
        (return (call infer-outlet id row))
      )
      (case .node-markup-read-expression
        (return (. (call found-node id want) type))
      )
      (case .node-style-read-expression
        (return (. (call found-node id want) type))
      )
      (case (call .node-style-property-expression row)
        (return (call infer-style-property id row))
      )
      (case .node-style-when
        (call (. frame diagnose)
          (block
            (arg id)
            (arg .stated)
            (arg (call (. program store-atom) "\"when\" state branches are only allowed in style rule bodies"))
          )
        )
        (return invalid-type)
      )
      (case .node-state-machine
        (return (call check-machine-site id))
      )
      (default
        (call decline id)
        (return invalid-type)
      )
    )
  )
  (fn-expr _ is-batch Bool
    (param type TypeId)
    ; Whether objects of a type are batches of markup.
    (if-expr batch-declared (!= (call derived-interface type (. types markup-batch-decl)) no-type) false)
    (where
      (lazy batch-declared (or (!= (. types markup-batch-decl module) 0) (!= (. types markup-batch-decl decl) 0)))
    )
  )
  (fn-expr _ in-batch Bool
    ; Whether a batch of markup is in force where content is being typed.
    (and (!= (. batched length) 0) ([] batched (- (. batched length) 1)))
  )
  (fn-expr _ batch-type TypeId
    ; The `MarkupRootElement` of the markup runtime.
    (call (. types well-known-type) "core/markup" "MarkupRootElement")
  )
  (fn-expr _ line-keeper SlotId
    (param line SyntaxId)
    ; The local no name reaches that keeps the object of the element a line of content is given to,
    ; declared at the line and found by its name, since the line may be a name its node resolves;
    ; the one after it keeps what the element took.
    (call (. bindings declared-at) (. frame slots) line (call (. program store-atom) "(element)"))
  )
  (fn-do _ action-maker (? InstanceId)
    (param site SyntaxId)
    (param made TypeId)
    (param rooted Bool)
    ; The markup runtime's function that makes the live action an object of a class owns, as
    ; `owner-action` says: `make-markup-action` given the batch in force where `rooted`, else
    ; `make-owner-markup-action` given the object as its host. One that has no shape here is
    ; declined, which is answered with nothing.
    (let host
      (scope (if-expr (== (call (. types intrinsic-of) made) .class) markup-host no-type)
        (lazy markup-host (call derived-interface made (. types markup-host-decl)))
      )
    )
    (if (or (!= (call (. types intrinsic-of) made) .class) (and (== host no-type) (not rooted)))
      (call decline site)
      (return null)
    )
    (call demand-live-runtime)
    (let live (. instances live))
    (let mark (. scratch types mark))
    (call (. scratch types push)
      (block
        (arg (if-expr (!= (. live trackers) no-instance) (. ([] (. instances signatures) (. live trackers)) returns) no-type))
      )
    )
    (call (. scratch types push) (. live callback))
    (call (. scratch types push) (if-expr rooted (call batch-type) host))
    (let action
      (call (. calls demand-runtime-call)
        (block
          (arg (. types markup-host-decl module))
          (arg no-type)
          (arg (call (. program store-atom) (if-expr rooted "make-markup-action" "make-owner-markup-action")))
          (arg mark)
        )
      )
    )
    (call (. scratch types rewind) mark)
    (if (or (== action no-instance) (== (. live has-actions) no-instance) other-return)
      (call decline site)
      (return null)
    )
    (lazy other-return (!= (. ([] (. instances signatures) action) returns) (. types live-action-type)))
    (if (not (call raises-out site action))
      (call decline site)
      (return null)
    )
    (return action)
  )
  (fn-expr _ owns-batch Bool
    (param made TypeId)
    ; Whether the live actions a markup element owns are made with a batch, as the reference's
    ; `createMarkupAction` makes them where it finds one for the element: the element itself where
    ; it is a batch, converted at its type as `batch-element` converts it, else the one in force.
    (or (call is-batch made) (call in-batch))
  )
  (fn-do _ argument-name (? Atom)
    (param arg SyntaxId)
    (param element SyntaxId)
    (param from InstanceId)
    ; The name of the parameter an argument of a markup element, given by position, fills, as the
    ; instance that makes the element chose its constructor, or none.
    (let fact (call (. facts latest-call) from element))
    (if (or (== fact no-fact) (== (. ([] (. facts calls) fact) callee) no-instance))
      (return null)
    )
    (let callee ([] (. instances rows) (. ([] (. facts calls) fact) callee)))
    (let owner ([] (. program modules) (. callee module)))
    (match? ([] (. tree nodes) element)
      (case (call .node-markup row)
        (match? ([] (. owner decls) (. callee decl))
          (case (call .decl-function fn)
            (let position U32)
            (for (in written ([] (. tree children) (. row args)))
              (if (== written arg)
                (if (>= position (. fn args count))
                  (return null)
                )
                (return (. ([] (. owner arg-pool) (+ (. fn args start) position)) name))
              )
              (+= position 1)
            )
          )
        )
      )
    )
    (return null)
  )
  (fn-do _ interface-accessor (? Index)
    (param type TypeId)
    (param name Atom)
    (call (. types complete) type)
    (let base (call (. types base-of) type))
    (if base
      (let inherited (call interface-accessor base name))
      (return-if inherited (if inherited))
    )
    (for (in interface (call (. types interfaces-of) type))
      (let place (call property-named interface name))
      (return-if place (if (and place (== (. ([] (. types properties) place) storage-kind) .storage-getter))))
      (blank)
      (let deeper (call interface-accessor interface name))
      (return-if deeper (if deeper))
    )
    (return null)
  )
  (fn-do _ raise-statement _
    (param statement SyntaxId)
    ; Makes the object of each markup element a statement of a block declares a name for, where the
    ; statement runs, as the reference does: the locals the statements above declare are in reach
    ; of what makes it. One a read of its name above made first is not made again.
    (return-if (if (or (== (. unbuilt length) 0) (not (is ([] (. tree nodes) statement) .node-markup)))))
    (blank)
    (call raise-element statement statement)
  )
  (fn-do _ raise-line _
    (param line SyntaxId)
    ; Makes the object of each markup element a body written as one line declares a name for, as
    ; `raise-elements` does for the lines of a block.
    (let first (. unbuilt length))
    (call await-element line line)
    (if (== (. unbuilt length) first)
      (return)
    )
    (call raise-element line line)
    (while (> (. unbuilt length) first)
      (call (. unbuilt pop))
      (call (. awaited pop))
    )
  )
  (fn-do _ is-plain-body Bool
    (param body SyntaxId)
    (param rooted Bool (= false))
    (param ruled Bool (= false))
    ; Whether the body of a markup element is one whose every line has a shape here: a block in which
    ; nothing tracks what it reads, apart from statements run again when it changes, values given rules
    ; applied where no live action of the reference is open, which read what they track plainly, markup
    ; branch and loop regions, whose arms and rows are checked where they are built, lines that give
    ; slots content, checked where the functions that build them are, in a root `<This`, the values its
    ; lines give properties, and state machines the object keeps; a line that holds another state
    ; machine, but in a region or a loop, has none. In the class's `• This` (`ruled`), the lines that
    ; are the rule's own are no lines of it. What the conditions of the style rules an element applies
    ; read is read by the gates that test them.
    (if (== body 0)
      (return true)
    )
    (match? ([] (. tree nodes) body)
      (case (call .node-block block)
        (for (in statement ([] (. tree children) (. block body)))
          (if (or (call kept-machine statement) rule-line (call binds-slot statement))
            (continue)
          )
          (lazy rule-line (and ruled (call (. tree rule-part) statement)))
          (if (not (call is-plain-line statement body rooted))
            (return false)
          )
        )
        (return true)
      )
    )
    (return false)
  )
  (fn-do _ is-plain-line Bool
    (param line SyntaxId)
    (param body SyntaxId)
    (param rooted Bool)
    ; Whether a line of the body of a markup element has a shape here, as `is-plain-body` says.
    (let gated (list SyntaxId))
    (for (in node (.. (call (. tree subtree-start) line) line))
      (match? ([] (. tree nodes) node)
        (case (call .node-style-rule-application row)
          (if (!= (. row condition) 0)
            (+= gated (. row condition))
          )
        )
      )
    )
    (for (in node (.. (call (. tree subtree-start) line) line))
      (if (call (. tree in-gated) node gated)
        (continue)
      )
      (match? ([] (. tree nodes) node)
        (case (call .node-identifier row)
          (if (and (. row is-tracked) name-plain name-live)
            (return false)
          )
          (lazy name-plain
            (block
              (and (not (call in-live-statement node body)) (not (and rooted (call (. tree in-attribute) node body))))
            )
          )
          (lazy name-live (and (not (call in-region node body)) (!= (call live-context node) .live-none)))
        )
        (case (call .node-get-expression row)
          (if (and (. row is-tracked) get-plain get-live)
            (return false)
          )
          (lazy get-plain
            (block
              (and (not (call in-live-statement node body)) (not (and rooted (call (. tree in-attribute) node body))))
            )
          )
          (lazy get-live (and (not (call in-region node body)) (!= (call live-context node) .live-none)))
        )
        (case .node-state-machine
          (if (and (not (call in-region node body)) (not (call (. tree in-body-loop) node body)))
            (return false)
          )
        )
        (case .node-markup-read-expression
          (return false)
        )
      )
    )
    (return true)
  )
  (fn-do _ leaves-line Bool
    (param statement SyntaxId)
    ; Whether a line of a markup element's body leaves where it stands, which the reference
    ; reports as a return no element may hold: a return, under a condition or not, a raise
    ; under no condition, `continue`, `break`, or a `do` block whose last statement is one.
    (if (or (call is-leaving statement) (is ([] (. tree nodes) statement) .node-return-if-true))
      (return true)
    )
    (match? ([] (. tree nodes) statement)
      (case (call .node-do-block row)
        (return (call (. facts is-leaving) instance (. row body)))
      )
    )
    (return false)
  )
  (fn-expr _ is-markup-host Bool
    (param type TypeId)
    ; Whether objects of a type take their content through the markup protocol.
    (and (== (call (. types intrinsic-of) type) .class) host-named (!= (call derived-interface type host) no-type))
    (where
      (lazy host (. types markup-host-decl))
      (lazy host-named (or (!= (. host module) 0) (!= (. host decl) 0)))
    )
  )
  (fn-expr _ takes-lines Bool
    (param type TypeId)
    ; Whether an element's lines are linked to it by its own `+=` and `++=`: it is an object of
    ; a class that does not take content through the markup protocol, and neither the class nor
    ; one it derives from writes markup that holds the default slot, which would take the lines.
    (case? (!= (call (. types intrinsic-of) type) .class)
      false
    )
    (case? (and (or (!= (. host module) 0) (!= (. host decl) 0)) (!= (call derived-interface type host) no-type))
      false
    )
    (default
      (not (call holds-slot type))
    )
    (where
      (lazy host (. types markup-host-decl))
    )
  )
  (fn-expr _ takes-hosted Bool
    (param type TypeId)
    ; Whether an element's lines are linked to it through the markup protocol: it is an object of
    ; a markup host, and neither its class nor one it derives from writes markup that holds the
    ; default slot, which would take the lines.
    (and (call is-markup-host type) (not (call holds-slot type)))
  )
  (fn-do _ holds-slot Bool
    (param type TypeId)
    ; Whether a class or one it derives from writes markup that holds the default slot.
    (let level (? TypeId) type)
    (while level
      (let ref (call class-ref types level))
      (let owner ([] (. program modules) (. ref module)))
      (match? ([] (. owner decls) (. ref decl))
        (case (call .decl-class class)
          (if (!= (. class content) 0)
            (for (in node (..< (call (. owner tree subtree-start) (. class content)) (. class content)))
              (match? ([] (. owner tree nodes) node)
                (case (call .node-slot-outlet row)
                  (if (== (. row name) 0)
                    (return true)
                  )
                )
              )
            )
          )
        )
      )
      (= level (call (. types base-of) level))
    )
    (return false)
  )
  (fn-expr _ builds-slot Bool
    (param element SyntaxId)
    ; Whether this instance is the function that builds what a markup element, this one, gives a
    ; slot.
    (and (== (. frame declaration kind) .slot-decl) (== (. frame declaration syntax) element))
  )
  (fn-do _ binds-slot Bool
    (param statement SyntaxId)
    ; Whether a line is a markup element that gives a slot content, which a function of its own
    ; builds: one that binds a slot by name, or the one line of its body that gives the default slot
    ; content, element or value; or one that forwards a slot.
    (match? ([] (. tree nodes) statement)
      (case .node-markup
        (return (!= (call nested-decl-of statement) 0))
      )
      (case .node-markup-slot-forward
        (return true)
      )
    )
    (return-if true (if (call (. tree fills-only) statement)))
    (return (call wraps-default statement))
  )
  (fn-do _ check-slot _
    (param element SyntaxId)
    ; The function that builds what a markup element gives a slot: the element made with its
    ; content, as it would be anywhere, cast to the type of the slot, which the element that gives
    ; it the function settled (`supply-slots`), under the styles that element sees and the rules
    ; written in rules it gives with those found on the way to the slot's outlet, under the state
    ; cells this function keeps or reads (`take-scope`). Where the slot
    ; repeats, it is given the item, which the name the element writes for it holds. It answers
    ; that type, and lets out what making the element raises. An element whose name is a property
    ; of the class the markup is run on gives the property the object, once made. The body of an
    ; element whose lines all give the default slot content builds them into a node (`wrap`). It
    ; runs under the batch in force where the line is written, read from the local that keeps it.
    ; Where the rules the slot's outlet applies bring rules under the state cells of `when`s, this
    ; function brings them (`root-applications`) and checks the states on what it built.
    ; One a style rule generates is typed as `check-content` says.
    (if (!= (. ([] (. instances rows) instance) context) (. U32 max))
      (call check-content element)
      (return)
    )
    (call prepare)
    (let wanted (if-expr outer (. outer slot-wanted) no-type))
    (if (== wanted no-type)
      (call decline element)
      (call finish-errors frame)
      (call close)
      (return)
    )
    (call (. instances set-returns) instance wanted wanted .return-declared)
    (let rooted (if-expr outer (. outer slot-batch) false))
    (if rooted
      (+= (. facts region-roots) (call RegionRoot instance element (. (!! outer) slot-root) (call batch-type)))
    )
    (match? ([] (. tree nodes) element)
      (case (call .node-markup row)
        (if (!= (. row slot-parameter) 0)
          (let resolution (call (. bindings resolution-of) (. frame binding) (. row slot-parameter)))
          (let item (call (. instances argument-type) instance 0))
          (if (or (!= (. resolution kind) .resolve-slot) (== item no-type))
            (call decline element)
            (call finish-errors frame)
            (call close)
            (return)
          )
          (call (. frame assign) (. resolution slot) item)
        )
      )
    )
    (let styled (. markup-styles length))
    (for (in style (. (!! outer) slot-styles))
      (+= markup-styles style)
    )
    (for (in sheet (. (!! outer) slot-sheets))
      (+= markup-sheets sheet)
    )
    (for (in level (. (!! outer) slot-levels))
      (+= sheet-levels level)
    )
    (= sheets-given (. (!! outer) slot-sheets-known))
    (for (in use (. (!! outer) slot-scopes))
      (+= rule-scopes (call take-scope use))
    )
    (let applied (. (!! outer) slot-applying))
    (if (and (!= applied 0) (not (call root-applications (. (!! outer) slot-applying-module) applied wanted)))
      (call decline element)
      (call finish-errors frame)
      (call close)
      (return)
    )
    (= scopes-given (. (!! outer) slot-scopes-known))
    (= layer-given (call (. (!! outer) markup-layer)))
    (+= batched rooted)
    (let made (if-expr (is ([] (. tree nodes) element) .node-block) (call wrap element wanted) (call infer element)))
    (call (. batched pop))
    (if (and typed-made (!= applied 0) (not (call check-cells (- (. U32 max) 1) element made true)))
      (= made invalid-type)
    )
    (lazy typed-made (and (!= made invalid-type) (!= made no-type)))
    (if (and (!= made invalid-type) (!= made no-type))
      (call (. conversions convert) element element made wanted .reason-return)
      (match? ([] (. tree nodes) element)
        (case (call .node-markup row)
          (if (!= (. row id) 0)
            (let place (call named-place element (. row id) made))
            (if place
              (call (. facts note-named-store) (call NamedStore instance element place))
            )
          )
        )
      )
    )
    (while (> (. markup-styles length) styled)
      (call (. markup-styles pop))
    )
    (call finish-errors frame)
    (call close)
  )
  (fn-do _ wrap TypeId
    (param body SyntaxId)
    (param wanted TypeId)
    ; The node the lines of a markup element's body, all content of its class's default slot, are
    ; built into, as the reference's `markupSlotContentWrapper` builds it: an object of the slot's
    ; type made with no arguments, of which the lines are the content. A type that is no markup
    ; host, or a batch, is declined.
    (if (or (not (call is-markup-host wanted)) (call is-batch wanted))
      (call decline body)
      (return invalid-type)
    )
    (let shapes-start (. scratch call-arguments mark))
    (let types-start (. scratch types mark))
    (let syntax-start (. scratch syntax mark))
    (let arguments (call arguments-since shapes-start types-start syntax-start (. scratch no-types)))
    (let made (call (. calls construction-on) body wanted arguments))
    (if (or (== made invalid-type) (== made no-type))
      (return invalid-type)
    )
    (call (. facts set-node-type) instance body made)
    (+= content-blocks body)
    (+= content-parents made)
    (+= element-bodies body)
    (+= batched (call in-batch))
    (call check-statement body)
    (call (. batched pop))
    (call (. element-bodies pop))
    (call (. content-parents pop))
    (call (. content-blocks pop))
    (return made)
  )
  (fn-do _ check-binder _
    (param name SyntaxId)
    ; The function a markup element whose body gives slots content gives its constructor, which
    ; the constructor runs once its own body has, before the markup of the element's class: it
    ; gives the local the element's name declares its one argument, the object, in the function
    ; that declares the local, so that what the slots are given reads it, as the reference's
    ; binder does, and where the name is a property of the class the markup is run on, gives the
    ; property the object too. A name no block declares a local for gives only the property. A local
    ; reached through functions other than those that build slots has no shape here.
    (call prepare)
    (call (. instances set-returns) instance (. types void-type) (. types void-type) .return-declared)
    (let host (call (. instances argument-type) instance 0))
    (let slot (call declaring-slot name))
    (let reached
      (scope (if-expr slot (and outer (call (. frame is-captured) slot) (call (. outer places-across) slot)) member)
        (lazy member (call names-property name))
      )
    )
    (if (or (== host no-type) (not reached))
      (call decline name)
      (call finish-errors frame)
      (call close)
      (return)
    )
    (if slot
      (call assign-placed slot host)
    )
    (if (call names-property name)
      (let place (call named-place name name host))
      (if place
        (call (. facts note-named-store) (call NamedStore instance name place))
      )
    )
    (call finish-errors frame)
    (call close)
  )
  (fn-expr _ names-property Bool
    (param name SyntaxId)
    ; Whether the name of a markup element is that of a property of the class of the object the
    ; function is run on.
    (case? (or (== self no-type) (== self invalid-type) (!= (call (. types intrinsic-of) self) .class) (call lacks-self))
      false
    )
    (default
      (and (!= text null) (!= (call property-named self text) null))
    )
    (where
      (lazy self (. frame self-type))
      (lazy text (call (. tree identifier-name) name))
    )
  )
  (fn-do _ give-lines Bool
    (param lines (list SyntaxId))
    (param names (list Atom))
    (param wanted (list TypeId))
    (param items (list TypeId))
    (param styles (list TypeId))
    (param sheets (list TypeId))
    (param levels (list U32))
    (param given (list Atom))
    (param builders (list TypeId))
    (param class TypeId)
    (param scopes (list ScopeUse))
    (param scoped Bool)
    (param keeps-own Bool)
    ; Types the function of each line that gives a slot content, under `styles` and the style
    ; `sheets` in their groups, and where `scoped`, the rules written in rules `scopes` and those found
    ; on the way to the outlet of the slot of `class` it gives (`outlet-scopes`, the way to which
    ; `keeps-own` those that match in the markup being filled where it is of that markup), made the
    ; builder of the slot (`builder-type`), as `names`, `wanted` and `items` hold them, and adds the
    ; slot to those `given`, with its builder (`add-slot`). The function of a slot that repeats takes
    ; the item, by the name the line writes for it. A line of a slot given already is not built: what
    ; gave it wins. A name bound twice is the reference's error, as is one no outlet declares, a
    ; slot that repeats given content that names no item, or default content, a line naming an item
    ; for a slot that does not repeat, and one that writes the item's type. A line that forwards a
    ; slot passes on the builder of that name the markup it is written in was given
    ; (`forward-slot`). The content given a slot whose items can be bound again is checked as the
    ; reference checks it (`reads-rebindable`). The function of each line is built under the batch
    ; in force where the line is written (`keep-root`). Answers false where a line has no shape here
    ; or is wrong.
    (let defaulted (!= (call (. names find) (call (. program store-atom) "")) null))
    (let seen (list Atom))
    (for (in line lines)
      (if (call (. tree holds-fills) line)
        (if (not (call give-choices line names wanted items styles sheets levels given builders class scopes scoped keeps-own seen))
          (return false)
        )
        (continue)
      )
      (let binding SyntaxId 0)
      (let parameter SyntaxId 0)
      (let forwarding SyntaxId 0)
      (match? ([] (. tree nodes) line)
        (case (call .node-markup row)
          (= binding (. row slot-binding))
          (= parameter (. row slot-parameter))
        )
        (case (call .node-markup-slot-forward row)
          (= binding (. row slot-binding))
          (= forwarding (. row outlet))
        )
      )
      (let bound (call (. tree identifier-name) binding))
      (if (or (and (!= binding 0) (not bound)) (and (== binding 0) (not defaulted)))
        (call decline line)
        (return false)
      )
      (let name (if-expr (!= binding 0) (!! bound) (call (. program store-atom) "")))
      (if (!= (call (. seen find) name) null)
        (call (. frame diagnose) binding .stated (call (. program store-atom) "Duplicate slot content"))
        (return false)
      )
      (+= seen name)
      (let position (call (. names find) name))
      (if (== position null)
        (call (. frame diagnose) binding .stated (call (. program store-atom) "Unknown slot"))
        (return false)
      )
      (let item ([] items position))
      (if (and (!= item no-type) (== binding 0))
        (call (. frame diagnose)
          (block
            (arg line)
            (arg .stated)
            (arg (call (. program store-atom) "Repeated default slot content requires a slot binding"))
          )
        )
        (return false)
      )
      (match ([] (. tree nodes) parameter)
        (case (call .node-markup-slot-parameter written)
          (if (== item no-type)
            (call (. frame diagnose)
              (block
                (arg (. written name))
                (arg .stated)
                (arg (call (. program store-atom) "Slot parameter requires a repeated slot"))
              )
            )
            (return false)
          )
          (if (!= (. written type-id) 0)
            (call (. frame diagnose)
              (block
                (arg (. written type-id))
                (arg .stated)
                (arg (call (. program store-atom) "Slot content parameter type belongs on the slot outlet"))
              )
            )
            (return false)
          )
        )
        (default
          (if (and (!= item no-type) (== forwarding 0))
            (call (. frame diagnose)
              (block
                (arg binding)
                (arg .stated)
                (arg (call (. program store-atom) "Repeated slot content requires a slot parameter"))
              )
            )
            (return false)
          )
        )
      )
      (let root (if-expr (== forwarding 0) (call keep-root line) no-slot))
      (let held (call (. given find) name))
      (if (and held keeps-own (!= (call chosen-slot ([] builders held)) no-type))
        (let message
          (paragraph
            (str "Slot \"" (. name text) "\" is filled inside an if or match where this object is made, so the class's content does not fill it too")
          )
        )
        (call (. frame diagnose) line .stated (call (. program store-atom) message))
        (return false)
      )
      (if (!= held null)
        (continue)
      )
      (if (and (!= item no-type) (== forwarding 0) (call rebinds item) (not (call reads-rebindable line parameter)))
        (return false)
      )
      (let content ([] wanted position))
      (let builder (call builder-type content item))
      (if (!= forwarding 0)
        (if (call forwards-nothing name)
          (continue)
        )
        (if (call forwards-choice name)
          (call (. frame diagnose)
            (block
              (arg line)
              (arg .stated)
              (arg
                (call (. program store-atom)
                  (block
                    (arg
                      (paragraph
                        "A slot filled inside an if or match is not passed on with <+; give it content here instead"
                      )
                    )
                  )
                )
              )
            )
          )
          (return false)
        )
        (if (or (== builder invalid-type) (not (call forward-slot line forwarding name builder)))
          (call decline line)
          (return false)
        )
        (let kept (. facts outlet-cells length))
        (if (not (call hold-cells line scopes))
          (return false)
        )
        (if (!= (. facts outlet-cells length) kept)
          (+= (. facts slot-forwards) (call SlotForward instance line builder item))
        )
        (call add-slot name builder given builders)
        (continue)
      )
      (= slot-scopes-known scoped)
      (if scoped
        (let seen (list ScopeUse))
        (for (in use scopes)
          (+= seen use)
        )
        (let found (list ScopeUse))
        (let status (call outlet-scopes class name content true seen sheets levels found keeps-own))
        (if (== status 2)
          (= slot-scopes-known false)
          (call decline line)
          (return false)
        )
        (if (== status 3)
          (let (tuple owner outlet) (call slot-outlet class name))
          (= slot-applying outlet)
          (= slot-applying-module (. (call class-ref types owner) module))
        )
        (for (in use scopes)
          (+= slot-scopes use)
        )
        (for (in use found)
          (+= slot-scopes use)
        )
      )
      (let decl (call nested-decl-of line))
      (if (or (== builder invalid-type) (== decl 0))
        (call decline line)
        (return false)
      )
      (= slot-wanted content)
      (= slot-root root)
      (= slot-batch (and (!= root no-slot) (call in-batch)))
      (for (in style styles)
        (+= slot-styles style)
      )
      (for (in sheet sheets)
        (+= slot-sheets sheet)
      )
      (for (in level levels)
        (+= slot-levels level)
      )
      (= slot-sheets-known (call sheets-known))
      (let callee (call demand-nested decl item))
      (= slot-wanted no-type)
      (= slot-root no-slot)
      (= slot-batch false)
      (call (. slot-styles clear))
      (call (. slot-sheets clear))
      (call (. slot-levels clear))
      (= slot-sheets-known false)
      (call (. slot-scopes clear))
      (= slot-scopes-known false)
      (= slot-applying 0)
      (if (== callee no-instance)
        (call decline line)
        (return false)
      )
      (let closure (call intern-nested decl))
      (call (. facts set-node-type) instance line closure)
      (if (== (call (. conversions convert) line line closure builder .reason-markup-slot) invalid-type)
        (return false)
      )
      (call add-slot name builder given builders)
    )
    (return true)
  )
  (fn-do _ keep-root SlotId
    (param line SyntaxId)
    ; The local no name reaches that keeps the batch of markup in force where a line that gives a
    ; slot content is written, which the function that builds the content captures: given the
    ; batch's type, which the line keeps there as it makes the function, or none where no batch is
    ; in force, as the reference captures the batch it finds.
    (let decl (call nested-decl-of line))
    (let root (if-expr (!= decl 0) (call captured-root decl line) no-slot))
    (if (== root no-slot)
      (return no-slot)
    )
    (let rooted (call in-batch))
    (call (. frame assign) root (if-expr rooted (call batch-type) (. types void-type)))
    (if rooted
      (+= (. facts region-roots) (call RegionRoot instance line root (call batch-type)))
    )
    (return root)
  )
  (fn-do _ captured-root SlotId
    (param decl DeclId)
    (param line SyntaxId)
    ; The local declared at a line that gives a slot content that the function the line declares
    ; captures, which keeps the batch in force there.
    (let row ([] (. bindings bindings) (. frame binding)))
    (for (in offset (..< 0 (. row nested count)))
      (let nested ([] (. bindings nested) (+ (. row nested start) offset)))
      (if (== (. nested decl) decl)
        (for (in index (..< 0 (. nested captures count)))
          (let slot (. ([] (. bindings captures) (+ (. nested captures start) index)) slot))
          (if (and (== (. ([] (. bindings slots) slot) syntax) line) (== (. ([] (. bindings slots) slot) kind) .slot-local))
            (return slot)
          )
        )
        (return no-slot)
      )
    )
    (return no-slot)
  )
  (fn-do _ forward-slot Bool
    (param line SyntaxId)
    (param outlet SyntaxId)
    (param name Atom)
    (param builder TypeId)
    ; A line that forwards a slot passes on, as the builder of the slot of its name, the one the
    ; function that fills an object with the markup it is written in was given for that name, which
    ; a function written in that one reaches through the local that holds it, as the reference
    ; passes it on unwrapped. The forward's outlet keeps where it is read from. Where that function
    ; was given one of another type, it is declined. One given none gives nothing (`forwards-nothing`).
    (let filling (call filling-checker))
    (if (not filling)
      (return false)
    )
    (let argument (call (. instances slot-argument) (. filling instance) name))
    (if (or (== argument (. U32 max)) (!= (call (. instances argument-type) (. filling instance) argument) builder))
      (return false)
    )
    (let held no-slot)
    (if (not (. frame declaration is-content))
      (= held (call builder-slot name))
      (if (== held no-slot)
        (return false)
      )
      (= argument (. U32 max))
    )
    (+= (. facts slot-outlets) (call SlotOutlet instance outlet argument 0 no-type held 0))
    (return true)
  )
  (fn-expr _ forwards-nothing Bool
    (param name Atom)
    ; Whether a line that forwards the slot of a name gives nothing, as the function that fills an
    ; object with the markup it is written in was given no builder for that name.
    (and (!= filling null) (== (call (. instances slot-argument) (. filling instance) name) (. U32 max)))
    (where
      (lazy filling (call filling-checker))
    )
  )
  (fn-do _ builder-type TypeId
    (param content TypeId)
    (param item TypeId)
    ; The type of the function that builds a slot of a content type: a `MarkupSlotBuilder`, or the
    ; `MarkupRowBuilder` that takes the item where the slot repeats.
    (if (== item no-type)
      (return (call (. types well-known-type-of) "core/markup" "MarkupSlotBuilder" content))
    )
    (return (call (. types well-known-type-of) "core/markup" "MarkupRowBuilder" item content))
  )
  (fn-expr _ rebinds Bool
    (param item TypeId)
    ; Whether the items of a slot that repeats are ones a row can be bound to again, whose content
    ; the reference checks for reads that would outlive the binding.
    (case? (== scope invalid-type)
      false
    )
    (default
      (!= (call derived-interface item (call class-ref types scope)) no-type)
    )
    (where
      (lazy scope (call (. types well-known-type) "core/markup" "MarkupRebindableScope"))
    )
  )
  (fn-do _ reads-rebindable Bool
    (param line SyntaxId)
    (param parameter SyntaxId)
    ; Checks the reads of the item a line gives a slot whose items can be bound again, by the name
    ; the line writes for it, as the reference checks them: outside a function or a `do` block, each
    ; read of a member of it must be tracked, and no local declared there with a value that reads
    ; it may be read in a function the line writes, by the names in reach as the reference finds
    ; them (`escaping-local`). Both are the reference's errors, the first at the member read, after
    ; the item's name. Answers false where one is reported.
    (let scope (? Atom) null)
    (match? ([] (. tree nodes) parameter)
      (case (call .node-markup-slot-parameter written)
        (= scope (call (. tree identifier-name) (. written name)))
      )
    )
    (if (not scope)
      (call decline line)
      (return false)
    )
    (let read (call untracked-read line scope))
    (if (!= read 0)
      (match? ([] (. tree nodes) read)
        (case (call .node-get-expression row)
          (let message
            (paragraph
              (str "Rebindable slot scope reads must be tracked as " (. scope text) ".#" (. row name text) "; use an explicit snapshot inside do for a stable value")
            )
          )
          (let object ([] (. tree nodes loc) (. row object)))
          (call (. frame diagnose) (. row object) .stated (call (. program store-atom) message))
          (call (. facts inset-diagnostic)
            (block
              (arg (- (+ (. object end column) 1) (. object begin column)))
              (arg (as (+ (. row name text length) 1) U32))
            )
          )
        )
      )
      (return false)
    )
    (let derived (list SyntaxId))
    (call derive-locals line scope derived)
    (if (== (. derived length) 0)
      (return true)
    )
    (let names (list Atom))
    (let held (list Bool))
    (let escaping (call escaping-local line derived names held false))
    (if (!= escaping 0)
      (let name (call (. tree identifier-name) escaping))
      (let message
        (paragraph
          (str "Local " (. (!! name) text) " derived from rebindable slot scope " (. scope text) " cannot escape into a closure; read " (. scope text) " directly in the closure or take an explicit snapshot inside do")
        )
      )
      (call (. frame diagnose) escaping .stated (call (. program store-atom) message))
      (return false)
    )
    (return true)
  )
  (fn-do _ derive-locals _
    (param id SyntaxId)
    (param scope Atom)
    (param derived (list SyntaxId))
    ; Adds each `.` written outside a function or a `do` block whose value reads a name there.
    (match? ([] (. tree nodes) id)
      (case .node-function-syntax
        (return)
      )
      (case .node-do-block
        (return)
      )
      (case (call .node-declare row)
        (if (and (not (. row is-lazy)) (!= (. row right) 0) (call reads-name (. row right) scope))
          (+= derived id)
        )
      )
    )
    (for (in child (call (. tree children-of) id))
      (call derive-locals child scope derived)
    )
  )
  (fn-do _ reads-name Bool
    (param id SyntaxId)
    (param scope Atom)
    ; Whether a name is read outside a function or a `do` block.
    (match? ([] (. tree nodes) id)
      (case .node-function-syntax
        (return false)
      )
      (case .node-do-block
        (return false)
      )
      (case (call .node-identifier row)
        (return (== (. row name) scope))
      )
    )
    (for (in child (call (. tree children-of) id))
      (if (call reads-name child scope)
        (return true)
      )
    )
    (return false)
  )
  (fn-do _ escaping-local SyntaxId
    (param id SyntaxId)
    (param derived (list SyntaxId))
    (param names (list Atom))
    (param held (list Bool))
    (param closed Bool)
    ; The first name read in a function, in the order written, that reaches a local one of the
    ; `derived` declarations declares, by the names in reach as the reference finds them, apart
    ; from what binds them: the names each declaration of a block around it declares, a lazy one's
    ; from the block's start and another's from after its value, which `held` marks where the
    ; declaration is derived, and the arguments of each function around it. None where there is
    ; none.
    (match? ([] (. tree nodes) id)
      (case (call .node-function-syntax row)
        (if (== (. row body) 0)
          (return 0)
        )
        (let mark (. names length))
        (for (in arg ([] (. tree children) (. row args)))
          (match? ([] (. tree nodes) arg)
            (case (call .node-argument-decl shape)
              (call bind-names (. shape pattern) false names held)
            )
          )
        )
        (let found (call escaping-local (. row body) derived names held true))
        (call unbind-names mark names held)
        (return found)
      )
      (case (call .node-block row)
        (let mark (. names length))
        (for (in statement ([] (. tree children) (. row body)))
          (match? ([] (. tree nodes) statement)
            (case (call .node-declare declare)
              (if (. declare is-lazy)
                (call bind-names (. declare left) (!= (call (. derived find) statement) null) names held)
              )
            )
          )
        )
        (for (in statement ([] (. tree children) (. row body)))
          (let found (call escaping-local statement derived names held closed))
          (if (!= found 0)
            (call unbind-names mark names held)
            (return found)
          )
        )
        (call unbind-names mark names held)
        (return 0)
      )
      (case (call .node-declare row)
        (if (. row is-lazy)
          (call bind-names (. row left) (!= (call (. derived find) id) null) names held)
        )
        (if (!= (. row right) 0)
          (let found (call escaping-local (. row right) derived names held closed))
          (if (!= found 0)
            (return found)
          )
        )
        (if (not (. row is-lazy))
          (call bind-names (. row left) (!= (call (. derived find) id) null) names held)
        )
        (return 0)
      )
      (case (call .node-identifier row)
        (if closed
          (let place (. names length))
          (while (> place 0)
            (-= place 1)
            (if (== ([] names place) (. row name))
              (if ([] held place)
                (return id)
              )
              (return 0)
            )
          )
        )
        (return 0)
      )
    )
    (for (in child (call (. tree children-of) id))
      (let found (call escaping-local child derived names held closed))
      (if (!= found 0)
        (return found)
      )
    )
    (return 0)
  )
  (fn-do _ bind-names _
    (param pattern SyntaxId)
    (param derived Bool)
    (param names (list Atom))
    (param held (list Bool))
    ; Puts in reach each name a pattern declares, marked `derived` or not.
    (match? ([] (. tree nodes) pattern)
      (case (call .node-identifier row)
        (+= names (. row name))
        (+= held derived)
        (return)
      )
    )
    (for (in child (call (. tree children-of) pattern))
      (call bind-names child derived names held)
    )
  )
  (fn-do _ wraps-default Bool
    (param body SyntaxId)
    ; Whether the body of a markup element is built by a function of its own into a node of its
    ; class's default slot type, every line of it content of that slot, or the one line that gives
    ; that content is built by one as a value of that type.
    (if (== body 0)
      (return false)
    )
    (let decl (call nested-decl-of body))
    (if (== decl 0)
      (return false)
    )
    (match? ([] (. ([] (. program modules) module) decls) decl)
      (case (call .decl-function fn)
        (return (== (. fn kind) .slot-decl))
      )
    )
    (return false)
  )
  (fn-do _ gives-default Bool
    (param body SyntaxId)
    (param ruled Bool (= false))
    ; Whether a line of an element's body gives the default slot content that no function of its
    ; own builds: a line that neither assigns nor gives a slot content, nor is the rule's own in
    ; the body of a class's `• This` (`ruled`), where the body is not built by one.
    (if (call wraps-default body)
      (return false)
    )
    (match? ([] (. tree nodes) body)
      (case (call .node-block block)
        (for (in statement ([] (. tree children) (. block body)))
          (if (and (not assigning) (not (call binds-slot statement)) (not (and ruled (call (. tree rule-part) statement))))
            (return true)
          )
          (lazy assigning (is ([] (. tree nodes) statement) .node-assign))
        )
      )
    )
    (return false)
  )
  (fn-do _ filling-checker (? Checker)
    ; The checker of the function that fills an object with the markup written in its class that
    ; this function is, or is written in; none where it is neither.
    (let level (? Checker) this)
    (while level
      (if (. level frame declaration is-content)
        (return level)
      )
      (= level (. level outer))
    )
    (return null)
  )
  (fn-do _ builder-slot SlotId
    (param name Atom)
    ; The local that holds the function that builds the slot of a name, which the function that
    ; fills an object with the markup of its class was given, where a function written in that one
    ; reaches it.
    (let range (. ([] (. bindings bindings) (. frame binding)) slots))
    (for (in offset (..< 0 (. range count)))
      (let slot (+ (. range start) offset))
      (if (and (== (. ([] (. bindings slots) slot) kind) .slot-builder) (== (. ([] (. bindings slots) slot) name) name))
        (return slot)
      )
    )
    (return no-slot)
  )
  (fn-do _ hold-builders Bool
    (param receiver TypeId)
    (param site SyntaxId)
    ; Types the local that holds the function that builds each slot a function written in this one
    ; reaches through it, as the builder of the slot the class's markup declares, given or not.
    ; Answers false where the slots have no shape here or are wrong.
    (let range (. ([] (. bindings bindings) (. frame binding)) slots))
    (let names (list Atom))
    (let wanted (list TypeId))
    (let items (list TypeId))
    (let read false)
    (for (in offset (..< 0 (. range count)))
      (let slot (+ (. range start) offset))
      (if (!= (. ([] (. bindings slots) slot) kind) .slot-builder)
        (continue)
      )
      (if (not read)
        (= read true)
        (let reported (. facts diagnostics length))
        (if (not (call class-outlets receiver names wanted items))
          (if (== (. facts diagnostics length) reported)
            (call decline site)
          )
          (return false)
        )
      )
      (let position (call (. names find) (. ([] (. bindings slots) slot) name)))
      (if (== position null)
        (call decline site)
        (return false)
      )
      (let builder (call builder-type ([] wanted position) ([] items position)))
      (let argument (call (. instances slot-argument) instance (. ([] (. bindings slots) slot) name)))
      (if (and (!= argument (. U32 max)) (!= (call chosen-slot (call (. instances argument-type) instance argument)) no-type))
        (= builder (call (. instances argument-type) instance argument))
      )
      (if (== builder invalid-type)
        (call decline site)
        (return false)
      )
      (call (. frame assign) slot builder)
    )
    (return true)
  )
  (fn-expr _ reads-getter Bool
    (param id SyntaxId)
    ; Whether a name reads a local of a row of a markup loop region that the reference reads as a
    ; getter.
    (and (== (. resolution kind) .resolve-slot) (!= (. ([] (. bindings slots) (. resolution slot)) getter) 0))
    (where
      (lazy resolution (call (. bindings resolution-of) (. frame binding) id))
    )
  )
  (fn-do _ check-line TypeId
    (param statement SyntaxId)
    (param parent TypeId)
    (param want Want (= (call Want)))
    ; A line of a block: one of markup content that is a markup branch region, a slot outlet that
    ; is one (`outlet-region`), or a markup loop region makes the region, which is the line's value,
    ; one that is a loop written with `in` and no function of its own runs its body as content as a
    ; `for` does, and any other is checked as a statement.
    (if (and (!= parent no-type) (call is-region statement))
      (return (call check-branch statement parent))
    )
    (if (and (!= parent no-type) (!= (call outlet-choice statement) no-type))
      (return (call check-chosen-outlet statement parent (call outlet-choice statement)))
    )
    (if (and (!= parent no-type) (call (. tree builds-outlet-alone) statement))
      (return (call check-outlet-arm statement parent))
    )
    (if (and (!= parent no-type) (!= (call outlet-region statement) 0))
      (return (call check-branch (call outlet-region statement) parent))
    )
    (if (and (!= parent no-type) (call is-loop-region statement))
      (return (call check-loop-region statement parent))
    )
    (if (and (!= parent no-type) (== (call nested-decl-of statement) 0))
      (match? ([] (. tree nodes) statement)
        (case (call .node-iterator-expression row)
          (call (. facts set-plan) instance statement .plan-content-loop)
          (call check-for statement (. row loop) (. row body) (. row next))
          (call (. frame forget-members))
          (return no-type)
        )
      )
    )
    (return (call check-statement statement want))
  )
  (fn-do _ chosen-slot TypeId
    (param builder TypeId)
    (match? ([] (. types rows) builder)
      (case (call .type-class row)
        (if (== (. row args count) 1)
          (let slot (call (. types child-type) (. row args) 0))
          (if (== (call (. types well-known-type-of) "core/markup" "MarkupSlotChoice" slot) builder)
            (return slot)
          )
        )
      )
    )
    (return no-type)
  )
  (fn-do _ is-region Bool
    (param id SyntaxId)
    ; Whether an `if` or a `match` is a markup branch region, whose arm a function of its own
    ; selects again.
    (let decl (call nested-decl-of id))
    (if (== decl 0)
      (return false)
    )
    (match? ([] (. ([] (. program modules) module) decls) decl)
      (case (call .decl-function fn)
        (return (== (. fn kind) .branch-decl))
      )
    )
    (return false)
  )
  (fn-do _ is-selector Bool
    (param id SyntaxId)
    (let decl (call nested-decl-of id))
    (if (== decl 0)
      (return false)
    )
    (match? ([] (. ([] (. program modules) module) decls) decl)
      (case (call .decl-function fn)
        (return (== (. fn kind) .selector-decl))
      )
    )
    (return false)
  )
  (fn-do _ is-loop-region Bool
    (param id SyntaxId)
    ; Whether a `for` is a markup loop region, whose container a function of its own reads again.
    (let decl (call nested-decl-of id))
    (if (== decl 0)
      (return false)
    )
    (match? ([] (. ([] (. program modules) module) decls) decl)
      (case (call .decl-function fn)
        (return (== (. fn kind) .source-decl))
      )
    )
    (return false)
  )
  (fn-expr _ region-head SyntaxId
    (param arm SyntaxId)
    ; The `if` of the markup branch region an arm is one of, or none: a later arm resolves to the
    ; local that keeps the region's host, which the `if` declares.
    (case? (call is-region arm)
      arm
    )
    (case? (!= (. resolution kind) .resolve-slot)
      0
    )
    (case? (and (!= head arm) (< head (. tree nodes length)) (is ([] (. tree nodes) head) .node-if-block) (call is-region head))
      head
    )
    (default
      0
    )
    (where
      (lazy resolution (call (. bindings resolution-of) (. frame binding) arm))
      (lazy head (. ([] (. bindings slots) (. resolution slot)) syntax))
    )
  )
  (fn-do _ in-region Bool
    (param node SyntaxId)
    (param body SyntaxId)
    ; Whether a node is written in a markup branch, match or loop region within a body: in one of
    ; its conditions, its subject, its patterns or its container, which the region reads in a live
    ; action of its own, or in an arm or the body of its loop, which a function of its own builds;
    ; or in a slot outlet that is such a region.
    (for (in around (..< (+ node 1) body))
      (if (and (<= (call (. tree subtree-start) around) node) (!= (call outlet-region around) 0))
        (return true)
      )
      (if (and (<= (call (. tree subtree-start) around) node) if-region)
        (return true)
      )
      (lazy if-region (and (is ([] (. tree nodes) around) .node-if-block) (!= (call region-head around) 0)))
      (if (and (<= (call (. tree subtree-start) around) node) match-region)
        (return true)
      )
      (lazy match-region (and (is ([] (. tree nodes) around) .node-match-expression) (call is-region around)))
      (if (and (<= (call (. tree subtree-start) around) node) loop-region)
        (return true)
      )
      (lazy loop-region (and (is ([] (. tree nodes) around) .node-for-block) (call is-loop-region around)))
      (if (and (<= (call (. tree subtree-start) around) node) (call is-selector around))
        (return true)
      )
    )
    (return false)
  )
  (fn-do _ check-branch TypeId
    (param id SyntaxId)
    (param parent TypeId)
    ; A markup branch region, as the reference compiles one:
    ; the host the `if` is content of must be a `MarkupElement`, whose `MarkupParent`
    ; gives the type of its content. Each arm is built by a function of its own given the
    ; region, made a `MarkupBranchBuilder` at the arm, and the builders are made a list at the
    ; `if`. The conditions are read in a live action of the region's own, and the index of the
    ; arm whose condition holds is what the markup runtime's `markup-create-branch-region` makes
    ; the region with; the region is the line's value, which the host takes. The host and the
    ; region are kept, in the two locals no name reaches declared at the `if`, for the function
    ; that selects the arm again, which the action runs: made by `make-owner-markup-action`,
    ; owned by the host and marked structural. Where a batch is found for the host, as
    ; `region-batch-of` says, the region is put under it by `ensure-markup-root` once made, and the
    ; action is made with it by `make-markup-action`. The batch in force where the region is
    ; written is kept in a third such local, which the arms are built under. A region whose
    ; content is no class or is a batch is declined, and one whose host makes no branch region, as
    ; `makes-region` says, is an error at the `if`. A region of a class with events, which the
    ; markup runtime makes, is kept as any other: the reference closes only its live actions. A
    ; match region selects the first arm whose pattern its subject matches (`read-patterns`), and
    ; its function selects again whatever arm the region holds, asking nothing of the region first,
    ; as the reference's `markupMatchBranch` does, and so does that of a slot outlet that is a region,
    ; written at its parameter, whose one arm is the outlet.
    (if (not (call is-markup-host parent))
      (call (. frame diagnose)
        (block
          (arg id)
          (arg .stated)
          (arg (call (. program store-atom) "Dynamic markup branch parent must implement MarkupElement"))
        )
      )
      (return invalid-type)
    )
    (let tree-host (call derived-interface parent (. types markup-tree-host-decl)))
    (let content (if-expr (!= tree-host no-type) (call first-arg tree-host) no-type))
    (if (or (== content no-type) (== content invalid-type))
      (call (. frame diagnose)
        (block
          (arg id)
          (arg .stated)
          (arg (call (. program store-atom) "Dynamic markup branch host content type could not be resolved"))
        )
      )
      (return invalid-type)
    )
    (let resolution (call (. bindings resolution-of) (. frame binding) id))
    (if (or (!= (call (. types intrinsic-of) content) .class) (!= (. resolution kind) .resolve-slot) (call is-batch content))
      (call decline id)
      (return invalid-type)
    )
    (if (not (call makes-region parent))
      (call (. frame diagnose) id .stated (call (. program store-atom) message))
      (lazy message
        (paragraph
          (str "Markup branch host " (call type-source types parent) " must declare markup-make-region, or extend MarkupNode")
        )
      )
      (return invalid-type)
    )
    (let builder (call (. types well-known-type-of) "core/markup" "MarkupBranchBuilder" content))
    (let list (call (. types well-known-type-of) "core/list" "List" builder))
    (if (or (== builder invalid-type) (== list invalid-type))
      (call decline id)
      (return invalid-type)
    )
    (let rooted (call in-batch))
    (let hosted (call is-batch parent))
    (let outer-batch region)
    (= region (= (. region batch) rooted))
    (= region (= (. region root) (+ (. resolution slot) 2)))
    (call (. frame assign) (. resolution slot) parent)
    (for (in arm (call (. tree region-arms) id))
      (let body (call (. tree region-arm-body) arm))
      (let decl (call nested-decl-of body))
      (if (or (== decl 0) (== (call demand-nested decl content) no-instance))
        (= region outer-batch)
        (call decline arm)
        (return invalid-type)
      )
      (let closure (call intern-nested decl))
      (call (. facts set-node-type) instance body closure)
      (if (== (call (. conversions convert) arm arm closure builder .reason-markup-arm) invalid-type)
        (= region outer-batch)
        (return invalid-type)
      )
    )
    (= region outer-batch)
    (call (. calls note-list) id list)
    (call read-arms id)
    (call demand-live-runtime)
    (let live (. instances live))
    (let host (call derived-interface parent (. types markup-host-decl)))
    (let selected (call (. types optional-of) (. types index-type)))
    (let markup (. types markup-host-decl module))
    (let mark (. scratch types mark))
    (call (. scratch types push) content)
    (call (. scratch types push) parent)
    (call (. scratch types push) parent)
    (call (. scratch types push) list)
    (call (. scratch types push) selected)
    (let create
      (call (. calls demand-runtime-call)
        (block
          (arg markup)
          (arg no-type)
          (arg (call (. program store-atom) "markup-create-branch-region"))
          (arg mark)
          (arg 2)
        )
      )
    )
    (call (. scratch types rewind) mark)
    (call (. scratch types push) content)
    (call (. scratch types push) content)
    (call (. scratch types push) selected)
    (let matched
      (scope (or (is ([] (. tree nodes) id) .node-match-expression) slot-parameter)
        (lazy slot-parameter (is ([] (. tree nodes) id) .node-markup-slot-parameter))
      )
    )
    (let keeps
      (block
        (case? matched
          no-instance
        )
        (default
          (call (. calls demand-runtime-call)
            (block
              (arg markup)
              (arg no-type)
              (arg (call (. program store-atom) "markup-branch-region-keeps-arm"))
              (arg mark)
              (arg 1)
            )
          )
        )
      )
    )
    (let select
      (call (. calls demand-runtime-call)
        (block
          (arg markup)
          (arg no-type)
          (arg (call (. program store-atom) "markup-select-branch-region"))
          (arg mark)
          (arg 1)
        )
      )
    )
    (call (. scratch types rewind) mark)
    (let batched (or rooted hosted))
    (let trackers
      (scope (if-expr (!= (. live trackers) no-instance) trackers-type no-type)
        (lazy trackers-type (. ([] (. instances signatures) (. live trackers)) returns))
      )
    )
    (call (. scratch types push) trackers)
    (call (. scratch types push) (. live callback))
    (call (. scratch types push) (if-expr batched (call batch-type) host))
    (let action
      (call (. calls demand-runtime-call)
        (block
          (arg markup)
          (arg no-type)
          (arg (call (. program store-atom) (if-expr batched "make-markup-action" "make-owner-markup-action")))
          (arg mark)
        )
      )
    )
    (call (. scratch types rewind) mark)
    (let structural (call mark-structural id parent))
    (if (or (== create no-instance) (and (== keeps no-instance) (not matched)) uncalled)
      (call decline id)
      (return invalid-type)
    )
    (lazy uncalled (or (== select no-instance) (== action no-instance) (== structural no-instance)))
    (let made (. ([] (. instances signatures) create) returns))
    (if (or (!= (call (. types intrinsic-of) made) .class) other-return)
      (call decline id)
      (return invalid-type)
    )
    (lazy other-return (!= (. ([] (. instances signatures) action) returns) (. types live-action-type)))
    (if (or (and (not matched) (!= (. ([] (. instances signatures) keeps) returns) (. types bool-type))) actionless)
      (call decline id)
      (return invalid-type)
    )
    (lazy actionless (== (. instances live has-actions) no-instance))
    (if (or (not (call raises-out id create)) (not (call raises-out id action)) (not (call raises-out id structural)))
      (call decline id)
      (return invalid-type)
    )
    (if hosted
      (call (. conversions convert) id id parent (call batch-type) .reason-markup-batch)
    )
    (let ensure (call region-ensure id made batched .reason-markup-region))
    (if (not ensure)
      (return invalid-type)
    )
    (if (or (not batched) (call is-markup-host parent))
      (call (. conversions convert) id id parent host .reason-markup-host)
    )
    (call (. frame assign) (. resolution slot) parent)
    (call (. frame assign) (+ (. resolution slot) 1) made)
    (call (. frame assign) (+ (. resolution slot) 2) (if-expr rooted (call batch-type) (. types void-type)))
    (let outer-content region)
    (= region (= (. region content) content))
    (= region (= (. region keeps) keeps))
    (= region (= (. region select) select))
    (let updater (call demand-lambda (call intern-nested (call nested-decl-of id)) (. scratch no-types)))
    (= region outer-content)
    (if (or (== updater no-instance) (and updater-raises (== (. live callback-result) no-type)))
      (call decline id)
      (return invalid-type)
    )
    (lazy updater-raises (!= (. ([] (. instances signatures) updater) errors count) 0))
    (call (. instances mark-may-panic) instance)
    (+= (. facts branch-regions)
      (call BranchRegion
        (block
          (arg instance)
          (arg id)
          (arg parent)
          (arg content)
          (arg list)
          (arg selected)
          (arg create)
          (arg updater)
          (arg action)
          (arg structural)
          (arg keeps)
          (arg select)
          (arg ensure)
          (arg hosted)
          (arg rooted)
        )
      )
    )
    (return made)
  )
  (fn-do _ mark-structural InstanceId
    (param id SyntaxId)
    (param owner TypeId)
    ; The call that marks the action of a markup region structural, given the host that owns the
    ; action as the reference's `markupLiveAction` does: the parent of a branch or the region of a
    ; loop, where that is a markup host, so a batch runs the actions of outer regions before those
    ; of inner ones. The host, converted at the `if` or `for` to the `MarkupElement` it is, is converted
    ; there again to the optional the call takes. Where the owner is no markup host the call is
    ; given none.
    (let host (call (. types well-known-type) "core/markup" "MarkupElement"))
    (let optional (call (. types optional-of) host))
    (let mark (. scratch types mark))
    (call (. scratch types push) (. types live-action-type))
    (call (. scratch types push) optional)
    (let structural
      (call (. calls demand-runtime-call)
        (block
          (arg (. types markup-host-decl module))
          (arg no-type)
          (arg (call (. program store-atom) "mark-structural-markup-action"))
          (arg mark)
        )
      )
    )
    (call (. scratch types rewind) mark)
    (if (and (!= structural no-instance) (call is-markup-host owner))
      (call (. conversions convert) id id host optional .reason-markup-structural)
    )
    (return structural)
  )
  (fn-do _ arm-root Bool
    (param body SyntaxId)
    (param content TypeId)
    (param slot SlotId)
    ; The batch in force where a markup branch region is written, which the function that builds
    ; an arm is built under: read from the local that keeps it, and the region the arm is given
    ; put under it by `ensure-markup-root` first, where it is a markup host, as the reference's
    ; builder and then its `compileContents` each do. False, once declined, where that has no
    ; shape here.
    (let ensure no-instance)
    (if (call is-markup-host content)
      (let host (call derived-interface content (. types markup-host-decl)))
      (let optional (call (. types optional-of) (call batch-type)))
      (let mark (. scratch types mark))
      (call (. scratch types push) host)
      (call (. scratch types push) optional)
      (= ensure
        (call (. calls demand-runtime-call)
          (block
            (arg (. types markup-host-decl module))
            (arg no-type)
            (arg (call (. program store-atom) "ensure-markup-root"))
            (arg mark)
          )
        )
      )
      (call (. scratch types rewind) mark)
      (if (or (== ensure no-instance) (not (call raises-out body ensure)))
        (call decline body)
        (return false)
      )
      (call (. conversions convert) body body content host .reason-markup-host)
      (call (. conversions convert) body body (call batch-type) optional .reason-markup-root)
    )
    (+= (. facts region-roots) (call RegionRoot instance body slot (call batch-type) ensure))
    (return true)
  )
  (fn-do _ read-arms _
    (param id SyntaxId)
    ; The conditions of a markup branch region read in turn, each tested as the condition of an
    ; `if` is, until one holds, and the subject of an arm written with a pattern, against which the
    ; pattern is tested (`test-pattern`); or the subject of a match region, against which each
    ; arm's pattern is tested in turn (`read-patterns`); or the name the parameter of a slot outlet
    ; that is a region gives, which must read the row's item as a getter, as the reference's
    ; `markupSlotOutletRebuildsOnArgument` asks.
    (match? ([] (. tree nodes) id)
      (case (call .node-match-expression row)
        (call read-patterns id (. row subject))
        (return)
      )
      (case (call .node-markup-slot-parameter row)
        (let value (call infer (. row name)))
        (if (and (!= value invalid-type) not-row-item (not (call reads-getter (. row name))))
          (call decline (. row name))
        )
        (lazy not-row-item (!= (call (. facts plan-of) instance (. row name)) .plan-row-item))
        (return)
      )
    )
    (let arm id)
    (while (!= arm 0)
      (let next SyntaxId 0)
      (match? ([] (. tree nodes) arm)
        (case (call .node-if-block row)
          (let pattern (call (. tree pattern-arm) arm))
          (if (!= pattern 0)
            (let subject (call (. tree matched-subject) (. row condition)))
            (let held (call infer-unprojected subject))
            (if (== held no-type)
              (call decline subject)
            )
            (if (and (!= held no-type) (!= held invalid-type) (not (call test-pattern pattern held)))
              (return)
            )
            (else-if (!= (. row condition) 0)
              (= tested-match (call (. tree tested) (. row condition)))
              (call note-truthiness (. row condition) (. row condition) (call infer (. row condition)))
              (= tested-match 0)
            )
          )
          (= next (. row next))
        )
      )
      (= arm next)
    )
  )
  (fn-do _ read-patterns _
    (param id SyntaxId)
    (param subject SyntaxId)
    ; The subject of a markup match region, read where the region is made and again by the function
    ; that selects its arm, against which each arm's pattern is tested in turn, binding nothing, as
    ; the reference's `markupMatchActiveArm` tests them. A pattern that tests with an expression of
    ; its own (`| x if x > 0`) has no shape here; one that can not match the subject is never tested.
    (let held (call infer-unprojected subject))
    (if (== held no-type)
      (call decline subject)
    )
    (if (or (== held no-type) (== held invalid-type))
      (return)
    )
    (for (in arm (call (. tree region-arms) id))
      (if (not (call test-pattern arm held))
        (return)
      )
    )
  )
  (fn-do _ test-pattern Bool
    (param arm SyntaxId)
    (param held TypeId)
    ; Tests the pattern of an arm of a match against a subject of a type, binding nothing. One that
    ; can not match is never tested; one that tests with an expression of its own has no shape here,
    ; and is declined, which answers false.
    (match? ([] (. tree nodes) arm)
      (case (call .node-type-transform row)
        (if (not (call (. tree tests-plainly) (. row pattern)))
          (call decline arm)
          (return false)
        )
        (if (and (not (call (. tree pattern-is-else) (. row pattern))) (not (call pattern-possible (. row pattern) held)))
          (call (. facts set-plan) instance arm .plan-never)
          (else
            (call check-pattern (. row pattern) held)
          )
        )
      )
    )
    (return true)
  )
  (fn-do _ bind-arm Bool
    (param arm SyntaxId)
    ; The subject of the match an arm of a markup match region, or of a branch region written with
    ; a pattern, is one of, read again by the function that builds the arm, where a member of the
    ; region's host read by its name alone is read from the host, kept where the region was made, and
    ; the arm's pattern matched against it, binding `it` and the names the pattern declares, as the
    ; reference's `markupCompileMatchedArm` does. False, once declined, where that has no shape here.
    (let subject (call (. tree matched-subject) (call (. tree arm-match) arm)))
    (let resolution (call (. bindings resolution-of) (. frame binding) (call (. tree arm-site) arm)))
    (if (or (== subject 0) (!= (. resolution kind) .resolve-slot))
      (call decline arm)
      (return false)
    )
    (+= content-blocks 0)
    (+= content-parents (call (. frame slot-type) (. resolution slot)))
    (let held (call infer-unprojected subject))
    (call (. content-blocks pop))
    (call (. content-parents pop))
    (if (== held no-type)
      (call decline subject)
    )
    (if (or (== held no-type) (== held invalid-type))
      (return false)
    )
    (match? ([] (. tree nodes) arm)
      (case (call .node-type-transform row)
        (if (and (not (call (. tree pattern-is-else) (. row pattern))) (not (call pattern-possible (. row pattern) held)))
          (call (. facts set-plan) instance arm .plan-never)
          (return true)
        )
        (let it (call arm-slot arm .slot-it))
        (if (!= it no-slot)
          (call (. frame assign) it held)
        )
        (call check-pattern (. row pattern) held)
        (let passed (call passed-type (. row pattern) held))
        (if (and (!= it no-slot) (!= passed held))
          (call (. frame assign) it passed)
        )
      )
    )
    (return true)
  )
  (fn-do _ check-arm _
    (param body SyntaxId)
    ; The function that builds an arm of a markup branch region: given the region, whose type is
    ; the host's content, it runs the arm's body as content of the region, which makes the elements
    ; it declares names for where it starts, under the styles, the rules written in rules, with the
    ; state cells it keeps (`take-scope`), and the batch in force where the region is written, as
    ; `arm-root` says. That of an arm of a match region first matches the arm's pattern against the
    ; subject (`bind-arm`). That of a slot outlet that is a region mounts the outlet's node as the
    ; region's content.
    (call prepare)
    (call (. instances set-returns) instance (. types void-type) (. types void-type) .return-declared)
    (let content (call (. instances argument-type) instance 0))
    (let resolution (call (. bindings resolution-of) (. frame binding) body))
    (if (or (!= (. resolution kind) .resolve-slot) (== content no-type))
      (call decline body)
      (call finish-errors frame)
      (call close)
      (return)
    )
    (call (. frame assign) (. resolution slot) content)
    (let styled (. markup-styles length))
    (if outer
      (for (in style (. outer markup-styles))
        (+= markup-styles style)
      )
      (call (. (!! outer) seen-sheets) markup-sheets sheet-levels)
      (= sheets-given (call (. (!! outer) sheets-known)))
      (for (in use (. (!! outer) rule-scopes))
        (+= rule-scopes (call take-scope use))
      )
      (= scopes-given (call (. (!! outer) scopes-known)))
      (= layer-given (call (. (!! outer) markup-layer)))
    )
    (let rooted (if-expr outer (. outer region batch) false))
    (if (and rooted (call (. tree builds-outlet-alone) body))
      (+= (. facts region-roots) (call RegionRoot instance body (. (!! outer) region root) (call batch-type) no-instance))
      (else-if (and rooted (not (call arm-root body content (. (!! outer) region root))))
        (call finish-errors frame)
        (call close)
        (return)
      )
    )
    (let matched (call (. tree body-arm) body))
    (if (and (!= matched 0) (not (call bind-arm matched)))
      (call finish-errors frame)
      (call close)
      (return)
    )
    (+= content-blocks body)
    (+= content-parents content)
    (+= batched rooted)
    (if (is ([] (. tree nodes) body) .node-slot-outlet)
      (let produced (call check-statement body (call (. (call Want) adding) .want-content-line)))
      (call link-content body produced content)
      (else
        (call check-body body)
      )
    )
    (call (. batched pop))
    (call (. content-blocks pop))
    (call (. content-parents pop))
    (while (> (. markup-styles length) styled)
      (call (. markup-styles pop))
    )
    (call finish-errors frame)
    (call close)
  )
  (fn-do _ loop-source LoopSource
    (param id SyntaxId)
    (param container SyntaxId)
    (param read TypeId)
    ; The container of a markup loop region as the region's source, as the reference's
    ; `markupLoopSource` takes it: a concrete `Collection` as it is, made a region by
    ; `markup-create-collection-region`, and else one that supports a `Broadcastable` or an `Iterable`,
    ; in that order, converted to that interface at the container, made one by
    ; `markup-create-broadcastable-region` or `markup-create-iterable-region`. The item is the
    ; interface's, or where that is not concrete the container's own first, as the reference's
    ; `markupLoopItemType` takes it. One that is an `Indexable` alone is the reference's error, as is
    ; one that is a `Collection` but no concrete one, and one that supports none of these. One that
    ; converts to a `Collection`, which the reference gives the region unconverted, and an `Iterable`
    ; that is `Closable`, which the reference gives the region to close, have no shape here yet. An
    ; optional container is read by the type it holds, and given to the region as it is where that
    ; type is the interface or derives from it, and else converted to the interface made optional.
    (let none (call LoopSource invalid-type no-type ""))
    (let optional (== (call (. types intrinsic-of) read) .optional))
    (let shape (if-expr optional (call (. types optional-inner) read) read))
    (if (and (== (call (. types intrinsic-of) shape) .interface) indexable)
      (call (. frame diagnose)
        (block
          (arg id)
          (arg .stated)
          (arg
            (call (. program store-atom)
              (block
                (arg
                  (paragraph
                    "Markup loop cannot observe Indexable sources because Indexable has no mutation events"
                  )
                )
              )
            )
          )
        )
      )
      (return none)
    )
    (lazy indexable (call same-decl (call class-ref types shape) (. types indexable-decl)))
    (let supports (call derived-interface shape (. types collection-decl)))
    (let kind "collection")
    (if (and (!= supports no-type) (== (call (. types intrinsic-of) shape) .interface))
      (call (. frame diagnose)
        (block
          (arg id)
          (arg .stated)
          (arg (call (. program store-atom) "Markup loop requires a concrete Collection source"))
        )
      )
      (return none)
    )
    (let collects (!= supports no-type))
    (if (and (== supports no-type) (== (call supported shape (. types collection-decl)) no-type))
      (= supports (call supported shape (. types broadcastable-decl)))
      (= kind "broadcastable")
    )
    (if (and (== supports no-type) (== (call supported shape (. types collection-decl)) no-type))
      (= supports (call supported shape (. types iterable-decl)))
      (= kind "iterable")
      (if (and (!= supports no-type) (!= (call derived-interface shape (. types closable-decl)) no-type))
        (call decline id)
        (return none)
      )
    )
    (if (== supports no-type)
      (if (or collection-shape broadcasts (!= (call supported shape (. types iterable-decl)) no-type))
        (call decline id)
        (else-if (!= (call supported shape (. types indexable-decl)) no-type)
          (call (. frame diagnose)
            (block
              (arg id)
              (arg .stated)
              (arg
                (call (. program store-atom)
                  (block
                    (arg
                      (paragraph
                        "Markup loop cannot observe Indexable sources because Indexable has no mutation events"
                      )
                    )
                  )
                )
              )
            )
          )
        )
        (else
          (call (. frame diagnose)
            (block
              (arg id)
              (arg .stated)
              (arg
                (call (. program store-atom)
                  (block
                    (arg "Markup loop source must be collection, broadcastable, or iterable")
                  )
                )
              )
            )
          )
        )
      )
      (lazy collection-shape (!= (call supported shape (. types collection-decl)) no-type))
      (lazy broadcasts (!= (call supported shape (. types broadcastable-decl)) no-type))
      (return none)
    )
    (let item (call first-arg supports))
    (if (or (== item no-type) (== item invalid-type) (. ([] (. types completions) item) has-variables))
      (= item (call first-arg shape))
    )
    (if (or (== item no-type) (== item invalid-type) (. ([] (. types completions) item) has-variables))
      (call decline id)
      (return none)
    )
    (if (or collects (and optional derives))
      (return (call LoopSource item read kind))
    )
    (lazy derives (!= (call derived-interface shape (if-expr (== kind "broadcastable") (. types broadcastable-decl) (. types iterable-decl))) no-type))
    (let given supports)
    (if (. ([] (. types completions) given) has-variables)
      (= given
        (call (. types well-known-type-of)
          (block
            (arg "core/stream")
            (arg (if-expr (== kind "broadcastable") "Broadcastable" "Iterable"))
            (arg item)
          )
        )
      )
    )
    (if (== given invalid-type)
      (return none)
    )
    (if optional
      (= given (call (. types optional-of) given))
    )
    (if (== (call (. conversions convert) container container read given .reason-argument) invalid-type)
      (return none)
    )
    (return (call LoopSource item given kind))
  )
  (fn-do _ check-row _
    (param body SyntaxId)
    ; The function that builds a row of a markup loop region: given the row's item, which the name
    ; the loop's header writes, `each` and `it` hold, it runs the loop's body as the body of a
    ; function, or, where the row is a region of its own (`row-region`), as content of the region
    ; it is given after the item, as an arm's body runs, under the styles, the rules written in rules, with the state cells it keeps
    ; (`take-scope`), and the batch in force where the region is written, and gives
    ; what the body gives, converted to the content of the region's host at the body, as the
    ; reference casts it. An element that binds a slot written as a line of the body is the
    ; reference's error.
    (call prepare)
    (let content (if-expr outer (. outer region content) no-type))
    (let item (call (. instances argument-type) instance 0))
    (let resolution (call (. bindings resolution-of) (. frame binding) body))
    (if (or (!= (. resolution kind) .resolve-slot) (== content no-type) (== item no-type))
      (call decline body)
      (call finish-errors frame)
      (call close)
      (return)
    )
    (let regioned (call (. tree row-region) body))
    (let returned (if-expr regioned (. types void-type) content))
    (call (. instances set-returns) instance returned returned .return-declared)
    (let lines (list SyntaxId))
    (match ([] (. tree nodes) body)
      (case (call .node-block block)
        (for (in statement ([] (. tree children) (. block body)))
          (+= lines statement)
        )
      )
      (default
        (+= lines body)
      )
    )
    (for (in line lines)
      (match? ([] (. tree nodes) line)
        (case (call .node-markup element)
          (if (!= (. element slot-binding) 0)
            (call (. frame diagnose)
              (block
                (arg (. element slot-binding))
                (arg .stated)
                (arg (call (. program store-atom) "A slot is filled by a line of the element's body, or by a line of an arm of an if or match there"))
              )
            )
            (call finish-errors frame)
            (call close)
            (return)
          )
        )
      )
    )
    (call (. frame assign) (. resolution slot) item)
    (if regioned
      (let held (call (. bindings resolution-of) (. frame binding) (call (. tree row-loop) body)))
      (if (!= (. held kind) .resolve-slot)
        (call decline body)
        (call finish-errors frame)
        (call close)
        (return)
      )
      (call (. frame assign) (. held slot) content)
    )
    (if (and (call reads-eager-getter body) (not (call is-row-item (. resolution slot) item)))
      (call decline body)
      (call finish-errors frame)
      (call close)
      (return)
    )
    (let styled (. markup-styles length))
    (if outer
      (for (in style (. outer markup-styles))
        (+= markup-styles style)
      )
      (call (. (!! outer) seen-sheets) markup-sheets sheet-levels)
      (= sheets-given (call (. (!! outer) sheets-known)))
      (for (in use (. (!! outer) rule-scopes))
        (+= rule-scopes (call take-scope use))
      )
      (= scopes-given (call (. (!! outer) scopes-known)))
      (= layer-given (call (. (!! outer) markup-layer)))
    )
    (let rooted (if-expr outer (. outer region batch) false))
    (if (and rooted regioned (not (call arm-root body content (. (!! outer) region root))))
      (call finish-errors frame)
      (call close)
      (return)
    )
    (if (and rooted (not regioned))
      (+= (. facts region-roots) (call RegionRoot instance body (. (!! outer) region root) (call batch-type)))
    )
    (+= batched rooted)
    (if regioned
      (+= content-blocks body)
      (+= content-parents content)
      (call check-statement body)
      (call (. content-blocks pop))
      (call (. content-parents pop))
      (call (. batched pop))
      (while (> (. markup-styles length) styled)
        (call (. markup-styles pop))
      )
      (call finish-errors frame)
      (call close)
      (return)
    )
    (= value-syntax body)
    (let value (call check-statement body))
    (call (. batched pop))
    (while (> (. markup-styles length) styled)
      (call (. markup-styles pop))
    )
    (if (and (!= value invalid-type) (!= value no-type))
      (call (. conversions convert) body value-syntax value content .reason-return)
    )
    (call finish-errors frame)
    (call close)
  )
  (fn-do _ reads-eager-getter Bool
    (param body SyntaxId)
    ; Whether the body of a row declares a getter that is not lazy, which the binder finds in the
    ; row of any keyed loop region. The reference reads such a local as a getter only where the
    ; row is given a `MarkupRowItem`.
    (match? ([] (. tree nodes) body)
      (case (call .node-block block)
        (for (in line ([] (. tree children) (. block body)))
          (match? ([] (. tree nodes) line)
            (case (call .node-declare declared)
              (if (and (not (. declared is-lazy)) (call declares-getter (. declared left)))
                (return true)
              )
            )
          )
        )
      )
    )
    (return false)
  )
  (fn-do _ check-key _
    (param clause SyntaxId)
    ; The function that keys a row of a markup loop region: given the row's item, which the name the
    ; loop's header writes, `each` and `it` hold, it gives the value of the `keyed by` clause,
    ; converted to a `String` at the value, as the reference casts it. That of a `when` clause tests
    ; the row's item, given as the row's function is, as a condition, and the markup runtime runs it
    ; in a live action of the row's own, which what it reads with `#` notes (`watched`).
    (call prepare)
    (let item (call (. instances argument-type) instance 0))
    (let resolution (call (. bindings resolution-of) (. frame binding) clause))
    (let expr SyntaxId 0)
    (let tests false)
    (match? ([] (. tree nodes) clause)
      (case (call .node-clause row)
        (= expr (. row expr))
        (= tests (== (. row op) .when-clause))
      )
    )
    (if (or (!= (. resolution kind) .resolve-slot) (== item no-type) (== expr 0))
      (call decline clause)
      (call finish-errors frame)
      (call close)
      (return)
    )
    (let answer (if-expr tests (. types bool-type) (. types string-type)))
    (call (. instances set-returns) instance answer answer .return-declared)
    (call (. frame assign) (. resolution slot) item)
    (let value (call infer expr))
    (if (and (!= value invalid-type) (!= value no-type))
      (call (. conversions convert)
        (block
          (arg (call (. tree return-site) expr))
          (arg expr)
          (arg value)
          (arg answer)
          (arg .reason-return)
          (arg true)
          (arg true)
        )
      )
    )
    (call finish-errors frame)
    (call close)
  )
  (fn-do _ read-row-item TypeId
    (param id SyntaxId)
    (param held TypeId)
    ; A name the row of a keyed markup loop region gives its item by, where the row's function is
    ; given a `MarkupRowItem`: the reference reads the holder's `item` by it, tracked. In the value
    ; of an assignment written with an operator other than `=`, which nothing runs again, the read
    ; is a plain one, as it is in the value of a declaration.
    (let name (call (. program store-atom) "item"))
    (let place (call property-named held name))
    (if (not place)
      (call decline id)
      (return invalid-type)
    )
    (if (not (call (. tree in-operator-value) id))
      (call track-read id held name)
    )
    (call (. facts set-plan) instance id .plan-row-item)
    (+= (. facts row-item-reads) (call RowItemRead instance id held))
    (return (. ([] (. types properties) place) type))
  )
  (fn-do _ read-getter TypeId
    (param id SyntaxId)
    (param slot SlotId)
    ; A read of a local of a row of a markup loop region that the reference reads as a getter: the
    ; value its declaration writes, typed here, where it is made again, and read where the
    ; outermost such read is, which `reading.getter` keeps while it is. A second read in one
    ; function, and a local written with a type, have no shape here yet.
    (if (!= (call (. getter-reads find) slot) null)
      (call decline id)
      (return invalid-type)
    )
    (+= getter-reads slot)
    (match? ([] (. tree nodes) (. ([] (. bindings slots) slot) getter))
      (case (call .node-declare declaration)
        (match? ([] (. tree nodes) (. declaration left))
          (case (call .node-type-capture capture)
            (if (!= (. capture type) 0)
              (call decline id)
              (return invalid-type)
            )
          )
        )
        (let around reading)
        (if (== (. reading getter) 0)
          (= reading (= (. reading getter) id))
        )
        (let value (call infer (. declaration right)))
        (= reading around)
        (if (and (!= value invalid-type) (!= value no-type))
          (call (. facts set-plan) instance id .plan-getter)
        )
        (return value)
      )
    )
    (call decline id)
    (return invalid-type)
  )
  (fn-do _ is-row-item Bool
    (param slot SlotId)
    (param held TypeId)
    ; Whether a local is the argument of the function that builds a row of a markup loop region,
    ; holding a `MarkupRowItem`.
    (if (or (!= (. ([] (. bindings slots) slot) kind) .slot-argument) not-row-item)
      (return false)
    )
    (lazy not-row-item (not (call same-decl (call class-ref types held) (. types markup-row-item-decl))))
    (let scope ([] (. bindings scopes) (. ([] (. bindings slots) slot) scope)))
    (if (!= (. scope kind) .scope-nested)
      (return false)
    )
    (let decl (call nested-decl-of (. scope syntax)))
    (if (== decl 0)
      (return false)
    )
    (match? ([] (. ([] (. program modules) module) decls) decl)
      (case (call .decl-function fn)
        (return (or (== (. fn kind) .row-decl) (and (== (. fn kind) .key-decl) (call (. tree tests-row) (. fn syntax)))))
      )
    )
    (return false)
  )
  (fn-do _ note-named _
    (param statement SyntaxId)
    (param held TypeId)
    ; A markup element a block declares a name for, in a function run on an object whose class
    ; has a property of that name: once the element's line has run, the reference stores in the
    ; property what the name then holds, as `named-place` says.
    (match? ([] (. tree nodes) statement)
      (case (call .node-markup row)
        (let place (call named-place statement (. row id) held))
        (if place
          (call (. facts note-named-store) (call NamedStore instance statement place))
        )
      )
    )
  )
  (fn-do _ named-place (? U32)
    (param site SyntaxId)
    (param name SyntaxId)
    (param held TypeId)
    ; The property of the class of the object a function is run on that the name of a markup
    ; element names, which the reference stores what the name holds in, converted at `site` as a
    ; value the property is given; or none. A property that the markup written in a class declared
    ; for an element is stored only by that markup, and a lazy one is given its value as an
    ; assignment gives it. A store that has no shape here is declined: in a function written in
    ; another, but one that builds a slot or gives a name its object (`in-slots`), or of a
    ; property not stored in the object, private to another module, or an array.
    (let self (. frame self-type))
    (if (or (== self no-type) (== self invalid-type) (!= (call (. types intrinsic-of) self) .class) (call lacks-self))
      (return null)
    )
    (let text (call (. tree identifier-name) name))
    (let place (only-if (call property-named self text) (if text)))
    (if (not place)
      (return null)
    )
    (let property ([] (. types properties) place))
    (let ref (call declaring-decl types property))
    (let member (call owner-property program (. ref module) (. ref decl) (!! text)))
    (match? ([] (. ([] (. program modules) (. ref module)) decls) member)
      (case (call .decl-property declared)
        (if (and (!= member 0) (!= (. declared element) 0))
          (let owner ([] (. program modules) (. ref module)))
          (let fills false)
          (match? ([] (. owner decls) (. ref decl))
            (case (call .decl-class class)
              (= fills (and (== (. ref module) module) (== (. class content-function) (call written-decl))))
            )
          )
          (if (not fills)
            (return null)
          )
        )
      )
    )
    (let type (. property type))
    (if (== type no-type)
      (= type (call demand-member property self (!! text)))
    )
    (let kept (or (== (. property storage-kind) .storage-eager) (== (. property storage-kind) .storage-lazy)))
    (let stored (and kept (!= type no-type) (!= type invalid-type)))
    (if (or (not (call in-slots)) (not stored) (call is-hidden property (!! text) .setter-decl) (call is-array-value type))
      (call decline site)
      (return null)
    )
    (if (== (call (. conversions convert) site site held type .reason-declaration true true) invalid-type)
      (return null)
    )
    (let written (call (. panics property-of) self (!! text)))
    (if written
      (call (. panics note-write) instance written)
    )
    (return (as place U32))
  )
  (fn-expr _ in-slots Bool
    ; Whether this function is no function written in another, or one written in such a one that
    ; builds a slot, gives a markup element's name its object, or builds a row of a markup loop
    ; region or an arm of a branch region, which run on the same object.
    (if-expr (call builds-in-place) (and (!= outer null) (call (. outer in-slots))) (== outer null))
  )
  (fn-expr _ builds-in-place Bool
    ; Whether this function builds a slot, gives a markup element's name its object, or builds a row
    ; of a markup loop region or an arm of a branch region, for the function it is written in.
    (or (== kind .slot-decl) (== kind .binder-decl) (== kind .row-decl) (== kind .branch-arm-decl))
    (where
      (lazy kind (. frame declaration kind))
    )
  )
  (fn-expr _ written-decl DeclId
    ; The function this one is, or that it is written in where it builds what it is written in
    ; builds (`builds-in-place`).
    (if-expr (and (call builds-in-place) outer) (call (. outer written-decl)) (. frame decl))
  )
  (fn-expr _ reads-before-made Bool
    (param read SyntaxId)
    (param slot SlotId)
    (or (call reads-before-placing read slot) (and (not (and outer (call (. frame is-captured) slot))) (== (call (. frame slot-type) slot) no-type)))
  )
  (fn-expr _ reads-before-placing Bool
    (param read SyntaxId)
    (param slot SlotId)
    (case? (!= (. frame declaration kind) .slot-decl)
      false
    )
    (default
      (and (>= element (. range start)) (< element (+ (. range start) (. range count))) after-read)
    )
    (where
      (lazy element (. ([] (. bindings slots) slot) group))
      (lazy range (. frame declaration subtree))
      (lazy after-read (> (call (. tree subtree-start) element) read))
    )
  )
  (fn-do _ infer-index Found
    (param id SyntaxId)
    (param object-syntax SyntaxId)
    (param key-syntax SyntaxId)
    (param is-optional Bool)
    (param want Want)
    (let object-found (call infer-found object-syntax (call (. (call Want) adding) .want-event)))
    (let object (. object-found type))
    (if (!= (. object-found event) (. U32 max))
      (return (call address-event id key-syntax is-optional ([] found-events (. object-found event)) want))
    )
    (let own (. object-found link))
    (let key (call infer key-syntax))
    (if (or (== object invalid-type) (== key invalid-type))
      (return (call Found invalid-type))
    )
    (let sized (call sized-array id object key-syntax key))
    (if (!= sized no-type)
      (return (call Found sized))
    )
    (let form (if-expr is-optional (call note-chain id id object) (. ChainForm chain-plain)))
    (if (or (== form .chain-absent) (call absent-after object-syntax object))
      (return (call Found (. types null-type)))
    )
    (let optional (== form .chain-tested))
    (let receiver (call link-receiver object-syntax object own optional))
    (let chained (and (or optional (call optional-chained object-syntax)) (call (. types is-optional) object)))
    (let pointee (call cpointer-item receiver))
    (if (== pointee (. types void-type))
      (call (. frame diagnose) id .stated (call (. program store-atom) "Void has no physical address"))
      (return (call Found invalid-type))
    )
    (if (!= pointee no-type)
      (call (. facts set-plan) instance id .plan-item)
      (return (call (. (call Found (if-expr chained (call (. types optional-of) pointee) pointee)) linking) pointee))
    )
    (let field (call tuple-field receiver key-syntax))
    (let positional (!= field no-type))
    (if (== field no-type)
      (= field (call view-index receiver key-syntax))
      (if (!= field no-type)
        (call plan-view id (call eager-slot (call row-struct-of receiver) key-syntax))
      )
    )
    (if (== field no-type)
      (= field (call aggregate-field receiver key-syntax key (!! (. types index-op-atom))))
      (= positional (!= field no-type))
    )
    (if (!= field no-type)
      (let read (if-expr chained (call (. types optional-of) field) field))
      (if positional
        (call note-field id receiver key-syntax)
        (call (. facts set-node-type) instance id read)
      )
      (return (call (. (call Found read) linking) field))
    )
    (let cell (call view-cell id object-syntax receiver key-syntax key))
    (if (!= cell no-type)
      (return (call (. (call Found (if-expr (and chained (!= cell invalid-type)) (call (. types optional-of) cell) cell)) linking) cell))
    )
    (let chosen (call selection-key receiver key))
    (let diagnosed (. facts diagnostics length))
    (let first-call FactId (as (. facts calls length) FactId))
    (let tabled (call is-table-view receiver))
    (let result
      (call (. calls operator-call)
        (block
          (arg id)
          (arg receiver)
          (arg (!! (. types index-op-atom)))
          (arg key-syntax)
          (arg chosen)
          (arg tabled)
          (arg object-syntax)
        )
      )
    )
    (if (== result invalid-type)
      (call restate-index diagnosed id receiver key-syntax)
      (return (call Found result))
    )
    (if (not (call plan-table-index id object-syntax receiver key-syntax key result))
      (return (call Found invalid-type))
    )
    (if (and tabled (not (call (. facts answers-in-place) instance id)))
      (call (. frame forget-members))
    )
    (if (not optional)
      (call (. calls plan-array-item) id key first-call result)
    )
    (return (call (. (call Found (if-expr chained (call (. types optional-of) result) result)) linking) result))
  )
  (fn-expr _ link-receiver TypeId
    (param object-syntax SyntaxId)
    (param object TypeId)
    (param own TypeId)
    (param is-optional Bool)
    ; What a read, an index or a call reads from. A link of an optional chain written after `?`
    ; reads from what the optional before it holds. A link written with no `?` after another
    ; link reads from what that link gives by itself, which the chain holds in no optional
    ; between its links: `own`, what typing the link before found it to give (`Found.link`).
    ; Anything else reads from the value as it is.
    (case? (or (== object invalid-type) (== object no-type) (not (call (. types is-optional) object)))
      object
    )
    (case? is-optional
      (call (. types optional-inner) object)
    )
    (case? (not (call optional-chained object-syntax))
      object
    )
    (default
      (if-expr (!= own no-type) own (call (. types optional-inner) object))
    )
  )
  (fn-do _ note-field _
    (param id SyntaxId)
    (param receiver TypeId)
    (param key-syntax SyntaxId)
    ; Records which stored field of a tuple or struct a constant index names, as the constant of
    ; the node that reads or assigns it. The index one past the last field names the place a new
    ; field would take. A tuple with no name stores every field it has, in order, so the index
    ; is the field.
    (match? ([] (. tree nodes) key-syntax)
      (case (call .node-integer-syntax row)
        (let wanted (. (call parse-integer-literal (. row value)) value))
        (let range (. ([] (. types completions) receiver) properties))
        (if (call (. types is-plain-tuple) receiver)
          (if (< wanted (. range count))
            (let held (as (. ([] (. types properties) (as (+ (. range start) wanted) Index)) slot) U64))
            (call (. facts set-place) instance id (as held U32) .plan-field)
            (else-if (== wanted (. range count))
              (call (. facts set-place) instance id (as wanted U32) .plan-field)
            )
          )
          (return)
        )
        (let position U64)
        (let place U64)
        (for (in offset (..< 0 (. range count)))
          (let property ([] (. types properties) (as (+ (. range start) offset) Index)))
          (if (!= (. property storage-kind) .storage-eager)
            (continue)
          )
          (if (== position wanted)
            (= place (. property slot))
            (break)
          )
          (+= position 1)
          (= place (+ (as (. property slot) U64) 1))
        )
        (if (== position wanted)
          (call (. facts set-place) instance id (as place U32) .plan-field)
        )
      )
    )
  )
  (fn-do _ restate-index _
    (param diagnosed Size)
    (param id SyntaxId)
    (param receiver TypeId)
    (param key-syntax SyntaxId)
    ; A tuple or struct with no index operator of its own is indexed by position, which must be a
    ; constant that names one of its fields.
    (if (or (== (call tuple-arity receiver) (. U32 max)) column-receiver (call indexes-itself receiver))
      (return)
    )
    (lazy column-receiver (call is-column-receiver (call (. types intrinsic-of) receiver)))
    (let message
      (scope (if-expr literal-key "Index out of bounds" "Value has no constant form")
        (lazy literal-key (call (. tree is-integer-literal) key-syntax))
      )
    )
    (call (. facts restate) diagnosed instance id .illegal-operation .stated (call (. program store-atom) message))
  )
  (fn-do _ selection-key TypeId
    (param receiver TypeId)
    (param key TypeId)
    ; A table selects rows by an array of indices as it does by an immutable array of them.
    (let kind (call (. types intrinsic-of) receiver))
    (if (and (!= kind .table) (!= kind .immutable-table))
      (return key)
    )
    (match? ([] (. types rows) key)
      (case (call .type-class row)
        (if (call same-decl (call DeclRef (. row module) (. row decl)) (. types array-decl))
          (let mark (. scratch types mark))
          (for (in position (..< 0 (. row args count)))
            (call (. scratch types push) (call (. types child-type) (. row args) position))
          )
          (let owner (. types immutable-array-decl))
          (return (call (. types intern-class) (. owner module) (. owner decl) mark))
        )
      )
    )
    (return key)
  )
  (fn-do _ tuple-field TypeId
    (param receiver TypeId)
    (param key-syntax SyntaxId)
    (let fields (call (of RowRange TypeId)))
    (match? ([] (. types rows) receiver)
      (case (call .type-tuple row)
        (= fields (. row fields))
      )
    )
    (if (== (. fields count) 0)
      (return no-type)
    )
    (match? ([] (. tree nodes) key-syntax)
      (case (call .node-integer-syntax row)
        (let literal (call parse-integer-literal (. row value)))
        (if (and (not (. literal negative)) (not (. literal overflow)) (< (. literal value) (. fields count)))
          (return (call (. types child-type) fields (as (. literal value) U32)))
        )
      )
    )
    (return no-type)
  )
  (fn-do _ check-task _
    (param id SyntaxId)
    ; A task spawned where its block is written. A body that captures a local is given an object the
    ; collector owns where it is spawned, and a panic a handler takes is moved into the collector's
    ; heap.
    (let row ([] (. bindings bindings) (. frame binding)))
    (for (in offset (..< 0 (. row nested count)))
      (let nested ([] (. bindings nested) (+ (. row nested start) offset)))
      (if (== (. nested syntax) id)
        (let mask (call callee-effects frame module (. nested decl)))
        (let none (. scratch no-types))
        (let callee (call (. instances intern) module (. nested decl) no-type mask instance none none false))
        (if (== (. ([] (. instances rows) callee) state) .instance-unstarted)
          (+= (. facts task-bodies) callee)
          (call run-within callee this)
        )
        (let owned (call owns-task id))
        (if (or (!= (. nested captures count) 0) (call (. tree has-handlers) id) owned)
          (call (. frame check-allocates) id)
        )
        (let form CallForm (if-expr owned .call-owned-task .call-task))
        (call (. facts record-call) instance id callee form (. scratch no-fills) false)
        (call demand-panic-report)
        (return)
      )
    )
  )
  (fn-do _ owns-task Bool
    (param task SyntaxId)
    ; Whether the task spawned at a node is owned, cancelled as its owner closes or its case exits:
    ; one not marked `@detached`, spawned in markup being built, by its innermost element where that
    ; is an object of a class, or else by the activation of a case the binder gave it to
    ; (`activation-tasks`), or else where a subscription would be owned (`is-owner`), by the receiver
    ; where that is an object of a class.
    (match? ([] (. tree nodes) task)
      (case (call .node-do-task-block row)
        (return-if false (if (. row detached)))
        (blank)
        (if (!= (. content-parents length) 0)
          (return (== (call (. types intrinsic-of) ([] content-parents (- (. content-parents length) 1))) .class))
        )
        (if (!= (call (. bindings activation-tasks) (. frame binding) task (call (. program store-atom) "(tasks)")) no-slot)
          (return true)
        )
        (return-if false (if (not (call is-owner))))
        (return (== (call (. types intrinsic-of) (. frame self-type)) .class))
      )
    )
    (return false)
  )
  (fn-do _ class-property DeclId
    (param ref DeclRef)
    (param name Atom)
    ; The property of a name a class declares, or none.
    (let owner ([] (. program modules) (. ref module)))
    (match? ([] (. owner decls) (. ref decl))
      (case (call .decl-class class)
        (for (in member (call (. owner members-named) (. class members) name))
          (match? ([] (. owner decls) member)
            (case (call .decl-property row)
              (if (and (. row name) (== (. row name) name))
                (return member)
              )
            )
          )
        )
      )
    )
    (return 0)
  )
  (fn-do _ declared-value SyntaxId
    (param owner ModuleId)
    (param property DeclId)
    ; The value a property of a module declares, or none.
    (if (== property 0)
      (return 0)
    )
    (match? ([] (. ([] (. program modules) owner) decls) property)
      (case (call .decl-property row)
        (return (. row value))
      )
    )
    (return 0)
  )
  (fn-do _ report-pattern-on _
    (param pattern SyntaxId)
    ; Reports a grammar written on a stream a subscription is given, which no match reads.
    (let text
      (paragraph
        "A grammar matches items it reads with \"in\", not items a subscription with \"on\" is given; write \"in\" in place of \"on\""
      )
    )
    (call (. frame diagnose) pattern .stated (call (. program store-atom) text))
  )
  (fn-do _ check-worker _
    (param id SyntaxId)
    (param worker SyntaxId)
    ; A task forked onto a named target runs on a worker. The target is typed before the task, as
    ; the reference reads it where it still knows what the flow before the task knows of properties.
    (let target (call infer worker))
    (if (or (== target invalid-type) (== target no-type))
      (return)
    )
    (let named
      (match ([] (. types rows) target)
        (case (call .type-class row)
          (call (. types worker-decl refers-to) (. row module) (. row decl))
        )
        (default
          false
        )
      )
    )
    (if (not named)
      (call (. frame diagnose) id .stated (call (. program store-atom) "Fork target is not a Worker"))
    )
  )
  (fn-do _ runs-class Bool
    (param owner DeclId)
    ; Whether an instance is a function a class of the module declares, or has an object of the
    ; class or of one derived from it for its receiver.
    (let decls (. ([] (. program modules) module) decls))
    (for (in instance (..< 0 (. instances length)))
      (let row ([] (. instances rows) instance))
      (if (== (. row module) module)
        (match? ([] decls (. row decl))
          (case (call .decl-function fn)
            (if (== (. fn owner) owner)
              (return true)
            )
          )
        )
      )
      (let level (? TypeId) (only-if (. row self-type) (if (!= (. row self-type) no-type))))
      (while (and level (== (call (. types intrinsic-of) level) .class))
        (let ref (call class-ref types level))
        (if (and (== (. ref module) module) (== (. ref decl) owner))
          (return true)
        )
        (= level (call (. types base-of) level))
      )
    )
    (return false)
  )
  (fn-do _ probe-runtime-call InstanceId
    (param probes ModuleId)
    (param name String)
    (param arguments (list TypeId))
    (let mark (. scratch types mark))
    (for (in argument arguments)
      (call (. scratch types push) argument)
    )
    (let callee (call (. calls demand-runtime-call) probes no-type (call (. program store-atom) name) mark))
    (call (. scratch types rewind) mark)
    (return callee)
  )
  (fn-expr _ optional-chained Bool
    (param syntax SyntaxId)
    (match ([] (. tree nodes) syntax)
      (case (call .node-get-expression row)
        (or (call chains-at syntax (. row is-optional)) (call optional-chained (. row object)))
      )
      (case (call .node-index-expression row)
        (or (call chains-at syntax (. row is-optional)) (call optional-chained (. row object)))
      )
      (case (call .node-style-read-expression row)
        (or (call chains-at syntax (. row is-optional)) (and (!= (. row object) 0) (call optional-chained (. row object))))
      )
      (case (call .node-markup-read-expression row)
        (or (call chains-at syntax (. row is-optional)) (and (!= (. row object) 0) (call optional-chained (. row object))))
      )
      (case (call .node-call-expression row)
        (call optional-chained (. row callable))
      )
      (default
        false
      )
    )
  )
  (fn-expr _ chains-at Bool
    (param link SyntaxId)
    (param is-optional Bool)
    (and is-optional (!= (call (. facts chain-form) instance link) .chain-plain))
  )
  (fn-expr _ absent-after Bool
    (param object-syntax SyntaxId)
    (param object TypeId)
    (and (== object (. types null-type)) (call optional-chained object-syntax))
  )
  (fn-do _ note-chain ChainForm
    (param id SyntaxId)
    (param link SyntaxId)
    (param receiver TypeId)
    (let form (call chain-form-of receiver))
    (call (. facts record-chain) instance id link form)
    (return form)
  )
  (fn-expr _ chain-form-of ChainForm
    (param receiver TypeId)
    (case? (== receiver (. types null-type))
      .chain-absent
    )
    (case? (call (. types is-optional) receiver)
      .chain-tested
    )
    (default
      .chain-plain
    )
  )
  (fn-do _ check-use TypeId
    (param id SyntaxId)
    (param expr SyntaxId)
    ; `use`, written as a value or as `do use`: the subject's `begin-using` gives the value, and its
    ; `end-using` is called where the block is left, the two calls recorded at the node in that
    ; order. A subject with no `begin-using` that closes gives itself, and `close`, the one call
    ; recorded, is called where the block is left. An error the call that ends the use raises
    ; leaves the function, as one a cleanup raises does.
    (= cleans-up true)
    (let chain (call (. tree optional-chain-expr) expr))
    (let subject (if-expr (!= chain 0) (call infer chain) (call infer expr)))
    (if (or (== subject invalid-type) (== subject no-type))
      (call decline id)
      (return invalid-type)
    )
    (if (!= chain 0)
      (call (. facts set-node-type) instance expr subject)
      (if (call (. types is-optional) subject)
        (= subject (call (. types optional-inner) subject))
      )
    )
    (call (. types optional-of) subject)
    (let used (call protocol-member subject "begin-using" id .role-begin))
    (if (== used invalid-type)
      (if (== (call ending-member subject "close" id) invalid-type)
        (let shown (call type-short-name types subject))
        (let text
          (paragraph
            (str shown " cannot be used, as it has no \"begin-using\" and is not Closable; declare \"begin-using\" and \"end-using\", or implement Closable")
          )
        )
        (call (. frame diagnose) id .stated (call (. program store-atom) text))
        (return invalid-type)
      )
      (= used subject)
      (else-if (== (call ending-member subject "end-using" id) invalid-type)
        (call decline id)
        (return invalid-type)
      )
    )
    (let slot (call (. bindings using-slot) (. frame binding) id))
    (if (!= slot no-slot)
      (call (. frame assign) slot (call (. types optional-of) subject))
    )
    (return (if-expr (and (!= chain 0) (not (call (. types is-optional) used))) (call (. types optional-of) used) used))
  )
  (fn-do _ ending-member TypeId
    (param receiver TypeId)
    (param name String)
    (param site SyntaxId)
    ; The method that ends a use, called as `protocol-member` calls one, whose errors leave the
    ; function.
    (let result (call (. calls protocol-getter) receiver (call (. program store-atom) name) site .role-end))
    (if (!= result invalid-type)
      (return result)
    )
    (return (. (call (. calls protocol-call) receiver (call (. program store-atom) name) site no-type true (:role (. CallRole role-end))) answer))
  )
  (fn-do _ protocol-member TypeId
    (param receiver TypeId)
    (param name String)
    (param site SyntaxId)
    (param role CallRole)
    (let atom (call (. program store-atom) name))
    (let result (call (. calls protocol-getter) receiver atom site role))
    (if (!= result invalid-type)
      (return result)
    )
    (return (. (call (. calls protocol-call) receiver atom site (:role role)) answer))
  )
  (fn-do _ check-task-handlers _
    (param task SyntaxId)
    ; The handlers written after a task's block run in the task, after its cleanups, when a panic
    ; of the type each names ends it, and bind that panic: each names `Panic` or a type derived
    ; from it, and takes no errors it replaced.
    (match? ([] (. tree nodes) task)
      (case (call .node-do-task-block row)
        (if (!= (. row catchers count) 0)
          (call (. frame forget-members))
        )
        (for (in catcher ([] (. tree children) (. row catchers)))
          (match? ([] (. tree nodes) catcher)
            (case (call .node-catcher handler)
              (if (!= (. handler previous count) 0)
                (call (. frame diagnose)
                  (block
                    (arg catcher)
                    (arg .stated)
                    (arg (call (. program store-atom) "A task's handler replaces no errors"))
                  )
                )
              )
              (let named (call (. tree handled-type) (. handler type)))
              (if (!= named 0)
                (let handled (call (. types evaluate-type) module tree named (. frame env)))
                (if (and (!= handled invalid-type) (not (call is-subtype types handled (. types panic-type))))
                  (call (. frame diagnose)
                    (block
                      (arg named)
                      (arg .stated)
                      (arg (call (. program store-atom) "A task's handler takes a panic"))
                    )
                  )
                )
              )
              (call check-pattern (. handler type) (. types panic-type))
              (call check-statement (. handler body))
            )
          )
        )
      )
    )
  )
  (fn-do _ nested-decl-of DeclId
    (param id SyntaxId)
    (let row ([] (. bindings bindings) (. frame binding)))
    (for (in offset (..< 0 (. row nested count)))
      (let nested ([] (. bindings nested) (+ (. row nested start) offset)))
      (if (== (. nested syntax) id)
        (return (. nested decl))
      )
    )
    (return 0)
  )
  (fn-do _ intern-nested TypeId
    (param decl DeclId)
    ; The type of a closure this instance writes.
    (return (call (. types intern-closure) module decl instance ([] (. instances stable-keys) instance)))
  )
  (fn-do _ demand-nested InstanceId
    (param decl DeclId)
    (param argument TypeId)
    (param second TypeId (= no-type))
    ; The one instance of a generated closure, keyed under this instance like a lambda's: a
    ; comprehension's takes its container, a pipeline body its item, and a feed list nothing.
    ; Its closure type is interned here, before its body is typed, so that the types of every
    ; closure a function writes are rowed in the order the function is typed.
    (call intern-nested decl)
    (let mask (call callee-effects frame module decl))
    (let mark (. scratch types mark))
    (if (!= argument no-type)
      (call (. scratch types push) argument)
    )
    (if (!= second no-type)
      (call (. scratch types push) second)
    )
    (let argument-span (call (. scratch types since) mark))
    (let callee (call (. instances intern) module decl no-type mask instance (. scratch no-types) argument-span))
    (call (. scratch types rewind) mark)
    (if (== (. ([] (. instances rows) callee) state) .instance-unstarted)
      (call run-within callee this true)
    )
    (return callee)
  )
  (fn-do _ list-of TypeId
    (param item TypeId)
    (let mark (. scratch types mark))
    (call (. scratch types push) item)
    (let list (call (. types class-with-args) (. types list-decl module) (. types list-decl decl) mark))
    (call (. types complete) list)
    (return list)
  )
  (fn-expr _ natural-item TypeId
    (param source TypeId)
    ; The item of the stream the reference reads a value through, as `record-stream-protocol`
    ; makes it, or none where it reads it through none.
    (case? (or (== source no-type) (== source invalid-type))
      no-type
    )
    (case? (!= given no-type)
      (call first-arg given)
    )
    (case? (== source (. types string-type))
      (call (. types type-row) .char)
    )
    (case? (or (call same-decl ref (. types generator-decl)) (and (== kind .interface) cursor-iterable))
      (call first-arg source)
    )
    (case? (and (!= kind .class) (!= kind .struct) (!= kind .tuple) (!= kind .interface))
      no-type
    )
    (case? (!= (call supported source (. types byte-readable-decl)) no-type)
      (if-expr (!= decodable no-type) (call first-arg decodable) (call (. types type-row) .uint8))
      (blank)
      (lazy decodable (call supported source (. types decodable-decl)))
    )
    (case? (!= indexable no-type)
      (call first-arg indexable)
    )
    (default
      (if-expr (!= iterable no-type) (call first-arg iterable) no-type)
    )
    (where
      (lazy kind (call (. types intrinsic-of) source))
      (lazy given (if-expr (or (== kind .class) (== kind .interface)) stream-support no-type))
      (lazy ref (call class-ref types source))
      (lazy indexable (call supported source (. types indexable-decl)))
      (lazy iterable (call supported source (. types iterable-decl)))
      (lazy stream-support (call supported source (. types token-stream-decl)))
      (lazy cursor-iterable (call same-decl ref (. types cursor-iterable-decl)))
    )
  )
  (fn-expr _ supported TypeId
    (param source TypeId)
    (param decl DeclRef)
    ; The type of a declaration a value supports, as the reference finds the stream to read it
    ; through: the value's own, that of a class it derives from, or an interface any of them
    ; declares or one of those derives from; else what a converter any of them declares makes,
    ; of that declaration. None where it supports none.
    (if-expr (!= found no-type) found (call converted-class source decl))
    (where
      (lazy found (call derived-interface source decl))
    )
  )
  (fn-do _ derived-interface TypeId
    (param type TypeId)
    (param decl DeclRef)
    ; The type of a declaration a type is, derives from, or declares as an interface, or one of
    ; those does, searched in that order, completing the type, which completes the classes above it.
    (if (call same-decl (call class-ref types type) decl)
      (return type)
    )
    (call (. types complete) type)
    (let base (call (. types base-of) type))
    (if base
      (let found (call derived-interface base decl))
      (if (!= found no-type)
        (return found)
      )
    )
    (for (in interface (call (. types interfaces-of) type))
      (let found (call derived-interface interface decl))
      (if (!= found no-type)
        (return found)
      )
    )
    (return no-type)
  )
  (fn-do _ converted-class TypeId
    (param type TypeId)
    (param decl DeclRef)
    ; What a converter a type declares makes, where it is of a declaration, else what one a
    ; class it derives from or an interface it declares does, searched in that order, completing the
    ; type, which completes the classes above it.
    (let declared (call (. relations declared-converter) type decl))
    (if (!= declared no-type)
      (return declared)
    )
    (call (. types complete) type)
    (let base (call (. types base-of) type))
    (if base
      (let found (call converted-class base decl))
      (if (!= found no-type)
        (return found)
      )
    )
    (for (in interface (call (. types interfaces-of) type))
      (let found (call converted-class interface decl))
      (if (!= found no-type)
        (return found)
      )
    )
    (return no-type)
  )
  (fn-do _ first-set U32
    (param id SyntaxId)
    ; What the reference knows of the first item a grammar reads, as it works it out to
    ; choose among arms: 1 where it knows what that item may be, and 2 more where the pattern may
    ; read none. A call, a test of a type, a predicate or text found as the pattern runs is not
    ; known, and a lookahead reads none and is not known either.
    (match? ([] (. tree nodes) id)
      (case (call .node-stream-match row)
        (return (call first-set (. row pattern)))
      )
      (case (call .node-stream-string row)
        (return (if-expr (== (. row text length) 0) 3 1))
      )
      (case .node-stream-any
        (return 1)
      )
      (case .node-stream-char-range
        (return 1)
      )
      (case (call .node-stream-and row)
        (let leading (call first-set (. row left)))
        (if (== (/and/ leading 2) 0)
          (return leading)
        )
        (let following (call first-set (. row right)))
        (return (/or/ (/and/ leading following 1) (/and/ following 2)))
      )
      (case (call .node-stream-or row)
        (let left (call first-set (. row left)))
        (let right (call first-set (. row right)))
        (return (/or/ (/and/ left right 1) (/and/ (/or/ left right) 2)))
      )
      (case (call .node-stream-unary row)
        (if (or (== (. row op) .positive-lookahead-op) (== (. row op) .negative-lookahead-op))
          (return 2)
        )
        (let item (/and/ (call first-set (. row operand)) 1))
        (return (if-expr (== (. row op) .one-or-more-op) item (/or/ item 2)))
      )
      (case (call .node-stream-length row)
        (match? ([] (. tree nodes) (. row min))
          (case (call .node-integer-syntax bound)
            (let item (/and/ (call first-set (. row operand)) 1))
            (return (if-expr (== (. (call parse-integer-literal (. bound value)) value) 0) (/or/ item 2) item))
          )
        )
      )
      (case (call .node-stream-capture row)
        (return (call first-set (. row pattern)))
      )
      (case (call .node-stream-transform row)
        (if (!= (. row pattern) 0)
          (return (call first-set (. row pattern)))
        )
      )
      (case (call .node-stream-panic row)
        (return (call first-set (. row pattern)))
      )
    )
    (return 0)
  )
  (fn-do _ hands-off Bool
    (param run InstanceId)
    ; What a function gives the errors that leave it to where the reference keeps them from its
    ; caller: the global `unhandled-error` of core, typed, which holds a function that takes an
    ; `Error` and answers nothing, and read by the function as a checked read is, evaluated first
    ; where it has no value yet. Calling it may panic, as a call of any function value may. Says
    ; whether that is in place.
    (let module (. (call class-ref types (. types error-type)) module))
    (let decls (. ([] (. program modules) module) decls))
    (let name (call (. program store-atom) "unhandled-error"))
    (for (in position (..< 0 (. decls length)))
      (match? ([] decls position)
        (case (call .decl-property property)
          (if (and (== (. property owner) 0) (. property name) (== (. property name) name))
            (let held (call demand-property module (as position DeclId)))
            (let fn
              (scope (if-expr (and (!= held invalid-type) (!= held no-type)) held-row no-type)
                (lazy held-row (call function-row types held))
              )
            )
            (if (== fn no-type)
              (return false)
            )
            (match? ([] (. types rows) fn)
              (case (call .type-function row)
                (let answers (and (!= (. row return-type) no-type) (!= (. row return-type) (. types void-type))))
                (if (or (. row is-c) answers odd-signature not-error)
                  (return false)
                )
                (lazy odd-signature (or (!= (. row errors count) 0) (!= (. row args count) 1)))
                (lazy not-error (!= (call (. types child-type) (. row args) 0) (. types error-type)))
              )
            )
            (= (. facts unhandled-error) (call DeclRef module (as position DeclId)))
            (call (. facts global-uses append) (call GlobalUse run 0 module (as position DeclId)))
            (call (. instances mark-may-panic) run)
            (return true)
          )
        )
      )
    )
    (return false)
  )
  (fn-expr _ is-owner Bool
    ; Whether what subscribes here is owned by an object: the markup element being built, the
    ; receiver of a method, or the object a class's section runs for. The reference gives such a
    ; subscription to the innermost element, or else to the object.
    (case? (!= (. content-parents length) 0)
      (== (call (. types intrinsic-of) ([] content-parents (- (. content-parents length) 1))) .class)
    )
    (default
      (and (!= (. frame self-type) no-type) (!= (. frame self-type) invalid-type) (not (call lacks-self)))
    )
  )
  (fn-expr _ activation-owns Bool
    (param id SyntaxId)
    (!= (call (. bindings activation-tasks) (. frame binding) id (call (. program store-atom) "(tasks)")) no-slot)
  )
  (fn-expr _ owns-subscription Bool
    (param id SyntaxId)
    (or (call is-owner) (call activation-owns id))
  )
  (fn-do _ closure-of-self TypeId
    ; The closure type of the nested function being typed, as the instance that writes it made it.
    (let enclosing (. ([] (. instances rows) instance) enclosing))
    (if (== enclosing no-instance)
      (return no-type)
    )
    (return (call (. types intern-closure) module (. frame decl) enclosing ([] (. instances stable-keys) enclosing)))
  )
  (fn-do _ hands-off-raising Bool
    (param call FactId)
    ; What the function being checked gives the errors of a call the compiler places in it to,
    ; where the call may raise: the global `unhandled-error` (see `hands-off`), and the function
    ; goes on. Says whether that is in place, or nothing needs it.
    (if (or (== call no-fact) (== (. ([] (. instances signatures) (. ([] (. facts calls) call) callee)) errors count) 0))
      (return true)
    )
    (return (call hands-off instance))
  )
  (fn-expr _ is-integer Bool
    (param type TypeId)
    (and (call intrinsic-is-numeric kind) (not (call intrinsic-is-float kind)) (!= kind .cpointer))
    (where
      (lazy kind (call (. types intrinsic-of) type))
    )
  )
  (fn-expr _ implements Bool
    (param container TypeId)
    (param decl DeclRef)
    (!= (call interface-of container decl) no-type)
  )
  (fn-expr _ iterable-item TypeId
    (param container TypeId)
    (param decl DeclRef)
    (if-expr (!= interface no-type) (call first-arg interface) no-type)
    (where
      (lazy interface (call interface-of container decl))
    )
  )
  (fn-do _ interface-of TypeId
    (param container TypeId)
    (param decl DeclRef)
    ; The interface of a declaration a type is or implements, its own before its bases': of
    ; several a class implements, the last it declares, whose functions answer for the earlier
    ; ones', as the reference finds them by name.
    (let current container)
    (while true
      (let interfaces (call (. types interfaces-of) current))
      (if (call same-decl (call class-ref types current) decl)
        (return current)
      )
      (let found no-type)
      (for (in interface interfaces)
        (if (call same-decl (call class-ref types interface) decl)
          (= found interface)
        )
      )
      (if (!= found no-type)
        (return found)
      )
      (let base (call (. types base-of) current))
      (if (not base)
        (return no-type)
      )
      (= current base)
    )
  )
  (fn-expr _ first-arg TypeId
    (param type TypeId)
    (match ([] (. types rows) type)
      (case (call .type-class row)
        (if-expr (!= (. row args count) 0) (call (. types child-type) (. row args) 0) no-type)
      )
      (default
        no-type
      )
    )
  )
  (fn-do _ closure-type TypeId
    (param id SyntaxId)
    (let row ([] (. bindings bindings) (. frame binding)))
    (for (in offset (..< 0 (. row nested count)))
      (let nested ([] (. bindings nested) (+ (. row nested start) offset)))
      (if (== (. nested syntax) id)
        (for (in index (..< 0 (. nested captures count)))
          (if (call holds-tested (. ([] (. bindings captures) (+ (. nested captures start) index)) slot))
            (call decline id)
            (return invalid-type)
          )
        )
        (if (!= (. nested captures count) 0)
          (call (. frame check-allocates) id)
        )
        (return (call intern-nested (. nested decl)))
      )
    )
    (call decline id)
    (return invalid-type)
  )
  (fn-do _ note-case _
    (param site SyntaxId)
    (param about TypeId)
    (param name Atom)
    ; Plans a node that names a case of a union as that case, by its number.
    (let completion (call (. types completion-of) about))
    (if (!= (. completion intrinsic) .union)
      (if (== (call (. facts plan-of) instance site) .plan-case)
        (call (. facts set-plan) instance site .plan-none)
      )
      (return)
    )
    (for (in offset (..< 0 (. completion cases count)))
      (let fact ([] (. types cases) (+ (. completion cases start) offset)))
      (if (and (. fact name) (== (!! (. fact name)) name))
        (call (. facts set-case) instance site (as offset U32) .plan-case)
        (return)
      )
    )
  )
  (fn-do _ refuse-error-truth Bool
    (param condition SyntaxId)
    (param type TypeId)
    (if (or (!= (call (. types intrinsic-of) type) .union) (call all (call (. types cases-of) type) (:where (not (call is-raised (. each type))))))
      (return false)
    )
    (let advice "test it with \"is Error\", or take it apart with \"match\"")
    (call (. frame diagnose)
      (block
        (arg condition)
        (arg .stated)
        (arg
          (call (. program store-atom)
            (block
              (arg (str "A value that may be an error, as \"catch\" gives, has no truth; " advice))
            )
          )
        )
      )
    )
    (return true)
  )
  (fn-do _ note-truthiness _
    (param site SyntaxId)
    (param condition SyntaxId)
    (param type TypeId)
    (param is-right Bool (= false))
    ; A value tested as a condition. One of a class or a text is asked whether it is empty, and
    ; the call is recorded at the site as the test: of the site's own value, or of an operand of
    ; the site when the condition is another node. `is-right` says the operand is the right one.
    ; A tuple, a struct, a table or a builder that says whether it is empty, as an array does, is
    ; asked too. A function value has no truth, nor has an object of a class, or a value of a tuple,
    ; a struct, a table or a builder, that does not say whether it is empty, which is reported at
    ; the site as `!` not defined for it. A value that may be an error, as `catch` gives, or a value
    ; of an interface has none either, which is reported at the condition with what to write
    ; instead.
    (call forget-carried condition)
    (if (or (== type invalid-type) (== type no-type))
      (return)
    )
    (let negation (call (. program store-atom) "!"))
    (if (== type (. types void-type))
      (call (. frame diagnose) site .illegal-operation negation type)
      (return)
    )
    (return-if (if (call refuse-error-truth condition type)))
    (let completion (call (. types completion-of) type))
    (if (== (. completion intrinsic) .interface)
      (let shown (call type-source types type))
      (call (. frame diagnose)
        (block
          (arg condition)
          (arg .stated)
          (arg (call (. program store-atom) (str shown " has no truth to test; read the values it gives instead")))
        )
      )
      (return)
    )
    (if (or (== (. completion intrinsic) .closure) (== (. completion intrinsic) .binding))
      (call (. frame diagnose) site .illegal-operation negation type)
      (return)
    )
    (let valued
      (scope (or (== (. completion intrinsic) .tuple) (== (. completion intrinsic) .struct) held)
        (lazy held (or (== (. completion intrinsic) .table) (== (. completion intrinsic) .immutable-table) (== (. completion intrinsic) .array-builder)))
      )
    )
    (if (and (!= (. completion intrinsic) .class) (!= (. completion intrinsic) .string) (not valued))
      (return)
    )
    (if (and (== (. completion intrinsic) .class) (. completion is-builtin))
      (return)
    )
    (if (and (or valued (== (. completion intrinsic) .class)) (== (call (. calls demand-method) type negation) no-instance))
      (call (. frame diagnose) site .illegal-operation negation type)
      (return)
    )
    (let shapes-start (. scratch call-arguments mark))
    (let types-start (. scratch types mark))
    (let syntax-start (. scratch syntax mark))
    (let arguments (call arguments-since shapes-start types-start syntax-start (. scratch no-types)))
    (let first FactId (as (. facts calls length) FactId))
    (call (. calls method-call) site condition type negation arguments)
    (call (. facts mark-truth) instance site first (!= site condition) is-right)
    (call (. scratch syntax rewind) syntax-start)
    (call (. scratch types rewind) types-start)
    (call (. scratch call-arguments rewind) shapes-start)
  )
  (fn-do _ is-super-syntax Bool
    (param id SyntaxId)
    (match? ([] (. tree nodes) id)
      (case .node-identifier
        (let resolution (call (. bindings resolution-of) (. frame binding) id))
        (if (== (. resolution kind) .resolve-slot)
          (return (== (. ([] (. bindings slots) (. resolution slot)) kind) .slot-super))
        )
      )
    )
    (return false)
  )
  (fn-do _ infer-symbol TypeId
    (param id SyntaxId)
    (param name Atom)
    ; A case named by its symbol alone, of the type its name alone gives. Where no type the module
    ; can name has it, it is of one of the program's that has it until the type expected of it
    ; settles it (`leave-unfound`), and where none has it, it is not found.
    (let owner (call anonymous-symbol id name))
    (if (== owner no-type)
      (= owner (call symbol-class types module name))
    )
    (if (!= owner invalid-type)
      (call note-enum-case owner name id)
      (return owner)
    )
    (= owner (call program-symbol-class types name))
    (if (== owner invalid-type)
      (call (. frame diagnose) id .stated (call (. program store-atom) "Case not found"))
      (return invalid-type)
    )
    (call note-enum-case owner name id false)
    (call (. calls leave-unfound) id)
    (return owner)
  )
  (fn-do _ infer-armed-symbol TypeId
    (param id SyntaxId)
    (param name Atom)
    ; A case named by its symbol alone that gives an arm of a match its value: of the type expected
    ; of the match where it has the case or another that converts to it does (`contextual-symbol`),
    ; as the reference casts each arm to that type, else as any other.
    (let owner (call contextual-symbol types relations (. arming expected) name module))
    (if (== owner invalid-type)
      (return (call infer-symbol id name))
    )
    (call note-enum-case owner name id)
    (call note-unsettled id (. arming expected))
    (return owner)
  )
  (fn-do _ symbol-sharers _
    (param expr SyntaxId)
    (param owners (list TypeId))
    ; The types the module can name that have the case an expression names by its symbol alone,
    ; where no union of anonymous cases has it: none for any other expression.
    (let name (call (. tree symbol-of) expr))
    (if (not name)
      (return)
    )
    (let unions (list TypeId))
    (let labels (list Atom))
    (call symbol-unions name unions labels)
    (if (== (. unions length) 0)
      (call symbol-owners types module name owners)
    )
  )
  (fn-do _ shared-symbol Bool
    (param expr SyntaxId)
    ; Whether an expression names a case by its symbol alone that several types the module can name
    ; have, where no union of anonymous cases has it.
    (let owners (list TypeId))
    (call symbol-sharers expr owners)
    (return (> (. owners length) 1))
  )
  (fn-do _ loose-symbol Bool
    (param expr SyntaxId)
    ; Whether an expression names a case by its symbol alone that several types have
    ; (`shared-symbol`), typed as the one its name alone gives: as the reference leaves it, of none
    ; of them until a cast settles it.
    (let owners (list TypeId))
    (call symbol-sharers expr owners)
    (return (and (> (. owners length) 1) (== (call (. facts node-type) instance expr) ([] owners (- (. owners length) 1)))))
  )
  (fn-do _ note-loose _
    (param expr SyntaxId)
    ; Notes a case named by its symbol alone that is used with no cast to settle which type's it is,
    ; to report as the reference reports one it never casts (`settle-later`).
    (if (call loose-symbol expr)
      (call (. calls settle-later) expr (!! (call (. tree symbol-of) expr)))
    )
  )
  (fn-do _ note-unsettled _
    (param expr SyntaxId)
    (param expected TypeId)
    (param explicit Bool (= false))
    ; Notes a case named by its symbol alone that a cast to the type expected of it leaves of no one
    ; type (`keeps-symbol`).
    (let name (call (. tree symbol-of) expr))
    (if (and name (call (. calls keeps-symbol) expr (call (. facts node-type) instance expr) expected name explicit))
      (call note-loose expr)
    )
  )
  (fn-expr _ argument-shape CallArgument
    (param name (? Atom))
    (param optional Bool)
    (param expr SyntaxId)
    (call CallArgument name optional false false false symbol (call (. conversions literal-of) expr) other (call (. conversions unit-literal-of) expr))
    (where
      (lazy chosen (call symbol-choice expr))
      (lazy symbol (if-expr (!= chosen 0) (call (. tree symbol-of) chosen) (call (. tree argument-symbol) expr)))
      (lazy other (only-if (call (. tree symbol-of) (call (. tree other-side) expr)) (if (!= chosen 0))))
    )
  )
  (fn-do _ symbol-choice SyntaxId
    (param expr SyntaxId)
    (match? ([] (. tree nodes) expr)
      (case (call .node-binary-expression row)
        (if (and (== (. row op) .else-op) (call (. tree symbol-of) (. row rhs)))
          (match? ([] (. tree nodes) (. row lhs))
            (case (call .node-binary-expression side)
              (let type (call (. facts node-type) instance (. row rhs)))
              (let agrees (and (!= type invalid-type) (== type (call (. facts node-type) instance (. side lhs)))))
              (if (and (== (. side op) .if-op) (call (. tree symbol-of) (. side lhs)) agrees)
                (return (. side lhs))
              )
            )
          )
        )
      )
    )
    (return 0)
  )
  (fn-do _ note-symbol-arm _
    (param about TypeId)
    (param arm SyntaxId)
    (call (. facts replace-node-type) instance arm about)
    (call note-enum-case about (!! (call (. tree symbol-of) arm)) arm)
  )
  (fn-expr _ declares-error Bool
    (param declared (of RowRange TypeId))
    (param error TypeId)
    (call some (..< 0 (. declared count)) (:where (call is-subtype types error (call (. types child-type) declared each))))
  )
  (fn-do _ run-within (list Narrowed)
    (param callee InstanceId)
    (param around Checker)
    (param nested Bool (= false))
    ; Types an instance written in another under the checker `around` of that one, in place where
    ; `nested`, as a closure, a task, a region or a body typed in place is. Answers what a region's
    ; body left the locals it captures as (`region-left`), which holds until another checker is made.
    (let checker (call checker-for session callee around false nested))
    (call (. checker run))
    (call (. checker retire))
    (return (. checker region-left))
  )
  (fn-do _ settled Checker
    (param enclosing InstanceId)
    ; A checker for an instance a closure was written in that has finished: it holds each
    ; local as the instance left it, and runs nothing. A closure written in a closure has one
    ; for each instance out to the first that is still running.
    (let around (. ([] (. instances rows) enclosing) enclosing))
    (let writer (only-if (?? (call definer around) (call settled around)) (if (!= around no-instance))))
    (let stand (call checker-for session enclosing writer true))
    (call (. stand prepare))
    (for (in offset (..< 0 (. stand frame slots count)))
      (let type (call (. facts slot-type) enclosing offset))
      (if (!= type no-type)
        (call (. stand frame assign) (+ (. stand frame slots start) offset) type)
      )
    )
    (return stand)
  )
  (fn-do _ dismiss _
    ; Closes a settled checker, and then those made around it.
    (let around outer)
    (call close)
    (call retire)
    (if (and around (. around probing))
      (call (. around dismiss))
    )
  )
  (fn-do _ decline _
    (param id SyntaxId)
    (call (. frame diagnose) id .not-supported)
  )
  (fn-do _ infer-integer TypeId
    (param id SyntaxId)
    (param text String)
    (param unit (? Atom))
    ; An integer written with a builtin number's suffix is the bit pattern of that width, kept to
    ; its low bits, while one written with a unit a module declares must fit the unit's number type,
    ; as a plain integer given to it must.
    (let literal (call parse-integer-literal text))
    (let target (if-expr unit (call literal-unit id text unit) (call (. types type-row) .uint64)))
    (if (and unit (!= target invalid-type) (. ([] (. types completions) target) has-variables))
      (let message (call (. program store-atom) "Unit types must be numeric and unqualified"))
      (call (. frame diagnose) id .stated message)
      (call (. facts inset-diagnostic) (as (. text length) U32))
      (return invalid-type)
    )
    (if (and (!= target invalid-type) (or (. literal overflow) unfit))
      (let shown (call (. program store-atom) (call decimal-text text)))
      (call (. frame diagnose) id .literal-does-not-fit shown no-type target)
      (return invalid-type)
    )
    (lazy unfit (and unit declared (not (call literal-fits-target types literal (call builtin-number types target)))))
    (lazy declared (!= (call builtin-number types target) target))
    (if unit
      (return (call unit-literal id target))
    )
    (return (call magnitude-type types literal))
  )
  (fn-do _ infer-unit-float TypeId
    (param id SyntaxId)
    (param text String)
    (param unit Atom)
    ; A number with a fraction written with a unit, which must hold fractions where it is a number
    ; of the unit's own.
    (let target (call literal-unit id text unit))
    (if (or (== target invalid-type) (call declares-constructor target))
      (return (call unit-literal id target))
    )
    (let number (call builtin-number types target))
    (if (call is-integer-kind (call (. types intrinsic-of) number))
      (let shown (call type-short-name types target))
      (let held (if-expr (== number target) "" (str ", as " (call type-short-name types number) " does")))
      (let message
        (paragraph
          (str shown " holds whole numbers" held ", so " text (. unit text) " cannot be written; write a whole number")
        )
      )
      (call (. frame diagnose) id .stated (call (. program store-atom) message))
      (return invalid-type)
    )
    (return (call unit-literal id target))
  )
  (fn-do _ unit-literal TypeId
    (param id SyntaxId)
    (param unit-type TypeId)
    ; A number written with a unit is of the unit's type. A unit that declares a constructor is
    ; constructed from the number, and the literal is what the constructor returns; one that
    ; declares none is a number, or no number can be written in it.
    (if (== unit-type invalid-type)
      (return invalid-type)
    )
    (if (and (call is-unit-class types unit-type) (not (call declares-constructor unit-type)))
      (if (not (call intrinsic-is-numeric (call (. types intrinsic-of) (call builtin-number types unit-type))))
        (let shown (call type-short-name types unit-type))
        (let message
          (paragraph
            (str shown " is no number and declares no constructor that takes one, so no number can be written in its unit; declare " shown " as a number type")
          )
        )
        (call (. frame diagnose) id .stated (call (. program store-atom) message))
        (return invalid-type)
      )
      (return unit-type)
    )
    (let shapes-start (. scratch call-arguments mark))
    (call (. scratch call-arguments push) (call CallArgument null false false false false))
    (let types-start (. scratch types mark))
    (call (. scratch types push) unit-type)
    (let syntax-start (. scratch syntax mark))
    (call (. scratch syntax push) id)
    (let arguments (call arguments-since shapes-start types-start syntax-start (. scratch no-types)))
    (let result (call (. calls construction-on) id unit-type arguments))
    (call (. scratch syntax rewind) syntax-start)
    (call (. scratch types rewind) types-start)
    (call (. scratch call-arguments rewind) shapes-start)
    (return result)
  )
  (fn-do _ declares-constructor Bool
    (param type TypeId)
    (match? ([] (. types rows) type)
      (case (call .type-class row)
        (let module ([] (. program modules) (. row module)))
        (match? ([] (. module decls) (. row decl))
          (case (call .decl-class cls)
            (if (== (. cls members count) 0)
              (return false)
            )
            (for (in member ([] (. module member-pool) (. cls members)))
              (match? ([] (. module decls) member)
                (case (call .decl-function fn)
                  (if (== (. fn kind) .constructor-decl)
                    (return true)
                  )
                )
              )
            )
          )
        )
      )
    )
    (return false)
  )
  (fn-do _ literal-unit TypeId
    (param id SyntaxId)
    (param text String)
    (param unit (? Atom))
    ; The type the unit of a literal names. A unit that names no type is reported where it is
    ; written, past the digits.
    (let target (call unit-class unit))
    (if (== target invalid-type)
      (call (. frame diagnose) id .stated (call (. program store-atom) "Type not found"))
      (call (. facts inset-diagnostic) (as (. text length) U32))
    )
    (return target)
  )
  (fn-do _ unit-class TypeId
    (param unit (? Atom))
    (if (not unit)
      (return invalid-type)
    )
    (let found (call (. types type-named) module unit (call (. types env-frame))))
    (if (!= found invalid-type)
      (call (. types complete) found)
    )
    (return found)
  )
  (fn-do _ reads-uninitialized Bool
    (param owner ModuleId)
    (param decl DeclId)
    ; A module's globals take their values in the order they are declared, so the value of one
    ; cannot read a later one whose own value has yet to be computed. A global each task or each
    ; thread holds its own of, or that `do with` binds, takes its value before every other global
    ; of its module, so its value reads them checked, as a function does; it cannot read a later
    ; one of its own kind (see `reads-later-local`).
    (if (or (== initializing 0) (!= owner module) (<= decl initializing))
      (return false)
    )
    (if (call initializes-early)
      (return (call reads-later-local owner decl))
    )
    (match? ([] (. ([] (. program modules) owner) decls) decl)
      (case (call .decl-property row)
        (if (or (!= (. row owner) 0) (== (. row value) 0) (. row is-lazy) (call is-task-local owner decl))
          (return false)
        )
        (if (or (call is-thread-local owner decl) (call is-stack-global owner decl))
          (return false)
        )
        (return (not (call is-constant-global owner decl)))
      )
    )
    (return false)
  )
  (fn-expr _ reads-later-local Bool
    (param owner ModuleId)
    (param decl DeclId)
    ; Whether the value of a global each task or each thread holds its own of, or that `do with`
    ; binds, reads a later one of its kind, which takes its value after it: those each thread holds
    ; take theirs in the order they are declared, and so do the others together.
    (if-expr (call is-thread-local module initializing) (call is-thread-local owner decl) later-other)
    (where
      (lazy later-other (or (call is-task-local owner decl) (call is-stack-global owner decl)))
    )
  )
  (fn-do _ demand-global TypeId
    (param id SyntaxId)
    (param owner ModuleId)
    (param decl DeclId)
    ; The type of a global a name reads or writes. The use of one each task or each thread holds
    ; its own of is recorded once its value is typed, as TypeScript makes that value once it has
    ; compiled it.
    (let type (call demand-property owner decl))
    (if (or (call is-task-local owner decl) (call is-thread-local owner decl) (call is-stack-global owner decl))
      (call (. facts local-global-uses append) (call LocalGlobalUse instance id owner decl))
    )
    (return type)
  )
  (fn-do _ is-lazy-global Bool
    (param owner ModuleId)
    (param decl DeclId)
    ; Whether a global takes its value where it is first read.
    (match? ([] (. ([] (. program modules) owner) decls) decl)
      (case (call .decl-property row)
        (return (and (== (. row owner) 0) (. row is-lazy) (== (. row decoration) null)))
      )
    )
    (return false)
  )
  (fn-do _ is-task-local Bool
    (param owner ModuleId)
    (param decl DeclId)
    ; Whether a global is one each task holds its own of.
    (match? ([] (. ([] (. program modules) owner) decls) decl)
      (case (call .decl-property row)
        (return (and (!= (. row decoration) null) (== (. row decoration text) "task")))
      )
    )
    (return false)
  )
  (fn-do _ is-thread-local Bool
    (param owner ModuleId)
    (param decl DeclId)
    ; Whether a global is one each thread holds its own of.
    (match? ([] (. ([] (. program modules) owner) decls) decl)
      (case (call .decl-property row)
        (return (and (!= (. row decoration) null) (== (. row decoration text) "thread")))
      )
    )
    (return false)
  )
  (fn-do _ is-stack-global Bool
    (param owner ModuleId)
    (param decl DeclId)
    ; Whether a global is one `do with` binds.
    (match? ([] (. ([] (. program modules) owner) decls) decl)
      (case (call .decl-property row)
        (return (and (!= (. row decoration) null) (== (. row decoration text) "stack")))
      )
    )
    (return false)
  )
  (fn-do _ is-constant-global Bool
    (param owner ModuleId)
    (param decl DeclId)
    ; A global whose value is a literal laid down before anything runs: a number or a string, of a
    ; numeric type or String when it declares one. Every other global takes its value when its
    ; module starts, or, kept for each task or thread, as the task or thread starts. One `do with`
    ; could bind is laid down so only where nothing binds it (`ProgramTables`).
    (let target ([] (. program modules) owner))
    (match? ([] (. target decls) decl)
      (case (call .decl-property row)
        (if (and (!= (. row decoration) null) (!= (. row decoration text) "stack"))
          (return false)
        )
        (let worded (and (!= (. row value) 0) (call (. target tree is-string-literal) (. row value))))
        (if (and (!= (. row value) 0) (not worded) (not (call is-constant-literal owner (. row value))))
          (return false)
        )
        (if (== (. row type-syntax) 0)
          (return (!= (. row value) 0))
        )
        (let env (call (. types env-frame)))
        (let declared (call (. types evaluate-type) owner (. target tree) (. row type-syntax) env))
        (if worded
          (return (== declared (. types string-type)))
        )
        (return (and (!= declared invalid-type) (call is-numeric types declared)))
      )
    )
    (return false)
  )
  (fn-do _ is-constant-literal Bool
    (param owner ModuleId)
    (param value SyntaxId)
    ; A number, a negated number, `true` or `false`, such a literal cast to a numeric type, or the
    ; least or greatest value of one. A number written with a unit that declares a constructor is
    ; what the constructor makes, and no literal.
    (let source (. ([] (. program modules) owner) tree))
    (match? ([] (. source nodes) value)
      (case (call .node-integer-syntax row)
        (return (call plain-unit owner (. row unit)))
      )
      (case (call .node-float-syntax row)
        (return (call plain-unit owner (. row unit)))
      )
      (case (call .node-unary-expression row)
        (return (and (== (. row op) .negative-op) (call (. source is-number) (. row operand))))
      )
      (case (call .node-identifier row)
        (return (or (== (. row name) (. types true-atom)) (== (. row name) (. types false-atom))))
      )
      (case (call .node-cast-expression row)
        (return (and (call is-constant-literal owner (. row lhs)) (call names-numeric owner (. row rhs))))
      )
      (case (call .node-get-expression row)
        (let bound (or (== (. row name text) "min") (== (. row name text) "max")))
        (return (and bound (call names-numeric owner (. row object))))
      )
    )
    (return false)
  )
  (fn-expr _ plain-unit Bool
    (param owner ModuleId)
    (param unit (? Atom))
    (case? (not unit)
      true
    )
    (default
      (or (== found invalid-type) (not (call declares-constructor found)))
    )
    (where
      (lazy found (call (. types type-named) owner unit (call (. types env-frame))))
    )
  )
  (fn-do _ names-numeric Bool
    (param owner ModuleId)
    (param type-syntax SyntaxId)
    (let source (. ([] (. program modules) owner) tree))
    (match? ([] (. source nodes) type-syntax)
      (case .node-type-identifier
        (let named (call (. types evaluate-type) owner source type-syntax (call (. types env-frame))))
        (return (and (!= named invalid-type) (call is-numeric types named)))
      )
    )
    (return false)
  )
  (fn-do _ guards-read Bool
    (param id SyntaxId)
    (param owner ModuleId)
    (param decl DeclId)
    ; Whether reading a global can fail where the read stands. One that `do with` binds is unbound
    ; outside every binding of it. One each task or each thread holds its own of has its value as
    ; the task or the thread starts. A lazy one is evaluated by the first read, which fails when
    ; its value is being evaluated already. Any other that is not a constant is checked for its
    ; value wherever it is read outside its own module's statements. The value of a class's
    ; property, which a constructor runs, and of a lazy global, which its first read runs, are
    ; outside them: either may run before the module's globals have their values, as may the
    ; value of a global each task or each thread holds its own of, or that `do with` binds.
    (if (call is-stack-local id)
      (for (in scope (. facts stack-scopes))
        (if (and (== (. scope instance) instance) (== (. scope module) owner) (== (. scope decl) decl))
          (if (and (>= id (. scope first)) (<= id (. scope last)))
            (return false)
          )
        )
      )
      (return true)
    )
    (if (or (call is-task-local owner decl) (call is-thread-local owner decl))
      (return false)
    )
    (match? ([] (. ([] (. program modules) owner) decls) decl)
      (case (call .decl-property row)
        (if (and (== (. row owner) 0) (. row is-lazy))
          (return true)
        )
      )
    )
    (if (and (. frame declaration is-main) (== owner module) (not (call is-deferred-value)) (not (call initializes-early)))
      (return false)
    )
    (if (!= (call core-literal-type owner decl) no-type)
      (return false)
    )
    (return (not (call is-constant-global owner decl)))
  )
  (fn-do _ is-deferred-value Bool
    (if (not (call (. instances is-initializer) instance))
      (return false)
    )
    (match? ([] (. ([] (. program modules) module) decls) (. ([] (. instances rows) instance) initializer))
      (case (call .decl-property row)
        (return (or (!= (. row owner) 0) (. row is-lazy)))
      )
    )
    (return false)
  )
  (fn-do _ note-guarded _
    (param id SyntaxId)
    (param owner ModuleId)
    (param decl DeclId)
    ; Plans a read of a global as a checked one: the reader may panic there.
    (call (. instances mark-may-panic) instance)
    (call (. facts set-plan) instance id .plan-guarded-read)
    (call (. facts global-uses append) (call GlobalUse instance id owner decl))
  )
  (fn-do _ lacks-self Bool
    ; Whether the function being checked runs without a value of the type it belongs to: a static
    ; method, or the constructor of an interface, which has no value to construct.
    (if outer
      (return (call (. outer lacks-self)))
    )
    (match? ([] (. ([] (. program modules) module) decls) (. frame decl))
      (case (call .decl-function fn)
        (if (. fn is-static)
          (return true)
        )
        (let self (. frame self-type))
        (if (and (call is-constructor-kind (. fn kind)) (!= self no-type) (!= self invalid-type))
          (return (== (call (. types intrinsic-of) self) .interface))
        )
      )
    )
    (return false)
  )
  (fn-do _ lacks-base Bool
    (if outer
      (return (call (. outer lacks-base)))
    )
    (let self (. frame self-type))
    (if (or (== self no-type) (== self invalid-type))
      (return false)
    )
    (call (. types complete) self)
    (return (== (call (. types base-of) self) null))
  )
  (fn-do _ read-received Found
    (param id SyntaxId)
    (param name Atom)
    (param want Want)
    ; A name read by its name alone in the body of a markup element that is a member of the
    ; element, or of an element it is in, the innermost first, as the binder found it: the
    ; reference reads the property of that element's object (`received-parent`), or names its
    ; event. A member that is neither a stored property nor an event, one read where no element is
    ; being built, or an event read in a function written in the element's body, has no shape here,
    ; but such an event used as a value is reported as `refuse-event-value` says, and one stored in
    ; a property or given to a call is kept until the property or the parameter is known
    ; (`store-event`, `settle-kept-arguments`).
    (let parent (call received-parent id name))
    (if (== parent no-type)
      (call decline id)
      (return (call Found invalid-type))
    )
    (let place (call property-named parent name))
    (if (and (not place) (!= (. (call (. bindings resolution-of) (. frame binding) id) slot) no-slot))
      (let found (call event-of parent name))
      (if (not found)
        (call decline id)
        (return (call Found invalid-type))
      )
      (let endpoint (call endpoint-of found))
      (if (call misused-event id endpoint want)
        (call refuse-event-value id (. found owner) name)
        (return (call Found invalid-type))
      )
      (if (and (!= endpoint invalid-type) (call (. want asks) .want-store))
        (return (call Found endpoint no-type (call found-event found) true))
      )
      (if (and (!= endpoint invalid-type) (. argument-typing unknown-callee))
        (return (call Found endpoint))
      )
      (let addressed (or (== (. found key) no-type) (!= (. found address) 0)))
      (if (and (!= endpoint invalid-type) (call (. want asks) .want-argument) (. argument-typing keeps) addressed)
        (+= endpoint-arguments id)
        (+= endpoint-events found)
        (+= kept-arguments id)
        (return (call Found endpoint))
      )
      (call decline id)
      (return (call Found invalid-type))
    )
    (if (not place)
      (return (call read-event id parent name want))
    )
    (if (== (. ([] (. types properties) place) storage-kind) .storage-getter)
      (call decline id)
      (return (call Found invalid-type))
    )
    (return (call read-property id id parent name want))
  )
  (fn-do _ misused-event Bool
    (param id SyntaxId)
    (param endpoint TypeId)
    (param want Want)
    ; Whether a node that names an event is used where a value is, as the reference finds none of
    ; an event: the value of a declaration that states no type, or one the event's `Broadcastable`
    ; is not (`takes-endpoint`), the value assigned to a local or cast to a type it is not, the
    ; value of an assigning operator, an item of a list or a tuple, what a line prints, an operand
    ; of an arithmetic, comparing or joining operator, or the object a member is read from or
    ; called on.
    (let holder (call (. tree holder-of) id))
    (let escaping (call (. want asks) .want-escape))
    (match? ([] (. tree nodes) holder)
      (case .node-declare
        (return (or (not escaping) (== (. want type) no-type) (not (call takes-endpoint endpoint (. want type)))))
      )
      (case (call .node-assign row)
        (if (!= (. row rhs) id)
          (return false)
        )
        (return
          (scope (or (!= (. row op) .eq-op) (and escaping (or typeless (not (call takes-endpoint endpoint (. want type))))))
            (lazy typeless (== (. want type) no-type))
          )
        )
      )
      (case (call .node-cast-expression row)
        (return
          (scope (and cast-escapes (!= (. want type) no-type) (not (call takes-endpoint endpoint (. want type))))
            (lazy cast-escapes (and (== (. row lhs) id) escaping))
          )
        )
      )
      (case .node-list-syntax
        (return true)
      )
      (case .node-tuple-syntax
        (return true)
      )
      (case .node-print
        (return true)
      )
      (case (call .node-binary-expression row)
        (return
          (scope (or computes (== (. row op) .concat-op) (== (. row op) .concat-string-op))
            (lazy computes (or (call is-arithmetic (. row op)) (call is-comparison (. row op))))
          )
        )
      )
      (case (call .node-get-expression row)
        (return (== (. row object) id))
      )
    )
    (return false)
  )
  (fn-expr _ takes-endpoint Bool
    (param endpoint TypeId)
    (param wanted TypeId)
    ; Whether an event's `Broadcastable` becomes a type without a converter, as the reference casts
    ; an event's endpoint only to an interface it has.
    (case? (or (== endpoint invalid-type) (== wanted invalid-type))
      true
    )
    (default
      (and legal-plain not-common (!= kind .relation-string-cast) (!= kind .relation-fromverter))
    )
    (where
      (lazy kind (. (call (. conversions compare-held) endpoint wanted) kind))
      (lazy legal-plain (and (!= kind .relation-illegal) (!= kind .relation-converter)))
      (lazy not-common (!= kind .relation-common-converter))
    )
  )
  (fn-do _ endpoint-of TypeId
    (param event NamedEvent)
    ; The `Broadcastable` an event's endpoint is.
    (return (call (. types well-known-type-of) "core/stream" "Broadcastable" (. event payload)))
  )
  (fn-do _ refuse-event-value _
    (param id SyntaxId)
    (param owner TypeId)
    (param name Atom)
    ; Reports a node that names an event used as a value, which an event is not.
    (let message
      (scope (str "\"" (. name text) "\" is an event of " owner-name "; it cannot be used as a value")
        (lazy owner-name (call type-short-name types owner))
      )
    )
    (call (. frame diagnose) id .stated (call (. program store-atom) message))
  )
  (fn-do _ refuse-event-read _
    (param id SyntaxId)
    (param owner TypeId)
    (param name Atom)
    ; Reports an event read with `<-`, as a channel is: an event gives each value to the
    ; subscribers it has as it is published, and keeps none to be read.
    (let written (. name text))
    (match? ([] (. tree nodes) id)
      (case (call .node-get-expression row)
        (match? ([] (. tree nodes) (. row object))
          (case (call .node-identifier object)
            (= written (str "(. " (. object name text) " " (. name text) ")"))
          )
        )
      )
    )
    (let owner-name (call type-short-name types owner))
    (let message
      (paragraph
        (str "\"" (. name text) "\" is an event of " owner-name ", which gives each value to its subscribers and keeps none to read with \"<-\"; hear the next one with \"(for (on value " written ") …)\", and end the loop with \"break\"")
      )
    )
    (call (. frame diagnose) id .stated (call (. program store-atom) message))
  )
  (fn-do _ read-unmade TypeId
    (param id SyntaxId)
    (param name Atom)
    (param slot SlotId)
    ; The name of a markup element of a class's markup read in a closure the markup makes before
    ; the element is made: the reference reads the receiver's property of the name when the
    ; closure runs (`plan-element-property`). In a function's markup, the closure reads the local
    ; that keeps the element when it runs (`read-later-element`), as it does the element it is an
    ; attribute of.
    (let self (. frame self-type))
    (if (and (!= self no-type) (!= self invalid-type) (not (call lacks-self)) (== (call (. types intrinsic-of) self) .class))
      (let place (call property-named self name))
      (if (and place (call names-element types ([] (. types properties) place)))
        (call (. instances mark-may-panic) instance)
        (call (. facts set-plan) instance id .plan-element-property)
        (return (. (call read-property id id self name) type))
      )
    )
    (if (and outer (call (. frame is-captured) slot) (call awaits-element slot))
      (return (call read-later-element id name slot))
    )
    (call decline id)
    (return invalid-type)
  )
  (fn-expr _ received-parent TypeId
    (param id SyntaxId)
    (param name Atom)
    ; The object a member read by its name alone in the body of a markup element is read from: in a
    ; function written in the body, that of the element the binder found, kept where it was made,
    ; and else the innermost element being built that has the member (`received-owner`).
    (case? (== kept no-slot)
      (call received-owner name)
    )
    (case? (or (== parent no-type) (== parent invalid-type) (!= (call (. types intrinsic-of) parent) .class))
      no-type
    )
    (case? (and place (call names-element types ([] (. types properties) place)))
      no-type
    )
    (default
      parent
    )
    (where
      (lazy kept (. (call (. bindings resolution-of) (. frame binding) id) slot))
      (lazy parent (call (. frame slot-type) kept))
      (lazy place (call property-named parent name))
    )
  )
  (fn-do _ received-owner TypeId
    (param name Atom)
    ; The innermost markup element being built whose class has a property or an event of a name,
    ; or no type: a property the markup of the element's class declares for an element is hidden
    ; there.
    (let position (. content-parents length))
    (while (!= position 0)
      (-= position 1)
      (let parent ([] content-parents position))
      (if (!= (call (. types intrinsic-of) parent) .class)
        (continue)
      )
      (let place (call property-named parent name))
      (if (and place (not (call names-element types ([] (. types properties) place))))
        (return parent)
      )
      (if (and (not place) (call declares-event parent name))
        (return parent)
      )
    )
    (return no-type)
  )
  (fn-do _ infer-identifier Found
    (param id SyntaxId)
    (param name Atom)
    (param want Want (= (call Want)))
    ; The type of a name alone, as what the binder resolved it to gives it: a local, a global, a
    ; member, a function or a type. A name the binder left for a style to resolve, which no style
    ; sheet's slot nor `inherit` is, is not found, as the reference reports it where no case of the
    ; property's union took it (`style-value`). The name of a slot outlet that is a markup branch
    ; region, which the reference builds a node of its own for where it is read, is declined.
    (let resolution (call (. bindings resolution-of) (. frame binding) id))
    (if (!= (/and/ (. resolution flags) (. ResolutionFlag resolution-received)) 0)
      (return (call read-received id name want))
    )
    (match (. resolution kind)
      (case= .resolve-slot
        (if (and (!= (. finally limit) 0) (> (. ([] (. bindings slots) (. resolution slot)) syntax) (. finally limit)))
          (call (. frame diagnose) id .stated (call (. program store-atom) "Name not found"))
          (return (call Found invalid-type))
        )
        (if (!= (. ([] (. bindings slots) (. resolution slot)) getter) 0)
          (return (call Found (call read-getter id (. resolution slot))))
        )
        (if (and (call (. bindings is-placed) (. resolution slot)) (!= (call outlet-choice placed-group) no-type))
          (let message
            (paragraph
              (str "Outlet \"" (. name text) "\" is not read by its name where its slot is filled inside an if or match")
            )
          )
          (call (. frame diagnose) id .stated (call (. program store-atom) message))
          (return (call Found invalid-type))
        )
        (lazy placed-group (. ([] (. bindings slots) (. resolution slot)) group))
        (if (and (!= (. unbuilt length) 0) (!= (call (. unbuilt find) (. resolution slot)) null))
          (if (or (== (. resolution slot) building) (!= (call (. held find) (. resolution slot)) null))
            (let message
              (paragraph
                (str "Named markup element \"" (. name text) "\" is read before its markup constructs it")
              )
            )
            (call (. frame diagnose) id .stated (call (. program store-atom) message))
            (return (call Found invalid-type))
          )
          (if (not (call raise-early id (. resolution slot)))
            (call decline id)
            (return (call Found invalid-type))
          )
        )
        (if (and (== (. ([] (. bindings slots) (. resolution slot)) kind) .slot-this) (call in-eager))
          (let message "Illegal to reference 'this' in eager properties or properties ")
          (call (. frame diagnose) id .stated (call (. program store-atom) (++ message "referenced by them")))
          (return (call Found invalid-type))
        )
        (if (and (== (. ([] (. bindings slots) (. resolution slot)) kind) .slot-this) (call lacks-self))
          (call (. frame diagnose) id .stated (call (. program store-atom) "Required self not defined"))
          (return (call Found invalid-type))
        )
        (if (and (== (. ([] (. bindings slots) (. resolution slot)) kind) .slot-super) (call lacks-base))
          (call (. frame diagnose) id .stated (call (. program store-atom) "super requires a base type"))
          (return (call Found invalid-type))
        )
        (if (and (== (. ([] (. bindings slots) (. resolution slot)) kind) .slot-super) (not (call (. want asks) .want-receiver)))
          (call (. frame diagnose) id .stated (call (. program store-atom) "Bare super is not a value"))
          (return (call Found invalid-type))
        )
        (if (and (call (. bindings is-placed) (. resolution slot)) (call reads-before-made id (. resolution slot)))
          (let message
            (paragraph
              (str "Named markup element \"" (. name text) "\" is read before its markup constructs it")
            )
          )
          (call (. frame diagnose) id .stated (call (. program store-atom) message))
          (return (call Found invalid-type))
        )
        (if (call precedes-declaration (. resolution slot))
          (if (or (call (. bindings is-placed) (. resolution slot)) (call awaits-element (. resolution slot)))
            (return (call Found (call read-unmade id name (. resolution slot))))
          )
          (if (call (. bindings names-machine) (. resolution slot))
            (call decline id)
            (return (call Found invalid-type))
          )
          (call (. frame diagnose) id .stated (call (. program store-atom) "Name not found"))
          (return (call Found invalid-type))
        )
        (if (and (call (. bindings is-placed) (. resolution slot)) (!= (call outlet-region placed-group) 0))
          (call decline id)
          (return (call Found invalid-type))
        )
        (call note-carried id (. resolution slot))
        (if (call wavers (. resolution slot))
          (call decline id)
          (return (call Found invalid-type))
        )
        (let read (call read-slot (. resolution slot) id))
        (if (and in-lazy (!= (call (. scratch narrowed-since) last-mark (call slot-key (. resolution slot))) no-type))
          (call (. facts note-inside-read) instance id)
        )
        (lazy in-lazy (and (!= (. lazy-marks length) 0) (not (call (. frame is-captured) (. resolution slot)))))
        (lazy last-mark ([] lazy-marks (- (. lazy-marks length) 1)))
        (if (call is-row-item (. resolution slot) read)
          (return (call Found (call read-row-item id read)))
        )
        (if (and (not (call (. want asks) .want-pattern)) (call (. types is-pattern-func) read))
          (if (call names-given-pattern (. resolution slot))
            (if (!= (. valuing action-arm) 0)
              (call (. frame diagnose)
                (block
                  (arg (. valuing action-arm))
                  (arg .stated)
                  (arg (call (. program store-atom) "Unable to compile pattern action: Name not found"))
                )
              )
              (else
                (call (. frame diagnose) id .stated (call (. program store-atom) "Name not found"))
              )
            )
            (return (call Found invalid-type))
          )
          (if (!= (. ([] (. instances rows) instance) helper) no-type)
            (call decline id)
            (return (call Found invalid-type))
          )
        )
        (call note-case-read id (. resolution slot) read)
        (return (call Found read))
      )
      (case= .resolve-global
        (if (call reads-uninitialized (. resolution module) (. resolution decl))
          (let message (str "Global '" (. name text) "' is read before it is initialized"))
          (call (. frame diagnose) id .stated (call (. program store-atom) message))
          (return (call Found invalid-type))
        )
        (if (call is-stack-local id)
          (call (. facts stack-reads append) (call StackRead instance id (. resolution module) (. resolution decl)))
        )
        (if (call is-lazy-global (. resolution module) (. resolution decl))
          (call (. frame check-lazy-read) id (. name text))
        )
        (if (call guards-read id (. resolution module) (. resolution decl))
          (call note-guarded id (. resolution module) (. resolution decl))
        )
        (return (call Found (call demand-global id (. resolution module) (. resolution decl))))
      )
      (case= .resolve-member
        (if (and (!= theme-sheet no-type) (call sheet-has-slot (call family-root theme-sheet) name))
          (return (call Found (call read-theme id name)))
        )
        (if (and (call in-eager) (call is-accessor (. frame self-type) name))
          (let message "Illegal to reference getters in eager properties")
          (call (. frame diagnose) id .stated (call (. program store-atom) message))
          (return (call Found invalid-type))
        )
        (if (call lacks-self)
          (call (. frame diagnose) id .stated (call (. program store-atom) "Required self not defined"))
          (return (call Found invalid-type))
        )
        (if (and (not outer) (call reads-unmade name) (not (call (. instances is-initializer) instance)))
          (let message
            (paragraph
              (str "Named markup element \"" (. name text) "\" is read before its markup constructs it")
            )
          )
          (call (. frame diagnose) id .stated (call (. program store-atom) message))
          (return (call Found invalid-type))
        )
        (if (and (not outer) (call reads-unmade name) (not (call is-eager-value)) (not (call waits-in-rule)) unkept)
          (call decline id)
          (return (call Found invalid-type))
        )
        (lazy unkept (and (not (call keeps-whole name)) (not (call runs-later id))))
        (return (call read-member id name want))
      )
      (case= .resolve-function
        (if (call names-module-accessor (. resolution module) (. resolution decl))
          (return (call Found (call (. calls module-getter-call) id name)))
        )
        (if (and (call names-method (. resolution module) (. resolution decl)) (not (call lacks-self)))
          (return (call Found (call (. calls method-binding) (. frame self-type) name id)))
        )
        (return
          (call Found
            (block
              (arg
                (call (. types intern-binding)
                  (block
                    (arg .bound-function)
                    (arg (. frame module))
                    (arg (. resolution module))
                    (arg (. resolution decl))
                  )
                )
              )
            )
          )
        )
      )
      (case= .resolve-type
        (return (call Found (call type-info-of id (call (. types type-named) module name (. frame env)))))
      )
      (default
        (let bound (call (. types env-lookup) (. frame env) name))
        (if bound
          (return (call Found (call type-info-of id bound)))
        )
        (let styled (!= (/and/ (. resolution flags) (. ResolutionFlag resolution-styled)) 0))
        (if (and styled themed (not (call (. tree is-inherit) id)) (call names-sheet-slot name))
          (return (call Found (call read-theme id name)))
        )
        (lazy themed (or (!= theme-made no-type) (!= theme-sheet no-type)))
        (if (and styled unquiet (not (call (. tree is-inherit) id)) (not (call names-sheet-slot name)))
          (call (. frame diagnose) id .stated (call (. program store-atom) "Name not found"))
          (return (call Found invalid-type))
        )
        (lazy unquiet (== (/and/ (. resolution flags) (. ResolutionFlag resolution-quiet)) 0))
        (if (!= (/and/ (. resolution flags) lenient-flags) 0)
          (call decline id)
        )
        (lazy lenient-flags (/or/ (. ResolutionFlag resolution-styled) (. ResolutionFlag resolution-quiet)))
        (return (call Found invalid-type))
      )
    )
  )
  (fn-do _ note-collection-read TypeId
    (param id SyntaxId)
    (param read TypeId)
    (param want Want)
    ; A tracked read whose value is a collection, which the reference tracks the changes of too,
    ; where the read is tracked (`trackCollectionRead`): the read is noted, and the runtime's
    ; `track-collection-dependency` typed. One of an optional collection is tracked where it holds
    ; one. The container of a markup loop region (`want-observed`) is no such read: the region
    ; observes it itself. Answers the read.
    (if (or (== read invalid-type) (== read no-type) (== (. types collection-decl module) 0) (call (. want asks) .want-observed))
      (return read)
    )
    (let held (if-expr (call (. types is-optional) read) (call (. types optional-inner) read) read))
    (if (or (!= (call (. types intrinsic-of) held) .class) (== (call derived-interface held (. types collection-decl)) no-type))
      (return read)
    )
    (if (not (call demand-track-collection))
      (call decline id)
      (return invalid-type)
    )
    (+= (. facts collection-reads) (call CollectionRead instance id))
    (return read)
  )
  (fn-do _ raise-early Bool
    (param read SyntaxId)
    (param slot SlotId)
    ; Makes the object of a named markup element a block has not made yet where what makes an
    ; earlier one, or a statement of the block above it, reads its name, as the reference evaluates
    ; the name's local where it is first read, under the styles in force there. The element is not
    ; made again where it is written. Only a read made each time the element being made, or the
    ; statement, is reaches it: one a branch or a call may skip would leave the object unmade on
    ; some runs, and is declined.
    (let waited (call (. unbuilt find) slot))
    (if (or (== waited null) (== ([] awaited waited) 0))
      (return false)
    )
    (let element ([] awaited waited))
    (if (not (call reached-always read (call (. tree holder-of) element)))
      (return false)
    )
    (match? ([] (. tree nodes) element)
      (case (call .node-markup row)
        (+= held building)
        (let around building)
        (= building slot)
        (let made (call make-element element row))
        (= building around)
        (call (. held pop))
        (call assign-element slot made element)
        (= ([] unbuilt waited) no-slot)
        (= ([] awaited waited) 0)
        (call (. facts note-raised) instance 0 element read)
        (return true)
      )
    )
    (return false)
  )
  (fn-do _ reached-always Bool
    (param read SyntaxId)
    (param home SyntaxId)
    ; Whether making the markup element being made, or else running a statement of the block `home`,
    ; always evaluates a node: each node between them evaluates the one below it whenever it is
    ; evaluated, up to an argument of the element, the value of an attribute it is given, or the
    ; statement.
    (let child read)
    (let node (call (. tree holder-of) read))
    (while (!= node 0)
      (if (and (== building no-slot) (== node home))
        (return true)
      )
      (match ([] (. tree nodes) node)
        (case (call .node-markup row)
          (return (== (?? (call element-slot node (. row id)) no-slot) building))
        )
        (case (call .node-assign row)
          (if (!= (. row rhs) child)
            (return false)
          )
          (if (!= building no-slot)
            (let owner (call (. tree body-element) (call (. tree holder-of) node)))
            (match? ([] (. tree nodes) owner)
              (case (call .node-markup made)
                (return (== (?? (call element-slot owner (. made id)) no-slot) building))
              )
            )
            (return false)
          )
        )
        (case (call .node-declare row)
          (if (or (!= building no-slot) (!= (. row right) child) (. row is-lazy))
            (return false)
          )
        )
        (case (call .node-print row)
          (if (or (!= building no-slot) (!= (. row body) child))
            (return false)
          )
        )
        (case (call .node-get-expression row)
          (if (or (!= (. row object) child) (. row is-optional))
            (return false)
          )
        )
        (case (call .node-binary-expression row)
          (let skips
            (scope (or chooses (== (. row op) .and-op) (== (. row op) .or-op))
              (lazy chooses (or (== (. row op) .coalesce-op) (== (. row op) .else-op)))
            )
          )
          (if (and skips (!= (. row lhs) child))
            (return false)
          )
          (if (and (== (. row op) .if-op) (!= (. row rhs) child))
            (return false)
          )
          (if (and (not skips) (!= (. row op) .if-op) (!= (. row op) .concat-op) other-op)
            (return false)
          )
          (lazy other-op (and (not (call is-arithmetic (. row op))) (not (call is-comparison (. row op)))))
        )
        (case .node-call-expression)
        (case .node-argument)
        (case .node-index-expression)
        (case .node-unary-expression)
        (case .node-cast-expression)
        (default
          (return false)
        )
      )
      (= child node)
      (= node (call (. tree holder-of) node))
    )
    (return false)
  )
  (fn-do _ pulled-root Bool
    (param id SyntaxId)
    (param object SyntaxId)
    (return-if false (if (and (== (call (. tree pipeline-of) id) 0) (not (call watched id)))))
    (blank)
    (match? ([] (. tree nodes) object)
      (case (call .node-identifier row)
        (return-if false (if (. row is-tracked)))
        (return (== (. (call (. bindings resolution-of) (. frame binding) object) kind) .resolve-slot))
      )
    )
    (return false)
  )
  (fn-do _ restored Bool
    (param slot SlotId)
    ; Whether something stores to a local after it is declared: an assignment, or its declaration
    ; run again, as one whose value reads something tracked is.
    (if (!= (/and/ (. ([] (. bindings slots) slot) flags) (. SlotFlag slot-assigned)) 0)
      (return true)
    )
    (let syntax (. ([] (. bindings slots) slot) syntax))
    (for (in node (..< (+ syntax 1) (as (. tree nodes length) SyntaxId)))
      (if (and (<= (call (. tree subtree-start) node) syntax) (is ([] (. tree nodes) node) .node-declare))
        (return (call is-live-statement node))
      )
    )
    (return false)
  )
  (fn-do _ unfollowed _
    (param id SyntaxId)
    (param name Atom)
    (let shown (. name text))
    (let message
      (paragraph
        (str "\"#" shown "\" is read for each item of a pipeline, which is followed only where the pipeline is given to a call in a live value, as in count(each in #items when each.#is-done); write \"" shown "\" to read it plainly")
      )
    )
    (call (. frame diagnose) id .stated (call (. program store-atom) message))
  )
  (fn-do + note-given _
    (param call SyntaxId)
    (param given SyntaxId)
    (param callee InstanceId)
    (param position U32)
    (if (or (== callee no-instance) (not (call takes-generator (call (. instances argument-type) callee position))))
      (return)
    )
    (+= given-nodes given)
    (+= given-calls call)
    (+= given-callees callee)
    (+= given-positions position)
  )
  (fn-expr _ takes-generator Bool
    (param type TypeId)
    (and (!= type no-type) (!= type invalid-type) (or (call same-decl ref (. types generator-decl)) (call same-decl ref (. types iterable-decl))))
    (where
      (lazy ref (call class-ref types type))
    )
  )
  (fn-do _ given-index (? Size)
    (param node SyntaxId)
    (let index (. given-nodes length))
    (while (!= index 0)
      (-= index 1)
      (if (== ([] given-nodes index) node)
        (return index)
      )
    )
    (return null)
  )
  (fn-do _ callee-use GeneratorUse
    (param callee InstanceId)
    (param position U32)
    (if (>= position 64)
      (return .generator-kept)
    )
    (call demand-body callee)
    (if (!= (. ([] (. instances rows) callee) state) .instance-done)
      (return .generator-kept)
    )
    (let bit (/lshift/ 1u64 (as position U64)))
    (if (!= (/and/ (. ([] (. instances rows) callee) consumes) bit) 0)
      (return .generator-consumed)
    )
    (if (!= (/and/ (. ([] (. instances rows) callee) hands-back) bit) 0)
      (return .generator-returned)
    )
    (return .generator-kept)
  )
  (fn-do _ generator-use GeneratorUse
    (param node SyntaxId)
    (let given (call given-index node))
    (if (!= given null)
      (let use (call callee-use ([] given-callees given) ([] given-positions given)))
      (if (== use .generator-returned)
        (return (call generator-use ([] given-calls given)))
      )
      (return use)
    )
    (let range (. ([] (. instances rows) instance) subtree))
    (for (in id (..< (. range start) (+ (. range start) (. range count))))
      (match? ([] (. tree nodes) id)
        (case (call .node-for-block row)
          (match? ([] (. tree nodes) (. row loop))
            (case (call .node-loop-syntax loop)
              (if (== (. loop container) node)
                (return .generator-consumed)
              )
            )
          )
        )
        (case (call .node-unary-expression row)
          (if (and (== (. row op) .read-op) (== (. row operand) node))
            (return .generator-consumed)
          )
        )
        (case (call .node-return row)
          (if (== (. row expr) node)
            (return .generator-returned)
          )
        )
        (case (call .node-yield row)
          (if (and (== (. row expr) node) (. row does-yield-all))
            (return .generator-returned)
          )
        )
        (case (call .node-argument-decl row)
          (if (and (<= (call (. tree subtree-start) (. row pattern)) node) (<= node (. row pattern)))
            (return .generator-consumed)
          )
        )
      )
    )
    (return .generator-kept)
  )
  (fn-do _ parameter-use GeneratorUse
    (param slot SlotId)
    (let held (/or/ (. SlotFlag slot-captured) (. SlotFlag slot-address-taken)))
    (if (!= (/and/ (. ([] (. bindings slots) slot) flags) held) 0)
      (return .generator-kept)
    )
    (let range (. ([] (. instances rows) instance) subtree))
    (let use GeneratorUse .generator-consumed)
    (for (in id (..< (. range start) (+ (. range start) (. range count))))
      (if (is ([] (. tree nodes) id) .node-identifier)
        (let resolution (call (. bindings resolution-of) (. frame binding) id))
        (if (and (== (. resolution kind) .resolve-slot) (== (. resolution slot) slot))
          (let found (call generator-use id))
          (if (== found .generator-kept)
            (return .generator-kept)
          )
          (if (== found .generator-returned)
            (= use .generator-returned)
          )
        )
      )
    )
    (if (. ([] (. instances rows) instance) is-generator)
      (return .generator-returned)
    )
    (return use)
  )
  (fn-do _ settle-generators _
    (for (in index (..< 0 (. pulled-pipelines length)))
      (call follow-pipeline ([] pulled-pipelines index) ([] pulled-reads index) ([] pulled-names index))
    )
    (let consumes U64)
    (let hands-back U64)
    (let position 0u32)
    (for (in offset (..< 0 (. frame slots count)))
      (let slot (+ (. frame slots start) offset))
      (let row ([] (. bindings slots) slot))
      (if (and outer (!= (. row scope) (. frame nested-scope)))
        (continue)
      )
      (if (!= (. row kind) .slot-argument)
        (continue)
      )
      (if (and (< position 64) (call takes-generator (call (. instances argument-type) instance position)))
        (let use (call parameter-use slot))
        (let bit (/lshift/ 1u64 (as position U64)))
        (if (== use .generator-consumed)
          (= consumes (/or/ consumes bit))
          (else-if (== use .generator-returned)
            (= hands-back (/or/ hands-back bit))
          )
        )
      )
      (+= position 1)
    )
    (= (. ([] (. instances rows) instance) consumes) consumes)
    (= (. ([] (. instances rows) instance) hands-back) hands-back)
  )
  (fn-expr _ read-site SyntaxId
    (param id SyntaxId)
    ; Where a node is read: a node of the value of a row local read as a getter is read where the
    ; outermost such read is.
    (if-expr (!= (. reading getter) 0) (. reading getter) id)
  )
  (fn-do _ owns-plain-actions Bool
    (param type TypeId)
    ; Whether the live actions an object owns are plain ones: it is an object of a class that is
    ; neither a markup host nor a markup batch, whose actions the reference makes through markup.
    (if (!= (call (. types intrinsic-of) type) .class)
      (return false)
    )
    (for (in decl (list (. types markup-host-decl) (. types markup-batch-decl)))
      (if (and (or (!= (. decl module) 0) (!= (. decl decl) 0)) (!= (call derived-interface type decl) no-type))
        (return false)
      )
    )
    (return true)
  )
  (fn-do _ root-value SyntaxId
    ; The line of a root `<This` whose value the instance types, as the value of a property, or
    ; none.
    (let unit ([] (. instances rows) instance))
    (if (== (. unit initializer) 0)
      (return 0)
    )
    (match? ([] (. ([] (. program modules) (. unit module)) decls) (. unit initializer))
      (case (call .decl-property row)
        (if (. row defaults-root)
          (return (. row syntax))
        )
      )
    )
    (return 0)
  )
  (fn-do _ in-loop Bool
    (param id SyntaxId)
    ; Whether a node is written in a loop of the function that writes it. The body of a markup loop
    ; region is the function that builds a row, in no loop.
    (for (in node (..< (+ id 1) (as (. tree nodes length) SyntaxId)))
      (if (and (== node (. frame declaration syntax)) (== (. frame declaration kind) .row-decl))
        (return false)
      )
      (if (<= (call (. tree subtree-start) node) id)
        (match? ([] (. tree nodes) node)
          (case .node-for-block
            (return true)
          )
          (case .node-iterator-expression
            (return true)
          )
          (case .node-while-block
            (return true)
          )
          (case .node-loop-syntax
            (return true)
          )
          (case .node-function-syntax
            (return false)
          )
        )
      )
    )
    (return false)
  )
  (fn-do _ infer-stream TypeId
    (param id SyntaxId)
    (param expr SyntaxId)
    ; A stream of a value as it changes, `<#value>`, as the reference makes it: the value, read while
    ; a live action of its own is open, is written by `<-write` to an `AsyncBufferedChannel` of its
    ; type made there, which is kept in the local no name reaches declared at the stream, and the
    ; action writes the value again to the channel through the function written for it as what it
    ; read changes. One that reads nothing tracked is reported, as it would never change; one written
    ; where a markup element is being made has no shape here yet.
    (if (not (call (. tree tracks-reads) expr))
      (let message
        (paragraph
          "A stream of a value follows the reads written with \"#\", and this one has none, so it would never change; write \"#\" before what it follows, as in \"<c.#count>\""
        )
      )
      (call (. frame diagnose) id .stated (call (. program store-atom) message))
      (return invalid-type)
    )
    (let decl (call nested-decl-of id))
    (let resolution (call (. bindings resolution-of) (. frame binding) id))
    (if (or (== decl 0) (!= (. resolution kind) .resolve-slot) (!= (. content-parents length) 0))
      (call decline id)
      (return invalid-type)
    )
    (let value (call infer expr))
    (if (or (== value invalid-type) (== value no-type))
      (return invalid-type)
    )
    (let channel (call (. types well-known-type-of) "core/channel" "AsyncBufferedChannel" value))
    (if (== channel invalid-type)
      (call decline id)
      (return invalid-type)
    )
    (let made (call (. calls demand-constructor) channel (. scratch types mark)))
    (let given (list TypeId))
    (+= given value)
    (let write (. (call (. calls protocol-call) channel (call (. program store-atom) "<-write") id given true (:role (. CallRole role-write))) fact))
    (if (or (== made no-instance) (== write no-fact))
      (call decline id)
      (return invalid-type)
    )
    (do
      (inline (call (. facts record-call) instance id made .call-constructor (. scratch no-fills) false))
    )
    (call (. frame assign) (. resolution slot) channel)
    (let position (. facts live-statements length))
    (while (!= position 0)
      (-= position 1)
      (let row ([] (. facts live-statements) position))
      (if (or (!= (. row instance) instance) (!= (. row site) id) (!= (. row rerun) no-instance))
        (continue)
      )
      (let rerun (call demand-lambda (call intern-nested decl) (. scratch no-types)))
      (if (or (== rerun no-instance) (!= (. ([] (. instances signatures) rerun) errors count) 0))
        (call decline id)
        (return invalid-type)
      )
      (call (. instances mark-may-panic) instance)
      (= ([] (. facts live-statements) position) (call LiveStatement instance id rerun))
      (return channel)
    )
    (let message
      (paragraph
        "A stream of a value is made only by a statement in a function's body, as in \"(let values (stream (. c #count)))\"; make it there, move a machine as a value changes with a \"whenever\" trigger, as in \"(then loading (trigger whenever #feed))\", or publish an event from a \"whenever\" rule and loop on it"
      )
    )
    (call (. frame diagnose) id .stated (call (. program store-atom) message))
    (return invalid-type)
  )
  (fn-do _ claim-lazy _
    (param slot SlotId)
    (param declaration SyntaxId)
    (param value SyntaxId)
    ; A lazy local whose value is closable, which the reference keeps behind a flag
    ; (`lazy-flagged`), in a function that makes markup or runs on an object of a class, is claimed
    ; for the object that owns what is made where it is evaluated, as the reference's `ownClosable`
    ; gives it: a `ClosableTracker` of it, made a `Tracker`, is held by a live action of the owner,
    ; and the value and the tracker are converted at the declaration (`AddressClaim`). `it` is not
    ; claimed, and one written with a type its value is converted to has no shape here.
    (if (or (== value 0) (== (. ([] (. bindings slots) slot) name text) "it") (not (call (. bindings lazy-flagged) slot)))
      (return)
    )
    (let raw (call (. facts node-type) instance value))
    (if (or (== raw no-type) (== raw invalid-type) (== (call derived-interface raw (. types closable-decl)) no-type))
      (return)
    )
    (let owned
      (scope (and (!= (. frame self-type) no-type) (not (call lacks-self)) class-self)
        (lazy class-self (== (call (. types intrinsic-of) (. frame self-type)) .class))
      )
    )
    (if (and (not owned) (not (call writes-markup)))
      (return)
    )
    (if (!= raw (call (. frame slot-type) slot))
      (call decline declaration)
      (return)
    )
    (call demand-live-runtime)
    (let closable (call (. types well-known-type) "core/stream" "Closable"))
    (let tracking (call (. types well-known-type) "core/tracker" "ClosableTracker"))
    (let tracker (call (. types well-known-type) "core/tracker" "Tracker"))
    (if (or (== closable invalid-type) (== tracking invalid-type) (== tracker invalid-type) live-missing)
      (call decline declaration)
      (return)
    )
    (lazy live-missing (or (== (. instances live add-tracker) no-instance) (== (. instances live action) no-instance)))
    (let mark (. scratch types mark))
    (call (. scratch types push) closable)
    (let closer (call (. calls demand-constructor) tracking mark))
    (call (. scratch types rewind) mark)
    (if (== closer no-instance)
      (call decline declaration)
      (return)
    )
    (call (. conversions convert) declaration declaration raw closable .reason-argument)
    (call (. conversions convert)
      (block
        (arg declaration)
        (arg declaration)
        (arg (. ([] (. instances signatures) closer) returns))
        (arg tracker)
        (arg .reason-argument)
      )
    )
    (+= (. facts address-claims) (call AddressClaim instance declaration closer))
  )
  (fn-do _ object-member TypeId
    (param id SyntaxId)
    (param name Atom)
    ; A member every object has that its class does not declare: its `uid`, or the list of the
    ; subscribers of its properties, which the runtime's property tracker gives the type of.
    (if (== (. name text) "uid")
      (call (. facts set-plan) instance id .plan-object-uid)
      (return (call (. types type-row) .uint32))
    )
    (if (!= (. name text) "property-subscribers")
      (return no-type)
    )
    (call demand-live-runtime)
    (let tracker (call (. types well-known-type) "core/tracker" "PropertyTracker"))
    (if (or (== tracker invalid-type) (== (. instances live subscribers) no-instance))
      (call decline id)
      (return invalid-type)
    )
    (call (. facts set-plan) instance id .plan-property-subscribers)
    (return (call tracker-field tracker "subscribers"))
  )
  (fn-expr _ reads-unmade Bool
    (param name Atom)
    ; Whether a member read by its name alone is the property the markup of a class declares
    ; for an element, read where the markup may not have run: in a constructor, or in the first
    ; value of a property or a rule. The reference reports the first, puts off the value of a
    ; stored property until the markup has run, and runs a rule that reads one in its test once
    ; it has.
    (case? (and (not (call is-constructor-kind (. frame declaration kind))) (not (call (. instances is-initializer) instance)))
      false
    )
    (case? (or (== self no-type) (== self invalid-type))
      false
    )
    (default
      (and (!= place null) (call names-element types ([] (. types properties) place)))
    )
    (where
      (lazy self (. frame self-type))
      (lazy place (call property-named self name))
    )
  )
  (fn-do _ is-eager-value Bool
    ; Whether the instance types the value written for a stored property of a class, which a
    ; constructor can put off.
    (let unit ([] (. instances rows) instance))
    (if (or (== (. unit initializer) 0) (== (. frame self-type) no-type))
      (return false)
    )
    (match? ([] (. ([] (. program modules) (. unit module)) decls) (. unit initializer))
      (case (call .decl-property row)
        (return (not (. row is-lazy)))
      )
    )
    (return false)
  )
  (fn-do _ names-method Bool
    (param owner ModuleId)
    (param decl DeclId)
    ; Whether a declaration is a method called on a receiver: read as a value by its name
    ; alone, it binds the receiver of the function that reads it.
    (match? ([] (. ([] (. program modules) owner) decls) decl)
      (case (call .decl-function fn)
        (return (and (!= (. fn owner) 0) (not (. fn is-static)) (== (. fn kind) .function-decl)))
      )
    )
    (return false)
  )
  (fn-expr _ names-module-accessor Bool
    (param owner ModuleId)
    (param decl DeclId)
    (match ([] (. ([] (. program modules) owner) decls) decl)
      (case (call .decl-function fn)
        (and (== (. fn owner) 0) (or (== (. fn kind) .getter-decl) (== (. fn kind) .setter-decl)))
      )
      (default
        false
      )
    )
  )
  (fn-do _ note-plain _
    (param id SyntaxId)
    (param name Atom)
    ; Says of a name read that reading it evaluates nothing: a local or an argument that is not
    ; lazy, a global its module gives its value as it starts, a property the receiver stores as
    ; it is constructed, or a name of no value. A lazy one, and one kept in a way of its own, is
    ; evaluated where it is read. A property of the name of one some class derives may be
    ; evaluated again as it is read, so the reader may panic.
    (let resolution (call (. bindings resolution-of) (. frame binding) id))
    (let plain true)
    (match? (. resolution kind)
      (case= .resolve-slot
        (= plain (!= (. ([] (. bindings slots) (. resolution slot)) kind) .slot-lazy))
      )
      (case= .resolve-global
        (= plain (call (. types is-literal-global) (. resolution module) (. resolution decl)))
        (match? ([] (. ([] (. program modules) (. resolution module)) decls) (. resolution decl))
          (case (call .decl-property row)
            (if (and (== (. row owner) 0) (== (. row decoration) null) (. row name) (not (. row is-lazy)))
              (= plain true)
            )
          )
        )
      )
      (case= .resolve-member
        (let found (only-if (call property-named (. frame self-type) name) (if (!= (. frame self-type) no-type))))
        (= plain (and (!= found null) (== (. ([] (. types properties) found) storage-kind) .storage-eager)))
        (if (and plain (call (. program is-derived-name) name) (== (call (. types intrinsic-of) (. frame self-type)) .class))
          (call (. instances mark-may-panic) instance)
        )
      )
    )
    (if plain
      (call (. facts mark-plain) instance id)
    )
  )
  (fn-do _ note-case-read _
    (param id SyntaxId)
    (param slot SlotId)
    (param read TypeId)
    ; Plans the read of a local that holds a union and is known to hold one case of it as the
    ; read of that case, and one known to hold cases of classes that derive from the class of one
    ; of them, read as that class, as the read of that one (`Narrowing.common-base`). One known to
    ; hold cases of classes that a class derives from or that derive from it, read as that class
    ; once a test for it holds, is read through the case `Narrowing.line-case` picks. A local that
    ; holds an optional of a union, known to hold a value that is one case, is planned the same. A
    ; local of an enclosing function is planned from the frame that declares it, as `read-slot` types it.
    (let home (call slot-frame slot))
    (call plan-case-read id (call (. home known) slot) (call (. home narrowed-cases) (call slot-key slot)) read)
  )
  (fn-expr _ narrowed-from TypeId
    (param key NarrowingKey)
    (param receiver TypeId)
    (param name Atom)
    (case? (call is-path-key key)
      (call (. frame path-declared-type) key)
    )
    (case? (or (!= declared no-type) (== receiver no-type) (== receiver invalid-type))
      declared
    )
    (default
      (if-expr found (. ([] (. types properties) found) type) no-type)
    )
    (where
      (lazy declared (call key-declared key))
      (lazy found (call property-named receiver name))
    )
  )
  (fn-do _ plan-case-read _
    (param id SyntaxId)
    (param declared TypeId)
    (param held U64)
    (param read TypeId)
    (if (or (== read declared) (== declared no-type) (== declared invalid-type))
      (return)
    )
    (if (call (. types is-optional) declared)
      (= declared (call (. types optional-inner) declared))
    )
    (if (or (== read declared) (!= (call (. types intrinsic-of) declared) .union))
      (return)
    )
    (let cases (. (call (. types completion-of) declared) cases))
    (let based (== (call (. narrowing common-base) cases held) read))
    (for (in offset (..< 0 (. cases count)))
      (let bit (if-expr (< offset 64) (/lshift/ 1u64 offset) 0))
      (let base (and based (!= (/and/ held bit) 0) (== (. ([] (. types cases) (+ (. cases start) offset)) type) read)))
      (if (and (!= bit 0) (or (== held bit) base))
        (let inner (if-expr base (. U32 max) (call inner-case (. ([] (. types cases) (+ (. cases start) offset)) type) read)))
        (call (. facts set-case) instance id (as offset U32) .plan-case-read inner)
        (return)
      )
    )
    (let lined (call (. narrowing line-case) cases held read))
    (if (and (!= held 0) (!= lined (. U32 max)))
      (call (. facts set-case) instance id lined .plan-case-read)
    )
  )
  (fn-do _ inner-case U32
    (param held TypeId)
    (param read TypeId)
    (let union (if-expr (call (. types is-optional) held) (call (. types optional-inner) held) held))
    (if (or (== union read) (!= (call (. types intrinsic-of) union) .union))
      (return (. U32 max))
    )
    (return (call (. narrowing case-of-type) (. (call (. types completion-of) union) cases) read))
  )
  (fn-expr _ slot-frame Frame
    (param slot SlotId)
    (if-expr (and outer (call (. frame is-captured) slot)) (call (. outer slot-frame) slot) frame)
  )
  (fn-do _ pointer-to TypeId
    (param target TypeId)
    (if (or (== target invalid-type) (== target no-type))
      (return invalid-type)
    )
    (let mark (. scratch types mark))
    (call (. scratch types push) target)
    (return (call (. types class-named-with-args) module (!! (. types cpointer-atom)) mark))
  )
  (fn-do _ sized-array TypeId
    (param id SyntaxId)
    (param object TypeId)
    (param key-syntax SyntaxId)
    (param key TypeId)
    ; An array of a type made with a count of an integer type takes the count as a `Size`, which
    ; it converts to as an argument does.
    (if (!= (call (. types intrinsic-of) object) .type-info)
      (return no-type)
    )
    (let item-type (call type-info-about object))
    (if (== item-type invalid-type)
      (return no-type)
    )
    (let mark (. scratch types mark))
    (call (. scratch types push) item-type)
    (let pattern (call (. types class-named-with-args) module (!! (. types array-atom)) mark))
    (if (== pattern invalid-type)
      (return no-type)
    )
    (let count key)
    (if (and (call is-integer key) (!= key (. types size-type)))
      (= count (call (. conversions convert) key-syntax key-syntax key (. types size-type) .reason-argument))
      (if (== count invalid-type)
        (return invalid-type)
      )
    )
    (let shapes-start (. scratch call-arguments mark))
    (call (. scratch call-arguments push) (call CallArgument null false false false false))
    (let types-start (. scratch types mark))
    (call (. scratch types push) count)
    (let syntax-start (. scratch syntax mark))
    (call (. scratch syntax push) key-syntax)
    (let arguments (call arguments-since shapes-start types-start syntax-start (. scratch no-types)))
    (let result (call (. calls construction-on) id pattern arguments))
    (call (. scratch syntax rewind) syntax-start)
    (call (. scratch types rewind) types-start)
    (call (. scratch call-arguments rewind) shapes-start)
    (return result)
  )
  (fn-do _ type-info-of TypeId
    (param id SyntaxId)
    (param about TypeId)
    (if (== about invalid-type)
      (call decline id)
      (return invalid-type)
    )
    (let mark (. scratch types mark))
    (call (. scratch types push) about)
    (return (call (. types class-named-with-args) module (!! (. types type-info-atom)) mark))
  )
  (fn-do _ type-info-about TypeId
    (param info TypeId)
    (match? ([] (. types rows) info)
      (case (call .type-class row)
        (if (== (. row args count) 1)
          (return (call (. types child-type) (. row args) 0))
        )
      )
    )
    (return invalid-type)
  )
  (fn-do _ static-get TypeId
    (param id SyntaxId)
    (param about TypeId)
    (param name Atom)
    (if (== about invalid-type)
      (return invalid-type)
    )
    (let completion (call (. types completion-of) about))
    (if (== (. completion intrinsic) .union)
      (for (in fact ([] (. types cases) (. completion cases)))
        (if (and (. fact name) (== (!! (. fact name)) name))
          (let valued (!= (?? (call enum-case-value about name) 0) 0))
          (if valued
            (call note-enum-case about name id)
            (return about)
          )
          (if (or (. fact is-default) (== (. fact type) no-type))
            (call note-case id about name)
            (return about)
          )
          (call decline id)
          (return invalid-type)
        )
      )
    )
    (if (and (. completion has-enums) (call enum-case-decl types program about name))
      (call note-enum-case about name id)
      (return about)
    )
    (if (or (== name (!! (. types max-atom))) (== name (!! (. types min-atom))))
      (let root (call number-root about))
      (if (== root invalid-type)
        (return invalid-type)
      )
      (call note-limit id root (== name (!! (. types max-atom))))
      (return about)
    )
    (if (== name (!! (. types size-atom)))
      (if (and (call is-numeric types about) (!= (. completion bit-size) 0))
        (call note-integer id (/ (+ (. completion bit-size) 7) 8))
        (else
          (call (. facts set-plan) instance id .plan-type-size)
        )
      )
      (return (. types size-type))
    )
    (if (call is-type-info-text name)
      (call note-type-text id about name)
      (return (. types string-type))
    )
    (if (call is-type-info-flag name)
      (call note-type-flag id about name)
      (return (. types bool-type))
    )
    (if (== (. name text) "bit-width")
      (if (and (not (call is-integer-kind (. completion intrinsic))) (!= (. completion intrinsic) .cpointer))
        (call (. frame diagnose) id .stated (call (. program store-atom) "Integer type required for bit-width"))
        (return invalid-type)
      )
      (call note-integer id (. completion bit-size))
      (return (call (. types type-row) .int64))
    )
    (if (== (. name text) "probe-data-type")
      (call note-integer id (call probe-data-type types about))
      (return (call (. types type-row) .int64))
    )
    (if (== (. name text) "properties")
      (let listed (call (. types well-known-type) "core/type" "PropertyList"))
      (if (!= listed invalid-type)
        (call (. facts note-properties-read) about)
        (call (. facts set-plan) instance id .plan-type-properties)
        (return listed)
      )
    )
    (if (== (. name text) "base")
      (let base (call (. types base-of) about))
      (if (not base)
        (call (. frame diagnose) id .stated (call (. program store-atom) "No base type"))
        (return invalid-type)
      )
      (call (. facts set-plan) instance id .plan-type-base)
      (return (call type-info-of id base))
    )
    (call (. frame diagnose) id .property-not-found name)
    (return invalid-type)
  )
  (fn-do _ note-integer _
    (param id SyntaxId)
    (param value U64)
    ; Records an integer as the constant a node answers with.
    (call (. facts set-value) instance id (call ConstantFact value 0 null false))
  )
  (fn-do _ note-limit _
    (param id SyntaxId)
    (param root TypeId)
    (param is-max Bool)
    ; Records the greatest or the least value of a number type as the constant its node answers
    ; with: the greatest and least finite values of a float.
    (let row ([] (. types completions) root))
    (if (call intrinsic-is-float (. row intrinsic))
      (let limit (if-expr (== (. row bit-size) 32) 3.402823466e+38 1.7976931348623157e+308))
      (call (. facts set-value) instance id (call ConstantFact 0 (if-expr is-max limit (- limit)) null true))
      (else-if (call is-integer-kind (. row intrinsic))
        (call note-integer id (call integer-limit (. row bit-size) (and (. row is-signed) (!= (. row bit-size) 1)) is-max))
      )
    )
  )
  (fn-do _ note-type-text _
    (param id SyntaxId)
    (param about TypeId)
    (param name Atom)
    ; Records the name or the key of a type as the constant its node answers with. A class of
    ; objects and an interface answer the concrete ones from the value, so they have no constant,
    ; and neither has a type with arguments or one that is not a class. A concrete one with no
    ; constant is planned as read from the value, and the name or the key with none as the text
    ; of the type. The name inlining knows of a value of an interface has no constant either.
    (let kind (. (call (. types completion-of) about) intrinsic))
    (let is-concrete (or (== (. name text) "concrete-name") (== (. name text) "concrete-key")))
    (let is-inlined (== (. name text) "inlined-name"))
    (let constant
      (scope (and (not (and is-concrete (or (call intrinsic-is-class kind) (== kind .interface)))) not-inlined)
        (lazy not-inlined (not (and is-inlined (== kind .interface))))
      )
    )
    (match ([] (. types rows) about)
      (case (call .type-class row)
        (if (!= (. row args count) 0)
          (= constant false)
        )
      )
      (default
        (= constant false)
      )
    )
    (if (not constant)
      (if is-concrete
        (call (. facts set-plan)
          (block
            (arg instance)
            (arg id)
            (arg (if-expr (== (. name text) "concrete-name") .plan-concrete-name .plan-concrete-key))
          )
        )
        (else-if (and is-inlined (== kind .interface))
          (call (. facts set-plan) instance id .plan-inlined-name)
        )
        (else-if (or (== (. name text) "name") is-inlined)
          (call (. facts set-plan) instance id .plan-type-name)
        )
        (else-if (== (. name text) "key")
          (call (. facts set-plan) instance id .plan-type-key)
        )
      )
      (return)
    )
    (let is-key (or (== (. name text) "key") (== (. name text) "concrete-key")))
    (let text (if-expr is-key (call type-key types about) (call type-short-name types about)))
    (call (. facts set-value) instance id (call ConstantFact 0 0 (call (. program store-atom) text) false))
  )
  (fn-do _ note-type-flag _
    (param id SyntaxId)
    (param about TypeId)
    (param name Atom)
    ; Records what a type answers to a question about its kind as the constant of the node. A
    ; pointer is an integer without a sign. Every type is read-only but a class, a struct and a
    ; `TableField`, as TypeScript says.
    (let row (call (. types completion-of) about))
    (let kind (. row intrinsic))
    (let numeric (call is-numeric types about))
    (let asked (. name text))
    (if (== asked "read-only")
      (let writable (or (== kind .class) (== kind .struct) (== kind .table-column)))
      (call note-integer id (if-expr writable 0 1))
      (return)
    )
    (let answer (== kind .struct))
    (if (== asked "is-integer")
      (= answer (or (call is-integer-kind kind) (== kind .cpointer)))
      (else-if (== asked "is-number")
        (= answer (or numeric (== kind .cpointer)))
      )
      (else-if (== asked "is-signed")
        (= answer (and numeric (. row is-signed)))
      )
      (else-if (== asked "is-tuple")
        (= answer (and (call intrinsic-is-tuple-like kind) (!= kind .struct)))
      )
    )
    (call note-integer id (if-expr answer 1 0))
  )
  (fn-do _ enum-case-value (? SyntaxId)
    (param about TypeId)
    (param name Atom)
    (let member (call enum-case-decl types program about name))
    (if (not member)
      (return null)
    )
    (let ref (call class-ref types about))
    (match? ([] (. ([] (. program modules) (. ref module)) decls) member)
      (case (call .decl-case row)
        (return (. row value))
      )
    )
    (return null)
  )
  (fn-do _ number-root TypeId
    (param about TypeId)
    (let current about)
    (while true
      (let kind (. ([] (. types completions) current) intrinsic))
      (if (== kind .bool)
        (return (. types bool-type))
      )
      (if (== (call (. types type-row) kind) current)
        (return current)
      )
      (let base (call (. types base-of) current))
      (if (not base)
        (return invalid-type)
      )
      (= current base)
    )
  )
  (fn-do _ cpointer-item TypeId
    (param receiver TypeId)
    (call (. types complete) receiver)
    (if (!= (. ([] (. types completions) receiver) intrinsic) .cpointer)
      (return no-type)
    )
    (return (call pointee-of types receiver))
  )
  (fn-expr _ core-literal-type TypeId
    (param owner U32)
    (param property DeclId)
    (case? (!= owner (. types core-module))
      no-type
    )
    (default
      (match ([] (. target decls) property)
        (case (call .decl-property row)
          (case? (or (== (. row name) (. types true-atom)) (== (. row name) (. types false-atom)))
            (. types bool-type)
          )
          (case? (== (. row name) (. types null-atom))
            (. types null-type)
          )
          (default
            no-type
          )
        )
        (default
          no-type
        )
      )
    )
    (where
      (lazy target ([] (. program modules) owner))
    )
  )
  (fn-do _ read-member Found
    (param id SyntaxId)
    (param name Atom)
    (param want Want (= (call Want)))
    (let receiver (. frame self-type))
    (if (or (== receiver no-type) (== receiver invalid-type))
      (return (call Found invalid-type))
    )
    (let resolution (call (. bindings resolution-of) (. frame binding) id))
    (if (and (== (. resolution kind) .resolve-member) (call (. frame is-doubted) (call member-key (. resolution module) (. resolution decl))))
      (call decline id)
      (return (call Found invalid-type))
    )
    (if (and (== (. resolution kind) .resolve-member) (. frame members-narrowed))
      (let key (call member-key (. resolution module) (. resolution decl)))
      (let narrowed (call forced-member id key want))
      (if (!= narrowed no-type)
        (call plan-case-read id (call narrowed-from key receiver name) (call (. frame narrowed-cases) key) narrowed)
        (return (call (. (call Found narrowed) holding) (call (. want asks) .want-forced)))
      )
    )
    (return (call read-property id id receiver name want))
  )
  (fn-do _ forced-member TypeId
    (param id SyntaxId)
    (param key NarrowingKey)
    (param want Want)
    ; What the flow knows a property or a path to hold at a read of it. A read in the value of a lazy
    ; local of one a test the value made narrowed is noted as one that holds wherever the value is
    ; evaluated (`note-inside-read`), as a local's is.
    (let held (if-expr (not (call (. want asks) .want-forced)) (call (. frame narrowed-member) key) (call (. frame held-member) key)))
    (if (and (!= held no-type) (!= (. lazy-marks length) 0) narrowed-inside)
      (call (. facts note-inside-read) instance id)
    )
    (lazy narrowed-inside (!= (call (. scratch narrowed-since) ([] lazy-marks (- (. lazy-marks length) 1)) key) no-type))
    (return held)
  )
  (fn-do _ note-lazy-read TypeId
    (param id SyntaxId)
    (param property TypeProperty)
    (param receiver TypeId)
    (param name Atom)
    ; A read of a lazy property evaluates its value when the object has none yet. The reference
    ; reads it by a call, which ends what is known of properties. The reader may panic where the
    ; value does, and always when the class of the object chooses the value: a class derived from
    ; the receiver's may write another. The errors the value lets out leave the reader at the read,
    ; which gives the value, as a call does; under `catch` the read gives the value or one of the
    ; errors, which is answered. A value that lets out errors for a class that the class of the
    ; object may not be is not typed here.
    (call (. frame forget-members))
    (if (call (. calls is-virtual-receiver) receiver)
      (call (. instances mark-may-panic) instance)
    )
    (= last-unit no-instance)
    (let value (call demand-member property receiver name))
    (let unit last-unit)
    (if (or (== unit no-instance) (== unit instance))
      (return no-type)
    )
    (call (. panics note-lazy-read) instance unit)
    (let virtual (call (. calls is-virtual-receiver) receiver))
    (if (and (not (call (. instances errors-known) unit)) (or (!= (. frame surround catch-depth) 0) virtual))
      (call demand-errors unit)
    )
    (let known (call (. instances errors-known) unit))
    (if (and known (== (. ([] (. instances signatures) unit) errors count) 0))
      (return no-type)
    )
    (if (or virtual (and (not known) (!= (. frame surround catch-depth) 0)))
      (call decline id)
      (return no-type)
    )
    (if (not known)
      (call defer-outgoing unit id)
      (return no-type)
    )
    (let signature ([] (. instances signatures) unit))
    (if (!= (. frame surround catch-depth) 0)
      (return (call result-type types value (call (. calls error-items) signature)))
    )
    (for (in offset (..< 0 (. signature errors count)))
      (call note-outgoing ([] (. instances signature-types) (+ (. signature errors start) offset)) id)
    )
    (return no-type)
  )
  (fn-do _ read-property Found
    (param id SyntaxId)
    (param object-syntax SyntaxId)
    (param receiver TypeId)
    (param name Atom)
    (param want Want (= (call Want)))
    (let rows forwarded-row)
    (= forwarded-row no-type)
    (let held case-row)
    (= case-row null)
    (let receiver-kind (call (. types intrinsic-of) receiver))
    (if (and (== name (!! (. types address-atom))) (!= (call cpointer-item receiver) no-type))
      (call (. facts set-plan) instance id .plan-address)
      (return (call Found (call (. types type-row) .uint64)))
    )
    (if (== receiver-kind .atom)
      (if (== name (!! (. types address-atom)))
        (call (. facts set-plan) instance id .plan-address)
        (return (call Found (call (. types type-row) .uint64)))
      )
      (if (== name (!! (. types text-atom)))
        (call (. facts set-plan) instance id .plan-reinterpret)
        (return (call Found (. types string-type)))
      )
    )
    (let viewed (call view-field receiver name))
    (if (!= viewed no-type)
      (let item (call row-struct-of receiver))
      (call plan-view id (. ([] (. types properties) (!! (call property-named item name))) slot))
      (return (call Found viewed))
    )
    (if (and (or (call is-column-receiver receiver-kind) columns (call is-index-reader receiver-kind)) length-name)
      (call plan-table id .table-length)
      (return (call Found (. types size-type)))
    )
    (lazy columns (or (== receiver-kind .table-column) (== receiver-kind .immutable-table-column)))
    (lazy length-name (or (== name (!! (. types length-atom))) (== (. name text) "size")))
    (let found (call property-named receiver name))
    (if (and found (call is-hidden ([] (. types properties) found) name) (call row-answers receiver name))
      (= found null)
    )
    (if found
      (let property ([] (. types properties) found))
      (if (call is-hidden property name)
        (let message (call privacy-message property name))
        (if (== id object-syntax)
          (= message "Name not found")
        )
        (call (. frame diagnose) id .stated (call (. program store-atom) message))
        (return (call Found invalid-type))
      )
      (if (call (. calls ranking has-extension-getter) receiver name)
        (call (. frame diagnose) id .extension-conflict)
        (return (call Found invalid-type))
      )
      (if (and (== receiver-kind .table-column) (== name (!! (. types data-atom))))
        (call plan-table id .table-data)
      )
      (if (and (== receiver-kind .table) (== (. property storage-kind) .storage-getter))
        (let getter (call table-member (. name text)))
        (if (or (== getter (. TableOp table-mark)) (== getter (. TableOp table-capacity)))
          (call plan-table id getter)
        )
      )
      (if (and (== (. property storage-kind) .storage-getter) (not (call is-array-field receiver name)))
        (let capture
          (block
            (case? held
              held
            )
            (default
              (call row-capture-of (if-expr (!= object-syntax id) object-syntax 0))
            )
          )
        )
        (return (call Found (call (. calls getter-call) id object-syntax receiver name capture)))
      )
      (if (== (. property storage-kind) .storage-getter)
        (let place U32 (if-expr (== name (!! (. types data-atom))) 0 1))
        (call (. facts set-place) instance id place .plan-field)
      )
      (if (and (== (. property storage-kind) .storage-lazy) (not assigns-plainly))
        (let caught (call note-lazy-read id property receiver name))
        (if (!= caught no-type)
          (return (call Found caught))
        )
      )
      (if (== (. property storage-kind) .storage-eager)
        (call (. facts mark-plain) instance id)
        (if (and (not assigns-plainly) (== receiver-kind .class) (call (. program is-derived-name) name))
          (call (. instances mark-may-panic) instance)
        )
        (if (and (not assigns-plainly) (!= id rebound-root) unplanned (call names-element types property) (not (call keeps-whole name)))
          (call (. instances mark-may-panic) instance)
          (call (. facts set-plan) instance id .plan-guarded-read)
        )
        (lazy unplanned (== (call (. facts plan-of) instance id) .plan-none))
      )
      (if (== (. property type) no-type)
        (return (call Found (call demand-member property receiver name)))
      )
      (return (call Found (. property type)))
    )
    (let shared-field (call row-case-field id receiver name))
    (if (!= shared-field no-type)
      (return (call Found shared-field))
    )
    (let places (list U32))
    (let holder (call (. calls ranking delegated-holder) receiver name places))
    (let reached (only-if (call property-named holder name) (if (and (!= holder no-type) (!= (. places length) 0)))))
    (if (and reached (!= (. ([] (. types properties) reached) storage-kind) .storage-getter) (not (call is-hidden ([] (. types properties) reached) name)))
      (if (call (. calls ranking has-extension-getter) receiver name)
        (call (. frame diagnose) id .extension-conflict)
        (return (call Found invalid-type))
      )
      (let read (call read-property id object-syntax holder name want))
      (if (!= (. read type) invalid-type)
        (call (. facts set-through) instance id places (call (. calls step-getters) places))
      )
      (return read)
    )
    (if (call intrinsic-is-class receiver-kind)
      (let member (call object-member id name))
      (if (!= member no-type)
        (if (call (. calls ranking has-extension-getter) receiver name)
          (call (. frame diagnose) id .extension-conflict)
          (return (call Found invalid-type))
        )
        (return (call Found member))
      )
    )
    (if (call (. calls has-getter) receiver name)
      (let capture
        (block
          (case? held
            held
          )
          (default
            (call row-capture-of (if-expr (!= object-syntax id) object-syntax 0))
          )
        )
      )
      (return (call Found (call (. calls getter-call) id object-syntax receiver name capture)))
    )
    (if (== receiver-kind .union)
      (let built (call union-property id receiver name))
      (if (!= built no-type)
        (return (call Found built))
      )
      (if (== (call (. calls getter-gap) receiver name) null)
        (let results (list TypeId))
        (let cased (. facts calls length))
        (for (in index (..< 0 (. (call (. types cases-of) receiver) length)))
          (let payload (. ([] (call (. types cases-of) receiver) index) type))
          (if (!= rows no-type)
            (= case-row (call RowCapture rows (as index U32) true))
          )
          (let got (. (call read-property id object-syntax payload name want) type))
          (if (== got invalid-type)
            (return (call Found invalid-type))
          )
          (if (== (call (. results find) got) null)
            (+= results got)
          )
        )
        (call (. facts name-roles-since) instance id cased .role-case)
        (call (. facts set-plan) instance id .plan-forward)
        (return (call Found (call (. calls forward-results) id results)))
      )
    )
    (if (== receiver-kind .optional)
      (if (== name (!! (. types value-atom)))
        (return (call Found (call (. types optional-inner) receiver)))
      )
      (if (== name (!! (. types has-value-atom)))
        (return (call Found (. types bool-type)))
      )
    )
    (if (== receiver-kind .type-info)
      (return (call Found (call static-get id (call type-info-about receiver) name)))
    )
    (if (and (== (. name text) "unit") (call is-numeric types receiver))
      (call (. facts set-plan) instance id .plan-unit-name)
      (return (call Found (. types string-type)))
    )
    (let views (call array-views receiver name))
    (if (!= views no-type)
      (if (not (call is-view-item (call row-struct-of views)))
        (let message "Array views require a fixed-layout product aggregate")
        (call (. frame diagnose) id .stated (call (. program store-atom) message))
        (return (call Found invalid-type))
      )
      (call plan-view id)
      (call (. frame check-allocates) id)
      (return (call Found views))
    )
    (if (and (== name (!! (. types length-atom))) (or (== receiver-kind .tuple) (== receiver-kind .struct)))
      (let arity (call tuple-arity receiver))
      (if (!= arity (. U32 max))
        (call note-integer id arity)
      )
      (return (call Found (call (. types type-row) .int64)))
    )
    (if (and (== (. name text) "layout") (== receiver-kind .table))
      (call plan-table id .table-layout)
      (return (call Found (. types string-type)))
    )
    (if (call is-column-receiver receiver-kind)
      (let column (call column-field-type receiver name))
      (if (!= column no-type)
        (let immutable (or (== receiver-kind .immutable-table) (== receiver-kind .immutable-table-span)))
        (let row (call row-struct-of receiver))
        (if (== (call (. types intrinsic-of) row) .struct)
          (call plan-table id .table-column (. ([] (. types properties) (!! (call property-named row name))) slot))
          (else-if (== (call (. types intrinsic-of) row) .union)
            (let first (. ([] (call (. types cases-of) row) 0) type))
            (let shared (call property-named first name))
            (if shared
              (call plan-table id .table-column (. ([] (. types properties) shared) slot))
            )
          )
        )
        (return (call Found (call (. types column-view-of) column immutable)))
      )
    )
    (if (or (== receiver-kind .table-row) (== receiver-kind .immutable-table-row))
      (let row (call row-struct-of receiver))
      (if (and (!= row no-type) (== (call (. types intrinsic-of) row) .union))
        (if (call has-case-getter row name)
          (= forwarded-row receiver)
          (return (call read-property id object-syntax row name want))
        )
      )
      (let column (only-if (call property-named row name) (if (!= row no-type))))
      (if column
        (let field ([] (. types properties) column))
        (if (call is-hidden field name)
          (call (. frame diagnose) id .stated (call (. program store-atom) (call privacy-message field name)))
          (return (call Found invalid-type))
        )
        (if (== (. field storage-kind) .storage-eager)
          (if (== (call (. types intrinsic-of) row) .struct)
            (call plan-table id .table-field (. field slot))
          )
          (if (== (. field type) no-type)
            (return (call Found (call demand-member field row name)))
          )
          (return (call Found (. field type)))
        )
      )
    )
    (if (call declares-event receiver name)
      (return (call read-event id receiver name want))
    )
    (let bound (call (. calls method-binding) receiver name id))
    (if (!= bound no-type)
      (return (call Found bound))
    )
    (let gap (only-if (call (. calls getter-gap) receiver name) (if (== receiver-kind .union))))
    (if gap
      (call (. frame diagnose) id .stated (call (. program store-atom) gap) receiver)
      (call (. frame mention) (call (. calls case-types) receiver))
      (return (call Found invalid-type))
    )
    (if (call is-batch-flush receiver)
      (let (tuple domain below) (call accessor-domain (. name text)))
      (if (and (!= (. domain length) 0) (not below))
        (return (call Found (call flush-flag id domain)))
      )
    )
    (if (call names-unmodeled-style receiver name id)
      (call decline id)
      (return (call Found invalid-type))
    )
    (call (. frame diagnose) id .property-not-found name)
    (return (call Found invalid-type))
  )
  (fn-do _ flush-flag TypeId
    (param id SyntaxId)
    (param domain String)
    ; A flag of a domain a `MarkupBatchFlush` reports, `is-X-invalid`, as the reference reads it:
    ; whether the bit of the domain, numbered as it is first named, is set in the mask of the
    ; domains the flush left pending.
    (let index (call style-domain (call (. program store-atom) domain) module id module id))
    (+= (. facts style-flags) (call StyleFlag instance id index no-instance))
    (return (. types bool-type))
  )
  (fn-expr _ is-batch-flush Bool
    (param type TypeId)
    ; Whether a type is the `MarkupBatchFlush` of the markup runtime, which a program that loads no
    ; markup has none of.
    (and (!= (. flush decl) 0) (call same-decl (call class-ref types type) flush))
    (where
      (lazy flush (. types markup-batch-flush-decl))
    )
  )
  (fn-do _ property-named (? Index)
    (param id TypeId)
    (param name Atom)
    ; The place of a property of a type by a name, as the module being typed sees it.
    (return (call (. types property-seen) id name module))
  )
  (fn-do _ is-hidden Bool
    (param fact TypeProperty)
    (param name Atom)
    (param accessor DeclKind (= .getter-decl))
    ; Whether a property, or the getter or setter that answers for it, is out of reach of the module
    ; using it, as `hiding-access` finds it.
    (return (!= (call hiding-access fact name accessor) null))
  )
  (fn-do _ hiding-access (? Access)
    (param fact TypeProperty)
    (param name Atom)
    (param accessor DeclKind (= .getter-decl))
    ; The access that keeps a property, or the getter or setter that answers for it, from the module
    ; using it: private to another module, or shared with a file family not this one's. One a markup
    ; element's name declares is not kept (`PropertyDecl.element`). A module that declares a facet of a
    ; class reaches the private members of the class, but a facet's private members are its own
    ; module's.
    (let ref (call declaring-decl types fact))
    (if (or (== (. ref module) module) (and (== (. ref module) 0) (== (. ref decl) 0)))
      (return null)
    )
    (if (and (== (. fact facet) (. U32 max)) (call (. program reaches-private) module (. ref module)))
      (return null)
    )
    (let owner-module ([] (. program modules) (. ref module)))
    (let members
      (match ([] (. owner-module decls) (. ref decl))
        (case (call .decl-class row)
          (. row members)
        )
        (case (call .decl-extension row)
          (. row members)
        )
        (default
          (call (of RowRange DeclId))
        )
      )
    )
    (for (in member (call (. owner-module members-named) members name))
      (match? ([] (. owner-module decls) member)
        (case (call .decl-property property)
          (if (and (. property name) (== (. property name) name))
            (return-if null (if (!= (. property element) 0)))
            (return (call shut-access (. property access) (. ref module)))
          )
        )
        (case (call .decl-function fn)
          (if (and (== (. fn kind) accessor) (. fn name) (== (. fn name) name))
            (return (call shut-access (. fn access) (. ref module)))
          )
        )
      )
    )
    (return null)
  )
  (fn-do _ shut-access (? Access)
    (param access Access)
    (param other ModuleId)
    ; An access that keeps a member of another module from this one, once `reaches-private` has had
    ; its say: private, or shared with a file family not this one's.
    (if (or (is access .public-access) (and (is access .family-access) (call (. program same-family) module other)))
      (return null)
    )
    (return access)
  )
  (fn-do _ privacy-message String
    (param fact TypeProperty)
    (param name Atom)
    (param accessor DeclKind (= .getter-decl))
    ; What an error says of a property `is-hidden` keeps from this module.
    (return (call hidden-message "Property" name (?? (call hiding-access fact name accessor) (. Access private-access))))
  )
  (fn-do _ union-property TypeId
    (param id SyntaxId)
    (param receiver TypeId)
    (param name Atom)
    ; What a union answers by itself, planned at the node that reads it: the number of the case
    ; it holds, that case's name, the key of its type, or what the union holds as a case named.
    ; Where it holds another case, a case named gives what its type makes with nothing written,
    ; whose construction is recorded at the node.
    (if (== (. name text) "case")
      (call (. facts set-plan) instance id .plan-case-number)
      (return (call (. types type-row) .uint8))
    )
    (if (or (== (. name text) "name") (== (. name text) "type"))
      (call (. facts set-plan) instance id (if-expr (== (. name text) "name") .plan-case-name .plan-case-type))
      (return (. types string-type))
    )
    (let cases (call (. types cases-of) receiver))
    (for (in index (..< 0 (. cases length)))
      (let fact ([] cases index))
      (if (and (. fact name) (== (!! (. fact name)) name))
        (call (. facts set-case) instance id (as index U32) .plan-case-value)
        (call construct-value id (. fact type))
        (return (if-expr (!= (. fact type) no-type) (. fact type) (call (. types type-row) .uint8)))
      )
    )
    (return no-type)
  )
  (fn-do _ aggregate-field TypeId
    (param receiver TypeId)
    (param key-syntax SyntaxId)
    (param key TypeId)
    (param operator Atom)
    (param value TypeId (= no-type))
    ; A tuple or struct class with no index operator of its own answers a constant index with the
    ; field at that position.
    (let kind (call (. types intrinsic-of) receiver))
    (if (and (!= kind .tuple) (!= kind .struct))
      (return no-type)
    )
    (if (or (call (. calls has-operator) receiver operator key value) (call indexes-itself receiver))
      (return no-type)
    )
    (return (call eager-field receiver key-syntax))
  )
  (fn-do _ indexes-itself Bool
    (param receiver TypeId)
    ; Whether the class of a type, or a base of it, declares an index operator of its own.
    (let level (? TypeId) receiver)
    (while level
      (match? ([] (. types rows) level)
        (case (call .type-class row)
          (let owner ([] (. program modules) (. row module)))
          (match? ([] (. owner decls) (. row decl))
            (case (call .decl-class body)
              (return-if true (if (!= (call (. owner first-member) (. body members) (!! (. types index-op-atom))) no-member)))
            )
          )
        )
      )
      (= level (call (. types base-of) level))
    )
    (return false)
  )
  (fn-do _ eager-type TypeId
    (param item TypeId)
    (param property TypeProperty)
    (if (!= (. property storage-kind) .storage-eager)
      (return no-type)
    )
    (if (== (. property type) no-type)
      (return (call demand-member property item (. property name)))
    )
    (return (. property type))
  )
  (fn-do _ eager-field TypeId
    (param item TypeId)
    (param key-syntax SyntaxId)
    (match? ([] (. tree nodes) key-syntax)
      (case (call .node-integer-syntax row)
        (let literal (call parse-integer-literal (. row value)))
        (if (or (. literal negative) (. literal overflow))
          (return no-type)
        )
        (call (. types complete) item)
        (let range (. ([] (. types completions) item) properties))
        (let position 0u32)
        (for (in offset (..< 0 (. range count)))
          (let property ([] (. types properties) (as (+ (. range start) offset) Index)))
          (if (== (. property storage-kind) .storage-eager)
            (if (== position (. literal value))
              (return (call eager-type item property))
            )
            (+= position 1)
          )
        )
      )
    )
    (return no-type)
  )
  (fn-do _ eager-slot U32
    (param item TypeId)
    (param key-syntax SyntaxId)
    ; The place in an item's layout of the stored field a constant index names.
    (match? ([] (. tree nodes) key-syntax)
      (case (call .node-integer-syntax row)
        (let literal (call parse-integer-literal (. row value)))
        (if (or (. literal negative) (. literal overflow))
          (return (. U32 max))
        )
        (call (. types complete) item)
        (let range (. ([] (. types completions) item) properties))
        (let position 0u32)
        (for (in offset (..< 0 (. range count)))
          (let property ([] (. types properties) (as (+ (. range start) offset) Index)))
          (if (== (. property storage-kind) .storage-eager)
            (if (== position (. literal value))
              (return (. property slot))
            )
            (+= position 1)
          )
        )
      )
    )
    (return (. U32 max))
  )
  (fn-do _ published-payload TypeId
    (param target SyntaxId)
    ; What an event publishes, when a write names an event of this object or of a local one, and
    ; no type when it names anything else.
    (let receiver no-type)
    (let name (? Atom) null)
    (match? ([] (. tree nodes) target)
      (case (call .node-identifier row)
        (if (== (. (call (. bindings resolution-of) (. frame binding) target) kind) .resolve-member)
          (= receiver (. frame self-type))
          (= name (. row name))
        )
      )
      (case (call .node-get-expression get)
        (let simple
          (match ([] (. tree nodes) (. get object))
            (case .node-identifier
              true
            )
            (default
              false
            )
          )
        )
        (if (and simple (not (. get is-optional)))
          (= receiver (call infer (. get object)))
          (= name (. get name))
        )
      )
    )
    (if (or (not name) (== receiver no-type) (== receiver invalid-type))
      (return no-type)
    )
    (if (call (. types is-optional) receiver)
      (= receiver (call (. types optional-inner) receiver))
    )
    (return (call event-payload receiver name))
  )
  (fn-expr _ event-payload TypeId
    (param receiver TypeId)
    (param name Atom)
    (if-expr found (. found payload) no-type)
    (where
      (lazy found (call event-of receiver name))
    )
  )
  (fn-do _ event-of (? NamedEvent)
    (param receiver TypeId)
    (param name Atom)
    (param anywhere Bool (= false))
    ; The event of this name a class declares or inherits, or an interface it is of declares, as
    ; the type that declares it has it, or none where none does, or one it keeps from the module
    ; asking, unless it is asked for `anywhere`.
    (for (in cursor (call event-chain receiver))
      (match? ([] (. types rows) cursor)
        (case (call .type-class row)
          (let found (call declared-event (. row module) (. row decl) name))
          (if found
            (let home (. found module))
            (match? ([] (. ([] (. program modules) home) decls) (. found decl))
              (case (call .decl-event event)
                (let hidden (not (call (. program reaches-access) module home (. event access))))
                (if (and hidden (not anywhere))
                  (return null)
                )
                (let private (not (is (. event access) .public-access)))
                (return
                  (call NamedEvent
                    (block
                      (arg cursor)
                      (arg name)
                      (arg (call declared-payload cursor (. event type-syntax) home))
                      (arg (call declared-key cursor (. event key-type) home))
                      (arg 0)
                      (arg private)
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
    (return null)
  )
  (fn-do _ declared-event (? DeclRef)
    (param class-module ModuleId)
    (param class-decl DeclId)
    (param name Atom)
    ; The event of a name a class declares, in its body or in a facet of it this module sees, as the
    ; module and the declaration that declare it.
    (let target ([] (. program modules) class-module))
    (match? ([] (. target decls) class-decl)
      (case (call .decl-class class)
        (return-if (call DeclRef class-module found) (if found))
        (blank)
        (lazy found (call (. target member-event) (. class members) name))
      )
    )
    (let facets (. program facets))
    (return-if null (if (== (. facets count) 0)))
    (blank)
    (let (tuple start end) (call (. facets class-range) class-module class-decl))
    (for (in position (..< start end))
      (let facet ([] (. facets class-facets) position))
      (if (and (== ([] (. facets states) facet) .facet-bound) (call (. program sees-facet) module facet))
        (let home ([] (. facets modules) facet))
        (match? ([] (. ([] (. program modules) home) decls) ([] (. facets decls) facet))
          (case (call .decl-extension row)
            (return-if (call DeclRef home found) (if found))
            (blank)
            (lazy found (call (. ([] (. program modules) home) member-event) (. row members) name))
          )
        )
      )
    )
    (return null)
  )
  (fn-do _ event-chain (list TypeId)
    (param receiver TypeId)
    ; The types whose declared events a type has: the type, the classes above it, and the
    ; interfaces each of them is of, each once.
    (let chain (list TypeId))
    (let cursor receiver)
    (while (!= cursor no-type)
      (+= chain cursor)
      (= cursor (?? (call (. types base-of) cursor) no-type))
    )
    (let index Index 0)
    (while (< index (. chain length))
      (for (in interface (call (. types interfaces-of) ([] chain index)))
        (let known false)
        (for (in held chain)
          (= known (or known (== held interface)))
        )
        (if (not known)
          (+= chain interface)
        )
      )
      (+= index 1)
    )
    (return chain)
  )
  (fn-do _ read-event Found
    (param id SyntaxId)
    (param receiver TypeId)
    (param name Atom)
    (param want Want)
    ; A node that names an event of an object, which is used as `use-event` says. One private to
    ; another module is an error at its declaration, as the reference finds it.
    (let found (call event-of receiver name))
    (if (and (not found) (call hides-event receiver name))
      (return (call Found invalid-type))
    )
    (if (or (not found) (== (. found payload) no-type))
      (call decline id)
      (return (call Found invalid-type))
    )
    (return (call use-event id found want))
  )
  (fn-do _ hides-event Bool
    (param receiver TypeId)
    (param name Atom)
    ; Whether the event of this name a class declares or inherits, or an interface it is of
    ; declares, is kept from this module, which is reported where the event is declared.
    (for (in cursor (call event-chain receiver))
      (match? ([] (. types rows) cursor)
        (case (call .type-class row)
          (let found (call declared-event (. row module) (. row decl) name))
          (if found
            (let home (. found module))
            (match? ([] (. ([] (. program modules) home) decls) (. found decl))
              (case (call .decl-event event)
                (if (not (call (. program reaches-access) module home (. event access)))
                  (let message
                    (call (. program store-atom)
                      (block
                        (arg (call hidden-message "Event" name (. event access)))
                      )
                    )
                  )
                  (call (. facts record-diagnostic) instance home (. event syntax) .stated message)
                  (return true)
                )
              )
            )
          )
        )
      )
    )
    (return false)
  )
  (fn-do _ use-event Found
    (param id SyntaxId)
    (param event NamedEvent)
    (param want Want)
    ; A node that names an event, where something uses it as the reference does: a write that
    ; publishes to it, a loop that subscribes to it, an index that addresses it with a key, or
    ; `rekey` or `release` of an address asks for it at the node, and a value of the event's
    ; `Broadcastable`, an argument of a call, as the reference gives an event to a parameter, or the
    ; container of a comprehension on a stream, takes its endpoint. The node has that
    ; `Broadcastable`'s type. So has one in an argument of a call of a name nothing declares, which
    ; is reported as no function found (`names-nothing`). One used as a value is reported as
    ; `refuse-event-value` says (`misused-event`), and an argument one converted by a converter as
    ; `misused-endpoint` says, and one read with `<-` as `refuse-event-read` says. The value stored
    ; in a property is taken once the property is known (`store-event`). Naming an event anywhere
    ; else, a keyed one with no address among them, is not supported.
    (let broadcastable (call endpoint-of event))
    (if (== broadcastable invalid-type)
      (call decline id)
      (return (call Found invalid-type))
    )
    (if (call (. want asks) .want-event)
      (return (call Found broadcastable no-type (call found-event event)))
    )
    (if (call (. want asks) .want-adapt)
      (call escape-event id event broadcastable id)
      (return (call Found broadcastable))
    )
    (if (and (call (. want asks) .want-escape) (== (. want type) broadcastable))
      (call escape-event id event broadcastable (. want place))
      (return (call Found broadcastable))
    )
    (if (call misused-event id broadcastable want)
      (call refuse-event-value id (. event owner) (. event name))
      (return (call Found invalid-type))
    )
    (if (call (. want asks) .want-store)
      (return (call Found broadcastable no-type (call found-event event)))
    )
    (if (. argument-typing unknown-callee)
      (return (call Found broadcastable))
    )
    (if (and (call (. want asks) .want-argument) (or (== (. event key) no-type) (!= (. event address) 0)))
      (call escape-event id event broadcastable id)
      (+= endpoint-arguments id)
      (+= endpoint-events event)
      (return (call Found broadcastable))
    )
    (if (call (. tree reads-once) id)
      (call refuse-event-read id (. event owner) (. event name))
      (return (call Found invalid-type))
    )
    (call (. frame diagnose) id .not-supported)
    (return (call Found invalid-type))
  )
  (fn-do _ address-event Found
    (param id SyntaxId)
    (param key-syntax SyntaxId)
    (param is-optional Bool)
    (param event NamedEvent)
    (param want Want)
    ; A keyed event indexed with a key, as the reference addresses one: the key is converted at
    ; its node to the event's key type, and the index names the event at that address, used as
    ; `use-event` says. A negative number written as the key is not supported, which the
    ; reference checks against the `U64` the address holds as well and rejects.
    (if is-optional
      (call (. frame diagnose) id .stated (call (. program store-atom) "Addressed event lookup cannot be optional"))
      (return (call Found invalid-type))
    )
    (if (!= (. event address) 0)
      (call (. frame diagnose) id .stated (call (. program store-atom) "An addressed event cannot be indexed again"))
      (return (call Found invalid-type))
    )
    (if (== (. event key) no-type)
      (call (. frame diagnose) id .stated (call (. program store-atom) (str "Event \"" (. event name text) "\" is not keyed")))
      (return (call Found invalid-type))
    )
    (if (or (== (. event key) invalid-type) (not (call event-key (. event key))))
      (call decline id)
      (return (call Found invalid-type))
    )
    (let key (call infer key-syntax))
    (if (or (== key invalid-type) (== (call (. conversions convert) key-syntax key-syntax key (. event key) .reason-argument) invalid-type))
      (return (call Found invalid-type))
    )
    (if (call (. tree negative-literal) key-syntax)
      (call decline key-syntax)
      (return (call Found invalid-type))
    )
    (return
      (call use-event
        (block
          (arg id)
          (arg (call NamedEvent (. event owner) (. event name) (. event payload) (. event key) id (. event is-private)))
          (arg want)
        )
      )
    )
  )
  (fn-do _ unaddressed Bool
    (param id SyntaxId)
    (param event NamedEvent)
    ; Whether an event published by key is used with no key, which is an error at the node.
    (if (or (== (. event key) no-type) (!= (. event address) 0))
      (return false)
    )
    (call (. frame diagnose)
      (block
        (arg id)
        (arg .stated)
        (arg (call (. program store-atom) (str "Keyed event \"" (. event name text) "\" must be addressed with [key]")))
      )
    )
    (return true)
  )
  (fn-do _ publish-event TypeId
    (param id SyntaxId)
    (param reference SyntaxId)
    (param event NamedEvent)
    (param arguments Arguments)
    ; A write to an event, as the reference publishes one: what it is given is made the event's
    ; payload, but only where something listens, which the event runtime answers for the object,
    ; and the runtime then publishes it. A `RoutedEvent` is always made and published along its
    ; route of owners, from the object on. An event that bubbles (`event-node`) is published along
    ; the parents of its object where its payload has no route of its own, and asks whether
    ; anything listens on the object or anywhere it could bubble to. A keyed event is published at
    ; its address, where the runtime answers with the generation of the receiver there, and is given
    ; it to publish with.
    (if (!= (. event payload) (. types void-type))
      (let site ([] (. arguments syntax) 0))
      (let given (call (. calls payload-argument) arguments 0 (. event payload)))
      (if (== (call (. conversions convert) site site given (. event payload) .reason-argument) invalid-type)
        (return invalid-type)
      )
      (call note-payload-effects site (. event name))
    )
    (if (and (call routes (. event payload)) (!= (. event key) no-type))
      (call (. frame diagnose) id .stated (call (. program store-atom) "Keyed events cannot use routed publication"))
      (return invalid-type)
    )
    (if (call routes (. event payload))
      (let node (call event-node reference event))
      (let mark (. scratch types mark))
      (call (. scratch types push) (. event payload))
      (call (. scratch types push) (. types size-type))
      (call (. scratch types push) (call pointer-to (call (. types type-row) .uint8)))
      (if (!= node no-type)
        (call (. scratch types push) node)
      )
      (call (. scratch types push) (. event payload))
      (let routing (if-expr (!= node no-type) "event-publish-routed-node" "event-publish-routed"))
      (let route
        (call (. calls demand-runtime-call)
          (block
            (arg (. types event-endpoint-decl module))
            (arg no-type)
            (arg (call (. program store-atom) routing))
            (arg mark)
            (arg 1)
          )
        )
      )
      (call (. scratch types rewind) mark)
      (if (== route no-instance)
        (call decline id)
        (return invalid-type)
      )
      (+= (. facts event-uses)
        (call EventUse
          (block
            (arg instance)
            (arg id)
            (arg reference)
            (arg (. event owner))
            (arg (. event name))
            (arg .event-route)
            (arg route)
            (arg no-instance)
            (arg no-instance)
            (arg 0)
            (arg (!= node no-type))
          )
        )
      )
      (call (. instances mark-may-panic) instance)
      (return (. types void-type))
    )
    (if (call unaddressed id event)
      (return invalid-type)
    )
    (let keyed (!= (. event address) 0))
    (let node (if-expr keyed no-type (call event-node reference event)))
    (let interest
      (block
        (case? keyed
          (call event-call "event-keyed-interest-generation" (. event payload) no-type 2)
        )
        (default
          (call event-call
            (block
              (arg (if-expr (!= node no-type) "event-has-route-interest" "event-has-interest"))
              (arg no-type)
            )
          )
        )
      )
    )
    (let publish no-instance)
    (if keyed
      (= publish (call event-call "event-publish-keyed" (. event payload) (. event payload) 3))
      (else-if (!= node no-type)
        (let mark (. scratch types mark))
        (call (. scratch types push) (. event payload))
        (call (. scratch types push) (call pointer-to (call (. types type-row) .uint8)))
        (call (. scratch types push) (. types size-type))
        (call (. scratch types push) node)
        (call (. scratch types push) (. event payload))
        (= publish
          (call (. calls demand-runtime-call)
            (block
              (arg (. types event-endpoint-decl module))
              (arg no-type)
              (arg (call (. program store-atom) "event-publish-node"))
              (arg mark)
              (arg 1)
            )
          )
        )
        (call (. scratch types rewind) mark)
      )
      (else
        (= publish (call event-call "event-publish" (. event payload) (. event payload)))
      )
    )
    (if (or (== interest no-instance) (== publish no-instance))
      (call decline id)
      (return invalid-type)
    )
    (+= (. facts event-uses)
      (call EventUse
        (block
          (arg instance)
          (arg id)
          (arg reference)
          (arg (. event owner))
          (arg (. event name))
          (arg .event-publish)
          (arg interest)
          (arg publish)
          (arg no-instance)
          (arg (. event address))
          (arg (!= node no-type))
        )
      )
    )
    (call (. instances mark-may-panic) instance)
    (return (. types void-type))
  )
  (fn-do _ event-node TypeId
    (param reference SyntaxId)
    (param event NamedEvent)
    ; The `EventNode` an event is published along, where it bubbles: one that is public and is
    ; published by no key, on an object whose class is an `EventNode`, which is converted at the node
    ; that names the event (`reason-event-node`). No type where it does not bubble.
    (if (or (. event is-private) (!= (. event key) no-type))
      (return no-type)
    )
    (let node (call (. types well-known-type) "core/event" "EventNode"))
    (if (or (== node invalid-type) (== node no-type))
      (return no-type)
    )
    (let receiver (call event-receiver reference))
    (if (or (== receiver no-type) (== receiver invalid-type) (!= (call (. types intrinsic-of) receiver) .class))
      (return no-type)
    )
    (if (== (call derived-interface receiver (call class-ref types node)) no-type)
      (return no-type)
    )
    (if (== (call (. conversions convert) reference reference receiver node .reason-event-node) invalid-type)
      (return no-type)
    )
    (return node)
  )
  (fn-do _ event-receiver TypeId
    (param reference SyntaxId)
    ; The type of the object a node that names an event publishes on, as the emitter evaluates it
    ; (`Emitter.event-owner`).
    (match? ([] (. tree nodes) reference)
      (case (call .node-get-expression get)
        (let object (call (. facts node-type) instance (. get object)))
        (return (call link-receiver (. get object) object no-type (call chains-at reference (. get is-optional))))
      )
      (case (call .node-identifier row)
        (if (!= (/and/ reference-flags (. ResolutionFlag resolution-received)) 0)
          (return (call received-parent reference (. row name)))
        )
        (lazy reference-flags (. (call (. bindings resolution-of) (. frame binding) reference) flags))
        (return (. frame self-type))
      )
    )
    (return no-type)
  )
  (fn-do _ note-payload-effects _
    (param payload SyntaxId)
    (param event Atom)
    ; Records the effects the payload of an event has (`PayloadEffectFact`), as the reference finds
    ; them as it makes the payload: a call of a `do` function other than a constructor, an assignment
    ; used as a value, and a write to a channel, the first of each as the reference meets it. A
    ; function written in the payload runs where it is called, not where it is made.
    (if (or (not (. lint traces)) (== payload 0))
      (return)
    )
    (let written payload)
    (match? ([] (. tree nodes) payload)
      (case (call .node-argument row)
        (= written (. row expr))
      )
    )
    (let start (call (. tree subtree-start) written))
    (let firsts (list U32))
    (for (in _ (..< 0 3))
      (+= firsts (. U32 max))
    )
    (let id written)
    (while (>= id start)
      (let key (. U32 max))
      (let kind (. PayloadEffectKind effect-call))
      (let nested false)
      (match? ([] (. tree nodes) id)
        (case .node-function-syntax
          (= nested true)
        )
        (case .node-assign
          (match ([] (. tree nodes) (call (. tree holder-of) id))
            (case .node-block
              (= key (. U32 max))
            )
            (default
              (= key (call (. tree subtree-start) id))
              (= kind .effect-assignment)
            )
          )
        )
        (case (call .node-binary-expression row)
          (if (== (. row op) .write-op)
            (= key (call (. tree subtree-start) id))
            (= kind .effect-channel-write)
          )
        )
        (case (call .node-call-expression row)
          (match? ([] (. tree nodes) (. row callable))
            (case (call .node-get-expression get)
              (if (and (== (. get name text) "<-write") (not (. get is-optional)))
                (= key (call (. tree subtree-start) id))
                (= kind .effect-channel-write)
              )
            )
          )
        )
      )
      (if nested
        (= id (call (. tree subtree-start) id))
        (else
          (if (and (!= key (. U32 max)) (< key ([] firsts kind)))
            (= ([] firsts kind) key)
          )
          (if (and (< id ([] firsts 0)) (call calls-imperative id))
            (= ([] firsts 0) id)
          )
        )
      )
      (if (<= id start)
        (break)
      )
      (-= id 1)
    )
    (while true
      (let next 3u32)
      (for (in position (..< 0 3))
        (if (and (!= ([] firsts position) (. U32 max)) (or (== next 3) (< ([] firsts position) ([] firsts next))))
          (= next (as position U32))
        )
      )
      (if (== next 3)
        (break)
      )
      (= ([] firsts next) (. U32 max))
      (call (. lint payload-effects append)
        (block
          (arg (call PayloadEffectFact instance written event (as next PayloadEffectKind)))
        )
      )
    )
  )
  (fn-do _ calls-imperative Bool
    (param id SyntaxId)
    ; Whether a node calls a `do` function other than a constructor, as a function, a method, an
    ; operator or a static method.
    (let cursor (call (. facts first-call) instance id))
    (while (!= cursor no-fact)
      (let call ([] (. facts calls) cursor))
      (= cursor (. call next))
      (let plain (or (== (. call form) .call-function) (== (. call form) .call-method)))
      (if (or (== (. call callee) no-instance) (not (or plain operator-or-static)))
        (continue)
      )
      (lazy operator-or-static (or (== (. call form) .call-operator) (== (. call form) .call-static)))
      (let row ([] (. instances rows) (. call callee)))
      (let checked (call describe program (. row module) (. row decl)))
      (if (and checked (. checked is-imperative) (not (call is-constructor-kind (. checked kind))))
        (return true)
      )
    )
    (return false)
  )
  (fn-do _ readdress-event TypeId
    (param id SyntaxId)
    (param reference SyntaxId)
    (param event NamedEvent)
    (param arguments Arguments)
    (param rekeys Bool)
    ; `rekey` or `release` of the address of a keyed event, as the reference makes them: the
    ; receiver, which claimed the endpoint there, gives the address a new key, the call's
    ; argument converted to the event's key type, or gives it up. The errors `rekey` raises leave
    ; the function with the call, or under `catch` the call gives nothing or one of them.
    (let verb (if-expr rekeys "rekey" "release"))
    (if (== (. event address) 0)
      (call (. frame diagnose) id .stated (call (. program store-atom) (str verb " requires an addressed keyed event")))
      (return invalid-type)
    )
    (if rekeys
      (let site ([] (. arguments syntax) 0))
      (if (== (call (. conversions convert) site site ([] (. arguments types) 0) (. event key) .reason-argument) invalid-type)
        (return invalid-type)
      )
    )
    (if (not (call is-owner))
      (call (. frame diagnose)
        (block
          (arg id)
          (arg .stated)
          (arg (call (. program store-atom) (str verb " requires the stable target/address lifetime")))
        )
      )
      (return invalid-type)
    )
    (let called
      (block
        (case? rekeys
          (call event-call "event-keyed-rekey" (. event payload) no-type 5)
        )
        (default
          (call event-call "event-keyed-release" (. event payload) no-type 3)
        )
      )
    )
    (if (== called no-instance)
      (call decline id)
      (return invalid-type)
    )
    (let caught (and (!= (. frame surround catch-depth) 0) (== (. frame surround transformer-depth) 0)))
    (if caught
      (call demand-errors called)
      (else-if (not (call raises-out id called))
        (call decline id)
        (return invalid-type)
      )
    )
    (let kind (if-expr rekeys (. EventUseKind event-rekey) (. EventUseKind event-release)))
    (+= (. facts event-uses)
      (call EventUse
        (block
          (arg instance)
          (arg id)
          (arg reference)
          (arg (. event owner))
          (arg (. event name))
          (arg kind)
          (arg called)
          (arg no-instance)
          (arg no-instance)
          (arg (. event address))
        )
      )
    )
    (call (. instances mark-may-panic) instance)
    (let signature ([] (. instances signatures) called))
    (if (and caught (!= (. signature errors count) 0))
      (return (call result-type types (. types void-type) (call (. calls error-items) signature)))
    )
    (return (. types void-type))
  )
  (fn-do _ raises-out Bool
    (param site SyntaxId)
    (param callee InstanceId)
    ; Notes the errors a function of the event or markup runtime raises as leaving the function at
    ; a node, as those of a call written there do. Where they would be caught or transformed there,
    ; which has no shape here, it says no.
    (call demand-errors callee)
    (let signature ([] (. instances signatures) callee))
    (if (== (. signature errors count) 0)
      (return true)
    )
    (if (or (!= (. frame surround catch-depth) 0) (!= (. frame surround transformer-depth) 0))
      (return false)
    )
    (for (in offset (..< 0 (. signature errors count)))
      (call note-outgoing ([] (. instances signature-types) (+ (. signature errors start) offset)) site)
    )
    (return true)
  )
  (fn-expr _ routes Bool
    (param payload TypeId)
    ; Whether an event's payload is a `RoutedEvent`, which the reference publishes along a route of
    ; owners.
    (and (!= routed invalid-type) (!= (call derived-interface payload (call class-ref types routed)) no-type))
    (where
      (lazy routed (call (. types well-known-type) "core/event" "RoutedEvent"))
    )
  )
  (fn-do _ event-call InstanceId
    (param name String)
    (param payload TypeId)
    (param given TypeId (= no-type))
    (param words Size (= 0))
    ; A function of the event runtime that compiled code calls of its own accord, for an object and
    ; the number of one of its events, then as many `U64` words as it is given, the halves of the
    ; keys of an address, a generation, or the identity of a receiver, then `given` where there is
    ; one: with `payload` as its type argument where there is one.
    (let mark (. scratch types mark))
    (if (!= payload no-type)
      (call (. scratch types push) payload)
    )
    (call (. scratch types push) (call pointer-to (call (. types type-row) .uint8)))
    (call (. scratch types push) (. types size-type))
    (for (in _ (..< 0 words))
      (call (. scratch types push) (call (. types type-row) .uint64))
    )
    (if (!= given no-type)
      (call (. scratch types push) given)
    )
    (let explicit Size (if-expr (!= payload no-type) 1 0))
    (let called
      (call (. calls demand-runtime-call)
        (block
          (arg (. types event-endpoint-decl module))
          (arg no-type)
          (arg (call (. program store-atom) name))
          (arg mark)
          (arg explicit)
        )
      )
    )
    (call (. scratch types rewind) mark)
    (return called)
  )
  (fn-do _ escape-event _
    (param id SyntaxId)
    (param event NamedEvent)
    (param broadcastable TypeId)
    (param place SyntaxId)
    ; An event made the `Broadcastable` a value is wanted as: the endpoint the event runtime keeps
    ; for it on the object, made where the node is, converted there. One at the address of a keyed
    ; event is claimed for the receiver (see `claim-endpoint`), and its key must name what lasts as
    ; long as the address does. What is wrong with it is an error where the value is converted, at
    ; the type a declaration states (`place`).
    (if (call unaddressed place event)
      (return)
    )
    (if (and (!= (. event address) 0) (not (call (. tree stable-key) (call (. tree index-key) (. event address)))))
      (let message
        (paragraph
          "A temporary keyed event address cannot escape; declare a stable address key and use that stable addressed lifetime"
        )
      )
      (call (. frame diagnose) place .stated (call (. program store-atom) message))
      (return)
    )
    (let adapter
      (block
        (case? (!= (. event address) 0)
          (call event-call "event-keyed-adapter" (. event payload) no-type 3)
        )
        (default
          (call event-call "event-adapter" (. event payload))
        )
      )
    )
    (if (== adapter no-instance)
      (call decline id)
      (return)
    )
    (if (and (!= (. event address) 0) (not (call claim-endpoint id place (. event address) adapter)))
      (return)
    )
    (call (. conversions convert) id id (. ([] (. instances signatures) adapter) returns) broadcastable .reason-argument)
    (+= (. facts event-uses)
      (call EventUse
        (block
          (arg instance)
          (arg id)
          (arg id)
          (arg (. event owner))
          (arg (. event name))
          (arg .event-escape)
          (arg adapter)
          (arg no-instance)
          (arg no-instance)
          (arg (. event address))
        )
      )
    )
    (call (. instances mark-may-panic) instance)
  )
  (fn-do _ claim-endpoint Bool
    (param site SyntaxId)
    (param place SyntaxId)
    (param address SyntaxId)
    (param made InstanceId)
    ; The endpoint at the address of a keyed event, which `made` gives, claimed for the receiver as
    ; the reference claims it: the receiver's identity is given for it, its errors leave the
    ; function at `site`, and a `ClosableTracker` of it, held by a live action of the receiver,
    ; closes it with the receiver. Says whether it is claimed; it is an error at `place` where
    ; there is no receiver.
    (if (not (call is-owner))
      (let message
        (paragraph
          "An addressed event subscription or adapter requires a stable target/address lifetime"
        )
      )
      (call (. frame diagnose) place .stated (call (. program store-atom) message))
      (return false)
    )
    (call demand-live-runtime)
    (let closable (call (. types well-known-type) "core/stream" "Closable"))
    (let tracking (call (. types well-known-type) "core/tracker" "ClosableTracker"))
    (let tracker (call (. types well-known-type) "core/tracker" "Tracker"))
    (if (or (== closable invalid-type) (== tracking invalid-type) (== tracker invalid-type) live-missing)
      (call decline site)
      (return false)
    )
    (lazy live-missing (or (== (. instances live add-tracker) no-instance) (== (. instances live action) no-instance)))
    (let mark (. scratch types mark))
    (call (. scratch types push) closable)
    (let closer (call (. calls demand-constructor) tracking mark))
    (call (. scratch types rewind) mark)
    (if (or (== closer no-instance) (not (call raises-out site made)))
      (call decline site)
      (return false)
    )
    (let named (call (. tree index-object) address))
    (call (. conversions convert) named named (. ([] (. instances signatures) made) returns) closable .reason-argument)
    (call (. conversions convert) named named (. ([] (. instances signatures) closer) returns) tracker .reason-argument)
    (+= (. facts address-claims) (call AddressClaim instance named closer))
    (return true)
  )
  (fn-do _ declared-key TypeId
    (param owner TypeId)
    (param syntax SyntaxId)
    (param home ModuleId)
    ; The type of the key an event is published by, or none where it is published by none. A key
    ; whose type is not known is the invalid type.
    (if (== syntax 0)
      (return no-type)
    )
    (let key (call declared-payload owner syntax home))
    (return (if-expr (== key no-type) invalid-type key))
  )
  (fn-do _ declared-payload TypeId
    (param owner TypeId)
    (param syntax SyntaxId)
    (param home ModuleId)
    ; The type an event of a class publishes, written in the module that declares the event: the
    ; class's own, or a facet's.
    (if (== syntax 0)
      (return (. types void-type))
    )
    (let payload invalid-type)
    (match? ([] (. types rows) owner)
      (case (call .type-class row)
        (let env (call (. types class-env-for) (. row module) (. row decl) (. row args) owner))
        (let tree (. ([] (. program modules) home) tree))
        (= payload (call (. types evaluate-type) home tree syntax env))
        (call (. types env-release) env)
      )
    )
    (return (if-expr (== payload invalid-type) no-type payload))
  )
  (fn-do _ declares-event Bool
    (param receiver TypeId)
    (param name Atom)
    (for (in cursor (call event-chain receiver))
      (match? ([] (. types rows) cursor)
        (case (call .type-class row)
          (return-if true (if (!= (call declared-event (. row module) (. row decl) name) null)))
        )
      )
    )
    (return false)
  )
  (fn-do _ declares-method Bool
    (param receiver TypeId)
    (param name Atom)
    (let cursor receiver)
    (while (!= cursor no-type)
      (match? ([] (. types rows) cursor)
        (case (call .type-class row)
          (let target ([] (. program modules) (. row module)))
          (match? ([] (. target decls) (. row decl))
            (case (call .decl-class class)
              (for (in member (call (. target members-named) (. class members) name))
                (match? ([] (. target decls) member)
                  (case (call .decl-function fn)
                    (if (and written (== (. fn kind) .function-decl) same-name)
                      (return true)
                    )
                    (lazy written (and (not (. fn is-generated)) (not (. fn is-static))))
                    (lazy same-name (and (. fn name) (== (. fn name) name)))
                  )
                )
              )
            )
          )
        )
      )
      (= cursor (?? (call (. types base-of) cursor) no-type))
    )
    (return false)
  )
  (fn-do _ inherited-getter-type TypeId
    (param self TypeId)
    ; The type a getter that states none returns where it is over one a base states the type of,
    ; which each getter over that one keeps.
    (return-if no-type (if (or (== self no-type) (== self invalid-type))))
    (blank)
    (match? ([] (. ([] (. program modules) module) decls) (. frame decl))
      (case (call .decl-function fn)
        (let name (. fn name))
        (if (and (== (. fn kind) .getter-decl) (== (. fn return-type) 0) name)
          (call (. types complete) self)
          (let base (?? (call (. types base-of) self) no-type))
          (if (and (!= base no-type) (call states-getter-type base name))
            (let inherited (call property-named base name))
            (if inherited
              (return (. ([] (. types properties) inherited) type))
            )
          )
        )
      )
    )
    (return no-type)
  )
  (fn-do _ states-getter-type Bool
    (param receiver TypeId)
    (param name Atom)
    ; Whether the getter of this name that the receiver declares or inherits states its type
    ; where it is first declared, the farthest base that declares one: each getter over it has
    ; the type it states there, as TypeScript gives each inherited property its base's.
    (let stated false)
    (let cursor receiver)
    (while (!= cursor no-type)
      (match? ([] (. types rows) cursor)
        (case (call .type-class row)
          (let target ([] (. program modules) (. row module)))
          (match? ([] (. target decls) (. row decl))
            (case (call .decl-class class)
              (for (in member (call (. target members-named) (. class members) name))
                (match? ([] (. target decls) member)
                  (case (call .decl-function fn)
                    (if (and (== (. fn kind) .getter-decl) (== (. fn name) name))
                      (= stated (!= (. fn return-type) 0))
                    )
                  )
                )
              )
            )
          )
        )
      )
      (= cursor (?? (call (. types base-of) cursor) no-type))
    )
    (return stated)
  )
  (fn-expr _ is-array-field Bool
    (param receiver TypeId)
    (param name Atom)
    (case? (and (!= name (!! (. types size-atom))) (!= name (!! (. types length-atom))) (!= name (!! (. types data-atom))))
      false
    )
    (default
      (match ([] (. types rows) receiver)
        (case (call .type-class row)
          (and (== (. row module) (. array module)) (== (. row decl) (. array decl)) (== (. row args count) 2))
        )
        (default
          false
        )
      )
    )
    (where
      (lazy array (. types array-decl))
    )
  )
  (fn-do _ check-constructor-fills _
    (let filling (list SlotId))
    (let owner-module ([] (. program modules) module))
    (let owner 0u32)
    (let args (call (of RowRange ArgumentShape)))
    (match? ([] (. owner-module decls) (. frame decl))
      (case (call .decl-function fn)
        (= owner (. fn owner))
        (= args (. fn args))
      )
    )
    (if (== owner 0)
      (return)
    )
    (if (call names-given)
      (call decline (. frame declaration body))
      (return)
    )
    (let position 0u32)
    (for (in shape ([] (. owner-module arg-pool) args))
      (let name (call pattern-name types tree (. shape pattern)))
      (if (and name (not (call redefaults position)))
        (let property (call owner-property program module owner name))
        (if (!= property 0)
          (call fill-property name property (call argument-slot position) (. shape pattern))
          (else
            (call fill-inherited name (call argument-slot position) (. shape pattern))
          )
        )
      )
      (+= position 1)
    )
    (for (in statement ([] (. tree children) (call body-statements)))
      (match? ([] (. tree nodes) statement)
        (case (call .node-declare row)
          (let slot (only-if (call declaring-slot (. row left)) (if (. row is-lazy))))
          (if slot
            (let name (. ([] (. bindings slots) slot) name))
            (let property (call owner-property program module owner name))
            (if (and declared-property (call (. tree is-typed) (. row left)))
              (call (. frame diagnose)
                (block
                  (arg (. row left))
                  (arg .stated)
                  (arg (call (. program store-atom) "Illegal to redefine property type"))
                )
              )
              (return)
            )
            (lazy declared-property (or (!= property 0) (call property-named (. frame self-type) name)))
            (if (!= property 0)
              (call read-slot slot)
              (call fill-property name property slot (. row right))
              (+= filling slot)
              (else-if (call property-named (. frame self-type) name)
                (call read-slot slot)
                (call fill-inherited name slot (. row right))
                (+= filling slot)
              )
            )
          )
        )
      )
    )
    (if (call fills-share filling)
      (= (. ([] (. instances rows) instance) fills-share) true)
    )
    (if (and (== (. frame declaration kind) .constructor-decl) (not (call returns-own tree (. frame declaration body))))
      (call check-initializer-reads)
    )
  )
  (fn-do _ names-given Bool
    ; Whether the body of a constructor names a property a markup element gives it the value
    ; of: the name is then a constant that holds the value, which has no shape here yet.
    (let given (. ([] (. instances rows) instance) fills))
    (let body (. frame declaration body))
    (if (or (== (. given count) 0) (== body 0))
      (return false)
    )
    (for (in node (..< (call (. tree subtree-start) body) body))
      (let name (? Atom) null)
      (match? ([] (. tree nodes) node)
        (case (call .node-identifier row)
          (= name (. row name))
        )
        (case (call .node-ref-identifier row)
          (= name (. row name))
        )
        (case (call .node-declare row)
          (let slot (call declaring-slot (. row left)))
          (if slot
            (= name (. ([] (. bindings slots) slot) name))
          )
        )
      )
      (if name
        (for (in offset (..< 0 (. given count)))
          (if (== (. ([] (. types properties) ([] (. instances fill-places) (+ (. given start) offset))) name) name)
            (return true)
          )
        )
      )
    )
    (return false)
  )
  (fn-do _ fills-share Bool
    (param filling (list SlotId))
    ; Whether the lazy locals a constructor gives its properties their values from, or the lazy
    ; locals their values read in turn, are captured by nested functions or make one.
    (let seen (list SlotId))
    (let pending (list SlotId))
    (for (in slot filling)
      (+= pending slot)
    )
    (while (!= (. pending length) 0)
      (let slot (call (. pending pop)))
      (if (!= (call (. seen find) slot) null)
        (continue)
      )
      (+= seen slot)
      (let row ([] (. bindings slots) slot))
      (if (!= (/and/ (. row flags) (. SlotFlag slot-captured)) 0)
        (return true)
      )
      (let value (call (. tree lazy-value) (. row group)))
      (if (== value 0)
        (continue)
      )
      (for (in node (..< (call (. tree subtree-start) value) (+ value 1)))
        (match? ([] (. tree nodes) node)
          (case .node-function-syntax
            (return true)
          )
          (case .node-identifier
            (let resolution (call (. bindings resolution-of) (. frame binding) node))
            (if (and (== (. resolution kind) .resolve-slot) lazy-slot)
              (+= pending (. resolution slot))
            )
            (lazy lazy-slot (== (. ([] (. bindings slots) (. resolution slot)) kind) .slot-lazy))
          )
        )
      )
    )
    (return false)
  )
  (fn-do _ field-reference (? Atom)
    (param id SyntaxId)
    ; The name of a field a node may name: an identifier, or a member read from `this`.
    (match? ([] (. tree nodes) id)
      (case (call .node-identifier row)
        (return (. row name))
      )
      (case (call .node-get-expression row)
        (if (call names-receiver (. row object))
          (return (. row name))
        )
      )
    )
    (return null)
  )
  (fn-expr _ body-statements (of RowRange SyntaxId)
    (match ([] (. tree nodes) (. frame declaration body))
      (case (call .node-block row)
        (. row body)
      )
      (default
        (call (of RowRange SyntaxId))
      )
    )
  )
  (fn-do _ fill-inherited _
    (param name Atom)
    (param slot SlotId)
    (param value-syntax SyntaxId)
    ; An argument or a lazy local named as a property a base class or a facet declares gives that
    ; property its value too. A facet's private property takes none: code outside the facet's file
    ; doesn't see it, and in that file it is refused, since another facet may keep the name as well.
    ; Its conversion to the property's type is recorded at the value: the type written for the
    ; property, or else the type of the value written for it.
    (let found (call property-named (. frame self-type) name))
    (if (not found)
      (return)
    )
    (let facet (. ([] (. types properties) found) facet))
    (if (and (!= facet (. U32 max)) (not (call declares-name ([] (. facets modules) facet) ([] (. facets decls) facet) name true)))
      (if (== ([] (. facets modules) facet) module)
        (let message
          (paragraph
            (str (. name text) " is private to facet " (call facet-name-of facet) ", so a constructor's argument can't give it a value")
          )
        )
        (call (. frame diagnose) value-syntax .stated (call (. program store-atom) message))
      )
      (return)
    )
    (lazy facets (. program facets))
    (let given (call (. frame known) slot))
    (if (or (== given no-type) (== given invalid-type))
      (return)
    )
    (call (. facts record-fill) (call FillFact instance name slot value-syntax))
    (let fact ([] (. types properties) found))
    (let declared (. fact type))
    (if (and (== declared no-type) (!= (. fact storage-kind) .storage-getter))
      (= declared (call demand-member fact (. frame self-type) name))
    )
    (let filled (call (. types optional-inner) given))
    (if (and (!= declared no-type) (!= declared invalid-type) (!= declared filled))
      (call (. conversions convert) value-syntax value-syntax filled declared .reason-assignment)
    )
  )
  (fn-do _ fill-property _
    (param name Atom)
    (param property DeclId)
    (param slot SlotId)
    (param value-syntax SyntaxId)
    ; An argument named as a property the class declares gives the property its value. Its
    ; conversion to the property's type is recorded at the property: the type written, or the one
    ; a class above gave the property, or else the type of the value written for it.
    (let given (call (. frame known) slot))
    (if (or (== given no-type) (== given invalid-type))
      (return)
    )
    (match? ([] (. ([] (. program modules) module) decls) property)
      (case (call .decl-property row)
        (call (. facts record-fill) (call FillFact instance name slot (. row syntax)))
        (let declared invalid-type)
        (let held (call property-named (. frame self-type) name))
        (let above (if-expr held (call first-type ([] (. types properties) held) name) no-type))
        (if (!= (. row type-syntax) 0)
          (= declared (call (. types evaluate-type) module tree (. row type-syntax) (. frame env)))
          (else-if (!= above no-type)
            (= declared above)
          )
          (else-if (!= (. row value) 0)
            (= declared (call literal-type types module tree (. row value) (. frame env)))
          )
        )
        (let filled (call (. types optional-inner) given))
        (if (and (!= declared invalid-type) (!= declared filled))
          (call (. conversions convert) (. row syntax) value-syntax filled declared .reason-assignment)
        )
      )
    )
  )
  (fn-do _ check-property-defaults _
    (param receiver TypeId)
    ; Types the values of the stored properties a constructor is not given, which it evaluates,
    ; so the errors an eager one lets out leave the constructor, at its class. Those of one that
    ; reads something tracked leave the function its live action evaluates it again with too,
    ; which gives them to the global `unhandled-error` (`hands-off`), as the reference's live action
    ; does; where that is not in place it is declined. A tuple's
    ; constructor given some fields is given them by position or by name, which its instance does
    ; not tell: each call types the values of the fields it leaves out (`check-field-default`).
    (= live-owned false)
    (if (or (== receiver no-type) (== receiver invalid-type))
      (return)
    )
    (call (. types complete) receiver)
    (let some
      (scope (and (== (. frame declaration kind) .tuple-constructor-decl) given-args)
        (lazy given-args (!= (. ([] (. instances signatures) instance) args count) 0))
      )
    )
    (for (in property (call (. types properties-of) receiver))
      (let given (and (!= (. property slot) (. U32 max)) some))
      (if (and (!= (. property storage-kind) .storage-getter) (not given))
        (= last-unit no-instance)
        (call demand-member property receiver (. property name) true)
        (if (and (== (. property storage-kind) .storage-eager) (!= last-unit no-instance) live-unit)
          (= live-owned true)
          (call demand-errors last-unit)
          (if (and (!= (. ([] (. instances signatures) last-unit) errors count) 0) (not (call hands-off last-unit)))
            (call decline (call owner-syntax))
          )
        )
        (lazy live-unit (. ([] (. instances rows) last-unit) is-live))
        (if (and (== (. property storage-kind) .storage-eager) (!= last-unit no-instance) other-unit)
          (call note-unit-errors last-unit (call owner-syntax))
          (if (not (call supplies (. property name)))
            (call note-default-use last-unit)
          )
          (call check-shared-machine property receiver)
        )
        (lazy other-unit (!= last-unit instance))
      )
      (if (and (== (. property storage-kind) .storage-eager) (not given))
        (call construct-default property receiver)
      )
    )
  )
  (fn-do _ check-shared-machine _
    (param property TypeProperty)
    (param receiver TypeId)
    ; A class runs the machine a property of it holds, and each machine that one refines, each typed
    ; for the class above it that declares it, and runs the groups at the root of each from its table
    ; where that class does (`lowers-for`). Where a section, a constructor or another machine of the
    ; class or of one between hears the event of such a group, that choice does not hold for it, and
    ; the class has no shape here.
    (if (not (call intrinsic-is-class (call (. types intrinsic-of) receiver)))
      (return)
    )
    (let current (call holding-type receiver (call declaring-holder types property)))
    (while (!= current no-type)
      (let typed current)
      (let level (call class-ref types current))
      (= current (?? (call (. types base-of) current) no-type))
      (let declared
        (scope (if-expr named-level (call class-property level (. property name)) 0)
          (lazy named-level (or (!= (. level module) 0) (!= (. level decl) 0)))
        )
      )
      (if (== declared 0)
        (continue)
      )
      (let owner-tree (. ([] (. program modules) (. level module)) tree))
      (let machine (call (. owner-tree declared-machine) (call declared-value (. level module) declared)))
      (if (== machine 0)
        (return)
      )
      (if (== typed receiver)
        (continue)
      )
      (for (in head (call (. owner-tree group-heads) (call (. owner-tree state-items) (call (. owner-tree state-body) machine))))
        (let written (call (. owner-tree group-stream) head))
        (let event (call own-event typed (. level module) written))
        (if (not event)
          (continue)
        )
        (let theirs (call lowers-for typed (. level module) written event))
        (let mine (call lowers-for receiver (. level module) written event))
        (if (and (!= theirs null) (or (== mine null) (!= mine theirs)))
          (call decline (call owner-syntax))
          (return)
        )
      )
    )
  )
  (fn-expr _ supplies Bool
    (param name Atom)
    ; Whether a constructor gives a property its value: a parameter of its name, a lazy local of its
    ; name, or an attribute a markup element gives. A value that may be null gives none, as the
    ; property then holds what its class writes. A tuple's constructor given no field gives none.
    (case? (== (. frame declaration kind) .tuple-constructor-decl)
      false
    )
    (case? (call is-constructor-initializer name)
      true
    )
    (case? (!= position (. U32 max))
      (and (not (call redefaults position)) (not (call (. types is-optional) (call (. frame known) (call argument-slot position)))))
    )
    (default
      (and (!= filled (. U32 max)) (not (call (. types is-optional) (call (. instances argument-type) instance filled))))
    )
    (where
      (lazy position (call constructor-parameter name))
      (lazy filled (call (. instances fill-argument) instance name))
    )
  )
  (fn-expr _ redefaults Bool
    (param position U32)
    ; Whether a constructor leaves the property its parameter at a place names to the default the
    ; class it makes writes (`Instance.redefaults`).
    (and (< position 32) (!= (/and/ (. ([] (. instances rows) instance) redefaults) (/lshift/ 1u32 position)) 0))
  )
  (fn-do _ note-default-use _
    (param unit InstanceId)
    ; Records the value a type writes for a property, which `unit` types, where a constructor of the
    ; type takes it as written (`DeclaredValueFact`).
    (let row ([] (. instances rows) unit))
    (if (or (!= (. row module) module) (== (. row initializer) 0))
      (return)
    )
    (match? ([] (. ([] (. program modules) (. row module)) decls) (. row initializer))
      (case (call .decl-property property)
        (if (and (!= (. property type-syntax) 0) (!= (. property value) 0))
          (let declared (. ([] (. instances signatures) unit) declared-returns))
          (let found (. ([] (. instances signatures) unit) returns))
          (call note-declared-value
            (block
              (arg 0)
              (arg (. row initializer))
              (arg (. property value))
              (arg (. property type-syntax))
              (arg declared)
              (arg found)
            )
          )
        )
      )
    )
  )
  (fn-do _ holding-type TypeId
    (param receiver TypeId)
    (param ref DeclRef)
    ; The class of a declaration among a class and its bases, as the class holds it: with the
    ; type arguments the class gives it. The class itself when it has no such base.
    (let current receiver)
    (while (!= current no-type)
      (let held (call class-ref types current))
      (if (and (== (. held module) (. ref module)) (== (. held decl) (. ref decl)))
        (return current)
      )
      (= current (?? (call (. types base-of) current) no-type))
    )
    (return receiver)
  )
  (fn-do _ construct-default _
    (param fact TypeProperty)
    (param receiver TypeId)
    ; A stored property with no value written, which the constructor is given none for, holds
    ; what its type constructs with no argument. The construction is recorded at the property,
    ; when the constructor's own module declares it. A constructor of another module has no
    ; place in its own source for it, so the construction is typed there by an instance of its
    ; own for the receiver, as a value written for the property is, and the constructor lets out
    ; its errors at its class and may panic where it may. The first values of a named tuple's or
    ; struct's fields are typed too, which emission gives the fields where the value is made.
    (let ref (call declaring-decl types fact))
    (if (or (== (. fact type) no-type) (== (. fact type) invalid-type) (call names-element types fact))
      (return)
    )
    (let tuple (if-expr (== (. ref decl) 0) (call written-tuple types receiver (. fact owner)) (call DeclRef 0 0)))
    (if (!= (. tuple decl) 0)
      (= ref tuple)
    )
    (let elsewhere (!= (. ref module) module))
    (if (not (call writes-value fact))
      (call demand-first-values (. fact type))
    )
    (if (or (call gives-every-value (. fact name)) (call is-constructor-initializer (. fact name)))
      (return)
    )
    (if (!= (. tuple decl) 0)
      (if (not elsewhere)
        (call construct-value (call written-field program tuple (. fact name)) (. fact type))
      )
      (return)
    )
    (let owner-module ([] (. program modules) (. ref module)))
    (let members (call (of RowRange DeclId)))
    (match? ([] (. owner-module decls) (. ref decl))
      (case (call .decl-class row)
        (= members (. row members))
      )
    )
    (for (in member (call (. owner-module members-named) members (. fact name)))
      (match? ([] (. owner-module decls) member)
        (case (call .decl-property row)
          (if (and (. row name) (== (. row name) (. fact name)))
            (if (or (!= (. row value) 0) (== (. row syntax) 0))
              (return)
            )
            (if (and (== (. row line) 0) (call rejects-default-cycle (. ref module) (. row syntax) fact))
              (return)
            )
            (if (and (== (. row line) 0) (call rejects-facet-default (. ref module) (. row syntax) fact))
              (return)
            )
            (if (not elsewhere)
              (call construct-value (. row syntax) (. fact type))
              (return)
            )
            (if (not (call is-constructed (. fact type)))
              (return)
            )
            (let unit (call (. instances intern-initializer) (. ref module) member receiver))
            (if (== (. ([] (. instances rows) unit) state) .instance-unstarted)
              (= (. ([] (. instances signatures) unit) declared-returns) (. fact type))
            )
            (do
              (inline (call demand-initializer unit (. row syntax)))
            )
            (call replay-member unit)
            (call note-unit-errors unit (call owner-syntax))
            (return)
          )
        )
      )
    )
  )
  (fn-do _ rejects-facet-default Bool
    (param owner ModuleId)
    (param site SyntaxId)
    (param fact TypeProperty)
    ; Whether a stored property with no value written is of a facet's type, which no constructor makes,
    ; and reports so.
    (if (or (call is-constructor-parameter (. fact name)) (!= (call (. instances fill-argument) instance (. fact name)) (. U32 max)))
      (return false)
    )
    (let facet (call (. types facet-of-type) (. fact type)))
    (return-if false (if (not facet)))
    (blank)
    (let shown (call type-short-name types (. fact type)))
    (let made (call type-short-name types (call (. types facet-owner) facet)))
    (let message
      (paragraph
        (str (. fact name text) " is a " shown ", a facet of " made ", which has no constructor to give it its first value; give it a value, or make it optional")
      )
    )
    (call (. facts record-diagnostic) instance owner site .stated (call (. program store-atom) message))
    (return true)
  )
  (fn-do _ rejects-default-cycle Bool
    (param owner ModuleId)
    (param site SyntaxId)
    (param fact TypeProperty)
    (return-if false (if (or parameter (!= (call (. instances fill-argument) instance (. fact name)) (. U32 max)))))
    (blank)
    (lazy parameter (call is-constructor-parameter (. fact name)))
    (return-if false (if (not (call defaults-class fact))))
    (blank)
    (let path-types (list TypeId))
    (let path-properties (list TypeProperty))
    (let done (call (of Map TypeId Bool)))
    (let found (call default-cycle-from (. fact type) path-types path-properties done))
    (return-if false (if (== found (. U32 max))))
    (blank)
    (let steps (list String))
    (for (in index (..< found (. path-types length)))
      (let property ([] path-properties index))
      (+= steps
        (scope (str holder-name "." (. property name text) " builds " (call type-short-name types (. property type)))
          (lazy holder-name (call type-short-name types ([] path-types index)))
        )
      )
    )
    (let message
      (paragraph
        (str "Default of " (. fact name text) " never finishes: " (call (. ", and " join) steps) " again. Give one of these fields a value, make it lazy with :=, or make it optional")
      )
    )
    (call (. facts record-diagnostic) instance owner site .stated (call (. program store-atom) message))
    (return true)
  )
  (fn-do _ default-cycle-from U32
    (param type TypeId)
    (param path-types (list TypeId))
    (param path-properties (list TypeProperty))
    (param done (of Map TypeId Bool))
    (for (in index (..< 0 (. path-types length)))
      (return-if (as index U32) (if (== ([] path-types index) type)))
    )
    (return-if (. U32 max) (if (has done type)))
    (blank)
    (if (call builds-defaults type)
      (let fields (list TypeProperty))
      (for (in property (call (. types properties-of) type))
        (if (call defaults-class property)
          (+= fields property)
        )
      )
      (for (in property fields)
        (+= path-types type)
        (+= path-properties property)
        (let found (call default-cycle-from (. property type) path-types path-properties done))
        (return-if found (if (!= found (. U32 max))))
        (blank)
        (call (. path-types pop))
        (call (. path-properties pop))
      )
    )
    (= ([] done type) true)
    (return (. U32 max))
  )
  (fn-do _ builds-defaults Bool
    (param type TypeId)
    (return-if false (if (or (!= (call (. types intrinsic-of) type) .class) (call is-markup-query type))))
    (blank)
    (call (. types complete) type)
    (let current type)
    (while (!= current no-type)
      (let ref (call class-ref types current))
      (return-if false (if (and (== (. ref module) 0) (== (. ref decl) 0))))
      (blank)
      (let owner ([] (. program modules) (. ref module)))
      (match? ([] (. owner decls) (. ref decl))
        (case (call .decl-class class)
          (return-if false (if (!= (. class content) 0)))
          (blank)
          (if (== current type)
            (for (in member ([] (. owner member-pool) (. class members)))
              (match? ([] (. owner decls) member)
                (case (call .decl-function function)
                  (return-if false (if (and (== (. function kind) .constructor-decl) bare-written)))
                  (blank)
                  (lazy bare-written (and (not (. function is-generated)) (== (. function required-count) 0)))
                )
              )
            )
          )
        )
      )
      (= current (?? (call (. types base-of) current) no-type))
    )
    (return true)
  )
  (fn-expr _ defaults-class Bool
    (param property TypeProperty)
    (case? (or (!= (. property storage-kind) .storage-eager) untyped)
      false
    )
    (case? (or (!= (call (. types intrinsic-of) (. property type)) .class) (call is-markup-query (. property type)))
      false
    )
    (default
      (and (not (call names-element types property)) (not (call writes-value property)))
    )
    (where
      (lazy untyped (or (== (. property type) no-type) (== (. property type) invalid-type)))
    )
  )
  (fn-expr _ is-constructed Bool
    (param type TypeId)
    ; Whether a value of a type with no value written is what the type constructs.
    (or (== kind .class) (== kind .tuple) (== kind .struct) (== kind .array-builder))
    (where
      (lazy kind (call (. types intrinsic-of) type))
    )
  )
  (fn-do _ demand-case-values _
    (param table TypeId)
    ; A table of unions starts each row as its first case's first value, and reads a row whose tag
    ; names no case as that: the values the case writes for its fields are typed with the table.
    (let row (call row-struct-of table))
    (if (or (== row no-type) (== row invalid-type) (!= (call (. types intrinsic-of) row) .union))
      (return)
    )
    (let held (call (. types cases-of) row))
    (if (and (!= (. held length) 0) (!= (. ([] held 0) type) no-type) (!= (. ([] held 0) type) invalid-type))
      (call demand-first-values (. ([] held 0) type))
    )
  )
  (fn-do _ demand-first-values _
    (param type TypeId)
    (param seen (list TypeId) (= (call (of List TypeId))))
    ; Types the values a named tuple or struct writes for its fields, and those of the named
    ; tuples and structs its fields hold with no value written.
    (return-if (if (!= (call (. seen find) type) null)))
    (blank)
    (+= seen type)
    (if (call (. types is-optional) type)
      (call demand-first-values (call (. types optional-inner) type) seen)
      (return)
    )
    (let kind (call (. types intrinsic-of) type))
    (if (== kind .union)
      (for (in case (call (. types cases-of) type))
        (if (and (!= (. case type) no-type) (!= (. case type) invalid-type))
          (call demand-first-values (. case type) seen)
        )
      )
      (return)
    )
    (let ref (call class-ref types type))
    (if (or (and (!= kind .tuple) (!= kind .struct) (!= kind .array-builder)) unnamed)
      (return)
    )
    (lazy unnamed (and (== (. ref module) 0) (== (. ref decl) 0)))
    (call (. types complete) type)
    (for (in property (call (. types properties-of) type))
      (if (== (. property storage-kind) .storage-getter)
        (continue)
      )
      (if (call writes-value property)
        (call demand-member property type (. property name) true)
        (else-if (and (== (. property storage-kind) .storage-eager) typed-property)
          (call demand-first-values (. property type) seen)
        )
      )
      (lazy typed-property (and (!= (. property type) no-type) (!= (. property type) invalid-type)))
    )
  )
  (fn-do _ construct-value _
    (param site SyntaxId)
    (param type TypeId)
    (if (or (== site 0) (== type no-type) (== type invalid-type) (not (call is-constructed type)))
      (return)
    )
    (let shapes-start (. scratch call-arguments mark))
    (let types-start (. scratch types mark))
    (let syntax-start (. scratch syntax mark))
    (let arguments (call arguments-since shapes-start types-start syntax-start (. scratch no-types)))
    (call (. calls construction-on) site type arguments false)
  )
  (fn-expr _ is-constructor-parameter Bool
    (param name Atom)
    (!= (call constructor-parameter name) (. U32 max))
  )
  (fn-expr _ gives-every-value Bool
    (param name Atom)
    (and (!= parameter (. U32 max)) (not (call (. types is-optional) (call (. instances argument-type) instance parameter))))
    (where
      (lazy parameter (call constructor-parameter name))
    )
  )
  (fn-do _ constructor-parameter U32
    (param name Atom)
    ; The place among a constructor's parameters of the one of a name, or `U32.max`.
    (let owner-module ([] (. program modules) module))
    (let position 0u32)
    (match? ([] (. owner-module decls) (. frame decl))
      (case (call .decl-function fn)
        (for (in shape ([] (. owner-module arg-pool) (. fn args)))
          (let named (call pattern-name types tree (. shape pattern)))
          (if (and named (== named name))
            (return position)
          )
          (+= position 1)
        )
      )
    )
    (return (. U32 max))
  )
  (fn-do _ refines-in-progress Bool
    (param ref DeclRef)
    (param name Atom)
    (param receiver TypeId)
    ; Whether a class above the one a property is declared in declares a property of the name whose
    ; value is being typed, for that class as a receiver holds it.
    (let above false)
    (let current receiver)
    (while (!= current no-type)
      (let held current)
      (let level (call class-ref types current))
      (= current (?? (call (. types base-of) current) no-type))
      (if (and (== (. level module) (. ref module)) (== (. level decl) (. ref decl)))
        (= above true)
        (continue)
      )
      (let declared (if-expr above (call class-property level name) 0))
      (if (!= declared 0)
        (let unit (call (. instances intern-initializer) (. level module) declared held))
        (if (== (. ([] (. instances rows) unit) state) .instance-in-progress)
          (return true)
        )
      )
    )
    (return false)
  )
  (fn-do _ projection-type TypeId
    (param ref DeclRef)
    (param node SyntaxId)
    (param receiver TypeId)
    ; The type of the property that projects a case of a machine of a class's markup that holds a
    ; value: the optional of what the case holds in the machine's union, as each function that fills
    ; an object with the markup typed the machine, which must agree. Where none has typed it yet, a
    ; filler or constructor of the class still waiting in the queue is typed first, one at a time,
    ; until one has (`pending-filler`), or else one of the class of the object read, or of a class
    ; between, which runs the class's, or else the class's filler as the object read holds the class,
    ; given no slots, which only typing reaches then: the instance that fills the object may be
    ; waiting in no queue yet, or in that of another pass of a parallel type pass. None where none is
    ; left.
    (let owner-module ([] (. program modules) (. ref module)))
    (let owner (. owner-module tree))
    (let filler DeclId 0)
    (let machine SyntaxId 0)
    (let position (? U32) null)
    (match? ([] (. owner-module decls) (. ref decl))
      (case (call .decl-class class)
        (= filler (. class content-function))
        (for (in written (call (. owner content-machines) (. class content)))
          (let cases (call (. owner machine-cases) (call (. owner state-items) (call (. owner state-body) written))))
          (if (!= (call (. cases find) node) null)
            (= machine written)
            (= position (call (. owner case-position) cases (!! (call (. owner state-name) node))))
          )
        )
      )
    )
    (if (or (== filler 0) (== machine 0) (== position null))
      (return invalid-type)
    )
    (let own false)
    (while true
      (let found no-type)
      (for (in row (. facts machines))
        (let same (and (== (. row module) (. ref module)) (== (. row syntax) machine) (== (. row outer) 0)))
        (if (and same (== (. ([] (. instances rows) (. ([] (. instances rows) (. row instance)) enclosing)) decl) filler))
          (let held no-type)
          (match? ([] (. types rows) (. row union))
            (case (call .type-named-union union)
              (= held (call (. types optional-of) (call (. types child-type) (. union cases) position)))
            )
          )
          (if (and (!= found no-type) (!= found held))
            (return invalid-type)
          )
          (= found held)
        )
      )
      (if (!= found no-type)
        (return found)
      )
      (let pending (call pending-filler ref filler))
      (let level receiver)
      (while (and (== pending no-instance) (!= level no-type))
        (let below (call class-ref types level))
        (if (and (== (. below module) (. ref module)) (== (. below decl) (. ref decl)))
          (break)
        )
        (= level (?? (call (. types base-of) level) no-type))
        (match? ([] (. ([] (. program modules) (. below module)) decls) (. below decl))
          (case (call .decl-class class)
            (= pending (call pending-filler below (. class content-function)))
          )
        )
      )
      (if (and (== pending no-instance) (not own))
        (= own true)
        (let slots (list Atom))
        (let builders (list TypeId))
        (= pending (call (. calls filler-instance) (call holding-type receiver ref) slots builders))
      )
      (if (== pending no-instance)
        (return invalid-type)
      )
      (call demand-own-body pending)
    )
  )
  (fn-do _ pending-filler InstanceId
    (param ref DeclRef)
    (param filler DeclId)
    ; An instance waiting in the queue whose body would fill an object of a class with its markup:
    ; the class's filler, or else a constructor of the class, which calls it. None where none waits.
    (let owner-module ([] (. program modules) (. ref module)))
    (let constructor no-instance)
    (for (in unit (..< 0u32 (as (. instances rows length) U32)))
      (let row ([] (. instances rows) unit))
      (if (or (!= (. row module) (. ref module)) (!= (. row state) .instance-unstarted))
        (continue)
      )
      (if (== (. row decl) filler)
        (return unit)
      )
      (if (== constructor no-instance)
        (match? ([] (. owner-module decls) (. row decl))
          (case (call .decl-function fn)
            (if (and (== (. fn owner) (. ref decl)) (call is-constructor-kind (. fn kind)))
              (= constructor unit)
            )
          )
        )
      )
    )
    (return constructor)
  )
  (fn-do _ first-type TypeId
    (param fact TypeProperty)
    (param name Atom)
    ; The type a stored property has from a class above the one that declares it again, or no
    ; type when no class above stores it. A class that gives a stored property of its base a new
    ; value does not give it a new type: the value is converted to the type the property already
    ; has. That type is worked out for the class above itself, once, whatever class below asks
    ; for it. A lazy property declared again is another function, with the type of its own value.
    (if (!= (. fact storage-kind) .storage-eager)
      (return no-type)
    )
    (let current (. fact owner))
    (while (!= current no-type)
      (let ref (call class-ref types current))
      (let is-class (or (!= (. ref module) 0) (!= (. ref decl) 0)))
      (let declares (and is-class (!= (call owner-property program (. ref module) (. ref decl) name) 0)))
      (= current (?? (call (. types base-of) current) no-type))
      (if declares
        (break)
      )
    )
    (if (== current no-type)
      (return no-type)
    )
    (let found (call property-named current name))
    (if (not found)
      (return no-type)
    )
    (let above ([] (. types properties) found))
    (if (!= (. above storage-kind) .storage-eager)
      (return no-type)
    )
    (let given (. above type))
    (if (== given no-type)
      (= given (call demand-member above current name false true))
    )
    (return (if-expr (== given invalid-type) no-type given))
  )
  (fn-expr _ is-accessor Bool
    (param receiver TypeId)
    (param name Atom)
    (if-expr found (== (. ([] (. types properties) found) storage-kind) .storage-getter) inherited)
    (where
      (lazy found (call property-named receiver name))
      (lazy inherited (and (== (call (. types intrinsic-of) receiver) .class) (!= (call interface-accessor receiver name) null)))
    )
  )
  (fn-do _ names-nothing Bool
    (param callable SyntaxId)
    (param args (of RowRange SyntaxId))
    ; Whether a call names a function nothing declares, which the reference reports once it has typed
    ; the arguments: a name alone the binder resolves to nothing, of no type parameter, that the
    ; module reaches no declaration of, called where there is no receiver whose members it could
    ; name, with no symbol among its arguments whose union's module it could be looked for in.
    (let name (call (. tree identifier-name) callable))
    (if (or (not name) (!= (. frame self-type) no-type) resolved)
      (return false)
    )
    (lazy resolved (!= (. (call (. bindings resolution-of) (. frame binding) callable) kind) .resolve-unresolved))
    (if (call (. types env-lookup) (. frame env) name)
      (return false)
    )
    (for (in _ (call (. program lookup) module name))
      (return false)
    )
    (for (in arg ([] (. tree children) args))
      (let written
        (match ([] (. tree nodes) arg)
          (case (call .node-argument argument)
            (. argument expr)
          )
          (default
            arg
          )
        )
      )
      (if (call (. tree argument-symbol) written)
        (return false)
      )
    )
    (return true)
  )
  (fn-expr _ arguments-since Arguments
    (param shapes-start ScratchMark)
    (param types-start ScratchMark)
    (param syntax-start ScratchMark)
    (param params (of ImmutableArray TypeId ArenaBacking))
    (param curried Bool (= false))
    (param piped SyntaxId (= 0))
    (param slots (of ImmutableArray Atom ArenaBacking) (= (call (of ImmutableArray Atom ArenaBacking))))
    (param builders (of ImmutableArray TypeId ArenaBacking) (= (call (of ImmutableArray TypeId ArenaBacking))))
    (param context U32 (= (. U32 max)))
    ; The arguments pushed on the scratch stacks since the marks, with any explicit type arguments,
    ; the call a value is piped into (`piped`), and what a markup element gives its constructor apart
    ; from them.
    (call Arguments shapes arg-types syntax params curried piped slots builders context)
    (where
      (lazy shapes (call (. scratch call-arguments since) shapes-start))
      (lazy arg-types (call (. scratch types since) types-start))
      (lazy syntax (call (. scratch syntax since) syntax-start))
    )
  )
  (fn-do _ names-nothing Bool
    (param id SyntaxId)
    ; Whether a name written as a type reaches nothing: no type parameter and no declaration the
    ; module reaches, which the reference says of a constructor.
    (let name (call type-head-name tree id))
    (if (or (not name) (call (. types env-lookup) (. frame env) name))
      (return false)
    )
    (for (in _ (call (. program lookup) module name))
      (return false)
    )
    (return true)
  )
  (fn-expr _ class-site SyntaxId
    (param ref DeclRef)
    (match ([] (. ([] (. program modules) (. ref module)) decls) (. ref decl))
      (case (call .decl-class class)
        (. class syntax)
      )
      (default
        0u32
      )
    )
  )
  (fn-do _ is-managed Bool
    (param type TypeId)
    (param depth U32)
    ; Whether a value of a type holds a pointer the collector must trace.
    (if (or (> depth 16) (== type no-type) (== type invalid-type))
      (return false)
    )
    (call (. types complete) type)
    (let kind (call (. types intrinsic-of) type))
    (if (or (call is-numeric types type) (== kind .void) (== kind .atom) (== kind .type-info))
      (return false)
    )
    (if (or (== kind .cpointer) (== kind .cfunction))
      (return false)
    )
    (if (== kind .optional)
      (return (call is-managed (call (. types optional-inner) type) (+ depth 1)))
    )
    (if (== kind .union)
      (for (in index (..< 0 (. (call (. types cases-of) type) length)))
        (let fact ([] (call (. types cases-of) type) index))
        (if (and (not (. fact is-default)) (call is-managed (. fact type) (+ depth 1)))
          (return true)
        )
      )
      (return false)
    )
    (if (or (call intrinsic-is-tuple-like kind) (call (. types is-plain-tuple) type))
      (let arity (call tuple-arity type))
      (if (== arity (. U32 max))
        (return true)
      )
      (for (in position (..< 0 arity))
        (if (call is-managed (call field-of type position) (+ depth 1))
          (return true)
        )
      )
      (return false)
    )
    (return true)
  )
  (fn-do _ has-empty-value Bool
    (param type TypeId)
    (param depth U32)
    (if (or (> depth 16) (== type no-type) (== type invalid-type))
      (return false)
    )
    (call (. types complete) type)
    (let kind (call (. types intrinsic-of) type))
    (if (or (== kind .optional) (== kind .string) (== kind .void) (call intrinsic-is-numeric kind))
      (return true)
    )
    (if (== kind .union)
      (for (in index (..< 0 (. (call (. types cases-of) type) length)))
        (let fact ([] (call (. types cases-of) type) index))
        (if (and (not (. fact is-default)) (!= (. fact type) no-type) (not (call has-empty-value (. fact type) (+ depth 1))))
          (return false)
        )
      )
      (return true)
    )
    (if (and (!= kind .tuple) (!= kind .struct) (not (call (. types is-plain-tuple) type)))
      (return false)
    )
    (let arity (call tuple-arity type))
    (if (== arity (. U32 max))
      (return false)
    )
    (for (in position (..< 0 arity))
      (if (not (call has-empty-value (call field-of type position) (+ depth 1)))
        (return false)
      )
    )
    (return true)
  )
  (fn-do _ report-fault Bool
    (param site SyntaxId)
    (param at-written Bool (= false))
    ; Says why the type store could not name a type just asked of it, at the place given or,
    ; when asked to and the type is written in this module, where it is written.
    (let fault (. types fault))
    (if (not fault)
      (return false)
    )
    (let written (. types fault-site))
    (let exact (and at-written (!= written 0) (== (. types fault-module) module)))
    (call (. frame diagnose) (if-expr exact written site) .stated fault)
    (call (. types clear-fault))
    (return true)
  )
  (fn-do _ report-circular Bool
    ; Reports an associated type whose binding names itself, where the type store met the cycle.
    (if (== (. types circular-binding) 0)
      (return false)
    )
    (let bound (. types circular-name))
    (let label (if-expr bound (. bound text) ""))
    (let message (call (. program store-atom) (str "Circular associated type " label)))
    (let owner (. types circular-module))
    (call (. facts record-diagnostic) instance owner (. types circular-binding) .stated message)
    (= (. types circular-binding) 0)
    (return true)
  )
  (fn-expr _ is-const-array Bool
    (param type TypeId)
    ; ConstArray is built by the compiler from constant items: it has no constructor to dispatch.
    (match ([] (. types rows) type)
      (case (call .type-class row)
        (call (. types const-array-decl refers-to) (. row module) (. row decl))
      )
      (default
        false
      )
    )
  )
  (fn-do _ static-owner TypeId
    (param object SyntaxId)
    (let named false)
    (match? ([] (. tree nodes) object)
      (case .node-type-identifier
        (= named true)
      )
      (case .node-core-type-identifier
        (= named true)
      )
      (case .node-type-arguments
        (= named true)
      )
      (case .node-type-associated
        (= named true)
      )
      (case (call .node-identifier row)
        (let resolution (call (. bindings resolution-of) (. frame binding) object))
        (if (== (. resolution kind) .resolve-type)
          (= named true)
          (else-if (or (== (. resolution kind) .resolve-unresolved) (== (. resolution kind) .resolve-none))
            (let bound (call (. types env-lookup) (. frame env) (. row name)))
            (if bound
              (return bound)
            )
          )
        )
      )
    )
    (if (not named)
      (return no-type)
    )
    (let owner (call (. types evaluate-type) module tree object (. frame env)))
    (return (if-expr (== owner invalid-type) no-type owner))
  )
  (fn-do _ infer-catch-optional TypeId
    (param id SyntaxId)
    (param body SyntaxId)
    (let outer-surround (. frame surround))
    (= (. frame surround) (= (. frame surround catch-depth) (+ (. outer-surround catch-depth) 1)))
    (let raw (call infer body))
    (= (. frame surround) outer-surround)
    (if (or (== raw invalid-type) (== raw (. types void-type)))
      (return raw)
    )
    (let value (call result-value types (if-expr (call (. types is-optional) raw) (call (. types optional-inner) raw) raw)))
    (if (== value (. types void-type))
      (= value (call (. types type-row) .int8))
    )
    (if (call (. types is-optional) value)
      (return value)
    )
    (return (call (. types optional-of) value))
  )
  (fn-do _ infer-catch TypeId
    (param id SyntaxId)
    (param body SyntaxId)
    (param is-raw Bool)
    (param catchers (of RowRange SyntaxId))
    (param want Want)
    ; An expression under `catch` gives its value or its error, as it is. With handlers it gives
    ; what it gives where no error was raised, joined with what the handlers give. A handler
    ; that gives an error does not raise it: the whole is then a value that may be that error. A
    ; handler whose pattern can match neither the value nor any of the errors is passed over, as
    ; the reference compiles no arm that can not match (`catcher-possible`). One whose value is
    ; dropped, a statement a block does not keep the value of, gives none where the values do not
    ; join. An optional chain to a call that raises gives an optional of what the call gives
    ; (`chained-result`): handlers take the errors of the call, and the chain gives its value as an
    ; optional, which holds nothing where the chain made no call.
    (let unused (call (. want asks) .want-unused))
    (if (and (== (. catchers count) 0) (not is-raw))
      (return (call infer body))
    )
    (let transformed (call (. tree transformer-exception) body catchers))
    (if (!= transformed 0)
      (call declare-transformers body transformed catchers)
      (return no-type)
    )
    (if (!= (. catchers count) 0)
      (call (. instances mark-may-panic) instance)
    )
    (let outer-surround (. frame surround))
    (= (. frame surround) (= (. frame surround catch-depth) (+ (. outer-surround catch-depth) 1)))
    (let raw (call infer body))
    (= (. frame surround) outer-surround)
    (if (or (== (. catchers count) 0) (== raw invalid-type))
      (return raw)
    )
    (let result (call chained-result raw))
    (let chained (!= result no-type))
    (if (not chained)
      (= result raw)
    )
    (if (not (call check-handled id body result is-raw catchers))
      (return invalid-type)
    )
    (let value (call result-value types result))
    (let side value)
    (if (and chained (!= value (. types void-type)) (not (call (. types is-optional) value)))
      (= side (call (. types optional-of) value))
    )
    (let mark (. scratch types mark))
    (if (!= side (. types void-type))
      (call (. scratch types push) side)
    )
    (let errors (list TypeId))
    (for (in catcher ([] (. tree children) catchers))
      (match? ([] (. tree nodes) catcher)
        (case (call .node-catcher row)
          (if (not (call takes-errors catcher (. row type)))
            (continue)
          )
          (if (not (call catcher-possible (. row type) result))
            (call (. facts set-plan) instance catcher .plan-never)
            (continue)
          )
          (call check-pattern (. row type) result)
          (let saved (. frame surround))
          (= (. frame surround) (= (. frame surround effects) (call exceptional-effects (. saved effects))))
          (let diagnosed (. facts diagnostics length))
          (let handled (call check-statement (. row body)))
          (= (. frame surround) saved)
          (if (call is-raised handled)
            (if (== (call (. errors find) handled) null)
              (+= errors handled)
            )
            (else-if (and (!= handled no-type) (!= handled (. types void-type)) (!= handled invalid-type))
              (call (. scratch types push) handled)
            )
            (else-if (and (!= value (. types void-type)) undiagnosed (call lacks-value (. row body) handled))
              (call (. frame diagnose) (. row body) .stated (call (. program store-atom) "Illegal statement"))
            )
          )
          (lazy undiagnosed (== (. facts diagnostics length) diagnosed))
        )
      )
    )
    (if (and (== (. scratch types length) mark) (== (. errors length) 0))
      (return (. types void-type))
    )
    (let joined (. types void-type))
    (if (!= (. scratch types length) mark)
      (= joined (call (. relations join) mark))
      (if (!= joined invalid-type)
        (for (in part (call (. scratch types since) mark))
          (if (!= part joined)
            (call (. conversions convert) id 0 part joined .reason-join)
          )
        )
        (if (and chained (!= side (. types void-type)))
          (if (!= value joined)
            (call (. conversions convert) id 0 value joined .reason-join)
          )
          (call (. conversions convert) id 0 (. types null-type) joined .reason-join)
        )
      )
    )
    (call (. scratch types rewind) mark)
    (if (and (== joined invalid-type) unused (== (. errors length) 0))
      (return (. types void-type))
    )
    (if (== joined invalid-type)
      (call (. frame diagnose) id .stated (call (. program store-atom) "Incompatible types in expression"))
      (return joined)
    )
    (if (== (. errors length) 0)
      (return joined)
    )
    (let given (. scratch types mark))
    (for (in error errors)
      (call (. scratch types push) error)
    )
    (return (call result-type types joined given))
  )
  (fn-expr _ chained-result TypeId
    (param raw TypeId)
    ; What an optional chain to a call that raises holds: the call's value or one of its errors.
    ; No type for anything else.
    (case? (and (call (. types is-optional) raw) (call is-result inner))
      inner
    )
    (default
      no-type
    )
    (where
      (lazy inner (call (. types optional-inner) raw))
    )
  )
  (fn-expr _ is-result Bool
    (param type TypeId)
    (match ([] (. types rows) type)
      (case .type-result
        true
      )
      (default
        false
      )
    )
  )
  (fn-do _ takes-errors Bool
    (param catcher SyntaxId)
    (param pattern SyntaxId)
    ; Whether a handler names the error type it takes, as in `catch error IOError`: `Error` or a type
    ; that extends it. A name alone, as in `catch error`, names no type.
    (if (== pattern 0)
      (call (. frame diagnose)
        (block
          (arg catcher)
          (arg .stated)
          (arg (call (. program store-atom) "Attached catch handler requires an Error type"))
        )
      )
      (return false)
    )
    (let caught
      (match ([] (. tree nodes) pattern)
        (case (call .node-type-capture row)
          (if-expr (== (. row type) 0) no-type (call caught-type pattern))
        )
        (default
          (call caught-type pattern)
        )
      )
    )
    (return-if false (if (== caught invalid-type)))
    (blank)
    (if (or (== caught no-type) (not (call is-subtype types caught (. types error-type))))
      (call (. frame diagnose)
        (block
          (arg pattern)
          (arg .stated)
          (arg (call (. program store-atom) "Attached catch handler type must be an Error subtype"))
        )
      )
      (return false)
    )
    (return true)
  )
  (fn-do _ catcher-possible Bool
    (param pattern SyntaxId)
    (param raw TypeId)
    ; Whether the pattern of a handler could match what an expression that may raise gives: its
    ; value or one of its errors, which the reference matches the handlers against as a match's
    ; arms.
    (if (call pattern-possible pattern (call result-value types raw))
      (return true)
    )
    (match? ([] (. types rows) raw)
      (case (call .type-result row)
        (for (in offset (..< 0 (. row errors count)))
          (if (call pattern-possible pattern (call (. types child-type) (. row errors) offset))
            (return true)
          )
        )
      )
    )
    (return false)
  )
  (fn-do _ check-handled Bool
    (param id SyntaxId)
    (param body SyntaxId)
    (param raw TypeId)
    (param is-raw Bool)
    (param catchers (of RowRange SyntaxId))
    ; Handlers attach to an expression that can raise. An error none of them takes leaves the
    ; function, unless the expression is itself caught: then the handlers must take every error.
    ; Which errors leave is recorded at the expression.
    (let errors (call (of RowRange TypeId)))
    (let raises false)
    (match? ([] (. types rows) raw)
      (case (call .type-result row)
        (= errors (. row errors))
        (= raises true)
      )
    )
    (if (not raises)
      (let message "Attached catch handlers require a Result expression")
      (call (. frame diagnose) body .stated (call (. program store-atom) message))
      (return false)
    )
    (let missing "")
    (let leaving U64)
    (let bit U64 1)
    (for (in offset (..< 0 (. errors count)))
      (let error (call (. types child-type) errors offset))
      (let place bit)
      (= bit (* bit 2))
      (if (call handles catchers error)
        (continue)
      )
      (if (not is-raw)
        (call note-outgoing error id)
        (= leaving (/or/ leaving place))
        (continue)
      )
      (if (!= (. missing length) 0)
        (+= missing ", ")
      )
      (+= missing (call type-short-name types error))
    )
    (if (!= (. missing length) 0)
      (let message (str "Non-exhaustive match for Result; missing " missing))
      (call (. frame diagnose) id .stated (call (. program store-atom) message))
      (return false)
    )
    (if (< (. errors count) 64)
      (call (. facts set-handled) instance id leaving)
    )
    (return true)
  )
  (fn-do _ handles Bool
    (param catchers (of RowRange SyntaxId))
    (param error TypeId)
    (for (in catcher ([] (. tree children) catchers))
      (match? ([] (. tree nodes) catcher)
        (case (call .node-catcher row)
          (if (== (. row type) 0)
            (continue)
          )
          (let caught (call caught-type (. row type)))
          (if (== caught invalid-type)
            (return true)
          )
          (let relation (call (. relations compare) error caught false false null module))
          (let down (== (. relation kind) .relation-down-cast))
          (if (and (call relation-legal relation) (not down) (!= (. relation kind) .relation-interface-down-cast))
            (return true)
          )
        )
      )
    )
    (return false)
  )
  (fn-do _ declare-transformers _
    (param site SyntaxId)
    (param exception SyntaxId)
    (param catchers (of RowRange SyntaxId))
    ; Each catcher names an error that, from here on, leaves the function as the exception raised
    ; in its place. The exception is typed once: only the catcher of a raise with one sees it.
    (let raised no-type)
    (let typed false)
    (for (in catcher ([] (. tree children) catchers))
      (match? ([] (. tree nodes) catcher)
        (case (call .node-catcher row)
          (if (!= (. row body) 0)
            (let message "Error transformers do not support catch bodies")
            (call (. frame diagnose) catcher .stated (call (. program store-atom) message))
            (continue)
          )
          (let source (if-expr (== (. row type) 0) no-type (call typed-catcher (. row type))))
          (if (or (== source no-type) (and (!= source invalid-type) (not (call is-subtype types source (. types error-type)))))
            (let message "Error transformer catch requires an error type")
            (call (. frame diagnose) catcher .stated (call (. program store-atom) message))
            (continue)
          )
          (call bind-catcher (. row type))
          (let chain (list TypeId))
          (for (in previous ([] (. tree children) (. row previous)))
            (call bind-catcher previous)
            (+= chain (call caught-type previous))
          )
          (if (and (!= source invalid-type) (call (. frame has-transform) source chain))
            (let shown (call type-short-name types source))
            (let message (str "Ambiguous error transformer for " shown "; only one transformer may "))
            (++= message "match the same error chain.")
            (call (. frame diagnose) catcher .stated (call (. program store-atom) message))
            (continue)
          )
          (if (not typed)
            (let saved (. frame surround))
            (= (. frame surround)
              (call Surround
                (block
                  (arg (call exceptional-effects (. saved effects)))
                  (arg (. saved zone-site))
                  (arg (. saved catch-depth))
                  (arg (+ (. saved transformer-depth) 1))
                )
              )
            )
            (= raised (call infer exception))
            (= (. frame surround) saved)
            (= typed true)
          )
          (if (and (!= source invalid-type) (!= raised invalid-type) (!= raised no-type))
            (let fact
              (call (. facts note-transform)
                (block
                  (arg instance)
                  (arg catcher)
                  (arg site)
                  (arg exception)
                  (arg source)
                  (arg chain)
                  (arg raised)
                )
              )
            )
            (call (. frame add-transform) source raised chain site fact)
          )
        )
      )
    )
  )
  (fn-do _ caught-type TypeId
    (param pattern SyntaxId)
    (return
      (match ([] (. tree nodes) pattern)
        (case (call .node-type-capture row)
          (call (. types evaluate-type) module tree (. row type) (. frame env))
        )
        (default
          (call (. types evaluate-type) module tree pattern (. frame env))
        )
      )
    )
  )
  (fn-do _ typed-catcher TypeId
    (param pattern SyntaxId)
    ; The error a catcher names, or none where it names only a local for it.
    (return
      (match ([] (. tree nodes) pattern)
        (case (call .node-type-capture row)
          (if-expr (== (. row type) 0) no-type (call caught-type pattern))
        )
        (default
          (call caught-type pattern)
        )
      )
    )
  )
  (fn-do _ bind-catcher _
    (param pattern SyntaxId)
    (if (== pattern 0)
      (return)
    )
    (match? ([] (. tree nodes) pattern)
      (case (call .node-type-capture row)
        (let slot (call declaring-slot pattern))
        (let caught (call (. types evaluate-type) module tree (. row type) (. frame env)))
        (if (and slot (!= caught invalid-type))
          (call (. frame assign) slot caught)
        )
      )
    )
  )
  (fn-do _ plan-class-test _
    (param id SyntaxId)
    (param op Operator)
    (param value TypeId)
    (param rhs SyntaxId)
    ; Plans `is` or `is not` between an object and a class as a test of the object's class, and
    ; records the class tested for as the node's constant. The class tested for is the object's
    ; own, one it is derived from, or one derived from it: any other is no class the object can
    ; be of, and the test is of what the object converts to, as any other pattern's is.
    (if (or (and (!= op .is-op) (!= op .is-not-op)) (== value invalid-type) (== value no-type))
      (return)
    )
    (if (or (!= (call (. types intrinsic-of) value) .class) (. ([] (. types completions) value) has-variables))
      (return)
    )
    (let target invalid-type)
    (match ([] (. tree nodes) rhs)
      (case .node-symbol
        (return)
      )
      (case .node-type-case
        (return)
      )
      (case (call .node-identifier row)
        (= target (call (. types type-named) module (. row name) (. frame env)))
      )
      (default
        (= target (call (. types evaluate-type) module tree rhs (. frame env)))
      )
    )
    (if (or (== target invalid-type) (== target no-type))
      (return)
    )
    (call (. types complete) target)
    (if (or (!= (call (. types intrinsic-of) target) .class) (. ([] (. types completions) target) has-variables))
      (return)
    )
    (if (!= (call (. types facet-of-type) target) null)
      (return)
    )
    (let kind (. (call (. relations compare) value target) kind))
    (let same (or (== kind .relation-same) (== kind .relation-equal)))
    (if (and (not same) (!= kind .relation-up-cast) (!= kind .relation-down-cast))
      (return)
    )
    (call (. facts set-type-detail) instance id target .plan-class-test)
  )
  (fn-do _ infer-unprojected TypeId
    (param syntax SyntaxId)
    ; The type of the subject of a match or of the value `is` tests. A local known to hold one
    ; case of its union is read there as the union, not as the case, as the reference reads it.
    ; One that holds an optional of the union is known to hold a value, and is read as the union.
    (let read (call infer syntax))
    (match? ([] (. tree nodes) syntax)
      (case .node-identifier
        (let resolution (call (. bindings resolution-of) (. frame binding) syntax))
        (if (and (== (. resolution kind) .resolve-slot) (== (call (. facts plan-of) instance syntax) .plan-case-read))
          (let declared (call (. frame known) (. resolution slot)))
          (if (call (. types is-optional) declared)
            (= declared (call (. types optional-inner) declared))
          )
          (call (. facts set-plan) instance syntax .plan-none)
          (call (. facts replace-node-type) instance syntax declared)
          (return declared)
        )
      )
    )
    (return read)
  )
  (fn-do _ plan-is _
    (param id SyntaxId)
    (param op Operator)
    (param subject TypeId)
    (param right SyntaxId)
    ; Plans `is` or `is not` between a value and a pattern that is no test of an object's class.
    ; The pattern is planned as the pattern of an arm of a match is: a type named by the
    ; conversions that say what it tests, a case named by its number, of a union, of an optional
    ; one, or of the union a row of a table holds, and a pattern of items as it is planned in a
    ; match. Types in parentheses are the tuple of them. One that can not match the value is never
    ; true: so a pattern of items against a text, which has none to give, and a case against an optional row, as TypeScript has it. A
    ; case no type the module can name has is not found. A pattern of texts against a `String` is
    ; planned as one in a match.
    (if (or (== subject invalid-type) (== subject no-type) (. ([] (. types completions) subject) has-variables))
      (return)
    )
    (let kind (call is-specificity op))
    (let target no-type)
    (match ([] (. tree nodes) right)
      (case (call .node-symbol row)
        (let given (if-expr (call (. types is-optional) subject) (call (. types optional-inner) subject) subject))
        (if (call names-enum-value right 0 (. row name) given)
          (return)
        )
        (let given-kind (call (. types intrinsic-of) given))
        (if (== given-kind .union)
          (call note-case right given (. row name))
          (else-if (and (== given subject) (or (== given-kind .table-row) (== given-kind .immutable-table-row)))
            (call note-case right (call row-struct-of given) (. row name))
          )
        )
        (let refined (and (== given subject) (== given-kind .union) (not (call names-case given (. row name)))))
        (if (and refined (!= (call refined-payload given (. row name)) no-type))
          (call (. facts set-plan) instance right .plan-refined-case)
          (else-if (!= (call (. facts plan-of) instance right) .plan-case)
            (call (. facts set-plan) instance right .plan-never)
            (if (and (== (call anonymous-symbol right (. row name)) no-type) (== (call symbol-class types module (. row name)) invalid-type))
              (call missing-case right (. row name) given)
            )
          )
        )
        (call (. facts set-plan) instance id .plan-is)
        (return)
      )
      (case .node-type-case
        (call check-pattern right subject)
        (call (. facts set-plan) instance id .plan-is)
        (return)
      )
      (case .node-type-list
        (if (or (== subject (. types string-type)) (not (call is-collection-type tree right)))
          (call plan-is-items id subject right)
          (return)
        )
        (= target (call (. types evaluate-type) module tree right (. frame env)))
      )
      (case .node-type-map
        (if (not (call is-collection-type tree right))
          (call plan-is-items id subject right)
          (return)
        )
        (= target (call (. types evaluate-type) module tree right (. frame env)))
      )
      (case (all .node-type-and ({} (and (== subject (. types string-type)) (call check-text-pattern right))))
        (call (. facts set-plan) instance id .plan-is)
        (return)
      )
      (case (call .node-identifier row)
        (= target (call (. types type-named) module (. row name) (. frame env)))
      )
      (case (call .node-tuple-syntax row)
        (= target (call tuple-named (. row items)))
        (if (== target invalid-type)
          (let reported (. facts diagnostics length))
          (for (in item ([] (. tree children) (. row items)))
            (call report-missing-type item (. frame env))
          )
          (if (== (. facts diagnostics length) reported)
            (let text
              (paragraph
                "Only types may be written in parentheses after \"is\"; to test what the fields hold, match the value with an arm, as in \"(case (tuple 3 name) …)\""
              )
            )
            (call (. frame diagnose) right .stated (call (. program store-atom) text))
          )
          (return)
        )
      )
      (default
        (= target (call (. types evaluate-type) module tree right (. frame env)))
      )
    )
    (if (or (== target invalid-type) (== target no-type))
      (call report-missing-type right (. frame env))
      (return)
    )
    (if (call refuses-facet-test right target)
      (return)
    )
    (if (. ([] (. types completions) target) has-variables)
      (= target (call complete-named target subject kind))
    )
    (if (and (!= target no-type) (call could-match subject target kind))
      (call plan-leaves right subject target kind (. U32 max))
      (call plan-exact right kind)
      (else
        (call (. facts set-plan) instance right .plan-never)
      )
    )
    (call (. facts set-plan) instance id .plan-is)
  )
  (fn-do _ refuses-facet-test Bool
    (param syntax SyntaxId)
    (param target TypeId)
    ; Whether a type a value is tested for is a facet's, which every object of its owner has, so that
    ; no test could say anything, and reports so.
    (let facet (call (. types facet-of-type) target))
    (return-if false (if (not facet)))
    (blank)
    (let owner (call (. types facet-owner) facet))
    (let message
      (paragraph
        (str (call type-short-name types target) " is a facet, which every " (call type-short-name types owner) " has, so no value is tested for it")
      )
    )
    (call (. frame diagnose) syntax .stated (call (. program store-atom) message))
    (return true)
  )
  (fn-do _ tuple-named TypeId
    (param items (of RowRange SyntaxId))
    ; The tuple of the types written in parentheses after `is`, as in `pair is (Int, String)`, or
    ; the invalid type where one of them names no type.
    (let mark (. scratch types mark))
    (let names-mark (. scratch names mark))
    (let position 0)
    (for (in item ([] (. tree children) items))
      (let field
        (match ([] (. tree nodes) item)
          (case (call .node-identifier row)
            (call (. types type-named) module (. row name) (. frame env))
          )
          (default
            (call (. types evaluate-type) module tree item (. frame env))
          )
        )
      )
      (if (or (== field invalid-type) (== field no-type))
        (call (. scratch types rewind) mark)
        (call (. scratch names rewind) names-mark)
        (return invalid-type)
      )
      (call (. scratch names push) (call (. types index-atom) position))
      (call (. scratch types push) field)
      (+= position 1)
    )
    (return (call (. types intern-tuple) mark names-mark))
  )
  (fn-do _ complete-named TypeId
    (param target TypeId)
    (param subject TypeId)
    (param kind Specificity)
    ; A generic named with its arguments left out, completed from the value it is tested
    ; against: the generic the value is, or for a union the first of its cases that is one. No
    ; type where the value is none, and the test is never true.
    (let given (if-expr (call (. types is-optional) subject) (call (. types optional-inner) subject) subject))
    (if (== (call (. types intrinsic-of) given) .union)
      (for (in fact (call (. types cases-of) given))
        (if (and (!= (. fact type) no-type) (!= (. fact type) invalid-type))
          (let held (call (. relations compare) (. fact type) target false false null module))
          (if (and (call instance-relation held kind) (not (. ([] (. types completions) (. held to)) has-variables)))
            (return (. held to))
          )
        )
      )
      (return no-type)
    )
    (let relation (call (. relations compare) given target false false null module))
    (if (and (call instance-relation relation kind) (not (. ([] (. types completions) (. relation to)) has-variables)))
      (return (. relation to))
    )
    (return no-type)
  )
  (fn-expr _ instance-relation Bool
    (param relation Relation)
    (param kind Specificity)
    (and (call (. relations holds-as) relation kind) (not (call converts-value (. relation kind))))
  )
  (fn-do _ plan-is-items _
    (param id SyntaxId)
    (param subject TypeId)
    (param right SyntaxId)
    ; Plans `is` between a value and a pattern of items or of keys: as the pattern of an arm of
    ; a match is planned, or as one that never matches where the value has none to give.
    (if (call pattern-possible right subject)
      (call check-pattern right subject)
      (else
        (call (. facts set-plan) instance right .plan-never)
      )
    )
    (call (. facts set-plan) instance id .plan-is)
  )
  (fn-do _ infer-binary TypeId
    (param id SyntaxId)
    (param op Operator)
    (param left SyntaxId)
    (param right SyntaxId)
    (param want Want)
    (if (call is-type-test op)
      (let tested (call infer-unprojected left))
      (call forget-carried left)
      (call plan-class-test id op tested right)
      (if (!= (call (. facts plan-of) instance id) .plan-class-test)
        (let own-matching matching)
        (= matching (= (. matching case) left))
        (call plan-is id op tested right)
        (= matching own-matching)
      )
      (return (. types bool-type))
    )
    (if (or (== op .and-op) (== op .or-op))
      (call note-truthiness id left (call infer-tested left))
      (if (call never-holds left (== op .and-op))
        (call (. facts set-plan) instance id .plan-never)
        (return (. types bool-type))
      )
      (let mark (. scratch narrowings mark))
      (call (. narrowing narrow-condition) left (== op .and-op))
      (call note-truthiness id right (call infer-tested right) true)
      (call pop-conditional mark)
      (return (. types bool-type))
    )
    (if (== op .coalesce-op)
      (return (call infer-coalesce id left right want))
    )
    (if (== op .else-op)
      (match? ([] (. tree nodes) left)
        (case (call .node-binary-expression row)
          (return (call infer-choice id (. row lhs) (. row rhs) right want))
        )
      )
    )
    (if (== op .if-op)
      (return (call infer-conditional id left right want))
    )
    (if (or (call is-pipeline-nested op) (== op .pipe-forward-op) writes (== op .grammar-pipe-op))
      (return (call infer-pipeline id op left right))
    )
    (lazy writes (or (== op .pipe-write-all-op) (== op .pipe-write-each-op)))
    (blank)
    (let equates (or (== op .equals-op) (== op .not-equals-op)))
    (if (and equates (or (call (. narrowing is-null-syntax) left) (call (. narrowing is-null-syntax) right)))
      (let lhs (call infer left))
      (let rhs (call infer right))
      (call forget-carried left)
      (call forget-carried right)
      (let other (if-expr (call (. narrowing is-null-syntax) left) rhs lhs))
      (let operand (if-expr (call (. narrowing is-null-syntax) left) right left))
      (if (and (!= other invalid-type) (!= other no-type))
        (if (or (call (. types is-optional) other) (call reads-held operand other))
          (call (. facts set-plan) instance id .plan-absent)
          (return (. types bool-type))
        )
      )
      (return (call infer-binary-values id op left lhs right rhs))
    )
    (let names-left (or (!= (call (. tree symbol-of) left) null) (call (. tree calls-symbol) left)))
    (if (and equates names-left (== (call (. tree symbol-of) right) null) (not (call (. tree calls-symbol) right)))
      (let named (call infer right))
      (if (call compares-machine-case op left named)
        (return invalid-type)
      )
      (return (call infer-compared id op left (call infer-comparand left named) right named))
    )
    (if (and (call is-arithmetic op) (not (call is-bitwise op)) (call shared-symbol left))
      (let given (call infer right))
      (return (call infer-binary-values id op left (call infer-receiver-symbol left op given) right given))
    )
    (let lhs (call infer left (call member-want op left false)))
    (if (and equates (call compares-machine-case op right lhs))
      (return invalid-type)
    )
    (let rhs (if-expr equates (call infer-comparand right lhs) (call infer right (call member-want op right true))))
    (call note-operand-suffixes op left lhs right rhs)
    (return (call infer-compared id op left lhs right rhs))
  )
  (fn-expr _ member-want Want
    (param op Operator)
    (param operand SyntaxId)
    (param is-right Bool)
    ; What a membership test asks of the operand it looks in, where that is a list written: that the
    ; test record what makes it (`want-member`).
    (if-expr (and tests (is ([] (. tree nodes) operand) .node-list-syntax)) (call (. (call Want) adding) .want-member) (call Want))
    (where
      (lazy tests
        (block
          (case? is-right
            (or (== op .is-in-op) (== op .not-in-op))
          )
          (default
            (or (== op .has-op) (== op .has-not-op))
          )
        )
      )
    )
  )
  (fn-do _ compares-machine-case Bool
    (param op Operator)
    (param symbol SyntaxId)
    (param other TypeId)
    ; Reports a case of a state machine that `==` or `!=` compares with the machine's value: a
    ; machine's case is tested with `is`, which holds while a case nested in it is active too.
    (let name (call (. tree symbol-of) symbol))
    (if (or (not name) (== other invalid-type) (== other no-type))
      (return false)
    )
    (let machine (call (. types optional-inner) other))
    (if (or (not (call is-machine-union machine)) (not (call names-case machine name)))
      (return false)
    )
    (let test (if-expr (== op .equals-op) "is" "is-not"))
    (let written (str "." (. name text)))
    (let message
      (paragraph
        (str "A state machine's case is tested with \"is\" or \"is-not\", which count the cases nested in it; write \"(" test " … " written ")\" in place of \"(" op " … " written ")\"")
      )
    )
    (call (. frame diagnose) symbol .stated (call (. program store-atom) message))
    (return true)
  )
  (fn-do _ note-operand-suffixes _
    (param op Operator)
    (param left SyntaxId)
    (param lhs TypeId)
    (param right SyntaxId)
    (param rhs TypeId)
    (if (or (== op .pow-op) (and (not (call is-arithmetic op)) (not (call is-comparison op))))
      (return)
    )
    (if (not (call is-shift op))
      (call (. calls note-operand-suffix) left right rhs)
    )
    (call (. calls note-operand-suffix) right left lhs)
  )
  (fn-do _ infer-receiver-symbol TypeId
    (param left SyntaxId)
    (param op Operator)
    (param rhs TypeId)
    ; A case named by its symbol alone that several types have, as the operand an operator is called
    ; on: of the last of them that declares the operator for the other operand, as a call settles
    ; such a case among its arguments by the function it finds, else of the type its name alone gives.
    (let token (call (. program store-atom) (str op)))
    (let owners (list TypeId))
    (call symbol-sharers left owners)
    (let position (. owners length))
    (while (and (> position 0) (!= rhs invalid-type))
      (-= position 1)
      (let owner ([] owners position))
      (if (call (. calls has-operator) owner token rhs)
        (return-if (call infer left) (if (== position (- (. owners length) 1))))
        (blank)
        (call note-enum-case owner (!! (call (. tree symbol-of) left)) left)
        (call (. facts set-node-type) instance left owner)
        (return owner)
      )
    )
    (return (call infer left))
  )
  (fn-do _ infer-compared TypeId
    (param id SyntaxId)
    (param op Operator)
    (param left SyntaxId)
    (param lhs TypeId)
    (param right SyntaxId)
    (param rhs TypeId)
    ; A comparison casts each side to the type of the other, as the reference does, so a case named
    ; by its symbol alone compared with a value of a type without the case is of no one type.
    (if (and (!= lhs invalid-type) (!= rhs invalid-type) (call is-comparison op))
      (call note-unsettled left rhs)
      (call note-unsettled right lhs)
    )
    (return (call infer-binary-values id op left lhs right rhs))
  )
  (fn-do _ wider-float Bool
    (param one TypeId)
    (param other TypeId)
    ; Whether a float is wider than another float, which a comparison of the two converts to it.
    (let first (call (. types completion-of) one))
    (let second (call (. types completion-of) other))
    (return
      (scope (and (call intrinsic-is-float (. first intrinsic)) (call intrinsic-is-float (. second intrinsic)) wider-bits)
        (lazy wider-bits (> (. first bit-size) (. second bit-size)))
      )
    )
  )
  (fn-do _ mixes-float Bool
    (param one TypeId)
    (param other TypeId)
    ; Whether one of two numbers is a float and the other an integer, which a comparison brings to
    ; the type arithmetic on the two works in.
    (let first (. (call (. types completion-of) one) intrinsic))
    (let second (. (call (. types completion-of) other) intrinsic))
    (return
      (scope (or float-first (and (call is-integer-kind first) (call intrinsic-is-float second)))
        (lazy float-first (and (call intrinsic-is-float first) (call is-integer-kind second)))
      )
    )
  )
  (fn-do _ infer-binary-values TypeId
    (param id SyntaxId)
    (param op Operator)
    (param left SyntaxId)
    (param lhs TypeId)
    (param right SyntaxId)
    (param rhs TypeId)
    (if (or (== lhs invalid-type) (== rhs invalid-type))
      (return invalid-type)
    )
    (if (call answers-arithmetic op)
      (let declared (call declared-arithmetic id op left lhs right rhs))
      (if (!= declared no-type)
        (return declared)
      )
    )
    (let left-type (call (. conversions adapted-literal) left lhs rhs))
    (let right-type (call (. conversions adapted-literal) right rhs lhs))
    (if (or (!= left-type lhs) (!= right-type rhs))
      (return (call infer-binary-values id op left left-type right right-type))
    )
    (if (or (== op .is-in-op) (== op .not-in-op))
      (return (call infer-containment id (== op .is-in-op) right rhs left lhs true))
    )
    (if (or (== op .has-op) (== op .has-not-op))
      (return (call infer-containment id (== op .has-op) left lhs right rhs false))
    )
    (if (or (== op .concat-op) (== op .concat-string-op))
      (if (and (== op .concat-op) non-string (call (. calls has-operator) lhs (!! (. types concat-atom)) rhs))
        (return (call (. calls operator-call) id lhs (!! (. types concat-atom)) right rhs))
      )
      (lazy non-string (!= lhs (. types string-type)))
      (if (and (== op .concat-op) (!= (call (. types intrinsic-of) lhs) .string))
        (call (. frame diagnose) id .illegal-operation null lhs rhs)
        (return invalid-type)
      )
      (call note-unsettled left (. types string-type))
      (call note-unsettled right (. types string-type))
      (if (!= lhs (. types string-type))
        (call (. conversions convert) id left lhs (. types string-type) .reason-operator)
      )
      (call (. calls concat-call) id right rhs)
      (return (. types string-type))
    )
    (let lhs-value (if-expr (call (. types is-optional) lhs) (call (. types optional-inner) lhs) lhs))
    (let rhs-value (if-expr (call (. types is-optional) rhs) (call (. types optional-inner) rhs) rhs))
    (let left-truth (== (call (. types intrinsic-of) lhs-value) .bool))
    (let right-truth (== (call (. types intrinsic-of) rhs-value) .bool))
    (let builtin
      (scope (and numeric (== left-truth right-truth))
        (lazy numeric (and (call is-numeric types lhs-value) (call is-numeric types rhs-value)))
      )
    )
    (let plain (and (== lhs lhs-value) (== rhs rhs-value)))
    (let equates (or (== op .equals-op) (== op .not-equals-op)))
    (if (and equates (not plain) (!= lhs (. types null-type)) (!= rhs (. types null-type)))
      (let held (call infer-held id op left lhs right rhs))
      (if (!= held no-type)
        (return held)
      )
    )
    (if (and (call is-comparison op) builtin (not plain) (not equates))
      (call (. frame diagnose) id .illegal-operation null lhs rhs)
      (return invalid-type)
    )
    (if (and (call is-comparison op) builtin plain (or (call is-declared-number lhs) (call is-declared-number rhs)))
      (let overridden (call infer-override id op left lhs right rhs false))
      (if (!= overridden no-type)
        (return overridden)
      )
    )
    (if (and (call is-comparison op) builtin)
      (let plan (. OperatorPlan plan-builtin))
      (if (!= lhs-value rhs-value)
        (let common (call integer-comparison-type types lhs-value rhs-value))
        (if (!= common no-type)
          (call cast-operand left lhs-value common)
          (call cast-operand right rhs-value common)
          (if (call compares-by-sign types lhs-value rhs-value)
            (= plan .plan-sign-checked-right)
            (if (. ([] (. types completions) lhs-value) is-signed)
              (= plan .plan-sign-checked-left)
            )
          )
          (else-if (and plain (call mixes-float lhs-value rhs-value))
            (let machine (call promote types lhs-value rhs-value))
            (call promote-operand left lhs-value machine)
            (call promote-operand right rhs-value machine)
          )
          (else-if (and (call intrinsic-is-float (. ([] (. types completions) rhs-value) intrinsic)) narrower)
            (call (. conversions convert) left left lhs-value rhs-value .reason-operand)
          )
          (else-if (and (call unit-drops-fraction types rhs-value lhs-value) (not (call unit-drops-fraction types lhs-value rhs-value)))
            (call (. conversions convert) left left lhs-value rhs-value .reason-operand)
          )
          (else
            (call (. conversions convert) right right rhs-value lhs-value .reason-operand)
          )
        )
        (lazy narrower (not (call wider-float lhs-value rhs-value)))
      )
      (if plain
        (call (. facts set-plan) instance id plan)
      )
      (return (. types bool-type))
    )
    (if (and (call is-bitwise op) (not (call is-shift op)))
      (let answered (call (. calls operands-call) id (call bitwise-name op) left lhs right rhs))
      (if (!= answered no-type)
        (return (call plan-answer id .plan-call answered))
      )
    )
    (if (and (call is-bitwise op) builtin)
      (let fallback (if-expr (call is-integer rhs-value) rhs-value (call (. types type-row) .int64)))
      (let decided (if-expr (call is-integer lhs-value) lhs-value fallback))
      (let mixed
        (scope (and integers (!= (call builtin-number types lhs) (call builtin-number types rhs)))
          (lazy integers (and (call is-integer lhs) (call is-integer rhs)))
        )
      )
      (if (and mixed (not (call is-shift op)))
        (let machine (call promote types lhs rhs))
        (call promote-operand left lhs machine)
        (call promote-operand right rhs machine)
        (call (. facts set-plan) instance id .plan-builtin)
        (return machine)
      )
      (if (!= lhs decided)
        (call (. conversions convert) left left lhs decided .reason-operand)
      )
      (if (call is-shift op)
        (if (!= rhs rhs-value)
          (call (. conversions convert) right right rhs rhs-value .reason-operand)
        )
        (call promote-operand right rhs-value decided)
        (else-if (!= rhs decided)
          (call (. conversions convert) right right rhs decided .reason-operand)
        )
      )
      (call (. facts set-plan) instance id .plan-builtin)
      (return decided)
    )
    (if (and (== op .pow-op) builtin plain (!= (call unit-root types lhs) no-type))
      (let raised (call raise-unit id left lhs right rhs))
      (if (!= raised no-type)
        (return raised)
      )
    )
    (if (and (== op .pow-op) builtin plain)
      (return
        (call plan-answer
          (block
            (arg id)
            (arg .plan-call)
            (arg (call (. calls operator-call) id lhs (call (. program store-atom) (str op)) right rhs))
          )
        )
      )
    )
    (if (and (call is-arithmetic op) builtin)
      (if (or (!= lhs lhs-value) left-truth)
        (call (. frame diagnose) id .illegal-operation null lhs rhs)
        (return invalid-type)
      )
      (let given rhs-value)
      (if (!= rhs rhs-value)
        (call (. conversions convert) right right rhs lhs .reason-operand)
        (= given lhs)
      )
      (if (== op .divide-op)
        (let within (call quotient-unit lhs-value given))
        (if (!= within no-type)
          (return (call plan-quotient id left lhs-value right given within))
        )
      )
      (if (or (== op .multiply-op) (== op .divide-op))
        (let scaling (call scaling-of (== op .multiply-op) lhs-value given))
        (if (. scaling applies)
          (return (call plan-scaling id left lhs-value right given scaling))
        )
        (let product (call product-of (== op .multiply-op) lhs-value given))
        (if (!= (. product problem) "")
          (call (. frame diagnose) id .stated (call (. program store-atom) (. product problem)))
          (return invalid-type)
        )
        (if (. product applies)
          (return (call plan-product id left lhs-value right given product))
        )
      )
      (let unit (call unit-arithmetic-type types lhs-value given (== op .multiply-op) takes scales))
      (lazy takes (or (== op .add-op) (== op .subtract-op) (== op .mod-op)))
      (lazy scales (or (== op .multiply-op) (== op .divide-op)))
      (if (== unit invalid-type)
        (call (. frame diagnose) right .illegal-cast null given lhs-value)
        (return invalid-type)
      )
      (let promoted (call promote types lhs-value given))
      (if (!= op .pow-op)
        (call plan-arithmetic id left lhs-value right given unit promoted)
      )
      (return (if-expr (!= unit no-type) unit promoted))
    )
    (let pointer-lhs (== (. ([] (. types completions) lhs-value) intrinsic) .cpointer))
    (if (and (call is-arithmetic op) pointer-lhs (call is-numeric types rhs-value))
      (if (and plain (== op .add-op))
        (call (. facts set-plan) instance id .plan-pointer-add)
      )
      (return lhs-value)
    )
    (if (== op .add-op)
      (let zipped (call zip-columns lhs rhs))
      (if (!= zipped no-type)
        (call (. facts set-table) instance id (. TableOp table-zip) 0 0)
        (return zipped)
      )
    )
    (let token (call (. program store-atom) (str op)))
    (if (call is-comparison op)
      (let overridden (call infer-override id op left lhs right rhs false))
      (if (and equates (== (call (. types intrinsic-of) lhs) .type-info) (== (call (. types intrinsic-of) rhs) .type-info))
        (call (. facts set-plan) instance id (if-expr (== lhs rhs) .plan-alike .plan-unlike))
        (return (. types bool-type))
      )
      (if (and equates plain (== lhs (. types void-type)) (== rhs (. types void-type)) (== overridden no-type))
        (call (. facts set-plan) instance id .plan-alike)
        (return (. types bool-type))
      )
      (if (!= overridden no-type)
        (return overridden)
      )
      (let left-address (== (call (. types intrinsic-of) lhs) .cpointer))
      (let right-address (== (call (. types intrinsic-of) rhs) .cpointer))
      (let addressed
        (scope (and left-pointer (or right-address (== rhs (. types null-type))))
          (lazy left-pointer (or left-address (== lhs (. types null-type))))
        )
      )
      (if (and plain (or left-address right-address) addressed)
        (call (. facts set-plan) instance id .plan-address-compare)
        (return (. types bool-type))
      )
      (if (and equates plain (call compare-fields id lhs rhs right false))
        (let fielded (. facts calls length))
        (call compare-fields id lhs rhs right true)
        (call (. facts name-roles-since) instance id fielded .role-field)
        (call (. facts set-plan) instance id (if-expr (== op .equals-op) .plan-fields .plan-not-fields))
        (return (. types bool-type))
      )
      (if (and equates plain (== lhs rhs) (call compare-cases id lhs right false))
        (let fielded (. facts calls length))
        (call compare-cases id lhs right true)
        (call (. facts name-roles-since) instance id fielded .role-field)
        (call (. facts set-plan) instance id (if-expr (== op .equals-op) .plan-fields .plan-not-fields))
        (return (. types bool-type))
      )
      (if (and equates plain (call is-unlike lhs rhs))
        (call (. facts set-plan) instance id .plan-unlike)
        (return (. types bool-type))
      )
      (let atoms (or (== (call (. types intrinsic-of) lhs) .atom) (== (call (. types intrinsic-of) rhs) .atom)))
      (if (and equates plain atoms (!= lhs rhs) (!= lhs (. types null-type)) (!= rhs (. types null-type)))
        (call (. frame diagnose) id .illegal-operation null lhs rhs)
        (return invalid-type)
      )
      (if (and equates (== lhs rhs) (call is-identified lhs))
        (call (. facts set-plan) instance id .plan-identity)
        (return (. types bool-type))
      )
      (let classes (and (== (call (. types intrinsic-of) lhs) .class) (== (call (. types intrinsic-of) rhs) .class)))
      (if (and equates plain classes related)
        (call (. facts set-plan) instance id .plan-identity)
        (return (. types bool-type))
      )
      (lazy related (or (call in-base-chain types lhs rhs) (call in-base-chain types rhs lhs)))
      (if (and equates plain (!= lhs rhs) classes)
        (call (. facts set-plan) instance id .plan-unlike)
        (return (. types bool-type))
      )
      (if (and equates plain (!= lhs rhs) closures)
        (call (. facts set-plan) instance id .plan-unlike)
        (return (. types bool-type))
      )
      (lazy closures (and (== (call (. types intrinsic-of) lhs) .closure) (== (call (. types intrinsic-of) rhs) .closure)))
      (if (and equates plain (!= lhs rhs) (== (call (. types intrinsic-of) lhs) .union))
        (call plan-case-equal id left lhs right rhs)
        (return (. types bool-type))
      )
      (if (and equates plain (== (call (. types intrinsic-of) lhs) .interface) (!= rhs (. types null-type)))
        (call compare-interfaces id lhs rhs)
        (return (. types bool-type))
      )
      (if (and equates plain (== (call (. types intrinsic-of) lhs) .class) rhs-interface)
        (call (. facts set-plan) instance id .plan-unlike)
        (return (. types bool-type))
      )
      (lazy rhs-interface (== (call (. types intrinsic-of) rhs) .interface))
      (if (and (== (call (. types intrinsic-of) lhs-value) .interface) (!= rhs (. types null-type)))
        (call (. instances mark-may-panic) instance)
      )
      (if (and (call is-numeric types lhs) (not (call is-numeric types rhs-value)) (!= rhs (. types null-type)))
        (call (. frame diagnose) id .illegal-operation null lhs rhs)
        (return invalid-type)
      )
      (let unanswered
        (scope (and unplanned (!= lhs (. types null-type)) (!= rhs (. types null-type)))
          (lazy unplanned (== (call (. facts plan-of) instance id) .plan-none))
        )
      )
      (if (and plain unanswered (or (!= lhs-value rhs-value) (not equates)))
        (call (. frame diagnose) id .illegal-operation null lhs rhs)
        (return invalid-type)
      )
      (return (. types bool-type))
    )
    (if (and (call is-numeric types lhs) (not (call is-numeric types rhs)))
      (if (call (. calls has-operator) lhs token rhs)
        (return (call plan-answer id .plan-call (call (. calls operator-call) id lhs token right rhs)))
      )
      (if (and (call is-numeric types lhs-value) (not (call is-numeric types rhs-value)))
        (call (. frame diagnose) right .illegal-cast null rhs lhs-value)
        (return invalid-type)
      )
      (call (. frame diagnose) id .illegal-operation null lhs rhs)
      (return invalid-type)
    )
    (return (call plan-answer id .plan-call (call (. calls operator-call) id lhs token right rhs)))
  )
  (fn-do _ infer-held TypeId
    (param id SyntaxId)
    (param op Operator)
    (param left SyntaxId)
    (param lhs TypeId)
    (param right SyntaxId)
    (param rhs TypeId)
    ; `==` or `!=` where an operand is an optional, in the order the reference asks:
    ; - two tuples of which one declares `==` for the other are compared where both operands
    ;   hold a value, and two that hold nothing are equal;
    ; - else a function the operands declare for each other as they are answers, as for any
    ;   comparison: no type is given here, and nothing is recorded;
    ; - else the operands are compared as what they hold, and two that hold nothing are equal
    ;   where they are optionals of one type.
    ; The `==` of what they hold is typed as any `==` is, with the right operand first where the
    ; reference puts an optional on the right first. Where that `==` tests a union on the left
    ; for a case, the one plan tests the case of what the optional holds. Nothing is planned where
    ; that `==` has no plan, or where two optionals of different types would be answered by a
    ; function.
    (let lhs-value (if-expr (call (. types is-optional) lhs) (call (. types optional-inner) lhs) lhs))
    (let rhs-value (if-expr (call (. types is-optional) rhs) (call (. types optional-inner) rhs) rhs))
    (if (or (call (. types is-optional) lhs-value) (call (. types is-optional) rhs-value))
      (return no-type)
    )
    (let equals (call (. program store-atom) (str (. Operator equals-op))))
    (let tuples (and (== (call (. types intrinsic-of) lhs-value) .tuple) (== (call (. types intrinsic-of) rhs-value) .tuple)))
    (let declared (and tuples (or (call (. calls has-operator) lhs-value equals rhs-value) (call (. calls has-operator) rhs-value equals lhs-value))))
    (if (and (not declared) (or (not (call is-numeric types lhs-value)) (not (call is-numeric types rhs-value))))
      (let overridden (call infer-override id op left lhs right rhs false))
      (if (!= overridden no-type)
        (return overridden)
      )
    )
    (let paired (and (!= lhs lhs-value) (!= rhs rhs-value)))
    (let exchanged (and (!= rhs rhs-value) (or (== lhs lhs-value) (== lhs rhs) declared)))
    (let answer invalid-type)
    (if exchanged
      (= answer (call infer-binary-values id .equals-op right rhs-value left lhs-value))
      (else
        (= answer (call infer-binary-values id .equals-op left lhs-value right rhs-value))
      )
    )
    (let inner (call (. facts plan-of) instance id))
    (if (and (== answer (. types bool-type)) (== inner .plan-held) (not exchanged))
      (let tested (call (. facts held-of) instance id))
      (if (and (!= (. tested case-index) (. U32 max)) (not (. tested left)) (not (. tested right)))
        (call (. facts set-held)
          (block
            (arg instance)
            (arg id)
            (arg
              (call HeldPlan
                (block
                  (arg (. tested plan))
                  (arg (!= lhs lhs-value))
                  (arg (!= rhs rhs-value))
                  (arg false)
                  (arg false)
                  (arg (. tested case-index))
                )
              )
            )
          )
        )
        (return (. types bool-type))
      )
    )
    (let called
      (scope (or plain-called (== inner .plan-neither-call) (== inner .plan-not-or-call))
        (lazy plain-called (or (== inner .plan-call) (== inner .plan-negated-call)))
      )
    )
    (if (or (!= answer (. types bool-type)) (== inner .plan-none) (== inner .plan-held) undeclared-pair)
      (call (. facts set-plan) instance id .plan-none)
      (return answer)
    )
    (lazy undeclared-pair (and paired (!= lhs rhs) (not declared) called))
    (call (. facts set-held)
      (block
        (arg instance)
        (arg id)
        (arg
          (call HeldPlan
            (block
              (arg inner)
              (arg (!= lhs lhs-value))
              (arg (!= rhs rhs-value))
              (arg (and paired (or (== lhs rhs) declared)))
              (arg exchanged)
            )
          )
        )
      )
    )
    (return (. types bool-type))
  )
  (fn-do _ compare-fields Bool
    (param id SyntaxId)
    (param left TypeId)
    (param right TypeId)
    (param right-syntax SyntaxId)
    (param records Bool)
    (param within (list TypeId) (= (call (of List TypeId))))
    ; Whether two tuples or structs are compared field by field: both store as many fields under
    ; the same names, and each pair in turn is one type the machine compares, or declares `==`,
    ; or is one class or atoms, or two unions of one type compared case by case, or is again two
    ; such tuples or structs, or two optionals of one type that declares `==` or is one of these,
    ; compared where both hold a value. With `records`, the call of each `==` is recorded at the
    ; node, in the order the fields are stored.
    (let kind (call (. types intrinsic-of) left))
    (let other (call (. types intrinsic-of) right))
    (if (or (and (!= kind .tuple) (!= kind .struct)) (and (!= other .tuple) (!= other .struct)) (!= (call (. within find) left) null))
      (return false)
    )
    (+= within left)
    (finally (call (. within pop)))
    (call (. types complete) left)
    (call (. types complete) right)
    (let mine (. ([] (. types completions) left) properties))
    (let theirs (. ([] (. types completions) right) properties))
    (let equals (call (. program store-atom) (str (. Operator equals-op))))
    (let a U32)
    (let b U32)
    (while true
      (while (and (< a (. mine count)) (== (. ([] (. types properties) (+ (. mine start) a)) slot) (. U32 max)))
        (+= a 1)
      )
      (while (and (< b (. theirs count)) (== (. ([] (. types properties) (+ (. theirs start) b)) slot) (. U32 max)))
        (+= b 1)
      )
      (if (or (>= a (. mine count)) (>= b (. theirs count)))
        (return (and (>= a (. mine count)) (>= b (. theirs count))))
      )
      (if (!= (. ([] (. types properties) (+ (. mine start) a)) name) (. ([] (. types properties) (+ (. theirs start) b)) name))
        (return false)
      )
      (let held (call member-type ([] (. types properties) (+ (. mine start) a)) left))
      (let given (call member-type ([] (. types properties) (+ (. theirs start) b)) right))
      (+= a 1)
      (+= b 1)
      (if (or (== held no-type) (== held invalid-type) (== given no-type) (== given invalid-type))
        (return false)
      )
      (if (and (== held given) (call compares-by-machine types held) (not (call is-declared-number held)))
        (continue)
      )
      (if (call (. calls has-operator) held equals given)
        (if records
          (call (. calls operator-call) id held equals right-syntax given)
        )
        (continue)
      )
      (if (and (== held given) (or (call compares-by-machine types held) (call is-identified held)))
        (continue)
      )
      (if (and (== (call (. types intrinsic-of) held) .interface) (== (call (. types intrinsic-of) given) .interface))
        (if records
          (call require-interface-equality id held)
        )
        (continue)
      )
      (if (and (== held given) (call compare-cases id held right-syntax records within))
        (continue)
      )
      (if (and (== held given) (call (. types is-optional) held))
        (let inner (call (. types optional-inner) held))
        (if (call (. calls has-operator) inner equals inner)
          (if records
            (call (. calls operator-call) id inner equals right-syntax inner)
          )
          (continue)
        )
        (if (or (call compares-by-machine types inner) (call is-identified inner) (call compare-cases id inner right-syntax records within) (call compare-fields id inner inner right-syntax records within))
          (continue)
        )
        (return false)
      )
      (if (not (call compare-fields id held given right-syntax records within))
        (return false)
      )
    )
    (return true)
  )
  (fn-do _ compare-cases Bool
    (param id SyntaxId)
    (param type TypeId)
    (param right-syntax SyntaxId)
    (param records Bool)
    (param within (list TypeId) (= (call (of List TypeId))))
    ; Whether two unions of one type are compared case by case: they are equal where both hold
    ; the same case and what it holds is equal, compared as a field of a tuple is. A case that
    ; holds nothing of its own is equal to itself. With `records`, the call of each `==` is
    ; recorded at the node, in the order of the cases.
    (if (or (== type no-type) (== type invalid-type) (!= (call (. types intrinsic-of) type) .union) (!= (call (. within find) type) null))
      (return false)
    )
    (+= within type)
    (finally (call (. within pop)))
    (let equals (call (. program store-atom) (str (. Operator equals-op))))
    (for (in fact (call (. types cases-of) type))
      (let held (. fact type))
      (if (or (. fact is-default) (== held no-type))
        (continue)
      )
      (if (== held invalid-type)
        (return false)
      )
      (if (and (call compares-by-machine types held) (not (call is-declared-number held)))
        (continue)
      )
      (if (call (. calls has-operator) held equals held)
        (if records
          (call (. calls operator-call) id held equals right-syntax held)
        )
        (continue)
      )
      (if (call compares-by-machine types held)
        (continue)
      )
      (if (call is-identified held)
        (continue)
      )
      (if (== (call (. types intrinsic-of) held) .interface)
        (if records
          (call require-interface-equality id held)
        )
        (continue)
      )
      (if (call compare-fields id held held right-syntax records within)
        (continue)
      )
      (if (not (call compare-cases id held right-syntax records within))
        (return false)
      )
    )
    (return true)
  )
  (fn-do _ plan-case-equal _
    (param id SyntaxId)
    (param left SyntaxId)
    (param union TypeId)
    (param right SyntaxId)
    (param type TypeId)
    ; Plans `==` of a union with a value of another type, as the reference answers it: the union
    ; is tested for the case a value of that type is held as, and what it holds is compared with
    ; the value as any two values of the type are. Nothing is planned where that case holds
    ; another type than the value's, or the `==` of two such values has no plan.
    (let relation (call (. relations compare) type union false false null module))
    (if (or (!= (. relation kind) .relation-wrap-cast) (== (. relation case-index) (. U32 max)))
      (return)
    )
    (let held ([] (call (. types cases-of) union) (. relation case-index)))
    (if (or (. held is-default) (!= (. held type) type))
      (return)
    )
    (let answer (call infer-binary-values id .equals-op left type right type))
    (let inner (call (. facts plan-of) instance id))
    (if (or (!= answer (. types bool-type)) (== inner .plan-none) (== inner .plan-held))
      (call (. facts set-plan) instance id .plan-none)
      (return)
    )
    (call (. facts set-held) instance id (call HeldPlan inner false false false false (. relation case-index)))
  )
  (fn-expr _ is-identified Bool
    (param type TypeId)
    ; Whether two values of a type that declares no `==` are equal when they are one: one object
    ; of a class, one atom, one closure's data, or one code and data that two values of a function
    ; type hold.
    (or class-or-atom (== (call (. types intrinsic-of) type) .closure) (!= (call function-row types type) no-type))
    (where
      (lazy class-or-atom (or (== (call (. types intrinsic-of) type) .class) (== (call (. types intrinsic-of) type) .atom)))
    )
  )
  (fn-expr + answers-arithmetic Bool
    (param op Operator)
    (or (== op .add-op) (== op .subtract-op) (== op .multiply-op) (== op .divide-op) (== op .mod-op))
  )
  (fn-do + declares-operator Bool
    (param type TypeId)
    (param token Atom)
    (if (not (call is-declared-number type))
      (return false)
    )
    (let owner (call class-ref types type))
    (for (in decl (. ([] (. program modules) (. owner module)) decls))
      (match? decl
        (case (call .decl-function fn)
          (if (and (== (. fn owner) (. owner decl)) (== (. fn name) token))
            (return true)
          )
        )
      )
    )
    (return false)
  )
  (fn-do _ declared-arithmetic TypeId
    (param id SyntaxId)
    (param op Operator)
    (param left SyntaxId)
    (param lhs TypeId)
    (param right SyntaxId)
    (param rhs TypeId)
    (let token (call (. program store-atom) (str op)))
    (if (call declares-operator lhs token)
      (if (call (. calls has-operator) lhs token rhs (:arg-syntax right))
        (return (call plan-answer id .plan-call (call (. calls operator-call) id lhs token right rhs)))
      )
      (call (. frame diagnose) id .illegal-operation token lhs rhs)
      (return invalid-type)
    )
    (if (or (not (call is-numeric types lhs)) (not (call declares-operator rhs token)))
      (return no-type)
    )
    (if (and (or (== op .add-op) (== op .multiply-op)) (call (. calls has-operator) rhs token lhs (:arg-syntax left)))
      (let answered (call (. calls operator-call) id rhs token left lhs))
      (if (!= answered invalid-type)
        (call (. facts mark-swapped) instance id)
      )
      (return (call plan-answer id .plan-call answered))
    )
    (call (. frame diagnose) id .illegal-operation token lhs rhs)
    (return invalid-type)
  )
  (fn-expr _ is-declared-number Bool
    (param type TypeId)
    ; Whether a number's type is a class written over a machine number, which may declare its own
    ; operators: a comparison of two asks them first, as of any other type.
    (and (!= (. owner decl) 0) (call is-numeric types type) (not (call (. types is-builtin-decl) (. owner module) (. owner decl))))
    (where
      (lazy owner (call class-ref types type))
    )
  )
  (fn-do _ is-unlike Bool
    (param left TypeId)
    (param right TypeId)
    ; Whether two tuples or structs are never equal: they store other numbers of fields, or a
    ; field of one has another name than the field in its place in the other.
    (let kind (call (. types intrinsic-of) left))
    (let other (call (. types intrinsic-of) right))
    (if (or (and (!= kind .tuple) (!= kind .struct)) (and (!= other .tuple) (!= other .struct)))
      (return false)
    )
    (call (. types complete) left)
    (call (. types complete) right)
    (let mine (. ([] (. types completions) left) properties))
    (let theirs (. ([] (. types completions) right) properties))
    (let a U32)
    (let b U32)
    (while true
      (while (and (< a (. mine count)) (== (. ([] (. types properties) (+ (. mine start) a)) slot) (. U32 max)))
        (+= a 1)
      )
      (while (and (< b (. theirs count)) (== (. ([] (. types properties) (+ (. theirs start) b)) slot) (. U32 max)))
        (+= b 1)
      )
      (if (or (>= a (. mine count)) (>= b (. theirs count)))
        (return (or (< a (. mine count)) (< b (. theirs count))))
      )
      (if (!= (. ([] (. types properties) (+ (. mine start) a)) name) (. ([] (. types properties) (+ (. theirs start) b)) name))
        (return true)
      )
      (+= a 1)
      (+= b 1)
    )
    (return false)
  )
  (fn-do _ member-type TypeId
    (param property TypeProperty)
    (param owner TypeId)
    ; The type of a stored property, typed from the value its class writes when none is declared.
    (if (!= (. property type) no-type)
      (return (. property type))
    )
    (return (call demand-member property owner (. property name)))
  )
  (fn-expr _ number-ratio UnitRatio
    (param type TypeId)
    (call (. types unit-families ratio-between) type number-member)
  )
  (fn-do _ scaling-of Scaling
    (param multiplies Bool)
    (param lhs TypeId)
    (param rhs TypeId)
    (let left-pure (not (. (call number-ratio lhs) is-none)))
    (let right-pure (not (. (call number-ratio rhs) is-none)))
    (let left-unit (and (not left-pure) (!= (call unit-root types lhs) no-type)))
    (let right-unit (and (not right-pure) (!= (call unit-root types rhs) no-type)))
    (if (and multiplies left-pure right-pure)
      (return (call Scaling true lhs false true))
    )
    (if (and left-unit right-pure)
      (return (call Scaling true lhs false true))
    )
    (if (and left-pure right-unit)
      (return (call Scaling true (if-expr multiplies rhs no-type) true false))
    )
    (if (and (not multiplies) right-pure (call is-machine-number types lhs))
      (return (call Scaling true no-type false true))
    )
    (return (call Scaling false no-type false false))
  )
  (fn-do _ product-of Product
    (param multiplies Bool)
    (param lhs TypeId)
    (param rhs TypeId)
    (let one (call UnitRatio 1.0 1.0))
    (let skip (call Product false no-type one ""))
    (let families (. types unit-families))
    (if (and (== (. families derived length) 0) (not (call measures-in-family lhs)) (not (call measures-in-family rhs)))
      (return skip)
    )
    (let left-unit (!= (call unit-root types lhs) no-type))
    (if (or (== (call unit-root types rhs) no-type) (not (. (call number-ratio lhs) is-none)) (not (. (call number-ratio rhs) is-none)))
      (return skip)
    )
    (if (and (not left-unit) (or multiplies (not (call is-machine-number types lhs))))
      (return skip)
    )
    (let none (list UnitTerm))
    (let left (if-expr left-unit (call (. families dimension-of) lhs) (call Dimension true one none)))
    (let right (call (. families dimension-of) rhs))
    (if (or (not (. left known)) (not (. right known)))
      (return skip)
    )
    (let power I32 (if-expr multiplies 1 -1))
    (let terms (call added-terms (. left terms) (. right terms) power))
    (let factor (call ratio-times (. left factor) (call ratio-power (. right factor) power)))
    (if (== (. terms length) 0)
      (if (and (not (call measures-in-family lhs)) (not (call measures-in-family rhs)))
        (return skip)
      )
      (return (call Product true no-type factor ""))
    )
    (let spelled (call merged-terms (call spelled-terms lhs left-unit) (call spelled-terms rhs true) power))
    (let strict (and left-unit (call measures-in-family lhs) (call measures-in-family rhs)))
    (return (call named-unit terms factor spelled strict "make one side a plain number"))
  )
  (fn-do _ power-of Product
    (param base TypeId)
    (param power I32)
    (param halves Bool)
    (param remedy String)
    (let one (call UnitRatio 1.0 1.0))
    (let families (. types unit-families))
    (let dimension (call (. families dimension-of) base))
    (if (not (. dimension known))
      (return (call Product false no-type one ""))
    )
    (if (and halves (not (call halves-evenly (. dimension terms))))
      (return (call Product false no-type one (str "No unit times itself is " (call type-short-name types base) ", so its square root has no unit; " remedy)))
    )
    (let terms (call raised-terms (. dimension terms) power halves))
    (let raised (call ratio-power (. dimension factor) power))
    (let factor (if-expr halves (call ratio-root raised) raised))
    (if (== (. terms length) 0)
      (return (call Product true no-type factor ""))
    )
    (let written (call raised-terms (call spelled-terms base true) power false))
    (let spelled
      (scope (if-expr halves (if-expr (call halves-evenly written) halved terms) written)
        (lazy halved (call raised-terms written 1 true))
      )
    )
    (return (call named-unit terms factor spelled true remedy))
  )
  (fn-do _ named-unit Product
    (param terms (list UnitTerm))
    (param factor UnitRatio)
    (param spelled (list UnitTerm))
    (param strict Bool)
    (param remedy String)
    (let one (call UnitRatio 1.0 1.0))
    (let skip (call Product false no-type one ""))
    (let families (. types unit-families))
    (let result no-type)
    (let rival no-type)
    (if (and (== (. spelled length) 1) (== (. ([] spelled 0) power) 1))
      (= result (. ([] spelled 0) unit))
      (else
        (let sources (list DerivedUnit))
        (for (in source (call (. families sources-measuring) terms))
          (if (call names-unit (. source type))
            (+= sources source)
          )
        )
        (for (in source sources)
          (if (call same-terms (. source terms) spelled)
            (if (== result no-type)
              (= result (. source type))
              (else
                (= rival (. source type))
              )
            )
          )
        )
        (if (== result no-type)
          (let best -1)
          (for (in source sources)
            (let shared 0)
            (for (in term spelled)
              (for (in own (. source terms))
                (if (== (. own unit) (. term unit))
                  (+= shared 1)
                )
              )
            )
            (if (> shared best)
              (= best shared)
              (= result (. source type))
              (= rival no-type)
              (else-if (== shared best)
                (= rival (. source type))
              )
            )
          )
        )
      )
    )
    (if (!= rival no-type)
      (let first (call type-short-name types result))
      (let second (call type-short-name types rival))
      (let source (call (. families source-of) result))
      (if (and source (call same-terms (. source terms) spelled))
        (return (call Product false no-type one (str first " and " second " are both declared as " (call terms-text spelled) "; keep one of them where both can be named")))
      )
      (return (call Product false no-type one (str (call terms-text spelled) " could be " first " or " second "; convert an operand to the units one of them is declared from")))
    )
    (if (and (== result no-type) (== (. terms length) 1) (== (. ([] terms 0) power) 1))
      (= result (. ([] terms 0) unit))
    )
    (if (== result no-type)
      (if strict
        (return (call Product false no-type one (str "No unit is declared as " (call terms-text spelled) "; declare one with an equality, or " remedy)))
      )
      (return skip)
    )
    (let measured (call (. families dimension-of) result))
    (return (call Product true result (call ratio-over factor (. measured factor)) ""))
  )
  (fn-expr _ names-unit Bool
    (param type TypeId)
    (== (call (. types type-named) module (call (. program store-atom) (call type-short-name types type)) (call (. types env-frame))) type)
  )
  (fn-expr _ measures-in-family Bool
    (param type TypeId)
    (. (call (. types completion-of) type) has-equalities)
  )
  (fn-do _ spelled-terms (list UnitTerm)
    (param type TypeId)
    (param counted Bool)
    (let terms (list UnitTerm))
    (if (not counted)
      (return terms)
    )
    (let source (call (. types unit-families source-of) type))
    (if source
      (return (. source terms))
    )
    (+= terms (call UnitTerm type 1))
    (return terms)
  )
  (fn-do _ merged-terms (list UnitTerm)
    (param base (list UnitTerm))
    (param extra (list UnitTerm))
    (param power I32)
    (let families (. types unit-families))
    (let terms (list UnitTerm))
    (for (in term base)
      (+= terms term)
    )
    (for (in term extra)
      (let found false)
      (for (in index (..< 0 (. terms length)))
        (let unit (. ([] terms index) unit))
        (if (and (not found) (or (== unit (. term unit)) (call (. families same-family) unit (. term unit))))
          (= (. ([] terms index) power) (+ (. ([] terms index) power) (* (. term power) power)))
          (= found true)
        )
      )
      (if (not found)
        (+= terms (call UnitTerm (. term unit) (* (. term power) power)))
      )
    )
    (let kept (list UnitTerm))
    (for (in term terms)
      (if (!= (. term power) 0)
        (+= kept term)
      )
    )
    (return kept)
  )
  (fn-do _ plan-product TypeId
    (param id SyntaxId)
    (param left SyntaxId)
    (param lhs TypeId)
    (param right SyntaxId)
    (param rhs TypeId)
    (param product Product)
    (let number (. types f64-type))
    (call promote-operand left lhs number)
    (call promote-operand right rhs number)
    (call (. facts set-plan) instance id .plan-builtin)
    (return (call measured-result id product))
  )
  (fn-do _ raise-unit TypeId
    (param id SyntaxId)
    (param left SyntaxId)
    (param lhs TypeId)
    (param right SyntaxId)
    (param rhs TypeId)
    (let ratio (call number-ratio lhs))
    (let pure (not (. ratio is-none)))
    (if (and (not pure) (not (call measures-in-family lhs)))
      (return no-type)
    )
    (if (!= (call unit-root types rhs) no-type)
      (call (. frame diagnose) right .stated (call (. program store-atom) "A unit is raised to a plain number, which has no unit"))
      (return invalid-type)
    )
    (let number (. types f64-type))
    (if pure
      (call (. conversions record-conversion) left (call scaling-relation lhs number ratio) .reason-promotion)
      (let answered (call raise-number id right rhs))
      (if (or (== answered invalid-type) (not (call keeps-scaled lhs)))
        (return answered)
      )
      (call (. conversions record-conversion) id (call scaling-relation number lhs (call ratio-over (call UnitRatio 1.0 1.0) ratio)) .reason-result)
      (return lhs)
    )
    (let exponent (call (. types unit-amount) module tree right))
    (let whole (== (as (as (. exponent amount) I64) F64) (. exponent amount)))
    (if (or (!= (. exponent failed) 0) (!= (. exponent problem) "") (!= (. exponent terms length) 0) (not whole))
      (let message "A unit is raised only to a whole number written in place, as in \"(%% 3meters 2)\", which decides the unit it gives; make it a plain number to raise it to another power")
      (call (. frame diagnose) right .stated (call (. program store-atom) message))
      (return invalid-type)
    )
    (let raised (call power-of lhs (as (. exponent amount) I32) false "raise a plain number"))
    (if (!= (. raised problem) "")
      (call (. frame diagnose) id .stated (call (. program store-atom) (. raised problem)))
      (return invalid-type)
    )
    (if (not (. raised applies))
      (return no-type)
    )
    (call promote-operand left lhs number)
    (let answered (call raise-number id right rhs))
    (if (== answered invalid-type)
      (return answered)
    )
    (return (call measured-result id raised))
  )
  (fn-do _ raise-number TypeId
    (param id SyntaxId)
    (param right SyntaxId)
    (param rhs TypeId)
    (let token (call (. program store-atom) "%%"))
    (return (call plan-answer id .plan-call (call (. calls operator-call) id (. types f64-type) token right rhs)))
  )
  (fn-do _ measured-result TypeId
    (param id SyntaxId)
    (param product Product)
    (let number (. types f64-type))
    (let result (. product result))
    (let kept (and (!= result no-type) (call keeps-scaled result)))
    (let target (if-expr kept result number))
    (if (or kept (not (call ratio-is-one (. product ratio))))
      (call (. conversions record-conversion) id (call scaling-relation number target (. product ratio)) .reason-result)
    )
    (return target)
  )
  (fn-do + root-unit TypeId
    (param id SyntaxId)
    (param given TypeId)
    (param answered TypeId)
    (if (== (call unit-root types given) no-type)
      (return answered)
    )
    (let number (. types f64-type))
    (let ratio (call number-ratio given))
    (if (not (. ratio is-none))
      (let rooted (call ratio-root ratio))
      (if (call keeps-scaled given)
        (call (. conversions record-conversion) id (call scaling-relation number given (call ratio-over rooted ratio)) .reason-result)
        (return given)
      )
      (call (. conversions record-conversion) id (call scaling-relation number number rooted) .reason-result)
      (return number)
    )
    (if (not (call measures-in-family given))
      (return answered)
    )
    (let root (call power-of given 1 true "take the root of a plain number"))
    (if (!= (. root problem) "")
      (call (. frame diagnose) id .stated (call (. program store-atom) (. root problem)))
      (return invalid-type)
    )
    (if (not (. root applies))
      (return answered)
    )
    (return (call measured-result id root))
  )
  (fn-do _ keeps-scaled Bool
    (param unit TypeId)
    (let number (call builtin-number types unit))
    (return (== (call promote types number (. types f64-type)) (call promote types number number)))
  )
  (fn-do _ scales-into Bool
    (param scaling Scaling)
    (param target TypeId)
    (if (not (. scaling applies))
      (return false)
    )
    (if (== (. scaling result) no-type)
      (return (and (call is-machine-number types target) (== (call promote types target (. types f64-type)) target)))
    )
    (return (and (== (. scaling result) target) (call keeps-scaled target)))
  )
  (fn-do _ plan-scaling TypeId
    (param id SyntaxId)
    (param left SyntaxId)
    (param lhs TypeId)
    (param right SyntaxId)
    (param rhs TypeId)
    (param scaling Scaling)
    (let number (. types f64-type))
    (let left-type (if-expr (. scaling numbers-left) number lhs))
    (let right-type (if-expr (. scaling numbers-right) number rhs))
    (if (. scaling numbers-left)
      (call (. conversions record-conversion) left (call scaling-relation lhs number (call number-ratio lhs)) .reason-operand)
    )
    (if (. scaling numbers-right)
      (call (. conversions record-conversion) id (call scaling-relation rhs number (call number-ratio rhs)) .reason-operator false no-type right)
    )
    (let machine (call promote types left-type right-type))
    (call promote-operand left left-type machine)
    (call promote-operand right right-type machine)
    (call (. facts set-plan) instance id .plan-builtin)
    (let result (. scaling result))
    (if (or (== result no-type) (not (call keeps-scaled result)))
      (return machine)
    )
    (if (!= result machine)
      (call (. conversions record-conversion) id (call (. conversions compare-held) machine result) .reason-result)
    )
    (return result)
  )
  (fn-expr _ quotient-unit TypeId
    (param lhs TypeId)
    (param rhs TypeId)
    (case? (or (not family) (not (or (== lhs rhs) (call (. types unit-families same-family) rhs lhs))))
      no-type
    )
    (case? (and (call unit-drops-fraction types rhs lhs) (not (call unit-drops-fraction types lhs rhs)))
      rhs
    )
    (default
      lhs
    )
    (where
      (lazy family (and (!= (call unit-root types lhs) no-type) (. (call (. types completion-of) lhs) has-equalities)))
    )
  )
  (fn-do _ plan-quotient TypeId
    (param id SyntaxId)
    (param left SyntaxId)
    (param lhs TypeId)
    (param right SyntaxId)
    (param rhs TypeId)
    (param unit TypeId)
    (let number (call builtin-number types unit))
    (let machine (call promote types number number))
    (if (!= lhs unit)
      (call (. conversions convert) left left lhs unit .reason-operand)
    )
    (if (!= rhs unit)
      (call (. conversions convert) id right rhs unit .reason-operator)
    )
    (call promote-operand left unit machine)
    (call promote-operand right unit machine)
    (call (. facts set-plan) instance id .plan-builtin)
    (return machine)
  )
  (fn-do _ plan-arithmetic _
    (param id SyntaxId)
    (param left SyntaxId)
    (param lhs TypeId)
    (param right SyntaxId)
    (param rhs TypeId)
    (param unit TypeId)
    (param promoted TypeId)
    ; Plans arithmetic on two numbers as the machine operation in their promoted type. With a
    ; unit, the right operand is first brought to the unit by its ratio, both are brought to the
    ; machine type of the unit, and the result goes back to the unit.
    (let machine promoted)
    (let given rhs)
    (if (!= unit no-type)
      (= machine (call promote types (call builtin-number types unit) (call builtin-number types unit)))
      (if (!= rhs unit)
        (call (. conversions convert) id right rhs unit .reason-operator)
        (= given unit)
      )
    )
    (call promote-operand left lhs machine)
    (call promote-operand right given machine)
    (if (and (!= unit no-type) (!= unit machine))
      (let relation (call (. conversions compare-held) machine unit))
      (call (. conversions record-conversion) id relation .reason-result)
    )
    (call (. facts set-plan) instance id .plan-builtin)
  )
  (fn-do _ promote-operand _
    (param operand SyntaxId)
    (param source TypeId)
    (param target TypeId)
    ; Brings an operand to the type its operator works in. The cast is the operator's own, which
    ; the reference makes without recording it, so it has a reason of its own. It is recorded at
    ; the operand as written, and never at the value of a local the operand names.
    (if (== source target)
      (return)
    )
    (let relation (call (. conversions compare-held) source target))
    (call (. conversions record-conversion) operand relation .reason-promotion true)
  )
  (fn-do _ cast-operand _
    (param operand SyntaxId)
    (param source TypeId)
    (param target TypeId)
    ; Brings an operand of a comparison of two integers to the type both are compared in. The
    ; cast is the operator's own, as in the reference, so a literal is not checked for fit:
    ; `-1 < 4000000000u32` is legal.
    (if (== source target)
      (return)
    )
    (let relation (call (. conversions compare-held) source target))
    (call (. conversions record-conversion) operand relation .reason-operand)
  )
  (fn-do _ compare-interfaces _
    (param id SyntaxId)
    (param left TypeId)
    (param right TypeId)
    ; Plans `==` of a value of an interface with another value. Two values of interfaces are
    ; equal when the type behind the left one says so, through the function its witness table
    ; holds for equality, which the interface then requires; where the types behind them
    ; differ, the getter that says whether a tracker compares for a change is read. A value of a
    ; type that is no interface on the right is the panic the reference compiles in.
    (call (. instances mark-may-panic) instance)
    (if (!= (call (. types intrinsic-of) right) .interface)
      (call (. facts set-plan) instance id .plan-interface-unlike)
      (return)
    )
    (let fielded (. facts calls length))
    (call require-interface-equality id left)
    (call (. facts name-roles-since) instance id fielded .role-field)
    (call (. facts set-plan) instance id .plan-interface-equal)
  )
  (fn-do _ require-interface-equality _
    (param id SyntaxId)
    (param interface TypeId)
    ; Notes that two values of an interface are compared at a node: the interface requires
    ; equality, the getter of a tracker's comparison for a change is recorded at the node, and
    ; the comparison may panic. Under an effect that forbids it, it is TypeScript's error.
    (call (. instances mark-may-panic) instance)
    (let restricted
      (scope (/or/ heap-effects (. CompilationEffect no-safepoint) (. CompilationEffect no-suspend))
        (lazy heap-effects (/or/ (. CompilationEffect gc-free) (. CompilationEffect no-heap)))
      )
    )
    (if (!= (/and/ (call dispatch-effects (. frame surround effects)) restricted) 0)
      (call (. frame diagnose)
        (block
          (arg id)
          (arg .restricted)
          (arg (call (. program store-atom) "Interface equality requires unrestricted effects"))
        )
      )
      (return)
    )
    (call (. facts require-equality) interface)
    (let action (. types live-action-type))
    (if (!= action invalid-type)
      (call (. calls demand-module-getter)
        (block
          (arg (. (call class-ref types action) module))
          (arg (call (. program store-atom) "is-comparing-for-change"))
          (arg id)
        )
      )
    )
  )
  (fn-do _ infer-override TypeId
    (param id SyntaxId)
    (param op Operator)
    (param left SyntaxId)
    (param lhs TypeId)
    (param right SyntaxId)
    (param rhs TypeId)
    (param exchanged Bool)
    ; A comparison is answered by a function its operands declare. In order:
    ; - the operator itself;
    ; - the operator that says the reverse, negated: `!=` by `==`, `<=` by `>`;
    ; - for an ordering, the mirrored one with equality: `<` holds when neither `>` nor `==`
    ;   does, and `<=` when `>=` does not or `==` does;
    ; - the mirrored operator with the operands exchanged.
    ; Gives no type when nothing is declared.
    (let direct (call call-override id op left lhs right rhs exchanged))
    (if (!= direct no-type)
      (return (call plan-answer id .plan-call direct))
    )
    (let negated (call call-override id (call negation-of op) left lhs right rhs exchanged))
    (if (!= negated no-type)
      (return
        (call plan-answer
          (block
            (arg id)
            (arg .plan-negated-call)
            (arg (if-expr (!= negated invalid-type) (. types bool-type) negated))
          )
        )
      )
    )
    (let equates (or (== op .equals-op) (== op .not-equals-op)))
    (let mirror (call opposite-of op))
    (if (not equates)
      (let mirrored (call call-override id mirror left lhs right rhs exchanged))
      (if (== mirrored invalid-type)
        (return mirrored)
      )
      (if (!= mirrored no-type)
        (let equal (call call-override id .equals-op left lhs right rhs exchanged .role-equal))
        (if (!= equal no-type)
          (let strict (or (== op .less-than-op) (== op .greater-than-op)))
          (let plan
            (scope (if-expr strict neither-plan (. OperatorPlan plan-not-or-call))
              (lazy neither-plan (. OperatorPlan plan-neither-call))
            )
          )
          (return (call plan-answer id plan (if-expr (!= equal invalid-type) (. types bool-type) equal)))
        )
        (let mine (call type-class-name lhs))
        (let theirs (call type-class-name rhs))
        (let compared (if-expr (== mine theirs) mine (str mine " or " theirs)))
        (call (. frame diagnose) id .stated (call (. program store-atom) (str "Must implement == for " compared)))
        (return invalid-type)
      )
    )
    (if exchanged
      (return no-type)
    )
    (return (call infer-override id mirror right rhs left lhs true))
  )
  (fn-expr _ bitwise-name Atom
    (param op Operator)
    ; The name of the function that answers a bitwise operator in place of the operator itself,
    ; when one is declared.
    (case? (== op .bitwise-and-op)
      (!! (. types and-atom))
    )
    (case? (== op .bitwise-or-op)
      (!! (. types or-atom))
    )
    (default
      (!! (. types xor-atom))
    )
  )
  (fn-do _ plan-answer TypeId
    (param id SyntaxId)
    (param plan OperatorPlan)
    (param result TypeId)
    ; Records how an operator is answered, once a function was found to answer it.
    (if (!= result invalid-type)
      (call (. facts set-plan) instance id plan)
    )
    (return result)
  )
  (fn-expr _ type-class-name String
    (param type TypeId)
    (match ([] (. types rows) type)
      (case (call .type-class row)
        (call class-name program (. row module) (. row decl))
      )
      (default
        (call type-short-name types type)
      )
    )
  )
  (fn-do _ infer-containment TypeId
    (param id SyntaxId)
    (param positive Bool)
    (param container-syntax SyntaxId)
    (param container TypeId)
    (param item-syntax SyntaxId)
    (param item TypeId)
    (param is-right Bool)
    ; `has` and `has not` answer for each other: a container that declares only one is asked that
    ; one and the answer is negated, as the reference does for an operator and its opposite.
    ; `is-right` says the container is the operator's right operand, as it is for `is in`. A list
    ; written in place may be answered without being made (`plans-list-member`); one that is not
    ; records here what makes it.
    (let has-not (call (. program store-atom) "has not"))
    (let wanted (if-expr positive (!! (. types has-atom)) has-not))
    (let other (if-expr positive has-not (!! (. types has-atom))))
    (let chosen wanted)
    (if (and (not (call (. calls has-operator) container wanted item (:arg-syntax item-syntax))) answers-other)
      (= chosen other)
    )
    (lazy answers-other (call (. calls has-operator) container other item (:arg-syntax item-syntax)))
    (let found (call (. calls operator-call) id container chosen item-syntax item))
    (if (== found invalid-type)
      (return found)
    )
    (if is-right
      (call (. facts mark-swapped) instance id)
    )
    (call (. facts set-plan) instance id (if-expr (== chosen wanted) .plan-call .plan-negated-call))
    (if (and (== chosen (!! (. types has-atom))) (call plans-list-member id container-syntax container))
      (call (. facts set-plan) instance id .plan-list-member)
      (else-if (is ([] (. tree nodes) container-syntax) .node-list-syntax)
        (call (. instances mark-may-panic) instance)
        (call (. calls note-list) container-syntax container)
      )
    )
    (return (. types bool-type))
  )
  (fn-do _ plans-list-member Bool
    (param id SyntaxId)
    (param written SyntaxId)
    (param list TypeId)
    ; Whether `has` of a list written in place, which core's `List` answers, is answered as
    ; `List.has` answers it without making the list (`plan-list-member`): where `==` of two values
    ; of the list's item type, planned at the list, compares them by the machine, as one object or
    ; one atom, or by the one function it calls, declared in a class, which `List.has` sees as this
    ; module does. An extension's `==` that this module sees may be hidden from `List.has`.
    (return-if false (if (is-not ([] (. tree nodes) written) .node-list-syntax)))
    (blank)
    (let callee (call operator-callee id))
    (return-if false (if (or (== callee no-instance) (!= (. ([] (. instances rows) callee) module) (. types list-decl module)))))
    (blank)
    (if (or (!= (. ([] (. instances rows) callee) self-type) list) (not (call same-decl (call class-ref types list) (. types list-decl))))
      (return false)
    )
    (let item (call first-arg list))
    (return-if false (if (or (== item no-type) (== item invalid-type))))
    (blank)
    (let kind (call (. types intrinsic-of) item))
    (let identified (or (== kind .class) (== kind .atom)))
    (let declared (call (. calls has-operator) item (call (. program store-atom) (str (. Operator equals-op))) item))
    (return-if false (if (and (not declared) (not identified) (not (call compares-by-machine types item)))))
    (blank)
    (let answer (call infer-binary-values written .equals-op written item written item))
    (let plan (call (. facts plan-of) instance written))
    (let machine (and (== plan .plan-builtin) (call compares-by-machine types item)))
    (let same (and (== plan .plan-identity) identified))
    (let called (and (== plan .plan-call) (call in-class (call operator-callee written))))
    (return-if true (if (and (== answer (. types bool-type)) (or machine same called))))
    (blank)
    (call (. facts set-plan) instance written .plan-none)
    (return false)
  )
  (fn-do _ in-class Bool
    (param callee InstanceId)
    ; Whether a function is declared in the body of a class, which code sees wherever it sees the
    ; class, and not in an extension.
    (return-if false (if (== callee no-instance)))
    (blank)
    (let row ([] (. instances rows) callee))
    (match? ([] (. ([] (. program modules) (. row module)) decls) (. row decl))
      (case (call .decl-function fn)
        (return (is ([] (. ([] (. program modules) (. row module)) decls) (. fn owner)) .decl-class))
      )
    )
    (return false)
  )
  (fn-do _ operator-callee InstanceId
    (param id SyntaxId)
    ; The function the one call of an operator recorded at a node calls, or no instance where
    ; there is none, or more than one.
    (let found no-instance)
    (let fact (call (. facts first-call) instance id))
    (while (!= fact no-fact)
      (let row ([] (. facts calls) fact))
      (if (== (. row form) .call-operator)
        (return-if no-instance (if (or (!= found no-instance) (. row is-partial))))
        (blank)
        (= found (. row callee))
      )
      (= fact (. row next))
    )
    (return found)
  )
  (fn-do _ infer-conditional TypeId
    (param id SyntaxId)
    (param left SyntaxId)
    (param right SyntaxId)
    (param want Want)
    ; `value if condition`: an optional of the value, empty where the condition fails. A lambda
    ; given where a function is expected is that function, as the reference types it with the type
    ; expected (`want-fitting`): its optional is of that type.
    (let fitting (call fitting-of want))
    (call note-truthiness id right (call infer right) true)
    (let mark (. scratch narrowings mark))
    (call (. narrowing narrow-condition) right true)
    (let value (call infer left))
    (call pop-conditional mark)
    (if (== value invalid-type)
      (return invalid-type)
    )
    (let fits (and (!= fitting no-type) (!= value no-type) (== (call (. types intrinsic-of) value) .closure)))
    (let wrapped (call (. types optional-of) (if-expr fits fitting value)))
    (if (!= wrapped value)
      (call (. conversions convert) id left value wrapped .reason-join)
    )
    (return wrapped)
  )
  (fn-do _ infer-coalesce TypeId
    (param id SyntaxId)
    (param left SyntaxId)
    (param right SyntaxId)
    (param want Want)
    (if (call (. tree coalesces-condition) id left)
      (call (. frame diagnose)
        (block
          (arg id)
          (arg .stated)
          (arg
            (call (. program store-atom)
              (block
                (arg
                  (paragraph
                    "`value if condition ?? other` is not a choice of two values. Write `if condition then value else other`."
                  )
                )
              )
            )
          )
        )
      )
      (return invalid-type)
    )
    (let lhs
      (call infer-tested
        (block
          (arg left)
          (arg (if-expr (call (. want asks) .want-fitting) (call (. (call Want) asking) .want-fitting (. want type)) (call Want)))
        )
      )
    )
    (call forget-carried left)
    (+= skippable-depth 1)
    (let rhs (if-expr (call shared-symbol right) (call infer right) (call infer-comparand right lhs)))
    (-= skippable-depth 1)
    (if (or (== lhs invalid-type) (== rhs invalid-type))
      (return invalid-type)
    )
    (if (== lhs (. types void-type))
      (call (. frame diagnose) id .illegal-operation null lhs rhs)
      (return invalid-type)
    )
    (if (== lhs (. types null-type))
      (return rhs)
    )
    (if (not (call (. types is-optional) lhs))
      (call note-truthiness id left lhs)
    )
    (= rhs (call (. conversions adapted-literal) right rhs (call (. types optional-inner) lhs)))
    (let inner (call (. types optional-inner) lhs))
    (let target (if-expr (or (call (. types is-optional) rhs) (== rhs (. types null-type))) lhs inner))
    (let relation (call (. relations unify-present) lhs rhs module))
    (if (call (. types is-optional) lhs)
      (= relation (call (. relations unify-fallback) target rhs module))
    )
    (if (not (call relation-legal relation))
      (call (. frame diagnose) id .illegal-cast null rhs target)
      (return invalid-type)
    )
    (let joined (. relation unified))
    (let settled (call settle-joined right rhs joined))
    (if (!= inner joined)
      (call (. conversions convert) id left inner joined .reason-join)
    )
    (if (!= settled joined)
      (call (. conversions convert) id right settled joined .reason-join)
    )
    (return joined)
  )
  (fn-do _ infer-tested TypeId
    (param syntax SyntaxId)
    (param want Want (= (call Want)))
    ; The type of an operand of `&&`, `||` or `!`, of the left of `??`, and of the condition of
    ; `while` or `=?` or of a clause of a loop. A local that holds an optional is tested there as
    ; the optional it is, also where the flow knows it to hold a value, as the reference tests
    ; it: for whether it holds one, and not for what the one it holds is. Every other condition
    ; tests what it holds.
    (let read (call infer syntax want))
    (if (or (== read invalid-type) (== read no-type))
      (return read)
    )
    (if (not (call reads-held syntax read))
      (call note-tested-force syntax read)
      (return read)
    )
    (let declared (call slot-known (. (call (. bindings resolution-of) (. frame binding) syntax) slot)))
    (call (. facts replace-node-type) instance syntax declared)
    (return declared)
  )
  (fn-do _ note-tested-force _
    (param syntax SyntaxId)
    (param read TypeId)
    (match? ([] (. tree nodes) syntax)
      (case (call .node-unary-expression row)
        (if (and (== (. row op) .optional-force-op) (call reads-held (. row operand) read))
          (let fact (call (. facts first-force) instance syntax))
          (if (!= fact no-fact)
            (= (. ([] (. facts forces) fact) is-tested) true)
          )
        )
      )
    )
  )
  (fn-do _ reads-held Bool
    (param expr SyntaxId)
    (param read TypeId)
    ; Whether an expression reads a local that holds an optional, where the flow knows it to
    ; hold a value and so reads that value.
    (match? ([] (. tree nodes) expr)
      (case .node-identifier
        (let resolution (call (. bindings resolution-of) (. frame binding) expr))
        (if (== (. resolution kind) .resolve-slot)
          (let known (call slot-known (. resolution slot)))
          (return (and (call (. types is-optional) known) (== (call (. types optional-inner) known) read)))
        )
      )
    )
    (return false)
  )
  (fn-do _ infer-choice TypeId
    (param id SyntaxId)
    (param value-syntax SyntaxId)
    (param condition SyntaxId)
    (param other-syntax SyntaxId)
    (param want Want)
    ; `if condition then value else other`: the two sides joined, an optional where either side is
    ; `null` or an optional. A lambda given where a function is expected is that function, as
    ; `infer-conditional` types it. A choice a function gives as its result joins at the declared
    ; result type when both sides convert to it, as the reference casts each side there.
    (let fitting (call fitting-of want))
    (let wanted (if-expr (call (. want asks) .want-choice) (. want type) no-type))
    (call note-truthiness id condition (call infer condition))
    (let mark (. scratch narrowings mark))
    (call (. narrowing narrow-condition) condition true)
    (let value (call infer-choice-side value-syntax wanted))
    (let value-settled (call (. frame assigned-since) mark))
    (call (. frame pop-narrowing) mark)
    (call (. narrowing narrow-condition) condition false)
    (let other (call infer-choice-side other-syntax wanted))
    (call pop-conditional mark)
    (call widen-settled value-settled)
    (if (or (== value invalid-type) (== other invalid-type))
      (return invalid-type)
    )
    (if (and (!= wanted no-type) (call fits-choice value wanted) (call fits-choice other wanted))
      (if (!= value wanted)
        (call (. conversions convert) id value-syntax value wanted .reason-join)
      )
      (if (!= other wanted)
        (call (. conversions convert) id other-syntax other wanted .reason-join)
      )
      (return wanted)
    )
    (= value (call (. conversions adapted-literal) value-syntax value (call (. types optional-inner) other)))
    (= other (call (. conversions adapted-literal) other-syntax other (call (. types optional-inner) value)))
    (if (and (== value (. types null-type)) (== other (. types null-type)))
      (return value)
    )
    (if (== value (. types null-type))
      (return (call optional-side id other-syntax other value-syntax fitting))
    )
    (if (== other (. types null-type))
      (return (call optional-side id value-syntax value other-syntax fitting))
    )
    (let optional (or (call (. types is-optional) value) (call (. types is-optional) other)))
    (let present (call (. types optional-inner) value))
    (let present-other (call (. types optional-inner) other))
    (let relation (call (. relations unify) present present-other module))
    (if (not (call relation-legal relation))
      (= relation (call (. relations unify-fallback) present present-other module))
    )
    (if (not (call relation-legal relation))
      (call (. frame diagnose) id .illegal-cast null other present)
      (return invalid-type)
    )
    (let joined (. relation unified))
    (let result (if-expr optional (call (. types optional-of) joined) joined))
    (call join-side id value-syntax value present joined result)
    (call join-side id other-syntax other present-other joined result)
    (return result)
  )
  (fn-do _ infer-choice-side TypeId
    (param side SyntaxId)
    (param wanted TypeId)
    ; A side of a choice, of `wanted` when one is given: a case named by its symbol alone is the case
    ; of that type, and a choice is joined at it.
    (return-if (call infer side) (if (== wanted no-type)))
    (return-if (call infer-with-expected side wanted) (if (not (call (. tree is-choice-syntax) side))))
    (return (call infer side (call (. (call Want) asking) .want-choice wanted)))
  )
  (fn-expr _ fits-choice Bool
    (param side TypeId)
    (param wanted TypeId)
    (call relation-legal (call (. relations compare) side wanted true false null module))
  )
  (fn-do _ optional-side TypeId
    (param id SyntaxId)
    (param side SyntaxId)
    (param given TypeId)
    (param empty SyntaxId)
    (param fitting TypeId)
    ; The join of a choice one side of which is `null`: an optional of the other side, which each
    ; side converts to, or the other side where it is a union with a case that holds `null`.
    (let present (call (. types optional-inner) given))
    (if (and (== given present) (call holds-null given))
      (call (. conversions convert) id empty (. types null-type) given .reason-join)
      (return given)
    )
    (let fits (and (!= fitting no-type) (== (call (. types intrinsic-of) present) .closure)))
    (let result (call (. types optional-of) (if-expr fits fitting present)))
    (if (!= given result)
      (call (. conversions convert) id side given result .reason-join)
    )
    (call (. conversions convert) id empty (. types null-type) result .reason-join)
    (return result)
  )
  (fn-do _ join-side _
    (param id SyntaxId)
    (param side SyntaxId)
    (param given TypeId)
    (param present TypeId)
    (param joined TypeId)
    (param result TypeId)
    ; Converts a side of a choice to its join: a case named by its symbol alone is cast to the
    ; type the sides join to, as the reference casts it there.
    (let settled (call settle-joined side present joined))
    (let arrives (if-expr (call (. types is-optional) given) (call (. types optional-of) settled) settled))
    (if (!= arrives result)
      (call (. conversions convert) id side arrives result .reason-join)
    )
  )
  (fn-do _ settle-joined TypeId
    (param branch SyntaxId)
    (param value TypeId)
    (param joined TypeId)
    ; The type a branch of a join arrives in: a case named by its symbol alone that several types
    ; have is cast to the type the branches join to, as the reference casts it there.
    (if (or (== value joined) (not (call loose-symbol branch)))
      (return value)
    )
    (return (call infer-with-expected branch joined))
  )
  (fn-do _ infer-comparand TypeId
    (param right SyntaxId)
    (param lhs TypeId)
    (let symbol (call (. tree symbol-of) right))
    (if (and symbol (!= lhs invalid-type) (!= lhs no-type))
      (let owner (call (. types optional-inner) lhs))
      (if (call enum-case-decl types program owner symbol)
        (call note-enum-case owner symbol right)
        (call (. facts set-node-type) instance right owner)
        (return owner)
      )
    )
    (if (and (!= lhs invalid-type) (!= lhs no-type) (call (. tree calls-symbol) right))
      (return (call infer-with-expected right (call (. types optional-inner) lhs)))
    )
    (return (call infer right))
  )
  (fn-do _ infer-unary TypeId
    (param id SyntaxId)
    (param op Operator)
    (param operand-syntax SyntaxId)
    ; Types an operator written before its operand. A force of what an arm's condition tested takes
    ; the type the test gave (`collect-arms`). A force of what the flow does not know to hold a value
    ; ends what is known of properties, as the reference's panic where it holds none makes calls. A
    ; function value has no truth for `!` to deny.
    (if (== op .delete-op)
      (return (call infer-delete id operand-syntax))
    )
    (if (== op .facts-of-op)
      (return (. types string-type))
    )
    (let operand
      (block
        (scope (if-expr (and (== op .optional-force-op) (== operand-syntax (. arm-typing forced))) forced-type no-type)
          (lazy forced-type (call (. facts node-type) instance operand-syntax))
        )
      )
    )
    (let held false)
    (if (and (== operand no-type) (== op .not-op))
      (= operand (call infer-tested operand-syntax))
      (else-if (== operand no-type)
        (let found
          (call infer-found
            (block
              (arg operand-syntax)
              (arg (if-expr (== op .optional-force-op) (call (. (call Want) adding) .want-forced) (call Want)))
            )
          )
        )
        (= operand (. found type))
        (= held (. found held))
      )
    )
    (if (== operand invalid-type)
      (return invalid-type)
    )
    (if (== op .not-op)
      (call forget-carried operand-syntax)
      (return-if invalid-type (if (call refuse-error-truth operand-syntax operand)))
      (let completion (call (. types completion-of) operand))
      (let declares (and (== (. completion intrinsic) .class) (not (. completion is-builtin))))
      (let valued (or (== (. completion intrinsic) .tuple) (== (. completion intrinsic) .struct)))
      (if (and declares (== (call (. calls demand-method) operand (call (. program store-atom) "!")) no-instance))
        (call (. frame diagnose) id .illegal-operation null operand)
        (return invalid-type)
      )
      (if (or declares valued (== (. completion intrinsic) .string))
        (let shapes-start (. scratch call-arguments mark))
        (let types-start (. scratch types mark))
        (let syntax-start (. scratch syntax mark))
        (let arguments (call arguments-since shapes-start types-start syntax-start (. scratch no-types)))
        (let not-atom (call (. program store-atom) "!"))
        (let result (call (. calls method-call) id operand-syntax operand not-atom arguments))
        (call (. scratch syntax rewind) syntax-start)
        (call (. scratch types rewind) types-start)
        (call (. scratch call-arguments rewind) shapes-start)
        (return (call plan-answer id .plan-call result))
      )
      (if (or (== (. completion intrinsic) .closure) (== (. completion intrinsic) .binding))
        (call (. frame diagnose) id .illegal-operation)
        (return invalid-type)
      )
      (if (or (call is-numeric types operand) (== (. completion intrinsic) .cpointer) (call (. types is-optional) operand))
        (call (. facts set-plan) instance id .plan-builtin)
      )
      (return (. types bool-type))
    )
    (if (== op .bitwise-not-op)
      (let decided (if-expr (call is-integer operand) operand (call (. types type-row) .int64)))
      (if (!= operand decided)
        (call (. conversions convert) operand-syntax operand-syntax operand decided .reason-operand)
      )
      (if (call is-numeric types operand)
        (call (. facts set-plan) instance id .plan-builtin)
      )
      (return decided)
    )
    (if (== op .negative-op)
      (let completion (call (. types completion-of) operand))
      (let kind (. completion intrinsic))
      (let aggregate (or (== kind .class) (== kind .tuple) (== kind .struct)))
      (if (and (not (call is-numeric types operand)) aggregate (not (. completion is-builtin)))
        (let shapes-start (. scratch call-arguments mark))
        (let types-start (. scratch types mark))
        (let syntax-start (. scratch syntax mark))
        (let arguments (call arguments-since shapes-start types-start syntax-start (. scratch no-types)))
        (let neg-atom (call (. program store-atom) "-neg"))
        (let result (call (. calls method-call) id operand-syntax operand neg-atom arguments))
        (call (. scratch syntax rewind) syntax-start)
        (call (. scratch types rewind) types-start)
        (call (. scratch call-arguments rewind) shapes-start)
        (return (call plan-answer id .plan-call result))
      )
      (if (not (call is-numeric types operand))
        (call (. frame diagnose) id .illegal-operation null operand)
        (return invalid-type)
      )
      (call (. facts set-plan) instance id .plan-builtin)
      (return operand)
    )
    (if (== op .read-op)
      (let shapes-start (. scratch call-arguments mark))
      (let types-start (. scratch types mark))
      (let syntax-start (. scratch syntax mark))
      (let arguments (call arguments-since shapes-start types-start syntax-start (. scratch no-types)))
      (let read-atom (call (. program store-atom) "<-read"))
      (let result (call (. calls method-call) id operand-syntax operand read-atom arguments))
      (call (. scratch syntax rewind) syntax-start)
      (call (. scratch types rewind) types-start)
      (call (. scratch call-arguments rewind) shapes-start)
      (return (call plan-answer id .plan-call result))
    )
    (if (== op .optional-force-op)
      (if (call (. types is-optional) operand)
        (call (. instances mark-may-panic) instance)
        (call (. frame forget-members))
      )
      (let result (call (. types optional-inner) operand))
      (let slot (call (. narrowing condition-slot) operand-syntax))
      (let is-narrowed false)
      (let declared no-type)
      (if (and slot (not (call (. types is-optional) operand)))
        (= declared (call key-declared slot))
        (= is-narrowed (and (!= declared no-type) (call (. types is-optional) declared)))
      )
      (call (. facts record-force) instance id operand result is-narrowed)
      (if (and is-narrowed held (!= (. unsure-stores length) 0))
        (+= unsure-forces id)
        (+= unsure-operands operand-syntax)
        (+= unsure-declared declared)
        (+= unsure-forced (as (. unsure-stores length) U32))
      )
      (if (and is-narrowed (!= (. typing-lazies length) 0))
        (if (== (call (. scratch narrowed-since) ([] lazy-marks (- (. lazy-marks length) 1)) (!! slot)) no-type)
          (+= forcing-lazies ([] typing-lazies (- (. typing-lazies length) 1)))
          (+= forcing-facts (as (- (. facts forces length) 1) FactId))
          (+= forcing-declared declared)
        )
      )
      (return result)
    )
    (if (== op .type-of-op)
      (if (== (call (. types intrinsic-of) operand) .class)
        (call note-loose operand-syntax)
      )
      (let viewed (call (. types facet-of-type) operand))
      (return (call type-info-of id (if-expr viewed (call (. types facet-owner) viewed) operand)))
    )
    (if (== op .facts-of-op)
      (return (. types string-type))
    )
    (call decline operand-syntax)
    (return invalid-type)
  )
  (fn-do _ infer-delete TypeId
    (param id SyntaxId)
    (param operand-syntax SyntaxId)
    (match? ([] (. tree nodes) operand-syntax)
      (case (call .node-index-expression row)
        (let object (call infer (. row object)))
        (let key (call infer (. row index)))
        (if (or (== object invalid-type) (== key invalid-type))
          (return invalid-type)
        )
        (let name (call (. program store-atom) "-=[]"))
        (let result (call (. calls operator-call) operand-syntax object name (. row index) key))
        (if (and (== result object) (call intrinsic-is-tuple-like (call (. types intrinsic-of) object)))
          (call (. facts set-plan) instance operand-syntax .plan-store-answer)
          (call note-replacement operand-syntax object result)
        )
        (return (if-expr (== result (. types void-type)) object result))
      )
    )
    (call decline id)
    (return invalid-type)
  )
  (fn-do _ infer-cast TypeId
    (param id SyntaxId)
    (param lhs SyntaxId)
    (param rhs SyntaxId)
    ; A case named by its symbol alone is cast as the reference casts it: settled by the target
    ; first (`contextual-symbol`), and noted where the cast leaves it of no one type. A target that
    ; names nothing is reported where it is written. An event cast is wanted as the target, as
    ; `use-event` says.
    (let target (call (. types evaluate-type) module tree rhs (. frame env)))
    (let value (call infer lhs (call (. (call Want) escaping) target lhs)))
    (if (== target invalid-type)
      (call report-missing-type rhs (. frame env))
      (return invalid-type)
    )
    (if (== value invalid-type)
      (return target)
    )
    (let symbol (call (. tree symbol-of) lhs))
    (if symbol
      (let owner (call contextual-symbol types relations target symbol module))
      (if (and (!= owner invalid-type) (!= owner value))
        (call (. facts replace-node-type) instance lhs owner)
        (call note-enum-case owner symbol lhs)
        (= value owner)
        (else-if (!= owner invalid-type)
          (call (. calls settle-unfound) lhs)
        )
      )
    )
    (let cast (call cast-value id lhs value target))
    (if (!= cast invalid-type)
      (call note-unsettled lhs target true)
    )
    (return cast)
  )
  (fn-do _ cast-value TypeId
    (param id SyntaxId)
    (param lhs SyntaxId)
    (param value TypeId)
    (param target TypeId)
    (let callable (. ([] (. types completions) value) intrinsic))
    (if (or (== callable .closure) (== callable .binding))
      (return (call (. conversions convert) id lhs value target .reason-explicit))
    )
    (if (and (call is-const-array value) (not (call is-const-array target)) (!= (call cpointer-item target) no-type))
      (call (. frame diagnose) id .illegal-cast null value target)
      (return invalid-type)
    )
    (let relation (call (. relations compare-explicit) value target module))
    (let chooses (and (call relation-legal relation) (== (call (. types intrinsic-of) target) .or)))
    (let answer (call (. conversions answer-of) relation))
    (if (!= answer no-type)
      (= (. relation to) answer)
      (= (. relation unified) answer)
    )
    (if (and (call relation-legal relation) (!= (. relation kind) .relation-same))
      (let requested (if-expr chooses target no-type))
      (call (. conversions record-conversion) id relation .reason-explicit false requested lhs)
      (let down (or (== (. relation kind) .relation-down-cast) (== (. relation kind) .relation-interface-down-cast)))
      (if (or down (== (. relation kind) .relation-unwrap-cast))
        (call (. instances mark-may-panic) instance)
      )
      (if (call is-caught-cast relation value target)
        (call demand-union-error)
        (call (. facts set-plan) instance id .plan-caught-cast)
        (let mark (. scratch types mark))
        (call (. scratch types push) (. types union-error-type))
        (return (call result-type types target mark))
      )
    )
    (let collides (or (== (. relation reason) .reason-ambiguous) (== (. relation reason) .reason-conflict)))
    (if (and (not (call relation-legal relation)) (or collides (not (call explicit-cast-allowed value target))))
      (call (. conversions report-illegal) id relation value target)
      (return invalid-type)
    )
    (if (and (not (call relation-legal relation)) (call reinterprets value target))
      (call (. facts set-plan) instance id .plan-reinterpret)
    )
    (let open (or (. ([] (. types completions) target) has-variables) (call (. relations holds-alternatives) target)))
    (return (if-expr (or chooses (and open (call relation-legal relation))) (. relation to) target))
  )
  (fn-expr _ is-caught-cast Bool
    (param relation Relation)
    (param value TypeId)
    (param target TypeId)
    ; Whether a cast is one out of a union written under `catch`, to one of its cases and not to
    ; text: where it fails it gives an error in place of its value.
    (case? (or (== (. frame surround catch-depth) 0) (and (!= (. relation kind) .relation-unwrap-cast) not-down-cast))
      false
    )
    (case? (or (== target (. types string-type)) (. ([] (. types completions) target) has-variables))
      false
    )
    (default
      (and (== (call (. types intrinsic-of) value) .union) (== (. relation to) target))
    )
    (where
      (lazy not-down-cast (!= (. relation kind) .relation-down-cast))
    )
  )
  (fn-do _ reinterprets Bool
    (param value TypeId)
    (param target TypeId)
    ; Whether a cast is between an atom and a text, which keeps the bits of the value: an atom
    ; is a pointer at its text.
    (let source (call (. types intrinsic-of) value))
    (let destination (call (. types intrinsic-of) target))
    (if (and (== source .atom) (== destination .string))
      (return true)
    )
    (return (and (== source .string) (== destination .atom)))
  )
  (fn-expr _ explicit-cast-allowed Bool
    (param value TypeId)
    (param target TypeId)
    ; A number converts to any other, except between two units no equality relates.
    (case? (and (call is-unit-class types value) (call is-unit-class types target))
      false
    )
    (case? (and (call is-numeric types value) (call is-numeric types target))
      true
    )
    (default
      (call reinterprets value target)
    )
  )
  (fn-do _ infer-range TypeId
    (param id SyntaxId)
    (param op Operator)
    (param left-syntax SyntaxId)
    (param right-syntax SyntaxId)
    (param increment SyntaxId)
    (let item (call range-item id left-syntax right-syntax increment))
    (if (== item invalid-type)
      (return invalid-type)
    )
    (return (call range-construction id op item left-syntax right-syntax increment))
  )
  (fn-do _ range-item TypeId
    (param range SyntaxId)
    (param left-syntax SyntaxId)
    (param right-syntax SyntaxId)
    (param increment SyntaxId)
    (param peer TypeId (= no-type))
    ; The item of a range: what its sides and its step unify to, each converted to that where
    ; it is written. An integer written with no suffix at one side is of the type of the other, and
    ; one written as the step of the type of the sides, as beside an operator, and the range is of
    ; the type of the other side. Sides written so beside a float step are of the step's type. A range with no step written steps by one, which is converted to
    ; an item that is no number at the range itself. Such an integer takes the integer type of a
    ; peer given, as a loop's pattern states it, before the type of the other side. Sides of two
    ; integer types neither converts to unasked are of the type arithmetic promotes them to.
    (let left (if-expr (!= left-syntax 0) (call infer left-syntax) (. types position-type)))
    (let right (if-expr (!= right-syntax 0) (call infer right-syntax) (. types position-type)))
    (let step (if-expr (!= increment 0) (call infer increment) no-type))
    (if (or (== left invalid-type) (== right invalid-type) (== step invalid-type))
      (return invalid-type)
    )
    (if (and (!= peer no-type) (call is-integer peer))
      (= left (call (. conversions adapted-literal) left-syntax left peer))
      (= right (call (. conversions adapted-literal) right-syntax right peer))
    )
    (let left-given left)
    (let right-given right)
    (= left (call (. conversions adapted-literal) left-syntax left right))
    (= right (call (. conversions adapted-literal) right-syntax right left))
    (let relation (call (. relations unify) left right module))
    (let promoted (and (not (call relation-legal relation)) (call is-integer left) (call is-integer right)))
    (if (and (not (call relation-legal relation)) (not promoted))
      (call (. frame diagnose) range .illegal-operation null left right)
      (return invalid-type)
    )
    (let item
      (scope (if-expr promoted promotion (if-expr (!= left left-given) right right-adapted))
        (lazy promotion (call promote types left right))
        (lazy right-adapted (if-expr (!= right right-given) left (. relation unified)))
      )
    )
    (let step-given step)
    (= step (call (. conversions adapted-literal) increment step item))
    (if (and (!= step no-type) (== step step-given))
      (let stepped (call (. relations unify) item step module))
      (if (call relation-legal stepped)
        (= item (. stepped unified))
        (else
          (= left (call (. conversions adapted-literal) left-syntax left step))
          (= right (call (. conversions adapted-literal) right-syntax right step))
          (if (or (!= left step) (!= right step))
            (call (. frame diagnose) range .illegal-operation null item step)
            (return invalid-type)
          )
          (= item step)
        )
      )
    )
    (if (and (!= left-syntax 0) (!= left item))
      (call range-side left-syntax left item promoted)
    )
    (if (and (!= right-syntax 0) (!= right item))
      (call range-side right-syntax right item promoted)
    )
    (if (and (!= increment 0) (!= step item))
      (call (. conversions convert) increment increment step item .reason-element)
    )
    (if (and (== increment 0) (not (call intrinsic-is-numeric (call (. types intrinsic-of) item))))
      (call (. conversions convert) range range (call (. types type-row) .int64) item .reason-step)
    )
    (return item)
  )
  (fn-do _ range-side _
    (param side SyntaxId)
    (param given TypeId)
    (param item TypeId)
    (param promoted Bool)
    ; Brings a side of a range to its item: as an element converts, or where the sides are integers
    ; neither converts to unasked, by the cast arithmetic makes to the type both promote to.
    (if (not promoted)
      (call (. conversions convert) side side given item .reason-element)
      (return)
    )
    (call (. conversions record-conversion) side (call (. conversions compare-held) given item) .reason-element)
  )
  (fn-do _ range-construction TypeId
    (param id SyntaxId)
    (param op Operator)
    (param item TypeId)
    (param left-syntax SyntaxId)
    (param right-syntax SyntaxId)
    (param increment SyntaxId)
    (let shapes-start (. scratch call-arguments mark))
    (let types-start (. scratch types mark))
    (let syntax-start (. scratch syntax mark))
    (for (in _ (..< 0 3))
      (call (. scratch call-arguments push) (call CallArgument null false false false false))
      (call (. scratch types push) item)
    )
    (call (. scratch syntax push) (if-expr (!= left-syntax 0) left-syntax id))
    (call (. scratch syntax push) (if-expr (and (!= right-syntax 0) (!= left-syntax 0)) right-syntax id))
    (call (. scratch syntax push) (if-expr (!= increment 0) increment id))
    (if (== op .range-through-op)
      (call (. scratch call-arguments push) (call CallArgument null false false false false))
      (call (. scratch types push) (. types bool-type))
      (call (. scratch syntax push) id)
    )
    (let arguments (call arguments-since shapes-start types-start syntax-start (. scratch no-types)))
    (let env (call (. types class-env) (. types range-decl module) (. types range-decl decl)))
    (let pattern (. env this-type))
    (call (. types env-release) env)
    (let result (call (. calls construction-on) id pattern arguments))
    (call (. scratch syntax rewind) syntax-start)
    (call (. scratch types rewind) types-start)
    (call (. scratch call-arguments rewind) shapes-start)
    (return result)
  )
  (fn-do _ infer-tuple TypeId
    (param items (of RowRange SyntaxId))
    (let mark (. scratch types mark))
    (let names-mark (. scratch names mark))
    (let position 0)
    (let valid true)
    (for (in item ([] (. tree children) items))
      (let field (call infer item))
      (if (== field invalid-type)
        (= valid false)
      )
      (call note-loose item)
      (call note-escape item)
      (call (. scratch names push) (call (. types index-atom) position))
      (call (. scratch types push) field)
      (+= position 1)
    )
    (if (not valid)
      (call (. scratch types rewind) mark)
      (call (. scratch names rewind) names-mark)
      (return invalid-type)
    )
    (return (call (. types intern-tuple) mark names-mark))
  )
  (fn-do _ note-escape _
    (param value SyntaxId)
    ; A value the reference stores where it no longer follows it, in a local, a property or a field
    ; of a tuple, ends what it knows of what the value is read from (`forget-escaped`), or of
    ; every property where the value is `this` (`forget-receiver`). A cast or a `!` of a value is
    ; read from what the value is.
    (let subject (call (. tree escaped-subject) value))
    (match? ([] (. tree nodes) subject)
      (case .node-identifier
        (let resolution (call (. bindings resolution-of) (. frame binding) subject))
        (if (and (== (. resolution kind) .resolve-slot) (== (. ([] (. bindings slots) (. resolution slot)) kind) .slot-this))
          (call (. frame forget-receiver))
          (return)
        )
        (let key (call (. narrowing base-key) subject))
        (if key
          (call (. frame forget-escaped) key)
        )
      )
      (case (call .node-get-expression row)
        (if (. row is-optional)
          (return)
        )
        (let shared (call (. narrowing receiver-member) (. row object) (. row name)))
        (if shared
          (call (. frame forget-escaped) shared)
          (return)
        )
        (let base (call (. narrowing base-key) (. row object)))
        (if base
          (let key (call (. frame find-path-key) base (. row name)))
          (if key
            (call (. frame forget-escaped) key)
          )
        )
      )
    )
  )
  (fn-do _ infer-header TypeId
    (param id SyntaxId)
    (param expr SyntaxId)
    (param items (of RowRange SyntaxId))
    ; A header gives each item below it to the `with` of what the one before gave. Each call is
    ; recorded at the header, in order. The first is made on the value written, each after on the
    ; header itself, which stands for the answer of the one before; one of those that would
    ; convert its receiver is declined, since the conversion would be kept at the header.
    (let left (call infer expr))
    (let with-atom (call (. program store-atom) "with"))
    (let object expr)
    (for (in item ([] (. tree children) items))
      (if (== left invalid-type)
        (return invalid-type)
      )
      (let shapes-start (. scratch call-arguments mark))
      (let types-start (. scratch types mark))
      (let syntax-start (. scratch syntax mark))
      (call (. scratch call-arguments push) (call CallArgument null false false false false null))
      (call (. scratch types push) (call infer item))
      (call (. scratch syntax push) item)
      (let arguments (call arguments-since shapes-start types-start syntax-start (. scratch no-types)))
      (let mark (. facts calls length))
      (= left (call (. calls method-call) id object left with-atom arguments))
      (call (. facts name-roles-since) instance id mark .role-with)
      (call (. scratch syntax rewind) syntax-start)
      (call (. scratch types rewind) types-start)
      (call (. scratch call-arguments rewind) shapes-start)
      (if (and (== object id) (!= left invalid-type) (!= (call (. facts first-conversion) instance id) no-fact))
        (call decline id)
        (return invalid-type)
      )
      (= object id)
    )
    (return left)
  )
  (fn-do _ infer-list TypeId
    (param id SyntaxId)
    (param items (of RowRange SyntaxId))
    (param want Want (= (call Want)))
    ; The items are joined, unless the list is expected as a list of a type each item converts to on
    ; its own (`want-items`), which each is made then, as a declared local of that type would be. A
    ; list a membership test looks in is made only where the test makes it (`want-member`).
    (let makes (not (call (. want asks) .want-member)))
    (if makes
      (call (. instances mark-may-panic) instance)
    )
    (let start (. scratch types mark))
    (let syntax-start (. scratch syntax mark))
    (let count 0)
    (for (in item ([] (. tree children) items))
      (call (. scratch types push) (call infer item))
      (call (. scratch syntax push) item)
      (+= count 1)
    )
    (let peer (call literal-peer start syntax-start count))
    (let typed (. scratch types mark))
    (for (in offset (..< 0 count))
      (call (. scratch types push)
        (block
          (arg
            (call (. conversions adapted-literal)
              (block
                (arg ([] (. scratch syntax) (+ syntax-start offset)))
                (arg ([] (. scratch types) (+ start offset)))
                (arg peer)
              )
            )
          )
        )
      )
    )
    (let joined invalid-type)
    (let valid true)
    (for (in offset (..< 0 count))
      (if (== ([] (. scratch types) (+ typed offset)) invalid-type)
        (= valid false)
      )
    )
    (if valid
      (let expected (call expected-item want))
      (= joined (if-expr (!= count 0) (call (. relations join) typed) invalid-type))
      (if (and (!= count 0) (!= expected no-type) (call items-fit typed count expected))
        (= joined expected)
      )
      (if (== joined invalid-type)
        (call (. frame diagnose) id .stated (call (. program store-atom) "Incompatible types in list"))
        (= valid false)
      )
    )
    (if valid
      (for (in offset (..< 0 count))
        (let element ([] (. scratch types) (+ typed offset)))
        (let site ([] (. scratch syntax) (+ syntax-start offset)))
        (if (and (!= element joined) (!= (call (. tree symbol-of) site) null))
          (= element (call infer-with-expected site joined))
        )
        (if (!= element joined)
          (call (. conversions convert) site site element joined .reason-element)
        )
      )
    )
    (call (. scratch syntax rewind) syntax-start)
    (call (. scratch types rewind) start)
    (if (not valid)
      (return invalid-type)
    )
    (let list-mark (. scratch types mark))
    (call (. scratch types push) joined)
    (let list-type (call (. types class-named-with-args) module (!! (. types list-atom)) list-mark))
    (if makes
      (call (. calls note-list) id list-type)
    )
    (return list-type)
  )
  (fn-do _ expected-item TypeId
    (param want Want)
    ; The item of the list type a list is expected as (`want-items`), or no type.
    (if (not (call (. want asks) .want-items))
      (return no-type)
    )
    (let expected (call (. types optional-inner) (. want type)))
    (call (. types complete) expected)
    (match? ([] (. types rows) expected)
      (case (call .type-class row)
        (if (and (== (. row module) (. types list-decl module)) (== (. row decl) (. types list-decl decl)) (!= (. row args count) 0))
          (let item (call (. types child-type) (. row args) 0))
          (call (. types complete) item)
          (if (not (. ([] (. types completions) item) has-variables))
            (return item)
          )
        )
      )
    )
    (return no-type)
  )
  (fn-do _ items-fit Bool
    (param mark ScratchMark)
    (param count Int)
    (param expected TypeId)
    (for (in offset (..< 0 count))
      (if (not (call fits-choice ([] (. scratch types) (+ mark offset)) expected))
        (return false)
      )
    )
    (return true)
  )
  (fn-do _ infer-get Found
    (param id SyntaxId)
    (param object-syntax SyntaxId)
    (param name Atom)
    (param is-optional Bool)
    (param want Want)
    (let owner (call static-owner object-syntax))
    (if (!= owner no-type)
      (call (. facts set-node-type) instance object-syntax (call type-info-of object-syntax owner))
      (if (and (call (. want asks) .want-event) (or (== (call (. types intrinsic-of) owner) .class) owner-interface))
        (let qualified (call event-of owner name true))
        (if qualified
          (return (call qualified-event id qualified want))
        )
      )
      (lazy owner-interface (== (call (. types intrinsic-of) owner) .interface))
      (return (call Found (call static-get id owner name)))
    )
    (let chain-expr (call (. tree optional-chain-expr) object-syntax))
    (let object no-type)
    (let own no-type)
    (if (!= chain-expr 0)
      (let chained-found (call infer-found chain-expr))
      (= object (. chained-found type))
      (= own (. chained-found link))
      (if (and (!= object invalid-type) (call (. types is-optional) object))
        (call (. facts set-node-type) instance object-syntax (call (. types optional-inner) object))
        (else
          (call (. facts set-node-type) instance object-syntax object)
        )
      )
      (else
        (let object-found (call infer-found object-syntax (call (. (call Want) adding) .want-receiver)))
        (= object (. object-found type))
        (= own (. object-found link))
      )
    )
    (if (== object invalid-type)
      (return (call Found invalid-type))
    )
    (if (== (call (. types intrinsic-of) object) .type-info)
      (return (call Found (call static-get id (call type-info-about object) name)))
    )
    (if (and (== (. name text) "path") (not is-optional) (call is-machine-union object))
      (return (call Found (call plan-machine-path id object)))
    )
    (let form (if-expr is-optional (call note-chain id id object) (. ChainForm chain-plain)))
    (if (or (== form .chain-absent) (call absent-after object-syntax object))
      (return (call Found (. types null-type)))
    )
    (let optional (== form .chain-tested))
    (let doubted false)
    (if (and (not optional) (or (. frame members-narrowed) (!= (. frame narrowed-members length) 0) stable-paths))
      (let shared (call (. narrowing receiver-member) object-syntax name))
      (let base (call (. narrowing base-key) object-syntax))
      (let key shared)
      (if (and (not key) base)
        (= key (call (. frame find-path-key) base name))
      )
      (if (and key (call (. frame is-doubted) key))
        (if (not (call (. want asks) .want-store))
          (call decline id)
          (return (call Found invalid-type))
        )
        (= doubted true)
      )
      (if (and key (call (. frame knows-member) key))
        (let narrowed (call forced-member id key want))
        (if (!= narrowed no-type)
          (call plan-narrowed-read id object name)
          (if (== (call (. facts plan-of) instance id) .plan-none)
            (call plan-case-read
              (block
                (arg id)
                (arg (call narrowed-from key object name))
                (arg (call (. frame narrowed-cases) key))
                (arg narrowed)
              )
            )
          )
          (return (call (. (call (. (call Found narrowed) doubting) doubted) holding) (call (. want asks) .want-forced)))
        )
      )
    )
    (lazy stable-paths (!= (. frame path-stable length) 0))
    (let receiver (call link-receiver object-syntax object own optional))
    (let chained (and (or optional (call optional-chained object-syntax)) (call (. types is-optional) object)))
    (if (and chained optional (== chain-expr 0))
      (call (. facts unwrapped append) (call UnwrappedFact instance object-syntax receiver))
    )
    (let source (call projected-from object-syntax receiver))
    (if (and (!= source no-type) (not (call answers receiver name)))
      (= receiver source)
    )
    (let found (call (. (call read-property id object-syntax receiver name want) doubting) doubted))
    (if (== (. found type) invalid-type)
      (return found)
    )
    (if (and (call is-super-syntax object-syntax) (not (call calls-getter id)))
      (call (. frame diagnose) object-syntax .stated (call (. program store-atom) "Bare super is not a value"))
      (return (call (. found typed) invalid-type))
    )
    (return (call (. (call (. found typed) (if-expr chained (call (. types optional-of) (. found type)) (. found type))) linking) (. found type)))
  )
  (fn-do _ qualified-event Found
    (param id SyntaxId)
    (param event NamedEvent)
    (param want Want)
    ; An event a loop names by the class that declares it, which the loop hears as it bubbles up to
    ; the object that owns the loop. An event that is not public, or one published by key, does not
    ; bubble, which is an error at the node.
    (if (. event is-private)
      (call (. frame diagnose)
        (block
          (arg id)
          (arg .stated)
          (arg
            (call (. program store-atom)
              (block
                (arg
                  (paragraph
                    (str "Event \"" (. event name text) "\" is not public, so it does not bubble and cannot be named by its class")
                  )
                )
              )
            )
          )
        )
      )
      (return (call Found invalid-type))
    )
    (if (!= (. event key) no-type)
      (call (. frame diagnose)
        (block
          (arg id)
          (arg .stated)
          (arg
            (call (. program store-atom)
              (block
                (arg
                  (paragraph
                    (str "Keyed event \"" (. event name text) "\" does not bubble, so it cannot be named by its class")
                  )
                )
              )
            )
          )
        )
      )
      (return (call Found invalid-type))
    )
    (return (call use-event id event want))
  )
  (fn-do _ is-machine-union Bool
    (param union TypeId)
    ; Whether a type is the union of a state machine: the only union told apart by where it is made.
    (match? ([] (. types rows) union)
      (case (call .type-named-union row)
        (return (!= (. row made-at) 0))
      )
    )
    (return false)
  )
  (fn-do _ plan-machine-path TypeId
    (param id SyntaxId)
    (param union TypeId)
    ; `path` read from a value of a machine's union, as the reference answers it: a `List'String`
    ; of the names of its active cases, made empty and given each name by its `append`.
    (let mark (. scratch types mark))
    (call (. scratch types push) (. types string-type))
    (let list (call (. types class-named-with-args) module (!! (. types list-atom)) mark))
    (if (or (== list invalid-type) (== list no-type))
      (call decline id)
      (return invalid-type)
    )
    (call (. calls note-list) id list)
    (let given (. scratch types mark))
    (call (. scratch types push) (. types string-type))
    (let append (call (. calls demand-runtime-call) module list (call (. program store-atom) "append") given))
    (call (. scratch types rewind) given)
    (if (== append no-instance)
      (call decline id)
      (return invalid-type)
    )
    (do
      (inline (call (. facts record-call) instance id append .call-method (. scratch no-fills) false))
    )
    (call (. facts set-plan) instance id .plan-machine-path)
    (call (. instances mark-may-panic) instance)
    (return list)
  )
  (fn-do _ plan-narrowed-read _
    (param id SyntaxId)
    (param object TypeId)
    (param name Atom)
    ; A member a test narrowed is read as any member is, and only its type is the narrowed one: a
    ; field of a table's row is read from its column.
    (let kind (call (. types intrinsic-of) object))
    (if (and (!= kind .table-row) (!= kind .immutable-table-row))
      (return)
    )
    (let row (call row-struct-of object))
    (if (or (== row no-type) (!= (call (. types intrinsic-of) row) .struct))
      (return)
    )
    (let column (call property-named row name))
    (if (and column (== (. ([] (. types properties) column) storage-kind) .storage-eager))
      (call plan-table id .table-field (. ([] (. types properties) column) slot))
    )
  )
  (fn-do _ plan-array-field _
    (param id SyntaxId)
    (param object-syntax SyntaxId)
    (param name Atom)
    ; A field of numbers that a struct declares, read of an item of an array read by an index, is
    ; read as TypeScript reads one: where the array's storage holds the item, when the index is
    ; less than the array's size, and of what the function that answers for an index the array
    ; does not hold gives anywhere else.
    (if (!= (call (. facts first-call) instance id) no-fact)
      (return)
    )
    (match? ([] (. tree nodes) object-syntax)
      (case (call .node-index-expression row)
        (if (. row is-optional)
          (return)
        )
        (let item (call (. facts node-type) instance object-syntax))
        (if (!= (call (. types intrinsic-of) item) .struct)
          (return)
        )
        (let found (call property-named item name))
        (if (not found)
          (return)
        )
        (let field ([] (. types properties) found))
        (if (or (!= (. field storage-kind) .storage-eager) (!= (. field owner) item))
          (return)
        )
        (call (. calls plan-array-item)
          (block
            (arg object-syntax)
            (arg (call (. facts node-type) instance (. row index)))
            (arg (call (. facts first-call) instance object-syntax))
            (arg (. field type))
          )
        )
      )
    )
  )
  (fn-do _ calls-getter Bool
    (param id SyntaxId)
    ; Whether a read is answered by a getter. `super` is the receiver of a call and no value: a
    ; read after it that calls nothing has no object to read.
    (let fact (call (. facts first-call) instance id))
    (while (!= fact no-fact)
      (if (== (. ([] (. facts calls) fact) form) .call-getter)
        (return true)
      )
      (= fact (. ([] (. facts calls) fact) next))
    )
    (return false)
  )
  (fn-expr _ compiles-probe Bool
    (param id SyntaxId)
    (call (. program compiles-probe) module (. ([] (. instances rows) instance) decl) id)
  )
  (fn-do _ check-probe _
    (param id SyntaxId)
    (param row ASTProbe)
    ; A probe that compiles writes a record through the probes module, each call recorded at the
    ; probe in the order it makes them (`record-probe-call`): the head of the record, of the object it
    ; is written of where it has one, then each value written in it, then the flush the module makes
    ; once enough is written. The texts written in a log are its template, and no values.
    (let found (call probes-module id))
    (if (not found)
      (return)
    )
    (let probes found)
    (let event (!= (. row name) null))
    (let object (call check-probe-object (. row object)))
    (if (== object invalid-type)
      (return)
    )
    (let head (if-expr event "probe-event-head" "probe-log-head"))
    (if (!= object no-type)
      (= head (if-expr event "probe-object-event-head" "probe-object-log-head"))
    )
    (if (or (not (call record-probe-head id probes head object)) (not (call check-probe-values id probes (. row content) (not event))))
      (return)
    )
    (call record-probe-flush id probes)
  )
  (fn-do _ check-probe-counter _
    (param id SyntaxId)
    (param row ASTProbeCounter)
    ; A counter adds to the count the probes module keeps under its key, of the object it is written
    ; of where it has one, by one or by what it is given, which is converted to `U64`. One that
    ; compiles only as a metric of the profile adds to the metric instead, which the runtime counts.
    (let found (call probes-module id))
    (if (not found)
      (return)
    )
    (let probes found)
    (let profiles
      (scope (and (== (. row object) 0) uncounted (call (. program probes compiles-profile) (. row key text)))
        (lazy uncounted (not (call (. program probes compiles-counter) (. ([] (. program modules) module) name) (. row key text))))
      )
    )
    (let object (call check-probe-object (. row object)))
    (if (== object invalid-type)
      (return)
    )
    (let delta (call (. types type-row) .uint64))
    (if (!= (. row delta) 0)
      (let got (call infer-with-expected (. row delta) delta))
      (if (or (== got invalid-type) (== got no-type))
        (return)
      )
      (if (== (call (. conversions convert) (. row delta) (. row delta) got delta .reason-argument true true) invalid-type)
        (return)
      )
    )
    (let short (call (. types type-row) .uint16))
    (if profiles
      (call (. facts record-call) instance id no-instance .call-probe-metric (. scratch no-fills) false)
      (else-if (== object no-type)
        (call record-probe-call id probes "probe-counter-add" (list short delta) .call-probe-head)
      )
      (else
        (call record-probe-call
          (block
            (arg id)
            (arg probes)
            (arg "probe-object-counter-add")
            (arg (list short object short delta))
            (arg .call-probe-head)
          )
        )
      )
    )
  )
  (fn-do _ check-probe-group _
    (param id SyntaxId)
    (param row ASTProbeGroup)
    ; A group writes a record where it begins and one where it ends, each a record of its own the
    ; probes module opens or closes the group by, then flushes. A group of data records events, of the
    ; object it is written of where it has one, and one written as a log records logs. The values of a
    ; group are written where it begins, or where it ends where it only ends; a log that only ends
    ; writes them in a log of their own, then ends. A group that begins and ends ends where the block
    ; it is written in is left (see the emitter's `emit-probe-group`). A group of data of no object
    ; and no values that compiles only as a timer of the profile begins and ends the timer instead,
    ; which the runtime times. One that begins and ends of an object is declined.
    (let found (call probes-module id))
    (if (not found)
      (return)
    )
    (let probes found)
    (let key (if-expr (. row key) (. row key text) ""))
    (let objects (and (. row is-data) (!= (. row object) 0)))
    (if (and empty-data uncompiled (call (. program probes compiles-profile) key))
      (call (. facts record-call) instance id no-instance .call-probe-metric (. scratch no-fills) false)
      (return)
    )
    (lazy empty-data (and (. row is-data) (not objects) (or (. row is-begin) (. row is-end)) (== (. row content count) 0)))
    (lazy uncompiled (not (call (. program probes compiles-data) (. ([] (. program modules) module) name) key)))
    (if (and objects (. row is-begin) (. row is-end))
      (call decline id)
      (return)
    )
    (let object (if-expr objects (call check-probe-object (. row object)) no-type))
    (if (== object invalid-type)
      (return)
    )
    (let begins (if-expr (. row is-data) "probe-group-push-event" "probe-group-push"))
    (let ends (if-expr (. row is-data) "probe-group-pop-event" "probe-group-pop"))
    (if objects
      (= begins "probe-group-push-object")
      (= ends "probe-group-pop-object")
    )
    (let logs (not (. row is-data)))
    (if (. row is-begin)
      (if (or (not (call record-probe-head id probes begins object true)) (not (call check-probe-values id probes (. row content) logs)) (not (call record-probe-flush id probes)))
        (return)
      )
      (if (not (. row is-end))
        (return)
      )
      (if (call record-probe-head id probes ends object true)
        (call record-probe-flush id probes)
      )
      (return)
    )
    (if (not (. row is-end))
      (return)
    )
    (if logs
      (if (or (not (call record-probe-head id probes "probe-log-head" no-type)) (not (call check-probe-values id probes (. row content) true)) (not (call record-probe-flush id probes)))
        (return)
      )
      (if (call record-probe-head id probes ends no-type true)
        (call record-probe-flush id probes)
      )
      (return)
    )
    (if (and (call record-probe-head id probes ends object true) (call check-probe-values id probes (. row content) false))
      (call record-probe-flush id probes)
    )
  )
  (fn-do _ probes-module (? ModuleId)
    (param id SyntaxId)
    ; The probes module, which a probe that compiles writes its records through, or none, where the
    ; probe is declined.
    (let found (call (. program module-by-name) probes-module-name))
    (if (not found)
      (call decline id)
      (return null)
    )
    (return (as found ModuleId))
  )
  (fn-do _ record-probe-flush Bool
    (param id SyntaxId)
    (param probes ModuleId)
    (param name String (= "probe-flush-if-needed"))
    ; Records at a probe the call that ends a record it writes: the flush the probes module makes once
    ; enough is written, or the one it makes at once.
    (let none (list TypeId))
    (return (call record-probe-call id probes name none))
  )
  (fn-do _ check-probe-object TypeId
    (param object SyntaxId)
    ; The type of the object a probe is written of, or no type where it is written of none. One the
    ; probes module gives no id, which is neither an object of a class nor an array nor
    ; `Inspectable`, is declined.
    (if (== object 0)
      (return no-type)
    )
    (let got (call infer object))
    (if (or (== got invalid-type) (== got no-type))
      (return invalid-type)
    )
    (let cast (call probe-cast types got))
    (if (and (!= cast .probe-object) (!= cast .probe-array))
      (call decline object)
      (return invalid-type)
    )
    (return got)
  )
  (fn-do _ check-probe-values Bool
    (param id SyntaxId)
    (param probes ModuleId)
    (param content (of RowRange SyntaxId))
    (param logs Bool)
    ; Records the writes of the values written in a probe, in order. The texts written in a log are
    ; its template, and no values.
    (for (in item ([] (. tree children) content))
      (if (and logs (is ([] (. tree nodes) item) .node-string-syntax))
        (continue)
      )
      (if (not (call check-probe-value id probes item logs))
        (return false)
      )
    )
    (return true)
  )
  (fn-do _ check-probe-value Bool
    (param id SyntaxId)
    (param probes ModuleId)
    (param item SyntaxId)
    (param logs Bool)
    ; Records the write of a value written in a probe, as its type is cast (`probe-cast`): as it is, by
    ; the id of its object, or as its text, made as a print makes it, by a call that ends what is known
    ; of every property, here and in the reference. A log writes an object or an array
    ; as its text too, but for a snapshot (`$!`), whose object the probes module writes the snapshot
    ; of, and a preview (`$?`). A preview of a value written as its text writes the name of its type
    ; instead, and makes no text.
    (let value item)
    (let snapshot false)
    (let preview false)
    (match? ([] (. tree nodes) item)
      (case (call .node-probe-snapshot row)
        (= value (. row content))
        (= snapshot true)
      )
      (case (call .node-probe-preview row)
        (= value (. row content))
        (= preview true)
      )
    )
    (let got (call infer value))
    (if (or (== got invalid-type) (== got no-type))
      (return false)
    )
    (let cast (call probe-cast types got))
    (if (or (== cast .probe-number) (== cast .probe-text))
      (return (call record-probe-call id probes "probe-write" (list got)))
    )
    (if (and preview (== cast .probe-converted))
      (return (call record-probe-call id probes "probe-write" (list (. types string-type))))
    )
    (if (or (== cast .probe-converted) (and logs (not snapshot) (not preview)))
      (call note-unsettled value (. types string-type))
      (if (== (call (. conversions convert) value value got (. types string-type) .reason-print) invalid-type)
        (return false)
      )
      (call (. frame forget-members))
      (return (call record-probe-call id probes "probe-write" (list (. types string-type))))
    )
    (return
      (call record-probe-call
        (block
          (arg id)
          (arg probes)
          (arg "probe-write-object")
          (arg (list got (call (. types type-row) .uint16) (. types bool-type)))
        )
      )
    )
  )
  (fn-do _ record-probe-head Bool
    (param id SyntaxId)
    (param probes ModuleId)
    (param name String)
    (param object TypeId)
    (param groups Bool (= false))
    ; Records the call that starts a record of a probe, given the probe's number, and for one of an
    ; object the object and the number of its class, after the kind of record it opens or closes
    ; where it `groups`.
    (let short (call (. types type-row) .uint16))
    (if (== object no-type)
      (return (call record-probe-call id probes name (list short) .call-probe-head))
    )
    (if groups
      (return
        (call record-probe-call
          (block
            (arg id)
            (arg probes)
            (arg name)
            (arg (list short (call (. types well-known-type) probes-module-name "ProbeType") object short))
            (arg .call-probe-head)
          )
        )
      )
    )
    (return (call record-probe-call id probes name (list short object short) .call-probe-head))
  )
  (fn-do _ record-probe-call Bool
    (param id SyntaxId)
    (param probes ModuleId)
    (param name String)
    (param arguments (list TypeId))
    (param form CallForm (= .call-probe))
    ; Records at a probe a call of a function of the probes module, given values of types; one no
    ; function takes is declined. An error that leaves it is reported where it is made, and what
    ; follows runs, and making its text may panic.
    (let mark (. scratch types mark))
    (for (in argument arguments)
      (call (. scratch types push) argument)
    )
    (let callee (call (. calls demand-runtime-call) probes no-type (call (. program store-atom) name) mark))
    (call (. scratch types rewind) mark)
    (if (== callee no-instance)
      (call decline id)
      (return false)
    )
    (call demand-errors callee)
    (if (!= (. ([] (. instances signatures) callee) errors count) 0)
      (call (. instances mark-may-panic) instance)
    )
    (call (. facts record-call) instance id callee form (. scratch no-fills) false)
    (return true)
  )
  (fn-do _ infer-print TypeId
    (param id SyntaxId)
    (param body SyntaxId)
    ; The values written in a print are made text one by one. Several are joined by a function
    ; that polls, so the instance may panic.
    (match? ([] (. tree nodes) body)
      (case (call .node-tuple-syntax row)
        (call (. instances mark-may-panic) instance)
        (let narrowed (. frame members-narrowed))
        (for (in item ([] (. tree children) (. row items)))
          (call infer-print id item)
          (call (. frame doubt-members-at) narrowed)
        )
        (call (. frame forget-members))
        (return (. types void-type))
      )
    )
    (let printed (call infer body))
    (call (. frame forget-members))
    (if (or (== printed invalid-type) (== printed no-type))
      (return invalid-type)
    )
    (call note-unsettled body (. types string-type))
    (if (!= printed (. types string-type))
      (call (. conversions convert) id body printed (. types string-type) .reason-print)
    )
    (return (. types void-type))
  )
  (fn-do _ report-unheld TypeId
    (param id SyntaxId)
    ; The error for characters in a pattern over integer items that do not hold them as they are.
    (let byte (<= (. (call (. types completion-of) (. stream-view item)) bit-size) 8))
    (let text
      (scope (if-expr byte over-bytes over-items)
        (lazy over-bytes "Characters in a pattern over bytes must be ASCII; match other bytes by number")
        (lazy over-items
          (paragraph
            (str "Characters in a pattern over " (call type-display types (. stream-view item)) " items must fit that type")
          )
        )
      )
    )
    (call (. frame diagnose) id .stated (call (. program store-atom) text))
    (return invalid-type)
  )
  (fn-expr _ reads-name Bool
    (param pattern SyntaxId)
    ; Whether a pattern passes on what a name read from its subject gives: one that reads a
    ; name, one joined after it, or a name that captures either.
    (match ([] (. tree nodes) pattern)
      (case .node-type-property
        true
      )
      (case (call .node-type-and row)
        (call reads-name (. row left))
      )
      (case (call .node-type-capture row)
        (and (!= (. row type) 0) (call reads-name (. row type)))
      )
      (default
        false
      )
    )
  )
  (fn-do _ note-replacement _
    (param id SyntaxId)
    (param target TypeId)
    (param stored TypeId)
    ; An array stored over an array tells the runtime its storage is replaced, which marks stale
    ; the views of the old storage where it goes away or shrinks. What an assigning operator
    ; stores is what its function answers, as it is for an assignment what is written.
    (if (and (call is-array-value target) (call is-array-value stored))
      (call (. facts mark-replacing) instance id)
      (call (. instances mark-may-panic) instance)
    )
  )
  (fn-expr _ is-array-value Bool
    (param type TypeId)
    (case? (or (== type no-type) (== type invalid-type) (!= (call (. types intrinsic-of) type) .tuple))
      false
    )
    (default
      (or (!= (call (. types ancestor-of) type (. types array-decl)) no-type) immutable-array)
    )
    (where
      (lazy immutable-array (!= (call (. types ancestor-of) type (. types immutable-array-decl)) no-type))
    )
  )
  (fn-do _ stored-value TypeId
    (param rhs SyntaxId)
    (param written TypeId)
    ; The type of what an assignment stores. A value written after the `?` of an assignment is
    ; stored only where it holds a value, so what is stored is what that optional holds; the
    ; assignment then gives what the place holds afterwards, which where nothing was stored is
    ; what it held before. Any other value is stored as written.
    (if (or (== written invalid-type) (== written no-type) (not (call (. types is-optional) written)))
      (return written)
    )
    (match? ([] (. tree nodes) rhs)
      (case .node-optional-chain
        (return (call (. types optional-inner) written))
      )
    )
    (return written)
  )
  (fn-do _ projected-from TypeId
    (param object-syntax SyntaxId)
    (param receiver TypeId)
    ; The union a local declares when it reads as one of that union's cases: a member the case
    ; does not answer is still the union's own.
    (match? ([] (. tree nodes) object-syntax)
      (case .node-identifier
        (let resolution (call (. bindings resolution-of) (. frame binding) object-syntax))
        (if (== (. resolution kind) .resolve-slot)
          (let known (call slot-known (. resolution slot)))
          (if (and (!= known no-type) (!= known invalid-type) (!= known receiver))
            (if (== (call (. types intrinsic-of) known) .union)
              (return known)
            )
          )
        )
      )
    )
    (return no-type)
  )
  (fn-expr _ answers Bool
    (param receiver TypeId)
    (param name Atom)
    (case? (or (!= (call property-named receiver name) null) (call (. calls has-getter) receiver name))
      true
    )
    (default
      (!= (call (. calls method-binding) receiver name) no-type)
    )
  )
  (fn-do _ row-capture-of (? RowCapture)
    (param object-syntax SyntaxId)
    ; What a receiver stands for where it is the case of a row: a name a pattern bound to the
    ; case, or the receiver of a member that runs on a row's case, written or not.
    (let own ([] (. instances rows) instance))
    (let adapted (call RowCapture (. own row-receiver) (. own row-case) (. own row-validated)))
    (if (== object-syntax 0)
      (return (only-if adapted (if (!= (. own row-receiver) no-type))))
    )
    (match? ([] (. tree nodes) object-syntax)
      (case .node-identifier
        (let resolution (call (. bindings resolution-of) (. frame binding) object-syntax))
        (if (== (. resolution kind) .resolve-slot)
          (if (== (. ([] (. bindings slots) (. resolution slot)) kind) .slot-this)
            (return (only-if adapted (if (!= (. own row-receiver) no-type))))
          )
          (return (call cursor-of (. resolution slot)))
        )
      )
    )
    (return null)
  )
  (fn-do _ cursor-of (? RowCapture)
    (param slot SlotId)
    (for (in held row-cursors)
      (if (== (. held slot) slot)
        (return (. held capture))
      )
    )
    (return (only-if (call (. outer cursor-of) slot) (if (!= outer null))))
  )
  (fn-do _ is-stack-local Bool
    (param name SyntaxId)
    ; Whether a name stands for a global bound anew by each `do with` that names it.
    (let resolution (call (. bindings resolution-of) (. frame binding) name))
    (if (!= (. resolution kind) .resolve-global)
      (return false)
    )
    (match? ([] (. ([] (. program modules) (. resolution module)) decls) (. resolution decl))
      (case (call .decl-property row)
        (return (and (!= (. row decoration) null) (== (. row decoration text) "stack")))
      )
    )
    (return false)
  )
)

(fn-do + checker-for Checker
  (param session Session)
  (param instance InstanceId)
  (param around (? Checker) (= null))
  (param probe Bool (= false))
  (param nested Bool (= false))
  (param trial SyntaxRange (= (call SyntaxRange 0 0)))
  ; A checker for an instance, with the settings `Checker` takes. The kit of a checker that has
  ; finished is kept and used again, because making one allocates its frame, its calls, and every
  ; list they hold. The first checker a session makes lists its declarations before it types
  ; anything (`Checker.list-declarations`).
  (let idle (. session scratch idle))
  (if (== (. idle length) 0)
    (let made (call Checker session instance (call CheckerKit session) around probe nested trial))
    (call (. made list-declarations))
    (return made)
  )
  (let parts (as ([] idle (- (. idle length) 1)) CheckerKit))
  (call (. idle pop))
  (return (call Checker session instance parts around probe nested trial))
)

(fn-do + type-written-in Bool
  (param session Session)
  ; Types each instance written in another that the passes of a parallel type pass typed and none is
  ; taken from (`Instances.written-in`), once the one it was written in is typed and did not type it
  ; in its run, as a closure called after that one finished is typed (`Checker.run-after-enclosing`).
  ; Says whether it typed any.
  (let instances (. session instances))
  (let waiting (. instances written-in))
  (let typed false)
  (let kept 0)
  (for (in position (..< 0 (. waiting length)))
    (let id ([] waiting position))
    (let row ([] (. instances rows) id))
    (if (!= (. row state) .instance-unstarted)
      (continue)
    )
    (let around (. ([] (. instances rows) (. row enclosing)) state))
    (if (and (!= around .instance-done) (!= around .instance-failed))
      (= ([] waiting kept) id)
      (+= kept 1)
      (continue)
    )
    (let checker (call checker-for session id))
    (call (. checker run-after-enclosing))
    (call (. checker retire))
    (= typed true)
  )
  (while (> (. waiting length) kept)
    (call (. waiting pop))
  )
  (return typed)
)

(type _ LoopContainer (is Tuple)
  (prop + type TypeId)
  (prop + item TypeId)
)

(type _ RowCursor (is Tuple)
  ; A slot a pattern bound to the case of a row of a table of unions, and what it stands for.
  (blank)
  (prop + slot SlotId)
  (prop + capture RowCapture)
)

(type _ AssumedResult (is Tuple)
  ; What an action under a helper took for the type its pattern's arms give where they declare
  ; none, the type of its own value, and what its choices rest on: whether a name it reads
  ; selected a materializer, whether it is `it` alone, and where it is a captured name alone,
  ; what that name holds and whether it holds text; the action, the pattern it follows and its
  ; expression; and the value materializer taken to make its value again, which is called only
  ; once the arms are known to give that type.
  (blank)
  (prop + value TypeId)
  (prop + selects Bool)
  (prop + forwards-it Bool)
  (prop + forwarded TypeId)
  (prop + backed Bool)
  (prop + site SyntaxId)
  (prop + pattern SyntaxId)
  (prop + body SyntaxId)
  (prop + interface TypeId)
)

(type _ NamedEvent (is Tuple)
  ; An event a node names: the class that declares it, as the object's type has it, its name,
  ; what it publishes, and the type of its key where it is published by key, with the node that
  ; indexes it with a key where one does. An event that is not public does not bubble.
  (blank)
  (prop + owner TypeId)
  (prop + name Atom)
  (prop + payload TypeId)
  (prop + key TypeId (= no-type))
  (prop + address SyntaxId (= 0))
  (prop + is-private Bool (= false))
)

(type _ CalledObject (is Tuple)
  ; The object a method is called on, typed before the arguments of the call as the reference
  ; evaluates it (`type-called-object`): its node, its type, what it links an optional chain to,
  ; and the event it names where it names one.
  (blank)
  (prop + object SyntaxId (= 0))
  (prop + type TypeId (= no-type))
  (prop + link TypeId (= no-type))
  (prop + event (? NamedEvent) (= null))
)

(type _ WantRole (is U32)
  ; What the context of a node asks of it. Of the type it expects: a function given as a value
  ; chosen by a condition is of that type (`want-fitting`), the sides of `if condition then value
  ; else other` are joined at it (`want-choice`), a case a call names by its symbol alone is one of
  ; it (`want-owner`), and a value that leaves the node there is of it, so that an event the node
  ; names gives its endpoint where the type is the event's `Broadcastable`, reported at the place
  ; asked (`want-escape`). Of an event the node names: it is an argument of a call
  ; (`want-argument`), the container of a loop that adapts it (`want-adapt`), asked for itself
  ; (`want-event`), or the value of a property stored to (`want-store`). And of the node itself: it
  ; is the object a member is read from or called on, which `super` may be (`want-receiver`), a
  ; statement whose value nothing uses (`want-unused`), one of the statements a function gives its
  ; value from (`want-quasi`), a statement (`want-statement`), the operand of `!`, which reads
  ; what a property holds where the flow knows it holds a value (`want-forced`), a match written
  ; as a statement, whose arms are one for their own alone (`want-match-statement`), a line of a
  ; markup body (`want-content-line`), the container of a markup loop region, which the region
  ; observes itself (`want-observed`), the name of a pattern a pattern compares with or calls
  ; (`want-pattern`), or a list written with its items, which are each made the item of the list
  ; type it expects where each converts to it (`want-items`), or the list written that a membership
  ; test looks in, which records what makes it only where the test makes it (`want-member`).
  (blank)
  (variant want-none (= 0))
  (variant want-fitting (= 1))
  (variant want-choice (= 2))
  (variant want-owner (= 4))
  (variant want-escape (= 8))
  (variant want-argument (= 16))
  (variant want-adapt (= 32))
  (variant want-event (= 64))
  (variant want-store (= 128))
  (variant want-receiver (= 256))
  (variant want-unused (= 512))
  (variant want-quasi (= 1024))
  (variant want-statement (= 2048))
  (variant want-forced (= 4096))
  (variant want-match-statement (= 8192))
  (variant want-content-line (= 16384))
  (variant want-observed (= 32768))
  (variant want-pattern (= 65536))
  (variant want-items (= 131072))
  (variant want-member (= 262144))
)

(type _ Want (is Tuple)
  ; What the context of a node asks of it where its syntax does not say: the type it expects of the
  ; node, what that type is for there and the roles the node has (`WantRole`), and where a value
  ; that escapes it is reported. `infer` gives it to that node alone, and a node gives the one inside
  ; it that stands for it what it was asked.
  (blank)
  (prop + type TypeId (= no-type))
  (prop + roles U32)
  (prop + place SyntaxId (= 0))
  (fn-expr + asks Bool
    (param role WantRole)
    (!= (/and/ roles (as role U32)) 0)
  )
  (fn-expr + asking Want
    (param role WantRole)
    (param type TypeId)
    (call Want type (/or/ roles (as role U32)) place)
  )
  (fn-expr + adding Want
    (param role WantRole)
    (call Want type (/or/ roles (as role U32)) place)
  )
  (fn-expr + escaping Want
    (param type TypeId)
    (param place SyntaxId)
    (call Want type (/or/ roles (as (. WantRole want-escape) U32)) place)
  )
)

(type _ Found (is Tuple)
  ; What typing a node found beside its type: what a link of an optional chain gives by itself,
  ; which the chain holds in no optional between its links (`link`); the event it names where it was
  ; asked for one or stored, kept in `found-events` (`event`), and whether a member a markup element
  ; receives names it (`kept`); whether a property read where it is stored is in doubt (`doubted`);
  ; and whether the property `!` reads holds a value the flow knows of (`held`).
  (blank)
  (prop + type TypeId)
  (prop + link TypeId (= no-type))
  (prop + event U32 (= (. U32 max)))
  (prop + kept Bool)
  (prop + doubted Bool)
  (prop + held Bool)
  (fn-expr + typed Found
    (param type TypeId)
    (call Found type link event kept doubted held)
  )
  (fn-expr + linking Found
    (param link TypeId)
    (call Found type link event kept doubted held)
  )
  (fn-expr + doubting Found
    (param doubted Bool)
    (call Found type link event kept doubted held)
  )
  (fn-expr + holding Found
    (param held Bool)
    (call Found type link event kept doubted held)
  )
)

(type _ LiveContext (is U8)
  ; The live action of the reference open where a node is compiled: none, the one the value of
  ; a property runs in, another, the one a rule of a class runs in, the one the value of an
  ; assignment or a lazy declaration runs in that a function of its own runs again, the one
  ; the `whenever` clause of a loop on a stream is tested in, which a function of its own tests
  ; again, the one the conditions of a markup branch region or the container of a markup loop
  ; region are read in, which a function of its own reads again, or the one the condition a style
  ; rule written on a markup element is applied under is tested in as a gate is made, which a
  ; function of its own tests again.
  (blank)
  (variant live-none (= 0))
  (variant live-value (= 1))
  (variant live-other (= 2))
  (variant live-rule (= 3))
  (variant live-statement (= 4))
  (variant live-whenever (= 5))
  (variant live-region (= 6))
  (variant live-gate (= 7))
)

(type _ LoopSource (is Tuple)
  ; What the container of a markup loop region is to the region, as the reference's
  ; `markupLoopSource` finds it: the item of its rows, the type the region is given it as, and its
  ; kind, which names the markup runtime's function that makes the region of it: `collection`,
  ; `broadcastable` or `iterable`. The invalid type for the item where there is none.
  (blank)
  (prop + item TypeId)
  (prop + given TypeId)
  (prop + kind String)
)

(type _ FirstItems (is U8)
  ; What the reference knows of the item a part of a grammar starts with: it may start
  ; with anything, or it may match nothing; it starts with any item; it must start with one of
  ; certain characters; or it is shaped so that what the reference knows is not known here.
  (blank)
  (variant first-open (= 0))
  (variant first-any (= 1))
  (variant first-ranges (= 2))
  (variant first-unsure (= 3))
)

(type _ SelectionEffects
  ; What the body of a loop over a selection of a table's rows may change, as TypeScript's loop
  ; over rows notes it: a table's storage, the indices, or a table that grows; or that what it
  ; changes is not known.
  (blank)
  (prop + table Bool)
  (prop + indices Bool)
  (prop + selected-table Bool)
  (prop + unknown Bool)
)

(type _ Machining (is Tuple)
  ; The machine being typed (`type-machine`): its syntax and where it is stored, the instance of the
  ; machine above that it refines, the name of a machine nested in a case and whether its parts
  ; start with the machine around it; its parts (`items`), its cases and the names each keeps, the
  ; payload each case is given and the types of what each keeps, the cases it starts in, those
  ; typed and those waiting to be, and the groups found. A nested machine is typed in a frame of its
  ; own (`type-nested-machine`).
  (blank)
  (prop + syntax SyntaxId)
  (prop + store MachineStore)
  (prop + refined InstanceId)
  (prop + named (? Atom))
  (prop + outer-starts Bool)
  (prop + items (list SyntaxId))
  (prop + cases (list SyntaxId))
  (prop + kept (list (list Atom)))
  (prop + payloads (list TypeId))
  (prop + kept-types (list (list TypeId)))
  (prop + starts (list SyntaxId))
  (prop + typed (list SyntaxId))
  (prop + waiting (list SyntaxId))
  (prop + groups-found (list MachineGroup))
)

(type _ Matching (is Tuple)
  ; The match being typed (`infer-match`): whether it gives an optional, the block of a match that
  ; covers its subject and of one whose arms are blocks (`closed` and `arms`), whether `if` or
  ; `while` tests it (`open`), whether its subject reads a row of a table, the subject a case
  ; written alone is a case of, and the type of the subject.
  (blank)
  (prop + optional Bool)
  (prop + closed SyntaxId (= 0))
  (prop + arms SyntaxId (= 0))
  (prop + open Bool)
  (prop + rows Bool)
  (prop + case SyntaxId (= 0))
  (prop + subject TypeId (= no-type))
)

(type _ Arming (is Tuple)
  ; The arms being typed (`infer-arms`): whether they stand as a statement, where their values
  ; start on the typing scratch, the type expected of them, whether they unite and where the types
  ; they unite start, how many may run and whether several do, the slot of the subject's `it`, and
  ; how deep the arms that test for a present value are.
  (blank)
  (prop + statement Bool)
  (prop + start ScratchMark (= 0))
  (prop + expected TypeId (= no-type))
  (prop + unite Bool)
  (prop + union ScratchMark (= 0))
  (prop + possible U32)
  (prop + several Bool)
  (prop + it SlotId (= no-slot))
  (prop + present-depth U32)
)

(type _ ArmTyping (is Tuple)
  ; The arm being collected (`collect-arms`): the slot of its `it`, the symbol a choice in it
  ; names, and the force its value reads through.
  (blank)
  (prop + it SlotId (= no-slot))
  (prop + symbol SyntaxId (= 0))
  (prop + forced SyntaxId (= 0))
)

(type _ RuleStream (is Tuple)
  ; The stream a pattern written in code runs on: the stream match being typed, and the stream a
  ; local rule is called on, with whether its pattern reads a String's UTF-8 bytes.
  (blank)
  (prop + matched SyntaxId (= 0))
  (prop + stream TypeId (= no-type))
  (prop + encoded Bool)
)

(type _ Valuing (is Tuple)
  ; What the part of a grammar being typed gives: whether it gives no value of its own, and
  ; the arm whose action is being typed.
  (blank)
  (prop + unvalued Bool)
  (prop + action-arm SyntaxId (= 0))
)

(type _ RuleArms (is Tuple)
  ; The arms of a grammar and what they are converted to (`type-stream-arms`): the type
  ; given them, whether they give a span of the source, whether they are a rule's, whether they
  ; give their text, the pattern whose names they capture and where its captures start, and the
  ; call a pattern argument casts.
  (blank)
  (prop + target TypeId (= no-type))
  (prop + span Bool)
  (prop + rule Bool)
  (prop + texts Bool)
  (prop + capture-root SyntaxId (= 0))
  (prop + capture-base Size (= 0))
  (prop + casting SyntaxId (= 0))
)

(type _ StreamView (is Tuple)
  ; The stream a pattern reads (`record-stream-view`): the buffer that holds its items, the type of
  ; an item, and the type of the stream.
  (blank)
  (prop + buffer TypeId (= no-type))
  (prop + item TypeId (= no-type))
  (prop + type TypeId (= no-type))
)

(type _ Helping (is Tuple)
  ; The helper a grammar runs under and how it rolls back: the helper and where it is given,
  ; whether anything in the pattern rolls back through it, whether the pattern is marked to roll
  ; back, the body a mark is taken around, and whether it types a span of the source.
  (blank)
  (prop + helper (? PatternHelper) (= null))
  (prop + site SyntaxId (= 0))
  (prop + rolls Bool)
  (prop + explicit Bool)
  (prop + body SyntaxId (= 0))
  (prop + span-typing Bool)
)

(type _ Preparing (is Tuple)
  ; How the element being made is given its values and content: the element whose rules are
  ; applied, whether their values are taken once, whether content they generate is off or refused,
  ; and whether an outlet's content overlays what it holds.
  (blank)
  (prop + site SyntaxId (= 0))
  (prop + values-once Bool)
  (prop + content-off Bool)
  (prop + content-refused Bool)
  (prop + overlaying Bool)
)

(type _ Finally (is Tuple)
  ; The `finally` block being checked: whether its cleanup runs, the last node it watches, and
  ; how many loops are open around it.
  (blank)
  (prop + cleaning-up Bool)
  (prop + limit SyntaxId (= 0))
  (prop + loops Size (= 0))
)

(type _ CallArgumentsTyping (is Tuple)
  ; The arguments of the call being typed (`infer-call`): whether what each gives is kept for the
  ; call to settle, and whether the call names a function nothing declares.
  (blank)
  (prop + keeps Bool)
  (prop + unknown-callee Bool)
)

(type _ UnitStyling (is Tuple)
  ; The line of a unit's style being declared, and the property of a unit being updated.
  (blank)
  (prop + styling SyntaxId (= 0))
  (prop + updating SyntaxId (= 0))
)

(type _ Reading (is Tuple)
  ; What is being read for a value: the getter a row local reads, the lazy local, and whether an
  ; eager value is typed in its context.
  (blank)
  (prop + getter SyntaxId (= 0))
  (prop + lazy SyntaxId (= 0))
  (prop + eager Bool)
)

(type _ Region (is Tuple)
  ; The markup region being typed (`check-branch`, `check-loop-region`): the type of its content,
  ; the functions that keep, select and replace what it shows and the source it shows, whether it
  ; runs in a batch, and the slot of its root.
  (blank)
  (prop + content TypeId (= no-type))
  (prop + keeps InstanceId (= no-instance))
  (prop + select InstanceId (= no-instance))
  (prop + source TypeId (= no-type))
  (prop + replace InstanceId (= no-instance))
  (prop + batch Bool)
  (prop + root SlotId (= no-slot))
)

(type _ Keying (is Tuple)
  ; Where the state cells of the `when`s that style scopes are gathered under are made: whether the
  ; way to a slot outlet is followed (`outlet-scopes`), the class whose sheets that way adds, and the
  ; root `<This`, class, or element of markup the cells are keyed at, in its module.
  (blank)
  (prop + discovering Bool)
  (prop + sheet-self TypeId (= no-type))
  (prop + module ModuleId (= 0))
  (prop + site SyntaxId (= 0))
)

(type _ CheckerKit
  (implements IdleKit)
  ; What a checker is made of that its worker keeps from one instance to the next: its frame, its
  ; helpers and its lists. A checker made from a kit takes each as its own and empties the lists
  ; (`empty`), so that making one allocates none of them and each list keeps the room it grew to.
  (blank)
  (prop + frame Frame)
  (prop + narrowing Narrowing)
  (prop + conversions Conversions)
  (prop + calls Calls)
  (prop + endpoint-arguments (list SyntaxId))
  (prop + found-events (list NamedEvent))
  (prop + endpoint-events (list NamedEvent))
  (prop + kept-arguments (list SyntaxId))
  (prop + materialized (list SlotId))
  (prop + unsure-stores (list U32))
  (prop + unsure-reads (list U32))
  (prop + unsure-forces (list SyntaxId))
  (prop + unsure-operands (list SyntaxId))
  (prop + unsure-declared (list TypeId))
  (prop + unsure-forced (list U32))
  (prop + lazy-marks (list ScratchMark))
  (prop + raised-arms (list SyntaxId))
  (prop + loop-marks (list ScratchMark))
  (prop + machine-items (list SyntaxId))
  (prop + machine-cases (list SyntaxId))
  (prop + machine-kept (list (list Atom)))
  (prop + machine-payloads (list TypeId))
  (prop + machine-kept-types (list (list TypeId)))
  (prop + machine-starts (list SyntaxId))
  (prop + machine-typed (list SyntaxId))
  (prop + machine-waiting (list SyntaxId))
  (prop + machine-groups-found (list MachineGroup))
  (prop + carried-slots (list SlotId))
  (prop + raising-lazies (list SlotId))
  (prop + raising-starts (list Size))
  (prop + typing-lazies (list SlotId))
  (prop + forcing-lazies (list SlotId))
  (prop + forcing-facts (list FactId))
  (prop + forcing-declared (list TypeId))
  (prop + forgetting-lazies (list SlotId))
  (prop + retyped-reads (list SyntaxId))
  (prop + raising-entries (list Outgoing))
  (prop + getter-reads (list SlotId))
  (prop + lazy-transforms (list Size))
  (prop + entered-lazies (list SlotId))
  (prop + entered-starts (list Size))
  (prop + entered-slots (list SlotId))
  (prop + entered-types (list TypeId))
  (prop + carried-loops (list Size))
  (prop + carried-sites (list SyntaxId))
  (prop + whole-returns (list SyntaxId))
  (prop + yield-literals (list SyntaxId))
  (prop + ordered-yields (list TypeId))
  (prop + ordered-sites (list SyntaxId))
  (prop + ordered-literals (list SyntaxId))
  (prop + lazy-slots (list SlotId))
  (prop + row-cursors (list RowCursor))
  (prop + checked-rows (list SlotId))
  (prop + arm-bodies (list SyntaxId))
  (prop + arm-present (list Bool))
  (prop + arm-values (list SyntaxId))
  (prop + arm-givens (list TypeId))
  (prop + arm-starts (list Size))
  (prop + arm-ends (list Size))
  (prop + arm-settled (list Narrowed))
  (prop + region-left (list Narrowed))
  (prop + owner-names (list Atom))
  (prop + owner-unions (list TypeId))
  (prop + owner-declared (list Bool))
  (prop + foreseen-sites (list SyntaxId))
  (prop + foreseen-payloads (list TypeId))
  (prop + unheld-cases (list SyntaxId))
  (prop + feed-lists (list SyntaxId))
  (prop + feed-items (list TypeId))
  (prop + feed-builds (list Bool))
  (prop + coded-rules (list SyntaxId))
  (prop + coded-typed (list SyntaxId))
  (prop + coded-streams (list TypeId))
  (prop + typed-rules (list SyntaxId))
  (prop + typed-helpers (list SyntaxId))
  (prop + remade-positions (list U32))
  (prop + remade-types (list TypeId))
  (prop + assumed-results (list AssumedResult))
  (prop + assumed-sources (list TypeId))
  (prop + capture-sites (list SyntaxId))
  (prop + capture-slots (list SlotId))
  (prop + capture-accumulating (list Bool))
  (prop + capture-patterns (list SyntaxId))
  (prop + capture-repeats (list U32))
  (prop + right-arms (list SyntaxId))
  (prop + rules (list SyntaxId))
  (prop + spanning (list U64))
  (prop + content-blocks (list SyntaxId))
  (prop + content-parents (list TypeId))
  (prop + element-bodies (list SyntaxId))
  (prop + batched (list Bool))
  (prop + markup-styles (list TypeId))
  (prop + style-marks (list U32))
  (prop + markup-sheets (list TypeId))
  (prop + sheet-levels (list U32))
  (prop + rule-scopes (list ScopeUse))
  (prop + element-scopes (list ScopeUse))
  (prop + collected (list ScopeUse))
  (prop + scoped-sites (list SyntaxId))
  (prop + scoped-starts (list U32))
  (prop + scoped-ends (list U32))
  (prop + scoped-rows (list ScopeUse))
  (prop + pretyped (list SyntaxId))
  (prop + discoveries (list U64))
  (prop + slot-scopes (list ScopeUse))
  (prop + slot-sheets (list TypeId))
  (prop + slot-levels (list U32))
  (prop + slot-styles (list TypeId))
  (prop + outlet-classes (list TypeId))
  (prop + unbuilt (list SlotId))
  (prop + awaited (list SyntaxId))
  (prop + foreseen (list SlotId))
  (prop + foreseen-types (list TypeId))
  (prop + given-nodes (list SyntaxId))
  (prop + given-calls (list SyntaxId))
  (prop + given-callees (list InstanceId))
  (prop + given-positions (list U32))
  (prop + pulled-pipelines (list SyntaxId))
  (prop + pulled-reads (list SyntaxId))
  (prop + pulled-names (list Atom))
  (prop + held (list SlotId))
  (fn-do + This _
    (param session Session)
    (lazy frame (call Frame session))
    (lazy narrowing (call Narrowing frame))
    (lazy conversions (call Conversions frame))
    (lazy calls (call Calls frame conversions))
  )
  (fn-do + empty _
    (call (. endpoint-arguments clear))
    (call (. found-events clear))
    (call (. endpoint-events clear))
    (call (. kept-arguments clear))
    (call (. materialized clear))
    (call (. unsure-stores clear))
    (call (. unsure-reads clear))
    (call (. unsure-forces clear))
    (call (. unsure-operands clear))
    (call (. unsure-declared clear))
    (call (. unsure-forced clear))
    (call (. lazy-marks clear))
    (call (. raised-arms clear))
    (call (. loop-marks clear))
    (call (. machine-items clear))
    (call (. machine-cases clear))
    (call (. machine-kept clear))
    (call (. machine-payloads clear))
    (call (. machine-kept-types clear))
    (call (. machine-starts clear))
    (call (. machine-typed clear))
    (call (. machine-waiting clear))
    (call (. machine-groups-found clear))
    (call (. carried-slots clear))
    (call (. raising-lazies clear))
    (call (. raising-starts clear))
    (call (. typing-lazies clear))
    (call (. forcing-lazies clear))
    (call (. forcing-facts clear))
    (call (. forcing-declared clear))
    (call (. forgetting-lazies clear))
    (call (. retyped-reads clear))
    (call (. raising-entries clear))
    (call (. getter-reads clear))
    (call (. lazy-transforms clear))
    (call (. entered-lazies clear))
    (call (. entered-starts clear))
    (call (. entered-slots clear))
    (call (. entered-types clear))
    (call (. carried-loops clear))
    (call (. carried-sites clear))
    (call (. whole-returns clear))
    (call (. yield-literals clear))
    (call (. ordered-yields clear))
    (call (. ordered-sites clear))
    (call (. ordered-literals clear))
    (call (. lazy-slots clear))
    (call (. row-cursors clear))
    (call (. checked-rows clear))
    (call (. arm-bodies clear))
    (call (. arm-present clear))
