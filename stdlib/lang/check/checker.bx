  (fn-do + demand-errors _
    (param callee InstanceId)
    ; Settles a callee's errors for a call that reads them now. Every body they pass through is
    ; typed first, here when nothing has typed it yet.
    (if (call (. instances errors-known) callee)
      (return)
    )
    (let errors (. session errors))
    (while true
      (let base (call (. errors gather) callee))
      (if (== (. errors unready length) base)
        (break)
      )
      (while (> (. errors unready length) base)
        (let last (- (. errors unready length) 1))
        (let next (as ([] (. errors unready) last) InstanceId))
        (call (. errors unready rewind) last)
        (call demand-body next)
      )
    )
    (call (. errors settle) callee)
  )
  (fn-do + type-default _
    (param callee InstanceId)
    (param position U32)
    ; Types the default of a parameter of a callee where a call first takes it, as the reference
    ; compiles a default only for a call that takes it: what the default calls is typed then, and
    ; what it gets wrong is reported then. For a tuple's constructor it is the value its type writes
    ; for the field the call leaves out (`check-field-default`). The default of a nested function
    ; is typed nowhere, as no call of it has a shape.
    (if (or (== callee no-instance) (!= (. ([] (. instances rows) callee) enclosing) no-instance))
      (return)
    )
    (if (not (call (. instances type-default) callee position))
      (return)
    )
    (let checker (call checker-for session callee null true))
    (if (and (. checker described) (== (. checker described kind) .tuple-constructor-decl))
      (call (. checker check-field-default) position)
      (else-if (. checker described)
        (call (. checker prepare))
        (call (. checker check-default) position)
        (call (. checker close))
      )
    )
    (call (. checker retire))
  )
  (fn-do + demand-lambda InstanceId
    (param closure TypeId)
    (param args (of ImmutableArray TypeId ArenaBacking))
    (let owner 0u32)
    (let nested-decl 0u32)
    (let enclosing instance)
    (match? ([] (. types rows) closure)
      (case (call .type-closure row)
        (= owner (. row module))
        (= nested-decl (. row decl))
        (= enclosing (. row enclosing))
      )
    )
    (if (== nested-decl 0)
      (return no-instance)
    )
    (let effects (call callee-effects frame owner nested-decl))
    (let callee (call (. instances intern) owner nested-decl no-type effects enclosing (. scratch no-types) args))
    (if (!= (. ([] (. instances rows) callee) state) .instance-unstarted)
      (return callee)
    )
    (let live (if-expr (== enclosing instance) this (call definer enclosing)))
    (let writer (?? live (call settled enclosing)))
    (call (. writer share-captures) nested-decl)
    (call run-within callee writer)
    (if (not live)
      (call (. writer dismiss))
    )
    (return callee)
  )
  (fn-do + lambda-fit TypeId
    (param closure TypeId)
    (param args (of ImmutableArray TypeId ArenaBacking))
    ; The type a closure returns for the arguments a candidate of a call would pass it, or the
    ; invalid type when its body does not type with them: that candidate is not the one, and what
    ; the body got wrong under it is not reported. A body that was refused says nothing of the
    ; candidate, so the function being typed is refused with it.
    (let diagnosed (. facts diagnostics length))
    (let callee (call demand-lambda closure args))
    (if (== callee no-instance)
      (return invalid-type)
    )
    (call demand-errors callee)
    (let declined (call (. facts declined-since) diagnosed callee))
    (if (call (. facts drop-diagnostics) diagnosed callee)
      (call (. instances set-returns) callee invalid-type no-type .return-failed)
      (if declined
        (call decline (. frame declaration syntax))
      )
      (return invalid-type)
    )
    (let signature ([] (. instances signatures) callee))
    (if (== (. signature return-state) .return-pending)
      (return invalid-type)
    )
    (return (. signature returns))
  )
  (fn-do + binding-return BoundReturn
    (param binding TypeId)
    (param args (of ImmutableArray TypeId ArenaBacking))
    (param asked Bool (= false))
    (return (call (. calls bound-return) binding args asked))
  )
  (fn-do + whole-answer TypeId
    (param callable TypeId)
    (param returned TypeId)
    (param args (of ImmutableArray TypeId ArenaBacking))
    (param declared (of RowRange TypeId))
    (param bound InstanceId)
    ; What a closure or a binding answers a function type whose return nothing has bound yet:
    ; what it returns, or its value or one of its errors where it raises. A parameter of the
    ; type bound so is how an error crosses a value of the type. A binding's is asked after
    ; `binding-return`, which found what the binding calls (`bound`).
    (let binds (== (. ([] (. types completions) callable) intrinsic) .binding))
    (let callee (if-expr binds bound (call demand-lambda callable args)))
    (if (== callee no-instance)
      (return returned)
    )
    (call demand-errors callee)
    (let signature ([] (. instances signatures) callee))
    (if (== (. signature errors count) 0)
      (return returned)
    )
    (let mark (. scratch types mark))
    (for (in offset (..< 0 (. signature errors count)))
      (let error ([] (. instances signature-types) (+ (. signature errors start) offset)))
      (if (not (call declares-error declared error))
        (call (. scratch types push) error)
      )
    )
    (return-if returned (if (== (. scratch types length) mark)))
    (return (call result-type types (if-expr (== returned no-type) (. types void-type) returned) mark))
  )
  (fn-do + misused-endpoint Bool
    (param syntax SyntaxId)
    ; Whether a node that names an event, given to a call as its endpoint, is converted by a
    ; converter, as the reference converts no endpoint: reported as `refuse-event-value` says.
    (let place syntax)
    (match? ([] (. tree nodes) syntax)
      (case (call .node-argument row)
        (= place (. row expr))
      )
    )
    (let position (call (. endpoint-arguments find) place))
    (if (== position null)
      (return false)
    )
    (let event ([] endpoint-events position))
    (call refuse-event-value place (. event owner) (. event name))
    (let kept (call (. kept-arguments find) place))
    (if (!= kept null)
      (= ([] kept-arguments kept) 0)
    )
    (return true)
  )
  (fn-do + truth-callee InstanceId
    (param type TypeId)
    ; The function that says whether a value of a class or a text is empty, which a conversion
    ; of the value to a Bool calls. No instance for a value of any other type.
    (let completion (call (. types completion-of) type))
    (if (and (!= (. completion intrinsic) .class) (!= (. completion intrinsic) .string))
      (return no-instance)
    )
    (if (and (== (. completion intrinsic) .class) (. completion is-builtin))
      (return no-instance)
    )
    (return (call (. calls demand-method) type (call (. program store-atom) "!")))
  )
  (fn-do + tuple-arity U32
    (param value TypeId)
    (if (call is-column-receiver (call (. types intrinsic-of) value))
      (return (call column-count value))
    )
    (match? ([] (. types rows) value)
      (case (call .type-tuple row)
        (return (. row fields count))
      )
      (case .type-class
        (return (call struct-arity value))
      )
    )
    (return (. U32 max))
  )
  (fn-do + field-of TypeId
    (param value TypeId)
    (param position U32)
    (let kind (call (. types intrinsic-of) value))
    (if (call is-column-receiver kind)
      (let column (call column-at value position))
      (if (== column no-type)
        (return invalid-type)
      )
      (return (call (. types column-view-of) column (or (== kind .immutable-table) (== kind .immutable-table-span))))
    )
    (match? ([] (. types rows) value)
      (case (call .type-tuple row)
        (return
          (scope (if-expr (< position (. row fields count)) field-type invalid-type)
            (lazy field-type (call (. types child-type) (. row fields) position))
          )
        )
      )
      (case .type-class
        (return (call struct-field-of value position))
      )
    )
    (return invalid-type)
  )
  (fn-expr + has-items Bool
    (param type TypeId)
    ; Whether a type has items a list pattern reads: one that is `Indexable` and no text.
    (and (!= type (. types string-type)) (call implements type (. types indexable-decl)))
  )
  (fn-do + note-enum-case _
    (param about TypeId)
    (param name Atom)
    (param site SyntaxId)
    (param settles Bool (= true))
    ; Notes the case a site names as one of `about`, which `settles` where something expected of it
    ; is a type with the case (`leave-unfound`).
    (if settles
      (call (. calls settle-unfound) site)
    )
    (if (call (. tree calls-symbol) site)
      (let busy (call (. calls suspend-ranking)))
      (call infer-with-expected site about)
      (call (. calls resume-ranking) busy)
      (return)
    )
    (call note-case site about name)
    (let is-union (== (call (. types intrinsic-of) about) .union))
    (if (and is-union (== (?? (call enum-case-value about name) 0) 0))
      (return)
    )
    (if (and (not is-union) (not (. (call (. types completion-of) about) has-enums)))
      (return)
    )
    (let member (call enum-case-decl types program about name))
    (if (not member)
      (return)
    )
    (let home (. (call class-ref types about) module))
    (call demand-body (call (. instances intern-initializer) home member about))
    (call (. facts set-enum) instance site home member)
  )
  (fn-do + note-symbol-choice _
    (param about TypeId)
    (param expr SyntaxId)
    (let chosen (call symbol-choice expr))
    (if (== chosen 0)
      (return)
    )
    (call note-symbol-arm about chosen)
    (call note-symbol-arm about (call (. tree other-side) expr))
    (call (. facts replace-node-type) instance expr about)
  )
  (fn-do + note-enum-number _
    (param site SyntaxId)
    (param about TypeId)
    ; Types what a number converted to an enum by its place needs, at the node the conversion is
    ; recorded at: every value the enum declares is made, and the enum is constructed with
    ; nothing given for a number that is no value's place. The construction is recorded only at
    ; a node no call is recorded at.
    (let ref (call class-ref types about))
    (if (or (== (. ref module) (. U32 max)) (== site 0))
      (return)
    )
    (let home ([] (. program modules) (. ref module)))
    (for (in member (..< 0 (. home decls length)))
      (match? ([] (. home decls) member)
        (case (call .decl-case row)
          (if (== (. row owner) (. ref decl))
            (call demand-body (call (. instances intern-initializer) (. ref module) (as member DeclId) about))
          )
        )
      )
    )
    (if (!= (call (. facts first-call) instance site) no-fact)
      (return)
    )
    (let shapes-start (. scratch call-arguments mark))
    (let types-start (. scratch types mark))
    (let syntax-start (. scratch syntax mark))
    (let arguments (call arguments-since shapes-start types-start syntax-start (. scratch no-types)))
    (call (. calls construction-on) site about arguments)
    (let fact (call (. facts first-call) instance site))
    (while (!= fact no-fact)
      (if (== (. ([] (. facts calls) fact) form) .call-constructor)
        (= (. ([] (. facts calls) fact) form) .call-enum-default)
      )
      (= fact (. ([] (. facts calls) fact) next))
    )
  )
  (fn-do + record-witness _
    (param from TypeId)
    (param to TypeId)
    ; A value made a value of an interface. Where its type carries errors of its own, as a
    ; generator that raises does, a function of the interface that carries none panics with the
    ; error's text where the type's raises one, so the text of each is made. Where an object of a
    ; class is made one, the class must use the styles the interface does (`conform-styles`), and a
    ; value of any type made one must answer the functions the interface requires
    ; (`conform-members`).
    (call (. facts record-witness-table) from to)
    (if (and (== (call (. types intrinsic-of) from) .class) (== (call (. types intrinsic-of) to) .interface))
      (call conform-styles from to)
    )
    (if (and (!= (call (. types intrinsic-of) from) .interface) (== (call (. types intrinsic-of) to) .interface))
      (call conform-members from to)
    )
    (match? ([] (. types rows) from)
      (case (call .type-class row)
        (if (!= (. row errors count) 0)
          (for (in offset (..< 0 (. row errors count)))
            (call (. conversions demand-converter)
              (block
                (arg (call (. types child-type) (. row errors) offset))
                (arg (. types string-type))
              )
            )
          )
          (call (. conversions demand-error-report))
        )
      )
    )
  )
  (fn-do + demand-union-error _
    ; Types what an unwrapped union that holds another case raises: the error's constructor and
    ; the converter that gives the panic its message, with the report they are raised through.
    (if (!= (. instances report union-error) no-instance)
      (return)
    )
    (let error (. types union-error-type))
    (let made (call (. calls demand-constructor) error (. scratch types mark) false true))
    (let text (call (. conversions demand-converter) error (. types string-type)))
    (= (. instances report union-error) made)
    (= (. instances report union-text) text)
  )
  (fn-do + note-outgoing _
    (param error TypeId)
    (param syntax SyntaxId)
    ; An error leaving the function at a node.
    (call hold-transforms error syntax)
    (call (. frame note-outgoing) error syntax)
  )
  (fn-do + defer-outgoing _
    (param callee InstanceId)
    (param syntax SyntaxId)
    ; The errors of a callee not yet known leaving the function at a call.
    (call hold-transforms no-type syntax)
    (call (. frame defer-outgoing) callee syntax)
  )
  (fn-expr _ in-zone-body Bool :get
    ; Whether the instance is the body of a `do without gc` block.
    (== (. frame declaration kind) .region-decl)
  )
  (fn-do + retire _
    ; Hands the checker's kit back once nothing is running on it.
    (+= (. scratch idle) kit)
  )
  (fn-do + run _
    ; Types the instance, leaving it `unshared` where its typing, apart from the instances it typed in
    ; turn, changed what another type pass cannot take in (`unshared-weight`), and publishes what it
    ; found for the other passes of a parallel type pass (`share`), offering them what it queued. One
    ; whose return was read while it was typed and then failed makes the parallel pass diverge. An
    ; instance that is typed only in the run of another (`runs-inline`) is part of that run: what it
    ; changed is the other's change too, and where the other is left unshared, so is it, so that a
    ; pass types the two again together. It is left `unretirable` in the same way where what it changed
    ; is more than rows retiring it removes and what an edit typed again in place keeps
    ; (`unretirable-weight`).
    (let weight (call unshared-weight))
    (let nested (. scratch nested-unshared))
    (let fixed (call unretirable-weight))
    (let nested-fixed (. scratch nested-unretirable))
    (let inline-mark (. scratch inline-runs length))
    (probe typing.serial
      (if (not (. session shared))
        (probe-count typing.serial)
      )
    )
    (+= (. scratch runners) this)
    (+= (. scratch running) instance)
    (call check-instance)
    (call (. calls report-unsettled-cases))
    (call settle-generators)
    (call (. instances finish-body) instance)
    (call (. scratch runners pop))
    (call (. scratch running pop))
    (let changed (- (call unshared-weight) weight))
    (let changed-fixed (- (call unretirable-weight) fixed))
    (let inline (call runs-inline ([] (. instances rows) instance)))
    (if (!= changed (- (. scratch nested-unshared) nested))
      (= (. ([] (. instances rows) instance) unshared) true)
    )
    (if (!= changed-fixed (- (. scratch nested-unretirable) nested-fixed))
      (= (. ([] (. instances rows) instance) unretirable) true)
    )
    (if (not inline)
      (= (. scratch nested-unshared) (+ nested changed))
      (= (. scratch nested-unretirable) (+ nested-fixed changed-fixed))
    )
    (if (. ([] (. instances rows) instance) unshared)
      (for (in position (..< inline-mark (. scratch inline-runs length)))
        (= (. ([] (. instances rows) ([] (. scratch inline-runs) position)) unshared) true)
      )
    )
    (if (. ([] (. instances rows) instance) unretirable)
      (for (in position (..< inline-mark (. scratch inline-runs length)))
        (= (. ([] (. instances rows) ([] (. scratch inline-runs) position)) unretirable) true)
      )
    )
    (if inline
      (+= (. scratch inline-runs) instance)
      (else
        (while (> (. scratch inline-runs length) inline-mark)
          (call (. scratch inline-runs pop))
        )
      )
    )
    (let signature ([] (. instances signatures) instance))
    (if (and (. session shared) (. signature read-in-progress) (== (. signature return-state) .return-failed))
      (call (. session shared diverge))
    )
    (call share session instance)
    (call offer-queued session)
  )
  (fn-do + find-query-targets _
    ; Numbers the targets of descendant queries once for the program, from 1, as the reference
    ; collects them before it compiles a class: the class `T` of each property a class with no
    ; type parameters declares as `Descendants'T`, then of each of its rules `whenever children T`
    ; and `whenever descendants T`, in the order of the modules and of what they declare, each
    ; once. Those a class with type parameters may add are noted (`note-open-targets`). Each target
    ; is completed, as the reference makes the class it collects, so the class's table holds its
    ; methods though no object of it is made.
    (if (. facts query-targets-found)
      (return)
    )
    (= (. facts query-targets-found) true)
    (for (in position (..< 0 (. program modules length)))
      (let owner ([] (. program modules) position))
      (let index 0u32)
      (for (in decl (. owner decls))
        (match? decl
          (case (call .decl-class class)
            (if (== (. class type-args count) 0)
              (let ref (call DeclRef (as position ModuleId) index))
              (for (in member ([] (. owner member-pool) (. class members)))
                (match? ([] (. owner decls) member)
                  (case (call .decl-property property)
                    (let query
                      (block
                        (case? (!= (. property type-syntax) 0)
                          (call query-type ref (. property type-syntax))
                        )
                        (default
                          no-type
                        )
                      )
                    )
                    (if (and (!= query no-type) (not (call is-ancestor-query query)))
                      (let target (call query-target query))
                      (if (== (call (. facts query-targets find) target) null)
                        (+= (. facts query-targets) target)
                      )
                    )
                  )
                )
              )
              (for (in part (call sheet-parts ref))
                (let written ([] (. program modules) (. part module)))
                (for (in member ([] (. written member-pool) (call part-members part)))
                  (match? ([] (. written decls) member)
                    (case (call .decl-rule rule)
                      (let target (call trigger-target part (. rule syntax)))
                      (if (and (!= target no-type) (== (call (. facts query-targets find) target) null))
                        (+= (. facts query-targets) target)
                      )
                    )
                  )
                )
              )
              (else
                (call note-open-targets (call DeclRef (as position ModuleId) index) (. class members))
              )
            )
          )
        )
        (+= index 1)
      )
    )
    (for (in target (. facts query-targets))
      (call (. types complete) target)
    )
  )
  (fn-do + open-class-env Bool
    (param receiver TypeId)
    (match? ([] (. types rows) receiver)
      (case (call .type-class row)
        (call (. frame open-env) (call (. types class-env-for) (. row module) (. row decl) (. row args) receiver))
        (return true)
      )
    )
    (return false)
  )
  (fn-do + prepare _
    (if prepared
      (return)
    )
    (= prepared true)
    (call (. conversions attach) this)
    (call (. calls attach) this)
    (= (. frame declaration) (!! described))
    (if outer
      (call (. frame adopt) (. outer frame))
      (else
        (= (. frame binding) (call (. session binder bind) module (. frame decl)))
      )
    )
    (call (. frame open) (. frame binding) (call feeds-consumer))
    (let receiver (call logical-receiver session module (. frame decl) (. frame self-type)))
    (let names-mark (. scratch names mark))
    (let items-mark (. scratch types mark))
    (call (. types clear-fault))
    (let plain (call signature-into types module (. frame decl) (call no-type-arguments types) receiver true))
    (let faulted (call report-fault (. frame declaration syntax) true))
    (let param-count (. ([] (. instances signatures) instance) param-count))
    (let given (call no-type-arguments types))
    (if (== param-count (. plain params length))
      (let bound-start (. scratch types mark))
      (for (in position (..< 0 param-count))
        (call (. scratch types push) (call (. instances param-type) instance position))
      )
      (= given (call TypeArguments (. plain params) (call (. scratch types since) bound-start)))
    )
    (let around (? TypeEnv) null)
    (if outer
      (= around (. outer frame env))
    )
    (call (. frame open-env) (. (call function-env types module (. frame decl) given receiver true around) env))
    (let signature (call signature-into types module (. frame decl) given receiver true))
    (if (not faulted)
      (call report-missing-signature signature)
    )
    (let is-constructor (call is-constructor-kind (. frame declaration kind)))
    (let self (. frame self-type))
    (let returns (. signature returns))
    (= declared-return (call stated-return types module (. frame decl) (. frame declaration) self returns))
    (if (== declared-return no-type)
      (= declared-return (call inherited-getter-type self))
    )
    (if (and (!= (. signature errors length) 0) (not (call (. instances errors-known) instance)))
      (call (. instances state-errors) instance (. signature errors))
      (else-if (and (. frame declaration is-content) (not (call (. instances errors-known) instance)))
        (call (. instances state-errors) instance (. scratch no-types))
      )
    )
    (let default-owner (call interface-default-owner types program module (. frame decl) (. frame self-type)))
    (if (!= default-owner no-type)
      (call (. facts record-witness-table) (. frame self-type) default-owner)
      (= (. frame self-type) default-owner)
    )
    (blank)
    (let position 0u32)
    (let from-signature (!= (. ([] (. instances signatures) instance) args count) (. signature args length)))
    (for (in offset (..< 0 (. frame slots count)))
      (let slot (+ (. frame slots start) offset))
      (let row ([] (. bindings slots) slot))
      (if (and outer (!= (. row scope) (. frame nested-scope)))
        (continue)
      )
      (if (== (. row kind) .slot-argument)
        (if (< position (. signature args length))
          (let declared ([] (. signature args) position))
          (let actual
            (scope (if-expr from-signature declared given-type)
              (lazy given-type (call (. instances argument-type) instance position))
            )
          )
          (let provided (< position (. ([] (. instances signatures) instance) args count)))
          (if (and provided (== (. ([] (. types completions) declared) intrinsic) .or))
            (= actual (call (. instances argument-type) instance position))
            (else-if (and outer provided retyped (call states-type signature position))
              (call decline (. row syntax))
            )
          )
          (lazy retyped (and (not from-signature) (!= declared actual)))
          (call (. frame assign) slot actual)
        )
        (+= position 1)
        (else-if (== (. row kind) .slot-this)
          (call (. frame assign) slot (. frame self-type))
        )
        (else-if (== (. row kind) .slot-super)
          (call (. frame assign) slot (call super-type))
        )
        (else-if (or (== (. row kind) .slot-each) (== (. row kind) .slot-it))
          (if (and (== (. frame declaration kind) .pipeline-decl) (== (. row syntax) (. frame declaration syntax)))
            (call (. frame assign) slot (call (. instances argument-type) instance 0))
          )
        )
      )
    )
    (call (. scratch types rewind) items-mark)
    (call (. scratch names rewind) names-mark)
    (if (or outer probing)
      (return)
    )
    (blank)
    (call type-written-defaults)
    (if is-constructor
      (let base (call (. types base-of) (. frame self-type)))
      (let site (. frame declaration syntax))
      (while (and base (== (. ([] (. types completions) base) intrinsic) .class))
        (call (. conversions record-conversion)
          (block
            (arg site)
            (arg (call up-cast-relation (. frame self-type) base))
            (arg .reason-receiver)
          )
        )
        (= base (call (. types base-of) base))
      )
    )
  )
  (fn-do + close _
    ; Ends typing the instance. A store typed as one that runs nothing is relied on where what was
    ; typed after it read what the flow knew of a property (`member-reads`), and a force after it
    ; of a property the flow knew to hold a value tests the property again should the store run
    ; actions (`note-forced`).
    (for (in position (..< 0 (. unsure-stores length)))
      (if (call (. frame relies-on-store) (as position U32) ([] unsure-reads position))
        (call (. panics rely-on-store) ([] unsure-stores position))
      )
    )
    (for (in position (..< 0 (. unsure-forces length)))
      (for (in store (..< 0 ([] unsure-forced position)))
        (call (. panics note-forced)
          (block
            (arg ([] unsure-stores store))
            (arg ([] unsure-forces position))
            (arg ([] unsure-operands position))
            (arg ([] unsure-declared position))
          )
        )
      )
    )
    (call (. unsure-stores clear))
    (call (. unsure-reads clear))
    (call (. unsure-forces clear))
    (call (. unsure-operands clear))
    (call (. unsure-declared clear))
    (call (. unsure-forced clear))
    (call (. frame close))
  )
  (fn-do + demand-body _
    (param callee InstanceId)
    (if (or (!= (. ([] (. instances rows) callee) state) .instance-unstarted) (call adopt session callee))
      (return)
    )
    (let checker (call checker-for session callee))
    (call (. checker run))
    (call (. checker retire))
  )
  (fn-do + infer-with-expected TypeId
    (param expr SyntaxId)
    (param expected TypeId)
    (param want Want (= (call Want)))
    (let symbol (call (. tree symbol-of) expr))
    (let expects (and (!= expected no-type) (!= expected invalid-type)))
    (if (and expects (!= (call (. tree arms-value) expr) expr))
      (= expected-block expr)
      (= block-expected expected)
    )
    (if (and symbol expects)
      (let owner (call contextual-symbol types relations expected symbol module))
      (if (!= owner invalid-type)
        (call (. facts replace-node-type) instance expr owner)
        (call note-enum-case owner symbol expr)
        (call note-unsettled expr expected)
        (return owner)
      )
    )
    (let fitting (if-expr expects (call expected-function expected) no-type))
    (if (and (!= fitting no-type) (call (. tree is-conditional-value) expr))
      (return (call infer expr (call (. want asking) .want-fitting expected)))
    )
    (if (and expects (or (is ([] (. tree nodes) expr) .node-list-syntax) (!= (call (. tree listed-feeds) expr) 0)))
      (return (call infer expr (call (. want asking) .want-items expected)))
    )
    (return-if (call infer expr want) (if (or (not expects) (not (call (. tree calls-symbol) expr)))))
    (return (call infer expr (call (. want asking) .want-owner expected)))
  )
  (fn-do + infer TypeId
    (param id SyntaxId)
    (param want Want (= (call Want)))
    (if (== id 0)
      (return no-type)
    )
    (return (call settle-typed id (call infer-node id want)))
  )
  (fn-do + decline-used-members _
    ; Declines each member of a class of the module that no pass models, once nothing is left to
    ; type and the program runs code of the class. The reference compiles nothing a class holds
    ; until the class is used, so a class whose code never runs changes nothing a program makes.
    (let undeclared (. ([] (. program modules) module) undeclared))
    (for (in position (..< 0 (. undeclared length)))
      (let owner ([] (. ([] (. program modules) module) undeclared-owners) position))
      (if (and (!= owner 0) (call runs-class owner))
        (call decline ([] undeclared position))
      )
    )
  )
  (fn-do + demand-panic-report _
    ; Types what the report of an unhandled panic calls, and notes the instances for emission:
    ; the converters of the panic and of its source to text, the source's constructor, the
    ; check for a terminating task with the panic it raises, and the constructor of a panic from
    ; a message.
    (let report (. instances report))
    (let panic (. types panic-type))
    (= (. report message) (call (. conversions demand-converter) panic (. types string-type)))
    (let message-mark (. scratch types mark))
    (call (. scratch types push) (. types string-type))
    (= (. report panic) (call (. calls demand-constructor) panic message-mark false true))
    (call (. scratch types rewind) message-mark)
    (let termination (. types termination-type))
    (= (. report termination-error) (call (. calls demand-constructor) termination (. scratch types mark) false true))
    (let error-module (. (call class-ref types termination) module))
    (let decls (. ([] (. program modules) error-module) decls))
    (for (in position (..< 0 (. decls length)))
      (match? ([] decls position)
        (case (call .decl-function fn)
          (if (== (. fn kind) .termination-panic-decl)
            (let check (as position DeclId))
            (= (. report termination) (call (. instances intern) error-module check no-type 0 no-instance))
          )
        )
      )
    )
    (let found (call property-named panic (call (. program store-atom) "source")))
    (if found
      (let property ([] (. types properties) found))
      (let declared (. property type))
      (let source
        (scope (if-expr undeclared (call demand-member property panic (. property name)) declared)
          (lazy undeclared (== declared no-type))
        )
      )
      (= (. report source-slot) (. property slot))
      (if (call (. types is-optional) source)
        (let inner (call (. types optional-inner) source))
        (= (. report source-text) (call (. conversions demand-converter) inner (. types string-type)))
        (let mark (. scratch types mark))
        (for (in field (call (. types properties-of) inner))
          (if (!= (. field storage-kind) .storage-getter)
            (call (. scratch types push) (. field type))
          )
        )
        (= (. report source) (call (. calls demand-constructor) inner mark false true))
        (call (. scratch types rewind) mark)
      )
    )
    (let traced (call property-named panic (call (. program store-atom) "trace")))
    (if traced
      (= (. report trace-slot) (. ([] (. types properties) traced) slot))
    )
    (let linked (call property-named panic (call (. program store-atom) "previous")))
    (if linked
      (= (. report previous-slot) (. ([] (. types properties) linked) slot))
    )
    (= (. instances report) report)
  )
  (fn-do + demand-probe-runtime _
    ; Types what a program whose probes compile calls of the probes module of its own accord, and
    ; notes the instances for emission (see `ProbeRuntime`), with what the report of an error calls,
    ; since an error that leaves a function of the module is reported where it is called.
    (let runtime (. instances probe-runtime))
    (= (. runtime demanded) true)
    (let found (call (. program module-by-name) probes-module-name))
    (if (not found)
      (= (. instances probe-runtime) runtime)
      (return)
    )
    (let probes (as found ModuleId))
    (let size (. types size-type))
    (let text (. types string-type))
