────────────────────
+ do scope-evaluate TypeId?
    - scope MatchScope
    - name Atom
    - env TypeEnv
    - default TypeId?

. found = scope-find(scope, name)
if !found
    = null
. index Index = found
. row = params[index]
if row.type == no-type
    = null
if default && !is-variable-row(types, row.type)
    . relation = compare(row.type, default, false, false, scope)
    if !relation-legal(relation)
        = null
    row.type = relation.unified
. unbound = is-variable-row(types, row.type) && !row.is-explicit
