+ module ModuleId
+ decl DeclId
+ receiver TypeId
+ env TypeEnv

━━━━━━━━━━━━━━━━━━━━
_ do params-resolved Bool
    - types Types
    - env TypeEnv

for position in env.start .. < env.end
    . name = types.env-name(position)
    . bound = types.env-lookup(env, name)
    if bound && is-variable-row(types, bound)
        = false
= true

━━━━━━━━━━━━━━━━━━━━
_ do collect-member-chain
    - types Types
    - id TypeId
    - into [TypeId]

. program = types.program
. interfaces = types.interfaces-of(id)
into += id
. base = types.base-of(id)
if base
    collect-member-chain(types, base, into)
for interface in interfaces
    collect-member-chain(types, interface, into)

━━━━━━━━━━━━━━━━━━━━
+ required-match Specificity
    - op TypeMatchOperator

match op
    | .match-similar
        .convertible
    | .match-exactly
        .exact
    ??
        .similar

━━━━━━━━━━━━━━━━━━━━
_ variable-name Atom?
    - types Types
    - id TypeId

match? types.rows[id]
    | .type-variable(row)
        row.name

━━━━━━━━━━━━━━━━━━━━
_ do bind-row Bool
    - types Types
    - pattern TypeId
    - actual TypeId
    - mark ScratchMark

if pattern == actual
    = true
match? types.rows[pattern]
    | .type-inference
        . count = (types.scratch.types.length - mark) / 2
        for offset in 0 .. < count
            if types.scratch.types[mark + offset * 2] == pattern
                = types.scratch.types[mark + offset * 2 + 1] == actual
        types.scratch.types.push(pattern)
        types.scratch.types.push(actual)
        = true
    | .type-variable
        . count = (types.scratch.types.length - mark) / 2
        for offset in 0 .. < count
            if types.scratch.types[mark + offset * 2] == pattern
                = types.scratch.types[mark + offset * 2 + 1] == actual
        types.scratch.types.push(pattern)
        types.scratch.types.push(actual)
        = true
    | .type-class(row)
        match? types.rows[actual]
            | .type-class(other)
                if row.module != other.module || row.decl != other.decl
                    = false
                = bind-ranges(types, row.args, other.args, mark)
        = false
    | .type-tuple(row)
        match? types.rows[actual]
            | .type-tuple(other)
                if !same-names(types, row.names, other.names)
                    = false
                = bind-ranges(types, row.fields, other.fields, mark)
        = false
    | .type-struct(row)
        match? types.rows[actual]
            | .type-struct(other)
                if !same-names(types, row.names, other.names)
                    = false
                = bind-ranges(types, row.fields, other.fields, mark)
        = false
    | .type-function(row)
        match? types.rows[actual]
            | .type-function(other)
                if row.is-c != other.is-c
                    = false
                if !bind-row(types, row.return-type, other.return-type, mark)
                    = false
                if !bind-ranges(types, row.args, other.args, mark)
                    = false
                = bind-ranges(types, row.errors, other.errors, mark)
        = false
    | .type-union(row)
        match? types.rows[actual]
            | .type-union(other)
                = bind-ranges(types, row.cases, other.cases, mark)
        = false
    | .type-result(row)
        match? types.rows[actual]
            | .type-result(other)
                if !bind-row(types, row.value, other.value, mark)
                    = false
                = bind-ranges(types, row.errors, other.errors, mark)
        = false
= false

━━━━━━━━━━━━━━━━━━━━
_ do paired TypeId?
    - types Types
    - pattern TypeId
    - mark ScratchMark
    - end ScratchMark

` The type `bind-row` bound a pattern to, among the pairs it pushed from `mark` to `end`.
. count = (end - mark) / 2
for offset in 0 .. < count
    if types.scratch.types[mark + offset * 2] == pattern
        = types.scratch.types[mark + offset * 2 + 1]
= null

━━━━━━━━━━━━━━━━━━━━
_ do bind-ranges Bool
    - types Types
    - patterns RowRange'TypeId
    - actuals RowRange'TypeId
    - mark ScratchMark

if patterns.count != actuals.count
    = false
for offset in 0 .. < patterns.count
    . pattern = types.child-type(patterns, offset)
    . actual = types.child-type(actuals, offset)
    if !bind-row(types, pattern, actual, mark)
        = false
= true

━━━━━━━━━━━━━━━━━━━━
_ do same-names Bool
    - types Types
    - left RowRange'TypeId
    - right RowRange'TypeId

if left.count != right.count
    = false
for offset in 0 .. < left.count
    if types.child-name(left, offset) != types.child-name(right, offset)
        = false
= true

━━━━━━━━━━━━━━━━━━━━
+ FromverterHit is Tuple

+ owner TypeId
+ module ModuleId
+ decl DeclId
+ collision RelationReason = .reason-none

━━━━━━━━━━━━━━━━━━━━
_ do lookup-equality UnitRatio
    - types Types
    - from TypeId
    - to TypeId

. mark = types.scratch.types.mark
types.scratch.types.push(from)
. ratio = find-equality(types, from, to, UnitRatio(1.0, 1.0), mark)
types.scratch.types.rewind(mark)
= ratio

━━━━━━━━━━━━━━━━━━━━
_ do find-equality UnitRatio
    - types Types
    - from TypeId
    - to TypeId
    - ratio UnitRatio
    - mark ScratchMark

for fact in types.equalities
    if fact.from == from
        . multiplier = ratio.multiplier * fact.ratio.multiplier
        . divisor = ratio.divisor * fact.ratio.divisor
        . this-ratio = UnitRatio(multiplier, divisor)
        if fact.to == to
            = this-ratio
        if !on-path(types, mark, fact.to)
            . depth = types.scratch.types.mark
            types.scratch.types.push(fact.to)
            . deep = find-equality(types, fact.to, to, this-ratio, mark)
            types.scratch.types.rewind(depth)
            if !deep.is-none
                = deep
= no-ratio()

━━━━━━━━━━━━━━━━━━━━
_ do on-path Bool
    - types Types
    - mark ScratchMark
    - id TypeId

for position in mark .. < types.scratch.types.length
    if types.scratch.types[position] == id
        = true
= false

━━━━━━━━━━━━━━━━━━━━
_ pointer-accepts Bool
    - type IntrinsicKind

|? intrinsic-is-numeric(type)
    true
|? intrinsic-is-class(type)
    true
|? type == .cfunction
    true
|? type == .capture
    true
|? type == .string
    true
|? type == .interface
    true
??
    false

━━━━━━━━━━━━━━━━━━━━
_ side-cast-tiebreak I32
    - types Types
    - from TypeId
    - to TypeId

|? from-type == .cpointer
    if intrinsic-is-numeric(to-type) && to-type != .cpointer then 1i32 else 0i32
|? is-integer-type(from-type) && intrinsic-is-float(to-type)
    -1i32
|? is-integer-type(from-type) && to-type == .cpointer
    1i32
|? intrinsic-is-float(from-type) && is-integer-type(to-type)
    1i32
??
    0i32

.. from-type = types.completions[from].intrinsic
.. to-type = types.completions[to].intrinsic

━━━━━━━━━━━━━━━━━━━━
_ is-integer-type Bool
    - type IntrinsicKind

intrinsic-is-numeric(type) && !intrinsic-is-float(type) && type != .number

━━━━━━━━━━━━━━━━━━━━
_ usable-wrap Bool
    - types Types
    - relation Relation

|? !relation-legal(relation)
    false
|? relation.rank < unwrap-rank
    true
|? relation.rank == converter-rank && (relation.match) >= 1u32
    true
??
    relation.rank == final-rank && types.completions[relation.to].intrinsic != .bool

━━━━━━━━━━━━━━━━━━━━
_ do push-cases Bool
    - types Types
    - union TypeId
    - unnamed Bool = false

` Pushes the type and the place of each case of a union that is not its default, or with
` `unnamed` of each that has no name, and answers whether the union has a default.
. completion = types.completions[union]
. index = 0u32
. has-default = false
for fact in types.cases[completion.cases]
    if fact.is-default
        has-default = true
    else if !unnamed || !fact.name
        types.scratch.types.push(fact.type)
        types.scratch.types.push(index)
    index += 1
= has-default

━━━━━━━━━━━━━━━━━━━━
_ generator-item TypeId
    - types Types
    - from TypeId

|? ref.module == types.generator-decl.module && ref.decl == types.generator-decl.decl
    class-arg(types, from, 0)
??
    no-type

.. ref = class-ref(types, from)

━━━━━━━━━━━━━━━━━━━━
_ list-item TypeId
    - types Types
    - id TypeId

|? ref.module == types.list-decl.module && ref.decl == types.list-decl.decl
    class-arg(types, id, 0)
??
    no-type

.. ref = class-decl-ref(types, id)

━━━━━━━━━━━━━━━━━━━━
+ do in-base-chain Bool
    - types Types
    - from TypeId
    - to TypeId

` Whether a type is another or a class below it, completing the type, which completes the classes
` above it.
if from == to
    = true
if from == no-type || from == invalid-type
    = false
types.complete(from)
. base = types.base-of(from)
while base
    if base == to
        = true
    base = types.base-of(base)
= false

━━━━━━━━━━━━━━━━━━━━
_ do has-interface Bool
    - types Types
    - id TypeId
    - target TypeId

. program = types.program
for interface in types.interfaces-of(id)
    if interface == target || has-interface(types, interface, target)
        = true
. base = types.base-of(id)
if base
    = has-interface(types, base, target)
= false

━━━━━━━━━━━━━━━━━━━━
_ do case-present Bool
    - types Types
    - union TypeId
    - target TypeId

. completion = types.completions[union]
for fact in types.cases[completion.cases]
    if !fact.is-default && fact.type == target
        = true
= false

━━━━━━━━━━━━━━━━━━━━
+ do push-fields
    - types Types
    - id TypeId

match? types.rows[id]
    | .type-tuple(row)
        for offset in 0 .. < row.fields.count
            types.scratch.types.push(types.child-type(row.fields, offset))
        =
    | .type-struct(row)
        for offset in 0 .. < row.fields.count
            types.scratch.types.push(types.child-type(row.fields, offset))
        =
. completion = types.completions[id]
for fact in types.properties[completion.properties]
    if fact.storage-kind != .storage-getter
        types.scratch.types.push(fact.type)

━━━━━━━━━━━━━━━━━━━━
_ is-anonymous-fields Bool
    - types Types
    - id TypeId

match types.rows[id]
    | .type-tuple
        true
    | .type-struct
        true
    ??
        false

━━━━━━━━━━━━━━━━━━━━
_ unify-wider TypeId
    - types Types
    - a TypeId
    - b TypeId

|? is-integer-type(a-type)
    |? intrinsic-is-numeric(b-type)
        |? intrinsic-is-float(b-type)
            base-unify(types, b, a)
        |? types.completions[b].bit-size > types.completions[a].bit-size
            base-unify(types, b, a)
        ??
            a
    ??
        b
|? intrinsic-is-float(a-type)
    |? intrinsic-is-numeric(b-type)
        match a-type
            |= .float32
                match b-type
                    |= .float32
                        base-unify(types, a, b)
                    ??
                        types.f64-type
            ??
                base-unify(types, a, b)
    ??
        b
??
    base-unify(types, a, b)

.. a-type = types.completions[a].intrinsic
.. b-type = types.completions[b].intrinsic

━━━━━━━━━━━━━━━━━━━━
_ base-unify TypeId
    - types Types
    - a TypeId
    - b TypeId

|? in-base-chain(types, a, b)
    b
??
    a

━━━━━━━━━━━━━━━━━━━━
+ is-variable-row Bool
    - types Types
    - id TypeId

match types.rows[id]
    | .type-variable
        true
    ??
        false

━━━━━━━━━━━━━━━━━━━━
+ do pointee-of TypeId
    - types Types
    - id TypeId

` What a pointer class leads to: what its base leads to when the base is a pointer, or else
` its own first argument.
. current = id
while true
    . base = types.base-of(current)
    if !base
        = class-arg(types, current, 0)
    if types.completion-of(base).intrinsic != .cpointer
        = class-arg(types, current, 0)
    current = base

━━━━━━━━━━━━━━━━━━━━
+ do should-delay-compare Bool
    - types Types
    - arg TypeId
    - expected TypeId

if !types.completions[expected].has-variables
    = false
. arg-type = types.completions[arg].intrinsic
match? types.rows[expected]
    | .type-associated
        = true
= arg-type == .function || arg-type == .closure || arg-type == .binding

━━━━━━━━━━━━━━━━━━━━
_ do member-class TypeId
    - types Types
    - id TypeId
    - module ModuleId
    - decl DeclId

. program = types.program
types.complete(id)
. ref = class-decl-ref(types, id)
if ref.module == module && ref.decl == decl
    = id
. base = types.base-of(id)
if base
    . found = member-class(types, base, module, decl)
    if found != no-type
        = found
. interfaces = types.completions[id].interfaces
for offset in 0 .. < interfaces.count
    . found = member-class(types, types.child-type(interfaces, offset), module, decl)
    if found != no-type
        = found
= no-type

━━━━━━━━━━━━━━━━━━━━
_ class-decl-ref DeclRef
    - types Types
    - id TypeId

match types.rows[id]
    | .type-class(row)
        DeclRef(row.module, row.decl)
    ??
        DeclRef(U32.max, U32.max)

━━━━━━━━━━━━━━━━━━━━
+ CallableFitter is Interface

────────────────────
+ fit-callable TypeId?
    - given TypeId
    - expected TypeId
    - scope MatchScope?

━━━━━━━━━━━━━━━━━━━━
+ Relations

+ types Types
+ program Program
+ params Table'TypeParamMatch
+ callables CallableFitter? = null
+ asking Bool
_ memo Table'Relation
_ compare-cache Map'Size'U32'ArenaBacking
_ unify-cache Map'Size'U32'ArenaBacking
_ extension-uses Size = 0
_ callable-uses Size = 0
_ alternatives List'U8'ArenaBacking
_ arena Arena

────────────────────
+ This
    - types Types

.. program = types.program
.. params = Table'TypeParamMatch(arena, 16)
.. memo = Table'Relation(arena, 16)
.. compare-cache = Map'Size'U32(arena)
.. unify-cache = Map'Size'U32(arena)
.. alternatives = List'U8(arena)

────────────────────
+ do release

arena.release()

────────────────────
+ holds-as Bool
    - relation Relation
    - required Specificity
    - of-types Bool = false

|? !relation-legal(relation)
    false
|? required == .convertible
    true
|? required == .exact
    exactly(relation, of-types)
??
    kin(relation)

────────────────────
_ kin Bool
    - relation Relation

match relation.kind
    |= .relation-same
        true
    |= .relation-or-cast
        true
    |= .relation-up-cast
        true
    |= .relation-down-cast
        true
    |= .relation-interface-cast
        true
    |= .relation-interface-down-cast
        true
    |= .relation-side-cast
        side-kin(relation.from, relation.to)
    |= .relation-wrap-cast
        wraps-kin(relation.from, relation.to)
    |= .relation-unwrap-cast
        unwraps-as(relation, false)
    ??
        false

────────────────────
_ exactly Bool
    - relation Relation
    - of-types Bool = false

match relation.kind
    |= .relation-same
        true
    |= .relation-or-cast
        true
    |= .relation-down-cast
        !of-types
    |= .relation-interface-down-cast
        !of-types
    |= .relation-unwrap-cast
        unwraps-as(relation, true)
    ??
        false

────────────────────
_ side-kin Bool
    - from TypeId
    - to TypeId

|? types.completions[to].intrinsic != .optional
    in-base-chain(types, from, to)
|? from == types.null-type
    true
|? inner == no-type
    false
??
    given != no-type && holds-as(compare(given, inner), .similar)

.. inner = optional-item(to)
.. given = if types.completions[from].intrinsic == .optional then optional-item(from) else from

────────────────────
_ do wraps-kin Bool
    - from TypeId
    - to TypeId

for fact in types.cases-of(to)
    if typed-case && holds-as(compare(from, fact.type), .similar)
        = true
    .. typed-case = fact.type != no-type && fact.type != invalid-type
= false

────────────────────
_ do unwraps-as Bool
    - relation Relation
    - exact Bool

. required = if exact then Specificity.exact else Specificity.similar
. from-type = types.completions[relation.from].intrinsic
if from-type == .optional
    . inner = optional-item(relation.from)
    = inner != no-type && holds-as(compare(inner, relation.to), required)
if from-type == .union
    . cases = types.cases-of(relation.from)
    if relation.case-index >= cases.length
        = false
    . held = cases[relation.case-index].type
    = held != no-type && holds-as(compare(held, relation.to), required)
= true

────────────────────
+ do implicit Bool
    - relation Relation
    - texts Bool = false

if !relation-legal(relation) || relation.explicit
    = false
. from = types.completions[relation.from].intrinsic
. to = types.completions[relation.to].intrinsic
. kind = relation.kind
. converts = kind == .relation-converter || kind == .relation-fromverter || common-kind
    .. common-kind = kind == .relation-common-converter
if to == .string && from != .string && (converts || kind == .relation-string-cast || unwraps)
    = texts
.. unwraps = kind == .relation-unwrap-cast
if from == .optional && to == .bool
    . inner = optional-item(relation.from)
    = inner != no-type && types.completions[inner].intrinsic != .bool
if from == .optional && to != .optional && kind != .relation-same
    = widens-optional(relation, texts)
= match kind
    |= .relation-unwrap-cast
        from != .union
    |= .relation-down-cast
        false
    |= .relation-interface-down-cast
        false
    |= .relation-string-cast
        texts || from == .string
    |= .relation-final-cast
        to != .bool && fields-implicit(relation.from, relation.to, texts)
    |= .relation-side-cast
        side-implicit(relation.from, relation.to, texts)
    |= .relation-wrap-cast
        wraps-implicit(relation, texts)
    |= .relation-fromverter
        (has-converter || enumless) && fields-implicit(relation.from, relation.to, texts)
        .. has-converter = relation.converter-module != U32.max
        .. enumless = !types.completions[relation.to].has-enums
    ??
        true

────────────────────
_ widens-optional Bool
    - relation Relation
    - texts Bool = false

|? relation.kind != .relation-unwrap-cast || types.completions[relation.from].intrinsic != .optional
    false
|? types.null-case(relation.to) == U32.max
    false
??
    inner != no-type && implicit(compare(inner, relation.to), texts)

.. inner = optional-item(relation.from)

────────────────────
_ do fields-implicit Bool
    - from TypeId
    - to TypeId
    - texts Bool

` Whether each field of a tuple written with no name converts unasked to the field at its place
` in the tuple it becomes.
if !is-anonymous-fields(types, from) || !intrinsic-is-tuple-like(types.completions[to].intrinsic)
    = true
. from-mark = types.scratch.types.mark
push-fields(types, from)
. to-mark = types.scratch.types.mark
push-fields(types, to)
. count = to-mark - from-mark
. fits = true
if types.scratch.types.length - to-mark == count
    for offset in 0 .. < count
        . field = types.scratch.types[from-mark + offset]
        . target = types.scratch.types[to-mark + offset]
        if fits && field != no-type && target != no-type && !implicit(compare(field, target), texts)
            fits = false
types.scratch.types.rewind(from-mark)
= fits

────────────────────
_ pointer-implicit Bool
    - from TypeId
    - to TypeId
    - from-type IntrinsicKind

` Whether a value becomes a pointer unasked: `null`; a pointer to the same type, a pointer to or
` from `Void`, or a pointer to bytes as a pointer to other bytes; a text as a pointer to its
` bytes; and an object, an interface, a union of objects or a function only as a pointer to
` `Void`. A number, a `Bool` or a `Char` becomes a pointer only when asked, as an address is no
` count.
|? from == types.null-type
    true
|? from-type == .cpointer
    held == pointee || opaque || held == types.void-type || (bytes(held) && bytes(pointee))
|? from-type == .string
    opaque || bytes(pointee)
??
    !intrinsic-is-numeric(from-type) && opaque

.. pointee = pointee-of(types, to)
.. opaque = pointee == types.void-type
.. held = pointee-of(types, from)

────────────────────
_ bytes Bool
    - type TypeId

` Whether a pointer that leads to a type leads to bytes: a `Char8`, an `I8` or a `U8`.
type == types.char8-type || kind == .int8 || kind == .uint8

.. kind = types.completion-of(type).intrinsic

────────────────────
_ do side-implicit Bool
    - from TypeId
    - to TypeId
    - texts Bool

` Whether a side cast is made unasked. A value becomes a pointer only as `pointer-implicit` says,
` and a function a value of another function type only as `calls-implicit` says.
. from-type = types.completions[from].intrinsic
. to-type = types.completions[to].intrinsic
if to-type == .optional
    if from == types.null-type
        = true
    . inner = optional-item(to)
    . given = if from-type == .optional then optional-item(from) else from
    = inner != no-type && given != no-type && implicit(compare(given, inner), texts)
if types.completions[to].has-enums
    = false
if to-type == .bool
    = from-type == .bool
if to-type == .cpointer
    = pointer-implicit(from, to, from-type)
if (to-type == .function || to-type == .cfunction) && from-callable
    = calls-implicit(function-row(types, from), function-row(types, to), texts)
.. from-callable = from-type == .function || from-type == .cfunction
if from-type == .cpointer || !intrinsic-is-numeric(to-type) || !intrinsic-is-numeric(from-type)
    = true
if from-type == .bool || (from-type == .char) != (to-type == .char)
    = false
= holds-every(from, to)

────────────────────
_ holds-every Bool
    - from TypeId
    - to TypeId

` Whether every value of one number type is a value of another: an integer of one as wide or
` wider that shares its sign, or wider and signed, an integer as a float whose significand holds
` each of its values exactly, so an `I32` as an `F64` but an `I64` only when asked, and a float as
` one as wide or wider.
|? intrinsic-is-float(left.intrinsic)
    intrinsic-is-float(right.intrinsic) && right.bit-size >= left.bit-size
|? intrinsic-is-float(right.intrinsic)
    significand >= (if left.is-signed then left.bit-size - 1 else left.bit-size)
|? left.is-signed == right.is-signed
    right.bit-size >= left.bit-size
??
    right.is-signed && right.bit-size > left.bit-size

.. left = types.completions[from]
.. right = types.completions[to]
.. significand = significand-bits(right.bit-size)

────────────────────
_ significand-bits U32
    - bit-size U32

` How many bits of an integer a float of a width holds exactly: its significand's.
match bit-size
    |= 16
        11
    |= 32
        24
    |= 64
        53
    ??
        113

────────────────────
_ wraps-implicit Bool
    - relation Relation
    - texts Bool

|? relation.case-index >= cases.length
    true
??
    held == no-type || held == relation.from || implicit(compare(relation.from, held), texts)

.. cases = types.cases-of(relation.to)
.. held = cases[relation.case-index].type

────────────────────
+ implicitly Relation
    - relation Relation
    - texts Bool = false

if implicit(relation, texts) then relation else illegal

.. illegal = illegal-relation(relation.from, relation.to, .reason-illegal-cast)

────────────────────
+ do joined-places TypeId
    - one TypeId
    - other TypeId

` What two types of values written as numbers with no suffix join to place by place: what they
` unify to, the float where one is an integer and the other a float, or the tuple of what their
` places join to. None where they do not join.
. relation = unify(one, other)
=? relation.unified if relation-legal(relation)
. left = types.completions[one].intrinsic
. right = types.completions[other].intrinsic
=? other if intrinsic-is-float(right) && is-integer-type(left)
=? one if intrinsic-is-float(left) && is-integer-type(right)
. ones = RowRange'TypeId()
. names = RowRange'Atom()
. others = RowRange'TypeId()
match? types.rows[one]
    | .type-tuple(row)
        ones = row.fields
        names = row.names
match? types.rows[other]
    | .type-tuple(row)
        others = row.fields
=? no-type if ones.count == 0 || ones.count != others.count
. mark = types.scratch.types.mark
. names-mark = types.scratch.names.mark
for offset in 0 .. < ones.count
    . place = joined-places(types.child-type(ones, offset), types.child-type(others, offset))
    if place == no-type
        types.scratch.types.rewind(mark)
        types.scratch.names.rewind(names-mark)
        = no-type
    types.scratch.types.push(place)
    types.scratch.names.push(types.child-name(names, offset))
. joined = types.intern-tuple(mark, names-mark)
types.scratch.types.rewind(mark)
types.scratch.names.rewind(names-mark)
= joined

────────────────────
+ do compare-explicit Relation
    - from TypeId
    - to TypeId
    - caller ModuleId? = null

` The relation `as` casts by: the one `compare` gives, or between two named tuples of one class
` whose fields cast only so, as a pointer at another item type does, the cast of each field. A
` closure is fitted to a function type it is cast to as `asking` says.
. asked = asking
asking = true
. relation = compare(from, to, false, false, null, caller)
asking = asked
if relation-legal(relation)
    = relation
if reads-text-as-number(from, to)
    = declared-relation(from, to, caller)
. to-type = types.completions[to].intrinsic
if !intrinsic-is-tuple-like(to-type) || is-array-view(to)
    = relation
if is-anonymous-fields(types, from) || anonymous-to || !same-class(types, from, to)
    = relation
.. anonymous-to = is-anonymous-fields(types, to)
= make-relation(.relation-final-cast, from, to, to)

────────────────────
+ compare-pattern Relation
    - from TypeId
    - to TypeId
    - caller ModuleId? = null

|? relation-legal(relation) || !class-may-be(from, to)
    relation
??
    make-relation(.relation-interface-down-cast, from, to, to)

.. relation = compare(from, to, false, false, null, caller)

────────────────────
+ do compare Relation
    - from TypeId
    - to TypeId
    - for-unify Bool = false
    - raw Bool = false
    - scope MatchScope? = null
    - caller ModuleId? = null

. source = from
if is-variable-row(types, from)
    source = to
. target = to
. open = types.completions[target].has-variables || holds-alternatives(target)
if !raw && open && source != target
    . completed = complete-target(target, source, scope)
    if completed
        target = completed
if source == target
    = make-relation(.relation-same, source, target, target)
. generic = types.completions[source].has-variables || types.completions[target].has-variables
. cacheable = !scope || !generic
. key = cache-key(source, target, caller)
. cached U32? = null
if cacheable
    if for-unify
        cached = unify-cache[key]
    else
        cached = compare-cache[key]
if cached
    = memo[cached]
. uses-before = extension-uses
. fits-before = callable-uses
. relation = relate(source, target, for-unify, raw, scope, caller)
if cacheable && (!caller || extension-uses == uses-before) && callable-uses == fits-before
    . position U32 = memo.length as U32
    memo.append(relation)
    if for-unify
        unify-cache[key] = position
    else
        compare-cache[key] = position
= relation

────────────────────
+ do holds-alternatives Bool
    - id TypeId

` Whether a class names a type of alternatives among its parameters, or a tuple among its
` fields, at any depth: a value of it holds the alternative its source chooses, never the
` alternatives themselves.
while alternatives.length <= id
    alternatives += 0
. known = alternatives[id]
if known != 0
    = known == 2
. holds = false
. inner = RowRange'TypeId()
match? types.rows[id]
    | .type-class(row)
        inner = row.args
    | .type-tuple(row)
        inner = row.fields
for offset in 0 .. < inner.count
    . arg = types.child-type(inner, offset)
    if arg != id && (types.intrinsic-of(arg) == .or || holds-alternatives(arg))
        holds = true
alternatives[id] = if holds then 2u8 else 1u8
= holds

────────────────────
+ do complete-from TypeId?
    - target TypeId
    - source TypeId

` A type with parameters left open completed from a value of another type, as a comparison
` completes it, or nothing where the value does not complete it.
= complete-target(target, source, null)

────────────────────
_ do complete-target TypeId?
    - target TypeId
    - source TypeId
    - scope MatchScope?

if scope
    = complete-against(target, source, scope)
. opened = scope-open()
. completed = complete-against(target, source, opened)
scope-release(opened)
= completed

────────────────────
+ do unify Relation
    - from TypeId
    - to TypeId
    - caller ModuleId? = null

. ltr = implicitly(compare(from, to, true, false, null, caller))
. rtl = implicitly(compare(to, from, true, false, null, caller))
if !relation-legal(ltr) && !relation-legal(rtl)
    . optioned = unify-optioned(from, to, caller)
    if optioned
        = optioned
    . fielded = unify-tuples(from, to, caller)
    if fielded
        = fielded
if ltr.rank == rtl.rank
    . wider = unify-wider(types, from, to)
    = if wider == from then rtl else ltr
. left = has-type(from, to)
. right = has-type(to, from)
if left && !right
    = rtl
if right && !left
    = ltr
= most-specific(rtl, ltr)

────────────────────
_ do unify-tuples Relation?
    - from TypeId
    - to TypeId
    - caller ModuleId?

` Two tuples written with no name, of as many fields, that do not unify whole unify as the tuple
` of what the fields at each place unify to, when both convert to it unasked.
. left = RowRange'TypeId()
. left-names = RowRange'Atom()
. right = RowRange'TypeId()
match? types.rows[from]
    | .type-tuple(row)
        left = row.fields
        left-names = row.names
match? types.rows[to]
    | .type-tuple(row)
        right = row.fields
=? null if left.count == 0 || left.count != right.count
. unified [TypeId]
for offset in 0 .. < left.count
    . field = unify(types.child-type(left, offset), types.child-type(right, offset), caller)
    =? null if !relation-legal(field) || field.unified == no-type
    unified += field.unified
. mark = types.scratch.types.mark
. names-mark = types.scratch.names.mark
for offset in 0 .. < unified.length
    types.scratch.types.push(unified[offset])
    types.scratch.names.push(types.child-name(left-names, offset as U32))
. joined = types.intern-tuple(mark, names-mark)
. relation = implicitly(compare(from, joined, true, false, null, caller))
. other = implicitly(compare(to, joined, true, false, null, caller))
= relation if relation-legal(relation) && relation-legal(other)

────────────────────
_ do unify-optioned Relation?
    - from TypeId
    - to TypeId
    - caller ModuleId?

` Two types that do not unify, one of them optional or null, unify as the optional of what the
` values they hold unify to, when the first converts to that.
. from-value = if types.is-optional(from) then types.optional-inner(from) else from
. to-value = if types.is-optional(to) then types.optional-inner(to) else to
if from == types.null-type || to == types.null-type
    . present = if from == types.null-type then to-value else from-value
    . nullable = compare(from, types.optional-of(present), true, false, null, caller)
    = nullable if relation-legal(nullable)
if from-value == from && to-value == to
    = null
. held = unify(from-value, to-value, caller)
if !relation-legal(held) || held.unified == no-type
    = null
. relation = compare(from, types.optional-of(held.unified), true, false, null, caller)
= relation if relation-legal(relation)

────────────────────
+ do unify-fallback Relation
    - left TypeId
    - value TypeId
    - caller ModuleId? = null

. forward = implicitly(compare(value, left, true, false, null, caller))
if has-type(value, left) && !has-type(left, value)
    . widening = implicitly(compare(left, value, false, false, null, caller))
    = if relation-legal(widening) then widening else forward
if relation-legal(forward) && !prefers-reverse(forward)
    = forward
. reverse = implicitly(compare(left, value, false, false, null, caller))
if relation-legal(reverse) && (!relation-legal(forward) || reverse.rank < forward.rank)
    = reverse
= forward

────────────────────
_ prefers-reverse Bool
    - relation Relation

relation.rank >= relation-rank(.relation-common-equality) || narrows || truncates-float(relation)

.. narrows = relation.kind == .relation-down-cast || relation.kind == .relation-interface-down-cast

────────────────────
_ is-narrowing Bool
    - relation Relation

|? relation.kind == .relation-unwrap-cast
    !widens-optional(relation)
??
    relation.kind == .relation-down-cast || relation.kind == .relation-interface-down-cast

────────────────────
+ do unify-present Relation
    - left TypeId
    - value TypeId
    - caller ModuleId? = null

. forward = implicitly(compare(left, value, false, false, null, caller))
if truncates-float(forward)
    . reverse = implicitly(compare(value, left, false, false, null, caller))
    if relation-legal(reverse)
        = reverse
= forward

────────────────────
_ do relate-facets Relation?
    - from TypeId
    - to TypeId

` How a value meets a facet's type: a class at or below the facet's owner, or a facet within it,
` narrows to it unasked, and a facet widens to its owner or a class above it only when asked, or
` is cast to a class below its owner as the owner is, with a test.
. facets = types.program.facets
. target = types.facet-of-type(to)
. source = types.facet-of-type(from)
if target
    if source
        =? null if !facets.is-within(source, target)
        = make-relation(.relation-up-cast, from, to, to)
    =? null if !intrinsic-is-class(types.completions[from].intrinsic)
    =? null if !in-base-chain(types, from, types.facet-owner(target))
    = make-relation(.relation-up-cast, from, to, to)
=? null if !source || !intrinsic-is-class(types.completions[to].intrinsic)
. owner = types.facet-owner(source)
if to != owner && in-base-chain(types, to, owner)
    = make-relation(.relation-down-cast, from, to, to)
=? null if !in-base-chain(types, owner, to)
. widened = make-relation(.relation-up-cast, from, to, to)
widened.explicit = true
= widened

────────────────────
_ truncates-float Bool
    - relation Relation

intrinsic-is-float(from-type) && is-integer-type(to-type)

.. from-type = types.completions[relation.from].intrinsic
.. to-type = types.completions[relation.to].intrinsic

────────────────────
+ do join TypeId
    - mark ScratchMark

` The type several values become together, as the reference unifies them: each is unified
` with the type the ones before it converted to, and the last of these says what all become.
` Values that do not unify become nothing together, and the type is invalid.
. count = types.scratch.types.length - mark
if count == 0
    = no-type
. held = types.scratch.types[mark]
. joined = held
for offset in 1 .. < count
    . next = types.scratch.types[mark + offset]
    . relation = unify(held, next)
    if !relation-legal(relation)
        = invalid-type
    held = relation.to
    joined = relation.unified
= joined

────────────────────
+ do join-arms TypeId
    - mark ScratchMark

` The type the values of a match's arms become together: each unified with those before it,
` or where it does not unify, the union of it and the cases of those before it.
. count = types.scratch.types.length - mark
if count == 0
    = no-type
. joined = types.scratch.types[mark]
for offset in 1 .. < count
    . next = types.scratch.types[mark + offset]
    . relation = unify(next, joined)
    if relation-legal(relation)
        joined = relation.unified
    else
        . pair = types.scratch.types.mark
        match types.rows[joined]
            | .type-union(row)
                for position in 0 .. < row.cases.count
                    types.scratch.types.push(types.child-type(row.cases, position))
            ??
                types.scratch.types.push(joined)
        types.scratch.types.push(next)
        joined = types.intern-union(pair)
= joined

────────────────────
_ do relate Relation
    - from TypeId
    - to TypeId
    - for-unify Bool
    - raw Bool
    - scope MatchScope?
    - caller ModuleId?

types.complete(from)
types.complete(to)
if is-variable-row(types, to)
    = illegal-relation(from, to, .reason-illegal-cast)

. ratio = lookup-equality(types, from, to)
if !ratio.is-none
    . equal = make-relation(.relation-equal, from, to, to)
    equal.ratio = ratio
    = equal

if can-side-cast(to, from) && !(for-unify && tests-truth(to, from))
    . side = make-relation(.relation-side-cast, from, to, to)
    side.rank = side.rank + side-cast-tiebreak(types, from, to)
    = side

if can-unwrap-cast(from, to)
    . target = to
    if types.completions[from].intrinsic == .optional && types.completions[to].intrinsic == .or
        . alternative = best-alternative(optional-item(from), to, scope)
        if alternative != no-type
            target = alternative
    . unwrap = make-relation(.relation-unwrap-cast, from, target, target)
    if types.completions[from].intrinsic == .union
        unwrap.case-index = wrap-case(from, to)
    if types.completions[from].intrinsic == .optional
        . inner = optional-item(from)
        if inner != target
            . inner-relation = compare(inner, target)
            if inner-relation.converter-module != U32.max
                unwrap.converter-module = inner-relation.converter-module
                unwrap.converter-decl = inner-relation.converter-decl
                unwrap.via = inner
            else if types.completions[inner].intrinsic == .union
                . held = wrap-case(inner, target)
                unwrap.case-index = if held != no-case then held else down-case(inner, target)
    = unwrap

if types.program.facets.count != 0
    . facet-relation = relate-facets(from, to)
    if facet-relation
        = facet-relation

if in-base-chain(types, from, to)
    = make-relation(.relation-up-cast, from, to, to)

if intrinsic-is-class(types.completions[from].intrinsic) && in-base-chain(types, to, from)
    = make-relation(.relation-down-cast, from, to, to)

if !for-unify && types.completions[from].intrinsic == .union
    . held = down-case(from, to)
    if held != no-case
        . down = make-relation(.relation-down-cast, from, to, to)
        down.case-index = held
        = down

if types.completions[from].intrinsic == .interface && has-interface(types, to, from)
    . kind = types.completions[to].intrinsic
    if intrinsic-is-class(kind) || intrinsic-is-tuple-like(kind)
        = make-relation(.relation-interface-down-cast, from, to, to)

if types.completions[to].intrinsic == .interface && has-interface(types, from, to)
    = make-relation(.relation-interface-cast, from, to, to)

if types.completions[to].intrinsic == .or
    . plain = unraised(from)
    . alternative = best-alternative(plain, to, scope)
    if alternative != no-type && plain != from
        = make-relation(.relation-same, from, from, from)
    if alternative != no-type
        . inner = compare(from, alternative, false, false, scope)
        inner.via = alternative
        = inner

if types.completions[to].intrinsic == .union
    . wrapped = wrap-case(to, from, true)
    if wrapped != no-case
        . wrap = make-relation(.relation-wrap-cast, from, to, to)
        wrap.case-index = wrapped
        = wrap

if !reads-text-as-number(from, to)
    . declared = declared-relation(from, to, caller)
    if relation-legal(declared) || declared.reason != .reason-illegal-cast
        = declared

if for-unify
    . common = common-relation(from, to, caller)
    if relation-legal(common)
        = common

if !for-unify && subclass-may-be(from, to)
    = make-relation(.relation-interface-down-cast, from, to, to)

if can-final-cast(to, from) && !(for-unify && tests-truth(to, from))
    = make-relation(.relation-final-cast, from, to, to)

if types.completions[to].intrinsic == .string && types.completions[from].intrinsic != .atom
    = make-relation(.relation-string-cast, from, to, to)

if types.completions[to].has-variables
    = illegal-relation(from, to, .reason-unresolved)
= illegal-relation(from, to, .reason-illegal-cast)

────────────────────
+ do reads-text-as-number Bool
    - from TypeId
    - to TypeId

types.complete(from)
types.complete(to)
= from-text && intrinsic-is-numeric(types.completions[to].intrinsic)
    .. from-text = types.completions[from].intrinsic == .string

────────────────────
_ do declared-relation Relation
    - from TypeId
    - to TypeId
    - caller ModuleId?

. fromverter = fromverter-owner(to, from, caller)
=? illegal-relation(from, to, fromverter.collision) if fromverter.collision != .reason-none
=? converter-relation(from, to, caller) if fromverter.owner == no-type
. conversion = make-relation(.relation-fromverter, from, to, to)
conversion.via = fromverter.owner
conversion.converter-module = fromverter.module
conversion.converter-decl = fromverter.decl
= conversion

────────────────────
_ subclass-may-be Bool
    - from TypeId
    - to TypeId

` Whether an object of a class may be of an interface the class does not declare, where a
` class declared below it does: the cast tests the object's class as it runs.
class-may-be(from, to) && types.declares-subclass-interface(from, to)

────────────────────
_ class-may-be Bool
    - from TypeId
    - to TypeId

|? !intrinsic-is-class(types.completions[from].intrinsic) || not-interface
    false
??
    !types.completions[from].has-variables && !types.completions[to].has-variables

.. not-interface = types.completions[to].intrinsic != .interface

────────────────────
+ unnamed-case-holds Bool
    - union TypeId
    - type TypeId

` Whether a case of a union that has no name holds a value of a type.
wrap-case(union, type, false, true) != no-case

────────────────────
+ do declared-converter TypeId
    - from TypeId
    - decl DeclRef

` What a converter a type declares itself makes, where that is of a declaration, as TypeScript
` reads a type's own converters to find a stream's. None where none is.
. converters = types.children[types.completion-of(from).converters]
for offset in 0 .. < converters.length / converter-words
    . target = converters[offset * converter-words]
    if same-decl(class-ref(types, target), decl)
        = target
= no-type

────────────────────
+ do converter-relation Relation
    - from TypeId
    - to TypeId
    - caller ModuleId?

` How a type converts to another by a converter it declares, whatever else relates the two.
` Illegal when it declares none, or when two that extensions declare collide.
. chosen = converter-match(from, to, caller)
if chosen.collision != .reason-none
    = illegal-relation(from, to, chosen.collision)
if chosen.specificity == no-match
    = illegal-relation(from, to, .reason-illegal-cast)
. converter = make-relation(.relation-converter, from, to, to)
converter.match = chosen.specificity as Specificity
converter.converter-module = chosen.module
converter.converter-decl = chosen.decl
converter.explicit = !chosen.implicit
= converter

────────────────────
_ do common-relation Relation
    - from TypeId
    - to TypeId
    - caller ModuleId?

. base = types.base-of(from)
if base
    . shared = common-base(types, base, to)
    if shared != no-type
        . up = make-relation(.relation-common-up-cast, from, to, shared)
        up.via = shared
        = up

. interface = common-interface(types, from, from, to)
if interface != no-type
    . shared = make-relation(.relation-common-interface, from, to, interface)
    shared.via = interface
    = shared

. mark = types.scratch.types.mark
push-converters(from, caller)
. matches = 0
. chosen = no-type
. chosen-ratio = no-ratio()
. candidates = (types.scratch.types.length - mark) / converter-words
for offset in 0 .. < candidates
    . target = types.scratch.types[mark + offset * converter-words]
    if !types.completions[target].has-variables
        . ratio = lookup-equality(types, target, to)
        if !ratio.is-none
            matches += 1
            chosen = target
            chosen-ratio = ratio
types.scratch.types.rewind(mark)
if matches == 1
    . equality = make-relation(.relation-common-equality, from, to, to)
    equality.via = chosen
    equality.ratio = chosen-ratio
    = equality

. common = common-converter(from, to, caller)
if common != no-type
    . converter = make-relation(.relation-common-converter, from, to, common)
    converter.via = common
    = converter
= illegal-relation(from, to, .reason-illegal-cast)

────────────────────
_ do common-converter TypeId
    - from TypeId
    - to TypeId
    - caller ModuleId?

. from-mark = types.scratch.types.mark
push-converters(from, caller)
. to-mark = types.scratch.types.mark
push-converters(to, caller)
. from-count = (to-mark - from-mark) / converter-words
. to-count = (types.scratch.types.length - to-mark) / converter-words
. common = 0
. chosen = no-type
for offset in 0 .. < from-count
    . target = types.scratch.types[from-mark + offset * converter-words]
    if !types.completions[target].has-variables
        . matching = false
        for other in 0 .. < to-count
            . candidate = types.scratch.types[to-mark + other * converter-words]
            if candidate == target && !types.completions[candidate].has-variables
                common += 1
                chosen = target
                matching = true
        if !matching && can-unify-with-target(to, target)
            common += 1
            chosen = target
for offset in 0 .. < to-count
    . target = types.scratch.types[to-mark + offset * converter-words]
    if !types.completions[target].has-variables
        . matching = false
        for other in 0 .. < from-count
            . candidate = types.scratch.types[from-mark + other * converter-words]
            if candidate == target && !types.completions[candidate].has-variables
                matching = true
        if !matching && can-unify-with-target(from, target)
            common += 1
            chosen = target
types.scratch.types.rewind(from-mark)
if common == 1
