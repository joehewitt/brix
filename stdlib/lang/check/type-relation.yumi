        types.env-release(matched.env)
= hit

────────────────────
_ tests-truth Bool
    - to TypeId
    - from TypeId

types.completions[to].intrinsic == .bool && from-type != .bool && !intrinsic-is-numeric(from-type)

.. from-type = types.completions[from].intrinsic

────────────────────
_ do can-side-cast Bool
    - to TypeId
    - from TypeId

. to-completion = types.completions[to]
. from-completion = types.completions[from]
. to-type = to-completion.intrinsic
. from-type = from-completion.intrinsic
if to-type == .bool
    = from-completion.is-builtin
if to-type == .cpointer
    = pointer-accepts(from-type) || (from-type == .union && holds-objects(from))
if to-type == .string
    = from-type == .cpointer && pointee-of(types, from) == types.char8-type
if to-type == .optional
    = optional-accepts(to, from)
if to-type == .closure || to-type == .capture
    = from-type == .cpointer
if to-type == .function
    if from-type == .binding
        = true
    if from-type == .closure
        = fit-closure(from, to, null) != null
    if from-type == .function || from-type == .cfunction
        = legal-function-call(function-row(types, from), function-row(types, to))
    = false
if to-type == .cfunction
    if from == types.null-type || from-type == .binding
        = true
    if from-type == .cfunction
        = legal-function-call(function-row(types, from), function-row(types, to))
    = false
if intrinsic-is-numeric(to-type)
    . unitless = !to-completion.has-equalities || !from-completion.has-equalities
    = intrinsic-is-numeric(from-type) && unitless
if to-type == .table-span
    = zips-columns(to, from)
if to-type == .tuple && from-type == .tuple
    = view-widens(to, from)
= false

────────────────────
_ do fit-closure TypeId?
    - from TypeId
    - to TypeId
    - scope MatchScope?

` A closure is a value of a function type when its body types with that type's arguments and
` returns what the type returns. Only the caller that is ranking or converting can type the
` body, so the answer holds for that caller alone and is never remembered.
callable-uses += 1
if !callables
    = null
= callables.fit-callable(from, to, scope)

────────────────────
_ do zips-columns Bool
    - to TypeId
    - from TypeId

` A span of struct rows is cast from the tuple of that struct's mutable fields, in order.
. row = class-arg(types, to, 0)
if row == no-type || types.completions[row].intrinsic == .union
    = false
. zipped = RowRange'TypeId()
match? types.rows[from]
    | .type-tuple(tuple)
        zipped = tuple.fields
if zipped.count == 0
    = false
. mark = types.scratch.types.mark
push-fields(types, row)
. matches = types.scratch.types.length - mark == zipped.count
if matches
    for offset in 0 .. < zipped.count
        . column = types.child-type(zipped, offset)
        types.complete(column)
        . is-column = types.completions[column].intrinsic == .table-column
        if !is-column || class-arg(types, column, 0) != types.scratch.types[mark + offset]
            matches = false
types.scratch.types.rewind(mark)
= matches

────────────────────
_ view-widens Bool
    - to TypeId
    - from TypeId

|? !ranged && !same-decl(target, source)
    false
|? !rows && !fields && !same-decl(target, types.array-row-decl)
    false
|? class-arg(types, to, 0) != class-arg(types, from, 0)
    false
??
    readable && class-arg(types, from, 1) == types.array-write-access

.. target = class-decl-ref(types, to)
.. source = class-decl-ref(types, from)
.. row-range = types.array-row-range-decl
.. ranged = same-decl(target, row-range) && same-decl(source, types.array-rows-decl)
.. rows = same-decl(target, row-range) || same-decl(target, types.array-rows-decl)
.. fields = same-decl(target, types.array-fields-decl) || same-decl(target, types.array-field-decl)
.. readable = class-arg(types, to, 1) == types.array-read-access

────────────────────
_ do optional-accepts Bool
    - to TypeId
    - from TypeId

if from == types.null-type
    = true
. inner = optional-item(to)
if inner == no-type
    = false
if types.completions[from].intrinsic == .optional
    . given = optional-item(from)
    = given != no-type && legal(given, inner)
if types.completions[from].intrinsic == .union
    for fact in types.cases-of(from)
        if fact.type == to
            = false
= legal(from, inner)

────────────────────
_ optional-item TypeId
    - id TypeId

` The type an optional holds, through a class that only derives from Optional.
if found != no-type then class-arg(types, found, 0) else no-type

.. found = types.ancestor-of(id, types.type-decl(.optional))

────────────────────
_ legal Bool
    - from TypeId
    - to TypeId

relation-legal(compare(from, to))

────────────────────
_ do legal-function-call Bool
    - from TypeId
    - to TypeId

if from == no-type || to == no-type
    = false
. from-args = RowRange'TypeId()
. from-errors = RowRange'TypeId()
. from-return = no-type
. to-args = RowRange'TypeId()
. to-errors = RowRange'TypeId()
. to-return = no-type
match? types.rows[from]
    | .type-function(row)
        from-args = row.args
        from-errors = row.errors
        from-return = row.return-type
match? types.rows[to]
    | .type-function(row)
        to-args = row.args
        to-errors = row.errors
        to-return = row.return-type
if from-args.count != to-args.count
    = false
for offset in 0 .. < to-args.count
    . arg-from = types.child-type(to-args, offset)
    . arg-to = types.child-type(from-args, offset)
    if !legal(arg-from, arg-to)
        = false
if !legal(from-return, to-return)
    = false
= accepts-errors(from-errors, to-errors)

────────────────────
_ do calls-implicit Bool
    - from TypeId
    - to TypeId
    - texts Bool

` Whether a function becomes a value of another function type unasked: as a call of it converts,
` each argument the type gives converts unasked to the one the function takes, and what the
` function gives to what the type returns.
if from == no-type || to == no-type
    = false
. from-args = RowRange'TypeId()
. from-return = no-type
. to-args = RowRange'TypeId()
. to-return = no-type
match? types.rows[from]
    | .type-function(row)
        from-args = row.args
        from-return = row.return-type
match? types.rows[to]
    | .type-function(row)
        to-args = row.args
        to-return = row.return-type
if from-args.count != to-args.count
    = false
for offset in 0 .. < to-args.count
    if !implicit(compare(to-arg, types.child-type(from-args, offset)), texts)
        = false
    .. to-arg = types.child-type(to-args, offset)
= same-return || implicit(compare(from-return, to-return), texts)
    .. same-return = to-return == types.void-type || from-return == to-return

────────────────────
_ do accepts-errors Bool
    - raised RowRange'TypeId
    - accepted RowRange'TypeId

for offset in 0 .. < raised.count
    . error = types.child-type(raised, offset)
    . handled = false
    for candidate in 0 .. < accepted.count
        if legal(error, types.child-type(accepted, candidate))
            handled = true
    if !handled
        = false
= true

────────────────────
_ do can-unwrap-cast Bool
    - from TypeId
    - to TypeId

. from-type = types.completions[from].intrinsic
if from-type == .optional
    . inner = optional-item(from)
    if to == inner
        = true
    if to == types.bool-type || inner == no-type
        = false
    . relation = compare(inner, to)
    = relation-legal(relation) && relation.rank < converter-rank
if from-type == .union
    = wrap-case(from, to) != no-case
if from-type == .table-row || from-type == .immutable-table-row
    . row = class-arg(types, from, 0)
    = to == row || shares-base(row, to)
if from-type == .tuple && same-decl(class-decl-ref(types, from), types.array-row-decl)
    = to == class-arg(types, from, 0)
= false

────────────────────
_ do down-case U32
    - union TypeId
    - to TypeId

if !intrinsic-is-class(types.completions[to].intrinsic)
    = no-case
. above = false
for fact in types.cases-of(union)
    if fact.is-default || fact.type == no-type || fact.type == invalid-type
        continue
    . kind = types.completions[fact.type].intrinsic
    if kind == .interface && has-interface(types, to, fact.type)
        = no-case
    if intrinsic-is-class(kind) && fact.type != to && in-base-chain(types, to, fact.type)
        above = true
= if above then wrap-case(union, to, true) else no-case

────────────────────
_ do holds-objects Bool
    - union TypeId

. cases = types.cases-of(union)
for fact in cases
    if fact.is-default || fact.type == no-type || fact.type == invalid-type
        = false
    types.complete(fact.type)
    if !intrinsic-is-class(types.completions[fact.type].intrinsic)
        = false
= cases.length != 0

────────────────────
_ do shares-base Bool
    - union TypeId
    - base TypeId

` Whether every case of a union derives from a base, which a table row of the union then
` reads from the fields the cases share.
if union == no-type
    = false
types.complete(union)
if types.completions[union].intrinsic != .union
    = false
. ref = class-decl-ref(types, base)
if ref.module == U32.max
    = false
. cases = types.cases-of(union)
for fact in cases
    if fact.is-default || fact.type == no-type || fact.type == invalid-type
        = false
    if fact.type == base || types.ancestor-of(fact.type, ref) != base
        = false
= cases.length != 0

────────────────────
_ do wrap-case U32
    - union TypeId
    - from TypeId
    - converts Bool = false
    - unnamed Bool = false

` The case of a union a value of a type is held in, or none: one it converts to unasked before
` one it does not, and among those the nearest. With `converts` the value may also be cast up to
` the case's class or to its interface, as when it is wrapped, and with `unnamed` only a case with
` no name holds it.
. mark = types.scratch.types.mark
push-cases(types, union, unnamed)
. count = (types.scratch.types.length - mark) / 2
. generator = generator-item(types, from)
if generator != no-type
    for offset in 0 .. < count
        . case-type = types.scratch.types[mark + offset * 2]
        . item = list-item(types, case-type)
        if item != no-type && legal(generator, item)
            . chosen U32 = types.scratch.types[mark + offset * 2 + 1]
            types.scratch.types.rewind(mark)
            = chosen
. best = no-case
. best-rank = 0i32
. best-match = 0u32
. best-unasked = false
for offset in 0 .. < count
    . case-type = types.scratch.types[mark + offset * 2]
    . index U32 = types.scratch.types[mark + offset * 2 + 1]
    . relation = compare(from, case-type, false, true)
    . cast = relation.kind == .relation-up-cast || relation.kind == .relation-interface-cast
    if usable-wrap(types, relation) || (converts && relation-legal(relation) && cast)
        . rank = case-selection-rank(types, relation)
        . match U32 = relation.match
        . unasked = implicit(relation)
        . nearer = rank < best-rank || (rank == best-rank && match > best-match)
        if best == no-case || (unasked && !best-unasked) || (unasked == best-unasked && nearer)
            best = index
            best-rank = rank
            best-match = match
            best-unasked = unasked
types.scratch.types.rewind(mark)
= best

────────────────────
_ best-alternative TypeId
    - from TypeId
    - to TypeId
    - scope MatchScope?

best[0]

.. alternatives = types.completions[to].alternatives
.. best = reduce((no-type, 0i32), 0 .. < alternatives.count) • using :: current, offset =>
    |? relation-legal(relation) && (current[0] == no-type || relation.rank < current[1])
        (alternative, relation.rank)
    ??
        current
    .. alternative = types.child-type(alternatives, offset)
    .. relation = compare(from, alternative, false, false, scope)

────────────────────
_ can-final-cast Bool
    - to TypeId
    - from TypeId

|? to-type == .bool
    true
|? to-type == .table-row
    row != no-type && types.completions[row].intrinsic == .union && case-present(types, row, from)
|? to-type == .union
    from-type == .union && union-rewraps(to, from)
|? intrinsic-is-tuple-like(to-type)
    !is-array-view(to) && tuple-final-cast(to, from)
??
    false

.. to-type = types.completions[to].intrinsic
.. from-type = types.completions[from].intrinsic
.. row = class-arg(types, to, 0)

────────────────────
_ is-array-view Bool
    - type TypeId

` A view of an array's rows or fields carries the access it was made with: only a view that
` writes becomes one that reads, never by a cast of last resort.
plural || same-decl(target, types.array-field-decl) || same-decl(target, types.array-row-decl)

.. target = class-decl-ref(types, type)
.. plural = rows || same-decl(target, types.array-fields-decl)
.. rows = same-decl(target, types.array-rows-decl) || same-decl(target, types.array-row-range-decl)

────────────────────
_ do union-rewraps Bool
    - to TypeId
    - from TypeId

. mark = types.scratch.types.mark
. has-default = push-cases(types, from)
. count = (types.scratch.types.length - mark) / 2
. rewraps = !has-default && count != 0
if rewraps
    for offset in 0 .. < count
        . case-type = types.scratch.types[mark + offset * 2]
        if wrap-case(to, case-type, true) == no-case
            rewraps = false
types.scratch.types.rewind(mark)
= rewraps

────────────────────
_ do tuple-final-cast Bool
    - to TypeId
    - from TypeId

. from-anon = is-anonymous-fields(types, from)
. to-anon = is-anonymous-fields(types, to)
. named = !from-anon && !to-anon
if named && !same-class(types, from, to)
    = false
. from-struct = types.completions[from].intrinsic == .struct
if !named && !from-anon && !(to-anon && from-struct)
    = false
. from-mark = types.scratch.types.mark
push-fields(types, from)
. to-mark = types.scratch.types.mark
push-fields(types, to)
. count = to-mark - from-mark
. legal-fields = count == types.scratch.types.length - to-mark
if legal-fields
    for offset in 0 .. < count
        . from-field = types.scratch.types[from-mark + offset]
        . to-field = types.scratch.types[to-mark + offset]
        if from-field != no-type && to-field != no-type && (!named || from-field != to-field)
            if named && (types.completions[from-field].intrinsic == .cpointer || to-pointer)
                legal-fields = false
            else if !legal(from-field, to-field)
                legal-fields = false
            .. to-pointer = types.completions[to-field].intrinsic == .cpointer
else if named
    legal-fields = true
types.scratch.types.rewind(from-mark)
= legal-fields

────────────────────
+ do tuple-field-preference I32
    - from TypeId
    - left TypeId
    - right TypeId
    - left-declared TypeId = no-type
    - right-declared TypeId = no-type

` Which of two tuples a tuple written with no name is better cast to, field by field: above
` zero for the right one, under it for the left one, zero where the fields disagree. A
` field one of the two declares as a parameter of its own loses to one the other declares
` with a type, as the reference prefers; any other is the one of lower rank.
if !is-anonymous-fields(types, from)
    = 0
. left-tuple = intrinsic-is-tuple-like(types.completions[left].intrinsic)
. right-tuple = intrinsic-is-tuple-like(types.completions[right].intrinsic)
if !left-tuple || !right-tuple
    = 0
. from-mark = types.scratch.types.mark
push-fields(types, from)
. left-mark = types.scratch.types.mark
push-fields(types, left)
. right-mark = types.scratch.types.mark
push-fields(types, right)
. left-open = types.scratch.types.mark
if left-declared != no-type && left-declared != invalid-type
    push-fields(types, left-declared)
. right-open = types.scratch.types.mark
if right-declared != no-type && right-declared != invalid-type
    push-fields(types, right-declared)
. count = left-mark - from-mark
. knows-left = right-open - left-open == count
. knows-right = types.scratch.types.length - right-open == count
. preference = 0i32
. conflict = false
if right-mark - left-mark == count && left-open - right-mark == count
    for offset in 0 .. < count
        . field = types.scratch.types[from-mark + offset]
        . to-left = types.scratch.types[left-mark + offset]
        . to-right = types.scratch.types[right-mark + offset]
        if field != no-type && to-left != no-type && to-right != no-type
            . left-free = knows-left && is-free-field(types.scratch.types[left-open + offset])
            . right-free = knows-right && is-free-field(types.scratch.types[right-open + offset])
            . left-rank = compare(field, to-left).rank
            . right-rank = compare(field, to-right).rank
            . field-preference = 0i32
            if left-free != right-free
                field-preference = if left-free then 1 else -1
            else if left-free
                field-preference = 0
            else if left-rank > right-rank
                field-preference = 1
            else if left-rank < right-rank
                field-preference = -1
            if field-preference != 0
                if preference != 0 && preference != field-preference
                    conflict = true
                preference = field-preference
types.scratch.types.rewind(from-mark)
= if conflict then 0 else preference

────────────────────
_ is-free-field Bool
    - declared TypeId

declared != no-type && declared != invalid-type && is-variable-row(types, declared)

────────────────────
_ has-type Bool
    - a TypeId
    - b TypeId

match types.completions[a].intrinsic
    |= .optional
        b == class-arg(types, a, 0)
    |= .union
        wrap-case(a, b) != no-case
    ??
        false

────────────────────
+ scope-open MatchScope

MatchScope(params.length, params.length)

────────────────────
+ do scope-release
    - scope MatchScope

params.truncate(scope.start)

────────────────────
+ do scope-find Size?
    - scope MatchScope
    - name Atom

. position = scope.start
for row in params[scope.start .. < scope.end]
    if row.name == name
        = position
    position += 1
= null

────────────────────
+ scope-lookup TypeId?
    - scope MatchScope
    - name Atom

|? found && type != no-type
    type
??
    null

.. found = scope-find(scope, name)
.. type = params[found].type

────────────────────
+ do scope-declare MatchScope?
    - scope MatchScope
    - name Atom
    - explicit Bool
    - type TypeId?

?! Panic("MatchScope declaration below the top frame")
    if scope.end != params.length

. resolved-explicit = false
if explicit && type
    . own = variable-name(types, type)
    resolved-explicit = !is-variable-row(types, type) || !own || own != name
. found = scope-find(scope, name)
if !found
    . row = TypeParamMatch
        - name
        - type ?? no-type
        - resolved-explicit
        - resolved-explicit
        - .convertible
        - false
        - 0
        - 0
        - 0
        - false
        - 0
        - 0
        - .convertible
    params.append(row)
    = MatchScope(scope.start, scope.end + 1)
. index Index = found
. pinned = params[index].is-pinned || resolved-explicit
. previous = params[index].type
if previous != no-type && !explicit && pinned
    params[index].is-pinned = pinned
    = scope
if previous != no-type && !is-variable-row(types, previous)
    if !type
        = null
    . held = implicitly(compare(type, previous, false, false, null))
    if !relation-legal(held) || is-narrowing(held)
        . unifier = unify(previous, type)
        if !relation-legal(unifier)
            = null
        params[index].type = unifier.unified
    params[index].is-pinned = pinned
    params[index].is-explicit = pinned
    = scope
. was-inferred = false
if type
    was-inferred = type != previous
params[index].is-pinned = pinned
params[index].type = type ?? no-type
. became-explicit = params[index].is-explicit || resolved-explicit || was-inferred
params[index].is-explicit = became-explicit
= scope

────────────────────
+ do scope-link
    - scope MatchScope
    - name Atom
