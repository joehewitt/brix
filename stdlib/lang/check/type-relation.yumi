_ no-case U32 = U32.max
_ no-match = U32.max as Specificity
_ converter-words Size = 4
_ unwrap-rank RelationRank = 30
_ converter-rank RelationRank = 90
_ final-rank RelationRank = 140

━━━━━━━━━━━━━━━━━━━━
+ relation-legal Bool
    - relation Relation

relation.kind != .relation-illegal

━━━━━━━━━━━━━━━━━━━━
+ validate-relation Bool
    - relation Relation
    - required Specificity

relation-legal(relation) && (relation.match) >= (required)

━━━━━━━━━━━━━━━━━━━━
+ most-specific Relation
    - first Relation
    - second Relation

|? !relation-legal(second)
    first
|? !relation-legal(first)
    second
|? first.rank < second.rank
    first
??
    second

━━━━━━━━━━━━━━━━━━━━
+ case-selection-rank I32
    - types Types
    - relation Relation

|? relation.kind == .relation-side-cast
    20 + representation-distance(types, relation.from, relation.to)
??
    relation.rank

━━━━━━━━━━━━━━━━━━━━
_ representation-distance I32
    - types Types
    - from TypeId
    - to TypeId

|? crosses-bool(types, from, to)
    3i32
|? !intrinsic-is-numeric(from-type) || !intrinsic-is-numeric(to-type)
    0i32
|? intrinsic-is-float(from-type) != intrinsic-is-float(to-type)
    2i32
|? intrinsic-bit-size(from-type) == intrinsic-bit-size(to-type) && same-sign
    0i32
??
    1i32

.. from-type = types.completions[from].intrinsic
.. to-type = types.completions[to].intrinsic
.. same-sign = intrinsic-is-signed(from-type) == intrinsic-is-signed(to-type)

━━━━━━━━━━━━━━━━━━━━
_ crosses-bool Bool
    - types Types
    - from TypeId
    - to TypeId

is-number-like(from-type) && is-number-like(to-type) && (from-type == .bool) != (to-type == .bool)

.. from-type = types.completions[from].intrinsic
.. to-type = types.completions[to].intrinsic

━━━━━━━━━━━━━━━━━━━━
_ is-number-like Bool
    - type IntrinsicKind

intrinsic-is-numeric(type) || type == .bool

━━━━━━━━━━━━━━━━━━━━
+ up-cast-relation Relation
    - from TypeId
    - to TypeId

` How a class relates to a class known to be among its bases, with no walk to find it.
make-relation(.relation-up-cast, from, to, to)

━━━━━━━━━━━━━━━━━━━━
_ make-relation Relation
    - kind RelationKind
    - from TypeId
    - to TypeId
    - unified TypeId

Relation(kind, rank, match, from, to, unified, U32.max, no-type, ratio, .reason-none, U32.max, 0)

.. rank = relation-rank(kind)
.. match = relation-match(kind)
.. ratio = no-ratio()

━━━━━━━━━━━━━━━━━━━━
_ illegal-relation Relation
    - from TypeId
    - to TypeId
    - reason RelationReason

Relation(.relation-illegal, -1i32, .convertible, from, to, to, U32.max, no-type, no-ratio(), reason)

━━━━━━━━━━━━━━━━━━━━
_ cache-key Size
    - source TypeId
    - target TypeId
    - caller ModuleId?

((source as Size) /lshift/ 40) /or/ ((target as Size) /lshift/ 16) /or/ caller-word(caller)

━━━━━━━━━━━━━━━━━━━━
_ caller-word Size
    - caller ModuleId?

|? caller
    caller + 1
??
    0

━━━━━━━━━━━━━━━━━━━━
_ common-base TypeId
    - types Types
    - candidate TypeId
    - to TypeId

|? in-base-chain(types, to, candidate)
    candidate
|? base
    common-base(types, base, to)
??
    no-type

.. base = types.base-of(candidate)

━━━━━━━━━━━━━━━━━━━━
_ do common-interface TypeId
    - types Types
    - root TypeId
    - id TypeId
    - to TypeId

. program = types.program
. completion = types.completion-of(id)
if completion.intrinsic == .interface && id != root && interface-includes(types, to, id)
    = id
for interface in types.children[completion.interfaces]
    . found = common-interface(types, root, interface, to)
    if found != no-type
        = found
= no-type

━━━━━━━━━━━━━━━━━━━━
_ do interface-includes Bool
    - types Types
    - id TypeId
    - target TypeId

. program = types.program
. completion = types.completion-of(id)
if completion.intrinsic == .interface && id == target
    = true
for interface in types.children[completion.interfaces]
    if interface-includes(types, interface, target)
        = true
= false

━━━━━━━━━━━━━━━━━━━━
+ variable-index U32
    - types Types
    - id TypeId

match types.rows[id]
    | .type-variable(row)
        row.index
    ??
        U32.max

━━━━━━━━━━━━━━━━━━━━
_ do member-type-in TypeId
    - types Types
    - module ModuleId
    - member DeclId
    - syntax SyntaxId
    - env TypeEnv

. program = types.program
. tree = program.modules[module].tree
. bound = types.declare-into(env, tree, syntax, module, member, env.end)
. type = types.evaluate-type(module, tree, syntax, bound)
types.env-truncate(env)
= type

━━━━━━━━━━━━━━━━━━━━
+ ConverterHit is Tuple

+ specificity Specificity
+ module ModuleId
+ decl DeclId
+ collision RelationReason = .reason-none
+ implicit Bool = true

━━━━━━━━━━━━━━━━━━━━
