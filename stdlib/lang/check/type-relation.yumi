    - env TypeEnv

. bound = scope-env(scope, env)
. tree = program.modules[row.syntax-module].tree
. assigned = assignment-type(row.syntax-module, tree, row.assign-syntax, bound)
types.env-truncate(env)
= assigned

────────────────────
+ scope-defers Bool
    - scope MatchScope
    - name Atom

|? !found
    false
|? row.assign-syntax == 0
    false
|? !row.must-match || row.type == no-type
    true
??
    is-variable-row(types, row.type) && !row.is-explicit

.. found = scope-find(scope, name)
.. row = params[found]

────────────────────
+ scope-has-assignment Bool
    - scope MatchScope
    - name Atom

|? !found
    false
??
    params[found].assign-syntax != 0

.. found = scope-find(scope, name)

────────────────────
+ do scope-specificity Specificity
    - scope MatchScope

for row in params[scope.start .. < scope.end]
