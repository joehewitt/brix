if found
    params[found].syntax-module = module
    params[found].assign-syntax = syntax
    params[found].has-specificity = is-specificity
    params[found].must-match = must-match

────────────────────
+ do scope-set-default
    - scope MatchScope
    - name Atom
    - module ModuleId
    - syntax SyntaxId

. found = scope-find(scope, name)
if found
    params[found].syntax-module = module
    params[found].default-syntax = syntax

────────────────────
+ do scope-set-constraint
    - scope MatchScope
    - name Atom
    - module ModuleId
    - syntax SyntaxId
