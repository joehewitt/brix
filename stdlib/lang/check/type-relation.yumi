        = complete-tuple(row.fields, row.names, from, scope)
    | .type-class(row)
        if from == types.null-type && types.intrinsic-of(to) == .optional
            = null
        if types.intrinsic-of(to) == .or
            = complete-alternative(to, from, scope)
        if types.completions[from].intrinsic == .closure
            types.complete(to)
            . fitted = fit-closure(from, to, scope) if function-row(types, to) != no-type
            = complete-against(to, fitted, scope) if fitted
        if types.completions[from].intrinsic == .binding
            types.complete(to)
            if function-row(types, to) != no-type
                . fitted = fit-closure(from, to, scope)
                = complete-against(to, fitted, scope) if fitted
        . matching = member-class(types, from, row.module, row.decl)
        if matching == no-type
            matching = converted-class(from, row.module, row.decl)
        if matching == no-type && converts-from(to, from)
            match? types.rows[from]
                | .type-class(other)
                    = complete-params(row.module, row.decl, row.args, other.args, scope)
        if matching == no-type
            = complete-shape(to, row.module, row.decl, row.args, from, scope)
        . actual = RowRange'TypeId()
        match? types.rows[matching]
            | .type-class(other)
                actual = other.args
        = complete-params(row.module, row.decl, row.args, actual, scope)
    | .type-associated(row)
        = complete-associated(row.owner, row.name, row.args, from, scope)
= null

────────────────────
_ do complete-associated TypeId?
    - owner TypeId
    - name Atom
    - args RowRange'TypeId
    - from TypeId
    - scope MatchScope

` An associated type of a parameter the call has bound is the type that binding gives it,
` whose own parameters the source then binds.
. variable = variable-name(types, owner)
. bound = if variable then scope-lookup(scope, variable) ?? owner else owner
if !bound || types.completions[bound].has-variables
    = null
. mark = types.scratch.types.mark
for offset in 0 .. < args.count
    types.scratch.types.push(types.child-type(args, offset))
. resolved = types.resolve-associated(bound, name, mark, types.env-frame())
if resolved == invalid-type
    = null
= complete-against(resolved, from, scope)

────────────────────
+ do converted-class TypeId
    - from TypeId
    - module ModuleId
    - decl DeclId

` The type one of the source's converters gives when it is an instance of the wanted class.
. mark = types.scratch.types.mark
push-converters(from, null)
. count = (types.scratch.types.length - mark) / converter-words
. found = no-type
for offset in 0 .. < count
    . base = mark + offset * converter-words
    . target = types.scratch.types[base]
    . ref = class-decl-ref(types, target)
    if ref.module == module && ref.decl == decl
        if types.completions[target].has-variables
            . converter-module U32 = types.scratch.types[base + 1]
            . converter U32 = types.scratch.types[base + 2]
            target = default-target(converter-module, converter, types.scratch.types[base + 3])
        if target != invalid-type && !types.completions[target].has-variables
            found = target
types.scratch.types.rewind(mark)
= found

────────────────────
_ do default-target TypeId
    - module ModuleId
    - decl DeclId
    - owner TypeId

` The type a converter to a generic type gives when nothing names that type's parameters:
` each takes the type its declaration assigns it.
. owner-module = 0u32
. owner-decl = 0u32
. owner-args = RowRange'TypeId()
match? types.rows[owner]
    | .type-class(row)
        owner-module = row.module
        owner-decl = row.decl
        owner-args = row.args
. decls = program.modules[module].decls
. tree = program.modules[module].tree
. target = invalid-type
match? decls[decl]
    | .decl-converter(row)
        . env = types.env-frame()
        . extended = false
        match? decls[row.owner]
            | .decl-extension
                extended = true
        if extended
            . matched = match-extension(module, row.owner, owner)
            if !matched
                = invalid-type
            env = matched.env
        else
            env = types.class-env-for(owner-module, owner-decl, owner-args, owner)
        env = types.declare-into(env, tree, row.target-type, module, decl, env.end)
        for assignment in tree.nodes[tree.children[row.param-assignments]]
            match? assignment
                | .node-param-assignment(arow)
                    . left = types.type-syntax-name(tree, arow.left)
                    . assigned = assignment-type(module, tree, arow.right, env)
                    if left && assigned.type != invalid-type
                        env = types.env-bind(env, left, assigned.type)
        target = types.evaluate-type(module, tree, row.target-type, env)
        types.env-release(env)
= target

────────────────────
_ do complete-shape TypeId?
    - to TypeId
    - module ModuleId
    - decl DeclId
    - args RowRange'TypeId
    - from TypeId
    - scope MatchScope

` A generic class no base or interface of the source names: an optional takes its parameter
` from the value it would hold, and a tuple class takes its parameters field by field from an
` anonymous tuple. A parameter the class was named without is taken from the fields that hold
` it, joined as the types of a generic function's arguments are.
. optional = types.type-decl(.optional)
if module == optional.module && decl == optional.decl && args.count == 1
    . inner = complete-against(types.child-type(args, 0), from, scope)
    = types.optional-of(inner) if inner
. source = RowRange'TypeId()
match? types.rows[from]
    | .type-tuple(other)
        source = other.fields
. kind = types.intrinsic-of(to)
if source.count == 0 || (kind != .tuple && kind != .struct)
    = null
. pairs = types.scratch.types.mark
. position = 0u32
for field in types.properties-of(to)
    if field.storage-kind == .storage-eager
        if position >= source.count || field.type == no-type
            types.scratch.types.rewind(pairs)
            = null
        . completed = complete-against(field.type, types.child-type(source, position), scope)
        if !completed
            types.scratch.types.rewind(pairs)
            = null
        . held = types.scratch.types.mark
        bind-row(types, field.type, completed, held)
        if !join-pairs(pairs, held)
            types.scratch.types.rewind(pairs)
            = null
        position += 1
if position != source.count
    types.scratch.types.rewind(pairs)
    = null
. mark = types.scratch.types.mark
for offset in 0 .. < args.count
    . arg = types.child-type(args, offset)
    . name = variable-name(types, arg)
    . bound = if name then scope-lookup(scope, name) ?? paired(types, arg, pairs, mark) else partner
        .. partner = paired(types, arg, pairs, mark)
    types.scratch.types.push(bound ?? arg)
. completed = types.intern-class(module, decl, mark)
types.scratch.types.rewind(pairs)
= completed

────────────────────
_ do join-pairs Bool
    - mark ScratchMark
    - held ScratchMark

` Joins the pairs `bind-row` pushed from `held` into those pushed from `mark` before: a
` pattern bound there takes the type its two types join to, as `joined-places` joins them, and a
` new one is kept. False where two types of one pattern do not join.
. pending = types.scratch.types
. end = held
. count = (pending.length - held) / 2
for offset in 0 .. < count
    . pattern = pending[held + offset * 2]
    . actual = pending[held + offset * 2 + 1]
    . found = false
    for earlier in 0 .. < (end - mark) / 2
        . bound = mark + earlier * 2
        if pending[bound] == pattern
            found = true
            if pending[bound + 1] != actual
                . joined = joined-places(pending[bound + 1], actual)
                if joined == no-type
                    = false
                pending[bound + 1] = joined
    if !found
        pending[end] = pattern
        pending[end + 1] = actual
        end += 2
pending.rewind(end)
= true

────────────────────
_ do complete-tuple TypeId?
    - fields RowRange'TypeId
    - names RowRange'Atom
    - from TypeId
    - scope MatchScope

. source = RowRange'TypeId()
match? types.rows[from]
    | .type-tuple(other)
        source = other.fields
if source.count != fields.count || fields.count == 0
    = null
. mark = types.scratch.types.mark
. names-mark = types.scratch.names.mark
for offset in 0 .. < fields.count
    . given = types.child-type(source, offset)
    . field = complete-against(types.child-type(fields, offset), given, scope)
    if !field
        types.scratch.types.rewind(mark)
        types.scratch.names.rewind(names-mark)
        = null
    types.scratch.types.push(field)
    types.scratch.names.push(types.child-name(names, offset))
= types.intern-tuple(mark, names-mark)

────────────────────
_ do complete-alternative TypeId?
    - to TypeId
    - from TypeId
    - scope MatchScope

. alternatives = types.completions[to].alternatives
. plain = unraised(from)
. saved [TypeParamMatch]
for row in params[scope.start .. < scope.end]
    saved += row
. length = params.length
. best = no-type
. best-rank = 0i32
. best-offset = 0
for offset in 0 .. < alternatives.count
    . alternative = types.child-type(alternatives, offset)
    . relation = compare(plain, alternative, false, false, scope)
    if relation-legal(relation) && (best == no-type || relation.rank < best-rank)
        best = relation.unified
        best-rank = relation.rank
        best-offset = offset
    restore-scope(scope, saved, length)
if best == no-type
    = null
. chosen = types.child-type(alternatives, best-offset as U32)
compare(plain, chosen, false, false, scope)
= if plain != from then from else best

────────────────────
_ do unraised TypeId
    - id TypeId

` A class whose value raises errors of its own, as the generator of a function that yields
` and raises does, without them: the reference chooses among alternatives by that type, and
` the value keeps its own.
match? types.rows[id]
    | .type-class(row)
        if row.errors.count != 0
            . mark = types.scratch.types.mark
            for offset in 0 .. < row.args.count
                types.scratch.types.push(types.child-type(row.args, offset))
            = types.intern-class(row.module, row.decl, mark)
= id

────────────────────
_ do restore-scope
    - scope MatchScope
    - saved [TypeParamMatch]
    - length Size

params.truncate(length)
for offset in 0 .. < saved.length
    params[scope.start + offset] = saved[offset]

────────────────────
_ do converts-from Bool
    - to TypeId
    - from TypeId

` A generic class that declares a conversion from the source takes its parameters from the
` source's own, in order.
types.complete(to)
= fromverter-owner(to, from, null).owner != no-type

────────────────────
_ do complete-params TypeId?
    - module ModuleId
    - decl DeclId
    - patterns RowRange'TypeId
    - actuals RowRange'TypeId
    - scope MatchScope

if patterns.count != actuals.count
    = null
. mark = types.scratch.types.mark
for offset in 0 .. < patterns.count
    . pattern = types.child-type(patterns, offset)
    . actual = types.child-type(actuals, offset)
    . chosen TypeId? = null
    if is-variable-row(types, pattern)
        . name = variable-name(types, pattern)
        if name && scope-find(scope, name)
            chosen = scope-evaluate(scope, name, types.env-frame(), actual)
        else
            chosen = actual
        if chosen && types.completions[chosen].has-variables
            chosen = null
    else if types.completions[pattern].has-variables || holds-alternatives(pattern)
        chosen = complete-against(pattern, actual, scope)
    else if types.intrinsic-of(pattern) == .or
        chosen = complete-alternative(pattern, actual, scope)
    else if is-variable-row(types, actual)
        chosen = pattern
    else if pattern == actual
        chosen = pattern
    if !chosen
        types.scratch.types.rewind(mark)
        = null
    types.scratch.types.push(chosen)
= types.intern-class(module, decl, mark)
