= no-type

────────────────────
_ can-unify-with-target Bool
    - from TypeId
    - to TypeId

relation-legal(relation) && relation.rank < converter-rank

.. relation = compare(from, to, false, true)

────────────────────
+ do bind-converter Bool
    - from TypeId
    - to TypeId
    - module ModuleId
    - decl DeclId
    - caller ModuleId?
    - mark ScratchMark = 0

. list-mark = types.scratch.types.mark
push-converters(from, caller)
. count = (types.scratch.types.length - list-mark) / converter-words
. target = no-type
for offset in 0 .. < count
    . base = list-mark + offset * converter-words
    . same-module = types.scratch.types[base + 1] == module
    if same-module && types.scratch.types[base + 2] == decl
        target = types.scratch.types[base]
types.scratch.types.rewind(list-mark)
if target == no-type || target == to || !types.completions[target].has-variables
    = false
= bind-row(types, target, to, mark)

────────────────────
_ do push-converters
    - id TypeId
    - caller ModuleId?

. completion = types.completion-of(id)
if !completion.has-variables
    for converter in types.children[completion.converters]
        types.scratch.types.push(converter)
    if caller
        push-extension-converters(caller, id)
. base = types.base-of(id)
if base
    push-converters(base, caller)
for offset in 0 .. < completion.interfaces.count
    push-converters(types.child-type(completion.interfaces, offset), caller)

────────────────────
_ do push-extension-converters
    - caller ModuleId
    - id TypeId

. ref = class-decl-ref(types, id)
if ref.module == U32.max
    =
for extension in program.extensions-for(caller, ref.module, ref.decl)
    . matched = match-extension(extension.module, extension.decl, id)
    if matched
        . owner-module = program.modules[extension.module]
        match? owner-module.decls[extension.decl]
            | .decl-extension(row)
                for member in owner-module.member-pool[row.members]
                    match? owner-module.decls[member]
                        | .decl-converter(converter)
                            . syntax = converter.target-type
                            . env = matched.env
                            . owner = extension.module
                            . target = member-type-in
                                - types
                                - owner
                                - member
                                - syntax
                                - env
                            types.scratch.types.push(target)
                            types.scratch.types.push(extension.module)
                            types.scratch.types.push(member)
                            types.scratch.types.push(id)
                            extension-uses += 1
        types.env-release(matched.env)

────────────────────
_ do converter-match ConverterHit
    - from TypeId
    - to TypeId
    - caller ModuleId?

` The converter a type gives a type by, as TypeScript's `dispatchConverter` finds it: of the
` type's own, its extensions', its base's and its interfaces', in that order, the first whose
` target is the type asked for, or else the first whose target binds to it. One that binds to a
` pointer to anything but `Void` converts only when asked, as it reads the type as another.
. mark = types.scratch.types.mark
push-converters(from, caller)
. count = (types.scratch.types.length - mark) / converter-words
. best = ConverterHit(no-match, U32.max, 0)
. best-rank = 0i32
for offset in 0 .. < count
    . base = mark + offset * converter-words
    . target = types.scratch.types[base]
    . module U32 = types.scratch.types[base + 1]
    . decl U32 = types.scratch.types[base + 2]
    . owner = types.scratch.types[base + 3]
    . rank = 0i32
    . binding-mark = types.scratch.types.mark
    . applies = false
    if target == to || is-alternative(target, to)
        applies = true
    else if types.completions[target].has-variables && !types.completions[to].has-variables
        applies = bind-row(types, target, to, binding-mark)
        rank = 1
    . ties = best.specificity != no-match && rank == best-rank
    if applies && (best.specificity == no-match || rank <= best-rank)
        . hit = converter-hit(module, decl, owner, binding-mark)
        if hit.specificity != no-match && ties
            . collision = converter-collision(best, module, decl)
            if collision != .reason-none
                best = ConverterHit
                    - best.specificity
                    - best.module
                    - best.decl
                    - collision
                    - best.implicit
        else if hit.specificity != no-match && rank != 0 && retypes-pointer(to)
            best = ConverterHit(hit.specificity, hit.module, hit.decl, hit.collision, false)
            best-rank = rank
        else if hit.specificity != no-match
            best = hit
            best-rank = rank
    types.scratch.types.rewind(binding-mark)
types.scratch.types.rewind(mark)
= best

────────────────────
_ retypes-pointer Bool
    - to TypeId

types.completion-of(to).intrinsic == .cpointer && pointee-of(types, to) != types.void-type

────────────────────
_ do is-alternative Bool
    - target TypeId
    - to TypeId

` Whether a converter declared to give one of several types gives the one asked for: the
` reference completes the type it declares against the one asked for, which takes the
` alternative that is that type.
types.complete(target)
if types.completions[target].intrinsic != .or
    = false
. alternatives = types.completions[target].alternatives
for offset in 0 .. < alternatives.count
    if types.child-type(alternatives, offset) == to
        = true
= false

────────────────────
_ converter-collision RelationReason
    - held ConverterHit
    - module ModuleId
    - decl DeclId

` Two converters that reach one target equally well collide when an extension adds either: two
` extensions are ambiguous, and an extension beside the type's own converter conflicts with it.
|? held.module == module && held.decl == decl
    .reason-none
|? mine && theirs
    .reason-ambiguous
|? mine || theirs
    .reason-conflict
??
    .reason-none

.. mine = extends-converter(held.module, held.decl)
.. theirs = extends-converter(module, decl)

────────────────────
_ do extends-converter Bool
    - module ModuleId
    - decl DeclId

. decls = program.modules[module].decls
match? decls[decl]
    | .decl-converter(row)
        match? decls[row.owner]
            | .decl-extension
                = true
= false

────────────────────
_ do converter-hit ConverterHit
    - module ModuleId
    - decl DeclId
    - owner TypeId
    - binding-mark ScratchMark

. owner-module = 0u32
. owner-decl = 0u32
. owner-args = RowRange'TypeId()
match? types.rows[owner]
    | .type-class(row)
        owner-module = row.module
        owner-decl = row.decl
        owner-args = row.args
. decls = program.modules[module].decls
. extension-owner = U32.max
match? decls[decl]
    | .decl-converter(row)
        match? decls[row.owner]
            | .decl-extension
                extension-owner = row.owner
. env = types.env-frame()
if extension-owner != U32.max
    . matched = match-extension(module, extension-owner, owner)
    if !matched
        = ConverterHit(no-match, U32.max, 0)
    env = matched.env
else
    env = types.class-env-for(owner-module, owner-decl, owner-args, owner)
. count = (types.scratch.types.length - binding-mark) / 2
for offset in 0 .. < count
    . variable = types.scratch.types[binding-mark + offset * 2]
    . actual = types.scratch.types[binding-mark + offset * 2 + 1]
    . name = variable-name(types, variable)
    if name
        env = types.env-bind(env, name, actual)
. tree = program.modules[module].tree
. result = ParamResult(env, .convertible, false)
match? decls[decl]
    | .decl-converter(row)
        . assigns = row.param-assignments
        . limits = row.param-constraints
        result = apply-param-declarations(module, tree, assigns, limits, env)
types.env-release(result.env)
if result.accepted
    = ConverterHit(result.specificity, module, decl, .reason-none, result.implicit)
= ConverterHit(no-match, U32.max, 0)

────────────────────
_ do apply-param-declarations ParamResult
    - module ModuleId
    - tree AST
    - assignments RowRange'SyntaxId
    - constraints RowRange'SyntaxId
    - env TypeEnv

. current = env
. specificity = Specificity.convertible
. accepted = true
. implicit = true
for assignment in tree.nodes[tree.children[assignments]]
    match? assignment
        | .node-param-assignment(arow)
            . assigned = assignment-type(module, tree, arow.right, current)
            if assigned.type == invalid-type
                accepted = false
            else
                implicit = implicit && assigned.implicit
                if arow.is-specificity
                    specificity = assigned.match
                . left = types.type-syntax-name(tree, arow.left)
                . bound = types.env-lookup(current, left) if left
                if left && !bound
                    current = types.env-bind(current, left, assigned.type)
                else if bound && bound != assigned.type
                    accepted = false
for constraint in tree.nodes[tree.children[constraints]]
    match? constraint
        | .node-param-constraint(crow)
            . name = types.type-syntax-name(tree, crow.left)
            . bound = types.env-lookup(current, name) if name
            if bound
                . caller Index = module
                . right = types.evaluate-type(caller as ModuleId, tree, crow.right, current)
                . relation = compare(bound, right)
                . required = required-match(crow.op)
                if !holds-as(relation, required, true)
                    accepted = false
                else if required == .convertible && !kin(relation) && !this.implicit(relation)
                    implicit = false
            else
                accepted = false
= ParamResult(current, specificity, accepted, implicit)

────────────────────
+ do match-extension ExtensionHit?
    - module ModuleId
    - decl DeclId
    - type TypeId

. env = extension-env(types, module, decl, type)
. pattern = env.this-type
. ref = class-decl-ref(types, pattern)
if ref.module == U32.max
    types.env-release(env)
    = null
. matching = member-class(types, type, ref.module, ref.decl)
if matching == no-type
    types.env-release(env)
    = null
. mark = types.scratch.types.mark
if !bind-row(types, pattern, matching, mark)
    types.scratch.types.rewind(mark)
    types.env-release(env)
    = null
. count = (types.scratch.types.length - mark) / 2
for offset in 0 .. < count
    . variable = types.scratch.types[mark + offset * 2]
    . actual = types.scratch.types[mark + offset * 2 + 1]
    . name = variable-name(types, variable)
    if name
        env = types.env-bind(env, name, actual)
types.scratch.types.rewind(mark)
. owner-module = program.modules[module]
. tree = owner-module.tree
. result = ParamResult(env, .convertible, false)
match? owner-module.decls[decl]
    | .decl-extension(row)
        . assigns = row.param-assignments
        . limits = row.param-constraints
        result = apply-param-declarations(module, tree, assigns, limits, env)
env = result.env
if !result.accepted || !params-resolved(types, env)
    types.env-release(env)
    = null
= ExtensionHit(module, decl, matching, types.env-with-this(env, matching))

────────────────────
+ do extension-matches <ExtensionHit>
    - caller ModuleId
    - type TypeId

. chain [TypeId]
collect-member-chain(types, type, chain)
for level in chain
    . ref = class-decl-ref(types, level)
    if ref.module != U32.max
        for extension in program.extensions-for(caller, ref.module, ref.decl)
            . decl U32 = extension.decl
            . matched = match-extension(extension.module, decl, type)
            if matched
                <= matched
                types.env-release(matched.env)

────────────────────
_ do assignment-type Assigned
    - module ModuleId
    - tree AST
    - right SyntaxId
    - env TypeEnv

match? tree.nodes[right]
    | .node-cast-expression(cast)
        . source = types.evaluate-type(module, tree, cast.lhs, env)
        . target = types.evaluate-type(module, tree, cast.rhs, env)
        . relation = compare(source, target)
        if relation-legal(relation)
            . unified = if relation.unified != no-type then relation.unified else target
            = Assigned(unified, relation.match, implicit(relation))
        = Assigned(invalid-type, .convertible)
= Assigned(types.evaluate-type(module, tree, right, env), .convertible)

────────────────────
+ do fromverter-owner FromverterHit
    - to TypeId
    - from TypeId
    - caller ModuleId?

. completion = types.completions[to]
. direct = FromverterHit(no-type, U32.max, 0)
for offset in 0 .. < completion.fromverters.count / converter-words
    . base = offset * converter-words
    if direct.owner == no-type && types.child-type(completion.fromverters, base as U32) == from
        . module U32 = types.child-type(completion.fromverters, (base + 1) as U32)
        . decl U32 = types.child-type(completion.fromverters, (base + 2) as U32)
        direct = FromverterHit(to, module, decl)
if caller
    . extended = extension-fromverter-hit(caller, to, from)
    if extended.owner != no-type && direct.owner != no-type
        = FromverterHit(to, direct.module, direct.decl, .reason-conflict)
    if extended.owner != no-type
        = extended
if direct.owner != no-type
    = direct
. numeric-from = intrinsic-is-numeric(types.completions[from].intrinsic)
if completion.has-enums && completion.intrinsic != .union && numeric-from
    = FromverterHit(to, U32.max, 0)
. base = types.base-of(to)
if base
    = fromverter-owner(base, from, caller)
= FromverterHit(no-type, U32.max, 0)

────────────────────
_ do extension-fromverter-hit FromverterHit
    - caller ModuleId
    - to TypeId
    - from TypeId

` The fromverter an extension adds for the source type; two of them are ambiguous.
. ref = class-ref(types, to)
. hit = FromverterHit(no-type, U32.max, 0)
if ref.module == U32.max
    = hit
for extension in program.extensions-for(caller, ref.module, ref.decl)
    . matched = match-extension(extension.module, extension.decl, to)
    if matched
        . owner-module = program.modules[extension.module]
        match? owner-module.decls[extension.decl]
            | .decl-extension(row)
                for member in owner-module.member-pool[row.members]
                    match? owner-module.decls[member]
                        | .decl-fromverter(fromverter)
                            . syntax = fromverter.source-type
                            . env = matched.env
                            . owner = extension.module
                            . source = member-type-in
                                - types
                                - owner
                                - member
                                - syntax
                                - env
                            if source == from && hit.owner != no-type
                                hit = FromverterHit(to, hit.module, hit.decl, .reason-ambiguous)
                            else if source == from
                                hit = FromverterHit(to, extension.module, member)
