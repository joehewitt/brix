. found = scope-find(scope, name)
if found
    params[found].links = params[found].links /or/ (1u64 /lshift/ index)

────────────────────
+ scope-links U64
    - scope MatchScope
    - name Atom

|? found
    params[found].links
??
    0u64

.. found = scope-find(scope, name)

────────────────────
+ do scope-clear-links
    - scope MatchScope
    - name Atom

. found = scope-find(scope, name)
if found
    params[found].links = 0u64

────────────────────
+ do scope-set-assignment
