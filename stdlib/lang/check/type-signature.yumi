━━━━━━━━━━━━━━━━━━━━
+ Signature is Tuple

` A declaration's signature evaluated in an environment: its type parameter names and the
` variables or bound types they stand for, its argument types, return type, and error types.
` The spans are runs on the types' scratch stacks and live until the caller rewinds.

+ params ImmutableArray'Atom'ArenaBacking
+ variables ImmutableArray'TypeId'ArenaBacking
+ args ImmutableArray'TypeId'ArenaBacking
+ returns TypeId
+ errors ImmutableArray'TypeId'ArenaBacking

━━━━━━━━━━━━━━━━━━━━
+ TypeArguments is Tuple

` IntrinsicKind parameter names bound to types before a signature is evaluated.

+ names ImmutableArray'Atom'ArenaBacking
+ types ImmutableArray'TypeId'ArenaBacking

━━━━━━━━━━━━━━━━━━━━
+ FunctionEnv is Tuple

+ env TypeEnv
+ params-start ScratchMark
+ hidden-start ScratchMark = 0
+ hidden-end ScratchMark = 0

━━━━━━━━━━━━━━━━━━━━
+ do owner-env TypeEnv
    - types Types
    - module ModuleId
    - owner DeclId

. program = types.program
if owner == 0
    = types.env-frame()

match? program.modules[module].decls[owner]
    | .decl-class
        = types.class-env(module, owner)
    | .decl-extension
        = extension-env(types, module, owner)
= types.env-frame()

━━━━━━━━━━━━━━━━━━━━
+ do extension-env TypeEnv
    - types Types
    - module ModuleId
    - decl DeclId
    - receiver TypeId = no-type

` The environment of an extension, the names its pattern declares. The pattern is read where
` the class it extends is, so with a receiver known, a name of that class's parameters the
` pattern does not declare is, while it is read, what the receiver gives it. A facet's `this` is
` its class, which takes no type arguments, through whatever facets the facet is part of.
. program = types.program
. env = types.env-frame()
. tree = program.modules[module].tree
match? program.modules[module].decls[decl]
    | .decl-extension(row)
        if row.facet
            . facets = program.facets
            . facet = facets.index-of(module, decl)
            . owner = invalid-type
            if facet && facets.states[facet] == .facet-bound
                owner = types.plain-class(facets.owner-modules[facet], facets.owner-decls[facet])
            = types.env-with-this(env, owner)
        env = types.declare-into(env, tree, row.receiver, module, decl, env.start)
        . pattern = no-type
        if receiver != no-type
            . scoped = bind-extended(types, module, tree, row.receiver, receiver, env)
            pattern = types.evaluate-type(module, tree, row.receiver, scoped)
            types.env-truncate(env)
        else
            pattern = types.evaluate-type(module, tree, row.receiver, env)
        env = types.env-with-this(env, pattern)
        env = types.apply-constraints(module, tree, row.param-constraints, env)
= env

━━━━━━━━━━━━━━━━━━━━
+ do extended-class-env TypeEnv
    - types Types
    - module ModuleId
    - owner DeclId
    - receiver TypeId
    - env TypeEnv

` For a member of an extension read with its receiver known, the parameters of the class it
` extends that its pattern does not declare, bound from the receiver: TypeScript reads the
` member where the class is. They are not parameters of the member.
. program = types.program
match? program.modules[module].decls[owner]
    | .decl-extension(row)
        = bind-extended(types, module, program.modules[module].tree, row.receiver, receiver, env)
= env

━━━━━━━━━━━━━━━━━━━━
_ do bind-extended TypeEnv
    - types Types
    - module ModuleId
    - tree AST
    - pattern SyntaxId
    - receiver TypeId
    - env TypeEnv

. base = pattern
match? tree.nodes[pattern]
    | .node-type-arguments(row)
        base = row.base
. extended = class-ref(types, types.evaluate-type(module, tree, base, env))
if extended.decl == 0
    = env
. program = types.program
. bound = env
match? program.modules[extended.module].decls[extended.decl]
    | .decl-class(row)
        . args = RowRange'TypeId()
        match? types.rows[owner-instance(types, extended.module, extended.decl, receiver)]
            | .type-class(actual)
                args = actual.args
        . owner-tree = program.modules[extended.module].tree
        for position in 0 .. < args.count
            if position < row.type-args.count
                . name = types.class-param-name(owner-tree, row.type-args, position)
                if name && !types.env-lookup(bound, name)
                    bound = types.env-bind(bound, name, types.child-type(args, position))
= bound

━━━━━━━━━━━━━━━━━━━━
+ do function-env FunctionEnv
    - types Types
    - module ModuleId
    - decl DeclId
    - bindings TypeArguments
    - receiver TypeId
    - class-params Bool
    - around TypeEnv? = null

` The environment a function's types are read in. A function written in another one starts from
` what that one's binds, `around`.
. program = types.program
. owner-module = program.modules[module]
. tree = owner-module.tree
match? owner-module.decls[decl]
    | .decl-function(row)
        . env = if around then types.env-within(around) else owner-env(types, module, row.owner)
        . hidden-start = env.end
        if receiver != no-type
            env = extended-class-env(types, module, row.owner, receiver, env)
        . hidden-end = env.end
        if receiver != no-type
            env = bind-receiver(types, module, row.owner, receiver, env)
        . params-start = env.end
        . constructs = is-constructor-kind(row.kind)
        if class-params && constructs
            params-start = env.start
        match? owner-module.decls[row.owner]
            | .decl-extension
                if class-params || !constructs
                    params-start = env.start
        . first = env.end
        for child in tree.children[row.type-args]
            . name = types.type-syntax-name(tree, child)
            if name && !types.env-lookup-from(env, name, first)
                . index U32 = (env.end - first) as U32
                . variable = types.intern-variable(module, decl, index, name)
                env = types.env-bind(env, name, variable)
        if is-index-span-constructor-kind(row.kind)
            for text in ["Source", "Bounds"]
                . name = program.store-atom(text)
                . index U32 = (env.end - first) as U32
                env = types.env-bind(env, name, types.intern-variable(module, decl, index, name))
        for shape in owner-module.arg-pool[row.args]
            env = types.declare-into(env, tree, shape.pattern, module, decl, first)
            if is-implicit-argument(types, module, tree, constructed-class(row), shape)
                . name = pattern-name(types, tree, shape.pattern)!
                if !types.env-lookup-from(env, name, first)
                    . index U32 = (env.end - first) as U32
                    . variable = types.intern-variable(module, decl, index, name)
                    env = types.env-bind(env, name, variable)
        for offset in 0 .. < bindings.names.length
            env = types.env-bind(env, bindings.names[offset], bindings.types[offset])
        env = types.apply-constraints(module, tree, row.param-constraints, env)
        = FunctionEnv(env, params-start, hidden-start, hidden-end)
    | .decl-converter(row)
        . env = owner-env(types, module, row.owner)
        if receiver != no-type
            env = bind-receiver(types, module, row.owner, receiver, env)
        . params-start = env.end
        env = types.declare-into(env, tree, row.target-type, module, decl, params-start)
        env = bind-given(types, bindings, env)
        env = types.apply-constraints(module, tree, row.param-constraints, env)
        = FunctionEnv(env, params-start)
    | .decl-fromverter(row)
        . env = owner-env(types, module, row.owner)
        if receiver != no-type
            env = bind-receiver(types, module, row.owner, receiver, env)
        . params-start = env.end
        env = types.declare-into(env, tree, row.source-type, module, decl, params-start)
        = FunctionEnv(bind-given(types, bindings, env), params-start)
= FunctionEnv(types.env-frame(), 0)

━━━━━━━━━━━━━━━━━━━━
_ do bind-given TypeEnv
    - types Types
    - bindings TypeArguments
    - env TypeEnv

. bound = env
for offset in 0 .. < bindings.names.length
    bound = types.env-bind(bound, bindings.names[offset], bindings.types[offset])
= bound

━━━━━━━━━━━━━━━━━━━━
+ do converter-env TypeEnv
    - types Types
    - module ModuleId
    - decl DeclId
    - owner DeclId
    - type-syntax SyntaxId

. program = types.program
. env = owner-env(types, module, owner)
. tree = program.modules[module].tree
= types.declare-into(env, tree, type-syntax, module, decl, env.end)

━━━━━━━━━━━━━━━━━━━━
+ do signature-into Signature
    - types Types
    - module ModuleId
    - decl DeclId
    - bindings TypeArguments
    - receiver TypeId
    - class-params Bool

` A fault raised before is set aside while the signature is read, so what reading it raises
` alone decides whether it is kept.
. program = types.program
. owner-module = program.modules[module]
. tree = owner-module.tree
. scratch = types.scratch
open-key(types, module, decl, bindings, receiver, class-params)
. cached = scratch.signatures.found
if cached
    = replay(scratch, scratch.signatures.rows[cached])
. prior = types.fault
. prior-module = types.fault-module
. prior-site = types.fault-site
types.clear-fault()
. function = function-env(types, module, decl, bindings, receiver, class-params)
. env = function.env
. params-start = scratch.names.mark
for position in function.params-start .. < env.end
    . name = types.env-name(position)
    . hidden = position >= function.hidden-start && position < function.hidden-end
    if !hidden && !name-in-span(scratch.names.since(params-start), name)
        scratch.names.push(name)
. params = scratch.names.since(params-start)
. variables-start = scratch.types.mark
for name in params
    . bound = types.env-lookup(env, name)
    scratch.types.push(bound ?? invalid-type)
. variables = scratch.types.since(variables-start)
. args-start = scratch.types.mark
. args-count = 0
. returns = no-type
. errors = scratch.no-types
match? owner-module.decls[decl]
    | .decl-function(row)
        if is-table-constructor-kind(row.kind)
            args-count = table-arguments(types, module, row.kind, env)
        else if row.args.count != 0
            for shape in owner-module.arg-pool[row.args]
                . declared = argument-type(types, module, tree, constructed-class(row), shape, env)
                scratch.types.push(declared)
                args-count += 1
        if row.return-type != 0
            returns = types.evaluate-type(module, tree, row.return-type, env)
        . errors-start = scratch.types.mark
        for child in tree.children[row.errors]
            scratch.types.push(types.evaluate-type(module, tree, child, env))
        errors = scratch.types.since(errors-start)
    | .decl-converter(row)
        returns = types.evaluate-type(module, tree, row.target-type, env)
    | .decl-fromverter(row)
        scratch.types.push(types.evaluate-type(module, tree, row.source-type, env))
        args-count = 1
        returns = if receiver != no-type then receiver else env.this-type
types.env-release(env)

. signature = Signature
    - params
    - variables
    - scratch.types.span(args-start, args-count)
    - returns
    - errors
open-key(types, module, decl, bindings, receiver, class-params)
remember(types, signature)
if prior
    types.fault = prior
    types.fault-module = prior-module
    types.fault-site = prior-site
= signature

━━━━━━━━━━━━━━━━━━━━
_ do open-key
    - types Types
    - module ModuleId
    - decl DeclId
    - bindings TypeArguments
    - receiver TypeId
    - class-params Bool

. cache = types.scratch.signatures
cache.open-key(module, decl, receiver, class-params, bindings.names.length)
for offset in 0 .. < bindings.names.length
    . name U32 = types.program.atom-key(bindings.names[offset]) as U32
    cache.add-binding(name, bindings.types[offset])

━━━━━━━━━━━━━━━━━━━━
_ do replay Signature
    - scratch TypingScratch
    - row CachedSignature

` The cached signature, pushed as the runs an evaluation leaves.
. cache = scratch.signatures
. names-start = scratch.names.mark
for offset in 0 .. < row.params
    scratch.names.push(cache.names[row.names + offset])
. params = scratch.names.since(names-start)
. variables-start = scratch.types.mark
for offset in 0 .. < row.params
    scratch.types.push(cache.types[row.types + offset])
. variables = scratch.types.since(variables-start)
. args-start = scratch.types.mark
for offset in 0 .. < row.args
    scratch.types.push(cache.types[row.types + row.params + offset])
. errors-start = scratch.types.mark
for offset in 0 .. < row.errors
    scratch.types.push(cache.types[row.types + row.params + row.args + offset])
. args = scratch.types.span(args-start, row.args)
= Signature(params, variables, args, row.returns, scratch.types.since(errors-start))

━━━━━━━━━━━━━━━━━━━━
_ do remember
    - types Types
    - signature Signature

` A signature that named every type is kept. One that failed is evaluated again, so its fault
` is raised again for whoever reports it.
. clean = !types.fault && signature.returns != invalid-type
for type in signature.variables
    if type == invalid-type
        clean = false
for type in signature.args
    if type == invalid-type
        clean = false
for type in signature.errors
    if type == invalid-type
        clean = false
if !clean
    =
. cache = types.scratch.signatures
. names U32 = cache.names.length as U32
. kept U32 = cache.types.length as U32
for name in signature.params
    cache.names += name
for type in signature.variables
    cache.types += type
for type in signature.args
    cache.types += type
for type in signature.errors
    cache.types += type
. params U32 = signature.params.length as U32
. args U32 = signature.args.length as U32
. errors U32 = signature.errors.length as U32
cache.keep(CachedSignature(names, kept, params, args, errors, signature.returns))

━━━━━━━━━━━━━━━━━━━━
_ do argument-type TypeId
    - types Types
    - module ModuleId
    - tree AST
    - constructed DeclId
    - shape ArgumentShape
    - env TypeEnv

. program = types.program
. written = written-argument-type(types, module, tree, constructed, shape)
if written != 0
    = types.evaluate-type(module, tree, written, env)
. name = pattern-name(types, tree, shape.pattern)
if !name
    = types.evaluate-type(module, tree, shape.pattern, env)
. bound = types.env-lookup(env, name)
if bound
    = bound
= invalid-type

━━━━━━━━━━━━━━━━━━━━
+ is-implicit-argument Bool
    - types Types
    - module ModuleId
    - tree AST
    - constructed DeclId
    - shape ArgumentShape

written-argument-type(types, module, tree, constructed, shape) == 0 && named-pattern

.. named-pattern = pattern-name(types, tree, shape.pattern) != null

━━━━━━━━━━━━━━━━━━━━
+ do written-argument-type SyntaxId
    - types Types
    - module ModuleId
    - tree AST
    - constructed DeclId
    - shape ArgumentShape

=? shape.type-syntax if shape.type-syntax != 0 || constructed == 0
. name = pattern-name(types, tree, shape.pattern)
if !name
    = 0
. property = owner-property(types.program, module, constructed, name)
if property == 0
    = 0
match? types.program.modules[module].decls[property]
    | .decl-property(row)
        if !row.is-lazy
            = row.type-syntax
= 0

━━━━━━━━━━━━━━━━━━━━
+ constructed-class DeclId
    - function FunctionDecl

if is-constructor-kind(function.kind) then function.owner else 0

━━━━━━━━━━━━━━━━━━━━
+ do implicit-argument-count U32
    - types Types
    - module ModuleId
    - decl DeclId

. program = types.program
. owner-module = program.modules[module]
. count = 0u32
match? owner-module.decls[decl]
    | .decl-function(row)
        for shape in owner-module.arg-pool[row.args]
            if is-implicit-argument(types, module, owner-module.tree, constructed-class(row), shape)
                count += 1
= count

━━━━━━━━━━━━━━━━━━━━
+ do pattern-name Atom?
    - types Types
    - tree AST
    - pattern SyntaxId

if pattern == 0
    = null
match? tree.nodes[pattern]
    | .node-type-capture(row)
        = types.type-syntax-name(tree, row.id)
= types.type-syntax-name(tree, pattern)

━━━━━━━━━━━━━━━━━━━━
+ do owner-property DeclId
    - program Program
    - module ModuleId
    - owner DeclId
    - name Atom

if owner == 0
    = 0
. owner-module = program.modules[module]
. members = RowRange'DeclId()
match? owner-module.decls[owner]
    | .decl-class(row)
        members = row.members
    | .decl-extension(row)
        if row.facet
            members = row.members
for member in owner-module.members-named(members, name)
    match? owner-module.decls[member]
        | .decl-property(row)
            if row.name && row.name == name
                = member
= 0

━━━━━━━━━━━━━━━━━━━━
+ do valued-property DeclId
    - program Program
    - module ModuleId
    - owner DeclId
    - name Atom

` The declaration of a property of a name in a class that writes its value: the first that
` has one, as a root `<This` gives a value to a property the class declares with none, or
` else the first.
. first = owner-property(program, module, owner, name)
if first == 0
    = 0
. owner-module = program.modules[module]
. members = match owner-module.decls[owner]
    | .decl-class(row)
        row.members
    | .decl-extension(row)
        row.members
    ??
        RowRange'DeclId()
for member in owner-module.members-named(members, name)
    match? owner-module.decls[member]
        | .decl-property(property)
            if property.name && property.name == name && property.value != 0
                = member
= first

━━━━━━━━━━━━━━━━━━━━
+ do literal-type TypeId
    - types Types
    - module ModuleId
    - tree AST
    - syntax SyntaxId
    - env TypeEnv

. program = types.program
match? tree.nodes[syntax]
    | .node-integer-syntax(row)
        if row.unit
            = types.type-named(module, row.unit, env)
        = types.type-row(.int64)
    | .node-float-syntax(row)
        if row.unit
            = types.type-named(module, row.unit, env)
        = types.f64-type
    | .node-string-syntax
        = types.string-type
    | .node-identifier(row)
        if row.name == types.true-atom! || row.name == types.false-atom!
            = types.bool-type
        if row.name == types.null-atom!
            = types.null-type
        = global-default-type(types, module, tree, row.name, env)
    | .node-symbol(row)
        = symbol-class(types, module, row.name)
    | .node-unary-expression(row)
        if row.op == .negative-op
            = literal-type(types, module, tree, row.operand, env)
    | .node-call-expression(row)
        . name = types.type-syntax-name(tree, row.callable)
        match? tree.nodes[row.callable]
            | .node-type-arguments
                if name
                    = types.evaluate-type(module, tree, row.callable, env)
        if name
            = types.type-named(module, name, env)
    | .node-get-expression(get)
        = static-member-type(types, module, tree, get.object, get.name, env)
= invalid-type

━━━━━━━━━━━━━━━━━━━━
_ do global-default-type TypeId
    - types Types
    - module ModuleId
    - tree AST
    - name Atom
    - env TypeEnv

. program = types.program
for candidate in program.lookup(module, name)
    . target = program.modules[candidate.module]
    match? target.decls[candidate.decl]
        | .decl-property(property)
            if property.owner != 0
                continue
            if property.type-syntax != 0
                = types.evaluate-type(candidate.module, target.tree, property.type-syntax, env)
            if property.value != 0
                = literal-type(types, candidate.module, target.tree, property.value, env)
            = invalid-type
= invalid-type

━━━━━━━━━━━━━━━━━━━━
_ do static-member-type TypeId
    - types Types
    - module ModuleId
    - tree AST
    - object SyntaxId
    - name Atom
    - env TypeEnv

. owner-name = types.type-syntax-name(tree, object)
if !owner-name
    = invalid-type
. owner = types.type-named(module, owner-name, env)
if owner == invalid-type
    = invalid-type
types.complete(owner)
. found = types.property-named(owner, name)
if found
    . property = types.properties[found]
    if property.type != no-type
        = property.type
    = invalid-type
= owner

━━━━━━━━━━━━━━━━━━━━
_ do table-arguments Size
    - types Types
    - module ModuleId
    - kind DeclKind
    - env TypeEnv

. program = types.program
if is-index-span-constructor-kind(kind)
    types.scratch.types.push(types.type-named(module, program.store-atom("Source"), env))
    if kind == .index-span-source-constructor-decl
        = 1
    . mark = types.scratch.types.mark
    types.scratch.types.push(types.type-named(module, program.store-atom("Bounds"), env))
    . range = types.range-decl
    types.scratch.types.push(types.intern-class(range.module, range.decl, mark))
    = 2
. size = types.size-type
. arena-mark = types.scratch.types.mark
. arena = types.intern-class(types.arena-decl.module, types.arena-decl.decl, arena-mark)
if kind == .table-size-constructor-decl
    types.scratch.types.push(size)
    = 1
if kind == .table-arena-constructor-decl
    types.scratch.types.push(arena)
    = 1
if kind == .table-capacity-constructor-decl
    types.scratch.types.push(arena)
    types.scratch.types.push(size)
    = 2
types.scratch.types.push(size)
. row = types.type-named(module, program.store-atom("Row"), env)
. index = types.index-type
. mark = types.scratch.types.mark
types.scratch.types.push(index)
. errors = types.scratch.types.mark
types.scratch.types.push(types.intern-function(row, false, mark, errors))
= 2

━━━━━━━━━━━━━━━━━━━━
+ do declared-argument TypeId
    - types Types
    - given TypeId
    - position U32

` The type a closure or a bound function declares for an argument, which a parameter of a
` function type infers its own open argument types from, and which a closure made a value
` of a function type takes whatever the type gives it.
. module = 0u32
. decl = 0u32
. object = no-type
. held = 0u32
match? types.rows[given]
    | .type-closure(row)
        module = row.module
        decl = row.decl
    | .type-binding(row)
        module = row.module
        decl = row.decl
        object = row.object
        held = row.items.count - row.param-count
if decl == 0
    = no-type
. scratch = types.scratch
. names-mark = scratch.names.mark
. items-mark = scratch.types.mark
. signature = signature-into(types, module, decl, no-type-arguments(types), object, true)
. slot = position + held
. declared = if slot < signature.args.length then signature.args[slot] else no-type
scratch.types.rewind(items-mark)
scratch.names.rewind(names-mark)
if declared == no-type || declared == invalid-type
    = no-type
= if types.completions[declared].has-variables then no-type else declared

━━━━━━━━━━━━━━━━━━━━
+ function-signature Signature
    - types Types
    - module ModuleId
    - decl DeclId

` The signature of a declaration on its own, with no receiver and no bindings. The spans are
` runs on the scratch stacks; the caller marks before and rewinds after reading them.
signature-into(types, module, decl, no-type-arguments(types), no-type, false)

━━━━━━━━━━━━━━━━━━━━
+ is-constructor-kind Bool
    - kind DeclKind

|? kind == .constructor-decl || kind == .default-constructor-decl
    true
|? kind == .cast-constructor-decl || kind == .tuple-constructor-decl
    true
??
    is-table-constructor-kind(kind)

━━━━━━━━━━━━━━━━━━━━
+ no-type-arguments TypeArguments
    - types Types

TypeArguments(types.scratch.no-names, types.scratch.no-types)

━━━━━━━━━━━━━━━━━━━━
_ do name-in-span Bool
    - names ImmutableArray'Atom'ArenaBacking
    - name Atom

for candidate in names
    if candidate == name
        = true
= false

━━━━━━━━━━━━━━━━━━━━
_ do owner-instance TypeId
    - types Types
    - module ModuleId
    - owner DeclId
    - receiver TypeId

` The receiver seen as the class that declares a member: the receiver itself or the base of
` that class, or the interface of it the receiver implements.
. current = receiver
while true
    match? types.rows[current]
        | .type-class(row)
            if row.module == module && row.decl == owner
                = current
    . base = types.base-of(current)
    if !base
        break
    current = base
current = receiver
while current != no-type
    . found = implemented-interface(types, current, module, owner)
    if found != no-type
        = found
    current = types.base-of(current) ?? no-type
= receiver

━━━━━━━━━━━━━━━━━━━━
+ do bind-receiver TypeEnv
    - types Types
    - module ModuleId
    - owner DeclId
    - receiver TypeId
    - env TypeEnv

` The environment of a member read with its receiver known: the parameters of its class
` bound from the receiver, or, for an extension, the names its pattern declares.
. program = types.program
. bound = env
match? program.modules[module].decls[owner]
    | .decl-class(row)
        . args = RowRange'TypeId()
        match? types.rows[owner-instance(types, module, owner, receiver)]
            | .type-class(actual)
                args = actual.args
        for position in 0 .. < args.count
            if position < row.type-args.count
                . tree = program.modules[module].tree
                . type-args = row.type-args
                . name = types.class-param-name(tree, type-args, position)
                if name
                    bound = types.env-bind(bound, name, types.child-type(args, position))
        bound = types.env-with-this(bound, receiver)
    | .decl-extension(row)
        . tree = program.modules[module].tree
        . actual-args = RowRange'TypeId()
        match? types.rows[receiver]
            | .type-class(actual)
                actual-args = actual.args
        match? tree.nodes[row.receiver]
            | .node-type-arguments(pattern)
                . position = 0
                for child in tree.children[pattern.args]
                    match? tree.nodes[child]
                        | .node-type-identifier(name-row)
                            if name-row.is-declare && position < actual-args.count
                                . actual = types.child-type(actual-args, position as U32)
                                bound = types.env-bind(bound, name-row.name, actual)
                    position += 1
        bound = types.env-with-this(bound, receiver)
= bound

━━━━━━━━━━━━━━━━━━━━
+ do symbol-class TypeId
    - types Types
    - module ModuleId
    - name Atom

` The type a case named by its symbol alone is of, where nothing else says: the last of the
` types the module can name that have the case.
. found [TypeId]
symbol-owners(types, module, name, found)
if found.length == 0
    = invalid-type
= found[found.length - 1]

━━━━━━━━━━━━━━━━━━━━
+ do symbol-owners
    - types Types
    - module ModuleId
    - name Atom
    - found [TypeId]

` Every type a module can name that has a case or value of this name, as the reference lists
` them: those of the modules it imports, and then its own, each module's in the order they
` are declared.
. program = types.program
. count = program.modules.length
. ordered [Size]
for _ in 0 .. < count
    ordered += Size.max
for position in 0 .. < count
    . owner Index = position
    . place = program.listed(module, owner as ModuleId)
    if place < count
        ordered[place] = position
for position in ordered
    if position == Size.max
        continue
    module-symbol-owners(types, position, name, found)

━━━━━━━━━━━━━━━━━━━━
+ do program-symbol-class TypeId
    - types Types
    - name Atom

` The type a case named by its symbol alone is of where no type the module can name has the
` case: the last of the program's types that have it, as the reference takes it until the type
` expected of the case settles it. Invalid where none has it.
. found [TypeId]
for position in 0 .. < types.program.modules.length
    module-symbol-owners(types, position, name, found)
if found.length == 0
    = invalid-type
= found[found.length - 1]

━━━━━━━━━━━━━━━━━━━━
_ do module-symbol-owners
    - types Types
    - position Size
    - name Atom
    - found [TypeId]

. owner Index = position
. owner-module = types.program.modules[position]
for decl in owner-module.decls
    match? decl
        | .decl-case(row)
            if row.name && row.name == name && row.owner != 0
                match? owner-module.decls[row.owner]
                    | .decl-class
                        . mark = types.scratch.types.mark
                        . type = types.class-with-args(owner as ModuleId, row.owner, mark)
                        if type != invalid-type && found.find(type) == null
                            found += type

━━━━━━━━━━━━━━━━━━━━
+ do interface-default-owner TypeId
    - types Types
    - program Program
    - module ModuleId
    - decl DeclId
    - self TypeId

` The interface a function that an interface declares with a body sees its receiver as,
` where that is an object of a class. No type for a getter or a setter, which the reference
` runs with the object itself, as it runs every such function for a value that is no object.
if self == no-type || self == invalid-type
    = no-type
. owner = 0u32
match? program.modules[module].decls[decl]
    | .decl-function(fn)
        owner = fn.owner
        if fn.kind == .getter-decl || fn.kind == .setter-decl
            = no-type
if owner == 0 || types.intrinsic-of(self) != .class
    = no-type
. current = self
while current != no-type
    match? types.rows[current]
        | .type-class(row)
            if row.module == module && row.decl == owner
                = no-type
    . found = implemented-interface(types, current, module, owner)
    if found != no-type
        = found
    current = types.base-of(current) ?? no-type
= no-type

━━━━━━━━━━━━━━━━━━━━
_ do implemented-interface TypeId
    - types Types
    - level TypeId
    - module ModuleId
    - owner DeclId

for interface in types.interfaces-of(level)
    match? types.rows[interface]
        | .type-class(row)
            if row.module == module && row.decl == owner
                = interface
    . parent = implemented-interface(types, interface, module, owner)
    if parent != no-type
        = parent
= no-type

