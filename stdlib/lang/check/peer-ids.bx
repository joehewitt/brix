(import ./binding)
(import ./instances)
(import ./stable-key)
(import ./type-store)
(import ./types)
(import /lang/ast/ast-nodes)
(import /lang/ast/decl)
(import /lang/ast/module)
(import /lang/ast/row-range)

(type + PeerIds
  ; What the ids another type pass over the same program gave its types, instances, properties,
  ; style contexts, bindings and their slots stand for in this pass, which interns each
  ; here the first time it is asked for. The peer `owns` an instance whose body it typed where no pass before it
  ; did: this pass takes what is known of that instance from the peer. Each id is checked against
  ; the stable key the peer gave it, so one that stands for something else here stops the compile.
  ; `calls` and `transforms` number here the peer's call and transform facts this pass takes in.
  (blank)
  (prop + types Types)
  (prop + instances Instances)
  (prop + bindings Bindings)
  (prop + peer-types Types)
  (prop + peer-instances Instances)
  (prop + peer-bindings Bindings)
  (prop + owned (list Bool))
  (prop + calls (list U32))
  (prop + transforms (list U32))
  (prop _ type-map (list U32))
  (prop _ instance-map (list U32))
  (prop _ binding-map (list U32))
  (prop _ context-map (list U32))
  (prop _ frame-map (list U32))
  (prop _ property-owners (list TypeId))
  (fn-do + This _
    (param types Types)
    (param instances Instances)
    (param bindings Bindings)
    (param peer-types Types)
    (param peer-instances Instances)
    (param peer-bindings Bindings)
    (param owned (list Bool))
    (for (in _ (..< 0 (. peer-types rows length)))
      (+= type-map 0)
    )
    (for (in _ (..< 0 (. peer-instances rows length)))
      (+= instance-map 0)
    )
    (for (in _ (..< 0 (. peer-bindings bindings length)))
      (+= binding-map 0)
    )
  )
  (fn-expr + owns Bool
    (param instance InstanceId)
    ; Whether this pass takes what is known of a peer's instance from the peer.
    (and (!= instance no-instance) ([] owned instance))
  )
  (fn-do + type TypeId
    (param id TypeId)
    ; The type here that is the peer's `id`.
    (if (or (== id no-type) (== id invalid-type))
      (return id)
    )
    (let known ([] type-map id))
    (if (!= known 0)
      (return (- known 1))
    )
    (let made (call make-type id))
    (throw (call Panic "A type of another type pass is another type here") (if (!= ([] (. types stable-keys) made) ([] (. peer-types stable-keys) id))))
    (blank)
    (= ([] type-map id) (+ made 1))
    (return made)
  )
  (fn-do _ make-type TypeId
    (param id TypeId)
    (let stack (. types scratch types))
    (match ([] (. peer-types rows) id)
      (case .type-invalid
        (return invalid-type)
      )
      (case (call .type-class row)
        (let mark (. stack mark))
        (call push-range (. row args))
        (let errors-mark (. stack mark))
        (call push-range (. row errors))
        (return (call (. types intern-raising-class) (. row module) (. row decl) mark errors-mark))
      )
      (case (call .type-variable row)
        (return (call (. types intern-variable) (. row module) (. row decl) (. row index) (. row name)))
      )
      (case (call .type-inference row)
        (return (call (. types intern-inference) (. row scope) (. row ordinal)))
      )
      (case (call .type-tuple row)
        (let mark (. stack mark))
        (let names-mark (. types scratch names mark))
        (call push-fields (. row fields) (. row names))
        (return (call (. types intern-tuple) mark names-mark))
      )
      (case (call .type-struct row)
        (let mark (. stack mark))
        (let names-mark (. types scratch names mark))
        (call push-fields (. row fields) (. row names))
        (return (call (. types intern-struct) mark names-mark))
      )
      (case (call .type-union row)
        (let mark (. stack mark))
        (call push-range (. row cases))
        (return (call (. types intern-union) mark))
      )
      (case (call .type-named-union row)
        (let mark (. stack mark))
        (let names-mark (. types scratch names mark))
        (call push-fields (. row cases) (. row names))
        (return (call (. types intern-named-union) (. row owner) mark names-mark (. row made-in) (. row made-at)))
      )
      (case (call .type-function row)
        (let returns (call type (. row return-type)))
        (let mark (. stack mark))
        (call push-range (. row args))
        (let errors-mark (. stack mark))
        (call push-range (. row errors))
        (return (call (. types intern-function) returns (. row is-c) mark errors-mark))
      )
      (case (call .type-result row)
        (let value (call type (. row value)))
        (let mark (. stack mark))
        (call push-range (. row errors))
        (return (call (. types intern-ordered-result) value mark))
      )
      (case (call .type-associated row)
        (let owner (call type (. row owner)))
        (let mark (. stack mark))
        (call push-range (. row args))
        (return (call (. types intern-associated) owner (call DeclRef (. row module) (. row decl)) (. row name) mark))
      )
      (case (call .type-closure row)
        (let enclosing (call instance (. row enclosing)))
        (return (call (. types intern-closure) (. row module) (. row decl) enclosing ([] (. instances stable-keys) enclosing)))
      )
      (case (call .type-binding row)
        (let object (call type (. row object)))
        (let mark (. stack mark))
        (call push-range (. row items))
        (return
          (call (. types intern-binding)
            (block
              (arg (. row form))
              (arg (. row scope))
              (arg (. row module))
              (arg (. row decl))
              (arg object)
              (arg (. row param-count))
              (arg mark)
            )
          )
        )
      )
    )
  )
  (fn-do _ push-range _
    (param range (of RowRange TypeId))
    (for (in offset (..< 0 (. range count)))
      (let child (call type (call (. peer-types child-type) range offset)))
      (call (. types scratch types push) child)
    )
  )
  (fn-do _ push-fields _
    (param fields (of RowRange TypeId))
    (param names (of RowRange Atom))
    (for (in offset (..< 0 (. fields count)))
      (let child (call type (call (. peer-types child-type) fields offset)))
      (call (. types scratch names push) (call (. peer-types child-name) names offset))
      (call (. types scratch types push) child)
    )
  )
  (fn-do + instance InstanceId
    (param id InstanceId)
    ; The instance here that is the peer's `id`, queued here where the peer queued it, unless it is
    ; typed only in the run of another (`runs-inline`). The value of a property made here is given
    ; the type the read that first asked for it there stated for it, as a read here would.
    (if (== id no-instance)
      (return id)
    )
    (let known ([] instance-map id))
    (if (!= known 0)
      (return (- known 1))
    )
    (let made (call make-instance id))
    (throw (call Panic "An instance of another type pass is another instance here") (if (!= ([] (. instances stable-keys) made) ([] (. peer-instances stable-keys) id))))
    (blank)
    (let row ([] (. peer-instances rows) id))
    (if (and (. row queued) (not (call runs-inline row)))
      (call (. instances queue) made)
    )
    (= ([] instance-map id) (+ made 1))
    (return made)
  )
  (fn-do _ make-instance InstanceId
    (param id InstanceId)
    (let row ([] (. peer-instances rows) id))
    (throw (call Panic "An instance typed on trial cannot be shared between type passes") (if (!= (. row probe) 0)))
    (blank)
    (let styled (call style-context (. row context)))
    (if (!= (. row root-values) 0)
      (return (call (. instances intern-root-values) (. row module) (call type (. row self-type)) (. row root-values) styled))
    )
    (if (!= (. row initializer) 0)
      (let value
        (call (. instances intern-initializer)
          (block
            (arg (. row module))
            (arg (. row initializer))
            (arg (call type (. row self-type)))
            (arg (call type (. row element)))
            (arg styled)
          )
        )
      )
      (if (== (. ([] (. instances rows) value) state) .instance-unstarted)
        (= (. ([] (. instances signatures) value) declared-returns)
          (call type
            (block
              (arg (. ([] (. peer-instances signatures) id) declared-returns))
            )
          )
        )
      )
      (return value)
    )
    (if (. row compares)
      (return (call (. instances intern-equality) (. row module) (call type (. row self-type))))
    )
    (let self-type (call type (. row self-type)))
    (let enclosing (call instance (. row enclosing)))
    (let row-receiver (call type (. row row-receiver)))
    (let helper (call type (. row helper)))
    (let inherits (call instance (. row inherits)))
    (let signature ([] (. peer-instances signatures) id))
    (let stack (. types scratch types))
    (let mark (. stack mark))
    (for (in position (..< (- (. signature args start) (. signature param-count)) (+ (. signature args start) (. signature args count))))
      (let translated (call type ([] (. peer-instances signature-types) position)))
      (call (. stack push) translated)
    )
    (let params (call (. stack span) mark (. signature param-count)))
    (let args (call (. stack span) (+ mark (. signature param-count)) (. signature args count)))
    (let words (. types scratch words))
    (let fills-mark (. words mark))
    (for (in offset (..< 0 (. row fills count)))
      (let place (call property ([] (. peer-instances fill-places) (+ (. row fills start) offset))))
      (call (. words push) place)
    )
    (let fills (call (. words since) fills-mark))
    (let slots-mark (. words mark))
    (for (in offset (..< 0 (. row slots count)))
      (let slot ([] (. peer-instances slot-places) (+ (. row slots start) offset)))
      (call (. words push) (call (. instances slot-id) ([] (. peer-instances slot-atoms) slot)))
    )
    (let slots (call (. words since) slots-mark))
    (let made
      (call (. instances intern)
        (block
          (arg (. row module))
          (arg (. row decl))
          (arg self-type)
          (arg (call swap-effects (. row effects)))
          (arg enclosing)
          (arg params)
          (arg args)
          (arg false)
          (arg row-receiver)
          (arg (. row row-case))
          (arg (. row row-validated))
          (arg 0)
          (arg helper)
          (arg fills)
          (arg slots)
          (arg styled)
          (arg (. row zone))
          (arg inherits)
          (arg (. row redefaults))
          (arg (. row spans))
          (arg (. row encoded))
        )
      )
    )
    (call (. words rewind) fills-mark)
    (call (. stack rewind) mark)
    (return made)
  )
  (fn-do + swap-effects EffectMask
    (param effects EffectMask)
    ; A peer's mask with the fakes it binds, which the peer numbers in its own sets, numbered here.
    (let set (call swap-set-of effects))
    (return-if effects (if (== set 0)))
    (blank)
    (let given peer-instances)
    (let entries (list U32))
    (let start ([] (. given swap-set-starts) (- set 1)))
    (for (in position (..< start (+ start ([] (. given swap-set-counts) (- set 1)))))
      (+= entries (call swap-entry ([] (. given swap-set-entries) position)))
    )
    (return (call with-swap-set effects (call (. instances intern-swap-set) entries)))
  )
  (fn-do + swap-entry U32
    (param entry U32)
    ; The fake bound to an effect here that is the peer's entry `entry` among its `swap-entries`, or 0
    ; for none.
    (return-if 0 (if (== entry 0)))
    (blank)
    (let held ([] (. peer-instances swap-entries) (- entry 1)))
    (return (call (. instances intern-swap-entry) (call SwapEntry (. held effect) (call type (. held fake)))))
  )
  (fn-do + style-context U32
    (param id U32)
    ; The style context here that is the peer's context `id`: the same styles, style sheets and rules
    ; written in rules, in their order, with what each is given (`Instances.intern-context`).
    (if (== id (. U32 max))
      (return id)
    )
    (while (<= (. context-map length) id)
      (+= context-map 0)
    )
    (let known ([] context-map id))
    (if (!= known 0)
      (return (- known 1))
    )
    (let given peer-instances)
    (let held ([] (. given contexts) id))
    (let styles (list TypeId))
    (let sheets (list TypeId))
    (let levels (list U32))
    (for (in position (..< (. held first) (+ (. held first) (. held styles))))
      (+= styles (call type ([] (. given context-types) position)))
    )
    (for (in position (..< (+ (. held first) (. held styles)) (+ (. held first) (. held styles) (. held sheets))))
      (+= sheets (call type ([] (. given context-types) position)))
      (+= levels ([] (. given context-levels) position))
    )
    (let scopes (list RuleScope))
    (let cells (list U32))
    (let valued (list U32))
    (for (in position (..< (. held scope-first) (+ (. held scope-first) (. held scopes))))
      (let scope ([] (. given context-scopes) position))
      (+= scopes (call RuleScope (. scope module) (. scope decl) (call type (. scope owner)) (call frame (. scope frames)) (. scope own)))
      (+= cells ([] (. given context-cells) position))
      (+= valued ([] (. given context-valued) position))
    )
    (let value-types (list TypeId))
    (for (in position (..< (. held value-first) (+ (. held value-first) (. held values))))
      (+= value-types (call type ([] (. given context-value-types) position)))
    )
    (let made
      (call (. instances intern-context)
        (block
          (arg styles)
          (arg sheets)
          (arg levels)
          (arg scopes)
          (arg cells)
          (arg (call type (. held made)))
          (arg (. held layer))
          (arg valued)
          (arg value-types)
        )
      )
    )
    (= ([] context-map id) (+ made 1))
    (return made)
  )
  (fn-do + frame U32
    (param id U32)
    ; The frame here of the style rule the peer's frame `id` applies, and of those around it.
    (if (== id (. U32 max))
      (return id)
    )
    (while (<= (. frame-map length) id)
      (+= frame-map 0)
    )
    (let known ([] frame-map id))
    (if (!= known 0)
      (return (- known 1))
    )
    (let held ([] (. peer-instances frames) id))
    (let made
      (call (. instances intern-frame)
        (block
          (arg (call frame (. held outer)))
          (arg (. held module))
          (arg (. held decl))
          (arg (call type (. held owner)))
          (arg (. held gate))
        )
      )
    )
    (= ([] frame-map id) (+ made 1))
    (return made)
  )
  (fn-do + property U32
    (param place U32)
    ; The place here of the property at a peer's `place` among the properties of every type.
    (if (== place (. U32 max))
      (return place)
    )
    (let owner (call property-owner place))
    (let master (call type owner))
    (call (. types complete) master)
    (let offset (- place (. ([] (. peer-types completions) owner) properties start)))
    (let found (+ (. ([] (. types completions) master) properties start) offset))
    (throw (call Panic "A property of another type pass is another property here") (if (!= (. ([] (. types properties) found) name) (. ([] (. peer-types properties) place) name))))
    (return found)
  )
  (fn-do _ property-owner TypeId
    (param place U32)
    (if (== (. property-owners length) 0)
      (for (in _ (..< 0 (. peer-types properties length)))
        (+= property-owners no-type)
      )
      (for (in id (..< 0 (. peer-types completions length)))
        (let range (. ([] (. peer-types completions) id) properties))
        (for (in offset (..< 0 (. range count)))
          (= ([] property-owners (+ (. range start) offset)) (as id TypeId))
        )
      )
    )
    (let owner ([] property-owners place))
    (throw (call Panic "A property of another type pass belongs to no type there") (if (== owner no-type)))
    (return owner)
  )
  (fn-do + binding BindingId
    (param id BindingId)
    ; The binding here of the declaration the peer's binding `id` binds, copied from the peer first
    ; (`Bindings.take`).
    (if (== id no-binding)
      (return id)
    )
    (let known ([] binding-map id))
    (if (!= known 0)
      (return (- known 1))
    )
    (let made (call (. bindings take) peer-bindings id))
    (= ([] binding-map id) (+ made 1))
    (return made)
  )
  (fn-do + slot SlotId
    (param id SlotId)
    ; The slot here that is the peer's slot `id`, among the slots of the binding that declares it.
    (if (== id no-slot)
      (return id)
    )
    (let low U32)
    (let high U32 (as (. peer-bindings bindings length) U32))
    (while (> (- high low) 1)
      (let middle (+ low (/ (- high low) 2)))
      (if (<= (. ([] (. peer-bindings bindings) middle) slots start) id)
        (= low middle)
        (else
          (= high middle)
        )
      )
    )
    (let peer ([] (. peer-bindings bindings) low))
    (throw (call Panic "A slot of another type pass belongs to none of its bindings") (if (or (< id (. peer slots start)) (>= id (+ (. peer slots start) (. peer slots count))))))
    (blank)
    (let found (- (+ (. ([] (. bindings bindings) (call binding low)) slots start) id) (. peer slots start)))
    (throw (call Panic "A slot of another type pass is another slot here") (if (or (!= (. ([] (. bindings slots) found) name) (. ([] (. peer-bindings slots) id) name)) (!= (. ([] (. bindings slots) found) syntax) (. ([] (. peer-bindings slots) id) syntax)))))
    (return found)
  )
)

(type + PeerNames
  ; Which of the types and instances of another type pass this pass can name: none typed on trial,
  ; nor any that names one through what it is made of, as a closure names the instance it is written
  ; in, or a style context the types it holds. Each is worked out the first time it is asked for.
  (blank)
  (prop _ types Types)
  (prop _ instances Instances)
  (prop _ type-states (list U8))
  (prop _ instance-states (list U8))
  (fn-do + This _
    (param types Types)
    (param instances Instances)
    (for (in _ (..< 0 (. types rows length)))
      (+= type-states 0)
    )
    (for (in _ (..< 0 (. instances rows length)))
      (+= instance-states 0)
    )
  )
  (fn-do + type-named Bool
    (param id TypeId)
    ; Whether this pass can name the type. One met again while its parts are being looked at is
    ; taken to be.
    (if (or (== id no-type) (== id invalid-type))
      (return true)
    )
    (let state ([] type-states id))
    (if (!= state 0)
      (return (!= state 2))
    )
    (= ([] type-states id) 1)
    (let named (call parts-named id))
    (= ([] type-states id) (if-expr named 1 2))
    (return named)
  )
  (fn-do + instance-named Bool
    (param id InstanceId)
    ; Whether this pass can name the instance.
    (if (== id no-instance)
      (return true)
    )
    (let state ([] instance-states id))
    (if (!= state 0)
      (return (!= state 2))
    )
    (= ([] instance-states id) 1)
    (let named (call instance-parts-named id))
    (= ([] instance-states id) (if-expr named 1 2))
    (return named)
  )
  (fn-do _ parts-named Bool
    (param id TypeId)
    (match? ([] (. types rows) id)
      (case (call .type-class row)
        (return (and (call range-named (. row args)) (call range-named (. row errors))))
      )
      (case (call .type-tuple row)
        (return (call range-named (. row fields)))
      )
      (case (call .type-struct row)
        (return (call range-named (. row fields)))
      )
      (case (call .type-union row)
        (return (call range-named (. row cases)))
      )
      (case (call .type-named-union row)
        (return (call range-named (. row cases)))
      )
      (case (call .type-function row)
        (return (and (call type-named (. row return-type)) (call range-named (. row args)) (call range-named (. row errors))))
      )
      (case (call .type-result row)
        (return (and (call type-named (. row value)) (call range-named (. row errors))))
      )
      (case (call .type-associated row)
        (return (and (call type-named (. row owner)) (call range-named (. row args))))
      )
      (case (call .type-closure row)
        (return (call instance-named (. row enclosing)))
      )
      (case (call .type-binding row)
        (return (and (call type-named (. row object)) (call range-named (. row items))))
      )
    )
    (return true)
  )
  (fn-do _ range-named Bool
    (param range (of RowRange TypeId))
    (for (in offset (..< 0 (. range count)))
      (if (not (call type-named (call (. types child-type) range offset)))
        (return false)
      )
    )
    (return true)
  )
  (fn-do _ instance-parts-named Bool
    (param id InstanceId)
    (let row ([] (. instances rows) id))
    (if (or (!= (. row probe) 0) (not (call context-named (. row context))))
      (return false)
    )
    (if (or (not (call type-named (. row self-type))) (not (call type-named (. row element))) (not (call type-named (. row row-receiver))) (not (call type-named (. row helper))))
      (return false)
    )
    (if (or (not (call instance-named (. row enclosing))) (not (call instance-named (. row inherits))))
      (return false)
    )
    (let signature ([] (. instances signatures) id))
    (for (in position (..< (- (. signature args start) (. signature param-count)) (+ (. signature args start) (. signature args count))))
      (if (not (call type-named ([] (. instances signature-types) position)))
        (return false)
      )
    )
    (return true)
  )
  (fn-do _ context-named Bool
    (param id U32)
    (if (== id (. U32 max))
      (return true)
    )
    (let held ([] (. instances contexts) id))
    (for (in position (..< (. held first) (+ (. held first) (. held styles) (. held sheets))))
      (if (not (call type-named ([] (. instances context-types) position)))
        (return false)
      )
    )
    (for (in position (..< (. held scope-first) (+ (. held scope-first) (. held scopes))))
      (let scope ([] (. instances context-scopes) position))
      (if (not (call type-named (. scope owner)))
        (return false)
      )
      (let frame (. scope frames))
      (while (!= frame (. U32 max))
        (if (not (call type-named (. ([] (. instances frames) frame) owner)))
          (return false)
        )
        (= frame (. ([] (. instances frames) frame) outer))
      )
    )
    (for (in position (..< (. held value-first) (+ (. held value-first) (. held values))))
      (if (not (call type-named ([] (. instances context-value-types) position)))
        (return false)
      )
    )
    (return (call type-named (. held made)))
  )
)
