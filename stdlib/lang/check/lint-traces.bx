(import ./instances)
(import ./peer-ids)
(import ./types)
(import /core/arena)
(import /core/table)
(import /lang/ast/ast-nodes)
(import /lang/ast/decl)

(type + DeclaredValueFact (is Struct)
  ; A value written with the type it is declared as: a local's, where `pattern` names it, or the
  ; value of `property` of the instance's module. `declared` is the type as written, and `found`
  ; the type of the value.
  (blank)
  (prop + instance InstanceId)
  (prop + pattern SyntaxId)
  (prop + property DeclId)
  (prop + value SyntaxId)
  (prop + annotation SyntaxId)
  (prop + declared TypeId)
  (prop + found TypeId)
)

(type + ContextCastKind (is U32)
  (variant cast-argument (= 0))
  (variant cast-return (= 1))
  (variant cast-assignment (= 2))
  (variant cast-pattern (= 3))
  (variant cast-operand (= 4))
)

(type + ContextCastFact (is Struct)
  ; A cast to the type the place it is written already takes it as: the value of a return, of an
  ; assignment to a variable or of a declaration written with that type, or an argument a call
  ; takes as that type, where the call chooses the same function without the cast (`kind`).
  ; `target` is the type cast to. A number written with a suffix is such a cast where the place,
  ; or the other operand of an operation (`cast-operand`), gives the number that type unsuffixed.
  (blank)
  (prop + instance InstanceId)
  (prop + syntax SyntaxId)
  (prop + kind ContextCastKind)
  (prop + target TypeId)
)

(type + PayloadEffectKind (is U32)
  (variant effect-call (= 0))
  (variant effect-assignment (= 1))
  (variant effect-channel-write (= 2))
)

(type + PayloadEffectFact (is Struct)
  ; An effect the payload of an event has where it is published (`payload`), as the reference finds
  ; it as it makes the payload, which it does only where something listens.
  (blank)
  (prop + instance InstanceId)
  (prop + payload SyntaxId)
  (prop + event Atom)
  (prop + kind PayloadEffectKind)
)

(type + CaseOwnerFact (is Struct)
  ; A type of which a case given to a call by its symbol alone (`syntax`) is taken by a function
  ; the call may choose, where functions it may choose take it as a case of more than one type, and
  ; whether that type is the one the function chosen takes.
  (blank)
  (prop + instance InstanceId)
  (prop + syntax SyntaxId)
  (prop + name Atom)
  (prop + owner TypeId)
  (prop + chosen Bool)
)

(type + LintTraces
  (prop + traces Bool)
  (prop + declared-values (of Table DeclaredValueFact))
  (prop + context-casts (of Table ContextCastFact))
  (prop + payload-effects (of Table PayloadEffectFact))
  (prop + case-owners (of Table CaseOwnerFact))
  (fn-do + This _
    (param arena Arena)
    (lazy declared-values (call (of Table DeclaredValueFact) arena 16))
    (lazy context-casts (call (of Table ContextCastFact) arena 16))
    (lazy payload-effects (call (of Table PayloadEffectFact) arena 16))
    (lazy case-owners (call (of Table CaseOwnerFact) arena 16))
  )
  (fn-do + absorb _
    (param peer LintTraces)
    (param ids PeerIds)
    (for (in row (. peer declared-values))
      (if (call (. ids owns) (. row instance))
        (let fact (as row DeclaredValueFact))
        (= (. fact instance) (call (. ids instance) (. row instance)))
        (= (. fact declared) (call (. ids type) (. row declared)))
        (= (. fact found) (call (. ids type) (. row found)))
        (call (. declared-values append) fact)
      )
    )
    (for (in row (. peer context-casts))
      (if (call (. ids owns) (. row instance))
        (let fact (as row ContextCastFact))
        (= (. fact instance) (call (. ids instance) (. row instance)))
        (= (. fact target) (call (. ids type) (. row target)))
        (call (. context-casts append) fact)
      )
    )
    (for (in row (. peer payload-effects))
      (if (call (. ids owns) (. row instance))
        (let fact (as row PayloadEffectFact))
        (= (. fact instance) (call (. ids instance) (. row instance)))
        (call (. payload-effects append) fact)
      )
    )
    (for (in row (. peer case-owners))
      (if (call (. ids owns) (. row instance))
        (let fact (as row CaseOwnerFact))
        (= (. fact instance) (call (. ids instance) (. row instance)))
        (= (. fact owner) (call (. ids type) (. row owner)))
        (call (. case-owners append) fact)
      )
    )
  )
  (fn-do + fold _
    (param mains (list InstanceId))
    (for (in position (..< 0 (. declared-values length)))
      (if (!= ([] mains (. ([] declared-values position) instance)) no-instance)
        (= (. ([] declared-values position) instance) ([] mains (. ([] declared-values position) instance)))
      )
    )
    (for (in position (..< 0 (. context-casts length)))
      (if (!= ([] mains (. ([] context-casts position) instance)) no-instance)
        (= (. ([] context-casts position) instance) ([] mains (. ([] context-casts position) instance)))
      )
    )
    (for (in position (..< 0 (. payload-effects length)))
      (if (!= ([] mains (. ([] payload-effects position) instance)) no-instance)
        (= (. ([] payload-effects position) instance) ([] mains (. ([] payload-effects position) instance)))
      )
    )
    (for (in position (..< 0 (. case-owners length)))
      (if (!= ([] mains (. ([] case-owners position) instance)) no-instance)
        (= (. ([] case-owners position) instance) ([] mains (. ([] case-owners position) instance)))
      )
    )
  )
  (fn-do + retire _
    (param retired (list Bool))
    (param dead InstanceId)
    (for (in position (..< 0 (. declared-values length)))
      (if (call held-by retired (. ([] declared-values position) instance))
        (= (. ([] declared-values position) instance) dead)
      )
    )
    (for (in position (..< 0 (. context-casts length)))
      (if (call held-by retired (. ([] context-casts position) instance))
        (= (. ([] context-casts position) instance) dead)
      )
    )
    (for (in position (..< 0 (. payload-effects length)))
      (if (call held-by retired (. ([] payload-effects position) instance))
        (= (. ([] payload-effects position) instance) dead)
      )
    )
    (for (in position (..< 0 (. case-owners length)))
      (if (call held-by retired (. ([] case-owners position) instance))
        (= (. ([] case-owners position) instance) dead)
      )
    )
  )
  (fn-expr _ held-by Bool
    (param retired (list Bool))
    (param instance InstanceId)
    (and (< (as instance Size) (. retired length)) ([] retired instance))
  )
)
