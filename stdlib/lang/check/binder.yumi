────────────────────
_ syntax-subtree SyntaxRange
    - syntax SyntaxId

SyntaxRange(start, syntax - start + 1)

.. start = tree.subtree-start(syntax)

────────────────────
_ do bind-converter
    - syntax SyntaxId
    - owner DeclId
    - source SyntaxId

` A converter body reads `this`; a fromverter also binds its source pattern as an argument.
. body = 0u32
do match? tree.nodes[syntax]
    | .node-converter-syntax(row)
        body = row.body
    | .node-fromverter-syntax(row)
        body = row.body

push-scope(.scope-function, syntax)
owner-decl = owner
declare-self()
declare-pattern(source, .slot-argument, 0, 0)
walk(body)
pop-scope()

────────────────────
_ do declare-self

declare(this-name, .slot-this, 0, SlotFlag.slot-constant, 0)
declare(super-name, .slot-super, 0, SlotFlag.slot-constant, 0)

────────────────────
_ do bind-function

` Binds a function of the module: its receiver, its arguments and their defaults, then its body,
` the module's top-level lines for `main`. For the function that fills an object with its class's
` markup, the state machines written beside a root `<This` are bound around the root's lines.
. syntax = 0u32
. owner = 0u32
. is-static = false
. args = RowRange'ArgumentShape()
. body = 0u32
. is-main = false
do match? program.modules[module].decls[decl]
    | .decl-function(row)
        syntax = row.syntax
        owner = row.owner
        is-static = row.is-static
        args = row.args
        body = row.body
        is-main = row.kind == .main-decl
        if row.is-content && body != 0
            content-turns += body
            if tree.root-this(row.syntax) != 0
                class-lines = body
            if tree.nodes[row.syntax] is .node-rule-syntax
                rule-lines = body

push-scope(.scope-function, syntax)
owner-decl = owner
if owner != 0 && !is-static
    declare-self()
do match? program.modules[module].decls[decl]
    | .decl-function(row)
        if row.is-content
            fills = true
            content-home = current-scope

. shapes = program.modules[module].arg-pool
for shape in shapes[args]
    declare-pattern(shape.pattern, .slot-argument, 0, 0)
owner-decl = 0
for shape in shapes[args]
    walk(shape.default-syntax)
owner-decl = owner

if is-main
    walk-top-level(tree.root)
else if body != 0 && is-slot-builder(body)
    declare-wrapped(body)
    walk-wrapped(body)
    if fills
        walk-bound(body)
else
    . content = if fills then syntax else 0u32
    for machine in tree.root-machines(content, false)
        walk(machine)
    walk(body)
    for machine in tree.root-machines(content, true)
        walk(machine)
pop-scope()

────────────────────
_ do share-lazy-values

` A lazy local that nested functions capture is evaluated by whichever function reads it
` first, so each of them must reach what its value reads. The locals and the arguments of
` the function that declares it that the value reads are captured with it, the items of
` its loops, and the receiver where the value reads a member, and so on through the lazy
` locals among them. Those declared together with it take their values with it, and so are
` captured with it.
. first = bindings.bindings[binding].slots.start
. changed = true
while changed
    changed = false
    for slot in first .. < bindings.slots.length
        . row = bindings.slots[slot]
        if row.kind != .slot-lazy || row.group == 0 || (row.flags /and/ SlotFlag.slot-captured) == 0
            continue
        do match? tree.nodes[row.group]
            | .node-declare(declaration)
                if !declaration.is-pattern && several && share-together(first, slot as SlotId)
                    changed = true
                .. several = bindings.names-several(tree, declaration.left)
                if declaration.right != 0 && share-read(first, row.scope, right-subtree)
                    changed = true
                .. right-subtree = syntax-subtree(declaration.right)

────────────────────
_ do share-together Bool
    - first SlotId
    - slot SlotId

` Captures the lazy locals declared together with one that nested functions capture, which
` lie beside it, and says whether any was not captured before.
. group = bindings.slots[slot].group
. start = slot
while start > first && bindings.slots[start - 1].group == group
    start -= 1
. end = slot + 1
while end < bindings.slots.length && bindings.slots[end].group == group
    end += 1
. found = false
for sibling in start .. < end
    . row = bindings.slots[sibling]
    if row.kind == .slot-lazy && (row.flags /and/ SlotFlag.slot-captured) == 0
        bindings.mark-slot(sibling, SlotFlag.slot-captured)
        found = true
= found

────────────────────
_ do share-read Bool
    - first SlotId
    - scope ScopeId
    - range SyntaxRange

` Captures each local, argument and receiver of the function of a scope that a range of
` syntax reads and that is declared outside the range, and says whether any was not
` captured before. Each it captures is noted as captured for a lazy local's value alone.
. home = function-of(scope)
. found = false
for id in range.start .. < range.start + range.count
    . resolution = bindings.resolution-of(binding, id)
    . slot = no-slot
    if resolution.kind == .resolve-slot
        slot = resolution.slot
    else if resolution.kind == .resolve-member || names-method(resolution)
        slot = receiver-slot(first)
    if slot == no-slot || slot < first
        continue
    . row = bindings.slots[slot]
    if (row.flags /and/ SlotFlag.slot-captured) != 0 || function-of(row.scope) != home
        continue
    if row.syntax >= range.start && row.syntax < range.start + range.count
        continue
    . kept = row.kind == .slot-local || row.kind == .slot-argument
    . item = row.kind == .slot-loop-item || row.kind == .slot-each || row.kind == .slot-it
    if kept || item || row.kind == .slot-lazy || row.kind == .slot-this
        bindings.mark-slot(slot, SlotFlag.slot-captured /or/ SlotFlag.slot-shared-read)
        found = true
= found

────────────────────
_ do names-method Bool
    - resolution Resolution

` Whether a name resolved to a method, which is called on the receiver.
if resolution.kind != .resolve-function
    = false
do match? program.modules[resolution.module].decls[resolution.decl]
    | .decl-function(row)
        = row.owner != 0 && !row.is-static
= false

────────────────────
_ do function-of ScopeId
    - scope ScopeId

` The scope of the function or the nested function a scope lies in.
. found = scope
while bindings.scopes[found].kind != .scope-function && bindings.scopes[found].kind != .scope-nested
    found = bindings.scopes[found].parent
= found

────────────────────
_ do receiver-slot SlotId
    - first SlotId

` The slot of the receiver of the function being bound, or none.
for slot in first .. < bindings.slots.length
    if bindings.slots[slot].kind == .slot-this
        = slot as SlotId
= no-slot

────────────────────
_ do walk-top-level Void
    - id SyntaxId

do match? tree.nodes[id]
    | .node-top-level-syntax(row)
        predeclare-lazies(row.statements)
        place-elements(row.statements)
        for statement in tree.children[row.statements]
            if is-finally(statement)
                continue
            if !is-declaration-syntax(tree, statement)
                raise-element(statement)
                walk(statement)
            else
                walk-initializers(statement)
        for statement in tree.children[row.statements]
            if is-finally(statement)
                walk(statement)

────────────────────
_ do walk-initializers
    - id SyntaxId

` Property initializers of a class or extension are lowered in its constructor by the
` TypeScript compiler, with `this` and the members in scope. They live inside main's range, so
` main binds them under the declaring type, each in a scope of its own. The value of a
` property, of a class or of the module, does not see the locals the module's statements
` declare: the names in reach when it starts are out of reach until it ends.
. members = RowRange'SyntaxId()
. saved-floor = value-floor
do match? tree.nodes[id]
    | .node-class-block(row)
        members = row.members
    | .node-extension(row)
        members = row.body
    | .node-style-sheet-extension(row)
        members = row.body
    | .node-property-syntax(row)
        . first = bindings.slots.length
        value-floor = names.length as U32
        machine-valued = row.value
        walk(row.value)
        machine-valued = 0
        value-floor = saved-floor
        note-window(id, first)
if members.count == 0
    =

. owner = decl-for-syntax(id)
if owner == 0
    =

. saved-owner = owner-decl
owner-decl = owner
for member in tree.children[members]
    do match? tree.nodes[member]
        | .node-property-syntax(property)
            if property.value != 0
                . first = bindings.slots.length
                value-floor = names.length as U32
                push-scope(.scope-function, member)
                declare-self()
                machine-valued = property.value
                walk(property.value)
                machine-valued = 0
                pop-scope()
                value-floor = saved-floor
                note-window(member, first)
        | .node-when-rule-syntax(rule)
            walk-rule(member, rule.expr, rule.body, saved-floor)
        | .node-whenever-rule-syntax(rule)
            if rule.kind.text == "value" && rule.args.count == 0
                walk-rule(member, rule.expr, rule.body, saved-floor)
            else if rule.kind.text != "value" && rule.args.count < 2
                walk-trigger(member, rule, saved-floor)
        | .node-subscriber-syntax(section)
            walk-rule(member, 0, section.iterator, saved-floor)
        | .node-rule-syntax(rule)
            walk-style-rule(member, rule, saved-floor)
        | .node-content-block
            walk-root-values(member, saved-floor)
owner-decl = saved-owner

────────────────────
_ do walk-rule
    - rule SyntaxId
    - expr SyntaxId
    - body SyntaxId
    - saved-floor U32

` A rule of a class is bound as the value of a property is: under the class, in a scope of
` its own, what it reads and then its body.
. first = bindings.slots.length
value-floor = names.length as U32
push-scope(.scope-function, rule)
declare-self()
walk(expr)
walk(body)
pop-scope()
value-floor = saved-floor
note-window(rule, first)

────────────────────
_ do walk-trigger
    - id SyntaxId
    - rule ASTWheneverRule
    - saved-floor U32

` A `whenever` rule on the markup an object is in is bound as a rule of the class is, with the
` changes it names, if any, declared first as a local of its body.
. first = bindings.slots.length
value-floor = names.length as U32
push-scope(.scope-function, id)
declare-self()
for arg in tree.children[rule.args]
    do match? tree.nodes[arg]
        | .node-argument-decl(row)
            declare-pattern(row.pattern, .slot-local, SlotFlag.slot-constant, 0)
walk(rule.body)
pop-scope()
value-floor = saved-floor
note-window(id, first)

────────────────────
_ do walk-style-rule
    - id SyntaxId
    - rule ASTRule
    - saved-floor U32

` A style rule is bound as a rule of the class is: under the class, in a scope of its own, the
` values it takes as arguments, the values it gives the rules it applies, then the value of
` each line of its body that declares one, those of each `when` (`walk-style-when`), each
` rule written in it (`walk-rule-body`), and the function of each line that generates content
` (`walk-content`). What a line names is a property of a style, which no scope holds.
. first = bindings.slots.length
value-floor = names.length as U32
push-scope(.scope-function, id)
walk-rule-body(id, rule, first)
pop-scope()
value-floor = saved-floor
note-window(id, first)

────────────────────
_ do walk-rule-body
    - id SyntaxId
    - rule ASTRule
    - first Size

` Binds a style rule in the scope opened for it, as `walk-style-rule` says. A rule written in
` its body, or in that of one of its `when`s, is bound in a scope of its own under it, so that
` it reads the values the rules around it take, which its window holds from `first` on. A line
` of its own body whose value reads something tracked is given again by a function of its own,
` as an attribute of a markup element is (`walk-attribute`).
declare-self()
for arg in tree.children[rule.args]
    do match? tree.nodes[arg]
        | .node-argument-decl(row)
            declare-pattern(row.pattern, .slot-argument, 0, 0)
styled-depth += 1
for application in tree.children[rule.style-rule-applications]
    do match? tree.nodes[application]
        | .node-style-rule-application(applied)
            for value in tree.children[applied.args]
                walk(value)
do match? tree.nodes[rule.body]
    | .node-block(block)
        for statement in tree.children[block.body]
            do match? tree.nodes[statement]
                | .node-assign(line)
                    walk(line.rhs)
                    if is-live(statement)
                        walk-attribute(statement)
                | .node-style-when(when)
                    walk-style-when(when.body, first)
                | .node-rule-syntax(nested)
                    walk-nested-rule(statement, nested, first)
                | .node-markup
                    walk-content(statement)
styled-depth -= 1

────────────────────
_ do walk-nested-rule
    - id SyntaxId
    - rule ASTRule
    - first Size

push-scope(.scope-block, id)
walk-rule-body(id, rule, first)
pop-scope()
note-window(id, first)

────────────────────
_ do walk-style-when
    - body SyntaxId
    - first Size

` The body of a `when` in a style rule is bound with the rule: the values it gives the rules it
` applies, the value of each line that declares one, each rule written in it
` (`walk-nested-rule`), and the function of each line that generates content (`walk-content`).
do match? tree.nodes[body]
    | .node-assign(line)
        walk(line.rhs)
    | .node-rule-syntax(nested)
        walk-nested-rule(body, nested, first)
    | .node-markup
        walk-content(body)
    | .node-block(block)
        for statement in tree.children[block.body]
            do match? tree.nodes[statement]
                | .node-assign(line)
                    walk(line.rhs)
                | .node-style-rule-application(applied)
                    for value in tree.children[applied.args]
                        walk(value)
                | .node-rule-syntax(nested)
                    walk-nested-rule(statement, nested, first)
                | .node-markup
                    walk-content(statement)

────────────────────
_ do walk-content
    - element SyntaxId

` The function that builds the content a line of a style rule generates, a markup element that
` binds a slot: the element, made and given its content in a scope of its own, which captures
` like a lambda, as the reference's `styleContentBuilderFunc` builds it, with no batch of markup
` kept where it is written. A markup line that binds no slot generates nothing.
if !is-slot-builder(element)
    =
do match? tree.nodes[element]
    | .node-markup(row)
        push-scope(.scope-nested, element)
        function-depth += 1
        open-nested(element)
        walk-markup(element, row.id, row.type-id, row.body)
        close-nested()
        function-depth -= 1
        pop-scope()

────────────────────
_ do walk-root-values
    - content SyntaxId
    - saved-floor U32

` The values a root `<This` gives properties of its class are the first values of those
` properties, each bound as the value a property is declared with is: under the class, in a
` scope of its own, at the line that gives it. So are the values it gives the style rules it
` applies, which its constructor evaluates, at the application that gives them.
do match? tree.nodes[tree.root-this(content)]
    | .node-markup(root)
        for application in tree.children[root.style-rule-applications]
            do match? tree.nodes[application]
                | .node-style-rule-application(applied)
                    if applied.args.count != 0
                        . first = bindings.slots.length
                        value-floor = names.length as U32
                        push-scope(.scope-function, application)
                        declare-self()
                        for value in tree.children[applied.args]
                            walk(value)
                        pop-scope()
                        value-floor = saved-floor
                        note-window(application, first)
        do match? tree.nodes[root.body]
            | .node-block(block)
                for statement in tree.children[block.body]
                    do match? tree.nodes[statement]
                        | .node-assign(attribute)
                            . first = bindings.slots.length
                            value-floor = names.length as U32
                            push-scope(.scope-function, statement)
                            declare-self()
                            styled-depth += 1
                            walk(attribute.rhs)
                            styled-depth -= 1
                            pop-scope()
                            value-floor = saved-floor
                            note-window(statement, first)

────────────────────
_ do note-window
    - property SyntaxId
    - first Size

` Keeps which locals the value of a property declared, so that the value is typed with
` those alone.
. count = bindings.slots.length - first
if count != 0
    bindings.windows.append(SlotWindow(property, RowRange'Slot(first as U32, count as U32)))

────────────────────
_ decl-for-syntax DeclId
    - syntax SyntaxId

type-index[((module as U64) /lshift/ 32) /or/ syntax] ?? 0

────────────────────
_ do predeclare-lazies Void
    - statements RowRange'SyntaxId
    - raises Bool = true
    - names Bool = true

` Declares the lazy locals of a block before its statements are walked. Those of a block that
` is one of the statements are declared with them, as the reference declares them, so the
` statements beside that block read them. A match declares only an action's own for its
` arms. A block that `names` declares the names its markup elements are given, and those of
` its slot outlets, which hold the nodes they mount.
for statement in tree.children[statements]
    do match? tree.nodes[statement]
        | .node-declare(row)
            if row.is-lazy && row-getters.find(statement) == null
                declare-pattern(row.left, .slot-lazy, 0, statement)
        | .node-block(row)
            if raises
                raise-lazies(statement, row.body)
        | .node-markup
            if names
                declare-ids(statement)
        | .node-slot-outlet(row)
            if names && row.name != 0
                declare-pattern(row.name, .slot-local, 0, statement)
                place-element(statement)

────────────────────
_ do declare-ids Void
    - element SyntaxId

` Declares the name a markup element is given, and those of the elements and slot outlets
` written as lines of its body, as locals of the block the outermost is a statement of, so every
` statement of the block reaches the name. The reference makes each such element where the
` statement that writes it runs, or where a statement above reads its name first; a slot
` outlet's name holds the node it mounts once it is mounted.
` An element under an `if` or a `for` written as a line is not reached: its name is the business
` of the body it is in.
do match? tree.nodes[element]
    | .node-markup(row)
        if row.id != 0
            declare-pattern(row.id, .slot-local, 0, element)
        do match? tree.nodes[row.body]
            | .node-block(block)
                for statement in tree.children[block.body]
                    declare-ids(statement)
    | .node-slot-outlet(row)
        if row.name != 0
            declare-pattern(row.name, .slot-local, 0, element)
            place-element(element)

────────────────────
_ do raise-elements Void
    - statements RowRange'SyntaxId

` Walks, where a block of markup content starts, what makes the object of each markup element
` the block declares a name for: its type, its arguments and the values of its attributes, in
` the order the elements are written. The reference makes these objects there, before any
` line of the block, so a local the block declares is not in reach of them, and neither are
` the members of an element they are written in.
for statement in tree.children[statements]
    raise-element(statement)

────────────────────
_ do place-elements Void
    - statements RowRange'SyntaxId

` Marks, where a block of statements starts, the markup elements among them that are made
` where they are written (`place-element`). What makes the object of each other element the
` block declares a name for is walked where the statement that writes it is, so the locals
` declared above it are in reach of it.
for statement in tree.children[statements]
    raise-element(statement, false)

────────────────────
_ do raise-element Void
    - element SyntaxId
    - raises Bool = true

if is-slot-builder(element)
    place-element(element)
    =
do match? tree.nodes[element]
    | .node-markup(row)
        if hosts-slots(row.type-id) && supplies-slots(element)
            place-element(element)
            =
        if raises && row.id != 0
            branch-depth += 1
            walk-made(element, row.id, row.body)
            branch-depth -= 1
            raised-elements += element
        do match? tree.nodes[row.body]
            | .node-block(block)
                for statement in tree.children[block.body]
                    raise-element(statement, raises)

────────────────────
_ do walk-markup Void
    - element SyntaxId
    - name SyntaxId
    - type SyntaxId
    - body SyntaxId

` A markup element: what makes its object, unless `raise-element` walked it already, the
` function that gives its name the object where its body gives slots content, and then the
` content of its body, or the function that builds it where it is the default slot's
` (`walk-wrapped`). One written with a name in a nested function captures the receiver, whose
` property of the name it may give the object.
branch-depth += 1
if name != 0 && function-depth != 0
    hold-self()
if raised-elements.find(element) == null
    if name != 0 && placed-elements.find(element) == null
        note-borrowed(name)
    else if name != 0
        hold-placed(name)
    walk-made(element, name, body)
if name != 0 && is-binder(name)
    walk-binder(name)
if body != 0 && is-slot-builder(body)
    walk-wrapped(body)
    walk-element(element, type, body, true)
else
    walk-element(element, type, body)
branch-depth -= 1

────────────────────
_ do hold-placed Void
    - name SyntaxId

` The name of a placed markup element is given the element's object where it is written,
` which a function written in the one that declares the name, such as the one that builds a
` slot, does through what it captures.
. text = identifier-name(tree, name)
. position = lookup-position(text) if text
if position
    use-slot(name-slots[position], name-depths[position], ResolutionFlag.resolution-write)

────────────────────
_ do is-binder Bool
    - name SyntaxId

` Whether the name of a markup element is where the function that gives it the element's
` object is written.
. decl = nested-decl-for(name)
if decl == 0
    = false
do match? program.modules[module].decls[decl]
    | .decl-function(fn)
        = fn.kind == .binder-decl
= false

────────────────────
_ do walk-binder Void
    - name SyntaxId

` The function a markup element whose body gives slots content gives its constructor, which
` gives the element's name the object before the markup of its class runs: it captures the
` local the name declares, and assigns it, and the receiver, whose property of the name it
` may give the object too.
push-scope(.scope-nested, name)
function-depth += 1
open-nested(name)
hold-placed(name)
hold-self()
close-nested()
function-depth -= 1
pop-scope()

────────────────────
_ names-markup Bool
    - slot SlotId

` Whether a local is declared for the name of a markup element.
group != 0 && tree.nodes[group] is .node-markup

.. group = bindings.slots[slot].group

────────────────────
_ do hold-self Void

` Captures the receiver where there is one, in a function that may store in its property.
. position = lookup-position(this-name)
if position
    use-slot(name-slots[position], name-depths[position], 0)

────────────────────
_ do place-element Void
    - element SyntaxId

` A markup element that is made where it is written, which no block makes where it starts:
` one that gives slots of its class content (`supplies-slots`), as the reference makes it, and
` with it every element written as a line of its body, one built as what an element gives a
` slot, and one among the lines of a class's markup that give the default slot of the class
` above (`declare-wrapped`); and a slot outlet, whose node is mounted where it is written. The
` local declared for its name is marked, and is given the object there.
do match? tree.nodes[element]
    | .node-slot-outlet(row)
        . resolution = bindings.resolution-of(binding, row.name)
        if resolution.kind == .resolve-slot
            bindings.mark-slot(resolution.slot, SlotFlag.slot-placed)
    | .node-markup(row)
        if row.id != 0
            placed-elements += element
            . resolution = bindings.resolution-of(binding, row.id)
            if resolution.kind == .resolve-slot
                bindings.mark-slot(resolution.slot, SlotFlag.slot-placed)
        do match? tree.nodes[row.body]
            | .node-block(block)
                for statement in tree.children[block.body]
                    place-element(statement)

────────────────────
_ do hosts-slots Bool
    - type SyntaxId

` Whether the class a markup element names by its type, as the binder can name it, or one
` it derives from writes markup that holds a slot outlet or forwards a slot.
. class = class-written(module, tree, type)
. depth = 0
while class && depth <= member-chain-limit
    . owner = program.modules[class.module]
    . next DeclRef? = null
    do match? owner.decls[class.decl]
        | .decl-class(row)
            if row.content != 0
                for node in owner.tree.subtree-start(row.content) .. < row.content
                    if owner.tree.nodes[node] is .node-slot-outlet || forwards
                        = true
                    .. forwards = owner.tree.nodes[node] is .node-markup-slot-forward
            if row.base != 0
                next = class-written(class.module, owner.tree, row.base)
    class = next
    depth += 1
= false

────────────────────
_ do supplies-slots Bool
    - element SyntaxId

` Whether a markup element's body gives slots of its class content, as the reference supplies
` them: a line bound to a slot by name, or what the module builder took for the default slot,
` which a function of its own builds. An element that gives none is made as any other is, its
` lines content of its object.
do match? tree.nodes[element]
    | .node-markup(row)
        if is-slot-builder(row.body)
            = true
        do match? tree.nodes[row.body]
            | .node-block(block)
                for line in tree.children[block.body]
                    if is-slot-builder(line) || (!gives-default(line) && !line-assigns)
                        = true
                    .. line-assigns = tree.nodes[line] is .node-assign
= false

────────────────────
_ do is-slot-builder Bool
    - id SyntaxId

` Whether a markup element is built by a function of its own, as what it binds a slot to.
. decl = nested-decl-for(id)
if decl == 0
    = false
do match? program.modules[module].decls[decl]
    | .decl-function(fn)
        = fn.kind == .slot-decl
= false

────────────────────
_ do walk-slot Void
    - element SyntaxId
    - name SyntaxId
    - type SyntaxId
    - body SyntaxId

` The function that builds what a markup element gives a slot of the element whose body it is
` a line of: the element itself, made and given its content in a scope of its own, or the value
` the one line that gives the default slot content is, which captures like a lambda. The reference builds it before that element's own content is
` written, so no name read there is a member of that element: the element is no receiver
` of it, though one around that element still is. The item a slot that repeats gives each
` row is its argument, by the name the element writes for it and by `each` and `it`. A name
` nothing declares in what such a slot is given is not reported: the reference checks those
` reads before it resolves them, and the type pass declines them. An element written with a
` name captures the receiver, whose property of the name it may give the object. It captures
` the local that keeps the batch in force where the element is written (`keep-root`).
. held = receiver-decls.length
. outer-module = if held != 0 then receiver-modules[held - 1] else module
. outer-decl = if held != 0 then receiver-decls[held - 1] else 0u32
. outer-mark = if held != 0 then receiver-marks[held - 1] else 0
. outer-element = if held != 0 then receiver-elements[held - 1] else 0u32
. outer-depth = if held != 0 then receiver-depths[held - 1] else 0u32
. outer-scope = if held != 0 then receiver-scopes[held - 1] else current-scope
if held != 0
    receiver-modules.pop()
    receiver-decls.pop()
    receiver-marks.pop()
    receiver-elements.pop()
    receiver-depths.pop()
    receiver-scopes.pop()
. root = keep-root(element)
push-scope(.scope-nested, element)
function-depth += 1
open-nested(element)
record-capture(root, slot-depth(root), false)
. repeats = false
do match? tree.nodes[element]
    | .node-markup(row)
        do match? tree.nodes[row.slot-parameter]
            | .node-markup-slot-parameter(parameter)
                declare-pattern(parameter.name, .slot-argument, 0, 0)
                . given = bindings.resolution-of(binding, parameter.name).slot
                bindings.set-resolution
                    - binding
                    - row.slot-parameter
                    - Resolution(.resolve-slot, 0, given, 0, 0)
                if bindings.slots[given].name != each-name
                    alias(each-name, given)
                alias(it-name, given)
                repeats = true
if repeats
    repeating-depth += 1
if name != 0
    hold-self()
if tree.nodes[element] is .node-markup
    walk-markup(element, name, type, body)
else
    walk(element)
if repeats
    repeating-depth -= 1
close-nested()
function-depth -= 1
pop-scope()
if held != 0
    receiver-modules += outer-module
    receiver-decls += outer-decl
    receiver-marks += outer-mark
    receiver-elements += outer-element
    receiver-depths += outer-depth
    receiver-scopes += outer-scope

────────────────────
_ do walk-outlet Void
    - name SyntaxId
    - parameter SyntaxId
    - rules RowRange'SyntaxId
    - body SyntaxId

` A slot outlet of the markup written in a class: the function that builds its slot, which a
` nested function the outlet is written in captures from the function that fills the object
` (`builder-of`), the value it gives that function where the slot repeats, the values given the
` style rules it applies, then the lines of its body. A line that assigns gives the node the
` outlet mounts a property, read in the scope the outlet is written in, with the function that
` gives it again where it has one, as an attribute of an element is; the others are the content
` the outlet mounts where it is given none, written in a block of their own.
if fills && function-depth != 0
    . text = program.store-atom("")
    if name != 0
        text = identifier-name(tree, name) ?? text
    use-slot(builder-of(text), 0, 0)
do match? tree.nodes[parameter]
    | .node-markup-slot-parameter(row)
        walk(row.name)
for rule in tree.children[rules]
    do match? tree.nodes[rule]
        | .node-style-rule-application(applied)
            styled-depth += 1
            for value in tree.children[applied.args]
                walk(value)
            styled-depth -= 1
do match? tree.nodes[body]
    | .node-block(block)
        for statement in tree.children[block.body]
            do match? tree.nodes[statement]
                | .node-assign(attribute)
                    styled-depth += 1
                    walk(attribute.rhs)
                    styled-depth -= 1
                    walk-attribute(statement)
        push-scope(.scope-block, body)
        predeclare-lazies(block.body)
        raise-elements(block.body)
        . lazies-end = names.length as U32
        for statement in tree.children[block.body]
            if !is-finally(statement) && !(tree.nodes[statement] is .node-assign)
                walk-statement(statement, false, lazies-end)
        for statement in tree.children[block.body]
            if is-finally(statement)
                walk(statement)
        pop-scope()

────────────────────
_ do walk-outlet-region Void
    - id SyntaxId
    - name SyntaxId
    - parameter SyntaxId
    - rules RowRange'SyntaxId
    - body SyntaxId

` A slot outlet that is a markup branch region of one arm, as the reference's
` `markupRebuildingSlotOutlet` makes it: the name its parameter gives is read where the outlet is
` written, to select the arm, and the outlet is built by a function of its own, written at it,
` which reads the name again with what it captures of what the name reads. The host, the region
` and the batch in force are kept in three locals no name reaches, declared at the parameter, as
` those of a match region are (`walk-match-region`); the function that selects the arm again,
` written at the parameter, captures them with what the name reads.
. given SyntaxId = 0
do match? tree.nodes[parameter]
    | .node-markup-slot-parameter(row)
        given = row.name
. kept = SlotFlag.slot-constant /or/ SlotFlag.slot-captured
. host = bindings.slots.append(host-slot) as SlotId
    .. host-slot = Slot(.slot-local, branch-host-name, parameter, current-scope, decl, 0, kept)
bindings.slots.append
    - Slot(.slot-local, branch-region-name, parameter, current-scope, decl, 0, kept)
bindings.slots.append(Slot(.slot-local, batch-root-name, parameter, current-scope, decl, 0, kept))
bindings.set-resolution
    - binding
    - parameter
    - Resolution(.resolve-slot, 0, host, 0, ResolutionFlag.resolution-declares)
walk(given)
. read [SlotId]
note-reads(given, read, true)
branch-depth += 1
push-scope(.scope-nested, id)
function-depth += 1
open-nested(id)
record-capture(host + 2, slot-depth(host + 2), false)
for slot in read
    bindings.mark-slot(slot, SlotFlag.slot-captured)
    record-capture(slot, slot-depth(slot), bindings.slots[slot].kind == .slot-this)
. arm = bindings.slots.append(arm-slot) as SlotId
    .. arm-slot = Slot(.slot-argument, branch-parent-name, id, current-scope, decl, 0, constant)
    .. constant = SlotFlag.slot-constant
bindings.set-resolution
    - binding
    - id
    - Resolution(.resolve-slot, 0, arm, 0, ResolutionFlag.resolution-declares)
walk-outlet(name, 0, rules, body)
close-nested()
function-depth -= 1
pop-scope()
branch-depth -= 1
. slots [SlotId]
slots += host
slots += host + 1
note-reads(given, slots, true)
capture-in(parameter, slots)

────────────────────
_ do walk-made Void
    - element SyntaxId
    - name SyntaxId
    - body SyntaxId

` What makes the object of a markup element: its type, its arguments, the values of the style
` rules it applies, and the values of the attributes its body gives it, which are read in the
` scope outside the element, each value with the function that gives it again where it has
` one. The condition a style rule is applied under reads a member of the element before a name
` of the scope outside, as the reference reads it in the scope of the rule's class, and is
` tested again by a function of its own (`walk-gates`). The slot an element binds, and the
` parameter it names for a slot, are names of the class it is content of, and no reads.
. bound SyntaxId = 0
. parameter SyntaxId = 0
. type SyntaxId = 0
do match? tree.nodes[element]
    | .node-markup(row)
        bound = row.slot-binding
        parameter = row.slot-parameter
        type = row.type-id
. class = class-written(module, tree, type)
for child in tree.children-of(element)
    if child != name && child != body && child != bound && child != parameter
        do match tree.nodes[child]
            | .node-style-rule-application(applied)
                styled-depth += 1
                for value in tree.children[applied.args]
                    walk(value)
                styled-depth -= 1
                if applied.condition != 0
                    open-receiver(element, class)
                    . around = condition-level
                    condition-level = receiver-decls.length - 1
                    walk(applied.condition)
                    condition-level = around
                    close-receiver()
            ??
                walk(child)
do match? tree.nodes[body]
    | .node-block(row)
        for statement in tree.children[row.body]
            do match? tree.nodes[statement]
                | .node-assign(attribute)
                    styled-depth += 1
                    walk(attribute.rhs)
                    styled-depth -= 1
                    walk-attribute(statement)
do match? tree.nodes[element]
    | .node-markup(row)
        walk-arguments(element, row.args)
        walk-gates(row.style-rule-applications)

────────────────────
_ do walk-gates Void
    - applications RowRange'SyntaxId

` The function that tests again the condition a style rule written on a markup element is
` applied under, where it has one: it captures every local, argument and receiver the condition
` reads, the list of subscribers of each local it reads tracked, and the element's object where
` it reads a member of the element (`keep-received`).
for application in tree.children[applications]
    do match? tree.nodes[application]
        | .node-style-rule-application(applied)
            if applied.condition != 0 && is-gate(applied.condition)
                keep-received(applied.condition)
                . slots [SlotId]
                note-reads(applied.condition, slots, true)
                capture-in(applied.condition, slots)

────────────────────
_ do is-gate Bool
    - id SyntaxId

` Whether the nested function declared at a node tests a condition again.
. decl = nested-decl-for(id)
if decl == 0
    = false
do match? program.modules[module].decls[decl]
    | .decl-function(fn)
        = fn.kind == .gate-decl
= false

────────────────────
_ do walk-arguments Void
    - element SyntaxId
    - args RowRange'SyntaxId

` The function that gives again each argument of a markup element, given by position, whose
` value read something tracked, as the reference compiles it: the element's object is kept in
` one local no name reaches, declared at the element, which each such function captures with
` every local, argument and receiver the value reads and the list of subscribers of each local
` it reads tracked.
. held = no-slot
for arg in tree.children[args]
    if !is-live(arg)
        continue
    if held == no-slot
        held = element-keeper(element, current-scope)
    keep-received(arg)
    . slots [SlotId]
    slots += held
    note-reads(arg, slots, true)
    capture-in(arg, slots)

────────────────────
_ do is-live Bool
    - id SyntaxId

` Whether the nested function declared at a node runs it again, as a live statement or an
` argument of a markup element whose value reads something tracked.
. decl = nested-decl-for(id)
if decl == 0
    = false
do match? program.modules[module].decls[decl]
    | .decl-function(fn)
        = fn.kind == .live-decl
= false

────────────────────
_ do walk-stream Void
    - id SyntaxId

` The function that writes the value of a stream of a value as it changes, `<#value>`, again
` when what it read tracked changes, as the reference compiles it: the channel is kept in a
` local no name reaches, declared at the stream, which the function captures with every local,
` argument and receiver the value reads and the list of subscribers of each local it reads
` tracked.
if nested-decl-for(id) == 0
    =
. kept = SlotFlag.slot-constant /or/ SlotFlag.slot-captured
. held = bindings.slots.append(channel-slot) as SlotId
    .. channel-slot = Slot(.slot-local, channel-name, id, current-scope, decl, 0, kept)
bindings.set-resolution
    - binding
    - id
    - Resolution(.resolve-slot, 0, held, 0, ResolutionFlag.resolution-declares)
. slots [SlotId]
slots += held
note-reads(id, slots)
capture-in(id, slots)

────────────────────
_ do walk-attribute Void
    - statement SyntaxId

` The function that gives an attribute of a markup element its value again when what the
` value read tracked changes, or a line of its body that gives content the element takes again,
` as the reference compiles it: the element's object is kept in a local no name reaches,
` declared at the line, which the function captures with every local, argument and receiver
` the value reads and the list of subscribers of each local it reads tracked. A line that gives
` content, to the element or to the region an arm of which it is written in, keeps in the next
` such local what that took, which the function replaces. Such a line may be a name alone, as
` `#child` is, whose node resolves the name: the line resolves to neither local, they are found
` by their names where they are declared, and what the line itself reads is captured too.
if nested-decl-for(statement) == 0
    =
. kept = SlotFlag.slot-constant /or/ SlotFlag.slot-captured
. held = bindings.slots.append(element-slot) as SlotId
    .. element-slot = Slot(.slot-local, element-name, statement, current-scope, decl, 0, kept)
. gives = tree.content-line(statement)
if !gives
    . declares = ResolutionFlag.resolution-declares
    bindings.set-resolution(binding, statement, Resolution(.resolve-slot, 0, held, 0, declares))
keep-received(statement)
. slots [SlotId]
slots += held
if gives
    . replaced = SlotFlag.slot-captured /or/ SlotFlag.slot-assigned
    slots += bindings.slots.append(prior) as SlotId
        .. prior = Slot(.slot-local, previous-name, statement, current-scope, decl, 0, replaced)
note-reads(statement, slots, gives)
capture-in(statement, slots)
do match? tree.nodes[statement]
    | .node-assign(row)
        if row.op == .bind-op && nested-decl-for(row.lhs) != 0
            . written = bindings.resolution-of(binding, row.rhs)
            if written.kind == .resolve-slot
                bindings.mark-slot(written.slot, SlotFlag.slot-assigned)
            capture-in(row.lhs, slots)

────────────────────
_ do keep-received Void
    - id SyntaxId

` Gives each name under a node that reads a member of a markup element by its name alone, where
` the element's body is written and not in a function of its own, the local that keeps that
` element's object (`element-keeper`), where the element is not written under the node: the
` function that gives the node again reads the member from that object, which it captures, as a
` function written in the element's body does (`receiver-keeper`).
. start = tree.subtree-start(id)
for node in start .. id
    . found = received-reads[node]
    if !found
        continue
    . element = received-elements[found]
    . resolution = bindings.resolution-of(binding, node)
    if resolution.slot == no-slot && (element < start || element > id)
        . held = element-keeper(element, received-scopes[found])
        bindings.set-resolution
            - binding
            - node
            - Resolution
                - resolution.kind
                - resolution.module
                - held
                - resolution.decl
                - resolution.flags

────────────────────
_ do note-borrowed Void
    - id SyntaxId

` The name of a markup element that no block declares: where something else in reach
` declared the name, the reference takes that thing's value for the element's object. What
` the name finds is kept for the type pass, and nothing is reported where it finds nothing.
. name = identifier-name(tree, id)
if !name
    =
. position = lookup-position(name)
if receiver-decls.length != 0 && received-level(name, position) != null
    . received = ResolutionFlag.resolution-received
    bindings.set-resolution(binding, id, Resolution(.resolve-unresolved, 0, no-slot, 0, received))
    =
if position
    bindings.set-resolution(binding, id, Resolution(.resolve-slot, 0, name-slots[position], 0, 0))
    =
outer-uses-self = false
. outer = resolve-outer(name)
if outer.kind != .resolve-unresolved
    bindings.set-resolution
        - binding
        - id
        - Resolution(outer.kind, outer.module, outer.slot, outer.decl, 0)

────────────────────
_ do note-content Void
    - statements RowRange'SyntaxId

` The lines of a markup element's body, or of a body that runs as one: an `if` written as a
` line runs its bodies as content of the same element, which declare no name for an element,
` and a `for`, or a loop written with `in` that is no function of its own, runs its body as
` content each turn, which declares those of its own. The body of a markup loop region builds a
` row, which is no content.
for statement in tree.children[statements]
    note-content-line(statement)

────────────────────
_ do note-content-line Void
    - statement SyntaxId

do match? tree.nodes[statement]
    | .node-if-block
        . branch = statement
        while branch != 0
            . next SyntaxId = 0
            do match? tree.nodes[branch]
                | .node-if-block(row)
                    content-bodies += tree.arm-body(branch)
                    next = row.next
            branch = next
    | .node-for-block(row)
        if !is-loop-region(statement)
            content-turns += row.body
    | .node-iterator-expression(row)
        if nested-decl-for(statement) == 0
            content-turns += row.body

────────────────────
_ do raise-lazies Void
    - block SyntaxId
    - statements RowRange'SyntaxId

for statement in tree.children[statements]
    do match? tree.nodes[statement]
        | .node-declare(row)
            if row.is-lazy && !row.is-scoped && row-getters.find(statement) == null
                declare-pattern(row.left, .slot-lazy, 0, statement)
                raised-homes += block

────────────────────
_ do declare-scoped Void
    - statements RowRange'SyntaxId

` Declares the lazy locals a block keeps to itself, where the rest were declared with the block
` around it: the value a call's guards test, which each call's own block names `it`.
for statement in tree.children[statements]
    do match? tree.nodes[statement]
        | .node-declare(row)
            if row.is-lazy && row.is-scoped
                declare-pattern(row.left, .slot-lazy, 0, statement)

────────────────────
_ do is-constructor-body Bool
    - id SyntaxId

` Whether a block is the body of a constructor of a type, which gives the object it makes: a
` constructor that is a rule makes none, and its lazy declarations are its rules.
do match? program.modules[module].decls[decl]
    | .decl-function(fn)
        = owned-body && fn.kind == .constructor-decl && rule-match(program, module, decl) == 0
            .. owned-body = owner-decl != 0 && fn.body == id
= false

────────────────────
_ do mark-initializers Void
    - statements RowRange'SyntaxId

` A lazy declaration in a constructor that names a property of the owner gives the property its
` value. The reference declares that value as a local at the property.
. target = program.modules[module]
for statement in tree.children[statements]
    do match? tree.nodes[statement]
        | .node-declare(row)
            . name = declared-name(row.left) if row.is-lazy
            . slot = lookup-slot(name) if name
            . member = member-of(module, owner-decl, name!, 0) if slot
            if member && member.module == (module)
                do match? target.decls[member.decl]
                    | .decl-property(property)
                        bindings.slots[slot!].property = property.syntax

────────────────────
_ do hide-initializers Void
    - statements RowRange'SyntaxId

` A lazy declaration in a constructor that builds its own class and names a field of it, its
` own or a base's, is the field's initializer, which runs before the body. The body reads and
` writes the field itself, so the local is in reach only of the values of such declarations.
for statement in tree.children[statements]
    do match? tree.nodes[statement]
        | .node-declare(row)
            . name = declared-name(row.left) if row.is-lazy
            . position = lookup-position(name) if name
            if position && names-field(name!)
                initializer-positions += position as U32
reach-initializers(false)

────────────────────
_ do names-field Bool
    - name Atom

. member = member-of(module, owner-decl, name, 0)
if member
    do match? program.modules[member.module].decls[member.decl]
        | .decl-property
            = true
= false

────────────────────
_ do reach-initializers Void
    - shown Bool

for position in initializer-positions
    latest-names[names[position]] = if shown then position else name-links[position]

────────────────────
_ do declare-capture
    - id SyntaxId

` A name a stream pattern captures. A match keeps one slot for each name, which every place
` that captures the name fills, as the reference's matchmaker keeps one. No capture is named
` `it`, which an action reads for what its arm matched.
. name = identifier-name(tree, id)
if name && name.text == "it"
    . message = "A capture cannot be named \"it\", which names what the arm matched; choose another name"
    bindings.diagnostics.append(Diagnostic(module, id, .stated, program.store-atom(message)))
. position = lookup-position(name) if name
if position && position >= capture-floor && bindings.slots[name-slots[position]].kind == .slot-pattern
    . declares U32 = ResolutionFlag.resolution-declares
    bindings.set-resolution
        - binding
        - id
        - Resolution(.resolve-slot, 0, name-slots[position], 0, declares)
    =
declare-pattern(id, .slot-pattern, SlotFlag.slot-constant, 0)
if name
    stream-captures[bindings.resolution-of(binding, id).slot] = true

────────────────────
_ do hoist-lazies Void
    - id SyntaxId

` The lazy locals of a pattern's actions are declared where the match is, in reach of every
` arm's pattern and action, as the reference declares a transform's where clause.
do match? tree.nodes[id]
    | .node-stream-transform(row)
        hoist-lazies(row.pattern)
        do match? tree.nodes[row.right]
            | .node-block(block)
                predeclare-lazies(block.body, false)
    | .node-stream-and(row)
        hoist-lazies(row.left)
        hoist-lazies(row.right)
    | .node-stream-or(row)
        hoist-lazies(row.left)
        hoist-lazies(row.right)
    | .node-stream-panic(row)
        hoist-lazies(row.pattern)
    | .node-stream-capture(row)
        hoist-lazies(row.pattern)
    | .node-stream-unary(row)
        hoist-lazies(row.operand)
    | .node-stream-length(row)
        hoist-lazies(row.operand)

────────────────────
_ do walk-element Void
    - element SyntaxId
    - type SyntaxId
    - body SyntaxId
    - bound Bool = false

` The content of a markup element's body. A line that assigns is an attribute, walked with
` what makes the element's object. The other lines are the element's content, which read the
` scope outside the element, as its attributes do, but for the event a handler subscribes to,
` which is the element's or one it is in, as `received-level` says,
` each with the function that gives it again where it has one, as an attribute has. The names
` of the elements among them are declared by a block around this one. Where a function of its
` own builds the lines that give the default slot content (`walk-wrapped`), only the content
` bound to other slots is walked here (`bound`). A value that gives the default slot content is
` walked as what builds it (`walk-slot`).
if body == 0
    =
. class = class-written(module, tree, type)
do match? tree.nodes[body]
    | .node-block(row)
        open-receiver(element, class)
        push-scope(.scope-block, body)
        if !bound
            note-content(row.body)
            if raised-homes.find(body) == null
                predeclare-lazies(row.body, true, false)
        . lazies-end = names.length as U32
        for statement in tree.children[row.body]
            if !is-finally(statement) && !assignment && (!bound || !gives-default(statement))
                if !(tree.nodes[statement] is .node-markup) && is-slot-builder(statement)
                    walk-slot(statement, 0, 0, 0)
                else
                    walk-statement(statement, false, lazies-end)
                if is-live(statement)
                    walk-attribute(statement)
            .. assignment = tree.nodes[statement] is .node-assign
        for statement in tree.children[row.body]
            if !bound && is-finally(statement)
                walk(statement)
        pop-scope()
        close-receiver()
        =
open-receiver(element, class)
walk(body)
close-receiver()

────────────────────
_ do gives-default Bool
    - line SyntaxId

` Whether a line of an element's body is content of the default slot: neither an attribute nor
` content bound to a slot.
do match? tree.nodes[line]
    | .node-assign
        = false
    | .node-markup-slot-forward
        = false
    | .node-markup(row)
        = row.slot-binding == 0
= true

────────────────────
_ do keep-root SlotId
    - syntax SyntaxId

` The local no name reaches that keeps the batch of markup in force where the function that
` builds what a markup element gives a slot is made, declared there, at what the function
` builds, which the function captures, as the reference captures the batch it finds.
. kept = SlotFlag.slot-constant /or/ SlotFlag.slot-captured
= bindings.slots.append(batch-root) as SlotId
    .. batch-root = Slot(.slot-local, batch-root-name, syntax, current-scope, decl, 0, kept)

────────────────────
_ do walk-wrapped Void
    - body SyntaxId

` The lines of a markup element's body that give its class's default slot content, which a
` function of its own builds into a node of the slot's type, as the reference builds them: the
` function captures like a lambda, the element is no receiver in it, and those lines are the
` content of that node (`gives-default`). The names of the elements among them are declared by
` a block around the element. It captures the local that keeps the batch in force where the
` element is written (`keep-root`).
. root = keep-root(body)
push-scope(.scope-nested, body)
function-depth += 1
open-nested(body)
record-capture(root, slot-depth(root), false)
do match? tree.nodes[body]
    | .node-block(row)
        push-scope(.scope-block, body)
        note-content(row.body)
        if raised-homes.find(body) == null
            predeclare-lazies(row.body, true, false)
        . lazies-end = names.length as U32
        for statement in tree.children[row.body]
            if !is-finally(statement) && gives-default(statement)
                walk-statement(statement, false, lazies-end)
        for statement in tree.children[row.body]
            if is-finally(statement)
                walk(statement)
        pop-scope()
close-nested()
function-depth -= 1
pop-scope()

────────────────────
_ do declare-wrapped Void
    - body SyntaxId

` Declares the names of the elements among the lines of a class's markup that give the default
` slot of the class above, in the function that fills the object, as a block around them would
` declare them: the function that builds the lines reaches them there. No block of that
` function makes them where it starts, so each is made where it is written, as the reference
` makes them (`place-element`).
do match? tree.nodes[body]
    | .node-block(row)
        for statement in tree.children[row.body]
            if gives-default(statement)
                declare-ids(statement)
                place-element(statement)

────────────────────
_ do walk-bound Void
    - body SyntaxId

` The lines of a class's markup bound to slots of the class above, where the lines that give its
` default slot are built into a node by a function of their own (`walk-wrapped`): each is walked
` in the function that fills the object, which holds the function that builds it, as an
` element's body walks those it holds (`walk-element`).
do match? tree.nodes[body]
    | .node-block(row)
        push-scope(.scope-block, body)
        . lazies-end = names.length as U32
        for statement in tree.children[row.body]
            if !is-finally(statement) && !assignment && !gives-default(statement)
                walk-statement(statement, false, lazies-end)
            .. assignment = tree.nodes[statement] is .node-assign
        pop-scope()

────────────────────
_ do open-receiver Void
    - element SyntaxId
    - class DeclRef?

` Opens the body of a markup element, of a class or of none the binder can name, as a level of
` receivers, written in the scope and the function in force.
receiver-modules += if class then class.module else module
receiver-decls += if class then class.decl else 0u32
receiver-marks += names.length
receiver-elements += element
receiver-depths += function-depth
receiver-scopes += current-scope

────────────────────
_ do close-receiver Void

` Closes the innermost level of receivers.
receiver-modules.pop()
receiver-decls.pop()
receiver-marks.pop()
receiver-elements.pop()
receiver-depths.pop()
receiver-scopes.pop()

────────────────────
_ do received-level Size?
    - name Atom
    - position Size?
    - lowest Size = 0

` The level of the markup element a name is a member of, the element or one it is in, no lower
` than `lowest`, rather than what the scopes give it, or none: it is none where a local the body
` itself declares hides the member. The innermost element is asked first. A property the markup
` of the element's class declares for an element is hidden there, as the reference hides it,
` and the name is asked of what is around. An element whose class the binder cannot name by its
` type may hold any member, so every name asked of it that is no local of the body is taken for
` one.
. level = receiver-decls.length
while level > lowest
    level -= 1
    if position && position >= receiver-marks[level]
        = null
    if receiver-decls[level] == 0
        = level
    . member = member-of(receiver-modules[level], receiver-decls[level], name, 0)
    if member && !names-element(member)
        = level
    if !member && method-of(receiver-modules[level], receiver-decls[level], name, 0)
        = level
= null

────────────────────
_ do receiver-keeper SlotId
    - level Size

` The local that keeps the object of the markup element at a level of receivers, where a name
` of its member is read in a function written in its body, which captures it: the element is
` made outside that function, by the one whose content it is, which needs none.
if function-depth <= receiver-depths[level]
    = no-slot
. held = element-keeper(receiver-elements[level], receiver-scopes[level])
use-slot(held, receiver-depths[level], 0)
= held

────────────────────
_ do element-keeper SlotId
    - element SyntaxId
    - scope ScopeId

` The local no name reaches that keeps the object of a markup element, declared at the element
` in the scope it is written in, once: the functions that give its arguments again and those
` written in its body that read its members capture it.
. resolution = bindings.resolution-of(binding, element)
if resolution.kind == .resolve-slot
    = resolution.slot
. kept = SlotFlag.slot-constant /or/ SlotFlag.slot-captured
. held = bindings.slots.append(element-slot) as SlotId
    .. element-slot = Slot(.slot-local, element-name, element, scope, decl, 0, kept)
. declares = ResolutionFlag.resolution-declares
bindings.set-resolution(binding, element, Resolution(.resolve-slot, 0, held, 0, declares))
= held

────────────────────
_ do names-element Bool
    - member DeclRef

` Whether a member is the property the markup of its class declares for an element.
do match? program.modules[member.module].decls[member.decl]
    | .decl-property(row)
        = row.element != 0
= false

────────────────────
_ do walk-action Void
    - body SyntaxId

` An action, whose block declares no lazy local of its own: its match declared them. Nothing
` after a statement that leaves the block is walked, as the reference compiles none of it.
do match? tree.nodes[body]
    | .node-block(row)
        push-scope(.scope-block, body)
        . dead = false
        for statement in tree.children[row.body]
            if !dead && !is-finally(statement)
                walk(statement)
            dead = dead || leaves-block(statement)
        dead = false
        for statement in tree.children[row.body]
            if !dead && is-finally(statement)
                walk(statement)
            dead = dead || leaves-block(statement)
        pop-scope()
        =
walk(body)

────────────────────
_ do walk-statement Void
    - statement SyntaxId
    - builds Bool
    - lazies-end U32

` A statement of a block; in a constructor that builds its own class, a field's initializer
` is walked with the other initializers in reach, and with no local the body declared before
` it, since it runs before the body.
. initializes = false
if builds
    for position in initializer-positions
        if bindings.slots[name-slots[position]].group == statement
            initializes = true
if !initializes
    walk(statement)
    =
. saved = body-names
body-names = RowRange'Atom(lazies-end, (names.length as U32) - lazies-end)
reach-initializers(true)
walk(statement)
reach-initializers(false)
body-names = saved

────────────────────
_ declared-name Atom?
    - pattern SyntaxId

match tree.nodes[pattern]
    | .node-type-capture(row)
        identifier-name(tree, row.id)
    ??
        identifier-name(tree, pattern)

────────────────────
_ do walk Void
    - id SyntaxId

if id == 0
    =

do match tree.nodes[id]
    | .node-top-level-syntax
        walk-top-level(id)
    | .node-block(row)
        push-scope(.scope-block, id)
        . lines = content-bodies.find(id) != null
        . content = lines || content-turns.find(id) != null
        if content
            note-content(row.body)
        if raised-homes.find(id) == null
            predeclare-lazies(row.body, true, !lines)
        else
            declare-scoped(row.body)
            if !lines
                for statement in tree.children[row.body]
                    declare-ids(statement)
        if content && !lines
            raise-elements(row.body)
        else if !lines
            place-elements(row.body)
        . builds = is-constructor-body(id) && !returns-own(tree, id)
        . lazies-end = names.length as U32
        if is-constructor-body(id)
            mark-initializers(row.body)
        if builds
            hide-initializers(row.body)
        . given = id == class-lines
        . ruled = id == rule-lines
        . dead = false
        for statement in tree.children[row.body]
            if reached && !given-assign && !(ruled && tree.rule-part(statement))
                if !content
                    raise-element(statement)
                walk-statement(statement, builds, lazies-end)
                if given && is-live(statement)
                    walk-attribute(statement)
            .. reached = (!dead || is-lazy-declare(statement)) && !is-finally(statement)
            .. given-assign = given && tree.nodes[statement] is .node-assign
            dead = dead || (!content && leaves-block(statement))
        dead = false
        for statement in tree.children[row.body]
            if !dead && is-finally(statement)
                walk(statement)
            dead = dead || (!content && leaves-block(statement))
        if builds
            initializer-positions.clear()
        pop-scope()
    | .node-declare(row)
        if row-getters.find(id) != null
            walk(row.right)
            note-getter-reads(id, row.right)
            declare-pattern(row.left, .slot-local, 0, 0)
            do match? tree.nodes[row.left]
                | .node-type-capture(capture)
                    bindings.set-getter(bindings.resolution-of(binding, capture.id).slot, id)
        else if row.is-lazy
            . rule = row.is-pattern || tree.nodes[row.right] is .node-stream-match
            . coded = valued-pattern && !(tree.nodes[row.right] is .node-stream-match)
                .. valued-pattern = row.is-pattern && row.right != 0
            . machine = if !row.is-pattern then tree.declared-machine(row.right) else 0
            . named = tree.declared-local(row.left)
            lazy-depth += 1
            if rule
                if stream-reach == 0 && function-depth == 0 && !lookup-slot(stream-name)
                    . site = row.left
                    do match? tree.nodes[row.left]
                        | .node-type-capture(capture)
                            site = capture.id
                    bindings.diagnostics.append(Diagnostic(module, site, .stream-not-found, null))
                stream-reach += 1
                push-scope(.scope-arm, row.right)
            if coded
                coded-depth += 1
            if machine != 0 && named != 0
                machine-bound = bindings.resolution-of(binding, named).slot
                machine-valued = machine
            walk(if machine != 0 then tree.declared-value(row.right) else row.right)
            machine-valued = 0
            machine-bound = no-slot
            if coded
                coded-depth -= 1
            if rule
                pop-scope()
                stream-reach -= 1
            lazy-depth -= 1
            walk-live(id)
        else if !row.is-pattern && tree.declared-machine(row.right) != 0 && local-named
            declare-pattern(row.left, .slot-local, 0, 0)
            machine-bound = bindings.resolution-of(binding, tree.declared-local(row.left)).slot
            machine-valued = tree.declared-machine(row.right)
            walk(machine-valued)
            machine-valued = 0
            machine-bound = no-slot
        else
            walk(row.right)
            redeclaring = id
            declare-pattern(row.left, .slot-local, 0, 0)
            redeclaring = 0
        .. local-named = tree.declared-local(row.left) != 0
    | .node-identifier(row)
        . flags = if row.is-tracked then (ResolutionFlag.resolution-tracked) else 0u32
        resolve(id, row.name, flags)
    | .node-ref-identifier(row)
        resolve(id, row.name, ResolutionFlag.resolution-ref)
    | .node-assign(row)
        walk(row.rhs)
        . target = identifier-name(tree, row.lhs)
        if target
            . assignment = if row.op == .eq-op then id else 0u32
            resolve(row.lhs, target, ResolutionFlag.resolution-write, assignment)
        else
            walk(row.lhs)
        walk-live(id)
    | .node-iterable-expression(row)
        walk(row.expr)
        walk-stream(id)
    | .node-get-expression(row)
        do match tree.nodes[row.object]
            | .node-identifier(root)
                if row.is-tracked && !root.is-tracked
                    resolve(row.object, root.name, ResolutionFlag.resolution-tracked)
                else
                    walk(row.object)
            ??
                walk(row.object)
    | .node-function-syntax(row)
        walk-nested(id, row.args, row.body)
    | .node-if-block(row)
        if is-branch(id)
            walk-branch(id)
        else
            branch-depth += 1
            walk-condition(id, row.condition, row.body)
            walk(row.next)
            branch-depth -= 1
    | .node-while-block(row)
        push-scope(.scope-loop, id)
        loop-depth += 1
        walk-condition(id, row.condition, row.body)
        loop-depth -= 1
        pop-scope()
    | .node-assertion-syntax(row)
        branch-depth += 1
        walk(row.exception)
        walk(row.condition)
        branch-depth -= 1
    | .node-latest-expression(row)
        branch-depth += 1
        walk(row.expr)
        branch-depth -= 1
        walk-latest(id)
    | .node-state-machine
        walk-machine(id)
    | .node-held-expression(row)
        walk-held(id, row.expr)
    | .node-use-expression(row)
        walk(row.expr)
        . keeper = bindings.slots.append(keeper-slot) as SlotId
            .. keeper-slot = Slot(.slot-use, using-name, id, current-scope, decl, 0, 0)
        . declares = ResolutionFlag.resolution-declares
        bindings.set-resolution(binding, id, Resolution(.resolve-slot, 0, keeper, 0, declares))
    | .node-held-read
        if held != no-slot
            bindings.set-resolution(binding, id, Resolution(.resolve-slot, 0, held, 0, 0))
    | .node-binary-expression(row)
        . short-circuit = logical || row.op == .coalesce-op || row.op == .else-op
            .. logical = row.op == .and-op || row.op == .or-op
        if short-circuit || row.op == .if-op
            branch-depth += 1
        if tree.piped-bullet(id) == 0
            walk(row.lhs)
        . streams = row.op == .stream-pattern-pipe-op
        if streams
            stream-reach += 1
        if streams && nested-decl-for(id) != 0
            walk-pattern-pipe(id, row.rhs)
        else if nested-decl-for(id) != 0 && !is-live(id)
            walk-pipeline-body(id, row.rhs, row.op == .pipe-closure-op)
        else if row.op == .pipe-forward-op
            resolve-callable(row.rhs)
        else if is-type-test(row.op)
            walk-tested(id, row.rhs)
        else
            walk(row.rhs)
        if streams
            stream-reach -= 1
        if row.op == .pipe-write-each-op
            declare-loop-state(id)
        if short-circuit || row.op == .if-op
            branch-depth -= 1
    | .node-markup(row)
        if is-slot-builder(id)
            walk-slot(id, row.id, row.type-id, row.body)
        else
            walk-markup(id, row.id, row.type-id, row.body)
    | .node-slot-outlet(row)
        if is-branch(row.slot-parameter)
            walk-outlet-region
                - id
                - row.name
                - row.slot-parameter
                - row.style-rule-applications
                - row.body
        else
            walk-outlet(row.name, row.slot-parameter, row.style-rule-applications, row.body)
    | .node-markup-slot-forward(row)
        if fills && function-depth != 0
            use-slot
                - builder-of(identifier-name(tree, row.slot-binding) ?? program.store-atom(""))
                - 0
                - 0
    | .node-for-block(row)
        if is-loop-region(id)
            walk-loop-region(id, row.loop, row.body)
        else if nested-decl-for(id) != 0
            walk-generator(id, row.loop, row.body)
        else
            walk-loop(row.loop, row.body)
        walk(row.next)
    | .node-iterator-expression(row)
        if is-broadcaster(id)
            walk-broadcaster(id, row.loop, row.body)
        else if nested-decl-for(id) != 0
            walk-generator(id, row.loop, row.body)
        else
            walk-loop(row.loop, row.body)
        walk(row.next)
    | .node-bullet-expression
        if nested-decl-for(id) != 0
            walk-bullets(id)
        else
            walk-bullet-items(id)
    | .node-pipeline-expression(row)
        if tree.piped-bullet(id) == 0
            walk(row.left)
        . streams = row.op == .stream-pattern-pipe-op
        if streams
            stream-reach += 1
        if streams && nested-decl-for(id) != 0
            walk-pattern-pipe(id, row.right)
        else if nested-decl-for(id) != 0 && !is-live(id)
            walk-pipeline-body(id, row.right, row.op == .pipe-closure-op)
        else if row.op == .pipe-forward-op
            resolve-callable(row.right)
        else
            walk(row.right)
        if streams
            stream-reach -= 1
        if row.op == .pipe-write-each-op
            declare-loop-state(id)
    | .node-loop-syntax
        walk-loop(id, 0)
    | .node-match-expression(row)
        if is-branch(id)
            walk-match-region(id, row.subject)
            =
        walk(row.subject)
        if row.subject != 0 && tree.stream-statement(row.body) != 0
            push-scope(.scope-arm, id)
            declare(it-name, .slot-it, id, SlotFlag.slot-constant, 0)
            stream-reach += 1
            walk(row.body)
            stream-reach -= 1
            pop-scope()
        else if row.subject != 0
            stream-reach += 1
            walk(row.body)
            stream-reach -= 1
        else
            walk(row.body)
        walk(row.helper)
    | .node-structure-match(row)
        branch-depth += 1
        walk-arms(row.pattern)
        branch-depth -= 1
    | .node-stream-match(row)
        if stream-reach == 0 && function-depth == 0 && !lookup-slot(stream-name)
            bindings.diagnostics.append(Diagnostic(module, id, .stream-not-found, null))
            =
        walk(row.helper)
        . floor = capture-floor
        capture-floor = names.length as U32
        stream-reach += 1
        branch-depth += 1
        hoist-lazies(row.pattern)
        walk(row.pattern)
        branch-depth -= 1
        stream-reach -= 1
        capture-floor = floor
        closed-matches += id
    | .node-stream-transform(row)
        walk(row.pattern)
        push-scope(.scope-arm, id)
        if row.pattern != 0
            declare(it-name, .slot-it, id, SlotFlag.slot-constant, 0)
        declare(location-name, .slot-location, id, SlotFlag.slot-constant, 0)
        walk-action(row.right)
        pop-scope()
    | .node-stream-predicate(row)
        push-scope(.scope-arm, id)
        declare(it-name, .slot-it, id, SlotFlag.slot-constant, 0)
        walk(row.predicate)
        pop-scope()
    | .node-catch-expression(row)
        guard-depth += 1
        if row.catchers.count == 1 && tree.transformer-exception(row.body, row.catchers) != 0
            walk-transformer(row.body, row.catchers)
        else
            walk(row.body)
            for catcher in tree.children[row.catchers]
                walk(catcher)
        guard-depth -= 1
    | .node-catch-optional-expression
        guard-depth += 1
        for child in tree.children-of(id)
            walk(child)
        guard-depth -= 1
    | .node-optional-chain
        guard-depth += 1
        for child in tree.children-of(id)
            walk(child)
        guard-depth -= 1
    | .node-catcher(row)
        push-scope(.scope-catch, id)
        declare-pattern(row.type, .slot-pattern, SlotFlag.slot-constant, 0)
        walk(row.body)
        pop-scope()
    | .node-use-block(row)
        walk(row.subject)
        push-scope(.scope-use, id)
        walk(row.body)
        pop-scope()
    | .node-do-task-block(row)
        walk(row.worker)
        if !row.detached
            own-task(id)
        walk-nested(id, RowRange'SyntaxId(), row.body, row.catchers)
    | .node-do-block(row)
        check-effect-names(id, row.bans, null)
        if nested-decl-for(id) != 0
            walk-nested(id, RowRange'SyntaxId(), row.body)
        else
            push-scope(.scope-do, id)
            walk(row.body)
            pop-scope()
    | .node-do-finally-block(row)
        guard-depth += 1
        push-scope(.scope-do, id)
        walk(row.body)
        pop-scope()
        guard-depth -= 1
    | .node-stack-local-binding-block(row)
        walk(row.value)
        resolve-stack-local(id, row.name)
        walk(row.body)
    | .node-call-expression(row)
        resolve-callable(row.callable)
        for arg in tree.children[row.args]
            walk(arg)
    | .node-cast-expression(row)
        walk(row.lhs)
    | .node-type-predicate(row)
        walk(row.expr)
    | .node-type-equality(row)
        walk(row.expr)
    | .node-type-capture
        declare-pattern(id, .slot-pattern, SlotFlag.slot-constant, 0)
    | .node-stream-capture(row)
        declare-capture(row.name)
        walk(row.pattern)
    | .node-stream-call(row)
        . saved = in-callee
        in-callee = true
        resolve(id, row.name, 0, 0, true)
        in-callee = saved
        for child in tree.children[row.params]
            walk(child)
        for child in tree.children[row.args]
            walk(child)
        for child in tree.children[row.collector-mappings]
            walk(child)
    | .node-type-identifier
        =
    | .node-type-arguments
        =
    | .node-type-associated
        =
    | .node-type-optional
        =
    | .node-type-tuple
        =
    | .node-type-transform
        =
    | .node-type-panic
        =
    | .node-type-and
        =
    | .node-type-or
        =
    | .node-type-relation
        =
    | .node-type-match
        =
    | .node-type-wildcard
        =
    | .node-type-remainder
        =
    | .node-type-list
        =
    | .node-type-map
        =
    | .node-type-map-item
        =
    | .node-type-function
        =
    | .node-type-iterable
        =
    | .node-type-case
        =
    | .node-type-property
        =
    | .node-type-numeric
        =
    | .node-class-block
        =
    | .node-extension
        =
    | .node-style-sheet-extension
        =
    | .node-property-syntax(row)
        . named = if fills then tree.content-property-name(id) else 0u32
        if named != 0
            walk(row.value)
            resolve(named, identifier-name(tree, named)!, ResolutionFlag.resolution-write, id)
            walk-live(id)
    | .node-import-syntax
        =
    | .node-probe
        walk-probe(id)
    | .node-probe-assign
        walk-probe(id)
    | .node-probe-counter
        walk-probe(id)
    | .node-probe-group
        walk-probe(id)
    | .node-probe-scope(row)
        if program.compiles-probe(module, decl, id)
            push-scope(.scope-block, id)
            predeclare-lazies(row.body)
            for statement in tree.children[row.body]
                walk(statement)
            pop-scope()
    | .node-unary-expression(row)
        if row.op != .facts-of-op
            walk(row.operand)
    | .node-style-read-expression(row)
        if row.object == 0
            capture-self()
        else
            walk(row.object)
    ??
        for child in tree.children-of(id)
            walk(child)

────────────────────
_ do walk-probe Void
    - id SyntaxId

branch-depth += 1
for child in tree.children-of(id)
    walk(child)
branch-depth -= 1

────────────────────
_ do walk-condition Void
    - id SyntaxId
    - condition SyntaxId
    - body SyntaxId

` An if or while condition that is a structure match scopes its captures over the body.
. pattern = match-pattern(condition)
if pattern != 0
    push-scope(.scope-arm, id)
    declare-pattern(pattern, .slot-pattern, SlotFlag.slot-constant, 0)
    walk(body)
    pop-scope()
else
    walk(condition)
    walk(body)

────────────────────
_ match-pattern SyntaxId
    - id SyntaxId

match tree.nodes[id]
    | .node-structure-match(row)
        row.pattern
    ??
        0

────────────────────
_ do walk-nested Void
    - id SyntaxId
    - args RowRange'SyntaxId
    - body SyntaxId
    - handlers RowRange'SyntaxId = RowRange'SyntaxId()

` A lambda, a task body or the body of a `do without gc` block: its own scope, argument slots,
` and capture pool. Captures gather while the body walks and are rowed when it closes,
` innermost first. A task's handlers run in the task, after its body, so they are bound in
` its scope as well.
push-scope(.scope-nested, id)
function-depth += 1
open-nested(id)
for arg in tree.children[args]
    do match? tree.nodes[arg]
        | .node-argument-decl(row)
            declare-pattern(row.pattern, .slot-argument, 0, 0)
for arg in tree.children[args]
    do match? tree.nodes[arg]
        | .node-argument-decl(row)
            walk(row.default-value)
walk(body)
for handler in tree.children[handlers]
    walk(handler)
close-nested()
function-depth -= 1
pop-scope()

────────────────────
_ written-as-content Bool
    - id SyntaxId

` Whether a state machine is written as a line of the markup of the class whose object the
` function being bound fills.
fills && tree.content-machines(bindings.scopes[content-home].syntax).find(id) != null

────────────────────
_ do walk-machine Void
    - id SyntaxId

` A state machine where it is written, a function of its own. A machine written as a
` statement, no value of a property or a declaration, first projects each case into the scope
` it is written in under the case's name, which no local of the function may have; one written
` as a line of a class's markup projects them as properties of the object instead.
` In its own function what it keeps is declared first, as slots no program names
` (`declare-machine`), and then its parts are bound; the flags of one declared into a local
` are declared beside the local. It captures the projections, the local it is declared into
` and those flags, which it writes, and the object of the function that starts it. A named
` machine written in one of its cases is part of it.
. decl = nested-decl-for(id)
if decl == 0
    =
. depth = function-depth
. items = tree.state-items(tree.state-body(id))
. cases = tree.machine-cases(items)
. kept = tree.machine-captures(items, cases)
. bound = machine-bound
. projects = machine-valued != id && !written-as-content(id)
machine-bound = no-slot
machine-valued = 0
. projections [SlotId]
if projects
    for node in cases
        . name = tree.state-name(node)!
        . found = lookup-position(name)
        if found && name-depths[found] == depth
            . message = program.store-atom("State projection '${name.text}' already exists")
            bindings.diagnostics.append(Diagnostic(module, id, .stated, message))
            break
        projections += declare(name, .slot-machine, id, 0, 0)
. first = bindings.slots.length
. flagged = bound != no-slot
if flagged
    for node in cases
        hide(active-name, node)
push-scope(.scope-nested, id)
function-depth += 1
open-nested(id)
declare-machine(id, items, cases, kept, flagged)
. last = bindings.slots.length
bindings.machines.append
    - MachineSlots(module, id, decl, RowRange'Slot(first as U32, (last - first) as U32), bound)
for slot in projections
    use-slot(slot, depth, ResolutionFlag.resolution-write)
if flagged
    use-slot(bound, depth, ResolutionFlag.resolution-write)
    for offset in 0 .. < cases.length
        use-slot(first + offset as U32, depth, ResolutionFlag.resolution-write)
. self = lookup-position(this-name)
if self
    use-slot(name-slots[self], name-depths[self], 0)
machine-cases += cases
machine-kept += kept
machine-roots += items
owning-cases += 0
state-depth += 1
walk-entered(0, items)
for item in items
    if tree.is-transition(item)
        walk-case(item)
walk-handlers(items)
state-depth -= 1
owning-cases.pop()
machine-cases.pop()
machine-kept.pop()
machine-roots.pop()
close-nested()
function-depth -= 1
pop-scope()

────────────────────
_ do walk-nested-machine
    - item SyntaxId

` A named machine written in a case of another, as the reference builds it: part of the
` function of the machine around it, whose environment holds what it keeps and the name the
` property declares, which holds the machine's value, declared as a machine's is
` (`declare-machine`), and whose parts are bound as that machine's are.
. id = tree.nested-machine(item)
. items = tree.state-items(tree.state-body(id))
. cases = tree.machine-cases(items)
. kept = tree.machine-captures(items, cases)
. bound = no-slot
do match? tree.nodes[item]
    | .node-property-syntax(row)
        declare-pattern(row.left, .slot-local, 0, 0)
        bound = bindings.resolution-of(binding, tree.declared-local(row.left)).slot
if bound != no-slot
    bindings.mark-slot(bound, SlotFlag.slot-captured)
. first = bindings.slots.length
. owner = if nested-decls.length != 0 then nested-decls[nested-decls.length - 1] else decl
declare-machine(id, items, cases, kept, false)
bindings.machines.append
    - MachineSlots
        - module
        - id
        - owner
        - RowRange'Slot(first as U32, (bindings.slots.length - first) as U32)
        - bound
machine-cases += cases
machine-kept += kept
machine-roots += items
owning-cases += 0
walk-entered(0, items)
for item in items
    if tree.is-transition(item)
        walk-case(item)
walk-handlers(items)
owning-cases.pop()
machine-cases.pop()
machine-kept.pop()
machine-roots.pop()

────────────────────
_ do declare-machine
    - id SyntaxId
    - items [SyntaxId]
    - cases [SyntaxId]
    - kept [[Atom]]
    - flagged Bool

` A machine's value, and for each case its flag, where it was not declared beside the local
` the machine is kept in, generation, payload where one is given, and each name it keeps from
` what entered it; for each group of event transitions its subscriber and source. The
` machine's environment holds each.
hide(machine-value-name, id)
for position in 0 .. < cases.length
    . node = cases[position]
    if !flagged
        hide(active-name, node)
    hide(generation-name, node)
    if tree.spawns-in-case(items, node)
        tasks-cases += node
        tasks-slots += bindings.slots.length as SlotId
        hide(tasks-name, node)
    if tree.payload-source(items, tree.state-name(node)!)
        hide(payload-name, node)
    for name in kept[position]
        hide(program.store-atom("(kept ${name.text})"), node)
hide-groups(items)

────────────────────
_ do hide-groups
    - items [SyntaxId]

for head in tree.group-heads(items)
    hide(subscriber-name, head)
    hide(source-name, head)
for item in items
    if tree.is-transition(item)
        hide-groups(tree.state-items(tree.state-body(item)))

────────────────────
_ do hide
    - name Atom
    - node SyntaxId

bindings.slots.append
    - Slot(.slot-machine, name, node, current-scope, decl, 0, SlotFlag.slot-captured)

────────────────────
_ do walk-entered Void
    - owner SyntaxId
    - items [SyntaxId]

` What runs where a machine starts, or once the entry statements of a case, its `owner`, have:
` what its first case is given where it is entered so (`enters-initial`), which a case never is
` where one of its immediate transitions always passes (`always-passes`), its immediate
` transitions, and the streams its groups subscribe to, each trigger with the slots of a loop,
` which one over a stream that is only iterable reads by.
. initial = if owner == 0 || !tree.always-passes(items) then tree.initial-case(items) else 0
if initial != 0 && tree.enters-initial(machine-roots[machine-roots.length - 1], owner)
    walk-targets(initial)
for transition in tree.immediate-transitions(items)
    . trigger = tree.state-trigger(transition)
    . subject = tree.trigger-subject(trigger)
    if trigger == 0
        walk-targets(transition)
    else if subject != 0
        walk(subject)
        push-scope(.scope-arm, transition)
        declare-pattern(tree.trigger-pattern(trigger), .slot-pattern, SlotFlag.slot-constant, 0)
        walk-targets(transition)
        pop-scope()
    else
        walk(tree.trigger-condition(trigger))
        walk-targets(transition)
for head in tree.group-heads(items)
    walk(tree.group-stream(head))
    declare-loop-state(tree.group-trigger(head))

────────────────────
_ do walk-targets Void
    - transition SyntaxId

` What a transition gives the case it enters, then what each name the case keeps reads there.
for target in tree.children[tree.state-targets(transition)]
    walk(target)
. cases = machine-cases[machine-cases.length - 1]
. position = tree.case-position(cases, tree.state-name(transition)!)
if position == null
    =
for name in machine-kept[machine-kept.length - 1][position]
    . found = lookup-position(name)
    . slot = no-slot
    if found
        slot = name-slots[found]
        use-slot(slot, name-depths[found], 0)
    bindings.machine-reads.append(MachineRead(module, transition, name, slot))

────────────────────
_ do walk-case Void
    - node SyntaxId

` A case or a continuation. Its activation is a scope of its own, which runs anew each time it
` is bound, where the names it was given and the names it keeps are declared. There its entry
` statements run in a scope of
` their own, with what runs once they have; then come its cases, the functions its groups run,
` and the `do finally` blocks of its exit in a scope of their own, beyond the entry's locals. A
` named machine among its entry statements is part of the machine (`walk-nested-machine`).
` Tasks its entry statements and handlers spawn are the activation's of the case it enters, where
` that case owns tasks (`owning-case`); those its `do finally` blocks spawn are not.
. items = tree.state-items(tree.state-body(node))
owning-cases += owning-case(node)
push-scope(.scope-activation, node)
declare-activation(node)
push-scope(.scope-block, node)
predeclare-lazies(tree.state-body(node))
for item in items
    if tree.nested-machine(item) != 0
        walk-nested-machine(item)
    else if tree.is-entry-item(item)
        walk(item)
walk-entered(node, items)
pop-scope()
for item in items
    if tree.is-transition(item)
        walk-case(item)
walk-handlers(items)
owning-cases += 0
push-scope(.scope-block, node)
for item in items
    if tree.nodes[item] is .node-do-finally-block
        walk(item)
pop-scope()
pop-scope()
owning-cases.pop()
owning-cases.pop()

────────────────────
_ do declare-activation
    - node SyntaxId

` The names an activation of a case sees: those among what it was given, then those it keeps,
` each a constant declared at the case or continuation.
. names [Atom]
tree.target-names(node, names)
. cases = machine-cases[machine-cases.length - 1]
. position = tree.case-position(cases, tree.state-name(node)!)
if position != null
    for name in machine-kept[machine-kept.length - 1][position]
        if names.find(name) == null
            names += name
for name in names
    declare(name, .slot-local, node, SlotFlag.slot-constant, 0)

────────────────────
_ do walk-handlers Void
    - items [SyntaxId]

` The function each group of a body's event transitions runs for an item: `each` and `it` are
` the item, and each transition tests its pattern and guard and gives its targets in an arm
` of its own; a handler's loop binds its pattern, tests its `when` and runs its body there.
for head in tree.group-heads(items)
    push-scope(.scope-block, head)
    declare(each-name, .slot-each, head, SlotFlag.slot-constant, 0)
    declare(it-name, .slot-it, head, SlotFlag.slot-constant, 0)
    if tree.is-state-handler(head)
        walk-state-handler(head)
        pop-scope()
        continue
    for transition in tree.group-transitions(items, head)
        . trigger = tree.state-trigger(transition)
        push-scope(.scope-arm, transition)
        declare-pattern(tree.trigger-pattern(trigger), .slot-pattern, SlotFlag.slot-constant, 0)
        walk(tree.trigger-guard(trigger))
        walk-targets(transition)
        pop-scope()
    pop-scope()

────────────────────
_ do walk-state-handler Void
    - head SyntaxId

do match? tree.nodes[head]
    | .node-for-block(row)
        do match? tree.nodes[row.loop]
            | .node-loop-syntax(loop)
                push-scope(.scope-arm, row.loop)
                declare-pattern(loop.pattern, .slot-pattern, SlotFlag.slot-constant, 0)
                do match? tree.nodes[loop.clause]
                    | .node-clause(clause)
                        walk(clause.expr)
                walk(row.body)
                pop-scope()

────────────────────
_ do open-nested
    - syntax SyntaxId

. decl = nested-decl-for(syntax)
. by-value = false
do match? program.modules[module].decls[decl]
    | .decl-function(row)
        by-value = row.kind == .task-decl || row.kind == .region-decl
nested-decls += decl
nested-syntax += syntax
nested-scopes += current-scope
nested-depths += function-depth
nested-by-value += by-value
nested-marks += capture-slots.length

────────────────────
_ do close-nested

` Rows the innermost open nested function: its captures move from the scratch pool into the
` store in first-reference order, and the entries of the enclosing functions stay behind.
. frame = nested-decls.length - 1
. mark = nested-marks[frame]
. start U32 = bindings.captures.length as U32
. kept = mark
. written = function-of(bindings.scopes[nested-scopes[frame]].parent)
for position in mark .. < capture-slots.length
    if capture-frames[position] == frame
        . slot = capture-slots[position]
        bindings.record-capture(slot, capture-flags[position])
        if lazy-slot && function-of(bindings.slots[slot].scope) == written
            bindings.note-lazy-capture(slot, lazy-depth != 0)
        .. lazy-slot = bindings.slots[slot].kind == .slot-lazy
    else
        capture-frames[kept] = capture-frames[position]
        capture-slots[kept] = capture-slots[position]
        capture-flags[kept] = capture-flags[position]
        kept += 1
while capture-slots.length > kept
    capture-frames.pop()
    capture-slots.pop()
    capture-flags.pop()
. captures = bindings.captures-from(start)
. row = NestedFunction(nested-decls[frame], nested-syntax[frame], nested-scopes[frame], captures)
bindings.nested.append(row)
nested-decls.pop()
nested-syntax.pop()
nested-scopes.pop()
nested-depths.pop()
nested-by-value.pop()
nested-marks.pop()

────────────────────
_ is-owner-scanned-decl Bool
    - decl DeclId

` A comprehension, bullet list, or pipeline body closure row: the reference compiler scans its
` body as part of its owner, so it gets an empty scan row of its own and no interval.
match program.modules[module].decls[decl]
    | .decl-function(fn)
        fn.kind == .iterator-decl || fn.kind == .bullet-decl || fn.kind == .pipeline-decl
    ??
        false

────────────────────
_ nested-decl-for DeclId
    - syntax SyntaxId

` The nested function declared at a node, or none. The module's index answers, so a node
` costs the same however many functions its module declares.
nested-index[((module as U64) /lshift/ 32) /or/ syntax] ?? 0

────────────────────
+ do forget-module
    - forgotten ModuleId

if forgotten < indexed.length
    indexed[forgotten] = false
. wide U64 = forgotten
. nested [U64]
for key, _ in nested-index
    if (key /rshift/ 32) == wide
        nested += key
for key in nested
    -= nested-index[key]
. typed [U64]
for key, _ in type-index
    if (key /rshift/ 32) == wide
        typed += key
for key in typed
    -= type-index[key]

────────────────────
_ do index-module

` Indexes a module's declarations the first time one of its functions is bound: the nested
` function and the class or extension at each node, and the functions a scan steps over, in
` the order of their nodes.
` A module's declarations are all made before any is bound.
while indexed.length <= module
    indexed += false
    skipped-first += 0
    skipped-count += 0
if indexed[module]
    =
indexed[module] = true
. wide U64 = module
. keys [U64]
. index = 0u32
for row in program.modules[module].decls
    . stepped SyntaxId = 0
    do match? row
        | .decl-function(fn)
            if is-nested-kind(fn.kind)
                . key = (wide /lshift/ 32) /or/ fn.syntax
                if nested-index[key] == null
                    nested-index[key] = index
            else if !fn.is-generated && fn.kind != .main-decl
                stepped = fn.syntax
        | .decl-class(class)
            . key = (wide /lshift/ 32) /or/ class.syntax
            if type-index[key] == null
                type-index[key] = index
        | .decl-extension(extension)
            . key = (wide /lshift/ 32) /or/ extension.syntax
            if type-index[key] == null
                type-index[key] = index
        | .decl-sheet-extension(extension)
            . key = (wide /lshift/ 32) /or/ extension.syntax
            if type-index[key] == null
                type-index[key] = index
        | .decl-converter(fn)
            stepped = fn.syntax
        | .decl-fromverter(fn)
            stepped = fn.syntax
    if stepped != 0
        . node U64 = stepped
        keys += (node /lshift/ 32) /or/ index
    index += 1
. sorted = sort(keys)
skipped-first[module] = skipped.length as U32
skipped-count[module] = sorted.length as U32
for key in sorted
    skipped += key

────────────────────
_ do record-capture
    - slot SlotId
    - depth U32
    - by-value Bool
    - flags ResolutionMask = 0
    - owner = false

` Every open nested function between the reference and the declaring function records the
` slot once, which is how the TypeScript compiler threads a value through chained closure
` callbacks. Task bodies and `this` capture by value. A capture notes whether the function
` assigns the slot. The body of a `do without gc` block runs where it is written, and takes the
` address of each local and argument it captures there. A receiver captured for anything but the
` `owner` of a task spawned inside is marked used, which a value of a struct cannot be.
if !owner && bindings.slots[slot].kind == .slot-this
    bindings.mark-slot(slot, SlotFlag.slot-self-used)
. assigned = if write-bit != 0 then CaptureFlag.capture-assigned else CaptureFlag.capture-none
    .. write-bit = flags /and/ (ResolutionFlag.resolution-write)
. kind = bindings.slots[slot].kind
. held = kind == .slot-local || kind == .slot-argument
. total = nested-decls.length
for reverse in 0 .. < total
    . frame = total - 1 - reverse
    if nested-depths[frame] <= depth
        =
    . position = frame-capture(frame, slot)
    if position
        capture-flags[position] = capture-flags[position] /or/ assigned
        continue
    . value = by-value || nested-by-value[frame]
    capture-frames += frame
    capture-slots += slot
    capture-flags += if value then ((CaptureFlag.capture-by-value) /or/ assigned) else assigned
    if held && is-region-frame(frame)
        bindings.mark-slot(slot, SlotFlag.slot-address-taken)

────────────────────
_ do frame-capture Size?
    - frame Size
    - slot SlotId

for position in nested-marks[frame] .. < capture-slots.length
    if capture-frames[position] == frame && capture-slots[position] == slot
        = position
= null

────────────────────
_ is-region-frame Bool
    - frame Size

match program.modules[module].decls[nested-decls[frame]]
    | .decl-function(row)
        row.kind == .region-decl
    ??
        false

────────────────────
_ do scan-body
    - syntax SyntaxId
    - range SyntaxRange

` A linear pass over the tag column of the binding's range. Every nested function of this
` binding gets its own scan row; every other declaration inside the range, which for main is
` every function of the module, is skipped. The module's index lists those by node, so only
` the ones inside the range are visited. Subtrees nest, so a stack holds the row in force.
` The binding row's nested count is filled by `finish`, so the rows appended since `reserve`
` are counted from the table.
. own = bindings.begin-scan(decl, syntax)
. nested-start = bindings.bindings[binding].nested.start
. nested-count = (bindings.nested.length) - nested-start
for offset in 0 .. < nested-count
    . nested = bindings.nested[nested-start + offset]
    . scan = bindings.begin-scan(nested.decl, nested.syntax)
    if !is-owner-scanned-decl(nested.decl)
        add-scan-interval(nested-subtree-start(nested), nested.syntax, scan)

. last = range.start + range.count - 1
. first = skipped-first[module]
. count = skipped-count[module]
. bound U64 = range.start
bound = bound /lshift/ 32
. low = 0u32
. high = count
while low < high
    . middle = (low + high) / 2
    if skipped[first + middle] < bound
        low = middle + 1
    else
        high = middle
while low < count
    . entry = skipped[first + low]
    . node = (entry /zrshift/ 32) as SyntaxId
    if node > last
        break
    . index = (entry /and/ 0xffffffff) as DeclId
    if index != decl
        . start = 0u32
        do match? program.modules[module].decls[index]
            | .decl-function(fn)
                start = fn.subtree.start
        if start == 0
            start = tree.subtree-start(node)
        add-scan-interval(start, node, U32.max)
    low += 1

. next = 0
for offset in 0 .. < range.count
    . id = range.start + offset
    while next < scan-starts.length && scan-starts[next] == id
        . row = scan-rows[next]
        if scan-stack-rows.length != 0 && scan-stack-rows[scan-stack-rows.length - 1] == U32.max
            row = U32.max
        scan-stack-rows += row
        scan-stack-ends += scan-ends[next]
        next += 1
    . target = own
    if scan-stack-rows.length != 0
        target = scan-stack-rows[scan-stack-rows.length - 1]
    if target != U32.max
        scan-node(target, id)
    while scan-stack-ends.length != 0 && scan-stack-ends[scan-stack-ends.length - 1] == id
        . closed = scan-stack-rows.pop()
        scan-stack-ends.pop()
        if closed != U32.max
            . parent = own
            if scan-stack-rows.length != 0
                parent = scan-stack-rows[scan-stack-rows.length - 1]
            if parent != U32.max
                bindings.record-scan(parent, .scan-nested-function, id)

────────────────────
_ do nested-subtree-start SyntaxId
    - nested NestedFunction

do match? program.modules[module].decls[nested.decl]
    | .decl-function(fn)
        if fn.syntax == nested.syntax
            = fn.subtree.start
= tree.subtree-start(nested.syntax)

────────────────────
_ do add-scan-interval
    - start SyntaxId
    - end SyntaxId
    - row U32

` Kept sorted by start, then by the wider subtree first, so the scan pushes an enclosing
` function before the functions that begin on its first node.
scan-starts += start
scan-ends += end
scan-rows += row
. position = scan-starts.length - 1
while position != 0 && interval-precedes(position, position - 1)
    . start-swap = scan-starts[position - 1]
    . end-swap = scan-ends[position - 1]
    . row-swap = scan-rows[position - 1]
    scan-starts[position - 1] = scan-starts[position]
    scan-ends[position - 1] = scan-ends[position]
    scan-rows[position - 1] = scan-rows[position]
    scan-starts[position] = start-swap
    scan-ends[position] = end-swap
    scan-rows[position] = row-swap
    position -= 1

────────────────────
_ interval-precedes Bool
    - left Size
    - right Size

earlier || (same-start && scan-ends[left] > scan-ends[right])

.. earlier = scan-starts[left] < scan-starts[right]
.. same-start = scan-starts[left] == scan-starts[right]

────────────────────
_ do scan-node
    - target U32
    - id SyntaxId

do match? tree.nodes[id]
    | .node-yield
        bindings.record-scan(target, .scan-yield, id)
    | .node-identifier(row)
        if row.is-tracked
            bindings.record-scan(target, .scan-tracked-read, id)
    | .node-get-expression(row)
        if row.is-tracked
            bindings.record-scan(target, .scan-tracked-read, id)
    | .node-latest-expression
        bindings.record-scan(target, .scan-latest, id)
    | .node-use-expression
        bindings.record-scan(target, .scan-use-expression, id)
    | .node-use-block
        bindings.record-scan(target, .scan-use-block, id)
    | .node-do-finally-block
        bindings.record-scan(target, .scan-do-finally, id)
    | .node-stack-local-binding-block
        bindings.record-scan(target, .scan-stack-local, id)
    | .node-call-expression
        bindings.record-scan(target, .scan-call, id)
    | .node-assertion-syntax
        bindings.record-scan(target, .scan-assertion, id)
    | .node-unary-expression(row)
        if row.op == .optional-force-op
            bindings.record-scan(target, .scan-force, id)
    | .node-index-expression
        bindings.record-scan(target, .scan-index, id)

────────────────────
_ do own-task
    - id SyntaxId

` A task spawned where a case's activation owns it is given the slot the machine keeps the
` activation's record of its tasks in, which the functions around it capture, as the task
` block's resolution; any other is given the receiver, where there is one, for its object to own.
. tasks = activation-tasks()
if tasks == no-slot
    capture-self(true)
    =
use-slot(tasks, slot-depth(tasks), 0)
bindings.set-resolution(binding, id, Resolution(.resolve-slot, 0, tasks, 0, 0))

────────────────────
_ do activation-tasks SlotId

` The slot of the record of the tasks of the case whose activation owns what is spawned here, or
` none.
=? no-slot if owning-cases.length == 0
. case = owning-cases[owning-cases.length - 1]
=? no-slot if case == 0
for position in 0 .. < tasks-cases.length
    =? tasks-slots[position] if tasks-cases[position] == case
= no-slot

────────────────────
_ do owning-case SyntaxId
    - node SyntaxId

` The case among the machine's cases that a case or continuation enters, where its activation
` owns tasks, or none.
. name = tree.state-name(node)
=? 0 if !name || machine-cases.length == 0
. cases = machine-cases[machine-cases.length - 1]
. position = tree.case-position(cases, name)
=? 0 if position == null
. case = cases[position]
=? case if tasks-cases.find(case) != null
= 0

────────────────────
_ do capture-self
    - owner = false

` A member or method reached from a nested function needs `this`, which the TypeScript compiler
` captures by value at every closure scope on the way out, as does a task spawned there that its
` `owner` keeps.
. position = lookup-position(this-name)
if !position
    =
. depth = name-depths[position]
if depth < function-depth
    . slot = name-slots[position]
    bindings.mark-slot(slot, SlotFlag.slot-captured)
    record-capture(slot, depth, true, 0, owner)

────────────────────
_ do walk-generator Void
    - id SyntaxId
    - loop SyntaxId
    - body SyntaxId

` A comprehension compiled as a generator closure, or a loop on a stream compiled as its
` subscriber: the caller evaluates the first container, so it binds outside, as does a
` `whenever` clause (see `walk-whenever`); the loop with its other clauses, chained headers,
` and body binds inside the closure's own scope and captures like a lambda body.
do match? tree.nodes[loop]
    | .node-loop-syntax(row)
        walk-source(row)
walk-whenever(loop)
push-scope(.scope-nested, id)
function-depth += 1
open-nested(id)
walk-loop(loop, body, true)
close-nested()
function-depth -= 1
pop-scope()

────────────────────
_ do is-broadcaster Bool
    - id SyntaxId

` Whether a comprehension is one on a stream compiled as its subscriber.
. decl = nested-decl-for(id)
if decl == 0
    = false
do match? program.modules[module].decls[decl]
    | .decl-function(fn)
        = fn.kind == .subscriber-decl
= false

────────────────────
_ do walk-broadcaster Void
    - id SyntaxId
    - loop SyntaxId
    - body SyntaxId

` A comprehension on a stream compiled as its subscriber, which writes what its body gives to
` a channel the comprehension makes: the channel is a local no name reaches, declared at the
` comprehension, which the subscriber captures before anything its loop reads, as the
` reference's subscriber reads the channel from the scope it closes over. A `whenever` clause
` binds outside too (see `walk-whenever`).
do match? tree.nodes[loop]
    | .node-loop-syntax(row)
        walk-source(row)
walk-whenever(loop)
. flags = SlotFlag.slot-constant /or/ SlotFlag.slot-captured
. channel = bindings.slots.append(channel-slot) as SlotId
    .. channel-slot = Slot(.slot-local, channel-name, id, current-scope, decl, 0, flags)
. declares = ResolutionFlag.resolution-declares
bindings.set-resolution(binding, id, Resolution(.resolve-slot, 0, channel, 0, declares))
push-scope(.scope-nested, id)
function-depth += 1
open-nested(id)
record-capture(channel, function-depth - 1, false)
walk-loop(loop, body, true)
close-nested()
function-depth -= 1
pop-scope()

────────────────────
_ do walk-bullets Void
    - id SyntaxId

` A bullet list compiled as a generator closure: every bullet's item binds inside the closure's
` own scope and captures like a lambda body.
push-scope(.scope-nested, id)
function-depth += 1
open-nested(id)
walk-bullet-items(id)
close-nested()
function-depth -= 1
pop-scope()

────────────────────
_ do walk-bullet-items Void
    - id SyntaxId

` The items along a bullet chain; the chain links are not walked as children. A bullet that
` gives every item of what it writes is a loop, and has the slots of one.
. bullet = id
while bullet != 0
    . next = 0u32
    do match? tree.nodes[bullet]
        | .node-bullet-expression(row)
            walk(row.item)
            if row.is-multi
                declare-loop-state(bullet)
            next = row.next
    bullet = next

────────────────────
_ do declare-loop-state
    - at SyntaxId

` The hidden slots of a loop at a node that heads none: a bullet that gives every item of
` what it writes, a pipe that writes each item of what it reads, or one that matches a
` pattern again and again on what it reads.
. state = bindings.slots.length as SlotId
for _ in 0 .. < loop-state-count
    bindings.slots.append(Slot(.slot-loop-state, state-name, at, current-scope, decl, 0, 0))
. declares U32 = ResolutionFlag.resolution-declares
bindings.set-resolution(binding, at, Resolution(.resolve-slot, 0, state, 0, declares))

────────────────────
_ do walk-pattern-pipe Void
    - id SyntaxId
    - pattern SyntaxId

` A stream piped through a pattern, compiled as a generator closure given the stream: the
` pattern binds inside the closure's own scope, beside the hidden slots of the loop that
` matches it again and again. What a bullet the pipe reads alone writes binds there too, as
` the closure evaluates it.
push-scope(.scope-nested, id)
function-depth += 1
open-nested(id)
declare-loop-state(id)
do match? tree.nodes[tree.piped-bullet(id)]
    | .node-bullet-expression(row)
        walk(row.item)
walk(pattern)
close-nested()
function-depth -= 1
pop-scope()

────────────────────
_ do walk-pipeline-body Void
    - id SyntaxId
    - body SyntaxId
    - whole Bool

` A map or filter body compiled as a closure taking `each`: the item binds inside the closure's
` own scope with no declaring syntax, as the reference declares its argument. A closure pipe
` takes the whole left value as `it`.
push-scope(.scope-nested, id)
function-depth += 1
open-nested(id)
if whole
    declare(it-name, .slot-it, id, SlotFlag.slot-constant, 0)
else
    declare(each-name, .slot-each, id, SlotFlag.slot-constant, 0)
walk(body)
close-nested()
function-depth -= 1
pop-scope()

────────────────────
_ do arrival-name SyntaxId
    - clause SyntaxId

` The name a loop's first clause tests where it is `when arrival` or `when bubbling`, or none.
do match? tree.nodes[clause]
    | .node-clause(row)
        if row.op is .when-clause
            do match? tree.nodes[row.expr]
                | .node-identifier(name)
                    if name.name.text == "arrival" || name.name.text == "bubbling"
                        = row.expr
= 0

────────────────────
_ do walk-loop Void
    - id SyntaxId
    - body SyntaxId
    - container-bound Bool = false
    - chained Bool = false

` A header of a loop, then the headers chained after it and the body. `each` and `it` are
` the item of the first header: one chained after it declares neither, as the reference
` binds them once for the loop, and neither is declared where its pattern declares the name
` itself (`declares-name`). The `whenever` clause of a loop on a stream binds where the
` loop is written, not here. A loop on a stream whose clause is `when arrival` or `when
` bubbling` may be one on an event, where that is no test: the name is not reported here when
` nothing declares it, and the type pass reports it where the loop is on no event. A header
` whose container is evaluated where its closure is made has one slot more, after its item,
` for the container it is given.
do match? tree.nodes[id]
    | .node-loop-syntax(row)
        if !container-bound
            walk-source(row)
        . streams = tree.is-stream-pattern(row.pattern)
        if streams
            stream-reach += 1
        push-scope(.scope-loop, id)
        loop-depth += 1
        if row.is-subscriber
            subscription-depth += 1
        . pattern = match-pattern(row.pattern)
        . item-pattern = if pattern != 0 then pattern else row.pattern
        . patterned = bindings.slots.length as SlotId
        if streams
            hoist-lazies(row.pattern)
            walk(row.pattern)
        else
            declare-pattern(item-pattern, .slot-loop-item, 0, 0)
        . named = names-item(item-pattern)
        . implicit = no-slot
        . each-free = !declares-name(patterned, each-name)
        if !chained && each-free && (!named || !lookup-slot(each-name))
            implicit = declare(each-name, .slot-each, id, SlotFlag.slot-constant, 0)
        if !chained && !declares-name(patterned, it-name) && (!named || !lookup-slot(it-name))
            . it-slot = declare(it-name, .slot-it, id, SlotFlag.slot-constant, 0)
            if implicit == no-slot
                implicit = it-slot
        . state = bindings.slots.length as SlotId
        . kept = if container-bound then loop-state-count + 1 else loop-state-count
        for _ in 0 .. < kept
            bindings.slots.append(Slot(.slot-loop-state, state-name, id, current-scope, decl, 0, 0))
        . declares U32 = ResolutionFlag.resolution-declares
        . first = if implicit != no-slot then implicit else state
        bindings.set-resolution(binding, id, Resolution(.resolve-slot, 0, first, 0, declares))
        quiet-name = if row.is-subscriber then arrival-name(row.clause) else 0
        . retested = tree.whenever-clause(id)
        walk-clauses(row.clause, if nested-decl-for(retested) != 0 then retested else 0)
        quiet-name = 0
        if row.next != 0
            walk-loop(row.next, body, false, true)
        else if content-turns.find(body) != null && !(tree.nodes[body] is .node-block)
            walk-line(body)
        else
            walk(body)
        if row.is-subscriber
            subscription-depth -= 1
        loop-depth -= 1
        pop-scope()
        if streams
            stream-reach -= 1

────────────────────
_ do walk-source Void
    - row ASTLoop

` The container of a loop's first header. That of a handler, which names the event it subscribes
` to, is the one name a row of a markup element's body reads as a member of the element.
. around = event-source
event-source = if row.is-subscriber then row.container else 0
walk(row.container)
event-source = around

────────────────────
_ do walk-line Void
    - line SyntaxId

` A body of markup content written as one line, which runs as a block of that line would: the
` line declares the name its markup element is given and those of the elements written as
` lines of its body, and what makes those objects is walked first.
push-scope(.scope-block, line)
note-content-line(line)
declare-ids(line)
raise-element(line)
walk(line)
pop-scope()

────────────────────
_ do walk-clauses Void
    - clause SyntaxId
    - skipped SyntaxId

` The clauses of a loop's header in order, but for the one `skipped`.
. current = clause
while current != 0
    . next SyntaxId = 0
    do match? tree.nodes[current]
        | .node-clause(row)
            if current != skipped
                walk(row.expr)
            next = row.next
    current = next

────────────────────
_ do walk-whenever Void
    - loop SyntaxId

` The `whenever` clause of a loop on a stream, which the function the loop is written in tests
` before it subscribes, as the reference compiles it: its value binds there, beside three
` locals no name reaches, declared at the clause, which hold what it last gave, the
` subscription and the broadcaster. The function that tests it again captures them, and every
` local, argument and receiver the value reads, and the list of subscribers of each local it
` reads tracked.
. clause = tree.whenever-clause(loop)
if clause == 0 || nested-decl-for(clause) == 0
    =
do match? tree.nodes[clause]
    | .node-clause(row)
        walk(row.expr)
. kept = SlotFlag.slot-constant /or/ SlotFlag.slot-captured
. changes = SlotFlag.slot-assigned /or/ SlotFlag.slot-captured
. passed = bindings.slots.append(passed-slot) as SlotId
    .. passed-slot = Slot(.slot-local, whenever-name, clause, current-scope, decl, 0, changes)
bindings.slots.append(Slot(.slot-local, subscription-name, clause, current-scope, decl, 0, kept))
bindings.slots.append(Slot(.slot-local, broadcaster-name, clause, current-scope, decl, 0, kept))
. declares = ResolutionFlag.resolution-declares
bindings.set-resolution(binding, clause, Resolution(.resolve-slot, 0, passed, 0, declares))
. slots [SlotId]
slots += passed
slots += passed + 1
slots += passed + 2
note-reads(clause, slots)
capture-in(clause, slots)

────────────────────
_ is-finally Bool
    - statement SyntaxId

` A finally block runs as its enclosing block ends, so it sees every local the block declares.
match tree.nodes[statement]
    | .node-do-finally-block
        true
    ??
        false

────────────────────
_ leaves-block Bool
    - statement SyntaxId

` Whether a statement leaves its block, so that nothing after it runs: a raise under no
` condition, a return, `continue` or `break`. `=? value` may leave only where the value is
` present, and so does not.
match tree.nodes[statement]
    | .node-assertion-syntax(row)
        row.condition == 0
    | .node-return(row)
        row.expr == 0 || !(tree.nodes[row.expr] is .node-optional-chain)
    | .node-continue
        true
    | .node-break
        true
    ??
        false

────────────────────
_ is-lazy-declare Bool
    - statement SyntaxId

match tree.nodes[statement]
    | .node-declare(row)
        row.is-lazy
    ??
        false

────────────────────
_ do declares-name Bool
    - first SlotId
    - name Atom

` Whether a slot declared from `first` on is named `name`.
for slot in first .. < bindings.slots.length
    if bindings.slots[slot].name == name
        = true
= false

────────────────────
_ names-item Bool
    - pattern SyntaxId

` A loop that names its item leaves an enclosing `each` and `it` in reach; one that does not
` binds them to its own item.
|? pattern == 0
    false
??
    match tree.nodes[pattern]
        | .node-identifier
            true
        | .node-type-capture
            true
        ??
            false

────────────────────
_ do walk-arms Void
    - id SyntaxId

` The arms of a match or a bare condition table: a type-or chain of type-transform nodes, each
` binding `it` and its captures over its result.
if id == 0
    =

do match tree.nodes[id]
    | .node-type-or(row)
        walk-arms(row.left)
        walk-arms(row.right)
    | .node-type-transform(row)
        push-scope(.scope-arm, id)
        declare(it-name, .slot-it, id, SlotFlag.slot-constant, 0)
        declare-pattern(row.pattern, .slot-pattern, SlotFlag.slot-constant, 0)
        walk(row.expr)
        pop-scope()
    ??
        push-scope(.scope-arm, id)
        declare-pattern(id, .slot-pattern, SlotFlag.slot-constant, 0)
        pop-scope()

────────────────────
_ do walk-transformer
    - body SyntaxId
    - catchers RowRange'SyntaxId

` A raise that declares one error transformer: its exception sees the names its catcher
` declares for the error it takes and for those in its chain, as the reference defines them
` where it raises the exception in the error's place.
for catcher in tree.children[catchers]
    do match? tree.nodes[catcher]
        | .node-catcher(row)
            push-scope(.scope-catch, catcher)
            declare-pattern(row.type, .slot-pattern, SlotFlag.slot-constant, 0)
            for previous in tree.children[row.previous]
                declare-pattern(previous, .slot-pattern, SlotFlag.slot-constant, 0)
            walk(body)
            walk(row.body)
            pop-scope()

────────────────────
_ do declare-pattern Void
    - id SyntaxId
    - kind SlotKind
    - flags SlotMask
    - group SyntaxId

` Declares every name a pattern binds and maps the declaring identifiers to their slots.
` Predicates and equalities inside the pattern are expressions and are walked as such.
if id == 0
    =
if pattern-depth == 0
    pattern-floor = names.length as U32
pattern-depth += 1
declare-pattern-node(id, kind, flags, group)
pattern-depth -= 1

────────────────────
_ do declare-pattern-node Void
    - id SyntaxId
    - kind SlotKind
    - flags SlotMask
    - group SyntaxId

do match tree.nodes[id]
    | .node-type-capture(row)
        . name = identifier-name(tree, row.id)
        if name
            . slot = declare-bound(name, kind, id, flags, group)
            . declares U32 = ResolutionFlag.resolution-declares
            . declared = Resolution(.resolve-slot, 0, slot, 0, declares)
            bindings.set-resolution(binding, row.id, declared)
        if kind == .slot-pattern || kind == .slot-loop-item || !name
            declare-captured(row.type, kind, flags, group)
        else
            walk-tests(row.type)
    | .node-identifier(row)
        . slot = declare-bound(row.name, kind, id, flags, group)
        . resolution = Resolution(.resolve-slot, 0, slot, 0, ResolutionFlag.resolution-declares)
        bindings.set-resolution(binding, id, resolution)
    | .node-type-remainder(row)
        declare-pattern(row.name, kind, flags, group)
    | .node-type-property(row)
        . slot = declare-bound(row.name, kind, id, flags, group)
        . resolution = Resolution(.resolve-slot, 0, slot, 0, ResolutionFlag.resolution-declares)
        bindings.set-resolution(binding, id, resolution)
    | .node-structure-match(row)
        declare-pattern(row.pattern, kind, flags, group)
    | .node-type-tuple(row)
        for field in tree.children[row.field-types]
            declare-pattern(field, kind, flags, group)
    | .node-type-optional(row)
        for field in tree.children[row.field-types]
            declare-pattern(field, kind, flags, group)
    | .node-type-list(row)
        for pattern in tree.children[row.patterns]
            declare-pattern(pattern, kind, flags, group)
    | .node-type-map(row)
        for pattern in tree.children[row.patterns]
            declare-pattern(pattern, kind, flags, group)
    | .node-type-map-item(row)
        declare-pattern(row.key, kind, flags, group)
        declare-pattern(row.value, kind, flags, group)
    | .node-type-match(row)
        declare-pattern(row.type, kind, flags, group)
    | .node-type-case(row)
        declare-pattern(row.type, kind, flags, group)
        declare-pattern(row.value, kind, flags, group)
    | .node-type-or(row)
        . start = names.length as U32
        declare-pattern(row.left, kind, flags, group)
        . floor = alternative-floor
        . ceiling = alternative-ceiling
        alternative-floor = if ceiling > floor then floor else start
        alternative-ceiling = names.length as U32
        declare-pattern(row.right, kind, flags, group)
        alternative-floor = floor
        alternative-ceiling = ceiling
    | .node-type-and(row)
        declare-pattern(row.left, kind, flags, group)
        declare-pattern(row.right, kind, flags, group)
    | .node-type-relation(row)
        declare-pattern(row.left, kind, flags, group)
        declare-pattern(row.right, kind, flags, group)
    | .node-type-iterable(row)
        declare-pattern(row.pattern, kind, flags, group)
    | .node-type-panic(row)
        declare-pattern(row.pattern, kind, flags, group)
    | .node-type-transform(row)
        declare-pattern(row.pattern, kind, flags, group)
        walk(row.expr)
    | .node-type-predicate(row)
        if !lookup-slot(it-name)
            declare(it-name, .slot-it, id, SlotFlag.slot-constant, 0)
        walk(row.expr)
    | .node-type-equality(row)
        walk(row.expr)
    | .node-type-numeric(row)
        walk(row.value)
    ??
        =

────────────────────
_ do declare-bound SlotId
    - name Atom
    - kind SlotKind
    - syntax SyntaxId
    - flags SlotMask
    - group SyntaxId

` A name an arm's pattern binds. One that an alternative before it binds, as `n` in
` `| .a(n) | .b(n)`, is the slot that alternative declared, which the one taken fills; one that
` the same alternative binds again is an error.
. position = lookup-position(name)
if position && kind == .slot-pattern
    . earlier = bindings.slots[name-slots[position]]
    if earlier.kind == kind && earlier.scope == current-scope
        if position >= alternative-floor && position < alternative-ceiling
            = name-slots[position]
        if position >= pattern-floor
            . message = "\"${name.text}\" is bound twice in this pattern; give each place a name of its own"
            bindings.diagnostics.append(Diagnostic(module, syntax, .stated, program.store-atom(message)))
= declare(name, kind, syntax, flags, group)

────────────────────
_ do declare-captured Void
    - id SyntaxId
    - kind SlotKind
    - flags SlotMask
    - group SyntaxId

` Declares what the pattern a name captures binds. A name the pattern reads from its subject
` is not one of them: the captured name holds what it gives.
if id == 0
    =
do match tree.nodes[id]
    | .node-type-property
        =
    | .node-type-and(row)
        declare-captured(row.left, kind, flags, group)
        declare-pattern(row.right, kind, flags, group)
    ??
        declare-pattern(id, kind, flags, group)

────────────────────
_ do walk-tests Void
    - id SyntaxId

` A pattern written where the type of a declared name goes declares no name of its own, and
` what it tests with is walked: a condition reads `it`, which is declared for it.
if id == 0
    =
do match? tree.nodes[id]
    | .node-type-and(row)
        walk-tests(row.left)
        walk-tests(row.right)
    | .node-type-or(row)
        walk-tests(row.left)
        walk-tests(row.right)
    | .node-type-predicate(row)
        if !lookup-slot(it-name)
            declare(it-name, .slot-it, id, SlotFlag.slot-constant, 0)
        walk(row.expr)
    | .node-type-equality(row)
        walk(row.expr)
    | .node-type-numeric(row)
        walk(row.value)
    | .node-type-capture(row)
        walk-tests(row.type)
    | .node-type-match(row)
        walk-tests(row.type)
    | .node-type-case(row)
        walk-tests(row.value)
    | .node-type-list(row)
        for pattern in tree.children[row.patterns]
            walk-tests(pattern)
    | .node-type-map(row)
        for pattern in tree.children[row.patterns]
            walk-tests(pattern)
    | .node-type-map-item(row)
        walk-tests(row.value)
    | .node-type-tuple(row)
        for field in tree.children[row.field-types]
            walk-tests(field)

────────────────────
_ do walk-tested
    - id SyntaxId
    - pattern SyntaxId

push-scope(.scope-arm, id)
do match tree.nodes[pattern]
    | .node-type-list
        walk-tests(pattern)
    | .node-type-map
        walk-tests(pattern)
    | .node-type-case
        walk-tests(pattern)
    ??
        walk(pattern)
pop-scope()

────────────────────
_ do walk-held
    - id SyntaxId
    - expr SyntaxId

` The middle of a chain of orderings declares a slot for its value, which no name reaches.
` The next ordering reads it before anything else is held, so the slot held last is the one
` a read resolves to.
walk(expr)
. row = Slot(.slot-held, held-name, id, current-scope, decl, 0, SlotFlag.slot-constant)
held = bindings.slots.append(row) as SlotId
. declares = ResolutionFlag.resolution-declares
bindings.set-resolution(binding, id, Resolution(.resolve-slot, 0, held, 0, declares))

────────────────────
_ do resolve Void
    - id SyntaxId
    - name Atom
    - flags ResolutionMask
    - assignment SyntaxId = 0
    - rule Bool = false

` Resolves a name to the slot, member, global, function or type it reads. `assignment` is the
` plain assignment the name is the target of: one that nothing declares is reported there, as
` a variable that is not declared, but where the function has `this` it may name a property of
` a style the object sees, which the type pass decides. A `rule` a pattern calls is never a name
` the match captures, as the reference calls rules by name and reads captures as values. A
` function that reads the name of a markup element of the one it is written in captures the
` receiver too, whose property of the name it reads where the element is not made yet. A name
` is a member of a markup element only where it is the event a handler written in the element's
` body subscribes to, or a name the condition of a style rule the element applies reads
` (`received-level`); every other row of the body reads the scope outside the element. Such a
` member read where the element's body is written notes the element, for a function that gives
` the read again (`keep-received`). One that hides a local of the name declared outside the
` element is noted so, for the type pass to say where the read fails.
. position = if rule then rule-position(name) ?? lookup-position(name) else lookup-position(name)
if coded-depth != 0 && !rule
    position = coded-position(position)
. lowest Size? = if id == event-source then 0 else condition-level
. level Size? = null
if receiver-decls.length != 0 && !rule && lowest != null
    level = received-level(name, position, lowest)
if level
    . received = flags /or/ ResolutionFlag.resolution-received
    if position
        received = received /or/ ResolutionFlag.resolution-hides
    . kept = receiver-keeper(level)
    if kept == no-slot
        received-reads[id] = received-elements.length as U32
        received-elements += receiver-elements[level]
        received-scopes += receiver-scopes[level]
    bindings.set-resolution(binding, id, Resolution(.resolve-unresolved, 0, kept, 0, received))
    =
if position
    . slot = name-slots[position]
    if bindings.slots[slot].getter != 0
        read-getter(id, slot)
    else
        use-slot(slot, name-depths[position], flags)
        if name-depths[position] < function-depth
            use-machine-flags(slot, name-depths[position])
            if names-markup(slot)
                hold-self()
    bindings.set-resolution(binding, id, Resolution(.resolve-slot, 0, slot, 0, flags))
    =

outer-uses-self = false
. outer = resolve-outer(name)
if outer-uses-self
    capture-self()
. kind = DiagnosticKind.name-not-found
. site = id
if name == this-name || name == super-name
    kind = DiagnosticKind.required-self
else if name == it-name || name == each-name
    kind = DiagnosticKind.context-not-found
else if assignment != 0
    kind = DiagnosticKind.variable-not-declared
    site = assignment
if unresolved && kind == .name-not-found && styled-depth != 0 && styles-name(name)
    bindings.set-resolution
        - binding
        - id
        - Resolution
            - .resolve-unresolved
            - 0
            - no-slot
            - 0
            - flags /or/ ResolutionFlag.resolution-styled
    =
.. unresolved = outer.kind == .resolve-unresolved
if outer.kind == .resolve-unresolved && kind == .variable-not-declared && lookup-position(this-name)
    capture-self()
    if function-depth != 0
        await-declaration(id, name, flags, U32.max)
    bindings.set-resolution
        - binding
        - id
        - Resolution
            - .resolve-unresolved
            - 0
            - no-slot
            - 0
            - flags /or/ ResolutionFlag.resolution-styled
    =
if outer.kind == .resolve-unresolved && repeating-depth != 0
    bindings.set-resolution
        - binding
        - id
        - Resolution(.resolve-unresolved, 0, no-slot, 0, flags /or/ ResolutionFlag.resolution-quiet)
    =
. reported = U32.max
if outer.kind == .resolve-unresolved && !in-callee && id != quiet-name
    reported = bindings.diagnostics.length as U32
    bindings.diagnostics.append(Diagnostic(module, site, kind, name))
. awaited = kind == .name-not-found || kind == .variable-not-declared
if outer.kind == .resolve-unresolved && function-depth != 0 && awaited
    await-declaration(id, name, flags, reported)
. inherited = Resolution(outer.kind, outer.module, outer.slot, outer.decl, flags)
bindings.set-resolution(binding, id, inherited)

────────────────────
_ do styles-name Bool
    - name Atom

` Whether a name nothing declares, read in the value a markup element's body gives one of its
` attributes or a line of a style rule declares, may be one the reference reads where the line
` names a style property: `inherit`, a slot of a style sheet, or a case of a union that holds
` nothing, among the names gathered once (`list-style-names`). The type pass decides.
=? true if name == inherit-name
list-style-names()
= style-names[name] != null

────────────────────
_ do list-style-names

=? if style-names-listed
style-names-listed = true
for position in 0 .. < program.modules.length
    . owner = program.modules[position]
    for decl in owner.decls
        do match? decl
            | .decl-class(row)
                if row.base != 0 && type-head-name(owner.tree, row.base) == sheet-name
                    for member in owner.member-pool[row.members]
                        . named = member-name(owner, member)
                        if named
                            style-names[named] = true
            | .decl-case(row)
                if row.name && row.type-syntax == 0
                    style-names[row.name] = true

────────────────────
_ member-name Atom?
    - target Module
    - member DeclId

match? target.decls[member]
    | .decl-property(row)
        row.name
    | .decl-event(row)
        row.name
    | .decl-function(row)
        row.name if row.kind == .getter-decl || row.kind == .setter-decl

────────────────────
_ do use-machine-flags
    - slot SlotId
    - depth U32

` A function inside the one that keeps a state machine in a local, which reads the local, reads
` the machine's flags too, which a case test of the local reads.
for row in bindings.machines
    if row.bound == slot
        for offset in 0 .. < row.slots.count
            . flag = row.slots.start + offset
            if bindings.slots[flag].scope == bindings.slots[slot].scope
                use-slot(flag, depth, 0)

────────────────────
_ do use-slot
    - slot SlotId
    - depth U32
    - flags ResolutionMask

` What a read of a local does: a function the read is in, inside the one that declares the
` local, captures it, and a tracked read the list of subscribers of that function too, as does
` a store from such a function where the one that declares the local reads it tracked.
. slot-flags = use-flags(flags, depth < function-depth)
if depth < function-depth
    record-capture(slot, depth, bindings.slots[slot].kind == .slot-this, flags)
if slot-flags != 0
    bindings.mark-slot(slot, slot-flags)
if bindings.slots[slot].kind == .slot-lazy
    note-lazy-use(slot, flags)
. tracked = (flags /and/ (ResolutionFlag.resolution-tracked)) != 0
. stored = (flags /and/ (ResolutionFlag.resolution-write)) != 0 && depth < function-depth
if is-trackable(slot) && (tracked || (stored && reads-tracked(bindings.slots[slot].name, slot)))
    . subscribers = subscribers-of(slot)
    if depth < function-depth
        bindings.mark-slot(subscribers, SlotFlag.slot-captured)
        record-capture(subscribers, depth, false)

────────────────────
_ do note-getters
    - loop SyntaxId
    - body SyntaxId

` Keeps the declarations written as lines of the row of a markup loop region that the reference
` reads as getters, declaring each where it is written and evaluating its value again at each
` read: a lazy one, and in the row of a loop keyed by a clause, one whose value reads the item by
` a name the row gives it, or another such local. The reference's row of a keyed loop over
` anything but a collection is no such row; that is declined where the row is typed.
. keyed = tree.keyed-clause(loop) != 0
. dependent [Atom]
if keyed
    dependent += each-name
    dependent += it-name
    do match? tree.nodes[loop]
        | .node-loop-syntax(row)
            do match? tree.nodes[row.pattern]
                | .node-type-capture(capture)
                    . named = identifier-name(tree, capture.id)
                    if named
                        dependent += named
do match? tree.nodes[body]
    | .node-block(block)
        for statement in tree.children[block.body]
            do match? tree.nodes[statement]
                | .node-declare(row)
                    . name = declared-name(row.left) if tree.nodes[row.left] is .node-type-capture
                    . plain = !row.is-pattern && row.right != 0 && name != null && no-machine
                        .. no-machine = tree.declared-machine(row.right) == 0
                    if plain && (row.is-lazy || (keyed && reads-any(row.right, dependent)))
                        row-getters += statement
                        if keyed
                            dependent += name!

────────────────────
_ do reads-any Bool
    - value SyntaxId
    - names [Atom]

for node in tree.subtree-start(value) .. < value + 1
    do match? tree.nodes[node]
        | .node-identifier(row)
            if names.find(row.name) != null
                = true
= false

────────────────────
_ do note-getter-reads
    - declaration SyntaxId
    - value SyntaxId

` Keeps, for a row local read as a getter, each name its value reads and what the name reaches
` where the value is written: a local, or none, and whether a member is read, which needs the
` receiver.
getter-decls += declaration
getter-firsts += getter-names.length
. selfish = false
. first = getter-names.length
for node in tree.subtree-start(value) .. < value + 1
    do match? tree.nodes[node]
        | .node-identifier(row)
            . read = bindings.resolution-of(binding, node)
            if read.kind == .resolve-member
                selfish = true
            . seen = false
            for position in first .. < getter-names.length
                if getter-names[position] == row.name
                    getter-flags[position] = getter-flags[position] /or/ read.flags
                    seen = true
            if !seen
                . position = lookup-position(row.name)
                getter-names += row.name
                getter-nodes += node
                getter-slots += if position then name-slots[position] else no-slot
                getter-depths += if position then name-depths[position] else 0u32
                getter-flags += read.flags
getter-ends += getter-names.length
getter-selves += selfish

────────────────────
_ do read-getter
    - id SyntaxId
    - slot SlotId

` A read of a row local the reference reads as a getter, which evaluates the local's value again
` where it is read: each name the value reads is read here, so a function the read is in
` captures it, and one that reaches another local here than where the value is written is the
` reference's error, reported at the read.
. getter = bindings.slots[slot].getter
. index = getter-decls.find(getter)
if index == null
    =
. first = getter-firsts[index]
. end = getter-ends[index]
for position in first .. < end
    . name = getter-names[position]
    . here = lookup-position(name)
    . reached = if here then name-slots[here] else no-slot
    if reached != getter-slots[position]
        . message = "Markup row local ${bindings.slots[slot].name.text} reads ${name.text}, which is shadowed here; rename one of them"
        bindings.diagnostics.append(Diagnostic(module, id, .stated, program.store-atom(message)))
        =
for position in first .. < end
    . read = getter-slots[position]
    if read != no-slot
        if bindings.slots[read].getter != 0
            read-getter(getter-nodes[position], read)
        else
            use-slot(read, getter-depths[position], getter-flags[position])
if getter-selves[index]
    capture-self()

────────────────────
_ is-trackable Bool
    - slot SlotId

` Whether a local is one a tracked read tracks: a lazy local, one a declaration names, or an
` argument.
kind == .slot-local || kind == .slot-lazy || kind == .slot-argument

.. kind = bindings.slots[slot].kind

────────────────────
_ do subscribers-of SlotId
    - slot SlotId

` The hidden local that holds the list of subscribers of the function that declares a local
` read tracked, which the reference makes where that function starts and every tracked read of
` its locals goes through. It is declared once, in the function's own scope.
. home = function-of(bindings.slots[slot].scope)
for held in subscriber-slots
    if bindings.slots[held].scope == home
        = held
. flags = SlotFlag.slot-constant
. made = bindings.slots.append(subscribers) as SlotId
    .. subscribers = Slot(.slot-subscribers, subscribers-name, home-syntax, home, decl, 0, flags)
    .. home-syntax = bindings.scopes[home].syntax
subscriber-slots += made
= made

────────────────────
_ do builder-of SlotId
    - name Atom

` The hidden local that holds the function that builds the slot of a name, which the function
` that fills an object with the markup of its class is given, declared once in that function's
` own scope.
for held in builder-slots
    if bindings.slots[held].name == name
        = held
. flags = SlotFlag.slot-constant
. made = bindings.slots.append(builder) as SlotId
    .. builder = Slot(.slot-builder, name, home-syntax, content-home, decl, 0, flags)
    .. home-syntax = bindings.scopes[content-home].syntax
builder-slots += made
= made

────────────────────
_ do walk-latest Void
    - id SyntaxId

` The latest item of a stream, read in a live action: the tracker that holds it is kept in a
` local no name reaches, declared at the read, which the function that runs the action again
` captures, as the reference keeps it in a constant of the scope the action is made in.
. kept = SlotFlag.slot-constant /or/ SlotFlag.slot-captured
. slot = bindings.slots.append(tracker) as SlotId
    .. tracker = Slot(.slot-local, tracker-name, id, current-scope, decl, 0, kept)
. declares = ResolutionFlag.resolution-declares
bindings.set-resolution(binding, id, Resolution(.resolve-slot, 0, slot, 0, declares))

────────────────────
_ do walk-live Void
    - id SyntaxId

` The function that runs a live statement again: it captures every local, argument and
` receiver the statement reads or writes, the local a declaration declares, with the list of
` subscribers it stores through where the function that declares it reads it tracked, and the
` list of subscribers of each local it reads tracked, so that it reaches them where the
` enclosing function keeps them.
. live = nested-decl-for(id)
if live == 0
    =
. slots [SlotId]
do match? tree.nodes[id]
    | .node-declare(row)
        . named = row.left
        do match? tree.nodes[row.left]
            | .node-type-capture(capture)
                named = capture.id
        . declared = identifier-name(tree, named)
        . found = lookup-position(declared) if declared
        if found
            slots += name-slots[found]
            if reads-tracked(declared!, name-slots[found])
                slots += subscribers-of(name-slots[found])
note-reads(id, slots)
capture-in(id, slots)

────────────────────
_ do reads-tracked Bool
    - name Atom
    - slot SlotId

` Whether the function that declares a local reads a local of its name tracked anywhere in it,
` alone or as the object a tracked member is read from, though later than here.
. home = bindings.scopes[function-of(bindings.slots[slot].scope)].syntax
for node in tree.subtree-start(home) .. home
    do match? tree.nodes[node]
        | .node-identifier(row)
            if row.is-tracked && row.name == name
                = true
        | .node-get-expression(row)
            if row.is-tracked
                do match? tree.nodes[row.object]
                    | .node-identifier(root)
                        if root.name == name
                            = true
= false

────────────────────
_ do is-branch Bool
    - id SyntaxId

` Whether an `if` or a `match` is a markup branch region, whose arm a function of its own
` selects again.
. decl = nested-decl-for(id)
if decl == 0
    = false
do match? program.modules[module].decls[decl]
    | .decl-function(fn)
        = fn.kind == .branch-decl
= false

────────────────────
_ do walk-branch Void
    - id SyntaxId

` A markup branch region, as the reference compiles one: its conditions are read where the
` `if` is written, to select the first arm, and each arm's body is built by a function of its
` own (`walk-arm`). The host of the region and the region itself are kept in two locals no
` name reaches, declared at the `if`, which the function that selects the arm again captures
` with every local, argument and receiver the conditions read and the list of subscribers of
` each local they read tracked. Each later arm, which follows the `if` in the tree, resolves to
` the first of those locals too, which the `if` declares. A third such local keeps the batch
` in force where the region is written, which each arm captures. An arm written with a pattern,
` `if | x = v`, is read and built as an arm of a match region is (`walk-match-arm`): its subject
` is read where the `if` is written, and again by the function that builds the arm.
. kept = SlotFlag.slot-constant /or/ SlotFlag.slot-captured
. host = bindings.slots.append(host-slot) as SlotId
    .. host-slot = Slot(.slot-local, branch-host-name, id, current-scope, decl, 0, kept)
bindings.slots.append(Slot(.slot-local, branch-region-name, id, current-scope, decl, 0, kept))
bindings.slots.append(Slot(.slot-local, batch-root-name, id, current-scope, decl, 0, kept))
. declares = ResolutionFlag.resolution-declares
bindings.set-resolution(binding, id, Resolution(.resolve-slot, 0, host, 0, declares))
branch-depth += 1
. arm = id
while arm != 0
    . next SyntaxId = 0
    do match? tree.nodes[arm]
        | .node-if-block(row)
            if arm != id
                bindings.set-resolution(binding, arm, Resolution(.resolve-slot, 0, host, 0, 0))
            . pattern = tree.pattern-arm(arm)
            if pattern != 0
                . subject = matched-subject(row.condition)
                walk(subject)
                . read [SlotId]
                read += host
                note-reads(subject, read, true)
                walk-match-arm(pattern, tree.arm-body(arm), host + 2, read)
            else
                walk(row.condition)
                walk-arm(row.body, host + 2)
            next = row.next
    arm = next
branch-depth -= 1
. slots [SlotId]
slots += host
slots += host + 1
arm = id
while arm != 0
    . next SyntaxId = 0
    do match? tree.nodes[arm]
        | .node-if-block(row)
            . pattern = tree.pattern-arm(arm)
            if pattern != 0
                note-reads(matched-subject(row.condition), slots, true)
                do match? tree.nodes[pattern]
                    | .node-type-transform(transform)
                        if transform.pattern != 0
                            note-reads(transform.pattern, slots, true)
            else if row.condition != 0
                note-reads(row.condition, slots)
            next = row.next
    arm = next
capture-in(id, slots)

────────────────────
_ matched-subject SyntaxId
    - matching SyntaxId

` The subject of a match, or none.
match tree.nodes[matching]
    | .node-match-expression(row)
        row.subject
    ??
        0

────────────────────
_ do walk-match-region Void
    - id SyntaxId
    - subject SyntaxId

` A markup match region, as the reference compiles one (`markupMatchBranch`): its subject is
` read where the `match` is written and each arm's pattern tested against it, to select the
` first arm, and each arm is built by a function of its own (`walk-match-arm`), which reads the
` subject again. The host, the region and the batch in force are kept in three locals no name
` reaches, declared at the `match`, as those of a branch region are (`walk-branch`); the
` function that selects the arm again captures them with what the subject and the patterns read.
walk(subject)
. kept = SlotFlag.slot-constant /or/ SlotFlag.slot-captured
. host = bindings.slots.append(host-slot) as SlotId
    .. host-slot = Slot(.slot-local, branch-host-name, id, current-scope, decl, 0, kept)
bindings.slots.append(Slot(.slot-local, branch-region-name, id, current-scope, decl, 0, kept))
bindings.slots.append(Slot(.slot-local, batch-root-name, id, current-scope, decl, 0, kept))
bindings.set-resolution
    - binding
    - id
    - Resolution(.resolve-slot, 0, host, 0, ResolutionFlag.resolution-declares)
. read [SlotId]
read += host
note-reads(subject, read, true)
. arms [SyntaxId]
tree.match-arms(id, arms)
branch-depth += 1
for arm in arms
    walk-match-arm(arm, tree.region-arm-body(arm), host + 2, read)
branch-depth -= 1
. slots [SlotId]
slots += host
slots += host + 1
note-reads(subject, slots, true)
for arm in arms
    do match? tree.nodes[arm]
        | .node-type-transform(row)
            if row.pattern != 0
                note-reads(row.pattern, slots, true)
capture-in(id, slots)

────────────────────
_ do walk-match-arm Void
    - arm SyntaxId
    - body SyntaxId
    - root SlotId
    - read [SlotId]

` The function that builds an arm of a markup match region, or of a branch region written with
` a pattern, at `body`: given the region, as an arm of a branch region is (`walk-arm`), it reads
` the subject again, with what it captures of `read`, and binds `it` and the names the arm's
` pattern declares before its body runs.
do match? tree.nodes[arm]
    | .node-type-transform(row)
        push-scope(.scope-nested, body)
        function-depth += 1
        open-nested(body)
        record-capture(root, slot-depth(root), false)
        for slot in read
            bindings.mark-slot(slot, SlotFlag.slot-captured)
            record-capture(slot, slot-depth(slot), bindings.slots[slot].kind == .slot-this)
        . given = bindings.slots.append(parent) as SlotId
        .. parent = Slot(.slot-argument, branch-parent-name, body, current-scope, decl, 0, constant)
        .. constant = SlotFlag.slot-constant
        bindings.set-resolution
            - binding
            - body
            - Resolution(.resolve-slot, 0, given, 0, ResolutionFlag.resolution-declares)
        push-scope(.scope-arm, arm)
        declare(it-name, .slot-it, arm, SlotFlag.slot-constant, 0)
        declare-pattern(row.pattern, .slot-pattern, SlotFlag.slot-constant, 0)
        walk(body)
        walk-arm-lines(body)
        pop-scope()
        close-nested()
        function-depth -= 1
        pop-scope()

────────────────────
_ do walk-arm Void
    - body SyntaxId
    - root SlotId

` The function that builds an arm of a markup branch region: its one argument, which no name
` reaches, is the region, and the arm's body runs as content of it. It captures like a lambda,
` and captures the local that keeps the batch in force where the region is written.
push-scope(.scope-nested, body)
function-depth += 1
open-nested(body)
record-capture(root, slot-depth(root), false)
. given = bindings.slots.append(parent) as SlotId
    .. parent = Slot(.slot-argument, branch-parent-name, body, current-scope, decl, 0, constant)
    .. constant = SlotFlag.slot-constant
bindings.set-resolution
    - binding
    - body
    - Resolution(.resolve-slot, 0, given, 0, ResolutionFlag.resolution-declares)
walk(body)
walk-arm-lines(body)
close-nested()
function-depth -= 1
pop-scope()

────────────────────
_ do walk-arm-lines Void
    - body SyntaxId

` The functions that give lines of an arm's body content again, as those of an element's body
` are (`walk-attribute`), where the region takes them.
do match? tree.nodes[body]
    | .node-block(row)
        for statement in tree.children[row.body]
            if is-live(statement) && tree.content-line(statement)
                walk-attribute(statement)

────────────────────
_ do is-loop-region Bool
    - id SyntaxId

` Whether a `for` is a markup loop region, whose container a function of its own reads again.
. decl = nested-decl-for(id)
if decl == 0
    = false
do match? program.modules[module].decls[decl]
    | .decl-function(fn)
        = fn.kind == .source-decl
= false

────────────────────
_ do walk-loop-region Void
    - id SyntaxId
    - loop SyntaxId
    - body SyntaxId

` A markup loop region, as the reference compiles one: its container is read where the `for`
` is written, and each row is built by a function of its own (`walk-row`), and keyed by one
` where the loop is keyed (`walk-key`). The host of the region and the region itself are kept
` in two locals no name reaches, declared at the `for`,
` which the function that reads the container again captures with every local, argument and
` receiver the container reads and the list of subscribers of each local it reads tracked. A
` third such local keeps the batch in force where the region is written, which the row's
` function captures.
. container SyntaxId = 0
do match? tree.nodes[loop]
    | .node-loop-syntax(row)
        container = row.container
walk(container)
. kept = SlotFlag.slot-constant /or/ SlotFlag.slot-captured
. host = bindings.slots.append(host-slot) as SlotId
    .. host-slot = Slot(.slot-local, loop-host-name, id, current-scope, decl, 0, kept)
bindings.slots.append(Slot(.slot-local, loop-region-name, id, current-scope, decl, 0, kept))
bindings.slots.append(Slot(.slot-local, batch-root-name, id, current-scope, decl, 0, kept))
bindings.set-resolution
    - binding
    - id
    - Resolution(.resolve-slot, 0, host, 0, ResolutionFlag.resolution-declares)
branch-depth += 1
walk-row(loop, body, host + 2)
. clause = tree.keyed-clause(loop)
if clause != 0
    walk-key(loop, clause)
. filter = tree.when-clause(loop)
if filter != 0
    walk-key(loop, filter)
branch-depth -= 1
. slots [SlotId]
slots += host
slots += host + 1
note-reads(container, slots, true)
capture-in(id, slots)

────────────────────
_ do walk-row Void
    - loop SyntaxId
    - body SyntaxId
    - root SlotId

` The function that builds a row of a markup loop region: its one argument is the row's item,
` which the name the loop's header writes, `each` and `it` all reach, as the reference defines
` each of them, and the loop's body gives the row. The argument resolves at the body. It
` captures like a lambda, and captures the local that keeps the batch in force where the region
` is written. The reference compiles neither the clauses of the header, which it refuses but
` a `keyed by`, nor headers chained after it, which it refuses.
push-scope(.scope-nested, body)
function-depth += 1
open-nested(body)
record-capture(root, slot-depth(root), false)
. pattern SyntaxId = 0
do match? tree.nodes[loop]
    | .node-loop-syntax(row)
        pattern = row.pattern
. given = no-slot
if names-item(pattern)
    declare-pattern(pattern, .slot-argument, 0, 0)
    . named = pattern
    do match? tree.nodes[pattern]
        | .node-type-capture(capture)
            named = capture.id
    given = bindings.resolution-of(binding, named).slot
else
    given = declare(each-name, .slot-argument, body, 0, 0)
bindings.set-resolution(binding, body, Resolution(.resolve-slot, 0, given, 0, 0))
. regioned = tree.row-region(body)
if regioned
    . parent = Slot(.slot-argument, branch-parent-name, loop, current-scope, decl, 0, SlotFlag.slot-constant)
    . region = bindings.slots.append(parent) as SlotId
    bindings.set-resolution(binding, loop, Resolution(.resolve-slot, 0, region, 0, ResolutionFlag.resolution-declares))
if bindings.slots[given].name != each-name
    alias(each-name, given)
alias(it-name, given)
note-getters(loop, body)
walk(body)
if regioned
    walk-arm-lines(body)
close-nested()
function-depth -= 1
pop-scope()

────────────────────
_ do walk-key Void
    - loop SyntaxId
    - clause SyntaxId

` The function that keys a row of a markup loop region: its one argument is the row's item,
` which the name the loop's header writes, `each` and `it` all reach, and it gives the value of
` the `keyed by` clause. The argument resolves at the clause. It captures like a lambda.
push-scope(.scope-nested, clause)
function-depth += 1
open-nested(clause)
. name = each-name
do match? tree.nodes[loop]
    | .node-loop-syntax(row)
        do match? tree.nodes[row.pattern]
            | .node-type-capture(capture)
                name = identifier-name(tree, capture.id) ?? each-name
. given = declare(name, .slot-argument, clause, 0, 0)
bindings.set-resolution
    - binding
    - clause
    - Resolution(.resolve-slot, 0, given, 0, ResolutionFlag.resolution-declares)
if name != each-name
    alias(each-name, given)
alias(it-name, given)
do match? tree.nodes[clause]
    | .node-clause(row)
        walk(row.expr)
close-nested()
function-depth -= 1
pop-scope()

────────────────────
_ do alias
    - name Atom
    - slot SlotId

` Brings a slot declared under one name into reach by another too.
. hidden = latest-names[name] ?? U32.max
name-links += hidden
latest-names[name] = names.length as U32
names += name
name-slots += slot
name-depths += function-depth

────────────────────
_ do note-reads
    - id SyntaxId
    - slots [SlotId]
    - itself Bool = false

` Adds to `slots` once each the locals, arguments and receiver the nodes below a node read or
` write, and the node itself where `itself` says, but those of a function inside, the local that
` keeps a markup element whose member one reads by its name alone (`receiver-keeper`), and the
` list of subscribers of each local read tracked. A row local read as a getter is none of
` them: what its value reads is.
. this-slot = no-slot
. position = lookup-position(this-name)
if position
    this-slot = name-slots[position]
. end = if itself then id + 1 else id
for node in tree.subtree-start(id) .. < end
    . resolution = bindings.resolution-of(binding, node)
    . slot = no-slot
    . received = (resolution.flags /and/ ResolutionFlag.resolution-received) != 0
    if resolution.kind == .resolve-slot || received
        slot = resolution.slot
    else if resolution.kind == .resolve-member || names-method(resolution) || reads-own-style(node)
        slot = this-slot
    if slot == no-slot || slot-depth(slot) > function-depth
        continue
    if bindings.slots[slot].getter != 0
        note-getter-slots(slot, slots, this-slot)
        continue
    note-slot(slot, slots, if !received then resolution.flags else 0)

────────────────────
_ do reads-own-style Bool
    - node SyntaxId

do match? tree.nodes[node]
    | .node-style-read-expression(row)
        = row.object == 0
= false

────────────────────
_ do note-slot
    - slot SlotId
    - slots [SlotId]
    - flags ResolutionMask

` Adds a slot to `slots` once, with the list of subscribers where it is read tracked, or
` stored to where the function that declares it reads it tracked.
if slots.find(slot) == null
    slots += slot
. tracked = (flags /and/ (ResolutionFlag.resolution-tracked)) != 0
. stored = (flags /and/ (ResolutionFlag.resolution-write)) != 0
if is-trackable(slot) && (tracked || (stored && reads-tracked(bindings.slots[slot].name, slot)))
    . subscribers = subscribers-of(slot)
    if slots.find(subscribers) == null
        slots += subscribers

────────────────────
_ do note-getter-slots
    - slot SlotId
    - slots [SlotId]
    - this-slot SlotId

` Adds to `slots` once each the locals a row local read as a getter reads where its value is
` written, through the getters among them, with the list of subscribers of each it reads
` tracked, and the receiver where the value reads a member.
. index = getter-decls.find(bindings.slots[slot].getter)
if index == null
    =
for position in getter-firsts[index] .. < getter-ends[index]
    . read = getter-slots[position]
    if read == no-slot
        continue
    if bindings.slots[read].getter != 0
        note-getter-slots(read, slots, this-slot)
    else
        note-slot(read, slots, getter-flags[position])
if getter-selves[index] && this-slot != no-slot && slots.find(this-slot) == null
    slots += this-slot

────────────────────
_ do capture-in
    - id SyntaxId
    - slots [SlotId]

` Opens the nested function declared at a node to capture each of `slots` where the
` enclosing function keeps it.
push-scope(.scope-nested, id)
function-depth += 1
open-nested(id)
for slot in slots
    bindings.mark-slot(slot, SlotFlag.slot-captured)
    record-capture(slot, slot-depth(slot), bindings.slots[slot].kind == .slot-this)
close-nested()
function-depth -= 1
pop-scope()

────────────────────
_ do slot-depth U32
    - slot SlotId

` How many nested functions lie around the scope that declares a slot.
. depth = 0u32
. scope = bindings.slots[slot].scope
while bindings.scopes[scope].kind != .scope-function
    if bindings.scopes[scope].kind == .scope-nested
        depth += 1
    scope = bindings.scopes[scope].parent
= depth

────────────────────
_ do use-flags SlotMask
    - flags ResolutionMask
    - captured Bool

. slot-flags = if captured then (SlotFlag.slot-captured) else 0u32
if (flags /and/ (ResolutionFlag.resolution-write)) != 0
    slot-flags = slot-flags /or/ (SlotFlag.slot-assigned)
    if !captured
        slot-flags = slot-flags /or/ (SlotFlag.slot-assigned-own)
if (flags /and/ (ResolutionFlag.resolution-ref)) != 0
    slot-flags = slot-flags /or/ (SlotFlag.slot-address-taken)
if (flags /and/ (ResolutionFlag.resolution-tracked)) != 0
    slot-flags = slot-flags /or/ (SlotFlag.slot-tracked)
= slot-flags

────────────────────
_ do await-declaration
    - id SyntaxId
    - name Atom
    - flags ResolutionMask
    - reported U32

` A nested function's body resolves when the function is first called, so a name in it that
` nothing declares yet waits for a local that an enclosing block declares later.
late-ids += id
late-names += name
late-flags += flags
late-scopes += current-scope
late-depths += function-depth
late-diagnostics += reported
late-frames += late-frame-decls.length
for frame in 0 .. < nested-decls.length
    late-frame-decls += nested-decls[frame]
    late-frame-depths += nested-depths[frame]
    late-frame-values += nested-by-value[frame]

────────────────────
_ do settle-late
    - name Atom
    - slot SlotId

` Gives a new local to the waiting names it is declared in time for: those of nested functions
` written earlier in the declaring block or in a block inside it. A task body captures by
` value where it is written, so it never waits.
for index in 0 .. < late-ids.length
    if late-names[index] == name && late-depths[index] > function-depth
        if encloses(current-scope, late-scopes[index]) && !waits-by-value(index)
            . flags = late-flags[index]
            bindings.mark-slot(slot, use-flags(flags, true))
            . found = Resolution(.resolve-slot, 0, slot, 0, flags)
            bindings.set-resolution(binding, late-ids[index], found)
            for frame in late-frames[index] .. < frames-end(index)
                if late-frame-depths[frame] > function-depth
                    add-capture(late-frame-decls[frame], slot)
            retract(index)
            late-depths[index] = 0

────────────────────
_ frames-end Size
    - index Size

if index + 1 < late-frames.length then late-frames[index + 1] else late-frame-decls.length

────────────────────
_ do waits-by-value Bool
    - index Size

for frame in late-frames[index] .. < frames-end(index)
    if late-frame-depths[frame] > function-depth && late-frame-values[frame]
        = true
= false

────────────────────
_ do encloses Bool
    - outer ScopeId
    - inner ScopeId

. scope = inner
while scope != outer
    . parent = bindings.scopes[scope].parent
    if parent >= scope
        = false
    scope = parent
= true

────────────────────
_ do add-capture
    - nested DeclId
    - slot SlotId

` A closed nested function gains a capture: its row moves to the end of the capture store with
` the new slot last.
. first Size = bindings.bindings[binding].nested.start
for position in first .. < bindings.nested.length
    if bindings.nested[position].decl == nested
        . held = bindings.nested[position].captures
        for offset in 0 .. < held.count
            if bindings.captures[held.start + offset].slot == slot
                =
        . start U32 = bindings.captures.length as U32
        for offset in 0 .. < held.count
            . capture = bindings.captures[held.start + offset]
            bindings.record-capture(capture.slot, capture.flags)
        bindings.record-capture(slot, 0)
        bindings.nested[position].captures = bindings.captures-from(start)
        =

────────────────────
_ do retract
    - index Size

` Withdraws the name-not-found diagnostic of a name that a later local resolved.
. row = late-diagnostics[index]
if row == U32.max
    =
. last = bindings.diagnostics.length - 1
for position in row .. < last
    . moved = bindings.diagnostics[position + 1]
    . shifted = Diagnostic(moved.module, moved.syntax, moved.kind, moved.name, moved.earlier)
    bindings.diagnostics[position] = shifted
bindings.diagnostics.truncate(last)
for other in 0 .. < late-diagnostics.length
    if late-diagnostics[other] != U32.max && late-diagnostics[other] > row
        late-diagnostics[other] -= 1
late-diagnostics[index] = U32.max

────────────────────
_ do resolve-stack-local
    - id SyntaxId
    - name Atom

for candidate in program.lookup(module, name)
    . target = program.modules[candidate.module]
    do match? target.decls[candidate.decl]
        | .decl-property(row)
            if row.owner == 0 && (is-public(row.access) || reaches)
                . found = Resolution(.resolve-global, candidate.module, no-slot, candidate.decl, 0)
                bindings.set-resolution(binding, id, found)
                =
            .. reaches = program.reaches-private(module, candidate.module)
        | .decl-effect(row)
            if is-public(row.access) || program.reaches-private(module, candidate.module)
                . found = Resolution(.resolve-global, candidate.module, no-slot, candidate.decl, 0)
                bindings.set-resolution(binding, id, found)
                =
bindings.diagnostics.append(Diagnostic(module, id, .name-not-found, name))

────────────────────
_ do note-lazy-use
    - slot SlotId
    - flags LazyUseMask

` The counts and context flags the emitter's lazy policy reads, mirroring the TypeScript
` planner's use summary: which kind of use, and whether it sits in a loop, a nested function,
` a branch, a subscription loop, or a state machine.
. is-write = (flags /and/ (ResolutionFlag.resolution-write)) != 0
. is-ref = (flags /and/ (ResolutionFlag.resolution-ref)) != 0
. is-tracked = (flags /and/ (ResolutionFlag.resolution-tracked)) != 0
. is-read = !is-write && !is-ref && !is-tracked
. bases = bindings.lazy-use-of(slot)
. use-flags = 0u32
if loop-depth > bases.loop-base
    use-flags = use-flags /or/ (LazyUseFlag.read-in-loop)
if is-captured-slot(slot)
    use-flags = use-flags /or/ (LazyUseFlag.read-in-nested)
if branch-depth > bases.branch-base
    use-flags = use-flags /or/ (LazyUseFlag.read-in-branch)
if subscription-depth > bases.subscription-base
    use-flags = use-flags /or/ (LazyUseFlag.read-in-subscription)
if state-depth > bases.state-base
    use-flags = use-flags /or/ (LazyUseFlag.read-in-state-machine)
if lazy-depth != 0
    use-flags = use-flags /or/ (LazyUseFlag.read-in-lazy)
. reads = if is-read then 1u32 else 0u32
. writes = if is-write then 1u32 else 0u32
. refs = if is-ref then 1u32 else 0u32
. tracked = if is-tracked then 1u32 else 0u32
bindings.record-lazy-use(slot, reads, writes, refs, tracked, use-flags)
. apart = control-apart || subscription-depth != bases.subscription-base
    .. control-apart = branch-depth != bases.branch-base || loop-depth != bases.loop-base
if is-read && !apart && state-depth == bases.state-base && unguarded && !is-captured-slot(slot)
    bindings.settle-lazy-read(slot)
.. unguarded = lazy-depth == 0 && guard-depth == 0


────────────────────
_ do is-captured-slot Bool
    - slot SlotId

. total = names.length
for reverse in 0 .. < total
    . position = total - 1 - reverse
    if name-slots[position] == slot
        = name-depths[position] < function-depth
= false

────────────────────
_ lookup-slot SlotId?
    - name Atom

|? position
    name-slots[position]
??
    null

.. position = lookup-position(name)

────────────────────
_ lookup-position Size?
    - name Atom

` The place of the name declared last among the names in reach. Each name knows the place
` of its last declaration, so no other name is read.
in-reach(latest-names[name] ?? U32.max)

────────────────────
_ do rule-position Size?
    - name Atom

` The place of the rule a pattern calls by a name: the name declared last in reach that no
` stream pattern captures, nor any other pattern of the match being read, as the reference
` calls rules by name and reads captures as values. A name an enclosing match captures is
` passed over too, where an argument of a call or a local rule's body is a match of its own.
. position = lookup-position(name)
while position && bindings.slots[name-slots[position]].kind == .slot-pattern && (position >= capture-floor || (stream-captures[name-slots[position]] ?? false))
    position = in-reach(name-links[position])
= position

────────────────────
_ do coded-position Size?
    - found Size?

` The place of a name in reach of the code of a local rule whose body is code. The reference
` compiles that code as a function where the rule is declared, so a name a match captured is
` in its reach only while the match is being read: within an action of the match, and not
` beside it.
. position = found
while position && bindings.slots[name-slots[position]].kind == .slot-pattern && is-closed(bindings.slots[name-slots[position]].syntax)
    position = in-reach(name-links[position])
= position

────────────────────
_ do is-closed Bool
    - capture SyntaxId

` Whether a name was captured by a stream pattern that has been read to its end.
for matched in closed-matches
    if tree.subtree-start(matched) <= capture && capture <= matched
        = true
= false

────────────────────
_ in-reach Size?
    - position U32

` A place among the names, where the name is in reach. A name declared before the value of a
` property began is not in reach of the value, nor one a constructor's body declared before a
` field's initializer.
|? position == U32.max || position < value-floor || in-body
    null
??
    position as Size

.. in-body = position >= body-names.start && position < body-names.end

────────────────────
_ do forget-names
    - mark Size

` Takes the names declared since a mark out of reach. The last declaration of each is again
` the one it hid.
. position = names.length
while position > mark
    position -= 1
    latest-names[names[position]] = name-links[position]

────────────────────
_ do resolve-callable
    - callable SyntaxId

. head = match? tree.nodes[callable]
    | .node-type-identifier(row)
        row.name
    | .node-type-arguments
        type-head-name(tree, callable)
if !head
    . direct = match tree.nodes[callable]
        | .node-identifier
            true
        ??
            false
    . saved = in-callee
    in-callee = direct
    walk(callable)
    in-callee = saved
    =
. class = first-class-named(module, head, type-argument-count(tree, callable))
if class
    bindings.set-resolution
        - binding
        - callable
        - Resolution(.resolve-type, class.module, no-slot, class.decl, 0)

────────────────────
_ do resolve-outer Resolution
    - name Atom

` Members of the owner chain, then module globals, then functions and types through the name
` index, then unresolved. A type is named by its own name alone: another name it is known by,
` such as the one a number of it is written with, names nothing in an expression. A function
` found through the name index whose name a method of the owner chain has uses the receiver
` too, as the type pass may call the method.
if owner-decl != 0
    . member = member-of(module, owner-decl, name, 0)
    if member
        outer-uses-self = true
        = Resolution(.resolve-member, member.module, no-slot, member.decl, 0)

. global DeclRef? = null
. class DeclRef? = null
. function DeclRef? = null
for candidate in program.lookup(module, name)
    . target = program.modules[candidate.module]
    do match? target.decls[candidate.decl]
        | .decl-property(row)
            if row.owner == 0 && !global
                if is-public(row.access) || reaches
                    global = DeclRef(candidate.module, candidate.decl)
                .. reaches = program.reaches-private(module, candidate.module)
        | .decl-class(row)
            if row.name == name && (!class || (candidate.module == class.module && no-type-args))
                class = DeclRef(candidate.module, candidate.decl)
            .. no-type-args = row.type-args.count == 0
        | .decl-function
            if !function
                function = DeclRef(candidate.module, candidate.decl)

if global
    = Resolution(.resolve-global, global.module, no-slot, global.decl, 0)
if class && !(in-callee && function)
    = Resolution(.resolve-type, class.module, no-slot, class.decl, 0)
if function
    if owner-decl != 0 && method-of(module, owner-decl, name, 0)
        outer-uses-self = true
    = Resolution(.resolve-function, function.module, no-slot, function.decl, 0)
if owner-decl != 0
    . method = method-of(module, owner-decl, name, 0)
    if method
        outer-uses-self = true
        = Resolution(.resolve-function, method.module, no-slot, method.decl, 0)
= Resolution(.resolve-unresolved, 0, no-slot, 0, 0)

────────────────────
_ do method-of DeclRef?
    - owner-module ModuleId
    - owner DeclId
    - name Atom
    - depth U32

` A function declared on the owner chain or on an extension visible from this module that
` applies to a class of the chain. The TypeScript compiler finds these through the class
` scope's method lookup after every variable lookup fails.
if depth > member-chain-limit
    = null

. target = program.modules[owner-module]
. owner-tree = target.tree
do match? target.decls[owner]
    | .decl-class(row)
        . direct = function-row(target, row.members, name)
        if direct
            = DeclRef(owner-module, direct)
        for extension in program.extensions-for(module, owner-module, owner)
            . extended = program.modules[extension.module]
            do match? extended.decls[extension.decl]
                | .decl-extension(body)
                    . found = function-row(extended, body.members, name)
                    if found
                        = DeclRef(extension.module, found)
        if row.base != 0
            . base = class-written(owner-module, owner-tree, row.base)
            if base
                = method-of(base.module, base.decl, name, depth + 1)
    | .decl-extension(row)
        . direct = function-row(target, row.members, name)
        if direct
            = DeclRef(owner-module, direct)
        . receiver = extended-decl(owner-module, owner, row)
        if receiver
            = method-of(receiver.module, receiver.decl, name, depth + 1)
= null

────────────────────
_ do function-row DeclId?
    - target Module
    - members RowRange'DeclId
    - name Atom

if members.count == 0
    = null
. place = target.first-member(members, name)
while place != no-member
    . member = target.member-pool[place]
    place = target.member-links[place]
    do match? target.decls[member]
        | .decl-function(row)
            if row.kind != .getter-decl && row.kind != .setter-decl && row.name && row.name == name
                = member
= null

────────────────────
_ do member-of DeclRef?
    - owner-module ModuleId
    - owner DeclId
    - name Atom
    - depth U32

` A property, event, or tuple base field on a class or extension chain, walked by declaration:
` the member rows, then the fields of a tuple base, then the base head through the name index,
` then the interfaces a property answers for the class, and those the class is of.
if depth > member-chain-limit
    = null

. target = program.modules[owner-module]
. owner-tree = target.tree
do match? target.decls[owner]
    | .decl-class(row)
        . direct = member-row(target, row.members, name)
        if direct
            = DeclRef(owner-module, direct)
        . faceted = facet-member(owner-module, owner, name)
        if faceted
            = faceted
        if is-builtin-member(owner-module, owner, name)
            = DeclRef(owner-module, owner)
        if row.base != 0
            if tuple-field-named(owner-tree, row.base, name)
                = DeclRef(owner-module, owner)
            . base = class-written(owner-module, owner-tree, row.base)
            if base
                . inherited = member-of(base.module, base.decl, name, depth + 1)
                if inherited
                    = inherited
        for delegate in target.syntax-pool[row.delegated]
            . declared = class-written(owner-module, owner-tree, delegate)
            if declared
                . provided = member-of(declared.module, declared.decl, name, depth + 1)
                if provided
                    = provided
        for interface in target.syntax-pool[row.interfaces]
            . declared = class-written(owner-module, owner-tree, interface)
            if declared
                . provided = member-of(declared.module, declared.decl, name, depth + 1)
                if provided
                    = provided
    | .decl-extension(row)
        . direct = member-row(target, row.members, name)
        if direct
            = DeclRef(owner-module, direct)
        . receiver = extended-decl(owner-module, owner, row)
        if receiver
            = member-of(receiver.module, receiver.decl, name, depth + 1)
    | .decl-sheet-extension(row)
        . receiver = class-written(owner-module, owner-tree, row.receiver)
        if receiver
            = member-of(receiver.module, receiver.decl, name, depth + 1)
= null

────────────────────
_ is-builtin-member Bool
    - class-module ModuleId
    - class-decl DeclId
    - name Atom

|? builtin-classes.optional.refers-to(class-module, class-decl)
    name == value-name || name == has-value-name
|? builtin-classes.type-info.refers-to(class-module, class-decl)
    name == name-name || name == key-name || name == properties-name
|? builtin-classes.number.refers-to(class-module, class-decl)
    name == unit-name
??
    false

────────────────────
_ do extended-decl DeclRef?
    - module ModuleId
    - decl DeclId
    - row ExtensionDecl

` What an extension adds to: the class it names, or for a facet, the class or facet it is part
` of.
=? class-written(module, program.modules[module].tree, row.receiver) if !row.facet
. facets = program.facets
. facet = facets.index-of(module, decl)
=? null if !facet || facets.parent-modules[facet] == U32.max
= DeclRef(facets.parent-modules[facet], facets.parent-decls[facet])

────────────────────
_ do facet-member DeclRef?
    - owner-module ModuleId
    - owner DeclId
    - name Atom

` A member of a name that a facet of a class declares, among the facets this module sees: a
` public one, or a private one of a facet this module declares.
. facets = program.facets
=? null if facets.count == 0
. (start, end) = facets.class-range(owner-module, owner)
for position in start .. < end
    . facet = facets.class-facets[position]
    . facet-module = facets.modules[facet]
    if program.sees-facet(module, facet)
        . target = program.modules[facet-module]
        do match? target.decls[facets.decls[facet]]
            | .decl-extension(row)
                . found = member-row(target, row.members, name)
                if found && (facet-module == module || member-reaches(target, found, facet-module))
                    = DeclRef(facet-module, found)
= null

────────────────────
_ do member-reaches Bool
    - target Module
    - member DeclId
    - other ModuleId

` Whether this module reaches a member of a facet another module declares: a public one, or one
` shared with this module's file family.
. access = match target.decls[member]
    | .decl-property(row)
        row.access
    | .decl-event(row)
        row.access
    | .decl-function(row)
        row.access
    ??
        Access.private-access
= access is .public-access || (access is .family-access && program.same-family(module, other))

────────────────────
_ do member-row DeclId?
    - target Module
    - members RowRange'DeclId
    - name Atom

if members.count == 0
    = null
. place = target.first-member(members, name)
while place != no-member
    . member = target.member-pool[place]
    place = target.member-links[place]
    if member-named(target, member, name)
        = member
= null

────────────────────
_ member-named Bool
    - target Module
    - member DeclId
    - name Atom

match target.decls[member]
    | .decl-property(row)
        row.name && row.name == name
    | .decl-event(row)
        row.name == name
    | .decl-function(row)
        (row.kind == .getter-decl || row.kind == .setter-decl) && row.name && row.name == name
    ??
        false

────────────────────
_ do tuple-field-named Bool
    - owner-tree AST
    - base SyntaxId
    - name Atom

do match? owner-tree.nodes[base]
    | .node-type-tuple(row)
        for field in owner-tree.children[row.field-types]
            if capture-named(owner-tree, field, name)
                = true
= false

────────────────────
_ capture-named Bool
    - owner-tree AST
    - id SyntaxId
    - name Atom

` Whether a field of a type written as a tuple is a capture that names `name`.
match owner-tree.nodes[id]
    | .node-type-capture(row)
        identifier-name(owner-tree, row.id) == name
    ??
        false

────────────────────
_ do first-class-named DeclRef?
    - caller ModuleId
    - name Atom
    - given Size

. first DeclRef? = null
for candidate in program.lookup(caller, name)
    do match? program.modules[candidate.module].decls[candidate.decl]
        | .decl-class(row)
            if !first
                first = DeclRef(candidate.module, candidate.decl)
            if candidate.module == first.module && row.type-args.count == given
                = DeclRef(candidate.module, candidate.decl)
= first

────────────────────
_ class-written DeclRef?
    - caller ModuleId
    - tree AST
    - type SyntaxId

first-class-named(caller, head, type-argument-count(tree, type)) if head

.. head = type-head-name(tree, type)

────────────────────
_ type-argument-count Size
    - tree AST
    - type SyntaxId

match tree.nodes[type]
    | .node-type-arguments(row)
        row.args.count
    ??
        0

────────────────────
_ do declare SlotId
    - name Atom
    - kind SlotKind
    - syntax SyntaxId
    - flags SlotMask
    - group SyntaxId

. hidden = latest-names[name] ?? U32.max
if kind == .slot-local || kind == .slot-lazy
    . mark = scope-marks[scope-marks.length - 1]
    . earlier = hidden
    . named = group != 0 && tree.nodes[group] is .node-markup
    . taken = if kind == .slot-lazy || named then DiagnosticKind.lazy-defined else redefined
        .. redefined = DiagnosticKind.already-defined
    . site = if earlier != U32.max then bindings.slots[name-slots[earlier]].syntax else 0
    . again = redeclaring != 0 && site < tree.subtree-start(redeclaring)
    if earlier != U32.max && earlier >= mark && again && earlier-local
        bindings.diagnostics.append(Diagnostic(module, syntax, .redeclared, name, site))
        earlier = U32.max
    .. earlier-local = bindings.slots[name-slots[earlier]].kind == .slot-local
    while earlier != U32.max && earlier >= mark
        bindings.diagnostics.append
            - Diagnostic(module, if named then group else syntax, taken, name)
        earlier = name-links[earlier]

. row = Slot(kind, name, syntax, current-scope, decl, group, flags)
. slot = bindings.slots.append(row) as SlotId
name-links += hidden
latest-names[name] = names.length as U32
names += name
name-slots += slot
name-depths += function-depth
if kind == .slot-local
    settle-late(name, slot)
if kind == .slot-lazy
    . declared = if loop-depth != 0 then (LazyUseFlag.declared-in-loop) else 0u32
    bindings.record-lazy-use(slot, 0, 0, 0, 0, declared)
    bindings.set-lazy-bases(slot, branch-depth, loop-depth, subscription-depth, state-depth)
= slot

────────────────────
_ do push-scope
    - kind ScopeKind
    - syntax SyntaxId

. id = bindings.scopes.append(Scope(current-scope, kind, syntax)) as ScopeId
scope-marks += names.length
scope-stack += current-scope
current-scope = id

────────────────────
_ do pop-scope

?! Panic("Binder has no scope to pop")
    if scope-marks.length == 0

. mark = scope-marks[scope-marks.length - 1]
-= scope-marks[scope-marks.length - 1]
forget-names(mark)
-= names[mark .. < names.length]
-= name-slots[mark .. < name-slots.length]
-= name-depths[mark .. < name-depths.length]
-= name-links[mark .. < name-links.length]
current-scope = scope-stack[scope-stack.length - 1]
-= scope-stack[scope-stack.length - 1]
