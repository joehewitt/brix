────────────────────
+ do bind BindingId
    - function-module ModuleId
    - function-decl DeclId

` The binding of a function, made the first time it is asked for. One binder does every
` function of a program, so binding a function allocates only when a stack outgrows what an
` earlier function needed.
=? existing
    if existing
= run(function-module, function-decl)

.. existing = bindings.binding-for(function-module, function-decl)

────────────────────
+ member-of-class DeclRef?
    - owner-module ModuleId
    - owner DeclId
    - name Atom

member-of(owner-module, owner, name, 0) ?? method-of(owner-module, owner, name, 0)

────────────────────
_ do run BindingId
    - function-module ModuleId
    - function-decl DeclId

reset(function-module, function-decl)
. decls = program.modules[module].decls
do match? decls[decl]
    | .decl-function(row)
        . range = row.subtree
        binding = bindings.reserve(module, decl, range)
        do match? tree.nodes[row.syntax]
            | .node-function-syntax(node)
                check-effect-names(row.syntax, node.bans, node.door)
        bind-function()
        share-lazy-values()
        scan-body(row.syntax, range)
        bindings.finish(binding, tree)
        = binding
    | .decl-converter(row)
        . range = syntax-subtree(row.syntax)
        binding = bindings.reserve(module, decl, range)
        bind-converter(row.syntax, row.owner, 0)
        scan-body(row.syntax, range)
        bindings.finish(binding, tree)
        = binding
    | .decl-fromverter(row)
        . range = syntax-subtree(row.syntax)
        binding = bindings.reserve(module, decl, range)
        bind-converter(row.syntax, row.owner, row.source-type)
        scan-body(row.syntax, range)
        bindings.finish(binding, tree)
        = binding
?! Panic("Binding requires a function, converter, or fromverter declaration")

────────────────────
_ do check-effect-names
    - id SyntaxId
    - bans RowRange'Atom
    - door Atom?

` The effects a `without` section bans and a door names are effects its module sees.
for offset in 0 .. < bans.count
    . name = tree.atoms[bans.start + offset]
    . found = program.effect-named(module, name)
    if !found
        bindings.diagnostics.append(Diagnostic(module, id, .stated, program.store-atom("Unknown name '${name.text}' after without")))
    else if found >= most-effects()
        bindings.diagnostics.append(Diagnostic(module, id, .stated, program.store-atom("A program can ban at most ${most-effects()} effects, and '${name.text}' is past them")))
if door && !program.effect-named(module, door)
    bindings.diagnostics.append(Diagnostic(module, id, .stated, program.store-atom("Unknown effect '${door.text}' in @door")))

────────────────────
_ do reset
    - function-module ModuleId
    - function-decl DeclId

module = function-module
decl = function-decl
tree = program.modules[module].tree
index-module()
binding = no-binding
current-scope = 0
function-depth = 0
loop-depth = 0
branch-depth = 0
subscription-depth = 0
state-depth = 0
lazy-depth = 0
guard-depth = 0
stream-reach = 0
capture-floor = 0
pattern-depth = 0
pattern-floor = 0
alternative-floor = 0
alternative-ceiling = 0
stream-captures.clear()
coded-depth = 0
closed-matches.clear()
receiver-modules.clear()
receiver-decls.clear()
receiver-marks.clear()
receiver-elements.clear()
receiver-depths.clear()
receiver-scopes.clear()
received-reads.clear()
received-elements.clear()
received-scopes.clear()
content-bodies.clear()
content-turns.clear()
class-lines = 0
rule-lines = 0
raised-elements.clear()
placed-elements.clear()
in-callee = false
quiet-name = 0
repeating-depth = 0
owner-decl = 0
outer-uses-self = false
held = no-slot
subscriber-slots.clear()
owning-cases.clear()
tasks-cases.clear()
tasks-slots.clear()
builder-slots.clear()
fills = false
forget-names(0)
names.clear()
initializer-positions.clear()
name-slots.clear()
name-depths.clear()
name-links.clear()
scope-marks.clear()
scope-stack.clear()
nested-decls.clear()
nested-syntax.clear()
nested-scopes.clear()
nested-depths.clear()
nested-by-value.clear()
nested-marks.clear()
capture-frames.clear()
capture-slots.clear()
capture-flags.clear()
scan-starts.clear()
scan-ends.clear()
scan-rows.clear()
scan-stack-rows.clear()
scan-stack-ends.clear()
late-ids.clear()
late-names.clear()
late-flags.clear()
late-scopes.clear()
late-depths.clear()
late-diagnostics.clear()
late-frames.clear()
late-frame-decls.clear()
late-frame-depths.clear()
late-frame-values.clear()
raised-homes.clear()
row-getters.clear()
getter-decls.clear()
getter-firsts.clear()
getter-ends.clear()
getter-selves.clear()
getter-names.clear()
getter-nodes.clear()
getter-slots.clear()
