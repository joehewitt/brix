(import ./binding)
(import ./calls)
(import ./checker)
(import ./checker.assignments)
(import ./checker.comprehensions)
(import ./checker.live-actions)
(import ./checker.markup)
(import ./checker.match-arms)
(import ./checker.streams)
(import ./checker.tables)
(import ./conversions)
(import ./coverage)
(import ./dispatch)
(import ./error-sets)
(import ./facts)
(import ./frame)
(import ./header)
(import ./instances)
(import ./narrowing)
(import ./narrowing-key)
(import ./numeric)
(import ./panics)
(import ./pattern-helper)
(import ./portable)
(import ./probe-casts)
(import ./session)
(import ./signature)
(import ./table-rows)
(import ./type-env)
(import ./type-relation)
(import ./type-signature)
(import ./type-store)
(import ./type-text)
(import ./types)
(import ./typing-scratch)
(import /core/arena)
(import /core/scratch)
(import /lang/ast/ast)
(import /lang/ast/ast-children)
(import /lang/ast/ast-nodes)
(import /lang/ast/ast-queries)
(import /lang/ast/decl)
(import /lang/ast/facets)
(import /lang/ast/module)
(import /lang/ast/operator)
(import /lang/ast/program)
(import /lang/ast/row-range)
(import /lang/ast/state-machines)
(import /lang/ast/viability)
(import /lang/constants)
(import /stream/aggregate)
(import /stream/sort)

(type _ Loops (facet-of Checker)
  (sees Assignments)
  (sees Comprehensions)
  (sees LiveActions)
  (sees Markup)
  (sees MatchArms)
  (sees Streams)
  (sees Tables)
  (prop _ place-base SyntaxId (= 0))
  (fn-do + check-while _
    (param id SyntaxId)
    (param condition SyntaxId)
    (param body SyntaxId)
    (call (. frame forget-members))
    (call reset-assigned-paths body)
    (call note-poll)
    (+= loop-marks (. scratch narrowings mark))
    (= tested-match (call (. tree tested) condition))
    (let runs (if-expr (!= tested-match 0) condition body))
    (call note-truthiness condition condition (call infer-tested condition))
    (= tested-match 0)
    (let mark (. scratch narrowings mark))
    (call (. narrowing narrow-condition) condition true)
    (+= loop-depth 1)
    (= discarding-block body)
    (call check-steps body)
    (-= loop-depth 1)
    (call (. frame pop-narrowing) mark)
    (call widen-assigned id runs)
  )
  (fn-do + note-poll _
    ; A loop polls on each pass, unless it is where no safepoint is allowed.
    (if (== (/and/ (call dispatch-effects (. frame surround effects)) (. CompilationEffect no-safepoint)) 0)
      (call (. instances mark-polls) instance)
    )
  )
  (fn-do _ reset-assigned-paths _
    (param body SyntaxId)
    (if (== body 0)
      (return)
    )
    (for (in id (.. (call (. tree subtree-start) body) body))
      (match? ([] (. tree nodes) id)
        (case (call .node-assign row)
          (call reset-target-paths (. row lhs))
        )
      )
    )
  )
  (fn-do _ reset-target-paths _
    (param target SyntaxId)
    (match? ([] (. tree nodes) target)
      (case .node-identifier
        (let resolution (call (. bindings resolution-of) (. frame binding) target))
        (if (== (. resolution kind) .resolve-slot)
          (call (. frame reset-stable-paths) (call slot-key (. resolution slot)))
        )
      )
      (case (call .node-tuple-syntax row)
        (for (in item ([] (. tree children) (. row items)))
          (call reset-target-paths item)
        )
      )
    )
  )
  (fn-do _ widen-assigned _
    (param loop SyntaxId)
    (param body SyntaxId)
    ; A loop runs any number of times, so a local it assigns is afterwards what its declaration
    ; says, unless every assignment in the loop leaves it as it was known before the loop. What
    ; was known before the loop cannot be relied on in the body ahead of an assignment that
    ; breaks it: the body runs again after that assignment.
    (if (== body 0)
      (call leave-loop)
      (return)
    )
    (for (in id (.. (call (. tree subtree-start) body) body))
      (match? ([] (. tree nodes) id)
        (case (call .node-assign row)
          (let key (call (. narrowing condition-slot) (. row lhs)))
          (if (not key)
            (continue)
          )
          (let slot (call key-slot key))
          (let declared (call slot-known slot))
          (let settled declared)
          (if (== (. row op) .eq-op)
            (= settled (call assigned-narrowing declared (call (. facts node-type) instance (. row rhs))))
          )
          (let carried (call (. frame key-type) key))
          (let typed (and (!= declared no-type) (!= declared invalid-type)))
          (if (and typed (!= settled carried))
            (if (and (!= carried declared) (call relies-on slot id (. row lhs)))
              (let name (call (. tree identifier-name) (. row lhs)))
              (let shown (if-expr name (. name text) ""))
              (let message (str "Narrowing of '" shown "' is used in the loop but does not hold when "))
              (call (. frame diagnose) loop .stated (call (. program store-atom) (++ message "the loop repeats")))
            )
            (call (. frame push-assigned) key declared)
          )
        )
      )
    )
    (call leave-loop)
  )
  (fn-do _ relies-on Bool
    (param slot SlotId)
    (param assignment SyntaxId)
    (param target SyntaxId)
    ; Whether the innermost loop reads a local as what was known of it before the loop, ahead of
    ; an assignment to it.
    (let loop (- (. loop-marks length) 1))
    (for (in position (..< 0 (. carried-sites length)))
      (let site ([] carried-sites position))
      (if (and (== ([] carried-slots position) slot) (== ([] carried-loops position) loop))
        (if (and (< site assignment) (!= site target))
          (return true)
        )
      )
    )
    (return false)
  )
  (fn-do _ leave-loop _
    (let loop (- (. loop-marks length) 1))
    (let kept 0)
    (for (in position (..< 0 (. carried-sites length)))
      (if (!= ([] carried-loops position) loop)
        (= ([] carried-slots kept) ([] carried-slots position))
        (= ([] carried-loops kept) ([] carried-loops position))
        (= ([] carried-sites kept) ([] carried-sites position))
        (+= kept 1)
      )
    )
    (-= ([] carried-slots (..< kept (. carried-slots length))))
    (-= ([] carried-loops (..< kept (. carried-loops length))))
    (-= ([] carried-sites (..< kept (. carried-sites length))))
    (call (. loop-marks pop))
  )
  (fn-do + check-for _
    (param id SyntaxId)
    (param loop SyntaxId)
    (param body SyntaxId)
    (param next SyntaxId)
    ; A `for` block. One on a stream subscribes where it is written, and its subscriber runs the
    ; body; one on a stream joined to another source, by a header chained after it or an `or`
    ; arm, is an error. Any other loop runs its headers and its body.
    (match? ([] (. tree nodes) loop)
      (case (call .node-loop-syntax row)
        (if (and (. row is-subscriber) (call (. tree is-grammar) (. row pattern)))
          (call report-pattern-on (. row pattern))
          (return)
        )
        (if (and (. row is-subscriber) (or (!= (. row next) 0) (!= next 0)))
          (let text "A loop on a stream subscribes to one source, so it cannot be joined to another; write a loop for each source")
          (call (. frame diagnose) loop .stated (call (. program store-atom) text))
          (return)
        )
        (let subscriber (if-expr (. row is-subscriber) (call nested-decl-of id) 0u32))
        (if (and (!= subscriber 0) (== (. frame declaration syntax) id))
          (call check-subscriber loop body)
          (else-if (!= subscriber 0)
            (call check-subscription id loop (. row container) (. row clause) subscriber)
          )
        )
        (if (!= subscriber 0)
          (if (!= next 0)
            (call check-statement next)
          )
          (return)
        )
        (let simple (and (== (. row next) 0) (call (. tree is-simple-loop-pattern) (. row pattern))))
        (let container (call loop-container (. row container) simple (call stated-item (. row pattern))))
        (call (. frame forget-members))
        (call reset-assigned-paths body)
        (let alone (and (== (. row next) 0) (not (. row is-subscriber)) (not (. row is-match))))
        (if (and (!= (. container item) no-type) alone)
          (call (. facts set-plan) instance loop .plan-range-loop)
        )
        (call note-poll)
        (+= loop-marks (. scratch narrowings mark))
        (call check-loop loop container body false (== (. row next) 0))
        (if (and (!= (. container item) no-type) alone)
          (if (call (. tree counts-from-zero) (. row container))
            (call (. facts set-constant)
              (block
                (arg instance)
                (arg loop)
                (arg (call ConstantFact 1 0.0 null false))
                (arg .plan-range-loop)
              )
            )
          )
          (call note-proven-rows loop (. row pattern) (. row container) (. row clause) body)
          (call note-proven-items (. row pattern) (. row container) (. row clause) body)
        )
        (call widen-assigned id body)
      )
    )
    (if (!= next 0)
      (call check-statement next)
    )
  )
  (fn-do + check-loop _
    (param loop SyntaxId)
    (param container LoopContainer)
    (param body SyntaxId)
    (param yields Bool)
    (param alone Bool (= false))
    (param given Bool (= false))
    ; One loop header over a container typed by the caller, then its chained headers and the body,
    ; which a comprehension yields and a `for` block runs. A `for` block's header `alone` in it
    ; gives the rows of a table as TypeScript gives them. A comprehension's header is `given` its
    ; container, which a loop over the rows of a table keeps until it begins. A pattern written as a match with no arms
    ; gives the item as it fitted, but one that names a case of a union leaves it the union. A
    ; `keyed by` keys only the rows of a markup loop region, which is not checked here.
    (match? ([] (. tree nodes) loop)
      (case (call .node-loop-syntax row)
        (if (not (. row is-subscriber))
          (call reject-keyed-clause (. row clause))
        )
        (if (call (. tree is-grammar) (. row pattern))
          (if (call check-pattern-header loop (. row pattern) (. container type))
            (call check-loop-rest loop (call tested-clause loop (. row clause)) (. row next) body yields)
          )
          (return)
        )
        (let item (. container item))
        (let iterated (. container type))
        (if (== item no-type)
          (if (not (. row is-subscriber))
            (= iterated (call iteration-container (. container type) (. row container)))
          )
          (= item (call loop-item-type iterated loop (call slice-through-call (. row container))))
          (let given (and (!= iterated invalid-type) (!= iterated no-type)))
          (if (and (== item invalid-type) given (not (. row is-subscriber)))
            (call (. frame diagnose) (. row container) .stated (call (. program store-atom) "Object is not iterable"))
          )
        )
        (let yielded item)
        (let pattern (. row pattern))
        (let transformed false)
        (let matched (. row is-match))
        (let fitted false)
        (match? ([] (. tree nodes) pattern)
          (case (call .node-structure-match inner)
            (= transformed (call (. tree has-arms) (. inner pattern)))
            (= pattern (. inner pattern))
            (= matched true)
            (= fitted (not transformed))
          )
        )
        (if transformed
          (= item (call match-item (. row pattern) pattern item))
          (else-if matched
            (call check-pattern pattern item)
            (if (and fitted typed-item (not (is ([] (. tree nodes) pattern) .node-type-case)))
              (= item (call pattern-value pattern item))
            )
            (lazy typed-item (and (!= item no-type) (!= item invalid-type)))
          )
          (else
            (call declare pattern item (. row container))
          )
        )
        (call (. facts set-loop-take) instance loop (call loop-take pattern transformed matched))
        (if (and itemless (or (call counts-rows iterated) (call counts-indices iterated (. row container))))
          (call (. facts set-plan) instance loop .plan-table-loop)
          (call (. instances mark-may-panic) instance)
          (let kind (call (. types intrinsic-of) iterated))
          (let held
            (scope (or (== kind .table-selection) (== kind .immutable-table-selection) spans-index)
              (lazy spans-index (== kind .index-span))
            )
          )
          (call keep-loop loop (if-expr held iterated yielded) (. types size-type) (. types size-type))
          (if given
            (call keep-loop-given loop iterated)
          )
          (if (and alone (not yields) (call checks-rows (. row pattern) iterated body (. row clause)))
            (call note-checked-rows loop (. row pattern))
          )
          (else-if (== (. container item) no-type)
            (call note-container-iteration loop iterated false loop)
            (if (== (call (. facts plan-of) instance loop) .plan-cursor-loop)
              (call note-place loop (. row container) iterated .plan-cursor-place-loop)
            )
            (if (call is-indexed iterated (call slice-through-call (. row container)))
              (call (. facts set-plan) instance loop .plan-index-loop)
              (if (call is-array-field iterated (!! (. types length-atom)))
                (call (. facts set-constant)
                  (block
                    (arg instance)
                    (arg loop)
                    (arg (call ConstantFact 1 0 null false))
                    (arg .plan-index-loop)
                  )
                )
              )
              (call keep-loop loop iterated (. types size-type) (. types size-type))
              (call note-place loop (. row container) iterated .plan-index-place-loop)
            )
          )
          (else
            (call keep-loop loop (. container item) (. container item) (. types bool-type))
          )
        )
        (lazy itemless (== (. container item) no-type))
        (call keep-loop-item loop (if-expr transformed item yielded))
        (call assign-loop-slots loop item (and (!= (. row pattern) 0) (not transformed) (not fitted)))
        (call check-loop-rest loop (call tested-clause loop (. row clause)) (. row next) body yields)
        (if (and alone (not yields) (not (. row is-match)) (not (. row is-subscriber)) table-looped)
          (if (call proves-rows (. row pattern) iterated body (. row clause))
            (call (. facts set-constant)
              (block
                (arg instance)
                (arg loop)
                (arg (call ConstantFact 1 0.0 null false))
                (arg .plan-table-loop)
              )
            )
          )
        )
        (lazy table-looped (== (call (. facts plan-of) instance loop) .plan-table-loop))
        (let selects
          (scope (or (== (call (. types intrinsic-of) iterated) .table-selection) immutable-selection)
            (lazy immutable-selection (== (call (. types intrinsic-of) iterated) .immutable-table-selection))
          )
        )
        (if (and selects (== (call (. facts plan-of) instance loop) .plan-table-loop))
          (let reads
            (call selection-reads
              (block
                (arg (. row container))
                (arg iterated)
                (arg body)
                (arg (. row clause))
                (arg (or (!= (. row next) 0) yields))
              )
            )
          )
          (call (. facts set-constant)
            (block
              (arg instance)
              (arg loop)
              (arg (call ConstantFact reads 0 null false))
              (arg .plan-table-loop)
            )
          )
        )
      )
    )
  )
  (fn-do _ reject-keyed-clause _
    (param clause SyntaxId)
    (let current clause)
    (while (!= current 0)
      (let next SyntaxId 0)
      (match? ([] (. tree nodes) current)
        (case (call .node-clause row)
          (if (== (. row op) .keyed-by-clause)
            (call (. frame diagnose)
              (block
                (arg current)
                (arg .stated)
                (arg (call (. program store-atom) "keyed by is only valid on markup loops"))
              )
            )
          )
          (= next (. row next))
        )
      )
      (= current next)
    )
  )
  (fn-expr _ tested-clause SyntaxId
    (param loop SyntaxId)
    (param clause SyntaxId)
    ; The clauses of a loop header that are tested: those after the first of a loop on an event
    ; whose first clause says which publications it hears. A `whenever` among them says whether
    ; the loop is subscribed and is not tested.
    (if-expr (call (. facts event-clause-of) module loop) (call (. tree next-clause) clause) clause)
  )
  (fn-do _ check-loop-rest _
    (param loop SyntaxId)
    (param clause SyntaxId)
    (param next SyntaxId)
    (param body SyntaxId)
    (param yields Bool)
    ; What follows a loop's header: its clause, which holds wherever the body runs, then the
    ; headers chained after it, or the body.
    (let clause-mark (. scratch narrowings mark))
    (if (!= clause 0)
      (call check-clause clause body)
    )
    (if (!= next 0)
      (match? ([] (. tree nodes) next)
        (case (call .node-loop-syntax following)
          (call check-loop
            (block
              (arg next)
              (arg (call loop-container (. following container) false (call stated-item (. following pattern))))
              (arg body)
              (arg yields)
            )
          )
        )
      )
      (else-if (and yields (call is-subscriber-body))
        (call note-broadcast body (call infer body))
      )
      (else-if yields
        (call note-yield (call infer body))
      )
      (else
        (+= loop-depth 1)
        (call check-body body)
        (-= loop-depth 1)
      )
    )
    (call (. frame pop-narrowing) clause-mark)
  )
  (fn-do _ check-pattern-header Bool
    (param loop SyntaxId)
    (param written SyntaxId)
    (param container TypeId)
    ; A loop's header written as a grammar, as the reference runs it: the container is
    ; read through the stream a match would read it through, made once, by the calls recorded at
    ; the header, and each pass matches the pattern from where the last left the stream, as a
    ; rule's arms match, without reading the rest. The loop ends where the stream has no more or
    ; the pattern fails, and a pattern that may match without reading, where the reference knows
    ; what it reads first, is an error, as it is in a pipe. Its item, `each`
    ; and `it`, is what the pattern gives, and the names it captures are the body's. One whose
    ; item is optional is an error: the reference gives what the optional holds, or a value it
    ; can not print. One whose names are not each what one part gave has no shape. A container the
    ; reference finds no iterator for is read through its stream all the same, as the reference's
    ; `StreamSourceIterator` lets it be, and one it makes no stream of is its error at the pattern.
    ; False where the header was declined.
    (let pattern written)
    (match? ([] (. tree nodes) written)
      (case (call .node-stream-match row)
        (= pattern (. row pattern))
      )
    )
    (if (or (== container invalid-type) (== container no-type))
      (return false)
    )
    (if (and (not (call iterates container)) (== (call natural-item container) no-type))
      (call (. frame diagnose) written .stated (call (. program store-atom) "Can't convert to iterable"))
      (return false)
    )
    (if (or (== (call first-set pattern) 3) (call (. tree never-reads) pattern))
      (call (. frame diagnose) written .stated (call (. program store-atom) "Grammar loop must consume input"))
      (return false)
    )
    (let buffer stream-view)
    (let read (call record-stream-protocol loop container))
    (let made (. stream-view type))
    (let typed (if-expr read (call type-stream-arms pattern true) invalid-type))
    (= stream-view buffer)
    (if (or (not read) (and (!= typed invalid-type) (not (call plain-captures pattern))))
      (call decline loop)
      (return false)
    )
    (if (== typed invalid-type)
      (return false)
    )
    (if (call (. types is-optional) typed)
      (call (. frame diagnose) written .stated (call (. program store-atom) (call optional-match-text "loop")))
      (return false)
    )
    (if (!= (call (. calls protocol-getter) made (call (. program store-atom) "has-more") loop) (. types bool-type))
      (call decline loop)
      (return false)
    )
    (call (. facts set-plan) instance loop .plan-pattern-loop)
    (call (. facts set-loop-take) instance loop .take-whole)
    (call keep-loop loop container made)
    (call keep-loop-item loop typed)
    (call assign-loop-slots loop typed false)
    (return true)
  )
  (fn-do + iterates Bool
    (param container TypeId)
    ; Whether the reference finds an iterator for the container of a loop over a stream, as it
    ; does before it makes the stream, though it uses none: a generator, or a value `supported` as
    ; a `CursorIterable`, an `Iterable`, an `Indexable` or a `Stream`.
    (if (call same-decl (call class-ref types container) (. types generator-decl))
      (return true)
    )
    (for (in decl (list (. types cursor-iterable-decl) (. types iterable-decl) (. types indexable-decl) (. types stream-decl)))
      (if (!= (call supported container decl) no-type)
        (return true)
      )
    )
    (return false)
  )
  (fn-do _ plain-captures Bool
    (param id SyntaxId)
    (param repeated Bool (= false))
    ; Whether each name a grammar captures holds what one part of it gave, as the
    ; reference gives the body of a loop the names its header captures: none captured in a
    ; repeat or a count, nor one that accumulates, which the reference can not compile there,
    ; nor one that may hold nothing, which it gives the body as a value it can not read.
    (match? ([] (. tree nodes) id)
      (case (call .node-stream-capture row)
        (if (or repeated (. row accumulating) (call (. types is-optional) (call (. facts node-type) instance (. row name))))
          (return false)
        )
        (return (call plain-captures (. row pattern) repeated))
      )
      (case (call .node-stream-and row)
        (return (and (call plain-captures (. row left) repeated) (call plain-captures (. row right) repeated)))
      )
      (case (call .node-stream-or row)
        (return (and (call plain-captures (. row left) repeated) (call plain-captures (. row right) repeated)))
      )
      (case (call .node-stream-transform row)
        (return (call plain-captures (. row pattern) repeated))
      )
      (case (call .node-stream-panic row)
        (return (call plain-captures (. row pattern) repeated))
      )
      (case (call .node-stream-unary row)
        (let repeat (or (== (. row op) .zero-or-more-op) (== (. row op) .one-or-more-op)))
        (return (call plain-captures (. row operand) (or repeated repeat)))
      )
      (case (call .node-stream-length row)
        (return (call plain-captures (. row operand) true))
      )
    )
    (return true)
  )
  (fn-do _ checks-rows Bool
    (param pattern SyntaxId)
    (param iterated TypeId)
    (param body SyntaxId)
    (param clause SyntaxId)
    ; Whether a loop gives each row of a table or a span of one as `t[i]` gives it, a row whose
    ; storage TypeScript checked: where the rows are of a union, the loop names its row alone, no
    ; nested function reads it, and neither the body nor the clause calls a local.
    (let kind (call (. types intrinsic-of) iterated))
    (if (or (== kind .table-selection) (== kind .immutable-table-selection) complex-pattern)
      (return false)
    )
    (lazy complex-pattern (not (call (. tree is-simple-loop-pattern) pattern)))
    (if (!= (call (. types intrinsic-of) (call row-struct-of iterated)) .union)
      (return false)
    )
    (let blocked (list Atom))
    (let effects (call SelectionEffects))
    (call scan-effects body blocked effects)
    (if (!= clause 0)
      (call scan-effects clause blocked effects)
    )
    (return (not (. effects table)))
  )
  (fn-expr _ proves-rows Bool
    (param pattern SyntaxId)
    (param iterated TypeId)
    (param body SyntaxId)
    (param clause SyntaxId)
    (case? (or (and (!= kind .table) (!= kind .table-span)) (== pattern 0) (not (call (. tree is-simple-loop-pattern) pattern)))
      false
    )
    (case? (or (not named) (!= (/and/ (. ([] (. bindings slots) named) flags) (. SlotFlag slot-captured)) 0))
      false
    )
    (default
      (and (call keeps-table body) (or (== clause 0) (call keeps-table clause)))
    )
    (where
      (lazy kind (call (. types intrinsic-of) iterated))
      (lazy named (call declaring-slot pattern))
    )
  )
  (fn-do _ keeps-table Bool
    (param root SyntaxId)
    (for (in node (..< (call (. tree subtree-start) root) (+ root 1)))
      (if (not (call keeps-table-node node))
        (return false)
      )
    )
    (return true)
  )
  (fn-do _ keeps-table-node Bool
    (param node SyntaxId)
    (let op (call planned-table-op node))
    (if (and has-call (!= op (. TableOp table-field)) (!= op (. TableOp table-row)))
      (return false)
    )
    (lazy has-call (!= (call (. facts first-call) instance node) no-fact))
    (match? ([] (. tree nodes) node)
      (case .node-identifier
        (let resolution (call (. bindings resolution-of) (. frame binding) node))
        (return (or (!= (. resolution kind) .resolve-slot) (!= (. ([] (. bindings slots) (. resolution slot)) kind) .slot-lazy)))
      )
      (case (call .node-unary-expression unary)
        (return (or (== (. unary op) .negative-op) (== (. unary op) .not-op)))
      )
      (case (call .node-get-expression get)
        (return (not (. get is-tracked)))
      )
      (case (call .node-assign assign)
        (return (call assigns-number (. assign lhs)))
      )
      (case (call .node-type-capture capture)
        (return (== (. capture type) 0))
      )
      (case (call .node-type-predicate predicate)
        (return (not (. predicate is-contextual)))
      )
      (case (call .node-type-equality equality)
        (return (not (. equality is-contextual)))
      )
      (case (call .node-clause clause)
        (return (!= (. clause op) .whenever-clause))
      )
      (case (call .node-match-expression matched)
        (return (== (. matched helper) 0))
      )
    )
    (return
      (match ([] (. tree nodes) node)
        (case .node-integer-syntax
          true
        )
        (case .node-float-syntax
          true
        )
        (case .node-binary-expression
          true
        )
        (case .node-cast-expression
          true
        )
        (case .node-declare
          true
        )
        (case .node-block
          true
        )
        (case .node-if-block
          true
        )
        (case .node-break
          true
        )
        (case .node-continue
          true
        )
        (case .node-return
          true
        )
        (case .node-structure-match
          true
        )
        (case .node-type-or
          true
        )
        (case .node-type-transform
          true
        )
        (case .node-type-case
          true
        )
        (case .node-type-tuple
          true
        )
        (case .node-type-wildcard
          true
        )
        (case .node-type-identifier
          true
        )
        (default
          false
        )
      )
    )
  )
  (fn-do _ assigns-number Bool
    (param lhs SyntaxId)
    (match? ([] (. tree nodes) lhs)
      (case .node-identifier
        (let resolution (call (. bindings resolution-of) (. frame binding) lhs))
        (let local
          (scope (and (== (. resolution kind) .resolve-slot) local-slot)
            (lazy local-slot (== (. ([] (. bindings slots) (. resolution slot)) kind) .slot-local))
          )
        )
        (let type (call (. facts node-type) instance lhs))
        (if (or (and (not local) (!= (. resolution kind) .resolve-global)) (== type no-type) (== type invalid-type))
          (return false)
        )
        (return (call intrinsic-is-numeric (call (. types intrinsic-of) type)))
      )
    )
    (return false)
  )
  (fn-do _ note-checked-rows _
    (param loop SyntaxId)
    (param pattern SyntaxId)
    ; Keeps the names a loop gives its rows by as reading rows whose storage was checked, unless a
    ; nested function reads one of them.
    (let slots (list SlotId))
    (if (!= pattern 0)
      (let named (call declaring-slot pattern))
      (if named
        (+= slots named)
      )
    )
    (let first (call (. bindings resolution-of) (. frame binding) loop))
    (if (== (. first kind) .resolve-slot)
      (let bound ([] (. bindings bindings) (. frame binding)))
      (let slot (. first slot))
      (while (< slot (+ (. bound slots start) (. bound slots count)))
        (let row ([] (. bindings slots) slot))
        (if (or (and (!= (. row kind) .slot-it) (!= (. row kind) .slot-each)) (!= (. row syntax) loop))
          (break)
        )
        (+= slots slot)
        (+= slot 1)
      )
    )
    (for (in slot slots)
      (if (!= (/and/ (. ([] (. bindings slots) slot) flags) (. SlotFlag slot-captured)) 0)
        (return)
      )
    )
    (for (in slot slots)
      (+= checked-rows slot)
    )
  )
  (fn-do _ note-proven-rows _
    (param loop SyntaxId)
    (param pattern SyntaxId)
    (param container SyntaxId)
    (param clause SyntaxId)
    (param body SyntaxId)
    (let view (call counted-view container))
    (if (or (not view) (== pattern 0))
      (return)
    )
    (let counter (call declaring-slot pattern))
    (if (not counter)
      (return)
    )
    (if (or (not (call keeps-rows body view counter)) (and (!= clause 0) (not (call keeps-rows clause view counter))))
      (return)
    )
    (call mark-proven-rows loop body view counter)
    (if (!= clause 0)
      (call mark-proven-rows loop clause view counter)
    )
  )
  (fn-do _ note-proven-items _
    (param pattern SyntaxId)
    (param container SyntaxId)
    (param clause SyntaxId)
    (param body SyntaxId)
    (let array (call counted-array container))
    (if (or (not array) (== pattern 0))
      (return)
    )
    (let counter (call declaring-slot pattern))
    (if (not counter)
      (return)
    )
    (if (or (not (call uses-as-items body array)) (and (!= clause 0) (not (call uses-as-items clause array))))
      (return)
    )
    (call mark-proven-items body array counter)
    (if (!= clause 0)
      (call mark-proven-items clause array counter)
    )
  )
  (fn-do _ counted-array (? SlotId)
    (param container SyntaxId)
    (if (not (call (. tree counts-from-zero) container))
      (return null)
    )
    (match? ([] (. tree nodes) container)
      (case (call .node-range-expression range)
        (match? ([] (. tree nodes) (. range right))
          (case (call .node-get-expression get)
            (if (or (. get is-tracked) (. get is-optional) uncounted)
              (return null)
            )
            (lazy uncounted (and (!= (. get name text) "length") (!= (. get name text) "size")))
            (if (not (call holds-array-items (call (. facts node-type) instance (. get object))))
              (return null)
            )
            (return (call plain-local (. get object)))
          )
        )
      )
    )
    (return null)
  )
  (fn-do _ uses-as-items Bool
    (param root SyntaxId)
    (param array SlotId)
    (let named U32)
    (let used U32)
    (for (in node (..< (call (. tree subtree-start) root) (+ root 1)))
      (if (call names-slot node array)
        (+= named 1)
      )
      (match? ([] (. tree nodes) node)
        (case (call .node-index-expression index)
          (if (call names-slot (. index object) array)
            (+= used 1)
          )
        )
        (case (call .node-get-expression get)
          (if (and (call names-slot (. get object) array) plain-get counted-name)
            (+= used 1)
          )
          (lazy plain-get (and (not (. get is-tracked)) (not (. get is-optional))))
          (lazy counted-name (or (== (. get name text) "length") (== (. get name text) "size")))
        )
      )
    )
    (return (== named used))
  )
  (fn-do _ mark-proven-items _
    (param root SyntaxId)
    (param array SlotId)
    (param counter SlotId)
    (for (in node (..< (call (. tree subtree-start) root) (+ root 1)))
      (if (and (== (call (. facts plan-of) instance node) .plan-array-item) (call is-counted-row node array counter))
        (call (. facts set-constant) instance node (call ConstantFact 1 0.0 null false) .plan-array-item)
      )
    )
  )
  (fn-do _ mark-proven-rows _
    (param loop SyntaxId)
    (param root SyntaxId)
    (param view SlotId)
    (param counter SlotId)
    (let proven (/or/ (as (. TableOp proven-row) U64) (/lshift/ (as loop U64) 32)))
    (for (in node (..< (call (. tree subtree-start) root) (+ root 1)))
      (if (call is-counted-row node view counter)
        (if (== (call (. facts plan-of) instance node) .plan-view)
          (call (. facts set-plan) instance node .plan-proven-row)
          (else-if (== (call planned-table-op node) (. TableOp table-row))
            (call (. facts set-constant) instance node (call ConstantFact proven 0.0 null false) .plan-table)
          )
        )
      )
    )
  )
  (fn-expr _ planned-table-op (? TableOp)
    (param node SyntaxId)
    (case? (or (== constant no-fact) (!= (call (. facts plan-of) instance node) .plan-table))
      null
    )
    (default
      (as (as (/and/ (. ([] (. facts constants) constant) bits) 4294967295) U32) TableOp)
    )
    (where
      (lazy constant (call (. facts constant-of) instance node))
    )
  )
  (fn-do _ counted-view (? SlotId)
    (param container SyntaxId)
    (match? ([] (. tree nodes) container)
      (case (call .node-range-expression range)
        (if (or (!= (. range op) .range-to-op) (!= (. range increment) 0) (not (call (. tree is-zero-literal) (. range left))))
          (return null)
        )
        (match? ([] (. tree nodes) (. range right))
          (case (call .node-get-expression get)
            (if (or (. get is-tracked) (. get is-optional) uncounted)
              (return null)
            )
            (lazy uncounted (and (!= (. get name text) "length") (!= (. get name text) "size")))
            (if (and (!= (call view-kind (call (. facts node-type) instance (. get object))) 1) not-length)
              (return null)
            )
            (lazy not-length (!= (call planned-table-op (. range right)) (. TableOp table-length)))
            (return (call plain-local (. get object)))
          )
        )
      )
    )
    (return null)
  )
  (fn-do _ plain-local (? SlotId)
    (param syntax SyntaxId)
    (match? ([] (. tree nodes) syntax)
      (case (call .node-identifier named)
        (if (. named is-tracked)
          (return null)
        )
        (let resolution (call (. bindings resolution-of) (. frame binding) syntax))
        (if (!= (. resolution kind) .resolve-slot)
          (return null)
        )
        (let slot ([] (. bindings slots) (. resolution slot)))
        (if (and (!= (. slot kind) .slot-local) (!= (. slot kind) .slot-argument))
          (return null)
        )
        (if (or (!= (/and/ (. slot flags) (. SlotFlag slot-captured)) 0) address-taken)
          (return null)
        )
        (lazy address-taken (!= (/and/ (. slot flags) (. SlotFlag slot-address-taken)) 0))
        (return (. resolution slot))
      )
    )
    (return null)
  )
  (fn-do _ names-slot Bool
    (param syntax SyntaxId)
    (param slot SlotId)
    (match? ([] (. tree nodes) syntax)
      (case (call .node-identifier named)
        (if (. named is-tracked)
          (return false)
        )
        (let resolution (call (. bindings resolution-of) (. frame binding) syntax))
        (return (and (== (. resolution kind) .resolve-slot) (== (. resolution slot) slot)))
      )
    )
    (return false)
  )
  (fn-do _ is-counted-row Bool
    (param node SyntaxId)
    (param view SlotId)
    (param counter SlotId)
    (match? ([] (. tree nodes) node)
      (case (call .node-index-expression index)
        (return (and (not (. index is-optional)) (call names-slot (. index object) view) (call names-slot (. index index) counter)))
      )
    )
    (return false)
  )
  (fn-do _ keeps-rows Bool
    (param root SyntaxId)
    (param view SlotId)
    (param counter SlotId)
    (for (in node (..< (call (. tree subtree-start) root) (+ root 1)))
      (if (not (call keeps-row node view counter))
        (return false)
      )
    )
    (return true)
  )
  (fn-do _ keeps-row Bool
    (param node SyntaxId)
    (param view SlotId)
    (param counter SlotId)
    (let answered
      (scope (or (== (call planned-table-op node) (. TableOp table-row)) field-op)
        (lazy field-op (== (call planned-table-op node) (. TableOp table-field)))
      )
    )
    (if (and (!= (call (. facts first-call) instance node) no-fact) (not answered))
      (return false)
    )
    (match? ([] (. tree nodes) node)
      (case (call .node-unary-expression unary)
        (return (or (== (. unary op) .negative-op) (== (. unary op) .not-op)))
      )
      (case (call .node-get-expression get)
        (if (or (. get is-tracked) (. get is-optional) (and unviewed not-field))
          (return false)
        )
        (lazy unviewed (!= (call (. facts plan-of) instance node) .plan-view))
        (lazy not-field (!= (call planned-table-op node) (. TableOp table-field)))
        (return
          (scope (and (call is-counted-row (. get object) view counter) (call intrinsic-is-numeric node-kind))
            (lazy node-kind (call (. types intrinsic-of) (call (. facts node-type) instance node)))
          )
        )
      )
      (case (call .node-assign assign)
        (return (call keeps-assigned (. assign lhs) view counter))
      )
      (case (call .node-type-capture capture)
        (return (== (. capture type) 0))
      )
      (case (call .node-type-predicate predicate)
        (return (not (. predicate is-contextual)))
      )
      (case (call .node-clause clause)
        (return (!= (. clause op) .whenever-clause))
      )
    )
    (return
      (match ([] (. tree nodes) node)
        (case .node-identifier
          true
        )
        (case .node-integer-syntax
          true
        )
        (case .node-float-syntax
          true
        )
        (case .node-binary-expression
          true
        )
        (case .node-cast-expression
          true
        )
        (case .node-index-expression
          true
        )
        (case .node-declare
          true
        )
        (case .node-block
          true
        )
        (case .node-if-block
          true
        )
        (case .node-break
          true
        )
        (case .node-continue
          true
        )
        (default
          false
        )
      )
    )
  )
  (fn-do _ keeps-assigned Bool
    (param lhs SyntaxId)
    (param view SlotId)
    (param counter SlotId)
    (match? ([] (. tree nodes) lhs)
      (case (call .node-get-expression get)
        (return (and (== (call (. facts plan-of) instance lhs) .plan-view) (call is-counted-row (. get object) view counter)))
      )
      (case .node-identifier
        (if (or (call names-slot lhs view) (call names-slot lhs counter))
          (return false)
        )
        (return (call intrinsic-is-numeric (call (. types intrinsic-of) (call (. facts node-type) instance lhs))))
      )
    )
    (return false)
  )
  (fn-do _ selection-reads U64
    (param container SyntaxId)
    (param selection TypeId)
    (param body SyntaxId)
    (param clause SyntaxId)
    (param chained Bool)
    ; How a loop over a selection of a table's rows reads its indices, as TypeScript's loop over
    ; rows decides from what its body and its clause may change: 1 where the indices are found
    ; again on each pass, and 2 where TypeScript leaves the loop to the selection's own iteration,
    ; or where what the body changes cannot be told. A name assigned or declared is changed, and
    ; so is each name in a place assigned, which may change indices; a call of a local may change
    ; a table or indices, and a call of a member each name its receiver and arguments are written
    ; with, and indices through a builder or an arena, or a table through a table that grows.
    (let blocked (list Atom))
    (let effects (call SelectionEffects))
    (call scan-effects body blocked effects)
    (if (!= clause 0)
      (call scan-effects clause blocked effects)
    )
    (if (or chained (. effects unknown))
      (return 2)
    )
    (let roots (list Atom))
    (let subject (call subject-roots container roots))
    (let stable (== (call (. types intrinsic-of) selection) .immutable-table-selection))
    (let source-blocked (and subject (!= (. roots length) 0) (call has-atom blocked ([] roots 0))))
    (if (and (not stable) (or source-blocked (. effects table) (. effects selected-table)))
      (return 2)
    )
    (let again (or (. effects table) (. effects indices)))
    (if subject
      (for (in position (..< 1 (. roots length)))
        (if (and (!= ([] roots position) ([] roots 0)) (call has-atom blocked ([] roots position)))
          (= again true)
        )
      )
    )
    (return (if-expr again 1 0))
  )
  (fn-do _ scan-effects _
    (param root SyntaxId)
    (param blocked (list Atom))
    (param effects SelectionEffects)
    ; Notes what the nodes under a node may change, as TypeScript's loop over rows notes it.
    (for (in node (..< (call (. tree subtree-start) root) (+ root 1)))
      (match? ([] (. tree nodes) node)
        (case (call .node-assign row)
          (match ([] (. tree nodes) (. row lhs))
            (case (call .node-identifier named)
              (+= blocked (. named name))
            )
            (default
              (call (. tree block-names) (. row lhs) blocked)
              (= (. effects indices) true)
            )
          )
        )
        (case (call .node-call-expression row)
          (match ([] (. tree nodes) (. row callable))
            (case .node-identifier
              (if (== (. (call (. bindings resolution-of) (. frame binding) (. row callable)) kind) .resolve-slot)
                (= (. effects table) true)
                (= (. effects indices) true)
              )
            )
            (default
              (call (. tree block-names) (. row callable) blocked)
              (match? ([] (. tree nodes) (. row callable))
                (case (call .node-get-expression get)
                  (call note-call-effect (. get object) effects)
                )
              )
            )
          )
          (for (in operand ([] (. tree children) (. row operands)))
            (let expression operand)
            (match? ([] (. tree nodes) operand)
              (case (call .node-argument argument)
                (= expression (. argument expr))
              )
            )
            (call (. tree block-names) expression blocked)
            (call note-call-effect expression effects)
          )
        )
        (case (call .node-declare row)
          (let named (call pattern-name types tree (. row left)))
          (if named
            (+= blocked named)
          )
        )
      )
    )
  )
  (fn-do _ note-call-effect _
    (param expression SyntaxId)
    (param effects SelectionEffects)
    ; Notes what a call may change through a value it is given: indices through a builder or an
    ; arena, and a table through a table that grows. A value whose type is not known here leaves
    ; what the call changes unknown.
    (let type (call (. facts node-type) instance expression))
    (if (or (== type no-type) (== type invalid-type))
      (= (. effects unknown) true)
      (return)
    )
    (let kind (call (. types intrinsic-of) type))
    (if (or (== kind .array-builder) (call (. types is-arena) type))
      (= (. effects indices) true)
    )
    (if (== kind .table)
      (= (. effects selected-table) true)
    )
  )
  (fn-do _ subject-roots Bool
    (param expression SyntaxId)
    (param roots (list Atom))
    ; The names a loop's container is read through, as TypeScript's flow facts root it: the name
    ; it is read from first, then those of the indices it is read at. False where it is not read
    ; from names alone, or from literal indices.
    (match? ([] (. tree nodes) expression)
      (case (call .node-identifier row)
        (+= roots (. row name))
        (return true)
      )
      (case (call .node-get-expression row)
        (return (call subject-roots (. row object) roots))
      )
      (case (call .node-index-expression row)
        (if (not (call subject-roots (. row object) roots))
          (return false)
        )
        (match? ([] (. tree nodes) (. row index))
          (case (call .node-integer-syntax literal)
            (return (== (. literal unit) null))
          )
          (case .node-string-syntax
            (return true)
          )
        )
        (return (call subject-roots (. row index) roots))
      )
    )
    (return false)
  )
  (fn-do _ note-place _
    (param loop SyntaxId)
    (param written SyntaxId)
    (param container TypeId)
    (param plan OperatorPlan)
    ; Plans a loop that counts or steps through a tuple or a struct as one that reads it where
    ; it is kept, where its container is written as such a place and is iterated as it is.
    (if (or (== container no-type) (== container invalid-type))
      (return)
    )
    (let kind (call (. types intrinsic-of) container))
    (if (or (and (!= kind .tuple) (!= kind .struct)) (!= (call (. facts node-type) instance written) container))
      (return)
    )
    (= place-base 0)
    (let shape (call place-shape written))
    (if (!= shape 0)
      (call (. facts set-loop-place) instance loop plan (if-expr (== shape 1) place-base (. U32 max)))
    )
  )
  (fn-do _ place-shape U32
    (param node SyntaxId)
    ; How the reference holds what an expression of a tuple or struct type gives: 0 as a value
    ; of its own, 1 by the address of where it is kept, and 2 in a way that has no shape here.
    ; A place is a local, an argument, a global or a stored property read by its name, and a
    ; stored field or property of one. A lazy local is a place where a flag says it has its
    ; value, and a value of its own where a read evaluates it. `place-base` is left as the
    ; object such a property is read from where that is no receiver: it is evaluated once.
    (match? ([] (. tree nodes) node)
      (case (call .node-identifier row)
        (let resolution (call (. bindings resolution-of) (. frame binding) node))
        (if (== (. resolution kind) .resolve-global)
          (return 1)
        )
        (if (== (. resolution kind) .resolve-slot)
          (if (!= (. ([] (. bindings slots) (. resolution slot)) kind) .slot-lazy)
            (return 1)
          )
          (let policy (call (. bindings lazy-policy) (. resolution slot)))
          (if (or (== policy .lazy-inline) (== policy .lazy-first-read))
            (return 0)
          )
          (return (if-expr (== policy .lazy-unsettled) 2 1))
        )
        (if (== (. resolution kind) .resolve-member)
          (return (call stored-shape node (. frame self-type) (. row name)))
        )
        (return 0)
      )
      (case (call .node-get-expression row)
        (if (or (. row is-tracked) (. row is-optional) (. row is-loop))
          (return 2)
        )
        (if (== (call (. facts plan-of) instance node) .plan-view)
          (return 0)
        )
        (let held (call (. facts node-type) instance (. row object)))
        (if (or (== held no-type) (== held invalid-type))
          (return 2)
        )
        (let stored (call stored-shape node held (. row name)))
        (if (!= stored 1)
          (return stored)
        )
        (let kind (call (. types intrinsic-of) held))
        (if (or (== kind .tuple) (== kind .struct))
          (return (call place-shape (. row object)))
        )
        (if (!= kind .class)
          (return 2)
        )
        (if (not (call names-receiver (. row object)))
          (= place-base (. row object))
        )
        (return 1)
      )
      (case (call .node-index-expression row)
        (if (. row is-optional)
          (return 2)
        )
        (if (!= (call (. facts plan-of) instance node) .plan-field)
          (return 0)
        )
        (return (call place-shape (. row object)))
      )
      (case .node-call-expression
        (return 0)
      )
      (case .node-tuple-syntax
        (return 0)
      )
      (case .node-range-expression
        (return 0)
      )
      (case .node-binary-expression
        (return 0)
      )
      (case .node-unary-expression
        (return 0)
      )
      (case .node-cast-expression
        (return 0)
      )
      (case .node-iterable-expression
        (return 0)
      )
    )
    (return 2)
  )
  (fn-expr _ stored-shape U32
    (param node SyntaxId)
    (param owner TypeId)
    (param name Atom)
    ; How a property read by its name is held: where it is kept for one the owner stores, and
    ; as a value of its own for one a function answers.
    (case? found
      (if-expr (== (. ([] (. types properties) found) storage-kind) .storage-getter) 0 1)
    )
    (case? (!= (call (. facts first-call) instance node) no-fact)
      0
    )
    (default
      (if-expr (== (call (. facts plan-of) instance node) .plan-field) 1 2)
    )
    (where
      (lazy found (call property-named owner name))
    )
  )
  (fn-do + demand-materialized _
    (param declaration CheckedDecl)
    ; A member that runs on a row's case and reads its cells with no check runs on the case
    ; gathered from the row instead where it may move the row's storage before it reads the row
    ; again, as TypeScript's `table-row-receiver-materialized` function does. That function is the
    ; member's instance on the case itself. One that writes its receiver has none.
    (let own ([] (. instances rows) instance))
    (if (or (== (. own row-receiver) no-type) (not (. own row-validated)) (call writes-receiver declaration))
      (return)
    )
    (let signature ([] (. instances signatures) instance))
    (let param-count (. signature param-count))
    (let start (- (. signature args start) param-count))
    (let mark (. scratch types mark))
    (for (in offset (..< 0 (+ param-count (. signature args count))))
      (call (. scratch types push) ([] (. instances signature-types) (+ start offset)))
    )
    (let params (call (. scratch types span) mark param-count))
    (let args (call (. scratch types span) (+ mark param-count) (. signature args count)))
    (let materialized
      (call (. instances intern)
        (block
          (arg (. own module))
          (arg (. own decl))
          (arg (. own self-type))
          (arg (. own effects))
          (arg (. own enclosing))
          (arg params)
          (arg args)
        )
      )
    )
    (call (. scratch types rewind) mark)
    (= (. ([] (. instances rows) instance) materialized) materialized)
  )
  (fn-do _ writes-receiver Bool
    (param declaration CheckedDecl)
    ; Whether a body may write its receiver: it assigns to a place reached from `this` or a
    ; member, calls a member of either, or holds a function of its own.
    (if (== (. declaration body) 0)
      (return false)
    )
    (for (in node (..< (call (. tree subtree-start) (. declaration body)) (+ (. declaration body) 1)))
      (match? ([] (. tree nodes) node)
        (case .node-function-syntax
          (return true)
        )
        (case (call .node-assign row)
          (if (call reaches-receiver (. row lhs))
            (return true)
          )
        )
        (case (call .node-call-expression row)
          (if (call reaches-receiver (. row callable))
            (return true)
          )
        )
      )
    )
    (return false)
  )
  (fn-do _ reaches-receiver Bool
    (param node SyntaxId)
    ; Whether a place or a callee is `this` or a member, or is reached from either.
    (let current node)
    (while (!= current 0)
      (let next SyntaxId 0)
      (match? ([] (. tree nodes) current)
        (case .node-identifier
          (let resolution (call (. bindings resolution-of) (. frame binding) current))
          (if (== (. resolution kind) .resolve-member)
            (return true)
          )
          (return (and (== (. resolution kind) .resolve-slot) (== (. ([] (. bindings slots) (. resolution slot)) kind) .slot-this)))
        )
        (case (call .node-get-expression row)
          (= next (. row object))
        )
        (case (call .node-index-expression row)
          (= next (. row object))
        )
      )
      (= current next)
    )
    (return false)
  )
  (fn-do + names-receiver Bool
    (param node SyntaxId)
    (match? ([] (. tree nodes) node)
      (case .node-identifier
        (let resolution (call (. bindings resolution-of) (. frame binding) node))
        (if (== (. resolution kind) .resolve-slot)
          (return (== (. ([] (. bindings slots) (. resolution slot)) kind) .slot-this))
        )
      )
    )
    (return false)
  )
  (fn-do _ loop-take LoopTake
    (param pattern SyntaxId)
    (param transformed Bool)
    (param matched Bool)
    ; What a header does with its item, from the pattern it writes: the arms of a match, a
    ; pattern written as one, or one a declaration is written with.
    (if transformed
      (return .take-arms)
    )
    (if (call (. tree names-whole) pattern)
      (return .take-whole)
    )
    (if matched
      (return .take-fitted)
    )
    (if (call (. tree has-arms) pattern)
      (return .take-unshaped)
    )
    (match? ([] (. tree nodes) pattern)
      (case (call .node-type-tuple row)
        (if (!= (. row field-types count) 0)
          (return .take-fields)
        )
      )
      (case (call .node-tuple-syntax row)
        (if (!= (. row items count) 0)
          (return .take-fields)
        )
      )
      (case (call .node-type-capture capture)
        (if (not (call reads-name (. capture type)))
          (return .take-converted)
        )
      )
    )
    (return .take-declared)
  )
  (fn-do _ match-item TypeId
    (param id SyntaxId)
    (param arms SyntaxId)
    (param item TypeId)
    ; A loop whose pattern is the arms of a match runs them on each item: `each` is what the arm an
    ; item matches gives, and an item no arm matches is passed over. The pattern is typed as what
    ; the arms give, for emission.
    (if (or (== item invalid-type) (== item no-type))
      (return invalid-type)
    )
    (let own-matching matching)
    (= matching (= (. matching subject) item))
    (= matching (= (. matching optional) true))
    (= matching (= (. matching case) 0))
    (let result (call infer-arms id arms))
    (= matching own-matching)
    (if (and (!= result no-type) (!= result invalid-type))
      (call (. facts set-node-type) instance id result)
    )
    (return (if-expr (call (. types is-optional) result) (call (. types optional-inner) result) result))
  )
  (fn-do + plan-range-at _
    (param planned SyntaxId)
    (param item TypeId)
    ; A loop at a node that heads none, over a range literal of whole numbers: it counts, with
    ; no range, and polls.
    (call (. facts set-plan) instance planned .plan-range-loop)
    (call keep-loop planned item item (. types bool-type))
    (call note-poll)
  )
  (fn-do + plan-iteration-at _
    (param planned SyntaxId)
    (param site SyntaxId)
    (param iterated TypeId)
    (param item TypeId)
    (param is-feed Bool)
    ; A loop at a node that heads none, over any other container: by the container's protocol,
    ; whose calls are kept at `site`, by its indexes where it has them, and polling.
    (call note-container-iteration site iterated is-feed planned)
    (if (call is-indexed iterated false)
      (call (. facts set-plan) instance planned .plan-index-loop)
      (if (call is-array-field iterated (!! (. types length-atom)))
        (call (. facts set-constant) instance planned (call ConstantFact 1 0 null false) .plan-index-loop)
      )
      (call keep-loop planned iterated (. types size-type) (. types size-type))
    )
    (call keep-loop-item planned item)
    (call note-poll)
  )
  (fn-do + note-container-iteration _
    (param site SyntaxId)
    (param container TypeId)
    (param is-feed Bool)
    (param planned SyntaxId)
    ; The iteration protocol the reference's generic loop lowering calls on a container that is
    ; neither a range literal nor a table, by the first it finds of these: a generator begins,
    ; reads, and ends iterating; a cursor iterable reads its initial state and steps it, the step
    ; called as any call is, whose errors leave the function; and anything else iterable, a value
    ; of an interface or an object of a class of one, begins, reads, and ends iterating. The
    ; instances and the witnesses of their implementors follow. A class that delegates the
    ; interface to a property is iterated by what the property holds, whose items are converted
    ; to the interface's at the loop, as the `as` that delegates it asks. A type iterated by an
    ; interface must answer the functions the interface requires, as where it is made one.
    ; A spread over a table also keeps the index cast of its counter at the feed. The
    ; loop is planned at `planned`, the header of a loop or the feed, where the slots of the
    ; loop are.
    (if (or (== container invalid-type) (== container no-type))
      (return)
    )
    (let cursor (!= (call iterable-item container (. types cursor-iterable-decl)) no-type))
    (let iterable (!= (call iterable-item container (. types iterable-decl)) no-type))
    (let generated (call same-decl (call class-ref types container) (. types generator-decl)))
    (if (and is-feed (not cursor) (not iterable) (call implements container (. types indexable-decl)))
      (call (. conversions convert) site site (. types size-type) (. types index-type) .reason-argument)
    )
    (if (and cursor (not generated))
      (let cursor-interface (call interface-of container (. types cursor-iterable-decl)))
      (if (and (!= (call (. types intrinsic-of) container) .interface) (!= cursor-interface no-type))
        (call conform-members container cursor-interface)
      )
      (let state (call (. calls protocol-getter) container (call (. program store-atom) "initial-iterator-state") site))
      (if (!= state invalid-type)
        (call (. calls protocol-call) container (call (. program store-atom) "next-iterator") site state true)
        (if (!= planned 0)
          (call (. facts set-plan) instance planned .plan-cursor-loop)
          (call keep-loop planned container state)
        )
      )
      (return)
    )
    (if (or generated iterable)
      (let places (list U32))
      (let interface
        (scope (if-expr (and iterable (not generated)) iterable-interface no-type)
          (lazy iterable-interface (call interface-of container (. types iterable-decl)))
        )
      )
      (if (and (!= interface no-type) (!= (call (. types intrinsic-of) container) .interface))
        (call conform-members container interface)
      )
      (let holder (if-expr (!= interface no-type) (call (. calls ranking interface-holder) container interface places) no-type))
      (let receiver (if-expr (!= holder no-type) holder container))
      (call (. calls keep-protocol-through) (. (call (. calls protocol-call) receiver (call (. program store-atom) "begin-iterating") site) fact) places)
      (let read-call (call (. calls protocol-call) receiver (call (. program store-atom) "<-read") site no-type true))
      (call (. calls keep-protocol-through) (. read-call fact) places)
      (let read (. read-call answer))
      (call (. calls keep-protocol-through) (. (call (. calls protocol-call) receiver (call (. program store-atom) "end-iterating") site) fact) places)
      (let item (if-expr (!= holder no-type) (call first-arg interface) no-type))
      (if (and (!= item no-type) (!= read invalid-type) (call (. types is-optional) read) other-item)
        (call (. conversions convert)
          (block
            (arg site)
            (arg site)
            (arg (call (. types optional-inner) read))
            (arg item)
            (arg .reason-element)
            (arg true)
            (arg (!= (. places length) 0))
          )
        )
      )
      (lazy other-item (!= (call (. types optional-inner) read) item))
      (if (!= planned 0)
        (call (. facts set-plan) instance planned .plan-stream-loop)
        (call keep-loop planned container)
      )
    )
  )
  (fn-expr + is-indexed Bool
    (param container TypeId)
    (param through-call Bool)
    ; Whether a loop over a container counts through its indexes, as `loop-item-type` found its
    ; item: the container is neither kind of iterable, and no table the loop reads by its rows.
    (case? (or (== container invalid-type) (== container no-type))
      false
    )
    (case? (!= (call iterable-item container (. types cursor-iterable-decl)) no-type)
      false
    )
    (case? (or plain-iterable (not (call implements container (. types indexable-decl))))
      false
    )
    (default
      (or through-call (not (call is-table-container (call (. types intrinsic-of) container))))
    )
    (where
      (lazy plain-iterable (!= (call iterable-item container (. types iterable-decl)) no-type))
    )
  )
  (fn-do + keep-loop _
    (param loop SyntaxId)
    (param first TypeId)
    (param second TypeId (= no-type))
    (param third TypeId (= no-type))
    ; Types what a loop keeps from one pass to the next, in the slots the binder declared for
    ; its header: for a range its index, its end and whether it counts down; for a container
    ; the container, and then its length and the count of items read, or the state of its
    ; cursor.
    (let slot (call (. bindings loop-state) (. frame binding) loop))
    (if (== slot no-slot)
      (return)
    )
    (call (. frame assign) slot first)
    (if (!= second no-type)
      (call (. frame assign) (+ slot 1) second)
    )
    (if (!= third no-type)
      (call (. frame assign) (+ slot 2) third)
    )
  )
  (fn-do _ keep-loop-given _
    (param loop SyntaxId)
    (param container TypeId)
    ; Types the slot after a loop's item, which the binder declared for a header given its
    ; container: there the loop of a comprehension over the rows of a table keeps the container
    ; until the loop begins and finds its rows, as TypeScript's loop over its argument does.
    (let slot (call (. bindings loop-state) (. frame binding) loop))
    (if (!= slot no-slot)
      (call (. frame assign) (+ slot loop-state-count) container)
    )
  )
  (fn-do + keep-loop-item _
    (param loop SyntaxId)
    (param item TypeId)
    ; Types the last of a loop's slots, which keeps the item of the pass.
    (let slot (call (. bindings loop-state) (. frame binding) loop))
    (if (and (!= slot no-slot) (!= item no-type) (!= item invalid-type))
      (call (. frame assign) (- (+ slot loop-state-count) 1) item)
    )
  )
  (fn-do _ check-clause _
    (param id SyntaxId)
    (param body SyntaxId)
    ; A clause is tested as a condition. It holds wherever the loop's body runs, so what it tests
    ; is narrowed there.
    (match? ([] (. tree nodes) id)
      (case (call .node-clause row)
        (if (!= (. row op) .whenever-clause)
          (call note-truthiness (. row expr) (. row expr) (call infer-tested (. row expr)))
        )
        (match? (. row op)
          (case .when-clause
            (call (. narrowing narrow-condition) (. row expr) true)
          )
          (case .while-clause
            (call (. narrowing narrow-condition) (. row expr) true)
          )
          (case .until-clause
            (call (. narrowing narrow-condition) (. row expr) false)
          )
        )
        (if (!= (. row next) 0)
          (call check-clause (. row next) body)
        )
      )
    )
  )
  (fn-do _ assign-loop-slots _
    (param loop SyntaxId)
    (param item TypeId)
    (param wrap Bool)
    ; `it` and `each` are the optional item under a pattern and the item itself without one, as
    ; the reference's loop lowering defines them; under a pattern written as a match they are
    ; the item as the pattern fitted it. The loop's header resolves to the first of the two the
    ; binder declared for it, and the other follows it.
    (let wrapped (if-expr (and wrap (!= item invalid-type)) (call (. types optional-of) item) item))
    (let first (call (. bindings resolution-of) (. frame binding) loop))
    (if (!= (. first kind) .resolve-slot)
      (return)
    )
    (let bound ([] (. bindings bindings) (. frame binding)))
    (let slot (. first slot))
    (while (< slot (+ (. bound slots start) (. bound slots count)))
      (let row ([] (. bindings slots) slot))
      (if (or (and (!= (. row kind) .slot-it) (!= (. row kind) .slot-each)) (!= (. row syntax) loop))
        (return)
      )
      (call (. frame assign) slot wrapped)
      (+= slot 1)
    )
  )
  (fn-do + stated-item TypeId
    (param pattern SyntaxId)
    ; The type a loop's pattern states for its item, when it states one and names no value.
    (if (!= pattern 0)
      (match? ([] (. tree nodes) pattern)
        (case (call .node-type-capture row)
          (if (and (!= (. row type) 0) (not (call reads-name (. row type))))
            (return (call (. types evaluate-type) module tree (. row type) (. frame env)))
          )
        )
      )
    )
    (return no-type)
  )
  (fn-do + loop-container LoopContainer
    (param syntax SyntaxId)
    (param simple Bool (= true))
    (param stated TypeId (= no-type))
    ; The container of a loop's header, typed. A range written there whose sides are integers
    ; written with no suffix is of the integer type the header's pattern states.
    (match? ([] (. tree nodes) syntax)
      (case (call .node-range-expression row)
        (if (== (. row increment) 0)
          (let item (call range-item syntax (. row left) (. row right) 0 stated))
          (if (== item invalid-type)
            (return (call LoopContainer invalid-type no-type))
          )
          (if (and (call is-integer item) simple)
            (let mark (. scratch types mark))
            (call (. scratch types push) item)
            (let range (call (. types class-named-with-args) module (!! (. types range-atom)) mark))
            (call (. facts set-node-type) instance syntax range)
            (return (call LoopContainer range item))
          )
          (let constructed (call range-construction syntax (. row op) item (. row left) (. row right) 0))
          (if (!= constructed no-type)
            (call (. facts set-node-type) instance syntax constructed)
          )
          (return (call LoopContainer constructed no-type))
        )
      )
    )
    (return (call LoopContainer (call infer syntax) no-type))
  )
  (fn-do + iteration-container TypeId
    (param container TypeId)
    (param site SyntaxId)
    ; A container that is not iterable itself is iterated as the first iterable type it declares a
    ; conversion to, in the reference's order of iteration protocols.
    (if (or (== container invalid-type) (== container no-type))
      (return container)
    )
    (if (!= (call interface-of container (. types cursor-iterable-decl)) no-type)
      (return container)
    )
    (if (!= (call interface-of container (. types iterable-decl)) no-type)
      (return container)
    )
    (if (call implements container (. types indexable-decl))
      (return container)
    )
    (let converted (call converted-iterable container (. types generator-decl)))
    (if (== converted no-type)
      (= converted (call converted-iterable container (. types cursor-iterable-decl)))
    )
    (if (== converted no-type)
      (= converted (call converted-iterable container (. types iterable-decl)))
    )
    (if (== converted no-type)
      (= converted (call converted-iterable container (. types indexable-decl)))
    )
    (if (== converted no-type)
      (= converted (call converted-iterable container (. types stream-decl)))
    )
    (if (== converted no-type)
      (return container)
    )
    (return (call (. conversions convert) site site container converted .reason-operand))
  )
  (fn-expr _ converted-iterable TypeId
    (param container TypeId)
    (param protocol DeclRef)
    (call (. relations converted-class) container (. protocol module) (. protocol decl))
  )
  (fn-do + loop-item-type TypeId
    (param container TypeId)
    (param site SyntaxId)
    (param through-call Bool (= false))
    (if (or (== container invalid-type) (== container no-type))
      (return invalid-type)
    )
    (let container-kind (call (. types intrinsic-of) container))
    (let streamed (call iterable-item container (. types cursor-iterable-decl)))
    (if (and (!= streamed no-type) (== container-kind .interface))
      (let cursor (call interface-of container (. types cursor-iterable-decl)))
      (call note-iterator-witness cursor (call (. program store-atom) "initial-iterator-state") .getter-decl)
      (call note-iterator-witness cursor (call (. program store-atom) "next-iterator") .function-decl)
    )
    (if (== streamed no-type)
      (= streamed (call iterable-item container (. types iterable-decl)))
    )
    (if (!= streamed no-type)
      (return streamed)
    )
    (if (call implements container (. types indexable-decl))
      (if (not (call is-array-field container (!! (. types length-atom))))
        (call (. calls demand-getter) container (!! (. types length-atom)) site)
      )
      (if (and (call is-table-container container-kind) (not through-call))
        (return (call (. calls index-item-type) container))
      )
      (return (call (. calls index-item) container site))
    )
    (return invalid-type)
  )
  (fn-do _ slice-through-call Bool
    (param syntax SyntaxId)
    (match? ([] (. tree nodes) syntax)
      (case .node-index-expression
        (let fact (call (. facts first-call) instance syntax))
        (if (== fact no-fact)
          (return false)
        )
        (let callee (. ([] (. facts calls) fact) callee))
        (if (== callee no-instance)
          (return false)
        )
        (return (!= (. ([] (. instances rows) callee) module) (. types table-module)))
      )
    )
    (return false)
  )
  (fn-expr _ counts-rows Bool
    (param container TypeId)
    ; Whether a loop over a container counts through the rows of a table, of a span of one or of
    ; a selection of them, as TypeScript does by the container's type alone, rather than through a
    ; method of it. Its rows are structs or unions.
    (case? (and (not (call is-column-receiver kind)) (not selects))
      false
    )
    (default
      (or (== row .struct) (== row .union))
    )
    (where
      (lazy kind (call (. types intrinsic-of) container))
      (lazy selects (or (== kind .table-selection) (== kind .immutable-table-selection)))
      (lazy row (call (. types intrinsic-of) (call row-struct-of container)))
    )
  )
  (fn-expr _ counts-indices Bool
    (param container TypeId)
    (param syntax SyntaxId)
    ; Whether a loop over a container counts through the indices of an index span, as
    ; TypeScript's loop over what is indexable does, by its length and its `[]`.
    (and (== (call (. types intrinsic-of) container) .index-span) (not (call slice-through-call syntax)))
  )
  (fn-do _ note-iterator-witness _
    (param interface TypeId)
    (param name Atom)
    (param kind DeclKind)
    (let ref (call class-ref types interface))
    (if (and (== (. ref module) 0) (== (. ref decl) 0))
      (return)
    )
    (let owner-module ([] (. program modules) (. ref module)))
    (let members (call (of RowRange DeclId)))
    (match? ([] (. owner-module decls) (. ref decl))
      (case (call .decl-class row)
        (= members (. row members))
      )
    )
    (for (in member (call (. owner-module members-named) members name))
      (match? ([] (. owner-module decls) member)
        (case (call .decl-function fn)
          (if (and (== (. fn kind) kind) (. fn name) (== (. fn name) name))
            (call (. facts record-witness-func) interface (. ref module) member)
            (return)
          )
        )
      )
    )
    (for (in parent (call (. types interfaces-of) interface))
      (call note-iterator-witness parent name kind)
    )
  )
)

(fn-do _ has-atom Bool
  (param names (list Atom))
  (param name Atom)
  ; Whether a list of names holds a name.
  (for (in held names)
    (if (== held name)
      (return true)
    )
  )
  (return false)
)
