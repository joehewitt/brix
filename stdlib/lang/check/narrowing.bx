(import ./binding)
(import ./facts)
(import ./frame)
(import ./instances)
(import ./narrowing-key)
(import ./type-relation)
(import ./type-store)
(import ./types)
(import ./typing-scratch)
(import /core/scratch)
(import /lang/ast/ast)
(import /lang/ast/ast-children)
(import /lang/ast/ast-nodes)
(import /lang/ast/decl)
(import /lang/ast/module)
(import /lang/ast/operator)
(import /lang/ast/program)
(import /lang/ast/row-range)

(type + Narrowing
  (prop + frame Frame)
  (prop _ types Types)
  (prop _ facts Facts)
  (prop _ relations Relations)
  (prop _ tree AST)
  (prop _ scratch TypingScratch)
  (fn-do + This _
    (param frame Frame)
    (lazy types (. frame types))
    (lazy relations (. frame relations))
    (lazy scratch (. frame scratch))
    (lazy facts (. frame facts))
    (lazy tree (. frame tree))
  )
  (fn-do + begin _
    (= tree (. frame tree))
  )
  (fn-do + narrow-condition _
    (param condition SyntaxId)
    (param edge Bool)
    (if (== condition 0)
      (return)
    )
    (match? ([] (. tree nodes) condition)
      (case (call .node-type-predicate row)
        (call narrow-condition (. row expr) edge)
      )
      (case (call .node-unary-expression row)
        (if (== (. row op) .not-op)
          (call narrow-condition (. row operand) (not edge))
        )
      )
      (case (call .node-binary-expression row)
        (if (== (. row op) .and-op)
          (if edge
            (call narrow-condition (. row lhs) true)
            (call narrow-condition (. row rhs) true)
          )
          (else-if (== (. row op) .or-op)
            (if (not edge)
              (call narrow-condition (. row lhs) false)
              (call narrow-condition (. row rhs) false)
            )
          )
          (else-if (or (== (. row op) .equals-op) (== (. row op) .not-equals-op))
            (call narrow-null (. row op) (. row lhs) (. row rhs) edge)
            (call narrow-equality (. row op) (. row lhs) (. row rhs) edge)
          )
          (else-if (call is-type-test (. row op))
            (call narrow-cases (. row op) (. row lhs) (. row rhs) edge)
          )
        )
      )
      (case .node-identifier
        (if edge
          (call narrow-present condition)
        )
      )
      (case .node-get-expression
        (if edge
          (call narrow-present condition)
        )
      )
    )
  )
  (fn-do _ narrow-present _
    (param subject SyntaxId)
    (let slot (call condition-slot subject))
    (if (not slot)
      (return)
    )
    (let current (call subject-type subject slot))
    (if (or (== current no-type) (== current invalid-type))
      (return)
    )
    (if (not (call (. types is-optional) current))
      (call (. frame push-narrowing) slot current (call (. frame narrowed-cases) slot))
      (return)
    )
    (let inner (call (. types optional-inner) current))
    (if (and (call is-member-key slot) (not (call (. frame is-stable-path) slot)))
      (call (. frame note-member) slot current)
    )
    (call (. frame push-narrowing) slot inner)
  )
  (fn-do _ narrow-null _
    (param op Operator)
    (param lhs SyntaxId)
    (param rhs SyntaxId)
    (param edge Bool)
    (let left-null (call is-null-syntax lhs))
    (let right-null (call is-null-syntax rhs))
    (if (== left-null right-null)
      (return)
    )
    (let subject (if-expr left-null rhs lhs))
    (let present (== (== op .not-equals-op) edge))
    (if present
      (call narrow-present subject)
    )
  )
  (fn-do + is-null-syntax Bool
    (param id SyntaxId)
    ; Whether an expression is `null`, the literal of core that no local or member of that name hides.
    (match? ([] (. tree nodes) id)
      (case (call .node-identifier row)
        (if (!= (. row name) (!! (. types null-atom)))
          (return false)
        )
        (let resolution (call (. frame bindings resolution-of) (. frame binding) id))
        (if (or (!= (. resolution kind) .resolve-global) (!= (. resolution module) (. types core-module)))
          (return false)
        )
        (match? ([] (. ([] (. frame program modules) (. resolution module)) decls) (. resolution decl))
          (case (call .decl-property property)
            (return (== (. property name) (. types null-atom)))
          )
        )
      )
    )
    (return false)
  )
  (fn-do _ narrow-cases _
    (param op Operator)
    (param lhs SyntaxId)
    (param rhs SyntaxId)
    (param edge Bool)
    (let slot (call condition-slot lhs))
    (if (not slot)
      (return)
    )
    (let subject (call subject-type lhs slot))
    (if (or (== subject invalid-type) (== subject no-type))
      (return)
    )
    (let completion (call (. types completion-of) subject))
    (let is-not (or (== op .is-not-op) (== op .is-not-exactly-op) (== op .is-not-similar-op)))
    (if (!= (. completion intrinsic) .union)
      (if (!= edge is-not)
        (call (. frame push-narrowing) slot subject (call (. frame narrowed-cases) slot))
      )
      (return)
    )
    (let cases (. completion cases))
    (let mark (. scratch words mark))
    (let target (call tested-type rhs))
    (let partial (call matching-cases op rhs target cases))
    (let matching U64)
    (for (in position (..< mark (. scratch words mark)))
      (if (< ([] (. scratch words) position) 64)
        (= matching (/or/ matching (/lshift/ 1u64 ([] (. scratch words) position))))
      )
    )
    (call (. scratch words rewind) mark)
    (let tested (if-expr (or (== op .is-op) (== op .is-not-op)) target no-type))
    (call narrow-to slot subject matching (!= edge is-not) partial tested)
  )
  (fn-do _ narrow-to _
    (param slot NarrowingKey)
    (param subject TypeId)
    (param matching U64)
    (param wanted Bool)
    (param partial U64 (= 0))
    (param tested TypeId (= no-type))
    ; Keeps the cases of a union a condition allows, or the others on its false edge, of those the
    ; slot could still hold, where the cases it allows only in part (`partial`) stay too. One case
    ; left that holds a value reads as that value, and cases left of classes that all derive from the
    ; class of one of them read as that class (`common-base`). Where `is` allows them for a class it
    ; `tested`, cases left of classes that derive from it or that it derives from hold an object of
    ; it, and read as it, or as the class of one of them that derives from it where all the others do.
    (let cases (. (call (. types completion-of) subject) cases))
    (if (or (== (. cases count) 0) (> (. cases count) 64))
      (return)
    )
    (let all U64 (if-expr (== (. cases count) 64) (. U64 max) (- (/lshift/ 1u64 (. cases count)) 1)))
    (let held (call (. frame narrowed-cases) slot))
    (let current (if-expr (== held 0) all held))
    (let kept (if-expr wanted matching (/xor/ all (/and/ matching (/xor/ partial (. U64 max))))))
    (let remaining (/and/ current kept))
    (let lined (and wanted (!= tested no-type) (!= (call line-case cases remaining tested) (. U32 max))))
    (if (or (== remaining 0) (and (== remaining current) (or (not lined) (== (/and/ partial remaining) 0))))
      (return)
    )
    (if lined
      (let based (call common-base cases remaining))
      (let read (if-expr (and (!= based no-type) (call in-base-chain types based tested)) based tested))
      (call (. frame push-narrowing) slot read remaining)
      (return)
    )
    (for (in offset (..< 0 (. cases count)))
      (if (== remaining (/lshift/ 1u64 offset))
        (let fact ([] (. types cases) (+ (. cases start) offset)))
        (if (and (not (. fact is-default)) (!= (. fact type) no-type))
          (call (. frame push-narrowing) slot (. fact type) remaining)
          (return)
        )
      )
    )
    (let base (call common-base cases remaining))
    (if (!= base no-type)
      (call (. frame push-narrowing) slot base remaining)
      (return)
    )
    (call (. frame push-narrowing) slot subject remaining)
  )
  (fn-do + common-base TypeId
    (param cases (of RowRange TypeId))
    (param remaining U64)
    ; The class of one of the `remaining` cases that the classes of all the others derive from, or no
    ; type where there is none.
    (for (in offset (..< 0 (. cases count)))
      (let fact ([] (. types cases) (+ (. cases start) offset)))
      (let kept (!= (/and/ remaining (/lshift/ 1u64 offset)) 0))
      (let valued (and (not (. fact is-default)) (!= (. fact type) no-type)))
      (if (and kept valued (call intrinsic-is-class (call (. types intrinsic-of) (. fact type))))
        (let shared true)
        (for (in other (..< 0 (. cases count)))
          (let held ([] (. types cases) (+ (. cases start) other)))
          (if (and (!= other offset) (!= (/and/ remaining (/lshift/ 1u64 other)) 0))
            (if (or (. held is-default) (== (. held type) no-type))
              (= shared false)
              (else-if (not (call intrinsic-is-class (call (. types intrinsic-of) (. held type))))
                (= shared false)
              )
              (else-if (not (call in-base-chain types (. held type) (. fact type)))
                (= shared false)
              )
            )
          )
        )
        (if shared
          (return (. fact type))
        )
      )
    )
    (return no-type)
  )
  (fn-do + line-case U32
    (param cases (of RowRange TypeId))
    (param remaining U64)
    (param target TypeId)
    ; Where each of the `remaining` cases of a union is of a class that derives from a class or that
    ; it derives from, which once a test for the class holds all hold an object of it, the case to
    ; read the union through as the class: that of the class itself, or else the first of them. None
    ; where any is of another type, or where the target is no class.
    (if (not (call intrinsic-is-class (call (. types intrinsic-of) target)))
      (return (. U32 max))
    )
    (let first (. U32 max))
    (for (in offset (..< 0 (. cases count)))
      (if (or (>= offset 64) (== (/and/ remaining (/lshift/ 1u64 offset)) 0))
        (continue)
      )
      (let fact ([] (. types cases) (+ (. cases start) offset)))
      (if (or (. fact is-default) (== (. fact type) no-type) (not (call intrinsic-is-class (call (. types intrinsic-of) (. fact type)))))
        (return (. U32 max))
      )
      (if (and (not (call in-base-chain types (. fact type) target)) (not (call in-base-chain types target (. fact type))))
        (return (. U32 max))
      )
      (if (or (== (. fact type) target) (== first (. U32 max)))
        (= first offset)
      )
    )
    (return first)
  )
  (fn-do _ narrow-equality _
    (param op Operator)
    (param lhs SyntaxId)
    (param rhs SyntaxId)
    (param edge Bool)
    ; A union compared with a case of it that holds no value keeps that case, or loses it.
    (if (not (call narrow-case op lhs rhs edge))
      (call narrow-case op rhs lhs edge)
    )
  )
  (fn-do _ narrow-case Bool
    (param op Operator)
    (param subject-syntax SyntaxId)
    (param case-syntax SyntaxId)
    (param edge Bool)
    (let name (? Atom) null)
    (let owner 0u32)
    (match? ([] (. tree nodes) case-syntax)
      (case (call .node-symbol row)
        (= name (. row name))
      )
      (case (call .node-get-expression row)
        (match? ([] (. tree nodes) (. row object))
          (case .node-type-identifier
            (if (not (. row is-optional))
              (= name (. row name))
              (= owner (. row object))
            )
          )
        )
      )
    )
    (if (not name)
      (return false)
    )
    (let slot (call condition-slot subject-syntax))
    (if (not slot)
      (return false)
    )
    (let subject (call subject-type subject-syntax slot))
    (if (or (== subject invalid-type) (== subject no-type))
      (return false)
    )
    (let completion (call (. types completion-of) subject))
    (if (!= (. completion intrinsic) .union)
      (return false)
    )
    (if (and (!= owner 0) (!= (call (. types evaluate-type) (. frame module) tree owner (. frame env)) subject))
      (return false)
    )
    (for (in offset (..< 0 (. completion cases count)))
      (let fact ([] (. types cases) (+ (. completion cases start) offset)))
      (if (and (. fact is-default) (. fact name) (== (!! (. fact name)) name) (< offset 64))
        (call narrow-to slot subject (/lshift/ 1u64 offset) (== (== op .equals-op) edge))
        (return true)
      )
    )
    (return false)
  )
  (fn-do _ tested-type TypeId
    (param rhs SyntaxId)
    ; The type a condition `is rhs` tests for, or none where it names a case.
    (match? ([] (. tree nodes) rhs)
      (case .node-symbol
        (return no-type)
      )
      (case .node-type-case
        (return no-type)
      )
      (case (call .node-identifier row)
        (return (call (. types type-named) (. frame module) (. row name) (. frame env)))
      )
    )
    (return (call (. types evaluate-type) (. frame module) tree rhs (. frame env)))
  )
  (fn-do _ matching-cases U64
    (param op Operator)
    (param rhs SyntaxId)
    (param target TypeId)
    (param cases (of RowRange TypeId))
    ; Pushes the cases of a union the condition `op rhs` tests for, of the type `target` where it
    ; names one, and answers those it allows only in part (`holding-cases`).
    (match? ([] (. tree nodes) rhs)
      (case (call .node-symbol row)
        (call add-cases-named (. row name) cases)
        (return 0)
      )
      (case (call .node-type-case row)
        (call add-cases-named (. row name) cases)
        (return 0)
      )
    )
    (if (or (== target invalid-type) (== target no-type))
      (return 0)
    )
    (let kind (. Specificity convertible))
    (if (or (== op .is-exactly-op) (== op .is-not-exactly-op))
      (= kind .exact)
      (else-if (or (== op .is-similar-op) (== op .is-not-similar-op))
        (= kind .similar)
      )
    )
    (if (== kind .convertible)
      (return (call holding-cases target cases))
    )
    (for (in offset (..< 0 (. cases count)))
      (let fact ([] (. types cases) (+ (. cases start) offset)))
      (if (and (!= (. fact type) no-type) (not (. fact is-default)))
        (let relation (call (. relations compare) (. fact type) target))
        (if (call validate-relation relation kind)
          (call (. scratch words push) offset)
        )
      )
    )
    (return 0)
  )
  (fn-do _ holding-cases U64
    (param target TypeId)
    (param cases (of RowRange TypeId))
    ; The cases of a union `is` tests a value for, as TypeScript picks them: the case the type relates
    ; to best, by rank and then by how closely it matches, the first of those tied, however it relates,
    ; so a base of a case's class picks the case; and where the type is a class, each other case of a
    ; class derived from it, and each of a class it derives from. Answers those of a class it derives
    ; from, which the test allows only in part: their object must be of the class too, and those of
    ; an interface the class declares, which may hold an object of another class.
    (let best (. U32 max))
    (let best-rank 0i32)
    (let best-match 0u32)
    (let declared U64)
    (for (in offset (..< 0 (. cases count)))
      (let fact ([] (. types cases) (+ (. cases start) offset)))
      (if (and (!= (. fact type) no-type) (not (. fact is-default)))
        (let relation (call (. relations compare) target (. fact type) false true))
        (let rank (call case-selection-rank types relation))
        (let match U32 (. relation match))
        (if (call relation-legal relation)
          (if (or (== best (. U32 max)) (< rank best-rank) (and (== rank best-rank) (> match best-match)))
            (= best offset)
            (= best-rank rank)
            (= best-match match)
          )
          (if (and (== (. relation kind) .relation-interface-cast) (< offset 64))
            (= declared (/or/ declared (/lshift/ 1u64 offset)))
          )
        )
      )
    )
    (if (== best (. U32 max))
      (return 0)
    )
    (call (. scratch words push) best)
    (if (not (call intrinsic-is-class (call (. types intrinsic-of) target)))
      (return 0)
    )
    (let partial declared)
    (for (in offset (..< 0 (. cases count)))
      (let fact ([] (. types cases) (+ (. cases start) offset)))
      (if (or (== (. fact type) no-type) (. fact is-default) (not (call intrinsic-is-class (call (. types intrinsic-of) (. fact type)))))
        (continue)
      )
      (let below (call in-base-chain types (. fact type) target))
      (let above (and (not below) (call in-base-chain types target (. fact type))))
      (if (and (!= offset best) (or below above))
        (call (. scratch words push) offset)
      )
      (if (and above (< offset 64))
        (= partial (/or/ partial (/lshift/ 1u64 offset)))
      )
    )
    (return partial)
  )
  (fn-do _ add-cases-named _
    (param name Atom)
    (param cases (of RowRange TypeId))
    (for (in offset (..< 0 (. cases count)))
      (let fact ([] (. types cases) (+ (. cases start) offset)))
      (if (and (. fact name) (== (!! (. fact name)) name))
        (call (. scratch words push) offset)
      )
    )
  )
  (fn-do _ word-listed Bool
    (param mark ScratchMark)
    (param value U32)
    (let listed false)
    (for (in position (..< mark (. scratch words mark)))
      (if (== ([] (. scratch words) position) value)
        (= listed true)
      )
    )
    (return listed)
  )
  (fn-do + condition-slot (? NarrowingKey)
    (param expr SyntaxId)
    ; The key what a condition tests is known by: a local, a stored property of the receiver, or a
    ; path of stored properties from one of those, each property read through the path before it.
    ; A getter is read by a call, which ends what the reference knows of properties, so nothing a
    ; condition tests of one is known where it is read again.
    (if (== expr 0)
      (return null)
    )
    (match? ([] (. tree nodes) expr)
      (case (call .node-type-predicate row)
        (return (call condition-slot (. row expr)))
      )
      (case (call .node-identifier named)
        (let resolution (call (. frame bindings resolution-of) (. frame binding) expr))
        (if (== (. resolution kind) .resolve-slot)
          (return (call slot-key (. resolution slot)))
        )
        (if (and (== (. resolution kind) .resolve-member) (not (call is-getter (. frame self-type) (. named name))))
          (return (call member-key (. resolution module) (. resolution decl)))
        )
      )
      (case (call .node-get-expression row)
        (if (. row is-optional)
          (return null)
        )
        (let shared (call receiver-member (. row object) (. row name)))
        (if shared
          (return shared)
        )
        (let base (call condition-slot (. row object)))
        (if (not base)
          (return null)
        )
        (let declared (call (. facts node-type) (. frame instance) expr))
        (if (== declared no-type)
          (return null)
        )
        (let receiver (call (. facts node-type) (. frame instance) (. row object)))
        (if (or (call is-getter receiver (. row name)) (call is-row-view receiver))
          (return null)
        )
        (return (call (. frame path-key) base (. row name) declared (call is-stable-step base receiver (. row name))))
      )
    )
    (return null)
  )
  (fn-do _ is-stable-step Bool
    (param base NarrowingKey)
    (param receiver TypeId)
    (param name Atom)
    (if (call is-member-key base)
      (if (not (call (. frame is-stable-path) base))
        (return false)
      )
      (else-if (== (. ([] (. frame bindings slots) (as base SlotId)) kind) .slot-this)
        (return false)
      )
    )
    (if (or (== receiver no-type) (== receiver invalid-type) (!= (call (. types intrinsic-of) receiver) .tuple))
      (return false)
    )
    (let found (call (. types property-named) receiver name))
    (if (not found)
      (return false)
    )
    (return (== (. ([] (. types properties) found) storage-kind) .storage-eager))
  )
  (fn-expr _ is-row-view Bool
    (param receiver TypeId)
    ; Whether an object is a view of the row of a table or an array, whose fields the reference
    ; reads with no type it knows before the read, so a condition tells it nothing of them.
    (case? (or (== receiver no-type) (== receiver invalid-type))
      false
    )
    (case? (or (== kind .table-row) (== kind .immutable-table-row))
      true
    )
    (case? (!= kind .tuple)
      false
    )
    (case? (!= (call (. types ancestor-of) receiver (. types array-row-decl)) no-type)
      true
    )
    (default
      (!= (call (. types ancestor-of) receiver (. types array-fields-decl)) no-type)
    )
    (where
      (lazy kind (call (. types intrinsic-of) receiver))
    )
  )
  (fn-do _ is-getter Bool
    (param receiver TypeId)
    (param name Atom)
    (if (or (== receiver no-type) (== receiver invalid-type))
      (return false)
    )
    (let owner receiver)
    (if (== (call (. types intrinsic-of) owner) .optional)
      (= owner (call (. types optional-inner) owner))
    )
    (let found (call (. types property-named) owner name))
    (if found
      (return (== (. ([] (. types properties) found) storage-kind) .storage-getter))
    )
    (return false)
  )
  (fn-do + base-key (? NarrowingKey)
    (param expr SyntaxId)
    ; The key of what an object is read from where something is known of it or of a path from it:
    ; a local, a property of the receiver, or a path a condition tested before.
    (match? ([] (. tree nodes) expr)
      (case .node-identifier
        (let resolution (call (. frame bindings resolution-of) (. frame binding) expr))
        (if (== (. resolution kind) .resolve-slot)
          (return (call slot-key (. resolution slot)))
        )
        (if (== (. resolution kind) .resolve-member)
          (return (call member-key (. resolution module) (. resolution decl)))
        )
      )
      (case (call .node-get-expression row)
        (if (. row is-optional)
          (return null)
        )
        (let shared (call receiver-member (. row object) (. row name)))
        (if shared
          (return shared)
        )
        (let base (call base-key (. row object)))
        (if base
          (return (call (. frame find-path-key) base (. row name)))
        )
      )
    )
    (return null)
  )
  (fn-do + receiver-member (? NarrowingKey)
    (param object SyntaxId)
    (param name Atom)
    ; The key of a property of the receiver that is read through `this`: the key the property
    ; has where it is named alone, so that what is known of one is known of the other. No key
    ; for any other object, nor for a name that is not a property a class of the receiver's
    ; chain declares.
    (let is-receiver false)
    (match? ([] (. tree nodes) object)
      (case .node-identifier
        (let resolution (call (. frame bindings resolution-of) (. frame binding) object))
        (if (== (. resolution kind) .resolve-slot)
          (= is-receiver (== (. ([] (. frame bindings slots) (. resolution slot)) kind) .slot-this))
        )
      )
    )
    (if (not is-receiver)
      (return null)
    )
    (let current (. frame self-type))
    (while (and (!= current no-type) (!= current invalid-type))
      (let ref (call class-ref types current))
      (let target ([] (. frame program modules) (. ref module)))
      (match? ([] (. target decls) (. ref decl))
        (case (call .decl-class row)
          (for (in member (call (. target members-named) (. row members) name))
            (match? ([] (. target decls) member)
              (case (call .decl-property property)
                (if (and (. property name) (== (. property name) name))
                  (return (call member-key (. ref module) member))
                )
              )
            )
          )
        )
      )
      (let base (call (. types base-of) current))
      (if (not base)
        (return null)
      )
      (= current base)
    )
    (return null)
  )
  (fn-expr _ subject-type TypeId
    (param subject SyntaxId)
    (param slot NarrowingKey)
    (case? (not (call is-member-key slot))
      (call (. frame key-type) slot)
    )
    (case? (!= narrowed no-type)
      narrowed
    )
    (case? (call is-path-key slot)
      (call (. frame path-declared-type) slot)
    )
    (default
      (call member-declared subject)
    )
    (where
      (lazy narrowed (if-expr (call (. frame knows-member) slot) (call (. frame narrowed-member) slot) no-type))
    )
  )
  (fn-do _ member-declared TypeId
    (param subject SyntaxId)
    ; The type of a property of the receiver a condition tests: the one written, or, for a property
    ; that takes the type of its value, the one the condition read it as, which the property is given
    ; only once the program is typed (`settle-properties`), so that what a condition knows of it does
    ; not depend on whether the function was typed before that.
    (let self (. frame self-type))
    (if (or (== self no-type) (== self invalid-type))
      (return invalid-type)
    )
    (let name (? Atom) null)
    (match? ([] (. tree nodes) subject)
      (case (call .node-identifier row)
        (= name (. row name))
      )
      (case (call .node-get-expression row)
        (= name (. row name))
      )
    )
    (if (not name)
      (return invalid-type)
    )
    (let found (call (. types property-named) self name))
    (if (not found)
      (return invalid-type)
    )
    (let declared (. ([] (. types properties) found) type))
    (if (!= declared no-type)
      (return declared)
    )
    (let read (call (. facts node-type) (. frame instance) subject))
    (return (if-expr (!= read no-type) read invalid-type))
  )
  (fn-do + exits Bool
    (param id SyntaxId)
    (param directly Bool (= false))
    (param reaches Bool (= false))
    (param uses Bool (= false))
    (param infers Bool (= false))
    ; Whether control never runs past a statement. `directly` asks what the reference asks of the
    ; body of a match arm: that the statement itself leaves, which a match never does whatever
    ; its arms do. `reaches` asks what the end of a function asks, whether control can get
    ; there at all:
    ; - any statement of a block that leaves keeps it from the rest;
    ; - a condition that is the constant true or false is the branch it takes;
    ; - a block that binds a name or uses a value is its body;
    ; - a match that must match leaves when its arms do, since no arm matching is a panic.
    ; `uses` asks what the reference asks of a function's end when it checks that the function
    ; returns: as without `reaches`, except that a block that uses a value is its body and a match
    ; that must match leaves when its arms do. `infers` asks, beside `uses`, what it asks of the end
    ; when it infers what the function returns, where no loop leaves. Asked none of these, a call of
    ; a function marked `@no-return` leaves too.
    (if (== id 0)
      (return false)
    )
    (match? ([] (. tree nodes) id)
      (case (call .node-block row)
        (let last 0u32)
        (for (in statement ([] (. tree children) (. row body)))
          (if (not (call is-lazy-declaration statement))
            (= last statement)
            (if (and reaches (call exits statement directly true uses infers))
              (return true)
            )
          )
        )
        (return (call exits last directly reaches uses infers))
      )
      (case .node-return
        (return true)
      )
      (case (call .node-return-if-true row)
        (return (and reaches (!= (. row condition) 0) (call is-constant (. row condition) true)))
      )
      (case .node-break
        (return true)
      )
      (case .node-continue
        (return true)
      )
      (case (call .node-assertion-syntax row)
        (return (or (== (. row condition) 0) (and reaches (call is-constant (. row condition) true))))
      )
      (case (call .node-if-block row)
        (if (== (. row condition) 0)
          (return (call exits (. row body) directly reaches uses infers))
        )
        (if (and reaches (call is-constant (. row condition) true))
          (return (call exits (. row body) directly true uses infers))
        )
        (if (and reaches (call is-constant (. row condition) false))
          (return (call exits (. row next) directly true uses infers))
        )
        (if (or (== (. row next) 0) (not (call exits (. row body) directly reaches uses infers)))
          (return false)
        )
        (return (call exits (. row next) directly reaches uses infers))
      )
      (case (call .node-do-block row)
        (return (call exits (. row body) directly reaches uses infers))
      )
      (case (call .node-stack-local-binding-block row)
        (return (and reaches (call exits (. row body) directly true uses infers)))
      )
      (case (call .node-use-block row)
        (return (and (or reaches uses) (call exits (. row body) directly reaches uses infers)))
      )
      (case (call .node-while-block row)
        (return (and (not infers) (call is-constant (. row condition) true) (not (call has-break (. row body)))))
      )
      (case (call .node-match-expression row)
        (if (and (or reaches uses) (not (. row is-optional)))
          (match? ([] (. tree nodes) (. row body))
            (case (call .node-structure-match arms)
              (return (call arms-exit (. arms pattern) reaches uses infers))
            )
          )
        )
        (return (and (not directly) (call exits (. row body) false reaches uses infers)))
      )
      (case (call .node-structure-match row)
        (return (and (not directly) (call arms-exit (. row pattern) reaches uses infers) (call has-else (. row pattern))))
      )
    )
    (return (and (not directly) (not reaches) (not uses) (not infers) (call calls-no-return id)))
  )
  (fn-do _ calls-no-return Bool
    (param id SyntaxId)
    (let cursor (call (. facts first-call) (. frame instance) id))
    (while (!= cursor no-fact)
      (let call ([] (. facts calls) cursor))
      (= cursor (. call next))
      (let named (or (== (. call form) .call-function) (== (. call form) .call-method) (== (. call form) .call-static)))
      (if (and named (!= (. call callee) no-instance))
        (let row ([] (. frame instances rows) (. call callee)))
        (let module ([] (. frame program modules) (. row module)))
        (match? ([] (. module decls) (. row decl))
          (case (call .decl-function fn)
            (match? ([] (. module tree nodes) (. fn syntax))
              (case (call .node-function-syntax syntax)
                (return-if true (if (. syntax is-no-return)))
              )
            )
          )
        )
      )
    )
    (return false)
  )
  (fn-do _ arms-exit Bool
    (param pattern SyntaxId)
    (param reaches Bool)
    (param uses Bool)
    (param infers Bool)
    ; Whether every arm of a match leaves the function or the loop it is in. An arm written with
    ; `?!` raises what it makes.
    (match? ([] (. tree nodes) pattern)
      (case (call .node-type-or row)
        (return (and (call arms-exit (. row left) reaches uses infers) (call arms-exit (. row right) reaches uses infers)))
      )
      (case (call .node-type-transform row)
        (return (call exits (. row expr) false reaches uses infers))
      )
      (case .node-type-panic
        (return true)
      )
    )
    (return false)
  )
  (fn-do _ has-else Bool
    (param pattern SyntaxId)
    (match? ([] (. tree nodes) pattern)
      (case (call .node-type-or row)
        (return (or (call has-else (. row left)) (call has-else (. row right))))
      )
      (case (call .node-type-transform row)
        (if (== (. row pattern) 0)
          (return true)
        )
        (match? ([] (. tree nodes) (. row pattern))
          (case .node-type-wildcard
            (return true)
          )
        )
      )
    )
    (return false)
  )
  (fn-expr + is-lazy-declaration Bool
    (param id SyntaxId)
    (match ([] (. tree nodes) id)
      (case (call .node-declare row)
        (. row is-lazy)
      )
      (default
        false
      )
    )
  )
  (fn-do _ is-constant Bool
    (param condition SyntaxId)
    (param truth Bool)
    ; Whether a condition is written as the constant true, or as the constant false.
    (match? ([] (. tree nodes) condition)
      (case (call .node-integer-syntax row)
        (return (== (. row value) (if-expr truth "1" "0")))
      )
      (case (call .node-identifier row)
        (let atom (if-expr truth (?? (. types true-atom) (. types false-atom)) (. types false-atom)))
        (return (and atom (== (. row name) atom)))
      )
      (case (call .node-type-predicate row)
        (return (call is-constant (. row expr) truth))
      )
    )
    (return false)
  )
  (fn-do _ has-break Bool
    (param id SyntaxId)
    (if (== id 0)
      (return false)
    )
    (match? ([] (. tree nodes) id)
      (case (call .node-block row)
        (for (in statement ([] (. tree children) (. row body)))
          (if (call has-break statement)
            (return true)
          )
        )
        (return false)
      )
      (case .node-break
        (return true)
      )
      (case (call .node-if-block row)
        (return (or (call has-break (. row body)) (call has-break (. row next))))
      )
      (case (call .node-do-block row)
        (return (call has-break (. row body)))
      )
      (case (call .node-stack-local-binding-block row)
        (return (call has-break (. row body)))
      )
      (case (call .node-use-block row)
        (return (call has-break (. row body)))
      )
      (case (call .node-match-expression row)
        (return (call has-break (. row body)))
      )
      (case (call .node-structure-match row)
        (return (call has-break (. row pattern)))
      )
      (case (call .node-type-or row)
        (return (or (call has-break (. row left)) (call has-break (. row right))))
      )
      (case (call .node-type-transform row)
        (return (call has-break (. row expr)))
      )
    )
    (return false)
  )
)
