release()

╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌

────────────────────
+ get is-sealed Bool

sealed

────────────────────
+ get builtin-classes BuiltinClasses

BuiltinClasses(type-decl(.optional), type-decl(.type-info), type-decl(.number))

────────────────────
+ do release

keys.release()
arena.release()

────────────────────
+ do reach
    - id TypeId

` Marks a type the typing state still names as a seal root. Duplicates and the absent type
` are dropped here so the callers can offer every column they hold without sorting it.
if id == no-type
    =
while reach-visited.length <= id
    reach-visited += false
if reach-visited[id]
    =
reach-visited[id] = true
reach-pending += id

────────────────────
+ do seal

` Completes every reached type and everything a completed type refers to, including the types
` completion itself interns on the way, and then refuses to intern or complete anything more,
` so the store can outlive the syntax trees and the typing scratch that completion reads.
while reach-pending.length != 0
    . last = reach-pending.length - 1
    . id = reach-pending[last]
    -= reach-pending[last .. < reach-pending.length]
    complete(id)
    reach-children(id)
rank()
sealed = true

────────────────────
+ do forget-module
    - forgotten ModuleId

. dropped [Size]
for closure, _ in placed
    do match? rows[closure as TypeId]
        | .type-closure(row)
            if row.module == forgotten
                dropped += closure
for closure in dropped
    -= placed[closure]

────────────────────
+ do unseal

sealed = false

────────────────────
+ env-frame TypeEnv

TypeEnv(env-names.length, env-names.length, env-constrained.length, env-constrained.length)

────────────────────
+ do env-bind TypeEnv
    - env TypeEnv
    - name Atom
    - type TypeId

?! Panic("TypeEnv binding below the top frame")
    if env.end != env-names.length

env-names += name
env-types += type
= TypeEnv(env.start, env-names.length, env.constraint-start, env.constraint-end, env.this-type)

────────────────────
+ do env-constrain TypeEnv
    - env TypeEnv
    - type TypeId
    - constraint TypeId

?! Panic("TypeEnv constraint below the top frame")
    if env.constraint-end != env-constrained.length

env-constrained += type
env-constraints += constraint
= TypeEnv(env.start, env.end, env.constraint-start, env-constrained.length, env.this-type)

────────────────────
+ env-with-this TypeEnv
    - env TypeEnv
    - this-type TypeId

TypeEnv(env.start, env.end, env.constraint-start, env.constraint-end, this-type)

────────────────────
+ do env-lookup TypeId?
    - env TypeEnv
    - name Atom

for reverse in 0 .. < env.end - env.start
    . position = env.end - 1 - reverse
    if env-names[position] == name
        = env-types[position]
= null

────────────────────
+ do env-lookup-from TypeId?
    - env TypeEnv
    - name Atom
    - first Size

for reverse in 0 .. < env.end - first
    . position = env.end - 1 - reverse
    if env-names[position] == name
        = env-types[position]
= null

────────────────────
+ env-name Atom
    - position Size

env-names[position]

────────────────────
+ do env-within TypeEnv
    - env TypeEnv

` A frame on top that holds what an environment below it binds and constrains, in its order,
` and the type it reads `This` as, for what is read inside what that environment is read for.
. made = env-frame()
for position in env.start .. < env.end
    made = env-bind(made, env-names[position], env-types[position])
for position in env.constraint-start .. < env.constraint-end
    made = env-constrain(made, env-constrained[position], env-constraints[position])
= env-with-this(made, env.this-type)

────────────────────
+ do env-release
    - env TypeEnv

-= env-names[env.start .. < env-names.length]
-= env-types[env.start .. < env-types.length]
-= env-constrained[env.constraint-start .. < env-constrained.length]
-= env-constraints[env.constraint-start .. < env-constraints.length]

────────────────────
+ do env-truncate
    - env TypeEnv

-= env-names[env.end .. < env-names.length]
-= env-types[env.end .. < env-types.length]

────────────────────
+ do index-atom Atom
    - position Size

while index-atoms.length <= position
    . next = index-atoms.length
    index-atoms += program.store-atom("$next")
= index-atoms[position]

────────────────────
+ do total-key-words Size

. total Size = 0
for index in 0 .. < keys.length
    total += keys.key-count(index)
= total

────────────────────
+ child-type TypeId
    - range RowRange'TypeId
    - offset U32

?! OutOfBoundsError("Types child offset out of bounds")
    if offset >= range.count

children[range.start + offset]

────────────────────
+ child-name Atom
    - range RowRange'Atom
    - offset U32

?! OutOfBoundsError("Types name offset out of bounds")
    if offset >= range.count

atoms[range.start + offset]

────────────────────
+ do bind-types

for binding in type-bindings
    . module = program.module-by-name(binding.module-name)
    if module
        . owner U32 = module as U32
        . decl = class-decl-named(owner, binding.class-name)
        if decl
            types-by-decl[pack-decl(owner, decl)] = binding.type
            if binding.is-builtin
                builtin-decls[pack-decl(owner, decl)] = 1
            . mark = scratch.types.mark
            . id = intern-class(owner, decl, mark)
            if !rows-by-type[binding.type]
                rows-by-type[binding.type] = id

