────────────────────
+ do intern-named-union TypeId
    - owner-name Atom
    - mark ScratchMark
    - names-mark ScratchMark
    - made-in U32 = 0
    - made-at U32 = 0

` The union of the cases pushed since the marks, named for a declaration, and private to the
` module and the place in it that make it where they are given: another made elsewhere is another
` type.
?! Panic("Types are sealed and cannot intern a type")
    if sealed
. count = scratch.types.length - mark
?! Panic("Types union case names and types are misaligned")
    if scratch.names.length - names-mark != count

ensure-scratch(5 + count * 3)
. owner-address = owner-name.address
key-scratch[0] = TypeTag.named-union
key-scratch[1] = (owner-address /and/ U32.max) as U32
key-scratch[2] = (owner-address /rshift/ 32) as U32
key-scratch[3] = made-in
key-scratch[4] = made-at
for offset in 0 .. < count
    . address = scratch.names[names-mark + offset].address
    key-scratch[5 + offset * 3] = (address /and/ U32.max) as U32
    key-scratch[6 + offset * 3] = (address /rshift/ 32) as U32
    key-scratch[7 + offset * 3] = scratch.types[mark + offset]

. id U32 = keys.store(key-scratch.data, 5 + count * 3) as U32
if keys.last-inserted
    . owner = type-decl(.union)
    . cases = store-items(mark)
    . names = store-names(names-mark)
    rows.append
        - NamedUnionType(owner.module, owner.decl, owner-name, cases, names, made-in, made-at)
    add-completion()
    note-children(id, cases)
scratch.types.rewind(mark)
scratch.names.rewind(names-mark)
= id

