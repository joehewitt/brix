    if sealed
. start = mark ?? scratch.types.length
. count = scratch.types.length - start
ensure-scratch(7 + count)
key-scratch[0] = TypeTag.binding
key-scratch[1] = form
key-scratch[2] = module
key-scratch[3] = decl
key-scratch[4] = object
key-scratch[5] = param-count
key-scratch[6] = scope
for offset in 0 .. < count
    key-scratch[7 + offset] = scratch.types[start + offset]
. id U32 = keys.store(key-scratch.data, 7 + count) as U32
if keys.last-inserted
    . held = store-items(start)
    rows.append(BindingType(module, decl, form, scope, object, param-count, held))
