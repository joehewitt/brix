+ do is-arena Bool
    - id TypeId

` Whether a type is `core/arena`'s `Arena`.
do match? rows[id]
    | .type-class(row)
        . module = program.modules[row.module]
        do match? module.decls[row.decl]
            | .decl-class(owner)
                = module.name == "core/arena" && owner.name.text == "Arena"
= false

────────────────────
+ do is-arena-backing Bool
    - id TypeId

` Whether a type is `core/arena`'s `ArenaBacking`.
do match? rows[id]
    | .type-class(row)
        . module = program.modules[row.module]
        do match? module.decls[row.decl]
            | .decl-class(owner)
                = module.name == "core/arena" && owner.name.text == "ArenaBacking"
= false

