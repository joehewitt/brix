    - decl DeclId

!!builtin-decls[pack-decl(module, decl)]

────────────────────
+ intrinsic-for-decl IntrinsicKind
    - module ModuleId
    - decl DeclId

|? found
    found as IntrinsicKind
??
    IntrinsicKind.none

.. found = types-by-decl[pack-decl(module, decl)]

────────────────────
+ type-row TypeId
