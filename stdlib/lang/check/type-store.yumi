do match? rows[id]
    | .type-class(row)
        if row.args.count > 1 && is-arena-backing(child-type(row.args, 1))
            = child-type(row.args, 0)
= no-type

────────────────────
+ do intern-class TypeId
    - module ModuleId
    - decl DeclId
    - mark ScratchMark

?! Panic("Types are sealed and cannot intern a type")
    if sealed
. count = scratch.types.length - mark
ensure-scratch(3 + count)
key-scratch[0] = TypeTag.class
key-scratch[1] = module
key-scratch[2] = decl
for offset in 0 .. < count
    key-scratch[3 + offset] = scratch.types[mark + offset]

. id U32 = keys.store(key-scratch.data, 3 + count) as U32
if keys.last-inserted
    . args = store-items(mark)
    rows.append(ClassType(module, decl, args, RowRange'TypeId()))
    add-completion()
    note-children(id, args)
    if is-builtin-decl(module, decl)
        set-flag(id, .flag-builtin)
scratch.types.rewind(mark)
= id

