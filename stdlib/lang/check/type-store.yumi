    completions[id].intrinsic = .binding
    completions[id].is-pointer = true
    for offset in 0 .. < held.count
        if completions[child-type(held, offset)].has-closures
            completions[id].has-closures = true
    if object != no-type && completions[object].has-closures
        completions[id].has-closures = true
scratch.types.rewind(start)
= id

