    core-module = core as ModuleId
. intrinsics = program.module-by-name("core/intrinsics")
if intrinsics
    intrinsics-module = intrinsics as ModuleId
. table = program.module-by-name("core/table")
if table
    table-module = table as ModuleId
declare-class-equalities()

