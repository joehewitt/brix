────────────────────
+ do shared-case-base TypeId
    - union TypeId
    - above TypeId = no-type

` The nearest base every case of a union derives from, or the next one above a base given.
. cases = cases-of(union)
if cases.length == 0
    = no-type
for fact in cases
    if fact.is-default || fact.type == no-type || fact.type == invalid-type
        = no-type
. base = base-of(if above != no-type then above else cases[0].type) ?? no-type
while base != no-type
    . ref = DeclRef(0, 0)
    do match? rows[base]
        | .type-class(row)
            ref = DeclRef(row.module, row.decl)
    . shared = true
    for fact in cases
        if ancestor-of(fact.type, ref) != base
            shared = false
    if shared
        = base
    base = base-of(base) ?? no-type
= no-type

────────────────────
+ do ancestor-of TypeId
    - id TypeId
    - ref DeclRef

. current = id
while true
    complete(current)
    do match? rows[current]
        | .type-class(row)
            if row.module == ref.module && row.decl == ref.decl
                = current
    . base = base-of(current)
    if !base
        = no-type
    current = base

