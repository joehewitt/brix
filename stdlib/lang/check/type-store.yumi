ensure-scratch(1 + count)
key-scratch[0] = TypeTag.union
for offset in 0 .. < count
    key-scratch[1 + offset] = scratch.types[mark + offset]

. id U32 = keys.store(key-scratch.data, 1 + count) as U32
if keys.last-inserted
    . owner = type-decl(.union)
