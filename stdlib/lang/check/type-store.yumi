────────────────────
+ This
    - program Program
    - scratch TypingScratch

?! Panic("Types must intern the invalid type at id zero")
    if intern-invalid() != invalid-type
void-type = invalid-type
bool-type = invalid-type
null-type = invalid-type
char8-type = invalid-type
f64-type = invalid-type
string-type = invalid-type
generator-decl = DeclRef(0, 0)
list-decl = DeclRef(0, 0)

.. rows = Table'TypeData(arena, 16)
.. completions = Table'TypeCompletion(arena, 16)
.. stable-keys = List'StableKey(arena)
.. ranked = Array'TypeId(arena, 0)
.. children = Scratch'TypeId(arena, 1024)
.. atoms = List'Atom(arena)
.. env-names = List'Atom(arena)
.. env-types = List'TypeId(arena)
.. env-constrained = List'TypeId(arena)
.. env-constraints = List'TypeId(arena)
.. index-atoms = List'Atom(arena)
.. resolving = List'U32(arena)
.. properties = Table'TypeProperty(arena, 16)
.. cases = Table'TypeCase(arena, 16)
.. associated-types = Table'TypeAssociated(arena, 16)
.. equalities = Table'TypeEquality(arena, 16)
.. property-scratch = Table'TypeProperty(arena, 16)
.. property-places = Map'MemberKey'U32(arena)
.. scratch-places = Map'MemberKey'U32(arena)
.. case-scratch = Table'TypeCase(arena, 16)
.. associated-scratch = Table'TypeAssociated(arena, 16)
.. key-scratch = Array'U32(arena, 16)
.. types-by-decl = Map'Size'U32(arena)
.. rows-by-type = Map'Size'U32(arena)
.. builtin-decls = Map'Size'U32(arena)
.. subclassed-decls = Map'Size'Bool(arena)
.. subclass-heads = Map'Size'U32(arena)
.. checked-classes = Map'Size'U32(arena)
.. c-function-decls = Map'Size'U64(arena)
.. placed = Map'Size'U64(arena)

