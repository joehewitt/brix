key-scratch[0] = TypeTag.raising-class
key-scratch[1] = module
key-scratch[2] = decl
key-scratch[3] = (errors-mark - mark) as U32
for offset in 0 .. < count
    key-scratch[4 + offset] = scratch.types[mark + offset]

. id U32 = keys.store(key-scratch.data, 4 + count) as U32
if keys.last-inserted
    . errors = store-items(errors-mark)
    scratch.types.rewind(errors-mark)
    . args = store-items(mark)
    rows.append(ClassType(module, decl, args, errors))
    add-completion()
    note-children(id, args)
    note-children(id, errors)
scratch.types.rewind(mark)
= id

