+ do well-known-type TypeId
    - module-name String
    - class-name String

. ref = well-known-decl(module-name, class-name)
if ref.module == 0 && ref.decl == 0
    = invalid-type
. mark = scratch.types.mark
= intern-class(ref.module, ref.decl, mark)

────────────────────
+ do well-known-type-of TypeId
