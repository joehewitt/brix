────────────────────
+ do evaluate-type TypeId
    - caller ModuleId
    - ast AST
    - id SyntaxId
    - env TypeEnv

if id == 0
    = void-type

do match ast.nodes[id]
    | .node-type-identifier(row)
        = type-named(caller, row.name, env)
    | .node-core-type-identifier(row)
        = well-known-type(row.module-name.text, row.name.text)
    | .node-type-arguments(row)
        = evaluate-type-args(caller, ast, row.base, row.args, env)
    | .node-type-associated(row)
        . named = evaluate-type-associated(caller, ast, row.owner, row.name, row.args, env)
        if named == invalid-type && fault && fault-site == 0
            fault-module = caller
            fault-site = id
        = named
    | .node-type-optional(row)
        = evaluate-type-optional(caller, ast, row.field-types, env)
    | .node-type-tuple(row)
        = evaluate-type-tuple(caller, ast, row.field-types, row.is-struct, env)
    | .node-type-function(row)
        . ret = row.return-type
        . errs = row.errors
        = evaluate-type-function(caller, ast, ret, row.args, errs, row.is-c, env)
    | .node-type-capture(row)
        = if row.type == 0 then invalid-type else evaluate-type(caller, ast, row.type, env)
    | .node-type-list(row)
        = evaluate-sugar(caller, ast, list-atom!, row.patterns, env)
    | .node-type-map(row)
        = evaluate-type-map(caller, ast, row.patterns, env)
    | .node-type-iterable(row)
        . item = evaluate-type(caller, ast, row.pattern, env)
        =? invalid-type if item == invalid-type
        . mark = scratch.types.mark
        scratch.types.push(item)
        = class-named-with-args(caller, stream-atom!, mark)
    | .node-type-match(row)
        = evaluate-type(caller, ast, row.type, env)
    | .node-type-and(row)
        = evaluate-type(caller, ast, row.left, env)
    | .node-type-or(row)
        = evaluate-type(caller, ast, row.left, env)
    | .node-type-numeric(row)
        = evaluate-type-numeric(caller, ast, row.value, env)
    | .node-identifier(row)
        = type-named(caller, row.name, env)
    | .node-argument-decl(row)
        = evaluate-type(caller, ast, row.pattern, env)
    ??
        = invalid-type

────────────────────
+ do missing-type SyntaxId
    - caller ModuleId
    - ast AST
    - id SyntaxId
    - env TypeEnv

` The innermost type written by name, with its arguments, that names nothing, within a type
` written, as TypeScript reports it; 0 where every name names a type.
do match? ast.nodes[id]
    | .node-type-identifier
        = if evaluate-type(caller, ast, id, env) == invalid-type then id else 0
    | .node-type-arguments(row)
        for argument in ast.children[row.args]
            . inner = missing-type(caller, ast, argument, env)
            if inner != 0
                = inner
        = if evaluate-type(caller, ast, id, env) == invalid-type then id else 0
for child in ast.children-of(id)
    . inner = missing-type(caller, ast, child, env)
    if inner != 0
        = inner
= 0

