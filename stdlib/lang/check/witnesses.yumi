━━━━━━━━━━━━━━━━━━━━
+ PendingReturn is Struct

+ callee InstanceId
+ site SyntaxId
+ expected TypeId
+ owner ModuleId

━━━━━━━━━━━━━━━━━━━━
+ PendingWitness is Struct

+ callee InstanceId
+ fn WitnessFunc
+ value TypeId

━━━━━━━━━━━━━━━━━━━━
+ WitnessTables

` The tables of what answers the functions of interfaces for each type converted to one. One
` that is `finding` only interns the functions that answer, as a type pass that types on many
` workers does on each (`type-share`): it records what tables a class derived from one has and
` which instances of an interface's functions calls name, and nothing of what answers them.

+ finding = false
_ retyping = false
+ types Types
+ program Program
_ relations Relations
+ instances Instances
+ facts Facts
_ ranking Ranking
_ scratch TypingScratch
_ tables-scanned Size = 0
_ funcs-scanned Size = 0
_ protos-scanned Size = 0
_ calls-scanned Size = 0
_ types-scanned Size = 0
_ equalities-scanned Size = 0
_ dynamic-scanned Size = 0
_ waiting [TypeId]
_ pending [PendingReturn]
_ resolved [Bool]
_ unchecked [PendingWitness]
_ getter-steps [U32]
_ tables-indexed Size = 0
_ table-heads [U32]
_ table-links [U32]
_ funcs-indexed Size = 0
_ func-heads [U32]
_ func-links [U32]
_ protos-indexed Size = 0
_ proto-heads [U32]
_ proto-links [U32]
_ frame Frame
_ conversions Conversions
_ session Session

────────────────────
+ This
    - typing Session

.. session = typing
.. types = session.types
.. relations = session.relations
.. program = session.program
.. instances = session.instances
.. facts = session.facts
.. ranking = Ranking(session, 0)
.. scratch = session.scratch
.. frame = Frame(session)
.. conversions = Conversions(frame)

────────────────────
+ do expand Bool
    - host Demander
    - host-conversions Conversions

` Finds what answers the functions of interfaces for the types converted to them since it
` last ran, and says whether a table was added. A class derived from one with a table has a
` table of its own, but for one with variables left, which no object is: a class made since it
` last ran, or complete since then (`fresh-types`), finds the tables of the classes above it,
` which are listed by the class each is for, but for those made as this runs, which have none
` listed yet, and a table added since then looks through every class made before, where any
` class is declared below its own. They are added in the
` order of the tables and then of the classes. Each table schedules the functions, listed by
` interface, of the interfaces its own is derived from, in the order they were found. The host
` works out the type of a property a class delegates to that is written with none, and types
` the defaults a function of a table gives (`record-defaults`). The ranking converts as the
` host does, with `host-conversions`.
ranking.host = host
ranking.conversions = host-conversions
. tables-before = tables-scanned
. types-before = types-scanned
. funcs-before = funcs-scanned
. protos-before = protos-scanned
for position in calls-scanned .. < facts.calls.length
    . callee = facts.calls[position].callee
    if callee == no-instance
        continue
    . receiver = instances.rows[callee].self-type
    if receiver != no-type && receiver != invalid-type && types.intrinsic-of(receiver) == .interface
        facts.record-witness-proto(callee)
calls-scanned = facts.calls.length
tables-scanned = facts.witness-tables.length
types-scanned = types.rows.length
funcs-scanned = facts.witness-funcs.length
protos-scanned = facts.witness-protos.length
while table-heads.length < types-scanned
    table-heads += 0
    func-heads += 0
    proto-heads += 0
for position in tables-indexed .. < tables-scanned
    . value = facts.witness-tables[position].value
    table-links += table-heads[value]
    table-heads[value] = (position + 1) as U32
tables-indexed = tables-scanned
. fresh = fresh-types(types-before)
. found [U64]
for position in tables-before .. < tables-scanned
    . table = facts.witness-tables[position]
    if !types.has-subclasses(table.value)
        continue
    for candidate in 0 .. < types-before
        . type = candidate as TypeId
        if type == table.value || !class-like || types.completions[type].has-variables
            continue
        .. class-like = intrinsic-is-class(types.completions[type].intrinsic)
        if in-base-chain(types, type, table.value)
            . wide U64 = position as U64
            found += (wide /lshift/ 32) /or/ (candidate as U64)
for type in fresh
    if !intrinsic-is-class(types.completions[type].intrinsic) || generic
        continue
    .. generic = types.completions[type].has-variables
    . level = types.base-of(type)
    while level
        . link = if level < table-heads.length then table-heads[level] else 0
        while link != 0
            . wide U64 = link - 1
            found += (wide /lshift/ 32) /or/ (type as U64)
            link = table-links[link - 1]
        level = types.base-of(level)
. sorted = sorted-pairs(found)
for pair in sorted
    . table = facts.witness-tables[(pair /rshift/ 32) as Index]
    facts.record-witness-table((pair /and/ 0xffffffff) as TypeId, table.interface)
derive-dynamic(fresh)
for offset in funcs-indexed .. < funcs-scanned
    . interface = facts.witness-funcs[offset].interface
    func-links += func-heads[interface]
    func-heads[interface] = (offset + 1) as U32
funcs-indexed = funcs-scanned
for offset in protos-indexed .. < protos-scanned
    . interface = instances.rows[facts.witness-protos[offset]].self-type
    proto-links += proto-heads[interface]
    proto-heads[interface] = (offset + 1) as U32
protos-indexed = protos-scanned
for position in 0 .. < tables-scanned
    . table = facts.witness-tables[position]
    if types.completions[table.value].intrinsic == .interface
        continue
    . first = if position < tables-before then funcs-before else 0
    . first-proto = if position < tables-before then protos-before else 0
    if first == funcs-scanned && first-proto == protos-scanned
        continue
    . reached [TypeId]
    reach-interfaces(table.interface, reached)
    . offsets [U32]
    . proto-offsets [U32]
    for interface in reached
        if interface >= func-heads.length
            continue
        . link = func-heads[interface]
        while link != 0 && (link - 1) as Size >= first
            offsets += link - 1
            link = func-links[link - 1]
        link = proto-heads[interface]
        while link != 0 && (link - 1) as Size >= first-proto
            proto-offsets += link - 1
            link = proto-links[link - 1]
    . sorted-funcs = sort(offsets)
    for offset in sorted-funcs
        schedule-witness(table.value, facts.witness-funcs[offset], no-instance)
    . sorted-protos = sort(proto-offsets)
    for offset in sorted-protos
        . proto = facts.witness-protos[offset]
        . row = instances.rows[proto]
        schedule-witness
            - table.value
            - WitnessFunc(row.self-type, row.module, row.decl)
            - proto
            - table.interface
if !finding
    resolve-pending()
    expand-equalities(tables-before)
ranking.host = null
ranking.conversions = null
= facts.witness-tables.length != tables-scanned

────────────────────
+ do check-retyped
    - host Demander
    - host-conversions Conversions
    - retired [Bool]

` Notes again each answer to a function of an interface that an edit typed again in place
` (`retype-edit`). Retiring the answer dropped what was noted at it: how it takes the arguments,
` how what it answers converts, and how the interface's own function takes the value. Its slot is
` filled already, and stays as it is.
ranking.host = host
ranking.conversions = host-conversions
retyping = true
. count = facts.witness-slots.length
for position in 0 .. < count
    . slot = facts.witness-slots[position]
    if slot.based || slot.callee == no-instance || unretired
        continue
    .. unretired = (slot.callee as Size) >= retired.length || !retired[slot.callee]
    . row = instances.rows[slot.proto]
    schedule-witness
        - slot.value
        - WitnessFunc(row.self-type, row.module, row.decl)
        - slot.proto
        - row.self-type
resolve-pending()
retyping = false
ranking.host = null
ranking.conversions = null

────────────────────
_ do fresh-types [TypeId]
    - types-before Size

` The types made since the last pass, and those made before that were not complete then and are
` now, in that order; one not complete yet waits for a later pass, as what it is is not known
` until it is.
. fresh [TypeId]
. still [TypeId]
for type in waiting
    if is-settled(type)
        fresh += type
    else
        still += type
for candidate in types-before .. < types-scanned
    . type = candidate as TypeId
    if is-settled(type)
        fresh += type
    else
        still += type
waiting = still
= fresh

────────────────────
_ is-settled Bool
    - type TypeId

state == .completion-done || state == .completion-failed

.. state = types.completions[type].completion

────────────────────
_ do derive-dynamic
    - fresh [TypeId]

` A class cast to an interface that classes below it declare has, for each class below it
` that the interface's conversion takes, a table of that class's own (`record-dynamic-witness`).
` A pair noted since the last pass looks through every class, and the others through the
` classes `fresh-types` gives.
. pairs = facts.dynamic-witnesses.length
for position in 0 .. < pairs
    . pair = facts.dynamic-witnesses[position]
    if position >= dynamic-scanned
        for candidate in 0 .. < types-scanned
            derive-table(candidate as TypeId, pair.value, pair.interface)
    else
        for type in fresh
            derive-table(type, pair.value, pair.interface)
dynamic-scanned = pairs

────────────────────
_ do derive-table
    - type TypeId
    - value TypeId
    - interface TypeId

if !intrinsic-is-class(types.completions[type].intrinsic) || types.completions[type].has-variables
    =
if type != value && !in-base-chain(types, type, value)
    =
if relations.compare(type, interface).kind == .relation-interface-cast
    facts.record-witness-table(type, interface)

────────────────────
_ do expand-equalities
    - tables-before Size

` Gives each table whose interface, or one it is derived from, has its values compared the
` comparison of two values of its type, which the function the table holds for equality
` runs. The comparison is queued as it is first made.
. equalities-before = equalities-scanned
equalities-scanned = facts.equalities.length
for position in 0 .. < tables-scanned
    . table = facts.witness-tables[position]
    . owner = class-ref(types, table.value)
    if table.equality != no-instance || owner.decl == 0 || of-interface
        continue
    .. of-interface = types.completions[table.value].intrinsic == .interface
    . first = if position < tables-before then equalities-before else 0
    for offset in first .. < equalities-scanned
        if implements(table.interface, facts.equalities[offset])
            facts.witness-tables[position].equality = instances.intern-equality
                - owner.module
                - table.value
            break

────────────────────
_ do resolve-pending

for position in 0 .. < pending.length
    if resolved[position]
        continue
    . item = pending[position]
    if instances.rows[item.callee].state != .instance-done
        continue
    . signature = instances.signatures[item.callee]
    if signature.return-state == .return-pending
        continue
    resolved[position] = true
    record-return(item.callee, item.site, signature.returns, item.expected, item.owner)
. waiting [PendingWitness]
for item in unchecked
    . settled = instances.rows[item.callee].state == .instance-done
    if settled && instances.signatures[item.callee].return-state != .return-pending
        check-witness(item)
    else
        waiting += item
unchecked = waiting

────────────────────
_ do check-witness
    - item PendingWitness

. fn = item.fn
. names-mark = scratch.names.mark
. items-mark = scratch.types.mark
. module = fn.module
. signature = signature-into(types, module, fn.decl, no-type-arguments(types), fn.interface, true)
. syntax = decl-syntax(fn.module, fn.decl)
. proto = MethodProto
    - "Interface"
    - "interface"
    - fn.module
    - syntax
    - signature.returns
    - signature.errors
check-method-result(session, item.callee, proto, carries-own-errors(types, item.value))
scratch.types.rewind(items-mark)
scratch.names.rewind(names-mark)

────────────────────
_ do record-return
    - callee InstanceId
    - site SyntaxId
    - returned TypeId
    - expected TypeId
    - owner ModuleId

` Records how the function of a witness table converts what the type's function answers to
` what the interface's answers, where they differ: at the type's function, with the function a
` type declares that converts it, where one does.
if returned == expected || returned == no-type || returned == invalid-type
    =
. relation = relations.compare(returned, expected, false, false, null, owner)
if relation.kind != .relation-same
    frame.begin(callee)
    conversions.begin()
    conversions.host = ranking.host
    . converter = conversions.converter-of(relation)
    . id = facts.record-conversion(callee, site, relation, .reason-return, converter)
    record-held(callee, id, relation, .reason-return)

────────────────────
_ do record-receiver
    - callee InstanceId
    - site SyntaxId
    - receiver TypeId
    - expected TypeId
    - owner ModuleId

` Records where the function of a witness table gives the interface's own function the value
` of the type as that interface: at the interface's function.
if site == 0 || receiver == expected
    =
. relation = relations.compare(receiver, expected, false, false, null, owner)
if relation.kind != .relation-same
    facts.record-conversion(callee, site, relation, .reason-receiver, no-instance)

────────────────────
_ do record-held
    - callee InstanceId
    - id FactId
    - relation Relation
    - reason ConversionReason

` Records the parts of a conversion, as `parts-of` makes them: for one that makes an optional of
` another type, the conversion of what it holds, and for a value made a case of a union, its
` conversion to what the case holds. The witness table of what an optional holds is noted where
` the new one holds an interface.
if relation.kind == .relation-side-cast && types.is-optional(relation.to)
    . held = types.optional-inner(relation.to)
    . given = types.optional-inner(relation.from)
    if types.intrinsic-of(held) == .interface && given != held && given != types.null-type
        facts.record-witness-table(given, held)
frame.begin(callee)
conversions.begin()
conversions.host = ranking.host
facts.conversions[id].parts = conversions.parts-of(relation, reason)

────────────────────
_ do record-arguments Bool
    - callee InstanceId
    - site SyntaxId
    - hit Hit

` Records how the function of a witness table gives the type's function each argument the
` interface's function takes, where their types differ: at the type's function, with the
` function that converts where the type's argument is made from the interface's by one it
` declares. A conversion by any other function is left out, and has no shape. Says whether
` any argument converts.
. converts = false
for position in 0 .. < hit.fills.length
    if position >= hit.relations.length
        break
    . relation = hit.relations[position]
    if relation.kind == .relation-same || relation.from == relation.to
        continue
    converts = true
    . converter = no-instance
    if relation.converter-module != U32.max
        if relation.kind != .relation-fromverter
            continue
        . mark = scratch.types.mark
        scratch.types.push(relation.from)
        . effects = declared-effects(program, relation.converter-module, relation.converter-decl)
        converter = instances.intern
            - relation.converter-module
            - relation.converter-decl
            - relation.to
            - effects
            - no-instance
            - scratch.no-types
            - scratch.types.since(mark)
        scratch.types.rewind(mark)
    . id = facts.record-conversion(callee, site, relation, .reason-argument, converter)
    record-held(callee, id, relation, .reason-argument)
= converts

────────────────────
_ do record-defaults
    - callee InstanceId
    - site SyntaxId
    - hit Hit
    - given U32

` Types the defaults of the parameters a type's function takes past the arguments the
` interface's function gives, which the function of the witness table gives it, and records at
` the type's function how a literal one converts to its parameter's type, as a call that
` leaves the argument out records it.
. host = ranking.host!
. owner = program.modules[hit.module]
match? owner.decls[hit.decl]
    | .decl-function(fn)
        for position in given .. < fn.args.count
            . shape = owner.arg-pool[fn.args.start + position]
            if shape.default-syntax == 0
                continue
            host.type-default(callee, position)
            . env = types.env-frame()
            . literal = literal-type(types, hit.module, owner.tree, shape.default-syntax, env)
            types.env-release(env)
            . expected = instances.argument-type(callee, position)
            match? owner.tree.nodes[shape.default-syntax]
                | .node-symbol(row)
                    literal = contextual-symbol(types, relations, expected, row.name, hit.module)
            if literal == invalid-type || literal == expected
                continue
            frame.begin(callee)
            conversions.begin()
            conversions.host = host
            conversions.convert(site, site, literal, expected, .reason-default)

────────────────────
_ do reach-interfaces
    - interface TypeId
    - reached [TypeId]

` Adds an interface and each it is derived from to a list, each once.
if reached.find(interface) != null
    =
reached += interface
for parent in types.interfaces-of(interface)
    reach-interfaces(parent, reached)

────────────────────
_ do implements Bool
    - interface TypeId
    - required TypeId

if interface == required
    = true
for parent in types.interfaces-of(interface)
    if implements(parent, required)
        = true
= false

────────────────────
_ do schedule-witness
    - receiver TypeId
    - fn WitnessFunc
    - proto InstanceId
    - table TypeId = no-type

` Finds the function of a type that answers a function of an interface, and schedules it. One that
` is `finding` leaves what another pass of a parallel type pass finds first to that pass.
` For an instance of the interface's function that a call names, it is found for that
` instance's arguments, with its type parameters as written, and noted as what fills the
` instance's slot for the type. Where the
` type declares none, that is the interface's own function: the instance itself when its
` receiver is the interface that declares the function, and else the function as the type
` runs it, which takes a value of the type and sees it as that interface. A getter or a
` setter the interface declares with a body is always the type's, whose receiver is the
` value. One found
` through a property the type delegates to is run for what that property holds. A getter or a
` setter the type answers with a property it stores is noted with the property, and a
` function a property the type delegates to answers with the properties read to reach it,
` as is a property stored there. A getter with a body found so is the type's own instead:
` it is typed with the type as its receiver, as the reference runs it for a value.
` Where the interface's own function answers and `table` is an interface derived from the
` one that declares it, the function as the type runs it is noted too: the reference fills
` the slot of such a table with that. A function no call names whose parameters are written
` with type parameters of its own is found only for the arguments a call gives it, as the
` reference fills its tables only with the functions calls name.
if finding && !claims(receiver, fn, proto, table)
    =
. owner-module = program.modules[fn.module]
. kind = DeclKind.function-decl
. name Atom? = null
. defaulted = false
. answers = false
. declarer DeclId = 0
match? owner-module.decls[fn.decl]
    | .decl-function(row)
        kind = row.kind
        name = row.name
        defaulted = row.body != 0
        answers = row.return-type != 0
        declarer = row.owner
if !name
    =
ranking.caller = class-ref(types, receiver).module
. names-mark = scratch.names.mark
. items-mark = scratch.types.mark
. module = fn.module
. plain = no-type-arguments(types)
. signature = signature-into(types, module, fn.decl, plain, fn.interface, true)
. shapes-start = scratch.call-arguments.mark
. params-start = scratch.types.mark
if proto != no-instance
    . row = instances.rows[proto]
    . given = param-count - implicit-argument-count(types, row.module, row.decl)
        .. param-count = instances.signatures[proto].param-count
    for position in 0 .. < given
        scratch.types.push(instances.param-type(proto, position))
. params = scratch.types.since(params-start)
. types-start = scratch.types.mark
. open = false
if proto == no-instance
    for arg in signature.args
        scratch.call-arguments.push(CallArgument(null, false, false, false, false))
        scratch.types.push(arg)
        open = open || types.completions[arg].has-variables
else
    for position in 0 .. < instances.signatures[proto].args.count
        scratch.call-arguments.push(CallArgument(null, false, false, false, false))
        scratch.types.push(instances.argument-type(proto, position))
ranking.begin(scratch.call-arguments.since(shapes-start), scratch.types.since(types-start))
ranking.explicit-params(params)
. hit Hit? = null
if kind == .getter-decl
    hit = ranking.dispatch-getter(receiver, name)
else if kind == .setter-decl
    hit = ranking.dispatch-setter(receiver, name)
else
    hit = ranking.dispatch-method(receiver, name)
. declared = hit && defaulted && hit.module == fn.module && hit.decl == fn.decl
. passed = hit && hit.receiver != receiver && ranking.delegates-to(receiver, hit.receiver)
. own = declared && !passed
. unanswered = answerable && self-hit && types.intrinsic-of(receiver) != .interface
    .. answerable = proto != no-instance && !defaulted && answers
    .. self-hit = !hit || (hit.module == fn.module && hit.decl == fn.decl)
. lazy-override = hit && defaulted && !is-imperative-decl(hit.module, hit.decl)
. direct = false
if own-function && !ranking.ambiguity() && types.intrinsic-of(receiver) == .class
    . seen = class-ref(types, instances.rows[proto].self-type)
    direct = seen.module == fn.module && seen.decl == declarer
.. own-function = own && kind == .function-decl && proto != no-instance
. place = types.property-named(receiver, name) if kind != .function-decl
. stored = place && types.properties[place].storage-kind != .storage-getter
. steps [U32]
. holder = no-type
if kind != .function-decl && !place
    holder = ranking.delegated-holder(receiver, name, steps)
. reached = types.property-named(holder, name) if holder != no-type && steps.length != 0
. lent = reached && types.properties[reached].storage-kind != .storage-getter
if lent && (declared || !hit)
    if proto != no-instance && !finding
        facts.record-witness-slot(receiver, proto, no-instance, reached! as U32, keep-steps(steps))
else if stored && (declared || !hit)
    if proto != no-instance && !finding
        facts.record-witness-slot(receiver, proto, no-instance, place! as U32)
else if direct
    if !finding
        facts.record-witness-slot(receiver, proto, proto)
        record-receiver
            - proto
            - decl-syntax(fn.module, fn.decl)
            - receiver
            - instances.rows[proto].self-type
            - fn.module
    if hit && table != instances.rows[proto].self-type
        . found = hit
        . viewed = instances.intern-dispatched
            - found.module
            - found.decl
            - found.receiver
            - declared-effects(program, found.module, found.decl)
            - proto
            - found.params
            - found.args
        if !finding
            facts.record-witness-slot(receiver, proto, viewed, U32.max, RowRange'U32(), true)
else if unanswered
    if !finding
        report-unanswered(receiver, fn, proto, name)
else if hit && !ranking.ambiguity() && (proto != no-instance || (!own && !lazy-override && !open))
    . effects = declared-effects(program, hit.module, hit.decl)
    . found = hit
    . self = found.receiver
    . places [U32]
    . lent = self != receiver && ranking.delegate-path(receiver, self, places)
    if lent && kind == .getter-decl
        self = receiver
        lent = false
    . callee = no-instance
    if proto != no-instance
        callee = instances.intern-dispatched
            - found.module
            - found.decl
            - self
            - effects
            - proto
            - found.params
            - found.args
    else
        callee = instances.intern
            - found.module
            - found.decl
            - self
            - effects
            - no-instance
            - found.params
            - found.args
    if !finding
        note-witness(callee, fn, receiver, proto, found, lent, places, signature.returns)
ranking.release()
scratch.call-arguments.rewind(shapes-start)
scratch.types.rewind(items-mark)
scratch.names.rewind(names-mark)
keep-getters()

────────────────────
_ do claims Bool
    - receiver TypeId
    - fn WitnessFunc
    - proto InstanceId
    - table TypeId

` Whether this pass is the first of a parallel type pass to find what answers a function of an
` interface for a type (`SharedTyping.claim`).
if !session.shared
    = true
. key = mixed(mixed(stable-key-seed, types.key-of(receiver)), types.key-of(fn.interface))
key = mixed(mixed(mixed(key, fn.module), fn.decl), types.key-of(table))
if proto != no-instance
    key = mixed(key, instances.stable-keys[proto])
= session.shared!.claim(key)

────────────────────
_ do report-unanswered
    - receiver TypeId
    - fn WitnessFunc
    - proto InstanceId
    - name Atom

` Reports a type that answers no function of an interface the interface declares without a body
` and with a result, which the type must answer: there is nothing of the interface's to run.
. ref = class-ref(types, receiver)
. site = match program.modules[ref.module].decls[ref.decl]
    | .decl-class(class)
        class.syntax
    ??
        0u32
. message = unanswered-text(types, receiver, fn.interface, name)
facts.record-diagnostic(proto, ref.module, site, .stated, program.store-atom(message))
facts.relate-diagnostic(program.store-atom("Interface"), fn.module, decl-syntax(fn.module, fn.decl))

────────────────────
_ do note-witness
    - callee InstanceId
    - fn WitnessFunc
    - receiver TypeId
    - proto InstanceId
    - found Hit
    - lent Bool
    - places [U32]
    - expected TypeId

` Notes the function of a type that answers a function of an interface: to be checked against it
` once typed, with how it takes the arguments of an instance a call names and fills its slot,
` and how what it answers converts to what the interface's answers.
unchecked += PendingWitness(callee, fn, receiver)
. site = decl-syntax(found.module, found.decl)
if proto != no-instance
    . converts = site != 0 && record-arguments(callee, site, found)
    if site != 0
        record-defaults(callee, site, found, instances.signatures[proto].args.count)
    if lent && !retyping
        facts.record-witness-slot
            - receiver
            - proto
            - callee
            - U32.max
            - keep-steps(places)
            - false
            - converts
    else
        facts.record-witness-slot(receiver, proto, callee, U32.max, RowRange'U32(), false, converts)
. owner = found.module
. given = no-type-arguments(types)
. implemented = signature-into(types, owner, found.decl, given, receiver, true)
. returned = implemented.returns
if site != 0 && expected != no-type
    if returned == no-type
        pending += PendingReturn(callee, site, expected, owner)
        resolved += false
    else
        record-return(callee, site, returned, expected, owner)

────────────────────
_ do keep-steps RowRange'U32
    - places [U32]

` Keeps the properties read on the way to what a type delegates to, and notes those a getter
` answers, whose getters are kept once the ranking is released.
. none [InstanceId]
. kept = facts.keep-steps(places, none)
for offset in 0 .. < places.length
    . property = types.properties[places[offset]]
    if property.storage-kind == .storage-getter && property.owner != no-type
        getter-steps += (kept.start + offset) as U32
= kept

────────────────────
_ do keep-getters

` Keeps, for each property read on the way to what a type delegates to that a getter
` answers, the getter as the type that declares the property runs it, for the function of
` the witness table to call.
for step in getter-steps
    . property = types.properties[facts.steps[step]]
    ranking.begin(scratch.no-shapes, scratch.no-types)
    . hit = ranking.dispatch-getter(property.owner, property.name)
    if hit && !ranking.ambiguity()
        . found = hit
        . effects = declared-effects(program, found.module, found.decl)
        . getter = instances.intern
            - found.module
            - found.decl
            - found.receiver
            - effects
            - no-instance
            - found.params
            - found.args
        facts.step-callees[step] = getter
    ranking.release()
getter-steps.clear()

────────────────────
_ decl-syntax SyntaxId
    - module ModuleId
    - decl DeclId

match program.modules[module].decls[decl]
    | .decl-function(fn)
        fn.syntax
    ??
        0u32

────────────────────
_ do is-imperative-decl Bool
    - module ModuleId
    - decl DeclId

. owner-module = program.modules[module]
match? owner-module.decls[decl]
    | .decl-function(fn)
        match? owner-module.tree.nodes[fn.syntax]
            | .node-function-syntax(syntax)
                = syntax.imperative
            | .node-getter-syntax(syntax)
                = syntax.imperative
= true
