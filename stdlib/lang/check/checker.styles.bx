(import ./binding)
(import ./calls)
(import ./checker)
(import ./checker.comprehensions)
(import ./checker.live-actions)
(import ./checker.markup)
(import ./conversions)
(import ./coverage)
(import ./dispatch)
(import ./error-sets)
(import ./facts)
(import ./frame)
(import ./header)
(import ./instances)
(import ./narrowing)
(import ./narrowing-key)
(import ./numeric)
(import ./panics)
(import ./pattern-helper)
(import ./portable)
(import ./probe-casts)
(import ./session)
(import ./signature)
(import ./table-rows)
(import ./type-env)
(import ./type-relation)
(import ./type-signature)
(import ./type-store)
(import ./type-text)
(import ./types)
(import ./typing-scratch)
(import /core/arena)
(import /core/scratch)
(import /lang/ast/ast)
(import /lang/ast/ast-children)
(import /lang/ast/ast-nodes)
(import /lang/ast/ast-queries)
(import /lang/ast/decl)
(import /lang/ast/facets)
(import /lang/ast/module)
(import /lang/ast/operator)
(import /lang/ast/program)
(import /lang/ast/row-range)
(import /lang/ast/state-machines)
(import /lang/ast/viability)
(import /lang/constants)
(import /stream/aggregate)
(import /stream/sort)

(type _ ThemeScope (is Tuple)
  (prop + made TypeId)
  (prop + sheet TypeId)
  (prop + statement SyntaxId)
  (prop + number U32)
)

(type _ Styles (facet-of Checker)
  (sees Comprehensions)
  (sees LiveActions)
  (sees Markup)
  (prop _ theme-statement SyntaxId (= 0))
  (prop _ theme-number U32 (= (. U32 max)))
  (prop _ style-mark U32 (= 0))
  (prop _ collecting Bool (= false))
  (prop _ framed U32 (= 0))
  (fn-do _ revise-application _
    (param index U32)
    ; Counts a change to an application of a style rule that another pass cannot take in with the
    ; instance changing it: one another instance recorded. The merge takes in the instance's own as
    ; they end, with the state cells and the values of rules they name (`Facts.absorb-applications`).
    (if (!= (. ([] (. facts style-applications) index) instance) instance)
      (+= (. facts revised) 1)
    )
  )
  (fn-do + check-gate-test _
    (param condition SyntaxId)
    ; The function that tests again the condition a style rule written on a markup element is
    ; applied under, as the reference's gate evaluates it in its live action: the condition typed
    ; again as the body of a closure that answers whether it holds, which must be a `Bool`.
    (call prepare)
    (call (. instances set-returns) instance (. types bool-type) (. types bool-type) .return-declared)
    (if (!= (call infer condition) (. types bool-type))
      (call decline condition)
    )
    (call finish-errors frame)
    (call close)
  )
  (fn-do + style-again Bool
    (param statement SyntaxId)
    (param rhs SyntaxId)
    (param row StyleDeclaration)
    ; Types the value of a style declaration a live action makes again, as where it is written.
    (let property ([] (. facts style-properties) (. row property)))
    (let written (call style-value rhs (. property type)))
    (if (or (== written invalid-type) (== written no-type))
      (return false)
    )
    (return (!= (call (. conversions convert) statement rhs written (. property type) .reason-assignment) invalid-type))
  )
  (fn-do + demand-styles _
    (param receiver TypeId)
    (param site SyntaxId)
    ; Registers the styles a class being made uses, and those the classes above it use, base
    ; first, as the reference does as it compiles a constructor: each style is numbered as it is
    ; first used, and its registration placed at the declaration of the constructor. No two styles
    ; a class sees may name one property. Then the classes' defaults are applied
    ; (`apply-style-defaults`). A using of a style sheet has no shape here, nor has one that is
    ; wrong in a class of another module, nor a property of an optional of a type that queries the
    ; markup the object is in.
    (if (or (== receiver no-type) (== receiver invalid-type) (!= (call (. types intrinsic-of) receiver) .class))
      (return)
    )
    (let chain (list TypeId))
    (let level (? TypeId) receiver)
    (while (and level (== (call (. types intrinsic-of) level) .class))
      (+= chain level)
      (= level (call (. types base-of) level))
    )
    (let visible (list TypeId))
    (for (in position (..< 0 (. chain length)))
      (for (in ref (call sheet-parts (call class-ref types ([] chain (- (. chain length) 1 position)))))
        (let owner ([] (. program modules) (. ref module)))
        (for (in member ([] (. owner member-pool) (call part-members ref)))
          (match? ([] (. owner decls) member)
            (case (call .decl-property property)
              (if (and (!= (. property type-syntax) 0) (call queries-markup ref (. property type-syntax)) (== (call query-type ref (. property type-syntax)) no-type))
                (call decline site)
                (return)
              )
            )
            (case (call .decl-using using)
              (if (!= (call using-sheet ref using) no-type)
                (continue)
              )
              (let used (call using-style ref using site))
              (if (== used no-type)
                (return)
              )
              (let index (call style-index used site true))
              (if (== index (. U32 max))
                (return)
              )
              (if (== (call (. visible find) used) null)
                (if (not (call distinct-style index visible (. ref module) (. using syntax) site))
                  (return)
                )
                (+= visible used)
              )
            )
          )
        )
      )
    )
    (if (call (. program module-by-name) "core/style")
      (call apply-style-defaults chain site)
    )
  )
  (fn-do _ apply-style-defaults _
    (param chain (list TypeId))
    (param site SyntaxId)
    ; The defaults of the classes of an object being made, base first, as the reference applies
    ; them once a constructor's body and the rules of each class have run: the rule `• This` each
    ; class writes declares at the defaults layer, each class's at a site of its own, its orders
    ; from a band of its own (`style-defaults-band`), the states its `when`s name the class's
    ; (`gate-when`). A line whose value reads something tracked is declared again by the action
    ; the object's class makes, as at an element. A rule `• This` that applies rules after its name
    ; applies them as an element's would (`apply-rule`), at the defaults layer, under the style
    ; sheets of the markup that made the object, as the reference's constructor applies them. Then
    ; come the rules and style lines of the class's root `<This` (`apply-root-rules`), and the rules
    ; of the style sheets the chain uses that the class's name answers (`apply-themed-defaults`). Each
    ; application of the defaults is marked `made` by its class. A rule `• This` written in another
    ; module is applied in that module (`enter-module`). A rule `• This` that takes values is
    ; declined.
    (for (in position (..< 0 (. chain length)))
      (let level ([] chain (- (. chain length) 1 position)))
      (let order (* (as position U32) style-defaults-band))
      (let ref (call class-ref types level))
      (let owner ([] (. program modules) (. ref module)))
      (match? ([] (. owner decls) (. ref decl))
        (case (call .decl-class class)
          (for (in member ([] (. owner member-pool) (. class members)))
            (match? ([] (. owner decls) member)
              (case (call .decl-style-rule rule)
                (let applying
                  (scope (and this-rule (call (. owner tree applies-rules) (. rule syntax)))
                    (lazy this-rule (== (. rule name text) "This"))
                  )
                )
                (if (and (== (. rule name text) "This") (not (call (. owner tree rule-takes-nothing) (. rule syntax))))
                  (call decline site)
                  (return)
                )
                (if (== (. rule name text) "This")
                  (let unit (call (. instances intern-initializer) (. ref module) member level))
                  (if (== (. ([] (. instances rows) unit) state) .instance-in-progress)
                    (call decline site)
                    (return)
                  )
                  (call demand-body unit)
                  (call (. panics note-inlined) instance unit)
                  (if (not (call note-style-errors unit site))
                    (return)
                  )
                  (if applying
                    (let home (call enter-module (. ref module)))
                    (let next
                      (call apply-defaults-rules
                        (block
                          (arg (. rule syntax))
                          (arg level)
                          (arg ([] chain 0))
                          (arg unit)
                          (arg order)
                        )
                      )
                    )
                    (call enter-module home)
                    (if (== next (. U32 max))
                      (return)
                    )
                    (if (!= next order)
                      (+= (. facts style-sites)
                        (call StyleSite
                          (block
                            (arg instance)
                            (arg (. ref module))
                            (arg (. rule syntax))
                          )
                        )
                      )
                    )
                    (= order next)
                    (continue)
                  )
                  (let ungated (list StyleWhen))
                  (for (in branch (call (. owner tree rule-whens) (call (. owner tree rule-body) (. rule syntax))))
                    (if (not (call gate-when site level (. ref module) branch ungated))
                      (return)
                    )
                  )
                  (let count (call (. facts style-declaration-count) unit))
                  (if (or (!= count 0) (call (. facts updates-properties) unit))
                    (+= (. facts style-applications)
                      (call StyleApplication
                        (block
                          (arg instance)
                          (arg (. ref module))
                          (arg (. rule syntax))
                          (arg unit)
                          (arg 0)
                          (arg order)
                        )
                      )
                    )
                    (= (. ([] (. facts style-applications) (- (. facts style-applications length) 1)) made) level)
                    (call revise-application (as (- (. facts style-applications length) 1) U32))
                    (if (not (call bind-defaults-slots site level unit last-application))
                      (return)
                    )
                    (lazy last-application (as (- (. facts style-applications length) 1) U32))
                    (if (call (. facts authors-in) unit)
                      (= (. ([] (. facts style-applications) (- (. facts style-applications length) 1)) action) (call demand-style-gates ([] chain 0)))
                      (call revise-application (as (- (. facts style-applications length) 1) U32))
                    )
                    (if (not (call choose-updater latest-application site level))
                      (return)
                    )
                    (lazy latest-application (as (- (. facts style-applications length) 1) U32))
                    (call share-defaults (- (. facts style-applications length) 1) (list unit) count)
                  )
                  (if (!= count 0)
                    (+= (. facts style-sites) (call StyleSite instance (. ref module) (. rule syntax)))
                    (+= order count)
                  )
                )
              )
            )
          )
        )
      )
      (= order (call apply-root-rules level ref ([] chain 0) order site))
      (if (== order (. U32 max))
        (return)
      )
      (if (not (call apply-themed-defaults level ([] chain 0) band-order site))
        (return)
      )
      (lazy band-order (+ (* (as position U32) style-defaults-band) (/ style-defaults-band 2)))
    )
  )
  (fn-do _ apply-themed-defaults Bool
    (param level TypeId)
    (param made TypeId)
    (param order U32)
    (param site SyntaxId)
    ; Applies the rules taking no values that the style sheets the chain of an object being made uses
    ; write by the name of its class `level`, among that class's defaults, as the reference's
    ; `styleThemeClass` finds them: those `sheet-rules` finds in the sheets of the chain and their
    ; variants, each as `apply-defaults-rules` applies a rule `• This`, in the module of the sheet
    ; that writes it, at a site of its own, from `order`, the upper half of the class's band, under
    ; the gates of the variants that write it (`gate-applications`). Where a class of the chain
    ; writes a rule of the name, an element applies that one instead, and none is applied here.
    ; Answers false where one is declined or reported.
    (let ref (call class-ref types level))
    (let named "")
    (let declared SyntaxId 0)
    (match? ([] (. ([] (. program modules) (. ref module)) decls) (. ref decl))
      (case (call .decl-class class)
        (= named (. class name text))
        (= declared (. class syntax))
      )
    )
    (let name (call (. program store-atom) named))
    (let (tuple owner written writes) (call class-style-rule made name))
    (return-if true (if (!= owner no-type)))
    (let none (list TypeId))
    (let sheets (list TypeId))
    (let members (list DeclRef))
    (let gates (list U64))
    (let entered (call enter-module (. ref module)))
    (let (tuple status found missed)
      (call sheet-rules
        (block
          (arg made)
          (arg name)
          (arg none)
          (arg declared)
          (arg sheets)
          (arg members)
          (arg gates)
          (arg (. U32 max))
          (arg false)
          (arg true)
        )
      )
    )
    (call enter-module entered)
    (if (== status 1)
      (call decline site)
    )
    (return-if false (if (!= status 0)))
    (let next order)
    (for (in position (..< 0 (. sheets length)))
      (let member ([] members position))
      (let syntax SyntaxId 0)
      (match? ([] (. ([] (. program modules) (. member module)) decls) (. member decl))
        (case (call .decl-style-rule rule)
          (= syntax (. rule syntax))
        )
      )
      (let home (call enter-module (. member module)))
      (let unit (call rule-unit ([] sheets position) member level syntax))
      (if (== unit no-instance)
        (call enter-module home)
        (call decline site)
        (return false)
      )
      (if (not (call note-style-errors unit site))
        (call enter-module home)
        (return false)
      )
      (let first (. facts style-applications length))
      (let applied (call apply-defaults-rules syntax level made unit next))
      (let gated
        (scope (and ordered (call gate-applications (as first U32) ([] sheets position) ([] gates position) syntax))
          (lazy ordered (!= applied (. U32 max)))
        )
      )
      (if (and gated (!= applied next))
        (+= (. facts style-sites) (call StyleSite instance (. member module) syntax))
      )
      (call enter-module home)
      (return-if false (if (not gated)))
      (= next applied)
    )
    (return true)
  )
  (fn-do _ bind-defaults-slots Bool
    (param site SyntaxId)
    (param level TypeId)
    (param unit InstanceId)
    (param application U32)
    (let sheeted (. markup-sheets length))
    (let context (. ([] (. instances rows) instance) context))
    (if (!= context (. U32 max))
      (let held ([] (. instances contexts) context))
      (for (in position (..< (+ (. held first) (. held styles)) (+ (. held first) (. held styles) (. held sheets))))
        (+= markup-sheets ([] (. instances context-types) position))
        (+= sheet-levels ([] (. instances context-levels) position))
      )
    )
    (let bound (call bind-rule-slots site level unit application))
    (while (> (. markup-sheets length) sheeted)
      (call (. markup-sheets pop))
      (call (. sheet-levels pop))
    )
    (return bound)
  )
  (fn-do _ note-style-errors Bool
    (param unit InstanceId)
    (param site SyntaxId)
    (if (call (. facts authors-in) unit)
      (call demand-errors unit)
      (if (and (!= (. ([] (. instances signatures) unit) errors count) 0) (not (call hands-off unit)))
        (call decline site)
        (return false)
      )
    )
    (call note-unit-errors unit site)
    (return true)
  )
  (fn-do _ apply-defaults-rules U32
    (param syntax SyntaxId)
    (param level TypeId)
    (param made TypeId)
    (param unit InstanceId)
    (param order U32)
    ; Applies a rule `• This` that the class `level` of an object being made writes and applies
    ; rules, and the rules it applies, as an element's rules are applied (`apply-rule`) to an object
    ; of that class, as the reference resolves them, but at the defaults layer, seeing the style
    ; sheets of the markup that made the object, which the constructor is made for, before those of
    ; the class, and the rules written in its rules, as the root's are seen (`apply-root-rules`),
    ; generating no content. A declaration that reads something tracked is declared again
    ; by the action of the object's class. Answers the order the next takes, or `U32.max`.
    (let first (. facts style-applications length))
    (let context (. ([] (. instances rows) instance) context))
    (let sheeted (. markup-sheets length))
    (let scoped (. rule-scopes length))
    (if (!= context (. U32 max))
      (let held ([] (. instances contexts) context))
      (for (in position (..< (+ (. held first) (. held styles)) (+ (. held first) (. held styles) (. held sheets))))
        (+= markup-sheets ([] (. instances context-types) position))
        (+= sheet-levels ([] (. instances context-levels) position))
      )
      (for (in position (..< (. held scope-first) (+ (. held scope-first) (. held scopes))))
        (if (and (== ([] (. instances context-cells) position) 0) (== ([] (. instances context-valued) position) (. U32 max)))
          (+= rule-scopes (call ScopeUse ([] (. instances context-scopes) position)))
        )
      )
    )
    (let active (list InstanceId))
    (let applied (list InstanceId))
    (let ungated (list StyleWhen))
    (let generates preparing)
    (= preparing (= (. preparing content-off) true))
    (= preparing (= (. preparing values-once) true))
    (= preparing (= (. preparing site) 0))
    (let framing framed)
    (let next (call apply-rule syntax level unit order 0 (. U32 max) 0 ungated active applied))
    (= preparing generates)
    (while (> (. markup-sheets length) sheeted)
      (call (. markup-sheets pop))
      (call (. sheet-levels pop))
    )
    (while (> (. rule-scopes length) scoped)
      (call (. rule-scopes pop))
    )
    (if (!= next (. U32 max))
      (for (in index (..< first (. facts style-applications length)))
        (= (. ([] (. facts style-applications) index) layer) 0)
        (call revise-application (as index U32))
        (if (== (. ([] (. facts style-applications) index) outer) (. U32 max))
          (= (. ([] (. facts style-applications) index) made) level)
          (call revise-application (as index U32))
        )
        (if (!= (. ([] (. facts style-applications) index) action) no-instance)
          (= (. ([] (. facts style-applications) index) action) (call demand-style-gates made))
          (call revise-application (as index U32))
        )
      )
      (if (== framed framing)
        (call share-defaults first applied (- next order))
      )
    )
    (return next)
  )
  (fn-do _ share-defaults _
    (param first Size)
    (param applied (list InstanceId))
    (param count U32)
    (return-if (if (or (== count 0) (>= first (. facts style-applications length)) (not (call shares-rule applied count)))))
    (let last (. facts style-applications length))
    (for (in index (..< first last))
      (let application ([] (. facts style-applications) index))
      (return-if (if (or (!= (. application cell) (. U32 max)) outer-held)))
      (lazy outer-held (or (!= (. application outer-cells) (. U32 max)) (!= (. application around-values) (. U32 max))))
      (return-if (if (or written-values (. application prepared) (!= (. application updater) no-instance))))
      (lazy written-values (or (!= (. application written) 0) (!= (. application values) no-instance)))
    )
    (for (in index (..< first last))
      (let unit (. ([] (. facts style-applications) index) unit))
      (call demand-errors unit)
      (return-if (if (!= (. ([] (. instances signatures) unit) errors count) 0)))
    )
    (= (. ([] (. facts style-applications) first) shared) true)
    (call revise-application (as first U32))
    (= (. ([] (. facts style-applications) first) span) count)
    (call revise-application (as first U32))
  )
  (fn-do _ apply-root-rules U32
    (param level TypeId)
    (param ref DeclRef)
    (param made TypeId)
    (param order U32)
    (param site SyntaxId)
    ; Applies the style rules the root `<This` of the markup the class `level` of an object being
    ; made writes after `•`, as the reference's constructor applies them once the class's rule
    ; `• This` has (`compileRootThisStyleDefaults`): each as an element's would to an object of that
    ; class (`apply-written-rules`), seeing none the others bring into view, at the defaults layer,
    ; at one site of the root's, from an order, under the style sheets of the markup that made the
    ; object and the rules written in its rules that no `when` or rule taking values holds. The
    ; rules written in the rules they apply come into view in the class's content (`root-scopes`),
    ; not here, so no state cell is kept for them, and a rule here that applies one under such a cell
    ; is declined. The values an application gives are typed by an instance of their own for the
    ; class, under the constructor's context (`check-root-values`), and those the rules it applies
    ; give the rules they apply are evaluated once, as the reference's constructor evaluates them
    ; (`values-once`). Then each line of the root that names no property of the class declares a
    ; style there, typed as an instance of its own (`check-root-style`). Content the rules' lines
    ; generate is declined (`content-refused`). A root written in another module is applied in that
    ; module (`enter-module`). A declaration that reads something tracked is declared again by the
    ; action of the object's class `made`. Answers the order the next takes, or `U32.max`.
    (let owner ([] (. program modules) (. ref module)))
    (let content SyntaxId 0)
    (let members (call (of RowRange DeclId)))
    (match? ([] (. owner decls) (. ref decl))
      (case (call .decl-class class)
        (= content (. class content))
        (= members (. class members))
      )
    )
    (if (== content 0)
      (return order)
    )
    (let root (call (. owner tree root-this) content))
    (let applications (call (of RowRange SyntaxId)))
    (let lines (list DeclId))
    (match? ([] (. owner tree nodes) root)
      (case (call .node-markup row)
        (= applications (. row style-rule-applications))
        (match? ([] (. owner tree nodes) (. row body))
          (case (call .node-block block)
            (for (in statement ([] (. owner tree children) (. block body)))
              (match? ([] (. owner tree nodes) statement)
                (case (call .node-assign line)
                  (let name (call (. owner tree identifier-name) (. line lhs)))
                  (if (and name (not (call property-named level name)))
                    (for (in member ([] (. owner member-pool) members))
                      (match? ([] (. owner decls) member)
                        (case (call .decl-property property)
                          (if (and (. property defaults-root) at-statement)
                            (+= lines member)
                          )
                          (lazy at-statement (== (. property syntax) statement))
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
    (if (and (== (. applications count) 0) (== (. lines length) 0))
      (return order)
    )
    (let home (call enter-module (. ref module)))
    (let next (call apply-root-written level ref made order site root applications lines))
    (call enter-module home)
    (return next)
  )
  (fn-do _ enter-module ModuleId
    (param entered ModuleId)
    ; Types what follows as written in a module, as the style rules a class of another module
    ; writes are applied to an object, the diagnostics there being that module's. Answers the
    ; module typed in before.
    (let home module)
    (= module entered)
    (= tree (. ([] (. program modules) entered) tree))
    (= (. frame module) entered)
    (= (. frame tree) tree)
    (return home)
  )
  (fn-do _ apply-root-written U32
    (param level TypeId)
    (param ref DeclRef)
    (param made TypeId)
    (param order U32)
    (param site SyntaxId)
    (param root SyntaxId)
    (param applications (of RowRange SyntaxId))
    (param lines (list DeclId))
    ; Applies the rules and style lines of the root `<This` of a class, in the module that writes
    ; it, as `apply-root-rules` says.
    (let first (. facts style-applications length))
    (let cells (as (. facts scope-cells length) U32))
    (let context (. ([] (. instances rows) instance) context))
    (let sheeted (. markup-sheets length))
    (let scoped (. rule-scopes length))
    (if (!= context (. U32 max))
      (let held ([] (. instances contexts) context))
      (for (in position (..< (+ (. held first) (. held styles)) (+ (. held first) (. held styles) (. held sheets))))
        (+= markup-sheets ([] (. instances context-types) position))
        (+= sheet-levels ([] (. instances context-levels) position))
      )
      (for (in position (..< (. held scope-first) (+ (. held scope-first) (. held scopes))))
        (if (and (== ([] (. instances context-cells) position) 0) (== ([] (. instances context-valued) position) (. U32 max)))
          (+= rule-scopes (call ScopeUse ([] (. instances context-scopes) position)))
        )
      )
    )
    (let seen (list ScopeUse))
    (for (in use element-scopes)
      (+= seen use)
    )
    (let refused preparing)
    (= preparing (= (. preparing content-refused) true))
    (= preparing (= (. preparing values-once) true))
    (= preparing (= (. preparing site) 0))
    (let next order)
    (for (in position (..< 0 (. applications count)))
      (call (. element-scopes clear))
      (let application ([] (. tree children) (+ (. applications start) position)))
      (let values no-instance)
      (match? ([] (. tree nodes) application)
        (case (call .node-style-rule-application applied)
          (if (!= (. applied args count) 0)
            (= values (call (. instances intern-root-values) module level application context))
            (call demand-body values)
            (call (. panics note-inlined) instance values)
          )
        )
      )
      (= next
        (call apply-written-rules
          (block
            (arg root)
            (arg level)
            (arg (call (of RowRange SyntaxId) (+ (. applications start) position) 1))
            (arg next)
            (arg values)
          )
        )
      )
      (if (== next (. U32 max))
        (break)
      )
    )
    (= preparing refused)
    (call (. element-scopes clear))
    (for (in use seen)
      (+= element-scopes use)
    )
    (while (> (. markup-sheets length) sheeted)
      (call (. markup-sheets pop))
      (call (. sheet-levels pop))
    )
    (while (> (. rule-scopes length) scoped)
      (call (. rule-scopes pop))
    )
    (if (== next (. U32 max))
      (return (. U32 max))
    )
    (for (in index (..< first (. facts style-applications length)))
      (let cell (. ([] (. facts style-applications) index) cell))
      (if (and (>= cell cells) (< cell (- (. U32 max) 1)))
        (call decline site)
        (return (. U32 max))
      )
    )
    (let empty (list ScopeUse))
    (do
      (inline (call prune-cells cells empty))
    )
    (for (in index (..< first (. facts style-applications length)))
      (= (. ([] (. facts style-applications) index) layer) 0)
      (call revise-application (as index U32))
      (if (== (. ([] (. facts style-applications) index) outer) (. U32 max))
        (= (. ([] (. facts style-applications) index) made) level)
        (call revise-application (as index U32))
      )
      (if (!= (. ([] (. facts style-applications) index) action) no-instance)
        (= (. ([] (. facts style-applications) index) action) (call demand-style-gates made))
        (call revise-application (as index U32))
      )
    )
    (for (in member lines)
      (let unit (call (. instances intern-initializer) (. ref module) member level))
      (if (== (. ([] (. instances rows) unit) state) .instance-in-progress)
        (call decline site)
        (return (. U32 max))
      )
      (call demand-body unit)
      (call (. panics note-inlined) instance unit)
      (if (not (call note-style-errors unit site))
        (return (. U32 max))
      )
      (let count (call (. facts style-declaration-count) unit))
      (if (== count 0)
        (call decline site)
        (return (. U32 max))
      )
      (+= (. facts style-applications) (call StyleApplication instance (. ref module) root unit 0 next))
      (= (. ([] (. facts style-applications) (- (. facts style-applications length) 1)) made) level)
      (call revise-application (as (- (. facts style-applications length) 1) U32))
      (if (call (. facts authors-in) unit)
        (= (. ([] (. facts style-applications) (- (. facts style-applications length) 1)) action)
          (call demand-style-gates
            (block
              (arg made)
            )
          )
        )
        (call revise-application (as (- (. facts style-applications length) 1) U32))
      )
      (+= next count)
    )
    (if (!= next order)
      (+= (. facts style-sites) (call StyleSite instance (. ref module) root))
    )
    (return next)
  )
  (fn-do + check-root-style _
    (param receiver TypeId)
    (param row PropertyDecl)
    ; Types a line of a root `<This` that names no property of its class as the declaration of a
    ; style property of the object, as the reference's constructor declares it among the class's
    ; defaults (`compileRootThisStyleDefaults`): as a line of the class's rule `• This` is
    ; (`declare-unit-style`), with `this` bound, at the root.
    (= (. frame self-type) receiver)
    (call bind-this receiver)
    (call (. frame close-env))
    (call open-class-env (call holding-type receiver (call DeclRef module (. row owner))))
    (let root 0u32)
    (match? ([] (. ([] (. program modules) module) decls) (. row owner))
      (case (call .decl-class class)
        (= root (call (. tree root-this) (. class content)))
      )
    )
    (let styles (call style-vocabulary receiver (. row syntax)))
    (if styles
      (do
        (inline (call declare-unit-style (. row syntax) root receiver styles 0))
      )
    )
    (call (. instances set-returns) instance (. types void-type) (. types void-type) .return-declared)
    (call finish-errors frame)
    (call close)
  )
  (fn-do _ queries-markup Bool
    (param ref DeclRef)
    (param written SyntaxId)
    ; Whether the type a class writes for a property is a query of the markup an object is in,
    ; `Ancestor'T` or `Descendants'T` of the markup runtime, or the optional of one.
    (let owner ([] (. program modules) (. ref module)))
    (let env (call (. types class-env) (. ref module) (. ref decl)))
    (let type (call (. types evaluate-type) (. ref module) (. owner tree) written env))
    (call (. types env-release) env)
    (let held (if-expr (call (. types is-optional) type) (call (. types optional-inner) type) type))
    (if (or (== held invalid-type) (!= (call (. types intrinsic-of) held) .class))
      (return false)
    )
    (let declared (call class-ref types held))
    (let home ([] (. program modules) (. declared module)))
    (if (!= (. home name) "core/markup")
      (return false)
    )
    (match? ([] (. home decls) (. declared decl))
      (case (call .decl-class class)
        (return (or (== (. class name text) "Ancestor") (== (. class name text) "Descendants")))
      )
    )
    (return false)
  )
  (fn-do _ using-style TypeId
    (param ref DeclRef)
    (param using UsingDecl)
    (param site SyntaxId)
    ; The style a class, or an extension of a style sheet, names in a using, or none where the using
    ; is declined or reported. One of a style sheet is no style (`using-sheet`); `StyleSheet` itself
    ; is the reference's error.
    (let used (call using-type ref using))
    (let root (and (== (call (. types intrinsic-of) used) .style-sheet) (== used (call (. types type-row) .style-sheet))))
    (if (or (== used invalid-type) (and (== (call (. types intrinsic-of) used) .style-sheet) (not root)))
      (call decline (if-expr (== (. ref module) module) (. using syntax) site))
      (return no-type)
    )
    (if (or (!= (call (. types intrinsic-of) used) .style) (== used (call (. types type-row) .style)))
      (if (!= (. ref module) module)
        (call decline site)
        (else
          (call (. frame diagnose)
            (block
              (arg (. using syntax))
              (arg .stated)
              (arg (call (. program store-atom) "Using target must be a Style or StyleSheet"))
            )
          )
        )
      )
      (return no-type)
    )
    (return used)
  )
  (fn-do _ using-sheet TypeId
    (param ref DeclRef)
    (param using UsingDecl)
    ; The style sheet a class names in a using, declared `• Name`, or none.
    (let used (call using-type ref using))
    (call (. types clear-fault))
    (if (or (== used invalid-type) (!= (call (. types intrinsic-of) used) .style-sheet))
      (return no-type)
    )
    (let sheet (call class-ref types used))
    (return (if-expr (call is-sheet-decl (. sheet module) (. sheet decl)) (call family-root used) no-type))
  )
  (fn-do _ using-type TypeId
    (param ref DeclRef)
    (param using UsingDecl)
    ; The type a using of a class or of an extension of a style sheet names, with the fault the
    ; type store gives where it names none. One it names is kept, and found again as it was.
    (let key (/or/ (/lshift/ (as (. ref module) Size) 32) (as (. using type-syntax) Size)))
    (let known ([] (. session scratch using-types) key))
    (if known
      (call (. types clear-fault))
      (return known)
    )
    (let owner ([] (. program modules) (. ref module)))
    (let env (call holder-env ref))
    (call (. types clear-fault))
    (let used (call (. types evaluate-type) (. ref module) (. owner tree) (. using type-syntax) env))
    (call (. types env-release) env)
    (if (!= used invalid-type)
      (= ([] (. session scratch using-types) key) used)
    )
    (return used)
  )
  (fn-do + add-sheet-groups _
    (param class TypeId)
    (param sheets (list TypeId))
    (param levels (list U32))
    ; Adds the style sheets a class uses to those seen, each in its group, as the reference's
    ; `visibleStyleSheetUsingGroups` and `addStyleSheetVocabularyGroup` add them: the classes of its
    ; chain, base first, each a group of its own, higher than those before, each sheet only where it
    ; is first seen. The sheets of each class of the chain are found once (`chain-sheets`).
    (if (or (== class no-type) (== class invalid-type) (!= (call (. types intrinsic-of) class) .class))
      (return)
    )
    (let place (as (call chain-sheets class) Size))
    (let position (. U32 max))
    (let group 0u32)
    (while (!= ([] (. facts chain-sheets) place) no-type)
      (let sheet ([] (. facts chain-sheets) place))
      (if (!= ([] (. facts chain-sheet-positions) place) position)
        (= position ([] (. facts chain-sheet-positions) place))
        (= group (if-expr (!= (. levels length) 0) (+ ([] levels (- (. levels length) 1)) 1) 0))
      )
      (if (== (call (. sheets find) sheet) null)
        (+= sheets sheet)
        (+= levels group)
      )
      (+= place 1)
    )
  )
  (fn-do _ chain-sheets U32
    (param class TypeId)
    ; Where the style sheets the classes of a chain use begin in `chain-sheets`, each with the place of
    ; its class in the chain, base first, in the order the classes name them, ended by none; found the
    ; first time they are asked for.
    (let held ([] (. facts chain-sheet-places) class))
    (return-if held (if held))
    (let start (as (. facts chain-sheets length) U32))
    (let chain (list TypeId))
    (let level (? TypeId) class)
    (while (and level (== (call (. types intrinsic-of) level) .class))
      (+= chain level)
      (= level (call (. types base-of) level))
    )
    (for (in position (..< 0 (. chain length)))
      (for (in ref (call sheet-parts (call class-ref types ([] chain (- (. chain length) 1 position)))))
        (let owner ([] (. program modules) (. ref module)))
        (for (in member ([] (. owner member-pool) (call part-members ref)))
          (match? ([] (. owner decls) member)
            (case (call .decl-using using)
              (let sheet (call using-sheet ref using))
              (if (!= sheet no-type)
                (+= (. facts chain-sheets) sheet)
                (+= (. facts chain-sheet-positions) (as position U32))
              )
            )
          )
        )
      )
    )
    (+= (. facts chain-sheets) no-type)
    (+= (. facts chain-sheet-positions) (. U32 max))
    (= ([] (. facts chain-sheet-places) class) start)
    (return start)
  )
  (fn-expr + sheets-known Bool
    ; Whether the style sheets markup written here sees are known here: in the main code of a module,
    ; or a function or a property's getter or setter that is nested in none, as the reference starts
    ; such a function with none; in the function that makes a class's content, which is one of its
    ; own for those of the markup that makes the object (`load-context`); and in a function that
    ; builds markup the markup around it gives them to (`sheets-given`); and in a constructor, whose
    ; body the reference starts with none and whose defaults it applies under those of the markup
    ; that makes the object (`apply-style-defaults`). Another nested in one sees those of the markup
    ; around it.
    (case? (or (. frame declaration is-content) sheets-given)
      true
    )
    (default
      (and (== (. ([] (. instances rows) instance) enclosing) no-instance) (or (== kind .main-decl) (== kind .function-decl) (== kind .getter-decl) (== kind .setter-decl) (call is-constructor-kind kind)))
    )
    (where
      (lazy kind (. frame declaration kind))
    )
  )
  (fn-do + seen-sheets _
    (param sheets (list TypeId))
    (param levels (list U32))
    ; The style sheets markup written here sees where no element is around it, in their groups,
    ; those of the class it is written in, or `sheet-self` while the way to a slot outlet is followed,
    ; where there are none.
    (for (in sheet markup-sheets)
      (+= sheets sheet)
    )
    (for (in level sheet-levels)
      (+= levels level)
    )
    (if (== (. sheets length) 0)
      (call add-sheet-groups
        (block
          (arg (if-expr (!= (. keying sheet-self) no-type) (. keying sheet-self) (. frame self-type)))
          (arg sheets)
          (arg levels)
        )
      )
    )
  )
  (fn-do + defaults-apply-rules Bool
    (param class TypeId)
    ; Whether the rule `• This` of a class of a chain applies rules, as the reference's
    ; `styleDefaultsApplyRules` asks.
    (let level (? TypeId) class)
    (while (and level (== (call (. types intrinsic-of) level) .class))
      (let ref (call class-ref types level))
      (let owner ([] (. program modules) (. ref module)))
      (match? ([] (. owner decls) (. ref decl))
        (case (call .decl-class declared)
          (for (in member ([] (. owner member-pool) (. declared members)))
            (match? ([] (. owner decls) member)
              (case (call .decl-style-rule rule)
                (if (and (== (. rule name text) "This") (call (. owner tree applies-rules) (. rule syntax)))
                  (return true)
                )
              )
            )
          )
        )
      )
      (= level (call (. types base-of) level))
    )
    (return false)
  )
  (fn-do + sheet-has-slot Bool
    (param sheet TypeId)
    (param name Atom)
    ; Whether a style sheet declares a slot of a name.
    (let ref (call class-ref types sheet))
    (let owner ([] (. program modules) (. ref module)))
    (match? ([] (. owner decls) (. ref decl))
      (case (call .decl-class declared)
        (for (in member ([] (. owner member-pool) (. declared members)))
          (match? ([] (. owner decls) member)
            (case (call .decl-property property)
              (if (and (. property name) (== (. property name) name))
                (return true)
              )
            )
          )
        )
      )
    )
    (return false)
  )
  (fn-do + names-sheet-slot Bool
    (param name Atom)
    ; Whether any style sheet of the program declares a slot of a name, among the names gathered
    ; once (`list-sheet-slots`).
    (call list-sheet-slots)
    (return (!= ([] (. facts sheet-slot-names) name) null))
  )
  (fn-do _ list-sheet-slots _
    (return-if (if (. facts slot-names-listed)))
    (= (. facts slot-names-listed) true)
    (for (in position (..< 0 (. program modules length)))
      (let owner ([] (. program modules) position))
      (for (in index (..< 0 (. owner decls length)))
        (match? ([] (. owner decls) index)
          (case (call .decl-property property)
            (if (and (. property name) (!= (. property owner) 0) in-sheet)
              (= ([] (. facts sheet-slot-names) (. property name)) 1)
            )
            (lazy in-sheet (call is-sheet-decl (as position ModuleId) (. property owner)))
          )
        )
      )
    )
  )
  (fn-do _ declare-sheet-slot U32
    (param statement SyntaxId)
    (param element SyntaxId)
    (param index U32)
    (param position U32)
    (param layer U32)
    (param order U32)
    (param value SyntaxId)
    (param made TypeId)
    ; A style declaration whose value is a name alone that names a slot of a style sheet the element
    ; sees, as the reference's `compileStyleDeclaration` takes one: the runtime reads the slot's
    ; value as it settles. The sheets the element sees are in groups, lowest first: those the class
    ; the markup is written in uses, those of the elements it is in, outermost first, then those of
    ; the element's class (`add-sheet-groups`); the slot is that of the highest group that has one
    ; of the name, and two in one group are the reference's error. A name that is also a local, a
    ; global, or a member of the class the markup is written in or of an element it is in is the
    ; reference's error. Answers 0 where the value names no such slot, 1 where it is declared, and 2
    ; where it is reported or declined. Where the sheets the markup sees are not known here
    ; (`sheets-known`), a name that is a slot of any style sheet is declined, as is a slot of another
    ; type than the property's.
    (let name (? Atom) null)
    (match? ([] (. tree nodes) value)
      (case (call .node-identifier row)
        (if (not (. row is-tracked))
          (= name (. row name))
        )
      )
    )
    (if (or (not name) (== (call (. types well-known-type) "core/style" "StyleSheetInfo") invalid-type))
      (return 0)
    )
    (if (not (call sheets-known))
      (if (call names-sheet-slot name)
        (call decline statement)
        (return 2)
      )
      (return 0)
    )
    (let (tuple found resolved) (call resolve-slot made name module statement))
    (if (not resolved)
      (return 2)
    )
    (if (== found no-type)
      (return 0)
    )
    (let clashes
      (scope (== (/and/ resolution-flags (. ResolutionFlag resolution-styled)) 0)
        (lazy resolution-flags (. (call (. bindings resolution-of) (. frame binding) value) flags))
      )
    )
    (for (in parent content-parents)
      (if (or (call property-named parent name) (call declares-event parent name))
        (= clashes true)
      )
    )
    (if (and self-class (or self-property (call declares-event (. frame self-type) name)))
      (= clashes true)
    )
    (lazy self-property (call property-named (. frame self-type) name))
    (lazy self-class (and (!= (. frame self-type) no-type) (== (call (. types intrinsic-of) (. frame self-type)) .class)))
    (if clashes
      (let text
        (paragraph
          (str "\"" (. name text) "\" is ambiguous: it names both a StyleSheet slot of " (call type-short-name types found) " and a lexical value")
        )
      )
      (call (. frame diagnose) value .stated (call (. program store-atom) text))
      (return 2)
    )
    (return (call declare-slot statement element index position layer order value name found))
  )
  (fn-do _ bind-rule-slots Bool
    (param id SyntaxId)
    (param made TypeId)
    (param unit InstanceId)
    (param application U32)
    ; Resolves, where a style rule a class writes is applied to a markup element, each line whose
    ; value is a name alone that a style sheet may answer against the sheets the element sees, as
    ; the reference resolves it there (`resolve-slot`): a line whose name nothing else declares
    ; takes that slot's value (`rule-slots`), and one whose name is also a value the rule sees is
    ; the reference's error. Declined: such a name no sheet the element sees answers, and one
    ; where the sheets are not known here.
    (let owner (. ([] (. instances rows) unit) module))
    (let written (. ([] (. program modules) owner) tree))
    (let count (as (. facts style-declarations length) U32))
    (let place (call (. facts first-style-declaration) unit))
    (while (< place count)
      (let row ([] (. facts style-declarations) place))
      (= place (call (. facts next-style-declaration) place))
      (if (. row inherits)
        (continue)
      )
      (let value SyntaxId 0)
      (match? ([] (. written nodes) (. row site))
        (case (call .node-assign line)
          (= value (. line rhs))
        )
      )
      (let name (? Atom) null)
      (match? ([] (. written nodes) value)
        (case (call .node-identifier ident)
          (if (not (. ident is-tracked))
            (= name (. ident name))
          )
        )
      )
      (let deferred (== (. row sheet) (- (. U32 max) 1)))
      (if (or (not name) (not (call names-sheet-slot name)))
        (if deferred
          (call decline id)
          (return false)
        )
        (continue)
      )
      (if (not (call sheets-known))
        (call decline id)
        (return false)
      )
      (let (tuple found resolved) (call resolve-slot made name owner (. row site)))
      (if (not resolved)
        (return false)
      )
      (if (== found no-type)
        (if deferred
          (call decline id)
          (return false)
        )
        (continue)
      )
      (if (not deferred)
        (call report-at
          (block
            (arg owner)
            (arg value)
            (arg
              (paragraph
                (str "\"" (. name text) "\" is ambiguous: it names both a StyleSheet slot of " (call type-short-name types found) " and a lexical value")
              )
            )
          )
        )
        (return false)
      )
      (let (tuple number offset projection)
        (call slot-binding
          (block
            (arg owner)
            (arg (. row site))
            (arg (. row property))
            (arg value)
            (arg name)
            (arg found)
            (arg id)
          )
        )
      )
      (if (== number (. U32 max))
        (return false)
      )
      (call revise-application application)
      (call (. facts add-rule-slot) (call RuleSlot application (. row site) number offset projection))
    )
    (return true)
  )
  (fn-do _ defers-slot Bool
    (param value SyntaxId)
    ; Whether the value of a line of a style rule a class writes is a name alone that nothing
    ; declares and some style sheet has a slot of, which is resolved where the rule is applied
    ; (`bind-rule-slots`).
    (match? ([] (. tree nodes) value)
      (case (call .node-identifier row)
        (return (and (not (. row is-tracked)) (!= (/and/ (. (call (. bindings resolution-of) (. frame binding) value) flags) (. ResolutionFlag resolution-styled)) 0) (call names-sheet-slot (. row name))))
      )
    )
    (return false)
  )
  (fn-do + visible-sheets _
    (param made TypeId)
    (param sheets (list TypeId))
    (param levels (list U32))
    ; The style sheets a markup element of a class sees, each in its group, lowest first, as the
    ; reference's `styleSheetVocabularyGroupsFor` gives them: those of the markup the element is
    ; in, or where there are none those the class the markup is written in uses, then those of the
    ; element's class (`add-sheet-groups`), but at a slot outlet (`overlaying`), where the reference
    ; adds none.
    (call seen-sheets sheets levels)
    (if (not (. preparing overlaying))
      (call add-sheet-groups made sheets levels)
    )
  )
  (fn-do _ declare-own-slot U32
    (param statement SyntaxId)
    (param element SyntaxId)
    (param index U32)
    (param position U32)
    (param order U32)
    (param value SyntaxId)
    (param sheet TypeId)
    ; A line of a rule of a style sheet whose value is a name alone that names a slot of the sheet,
    ; which the reference resolves against that sheet alone: declared as `declare-slot` says.
    ; Answers as `declare-sheet-slot` does.
    (match? ([] (. tree nodes) value)
      (case (call .node-identifier row)
        (if (and (not (. row is-tracked)) (call sheet-has-slot sheet (. row name)))
          (return (call declare-slot statement element index position 0 order value (. row name) sheet))
        )
      )
    )
    (return 0)
  )
  (fn-do _ reads-sheet-member Bool
    (param value SyntaxId)
    (param sheet TypeId)
    ; Whether a value a rule of a style sheet declares names `this` or a member of the sheet that is
    ; no slot of it, which the reference compiles with no object of the sheet.
    (let root (call family-root sheet))
    (for (in node (.. (call (. tree subtree-start) value) value))
      (match? ([] (. tree nodes) node)
        (case (call .node-identifier row)
          (if (or (== (. row name text) "this") (and (call property-named sheet (. row name)) not-slot))
            (return true)
          )
          (lazy not-slot (not (call sheet-has-slot root (. row name))))
        )
      )
    )
    (return false)
  )
  (fn-do _ enter-theme ThemeScope
    (param made TypeId)
    (param sheet TypeId)
    (param statement SyntaxId)
    (let outer (call ThemeScope theme-made theme-sheet theme-statement theme-number))
    (= theme-made made)
    (= theme-sheet sheet)
    (= theme-statement statement)
    (= theme-number (. U32 max))
    (return outer)
  )
  (fn-do _ leave-theme U32
    (param outer ThemeScope)
    (let number theme-number)
    (= theme-made (. outer made))
    (= theme-sheet (. outer sheet))
    (= theme-statement (. outer statement))
    (= theme-number (. outer number))
    (return number)
  )
  (fn-do + read-theme TypeId
    (param id SyntaxId)
    (param name Atom)
    (let found no-type)
    (if (!= theme-sheet no-type)
      (= found (call sheet-slot-owner theme-sheet name))
      (else
        (if (not (call sheets-known))
          (call decline id)
          (return invalid-type)
        )
        (let (tuple seen resolved) (call resolve-slot theme-made name module theme-statement))
        (if (not resolved)
          (return invalid-type)
        )
        (= found seen)
      )
    )
    (if (== found no-type)
      (call (. frame diagnose) id .stated (call (. program store-atom) "Name not found"))
      (return invalid-type)
    )
    (let number (call sheet-index (call family-root found) module theme-statement id))
    (if (== number (. U32 max))
      (return invalid-type)
    )
    (let use ([] (. facts style-sheet-uses) number))
    (let offset 0u32)
    (while (and (< offset (. use count)) (!= (. ([] (. facts sheet-slots) (+ (. use first) offset)) name) name))
      (+= offset 1)
    )
    (if (== offset (. use count))
      (call decline id)
      (return invalid-type)
    )
    (if (and (!= theme-number (. U32 max)) (!= theme-number number))
      (let other (call type-short-name types (. ([] (. facts style-sheet-uses) theme-number) type)))
      (call (. frame diagnose)
        (block
          (arg id)
          (arg .stated)
          (arg
            (call (. program store-atom)
              (block
                (arg
                  (paragraph
                    (str "A style value reads slots of one StyleSheet: \"" (. name text) "\" is a slot of " (call type-short-name types (. use type)) ", and others it reads are slots of " other)
                  )
                )
              )
            )
          )
        )
      )
      (return invalid-type)
    )
    (= theme-number number)
    (call (. facts add-theme-read) (call ThemeRead instance module id number offset))
    (return (. ([] (. facts sheet-slots) (+ (. use first) offset)) type))
  )
  (fn-do _ sheet-slot-owner TypeId
    (param sheet TypeId)
    (param name Atom)
    (let root (call family-root sheet))
    (return-if root (if (call sheet-has-slot root name)))
    (for (in part (call sheet-parts (call class-ref types root)))
      (let owner ([] (. program modules) (. part module)))
      (for (in member ([] (. owner member-pool) (call part-members part)))
        (match? ([] (. owner decls) member)
          (case (call .decl-using using)
            (let used (call using-sheet part using))
            (if (and (!= used no-type) (call sheet-has-slot used name))
              (return used)
            )
          )
        )
      )
    )
    (return no-type)
  )
  (fn-do _ theme-static Bool
    (param value SyntaxId)
    (for (in node (.. (call (. tree subtree-start) value) value))
      (if (call (. facts theme-read-of) instance node)
        (continue)
      )
      (match? ([] (. tree nodes) node)
        (case .node-style-read-expression
          (return false)
        )
        (case (call .node-identifier row)
          (if (or (. row is-tracked) (== (. row name text) "this"))
            (return false)
          )
          (let kind (. (call (. bindings resolution-of) (. frame binding) node) kind))
          (if (or (== kind .resolve-slot) (== kind .resolve-member))
            (return false)
          )
        )
      )
    )
    (return true)
  )
  (fn-do _ declare-themed Bool
    (param statement SyntaxId)
    (param element SyntaxId)
    (param index U32)
    (param position U32)
    (param layer U32)
    (param order U32)
    (param value SyntaxId)
    (param number U32)
    (let property ([] (. facts style-properties) position))
    (if (or (call is-live-statement statement) (not (call theme-static value)))
      (call (. frame diagnose)
        (block
          (arg value)
          (arg .stated)
          (arg
            (call (. program store-atom)
              (block
                (arg
                  (paragraph
                    "A style value that reads StyleSheet slots may read no local, member, style or tracked value; read a slot as \"\$name\" to compute with one"
                  )
                )
              )
            )
          )
        )
      )
      (return false)
    )
    (if (not (call demand-themed-runtime))
      (call decline statement)
      (return false)
    )
    (let place (call (. facts note-themed-value) module statement instance (. property type) number))
    (let declaration
      (call StyleDeclaration
        (block
          (arg instance)
          (arg element)
          (arg statement)
          (arg (. ([] (. facts style-uses) index) type))
          (arg position)
          (arg layer)
          (arg order)
          (arg false)
        )
      )
    )
    (= (. declaration themed) place)
    (call (. facts add-style-declaration) declaration)
    (return true)
  )
  (fn-do _ demand-themed-runtime Bool
    (let runtime (. facts style-runtime))
    (if (!= (. runtime site-themed) no-instance)
      (return true)
    )
    (if (not (call demand-sheet-declarations))
      (return false)
    )
    (= runtime (. facts style-runtime))
    (let module-id (. (call class-ref types (call (. types type-row) .style)) module))
    (let info (call (. types well-known-type) "core/style" "StyleInfo"))
    (let sheet (call (. types well-known-type) "core/style" "StyleSheetInfo"))
    (let record (call (. types well-known-type) "core/style" "StyleSheetRecord"))
    (let maker (call (. types well-known-type) "core/style" "StyleThemedMaker"))
    (let made (call (. types well-known-type) "core/style" "StyleOptionalBits"))
    (if (or info-missing (== record invalid-type) (== maker invalid-type) (== made invalid-type))
      (return false)
    )
    (lazy info-missing (or (== info invalid-type) (== sheet invalid-type)))
    (= (. runtime themed-made) made)
    (let mark (. scratch types mark))
    (call (. scratch types push) (. types size-type))
    (call (. scratch types push) info)
    (call (. scratch types push) (. types size-type))
    (call (. scratch types push) (call (. types type-row) .uint32))
    (call (. scratch types push) (call (. types type-row) .uint32))
    (call (. scratch types push) sheet)
    (call (. scratch types push) (. types size-type))
    (call (. scratch types push) maker)
    (= (. runtime site-themed)
      (call (. calls demand-runtime-call)
        (block
          (arg module-id)
          (arg no-type)
          (arg (call (. program store-atom) "style-template-site-themed"))
          (arg mark)
        )
      )
    )
    (call (. scratch types rewind) mark)
    (call (. scratch types push) record)
    (call (. scratch types push) (. types size-type))
    (= (. runtime themed-slot)
      (call (. calls demand-runtime-call)
        (block
          (arg module-id)
          (arg no-type)
          (arg (call (. program store-atom) "style-themed-slot"))
          (arg mark)
        )
      )
    )
    (= (. runtime themed-none)
      (call (. calls demand-runtime-call)
        (block
          (arg module-id)
          (arg no-type)
          (arg (call (. program store-atom) "style-themed-none"))
          (arg mark)
        )
      )
    )
    (call (. scratch types rewind) mark)
    (= (. facts style-runtime) runtime)
    (return
      (scope (and themed-ready (!= (. runtime themed-none) no-instance))
        (lazy themed-ready (and (!= (. runtime site-themed) no-instance) (!= (. runtime themed-slot) no-instance)))
      )
    )
  )
  (fn-do _ demand-family-runtime Bool
    (let runtime (. facts style-runtime))
    (if (!= (. runtime site-family) no-instance)
      (return true)
    )
    (if (not (call demand-sheet-declarations))
      (return false)
    )
    (= runtime (. facts style-runtime))
    (let module-id (. (call class-ref types (call (. types type-row) .style)) module))
    (let sheet (call (. types well-known-type) "core/style" "StyleSheetInfo"))
    (if (== sheet invalid-type)
      (return false)
    )
    (let mark (. scratch types mark))
    (call (. scratch types push) (. types size-type))
    (call (. scratch types push) sheet)
    (call (. scratch types push) (call (. types type-row) .uint64))
    (= (. runtime site-family)
      (call (. calls demand-runtime-call)
        (block
          (arg module-id)
          (arg no-type)
          (arg (call (. program store-atom) "style-template-site-family"))
          (arg mark)
        )
      )
    )
    (call (. scratch types rewind) mark)
    (call (. scratch types push) (. types size-type))
    (= (. runtime site-family-end)
      (call (. calls demand-runtime-call)
        (block
          (arg module-id)
          (arg no-type)
          (arg (call (. program store-atom) "style-template-site-family-end"))
          (arg mark)
        )
      )
    )
    (call (. scratch types rewind) mark)
    (= (. facts style-runtime) runtime)
    (return (and (!= (. runtime site-family) no-instance) (!= (. runtime site-family-end) no-instance)))
  )
  (fn-do _ declare-slot U32
    (param statement SyntaxId)
    (param element SyntaxId)
    (param index U32)
    (param position U32)
    (param layer U32)
    (param order U32)
    (param value SyntaxId)
    (param name Atom)
    (param found TypeId)
    ; Records a declaration that takes its value from a slot of a style sheet (`slot-binding`).
    ; Answers as `declare-sheet-slot` does.
    (if (== layer (. U32 max))
      (call decline statement)
      (return 2)
    )
    (let (tuple number offset projection)
      (call slot-binding
        (block
          (arg module)
          (arg statement)
          (arg position)
          (arg value)
          (arg name)
          (arg found)
          (arg statement)
        )
      )
    )
    (if (== number (. U32 max))
      (return 2)
    )
    (call (. facts add-style-declaration)
      (block
        (arg
          (call StyleDeclaration
            (block
              (arg instance)
              (arg element)
              (arg statement)
              (arg (. ([] (. facts style-uses) index) type))
              (arg position)
              (arg layer)
              (arg order)
              (arg true)
              (arg false)
              (arg false)
              (arg number)
              (arg offset)
              (arg projection)
            )
          )
        )
      )
    )
    (return 1)
  )
  (fn-do _ slot-binding (tuple U32 U32 U32)
    (param owner ModuleId)
    (param statement SyntaxId)
    (param position U32)
    (param value SyntaxId)
    (param name Atom)
    (param found TypeId)
    (param at SyntaxId)
    ; The number of the style sheet whose slot of a name a declaration of a style property takes
    ; its value from, written at `statement` in a module, the slot's place among the sheet's, and
    ; how its bits become the property's where their types differ (`sheet-projection`), or
    ; `U32.max`; with the reference's errors where they cannot, and declined at `at`. The number is
    ; `U32.max` where it is reported or declined.
    (let number (call sheet-index (call family-root found) owner statement at))
    (if (== number (. U32 max))
      (return (tuple (. U32 max) 0 0))
    )
    (let use ([] (. facts style-sheet-uses) number))
    (let offset 0u32)
    (while (and (< offset (. use count)) (!= (. ([] (. facts sheet-slots) (+ (. use first) offset)) name) name))
      (+= offset 1)
    )
    (let property ([] (. facts style-properties) position))
    (if (or (== offset (. use count)) (not (call demand-style-sites)) (not (call demand-sheet-declarations)))
      (call decline at)
      (return (tuple (. U32 max) 0 0))
    )
    (let slot ([] (. facts sheet-slots) (+ (. use first) offset)))
    (let projection (. U32 max))
    (if (!= (. slot type) (. property type))
      (if (not (call relation-legal (call (. relations compare) (. slot type) (. property type) false false null owner)))
        (call report-at
          (block
            (arg owner)
            (arg value)
            (arg
              (paragraph
                (str "StyleSheet slot \"" (. name text) "\" has type " (call type-display types (. slot type)) ", which cannot be converted to style property \"" (. property name text) "\" type " (call type-display types (. property type)))
              )
            )
          )
        )
        (call (. facts mention-types) (list (. slot type) (. property type)))
        (return (tuple (. U32 max) 0 0))
      )
      (= projection (call sheet-projection (. slot type) (. property type)))
      (if (== projection (- (. U32 max) 1))
        (let shown (call type-display types (. property type)))
        (call report-at
          (block
            (arg owner)
            (arg value)
            (arg
              (paragraph
                (str "StyleSheet slot \"" (. name text) "\" can convert to " shown ", but not as a zero-allocation style-sheet projection; declare the slot as " shown " or assign a concrete value.")
              )
            )
          )
        )
        (call (. facts mention-types) (list (. property type)))
        (return (tuple (. U32 max) 0 0))
      )
      (if (== projection (. U32 max))
        (call decline at)
        (return (tuple (. U32 max) 0 0))
      )
    )
    (return (tuple number offset projection))
  )
  (fn-do _ sheet-projection U32
    (param source TypeId)
    (param target TypeId)
    ; How the runtime makes the bits of a style property's value of those of a slot of a style sheet
    ; of another type, as the reference's `styleSheetProjectionPlan` says, recorded among
    ; `style-projections`: where the slot is no optional or the property is one, the bits of what an
    ; optional slot holds are copied where the property's type takes them as they are, or wrapped as
    ; the case of a union the property holds that takes them so (`reusable-case`), or of a union slot
    ; whose every case's value a case of the property's union takes so, given that case's number
    ; (`style-projection-union-remap`), whose table program tables number in source order
    ; (`ProgramTables.remap-number`). A case wraps the slot's bits only where they fit above its
    ; number: a whole number of at most 32 bits, or a handle; not a wider number such as a float.
    ; `U32.max - 1` where there is no such way, the reference's error.
    (if (and (call (. types is-optional) source) (not (call (. types is-optional) target)))
      (return (- (. U32 max) 1))
    )
    (let held (if-expr (call (. types is-optional) source) (call (. types optional-inner) source) source))
    (let wanted (if-expr (call (. types is-optional) target) (call (. types optional-inner) target) target))
    (let preserves (and (call (. types is-optional) source) (call (. types is-optional) target)))
    (if (not (call demand-sheet-projections))
      (return (. U32 max))
    )
    (let index (as (. facts style-projections length) U32))
    (if (call reuses-style-bits held wanted)
      (+= (. facts style-projections) (call StyleProjection 0 0 preserves))
      (return index)
    )
    (if (!= (call (. types intrinsic-of) wanted) .union)
      (return (- (. U32 max) 1))
    )
    (let found (call reusable-case held wanted))
    (if (!= found (. U32 max))
      (let payload (. ([] (call (. types cases-of) wanted) found) type))
      (if (and (not (call inline-style-case payload)) (not (call holds-handle payload)))
        (return (- (. U32 max) 1))
      )
      (+= (. facts style-projections) (call StyleProjection 1 found preserves))
      (return index)
    )
    (if (== (call (. types intrinsic-of) held) .union)
      (let sources (call (. types cases-of) held))
      (let first (as (. facts projection-tags length) U32))
      (for (in position (..< 0 (. sources length)))
        (let item ([] sources position))
        (let tag (if-expr (. item is-default) (. U32 max) (call reusable-case (. item type) wanted)))
        (if (== tag (. U32 max))
          (-= ([] (. facts projection-tags) (..< first (. facts projection-tags length))))
          (return (- (. U32 max) 1))
        )
        (+= (. facts projection-tags) tag)
      )
      (+= (. facts style-projections)
        (call StyleProjection
          (block
            (arg 2)
            (arg (as (. sources length) U32))
            (arg preserves)
            (arg first)
            (arg (as (. sources length) U32))
          )
        )
      )
      (return index)
    )
    (return (- (. U32 max) 1))
  )
  (fn-expr _ reuses-style-bits Bool
    (param source TypeId)
    (param target TypeId)
    ; Whether the bits of a style value of one type are those of another's, as the reference's
    ; `styleProjectionCanReusePayloadBits` says: the same type, or an object of a class below the
    ; other's.
    (case? (== source target)
      true
    )
    (default
      (and both-classes (call in-base-chain types source target))
    )
    (where
      (lazy both-classes (and (== (call (. types intrinsic-of) source) .class) (== (call (. types intrinsic-of) target) .class)))
    )
  )
  (fn-do _ reusable-case U32
    (param source TypeId)
    (param union TypeId)
    ; The case of a union whose value takes the bits of a style value of another type as they are,
    ; as the reference's `styleProjectionReusableUnionCase` chooses it: one of the same type before
    ; one of a class above it, the first of each. None where no case does.
    (let found (. U32 max))
    (let cases (call (. types cases-of) union))
    (for (in index (..< 0 (. cases length)))
      (let item ([] cases index))
      (if (or (. item is-default) (== (. item type) no-type) (== (. item type) (. types void-type)))
        (continue)
      )
      (if (== (. item type) source)
        (return (as index U32))
      )
      (if (and (== found (. U32 max)) (call reuses-style-bits source (. item type)))
        (= found (as index U32))
      )
    )
    (return found)
  )
  (fn-do _ demand-sheet-projections Bool
    ; The function of the style runtime that declares the slot of a style sheet as a style's value of
    ; another type for a site, typed once.
    (let runtime (. facts style-runtime))
    (if (!= (. runtime site-projected) no-instance)
      (return true)
    )
    (let module-id (. (call class-ref types (call (. types type-row) .style)) module))
    (let info (call (. types well-known-type) "core/style" "StyleInfo"))
    (let sheet (call (. types well-known-type) "core/style" "StyleSheetInfo"))
    (let tags (call (. types well-known-type-of) "core" "ConstArray" (call (. types type-row) .uint8)))
    (if (== tags invalid-type)
      (return false)
    )
    (let remap (call (. types optional-of) tags))
    (let mark (. scratch types mark))
    (call (. scratch types push) (. types size-type))
    (call (. scratch types push) info)
    (call (. scratch types push) (. types size-type))
    (call (. scratch types push) (call (. types type-row) .uint32))
    (call (. scratch types push) (call (. types type-row) .uint32))
    (call (. scratch types push) sheet)
    (call (. scratch types push) (. types size-type))
    (call (. scratch types push) (call (. types type-row) .uint32))
    (call (. scratch types push) (call (. types type-row) .int64))
    (call (. scratch types push) (. types size-type))
    (call (. scratch types push) (. types bool-type))
    (call (. scratch types push) remap)
    (= (. runtime site-projected)
      (call (. calls demand-runtime-call)
        (block
          (arg module-id)
          (arg no-type)
          (arg (call (. program store-atom) "style-template-site-style-sheet-projected"))
          (arg mark)
        )
      )
    )
    (call (. scratch types rewind) mark)
    (= (. runtime remap-tags) remap)
    (= (. facts style-runtime) runtime)
    (return (!= (. runtime site-projected) no-instance))
  )
  (fn-do _ slot-domains U32
    (param ref DeclRef)
    (param name Atom)
    (param home ModuleId)
    (param site SyntaxId)
    (let owner ([] (. program modules) (. ref module)))
    (let mask 0u32)
    (match? ([] (. owner decls) (. ref decl))
      (case (call .decl-class declared)
        (for (in member ([] (. owner member-pool) (. declared members)))
          (match? ([] (. owner decls) member)
            (case (call .decl-style-domains domains)
              (match? ([] (. owner tree nodes) (. domains syntax))
                (case (call .node-style-annotation row)
                  (if (== (call (. owner tree identifier-name) (. row left)) name)
                    (for (in item ([] (. owner tree children) (. row domains)))
                      (match? ([] (. owner tree nodes) item)
                        (case (call .node-style-domain-item domain)
                          (let named (call (. owner tree identifier-name) (. domain domain)))
                          (if (and named (== (. domain target) 0))
                            (let index
                              (call style-domain
                                (block
                                  (arg named)
                                  (arg home)
                                  (arg site)
                                  (arg (. ref module))
                                  (arg item)
                                )
                              )
                            )
                            (if (< index 32)
                              (= mask (/or/ mask (/lshift/ 1u32 (as index Size))))
                            )
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
    (return mask)
  )
  (fn-do + check-sheet-domains _
    (param index DeclId)
    (param class ClassDecl)
    (let mark (. scratch types mark))
    (let sheet (call (. types intern-class) module index mark))
    (call (. types complete) sheet)
    (let base (?? (call (. types base-of) sheet) no-type))
    (for (in member ([] (. ([] (. program modules) module) member-pool) (. class members)))
      (match? ([] (. ([] (. program modules) module) decls) member)
        (case (call .decl-style-domains domains)
          (match? ([] (. tree nodes) (. domains syntax))
            (case (call .node-style-annotation row)
              (let name (call (. tree identifier-name) (. row left)))
              (if (call is-sheet-type base)
                (call (. frame diagnose)
                  (block
                    (arg (. domains syntax))
                    (arg .stated)
                    (arg
                      (call (. program store-atom)
                        (block
                          (arg
                            (paragraph
                              (str "Derived StyleSheet \"" (. class name text) "\" names no domains; its slots raise those " (call type-short-name types (call family-root sheet)) " names")
                            )
                          )
                        )
                      )
                    )
                  )
                )
                (else-if (or (not name) (not (call sheet-has-slot sheet name)))
                  (call (. frame diagnose)
                    (block
                      (arg (. row left))
                      (arg .stated)
                      (arg
                        (call (. program store-atom)
                          (block
                            (arg
                              (paragraph
                                (str "StyleSheet slot \"" (if-expr name (. name text) "") "\" does not exist")
                              )
                            )
                          )
                        )
                      )
                    )
                  )
                )
                (else
                  (for (in item ([] (. tree children) (. row domains)))
                    (match? ([] (. tree nodes) item)
                      (case (call .node-style-domain-item domain)
                        (if (!= (. domain target) 0)
                          (call (. frame diagnose)
                            (block
                              (arg (. domain target))
                              (arg .stated)
                              (arg
                                (call (. program store-atom)
                                  (block
                                    (arg
                                      (paragraph
                                        "A StyleSheet slot raises its domains on the node that reads it, so they name no target"
                                      )
                                    )
                                  )
                                )
                              )
                            )
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )
  (fn-do _ sheet-index U32
    (param sheet TypeId)
    (param home ModuleId)
    (param site SyntaxId)
    (param at SyntaxId)
    ; The number of a style sheet among those the program registers, given when a declaration
    ; first takes a value from one of its slots, with its slots in the order the sheet declares
    ; them, each kept in a stored property of the object its constructor makes and becoming bits as
    ; a property of a style does; or none where it is declined, at `at`. The declaration is written
    ; at `site` in a module, and is noted as the instance's use of the sheet (`note-style-user`). Its
    ; constructor takes nothing.
    (for (in position (..< 0 (. facts style-sheet-uses length)))
      (if (== (. ([] (. facts style-sheet-uses) position) type) sheet)
        (+= (. facts lookups) 1)
        (call place-sheet-domains sheet home site)
        (call note-style-user sheet home site false)
        (return (as position U32))
      )
    )
    (let ref (call class-ref types sheet))
    (let owner ([] (. program modules) (. ref module)))
    (let first (as (. facts sheet-slots length) U32))
    (match? ([] (. owner decls) (. ref decl))
      (case (call .decl-class declared)
        (for (in member ([] (. owner member-pool) (. declared members)))
          (match? ([] (. owner decls) member)
            (case (call .decl-property property)
              (if (not (. property name))
                (continue)
              )
              (let named (. property name))
              (let seen false)
              (let start Size first)
              (for (in place (..< start (. facts sheet-slots length)))
                (if (== (. ([] (. facts sheet-slots) place) name) named)
                  (= seen true)
                )
              )
              (if seen
                (continue)
              )
              (let found (call property-named sheet named))
              (if (not found)
                (call decline at)
                (return (. U32 max))
              )
              (let row ([] (. types properties) found))
              (let declared-type
                (scope (if-expr untyped (call demand-member row sheet named) (. row type))
                  (lazy untyped (== (. row type) no-type))
                )
              )
              (if (or (!= (. row storage-kind) .storage-eager) unresolved)
                (call decline at)
                (return (. U32 max))
              )
              (lazy unresolved (or (== declared-type invalid-type) (== declared-type no-type)))
              (let flags (call sheet-slot-flags declared-type))
              (if (== flags (. U32 max))
                (call decline at)
                (return (. U32 max))
              )
              (+= (. facts sheet-slots)
                (call SheetSlot
                  (block
                    (arg named)
                    (arg declared-type)
                    (arg (. row slot))
                    (arg flags)
                    (arg (call slot-domains ref named home site))
                  )
                )
              )
            )
          )
        )
      )
    )
    (let mark (. scratch types mark))
    (let singleton (call (. calls demand-constructor) sheet mark))
    (let last (as (. facts sheet-slots length) U32))
    (if (or (== singleton no-instance) (not (call demand-sheet-runtime)) (not (call demand-sheet-members sheet first last)))
      (call decline at)
      (return (. U32 max))
    )
    (let index (as (. facts style-sheet-uses length) U32))
    (+= (. facts style-sheet-uses) (call StyleSheetUse sheet singleton first (- last first)))
    (call note-style-user sheet home site false)
    (return index)
  )
  (fn-do _ place-sheet-domains _
    (param sheet TypeId)
    (param home ModuleId)
    (param site SyntaxId)
    ; Places the domains the slots of a style sheet name, as a later use of the sheet at `site` in
    ; `home` names each (`place-style-domain`) as its first use does (`slot-domains`), so that the
    ; places noted do not depend on which instance used the sheet first.
    (let ref (call class-ref types sheet))
    (let owner ([] (. program modules) (. ref module)))
    (match? ([] (. owner decls) (. ref decl))
      (case (call .decl-class declared)
        (for (in member ([] (. owner member-pool) (. declared members)))
          (match? ([] (. owner decls) member)
            (case (call .decl-style-domains domains)
              (match? ([] (. owner tree nodes) (. domains syntax))
                (case (call .node-style-annotation row)
                  (for (in item ([] (. owner tree children) (. row domains)))
                    (match? ([] (. owner tree nodes) item)
                      (case (call .node-style-domain-item domain)
                        (let named (call (. owner tree identifier-name) (. domain domain)))
                        (if (and named (== (. domain target) 0))
                          (call place-style-domain named home site (. ref module) item)
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )
  (fn-do _ demand-sheet-members Bool
    (param sheet TypeId)
    (param first U32)
    (param last U32)
    (call list-derived-sheets)
    (for (in derived (. facts derived-sheets))
      (if (!= (call family-root derived) sheet)
        (continue)
      )
      (let start (as (. facts sheet-member-slots length) U32))
      (let level derived)
      (while true
        (let ref (call class-ref types level))
        (let owner ([] (. program modules) (. ref module)))
        (match? ([] (. owner decls) (. ref decl))
          (case (call .decl-class declared)
            (for (in member ([] (. owner member-pool) (. declared members)))
              (match? ([] (. owner decls) member)
                (case (call .decl-property property)
                  (let named (. property name))
                  (if (and named (or (!= level sheet) (and (!= (. property value) 0) slot-reads)))
                    (call add-member-slot named start first last)
                  )
                  (lazy slot-reads (call reads-sheet-slots (. owner tree) (. property value) sheet))
                )
              )
            )
          )
        )
        (if (== level sheet)
          (break)
        )
        (= level (?? (call (. types base-of) level) sheet))
      )
      (let mark (. scratch types mark))
      (let singleton (call (. calls demand-constructor) derived mark))
      (if (or (== singleton no-instance) (not (call demand-sheet-member-runtime)))
        (return false)
      )
      (+= (. facts sheet-members)
        (call SheetMember
          (block
            (arg sheet)
            (arg derived)
            (arg singleton)
            (arg start)
            (arg (- (as (. facts sheet-member-slots length) U32) start))
          )
        )
      )
    )
    (return true)
  )
  (fn-do _ reads-sheet-slots Bool
    (param written AST)
    (param value SyntaxId)
    (param sheet TypeId)
    (for (in node (.. (call (. written subtree-start) value) value))
      (match? ([] (. written nodes) node)
        (case (call .node-identifier row)
          (if (or (== (. row name text) "this") (call sheet-has-slot sheet (. row name)))
            (return true)
          )
        )
      )
    )
    (return false)
  )
  (fn-do _ add-member-slot _
    (param name Atom)
    (param start U32)
    (param first U32)
    (param last U32)
    (for (in place (..< first last))
      (if (== (. ([] (. facts sheet-slots) place) name) name)
        (let offset (- place first))
        (for (in held (..< (as start Size) (. facts sheet-member-slots length)))
          (if (== ([] (. facts sheet-member-slots) held) offset)
            (return)
          )
        )
        (+= (. facts sheet-member-slots) offset)
        (return)
      )
    )
  )
  (fn-do _ demand-sheet-member-runtime Bool
    (let runtime (. facts style-runtime))
    (if (!= (. runtime sheet-member-slot) no-instance)
      (return true)
    )
    (let module-id (. (call class-ref types (call (. types type-row) .style)) module))
    (let info (call (. types well-known-type) "core/style" "StyleSheetInfo"))
    (let record (call (. types well-known-type) "core/style" "StyleSheetRecord"))
    (if (or (== info invalid-type) (== record invalid-type))
      (return false)
    )
    (let mark (. scratch types mark))
    (call (. scratch types push) info)
    (call (. scratch types push) (. types string-type))
    (call (. scratch types push) (. types string-type))
    (call (. scratch types push) (call (. types type-row) .uint32))
    (call (. scratch types push) (call (. types type-row) .uint32))
    (= (. runtime sheet-register-member)
      (call (. calls demand-runtime-call)
        (block
          (arg module-id)
          (arg no-type)
          (arg (call (. program store-atom) "style-sheet-register-member"))
          (arg mark)
        )
      )
    )
    (call (. scratch types rewind) mark)
    (call (. scratch types push) record)
    (call (. scratch types push) (. types size-type))
    (call (. scratch types push) (call (. types type-row) .int64))
    (call (. scratch types push) (. types bool-type))
    (= (. runtime sheet-member-slot)
      (call (. calls demand-runtime-call)
        (block
          (arg module-id)
          (arg no-type)
          (arg (call (. program store-atom) "style-sheet-member-slot"))
          (arg mark)
        )
      )
    )
    (call (. scratch types rewind) mark)
    (call (. scratch types push) record)
    (call (. scratch types push) (. types string-type))
    (= (. runtime sheet-member-tag)
      (call (. calls demand-runtime-call)
        (block
          (arg module-id)
          (arg no-type)
          (arg (call (. program store-atom) "style-sheet-member-tag"))
          (arg mark)
        )
      )
    )
    (call (. scratch types rewind) mark)
    (= (. facts style-runtime) runtime)
    (return
      (scope (and registers (!= (. runtime sheet-member-slot) no-instance) (!= (. runtime sheet-member-tag) no-instance))
        (lazy registers (!= (. runtime sheet-register-member) no-instance))
      )
    )
  )
  (fn-do _ sheet-slot-flags U32
    (param type TypeId)
    ; How the bits of a slot of a style sheet are flagged, as the reference's `styleEncodedFlagBits`
    ; says: 2 where they encode a value of a union, or one boxed, else 0; the values are made bits
    ; as those of a style's properties are. None for a type that has no such bits.
    (let held (if-expr (call (. types is-optional) type) (call (. types optional-inner) type) type))
    (let kind (call (. types intrinsic-of) held))
    (if (== kind .union)
      (for (in item (call (. types cases-of) held))
        (if (== (call style-case (. item type)) (. U32 max))
          (return (. U32 max))
        )
      )
      (return 2)
    )
    (if (and (call intrinsic-is-numeric kind) (!= kind .cpointer) (!= kind .number))
      (return 0)
    )
    (if (== kind .class)
      (return (if-expr (call demand-style-coding held true) 0 (. U32 max)))
    )
    (if (call boxed-style kind)
      (return (if-expr (call demand-style-coding held false) 2 (. U32 max)))
    )
    (return (. U32 max))
  )
  (fn-do _ demand-sheet-runtime Bool
    ; The functions of the style runtime that registering style sheets calls, typed once.
    (let runtime (. facts style-runtime))
    (if (!= (. runtime sheet-register) no-instance)
      (return true)
    )
    (if (or (not (call demand-style-runtime)) (not (call demand-style-sites)))
      (return false)
    )
    (= runtime (. facts style-runtime))
    (let module-id (. (call class-ref types (call (. types type-row) .style)) module))
    (let info (call (. types well-known-type) "core/style" "StyleSheetInfo"))
    (if (== info invalid-type)
      (return false)
    )
    (let mark (. scratch types mark))
    (call (. scratch types push) (. types string-type))
    (= (. runtime sheet-info-for)
      (call (. calls demand-runtime-call)
        (block
          (arg module-id)
          (arg no-type)
          (arg (call (. program store-atom) "style-sheet-info-for"))
          (arg mark)
        )
      )
    )
    (call (. scratch types push) (. types string-type))
    (call (. scratch types push) (. types size-type))
    (= (. runtime sheet-info) (call (. calls demand-constructor) info mark))
    (call (. scratch types rewind) mark)
    (call (. scratch types push) info)
    (call (. scratch types push) (. types size-type))
    (call (. scratch types push) (. types string-type))
    (call (. scratch types push) (call (. types type-row) .int64))
    (call (. scratch types push) (. types bool-type))
    (call (. scratch types push) (call (. types type-row) .uint32))
    (call (. scratch types push) (call (. types type-row) .uint32))
    (= (. runtime sheet-register-slot)
      (call (. calls demand-runtime-call)
        (block
          (arg module-id)
          (arg no-type)
          (arg (call (. program store-atom) "style-sheet-register-slot"))
          (arg mark)
        )
      )
    )
    (call (. scratch types rewind) mark)
    (call (. scratch types push) info)
    (call (. scratch types push) (call (. types type-row) .int64))
    (= (. runtime sheet-register)
      (call (. calls demand-runtime-call)
        (block
          (arg module-id)
          (arg no-type)
          (arg (call (. program store-atom) "style-sheet-register"))
          (arg mark)
        )
      )
    )
    (call (. scratch types rewind) mark)
    (call (. scratch types push) (. types index-type))
    (= (. runtime sheet-info-required)
      (call (. calls demand-runtime-call)
        (block
          (arg module-id)
          (arg no-type)
          (arg (call (. program store-atom) "style-sheet-info-required"))
          (arg mark)
        )
      )
    )
    (call (. scratch types rewind) mark)
    (= (. facts style-runtime) runtime)
    (return (and (!= (. runtime sheet-info-for) no-instance) (!= (. runtime sheet-info) no-instance) (!= (. runtime sheet-register-slot) no-instance) (!= (. runtime sheet-register) no-instance) (!= (. runtime sheet-info-required) no-instance)))
  )
  (fn-do _ demand-sheet-declarations Bool
    ; The function of the style runtime that declares the slot of a style sheet as a style's value
    ; for a site, typed once.
    (let runtime (. facts style-runtime))
    (if (!= (. runtime site-sheet) no-instance)
      (return true)
    )
    (let module-id (. (call class-ref types (call (. types type-row) .style)) module))
    (let info (call (. types well-known-type) "core/style" "StyleInfo"))
    (let sheet (call (. types well-known-type) "core/style" "StyleSheetInfo"))
    (let mark (. scratch types mark))
    (call (. scratch types push) (. types size-type))
    (call (. scratch types push) info)
    (call (. scratch types push) (. types size-type))
    (call (. scratch types push) (call (. types type-row) .uint32))
    (call (. scratch types push) (call (. types type-row) .uint32))
    (call (. scratch types push) sheet)
    (call (. scratch types push) (. types size-type))
    (= (. runtime site-sheet)
      (call (. calls demand-runtime-call)
        (block
          (arg module-id)
          (arg no-type)
          (arg (call (. program store-atom) "style-template-site-style-sheet"))
          (arg mark)
        )
      )
    )
    (call (. scratch types rewind) mark)
    (= (. facts style-runtime) runtime)
    (return (!= (. runtime site-sheet) no-instance))
  )
  (fn-do _ distinct-style Bool
    (param index U32)
    (param visible (list TypeId))
    (param owner ModuleId)
    (param written SyntaxId)
    (param site SyntaxId)
    ; Whether no property of a style is one a style seen before it names, which is reported.
    (let use ([] (. facts style-uses) index))
    (for (in position (..< (. use first) (+ (. use first) (. use count))))
      (let name (. ([] (. facts style-properties) position) name))
      (for (in other visible)
        (for (in seen (. facts style-uses))
          (if (!= (. seen type) other)
            (continue)
          )
          (for (in place (..< (. seen first) (+ (. seen first) (. seen count))))
            (if (== (. ([] (. facts style-properties) place) name) name)
              (if (!= owner module)
                (call decline site)
                (else
                  (let message
                    (paragraph
                      (str "Style property \"" (. name text) "\" is declared by both " (call type-short-name types other) " and " (call type-short-name types (. use type)))
                    )
                  )
                  (call (. frame diagnose) written .stated (call (. program store-atom) message))
                )
              )
              (return false)
            )
          )
        )
      )
    )
    (return true)
  )
  (fn-do _ style-index U32
    (param used TypeId)
    (param site SyntaxId)
    (param constructs Bool)
    ; The number of a style among those the program registers, given when it is first used, with
    ; its properties, base first, each kept in a stored property of the object its constructor
    ; makes; or none where the style is declined or reported. Each use is noted as the instance's,
    ; a constructor that `constructs` with it or a line that declares with it (`note-style-user`).
    ; A line of a style that names the domains a change to a property raises numbers each domain as
    ; it is first named, and each use names it (`place-style-domains`). The type of a property
    ; says how its value becomes the bits of a slot: a number is cast, an object is interned, a value
    ; of a union is its case's number below the bits its case's value becomes, and any other value is
    ; boxed and the box interned. Each use notes the codings of the properties
    ; (`note-style-codings`), so that what the instance records is the same whichever instance
    ; registered the style.
    (for (in position (..< 0 (. facts style-uses length)))
      (if (== (. ([] (. facts style-uses) position) type) used)
        (call place-style-domains used site)
        (call note-style-codings ([] (. facts style-uses) position))
        (call note-style-user used module site constructs)
        (return (as position U32))
      )
    )
    (let chain (list TypeId))
    (let level (? TypeId) used)
    (while (and level (== (call (. types intrinsic-of) level) .style) (!= level (call (. types type-row) .style)))
      (+= chain level)
      (= level (call (. types base-of) level))
    )
    (let first (as (. facts style-properties length) U32))
    (for (in position (..< 0 (. chain length)))
      (let ref (call class-ref types ([] chain (- (. chain length) 1 position))))
      (let owner ([] (. program modules) (. ref module)))
      (let members (call (of RowRange DeclId)))
      (match? ([] (. owner decls) (. ref decl))
        (case (call .decl-class class)
          (= members (. class members))
        )
      )
      (for (in member ([] (. owner member-pool) members))
        (match? ([] (. owner decls) member)
          (case (call .decl-property property)
            (if (and (. property name) plain-member (== (call style-property first (. property name)) (. U32 max)))
              (if (not (call add-style-property used property (. ref module) site))
                (return (. U32 max))
              )
            )
            (lazy plain-member (and (not (. property defaults-root)) (== (. property element) 0)))
          )
        )
      )
      (for (in member ([] (. owner member-pool) members))
        (match? ([] (. owner decls) member)
          (case (call .decl-style-domains domains)
            (if (not (call add-style-domains first (. owner tree) (. domains syntax) (. ref module) site))
              (return (. U32 max))
            )
          )
        )
      )
    )
    (let mark (. scratch types mark))
    (let singleton (call (. calls demand-constructor) used mark))
    (if (or (== singleton no-instance) (not (call demand-style-runtime)))
      (call decline site)
      (return (. U32 max))
    )
    (let index (as (. facts style-uses length) U32))
    (let last (as (. facts style-properties length) U32))
    (+= (. facts style-uses) (call StyleUse used singleton first (- last first)))
    (call note-style-user used module site constructs)
    (return index)
  )
  (fn-do _ note-style-user _
    (param used TypeId)
    (param home ModuleId)
    (param site SyntaxId)
    (param constructs Bool)
    ; Notes that the instance being checked uses a style or a style sheet at a place in a module,
    ; keeping the first such place, a constructor's before any other, among those it noted last.
    (let position (. facts style-users length))
    (while (and (> position 0) (== (. ([] (. facts style-users) (- position 1)) instance) instance))
      (-= position 1)
      (let user ([] (. facts style-users) position))
      (if (== (. user type) used)
        (if (or (and (== constructs (. user constructed)) comes-first) (and constructs (not (. user constructed))))
          (= ([] (. facts style-users) position) (call StyleUser used instance home site constructs))
        )
        (lazy comes-first (call precedes home site (. user module) (. user site)))
        (return)
      )
    )
    (+= (. facts style-users) (call StyleUser used instance home site constructs))
  )
  (fn-do _ note-style-codings _
    (param use StyleUse)
    ; Notes the instance being checked as using the codings the properties of a registered style
    ; turn values into bits by, as registering them does (`add-style-property`): an object's, a
    ; boxed value's, and those of the cases of a union that have one.
    (for (in position (..< (. use first) (+ (. use first) (. use count))))
      (let declared (. ([] (. facts style-properties) position) type))
      (let held (if-expr (call (. types is-optional) declared) (call (. types optional-inner) declared) declared))
      (let kind (call (. types intrinsic-of) held))
      (if (== kind .union)
        (for (in item (call (. types cases-of) held))
          (call note-coding-user (. item type))
        )
        (else-if (or (== kind .class) (call boxed-style kind))
          (call note-coding-user held)
        )
      )
    )
  )
  (fn-do _ note-coding-user _
    (param type TypeId)
    ; Notes the instance being checked as using the coding of a type, where there is one.
    (for (in coding (. facts style-codings))
      (if (== (. coding type) type)
        (+= (. facts coding-users) (call CodingUser instance type))
        (return)
      )
    )
  )
  (fn-do _ style-property U32
    (param first U32)
    (param name Atom)
    ; The place of a property among those of the style being registered, or none.
    (for (in position (..< first (as (. facts style-properties length) U32)))
      (if (== (. ([] (. facts style-properties) position) name) name)
        (return position)
      )
    )
    (return (. U32 max))
  )
  (fn-do _ add-style-property Bool
    (param used TypeId)
    (param property PropertyDecl)
    (param owner ModuleId)
    (param site SyntaxId)
    ; Adds a property of a style being registered. Its annotation says it is inherited; any other
    ; is reported, as is a type written for it that names nothing, which the reference meets as it
    ; registers. One that is not stored in the object, or whose type has no bits a slot holds,
    ; is declined.
    (let name (!! (. property name)))
    (let found (call property-named used name))
    (if (not found)
      (call decline site)
      (return false)
    )
    (let row ([] (. types properties) found))
    (if (!= (. row storage-kind) .storage-eager)
      (call decline site)
      (return false)
    )
    (let declared (if-expr (== (. row type) no-type) (call demand-member row used name) (. row type)))
    (if (and (== declared invalid-type) (== owner module) (!= (. property type-syntax) 0))
      (let env (call (. types class-env) owner (. property owner)))
      (let reported (call report-missing-type (. property type-syntax) env))
      (call (. types env-release) env)
      (if reported
        (return false)
      )
    )
    (if (or (== declared invalid-type) (== declared no-type))
      (call decline site)
      (return false)
    )
    (let held (if-expr (call (. types is-optional) declared) (call (. types optional-inner) declared) declared))
    (if (== (call (. types intrinsic-of) held) .style)
      (if (!= owner module)
        (call decline site)
        (else
          (let message
            (paragraph
              (str "Style property \"" (. name text) "\" cannot have a Style type; use an object-valued property with an ordinary descriptor class instead")
            )
          )
          (call (. frame diagnose) (. property syntax) .stated (call (. program store-atom) message))
        )
      )
      (return false)
    )
    (let flags 0u32)
    (let written (. ([] (. program modules) owner) tree))
    (match? ([] (. written nodes) (. property syntax))
      (case (call .node-property-syntax row)
        (for (in offset (..< 0 (. row annotations count)))
          (let annotation ([] (. written atoms) (+ (. row annotations start) offset)))
          (if (!= (. annotation text) "inherited")
            (if (!= owner module)
              (call decline site)
              (else
                (let message
                  (paragraph
                    (str "Unknown style property annotation \"@" (. annotation text) "\"; only \"@inherited\" is supported")
                  )
                )
                (call (. frame diagnose) (. property syntax) .stated (call (. program store-atom) message))
              )
            )
            (return false)
          )
          (= flags 1)
        )
      )
    )
    (let shift 0u32)
    (let tags 0u64)
    (let kind (call (. types intrinsic-of) held))
    (if (== kind .union)
      (= shift 8)
      (= flags (/or/ flags 2))
      (let cases (call (. types cases-of) held))
      (for (in index (..< 0 (. cases length)))
        (let coded (call style-case (. ([] cases index) type)))
        (if (== coded (. U32 max))
          (call decline site)
          (return false)
        )
        (if (and (== coded 2) (< index 64))
          (= tags (/or/ tags (/lshift/ 1u64 (as index U64))))
        )
      )
      (else-if (or (call intrinsic-is-numeric kind) (== kind .bool))
        (if (or (== kind .cpointer) (== kind .number))
          (call decline site)
          (return false)
        )
        (if (call intrinsic-is-float kind)
          (= flags (/or/ flags 4))
        )
      )
      (else-if (== kind .class)
        (if (not (call demand-style-coding held true))
          (call decline site)
          (return false)
        )
        (= flags (/or/ flags 8))
      )
      (else-if (call boxed-style kind)
        (= flags (/or/ flags 2))
        (= tags 1)
        (if (not (call demand-style-coding held false))
          (call decline site)
          (return false)
        )
      )
      (else
        (call decline site)
        (return false)
      )
    )
    (+= (. facts style-properties) (call StyleProperty name declared (. row slot) flags shift tags))
    (return true)
  )
  (fn-do _ style-case U32
    (param type TypeId)
    ; How a case of a union a style property holds becomes bits: 0 for a whole number of at most
    ; 32 bits, inline below its case's number, 1 for an object, interned, and 2 for any other
    ; value, boxed. None for one that has no such bits.
    (let kind (call (. types intrinsic-of) type))
    (if (and (call is-integer-kind kind) inline-bits)
      (return 0)
    )
    (lazy inline-bits (and (> (. ([] (. types completions) type) bit-size) 0) (<= (. ([] (. types completions) type) bit-size) 32)))
    (if (== kind .class)
      (return (if-expr (call demand-style-coding type true) 1 (. U32 max)))
    )
    (if (and (call intrinsic-is-numeric kind) (!= kind .cpointer) (!= kind .number))
      (return (if-expr (call demand-style-coding type false) 2 (. U32 max)))
    )
    (if (call boxed-style kind)
      (return (if-expr (call demand-style-coding type false) 2 (. U32 max)))
    )
    (return (. U32 max))
  )
  (fn-do _ demand-style-coding Bool
    (param type TypeId)
    (param object Bool)
    ; Types how values of a type that is no number become bits as styles register: an object by
    ; the runtime's `style-intern-object` for the type, and any other value by the constructor of
    ; its box and the runtime's `style-intern-holder`. The instance typed is noted as using them
    ; (`Facts.coding-users`).
    (for (in coding (. facts style-codings))
      (if (== (. coding type) type)
        (+= (. facts coding-users) (call CodingUser instance type))
        (return true)
      )
    )
    (let runtime (. (call class-ref types (call (. types type-row) .style)) module))
    (let mark (. scratch types mark))
    (if object
      (let taken (call (. types optional-of) type))
      (call (. scratch types push) type)
      (call (. scratch types push) taken)
      (let intern
        (call (. calls demand-runtime-call)
          (block
            (arg runtime)
            (arg no-type)
            (arg (call (. program store-atom) "style-intern-object"))
            (arg mark)
            (arg 1)
          )
        )
      )
      (call (. scratch types rewind) mark)
      (if (== intern no-instance)
        (return false)
      )
      (+= (. facts style-codings) (call StyleCoding type intern no-instance taken))
      (+= (. facts coding-users) (call CodingUser instance type))
      (return true)
    )
    (let box (call (. types well-known-type-of) "core/style" "StyleWideHolder" type))
    (if (== box invalid-type)
      (return false)
    )
    (call (. scratch types push) type)
    (let holder (call (. calls demand-constructor) box mark))
    (call (. scratch types rewind) mark)
    (if (== holder no-instance)
      (return false)
    )
    (if (== (. facts style-runtime intern-holder) no-instance)
      (= (. facts style-runtime held)
        (call (. types optional-of)
          (block
            (arg (call (. types well-known-type) "core/style" "StyleObjectHolder"))
          )
        )
      )
      (call (. scratch types push) (. facts style-runtime held))
      (= (. facts style-runtime intern-holder)
        (call (. calls demand-runtime-call)
          (block
            (arg runtime)
            (arg no-type)
            (arg (call (. program store-atom) "style-intern-holder"))
            (arg mark)
          )
        )
      )
      (call (. scratch types rewind) mark)
      (if (== (. facts style-runtime intern-holder) no-instance)
        (return false)
      )
    )
    (+= (. facts style-codings) (call StyleCoding type no-instance holder))
    (+= (. facts coding-users) (call CodingUser instance type))
    (return true)
  )
  (fn-do _ add-style-domains Bool
    (param first U32)
    (param tree AST)
    (param id SyntaxId)
    (param owner ModuleId)
    (param site SyntaxId)
    ; Adds the domains a line of a style names for one of its properties, each numbered as it is
    ; first named, raised on the node itself, or on its parent where the line says so. A line
    ; naming no property of the style, or a place other than the node or its parent, is reported.
    (match? ([] (. tree nodes) id)
      (case (call .node-style-annotation row)
        (let name (call (. tree identifier-name) (. row left)))
        (let position (if-expr name (call style-property first name) (. U32 max)))
        (if (== position (. U32 max))
          (let message (str "Style property \"" (if-expr name (. name text) "") "\" does not exist"))
          (call report-style id owner site message)
          (return false)
        )
        (for (in item ([] (. tree children) (. row domains)))
          (match? ([] (. tree nodes) item)
            (case (call .node-style-domain-item domain)
              (let domain-name (call (. tree identifier-name) (. domain domain)))
              (let target (only-if (call (. tree identifier-name) (. domain target)) (if (!= (. domain target) 0))))
              (if (not domain-name)
                (call decline site)
                (return false)
              )
              (let index (call style-domain domain-name module site owner item))
              (if (or (not target) (== (. target text) "self"))
                (+= (. facts property-domains) (call PropertyDomain position index false))
                (else-if (== (. target text) "parent")
                  (+= (. facts property-domains) (call PropertyDomain position index true))
                )
                (else
                  (let message
                    (paragraph
                      (str "Unknown style invalidation target \"" (. target text) "\"; expected \"self\" or \"parent\"")
                    )
                  )
                  (call report-style id owner site message)
                  (return false)
                )
              )
            )
          )
        )
        (return true)
      )
    )
    (call decline site)
    (return false)
  )
  (fn-do _ report-style _
    (param id SyntaxId)
    (param owner ModuleId)
    (param site SyntaxId)
    (param message String)
    ; Reports a style written wrong where it is written, or declines the constructor that uses it
    ; where that is in another module.
    (if (!= owner module)
      (call decline site)
      (else
        (call (. frame diagnose) id .stated (call (. program store-atom) message))
      )
    )
  )
  (fn-do + style-domain U32
    (param name Atom)
    (param home ModuleId)
    (param site SyntaxId)
    (param line-module ModuleId)
    (param line SyntaxId)
    ; The place of a domain of invalidation among `style-domains`, made as it is first named. The
    ; instance typed is noted as naming it at `site` in `home` by `line` (`note-domain-user`). The 32
    ; the runtime holds are counted once the program is typed (`Typing.number-domains`).
    (let known (call place-style-domain name home site line-module line))
    (if (!= known (. U32 max))
      (return known)
    )
    (+= (. facts style-domains) (call StyleDomain name))
    (let index (as (- (. facts style-domains length) 1) U32))
    (call note-domain-user index home site line-module line)
    (return index)
  )
  (fn-do _ place-style-domain U32
    (param name Atom)
    (param home ModuleId)
    (param site SyntaxId)
    (param line-module ModuleId)
    (param line SyntaxId)
    ; The number of a domain of invalidation already named, or none. The instance typed is noted as
    ; naming it at `site` in `home` by `line` (`note-domain-user`).
    (for (in position (..< 0 (. facts style-domains length)))
      (if (== (. ([] (. facts style-domains) position) name) name)
        (call note-domain-user (as position U32) home site line-module line)
        (return (as position U32))
      )
    )
    (return (. U32 max))
  )
  (fn-do _ note-domain-user _
    (param domain U32)
    (param home ModuleId)
    (param site SyntaxId)
    (param line-module ModuleId)
    (param line SyntaxId)
    ; Notes that the instance being checked names a domain of invalidation at `site` in `home`, by a
    ; line, keeping the first such place and line (`names-before`) among those it noted last.
    ; Program tables register the domain at the first of those of every instance, so the place is
    ; the same however instances are typed.
    (let user (call DomainUser instance domain home site line-module line))
    (let position (. facts domain-users length))
    (while (and (> position 0) (== (. ([] (. facts domain-users) (- position 1)) instance) instance))
      (-= position 1)
      (if (== (. ([] (. facts domain-users) position) domain) domain)
        (if (call names-before user ([] (. facts domain-users) position))
          (= ([] (. facts domain-users) position) user)
        )
        (return)
      )
    )
    (+= (. facts domain-users) user)
  )
  (fn-expr _ names-before Bool
    (param user DomainUser)
    (param other DomainUser)
    ; Whether an instance names a domain of invalidation before another does: at an earlier place,
    ; or at the same place by an earlier line, each in source order and then by its syntax, as
    ; program tables order the places of domains.
    (case? (or (!= (. user module) (. other module)) (!= (. user site) (. other site)))
      (call placed-before (. user module) (. user site) (. other module) (. other site))
    )
    (default
      (call placed-before (. user line-module) (. user line) (. other line-module) (. other line))
    )
  )
  (fn-expr _ placed-before Bool
    (param module ModuleId)
    (param site SyntaxId)
    (param other-module ModuleId)
    (param other SyntaxId)
    ; Whether a place in the program comes before another in source order (`precedes`), or, where
    ; the two begin together in a module, has the lesser syntax.
    (case? (call precedes module site other-module other)
      true
    )
    (case? (call precedes other-module other module site)
      false
    )
    (default
      (and (== module other-module) (< site other))
    )
  )
  (fn-do _ place-style-domains _
    (param used TypeId)
    (param site SyntaxId)
    ; Places the domains the lines of a style and of the styles above it name, as a use of the style
    ; at `site` names each (`place-style-domain`).
    (let level (? TypeId) used)
    (while (and level (== (call (. types intrinsic-of) level) .style) (!= level (call (. types type-row) .style)))
      (let ref (call class-ref types level))
      (let owner ([] (. program modules) (. ref module)))
      (match? ([] (. owner decls) (. ref decl))
        (case (call .decl-class class)
          (for (in member ([] (. owner member-pool) (. class members)))
            (match? ([] (. owner decls) member)
              (case (call .decl-style-domains domains)
                (match? ([] (. owner tree nodes) (. domains syntax))
                  (case (call .node-style-annotation row)
                    (for (in item ([] (. owner tree children) (. row domains)))
                      (match? ([] (. owner tree nodes) item)
                        (case (call .node-style-domain-item domain)
                          (let name (call (. owner tree identifier-name) (. domain domain)))
                          (if name
                            (call place-style-domain
                              (block
                                (arg name)
                                (arg module)
                                (arg site)
                                (arg (. ref module))
                                (arg item)
                              )
                            )
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
      (= level (call (. types base-of) level))
    )
  )
  (fn-do + style-name (? Atom)
    (param written AST)
    (param id SyntaxId)
    (match? ([] (. written nodes) id)
      (case (call .node-get-expression row)
        (return-if null (if (or (. row is-tracked) (. row is-optional) (. row is-loop))))
        (match? ([] (. written nodes) (. row object))
          (case (call .node-identifier head)
            (return-if (call (. program store-atom) (str (. head name text) "." (. row name text))) (if (not (. head is-tracked))))
          )
        )
        (return null)
      )
    )
    (return (call (. written identifier-name) id))
  )
  (fn-expr + styles-attribute Bool
    (param op Operator)
    (param class TypeId)
    (param name (? Atom))
    ; Whether an attribute of a markup element may name a property of a style rather than one of
    ; the element's class: a plain assignment of a name the class has no property of, where the
    ; style runtime is loaded.
    (case? (or (not name) (!= op .eq-op) (!= (call (. types intrinsic-of) class) .class) generic)
      false
    )
    (default
      (and (not (call property-named class name)) (not (call interface-accessor class name)) (!= (call (. program module-by-name) "core/style") null))
    )
    (where
      (lazy generic (. ([] (. types completions) class) has-variables))
    )
  )
  (fn-do + add-visible-styles Bool
    (param class TypeId)
    (param styles (list TypeId))
    (param site SyntaxId)
    ; Adds to a vocabulary the styles a class sees, each once: those its bases use, base first,
    ; then its own, as the reference's `visibleStyleUsings`, or those an interface and each it
    ; extends use (`add-interface-styles`), or a style sheet uses (`add-sheet-styles`). A using of
    ; a style sheet gives none. One that is wrong is declined or reported, and false. What a class
    ; or a style sheet sees is kept once found (`visible-styles`), and added again as it was, with
    ; the fault the type store gives cleared where reading its usings clears it.
    (if (and (!= class no-type) (== (call (. types intrinsic-of) class) .interface))
      (return (call add-interface-styles class styles site))
    )
    (if (or (== class no-type) (and (!= (call (. types intrinsic-of) class) .class) not-sheet))
      (return true)
    )
    (lazy not-sheet (!= (call (. types intrinsic-of) class) .style-sheet))
    (let known ([] (. scratch visible-styles) class))
    (if known
      (let start (as (/ known 4294967296) Size))
      (let count (as (% (/ known 2) 2147483648) Size))
      (if (== (% known 2) 1)
        (call (. types clear-fault))
      )
      (for (in offset (..< 0 count))
        (let used ([] (. scratch visible-style-list) (+ start offset)))
        (if (== (call (. styles find) used) null)
          (+= styles used)
        )
      )
      (return true)
    )
    (let found (list TypeId))
    (let (tuple kept usings) (call find-visible-styles class found site))
    (for (in used found)
      (if (== (call (. styles find) used) null)
        (+= styles used)
      )
    )
    (if (not kept)
      (return false)
    )
    (let start (as (. scratch visible-style-list length) U64))
    (for (in used found)
      (+= (. scratch visible-style-list) used)
    )
    (= ([] (. scratch visible-styles) class)
      (scope (+ (* start 4294967296) (* found-count 2) (if-expr usings 1 0))
        (lazy found-count (as (. found length) U64))
      )
    )
    (return true)
  )
  (fn-do _ find-visible-styles (tuple Bool Bool)
    (param class TypeId)
    (param styles (list TypeId))
    (param site SyntaxId)
    ; The styles a class or a style sheet sees, each once, as `add-visible-styles` adds them;
    ; whether none was wrong, and whether a using was read.
    (if (== (call (. types intrinsic-of) class) .style-sheet)
      (return (call add-sheet-styles class styles site))
    )
    (let usings false)
    (let chain (list TypeId))
    (let level (? TypeId) class)
    (while (and level (== (call (. types intrinsic-of) level) .class))
      (+= chain level)
      (= level (call (. types base-of) level))
    )
    (for (in position (..< 0 (. chain length)))
      (for (in ref (call sheet-parts (call class-ref types ([] chain (- (. chain length) 1 position)))))
        (let owner ([] (. program modules) (. ref module)))
        (for (in member ([] (. owner member-pool) (call part-members ref)))
          (match? ([] (. owner decls) member)
            (case (call .decl-using using)
              (= usings true)
              (if (!= (call using-sheet ref using) no-type)
                (continue)
              )
              (let used (call using-style ref using site))
              (if (== used no-type)
                (return (tuple false true))
              )
              (if (== (call (. styles find) used) null)
                (+= styles used)
              )
            )
          )
        )
      )
    )
    (return (tuple true usings))
  )
  (fn-do _ add-sheet-styles (tuple Bool Bool)
    (param sheet TypeId)
    (param styles (list TypeId))
    (param site SyntaxId)
    ; Adds to a vocabulary the styles a style sheet uses, with those its extensions use
    ; (`sheet-parts`), which the rules it writes declare, after those of the sheet it derives from;
    ; whether none was wrong, and whether a using was read.
    (let usings false)
    (let base (?? (call (. types base-of) sheet) no-type))
    (if (call is-sheet-type base)
      (let (tuple kept inherited) (call add-sheet-styles base styles site))
      (return-if (tuple false true) (if (not kept)))
      (= usings inherited)
    )
    (for (in part (call sheet-parts (call class-ref types sheet)))
      (let owner ([] (. program modules) (. part module)))
      (for (in member ([] (. owner member-pool) (call part-members part)))
        (match? ([] (. owner decls) member)
          (case (call .decl-using using)
            (= usings true)
            (if (!= (call using-sheet part using) no-type)
              (continue)
            )
            (let used (call using-style part using site))
            (if (== used no-type)
              (return (tuple false true))
            )
            (if (== (call (. styles find) used) null)
              (+= styles used)
            )
          )
        )
      )
    )
    (return (tuple true usings))
  )
  (fn-do _ add-interface-styles Bool
    (param interface TypeId)
    (param styles (list TypeId))
    (param site SyntaxId)
    ; Adds to a vocabulary the styles an interface uses, then those of each interface it extends,
    ; as the reference's `visibleStyleUsings` of an interface.
    (let ref (call class-ref types interface))
    (let owner ([] (. program modules) (. ref module)))
    (match? ([] (. owner decls) (. ref decl))
      (case (call .decl-class declared)
        (for (in member ([] (. owner member-pool) (. declared members)))
          (match? ([] (. owner decls) member)
            (case (call .decl-using using)
              (let used (call using-style ref using site))
              (if (== used no-type)
                (return false)
              )
              (if (== (call (. styles find) used) null)
                (+= styles used)
              )
            )
          )
        )
      )
    )
    (for (in extended (call (. types interfaces-of) interface))
      (if (not (call add-interface-styles extended styles site))
        (return false)
      )
    )
    (return true)
  )
  (fn-do + conform-styles _
    (param class TypeId)
    (param interface TypeId)
    ; A class whose objects are made values of an interface must use each style the interface and
    ; those it extends use, as the reference checks as it makes the witness; the first it does not
    ; is the reference's error, at the class's declaration. Each instance that makes the witness
    ; reports it, so that it is reported whichever of them a type pass types.
    (let key (/or/ (/lshift/ (as class U64) 32) (as interface U64)))
    (let known ([] (. scratch missing-styles) key))
    (let missing (if-expr known known (call missing-style class interface)))
    (= ([] (. scratch missing-styles) key) missing)
    (if (== missing no-type)
      (return)
    )
    (let ref (call class-ref types class))
    (let owner ([] (. program modules) (. ref module)))
    (match? ([] (. owner decls) (. ref decl))
      (case (call .decl-class declared)
        (let text
          (call (. program store-atom)
            (block
              (arg
                (paragraph
                  (str (call type-short-name types class) " must use " (call type-short-name types missing) " to implement " (call type-short-name types interface))
                )
              )
            )
          )
        )
        (call (. facts record-diagnostic)
          (block
            (arg instance)
            (arg (. ref module))
            (arg (. declared syntax))
            (arg .stated)
            (arg text)
            (arg no-type)
            (arg no-type)
          )
        )
      )
    )
  )
  (fn-do _ missing-style TypeId
    (param class TypeId)
    (param interface TypeId)
    ; The first style an interface or one it extends uses that a class does not, or no type.
    (if (not (call (. program module-by-name) "core/style"))
      (return no-type)
    )
    (let wanted (list TypeId))
    (if (or (not (call add-interface-styles interface wanted 0)) (== (. wanted length) 0))
      (return no-type)
    )
    (let seen (list TypeId))
    (if (not (call add-visible-styles class seen 0))
      (return no-type)
    )
    (for (in style wanted)
      (if (== (call (. seen find) style) null)
        (return style)
      )
    )
    (return no-type)
  )
  (fn-do + style-vocabulary (? (list TypeId))
    (param class TypeId)
    (param site SyntaxId)
    ; The styles a name written for an object of a class in markup may be a property of, in the
    ; order they answer it: the class's own, those of the elements the markup is in, innermost
    ; first, and those of the class the markup is written in, as the reference's
    ; `styleVocabularyFor`. None where a using is declined.
    (let styles (list TypeId))
    (if (not (call add-visible-styles class styles site))
      (return null)
    )
    (call add-markup-styles styles)
    (if (not (call add-visible-styles (. frame self-type) styles site))
      (return null)
    )
    (return styles)
  )
  (fn-do _ add-markup-styles _
    (param styles (list TypeId))
    ; Adds to a vocabulary the styles of the elements the markup is in, innermost first, each that
    ; it does not hold yet, once. The stack of them holds a style again for each element that
    ; brings it into view, so what the vocabulary holds is marked by type rather than searched.
    (+= style-mark 1)
    (for (in style styles)
      (call mark-style style)
    )
    (for (in position (..< 0 (. markup-styles length)))
      (let used ([] markup-styles (- (. markup-styles length) 1 position)))
      (if (call mark-style used)
        (+= styles used)
      )
    )
  )
  (fn-do _ mark-style Bool
    (param style TypeId)
    ; Marks a style as one the vocabulary `add-markup-styles` gathers holds, and says whether it
    ; held it not yet.
    (while (<= (. style-marks length) style)
      (+= style-marks 0)
    )
    (if (== ([] style-marks style) style-mark)
      (return false)
    )
    (= ([] style-marks style) style-mark)
    (return true)
  )
  (fn-do _ names-style-property Bool
    (param used TypeId)
    (param name Atom)
    ; Whether a style, or one above it, declares a property of a name.
    (let level (? TypeId) used)
    (while (and level (== (call (. types intrinsic-of) level) .style) (!= level (call (. types type-row) .style)))
      (let ref (call class-ref types level))
      (let owner ([] (. program modules) (. ref module)))
      (match? ([] (. owner decls) (. ref decl))
        (case (call .decl-class declared)
          (for (in member ([] (. owner member-pool) (. declared members)))
            (match? ([] (. owner decls) member)
              (case (call .decl-property property)
                (if (and (. property name) (== (. property name) name) plain-member)
                  (return true)
                )
                (lazy plain-member (and (not (. property defaults-root)) (== (. property element) 0)))
              )
            )
          )
        )
      )
      (= level (call (. types base-of) level))
    )
    (return false)
  )
  (fn-do _ style-answering TypeId
    (param styles (list TypeId))
    (param name Atom)
    ; The style of a vocabulary that declares a property of a name: none where no style does, and
    ; the invalid type where two do, which the reference resolves by their types.
    (let found no-type)
    (for (in used styles)
      (if (call names-style-property used name)
        (if (!= found no-type)
          (return invalid-type)
        )
        (= found used)
      )
    )
    (return found)
  )
  (fn-do _ first-answering TypeId
    (param styles (list TypeId))
    (param name Atom)
    (param site SyntaxId)
    ; The first style of a vocabulary that declares a property of a name where more than one does,
    ; as the reference resolves it where they give it one type; where two give it different types,
    ; the reference's error at the name `site` writes, and the invalid type.
    (let found no-type)
    (let held no-type)
    (let owner no-type)
    (let written site)
    (match? ([] (. tree nodes) site)
      (case (call .node-assign line)
        (= written (. line lhs))
      )
    )
    (for (in used styles)
      (let (tuple level type) (call declared-style-property used name))
      (if (== level no-type)
        (continue)
      )
      (if (or (== type invalid-type) (== type no-type))
        (call decline site)
        (return invalid-type)
      )
      (if (== found no-type)
        (= found used)
        (= held type)
        (= owner level)
        (else-if (!= type held)
          (call (. frame diagnose)
            (block
              (arg written)
              (arg .stated)
              (arg
                (call (. program store-atom)
                  (block
                    (arg
                      (paragraph
                        (str "Style property \"" (. name text) "\" has conflicting types in visible styles " (call type-short-name types owner) " and " (call type-short-name types level))
                      )
                    )
                  )
                )
              )
            )
          )
          (return invalid-type)
        )
      )
    )
    (return found)
  )
  (fn-do _ declared-style-property (tuple TypeId TypeId)
    (param used TypeId)
    (param name Atom)
    ; The style that declares a property of a name, the one given or one above it, and the type it
    ; gives the property; none where none does.
    (let level (? TypeId) used)
    (while (and level (== (call (. types intrinsic-of) level) .style) (!= level (call (. types type-row) .style)))
      (if (call names-own-style-property level name)
        (let place (call property-named level name))
        (if (not place)
          (return (tuple level invalid-type))
        )
        (let property ([] (. types properties) place))
        (let declared
          (scope (if-expr typed (. property type) (call demand-member property level name))
            (lazy typed (!= (. property type) no-type))
          )
        )
        (return (tuple level declared))
      )
      (= level (call (. types base-of) level))
    )
    (return (tuple no-type no-type))
  )
  (fn-do _ names-own-style-property Bool
    (param level TypeId)
    (param name Atom)
    ; Whether a style itself, and not one above it, declares a property of a name.
    (let ref (call class-ref types level))
    (let owner ([] (. program modules) (. ref module)))
    (match? ([] (. owner decls) (. ref decl))
      (case (call .decl-class declared)
        (for (in member ([] (. owner member-pool) (. declared members)))
          (match? ([] (. owner decls) member)
            (case (call .decl-property property)
              (if (and (. property name) (== (. property name) name) plain-member)
                (return true)
              )
              (lazy plain-member (and (not (. property defaults-root)) (== (. property element) 0)))
            )
          )
        )
      )
    )
    (return false)
  )
  (fn-do _ find-style-property (tuple U32 U32)
    (param styles (list TypeId))
    (param name Atom)
    (param site SyntaxId)
    ; The number of the style of a vocabulary whose property of a name answers it, and the
    ; property's place in `style-properties`: the first style that declares one, as the reference
    ; resolves it, numbered as it is first used, where all that do give it one type
    ; (`first-answering`). Both are `U32.max` where no style declares one, and the place alone where
    ; the property is declined or reported.
    (let found (call style-answering styles name))
    (if (== found invalid-type)
      (= found (call first-answering styles name site))
    )
    (if (== found invalid-type)
      (return (tuple 0 (. U32 max)))
    )
    (if (== found no-type)
      (return (tuple (. U32 max) (. U32 max)))
    )
    (let index (call style-index found site false))
    (if (== index (. U32 max))
      (return (tuple 0 (. U32 max)))
    )
    (let use ([] (. facts style-uses) index))
    (for (in position (..< (. use first) (+ (. use first) (. use count))))
      (if (== (. ([] (. facts style-properties) position) name) name)
        (return (tuple index position))
      )
    )
    (call decline site)
    (return (tuple 0 (. U32 max)))
  )
  (fn-do + declare-styles Bool
    (param id SyntaxId)
    (param made TypeId)
    (param body SyntaxId)
    (param first U32)
    ; Types the attributes of a markup element that name a property of a style the element sees,
    ; its vocabulary, not one of its class: each declares the property's value for the object at
    ; the element's site, as the reference declares it after the constructor and before the
    ; properties are stored, in the order written, at the layer `markup-layer` says. The value is
    ; converted to the property's type as one assigned is. A name no style answers is the
    ; reference's error. A value that reads something tracked is declared again as it changes by a
    ; live action of the object's association with the site (`settle-attributes`). `inherit` takes
    ; the value from the parent (`declare-inherit`). A value the runtime holds a handle to is held
    ; by a holder of its own (`style-value-ready`), or where it reads nothing that differs from one
    ; making to the next, evaluated once for every making (`note-static-value`). A name alone that
    ; names a slot of a style sheet the element sees declares that slot (`declare-sheet-slot`).
    ; Their orders follow the `first` the rules the element applies took.
    ; The element is a site where any of them declares, where it applies a shared rule that
    ; declares nothing (`empty-shared`), which the reference calls at a site all the same.
    (let order first)
    (let sited empty-shared)
    (= empty-shared false)
    (if (or (== body 0) (not (is ([] (. tree nodes) body) .node-block)))
      (if (or (!= order 0) sited)
        (+= (. facts style-sites) (call StyleSite instance module id))
      )
      (return true)
    )
    (let layer (call markup-layer))
    (let styles (? (list TypeId)) null)
    (match? ([] (. tree nodes) body)
      (case (call .node-block row)
        (for (in statement ([] (. tree children) (. row body)))
          (match? ([] (. tree nodes) statement)
            (case (call .node-assign attribute)
              (let name (call style-name tree (. attribute lhs)))
              (if (not (call styles-attribute (. attribute op) made name))
                (continue)
              )
              (if (not styles)
                (= styles (call style-vocabulary made statement))
                (if (not styles)
                  (return false)
                )
              )
              (let (tuple index position) (call find-style-property styles (!! name) statement))
              (if (== position (. U32 max))
                (if (== index (. U32 max))
                  (call attribute-not-found (. attribute lhs) (!! name))
                )
                (return false)
              )
              (let property ([] (. facts style-properties) position))
              (if (call (. tree is-inherit) (. attribute rhs))
                (if (== layer (. U32 max))
                  (call decline statement)
                  (return false)
                )
                (if (not (call declare-inherit statement id index position layer order))
                  (return false)
                )
                (+= order 1)
                (continue)
              )
              (let sheeted
                (call declare-sheet-slot
                  (block
                    (arg statement)
                    (arg id)
                    (arg index)
                    (arg position)
                    (arg layer)
                    (arg order)
                    (arg (. attribute rhs))
                    (arg made)
                  )
                )
              )
              (if (== sheeted 2)
                (return false)
              )
              (if (== sheeted 1)
                (+= order 1)
                (continue)
              )
              (if (not (call style-value-ready (. property type)))
                (call decline statement)
                (return false)
              )
              (let scope (call enter-theme made no-type statement))
              (let written (call style-value (. attribute rhs) (. property type)))
              (let themed (call leave-theme scope))
              (if (or (== written invalid-type) (== written no-type))
                (return false)
              )
              (if (== (call (. conversions convert) statement (. attribute rhs) written (. property type) .reason-assignment) invalid-type)
                (return false)
              )
              (if (or (== layer (. U32 max)) (not (call demand-style-sites)) (and (call is-live-statement statement) (not (call demand-style-authors made))))
                (call decline statement)
                (return false)
              )
              (if (!= themed (. U32 max))
                (if (not (call declare-themed statement id index position layer order (. attribute rhs) themed))
                  (return false)
                )
                (+= order 1)
                (continue)
              )
              (let fixed (call fixed-style-value (. attribute rhs)))
              (let cached
                (scope (and cacheable (call declaration-static (. attribute rhs)))
                  (lazy cacheable (and (not (call is-live-statement statement)) (call holds-handle (. property type))))
                )
              )
              (if cached
                (call note-static-value statement (. property type))
              )
              (call (. facts add-style-declaration)
                (block
                  (arg
                    (call StyleDeclaration
                      (block
                        (arg instance)
                        (arg id)
                        (arg statement)
                        (arg (. ([] (. facts style-uses) index) type))
                        (arg position)
                        (arg layer)
                        (arg order)
                        (arg fixed)
                        (arg false)
                        (arg cached)
                      )
                    )
                  )
                )
              )
              (+= order 1)
            )
          )
        )
      )
    )
    (if (or (!= order 0) sited)
      (+= (. facts style-sites) (call StyleSite instance module id))
    )
    (return true)
  )
  (fn-do + apply-style-rules U32
    (param id SyntaxId)
    (param made TypeId)
    (param row ASTMarkup)
    ; The style rules a markup element applies, as the reference applies them once the object is
    ; made: first those that take no values whose name a class of the element, the type written
    ; or the element's id spelled as a selector matches (`implicit-names`), then those written
    ; after `•`, in order. Each is the rule the element's class, or the nearest class above it,
    ; writes by that name with no values; where none does, nothing is applied. Each is typed once
    ; for the class that writes it (`check-style-unit`) and declares at the rule layer, from the
    ; order the one before it ended at, with the rules it applies itself (`apply-rule`). Answers
    ; how many declarations they make, or `U32.max` where one is declined or reported. Rules
    ; apply without `core/style`, as their lines may set properties of the class. A rule matched
    ; by name that the reference makes a function shared by every element it matches
    ; (`shares-rule`) is marked `shared`. The values a written one is given are typed as they are
    ; written, with nothing expected, and the rule is chosen by them (`match-style-rule`); each is
    ; converted at its node to the type the rule takes it as. A written name some rule of the
    ; chain has but none takes such values by is the reference's `Type mismatch`. A written one with
    ; a condition is applied under it (`applied-gate`). Declined: a shared rule that declares
    ; nothing, which the reference makes a site for anyway, a name a rule written in a rule may
    ; answer (`overlay-rule`), and a
    ; rule whose properties the element's vocabulary answers with other styles than its class's
    ; does. Where no class of the chain answers a name, the style sheets the element sees may
    ; (`sheet-rules`), each group's rule applied in turn, lowest first. After those, each rule
    ; written in a rule that the element sees and that answers the name is applied over them
    ; (`scope-rules`), those the element's own rules applied before bring into view among them. The
    ; rules written in rules that its rules bring into view must be those the element was made
    ; seeing (`gather-scopes`), or it is declined.
    (if (!= (call (. types intrinsic-of) made) .class)
      (if (!= (. row style-rule-applications count) 0)
        (call decline id)
        (return (. U32 max))
      )
      (return 0)
    )
    (let styled (!= (call (. program module-by-name) "core/style") null))
    (let order U32)
    (call (. element-scopes clear))
    (= empty-shared false)
    (for (in name (call implicit-names made (. row type-id) (. row id) tree))
      (let atom (call (. program store-atom) name))
      (if (call overlay-rule atom)
        (call decline id)
        (return (. U32 max))
      )
      (= collecting true)
      (call (. collected clear))
      (= order (call apply-implicit id made (. row type-id) atom order styled))
      (= collecting false)
      (if (== order (. U32 max))
        (return (. U32 max))
      )
      (for (in use collected)
        (+= element-scopes use)
      )
    )
    (= order (call apply-written-rules id made (. row style-rule-applications) order no-instance true))
    (if (and (!= order (. U32 max)) (not (call same-scopes id)))
      (call decline id)
      (= order (. U32 max))
    )
    (call (. element-scopes clear))
    (return order)
  )
  (fn-do _ apply-implicit U32
    (param id SyntaxId)
    (param made TypeId)
    (param type-id SyntaxId)
    (param name Atom)
    (param order U32)
    (param styled Bool)
    ; Applies the style rules taking no values that a markup element matches by a name, as
    ; `apply-style-rules` says. A rule of a style sheet the element's chain uses that a class of the
    ; chain matches by its name is one of that class's defaults, applied where the object is made
    ; (`apply-themed-defaults`), and not here (`themes-class`); the rules written in it still come
    ; into view for the element's body, as the element gathered them (`gather-rule`). Answers the
    ; order the next rule takes, or `U32.max`.
    (let next order)
    (let (tuple level member named) (call class-style-rule made name))
    (let none (list TypeId))
    (if (!= level no-type)
      (= next (call apply-named id made (call rule-unit level member made id) next styled))
      (if (== next (. U32 max))
        (return (. U32 max))
      )
      (else
        (let sheets (list TypeId))
        (let members (list DeclRef))
        (let gates (list U64))
        (let (tuple status writes missed)
          (call sheet-rules
            (block
              (arg made)
              (arg name)
              (arg none)
              (arg (call written-name type-id name))
              (arg sheets)
              (arg members)
              (arg gates)
              (arg (. U32 max))
            )
          )
        )
        (if (== status 1)
          (call decline id)
        )
        (if (!= status 0)
          (return (. U32 max))
        )
        (for (in position (..< 0 (. sheets length)))
          (if (call themes-class made name ([] sheets position))
            (let brought (list ScopeUse))
            (if (not (call gather-rule made (. ([] members position) module) (. ([] members position) decl) ([] sheets position) (. U32 max) (. U32 max) element-scopes id made brought 0 (. U32 max) (. U32 max)))
              (call decline id)
              (return (. U32 max))
            )
            (for (in use brought)
              (+= collected use)
            )
            (continue)
          )
          (let unit (call rule-unit ([] sheets position) ([] members position) made id))
          (let first (. facts style-applications length))
          (= next (call apply-named id made unit next styled))
          (if (or failed (not (call gate-applications (as first U32) ([] sheets position) ([] gates position) id)))
            (return (. U32 max))
          )
          (lazy failed (== next (. U32 max)))
        )
      )
    )
    (let scoped (list ScopeUse))
    (let (tuple scoping found missed) (call scope-rules made name none element-scopes scoped (. U32 max)))
    (if (== scoping 1)
      (call decline id)
    )
    (if (!= scoping 0)
      (return (. U32 max))
    )
    (for (in use scoped)
      (= next
        (call apply-named
          (block
            (arg id)
            (arg made)
            (arg (call scope-unit (. use scope) made))
            (arg next)
            (arg styled)
            (arg (. use scope frames))
            (arg (. use cell))
            (arg (. use values))
            (arg (. use outer-cells))
          )
        )
      )
      (if (== next (. U32 max))
        (return (. U32 max))
      )
    )
    (return next)
  )
  (fn-do _ themes-class Bool
    (param made TypeId)
    (param name Atom)
    (param sheet TypeId)
    ; Whether `sheet`, which writes a rule of `name`, is a style sheet the chain of a markup element's
    ; class uses (`add-sheet-groups`) and a class of the chain has the name, so that the rule is one
    ; of that class's defaults (`apply-themed-defaults`).
    (let own (list TypeId))
    (let levels (list U32))
    (call add-sheet-groups made own levels)
    (return-if false (if (== (call (. own find) (call family-root sheet)) null)))
    (let level (? TypeId) made)
    (while (and level (== (call (. types intrinsic-of) level) .class))
      (let ref (call class-ref types level))
      (match? ([] (. ([] (. program modules) (. ref module)) decls) (. ref decl))
        (case (call .decl-class class)
          (if (== (call (. program store-atom) (. class name text)) name)
            (return true)
          )
        )
      )
      (= level (call (. types base-of) level))
    )
    (return false)
  )
  (fn-do + apply-written-rules U32
    (param id SyntaxId)
    (param made TypeId)
    (param applications (of RowRange SyntaxId))
    (param first U32)
    (param values InstanceId (= no-instance))
    (param gates Bool (= false))
    ; The style rules written after `•` that a markup element, or a slot outlet for what it mounts,
    ; applies, in order, from the order `first`, as `apply-style-rules` says, each bringing into view
    ; the rules written in the rules it applies (`element-scopes`). The values an application gives
    ; are typed here, but where the element typed them as it gathered what they bring
    ; (`gather-scopes`), or by the instance `values` where one types them (`check-root-values`),
    ; which converts them too. Where an element `gates` what its rules declare, a rule written with a
    ; condition is applied under it (`applied-gate`) once a rule answers its name; elsewhere it is
    ; declined. Answers the order the next declaration takes, or `U32.max`.
    (let order first)
    (for (in application ([] (. tree children) applications))
      (match? ([] (. tree nodes) application)
        (case (call .node-style-rule-application applied)
          (if (or (and conditional (or (not gates) (!= values no-instance))) (call overlay-rule (. applied name)))
            (call decline application)
            (return (. U32 max))
          )
          (lazy conditional (!= (. applied condition) 0))
          (let given (list TypeId))
          (for (in value ([] (. tree children) (. applied args)))
            (let held (if-expr (!= values no-instance) values instance))
            (let scope
              (call enter-theme
                (block
                  (arg (if-expr (== values no-instance) made no-type))
                  (arg no-type)
                  (arg application)
                )
              )
            )
            (let type
              (scope (if-expr answered (call (. facts answer-type) held value) (call infer value))
                (lazy answered (or (!= values no-instance) (!= (call (. pretyped find) value) null)))
              )
            )
            (call leave-theme scope)
            (if (or (== type invalid-type) (== type no-type))
              (if (!= values no-instance)
                (call decline application)
              )
              (return (. U32 max))
            )
            (+= given type)
          )
          (let levels (list TypeId))
          (let members (list DeclRef))
          (let gates (list U64))
          (let scoped (list ScopeUse))
          (if (not (call choose-written-rule made application given levels members gates scoped))
            (return (. U32 max))
          )
          (let gate (list StyleWhen))
          (if (and (!= (. applied condition) 0) (!= (+ (. levels length) (. scoped length)) 0))
            (let held (call applied-gate (. applied condition) made))
            (if (not held)
              (return (. U32 max))
            )
            (+= gate held)
          )
          (= collecting true)
          (call (. collected clear))
          (for (in chosen (..< 0 (+ (. levels length) (. scoped length))))
            (let unit (if-expr (< chosen (. levels length)) (call rule-unit ([] levels chosen) ([] members chosen) made application) (call scope-unit (. ([] scoped (- chosen (. levels length))) scope) made)))
            (if (or (== unit no-instance) (not (call answers-alike unit made application)))
              (= collecting false)
              (call decline application)
              (return (. U32 max))
            )
            (let wanted (if-expr (< chosen (. levels length)) (?? (call rule-argument-types ([] members chosen)) (call scope-argument-types (. ([] scoped (- chosen (. levels length))) scope))) (call scope-argument-types (. ([] scoped (- chosen (. levels length))) scope))))
            (for (in position (..< 0 (. given length)))
              (let value ([] (. tree children) (+ (. applied args start) position)))
              (if (and (== values no-instance) (== chosen 0) (== (call (. conversions convert) value value ([] given position) ([] (!! wanted) position) .reason-argument) invalid-type))
                (= collecting false)
                (return (. U32 max))
              )
            )
            (let active (list InstanceId))
            (let applied (list InstanceId))
            (let gated (list StyleWhen))
            (for (in held gate)
              (+= gated held)
            )
            (let frames
              (scope (if-expr (>= chosen (. levels length)) scoped-frames (. U32 max))
                (lazy scoped-frames (. ([] scoped (- chosen (. levels length))) scope frames))
              )
            )
            (let cell
              (scope (if-expr (>= chosen (. levels length)) scoped-cell (. U32 max))
                (lazy scoped-cell (. ([] scoped (- chosen (. levels length))) cell))
              )
            )
            (let around
              (scope (if-expr (>= chosen (. levels length)) scoped-values (. U32 max))
                (lazy scoped-values (. ([] scoped (- chosen (. levels length))) values))
              )
            )
            (let links
              (scope (if-expr (>= chosen (. levels length)) scoped-links (. U32 max))
                (lazy scoped-links (. ([] scoped (- chosen (. levels length))) outer-cells))
              )
            )
            (let recorded (. facts style-applications length))
            (= order
              (call apply-rule
                (block
                  (arg id)
                  (arg made)
                  (arg unit)
                  (arg order)
                  (arg application)
                  (arg (. U32 max))
                  (arg 0)
                  (arg gated)
                  (arg active)
                  (arg applied)
                  (arg frames)
                  (arg cell)
                  (arg around)
                  (arg (and (== values no-instance) (!= (. given length) 0)))
                  (arg links)
                )
              )
            )
            (if (== order (. U32 max))
              (= collecting false)
              (return (. U32 max))
            )
            (= (. ([] (. facts style-applications) recorded) values) values)
            (call revise-application (as recorded U32))
            (if (and (< chosen (. levels length)) (not (call gate-applications (as recorded U32) ([] levels chosen) ([] gates chosen) application)))
              (= collecting false)
              (return (. U32 max))
            )
            (if (and (== values no-instance) (!= (. given length) 0))
              (call share-written-values (as recorded U32) tree (. frame binding))
              (if (not (call bind-given-slots (as recorded U32) application unit module instance))
                (= collecting false)
                (return (. U32 max))
              )
            )
          )
          (= collecting false)
          (for (in use collected)
            (+= element-scopes use)
          )
        )
      )
    )
    (return order)
  )
  (fn-do _ applied-gate (? StyleWhen)
    (param condition SyntaxId)
    (param made TypeId)
    ; The condition a style rule written after `•` on a markup element is applied under, which gates
    ; what the rule declares and the rules it applies, as the reference's `compileStyleGatedBlock`
    ; gates them: a name or a member read tracked, or the latest value of one, as the reference
    ; reports, of type `Bool`, tested where each gate is made and again by the function written for
    ; it (`check-gate-test`). The gate it makes alone is recorded once (`StyleGate`). None where it
    ; is reported or declined.
    (if (not (call (. tree is-condition-reference) condition))
      (call (. frame diagnose)
        (block
          (arg condition)
          (arg .stated)
          (arg
            (call (. program store-atom)
              (block
                (arg
                  (paragraph
                    "Style rule conditions must be a tracked boolean property reference (like #is-disabled)"
                  )
                )
              )
            )
          )
        )
      )
      (return null)
    )
    (let type (call infer condition))
    (if (== type invalid-type)
      (return null)
    )
    (if (!= type (. types bool-type))
      (call (. frame diagnose)
        (block
          (arg condition)
          (arg .stated)
          (arg
            (call (. program store-atom)
              (block
                (arg
                  (paragraph
                    (str "Style rule conditions must be Bool, but this condition is " (call type-display types type))
                  )
                )
              )
            )
          )
          (arg type)
        )
      )
      (return null)
    )
    (let decl (call nested-decl-of condition))
    (let test (if-expr (!= decl 0) (call demand-lambda (call intern-nested decl) (. scratch no-types)) no-instance))
    (if (or (== test no-instance) (!= (. ([] (. instances signatures) test) errors count) 0))
      (call decline condition)
      (return null)
    )
    (+= (. facts live-statements) (call LiveStatement instance condition test))
    (call (. instances mark-may-panic) instance)
    (let action (call demand-style-gates made))
    (if (or (== action no-instance) (== (. instances live track) no-instance))
      (call decline condition)
      (return null)
    )
    (let held (call StyleWhen module condition (. U32 max) test))
    (let whens (list StyleWhen))
    (+= whens held)
    (call record-gate made whens action)
    (return held)
  )
  (fn-do + choose-written-rule Bool
    (param made TypeId)
    (param application SyntaxId)
    (param given (list TypeId))
    (param levels (list TypeId))
    (param members (list DeclRef))
    (param gates (list U64))
    (param scoped (list ScopeUse))
    ; The rules a style rule written after `•` applies by its name, for an object of the class `made`
    ; and the types of the values it gives: the one the class's chain chooses, as the reference's
    ; `resolveMatch` does, or else those the style sheets in view choose, each with the class that
    ; writes it, in `levels` and `members`; then those of the rules written in rules in view
    ; (`element-scopes`) in `scoped`. A name that some rule takes but none for those values is the
    ; reference's error, and so is a name no module of the program declares (`style-declared`); more than one rule given values, a rule that matches ambiguously, and a
    ; choice the sheets or the rules in view cannot make here are declined. False where one is.
    (match? ([] (. tree nodes) application)
      (case (call .node-style-rule-application applied)
        (let (tuple level member taken mismatch) (call match-style-rule made (. applied name) given))
        (if (== level invalid-type)
          (if (not (call report-argument-types member))
            (call decline application)
          )
          (return false)
        )
        (let named taken)
        (let missed mismatch)
        (if (!= level no-type)
          (+= levels level)
          (+= members member)
          (+= gates (. U64 max))
          (else
            (let (tuple status writes last)
              (call sheet-rules
                (block
                  (arg made)
                  (arg (. applied name))
                  (arg given)
                  (arg application)
                  (arg levels)
                  (arg members)
                  (arg gates)
                  (arg mismatch)
                )
              )
            )
            (if (== status 1)
              (call decline application)
            )
            (if (!= status 0)
              (return false)
            )
            (= named (or named writes))
            (= missed last)
          )
        )
        (let (tuple scoping found place-missed)
          (call scope-rules
            (block
              (arg made)
              (arg (. applied name))
              (arg given)
              (arg element-scopes)
              (arg scoped)
              (arg missed)
            )
          )
        )
        (if (== scoping 1)
          (call decline application)
        )
        (if (!= scoping 0)
          (return false)
        )
        (if (and (== (. levels length) 0) (== (. scoped length) 0) (or named found))
          (let place
            (scope (if-expr (!= place-missed (. U32 max)) missed-value application)
              (lazy missed-value ([] (. tree children) (+ (. applied args start) place-missed)))
            )
          )
          (call (. frame diagnose) place .stated (call (. program store-atom) "Type mismatch"))
          (return false)
        )
        (if (and (== (. levels length) 0) (== (. scoped length) 0) (not (call style-declared (. applied name))))
          (call (. frame diagnose)
            (block
              (arg application)
              (arg .stated)
              (arg
                (call (. program store-atom)
                  (block
                    (arg
                      (paragraph
                        (str "No style rule is named \"" (. applied name text) "\". Write one in a style sheet, or, where a library applies it for a theme to style, declare it there with an empty rule")
                      )
                    )
                  )
                )
              )
            )
          )
          (return false)
        )
        (if (and several (!= (. given length) 0) (or (!= (. scoped length) 0) (not (call variants-alike levels members))))
          (call decline application)
          (return false)
        )
        (lazy several (> (+ (. levels length) (. scoped length)) 1))
        (return true)
      )
    )
    (call decline application)
    (return false)
  )
  (fn-do _ variants-alike Bool
    (param levels (list TypeId))
    (param members (list DeclRef))
    (let wanted (call rule-argument-types ([] members 0)))
    (return-if false (if (not wanted)))
    (for (in position (..< 1 (. levels length)))
      (if (!= (call family-root ([] levels position)) (call family-root ([] levels 0)))
        (return false)
      )
      (let other (call rule-argument-types ([] members position)))
      (if (or (not other) (!= (. other length) (. wanted length)))
        (return false)
      )
      (for (in place (..< 0 (. wanted length)))
        (if (!= ([] other place) ([] wanted place))
          (return false)
        )
      )
    )
    (return true)
  )
  (fn-do _ written-name SyntaxId
    (param type-id SyntaxId)
    (param name Atom)
    ; The type a markup element is written with where it is spelled as a style rule's name, at which
    ; the reference reports an error of the rule it applies by that name; or none.
    (match? ([] (. tree nodes) (call written-base tree type-id))
      (case (call .node-type-identifier written)
        (if (and (not (. written is-declare)) (== (. written name) name))
          (return (call written-base tree type-id))
        )
      )
    )
    (return 0)
  )
  (fn-do _ apply-named U32
    (param id SyntaxId)
    (param made TypeId)
    (param unit InstanceId)
    (param order U32)
    (param styled Bool)
    (param frames U32 (= (. U32 max)))
    (param cell U32 (= (. U32 max)))
    (param values U32 (= (. U32 max)))
    (param outer-cells U32 (= (. U32 max)))
    ; Applies a style rule taking no values that a markup element matches by name, written by a
    ; class of its chain, a style sheet it sees or a rule within the `frames`, state cells and `values`
    ; given, typed by the
    ; instance `unit`, from an order, as `apply-style-rules` says, marked `shared` where the
    ; reference makes it a function (`shares-rule`): one with no rules around it, which matches no
    ; rule that has any as it applies its own. One that declares nothing makes the element a site
    ; all the same (`empty-shared`). Answers the order the next rule takes, or `U32.max`.
    (if (or (== unit no-instance) (not (call answers-alike unit made id)))
      (call decline id)
      (return (. U32 max))
    )
    (let active (list InstanceId))
    (let applied (list InstanceId))
    (let ungated (list StyleWhen))
    (let first (. facts style-applications length))
    (let framing framed)
    (let next
      (call apply-rule
        (block
          (arg id)
          (arg made)
          (arg unit)
          (arg order)
          (arg 0)
          (arg (. U32 max))
          (arg 0)
          (arg ungated)
          (arg active)
          (arg applied)
          (arg frames)
          (arg cell)
          (arg values)
          (arg false)
          (arg outer-cells)
        )
      )
    )
    (if (== next (. U32 max))
      (return (. U32 max))
    )
    (if (and styled (== frames (. U32 max)) (== framed framing) (call shares-rule applied (- next order)))
      (if (== next order)
        (= empty-shared true)
      )
      (= (. ([] (. facts style-applications) first) shared) true)
      (call revise-application (as first U32))
      (= (. ([] (. facts style-applications) first) made) made)
      (call revise-application (as first U32))
      (= (. ([] (. facts style-applications) first) span) (- next order))
      (call revise-application (as first U32))
    )
    (return next)
  )
  (fn-do + sheet-rules (tuple U32 Bool U32)
    (param made TypeId)
    (param name Atom)
    (param given (list TypeId))
    (param at SyntaxId)
    (param matched (list TypeId))
    (param members (list DeclRef))
    (param gates (list U64))
    (param mismatch U32)
    (param own Bool (= false))
    (param chained Bool (= false))
    ; The rules of the style sheets a markup element of a class sees that an application of a name
    ; answers, where no class of its chain does, as the reference's `resolveMatch` adds them: in
    ; each group, lowest first, the rule of each sheet that takes the values given most closely
    ; (`match-rules-of`), and of those the one that takes them most closely, two alike being the
    ; reference's error at `at`, or declined where `at` is none, and one whose types are written
    ; wrong reported where it is written (`report-argument-types`). Each group's applies, the lowest
    ; first. Answers 0, 1 where it is to be declined and 2 where it is reported; whether a sheet
    ; it looks at writes a rule of the name; and the place of the last value found not to convert.
    ; Where the sheets the markup sees are not known here (`sheets-known`), a name a rule of any
    ; sheet has is declined. With `own`, the sheets are those the class uses alone, as a rule the
    ; class writes chooses for the values it gives the rules it applies. With `chained`, they are
    ; those the class's chain uses and their variants, as the defaults of a class find the rules of
    ; its name (`apply-themed-defaults`).
    (if (not (call sheet-rule-name name))
      (return (tuple 0 false mismatch))
    )
    (if (and (not own) (not chained) (not (call sheets-known)))
      (return (tuple 1 false mismatch))
    )
    (let sheets (list TypeId))
    (let levels (list U32))
    (if (or own chained)
      (call add-sheet-groups made sheets levels)
      (else
        (call visible-sheets made sheets levels)
      )
    )
    (let named false)
    (let missed mismatch)
    (let top (if-expr (!= (. levels length) 0) (+ ([] levels (- (. levels length) 1)) 1) 0u32))
    (for (in group (..< 0 top))
      (let best no-type)
      (let best-kind 0u32)
      (let tied no-type)
      (let chosen-sheets (list TypeId))
      (let chosen-rules (list DeclRef))
      (let chosen-gates (list U64))
      (for (in place (..< 0 (. sheets length)))
        (if (!= ([] levels place) group)
          (continue)
        )
        (let family (call family-members ([] sheets place) own))
        (if (> (. family length) 64)
          (return (tuple 1 named missed))
        )
        (let found-sheets (list TypeId))
        (let found-rules (list DeclRef))
        (let found-gates (list U64))
        (let (tuple found kind writes last)
          (call family-rules
            (block
              (arg family)
              (arg name)
              (arg given)
              (arg missed)
              (arg found-sheets)
              (arg found-rules)
              (arg found-gates)
            )
          )
        )
        (if writes
          (= named true)
        )
        (= missed last)
        (if (and found (== kind (. U32 max)))
          (return (tuple (if-expr (call report-argument-types ([] found-rules 0)) 2u32 1u32) named missed))
        )
        (if (not found)
          (continue)
        )
        (if (or (== best no-type) (> kind best-kind))
          (= best ([] sheets place))
          (= best-kind kind)
          (= tied no-type)
          (= chosen-sheets found-sheets)
          (= chosen-rules found-rules)
          (= chosen-gates found-gates)
          (else-if (and (== kind best-kind) (== tied no-type))
            (= tied ([] sheets place))
          )
        )
      )
      (if (!= tied no-type)
        (if (== at 0)
          (return (tuple 1 named missed))
        )
        (let text
          (paragraph
            (str "Style rule \"" (. name text) "\" is ambiguous between visible style sheets " (call type-short-name types best) " and " (call type-short-name types tied))
          )
        )
        (call (. frame diagnose) at .stated (call (. program store-atom) text))
        (call (. facts inset-diagnostic) 0 (as (. name text length) U32))
        (return (tuple 2 named missed))
      )
      (for (in position (..< 0 (. chosen-sheets length)))
        (+= matched ([] chosen-sheets position))
        (+= members ([] chosen-rules position))
        (+= gates ([] chosen-gates position))
      )
    )
    (return (tuple 0 named missed))
  )
  (fn-do _ family-members (list TypeId)
    (param root TypeId)
    (param alone Bool (= false))
    (let family (list TypeId))
    (+= family root)
    (return-if family (if alone))
    (call list-derived-sheets)
    (for (in derived (. facts derived-sheets))
      (if (== (call family-root derived) root)
        (+= family derived)
      )
    )
    (return family)
  )
  (fn-do _ family-rules (tuple Bool U32 Bool U32)
    (param family (list TypeId))
    (param name Atom)
    (param given (list TypeId))
    (param mismatch U32)
    (param sheets (list TypeId))
    (param rules (list DeclRef))
    (param gates (list U64))
    (if (== (. family length) 1)
      (let (tuple held rule kind writes last) (call match-rules-of ([] family 0) name given mismatch))
      (if held
        (+= sheets ([] family 0))
        (+= rules rule)
        (+= gates (. U64 max))
      )
      (return (tuple held kind writes last))
    )
    (let found (list Bool))
    (let chosen (list DeclRef))
    (let kinds (list U32))
    (let named false)
    (let missed mismatch)
    (for (in sheet family)
      (let (tuple held rule kind writes last) (call match-rules-of sheet name given missed))
      (= named (or named writes))
      (= missed last)
      (if (and held (== kind (. U32 max)))
        (+= rules rule)
        (return (tuple true (. U32 max) named missed))
      )
      (+= found held)
      (+= chosen rule)
      (+= kinds kind)
    )
    (let picks (list U32))
    (for (in position (..< 0 (. family length)))
      (let pick (. U32 max))
      (let level ([] family position))
      (while true
        (let place (call (. family find) level))
        (if (and place ([] found place) (or (== pick (. U32 max)) (> ([] kinds place) ([] kinds pick))))
          (= pick (as place U32))
        )
        (if (== level ([] family 0))
          (break)
        )
        (= level (?? (call (. types base-of) level) ([] family 0)))
      )
      (+= picks pick)
    )
    (let full (if-expr (== (. family length) 64) (. U64 max) (- (/lshift/ 1u64 (. family length)) 1)))
    (let any false)
    (let best 0u32)
    (for (in place (..< 0 (. family length)))
      (let mask 0u64)
      (for (in position (..< 0 (. picks length)))
        (if (== ([] picks position) (as place U32))
          (= mask (/or/ mask (/lshift/ 1u64 position)))
        )
      )
      (if (== mask 0)
        (continue)
      )
      (+= sheets ([] family place))
      (+= rules ([] chosen place))
      (+= gates (if-expr (== mask full) (. U64 max) mask))
      (if (or (not any) (> ([] kinds place) best))
        (= best ([] kinds place))
      )
      (= any true)
    )
    (return (tuple any best named missed))
  )
  (fn-do _ gate-applications Bool
    (param first U32)
    (param sheet TypeId)
    (param mask U64)
    (param at SyntaxId)
    (return-if true (if (== mask (. U64 max))))
    (let family (call sheet-index (call family-root sheet) module at at))
    (if (or (== family (. U32 max)) (not (call demand-family-runtime)))
      (call decline at)
      (return false)
    )
    (+= (. facts family-gates) 1)
    (for (in index (..< first (as (. facts style-applications length) U32)))
      (let held ([] (. facts style-applications) index))
      (if (and (!= (. held family) (. U32 max)) (!= (. held family) family))
        (call decline at)
        (return false)
      )
      (= (. ([] (. facts style-applications) index) family) family)
      (call revise-application index)
      (= (. ([] (. facts style-applications) index) members)
        (scope (if-expr (== (. held family) family) masked mask)
          (lazy masked (/and/ (. held members) mask))
        )
      )
      (call revise-application index)
    )
    (return true)
  )
  (fn-do _ apply-rule U32
    (param id SyntaxId)
    (param made TypeId)
    (param unit InstanceId)
    (param order U32)
    (param written SyntaxId)
    (param outer U32)
    (param within SyntaxId)
    (param gated (list StyleWhen))
    (param active (list InstanceId))
    (param applied (list InstanceId))
    (param frames U32 (= (. U32 max)))
    (param cell U32 (= (. U32 max)))
    (param values U32 (= (. U32 max)))
    (param gives Bool (= false))
    (param outer-cells U32 (= (. U32 max)))
    ; Records a style rule applied to a markup element at the rule layer from an order, with the
    ; rules it applies itself, as the reference applies them: each name the rule writes after its
    ; own, then each the body of each of its `when`s does, is resolved for the element's class as
    ; a name the element writes is, and applied in turn, recorded after this one with this one as
    ; its `outer` and the `when` as its `within`. The values the rule gives one were typed and
    ; converted with the rule (`type-applied-values`), for the rule its own class chooses, which
    ; must be the one the element's class does. `gated` holds the `when`s the rule is applied
    ; under, the outermost first, which gate its declarations as `gate-when` says; a rule so gated
    ; that sets a property of its class is the reference's error. Answers the order the next rule
    ; takes, or `U32.max` where one is declined or reported. A rule that comes to apply itself
    ; again is the reference's error, at the application that would. `active` holds the rules
    ; being applied, the outermost first, and `applied` gathers each rule applied. A rule with a
    ; declaration whose value reads something tracked is given the constructor of the action of
    ; the style runtime that declares it again for the element's object, and one with a line that
    ; sets a property of its class again the function that makes that line's live action, chosen
    ; where the rule is applied, as `owner-action` chooses one for an attribute. A line of a rule a
    ; class writes whose value names a slot of a style sheet takes the slot the element sees
    ; (`bind-rule-slots`). The rules applied around the rule are `frames`; with the rule they are
    ; those around the rules it applies after its name, and around the rules written in it, which it
    ; brings into view after those (`bring-scopes`). A rule written in the body of a `when` is
    ; applied under the state cell of the `when` (`cell`), and those of the `when`s further out
    ; (`outer-cells`), first of all the `when`s that gate it, unless they hold them already
    ; (`cell-whens`). The content its lines generate follows its own
    ; declarations, and that of each `when` its declarations, each taking an order
    ; (`generate-content`). A rule written in a rule reads the `values` of the rule around it that
    ; takes some; one the element `gives` values holds them for the rules written in it
    ; (`scope-values`), but not within another that does.
    (let row ([] (. instances rows) unit))
    (let owner ([] (. program modules) (. row module)))
    (let index (as (. facts style-applications length) U32))
    (+= (. facts style-applications)
      (call StyleApplication
        (block
          (arg instance)
          (arg module)
          (arg id)
          (arg unit)
          (arg 2)
          (arg order)
          (arg written)
          (arg outer)
          (arg within)
        )
      )
    )
    (= (. ([] (. facts style-applications) index) around-values) values)
    (call revise-application index)
    (if (and (== (call (. types intrinsic-of) (. row self-type)) .class) (not (call bind-rule-slots id made unit index)))
      (return (. U32 max))
    )
    (let whens (call cell-whens id made gated cell outer-cells index))
    (if (not whens)
      (return (. U32 max))
    )
    (let gates whens)
    (if (call (. facts authors-in) unit)
      (let action (call demand-style-gates made))
      (if (== action no-instance)
        (call decline id)
        (return (. U32 max))
      )
      (= (. ([] (. facts style-applications) index) action) action)
      (call revise-application index)
    )
    (if (!= written 0)
      (let (tuple live local) (call values-live written outer))
      (if (and live local)
        (call decline id)
        (return (. U32 max))
      )
      (if live
        (= (. ([] (. facts style-applications) index) live-values) true)
        (call revise-application index)
      )
      (if (and live (call (. facts updates-given) unit))
        (call demand-live-runtime)
      )
      (if (and live (call (. facts reads-given-in) unit))
        (let action (call demand-style-gates made))
        (if (or (== action no-instance) (not (call demand-style-authors made)))
          (call decline id)
          (return (. U32 max))
        )
        (= (. ([] (. facts style-applications) index) action) action)
        (call revise-application index)
      )
    )
    (if (not (call choose-updater index id made))
      (return (. U32 max))
    )
    (let next order)
    (+= active unit)
    (+= applied unit)
    (if (and (!= (. gates length) 0) (not (call gates-updates unit)))
      (return (. U32 max))
    )
    (let around (call (. instances intern-frame) frames (. row module) (. row initializer) (. row self-type) 0))
    (let framed values)
    (match? ([] (. owner decls) (. row initializer))
      (case (call .decl-style-rule rule)
        (match? ([] (. owner tree nodes) (. rule syntax))
          (case (call .node-rule-syntax declared)
            (if (and gives (call (. owner tree holds-rules) (. rule syntax)))
              (if (!= values (. U32 max))
                (call decline id)
                (return (. U32 max))
              )
              (= framed (call scope-values written around))
            )
            (for (in nested ([] (. owner tree children) (. declared style-rule-applications)))
              (= next
                (call apply-inner
                  (block
                    (arg id)
                    (arg made)
                    (arg unit)
                    (arg nested)
                    (arg next)
                    (arg index)
                    (arg 0)
                    (arg gates)
                    (arg active)
                    (arg applied)
                    (arg around)
                    (arg cell)
                    (arg framed)
                    (arg outer-cells)
                  )
                )
              )
              (if (== next (. U32 max))
                (return (. U32 max))
              )
            )
            (if (not (call declares-only unit (. declared body) gates))
              (return (. U32 max))
            )
            (if (not (call bring-scopes id made unit around gates cell framed outer-cells))
              (return (. U32 max))
            )
            (let generated
              (call generate-content
                (block
                  (arg id)
                  (arg made)
                  (arg unit)
                  (arg index)
                  (arg (call (. owner tree rule-content) (. declared body)))
                  (arg gates)
                )
              )
            )
            (if (== generated (. U32 max))
              (return (. U32 max))
            )
            (+= next generated)
            (for (in branch (call (. owner tree rule-whens) (. declared body)))
              (let inner (call gate-when id made (. row module) branch gates))
              (if (not inner)
                (return (. U32 max))
              )
              (for (in nested (call (. owner tree when-applications) branch))
                (= next
                  (call apply-inner
                    (block
                      (arg id)
                      (arg made)
                      (arg unit)
                      (arg nested)
                      (arg next)
                      (arg index)
                      (arg branch)
                      (arg inner)
                      (arg active)
                      (arg applied)
                      (arg (. U32 max))
                    )
                  )
                )
                (if (== next (. U32 max))
                  (return (. U32 max))
                )
              )
              (let gated-content
                (call generate-content
                  (block
                    (arg id)
                    (arg made)
                    (arg unit)
                    (arg index)
                    (arg (call (. owner tree when-content) branch))
                    (arg inner)
                  )
                )
              )
              (if (== gated-content (. U32 max))
                (return (. U32 max))
              )
              (+= next gated-content)
            )
          )
        )
      )
    )
    (call (. active pop))
    (return (+ next (call (. facts style-declaration-count) unit)))
  )
  (fn-do _ values-live (tuple Bool Bool)
    (param written SyntaxId)
    (param outer U32)
    ; Whether the values an application written after `•` gives read something tracked, or, for one
    ; a style rule applies, a value of the rule around it whose application has `live-values`: each
    ; declaration of the rule that reads them is declared again as they change. Then whether those
    ; of a markup element read a local of the function the element is written in, which the function
    ; that declares them again does not keep, so that the application is declined where they are live.
    (let around (!= outer (. U32 max)))
    (let unit (if-expr around (. ([] (. facts style-applications) outer) unit) no-instance))
    (let written-tree (if-expr around (. ([] (. program modules) (. ([] (. instances rows) unit) module)) tree) tree))
    (let binding (if-expr around (. ([] (. instances rows) unit) binding) (. frame binding)))
    (let rooted (and (not around) (call (. written-tree roots-values) written)))
    (let live false)
    (let local false)
    (match? ([] (. written-tree nodes) written)
      (case (call .node-style-rule-application applied)
        (for (in value ([] (. written-tree children) (. applied args)))
          (for (in node (.. (call (. written-tree subtree-start) value) value))
            (match? ([] (. written-tree nodes) node)
              (case (call .node-get-expression row)
                (= live (or live (. row is-tracked)))
              )
              (case (call .node-identifier row)
                (= live (or live (. row is-tracked)))
                (if (not rooted)
                  (let resolution (call (. bindings resolution-of) binding node))
                  (if (and (== (. resolution kind) .resolve-slot) not-this)
                    (if around
                      (= live (or live (. ([] (. facts style-applications) outer) live-values)))
                      (else-if (!= (call (. facts row-item-of) instance node) no-type)
                        (= live true)
                      )
                      (else
                        (= local true)
                      )
                    )
                  )
                  (lazy not-this (!= (. ([] (. bindings slots) (. resolution slot)) kind) .slot-this))
                )
              )
            )
          )
        )
      )
    )
    (return (tuple live local))
  )
  (fn-do _ declares-only Bool
    (param unit InstanceId)
    (param body SyntaxId)
    (param gates (list StyleWhen))
    ; Whether a style rule applied under the condition a rule written on a markup element gives
    ; declares styles alone, as the reference requires of a rule so applied: its error is at the
    ; first line of its body that is no declaration, `when`, rule or generated content, or else at
    ; the first rule written in its body, or else in the body of one of its `when`s. True where no
    ; such condition gates it.
    (let conditioned false)
    (for (in held gates)
      (= conditioned (or conditioned (!= (. held test) no-instance)))
    )
    (if (or (not conditioned) (== body 0))
      (return true)
    )
    (let row ([] (. instances rows) unit))
    (let written (. ([] (. program modules) (. row module)) tree))
    (let lines (list SyntaxId))
    (match ([] (. written nodes) body)
      (case (call .node-block block)
        (for (in line ([] (. written children) (. block body)))
          (+= lines line)
        )
      )
      (default
        (+= lines body)
      )
    )
    (let found SyntaxId 0)
    (for (in line lines)
      (let kind ([] (. written nodes) line))
      (if (and (== found 0) undeclared (not (is kind .node-rule-syntax)) (not (call (. written generates) line)))
        (= found line)
      )
      (lazy undeclared (and (not (is kind .node-assign)) (not (is kind .node-style-when))))
    )
    (for (in line lines)
      (if (and (== found 0) (is ([] (. written nodes) line) .node-rule-syntax))
        (= found line)
      )
    )
    (for (in branch (call (. written rule-whens) body))
      (for (in line (call (. written when-lines) branch))
        (if (and (== found 0) (is ([] (. written nodes) line) .node-rule-syntax))
          (= found line)
        )
      )
    )
    (if (== found 0)
      (return true)
    )
    (call (. facts record-diagnostic)
      (block
        (arg instance)
        (arg (. row module))
        (arg found)
        (arg .stated)
        (arg (call (. program store-atom) "Conditionally applied style rules may only contain style declarations"))
        (arg no-type)
        (arg no-type)
      )
    )
    (return false)
  )
  (fn-do _ apply-inner U32
    (param id SyntaxId)
    (param made TypeId)
    (param unit InstanceId)
    (param nested SyntaxId)
    (param order U32)
    (param outer U32)
    (param within SyntaxId)
    (param gated (list StyleWhen))
    (param active (list InstanceId))
    (param applied (list InstanceId))
    (param around U32)
    (param cell U32 (= (. U32 max)))
    (param values U32 (= (. U32 max)))
    (param outer-cells U32 (= (. U32 max)))
    ; Applies a rule a style rule applies, written at `nested` in the rule's module, from an order,
    ; as `apply-rule` says, those of the style sheets the element sees where no class of its chain
    ; answers the name (`sheet-rules`), within the rules applied `around` it, the state cells of the
    ; `when`s among them and the values of the one that takes some, and then those written in rules
    ; that the markup sees (`scope-rules`), each within its own. Declined: one with a
    ; condition, one a rule written in a rule may answer where those are not known, or that the
    ; rules the element applied before bring into view, which the reference sees as it gathers them
    ; but not as it applies them; a name some class or style sheet has but none takes the values
    ; given by, values given to rules of style sheets other than the one the rule's class chose for
    ; them (`sheet-values-alike`) or to a rule written in a rule, and a value that calls a function where
    ; the reference evaluates it once more but not here: it evaluates those the rules after the name
    ; of a rule a markup element applies give as it prepares the element, and again as the rule is
    ; applied, and the emitter does too (`prepared-rule`, marked on the rule's application). A
    ; constructor applying its rule `• This` or the rules of its root `<This` (`values-once`)
    ; evaluates them once.
    (let row ([] (. instances rows) unit))
    (let owner ([] (. program modules) (. row module)))
    (match? ([] (. owner tree nodes) nested)
      (case (call .node-style-rule-application inner)
        (if (or conditional (call overlay-rule (. inner name)) (call names-scope element-scopes (. inner name)))
          (call decline id)
          (return (. U32 max))
        )
        (lazy conditional (!= (. inner condition) 0))
        (let given (list TypeId))
        (let evaluated false)
        (for (in value ([] (. owner tree children) (. inner args)))
          (let type (call (. facts node-type) unit value))
          (let runs (and (not (. preparing values-once)) (call runs-code unit (. owner tree) value)))
          (if (or untyped (and runs (not (call prepared-rule id outer within))))
            (call decline id)
            (return (. U32 max))
          )
          (lazy untyped (or (== type no-type) (== type invalid-type)))
          (= evaluated (or evaluated runs))
          (+= given type)
        )
        (let (tuple level member taken mismatch) (call match-style-rule made (. inner name) given))
        (if (and (== level invalid-type) (call report-argument-types member))
          (return (. U32 max))
        )
        (let scoped (list ScopeUse))
        (let none (list ScopeUse))
        (let (tuple scoping found missed) (call scope-rules made (. inner name) given none scoped (. U32 max)))
        (if (== scoping 2)
          (return (. U32 max))
        )
        (if (or (!= scoping 0) (== level invalid-type) unscoped scoped-given)
          (call decline id)
          (return (. U32 max))
        )
        (lazy unscoped (and taken (== level no-type) (== (. scoped length) 0)))
        (lazy scoped-given (and (!= (. scoped length) 0) (!= (. given length) 0)))
        (let next order)
        (if (== level no-type)
          (let sheets (list TypeId))
          (let members (list DeclRef))
          (let gates (list U64))
          (let (tuple status writes last)
            (call sheet-rules
              (block
                (arg made)
                (arg (. inner name))
                (arg given)
                (arg 0)
                (arg sheets)
                (arg members)
                (arg gates)
                (arg (. U32 max))
              )
            )
          )
          (if (or (!= status 0) (and (!= (. given length) 0) (if-expr (== (. sheets length) 0) writes (not (call sheet-values-alike (. row self-type) (. inner name) given sheets members)))))
            (call decline id)
            (return (. U32 max))
          )
          (let gives (if-expr (!= (. given length) 0) nested 0))
          (for (in position (..< 0 (. sheets length)))
            (let recorded (. facts style-applications length))
            (let inner-unit (call rule-unit ([] sheets position) ([] members position) made id))
            (= next
              (call apply-unit
                (block
                  (arg id)
                  (arg made)
                  (arg inner-unit)
                  (arg next)
                  (arg gives)
                  (arg outer)
                  (arg within)
                  (arg gated)
                  (arg active)
                  (arg applied)
                  (arg (. row module))
                  (arg nested)
                  (arg around)
                  (arg cell)
                  (arg values)
                  (arg outer-cells)
                )
              )
            )
            (if (or (== next (. U32 max)) (not (call gate-applications (as recorded U32) ([] sheets position) ([] gates position) id)))
              (return (. U32 max))
            )
            (if (and (!= gives 0) (not (call bind-given-slots (as recorded U32) nested inner-unit (. row module) unit)))
              (return (. U32 max))
            )
            (= (. ([] (. facts style-applications) recorded) prepared) evaluated)
            (call revise-application (as recorded U32))
            (if (!= gives 0)
              (call share-written-values (as recorded U32) (. owner tree) (. row binding))
            )
          )
          (else
            (if (!= (. given length) 0)
              (let (tuple own chosen named last) (call match-style-rule (. row self-type) (. inner name) given))
              (if (or (!= own level) (!= (. chosen module) (. member module)) (!= (. chosen decl) (. member decl)))
                (call decline id)
                (return (. U32 max))
              )
            )
            (let gives (if-expr (!= (. given length) 0) nested 0))
            (let recorded (. facts style-applications length))
            (= next
              (call apply-unit
                (block
                  (arg id)
                  (arg made)
                  (arg (call rule-unit level member made id))
                  (arg next)
                  (arg gives)
                  (arg outer)
                  (arg within)
                  (arg gated)
                  (arg active)
                  (arg applied)
                  (arg (. row module))
                  (arg nested)
                  (arg around)
                  (arg cell)
                  (arg values)
                  (arg outer-cells)
                )
              )
            )
            (if (== next (. U32 max))
              (return (. U32 max))
            )
            (= (. ([] (. facts style-applications) recorded) prepared) evaluated)
            (call revise-application (as recorded U32))
            (if (!= gives 0)
              (call share-written-values (as recorded U32) (. owner tree) (. row binding))
            )
          )
        )
        (for (in use scoped)
          (if (!= (. use scope frames) (. U32 max))
            (+= framed 1)
          )
          (= next
            (call apply-unit
              (block
                (arg id)
                (arg made)
                (arg (call scope-unit (. use scope) made))
                (arg next)
                (arg 0)
                (arg outer)
                (arg within)
                (arg gated)
                (arg active)
                (arg applied)
                (arg (. row module))
                (arg nested)
                (arg (. use scope frames))
                (arg (. use cell))
                (arg (. use values))
                (arg (. use outer-cells))
              )
            )
          )
          (if (== next (. U32 max))
            (return (. U32 max))
          )
        )
        (return next)
      )
    )
    (call decline id)
    (return (. U32 max))
  )
  (fn-do _ prepared-rule Bool
    (param id SyntaxId)
    (param outer U32)
    (param within SyntaxId)
    ; Whether a rule a style rule applies, by the application `outer`, is one the reference prepares
    ; as it prepares the markup element `id` whose rules are being applied (`preparing.site`), before
    ; its object is made (`nestedRuleScopesForPrepared`): one written after the name of a rule the
    ; element applies, or after that of one so prepared, but not in the body of a `when`.
    (if (or (== (. preparing site) 0) (!= id (. preparing site)) (!= within 0))
      (return false)
    )
    (let position outer)
    (while (!= position (. U32 max))
      (let held ([] (. facts style-applications) position))
      (if (or (!= (. held within) 0) (!= (. held instance) instance))
        (return false)
      )
      (= position (. held outer))
    )
    (return true)
  )
  (fn-expr _ sheet-values-alike Bool
    (param class TypeId)
    (param name Atom)
    (param given (list TypeId))
    (param sheets (list TypeId))
    (param members (list DeclRef))
    ; Whether the rules of the style sheets an element sees that values a style rule gives choose
    ; are one, and the one the class or sheet that writes the style rule chooses (`own-sheet-rule`),
    ; to whose types the values were converted where they are written (`type-applied-values`).
    (case? (and (!= (. sheets length) 1) (not (call variants-alike sheets members)))
      false
    )
    (default
      (and (!= (. chosen decl) 0) (== (. chosen module) (. ([] members 0) module)) (== (. chosen decl) (. ([] members 0) decl)))
    )
    (where
      (lazy chosen (call own-sheet-rule class name given))
    )
  )
  (fn-do _ own-sheet-rule DeclRef
    (param level TypeId)
    (param name Atom)
    (param given (list TypeId))
    ; The rule of style sheets a class or a style sheet that writes a style rule chooses for the
    ; values it gives a rule it applies, where no class of its chain answers the name: the one of
    ; the sheets the class uses that they choose, or for a sheet, which uses none, the one sheet of
    ; the program with a rule they choose (`program-sheet-rule`). None where there is no one rule.
    (let sheets (list TypeId))
    (let members (list DeclRef))
    (let gates (list U64))
    (let (tuple status writes last) (call sheet-rules level name given 0 sheets members gates (. U32 max) true))
    (if (or (!= status 0) (> (. sheets length) 1))
      (return (call DeclRef 0 0))
    )
    (if (== (. sheets length) 1)
      (return ([] members 0))
    )
    (if (!= (call (. types intrinsic-of) level) .style-sheet)
      (return (call DeclRef 0 0))
    )
    (return (call program-sheet-rule name given))
  )
  (fn-do _ program-sheet-rule DeclRef
    (param name Atom)
    (param given (list TypeId))
    ; The rule of a name that values given choose among the style sheets of the program that write
    ; one (`match-rules-of`), in modules the module being typed shares a case with, where only one
    ; sheet has such a rule, or none where no sheet or more than one does, or the rule takes a type
    ; not known here.
    (let sheets (list DeclRef))
    (let position (call (. facts first-style-rule) name))
    (while (!= position (. U32 max))
      (let ref ([] (. facts style-rules) position))
      (= position ([] (. facts style-rule-nexts) position))
      (if (not (call (. program shares-case) module (. ref module)))
        (continue)
      )
      (match? ([] (. ([] (. program modules) (. ref module)) decls) (. ref decl))
        (case (call .decl-style-rule rule)
          (if (and (!= (. rule owner) 0) (call is-sheet-decl (. ref module) (. rule owner)))
            (let sheet
              (scope (?? (call extended-sheet owner-ref) (call DeclRef (. ref module) (. rule owner)))
                (lazy owner-ref (call DeclRef (. ref module) (. rule owner)))
              )
            )
            (let seen false)
            (for (in held sheets)
              (if (and (== (. held module) (. sheet module)) (== (. held decl) (. sheet decl)))
                (= seen true)
              )
            )
            (if (not seen)
              (+= sheets sheet)
            )
          )
        )
      )
    )
    (let chosen (call DeclRef 0 0))
    (for (in sheet sheets)
      (let level (call (. types class-with-args) (. sheet module) (. sheet decl) (. scratch types mark)))
      (if (!= (call family-root level) level)
        (continue)
      )
      (let (tuple found written kind named last) (call match-rules-of level name given (. U32 max)))
      (if found
        (if (or (!= (. chosen decl) 0) (== kind (. U32 max)))
          (return (call DeclRef 0 0))
        )
        (= chosen written)
      )
    )
    (return chosen)
  )
  (fn-do _ apply-unit U32
    (param id SyntaxId)
    (param made TypeId)
    (param unit InstanceId)
    (param order U32)
    (param gives SyntaxId)
    (param outer U32)
    (param within SyntaxId)
    (param gated (list StyleWhen))
    (param active (list InstanceId))
    (param applied (list InstanceId))
    (param owner ModuleId)
    (param nested SyntaxId)
    (param frames U32)
    (param cell U32 (= (. U32 max)))
    (param values U32 (= (. U32 max)))
    (param outer-cells U32 (= (. U32 max)))
    ; Applies the rule a style rule applies at `nested` in a module, within the rules applied
    ; around it (`frames`), the state cells of the `when`s around it and the values of the rule around
    ; it that takes some, as `apply-rule` says, where the element's vocabulary answers its properties
    ; as the rule's does and it does not come to apply itself again, the reference's error.
    (if (or (== unit no-instance) (not (call answers-alike unit made id)))
      (call decline id)
      (return (. U32 max))
    )
    (let cycle (call (. active find) unit))
    (if cycle
      (call report-recursion active cycle unit owner nested)
      (return (. U32 max))
    )
    (return
      (call apply-rule
        (block
          (arg id)
          (arg made)
          (arg unit)
          (arg order)
          (arg gives)
          (arg outer)
          (arg within)
          (arg gated)
          (arg active)
          (arg applied)
          (arg frames)
          (arg cell)
          (arg values)
          (arg false)
          (arg outer-cells)
        )
      )
    )
  )
  (fn-do _ generate-content U32
    (param id SyntaxId)
    (param made TypeId)
    (param unit InstanceId)
    (param index U32)
    (param lines (list SyntaxId))
    (param gates (list StyleWhen))
    ; Types the content the lines of a style rule given generate where the rule is applied to the
    ; markup element `id`, by the application `index` of `style-applications`, under the `when`s
    ; `gates`, as the reference's `compileGuardedContent` makes it: each line is built by a function
    ; of its own, typed in the rule's module for what the element sees (`demand-content`), which a
    ; record of the style runtime holds for the element's object as a `MarkupElement`; under `when`s,
    ; an action of its own enables the record as they hold (`demand-style-content`), first where the
    ; element is made, where what enabling it raises leaves the function. None is
    ; generated where the reference generates none: by the rule `• This` (`content-off`), and by the
    ; rules the markup a function that builds generated content makes applies (`generating`).
    ; Answers how many lines generate content, each taking an order, or `U32.max` where one is
    ; declined or reported: by the rules a root `<This` applies in a constructor (`content-refused`),
    ; at a slot outlet, and where the element's object takes no content through the markup protocol,
    ; the reference's error. The values of the rules around rules written in rules the content sees
    ; are those the element holds, which the function keeps (`content-view`), and so are the state
    ; cells of the `when`s around them.
    (if (and (!= (. lines length) 0) (. preparing content-refused))
      (call decline id)
      (return (. U32 max))
    )
    (if (or (== (. lines length) 0) (. preparing content-off) (not (call generating)))
      (return 0)
    )
    (if (not (is ([] (. tree nodes) id) .node-markup))
      (call decline id)
      (return (. U32 max))
    )
    (if (not (call is-markup-host made))
      (call (. frame diagnose)
        (block
          (arg id)
          (arg .stated)
          (arg (call (. program store-atom) "Generated style content requires a MarkupElement target"))
        )
      )
      (return (. U32 max))
    )
    (let carried (list U32))
    (let cells (list U32))
    (let context (call content-view id carried cells))
    (let host (call (. types well-known-type) "core/markup" "MarkupElement"))
    (if (or (== context (. U32 max)) (== host invalid-type) (not (call demand-style-content made gates)))
      (call decline id)
      (return (. U32 max))
    )
    (if (== (call (. conversions convert) id id made host .reason-markup-host) invalid-type)
      (return (. U32 max))
    )
    (if (and (!= (. gates length) 0) (not (call raises-out id (. facts style-runtime content-enabled))))
      (call decline id)
      (return (. U32 max))
    )
    (let builder (call builder-type host no-type))
    (let row ([] (. instances rows) unit))
    (let written (. ([] (. program modules) (. row module)) tree))
    (let value-first (as (. facts content-values length) U32))
    (for (in held carried)
      (+= (. facts content-values) held)
    )
    (let cell-first (as (. facts content-cells length) U32))
    (for (in held cells)
      (+= (. facts content-cells) held)
    )
    (for (in line lines)
      (let callee (call demand-content unit line context))
      (if (or (== callee no-instance) (== builder invalid-type))
        (call decline id)
        (return (. U32 max))
      )
      (let closure
        (call (. types intern-closure)
          (block
            (arg (. row module))
            (arg (. ([] (. instances rows) callee) decl))
            (arg callee)
            (arg ([] (. instances stable-keys) callee))
          )
        )
      )
      (call (. conversions record-made) callee line closure builder)
      (let slot (. U32 max))
      (match? ([] (. written nodes) line)
        (case (call .node-markup element)
          (let name (call (. written identifier-name) (. element slot-binding)))
          (= slot (if-expr name (call slot-number (. name text)) (. U32 max)))
        )
      )
      (+= (. facts style-contents)
        (call StyleContent
          (block
            (arg instance)
            (arg id)
            (arg index)
            (arg line)
            (arg slot)
            (arg callee)
            (arg closure)
            (arg value-first)
            (arg (as (. carried length) U32))
            (arg cell-first)
            (arg (as (. cells length) U32))
          )
        )
      )
    )
    (return (as (. lines length) U32))
  )
  (fn-do _ generating Bool
    ; Whether the rules markup written here applies generate content, as the reference's
    ; `markupStyleContentEnabled` says: not in a function that builds generated content, nor in one
    ; it encloses.
    (let around instance)
    (while (!= around no-instance)
      (let context (. ([] (. instances rows) around) context))
      (if (and (!= context (. U32 max)) (!= (. ([] (. instances contexts) context) layer) 0))
        (return false)
      )
      (= around (. ([] (. instances rows) around) enclosing))
    )
    (return true)
  )
  (fn-do _ content-view U32
    (param id SyntaxId)
    (param carried (list U32))
    (param cells (list U32))
    ; The context of the function that builds content a style rule generates at a markup element,
    ; as the reference's `markupStyleContext` gives it there: the styles the markup written here sees,
    ; the first to answer a name first, the style sheets it sees in their groups, the rules written in
    ; rules it sees, with those the element's own rules bring into view (`push-scopes`), each with
    ; how many state cells of the `when`s around it it is seen under, which the function keeps, the
    ; outermost first, as `cells` gathers them, and where the values of the rule around it that
    ; takes some are among those it keeps, which are `carried` (`place-values`); and the layer its
    ; declarations take. `U32.max` where those are not known here, or a cell is not carried here.
    (if (not (call sheets-known))
      (return (. U32 max))
    )
    (if (and (not (call scopes-known)) (call nested-any))
      (return (. U32 max))
    )
    (let styles (list TypeId))
    (for (in position (..< 0 (. markup-styles length)))
      (+= styles ([] markup-styles (- (. markup-styles length) 1 position)))
    )
    (let sheets (list TypeId))
    (let levels (list U32))
    (call seen-sheets sheets levels)
    (let scopes (list RuleScope))
    (let counts (list U32))
    (let seen (. rule-scopes length))
    (call push-content-scopes id)
    (let known true)
    (for (in use rule-scopes)
      (+= scopes (. use scope))
      (+= counts (if-expr (== (. use cell) (. U32 max)) 0u32 (+ 1 (call (. facts link-count) (. use outer-cells)))))
      (if (== (. use cell) (- (. U32 max) 1))
        (= known false)
        (else-if (!= (. use cell) (. U32 max))
          (call (. facts link-cells) (. use outer-cells) cells)
          (+= cells (. use cell))
        )
      )
    )
    (let valued (list U32))
    (let value-types (list TypeId))
    (= known (and known (call place-values 0 valued value-types carried)))
    (while (> (. rule-scopes length) seen)
      (call (. rule-scopes pop))
    )
    (if (not known)
      (return (. U32 max))
    )
    (return
      (call (. instances intern-context)
        (block
          (arg styles)
          (arg sheets)
          (arg levels)
          (arg scopes)
          (arg counts)
          (arg no-type)
          (arg (call markup-layer))
          (arg valued)
          (arg value-types)
        )
      )
    )
  )
  (fn-do _ demand-content InstanceId
    (param unit InstanceId)
    (param line SyntaxId)
    (param context U32)
    ; The function that builds the content a line of a style rule generates, the line's function in
    ; the frame of the instance `unit` that types the rule, typed once for each context
    ; (`check-content`). None where the line has no function, or its function captures.
    (let row ([] (. instances rows) unit))
    (let decl (call content-decl (. row module) line))
    (if (== decl 0)
      (return no-instance)
    )
    (let effects (call callee-effects frame (. row module) decl))
    (let callee
      (call (. instances intern)
        (block
          (arg (. row module))
          (arg decl)
          (arg no-type)
          (arg effects)
          (arg unit)
          (arg (. scratch no-types))
          (arg (. scratch no-types))
          (arg true)
          (arg no-type)
          (arg (. U32 max))
          (arg false)
          (arg 0)
          (arg no-type)
          (arg (call (of ImmutableArray U32 ArenaBacking)))
          (arg (call (of ImmutableArray U32 ArenaBacking)))
          (arg context)
        )
      )
    )
    (if (== (. ([] (. instances rows) callee) state) .instance-unstarted)
      (let writer (call settled unit))
      (call run-within callee writer)
      (call (. writer dismiss))
    )
    (return callee)
  )
  (fn-do _ content-decl DeclId
    (param module ModuleId)
    (param line SyntaxId)
    ; The function of a line of a style rule that generates content, which the main code of its
    ; module declares, where it captures nothing; or none.
    (let binding (call (. session binder bind) module (. ([] (. program modules) module) main-decl)))
    (let row ([] (. bindings bindings) binding))
    (for (in offset (..< 0 (. row nested count)))
      (let nested ([] (. bindings nested) (+ (. row nested start) offset)))
      (if (== (. nested syntax) line)
        (return (if-expr (== (. nested captures count) 0) (. nested decl) 0))
      )
    )
    (return 0)
  )
  (fn-do _ demand-style-content Bool
    (param made TypeId)
    (param gates (list StyleWhen))
    ; The functions of the style runtime generated content calls, typed once: the record of a line's
    ; content, made for an association, and what enables it; and, under `when`s, the row of
    ; `style-gates` that enables the record as they hold, with the action that runs its function.
    (if (not (call demand-style-sites))
      (return false)
    )
    (let runtime (. facts style-runtime))
    (let module-id (. (call class-ref types (call (. types type-row) .style)) module))
    (if (== (. runtime template-content) no-instance)
      (let association (call (. types well-known-type) "core/style" "StyleSiteAssociation"))
      (let host (call (. types well-known-type) "core/markup" "MarkupElement"))
      (let builder (if-expr (!= host invalid-type) (call builder-type host no-type) invalid-type))
      (if (or (== association invalid-type) (== builder invalid-type))
        (return false)
      )
      (let mark (. scratch types mark))
      (call (. scratch types push) association)
      (call (. scratch types push) host)
      (call (. scratch types push) (call (. types type-row) .uint32))
      (call (. scratch types push) (call (. types type-row) .uint32))
      (call (. scratch types push) builder)
      (= (. runtime template-content)
        (call (. calls demand-runtime-call)
          (block
            (arg module-id)
            (arg no-type)
            (arg (call (. program store-atom) "style-template-content"))
            (arg mark)
          )
        )
      )
      (call (. scratch types rewind) mark)
      (if (== (. runtime template-content) no-instance)
        (return false)
      )
      (call (. scratch types push) (. ([] (. instances signatures) (. runtime template-content)) returns))
      (call (. scratch types push) (. types bool-type))
      (= (. runtime content-enabled)
        (call (. calls demand-runtime-call)
          (block
            (arg module-id)
            (arg no-type)
            (arg (call (. program store-atom) "style-content-set-enabled"))
            (arg mark)
          )
        )
      )
      (call (. scratch types rewind) mark)
      (= (. facts style-runtime) runtime)
    )
    (if (or (== (. runtime template-content) no-instance) (== (. runtime content-enabled) no-instance))
      (return false)
    )
    (if (== (. gates length) 0)
      (return true)
    )
    (let action (call demand-style-gates made))
    (if (== action no-instance)
      (return false)
    )
    (call record-gate made gates action true)
    (return true)
  )
  (fn-do + scope-rules (tuple U32 Bool U32)
    (param made TypeId)
    (param name Atom)
    (param given (list TypeId))
    (param extra (list ScopeUse))
    (param matched (list ScopeUse))
    (param mismatch U32)
    ; The rules written in rules that markup sees (`rule-scopes`), and then those of `extra`, that
    ; an application of a name answers at an element of a class, as the reference's `resolveMatch`
    ; adds them after the rules of the classes and the style sheets, in the order they came into
    ; view: each of the name taking as many values as are given, each convertible to the type the
    ; rule takes it as, but none that reaches only the markup of an element not yet filled
    ; (`scope-pending`). Answers 0, 1 where one is declined and 2 where one is reported: declined
    ; where it has a rule around it that takes values, or around which the state cells of `when`s are
    ; not carried (`plain-frames`), or whose types are not known here, and reported where those types
    ; are written wrong (`report-argument-types`); whether one has the name; and the place of the
    ; last value found not to convert, or `mismatch`.
    (let named false)
    (let missed mismatch)
    (let count (+ (. rule-scopes length) (. extra length)))
    (for (in position (..< 0 count))
      (let use
        (scope (if-expr (< position (. rule-scopes length)) ([] rule-scopes position) extra-use)
          (lazy extra-use ([] extra (- position (. rule-scopes length))))
        )
      )
      (let scope (. use scope))
      (if (== (. scope own) .scope-pending)
        (continue)
      )
      (let owner ([] (. program modules) (. scope module)))
      (match? ([] (. owner decls) (. scope decl))
        (case (call .decl-style-rule rule)
          (if (!= (. rule name) name)
            (continue)
          )
          (= named true)
          (if (!= (call (. owner tree rule-takes) (. rule syntax)) (. given length))
            (continue)
          )
          (let wanted (call scope-argument-types scope))
          (if (not wanted)
            (return (tuple (if-expr (call report-argument-types (call DeclRef (. scope module) (. scope decl))) 2u32 1u32) named missed))
          )
          (let fits true)
          (for (in place (..< 0 (. given length)))
            (if (not (call relation-legal (call (. conversions compare-held) ([] given place) ([] wanted place))))
              (= missed (as place U32))
              (= fits false)
              (break)
            )
          )
          (if (not fits)
            (continue)
          )
          (if (not (call plain-frames use))
            (return (tuple 1 named missed))
          )
          (+= matched use)
        )
      )
    )
    (return (tuple 0 named missed))
  )
  (fn-do _ names-scope Bool
    (param scopes (list ScopeUse))
    (param name Atom)
    ; Whether a rule written in a rule among those given has a name, but for one that matches nothing
    ; yet (`scope-pending`).
    (for (in use scopes)
      (if (== (. use scope own) .scope-pending)
        (continue)
      )
      (match? ([] (. ([] (. program modules) (. use scope module)) decls) (. use scope decl))
        (case (call .decl-style-rule rule)
          (if (== (. rule name) name)
            (return true)
          )
        )
      )
    )
    (return false)
  )
  (fn-do _ plain-frames Bool
    (param use ScopeUse)
    ; Whether the rules applied around a rule written in a rule hold it under `when`s whose state
    ; cells are here, one for each, and one of them at most takes values, which are here, which is
    ; all that is modeled of them.
    (if (or (== (. use cell) (- (. U32 max) 1)) (== (. use values) (- (. U32 max) 1)))
      (return false)
    )
    (let gates U32)
    (let valued U32)
    (let frame (. use scope frames))
    (while (!= frame (. U32 max))
      (let held ([] (. instances frames) frame))
      (if (!= (. held gate) 0)
        (+= gates 1)
      )
      (let owner ([] (. program modules) (. held module)))
      (match? ([] (. owner decls) (. held decl))
        (case (call .decl-style-rule rule)
          (if (and (== (. held gate) 0) (!= (call (. owner tree rule-takes) (. rule syntax)) 0))
            (if (or (== (. use values) (. U32 max)) (!= (. ([] (. facts scope-values) (. use values)) frame) frame))
              (return false)
            )
            (+= valued 1)
          )
        )
      )
      (= frame (. held outer))
    )
    (let cells (if-expr (== (. use cell) (. U32 max)) 0u32 (+ 1 (call (. facts link-count) (. use outer-cells)))))
    (return (and (== gates cells) (== valued (if-expr (== (. use values) (. U32 max)) 0u32 1u32))))
  )
  (fn-do _ scope-unit InstanceId
    (param scope RuleScope)
    (param made TypeId)
    ; The instance that types a rule written in a rule for an element of a class it is matched at,
    ; as the reference matches it (`targetOwner`): for its style sheet and the element's class where
    ; a sheet holds it, else for the element's class; typed now, or none where it is being typed
    ; already.
    (let sheet (== (call (. types intrinsic-of) (. scope owner)) .style-sheet))
    (let unit
      (call (. instances intern-initializer)
        (block
          (arg (. scope module))
          (arg (. scope decl))
          (arg (if-expr sheet (. scope owner) made))
          (arg (if-expr sheet made no-type))
        )
      )
    )
    (if (== (. ([] (. instances rows) unit) state) .instance-in-progress)
      (return no-instance)
    )
    (call demand-body unit)
    (call (. panics note-inlined) instance unit)
    (return unit)
  )
  (fn-do _ bring-scopes Bool
    (param id SyntaxId)
    (param made TypeId)
    (param unit InstanceId)
    (param around U32)
    (param gated (list StyleWhen))
    (param cell U32)
    (param values U32)
    (param outer-cells U32)
    ; Brings into view the rules written in a style rule applied to an element, which the markup
    ; its object makes and its body see (`collected`), as the reference's `styleRuleNestedScopes`
    ; gives them: those of its body, under the state cells the rule is applied under (`cell`, and
    ; `outer-cells` further out), then those of each of its `when`s, under its own (`when-cell`)
    ; within those (`outer-links`), each within the rules applied `around` them, under the `when` for
    ; those of one, and reading the `values` of the one that takes some. A rule applied under a
    ; `when` that is not a state cell may hold none, as the reference reports at the first.
    (let row ([] (. instances rows) unit))
    (let owner ([] (. program modules) (. row module)))
    (let scopes (list ScopeUse))
    (let first SyntaxId 0)
    (match? ([] (. owner decls) (. row initializer))
      (case (call .decl-style-rule rule)
        (let body (call (. owner tree rule-body) (. rule syntax)))
        (match? ([] (. owner tree nodes) body)
          (case (call .node-block block)
            (for (in statement ([] (. owner tree children) (. block body)))
              (if (is ([] (. owner tree nodes) statement) .node-rule-syntax)
                (if (== first 0)
                  (= first statement)
                )
                (+= scopes
                  (call ScopeUse
                    (block
                      (arg
                        (call RuleScope
                          (block
                            (arg (. row module))
                            (arg (call nested-decl (. row module) (. row initializer) statement))
                            (arg (. row self-type))
                            (arg around)
                            (arg (call scope-own (. owner tree) statement))
                          )
                        )
                      )
                      (arg cell)
                      (arg values)
                      (arg outer-cells)
                    )
                  )
                )
              )
            )
          )
        )
        (for (in branch (call (. owner tree rule-whens) body))
          (let gate (. U32 max))
          (let held (. U32 max))
          (let links (. U32 max))
          (for (in line (call (. owner tree when-lines) branch))
            (if (is ([] (. owner tree nodes) line) .node-rule-syntax)
              (if (== first 0)
                (= first line)
              )
              (if (== gate (. U32 max))
                (= gate
                  (call (. instances intern-frame)
                    (block
                      (arg around)
                      (arg (. row module))
                      (arg (. row initializer))
                      (arg (. row self-type))
                      (arg branch)
                    )
                  )
                )
                (= held
                  (block
                    (case? collecting
                      (call when-cell cell id made (. row module) branch)
                    )
                    (default
                      (- (. U32 max) 1)
                    )
                  )
                )
                (= links (call outer-links held cell outer-cells))
              )
              (+= scopes
                (call ScopeUse
                  (block
                    (arg
                      (call RuleScope
                        (block
                          (arg (. row module))
                          (arg (call nested-decl (. row module) (. row initializer) line))
                          (arg (. row self-type))
                          (arg gate)
                          (arg (call scope-own (. owner tree) line))
                        )
                      )
                    )
                    (arg held)
                    (arg values)
                    (arg links)
                  )
                )
              )
            )
          )
        )
      )
    )
    (if (== first 0)
      (return true)
    )
    (for (in held gated)
      (if (== (. held cell) (. U32 max))
        (call (. facts record-diagnostic)
          (block
            (arg instance)
            (arg (. row module))
            (arg first)
            (arg .stated)
            (arg
              (call (. program store-atom)
                (block
                  (arg "Conditionally applied style rules may only contain style declarations")
                )
              )
            )
            (arg no-type)
            (arg no-type)
          )
        )
        (return false)
      )
    )
    (if collecting
      (for (in use scopes)
        (+= collected use)
      )
    )
    (return true)
  )
  (fn-do _ when-cell U32
    (param cell U32)
    (param site SyntaxId)
    (param owner TypeId)
    (param module ModuleId)
    (param branch SyntaxId)
    ; The state cell of a `when` of a style rule whose body holds rules written in it, made at a site
    ; (`scope-cell`), as the reference binds the last frame around such a rule; `U32.max - 1`, a cell
    ; not carried, where the rule is applied under the state cell of a `when` that is not carried.
    (if (== cell (- (. U32 max) 1))
      (return (- (. U32 max) 1))
    )
    (return (call scope-cell site owner module branch))
  )
  (fn-do _ outer-links U32
    (param held U32)
    (param cell U32)
    (param outer-cells U32)
    ; The state cells further out than that of a `when` (`held`) of a style rule applied under the
    ; cell `cell` and those further out, `outer-cells`: those with `cell` before them, where it is one;
    ; none where `held` is not carried.
    (if (>= held (- (. U32 max) 1))
      (return (. U32 max))
    )
    (if (>= cell (- (. U32 max) 1))
      (return outer-cells)
    )
    (return (call (. facts scope-link) cell outer-cells))
  )
  (fn-do + outlet-applications U32
    (param class TypeId)
    (param name Atom)
    (param content TypeId)
    ; Brings into view the rules written in rules that the rules the outlet of the slot of a name of a
    ; class applies after `•` bring to what the slot is given, as the reference's
    ; `markupStyleRuleScopesForApplications` gathers them for the slot's type `content` there. Answers
    ; 0; 3, bringing none, where one is under the state cell of a `when`, which the function that
    ; builds the content binds to what it builds (`root-applications`); or 2 where one is declined:
    ; one with values, and the rules of an outlet a line forwards.
    (let (tuple owner outlet) (call slot-outlet class name))
    (if (== owner no-type)
      (return 0)
    )
    (let ref (call class-ref types owner))
    (let written (. ([] (. program modules) (. ref module)) tree))
    (match? ([] (. written nodes) outlet)
      (case (call .node-slot-outlet row)
        (for (in application ([] (. written children) (. row style-rule-applications)))
          (match? ([] (. written nodes) application)
            (case (call .node-style-rule-application applied)
              (if (and (call scoping-named (. applied name)) (!= (. applied args count) 0))
                (return 2)
              )
            )
          )
        )
        (let none (list Atom))
        (let gathered (list ScopeUse))
        (let own-keying keying)
        (= keying (call Keying true (. keying sheet-self) (. ref module) outlet))
        (let gathering
          (call gather-scopes
            (block
              (arg content)
              (arg none)
              (arg (. row style-rule-applications))
              (arg outlet)
              (arg content)
              (arg gathered)
              (arg written)
            )
          )
        )
        (= keying own-keying)
        (if (not gathering)
          (return 2)
        )
        (for (in use gathered)
          (if (!= (. use cell) (. U32 max))
            (return 3)
          )
        )
        (for (in use gathered)
          (+= rule-scopes use)
        )
      )
      (case .node-markup-slot-forward
        (if (call outlet-applies class name)
          (return 2)
        )
      )
    )
    (return 0)
  )
  (fn-do _ outlet-applies Bool
    (param class TypeId)
    (param name Atom)
    ; Whether the outlet of the slot of a name of a class, or that of the class whose slot a line
    ; forwards it to, applies after `•` a rule whose name some rule that brings rules written in rules
    ; has, which brings them to what the slot is given, which is declined.
    (let (tuple owner outlet) (call slot-outlet class name))
    (if (== owner no-type)
      (return false)
    )
    (let ref (call class-ref types owner))
    (let written (. ([] (. program modules) (. ref module)) tree))
    (match? ([] (. written nodes) outlet)
      (case (call .node-slot-outlet row)
        (for (in application ([] (. written children) (. row style-rule-applications)))
          (match? ([] (. written nodes) application)
            (case (call .node-style-rule-application applied)
              (if (call scoping-named (. applied name))
                (return true)
              )
            )
          )
        )
      )
      (case .node-markup-slot-forward
        (let element (call (. written holder-of) (call (. written holder-of) outlet)))
        (match? ([] (. written nodes) element)
          (case (call .node-markup made)
            (let args (call (of RowRange TypeId)))
            (match? ([] (. types rows) owner)
              (case (call .type-class row)
                (= args (. row args))
              )
            )
            (let env (call (. types class-env-for) (. ref module) (. ref decl) args owner))
            (let host (call (. types evaluate-type) (. ref module) written (. made type-id) env))
            (call (. types env-release) env)
            (if (or (== host invalid-type) (== host no-type) (!= (call (. types intrinsic-of) host) .class))
              (return true)
            )
            (return (call outlet-applies host name))
          )
        )
      )
    )
    (return false)
  )
  (fn-do _ cell-whens (? (list StyleWhen))
    (param id SyntaxId)
    (param made TypeId)
    (param gated (list StyleWhen))
    (param cell U32)
    (param outer-cells U32)
    (param index U32)
    ; The `when`s that gate a style rule applied under those given, as the reference's
    ; `styleScopeStateConditions` puts the state cells of the `when`s around a rule written in a rule
    ; before them, the outermost first, but those they hold already: its gate is recorded once
    ; (`StyleGate`) and the application of the rule is marked with the cells, the innermost as its
    ; `cell` and those further out as its `outer-cells`. None where it is declined.
    (if (== cell (. U32 max))
      (return gated)
    )
    (let chain (list U32))
    (call (. facts link-cells) outer-cells chain)
    (+= chain cell)
    (let missing (list U32))
    (for (in held chain)
      (let holds false)
      (for (in place gated)
        (= holds (or holds (== (. place cell) held)))
      )
      (if (not holds)
        (+= missing held)
      )
    )
    (if (== (. missing length) 0)
      (return gated)
    )
    (let action (call demand-style-gates made))
    (if (or (== action no-instance) (== (. instances live track) no-instance))
      (call decline id)
      (return null)
    )
    (let whens (list StyleWhen))
    (for (in held missing)
      (let row ([] (. facts scope-cells) held))
      (+= whens (call StyleWhen (. row module) (. row when) held))
    )
    (for (in held gated)
      (+= whens held)
    )
    (call record-gate made whens action)
    (= (. ([] (. facts style-applications) index) cell) ([] missing (- (. missing length) 1)))
    (call revise-application index)
    (let links (. U32 max))
    (for (in position (..< 0 (- (. missing length) 1)))
      (= links (call (. facts scope-link) ([] missing position) links))
    )
    (= (. ([] (. facts style-applications) index) outer-cells) links)
    (call revise-application index)
    (return whens)
  )
  (fn-do _ same-scopes Bool
    (param id SyntaxId)
    ; Whether the rules written in rules that the style rules a markup element applies brought into
    ; view (`element-scopes`) are those it was made seeing.
    (let (tuple start end) (call scopes-of id))
    (if (!= (- end start) (. element-scopes length))
      (return false)
    )
    (for (in position (..< 0 (. element-scopes length)))
      (if (not (call same-use ([] scoped-rows (+ start position)) ([] element-scopes position)))
        (return false)
      )
    )
    (return true)
  )
  (fn-expr _ same-use Bool
    (param first ScopeUse)
    (param second ScopeUse)
    ; Whether two rules written in rules seen are the same, under the same state cells, with the same
    ; values of the rules around.
    (and same-cell (== (. first values) (. second values)) (== (. first outer-cells) (. second outer-cells)))
    (where
      (lazy same-cell (and (call (. instances same-scope) (. first scope) (. second scope)) (== (. first cell) (. second cell))))
    )
  )
  (fn-do _ push-content-scopes _
    (param id SyntaxId)
    ; Brings into view, for the content a style rule generates at a markup element, the rules written
    ; in rules that the style rules the element applies do, those that reach only the markup of its
    ; class's own matching there too (`scope-entered`), as the reference's
    ; `enteredOwnStyleRuleScopes` gives them.
    (let (tuple start end) (call scopes-of id))
    (for (in position (..< start end))
      (+= rule-scopes (call entered-use ([] scoped-rows position)))
    )
  )
  (fn-do + gather-rule Bool
    (param made TypeId)
    (param owner ModuleId)
    (param decl DeclId)
    (param holder TypeId)
    (param frames U32)
    (param cell U32)
    (param seen (list ScopeUse))
    (param site SyntaxId)
    (param read TypeId)
    (param scopes (list ScopeUse))
    (param gives SyntaxId)
    (param values U32)
    (param outer-cells U32)
    ; Gathers the rules written in rules that a style rule matched for a class or style sheet
    ; (`holder`) brings into view, within `frames`, the state cells `cell` and `outer-cells` and the
    ; `values` of the rules around, as the reference's `nestedRuleScopesForMatch` gathers them: those
    ; the rules it applies after its name bring, within it, then its own (`bring-scopes`), with the
    ; state cells of its `when`s made at `site` for an object read as of class `read`, within those
    ; (`outer-links`), and the values the application `gives`, where one does (`scope-values`).
    ; False where one is declined: an
    ; application within it with a condition or values whose name has a rule that brings any, and
    ; values given within a rule around that takes some.
    (let around (call (. instances intern-frame) frames owner decl holder 0))
    (let framed values)
    (if (!= gives 0)
      (if (!= values (. U32 max))
        (return false)
      )
      (= framed (call scope-values gives around))
    )
    (let written (. ([] (. program modules) owner) tree))
    (match? ([] (. ([] (. program modules) owner) decls) decl)
      (case (call .decl-style-rule rule)
        (match? ([] (. written nodes) (. rule syntax))
          (case (call .node-rule-syntax declared)
            (for (in application ([] (. written children) (. declared style-rule-applications)))
              (match? ([] (. written nodes) application)
                (case (call .node-style-rule-application applied)
                  (if (not (call scoping-named (. applied name)))
                    (continue)
                  )
                  (if (and (!= (. applied args count) 0) (== (. applied condition) 0) (. keying discovering))
                    (continue)
                  )
                  (if (or (!= (. applied condition) 0) (!= (. applied args count) 0))
                    (return false)
                  )
                  (let none (list TypeId))
                  (if (not (call gather-name made (. applied name) seen around cell site read scopes none 0 framed outer-cells))
                    (return false)
                  )
                )
              )
            )
            (let body (. declared body))
            (match? ([] (. written nodes) body)
              (case (call .node-block block)
                (for (in statement ([] (. written children) (. block body)))
                  (if (is ([] (. written nodes) statement) .node-rule-syntax)
                    (+= scopes
                      (call ScopeUse
                        (block
                          (arg
                            (call RuleScope
                              (block
                                (arg owner)
                                (arg (call nested-decl owner decl statement))
                                (arg holder)
                                (arg around)
                                (arg (call scope-own written statement))
                              )
                            )
                          )
                          (arg cell)
                          (arg framed)
                          (arg outer-cells)
                        )
                      )
                    )
                  )
                )
              )
            )
            (for (in branch (call (. written rule-whens) body))
              (let gate (. U32 max))
              (let held (. U32 max))
              (let links (. U32 max))
              (for (in line (call (. written when-lines) branch))
                (if (is ([] (. written nodes) line) .node-rule-syntax)
                  (if (== gate (. U32 max))
                    (= gate (call (. instances intern-frame) around owner decl holder branch))
                    (= held (call when-cell cell site read owner branch))
                    (= links (call outer-links held cell outer-cells))
                  )
                  (+= scopes
                    (call ScopeUse
                      (block
                        (arg
                          (call RuleScope
                            (block
                              (arg owner)
                              (arg (call nested-decl owner decl line))
                              (arg holder)
                              (arg gate)
                              (arg (call scope-own written line))
                            )
                          )
                        )
                        (arg held)
                        (arg framed)
                        (arg links)
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
    (return true)
  )
  (fn-do _ scope-values U32
    (param site SyntaxId)
    (param frame U32)
    ; The values the application `site` of this instance gives the rule of a frame, which the rules
    ; written in it read, made once.
    (for (in index (..< 0 (. facts scope-values length)))
      (let held ([] (. facts scope-values) index))
      (if (and same-site (== (. held module) module) (== (. held frame) frame))
        (return (as index U32))
      )
      (lazy same-site (and (== (. held instance) instance) (== (. held site) site)))
    )
    (+= (. facts scope-values) (call ScopeValues instance site module frame))
    (return (as (- (. facts scope-values length) 1) U32))
  )
  (fn-do _ gates-updates Bool
    (param unit InstanceId)
    ; Whether a style rule applied in the body of a `when` sets no property of its class, which
    ; the reference reports at the first line that does: a gated block of declarations may only
    ; declare styles.
    (for (in update (. facts rule-updates))
      (if (== (. update instance) unit)
        (let row ([] (. instances rows) unit))
        (let written (. ([] (. program modules) (. row module)) tree))
        (match? ([] (. written nodes) (. update site))
          (case (call .node-assign line)
            (let name (call (. written identifier-name) (. line lhs)))
            (if name
              (call (. facts record-diagnostic)
                (block
                  (arg instance)
                  (arg (. row module))
                  (arg (. line lhs))
                  (arg .stated)
                  (arg (call conditional-update name))
                  (arg no-type)
                  (arg no-type)
                )
              )
              (return false)
            )
          )
        )
        (call decline (. update site))
        (return false)
      )
    )
    (return true)
  )
  (fn-do _ gate-when (? (list StyleWhen))
    (param id SyntaxId)
    (param made TypeId)
    (param owner ModuleId)
    (param branch SyntaxId)
    (param gated (list StyleWhen))
    ; The `when`s that gate the declarations of the body of a `when` of a style rule applied to an
    ; object of a class, the outermost first: those the rule is applied under, then this one. Its
    ; state must be a property of the class of type `Bool`, as the reference reports, which is
    ; read tracked, and the gate is recorded once (`StyleGate`), with the constructor of the
    ; action that runs it. None where it is reported or declined.
    (let written (. ([] (. program modules) owner) tree))
    (let state (call (. program store-atom) ""))
    (match? ([] (. written nodes) branch)
      (case (call .node-style-when row)
        (= state (. row state))
      )
    )
    (let place (call property-named made state))
    (let shown (call type-short-name types made))
    (if (not place)
      (call (. facts record-diagnostic)
        (block
          (arg instance)
          (arg owner)
          (arg branch)
          (arg .stated)
          (arg (call (. program store-atom) (str "Style state \"" (. state text) "\" is not a property of " shown)))
          (arg no-type)
          (arg no-type)
        )
      )
      (return null)
    )
    (let property ([] (. types properties) place))
    (if (== (. property storage-kind) .storage-getter)
      (call decline id)
      (return null)
    )
    (let declared (. property type))
    (if (== declared no-type)
      (= declared (call demand-member property made state))
    )
    (if (== declared invalid-type)
      (return null)
    )
    (if (!= declared (. types bool-type))
      (call (. facts record-diagnostic)
        (block
          (arg instance)
          (arg owner)
          (arg branch)
          (arg .stated)
          (arg
            (call (. program store-atom)
              (block
                (arg
                  (paragraph
                    (str "Style state \"" (. state text) "\" must be a boolean property, but " shown "." (. state text) " is " (call type-display types declared))
                  )
                )
              )
            )
          )
          (arg declared)
          (arg no-type)
        )
      )
      (return null)
    )
    (call (. instances mark-may-panic) instance)
    (let key (call (. panics property-of) made state))
    (if key
      (call (. panics track) key)
    )
    (let ref (call class-ref types (. property owner)))
    (call (. facts note-tracked) (. ref module) (. ref decl) state)
    (call demand-live-runtime)
    (let action (call demand-style-gates made))
    (if (or (== action no-instance) (== (. instances live track) no-instance))
      (call decline id)
      (return null)
    )
    (let whens (list StyleWhen))
    (for (in held gated)
      (+= whens held)
    )
    (+= whens (call StyleWhen owner branch))
    (call record-gate made whens action)
    (return whens)
  )
  (fn-do _ record-gate _
    (param made TypeId)
    (param whens (list StyleWhen))
    (param action InstanceId)
    (param content _ (= false))
    (let found (call (. facts gate-of) made whens content))
    (if (!= found (. U32 max))
      (+= (. facts gate-users) (call GateUser instance found))
      (return)
    )
    (+= (. facts gate-users) (call GateUser instance (as (. facts style-gates length) U32)))
    (+= (. facts style-gates)
      (call StyleGate
        (block
          (arg made)
          (arg (as (. facts style-gate-whens length) U32))
          (arg (as (. whens length) U32))
          (arg action)
          (arg content)
        )
      )
    )
    (for (in held whens)
      (+= (. facts style-gate-whens) held)
    )
  )
  (fn-do + demand-style-gates InstanceId
    (param made TypeId)
    ; The functions of the style runtime a gated block of declarations calls, typed once, and the
    ; constructor of the action that gates a block on an object of a class, `StyleDynamicAction`
    ; of the class, given the object, the trackers of the conditions and the callback that
    ; evaluates them again; or none.
    (call demand-live-runtime)
    (if (not (call demand-style-sites))
      (return no-instance)
    )
    (let runtime (. facts style-runtime))
    (let module-id (. (call class-ref types (call (. types type-row) .style)) module))
    (let association (call (. types well-known-type) "core/style" "StyleSiteAssociation"))
    (let base (call (. types well-known-type) "core/style" "StyleDynamicActionBase"))
    (let pointer (call (. types well-known-type) "core" "Pointer"))
    (let live (. types live-action-type))
    (if (or (== base invalid-type) (== pointer invalid-type) (== live invalid-type))
      (return no-instance)
    )
    (let mark (. scratch types mark))
    (if (== (. runtime open-block) no-instance)
      (call (. scratch types push) association)
      (= (. runtime open-block)
        (call (. calls demand-runtime-call)
          (block
            (arg module-id)
            (arg no-type)
            (arg (call (. program store-atom) "style-template-open-block"))
            (arg mark)
          )
        )
      )
      (call (. scratch types push) (call (. types type-row) .int64))
      (= (. runtime close-block)
        (call (. calls demand-runtime-call)
          (block
            (arg module-id)
            (arg no-type)
            (arg (call (. program store-atom) "style-template-close-block"))
            (arg mark)
          )
        )
      )
      (call (. scratch types rewind) mark)
      (call (. scratch types push) association)
      (call (. scratch types push) base)
      (= (. runtime dynamic)
        (call (. calls demand-runtime-call)
          (block
            (arg module-id)
            (arg no-type)
            (arg (call (. program store-atom) "style-template-dynamic"))
            (arg mark)
          )
        )
      )
      (call (. scratch types rewind) mark)
      (call (. scratch types push) pointer)
      (call (. scratch types push) (call (. types type-row) .int64))
      (call (. scratch types push) (. types bool-type))
      (= (. runtime block-enabled)
        (call (. calls demand-runtime-call)
          (block
            (arg module-id)
            (arg no-type)
            (arg (call (. program store-atom) "style-set-block-enabled"))
            (arg mark)
          )
        )
      )
      (call (. scratch types rewind) mark)
      (= (. facts style-runtime) runtime)
    )
    (if (or blocks-missing (== (. runtime dynamic) no-instance) (== (. runtime block-enabled) no-instance))
      (return no-instance)
    )
    (lazy blocks-missing (or (== (. runtime open-block) no-instance) (== (. runtime close-block) no-instance)))
    (call (. scratch types push) made)
    (let action (call (. types class-named-with-args) module-id (call (. program store-atom) "StyleDynamicAction") mark))
    (call (. scratch types rewind) mark)
    (if (== action invalid-type)
      (return no-instance)
    )
    (call (. types complete) action)
    (call (. scratch types push) made)
    (call (. scratch types push)
      (block
        (arg (. ([] (. types properties) (!! (call property-named live (call (. program store-atom) "trackers")))) type))
      )
    )
    (call (. scratch types push) (. instances live callback))
    (let made-action (call (. calls demand-constructor) action mark))
    (call (. scratch types rewind) mark)
    (return made-action)
  )
  (fn-do _ demand-style-authors Bool
    (param made TypeId)
    ; The function of the style runtime a live action that declares a style again for an object
    ; calls, typed once, with those a gated block calls, whose action it is made by.
    (if (== (call demand-style-gates made) no-instance)
      (return false)
    )
    (let runtime (. facts style-runtime))
    (if (== (. runtime author-dynamic) no-instance)
      (let module-id (. (call class-ref types (call (. types type-row) .style)) module))
      (let info (call (. types well-known-type) "core/style" "StyleInfo"))
      (let pointer (call (. types well-known-type) "core" "Pointer"))
      (if (or (== info invalid-type) (== pointer invalid-type))
        (return false)
      )
      (let mark (. scratch types mark))
      (call (. scratch types push) pointer)
      (call (. scratch types push) info)
      (call (. scratch types push) (. types size-type))
      (call (. scratch types push) (call (. types type-row) .uint32))
      (call (. scratch types push) (call (. types type-row) .uint32))
      (call (. scratch types push) (call (. types type-row) .int64))
      (call (. scratch types push) (call (. types type-row) .int64))
      (call (. scratch types push) (. types bool-type))
      (= (. runtime author-dynamic)
        (call (. calls demand-runtime-call)
          (block
            (arg module-id)
            (arg no-type)
            (arg (call (. program store-atom) "style-author-dynamic"))
            (arg mark)
          )
        )
      )
      (call (. scratch types rewind) mark)
      (= (. facts style-runtime) runtime)
    )
    (return (!= (. runtime author-dynamic) no-instance))
  )
  (fn-do _ runs-code Bool
    (param unit InstanceId)
    (param written AST)
    (param value SyntaxId)
    ; Whether a value an instance typed calls a function, but the constructor the program makes for
    ; a type that is no class, which makes the value and does nothing else.
    (for (in node (.. (call (. written subtree-start) value) value))
      (let fact (call (. facts first-call) unit node))
      (if (and (!= fact no-fact) (not (call makes-value ([] (. facts calls) fact))))
        (return true)
      )
    )
    (return false)
  )
  (fn-do _ makes-value Bool
    (param call CallFact)
    ; Whether a call is of the constructor the program makes for a type that is no class.
    (if (or (!= (. call form) .call-constructor) (!= (. call next) no-fact))
      (return false)
    )
    (let row ([] (. instances rows) (. call callee)))
    (if (== (call (. types intrinsic-of) (. row self-type)) .class)
      (return false)
    )
    (match? ([] (. ([] (. program modules) (. row module)) decls) (. row decl))
      (case (call .decl-function fn)
        (return (. fn is-generated))
      )
    )
    (return false)
  )
  (fn-do _ report-recursion _
    (param active (list InstanceId))
    (param start Size)
    (param again InstanceId)
    (param owner ModuleId)
    (param at SyntaxId)
    ; The reference's error for a style rule that comes to apply itself again: the names of the
    ; rules from the first time it was applied on, then its own, at the application that would.
    (let names "")
    (for (in position (..< start (. active length)))
      (+= names (str (call rule-name ([] active position)) " -> "))
    )
    (+= names (call rule-name again))
    (let text (call (. program store-atom) (str "Recursive style rule application: " names)))
    (call (. facts record-diagnostic) instance owner at .stated text no-type no-type)
  )
  (fn-do _ rule-name String
    (param unit InstanceId)
    ; The name of the style rule an instance types.
    (let row ([] (. instances rows) unit))
    (match? ([] (. ([] (. program modules) (. row module)) decls) (. row initializer))
      (case (call .decl-style-rule rule)
        (return (. rule name text))
      )
    )
    (return "")
  )
  (fn-do _ rule-unit InstanceId
    (param level TypeId)
    (param member DeclRef)
    (param made TypeId)
    (param site SyntaxId)
    ; The instance that types a style rule a class or a style sheet writes, for the class or sheet
    ; `level`, and for a sheet's, the class `made` of the element it is applied to, as the reference
    ; resolves its names there; for a class's, under the styles of the element's vocabulary it
    ; reads (`rule-context`), applied at `site`. Typed now, or none where it is being typed already.
    ; The instance that applies it runs its code, and may panic where it does.
    (let element (if-expr (== (call (. types intrinsic-of) level) .style-sheet) made no-type))
    (let context (if-expr (== element no-type) (call rule-context level member made site) (. U32 max)))
    (let unit (call (. instances intern-initializer) (. member module) (. member decl) level element context))
    (if (== (. ([] (. instances rows) unit) state) .instance-in-progress)
      (return no-instance)
    )
    (call demand-body unit)
    (call (. panics note-inlined) instance unit)
    (return unit)
  )
  (fn-do _ rule-context U32
    (param level TypeId)
    (param member DeclRef)
    (param made TypeId)
    (param site SyntaxId)
    ; The styles a style rule a class writes is typed under beside those the class sees, where it is
    ; applied at `site` to an element of a class: each style the element sees, as `answers-alike`
    ; lists them, that declares a name a line of the rule declares which no style the class sees
    ; answers, in the order the element sees them, as the reference keys the function of a rule by
    ; the styles of the element's vocabulary it reads (`keyForMarkupStyleReads`); or none.
    (if (!= (call (. types intrinsic-of) level) .class)
      (return (. U32 max))
    )
    (let written (. ([] (. program modules) (. member module)) tree))
    (let body SyntaxId 0)
    (match? ([] (. ([] (. program modules) (. member module)) decls) (. member decl))
      (case (call .decl-style-rule rule)
        (match? ([] (. written nodes) (. rule syntax))
          (case (call .node-rule-syntax declared)
            (= body (. declared body))
          )
        )
      )
    )
    (if (== body 0)
      (return (. U32 max))
    )
    (let lines (list SyntaxId))
    (match? ([] (. written nodes) body)
      (case (call .node-block block)
        (for (in statement ([] (. written children) (. block body)))
          (+= lines statement)
        )
      )
    )
    (for (in branch (call (. written rule-whens) body))
      (for (in statement (call (. written when-lines) branch))
        (+= lines statement)
      )
    )
    (let own (list TypeId))
    (let seen (list TypeId))
    (if (or (not (call add-visible-styles level own site)) (not (call add-visible-styles made seen site)))
      (return (. U32 max))
    )
    (call add-markup-styles seen)
    (let wanted (list Bool))
    (for (in _ seen)
      (+= wanted false)
    )
    (for (in statement lines)
      (match? ([] (. written nodes) statement)
        (case (call .node-assign line)
          (let name (call style-name written (. line lhs)))
          (if (and (== (. line op) .eq-op) name (not (call property-named level name)) (== (call style-answering own name) no-type))
            (for (in position (..< 0 (. seen length)))
              (if (call names-style-property ([] seen position) name)
                (= ([] wanted position) true)
              )
            )
          )
        )
      )
    )
    (let extra (list TypeId))
    (for (in position (..< 0 (. seen length)))
      (if (and ([] wanted position) (== (call (. own find) ([] seen position)) null))
        (+= extra ([] seen position))
      )
    )
    (if (== (. extra length) 0)
      (return (. U32 max))
    )
    (let sheets (list TypeId))
    (let levels (list U32))
    (let scopes (list RuleScope))
    (let cells (list U32))
    (let valued (list U32))
    (return (call (. instances intern-context) extra sheets levels scopes cells no-type 0 valued sheets))
  )
  (fn-do _ unit-vocabulary (? (list TypeId))
    (param named TypeId)
    (param syntax SyntaxId)
    ; The styles the lines of a style rule an instance types declare names of: those `named` sees
    ; (`style-vocabulary`), then those of the context the instance is typed under (`rule-context`).
    (let styles (call style-vocabulary named syntax))
    (let context (. ([] (. instances rows) instance) context))
    (if (or (not styles) (== context (. U32 max)))
      (return styles)
    )
    (let held ([] (. instances contexts) context))
    (let found styles)
    (for (in position (..< (. held first) (+ (. held first) (. held styles))))
      (let used ([] (. instances context-types) position))
      (if (== (call (. found find) used) null)
        (+= found used)
      )
    )
    (return found)
  )
  (fn-do _ shares-rule Bool
    (param applied (list InstanceId))
    (param count U32)
    ; Whether the reference compiles a rule matched by name into a function every element it
    ; matches calls, as `styleRuleIsShareable` says: one whose weight, with the rules it applies,
    ; is more than one, each style it declares and each `when` weighing one, and none of which
    ; sets a property of its class or generates content.
    (let weight count)
    (for (in unit applied)
      (if (call (. facts updates-properties) unit)
        (return false)
      )
      (let row ([] (. instances rows) unit))
      (let written (. ([] (. program modules) (. row module)) tree))
      (match? ([] (. ([] (. program modules) (. row module)) decls) (. row initializer))
        (case (call .decl-style-rule rule)
          (match? ([] (. written nodes) (. rule syntax))
            (case (call .node-rule-syntax declared)
              (if (!= (. (call (. written rule-content) (. declared body)) length) 0)
                (return false)
              )
              (for (in branch (call (. written rule-whens) (. declared body)))
                (if (!= (. (call (. written when-content) branch) length) 0)
                  (return false)
                )
              )
              (+= weight (as (. (call (. written rule-whens) (. declared body)) length) U32))
            )
          )
        )
      )
    )
    (return (> weight 1))
  )
  (fn-do + class-style-rule (tuple TypeId DeclRef Bool)
    (param made TypeId)
    (param name Atom)
    ; The class of a chain, the most derived first, that writes a style rule of a name taking no
    ; values, and the rule, as the reference resolves a rule an element applies; and whether some
    ; class writes a rule of that name at all.
    (let named false)
    (let level (? TypeId) made)
    (while (and level (== (call (. types intrinsic-of) level) .class))
      (let ref (call class-ref types level))
      (let owner ([] (. program modules) (. ref module)))
      (match? ([] (. owner decls) (. ref decl))
        (case (call .decl-class class)
          (for (in member ([] (. owner member-pool) (. class members)))
            (match? ([] (. owner decls) member)
              (case (call .decl-style-rule rule)
                (if (== (. rule name) name)
                  (= named true)
                  (if (call (. owner tree rule-takes-nothing) (. rule syntax))
                    (return (tuple level (call DeclRef (. ref module) member) true))
                  )
                )
              )
            )
          )
        )
      )
      (= level (call (. types base-of) level))
    )
    (return (tuple no-type (call DeclRef 0 0) named))
  )
  (fn-do + match-style-rule (tuple TypeId DeclRef Bool U32)
    (param made TypeId)
    (param name Atom)
    (param given (list TypeId))
    ; The style rule a written application chooses by the types of its values, as the reference's
    ; `resolveMatch` chooses among the rules the classes of a chain write: in each class, the
    ; first rule of the name taking as many values, each convertible to the type the rule takes it
    ; as, that converts them most closely; then, of the classes, the most derived whose choice
    ; converts them most closely. Answers the class and the rule, or no type where none is chosen;
    ; whether some class writes a rule of the name; and the place of the last value found not to
    ; convert, at which the reference reports the mismatch, or `U32.max`. A type a rule takes that
    ; is not known here is answered as an invalid class with that rule, to be reported where it is
    ; written wrong (`report-argument-types`) or else declined.
    (let named false)
    (let mismatch (. U32 max))
    (let best no-type)
    (let best-member (call DeclRef 0 0))
    (let best-kind 0u32)
    (let level (? TypeId) made)
    (while (and level (== (call (. types intrinsic-of) level) .class))
      (let (tuple found chosen kind writes missed) (call match-rules-of level name given mismatch))
      (if writes
        (= named true)
      )
      (= mismatch missed)
      (if (and found (== kind (. U32 max)))
        (return (tuple invalid-type chosen named mismatch))
      )
      (if (and found (or (== best no-type) (> kind best-kind)))
        (= best level)
        (= best-member chosen)
        (= best-kind kind)
      )
      (= level (call (. types base-of) level))
    )
    (return (tuple best best-member named mismatch))
  )
  (fn-do _ match-rules-of (tuple Bool DeclRef U32 Bool U32)
    (param level TypeId)
    (param name Atom)
    (param given (list TypeId))
    (param mismatch U32)
    ; The rule of a name a class or a style sheet writes that a written application chooses by the
    ; types of its values, as the reference's `matchRulesOf` chooses it: the first taking as many
    ; values, each convertible to the type the rule takes it as, that converts them most closely.
    ; A sheet writes the rules of its extensions after its own (`sheet-parts`). Answers whether
    ; there is one, the rule and how closely, `U32.max` for a type a rule takes that is not known
    ; here; whether the class writes a rule of the name; and the place of the last value found not
    ; to convert, or `mismatch` where none is.
    (let found false)
    (let named false)
    (let chosen (call DeclRef 0 0))
    (let kind 0u32)
    (let missed mismatch)
    (for (in part (call sheet-parts (call class-ref types level)))
      (let owner ([] (. program modules) (. part module)))
      (for (in member ([] (. owner member-pool) (call part-members part)))
        (match? ([] (. owner decls) member)
          (case (call .decl-style-rule rule)
            (if (!= (. rule name) name)
              (continue)
            )
            (= named true)
            (if (!= (call (. owner tree rule-takes) (. rule syntax)) (. given length))
              (continue)
            )
            (let written (call DeclRef (. part module) member))
            (let wanted (call rule-argument-types written))
            (if (not wanted)
              (return (tuple true written (. U32 max) named missed))
            )
            (let fits true)
            (let closeness (as (. Specificity exact) U32))
            (for (in position (..< 0 (. given length)))
              (let relation (call (. conversions compare-held) ([] given position) ([] wanted position)))
              (if (not (call relation-legal relation))
                (= missed (as position U32))
                (= fits false)
                (break)
              )
              (if (< (as (. relation match) U32) closeness)
                (= closeness (. relation match))
              )
            )
            (if (and fits (or (not found) (> closeness kind)))
              (= found true)
              (= chosen written)
              (= kind closeness)
            )
          )
        )
      )
    )
    (return (tuple found chosen kind named missed))
  )
  (fn-do _ report-argument-types Bool
    (param member DeclRef)
    ; Reports a value a style rule takes whose type is written wrong, where it is written, as the
    ; reference's `resolveMatch` reports it as it matches the rule (`argument-type-error`). Says
    ; whether one was reported.
    (let owner ([] (. program modules) (. member module)))
    (match? ([] (. owner decls) (. member decl))
      (case (call .decl-style-rule rule)
        (match? ([] (. owner tree nodes) (. rule syntax))
          (case (call .node-rule-syntax row)
            (let env (call holder-env (call DeclRef (. member module) (. rule owner))))
            (for (in arg ([] (. owner tree children) (. row args)))
              (let (tuple at message) (call argument-type-error (. member module) arg env))
              (if (!= at 0)
                (call (. types env-release) env)
                (call report-at (. member module) at message)
                (return true)
              )
            )
            (call (. types env-release) env)
          )
        )
      )
    )
    (return false)
  )
  (fn-do _ argument-type-error (tuple SyntaxId String)
    (param owner ModuleId)
    (param argument SyntaxId)
    (param env TypeEnv)
    ; Where a value a style rule takes is written wrong, and the reference's error there: a name
    ; written with no type, a type written that names nothing (`missing-type`), or a type written
    ; with no name, which the reference refuses as the rule binds it. None where it is written right.
    (let written (. ([] (. program modules) owner) tree))
    (match? ([] (. written nodes) argument)
      (case (call .node-argument-decl row)
        (match? ([] (. written nodes) (. row pattern))
          (case (call .node-type-capture capture)
            (if (== (. capture type) 0)
              (return (tuple argument "Argument type not found"))
            )
            (return (tuple (call (. types missing-type) owner written (. capture type) env) "Type not found"))
          )
        )
        (let missing (call (. types missing-type) owner written (. row pattern) env))
        (if (!= missing 0)
          (return (tuple missing "Type not found"))
        )
        (return (tuple (. row pattern) "Invalid argument"))
      )
    )
    (return (tuple 0 ""))
  )
  (fn-do _ overlay-rule Bool
    (param name Atom)
    ; Whether a style rule of a name may be answered other than by a class of the element that
    ; applies it, a style sheet it sees, or a rule written in a rule that it sees where those are
    ; known (`scopes-known`), as the reference also looks: by a rule written in a rule where they
    ; are not, or by one written at the top of a module. What answers is not modeled.
    (if (and (not (call scopes-known)) (call nested-named name))
      (return true)
    )
    (let position (call (. facts first-style-rule) name))
    (while (!= position (. U32 max))
      (let ref ([] (. facts style-rules) position))
      (= position ([] (. facts style-rule-nexts) position))
      (if (not (call (. program shares-case) module (. ref module)))
        (continue)
      )
      (match? ([] (. ([] (. program modules) (. ref module)) decls) (. ref decl))
        (case (call .decl-style-rule rule)
          (if (== (. rule owner) 0)
            (return true)
          )
        )
      )
    )
    (return false)
  )
  (fn-do + list-style-rules _
    ; Lists, once, the style rules the program writes and the names of those written in rules; and
    ; the names of those that bring rules written in rules into view where they are applied
    ; (`scoping-names`): those with rules written in them, and those that apply one of those names
    ; after their own. Each name is listed with the module that writes the rule, and is seen only
    ; from the modules that share a case of a batch with it (`shares-case`), as one program sees all.
    (return-if (if (. facts rules-listed)))
    (= (. facts rules-listed) true)
    (for (in position (..< 0 (. program modules length)))
      (let owner ([] (. program modules) position))
      (let place (as position ModuleId))
      (let index 0u32)
      (for (in decl (. owner decls))
        (match? decl
          (case (call .decl-style-rule rule)
            (if (!= (. rule outer) 0)
              (+= (. facts nested-rules) (. rule name))
              (+= (. facts nested-modules) place)
              (match? ([] (. owner decls) (. rule outer))
                (case (call .decl-style-rule around)
                  (if (not (call lists-scoping (. around name) place))
                    (+= (. facts scoping-names) (. around name))
                    (+= (. facts scoping-modules) place)
                  )
                )
              )
              (else
                (call (. facts add-style-rule) (call DeclRef place index) (. rule name))
              )
            )
          )
        )
        (+= index 1)
      )
    )
    (let growing (!= (. facts scoping-names length) 0))
    (while growing
      (= growing false)
      (for (in position (..< 0 (. program modules length)))
        (let owner ([] (. program modules) position))
        (let place (as position ModuleId))
        (for (in decl (. owner decls))
          (match? decl
            (case (call .decl-style-rule rule)
              (if (call lists-scoping (. rule name) place)
                (continue)
              )
              (match? ([] (. owner tree nodes) (. rule syntax))
                (case (call .node-rule-syntax written)
                  (for (in application ([] (. owner tree children) (. written style-rule-applications)))
                    (match? ([] (. owner tree nodes) application)
                      (case (call .node-style-rule-application applied)
                        (if (and (call scoping-from (. applied name) place) unlisted)
                          (+= (. facts scoping-names) (. rule name))
                          (+= (. facts scoping-modules) place)
                          (= growing true)
                        )
                        (lazy unlisted (not (call lists-scoping (. rule name) place)))
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )
  (fn-do _ lists-scoping Bool
    (param name Atom)
    (param owner ModuleId)
    ; Whether `scoping-names` lists a name for a module that writes a rule of it.
    (for (in position (..< 0 (. facts scoping-names length)))
      (if (and (== ([] (. facts scoping-names) position) name) (== ([] (. facts scoping-modules) position) owner))
        (return true)
      )
    )
    (return false)
  )
  (fn-do _ style-declared Bool
    (param name Atom)
    ; Whether a module the module being typed shares a case with writes a style rule of a name, in a
    ; rule or outside one.
    (return-if true (if (call nested-named name)))
    (let position (call (. facts first-style-rule) name))
    (while (!= position (. U32 max))
      (let ref ([] (. facts style-rules) position))
      (= position ([] (. facts style-rule-nexts) position))
      (return-if true (if (call (. program shares-case) module (. ref module))))
    )
    (return false)
  )
  (fn-do _ nested-named Bool
    (param name Atom)
    ; Whether a module the module being typed shares a case with writes a rule of a name in a rule.
    (for (in position (..< 0 (. facts nested-rules length)))
      (if (and (== ([] (. facts nested-rules) position) name) case-shared)
        (return true)
      )
      (lazy case-shared (call (. program shares-case) module ([] (. facts nested-modules) position)))
    )
    (return false)
  )
  (fn-do _ sheet-rule-name Bool
    (param name Atom)
    ; Whether a style sheet writes a style rule of a name, in a module the module being typed shares
    ; a case with.
    (let position (call (. facts first-style-rule) name))
    (while (!= position (. U32 max))
      (let ref ([] (. facts style-rules) position))
      (= position ([] (. facts style-rule-nexts) position))
      (if (not (call (. program shares-case) module (. ref module)))
        (continue)
      )
      (match? ([] (. ([] (. program modules) (. ref module)) decls) (. ref decl))
        (case (call .decl-style-rule rule)
          (if (and (!= (. rule owner) 0) (call is-sheet-decl (. ref module) (. rule owner)))
            (return true)
          )
        )
      )
    )
    (return false)
  )
  (fn-do _ answers-alike Bool
    (param unit InstanceId)
    (param made TypeId)
    (param site SyntaxId)
    ; Whether each property a style rule declares, typed for the class that writes it, is answered
    ; by the same style where the rule is applied to an element of a class: the reference resolves
    ; the names there, in the element's vocabulary, with that of a style sheet that writes the
    ; rule last.
    (let styles (list TypeId))
    (if (not (call add-visible-styles made styles site))
      (return false)
    )
    (call add-markup-styles styles)
    (let writer (. ([] (. instances rows) unit) self-type))
    (if (and (== (call (. types intrinsic-of) writer) .style-sheet) (not (call add-visible-styles writer styles site)))
      (return false)
    )
    (let owner (. ([] (. program modules) (. ([] (. instances rows) unit) module)) tree))
    (let place (call (. facts first-style-declaration) unit))
    (while (!= place (. U32 max))
      (let row ([] (. facts style-declarations) place))
      (match? ([] (. owner nodes) (. row site))
        (case (call .node-assign line)
          (let name (call style-name owner (. line lhs)))
          (if (or (not name) (!= (call style-answering styles name) (. row style)))
            (return false)
          )
        )
      )
      (= place (call (. facts next-style-declaration) place))
    )
    (return true)
  )
  (fn-do + check-style-unit _
    (param receiver TypeId)
    (param syntax SyntaxId)
    (param writer DeclId)
    ; Types a style rule for the class that writes it, as a rule of the class is typed, with
    ; `this` bound and each value it takes of the type the class declares for it. Each line of its
    ; body, in the order written, sets a property of the class (`update-unit-property`) or names a
    ; property of a style the class sees and declares its value, typed and converted as an
    ; element's declaration is. A name no style answers is the reference's error. The lines of
    ; each `when` follow, which may only declare styles, as the reference reports. A declared
    ; value that reads something tracked is declared again as it changes where the rule is applied
    ; (`StyleAuthor`), and `inherit` takes the value from the parent (`declare-inherit`). A value the
    ; runtime holds a handle to is declared as an element's is. Any other line, and a declared
    ; value that reads a value the rule takes and something tracked, are declined. The rules a rule
    ; applies are resolved where
    ; it is applied. A rule answers nothing.
    (= (. frame self-type) receiver)
    (call bind-this receiver)
    (call (. frame close-env))
    (call open-class-env (call holding-type receiver (call DeclRef module writer)))
    (if (and (call sheet-rule) (== (. ([] (. instances rows) instance) element) no-type))
      (if (and (not (call report-missing-type syntax (. frame env))) (call assign-rule-arguments syntax true) (call assign-outer-arguments true))
        (call type-sheet-lines receiver syntax)
      )
      (else-if (and (call assign-rule-arguments syntax) (call assign-outer-arguments))
        (call declare-unit-styles receiver syntax)
      )
    )
    (call (. instances set-returns) instance (. types void-type) (. types void-type) .return-declared)
    (call finish-errors frame)
    (call close)
  )
  (fn-do _ type-sheet-lines _
    (param sheet TypeId)
    (param syntax SyntaxId)
    (match? ([] (. tree nodes) syntax)
      (case (call .node-rule-syntax rule)
        (if (== (. rule body) 0)
          (return)
        )
        (let styles (list TypeId))
        (if (not (call add-visible-styles sheet styles syntax))
          (return)
        )
        (match? ([] (. tree nodes) (. rule body))
          (case (call .node-block block)
            (for (in statement ([] (. tree children) (. block body)))
              (call type-sheet-line statement sheet styles)
            )
            (for (in branch (call (. tree rule-whens) (. rule body)))
              (for (in statement (call (. tree when-lines) branch))
                (call type-sheet-line statement sheet styles)
              )
            )
          )
        )
      )
    )
  )
  (fn-do _ type-sheet-line _
    (param statement SyntaxId)
    (param sheet TypeId)
    (param styles (list TypeId))
    (match? ([] (. tree nodes) statement)
      (case .node-rule-syntax
        (call type-nested-rule statement sheet)
      )
      (case (call .node-assign line)
        (let name (call (. tree identifier-name) (. line lhs)))
        (if (or (!= (. line op) .eq-op) (not name))
          (return)
        )
        (let answering (call style-answering styles name))
        (if (or (== answering no-type) (== answering invalid-type))
          (return)
        )
        (let (tuple _ declared) (call declared-style-property answering name))
        (if (or untyped (not (call sheet-value-typed (. line rhs) sheet declared)))
          (return)
        )
        (lazy untyped (or (== declared no-type) (== declared invalid-type)))
        (let written (call style-value (. line rhs) declared))
        (if (and (!= written no-type) (!= written invalid-type))
          (call (. conversions convert) statement (. line rhs) written declared .reason-assignment)
        )
      )
    )
  )
  (fn-do _ sheet-value-typed Bool
    (param value SyntaxId)
    (param sheet TypeId)
    (param declared TypeId)
    (if (or (call (. tree is-inherit) value) (call (. tree reads-tracked) value) (call reads-slots value) reads-member)
      (return false)
    )
    (lazy reads-member (call reads-sheet-member value sheet))
    (for (in node (.. (call (. tree subtree-start) value) value))
      (match? ([] (. tree nodes) node)
        (case .node-style-read-expression
          (return false)
        )
        (case (call .node-identifier row)
          (let styled
            (scope (!= (/and/ resolution-flags (. ResolutionFlag resolution-styled)) 0)
              (lazy resolution-flags (. (call (. bindings resolution-of) (. frame binding) node) flags))
            )
          )
          (if (and styled (or (!= node value) (not (call bare-case declared (. row name)))))
            (return false)
          )
        )
      )
    )
    (return true)
  )
  (fn-do _ type-nested-rule _
    (param syntax SyntaxId)
    (param sheet TypeId)
    (return-if (if (not (call sheet-rule))))
    (let nested (call nested-decl module (. ([] (. instances rows) instance) initializer) syntax))
    (return-if (if (== nested 0)))
    (let unit (call (. instances intern-initializer) module nested sheet))
    (if (== (. ([] (. instances rows) unit) state) .instance-unstarted)
      (call demand-body unit)
    )
  )
  (fn-do _ assign-rule-arguments Bool
    (param syntax SyntaxId)
    (param quiet Bool (= false))
    ; Gives each value a style rule takes, `name Type`, the type the class declares for it.
    (match? ([] (. tree nodes) syntax)
      (case (call .node-rule-syntax rule)
        (for (in arg ([] (. tree children) (. rule args)))
          (let declared (call (. tree argument-type-syntax) arg))
          (let named SyntaxId 0)
          (match? ([] (. tree nodes) arg)
            (case (call .node-argument-decl row)
              (match? ([] (. tree nodes) (. row pattern))
                (case (call .node-type-capture capture)
                  (= named (. capture id))
                )
              )
            )
          )
          (let resolution (call (. bindings resolution-of) (. frame binding) named))
          (if (or (== declared 0) (== named 0) (!= (. resolution kind) .resolve-slot))
            (if (not quiet)
              (call decline arg)
            )
            (return false)
          )
          (let type (call (. types evaluate-type) module tree declared (. frame env)))
          (if (== type invalid-type)
            (if (not quiet)
              (call decline arg)
            )
            (return false)
          )
          (call (. frame assign) (. resolution slot) type)
        )
      )
    )
    (return true)
  )
  (fn-do _ assign-outer-arguments Bool
    (param quiet Bool (= false))
    ; Gives each value the rules around a rule written in a rule take the type the class declares
    ; for it, as the reference defines the values of the frames it is applied within
    ; (`withStyleRuleLexicalFrames`), which the rule reads as the frame gives them.
    (let decls (. ([] (. program modules) module) decls))
    (let outer DeclId 0)
    (match? ([] decls (. ([] (. instances rows) instance) initializer))
      (case (call .decl-style-rule rule)
        (= outer (. rule outer))
      )
    )
    (while (!= outer 0)
      (let next DeclId 0)
      (match? ([] decls outer)
        (case (call .decl-style-rule rule)
          (if (not (call assign-rule-arguments (. rule syntax) quiet))
            (return false)
          )
          (= next (. rule outer))
        )
      )
      (= outer next)
    )
    (return true)
  )
  (fn-do _ marks-up-class Bool
    (param syntax SyntaxId)
    ; Whether the lines of a style rule that are not its own (`rule-part`) are the markup of the
    ; class that writes it: the rule is that class's `• This`, which the class keeps as its content
    ; (`defaults-content`), so its markup function types them and the rule does not.
    (let decl (. ([] (. instances rows) instance) initializer))
    (match? ([] (. ([] (. program modules) module) decls) decl)
      (case (call .decl-style-rule rule)
        (match? ([] (. ([] (. program modules) module) decls) (. rule owner))
          (case (call .decl-class class)
            (return (== (. class content) syntax))
          )
        )
      )
    )
    (return false)
  )
  (fn-do _ sheet-rule Bool
    ; Whether the style rule an instance types is written in a style sheet, whose lines may only
    ; declare styles and generate content: any other line is the reference's error.
    (let decl (. ([] (. instances rows) instance) initializer))
    (match? ([] (. ([] (. program modules) module) decls) decl)
      (case (call .decl-style-rule rule)
        (return (call is-sheet-decl module (. rule owner)))
      )
    )
    (return false)
  )
  (fn-do _ declare-unit-styles _
    (param receiver TypeId)
    (param syntax SyntaxId)
    ; Types the lines of a style rule's body, as `check-style-unit` says, for the class or style
    ; sheet that writes it. The names it declares are those of the styles the class sees, then those
    ; of the context it is typed under, or for a rule a style sheet writes, those the class of the
    ; element it is typed for sees, then the sheet's, as the reference resolves them where the rule
    ; is applied (`unit-vocabulary`).
    (match? ([] (. tree nodes) syntax)
      (case (call .node-rule-syntax rule)
        (call type-applied-values receiver rule)
        (if (== (. rule body) 0)
          (return)
        )
        (let styles (? (list TypeId)) null)
        (let element (. ([] (. instances rows) instance) element))
        (let named (if-expr (!= element no-type) element receiver))
        (let order U32)
        (let marks-up (call marks-up-class syntax))
        (match ([] (. tree nodes) (. rule body))
          (case (call .node-block block)
            (for (in statement ([] (. tree children) (. block body)))
              (match? ([] (. tree nodes) statement)
                (case (call .node-assign line)
                  (let name (call (. tree identifier-name) (. line lhs)))
                  (if (and assigning name is-class (call property-named receiver name))
                    (if (not (call update-unit-property statement line receiver name))
                      (return)
                    )
                    (continue)
                  )
                  (lazy assigning (== (. line op) .eq-op))
                  (lazy is-class (== (call (. types intrinsic-of) receiver) .class))
                )
                (case .node-style-when
                  (continue)
                )
                (case .node-rule-syntax
                  (call type-nested-rule statement receiver)
                  (continue)
                )
              )
              (if (not (call (. tree rule-part) statement))
                (if marks-up
                  (continue)
                )
                (if (call sheet-rule)
                  (call (. frame diagnose)
                    (block
                      (arg statement)
                      (arg .stated)
                      (arg
                        (call (. program store-atom)
                          (block
                            (arg
                              (paragraph
                                "StyleSheet style rules may only contain style declarations and generated content"
                              )
                            )
                          )
                        )
                      )
                    )
                  )
                  (return)
                )
              )
              (match? ([] (. tree nodes) statement)
                (case .node-markup
                  (if (== (call content-slot statement) (. U32 max))
                    (return)
                  )
                  (continue)
                )
                (case .node-markup-slot-forward
                  (do
                    (inline (call content-slot statement))
                  )
                  (return)
                )
              )
              (if (not styles)
                (= styles (call unit-vocabulary named syntax))
                (if (not styles)
                  (return)
                )
              )
              (if (not (call declare-unit-style statement syntax receiver styles order))
                (return)
              )
              (+= order 1)
            )
            (for (in branch (call (. tree rule-whens) (. rule body)))
              (for (in statement (call (. tree when-lines) branch))
                (match? ([] (. tree nodes) statement)
                  (case .node-style-rule-application
                    (continue)
                  )
                  (case .node-rule-syntax
                    (call type-nested-rule statement receiver)
                    (continue)
                  )
                  (case .node-markup
                    (if (== (call content-slot statement) (. U32 max))
                      (return)
                    )
                    (continue)
                  )
                  (case .node-markup-slot-forward
                    (do
                      (inline (call content-slot statement))
                    )
                    (return)
                  )
                  (case (call .node-assign line)
                    (let name (call (. tree identifier-name) (. line lhs)))
                    (if (and name (call property-named receiver name))
                      (call (. frame diagnose) (. line lhs) .stated (call conditional-update name))
                      (return)
                    )
                  )
                )
                (if (not styles)
                  (= styles (call unit-vocabulary named syntax))
                  (if (not styles)
                    (return)
                  )
                )
                (if (not (call declare-unit-style statement syntax receiver styles order))
                  (return)
                )
                (+= order 1)
              )
            )
          )
          (default
            (call decline (. rule body))
          )
        )
      )
    )
  )
  (fn-do _ rule-writer TypeId
    (param receiver TypeId)
    ; The class that writes the style rule an instance types, where it is no class of the receiver's
    ; chain, as a rule written in a rule of one class is typed for the class of the element it
    ; matches; the receiver otherwise, or where the writer takes type arguments the receiver does
    ; not give.
    (match? ([] (. ([] (. program modules) module) decls) (. ([] (. instances rows) instance) initializer))
      (case (call .decl-style-rule rule)
        (match? ([] (. ([] (. program modules) module) decls) (. rule owner))
          (case (call .decl-class class)
            (if (and (== (. class type-args count) 0) same-holder not-owner)
              (return (call (. types intern-class) module (. rule owner) (. scratch types mark)))
            )
            (lazy same-holder (== (call holding-type receiver (call DeclRef module (. rule owner))) receiver))
            (lazy not-owner (not (call same-decl (call class-ref types receiver) (call DeclRef module (. rule owner)))))
          )
        )
      )
    )
    (return receiver)
  )
  (fn-do _ content-slot U32
    (param line SyntaxId)
    ; The slot a line of a style rule that generates content fills, 0 to 3 for before, after,
    ; first-child and last-child, as the reference's `styleContentTemplateFor` reads it. A line that
    ; forwards a slot, one that names the item of a slot that repeats, and a slot of another name are
    ; the reference's errors, and a markup line that binds no slot is declined; each answers
    ; `U32.max`.
    (let binding SyntaxId 0)
    (let parameter SyntaxId 0)
    (match? ([] (. tree nodes) line)
      (case (call .node-markup row)
        (= binding (. row slot-binding))
        (= parameter (. row slot-parameter))
      )
      (case (call .node-markup-slot-forward row)
        (call (. frame diagnose)
          (block
            (arg (. row slot-binding))
            (arg .stated)
            (arg (call (. program store-atom) "Style content slots cannot forward markup slots"))
          )
        )
        (return (. U32 max))
      )
    )
    (let name (only-if (call (. tree identifier-name) binding) (if (!= binding 0))))
    (if (not name)
      (call decline line)
      (return (. U32 max))
    )
    (match? ([] (. tree nodes) parameter)
      (case (call .node-markup-slot-parameter written)
        (call (. frame diagnose)
          (block
            (arg (. written name))
            (arg .stated)
            (arg (call (. program store-atom) "Style content slots cannot declare a repeated slot parameter"))
          )
        )
        (return (. U32 max))
      )
    )
    (let text (. name text))
    (if (== text "before")
      (return 0)
    )
    (if (== text "after")
      (return 1)
    )
    (if (== text "first-child")
      (return 2)
    )
    (if (== text "last-child")
      (return 3)
    )
    (call (. frame diagnose)
      (block
        (arg binding)
        (arg .stated)
        (arg
          (call (. program store-atom)
            (block
              (arg (str "Unknown style content slot \"" text "\"; expected before, after, first-child, or last-child"))
            )
          )
        )
      )
    )
    (return (. U32 max))
  )
  (fn-do _ conditional-update Atom
    (param name Atom)
    ; The reference's error for a line of a style rule that sets a property of its class where the
    ; rule's declarations are gated by a `when`.
    (return
      (call (. program store-atom)
        (block
          (arg
            (paragraph
              (str "Conditional style declarations may only set style properties, and \"" (. name text) "\" is an object property")
            )
          )
        )
      )
    )
  )
  (fn-do _ type-applied-values _
    (param receiver TypeId)
    (param rule ASTRule)
    ; Types the values a style rule gives each rule it applies, after its name and then in the
    ; body of each `when`, as written, with nothing expected, and converts each to the type the
    ; rule the class chooses by them takes it as (`match-style-rule`), or where no class of its
    ; chain answers the name, the rule of style sheets it chooses (`own-sheet-rule`). An element
    ; whose class or sheets choose another is declined where the rule is applied (`apply-rule`).
    ; A value names the slots of the style sheets the class that writes the rule sees
    ; (`rule-writer`), which a rule written in a rule matches against another class's elements.
    (let applications (list SyntaxId))
    (let writer (call rule-writer receiver))
    (for (in nested ([] (. tree children) (. rule style-rule-applications)))
      (+= applications nested)
    )
    (for (in branch (call (. tree rule-whens) (. rule body)))
      (for (in nested (call (. tree when-applications) branch))
        (+= applications nested)
      )
    )
    (for (in nested applications)
      (match? ([] (. tree nodes) nested)
        (case (call .node-style-rule-application applied)
          (if (== (. applied args count) 0)
            (continue)
          )
          (let given (list TypeId))
          (for (in value ([] (. tree children) (. applied args)))
            (let sheet (== (call (. types intrinsic-of) receiver) .style-sheet))
            (let scope
              (call enter-theme
                (block
                  (arg (if-expr sheet no-type writer))
                  (arg (if-expr sheet receiver no-type))
                  (arg nested)
                )
              )
            )
            (let type (call infer value))
            (call leave-theme scope)
            (if (or (== type invalid-type) (== type no-type))
              (return)
            )
            (+= given type)
          )
          (let (tuple level member taken mismatch) (call match-style-rule receiver (. applied name) given))
          (let chosen (if-expr (and (!= level no-type) (!= level invalid-type)) member (call DeclRef 0 0)))
          (if (and (== level no-type) (not taken))
            (= chosen (call own-sheet-rule receiver (. applied name) given))
          )
          (if (!= (. chosen decl) 0)
            (let wanted (call rule-argument-types chosen))
            (for (in position (..< 0 (. given length)))
              (let value ([] (. tree children) (+ (. applied args start) position)))
              (call (. conversions convert)
                (block
                  (arg value)
                  (arg value)
                  (arg ([] given position))
                  (arg ([] (!! wanted) position))
                  (arg .reason-argument)
                )
              )
            )
          )
        )
      )
    )
  )
  (fn-do _ update-unit-property Bool
    (param statement SyntaxId)
    (param line ASTAssign)
    (param receiver TypeId)
    (param name Atom)
    ; A line of a style rule that names a property of the class that writes it, which sets the
    ; property where the rule is applied, as an attribute of a markup element sets one: the value
    ; is converted to the property's type as one assigned is. A value that reads something
    ; tracked or a slot of a style sheet is set again as it changes by a function of its own, as an
    ; attribute's is (`settle-update`), and one that reads a value the rule takes where an application
    ; gives it values that do (`values-live`). A property a setter answers, a getter, and one of an array are declined.
    (let place (call property-named receiver name))
    (let property ([] (. types properties) (!! place)))
    (let live (or (call (. tree reads-tracked) (. line rhs)) (call reads-slots (. line rhs))))
    (if (or (== (. property storage-kind) .storage-getter) (call is-hidden property name .setter-decl))
      (call decline statement)
      (return false)
    )
    (let declared (. property type))
    (if (== declared no-type)
      (= declared (call demand-member property receiver name))
    )
    (if (or (== declared no-type) (== declared invalid-type) (call is-array-value declared))
      (call decline statement)
      (return false)
    )
    (call expect-feeds (. line rhs) declared)
    (let outer unit-styling)
    (= unit-styling (= (. unit-styling updating) (if-expr live statement 0u32)))
    (let written (call infer-with-expected (. line rhs) declared))
    (= unit-styling outer)
    (if (or (== written invalid-type) (== written no-type))
      (return false)
    )
    (if (== (call (. conversions convert) statement (. line rhs) written declared .reason-assignment) invalid-type)
      (return false)
    )
    (let noted (call (. panics property-of) receiver name))
    (if noted
      (call (. panics note-write) instance noted)
    )
    (let given (and (not live) (call reads-rule-values (. line rhs))))
    (+= (. facts rule-updates) (call RuleUpdate instance statement (as (!! place) U32) given))
    (if given
      (call owner-conversions statement receiver)
    )
    (return (or (not live) (call settle-update statement receiver (as (!! place) U32))))
  )
  (fn-do _ owner-conversions _
    (param statement SyntaxId)
    (param receiver TypeId)
    ; Converts the object a line of a style rule that sets a property of its class is applied to, at
    ; the line, to the owner of the live action that sets it again: as its host where the class is a
    ; markup host, or as a batch where it is one.
    (let host (call derived-interface receiver (. types markup-host-decl)))
    (if (!= host no-type)
      (call (. conversions convert) statement statement receiver host .reason-markup-host)
    )
    (if (call is-batch receiver)
      (call (. conversions convert) statement statement receiver (call batch-type) .reason-markup-batch)
    )
  )
  (fn-do _ settle-update Bool
    (param statement SyntaxId)
    (param receiver TypeId)
    (param place U32)
    ; Types the function that sets again the property a line of a style rule sets where its value
    ; read something tracked, as `settle-attributes` types an attribute's: the local no name
    ; reaches that keeps the object, declared at the line, holds one of the class. The action is
    ; made where the rule is applied (`rule-updater`), for the object as its host where the class
    ; is a markup host, to which it is converted at the line, or as a batch where it is one.
    (let position (. facts live-statements length))
    (while (!= position 0)
      (-= position 1)
      (let live ([] (. facts live-statements) position))
      (if (or (!= (. live instance) instance) (!= (. live site) statement) (!= (. live rerun) no-instance))
        (continue)
      )
      (let resolution (call (. bindings resolution-of) (. frame binding) statement))
      (if (or (!= (. resolution kind) .resolve-slot) (!= (call (. types intrinsic-of) receiver) .class))
        (call decline statement)
        (return false)
      )
      (call (. frame assign) (. resolution slot) receiver)
      (let rerun (call demand-lambda (call intern-nested (call nested-decl-of statement)) (. scratch no-types)))
      (if (or (== rerun no-instance) (!= (. ([] (. instances signatures) rerun) errors count) 0))
        (call decline statement)
        (return false)
      )
      (call (. instances mark-may-panic) instance)
      (= ([] (. facts live-statements) position) (call LiveStatement instance statement rerun 0 place))
      (call owner-conversions statement receiver)
      (return true)
    )
    (let resolution (call (. bindings resolution-of) (. frame binding) statement))
    (if (== (. resolution kind) .resolve-slot)
      (call (. frame assign) (. resolution slot) receiver)
    )
    (return true)
  )
  (fn-do _ declare-unit-style Bool
    (param statement SyntaxId)
    (param rule SyntaxId)
    (param receiver TypeId)
    (param styles (list TypeId))
    (param order U32)
    (match? ([] (. tree nodes) statement)
      (case (call .node-assign line)
        (let name (call style-name tree (. line lhs)))
        (let sheet (== (call (. types intrinsic-of) receiver) .style-sheet))
        (if (or (!= (. line op) .eq-op) (not name) (and (not sheet) (call property-named receiver name)))
          (call decline statement)
          (return false)
        )
        (let (tuple index position) (call find-style-property styles name statement))
        (if (== position (. U32 max))
          (if (or (and (== index (. U32 max)) (call (. program module-by-name) "core/style")) sheet)
            (call decline statement)
            (else-if (== index (. U32 max))
              (call (. frame diagnose) (. line lhs) .stated (call (. program store-atom) "Property not found"))
            )
          )
          (return false)
        )
        (let property ([] (. facts style-properties) position))
        (if sheet
          (let slotted
            (call declare-own-slot
              (block
                (arg statement)
                (arg rule)
                (arg index)
                (arg position)
                (arg order)
                (arg (. line rhs))
                (arg receiver)
              )
            )
          )
          (if (!= slotted 0)
            (return (== slotted 1))
          )
          (if (call reads-sheet-member (. line rhs) receiver)
            (call decline statement)
            (return false)
          )
        )
        (if (call (. tree is-inherit) (. line rhs))
          (return (call declare-inherit statement rule index position 0 order))
        )
        (if (and (not sheet) (call defers-slot (. line rhs)))
          (if (or (not (call demand-style-sites)) (not (call demand-sheet-declarations)))
            (call decline statement)
            (return false)
          )
          (call (. facts add-style-declaration)
            (block
              (arg
                (call StyleDeclaration
                  (block
                    (arg instance)
                    (arg rule)
                    (arg statement)
                    (arg (. ([] (. facts style-uses) index) type))
                    (arg position)
                    (arg 0)
                    (arg order)
                    (arg true)
                    (arg false)
                    (arg false)
                    (arg (- (. U32 max) 1))
                  )
                )
              )
            )
          )
          (return true)
        )
        (if (or (not (call style-value-ready (. property type))) (not (call demand-style-sites)))
          (call decline statement)
          (return false)
        )
        (let live (or (call (. tree reads-tracked) (. line rhs)) (call reads-slots (. line rhs))))
        (if (and live (or (call reads-rule-values (. line rhs)) (not (call demand-style-authors receiver))))
          (call decline statement)
          (return false)
        )
        (let outer unit-styling)
        (= unit-styling (= (. unit-styling styling) (if-expr live statement 0u32)))
        (let scope
          (call enter-theme
            (block
              (arg (if-expr sheet no-type (call rule-writer receiver)))
              (arg (if-expr sheet receiver no-type))
              (arg statement)
            )
          )
        )
        (let written (call style-value (. line rhs) (. property type)))
        (let themed (call leave-theme scope))
        (= unit-styling outer)
        (if (or (== written invalid-type) (== written no-type))
          (return false)
        )
        (if (== (call (. conversions convert) statement (. line rhs) written (. property type) .reason-assignment) invalid-type)
          (return false)
        )
        (if (!= themed (. U32 max))
          (return (call declare-themed statement rule index position 0 order (. line rhs) themed))
        )
        (let cached (and (not live) (call holds-handle (. property type)) (call declaration-static (. line rhs))))
        (if cached
          (call note-static-value statement (. property type))
        )
        (let declaration
          (call StyleDeclaration
            (block
              (arg instance)
              (arg rule)
              (arg statement)
              (arg (. ([] (. facts style-uses) index) type))
              (arg position)
              (arg 0)
              (arg order)
              (arg (call fixed-style-value (. line rhs)))
              (arg false)
              (arg cached)
            )
          )
        )
        (= (. declaration reads-given) (and (not live) (call reads-rule-values (. line rhs))))
        (if (and (not live) (not (. declaration fixed)) (not cached))
          (let given (call rule-value-slots rule))
          (if (!= (. given length) 0)
            (if (call holds-handle (. property type))
              (= (. declaration once-given) (call given-static (. line rhs) given))
              (else
                (= (. declaration fixed-given) (call given-fixed (. line rhs) given))
              )
            )
          )
        )
        (call (. facts add-style-declaration) declaration)
        (if live
          (+= (. facts style-authors) (call StyleAuthor instance statement))
        )
        (return true)
      )
    )
    (call decline statement)
    (return false)
  )
  (fn-do _ declare-inherit Bool
    (param statement SyntaxId)
    (param element SyntaxId)
    (param index U32)
    (param position U32)
    (param layer U32)
    (param order U32)
    ; A declaration of `inherit`, as the reference makes one: the runtime takes the property's value
    ; from the parent as it settles, for a property that is `@inherited`; for any other it is the
    ; reference's error.
    (let property ([] (. facts style-properties) position))
    (if (== (/and/ (. property flags) 1) 0)
      (call (. frame diagnose)
        (block
          (arg statement)
          (arg .stated)
          (arg
            (call (. program store-atom)
              (block
                (arg
                  (paragraph
                    (str "Style property \"" (. property name text) "\" is not @inherited, so it cannot be assigned \"inherit\"")
                  )
                )
              )
            )
          )
        )
      )
      (return false)
    )
    (if (not (call demand-style-inherits))
      (call decline statement)
      (return false)
    )
    (call (. facts add-style-declaration)
      (block
        (arg
          (call StyleDeclaration
            (block
              (arg instance)
              (arg element)
              (arg statement)
              (arg (. ([] (. facts style-uses) index) type))
              (arg position)
              (arg layer)
              (arg order)
              (arg true)
              (arg true)
            )
          )
        )
      )
    )
    (return true)
  )
  (fn-do _ style-value-ready Bool
    (param type TypeId)
    ; Whether the runtime has what declares a value of a style property's type: a number or a
    ; truth is its own bits, as is a union whose cases are each a whole number of at most 32 bits;
    ; an object, a value boxed, and any other union are held by the runtime's holders
    ; (`demand-style-holders`), each case of a union that is no such number by its own. A union
    ; nested in a union has no shape here.
    (if (not (call holds-handle type))
      (return true)
    )
    (if (not (call demand-style-holders))
      (return false)
    )
    (let inner (if-expr (call (. types is-optional) type) (call (. types optional-inner) type) type))
    (if (!= (call (. types intrinsic-of) inner) .union)
      (return (call style-holder-ready inner))
    )
    (for (in item (call (. types cases-of) inner))
      (if (and (not (call inline-style-case (. item type))) (not (call style-holder-ready (. item type))))
        (return false)
      )
    )
    (return true)
  )
  (fn-do _ style-holder-ready Bool
    (param type TypeId)
    ; Whether a style value of a type that is no union has a holder of the runtime's: an object
    ; its `StyleValueHolder`, which takes it as its optional, and any other value its box. The
    ; instance typed is noted as holding an object so (`Facts.coding-users`).
    (if (== (call (. types intrinsic-of) type) .union)
      (return false)
    )
    (let object (== (call (. types intrinsic-of) type) .class))
    (if (not (call demand-style-coding type object))
      (return false)
    )
    (if (not object)
      (return true)
    )
    (for (in position (..< 0 (. facts style-codings length)))
      (let coding ([] (. facts style-codings) position))
      (if (and (== (. coding type) type) (!= (. coding intern) no-instance))
        (if (== (. coding value-holder) no-instance)
          (let box (call (. types well-known-type-of) "core/style" "StyleValueHolder" type))
          (if (== box invalid-type)
            (return false)
          )
          (let mark (. scratch types mark))
          (call (. scratch types push) (. coding taken))
          (let holder (call (. calls demand-constructor) box mark))
          (call (. scratch types rewind) mark)
          (if (== holder no-instance)
            (return false)
          )
          (= (. ([] (. facts style-codings) position) value-holder) holder)
        )
        (+= (. facts coding-users) (call CodingUser instance type true))
        (return true)
      )
    )
    (return false)
  )
  (fn-do _ holds-handle Bool
    (param type TypeId)
    ; Whether the runtime holds a handle to a value of a style property's type, as the reference's
    ; `styleValueNeedsHolder` says: an object, a value boxed, or a union with a case that is no
    ; whole number of at most 32 bits.
    (let inner (if-expr (call (. types is-optional) type) (call (. types optional-inner) type) type))
    (if (call scalar-style inner)
      (return false)
    )
    (if (!= (call (. types intrinsic-of) inner) .union)
      (return true)
    )
    (for (in item (call (. types cases-of) inner))
      (if (not (call inline-style-case (. item type)))
        (return true)
      )
    )
    (return false)
  )
  (fn-expr _ inline-style-case Bool
    (param type TypeId)
    ; Whether a case of a union style value is kept in the slot's bits above its number: a whole
    ; number of at most 32 bits.
    (and (> size 0) (<= size 32) (call is-integer-kind (call (. types intrinsic-of) type)))
    (where
      (lazy size (. ([] (. types completions) type) bit-size))
    )
  )
  (fn-do _ declaration-static Bool
    (param value SyntaxId)
    ; Whether a style value reads nothing that differs from one making of the element, or one
    ; application of the rule, to the next, as the reference's `styleExpressionIsDeclarationStatic`
    ; says: no style, no name tracked, no `this`, and no local, argument or member.
    (for (in node (.. (call (. tree subtree-start) value) value))
      (match? ([] (. tree nodes) node)
        (case .node-style-read-expression
          (return false)
        )
        (case (call .node-identifier row)
          (if (or (. row is-tracked) (== (. row name text) "this"))
            (return false)
          )
          (let kind (. (call (. bindings resolution-of) (. frame binding) node) kind))
          (if (or (== kind .resolve-slot) (== kind .resolve-member))
            (return false)
          )
        )
      )
    )
    (return true)
  )
  (fn-do _ note-static-value _
    (param statement SyntaxId)
    (param type TypeId)
    ; A value the reference evaluates once for every making of the declaration that writes it,
    ; which a function of its own evaluates (`Facts.note-static-value`).
    (call (. facts note-static-value) module statement instance type)
  )
  (fn-do _ demand-style-holders Bool
    ; The functions of the style runtime a declaration of a value it holds a handle to calls, typed
    ; once: the declaration by a holder for an association and again by a live action, and the
    ; declaration of a value evaluated once for every making, for a site and for an association.
    (if (not (call demand-style-sites))
      (return false)
    )
    (let runtime (. facts style-runtime))
    (if (== (. runtime template-object) no-instance)
      (let module-id (. (call class-ref types (call (. types type-row) .style)) module))
      (let info (call (. types well-known-type) "core/style" "StyleInfo"))
      (let association (call (. types well-known-type) "core/style" "StyleSiteAssociation"))
      (let pointer (call (. types well-known-type) "core" "Pointer"))
      (let maker (call (. types well-known-type) "core/style" "StyleStaticMaker"))
      (let base (call (. types well-known-type) "core/style" "StyleObjectHolder"))
      (if (or info-missing (== pointer invalid-type) (== maker invalid-type) (== base invalid-type))
        (return false)
      )
      (lazy info-missing (or (== info invalid-type) (== association invalid-type)))
      (if (== (. runtime held) no-type)
        (= (. runtime held) (call (. types optional-of) base))
      )
      (let mark (. scratch types mark))
      (call (. scratch types push) association)
      (call (. scratch types push) info)
      (call (. scratch types push) (. types size-type))
      (call (. scratch types push) (call (. types type-row) .uint32))
      (call (. scratch types push) (call (. types type-row) .uint32))
      (call (. scratch types push) (. types bool-type))
      (call (. scratch types push) (. runtime held))
      (call (. scratch types push) (call (. types type-row) .uint32))
      (call (. scratch types push) (call (. types type-row) .int64))
      (= (. runtime template-object)
        (call (. calls demand-runtime-call)
          (block
            (arg module-id)
            (arg no-type)
            (arg (call (. program store-atom) "style-template-object"))
            (arg mark)
          )
        )
      )
      (call (. scratch types rewind) mark)
      (call (. scratch types push) (. types size-type))
      (call (. scratch types push) info)
      (call (. scratch types push) (. types size-type))
      (call (. scratch types push) (call (. types type-row) .uint32))
      (call (. scratch types push) (call (. types type-row) .uint32))
      (call (. scratch types push) (. types size-type))
      (call (. scratch types push) maker)
      (= (. runtime site-cached)
        (call (. calls demand-runtime-call)
          (block
            (arg module-id)
            (arg no-type)
            (arg (call (. program store-atom) "style-template-site-static-cached"))
            (arg mark)
          )
        )
      )
      (call (. scratch types rewind) mark)
      (call (. scratch types push) pointer)
      (call (. scratch types push) info)
      (call (. scratch types push) (. types size-type))
      (call (. scratch types push) (call (. types type-row) .uint32))
      (call (. scratch types push) (call (. types type-row) .uint32))
      (call (. scratch types push) (call (. types type-row) .int64))
      (call (. scratch types push) (. types bool-type))
      (call (. scratch types push) (. runtime held))
      (call (. scratch types push) (call (. types type-row) .uint32))
      (call (. scratch types push) (call (. types type-row) .int64))
      (= (. runtime author-object)
        (call (. calls demand-runtime-call)
          (block
            (arg module-id)
            (arg no-type)
            (arg (call (. program store-atom) "style-author-dynamic-object"))
            (arg mark)
          )
        )
      )
      (call (. scratch types rewind) mark)
      (= (. facts style-runtime) runtime)
    )
    (return
      (scope (and template-ready (!= (. runtime author-object) no-instance))
        (lazy template-ready (and (!= (. runtime template-object) no-instance) (!= (. runtime site-cached) no-instance)))
      )
    )
  )
  (fn-do _ demand-style-inherits Bool
    ; The function of the style runtime a declaration of `inherit` calls, with those of a site,
    ; typed once.
    (if (not (call demand-style-sites))
      (return false)
    )
    (let runtime (. facts style-runtime))
    (if (== (. runtime site-inherit) no-instance)
      (let module-id (. (call class-ref types (call (. types type-row) .style)) module))
      (let info (call (. types well-known-type) "core/style" "StyleInfo"))
      (let mark (. scratch types mark))
      (call (. scratch types push) (. types size-type))
      (call (. scratch types push) info)
      (call (. scratch types push) (. types size-type))
      (call (. scratch types push) (call (. types type-row) .uint32))
      (call (. scratch types push) (call (. types type-row) .uint32))
      (= (. runtime site-inherit)
        (call (. calls demand-runtime-call)
          (block
            (arg module-id)
            (arg no-type)
            (arg (call (. program store-atom) "style-template-site-inherit"))
            (arg mark)
          )
        )
      )
      (call (. scratch types rewind) mark)
      (= (. facts style-runtime) runtime)
    )
    (return (!= (. runtime site-inherit) no-instance))
  )
  (fn-do _ reads-slots Bool
    (param value SyntaxId)
    ; Whether a value reads a slot of a style sheet by `$name` (`read-variable`), which a theme
    ; switch changes: a name some sheet declares a slot of. A read of a style's property is not
    ; tracked.
    (for (in node (.. (call (. tree subtree-start) value) value))
      (match? ([] (. tree nodes) node)
        (case (call .node-style-read-expression row)
          (if (call names-sheet-slot (. row name))
            (return true)
          )
        )
      )
    )
    (return false)
  )
  (fn-do _ reads-rule-values Bool
    (param value SyntaxId)
    ; Whether a value of a style rule reads a value the rule takes.
    (for (in node (.. (call (. tree subtree-start) value) value))
      (match? ([] (. tree nodes) node)
        (case .node-identifier
          (let resolution (call (. bindings resolution-of) (. frame binding) node))
          (if (and (== (. resolution kind) .resolve-slot) not-this)
            (return true)
          )
          (lazy not-this (!= (. ([] (. bindings slots) (. resolution slot)) kind) .slot-this))
        )
      )
    )
    (return false)
  )
  (fn-expr _ scalar-style Bool
    (param type TypeId)
    ; Whether a style property's value is kept in its slot as itself: a number, a truth or a
    ; character, not optional, as the reference's `NumberType` is.
    (scope (and (call intrinsic-is-numeric kind) (!= kind .cpointer) (!= kind .number))
      (lazy kind (call (. types intrinsic-of) type))
    )
  )
  (fn-do _ style-value TypeId
    (param value SyntaxId)
    (param declared TypeId)
    ; The type of the value a style declaration gives a property of a type, as the reference's
    ; `compileStyleDeclarationExpression` reads it: a name alone, untracked, that names a case of the
    ; property's union that holds nothing is that case, before anything else the name may be, and is
    ; planned as `static-get` plans a case named on its union; any other value is typed as expected.
    (match? ([] (. tree nodes) value)
      (case (call .node-identifier row)
        (if (and (not (. row is-tracked)) (call bare-case declared (. row name)))
          (let union
            (scope (if-expr (call (. types is-optional) declared) inner declared)
              (lazy inner (call (. types optional-inner) declared))
            )
          )
          (let cased (call static-get value union (. row name)))
          (call (. facts replace-node-type) instance value cased)
          (return cased)
        )
      )
    )
    (return (call infer-with-expected value declared))
  )
  (fn-do _ bare-case Bool
    (param declared TypeId)
    (param name Atom)
    (let union (if-expr (call (. types is-optional) declared) (call (. types optional-inner) declared) declared))
    (return-if false (if (!= (call (. types intrinsic-of) union) .union)))
    (for (in fact ([] (. types cases) (. (call (. types completion-of) union) cases)))
      (if (and (. fact name) (== (!! (. fact name)) name) (or (. fact is-default) (== (. fact type) no-type)))
        (return true)
      )
    )
    (return false)
  )
  (fn-do _ fixed-style-value Bool
    (param value SyntaxId)
    ; Whether a style value reads nothing that can differ from one making of the element to the
    ; next, as the reference's `styleExpressionIsStatic` says: no style, no name tracked, no
    ; `this`, and no local, member or global but `true`, `false` and `null`.
    (for (in node (.. (call (. tree subtree-start) value) value))
      (match? ([] (. tree nodes) node)
        (case .node-style-read-expression
          (return false)
        )
        (case (call .node-identifier row)
          (if (or (. row is-tracked) (== (. row name text) "this"))
            (return false)
          )
          (let resolution (call (. bindings resolution-of) (. frame binding) node))
          (if (or (== (. resolution kind) .resolve-slot) (== (. resolution kind) .resolve-member))
            (return false)
          )
          (if (and (== (. resolution kind) .resolve-global) not-literal)
            (return false)
          )
          (lazy not-literal (not (call (. types is-literal-global) (. resolution module) (. resolution decl))))
        )
      )
    )
    (return true)
  )
  (fn-do _ rule-value-slots (list SlotId)
    (param rule SyntaxId)
    (let slots (list SlotId))
    (match? ([] (. tree nodes) rule)
      (case (call .node-rule-syntax declared)
        (for (in arg ([] (. tree children) (. declared args)))
          (match? ([] (. tree nodes) arg)
            (case (call .node-argument-decl shape)
              (match? ([] (. tree nodes) (. shape pattern))
                (case (call .node-type-capture capture)
                  (let resolution (call (. bindings resolution-of) (. frame binding) (. capture id)))
                  (if (== (. resolution kind) .resolve-slot)
                    (+= slots (. resolution slot))
                  )
                )
              )
            )
          )
        )
      )
    )
    (return slots)
  )
  (fn-do _ given-fixed Bool
    (param value SyntaxId)
    (param given (list SlotId))
    (for (in node (.. (call (. tree subtree-start) value) value))
      (match? ([] (. tree nodes) node)
        (case .node-style-read-expression
          (return false)
        )
        (case (call .node-identifier row)
          (if (or (. row is-tracked) (== (. row name text) "this"))
            (return false)
          )
          (let resolution (call (. bindings resolution-of) (. frame binding) node))
          (if (== (. resolution kind) .resolve-member)
            (return false)
          )
          (if (and (== (. resolution kind) .resolve-slot) (== (call (. given find) (. resolution slot)) null))
            (return false)
          )
          (if (and (== (. resolution kind) .resolve-global) not-literal)
            (return false)
          )
          (lazy not-literal (not (call (. types is-literal-global) (. resolution module) (. resolution decl))))
        )
      )
    )
    (return true)
  )
  (fn-do _ given-static Bool
    (param value SyntaxId)
    (param given (list SlotId))
    (for (in node (.. (call (. tree subtree-start) value) value))
      (match? ([] (. tree nodes) node)
        (case .node-style-read-expression
          (return false)
        )
        (case (call .node-identifier row)
          (if (or (. row is-tracked) (== (. row name text) "this"))
            (return false)
          )
          (let resolution (call (. bindings resolution-of) (. frame binding) node))
          (if (== (. resolution kind) .resolve-member)
            (return false)
          )
          (if (and (== (. resolution kind) .resolve-slot) (== (call (. given find) (. resolution slot)) null))
            (return false)
          )
        )
      )
    )
    (return true)
  )
  (fn-do _ share-written-values _
    (param index U32)
    (param written AST)
    (param binding BindingId)
    (let fixed true)
    (let static true)
    (match ([] (. written nodes) (. ([] (. facts style-applications) index) written))
      (case (call .node-style-rule-application applied)
        (for (in value ([] (. written children) (. applied args)))
          (for (in node (.. (call (. written subtree-start) value) value))
            (match? ([] (. written nodes) node)
              (case .node-style-read-expression
                (= fixed false)
                (= static false)
              )
              (case (call .node-get-expression row)
                (if (. row is-tracked)
                  (= fixed false)
                  (= static false)
                )
              )
              (case (call .node-identifier row)
                (let resolution (call (. bindings resolution-of) binding node))
                (if (or tracked-or-this (== (. resolution kind) .resolve-slot) member-read)
                  (= fixed false)
                  (= static false)
                )
                (lazy tracked-or-this (or (. row is-tracked) (== (. row name text) "this")))
                (lazy member-read (== (. resolution kind) .resolve-member))
                (if (and (== (. resolution kind) .resolve-global) (not literal))
                  (= fixed false)
                )
                (lazy literal (call (. types is-literal-global) (. resolution module) (. resolution decl)))
              )
            )
          )
        )
      )
      (default
        (return)
      )
    )
    (= (. ([] (. facts style-applications) index) fixed-values) fixed)
    (= (. ([] (. facts style-applications) index) static-values) static)
    (call revise-application index)
  )
  (fn-do _ bind-given-slots Bool
    (param index U32)
    (param application SyntaxId)
    (param unit InstanceId)
    (param home ModuleId)
    (param reader InstanceId)
    ; Binds the values a style rule is given as slots of style sheets where it is applied: a line
    ; that declares one alone takes the slot (`rule-slots`), and one that computes with them is
    ; evaluated from the slots by the runtime (`rule-themes`). Any other read of such a value is
    ; reported.
    (let written (. ([] (. program modules) home) tree))
    (let applied
      (match? ([] (. written nodes) application)
        (case (call .node-style-rule-application written)
          written
        )
      )
    )
    (if (not applied)
      (return true)
    )
    (let row ([] (. instances rows) unit))
    (let owner ([] (. program modules) (. row module)))
    (let names (list SyntaxId))
    (let body SyntaxId 0)
    (match? ([] (. owner decls) (. row initializer))
      (case (call .decl-style-rule rule)
        (= body (. rule syntax))
        (match? ([] (. owner tree nodes) (. rule syntax))
          (case (call .node-rule-syntax declared)
            (for (in arg ([] (. owner tree children) (. declared args)))
              (match? ([] (. owner tree nodes) arg)
                (case (call .node-argument-decl shape)
                  (match? ([] (. owner tree nodes) (. shape pattern))
                    (case (call .node-type-capture capture)
                      (+= names (. capture id))
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
    (let params (list SlotId))
    (let reads (list ThemeRead))
    (let values (list SyntaxId))
    (let positions (list U32))
    (for (in position (..< 0 (. applied args count)))
      (let value ([] (. written children) (+ (. applied args start) position)))
      (let read (call (. facts theme-read-of) reader value))
      (if (not read)
        (for (in node (.. (call (. written subtree-start) value) value))
          (if (call (. facts theme-read-of) reader node)
            (call report-at
              (block
                (arg home)
                (arg node)
                (arg
                  (paragraph
                    "A style rule takes a StyleSheet slot only alone, as in \"(• bg panel-color)\", not in an expression"
                  )
                )
              )
            )
            (return false)
          )
        )
        (continue)
      )
      (if (or (>= position (. names length)) (== body 0))
        (call decline application)
        (return false)
      )
      (+= params (. (call (. bindings resolution-of) (. row binding) ([] names position)) slot))
      (+= reads read)
      (+= values value)
      (+= positions position)
    )
    (return-if true (if (== (. params length) 0)))
    (let covered (list SyntaxId))
    (let count (as (. facts style-declarations length) U32))
    (let place (call (. facts first-style-declaration) unit))
    (while (< place count)
      (let declared ([] (. facts style-declarations) place))
      (= place (call (. facts next-style-declaration) place))
      (let rhs SyntaxId 0)
      (match? ([] (. owner tree nodes) (. declared site))
        (case (call .node-assign line)
          (= rhs (. line rhs))
        )
      )
      (if (== rhs 0)
        (continue)
      )
      (if (is ([] (. owner tree nodes) rhs) .node-identifier)
        (let resolution (call (. bindings resolution-of) (. row binding) rhs))
        (let found (only-if (call (. params find) (. resolution slot)) (if (== (. resolution kind) .resolve-slot))))
        (if (== found null)
          (continue)
        )
        (let read ([] reads found))
        (let use ([] (. facts style-sheet-uses) (. read sheet)))
        (let slot ([] (. facts sheet-slots) (+ (. use first) (. read slot))))
        (let (tuple number offset projection)
          (call slot-binding
            (block
              (arg (. row module))
              (arg (. declared site))
              (arg (. declared property))
              (arg rhs)
              (arg (. slot name))
              (arg (. use type))
              (arg application)
            )
          )
        )
        (if (== number (. U32 max))
          (return false)
        )
        (call revise-application index)
        (call (. facts add-rule-slot) (call RuleSlot index (. declared site) number offset projection))
        (+= covered rhs)
        (continue)
      )
      (let given (call given-reads unit rhs params))
      (if (or (not given) (== (. given length) 0))
        (continue)
      )
      (if (not (call bind-given-theme index unit declared given params reads values positions home application (. applied name)))
        (return false)
      )
      (for (in node given)
        (+= covered node)
      )
    )
    (for (in node (.. (call (. owner tree subtree-start) body) body))
      (if (or (!= (call (. names find) node) null) (!= (call (. covered find) node) null) not-identifier)
        (continue)
      )
      (lazy not-identifier (not (is ([] (. owner tree nodes) node) .node-identifier)))
      (let resolution (call (. bindings resolution-of) (. row binding) node))
      (let found (only-if (call (. params find) (. resolution slot)) (if (== (. resolution kind) .resolve-slot))))
      (if (!= found null)
        (let read ([] reads found))
        (let slot ([] (. facts sheet-slots) (+ (. ([] (. facts style-sheet-uses) (. read sheet)) first) (. read slot))))
        (call report-at
          (block
            (arg home)
            (arg ([] values found))
            (arg
              (paragraph
                (str "Style rule \"" (. applied name text) "\" computes with what it is given, so it cannot take StyleSheet slot \"" (. slot name text) "\"")
              )
            )
          )
        )
        (return false)
      )
    )
    (return true)
  )
  (fn-do _ given-reads (? (list SyntaxId))
    (param unit InstanceId)
    (param value SyntaxId)
    (param params (list SlotId))
    ; The names by which a value a line of a style rule declares reads the values the rule takes as
    ; slots of style sheets (`params`); none where it also reads another local, a member, a style, a
    ; slot of a style sheet or anything tracked, which the runtime cannot evaluate from the slots.
    (let row ([] (. instances rows) unit))
    (let source (. ([] (. program modules) (. row module)) tree))
    (let found (list SyntaxId))
    (for (in node (.. (call (. source subtree-start) value) value))
      (if (call (. facts theme-read-of) unit node)
        (return null)
      )
      (match? ([] (. source nodes) node)
        (case .node-style-read-expression
          (return null)
        )
        (case (call .node-identifier ident)
          (if (or (. ident is-tracked) (== (. ident name text) "this"))
            (return null)
          )
          (let resolution (call (. bindings resolution-of) (. row binding) node))
          (if (== (. resolution kind) .resolve-member)
            (return null)
          )
          (if (== (. resolution kind) .resolve-slot)
            (if (== (call (. params find) (. resolution slot)) null)
              (return null)
            )
            (+= found node)
          )
        )
      )
    )
    (return found)
  )
  (fn-do _ bind-given-theme Bool
    (param index U32)
    (param unit InstanceId)
    (param declared StyleDeclaration)
    (param given (list SyntaxId))
    (param params (list SlotId))
    (param reads (list ThemeRead))
    (param values (list SyntaxId))
    (param positions (list U32))
    (param home ModuleId)
    (param application SyntaxId)
    (param name Atom)
    ; Records that a line of a style rule applied at `application` computes its value with the values
    ; the rule takes as slots of one style sheet, read by the names `given`, as a value the runtime
    ; evaluates from the slots of the subtree's sheet (`rule-themes`). Each slot must have the type
    ; the rule takes its value as.
    (let row ([] (. instances rows) unit))
    (let taken (call rule-argument-types (call DeclRef (. row module) (. row initializer))))
    (let givens (list ThemedGiven))
    (let sheet (. U32 max))
    (for (in node given)
      (let found (!! (call (. params find) (. (call (. bindings resolution-of) (. row binding) node) slot))))
      (let read ([] reads found))
      (let use ([] (. facts style-sheet-uses) (. read sheet)))
      (let slot ([] (. facts sheet-slots) (+ (. use first) (. read slot))))
      (if (and (!= sheet (. U32 max)) (!= sheet (. read sheet)))
        (call report-at
          (block
            (arg home)
            (arg ([] values found))
            (arg
              (paragraph
                (str "A style value reads slots of one StyleSheet: \"" (. slot name text) "\" is a slot of " (call type-short-name types (. use type)) ", and others it reads are slots of " (call type-short-name types (. ([] (. facts style-sheet-uses) sheet) type)))
              )
            )
          )
        )
        (return false)
      )
      (= sheet (. read sheet))
      (let wanted
        (scope (if-expr (and taken (< place (. taken length))) ([] taken (as ([] positions found) Size)) no-type)
          (lazy place (as ([] positions found) Size))
        )
      )
      (if (!= wanted (. slot type))
        (call report-at
          (block
            (arg home)
            (arg ([] values found))
            (arg
              (paragraph
                (str "Style rule \"" (. name text) "\" takes " (call type-display types wanted) ", so it can compute only with a StyleSheet slot of that type, not \"" (. slot name text) "\" of type " (call type-display types (. slot type)))
              )
            )
          )
        )
        (return false)
      )
      (let param ([] params found))
      (let seen false)
      (for (in item givens)
        (if (== (. item param) param)
          (= seen true)
        )
      )
      (if (not seen)
        (+= givens (call ThemedGiven param (. read slot)))
      )
    )
    (if (not (call demand-themed-runtime))
      (call decline application)
      (return false)
    )
    (let property ([] (. facts style-properties) (. declared property)))
    (let themed
      (call (. facts note-given-themed-value)
        (block
          (arg (. row module))
          (arg (. declared site))
          (arg unit)
          (arg (. property type))
          (arg sheet)
          (arg givens)
        )
      )
    )
    (call revise-application index)
    (call (. facts add-rule-theme) (call RuleTheme index (. declared site) themed))
    (return true)
  )
  (fn-do _ demand-style-sites Bool
    ; The functions of the style runtime a markup element that declares styles calls, typed once.
    ; The element's object is given to them as the `Pointer` the reference casts it to.
    (if (not (call demand-style-runtime))
      (return false)
    )
    (let runtime (. facts style-runtime))
    (if (== (. runtime info-required) no-instance)
      (let module-id (. (call class-ref types (call (. types type-row) .style)) module))
      (let info (call (. types well-known-type) "core/style" "StyleInfo"))
      (let association (call (. types well-known-type) "core/style" "StyleSiteAssociation"))
      (let pointer (call (. types well-known-type) "core" "Pointer"))
      (if (or (== info invalid-type) (== association invalid-type) (== pointer invalid-type))
        (return false)
      )
      (let mark (. scratch types mark))
      (call (. scratch types push) (. types index-type))
      (= (. runtime info-required)
        (call (. calls demand-runtime-call)
          (block
            (arg module-id)
            (arg no-type)
            (arg (call (. program store-atom) "style-info-required"))
            (arg mark)
          )
        )
      )
      (call (. scratch types rewind) mark)
      (call (. scratch types push) (. types size-type))
      (call (. scratch types push) info)
      (call (. scratch types push) (. types size-type))
      (call (. scratch types push) (call (. types type-row) .uint32))
      (call (. scratch types push) (call (. types type-row) .uint32))
      (call (. scratch types push) (call (. types type-row) .int64))
      (call (. scratch types push) (. types bool-type))
      (= (. runtime site-static)
        (call (. calls demand-runtime-call)
          (block
            (arg module-id)
            (arg no-type)
            (arg (call (. program store-atom) "style-template-site-static"))
            (arg mark)
          )
        )
      )
      (call (. scratch types rewind) mark)
      (call (. scratch types push) association)
      (call (. scratch types push) info)
      (call (. scratch types push) (. types size-type))
      (call (. scratch types push) (call (. types type-row) .uint32))
      (call (. scratch types push) (call (. types type-row) .uint32))
      (call (. scratch types push) (call (. types type-row) .int64))
      (call (. scratch types push) (. types bool-type))
      (= (. runtime template-static)
        (call (. calls demand-runtime-call)
          (block
            (arg module-id)
            (arg no-type)
            (arg (call (. program store-atom) "style-template-static"))
            (arg mark)
          )
        )
      )
      (call (. scratch types rewind) mark)
      (call (. scratch types push) pointer)
      (call (. scratch types push) (. types size-type))
      (= (. runtime associate)
        (call (. calls demand-runtime-call)
          (block
            (arg module-id)
            (arg no-type)
            (arg (call (. program store-atom) "style-associate"))
            (arg mark)
          )
        )
      )
      (call (. scratch types rewind) mark)
      (call (. scratch types push) pointer)
      (= (. runtime site-ready)
        (call (. calls demand-runtime-call)
          (block
            (arg module-id)
            (arg no-type)
            (arg (call (. program store-atom) "style-site-ready"))
            (arg mark)
          )
        )
      )
      (call (. scratch types rewind) mark)
      (call (. scratch types push) (. types size-type))
      (= (. runtime site-recording)
        (call (. calls demand-runtime-call)
          (block
            (arg module-id)
            (arg no-type)
            (arg (call (. program store-atom) "style-site-recording"))
            (arg mark)
          )
        )
      )
      (call (. scratch types rewind) mark)
      (call (. scratch types push) (. types size-type))
      (= (. runtime site-recorded)
        (call (. calls demand-runtime-call)
          (block
            (arg module-id)
            (arg no-type)
            (arg (call (. program store-atom) "style-site-recorded"))
            (arg mark)
          )
        )
      )
      (call (. scratch types rewind) mark)
      (= (. facts style-runtime) runtime)
    )
    (return (and (!= (. runtime info-required) no-instance) (!= (. runtime site-static) no-instance) (!= (. runtime template-static) no-instance) (!= (. runtime associate) no-instance) (!= (. runtime site-ready) no-instance) (!= (. runtime site-recording) no-instance) (!= (. runtime site-recorded) no-instance)))
  )
  (fn-do + infer-style-read Found
    (param id SyntaxId)
    (param row ASTStyleReadExpression)
    ; A read of a style property, `$name`, of an object or of `this`: the value the style runtime
    ; holds for the object, resolved against the styles the subject's class sees and those of the
    ; class the read is written in, as the reference resolves it, read by `style-read-bits` and
    ; taken as the property's type, the subject cast to a `Pointer` as the reference casts it. An
    ; optional is read with whether it holds nothing by `style-read-optional`, and a value the
    ; runtime holds a handle to is resolved from it (`style-read-ready`). A name no style answers
    ; that names the flag of a domain reads the flag; any other is the reference's error. A read
    ; written after `?` is a link of an optional chain, read from what the optional holds, as the
    ; reference's `pushChain` makes one. A read of an optional chain written in parentheses, of
    ; an optional otherwise, and of no class or interface, are declined. A read with no object where
    ; there is no `this` finds no property, the reference's error. The runtime's reader is a call,
    ; which ends what is known of properties.
    (if (not (call (. program module-by-name) "core/style"))
      (call (. frame diagnose) id .stated (call (. program store-atom) "Style runtime is not loaded"))
      (return (call Found invalid-type))
    )
    (let subject (. frame self-type))
    (let chained false)
    (if (!= (. row object) 0)
      (if (!= (call (. tree optional-chain-expr) (. row object)) 0)
        (call decline id)
        (return (call Found invalid-type))
      )
      (let object-found (call infer-found (. row object)))
      (let object (. object-found type))
      (let own (. object-found link))
      (if (== object invalid-type)
        (return (call Found invalid-type))
      )
      (let form (if-expr (. row is-optional) (call note-chain id id object) (. ChainForm chain-plain)))
      (if (or (== form .chain-absent) (call absent-after (. row object) object))
        (return (call Found (. types null-type)))
      )
      (let optional (== form .chain-tested))
      (= subject (call link-receiver (. row object) object own optional))
      (= chained (and (or optional (call optional-chained (. row object))) (call (. types is-optional) object)))
      (if (and chained optional)
        (call (. facts unwrapped append) (call UnwrappedFact instance (. row object) subject))
      )
    )
    (if (or (== subject no-type) (== subject invalid-type))
      (call (. frame diagnose) id .stated (call (. program store-atom) (str "Style property \"" (. row name text) "\" not found")))
      (return (call Found invalid-type))
    )
    (if (or (call (. types is-optional) subject) (and (!= (call (. types intrinsic-of) subject) .class) not-interface))
      (call decline id)
      (return (call Found invalid-type))
    )
    (lazy not-interface (!= (call (. types intrinsic-of) subject) .interface))
    (let styles (list TypeId))
    (if (or (not (call add-visible-styles subject styles id)) (not (call add-visible-styles (. frame self-type) styles id)))
      (return (call Found invalid-type))
    )
    (let (tuple index position) (call find-style-property styles (. row name) id))
    (if (== position (. U32 max))
      (if (!= index (. U32 max))
        (return (call Found invalid-type))
      )
      (let text (. row name text))
      (let (tuple domain below) (call accessor-domain text))
      (if (!= (. domain length) 0)
        (return (call Found (call flag-domain id domain below (== (. row object) 0) false)))
      )
      (let variable (call read-variable id (. row name) subject chained))
      (if (!= (. variable type) no-type)
        (return variable)
      )
      (call (. frame diagnose) id .stated (call (. program store-atom) (str "Style property \"" text "\" not found")))
      (return (call Found invalid-type))
    )
    (let property ([] (. facts style-properties) position))
    (if (or (not (call demand-style-runtime)) (not (call style-read-ready (. property type))))
      (call decline id)
      (return (call Found invalid-type))
    )
    (let module-id (. (call class-ref types (call (. types type-row) .style)) module))
    (let optional (call (. types is-optional) (. property type)))
    (let mark (. scratch types mark))
    (call (. scratch types push) subject)
    (call (. scratch types push) (. types index-type))
    (call (. scratch types push) (. types size-type))
    (let reader
      (call (. calls demand-runtime-call)
        (block
          (arg module-id)
          (arg no-type)
          (arg (call (. program store-atom) (if-expr optional "style-read-host-optional" "style-read-host-bits")))
          (arg mark)
        )
      )
    )
    (call (. scratch types rewind) mark)
    (let hosted (!= reader no-instance))
    (if (not hosted)
      (let pointer (call (. types well-known-type) "core" "Pointer"))
      (call (. scratch types push) pointer)
      (call (. scratch types push) (. types index-type))
      (call (. scratch types push) (. types size-type))
      (= reader
        (call (. calls demand-runtime-call)
          (block
            (arg module-id)
            (arg no-type)
            (arg (call (. program store-atom) (if-expr optional "style-read-optional" "style-read-bits")))
            (arg mark)
          )
        )
      )
      (call (. scratch types rewind) mark)
      (if (== pointer invalid-type)
        (= reader no-instance)
      )
    )
    (if (== reader no-instance)
      (call decline id)
      (return (call Found invalid-type))
    )
    (+= (. facts style-reads) (call StyleRead instance id (. ([] (. facts style-uses) index) type) position reader hosted))
    (call (. frame forget-members))
    (return (call (. (call Found (if-expr chained (call (. types optional-of) (. property type)) (. property type))) linking) (. property type)))
  )
  (fn-do + infer-style-property TypeId
    (param id SyntaxId)
    (param row ASTStylePropertyExpression)
    (if (not (call (. program module-by-name) "core/style"))
      (call (. frame diagnose) id .stated (call (. program store-atom) "Style runtime is not loaded"))
      (return invalid-type)
    )
    (let styles (list TypeId))
    (if (not (call add-visible-styles (. frame self-type) styles id))
      (return invalid-type)
    )
    (let (tuple index position) (call find-style-property styles (. row name) id))
    (if (== position (. U32 max))
      (if (!= index (. U32 max))
        (return invalid-type)
      )
      (call (. frame diagnose) id .stated (call (. program store-atom) (str "Style property \"" (. row name text) "\" not found")))
      (return invalid-type)
    )
    (let value (. ([] (. facts style-properties) position) type))
    (let component (. U32 max))
    (let part (. row component))
    (if part
      (if (== (call (. types intrinsic-of) value) .tuple)
        (let fields (call (. types properties-of) value))
        (for (in field (..< 0 (. fields length)))
          (if (== (. ([] fields field) name) part)
            (= component (as field U32))
          )
        )
      )
      (if (== component (. U32 max))
        (call (. frame diagnose)
          (block
            (arg id)
            (arg .stated)
            (arg
              (call (. program store-atom)
                (block
                  (arg (str "Style property \"" (. row name text) "\" has no component \"" (. part text) "\""))
                )
              )
            )
          )
        )
        (return invalid-type)
      )
      (= value (. ([] (call (. types properties-of) value) component) type))
    )
    (if (not (call demand-style-runtime))
      (call decline id)
      (return invalid-type)
    )
    (let module-id (. (call class-ref types (call (. types type-row) .style)) module))
    (let mark (. scratch types mark))
    (call (. scratch types push) value)
    (call (. scratch types push) (. types index-type))
    (call (. scratch types push) (. types size-type))
    (if part
      (call (. scratch types push) (. types index-type))
    )
    (let maker
      (call (. calls demand-runtime-call)
        (block
          (arg module-id)
          (arg no-type)
          (arg (call (. program store-atom) (if-expr part "style-property-component" "style-property")))
          (arg mark)
          (arg 1)
        )
      )
    )
    (call (. scratch types rewind) mark)
    (if (== maker no-instance)
      (call decline id)
      (return invalid-type)
    )
    (+= (. facts style-reads)
      (call StyleRead
        (block
          (arg instance)
          (arg id)
          (arg (. ([] (. facts style-uses) index) type))
          (arg position)
          (arg maker)
          (arg false)
          (arg (. U32 max))
          (arg 0)
          (arg no-type)
          (arg component)
          (arg true)
        )
      )
    )
    (return (. ([] (. instances signatures) maker) returns))
  )
  (fn-do _ read-variable Found
    (param id SyntaxId)
    (param name Atom)
    (param subject TypeId)
    (param chained Bool)
    (let sheets (list TypeId))
    (let levels (list U32))
    (call add-sheet-groups subject sheets levels)
    (call add-sheet-groups (. frame self-type) sheets levels)
    (let found no-type)
    (for (in sheet sheets)
      (let root (call family-root sheet))
      (if (and (!= root found) (call sheet-has-slot root name))
        (if (!= found no-type)
          (call (. frame diagnose)
            (block
              (arg id)
              (arg .stated)
              (arg
                (call (. program store-atom)
                  (block
                    (arg
                      (paragraph
                        (str "\"" (. name text) "\" is a slot of both " (call type-short-name types found) " and " (call type-short-name types root))
                      )
                    )
                  )
                )
              )
            )
          )
          (return (call Found invalid-type))
        )
        (= found root)
      )
    )
    (return-if (call Found no-type) (if (== found no-type)))
    (let number (call sheet-index found module id id))
    (if (== number (. U32 max))
      (return (call Found invalid-type))
    )
    (let use ([] (. facts style-sheet-uses) number))
    (let offset (. U32 max))
    (for (in place (..< (. use first) (+ (. use first) (. use count))))
      (if (== (. ([] (. facts sheet-slots) place) name) name)
        (= offset (- place (. use first)))
      )
    )
    (if (== offset (. U32 max))
      (call decline id)
      (return (call Found invalid-type))
    )
    (let type (. ([] (. facts sheet-slots) (+ (. use first) offset)) type))
    (if (or (not (call demand-style-runtime)) (not (call style-read-ready type)))
      (call decline id)
      (return (call Found invalid-type))
    )
    (let module-id (. (call class-ref types (call (. types type-row) .style)) module))
    (let optional (call (. types is-optional) type))
    (let mark (. scratch types mark))
    (call (. scratch types push) subject)
    (call (. scratch types push) (. types index-type))
    (call (. scratch types push) (. types size-type))
    (call (. scratch types push) (. types bool-type))
    (let reader
      (call (. calls demand-runtime-call)
        (block
          (arg module-id)
          (arg no-type)
          (arg
            (call (. program store-atom)
              (block
                (arg (if-expr optional "style-read-host-sheet-optional" "style-read-host-sheet-bits"))
              )
            )
          )
          (arg mark)
        )
      )
    )
    (call (. scratch types rewind) mark)
    (let hosted (!= reader no-instance))
    (if (not hosted)
      (let pointer (call (. types well-known-type) "core" "Pointer"))
      (call (. scratch types push) pointer)
      (call (. scratch types push) (. types index-type))
      (call (. scratch types push) (. types size-type))
      (call (. scratch types push) (. types bool-type))
      (= reader
        (call (. calls demand-runtime-call)
          (block
            (arg module-id)
            (arg no-type)
            (arg
              (call (. program store-atom)
                (block
                  (arg (if-expr optional "style-read-sheet-optional" "style-read-sheet-bits"))
                )
              )
            )
            (arg mark)
          )
        )
      )
      (call (. scratch types rewind) mark)
      (if (== pointer invalid-type)
        (= reader no-instance)
      )
    )
    (if (or (== reader no-instance) (not (call demand-track-collection)))
      (call decline id)
      (return (call Found invalid-type))
    )
    (+= (. facts style-reads) (call StyleRead instance id no-type (. U32 max) reader hosted number offset type))
    (+= (. facts sheet-reads) 1)
    (if (or (== (. unit-styling styling) 0) (> (call (. tree subtree-start) (. unit-styling styling)) id) (> id (. unit-styling styling)))
      (let context (call live-context (call read-site id)))
      (if (and (== context .live-value) (call is-eager-value))
        (call (. instances mark-live) instance)
        (else-if (and (== context .live-rule) (call is-rule-unit))
          (call (. instances mark-live) instance)
        )
        (else-if (== context .live-statement)
          (call note-live-statement (call read-site id))
        )
      )
    )
    (call (. frame forget-members))
    (return (call (. (call Found (if-expr chained (call (. types optional-of) type) type)) linking) type))
  )
  (fn-do + infer-style-assign (? TypeId)
    (param id SyntaxId)
    (param lhs SyntaxId)
    (param receiver TypeId)
    (param name Atom)
    (param op Operator)
    (param rhs SyntaxId)
    (param value TypeId)
    ; An assignment of a name no member of an object of a class or an interface answers that names
    ; a property of a style the object sees, as the reference's `compileImperativeStyleWrite` makes
    ; one: the value, converted to the property's type as one assigned is, is declared for the
    ; object at the imperative layer, its bits by `style-author-imperative` or where the runtime
    ; holds a handle to it by a holder, the object cast to a `Pointer`. It gives the value converted.
    ; None where no style answers. Any operator but `=` is declined, as is a declaration that may
    ; raise an error, which the reference reports as unhandled.
    (let kind (call (. types intrinsic-of) receiver))
    (if (or (and (!= kind .class) (!= kind .interface)) (call property-named receiver name) no-style)
      (return null)
    )
    (lazy no-style (not (call (. program module-by-name) "core/style")))
    (let styles (call style-vocabulary receiver lhs))
    (if (not styles)
      (return invalid-type)
    )
    (let (tuple index position) (call find-style-property styles name lhs))
    (if (== position (. U32 max))
      (if (!= index (. U32 max))
        (return invalid-type)
      )
      (return null)
    )
    (let property ([] (. facts style-properties) position))
    (if (or (!= op .eq-op) (not (call style-value-ready (. property type))) (not (call demand-style-writes)))
      (call decline id)
      (return invalid-type)
    )
    (let runtime (. facts style-runtime))
    (if (or (!= (. ([] (. instances signatures) (. runtime imperative)) errors count) 0) object-errors)
      (call decline id)
      (return invalid-type)
    )
    (lazy object-errors (!= (. ([] (. instances signatures) (. runtime imperative-object)) errors count) 0))
    (if (== (call (. conversions convert) id rhs value (. property type) .reason-assignment) invalid-type)
      (return invalid-type)
    )
    (+= (. facts style-writes) (call StyleWrite instance id (. ([] (. facts style-uses) index) type) position))
    (return (. property type))
  )
  (fn-do + infer-self-style-assign TypeId
    (param id SyntaxId)
    (param lhs SyntaxId)
    (param op Operator)
    (param name Atom)
    (param rhs SyntaxId)
    ; An assignment of a name nothing declares in a function that has `this`, which the reference
    ; makes a declaration of the property of a style the object sees that the name names, as
    ; `infer-style-assign` says, and otherwise reports as a variable that is not declared.
    (let value (call stored-value rhs (call infer rhs)))
    (if (== value invalid-type)
      (return invalid-type)
    )
    (let styled
      (block
        (only-if (call infer-style-assign id lhs (. frame self-type) name op rhs value) (if (!= (. frame self-type) no-type)))
      )
    )
    (if styled
      (return styled)
    )
    (call (. frame diagnose) id .stated (call (. program store-atom) "Variable not declared"))
    (return invalid-type)
  )
  (fn-do _ demand-style-writes Bool
    ; The functions of the style runtime an assignment that declares a style for an object calls,
    ; typed once, with the record of a style by its number.
    (if (or (not (call demand-style-sites)) (not (call demand-style-holders)))
      (return false)
    )
    (let runtime (. facts style-runtime))
    (if (== (. runtime imperative) no-instance)
      (let module-id (. (call class-ref types (call (. types type-row) .style)) module))
      (let info (call (. types well-known-type) "core/style" "StyleInfo"))
      (let pointer (call (. types well-known-type) "core" "Pointer"))
      (let mark (. scratch types mark))
      (call (. scratch types push) pointer)
      (call (. scratch types push) info)
      (call (. scratch types push) (. types size-type))
      (call (. scratch types push) (call (. types type-row) .int64))
      (call (. scratch types push) (. types bool-type))
      (= (. runtime imperative)
        (call (. calls demand-runtime-call)
          (block
            (arg module-id)
            (arg no-type)
            (arg (call (. program store-atom) "style-author-imperative"))
            (arg mark)
          )
        )
      )
      (call (. scratch types rewind) mark)
      (call (. scratch types push) pointer)
      (call (. scratch types push) info)
      (call (. scratch types push) (. types size-type))
      (call (. scratch types push) (. types bool-type))
      (call (. scratch types push) (. runtime held))
      (call (. scratch types push) (call (. types type-row) .uint32))
      (call (. scratch types push) (call (. types type-row) .int64))
      (= (. runtime imperative-object)
        (call (. calls demand-runtime-call)
          (block
            (arg module-id)
            (arg no-type)
            (arg (call (. program store-atom) "style-author-imperative-object"))
            (arg mark)
          )
        )
      )
      (call (. scratch types rewind) mark)
      (= (. facts style-runtime) runtime)
    )
    (return (and (!= (. runtime imperative) no-instance) (!= (. runtime imperative-object) no-instance)))
  )
  (fn-do _ style-read-ready Bool
    (param type TypeId)
    ; Whether a value of a style property's type is read back from its bits: a number or a truth as
    ; it is, and a handle by the runtime's `style-object-pointer`, to the object it holds or the box
    ; of a value. A union nested in a union has no shape here.
    (let inner (if-expr (call (. types is-optional) type) (call (. types optional-inner) type) type))
    (if (call scalar-style inner)
      (return true)
    )
    (if (not (call holds-handle inner))
      (return true)
    )
    (if (not (call demand-object-pointer))
      (return false)
    )
    (if (!= (call (. types intrinsic-of) inner) .union)
      (return (call style-holder-ready inner))
    )
    (for (in item (call (. types cases-of) inner))
      (if (and (not (call inline-style-case (. item type))) (not (call style-holder-ready (. item type))))
        (return false)
      )
    )
    (return true)
  )
  (fn-do _ demand-object-pointer Bool
    ; The function of the style runtime that resolves the bits of a handle, typed once.
    (let runtime (. facts style-runtime))
    (if (== (. runtime object-pointer) no-instance)
      (let module-id (. (call class-ref types (call (. types type-row) .style)) module))
      (let mark (. scratch types mark))
      (call (. scratch types push) (call (. types type-row) .int64))
      (= (. runtime object-pointer)
        (call (. calls demand-runtime-call)
          (block
            (arg module-id)
            (arg no-type)
            (arg (call (. program store-atom) "style-object-pointer"))
            (arg mark)
          )
        )
      )
      (call (. scratch types rewind) mark)
      (= (. facts style-runtime) runtime)
    )
    (return (!= (. runtime object-pointer) no-instance))
  )
  (fn-do _ flag-domain TypeId
    (param id SyntaxId)
    (param domain String)
    (param below Bool)
    (param bare Bool)
    (param writes Bool)
    ; A read or a write of the flag of a domain: the domain numbered as it is first named, and the
    ; function of the style runtime that reads or writes the flag of the subject cast to a
    ; `Pointer`, `style-node-domain-invalid` or `style-node-domain-write`, or their `-below`
    ; forms, a call that ends what is known of properties. A read gives a `Bool`. A bare one in a
    ; nested function is declined.
    (if (and bare (!= (. ([] (. instances rows) instance) enclosing) no-instance))
      (call decline id)
      (return invalid-type)
    )
    (let index (call style-domain (call (. program store-atom) domain) module id module id))
    (let pointer (call (. types well-known-type) "core" "Pointer"))
    (if (or (== pointer invalid-type) (not (call demand-style-runtime)))
      (call decline id)
      (return invalid-type)
    )
    (let module-id (. (call class-ref types (call (. types type-row) .style)) module))
    (let name (if-expr writes "style-node-domain-write" "style-node-domain-invalid"))
    (let mark (. scratch types mark))
    (call (. scratch types push) pointer)
    (call (. scratch types push) (. types size-type))
    (if writes
      (call (. scratch types push) (. types bool-type))
    )
    (let call
      (call (. calls demand-runtime-call)
        (block
          (arg module-id)
          (arg no-type)
          (arg (call (. program store-atom) (if-expr below (str name "-below") name)))
          (arg mark)
        )
      )
    )
    (call (. scratch types rewind) mark)
    (if (== call no-instance)
      (call decline id)
      (return invalid-type)
    )
    (+= (. facts style-flags) (call StyleFlag instance id index call))
    (call (. frame forget-members))
    (return (. types bool-type))
  )
  (fn-do + infer-style-write TypeId
    (param id SyntaxId)
    (param op Operator)
    (param lhs SyntaxId)
    (param row ASTStyleReadExpression)
    (param rhs SyntaxId)
    ; A write of the flag of a domain, `$is-X-invalid = on`, of an object or of `this`, as the
    ; reference writes it: the value, then the subject, given to the style runtime's writer. The
    ; value is what the write answers. A write of any other name is the reference's error. An
    ; assigning operator, a value that is no `Bool`, a value that reads something tracked, and a
    ; subject chained on an optional, of an optional or of no class are declined.
    (let written (call infer-with-expected rhs (. types bool-type)))
    (if (or (== written invalid-type) (== written no-type))
      (return invalid-type)
    )
    (let text (. row name text))
    (let (tuple domain below) (call accessor-domain text))
    (if (== (. domain length) 0)
      (call (. frame diagnose)
        (block
          (arg lhs)
          (arg .stated)
          (arg (call (. program store-atom) (str "Style values are computed by settling; \"\$" text "\" is not assignable")))
        )
      )
      (return invalid-type)
    )
    (if (or (!= op .eq-op) (!= written (. types bool-type)) (call is-live-statement id) no-style)
      (call decline id)
      (return invalid-type)
    )
    (lazy no-style (not (call (. program module-by-name) "core/style")))
    (let subject (. frame self-type))
    (if (!= (. row object) 0)
      (= subject (call infer (. row object)))
      (if (== subject invalid-type)
        (return invalid-type)
      )
    )
    (if (or (. row is-optional) (call (. types is-optional) subject) (!= (call (. types intrinsic-of) subject) .class))
      (call decline id)
      (return invalid-type)
    )
    (if (== (call flag-domain id domain below (== (. row object) 0) true) invalid-type)
      (return invalid-type)
    )
    (return written)
  )
  (fn-do _ demand-style-runtime Bool
    ; The functions of the style runtime that registering styles calls, typed once.
    (let runtime (. facts style-runtime))
    (if (!= (. runtime register) no-instance)
      (return true)
    )
    (let module-id (. (call class-ref types (call (. types type-row) .style)) module))
    (let info (call (. types well-known-type) "core/style" "StyleInfo"))
    (if (== info invalid-type)
      (return false)
    )
    (let mark (. scratch types mark))
    (call (. scratch types push) (. types string-type))
    (= (. runtime info-for)
      (call (. calls demand-runtime-call)
        (block
          (arg module-id)
          (arg no-type)
          (arg (call (. program store-atom) "style-info-for"))
          (arg mark)
        )
      )
    )
    (call (. scratch types push) (. types string-type))
    (call (. scratch types push) (. types size-type))
    (= (. runtime info) (call (. calls demand-constructor) info mark))
    (call (. scratch types rewind) mark)
    (call (. scratch types push) info)
    (call (. scratch types push) (. types size-type))
    (call (. scratch types push) (. types string-type))
    (call (. scratch types push) (call (. types type-row) .int64))
    (call (. scratch types push) (. types bool-type))
    (call (. scratch types push) (call (. types type-row) .uint32))
    (call (. scratch types push) (call (. types type-row) .uint32))
    (call (. scratch types push) (call (. types type-row) .uint32))
    (call (. scratch types push) (call (. types type-row) .uint32))
    (call (. scratch types push) (call (. types type-row) .uint64))
    (= (. runtime register-property)
      (call (. calls demand-runtime-call)
        (block
          (arg module-id)
          (arg no-type)
          (arg (call (. program store-atom) "style-register-property"))
          (arg mark)
        )
      )
    )
    (call (. scratch types rewind) mark)
    (call (. scratch types push) info)
    (call (. scratch types push) (call (. types type-row) .int64))
    (= (. runtime register)
      (call (. calls demand-runtime-call)
        (block
          (arg module-id)
          (arg no-type)
          (arg (call (. program store-atom) "style-register"))
          (arg mark)
        )
      )
    )
    (call (. scratch types rewind) mark)
    (call (. scratch types push) (. types string-type))
    (call (. scratch types push) (. types size-type))
    (= (. runtime register-domain)
      (call (. calls demand-runtime-call)
        (block
          (arg module-id)
          (arg no-type)
          (arg (call (. program store-atom) "style-register-domain"))
          (arg mark)
        )
      )
    )
    (call (. scratch types rewind) mark)
    (= (. runtime intern-holder) (. facts style-runtime intern-holder))
    (= (. facts style-runtime) runtime)
    (return (and (!= (. runtime info-for) no-instance) (!= (. runtime info) no-instance) (!= (. runtime register-property) no-instance) (!= (. runtime register) no-instance) (!= (. runtime register-domain) no-instance)))
  )
  (fn-do + check-style-rule _
    (param index DeclId)
    (param rule StyleRuleDecl)
    ; A class's style rules are told apart by name and by the type of what each takes: `• This`,
    ; the defaults rule, takes nothing, and no rule repeats one the class wrote before it. A style
    ; sheet has no defaults rule.
    (match? ([] (. tree nodes) (. rule syntax))
      (case (call .node-rule-syntax row)
        (if (and (== (. rule name text) "This") (!= (. row args count) 0))
          (call (. frame diagnose)
            (block
              (arg (. rule syntax))
              (arg .stated)
              (arg (call (. program store-atom) "Style rule \"This\" must be parameterless"))
            )
          )
          (return)
        )
        (let decls (. ([] (. program modules) module) decls))
        (for (in earlier (..< 0 index))
          (match? ([] decls earlier)
            (case (call .decl-style-rule other)
              (if (and (== (. other outer) 0) namesake (call repeats-rule (. other syntax) (. row args)))
                (call (. frame diagnose)
                  (block
                    (arg (. rule syntax))
                    (arg .stated)
                    (arg (call (. program store-atom) "Redefinition of style rule"))
                  )
                )
                (return)
              )
              (lazy namesake (and (== (. other owner) (. rule owner)) (== (. other name) (. rule name))))
            )
          )
        )
        (if (and (== (. rule name text) "This") (!= (. rule owner) 0) (call is-sheet-decl module (. rule owner)))
          (call (. frame diagnose)
            (block
              (arg (. rule syntax))
              (arg .stated)
              (arg (call (. program store-atom) "StyleSheets may not declare a \"This\" defaults rule"))
            )
          )
        )
      )
    )
  )
  (fn-do + is-sheet-decl Bool
    (param owner-module ModuleId)
    (param decl DeclId)
    ; Whether a class a module declares is a style sheet, declared `• Name`, or the declaration is
    ; an extension of one, `• extend Name`, whose members the sheet has.
    (let owner ([] (. program modules) owner-module))
    (match? ([] (. owner decls) decl)
      (case (call .decl-class class)
        (match? ([] (. owner tree nodes) (. class syntax))
          (case (call .node-class-block row)
            (return (. row is-style-sheet))
          )
        )
      )
      (case .decl-sheet-extension
        (return true)
      )
    )
    (return false)
  )
  (fn-expr + is-sheet-type Bool
    (param type TypeId)
    (case? (or (== type no-type) (== type invalid-type) (!= (call (. types intrinsic-of) type) .style-sheet))
      false
    )
    (default
      (call is-sheet-decl (. ref module) (. ref decl))
    )
    (where
      (lazy ref (call class-ref types type))
    )
  )
  (fn-do _ list-derived-sheets _
    (return-if (if (. facts derived-listed)))
    (= (. facts derived-listed) true)
    (for (in position (..< 0 (. program declare-order length)))
      (let home (as ([] (. program declare-order) position) ModuleId))
      (let owner ([] (. program modules) home))
      (for (in index (..< 0 (. owner decls length)))
        (if (and (is ([] (. owner decls) index) .decl-class) (call is-sheet-decl home (as index DeclId)))
          (let mark (. scratch types mark))
          (let sheet (call (. types intern-class) home (as index DeclId) mark))
          (call (. types complete) sheet)
          (if (call is-sheet-type (?? (call (. types base-of) sheet) no-type))
            (+= (. facts derived-sheets) sheet)
          )
        )
      )
    )
  )
  (fn-do + check-derived-sheet _
    (param index DeclId)
    (param class ClassDecl)
    (let mark (. scratch types mark))
    (let sheet (call (. types intern-class) module index mark))
    (call (. types complete) sheet)
    (let base (?? (call (. types base-of) sheet) no-type))
    (let tags
      (match ([] (. tree nodes) (. class syntax))
        (case (call .node-class-block row)
          (. row tags)
        )
        (default
          (call (of RowRange Atom))
        )
      )
    )
    (if (not (call is-sheet-type base))
      (if (or (== base invalid-type) (== base no-type))
        (match? ([] (. tree nodes) (. class base))
          (case (call .node-type-identifier ident)
            (call (. frame diagnose)
              (block
                (arg (. class base))
                (arg .stated)
                (arg (call (. program store-atom) (str "StyleSheet base \"" (. ident name text) "\" not found")))
              )
            )
          )
        )
        (else-if (!= base (call (. types type-row) .style-sheet))
          (call (. frame diagnose)
            (block
              (arg (. class base))
              (arg .stated)
              (arg
                (call (. program store-atom)
                  (block
                    (arg (str "StyleSheet base \"" (call type-short-name types base) "\" is not a StyleSheet"))
                  )
                )
              )
            )
          )
        )
        (else-if (!= (. tags count) 0)
          (call (. frame diagnose)
            (block
              (arg (. class syntax))
              (arg .stated)
              (arg
                (call (. program store-atom)
                  (block
                    (arg
                      (paragraph
                        (str "StyleSheet \"" (. class name text) "\" takes tags only where it derives from another StyleSheet")
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
      (return)
    )
    (for (in offset (..< 0 (. tags count)))
      (let tag ([] (. tree atoms) (+ (. tags start) offset)))
      (for (in earlier (..< 0 offset))
        (if (== ([] (. tree atoms) (+ (. tags start) earlier)) tag)
          (call (. frame diagnose)
            (block
              (arg (. class syntax))
              (arg .stated)
              (arg (call (. program store-atom) (str "StyleSheet tag \"" (. tag text) "\" is repeated")))
            )
          )
          (return)
        )
      )
    )
    (let owner ([] (. program modules) module))
    (for (in member ([] (. owner member-pool) (. class members)))
      (match? ([] (. owner decls) member)
        (case (call .decl-property property)
          (let named (. property name))
          (if named
            (let found (call property-named base named))
            (if (or (not found) (not (call is-sheet-type (. ([] (. types properties) found) owner))))
              (call (. frame diagnose) (. property syntax) .stated (call (. program store-atom) (str "Derived StyleSheet \"" (. class name text) "\" can only override slots of " (call type-short-name types base) ", which has no slot \"" (. named text) "\"")))
            )
          )
        )
      )
    )
  )
  (fn-do + sheet-parts (list DeclRef)
    (param ref DeclRef)
    ; The declarations whose members a class has: a class's own, then each facet bound to it in the
    ; order of its facets; those of a style sheet are the sheet's, then each extension of it the
    ; program declares (`• extend Name`), as the reference declares them into the sheet: in the order
    ; the modules are declared and, in one, in the order written.
    (let parts (list DeclRef))
    (+= parts ref)
    (if (not (call is-sheet-decl (. ref module) (. ref decl)))
      (let facets (. program facets))
      (return-if parts (if (== (. facets count) 0)))
      (let (tuple start end) (call (. facets class-range) (. ref module) (. ref decl)))
      (for (in position (..< start end))
        (let facet ([] (. facets class-facets) position))
        (if (== ([] (. facets states) facet) .facet-bound)
          (+= parts (call DeclRef ([] (. facets modules) facet) ([] (. facets decls) facet)))
        )
      )
      (return parts)
    )
    (let key (/or/ (/lshift/ (as (. ref module) Size) 32) (as (. ref decl) Size)))
    (let next (?? ([] (. facts sheet-extension-heads) key) (. U32 max)))
    (while (!= next (. U32 max))
      (let held ([] (. facts sheet-extensions) next))
      (+= parts (call DeclRef (. held module) (. held decl)))
      (= next (. held next))
    )
    (return parts)
  )
  (fn-do + list-sheet-extensions _
    ; Lists, once, each extension of a style sheet the program declares, with the sheet it extends,
    ; in the order the modules are declared, each sheet's in a chain of their own. One whose target
    ; is no style sheet extends nothing.
    (return-if (if (. facts extensions-listed)))
    (= (. facts extensions-listed) true)
    (let tails (call (of Map Size U32) (. facts arena)))
    (for (in position (..< 0 (. program declare-order length)))
      (let home (as ([] (. program declare-order) position) ModuleId))
      (let owner ([] (. program modules) home))
      (for (in index (..< 0 (. owner decls length)))
        (match? ([] (. owner decls) index)
          (case (call .decl-sheet-extension row)
            (call (. types clear-fault))
            (let target (call (. types evaluate-type) home (. owner tree) (. row receiver) (call (. types env-frame))))
            (call (. types clear-fault))
            (if (and typed (or (== (call (. types intrinsic-of) target) .class) style-sheet))
              (let sheet (call class-ref types target))
              (if (and (is ([] (. ([] (. program modules) (. sheet module)) decls) (. sheet decl)) .decl-class) sheet-decl)
                (let key (/or/ (/lshift/ (as (. sheet module) Size) 32) (as (. sheet decl) Size)))
                (let place (as (. facts sheet-extensions length) U32))
                (+= (. facts sheet-extensions)
                  (call SheetExtension
                    (block
                      (arg home)
                      (arg (as index DeclId))
                      (arg (. sheet module))
                      (arg (. sheet decl))
                    )
                  )
                )
                (let last (?? ([] tails key) (. U32 max)))
                (if (== last (. U32 max))
                  (= ([] (. facts sheet-extension-heads) key) place)
                  (else
                    (= (. ([] (. facts sheet-extensions) last) next) place)
                  )
                )
                (= ([] tails key) place)
              )
              (lazy sheet-decl (call is-sheet-decl (. sheet module) (. sheet decl)))
            )
            (lazy typed (and (!= target invalid-type) (!= target no-type)))
            (lazy style-sheet (== (call (. types intrinsic-of) target) .style-sheet))
          )
        )
      )
    )
  )
  (fn-do + extended-sheet (? DeclRef)
    (param ref DeclRef)
    ; The style sheet an extension of one extends, or none for any other declaration.
    (if (not (is ([] (. ([] (. program modules) (. ref module)) decls) (. ref decl)) .decl-sheet-extension))
      (return null)
    )
    (for (in held (. facts sheet-extensions))
      (if (and (== (. held module) (. ref module)) (== (. held decl) (. ref decl)))
        (return (call DeclRef (. held sheet-module) (. held sheet)))
      )
    )
    (return null)
  )
  (fn-do + check-sheet-extension _
    (param index DeclId)
    (param extension SheetExtensionDecl)
    ; An extension of a style sheet, `• extend Name`, as the reference's `ASTStyleSheetExtension`
    ; declares one: its target must be a style sheet, and each rule it adds may repeat none the
    ; sheet has (`repeats-part`); it holds usings and rules alone, a slot being an error. The first
    ; that is wrong is the reference's error. The usings and rules it adds are the sheet's
    ; (`sheet-parts`).
    (let id (. extension syntax))
    (let row
      (match? ([] (. tree nodes) id)
        (case (call .node-style-sheet-extension written)
          written
        )
      )
    )
    (if (not row)
      (return)
    )
    (let name
      (match? ([] (. tree nodes) (. row receiver))
        (case (call .node-type-identifier ident)
          (. ident name)
        )
      )
    )
    (if (not name)
      (return)
    )
    (call (. types clear-fault))
    (let target (call (. types evaluate-type) module tree (. row receiver) (. frame env)))
    (call (. types clear-fault))
    (if (or (== target invalid-type) (== target no-type))
      (call (. frame diagnose)
        (block
          (arg id)
          (arg .stated)
          (arg (call (. program store-atom) (str "StyleSheet extension target \"" (. name text) "\" not found")))
        )
      )
      (return)
    )
    (if (and (!= (call (. types intrinsic-of) target) .class) (!= (call (. types intrinsic-of) target) .style-sheet))
      (call (. frame diagnose)
        (block
          (arg id)
          (arg .stated)
          (arg (call (. program store-atom) (str "StyleSheet extension target \"" (. name text) "\" is not a StyleSheet")))
        )
      )
      (return)
    )
    (let ref (call class-ref types target))
    (if (not (call is-sheet-decl (. ref module) (. ref decl)))
      (call (. frame diagnose)
        (block
          (arg id)
          (arg .stated)
          (arg (call (. program store-atom) (str "StyleSheet extension target \"" (. name text) "\" is not a StyleSheet")))
        )
      )
      (return)
    )
    (for (in member ([] (. tree children) (. row body)))
      (match ([] (. tree nodes) member)
        (case .node-property-syntax
          (call (. frame diagnose)
            (block
              (arg member)
              (arg .stated)
              (arg (call (. program store-atom) "StyleSheet extensions may not declare slots"))
            )
          )
          (return)
        )
        (case (call .node-rule-syntax rule)
          (if (== (. rule name text) "This")
            (call (. frame diagnose)
              (block
                (arg member)
                (arg .stated)
                (arg (call (. program store-atom) "StyleSheets may not declare a \"This\" defaults rule"))
              )
            )
            (return)
          )
          (let (tuple repeats known) (call repeats-part ref (call DeclRef module index) rule))
          (if (not known)
            (call decline member)
            (return)
          )
          (if repeats
            (call (. frame diagnose) member .stated (call (. program store-atom) "Redefinition of style rule"))
            (return)
          )
        )
        (case .node-using-declaration
          (continue)
        )
        (default
          (call (. frame diagnose)
            (block
              (arg member)
              (arg .stated)
              (arg
                (call (. program store-atom)
                  (block
                    (arg "StyleSheet extensions may only declare using declarations and style rules")
                  )
                )
              )
            )
          )
          (return)
        )
      )
    )
  )
  (fn-do _ repeats-part (tuple Bool Bool)
    (param sheet DeclRef)
    (param extension DeclRef)
    (param rule ASTRule)
    ; Whether a style rule an extension of a style sheet adds repeats one the sheet has before it, its
    ; own or one an extension declared earlier adds (`sheet-parts`), as the reference finds a rule it
    ; declares into the sheet again: of the same name, taking what it takes (`same-signature`); and
    ; whether that is known.
    (for (in part (call sheet-parts sheet))
      (if (and (== (. part module) (. extension module)) (== (. part decl) (. extension decl)))
        (return (tuple false true))
      )
      (let owner ([] (. program modules) (. part module)))
      (for (in member ([] (. owner member-pool) (call part-members part)))
        (match? ([] (. owner decls) member)
          (case (call .decl-style-rule other)
            (if (== (. other name) (. rule name))
              (match? ([] (. owner tree nodes) (. other syntax))
                (case (call .node-rule-syntax written)
                  (let (tuple same known)
                    (call same-signature
                      (block
                        (arg (. owner tree))
                        (arg (. written args))
                        (arg tree)
                        (arg (. rule args))
                      )
                    )
                  )
                  (if (or (not known) same)
                    (return (tuple same known))
                  )
                )
              )
            )
          )
        )
      )
    )
    (return (tuple false true))
  )
  (fn-do _ repeats-rule Bool
    (param earlier SyntaxId)
    (param args (of RowRange SyntaxId))
    ; Whether an earlier rule of the same name takes what `args` takes, as `same-signature` tells.
    ; One whose types are written in a way not named here is declined.
    (match? ([] (. tree nodes) earlier)
      (case (call .node-rule-syntax row)
        (let (tuple same known) (call same-signature tree (. row args) tree args))
        (if (not known)
          (call decline earlier)
          (return false)
        )
        (return same)
      )
    )
    (return false)
  )
  (fn-do _ same-signature (tuple Bool Bool)
    (param left-tree AST)
    (param left (of RowRange SyntaxId))
    (param right-tree AST)
    (param right (of RowRange SyntaxId))
    ; Whether two style rules take the same values, as the reference's `hasSameSignature` tells rules
    ; of one name apart: as many, each of a type written with the same name (`written-type-name`),
    ; the first that differs telling them apart; and whether that is known, false where a type it
    ; reaches is written in a way not named here.
    (if (!= (. left count) (. right count))
      (return (tuple false true))
    )
    (for (in offset (..< 0 (. left count)))
      (let mine
        (call written-type-name
          (block
            (arg left-tree)
            (arg (call (. left-tree rule-argument-type) ([] (. left-tree children) (+ (. left start) offset))))
          )
        )
      )
      (let theirs
        (call written-type-name
          (block
            (arg right-tree)
            (arg (call (. right-tree rule-argument-type) ([] (. right-tree children) (+ (. right start) offset))))
          )
        )
      )
      (if (or (not mine) (not theirs))
        (return (tuple false false))
      )
      (if (!= mine theirs)
        (return (tuple false true))
      )
    )
    (return (tuple true true))
  )
  (fn-do _ choose-updater Bool
    (param index U32)
    (param site SyntaxId)
    (param made TypeId)
    ; Gives the application `index` of a rule with a line that sets a property of its class again
    ; as what its value read changes the function that makes that line's live action for an object
    ; of the class `made`, as `owner-action` chooses one for an attribute where the rule is
    ; applied, or marks those actions plain ones, and so for one with `live-values` whose rule sets a
    ; property with a value that reads them. Says whether that has a shape here.
    (let unit (. ([] (. facts style-applications) index) unit))
    (if (and (not (call (. facts updates-live) unit)) (not (and live-given (call (. facts updates-given) unit))))
      (return true)
    )
    (lazy live-given (. ([] (. facts style-applications) index) live-values))
    (let rooted (call owns-batch made))
    (if (and (call owns-plain-actions made) (not rooted))
      (= (. ([] (. facts style-applications) index) plain-updates) true)
      (else
        (let maker (call action-maker site made rooted))
        (if (not maker)
          (return false)
        )
        (= (. ([] (. facts style-applications) index) updater) maker)
        (= (. ([] (. facts style-applications) index) rooted) rooted)
      )
    )
    (call revise-application index)
    (return true)
  )
  (fn-do + root-applications Bool
    (param owner ModuleId)
    (param outlet SyntaxId)
    (param wanted TypeId)
    ; Brings into view, in the function that builds what a line gives a slot, the rules written in
    ; rules that the rules the slot's outlet applies bring, as the reference's
    ; `markupSlotContentNodeWithRuleScopes` binds them: under state cells this function makes before
    ; it builds (at no element, `U32.max - 1`) and binds to what it built, read as of the slot's
    ; type. False where one is declined.
    (let written (. ([] (. program modules) owner) tree))
    (match? ([] (. written nodes) outlet)
      (case (call .node-slot-outlet row)
        (let none (list Atom))
        (let gathered (list ScopeUse))
        (if (not (call gather-scopes wanted none (. row style-rule-applications) (- (. U32 max) 1) wanted gathered written))
          (return false)
        )
        (for (in use gathered)
          (if (!= (. use scope own) .scope-pending)
            (+= rule-scopes use)
          )
        )
        (return true)
      )
    )
    (return false)
  )
  (fn-do + applies-plainly Bool
    (param element SyntaxId)
    ; Whether a markup element other than a root `<This` is written in lines of markup alone, each
    ; an element of the body of the one around it, out to the markup of a class or to the body of
    ; the arm of a markup region the instance builds, where the reference opens no live action as it
    ; makes the element.
    (match? ([] (. tree nodes) element)
      (case (call .node-markup row)
        (if (call (. tree names-this) (. row type-id))
          (return false)
        )
      )
    )
    (let arm (if-expr (== (. frame declaration kind) .branch-arm-decl) (. frame declaration syntax) 0u32))
    (let node element)
    (while true
      (let holder (call (. tree holder-of) node))
      (if (== holder 0)
        (return false)
      )
      (if (== holder arm)
        (return true)
      )
      (match ([] (. tree nodes) holder)
        (case .node-block
          (= node holder)
        )
        (case (call .node-markup row)
          (if (!= node (. row body))
            (return false)
          )
          (= node holder)
        )
        (case .node-content-block
          (return true)
        )
        (default
          (return false)
        )
      )
    )
  )
  (fn-do + names-unmodeled-style Bool
    (param receiver TypeId)
    (param name Atom)
    (param site SyntaxId)
    ; Whether a name no member answers is one the reference reads or writes on an object as a
    ; property of a style its class uses, or as the flag of a domain a `MarkupBatchFlush` reports,
    ; neither of which has a shape here yet.
    (if (call is-batch-flush receiver)
      (let (tuple domain _) (call accessor-domain (. name text)))
      (return (!= (. domain length) 0))
    )
    (if (== (call (. types intrinsic-of) receiver) .interface)
      (return (call uses-styles receiver))
    )
    (if (!= (call (. types intrinsic-of) receiver) .class)
      (return false)
    )
    (let styles (list TypeId))
    (if (not (call add-visible-styles receiver styles site))
      (return true)
    )
    (return (!= (call style-answering styles name) no-type))
  )
  (fn-do _ uses-styles Bool
    (param type TypeId)
    ; Whether the declaration of a type names a style or a style sheet in a using.
    (let ref (call class-ref types type))
    (let owner ([] (. program modules) (. ref module)))
    (match? ([] (. owner decls) (. ref decl))
      (case (call .decl-class declared)
        (for (in member ([] (. owner member-pool) (. declared members)))
          (if (is ([] (. owner decls) member) .decl-using)
            (return true)
          )
        )
      )
    )
    (return false)
  )
)

(fn-expr + accessor-domain (tuple String Bool)
  (param text String)
  ; The domain whose flag a name of a style read names, `is-X-invalid` or `is-X-invalid-below`,
  ; and whether it is the flag below, as the reference's `styleDomainAccessor` matches it: no
  ; domain where the name is neither.
  (case? (not (call (. text starts-with) "is-"))
    (tuple "" false)
  )
  (case? (and (call (. text ends-with) "-invalid-below") (> (. text length) 17))
    (tuple ([] text (..< 3 (- (. text length) 14))) true)
  )
  (case? (and (call (. text ends-with) "-invalid") (> (. text length) 11))
    (tuple ([] text (..< 3 (- (. text length) 8))) false)
  )
  (default
    (tuple "" false)
  )
)

(fn-expr _ slot-number U32
  (param name String)
  ; The number of a slot generated content fills, 0 to 3 for before, after, first-child and
  ; last-child, or `U32.max`.
  (case? (== name "before")
    0
  )
  (case? (== name "after")
    1
  )
  (case? (== name "first-child")
    2
  )
  (case? (== name "last-child")
    3
  )
  (default
    (. U32 max)
  )
)
