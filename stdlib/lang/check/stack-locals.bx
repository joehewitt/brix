(import ./call-paths)
(import ./facts)
(import ./instances)
(import ./session)
(import ./types)
(import /lang/ast/ast-nodes)
(import /lang/ast/decl)
(import /lang/ast/module)
(import /lang/ast/program)

(type + StackLocals
  ; A global that each `do with` binds anew must be bound wherever it is read. A function requires
  ; the ones it reads outside a binding of its own, and the ones the functions it calls require
  ; unless it calls them under a binding. A door that calls the door typed under a fake where its
  ; effect's slot holds one hands on nothing: it reads the slot. A call of an interface member or of a method a class
  ; declares again requires what each function that may answer it requires. A nested function holds
  ; the state of where it is made, so what it requires reaches the function that makes it, unless
  ; a binding is open where it is made, and does not reach its callers. What a module's own
  ; statements still require is never bound, which is reported at a read it reaches, with the chain
  ; from the statements to the read. A function becomes a value of a function type only where it
  ; requires nothing, since what a call through the value requires reaches no caller; a closure
  ; holds the state of where it is made. What each function reads outside its bindings, with or
  ; without a value of its own, is recorded too.
  (blank)
  (prop _ program Program)
  (prop _ instances Instances)
  (prop _ facts Facts)
  (prop _ paths CallPaths)
  (prop _ holders (list InstanceId))
  (prop _ modules (list ModuleId))
  (prop _ decls (list DeclId))
  (prop _ readers (list InstanceId))
  (prop _ read-modules (list ModuleId))
  (prop _ read-decls (list DeclId))
  (prop _ keepers (list InstanceId))
  (prop _ kept-modules (list ModuleId))
  (prop _ kept-decls (list DeclId))
  (prop _ call-heads (list U32))
  (prop _ call-links (list U32))
  (fn-do + This _
    (param session Session)
    (param paths _)
    (lazy program (. session program))
    (lazy instances (. session instances))
    (lazy facts (. session facts))
  )
  (fn-do + check _
    (for (in read (. facts stack-reads))
      (let bound (call binds (. read instance) (. read syntax) (. read module) (. read decl)))
      (if (and (not bound) (not (call has-default (. read instance) (. read module) (. read decl))))
        (call require (. read instance) (. read module) (. read decl))
      )
    )
    (let grew (!= (. holders length) 0))
    (while grew
      (= grew false)
      (for (in call (. facts calls))
        (if (and (!= (. call callee) no-instance) (call requires-any (. call callee)) (call propagates (. call callee)) (not dispatches))
          (= grew (or (call require-from (. call callee) (. call instance) (. call syntax)) grew))
        )
        (lazy dispatches (call (. facts dispatches-to) (. call instance) (. call callee)))
      )
      (for (in slot (. facts witness-slots))
        (if (and (!= (. slot callee) no-instance) (!= (. slot proto) no-instance) (call requires-any (. slot callee)))
          (= grew (or (call require-from (. slot callee) (. slot proto) 0) grew))
        )
      )
      (for (in fact (. facts overrides))
        (if (and (!= (. fact override) no-instance) (call requires-any (. fact override)))
          (= grew (or (call require-from (. fact override) (. fact base) 0) grew))
        )
      )
      (let total (. holders length))
      (for (in position (..< 0 total))
        (let holder ([] holders position))
        (let outer (. ([] (. instances rows) holder) enclosing))
        (if (and (!= outer no-instance) (call is-nested holder))
          (let module ([] modules position))
          (let decl ([] decls position))
          (if (not (call binds outer (call made-at holder) module decl))
            (= grew (or (call require outer module decl) grew))
          )
        )
      )
    )
    (call check-values)
    (call report)
    (call gather-needs)
    (call gather-holds)
  )
  (fn-do _ require-from Bool
    (param callee InstanceId)
    (param caller InstanceId)
    (param syntax SyntaxId)
    (let grew false)
    (let total (. holders length))
    (for (in position (..< 0 total))
      (if (== ([] holders position) callee)
        (let module ([] modules position))
        (let decl ([] decls position))
        (if (or (== syntax 0) (not (call binds caller syntax module decl)))
          (= grew (or (call require caller module decl) grew))
        )
      )
    )
    (return grew)
  )
  (fn-do _ gather-needs _
    ; Records the globals each function reads outside its own bindings of them, itself or through
    ; the functions it calls outside one. Calling a nested function reads nothing: it holds what
    ; it captured. Each function found to read one hands it on to the calls of it once.
    (for (in read (. facts stack-reads))
      (if (not (call binds (. read instance) (. read syntax) (. read module) (. read decl)))
        (call need (. read instance) (. read module) (. read decl))
      )
    )
    (if (!= (. readers length) 0)
      (call index-calls)
    )
    (let next Size 0)
    (while (< next (. readers length))
      (let module ([] read-modules next))
      (let decl ([] read-decls next))
      (let call ([] call-heads ([] readers next)))
      (+= next 1)
      (while (!= call (. U32 max))
        (let fact ([] (. facts calls) call))
        (if (not (call binds (. fact instance) (. fact syntax) module decl))
          (call need (. fact instance) module decl)
        )
        (= call ([] call-links call))
      )
    )
    (for (in position (..< 0 (. readers length)))
      (call (. facts stack-needs append)
        (block
          (arg (call StackNeed ([] readers position) ([] read-modules position) ([] read-decls position)))
        )
      )
    )
  )
  (fn-do _ index-calls _
    ; Chains the calls of each function that hands on what it reads to its callers.
    (for (in instance (..< 0 (. instances length)))
      (+= call-heads (. U32 max))
    )
    (for (in position (..< 0 (. facts calls length)))
      (+= call-links (. U32 max))
      (let callee (. ([] (. facts calls) position) callee))
      (if (and (!= callee no-instance) (call propagates callee))
        (= ([] call-links position) ([] call-heads callee))
        (= ([] call-heads callee) (as position U32))
      )
    )
  )
  (fn-do _ gather-holds _
    ; Records the globals whose state each nested function holds from where it is made: those it
    ; reads outside its own bindings of them, and those each function nested in it holds where no
    ; binding of its own is open where that function is made. A function that is not nested reads
    ; the slot of the task running where it makes one.
    (for (in position (..< 0 (. readers length)))
      (if (call is-nested ([] readers position))
        (call hold ([] readers position) ([] read-modules position) ([] read-decls position))
      )
    )
    (let grew (!= (. keepers length) 0))
    (while grew
      (= grew false)
      (let total (. keepers length))
      (for (in position (..< 0 total))
        (let outer (. ([] (. instances rows) ([] keepers position)) enclosing))
        (if (and (!= outer no-instance) (call is-nested outer))
          (let module ([] kept-modules position))
          (let decl ([] kept-decls position))
          (if (not (call binds outer (call made-at ([] keepers position)) module decl))
            (= grew (or (call hold outer module decl) grew))
          )
        )
      )
    )
    (for (in position (..< 0 (. keepers length)))
      (call (. facts stack-holds append)
        (block
          (arg (call StackHold ([] keepers position) ([] kept-modules position) ([] kept-decls position)))
        )
      )
    )
  )
  (fn-do _ hold Bool
    (param keeper InstanceId)
    (param module ModuleId)
    (param decl DeclId)
    (for (in position (..< 0 (. keepers length)))
      (if (and (== ([] keepers position) keeper) (== ([] kept-modules position) module) same-decl)
        (return false)
      )
      (lazy same-decl (== ([] kept-decls position) decl))
    )
    (+= keepers keeper)
    (+= kept-modules module)
    (+= kept-decls decl)
    (return true)
  )
  (fn-do _ is-nested Bool
    (param instance InstanceId)
    (let row ([] (. instances rows) instance))
    (match? ([] (. ([] (. program modules) (. row module)) decls) (. row decl))
      (case (call .decl-function fn)
        (return (call is-nested-kind (. fn kind)))
      )
    )
    (return false)
  )
  (fn-do _ made-at SyntaxId
    (param instance InstanceId)
    ; Where a nested function is written in the function it is nested in.
    (let row ([] (. instances rows) instance))
    (match? ([] (. ([] (. program modules) (. row module)) decls) (. row decl))
      (case (call .decl-function fn)
        (return (. fn syntax))
      )
    )
    (return 0)
  )
  (fn-do _ need Bool
    (param reader InstanceId)
    (param module ModuleId)
    (param decl DeclId)
    (for (in position (..< 0 (. readers length)))
      (if (and (== ([] readers position) reader) (== ([] read-modules position) module) same-decl)
        (return false)
      )
      (lazy same-decl (== ([] read-decls position) decl))
    )
    (+= readers reader)
    (+= read-modules module)
    (+= read-decls decl)
    (return true)
  )
  (fn-do _ require Bool
    (param holder InstanceId)
    (param module ModuleId)
    (param decl DeclId)
    (for (in position (..< 0 (. holders length)))
      (if (and (== ([] holders position) holder) (== ([] modules position) module) (== ([] decls position) decl))
        (return false)
      )
    )
    (+= holders holder)
    (+= modules module)
    (+= decls decl)
    (return true)
  )
  (fn-do _ requires-any Bool
    (param holder InstanceId)
    (for (in known holders)
      (if (== known holder)
        (return true)
      )
    )
    (return false)
  )
  (fn-do _ binds Bool
    (param instance InstanceId)
    (param syntax SyntaxId)
    (param module ModuleId)
    (param decl DeclId)
    (for (in scope (. facts stack-scopes))
      (if (and (== (. scope instance) instance) (== (. scope module) module) (== (. scope decl) decl))
        (if (and (>= syntax (. scope first)) (<= syntax (. scope last)))
          (return true)
        )
      )
    )
    (return false)
  )
  (fn-do _ has-default Bool
    (param instance InstanceId)
    (param module ModuleId)
    (param decl DeclId)
    ; Whether a read of a global `do with` binds has a value where none is bound: the one written, or
    ; for an effect the real doors, which a door reached where no fake is bound calls.
    (match? ([] (. ([] (. program modules) module) decls) decl)
      (case (call .decl-property row)
        (return (!= (. row value) 0))
      )
      (case .decl-effect
        (let effect (call (. program effects index-of) module decl))
        (return (or (not effect) (== (call (. instances fake-of) (. ([] (. instances rows) instance) effects) effect) no-type)))
      )
    )
    (return false)
  )
  (fn-do _ propagates Bool
    (param callee InstanceId)
    (let row ([] (. instances rows) callee))
    (match? ([] (. ([] (. program modules) (. row module)) decls) (. row decl))
      (case (call .decl-function fn)
        (return (not (call is-nested-kind (. fn kind))))
      )
    )
    (return true)
  )
  (fn-expr _ is-root Bool
    (param holder InstanceId)
    (== (. ([] (. program modules) (. row module)) main-decl) (. row decl))
    (where
      (lazy row ([] (. instances rows) holder))
    )
  )
  (fn-do _ report _
    (for (in position (..< 0 (. holders length)))
      (if (call is-root ([] holders position))
        (call report-unbound ([] holders position) ([] modules position) ([] decls position))
      )
    )
  )
  (fn-do _ report-unbound _
    (param root InstanceId)
    (param module ModuleId)
    (param decl DeclId)
    (let found
      (call (. paths chain-from)
        (block
          (arg root)
          (arg (=> ((: edge CallEdge)) (call carries edge module decl)))
          (arg (=> ((: instance InstanceId)) (!= (call read-in instance module decl) 0)))
        )
      )
    )
    (let reader (if-expr (and found (!= (. found length) 0)) (. ([] found (- (. found length) 1)) callee) root))
    (let read (call read-in reader module decl))
    (let names (list String))
    (+= names (call (. paths name-of) root))
    (if found
      (++= names (call (. paths names) found))
    )
    (let chain (if-expr (> (. names length) 1) (str ": " (call (. " → " join) names)) ""))
    (let message (call (. program store-atom) (str (call subject-of module decl) " is not bound" chain)))
    (if (== read 0)
      (call (. facts record-diagnostic) root module (call site-of module decl) .reached message)
      (return)
    )
    (call (. facts record-diagnostic) root (. ([] (. instances rows) reader) module) read .reached message)
  )
  (fn-do _ check-values _
    ; A function made a value of a function type requires nothing of where it is called, since no
    ; call through the value reaches it: reported where it is made, with the chain to a read.
    (return-if (if (== (. holders length) 0)))
    (blank)
    (for (in fact (. facts conversions))
      (call check-value (. fact instance) (. fact syntax) (. fact runs))
    )
    (for (in fact (. facts conversion-parts))
      (call check-value (. fact instance) (. fact syntax) (. fact runs))
    )
  )
  (fn-do _ check-value _
    (param maker InstanceId)
    (param site SyntaxId)
    (param runs InstanceId)
    (return-if (if (or (== runs no-instance) (== maker no-instance) (== maker (. instances dead)) (call is-nested runs))))
    (blank)
    (for (in position (..< 0 (. holders length)))
      (if (== ([] holders position) runs)
        (let module ([] modules position))
        (let decl ([] decls position))
        (let found
          (call (. paths chain-from)
            (block
              (arg runs)
              (arg (=> ((: edge CallEdge)) (call carries edge module decl)))
              (arg (=> ((: instance InstanceId)) (!= (call read-in instance module decl) 0)))
            )
          )
        )
        (let names (list String))
        (+= names (call (. paths name-of) runs))
        (if found
          (++= names (call (. paths names) found))
        )
        (let text
          (paragraph
            (str (call subject-of module decl) " cannot be read through a function value: " (call (. " → " join) names))
          )
        )
        (call (. facts record-diagnostic)
          (block
            (arg maker)
            (arg (. ([] (. instances rows) maker) module))
            (arg site)
            (arg .reached)
            (arg (call (. program store-atom) text))
          )
        )
      )
    )
  )
  (fn-do _ carries Bool
    (param edge CallEdge)
    (param module ModuleId)
    (param decl DeclId)
    ; Whether a global the function an edge reaches requires reaches the function it leaves.
    (return-if false (if (not (call requires (. edge callee) module decl))))
    (blank)
    (match (. edge kind)
      (case= .edge-call
        (return (and (call propagates (. edge callee)) (not (call binds (. edge caller) (. edge syntax) module decl))))
      )
      (case= .edge-answer
        (return true)
      )
      (case= .edge-made
        (return (not (call binds (. edge caller) (. edge syntax) module decl)))
      )
      (default
        (return false)
      )
    )
    (return false)
  )
  (fn-do _ requires Bool
    (param holder InstanceId)
    (param module ModuleId)
    (param decl DeclId)
    (for (in position (..< 0 (. holders length)))
      (if (and (== ([] holders position) holder) (== ([] modules position) module) (== ([] decls position) decl))
        (return true)
      )
    )
    (return false)
  )
  (fn-do _ read-in SyntaxId
    (param instance InstanceId)
    (param module ModuleId)
    (param decl DeclId)
    ; A read of a global in a function outside a binding of its own, or none.
    (for (in read (. facts stack-reads))
      (if (and (== (. read instance) instance) (== (. read module) module) (== (. read decl) decl))
        (if (not (call binds instance (. read syntax) module decl))
          (return (. read syntax))
        )
      )
    )
    (return 0)
  )
  (fn-do _ subject-of String
    (param module ModuleId)
    (param decl DeclId)
    ; What an error names a global `do with` binds as: a stack-local variable, or the fake bound to
    ; an effect.
    (match? ([] (. ([] (. program modules) module) decls) decl)
      (case (call .decl-effect row)
        (return (str "The fake bound to '" (. row name text) "'"))
      )
    )
    (return (str "Stack-local variable '" (call name-of module decl) "'"))
  )
  (fn-do _ name-of String
    (param module ModuleId)
    (param decl DeclId)
    (match? ([] (. ([] (. program modules) module) decls) decl)
      (case (call .decl-property row)
        (if (. row name)
          (return (. row name text))
        )
      )
    )
    (return "")
  )
  (fn-do _ site-of SyntaxId
    (param module ModuleId)
    (param decl DeclId)
    (match? ([] (. ([] (. program modules) module) decls) decl)
      (case (call .decl-property row)
        (return (. row syntax))
      )
    )
    (return 0)
  )
)
