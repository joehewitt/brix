./type-signature
./type-store
./types
/lang/ast/ast-nodes
/lang/ast/decl
/lang/ast/module
/lang/ast/program
/lang/ast/row-range

━━━━━━━━━━━━━━━━━━━━
+ do declaring-class DeclRef
    - types Types
    - owner TypeId
    - name Atom

` The class among a type and its bases that declares a property of a name, or the type's own
` class where none does.
. current = owner
while current != no-type
    . ref = class-ref(types, current)
    if ref.module == 0 && ref.decl == 0
        = ref
    if owner-property(types.program, ref.module, ref.decl, name) != 0
        = ref
    current = types.base-of(current) ?? no-type
= class-ref(types, owner)

━━━━━━━━━━━━━━━━━━━━
+ do declaring-decl DeclRef
    - types Types
    - fact TypeProperty

` The class or facet that declares a property: the facet a facet's property has, unless a class
` below the facet's own gives it a new value (`is-given-below`), or else the class among a type
` and its bases that declares it.
=? declaring-class(types, fact.owner, fact.name) if fact.facet == U32.max || is-given-below(types, fact)
. facets = types.program.facets
= DeclRef(facets.modules[fact.facet], facets.decls[fact.facet])

━━━━━━━━━━━━━━━━━━━━
+ is-given-below Bool
    - types Types
    - fact TypeProperty

` Whether a class below the class of a facet gives the facet's property a new value: the
` property's owner is then that class, not the facet's.
fact.facet != U32.max && (holder.module != owner-module || holder.decl != owner-decl)

.. holder = class-ref(types, fact.owner)
.. owner-module = types.program.facets.owner-modules[fact.facet]
.. owner-decl = types.program.facets.owner-decls[fact.facet]

━━━━━━━━━━━━━━━━━━━━
+ do declaring-holder DeclRef
    - types Types
    - fact TypeProperty

` The class that holds a property: the class of a facet that declares it, unless a class below
` gives it a new value (`is-given-below`), or else the class that declares it.
=? declaring-class(types, fact.owner, fact.name) if fact.facet == U32.max || is-given-below(types, fact)
. facets = types.program.facets
= DeclRef(facets.owner-modules[fact.facet], facets.owner-decls[fact.facet])

━━━━━━━━━━━━━━━━━━━━
+ do written-tuple DeclRef
    - types Types
    - type TypeId
    - fields TypeId

. current = type
while current != no-type
    . base = types.base-of(current) ?? no-type
    if base == fields
        = class-ref(types, current)
    current = base
= DeclRef(0, 0)

━━━━━━━━━━━━━━━━━━━━
+ do written-field SyntaxId
    - program Program
    - ref DeclRef
    - name Atom

if ref.decl == 0
    = 0
. owner = program.modules[ref.module]
. tree = owner.tree
match? owner.decls[ref.decl]
    | .decl-class(class)
        match? tree.nodes[class.base]
            | .node-type-tuple(row)
                . position = 0
                for field in tree.children[row.field-types]
                    . written = match? tree.nodes[field]
                        | .node-type-capture(capture)
                            match? tree.nodes[capture.id]
                                | .node-identifier(id)
                                    id.name.text
                    if (written ?? "$position") == name.text
                        = field
                    position += 1
= 0

━━━━━━━━━━━━━━━━━━━━
+ do names-element Bool
    - types Types
    - fact TypeProperty

` Whether a property is one the markup written in a class declared for an element of a
` name: it holds nothing until that markup makes the element.
. ref = declaring-decl(types, fact)
. member = owner-property(types.program, ref.module, ref.decl, fact.name)
if member == 0
    = false
match? types.program.modules[ref.module].decls[member]
    | .decl-property(row)
        = row.element != 0
= false

━━━━━━━━━━━━━━━━━━━━
+ do member-site SyntaxId
    - types Types
    - ref DeclRef
    - name Atom

` Where a class declares a property or a getter of a name.
. owner = types.program.modules[ref.module]
match? owner.decls[ref.decl]
    | .decl-class(class)
        for member in owner.members-named(class.members, name)
            match? owner.decls[member]
                | .decl-property(property)
                    if property.name && property.name == name
                        = property.syntax
                | .decl-function(fn)
                    if fn.kind == .getter-decl && fn.name && fn.name == name
                        = fn.syntax
        = class.syntax
= 0

━━━━━━━━━━━━━━━━━━━━
+ do is-hot-field Bool
    - types Types
    - property TypeProperty

` Whether the declaration of a field asks to be packed first among a table row's inline bytes.
. owner = declaring-decl(types, property)
. written = member-site(types, owner, property.name)
. target = types.program.modules[owner.module].tree
match? target.nodes[written]
    | .node-property-syntax(row)
        for annotation in target.atoms[row.annotations]
            if annotation.text == "hot"
                = true
= false

━━━━━━━━━━━━━━━━━━━━
+ do is-common-field Bool
    - types Types
    - union TypeId
    - field TypeProperty

` A field every case of a union row inherits from one declaration with one type is held in a
` column of its own.
if field.storage-kind != .storage-eager
    = false
. declared = declaring-decl(types, field)
for fact in types.cases-of(union)
    if fact.is-default || fact.type == no-type || fact.type == invalid-type
        = false
    . found = types.property-named(fact.type, field.name)
    if !found
        = false
    . other = types.properties[found]
    if other.storage-kind != .storage-eager || other.type != field.type
        = false
    . held = declaring-decl(types, other)
    if held.module != declared.module || held.decl != declared.decl
        = false
= true
