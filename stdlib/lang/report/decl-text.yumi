/lang/ast/ast-nodes
/lang/ast/decl
/lang/ast/module
/lang/ast/row-range

━━━━━━━━━━━━━━━━━━━━
+ shape-text String
    - module Module
    - row FunctionDecl

"${shape-head-text(row)} args=[${shape-args-text(module, row)}]"

━━━━━━━━━━━━━━━━━━━━
+ do shape-head-text String
    - row FunctionDecl

. kind = kind-text(row.kind)
if row.owner == 0 && (row.kind == .getter-decl || row.kind == .setter-decl)
    kind = "fn"
. static = if row.is-static then "yes" else "no"
. effects = effects-text(row.effects)
. variadic = if row.variadic-index == U32.max then "-" else "${row.variadic-index}"
= "kind=$kind static=$static without=$effects variadic=$variadic required=${row.required-count}"

━━━━━━━━━━━━━━━━━━━━
+ shape-args-text String
    - module Module
    - row FunctionDecl

", ".join(shape-arg-text(each) in module.arg-pool[row.args])

━━━━━━━━━━━━━━━━━━━━
+ do shape-arg-text String
    - shape ArgumentShape

. name = "-"
if shape.name
    . atom = shape.name
    name = atom.text
. default = if shape.has-default then "default" else "-"
= "$name:${specificity-text(shape.specificity)}:$default"

━━━━━━━━━━━━━━━━━━━━
+ do extension-members-text String
    - module Module
    - decl DeclId

. items [String]
match? module.decls[decl]
    | .decl-extension(row)
        for member in module.member-pool[row.members]
            match? module.decls[member]
                | .decl-function(fn)
                    . name = "-"
                    if fn.name
                        . atom = fn.name
                        name = atom.text
                    items += match fn.kind
                        |= .constructor-decl
                            "ctor"
                        |= .getter-decl
                            "get:$name"
                        |= .setter-decl
                            "set:$name"
                        ??
                            "fn:$name"
                | .decl-converter
                    items += "to"
                | .decl-fromverter
                    items += "from"
= ",".join(items)

━━━━━━━━━━━━━━━━━━━━
+ kind-text String
    - kind DeclKind

match kind
    |= .getter-decl
        "get"
    |= .setter-decl
        "set"
    |= .constructor-decl
        "ctor"
    |= .default-constructor-decl
        "default"
    |= .cast-constructor-decl
        "cast"
    |= .main-decl
        "main"
    |= .tuple-constructor-decl
        "tuple"
    |= .closure-decl
        "closure"
    |= .task-decl
        "task"
    |= .region-decl
        "region"
    |= .table-size-constructor-decl
        "table-size"
    |= .table-arena-constructor-decl
        "table-arena"
    |= .table-capacity-constructor-decl
        "table-capacity"
    |= .table-filler-constructor-decl
        "table-filler"
    |= .index-span-source-constructor-decl
        "index-span-source"
    |= .index-span-range-constructor-decl
        "index-span-range"
    |= .iterator-decl
        "iterator"
    |= .feed-decl
        "feed"
    |= .pipeline-decl
        "pipeline"
    |= .init-decl
        "init"
    |= .task-main-decl
        "task-main"
    |= .termination-panic-decl
        "termination-panic"
    ??
        "fn"

━━━━━━━━━━━━━━━━━━━━
+ specificity-text String
    - specificity Specificity

match specificity
    |= .convertible
        "convertible"
    |= .similar
        "similar"
    |= .exact
        "exactly"
    ??
        "-"

━━━━━━━━━━━━━━━━━━━━
+ effects-text String
    - effects CompilationEffect

if names then ",".join(names) else "-"

.. names = List'String
    *? "gc" if gc-free
    *? "heap" if !gc-free && has-effect(effects, CompilationEffect.no-heap)
    *? "safepoints" if !gc-free && safepoint-free
    *? "probe-safepoints" if has-effect(effects, CompilationEffect.no-probe-safepoint)
    *? "suspend" if has-effect(effects, CompilationEffect.no-suspend) && !safepoint-free
.. gc-free = has-effect(effects, CompilationEffect.gc-free)
.. safepoint-free = has-effect(effects, CompilationEffect.no-safepoint)

━━━━━━━━━━━━━━━━━━━━
_ has-effect Bool
    - effects CompilationEffect
    - effect CompilationEffect

(effects /and/ effect) != CompilationEffect.none
