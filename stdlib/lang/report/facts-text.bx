(import ./decl-text)
(import ./diagnostic-report)
(import ./excerpt)
(import /lang/ast/ast)
(import /lang/ast/ast-children)
(import /lang/ast/ast-nodes)
(import /lang/ast/decl)
(import /lang/ast/module)
(import /lang/ast/operator)
(import /lang/ast/program)
(import /lang/ast/row-range)
(import /lang/check/binding)
(import /lang/check/facts)
(import /lang/check/instances)
(import /lang/check/session)
(import /lang/check/type-signature)
(import /lang/check/type-store)
(import /lang/check/type-text)
(import /lang/check/types)
(import /os/path)
(import /stream/aggregate)
(import /stream/sort)

(fn-expr + node-location-text String
  (param tree AST)
  (param id SyntaxId)
  (str (. loc begin line) ":" (. loc begin column))
  (where
    (lazy loc ([] (. tree nodes loc) id))
  )
)

(fn-expr + diagnostic-kind-name String
  (param kind TypeDiagnosticKind)
  (match kind
    (case= .function-not-found
      "function-not-found"
    )
    (case= .constructor-not-found
      "constructor-not-found"
    )
    (case= .property-not-found
      "property-not-found"
    )
    (case= .literal-does-not-fit
      "literal-does-not-fit"
    )
    (case= .illegal-cast
      "illegal-cast"
    )
    (case= .return-after-recursion
      "return-after-recursion"
    )
    (case= .illegal-operation
      "illegal-operation"
    )
    (case= .circular-reference
      "circular-reference"
    )
    (case= .ambiguous-constructor
      "ambiguous-constructor"
    )
    (case= .ambiguous-static
      "ambiguous-static"
    )
    (case= .ambiguous-extension
      "ambiguous-extension"
    )
    (case= .extension-conflict
      "extension-conflict"
    )
    (case= .unable-to-unify-returns
      "unable-to-unify-returns"
    )
    (case= .invalid-bang-return
      "invalid-bang-return"
    )
    (case= .error-leaves-function
      "error-leaves-function"
    )
    (case= .error-leaves-generator
      "error-leaves-generator"
    )
    (case= .non-void-return
      "non-void-return"
    )
    (case= .explicit-return-requires-do
      "explicit-return-requires-do"
    )
    (case= .no-possible-matches
      "no-possible-matches"
    )
    (case= .stated
      "stated"
    )
    (case= .stated-unplaced
      "stated-unplaced"
    )
    (case= .unasked-unwrap
      "unasked-unwrap"
    )
    (case= .unasked-text
      "unasked-text"
    )
    (case= .unasked-narrowing
      "unasked-narrowing"
    )
    (case= .unasked-conversion
      "unasked-conversion"
    )
    (case= .restricted
      "restricted"
    )
    (case= .reached
      "reached"
    )
    (default
      "not-supported"
    )
  )
)

(fn-expr + is-unlocated Bool
  (param loc MatchLocation)
  (and (== (. loc begin line) 0) (== (. loc begin column) 0) (== (. loc end line) 0) (== (. loc end column) 0))
)

(fn-expr + is-pattern-answer Bool
  (param tree AST)
  (param syntax SyntaxId)
  ; Whether a node is an equality pattern, whose type is that of the answer of its `==` and
  ; is not one the program wrote.
  (match ([] (. tree nodes) syntax)
    (case .node-type-equality
      true
    )
    (default
      false
    )
  )
)

(fn-expr + is-on-line Bool
  (param tree AST)
  (param syntax SyntaxId)
  (param line U32)
  (or (== line (. U32 max)) (== (. ([] (. tree nodes loc) syntax) begin line) line))
)

(fn-expr + force-text String
  (param types Types)
  (param tree AST)
  (param fact ForceFact)
  (str (. ([] (. tree nodes loc) (. fact syntax)) begin column) "=" operand "->" result suffix)
  (where
    (lazy operand (call type-text types (. fact operand)))
    (lazy result (call type-text types (. fact result)))
    (lazy suffix (if-expr (. fact is-narrowed) ":narrowed" ""))
    (blank)
    (lazy program (. types program))
  )
)

(fn-expr + diagnostic-summary-text String
  (param tree AST)
  (param diagnostic TypeDiagnostic)
  (str (call diagnostic-kind-name (. diagnostic kind)) ":" shown "@" location)
  (where
    (lazy shown (if-expr (. diagnostic name) (. named text) "-"))
    (lazy named (. diagnostic name))
    (lazy location (if-expr (!= (. diagnostic syntax) 0) (call node-location-text tree (. diagnostic syntax)) "-"))
  )
)

(fn-do + loop-locations (map String Bool)
  (param tree AST)
  ; The locations of `for` blocks and loop headers. The TypeScript oracle cannot tell its own
  ; loop desugaring apart from a call or cast the source places there, such as a comprehension
  ; body, so it drops every call and cast at those locations and the Brix side drops the same.
  (let locations (map String Bool))
  (let total (as (. tree nodes length) SyntaxId))
  (for (in id (..< 1 total))
    (match? ([] (. tree nodes) id)
      (case .node-loop-syntax
        (= ([] locations (call node-location-text tree id)) true)
      )
      (case .node-for-block
        (= ([] locations (call node-location-text tree id)) true)
      )
    )
  )
  (return locations)
)

(fn-do + synthesized-locations (map String Bool)
  (param tree AST)
  ; The locations of multi and optional feeds and of map and filter pipelines. The TypeScript
  ; compiler lowers each through nodes it synthesizes at that location, the loop item, the
  ; optional's capture, and the closure's argument, whose types have no source node on either
  ; side, so both oracles drop the type lines there.
  (let locations (map String Bool))
  (let total (as (. tree nodes length) SyntaxId))
  (for (in id (..< 1 total))
    (match? ([] (. tree nodes) id)
      (case (call .node-feed-expression row)
        (if (or (. row is-spread) (. row is-optional))
          (= ([] locations (call node-location-text tree id)) true)
        )
      )
      (case (call .node-pipeline-expression row)
        (if (call is-pipeline-closure (. row op))
          (= ([] locations (call node-location-text tree id)) true)
        )
      )
    )
  )
  (return locations)
)

(fn-do + is-listed-instance Bool
  (param program Program)
  (param row Instance)
  (let listed (not (call (. ([] (. program modules) (. row module)) name ends-with) ".h")))
  (match? ([] (. ([] (. program modules) (. row module)) decls) (. row decl))
    (case (call .decl-function fn)
      (= listed (and listed (!= (. fn kind) .main-decl) (!= (. fn kind) .task-decl)))
      (= listed (and listed (not (call is-startup-kind (. fn kind))) (!= (. fn kind) .termination-panic-decl)))
    )
  )
  (return listed)
)

(fn-expr _ instance-self TypeId
  (param program Program)
  (param row Instance)
  (match ([] (. ([] (. program modules) (. row module)) decls) (. row decl))
    (case (call .decl-function fn)
      (if-expr (. fn is-static) no-type (. row self-type))
    )
    (case .decl-fromverter
      no-type
    )
    (default
      (. row self-type)
    )
  )
)

(fn-do _ instance-head String
  (param types Types)
  (param module ModuleId)
  (param decl DeclId)
  (let program (. types program))
  (let owner-module ([] (. program modules) module))
  (match? ([] (. owner-module decls) decl)
    (case (call .decl-function row)
      (if (or (== (. row kind) .closure-decl) (== (. row kind) .feed-decl))
        (let loc ([] (. owner-module tree nodes loc) (. row syntax)))
        (return (str "closure " (. owner-module name) ":" (. loc begin line) ":" (. loc begin column)))
      )
      (if (or (== (. row kind) .iterator-decl) (== (. row kind) .pipeline-decl))
        (let loc ([] (. owner-module tree nodes loc) (. row syntax)))
        (let line (- (as (. loc begin line) I64) 1))
        (return (str "closure " (. owner-module name) ":" line ":" (. loc begin column)))
      )
    )
  )
  (return (call decl-head types module decl))
)

(fn-expr + is-traced-form Bool
  (param form CallForm)
  (and named (call is-written-form form))
  (where
    (lazy named (and not-accessor (!= form .call-closure) (!= form .call-converter)))
    (lazy not-accessor (and (!= form .call-getter) (!= form .call-setter) (!= form .call-store-setter)))
  )
)

(fn-expr + is-written-form Bool
  (param form CallForm)
  ; Whether a call of a form is one the source writes. The calls a list written makes are not,
  ; nor is the store through an inner index, nor the construction of an enum for a number
  ; converted to it, nor a task spawned.
  (and unprobed (!= form .call-probe) (!= form .call-probe-head) (!= form .call-probe-metric))
  (where
    (lazy made (or (== form .call-list-make) (== form .call-list-reserve) (== form .call-list-data) appends))
    (lazy appends (== form .call-list-append))
    (lazy unprobed (and direct (!= form .call-view-range) (!= form .call-replaced)))
    (lazy direct (and (not made) (!= form .call-store-through) (!= form .call-enum-default) (not (call spawns-task form))))
  )
)

(fn-expr + is-traced-call Bool
  (param fact CallFact)
  (param instance InstanceId)
  (and own (!= (. fact form) .call-converter) (call is-written-form (. fact form)))
  (where
    (lazy own (and (== (. fact instance) instance) (!= (. fact callee) no-instance)))
  )
)

(fn-expr _ pair-relation Relation
  (param fact PairFact)
  relation
  (where
    (lazy relation
      (call Relation
        (block
          (arg (. fact kind))
          (arg (. fact rank))
          (arg (. fact match))
          (arg (. fact from))
          (arg (. fact to))
          (arg (. fact unified))
          (arg (. U32 max))
          (arg no-type)
          (arg (. fact ratio))
          (arg .reason-none)
          (arg (. U32 max))
          (arg 0)
        )
      )
    )
  )
)

(fn-expr + relation-text _
  (param types Types)
  (param relation Relation)
  (paragraph
    (str name " rank=" (. relation rank) " match=" match " unified=" unified ratio)
  )
  (where
    (lazy program (. types program))
    (lazy unified (if-expr (!= (. relation kind) .relation-illegal) (call type-key types (. relation unified)) "-"))
    (lazy name (call relation-name (. relation kind)))
    (lazy match U32 (. relation match))
    (lazy ratio (if-expr equal (str " ratio=" (call ratio-text (. relation ratio))) ""))
    (lazy equal (or (== (. relation kind) .relation-equal) (== (. relation kind) .relation-common-equality)))
  )
)

(fn-do + traced-self TypeId
  (param types Types)
  (param module ModuleId)
  (param decl DeclId)
  (param self-type TypeId)
  (let program (. types program))
  (let owner-module ([] (. program modules) module))
  (match? ([] (. owner-module decls) decl)
    (case (call .decl-function row)
      (if (. row is-static)
        (return no-type)
      )
      (if (and (call is-constructor-kind (. row kind)) (!= (. row owner) 0))
        (match? ([] (. owner-module decls) (. row owner))
          (case (call .decl-class class)
            (if (!= (. class type-args count) 0)
              (let env (call (. types class-env) module (. row owner)))
              (let pattern (. env this-type))
              (call (. types env-release) env)
              (return pattern)
            )
          )
        )
      )
    )
  )
  (return self-type)
)

(fn-expr + shown-params U32
  (param types Types)
  (param module ModuleId)
  (param decl DeclId)
  (param param-count U32)
  (if-expr (<= implicit param-count) (- param-count implicit) 0u32)
  (where
    (lazy implicit (call implicit-argument-count types module decl))
    (blank)
    (lazy program (. types program))
  )
)

(fn-do + decl-head String
  (param types Types)
  (param module ModuleId)
  (param decl DeclId)
  (let program (. types program))
  (let owner-module ([] (. program modules) module))
  (let module-name (. owner-module name))
  (match? ([] (. owner-module decls) decl)
    (case (call .decl-function row)
      (let kind (call head-kind row))
      (let owner (call owner-label types module (. row owner)))
      (let name (call function-name row))
      (if (call (. module-name ends-with) ".h")
        (return (str "? " module-name ":-:" name))
      )
      (if (. row is-generated)
        (return (str "gen " module-name ":" owner ":" (call generated-kind (. row kind))))
      )
      (let ordinal 0)
      (let index 0u32)
      (for (in other (. owner-module decls))
        (if (== index decl)
          (break)
        )
        (match? other
          (case (call .decl-function earlier)
            (let plain (and (not (. earlier is-generated)) (not (call is-nested-kind (. earlier kind)))))
            (if (and plain (== (. earlier owner) (. row owner)) (== (call head-kind earlier) kind))
              (if (== (call function-name earlier) name)
                (+= ordinal 1)
              )
            )
          )
        )
        (+= index 1)
      )
      (return (str kind " " module-name ":" owner ":" name "#" ordinal))
    )
    (case (call .decl-converter row)
      (let owner (call owner-label types module (. row owner)))
      (let ordinal (call accessor-ordinal program module decl (. row owner) true))
      (return (str "to " module-name ":" owner "#" ordinal))
    )
    (case (call .decl-fromverter row)
      (let owner (call owner-label types module (. row owner)))
      (let ordinal (call accessor-ordinal program module decl (. row owner) false))
      (return (str "from " module-name ":" owner "#" ordinal))
    )
  )
  (return "?")
)

(fn-do _ accessor-ordinal Size
  (param program Program)
  (param module ModuleId)
  (param decl DeclId)
  (param owner DeclId)
  (param converters Bool)
  (let ordinal Size 0)
  (let index 0u32)
  (for (in other (. ([] (. program modules) module) decls))
    (if (== index decl)
      (break)
    )
    (match? other
      (case (call .decl-converter row)
        (if (and converters (== (. row owner) owner))
          (+= ordinal 1)
        )
      )
      (case (call .decl-fromverter row)
        (if (and (not converters) (== (. row owner) owner))
          (+= ordinal 1)
        )
      )
    )
    (+= index 1)
  )
  (return ordinal)
)

(fn-expr _ generated-kind String
  (param kind DeclKind)
  (match kind
    (case= .tuple-constructor-decl
      "tuple"
    )
    (case= .cast-constructor-decl
      "cast"
    )
    (case= .index-span-source-constructor-decl
      "cast"
    )
    (case= .table-size-constructor-decl
      "size"
    )
    (case= .table-arena-constructor-decl
      "arena"
    )
    (case= .table-capacity-constructor-decl
      "arena-capacity"
    )
    (case= .table-filler-constructor-decl
      "filler"
    )
    (default
      "default"
    )
  )
)

(fn-expr _ head-kind String
  (param row FunctionDecl)
  (match (. row kind)
    (case= .getter-decl
      (if-expr (!= (. row owner) 0) "get" "fn")
    )
    (case= .setter-decl
      (if-expr (!= (. row owner) 0) "set" "fn")
    )
    (default
      "fn"
    )
  )
)

(fn-expr _ function-name String
  (param row FunctionDecl)
  (case? (not (. row name))
    "?"
  )
  (case? (call (. atom text starts-with) "(closure")
    "()"
  )
  (default
    (call (. "" join) (call (. atom text split) " "))
  )
  (where
    (lazy atom (. row name))
  )
)

(fn-do _ owner-label String
  (param types Types)
  (param module ModuleId)
  (param owner DeclId)
  (let program (. types program))
  (if (== owner 0)
    (return "-")
  )
  (match? ([] (. ([] (. program modules) module) decls) owner)
    (case (call .decl-class row)
      (return (. row name text))
    )
    (case .decl-extension
      (let env (call extension-env types module owner))
      (let label (str "ext:" (call type-key types (. env this-type))))
      (call (. types env-release) env)
      (return label)
    )
    (case .decl-sheet-extension
      (return "sheet-ext")
    )
  )
  (return "?")
)

(fn-do + binding-diagnostic-lines _
  (param bindings Bindings)
  (param program Program)
  (param module ModuleId)
  (param label String)
  (param lines (list String))
  (let owner ([] (. program modules) module))
  (let tree (. owner tree))
  (let reported (list DeclId))
  (for (in diagnostic (. bindings diagnostics))
    (if (or (!= (. diagnostic module) module) (== (. diagnostic kind) .redeclared))
      (continue)
    )
    (let holder (call enclosing-function owner (. diagnostic syntax)))
    (if (and (!= holder 0) (!= (call (. reported find) holder) null))
      (continue)
    )
    (+= reported holder)
    (let message (call binding-diagnostic-message diagnostic))
    (+= lines (str "diag " label " " (call node-extent-text tree (. diagnostic syntax)) " " message))
  )
)

(fn-do + enclosing-function DeclId
  (param owner Module)
  (param syntax SyntaxId)
  (let found 0u32)
  (let narrowest (. U32 max))
  (let index 0u32)
  (for (in decl (. owner decls))
    (match? decl
      (case (call .decl-function row)
        (let start (. row subtree start))
        (let inside (and (>= syntax start) (< syntax (+ start (. row subtree count)))))
        (if (and inside (< (. row subtree count) narrowest))
          (= found index)
          (= narrowest (. row subtree count))
        )
      )
    )
    (+= index 1)
  )
  (return found)
)

(fn-expr + binding-diagnostic-message String
  (param diagnostic Diagnostic)
  ; A stated diagnostic's name is its whole message.
  (match (. diagnostic kind)
    (case= .stated
      (if-expr (. diagnostic name) (. diagnostic name text) "")
    )
    (case= .already-defined
      "Redefining variable in same scope"
    )
    (case= .redeclared
      "Redefining variable in same scope"
    )
    (case= .lazy-defined
      "Variable is already defined"
    )
    (case= .required-self
      "Required self not defined"
    )
    (case= .variable-not-declared
      "Variable not declared"
    )
    (case= .stream-not-found
      "Pattern has nothing to match"
    )
    (default
      "Name not found"
    )
  )
)

(fn-do + node-extent-text String
  (param tree AST)
  (param id SyntaxId)
  (if (== id 0)
    (return "-")
  )
  (let loc ([] (. tree nodes loc) id))
  (let width 1)
  (if (> (. loc end line) (. loc begin line))
    (let length (call line-length (. tree source) (. loc begin line)))
    (= width (if-expr (> length (. loc begin column)) (- length (. loc begin column) 1) 0))
    (else-if (>= (+ (. loc end column) 1) (. loc begin column))
      (= width (- (+ (. loc end column) 1) (. loc begin column)))
    )
  )
  (return (str (. loc begin line) ":" (. loc begin column) "+" width))
)

(fn-do + line-length Size
  (param source String)
  (param line U32)
  (let current 0u32)
  (let length 0)
  (for (in char source)
    (if (== char (char "\n"))
      (if (== current line)
        (return length)
      )
      (+= current 1)
      (= length 0)
      (else-if (== current line)
        (+= length 1)
      )
    )
  )
  (return length)
)

(fn-do + diagnostic-message String
  (param types Types)
  (param diagnostic TypeDiagnostic)
  (let program (. types program))
  (let shown "")
  (if (. diagnostic name)
    (let atom (. diagnostic name))
    (= shown (. atom text))
  )
  (let source (. diagnostic from))
  (let target (. diagnostic to))
  (let raised (call type-short-name types source))
  (return
    (match (. diagnostic kind)
      (case= .function-not-found
        "Function not found"
      )
      (case= .constructor-not-found
        "Constructor not found"
      )
      (case= .property-not-found
        "Property not found"
      )
      (case= .literal-does-not-fit
        (str "Integer literal " shown " does not fit " (call type-short-name types target))
      )
      (case= .illegal-cast
        (scope (str "Illegal cast from " shown-source " to " shown-target)
          (lazy shown-source (call type-display types source))
          (lazy shown-target (call type-display types target))
        )
      )
      (case= .unasked-unwrap
        (call unwritten-message types source target)
      )
      (case= .unasked-text
        (call unwritten-message types source target)
      )
      (case= .unasked-narrowing
        (call unwritten-message types source target)
      )
      (case= .unasked-conversion
        (call unwritten-message types source target)
      )
      (case= .return-after-recursion
        "Can't infer return type after recursion"
      )
      (case= .illegal-operation
        "Illegal types for operation"
      )
      (case= .circular-reference
        "Circular reference"
      )
      (case= .ambiguous-constructor
        "Ambiguous constructor"
      )
      (case= .ambiguous-static
        "Ambiguous static method"
      )
      (case= .ambiguous-extension
        "Ambiguous extension member"
      )
      (case= .extension-conflict
        "Extension member conflicts with existing member"
      )
      (case= .unable-to-unify-returns
        "Unable to unify return types"
      )
      (case= .invalid-bang-return
        (scope (str raised " cannot be returned with ?!; " advice)
          (lazy advice "return an Error subtype or use ?! Panic(...) to end the task.")
        )
      )
      (case= .error-leaves-function
        (str raised " can leave function " shown "; declare it with ?! " raised ", or catch it here")
      )
      (case= .error-leaves-generator
        (str raised " can leave generator " shown ", which does not declare it; declare it with ?! " raised ", or catch it here")
      )
      (case= .error-not-carried
        (scope (str raised " can leave this function, and " carrier "; " advice)
          (lazy carrier (if-expr (call is-c-function types target) "a C function cannot carry it" (str named " does not carry it")))
          (lazy named (call type-short-name types target))
          (lazy advice (if-expr (call is-c-function types target) "catch it here" (str "add ?! " raised " to " named ", or catch it here")))
        )
      )
      (case= .non-void-return
        "Non-do function must return a non-void value"
      )
      (case= .explicit-return-requires-do
        "Explicit return requires do"
      )
      (case= .no-possible-matches
        "Pattern has no possible matches"
      )
      (case= .stated
        shown
      )
      (case= .stated-unplaced
        shown
      )
      (case= .restricted
        shown
      )
      (case= .reached
        shown
      )
      (default
        "Not supported"
      )
    )
  )
)

(fn-expr _ unwritten-message String
  (param types Types)
  (param source TypeId)
  (param target TypeId)
  (str "Unwritten conversion from " (call type-display types source) " to " (call type-display types target))
)

(fn-do + diagnostic-text String
  (param program Program)
  (param module ModuleId)
  (param syntax SyntaxId)
  (param message String)
  (param inset U32 (= 0))
  (param span U32 (= 0))
  (param sources (? ExcerptSources) (= null))
  (let owner ([] (. program modules) module))
  (let path (call display-path (. owner path)))
  (if (== syntax 0)
    (return (str "Exception: " message "\n<" path ">"))
  )
  (let loc ([] (. owner tree nodes loc) syntax))
  (let own (use (call ExcerptSources program)))
  (return (str "Exception: " message "\n<" path ":" (+ (. loc begin line) 1) ">\n" (call (. (?? sources own) excerpt) module loc inset span)))
)

(fn-do + related-text String
  (param program Program)
  (param module ModuleId)
  (param syntax SyntaxId)
  (param label String)
  (param sources (? ExcerptSources) (= null))
  ; A second place a diagnostic points at: its label, where it is, and the line there.
  (let owner ([] (. program modules) module))
  (let loc ([] (. owner tree nodes loc) syntax))
  (let own (use (call ExcerptSources program)))
  (return (str label ":\n<" (call display-path (. owner path)) ":" (+ (. loc begin line) 1) ">\n" (call (. (?? sources own) line) module loc)))
)

(fn-expr + display-path String
  (param path String)
  (if-expr (!= (. path length) 0) path "no file")
)

(fn-do + keyed-text String
  (param owner Module)
  (param syntax SyntaxId)
  (param text String)
  (let line 0u32)
  (if (!= syntax 0)
    (= line (. ([] (. owner tree nodes loc) syntax) begin line))
  )
  (let digits (str line))
  (return (++ (* "0" (- 6 (. digits length))) digits ":" text))
)

(type + FactsText
  (prop + session Session)
  (prop + types Types)
  (prop + program Program)
  (prop + bindings Bindings)
  (prop + instances Instances)
  (prop + facts Facts)
  (prop + report DiagnosticReport)
  (fn-do + This _
    (param session Session)
    (param search-paths (list Path) (= (list)))
    (lazy types (. session types))
    (lazy program (. session program))
    (lazy bindings (. session bindings))
    (lazy instances (. session instances))
    (lazy facts (. session facts))
    (lazy report (call DiagnosticReport session search-paths))
  )
  (fn-do + node-type-lines _
    (param instance InstanceId)
    (param label String)
    (param lines (list String))
    (param dropped (map String Bool))
    (let row ([] (. instances rows) instance))
    (if (== (. row node-start) (. U32 max))
      (return)
    )
    (let tree (. ([] (. program modules) (. row module)) tree))
    (for (in offset (..< 0 (. row subtree count)))
      (let type ([] (. facts node-types) (+ (. row node-start) offset)))
      (if (!= type no-type)
        (let id (+ (. row subtree start) offset))
        (if (or (call is-unlocated ([] (. tree nodes loc) id)) (call is-pattern-answer tree id))
          (continue)
        )
        (let location (call node-location-text tree id))
        (if (== ([] dropped location) true)
          (continue)
        )
        (+= lines (str "type " label " " location " " (call type-key types type)))
      )
    )
    (for (in fact (. facts unwrapped))
      (if (and (== (. fact instance) instance) (not (call is-unlocated ([] (. tree nodes loc) (. fact syntax)))))
        (let location (call node-location-text tree (. fact syntax)))
        (if (!= ([] dropped location) true)
          (+= lines (str "type " label " " location " " (call type-key types (. fact type))))
        )
      )
    )
  )
  (fn-do + conversion-lines _
    (param instance InstanceId)
    (param label String)
    (param lines (list String))
    (param dropped (map String Bool))
    (let row ([] (. instances rows) instance))
    (let tree (. ([] (. program modules) (. row module)) tree))
    (for (in id (call (. facts instance-conversions) instance))
      (let fact ([] (. facts conversions) id))
      (let unwritten
        (scope (or implied (== (. fact reason) .reason-pattern))
          (lazy implied (or (== (. fact reason) .reason-promotion) (== (. fact reason) .reason-relation)))
        )
      )
      (let silent (or (== (. fact reason) .reason-literal-return) (== (. fact reason) .reason-step)))
      (if (and (!= (. fact kind) .relation-same) (not unwritten) (not silent))
        (let location (call node-location-text tree (. fact syntax)))
        (if (== ([] dropped location) true)
          (continue)
        )
        (let source (call type-key types (. fact from)))
        (let target (call type-key types (call asked-type fact)))
        (+= lines (str "cast " label " " location " " source " -> " target " " (call relation-name (. fact kind))))
      )
    )
  )
  (fn-do + override-lines _
    (param instance InstanceId)
    (param label String)
    (param lines (list String))
    ; The methods and converters that subclasses declare in place of an instance, and the
    ; properties they store in place of it, in the order of their text.
    (let found (list String))
    (for (in fact (. facts overrides))
      (if (and (== (. fact base) instance) (== (. fact override) no-instance))
        (+= found (str "override " label " " (call type-key types (. fact receiver)) " property " (. ([] (. types properties) (. fact property)) name text)))
        (else-if (== (. fact base) instance)
          (+= found (str "override " label " " (call type-key types (. fact receiver)) " " (call call-text (. fact override))))
        )
      )
    )
    (let ordered (list String) (call sort found))
    (++= lines ordered)
  )
  (fn-do + types-on-line String
    (param instance InstanceId)
    (param line U32)
    (let row ([] (. instances rows) instance))
    (if (== (. row node-start) (. U32 max))
      (return "")
    )
    (let tree (. ([] (. program modules) (. row module)) tree))
    (let columns (list U32))
    (let shown (list String))
    (for (in offset (..< 0 (. row subtree count)))
      (let type ([] (. facts node-types) (+ (. row node-start) offset)))
      (if (== type no-type)
        (continue)
      )
      (let loc ([] (. tree nodes loc) (+ (. row subtree start) offset)))
      (if (or (!= (. loc begin line) line) (call is-unlocated loc) pattern-answer)
        (continue)
      )
      (lazy pattern-answer (call is-pattern-answer tree (+ (. row subtree start) offset)))
      (let entry (str (. loc begin column) "=" (call type-text types type)))
      (let position (. columns length))
      (while (and (!= position 0) (> ([] columns (- position 1)) (. loc begin column)))
        (-= position 1)
      )
      (if (and (!= position 0) (== ([] columns (- position 1)) (. loc begin column)) (== ([] shown (- position 1)) entry))
        (continue)
      )
      (call (. columns insert) (. loc begin column) position)
      (call (. shown insert) entry position)
    )
    (return (call (. ";" join) shown))
  )
  (fn-do + local-types String
    (param instance InstanceId)
    ; The locals an instance keeps a type for, as `name=type` in slot order.
    (let row ([] (. instances rows) instance))
    (if (== (. row binding) no-binding)
      (return "")
    )
    (let slots (. ([] (. bindings bindings) (. row binding)) slots))
    (let shown (list String))
    (for (in offset (..< 0 (. slots count)))
      (let type (call (. facts slot-type) instance offset))
      (let slot ([] (. bindings slots) (+ (. slots start) offset)))
      (if (and (!= type no-type) (!= (. slot kind) .slot-loop-state))
        (+= shown (str (. slot name text) "=" (call type-text types type)))
      )
    )
    (return (call (. ";" join) shown))
  )
  (fn-expr + fill-summary String
    (param instance InstanceId)
    ; The properties a constructor fills, as `property<-kind` in the order it fills them, where the
    ; kind says whether an argument or a lazy local gives the value.
    (call (. ";" join) shown)
    (where
      (lazy shown
        (case-each (in fact (. facts fills) (when (== (. fact instance) instance)))
          (str (. fact name text) "<-" (if-expr (== (. ([] (. bindings slots) (. fact slot)) kind) .slot-lazy) "lazy" "argument"))
        )
      )
    )
  )
  (fn-expr + conversion-summary String
    (param instance InstanceId)
    (param line U32 (= (. U32 max)))
    (call (. " " join) (in (call conversion-text tree each) shown))
    (where
      (lazy row ([] (. instances rows) instance))
      (lazy tree (. ([] (. program modules) (. row module)) tree))
      (lazy recorded (in ([] (. facts conversions) each) (call (. facts instance-conversions) instance)))
      (lazy shown (in each recorded (when (and (!= (. each kind) .relation-same) (call is-on-line tree (. each syntax) line)))))
    )
  )
  (fn-expr _ asked-type TypeId
    (param fact ConversionFact)
    ; The type a conversion was asked for: the one it gives, unless that was chosen from
    ; several alternatives.
    (if-expr (== (. fact asked) no-type) (. fact to) (. fact asked))
  )
  (fn-expr + conversion-text String
    (param tree AST)
    (param fact ConversionFact)
    (str location ":" source "->" target ":" (call relation-name (. fact kind)) suffix)
    (where
      (lazy location (call node-location-text tree (. fact syntax)))
      (lazy source (call type-text types (. fact from)))
      (lazy target (call type-text types (call asked-type fact)))
      (lazy suffix (if-expr (!= (. fact callee) no-instance) (str "=" callee-head) ""))
      (lazy callee-head (call decl-head types (. callee module) (. callee decl)))
      (lazy callee ([] (. instances rows) (. fact callee)))
    )
  )
  (fn-expr + force-summary String
    (param instance InstanceId)
    (param line U32)
    (call (. " " join) (in (call force-text types tree each) shown))
    (where
      (lazy row ([] (. instances rows) instance))
      (lazy tree (. ([] (. program modules) (. row module)) tree))
      (lazy recorded (in ([] (. facts forces) each) (call (. facts instance-forces) instance)))
      (lazy shown (in each recorded (when (== (. ([] (. tree nodes loc) (. each syntax)) begin line) line))))
    )
  )
  (fn-expr + diagnostic-summary String
    (param module ModuleId)
    (call (. " " join) (in (call diagnostic-summary-text tree each) (. facts diagnostics) (when (and (== (. each module) module) (!= (. each kind) .not-supported)))))
    (where
      (lazy tree (. ([] (. program modules) module) tree))
    )
  )
  (fn-expr + unsupported-summary String
    (param module ModuleId)
    (call (. " " join) (in (call node-location-text tree (. each syntax)) (. facts diagnostics) (when (and (== (. each module) module) (== (. each kind) .not-supported)))))
    (where
      (lazy tree (. ([] (. program modules) module) tree))
    )
  )
  (fn-expr + return-summary String
    (param instance InstanceId)
    (str shown raised " " state)
    (where
      (lazy signature ([] (. instances signatures) instance))
      (lazy state
        (match (. signature return-state)
          (case= .return-declared
            "declared"
          )
          (case= .return-inferred
            "inferred"
          )
          (case= .return-failed
            "failed"
          )
          (default
            "pending"
          )
        )
      )
      (lazy shown (if-expr (!= (. signature returns) no-type) (call type-text types (. signature returns)) "-"))
      (lazy errors (in (call type-text types (call (. instances error-type) instance each)) (..< 0 (. signature errors count))))
      (lazy raised (if-expr (!= (. signature errors count) 0) (str " ?! " (call (. " | " join) errors)) ""))
    )
  )
  (fn-do + call-lines _
    (param instance InstanceId)
    (param label String)
    (param lines (list String))
    (param dropped (map String Bool))
    (let row ([] (. instances rows) instance))
    (let tree (. ([] (. program modules) (. row module)) tree))
    (for (in id (call (. facts instance-calls) instance))
      (let fact ([] (. facts calls) id))
      (if (and (call is-traced-form (. fact form)) (not (. fact is-partial)))
        (let location (call node-location-text tree (. fact syntax)))
        (if (== ([] dropped location) true)
          (continue)
        )
        (let raw (and (not (. fact propagates)) (!= (. ([] (. instances signatures) (. fact callee)) errors count) 0)))
        (let bound-self (== (. fact form) .call-this-constructor))
        (let text (call call-text (. fact callee) raw bound-self))
        (+= lines (str "call " label " " location " " text))
      )
    )
  )
  (fn-do + instance-lines _
    (param instance InstanceId)
    (param label String)
    (param lines (list String))
    (let row ([] (. instances rows) instance))
    (if (or (== (. row state) .instance-unstarted) (not (call is-listed-instance program row)))
      (return)
    )
    (+= lines (str "instance " label " " (call instance-text instance)))
  )
  (fn-expr + instance-text String
    (param instance InstanceId)
    (str head " " signature-text " returns=" returns " errors=[" shown-errors "]")
    (where
      (lazy row ([] (. instances rows) instance))
      (lazy signature ([] (. instances signatures) instance))
      (lazy head (call instance-head types (. row module) (. row decl)))
      (lazy shown-self (call instance-self program row))
      (lazy self (if-expr (!= shown-self no-type) (call type-key types shown-self) "-"))
      (lazy shown (call shown-params types (. row module) (. row decl) (. signature param-count)))
      (lazy params (in (call type-key types (call (. instances param-type) instance each)) (..< 0 shown)))
      (lazy args (in (call type-key types (call (. instances argument-type) instance each)) (..< 0 (. signature args count))))
      (lazy mask (call effects-text (as (. row effects) CompilationEffect)))
      (lazy effects (if-expr (== mask "-") "" mask))
      (lazy returns (if-expr (!= (. signature returns) no-type) (call type-key types (. signature returns)) "-"))
      (lazy shown-params-text (call (. ", " join) params))
      (lazy shown-args (call (. ", " join) args))
      (lazy error-keys (call signature-error-keys instance))
      (lazy sorted-errors (list String) (call sort error-keys))
      (lazy shown-errors (call (. ", " join) sorted-errors))
      (lazy signature-text (str "params=[" shown-params-text "] self=" self " args=[" shown-args "] without=[" effects "]"))
    )
  )
  (fn-do + panic-lines _
    (param instance InstanceId)
    (param label String)
    (param lines (list String))
    (let row ([] (. instances rows) instance))
    (if (or (== (. row state) .instance-unstarted) (not (call is-listed-instance program row)))
      (return)
    )
    (let signature ([] (. instances signatures) instance))
    (let head (call instance-head types (. row module) (. row decl)))
    (let shown-self (call instance-self program row))
    (let self (if-expr (!= shown-self no-type) (call type-key types shown-self) "-"))
    (let args (in (call type-key types (call (. instances argument-type) instance each)) (..< 0 (. signature args count))))
    (let shown-args (call (. ", " join) args))
    (let flag (if-expr (. row may-panic) "true" "false"))
    (+= lines (str "panic " label " " head " self=" self " args=[" shown-args "] " flag))
  )
  (fn-expr + signature-error-keys (list String)
    (param instance InstanceId)
    (in (call type-key types (call (. instances error-type) instance each)) (..< 0 (. signature errors count)))
    (where
      (lazy signature ([] (. instances signatures) instance))
    )
  )
  (fn-do + call-text String
    (param callee InstanceId)
    (param raw Bool (= false))
    (param bound-self Bool (= false))
    (let row ([] (. instances rows) callee))
    (let signature ([] (. instances signatures) callee))
    (let head (call decl-head types (. row module) (. row decl)))
    (let traced (call traced-self types (. row module) (. row decl) (. row self-type)))
    (let shown-self (if-expr bound-self (. row self-type) traced))
    (let self (if-expr (!= shown-self no-type) (call type-key types shown-self) "-"))
    (let shown (call shown-params types (. row module) (. row decl) (. signature param-count)))
    (let params (in (call type-key types (call (. instances param-type) callee each)) (..< 0 shown)))
    (let args (in (call type-key types (call (. instances argument-type) callee each)) (..< 0 (. signature args count))))
    (blank)
    (let shown-returns (. signature returns))
    (if (and raw (!= (. signature errors count) 0))
      (let mark (. types scratch types mark))
      (for (in position (..< 0 (. signature errors count)))
        (call (. types scratch types push) ([] (. instances signature-types) (+ (. signature errors start) position)))
      )
      (= shown-returns (call result-type types (. signature returns) mark))
    )
    (let returns (if-expr (!= shown-returns no-type) (call type-key types shown-returns) "-"))
    (return (str head " params=[" (call (. ", " join) params) "] self=" self " args=[" (call (. ", " join) args) "] returns=" returns))
  )
  (fn-expr + calls-on-line String
    (param instance InstanceId)
    (param line U32)
    (call (. " " join) (in (call call-head each) shown))
    (where
      (lazy row ([] (. instances rows) instance))
      (lazy tree (. ([] (. program modules) (. row module)) tree))
      (lazy calls (in ([] (. facts calls) each) (call (. facts instance-calls) instance)))
      (lazy shown (in each calls (when (and (call is-traced-call each instance) (call is-on-line tree (. each syntax) line)))))
    )
  )
  (fn-expr + call-head String
    (param fact CallFact)
    (if-expr (. fact is-partial) (++ head "?") head)
    (where
      (lazy callee ([] (. instances rows) (. fact callee)))
      (lazy head (call decl-head types (. callee module) (. callee decl)))
    )
  )
  (fn-do + pair-lines _
    (param instance InstanceId)
    (param lines (list String))
    (for (in fact (. facts pairs))
      (if (== (. fact instance) instance)
        (let relation (call pair-relation fact))
        (let source (call type-key types (. fact from)))
        (let target (call type-key types (. fact to)))
        (+= lines (str "pair " source " -> " target " = " (call relation-text types relation)))
      )
    )
  )
  (fn-do + diagnostic-lines _
    (param instance InstanceId)
    (param label String)
    (param lines (list String))
    (for (in diagnostic (. facts diagnostics))
      (if (or (!= (. diagnostic instance) instance) (== (. diagnostic kind) .not-supported))
        (continue)
      )
      (let tree (. ([] (. program modules) (. diagnostic module)) tree))
      (let message (call diagnostic-message types diagnostic))
      (+= lines (str "diag " label " " (call node-extent-text tree (. diagnostic syntax)) " " message))
      (return)
    )
  )
  (fn-expr + rendered-diagnostics String
    (param module ModuleId)
    (call (. "\n" join) (call diagnostic-entries module))
  )
  (fn-expr + rendered-declines String
    (param module ModuleId)
    (call (. "\n" join) (call decline-entries module))
  )
  (fn-do + reported-entries (list String)
    (param limit Index)
    (let undeclared (call first-undeclared))
    (return-if (list undeclared) (if undeclared))
    (let entries (list String))
    (for (in module (call report-order))
      (++= entries (call diagnostic-entries module))
    )
    (let decline (call first-decline))
    (return-if (list decline) (if (and (== (. entries length) 0) decline)))
    (return-if entries (if (<= (. entries length) limit)))
    (let hidden (- (. entries length) limit))
    (let shown ([] entries (..< 0 limit)))
    (+= shown (if-expr (== hidden 1) "1 more error is not shown" (str hidden " more errors are not shown")))
    (return shown)
  )
  (fn-expr + first-decline (? String)
    (spread (call report-order))
    (pipe ?*>
      (call first entries
        (block
          (lazy entries (call decline-entries each))
        )
      )
    )
    (pipe |> first)
  )
  (fn-expr + first-undeclared (? String)
    ; The first declaration written that no pass models. What is said of a program past one is
    ; not to be trusted: what the declaration names is found nowhere. A member of a class counts
    ; only where the program is otherwise reported, since one of a class that runs is declined,
    ; and then only where the class is named somewhere, as the reference compiles nothing of a
    ; class nothing names.
    (spread (call report-order))
    (pipe ?*>
      (call first entries
        (block
          (lazy entries (call undeclared-entries each diagnosed))
        )
      )
    )
    (pipe |> first)
    (where
      (lazy diagnosed (call is-diagnosed))
    )
  )
  (fn-do _ is-diagnosed Bool
    ; Whether anything is reported of the program other than what is declined. A local declared
    ; again is the type pass's to report.
    (return-if true (if (call (. bindings reports))))
    (for (in diagnostic (. facts diagnostics))
      (if (!= (. diagnostic kind) .not-supported)
        (return true)
      )
    )
    (return false)
  )
  (fn-expr _ report-order _
    (item (. program entry-module))
    (spread others)
    (where
      (lazy others (in (as each ModuleId) (..< 0 (. program modules length)) (when (!= each (. program entry-module)))))
    )
  )
  (fn-do + diagnostic-entries (list String)
    (param module ModuleId)
    ; The errors reported of a module, by line. One TypeScript states with no place keeps the line
    ; of its node for the order and is shown with none.
    (let owner ([] (. program modules) module))
    (let sources (use (call ExcerptSources program)))
    (let keyed (list String))
    (let reported (list String))
    (for (in diagnostic (. bindings diagnostics))
      (if (or (!= (. diagnostic module) module) (== (. diagnostic kind) .redeclared))
        (continue)
      )
      (let message (call (. report binding-message) diagnostic (call binding-diagnostic-message diagnostic)))
      (let key (str (call enclosing-function owner (. diagnostic syntax)) " " message))
      (if (!= (call (. reported find) key) null)
        (continue)
      )
      (+= reported key)
      (let text (call diagnostic-text program module (. diagnostic syntax) message (:sources sources)))
      (+= keyed (call keyed-text owner (. diagnostic syntax) text))
    )
    (let seen (list InstanceId))
    (let reached (list String))
    (for (in diagnostic (. facts diagnostics))
      (if (or (!= (. diagnostic module) module) (== (. diagnostic kind) .not-supported))
        (continue)
      )
      (if (!= (. diagnostic kind) .reached)
        (if (!= (call (. seen find) (. diagnostic instance)) null)
          (continue)
        )
        (+= seen (. diagnostic instance))
      )
      (let message (call (. report type-message) diagnostic (call diagnostic-message types diagnostic)))
      (let place (if-expr (== (. diagnostic kind) .stated-unplaced) 0u32 (call (. report type-site) diagnostic)))
      (let moved (and (!= (. diagnostic kind) .stated-unplaced) (!= place (. diagnostic syntax))))
      (let text
        (call diagnostic-text
          (block
            (arg program)
            (arg module)
            (arg place)
            (arg message)
            (arg (if-expr moved 0u32 (. diagnostic inset)))
            (arg (if-expr moved 0u32 (. diagnostic width)))
            (arg sources)
          )
        )
      )
      (if (. diagnostic related-label)
        (let label (. diagnostic related-label))
        (let related (. diagnostic related-module))
        (+= text (++ "\n" (call related-text program related (. diagnostic related-syntax) (. (!! label) text) sources)))
      )
      (let entry (call keyed-text owner (if-expr moved place (. diagnostic syntax)) text))
      (if (== (. diagnostic kind) .reached)
        (+= reached entry)
        (else
          (+= keyed entry)
        )
      )
    )
    (return (call ordered-entries (++ (call first-of-each-line keyed) reached)))
  )
  (fn-do _ first-of-each-line (list String)
    (param keyed (list String))
    (let ordered (list String) (call sort keyed))
    (let kept (list String))
    (for (in text ordered)
      (if (or (== (. kept length) 0) (!= ([] ([] kept (- (. kept length) 1)) (..< 0 6)) ([] text (..< 0 6))))
        (+= kept text)
      )
    )
    (return kept)
  )
  (fn-do + decline-entries (list String)
    (param module ModuleId)
    (let owner ([] (. program modules) module))
    (let sources (use (call ExcerptSources program)))
    (let keyed (list String))
    (for (in diagnostic (. facts diagnostics))
      (if (and (== (. diagnostic module) module) (== (. diagnostic kind) .not-supported))
        (let text (call diagnostic-text program module (. diagnostic syntax) (call (. report decline-message) diagnostic) (:sources sources)))
        (+= keyed (call keyed-text owner (. diagnostic syntax) text))
      )
    )
    (return (call ordered-entries keyed))
  )
  (fn-do + undeclared-entries (list String)
    (param module ModuleId)
    (param members Bool (= true))
    ; The declarations of a module no pass models, but one the type pass reports an error within,
    ; which it has judged: a second section of a class, as the reference finds as it declares the
    ; module, or a member of an extension of a style sheet that is wrong, whose check judges the
    ; extension whole.
    (let owner ([] (. program modules) module))
    (let sources (use (call ExcerptSources program)))
    (let keyed (list String))
    (for (in position (..< 0 (. owner undeclared length)))
      (let written ([] (. owner undeclared) position))
      (let holder ([] (. owner undeclared-owners) position))
      (let judged false)
      (match? ([] (. owner decls) holder)
        (case (call .decl-sheet-extension extension)
          (= judged (call reported-within module (. extension syntax)))
        )
      )
      (if (or judged (call reported-within module written))
        (continue)
      )
      (if (or (== holder 0) (and members (call is-named module holder)))
        (let text (call diagnostic-text program module written "Not supported" (:sources sources)))
        (+= keyed (call keyed-text owner written text))
      )
    )
    (return (call ordered-entries keyed))
  )
  (fn-do _ reported-within Bool
    (param module ModuleId)
    (param written SyntaxId)
    ; Whether the type pass reports an error at a declaration or within it.
    (let start (call (. ([] (. program modules) module) tree subtree-start) written))
    (for (in diagnostic (. facts diagnostics))
      (if (and (== (. diagnostic module) module) (!= (. diagnostic kind) .not-supported) within)
        (return true)
      )
      (lazy within (and (>= (. diagnostic syntax) start) (<= (. diagnostic syntax) written)))
    )
    (return false)
  )
  (fn-do _ is-named Bool
    (param module ModuleId)
    (param decl DeclId)
    ; Whether a class is named anywhere in the program, by its name or an alias: in a type, a
    ; markup element, or a name read, its own members included.
    (let owner ([] (. program modules) module))
    (let names (list Atom))
    (match? ([] (. owner decls) decl)
      (case (call .decl-class class)
        (+= names (. class name))
        (for (in alias ([] (. owner tree atoms) (. class aliases)))
          (+= names alias)
        )
      )
    )
    (if (== (. names length) 0)
      (return true)
    )
    (for (in other (. program modules))
      (let tree (. other tree))
      (for (in id (..< 1u32 (. tree nodes length)))
        (match? ([] (. tree nodes) id)
          (case (call .node-type-identifier row)
            (if (!= (call (. names find) (. row name)) null)
              (return true)
            )
          )
          (case (call .node-identifier row)
            (if (!= (call (. names find) (. row name)) null)
              (return true)
            )
          )
        )
      )
    )
    (return false)
  )
  (fn-do _ ordered-entries (list String)
    (param keyed (list String))
    (let ordered (list String) (call sort keyed))
    (let unique (list String))
    (for (in text ordered)
      (if (or (== (. unique length) 0) (!= ([] unique (- (. unique length) 1)) text))
        (+= unique text)
      )
    )
    (return
      (case-each (in text unique)
        ([] text (... 7))
      )
    )
  )
)
