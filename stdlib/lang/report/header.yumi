/lang/ast/ast
/lang/ast/ast-nodes
/lang/ast/decl
/lang/ast/module
/lang/ast/program
/lang/check/facts
/lang/check/instances
/lang/check/session
/lang/check/type-store
/lang/check/type-text
/lang/check/types
/stream/aggregate

━━━━━━━━━━━━━━━━━━━━
+ InferredParam is Tuple

+ position U32
+ syntax SyntaxId
+ type String

━━━━━━━━━━━━━━━━━━━━
+ InferredHeader is Tuple

+ returns String?
+ errors [String]
+ params [InferredParam]
+ differs String?

────────────────────
+ get is-empty Bool

!returns && errors.length == 0 && params.length == 0 && !differs

━━━━━━━━━━━━━━━━━━━━
+ do inferred-header InferredHeader?
    - session Session
    - module ModuleId
    - decl DeclId
    - copies [InstanceId]

=? null if copies.length == 0
do match? session.program.modules[module].decls[decl]
    | .decl-function(fn)
        = HeaderReading(session, module, fn, copies).read()
= null

━━━━━━━━━━━━━━━━━━━━
_ HeaderReading

+ session Session
+ module ModuleId
+ fn FunctionDecl
+ copies [InstanceId]

────────────────────
+ This
    - session
    - module
    - fn
    - copies

────────────────────
+ do read InferredHeader

. chosen = default-copy()
. params [InferredParam]
. shapes = session.program.modules[module].arg-pool
for position in 0 .. < fn.args.count
    . shape = shapes[fn.args.start + position]
    if shape.type-syntax == 0 && shape.default-syntax == 0 && shape.pattern != 0
        . type = agreed(position as U32)
        if type != no-type
            params += InferredParam(position as U32, shape.pattern, type-source(session.types, type))
. infers-return = fn.return-type == 0 && fn.kind != .constructor-decl && fn.kind != .setter-decl
. returns = if infers-return then returned(chosen) else null
. errors [String]
. differs [String]
if fn.errors.count == 0
    . shared = shared-errors(chosen)
    for error in shared
        errors += type-source(session.types, error)
    . extra = extra-errors(shared)
    if extra.length != 0
        differs += "${if varies() then "Some uses" else "Copies made for other callers"} also raise ${" | ".join(extra)}"
if infers-return && !varies() && returns-differ(chosen)
    differs += "Copies made for other callers return other types"
= InferredHeader(returns, errors, params, if differs.length == 0 then null else "; ".join(differs))

────────────────────
_ do default-copy InstanceId

for copy in copies
    =? copy if session.instances.rows[copy].effects == 0
= copies[0]

────────────────────
_ do varies Bool

for position in 0 .. < fn.args.count
    . first = session.instances.argument-type(copies[0], position as U32)
    for copy in copies
        =? true if session.instances.argument-type(copy, position as U32) != first
= false

────────────────────
_ do agreed TypeId
    - position U32

. first = session.instances.argument-type(copies[0], position)
=? no-type if first == invalid-type
for copy in copies
    =? no-type if session.instances.argument-type(copy, position) != first
= first

────────────────────
_ do returned String?
    - chosen InstanceId

. types = session.types
. given = session.instances.signatures[chosen].returns
=? null if given == no-type || given == invalid-type || given == types.void-type
=? type-source(types, given) if !varies()
. same = all(copies) • where session.instances.signatures[each].returns == given
=? type-source(types, given) if same
. tree = session.program.modules[module].tree
for position in 0 .. < fn.type-args.count
    . bound = all(copies) • where session.instances.signatures[each].returns == session.instances.param-type(each, position)
    . name = types.class-param-name(tree, fn.type-args, position)
    =? name.text if bound && name
. owned = types.class-type-args(module, fn.owner)
for position in 0 .. < owned.count
    . bound = all(copies) • where session.instances.signatures[each].returns == class-arg(types, session.instances.rows[each].self-type, position as U32)
    . name = types.class-param-name(tree, owned, position)
    =? name.text if bound && name
= null

────────────────────
_ do returns-differ Bool
    - chosen InstanceId

. given = session.instances.signatures[chosen].returns
= some(copies) • where session.instances.signatures[each].returns != given

────────────────────
_ do errors-of [TypeId]
    - copy InstanceId

. instances = session.instances
. found [TypeId]
if !instances.errors-known(copy)
    = found
for position in 0 .. < instances.signatures[copy].errors.count
    found += instances.error-type(copy, position)
= found

────────────────────
_ do shared-errors [TypeId]
    - chosen InstanceId

. shared [TypeId]
. sets [[TypeId]]
for copy in copies
    sets += errors-of(copy)
for error in errors-of(chosen)
    if !varies() || (all(sets) • where each.find(error) != null)
        shared += error
= shared

────────────────────
_ do extra-errors [String]
    - shared [TypeId]

. seen [TypeId = Bool]
for error in shared
    seen[error] = true
. extra [String]
for copy in copies
    for error in errors-of(copy)
        if seen[error] == null
            seen[error] = true
            extra += type-source(session.types, error)
= extra
