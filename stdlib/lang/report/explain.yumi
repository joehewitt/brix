+ explain-label-width Size = 9

━━━━━━━━━━━━━━━━━━━━
+ ExplainError is Error

────────────────────
+ This
    - message String

━━━━━━━━━━━━━━━━━━━━
+ do explained-function DeclRef ?! ExplainError
    - program Program
    - root ModuleId
    - asked String

. parts [String] = asked.split(":")
. found [DeclRef]
. number = line-number(parts[parts.length - 1]) if parts.length == 2
if number
    . held = module-at(program, parts[0])
    ?! ExplainError("No module of the program is at ${parts[0]}")
        if !held
    . at = function-at-line(program, held, number - 1)
    ?! ExplainError("No function is written at $asked")
        if !at
    = at
if parts.length == 2
    . place = parts[0]
    for position in 0 .. < program.modules.length
        . path = program.modules[position].path
        if path == place || path.ends-with("/$place")
            found ++= named-functions(program, position as ModuleId, parts[1])
    ?! ExplainError("No module at $place declares a function named ${parts[1]}")
        if found.length == 0
else
    for position in 0 .. < program.modules.length
        found ++= named-functions(program, position as ModuleId, asked)
    . local [DeclRef]
    for each in found
        if each.module == root
            local += each
    if local.length != 0
        found = local
    if found.length == 0
        found ++= named-methods(program, root, asked)
    if found.length == 0
        for position in 0 .. < program.modules.length
            found ++= named-methods(program, position as ModuleId, asked)
    ?! ExplainError("No function is named $asked")
        if found.length == 0
=? found[0] if found.length == 1
. places = List'String("  ${declared-at(program, each)}" in found)
?! ExplainError("$asked names ${found.length} functions; ask for one by its file and line:\n${"\n".join(places)}")

━━━━━━━━━━━━━━━━━━━━
+ do function-at-line DeclRef?
    - program Program
    - module ModuleId
    - line U32

. holder = program.modules[module]
. tree = holder.tree
. best DeclRef? = null
. best-line = 0u32
for index in 0 .. < holder.decls.length
    do match? holder.decls[index]
        | .decl-function(fn)
            if is-explained(fn) && !is-unlocated(tree.nodes.loc[fn.syntax])
                . first = tree.nodes.loc[fn.syntax].begin.line
                . last = last-line(tree, fn)
                if first <= line && line <= last && (!best || first >= best-line)
                    best = DeclRef(module, index as DeclId)
                    best-line = first
= best

━━━━━━━━━━━━━━━━━━━━
+ do explain-function String
    - session Session
    - root ModuleId
    - ref DeclRef
    - text String

= ExplainReport(session, root, ref, text).text()

━━━━━━━━━━━━━━━━━━━━
+ ExplainNote is Tuple

+ kind String
+ label String
+ text String

━━━━━━━━━━━━━━━━━━━━
+ do explain-notes [ExplainNote]
    - session Session
    - root ModuleId
    - ref DeclRef
    - copies [InstanceId]

= ExplainReport(session, root, ref, "").notes(copies)

━━━━━━━━━━━━━━━━━━━━
+ do module-at ModuleId?
    - program Program
    - place String

. bare = if place.starts-with("./") then place[2 ...] else place
for position in 0 .. < program.modules.length
    . path = program.modules[position].path
    =? position as ModuleId if path == bare || path.ends-with("/$bare")
= null

━━━━━━━━━━━━━━━━━━━━
_ do line-number U32?
    - text String

=? null if text.length == 0
. value = 0u32
for position in 0 .. < text.length
    . digit = "0123456789".find(text[position .. < position + 1])
    =? null if digit == null
    value = value * 10 + (digit as U32)
=? null if value == 0
= value

━━━━━━━━━━━━━━━━━━━━
_ do named-functions [DeclRef]
    - program Program
    - module ModuleId
    - asked String

. found [DeclRef]
. parts [String] = asked.split(".")
. decls = program.modules[module].decls
if parts.length == 2
    for index in 0 .. < decls.length
        do match? decls[index]
            | .decl-function(fn)
                if is-explained(fn) && fn.owner != 0 && class-named(decls, fn.owner) == parts[0]
                    if function-text(fn) == parts[1] || (fn.kind == .constructor-decl && parts[1] == "This")
                        found += DeclRef(module, index as DeclId)
    = found
for index in 0 .. < decls.length
    do match? decls[index]
        | .decl-function(fn)
            if is-explained(fn) && fn.owner == 0 && function-text(fn) == asked
                found += DeclRef(module, index as DeclId)
= found

━━━━━━━━━━━━━━━━━━━━
_ do named-methods [DeclRef]
    - program Program
    - module ModuleId
    - asked String

. found [DeclRef]
. decls = program.modules[module].decls
for index in 0 .. < decls.length
    do match? decls[index]
        | .decl-function(fn)
            if is-explained(fn) && fn.owner != 0 && function-text(fn) == asked
                found += DeclRef(module, index as DeclId)
= found

━━━━━━━━━━━━━━━━━━━━
_ is-explained Bool
    - fn FunctionDecl

!fn.is-generated && (fn.name != null || fn.kind == .constructor-decl)

━━━━━━━━━━━━━━━━━━━━
_ function-text String
    - fn FunctionDecl

if name then name.text else ""

.. name = fn.name

━━━━━━━━━━━━━━━━━━━━
_ class-named String
    - decls ImmutableTable'Decl
    - owner DeclId

match decls[owner]
    | .decl-class(owned)
        owned.name.text
    ??
        ""

━━━━━━━━━━━━━━━━━━━━
_ do last-line U32
    - tree AST
    - fn FunctionDecl

. last = tree.nodes.loc[fn.syntax].end.line
for offset in 0 .. < fn.subtree.count
    . loc = tree.nodes.loc[fn.subtree.start + offset]
    if !is-unlocated(loc) && loc.end.line > last
        last = loc.end.line
= last

━━━━━━━━━━━━━━━━━━━━
_ do declared-at String
    - program Program
    - ref DeclRef

. holder = program.modules[ref.module]
= "${holder.path}:${holder.tree.nodes.loc[holder.decls.syntax[ref.decl]].begin.line + 1}"

━━━━━━━━━━━━━━━━━━━━
_ ExplainLine is Tuple

+ label String
+ item String
+ path String

━━━━━━━━━━━━━━━━━━━━
_ ExplainReport

+ session Session
+ root ModuleId
+ ref DeclRef
+ source String

_ copies [InstanceId]
_ lines [ExplainLine]

────────────────────
+ This
    - session
    - root
    - ref
    - source

────────────────────
+ do text String

. instances = session.instances
for position in 0 .. < instances.length
    . row = instances.rows[position]
    . id = position as InstanceId
    if row.module == ref.module && row.decl == ref.decl && id != instances.dead && row.probe == 0
        copies += id
. head = header()
=? "$head\n\nThe compiler typed no copy of this function: nothing it typed calls it." if copies.length == 0
. chosen = default-copy()
raises(chosen)
needs(chosen)
holds(chosen)
copied(chosen)
. filled = inferred-header(session, ref.module, ref.decl, copies)
. differs = filled.differs if filled
if differs
    lines += ExplainLine("differs", differs, "")
=? head if lines.length == 0
= "$head\n\n${"\n".join(shown-lines())}"

────────────────────
+ do notes [ExplainNote]
    - found [InstanceId]

. notes [ExplainNote]
copies = found
=? notes if copies.length == 0
. chosen = default-copy()
needs(chosen)
holds(chosen)
copied(chosen)
. filled = inferred-header(session, ref.module, ref.decl, copies)
. differs = filled.differs if filled
if differs
    lines += ExplainLine("differs", differs, "")
for line in lines
    . label = if line.label == "differs" then "differs" else if line.label == "copies" then "copy ${line.item}" else "${line.label} ${line.item}"
    . lead = line.label ++ " " * (explain-label-width - line.label.length)
    . text = if line.path.length == 0 then "$lead${line.item}" else "$lead${line.item}  ${line.path}"
    notes += ExplainNote(line.label, label, text)
= notes

────────────────────
_ do default-copy InstanceId

for copy in copies
    =? copy if session.instances.rows[copy].effects == 0
= copies[0]

────────────────────
_ do header String

. holder = session.program.modules[ref.module]
. fn = function()
. first = holder.tree.nodes.loc[fn.syntax].begin.line as Size
. all [String] = source.split("\n")
=? "" if first >= all.length
. is-brix = holder.path.ends-with(brix-extension)
. last = first
while last + 1 < all.length && is-header-row(all[last + 1], is-brix)
    last += 1
. shown = List'String(all[first .. last])
if is-brix
    shown = yumi-lines(shown)
else
    shown = List'String(trailing-trimmed(each) in shown)
=? "\n".join(shown) if copies.length == 0
. filled = inferred-header(session, ref.module, ref.decl, copies)
=? "\n".join(shown) if !filled
. parts [String]
. returns = filled.returns
if returns
    parts += returns
if filled.errors.length != 0
    parts += "?! ${" | ".join(filled.errors)}"
if parts.length != 0 && shown.length != 0
    shown[0] = "${shown[0]} ${" ".join(parts)}"
for param in filled.params
    . at = holder.tree.nodes.loc[param.syntax].begin.line as Size
    if at >= first && at - first < shown.length
        shown[at - first] = "${shown[at - first]} ${param.type}"
= "\n".join(shown)

────────────────────
_ do yumi-lines [String]
    - written [String]

. converted = catch? brix-yumi-text("${"\n".join(written)}\n)")
=? written if !converted
. found [String]
for line in converted.split("\n")
    if line.trim().length != 0 && !line.starts-with("━")
        found += trailing-trimmed(line)
= found

────────────────────
_ do function FunctionDecl

do match? session.program.modules[ref.module].decls[ref.decl]
    | .decl-function(fn)
        = fn
?! Panic("An explained declaration is a function")

────────────────────
_ do raises
    - chosen InstanceId

. instances = session.instances
=? if !instances.errors-known(chosen)
for position in 0 .. < instances.signatures[chosen].errors.count
    . error = instances.error-type(chosen, position)
    lines += ExplainLine("raises", type-source(session.types, error), raise-path(chosen, error))

────────────────────
_ do raise-path String
    - start InstanceId
    - error TypeId

. facts = session.facts
. parent [InstanceId = InstanceId]
. queue [InstanceId]
queue += start
parent[start] = start
. next Size = 0
while next < queue.length
    . id = queue[next]
    next += 1
    . site = raise-site(id, error)
    if site
        = "${path-to(parent, start, id)}${site}"
    for call in facts.instance-calls(id)
        . fact = facts.calls[call]
        if fact.propagates && fact.callee != no-instance && raises-error(fact.callee, error) && parent[fact.callee] == null
            parent[fact.callee] = id
            queue += fact.callee
    for conversion in facts.instance-conversions(id)
        . fact = facts.conversions[conversion]
        if fact.raise == .raise-leaves && fact.callee != no-instance && raises-error(fact.callee, error) && parent[fact.callee] == null
            parent[fact.callee] = id
            queue += fact.callee
for id in queue
    for call in facts.instance-calls(id)
        . fact = facts.calls[call]
        if fact.propagates && fact.form == .call-closure && fact.callee == no-instance
            = "${path-to(parent, start, id)}a call of a function value, at ${place(id, fact.syntax)}"
= "no raise found"

────────────────────
_ do raise-site String?
    - instance InstanceId
    - error TypeId

. facts = session.facts
for transform in facts.transforms
    if transform.instance == instance && transform.raised == error
        = "at ${place(instance, transform.site)}"
. row = session.instances.rows[instance]
. tree = session.program.modules[row.module].tree
for offset in 0 .. < row.subtree.count
    . syntax = (row.subtree.start + offset) as SyntaxId
    if facts.plan-of(instance, syntax) == .plan-raise
        . exception = raised-expression(tree, syntax)
        if exception != 0 && facts.node-type(instance, exception) == error
            = "at ${place(instance, syntax)}"
= null

────────────────────
_ do raises-error Bool
    - instance InstanceId
    - error TypeId

. instances = session.instances
for position in 0 .. < instances.signatures[instance].errors.count
    =? true if instances.error-type(instance, position) == error
= false

────────────────────
_ do needs
    - chosen InstanceId

for need in session.facts.stack-needs
    if need.instance == chosen
        lines += ExplainLine("needs", global-name(need.module, need.decl), read-path(chosen, need.module, need.decl))

────────────────────
_ do holds
    - chosen InstanceId

for hold in session.facts.stack-holds
    if hold.instance == chosen
        lines += ExplainLine("holds", global-name(hold.module, hold.decl), read-path(chosen, hold.module, hold.decl))

────────────────────
_ do read-path String
    - start InstanceId
    - module ModuleId
    - decl DeclId

. facts = session.facts
. parent [InstanceId = InstanceId]
. queue [InstanceId]
queue += start
parent[start] = start
. next Size = 0
while next < queue.length
    . id = queue[next]
    next += 1
    for read in facts.stack-reads
        if read.instance == id && read.module == module && read.decl == decl
            = "${path-to(parent, start, id)}at ${place(id, read.syntax)}"
    for call in facts.instance-calls(id)
        . callee = facts.calls[call].callee
        if callee != no-instance && needs-global(callee, module, decl) && parent[callee] == null
            parent[callee] = id
            queue += callee
= "no read found"

────────────────────
_ do needs-global Bool
    - instance InstanceId
    - module ModuleId
    - decl DeclId

for need in session.facts.stack-needs
    =? true if need.instance == instance && need.module == module && need.decl == decl
= false

────────────────────
_ do copied
    - chosen InstanceId

. instances = session.instances
. facts = session.facts
for copy in copies
    . effects = instances.rows[copy].effects
    if copy != chosen && effects != 0
        . callers [FactId]
        for position in 0 .. < facts.calls.length
            if facts.calls[position].callee == copy
                callers += position as FactId
        . path = if callers.length == 0 then "made by the compiler" else caller-text(callers)
        lines += ExplainLine("copies", restriction-text(effects), path)

────────────────────
_ do caller-text String
    - callers [FactId]

. fact = session.facts.calls[callers[0]]
. more = if callers.length > 1 then " and ${callers.length - 1} more" else ""
= "for ${callee-name(fact.instance)} at ${place(fact.instance, fact.syntax)}$more"

────────────────────
_ do path-to String
    - parent [InstanceId = InstanceId]
    - start InstanceId
    - end InstanceId

. names [String]
. cursor = end
while cursor != start
    names.insert(callee-name(cursor), 0)
    cursor = parent[cursor] ?? start
=? "" if names.length == 0
= "${" → ".join(names)}, "

────────────────────
_ do callee-name String
    - instance InstanceId

. row = session.instances.rows[instance]
. decls = session.program.modules[row.module].decls
do match? decls[row.decl]
    | .decl-function(fn)
        . owner = class-named(decls, fn.owner)
        =? owner if fn.kind == .constructor-decl && owner.length != 0
        . name = fn.name
        if name
            =? "${owner}.${name.text}" if owner.length != 0
            = name.text
        =? "a function in ${callee-name(row.enclosing)}" if row.enclosing != no-instance
    | .decl-converter(converter)
        = "the converter of ${class-named(decls, converter.owner)}"
    | .decl-fromverter(fromverter)
        = "the fromverter of ${class-named(decls, fromverter.owner)}"
= "a function"

────────────────────
_ do global-name String
    - module ModuleId
    - decl DeclId

do match? session.program.modules[module].decls[decl]
    | .decl-property(property)
        . name = property.name
        =? name.text if name
= "a global"

────────────────────
_ do place String
    - instance InstanceId
    - syntax SyntaxId

. holder = session.program.modules[session.instances.rows[instance].module]
. loc = holder.tree.nodes.loc[syntax]
= "${shown-path(holder.path)}:${loc.begin.line + 1}"

────────────────────
_ do shown-path String
    - path String

. root-path = session.program.modules[root].path
. slash = root-path.find-reverse("/")
. folder = if slash then root-path[0 .. < slash] else ""
=? path[folder.length + 1 ...] if folder.length != 0 && path.starts-with("$folder/")
= Path(path).name

────────────────────
_ do shown-lines [String]

. width Size = 0
for line in lines
    if line.path.length != 0 && line.item.length > width
        width = line.item.length
. shown [String]
. previous = ""
for line in lines
    . label = if line.label == previous then "" else line.label
    previous = line.label
    . lead = label ++ " " * (explain-label-width - label.length)
    if line.path.length == 0
        shown += "$lead${line.item}"
    else
        shown += "$lead${line.item}${" " * (width + 2 - line.item.length)}${line.path}"
= shown

━━━━━━━━━━━━━━━━━━━━
_ raised-expression SyntaxId
    - tree AST
    - syntax SyntaxId

match tree.nodes[syntax]
    | .node-assertion-syntax(row)
        row.exception
    | .node-type-transform(row)
        row.expr
    ??
        0

━━━━━━━━━━━━━━━━━━━━
_ do restriction-text String
    - effects EffectMask

=? "gc-free" if (effects /and/ CompilationEffect.gc-free) != 0
. parts [String]
if (effects /and/ CompilationEffect.no-heap) != 0
    parts += "without heap"
if (effects /and/ CompilationEffect.no-safepoint) != 0
    parts += "without safepoints"
else if (effects /and/ CompilationEffect.no-suspend) != 0
    parts += "without suspending"
if (effects /and/ CompilationEffect.no-probe-safepoint) != 0
    parts += "without probe safepoints"
= ", ".join(parts)

━━━━━━━━━━━━━━━━━━━━
_ is-header-row Bool
    - line String
    - is-brix Bool

if is-brix then line.trim().starts-with("(param ") else is-indented

.. is-indented = line.length != 0 && (line.starts-with(" ") || line.starts-with("\t")) && line.trim().length != 0

━━━━━━━━━━━━━━━━━━━━
_ do trailing-trimmed String
    - line String

. end = line.length
while end > 0 && (line[end - 1 .. < end] == " " || line[end - 1 .. < end] == "\t")
    end -= 1
= line[0 .. < end]
