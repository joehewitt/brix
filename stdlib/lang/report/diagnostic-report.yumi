/lang/ast/ast
/lang/ast/ast-children
/lang/ast/ast-nodes
/lang/ast/decl
/lang/ast/module
/lang/ast/operator
/lang/ast/program
/lang/ast/row-range
/lang/check/binding
/lang/check/facts
/lang/check/instances
/lang/check/numeric
/lang/check/session
/lang/check/type-store
/lang/check/type-text
/lang/check/types
/lang/target
/os/env
/os/file
/os/path
/stream/aggregate
/stream/sort

━━━━━━━━━━━━━━━━━━━━
+ DiagnosticReport

+ types Types
+ program Program
+ facts Facts
+ bindings Bindings
+ instances Instances
+ index DeclarationIndex

────────────────────
+ This
    - session Session
    - roots [Path]

.. types = session.types
.. program = session.program
.. facts = session.facts
.. bindings = session.bindings
.. instances = session.instances
.. index = DeclarationIndex(roots, session.program.target)

────────────────────
+ type-message String
    - diagnostic TypeDiagnostic
    - base String

sourced(diagnostic, message)

.. message = match diagnostic.kind
    |= .function-not-found
        function-message(diagnostic, base)
    |= .constructor-not-found
        constructor-message(diagnostic, base)
    |= .property-not-found
        property-message(diagnostic, base)
    |= .illegal-operation
        operation-message(diagnostic, base)
    |= .stated
        stated-message(diagnostic, base)
    |= .explicit-return-requires-do
        imperative-message(diagnostic, "cannot return with \"$returning\"", base)
    |= .no-possible-matches
        declared-match-message(diagnostic, base)
    |= .illegal-cast
        cast-message(diagnostic, base)
    |= .unasked-unwrap
        unasked-message(diagnostic, base)
    |= .unasked-text
        unasked-message(diagnostic, base)
    |= .unasked-narrowing
        unasked-message(diagnostic, base)
    |= .unasked-conversion
        unasked-message(diagnostic, base)
    |= .ambiguous-extension
        extension-message(diagnostic, base)
    |= .return-after-recursion
        recursion-message(diagnostic, base)
    |= .unable-to-unify-returns
        unify-message(diagnostic, base)
    |= .circular-reference
        circular-message(diagnostic, base)
    |= .error-leaves-function
        leaves-message(diagnostic, base)
    |= .non-void-return
        divider-message(diagnostic, base)
    ??
        base
.. returning = if is-brix-tree(program.modules[diagnostic.module].tree) then "(return …)" else "="

────────────────────
_ do sourced String
    - diagnostic TypeDiagnostic
    - text String

. sources [String = String]
for type in mentioned(diagnostic)
    . source = type-source(types, type)
    for written in [type-key(types, type), type-display(types, type), type-short-name(types, type)]
        if written != source && !sources[written]
            sources[written] = source
. order = sort(sources.keys) • using :: a, b => compare-basic(b.length, a.length)
= reduce(text, order) • using :: done, written => replaced(done, written, sources[written]!)

────────────────────
_ mentioned [TypeId]
    - diagnostic TypeDiagnostic

List
    * diagnostic.from
    * diagnostic.to
    ** facts.diagnostic-mentions[diagnostic.mentions.start .. < diagnostic.mentions.end]
    ?> settled(each)

────────────────────
_ do replaced String
    - text String
    - old String
    - new String

. result = ""
. rest = text
. found = rest.find(old)
while found != null
    result += rest[0 .. < found] ++ new
    rest = rest[found + old.length ...]
    found = rest.find(old)
= result ++ rest

────────────────────
+ type-site SyntaxId
    - diagnostic TypeDiagnostic

if stray != 0 then stray else diagnostic.syntax

.. stray = divided-stray(diagnostic)

────────────────────
+ decline-message String
    - diagnostic TypeDiagnostic

if holder then stray-message(diagnostic.module, holder, diagnostic.syntax) else "Not supported"

.. holder = stray-holder(diagnostic.module, diagnostic.syntax)

────────────────────
+ binding-message String
    - diagnostic Diagnostic
    - base String

match diagnostic.kind
    |? !diagnostic.name
        base
    |= .name-not-found
        name-message(diagnostic.module, diagnostic.syntax, name)
    |= .already-defined
        redefined-message(diagnostic.module, diagnostic.syntax, name)
    |= .variable-not-declared
        undeclared-message(diagnostic.module, diagnostic.syntax, name)
    |= .context-not-found
        context-message(name)
    ??
        base

.. name = diagnostic.name!.text

────────────────────
_ context-message String
    - name String

` The error of `it` or `each` read where nothing gives it a value.
|? name == "it"
    "Name \"it\" not found, as nothing here gives a subject; \"it\" reads what a match arm, a loop or a pipe is given"
??
    "Name \"each\" not found, as nothing here gives an item; \"each\" reads the item of a stage, a loop, a callback or a trigger"

────────────────────
_ stated-message String
    - diagnostic TypeDiagnostic
    - base String

match base
    |= "Type not found"
        type-not-found-message(diagnostic, base)
    |= "Default value required"
        default-message(diagnostic, base)
    |= "Name not found"
        stated-name-message(diagnostic, base)
    |= "Property not found"
        stated-property-message(diagnostic, base)
    |= "Immediate declaration requires do"
        imperative-message(diagnostic, "cannot hold \". name = value\" declarations", base)
    |= "Loop requires do"
        imperative-message(diagnostic, "cannot hold loops", base)
    |= "Yield requires do"
        imperative-message(diagnostic, "cannot yield", base)
    |= "Assignment requires do"
        imperative-message
            - diagnostic
            - "cannot hold assignments"
            - base
            - "put the assignment in a \"do\" block"
    |= "If statement requires do"
        imperative-message
            - diagnostic
            - "cannot hold \"if\" statements"
            - base
            - "write a check as \"?! error if condition\", put other steps in a \"do\" block"
    |= "Call before the value requires do"
        imperative-message
            - diagnostic
            - "cannot run calls before its value"
            - base
            - "put the call in a \"do\" block"
    |= "Lazy before the value requires do"
        imperative-message
            - diagnostic
            - "cannot name lazies before its value"
            - base
            - "move the lazy below the value"
    |= "Redefining variable in same scope"
        stated-redefined-message(diagnostic, base)
    |= "Variable not declared"
        stated-undeclared-message(diagnostic, base)
    |= bare-value-text()
        divider-message(diagnostic, base)
    |= "Attached catch handlers require a Result expression"
        catch-message(diagnostic, base)
    |= "Incompatible types in list"
        list-message(diagnostic, base)
    |= "Match arm gives no value"
        arm-step-message(diagnostic)
    |= "Object is not iterable"
        iteration-message(diagnostic, base)
    |= "Redefinition of property"
        redefinition-message(diagnostic, base)
    |= "Illegal to redefine type of inherited property"
        override-type-message(diagnostic, base)
    |= "Inherited properties must have same assignment type"
        override-storage-message(diagnostic, base)
    |= "Case not found"
        case-message(diagnostic, base)
    |= "Optional chaining receiver is not optional"
        chaining-message(diagnostic, base)
    |= "Optional force operand is not optional"
        force-message(diagnostic, base)
    |= "Can't infer return type after recursion"
        recursion-message(diagnostic, base)
    |= "Type can't be null"
        null-message(diagnostic, base)
    |= "Unrecognized argument"
        argument-message(diagnostic, base)
    |= "Illegal return"
        return-message(diagnostic, base)
    |= "Illegal return from subscriber"
        subscriber-return-message(diagnostic, base)
    ??
        prefixed-message(diagnostic, base)

────────────────────
_ prefixed-message String
    - diagnostic TypeDiagnostic
    - base String

|? base.starts-with("Function ") && base.ends-with(" ends with a value it does not return")
    "$base; return it with \"= value\", or remove it"
|? base.starts-with("Function returns error (")
    raised-message(diagnostic, base)
|? base.starts-with("Non-exhaustive match for ")
    coverage-message(diagnostic, base)
|? base.starts-with("Event endpoints provide ")
    endpoint-message(diagnostic)
|? recursive && base.ends-with(", or catch them here")
    recursive-errors-message(diagnostic, base)
??
    base

.. recursive = base.find(" can leave recursive function ") != null

────────────────────
_ do function-message String
    - diagnostic TypeDiagnostic
    - base String

. tree = program.modules[diagnostic.module].tree
. callable SyntaxId = 0
. operands = RowRange'SyntaxId()
do match? tree.nodes[diagnostic.syntax]
    | .node-call-expression(row)
        callable = row.callable
        operands = call-operands(row)
if callable == 0
    =? base if !diagnostic.name
    = "Function \"${diagnostic.name.text}\" not found"
. given = arguments-text(diagnostic, operands)
. count = positional-count(tree, operands)
do match? tree.nodes[callable]
    | .node-get-expression(row)
        . object = facts.node-type(diagnostic.instance, row.object)
        . inner = if row.is-optional then optional-inner(object) else no-type
        . receiver = if inner != no-type then inner else object
        = "${method-message(diagnostic.module, receiver, row.name, given, diagnostic.members)}$gap"
            .. gap = member-gap(diagnostic.module, receiver, row.name, count, diagnostic.members)
    | .node-c-identifier(row)
        = c-function-message(diagnostic.module, row.name, given)
    | .node-identifier(row)
        . local = local-call-message(diagnostic, callable, row.name)
        =? local if local
        . own = own-receiver(diagnostic, row.name)
        =? "$own-text$own-gap" if own != no-type
        .. own-text = method-message(diagnostic.module, own, row.name, given, diagnostic.members)
        .. own-gap = member-gap(diagnostic.module, own, row.name, count, diagnostic.members)
        = "${free-function-message(diagnostic.module, row.name, given)}$identifier-gap"
            .. identifier-gap = free-gap(diagnostic.module, row.name, count)
    | .node-ref-identifier(row)
        = "${free-function-message(diagnostic.module, row.name, given)}$ref-gap"
            .. ref-gap = free-gap(diagnostic.module, row.name, count)
=? base if !diagnostic.name
= free-function-message(diagnostic.module, diagnostic.name, given)

────────────────────
_ do positional-count Size?
    - tree AST
    - operands RowRange'SyntaxId

. count Size = 0
for offset in 0 .. < operands.count
    do match? tree.nodes[tree.children[operands.start + offset]]
        | .node-argument(row)
            =? null if row.name
    count += 1
= count

────────────────────
_ do free-gap String
    - caller ModuleId
    - name Atom
    - count Size?

for candidate in program.lookup(caller, name)
    . owner = program.modules[candidate.module]
    do match? owner.decls[candidate.decl]
        | .decl-function(fn)
            if fn.owner == 0 && fn.kind == .function-decl
                . gap = left-out(owner, fn, count)
                =? gap if gap.length != 0
= ""

────────────────────
_ do member-gap String
    - caller ModuleId
    - receiver TypeId
    - name Atom
    - count Size?
    - added RowRange'DeclRef

for ref in member-refs(receiver, added)
    . owner = program.modules[ref.module]
    do match? owner.decls[ref.decl]
        | .decl-function(fn)
            if fn.name == name && fn.kind == .function-decl
                . gap = left-out(owner, fn, count)
                =? gap if gap.length != 0
= ""

────────────────────
_ do constructor-gap String
    - caller ModuleId
    - name Atom
    - count Size?

for candidate in program.lookup(caller, name)
    . owner = program.modules[candidate.module]
    do match? owner.decls[candidate.decl]
        | .decl-class(class)
            for offset in 0 .. < class.members.count
                do match? owner.decls[owner.member-pool[class.members.start + offset]]
                    | .decl-function(fn)
                        if fn.kind == .constructor-decl
                            . gap = left-out(owner, fn, count)
                            =? gap if gap.length != 0
= ""

────────────────────
_ left-out String
    - owner Module
    - fn FunctionDecl
    - count Size?

|? !count || count >= fn.args.count
    ""
|? shape.has-default || !is-optional-syntax(owner.tree, shape.type-syntax)
    ""
??
    "; \"$label\" may be null but has no default, so a call must give it: pass null, or declare \"$label $typed = null\""

.. shape = owner.arg-pool[fn.args.start + count]
.. label = if shape.name then shape.name.text else "?"
.. typed = written-type(owner.tree, shape.type-syntax)

────────────────────
_ is-optional-syntax Bool
    - tree AST
    - id SyntaxId

match tree.nodes[id]
    | .node-type-arguments(row)
        row.args.count == 1 && written-name(tree, row.base) == "Optional"
    ??
        false

────────────────────
_ written-type String
    - tree AST
    - id SyntaxId

|? is-optional-syntax(tree, id)
    "${written-type(tree, tree.children[optional-inner-syntax(tree, id)])}?"
|? is-brix-tree(tree)
    spelled-type(tree, id)
|? suffix != ""
    "${written-type(tree, tree.children[optional-inner-syntax(tree, id)])}$suffix"
??
    node-text(tree, id)

.. suffix = type-suffix-text(tree, id)

────────────────────
_ type-suffix-text String
    - tree AST
    - id SyntaxId

` The suffix of a type written `T[]` or `T<>`, whose syntax spans `T` alone.
|? named == "Array"
    "[]"
|? named == "SyncChannel"
    "<>"
??
    ""

.. named = match tree.nodes[id]
    | .node-type-arguments(row)
        if row.args.count == 1 && shorthand then written-name(tree, row.base) else null
            .. shorthand = tree.nodes.loc[row.base].begin == tree.nodes.loc[tree.children[row.args.start]].begin
    ??
        null

────────────────────
_ do spelled-type String
    - tree AST
    - id SyntaxId

do match? tree.nodes[id]
    | .node-type-identifier(row)
        = row.name.text
    | .node-type-arguments(row)
        = written-type(tree, row.base) ++ type-arguments-text(tree, row.args)
    | .node-type-associated(row)
        = "${written-type(tree, row.owner)}.${row.name.text}${type-arguments-text(tree, row.args)}"
    | .node-type-list(row)
        if row.patterns.count == 1
            = "[${written-type(tree, tree.children[row.patterns.start])}]"
    | .node-type-tuple(row)
        = "(${", ".join(written-type(tree, each) in tree.children[row.field-types])})"
    | .node-type-capture(row)
        . name = written-name(tree, row.id) ?? ""
        = if row.type != 0 then "$name ${written-type(tree, row.type)}".trim() else name
= node-text(tree, id)

────────────────────
_ type-arguments-text String
    - tree AST
    - args RowRange'SyntaxId

"".join("'${written-type(tree, each)}" in tree.children[args])

────────────────────
_ is-brix-tree Bool
    - tree AST

tree.source-path.ends-with(brix-extension)

────────────────────
_ optional-inner-syntax Index
    - tree AST
    - id SyntaxId

match tree.nodes[id]
    | .node-type-arguments(row)
        row.args.start
    ??
        0

────────────────────
_ call-operands RowRange'SyntaxId
    - row ASTCallExpression

RowRange'SyntaxId(row.operands.start + row.param-count, row.operands.count - row.param-count)

────────────────────
_ do own-receiver TypeId
    - diagnostic TypeDiagnostic
    - name Atom

` The class whose method a call by a name alone names, where no function by that name is
` visible: that of the method the call is in, or of one it is written in.
=? no-type if visible-signatures(diagnostic.module, name, .function-decl, null).length != 0
. instance = diagnostic.instance
while instance < instances.rows.length
    . own = instances.rows[instance].self-type
    =? own if own != no-type && matching != 0
    .. matching = member-signatures(diagnostic.module, own, name, null, diagnostic.members).length
    instance = instances.rows[instance].enclosing
= no-type

────────────────────
_ free-function-message String
    - caller ModuleId
    - name Atom
    - given String?

|? signatures.length != 0 && every-rule(caller, name)
    "\"${name.text}\" is a rule, which matches a stream; use it in a pattern, as in ~ \\${name.text}"
|? signatures.length != 0
    "No function \"${name.text}\"${accepting(given)}; $declared"
|? hidden.length != 0
    "Function \"${name.text}\" is private, declared with _, so only its own module can call it"
??
    "Function \"${name.text}\" not found${missing-note(caller, name, false, nearby)}"

.. signatures = visible-signatures(caller, name, .function-decl, null)
.. hidden = visible-signatures(caller, name, .function-decl, Access.private-access)
.. declared = "${declared-as(signatures)}${private-note(hidden)}"
.. nearby = visible-name-texts(caller, false)

────────────────────
_ do every-rule Bool
    - caller ModuleId
    - name Atom

` Whether each function by a name the caller sees is a rule, whose first parameter is the
` stream it matches.
. found = false
for candidate in program.lookup(caller, name)
    . owner = program.modules[candidate.module]
    do match? owner.decls[candidate.decl]
        | .decl-function(fn)
            if fn.owner == 0 && fn.kind == .function-decl
                if fn.args.count == 0 || owner.arg-pool[fn.args.start].name?.text != "(stream)"
                    = false
                found = true
= found

────────────────────
_ missing-note String
    - caller ModuleId
    - name Atom
    - wants-type Bool
    - nearby [String]

if elsewhere then "; ${elsewhere}" else suggested(name.text, nearby)

.. elsewhere = absent-hint(caller, name, wants-type) ?? unimported-hint(caller, name, wants-type)

────────────────────
_ do c-function-message String
    - caller ModuleId
    - name Atom
    - given String?

. declared = false
. signatures [String]
for candidate in program.lookup(caller, name)
    . owner = program.modules[candidate.module]
    if owner.name.ends-with(".h")
        declared = true
        do match? owner.decls[candidate.decl]
            | .decl-function(fn)
                . shown = signature(owner, fn) • labeled false
                if signatures.length < 3 && signatures.find(shown) == null
                    signatures += shown
=? "C function \"${name.text}\" is not declared by any header this module imports" if !declared
. message = "No C function \"${name.text}\"${accepting(given)}"
= if signatures.length != 0 then "$message; ${declared-as(signatures)}" else message

────────────────────
_ method-message String
    - caller ModuleId
    - receiver TypeId
    - name Atom
    - given String?
    - added RowRange'DeclRef

|? receiver == no-type || receiver == invalid-type
    "Method \"$method\" not found"
|? inner != no-type && class-declares(inner, name)
    "Method \"$method\" is called on $shown, which may be null; unwrap it first with ! or ?."
|? !is-letter(method[0 .. < 1])
    "Operator \"${operator-name(method)}\" is not defined for $shown"
|? signatures.length != 0
    "No method \"$method\" of $shown${accepting(given)}; $declared"
|? hidden.length != 0
    "Method \"$method\" of $shown is private, declared with _, so only its own module can call it"
|? shared.length != 0
    "Method \"$method\" of $shown is shared, declared with ^, so only its own file family can call it"
|? unseen
    "$shown has no method \"$method\" here; facet $unseen declares it, and only the facets a facet sees are in reach. Write \"sees $unseen\" under the facet that uses it"
|? widening
    "$shown has no method \"$method\"; a facet's value has only its facet's members and those of the facets it is part of. Write \"as $widening\" to reach the rest of $widening"
??
    "$shown has no method \"$method\"${suggested(method, member-names(caller, receiver))}"

.. method = name.text
.. widening = facet-widening(receiver, name)
.. unseen = unseen-facet(caller, name, receiver)
.. shown = type-source(types, receiver)
.. inner = optional-inner(receiver)
.. signatures = member-signatures(caller, receiver, name, null, added)
.. hidden = member-signatures(caller, receiver, name, Access.private-access, added)
.. shared = member-signatures(caller, receiver, name, Access.family-access, added)
.. declared = "${declared-as(signatures)}${private-note(hidden)}${family-note(shared)}"

────────────────────
_ do constructor-message String
    - diagnostic TypeDiagnostic
    - base String

. tree = program.modules[diagnostic.module].tree
. head SyntaxId = 0
. operands = RowRange'SyntaxId()
. called = false
do match? tree.nodes[diagnostic.syntax]
    | .node-call-expression(row)
        head = row.callable
        operands = call-operands(row)
        called = true
    | .node-type-identifier
        head = diagnostic.syntax
        . call = enclosing-call(tree, head)
        do match? tree.nodes[call] if call != 0
            | .node-call-expression(row)
                operands = call-operands(row)
                called = true
. name = written-name(tree, head) if head != 0
if !name
    = base
. atom = program.store-atom(own-class-name(diagnostic, name))
. given = arguments-text(diagnostic, operands) if called
. gap = if called then constructor-gap(diagnostic.module, atom, positional) else ""
    .. positional = positional-count(tree, operands)
= "${named-constructor-message(diagnostic.module, atom, given)}$gap"

────────────────────
_ do own-class-name String
    - diagnostic TypeDiagnostic
    - name String

` The name of the class `This` names where a diagnostic is: that of the method it is in, or of
` one that method is written in. Any other name is itself.
=? name if name != "This"
. instance = diagnostic.instance
while instance < instances.rows.length
    . own = instances.rows[instance].self-type
    do match? types.rows[own] if own != no-type
        | .type-class(row)
            do match? program.modules[row.module].decls[row.decl]
                | .decl-class(class)
                    = class.name.text
    instance = instances.rows[instance].enclosing
= name

────────────────────
_ named-constructor-message String
    - caller ModuleId
    - atom Atom
    - given String?

|? facet
    "$name is a facet of ${facet-owner-name(facet)}, so it has no constructor; a ${facet-owner-name(facet)} is a $name"
|? !visible-type(caller, atom)
    "Type \"$name\" not found${missing-note(caller, atom, true, visible-name-texts(caller, true))}"
|? is-interface(caller, atom)
    "$name is an interface, so it has no constructor; construct a class that is $name"
|? alternatives.length != 0
    "$name stands for any one of ${" and ".join(alternatives)}, so it has no constructor; give it a value of one of them, as in $name(value)"
|? signatures.length != 0
    "$message; its declared constructors are ${" and ".join(signatures)}$kept"
|? hidden.length != 0
    "$message; its constructors are private, declared with _, so only its own module can call them"
|? shared.length != 0
    "$message; its constructors are shared, declared with ^, so only its own file family can call them"
??
    message

.. name = atom.text
.. facet = visible-facet(caller, atom)
.. message = "No constructor of $name${accepting(given)}"
.. alternatives = alternative-names(caller, atom)
.. signatures = constructor-signatures(caller, atom, name, null)
.. hidden = constructor-signatures(caller, atom, name, Access.private-access)
.. shared = constructor-signatures(caller, atom, name, Access.family-access)
.. kept = "${private-note(hidden)}${family-note(shared)}"

────────────────────
_ do enclosing-call SyntaxId
    - tree AST
    - callable SyntaxId

` The call of a callable with all its arguments: the last call node of it, since a call's bullets
` give it a node of its own after the one its parentheses give.
. found SyntaxId = 0
for position in 0 .. < tree.nodes.length
    do match? tree.nodes[position]
        | .node-call-expression(row)
            if row.callable == callable
                found = position as SyntaxId
= found

────────────────────
_ do is-interface Bool
    - caller ModuleId
    - name Atom

for candidate in program.lookup(caller, name)
    if class-intrinsic(candidate.module, candidate.decl) == .interface
        = true
= false

────────────────────
_ do alternative-names [String]
    - caller ModuleId
    - name Atom

` The types a type of alternatives a module names stands for, as its declaration writes them, or
` none for any other type.
. names [String]
for candidate in program.lookup(caller, name)
    . owner = program.modules[candidate.module]
    do match? owner.decls[candidate.decl]
        | .decl-class(class)
            for alternative in owner.tree.children[class.or-bases]
                names += node-text(owner.tree, alternative)
            =? names if names.length != 0
= names

────────────────────
_ do class-intrinsic IntrinsicKind
    - module ModuleId
    - decl DeclId

for position in 0 .. < types.rows.length
    do match? types.rows[position]
        | .type-class(row)
            if row.module == module && row.decl == decl && settled(position as TypeId)
                = types.completion-of(position as TypeId).intrinsic
= .none

────────────────────
_ do constructor-signatures [String]
    - caller ModuleId
    - name Atom
    - shown String
    - kept Access?

. found [String]
for candidate in program.lookup(caller, name)
    . owner = program.modules[candidate.module]
    do match? owner.decls[candidate.decl]
        | .decl-class(class)
            . intrinsic = class-intrinsic(candidate.module, candidate.decl)
            for offset in 0 .. < class.members.count
                . member = owner.member-pool[class.members.start + offset]
                do match? owner.decls[member]
                    | .decl-function(fn)
                        . open = keeps(caller, candidate.module, fn.access, kept)
                        . written = constructor-signature(owner, class, fn, shown, intrinsic)
                        if written && open && found.length < 4 && !(found has written)
                            found += written
= found

────────────────────
_ do constructor-signature String?
    - owner Module
    - class ClassDecl
    - fn FunctionDecl
    - shown String
    - intrinsic IntrinsicKind

if fn.kind == .constructor-decl && fn.args.count != 0
    =? null if owner.arg-pool[fn.args.start].name?.text == "(stream)"
    = signature(owner, fn, shown)
if fn.kind == .constructor-decl
    = "\"$shown()\""
if fn.kind != .tuple-constructor-decl || (intrinsic != .tuple && intrinsic != .struct)
    = null
. fields [String]
for offset in 0 .. < class.members.count
    do match? owner.decls[owner.member-pool[class.members.start + offset]]
        | .decl-property(property)
            . typed = if property.type-syntax != 0 then type-text else ""
                .. type-text = written-type(owner.tree, property.type-syntax)
            . valued = if property.value != 0 then "= $value-text" else ""
                .. value-text = node-text(owner.tree, property.value)
            if property.name
                fields += "${property.name.text} $field-text".trim()
                    .. field-text = if typed.length != 0 then typed else valued
. base = if class.base != 0 then written-type(owner.tree, class.base) else ""
=? "\"$shown$base\"" if fields.length == 0 && base.starts-with("(")
= "\"$shown(${", ".join(fields)})\""

────────────────────
_ do property-message String
    - diagnostic TypeDiagnostic
    - base String

` The receiver is what the diagnostic names, where it names one, or what its node was typed as.
. tree = program.modules[diagnostic.module].tree
do match? tree.nodes[diagnostic.syntax]
    | .node-get-expression(row)
        . typed = facts.node-type(diagnostic.instance, row.object)
        . receiver = if diagnostic.from != no-type then diagnostic.from else typed
        = member-read-message(diagnostic.module, tree, row.object, receiver, row.name)
=? base if !diagnostic.name
= "Property \"${diagnostic.name.text}\" not found"

────────────────────
_ do stated-property-message String
    - diagnostic TypeDiagnostic
    - base String

. tree = program.modules[diagnostic.module].tree
do match? tree.nodes[diagnostic.syntax]
    | .node-get-expression(row)
        . receiver = facts.node-type(diagnostic.instance, row.object)
        = member-read-message(diagnostic.module, tree, row.object, receiver, row.name)
. name = written-name(tree, diagnostic.syntax)
=? base if !name
= "Property \"${name}\" not found"

────────────────────
_ member-read-message String
    - caller ModuleId
    - tree AST
    - object SyntaxId
    - receiver TypeId
    - name Atom

|? interpolated
    interpolated-message(interpolated, property)
|? named && is-type-name(named) && cases.length != 0
    "${named} has no case \"$property\"${suggested(property, cases)}"
|? receiver == no-type || receiver == invalid-type
    "Property \"$property\" not found"
|? inner != no-type && class-declares(inner, name)
    "Property \"$property\" is read from $shown, which may be null; unwrap it first with ! or ?."
|? unseen
    "$shown has no property \"$property\" here; facet $unseen declares it, and only the facets a facet sees are in reach. Write \"sees $unseen\" under the facet that uses it"
|? widening
    "$shown has no property \"$property\"; a facet's value has only its facet's members and those of the facets it is part of. Write \"as $widening\" to reach the rest of $widening"
??
    "$shown has no property \"$property\"${suggested(property, member-names(caller, receiver))}"

.. property = name.text
.. widening = facet-widening(receiver, name)
.. unseen = unseen-facet(caller, name, receiver)
.. interpolated = interpolated-read(tree, object)
.. named = written-name(tree, object)
.. cases = case-names(caller, named)
.. shown = type-source(types, receiver)
.. inner = optional-inner(receiver)

────────────────────
_ ¶ interpolated-message
    - variable String
    - property String

$missing; in a string, $written reads the property "$property" of $variable. $fix

════════════════════
.. missing = "Property \"$property\" not found"
.. written = "\"\$${variable}.${property}\""
.. fix = "Write \"${braced(variable)}.${property}\" to put text after the value"

────────────────────
_ do interpolated-read String?
    - tree AST
    - object SyntaxId

do match? tree.nodes[object]
    | .node-identifier(row)
        if preceded-by-dollar(tree, object)
            = row.name.text
= null

────────────────────
_ preceded-by-dollar Bool
    - tree AST
    - id SyntaxId

loc.begin.column != 0 && char-at(line, loc.begin.column - 1) == '$'

.. loc = tree.nodes.loc[id]
.. line = source-line(tree.source, loc.begin.line)

────────────────────
_ do char-at Char
    - text String
    - position Index

. index Index = 0
for char in text
    if index == position
        = char
    index += 1
= 0 as Char

────────────────────
_ braced String
    - name String

"\$" ++ "{" ++ name ++ "}"

────────────────────
_ do operation-message String
    - diagnostic TypeDiagnostic
    - base String

. tree = program.modules[diagnostic.module].tree
. left = diagnostic.from
. right = diagnostic.to
if diagnostic.name?.text == "!" && known(left) && !joins-conditions(tree, diagnostic.syntax)
    . shown = type-source(types, left)
    . reason = if shown.starts-with("function ") then "; it is a function, so call it first" else ", since operator \"!\" is not defined for it"
    = "$shown cannot be tested as a condition$reason"
do match? tree.nodes[diagnostic.syntax]
    | .node-binary-expression(row)
        . op = "$row.op"
        if left == no-type
            left = facts.node-type(diagnostic.instance, row.lhs)
        if right == no-type
            right = facts.node-type(diagnostic.instance, row.rhs)
        if known(left) && known(right)
            = "Operator \"$op\" is not defined for ${operands-text(left, right)}"
        = base
    | .node-unary-expression(row)
        . op = if row.op == .negative-op then "-" else op-text
            .. op-text = if row.op == .read-op then "<-" else "$row.op"
        if left == no-type
            left = facts.node-type(diagnostic.instance, row.operand)
        if known(left)
            . shown = type-source(types, left)
            . callable = shown.starts-with("function ")
            . calling = if callable then "; it is a function, so call it first" else ""
            = "Operator \"$op\" is not defined for $shown$calling"
        = base
    | .node-assign(row)
        if left == no-type
            left = facts.node-type(diagnostic.instance, row.lhs)
        if right == no-type
            right = facts.node-type(diagnostic.instance, row.rhs)
        . op = if is-brix-tree(tree) then "$row.op" else between(tree, row.lhs, row.rhs)
        if known(left) && known(right) && op.length != 0
            = "Operator \"$op\" is not defined for ${operands-text(left, right)}"
if known(left) && known(right)
    = "$base: ${operands-text(left, right)}"
= base

────────────────────
_ joins-conditions Bool
    - tree AST
    - syntax SyntaxId

` Whether a condition is an operand of "&&" or "||", which is reported as the operator's.
match tree.nodes[syntax]
    | .node-binary-expression(row)
        row.op == .and-op || row.op == .or-op
    ??
        false

────────────────────
_ operands-text String
    - left TypeId
    - right TypeId

"${type-source(types, left)} and ${type-source(types, right)}"

────────────────────
_ between String
    - tree AST
    - left SyntaxId
    - right SyntaxId

|? left-end.line != right-start.line || start >= end || end > line.length
    ""
??
    line[start .. < end].trim()

.. left-end = tree.nodes.loc[left].end
.. right-start = tree.nodes.loc[right].begin
.. line = source-line(tree.source, left-end.line)
.. start = left-end.column + 1
.. end = right-start.column

────────────────────
_ do type-not-found-message String
    - diagnostic TypeDiagnostic
    - base String

. tree = program.modules[diagnostic.module].tree
do match? tree.nodes[diagnostic.syntax]
    | .node-symbol
        = case-message(diagnostic, base)
. name = type-name-at(tree, diagnostic.syntax)
if !name
    do match? tree.nodes[diagnostic.syntax]
        | .node-integer-syntax(row)
            = unit-message(diagnostic, row.unit)
        | .node-float-syntax(row)
            = unit-message(diagnostic, row.unit)
    = base
. facet = facet-named(program.store-atom(name))
=? facet-reach-message(diagnostic.module, name, facet) if facet
. nearby = visible-name-texts(diagnostic.module, true)
. note = missing-note(diagnostic.module, program.store-atom(name), true, nearby)
= "Type \"$name\" not found$note"

────────────────────
_ facet-reach-message String
    - module ModuleId
    - name String
    - facet U32

|? kept
    "$missing; facet $name of $owner is private, declared with _, so only its own file names it"
|? hosted
    "$missing; facet $name of $owner is in reach of another facet only where it sees it. Write \"sees $name\" under the facet that uses it"
??
    "$missing; $name is a facet of $owner, whose name comes with $owner's module. Import that module to name it"

.. missing = "Type \"$name\" not found"
.. owner = facet-owner-name(facet)
.. kept = is-kept-facet(module, facet)
.. hosts = program.facets.hosts
.. hosted = module < hosts.length && hosts[module] == program.facets.owner-modules[facet]

────────────────────
_ is-kept-facet Bool
    - module ModuleId
    - facet U32

` Whether a facet is private to a file other than a module's.
match program.modules[home].decls[program.facets.decls[facet]]
    | .decl-extension(row)
        home != module && !program.reaches-access(module, home, row.access)
    ??
        false

.. home = program.facets.modules[facet]

────────────────────
_ do facet-named U32?
    - name Atom

` The facet of the program with a name, if one has it.
. facets = program.facets
for facet in 0 .. < facets.count
    do match? program.modules[facets.modules[facet]].decls[facets.decls[facet]]
        | .decl-extension(row)
            if row.facet == name
                = facet as U32
= null

────────────────────
_ facet-owner-name String
    - facet U32

class-name(program, program.facets.owner-modules[facet], program.facets.owner-decls[facet])

────────────────────
_ do unit-message String
    - diagnostic TypeDiagnostic
    - unit Atom?

` That the unit written after a number names nothing, with the module that declares it where
` the program does.
if !unit
    = "Unit not found"
. message = "Unit \"${unit.text}\" not found"
. elsewhere = unimported-hint(diagnostic.module, unit, true)
if elsewhere
    = "$message; ${elsewhere}"
= message

────────────────────
_ do type-name-at String?
    - tree AST
    - id SyntaxId

do match? tree.nodes[id]
    | .node-type-identifier(row)
        = row.name.text
    | .node-type-arguments(row)
        = type-name-at(tree, row.base)
    | .node-type-optional(row)
        if row.field-types.count != 0
            = type-name-at(tree, tree.children[row.field-types.start])
    | .node-identifier(row)
        = row.name.text
= null

────────────────────
_ do facet-widening String?
    - receiver TypeId
    - name Atom

` The owner of a facet's value, where the owner or another of its facets has a member of a name
` that the facet's value lacks.
. facet = types.facet-of-type(receiver) if receiver != no-type && receiver != invalid-type
=? null if !facet
. owner = types.facet-owner(facet)
=? null if owner == no-type || !class-declares(owner, name)
= type-source(types, owner)

────────────────────
_ do unseen-facet String?
    - module ModuleId
    - name Atom
    - receiver TypeId = no-type

` A facet of a class that a module declares facets of, which declares a member of a name that is
` not private and which the module's facets do not see: a facet of the receiver's class or of a
` class above it, where there is a receiver, which a facet's value is its owner's.
. facets = program.facets
. viewed = types.facet-of-type(receiver) if receiver != no-type && receiver != invalid-type
. held = if viewed then types.facet-owner(viewed) else receiver
for facet in 0 .. < facets.count
    . owned = held == no-type || is-of-class(held, facets.owner-modules[facet], facets.owner-decls[facet])
    if owned && facets.states[facet] == .facet-bound && !program.sees-facet(module, facet as U32)
        . target = program.modules[facets.modules[facet]]
        do match? target.decls[facets.decls[facet]]
            | .decl-extension(row)
                . place = target.first-member(row.members, name)
                while place != no-member
                    . member = target.member-pool[place]
                    place = target.member-links[place]
                    . shared = match target.decls[member]
                        | .decl-property(property)
                            property.name == name && property.access != .private-access
                        | .decl-function(fn)
                            fn.name == name && fn.access != .private-access
                        | .decl-event(event)
                            event.name == name && event.access != .private-access
                        ??
                            false
                    if shared
                        = row.facet?.text
= null

────────────────────
_ stated-name-message String
    - diagnostic TypeDiagnostic
    - base String

if name then name-message(diagnostic.module, diagnostic.syntax, name) else base

.. name = written-name(program.modules[diagnostic.module].tree, diagnostic.syntax)

────────────────────
_ name-message String
    - module ModuleId
    - syntax SyntaxId
    - name String

|? dash && dash > 0 && preceded-by-dollar(program.modules[module].tree, syntax)
    "$missing; in a string, \"\$$name\" reads the whole name \"$name\". $fix"
|? unseen
    "$missing; facet $unseen declares it, and only the facets a facet sees are in reach. Write \"sees $unseen\" under the facet that uses it"
??
    "$missing${missing-note(module, program.store-atom(name), false, nearby)}"

.. missing = "Name \"$name\" not found"
.. unseen = unseen-facet(module, program.store-atom(name))
.. dash = name.find-reverse("-")
.. rest = name[dash ...]
.. fix = "Write \"${braced(name[0 .. < dash])}$rest\" to put \"$rest\" after the value"
.. nearby = local-names(module, syntax) ++ visible-name-texts(module, false)

────────────────────
_ do declared-match-message String
    - diagnostic TypeDiagnostic
    - base String

. tree = program.modules[diagnostic.module].tree
. name = ""
. annotation SyntaxId = 0
do match? tree.nodes[diagnostic.syntax]
    | .node-type-capture(row)
        name = written-name(tree, row.id) ?? ""
        annotation = row.type
if annotation == 0
    = base
. value = no-type
for position in 0 .. < tree.nodes.length
    do match? tree.nodes[position]
        | .node-declare(row)
            if row.left == diagnostic.syntax
                value = facts.node-type(diagnostic.instance, row.right)
if !known(value)
    = base
. wanted = written-type(tree, annotation)
. shown = type-source(types, value)
. viewed = types.facet-of-type(value)
if viewed
    . owner = type-source(types, types.facet-owner(viewed))
    = "\"$name\" is declared $wanted, but its value is $shown, a facet's value, which becomes only the facets it is part of unasked; write \"as $owner\" to convert its class"
. fix = "convert the value, or declare \"$name\" without a type"
= "\"$name\" is declared $wanted, but its value is $shown, which can never be $wanted; $fix"

────────────────────
_ cast-message String
    - diagnostic TypeDiagnostic
    - base String

|? !known(diagnostic.from) || !known(diagnostic.to)
    base
|? written
    "$source cannot be cast to $target; there is no conversion between them"
|? chooses
    "The two sides of this \"if\" are $target and $source, which have no common type; convert them to one type"
??
    "Expected $target here, but this is $source, and there is no conversion between them"

.. source = type-source(types, diagnostic.from)
.. target = type-source(types, diagnostic.to)
.. node = program.modules[diagnostic.module].tree.nodes[diagnostic.syntax]
.. written = node is .node-cast-expression
.. chooses = match node
    | .node-binary-expression(row)
        row.op == .else-op
    ??
        false

────────────────────
_ unasked-message String
    - diagnostic TypeDiagnostic
    - base String

|? !known(diagnostic.from) || !known(diagnostic.to)
    base
??
    match diagnostic.kind
        |= .unasked-unwrap
            "$lead, which may hold nothing; write \"!\" after it to unwrap it, or \"?? fallback\" to give a value for nothing"
        |= .unasked-text
            "$lead, which becomes text only inside a text or a print, or when asked; write \"as $target\", or write it inside a text, as in \"\$name\""
        |= .unasked-narrowing
            "$lead, which is not always $target; match it with \"| name $target\", or write \"as $target\""
        ??
            "$lead, which becomes $target only when asked; write \"as $target\""

.. target = type-source(types, diagnostic.to)
.. lead = "Expected $target here, but this is ${type-source(types, diagnostic.from)}"

────────────────────
_ imperative-message String
    - diagnostic TypeDiagnostic
    - limit String
    - base String
    - remedy String = ""

|? !fn
    base
|? fn.kind == .closure-decl
    "$lead; ${offered}write \"${if is-brix then ":do" else "=> do"}\"$returning"
|? is-brix && header.starts-with("(fn-expr ")
    "$lead; ${offered}write \"(fn-do ${header[9 ...]} …)\"$returning"
|? !(header.starts-with("+ ") || header.starts-with("_ "))
    "$lead; ${offered}declare it with $doing$returning"
??
    "$lead; ${offered}write \"${header[0 .. < 2]}do ${header[2 ...]}\"$returning"

.. owner = program.modules[diagnostic.module]
.. is-brix = is-brix-tree(owner.tree)
.. doing = if is-brix then "fn-do" else "do"
.. fn = enclosing-function-decl(owner, diagnostic.syntax)
.. header = line-at(owner.tree, fn.syntax).trim()
.. name = fn.name!.text
.. lead = if fn.kind == .closure-decl then "A closure without ${if is-brix then ":do" else "do"} is one expression and $limit" else "Function \"$name\" is not declared with $doing, so its body is one expression and $limit"
.. offered = if remedy then "$remedy, or " else ""
.. returning = match diagnostic.kind
    |= .explicit-return-requires-do
        ""
    ??
        " and return its value with \"${if is-brix then "(return value)" else "= value"}\""

────────────────────
_ do default-message String
    - diagnostic TypeDiagnostic
    - base String

. owner = program.modules[diagnostic.module]
for decl in owner.decls
    do match? decl
        | .decl-function(fn)
            . position = argument-at(owner, fn, diagnostic.syntax)
            if position != U32.max
                = required-after-default(owner, fn, position, base)
= base

────────────────────
_ do argument-at U32
    - owner Module
    - fn FunctionDecl
    - syntax SyntaxId

for offset in 0 .. < fn.args.count
    if owner.arg-pool[fn.args.start + offset].pattern == syntax
        = offset
= U32.max

────────────────────
_ do required-after-default String
    - owner Module
    - fn FunctionDecl
    - position U32
    - base String

. required = owner.arg-pool[fn.args.start + position]
. earlier = U32.max
for offset in 0 .. < position
    if owner.arg-pool[fn.args.start + offset].has-default
        earlier = offset
        break
if earlier == U32.max
    = base
. defaulted = owner.arg-pool[fn.args.start + earlier]
. named = shape-name(owner.tree, required)
. prior = shape-name(owner.tree, defaulted)
. fix = "declare required parameters first, or give $named a default"
= "Parameter $named has no default but comes after $prior, which has a default; $fix"

────────────────────
_ shape-name String
    - tree AST
    - shape ArgumentShape

"\"$named\""

.. named = if shape.name then shape.name.text else written-name(tree, shape.pattern) ?? "?"

────────────────────
_ divider-message String
    - diagnostic TypeDiagnostic
    - base String

if stray == 0 then base else stray-message(diagnostic.module, divided-holder(diagnostic)!, stray)

.. stray = divided-stray(diagnostic)

────────────────────
_ divided-stray SyntaxId
    - diagnostic TypeDiagnostic

if holder then stray-declaration(diagnostic.module, holder.syntax) else 0

.. holder = divided-holder(diagnostic)

────────────────────
_ do divided-holder FunctionDecl?
    - diagnostic TypeDiagnostic

. owner = program.modules[diagnostic.module]
do match? diagnostic.kind
    |= .non-void-return
        = function-at(owner, diagnostic.syntax)
    |= .stated
        =? enclosing-function-decl(owner, diagnostic.syntax) if diagnostic.name && diagnostic.name.text == bare-value-text()
= null

────────────────────
_ bare-value-text String

"A value cannot stand alone as a step; use it, or remove it"

────────────────────
_ do stray-declaration SyntaxId
    - module ModuleId
    - header SyntaxId

. owner = program.modules[module]
. fn = function-at(owner, header)
=? 0 if !fn || fn.is-content || fn.kind == .live-decl
do match? owner.tree.nodes[fn.body]
    | .node-block(row)
        for statement in owner.tree.children[row.body]
            do match? owner.tree.nodes[statement]
                | .node-property-syntax
                    = statement
= 0

────────────────────
_ do stray-holder FunctionDecl?
    - module ModuleId
    - syntax SyntaxId

. owner = program.modules[module]
do match? owner.tree.nodes[syntax]
    | .node-property-syntax
        . fn = enclosing-function-decl(owner, syntax)
        if fn && !fn.is-content && fn.body != 0 && stray-declaration(module, fn.syntax) == syntax
            = fn
= null

────────────────────
_ stray-message String
    - module ModuleId
    - fn FunctionDecl
    - stray SyntaxId

|? valued && fn.owner == 0
    "$lead; declare module-level values above the first divider"
|? valued
    "$lead; declare properties above the first thin divider (─) of the type"
??
    "$lead; put $divider on the line above it"

.. tree = program.modules[module].tree
.. line = line-at(tree, stray).trim()
.. name = if fn.name then fn.name.text else "?"
.. lead = "\"$line\" is read as part of the body of \"$name\", because no divider separates them"
.. valued = match tree.nodes[stray]
    | .node-property-syntax(row)
        row.value != 0
    ??
        false
.. divider = if fn.owner != 0 then "a thin divider (─)" else "a thick divider (━)"

────────────────────
_ stated-redefined-message String
    - diagnostic TypeDiagnostic
    - base String

if name then redefined-message(diagnostic.module, diagnostic.syntax, name) else base

.. name = written-name(program.modules[diagnostic.module].tree, diagnostic.syntax)

────────────────────
_ ¶ redefined-message
    - module ModuleId
    - syntax SyntaxId
    - name String

"$name" is already declared$place in this scope; $fix, or choose another name

════════════════════
.. earlier = earlier-slot(module, syntax, name)
.. tree = program.modules[module].tree
.. place = if earlier != 0 then " on line ${tree.nodes.loc[earlier].begin.line + 1}" else ""
.. fix = "to change its value, assign it without the \".\", as in \"$name = value\""

────────────────────
_ do earlier-slot SyntaxId
    - module ModuleId
    - syntax SyntaxId
    - name String

. narrowest = U32.max
. found SyntaxId = 0
for binding in bindings.bindings
    . start = binding.subtree.start
    . count = binding.subtree.count
    if binding.module == module && syntax >= start && syntax < start + count && count < narrowest
        narrowest = count
        found = 0
        for slot in bindings.slots[binding.slots]
            if slot.name.text == name && slot.syntax != 0 && slot.syntax < syntax
                found = slot.syntax
= found

────────────────────
_ do stated-undeclared-message String
    - diagnostic TypeDiagnostic
    - base String

. tree = program.modules[diagnostic.module].tree
do match? tree.nodes[diagnostic.syntax]
    | .node-assign(row)
        . name = written-name(tree, row.lhs)
        if name
            = undeclared-message(diagnostic.module, diagnostic.syntax, name)
= base

────────────────────
_ undeclared-message String
    - module ModuleId
    - syntax SyntaxId
    - name String

|? close.length != 0
    "Variable \"$name\" is not declared$close"
??
    "Variable \"$name\" is not declared; declare it with \"$declaring\""

.. close = suggested(name, local-names(module, syntax))
.. tree = program.modules[module].tree
.. written = node-text(tree, syntax)
.. whole = tree.nodes.loc[syntax].end.line == tree.nodes.loc[syntax].begin.line
.. declaring = if is-brix-tree(tree) then brix-declaring(written, name, whole) else yumi-declaring
.. yumi-declaring = if written.starts-with("$name = ") then ". $written" else ". $name = value"

────────────────────
_ brix-declaring String
    - written String
    - name String
    - whole Bool

if whole && written.starts-with("(= $name ") then "(let ${written[3 ...]}" else "(let $name value)"

────────────────────
_ local-call-message String?
    - diagnostic TypeDiagnostic
    - callable SyntaxId
    - name Atom

|? local-names(diagnostic.module, callable).find(name.text) == null
    null
|? visible-signatures(diagnostic.module, name, .function-decl, null).length != 0
    null
|? shown.starts-with("function ") || shown == "closure"
    null
??
    "\"${name.text}\" is $what, not a function, so it cannot be called"

.. declared = earlier-slot(diagnostic.module, callable, name.text)
.. type = if declared != 0 then declared-type(diagnostic, declared) else no-type
.. shown = if known(type) then type-source(types, type) else ""
.. what = if shown.length != 0 then "a local $shown" else "a local value"

────────────────────
_ do declared-type TypeId
    - diagnostic TypeDiagnostic
    - declared SyntaxId

. tree = program.modules[diagnostic.module].tree
. own = facts.node-type(diagnostic.instance, declared)
=? own if known(own)
for position in 0 .. < tree.nodes.length
    do match? tree.nodes[position]
        | .node-declare(row)
            if row.left == declared
                = facts.node-type(diagnostic.instance, row.right)
= no-type

────────────────────
_ catch-message String
    - diagnostic TypeDiagnostic
    - base String

|? written.length == 0
    base
??
    "\"$written\" cannot fail, so the catch attached to it has nothing to handle; $fix"

.. tree = program.modules[diagnostic.module].tree
.. written = node-text(tree, diagnostic.syntax)
.. fix = "remove the catch, or attach it to a call that can fail"

────────────────────
_ arm-step-message String
    - diagnostic TypeDiagnostic

"This arm gives no value, and a match gives the value of the arm it takes; to run its arms as steps, write \"$form\""

.. form = if is-brix-tree(program.modules[diagnostic.module].tree) then "(do (inline (match …)))" else "do match"

────────────────────
_ do list-message String
    - diagnostic TypeDiagnostic
    - base String

. tree = program.modules[diagnostic.module].tree
. shown [String]
do match? tree.nodes[diagnostic.syntax]
    | .node-list-syntax(row)
        for item in tree.children[row.items]
            . type = facts.node-type(diagnostic.instance, item)
            if known(type) && shown.find(type-source(types, type)) == null
                shown += type-source(types, type)
=? base if shown.length < 2
= "This list mixes ${listed(shown)}, which have no common type; convert the items to one type"

────────────────────
_ iteration-message String
    - diagnostic TypeDiagnostic
    - base String

|? !settled(type)
    base
|? is-integer-kind(types.completion-of(type).intrinsic)
    "$cannot; to count, loop over a range, as in \"0 .. < $written\""
??
    "$cannot; loop over a list, a range or a stream"

.. type = facts.node-type(diagnostic.instance, diagnostic.syntax)
.. cannot = "A for loop cannot iterate over ${type-source(types, type)}"
.. written = node-text(program.modules[diagnostic.module].tree, diagnostic.syntax)

────────────────────
_ redefinition-message String
    - diagnostic TypeDiagnostic
    - base String

|? member == U32.max || !name || holder.length == 0
    base
??
    "$holder declares \"${name.text}\" twice$place; remove one of them, or rename it"

.. owner = program.modules[diagnostic.module]
.. member = member-at(owner, diagnostic.syntax)
.. name = member-name(owner, member)
.. holder = holder-text(owner, member-owner(owner, member))
.. first = earlier-member(owner, member, name)
.. first-line = owner.tree.nodes.loc[member-site(owner, first)].begin.line + 1
.. place = if first != U32.max then " (first on line $first-line)" else ""

────────────────────
_ override-type-message String
    - diagnostic TypeDiagnostic
    - base String

|? member == U32.max || !name || inherited.length == 0
    base
??
    "\"${name.text}\" is inherited from $inherited, $kept"

.. owner = program.modules[diagnostic.module]
.. member = member-at(owner, diagnostic.syntax)
.. name = member-name(owner, member)
.. inherited = base-text(owner, member)
.. typed = member-type-text(owner, member)
.. removal = if typed.length != 0 then "; remove \"$typed\"" else ""
.. kept = "so it keeps the type it has there and cannot state its own$removal"

────────────────────
_ override-storage-message String
    - diagnostic TypeDiagnostic
    - base String

|? member == U32.max || !name || inherited.length == 0
    base
|? own.length != 0 && theirs.length != 0 && own != theirs
    "$lead, which declares it $theirs, so declare it $theirs here too, not $own"
??
    "$lead, so declare it the way $inherited does, $same"

.. owner = program.modules[diagnostic.module]
.. member = member-at(owner, diagnostic.syntax)
.. name = member-name(owner, member)
.. inherited = base-text(owner, member)
.. lead = "\"${name.text}\" is inherited from $inherited"
.. own = storage-text(owner.tree, diagnostic.syntax)
.. theirs = inherited-storage(diagnostic.module, inherited, name)
.. same = "with the same \"=\" or \":=\", or as a getter if it is one there"

────────────────────
_ storage-text String
    - tree AST
    - syntax SyntaxId

|? text.starts-with("+ get ") || text.starts-with("_ get ") || brix-getter
    "as a getter"
|? text.find(if is-brix then " (:= " else " := ") != null
    "with \":=\""
|? text.find(if is-brix then " (= " else " = ") != null
    "with \"=\""
??
    ""

.. text = line-at(tree, syntax).trim()
.. is-brix = is-brix-tree(tree)
.. brix-getter = is-brix && text.find(" :get") != null

────────────────────
_ line-at String
    - tree AST
    - syntax SyntaxId

source-line(tree.source, tree.nodes.loc[syntax].begin.line)

────────────────────
_ do inherited-storage String
    - caller ModuleId
    - written String
    - name Atom

. cut = written.find("'")
. named = if cut then written[0 .. < cut] else written
for candidate in program.lookup(caller, program.store-atom(named))
    . owner = program.modules[candidate.module]
    do match? owner.decls[candidate.decl]
        | .decl-class(class)
            for offset in 0 .. < class.members.count
                . member = owner.member-pool[class.members.start + offset]
                if member-name(owner, member) == name
                    = storage-text(owner.tree, member-site(owner, member))
= ""

────────────────────
_ do member-at DeclId
    - owner Module
    - syntax SyntaxId

. index = 0u32
for _ in owner.decls
    if syntax != 0 && member-site(owner, index) == syntax
        = index
    index += 1
= U32.max

────────────────────
_ member-site SyntaxId
    - owner Module
    - decl DeclId

match owner.decls[decl]
    | .decl-property(property)
        property.syntax
    | .decl-function(fn)
        fn.syntax
    | .decl-event(event)
        event.syntax
    ??
        0u32

────────────────────
_ member-name Atom?
    - owner Module
    - decl DeclId

match? owner.decls[decl]
    | .decl-property(property)
        property.name
    | .decl-function(fn)
        fn.name
    | .decl-event(event)
        event.name

────────────────────
_ member-owner DeclId
    - owner Module
    - decl DeclId

match owner.decls[decl]
    | .decl-property(property)
        property.owner
    | .decl-function(fn)
        fn.owner
    | .decl-event(event)
        event.owner
    ??
        0u32

────────────────────
_ member-type-text String
    - owner Module
    - decl DeclId

if syntax != 0 then node-text(owner.tree, syntax) else ""

.. syntax = match owner.decls[decl]
    | .decl-property(property)
        property.type-syntax
    | .decl-function(fn)
        fn.return-type
    ??
        0u32

────────────────────
_ do base-text String
    - owner Module
    - decl DeclId

. holder = member-owner(owner, decl)
=? "" if holder == 0
do match? owner.decls[holder]
    | .decl-class(class)
        if class.base != 0
            = written-type(owner.tree, class.base)
= ""

────────────────────
_ do earlier-member DeclId
    - owner Module
    - member DeclId
    - name Atom

. holder = member-owner(owner, member)
=? U32.max if holder == 0
do match? owner.decls[holder]
    | .decl-class(class)
        for offset in 0 .. < class.members.count
            . other = owner.member-pool[class.members.start + offset]
            if other < member && member-name(owner, other) == name
                = other
= U32.max

────────────────────
_ do case-message String
    - diagnostic TypeDiagnostic
    - base String

. tree = program.modules[diagnostic.module].tree
. name = ""
do match? tree.nodes[diagnostic.syntax]
    | .node-symbol(row)
        name = row.name.text
=? base if name.length == 0
. names [String]
for position in 0 .. < program.modules.length
    . owner = program.modules[position]
    for decl in owner.decls
        do match? decl
            | .decl-case(case)
                if case.name && case.name.text == name
                    . holder = holder-text(owner, case.owner)
                    if holder.length != 0
                        = unimported-case-message(diagnostic.module, owner, holder, name)
                if case.name && names.find(".${case.name.text}") == null
                    names += ".${case.name.text}"
= "Case \".$name\" not found${suggested(".$name", names)}"

────────────────────
_ ¶ unimported-case-message
    - caller ModuleId
    - owner Module
    - holder String
    - name String

Case ".$name" belongs to $holder, which this module does not import, so $alone; $fix

════════════════════
.. alone = "the case cannot be named alone"
.. fix = "write \"$holder.$name\" and add the import ${import-line(caller, owner)}"

────────────────────
_ do holder-text String
    - owner Module
    - holder DeclId

=? "" if holder == 0
do match? owner.decls[holder]
    | .decl-class(class)
        = class.name.text
= ""

────────────────────
_ do case-names [String]
    - caller ModuleId
    - name String

. found [String]
for candidate in program.lookup(caller, program.store-atom(name))
    . owner = program.modules[candidate.module]
    do match? owner.decls[candidate.decl]
        | .decl-class(class)
            for offset in 0 .. < class.members.count
                do match? owner.decls[owner.member-pool[class.members.start + offset]]
                    | .decl-case(case)
                        if case.name
                            found += case.name.text
= found

────────────────────
_ chaining-message String
    - diagnostic TypeDiagnostic
    - base String

|? object == 0 || !(is-brix-tree(tree) || written.starts-with(receiver)) || not-chained
    base
??
    "\"$receiver\" is ${typed}never null, so it needs no \"?\"; write \"$fixed\""

.. tree = program.modules[diagnostic.module].tree
.. object = chained-object(tree, diagnostic.syntax)
.. not-chained = char-at(written, mark) != '?'
.. written = node-text(tree, diagnostic.syntax)
.. receiver = node-text(tree, object)
.. link = chained-link(tree, diagnostic.syntax)
.. linked = tree.nodes.loc[link].begin.column - tree.nodes.loc[diagnostic.syntax].begin.column
.. mark = if is-brix-tree(tree) then (linked + 1) as Index else receiver.length
.. fixed = written[0 .. < mark] ++ written[mark + 1 ...]
.. type = facts.node-type(diagnostic.instance, object)
.. typed = if known(type) then "${type-source(types, type)}, which is " else ""

────────────────────
_ force-message String
    - diagnostic TypeDiagnostic
    - base String

|? forced.length == 0
    base
??
    "\"$forced\" is ${typed}never null here, so it needs no \"$mark\""

.. tree = program.modules[diagnostic.module].tree
.. written = node-text(tree, diagnostic.syntax)
.. forced = if is-brix-tree(tree) then forced-operand(tree, diagnostic.syntax) else unforced
.. unforced = if written.ends-with("!") then written[0 .. < written.length - 1] else ""
.. mark = if is-brix-tree(tree) then "!!" else "!"
.. typed = if known(diagnostic.from) then "$from-text, which is " else ""
.. from-text = type-source(types, diagnostic.from)

────────────────────
_ forced-operand String
    - tree AST
    - id SyntaxId

match tree.nodes[id]
    | .node-unary-expression(row)
        if row.op == .optional-force-op then node-text(tree, row.operand) else ""
    ??
        ""

────────────────────
_ chained-link SyntaxId
    - tree AST
    - id SyntaxId

match tree.nodes[id]
    | .node-call-expression(row)
        chained-link(tree, row.callable)
    ??
        id

────────────────────
_ chained-object SyntaxId
    - tree AST
    - id SyntaxId

match tree.nodes[id]
    | .node-get-expression(row)
        row.object
    | .node-index-expression(row)
        row.object
    | .node-call-expression(row)
        chained-object(tree, row.callable)
    ??
        0u32

────────────────────
_ called-member SyntaxId
    - tree AST
    - id SyntaxId

match tree.nodes[id]
    | .node-get-expression
        id
    | .node-call-expression(row)
        called-member(tree, row.callable)
    ??
        0u32

────────────────────
_ do extension-message String
    - diagnostic TypeDiagnostic
    - base String

. tree = program.modules[diagnostic.module].tree
. member = called-member(tree, diagnostic.syntax)
=? base if member == 0
do match? tree.nodes[member]
    | .node-get-expression(row)
        . receiver = facts.node-type(diagnostic.instance, row.object)
        . shown = if known(receiver) then " for ${type-source(types, receiver)}" else ""
        . fix = "remove or rename all but one of them"
        . declared = "More than one extension declares \"${row.name.text}\"$shown"
        = "$declared, so the call is ambiguous; $fix"
= base

────────────────────
_ recursion-message String
    - diagnostic TypeDiagnostic
    - base String

|? !fn || !fn-name
    base
??
    "Function \"${fn-name.text}\" $reason; declare it, as in \"$declared\""

.. owner = program.modules[diagnostic.module]
.. fn = function-at(owner, diagnostic.syntax)
.. fn-name = fn.name
.. reason = "calls itself before its return type is known, so the type cannot be inferred"
.. header = line-at(owner.tree, fn.syntax).trim()
.. returned = if known(diagnostic.to) then type-source(types, diagnostic.to) else "ReturnType"
.. cut = header.find(" ?! ")
.. declared = if is-brix-tree(owner.tree) then brix-returning(header, returned) else typed
.. typed = if cut then "${header[0 .. < cut]} $returned${header[cut ...]}" else "$header $returned"

────────────────────
_ do brix-returning String
    - header String
    - returned String

. words = List(header.split(" "))
if words.length > 3 && words[3] == "_"
    words[3] = returned
= "${" ".join(words)} …)"

────────────────────
_ unify-message String
    - diagnostic TypeDiagnostic
    - base String

|? !known(diagnostic.from) || !known(diagnostic.to)
    base
??
    "$subject returns $here here and $elsewhere elsewhere, which have no common type; $fix"

.. fn = enclosing-function-decl(program.modules[diagnostic.module], diagnostic.syntax)
.. subject = if fn then "Function \"${fn.name!.text}\"" else "This function"
.. here = type-source(types, diagnostic.from)
.. elsewhere = type-source(types, diagnostic.to)
.. fix = "return one type, or declare the return type"

────────────────────
_ circular-message String
    - diagnostic TypeDiagnostic
    - base String

|? !name
    base
??
    "\"$name\" depends on its own value, directly or through the values it reads; break the cycle"

.. owner = program.modules[diagnostic.module]
.. member = member-at(owner, diagnostic.syntax)
.. declared = member-name(owner, member) if member != U32.max
.. name = if declared then declared.text else written-name(owner.tree, diagnostic.syntax)

────────────────────
_ do null-message String
    - diagnostic TypeDiagnostic
    - base String

. tree = program.modules[diagnostic.module].tree
. type = node-text(tree, diagnostic.syntax)
for position in 0 .. < tree.nodes.length
    do match? tree.nodes[position]
        | .node-type-capture(row)
            if row.type == diagnostic.syntax
                . name = written-name(tree, row.id)
                if name
                    = interface-default-message(name, type)
= base

────────────────────
_ ¶ interface-default-message
    - name String
    - type String

"$name" is declared $type with no value, but $type is an interface, so $nothing; $fix

════════════════════
.. nothing = "there is nothing to construct"
.. fix = "give it a value, as in \". $name $type = value\", or $declare"
.. declare = "declare it \"$type?\" to start as null"

────────────────────
_ return-message String
    - diagnostic TypeDiagnostic
    - base String

|? enclosing-function-decl(owner, diagnostic.syntax)
    base
|? !at-top
    "Only a function can return with \"$returning\", and this statement is not inside one; remove the \"$returning\""
??
    "The top level of a module cannot return a value with \"$returning\"; $removal"

.. owner = program.modules[diagnostic.module]
.. tree = owner.tree
.. is-brix = is-brix-tree(tree)
.. at-top = if is-brix then tree.holder-of(diagnostic.syntax) == tree.root else at-margin
.. at-margin = tree.nodes.loc[diagnostic.syntax].begin.column == 0
.. returning = if is-brix then "return" else "="
.. printing = if is-brix then "print" else "--"
.. removal = "remove the \"$returning\", or print the value with \"$printing\""

────────────────────
_ subscriber-return-message String
    - diagnostic TypeDiagnostic
    - base String

|? !fn
    base
|? stream == 0
    base
|? is-class-section(owner, fn.syntax)
    "The event handler for \"$source\" cannot return with \"=\"; move its body into a method$method and call that, or end the handler early with \"continue\""
??
    "The body of a loop on \"$source\" cannot return with \"=\"; skip to the next value with \"continue\", or stop the loop with \"break\""

.. owner = program.modules[diagnostic.module]
.. fn = enclosing-subscriber-decl(owner, diagnostic.syntax)
.. stream = subscribed-stream(owner.tree, fn.syntax)
.. source = node-text(owner.tree, stream)
.. name = written-name(owner.tree, stream)
.. method = if name then ", as in \"_ do handle-$name\"," else ""

────────────────────
_ do is-class-section Bool
    - owner Module
    - syntax SyntaxId

=? false if enclosing-function-decl(owner, syntax)
for decl in owner.decls
    do match? decl
        | .decl-class(class)
            if syntax >= owner.tree.subtree-start(class.syntax) && syntax < class.syntax
                = true
= false

────────────────────
_ do enclosing-subscriber-decl FunctionDecl?
    - owner Module
    - syntax SyntaxId

. found FunctionDecl?
for decl in owner.decls
    do match? decl
        | .decl-function(fn)
            . start = fn.subtree.start
            . inside = syntax >= start && syntax < start + fn.subtree.count
            if inside && subscriber && (!found || fn.subtree.count < found.subtree.count)
                found = fn
            .. subscriber = fn.kind == .subscriber-decl
= found

────────────────────
_ do subscribed-stream SyntaxId
    - tree AST
    - id SyntaxId

do match? tree.nodes[id]
    | .node-for-block(row)
        do match? tree.nodes[row.loop]
            | .node-loop-syntax(loop)
                = loop.container
= 0

────────────────────
_ do argument-message String
    - diagnostic TypeDiagnostic
    - base String

. tree = program.modules[diagnostic.module].tree
. label = ""
do match? tree.nodes[diagnostic.syntax]
    | .node-argument(row)
        label = if row.name then row.name.text else ""
=? base if label.length == 0
for position in 0 .. < tree.nodes.length
    do match? tree.nodes[position]
        | .node-call-expression(row)
            for operand in tree.children[row.operands]
                if operand == diagnostic.syntax
                    . callee = node-text(tree, row.callable)
                    . type = facts.node-type(diagnostic.instance, row.callable)
                    . typed = if known(type) then ", whose type is $type-text" else ""
                        .. type-text = type-source(types, type)
                    = "\"$callee\" has no \"$label\" argument$typed"
= "This call has no \"$label\" argument"

────────────────────
_ raised-message String
    - diagnostic TypeDiagnostic
    - base String

|? !open || !close || !fn || !fn-name
    base
??
    "\"$name\" can fail with $names, but $other cannot; $fix"

.. open = base.find("(")
.. close = base.find(")")
.. fn = function-at(program.modules[diagnostic.module], diagnostic.syntax)
.. fn-name = fn.name
.. names = base[open + 1 .. < close]
.. name = fn-name.text
.. implements = base.ends-with(" interface does not")
.. other = if implements then "the interface method it implements" else "the method it overrides"
.. fix = "add \"${declared-errors(names)}\" to that method, or catch the error inside \"$name\""

────────────────────
_ declared-errors String
    - names String

" ".join((names.split(", ") *> "?! $each"))

────────────────────
_ brix-errors String
    - names String

" ".join((names.split(", ") *> "(?! $each)"))

────────────────────
_ recursive-errors-message String
    - diagnostic TypeDiagnostic
    - base String

|? !lead || !tail
    base
??
    "$names can leave \"$name\", which calls itself, so its errors cannot be inferred; $fix"

.. marker = " can leave recursive function "
.. lead = base.find(marker)
.. tail = base.find(" before its errors are inferred")
.. names = base[0 .. < lead]
.. name = base[lead + marker.length .. < tail]
.. example = declaring-example(program.modules[diagnostic.module], name, names)
.. fix = "declare them on it$example, or catch them here"

────────────────────
_ leaves-message String
    - diagnostic TypeDiagnostic
    - base String

|? !diagnostic.name || !known(diagnostic.from)
    base
??
    "$names can leave \"$name\", which does not declare it; declare it$example$catching"

.. name = diagnostic.name!.text
.. names = type-short-name(types, diagnostic.from)
.. owner = program.modules[diagnostic.module]
.. example = declaring-example(owner, name, names)
.. raising = node-text(owner.tree, diagnostic.syntax).starts-with
    - if is-brix-tree(owner.tree) then "(throw " else "?! "
.. catching = if raising then "" else ", or catch it here"

────────────────────
_ do declaring-example String
    - owner Module
    - name String
    - names String

for decl in owner.decls
    do match? decl
        | .decl-function(fn)
            if fn.name && fn.name.text == name
                . header = line-at(owner.tree, fn.syntax).trim()
                =? ", as in \"$header ${brix-errors(names)} …)\"" if is-brix-tree(owner.tree)
                = ", as in \"$header ${declared-errors(names)}\""
= ""

────────────────────
_ coverage-message String
    - diagnostic TypeDiagnostic
    - base String

|? split && on-result && !settled(diagnostic.from)
    "This catch does not handle ${listed(cases)}; add a handler for $each, or one for Error"
|? !split || !settled(diagnostic.from)
    base
|? missing == "present" && known(inner)
    "$matching handles only null; add a case for a present value, as in \"$present\", $rest"
|? arms.length == cases.length
    "$matching does not handle ${listed(cases)}; add ${listed(arms)}, $rest"
??
    "$matching does not handle ${listed(cases)}; add a case for $each, $rest"

.. split = base.find("; missing ")
.. missing = base[split + 10 ...]
.. on-result = base.starts-with("Non-exhaustive match for Result;")
.. matching = "This match on ${if on-result then "Result" else type-source(types, diagnostic.from)}"
.. inner = optional-inner(diagnostic.from)
.. present = "| value ${type-source(types, inner)}"
.. labels = List(missing.split(", "))
.. cases = List(labels *> plain-label(each))
.. arms = List(labels ?> is-literal-label(each) *> "\"|= $each\"")
.. each = if cases.length == 1 then "it" else "each"
.. rest = "or \"??\" for the rest"

────────────────────
_ is-literal-label Bool
    - label String

label == "true" || label == "false" || label == "null" || qualified

.. qualified = label.find(".") != null && !label.starts-with(".")

────────────────────
_ endpoint-message String
    - diagnostic TypeDiagnostic

"Event endpoints provide Broadcastable'$provided, not ${type-source(types, diagnostic.to)}"

.. provided = type-source(types, diagnostic.from)

────────────────────
_ plain-label String
    - label String

if label == "present" then "a present value" else label

────────────────────
_ listed String
    - names [String]

match names.length
    |= 0
        ""
    |= 1
        names[0]
    ??
        "${", ".join(names[0 .. < names.length - 1])} and ${names[names.length - 1]}"

────────────────────
_ do function-at FunctionDecl?
    - owner Module
    - syntax SyntaxId

for decl in owner.decls
    do match? decl
        | .decl-function(fn)
            if fn.syntax == syntax
                = fn
= null

────────────────────
_ do enclosing-function-decl FunctionDecl?
    - owner Module
    - syntax SyntaxId

. found FunctionDecl?
for decl in owner.decls
    do match? decl
        | .decl-function(fn)
            . start = fn.subtree.start
            . inside = syntax >= start && syntax < start + fn.subtree.count
            if inside && fn.name && (!found || fn.subtree.count < found.subtree.count)
                found = fn
= found

────────────────────
_ do arguments-text String?
    - diagnostic TypeDiagnostic
    - operands RowRange'SyntaxId

. tree = program.modules[diagnostic.module].tree
. positional [String]
. labeled = ""
for offset in 0 .. < operands.count
    . operand = tree.children[operands.start + offset]
    . expr = operand
    . label Atom?
    do match? tree.nodes[operand]
        | .node-argument(row)
            expr = row.expr
            label = row.name
    . type = facts.node-type(diagnostic.instance, expr)
    if !known(type)
        = null
    if label
        labeled += " ${label.text} ${type-source(types, type)}"
    else
        positional += type-source(types, type)
=? labeled.trim() if positional.length == 0 && labeled.length != 0
= "(${", ".join(positional)})$labeled"

────────────────────
_ private-note String
    - hidden [String]

if hidden.length == 0 then "" else "; ${" and ".join(hidden)} $verb private to its module"

.. verb = if hidden.length == 1 then "is" else "are"

────────────────────
_ family-note String
    - shared [String]

if shared.length == 0 then "" else "; ${" and ".join(shared)} $verb shared with its file family"

.. verb = if shared.length == 1 then "is" else "are"

────────────────────
_ do keeps Bool
    - caller ModuleId
    - module ModuleId
    - access Access
    - kept Access?

` Whether a declaration of a module with an access belongs in a list of signatures: one the caller
` reaches, for a list of none kept, or one kept from the caller by the access the list is of.
. reached = program.reaches-access(caller, module, access)
if !kept
    = reached
= !reached && access == kept

────────────────────
_ is-letter Bool
    - text String

text.length != 0 && ((text >= "a" && text <= "z") || (text >= "A" && text <= "Z"))

────────────────────
_ operator-name String
    - name String

|? name.starts-with("<-")
    "<-"
|? name == "-neg"
    "-"
??
    name

────────────────────
_ accepting String
    - given String?

if given then " accepts ${given}" else " matches these arguments"

────────────────────
_ declared-as String
    - signatures [String]

"it is declared as ${" or ".join(signatures)}"

────────────────────
_ do visible-signatures [String]
    - caller ModuleId
    - name Atom
    - kind DeclKind
    - kept Access?

. found [String]
for candidate in program.lookup(caller, name)
    . owner = program.modules[candidate.module]
    if owner.name.ends-with(".h")
        continue
    do match? owner.decls[candidate.decl]
        | .decl-function(fn)
            . open = keeps(caller, candidate.module, fn.access, kept)
            if fn.owner == 0 && fn.kind == kind && open && found.length < 3
                found += signature(owner, fn)
= found

────────────────────
_ do member-signatures [String]
    - caller ModuleId
    - receiver TypeId
    - name Atom
    - kept Access?
    - added RowRange'DeclRef = RowRange'DeclRef()

. found [String]
for ref in member-refs(receiver, added)
    . owner = program.modules[ref.module]
    do match? owner.decls[ref.decl]
        | .decl-function(fn)
            . open = keeps(caller, ref.module, fn.access, kept)
            . wanted = fn.name == name && fn.kind == .function-decl
            if wanted && open && found.length < 3
                found += signature(owner, fn)
= found

────────────────────
_ do member-refs [DeclRef]
    - receiver TypeId
    - added RowRange'DeclRef

. refs [DeclRef]
. current = receiver
. depth = 0
while settled(current) && depth < 16
    do match? types.rows[current]
        | .type-class(row)
            . owner = program.modules[row.module]
            do match? owner.decls[row.decl]
                | .decl-class(class)
                    for offset in 0 .. < class.members.count
                        refs += DeclRef(row.module, owner.member-pool[class.members.start + offset])
    current = types.completion-of(current).base
    depth += 1
refs ++= facts.diagnostic-members[added.start .. < added.end]
= refs

────────────────────
_ do is-of-class Bool
    - receiver TypeId
    - module ModuleId
    - decl DeclId

` Whether a type is a class a module declares, or a class below it.
. current = receiver
. depth = 0
while settled(current) && depth < 16
    do match? types.rows[current]
        | .type-class(row)
            =? true if row.module == module && row.decl == decl
    current = types.completion-of(current).base
    depth += 1
= false

────────────────────
_ class-declares Bool
    - type TypeId
    - name Atom

settled(type) && (types.property-named(type, name) != null || visible + hidden + shared != 0)

.. visible = member-signatures(0, type, name, null).length
.. hidden = member-signatures(0, type, name, Access.private-access).length
.. shared = member-signatures(0, type, name, Access.family-access).length

────────────────────
_ do signature String
    - owner Module
    - fn FunctionDecl
    - named String? = null
    - labeled Bool = true

` A function as a call of it is written, with each parameter's name and type, or with its type
` alone where the names are not `labeled`, as a C function's are not.
. tree = owner.tree
. written [String]
for offset in 0 .. < fn.args.count
    . shape = owner.arg-pool[fn.args.start + offset]
    . label = if labeled && shape.name then shape.name.text else ""
    . typed = if shape.type-syntax != 0 then written-type(tree, shape.type-syntax) else ""
    written += "$label $typed".trim()
. name = named ?? (if fn.name then fn.name.text else "?")
. params = if written.length != 0 then "(${", ".join(written)})" else ""
= "\"$name$params\""

────────────────────
_ do visible-facet U32?
    - caller ModuleId
    - name Atom

` The facet a name names where the caller sees it, and sees no class of the name.
=? null if visible-type(caller, name)
for candidate in program.lookup(caller, name)
    do match? program.modules[candidate.module].decls[candidate.decl]
        | .decl-extension(row)
            if row.facet == name
                = program.facets.index-of(candidate.module, candidate.decl)
= null

────────────────────
_ do visible-type Bool
    - caller ModuleId
    - name Atom

for candidate in program.lookup(caller, name)
    do match? program.modules[candidate.module].decls[candidate.decl]
        | .decl-class
            = true
= false

────────────────────
_ do absent-hint String?
    - caller ModuleId
    - name Atom
    - wants-type Bool

. importer = program.modules[caller].name
for absent in program.absent-imports
    if absent.module == importer && index.file-declares(absent.path, name.text, wants-type)
        . file = (last(absent.path.split("/"))) ?? absent.path
        = "it is only defined in $file, which isn't part of ${program.target.name} builds"
= null

────────────────────
_ do unimported-hint String?
    - caller ModuleId
    - name Atom
    - wants-type Bool

. places [String]
for candidate in program.unseen-declarations(caller, name)
    . owner = program.modules[candidate.module]
    if owner.name.ends-with(".h") || !declares-public(owner, candidate.decl, wants-type)
        continue
    . line = import-line(caller, owner)
    if places.find(line) == null
        places += line
if places.length == 0
    for line in index.modules-declaring(name.text, wants-type)
        if places.length < 3
            places += line
=? null if places.length == 0
. missing = "which this module does not import"
if places.length == 1
    = "it is declared in ${places[0]}, $missing. Add the import ${places[0]}"
= "it is declared in ${" and ".join(places)}, $missing. Import one of them"

────────────────────
_ declares-public Bool
    - owner Module
    - decl DeclId
    - wants-type Bool

match owner.decls[decl]
    | .decl-class(class)
        wants-type && is-public(class.access)
    | .decl-unit
        wants-type
    | .decl-function(fn)
        !wants-type && fn.owner == 0 && fn.kind == .function-decl && is-public(fn.access)
    | .decl-property(property)
        !wants-type && property.owner == 0 && is-public(property.access)
    ??
        false

────────────────────
_ do import-line String
    - caller ModuleId
    - owner Module

. whole = absolute-parts(owner.path)
for root in index.roots
    . base = root as String
    =? "/${collapsed(owner.name)}" if starts-with-parts(whole, absolute-parts(base))
=? "/${collapsed(owner.name)}" if index.roots.length == 0
. origin = program.modules[caller].path
. directory = absolute-parts(origin)
if origin.length != 0
    directory.pop()
. shared = 0
while shared < directory.length && shared < whole.length && directory[shared] == whole[shared]
    shared += 1
. parts [String]
for _ in shared .. < directory.length
    parts += ".."
for part in whole[shared ...]
    parts += part
. written = "/".join(parts)
. stem = source-stem(written) ?? written
= collapsed(if stem.starts-with("..") then stem else "./$stem")

────────────────────
_ do absolute-parts [String]
    - path String

. whole = if path.starts-with("/") then path else "${cwd()}/$path"
. parts [String]
for part in whole.split("/")
    if part == ".."
        if parts.length != 0
            parts.pop()
    else if part.length != 0 && part != "."
        parts += part
= parts

────────────────────
_ starts-with-parts Bool
    - whole [String]
    - prefix [String]

prefix.length < whole.length && whole[0 .. < prefix.length] == prefix

────────────────────
_ collapsed String
    - name String

if slash && head.ends-with(tail) && (head == tail || head.ends-with("/$tail")) then head else name

.. slash = name.find-reverse("/")
.. head = name[0 .. < slash]
.. tail = name[slash + 1 ...]

────────────────────
_ do optional-inner TypeId
    - type TypeId

if !settled(type) || types.completion-of(type).intrinsic != .optional
    = no-type
do match? types.rows[type]
    | .type-class(row)
        = types.child-type(row.args, 0)
= no-type

────────────────────
_ known Bool
    - type TypeId

type != no-type && type != invalid-type

────────────────────
_ settled Bool
    - type TypeId

known(type) && types.completions[type].completion == .completion-done

────────────────────
_ written-name String?
    - tree AST
    - id SyntaxId

match? tree.nodes[id]
    | .node-identifier(row)
        row.name.text
    | .node-ref-identifier(row)
        row.name.text
    | .node-type-identifier(row)
        row.name.text
    | .node-type-arguments(row)
        written-name(tree, row.base)
    | .node-type-capture(row)
        written-name(tree, row.id)
    | .node-get-expression(row)
        row.name.text

────────────────────
_ do node-text String
    - tree AST
    - id SyntaxId

. loc = tree.nodes.loc[id]
. line = source-line(tree.source, loc.begin.line)
. start = loc.begin.column as Index
=? "" if start >= line.length
. end = line.length
if loc.end.line == loc.begin.line && loc.end.column < line.length
    end = loc.end.column + 1
= line[start .. < end].trim()

────────────────────
_ is-name-char Bool
    - char Char

letter || (char >= '0' && char <= '9') || char == '-' || char == '_'

.. letter = (char >= 'a' && char <= 'z') || (char >= 'A' && char <= 'Z')

────────────────────
_ do source-line String
    - source String
    - line U32

. current = 0u32
. text = ""
for char in source
    if char == '\n'
        if current == line
            = text
        current += 1
    else if current == line
        text += char
= text

────────────────────
_ do member-names [String]
    - caller ModuleId
    - receiver TypeId

. found [String]
. current = receiver
. depth = 0
while settled(current) && depth < 16
    do match? types.rows[current]
        | .type-class(row)
            . owner = program.modules[row.module]
            do match? owner.decls[row.decl]
                | .decl-class(class)
                    collect-members(owner, class.members, found)
            for extension in program.extensions-for(caller, row.module, row.decl)
                . extender = program.modules[extension.module]
                do match? extender.decls[extension.decl]
                    | .decl-extension(extended)
                        collect-members(extender, extended.members, found)
    current = types.completion-of(current).base
    depth += 1
= found

────────────────────
_ do collect-members
    - owner Module
    - members RowRange'DeclId
    - found [String]

for offset in 0 .. < members.count
    . member = owner.member-pool[members.start + offset]
    . name = match? owner.decls[member]
        | .decl-function(fn)
            fn.name if fn.kind == .function-decl || fn.kind == .getter-decl
        | .decl-property(property)
            property.name
    if name && found.find(name.text) == null
        found += name.text

────────────────────
_ do local-names [String]
    - module ModuleId
    - syntax SyntaxId

. found [String]
for binding in bindings.bindings
    . start = binding.subtree.start
    if binding.module == module && syntax >= start && syntax < start + binding.subtree.count
        for slot in bindings.slots[binding.slots]
            . text = slot.name.text
            if is-named-slot(slot.kind) && text.length != 0 && found.find(text) == null
                found += text
= found

────────────────────
_ is-named-slot Bool
    - kind SlotKind

match kind
    |= .slot-local
        true
    |= .slot-argument
        true
    |= .slot-lazy
        true
    |= .slot-pattern
        true
    |= .slot-loop-item
        true
    ??
        false

────────────────────
_ visible-name-texts [String]
    - caller ModuleId
    - wants-type Bool

List
    ** program.visible-names(caller)
    *> each.text
    ?> each.length != 0 && is-type-name(each) == wants-type

────────────────────
_ is-type-name Bool
    - name String

name[0 .. < 1] >= "A" && name[0 .. < 1] <= "Z"

────────────────────
_ do suggested String
    - name String
    - candidates [String]

. folded-name = folded(name)
. limit = if name.length <= 2 then 0 else if name.length <= 4 then 1 else if name.length <= 8 then 2 else 3
. best [String]
. best-distance = limit + 1
for candidate in candidates
    if candidate == name
        continue
    . gap = if folded(candidate) == folded-name then 0 else distance(folded-name, folded(candidate))
    if gap > limit
        continue
    if gap < best-distance
        best-distance = gap
        best = [candidate]
    else if gap == best-distance && best.find(candidate) == null
        best += candidate
if best.length == 0
    = ""
. ordered [String] = sort(best)
. quoted [String]
for candidate in ordered
    if quoted.length < 3
        quoted += "\"$candidate\""
if quoted.length == 1
    = "; did you mean ${quoted[0]}?"
= "; did you mean ${", ".join(quoted[0 .. < quoted.length - 1])} or ${quoted[quoted.length - 1]}?"

────────────────────
_ do folded String
    - name String

. text = ""
for char in name
    if char != '-' && char != '_'
        text += char.lowercase
= text

────────────────────
_ do distance Index
    - left String
    - right String

. a [Char]
for char in left
    a += char
. b [Char]
for char in right
    b += char
. prior [Index]
for column in 0 .. b.length
    prior += column
for row in 0 .. < a.length
    . current [Index]
    current += row + 1
    for column in 0 .. < b.length
        . cost = if a[row] == b[column] then 0 else 1
        . step = prior[column] + cost
        . shift = current[column] + 1
        . drop = prior[column + 1] + 1
        current += if step <= shift && step <= drop then step else cheaper
            .. cheaper = if shift <= drop then shift else drop
    prior = current
= prior[b.length]

━━━━━━━━━━━━━━━━━━━━
+ DeclarationIndex

+ roots [Path]
+ target Target
_ types [String = [String]]
_ values [String = [String]]
_ built Bool

────────────────────
+ This
    - roots [Path]
    - target Target

────────────────────
+ do modules-declaring [String]
    - name String
    - wants-type Bool

if !built
    built = true
    for root in roots
        scan(root, "")
. none [String]
= (if wants-type then types[name] ?? values[name] else values[name]) ?? none

────────────────────
+ do file-declares Bool
    - path String
    - name String
    - wants-type Bool

. file-types [String = [String]]
. file-values [String = [String]]
read-module(Path(path), path, file-types, file-values)
= (if wants-type then file-types else file-values)[name] != null

────────────────────
_ do scan
    - directory Path
    - prefix String

. listed = catch? entries-of(directory)
if !listed
    =
for entry in listed
    if entry.name.starts-with("_") || entry.name.starts-with(".")
        continue
    if entry.kind == PathKind.directory
        if skipped-directory(entry.name)
            continue
        scan(directory / entry.name, "$prefix${entry.name}/")
    else if source-stem(entry.name) && target.includes(platform-suffix(entry.name))
        read-module
            - directory / entry.name
            - import-name(prefix, source-stem(entry.name)!)
            - types
            - values

────────────────────
_ skipped-directory Bool
    - name String

name == "tests" || name == "stress" || name == "fixtures" || name == "bench" || name == "lang"

────────────────────
_ import-name String
    - prefix String
    - stem String

|? prefix.length != 0 && prefix == "$stem/"
    "/$stem"
|? prefix.ends-with("/$stem/")
    "/${prefix[0 .. < prefix.length - 1]}"
??
    "/$prefix$stem"

────────────────────
_ do read-module
    - path Path
    - line String
    - type-table [String = [String]]
    - value-table [String = [String]]

. text = catch? read-file-text(path)
if !text
    =
if (path as String).ends-with(brix-extension)
    read-brix-module(text, line, type-table, value-table)
    =
. after-divider = false
for row in text.split("\n")
    if row.starts-with("━")
        after-divider = true
        continue
    if row.length == 0
        continue
    if row.starts-with("+ ")
        . name = declared-name(row)
        if name.length != 0
            . upper = name[0 .. < 1] >= "A" && name[0 .. < 1] <= "Z"
            if upper && !row.starts-with("+ This") && (after-divider || row.find(" is ") != null)
                add(type-table, name, line)
            else if !upper && after-divider
                add(value-table, name, line)
    after-divider = false

────────────────────
_ do read-brix-module
    - text String
    - line String
    - type-table [String = [String]]
    - value-table [String = [String]]

for row in text.split("\n")
    for head in ["type", "type-line"]
        . name = brix-declared-name(row, head)
        if name.length != 0
            add(type-table, name, line)
    for head in ["fn-do", "fn-expr"]
        . name = brix-declared-name(row, head)
        if name.length != 0
            add(value-table, name, line)

────────────────────
_ brix-declared-name String
    - row String
    - head String

if row.starts-with(lead) then leading-name(declared) else ""

.. lead = "($head + "
.. rest = row[lead.length ...]
.. declared = if rest.starts-with("(of ") then rest[4 ...] else rest

────────────────────
_ do add
    - table [String = [String]]
    - name String
    - line String

. held = table[name]
if !held
    table[name] = [line]
else if held.find(line) == null
    table[name] = held ++ [line]

────────────────────
_ do declared-name String
    - row String

. rest = row[2 ...]
for word in ["do ", "get ", "set "]
    if rest.starts-with(word)
        rest = rest[word.length ...]
= leading-name(rest)

────────────────────
_ do leading-name String
    - text String

. name = ""
for char in text
    . letter = (char >= 'a' && char <= 'z') || (char >= 'A' && char <= 'Z')
    if letter || (char >= '0' && char <= '9') || char == '-'
        name += char
    else
        break
= name

━━━━━━━━━━━━━━━━━━━━
_ entries-of [PathEntry] ?! Error
    - directory Path

List(directory.entries)
