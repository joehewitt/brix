(import /lang/ast/ast)
(import /lang/ast/module)
(import /lang/ast/program)
(import /lang/target)
(import /lang/ubrix/excerpt)

(type + ExcerptSources
  (prop _ program Program)
  (prop _ documents (map ModuleId UBrixExcerpts))
  (fn-do + This _
    (param program _)
  )
  (fn-expr + begin-using _
    this
  )
  (fn-do + end-using _
    (for (in (tuple _ excerpts) documents)
      (call (. excerpts end-using))
    )
  )
  (fn-do + excerpt String
    (param module ModuleId)
    (param loc MatchLocation)
    (param inset U32 (= 0))
    (param span U32 (= 0))
    (let found (call shown module loc))
    (return-if (str "    " (. found text) "\n" (* " " (+ 4 (. found start))) (* "^" (. found width))) (if found))
    (blank)
    (let text (call source-line (. ([] (. program modules) module) tree source) (. loc begin line)))
    (let start (+ (. loc begin column) inset))
    (let width 1)
    (if (!= span 0)
      (= width span)
      (else-if (> (. loc end line) (. loc begin line))
        (= width (if-expr (> (. text length) start) (- (. text length) start 1) 0))
      )
      (else-if (>= (+ (. loc end column) 1) start)
        (= width (- (+ (. loc end column) 1) start))
      )
    )
    (return (str "    " text "\n" (* " " (+ 4 start)) (* "^" width)))
  )
  (fn-do + line String
    (param module ModuleId)
    (param loc MatchLocation)
    (let found (call shown module loc))
    (return-if (str "    " (. found text)) (if found))
    (return (str "    " (call source-line (. ([] (. program modules) module) tree source) (. loc begin line))))
  )
  (fn-do _ shown (? UBrixExcerpt)
    (param module ModuleId)
    (param loc MatchLocation)
    (let tree (. ([] (. program modules) module) tree))
    (return-if null (if (or (not (. program shows-ubrix)) (not (call (. tree source-path ends-with) brix-extension)))))
    (return-if null (if (and (== (. loc begin line) 0) (== (. loc begin column) 0) (== (. loc end line) 0) (== (. loc end column) 0))))
    (blank)
    (let held ([] documents module))
    (return-if (call (. held at) loc) (if held))
    (blank)
    (let made (call UBrixExcerpts (. tree source)))
    (= ([] documents module) made)
    (return (call (. made at) loc))
  )
)
