(import ./facts-text)
(import ./header)
(import /core/table)
(import /lang/ast/ast)
(import /lang/ast/ast-nodes)
(import /lang/ast/decl)
(import /lang/ast/module)
(import /lang/ast/program)
(import /lang/check/call-paths)
(import /lang/check/facts)
(import /lang/check/instances)
(import /lang/check/session)
(import /lang/check/type-text)
(import /lang/check/types)
(import /lang/ubrix/convert)
(import /os/path)
(blank)
(prop + explain-label-width Size (= 9))

(type + ExplainError (is Error)
  (fn-do + This _
    (param message String)
  )
)

(fn-do + explained-function DeclRef (?! ExplainError)
  (param program Program)
  (param root ModuleId)
  (param asked String)
  (let parts (list String) (call (. asked split) ":"))
  (let found (list DeclRef))
  (let number (only-if (call line-number ([] parts (- (. parts length) 1))) (if (== (. parts length) 2))))
  (if number
    (let held (call module-at program ([] parts 0)))
    (throw (call ExplainError (str "No module of the program is at " ([] parts 0))) (if (not held)))
    (blank)
    (let at (call function-at-line program held (- number 1)))
    (throw (call ExplainError (str "No function is written at " asked)) (if (not at)))
    (return at)
  )
  (if (== (. parts length) 2)
    (let place ([] parts 0))
    (for (in position (..< 0 (. program modules length)))
      (let path (. ([] (. program modules) position) path))
      (if (or (== path place) (call (. path ends-with) (str "/" place)))
        (++= found (call named-functions program (as position ModuleId) ([] parts 1)))
      )
    )
    (throw (call ExplainError (str "No module at " place " declares a function named " ([] parts 1))) (if (== (. found length) 0)))
    (else
      (for (in position (..< 0 (. program modules length)))
        (++= found (call named-functions program (as position ModuleId) asked))
      )
      (let local (list DeclRef))
      (for (in each found)
        (if (== (. each module) root)
          (+= local each)
        )
      )
      (if (!= (. local length) 0)
        (= found local)
      )
      (if (== (. found length) 0)
        (++= found (call named-methods program root asked))
      )
      (if (== (. found length) 0)
        (for (in position (..< 0 (. program modules length)))
          (++= found (call named-methods program (as position ModuleId) asked))
        )
      )
      (throw (call ExplainError (str "No function is named " asked)) (if (== (. found length) 0)))
    )
  )
  (return-if ([] found 0) (if (== (. found length) 1)))
  (blank)
  (let places (call (of List String) (in (str "  " (call declared-at program each)) found)))
  (throw
    (call ExplainError
      (block
        (arg
          (paragraph
            (str asked " names " (. found length) " functions; ask for one by its file and line:")
            (str (call (. "\n" join) places))
          )
        )
      )
    )
  )
)

(fn-do + function-at-line (? DeclRef)
  (param program Program)
  (param module ModuleId)
  (param line U32)
  (let holder ([] (. program modules) module))
  (let tree (. holder tree))
  (let best (? DeclRef) null)
  (let best-line 0u32)
  (for (in index (..< 0 (. holder decls length)))
    (match? ([] (. holder decls) index)
      (case (call .decl-function fn)
        (if (and (call is-explained fn) (not (call is-unlocated ([] (. tree nodes loc) (. fn syntax)))))
          (let first (. ([] (. tree nodes loc) (. fn syntax)) begin line))
          (let last (call last-line tree fn))
          (if (and (<= first line) (<= line last) (or (not best) (>= first best-line)))
            (= best (call DeclRef module (as index DeclId)))
            (= best-line first)
          )
        )
      )
    )
  )
  (return best)
)

(fn-do + explain-function String
  (param session Session)
  (param root ModuleId)
  (param ref DeclRef)
  (param text String)
  (return (call (. (call ExplainReport session root ref text) text)))
)

(type + ExplainNote (is Tuple)
  (prop + kind String)
  (prop + label String)
  (prop + text String)
)

(fn-do + explain-notes (list ExplainNote)
  (param session Session)
  (param root ModuleId)
  (param ref DeclRef)
  (param copies (list InstanceId))
  (return (call (. (call ExplainReport session root ref "") notes) copies))
)

(fn-do + module-at (? ModuleId)
  (param program Program)
  (param place String)
  (let bare (if-expr (call (. place starts-with) "./") ([] place (... 2)) place))
  (for (in position (..< 0 (. program modules length)))
    (let path (. ([] (. program modules) position) path))
    (return-if (as position ModuleId) (if (or (== path bare) (call (. path ends-with) (str "/" bare)))))
  )
  (return null)
)

(fn-do _ line-number (? U32)
  (param text String)
  (return-if null (if (== (. text length) 0)))
  (blank)
  (let value 0u32)
  (for (in position (..< 0 (. text length)))
    (let digit (call (. "0123456789" find) ([] text (..< position (+ position 1)))))
    (return-if null (if (== digit null)))
    (blank)
    (= value (+ (* value 10) (as digit U32)))
  )
  (return-if null (if (== value 0)))
  (return value)
)

(fn-do _ named-functions (list DeclRef)
  (param program Program)
  (param module ModuleId)
  (param asked String)
  (let found (list DeclRef))
  (let parts (list String) (call (. asked split) "."))
  (let decls (. ([] (. program modules) module) decls))
  (if (== (. parts length) 2)
    (for (in index (..< 0 (. decls length)))
      (match? ([] decls index)
        (case (call .decl-function fn)
          (if (and (call is-explained fn) (!= (. fn owner) 0) (== (call class-named decls (. fn owner)) ([] parts 0)))
            (if (or (== (call function-text fn) ([] parts 1)) (and (== (. fn kind) .constructor-decl) (== ([] parts 1) "This")))
              (+= found (call DeclRef module (as index DeclId)))
            )
          )
        )
      )
    )
    (return found)
  )
  (for (in index (..< 0 (. decls length)))
    (match? ([] decls index)
      (case (call .decl-function fn)
        (if (and (call is-explained fn) (== (. fn owner) 0) (== (call function-text fn) asked))
          (+= found (call DeclRef module (as index DeclId)))
        )
      )
    )
  )
  (return found)
)

(fn-do _ named-methods (list DeclRef)
  (param program Program)
  (param module ModuleId)
  (param asked String)
  (let found (list DeclRef))
  (let decls (. ([] (. program modules) module) decls))
  (for (in index (..< 0 (. decls length)))
    (match? ([] decls index)
      (case (call .decl-function fn)
        (if (and (call is-explained fn) (!= (. fn owner) 0) (== (call function-text fn) asked))
          (+= found (call DeclRef module (as index DeclId)))
        )
      )
    )
  )
  (return found)
)

(fn-expr _ is-explained Bool
  (param fn FunctionDecl)
  (and (not (. fn is-generated)) (or (!= (. fn name) null) (== (. fn kind) .constructor-decl)))
)

(fn-expr _ function-text String
  (param fn FunctionDecl)
  (if-expr name (. name text) "")
  (where
    (lazy name (. fn name))
  )
)

(fn-expr _ class-named String
  (param decls (of ImmutableTable Decl))
  (param owner DeclId)
  (match ([] decls owner)
    (case (call .decl-class owned)
      (. owned name text)
    )
    (default
      ""
    )
  )
)

(fn-do _ last-line U32
  (param tree AST)
  (param fn FunctionDecl)
  (let last (. ([] (. tree nodes loc) (. fn syntax)) end line))
  (for (in offset (..< 0 (. fn subtree count)))
    (let loc ([] (. tree nodes loc) (+ (. fn subtree start) offset)))
    (if (and (not (call is-unlocated loc)) (> (. loc end line) last))
      (= last (. loc end line))
    )
  )
  (return last)
)

(fn-do _ declared-at String
  (param program Program)
  (param ref DeclRef)
  (let holder ([] (. program modules) (. ref module)))
  (return (str (. holder path) ":" (+ (. ([] (. holder tree nodes loc) ([] (. holder decls syntax) (. ref decl))) begin line) 1)))
)

(type _ ExplainLine (is Tuple)
  (prop + label String)
  (prop + item String)
  (prop + path String)
)

(type _ ExplainReport
  (prop + session Session)
  (prop + root ModuleId)
  (prop + ref DeclRef)
  (prop + source String)
  (blank)
  (prop _ copies (list InstanceId))
  (prop _ lines (list ExplainLine))
  (prop _ paths CallPaths)
  (fn-do + This _
    (param session _)
    (param root _)
    (param ref _)
    (param source _)
    (lazy paths (call CallPaths session))
  )
  (fn-do + text String
    (let instances (. session instances))
    (for (in position (..< 0 (. instances length)))
      (let row ([] (. instances rows) position))
      (let id (as position InstanceId))
      (if (and (== (. row module) (. ref module)) (== (. row decl) (. ref decl)) (!= id (. instances dead)) (== (. row probe) 0))
        (+= copies id)
      )
    )
    (let head (call header))
    (if (== (. copies length) 0)
      (return (str head "\n\nThe compiler typed no copy of this function: nothing it typed calls it."))
    )
    (let chosen (call default-copy))
    (call raises chosen)
    (call needs chosen)
    (call holds chosen)
    (call copied chosen)
    (let filled (call inferred-header session (. ref module) (. ref decl) copies))
    (let differs (only-if (. filled differs) (if filled)))
    (if differs
      (+= lines (call ExplainLine "differs" differs ""))
    )
    (return-if head (if (== (. lines length) 0)))
    (return (str head "\n\n" (call (. "\n" join) (call shown-lines))))
  )
  (fn-do + notes (list ExplainNote)
    (param found (list InstanceId))
    (let notes (list ExplainNote))
    (= copies found)
    (return-if notes (if (== (. copies length) 0)))
    (blank)
    (let chosen (call default-copy))
    (call needs chosen)
    (call holds chosen)
    (call copied chosen)
    (let filled (call inferred-header session (. ref module) (. ref decl) copies))
    (let differs (only-if (. filled differs) (if filled)))
    (if differs
      (+= lines (call ExplainLine "differs" differs ""))
    )
    (for (in line lines)
      (let label
        (match (. line label)
          (case= "differs"
            "differs"
          )
          (case= "copies"
            (str "copy " (. line item))
          )
          (default
            (str (. line label) " " (. line item))
          )
        )
      )
      (let lead (++ (. line label) (* " " (- explain-label-width (. line label length)))))
      (let text
        (match (. line path length)
          (case= 0
            (str lead (. line item))
          )
          (default
            (str lead (. line item) "  " (. line path))
          )
        )
      )
      (+= notes (call ExplainNote (. line label) label text))
    )
    (return notes)
  )
  (fn-do _ default-copy InstanceId
    (for (in copy copies)
      (return-if copy (if (== (. ([] (. session instances rows) copy) effects) 0)))
    )
    (return ([] copies 0))
  )
  (fn-do _ header String
    (let holder ([] (. session program modules) (. ref module)))
    (let fn (call function))
    (let first (as (. ([] (. holder tree nodes loc) (. fn syntax)) begin line) Size))
    (let all (list String) (call (. source split) "\n"))
    (return-if "" (if (>= first (. all length))))
    (blank)
    (let last first)
    (while (and (< (+ last 1) (. all length)) (call is-header-row ([] all (+ last 1))))
      (+= last 1)
    )
    (let shown (call ubrix-lines (call (of List String) ([] all (.. first last)))))
    (return-if (call (. "\n" join) shown) (if (== (. copies length) 0)))
    (blank)
    (let filled (call inferred-header session (. ref module) (. ref decl) copies))
    (return-if (call (. "\n" join) shown) (if (not filled)))
    (blank)
    (let parts (list String))
    (let returns (. filled returns))
    (if returns
      (+= parts returns)
    )
    (if (!= (. filled errors length) 0)
      (+= parts (str "?! " (call (. " | " join) (. filled errors))))
    )
    (if (and (!= (. parts length) 0) (!= (. shown length) 0))
      (= ([] shown 0) (str ([] shown 0) " " (call (. " " join) parts)))
    )
    (for (in param (. filled params))
      (let at (as (. ([] (. holder tree nodes loc) (. param syntax)) begin line) Size))
      (if (and (>= at first) (< (- at first) (. shown length)))
        (= ([] shown (- at first)) (str ([] shown (- at first)) " " (. param type)))
      )
    )
    (return (call (. "\n" join) shown))
  )
  (fn-do _ ubrix-lines (list String)
    (param written (list String))
    (let converted (catch? (call brix-to-ubrix (str (call (. "\n" join) written) "\n)"))))
    (return-if written (if (not converted)))
    (blank)
    (let found (list String))
    (for (in line (call (. converted split) "\n"))
      (if (and (!= (. (call (. line trim)) length) 0) (not (call (. line starts-with) "━")))
        (+= found (call trailing-trimmed line))
      )
    )
    (return found)
  )
  (fn-do _ function FunctionDecl
    (match? ([] (. ([] (. session program modules) (. ref module)) decls) (. ref decl))
      (case (call .decl-function fn)
        (return fn)
      )
    )
    (throw (call Panic "An explained declaration is a function"))
  )
  (fn-do _ raises _
    (param chosen InstanceId)
    (let instances (. session instances))
    (return-if (if (not (call (. instances errors-known) chosen))))
    (blank)
    (for (in position (..< 0 (. ([] (. instances signatures) chosen) errors count)))
      (let error (call (. instances error-type) chosen position))
      (+= lines (call ExplainLine "raises" (call type-source (. session types) error) (call raise-path chosen error)))
    )
  )
  (fn-do _ raise-path String
    (param start InstanceId)
    (param error TypeId)
    (let found
      (call (. paths chain-from)
        (block
          (arg start)
          (arg (=> ((: edge CallEdge)) (call passes-error edge error)))
          (arg (=> ((: instance InstanceId)) (!= (call raise-site instance error) null)))
        )
      )
    )
    (if found
      (let end (if-expr (== (. found length) 0) start (. ([] found (- (. found length) 1)) callee)))
      (return (str (call path-text found) (!! (call raise-site end error))))
    )
    (let through
      (call (. paths chain-from)
        (block
          (arg start)
          (arg (=> ((: edge CallEdge)) (call passes-error edge error)))
          (arg (=> ((: instance InstanceId)) (!= (call value-call instance) 0)))
        )
      )
    )
    (if through
      (let end (if-expr (== (. through length) 0) start (. ([] through (- (. through length) 1)) callee)))
      (return (str (call path-text through) "a call of a function value, at " (call place end (call value-call end))))
    )
    (return "no raise found")
  )
  (fn-do _ passes-error Bool
    (param edge CallEdge)
    (param error TypeId)
    (let facts (. session facts))
    (match (. edge kind)
      (case= .edge-call
        (return (and (. ([] (. facts calls) (. edge fact)) propagates) (call raises-error (. edge callee) error)))
      )
      (case= .edge-convert
        (return (and (== (. ([] (. facts conversions) (. edge fact)) raise) .raise-leaves) (call raises-error (. edge callee) error)))
      )
      (default
        (return false)
      )
    )
    (return false)
  )
  (fn-do _ value-call SyntaxId
    (param instance InstanceId)
    ; A call of a function value an instance makes that passes on what it raises, or none.
    (let facts (. session facts))
    (for (in call (call (. facts instance-calls) instance))
      (let fact ([] (. facts calls) call))
      (return-if (. fact syntax) (if (and (. fact propagates) (== (. fact form) .call-closure) (== (. fact callee) no-instance))))
    )
    (return 0)
  )
  (fn-do _ raise-site (? String)
    (param instance InstanceId)
    (param error TypeId)
    (let facts (. session facts))
    (for (in transform (. facts transforms))
      (if (and (== (. transform instance) instance) (== (. transform raised) error))
        (return (str "at " (call place instance (. transform site))))
      )
    )
    (let row ([] (. session instances rows) instance))
    (let tree (. ([] (. session program modules) (. row module)) tree))
    (for (in offset (..< 0 (. row subtree count)))
      (let syntax (as (+ (. row subtree start) offset) SyntaxId))
      (if (== (call (. facts plan-of) instance syntax) .plan-raise)
        (let exception (call raised-expression tree syntax))
        (if (and (!= exception 0) (== (call (. facts node-type) instance exception) error))
          (return (str "at " (call place instance syntax)))
        )
      )
    )
    (return null)
  )
  (fn-do _ raises-error Bool
    (param instance InstanceId)
    (param error TypeId)
    (let instances (. session instances))
    (for (in position (..< 0 (. ([] (. instances signatures) instance) errors count)))
      (return-if true (if (== (call (. instances error-type) instance position) error)))
    )
    (return false)
  )
  (fn-do _ needs _
    (param chosen InstanceId)
    (for (in need (. session facts stack-needs))
      (if (== (. need instance) chosen)
        (+= lines
          (call ExplainLine
            (block
              (arg "needs")
              (arg (call global-name (. need module) (. need decl)))
              (arg (call read-path chosen (. need module) (. need decl)))
            )
          )
        )
      )
    )
  )
  (fn-do _ holds _
    (param chosen InstanceId)
    (for (in hold (. session facts stack-holds))
      (if (== (. hold instance) chosen)
        (+= lines
          (call ExplainLine
            (block
              (arg "holds")
              (arg (call global-name (. hold module) (. hold decl)))
              (arg (call read-path chosen (. hold module) (. hold decl)))
            )
          )
        )
      )
    )
  )
  (fn-do _ read-path String
    (param start InstanceId)
    (param module ModuleId)
    (param decl DeclId)
    (let found
      (call (. paths chain-from)
        (block
          (arg start)
          (arg (=> ((: edge CallEdge)) (and (== (. edge kind) .edge-call) (call needs-global (. edge callee) module decl))))
          (arg (=> ((: instance InstanceId)) (!= (call global-read instance module decl) 0)))
        )
      )
    )
    (return-if "no read found" (if (not found)))
    (blank)
    (let end (if-expr (== (. found length) 0) start (. ([] found (- (. found length) 1)) callee)))
    (return (str (call path-text found) "at " (call place end (call global-read end module decl))))
  )
  (fn-do _ global-read SyntaxId
    (param instance InstanceId)
    (param module ModuleId)
    (param decl DeclId)
    (for (in read (. session facts stack-reads))
      (return-if (. read syntax) (if (and (== (. read instance) instance) (== (. read module) module) (== (. read decl) decl))))
    )
    (return 0)
  )
  (fn-do _ needs-global Bool
    (param instance InstanceId)
    (param module ModuleId)
    (param decl DeclId)
    (for (in need (. session facts stack-needs))
      (return-if true (if (and (== (. need instance) instance) (== (. need module) module) (== (. need decl) decl))))
    )
    (return false)
  )
  (fn-do _ copied _
    (param chosen InstanceId)
    (let instances (. session instances))
    (let facts (. session facts))
    (for (in copy copies)
      (let effects (. ([] (. instances rows) copy) effects))
      (if (and (!= copy chosen) (!= effects 0))
        (let callers (list FactId))
        (for (in position (..< 0 (. facts calls length)))
          (if (== (. ([] (. facts calls) position) callee) copy)
            (+= callers (as position FactId))
          )
        )
        (let path (if-expr (== (. callers length) 0) "made by the compiler" (call caller-text callers)))
        (let parts (list String))
        (let restricted (call restriction-text effects (. session program effects names)))
        (if (!= (. restricted length) 0)
          (+= parts restricted)
        )
        (++= parts (call fakes-text effects))
        (+= lines (call ExplainLine "copies" (call (. ", " join) parts) path))
      )
    )
  )
  (fn-do _ fakes-text (list String)
    (param effects EffectMask)
    ; What a copy is typed with of the fakes `do with` binds: each effect with the class of its fake,
    ; or with its real doors in a fake's own methods.
    (let parts (list String))
    (let set (call swap-set-of effects))
    (return-if parts (if (== set 0)))
    (blank)
    (let instances (. session instances))
    (let names (. session program effects names))
    (let start ([] (. instances swap-set-starts) (- set 1)))
    (for (in position (..< start (+ start ([] (. instances swap-set-counts) (- set 1)))))
      (let held ([] (. instances swap-entries) (- ([] (. instances swap-set-entries) position) 1)))
      (let name (. ([] names (. held effect)) text))
      (+= parts (if-expr (== (. held fake) no-type) (str "with real " name) (str "with " name " = " (call type-short-name (. session types) (. held fake)))))
    )
    (return parts)
  )
  (fn-do _ caller-text String
    (param callers (list FactId))
    (let fact ([] (. session facts calls) ([] callers 0)))
    (let more (if-expr (> (. callers length) 1) (str " and " (- (. callers length) 1) " more") ""))
    (return (str "for " (call (. paths name-of) (. fact instance)) " at " (call place (. fact instance) (. fact syntax)) more))
  )
  (fn-do _ path-text String
    (param chain (list CallEdge))
    (return-if "" (if (== (. chain length) 0)))
    (return (str (call (. " → " join) (call (. paths names) chain)) ", "))
  )
  (fn-do _ global-name String
    (param module ModuleId)
    (param decl DeclId)
    (match? ([] (. ([] (. session program modules) module) decls) decl)
      (case (call .decl-property property)
        (let name (. property name))
        (return-if (. name text) (if name))
      )
      (case (call .decl-effect effect)
        (return (str "the fake bound to " (. effect name text)))
      )
    )
    (return "a global")
  )
  (fn-do _ place String
    (param instance InstanceId)
    (param syntax SyntaxId)
    (let holder ([] (. session program modules) (. ([] (. session instances rows) instance) module)))
    (let loc ([] (. holder tree nodes loc) syntax))
    (return (str (call shown-path (. holder path)) ":" (+ (. loc begin line) 1)))
  )
  (fn-do _ shown-path String
    (param path String)
    (let root-path (. ([] (. session program modules) root) path))
    (let slash (call (. root-path find-reverse) "/"))
    (let folder (if-expr slash ([] root-path (..< 0 slash)) ""))
    (return-if ([] path (... (+ (. folder length) 1))) (if (and (!= (. folder length) 0) (call (. path starts-with) (str folder "/")))))
    (return (. (call Path path) name))
  )
  (fn-do _ shown-lines (list String)
    (let width Size 0)
    (for (in line lines)
      (if (and (!= (. line path length) 0) (> (. line item length) width))
        (= width (. line item length))
      )
    )
    (let shown (list String))
    (let previous "")
    (for (in line lines)
      (let label (if-expr (== (. line label) previous) "" (. line label)))
      (= previous (. line label))
      (let lead (++ label (* " " (- explain-label-width (. label length)))))
      (if (== (. line path length) 0)
        (+= shown (str lead (. line item)))
        (else
          (+= shown (str lead (. line item) (* " " (- (+ width 2) (. line item length))) (. line path)))
        )
      )
    )
    (return shown)
  )
)

(fn-expr _ raised-expression SyntaxId
  (param tree AST)
  (param syntax SyntaxId)
  (match ([] (. tree nodes) syntax)
    (case (call .node-assertion-syntax row)
      (. row exception)
    )
    (case (call .node-type-transform row)
      (. row expr)
    )
    (default
      0
    )
  )
)

(fn-do _ restriction-text String
  (param effects EffectMask)
  (param names (list Atom))
  (return-if "gc-free" (if (!= (/and/ effects (. CompilationEffect gc-free)) 0)))
  (blank)
  (let parts (list String))
  (if (!= (/and/ effects (. CompilationEffect no-heap)) 0)
    (+= parts "without heap")
  )
  (if (!= (/and/ effects (. CompilationEffect no-safepoint)) 0)
    (+= parts "without safepoints")
    (else-if (!= (/and/ effects (. CompilationEffect no-suspend)) 0)
      (+= parts "without suspending")
    )
  )
  (if (!= (/and/ effects (. CompilationEffect no-probe-safepoint)) 0)
    (+= parts "without probe safepoints")
  )
  (for (in index (..< 0 (. names length)))
    (if (and (< index (call most-effects)) (!= (/and/ effects (call ban-bit (as index U32))) 0))
      (+= parts (str "without " (. ([] names index) text)))
    )
  )
  (return (call (. ", " join) parts))
)

(fn-expr _ is-header-row Bool
  (param line String)
  (call (. (call (. line trim)) starts-with) "(param ")
)

(fn-do _ trailing-trimmed String
  (param line String)
  (let end (. line length))
  (while (and (> end 0) (or (== ([] line (..< (- end 1) end)) " ") (== ([] line (..< (- end 1) end)) "\t")))
    (-= end 1)
  )
  (return ([] line (..< 0 end)))
)
