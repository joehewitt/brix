(import /lang/ast/ast)
(import /lang/ast/ast-children)
(import /lang/ast/ast-nodes)
(import /lang/ast/decl)
(import /lang/ast/module)
(import /lang/ast/operator)
(import /lang/ast/program)
(import /lang/ast/row-range)
(import /lang/check/binding)
(import /lang/check/facts)
(import /lang/check/instances)
(import /lang/check/numeric)
(import /lang/check/session)
(import /lang/check/type-store)
(import /lang/check/type-text)
(import /lang/check/types)
(import /lang/target)
(import /os/env)
(import /os/file)
(import /os/path)
(import /stream/aggregate)
(import /stream/sort)

(type + DiagnosticReport
  (prop + types Types)
  (prop + program Program)
  (prop + facts Facts)
  (prop + bindings Bindings)
  (prop + instances Instances)
  (prop + index DeclarationIndex)
  (fn-do + This _
    (param session Session)
    (param roots (list Path))
    (lazy types (. session types))
    (lazy program (. session program))
    (lazy facts (. session facts))
    (lazy bindings (. session bindings))
    (lazy instances (. session instances))
    (lazy index (call DeclarationIndex roots (. session program target)))
  )
  (fn-expr + type-message String
    (param diagnostic TypeDiagnostic)
    (param base String)
    (call sourced diagnostic message)
    (where
      (lazy message
        (match (. diagnostic kind)
          (case= .function-not-found
            (call function-message diagnostic base)
          )
          (case= .constructor-not-found
            (call constructor-message diagnostic base)
          )
          (case= .property-not-found
            (call property-message diagnostic base)
          )
          (case= .illegal-operation
            (call operation-message diagnostic base)
          )
          (case= .stated
            (call stated-message diagnostic base)
          )
          (case= .explicit-return-requires-do
            (call imperative-message diagnostic "cannot return with \"(return …)\"" base)
          )
          (case= .no-possible-matches
            (call declared-match-message diagnostic base)
          )
          (case= .illegal-cast
            (call cast-message diagnostic base)
          )
          (case= .unasked-unwrap
            (call unasked-message diagnostic base)
          )
          (case= .unasked-text
            (call unasked-message diagnostic base)
          )
          (case= .unasked-narrowing
            (call unasked-message diagnostic base)
          )
          (case= .unasked-conversion
            (call unasked-message diagnostic base)
          )
          (case= .ambiguous-extension
            (call extension-message diagnostic base)
          )
          (case= .return-after-recursion
            (call recursion-message diagnostic base)
          )
          (case= .unable-to-unify-returns
            (call unify-message diagnostic base)
          )
          (case= .circular-reference
            (call circular-message diagnostic base)
          )
          (case= .error-leaves-function
            (call leaves-message diagnostic base)
          )
          (case= .non-void-return
            (call divider-message diagnostic base)
          )
          (default
            base
          )
        )
      )
    )
  )
  (fn-do _ sourced String
    (param diagnostic TypeDiagnostic)
    (param text String)
    (let sources (map String String))
    (for (in type (call mentioned diagnostic))
      (let source (call type-source types type))
      (for (in written (list (call type-key types type) (call type-display types type) (call type-short-name types type)))
        (if (and (!= written source) (not ([] sources written)))
          (= ([] sources written) source)
        )
      )
    )
    (let order (call sort (. sources keys) (:using (=> (a b) (call compare-basic (. b length) (. a length))))))
    (return (call reduce text order (:using (=> (done written) (call replaced done written (!! ([] sources written)))))))
  )
  (fn-expr _ mentioned (list TypeId)
    (param diagnostic TypeDiagnostic)
    (call List
      (block
        (item (. diagnostic from))
        (item (. diagnostic to))
        (spread ([] (. facts diagnostic-mentions) (..< (. diagnostic mentions start) (. diagnostic mentions end))))
        (pipe ?> (call settled each))
      )
    )
  )
  (fn-do _ replaced String
    (param text String)
    (param old String)
    (param new String)
    (let result "")
    (let rest text)
    (let found (call (. rest find) old))
    (while (!= found null)
      (+= result (++ ([] rest (..< 0 found)) new))
      (= rest ([] rest (... (+ found (. old length)))))
      (= found (call (. rest find) old))
    )
    (return (++ result rest))
  )
  (fn-expr + type-site SyntaxId
    (param diagnostic TypeDiagnostic)
    (if-expr (!= stray 0) stray (. diagnostic syntax))
    (where
      (lazy stray (call divided-stray diagnostic))
    )
  )
  (fn-expr + decline-message String
    (param diagnostic TypeDiagnostic)
    (if-expr holder (call stray-message (. diagnostic module) holder (. diagnostic syntax)) "Not supported")
    (where
      (lazy holder (call stray-holder (. diagnostic module) (. diagnostic syntax)))
    )
  )
  (fn-expr + binding-message String
    (param diagnostic Diagnostic)
    (param base String)
    (match (. diagnostic kind)
      (case? (not (. diagnostic name))
        base
      )
      (case= .name-not-found
        (call name-message (. diagnostic module) (. diagnostic syntax) name)
      )
      (case= .already-defined
        (call redefined-message (. diagnostic module) (. diagnostic syntax) name)
      )
      (case= .variable-not-declared
        (call undeclared-message (. diagnostic module) (. diagnostic syntax) name)
      )
      (case= .context-not-found
        (call context-message name)
      )
      (default
        base
      )
    )
    (where
      (lazy name (. (!! (. diagnostic name)) text))
    )
  )
  (fn-expr _ context-message String
    (param name String)
    ; The error of `it` or `each` read where nothing gives it a value.
    (case? (== name "it")
      "Name \"it\" not found, as nothing here gives a subject; \"it\" reads what a match arm, a loop or a pipe is given"
    )
    (default
      "Name \"each\" not found, as nothing here gives an item; \"each\" reads the item of a stage, a loop, a callback or a trigger"
    )
  )
  (fn-expr _ stated-message String
    (param diagnostic TypeDiagnostic)
    (param base String)
    (match base
      (case= "Type not found"
        (call type-not-found-message diagnostic base)
      )
      (case= "Default value required"
        (call default-message diagnostic base)
      )
      (case= "Name not found"
        (call stated-name-message diagnostic base)
      )
      (case= "Property not found"
        (call stated-property-message diagnostic base)
      )
      (case= "Immediate declaration requires do"
        (call imperative-message diagnostic "cannot hold \"(let name value)\" declarations" base)
      )
      (case= "Loop requires do"
        (call imperative-message diagnostic "cannot hold loops" base)
      )
      (case= "Yield requires do"
        (call imperative-message diagnostic "cannot yield" base)
      )
      (case= "Assignment requires do"
        (call imperative-message
          (block
            (arg diagnostic)
            (arg "cannot hold assignments")
            (arg base)
            (arg "put the assignment in a \"do\" block")
          )
        )
      )
      (case= "If statement requires do"
        (call imperative-message
          (block
            (arg diagnostic)
            (arg "cannot hold \"if\" statements")
            (arg base)
            (arg "write a check as \"(throw error (if condition))\"")
          )
        )
      )
      (case= "Call before the value requires do"
        (call imperative-message
          (block
            (arg diagnostic)
            (arg "cannot run calls before its value")
            (arg base)
            (arg "put the call in a \"do\" block")
          )
        )
      )
      (case= "Lazy before the value requires do"
        (call imperative-message
          (block
            (arg diagnostic)
            (arg "cannot name lazies before its value")
            (arg base)
            (arg "move the lazy below the value")
          )
        )
      )
      (case= "Redefining variable in same scope"
        (call stated-redefined-message diagnostic base)
      )
      (case= "Variable not declared"
        (call stated-undeclared-message diagnostic base)
      )
      (case= (call bare-value-text)
        (call divider-message diagnostic base)
      )
      (case= "Attached catch handlers require a Result expression"
        (call catch-message diagnostic base)
      )
      (case= "Incompatible types in list"
        (call list-message diagnostic base)
      )
      (case= "Match arm gives no value"
        (call arm-step-message)
      )
      (case= "Match arm gives no value in a value body"
        (call arm-value-message)
      )
      (case= "Object is not iterable"
        (call iteration-message diagnostic base)
      )
      (case= "Redefinition of property"
        (call redefinition-message diagnostic base)
      )
      (case= "Illegal to redefine type of inherited property"
        (call override-type-message diagnostic base)
      )
      (case= "Inherited properties must have same assignment type"
        (call override-storage-message diagnostic base)
      )
      (case= "Case not found"
        (call case-message diagnostic base)
      )
      (case= "Optional chaining receiver is not optional"
        (call chaining-message diagnostic base)
      )
      (case= "Optional force operand is not optional"
        (call force-message diagnostic base)
      )
      (case= "Can't infer return type after recursion"
        (call recursion-message diagnostic base)
      )
      (case= "Type can't be null"
        (call null-message diagnostic base)
      )
      (case= "Unrecognized argument"
        (call argument-message diagnostic base)
      )
      (case= "Illegal return"
        (call return-message diagnostic base)
      )
      (case= "Illegal return from subscriber"
        (call subscriber-return-message diagnostic base)
      )
      (default
        (call prefixed-message diagnostic base)
      )
    )
  )
  (fn-expr _ prefixed-message String
    (param diagnostic TypeDiagnostic)
    (param base String)
    (case? (and (call (. base starts-with) "Function ") (call (. base ends-with) " ends with a value it does not return"))
      (str base "; return it with \"(return value)\", or remove it")
    )
    (case? (call (. base starts-with) "Function returns error (")
      (call raised-message diagnostic base)
    )
    (case? (call (. base starts-with) "Non-exhaustive match for ")
      (call coverage-message diagnostic base)
    )
    (case? (call (. base starts-with) "Event endpoints provide ")
      (call endpoint-message diagnostic)
    )
    (case? (and recursive (call (. base ends-with) ", or catch them here"))
      (call recursive-errors-message diagnostic base)
    )
    (default
      base
    )
    (where
      (lazy recursive (!= (call (. base find) " can leave recursive function ") null))
    )
  )
  (fn-do _ function-message String
    (param diagnostic TypeDiagnostic)
    (param base String)
    (let tree (. ([] (. program modules) (. diagnostic module)) tree))
    (let callable SyntaxId 0)
    (let operands (call (of RowRange SyntaxId)))
    (match? ([] (. tree nodes) (. diagnostic syntax))
      (case (call .node-call-expression row)
        (= callable (. row callable))
        (= operands (call call-operands row))
      )
    )
    (if (== callable 0)
      (return-if base (if (not (. diagnostic name))))
      (return (str "Function \"" (. diagnostic name text) "\" not found"))
    )
    (let given (call arguments-text diagnostic operands))
    (let count (call positional-count tree operands))
    (match? ([] (. tree nodes) callable)
      (case (call .node-get-expression row)
        (let object (call (. facts node-type) (. diagnostic instance) (. row object)))
        (let inner (if-expr (. row is-optional) (call optional-inner object) no-type))
        (let receiver (if-expr (!= inner no-type) inner object))
        (return
          (scope (str (call method-message (. diagnostic module) receiver (. row name) given (. diagnostic members)) gap)
            (lazy gap (call member-gap (. diagnostic module) receiver (. row name) count (. diagnostic members)))
          )
        )
      )
      (case (call .node-c-identifier row)
        (return (call c-function-message (. diagnostic module) (. row name) given))
      )
      (case (call .node-identifier row)
        (let local (call local-call-message diagnostic callable (. row name)))
        (return-if local (if local))
        (let own (call own-receiver diagnostic (. row name)))
        (return-if (str own-text own-gap) (if (!= own no-type)))
        (lazy own-text (call method-message (. diagnostic module) own (. row name) given (. diagnostic members)))
        (lazy own-gap (call member-gap (. diagnostic module) own (. row name) count (. diagnostic members)))
        (return
          (scope (str (call free-function-message (. diagnostic module) (. row name) given) identifier-gap)
            (lazy identifier-gap (call free-gap (. diagnostic module) (. row name) count))
          )
        )
      )
      (case (call .node-ref-identifier row)
        (return
          (scope (str (call free-function-message (. diagnostic module) (. row name) given) ref-gap)
            (lazy ref-gap (call free-gap (. diagnostic module) (. row name) count))
          )
        )
      )
    )
    (return-if base (if (not (. diagnostic name))))
    (return (call free-function-message (. diagnostic module) (. diagnostic name) given))
  )
  (fn-do _ positional-count (? Size)
    (param tree AST)
    (param operands (of RowRange SyntaxId))
    (let count Size 0)
    (for (in offset (..< 0 (. operands count)))
      (match? ([] (. tree nodes) ([] (. tree children) (+ (. operands start) offset)))
        (case (call .node-argument row)
          (return-if null (if (. row name)))
        )
      )
      (+= count 1)
    )
    (return count)
  )
  (fn-do _ free-gap String
    (param caller ModuleId)
    (param name Atom)
    (param count (? Size))
    (for (in candidate (call (. program lookup) caller name))
      (let owner ([] (. program modules) (. candidate module)))
      (match? ([] (. owner decls) (. candidate decl))
        (case (call .decl-function fn)
          (if (and (== (. fn owner) 0) (== (. fn kind) .function-decl))
            (let gap (call left-out owner fn count))
            (return-if gap (if (!= (. gap length) 0)))
          )
        )
      )
    )
    (return "")
  )
  (fn-do _ member-gap String
    (param caller ModuleId)
    (param receiver TypeId)
    (param name Atom)
    (param count (? Size))
    (param added (of RowRange DeclRef))
    (for (in ref (call member-refs receiver added))
      (let owner ([] (. program modules) (. ref module)))
      (match? ([] (. owner decls) (. ref decl))
        (case (call .decl-function fn)
          (if (and (== (. fn name) name) (== (. fn kind) .function-decl))
            (let gap (call left-out owner fn count))
            (return-if gap (if (!= (. gap length) 0)))
          )
        )
      )
    )
    (return "")
  )
  (fn-do _ constructor-gap String
    (param caller ModuleId)
    (param name Atom)
    (param count (? Size))
    (for (in candidate (call (. program lookup) caller name))
      (let owner ([] (. program modules) (. candidate module)))
      (match? ([] (. owner decls) (. candidate decl))
        (case (call .decl-class class)
          (for (in offset (..< 0 (. class members count)))
            (match? ([] (. owner decls) ([] (. owner member-pool) (+ (. class members start) offset)))
              (case (call .decl-function fn)
                (if (== (. fn kind) .constructor-decl)
                  (let gap (call left-out owner fn count))
                  (return-if gap (if (!= (. gap length) 0)))
                )
              )
            )
          )
        )
      )
    )
    (return "")
  )
  (fn-expr _ left-out String
    (param owner Module)
    (param fn FunctionDecl)
    (param count (? Size))
    (case? (or (not count) (>= count (. fn args count)))
      ""
    )
    (case? (or (. shape has-default) (not (call is-optional-syntax (. owner tree) (. shape type-syntax))))
      ""
    )
    (default
      (str "; \"" label "\" may be null but has no default, so a call must give it: pass null, or declare \"" label " " typed " = null\"")
    )
    (where
      (lazy shape ([] (. owner arg-pool) (+ (. fn args start) count)))
      (lazy label (if-expr (. shape name) (. shape name text) "?"))
      (lazy typed (call written-type (. owner tree) (. shape type-syntax)))
    )
  )
  (fn-expr _ is-optional-syntax Bool
    (param tree AST)
    (param id SyntaxId)
    (match ([] (. tree nodes) id)
      (case (call .node-type-arguments row)
        (and (== (. row args count) 1) (== (call written-name tree (. row base)) "Optional"))
      )
      (default
        false
      )
    )
  )
  (fn-expr _ written-type String
    (param tree AST)
    (param id SyntaxId)
    (case? (call is-optional-syntax tree id)
      (str (call written-type tree ([] (. tree children) (call optional-inner-syntax tree id))) "?")
    )
    (default
      (call spelled-type tree id)
    )
  )
  (fn-do _ spelled-type String
    (param tree AST)
    (param id SyntaxId)
    (match? ([] (. tree nodes) id)
      (case (call .node-type-identifier row)
        (return (. row name text))
      )
      (case (call .node-type-arguments row)
        (return (++ (call written-type tree (. row base)) (call type-arguments-text tree (. row args))))
      )
      (case (call .node-type-associated row)
        (return (str (call written-type tree (. row owner)) "." (. row name text) (call type-arguments-text tree (. row args))))
      )
      (case (call .node-type-list row)
        (if (== (. row patterns count) 1)
          (return (str "[" (call written-type tree ([] (. tree children) (. row patterns start))) "]"))
        )
      )
      (case (call .node-type-tuple row)
        (return (str "(" (call (. ", " join) (in (call written-type tree each) ([] (. tree children) (. row field-types)))) ")"))
      )
      (case (call .node-type-capture row)
        (let name (?? (call written-name tree (. row id)) ""))
        (return (if-expr (!= (. row type) 0) (call (. (str name " " (call written-type tree (. row type))) trim)) name))
      )
    )
    (return (call node-text tree id))
  )
  (fn-expr _ type-arguments-text String
    (param tree AST)
    (param args (of RowRange SyntaxId))
    (call (. "" join) (in (str "'" (call written-type tree each)) ([] (. tree children) args)))
  )
  (fn-expr _ optional-inner-syntax Index
    (param tree AST)
    (param id SyntaxId)
    (match ([] (. tree nodes) id)
      (case (call .node-type-arguments row)
        (. row args start)
      )
      (default
        0
      )
    )
  )
  (fn-expr _ call-operands (of RowRange SyntaxId)
    (param row ASTCallExpression)
    (call (of RowRange SyntaxId) (+ (. row operands start) (. row param-count)) (- (. row operands count) (. row param-count)))
  )
  (fn-do _ own-receiver TypeId
    (param diagnostic TypeDiagnostic)
    (param name Atom)
    ; The class whose method a call by a name alone names, where no function by that name is
    ; visible: that of the method the call is in, or of one it is written in.
    (return-if no-type (if (!= (. (call visible-signatures (. diagnostic module) name .function-decl null) length) 0)))
    (let instance (. diagnostic instance))
    (while (< instance (. instances rows length))
      (let own (. ([] (. instances rows) instance) self-type))
      (return-if own (if (and (!= own no-type) (!= matching 0))))
      (lazy matching (. (call member-signatures (. diagnostic module) own name null (. diagnostic members)) length))
      (= instance (. ([] (. instances rows) instance) enclosing))
    )
    (return no-type)
  )
  (fn-expr _ free-function-message String
    (param caller ModuleId)
    (param name Atom)
    (param given (? String))
    (case? (and (!= (. signatures length) 0) (call every-rule caller name))
      (str "\"" (. name text) "\" is a rule, which matches a stream; use it in a pattern, as in ~ \\" (. name text))
    )
    (case? (!= (. signatures length) 0)
      (str "No function \"" (. name text) "\"" (call accepting given) "; " declared)
    )
    (case? (!= (. hidden length) 0)
      (str "Function \"" (. name text) "\" is private, declared with _, so only its own module can call it")
    )
    (default
      (str "Function \"" (. name text) "\" not found" (call missing-note caller name false nearby))
    )
    (where
      (lazy signatures (call visible-signatures caller name .function-decl null))
      (lazy hidden (call visible-signatures caller name .function-decl (. Access private-access)))
      (lazy declared (str (call declared-as signatures) (call private-note hidden)))
      (lazy nearby (call visible-name-texts caller false))
    )
  )
  (fn-do _ every-rule Bool
    (param caller ModuleId)
    (param name Atom)
    ; Whether each function by a name the caller sees is a rule, whose first parameter is the
    ; stream it matches.
    (let found false)
    (for (in candidate (call (. program lookup) caller name))
      (let owner ([] (. program modules) (. candidate module)))
      (match? ([] (. owner decls) (. candidate decl))
        (case (call .decl-function fn)
          (if (and (== (. fn owner) 0) (== (. fn kind) .function-decl))
            (if (or (== (. fn args count) 0) (!= (?. (. ([] (. owner arg-pool) (. fn args start)) name) text) "(stream)"))
              (return false)
            )
            (= found true)
          )
        )
      )
    )
    (return found)
  )
  (fn-expr _ missing-note String
    (param caller ModuleId)
    (param name Atom)
    (param wants-type Bool)
    (param nearby (list String))
    (case? elsewhere
      (str "; " elsewhere)
    )
    (case? (and (not wants-type) (== (. name text) "pow"))
      "; write \"(%% a b)\" to raise a to the power b"
    )
    (default
      (call suggested (. name text) nearby)
    )
    (where
      (lazy elsewhere (?? (call absent-hint caller name wants-type) (call unimported-hint caller name wants-type)))
    )
  )
  (fn-do _ c-function-message String
    (param caller ModuleId)
    (param name Atom)
    (param given (? String))
    (let declared false)
    (let signatures (list String))
    (for (in candidate (call (. program lookup) caller name))
      (let owner ([] (. program modules) (. candidate module)))
      (if (call (. owner name ends-with) ".h")
        (= declared true)
        (match? ([] (. owner decls) (. candidate decl))
          (case (call .decl-function fn)
            (let shown (call signature owner fn (:labeled false)))
            (if (and (< (. signatures length) 3) (== (call (. signatures find) shown) null))
              (+= signatures shown)
            )
          )
        )
      )
    )
    (return-if (str "C function \"" (. name text) "\" is not declared by any header this module imports") (if (not declared)))
    (let message (str "No C function \"" (. name text) "\"" (call accepting given)))
    (return (if-expr (!= (. signatures length) 0) (str message "; " (call declared-as signatures)) message))
  )
  (fn-expr _ method-message String
    (param caller ModuleId)
    (param receiver TypeId)
    (param name Atom)
    (param given (? String))
    (param added (of RowRange DeclRef))
    (case? (or (== receiver no-type) (== receiver invalid-type))
      (str "Method \"" method "\" not found")
    )
    (case? (and (!= inner no-type) (call class-declares inner name))
      (str "Method \"" method "\" is called on " shown ", which may be null; unwrap it first with \"(!! …)\" or \"(?. …)\"")
    )
    (case? (not (call is-letter ([] method (..< 0 1))))
      (str "Operator \"" (call operator-name method) "\" is not defined for " shown)
    )
    (case? (!= (. signatures length) 0)
      (str "No method \"" method "\" of " shown (call accepting given) "; " declared)
    )
    (case? (!= (. hidden length) 0)
      (str "Method \"" method "\" of " shown " is private, declared with _, so only its own module can call it")
    )
    (case? (!= (. shared length) 0)
      (str "Method \"" method "\" of " shown " is shared, declared with ^, so only its own file family can call it")
    )
    (case? unseen
      (str shown " has no method \"" method "\" here; facet " unseen " declares it, and only the facets a facet sees are in reach. Write \"sees " unseen "\" under the facet that uses it")
    )
    (case? widening
      (str shown " has no method \"" method "\"; a facet's value has only its facet's members and those of the facets it is part of. Write \"" (call casting (?? widening "")) "\" to reach the rest of " widening)
    )
    (case? (and (== method "pow") (!= (. (call member-signatures caller receiver (call (. program store-atom) "%%") null added) length) 0))
      (str shown " has no method \"pow\"; write \"(%% a b)\" to raise a to the power b")
    )
    (default
      (str shown " has no method \"" method "\"" (call suggested method (call member-names caller receiver)))
    )
    (where
      (lazy method (. name text))
      (lazy widening (call facet-widening receiver name))
      (lazy unseen (call unseen-facet caller name receiver))
      (lazy shown (call type-source types receiver))
      (lazy inner (call optional-inner receiver))
      (lazy signatures (call member-signatures caller receiver name null added))
      (lazy hidden (call member-signatures caller receiver name (. Access private-access) added))
      (lazy shared (call member-signatures caller receiver name (. Access family-access) added))
      (lazy declared (str (call declared-as signatures) (call private-note hidden) (call family-note shared)))
    )
  )
  (fn-do _ constructor-message String
    (param diagnostic TypeDiagnostic)
    (param base String)
    (let tree (. ([] (. program modules) (. diagnostic module)) tree))
    (let head SyntaxId 0)
    (let operands (call (of RowRange SyntaxId)))
    (let called false)
    (match? ([] (. tree nodes) (. diagnostic syntax))
      (case (call .node-call-expression row)
        (= head (. row callable))
        (= operands (call call-operands row))
        (= called true)
      )
      (case .node-type-identifier
        (= head (. diagnostic syntax))
        (let call (call enclosing-call tree head))
        (match? (only-if ([] (. tree nodes) call) (if (!= call 0)))
          (case (call .node-call-expression row)
            (= operands (call call-operands row))
            (= called true)
          )
        )
      )
    )
    (let name (only-if (call written-name tree head) (if (!= head 0))))
    (if (not name)
      (return base)
    )
    (let atom (call (. program store-atom) (call own-class-name diagnostic name)))
    (let given (only-if (call arguments-text diagnostic operands) (if called)))
    (let gap
      (scope (if-expr called (call constructor-gap (. diagnostic module) atom positional) "")
        (lazy positional (call positional-count tree operands))
      )
    )
    (return (str (call named-constructor-message (. diagnostic module) atom given) gap))
  )
  (fn-do _ own-class-name String
    (param diagnostic TypeDiagnostic)
    (param name String)
    ; The name of the class `This` names where a diagnostic is: that of the method it is in, or of
    ; one that method is written in. Any other name is itself.
    (return-if name (if (!= name "This")))
    (let instance (. diagnostic instance))
    (while (< instance (. instances rows length))
      (let own (. ([] (. instances rows) instance) self-type))
      (match? (only-if ([] (. types rows) own) (if (!= own no-type)))
        (case (call .type-class row)
          (match? ([] (. ([] (. program modules) (. row module)) decls) (. row decl))
            (case (call .decl-class class)
              (return (. class name text))
            )
          )
        )
      )
      (= instance (. ([] (. instances rows) instance) enclosing))
    )
    (return name)
  )
  (fn-expr _ named-constructor-message String
    (param caller ModuleId)
    (param atom Atom)
    (param given (? String))
    (case? facet
      (str name " is a facet of " (call facet-owner-name facet) ", so it has no constructor; a " (call facet-owner-name facet) " is a " name)
    )
    (case? (not (call visible-type caller atom))
      (str "Type \"" name "\" not found" (call missing-note caller atom true (call visible-name-texts caller true)))
    )
    (case? (call is-interface caller atom)
      (str name " is an interface, so it has no constructor; construct a class that is " name)
    )
    (case? (!= (. alternatives length) 0)
      (str name " stands for any one of " (call (. " and " join) alternatives) ", so it has no constructor; give it a value of one of them, as in " name "(value)")
    )
    (case? (!= (. signatures length) 0)
      (str message "; its declared constructors are " (call (. " and " join) signatures) kept)
    )
    (case? (!= (. hidden length) 0)
      (str message "; its constructors are private, declared with _, so only its own module can call them")
    )
    (case? (!= (. shared length) 0)
      (str message "; its constructors are shared, declared with ^, so only its own file family can call them")
    )
    (default
      message
    )
    (where
      (lazy name (. atom text))
      (lazy facet (call visible-facet caller atom))
      (lazy message (str "No constructor of " name (call accepting given)))
      (lazy alternatives (call alternative-names caller atom))
      (lazy signatures (call constructor-signatures caller atom name null))
      (lazy hidden (call constructor-signatures caller atom name (. Access private-access)))
      (lazy shared (call constructor-signatures caller atom name (. Access family-access)))
      (lazy kept (str (call private-note hidden) (call family-note shared)))
    )
  )
  (fn-do _ enclosing-call SyntaxId
    (param tree AST)
    (param callable SyntaxId)
    ; The call of a callable with all its arguments: the last call node of it, since a call's bullets
    ; give it a node of its own after the one its parentheses give.
    (let found SyntaxId 0)
    (for (in position (..< 0 (. tree nodes length)))
      (match? ([] (. tree nodes) position)
        (case (call .node-call-expression row)
          (if (== (. row callable) callable)
            (= found (as position SyntaxId))
          )
        )
      )
    )
    (return found)
  )
  (fn-do _ is-interface Bool
    (param caller ModuleId)
    (param name Atom)
    (for (in candidate (call (. program lookup) caller name))
      (if (== (call class-intrinsic (. candidate module) (. candidate decl)) .interface)
        (return true)
      )
    )
    (return false)
  )
  (fn-do _ alternative-names (list String)
    (param caller ModuleId)
    (param name Atom)
    ; The types a type of alternatives a module names stands for, as its declaration writes them, or
    ; none for any other type.
    (let names (list String))
    (for (in candidate (call (. program lookup) caller name))
      (let owner ([] (. program modules) (. candidate module)))
      (match? ([] (. owner decls) (. candidate decl))
        (case (call .decl-class class)
          (for (in alternative ([] (. owner tree children) (. class or-bases)))
            (+= names (call node-text (. owner tree) alternative))
          )
          (return-if names (if (!= (. names length) 0)))
        )
      )
    )
    (return names)
  )
  (fn-do _ class-intrinsic IntrinsicKind
    (param module ModuleId)
    (param decl DeclId)
    (for (in position (..< 0 (. types rows length)))
      (match? ([] (. types rows) position)
        (case (call .type-class row)
          (if (and (== (. row module) module) (== (. row decl) decl) (call settled (as position TypeId)))
            (return (. (call (. types completion-of) (as position TypeId)) intrinsic))
          )
        )
      )
    )
    (return .none)
  )
  (fn-do _ constructor-signatures (list String)
    (param caller ModuleId)
    (param name Atom)
    (param shown String)
    (param kept (? Access))
    (let found (list String))
    (for (in candidate (call (. program lookup) caller name))
      (let owner ([] (. program modules) (. candidate module)))
      (match? ([] (. owner decls) (. candidate decl))
        (case (call .decl-class class)
          (let intrinsic (call class-intrinsic (. candidate module) (. candidate decl)))
          (for (in offset (..< 0 (. class members count)))
            (let member ([] (. owner member-pool) (+ (. class members start) offset)))
            (match? ([] (. owner decls) member)
              (case (call .decl-function fn)
                (let open (call keeps caller (. candidate module) (. fn access) kept))
                (let written (call constructor-signature owner class fn shown intrinsic))
                (if (and written open (< (. found length) 4) (not (has found written)))
                  (+= found written)
                )
              )
            )
          )
        )
      )
    )
    (return found)
  )
  (fn-do _ constructor-signature (? String)
    (param owner Module)
    (param class ClassDecl)
    (param fn FunctionDecl)
    (param shown String)
    (param intrinsic IntrinsicKind)
    (if (and (== (. fn kind) .constructor-decl) (!= (. fn args count) 0))
      (return-if null (if (== (?. (. ([] (. owner arg-pool) (. fn args start)) name) text) "(stream)")))
      (return (call signature owner fn shown))
    )
    (if (== (. fn kind) .constructor-decl)
      (return (str "\"" shown "()\""))
    )
    (if (or (!= (. fn kind) .tuple-constructor-decl) (and (!= intrinsic .tuple) (!= intrinsic .struct)))
      (return null)
    )
    (let fields (list String))
    (for (in offset (..< 0 (. class members count)))
      (match? ([] (. owner decls) ([] (. owner member-pool) (+ (. class members start) offset)))
        (case (call .decl-property property)
          (let typed
            (scope (if-expr (!= (. property type-syntax) 0) type-text "")
              (lazy type-text (call written-type (. owner tree) (. property type-syntax)))
            )
          )
          (let valued
            (scope (if-expr (!= (. property value) 0) (str "= " value-text) "")
              (lazy value-text (call node-text (. owner tree) (. property value)))
            )
          )
          (if (. property name)
            (+= fields
              (call (. (str (. property name text) " " field-text) trim)
                (block
                  (lazy field-text (if-expr (!= (. typed length) 0) typed valued))
                )
              )
            )
          )
        )
      )
    )
    (let base (if-expr (!= (. class base) 0) (call written-type (. owner tree) (. class base)) ""))
    (return-if (str "\"" shown base "\"") (if (and (== (. fields length) 0) (call (. base starts-with) "("))))
    (return (str "\"" shown "(" (call (. ", " join) fields) ")\""))
  )
  (fn-do _ property-message String
    (param diagnostic TypeDiagnostic)
    (param base String)
    ; The receiver is what the diagnostic names, where it names one, or what its node was typed as.
    (let tree (. ([] (. program modules) (. diagnostic module)) tree))
    (match? ([] (. tree nodes) (. diagnostic syntax))
      (case (call .node-get-expression row)
        (let typed (call (. facts node-type) (. diagnostic instance) (. row object)))
        (let receiver (if-expr (!= (. diagnostic from) no-type) (. diagnostic from) typed))
        (return (call member-read-message (. diagnostic module) tree (. row object) receiver (. row name)))
      )
    )
    (return-if base (if (not (. diagnostic name))))
    (return (str "Property \"" (. diagnostic name text) "\" not found"))
  )
  (fn-do _ stated-property-message String
    (param diagnostic TypeDiagnostic)
    (param base String)
    (let tree (. ([] (. program modules) (. diagnostic module)) tree))
    (match? ([] (. tree nodes) (. diagnostic syntax))
      (case (call .node-get-expression row)
        (let receiver (call (. facts node-type) (. diagnostic instance) (. row object)))
        (return (call member-read-message (. diagnostic module) tree (. row object) receiver (. row name)))
      )
    )
    (let name (call written-name tree (. diagnostic syntax)))
    (return-if base (if (not name)))
    (return (str "Property \"" name "\" not found"))
  )
  (fn-expr _ member-read-message String
    (param caller ModuleId)
    (param tree AST)
    (param object SyntaxId)
    (param receiver TypeId)
    (param name Atom)
    (case? interpolated
      (call interpolated-message interpolated property)
    )
    (case? (and named (call is-type-name named) (!= (. cases length) 0))
      (str named " has no case \"" property "\"" (call suggested property cases))
    )
    (case? (or (== receiver no-type) (== receiver invalid-type))
      (str "Property \"" property "\" not found")
    )
    (case? (and (!= inner no-type) (call class-declares inner name))
      (str "Property \"" property "\" is read from " shown ", which may be null; unwrap it first with \"(!! …)\" or \"(?. …)\"")
    )
    (case? unseen
      (str shown " has no property \"" property "\" here; facet " unseen " declares it, and only the facets a facet sees are in reach. Write \"sees " unseen "\" under the facet that uses it")
    )
    (case? widening
      (str shown " has no property \"" property "\"; a facet's value has only its facet's members and those of the facets it is part of. Write \"" (call casting (?? widening "")) "\" to reach the rest of " widening)
    )
    (default
      (str shown " has no property \"" property "\"" (call suggested property (call member-names caller receiver)))
    )
    (where
      (lazy property (. name text))
      (lazy widening (call facet-widening receiver name))
      (lazy unseen (call unseen-facet caller name receiver))
      (lazy interpolated (call interpolated-read tree object))
      (lazy named (call written-name tree object))
      (lazy cases (call case-names caller named))
      (lazy shown (call type-source types receiver))
      (lazy inner (call optional-inner receiver))
    )
  )
  (fn-expr _ interpolated-message _
    (param variable String)
    (param property String)
    (paragraph
      (str missing "; in a string, " written " reads the property \"" property "\" of " variable ". " fix)
    )
    (where
      (lazy missing (str "Property \"" property "\" not found"))
      (lazy written (str "\"\$" variable "." property "\""))
      (lazy fix (str "Write \"" (call braced variable) "." property "\" to put text after the value"))
    )
  )
  (fn-do _ interpolated-read (? String)
    (param tree AST)
    (param object SyntaxId)
    (match? ([] (. tree nodes) object)
      (case (call .node-identifier row)
        (if (call preceded-by-dollar tree object)
          (return (. row name text))
        )
      )
    )
    (return null)
  )
  (fn-expr _ preceded-by-dollar Bool
    (param tree AST)
    (param id SyntaxId)
    (and (!= (. loc begin column) 0) (== (call char-at line (- (. loc begin column) 1)) '$'))
    (where
      (lazy loc ([] (. tree nodes loc) id))
      (lazy line (call source-line (. tree source) (. loc begin line)))
    )
  )
  (fn-do _ char-at Char
    (param text String)
    (param position Index)
    (let index Index 0)
    (for (in char text)
      (if (== index position)
        (return char)
      )
      (+= index 1)
    )
    (return (as 0 Char))
  )
  (fn-expr _ braced String
    (param name String)
    (++ "\$" "{" name "}")
  )
  (fn-do _ operation-message String
    (param diagnostic TypeDiagnostic)
    (param base String)
    (let tree (. ([] (. program modules) (. diagnostic module)) tree))
    (let left (. diagnostic from))
    (let right (. diagnostic to))
    (if (and (== (?. (. diagnostic name) text) "!") (call known left) (not (call joins-conditions tree (. diagnostic syntax))))
      (let shown (call type-source types left))
      (let reason
        (block
          (case? (call (. shown starts-with) "function ")
            "; it is a function, so call it first"
          )
          (default
            ", since operator \"!\" is not defined for it"
          )
        )
      )
      (return (str shown " cannot be tested as a condition" reason))
    )
    (match? ([] (. tree nodes) (. diagnostic syntax))
      (case (call .node-binary-expression row)
        (let op (str (. row op)))
        (if (== left no-type)
          (= left (call (. facts node-type) (. diagnostic instance) (. row lhs)))
        )
        (if (== right no-type)
          (= right (call (. facts node-type) (. diagnostic instance) (. row rhs)))
        )
        (if (and (call known left) (call known right))
          (return (str "Operator \"" op "\" is not defined for " (call operands-text left right)))
        )
        (return base)
      )
      (case (call .node-unary-expression row)
        (let op
          (scope (if-expr (== (. row op) .negative-op) "-" op-text)
            (lazy op-text (if-expr (== (. row op) .read-op) "<-" (str (. row op))))
          )
        )
        (if (== left no-type)
          (= left (call (. facts node-type) (. diagnostic instance) (. row operand)))
        )
        (if (call known left)
          (let shown (call type-source types left))
          (let callable (call (. shown starts-with) "function "))
          (let calling (if-expr callable "; it is a function, so call it first" ""))
          (return (str "Operator \"" op "\" is not defined for " shown calling))
        )
        (return base)
      )
      (case (call .node-assign row)
        (if (== left no-type)
          (= left (call (. facts node-type) (. diagnostic instance) (. row lhs)))
        )
        (if (== right no-type)
          (= right (call (. facts node-type) (. diagnostic instance) (. row rhs)))
        )
        (let op (str (. row op)))
        (if (and (call known left) (call known right) (!= (. op length) 0))
          (return (str "Operator \"" op "\" is not defined for " (call operands-text left right)))
        )
      )
    )
    (if (and (call known left) (call known right))
      (return (str base ": " (call operands-text left right)))
    )
    (return base)
  )
  (fn-expr _ joins-conditions Bool
    (param tree AST)
    (param syntax SyntaxId)
    ; Whether a condition is an operand of "&&" or "||", which is reported as the operator's.
    (match ([] (. tree nodes) syntax)
      (case (call .node-binary-expression row)
        (or (== (. row op) .and-op) (== (. row op) .or-op))
      )
      (default
        false
      )
    )
  )
  (fn-expr _ operands-text String
    (param left TypeId)
    (param right TypeId)
    (str (call type-source types left) " and " (call type-source types right))
  )
  (fn-do _ type-not-found-message String
    (param diagnostic TypeDiagnostic)
    (param base String)
    (let tree (. ([] (. program modules) (. diagnostic module)) tree))
    (match? ([] (. tree nodes) (. diagnostic syntax))
      (case .node-symbol
        (return (call case-message diagnostic base))
      )
    )
    (let name (call type-name-at tree (. diagnostic syntax)))
    (if (not name)
      (match? ([] (. tree nodes) (. diagnostic syntax))
        (case (call .node-integer-syntax row)
          (return (call unit-message diagnostic (. row unit)))
        )
        (case (call .node-float-syntax row)
          (return (call unit-message diagnostic (. row unit)))
        )
      )
      (return base)
    )
    (let facet (call facet-named (call (. program store-atom) name)))
    (return-if (call facet-reach-message (. diagnostic module) name facet) (if facet))
    (let nearby (call visible-name-texts (. diagnostic module) true))
    (let note (call missing-note (. diagnostic module) (call (. program store-atom) name) true nearby))
    (return (str "Type \"" name "\" not found" note))
  )
  (fn-expr _ facet-reach-message String
    (param module ModuleId)
    (param name String)
    (param facet U32)
    (case? kept
      (str missing "; facet " name " of " owner " is private, declared with _, so only its own file names it")
    )
    (case? hosted
      (str missing "; facet " name " of " owner " is in reach of another facet only where it sees it. Write \"sees " name "\" under the facet that uses it")
    )
    (default
      (str missing "; " name " is a facet of " owner ", whose name comes with " owner "'s module. Import that module to name it")
    )
    (where
      (lazy missing (str "Type \"" name "\" not found"))
      (lazy owner (call facet-owner-name facet))
      (lazy kept (call is-kept-facet module facet))
      (lazy hosts (. program facets hosts))
      (lazy hosted (and (< module (. hosts length)) (== ([] hosts module) ([] (. program facets owner-modules) facet))))
    )
  )
  (fn-expr _ is-kept-facet Bool
    (param module ModuleId)
    (param facet U32)
    ; Whether a facet is private to a file other than a module's.
    (match ([] (. ([] (. program modules) home) decls) ([] (. program facets decls) facet))
      (case (call .decl-extension row)
        (and (!= home module) (not (call (. program reaches-access) module home (. row access))))
      )
      (default
        false
      )
    )
    (where
      (lazy home ([] (. program facets modules) facet))
    )
  )
  (fn-do _ facet-named (? U32)
    (param name Atom)
    ; The facet of the program with a name, if one has it.
    (let facets (. program facets))
    (for (in facet (..< 0 (. facets count)))
      (match? ([] (. ([] (. program modules) ([] (. facets modules) facet)) decls) ([] (. facets decls) facet))
        (case (call .decl-extension row)
          (if (== (. row facet) name)
            (return (as facet U32))
          )
        )
      )
    )
    (return null)
  )
  (fn-expr _ facet-owner-name String
    (param facet U32)
    (call class-name program ([] (. program facets owner-modules) facet) ([] (. program facets owner-decls) facet))
  )
  (fn-do _ unit-message String
    (param diagnostic TypeDiagnostic)
    (param unit (? Atom))
    ; That the unit written after a number names nothing, with the module that declares it where
    ; the program does.
    (if (not unit)
      (return "Unit not found")
    )
    (let message (str "Unit \"" (. unit text) "\" not found"))
    (let elsewhere (call unimported-hint (. diagnostic module) unit true))
    (if elsewhere
      (return (str message "; " elsewhere))
    )
    (return message)
  )
  (fn-do _ type-name-at (? String)
    (param tree AST)
    (param id SyntaxId)
    (match? ([] (. tree nodes) id)
      (case (call .node-type-identifier row)
        (return (. row name text))
      )
      (case (call .node-type-arguments row)
        (return (call type-name-at tree (. row base)))
      )
      (case (call .node-type-optional row)
        (if (!= (. row field-types count) 0)
          (return (call type-name-at tree ([] (. tree children) (. row field-types start))))
        )
      )
      (case (call .node-identifier row)
        (return (. row name text))
      )
    )
    (return null)
  )
  (fn-do _ facet-widening (? String)
    (param receiver TypeId)
    (param name Atom)
    ; The owner of a facet's value, where the owner or another of its facets has a member of a name
    ; that the facet's value lacks.
    (let facet (only-if (call (. types facet-of-type) receiver) (if (and (!= receiver no-type) (!= receiver invalid-type)))))
    (return-if null (if (not facet)))
    (let owner (call (. types facet-owner) facet))
    (return-if null (if (or (== owner no-type) (not (call class-declares owner name)))))
    (return (call type-source types owner))
  )
  (fn-do _ unseen-facet (? String)
    (param module ModuleId)
    (param name Atom)
    (param receiver TypeId (= no-type))
    ; A facet of a class that a module declares facets of, which declares a member of a name that is
    ; not private and which the module's facets do not see: a facet of the receiver's class or of a
    ; class above it, where there is a receiver, which a facet's value is its owner's.
    (let facets (. program facets))
    (let viewed (only-if (call (. types facet-of-type) receiver) (if (and (!= receiver no-type) (!= receiver invalid-type)))))
    (let held (if-expr viewed (call (. types facet-owner) viewed) receiver))
    (for (in facet (..< 0 (. facets count)))
      (let owned
        (block
          (or (== held no-type) (call is-of-class held ([] (. facets owner-modules) facet) ([] (. facets owner-decls) facet)))
        )
      )
      (if (and owned (== ([] (. facets states) facet) .facet-bound) (not (call (. program sees-facet) module (as facet U32))))
        (let target ([] (. program modules) ([] (. facets modules) facet)))
        (match? ([] (. target decls) ([] (. facets decls) facet))
          (case (call .decl-extension row)
            (for (in member (call (. target members-named) (. row members) name))
              (let shared
                (match ([] (. target decls) member)
                  (case (call .decl-property property)
                    (and (== (. property name) name) (!= (. property access) .private-access))
                  )
                  (case (call .decl-function fn)
                    (and (== (. fn name) name) (!= (. fn access) .private-access))
                  )
                  (case (call .decl-event event)
                    (and (== (. event name) name) (!= (. event access) .private-access))
                  )
                  (default
                    false
                  )
                )
              )
              (if shared
                (return (?. (. row facet) text))
              )
            )
          )
        )
      )
    )
    (return null)
  )
  (fn-expr _ stated-name-message String
    (param diagnostic TypeDiagnostic)
    (param base String)
    (if-expr name (call name-message (. diagnostic module) (. diagnostic syntax) name) base)
    (where
      (lazy name (call written-name (. ([] (. program modules) (. diagnostic module)) tree) (. diagnostic syntax)))
    )
  )
  (fn-expr _ name-message String
    (param module ModuleId)
    (param syntax SyntaxId)
    (param name String)
    (case? (and dash (> dash 0) (call preceded-by-dollar (. ([] (. program modules) module) tree) syntax))
      (str missing "; in a string, \"\$" name "\" reads the whole name \"" name "\". " fix)
    )
    (case? unseen
      (str missing "; facet " unseen " declares it, and only the facets a facet sees are in reach. Write \"sees " unseen "\" under the facet that uses it")
    )
    (default
      (str missing (call missing-note module (call (. program store-atom) name) false nearby))
    )
    (where
      (lazy missing (str "Name \"" name "\" not found"))
      (lazy unseen (call unseen-facet module (call (. program store-atom) name)))
      (lazy dash (call (. name find-reverse) "-"))
      (lazy rest ([] name (... dash)))
      (lazy fix (str "Write \"" (call braced ([] name (..< 0 dash))) rest "\" to put \"" rest "\" after the value"))
      (lazy nearby (++ (call local-names module syntax) (call visible-name-texts module false)))
    )
  )
  (fn-do _ declared-match-message String
    (param diagnostic TypeDiagnostic)
    (param base String)
    (let tree (. ([] (. program modules) (. diagnostic module)) tree))
    (let name "")
    (let annotation SyntaxId 0)
    (match? ([] (. tree nodes) (. diagnostic syntax))
      (case (call .node-type-capture row)
        (= name (?? (call written-name tree (. row id)) ""))
        (= annotation (. row type))
      )
    )
    (if (== annotation 0)
      (return base)
    )
    (let value no-type)
    (for (in position (..< 0 (. tree nodes length)))
      (match? ([] (. tree nodes) position)
        (case (call .node-declare row)
          (if (== (. row left) (. diagnostic syntax))
            (= value (call (. facts node-type) (. diagnostic instance) (. row right)))
          )
        )
      )
    )
    (if (not (call known value))
      (return base)
    )
    (let wanted (call written-type tree annotation))
    (let shown (call type-source types value))
    (let viewed (call (. types facet-of-type) value))
    (if viewed
      (let owner (call type-source types (call (. types facet-owner) viewed)))
      (return
        (paragraph
          (str "\"" name "\" is declared " wanted ", but its value is " shown ", a facet's value, which becomes only the facets it is part of unasked; write \"" (call casting owner) "\" to convert its class")
        )
      )
    )
    (let fix (str "convert the value, or declare \"" name "\" without a type"))
    (return (str "\"" name "\" is declared " wanted ", but its value is " shown ", which can never be " wanted "; " fix))
  )
  (fn-expr _ cast-message String
    (param diagnostic TypeDiagnostic)
    (param base String)
    (case? (or (not (call known (. diagnostic from))) (not (call known (. diagnostic to))))
      base
    )
    (case? written
      (str source " cannot be cast to " target "; there is no conversion between them")
    )
    (case? chooses
      (str "The two sides of this \"if\" are " target " and " source ", which have no common type; convert them to one type")
    )
    (default
      (str "Expected " target " here, but this is " source ", and there is no conversion between them")
    )
    (where
      (lazy source (call type-source types (. diagnostic from)))
      (lazy target (call type-source types (. diagnostic to)))
      (lazy node ([] (. ([] (. program modules) (. diagnostic module)) tree nodes) (. diagnostic syntax)))
      (lazy written (is node .node-cast-expression))
      (lazy chooses
        (match node
          (case (call .node-binary-expression row)
            (== (. row op) .else-op)
          )
          (default
            false
          )
        )
      )
    )
  )
  (fn-expr _ unasked-message String
    (param diagnostic TypeDiagnostic)
    (param base String)
    (case? (or (not (call known (. diagnostic from))) (not (call known (. diagnostic to))))
      base
    )
    (case? binds
      (str "\"<->\" needs each side to become the other on its own, and " (call type-source types (. diagnostic from)) " becomes " target " only when asked; bind a place of the property's type")
    )
    (default
      (match (. diagnostic kind)
        (case= .unasked-unwrap
          (if-expr (!= (call optional-inner (. diagnostic to)) no-type) (str lead ", which becomes " target " only when asked; write \"" cast "\"") (str lead ", which may hold nothing; " unwrap))
        )
        (case= .unasked-text
          (str lead ", which becomes text only inside a text or a print, or when asked; " texting)
        )
        (case= .unasked-narrowing
          (str lead ", which is not always " target "; " narrowing)
        )
        (default
          (str lead ", which becomes " target " only when asked; write \"" cast "\"")
        )
      )
    )
    (where
      (lazy target (call type-source types (. diagnostic to)))
      (lazy lead (str "Expected " target " here, but this is " (call type-source types (. diagnostic from))))
      (lazy tree (. ([] (. program modules) (. diagnostic module)) tree))
      (lazy binds (call binding-site tree (. diagnostic syntax)))
      (lazy held (call brix-held tree (. diagnostic syntax)))
      (lazy cast (str "(as " held " " (call type-brix types (. diagnostic to)) ")"))
      (lazy unwrap (str "write \"(!! " held ")\" to unwrap it, or \"(?? " held " fallback)\" to give a value for nothing"))
      (lazy texting (str "write \"" cast "\", or put it in a \"(str …)\""))
      (lazy narrowing (str "match it with \"(case (: name " (call type-brix types (. diagnostic to)) ") …)\", or write \"" cast "\""))
    )
  )
  (fn-expr _ casting String
    (param target String)
    (str "(as … " target ")")
  )
  (fn-do _ brix-held String
    (param tree AST)
    (param id SyntaxId)
    ; The value a fix-it in Brix holds: as it is written, where that is short and on one line, or
    ; an ellipsis. Where the diagnostic points at the type a declaration is written with, the value
    ; is the declaration's.
    (let held (call declared-value tree id))
    (let loc ([] (. tree nodes loc) held))
    (let text (call node-text tree held))
    (return (if-expr (and (== (. loc end line) (. loc begin line)) (!= (. text length) 0) (<= (. text length) 40)) text "…"))
  )
  (fn-do _ declared-value SyntaxId
    (param tree AST)
    (param id SyntaxId)
    (let at id)
    (for (in step (..< 0 3))
      (let holder (call (. tree holder-of) at))
      (return-if id (if (== holder 0)))
      (match? ([] (. tree nodes) holder)
        (case (call .node-declare row)
          (return (if-expr (and (!= (. row right) 0) (== (. row left) at)) (. row right) id))
        )
      )
      (= at holder)
    )
    (return id)
  )
  (fn-do _ binding-site Bool
    (param tree AST)
    (param syntax SyntaxId)
    (match? ([] (. tree nodes) syntax)
      (case (call .node-assign row)
        (return (== (. row op) .bind-op))
      )
      (case .node-identifier
        (match? ([] (. tree nodes) (call (. tree holder-of) syntax))
          (case (call .node-assign row)
            (return (and (== (. row op) .bind-op) (== (. row lhs) syntax)))
          )
        )
      )
    )
    (return false)
  )
  (fn-expr _ imperative-message String
    (param diagnostic TypeDiagnostic)
    (param limit String)
    (param base String)
    (param remedy String (= ""))
    (case? (not fn)
      base
    )
    (case? (== (. fn kind) .closure-decl)
      (str lead "; " offered "write \":do\"" returning)
    )
    (case? (call (. header starts-with) "(fn-expr ")
      (str lead "; " offered "write \"(fn-do " ([] header (... 9)) " …)\"" returning)
    )
    (default
      (str lead "; " offered "declare it with fn-do" returning)
    )
    (where
      (lazy owner ([] (. program modules) (. diagnostic module)))
      (lazy fn (call enclosing-function-decl owner (. diagnostic syntax)))
      (lazy header (call (. (call line-at (. owner tree) (. fn syntax)) trim)))
      (lazy name (. (!! (. fn name)) text))
      (lazy lead
        (match (. fn kind)
          (case= .closure-decl
            (str "A closure without :do is one expression and " limit)
          )
          (default
            (str "Function \"" name "\" is not declared with fn-do, so its body is one expression and " limit)
          )
        )
      )
      (lazy offered (if-expr remedy (str remedy ", or ") ""))
      (lazy returning
        (match (. diagnostic kind)
          (case= .explicit-return-requires-do
            ""
          )
          (default
            " and return its value with \"(return value)\""
          )
        )
      )
    )
  )
  (fn-do _ default-message String
    (param diagnostic TypeDiagnostic)
    (param base String)
    (let owner ([] (. program modules) (. diagnostic module)))
    (for (in decl (. owner decls))
      (match? decl
        (case (call .decl-function fn)
          (let position (call argument-at owner fn (. diagnostic syntax)))
          (if (!= position (. U32 max))
            (return (call required-after-default owner fn position base))
          )
        )
      )
    )
    (return base)
  )
  (fn-do _ argument-at U32
    (param owner Module)
    (param fn FunctionDecl)
    (param syntax SyntaxId)
    (for (in offset (..< 0 (. fn args count)))
      (if (== (. ([] (. owner arg-pool) (+ (. fn args start) offset)) pattern) syntax)
        (return offset)
      )
    )
    (return (. U32 max))
  )
  (fn-do _ required-after-default String
    (param owner Module)
    (param fn FunctionDecl)
    (param position U32)
    (param base String)
    (let required ([] (. owner arg-pool) (+ (. fn args start) position)))
    (let earlier (. U32 max))
    (for (in offset (..< 0 position))
      (if (. ([] (. owner arg-pool) (+ (. fn args start) offset)) has-default)
        (= earlier offset)
        (break)
      )
    )
    (if (== earlier (. U32 max))
      (return base)
    )
    (let defaulted ([] (. owner arg-pool) (+ (. fn args start) earlier)))
    (let named (call shape-name (. owner tree) required))
    (let prior (call shape-name (. owner tree) defaulted))
    (let fix (str "declare required parameters first, or give " named " a default"))
    (return (str "Parameter " named " has no default but comes after " prior ", which has a default; " fix))
  )
  (fn-expr _ shape-name String
    (param tree AST)
    (param shape ArgumentShape)
    (str "\"" named "\"")
    (where
      (lazy named (if-expr (. shape name) (. shape name text) (?? (call written-name tree (. shape pattern)) "?")))
    )
  )
  (fn-expr _ divider-message String
    (param diagnostic TypeDiagnostic)
    (param base String)
    (if-expr (== stray 0) base (call stray-message (. diagnostic module) (!! (call divided-holder diagnostic)) stray))
    (where
      (lazy stray (call divided-stray diagnostic))
    )
  )
  (fn-expr _ divided-stray SyntaxId
    (param diagnostic TypeDiagnostic)
    (if-expr holder (call stray-declaration (. diagnostic module) (. holder syntax)) 0)
    (where
      (lazy holder (call divided-holder diagnostic))
    )
  )
  (fn-do _ divided-holder (? FunctionDecl)
    (param diagnostic TypeDiagnostic)
    (let owner ([] (. program modules) (. diagnostic module)))
    (match? (. diagnostic kind)
      (case= .non-void-return
        (return (call function-at owner (. diagnostic syntax)))
      )
      (case= .stated
        (if (and (. diagnostic name) (== (. diagnostic name text) (call bare-value-text)))
          (return (call enclosing-function-decl owner (. diagnostic syntax)))
        )
      )
    )
    (return null)
  )
  (fn-expr _ bare-value-text String
    "A value cannot stand alone as a step; use it, or remove it"
  )
  (fn-do _ stray-declaration SyntaxId
    (param module ModuleId)
    (param header SyntaxId)
    (let owner ([] (. program modules) module))
    (let fn (call function-at owner header))
    (return-if 0 (if (or (not fn) (. fn is-content) (== (. fn kind) .live-decl))))
    (match? ([] (. owner tree nodes) (. fn body))
      (case (call .node-block row)
        (for (in statement ([] (. owner tree children) (. row body)))
          (match? ([] (. owner tree nodes) statement)
            (case .node-property-syntax
              (return statement)
            )
          )
        )
      )
    )
    (return 0)
  )
  (fn-do _ stray-holder (? FunctionDecl)
    (param module ModuleId)
    (param syntax SyntaxId)
    (let owner ([] (. program modules) module))
    (match? ([] (. owner tree nodes) syntax)
      (case .node-property-syntax
        (let fn (call enclosing-function-decl owner syntax))
        (if (and fn (not (. fn is-content)) (!= (. fn body) 0) (== (call stray-declaration module (. fn syntax)) syntax))
          (return fn)
        )
      )
    )
    (return null)
  )
  (fn-expr _ stray-message String
    (param module ModuleId)
    (param fn FunctionDecl)
    (param stray SyntaxId)
    (case? (and valued (== (. fn owner) 0))
      (str lead "; declare module-level values above the first divider")
    )
    (case? valued
      (str lead "; declare properties above the first thin divider (─) of the type")
    )
    (default
      (str lead "; put " divider " on the line above it")
    )
    (where
      (lazy tree (. ([] (. program modules) module) tree))
      (lazy line (call (. (call line-at tree stray) trim)))
      (lazy name (if-expr (. fn name) (. fn name text) "?"))
      (lazy lead (str "\"" line "\" is read as part of the body of \"" name "\", because no divider separates them"))
      (lazy valued
        (match ([] (. tree nodes) stray)
          (case (call .node-property-syntax row)
            (!= (. row value) 0)
          )
          (default
            false
          )
        )
      )
      (lazy divider (if-expr (!= (. fn owner) 0) "a thin divider (─)" "a thick divider (━)"))
    )
  )
  (fn-expr _ stated-redefined-message String
    (param diagnostic TypeDiagnostic)
    (param base String)
    (if-expr name (call redefined-message (. diagnostic module) (. diagnostic syntax) name) base)
    (where
      (lazy name (call written-name (. ([] (. program modules) (. diagnostic module)) tree) (. diagnostic syntax)))
    )
  )
  (fn-expr _ redefined-message _
    (param module ModuleId)
    (param syntax SyntaxId)
    (param name String)
    (paragraph
      (str "\"" name "\" is already declared" place " in this scope; " fix ", or choose another name")
    )
    (where
      (lazy earlier (call earlier-slot module syntax name))
      (lazy tree (. ([] (. program modules) module) tree))
      (lazy place (if-expr (!= earlier 0) (str " on line " (+ (. ([] (. tree nodes loc) earlier) begin line) 1)) ""))
      (lazy fix (str "to change its value, assign it with \"(= " name " value)\""))
    )
  )
  (fn-do _ earlier-slot SyntaxId
    (param module ModuleId)
    (param syntax SyntaxId)
    (param name String)
    (let narrowest (. U32 max))
    (let found SyntaxId 0)
    (for (in binding (. bindings bindings))
      (let start (. binding subtree start))
      (let count (. binding subtree count))
      (if (and (== (. binding module) module) (>= syntax start) (< syntax (+ start count)) (< count narrowest))
        (= narrowest count)
        (= found 0)
        (for (in slot ([] (. bindings slots) (. binding slots)))
          (if (and (== (. slot name text) name) (!= (. slot syntax) 0) (< (. slot syntax) syntax))
            (= found (. slot syntax))
          )
        )
      )
    )
    (return found)
  )
  (fn-do _ stated-undeclared-message String
    (param diagnostic TypeDiagnostic)
    (param base String)
    (let tree (. ([] (. program modules) (. diagnostic module)) tree))
    (match? ([] (. tree nodes) (. diagnostic syntax))
      (case (call .node-assign row)
        (let name (call written-name tree (. row lhs)))
        (if name
          (return (call undeclared-message (. diagnostic module) (. diagnostic syntax) name))
        )
      )
    )
    (return base)
  )
  (fn-expr _ undeclared-message String
    (param module ModuleId)
    (param syntax SyntaxId)
    (param name String)
    (case? (!= (. close length) 0)
      (str "Variable \"" name "\" is not declared" close)
    )
    (default
      (str "Variable \"" name "\" is not declared; declare it with \"" declaring "\"")
    )
    (where
      (lazy close (call suggested name (call local-names module syntax)))
      (lazy tree (. ([] (. program modules) module) tree))
      (lazy written (call node-text tree syntax))
      (lazy whole (== (. ([] (. tree nodes loc) syntax) end line) (. ([] (. tree nodes loc) syntax) begin line)))
      (lazy declaring (call brix-declaring written name whole))
    )
  )
  (fn-expr _ brix-declaring String
    (param written String)
    (param name String)
    (param whole Bool)
    (if-expr (and whole (call (. written starts-with) (str "(= " name " "))) (str "(let " ([] written (... 3))) (str "(let " name " value)"))
  )
  (fn-expr _ local-call-message (? String)
    (param diagnostic TypeDiagnostic)
    (param callable SyntaxId)
    (param name Atom)
    (case? (== (call (. (call local-names (. diagnostic module) callable) find) (. name text)) null)
      null
    )
    (case? (!= (. (call visible-signatures (. diagnostic module) name .function-decl null) length) 0)
      null
    )
    (case? (or (call (. shown starts-with) "function ") (== shown "closure"))
      null
    )
    (default
      (str "\"" (. name text) "\" is " what ", not a function, so it cannot be called")
    )
    (where
      (lazy declared (call earlier-slot (. diagnostic module) callable (. name text)))
      (lazy type (if-expr (!= declared 0) (call declared-type diagnostic declared) no-type))
      (lazy shown (if-expr (call known type) (call type-source types type) ""))
      (lazy what (if-expr (!= (. shown length) 0) (str "a local " shown) "a local value"))
    )
  )
  (fn-do _ declared-type TypeId
    (param diagnostic TypeDiagnostic)
    (param declared SyntaxId)
    (let tree (. ([] (. program modules) (. diagnostic module)) tree))
    (let own (call (. facts node-type) (. diagnostic instance) declared))
    (return-if own (if (call known own)))
    (for (in position (..< 0 (. tree nodes length)))
      (match? ([] (. tree nodes) position)
        (case (call .node-declare row)
          (if (== (. row left) declared)
            (return (call (. facts node-type) (. diagnostic instance) (. row right)))
          )
        )
      )
    )
    (return no-type)
  )
  (fn-expr _ catch-message String
    (param diagnostic TypeDiagnostic)
    (param base String)
    (case? (== (. written length) 0)
      base
    )
    (default
      (str "\"" written "\" cannot fail, so the catch attached to it has nothing to handle; " fix)
    )
    (where
      (lazy tree (. ([] (. program modules) (. diagnostic module)) tree))
      (lazy written (call node-text tree (. diagnostic syntax)))
      (lazy fix "remove the catch, or attach it to a call that can fail")
    )
  )
  (fn-expr _ arm-step-message String
    "This arm gives no value, and here a match gives the value of the arm it takes; to run its arms as steps, write the match on a row of its own in a body of steps"
  )
  (fn-expr _ arm-value-message String
    "This arm gives no value, and this body is a value, so a match gives the value of the arm it takes; to run its arms as steps, write `fn-do`, or `:do` in a closure"
  )
  (fn-do _ list-message String
    (param diagnostic TypeDiagnostic)
    (param base String)
    (let tree (. ([] (. program modules) (. diagnostic module)) tree))
    (let shown (list String))
    (match? ([] (. tree nodes) (. diagnostic syntax))
      (case (call .node-list-syntax row)
        (for (in item ([] (. tree children) (. row items)))
          (let type (call (. facts node-type) (. diagnostic instance) item))
          (if (and (call known type) (== (call (. shown find) (call type-source types type)) null))
            (+= shown (call type-source types type))
          )
        )
      )
    )
    (return-if base (if (< (. shown length) 2)))
    (return (str "This list mixes " (call listed shown) ", which have no common type; convert the items to one type"))
  )
  (fn-expr _ iteration-message String
    (param diagnostic TypeDiagnostic)
    (param base String)
    (case? (not (call settled type))
      base
    )
    (case? (call is-integer-kind (. (call (. types completion-of) type) intrinsic))
      (str cannot "; to count, loop over a range, as in \"0 .. < " written "\"")
    )
    (default
      (str cannot "; loop over a list, a range or a stream")
    )
    (where
      (lazy type (call (. facts node-type) (. diagnostic instance) (. diagnostic syntax)))
      (lazy cannot (str "A for loop cannot iterate over " (call type-source types type)))
      (lazy written (call node-text (. ([] (. program modules) (. diagnostic module)) tree) (. diagnostic syntax)))
    )
  )
  (fn-expr _ redefinition-message String
    (param diagnostic TypeDiagnostic)
    (param base String)
    (case? (or (== member (. U32 max)) (not name) (== (. holder length) 0))
      base
    )
    (default
      (str holder " declares \"" (. name text) "\" twice" place "; remove one of them, or rename it")
    )
    (where
      (lazy owner ([] (. program modules) (. diagnostic module)))
      (lazy member (call member-at owner (. diagnostic syntax)))
      (lazy name (call member-name owner member))
      (lazy holder (call holder-text owner (call member-owner owner member)))
      (lazy first (call earlier-member owner member name))
      (lazy first-line (+ (. ([] (. owner tree nodes loc) (call member-site owner first)) begin line) 1))
      (lazy place (if-expr (!= first (. U32 max)) (str " (first on line " first-line ")") ""))
    )
  )
  (fn-expr _ override-type-message String
    (param diagnostic TypeDiagnostic)
    (param base String)
    (case? (or (== member (. U32 max)) (not name) (== (. inherited length) 0))
      base
    )
    (default
      (str "\"" (. name text) "\" is inherited from " inherited ", " kept)
    )
    (where
      (lazy owner ([] (. program modules) (. diagnostic module)))
      (lazy member (call member-at owner (. diagnostic syntax)))
      (lazy name (call member-name owner member))
      (lazy inherited (call base-text owner member))
      (lazy typed (call member-type-text owner member))
      (lazy removal (if-expr (!= (. typed length) 0) (str "; remove \"" typed "\"") ""))
      (lazy kept (str "so it keeps the type it has there and cannot state its own" removal))
    )
  )
  (fn-expr _ override-storage-message String
    (param diagnostic TypeDiagnostic)
    (param base String)
    (case? (or (== member (. U32 max)) (not name) (== (. inherited length) 0))
      base
    )
    (case? (and (!= (. own length) 0) (!= (. theirs length) 0) (!= own theirs))
      (str lead ", which declares it " theirs ", so declare it " theirs " here too, not " own)
    )
    (default
      (str lead ", so declare it the way " inherited " does, " same)
    )
    (where
      (lazy owner ([] (. program modules) (. diagnostic module)))
      (lazy member (call member-at owner (. diagnostic syntax)))
      (lazy name (call member-name owner member))
      (lazy inherited (call base-text owner member))
      (lazy lead (str "\"" (. name text) "\" is inherited from " inherited))
      (lazy own (call storage-text (. owner tree) (. diagnostic syntax)))
      (lazy theirs (call inherited-storage (. diagnostic module) inherited name))
      (lazy same "with the same \"=\" or \":=\", or as a getter if it is one there")
    )
  )
  (fn-expr _ storage-text String
    (param tree AST)
    (param syntax SyntaxId)
    (case? (!= (call (. text find) " :get") null)
      "as a getter"
    )
    (case? (!= (call (. text find) " (:= ") null)
      "with \":=\""
    )
    (case? (!= (call (. text find) " (= ") null)
      "with \"=\""
    )
    (default
      ""
    )
    (where
      (lazy text (call (. (call line-at tree syntax) trim)))
    )
  )
  (fn-expr _ line-at String
    (param tree AST)
    (param syntax SyntaxId)
    (call source-line (. tree source) (. ([] (. tree nodes loc) syntax) begin line))
  )
  (fn-do _ inherited-storage String
    (param caller ModuleId)
    (param written String)
    (param name Atom)
    (let cut (call (. written find) "'"))
    (let named (if-expr cut ([] written (..< 0 cut)) written))
    (for (in candidate (call (. program lookup) caller (call (. program store-atom) named)))
      (let owner ([] (. program modules) (. candidate module)))
      (match? ([] (. owner decls) (. candidate decl))
        (case (call .decl-class class)
          (for (in offset (..< 0 (. class members count)))
            (let member ([] (. owner member-pool) (+ (. class members start) offset)))
            (if (== (call member-name owner member) name)
              (return (call storage-text (. owner tree) (call member-site owner member)))
            )
          )
        )
      )
    )
    (return "")
  )
  (fn-do _ member-at DeclId
    (param owner Module)
    (param syntax SyntaxId)
    (let index 0u32)
    (for (in _ (. owner decls))
      (if (and (!= syntax 0) (== (call member-site owner index) syntax))
        (return index)
      )
      (+= index 1)
    )
    (return (. U32 max))
  )
  (fn-expr _ member-site SyntaxId
    (param owner Module)
    (param decl DeclId)
    (match ([] (. owner decls) decl)
      (case (call .decl-property property)
        (. property syntax)
      )
      (case (call .decl-function fn)
        (. fn syntax)
      )
      (case (call .decl-event event)
        (. event syntax)
      )
      (default
        0u32
      )
    )
  )
  (fn-expr _ member-name (? Atom)
    (param owner Module)
    (param decl DeclId)
    (match? ([] (. owner decls) decl)
      (case (call .decl-property property)
        (. property name)
      )
      (case (call .decl-function fn)
        (. fn name)
      )
      (case (call .decl-event event)
        (. event name)
      )
    )
  )
  (fn-expr _ member-owner DeclId
    (param owner Module)
    (param decl DeclId)
    (match ([] (. owner decls) decl)
      (case (call .decl-property property)
        (. property owner)
      )
      (case (call .decl-function fn)
        (. fn owner)
      )
      (case (call .decl-event event)
        (. event owner)
      )
      (default
        0u32
      )
    )
  )
  (fn-expr _ member-type-text String
    (param owner Module)
    (param decl DeclId)
    (if-expr (!= syntax 0) (call node-text (. owner tree) syntax) "")
    (where
      (lazy syntax
        (match ([] (. owner decls) decl)
          (case (call .decl-property property)
            (. property type-syntax)
          )
          (case (call .decl-function fn)
            (. fn return-type)
          )
          (default
            0u32
          )
        )
      )
    )
  )
  (fn-do _ base-text String
    (param owner Module)
    (param decl DeclId)
    (let holder (call member-owner owner decl))
    (return-if "" (if (== holder 0)))
    (match? ([] (. owner decls) holder)
      (case (call .decl-class class)
        (if (!= (. class base) 0)
          (return (call written-type (. owner tree) (. class base)))
        )
      )
    )
    (return "")
  )
  (fn-do _ earlier-member DeclId
    (param owner Module)
    (param member DeclId)
    (param name Atom)
    (let holder (call member-owner owner member))
    (return-if (. U32 max) (if (== holder 0)))
    (match? ([] (. owner decls) holder)
      (case (call .decl-class class)
        (for (in offset (..< 0 (. class members count)))
          (let other ([] (. owner member-pool) (+ (. class members start) offset)))
          (if (and (< other member) (== (call member-name owner other) name))
            (return other)
          )
        )
      )
    )
    (return (. U32 max))
  )
  (fn-do _ case-message String
    (param diagnostic TypeDiagnostic)
    (param base String)
    (let tree (. ([] (. program modules) (. diagnostic module)) tree))
    (let name "")
    (match? ([] (. tree nodes) (. diagnostic syntax))
      (case (call .node-symbol row)
        (= name (. row name text))
      )
    )
    (return-if base (if (== (. name length) 0)))
    (let names (list String))
    (for (in position (..< 0 (. program modules length)))
      (let owner ([] (. program modules) position))
      (for (in decl (. owner decls))
        (match? decl
          (case (call .decl-case case)
            (if (and (. case name) (== (. case name text) name))
              (let holder (call holder-text owner (. case owner)))
              (if (!= (. holder length) 0)
                (return (call unimported-case-message (. diagnostic module) owner holder name))
              )
            )
            (if (and (. case name) (== (call (. names find) (str "." (. case name text))) null))
              (+= names (str "." (. case name text)))
            )
          )
        )
      )
    )
    (return (str "Case \"." name "\" not found" (call suggested (str "." name) names)))
  )
  (fn-expr _ unimported-case-message _
    (param caller ModuleId)
    (param owner Module)
    (param holder String)
    (param name String)
    (paragraph
      (str "Case \"." name "\" belongs to " holder ", which this module does not import, so " alone "; " fix)
    )
    (where
      (lazy alone "the case cannot be named alone")
      (lazy fix (str "write \"" holder "." name "\" and add the import " (call import-line caller owner)))
    )
  )
  (fn-do _ holder-text String
    (param owner Module)
    (param holder DeclId)
    (return-if "" (if (== holder 0)))
    (match? ([] (. owner decls) holder)
      (case (call .decl-class class)
        (return (. class name text))
      )
    )
    (return "")
  )
  (fn-do _ case-names (list String)
    (param caller ModuleId)
    (param name String)
    (let found (list String))
    (for (in candidate (call (. program lookup) caller (call (. program store-atom) name)))
      (let owner ([] (. program modules) (. candidate module)))
      (match? ([] (. owner decls) (. candidate decl))
        (case (call .decl-class class)
          (for (in offset (..< 0 (. class members count)))
            (match? ([] (. owner decls) ([] (. owner member-pool) (+ (. class members start) offset)))
              (case (call .decl-case case)
                (if (. case name)
                  (+= found (. case name text))
                )
              )
            )
          )
        )
      )
    )
    (return found)
  )
  (fn-expr _ chaining-message String
    (param diagnostic TypeDiagnostic)
    (param base String)
    (case? (or (== object 0) not-chained)
      base
    )
    (default
      (str "\"" receiver "\" is " typed "never null, so it needs no \"?\"; write \"" fixed "\"")
    )
    (where
      (lazy tree (. ([] (. program modules) (. diagnostic module)) tree))
      (lazy object (call chained-object tree (. diagnostic syntax)))
      (lazy not-chained (!= (call char-at written mark) '?'))
      (lazy written (call node-text tree (. diagnostic syntax)))
      (lazy receiver (call node-text tree object))
      (lazy link (call chained-link tree (. diagnostic syntax)))
      (lazy linked (- (. ([] (. tree nodes loc) link) begin column) (. ([] (. tree nodes loc) (. diagnostic syntax)) begin column)))
      (lazy mark (as (+ linked 1) Index))
      (lazy fixed (++ ([] written (..< 0 mark)) ([] written (... (+ mark 1)))))
      (lazy type (call (. facts node-type) (. diagnostic instance) object))
      (lazy typed (if-expr (call known type) (str (call type-source types type) ", which is ") ""))
    )
  )
  (fn-expr _ force-message String
    (param diagnostic TypeDiagnostic)
    (param base String)
    (case? (== (. forced length) 0)
      base
    )
    (default
      (str "\"" forced "\" is " typed "never null here, so it needs no \"!!\"")
    )
    (where
      (lazy tree (. ([] (. program modules) (. diagnostic module)) tree))
      (lazy forced (call forced-operand tree (. diagnostic syntax)))
      (lazy typed (if-expr (call known (. diagnostic from)) (str from-text ", which is ") ""))
      (lazy from-text (call type-source types (. diagnostic from)))
    )
  )
  (fn-expr _ forced-operand String
    (param tree AST)
    (param id SyntaxId)
    (match ([] (. tree nodes) id)
      (case (call .node-unary-expression row)
        (if-expr (== (. row op) .optional-force-op) (call node-text tree (. row operand)) "")
      )
      (default
        ""
      )
    )
  )
  (fn-expr _ chained-link SyntaxId
    (param tree AST)
    (param id SyntaxId)
    (match ([] (. tree nodes) id)
      (case (call .node-call-expression row)
        (call chained-link tree (. row callable))
      )
      (default
        id
      )
    )
  )
  (fn-expr _ chained-object SyntaxId
    (param tree AST)
    (param id SyntaxId)
    (match ([] (. tree nodes) id)
      (case (call .node-get-expression row)
        (. row object)
      )
      (case (call .node-index-expression row)
        (. row object)
      )
      (case (call .node-call-expression row)
        (call chained-object tree (. row callable))
      )
      (default
        0u32
      )
    )
  )
  (fn-expr _ called-member SyntaxId
    (param tree AST)
    (param id SyntaxId)
    (match ([] (. tree nodes) id)
      (case .node-get-expression
        id
      )
      (case (call .node-call-expression row)
        (call called-member tree (. row callable))
      )
      (default
        0u32
      )
    )
  )
  (fn-do _ extension-message String
    (param diagnostic TypeDiagnostic)
    (param base String)
    (let tree (. ([] (. program modules) (. diagnostic module)) tree))
    (let member (call called-member tree (. diagnostic syntax)))
    (return-if base (if (== member 0)))
    (match? ([] (. tree nodes) member)
      (case (call .node-get-expression row)
        (let receiver (call (. facts node-type) (. diagnostic instance) (. row object)))
        (let shown (if-expr (call known receiver) (str " for " (call type-source types receiver)) ""))
        (let fix "remove or rename all but one of them")
        (let declared (str "More than one extension declares \"" (. row name text) "\"" shown))
        (return (str declared ", so the call is ambiguous; " fix))
      )
    )
    (return base)
  )
  (fn-expr _ recursion-message String
    (param diagnostic TypeDiagnostic)
    (param base String)
    (case? (or (not fn) (not fn-name))
      base
    )
    (default
      (str "Function \"" (. fn-name text) "\" " reason "; declare it, as in \"" declared "\"")
    )
    (where
      (lazy owner ([] (. program modules) (. diagnostic module)))
      (lazy fn (call function-at owner (. diagnostic syntax)))
      (lazy fn-name (. fn name))
      (lazy reason "calls itself before its return type is known, so the type cannot be inferred")
      (lazy header (call (. (call line-at (. owner tree) (. fn syntax)) trim)))
      (lazy returned (if-expr (call known (. diagnostic to)) (call type-source types (. diagnostic to)) "ReturnType"))
      (lazy declared (call brix-returning header returned))
    )
  )
  (fn-do _ brix-returning String
    (param header String)
    (param returned String)
    (let words (call List (call (. header split) " ")))
    (if (and (> (. words length) 3) (== ([] words 3) "_"))
      (= ([] words 3) returned)
    )
    (return (str (call (. " " join) words) " …)"))
  )
  (fn-expr _ unify-message String
    (param diagnostic TypeDiagnostic)
    (param base String)
    (case? (or (not (call known (. diagnostic from))) (not (call known (. diagnostic to))))
      base
    )
    (default
      (str subject " returns " here " here and " elsewhere " elsewhere, which have no common type; " fix)
    )
    (where
      (lazy fn (call enclosing-function-decl ([] (. program modules) (. diagnostic module)) (. diagnostic syntax)))
      (lazy subject (if-expr fn (str "Function \"" (. (!! (. fn name)) text) "\"") "This function"))
      (lazy here (call type-source types (. diagnostic from)))
      (lazy elsewhere (call type-source types (. diagnostic to)))
      (lazy fix "return one type, or declare the return type")
    )
  )
  (fn-expr _ circular-message String
    (param diagnostic TypeDiagnostic)
    (param base String)
    (case? (not name)
      base
    )
    (default
      (str "\"" name "\" depends on its own value, directly or through the values it reads; break the cycle")
    )
    (where
      (lazy owner ([] (. program modules) (. diagnostic module)))
      (lazy member (call member-at owner (. diagnostic syntax)))
      (lazy declared (only-if (call member-name owner member) (if (!= member (. U32 max)))))
      (lazy name (if-expr declared (. declared text) (call written-name (. owner tree) (. diagnostic syntax))))
    )
  )
  (fn-do _ null-message String
    (param diagnostic TypeDiagnostic)
    (param base String)
    (let tree (. ([] (. program modules) (. diagnostic module)) tree))
    (let type (call node-text tree (. diagnostic syntax)))
    (for (in position (..< 0 (. tree nodes length)))
      (match? ([] (. tree nodes) position)
        (case (call .node-type-capture row)
          (if (== (. row type) (. diagnostic syntax))
            (let name (call written-name tree (. row id)))
            (if name
              (return (call interface-default-message name type))
            )
          )
        )
      )
    )
    (return base)
  )
  (fn-expr _ interface-default-message _
    (param name String)
    (param type String)
    (paragraph
      (str "\"" name "\" is declared " type " with no value, but " type " is an interface, so " nothing "; " fix)
    )
    (where
      (lazy nothing "there is nothing to construct")
      (lazy fix (str "give it a value, as in \"(let " name " " type " value)\", or " declare))
      (lazy declare (str "declare it \"(? " type ")\" to start as null"))
    )
  )
  (fn-expr _ return-message String
    (param diagnostic TypeDiagnostic)
    (param base String)
    (case? (call enclosing-function-decl owner (. diagnostic syntax))
      base
    )
    (case? (not at-top)
      "Only a function can return with \"return\", and this statement is not inside one; remove the \"return\""
    )
    (default
      (str "The top level of a module cannot return a value with \"return\"; " removal)
    )
    (where
      (lazy owner ([] (. program modules) (. diagnostic module)))
      (lazy tree (. owner tree))
      (lazy at-top (== (call (. tree holder-of) (. diagnostic syntax)) (. tree root)))
      (lazy removal "remove the \"return\", or print the value with \"print\"")
    )
  )
  (fn-expr _ subscriber-return-message String
    (param diagnostic TypeDiagnostic)
    (param base String)
    (case? (not fn)
      base
    )
    (case? (== stream 0)
      base
    )
    (case? (call is-class-section owner (. fn syntax))
      (str "The event handler for \"" source "\" cannot return with \"(return …)\"; move its body into a method" method " and call that, or end the handler early with \"continue\"")
    )
    (default
      (str "The body of a loop on \"" source "\" cannot return with \"(return …)\"; skip to the next value with \"continue\", or stop the loop with \"break\"")
    )
    (where
      (lazy owner ([] (. program modules) (. diagnostic module)))
      (lazy fn (call enclosing-subscriber-decl owner (. diagnostic syntax)))
      (lazy stream (call subscribed-stream (. owner tree) (. fn syntax)))
      (lazy source (call node-text (. owner tree) stream))
      (lazy name (call written-name (. owner tree) stream))
      (lazy method (if-expr name (str ", as in \"(fn-do _ handle-" name " …)\",") ""))
    )
  )
  (fn-do _ is-class-section Bool
    (param owner Module)
    (param syntax SyntaxId)
    (return-if false (if (call enclosing-function-decl owner syntax)))
    (for (in decl (. owner decls))
      (match? decl
        (case (call .decl-class class)
          (if (and (>= syntax (call (. owner tree subtree-start) (. class syntax))) (< syntax (. class syntax)))
            (return true)
          )
        )
      )
    )
    (return false)
  )
  (fn-do _ enclosing-subscriber-decl (? FunctionDecl)
    (param owner Module)
    (param syntax SyntaxId)
    (let found (? FunctionDecl))
    (for (in decl (. owner decls))
      (match? decl
        (case (call .decl-function fn)
          (let start (. fn subtree start))
          (let inside (and (>= syntax start) (< syntax (+ start (. fn subtree count)))))
          (if (and inside subscriber (or (not found) (< (. fn subtree count) (. found subtree count))))
            (= found fn)
          )
          (lazy subscriber (== (. fn kind) .subscriber-decl))
        )
      )
    )
    (return found)
  )
  (fn-do _ subscribed-stream SyntaxId
    (param tree AST)
    (param id SyntaxId)
    (match? ([] (. tree nodes) id)
      (case (call .node-for-block row)
        (match? ([] (. tree nodes) (. row loop))
          (case (call .node-loop-syntax loop)
            (return (. loop container))
          )
        )
      )
    )
    (return 0)
  )
  (fn-do _ argument-message String
    (param diagnostic TypeDiagnostic)
    (param base String)
    (let tree (. ([] (. program modules) (. diagnostic module)) tree))
    (let label "")
    (match? ([] (. tree nodes) (. diagnostic syntax))
      (case (call .node-argument row)
        (= label (if-expr (. row name) (. row name text) ""))
      )
    )
    (return-if base (if (== (. label length) 0)))
    (for (in position (..< 0 (. tree nodes length)))
      (match? ([] (. tree nodes) position)
        (case (call .node-call-expression row)
          (for (in operand ([] (. tree children) (. row operands)))
            (if (== operand (. diagnostic syntax))
              (let callee (call node-text tree (. row callable)))
              (let type (call (. facts node-type) (. diagnostic instance) (. row callable)))
              (let typed
                (scope (if-expr (call known type) (str ", whose type is " type-text) "")
                  (lazy type-text (call type-source types type))
                )
              )
              (return (str "\"" callee "\" has no \"" label "\" argument" typed))
            )
          )
        )
      )
    )
    (return (str "This call has no \"" label "\" argument"))
  )
  (fn-expr _ raised-message String
    (param diagnostic TypeDiagnostic)
    (param base String)
    (case? (or (not open) (not close) (not fn) (not fn-name))
      base
    )
    (default
      (str "\"" name "\" can fail with " names ", but " other " cannot; " fix)
    )
    (where
      (lazy open (call (. base find) "("))
      (lazy close (call (. base find) ")"))
      (lazy fn (call function-at ([] (. program modules) (. diagnostic module)) (. diagnostic syntax)))
      (lazy fn-name (. fn name))
      (lazy names ([] base (..< (+ open 1) close)))
      (lazy name (. fn-name text))
      (lazy implements (call (. base ends-with) " interface does not"))
      (lazy other (if-expr implements "the interface method it implements" "the method it overrides"))
      (lazy fix (str "add \"" (call brix-errors names) "\" to that method, or catch the error inside \"" name "\""))
    )
  )
  (fn-expr _ brix-errors String
    (param names String)
    (call (. " " join) (*> (call (. names split) ", ") (str "(?! " each ")")))
  )
  (fn-expr _ recursive-errors-message String
    (param diagnostic TypeDiagnostic)
    (param base String)
    (case? (or (not lead) (not tail))
      base
    )
    (default
      (str names " can leave \"" name "\", which calls itself, so its errors cannot be inferred; " fix)
    )
    (where
      (lazy marker " can leave recursive function ")
      (lazy lead (call (. base find) marker))
      (lazy tail (call (. base find) " before its errors are inferred"))
      (lazy names ([] base (..< 0 lead)))
      (lazy name ([] base (..< (+ lead (. marker length)) tail)))
      (lazy example (call declaring-example ([] (. program modules) (. diagnostic module)) name names))
      (lazy fix (str "declare them on it" example ", or catch them here"))
    )
  )
  (fn-expr _ leaves-message String
    (param diagnostic TypeDiagnostic)
    (param base String)
    (case? (or (not (. diagnostic name)) (not (call known (. diagnostic from))))
      base
    )
    (default
      (str names " can leave \"" name "\", which does not declare it; declare it" example catching)
    )
    (where
      (lazy name (. (!! (. diagnostic name)) text))
      (lazy names (call type-short-name types (. diagnostic from)))
      (lazy owner ([] (. program modules) (. diagnostic module)))
      (lazy example (call declaring-example owner name names))
      (lazy raising (call (. (call node-text (. owner tree) (. diagnostic syntax)) starts-with) "(throw "))
      (lazy catching (if-expr raising "" ", or catch it here"))
    )
  )
  (fn-do _ declaring-example String
    (param owner Module)
    (param name String)
    (param names String)
    (for (in decl (. owner decls))
      (match? decl
        (case (call .decl-function fn)
          (if (and (. fn name) (== (. fn name text) name))
            (let header (call (. (call line-at (. owner tree) (. fn syntax)) trim)))
            (return (str ", as in \"" header " " (call brix-errors names) " …)\""))
          )
        )
      )
    )
    (return "")
  )
  (fn-expr _ coverage-message String
    (param diagnostic TypeDiagnostic)
    (param base String)
    (case? (and split on-result (not (call settled (. diagnostic from))))
      (str "This catch does not handle " (call listed cases) "; add a handler for " each ", or one for Error")
    )
    (case? (or (not split) (not (call settled (. diagnostic from))))
      base
    )
    (case? (and (== missing "present") (call known inner))
      (str matching " handles only null; add a case for a present value, as in \"" present "\", " rest)
    )
    (case? (== (. arms length) (. cases length))
      (str matching " does not handle " (call listed cases) "; add " (call listed arms) ", " rest)
    )
    (default
      (str matching " does not handle " (call listed cases) "; add a case for " each ", " rest)
    )
    (where
      (lazy split (call (. base find) "; missing "))
      (lazy missing ([] base (... (+ split 10))))
      (lazy on-result (call (. base starts-with) "Non-exhaustive match for Result;"))
      (lazy matching (str "This match on " (if-expr on-result "Result" (call type-source types (. diagnostic from)))))
      (lazy inner (call optional-inner (. diagnostic from)))
      (lazy present (str "(case (: value " (call type-brix types inner) ") …)"))
      (lazy labels (call List (call (. missing split) ", ")))
      (lazy cases (call List (*> labels (call plain-label each))))
      (lazy arms (call List (*> (?> labels (call is-literal-label each)) (str "\"(case= " (call brix-label each) " …)\""))))
      (lazy each (if-expr (== (. cases length) 1) "it" "each"))
      (lazy rest "or \"(default …)\" for the rest")
    )
  )
  (fn-expr _ brix-label String
    (param label String)
    ; A case a match leaves out as Brix writes its value: a case named with its type, as in
    ; `Level.low`, is `(. Level low)`.
    (case? (== split null)
      label
    )
    (default
      (str "(. " ([] label (..< 0 split)) " " ([] label (... (+ split 1))) ")")
    )
    (where
      (lazy split (call (. label find) "."))
    )
  )
  (fn-expr _ is-literal-label Bool
    (param label String)
    (or (== label "true") (== label "false") (== label "null") qualified)
    (where
      (lazy qualified (and (!= (call (. label find) ".") null) (not (call (. label starts-with) "."))))
    )
  )
  (fn-expr _ endpoint-message String
    (param diagnostic TypeDiagnostic)
    (str "Event endpoints provide Broadcastable'" provided ", not " (call type-source types (. diagnostic to)))
    (where
      (lazy provided (call type-source types (. diagnostic from)))
    )
  )
  (fn-expr _ plain-label String
    (param label String)
    (if-expr (== label "present") "a present value" label)
  )
  (fn-expr _ listed String
    (param names (list String))
    (match (. names length)
      (case= 0
        ""
      )
      (case= 1
        ([] names 0)
      )
      (default
        (str (call (. ", " join) ([] names (..< 0 (- (. names length) 1)))) " and " ([] names (- (. names length) 1)))
      )
    )
  )
  (fn-do _ function-at (? FunctionDecl)
    (param owner Module)
    (param syntax SyntaxId)
    (for (in decl (. owner decls))
      (match? decl
        (case (call .decl-function fn)
          (if (== (. fn syntax) syntax)
            (return fn)
          )
        )
      )
    )
    (return null)
  )
  (fn-do _ enclosing-function-decl (? FunctionDecl)
    (param owner Module)
    (param syntax SyntaxId)
    (let found (? FunctionDecl))
    (for (in decl (. owner decls))
      (match? decl
        (case (call .decl-function fn)
          (let start (. fn subtree start))
          (let inside (and (>= syntax start) (< syntax (+ start (. fn subtree count)))))
          (if (and inside (. fn name) (or (not found) (< (. fn subtree count) (. found subtree count))))
            (= found fn)
          )
        )
      )
    )
    (return found)
  )
  (fn-do _ arguments-text (? String)
    (param diagnostic TypeDiagnostic)
    (param operands (of RowRange SyntaxId))
    (let tree (. ([] (. program modules) (. diagnostic module)) tree))
    (let positional (list String))
    (let labeled "")
    (for (in offset (..< 0 (. operands count)))
      (let operand ([] (. tree children) (+ (. operands start) offset)))
      (let expr operand)
      (let label (? Atom))
      (match? ([] (. tree nodes) operand)
        (case (call .node-argument row)
          (= expr (. row expr))
          (= label (. row name))
        )
      )
      (let type (call (. facts node-type) (. diagnostic instance) expr))
      (if (not (call known type))
        (return null)
      )
      (if label
        (+= labeled (str " " (. label text) " " (call type-source types type)))
        (else
          (+= positional (call type-source types type))
        )
      )
    )
    (return-if (call (. labeled trim)) (if (and (== (. positional length) 0) (!= (. labeled length) 0))))
    (return (str "(" (call (. ", " join) positional) ")" labeled))
  )
  (fn-expr _ private-note String
    (param hidden (list String))
    (if-expr (== (. hidden length) 0) "" (str "; " (call (. " and " join) hidden) " " verb " private to its module"))
    (where
      (lazy verb (if-expr (== (. hidden length) 1) "is" "are"))
    )
  )
  (fn-expr _ family-note String
    (param shared (list String))
    (if-expr (== (. shared length) 0) "" (str "; " (call (. " and " join) shared) " " verb " shared with its file family"))
    (where
      (lazy verb (if-expr (== (. shared length) 1) "is" "are"))
    )
  )
  (fn-do _ keeps Bool
    (param caller ModuleId)
    (param module ModuleId)
    (param access Access)
    (param kept (? Access))
    ; Whether a declaration of a module with an access belongs in a list of signatures: one the caller
    ; reaches, for a list of none kept, or one kept from the caller by the access the list is of.
    (let reached (call (. program reaches-access) caller module access))
    (if (not kept)
      (return reached)
    )
    (return (and (not reached) (== access kept)))
  )
  (fn-expr _ is-letter Bool
    (param text String)
    (and (!= (. text length) 0) (or (and (>= text "a") (<= text "z")) (and (>= text "A") (<= text "Z"))))
  )
  (fn-expr _ operator-name String
    (param name String)
    (case? (call (. name starts-with) "<-")
      "<-"
    )
    (case? (== name "-neg")
      "-"
    )
    (default
      name
    )
  )
  (fn-expr _ accepting String
    (param given (? String))
    (if-expr given (str " accepts " given) " matches these arguments")
  )
  (fn-expr _ declared-as String
    (param signatures (list String))
    (str "it is declared as " (call (. " or " join) signatures))
  )
  (fn-do _ visible-signatures (list String)
    (param caller ModuleId)
    (param name Atom)
    (param kind DeclKind)
    (param kept (? Access))
    (let found (list String))
    (for (in candidate (call (. program lookup) caller name))
      (let owner ([] (. program modules) (. candidate module)))
      (if (call (. owner name ends-with) ".h")
        (continue)
      )
      (match? ([] (. owner decls) (. candidate decl))
        (case (call .decl-function fn)
          (let open (call keeps caller (. candidate module) (. fn access) kept))
          (if (and (== (. fn owner) 0) (== (. fn kind) kind) open (< (. found length) 3))
            (+= found (call signature owner fn))
          )
        )
      )
    )
    (return found)
  )
  (fn-do _ member-signatures (list String)
    (param caller ModuleId)
    (param receiver TypeId)
    (param name Atom)
    (param kept (? Access))
    (param added (of RowRange DeclRef) (= (call (of RowRange DeclRef))))
    (let found (list String))
    (for (in ref (call member-refs receiver added))
      (let owner ([] (. program modules) (. ref module)))
      (match? ([] (. owner decls) (. ref decl))
        (case (call .decl-function fn)
          (let open (call keeps caller (. ref module) (. fn access) kept))
          (let wanted (and (== (. fn name) name) (== (. fn kind) .function-decl)))
          (if (and wanted open (< (. found length) 3))
            (+= found (call signature owner fn))
          )
        )
      )
    )
    (return found)
  )
  (fn-do _ member-refs (list DeclRef)
    (param receiver TypeId)
    (param added (of RowRange DeclRef))
    (let refs (list DeclRef))
    (let current receiver)
    (let depth 0)
    (while (and (call settled current) (< depth 16))
      (match? ([] (. types rows) current)
        (case (call .type-class row)
          (let owner ([] (. program modules) (. row module)))
          (match? ([] (. owner decls) (. row decl))
            (case (call .decl-class class)
              (for (in offset (..< 0 (. class members count)))
                (+= refs (call DeclRef (. row module) ([] (. owner member-pool) (+ (. class members start) offset))))
              )
            )
          )
        )
      )
      (= current (. (call (. types completion-of) current) base))
      (+= depth 1)
    )
    (++= refs ([] (. facts diagnostic-members) (..< (. added start) (. added end))))
    (return refs)
  )
  (fn-do _ is-of-class Bool
    (param receiver TypeId)
    (param module ModuleId)
    (param decl DeclId)
    ; Whether a type is a class a module declares, or a class below it.
    (let current receiver)
    (let depth 0)
    (while (and (call settled current) (< depth 16))
      (match? ([] (. types rows) current)
        (case (call .type-class row)
          (return-if true (if (and (== (. row module) module) (== (. row decl) decl))))
        )
      )
      (= current (. (call (. types completion-of) current) base))
      (+= depth 1)
    )
    (return false)
  )
  (fn-expr _ class-declares Bool
    (param type TypeId)
    (param name Atom)
    (and (call settled type) (or (!= (call (. types property-named) type name) null) (!= (+ visible hidden shared) 0)))
    (where
      (lazy visible (. (call member-signatures 0 type name null) length))
      (lazy hidden (. (call member-signatures 0 type name (. Access private-access)) length))
      (lazy shared (. (call member-signatures 0 type name (. Access family-access)) length))
    )
  )
  (fn-do _ signature String
    (param owner Module)
    (param fn FunctionDecl)
    (param named (? String) (= null))
    (param labeled Bool (= true))
    ; A function as a call of it is written, with each parameter's name and type, or with its type
    ; alone where the names are not `labeled`, as a C function's are not.
    (let tree (. owner tree))
    (let written (list String))
    (for (in offset (..< 0 (. fn args count)))
      (let shape ([] (. owner arg-pool) (+ (. fn args start) offset)))
      (let label (if-expr (and labeled (. shape name)) (. shape name text) ""))
      (let typed (if-expr (!= (. shape type-syntax) 0) (call written-type tree (. shape type-syntax)) ""))
      (+= written (call (. (str label " " typed) trim)))
    )
    (let name (?? named (if-expr (. fn name) (. fn name text) "?")))
    (let params (if-expr (!= (. written length) 0) (str "(" (call (. ", " join) written) ")") ""))
    (return (str "\"" name params "\""))
  )
  (fn-do _ visible-facet (? U32)
    (param caller ModuleId)
    (param name Atom)
    ; The facet a name names where the caller sees it, and sees no class of the name.
    (return-if null (if (call visible-type caller name)))
    (for (in candidate (call (. program lookup) caller name))
      (match? ([] (. ([] (. program modules) (. candidate module)) decls) (. candidate decl))
        (case (call .decl-extension row)
          (if (== (. row facet) name)
            (return (call (. program facets index-of) (. candidate module) (. candidate decl)))
          )
        )
      )
    )
    (return null)
  )
  (fn-do _ visible-type Bool
    (param caller ModuleId)
    (param name Atom)
    (for (in candidate (call (. program lookup) caller name))
      (match? ([] (. ([] (. program modules) (. candidate module)) decls) (. candidate decl))
        (case .decl-class
          (return true)
        )
      )
    )
    (return false)
  )
  (fn-do _ absent-hint (? String)
    (param caller ModuleId)
    (param name Atom)
    (param wants-type Bool)
    (let importer (. ([] (. program modules) caller) name))
    (for (in absent (. program absent-imports))
      (if (and (== (. absent module) importer) (call (. index file-declares) (. absent path) (. name text) wants-type))
        (let file (?? (call last (call (. absent path split) "/")) (. absent path)))
        (return (str "it is only defined in " file ", which isn't part of " (. program target name) " builds"))
      )
    )
    (return null)
  )
  (fn-do _ unimported-hint (? String)
    (param caller ModuleId)
    (param name Atom)
    (param wants-type Bool)
    (let places (list String))
    (for (in candidate (call (. program unseen-declarations) caller name))
      (let owner ([] (. program modules) (. candidate module)))
      (if (or (call (. owner name ends-with) ".h") (not (call declares-public owner (. candidate decl) wants-type)))
        (continue)
      )
      (let line (call import-line caller owner))
      (if (== (call (. places find) line) null)
        (+= places line)
      )
    )
    (if (== (. places length) 0)
      (for (in line (call (. index modules-declaring) (. name text) wants-type))
        (if (< (. places length) 3)
          (+= places line)
        )
      )
    )
    (return-if null (if (== (. places length) 0)))
    (let missing "which this module does not import")
    (if (== (. places length) 1)
      (return (str "it is declared in " ([] places 0) ", " missing ". Add the import " ([] places 0)))
    )
    (return (str "it is declared in " (call (. " and " join) places) ", " missing ". Import one of them"))
  )
  (fn-expr _ declares-public Bool
    (param owner Module)
    (param decl DeclId)
    (param wants-type Bool)
    (match ([] (. owner decls) decl)
      (case (call .decl-class class)
        (and wants-type (call is-public (. class access)))
      )
      (case .decl-unit
        wants-type
      )
      (case (call .decl-function fn)
        (and (not wants-type) (== (. fn owner) 0) (== (. fn kind) .function-decl) (call is-public (. fn access)))
      )
      (case (call .decl-property property)
        (and (not wants-type) (== (. property owner) 0) (call is-public (. property access)))
      )
      (default
        false
      )
    )
  )
  (fn-do _ import-line String
    (param caller ModuleId)
    (param owner Module)
    (let whole (call absolute-parts (. owner path)))
    (for (in root (. index roots))
      (let base (as root String))
      (return-if (str "/" (call collapsed (. owner name))) (if (call starts-with-parts whole (call absolute-parts base))))
    )
    (return-if (str "/" (call collapsed (. owner name))) (if (== (. index roots length) 0)))
    (let origin (. ([] (. program modules) caller) path))
    (let directory (call absolute-parts origin))
    (if (!= (. origin length) 0)
      (call (. directory pop))
    )
    (let shared 0)
    (while (and (< shared (. directory length)) (< shared (. whole length)) (== ([] directory shared) ([] whole shared)))
      (+= shared 1)
    )
    (let parts (list String))
    (for (in _ (..< shared (. directory length)))
      (+= parts "..")
    )
    (for (in part ([] whole (... shared)))
      (+= parts part)
    )
    (let written (call (. "/" join) parts))
    (let stem (?? (call source-stem written) written))
    (return (call collapsed (if-expr (call (. stem starts-with) "..") stem (str "./" stem))))
  )
  (fn-do _ absolute-parts (list String)
    (param path String)
    (let whole (if-expr (call (. path starts-with) "/") path (str (call cwd) "/" path)))
    (let parts (list String))
    (for (in part (call (. whole split) "/"))
      (if (== part "..")
        (if (!= (. parts length) 0)
          (call (. parts pop))
        )
        (else-if (and (!= (. part length) 0) (!= part "."))
          (+= parts part)
        )
      )
    )
    (return parts)
  )
  (fn-expr _ starts-with-parts Bool
    (param whole (list String))
    (param prefix (list String))
    (and (< (. prefix length) (. whole length)) (== ([] whole (..< 0 (. prefix length))) prefix))
  )
  (fn-expr _ collapsed String
    (param name String)
    (if-expr (and slash (call (. head ends-with) tail) (or (== head tail) (call (. head ends-with) (str "/" tail)))) head name)
    (where
      (lazy slash (call (. name find-reverse) "/"))
      (lazy head ([] name (..< 0 slash)))
      (lazy tail ([] name (... (+ slash 1))))
    )
  )
  (fn-do _ optional-inner TypeId
    (param type TypeId)
    (if (or (not (call settled type)) (!= (. (call (. types completion-of) type) intrinsic) .optional))
      (return no-type)
    )
    (match? ([] (. types rows) type)
      (case (call .type-class row)
        (return (call (. types child-type) (. row args) 0))
      )
    )
    (return no-type)
  )
  (fn-expr _ known Bool
    (param type TypeId)
    (and (!= type no-type) (!= type invalid-type))
  )
  (fn-expr _ settled Bool
    (param type TypeId)
    (and (call known type) (== (. ([] (. types completions) type) completion) .completion-done))
  )
  (fn-expr _ written-name (? String)
    (param tree AST)
    (param id SyntaxId)
    (match? ([] (. tree nodes) id)
      (case (call .node-identifier row)
        (. row name text)
      )
      (case (call .node-ref-identifier row)
        (. row name text)
      )
      (case (call .node-type-identifier row)
        (. row name text)
      )
      (case (call .node-type-arguments row)
        (call written-name tree (. row base))
      )
      (case (call .node-type-capture row)
        (call written-name tree (. row id))
      )
      (case (call .node-get-expression row)
        (. row name text)
      )
    )
  )
  (fn-do _ node-text String
    (param tree AST)
    (param id SyntaxId)
    (let loc ([] (. tree nodes loc) id))
    (let line (call source-line (. tree source) (. loc begin line)))
    (let start (as (. loc begin column) Index))
    (return-if "" (if (>= start (. line length))))
    (let end (. line length))
    (if (and (== (. loc end line) (. loc begin line)) (< (. loc end column) (. line length)))
      (= end (+ (. loc end column) 1))
    )
    (return (call (. ([] line (..< start end)) trim)))
  )
  (fn-expr _ is-name-char Bool
    (param char Char)
    (or letter (and (>= char '0') (<= char '9')) (== char '-') (== char '_'))
    (where
      (lazy letter (or (and (>= char 'a') (<= char 'z')) (and (>= char 'A') (<= char 'Z'))))
    )
  )
  (fn-do _ source-line String
    (param source String)
    (param line U32)
    (let current 0u32)
    (let text "")
    (for (in char source)
      (if (== char (char "\n"))
        (if (== current line)
          (return text)
        )
        (+= current 1)
        (else-if (== current line)
          (+= text char)
        )
      )
    )
    (return text)
  )
  (fn-do _ member-names (list String)
    (param caller ModuleId)
    (param receiver TypeId)
    (let found (list String))
    (let current receiver)
    (let depth 0)
    (while (and (call settled current) (< depth 16))
      (match? ([] (. types rows) current)
        (case (call .type-class row)
          (let owner ([] (. program modules) (. row module)))
          (match? ([] (. owner decls) (. row decl))
            (case (call .decl-class class)
              (call collect-members owner (. class members) found)
            )
          )
          (for (in extension (call (. program extensions-for) caller (. row module) (. row decl)))
            (let extender ([] (. program modules) (. extension module)))
            (match? ([] (. extender decls) (. extension decl))
              (case (call .decl-extension extended)
                (call collect-members extender (. extended members) found)
              )
            )
          )
        )
      )
      (= current (. (call (. types completion-of) current) base))
      (+= depth 1)
    )
    (return found)
  )
  (fn-do _ collect-members _
    (param owner Module)
    (param members (of RowRange DeclId))
    (param found (list String))
    (for (in offset (..< 0 (. members count)))
      (let member ([] (. owner member-pool) (+ (. members start) offset)))
      (let name
        (match? ([] (. owner decls) member)
          (case (call .decl-function fn)
            (only-if (. fn name) (if (or (== (. fn kind) .function-decl) (== (. fn kind) .getter-decl))))
          )
          (case (call .decl-property property)
            (. property name)
          )
        )
      )
      (if (and name (== (call (. found find) (. name text)) null))
        (+= found (. name text))
      )
    )
  )
  (fn-do _ local-names (list String)
    (param module ModuleId)
    (param syntax SyntaxId)
    (let found (list String))
    (for (in binding (. bindings bindings))
      (let start (. binding subtree start))
      (if (and (== (. binding module) module) (>= syntax start) (< syntax (+ start (. binding subtree count))))
        (for (in slot ([] (. bindings slots) (. binding slots)))
          (let text (. slot name text))
          (if (and (call is-named-slot (. slot kind)) (!= (. text length) 0) (== (call (. found find) text) null))
            (+= found text)
          )
        )
      )
    )
    (return found)
  )
  (fn-expr _ is-named-slot Bool
    (param kind SlotKind)
    (match kind
      (case= .slot-local
        true
      )
      (case= .slot-argument
        true
      )
      (case= .slot-lazy
        true
      )
      (case= .slot-pattern
        true
      )
      (case= .slot-loop-item
        true
      )
      (default
        false
      )
    )
  )
  (fn-expr _ visible-name-texts (list String)
    (param caller ModuleId)
    (param wants-type Bool)
    (call List
      (block
        (spread (call (. program visible-names) caller))
        (pipe *> (. each text))
        (pipe ?> (and (!= (. each length) 0) (== (call is-type-name each) wants-type)))
      )
    )
  )
  (fn-expr _ is-type-name Bool
    (param name String)
    (and (>= ([] name (..< 0 1)) "A") (<= ([] name (..< 0 1)) "Z"))
  )
  (fn-do _ suggested String
    (param name String)
    (param candidates (list String))
    (let folded-name (call folded name))
    (let limit
      (block
        (case? (<= (. name length) 2)
          0
        )
        (case? (<= (. name length) 4)
          1
        )
        (case? (<= (. name length) 8)
          2
        )
        (default
          3
        )
      )
    )
    (let best (list String))
    (let best-distance (+ limit 1))
    (for (in candidate candidates)
      (if (== candidate name)
        (continue)
      )
      (let gap (if-expr (== (call folded candidate) folded-name) 0 (call distance folded-name (call folded candidate))))
      (if (> gap limit)
        (continue)
      )
      (if (< gap best-distance)
        (= best-distance gap)
        (= best (list candidate))
        (else-if (and (== gap best-distance) (== (call (. best find) candidate) null))
          (+= best candidate)
        )
      )
    )
    (if (== (. best length) 0)
      (return "")
    )
    (let ordered (list String) (call sort best))
    (let quoted (list String))
    (for (in candidate ordered)
      (if (< (. quoted length) 3)
        (+= quoted (str "\"" candidate "\""))
      )
    )
    (if (== (. quoted length) 1)
      (return (str "; did you mean " ([] quoted 0) "?"))
    )
    (return (str "; did you mean " (call (. ", " join) ([] quoted (..< 0 (- (. quoted length) 1)))) " or " ([] quoted (- (. quoted length) 1)) "?"))
  )
  (fn-do _ folded String
    (param name String)
    (let text "")
    (for (in char name)
      (if (and (!= char '-') (!= char '_'))
        (+= text (. char lowercase))
      )
    )
    (return text)
  )
  (fn-do _ distance Index
    (param left String)
    (param right String)
    (let a (list Char))
    (for (in char left)
      (+= a char)
    )
    (let b (list Char))
    (for (in char right)
      (+= b char)
    )
    (let prior (list Index))
    (for (in column (.. 0 (. b length)))
      (+= prior column)
    )
    (for (in row (..< 0 (. a length)))
      (let current (list Index))
      (+= current (+ row 1))
      (for (in column (..< 0 (. b length)))
        (let cost (if-expr (== ([] a row) ([] b column)) 0 1))
        (let step (+ ([] prior column) cost))
        (let shift (+ ([] current column) 1))
        (let drop (+ ([] prior (+ column 1)) 1))
        (+= current
          (scope (if-expr (and (<= step shift) (<= step drop)) step cheaper)
            (lazy cheaper (if-expr (<= shift drop) shift drop))
          )
        )
      )
      (= prior current)
    )
    (return ([] prior (. b length)))
  )
)

(type + DeclarationIndex
  (prop + roots (list Path))
  (prop + target Target)
  (prop _ types (map String (list String)))
  (prop _ values (map String (list String)))
  (prop _ built Bool)
  (fn-do + This _
    (param roots (list Path))
    (param target Target)
  )
  (fn-do + modules-declaring (list String)
    (param name String)
    (param wants-type Bool)
    (if (not built)
      (= built true)
      (for (in root roots)
        (call scan root "")
      )
    )
    (let none (list String))
    (return (?? (if-expr wants-type (?? ([] types name) ([] values name)) ([] values name)) none))
  )
  (fn-do + file-declares Bool
    (param path String)
    (param name String)
    (param wants-type Bool)
    (let file-types (map String (list String)))
    (let file-values (map String (list String)))
    (call read-module (call Path path) path file-types file-values)
    (return (!= ([] (if-expr wants-type file-types file-values) name) null))
  )
  (fn-do _ scan _
    (param directory Path)
    (param prefix String)
    (let listed (catch? (call entries-of directory)))
    (if (not listed)
      (return)
    )
    (for (in entry listed)
      (if (or (call (. entry name starts-with) "_") (call (. entry name starts-with) "."))
        (continue)
      )
      (if (== (. entry kind) (. PathKind directory))
        (if (call skipped-directory (. entry name))
          (continue)
        )
        (call scan (/ directory (. entry name)) (str prefix (. entry name) "/"))
        (else-if (and (call source-stem (. entry name)) (call (. target includes) (call platform-suffix (. entry name))))
          (call read-module
            (block
              (arg (/ directory (. entry name)))
              (arg (call import-name prefix (!! (call source-stem (. entry name)))))
              (arg types)
              (arg values)
            )
          )
        )
      )
    )
  )
  (fn-expr _ skipped-directory Bool
    (param name String)
    (or (== name "tests") (== name "stress") (== name "fixtures") (== name "bench") (== name "lang"))
  )
  (fn-expr _ import-name String
    (param prefix String)
    (param stem String)
    (case? (and (!= (. prefix length) 0) (== prefix (str stem "/")))
      (str "/" stem)
    )
    (case? (call (. prefix ends-with) (str "/" stem "/"))
      (str "/" ([] prefix (..< 0 (- (. prefix length) 1))))
    )
    (default
      (str "/" prefix stem)
    )
  )
  (fn-do _ read-module _
    (param path Path)
    (param line String)
    (param type-table (map String (list String)))
    (param value-table (map String (list String)))
    (let text (catch? (call read-file-text path)))
    (if (not text)
      (return)
    )
    (for (in row (call (. text split) "\n"))
      (for (in head (list "type" "type-line"))
        (let name (call brix-declared-name row head))
        (if (!= (. name length) 0)
          (call add type-table name line)
        )
      )
      (for (in head (list "fn-do" "fn-expr"))
        (let name (call brix-declared-name row head))
        (if (!= (. name length) 0)
          (call add value-table name line)
        )
      )
    )
  )
  (fn-expr _ brix-declared-name String
    (param row String)
    (param head String)
    (if-expr (call (. row starts-with) lead) (call leading-name declared) "")
    (where
      (lazy lead (str "(" head " + "))
      (lazy rest ([] row (... (. lead length))))
      (lazy declared (if-expr (call (. rest starts-with) "(of ") ([] rest (... 4)) rest))
    )
  )
  (fn-do _ add _
    (param table (map String (list String)))
    (param name String)
    (param line String)
    (let held ([] table name))
    (if (not held)
      (= ([] table name) (list line))
      (else-if (== (call (. held find) line) null)
        (= ([] table name) (++ held (list line)))
      )
    )
  )
  (fn-do _ leading-name String
    (param text String)
    (let name "")
    (for (in char text)
      (let letter (or (and (>= char 'a') (<= char 'z')) (and (>= char 'A') (<= char 'Z'))))
      (if (or letter (and (>= char '0') (<= char '9')) (== char '-'))
        (+= name char)
        (else
          (break)
        )
      )
    )
    (return name)
  )
)

(fn-expr _ entries-of (list PathEntry) (?! Error)
  (param directory Path)
  (call List (. directory entries))
)
