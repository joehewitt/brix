(import /lang/ast/ast)
(import /lang/ast/ast-nodes)
(import /lang/ast/decl)
(import /lang/ast/module)
(import /lang/ast/program)
(import /lang/check/facts)
(import /lang/check/instances)
(import /lang/check/session)
(import /lang/check/type-store)
(import /lang/check/type-text)
(import /lang/check/types)
(import /stream/aggregate)

(type + InferredParam (is Tuple)
  (prop + position U32)
  (prop + syntax SyntaxId)
  (prop + type String)
)

(type + InferredHeader (is Tuple)
  (prop + returns (? String))
  (prop + errors (list String))
  (prop + params (list InferredParam))
  (prop + differs (? String))
  (fn-expr + is-empty Bool :get
    (and (not returns) (== (. errors length) 0) (== (. params length) 0) (not differs))
  )
)

(fn-do + inferred-header (? InferredHeader)
  (param session Session)
  (param module ModuleId)
  (param decl DeclId)
  (param copies (list InstanceId))
  (return-if null (if (== (. copies length) 0)))
  (match? ([] (. ([] (. session program modules) module) decls) decl)
    (case (call .decl-function fn)
      (return (call (. (call HeaderReading session module fn copies) read)))
    )
  )
  (return null)
)

(type _ HeaderReading
  (prop + session Session)
  (prop + module ModuleId)
  (prop + fn FunctionDecl)
  (prop + copies (list InstanceId))
  (fn-do + This _
    (param session _)
    (param module _)
    (param fn _)
    (param copies _)
  )
  (fn-do + read InferredHeader
    (let chosen (call default-copy))
    (let params (list InferredParam))
    (let shapes (. ([] (. session program modules) module) arg-pool))
    (for (in position (..< 0 (. fn args count)))
      (let shape ([] shapes (+ (. fn args start) position)))
      (if (and (== (. shape type-syntax) 0) (== (. shape default-syntax) 0) (!= (. shape pattern) 0))
        (let type (call agreed (as position U32)))
        (if (!= type no-type)
          (+= params
            (call InferredParam
              (block
                (arg (as position U32))
                (arg (. shape pattern))
                (arg (call type-source (. session types) type))
              )
            )
          )
        )
      )
    )
    (let infers-return (and (== (. fn return-type) 0) (!= (. fn kind) .constructor-decl) (!= (. fn kind) .setter-decl)))
    (let returns (only-if (call returned chosen) (if infers-return)))
    (let errors (list String))
    (let differs (list String))
    (if (== (. fn errors count) 0)
      (let shared (call shared-errors chosen))
      (for (in error shared)
        (+= errors (call type-source (. session types) error))
      )
      (let extra (call extra-errors shared))
      (if (!= (. extra length) 0)
        (+= differs
          (paragraph
            (str (if-expr (call varies) "Some uses" "Copies made for other callers") " also raise " (call (. " | " join) extra))
          )
        )
      )
    )
    (if (and infers-return (not (call varies)) (call returns-differ chosen))
      (+= differs "Copies made for other callers return other types")
    )
    (return (call InferredHeader returns errors params (if-expr (== (. differs length) 0) null (call (. "; " join) differs))))
  )
  (fn-do _ default-copy InstanceId
    (for (in copy copies)
      (return-if copy (if (== (. ([] (. session instances rows) copy) effects) 0)))
    )
    (return ([] copies 0))
  )
  (fn-do _ varies Bool
    (for (in position (..< 0 (. fn args count)))
      (let first (call (. session instances argument-type) ([] copies 0) (as position U32)))
      (for (in copy copies)
        (return-if true (if (!= (call (. session instances argument-type) copy (as position U32)) first)))
      )
    )
    (return false)
  )
  (fn-do _ agreed TypeId
    (param position U32)
    (let first (call (. session instances argument-type) ([] copies 0) position))
    (return-if no-type (if (== first invalid-type)))
    (for (in copy copies)
      (return-if no-type (if (!= (call (. session instances argument-type) copy position) first)))
    )
    (return first)
  )
  (fn-do _ returned (? String)
    (param chosen InstanceId)
    (let types (. session types))
    (let given (. ([] (. session instances signatures) chosen) returns))
    (return-if null (if (or (== given no-type) (== given invalid-type) (== given (. types void-type)))))
    (return-if (call type-source types given) (if (not (call varies))))
    (let same (call all copies (:where (== (. ([] (. session instances signatures) each) returns) given))))
    (return-if (call type-source types given) (if same))
    (let tree (. ([] (. session program modules) module) tree))
    (for (in position (..< 0 (. fn type-args count)))
      (let bound (call all copies (:where (== (. ([] (. session instances signatures) each) returns) (call (. session instances param-type) each position)))))
      (let name (call (. types class-param-name) tree (. fn type-args) position))
      (return-if (. name text) (if (and bound name)))
    )
    (let owned (call (. types class-type-args) module (. fn owner)))
    (for (in position (..< 0 (. owned count)))
      (let bound (call all copies (:where (== (. ([] (. session instances signatures) each) returns) (call class-arg types (. ([] (. session instances rows) each) self-type) (as position U32))))))
      (let name (call (. types class-param-name) tree owned position))
      (return-if (. name text) (if (and bound name)))
    )
    (return null)
  )
  (fn-do _ returns-differ Bool
    (param chosen InstanceId)
    (let given (. ([] (. session instances signatures) chosen) returns))
    (return (call some copies (:where (!= (. ([] (. session instances signatures) each) returns) given))))
  )
  (fn-do _ errors-of (list TypeId)
    (param copy InstanceId)
    (let instances (. session instances))
    (let found (list TypeId))
    (if (not (call (. instances errors-known) copy))
      (return found)
    )
    (for (in position (..< 0 (. ([] (. instances signatures) copy) errors count)))
      (+= found (call (. instances error-type) copy position))
    )
    (return found)
  )
  (fn-do _ shared-errors (list TypeId)
    (param chosen InstanceId)
    (let shared (list TypeId))
    (let sets (list (list TypeId)))
    (for (in copy copies)
      (+= sets (call errors-of copy))
    )
    (for (in error (call errors-of chosen))
      (if (or (not (call varies)) (call all sets (:where (!= (call (. each find) error) null))))
        (+= shared error)
      )
    )
    (return shared)
  )
  (fn-do _ extra-errors (list String)
    (param shared (list TypeId))
    (let seen (map TypeId Bool))
    (for (in error shared)
      (= ([] seen error) true)
    )
    (let extra (list String))
    (for (in copy copies)
      (for (in error (call errors-of copy))
        (if (== ([] seen error) null)
          (= ([] seen error) true)
          (+= extra (call type-source (. session types) error))
        )
      )
    )
    (return extra)
  )
)
