━━━━━━━━━━━━━━━━━━━━
+ node-location-text String
    - tree AST
    - id SyntaxId

"${loc.begin.line}:${loc.begin.column}"

.. loc = tree.nodes.loc[id]

━━━━━━━━━━━━━━━━━━━━
+ diagnostic-kind-name String
    - kind TypeDiagnosticKind

match kind
    |= .function-not-found
        "function-not-found"
    |= .constructor-not-found
        "constructor-not-found"
    |= .property-not-found
        "property-not-found"
    |= .literal-does-not-fit
        "literal-does-not-fit"
    |= .illegal-cast
        "illegal-cast"
    |= .return-after-recursion
        "return-after-recursion"
    |= .illegal-operation
        "illegal-operation"
    |= .circular-reference
        "circular-reference"
    |= .ambiguous-constructor
        "ambiguous-constructor"
    |= .ambiguous-static
        "ambiguous-static"
    |= .ambiguous-extension
        "ambiguous-extension"
    |= .extension-conflict
        "extension-conflict"
    |= .unable-to-unify-returns
        "unable-to-unify-returns"
    |= .invalid-bang-return
        "invalid-bang-return"
    |= .error-leaves-function
        "error-leaves-function"
    |= .error-leaves-generator
        "error-leaves-generator"
    |= .non-void-return
        "non-void-return"
    |= .explicit-return-requires-do
        "explicit-return-requires-do"
    |= .no-possible-matches
        "no-possible-matches"
    |= .stated
        "stated"
    |= .stated-unplaced
        "stated-unplaced"
    |= .unasked-unwrap
        "unasked-unwrap"
    |= .unasked-text
        "unasked-text"
    |= .unasked-narrowing
        "unasked-narrowing"
    |= .unasked-conversion
        "unasked-conversion"
    |= .restricted
        "restricted"
    |= .reached
        "reached"
    ??
        "not-supported"

━━━━━━━━━━━━━━━━━━━━
+ is-unlocated Bool
    - loc MatchLocation

loc.begin.line == 0 && loc.begin.column == 0 && loc.end.line == 0 && loc.end.column == 0

━━━━━━━━━━━━━━━━━━━━
+ is-pattern-answer Bool
    - tree AST
    - syntax SyntaxId

` Whether a node is an equality pattern, whose type is that of the answer of its `==` and
` is not one the program wrote.
match tree.nodes[syntax]
    | .node-type-equality
        true
    ??
        false

━━━━━━━━━━━━━━━━━━━━
+ is-on-line Bool
    - tree AST
    - syntax SyntaxId
    - line U32

line == U32.max || tree.nodes.loc[syntax].begin.line == line

━━━━━━━━━━━━━━━━━━━━
+ force-text String
    - types Types
    - tree AST
    - fact ForceFact

"${tree.nodes.loc[fact.syntax].begin.column}=${operand}->${result}$suffix"

.. operand = type-text(types, fact.operand)
.. result = type-text(types, fact.result)
.. suffix = if fact.is-narrowed then ":narrowed" else ""

.. program = types.program

━━━━━━━━━━━━━━━━━━━━
+ diagnostic-summary-text String
    - tree AST
    - diagnostic TypeDiagnostic

"${diagnostic-kind-name(diagnostic.kind)}:$shown@$location"

.. shown = if diagnostic.name then named.text else "-"
.. named = diagnostic.name
.. location = if diagnostic.syntax != 0 then node-location-text(tree, diagnostic.syntax) else "-"

━━━━━━━━━━━━━━━━━━━━
+ do loop-locations [String = Bool]
    - tree AST

` The locations of `for` blocks and loop headers. The TypeScript oracle cannot tell its own
` loop desugaring apart from a call or cast the source places there, such as a comprehension
` body, so it drops every call and cast at those locations and the Brix side drops the same.
. locations [String = Bool]
. total = tree.nodes.length as SyntaxId
for id in 1 .. < total
    do match? tree.nodes[id]
        | .node-loop-syntax
            locations[node-location-text(tree, id)] = true
        | .node-for-block
            locations[node-location-text(tree, id)] = true
= locations

━━━━━━━━━━━━━━━━━━━━
+ do synthesized-locations [String = Bool]
    - tree AST

` The locations of multi and optional feeds and of map and filter pipelines. The TypeScript
` compiler lowers each through nodes it synthesizes at that location, the loop item, the
` optional's capture, and the closure's argument, whose types have no source node on either
` side, so both oracles drop the type lines there.
. locations [String = Bool]
. total = tree.nodes.length as SyntaxId
for id in 1 .. < total
    do match? tree.nodes[id]
        | .node-feed-expression(row)
            if row.is-spread || row.is-optional
                locations[node-location-text(tree, id)] = true
        | .node-pipeline-expression(row)
            if is-pipeline-closure(row.op)
                locations[node-location-text(tree, id)] = true
= locations

━━━━━━━━━━━━━━━━━━━━
+ do is-listed-instance Bool
    - program Program
    - row Instance

. listed = !program.modules[row.module].name.ends-with(".h")
do match? program.modules[row.module].decls[row.decl]
    | .decl-function(fn)
        listed = listed && fn.kind != .main-decl && fn.kind != .task-decl
        listed = listed && !is-startup-kind(fn.kind) && fn.kind != .termination-panic-decl
= listed

━━━━━━━━━━━━━━━━━━━━
_ instance-self TypeId
    - program Program
    - row Instance

match program.modules[row.module].decls[row.decl]
    | .decl-function(fn)
        if fn.is-static then no-type else row.self-type
    | .decl-fromverter
        no-type
    ??
        row.self-type

━━━━━━━━━━━━━━━━━━━━
_ do instance-head String
    - types Types
    - module ModuleId
    - decl DeclId

. program = types.program
. owner-module = program.modules[module]
do match? owner-module.decls[decl]
    | .decl-function(row)
        if row.kind == .closure-decl || row.kind == .feed-decl
            . loc = owner-module.tree.nodes.loc[row.syntax]
            = "closure ${owner-module.name}:${loc.begin.line}:${loc.begin.column}"
        if row.kind == .iterator-decl || row.kind == .pipeline-decl
            . loc = owner-module.tree.nodes.loc[row.syntax]
            . line = (loc.begin.line as I64) - 1
            = "closure ${owner-module.name}:$line:${loc.begin.column}"
= decl-head(types, module, decl)

━━━━━━━━━━━━━━━━━━━━
+ is-traced-form Bool
    - form CallForm

named && is-written-form(form)

.. named = not-accessor && form != .call-closure && form != .call-converter
.. not-accessor = form != .call-getter && form != .call-setter && form != .call-store-setter

━━━━━━━━━━━━━━━━━━━━
+ is-written-form Bool
    - form CallForm

` Whether a call of a form is one the source writes. The calls a list written makes are not,
` nor is the store through an inner index, nor the construction of an enum for a number
` converted to it, nor a task spawned.
unprobed && form != .call-probe && form != .call-probe-head && form != .call-probe-metric

.. made = form == .call-list-make || form == .call-list-reserve || form == .call-list-data || appends
.. appends = form == .call-list-append
.. unprobed = direct && form != .call-view-range && form != .call-replaced
.. direct = !made && form != .call-store-through && form != .call-enum-default && !spawns-task(form)

━━━━━━━━━━━━━━━━━━━━
+ is-traced-call Bool
    - fact CallFact
    - instance InstanceId

own && fact.form != .call-converter && is-written-form(fact.form)

.. own = fact.instance == instance && fact.callee != no-instance

━━━━━━━━━━━━━━━━━━━━
_ pair-relation Relation
    - fact PairFact

relation

.. relation = Relation
    - fact.kind
    - fact.rank
    - fact.match
    - fact.from
    - fact.to
    - fact.unified
    - U32.max
    - no-type
    - fact.ratio
    - .reason-none
    - U32.max
    - 0

━━━━━━━━━━━━━━━━━━━━
+ ¶ relation-text
    - types Types
    - relation Relation

$name rank=${relation.rank} match=$match unified=$unified$ratio

════════════════════
.. program = types.program
.. unified = if relation.kind != .relation-illegal then type-key(types, relation.unified) else "-"
.. name = relation-name(relation.kind)
.. match U32 = relation.match
.. ratio = if equal then " ratio=${ratio-text(relation.ratio)}" else ""
.. equal = relation.kind == .relation-equal || relation.kind == .relation-common-equality

━━━━━━━━━━━━━━━━━━━━
+ do traced-self TypeId
    - types Types
    - module ModuleId
    - decl DeclId
    - self-type TypeId

. program = types.program
. owner-module = program.modules[module]
do match? owner-module.decls[decl]
    | .decl-function(row)
        if row.is-static
            = no-type
        if is-constructor-kind(row.kind) && row.owner != 0
            do match? owner-module.decls[row.owner]
                | .decl-class(class)
                    if class.type-args.count != 0
                        . env = types.class-env(module, row.owner)
                        . pattern = env.this-type
                        types.env-release(env)
                        = pattern
= self-type

━━━━━━━━━━━━━━━━━━━━
+ shown-params U32
    - types Types
    - module ModuleId
    - decl DeclId
    - param-count U32

if implicit <= param-count then param-count - implicit else 0u32

.. implicit = implicit-argument-count(types, module, decl)

.. program = types.program

━━━━━━━━━━━━━━━━━━━━
+ do decl-head String
    - types Types
    - module ModuleId
    - decl DeclId

. program = types.program
. owner-module = program.modules[module]
. module-name = owner-module.name
do match? owner-module.decls[decl]
    | .decl-function(row)
        . kind = head-kind(row)
        . owner = owner-label(types, module, row.owner)
        . name = function-name(row)
        if module-name.ends-with(".h")
            = "? $module-name:-:$name"
        if row.is-generated
            = "gen $module-name:$owner:${generated-kind(row.kind)}"
        . ordinal = 0
        . index = 0u32
        for other in owner-module.decls
            if index == decl
                break
            do match? other
                | .decl-function(earlier)
                    . plain = !earlier.is-generated && !is-nested-kind(earlier.kind)
                    if plain && earlier.owner == row.owner && head-kind(earlier) == kind
                        if function-name(earlier) == name
                            ordinal += 1
            index += 1
        = "$kind $module-name:$owner:$name#$ordinal"
    | .decl-converter(row)
        . owner = owner-label(types, module, row.owner)
        . ordinal = accessor-ordinal(program, module, decl, row.owner, true)
        = "to $module-name:$owner#$ordinal"
    | .decl-fromverter(row)
        . owner = owner-label(types, module, row.owner)
        . ordinal = accessor-ordinal(program, module, decl, row.owner, false)
        = "from $module-name:$owner#$ordinal"
= "?"

━━━━━━━━━━━━━━━━━━━━
_ do accessor-ordinal Size
    - program Program
    - module ModuleId
    - decl DeclId
    - owner DeclId
    - converters Bool

. ordinal Size = 0
. index = 0u32
for other in program.modules[module].decls
    if index == decl
        break
    do match? other
        | .decl-converter(row)
            if converters && row.owner == owner
                ordinal += 1
        | .decl-fromverter(row)
            if !converters && row.owner == owner
                ordinal += 1
    index += 1
= ordinal

━━━━━━━━━━━━━━━━━━━━
_ generated-kind String
    - kind DeclKind

match kind
    |= .tuple-constructor-decl
        "tuple"
    |= .cast-constructor-decl
        "cast"
    |= .index-span-source-constructor-decl
        "cast"
    |= .table-size-constructor-decl
        "size"
    |= .table-arena-constructor-decl
        "arena"
    |= .table-capacity-constructor-decl
        "arena-capacity"
    |= .table-filler-constructor-decl
        "filler"
    ??
        "default"

━━━━━━━━━━━━━━━━━━━━
_ head-kind String
    - row FunctionDecl

match row.kind
    |= .getter-decl
        if row.owner != 0 then "get" else "fn"
    |= .setter-decl
        if row.owner != 0 then "set" else "fn"
    ??
        "fn"

━━━━━━━━━━━━━━━━━━━━
_ function-name String
    - row FunctionDecl

|? !row.name
    "?"
|? atom.text.starts-with("(closure")
    "()"
??
    "".join(atom.text.split(" "))

.. atom = row.name

━━━━━━━━━━━━━━━━━━━━
_ do owner-label String
    - types Types
    - module ModuleId
    - owner DeclId

. program = types.program
if owner == 0
    = "-"
do match? program.modules[module].decls[owner]
    | .decl-class(row)
        = row.name.text
    | .decl-extension
        . env = extension-env(types, module, owner)
        . label = "ext:${type-key(types, env.this-type)}"
        types.env-release(env)
        = label
    | .decl-sheet-extension
        = "sheet-ext"
= "?"

━━━━━━━━━━━━━━━━━━━━
+ do binding-diagnostic-lines
    - bindings Bindings
    - program Program
    - module ModuleId
    - label String
    - lines [String]

. owner = program.modules[module]
. tree = owner.tree
. reported [DeclId]
for diagnostic in bindings.diagnostics
    if diagnostic.module != module || diagnostic.kind == .redeclared
        continue
    . holder = enclosing-function(owner, diagnostic.syntax)
    if holder != 0 && reported.find(holder) != null
        continue
    reported += holder
    . message = binding-diagnostic-message(diagnostic)
    lines += "diag $label ${node-extent-text(tree, diagnostic.syntax)} $message"

━━━━━━━━━━━━━━━━━━━━
+ do enclosing-function DeclId
    - owner Module
    - syntax SyntaxId

. found = 0u32
. narrowest = U32.max
. index = 0u32
for decl in owner.decls
    do match? decl
        | .decl-function(row)
            . start = row.subtree.start
            . inside = syntax >= start && syntax < start + row.subtree.count
            if inside && row.subtree.count < narrowest
                found = index
                narrowest = row.subtree.count
    index += 1
= found

━━━━━━━━━━━━━━━━━━━━
+ binding-diagnostic-message String
    - diagnostic Diagnostic

` A stated diagnostic's name is its whole message.
match diagnostic.kind
    |= .stated
        if diagnostic.name then diagnostic.name.text else ""
    |= .already-defined
        "Redefining variable in same scope"
    |= .redeclared
        "Redefining variable in same scope"
    |= .lazy-defined
        "Variable is already defined"
    |= .required-self
        "Required self not defined"
    |= .variable-not-declared
        "Variable not declared"
    |= .stream-not-found
        "Pattern has nothing to match"
    ??
        "Name not found"

━━━━━━━━━━━━━━━━━━━━
+ do node-extent-text String
    - tree AST
    - id SyntaxId

if id == 0
    = "-"
. loc = tree.nodes.loc[id]
. width = 1
if loc.end.line > loc.begin.line
    . length = line-length(tree.source, loc.begin.line)
    width = if length > loc.begin.column then length - loc.begin.column - 1 else 0
else if loc.end.column + 1 >= loc.begin.column
    width = loc.end.column + 1 - loc.begin.column
= "${loc.begin.line}:${loc.begin.column}+$width"

━━━━━━━━━━━━━━━━━━━━
+ do line-length Size
    - source String
    - line U32

. current = 0u32
. length = 0
for char in source
    if char == '\n'
        if current == line
            = length
        current += 1
        length = 0
    else if current == line
        length += 1
= length

━━━━━━━━━━━━━━━━━━━━
+ do diagnostic-message String
    - types Types
    - diagnostic TypeDiagnostic

. program = types.program
. shown = ""
if diagnostic.name
    . atom = diagnostic.name
    shown = atom.text
. source = diagnostic.from
. target = diagnostic.to
. raised = type-short-name(types, source)
= match diagnostic.kind
    |= .function-not-found
        "Function not found"
    |= .constructor-not-found
        "Constructor not found"
    |= .property-not-found
        "Property not found"
    |= .literal-does-not-fit
        "Integer literal $shown does not fit ${type-short-name(types, target)}"
    |= .illegal-cast
        "Illegal cast from $shown-source to $shown-target"
            .. shown-source = type-display(types, source)
            .. shown-target = type-display(types, target)
    |= .unasked-unwrap
        unwritten-message(types, source, target)
    |= .unasked-text
        unwritten-message(types, source, target)
    |= .unasked-narrowing
        unwritten-message(types, source, target)
    |= .unasked-conversion
        unwritten-message(types, source, target)
    |= .return-after-recursion
        "Can't infer return type after recursion"
    |= .illegal-operation
        "Illegal types for operation"
    |= .circular-reference
        "Circular reference"
    |= .ambiguous-constructor
        "Ambiguous constructor"
    |= .ambiguous-static
        "Ambiguous static method"
    |= .ambiguous-extension
        "Ambiguous extension member"
    |= .extension-conflict
        "Extension member conflicts with existing member"
    |= .unable-to-unify-returns
        "Unable to unify return types"
    |= .invalid-bang-return
        "$raised cannot be returned with ?!; $advice"
            .. advice = "return an Error subtype or use ?! Panic(...) to end the task."
    |= .error-leaves-function
        "$raised can leave function $shown; declare it with ?! $raised, or catch it here"
    |= .error-leaves-generator
        "$raised can leave generator $shown, which does not declare it; declare it with ?! $raised, or catch it here"
    |= .error-not-carried
        "$raised can leave this function, and $carrier; $advice"
            .. carrier = if is-c-function(types, target) then "a C function cannot carry it" else "$named does not carry it"
            .. named = type-short-name(types, target)
            .. advice = if is-c-function(types, target) then "catch it here" else "add ?! $raised to $named, or catch it here"
    |= .non-void-return
        "Non-do function must return a non-void value"
    |= .explicit-return-requires-do
        "Explicit return requires do"
    |= .no-possible-matches
        "Pattern has no possible matches"
    |= .stated
        shown
    |= .stated-unplaced
        shown
    |= .restricted
        shown
    |= .reached
        shown
    ??
        "Not supported"

━━━━━━━━━━━━━━━━━━━━
_ unwritten-message String
    - types Types
    - source TypeId
    - target TypeId

"Unwritten conversion from ${type-display(types, source)} to ${type-display(types, target)}"

━━━━━━━━━━━━━━━━━━━━
+ do diagnostic-text String
    - program Program
    - module ModuleId
    - syntax SyntaxId
    - message String
    - inset U32 = 0
    - span U32 = 0
    - sources ExcerptSources? = null

. owner = program.modules[module]
. path = display-path(owner.path)
if syntax == 0
    = "Exception: $message\n<$path>"
. loc = owner.tree.nodes.loc[syntax]
. own = use ExcerptSources(program)
= "Exception: $message\n<$path:${loc.begin.line + 1}>\n${(sources ?? own).excerpt(module, loc, inset, span)}"

━━━━━━━━━━━━━━━━━━━━
+ do related-text String
    - program Program
    - module ModuleId
    - syntax SyntaxId
    - label String
    - sources ExcerptSources? = null

` A second place a diagnostic points at: its label, where it is, and the line there.
. owner = program.modules[module]
. loc = owner.tree.nodes.loc[syntax]
. own = use ExcerptSources(program)
= "$label:\n<${display-path(owner.path)}:${loc.begin.line + 1}>\n${(sources ?? own).line(module, loc)}"

━━━━━━━━━━━━━━━━━━━━
+ display-path String
    - path String

if path.length != 0 then path else "no file"

━━━━━━━━━━━━━━━━━━━━
+ do keyed-text String
    - owner Module
    - syntax SyntaxId
    - text String

. line = 0u32
if syntax != 0
    line = owner.tree.nodes.loc[syntax].begin.line
. digits = "$line"
= "0" * (6 - digits.length) ++ digits ++ ":" ++ text

━━━━━━━━━━━━━━━━━━━━
+ FactsText

+ session Session
+ types Types
+ program Program
+ bindings Bindings
+ instances Instances
+ facts Facts
+ report DiagnosticReport

────────────────────
+ This
    - session Session
    - search-paths [Path] = []

.. types = session.types
.. program = session.program
.. bindings = session.bindings
.. instances = session.instances
.. facts = session.facts
.. report = DiagnosticReport(session, search-paths)

────────────────────
+ do node-type-lines
    - instance InstanceId
    - label String
    - lines [String]
    - dropped [String = Bool]

. row = instances.rows[instance]
if row.node-start == U32.max
    =
. tree = program.modules[row.module].tree
for offset in 0 .. < row.subtree.count
    . type = facts.node-types[row.node-start + offset]
    if type != no-type
        . id = row.subtree.start + offset
        if is-unlocated(tree.nodes.loc[id]) || is-pattern-answer(tree, id)
            continue
        . location = node-location-text(tree, id)
        if dropped[location] == true
            continue
        lines += "type $label $location ${type-key(types, type)}"
for fact in facts.unwrapped
    if fact.instance == instance && !is-unlocated(tree.nodes.loc[fact.syntax])
        . location = node-location-text(tree, fact.syntax)
        if dropped[location] != true
            lines += "type $label $location ${type-key(types, fact.type)}"

────────────────────
+ do conversion-lines
    - instance InstanceId
    - label String
    - lines [String]
    - dropped [String = Bool]

. row = instances.rows[instance]
. tree = program.modules[row.module].tree
for id in facts.instance-conversions(instance)
    . fact = facts.conversions[id]
    . unwritten = implied || fact.reason == .reason-pattern
        .. implied = fact.reason == .reason-promotion || fact.reason == .reason-relation
    . silent = fact.reason == .reason-literal-return || fact.reason == .reason-step
    if fact.kind != .relation-same && !unwritten && !silent
        . location = node-location-text(tree, fact.syntax)
        if dropped[location] == true
            continue
        . source = type-key(types, fact.from)
        . target = type-key(types, asked-type(fact))
        lines += "cast $label $location $source -> $target ${relation-name(fact.kind)}"

────────────────────
+ do override-lines
    - instance InstanceId
    - label String
    - lines [String]

` The methods and converters that subclasses declare in place of an instance, and the
` properties they store in place of it, in the order of their text.
. found [String]
for fact in facts.overrides
    if fact.base == instance && fact.override == no-instance
        found += "override $label ${type-key(types, fact.receiver)} property ${types.properties[fact.property].name.text}"
    else if fact.base == instance
        found += "override $label ${type-key(types, fact.receiver)} ${call-text(fact.override)}"
. ordered [String] = sort(found)
lines ++= ordered

────────────────────
+ do types-on-line String
    - instance InstanceId
    - line U32

. row = instances.rows[instance]
if row.node-start == U32.max
    = ""
. tree = program.modules[row.module].tree
. columns [U32]
. shown [String]
for offset in 0 .. < row.subtree.count
    . type = facts.node-types[row.node-start + offset]
    if type == no-type
        continue
    . loc = tree.nodes.loc[row.subtree.start + offset]
    if loc.begin.line != line || is-unlocated(loc) || pattern-answer
        continue
    .. pattern-answer = is-pattern-answer(tree, row.subtree.start + offset)
    . entry = "${loc.begin.column}=${type-text(types, type)}"
    . position = columns.length
    while position != 0 && columns[position - 1] > loc.begin.column
        position -= 1
    if position != 0 && columns[position - 1] == loc.begin.column && shown[position - 1] == entry
        continue
    columns.insert(loc.begin.column, position)
    shown.insert(entry, position)
= ";".join(shown)

────────────────────
+ do local-types String
    - instance InstanceId

` The locals an instance keeps a type for, as `name=type` in slot order.
. row = instances.rows[instance]
if row.binding == no-binding
    = ""
. slots = bindings.bindings[row.binding].slots
. shown [String]
for offset in 0 .. < slots.count
    . type = facts.slot-type(instance, offset)
    . slot = bindings.slots[slots.start + offset]
    if type != no-type && slot.kind != .slot-loop-state
        shown += "${slot.name.text}=${type-text(types, type)}"
= ";".join(shown)

────────────────────
+ fill-summary String
    - instance InstanceId

` The properties a constructor fills, as `property<-kind` in the order it fills them, where the
` kind says whether an argument or a lazy local gives the value.
";".join(shown)

.. shown = <* fact in facts.fills when fact.instance == instance
    "${fact.name.text}<-${if bindings.slots[fact.slot].kind == .slot-lazy then "lazy" else "argument"}"

────────────────────
+ conversion-summary String
    - instance InstanceId
    - line U32 = U32.max

" ".join(conversion-text(tree, each) in shown)

.. row = instances.rows[instance]
.. tree = program.modules[row.module].tree
.. recorded = facts.conversions[each] in facts.instance-conversions(instance)
.. shown = each in recorded when each.kind != .relation-same && is-on-line(tree, each.syntax, line)

────────────────────
_ asked-type TypeId
    - fact ConversionFact

` The type a conversion was asked for: the one it gives, unless that was chosen from
` several alternatives.
if fact.asked == no-type then fact.to else fact.asked

────────────────────
+ conversion-text String
    - tree AST
    - fact ConversionFact

"$location:${source}->${target}:${relation-name(fact.kind)}$suffix"

.. location = node-location-text(tree, fact.syntax)
.. source = type-text(types, fact.from)
.. target = type-text(types, asked-type(fact))
.. suffix = if fact.callee != no-instance then "=$callee-head" else ""
.. callee-head = decl-head(types, callee.module, callee.decl)
.. callee = instances.rows[fact.callee]

────────────────────
+ force-summary String
    - instance InstanceId
    - line U32

" ".join(force-text(types, tree, each) in shown)

.. row = instances.rows[instance]
.. tree = program.modules[row.module].tree
.. recorded = facts.forces[each] in facts.instance-forces(instance)
.. shown = each in recorded when tree.nodes.loc[each.syntax].begin.line == line

────────────────────
+ diagnostic-summary String
    - module ModuleId

" ".join(diagnostic-summary-text(tree, each) in facts.diagnostics when each.module == module && each.kind != .not-supported)

.. tree = program.modules[module].tree

────────────────────
+ unsupported-summary String
    - module ModuleId

" ".join(node-location-text(tree, each.syntax) in facts.diagnostics when each.module == module && each.kind == .not-supported)

.. tree = program.modules[module].tree

────────────────────
+ return-summary String
    - instance InstanceId

"$shown$raised $state"

.. signature = instances.signatures[instance]
.. state = match signature.return-state
    |= .return-declared
        "declared"
    |= .return-inferred
        "inferred"
    |= .return-failed
        "failed"
    ??
        "pending"
.. shown = if signature.returns != no-type then type-text(types, signature.returns) else "-"
.. errors = type-text(types, instances.error-type(instance, each)) in 0 .. < signature.errors.count
.. raised = if signature.errors.count != 0 then " ?! ${" | ".join(errors)}" else ""

────────────────────
+ do call-lines
    - instance InstanceId
    - label String
    - lines [String]
    - dropped [String = Bool]

. row = instances.rows[instance]
. tree = program.modules[row.module].tree
for id in facts.instance-calls(instance)
    . fact = facts.calls[id]
    if is-traced-form(fact.form) && !fact.is-partial
        . location = node-location-text(tree, fact.syntax)
        if dropped[location] == true
            continue
        . raw = !fact.propagates && instances.signatures[fact.callee].errors.count != 0
        . bound-self = fact.form == .call-this-constructor
        . text = call-text(fact.callee, raw, bound-self)
        lines += "call $label $location $text"

────────────────────
+ do instance-lines
    - instance InstanceId
    - label String
    - lines [String]

. row = instances.rows[instance]
if row.state == .instance-unstarted || !is-listed-instance(program, row)
    =
lines += "instance $label ${instance-text(instance)}"

────────────────────
+ instance-text String
    - instance InstanceId

"$head $signature-text returns=$returns errors=[$shown-errors]"

.. row = instances.rows[instance]
.. signature = instances.signatures[instance]
.. head = instance-head(types, row.module, row.decl)
.. shown-self = instance-self(program, row)
.. self = if shown-self != no-type then type-key(types, shown-self) else "-"
.. shown = shown-params(types, row.module, row.decl, signature.param-count)
.. params = type-key(types, instances.param-type(instance, each)) in 0 .. < shown
.. args = type-key(types, instances.argument-type(instance, each)) in 0 .. < signature.args.count
.. mask = effects-text(row.effects as CompilationEffect)
.. effects = if mask == "-" then "" else mask
.. returns = if signature.returns != no-type then type-key(types, signature.returns) else "-"
.. shown-params-text = ", ".join(params)
.. shown-args = ", ".join(args)
.. error-keys = signature-error-keys(instance)
.. sorted-errors [String] = sort(error-keys)
.. shown-errors = ", ".join(sorted-errors)
.. signature-text = "params=[$shown-params-text] self=$self args=[$shown-args] without=[$effects]"

────────────────────
+ do panic-lines
    - instance InstanceId
    - label String
    - lines [String]

. row = instances.rows[instance]
if row.state == .instance-unstarted || !is-listed-instance(program, row)
    =
. signature = instances.signatures[instance]
. head = instance-head(types, row.module, row.decl)
. shown-self = instance-self(program, row)
. self = if shown-self != no-type then type-key(types, shown-self) else "-"
. args = type-key(types, instances.argument-type(instance, each)) in 0 .. < signature.args.count
. shown-args = ", ".join(args)
. flag = if row.may-panic then "true" else "false"
lines += "panic $label $head self=$self args=[$shown-args] $flag"

────────────────────
+ signature-error-keys [String]
    - instance InstanceId

type-key(types, instances.error-type(instance, each)) in 0 .. < signature.errors.count

.. signature = instances.signatures[instance]

────────────────────
+ do call-text String
    - callee InstanceId
    - raw Bool = false
    - bound-self Bool = false

. row = instances.rows[callee]
. signature = instances.signatures[callee]
. head = decl-head(types, row.module, row.decl)
. traced = traced-self(types, row.module, row.decl, row.self-type)
. shown-self = if bound-self then row.self-type else traced
. self = if shown-self != no-type then type-key(types, shown-self) else "-"
. shown = shown-params(types, row.module, row.decl, signature.param-count)
. params = type-key(types, instances.param-type(callee, each)) in 0 .. < shown
. args = type-key(types, instances.argument-type(callee, each)) in 0 .. < signature.args.count

. shown-returns = signature.returns
if raw && signature.errors.count != 0
    . mark = types.scratch.types.mark
    for position in 0 .. < signature.errors.count
        types.scratch.types.push(instances.signature-types[signature.errors.start + position])
    shown-returns = result-type(types, signature.returns, mark)
. returns = if shown-returns != no-type then type-key(types, shown-returns) else "-"
= "$head params=[${", ".join(params)}] self=$self args=[${", ".join(args)}] returns=$returns"

────────────────────
+ calls-on-line String
    - instance InstanceId
    - line U32

" ".join(call-head(each) in shown)

.. row = instances.rows[instance]
.. tree = program.modules[row.module].tree
.. calls = facts.calls[each] in facts.instance-calls(instance)
.. shown = each in calls when is-traced-call(each, instance) && is-on-line(tree, each.syntax, line)

────────────────────
+ call-head String
    - fact CallFact

if fact.is-partial then head ++ "?" else head

.. callee = instances.rows[fact.callee]
.. head = decl-head(types, callee.module, callee.decl)

────────────────────
+ do pair-lines
    - instance InstanceId
    - lines [String]

for fact in facts.pairs
    if fact.instance == instance
        . relation = pair-relation(fact)
        . source = type-key(types, fact.from)
        . target = type-key(types, fact.to)
        lines += "pair $source -> $target = ${relation-text(types, relation)}"

────────────────────
+ do diagnostic-lines
    - instance InstanceId
    - label String
    - lines [String]

for diagnostic in facts.diagnostics
    if diagnostic.instance != instance || diagnostic.kind == .not-supported
        continue
    . tree = program.modules[diagnostic.module].tree
    . message = diagnostic-message(types, diagnostic)
    lines += "diag $label ${node-extent-text(tree, diagnostic.syntax)} $message"
    =

────────────────────
+ rendered-diagnostics String
    - module ModuleId

"\n".join(diagnostic-entries(module))

────────────────────
+ rendered-declines String
    - module ModuleId

"\n".join(decline-entries(module))

────────────────────
+ do reported-entries [String]
    - limit Index

. undeclared = first-undeclared()
=? [undeclared] if undeclared
. entries [String]
for module in report-order()
    entries ++= diagnostic-entries(module)
. decline = first-decline()
=? [decline] if entries.length == 0 && decline
=? entries if entries.length <= limit
. hidden = entries.length - limit
. shown = entries[0 .. < limit]
shown += if hidden == 1 then "1 more error is not shown" else "$hidden more errors are not shown"
= shown

────────────────────
+ first-decline String?

** report-order()
?*> first(entries)
    .. entries = decline-entries(each)
|> first

────────────────────
+ first-undeclared String?

` The first declaration written that no pass models. What is said of a program past one is
` not to be trusted: what the declaration names is found nowhere. A member of a class counts
` only where the program is otherwise reported, since one of a class that runs is declined,
` and then only where the class is named somewhere, as the reference compiles nothing of a
` class nothing names.
** report-order()
?*> first(entries)
    .. entries = undeclared-entries(each, diagnosed)
|> first

.. diagnosed = is-diagnosed()

────────────────────
_ do is-diagnosed Bool

` Whether anything is reported of the program other than what is declined. A local declared
` again is the type pass's to report.
=? true if bindings.reports()
for diagnostic in facts.diagnostics
    if diagnostic.kind != .not-supported
        = true
= false

────────────────────
_ report-order

* program.entry-module
** others

.. others = (each as ModuleId) in 0 .. < program.modules.length when each != program.entry-module

────────────────────
+ do diagnostic-entries [String]
    - module ModuleId

` The errors reported of a module, by line. One TypeScript states with no place keeps the line
` of its node for the order and is shown with none.
. owner = program.modules[module]
. sources = use ExcerptSources(program)
. keyed [String]
. reported [String]
for diagnostic in bindings.diagnostics
    if diagnostic.module != module || diagnostic.kind == .redeclared
        continue
    . message = report.binding-message(diagnostic, binding-diagnostic-message(diagnostic))
    . key = "${enclosing-function(owner, diagnostic.syntax)} $message"
    if reported.find(key) != null
        continue
    reported += key
    . text = diagnostic-text(program, module, diagnostic.syntax, message) • sources sources
    keyed += keyed-text(owner, diagnostic.syntax, text)
. seen [InstanceId]
. reached [String]
for diagnostic in facts.diagnostics
    if diagnostic.module != module || diagnostic.kind == .not-supported
        continue
    if diagnostic.kind != .reached
        if seen.find(diagnostic.instance) != null
            continue
        seen += diagnostic.instance
    . message = report.type-message(diagnostic, diagnostic-message(types, diagnostic))
    . place = if diagnostic.kind == .stated-unplaced then 0u32 else report.type-site(diagnostic)
    . moved = diagnostic.kind != .stated-unplaced && place != diagnostic.syntax
    . text = diagnostic-text
        - program
        - module
        - place
        - message
        - if moved then 0u32 else diagnostic.inset
        - if moved then 0u32 else diagnostic.width
        - sources
    if diagnostic.related-label
        . label = diagnostic.related-label
        . related = diagnostic.related-module
        text += "\n" ++ related-text(program, related, diagnostic.related-syntax, label!.text, sources)
    . entry = keyed-text(owner, if moved then place else diagnostic.syntax, text)
    if diagnostic.kind == .reached
        reached += entry
    else
        keyed += entry
= ordered-entries(first-of-each-line(keyed) ++ reached)

────────────────────
_ do first-of-each-line [String]
    - keyed [String]

. ordered [String] = sort(keyed)
. kept [String]
for text in ordered
    if kept.length == 0 || kept[kept.length - 1][0 .. < 6] != text[0 .. < 6]
        kept += text
= kept

────────────────────
+ do decline-entries [String]
    - module ModuleId

. owner = program.modules[module]
. sources = use ExcerptSources(program)
. keyed [String]
for diagnostic in facts.diagnostics
    if diagnostic.module == module && diagnostic.kind == .not-supported
        . text = diagnostic-text(program, module, diagnostic.syntax, report.decline-message(diagnostic)) • sources sources
        keyed += keyed-text(owner, diagnostic.syntax, text)
= ordered-entries(keyed)

────────────────────
+ do undeclared-entries [String]
    - module ModuleId
    - members Bool = true

` The declarations of a module no pass models, but one the type pass reports an error within,
` which it has judged: a second section of a class, as the reference finds as it declares the
` module, or a member of an extension of a style sheet that is wrong, whose check judges the
` extension whole.
. owner = program.modules[module]
. sources = use ExcerptSources(program)
. keyed [String]
for position in 0 .. < owner.undeclared.length
    . written = owner.undeclared[position]
    . holder = owner.undeclared-owners[position]
    . judged = false
    do match? owner.decls[holder]
        | .decl-sheet-extension(extension)
            judged = reported-within(module, extension.syntax)
    if judged || reported-within(module, written)
        continue
    if holder == 0 || (members && is-named(module, holder))
        . text = diagnostic-text(program, module, written, "Not supported") • sources sources
        keyed += keyed-text(owner, written, text)
= ordered-entries(keyed)

────────────────────
_ do reported-within Bool
    - module ModuleId
    - written SyntaxId

` Whether the type pass reports an error at a declaration or within it.
. start = program.modules[module].tree.subtree-start(written)
for diagnostic in facts.diagnostics
    if diagnostic.module == module && diagnostic.kind != .not-supported && within
        = true
    .. within = diagnostic.syntax >= start && diagnostic.syntax <= written
= false

────────────────────
_ do is-named Bool
    - module ModuleId
    - decl DeclId

` Whether a class is named anywhere in the program, by its name or an alias: in a type, a
` markup element, or a name read, its own members included.
. owner = program.modules[module]
. names [Atom]
do match? owner.decls[decl]
    | .decl-class(class)
        names += class.name
        for alias in owner.tree.atoms[class.aliases]
            names += alias
if names.length == 0
    = true
for other in program.modules
    . tree = other.tree
    for id in 1u32 .. < tree.nodes.length
        do match? tree.nodes[id]
            | .node-type-identifier(row)
                if names.find(row.name) != null
                    = true
            | .node-identifier(row)
                if names.find(row.name) != null
                    = true
= false

────────────────────
_ do ordered-entries [String]
    - keyed [String]

. ordered [String] = sort(keyed)
. unique [String]
for text in ordered
    if unique.length == 0 || unique[unique.length - 1] != text
        unique += text
= <* text in unique
    text[7 ...]
