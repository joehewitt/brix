(import /lang/backend/mir)
(import /lang/backend/mir-text)
(import /test)
(blank)

(main
  (call tests)
)

(fn-do + tests TestRender
  (let cases (call TestCase "Backend Text Numbers"))
  (call (. cases run) number-tests)
  (= cases (call (. cases then) "Backend Text Hash" hash-tests))
  (= cases (call (. cases then) "Backend Post Order" post-order-tests))
  (return cases)
)

(fn-do _ number-tests TestCase
  (param t TestCase)
  (let out TextBuffer)
  (call (. out unsigned) 0)
  (call (. out byte) 32)
  (call (. out unsigned) 18446744073709551615)
  (call (. out byte) 32)
  (call (. out signed) -1)
  (call (. out byte) 32)
  (call (. out signed) (as (/lshift/ 1u64 63) I64))
  (call (. out byte) 32)
  (call (. out signed) 9223372036854775807)
  (call (. t expect)
    (block
      (arg "decimal")
      (arg "0 18446744073709551615 -1 -9223372036854775808 9223372036854775807")
      (arg (call written out))
    )
  )
  (blank)
  (call (. out clear))
  (call (. out hex64) 0)
  (call (. out byte) 32)
  (call (. out hex64) 0xcbf29ce484222325)
  (call (. t expect) "hex64" "0000000000000000 cbf29ce484222325" (call written out))
  (return t)
)

(fn-do _ hash-tests TestCase
  (param t TestCase)
  (let out TextBuffer)
  (call (. t expect) "empty" 0xcbf29ce484222325 (. out hash))
  (call (. out text) "hello")
  (call (. t expect) "hello" 0xa430d84680aabd0b (. out hash))
  (return t)
)

(fn-do _ post-order-tests TestCase
  (param t TestCase)
  (let function (use (call MIRFunction)))
  (call (. t expect) "no blocks" 0 (. (call (. function post-order)) length))
  (for (in block (..< 0 5))
    (call (. function blocks append) (call MIRBlock no-string (call IdList) (call IdList) (call IdList)))
    (= (. function block-order) (call (. function block-order appended) (. function arena) (as block U32)))
  )
  (call connect function 0 1)
  (call connect function 0 2)
  (call connect function 1 3)
  (call connect function 2 3)
  (call connect function 3 1)
  (call connect function 4 0)
  (let order (call (. function post-order)))
  (call (. t expect) "reachable blocks" 4 (. order length))
  (call (. t expect) "deepest first" 3 ([] order 0))
  (call (. t expect) "then its predecessor" 1 ([] order 1))
  (call (. t expect) "then the second branch" 2 ([] order 2))
  (call (. t expect) "root last" 0 ([] order 3))
  (return t)
)

(fn-do _ connect _
  (param function MIRFunction)
  (param from BlockId)
  (param to BlockId)
  (= (. ([] (. function blocks) from) successors) (call (. ([] (. function blocks) from) successors appended) (. function arena) to))
  (= (. ([] (. function blocks) to) predecessors) (call (. ([] (. function blocks) to) predecessors appended) (. function arena) from))
)

(fn-expr _ written String
  (param out TextBuffer)
  (call (. ([] (. out bytes) (..< 0 (. out length))) slice-string))
)
