)
:----

<CastExpression>
    <CastExpression>
        <CastExpression>
            <Id name="foo"/>
            <TypeId name="Foo"/>
        </CastExpression>
        <TypeId name="Bar"/>
    </CastExpression>
    <TypeId name="Baz"/>
</CastExpression>
