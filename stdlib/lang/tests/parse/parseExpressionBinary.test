a && b || c && d

:----
%brix
(main
  (or (and a b) (and c d))
)
:----

<BinaryExpression operator="||">
    <BinaryExpression operator="&&">
        <Id name="a"/>
        <Id name="b"/>
    </BinaryExpression>
    <BinaryExpression operator="&&">
        <Id name="c"/>
        <Id name="d"/>
    </BinaryExpression>
</BinaryExpression>
