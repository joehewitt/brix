<BinaryExpression operator="+">
    <Id name="foo"/>
    <BinaryExpression operator="*">
        <Id name="bar"/>
        <Integer value="2"/>
    </BinaryExpression>
</BinaryExpression>
;====
:====

foo /bar/ baz

:----
%brix
(main
  (/bar/ foo baz)
)
:----

<CallExpression>
    <Id name="bar"/>
    <Argument>
        <Id name="foo"/>
    </Argument>
    <Argument>
        <Id name="baz"/>
    </Argument>
</CallExpression>
;====
:====

foo //bar// baz

:----
%brix
(main
  (//bar// foo baz)
)
:----

<CallExpression>
    <Id name="bar"/>
    <Argument>
        <Id name="foo"/>
    </Argument>
    <Argument>
        <Id name="baz"/>
    </Argument>
</CallExpression>
;====
:====

foo ///x/// baz

:----
%brix
(main
  (///x/// foo baz)
)
:----

<CallExpression>
    <Id name="x"/>
    <Argument>
        <Id name="foo"/>
    </Argument>
    <Argument>
        <Id name="baz"/>
    </Argument>
</CallExpression>
;====
:====

a ///x/// b /y/ c

:----
%brix
(main
  (///x/// a (/y/ b c))
)
:----

<CallExpression>
    <Id name="x"/>
    <Argument>
        <Id name="a"/>
    </Argument>
    <Argument>
        <CallExpression>
            <Id name="y"/>
            <Argument>
                <Id name="b"/>
            </Argument>
            <Argument>
                <Id name="c"/>
            </Argument>
        </CallExpression>
    </Argument>
</CallExpression>
;====
:====

a /x/ b ///y/// c

:----
%brix
(main
  (///y/// (/x/ a b) c)
)
:----

<CallExpression>
    <Id name="y"/>
    <Argument>
        <CallExpression>
            <Id name="x"/>
            <Argument>
                <Id name="a"/>
            </Argument>
            <Argument>
                <Id name="b"/>
            </Argument>
        </CallExpression>
    </Argument>
    <Argument>
        <Id name="c"/>
    </Argument>
</CallExpression>
;====
