    <Id name="foo"/>
    <TypeId name="Bar"/>
</BinaryExpression>
;====
:====

i > 0 && i == 0

:----
%brix
(main
  (and (> i 0) (== i 0))
)
:----

<BinaryExpression operator="&&">
    <BinaryExpression operator=">">
        <Id name="i"/>
        <Integer value="0"/>
    </BinaryExpression>
    <BinaryExpression operator="==">
        <Id name="i"/>
        <Integer value="0"/>
    </BinaryExpression>
</BinaryExpression>
;====
:====

10 > i > 0

:----
%brix
(main
  (> 10 i 0)
)
:----

<BinaryExpression operator="&&">
    <BinaryExpression operator=">">
        <Integer value="10"/>
        <Held>
            <Id name="i"/>
        </Held>
    </BinaryExpression>
    <BinaryExpression operator=">">
        <HeldRead/>
        <Integer value="0"/>
    </BinaryExpression>
</BinaryExpression>
;====
:====

9 > i >= j > 0

:----
%brix
(main
  (> (>= (> 9 i) j) 0)
)
:----

<BinaryExpression operator="&&">
    <BinaryExpression operator=">">
        <Integer value="9"/>
        <Held>
            <Id name="i"/>
        </Held>
    </BinaryExpression>
    <BinaryExpression operator="&&">
        <BinaryExpression operator=">=">
            <HeldRead/>
            <Held>
                <Id name="j"/>
            </Held>
        </BinaryExpression>
        <BinaryExpression operator=">">
            <HeldRead/>
            <Integer value="0"/>
        </BinaryExpression>
    </BinaryExpression>
</BinaryExpression>
;====
:====
