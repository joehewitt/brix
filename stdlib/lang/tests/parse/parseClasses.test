:====

+ false = Bool(0)

:----
%brix
(prop + false _ (= (call Bool 0)))
:----

<Property access="public-access">
    <TypeCapture>
        <Id name="false"/>
    </TypeCapture>
    <CallExpression>
        <TypeId name="Bool"/>
        <Argument>
            <Integer value="0"/>
        </Argument>
    </CallExpression>
</Property>
;====
:====

━━━━━━━━━━━━━━━━━━━━
+ A

────────────────────
+ This ~ Char

~ "/"? (\file-word "/")+ \file-word?
    This(it)

.. file-word ~
    ~ \file-char+

.. file-char ~
    ~ [a-zA-Z0-9.]

:----
%brix
(type + A
  (fn-expr + This _ (over: Char)
    (~ (seq (? "/") (+ (seq \file-word "/")) (? \file-word))
      (call This it)
    )
    (where
      (lazy file-word
        (pattern
          (~ (+ \file-char))
        )
      )
      (blank)
      (lazy file-char
        (pattern
          (~ (chars "a-zA-Z0-9."))
        )
      )
    )
  )
)
:----

<Class name="A" access="public-access">
    <Function names="This" access="public-access">
        <pattern>
            <TypeId name="Char"/>
        </pattern>
        <TypeId name="StreamItem"/>
        <ArgumentDecl>
            <TypeCapture>
                <Id name="(stream)"/>
                <TypeArguments>
                    <TypeId name="TokenStream"/>
                    <TypeId name="Char"/>
                </TypeArguments>
            </TypeCapture>
        </ArgumentDecl>
        <TypeConstraint op="exactly">
            <TypeId name="StreamItem"/>
            <TypeId name="Char"/>
        </TypeConstraint>
        <Block>
            <StreamMatch>
                <StreamTransform>
                    <StreamAnd>
                        <StreamAnd>
                            <UnaryStream op="?">
                                <StreamString text="/"/>
                            </UnaryStream>
                            <UnaryStream op="+">
                                <StreamAnd>
                                    <StreamCall name="file-word"/>
                                    <StreamString text="/"/>
                                </StreamAnd>
                            </UnaryStream>
                        </StreamAnd>
                        <UnaryStream op="?">
                            <StreamCall name="file-word"/>
                        </UnaryStream>
                    </StreamAnd>
                    <Block>
                        <CallExpression>
                            <TypeId name="This"/>
                            <Argument>
                                <Id name="it"/>
                            </Argument>
                        </CallExpression>
                    </Block>
                </StreamTransform>
            </StreamMatch>
            <Declaration lazy="true" pattern="true">
                <TypeCapture>
                    <Id name="file-word"/>
                </TypeCapture>
                <StreamMatch>
                    <UnaryStream op="+">
                        <StreamCall name="file-char"/>
                    </UnaryStream>
                </StreamMatch>
            </Declaration>
            <Declaration lazy="true" pattern="true">
                <TypeCapture>
                    <Id name="file-char"/>
                </TypeCapture>
                <StreamMatch>
                    <StreamOr>
                        <StreamOr>
                            <StreamOr>
                                <StreamCharRange>
                                    <Integer value="97" unit="c"/>
                                    <Integer value="122" unit="c"/>
                                </StreamCharRange>
                                <StreamCharRange>
                                    <Integer value="65" unit="c"/>
                                    <Integer value="90" unit="c"/>
                                </StreamCharRange>
                            </StreamOr>
                            <StreamCharRange>
                                <Integer value="48" unit="c"/>
                                <Integer value="57" unit="c"/>
                            </StreamCharRange>
                        </StreamOr>
                        <StreamCharRange>
                            <Integer value="46" unit="c"/>
                            <Integer value="46" unit="c"/>
                        </StreamCharRange>
                    </StreamOr>
                </StreamMatch>
            </Declaration>
        </Block>
    </Function>
</Class>
;====
