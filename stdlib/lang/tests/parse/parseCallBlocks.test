call
    • with this
        | .alpha
            "A"
        ??
            "B"

:----
%brix
(main
  (call call
    (block
      (:with
        (call this
          (block
            (case .alpha
              "A"
            )
            (default
              "B"
            )
          )
        )
      )
    )
  )
)
:----

<CallExpression>
    <Id name="call"/>
    <Argument name="with">
        <CallExpression>
            <Id name="this"/>
            <Argument>
                <Block>
                    <StructureMatch>
                        <TypeOr>
                            <TypeTransform>
                                <TypeCase name="alpha"/>
                                <Block>
                                    <String text="A"/>
                                </Block>
                            </TypeTransform>
                            <TypeTransform>
                                <Block>
                                    <String text="B"/>
                                </Block>
                            </TypeTransform>
                        </TypeOr>
                    </StructureMatch>
                </Block>
            </Argument>
        </CallExpression>
    </Argument>
</CallExpression>
