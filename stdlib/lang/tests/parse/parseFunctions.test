x()

:----
%brix
(subscribe-for (in foo bar)
  (and-for (in foo bar))
  (call x)
)
:----

<Subscriber>
    <For>
        <In>
            <TypeCapture>
                <Id name="foo"/>
            </TypeCapture>
            <Id name="bar"/>
            <In>
                <TypeCapture>
                    <Id name="foo"/>
                </TypeCapture>
                <Id name="bar"/>
            </In>
        </In>
        <Block>
            <CallExpression>
                <Id name="x"/>
            </CallExpression>
        </Block>
    </For>
</Subscriber>
