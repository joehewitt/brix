g(foo)

:----
%brix
(subscribe (on bar)
  (call f)
)

(subscribe-for (in foo bar)
  (call g foo)
)
:----

<Subscriber>
    <For>
        <On>
            <Id name="bar"/>
        </On>
        <Block>
            <CallExpression>
                <Id name="f"/>
            </CallExpression>
        </Block>
    </For>
</Subscriber>
<Subscriber>
    <For>
        <In>
            <TypeCapture>
                <Id name="foo"/>
            </TypeCapture>
            <Id name="bar"/>
        </In>
        <Block>
            <CallExpression>
                <Id name="g"/>
                <Argument>
                    <Id name="foo"/>
                </Argument>
            </CallExpression>
        </Block>
    </For>
</Subscriber>
;====
:====
# A function's header takes a without section after its annotations, and a do function's a with
# section that binds for its whole body.

━━━━━━━━━━━━━━━━━━━━
+ do func Int ?! Error @inline without heap, suspend with depth = 2, request = depth
    - value Int

= value

:----
%brix
(fn-do + func Int (?! Error) @inline (without heap suspend) (with depth 2) (with request depth)
  (param value Int)
  (blank)
  (return value)
)
:----

<Function names="func" access="public-access" imperative="true" effects="no-heap,no-suspend" inline="true">
    <ArgumentDecl>
        <TypeCapture>
            <Id name="value"/>
            <TypeId name="Int"/>
        </TypeCapture>
    </ArgumentDecl>
    <TypeId name="Int"/>
    <errors>
        <TypeId name="Error"/>
    </errors>
    <Block>
        <StackLocalBinding name="depth">
            <Integer value="2"/>
            <Block>
                <StackLocalBinding name="request">
                    <Id name="depth"/>
                    <Block>
                        <Return>
                            <Id name="value"/>
                        </Return>
                    </Block>
                </StackLocalBinding>
            </Block>
        </StackLocalBinding>
    </Block>
</Function>
;====
