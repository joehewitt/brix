  (call x)
)
:----

<Subscriber>
    <For>
        <On>
            <Id name="bar"/>
        </On>
        <Block>
            <CallExpression>
                <Id name="x"/>
            </CallExpression>
        </Block>
    </For>
</Subscriber>
;====
:================================================================================================

━━━━━━━━━━━━━━━━━━━━
