━━━━━━━━━━━━━━━━━━━━
+ do This ~ Char

~ "a"

:----
%crash

Exception: Stream-pattern functions do not support do
<no file:2>
    ━━━━━━━━━━━━━━━━━━━━
    ^^^^^^^^^^^^^^^^^^^
;====
:====

≤
+ Thing

━━━━━━━━━━━━━━━━━━━━
+ do This

━━━━━━━━━━━━━━━━━━━━
+ do get name String

= "thing"

━━━━━━━━━━━━━━━━━━━━
+ do name = value String

-- value

━━━━━━━━━━━━━━━━━━━━
+ do to String

= name

━━━━━━━━━━━━━━━━━━━━
+ do from value String

= Thing()
≥

:----
%brix
(type + Thing
  (fn-do + This _)
  (fn-do + name String :get
    (return "thing")
  )
  (fn-do + name _ :set (param value String)
    (print value)
  )
  (fn-to-do + String
    (return name)
  )
  (fn-from-do + (: value String)
    (return (call Thing))
  )
)
:----

<Class name="Thing" access="public-access">
    <Function names="This" access="public-access" imperative="true"/>
    <Function names="name" access="public-access" getter="true" imperative="true">
        <TypeId name="String"/>
        <Block>
            <Return>
                <String text="thing"/>
            </Return>
        </Block>
    </Function>
    <Function names="name" access="public-access" setter="true" imperative="true">
        <ArgumentDecl>
            <TypeCapture>
                <Id name="value"/>
                <TypeId name="String"/>
            </TypeCapture>
        </ArgumentDecl>
        <Block>
            <Print>
                <Id name="value"/>
            </Print>
        </Block>
    </Function>
    <Converter access="public-access" imperative="true">
        <TypeId name="String"/>
        <Block>
            <Return>
                <Id name="name"/>
            </Return>
        </Block>
    </Converter>
    <Fromverter access="public-access" imperative="true">
        <TypeCapture>
            <Id name="value"/>
            <TypeId name="String"/>
        </TypeCapture>
        <Block>
            <Return>
                <CallExpression>
                    <TypeId name="Thing"/>
                </CallExpression>
            </Return>
        </Block>
    </Fromverter>
</Class>
;====
:====

+ name String => do
    = "ok"

:----
