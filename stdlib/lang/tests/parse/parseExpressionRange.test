:====

foo .. < bar

:----
%brix
(main
  (..< foo bar)
)
:----

<RangeExpression operator="..">
    <Id name="foo"/>
    <Id name="bar"/>
</RangeExpression>
;====
:====

foo .. bar

:----
%brix
(main
  (.. foo bar)
)
:----

<RangeExpression operator="thru">
    <Id name="foo"/>
    <Id name="bar"/>
</RangeExpression>
;====
:====

foo .. < bar by baz

:----
%brix
(main
  (..< foo bar (by: baz))
)
:----

<RangeExpression operator="..">
    <Id name="foo"/>
    <Id name="bar"/>
    <Id name="baz"/>
</RangeExpression>
;====
:====

call • from foo .. < bar by baz

:----
%brix
(main
  (call call (:from (..< foo bar (by: baz))))
)
:----

<CallExpression>
    <Id name="call"/>
    <Argument name="from">
        <RangeExpression operator="..">
            <Id name="foo"/>
            <Id name="bar"/>
            <Id name="baz"/>
        </RangeExpression>
    </Argument>
</CallExpression>
