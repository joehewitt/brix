foo(1, ...)

:------------------------------------------------------------------------------------------------
%brix
(main
  (call foo 1 ...)
)
:----

<CallExpression curried="true">
    <Id name="foo"/>
    <Argument>
        <Integer value="1"/>
    </Argument>
</CallExpression>

