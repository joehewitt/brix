:====

foo if bar

:----
%brix
(main
  (only-if foo (if bar))
)
:----

<BinaryExpression operator="if">
    <Id name="foo"/>
    <Id name="bar"/>
</BinaryExpression>
;====
:====

if foo then c2 else c1

:----
%brix
(main
  (if-expr foo c2 c1)
)
:----

<BinaryExpression operator="else">
    <BinaryExpression operator="if">
        <Id name="c2"/>
        <Id name="foo"/>
    </BinaryExpression>
    <Id name="c1"/>
</BinaryExpression>

;====
:====

c2 ?? c1

:----
%brix
(main
  (?? c2 c1)
)
:----

<BinaryExpression operator="??">
    <Id name="c2"/>
    <Id name="c1"/>
</BinaryExpression>
;====
:====

if foo then c3 else if bar then c2 else c1

:----
%brix
(main
  (if-expr foo c3 (if-expr bar c2 c1))
)
:----

<BinaryExpression operator="else">
    <BinaryExpression operator="if">
        <Id name="c3"/>
        <Id name="foo"/>
    </BinaryExpression>
    <BinaryExpression operator="else">
        <BinaryExpression operator="if">
            <Id name="c2"/>
            <Id name="bar"/>
        </BinaryExpression>
        <Id name="c1"/>
    </BinaryExpression>
</BinaryExpression>
;====
:====
# An `is` test against a list pattern ends before `then`, so it can be the condition of an if expression.

if value is [String] then c2 else c1

:----
%brix
(main
  (if-expr (is value (list String)) c2 c1)
)
:----

<BinaryExpression operator="else">
    <BinaryExpression operator="if">
        <Id name="c2"/>
        <BinaryExpression operator="is">
            <Id name="value"/>
            <TypeList>
                <TypeId name="String"/>
            </TypeList>
        </BinaryExpression>
    </BinaryExpression>
    <Id name="c1"/>
</BinaryExpression>
;====