:====

?! error

:----
%brix
(main
  (throw error)
)
:----

<Assert>
    <Id name="error"/>
</Assert>
;====
:====

?! error
    if condition

:----
%brix
(main
  (throw error (if condition))
)
:----

<Assert>
    <TypePredicate>
        <Id name="condition"/>
    </TypePredicate>
    <Id name="error"/>
</Assert>
;====
:====

?! failure! if failure

:----
%brix
(main
  (throw (!! failure) (if failure))
)
:----

<Assert>
    <TypePredicate>
        <Id name="failure"/>
    </TypePredicate>
    <UnaryExpression operator="!">
        <Id name="failure"/>
    </UnaryExpression>
</Assert>
;====
