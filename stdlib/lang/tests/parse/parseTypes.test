====================================================================================================
Compound type shorthands
====================================================================================================
:====

+ Foo is [Foo]

:----
%brix
(type-line + Foo (is (list Foo)))
:----

<Class name="Foo" access="public-access">
    <Implements inherited="true">
        <TypeArguments>
            <TypeId name="List"/>
            <TypeId name="Foo"/>
        </TypeArguments>
    </Implements>
</Class>
;====
:====

+ Foo is [Foo = Bar]

:----
%brix
(type-line + Foo (is (map Foo Bar)))
:----

<Class name="Foo" access="public-access">
    <Implements inherited="true">
        <TypeArguments>
            <TypeId name="Map"/>
            <TypeId name="Foo"/>
            <TypeId name="Bar"/>
        </TypeArguments>
    </Implements>
</Class>
;====
:====

+ Foo is <Foo>

:----
%brix
(type-line + Foo (is (stream Foo)))
:----

<Class name="Foo" access="public-access">
    <Implements inherited="true">
        <TypeArguments>
            <TypeId name="Stream"/>
            <TypeId name="Foo"/>
        </TypeArguments>
    </Implements>
</Class>
;====
====================================================================================================
Function types
====================================================================================================
:====

+ Foo is () Baz
    - foo Foo

:----
%brix
(type-line + Foo (is (fn-type Baz (param foo Foo))))
:----

<Class name="Foo" access="public-access">
    <Implements inherited="true">
        <TypeFunction>
            <TypeId name="Baz"/>
            <ArgumentDecl>
                <TypeCapture>
                    <Id name="foo"/>
                    <TypeId name="Foo"/>
                </TypeCapture>
            </ArgumentDecl>
        </TypeFunction>
    </Implements>
</Class>
;====
:====

━━━━━━━━━━━━━━━━━━━━
+ Foo is () Baz
    - foo Foo

:----
%brix
(type + Foo (is (fn-type Baz (param foo Foo))))
:----

<Class name="Foo" access="public-access">
    <Implements inherited="true">
        <TypeFunction>
            <TypeId name="Baz"/>
            <ArgumentDecl>
                <TypeCapture>
                    <Id name="foo"/>
                    <TypeId name="Foo"/>
                </TypeCapture>
            </ArgumentDecl>
        </TypeFunction>
    </Implements>
</Class>
;====
:====

━━━━━━━━━━━━━━━━━━━━
+ fn
    - arg () Baz
        - foo Foo

:----
%brix
(fn-expr + fn _
  (param arg (fn-type Baz (param foo Foo)))
)
:----

<Function names="fn" access="public-access">
    <ArgumentDecl>
        <TypeCapture>
            <Id name="arg"/>
            <TypeFunction>
                <TypeId name="Baz"/>
                <ArgumentDecl>
                    <TypeCapture>
                        <Id name="foo"/>
                        <TypeId name="Foo"/>
                    </TypeCapture>
                </ArgumentDecl>
            </TypeFunction>
        </TypeCapture>
    </ArgumentDecl>
</Function>
;====
:====

━━━━━━━━━━━━━━━━━━━━
+ Statement'Item is () Void
    - a Int

:----
%brix
(type + (of Statement Item) (is (fn-type Void (param a Int))))
:----

<Class name="Statement" access="public-access">
    <TypeId name="Item"/>
    <Implements inherited="true">
        <TypeFunction>
            <TypeId name="Void"/>
            <ArgumentDecl>
                <TypeCapture>
                    <Id name="a"/>
                    <TypeId name="Int"/>
                </TypeCapture>
            </ArgumentDecl>
        </TypeFunction>
    </Implements>
</Class>
;====
:================================================================================================

x is Foo
x is! Foo
x is~ Foo

:------------------------------------------------------------------------------------------------
%brix
(main
  (is x Foo)
  (is! x Foo)
  (is~ x Foo)
)
:----

<BinaryExpression operator="is">
    <Id name="x"/>
    <TypeId name="Foo"/>
</BinaryExpression>
<BinaryExpression operator="is!">
    <Id name="x"/>
    <TypeId name="Foo"/>
</BinaryExpression>
<BinaryExpression operator="is~">
    <Id name="x"/>
    <TypeId name="Foo"/>
</BinaryExpression>

;====
