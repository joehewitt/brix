:====

. foo
    bar

:----
%brix
(main
  (let foo
    (block
      bar
    )
  )
)
:----

<Declaration>
    <TypeCapture>
        <Id name="foo"/>
    </TypeCapture>
    <Block>
        <Id name="bar"/>
    </Block>
</Declaration>
;====
:====

.. foo = bar

:----
%brix
(main
  (lazy foo bar)
)
:----

<Declaration lazy="true">
    <TypeCapture>
        <Id name="foo"/>
    </TypeCapture>
    <Id name="bar"/>
</Declaration>
;====
:====

. foo Foo = bar

:----
%brix
(main
  (let foo Foo bar)
)
:----

<Declaration>
    <TypeCapture>
        <Id name="foo"/>
        <TypeId name="Foo"/>
    </TypeCapture>
    <Id name="bar"/>
</Declaration>
;====
:====

. foo [Foo] = bar

:----
%brix
(main
  (let foo (list Foo) bar)
)
:----

<Declaration>
    <TypeCapture>
        <Id name="foo"/>
        <TypeList>
            <TypeId name="Foo"/>
        </TypeList>
    </TypeCapture>
    <Id name="bar"/>
</Declaration>
;====
:====

.. name ~
    ~ Foo

:----
%brix
(main
  (lazy name
    (pattern
      (~ Foo)
    )
  )
)
:----

<Declaration lazy="true" pattern="true">
    <TypeCapture>
        <Id name="name"/>
    </TypeCapture>
    <StreamMatch>
        <StreamType>
            <TypeId name="Foo"/>
        </StreamType>
    </StreamMatch>
</Declaration>
;====
:====

. x =
    -- foo
    foo

:----

<Declaration>
    <TypeCapture>
        <Id name="x"/>
    </TypeCapture>
    <Block>
        <Print>
            <Id name="foo"/>
        </Print>
        <Id name="foo"/>
    </Block>
</Declaration>
;====
