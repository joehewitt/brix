====================================================================================================
Apply without input
====================================================================================================
:====

result | binding

:----
%brix
(main
  (select result (| binding))
)
:----

<StructureMatch>
    <TypeTransform>
        <TypeCapture>
            <Id name="binding"/>
        </TypeCapture>
        <Id name="result"/>
    </TypeTransform>
</StructureMatch>
;====

====================================================================================================
Pattern helper clauses
====================================================================================================
:====

match input
    with helper
    ~ "x"

:----
%brix
(main
  (match input
    (with helper)
    (~ "x")
  )
)
:----

<Match>
    <Id name="input"/>
    <PatternHelper>
        <Id name="helper"/>
    </PatternHelper>
    <StreamMatch>
        <StreamString text="x"/>
    </StreamMatch>
</Match>
;====
:====

match input
    ~ "x"
    with helper

:----
%crash

Exception: with helper must be the first clause of a stream match
<no file:4>
        with helper
        ^^^^^^^^^^^
;====
:====

match input
    with first
    with second
    ~ "x"

:----
%crash

Exception: Stream match has more than one helper
<no file:2>
    match input
    ^^^^^^^^^^
;====
:====

match input
    ~ "x" @rollback
        1

:----
%brix
(main
  (match input
    (~ "x" @rollback
      1
    )
  )
)
:----

<Match>
    <Id name="input"/>
    <StreamMatch>
        <StreamTransform rollback="true">
            <StreamString text="x"/>
            <Block>
                <Integer value="1"/>
            </Block>
        </StreamTransform>
    </StreamMatch>
</Match>
;====
:====

result ~ Binding

:----
%brix
(main
  (select result (~ Binding))
)
:----

<StreamMatch>
    <StreamTransform>
        <StreamType>
            <TypeId name="Binding"/>
        </StreamType>
        <Id name="result"/>
    </StreamTransform>
</StreamMatch>
;====
:====

source ~> \record with helper

:----
%brix
(main
  (~> source \record (with helper))
)
:----

<BinaryExpression operator="~>">
    <Id name="source"/>
    <StreamMatch>
        <StreamCall name="record"/>
        <PatternHelper>
            <Id name="helper"/>
        </PatternHelper>
    </StreamMatch>
</BinaryExpression>
;====
:====

source
~> item . with helper
    item

:----
%brix
(main
  source
  (pipe ~> (: item .)
    (with helper)
    item
  )
)
:----

<Pipeline op="~>">
    <Id name="source"/>
    <StreamMatch>
        <StreamTransform>
            <StreamCapture>
                <Id name="item"/>
                <StreamAny/>
            </StreamCapture>
            <Block>
                <Id name="item"/>
            </Block>
        </StreamTransform>
        <PatternHelper>
            <Id name="helper"/>
        </PatternHelper>
    </StreamMatch>
</Pipeline>
;====
:====

source ~> \record with Helper(scratch)

:----
%brix
(main
  (~> source \record (with (call Helper scratch)))
)
:----

<BinaryExpression operator="~>">
    <Id name="source"/>
    <StreamMatch>
        <StreamCall name="record"/>
        <PatternHelper>
            <CallExpression>
                <TypeId name="Helper"/>
                <Argument>
                    <Id name="scratch"/>
                </Argument>
            </CallExpression>
        </PatternHelper>
    </StreamMatch>
</BinaryExpression>
;====
====================================================================================================
Apply without binding
====================================================================================================
:====

result = input

:----
%brix
(main
  (= result input)
)
:----

<AssignmentExpression op="=">
    <Id name="result"/>
    <Id name="input"/>
</AssignmentExpression>
;====
:====

result =
    input

:----
%brix
(main
  (= result
    (block
      input
    )
  )
)
:----

<AssignmentExpression op="=">
    <Id name="result"/>
    <Block>
        <Id name="input"/>
    </Block>
</AssignmentExpression>
;====
:====

result in input

:----
%brix
(main
  (in result input)
)
:----

<Iterator>
    <In>
        <Id name="input"/>
    </In>
    <Id name="result"/>
</Iterator>
;====
====================================================================================================
Structural match with binding and input
====================================================================================================
:====

result | binding = input

:----
%brix
(main
  (= (select result (| binding)) input)
)
:----

<Match>
    <Id name="input"/>
    <StructureMatch>
        <TypeTransform>
            <TypeCapture>
                <Id name="binding"/>
            </TypeCapture>
            <Id name="result"/>
        </TypeTransform>
    </StructureMatch>
</Match>
;====
:====

result | binding =
    input

:----
%brix
(main
  (= (select result (| binding))
    (block
      input
    )
  )
)
:----

<Match>
    <Block>
        <Id name="input"/>
    </Block>
    <StructureMatch>
        <TypeTransform>
            <TypeCapture>
                <Id name="binding"/>
            </TypeCapture>
            <Id name="result"/>
        </TypeTransform>
    </StructureMatch>
</Match>
;====
:====

result | binding in input

:----
%brix
(main
  (in (select result (| binding)) input)
)
:----

<Iterator>
    <In>
        <StructureMatch>
            <TypeTransform>
                <TypeCapture>
                    <Id name="binding"/>
                </TypeCapture>
                <Id name="result"/>
            </TypeTransform>
        </StructureMatch>
        <Id name="input"/>
    </In>
    <Id name="each"/>
</Iterator>
;====
