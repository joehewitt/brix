            <TypeOr>
                <TypeOr>
                    <TypeTransform>
                        <TypePredicate>
                            <Id name="binding"/>
                        </TypePredicate>
                        <Block>
                            <Id name="result"/>
                        </Block>
                    </TypeTransform>
                    <TypeTransform>
                        <TypePredicate>
                            <Id name="binding"/>
                        </TypePredicate>
                        <UnaryExpression operator="!">
                            <Id name="binding"/>
                        </UnaryExpression>
                    </TypeTransform>
                </TypeOr>
                <TypeTransform>
                    <Id name="result"/>
                </TypeTransform>
            </TypeOr>
