;====
====================================================================================================
Function body match and iterator block header
====================================================================================================
:====

━━━━━━━━━━━━━━━━━━━━
+ foo

match input
    result

:----

<Function names="foo" access="public-access">
    <Block>
        <Match>
            <Id name="input"/>
            <Id name="result"/>
        </Match>
    </Block>
</Function>
;====
:====

━━━━━━━━━━━━━━━━━━━━
+ foo
    = in input

result

:----
%brix
(fn-expr + foo _
  (iterates in input)
  result
)
:----

<Function names="foo" access="public-access">
    <Iterator>
        <In>
            <Id name="input"/>
        </In>
        <Id name="result"/>
    </Iterator>
</Function>
;====
:====

━━━━━━━━━━━━━━━━━━━━
+ foo

match input
    ~ Binding

:----
%brix
(fn-expr + foo _
  (match input
    (~ Binding)
  )
)
:----

<Function names="foo" access="public-access">
    <Block>
        <Match>
            <Id name="input"/>
            <StreamMatch>
                <StreamType>
                    <TypeId name="Binding"/>
                </StreamType>
            </StreamMatch>
        </Match>
    </Block>
</Function>
;====
:====

━━━━━━━━━━━━━━━━━━━━
+ foo
    = in input

~ .

:----
%brix
(fn-expr + foo _
  (iterates in input)
  (~ .)
)
:----

<Function names="foo" access="public-access">
    <Iterator>
        <In>
            <StreamAny/>
            <Id name="input"/>
        </In>
        <Id name="each"/>
    </Iterator>
</Function>
;====
====================================================================================================
"on" variations
====================================================================================================
:====

result on input
result | binding on input
<* binding on input
on input
    result

━━━━━━━━━━━━━━━━━━━━
+ foo
    = on input

x

:----
%brix
(main
  (on result input)
  (on (select result (| binding)) input)
  (case-each (on binding input))
  (iterate (on input)
    (block
      result
    )
  )
)

(fn-expr + foo _
  (iterates on input)
  x
)
:----

<Iterator>
    <On>
        <Id name="input"/>
    </On>
    <Id name="result"/>
</Iterator>
<Iterator>
    <On>
        <StructureMatch>
            <TypeTransform>
                <TypeCapture>
                    <Id name="binding"/>
                </TypeCapture>
                <Id name="result"/>
            </TypeTransform>
        </StructureMatch>
        <Id name="input"/>
    </On>
    <Id name="each"/>
</Iterator>
<Iterator>
    <On>
        <StructureMatch>
            <TypeCapture>
                <Id name="binding"/>
            </TypeCapture>
        </StructureMatch>
        <Id name="input"/>
    </On>
    <Id name="each"/>
</Iterator>
<Iterator>
    <On>
        <Id name="input"/>
    </On>
    <Id name="result"/>
</Iterator>
<Function names="foo" access="public-access">
    <Iterator>
        <On>
            <Id name="input"/>
        </On>
        <Id name="x"/>
    </Iterator>
</Function>
;====
