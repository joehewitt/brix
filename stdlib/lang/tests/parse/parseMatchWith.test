====================================================================================================
Pattern matching
====================================================================================================
:====

match input
    | binding
        result
    | binding

:----
%brix
(main
  (match input
    (case binding
      result
    )
    (case binding)
  )
)
:----

<Match>
    <Id name="input"/>
    <StructureMatch>
        <TypeOr>
            <TypeTransform>
                <TypeCapture>
                    <Id name="binding"/>
                </TypeCapture>
                <Block>
                    <Id name="result"/>
                </Block>
            </TypeTransform>
            <TypeCapture>
                <Id name="binding"/>
            </TypeCapture>
        </TypeOr>
    </StructureMatch>
</Match>

;====
:====

match input
    ~ Binding
        result
    ~ Binding
    ?? result

:----
%brix
(main
  (match input
    (~ Binding
      result
    )
    (~ Binding)
    (default
      (inline result)
    )
  )
)
:----

<Match>
    <Id name="input"/>
    <StreamMatch>
        <StreamOr>
            <StreamOr>
                <StreamTransform>
                    <StreamType>
                        <TypeId name="Binding"/>
                    </StreamType>
                    <Block>
                        <Id name="result"/>
                    </Block>
                </StreamTransform>
                <StreamType>
                    <TypeId name="Binding"/>
                </StreamType>
            </StreamOr>
            <StreamTransform>
                <Id name="result"/>
            </StreamTransform>
        </StreamOr>
    </StreamMatch>
</Match>

;====
:====

match input
    |? binding
        result
    |? binding
    ?? result

:----
%brix
(main
  (match input
    (case? binding
      result
    )
    (case? binding)
    (default
      (inline result)
    )
  )
)
:----

<Match>
    <Id name="input"/>
    <StructureMatch>
        <TypeOr>
            <TypeOr>
                <TypeTransform>
                    <TypePredicate>
                        <Id name="binding"/>
                    </TypePredicate>
                    <Block>
                        <Id name="result"/>
                    </Block>
                </TypeTransform>
                <TypeTransform>
                    <TypePredicate>
                        <Id name="binding"/>
                    </TypePredicate>
                    <UnaryExpression operator="!">
                        <Id name="binding"/>
                    </UnaryExpression>
                </TypeTransform>
            </TypeOr>
            <TypeTransform>
                <Id name="result"/>
            </TypeTransform>
        </TypeOr>
    </StructureMatch>
</Match>

;====
:====

in input
    | binding
        result
    | binding
    ?? result

:----
%brix
(main
  (iterate (in input)
    (block
      (case binding
        result
      )
      (case binding)
      (default
        (inline result)
      )
    )
  )
)
:----

<Iterator>
    <In>
        <StructureMatch>
            <TypeOr>
                <TypeOr>
                    <TypeTransform>
                        <TypeCapture>
                            <Id name="binding"/>
                        </TypeCapture>
                        <Block>
                            <Id name="result"/>
                        </Block>
                    </TypeTransform>
                    <TypeCapture>
                        <Id name="binding"/>
                    </TypeCapture>
                </TypeOr>
                <TypeTransform>
                    <Id name="result"/>
                </TypeTransform>
            </TypeOr>
        </StructureMatch>
        <Id name="input"/>
    </In>
    <Id name="each"/>
</Iterator>

;====
:====

in input
    ~ Binding
        result
