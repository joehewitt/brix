;====
:====
# Parses a blank line between argument lines.

━━━━━━━━━━━━━━━━━━━━
+ do work
    - a Int

    - b Int = 1

. r = a + b

:----
%brix
(fn-do + work _
  (param a Int)
  (param b Int (= 1))
  (blank)
  (let r (+ a b))
)
:----

<Function names="work" access="public-access" imperative="true">
    <ArgumentDecl>
        <TypeCapture>
            <Id name="a"/>
            <TypeId name="Int"/>
        </TypeCapture>
    </ArgumentDecl>
    <ArgumentDecl>
        <TypeCapture>
            <Id name="b"/>
            <TypeId name="Int"/>
        </TypeCapture>
        <Integer value="1"/>
    </ArgumentDecl>
    <Block>
        <Declaration>
            <TypeCapture>
                <Id name="r"/>
            </TypeCapture>
            <BinaryExpression operator="+">
                <Id name="a"/>
                <Id name="b"/>
            </BinaryExpression>
        </Declaration>
    </Block>
</Function>
;====
:====

━━━━━━━━━━━━━━━━━━━━
_ summary
    - reason Int

match reason
    |= 1
        "one"
    ??
        "other"

:----
%brix
(fn-expr _ summary _
  (param reason Int)
  (match reason
    (case= 1
      "one"
    )
    (default
      "other"
    )
  )
)
:----

<Function names="summary" access="private-access">
    <ArgumentDecl>
        <TypeCapture>
            <Id name="reason"/>
            <TypeId name="Int"/>
        </TypeCapture>
    </ArgumentDecl>
    <Block>
        <Match>
            <Id name="reason"/>
            <StructureMatch>
                <TypeOr>
                    <TypeTransform>
                        <TypeEquality>
                            <Integer value="1"/>
                        </TypeEquality>
                        <Block>
                            <String text="one"/>
                        </Block>
                    </TypeTransform>
                    <TypeTransform>
                        <Block>
                            <String text="other"/>
                        </Block>
                    </TypeTransform>
                </TypeOr>
            </StructureMatch>
        </Match>
    </Block>
</Function>
;====
:====

━━━━━━━━━━━━━━━━━━━━
+ summary
