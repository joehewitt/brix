:====

|? y
    x


:----
%brix
(main
  (case? y
    x
  )
)
:----

<StructureMatch>
    <TypeTransform>
        <TypePredicate>
            <Id name="y"/>
        </TypePredicate>
        <Block>
            <Id name="x"/>
        </Block>
    </TypeTransform>
</StructureMatch>
