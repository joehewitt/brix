━━━━━━━━━━━━━━━━━━━━
_ ¶ tree-box-row-text String
    - content String
    - suffix String

$prefix $content $suffix

════════════════════
.. prefix = "hi"

:------------------------------------------------------------------------------------------------
%brix
(fn-expr _ tree-box-row-text String
  (param content String)
  (param suffix String)
  (paragraph
    (str prefix " " content " " suffix)
  )
  (where
    (lazy prefix "hi")
  )
)
:----

<Function names="tree-box-row-text" access="private-access">
    <ArgumentDecl>
        <TypeCapture>
            <Id name="content"/>
            <TypeId name="String"/>
        </TypeCapture>
    </ArgumentDecl>
    <ArgumentDecl>
        <TypeCapture>
            <Id name="suffix"/>
            <TypeId name="String"/>
        </TypeCapture>
    </ArgumentDecl>
    <TypeId name="String"/>
    <Block>
        <BinaryExpression operator="++">
            <BinaryExpression operator="++">
                <BinaryExpression operator="++">
                    <BinaryExpression operator="++">
                        <Id name="prefix"/>
                        <String text=" "/>
                    </BinaryExpression>
                    <Id name="content"/>
                </BinaryExpression>
                <String text=" "/>
            </BinaryExpression>
            <Id name="suffix"/>
        </BinaryExpression>
        <Declaration lazy="true">
            <TypeCapture>
                <Id name="prefix"/>
            </TypeCapture>
            <String text="hi"/>
        </Declaration>
    </Block>
</Function>

