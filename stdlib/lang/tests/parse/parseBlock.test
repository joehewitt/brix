    <ArgumentDecl>
        <TypeCapture>
            <Id name="arg"/>
        </TypeCapture>
    </ArgumentDecl>
    <Block>
        <String text="foo

bar

baz"/>
    </Block>
</Function>
<Function names="other" access="public-access"/>

