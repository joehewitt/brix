    - arg

Foo ${1} bar ${"x".length} baz

:------------------------------------------------------------------------------------------------
%brix
(fn-expr + text _
  (param arg _)
  (paragraph
    (str "Foo " 1 " bar " (. "x" length) " baz")
  )
)
:----

<Function names="text" access="public-access">
    <ArgumentDecl>
        <TypeCapture>
            <Id name="arg"/>
        </TypeCapture>
    </ArgumentDecl>
    <Block>
        <BinaryExpression operator="++">
            <BinaryExpression operator="++">
                <BinaryExpression operator="++">
                    <BinaryExpression operator="++">
                        <String text="Foo "/>
                        <Integer value="1"/>
                    </BinaryExpression>
                    <String text=" bar "/>
                </BinaryExpression>
                <Get name="length">
                    <String text="x"/>
                </Get>
            </BinaryExpression>
            <String text=" baz"/>
        </BinaryExpression>
    </Block>
</Function>

