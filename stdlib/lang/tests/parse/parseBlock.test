:====

do
    do use Thing()
        -- "using"

:----
%brix
(main
  (do
    (do-use (call Thing)
      (print "using")
    )
  )
)
:----

<Do>
    <Block>
        <UseBlock>
            <CallExpression>
                <TypeId name="Thing"/>
            </CallExpression>
            <Block>
                <Print>
                    <String text="using"/>
                </Print>
            </Block>
        </UseBlock>
    </Block>
</Do>
;====
:====

do
    . a = use Thing()

:----
%brix
(main
  (do
    (let a (use (call Thing)))
  )
)
:----

<Do>
    <Block>
        <Declaration>
            <TypeCapture>
                <Id name="a"/>
            </TypeCapture>
            <Use>
                <CallExpression>
                    <TypeId name="Thing"/>
                </CallExpression>
            </Use>
        </Declaration>
    </Block>
</Do>
;====
:====

+ @stack request Int

do with request = 42
    -- request

:----
%brix
(prop + request Int @stack)
(blank)

(main
  (do-with request 42
    (print request)
  )
)
:----

<Property access="public-access" decoration="stack">
    <TypeCapture>
        <Id name="request"/>
        <TypeId name="Int"/>
    </TypeCapture>
</Property>
<StackLocalBinding name="request">
    <Integer value="42"/>
    <Block>
        <Print>
            <Id name="request"/>
        </Print>
    </Block>
</StackLocalBinding>
;====
:====

. term = use Thing()
    bar

:----
%brix
(main
  (let term
    (use
      (call Thing
        (block
          bar
        )
      )
    )
  )
)
:----

<Declaration>
    <TypeCapture>
        <Id name="term"/>
    </TypeCapture>
    <Use>
        <CallExpression>
            <TypeId name="Thing"/>
            <Argument>
                <Block>
                    <Id name="bar"/>
                </Block>
            </Argument>
        </CallExpression>
    </Use>
</Declaration>

