━━━━━━━━━━━━━━━━━━━━
+ ¶ text String
    - content String

$prefix $content

════════════════════
.. prefix = "hi"

━━━━━━━━━━━━━━━━━━━━
+ other String

"ok"

:------------------------------------------------------------------------------------------------
%brix
(fn-expr + text String
  (param content String)
  (paragraph
    (str prefix " " content)
  )
  (where
    (lazy prefix "hi")
  )
)

(fn-expr + other String
  "ok"
)
:----

<Function names="text" access="public-access">
    <ArgumentDecl>
        <TypeCapture>
            <Id name="content"/>
            <TypeId name="String"/>
        </TypeCapture>
    </ArgumentDecl>
    <TypeId name="String"/>
    <Block>
        <BinaryExpression operator="++">
            <BinaryExpression operator="++">
                <Id name="prefix"/>
                <String text=" "/>
            </BinaryExpression>
            <Id name="content"/>
        </BinaryExpression>
        <Declaration lazy="true">
            <TypeCapture>
                <Id name="prefix"/>
            </TypeCapture>
            <String text="hi"/>
        </Declaration>
    </Block>
</Function>
<Function names="other" access="public-access">
    <TypeId name="String"/>
    <Block>
        <String text="ok"/>
    </Block>
</Function>

