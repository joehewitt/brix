====================================================================================================
Basic strings
====================================================================================================
:====

""

:----
%brix
(main
  ""
)
:----

<String text=""/>
;====
:====

"foo"

:----
%brix
(main
  "foo"
)
:----

<String text="foo"/>
;====
====================================================================================================
Character literals
====================================================================================================
:====

'A'

:----
%brix
(main
  'A'
)
:----

<Integer value="65" unit="c"/>
;====
:====

'\n'

:----
%brix
(main
  (char "\n")
)
:----

<Integer value="10" unit="c"/>
;====
:====

'\u20AC'

:----
%brix
(main
  (char "€")
)
:----

<Integer value="8364" unit="c"/>
;====
:====

'💜'

:----
%brix
(main
  (char "💜")
)
:----

<Integer value="128156" unit="c"/>
;====
:====

'\''

:----
%brix
(main
  (char "'")
)
:----

<Integer value="39" unit="c"/>
;====
:====

'\v'

:----
%brix
(main
  (char "\x0b")
)
:----

<Integer value="11" unit="c"/>
;====
:====

'\0'

:----
%brix
(main
  (char "\x00")
)
:----

<Integer value="0" unit="c"/>
;====
:====

'ab'

:----

Exception: Syntax error
<no file:2>
    'ab'
      ^
;====
====================================================================================================
Embedded expressions
====================================================================================================
:====

"foo\${1}bar"

:----
%brix
(main
  "foo\${1}bar"
)
:----

<String text="foo${1}bar"/>
;====
:====

"foo\$bar"

:----
%brix
(main
  "foo\$bar"
)
:----

<String text="foo$bar"/>
;====
:====

"foo${1}"

:----
%brix
(main
  (str "foo" 1)
)
:----

<BinaryExpression operator="++">
    <String text="foo"/>
    <Integer value="1"/>
</BinaryExpression>
;====
:====

"${1}bar"

:----
%brix
(main
  (str 1 "bar")
)
:----

<BinaryExpression operator="++">
    <Integer value="1"/>
    <String text="bar"/>
</BinaryExpression>
;====
:====

"foo${1}bar"

:----
%brix
(main
  (str "foo" 1 "bar")
)
:----

<BinaryExpression operator="++">
    <BinaryExpression operator="++">
        <String text="foo"/>
        <Integer value="1"/>
    </BinaryExpression>
    <String text="bar"/>
</BinaryExpression>
;====
:====

"foo${1}bar${2}baz"

:----
%brix
(main
  (str "foo" 1 "bar" 2 "baz")
)
:----

<BinaryExpression operator="++">
    <BinaryExpression operator="++">
        <BinaryExpression operator="++">
            <BinaryExpression operator="++">
                <String text="foo"/>
                <Integer value="1"/>
            </BinaryExpression>
            <String text="bar"/>
        </BinaryExpression>
        <Integer value="2"/>
    </BinaryExpression>
    <String text="baz"/>
</BinaryExpression>
;====
:================================================================================================

"foo$bar"

:------------------------------------------------------------------------------------------------
%brix
(main
  (str "foo" bar)
)
:----

<BinaryExpression operator="++">
    <String text="foo"/>
    <Id name="bar"/>
</BinaryExpression>

;====
:================================================================================================

"foo$bar.baz"

:------------------------------------------------------------------------------------------------
%brix
(main
  (str "foo" (. bar baz))
)
:----

<BinaryExpression operator="++">
    <String text="foo"/>
    <Get name="baz">
        <Id name="bar"/>
    </Get>
</BinaryExpression>

;====
:====

"foo$bar.#baz"

:----
%brix
(main
  (str "foo" bar ".#baz")
)
:----

<BinaryExpression operator="++">
    <BinaryExpression operator="++">
        <String text="foo"/>
        <Id name="bar"/>
    </BinaryExpression>
    <String text=".#baz"/>
</BinaryExpression>
;====
:====

"\n"

:----
%brix
(main
  "\n"
)
:----

<String text="
"/>
;====
:====

"\t"

:----
%brix
(main
  "\t"
)
:----

<String text="	"/>
;====
:====

"\"\""

:----
%brix
(main
  "\"\""
)
:----

<String text=""""/>
;====
:====

"\u20AC"

:----
%brix
(main
  "€"
)
:----

<String text="€"/>
;====
:====

"\x25"

:----
%brix
(main
  "%"
)
:----

<String text="%"/>
;====
:====
# A line continuation in text adds no character.

"abc\
def"

:----
%brix
(main
  "abcdef"
)
:----

<String text="abcdef"/>
;====
:====
# Text that is only line continuations is dropped beside an expression.

"\
${1}\
"

:----
%brix
(main
  (str "" 1 "")
)
:----

<BinaryExpression operator="++">
    <String text=""/>
    <Integer value="1"/>
</BinaryExpression>
;====
:====
# Line continuations around text and an expression.

"p\
\
q${1}\
r"

:----
%brix
(main
  (str "pq" 1 "r")
)
:----

<BinaryExpression operator="++">
    <BinaryExpression operator="++">
        <String text="pq"/>
        <Integer value="1"/>
    </BinaryExpression>
    <String text="r"/>
</BinaryExpression>
;====
:====

"\x41B"

:----
%brix
(main
  "AB"
)
:----

<String text="AB"/>
;====
:====

"\x25f"

:----
%brix
(main
  "%f"
)
:----

<String text="%f"/>
;====
:====

"\u20ACa"

:----
%brix
(main
  "€a"
)
:----

<String text="€a"/>
;====
:====

"\u00412"

:----
%brix
(main
  "A2"
)
:----

<String text="A2"/>
;====
:====

"\━"

:----
%brix
(main
  "━"
)
:----

<String text="━"/>
;====
