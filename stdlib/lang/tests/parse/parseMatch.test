====================================================================================================
Other combinations
====================================================================================================
:====

|? foo
    y
    .. y = 2
|? foo
    y
    .. y = 2
??
    y
    .. y = 2


:----
%brix
(main
  (case? foo
    y
    (lazy y 2)
  )
  (case? foo
    y
    (lazy y 2)
  )
  (default
    y
    (lazy y 2)
  )
)
:----

<StructureMatch>
    <TypeOr>
        <TypeOr>
            <TypeTransform>
                <TypePredicate>
                    <Id name="foo"/>
                </TypePredicate>
                <Block>
                    <Id name="y"/>
                    <Declaration lazy="true">
                        <TypeCapture>
                            <Id name="y"/>
                        </TypeCapture>
                        <Integer value="2"/>
                    </Declaration>
                </Block>
            </TypeTransform>
            <TypeTransform>
                <TypePredicate>
                    <Id name="foo"/>
                </TypePredicate>
                <Block>
                    <Id name="y"/>
                    <Declaration lazy="true">
                        <TypeCapture>
                            <Id name="y"/>
                        </TypeCapture>
                        <Integer value="2"/>
                    </Declaration>
                </Block>
            </TypeTransform>
        </TypeOr>
        <TypeTransform>
            <Block>
                <Id name="y"/>
                <Declaration lazy="true">
                    <TypeCapture>
                        <Id name="y"/>
                    </TypeCapture>
                    <Integer value="2"/>
                </Declaration>
            </Block>
        </TypeTransform>
    </TypeOr>
</StructureMatch>
;====
:====

|? first
    foo • at bar


:----
%brix
(main
  (case? first
    (call foo (:at bar))
  )
)
:----

<StructureMatch>
    <TypeTransform>
        <TypePredicate>
            <Id name="first"/>
        </TypePredicate>
        <Block>
            <CallExpression>
                <Id name="foo"/>
                <Argument name="at">
                    <Id name="bar"/>
                </Argument>
            </CallExpression>
        </Block>
    </TypeTransform>
</StructureMatch>
;====
:================================================================================================

| a Bar
    foo
| a Bar!
    foo
| a Bar~
    foo

:------------------------------------------------------------------------------------------------

<StructureMatch>
    <TypeOr>
        <TypeOr>
            <TypeTransform>
                <TypeCapture>
                    <Id name="a"/>
                    <TypeId name="Bar"/>
                </TypeCapture>
                <Block>
                    <Id name="foo"/>
                </Block>
            </TypeTransform>
            <TypeTransform>
                <TypeCapture>
                    <Id name="a"/>
                    <TypeMatch op="exactly">
                        <TypeId name="Bar"/>
                    </TypeMatch>
                </TypeCapture>
                <Block>
                    <Id name="foo"/>
                </Block>
            </TypeTransform>
        </TypeOr>
        <TypeTransform>
            <TypeCapture>
                <Id name="a"/>
                <TypeMatch op="similar">
                    <TypeId name="Bar"/>
                </TypeMatch>
            </TypeCapture>
            <Block>
                <Id name="foo"/>
            </Block>
        </TypeTransform>
    </TypeOr>
</StructureMatch>

;====
====================================================================================================
Unionized matches
====================================================================================================
:================================================================================================

||= foo
    1
||? foo
    1
|| Type
    1

:------------------------------------------------------------------------------------------------

<StructureMatch>
    <TypeOr>
        <TypeOr>
            <TypeTransform isUnion="true">
                <TypeEquality>
                    <Id name="foo"/>
                </TypeEquality>
                <Block>
                    <Integer value="1"/>
                </Block>
            </TypeTransform>
            <TypeTransform isUnion="true">
                <TypePredicate>
                    <Id name="foo"/>
                </TypePredicate>
                <Block>
                    <Integer value="1"/>
                </Block>
            </TypeTransform>
        </TypeOr>
        <TypeTransform isUnion="true">
            <TypeId name="Type"/>
            <Block>
                <Integer value="1"/>
            </Block>
        </TypeTransform>
    </TypeOr>
</StructureMatch>

;====
