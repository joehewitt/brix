====================================================================================================
Inline match
====================================================================================================
:====

a if b

:----
%brix
(main
  (only-if a (if b))
)
:----

<BinaryExpression operator="if">
    <Id name="a"/>
    <Id name="b"/>
</BinaryExpression>
;====
:====

if b then a else d

:----
%brix
(main
  (if-expr b a d)
)
:----

<BinaryExpression operator="else">
    <BinaryExpression operator="if">
        <Id name="a"/>
        <Id name="b"/>
    </BinaryExpression>
    <Id name="d"/>
</BinaryExpression>
;====
:====

| foo
    c2
?? c1

:----

<StructureMatch>
    <TypeOr>
        <TypeTransform>
            <TypeCapture>
                <Id name="foo"/>
            </TypeCapture>
            <Block>
                <Id name="c2"/>
            </Block>
        </TypeTransform>
        <TypeTransform>
            <Id name="c1"/>
        </TypeTransform>
    </TypeOr>
</StructureMatch>
;====
:====

|? c2
?? c1

:----
%brix
(main
  (case? c2)
  (default
    (inline c1)
  )
)
:----

<StructureMatch>
    <TypeOr>
        <TypeTransform>
            <TypePredicate>
                <Id name="c2"/>
            </TypePredicate>
            <UnaryExpression operator="!">
                <Id name="c2"/>
            </UnaryExpression>
        </TypeTransform>
        <TypeTransform>
            <Id name="c1"/>
        </TypeTransform>
    </TypeOr>
</StructureMatch>
;====
:====

|? foo
    c3
| bar
    c2
|? c4
?? c1

:----

<StructureMatch>
    <TypeOr>
        <TypeOr>
            <TypeOr>
                <TypeTransform>
                    <TypePredicate>
                        <Id name="foo"/>
                    </TypePredicate>
                    <Block>
                        <Id name="c3"/>
                    </Block>
                </TypeTransform>
                <TypeTransform>
                    <TypeCapture>
                        <Id name="bar"/>
                    </TypeCapture>
                    <Block>
                        <Id name="c2"/>
                    </Block>
                </TypeTransform>
            </TypeOr>
            <TypeTransform>
                <TypePredicate>
                    <Id name="c4"/>
                </TypePredicate>
                <UnaryExpression operator="!">
                    <Id name="c4"/>
                </UnaryExpression>
            </TypeTransform>
        </TypeOr>
        <TypeTransform>
            <Id name="c1"/>
        </TypeTransform>
    </TypeOr>
</StructureMatch>

;====
====================================================================================================
Anonymous match cases
====================================================================================================
:====

|? missing-email
    ..invalid-email
??
    ..valid(email, password)

:----
%brix
(main
  (case? missing-email
    ..invalid-email
  )
  (default
    (call ..valid email password)
  )
)
:----

<StructureMatch>
    <TypeOr>
        <TypeTransform>
            <TypePredicate>
                <Id name="missing-email"/>
            </TypePredicate>
            <Block>
                <AnonymousCase name="invalid-email"/>
            </Block>
        </TypeTransform>
        <TypeTransform>
            <Block>
                <AnonymousCase name="valid">
                    <Id name="email"/>
                    <Id name="password"/>
                </AnonymousCase>
            </Block>
        </TypeTransform>
    </TypeOr>
</StructureMatch>
;====
:====

~ "ok"
    ..ok
??
    ..failed(code)

:----
%brix
(main
  (~ "ok"
    ..ok
  )
  (default
    (call ..failed code)
  )
)
:----

<StreamMatch>
    <StreamOr>
        <StreamTransform>
            <StreamString text="ok"/>
            <Block>
                <AnonymousCase name="ok"/>
            </Block>
        </StreamTransform>
        <StreamTransform>
            <Block>
                <AnonymousCase name="failed">
                    <Id name="code"/>
                </AnonymousCase>
            </Block>
        </StreamTransform>
    </StreamOr>
</StreamMatch>
;====
:====

. result = match input
    |? missing-email
        ..invalid-email
    ??
        ..valid(email, password)

:----
%brix
(main
  (let result
    (match input
      (case? missing-email
        ..invalid-email
      )
      (default
        (call ..valid email password)
      )
    )
  )
)
:----

<Declaration>
    <TypeCapture>
        <Id name="result"/>
    </TypeCapture>
    <Match>
        <Id name="input"/>
        <StructureMatch>
            <TypeOr>
                <TypeTransform>
                    <TypePredicate>
                        <Id name="missing-email"/>
                    </TypePredicate>
                    <Block>
                        <AnonymousCase name="invalid-email" owner="result"/>
                    </Block>
                </TypeTransform>
                <TypeTransform>
                    <Block>
                        <AnonymousCase name="valid" owner="result">
                            <Id name="email"/>
                            <Id name="password"/>
                        </AnonymousCase>
                    </Block>
                </TypeTransform>
            </TypeOr>
        </StructureMatch>
    </Match>
</Declaration>
;====
:====

.. login-submission = on submitted
    |? !email-box.text
        ..invalid-email
    |? !password-box.text
        ..invalid-password
    ??
        ..valid(email-box.text, password-box.text)

:----
%brix
(main
  (lazy login-submission
    (iterate (on submitted)
      (block
        (case? (not (. email-box text))
          ..invalid-email
        )
        (case? (not (. password-box text))
          ..invalid-password
        )
        (default
          (call ..valid (. email-box text) (. password-box text))
        )
      )
    )
  )
)
:----

<Declaration lazy="true">
    <TypeCapture>
        <Id name="login-submission"/>
    </TypeCapture>
    <Iterator>
        <On>
            <StructureMatch>
                <TypeOr>
                    <TypeOr>
                        <TypeTransform>
                            <TypePredicate>
                                <UnaryExpression operator="!">
                                    <Get name="text">
                                        <Id name="email-box"/>
                                    </Get>
                                </UnaryExpression>
                            </TypePredicate>
                            <Block>
                                <AnonymousCase name="invalid-email" owner="login-submission"/>
                            </Block>
                        </TypeTransform>
                        <TypeTransform>
                            <TypePredicate>
                                <UnaryExpression operator="!">
                                    <Get name="text">
                                        <Id name="password-box"/>
                                    </Get>
                                </UnaryExpression>
                            </TypePredicate>
                            <Block>
                                <AnonymousCase name="invalid-password" owner="login-submission"/>
                            </Block>
                        </TypeTransform>
                    </TypeOr>
                    <TypeTransform>
                        <Block>
                            <AnonymousCase name="valid" owner="login-submission">
                                <Get name="text">
                                    <Id name="email-box"/>
                                </Get>
                                <Get name="text">
                                    <Id name="password-box"/>
                                </Get>
                            </AnonymousCase>
                        </Block>
                    </TypeTransform>
                </TypeOr>
            </StructureMatch>
            <Id name="submitted"/>
        </On>
        <Id name="each"/>
    </Iterator>
</Declaration>
;====
:====

. event = match input
    ~ "ok"
        ..ok
    ??
        ..failed(code)

:----
%brix
(main
  (let event
    (match input
      (~ "ok"
        ..ok
      )
      (default
        (call ..failed code)
      )
    )
  )
)
:----

<Declaration>
    <TypeCapture>
        <Id name="event"/>
    </TypeCapture>
    <Match>
        <Id name="input"/>
        <StreamMatch>
            <StreamOr>
                <StreamTransform>
                    <StreamString text="ok"/>
                    <Block>
                        <AnonymousCase name="ok" owner="event"/>
                    </Block>
                </StreamTransform>
                <StreamTransform>
                    <Block>
                        <AnonymousCase name="failed" owner="event">
                            <Id name="code"/>
                        </AnonymousCase>
                    </Block>
                </StreamTransform>
            </StreamOr>
        </StreamMatch>
    </Match>
</Declaration>
;====
