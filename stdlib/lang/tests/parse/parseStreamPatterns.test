====================================================================================================
Patterns
====================================================================================================
:====

~ Foo

:----
%brix
(main
  (~ Foo)
)
:----

<StreamMatch>
    <StreamType>
        <TypeId name="Foo"/>
    </StreamType>
</StreamMatch>
;====
:====

~ foo Foo

:----
%brix
(main
  (~ (: foo Foo))
)
:----

<StreamMatch>
    <StreamCapture>
        <Id name="foo"/>
        <StreamType>
            <TypeId name="Foo"/>
        </StreamType>
    </StreamCapture>
</StreamMatch>
;====
:====

~ foo Foo bar Bar

:----
%brix
(main
  (~ (seq (: foo Foo) (: bar Bar)))
)
:----

<StreamMatch>
    <StreamAnd>
        <StreamCapture>
            <Id name="foo"/>
            <StreamType>
                <TypeId name="Foo"/>
            </StreamType>
        </StreamCapture>
        <StreamCapture>
            <Id name="bar"/>
            <StreamType>
                <TypeId name="Bar"/>
            </StreamType>
        </StreamCapture>
    </StreamAnd>
</StreamMatch>
;====
:====

~ Foo?

:----
%brix
(main
  (~ (? Foo))
)
:----

<StreamMatch>
    <UnaryStream op="?">
        <StreamType>
            <TypeId name="Foo"/>
        </StreamType>
    </UnaryStream>
</StreamMatch>
;====
:====

~ Foo*

:----
%brix
(main
  (~ (* Foo))
)
:----

<StreamMatch>
    <UnaryStream op="*">
        <StreamType>
            <TypeId name="Foo"/>
        </StreamType>
    </UnaryStream>
</StreamMatch>
;====
:====

~ Foo+

:----
%brix
(main
  (~ (+ Foo))
)
:----

<StreamMatch>
    <UnaryStream op="+">
        <StreamType>
            <TypeId name="Foo"/>
        </StreamType>
    </UnaryStream>
</StreamMatch>
;====
:====

~ Foo (Bar Baz)+

:----
%brix
(main
  (~ (seq Foo (+ (seq Bar Baz))))
)
:----

<StreamMatch>
    <StreamAnd>
        <StreamType>
            <TypeId name="Foo"/>
        </StreamType>
        <UnaryStream op="+">
            <StreamAnd>
                <StreamType>
                    <TypeId name="Bar"/>
                </StreamType>
                <StreamType>
                    <TypeId name="Baz"/>
                </StreamType>
            </StreamAnd>
        </UnaryStream>
    </StreamAnd>
</StreamMatch>
;====
:====

~ sc (Foo Bar)

:----
%brix
(main
  (~ (: sc (seq Foo Bar)))
)
:----

<StreamMatch>
    <StreamCapture>
        <Id name="sc"/>
        <StreamAnd>
            <StreamType>
                <TypeId name="Foo"/>
            </StreamType>
            <StreamType>
                <TypeId name="Bar"/>
            </StreamType>
        </StreamAnd>
    </StreamCapture>
</StreamMatch>
;====
:====

~ sc Foo+

:----
%brix
(main
  (~ (: sc (+ Foo)))
)
:----

<StreamMatch>
    <StreamCapture>
        <Id name="sc"/>
        <UnaryStream op="+">
            <StreamType>
                <TypeId name="Foo"/>
            </StreamType>
        </UnaryStream>
    </StreamCapture>
</StreamMatch>
;====
:====

~ !Foo

:----
%brix
(main
  (~ (! Foo))
)
:----

<StreamMatch>
    <UnaryStream op="!">
        <StreamType>
            <TypeId name="Foo"/>
        </StreamType>
    </UnaryStream>
</StreamMatch>
;====
:====

~ Foo | Bar | Baz

:----
%brix
(main
  (~ (| Foo Bar Baz))
)
:----

<StreamMatch>
    <StreamOr>
        <StreamOr>
            <StreamType>
                <TypeId name="Foo"/>
            </StreamType>
            <StreamType>
                <TypeId name="Bar"/>
            </StreamType>
        </StreamOr>
        <StreamType>
            <TypeId name="Baz"/>
        </StreamType>
    </StreamOr>
</StreamMatch>
;====
:====

~ [a-z0-9|]

:----
%brix
(main
  (~ (chars "a-z0-9|"))
)
:----

<StreamMatch>
    <StreamOr>
        <StreamOr>
            <StreamCharRange>
                <Integer value="97" unit="c"/>
                <Integer value="122" unit="c"/>
            </StreamCharRange>
            <StreamCharRange>
                <Integer value="48" unit="c"/>
                <Integer value="57" unit="c"/>
            </StreamCharRange>
        </StreamOr>
        <StreamCharRange>
            <Integer value="124" unit="c"/>
            <Integer value="124" unit="c"/>
        </StreamCharRange>
    </StreamOr>
</StreamMatch>
;====
:====

~ [\u03b1]

:----
%brix
(main
  (~ (chars "\\u03b1"))
)
:----

<StreamMatch>
    <StreamCharRange>
        <Integer value="945" unit="c"/>
        <Integer value="945" unit="c"/>
    </StreamCharRange>
</StreamMatch>
;====
:====

~ \foo()
~ \foo(~ .)
~ \foo(~ ., ~ .)
~ \foo(~ ., ~ ., ~ .)

:----
%brix
(main
  (~ (call \foo))
  (~ (call \foo (~ .)))
  (~ (call \foo (~ .) (~ .)))
  (~ (call \foo (~ .) (~ .) (~ .)))
)
:----

<StreamMatch>
    <StreamOr>
        <StreamOr>
            <StreamOr>
                <StreamCall name="foo"/>
                <StreamCall name="foo">
                    <args>
                        <StreamMatch>
                            <StreamAny/>
                        </StreamMatch>
                    </args>
                </StreamCall>
            </StreamOr>
            <StreamCall name="foo">
                <args>
                    <StreamMatch>
                        <StreamAny/>
                    </StreamMatch>
                    <StreamMatch>
                        <StreamAny/>
                    </StreamMatch>
                </args>
            </StreamCall>
        </StreamOr>
        <StreamCall name="foo">
            <args>
                <StreamMatch>
                    <StreamAny/>
                </StreamMatch>
                <StreamMatch>
                    <StreamAny/>
                </StreamMatch>
                <StreamMatch>
                    <StreamAny/>
                </StreamMatch>
            </args>
        </StreamCall>
    </StreamOr>
</StreamMatch>
;====
====================================================================================================
Combinations
====================================================================================================
:====

~ Foo
~ Bar

:----
%brix
(main
  (~ Foo)
  (~ Bar)
)
:----

<StreamMatch>
    <StreamOr>
        <StreamType>
            <TypeId name="Foo"/>
        </StreamType>
        <StreamType>
            <TypeId name="Bar"/>
        </StreamType>
    </StreamOr>
</StreamMatch>
;====
:====

~ Foo
?? bar

:----
%brix
(main
  (~ Foo)
  (default
    (inline bar)
  )
)
:----

<StreamMatch>
    <StreamOr>
        <StreamType>
            <TypeId name="Foo"/>
        </StreamType>
        <StreamTransform>
            <Id name="bar"/>
        </StreamTransform>
    </StreamOr>
</StreamMatch>
;====
:====

~ Foo
?! bar

:----
%brix
(main
  (~ Foo)
  (throw bar)
)
:----

<StreamMatch>
    <StreamOr>
        <StreamType>
            <TypeId name="Foo"/>
        </StreamType>
        <StreamPanic>
            <StreamTransform>
                <Id name="bar"/>
            </StreamTransform>
        </StreamPanic>
    </StreamOr>
</StreamMatch>
;====
:====

|? expr
    ~ Foo
??
    ~ Bar

:----
%brix
(main
  (case? expr
    (~ Foo)
  )
  (default
    (~ Bar)
  )
)
:----

<StructureMatch>
    <TypeOr>
        <TypeTransform>
            <TypePredicate>
                <Id name="expr"/>
            </TypePredicate>
            <Block>
                <StreamMatch>
                    <StreamType>
                        <TypeId name="Foo"/>
                    </StreamType>
                </StreamMatch>
            </Block>
        </TypeTransform>
        <TypeTransform>
            <Block>
                <StreamMatch>
                    <StreamType>
                        <TypeId name="Bar"/>
                    </StreamType>
                </StreamMatch>
            </Block>
        </TypeTransform>
    </TypeOr>
</StructureMatch>
;====
:====

x = ~ Bar = foo

:----
%brix
(main
  (= x (~ Bar (of: foo)))
)
:----

<AssignmentExpression op="=">
    <Id name="x"/>
    <Match>
        <Id name="foo"/>
        <StreamMatch>
            <StreamType>
                <TypeId name="Bar"/>
            </StreamType>
        </StreamMatch>
    </Match>
</AssignmentExpression>
;====
:====

match foo
    ~ \foo
    .. foo ~ @rollback
        ~ Foo

:----
%brix
(main
  (match foo
    (~ \foo)
    (lazy foo
      (pattern
        @rollback
        (~ Foo)
      )
    )
  )
)
:----

<Match>
    <Id name="foo"/>
    <Block>
        <StreamMatch>
            <StreamCall name="foo"/>
        </StreamMatch>
        <Declaration lazy="true" pattern="true" rollback="true">
            <TypeCapture>
                <Id name="foo"/>
            </TypeCapture>
            <StreamMatch>
                <StreamType>
                    <TypeId name="Foo"/>
                </StreamType>
            </StreamMatch>
        </Declaration>
    </Block>
</Match>
;====
:====

match foo
    ~ \bar
        expr1
    .. bar ~
        ~ Pattern

:----
%brix
(main
  (match foo
    (~ \bar
      expr1
    )
    (lazy bar
      (pattern
        (~ Pattern)
      )
    )
  )
)
:----

<Match>
    <Id name="foo"/>
    <Block>
        <StreamMatch>
            <StreamTransform>
                <StreamCall name="bar"/>
                <Block>
                    <Id name="expr1"/>
                </Block>
            </StreamTransform>
        </StreamMatch>
        <Declaration lazy="true" pattern="true">
            <TypeCapture>
                <Id name="bar"/>
            </TypeCapture>
            <StreamMatch>
                <StreamType>
                    <TypeId name="Pattern"/>
                </StreamType>
            </StreamMatch>
        </Declaration>
    </Block>
</Match>
;====
:====
# Consecutive applied matches don't combine

~ \foo'Bar() = foo
~ \foo'Bar() = foo

:----
%brix
(main
  (~ (call (of \foo Bar)) (of: foo))
  (~ (call (of \foo Bar)) (of: foo))
)
:----

<Match>
    <Id name="foo"/>
    <StreamMatch>
        <StreamCall name="foo">
            <params>
                <TypeId name="Bar"/>
            </params>
        </StreamCall>
    </StreamMatch>
</Match>
<Match>
    <Id name="foo"/>
    <StreamMatch>
        <StreamCall name="foo">
            <params>
                <TypeId name="Bar"/>
            </params>
        </StreamCall>
    </StreamMatch>
</Match>
;====
:====

match foo
    ~ .
        42
    ?! Error()
    .. a = 1

match foo
    ~ .
        42
    .. a = 1
    ?! Error()

:----
%brix
(main
  (match foo
    (~ .
      42
    )
    (throw (call Error))
    (lazy a 1)
  )
  (blank)
  (match foo
    (~ .
      42
    )
    (lazy a 1)
    (throw (call Error))
  )
)
:----

<Match>
    <Id name="foo"/>
    <Block>
        <StreamMatch>
            <StreamOr>
                <StreamTransform>
                    <StreamAny/>
                    <Block>
                        <Integer value="42"/>
                    </Block>
                </StreamTransform>
                <StreamPanic>
                    <StreamTransform>
                        <CallExpression>
                            <TypeId name="Error"/>
                        </CallExpression>
                    </StreamTransform>
                </StreamPanic>
            </StreamOr>
        </StreamMatch>
        <Declaration lazy="true">
            <TypeCapture>
                <Id name="a"/>
            </TypeCapture>
            <Integer value="1"/>
        </Declaration>
    </Block>
</Match>
<Match>
    <Id name="foo"/>
    <Block>
        <StreamMatch>
            <StreamTransform>
                <StreamAny/>
                <Block>
                    <Integer value="42"/>
                </Block>
            </StreamTransform>
        </StreamMatch>
        <Declaration lazy="true">
            <TypeCapture>
                <Id name="a"/>
            </TypeCapture>
            <Integer value="1"/>
        </Declaration>
        <Assert>
            <CallExpression>
                <TypeId name="Error"/>
            </CallExpression>
        </Assert>
    </Block>
</Match>
;====
:====

.. domain ~
    ~ "x"

:----
%brix
(main
  (lazy domain
    (pattern
      (~ "x")
    )
  )
)
:----

<Declaration lazy="true" pattern="true">
    <TypeCapture>
        <Id name="domain"/>
    </TypeCapture>
    <StreamMatch>
        <StreamString text="x"/>
    </StreamMatch>
</Declaration>
;====
:====

.. domain ~
    ~ 'x'

:----
%brix
(main
  (lazy domain
    (pattern
      (~ 'x')
    )
  )
)
:----

<Declaration lazy="true" pattern="true">
    <TypeCapture>
        <Id name="domain"/>
    </TypeCapture>
    <StreamMatch>
        <StreamEquality>
            <Integer value="120" unit="c"/>
        </StreamEquality>
    </StreamMatch>
</Declaration>
;====
:====

.. domain ~
    ~ \letter

    .. foo = 1

:----
%brix
(main
  (lazy domain
    (pattern
      (~ \letter)
      (blank)
      (lazy foo 1)
    )
  )
)
:----

<Declaration lazy="true" pattern="true">
    <TypeCapture>
        <Id name="domain"/>
    </TypeCapture>
    <StreamMatch>
        <StreamCall name="letter"/>
    </StreamMatch>
</Declaration>
;====
:====

~ \{foo}

:----
%brix
(main
  (~ (\{} foo))
)
:----

<StreamMatch>
    <StreamPredicate>
        <Id name="foo"/>
    </StreamPredicate>
</StreamMatch>
;====
:====

~ ...values Foo

:----
%brix
(main
  (~ (: ...values Foo))
)
:----

<StreamMatch>
    <StreamCapture accumulating="true">
        <Id name="values"/>
        <StreamType>
            <TypeId name="Foo"/>
        </StreamType>
    </StreamCapture>
</StreamMatch>
;====
:====

~ \helper(into values)

:----
%brix
(main
  (~ (call \helper (into values)))
)
:----

<StreamMatch>
    <StreamCall name="helper">
        <collectorMappings>
            <CollectorMapping caller="values"/>
        </collectorMappings>
    </StreamCall>
</StreamMatch>
;====
:====

~ \expression(into terms: outer-terms, into operators: outer-operators)

:----
%brix
(main
  (~ (call \expression (into terms outer-terms) (into operators outer-operators)))
)
:----

<StreamMatch>
    <StreamCall name="expression">
        <collectorMappings>
            <CollectorMapping callee="terms" caller="outer-terms"/>
            <CollectorMapping callee="operators" caller="outer-operators"/>
        </collectorMappings>
    </StreamCall>
</StreamMatch>
;====
