:====

= foo

:----
%brix
(main
  (return foo)
)
:----

<Return>
    <Id name="foo"/>
</Return>
;====
:====

<= foo

:----
%brix
(main
  (yield foo)
)
:----

<Yield>
    <Id name="foo"/>
</Yield>
;====
:====

<<= foo

:----
%brix
(main
  (yield-all foo)
)
:----

<For>
    <In>
        <TypeCapture>
            <Id name="-"/>
        </TypeCapture>
        <Id name="foo"/>
    </In>
    <Yield>
        <Id name="-"/>
    </Yield>
</For>
;====
:====

x
-- foo

:----
%brix
(main
  x
  (print foo)
)
:----

<Id name="x"/>
<Print>
    <Id name="foo"/>
</Print>
;====
:====

break

:----
%brix
(main
  (break)
)
:----

<Break/>
;====
:====

continue

:----
%brix
(main
  (continue)
)
:----

<Continue/>
;====
:====
# A name that begins with break or continue is a name, not a break or a continue.

break-x()
continue-x()

:----
%brix
(main
  (call break-x)
  (call continue-x)
)
:----

<CallExpression>
    <Id name="break-x"/>
</CallExpression>
<CallExpression>
    <Id name="continue-x"/>
</CallExpression>
;====
