:================================================================================================

* foo
* bar
* baz

:------------------------------------------------------------------------------------------------
%brix
(main
  (bullet foo)
  (bullet bar)
  (bullet baz)
)
:----

<Bullet>
    <Id name="foo"/>
    <Bullet>
        <Id name="bar"/>
        <Bullet>
            <Id name="baz"/>
        </Bullet>
    </Bullet>
</Bullet>

;====
:================================================================================================

*? foo
**? bar

:------------------------------------------------------------------------------------------------
%brix
(main
  (bullet? foo)
  (bullet*? bar)
)
:----

<Bullet optional="true">
    <Id name="foo"/>
    <Bullet multi="true" optional="true">
        <Id name="bar"/>
    </Bullet>
</Bullet>

;====
:====

* foo
** bar
* baz

:----
%brix
(main
  (bullet foo)
  (bullet* bar)
  (bullet baz)
)
:----

<Bullet>
    <Id name="foo"/>
    <Bullet multi="true">
        <Id name="bar"/>
        <Bullet>
            <Id name="baz"/>
        </Bullet>
    </Bullet>
</Bullet>

;====
:====

* foo
|> bar

:----
%brix
(main
  (bullet foo)
  (pipe |> bar)
)
:----

<Pipeline op="|>">
    <Bullet>
        <Id name="foo"/>
    </Bullet>
    <Id name="bar"/>
</Pipeline>

;====
:====

1
|> a
*> b
?> c
|=> d

:----
%brix
(main
  1
  (pipe |> a)
  (pipe *> b)
  (pipe ?> c)
  (pipe |=> d)
)
:----

<Pipeline op="|=>">
    <Pipeline op="?>">
        <Pipeline op="*>">
            <Pipeline op="|>">
                <Integer value="1"/>
                <Id name="a"/>
            </Pipeline>
            <Id name="b"/>
        </Pipeline>
        <Id name="c"/>
    </Pipeline>
    <Id name="d"/>
</Pipeline>

;====
:====

source
~> \record
?> each.relevant
*-> destination

:----
%brix
(main
  source
  (pipe ~> \record)
  (pipe ?> (. each relevant))
  (pipe *-> destination)
)
:----

<Pipeline op="*->">
    <Pipeline op="?>">
        <Pipeline op="~>">
            <Id name="source"/>
            <StreamMatch>
                <StreamCall name="record"/>
            </StreamMatch>
        </Pipeline>
        <Get name="relevant">
            <Id name="each"/>
        </Get>
    </Pipeline>
    <Id name="destination"/>
</Pipeline>
;====
:====

source ~> \record+

:----
%brix
(main
  (~> source (+ \record))
)
:----

<BinaryExpression operator="~>">
    <Id name="source"/>
    <StreamMatch>
        <UnaryStream op="+">
            <StreamCall name="record"/>
        </UnaryStream>
    </StreamMatch>
</BinaryExpression>
;====
:====

source
~> line (.)* \nl?
    line
|> print-all

:----
%brix
(main
  source
  (pipe ~> (seq (: line (* .)) (? \nl))
    line
  )
  (pipe |> print-all)
)
:----

<Pipeline op="|>">
    <Pipeline op="~>">
        <Id name="source"/>
        <StreamMatch>
            <StreamTransform>
                <StreamAnd>
                    <StreamCapture>
                        <Id name="line"/>
                        <UnaryStream op="*">
                            <StreamAny/>
                        </UnaryStream>
                    </StreamCapture>
                    <UnaryStream op="?">
                        <StreamCall name="nl"/>
                    </UnaryStream>
                </StreamAnd>
                <Block>
                    <Id name="line"/>
                </Block>
            </StreamTransform>
        </StreamMatch>
    </Pipeline>
    <Id name="print-all"/>
</Pipeline>
;====
:====

* foo in set • with
    indented
* bar

:----
%brix
(main
  (bullet
    (call (in foo set)
      (:with
        (block
          indented
        )
      )
    )
  )
  (bullet bar)
)
:----

<Bullet>
    <CallExpression>
        <Iterator>
            <In>
                <Id name="set"/>
            </In>
            <Id name="foo"/>
        </Iterator>
        <Argument name="with">
            <Block>
                <Id name="indented"/>
            </Block>
        </Argument>
    </CallExpression>
    <Bullet>
        <Id name="bar"/>
    </Bullet>
</Bullet>
;====
:====

foo <-* bar

:----
%brix
(main
  (<-* foo bar)
)
:----

<For>
    <In>
        <TypeCapture>
            <Id name="(item)"/>
        </TypeCapture>
        <Id name="bar"/>
    </In>
    <BinaryExpression operator="<-write">
        <Id name="foo"/>
        <Id name="(item)"/>
    </BinaryExpression>
</For>
;====
:====

1
*> each * 2

:----
%brix
(main
  1
  (pipe *> (* each 2))
)
:----

<Pipeline op="*>">
    <Integer value="1"/>
    <BinaryExpression operator="*">
        <Id name="each"/>
        <Integer value="2"/>
    </BinaryExpression>
</Pipeline>

;====
:====

1
?> each * 2

:----
%brix
(main
  1
  (pipe ?> (* each 2))
)
:----

<Pipeline op="?>">
    <Integer value="1"/>
    <BinaryExpression operator="*">
        <Id name="each"/>
        <Integer value="2"/>
    </BinaryExpression>
</Pipeline>

;====
:====

1
|=> it * 2

:----
%brix
(main
  1
  (pipe |=> (* it 2))
)
:----

<Pipeline op="|=>">
    <Integer value="1"/>
    <BinaryExpression operator="*">
        <Id name="it"/>
        <Integer value="2"/>
    </BinaryExpression>
</Pipeline>

;====
:====

1
|> double • where each % 2

:----
%brix
(main
  1
  (pipe |> (call double (:where (% each 2))))
)
:----

<Pipeline op="|>">
    <Integer value="1"/>
    <CallExpression>
        <Id name="double"/>
        <Argument name="where">
            <Function names="(closure)" access="private-access">
                <ArgumentDecl>
                    <TypeCapture>
                        <Id name="each"/>
                    </TypeCapture>
                </ArgumentDecl>
                <BinaryExpression operator="%">
                    <Id name="each"/>
                    <Integer value="2"/>
                </BinaryExpression>
            </Function>
        </Argument>
    </CallExpression>
</Pipeline>

;====
:====

════════════════════
foo

bar
baz

:----
%brix
(main
  (header foo)
  bar
  baz
)
:----

<Header>
    <Id name="foo"/>
    <items>
        <Id name="bar"/>
        <Id name="baz"/>
    </items>
</Header>
;====
:====

════════════════════
foo

=> bar
=> baz

:----
%brix
(main
  (header foo)
  (=> () bar)
  (=> () baz)
)
:----

<Header>
    <Id name="foo"/>
    <items>
        <Function names="(closure)" access="private-access">
            <Id name="bar"/>
        </Function>
        <Function names="(closure2)" access="private-access">
            <Id name="baz"/>
        </Function>
    </items>
</Header>
;====
:====

════════════════════
foo

bar
.. bar = 1

════════════════════
baz

qux

:----
%brix
(main
  (header foo)
  bar
  (lazy bar 1)
  (header baz)
  qux
)
:----

<Declaration lazy="true">
    <TypeCapture>
        <Id name="bar"/>
    </TypeCapture>
    <Integer value="1"/>
</Declaration>
<Header>
    <Id name="foo"/>
    <items>
        <Id name="bar"/>
        <Header>
            <Id name="baz"/>
            <items/>
        </Header>
        <Id name="qux"/>
    </items>
</Header>
;====
