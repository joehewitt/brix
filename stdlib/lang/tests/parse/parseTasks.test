:====

do new @priority
    work()

:----
%brix
(main
  (do-new @priority
    (call work)
  )
)
:----

<DoTask scheduling="priority">
    <Block>
        <CallExpression>
            <Id name="work"/>
        </CallExpression>
    </Block>
</DoTask>
;====
:====

do new @normal
    work()

:----
%brix
(main
  (do-new @normal
    (call work)
  )
)
:----

<DoTask>
    <Block>
        <CallExpression>
            <Id name="work"/>
        </CallExpression>
    </Block>
</DoTask>
;====
:====

do new thread @priority
    work()

:----
%brix
(main
  (do-new-thread @priority
    (call work)
  )
)
:----

<DoTask parallel="true" scheduling="priority">
    <Block>
        <CallExpression>
            <Id name="work"/>
        </CallExpression>
    </Block>
</DoTask>
;====
:====

do new thread(work)

:----
%brix
(main
  (do-new
    (inline (call thread work))
  )
)
:----

<DoTask>
    <CallExpression>
        <Id name="thread"/>
        <Argument>
            <Id name="work"/>
        </Argument>
    </CallExpression>
</DoTask>
;====
:====

do (worker) new @priority
    work()

:----
%brix
(main
  (do-new (worker: worker) @priority
    (call work)
  )
)
:----

<DoTask scheduling="priority">
    <worker>
        <Id name="worker"/>
    </worker>
    <Block>
        <CallExpression>
            <Id name="work"/>
        </CallExpression>
    </Block>
</DoTask>
;====
