:====

do new
    serve(connection)
catch failure Panic
    log(failure)

:----
%brix
(main
  (do-new
    (call serve connection)
    (on-failure (: failure Panic)
      (call log failure)
    )
  )
)
:----

<DoTask>
    <Block>
        <CallExpression>
            <Id name="serve"/>
            <Argument>
                <Id name="connection"/>
            </Argument>
        </CallExpression>
    </Block>
    <Catch>
        <TypeCapture>
            <Id name="failure"/>
            <TypeId name="Panic"/>
        </TypeCapture>
        <Block>
            <CallExpression>
                <Id name="log"/>
                <Argument>
                    <Id name="failure"/>
                </Argument>
            </CallExpression>
        </Block>
    </Catch>
</DoTask>
;====
:====

do new serve(connection)
catch failure OutOfBoundsError
    log(failure)

:----
%brix
(main
  (do-new
    (inline (call serve connection))
    (on-failure (: failure OutOfBoundsError)
      (call log failure)
    )
  )
)
:----

<DoTask>
    <CallExpression>
        <Id name="serve"/>
        <Argument>
            <Id name="connection"/>
        </Argument>
    </CallExpression>
    <Catch>
        <TypeCapture>
            <Id name="failure"/>
            <TypeId name="OutOfBoundsError"/>
        </TypeCapture>
        <Block>
            <CallExpression>
                <Id name="log"/>
                <Argument>
                    <Id name="failure"/>
                </Argument>
            </CallExpression>
        </Block>
    </Catch>
</DoTask>
