do new @priority
    work()

:----
%brix
(main
  (do-new @priority
    (call work)
  )
)
:----

<DoTask scheduling="priority">
    <Block>
        <CallExpression>
            <Id name="work"/>
        </CallExpression>
    </Block>
</DoTask>
