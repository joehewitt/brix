%brix
(main
  (do-new (worker: worker) @priority
    (call work)
  )
)
:----

<DoTask scheduling="priority">
    <worker>
        <Id name="worker"/>
    </worker>
    <Block>
        <CallExpression>
            <Id name="work"/>
        </CallExpression>
    </Block>
</DoTask>
