<CallExpression>
    <Id name="foo"/>
    <Argument name="where">
        <Function names="(closure)" access="private-access">
            <ArgumentDecl>
                <TypeCapture>
                    <Id name="each"/>
                </TypeCapture>
            </ArgumentDecl>
            <BinaryExpression operator="*">
                <Id name="each"/>
                <Integer value="2"/>
            </BinaryExpression>
        </Function>
    </Argument>
</CallExpression>
