    <ArgumentDecl variadic="true">
        <TypeCapture>
            <Id name="foo"/>
            <TypeArguments>
                <TypeId name="List"/>
                <TypeId name="Int"/>
            </TypeArguments>
        </TypeCapture>
    </ArgumentDecl>
    <Id name="foo"/>
