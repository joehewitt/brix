:====

=> do f(1)

:----
%brix
(main
  (=> () :do (call f 1))
)
:----

<Function names="(closure)" access="private-access" imperative="true">
    <CallExpression>
        <Id name="f"/>
        <Argument>
            <Integer value="1"/>
        </Argument>
    </CallExpression>
</Function>
;====
