                                <Integer value="0"/>
                            </TypeEquality>
                            <Block>
                                <String text="zero"/>
                            </Block>
                        </TypeTransform>
                        <TypeTransform>
                            <Block>
                                <String text="some"/>
                            </Block>
                        </TypeTransform>
                    </TypeOr>
                </StructureMatch>
            </Match>
        </Function>
    </Argument>
</CallExpression>
