:====

foo = bar

:----
%brix
(main
  (= foo bar)
)
:----

<AssignmentExpression op="=">
    <Id name="foo"/>
    <Id name="bar"/>
</AssignmentExpression>
;====
:====

foo =? bar

:----
%brix
(main
  (=? foo bar)
)
:----

<AssignmentExpression op="=">
    <Id name="foo"/>
    <OptionalChain>
        <Id name="bar"/>
    </OptionalChain>
</AssignmentExpression>
;====
:====

a = b = c

:----
%brix
(main
  (= a (= b c))
)
:----

<AssignmentExpression op="=">
    <Id name="a"/>
    <AssignmentExpression op="=">
        <Id name="b"/>
        <Id name="c"/>
    </AssignmentExpression>
</AssignmentExpression>
;====
:====

foo += bar

:----
%brix
(main
  (+= foo bar)
)
:----

<AssignmentExpression op="+=">
    <Id name="foo"/>
    <Id name="bar"/>
</AssignmentExpression>
;====
:====

foo = bar += bar

:----
%brix
(main
  (= foo (+= bar bar))
)
:----

<AssignmentExpression op="=">
    <Id name="foo"/>
    <AssignmentExpression op="+=">
        <Id name="bar"/>
        <Id name="bar"/>
    </AssignmentExpression>
</AssignmentExpression>
;====
:====

foo.bar = baz

:----
%brix
(main
  (= (. foo bar) baz)
)
:----

<AssignmentExpression op="=">
    <Get name="bar">
        <Id name="foo"/>
    </Get>
    <Id name="baz"/>
</AssignmentExpression>
;====
:====

foo.bar.baz = z

:----
%brix
(main
  (= (. foo bar baz) z)
)
:----

<AssignmentExpression op="=">
    <Get name="baz">
        <Get name="bar">
            <Id name="foo"/>
        </Get>
    </Get>
    <Id name="z"/>
</AssignmentExpression>
;====
:====

foo[0] = baz

:----
%brix
(main
  (= ([] foo 0) baz)
)
:----

<AssignmentExpression op="=">
    <Index>
        <Id name="foo"/>
        <Integer value="0"/>
    </Index>
    <Id name="baz"/>
</AssignmentExpression>
;====
:====

foo =
    bar

:----
%brix
(main
  (= foo
    (block
      bar
    )
  )
)
:----

<AssignmentExpression op="=">
    <Id name="foo"/>
    <Block>
        <Id name="bar"/>
    </Block>
</AssignmentExpression>
;====
:====

foo <-* bar

:----
%brix
(main
  (<-* foo bar)
)
:----

<For>
    <In>
        <TypeCapture>
            <Id name="(item)"/>
        </TypeCapture>
        <Id name="bar"/>
    </In>
    <BinaryExpression operator="<-write">
        <Id name="foo"/>
        <Id name="(item)"/>
    </BinaryExpression>
</For>
;====
:====

foo <-* ~ "f" in "ff"

:----
%brix
(main
  (<-* foo (~ "f" (in: "ff")))
)
:----

<For>
    <In>
        <StreamMatch>
            <StreamString text="f"/>
        </StreamMatch>
        <String text="ff"/>
    </In>
    <BinaryExpression operator="<-write">
        <Id name="foo"/>
        <Id name="each"/>
    </BinaryExpression>
</For>
;====
:====

x = foo =
    bar

:----
%brix
(main
  (= x
    (= foo
      (block
        bar
      )
    )
  )
)
:----

<AssignmentExpression op="=">
    <Id name="x"/>
    <AssignmentExpression op="=">
        <Id name="foo"/>
        <Block>
            <Id name="bar"/>
        </Block>
    </AssignmentExpression>
</AssignmentExpression>
;====
:====

x = -- foo

:----

Exception: A print is a step and gives no value; print on a line of its own, or after ":" as a one-step body
<no file:2>
    x = -- foo
          ^
;====
:====

x, y = b

:----
%brix
(main
  (= (tuple x y) b)
)
:----

<AssignmentExpression op="=">
    <Tuple>
        <Id name="x"/>
        <Id name="y"/>
    </Tuple>
    <Id name="b"/>
</AssignmentExpression>
;====
