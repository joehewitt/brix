    <In>
        <TypeCapture>
            <Id name="foo"/>
            <TypePredicate>
                <Id name="foo"/>
            </TypePredicate>
        </TypeCapture>
        <Id name="bar"/>
    </In>
    <Integer value="0"/>
</For>
