====================================================================================================
Types
====================================================================================================
:====

. foo

:----
%brix
(main
  (let foo)
)
:----

<Declaration>
    <TypeCapture>
        <Id name="foo"/>
    </TypeCapture>
</Declaration>
;====
:====

. $foo

:----
%brix
(main
  (let $foo)
)
:----

<Declaration>
    <TypeEquality>
        <Id name="foo"/>
    </TypeEquality>
</Declaration>
;====
:====

. foo Bar

:----
%brix
(main
  (let foo Bar)
)
:----

<Declaration>
    <TypeCapture>
        <Id name="foo"/>
        <TypeId name="Bar"/>
    </TypeCapture>
</Declaration>
;====
:====

. foo Bar?

:----
%brix
(main
  (let foo (? Bar))
)
:----

<Declaration>
    <TypeCapture>
        <Id name="foo"/>
        <TypeArguments>
            <TypeId name="Optional"/>
            <TypeId name="Bar"/>
        </TypeArguments>
    </TypeCapture>
</Declaration>
;====
:====

. Foo'Bar?

:----
%brix
(main
  (let (? (of Foo Bar)))
)
:----

<Declaration>
    <TypeArguments>
        <TypeId name="Optional"/>
        <TypeArguments>
            <TypeId name="Foo"/>
            <TypeId name="Bar"/>
        </TypeArguments>
    </TypeArguments>
</Declaration>
;====
:====

[Foo]

:----
%brix
(main
  (list Foo)
)
:----

<List>
    <TypeId name="Foo"/>
</List>
;====
:====

. [foo, bar]
[foo, bar] = 1

:----
%brix
(main
  (let (list foo bar))
  (= (list foo bar) 1)
)
:----

<Declaration>
    <TypeList>
        <TypeCapture>
            <Id name="foo"/>
        </TypeCapture>
        <TypeCapture>
            <Id name="bar"/>
        </TypeCapture>
    </TypeList>
</Declaration>
<AssignmentExpression op="=">
    <List>
        <Id name="foo"/>
        <Id name="bar"/>
    </List>
    <Integer value="1"/>
</AssignmentExpression>
;====
:====

. [foo, _, ...rest, bar]

:----
%brix
(main
  (let (list foo _ ...rest bar))
)
:----

<Declaration>
    <TypeList>
        <TypeCapture>
            <Id name="foo"/>
        </TypeCapture>
        <TypeWildcard/>
        <TypeRemainder>
            <Id name="rest"/>
        </TypeRemainder>
        <TypeCapture>
            <Id name="bar"/>
        </TypeCapture>
    </TypeList>
</Declaration>
;====
:====

. [foo Foo, bar]
[foo, bar] = 1

:----
%brix
(main
  (let (list (: foo Foo) bar))
  (= (list foo bar) 1)
)
:----

<Declaration>
    <TypeList>
        <TypeCapture>
            <Id name="foo"/>
            <TypeId name="Foo"/>
        </TypeCapture>
        <TypeCapture>
            <Id name="bar"/>
        </TypeCapture>
    </TypeList>
</Declaration>
<AssignmentExpression op="=">
    <List>
        <Id name="foo"/>
        <Id name="bar"/>
    </List>
    <Integer value="1"/>
</AssignmentExpression>
;====
:====

. [Foo = Bar]

:----
%brix
(main
  (let (map Foo Bar))
)
:----

<Declaration>
    <TypeMap>
        <MapItem>
            <TypeId name="Foo"/>
            <TypeId name="Bar"/>
        </MapItem>
    </TypeMap>
</Declaration>
;====
:====

. [foo = bar, baz = boo]
[foo = bar, baz = boo] = 1

:----
%brix
(main
  (let (list (= foo bar) (= baz boo)))
  (= (list (= foo bar) (= baz boo)) 1)
)
:----

<Declaration>
    <TypeMap>
        <MapItem>
            <TypeCapture>
                <Id name="foo"/>
            </TypeCapture>
            <TypeCapture>
                <Id name="bar"/>
            </TypeCapture>
        </MapItem>
        <MapItem>
            <TypeCapture>
                <Id name="baz"/>
            </TypeCapture>
            <TypeCapture>
                <Id name="boo"/>
            </TypeCapture>
        </MapItem>
    </TypeMap>
</Declaration>
<AssignmentExpression op="=">
    <List>
        <AssignmentExpression op="=">
            <Id name="foo"/>
            <Id name="bar"/>
        </AssignmentExpression>
        <AssignmentExpression op="=">
            <Id name="baz"/>
            <Id name="boo"/>
        </AssignmentExpression>
    </List>
    <Integer value="1"/>
</AssignmentExpression>
;====
