. [first, ..., last]

:----
%brix
(main
  (let (list first ... last))
)
:----

<Declaration>
    <TypeList>
        <TypeCapture>
            <Id name="first"/>
        </TypeCapture>
        <TypeRemainder/>
        <TypeCapture>
            <Id name="last"/>
        </TypeCapture>
    </TypeList>
</Declaration>
;====
:====

. ["id" = value, $key = expected, ...rest]

:----
%brix
(main
  (let (list (= "id" value) (= $key expected) ...rest))
)
:----

<Declaration>
    <TypeMap>
        <MapItem>
            <TypeEquality>
                <String text="id"/>
            </TypeEquality>
            <TypeCapture>
                <Id name="value"/>
            </TypeCapture>
        </MapItem>
        <MapItem>
            <TypeEquality>
                <Id name="key"/>
            </TypeEquality>
            <TypeCapture>
                <Id name="expected"/>
            </TypeCapture>
        </MapItem>
        <TypeRemainder>
            <Id name="rest"/>
        </TypeRemainder>
    </TypeMap>
</Declaration>
;====
:====

. ['x' = value]

:----
%brix
(main
  (let (map 'x' value))
)
:----

<Declaration>
    <TypeMap>
        <MapItem>
            <TypeEquality>
                <Integer value="120" unit="(char)"/>
            </TypeEquality>
            <TypeCapture>
                <Id name="value"/>
            </TypeCapture>
        </MapItem>
    </TypeMap>
</Declaration>
;====
:====

. f "foo" ...middle b "bar"

:----
%brix
(main
  (let (all (: f "foo") ...middle (: b "bar")))
)
:----

<Declaration>
    <TypeAnd>
        <TypeAnd>
            <TypeCapture>
                <Id name="f"/>
                <TypeEquality>
                    <String text="foo"/>
                </TypeEquality>
            </TypeCapture>
            <TypeRemainder>
                <Id name="middle"/>
            </TypeRemainder>
        </TypeAnd>
        <TypeCapture>
            <Id name="b"/>
            <TypeEquality>
                <String text="bar"/>
            </TypeEquality>
        </TypeCapture>
    </TypeAnd>
</Declaration>
;====
:====
# Double-underscore is not a pattern.

. [foo, __, bar]

:----
%crash

Exception: Syntax error
<no file:2>
    . [foo, __, bar]
             ^
;====
:====
# Remainders are only legal inside sequence, map, and text pattern profiles.

. ...

:----
%crash

Exception: Remainder pattern is only valid inside sequence, map, or text patterns
<no file:2>
    . ...
      ^^^
;====
:====
# ImmutableArray and map bracket forms cannot be mixed.

. [first, "id" = value]

:----
%crash

Exception: Cannot mix sequence and map items in one bracket pattern
<no file:2>
    . [first, "id" = value]
              ^^^^^^^^^^^^
;====
:====
# Each structure profile can contain at most one remainder.

. [first, ...middle, ..., last]

:----
%crash

Exception: Pattern may contain only one remainder
<no file:2>
    . [first, ...middle, ..., last]
                         ^^^
;====
:====
# Map patterns can contain at most one unmatched-entry remainder.

. ["a" = a, ...rest, ...]

:----
%crash

Exception: Pattern may contain only one remainder
<no file:2>
    . ["a" = a, ...rest, ...]
                         ^^^
;====
:====
# Text patterns can contain at most one substring remainder.

. "a" ...middle "b" ...tail

:----
%crash

Exception: Pattern may contain only one remainder
<no file:2>
    . "a" ...middle "b" ...tail
                        ^^^^^^^
;====
:====
# Double-underscore is not a captured pattern.

. rest __

:----
%crash

Exception: Syntax error
<no file:2>
    . rest __
            ^
;====
