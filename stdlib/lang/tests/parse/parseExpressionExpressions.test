:====

#foo

:----
%brix
(main
  #foo
)
:----

<Id name="foo" tracked="true"/>
;====
:====

object.#foo

:----
%brix
(main
  (. object #foo)
)
:----

<Get name="foo" tracked="true">
    <Id name="object"/>
</Get>
;====
:====

$foo

:----
%brix
(main
  $foo
)
:----

<StyleRead name="foo"/>
;====
:====

object.$foo

:----
%brix
(main
  (. object $foo)
)
:----

<StyleRead name="foo">
    <Id name="object"/>
</StyleRead>
;====
:====

object?.$foo

:----
%brix
(main
  (?. object $foo)
)
:----

<StyleRead name="foo" optional="true">
    <Id name="object"/>
</StyleRead>
;====
:====

##foo

:----
%brix
(main
  (## foo)
)
:----

<Latest>
    <Id name="foo"/>
</Latest>
;====
:====

foo • of ##foo

:----
%brix
(main
  (call foo (:of (## foo)))
)
:----

<CallExpression>
    <Id name="foo"/>
    <Argument name="of">
        <Latest>
            <Id name="foo"/>
        </Latest>
    </Argument>
</CallExpression>
;====
:====

<foo>

:----
%brix
(main
  (stream foo)
)
:----

<Iterable>
    <Id name="foo"/>
</Iterable>
;====
:====

object*.length

:----
%nyi

<For>
    <In>
        <Id name="(*.)"/>
        <Id name="object"/>
    </In>
    <Get name="length">
        <Id name="(*.)"/>
    </Get>
</For>
;====
:====

foo.children*.paint • to canvas

:----
%nyi

<For>
    <In>
        <Id name="(*.)"/>
        <Get name="children">
            <Id name="foo"/>
        </Get>
    </In>
    <CallExpression>
        <Get name="paint">
            <Id name="(*.)"/>
        </Get>
        <Argument name="to">
            <Id name="canvas"/>
        </Argument>
    </CallExpression>
</For>
;====
