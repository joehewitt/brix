:====

. rows =
    ** 1 .. 2
    *>
        List
            ** 1 .. 2
            *> each * 10 + outer
        .. outer = each

:----
%brix
(main
  (let rows
    (block
      (bullet* (.. 1 2))
      (pipe *>
        (block
          (call List
            (block
              (bullet* (.. 1 2))
              (pipe *> (+ (* each 10) outer))
            )
          )
          (lazy outer each)
        )
      )
    )
  )
)
:----

<Declaration>
    <TypeCapture>
        <Id name="rows"/>
    </TypeCapture>
    <Block>
        <Pipeline op="*>">
            <Bullet multi="true">
                <RangeExpression operator="thru">
                    <Integer value="1"/>
                    <Integer value="2"/>
                </RangeExpression>
            </Bullet>
            <Block>
                <CallExpression>
                    <TypeId name="List"/>
                    <Argument>
                        <Block>
                            <Pipeline op="*>">
                                <Bullet multi="true">
                                    <RangeExpression operator="thru">
                                        <Integer value="1"/>
                                        <Integer value="2"/>
                                    </RangeExpression>
                                </Bullet>
                                <BinaryExpression operator="+">
                                    <BinaryExpression operator="*">
                                        <Id name="each"/>
                                        <Integer value="10"/>
                                    </BinaryExpression>
                                    <Id name="outer"/>
                                </BinaryExpression>
                            </Pipeline>
                        </Block>
                    </Argument>
                </CallExpression>
                <Declaration lazy="true">
                    <TypeCapture>
                        <Id name="outer"/>
                    </TypeCapture>
                    <Id name="each"/>
                </Declaration>
            </Block>
        </Pipeline>
    </Block>
</Declaration>
;====
:====

values *|> action(each)

:----
%brix
(main
  (*|> values (call action each))
)
:----

<BinaryExpression operator="*|>">
    <Id name="values"/>
    <CallExpression>
        <Id name="action"/>
        <Argument>
            <Id name="each"/>
        </Argument>
    </CallExpression>
</BinaryExpression>
;====
:====

** values
*|> action(each)

:----
%brix
(main
  (bullet* values)
  (pipe *|> (call action each))
)
:----

<Pipeline op="*|>">
    <Bullet multi="true">
        <Id name="values"/>
    </Bullet>
    <CallExpression>
        <Id name="action"/>
        <Argument>
            <Id name="each"/>
        </Argument>
    </CallExpression>
</Pipeline>
;====
