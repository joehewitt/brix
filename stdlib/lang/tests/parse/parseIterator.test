:====

result2 in (result1 in input)

:----
%brix
(main
  (in result2 (in result1 input))
)
:----

<Iterator>
    <In>
        <Iterator>
            <In>
                <Id name="input"/>
            </In>
            <Id name="result1"/>
        </Iterator>
    </In>
    <Id name="result2"/>
</Iterator>
;====
:====

result in input while a when b

:----
%brix
(main
  (in result input (while a) (when b))
)
:----

<Iterator>
    <In>
        <Id name="input"/>
        <While>
            <Id name="a"/>
            <When>
                <Id name="b"/>
            </When>
        </While>
    </In>
    <Id name="result"/>
</Iterator>
;====
:====

in b
    c

:----
%brix
(main
  (iterate (in b)
    (block
      c
    )
  )
)
:----

<Iterator>
    <In>
        <Id name="b"/>
    </In>
    <Id name="c"/>
</Iterator>
;====
:====

in b
and c
    d

:----
%brix
(main
  (iterate (in b) (and-for (each c))
    (block
      d
    )
  )
)
:----

<Iterator>
    <In>
        <Id name="b"/>
        <In>
            <TypeCapture>
                <Id name="c"/>
            </TypeCapture>
        </In>
    </In>
    <Id name="d"/>
</Iterator>
;====
:====

in b when d
    c

:----
%brix
(main
  (iterate (in b (when d))
    (block
      c
    )
  )
)
:----

<Iterator>
    <In>
        <Id name="b"/>
        <When>
            <Id name="d"/>
        </When>
    </In>
    <Id name="c"/>
</Iterator>
;====
:====

in b when a
    c
or in g
    f

:----
%brix
(main
  (iterate (in b (when a))
    (block
      c
    )
    (or-for (in g)
      f
    )
  )
)
:----

<Iterator>
    <In>
        <Id name="b"/>
        <When>
            <Id name="a"/>
        </When>
    </In>
    <Id name="c"/>
    <Iterator>
        <In>
            <Id name="g"/>
        </In>
        <Block>
            <Id name="f"/>
        </Block>
    </Iterator>
</Iterator>
;====
====================================================================================================
each autoclosure
====================================================================================================
:====

each in foo

:----
%brix
(main
  (in each foo)
)
:----

<Iterator>
    <In>
        <Id name="foo"/>
    </In>
    <Id name="each"/>
</Iterator>
;====
:====

result *> binding in input

:----
%brix
(main
  (in (*> result binding) input)
)
:----

<Iterator>
    <In>
        <TypeCapture>
            <Id name="binding"/>
        </TypeCapture>
        <Id name="input"/>
    </In>
    <Id name="result"/>
</Iterator>
;====
:====

each in foo when each

:----
%brix
(main
  (in each foo (when each))
)
:----

<Iterator>
    <In>
        <Id name="foo"/>
        <When>
            <Id name="each"/>
        </When>
    </In>
    <Id name="each"/>
</Iterator>
;====
:====

a = each in foo

:----
%brix
(main
  (= a (in each foo))
)
:----

<AssignmentExpression op="=">
    <Id name="a"/>
    <Iterator>
        <In>
            <Id name="foo"/>
        </In>
        <Id name="each"/>
    </Iterator>
</AssignmentExpression>
;====
:====

foo • of each in foo

:----
%brix
(main
  (call foo (:of (in each foo)))
)
:----

<CallExpression>
    <Id name="foo"/>
    <Argument name="of">
        <Iterator>
            <In>
                <Id name="foo"/>
            </In>
            <Id name="each"/>
        </Iterator>
    </Argument>
</CallExpression>
;====
:====

foo • of each in foo when bar

:----
%brix
(main
  (call foo (:of (in each foo (when bar))))
)
:----

<CallExpression>
    <Id name="foo"/>
    <Argument name="of">
        <Iterator>
            <In>
                <Id name="foo"/>
                <When>
                    <Id name="bar"/>
                </When>
            </In>
            <Id name="each"/>
        </Iterator>
    </Argument>
</CallExpression>
;====
:====

<* binding in input when clause
    result

:----
%brix
(main
  (case-each (in binding input (when clause))
    result
  )
)
:----

<Iterator>
    <In>
        <StructureMatch>
            <TypeCapture>
                <Id name="binding"/>
            </TypeCapture>
        </StructureMatch>
        <Id name="input"/>
        <When>
            <Id name="clause"/>
        </When>
    </In>
    <Id name="result"/>
</Iterator>
;====
