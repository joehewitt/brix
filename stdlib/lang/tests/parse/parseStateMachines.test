:====
# Parses local immediate declaration-bound state machines.

━━━━━━━━━━━━━━━━━━━━
+ do build

. flow ~>
    ~> idle
    ~> ready if true

:----
%brix
(fn-do + build _
  (let flow
    (machine
      (state idle)
      (state ready (trigger if true))
    )
  )
)
:----
<Function names="build" access="public-access" imperative="true">
    <Block>
        <Declaration>
            <TypeCapture>
                <Id name="flow"/>
            </TypeCapture>
            <StateMachine>
                <StateCase name="idle"/>
                <StateCase name="ready">
                    <StateTrigger kind="if">
                        <Id name="true"/>
                    </StateTrigger>
                </StateCase>
            </StateMachine>
        </Declaration>
    </Block>
</Function>
;====
:====
# Parses local lazy declaration-bound state machines.

━━━━━━━━━━━━━━━━━━━━
+ build

.. flow ~>
    ~> idle
    ~> ready if enabled

:----
%brix
(fn-expr + build _
  (lazy flow
    (machine
      (state idle)
      (state ready (trigger if enabled))
    )
  )
)
:----
<Function names="build" access="public-access">
    <Block>
        <Declaration lazy="true">
            <TypeCapture>
                <Id name="flow"/>
            </TypeCapture>
            <StateMachine>
                <StateCase name="idle"/>
                <StateCase name="ready">
                    <StateTrigger kind="if">
                        <Id name="enabled"/>
                    </StateTrigger>
                </StateCase>
            </StateMachine>
        </Declaration>
    </Block>
</Function>
;====
:====
# Parses anonymous state machines in class content sections.

━━━━━━━━━━━━━━━━━━━━
+ Panel

────────────────────
~> idle
~> active on activate

:----
%brix
(type + Panel
  (content
    (state idle)
    (state active (trigger on activate))
  )
)
:----
<Class name="Panel" access="public-access">
    <Content>
        <Block>
            <StateMachine>
                <StateCase name="idle"/>
                <StateCase name="active">
                    <StateTrigger kind="on">
                        <Id name="activate"/>
                    </StateTrigger>
                </StateCase>
            </StateMachine>
        </Block>
    </Content>
</Class>
;====
:====
# Parses nested named state machines inside class-owned state cases.

━━━━━━━━━━━━━━━━━━━━
+ Session

────────────────────
+ app ~>

~> closed
~> ready
    + auth ~>
        ~> editing
        ~> authenticated on login

:----
%brix
(type + Session
  (prop + app _
    (machine
      (state closed)
      (state ready
        (prop + auth _
          (machine
            (state editing)
            (state authenticated (trigger on login))
          )
        )
      )
    )
  )
)
:----
<Class name="Session" access="public-access">
    <Property access="public-access">
        <TypeCapture>
            <Id name="app"/>
        </TypeCapture>
        <StateMachine>
            <StateCase name="closed"/>
            <StateCase name="ready">
                <Property access="public-access">
                    <TypeCapture>
                        <Id name="auth"/>
                    </TypeCapture>
                    <StateMachine>
                        <StateCase name="editing"/>
                        <StateCase name="authenticated">
                            <StateTrigger kind="on">
                                <Id name="login"/>
                            </StateTrigger>
                        </StateCase>
                    </StateMachine>
                </Property>
            </StateCase>
        </StateMachine>
    </Property>
</Class>
;====
:====
# Parses a state machine written as a section of a class as a property of the class.

━━━━━━━━━━━━━━━━━━━━
+ Panel

────────────────────
+ phase ~>

~> idle
~> active on go

:----
%brix
(type + Panel
  (prop + phase _
    (machine
      (state idle)
      (state active (trigger on go))
    )
  )
)
:----
<Class name="Panel" access="public-access">
    <Property access="public-access">
        <TypeCapture>
            <Id name="phase"/>
        </TypeCapture>
        <StateMachine>
            <StateCase name="idle"/>
            <StateCase name="active">
                <StateTrigger kind="on">
                    <Id name="go"/>
                </StateTrigger>
            </StateCase>
        </StateMachine>
    </Property>
</Class>
;====
