:====

foo?.bar

:----
%brix
(main
  (?. foo bar)
)
:----

<Get name="bar" optional="true">
    <Id name="foo"/>
</Get>
;====
:====

foo.bar?.baz

:----
%brix
(main
  (?. (. foo bar) baz)
)
:----

<Get name="baz" optional="true">
    <Get name="bar">
        <Id name="foo"/>
    </Get>
</Get>
;====
:====

foo[0]?.baz

:----
%brix
(main
  (?. ([] foo 0) baz)
)
:----

<Get name="baz" optional="true">
    <Index>
        <Id name="foo"/>
        <Integer value="0"/>
    </Index>
</Get>
;====
:====

foo?.bar[0]

:----
%brix
(main
  ([] (?. foo bar) 0)
)
:----

<Index>
    <Get name="bar" optional="true">
        <Id name="foo"/>
    </Get>
    <Integer value="0"/>
</Index>
;====
:====

foo()?.bar

:----
%brix
(main
  (?. (call foo) bar)
)
:----

<Get name="bar" optional="true">
    <CallExpression>
        <Id name="foo"/>
    </CallExpression>
</Get>
;====
:====

foo?.bar()?.baz

:----
%brix
(main
  (?. (call (?. foo bar)) baz)
)
:----

<Get name="baz" optional="true">
    <CallExpression>
        <Get name="bar" optional="true">
            <Id name="foo"/>
        </Get>
    </CallExpression>
</Get>
;====
:====

foo =? bar
foo +=? bar
=? foo
<=? foo
use? foo
--? foo

:----
%brix
(main
  (=? foo bar)
  (+=? foo bar)
  (return? foo)
  (yield? foo)
  (use? foo)
  (print? foo)
)
:----

<AssignmentExpression op="=">
    <Id name="foo"/>
    <OptionalChain>
        <Id name="bar"/>
    </OptionalChain>
</AssignmentExpression>
<AssignmentExpression op="+=">
    <Id name="foo"/>
    <OptionalChain>
        <Id name="bar"/>
    </OptionalChain>
</AssignmentExpression>
<Return>
    <OptionalChain>
        <Id name="foo"/>
    </OptionalChain>
</Return>
<Yield>
    <OptionalChain>
        <Id name="foo"/>
    </OptionalChain>
</Yield>
<Use>
    <OptionalChain>
        <Id name="foo"/>
    </OptionalChain>
</Use>
<Print>
    <OptionalChain>
        <Id name="foo"/>
    </OptionalChain>
</Print>

;====
:====

=? if !foo
= !foo

:----
%brix
(main
  (return-if (if (not foo)))
  (return (not foo))
)
:----

<ReturnIfTrue>
    <UnaryExpression operator="!">
        <Id name="foo"/>
    </UnaryExpression>
</ReturnIfTrue>
<Return>
    <UnaryExpression operator="!">
        <Id name="foo"/>
    </UnaryExpression>
</Return>
;====
:====

=? true
    if foo

:----
%brix
(main
  (return-if true (if foo))
)
:----

<ReturnIfTrue>
    <Id name="true"/>
    <Id name="foo"/>
</ReturnIfTrue>
;====
:====

=? if foo

:----
%brix
(main
  (return-if (if foo))
)
:----

<ReturnIfTrue>
    <Id name="foo"/>
</ReturnIfTrue>
;====
:====

=?
    if foo

:----
%brix
(main
  (return-if (if foo))
)
:----

<ReturnIfTrue>
    <Id name="foo"/>
</ReturnIfTrue>
;====
:====

*? foo

:----
%brix
(main
  (bullet? foo)
)
:----

<Bullet optional="true">
    <Id name="foo"/>
</Bullet>
;====
:====

foo.bar!.baz

:----
%brix
(main
  (. (!! (. foo bar)) baz)
)
:----

<Get name="baz">
    <UnaryExpression operator="!">
        <Get name="bar">
            <Id name="foo"/>
        </Get>
    </UnaryExpression>
</Get>
;====
:====

foo()!.bar

:----
%brix
(main
  (. (!! (call foo)) bar)
)
:----

<Get name="bar">
    <UnaryExpression operator="!">
        <CallExpression>
            <Id name="foo"/>
        </CallExpression>
    </UnaryExpression>
</Get>
;====
:====

foo[0]!.bar

:----
%brix
(main
  (. (!! ([] foo 0)) bar)
)
:----

<Get name="bar">
    <UnaryExpression operator="!">
        <Index>
            <Id name="foo"/>
            <Integer value="0"/>
        </Index>
    </UnaryExpression>
</Get>
;====
:====

foo.bar![0]

:----
%brix
(main
  ([] (!! (. foo bar)) 0)
)
:----

<Index>
    <UnaryExpression operator="!">
        <Get name="bar">
            <Id name="foo"/>
        </Get>
    </UnaryExpression>
    <Integer value="0"/>
</Index>
;====
:====

foo.bar()!.baz!.qux

:----
%brix
(main
  (. (!! (. (!! (call (. foo bar))) baz)) qux)
)
:----

<Get name="qux">
    <UnaryExpression operator="!">
        <Get name="baz">
            <UnaryExpression operator="!">
                <CallExpression>
                    <Get name="bar">
                        <Id name="foo"/>
                    </Get>
                </CallExpression>
            </UnaryExpression>
        </Get>
    </UnaryExpression>
</Get>
;====
:====

foo.bar!
foo.bar != baz

:----
%brix
(main
  (!! (. foo bar))
  (!= (. foo bar) baz)
)
:----

<UnaryExpression operator="!">
    <Get name="bar">
        <Id name="foo"/>
    </Get>
</UnaryExpression>
<BinaryExpression operator="!=">
    <Get name="bar">
        <Id name="foo"/>
    </Get>
    <Id name="baz"/>
</BinaryExpression>
;====
:====
