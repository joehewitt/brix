:================================================================================================

// foo ${bar} baz
// foo $bar baz
// foo $bar.baz
// foo $bar?.baz
// foo $bar

:------------------------------------------------------------------------------------------------
%brix
(main
  (probe-log _ (text: "foo " bar " baz"))
  (probe-log _ (text: "foo " bar " baz"))
  (probe-log _ (text: "foo " (. bar baz)))
  (probe-log _ (text: "foo " (?. bar baz)))
  (probe-log _ (text: "foo " bar))
)
:----

<Probe>
    <String text="foo "/>
    <Id name="bar"/>
    <String text=" baz"/>
</Probe>
<Probe>
    <String text="foo "/>
    <Id name="bar"/>
    <String text=" baz"/>
</Probe>
<Probe>
    <String text="foo "/>
    <Get name="baz">
        <Id name="bar"/>
    </Get>
</Probe>
<Probe>
    <String text="foo "/>
    <Get name="baz" optional="true">
        <Id name="bar"/>
    </Get>
</Probe>
<Probe>
    <String text="foo "/>
    <Id name="bar"/>
</Probe>
;====
:================================================================================================

// dispatch $shown returns ${type-text(store, index, result)}

:------------------------------------------------------------------------------------------------
%brix
(main
  (probe-log _ (text: "dispatch " shown " returns " (call type-text store index result)))
)
:----

<Probe>
    <String text="dispatch "/>
    <Id name="shown"/>
    <String text=" returns "/>
    <CallExpression>
        <Id name="type-text"/>
        <Argument>
            <Id name="store"/>
        </Argument>
        <Argument>
            <Id name="index"/>
        </Argument>
        <Argument>
            <Id name="result"/>
        </Argument>
    </CallExpression>
</Probe>
;====
:================================================================================================

━━━━━━━━━━━━━━━━━━━━
_ do trace-call TypeId

if result
    // dispatch $shown returns ${type-text(store, index, result)}

= result

:------------------------------------------------------------------------------------------------
%brix
(fn-do _ trace-call TypeId
  (if result
    (probe-log _ (text: "dispatch " shown " returns " (call type-text store index result)))
  )
  (blank)
  (return result)
)
:----

<Function names="trace-call" access="private-access" imperative="true">
    <TypeId name="TypeId"/>
    <Block>
        <If>
            <TypePredicate>
                <Id name="result"/>
            </TypePredicate>
            <Block>
                <Probe>
                    <String text="dispatch "/>
                    <Id name="shown"/>
                    <String text=" returns "/>
                    <CallExpression>
                        <Id name="type-text"/>
                        <Argument>
                            <Id name="store"/>
                        </Argument>
                        <Argument>
                            <Id name="index"/>
                        </Argument>
                        <Argument>
                            <Id name="result"/>
                        </Argument>
                    </CallExpression>
                </Probe>
            </Block>
        </If>
        <Return>
            <Id name="result"/>
        </Return>
    </Block>
</Function>
;====
