  (probe-log _ (text: "foo " (preview bar) " baz"))
  (probe-log _ (text: "foo " (preview (. bar baz))))
  (probe-log _ (text: "foo " (preview (?. bar baz))))
  (probe-log _ (text: "foo " (preview (. bar baz)) " baz"))
)
