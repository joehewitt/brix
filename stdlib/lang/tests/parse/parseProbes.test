<Probe>
    <String text="foo "/>
    <ProbePreview>
        <Id name="bar"/>
    </ProbePreview>
    <String text=" baz"/>
</Probe>
<Probe>
    <String text="foo "/>
    <ProbePreview>
        <Get name="baz">
            <Id name="bar"/>
        </Get>
    </ProbePreview>
</Probe>
<Probe>
    <String text="foo "/>
    <ProbePreview>
        <Get name="baz" optional="true">
            <Id name="bar"/>
        </Get>
    </ProbePreview>
</Probe>
<Probe>
    <String text="foo "/>
    <ProbePreview>
        <Get name="baz">
            <Id name="bar"/>
        </Get>
    </ProbePreview>
    <String text=" baz"/>
</Probe>

