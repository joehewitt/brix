//http.response.headers -> response-headers
    .. response-headers = "ok"
        .. suffix = "!"

:------------------------------------------------------------------------------------------------
%brix
(main
  (probe-log http.response.headers (items: response-headers)
    (block
      (lazy response-headers
        (scope "ok"
          (lazy suffix "!")
        )
      )
    )
  )
)
:----

<Block>
    <Probe key="http.response.headers">
        <Id name="response-headers"/>
    </Probe>
    <Declaration lazy="true">
        <TypeCapture>
            <Id name="response-headers"/>
        </TypeCapture>
        <Block>
            <Declaration lazy="true">
                <TypeCapture>
                    <Id name="suffix"/>
                </TypeCapture>
                <String text="!"/>
            </Declaration>
            <Declaration lazy="true">
                <TypeCapture>
                    <Id name="it"/>
                </TypeCapture>
                <String text="ok"/>
            </Declaration>
            <Id name="it"/>
        </Block>
    </Declaration>
</Block>

;====
:================================================================================================

