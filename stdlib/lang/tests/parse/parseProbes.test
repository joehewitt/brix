<Block>
    <Probe object="channel" key="write">
        <Id name="detail"/>
        <Id name="task"/>
    </Probe>
    <Declaration lazy="true">
        <TypeCapture>
            <Id name="detail"/>
        </TypeCapture>
        <String text="ok"/>
    </Declaration>
</Block>

