    text = "Fallback"
    <TextBox = "Body"
+ <MarkNode

:----
%brix
(type + Panel
  (content
    (+<> TextBox (id: header) (• selected)
      (= text "Fallback")
      (<> TextBox (value: "Body"))
    )
    (+<> MarkNode)
  )
)
:----

<Class name="Panel" access="public-access">
    <Content>
        <Block>
            <SlotOutlet>
                <Id name="header"/>
                <TypeId name="TextBox"/>
                <StyleRuleApplications>
                    <StyleRuleApplication name="selected"/>
                </StyleRuleApplications>
                <Block>
                    <AssignmentExpression op="=">
                        <Id name="text"/>
                        <String text="Fallback"/>
                    </AssignmentExpression>
                    <Markup>
                        <TypeId name="TextBox"/>
                        <args>
                            <String text="Body"/>
                        </args>
                    </Markup>
                </Block>
            </SlotOutlet>
            <SlotOutlet>
                <TypeId name="MarkNode"/>
            </SlotOutlet>
        </Block>
    </Content>
</Class>
;====
