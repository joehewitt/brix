+ <Box row - item RowData

━━━━━━━━━━━━━━━━━━━━

<Panel
    <TextBox (row) - item = item.text

:----
%brix
(type + Panel
  (content
    (+<> Box (id: row) (param: item RowData))
  )
)

(main
  (<> Panel
    (<> TextBox (slot: row) (param: item) (value: (. item text)))
  )
)
:----

<Class name="Panel" access="public-access">
    <Content>
        <Block>
            <SlotOutlet>
                <Id name="row"/>
                <TypeId name="Box"/>
                <SlotParameter>
                    <Id name="item"/>
                    <TypeId name="RowData"/>
                </SlotParameter>
            </SlotOutlet>
        </Block>
    </Content>
</Class>
<Markup>
    <TypeId name="Panel"/>
    <Block>
        <Markup>
            <TypeId name="TextBox"/>
            <SlotBinding>
                <Id name="row"/>
                <SlotParameter>
                    <Id name="item"/>
                </SlotParameter>
            </SlotBinding>
            <args>
                <Get name="text">
                    <Id name="item"/>
                </Get>
            </args>
        </Markup>
    </Block>
</Markup>
