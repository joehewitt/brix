/core/arena
/lang/backend/aarch64-encoder
/lang/backend/mir
/test

tests()

━━━━━━━━━━━━━━━━━━━━
+ do tests TestRender

. cases = TestCase("Backend Sorting")
cases.run(sorting-tests)
cases = cases.then("Backend Logical Immediates", logical-immediate-tests)
cases = cases.then("Backend Move Wide Immediates", move-wide-tests)
= cases

━━━━━━━━━━━━━━━━━━━━
_ do sorting-tests TestCase
    - t TestCase

. arena = use Arena()
. small = arena.allocate'U64(5)
small[0] = 9
small[1] = 3
small[2] = 7
small[3] = 3
small[4] = 0
sort-u64(arena, small, 5)
t.expect("small order", "0 3 3 7 9", "${small[0]} ${small[1]} ${small[2]} ${small[3]} ${small[4]}")

. ids = new-id-list(arena, 40)
. keys = arena.allocate'U32(40)
for index in 0 .. < 40
    ids = ids.appended(arena, (100 + index) as U32)
    keys[index] = ((39 - index) / 10) as U32
. sorted = stable-order(arena, ids, keys)
t.expect("the smallest key first", 130, sorted[0])
t.expect("ties keep their order", 139, sorted[9])
t.expect("the next key", 120, sorted[10])
t.expect("the largest key last", 109, sorted[39])
t.expect("length", 40, sorted.length)
. single = stable-order(arena, IdList(ids.data, 1, 1), keys)
t.expect("one id", 100, single[0])
= t

━━━━━━━━━━━━━━━━━━━━
_ do logical-immediate-tests TestCase
    - t TestCase

. alternating = encode-logical-immediate(0x5555555555555555, 64)
t.check("alternating bits", alternating.is-encodable)
t.expect("alternating n", 0, alternating.n)
t.expect("alternating immr", 0, alternating.immr)
t.expect("alternating imms", 0x3c, alternating.imms)
. byte = encode-logical-immediate(0xff, 64)
t.expect("byte n", 1, byte.n)
t.expect("byte immr", 0, byte.immr)
t.expect("byte imms", 7, byte.imms)
. narrow-byte = encode-logical-immediate(0xff, 32)
t.expect("32-bit byte n", 0, narrow-byte.n)
t.expect("32-bit byte imms", 7, narrow-byte.imms)
. high = encode-logical-immediate(0xffffffff000000ff, 32)
t.check("a 32-bit value ignores the high half", high.is-encodable)
t.expect("high half imms", 7, high.imms)

t.check("zero", !encode-logical-immediate(0, 64).is-encodable)
t.check("all ones", !encode-logical-immediate(U64.max, 64).is-encodable)
t.check("32-bit all ones", !encode-logical-immediate(0xffffffff, 32).is-encodable)
t.check("two runs", !encode-logical-immediate(0x1234, 64).is-encodable)

. patterns = 0
. round-trips = 0
for bits in [32u32, 64u32]
    . size U32 = 2
    while size <= bits
        for ones in 1 .. < size
            for rotation in 0 .. < size
                . value = repeated(rotated(run-of-ones(ones), rotation, size), size, bits)
                . encoded = encode-logical-immediate(value, bits)
                patterns += 1
                if encoded.is-encodable && decoded(encoded, bits) == value
                    round-trips += 1
        size *= 2
t.expect("patterns", 6636, patterns)
t.expect("every pattern encodes to itself", patterns, round-trips)
= t

━━━━━━━━━━━━━━━━━━━━
_ do move-wide-tests TestCase
    - t TestCase

. zero = encode-move-wide-immediate(0, 64)
t.check("zero", zero.is-encodable && !zero.is-negated)
t.expect("zero imm", 0, zero.imm16)
. shifted = encode-move-wide-immediate(0xffff0000, 32)
t.check("shifted", shifted.is-encodable && !shifted.is-negated)
t.expect("shifted halfword", 1, shifted.halfword)
t.expect("shifted imm", 0xffff, shifted.imm16)
. top = encode-move-wide-immediate(0x1234000000000000, 64)
t.expect("top halfword", 3, top.halfword)
t.expect("top imm", 0x1234, top.imm16)
. minus-one = encode-move-wide-immediate(U64.max, 64)
t.check("minus one is negated", minus-one.is-encodable && minus-one.is-negated)
t.expect("minus one imm", 0, minus-one.imm16)
. narrow-minus-one = encode-move-wide-immediate(0xffffffff, 32)
t.check("32-bit minus one is negated", narrow-minus-one.is-negated)
t.expect("32-bit minus one imm", 0, narrow-minus-one.imm16)
. negated = encode-move-wide-immediate(0xffffffffedcbffff, 64)
t.check("negated", negated.is-encodable && negated.is-negated)
t.expect("negated halfword", 1, negated.halfword)
t.expect("negated imm", 0x1234, negated.imm16)
t.check("two halfwords", !encode-move-wide-immediate(0x12340000ffff, 64).is-encodable)
t.check("32-bit two halfwords", !encode-move-wide-immediate(0x00010001, 32).is-encodable)
= t

━━━━━━━━━━━━━━━━━━━━
_ run-of-ones U64
    - count U32

if count >= 64 then U64.max else (1u64 /lshift/ count) - 1

━━━━━━━━━━━━━━━━━━━━
_ rotated U64
    - value U64
    - amount U32
    - size U32

|? shift == 0
    value /and/ mask
??
    ((value /zrshift/ shift) /or/ (value /lshift/ (size - shift))) /and/ mask

.. mask = run-of-ones(size)
.. shift = amount % size

━━━━━━━━━━━━━━━━━━━━
_ do repeated U64
    - element U64
    - size U32
    - bits U32

. value U64
. offset U32
while offset < bits
    value = value /or/ (element /lshift/ offset)
    offset += size
= value

━━━━━━━━━━━━━━━━━━━━
_ do decoded U64
    - encoded LogicalImmediate
    - bits U32

. combined = (encoded.n /lshift/ 6) /or/ ((encoded.imms /xor/ 0x3f) /and/ 0x3f)
. size U32 = 64
while size > 1 && (combined /and/ size) == 0
    size /= 2
. levels = size - 1
. ones = (encoded.imms /and/ levels) + 1
= repeated(rotated(run-of-ones(ones), encoded.immr /and/ levels, size), size, bits)
