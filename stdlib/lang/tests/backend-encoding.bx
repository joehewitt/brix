(import /core/arena)
(import /lang/backend/aarch64-encoder)
(import /lang/backend/mir)
(import /test)
(blank)

(main
  (call tests)
)

(fn-do + tests TestRender
  (let cases (call TestCase "Backend Sorting"))
  (call (. cases run) sorting-tests)
  (= cases (call (. cases then) "Backend Logical Immediates" logical-immediate-tests))
  (= cases (call (. cases then) "Backend Move Wide Immediates" move-wide-tests))
  (return cases)
)

(fn-do _ sorting-tests TestCase
  (param t TestCase)
  (let arena (use (call Arena)))
  (let small (call (of (. arena allocate) U64) 5))
  (= ([] small 0) 9)
  (= ([] small 1) 3)
  (= ([] small 2) 7)
  (= ([] small 3) 3)
  (= ([] small 4) 0)
  (call sort-u64 arena small 5)
  (call (. t expect) "small order" "0 3 3 7 9" (str ([] small 0) " " ([] small 1) " " ([] small 2) " " ([] small 3) " " ([] small 4)))
  (blank)
  (let ids (call new-id-list arena 40))
  (let keys (call (of (. arena allocate) U32) 40))
  (for (in index (..< 0 40))
    (= ids (call (. ids appended) arena (as (+ 100 index) U32)))
    (= ([] keys index) (as (/ (- 39 index) 10) U32))
  )
  (let sorted (call stable-order arena ids keys))
  (call (. t expect) "the smallest key first" 130 ([] sorted 0))
  (call (. t expect) "ties keep their order" 139 ([] sorted 9))
  (call (. t expect) "the next key" 120 ([] sorted 10))
  (call (. t expect) "the largest key last" 109 ([] sorted 39))
  (call (. t expect) "length" 40 (. sorted length))
  (let single (call stable-order arena (call IdList (. ids data) 1 1) keys))
  (call (. t expect) "one id" 100 ([] single 0))
  (return t)
)

(fn-do _ logical-immediate-tests TestCase
  (param t TestCase)
  (let alternating (call encode-logical-immediate 0x5555555555555555 64))
  (call (. t check) "alternating bits" (. alternating is-encodable))
  (call (. t expect) "alternating n" 0 (. alternating n))
  (call (. t expect) "alternating immr" 0 (. alternating immr))
  (call (. t expect) "alternating imms" 0x3c (. alternating imms))
  (let byte (call encode-logical-immediate 0xff 64))
  (call (. t expect) "byte n" 1 (. byte n))
  (call (. t expect) "byte immr" 0 (. byte immr))
  (call (. t expect) "byte imms" 7 (. byte imms))
  (let narrow-byte (call encode-logical-immediate 0xff 32))
  (call (. t expect) "32-bit byte n" 0 (. narrow-byte n))
  (call (. t expect) "32-bit byte imms" 7 (. narrow-byte imms))
  (let high (call encode-logical-immediate 0xffffffff000000ff 32))
  (call (. t check) "a 32-bit value ignores the high half" (. high is-encodable))
  (call (. t expect) "high half imms" 7 (. high imms))
  (blank)
  (call (. t check) "zero" (not (. (call encode-logical-immediate 0 64) is-encodable)))
  (call (. t check) "all ones" (not (. (call encode-logical-immediate (. U64 max) 64) is-encodable)))
  (call (. t check) "32-bit all ones" (not (. (call encode-logical-immediate 0xffffffff 32) is-encodable)))
  (call (. t check) "two runs" (not (. (call encode-logical-immediate 0x1234 64) is-encodable)))
  (blank)
  (let patterns 0)
  (let round-trips 0)
  (for (in bits (list 32u32 64u32))
    (let size U32 2)
    (while (<= size bits)
      (for (in ones (..< 1 size))
        (for (in rotation (..< 0 size))
          (let value (call repeated (call rotated (call run-of-ones ones) rotation size) size bits))
          (let encoded (call encode-logical-immediate value bits))
          (+= patterns 1)
          (if (and (. encoded is-encodable) (== (call decoded encoded bits) value))
            (+= round-trips 1)
          )
        )
      )
      (*= size 2)
    )
  )
  (call (. t expect) "patterns" 6636 patterns)
  (call (. t expect) "every pattern encodes to itself" patterns round-trips)
  (return t)
)

(fn-do _ move-wide-tests TestCase
  (param t TestCase)
  (let zero (call encode-move-wide-immediate 0 64))
  (call (. t check) "zero" (and (. zero is-encodable) (not (. zero is-negated))))
  (call (. t expect) "zero imm" 0 (. zero imm16))
  (let shifted (call encode-move-wide-immediate 0xffff0000 32))
  (call (. t check) "shifted" (and (. shifted is-encodable) (not (. shifted is-negated))))
  (call (. t expect) "shifted halfword" 1 (. shifted halfword))
  (call (. t expect) "shifted imm" 0xffff (. shifted imm16))
  (let top (call encode-move-wide-immediate 0x1234000000000000 64))
  (call (. t expect) "top halfword" 3 (. top halfword))
  (call (. t expect) "top imm" 0x1234 (. top imm16))
  (let minus-one (call encode-move-wide-immediate (. U64 max) 64))
  (call (. t check) "minus one is negated" (and (. minus-one is-encodable) (. minus-one is-negated)))
  (call (. t expect) "minus one imm" 0 (. minus-one imm16))
  (let narrow-minus-one (call encode-move-wide-immediate 0xffffffff 32))
  (call (. t check) "32-bit minus one is negated" (. narrow-minus-one is-negated))
  (call (. t expect) "32-bit minus one imm" 0 (. narrow-minus-one imm16))
  (let negated (call encode-move-wide-immediate 0xffffffffedcbffff 64))
  (call (. t check) "negated" (and (. negated is-encodable) (. negated is-negated)))
  (call (. t expect) "negated halfword" 1 (. negated halfword))
  (call (. t expect) "negated imm" 0x1234 (. negated imm16))
  (call (. t check) "two halfwords" (not (. (call encode-move-wide-immediate 0x12340000ffff 64) is-encodable)))
  (call (. t check) "32-bit two halfwords" (not (. (call encode-move-wide-immediate 0x00010001 32) is-encodable)))
  (return t)
)

(fn-expr _ run-of-ones U64
  (param count U32)
  (if-expr (>= count 64) (. U64 max) (- (/lshift/ 1u64 count) 1))
)

(fn-expr _ rotated U64
  (param value U64)
  (param amount U32)
  (param size U32)
  (case? (== shift 0)
    (/and/ value mask)
  )
  (default
    (/and/ (/or/ (/zrshift/ value shift) (/lshift/ value (- size shift))) mask)
  )
  (where
    (lazy mask (call run-of-ones size))
    (lazy shift (% amount size))
  )
)

(fn-do _ repeated U64
  (param element U64)
  (param size U32)
  (param bits U32)
  (let value U64)
  (let offset U32)
  (while (< offset bits)
    (= value (/or/ value (/lshift/ element offset)))
    (+= offset size)
  )
  (return value)
)

(fn-do _ decoded U64
  (param encoded LogicalImmediate)
  (param bits U32)
  (let combined (/or/ (/lshift/ (. encoded n) 6) (/and/ (/xor/ (. encoded imms) 0x3f) 0x3f)))
  (let size U32 64)
  (while (and (> size 1) (== (/and/ combined size) 0))
    (/= size 2)
  )
  (let levels (- size 1))
  (let ones (+ (/and/ (. encoded imms) levels) 1))
  (return (call repeated (call rotated (call run-of-ones ones) (/and/ (. encoded immr) levels) size) size bits))
)
