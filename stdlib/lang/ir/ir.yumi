| operand-void = 0
| operand-value = 1
| operand-number = 2
| operand-constant = 4
| operand-symbol = 5
| operand-argument = 6
| operand-environment = 7
| operand-panic-signal = 8
| operand-block = 9
| operand-result = 10
| operand-descriptor = 11
| operand-buffer-descriptor = 12

