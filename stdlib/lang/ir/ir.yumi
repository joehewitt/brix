+ ValueId is U32
+ IRBlockId is U32
+ ConstantId is U32
+ LocalId is U32
+ Operand is U32

+ no-block IRBlockId = U32.max

_ operand-kind-shift U32 = 28
_ operand-payload-mask U32 = 0x0fffffff

+ may-panic-dependency U32 = 1
+ generator-dependency U32 = 2

+ callee-kind-mask U32 = 0xff
+ checked-call-flag U32 = 0x100
+ stack-map-call-flag U32 = 0x200
+ managed-store-flag U32 = 0x80000000

