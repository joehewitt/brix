| op-negate = 17
| op-bitwise-not = 18
| op-compare = 19
| op-load-local = 20
| op-store-local = 21
| op-count-leading-zeros = 22
| op-local-address = 23
| op-load-task-word = 24
| op-float-math = 25
| op-switch = 26
| op-yield = 27
| op-inlined-name = 28
| op-load-acquire = 29
| op-store-release = 30

