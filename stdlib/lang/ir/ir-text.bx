(import ./ir)
(import /core/table)
(import /lang/backend/bundle)
(import /lang/backend/mir)
(import /lang/backend/mir-text)
(import /lang/emit/layouts)
(import /lang/emit/program-tables)
(import /lang/emit/runtime)
(blank)
(prop _ op-names (list String)
  (=
    (call List
      (block
        (item "call-void")
        (item "return")
        (item "call")
        (item "jump")
        (item "branch")
        (item "phi")
        (item "arithmetic")
        (item "bitwise")
        (item "num-cast")
        (item "load")
        (item "store")
        (item "address")
        (item "frame")
        (item "copy")
        (item "zero")
        (item "load-task-panic")
        (item "load-panic-signal")
        (item "negate")
        (item "bitwise-not")
        (item "compare")
        (item "load-local")
        (item "store-local")
        (item "count-leading-zeros")
        (item "local-address")
        (item "load-task-word")
        (item "float-math")
        (item "switch")
        (item "yield")
        (item "inlined-name")
        (item "load-acquire")
        (item "store-release")
      )
    )
  )
)
(prop _ kind-names (list String)
  (=
    (call List
      (block
        (item "main")
        (item "init")
        (item "task-main")
        (item "process-main")
        (item "instance")
        (item "initializer")
        (item "lazy")
        (item "constants")
        (item "globals")
        (item "lazy-global")
        (item "statics")
        (item "adapter")
        (item "witness")
        (item "viewed-body")
        (item "generator-body")
        (item "class-adapter")
        (item "union-dispatch")
        (item "interface-equality")
        (item "task-local-init")
        (item "task-body")
        (item "task-init")
        (item "thread-local-init")
        (item "thread-init")
        (item "stack-local-init")
        (item "argument-default")
        (item "stream-action")
        (item "pattern-helper")
        (item "pattern-cast")
        (item "lazy-rule")
        (item "mapped-rule")
        (item "raising-rule")
        (item "storage-growth")
        (item "rule-adapter")
        (item "property-updater")
        (item "live-adapter")
        (item "class-rule-updater")
        (item "idle-action")
        (item "event-handler")
        (item "event-matcher")
        (item "event-registrations")
        (item "style-registration")
        (item "style-gate")
        (item "markup-query")
        (item "markup-query-add")
        (item "markup-query-remove")
        (item "style-author")
        (item "style-static-value")
        (item "style-rule")
        (item "style-sheet-registration")
        (item "style-scope-state")
        (item "slot-forward")
        (item "constructor-body")
        (item "markup-trigger-add")
        (item "markup-trigger-remove")
        (item "markup-trigger-ancestor")
        (item "machine-handler")
        (item "machine-cast")
        (item "machine-activation")
        (item "machine-descriptor")
        (item "machine-deferral")
        (item "batch-main")
        (item "batch-finish")
        (item "source-attach")
        (item "machine-part")
        (item "probe-setup")
        (item "probe-teardown")
        (item "probe-closer")
        (item "probe-flush")
        (item "probe-safepoint")
        (item "machine-stop")
        (item "style-themed-value")
        (item "style-given-author")
        (item "raise-message")
        (item "raise-panic")
      )
    )
  )
)
(prop _ callee-names (list String) (= (list "function" "runtime" "c" "value")))
(prop _ machine-names (list String)
  (=
    (call List
      (block
        (item "void")
        (item "pointer")
        (item "managed")
        (item "u8")
        (item "i8")
        (item "u16")
        (item "i16")
        (item "u32")
        (item "i32")
        (item "u64")
        (item "i64")
        (item "f32")
        (item "f64")
      )
    )
  )
)
(prop _ arithmetic-names (list String) (= (list "add" "subtract" "multiply" "divide" "remainder")))
(prop _ bitwise-names (list String) (= (list "and" "or" "xor" "shift-left" "shift-right" "shift-right-zero")))
(prop _ compare-names (list String) (= (list "equal" "not-equal" "less" "less-equal" "greater" "greater-equal")))
(prop _ float-math-names (list String) (= (list "sqrt" "abs" "min" "max")))

(type + IRText
  ; A function's IR as text, for reading while debugging the emitter.
  (blank)
  (prop + out TextBuffer)
  (prop _ tables ProgramTables)
  (fn-do + This _
    (param tables ProgramTables)
  )
  (fn-do + function-text _
    (param ir IRFunction)
    (let bundle (. tables bundle))
    (let function ([] (. tables functions) (. ir function)))
    (call (. out text) "function ")
    (call (. out span) (call (. bundle string) (. function name)))
    (call (. out text) " kind=")
    (call (. out text) ([] kind-names (. function kind)))
    (call (. out text) " returns=")
    (call layout-text (. ir returns))
    (if (. ir signals)
      (call (. out text) " signals")
    )
    (for (in position (..< 0 (. ir arguments length)))
      (call (. out text) " arg")
      (call (. out unsigned) position)
      (call (. out byte) 61)
      (call layout-text ([] (. ir arguments) position))
    )
    (call (. out byte) 10)
    (for (in id (..< 0 (. ir locals length)))
      (call (. out text) "local L")
      (call (. out unsigned) (as id U64))
      (call (. out byte) 32)
      (call layout-text (. ([] (. ir locals) id) layout))
      (if (. ([] (. ir locals) id) address-taken)
        (call (. out text) " address-taken")
      )
      (call (. out byte) 10)
    )
    (for (in position (..< 0 (. ir order length)))
      (let block ([] (. ir order) position))
      (call (. out text) "block ")
      (call (. out unsigned) block)
      (call (. out byte) 10)
      (let rows (. ([] (. ir blocks) block) instructions))
      (for (in id (..< (. rows start) (. rows end)))
        (call instruction-text ir id)
      )
    )
    (for (in id (..< 0 (. ir constants length)))
      (let constant ([] (. ir constants) id))
      (call (. out text) "constant C")
      (call (. out unsigned) (as id U64))
      (call (. out text) " string chars=")
      (call (. out unsigned) (. constant character-length))
      (call (. out text) " flags=")
      (call (. out unsigned) (. constant flags))
      (call (. out text) " bytes=")
      (call (. out hex) (. constant bytes))
      (call (. out byte) 10)
    )
    (for (in dependency (. ir dependencies))
      (call (. out text) "depends ")
      (call (. out text) ([] callee-names (. dependency kind)))
      (call (. out byte) 32)
      (if (== (. dependency kind) .callee-function)
        (call (. out span) (call (. bundle string) (. ([] (. tables functions) (. dependency symbol)) name)))
        (else-if (== (. dependency kind) .callee-c)
          (call (. out span) (call (. bundle string) (. dependency symbol)))
        )
        (else
          (call (. out text) ([] runtime-function-names (. dependency symbol)))
        )
      )
      (if (!= (/and/ (. dependency flags) may-panic-dependency) 0)
        (call (. out text) " may-panic")
      )
      (if (!= (/and/ (. dependency flags) generator-dependency) 0)
        (call (. out text) " generator")
      )
      (call (. out byte) 10)
    )
  )
  (fn-do _ instruction-text _
    (param ir IRFunction)
    (param id ValueId)
    (let row ([] (. ir instructions) id))
    (call (. out text) "  %")
    (call (. out unsigned) id)
    (call (. out byte) 32)
    (call (. out text) ([] op-names (. row op)))
    (call aux-text row)
    (if (!= (. row layout) void-layout)
      (call (. out byte) 32)
      (call layout-text (. row layout))
    )
    (for (in position (..< (. row operands start) (. row operands end)))
      (call (. out text) (if-expr (== position (. row operands start)) " " ", "))
      (call operand-text ir ([] (. ir operands) position))
    )
    (if (!= (. row line) 0)
      (call (. out text) " loc=")
      (call (. out unsigned) (. row line))
      (call (. out byte) 58)
      (call (. out unsigned) (. row column))
    )
    (call (. out byte) 10)
  )
  (fn-do _ aux-text _
    (param row IRInstruction)
    ; The op's own parameter, as the row's doc lists them.
    (let payload (/and/ (. row aux) 0x7fffffff))
    (let is-flagged (!= (/and/ (. row aux) managed-store-flag) 0))
    (match (. row op)
      (case= .op-call-void
        (call call-text (. row aux))
      )
      (case= .op-call
        (call call-text (. row aux))
      )
      (case= .op-return
        (if (== (. row aux) (. ReturnKind return-panic))
          (call (. out text) ".panic")
        )
      )
      (case= .op-arithmetic
        (call (. out byte) 46)
        (call (. out text) ([] arithmetic-names (. row aux)))
      )
      (case= .op-bitwise
        (call (. out byte) 46)
        (call (. out text) ([] bitwise-names (. row aux)))
      )
      (case= .op-compare
        (call (. out byte) 46)
        (call (. out text) ([] compare-names (. row aux)))
      )
      (case= .op-float-math
        (call (. out byte) 46)
        (call (. out text) ([] float-math-names (. row aux)))
      )
      (case= .op-load
        (call offset-text payload false)
      )
      (case= .op-address
        (call offset-text payload false)
      )
      (case= .op-store
        (call offset-text payload is-flagged)
      )
      (case= .op-copy
        (call (. out byte) 32)
        (call layout-text payload)
        (if is-flagged
          (call (. out text) " barrier")
        )
      )
      (case= .op-zero
        (call (. out byte) 32)
        (call layout-text payload)
      )
      (case= .op-load-local
        (call local-text (. row aux))
      )
      (case= .op-store-local
        (call local-text (. row aux))
      )
      (case= .op-local-address
        (call local-text (. row aux))
      )
      (case= .op-load-task-word
        (call offset-text payload false)
      )
      (case= .op-load-acquire
        (call offset-text payload false)
      )
      (case= .op-store-release
        (call offset-text payload false)
      )
      (default
        (return)
      )
    )
  )
  (fn-do _ local-text _
    (param local LocalId)
    (call (. out text) " L")
    (call (. out unsigned) local)
  )
  (fn-do _ call-text _
    (param aux U32)
    (call (. out byte) 46)
    (call (. out text) ([] callee-names (/and/ aux callee-kind-mask)))
    (if (!= (/and/ aux checked-call-flag) 0)
      (call (. out text) ".checked")
    )
    (if (!= (/and/ aux stack-map-call-flag) 0)
      (call (. out text) ".stack-map")
    )
  )
  (fn-do _ offset-text _
    (param offset U32)
    (param is-barrier Bool)
    (call (. out text) " +")
    (call (. out unsigned) offset)
    (if is-barrier
      (call (. out text) " barrier")
    )
  )
  (fn-do _ layout-text _
    (param layout LayoutId)
    ; A scalar's name, or a struct's id with its size.
    (if (< layout first-struct-layout)
      (call (. out text) ([] machine-names layout))
      (return)
    )
    (call (. out text) "struct")
    (call (. out unsigned) layout)
    (call (. out byte) 58)
    (call (. out unsigned) (. ([] (. tables layouts rows) layout) size))
  )
  (fn-do _ operand-text _
    (param ir IRFunction)
    (param operand Operand)
    (let payload (call operand-payload operand))
    (match (call operand-kind operand)
      (case= .operand-void
        (call (. out text) "void")
      )
      (case= .operand-value
        (call (. out byte) 37)
        (call (. out unsigned) payload)
      )
      (case= .operand-number
        (let number ([] (. ir numbers) payload))
        (call (. out byte) 35)
        (call (. out unsigned) (. number bits))
        (call (. out byte) 58)
        (call (. out text) ([] machine-names (. number kind)))
      )
      (case= .operand-constant
        (call (. out byte) 67)
        (call (. out unsigned) payload)
      )
      (case= .operand-symbol
        (call (. out text) "S(")
        (call (. out span) (call (. tables bundle string) payload))
        (call (. out byte) 41)
      )
      (case= .operand-argument
        (call (. out text) "arg")
        (call (. out unsigned) payload)
      )
      (case= .operand-environment
        (call (. out text) "environment")
      )
      (case= .operand-panic-signal
        (call (. out text) "panic-signal")
      )
      (case= .operand-block
        (call (. out byte) 98)
        (call (. out unsigned) payload)
      )
      (case= .operand-result
        (call (. out text) "result")
      )
      (case= .operand-descriptor
        (call (. out text) "descriptor(")
        (call layout-text payload)
        (call (. out byte) 41)
      )
      (case= .operand-buffer-descriptor
        (call (. out text) "buffer-descriptor(")
        (call layout-text payload)
        (call (. out byte) 41)
      )
      (default
        (call (. out text) "unknown")
      )
    )
  )
)
