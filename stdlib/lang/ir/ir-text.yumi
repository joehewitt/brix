./ir
/core/table
/lang/backend/bundle
/lang/backend/mir
/lang/backend/mir-text
/lang/emit/layouts
/lang/emit/program-tables
/lang/emit/runtime

_ op-names [String] = ["call-void", "return", "call", "jump", "branch", "phi", "arithmetic", "bitwise", "num-cast", "load", "store", "address", "frame", "copy", "zero", "load-task-panic", "load-panic-signal", "negate", "bitwise-not", "compare", "load-local", "store-local", "count-leading-zeros", "local-address", "load-task-word", "float-math", "switch", "yield", "inlined-name", "load-acquire", "store-release"]
_ kind-names [String] = ["main", "init", "task-main", "process-main", "instance", "initializer", "lazy", "constants", "globals", "lazy-global", "statics", "adapter", "witness", "viewed-body", "generator-body", "class-adapter", "union-dispatch", "interface-equality", "task-local-init", "task-body", "task-init", "thread-local-init", "thread-init", "stack-local-init", "argument-default", "stream-action", "pattern-helper", "pattern-cast", "lazy-rule", "mapped-rule", "raising-rule", "storage-growth", "rule-adapter", "property-updater", "live-adapter", "class-rule-updater", "idle-action", "event-handler", "event-matcher", "event-registrations", "style-registration", "style-gate", "markup-query", "markup-query-add", "markup-query-remove", "style-author", "style-static-value", "style-rule", "style-sheet-registration", "style-scope-state", "slot-forward", "constructor-body", "markup-trigger-add", "markup-trigger-remove", "markup-trigger-ancestor", "machine-handler", "machine-cast", "machine-activation", "machine-descriptor", "machine-deferral", "batch-main", "batch-finish", "source-attach", "machine-part", "probe-setup", "probe-teardown", "probe-closer", "probe-flush", "probe-safepoint", "machine-stop", "style-themed-value", "style-given-author"]
_ callee-names [String] = ["function", "runtime", "c", "value"]
_ machine-names [String] = ["void", "pointer", "managed", "u8", "i8", "u16", "i16", "u32", "i32", "u64", "i64", "f32", "f64"]
_ arithmetic-names [String] = ["add", "subtract", "multiply", "divide", "remainder"]
_ bitwise-names [String] = ["and", "or", "xor", "shift-left", "shift-right", "shift-right-zero"]
_ compare-names [String] = ["equal", "not-equal", "less", "less-equal", "greater", "greater-equal"]
_ float-math-names [String] = ["sqrt", "abs", "min", "max"]

━━━━━━━━━━━━━━━━━━━━
+ IRText

` A function's IR as text, for reading while debugging the emitter.

+ out TextBuffer
_ tables ProgramTables

────────────────────
+ This
    - tables ProgramTables

────────────────────
+ do function-text
    - ir IRFunction

. bundle = tables.bundle
. function = tables.functions[ir.function]
out.text("function ")
out.span(bundle.string(function.name))
out.text(" kind=")
out.text(kind-names[function.kind])
out.text(" returns=")
layout-text(ir.returns)
if ir.signals
    out.text(" signals")
for position in 0 .. < ir.arguments.length
    out.text(" arg")
    out.unsigned(position)
    out.byte(61)
    layout-text(ir.arguments[position])
out.byte(10)
for id in 0 .. < ir.locals.length
    out.text("local L")
    out.unsigned(id as U64)
    out.byte(32)
    layout-text(ir.locals[id].layout)
    if ir.locals[id].address-taken
        out.text(" address-taken")
    out.byte(10)
for position in 0 .. < ir.order.length
    . block = ir.order[position]
    out.text("block ")
    out.unsigned(block)
    out.byte(10)
    . rows = ir.blocks[block].instructions
    for id in rows.start .. < rows.end
        instruction-text(ir, id)
for id in 0 .. < ir.constants.length
    . constant = ir.constants[id]
    out.text("constant C")
    out.unsigned(id as U64)
    out.text(" string chars=")
    out.unsigned(constant.character-length)
    out.text(" flags=")
    out.unsigned(constant.flags)
    out.text(" bytes=")
    out.hex(constant.bytes)
    out.byte(10)
for dependency in ir.dependencies
    out.text("depends ")
    out.text(callee-names[dependency.kind])
    out.byte(32)
    if dependency.kind == .callee-function
        out.span(bundle.string(tables.functions[dependency.symbol].name))
    else if dependency.kind == .callee-c
        out.span(bundle.string(dependency.symbol))
    else
        out.text(runtime-function-names[dependency.symbol])
    if (dependency.flags /and/ may-panic-dependency) != 0
        out.text(" may-panic")
    if (dependency.flags /and/ generator-dependency) != 0
        out.text(" generator")
    out.byte(10)

────────────────────
_ do instruction-text
    - ir IRFunction
    - id ValueId

. row = ir.instructions[id]
out.text("  %")
out.unsigned(id)
out.byte(32)
out.text(op-names[row.op])
aux-text(row)
if row.layout != void-layout
    out.byte(32)
    layout-text(row.layout)
for position in row.operands.start .. < row.operands.end
    out.text(if position == row.operands.start then " " else ", ")
    operand-text(ir, ir.operands[position])
if row.line != 0
    out.text(" loc=")
    out.unsigned(row.line)
    out.byte(58)
    out.unsigned(row.column)
out.byte(10)

────────────────────
_ do aux-text
    - row IRInstruction

` The op's own parameter, as the row's doc lists them.
. payload = row.aux /and/ 0x7fffffff
. is-flagged = (row.aux /and/ managed-store-flag) != 0
do match row.op
    |= .op-call-void
        call-text(row.aux)
    |= .op-call
        call-text(row.aux)
    |= .op-return
        if row.aux == ReturnKind.return-panic
            out.text(".panic")
    |= .op-arithmetic
        out.byte(46)
        out.text(arithmetic-names[row.aux])
    |= .op-bitwise
        out.byte(46)
        out.text(bitwise-names[row.aux])
    |= .op-compare
        out.byte(46)
        out.text(compare-names[row.aux])
    |= .op-float-math
        out.byte(46)
        out.text(float-math-names[row.aux])
    |= .op-load
        offset-text(payload, false)
    |= .op-address
        offset-text(payload, false)
    |= .op-store
        offset-text(payload, is-flagged)
    |= .op-copy
        out.byte(32)
        layout-text(payload)
        if is-flagged
            out.text(" barrier")
    |= .op-zero
        out.byte(32)
        layout-text(payload)
    |= .op-load-local
        local-text(row.aux)
    |= .op-store-local
        local-text(row.aux)
    |= .op-local-address
        local-text(row.aux)
    |= .op-load-task-word
        offset-text(payload, false)
    |= .op-load-acquire
        offset-text(payload, false)
    |= .op-store-release
        offset-text(payload, false)
    ??
        =

────────────────────
_ do local-text
    - local LocalId

out.text(" L")
out.unsigned(local)

────────────────────
_ do call-text
    - aux U32

out.byte(46)
out.text(callee-names[aux /and/ callee-kind-mask])
if (aux /and/ checked-call-flag) != 0
    out.text(".checked")
if (aux /and/ stack-map-call-flag) != 0
    out.text(".stack-map")

────────────────────
_ do offset-text
    - offset U32
    - is-barrier Bool

out.text(" +")
out.unsigned(offset)
if is-barrier
    out.text(" barrier")

────────────────────
_ do layout-text
    - layout LayoutId

` A scalar's name, or a struct's id with its size.
if layout < first-struct-layout
    out.text(machine-names[layout])
    =
out.text("struct")
out.unsigned(layout)
out.byte(58)
out.unsigned(tables.layouts.rows[layout].size)

────────────────────
_ do operand-text
    - ir IRFunction
    - operand Operand

. payload = operand-payload(operand)
do match operand-kind(operand)
    |= .operand-void
        out.text("void")
    |= .operand-value
        out.byte(37)
        out.unsigned(payload)
    |= .operand-number
        . number = ir.numbers[payload]
        out.byte(35)
        out.unsigned(number.bits)
        out.byte(58)
        out.text(machine-names[number.kind])
    |= .operand-constant
        out.byte(67)
        out.unsigned(payload)
    |= .operand-symbol
        out.text("S(")
        out.span(tables.bundle.string(payload))
        out.byte(41)
    |= .operand-argument
        out.text("arg")
        out.unsigned(payload)
    |= .operand-environment
        out.text("environment")
    |= .operand-panic-signal
        out.text("panic-signal")
    |= .operand-block
        out.byte(98)
        out.unsigned(payload)
    |= .operand-result
        out.text("result")
    |= .operand-descriptor
        out.text("descriptor(")
        layout-text(payload)
        out.byte(41)
    |= .operand-buffer-descriptor
        out.text("buffer-descriptor(")
        layout-text(payload)
        out.byte(41)
    ??
        out.text("unknown")
