(import ./ir)
(import /core/arena)
(import /core/table)
(import /lang/ast/ast-nodes)
(import /lang/ast/decl)
(import /lang/ast/module)
(import /lang/ast/program)
(import /lang/backend/bundle)
(import /lang/backend/mir)
(import /lang/backend/mir-digest)
(import /lang/check/facts)
(import /lang/check/instances)
(import /lang/check/stable-key)
(import /lang/check/type-store)
(import /lang/check/types)
(import /lang/emit/layouts)
(import /lang/emit/program-tables)
(blank)
(prop _ first-multiplier U64 (= 0x9e3779b97f4a7c15))
(prop _ second-multiplier U64 (= 0xc2b2ae3d27d4eb4f))
(prop _ first-offset U64 (= 0x165667b19e3779f9))
(prop _ second-offset U64 (= 0x27d4eb2f165667c5))
(prop _ absent-mark U64 (= 0x4142534e54))

(type + IRDigest (is Tuple)
  (prop + high U64)
  (prop + low U64)
)

(fn-expr + same-digest Bool
  (param first IRDigest)
  (param second IRDigest)
  (and (== (. first high) (. second high)) (== (. first low) (. second low)))
)

(type + IRDigester
  ; A digest of a function's IR as the emitter leaves it, before inlining, which one round of
  ; emission shares with the next wherever the IR is the same. Each id in the IR goes in as what it
  ; names in its round: a string by its bytes, a function by its name, a layout by what it holds
  ; (`layout-key`) and a type by its stable key. Syntax ids, lines, columns and modules go in as
  ; they are, as does each number that is the IR's own: a value, a block, a local or a constant.
  ; What lowering reads of the function's row goes in too: its symbol, the name a stack trace
  ; prints, where its declaration is written, and the module and placelessness its locations take.
  (blank)
  (prop _ tables ProgramTables)
  (prop _ program Program)
  (prop _ instances Instances)
  (prop _ facts Facts)
  (prop _ types Types)
  (prop _ layout-keys (of CPointer U64))
  (prop _ layout-states (of CPointer Byte))
  (prop _ first U64)
  (prop _ second U64)
  (fn-do + This _
    (param tables ProgramTables)
    (param program Program)
    (param instances Instances)
    (param facts Facts)
    (param types Types)
    (param storage Arena)
    (let count (. tables layouts count))
    (= layout-keys (call (of (. storage allocate) U64) count))
    (= layout-states (call (of (. storage allocate) Byte) count))
    (for (in id (..< 0 count))
      (= ([] layout-keys id) 0)
      (= ([] layout-states id) 0)
    )
  )
  (fn-do + digest IRDigest
    (param ir IRFunction)
    (param bridged Bool)
    (= first first-offset)
    (= second second-offset)
    (let row ([] (. tables functions) (. ir function)))
    (call string (. row symbol))
    (call string (if-expr bridged (. row bridge-display) (. row display)))
    (let declared (call (. tables declared-at) (. ir function)))
    (call flag (!= declared null))
    (if declared
      (call string (. declared file))
      (call word (as (. declared line) U64))
      (call word (as (. declared column) U64))
    )
    (call flag (. row placeless))
    (call word (. row module))
    (call word (. row site-module))
    (call layout (. ir returns))
    (call flag (. ir signals))
    (call word (. ir arguments length))
    (for (in position (..< 0 (. ir arguments length)))
      (call layout ([] (. ir arguments) position))
    )
    (call word (as (. ir locals length) U64))
    (for (in id (..< 0 (. ir locals length)))
      (let local ([] (. ir locals) id))
      (call layout (. local layout))
      (call flag (. local address-taken))
      (call flag (. local filled))
    )
    (call ids (. ir order))
    (call word (as (. ir blocks length) U64))
    (for (in block (..< 0 (. ir blocks length)))
      (call span (. ([] (. ir blocks) block) instructions))
    )
    (call word (as (. ir instructions length) U64))
    (for (in id (..< 0 (. ir instructions length)))
      (call instruction ir ([] (. ir instructions) id))
    )
    (call word (as (. ir numbers length) U64))
    (for (in id (..< 0 (. ir numbers length)))
      (call word (. ([] (. ir numbers) id) kind))
      (call word (. ([] (. ir numbers) id) bits))
    )
    (call word (as (. ir constants length) U64))
    (for (in id (..< 0 (. ir constants length)))
      (let constant ([] (. ir constants) id))
      (call word (. constant kind))
      (call word (. constant character-length))
      (call word (. constant flags))
      (call bytes (. constant bytes))
    )
    (call word (as (. ir dependencies length) U64))
    (for (in id (..< 0 (. ir dependencies length)))
      (let dependency ([] (. ir dependencies) id))
      (call word (. dependency kind))
      (call word (. dependency flags))
      (if (== (. dependency kind) .callee-function)
        (call function (. dependency symbol))
        (else-if (== (. dependency kind) .callee-c)
          (call string (. dependency symbol))
        )
        (else
          (call word (. dependency symbol))
        )
      )
    )
    (call ids (. ir made-calls))
    (call word (as (. ir streams length) U64))
    (for (in id (..< 0 (. ir streams length)))
      (let stream ([] (. ir streams) id))
      (call operand (. stream made))
      (call word (. stream begin))
      (call word (. stream read))
      (call ids (. stream ends))
      (call word (. stream head))
      (call word (. stream polled))
      (call word (. stream done))
    )
    (call word (as (. ir notes length) U64))
    (for (in id (..< 0 (. ir notes length)))
      (let note ([] (. ir notes) id))
      (call word (. note row))
      (call function (. note target))
      (call word (. note site-module))
      (call word (. note site-syntax))
      (call word (. note chain length))
      (for (in position (..< 0 (. note chain length)))
        (call function ([] (. note chain) position))
      )
    )
    (return (call IRDigest (call settled first) (call settled second)))
  )
  (fn-do + context IRDigest
    (param id FunctionId)
    (param ir IRDigest)
    (param bridged Bool)
    ; What the inliner reads of a function it consults: its IR as the emitter leaves it, whether
    ; it is bridged, and what its verdicts read besides, from its row, its instance, its
    ; declaration and its signature, and for a union dispatch the read it forwards.
    (= first first-offset)
    (= second second-offset)
    (call word (. ir high))
    (call word (. ir low))
    (call flag bridged)
    (let row ([] (. tables functions) id))
    (call word (. row kind))
    (call flag (. row may-panic))
    (if (== (. row kind) .union-dispatch)
      (call forward (. row place))
    )
    (let instance (. row instance))
    (if (!= instance no-instance)
      (call flag (call (. tables is-recursive) instance))
      (call flag (call (. tables asks-inline) instance))
      (call flag (!= ([] (. tables step-functions) instance) no-function))
      (let held ([] (. instances rows) instance))
      (call flag (. held may-panic))
      (call flag (. held is-generator))
      (call declaration held)
      (let signature ([] (. instances signatures) instance))
      (call word (. signature args count))
      (call word (. signature errors count))
      (call word (call (. types key-of) (. signature returns)))
      (if (!= (. signature args count) 0)
        (let argument (call (. instances argument-type) instance 0))
        (call word (call (. types key-of) argument))
        (if (and (!= argument no-type) (== (call (. types intrinsic-of) argument) .tuple))
          (call layout ([] (. tables layouts values) argument))
        )
      )
    )
    (return (call IRDigest (call settled first) (call settled second)))
  )
  (fn-do + round-context IRDigest
    (param seed MIRDigest)
    (param optimizes Bool)
    ; What inlining and lowering read of the round as a whole: the bundle's settings, its special
    ; and runtime symbols, the paths of the modules, the layout an interface's table is read
    ; through, and whether the round inlines.
    (= first first-offset)
    (= second second-offset)
    (call word (. seed high))
    (call word (. seed low))
    (call flag optimizes)
    (let bundle (. tables bundle))
    (for (in symbol (list (. bundle entry-name) (. bundle main-name) (. bundle gc-public-control-word-symbol) (. bundle write-barrier-record-symbol) (. bundle zero-stack-frame-symbol) (. bundle memory-copy-symbol) (. bundle memory-zero-symbol) (. bundle bulk-write-barrier-symbol) (. bundle thread-cache-symbol) (. bundle allocation-refill-symbol) (. bundle allocate-object-symbol)))
      (call string symbol)
    )
    (let runtime (. tables runtime-symbols))
    (call word (. runtime length))
    (for (in index (..< 0 (. runtime length)))
      (call string ([] runtime index))
    )
    (let paths (. tables module-paths))
    (call word (. paths length))
    (for (in index (..< 0 (. paths length)))
      (call string ([] paths index))
    )
    (call layout (. tables layouts interface-layout))
    (return (call IRDigest (call settled first) (call settled second)))
  )
  (fn-expr + name-key StableKey
    (param id FunctionId)
    ; A function's name as a key, the same in every round that emits it.
    (call named stable-key-seed (. ([] (. tables functions) id) name))
  )
  (fn-expr + known StableKey
    (param id LayoutId)
    ; The key of a layout this digester has met, or zero.
    (if-expr (== ([] layout-states id) 2) ([] layout-keys id) 0)
  )
  (fn-do _ declaration _
    (param held Instance)
    (let module ([] (. program modules) (. held module)))
    (match? ([] (. module decls) (. held decl))
      (case (call .decl-function fn)
        (call word (. fn kind))
        (match? ([] (. module tree nodes) (. fn syntax))
          (case (call .node-function-syntax syntax)
            (call flag (. syntax is-inline))
            (if (!= (. syntax body) 0)
              (let loc (. ([] (. module tree nodes) (. syntax body)) loc))
              (call word (- (. loc end line) (. loc begin line)))
            )
          )
        )
      )
    )
  )
  (fn-do _ forward _
    (param place U32)
    (let found ([] (. facts forwards) place))
    (call word (. found given))
    (match? ([] (. ([] (. program modules) (. ([] (. instances rows) (. found instance)) module)) tree nodes) (. found syntax))
      (case (call .node-get-expression read)
        (call word (call (. types key-of) (call (. facts node-type) (. found instance) (. read object))))
      )
    )
  )
  (fn-do _ instruction _
    (param ir IRFunction)
    (param row IRInstruction)
    (call word (. row op))
    (call word (. row block))
    (call layout (. row layout))
    (call word (call (. types key-of) (. row type)))
    (call word (. row syntax))
    (call word (. row line))
    (call word (. row column))
    (call word (. row module))
    (if (or (== (. row op) .op-frame) (== (. row op) .op-zero))
      (call layout (. row aux))
      (else-if (== (. row op) .op-copy)
        (call layout (/and/ (. row aux) 0x7fffffff))
        (call word (/and/ (. row aux) managed-store-flag))
      )
      (else
        (call word (. row aux))
      )
    )
    (call word (. row operands count))
    (for (in position (..< (. row operands start) (. row operands end)))
      (call operand ([] (. ir operands) position))
    )
  )
  (fn-do _ operand _
    (param operand Operand)
    (let kind (call operand-kind operand))
    (let payload (call operand-payload operand))
    (call word kind)
    (match kind
      (case= .operand-symbol
        (call string payload)
      )
      (case= .operand-descriptor
        (call layout payload)
      )
      (case= .operand-buffer-descriptor
        (call layout payload)
      )
      (default
        (call word payload)
      )
    )
  )
  (fn-do _ function _
    (param id FunctionId)
    (if (== id no-function)
      (call word absent-mark)
      (return)
    )
    (call string (. ([] (. tables functions) id) name))
  )
  (fn-do _ string _
    (param id StringId)
    (if (== id no-string)
      (call word absent-mark)
      (return)
    )
    (call bytes (call (. tables bundle string) id))
  )
  (fn-do _ bytes _
    (param text ByteSpan)
    (call word (as (. text length) U64))
    (let packed 0u64)
    (for (in index (..< 0 (. text length)))
      (= packed (/or/ (/lshift/ packed 8) (as ([] (. text data) index) U64)))
      (if (== (% index 8) 7)
        (call word packed)
        (= packed 0)
      )
    )
    (call word packed)
  )
  (fn-do _ layout _
    (param id LayoutId)
    (call word (call layout-word id))
  )
  (fn-expr _ layout-word U64
    (param id LayoutId)
    ; A layout as a word: a scalar's machine kind, or a struct's key (`layout-key`).
    (if-expr (or (< id first-struct-layout) (== id no-layout)) (as id U64) (call layout-key id))
  )
  (fn-do _ layout-key StableKey
    (param id LayoutId)
    ; What a struct's layout holds, kept once it is known: its kind, size, alignment and format,
    ; whether it holds managed pointers, the names of its descriptors and its allocation site, the
    ; type it was built for, its fields and its cases each with its place, its layout and its type,
    ; and the layout it shares its shape with, where that is another.
    (if (== ([] layout-states id) 2)
      (return ([] layout-keys id))
    )
    (if (== ([] layout-states id) 1)
      (return absent-mark)
    )
    (= ([] layout-states id) 1)
    (let row ([] (. tables layouts rows) id))
    (let key (call mixed (call mixed (call mixed stable-key-seed (. row kind)) (. row size)) (. row alignment)))
    (= key (call mixed (call mixed key (. row format)) (if-expr (. row is-managed) 1u64 0u64)))
    (= key (call named (call named (call named key (. row descriptor)) (. row buffer)) (. row site)))
    (= key (call mixed key (call (. types key-of) (. row type))))
    (= key (call fields key (. row fields)))
    (= key (call fields key (. row cases)))
    (= key (call mixed key (if-expr (!= (. row shape) id) (call layout-word (. row shape)) absent-mark)))
    (= ([] layout-keys id) key)
    (= ([] layout-states id) 2)
    (return key)
  )
  (fn-do _ fields StableKey
    (param key StableKey)
    (param range Span)
    (let result (call mixed key (. range count)))
    (for (in index (..< (. range start) (. range end)))
      (let field ([] (. tables layouts fields) index))
      (= result
        (call mixed
          (block
            (arg (call mixed (call mixed result (. field offset)) (call layout-word (. field layout))))
            (arg (call (. types key-of) (. field type)))
          )
        )
      )
    )
    (return result)
  )
  (fn-do _ named StableKey
    (param key StableKey)
    (param id StringId)
    (if (== id no-string)
      (return (call mixed key absent-mark))
    )
    (let text (call (. tables bundle string) id))
    (let result (call mixed key (as (. text length) U64)))
    (for (in index (..< 0 (. text length)))
      (= result (call mixed result ([] (. text data) index)))
    )
    (return result)
  )
  (fn-do _ ids _
    (param list IdList)
    (call word (. list length))
    (for (in index (..< 0 (. list length)))
      (call word ([] list index))
    )
  )
  (fn-do _ span _
    (param range Span)
    (call word (. range start))
    (call word (. range count))
  )
  (fn-do _ flag _
    (param value Bool)
    (call word (if-expr value 1u64 0u64))
  )
  (fn-do _ word _ @inline
    (param value U64)
    (= first (call lane first value first-multiplier))
    (= second (call lane second (/xor/ value second-offset) second-multiplier))
  )
)

(fn-expr _ lane U64 @inline
  (param hash U64)
  (param value U64)
  (param multiplier U64)
  (+ (* (/or/ (/lshift/ combined 27) (/zrshift/ combined 37)) multiplier) first-offset)
  (where
    (lazy combined (/xor/ hash (* value multiplier)))
  )
)

(fn-expr _ settled U64
  (param hash U64)
  (* (/xor/ folded (/zrshift/ folded 29)) first-multiplier)
  (where
    (lazy folded (* (/xor/ hash (/zrshift/ hash 33)) second-multiplier))
  )
)
