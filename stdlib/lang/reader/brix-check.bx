(import ./brix-catalog)
(import ./brix-heads)
(import /core/arena)
(import /data/sexp)
(blank)
(prop _ ubrix-keywords _ (:= (list "in" "on" "and" "or" "do" "for" "while" "if" "else")))

(type + BrixIssueKind (is U8)
  (variant empty-list)
  (variant headless)
  (variant raw-form)
  (variant unknown-head)
  (variant misfit)
  (variant firm-misfit)
  (variant refused)
  (variant late-flag)
  (variant bad-name)
  (variant wrong-literal)
  (variant wrong-form)
  (variant surplus)
  (variant missing)
)

(type + BrixIssue (is Tuple)
  (prop + index Index)
  (prop + rank Index)
  (prop + is-own Bool)
  (prop + kind BrixIssueKind)
  (prop + sense (? BrixSense) (= null))
  (prop + slot (? BrixSlot) (= null))
  (prop + place (? BrixPlace) (= null))
  (prop + spot String)
  (prop + owner Index (= 0))
)

(type + BrixChecker
  (prop + issues (list BrixIssue))
  (blank)
  (prop _ catalog BrixCatalog)
  (prop _ tape SexpTape)
  (prop _ heads (of Array U8 ArenaBacking))
  (prop _ bytes (of ImmutableArray Byte))
  (fn-do + This _
    (param catalog _)
    (param tape _)
    (param heads _)
    (lazy bytes (. tape bytes))
  )
  (fn-do + check _
    (let index Index 0)
    (while (< index (. tape length))
      (let broken (call fits index (. catalog top) top-spot))
      (if broken
        (+= issues broken)
      )
      (= index (call (. tape after) index))
    )
    (blank)
    (lazy top-spot "a form at the top level of a file")
  )
  (fn-do + is-clean Bool
    (param node Index)
    (param sense BrixSense)
    (let mark (. issues length))
    (let broken (call follows node sense))
    (let clean (and (not broken) (== (. issues length) mark)))
    (call drop mark)
    (return clean)
  )
  (fn-do + message String
    (param issue BrixIssue)
    (let node (. issue index))
    (match (. issue kind)
      (case= .empty-list
        (return "`()` is empty. Every list starts with a form name.")
      )
      (case= .headless
        (return (str "Every list starts with a form name. This one starts with " (call what (+ node 1)) "."))
      )
      (case= .raw-form
        (return
          (paragraph
            "(raw …) holds text that is not Brix, and a file that holds it does not compile. Write the row as forms."
          )
        )
      )
      (case= .unknown-head
        (let head (call (. tape atom-text) (+ node 1)))
        (return (str "`" head "` is not a form. " (call unknown head (!! (. issue place)))))
      )
      (case= .misfit
        (return (call misfit-message node (!! (. issue place)) (. issue spot)))
      )
      (case= .firm-misfit
        (return
          (scope (str (call what node) " cannot be " (. issue spot) ". " hint)
            (lazy hint (!! (call (. catalog firm-hint) (call (. tape atom-text) (+ node 1)) (!! (. issue place)))))
          )
        )
      )
      (case= .refused
        (return (. (!! (. issue sense)) meaning))
      )
      (case= .late-flag
        (return (call late-flag-message issue))
      )
      (case= .bad-name
        (return (call name-advice node))
      )
      (case= .wrong-literal
        (let sense (!! (. issue sense)))
        (return
          (paragraph
            (str "(" (. sense head) " …) takes `" (!! (. (!! (. issue slot)) literal)) "` here, and " (call what node) " stands in its place. Its shape is " (. sense shape) ".")
          )
        )
      )
      (case= .wrong-form
        (let sense (!! (. issue sense)))
        (return
          (paragraph
            (str "(" (. sense head) " …) takes (" (. (!! (. (!! (. issue slot)) form)) head) " …) here, and " (call what node) " stands in its place. Its shape is " (. sense shape) ".")
          )
        )
      )
      (case= .surplus
        (return (call surplus-message issue))
      )
      (case= .missing
        (let sense (!! (. issue sense)))
        (let slot (!! (. issue slot)))
        (if (and (== (. slot role) "row") (. slot is-repeating))
          (let empty (call (. catalog remark) (. sense head) "Empty"))
          (return-if empty (if (!= empty null)))
        )
        (let text (str "(" (. sense head) " …) needs " (. slot label) ". Its shape is " (. sense shape) "."))
        (let note (?. (. slot place) note))
        (return (if-expr note (str text " " note) text))
      )
    )
  )
  (fn-do _ fits (? BrixIssue)
    (param node Index)
    (param place BrixPlace)
    (param spot String)
    (if (call (. tape is-atom) node)
      (return-if (call named node place) (if (call (. place takes-atom) tape node)))
      (return (call BrixIssue node (call rank node) true .misfit null null place spot))
    )
    (if (call (. tape is-text) node)
      (return-if null (if (or (. place takes-strings) (. place is-free))))
      (return (call BrixIssue node (call rank node) true .misfit null null place spot))
    )
    (let first (+ node 1))
    (if (== first (call (. tape close-of) node))
      (return-if (call params node) (if (. place takes-params)))
      (return (call BrixIssue node (call rank node) true .empty-list))
    )
    (if (not (call (. tape is-atom) first))
      (return-if (call params node) (if (. place takes-params)))
      (return (call BrixIssue node (call rank node) true .headless))
    )
    (let kind (as ([] (. heads data) node) BrixHead))
    (return-if (call BrixIssue node (call rank node) true .raw-form) (if (and (== kind .none) (call (. tape atom-is) first "raw"))))
    (blank)
    (let refused (call refusal node kind place spot))
    (return-if refused (if refused))
    (blank)
    (let senses (call form-senses node))
    (if (== senses null)
      (return-if (call params node) (if (. place takes-params)))
      (return (call BrixIssue node (call rank node) true .unknown-head null null place))
    )
    (let failed (? BrixIssue) null)
    (let kept (? (list BrixIssue)) null)
    (let is-able false)
    (for (in sense senses)
      (if (not (call (. place takes) sense))
        (continue)
      )
      (= is-able true)
      (let mark (. issues length))
      (let broken (call follows node sense))
      (if (not broken)
        (return-if null (if (== (. issues length) mark)))
        (blank)
        (let found (call taken mark))
        (if (or (== kept null) (< (. found length) (. kept length)) (and (== (. found length) (. kept length)) (> (. ([] found 0) rank) (. ([] kept 0) rank))))
          (= kept found)
        )
        (continue)
      )
      (call drop mark)
      (if (or (not failed) (> (. broken rank) (. failed rank)))
        (= failed broken)
      )
    )
    (if (not is-able)
      (return-if (call params node) (if (. place takes-params)))
      (return (call BrixIssue node (call rank node) true .misfit null null place spot))
    )
    (if (and (!= kept null) (not (and failed (> (. kept length) 0) (> (. failed rank) (. ([] kept 0) rank)))))
      (++= issues kept)
      (return null)
    )
    (if (and (call (. catalog has-firm-hint) kind) (call (. catalog firm-hint) (call (. tape atom-text) first) place))
      (return (call BrixIssue node (call rank node) true .firm-misfit null null place spot))
    )
    (return failed)
  )
  (fn-do _ refusal (? BrixIssue)
    (param node Index)
    (param kind BrixHead)
    (param place BrixPlace)
    (param spot String)
    (return-if null (if (== kind .none)))
    (blank)
    (let found (call (. catalog refusals-of) kind))
    (return-if null (if (== found null)))
    (blank)
    (for (in sense found)
      (if (and (call (. place takes) sense) (call is-clean node sense))
        (return (call BrixIssue node (call rank node) true .refused sense null place spot))
      )
    )
    (return null)
  )
  (fn-do _ follows (? BrixIssue)
    (param node Index)
    (param sense BrixSense)
    (let close (call (. tape close-of) node))
    (let slots (. sense slots))
    (let cursor Index 0)
    (let used Size 0)
    (let noted (? (list Index)) null)
    (let last (? BrixSlot) null)
    (let previous Index 0)
    (let next (call (. tape after) (+ node 1)))
    (while (< next close)
      (let item next)
      (= next (call (. tape after) next))
      (let spot cursor)
      (let best (? BrixIssue) null)
      (let origin Index 0)
      (let is-placed false)
      (while (< spot (. slots length))
        (let slot ([] slots spot))
        (let is-loose (call (. slot is-skippable) (if-expr (== spot cursor) used 0)))
        (let mark (. issues length))
        (let broken (call fills item slot sense))
        (if (and broken (call is-piped item close slot))
          (call drop mark)
          (= broken null)
        )
        (if (not broken)
          (if (and (> (. issues length) mark) is-loose)
            (let saved (call taken mark))
            (let clean (call later item sense (+ spot 1)))
            (if (== clean null)
              (++= issues saved)
              (else
                (= spot clean)
              )
            )
          )
          (= is-placed true)
          (break)
        )
        (if (or (not best) (> (. broken rank) (. best rank)) (and (== (. broken rank) (. best rank)) (>= (. slot width) (. ([] slots origin) width))))
          (= best broken)
          (= origin spot)
        )
        (if (not is-loose)
          (break)
        )
        (+= spot 1)
      )
      (if is-placed
        (= last ([] slots spot))
        (= previous item)
        (if (!= spot cursor)
          (= used 0)
        )
        (= cursor spot)
        (+= used 1)
        (if (not (. ([] slots cursor) is-repeating))
          (+= cursor 1)
          (= used 0)
        )
        (continue)
      )
      (let flag (call late-flag item sense cursor))
      (return-if (call BrixIssue item (call rank item) true .late-flag sense flag null "" node) (if flag))
      (return-if best (if (< spot (. slots length))))
      (blank)
      (if (== (as ([] (. heads data) item) BrixHead) .blank-head)
        (continue)
      )
      (let is-over (or (not best) (and (. best is-own) (== (. best index) item))))
      (if (or (not best) (and is-over (call is-overflow item (>= cursor (. slots length)) last)))
        (return (call BrixIssue item (call rank item) false .surplus sense last null "" previous))
      )
      (return-if best (if (and (call (. tape is-atom) item) (== ([] bytes (call (. tape start) item)) 58))))
      (blank)
      (let resume (call resumed slots cursor origin))
      (return-if best (if (== resume null)))
      (blank)
      (let is-blamed (and (. best is-own) (== (. best index) item)))
      (let seen noted)
      (if (not (and is-blamed seen (has seen resume)))
        (+= issues best)
      )
      (if is-blamed
        (if seen
          (+= seen resume)
          (else
            (= noted (call (of List Index) resume))
          )
        )
      )
      (if (!= resume cursor)
        (= used 0)
      )
      (= cursor resume)
      (+= used 1)
    )
    (while (< cursor (. slots length))
      (let slot ([] slots cursor))
      (return-if (call BrixIssue node (call rank node true) false .missing sense slot) (if (not (call (. slot is-skippable) used))))
      (blank)
      (+= cursor 1)
      (= used 0)
    )
    (return null)
  )
  (fn-do _ named (? BrixIssue)
    (param node Index)
    (param place BrixPlace)
    (return-if null (if (or (. place is-free) (has (. place wanted) "Atom"))))
    (blank)
    (let start (call (. tape start) node))
    (let end (call (. tape end) node))
    (let first ([] bytes start))
    (let issue (call BrixIssue node (call rank node) true .bad-name))
    (return-if issue (if (and (== first 35) (not (has (. place wanted) "Name")) (or (call (. tape atom-is) node "#t") (call (. tape atom-is) node "#f")))))
    (return-if null (if (and (== first 67) (> end (+ start 1)) (== ([] bytes (+ start 1)) 58))))
    (return-if issue (if (call (. tape atom-is) node "nil")))
    (blank)
    (let is-split
      (scope (and (or (has (. place wanted) "Key") (has (. place wanted) "Keyed")) is-letter)
        (lazy is-letter (or (and (>= first 97) (<= first 122)) (and (>= first 65) (<= first 90))))
      )
    )
    (let part start)
    (let segments 0)
    (for (in index (.. start end))
      (if (or (== index end) (and is-split (== ([] bytes index) 46)))
        (return-if issue (if (or (== index part) (not (call is-spelled part index)))))
        (blank)
        (= part (+ index 1))
        (+= segments 1)
      )
    )
    (return-if issue (if (and (has (. place wanted) "Keyed") (> segments 2))))
    (blank)
    (let is-declared (or (has (. place wanted) "Binder") (has (. place wanted) "Local")))
    (if (and (<= (- end start) 5) (or is-declared (has (. place wanted) "Key")))
      (for (in word ubrix-keywords)
        (return-if issue (if (and (call (. tape atom-is) node word) (or is-declared (== word "do")))))
      )
    )
    (return null)
  )
  (fn-do _ is-spelled Bool
    (param start Index)
    (param end Index)
    (let first ([] bytes start))
    (let is-lower (and (>= first 97) (<= first 122)))
    (let is-upper (and (>= first 65) (<= first 90)))
    (return-if true (if (and (not is-lower) (not is-upper))))
    (blank)
    (for (in index (..< (+ start 1) end))
      (let byte ([] bytes index))
      (let is-plain (or (and (>= byte 97) (<= byte 122)) (and (>= byte 48) (<= byte 57))))
      (return-if false (if (and (not is-plain) (not (and is-lower (== byte 45))) (not (and is-upper (>= byte 65) (<= byte 90))))))
    )
    (return true)
  )
  (fn-expr _ name-advice String
    (param node Index)
    (case? (== text "nil")
      "`nil` is not a Brix value. Write `null`."
    )
    (case? (== text "#t")
      "`#t` is not a Brix value. Write `true`."
    )
    (case? (== text "#f")
      "`#f` is not a Brix value. Write `false`."
    )
    (case? (has ubrix-keywords text)
      (str "`" text "` is a UBrix keyword, and UBrix cannot show it as this name. Choose another name.")
    )
    (case? (and (> (. parts length) 1) (not (has parts "")))
      (str "`" text "` is not a name. To read a member, write `(. " (call (. " " join) parts) ")`.")
    )
    (case? (and (!= fixed text) (call is-word fixed is-type))
      (str "`" text "` is not a Brix " noun ". " rule ": write `" fixed "`.")
    )
    (default
      (str "`" text "` is not a Brix " noun ". " rule ".")
    )
    (where
      (lazy text (call (. tape atom-text) node))
      (lazy parts (call List (call (. text split) ".")))
      (lazy is-type (<= ([] bytes (call (. tape start) node)) 90))
      (lazy fixed (if-expr is-type (call typed text) (call kebab text)))
      (lazy rule
        (block
          (case? is-type
            "A type name is a capitalized word of letters and digits"
          )
          (default
            "A name is lowercase words joined by hyphens"
          )
        )
      )
      (lazy noun (if-expr is-type "type name" "name"))
    )
  )
  (fn-do _ kebab String
    (param text String)
    (let word text)
    (while (or (call (. word ends-with) "?") (call (. word ends-with) "!"))
      (= word ([] word (..< 0 (- (. word length) 1))))
    )
    (let joined (call (. "-to-" join) (call (. word split) "->")))
    (let out "")
    (for (in char joined)
      (if (and (>= char 'A') (<= char 'Z'))
        (if (and (!= out "") (not (call (. out ends-with) "-")))
          (= out (str out "-"))
        )
        (= out (str out (. (str char) lowercased)))
        (else-if (== char '_')
          (= out (str out "-"))
        )
        (else
          (= out (str out char))
        )
      )
    )
    (return out)
  )
  (fn-do _ typed String
    (param text String)
    (let out "")
    (let is-raised false)
    (for (in char text)
      (if (or (== char '_') (== char '-'))
        (= is-raised true)
        (else-if is-raised
          (= out (str out (. (str char) uppercased)))
          (= is-raised false)
        )
        (else
          (= out (str out char))
        )
      )
    )
    (return out)
  )
  (fn-do _ is-word Bool
    (param text String)
    (param is-type Bool)
    (let is-first true)
    (for (in char text)
      (let is-lower (and (>= char 'a') (<= char 'z')))
      (let is-upper (and (>= char 'A') (<= char 'Z')))
      (let is-digit (and (>= char '0') (<= char '9')))
      (return-if false (if (and is-first (not (if-expr is-type is-upper is-lower)))))
      (return-if false (if (and (not is-lower) (not is-digit) (not (if-expr is-type is-upper (== char '-'))))))
      (blank)
      (= is-first false)
    )
    (return (not is-first))
  )
  (fn-do _ late-flag (? BrixSlot)
    (param item Index)
    (param sense BrixSense)
    (param cursor Index)
    (return-if null (if (not (call (. tape is-atom) item))))
    (blank)
    (for (in index (..< 0 cursor))
      (let slot ([] (. sense slots) index))
      (let literal (. slot literal))
      (return-if slot (if (and (!= literal null) (call (. literal starts-with) ":") (call (. tape atom-is) item literal))))
      (blank)
      (let place (. slot place))
      (return-if slot (if (and (!= place null) (has (. place leads) "@") (call (. place takes-atom) tape item))))
    )
    (return null)
  )
  (fn-do _ late-flag-message String
    (param issue BrixIssue)
    (let node (. issue owner))
    (let close (call (. tape close-of) node))
    (let flag (call (. tape atom-text) (. issue index)))
    (let line (str "(" (. (!! (. issue sense)) head)))
    (let named "")
    (let item (call (. tape after) (+ node 1)))
    (for (in slot (. (!! (. issue sense)) slots))
      (if (or (>= item close) (. slot is-optional) (. slot is-repeating) is-named-slot)
        (break)
      )
      (lazy is-named-slot (call (. (?? (. slot literal) "") starts-with) ":"))
      (= line (str line " " (call inline-text item)))
      (= named (. slot role))
      (= item (call (. tape after) item))
    )
    (let place (if-expr (== named "result") "the result type" (str "`" named "`")))
    (return (str "`" flag "` goes on the header line, after " place ": `" line " " flag "`."))
  )
  (fn-do _ is-piped Bool
    (param item Index)
    (param close Index)
    (param slot BrixSlot)
    (let place (. slot place))
    (return-if false (if (or (== place null) (not (. place takes-piped)))))
    (blank)
    (let next (call (. tape after) item))
    (return-if false (if (or (>= next close) (!= (as ([] (. heads data) next) BrixHead) .pipe-head))))
    (blank)
    (let mark (. issues length))
    (let broken (call fits item (. catalog piped) "a value"))
    (let clean (and (not broken) (== (. issues length) mark)))
    (call drop mark)
    (return clean)
  )
  (fn-do _ resumed (? Index)
    (param slots (list BrixSlot))
    (param cursor Index)
    (param origin Index)
    (return-if origin (if (. ([] slots origin) is-repeating)))
    (blank)
    (let spot (. slots length))
    (while (> spot cursor)
      (-= spot 1)
      (return-if spot (if (. ([] slots spot) is-repeating)))
    )
    (return null)
  )
  (fn-do _ later (? Index)
    (param item Index)
    (param sense BrixSense)
    (param start Index)
    (let spot start)
    (while (< spot (. sense slots length))
      (let slot ([] (. sense slots) spot))
      (let mark (. issues length))
      (let broken (call fills item slot sense))
      (let clean (and (not broken) (== (. issues length) mark)))
      (call drop mark)
      (return-if spot (if clean))
      (return-if null (if (not (call (. slot is-skippable) 0))))
      (blank)
      (+= spot 1)
    )
    (return null)
  )
  (fn-do _ fills (? BrixIssue)
    (param item Index)
    (param slot BrixSlot)
    (param sense BrixSense)
    (let literal (. slot literal-bytes))
    (if (!= literal null)
      (return-if null (if (and (call (. tape is-atom) item) (call (. tape atom-matches) item literal))))
      (return (call BrixIssue item (call rank item false true) false .wrong-literal sense slot))
    )
    (let form (. slot form))
    (if (!= form null)
      (return-if (call follows item form) (if (call is-headed item (. form head-bytes))))
      (return (call BrixIssue item (call rank item false true) false .wrong-form sense slot))
    )
    (return (call fits item (!! (. slot place)) (. slot spot)))
  )
  (fn-expr _ is-overflow Bool
    (param item Index)
    (param is-closed Bool)
    (param last (? BrixSlot))
    (case? (and (!= head null) (!= (call (. catalog firm-hint) head (. catalog section)) null))
      true
    )
    (case? (== last null)
      false
    )
    (case? (!= form null)
      (and is-closed (!= (call (. catalog firm-hint) (. form head) (. catalog section)) null))
    )
    (default
      (and (not (. last is-repeating)) (!= place null) (!= (call (. catalog overflow) place) null))
    )
    (where
      (lazy head (call head-text item))
      (lazy form (. last form))
      (lazy place (. last place))
    )
  )
  (fn-do _ surplus-message String
    (param issue BrixIssue)
    (let node (. issue index))
    (let sense (!! (. issue sense)))
    (let head (call head-text node))
    (if (!= head null)
      (let section (call (. catalog firm-hint) head (. catalog section)))
      (return-if (str (call what node) " is out of place. " section) (if (!= section null)))
    )
    (let last (. issue slot))
    (if (!= last null)
      (let form (. last form))
      (if (!= form null)
        (let closing (call (. catalog firm-hint) (. form head) (. catalog section)))
        (return-if (str (call what node) " follows (" (. form head) " …). " closing) (if (!= closing null)))
      )
      (let place (. last place))
      (if (!= place null)
        (let overflow (call (. catalog overflow) place))
        (return-if (call filled overflow (. sense head) (call what node) (call what (. issue owner))) (if (!= overflow null)))
      )
    )
    (return (str "(" (. sense head) " …) takes nothing more, and " (call what node) " follows. Its shape is " (. sense shape) "."))
  )
  (fn-expr _ filled String
    (param text String)
    (param head String)
    (param item String)
    (param value String)
    (call (. value join) (call (. placed split) "{value}"))
    (where
      (lazy named (call (. head join) (call (. text split) "{head}")))
      (lazy doing (call (. (call (. "-do" join) (call (. head split) "-expr")) join) (call (. named split) "{do}")))
      (lazy placed (call (. item join) (call (. doing split) "{item}")))
    )
  )
  (fn-do _ misfit-message String
    (param node Index)
    (param place BrixPlace)
    (param spot String)
    (let advice (. place note))
    (let head (call head-text node))
    (if (!= head null)
      (let hint (call (. catalog hint) head place))
      (if (!= hint null)
        (= advice hint)
      )
    )
    (let text (str (call what node) " cannot be " spot ", which takes " (. place names) "."))
    (return (if-expr advice (str text " " advice) text))
  )
  (fn-do _ params (? BrixIssue)
    (param node Index)
    (let close (call (. tape close-of) node))
    (let item (+ node 1))
    (while (< item close)
      (let broken (call fits item (. catalog binder) "a parameter of the list"))
      (return-if broken (if broken))
      (blank)
      (= item (call (. tape after) item))
    )
    (return null)
  )
  (fn-expr _ unknown String
    (param head String)
    (param place BrixPlace)
    (case? (!= hint null)
      hint
    )
    (case? (and (> (. parts length) 1) (!= ([] parts 0) "") (!= ([] parts (- (. parts length) 1)) ""))
      (str "To call a method, write `(call (. " (call (. " " join) parts) ") …)`.")
    )
    (default
      (str "To call a function named " head ", write `(call " head " …)`.")
    )
    (where
      (lazy hint (call (. catalog hint) head place))
      (lazy parts (call List (call (. head split) ".")))
    )
  )
  (fn-expr _ what String
    (param node Index)
    (case? (call (. tape is-atom) node)
      (str "`" (call (. tape atom-text) node) "`")
    )
    (case? (call (. tape is-text) node)
      (str "the text " (call clipped (call inline-text node)))
    )
    (case? (!= head null)
      (str "(" head " …)")
    )
    (default
      (call clipped (call inline-text node))
    )
    (where
      (lazy head (call head-text node))
    )
  )
  (fn-do _ inline-text String
    (param node Index)
    (let text "")
    (let last (char " "))
    (let is-spaced false)
    (for (in char (call (. bytes slice-string) (..< (call (. tape start) node) (call (. tape end) node))))
      (if (or (== char (char " ")) (== char (char "\n")) (== char (char "\t")) (== char (char "\r")))
        (= is-spaced true)
        (continue)
      )
      (if (and is-spaced (!= char (char ")")) (!= last (char "(")) (!= (. text length) 0))
        (+= text (char " "))
      )
      (= is-spaced false)
      (+= text char)
      (= last char)
    )
    (return text)
  )
  (fn-expr _ head-text (? String)
    (param node Index)
    (case? (not (call (. tape is-open) node))
      null
    )
    (case? (or (>= first (call (. tape close-of) node)) (not (call (. tape is-atom) first)))
      null
    )
    (default
      (call (. tape atom-text) first)
    )
    (where
      (lazy first (+ node 1))
    )
  )
  (fn-expr _ is-headed Bool
    (param node Index)
    (param head (of ImmutableArray Byte))
    (case? (not (call (. tape is-open) node))
      false
    )
    (default
      (and (< first (call (. tape close-of) node)) (call (. tape is-atom) first) (call (. tape atom-matches) first head))
    )
    (where
      (lazy first (+ node 1))
    )
  )
  (fn-expr _ form-senses (? (list BrixSense))
    (param node Index)
    (case? (!= kind .none)
      (call (. catalog senses-of) kind size (== ([] bytes (- (+ start size) 1)) 63))
    )
    (case? (and (> size 1) (== lead 58) (!= ([] bytes (- (+ start size) 1)) 58))
      (. catalog label-senses)
    )
    (case? (and (> size 2) (== lead 47) (== ([] bytes (- (+ start size) 1)) 47))
      (. catalog infix-senses)
    )
    (default
      (call (. catalog senses) (call (. tape atom-text) first))
    )
    (where
      (lazy kind (as ([] (. heads data) node) BrixHead))
      (lazy first (+ node 1))
      (lazy start (call (. tape start) first))
      (lazy size (- (call (. tape end) first) start))
      (lazy lead ([] bytes start))
    )
  )
  (fn-expr _ clipped String
    (param text String)
    (if-expr (> (. text length) 28) (str ([] text (..< 0 28)) "…") text)
  )
  (fn-expr _ rank Index
    (param node Index)
    (param is-end _ (= false))
    (param is-weak _ (= false))
    (+ (* place 2) (if-expr is-weak 0 1))
    (where
      (lazy place (if-expr is-end (call (. tape end) node) (call (. tape start) node)))
    )
  )
  (fn-do _ taken (list BrixIssue)
    (param mark Size)
    (let found (list BrixIssue))
    (for (in position (..< mark (. issues length)))
      (+= found ([] issues position))
    )
    (call drop mark)
    (return found)
  )
  (fn-do _ drop _
    (param mark Size)
    (if (> (. issues length) mark)
      (-= ([] issues (..< mark (. issues length))))
    )
  )
)

(fn-do + brix-text-fits Bool (?! SexpError)
  (param text String)
  (param sense BrixSense)
  (let scratch (use (call Arena)))
  (let tape (call sexp-tape text scratch false))
  (let checker (call BrixChecker brix-catalog tape (call brix-form-heads tape scratch)))
  (return (call (. checker is-clean) 0 sense))
)
