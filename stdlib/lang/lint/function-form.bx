(import ./rule-context)
(import ./source)
(import ./symbols)
(import ./templates)
(import /lang/ast/ast)
(import /lang/ast/ast-children)
(import /lang/ast/ast-nodes)
(import /lang/ast/operator)
(import /lang/ast/row-range)
(import /stream/aggregate)
(import /stream/sort)

(type + PlanKind (is U32)
  (variant plan-open (= 0))
  (variant plan-prefix (= 1))
  (variant plan-leaf (= 2))
  (variant plan-choice (= 3))
)

(type + PlanStep (is Tuple)
  ; One step down a path of choices: the choice, the condition of the branch taken or none for the
  ; fallback, and the branch's place among the choice's branches from one.
  (blank)
  (prop + choice U32)
  (prop + condition SyntaxId)
  (prop + ordinal U32)
)

(type + Plan
  ; A way through a `do` function's body to its results: an open end that gives no result, a
  ; statement before the rest, a returned result, or a choice among branches and a fallback.
  (blank)
  (prop + kind PlanKind)
  (prop + statement SyntaxId)
  (prop + result SyntaxId)
  (prop + next (? Plan))
  (prop + choice U32)
  (prop + conditions (list SyntaxId))
  (prop + branches (list Plan))
  (prop + fallback (? Plan))
  (fn-do + This _
    (param kind PlanKind)
  )
)

(fn-expr + open-plan Plan
  (call Plan .plan-open)
)

(fn-do + prefix-plan Plan
  (param statement SyntaxId)
  (param next Plan)
  (let plan (call Plan .plan-prefix))
  (= (. plan statement) statement)
  (= (. plan next) next)
  (return plan)
)

(fn-do + leaf-plan Plan
  (param result SyntaxId)
  (param statement SyntaxId)
  (let plan (call Plan .plan-leaf))
  (= (. plan result) result)
  (= (. plan statement) statement)
  (return plan)
)

(fn-do + choice-plan Plan
  (param choice U32)
  (param conditions (list SyntaxId))
  (param branches (list Plan))
  (param fallback (? Plan))
  (let plan (call Plan .plan-choice))
  (= (. plan choice) choice)
  (= (. plan conditions) conditions)
  (= (. plan branches) branches)
  (= (. plan fallback) fallback)
  (return plan)
)

(fn-do + has-open-path Bool
  (param plan Plan)
  ; Whether some way through a plan ends without a result.
  (if (== (. plan kind) .plan-open)
    (return true)
  )
  (if (== (. plan kind) .plan-prefix)
    (return (call has-open-path (!! (. plan next))))
  )
  (if (== (. plan kind) .plan-leaf)
    (return false)
  )
  (for (in branch (. plan branches))
    (if (call has-open-path branch)
      (return true)
    )
  )
  (let fallback (. plan fallback))
  (return (or (not fallback) (call has-open-path fallback)))
)

(fn-do + replace-open-paths Plan
  (param plan Plan)
  (param continuation Plan)
  ; A plan whose open ends go on to `continuation`.
  (if (== (. plan kind) .plan-open)
    (return continuation)
  )
  (if (== (. plan kind) .plan-prefix)
    (return (call prefix-plan (. plan statement) (call replace-open-paths (!! (. plan next)) continuation)))
  )
  (if (== (. plan kind) .plan-leaf)
    (return plan)
  )
  (let branches (list Plan))
  (for (in branch (. plan branches))
    (+= branches (call replace-open-paths branch continuation))
  )
  (let replaced continuation)
  (let fallback (. plan fallback))
  (if fallback
    (= replaced (call replace-open-paths fallback continuation))
  )
  (return (call choice-plan (. plan choice) (. plan conditions) branches replaced))
)

(fn-do + normalized-plan Plan
  (param tree AST)
  (param plan Plan)
  ; A plan whose choices take in a fallback choice on the same subject, or on none, as more branches.
  (if (== (. plan kind) .plan-prefix)
    (return (call prefix-plan (. plan statement) (call normalized-plan tree (!! (. plan next)))))
  )
  (if (!= (. plan kind) .plan-choice)
    (return plan)
  )
  (let branches (list Plan))
  (for (in branch (. plan branches))
    (+= branches (call normalized-plan tree branch))
  )
  (let kept (? Plan) null)
  (let fallback (. plan fallback))
  (if fallback
    (= kept (call normalized-plan tree fallback))
  )
  (let normalized (call choice-plan (. plan choice) (. plan conditions) branches kept))
  (while true
    (let inner (. normalized fallback))
    (if (or (not inner) (!= (. inner kind) .plan-choice) (not (call can-flatten tree normalized inner)))
      (break)
    )
    (let conditions (list SyntaxId))
    (++= conditions (. normalized conditions))
    (++= conditions (. inner conditions))
    (let joined (list Plan))
    (++= joined (. normalized branches))
    (++= joined (. inner branches))
    (= normalized (call choice-plan (. normalized choice) conditions joined (. inner fallback)))
  )
  (return normalized)
)

(fn-expr + can-flatten Bool
  (param tree AST)
  (param outer Plan)
  (param fallback Plan)
  (case? (== (. outer-subject length) 0)
    (== (. fallback-subject length) 0)
  )
  (default
    (== outer-subject fallback-subject)
  )
  (where
    (lazy outer-subject (call choice-subject tree outer))
    (lazy fallback-subject (call choice-subject tree fallback))
  )
)

(fn-do + choice-subject String
  (param tree AST)
  (param plan Plan)
  ; The local every branch of a choice tests with `is` or `==`, or none.
  (let subject "")
  (for (in condition (. plan conditions))
    (let direct (call direct-subject tree condition))
    (if (or (== (. direct length) 0) (and (!= (. subject length) 0) (!= direct subject)))
      (return "")
    )
    (= subject direct)
  )
  (return subject)
)

(fn-do + direct-subject String
  (param tree AST)
  (param condition SyntaxId)
  (match? ([] (. tree nodes) (call guard-expression tree condition))
    (case (call .node-binary-expression row)
      (if (or (== (. row op) .is-op) (== (. row op) .equals-op))
        (match? ([] (. tree nodes) (. row lhs))
          (case (call .node-identifier left)
            (if (not (. left is-tracked))
              (return (. left name text))
            )
          )
        )
      )
    )
  )
  (return "")
)

(fn-expr + guard-expression SyntaxId
  (param tree AST)
  (param condition SyntaxId)
  (match ([] (. tree nodes) condition)
    (case (call .node-type-predicate row)
      (. row expr)
    )
    (default
      condition
    )
  )
)

(fn-do + after-prefixes Plan
  (param plan Plan)
  (let current plan)
  (while (== (. current kind) .plan-prefix)
    (= current (!! (. current next)))
  )
  (return current)
)

(fn-do + has-leading-assertions Bool
  (param tree AST)
  (param plan Plan)
  (let current plan)
  (while (== (. current kind) .plan-prefix)
    (if (is ([] (. tree nodes) (. current statement)) .node-assertion-syntax)
      (return true)
    )
    (= current (!! (. current next)))
  )
  (return false)
)

(type + Planner
  ; Builds the plan of a function's body, numbering its choices in the order they are made.
  (blank)
  (prop + tree AST)
  (prop _ choices U32)
  (fn-do + This _
    (param tree AST)
  )
  (fn-do _ next-choice U32
    (+= choices 1)
    (return choices)
  )
  (fn-do + plan-block (? Plan)
    (param block SyntaxId)
    ; The plan of a block, with its lazy locals first, or none where a statement has no plan.
    (let lazies (list SyntaxId))
    (let statements (list SyntaxId))
    (match ([] (. tree nodes) block)
      (case (call .node-block row)
        (for (in statement ([] (. tree children) (. row body)))
          (if (call is-lazy-local tree statement)
            (if (not (call has-local-value tree statement))
              (return null)
            )
            (+= lazies statement)
            (else
              (+= statements statement)
            )
          )
        )
      )
      (throw (call Panic "Expected a block"))
    )
    (let body (call plan-statements statements 0))
    (if (not body)
      (return null)
    )
    (let plan body)
    (for (in step (..< 0 (. lazies length)))
      (= plan (call prefix-plan ([] lazies (- (. lazies length) 1 step)) plan))
    )
    (return plan)
  )
  (fn-do _ plan-statements (? Plan)
    (param statements (list SyntaxId))
    (param index Index)
    (if (>= index (. statements length))
      (return (call open-plan))
    )
    (let statement ([] statements index))
    (match? ([] (. tree nodes) statement)
      (case (call .node-declare row)
        (if (or (. row is-pattern) (== (. row right) 0))
          (return null)
        )
        (let next (call plan-statements statements (+ index 1)))
        (if (not next)
          (return null)
        )
        (return (call prefix-plan statement next))
      )
      (case .node-assertion-syntax
        (let next (call plan-statements statements (+ index 1)))
        (if (not next)
          (return null)
        )
        (return (call prefix-plan statement next))
      )
      (case (call .node-return row)
        (if (not (call is-successful-value tree (. row expr)))
          (return null)
        )
        (return (call leaf-plan (. row expr) statement))
      )
      (case (call .node-return-if-true row)
        (if (not (call is-successful-value tree (. row expr)))
          (return null)
        )
        (let fallback (call plan-statements statements (+ index 1)))
        (if (not fallback)
          (return null)
        )
        (let conditions (list SyntaxId))
        (+= conditions (. row condition))
        (let branches (list Plan))
        (+= branches (call leaf-plan (. row expr) statement))
        (return (call choice-plan (call next-choice) conditions branches fallback))
      )
      (case .node-if-block
        (return (call plan-if statements index))
      )
    )
    (return null)
  )
  (fn-do _ plan-if (? Plan)
    (param statements (list SyntaxId))
    (param index Index)
    ; The plan of an `if` chain, whose branches that end without a result go on to what follows it.
    (let conditions (list SyntaxId))
    (let branches (list Plan))
    (let fallback (? Plan) null)
    (let branch ([] statements index))
    (while (!= branch 0)
      (match ([] (. tree nodes) branch)
        (case (call .node-if-block row)
          (if (not (is ([] (. tree nodes) (. row body)) .node-block))
            (return null)
          )
          (let branch-plan (call plan-block (. row body)))
          (if (not branch-plan)
            (return null)
          )
          (if (!= (. row condition) 0)
            (+= conditions (. row condition))
            (+= branches branch-plan)
            (else
              (= fallback branch-plan)
              (if (!= (. row next) 0)
                (return null)
              )
            )
          )
          (= branch (. row next))
        )
        (default
          (return null)
        )
      )
    )
    (blank)
    (let last (?? fallback (call open-plan)))
    (let open (call has-open-path last))
    (for (in each-plan branches)
      (= open (or open (call has-open-path each-plan)))
    )
    (if open
      (let continuation (call plan-statements statements (+ index 1)))
      (if (not continuation)
        (return null)
      )
      (let replaced (list Plan))
      (for (in each-plan branches)
        (+= replaced (call replace-open-paths each-plan continuation))
      )
      (= branches replaced)
      (= last (call replace-open-paths last continuation))
    )
    (return (call choice-plan (call next-choice) conditions branches last))
  )
)

(fn-expr + is-lazy-local Bool
  (param tree AST)
  (param id SyntaxId)
  (match ([] (. tree nodes) id)
    (case (call .node-declare row)
      (. row is-lazy)
    )
    (default
      false
    )
  )
)

(fn-expr + has-local-value Bool
  (param tree AST)
  (param id SyntaxId)
  (match ([] (. tree nodes) id)
    (case (call .node-declare row)
      (and (not (. row is-pattern)) (!= (. row right) 0))
    )
    (default
      false
    )
  )
)

(fn-expr + is-successful-value Bool
  (param tree AST)
  (param id SyntaxId)
  ; Whether a returned value is one that always succeeds as written: not optional, not caught.
  (and (!= id 0) (not (is ([] (. tree nodes) id) .node-optional-chain)) (not (is ([] (. tree nodes) id) .node-catch-expression)))
)

(fn-do + local-name String
  (param tree AST)
  (param id SyntaxId)
  ; The name a declaration of one local gives, or none.
  (match? ([] (. tree nodes) id)
    (case (call .node-declare row)
      (match? ([] (. tree nodes) (. row left))
        (case (call .node-type-capture capture)
          (return (call identifier-name tree (. capture id)))
        )
      )
    )
  )
  (return "")
)

(fn-do + local-display-name String
  (param source LintSource)
  (param tree AST)
  (param id SyntaxId)
  (param name String)
  ; The name of a local as written, where it is written as a plain name.
  (match? ([] (. tree nodes) id)
    (case (call .node-declare row)
      (match? ([] (. tree nodes) (. row left))
        (case (call .node-type-capture capture)
          (let text (call node-text source tree (. capture id)))
          (if (call is-plain-name text)
            (return text)
          )
        )
      )
    )
  )
  (return name)
)

(fn-do + is-plain-name Bool
  (param text String)
  (if (or (== (. text length) 0) (not (call is-name-start ([] text 0))))
    (return false)
  )
  (for (in char text)
    (if (and (not (call is-name-start char)) (not (and (>= char '0') (<= char '9'))) (!= char '-'))
      (return false)
    )
  )
  (return true)
)

(fn-expr + is-name-start Bool
  (param char Char)
  (or (and (>= char 'a') (<= char 'z')) (and (>= char 'A') (<= char 'Z')) (== char '_'))
)

(fn-expr + local-value SyntaxId
  (param tree AST)
  (param id SyntaxId)
  (match ([] (. tree nodes) id)
    (case (call .node-declare row)
      (. row right)
    )
    (default
      0
    )
  )
)

(fn-expr + is-direct-value Bool
  (param tree AST)
  (param id SyntaxId)
  ; Whether a value is written as an untracked name or a literal.
  (match ([] (. tree nodes) id)
    (case (call .node-identifier row)
      (not (. row is-tracked))
    )
    (case (call .node-integer-syntax row)
      (not (. row unit))
    )
    (case (call .node-float-syntax row)
      (not (. row unit))
    )
    (case .node-string-syntax
      true
    )
    (case .node-symbol
      true
    )
    (default
      false
    )
  )
)

(fn-do + is-proven-value Bool
  (param tree AST)
  (param id SyntaxId)
  ; Whether a value is written as one that cannot fail: a direct value, or a tuple or list of them.
  (if (call is-direct-value tree id)
    (return true)
  )
  (match? ([] (. tree nodes) id)
    (case (call .node-tuple-syntax row)
      (for (in item ([] (. tree children) (. row items)))
        (if (not (call is-proven-value tree item))
          (return false)
        )
      )
      (return true)
    )
    (case (call .node-list-syntax row)
      (for (in item ([] (. tree children) (. row items)))
        (if (not (call is-proven-value tree item))
          (return false)
        )
      )
      (return true)
    )
  )
  (return false)
)

(type + PlanContext
  ; An expression a plan evaluates on a path: a guard or result, which decides what is returned, or
  ; an assertion's condition or exception, which does not.
  (blank)
  (prop + affects-certainty Bool)
  (prop + node SyntaxId)
  (prop + path (list PlanStep))
  (fn-do + This _
    (param affects-certainty Bool)
    (param node SyntaxId)
    (param path (list PlanStep))
  )
)

(type + PlanDependency
  ; A local a multi-result function declares, the paths it is declared on and where its readers
  ; are, and so the path it belongs on as a lazy local.
  (blank)
  (prop + node SyntaxId)
  (prop + name String)
  (prop + display String)
  (prop + occurrences (list (list PlanStep)))
  (prop + contexts (list PlanContext))
  (prop + dependents (list Index))
  (prop + placement (list PlanStep))
  (fn-do + This _
    (param node SyntaxId)
    (param name String)
    (param display String)
  )
)

(type + MultiResult
  ; A `do` function with several returned results that one ordered match could give.
  (blank)
  (prop + dependencies (list PlanDependency))
  (prop + contexts (list PlanContext))
  (prop + leading-assertions Bool)
  (prop + outer-match String)
  (prop + result-paths Int)
  (fn-do + This _)
)

(type + PlanReader
  ; Reads the locals, expressions and results of a plan along every path through it.
  (blank)
  (prop + source LintSource)
  (prop + tree AST)
  (prop + dependencies (list PlanDependency))
  (prop + by-node (map SyntaxId Index))
  (prop + by-name (map String Index))
  (prop + contexts (list PlanContext))
  (prop + returns (map SyntaxId Bool))
  (prop + result-paths Int)
  (prop + invalid Bool)
  (fn-do + This _
    (param source LintSource)
    (param tree AST)
  )
  (fn-do + visit _
    (param plan Plan)
    (param path (list PlanStep))
    (if (== (. plan kind) .plan-open)
      (= invalid true)
      (return)
    )
    (if (== (. plan kind) .plan-prefix)
      (call visit-prefix (. plan statement) path)
      (call visit (!! (. plan next)) path)
      (return)
    )
    (if (== (. plan kind) .plan-leaf)
      (+= result-paths 1)
      (= ([] returns (. plan statement)) true)
      (+= contexts (call PlanContext true (. plan result) path))
      (return)
    )
    (blank)
    (for (in position (..< 0 (. plan branches length)))
      (let condition ([] (. plan conditions) position))
      (+= contexts (call PlanContext true (call guard-expression tree condition) path))
      (let step (call PlanStep (. plan choice) condition (as (+ position 1) U32)))
      (call visit ([] (. plan branches) position) (call extended path step))
    )
    (let fallback (. plan fallback))
    (if fallback
      (let ordinal (+ (. plan branches length) 1))
      (call visit fallback (call extended path (call PlanStep (. plan choice) 0 (as ordinal U32))))
    )
  )
  (fn-do _ visit-prefix _
    (param statement SyntaxId)
    (param path (list PlanStep))
    (match? ([] (. tree nodes) statement)
      (case (call .node-assertion-syntax row)
        (if (!= (. row condition) 0)
          (+= contexts (call PlanContext false (. row condition) path))
        )
        (+= contexts (call PlanContext false (. row exception) path))
        (return)
      )
    )
    (blank)
    (let name (call local-name tree statement))
    (if (or (== (. name length) 0) (== (call local-value tree statement) 0))
      (= invalid true)
      (return)
    )
    (let known ([] by-node statement))
    (if (!= known null)
      (+= (. ([] dependencies known) occurrences) path)
      (return)
    )
    (let duplicate ([] by-name name))
    (if (!= duplicate null)
      (= invalid true)
      (return)
    )
    (let dependency (call PlanDependency statement name (call local-display-name source tree statement name)))
    (+= (. dependency occurrences) path)
    (= ([] by-node statement) (. dependencies length))
    (= ([] by-name name) (. dependencies length))
    (+= dependencies dependency)
  )
)

(fn-do + extended (list PlanStep)
  (param path (list PlanStep))
  (param step PlanStep)
  (let longer (list PlanStep))
  (++= longer path)
  (+= longer step)
  (return longer)
)

(fn-do + referenced-locals (list String)
  (param tree AST)
  (param id SyntaxId)
  (param known (map String Index))
  ; The locals in `known` an expression reads, in the order first read, apart from reads inside a
  ; declaration, a function or a `do` block within it.
  (let names (list String))
  (let seen (map String Bool))
  (call gather-referenced tree id known false seen names)
  (return names)
)

(fn-do _ gather-referenced _
  (param tree AST)
  (param id SyntaxId)
  (param known (map String Index))
  (param inside Bool)
  (param seen (map String Bool))
  (param names (list String))
  (if (== id 0)
    (return)
  )
  (match? ([] (. tree nodes) id)
    (case (call .node-identifier row)
      (let name (. row name text))
      (if (and (not inside) (!= ([] known name) null) (not ([] seen name)))
        (= ([] seen name) true)
        (+= names name)
      )
    )
  )
  (let hides (or inside (call hides-locals tree id)))
  (for (in child (call (. tree children-of) id))
    (call gather-referenced tree child known hides seen names)
  )
)

(fn-expr + hides-locals Bool
  (param tree AST)
  (param id SyntaxId)
  (match ([] (. tree nodes) id)
    (case .node-declare
      true
    )
    (case .node-function-syntax
      true
    )
    (case .node-do-block
      true
    )
    (case .node-do-task-block
      true
    )
    (case .node-do-finally-block
      true
    )
    (default
      false
    )
  )
)

(fn-do + common-path (list PlanStep)
  (param paths (list (list PlanStep)))
  ; The steps every path shares from its start.
  (let common (list PlanStep))
  (if (== (. paths length) 0)
    (return common)
  )
  (++= common ([] paths 0))
  (for (in position (..< 1 (. paths length)))
    (let path ([] paths position))
    (let shared 0)
    (while (and (< shared (. common length)) (< shared (. path length)) (call same-step ([] common shared) ([] path shared)))
      (+= shared 1)
    )
    (let kept (list PlanStep))
    (for (in index (..< 0 shared))
      (+= kept ([] common index))
    )
    (= common kept)
  )
  (return common)
)

(fn-do + path-starts-with Bool
  (param path (list PlanStep))
  (param prefix (list PlanStep))
  (for (in index (..< 0 (. prefix length)))
    (if (or (>= index (. path length)) (not (call same-step ([] prefix index) ([] path index))))
      (return false)
    )
  )
  (return true)
)

(fn-expr + same-step Bool
  (param left PlanStep)
  (param right PlanStep)
  (and (== (. left choice) (. right choice)) (== (. left ordinal) (. right ordinal)))
)

(fn-do + multi-result (? MultiResult)
  (param source LintSource)
  (param tree AST)
  (param function ASTFunction)
  ; The multi-result form of a `do` function's body, or none where its paths do not all end in a
  ; result, it returns fewer than two, or a local cannot be placed on the paths that read it.
  (let planner (call Planner tree))
  (let raw (call (. planner plan-block) (. function body)))
  (if (or (not raw) (call has-open-path raw))
    (return null)
  )
  (let plan (call normalized-plan tree raw))
  (let outer (call after-prefixes plan))
  (if (!= (. outer kind) .plan-choice)
    (return null)
  )
  (blank)
  (let reader (call PlanReader source tree))
  (let empty (list PlanStep))
  (call (. reader visit) plan empty)
  (if (or (. reader invalid) (< (. reader returns length) 2))
    (return null)
  )
  (blank)
  (let dependencies (. reader dependencies))
  (for (in context (. reader contexts))
    (for (in name (call referenced-locals tree (. context node) (. reader by-name)))
      (+= (. ([] dependencies (!! ([] (. reader by-name) name))) contexts) context)
    )
  )
  (for (in position (..< 0 (. dependencies length)))
    (let value (call local-value tree (. ([] dependencies position) node)))
    (for (in name (call referenced-locals tree value (. reader by-name)))
      (let required (!! ([] (. reader by-name) name)))
      (if (== required position)
        (return null)
      )
      (if (not (call has-index (. ([] dependencies required) dependents) position))
        (+= (. ([] dependencies required) dependents) position)
      )
    )
  )
  (blank)
  (let finder (call PathFinder dependencies))
  (for (in dependency dependencies)
    (let declared (call common-path (. dependency occurrences)))
    (= (. dependency placement) (call common-path (call (. finder paths-of) dependency)))
    (if (not (call path-starts-with (. dependency placement) declared))
      (return null)
    )
  )
  (if (. finder invalid)
    (return null)
  )
  (blank)
  (let result (call MultiResult))
  (= (. result dependencies) (call sorted-by-place tree dependencies))
  (= (. result contexts) (. reader contexts))
  (= (. result leading-assertions) (call has-leading-assertions tree plan))
  (= (. result outer-match) (if-expr (!= (. (call choice-subject tree outer) length) 0) "subject" "bare"))
  (= (. result result-paths) (. reader result-paths))
  (return result)
)

(fn-do + has-index Bool
  (param items (list Index))
  (param item Index)
  (for (in found items)
    (if (== found item)
      (return true)
    )
  )
  (return false)
)

(fn-do + sorted-by-place (list PlanDependency)
  (param tree AST)
  (param dependencies (list PlanDependency))
  ; Locals in the order they are declared, keeping the order of any declared at one place.
  (let sorted (list PlanDependency))
  (for (in dependency dependencies)
    (let place (. ([] (. tree nodes loc) (. dependency node)) begin))
    (let position (. sorted length))
    (while (and (> position 0) (call is-before place (. ([] (. tree nodes loc) (. ([] sorted (- position 1)) node)) begin)))
      (-= position 1)
    )
    (call (. sorted insert) dependency position)
  )
  (return sorted)
)

(fn-expr + is-before Bool
  (param left TokenLocation)
  (param right TokenLocation)
  (or (< (. left line) (. right line)) (and (== (. left line) (. right line)) (< (. left column) (. right column))))
)

(type + PathFinder
  ; The paths on which each local is read, directly or through the locals that read it.
  (blank)
  (prop + dependencies (list PlanDependency))
  (prop + invalid Bool)
  (prop _ found (map Index (list (list PlanStep))))
  (prop _ visiting (map Index Bool))
  (fn-do + This _
    (param dependencies (list PlanDependency))
  )
  (fn-expr + paths-of (list (list PlanStep))
    (param dependency PlanDependency)
    (call paths-at (call index-of dependency))
  )
  (fn-do _ index-of Index
    (param dependency PlanDependency)
    (for (in position (..< 0 (. dependencies length)))
      (if (== (. ([] dependencies position) node) (. dependency node))
        (return position)
      )
    )
    (throw (call Panic "Expected a local of the plan"))
  )
  (fn-do _ paths-at (list (list PlanStep))
    (param position Index)
    (let cached ([] found position))
    (if cached
      (return cached)
    )
    (let paths (list (list PlanStep)))
    (if ([] visiting position)
      (= invalid true)
      (return paths)
    )
    (= ([] visiting position) true)
    (let dependency ([] dependencies position))
    (for (in context (. dependency contexts))
      (+= paths (. context path))
    )
    (for (in dependent (. dependency dependents))
      (++= paths (call paths-at dependent))
    )
    (if (== (. paths length) 0)
      (++= paths (. dependency occurrences))
    )
    (= ([] visiting position) false)
    (= ([] found position) paths)
    (return paths)
  )
)

(fn-do + lint-expression-functions _
  (param source LintSource)
  (param tree AST)
  (param context RuleContext)
  (let attached (call attached-nodes tree))
  (for (in id (..< 1u32 (. tree nodes length)))
    (if (not ([] attached id))
      (continue)
    )
    (match? ([] (. tree nodes) id)
      (case (call .node-function-syntax row)
        (call lint-expression-function source tree (as id SyntaxId) row context)
      )
    )
  )
)

(fn-do _ lint-expression-function _
  (param source LintSource)
  (param tree AST)
  (param id SyntaxId)
  (param function ASTFunction)
  (param context RuleContext)
  (if (or (not (call is-expression-function-kind tree function)) (not (is ([] (. tree nodes) (. function body)) .node-block)))
    (return)
  )
  (if (!= (. (call text-builder source tree function) length) 0)
    (return)
  )
  (let place (call imperative-token-place tree id))
  (blank)
  (let dependencies (list SyntaxId))
  (let result (call single-result tree function dependencies))
  (if (!= result 0)
    (let late (call eager-read-crosses-assertion tree function dependencies null))
    (let status
      (scope (if-expr has-late "review" (call single-result-status tree dependencies result))
        (lazy has-late (!= (. late length) 0))
      )
    )
    (call (. context report) (call single-result-message tree late status) (. place line) (. place column) status)
    (return)
  )
  (blank)
  (let multi (call multi-result source tree function))
  (if (not multi)
    (return)
  )
  (let found multi)
  (let locals (list SyntaxId))
  (for (in dependency (. found dependencies))
    (+= locals (. dependency node))
  )
  (let late (call eager-read-crosses-assertion tree function locals found))
  (let status (if-expr (!= (. late length) 0) "review" (call multi-result-status tree found)))
  (let message (call multi-result-message source tree found status late))
  (call (. context report) message (. place line) (. place column) status)
)

(fn-do + has-expression-form Bool
  (param source LintSource)
  (param tree AST)
  (param function ASTFunction)
  (if (or (not (call is-expression-function-kind tree function)) (not (is ([] (. tree nodes) (. function body)) .node-block)))
    (return false)
  )
  (let dependencies (list SyntaxId))
  (return (or (!= (call single-result tree function dependencies) 0) (!= (call multi-result source tree function) null)))
)

(fn-expr + is-expression-function-kind Bool
  (param tree AST)
  (param function ASTFunction)
  ; Whether a function is a plain `do` function that could be written as an expression.
  (and is-plain (not (. function is-setter)) (not is-constructor) (== (. function pattern) 0))
  (where
    (lazy is-plain (and (. function imperative) (== (. function compilation-effects) .none)))
    (lazy is-constructor (and (!= (. function names count) 0) (== first-name "This")))
    (lazy first-name (. ([] (. tree atoms) (. function names start)) text))
  )
)

(fn-do + single-result SyntaxId
  (param tree AST)
  (param function ASTFunction)
  (param dependencies (list SyntaxId))
  ; The value a `do` function returns last, where everything before is assertions and locals with
  ; values, which it adds to `dependencies`; or none.
  (let statements
    (match ([] (. tree nodes) (. function body))
      (case (call .node-block row)
        (. row body)
      )
      (throw (call Panic "Expected a block"))
    )
  )
  (if (== (. statements count) 0)
    (return 0)
  )
  (let last ([] (. tree children) (- (+ (. statements start) (. statements count)) 1)))
  (let result
    (match ([] (. tree nodes) last)
      (case (call .node-return row)
        (. row expr)
      )
      (default
        0
      )
    )
  )
  (if (or (== result 0) (is ([] (. tree nodes) result) .node-catch-expression))
    (return 0)
  )
  (for (in position (..< 0 (- (. statements count) 1)))
    (let statement ([] (. tree children) (+ (. statements start) position)))
    (if (is ([] (. tree nodes) statement) .node-assertion-syntax)
      (continue)
    )
    (match ([] (. tree nodes) statement)
      (case (call .node-declare row)
        (if (or (. row is-pattern) (== (. row right) 0))
          (return 0)
        )
        (+= dependencies statement)
      )
      (default
        (return 0)
      )
    )
  )
  (return result)
)

(fn-do + single-result-status String
  (param tree AST)
  (param dependencies (list SyntaxId))
  (param result SyntaxId)
  (for (in dependency dependencies)
    (if (not (call is-local-value-proven tree dependency))
      (return "review")
    )
  )
  (return (if-expr (call is-proven-value tree result) "actionable" "review"))
)

(fn-expr + is-local-value-proven Bool
  (param tree AST)
  (param id SyntaxId)
  ; Whether moving a local to `..` keeps its value: a lazy one proven, an eager one direct.
  (if-expr (call is-lazy-local tree id) (call is-proven-value tree value) (call is-direct-value tree value))
  (where
    (lazy value (call local-value tree id))
  )
)

(fn-expr + single-result-message String
  (param tree AST)
  (param late (list SyntaxId))
  (param status String)
  (case? (!= (. late length) 0)
    (str review-head "; " (call late-clause late-names) ".")
  )
  (case? (== status "actionable")
    (str actionable-head " " actionable-tail)
  )
  (default
    (str review-head "; " review-tail)
  )
  (where
    (lazy actionable-head "Prefer an expression function: remove `do` and the explicit return,")
    (lazy actionable-tail "keep assertions first, then the value, then `..` lazy dependencies.")
    (lazy review-head "Review this single-result `do` function for expression form")
    (lazy review-tail (str "keep `do` only when its value is an effect's result or " misplaced))
    (lazy misplaced "a lazy's first read would come in the wrong place.")
    (lazy late-names (call listed (*> late (str "`" (call local-name tree each) "`"))))
  )
)

(fn-expr + late-clause String
  (param names String)
  (str "as `..` lazies, " names " would first be read after assertion work that makes calls, so " check)
  (where
    (lazy check "check that each still reads the value it should")
  )
)

(fn-do + multi-result-status String
  (param tree AST)
  (param found MultiResult)
  (for (in dependency (. found dependencies))
    (if (not (call is-local-value-proven tree (. dependency node)))
      (return "review")
    )
  )
  (for (in context (. found contexts))
    (if (and (. context affects-certainty) (not (call is-proven-value tree (. context node))))
      (return "review")
    )
  )
  (return "actionable")
)

(fn-do + multi-result-message String
  (param source LintSource)
  (param tree AST)
  (param found MultiResult)
  (param status String)
  (param late (list SyntaxId))
  ; The advice for a multi-result function: the match its results become, where its locals go, and
  ; what to check before removing `do`.
  (let paths (. found result-paths))
  (let shape (. found outer-match))
  (let prefix (str "Prefer an expression function: replace " paths " successful return paths with one "))
  (+= prefix (str "ordered " shape " match"))
  (if (!= status "actionable")
    (= prefix (str "Review this multi-result `do` function for expression form: its " paths " successful "))
    (+= prefix (str "return paths can become one ordered " shape " match"))
  )
  (blank)
  (let clauses (list String))
  (if (. found leading-assertions)
    (+= clauses "keep dominating assertions before the match")
  )
  (blank)
  (let function-level (list PlanDependency))
  (for (in dependency (. found dependencies))
    (if (== (. dependency placement length) 0)
      (+= function-level dependency)
    )
  )
  (if (!= (. function-level length) 0)
    (+= clauses (str "move " (call listed-names function-level) " to function-level `..` lazies"))
  )
  (blank)
  (let keys (list String))
  (let groups (map String (list PlanDependency)))
  (for (in dependency (. found dependencies))
    (if (== (. dependency placement length) 0)
      (continue)
    )
    (let key (call (. "/" join) (*> (. dependency placement) (str (. each choice) ":" (. each ordinal)))))
    (if (not ([] groups key))
      (let fresh (list PlanDependency))
      (= ([] groups key) fresh)
      (+= keys key)
    )
    (+= (!! ([] groups key)) dependency)
  )
  (for (in key keys)
    (let group (!! ([] groups key)))
    (let kind (if-expr (== (. group length) 1) "a `..` lazy" "`..` lazies"))
    (let location (call path-description source tree (. ([] group 0) placement)))
    (+= clauses (str "place " (call listed-names group) " as " kind " in " location))
  )
  (blank)
  (if (== status "review")
    (let crossing (list PlanDependency))
    (let eager (list PlanDependency))
    (for (in dependency (. found dependencies))
      (if (!= (call (. late find) (. dependency node)) null)
        (+= crossing dependency)
        (else-if (not (call is-lazy-local tree (. dependency node)))
          (+= eager dependency)
        )
      )
    )
    (if (!= (. crossing length) 0)
      (+= clauses (call late-clause (call listed-names crossing)))
    )
    (if (!= (. eager length) 0)
      (let names (call listed-names eager))
      (let clause (str "verify eager order and effects: moving " names " to `..` defers evaluation "))
      (+= clause "and failure until first use")
      (+= clauses clause)
    )
    (if (and (== (. crossing length) 0) (== (. eager length) 0))
      (+= clauses "verify guard and result evaluation order and effects before removing `do`")
    )
  )
  (if (== (. clauses length) 0)
    (+= clauses "preserve branch order and nesting")
  )
  (let joined (call (. "; " join) clauses))
  (return (str prefix "; " joined "."))
)

(fn-expr + listed-names String
  (param dependencies (list PlanDependency))
  (call listed (*> dependencies (str "`" (. each display) "`")))
)

(fn-expr + listed String
  (param names (list String))
  (case? (< (. names length) 2)
    (if-expr (== (. names length) 1) ([] names 0) "")
  )
  (case? (== (. names length) 2)
    (str ([] names 0) " and " ([] names 1))
  )
  (default
    (str leading ", and " ([] names (- (. names length) 1)))
  )
  (where
    (lazy leading (call (. ", " join) ([] names (... _ (- (. names length) 1)))))
  )
)

(fn-expr + path-description String
  (param source LintSource)
  (param tree AST)
  (param path (list PlanStep))
  ; A path of choices as the conditions of the branches it takes.
  (call (. " then " join) (in (call step-description source tree each) path))
)

(fn-expr _ step-description String
  (param source LintSource)
  (param tree AST)
  (param step PlanStep)
  (if-expr is-fallback (str "choice " (. step ordinal) " (fallback)") (str "choice " (. step ordinal) " (`" summary "`)"))
  (where
    (lazy summary (call condensed (call node-text source tree (call guard-expression tree (. step condition)))))
    (lazy is-fallback (== (. step condition) 0))
  )
)

(fn-do + condensed String
  (param text String)
  ; Text on one line, with each run of spaces one space and backticks as quotes.
  (let result String)
  (let pending false)
  (for (in char text)
    (if (call is-space-char char)
      (= pending true)
      (continue)
    )
    (if (and pending (!= (. result length) 0))
      (+= result " ")
    )
    (= pending false)
    (+= result (if-expr (== char '`') "'" (str char)))
  )
  (return result)
)

(fn-do + eager-read-crosses-assertion (list SyntaxId)
  (param tree AST)
  (param function ASTFunction)
  (param dependencies (list SyntaxId))
  (param multi (? MultiResult))
  ; The eager locals that, made lazy, would first be read after an assertion whose condition calls or
  ; assigns, and so could read a different value.
  (let declarations (map String SyntaxId))
  (for (in dependency dependencies)
    (= ([] declarations (call local-name tree dependency)) dependency)
  )
  (let stable (map String Bool))
  (= ([] stable "true") true)
  (= ([] stable "false") true)
  (= ([] stable "null") true)
  (= ([] stable "this") true)
  (for (in arg ([] (. tree children) (. function args)))
    (match? ([] (. tree nodes) arg)
      (case (call .node-argument-decl row)
        (= ([] stable (call declared-name tree (. row pattern))) true)
      )
    )
  )
  (blank)
  (let snapshots (list SyntaxId))
  (for (in dependency dependencies)
    (let value (call local-value tree dependency))
    (let visiting (map String Bool))
    (if (and (not (call is-lazy-local tree dependency)) (!= value 0))
      (if (not (call is-stable-value tree value stable declarations visiting))
        (+= snapshots dependency)
      )
    )
  )
  (let late (list SyntaxId))
  (if (!= (. snapshots length) 0)
    (let read (map String Bool))
    (call note-late-reads tree (. function body) false snapshots multi declarations read late)
  )
  (return late)
)

(fn-do + is-stable-value Bool
  (param tree AST)
  (param id SyntaxId)
  (param stable (map String Bool))
  (param declarations (map String SyntaxId))
  (param visiting (map String Bool))
  (match? ([] (. tree nodes) id)
    (case (call .node-identifier row)
      (if (. row is-tracked)
        (return false)
      )
      (let name (. row name text))
      (if ([] stable name)
        (return true)
      )
      (let declaration ([] declarations name))
      (if (or (== declaration null) ([] visiting name))
        (return false)
      )
      (let value (call local-value tree declaration))
      (if (== value 0)
        (return false)
      )
      (= ([] visiting name) true)
      (let result (call is-stable-value tree value stable declarations visiting))
      (= ([] visiting name) false)
      (return result)
    )
  )
  (return (call is-direct-value tree id))
)

(fn-do _ note-late-reads _
  (param tree AST)
  (param id SyntaxId)
  (param nested Bool)
  (param snapshots (list SyntaxId))
  (param multi (? MultiResult))
  (param declarations (map String SyntaxId))
  (param read (map String Bool))
  (param late (list SyntaxId))
  (if (== id 0)
    (return)
  )
  (let condition (if-expr nested 0 (call checked-condition tree id)))
  (if (!= condition 0)
    (for (in snapshot snapshots)
      (let name (call local-name tree snapshot))
      (let visiting (map String Bool))
      (if (and (not ([] read name)) (call reads-local tree condition name declarations visiting))
        (= ([] read name) true)
      )
    )
    (match? ([] (. tree nodes) id)
      (case (call .node-assertion-syntax row)
        (if (call calls-or-assigns tree condition)
          (for (in snapshot snapshots)
            (if (and (not ([] read (call local-name tree snapshot))) (== (call (. late find) snapshot) null))
              (if (call follows-snapshot tree id row snapshot multi)
                (+= late snapshot)
              )
            )
          )
        )
      )
    )
  )
  (let inner (or nested (call is-function-node tree id)))
  (for (in child (call (. tree children-of) id))
    (call note-late-reads tree child inner snapshots multi declarations read late)
  )
)

(fn-expr + checked-condition SyntaxId
  (param tree AST)
  (param id SyntaxId)
  (match ([] (. tree nodes) id)
    (case (call .node-assertion-syntax row)
      (. row condition)
    )
    (case (call .node-return-if-true row)
      (. row condition)
    )
    (default
      0
    )
  )
)

(fn-do + reads-local Bool
  (param tree AST)
  (param id SyntaxId)
  (param name String)
  (param declarations (map String SyntaxId))
  (param visiting (map String Bool))
  (if (== id 0)
    (return false)
  )
  (match? ([] (. tree nodes) id)
    (case (call .node-identifier row)
      (let found (. row name text))
      (if (== found name)
        (return true)
      )
      (let declaration ([] declarations found))
      (if (and (!= declaration null) (not ([] visiting found)))
        (= ([] visiting found) true)
        (let through
          (call reads-local
            (block
              (arg tree)
              (arg (call local-value tree declaration))
              (arg name)
              (arg declarations)
              (arg visiting)
            )
          )
        )
        (= ([] visiting found) false)
        (if through
          (return true)
        )
      )
    )
  )
  (for (in child (call (. tree children-of) id))
    (if (call reads-local tree child name declarations visiting)
      (return true)
    )
  )
  (return false)
)

(fn-do + follows-snapshot Bool
  (param tree AST)
  (param id SyntaxId)
  (param assertion ASTAssertion)
  (param snapshot SyntaxId)
  (param multi (? MultiResult))
  (if (not (call is-before (. ([] (. tree nodes loc) snapshot) begin) (. ([] (. tree nodes loc) id) begin)))
    (return false)
  )
  (if (not multi)
    (return true)
  )
  (let found multi)
  (for (in context (. found contexts))
    (if (and (!= (. context node) (. assertion condition)) (!= (. context node) (. assertion exception)))
      (continue)
    )
    (for (in dependency (. found dependencies))
      (if (== (. dependency node) snapshot)
        (for (in path (. dependency occurrences))
          (if (call path-starts-with (. context path) path)
            (return true)
          )
        )
      )
    )
    (break)
  )
  (return false)
)

(fn-do + calls-or-assigns Bool
  (param tree AST)
  (param id SyntaxId)
  (if (== id 0)
    (return false)
  )
  (if (or (is ([] (. tree nodes) id) .node-call-expression) (is ([] (. tree nodes) id) .node-assign))
    (return true)
  )
  (for (in child (call (. tree children-of) id))
    (if (call calls-or-assigns tree child)
      (return true)
    )
  )
  (return false)
)

(fn-expr + imperative-token-place TokenLocation
  (param tree AST)
  (param id SyntaxId)
  (call TokenLocation (+ (. begin line) 1) (+ (. begin column) 1))
  (where
    (lazy begin (. ([] (. tree nodes loc) id) begin))
  )
)

(fn-expr + is-word-char Bool
  (param char Char)
  (or (call is-name-start char) (and (>= char '0') (<= char '9')))
)
