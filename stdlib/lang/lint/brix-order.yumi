./brix-source
./format
./method-order
./source
/core/table
/data/source-tree
/lang/ast/ast
/lang/ast/ast-children
/lang/ast/ast-nodes
/lang/ast/operator
/lang/ast/row-range
/lang/brix/layout
/stream/aggregate
/stream/sort

━━━━━━━━━━━━━━━━━━━━
+ do brix-ordered String?
    - source LintSource
    - tree AST
    - index MethodOrderIndex?

. read = read-brix-source(source)
=? null if !read
. brix = use read
= BrixOrder(brix, tree, index).ordered-text()

━━━━━━━━━━━━━━━━━━━━
+ BrixOrder

+ brix BrixSource
+ tree AST
+ index MethodOrderIndex?
_ store SourceStore
_ layout BrixLayout
_ module-order [String = OrderInfo]
_ type-order [String = OrderInfo]
_ sheet-order [String = OrderInfo]
_ sheet-rule-order [String = OrderInfo]
_ rule-order [String = OrderInfo]
_ primary-names [String = Bool]

────────────────────
+ This
    - brix
    - tree
    - index

.. store = brix.store
.. layout = BrixLayout(brix.store)
.. module-order = module-order-spec()
.. type-order = type-member-order-spec()
.. sheet-order = style-sheet-member-order-spec()
.. sheet-rule-order = style-sheet-rule-body-order-spec()
.. rule-order = style-rule-body-order-spec()
.. primary-names = primary-type-names(brix.source.path)

────────────────────
+ do ordered-text String

. roots [ImmutableTableRow'SourceNode] = store.node(each) in brix.roots
= brix-file-text(store, arranged(roots, top-level-statements(tree), .sequence-module, 0))

────────────────────
_ do arranged [ImmutableTableRow'SourceNode]
    - members [ImmutableTableRow'SourceNode]
    - ids [SyntaxId]
    - kind SequenceKind
    - container U32

. positions [U32 = Index]
for position in 0 .. < members.length
    positions[members[position].id] = position
. rebuilt [ImmutableTableRow'SourceNode]
rebuilt ++= members
. places [SyntaxId = Index]
for id in ids
    . place = member-of(id, container, positions)
    if place != null
        places[id] = place
        . inner = nested(members[place], id, kind)
        if inner
            rebuilt[place] = inner
= reordered(members, rebuilt, ids, places, kind) ?? rebuilt

────────────────────
_ do member-of Index?
    - id SyntaxId
    - container U32
    - positions [U32 = Index]

. begin = tree.nodes.loc[id].begin
. found = brix.form-at(begin.line, begin.column)
=? null if !found
. current = found
. parent = brix.parent-of(current)
while parent && parent.id != container
    current = parent
    parent = brix.parent-of(current)
=? null if !parent && container != 0
= positions[current.id]

────────────────────
_ do nested ImmutableTableRow'SourceNode?
    - item ImmutableTableRow'SourceNode
    - id SyntaxId
    - kind SequenceKind

. is-module = kind == .sequence-module
. in-sheet = kind == .sequence-sheet || kind == .sequence-sheet-rule-body
. is-rule-body = kind == .sequence-sheet-rule-body || kind == .sequence-rule-body
match? tree.nodes[id]
    | .node-class-block(row)
        =? null if !is-module
        = within
            - item
            - tree.children[row.members]
            - if row.is-style-sheet then .sequence-sheet else .sequence-type
    | .node-style-sheet-extension(row)
        =? null if !is-module
        = within(item, tree.children[row.body], .sequence-sheet)
    | .node-extension(row)
        =? null if !is-module
        = within(item, tree.children[row.body], .sequence-type)
    | .node-rule-syntax(row)
        =? null if is-module
        = within-block(item, row.body, in-sheet)
    | .node-style-when(row)
        =? null if !is-rule-body
        = within-block(item, row.body, in-sheet)
= null

────────────────────
_ do within-block ImmutableTableRow'SourceNode?
    - item ImmutableTableRow'SourceNode
    - body SyntaxId
    - in-sheet Bool

=? null if body == 0
match? tree.nodes[body]
    | .node-block(block)
        = within
            - item
            - tree.children[block.body]
            - if in-sheet then .sequence-sheet-rule-body else .sequence-rule-body
= null

────────────────────
_ do within ImmutableTableRow'SourceNode?
    - item ImmutableTableRow'SourceNode
    - ids [SyntaxId]
    - kind SequenceKind

=? null if ids.length == 0
. found = layout.header-count(item)
=? null if found == null
. count = found as Index
. items = store.listed(item)
. members [ImmutableTableRow'SourceNode]
for position in count .. < items.length
    members += items[position]
. made = arranged(members, ids, kind, item.id)
=? null if is-same(made, members)
. whole [ImmutableTableRow'SourceNode]
for position in 0 .. < count
    whole += items[position]
whole ++= made
= store.with-items(item, whole)

────────────────────
_ do reordered [ImmutableTableRow'SourceNode]?
    - members [ImmutableTableRow'SourceNode]
    - rebuilt [ImmutableTableRow'SourceNode]
    - ids [SyntaxId]
    - places [SyntaxId = Index]
    - kind SequenceKind

. order = order-of(kind)
. found = anchors-of(members, ids, places, kind)
=? null if !found || found.length == 0
. chunks = chunks-of(members, found, order)
. output [ImmutableTableRow'SourceNode]
for slot in 0 .. < chunks[0].start
    output += rebuilt[slot]
. index Index = 0
while index < chunks.length
    if is-sortable(chunks[index], order)
        . first = index
        while index < chunks.length && is-sortable(chunks[index], order)
            index += 1
        output ++= region(members, rebuilt, chunks[first .. < index])
    else
        for slot in chunks[index].start .. < chunks[index].end
            output += rebuilt[slot]
        index += 1
for slot in chunks[chunks.length - 1].end .. < members.length
    output += rebuilt[slot]
= output

────────────────────
_ do anchors-of [ChunkAnchor]?
    - members [ImmutableTableRow'SourceNode]
    - ids [SyntaxId]
    - places [SyntaxId = Index]
    - kind SequenceKind

. anchors [ChunkAnchor]
. position Index = 0
while position < ids.length
    . id = ids[position]
    if is-skipped-member(id)
        position += 1
        continue
    . first = places[id]
    =? null if first == null
    if kind == .sequence-type && is-delegates(id)
        . end = position
        while end < ids.length && is-delegates(ids[end])
            end += 1
        =? null if end >= ids.length || !is-property(ids[end])
        . property = ids[end]
        . last = places[property]
        =? null if last == null || last < first
        . bucket = "delegates-for-properties"
        . anchor = ChunkAnchor
            - property
            - bucket
            - anchors.length
            - sort-priority(property, bucket, kind)
            - false
            - first
            - last
        =? null if !push-anchor(anchors, anchor)
        position = end + 1
        continue
    . bucket = classify(id, members[first], kind)
    . anchor = ChunkAnchor
        - id
        - bucket
        - anchors.length
        - sort-priority(id, bucket, kind)
        - false
        - first
        - first
    =? null if !push-anchor(anchors, anchor)
    position += 1
= anchors

────────────────────
_ do push-anchor Bool
    - anchors [ChunkAnchor]
    - anchor ChunkAnchor

if anchors.length != 0
    . previous = anchors[anchors.length - 1]
    . merges = anchor.bucket == previous.bucket && is-opaque-bucket(anchor.bucket)
    if merges
        if anchor.end-line > previous.end-line
            previous.end-line = anchor.end-line
        = true
    =? false if anchor.start-line <= previous.end-line
anchors += anchor
= true

────────────────────
_ do chunks-of [Chunk]
    - members [ImmutableTableRow'SourceNode]
    - anchors [ChunkAnchor]
    - order [String = OrderInfo]

. starts [Index]
for position in 0 .. < anchors.length
    . floor = if position > 0 then anchors[position - 1].end-line + 1 else 0
    starts += attached-start(members, anchors[position].start-line, floor)
. chunks [Chunk]
for position in 0 .. < anchors.length
    . anchor = anchors[position]
    . end = if position + 1 < anchors.length then starts[position + 1] else anchor.end-line + 1
    . info = order[anchor.bucket] if anchor.bucket.length != 0
    chunks += Chunk
        - starts[position]
        - end
        - anchor.bucket
        - anchor.original-index
        - anchor.sort-priority
        - false
        - ""
        - if info then info.index else -1
        - if info then info.section else -1
        - is-member-function-bucket(anchor.bucket)
= chunks

────────────────────
_ do attached-start Index
    - members [ImmutableTableRow'SourceNode]
    - first Index
    - floor Index

. start = first
while start > floor && store.is-comment(members[start - 1])
    start -= 1
= start

────────────────────
_ do region [ImmutableTableRow'SourceNode]
    - members [ImmutableTableRow'SourceNode]
    - rebuilt [ImmutableTableRow'SourceNode]
    - chunks [Chunk]

. sorted = sort(chunks) • using compare-chunks
. made [ImmutableTableRow'SourceNode]
for position in 0 .. < sorted.length
    . chunk = sorted[position]
    . core = core-end(members, chunk)
    . start = lead(members, chunk, core)
    for slot in start .. < core
        made += shown(rebuilt[slot], chunk.bucket)
    if position + 1 == sorted.length
        . held = chunks[position]
        for slot in core-end(members, held) .. < held.end
            made += rebuilt[slot]
    else if is-spaced(members, chunk, sorted[position + 1])
        made += store.blank()
= made

────────────────────
_ is-spaced Bool
    - members [ImmutableTableRow'SourceNode]
    - left Chunk
    - right Chunk

|? store.is-comment(last)
    true
|? is-divided(last, left.bucket)
    false
|? store.is-comment(first)
    true
|? is-divided(first, right.bucket)
    false
??
    left.section != right.section || is-style-rule-bucket(left.bucket) && is-right-style-rule

.. last = members[core-end(members, left) - 1]
.. first = members[lead(members, right, core-end(members, right))]
.. is-right-style-rule = is-style-rule-bucket(right.bucket)

────────────────────
_ is-divided Bool
    - node ImmutableTableRow'SourceNode
    - bucket String

!is-one-line-type-bucket(bucket) && (layout.is-apart(node) || is-machine)

.. count = store.count(node)
.. is-machine = store.is-form(node, "prop") && count > 4 && store.is-form(store.item(node, count - 1), "machine")

────────────────────
_ do shown ImmutableTableRow'SourceNode
    - node ImmutableTableRow'SourceNode
    - bucket String

=? node if !is-one-line-type-bucket(bucket) || !store.is-form(node, "type")
. items = store.listed(node)
items[0] = store.atom("type-line")
= store.with-items(node, items)

────────────────────
_ do lead Index
    - members [ImmutableTableRow'SourceNode]
    - chunk Chunk
    - end Index

=? chunk.start if !is-one-line-type-bucket(chunk.bucket)
. position = chunk.start
while position < end && store.is-blank(members[position])
    position += 1
= position

────────────────────
_ do core-end Index
    - members [ImmutableTableRow'SourceNode]
    - chunk Chunk

. end = chunk.end
while end > chunk.start && store.is-blank(members[end - 1])
    end -= 1
= end

────────────────────
_ do is-same Bool
    - left [ImmutableTableRow'SourceNode]
    - right [ImmutableTableRow'SourceNode]

=? false if left.length != right.length
= all(0 .. < left.length) • where is-same-item(left[each], right[each])

────────────────────
_ is-same-item Bool
    - left ImmutableTableRow'SourceNode
    - right ImmutableTableRow'SourceNode

left.index == right.index || (store.is-blank(left) && store.is-blank(right)) || is-same-comment

.. is-same-comment = store.is-comment(left) && store.is-comment(right) && store.comment-text(left) == store.comment-text(right)

────────────────────
_ is-sortable Bool
    - chunk Chunk
    - order [String = OrderInfo]

chunk.bucket.length != 0 && order[chunk.bucket] != null

────────────────────
_ order-of [String = OrderInfo]
    - kind SequenceKind

match kind
    |= .sequence-module
        module-order
    |= .sequence-type
        type-order
    |= .sequence-sheet
        sheet-order
    |= .sequence-sheet-rule-body
        sheet-rule-order
    ??
        rule-order

────────────────────
_ do classify String
    - id SyntaxId
    - item ImmutableTableRow'SourceNode
    - kind SequenceKind

match kind
    |= .sequence-module
        = module-bucket(id, item)
    |= .sequence-type
        = type-bucket(id, item)
    |= .sequence-sheet
        = sheet-bucket(id)
    |= .sequence-sheet-rule-body
        = sheet-rule-bucket(id)
    ??
        = rule-bucket(id)

────────────────────
_ do module-bucket String
    - id SyntaxId
    - item ImmutableTableRow'SourceNode

match tree.nodes[id]
    | .node-import-syntax
        = "imports"
    | .node-property-syntax(row)
        if row.value != 0 && is-machine-value && (store.head(item) ?? "").starts-with("fn")
            = "${access-prefix(row.access)}-functions"
        .. is-machine-value = is-state-machine(row.value)
        = property-bucket(row, "globals")
    | .node-class-block(row)
        if row.is-style-sheet
            = "style-sheets"
        if row.aliases.count != 0
            = ""
        . prefix = access-prefix(row.access)
        = if is-one-line-type(row, item) then "${prefix}-one-line-types" else "${prefix}-types"
    | .node-style-sheet-extension
        = "style-sheet-extensions"
    | .node-subscriber-syntax
        = "module-subscriptions"
    | .node-extension(row)
        = "${access-prefix(row.access)}-extensions"
    | .node-function-syntax(row)
        = module-function-bucket(row.access, row.return-type)
    | .node-unit-declaration
        = ""
    | .node-converter-syntax
        = ""
    | .node-fromverter-syntax
        = ""
    | .node-when-rule-syntax
        = ""
    | .node-whenever-rule-syntax
        = ""
    ??
        = "module-main-body"

────────────────────
_ do is-one-line-type Bool
    - row ASTClassBlock
    - item ImmutableTableRow'SourceNode

=? false if is-function-type(row.base) || row.members.count != 0
=? false if row.base == 0 && row.or-bases.count == 0
=? false if row.param-constraints.count != 0 || row.param-assignments.count != 0
. header = layout.header-count(item)
=? false if header != null && (header as Size) < store.count(item)
= some(store.items(item)) • where store.is-form(each, "is")

────────────────────
_ module-function-bucket String
    - access Access
    - return-type SyntaxId

|? !is-tests-path(brix.source.path)
    "${prefix}-functions"
|? name == "testrender"
    "${prefix}-test-render-functions"
|? name == "testcase"
    "${prefix}-test-case-functions"
|? prefix == "public"
    "test-public-functions"
??
    "${prefix}-functions"

.. prefix = access-prefix(access)
.. name = normalized-name(type-name(return-type))

────────────────────
_ type-name String
    - id SyntaxId

if id == 0 then "" else declared

.. declared = match tree.nodes[id]
    | .node-type-identifier(row)
        row.name.text
    | .node-core-type-identifier(row)
        row.name.text
    ??
        ""

────────────────────
_ do type-bucket String
    - id SyntaxId
    - item ImmutableTableRow'SourceNode

match tree.nodes[id]
    | .node-enum-declaration
        = "enum-cases"
    | .node-property-syntax(row)
        = property-bucket(row, "properties")
    | .node-dependency-declaration
        = "dependencies"
    | .node-style-annotation
        = "style-annotations"
    | .node-rule-syntax
        = "style-rules"
    | .node-content-block
        = "content-block"
    | .node-fromverter-syntax(row)
        = if row.access == .public-access then "public-fromverters" else ""
    | .node-converter-syntax(row)
        = if row.access == .public-access then "public-converters" else ""
    | .node-subscriber-syntax
        = "subscriptions"
    | .node-when-rule-syntax
        = "when-rules"
    | .node-whenever-rule-syntax
        = "whenever-rules"
    | .node-function-syntax(row)
        = function-bucket(row, item)
    ??
        = ""

────────────────────
_ function-bucket String
    - row ASTFunction
    - item ImmutableTableRow'SourceNode

|? row.names.count == 1 && tree.atoms[row.names.start].text == "This"
    "${prefix}-constructors"
|? row.is-getter && store.is-form(item, "prop")
    "${prefix}-inline-getter-properties"
|? row.is-getter
    "${prefix}-getters"
|? row.is-setter
    "${prefix}-setters"
|? operator.length == 0
    "${prefix}-methods"
|? operator == "[]"
    "${prefix}-indexers"
|? operator == "[]="
    "${prefix}-index-setters"
|? operator == "-=[]"
    "${prefix}-index-deleters"
|? is-prefix-operator(operator)
    "${prefix}-prefix-operators"
??
    "${prefix}-operators"

.. prefix = access-prefix(row.access)
.. operator = operator-token(row, item)

────────────────────
_ operator-token String
    - row ASTFunction
    - item ImmutableTableRow'SourceNode

|? row.names.count != 1
    ""
|? name == "()"
    ""
|? name == "[]" || name == "[]=" || name == "-=[]"
    name
|? store.count(item) < 3
    ""
|? store.is-form(key, "infix")
    name
|? !store.is-form(key, "prefix")
    ""
|? name == "-="
    "-=del"
??
    name

.. name = tree.atoms[row.names.start].text
.. key = store.item(item, 2)

────────────────────
_ property-bucket String
    - row ASTProperty
    - scope String

|? row.value != 0 && is-state-machine(row.value)
    "${prefix}-state-machine-${scope}"
|? scope == "properties" && row.annotations.count != 0
    "${prefix}-style-properties"
|? row.is-lazy
    "${prefix}-lazy-${scope}"
??
    "${prefix}-${scope}"

.. prefix = access-prefix(row.access)

────────────────────
_ do sheet-bucket String
    - id SyntaxId

match tree.nodes[id]
    | .node-property-syntax(row)
        . lazy = if row.is-lazy then "lazy-" else ""
        = "${access-prefix(row.access)}-${lazy}slots"
    | .node-rule-syntax
        = "style-rules"
    ??
        = ""

────────────────────
_ sheet-rule-bucket String
    - id SyntaxId

match tree.nodes[id]
    | .node-assign
        "style-declarations"
    | .node-style-when
        "style-when-blocks"
    | .node-rule-syntax
        "nested-style-rules"
    ??
        ""

────────────────────
_ rule-bucket String
    - id SyntaxId

match tree.nodes[id]
    | .node-assign
        "style-declarations"
    | .node-style-when
        "style-when-blocks"
    | .node-markup-slot-forward
        "generated-content-slots"
    | .node-markup(row)
        if row.slot-binding != 0 then "generated-content-slots" else "content-body"
    | .node-rule-syntax
        "nested-style-rules"
    ??
        "content-body"

────────────────────
_ do sort-priority Int
    - id SyntaxId
    - bucket String
    - kind SequenceKind

if kind == .sequence-module
    =? 0 if bucket != "public-types" || !is-type-class(id)
    = if primary-names[normalized-name(class-name(id))] then -1 else 0
=? 0 if kind != .sequence-type || !is-semantic-callable(id, bucket)
. found = index?.metadata[id]
= if found then found.priority else 0

────────────────────
_ is-semantic-callable Bool
    - id SyntaxId
    - bucket String

is-semantic-callable-bucket(bucket) && is-callable

.. is-callable = match tree.nodes[id]
    | .node-function-syntax
        true
    | .node-converter-syntax
        true
    | .node-fromverter-syntax
        true
    ??
        false

────────────────────
_ is-skipped-member Bool
    - id SyntaxId

match tree.nodes[id]
    | .node-noop
        true
    | .node-implements-declaration
        true
    | .node-using-declaration
        true
    | .node-sees-declaration
        true
    ??
        false

────────────────────
_ is-delegates Bool
    - id SyntaxId

match tree.nodes[id]
    | .node-delegate-declaration
        true
    ??
        false

────────────────────
_ is-property Bool
    - id SyntaxId

match tree.nodes[id]
    | .node-property-syntax
        true
    ??
        false

────────────────────
_ is-state-machine Bool
    - id SyntaxId

match tree.nodes[id]
    | .node-state-machine
        true
    ??
        false

────────────────────
_ is-type-class Bool
    - id SyntaxId

match tree.nodes[id]
    | .node-class-block(row)
        !row.is-style-sheet
    ??
        false

────────────────────
_ is-function-type Bool
    - id SyntaxId

id != 0 && is-type-function

.. is-type-function = match tree.nodes[id]
    | .node-type-function
        true
    ??
        false

────────────────────
_ class-name String
    - id SyntaxId

match tree.nodes[id]
    | .node-class-block(row)
        row.name.text
    ??
        ""
