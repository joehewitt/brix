(import ./brix-source)
(import /code/structure/document)
(import /core/table)
(import /data/sexp)
(import /data/source-sexp)
(import /data/source-tree)
(import /lang/brix/brix)

(type + BrixRowShape (is Tuple)
  (prop + id U32)
  (prop + line U32)
  (prop + column U32)
  (prop + shown String)
  (prop + columns Size)
  (prop + indent Size)
  (prop + is-text Bool)
)

(fn-do + brix-row-shapes (list BrixRowShape) (?! SexpError)
  (param text String)
  (let language (call BrixLanguage))
  (let store (use (. language store)))
  (let document (call source-document-read language text))
  (let marked (use (call SourceStore)))
  (let marks (call SexpMarks (. marked latest-id)))
  (call sexp-read text marked marks)
  (let shapes (list BrixRowShape))
  (let place (call BrixCursor (call byte-view text)))
  (for (in index (..< 0 (. document declarations length)))
    (for (in outline (call (. document rows-of) index))
      (let row (call (. language render) outline))
      (let node (call (. store node-at) (. row node)))
      (if (and node (not (call (. store is-comment) node)))
        (let start (call (. marks start) (. node id)))
        (if (> start 0)
          (call (. place advance) start)
        )
        (+= shapes
          (call BrixRowShape
            (block
              (arg (. node id))
              (arg (+ (. place line) 1))
              (arg (+ (. place column) 1))
              (arg (call shown store node))
              (arg (. row columns))
              (arg (. row indent))
              (arg (== (. outline mode) brix-mode-text))
            )
          )
        )
      )
      (call (. document discard))
    )
  )
  (return shapes)
)

(fn-expr _ shown String
  (param store SourceStore)
  (param node (of ImmutableTableRow SourceNode))
  (if-expr (!= head null) (str "(" head " …)") (str "`" (call (. store text) node) "`"))
  (where
    (lazy head (call (. store head) node))
  )
)
