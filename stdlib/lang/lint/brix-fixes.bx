(import ./brix-source)
(import ./diagnostics)
(import ./source)
(import /core/table)
(import /data/source-tree)
(import /lang/ast/ast)
(import /lang/ast/ast-nodes)

(fn-do + brix-lift-fix (? LintFix)
  (param source LintSource)
  (param tree AST)
  (param fallback SyntaxId)
  (let read (call read-brix-source source))
  (return-if null (if (not read)))
  (let brix (use read))
  (let store (. brix store))
  (let begin (. ([] (. tree nodes loc) fallback) begin))
  (let arm (call (. brix form-at) (. begin line) (. begin column)))
  (return-if null (if (or (not arm) (not (call (. store is-form) arm "default")))))
  (let depth (call (. brix depth-of) arm))
  (let edit (call (. brix edit) arm arm (call (. brix rows-text) (call (. store listed) arm 1) depth)))
  (return (call LintFix "safe" "Lift match fallback assertions" (list edit)))
)

(fn-do + brix-null-fallback-fix (? LintFix)
  (param source LintSource)
  (param tree AST)
  (param id SyntaxId)
  (let read (call read-brix-source source))
  (return-if null (if (not read)))
  (let brix (use read))
  (let store (. brix store))
  (let begin (. ([] (. tree nodes loc) id) begin))
  (let found (call (. brix form-at) (. begin line) (. begin column)))
  (return-if null (if (or (not found) (not (call (. store is-form) found "if-expr")) (!= (call (. store count) found) 4))))
  (let form found)
  (let fallback (call (. store item) form 3))
  (return-if null (if (or (not (call (. store is-atom) fallback)) (!= (call (. store text) fallback) "null"))))
  (let guard (call (. store list) (list (call (. store atom) "if") (call (. store item) form 1))))
  (let made (call (. store list) (list (call (. store atom) "only-if") (call (. store item) form 2) guard)))
  (return
    (call LintFix
      (block
        (arg "safe")
        (arg "Write a conditional value")
        (arg (list (call (. brix edit) form form (call (. brix text-of) made (call (. brix depth-of) form)))))
      )
    )
  )
)

(fn-do + brix-is-map-literal Bool
  (param source LintSource)
  (param tree AST)
  (param id SyntaxId)
  (let read (call read-brix-source source))
  (return-if false (if (not read)))
  (let brix (use read))
  (let store (. brix store))
  (let begin (. ([] (. tree nodes loc) id) begin))
  (let form (call (. brix form-at) (. begin line) (. begin column)))
  (return-if false (if (not form)))
  (for (in item (call (. store listed) form 2))
    (if (call (. store is-form) item "block")
      (for (in row (call (. store listed) item 1))
        (return-if true (if (call (. store is-form) row "entry")))
      )
    )
  )
  (return false)
)

(fn-do + brix-map-constructor-fix (? LintFix)
  (param source LintSource)
  (param tree AST)
  (param id SyntaxId)
  (let read (call read-brix-source source))
  (return-if null (if (not read)))
  (let brix (use read))
  (let store (. brix store))
  (let begin (. ([] (. tree nodes loc) id) begin))
  (let found (call (. brix form-at) (. begin line) (. begin column)))
  (return-if null (if (or (not found) (not (call (. store is-form) found "call")) (!= (call (. store count) found) 3))))
  (let form found)
  (let block (call (. store item) form 2))
  (return-if null (if (not (call (. store is-form) block "block"))))
  (let rows (list (of ImmutableTableRow SourceNode)))
  (+= rows (call (. store item) block 0))
  (for (in row (call (. store listed) block 1))
    (return-if null (if (or (not (call (. store is-form) row "arg")) (!= (call (. store count) row) 2))))
    (let pair (call (. store item) row 1))
    (return-if null (if (or (not (call (. store is-form) pair "tuple")) (!= (call (. store count) pair) 3))))
    (+= rows (call (. store list) (list (call (. store atom) "entry") (call (. store item) pair 1) (call (. store item) pair 2))))
  )
  (let made
    (call (. store with-items)
      (block
        (arg form)
        (arg (list (call (. store item) form 0) (call (. store item) form 1) (call (. store with-items) block rows)))
      )
    )
  )
  (return
    (call LintFix
      (block
        (arg "safe")
        (arg "Use map literal syntax")
        (arg (list (call (. brix edit) form form (call (. brix text-of) made (call (. brix depth-of) form)))))
      )
    )
  )
)

(fn-do + brix-initial-entries-fix (? LintFix)
  (param source LintSource)
  (param tree AST)
  (param declaration SyntaxId)
  (param statements (list SyntaxId))
  (let read (call read-brix-source source))
  (return-if null (if (not read)))
  (let brix (use read))
  (let store (. brix store))
  (let begin (. ([] (. tree nodes loc) declaration) begin))
  (let found (call (. brix form-at) (. begin line) (. begin column)))
  (return-if null (if (or (not found) (not (call (. store is-form) found "let")))))
  (let first found)
  (let count (call (. store count) first))
  (let call (call (. store item) first (- count 1)))
  (return-if null (if (or (< count 3) (not (call (. store is-form) call "call")) (!= (call (. store count) call) 2))))
  (let entries (list (of ImmutableTableRow SourceNode)))
  (+= entries (call (. store atom) "block"))
  (let last first)
  (for (in statement statements)
    (let place (. ([] (. tree nodes loc) statement) begin))
    (let written (call (. brix form-at) (. place line) (. place column)))
    (return-if null (if (or (not written) (not (call (. store is-form) written "=")) (!= (call (. store count) written) 3))))
    (let form written)
    (return-if null (if (not (call (. brix is-adjacent) last form))))
    (let target (call (. store item) form 1))
    (return-if null (if (or (not (call (. store is-form) target "[]")) (!= (call (. store count) target) 3))))
    (+= entries (call (. store list) (list (call (. store atom) "entry") (call (. store item) target 2) (call (. store item) form 2))))
    (= last form)
  )
  (let items (call (. store listed) first))
  (= ([] items (- count 1))
    (call (. store with-items)
      (block
        (arg call)
        (arg (list (call (. store item) call 0) (call (. store item) call 1) (call (. store list) entries)))
      )
    )
  )
  (let made (call (. store with-items) first items))
  (return
    (call LintFix
      (block
        (arg "safe")
        (arg "Use map literal syntax")
        (arg (list (call (. brix edit) first last (call (. brix text-of) made (call (. brix depth-of) first)))))
      )
    )
  )
)

(fn-do + brix-default-fix (? LintFix)
  (param source LintSource)
  (param line U32)
  (param column U32)
  (let read (call read-brix-source source))
  (return-if null (if (not read)))
  (let brix (use read))
  (let store (. brix store))
  (let value (call (. brix form-at) (- line 1) (- column 1)))
  (return-if null (if (not value)))
  (let parent (call (. brix parent-of) value))
  (return-if null (if (not parent)))
  (let is-wrapped (and (call (. store is-form) parent "=") (== (call (. store count) parent) 2)))
  (let owner (if-expr is-wrapped (call (. brix parent-of) parent) parent))
  (return-if null (if (or (not owner) (not (or (call (. store is-form) owner "prop") (call (. store is-form) owner "let"))))))
  (let kept (call (. store listed) owner))
  (let last (call (. kept pop)))
  (return-if null (if (!= (. last id) (if-expr is-wrapped (. parent id) (. value id)))))
  (let made (call (. store with-items) owner kept))
  (return
    (call LintFix
      (block
        (arg "safe")
        (arg "Omit redundant default initializer")
        (arg (list (call (. brix edit) owner owner (call (. brix text-of) made (call (. brix depth-of) owner)))))
      )
    )
  )
)

(fn-do + brix-initializer-fix (? LintFix)
  (param source LintSource)
  (param line U32)
  (param column U32)
  (param name String)
  (let read (call read-brix-source source))
  (return-if null (if (not read)))
  (let brix (use read))
  (let store (. brix store))
  (let found (call (. brix form-at) (- line 1) (- column 1)))
  (return-if null (if (or (not found) (not (call (. store is-form) found "=")) (!= (call (. store count) found) 3))))
  (let target (call (. store item) found 1))
  (let is-named (and (call (. store is-atom) target) (== (call (. store text) target) name)))
  (let is-this
    (scope (and is-member has-this (== (call (. store text) (call (. store item) target 2)) name))
      (lazy is-member (and (call (. store is-form) target ".") (== (call (. store count) target) 3)))
      (lazy has-this (== (call (. store text) (call (. store item) target 1)) "this"))
    )
  )
  (return-if null (if (and (not is-named) (not is-this))))
  (let made (call (. store list) (list (call (. store atom) "lazy") (call (. store atom) name) (call (. store item) found 2))))
  (return
    (call LintFix
      (block
        (arg "safe")
        (arg "Initialize with `..`")
        (arg (list (call (. brix edit) found found (call (. brix text-of) made (call (. brix depth-of) found)))))
      )
    )
  )
)

(fn-do + brix-suffix-fix (? LintFix)
  (param source LintSource)
  (param line U32)
  (param column U32)
  (param unit String)
  (let read (call read-brix-source source))
  (return-if null (if (not read)))
  (let brix (use read))
  (let store (. brix store))
  (let found (call (. brix form-at) (- line 1) (- column 1)))
  (return-if null (if (or (not found) (not (call (. store is-atom) found)))))
  (let text (call (. store text) found))
  (return-if null (if (or (<= (. text length) (. unit length)) (not (call (. text ends-with) unit)))))
  (let kept ([] text (..< 0 (- (. text length) (. unit length)))))
  (return (call LintFix "safe" "Remove redundant suffix" (list (call (. brix edit) found found kept))))
)
