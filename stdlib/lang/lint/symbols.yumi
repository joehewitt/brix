+ StyleClass

` What the style shorthand rule reads of a type a module declares: the types it uses or
` implements, by name where written as one, whether it is a style, the properties it declares, and
` its style rules with the property each one forwards its one argument to, if any.

+ name String
+ module-path String
+ key String
+ aliases [String]
+ is-public Bool
+ references [String]
+ is-style Bool
+ properties [String = Bool]
+ rules [String]
+ forwarded [String]

────────────────────
+ This
    - name String
    - module-path String
    - key String

────────────────────
+ do names Bool
    - name String

if this.name == name
    = true
for alias in aliases
    if alias == name
        = true
= false

━━━━━━━━━━━━━━━━━━━━
+ do collect-style-classes [StyleClass]
    - tree AST
    - path String
    - imported Bool

` The types a module declares, as declared where `imported`, or else as the linted source
` writes them.
. classes [StyleClass]
match tree.nodes[tree.root]
    | .node-top-level-syntax(root)
        for id in tree.children[root.statements]
            match? tree.nodes[id]
                | .node-class-block(row)
                    classes += style-class(tree, id, row, path, imported)
    ?! Panic("AST root has the wrong syntax case")
= classes

━━━━━━━━━━━━━━━━━━━━
+ do style-class StyleClass
    - tree AST
    - id SyntaxId
    - row ASTClassBlock
    - path String
    - imported Bool

` A declared type, whose properties are its fields, and where `imported` also its getters and
` setters. It is a style where a base it implements is `Style`, and also where it uses `Style`
` unless `imported`.
. found = StyleClass(row.name.text, path, "$path#$id")
found.is-public = row.access == .public-access
for offset in 0 .. < row.aliases.count
    found.aliases += tree.atoms[row.aliases.start + offset].text

. bases [SyntaxId]
. usings [SyntaxId]
if row.base != 0
    bases += row.base
for member in tree.children[row.members]
    match? tree.nodes[member]
        | .node-implements-declaration(declaration)
            bases += declaration.type
        | .node-using-declaration(declaration)
            usings += declaration.type
        | .node-property-syntax(property)
            found.properties[declared-name(tree, property.left)] = true
        | .node-getter-syntax(getter)
            if imported && getter.names.count != 0
                found.properties[tree.atoms[getter.names.start].text] = true
        | .node-setter-syntax(setter)
            if imported && setter.names.count != 0
                found.properties[tree.atoms[setter.names.start].text] = true
        | .node-rule-syntax(rule)
            found.rules += rule.name.text
            found.forwarded += forwarded-property(tree, rule)

for type in usings
    found.references += plain-type-name(tree, type)
    if !imported && type-name(tree, type) == "Style"
        found.is-style = true
for type in bases
    found.references += plain-type-name(tree, type)
    if type-name(tree, type) == "Style"
        found.is-style = true
= found

━━━━━━━━━━━━━━━━━━━━
+ plain-type-name String
    - tree AST
    - id SyntaxId

match tree.nodes[id]
    | .node-type-identifier(row)
        row.name.text
    ??
        ""

━━━━━━━━━━━━━━━━━━━━
+ do forwarded-property String
    - tree AST
    - rule ASTRule

` The property a style rule sets to its one argument and does nothing else, or none.
if rule.args.count != 1 || rule.style-rule-applications.count != 0
    = ""
. parameter = match tree.nodes[tree.children[rule.args.start]]
    | .node-argument-decl(arg)
        arg
    ??
        = ""
if parameter.is-variadic || parameter.default-value != 0
    = ""
match? tree.nodes[rule.body]
    | .node-block(block)
        if block.body.count != 1
            = ""
        . statement = tree.children[block.body.start]
        match? tree.nodes[statement]
            | .node-assign(assignment)
                . left = identifier-name(tree, assignment.lhs)
                . right = identifier-name(tree, assignment.rhs)
                . argument = declared-name(tree, parameter.pattern)
                if right.length != 0 && right == argument && !is-tracked-name(tree, assignment.rhs)
                    = left
= ""

━━━━━━━━━━━━━━━━━━━━
+ identifier-name String
    - tree AST
    - id SyntaxId

match tree.nodes[id]
    | .node-identifier(row)
        row.name.text
    ??
        ""

━━━━━━━━━━━━━━━━━━━━
+ is-tracked-name Bool
    - tree AST
    - id SyntaxId

match tree.nodes[id]
    | .node-identifier(row)
        row.is-tracked
    ??
        false

━━━━━━━━━━━━━━━━━━━━
+ do declared-order [NameSymbol]
    - symbols [NameSymbol]

` Symbols in the order a declared module lists them: its globals, functions, types and then type
` aliases, each in the order written.
. ordered [NameSymbol]
for rank in 0 .. < 4
    for symbol in symbols
        if declared-rank(symbol.kind) == rank
            ordered += symbol
= ordered

━━━━━━━━━━━━━━━━━━━━
+ declared-rank Int
    - kind String

|? kind == "global"
    0
|? kind == "function"
    1
|? kind == "type-alias"
    3
??
    2

━━━━━━━━━━━━━━━━━━━━
+ module-display-name String
    - name String

if name.starts-with("/") then name[1 ...] else name

━━━━━━━━━━━━━━━━━━━━
+ do collect-imports [ImportEntry]
    - tree AST

. entries [ImportEntry]
match tree.nodes[tree.root]
    | .node-top-level-syntax(root)
        for id in tree.children[root.statements]
            match? tree.nodes[id]
                | .node-import-syntax(import)
                    . text = import-path-text(tree, import.paths)
                    entries += ImportEntry(text, import.is-export, import.loc)
    ?! Panic("AST root has the wrong syntax case")

= entries

━━━━━━━━━━━━━━━━━━━━
+ import-path-text String
    - tree AST
    - paths RowRange'Atom

"/".join(tree.atoms[paths.start + each].text in 0 .. < paths.count)

━━━━━━━━━━━━━━━━━━━━
+ do collect-symbols [NameSymbol]
    - tree AST
    - origin-name String
    - origin-path String
    - only-public Bool

. symbols [NameSymbol]
match tree.nodes[tree.root]
    | .node-top-level-syntax(root)
        for id in tree.children[root.statements]
            collect-statement-symbols(tree, id, origin-name, origin-path, only-public, symbols)
    ?! Panic("AST root has the wrong syntax case")

= symbols

━━━━━━━━━━━━━━━━━━━━
_ do collect-statement-symbols
    - tree AST
    - id SyntaxId
    - origin-name String
    - origin-path String
    - only-public Bool
    - symbols [NameSymbol]

. loc = tree.nodes.loc[id]
. site = SymbolSite(loc.begin.line, loc.begin.column, origin-name, origin-path)

match? tree.nodes[id]
    | .node-class-block(row)
        if only-public && row.access != .public-access
            =

        . kind = if row.is-style-sheet then "style-sheet" else "type"
        symbols += NameSymbol("type", kind, row.name.text, site)
        for offset in 0 .. < row.aliases.count
            . alias = tree.atoms[row.aliases.start + offset].text
            symbols += NameSymbol("type", "type-alias", alias, site)

    | .node-function-syntax(row)
        if only-public && row.access != .public-access
            =

        for offset in 0 .. < row.names.count
            . name = tree.atoms[row.names.start + offset].text
            if name.length != 0
                . symbol = NameSymbol("value", "function", name, site)
                symbol.call-shape = function-call-shape(tree, row)
                symbols += symbol

    | .node-property-syntax(row)
        if only-public && row.access != .public-access
            =

        . name = declared-name(tree, row.left)
        if name.length == 0
            =

        symbols += NameSymbol("value", "global", name, site)
        if row.value != 0 && is-state-machine(tree, row.value)
            symbols += NameSymbol("type", "type", name, site)

━━━━━━━━━━━━━━━━━━━━
+ do function-call-shape FunctionCallShape?
    - tree AST
    - function ASTFunction

. minimum = 0u32
. labels [String = Bool]
. call-names [String]
for id in tree.children[function.args]
    match tree.nodes[id]
        | .node-argument-decl(arg)
            if arg.is-variadic
                = null
            . label = declared-name(tree, arg.pattern)
            call-names += label
            if label.length != 0
                if labels[label]
                    = null
                labels[label] = true
            if arg.default-value == 0
                minimum += 1
        ??
            = null
. generic = function.type-args.count + function.param-constraints.count
generic += function.param-assignments.count
= FunctionCallShape(minimum, function.args.count, call-names, function.args.count + generic == 0)

━━━━━━━━━━━━━━━━━━━━
+ is-state-machine Bool
    - tree AST
    - id SyntaxId

match tree.nodes[id]
    | .node-state-machine
        true
    ??
        false

━━━━━━━━━━━━━━━━━━━━
+ declared-name String
    - tree AST
    - id SyntaxId

match tree.nodes[id]
    | .node-identifier(row)
        row.name.text
    | .node-ref-identifier(row)
        row.name.text
    | .node-type-capture(row)
        declared-name(tree, row.id)
    ??
        ""

━━━━━━━━━━━━━━━━━━━━
+ type-name String
    - tree AST
    - id SyntaxId

match tree.nodes[id]
    | .node-type-identifier(row)
        row.name.text
    | .node-type-arguments(row)
        type-name(tree, row.base)
    ??
        ""

━━━━━━━━━━━━━━━━━━━━
+ do collect-type-params [TypeParam]
    - tree AST

. params [TypeParam]
. seen [String = Bool]
. total = tree.nodes.length

for id in 1u32 .. < total
    match? tree.nodes[id]
        | .node-class-block(row)
            add-type-args(tree, row.type-args, params, seen)
        | .node-function-syntax(row)
            add-type-args(tree, row.type-args, params, seen)
        | .node-getter-syntax(row)
            add-type-args(tree, row.type-args, params, seen)
        | .node-setter-syntax(row)
            add-type-args(tree, row.type-args, params, seen)
        | .node-type-identifier(row)
            if row.is-declare
                add-type-param(tree, id as SyntaxId, row.name.text, params, seen)

= params

━━━━━━━━━━━━━━━━━━━━
_ do add-type-args
    - tree AST
    - range RowRange'SyntaxId
    - params [TypeParam]
    - seen [String = Bool]

for child in tree.children[range]
    . name = type-name(tree, child)
    if name.length != 0
        add-type-param(tree, child, name, params, seen)

━━━━━━━━━━━━━━━━━━━━
_ do add-type-param
    - tree AST
    - id SyntaxId
    - name String
    - params [TypeParam]
    - seen [String = Bool]

. loc = tree.nodes.loc[id]
. key = "$name:${loc.begin.line}:${loc.begin.column}"
if seen[key]
    =

seen[key] = true
params += TypeParam(name, loc.begin.line, loc.begin.column)
