━━━━━━━━━━━━━━━━━━━━
+ SymbolAnalyzer

+ atoms AtomPool
+ resolver ModuleResolver
_ modules [String = ExportedModule]

────────────────────
+ This
    - search-paths [Path]

. c-paths [String = [Path]]
resolver = ModuleResolver(search-paths, c-paths)

────────────────────
+ parse-source AST
    - source LintSource

builder.finish(atoms)

.. builder = parse-lint-text(source.text, source.path)

────────────────────
+ do analyze ModuleAnalysis
    - source LintSource
    - tree AST

. analysis = ModuleAnalysis(source, tree)
analysis.analyzer = this
analysis.imports = collect-imports(tree)
analysis.local-symbols = collect-symbols(tree, local-origin-name, source.path, false)
analysis.type-params = collect-type-params(tree)

. seen [String = Index]
. builds = narrowed-builds(null, source.path)
. priority = 0
for entry in analysis.imports
    . position = priority
    priority += 1
    . resolved = resolver.resolve-module(entry.import-path, source.path)
    if !resolved
        continue

    . found = resolved
    . resolved-name = module-display-name(found.name)
    . resolved-path = found.path as String
    entry.resolved-name = resolved-name
    entry.resolved-path = resolved-path
    . visited [String = Bool]
    . output = analysis.imported-symbols
    collect-exported(resolved-path, resolved-name, position, entry, builds, visited, seen, output)

= analysis

────────────────────
_ do collect-exported ?! Error
    - path String
    - name String
    - priority Int
    - direct ImportEntry
    - builds [String]?
    - visited [String = Bool]
    - seen [String = Index]
    - output [NameSymbol]

` Adds the public symbols of a module and then of the modules it exports, the last exported
` first, as the direct import that reaches them brings them in, in the builds of `builds` that
` load each module on the way. A symbol a later direct import also reaches takes that import's
` place, and is seen in the builds of both.
if visited[path]
    =
visited[path] = true

. module = exported-module(path, name)
if !module
    =

. loaded = narrowed-builds(builds, path)
for symbol in module.symbols
    . key = "${symbol.key}:${symbol.origin-key}"
    if symbol.kind == "c-function"
        key += ":$path"
    . known = seen[key]
    if known != null
        . kept = output[known]
        . joined = joined-builds(kept.builds, loaded)
        if priority > kept.import-priority
            output[known] = symbol.imported-by(priority, direct, joined)
        else
            kept.builds = joined
        continue
    seen[key] = output.length
    output += symbol.imported-by(priority, direct, loaded)

for position in 0 .. < module.exports.length
    . entry = module.exports[module.exports.length - 1 - position]
    . resolved = resolver.resolve-module(entry.import-path, path)
    if resolved
        . found = resolved
        . found-path = found.path as String
        . found-name = module-display-name(found.name)
        collect-exported(found-path, found-name, priority, direct, loaded, visited, seen, output)

────────────────────
_ do exported-module ExportedModule?
    - path String
    - name String

. cached = modules[path]
if cached
    = cached
if path.ends-with(".h")
    = c-header-module(path, name)
if !Path(path).is-file
    = null

. text = read-file-text(Path(path))
. builder = parse-lint-text(text, path)
    catch YumiSyntaxError
        = null
. tree = use builder.finish(atoms)

. module = ExportedModule(name, path)
module.symbols = declared-order(collect-symbols(tree, name, path, true))
module.classes = collect-style-classes(tree, path, true)
for entry in collect-imports(tree)
    module.imports += entry
    if entry.is-export
        module.exports += entry

modules[path] = module
= module

────────────────────
+ module-at ExportedModule?
    - path String

` The module loaded from `path`, if one is.
modules[path]

────────────────────
+ do imported-module ExportedModule?
    - entry ImportEntry
    - from String

` The module an import names, resolved from the module at `from`, or none where it is not found
` or does not parse.
if !entry.resolved-path
    . resolved = resolver.resolve-module(entry.import-path, from)
    if !resolved
        = null
    . found = resolved
    entry.resolved-name = module-display-name(found.name)
    entry.resolved-path = found.path as String
. module = catch exported-module(entry.resolved-path!, entry.resolved-name ?? "")
    catch Error
        = null
= module

────────────────────
_ do c-header-module ExportedModule
    - path String
    - name String

. module = ExportedModule(name, path)
. counts [String = Int]
for function in resolver.c-module-functions(path)
    . symbol = NameSymbol("c-value", "c-function", function.name, SymbolSite(0, 0, name, path))
    . index = counts[function.name] ?? 0
    counts[function.name] = index + 1
    . declared = function.declaration-key
    if declared
        symbol.origin-key = "c-declaration:$declared"
    else
        symbol.origin-key += ":$index"
    module.symbols += symbol

modules[path] = module
= module

━━━━━━━━━━━━━━━━━━━━
_ do narrowed-builds [String]?
    - builds [String]?
    - path String

` Of the targets in `builds`, those whose builds load the module at `path`. Null stands for every
` target, in `builds` and in the result.
. suffix = platform-suffix(path)
=? builds if !suffix || !is-platform(suffix)
. narrowed [String]
for target in targets()
    if target.includes(suffix) && (!builds || builds.find(target.name) != null)
        narrowed += target.name
= narrowed

━━━━━━━━━━━━━━━━━━━━
_ do joined-builds [String]?
    - first [String]?
    - second [String]?

` The targets in `first` or in `second`, where null stands for every target.
=? null if !first || !second
. joined [String]
joined ++= first
for target in second
    if joined.find(target) == null
        joined += target
= joined

