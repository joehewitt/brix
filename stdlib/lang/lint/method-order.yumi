./format
./source
./symbols
/core/atom-pool
/lang/ast/ast
/lang/ast/ast-children
/lang/ast/ast-nodes
/lang/ast/error
/lang/ast/module-resolver
/lang/ast/operator
/lang/ast/row-range
/lang/ast/syntax-uses
/lang/constants
/os/file
/os/path
/stream/sort

_ override-priority-base = -2000000000
_ interface-priority-base = -1000000000
_ group-stride = 1000000
_ bucket-stride = 10000

━━━━━━━━━━━━━━━━━━━━
+ DeclarationStore

` The declarations of modules as the reference's module store makes them for ordering: the builtin
` modules first, which import nothing implicitly, and then each module the first time an import
` reaches it, which also imports the builtin modules.
+ resolver ModuleResolver
_ atoms AtomPool
_ modules [String = DeclaredModule]
_ failures [String = String]
_ builtins [DeclaredModule]
_ next-id = 0
_ is-initialized = false
_ initialize-error String?

────────────────────
+ This
    - search-paths [Path]

. c-paths [String = [Path]]
resolver = ModuleResolver(search-paths, c-paths)
atoms = AtomPool()

────────────────────
+ module-index MethodOrderIndex? ?! Error
    - source LintSource
    - tree AST

` The places of the public functions of a source's classes that implement its interfaces or
` override its bases, or none where no function has one.
if index.metadata.length == 0 then null else index

.. index = method-order-index(declare-source(source, tree))

────────────────────
+ do declare-source DeclaredModule ?! Error
    - source LintSource
    - tree AST

` A source declared as the reference declares it for ordering, as a module of its own apart from
` any module at its path.
initialize()
. module = new-module(local-origin-name, source.path, false)
declare(module, source, tree)
= module

────────────────────
_ do initialize ?! Error

if !is-initialized
    is-initialized = true
    . outcome = catch declare-builtins()
    if outcome is Error
        initialize-error = (outcome as Error).message
if initialize-error
    ?! Error(initialize-error)

────────────────────
_ do declare-builtins ?! Error

. found [DeclaredModule]
for name in builtin-module-names
    found += import-module(name, null)
for name in core-module-names
    import-module(name, null)
builtins = found

────────────────────
_ do new-module DeclaredModule
    - name String
    - path String
    - is-builtin Bool

next-id += 1
= DeclaredModule(next-id, name, path, is-builtin)

────────────────────
_ do import-module DeclaredModule ?! Error
    - name String
    - scope DeclaredModule?

if scope && scope.name == name
    = scope
if name.ends-with(".h")
    = c-module(name, scope)
. resolved = resolver.resolve-module(name, scope.path if scope)
if !resolved
    ?! Error("Module \"$name\" not found")
. path = resolved.path as String
. failed = failures[path]
if failed
    ?! Error(failed)
. cached = modules[path]
if cached
    = cached
. module = new-module(resolved.name, path, !scope || scope.is-builtin)
modules[path] = module
. outcome = catch declare-file(module)
if outcome is Error
    failures[path] = (outcome as Error).message
    ?! outcome as Error
= module

────────────────────
_ do c-module DeclaredModule ?! Error
    - name String
    - scope DeclaredModule?

. key = "c:$name"
. cached = modules[key]
if cached
    = cached
if !resolver.find-c-module(name)
    ?! Error("Module \"$name\" not found")
. module = new-module(name, key, !scope || scope.is-builtin)
modules[key] = module
= module

────────────────────
_ do declare-file ?! Error
    - module DeclaredModule

. text = read-file-text(Path(module.path))
. builder = parse-lint-text(text, module.path)
    catch YumiSyntaxError
        ?! Error("Syntax error")
. tree = use builder.finish(atoms)
declare(module, LintSource(module.path, text), tree)

────────────────────
_ do declare ?! Error
    - module DeclaredModule
    - source LintSource
    - tree AST

` Declares a module's imports and classes in the order written, and then the modules that the
` syntax it uses imports, and the builtin modules once those are declared.
for id in top-level-statements(tree)
    do match? tree.nodes[id]
        | .node-import-syntax(row)
            . imported = import-module(import-path-text(tree, row.paths), module)
            if imported.id != module.id
                module.imports += DeclaredImport(imported, row.is-export)
        | .node-class-block(row)
            declare-class(module, source, tree, row)
        | .node-extension(row)
            check-extension(tree, row)

if !module.is-builtin && uses-stream-syntax(tree)
    for name in stream-module-names
        import-implicitly(module, name)
if lacks(module, markup-module-name) && uses-markup-syntax(tree)
    import-implicitly(module, markup-module-name)
if lacks(module, style-module-name) && uses-style-sheet-syntax(tree)
    import-implicitly(module, style-module-name)
if is-initialized && !initialize-error && builtins.length != 0
    for builtin in builtins
        module.imports += DeclaredImport(builtin, false)

────────────────────
_ lacks Bool
    - module DeclaredModule
    - name String

module.name != name && !module.imports-named(name)

────────────────────
_ do import-implicitly ?! Error
    - module DeclaredModule
    - name String

. imported = import-module(name, module)
if imported.id != module.id
    module.imports += DeclaredImport(imported, false)

━━━━━━━━━━━━━━━━━━━━
+ DeclaredModule

` A module's classes and type aliases, and the modules it imports, as the reference declares a
` module for finding classes by name.
+ id Int
+ name String
+ path String
+ is-builtin Bool
+ classes [DeclaredClass]
+ classes-by-name [String = [DeclaredClass]]
+ aliases [String = DeclaredClass]
+ imports [DeclaredImport]

────────────────────
+ This
    - id Int
    - name String
    - path String
    - is-builtin Bool

────────────────────
+ do add-class
    - declared DeclaredClass

declared.index = classes.length as Int
classes += declared
. named = classes-by-name[declared.name]
if named
    named += declared
else
    . list [DeclaredClass]
    list += declared
    classes-by-name[declared.name] = list

────────────────────
+ do imports-named Bool
    - name String

for imported in imports
    if imported.module.name == name
        = true
= false

────────────────────
+ do classes-named [DeclaredClass]
    - name String

` The classes a name finds from this module: its own, and the public ones of the modules it
` imports and those they export. As in the reference, a module that exports nothing counts again
` each time an import reaches it.
. found [DeclaredClass]
. visited [Int = Bool]
collect(name, true, visited, found)
= found

────────────────────
+ do collect
    - name String
    - is-access Bool
    - visited [Int = Bool]
    - found [DeclaredClass]

if visited[id]
    =
. is-marked = false
for imported in imports
    if is-access || imported.is-export
        if !is-marked
            visited[id] = true
            is-marked = true
        imported.module.collect(name, false, visited, found)
. named = classes-by-name[name]
if named
    for declared in named
        if declared.is-public || is-access
            found += declared
. alias = aliases[name]
if alias && (alias.is-public || is-access)
    found += alias

━━━━━━━━━━━━━━━━━━━━
+ DeclaredImport is Tuple

+ module DeclaredModule
+ is-export Bool

━━━━━━━━━━━━━━━━━━━━
+ DeclaredClass

` A class as the reference declares it: its type parameters, its bases in the order written, and
` its public functions in the order of their buckets and then of where they are.
+ name String
+ module DeclaredModule
+ line U32
+ index = 0
+ is-public = false
+ param-count = 0
+ bases [DeclaredBase]
+ callables [DeclaredCallable]

────────────────────
+ This
    - name String
    - module DeclaredModule

━━━━━━━━━━━━━━━━━━━━
+ DeclaredBase is Tuple

` A type a class names as its base, where `is-inherited`, or as an interface it implements, with
` the name and type parameter count it refers to a class by, if it refers to one that way.
+ is-inherited Bool
+ type-name String
+ reference String?
+ reference-params Int

━━━━━━━━━━━━━━━━━━━━
+ DeclaredCallable is Tuple

` A public function of a class that an interface or base type can require, by the bucket it goes
` in, its signature, and its place among the class's public functions.
+ bucket String
+ signature String
+ order Int
+ node SyntaxId

━━━━━━━━━━━━━━━━━━━━
+ CallableEntry is Tuple

+ bucket String
+ signature String
+ bucket-index Int
+ line U32
+ column U32
+ node SyntaxId

━━━━━━━━━━━━━━━━━━━━
+ ResolvedClass is Tuple

+ declared DeclaredClass
+ header-name String

━━━━━━━━━━━━━━━━━━━━
+ Requirement is Tuple

` A public function a base type or interface declares, which a class's function with the same
` signature implements, under the section named for that type.
+ signature String
+ bucket String
+ order Int
+ header-name String
+ group Int

━━━━━━━━━━━━━━━━━━━━
+ ClassDeclaration

` The members of one class as the reference declares them, failing as it does on a member that
` redefines another, and the public functions among them.
+ source LintSource
+ tree AST
+ declared DeclaredClass
_ properties [String = Bool]
_ members [String = Bool]
_ style-rules [String = Bool]
_ has-content = false
_ entries [CallableEntry]

────────────────────
+ This
    - source LintSource
    - tree AST
    - declared DeclaredClass

────────────────────
+ do declare-members ?! Error
    - ids RowRange'SyntaxId

for id in tree.children[ids]
    declare-member(id)
. sorted = sort(entries) • using compare-entries
. order = 0
for entry in sorted
    declared.callables += DeclaredCallable(entry.bucket, entry.signature, order, entry.node)
    order += 1

────────────────────
_ do declare-member ?! Error
    - id SyntaxId

do match? tree.nodes[id]
    | .node-implements-declaration(row)
        declared.bases += declared-base(tree, row.type, false)
    | .node-property-syntax(row)
        declare-property(row)
    | .node-event-declaration(row)
        add-member(row.name.text)
    | .node-function-syntax(row)
        declare-function(id, row, false, false)
    | .node-converter-syntax(row)
        declare-converter(id, row.access, row.type, "public-converters")
    | .node-fromverter-syntax(row)
        declare-converter(id, row.access, row.type, "public-fromverters")
    | .node-rule-syntax(row)
        declare-style-rule(row)
    | .node-content-block
        set-content()

────────────────────
_ do declare-property ?! Error
    - row ASTProperty

do match tree.nodes[row.left]
    | .node-type-capture(capture)
        add-property(expression-name(tree, capture.id))
    ??
        add-member(declared-type-name(tree, row.left))

────────────────────
_ do add-property ?! Error
    - name String

if members[name]
    ?! Error("Redefinition of class member")
if properties[name]
    ?! Error("Redefinition of property")
properties[name] = true

────────────────────
_ do add-member ?! Error
    - name String

if members[name] || properties[name]
    ?! Error("Redefinition of class member")
members[name] = true

────────────────────
_ do set-content ?! Error

if has-content
    ?! Error("Only one content section permitted")
has-content = true

────────────────────
_ do declare-style-rule ?! Error
    - row ASTRule

. name = row.name.text
if name == "This" && row.args.count != 0
    ?! Error("Style rule \"This\" must be parameterless")
. types [String]
for arg in tree.children[row.args]
    types += argument-type-name(tree, arg)
. key = "$name\0${row.args.count}\0${"\0".join(types)}"
if style-rules[key]
    ?! Error("Redefinition of style rule")
style-rules[key] = true

────────────────────
_ do declare-converter ?! Error
    - id SyntaxId
    - access Access
    - type SyntaxId
    - bucket String

if access != .public-access
    ?! Error("Converters must be public")
. params [String]
declare-params(tree, type, params)
add-entry(id, bucket, "$bucket\0${declared-type-name(tree, type)}")

────────────────────
_ do declare-function ?! Error
    - id SyntaxId
    - row ASTFunction
    - getter Bool
    - setter Bool

. is-getter = getter || row.is-getter
. is-setter = setter || row.is-setter
if row.names.count != 1
    ?! Error("Not yet implemented")
. name = tree.atoms[row.names.start].text
if row.is-static && (is-getter || is-setter || name == "This")
    ?! Error("Static is only supported on ordinary type functions")
. params = function-params(tree, row)
check-defaults(tree, row)
if is-getter
    add-property(name)
    if row.access == .public-access
        add-entry(id, "public-getters", function-signature(row, name, "public-getters", params))
    =
if is-setter
    if !properties[name]
        add-property(name)
    if row.access == .public-access
        add-entry(id, "public-setters", function-signature(row, name, "public-setters", params))
    =
if name == "This" || row.is-static || row.access != .public-access
    =
. line = tree.nodes.loc[id].begin.line as Index
. header = if line < source.lines.length then source.lines[line] else ""
. operator = if source.is-brix then brix-operator else header-operator(name, header)
    .. brix-operator = brix-header-operator(name, header)
. bucket = operator-bucket(operator)
. called = if operator.length != 0 then operator else name
add-entry(id, bucket, function-signature(row, called, bucket, params))

────────────────────
_ do function-signature String
    - row ASTFunction
    - name String
    - bucket String
    - params [String]

. args [String]
for arg in tree.children[row.args]
    args += "${argument-call-name(tree, arg)}:${argument-type-name(tree, arg)}"
= "$bucket\0$name\0${params.length}\0${"\0".join(args)}"

────────────────────
_ do add-entry
    - id SyntaxId
    - bucket String
    - signature String

. place = tree.nodes.loc[id].begin
. index = bucket-order-index(bucket)
entries += CallableEntry(bucket, signature, index, place.line, place.column, id)

━━━━━━━━━━━━━━━━━━━━
+ compare-entries Comparison
    - left CallableEntry
    - right CallableEntry

|? left.bucket-index != right.bucket-index
    compare-basic(left.bucket-index, right.bucket-index)
|? left.line != right.line
    compare-basic(left.line, right.line)
??
    compare-basic(left.column, right.column)

━━━━━━━━━━━━━━━━━━━━
+ operator-bucket String
    - operator String

|? operator.length == 0
    "public-methods"
|? operator == "[]"
    "public-indexers"
|? operator == "[]="
    "public-index-setters"
|? operator == "-=[]"
    "public-index-deleters"
|? is-prefix-operator(operator)
    "public-prefix-operators"
??
    "public-operators"

━━━━━━━━━━━━━━━━━━━━
+ do function-params [String] ?! Error
    - tree AST
    - row ASTFunction

` The names of a function's type parameters: those it lists, and those its arguments declare.
. params [String]
for param in tree.children[row.type-args]
    params += declared-type-name(tree, param)
for arg in tree.children[row.args]
    do match? tree.nodes[arg]
        | .node-argument-decl(decl)
            declare-params(tree, decl.pattern, params)
= params

━━━━━━━━━━━━━━━━━━━━
+ do declare-params ?! Error
    - tree AST
    - type SyntaxId
    - params [String]

if type == 0
    =
do match? tree.nodes[type]
    | .node-type-identifier(row)
        if row.is-declare
            . name = row.name.text
            for param in params
                if param == name
                    ?! Error("Duplicate type parameter")
            params += name
    | .node-type-arguments(row)
        for arg in tree.children[row.args]
            declare-params(tree, arg, params)
    | .node-type-associated(row)
        declare-params(tree, row.owner, params)
        for arg in tree.children[row.args]
            declare-params(tree, arg, params)
    | .node-type-match(row)
        declare-params(tree, row.type, params)
    | .node-type-capture(row)
        declare-params(tree, row.type, params)

━━━━━━━━━━━━━━━━━━━━
+ do check-defaults ?! Error
    - tree AST
    - row ASTFunction

. has-started = false
for arg in tree.children[row.args]
    if has-default(tree, arg)
        has-started = true
    else if has-started
        ?! Error("Default value required")

━━━━━━━━━━━━━━━━━━━━
+ do has-default Bool
    - tree AST
    - arg SyntaxId

do match? tree.nodes[arg]
    | .node-argument-decl(decl)
        = decl.default-value != 0
= false

━━━━━━━━━━━━━━━━━━━━
+ do argument-call-name String
    - tree AST
    - arg SyntaxId

do match? tree.nodes[arg]
    | .node-argument-decl(decl)
        = pattern-name(tree, decl.pattern)
= ""

━━━━━━━━━━━━━━━━━━━━
+ do argument-type-name String
    - tree AST
    - arg SyntaxId

do match? tree.nodes[arg]
    | .node-argument-decl(decl)
        . name = declared-type-name(tree, decl.pattern)
        if decl.is-variadic
            = "$name..."
        = name
= ""

━━━━━━━━━━━━━━━━━━━━
+ pattern-name String
    - tree AST
    - pattern SyntaxId

match tree.nodes[pattern]
    | .node-type-capture(row)
        expression-name(tree, row.id)
    | .node-type-predicate(row)
        expression-name(tree, row.expr)
    ??
        ""

━━━━━━━━━━━━━━━━━━━━
+ do declared-type-name String
    - tree AST
    - type SyntaxId

` The name the reference gives a type as written.
if type == 0
    = ""
do match? tree.nodes[type]
    | .node-type-identifier(row)
        = row.name.text
    | .node-core-type-identifier(row)
        = row.name.text
    | .node-type-arguments(row)
        . names [String]
        names += declared-type-name(tree, row.base)
        for arg in tree.children[row.args]
            names += declared-type-name(tree, arg)
        = "'".join(names)
    | .node-type-associated(row)
        . text = "${declared-type-name(tree, row.owner)}.${row.name.text}"
        for arg in tree.children[row.args]
            text += "'${declared-type-name(tree, arg)}"
        = text
    | .node-type-match(row)
        = declared-type-name(tree, row.type)
    | .node-type-capture(row)
        = declared-type-name(tree, row.type)
    | .node-type-tuple(row)
        . names [String]
        for field in tree.children[row.field-types]
            names += declared-type-name(tree, field)
        . kind = if row.is-struct then "struct" else "tuple"
        = "$kind(${",".join(names)})"
    | .node-type-list(row)
        . names [String]
        for pattern in tree.children[row.patterns]
            names += declared-type-name(tree, pattern)
        = "list(${",".join(names)})"
    | .node-type-predicate(row)
        = expression-name(tree, row.expr)
= ""

━━━━━━━━━━━━━━━━━━━━
+ expression-name String
    - tree AST
    - id SyntaxId

match tree.nodes[id]
    | .node-identifier(row)
        row.name.text
    ??
        ""

━━━━━━━━━━━━━━━━━━━━
+ do declared-base DeclaredBase
    - tree AST
    - type SyntaxId
    - is-inherited Bool

. name = declared-type-name(tree, type)
do match? tree.nodes[type]
    | .node-type-identifier(row)
        = DeclaredBase(is-inherited, name, row.name.text, 0)
    | .node-type-arguments(row)
        do match? tree.nodes[row.base]
            | .node-type-identifier(base)
                = DeclaredBase(is-inherited, name, base.name.text, row.args.count)
= DeclaredBase(is-inherited, name, null, 0)

━━━━━━━━━━━━━━━━━━━━
+ do declare-class ?! Error
    - module DeclaredModule
    - source LintSource
    - tree AST
    - row ASTClassBlock

. declared = DeclaredClass(row.name.text, module)
declared.line = row.loc.begin.line
declared.is-public = row.access == .public-access
declared.param-count = row.type-args.count as Int
if row.base != 0
    declared.bases += declared-base(tree, row.base, true)
ClassDeclaration(source, tree, declared).declare-members(row.members)
module.add-class(declared)
for offset in 0 .. < row.aliases.count
    module.aliases[tree.atoms[row.aliases.start + offset].text] = declared

━━━━━━━━━━━━━━━━━━━━
+ do check-extension ?! Error
    - tree AST
    - row ASTExtension

if row.as-types.count != 0
    ?! Error("Not yet implemented")
for member in tree.children[row.body]
    do match? tree.nodes[member]
        | .node-property-syntax
            ?! Error("Stored properties are not allowed in extensions")
        | .node-function-syntax(function)
            check-extension-function(tree, function)
        | .node-converter-syntax
            continue
        | .node-fromverter-syntax
            continue
        ?! Error("Statement can not be used in extensions")

━━━━━━━━━━━━━━━━━━━━
+ do check-extension-function ?! Error
    - tree AST
    - row ASTFunction

if row.is-setter
    ?! Error("Setters are not allowed in extensions")
if row.names.count != 1
    ?! Error("Not yet implemented")
if tree.atoms[row.names.start].text == "This"
    =
function-params(tree, row)
check-defaults(tree, row)

━━━━━━━━━━━━━━━━━━━━
+ do method-order-index MethodOrderIndex
    - module DeclaredModule

. index = MethodOrderIndex()
for declared in module.classes
    add-metadata(declared, index)
= index

━━━━━━━━━━━━━━━━━━━━
+ do add-metadata
    - declared DeclaredClass
    - index MethodOrderIndex

` Places each public function of a class that overrides a function of a base type, and then each
` that implements a function of an interface, under a section for that type.
. current = unique-callables(declared.callables)
if current.length == 0
    =
. chain = base-chain(declared)
if !chain
    =
. lineage [DeclaredClass]
for resolved in chain
    lineage += resolved.declared
lineage += declared
. interfaces = interface-order(lineage)
. required [String = Bool]
. ordered [Requirement]
. seen [String = Bool]
for group in 0 .. < interfaces.length
    . iface = interfaces[group]
    . counts = signature-counts(iface.declared.callables)
    for callable in iface.declared.callables
        required[callable.signature] = true
        if !seen[callable.signature]
            seen[callable.signature] = true
            if counts[callable.signature] == 1
                ordered += requirement(callable, iface.header-name, group)

. base-counts [String = Int]
for resolved in chain
    for callable in resolved.declared.callables
        base-counts[callable.signature] = (base-counts[callable.signature] ?? 0) + 1
for group in 0 .. < chain.length
    . resolved = chain[group]
    for callable in resolved.declared.callables
        if base-counts[callable.signature] == 1 && !required[callable.signature]
            . found = current[callable.signature]
            if found
                . item = requirement(callable, resolved.header-name, group)
                add-method(found, override-priority-base, item, index)
for item in ordered
    . found = current[item.signature]
    if found
        add-method(found, interface-priority-base, item, index)

━━━━━━━━━━━━━━━━━━━━
+ requirement Requirement
    - callable DeclaredCallable
    - header-name String
    - group Int

Requirement(callable.signature, callable.bucket, callable.order, header-name, group)

━━━━━━━━━━━━━━━━━━━━
+ do add-method
    - callable DeclaredCallable
    - base Int
    - item Requirement
    - index MethodOrderIndex

if index.metadata[callable.node]
    =
. placement = bucket-order-index(item.bucket) * bucket-stride + item.order
. priority = base + item.group * group-stride + placement
. header = labeled-divider("is ${item.header-name}")
index.metadata[callable.node] = MethodOrderMetadata(priority, header)

━━━━━━━━━━━━━━━━━━━━
+ do base-chain [ResolvedClass]?
    - declared DeclaredClass

` The base types a class inherits from, its root first, or none where a class inherits from more
` than one or from one that is not found once.
. chain [ResolvedClass]
. seen [DeclaredClass]
seen += declared
. current = declared
while true
    . inherited [DeclaredBase]
    for base in current.bases
        if base.is-inherited
            inherited += base
    if inherited.length == 0
        break
    if inherited.length != 1
        = null
    . parent = resolve-class(current, inherited[0])
    if !parent || contains-class(seen, parent)
        = null
    chain += ResolvedClass(parent, inherited[0].type-name)
    seen += parent
    current = parent
. reversed [ResolvedClass]
for offset in 0 .. < chain.length
    reversed += chain[chain.length - 1 - offset]
= reversed

━━━━━━━━━━━━━━━━━━━━
+ do interface-order [ResolvedClass]
    - lineage [DeclaredClass]

. interfaces [ResolvedClass]
for declared in lineage
    for base in declared.bases
        if !base.is-inherited
            . found = resolve-class(declared, base)
            if found
                interfaces += ResolvedClass(found, base.type-name)
= interfaces

━━━━━━━━━━━━━━━━━━━━
+ do resolve-class DeclaredClass?
    - owner DeclaredClass
    - base DeclaredBase

` The one class a base names from its owner's module, with as many type parameters as it gives.
. reference = base.reference
if !reference
    = null
. found DeclaredClass? = null
. count = 0
for candidate in owner.module.classes-named(reference)
    if candidate.param-count == base.reference-params
        found = candidate
        count += 1
if count != 1
    = null
= found

━━━━━━━━━━━━━━━━━━━━
+ do contains-class Bool
    - list [DeclaredClass]
    - declared DeclaredClass

for item in list
    if item.module.id == declared.module.id && item.index == declared.index
        = true
= false

━━━━━━━━━━━━━━━━━━━━
+ do unique-callables [String = DeclaredCallable]
    - callables [DeclaredCallable]

. counts = signature-counts(callables)
. unique [String = DeclaredCallable]
for callable in callables
    if counts[callable.signature] == 1
        unique[callable.signature] = callable
= unique

━━━━━━━━━━━━━━━━━━━━
+ do signature-counts [String = Int]
    - callables [DeclaredCallable]

. counts [String = Int]
for callable in callables
    counts[callable.signature] = (counts[callable.signature] ?? 0) + 1
= counts

━━━━━━━━━━━━━━━━━━━━
+ bucket-order-index Int
    - bucket String

if found then found.index else 0

.. found = type-member-order-spec()[bucket]

━━━━━━━━━━━━━━━━━━━━
+ do top-level-statements [SyntaxId]
    - tree AST

. found [SyntaxId]
do match? tree.nodes[tree.root]
    | .node-top-level-syntax(root)
        for id in tree.children[root.statements]
            found += id
= found
