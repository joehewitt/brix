(import ./source)
(import /core/atom-pool)
(import /lang/ast/ast)
(import /lang/ast/ast-children)
(import /lang/ast/ast-nodes)
(import /lang/ast/error)
(import /lang/ast/module-resolver)
(import /lang/ast/operator)
(import /lang/ast/row-range)
(import /lang/reader/brix)
(import /lang/target)
(import /os/file)
(import /os/path)
(import /stream/aggregate)
(blank)
(prop + local-origin-name _ (= "__source__"))

(type + NameSymbol
  ; A declared name, and where only some targets' builds see it, the names of those targets.
  (blank)
  (prop + namespace String)
  (prop + kind String)
  (prop + name String)
  (prop + line U32)
  (prop + column U32)
  (prop + origin-name String)
  (prop + origin-path String)
  (prop + origin-key String)
  (prop + call-shape (? FunctionCallShape))
  (prop + import-priority _ (= -1))
  (prop + import-line U32)
  (prop + import-column U32)
  (prop + builds (? (list String)))
  (fn-do + This _
    (param namespace String)
    (param kind String)
    (param name String)
    (param site SymbolSite)
    ; A name declared at `site`, whose origin key tells its declaration from every other one.
    (= line (. site line))
    (= column (. site column))
    (= origin-name (. site origin-name))
    (= origin-path (. site origin-path))
    (= origin-key (str module-key ":" kind ":" name ":" line ":" column))
  )
  (fn-do + imported-by NameSymbol
    (param priority Int)
    (param entry ImportEntry)
    (param builds (? (list String)))
    ; This symbol as brought in by the direct import `entry`, the `priority`th of its module, in the
    ; builds of `builds`.
    (let copy (call NameSymbol namespace kind name (call SymbolSite line column origin-name origin-path)))
    (= (. copy origin-key) origin-key)
    (= (. copy call-shape) call-shape)
    (= (. copy import-priority) priority)
    (= (. copy import-line) (. entry begin-line))
    (= (. copy import-column) (. entry begin-column))
    (= (. copy builds) builds)
    (return copy)
  )
  (fn-do + shares-build Bool
    (param other NameSymbol)
    ; Whether the build for some target sees both this symbol and `other`.
    (for (in target (call targets))
      (if (and (call sees (. target name)) (call (. other sees) (. target name)))
        (return true)
      )
    )
    (return false)
  )
  (fn-expr + sees Bool
    (param target String)
    (or (not builds) (!= (call (. builds find) target) null))
  )
  (fn-expr + key String :get
    (str namespace ":" name)
  )
  (fn-expr + module-key String :get
    (if-expr (!= (. origin-path length) 0) origin-path origin-name)
  )
  (fn-expr + origin-label String :get
    (case? (!= (. origin-name length) 0)
      origin-name
    )
    (case? (!= (. origin-path length) 0)
      origin-path
    )
    (default
      "<unknown>"
    )
  )
)

(type + FunctionCallShape (is Tuple)
  (prop + minimum U32)
  (prop + maximum U32)
  (prop + labels (list String))
  (prop + no-args Bool)
)

(type + SymbolSite (is Tuple)
  (prop + line U32)
  (prop + column U32)
  (prop + origin-name String)
  (prop + origin-path String)
)

(type + TypeParam (is Tuple)
  (prop + name String)
  (prop + line U32)
  (prop + column U32)
)

(type + ImportEntry
  (prop + import-path String)
  (prop + is-export Bool)
  (prop + begin-line U32)
  (prop + begin-column U32)
  (prop + end-line U32)
  (prop + end-column U32)
  (prop + resolved-name (? String))
  (prop + resolved-path (? String))
  (fn-do + This _
    (param import-path String)
    (param is-export Bool)
    (param loc MatchLocation)
    (= begin-line (. loc begin line))
    (= begin-column (. loc begin column))
    (= end-line (. loc end line))
    (= end-column (. loc end column))
  )
)

(type + ModuleAnalysis
  (prop + source LintSource)
  (prop + tree AST)
  (prop + imports (list ImportEntry))
  (prop + local-symbols (list NameSymbol))
  (prop + imported-symbols (list NameSymbol))
  (prop + type-params (list TypeParam))
  (prop + analyzer (? SymbolAnalyzer))
  (fn-do + This _
    (param source LintSource)
    (param tree AST)
  )
)

(type + ExportedModule
  (prop + name String)
  (prop + path String)
  (prop + symbols (list NameSymbol))
  (prop + imports (list ImportEntry))
  (prop + exports (list ImportEntry))
  (prop + classes (list StyleClass))
  (fn-do + This _
    (param name String)
    (param path String)
  )
)

(type + SymbolAnalyzer
  (prop + atoms AtomPool)
  (prop + resolver ModuleResolver)
  (prop _ modules (map String ExportedModule))
  (fn-do + This _
    (param search-paths (list Path))
    (let c-paths (map String (list Path)))
    (= resolver (call ModuleResolver search-paths c-paths))
  )
  (fn-expr + parse-source AST
    (param source LintSource)
    (call (. builder finish) atoms)
    (where
      (lazy builder (call parse-brix (. source text) (. source path)))
    )
  )
  (fn-do + analyze ModuleAnalysis
    (param source LintSource)
    (param tree AST)
    (let analysis (call ModuleAnalysis source tree))
    (= (. analysis analyzer) this)
    (= (. analysis imports) (call collect-imports tree))
    (= (. analysis local-symbols) (call collect-symbols tree local-origin-name (. source path) false))
    (= (. analysis type-params) (call collect-type-params tree))
    (blank)
    (let seen (map String Index))
    (let builds (call narrowed-builds null (. source path)))
    (let priority 0)
    (for (in entry (. analysis imports))
      (let position priority)
      (+= priority 1)
      (let resolved (call (. resolver resolve-module) (. entry import-path) (. source path)))
      (if (not resolved)
        (continue)
      )
      (blank)
      (let found resolved)
      (let resolved-name (call module-display-name (. found name)))
      (let resolved-path (as (. found path) String))
      (= (. entry resolved-name) resolved-name)
      (= (. entry resolved-path) resolved-path)
      (let visited (map String Bool))
      (let output (. analysis imported-symbols))
      (call collect-exported resolved-path resolved-name position entry builds visited seen output)
    )
    (blank)
    (return analysis)
  )
  (fn-do _ collect-exported _ (?! Error)
    (param path String)
    (param name String)
    (param priority Int)
    (param direct ImportEntry)
    (param builds (? (list String)))
    (param visited (map String Bool))
    (param seen (map String Index))
    (param output (list NameSymbol))
    ; Adds the public symbols of a module and then of the modules it exports, the last exported
    ; first, as the direct import that reaches them brings them in, in the builds of `builds` that
    ; load each module on the way. A symbol a later direct import also reaches takes that import's
    ; place, and is seen in the builds of both.
    (if ([] visited path)
      (return)
    )
    (= ([] visited path) true)
    (blank)
    (let module (call exported-module path name))
    (if (not module)
      (return)
    )
    (blank)
    (let loaded (call narrowed-builds builds path))
    (for (in symbol (. module symbols))
      (let key (str (. symbol key) ":" (. symbol origin-key)))
      (if (== (. symbol kind) "c-function")
        (+= key (str ":" path))
      )
      (let known ([] seen key))
      (if (!= known null)
        (let kept ([] output known))
        (let joined (call joined-builds (. kept builds) loaded))
        (if (> priority (. kept import-priority))
          (= ([] output known) (call (. symbol imported-by) priority direct joined))
          (else
            (= (. kept builds) joined)
          )
        )
        (continue)
      )
      (= ([] seen key) (. output length))
      (+= output (call (. symbol imported-by) priority direct loaded))
    )
    (blank)
    (for (in position (..< 0 (. module exports length)))
      (let entry ([] (. module exports) (- (. module exports length) 1 position)))
      (let resolved (call (. resolver resolve-module) (. entry import-path) path))
      (if resolved
        (let found resolved)
        (let found-path (as (. found path) String))
        (let found-name (call module-display-name (. found name)))
        (call collect-exported found-path found-name priority direct loaded visited seen output)
      )
    )
  )
  (fn-do _ exported-module (? ExportedModule)
    (param path String)
    (param name String)
    (let cached ([] modules path))
    (if cached
      (return cached)
    )
    (if (call (. path ends-with) ".h")
      (return (call c-header-module path name))
    )
    (if (not (. (call Path path) is-file))
      (return null)
    )
    (blank)
    (let text (call read-file-text (call Path path)))
    (let builder
      (call parse-brix text path
        (block
          (on-error BrixSyntaxError
            (return null)
          )
        )
      )
    )
    (let tree (use (call (. builder finish) atoms)))
    (blank)
    (let module (call ExportedModule name path))
    (= (. module symbols) (call declared-order (call collect-symbols tree name path true)))
    (= (. module classes) (call collect-style-classes tree path true))
    (for (in entry (call collect-imports tree))
      (+= (. module imports) entry)
      (if (. entry is-export)
        (+= (. module exports) entry)
      )
    )
    (blank)
    (= ([] modules path) module)
    (return module)
  )
  (fn-expr + module-at (? ExportedModule)
    (param path String)
    ; The module loaded from `path`, if one is.
    ([] modules path)
  )
  (fn-do + imported-module (? ExportedModule)
    (param entry ImportEntry)
    (param from String)
    ; The module an import names, resolved from the module at `from`, or none where it is not found
    ; or does not parse.
    (if (not (. entry resolved-path))
      (let resolved (call (. resolver resolve-module) (. entry import-path) from))
      (if (not resolved)
        (return null)
      )
      (let found resolved)
      (= (. entry resolved-name) (call module-display-name (. found name)))
      (= (. entry resolved-path) (as (. found path) String))
    )
    (let module
      (scope (catch (call exported-module (!! (. entry resolved-path)) (?? (. entry resolved-name) "")))
        (on-error Error
          (return null)
        )
      )
    )
    (return module)
  )
  (fn-do _ c-header-module ExportedModule
    (param path String)
    (param name String)
    (let module (call ExportedModule name path))
    (let counts (map String Int))
    (for (in function (call (. resolver c-module-functions) path))
      (let symbol (call NameSymbol "c-value" "c-function" (. function name) (call SymbolSite 0 0 name path)))
      (let index (?? ([] counts (. function name)) 0))
      (= ([] counts (. function name)) (+ index 1))
      (let declared (. function declaration-key))
      (if declared
        (= (. symbol origin-key) (str "c-declaration:" declared))
        (else
          (+= (. symbol origin-key) (str ":" index))
        )
      )
      (+= (. module symbols) symbol)
    )
    (blank)
    (= ([] modules path) module)
    (return module)
  )
)

(fn-do _ narrowed-builds (? (list String))
  (param builds (? (list String)))
  (param path String)
  ; Of the targets in `builds`, those whose builds load the module at `path`. Null stands for every
  ; target, in `builds` and in the result.
  (let suffix (call platform-suffix path))
  (return-if builds (if (or (not suffix) (not (call is-platform suffix)))))
  (blank)
  (let narrowed (list String))
  (for (in target (call targets))
    (if (and (call (. target includes) suffix) (or (not builds) (!= (call (. builds find) (. target name)) null)))
      (+= narrowed (. target name))
    )
  )
  (return narrowed)
)

(fn-do _ joined-builds (? (list String))
  (param first (? (list String)))
  (param second (? (list String)))
  ; The targets in `first` or in `second`, where null stands for every target.
  (return-if null (if (or (not first) (not second))))
  (blank)
  (let joined (list String))
  (++= joined first)
  (for (in target second)
    (if (== (call (. joined find) target) null)
      (+= joined target)
    )
  )
  (return joined)
)

(type + StyleClass
  ; What the style shorthand rule reads of a type a module declares: the types it uses or
  ; implements, by name where written as one, whether it is a style, the properties it declares, and
  ; its style rules with the property each one forwards its one argument to, if any.
  (blank)
  (prop + name String)
  (prop + module-path String)
  (prop + key String)
  (prop + aliases (list String))
  (prop + is-public Bool)
  (prop + references (list String))
  (prop + is-style Bool)
  (prop + properties (map String Bool))
  (prop + rules (list String))
  (prop + forwarded (list String))
  (fn-do + This _
    (param name String)
    (param module-path String)
    (param key String)
  )
  (fn-do + names Bool
    (param name String)
    (if (== (. this name) name)
      (return true)
    )
    (for (in alias aliases)
      (if (== alias name)
        (return true)
      )
    )
    (return false)
  )
)

(fn-do + collect-style-classes (list StyleClass)
  (param tree AST)
  (param path String)
  (param imported Bool)
  ; The types a module declares, as declared where `imported`, or else as the linted source
  ; writes them.
  (let classes (list StyleClass))
  (match ([] (. tree nodes) (. tree root))
    (case (call .node-top-level-syntax root)
      (for (in id ([] (. tree children) (. root statements)))
        (match? ([] (. tree nodes) id)
          (case (call .node-class-block row)
            (+= classes (call style-class tree id row path imported))
          )
        )
      )
    )
    (throw (call Panic "AST root has the wrong syntax case"))
  )
  (return classes)
)

(fn-do + style-class StyleClass
  (param tree AST)
  (param id SyntaxId)
  (param row ASTClassBlock)
  (param path String)
  (param imported Bool)
  ; A declared type, whose properties are its fields, and where `imported` also its getters and
  ; setters. It is a style where a base it implements is `Style`, and also where it uses `Style`
  ; unless `imported`.
  (let found (call StyleClass (. row name text) path (str path "#" id)))
  (= (. found is-public) (== (. row access) .public-access))
  (for (in offset (..< 0 (. row aliases count)))
    (+= (. found aliases) (. ([] (. tree atoms) (+ (. row aliases start) offset)) text))
  )
  (blank)
  (let bases (list SyntaxId))
  (let usings (list SyntaxId))
  (if (!= (. row base) 0)
    (+= bases (. row base))
  )
  (for (in member ([] (. tree children) (. row members)))
    (match? ([] (. tree nodes) member)
      (case (call .node-implements-declaration declaration)
        (+= bases (. declaration type))
      )
      (case (call .node-using-declaration declaration)
        (+= usings (. declaration type))
      )
      (case (call .node-property-syntax property)
        (= ([] (. found properties) (call declared-name tree (. property left))) true)
      )
      (case (call .node-getter-syntax getter)
        (if (and imported (!= (. getter names count) 0))
          (= ([] (. found properties) (. ([] (. tree atoms) (. getter names start)) text)) true)
        )
      )
      (case (call .node-setter-syntax setter)
        (if (and imported (!= (. setter names count) 0))
          (= ([] (. found properties) (. ([] (. tree atoms) (. setter names start)) text)) true)
        )
      )
      (case (call .node-rule-syntax rule)
        (+= (. found rules) (. rule name text))
        (+= (. found forwarded) (call forwarded-property tree rule))
      )
    )
  )
  (blank)
  (for (in type usings)
    (+= (. found references) (call plain-type-name tree type))
    (if (and (not imported) (== (call type-name tree type) "Style"))
      (= (. found is-style) true)
    )
  )
  (for (in type bases)
    (+= (. found references) (call plain-type-name tree type))
    (if (== (call type-name tree type) "Style")
      (= (. found is-style) true)
    )
  )
  (return found)
)

(fn-expr + plain-type-name String
  (param tree AST)
  (param id SyntaxId)
  (match ([] (. tree nodes) id)
    (case (call .node-type-identifier row)
      (. row name text)
    )
    (default
      ""
    )
  )
)

(fn-do + forwarded-property String
  (param tree AST)
  (param rule ASTRule)
  ; The property a style rule sets to its one argument and does nothing else, or none.
  (if (or (!= (. rule args count) 1) (!= (. rule style-rule-applications count) 0))
    (return "")
  )
  (let parameter
    (match ([] (. tree nodes) ([] (. tree children) (. rule args start)))
      (case (call .node-argument-decl arg)
        arg
      )
      (default
        (return "")
      )
    )
  )
  (if (or (. parameter is-variadic) (!= (. parameter default-value) 0))
    (return "")
  )
  (match? ([] (. tree nodes) (. rule body))
    (case (call .node-block block)
      (if (!= (. block body count) 1)
        (return "")
      )
      (let statement ([] (. tree children) (. block body start)))
      (match? ([] (. tree nodes) statement)
        (case (call .node-assign assignment)
          (let left (call identifier-name tree (. assignment lhs)))
          (let right (call identifier-name tree (. assignment rhs)))
          (let argument (call declared-name tree (. parameter pattern)))
          (if (and (!= (. right length) 0) (== right argument) (not (call is-tracked-name tree (. assignment rhs))))
            (return left)
          )
        )
      )
    )
  )
  (return "")
)

(fn-expr + identifier-name String
  (param tree AST)
  (param id SyntaxId)
  (match ([] (. tree nodes) id)
    (case (call .node-identifier row)
      (. row name text)
    )
    (default
      ""
    )
  )
)

(fn-expr + is-tracked-name Bool
  (param tree AST)
  (param id SyntaxId)
  (match ([] (. tree nodes) id)
    (case (call .node-identifier row)
      (. row is-tracked)
    )
    (default
      false
    )
  )
)

(fn-do + declared-order (list NameSymbol)
  (param symbols (list NameSymbol))
  ; Symbols in the order a declared module lists them: its globals, functions, types and then type
  ; aliases, each in the order written.
  (let ordered (list NameSymbol))
  (for (in rank (..< 0 4))
    (for (in symbol symbols)
      (if (== (call declared-rank (. symbol kind)) rank)
        (+= ordered symbol)
      )
    )
  )
  (return ordered)
)

(fn-expr + declared-rank Int
  (param kind String)
  (case? (== kind "global")
    0
  )
  (case? (== kind "function")
    1
  )
  (case? (== kind "type-alias")
    3
  )
  (default
    2
  )
)

(fn-expr + module-display-name String
  (param name String)
  (if-expr (call (. name starts-with) "/") ([] name (... 1)) name)
)

(fn-do + collect-imports (list ImportEntry)
  (param tree AST)
  (let entries (list ImportEntry))
  (match ([] (. tree nodes) (. tree root))
    (case (call .node-top-level-syntax root)
      (for (in id ([] (. tree children) (. root statements)))
        (match? ([] (. tree nodes) id)
          (case (call .node-import-syntax import)
            (let text (call import-path-text tree (. import paths)))
            (+= entries (call ImportEntry text (. import is-export) (. import loc)))
          )
        )
      )
    )
    (throw (call Panic "AST root has the wrong syntax case"))
  )
  (blank)
  (return entries)
)

(fn-expr + import-path-text String
  (param tree AST)
  (param paths (of RowRange Atom))
  (call (. "/" join) (in (. ([] (. tree atoms) (+ (. paths start) each)) text) (..< 0 (. paths count))))
)

(fn-do + collect-symbols (list NameSymbol)
  (param tree AST)
  (param origin-name String)
  (param origin-path String)
  (param only-public Bool)
  (let symbols (list NameSymbol))
  (match ([] (. tree nodes) (. tree root))
    (case (call .node-top-level-syntax root)
      (for (in id ([] (. tree children) (. root statements)))
        (call collect-statement-symbols tree id origin-name origin-path only-public symbols)
      )
    )
    (throw (call Panic "AST root has the wrong syntax case"))
  )
  (blank)
  (return symbols)
)

(fn-do _ collect-statement-symbols _
  (param tree AST)
  (param id SyntaxId)
  (param origin-name String)
  (param origin-path String)
  (param only-public Bool)
  (param symbols (list NameSymbol))
  (let loc ([] (. tree nodes loc) id))
  (let site (call SymbolSite (. loc begin line) (. loc begin column) origin-name origin-path))
  (blank)
  (match? ([] (. tree nodes) id)
    (case (call .node-class-block row)
      (if (and only-public (!= (. row access) .public-access))
        (return)
      )
      (blank)
      (let kind (if-expr (. row is-style-sheet) "style-sheet" "type"))
      (+= symbols (call NameSymbol "type" kind (. row name text) site))
      (for (in offset (..< 0 (. row aliases count)))
        (let alias (. ([] (. tree atoms) (+ (. row aliases start) offset)) text))
        (+= symbols (call NameSymbol "type" "type-alias" alias site))
      )
    )
    (blank)
    (case (call .node-function-syntax row)
      (if (and only-public (!= (. row access) .public-access))
        (return)
      )
      (blank)
      (for (in offset (..< 0 (. row names count)))
        (let name (. ([] (. tree atoms) (+ (. row names start) offset)) text))
        (if (!= (. name length) 0)
          (let symbol (call NameSymbol "value" "function" name site))
          (= (. symbol call-shape) (call function-call-shape tree row))
          (+= symbols symbol)
        )
      )
    )
    (blank)
    (case (call .node-property-syntax row)
      (if (and only-public (!= (. row access) .public-access))
        (return)
      )
      (blank)
      (let name (call declared-name tree (. row left)))
      (if (== (. name length) 0)
        (return)
      )
      (blank)
      (+= symbols (call NameSymbol "value" "global" name site))
      (if (and (!= (. row value) 0) (call is-state-machine tree (. row value)))
        (+= symbols (call NameSymbol "type" "type" name site))
      )
    )
  )
)

(fn-do + function-call-shape (? FunctionCallShape)
  (param tree AST)
  (param function ASTFunction)
  (let minimum 0u32)
  (let labels (map String Bool))
  (let call-names (list String))
  (for (in id ([] (. tree children) (. function args)))
    (match ([] (. tree nodes) id)
      (case (call .node-argument-decl arg)
        (if (. arg is-variadic)
          (return null)
        )
        (let label (call declared-name tree (. arg pattern)))
        (+= call-names label)
        (if (!= (. label length) 0)
          (if ([] labels label)
            (return null)
          )
          (= ([] labels label) true)
        )
        (if (== (. arg default-value) 0)
          (+= minimum 1)
        )
      )
      (default
        (return null)
      )
    )
  )
  (let generic (+ (. function type-args count) (. function param-constraints count)))
  (+= generic (. function param-assignments count))
  (return (call FunctionCallShape minimum (. function args count) call-names (== (+ (. function args count) generic) 0)))
)

(fn-expr + is-state-machine Bool
  (param tree AST)
  (param id SyntaxId)
  (match ([] (. tree nodes) id)
    (case .node-state-machine
      true
    )
    (default
      false
    )
  )
)

(fn-expr + declared-name String
  (param tree AST)
  (param id SyntaxId)
  (match ([] (. tree nodes) id)
    (case (call .node-identifier row)
      (. row name text)
    )
    (case (call .node-ref-identifier row)
      (. row name text)
    )
    (case (call .node-type-capture row)
      (call declared-name tree (. row id))
    )
    (default
      ""
    )
  )
)

(fn-expr + type-name String
  (param tree AST)
  (param id SyntaxId)
  (match ([] (. tree nodes) id)
    (case (call .node-type-identifier row)
      (. row name text)
    )
    (case (call .node-type-arguments row)
      (call type-name tree (. row base))
    )
    (default
      ""
    )
  )
)

(fn-do + collect-type-params (list TypeParam)
  (param tree AST)
  (let params (list TypeParam))
  (let seen (map String Bool))
  (let total (. tree nodes length))
  (blank)
  (for (in id (..< 1u32 total))
    (match? ([] (. tree nodes) id)
      (case (call .node-class-block row)
        (call add-type-args tree (. row type-args) params seen)
      )
      (case (call .node-function-syntax row)
        (call add-type-args tree (. row type-args) params seen)
      )
      (case (call .node-getter-syntax row)
        (call add-type-args tree (. row type-args) params seen)
      )
      (case (call .node-setter-syntax row)
        (call add-type-args tree (. row type-args) params seen)
      )
      (case (call .node-type-identifier row)
        (if (. row is-declare)
          (call add-type-param tree (as id SyntaxId) (. row name text) params seen)
        )
      )
    )
  )
  (blank)
  (return params)
)

(fn-do _ add-type-args _
  (param tree AST)
  (param range (of RowRange SyntaxId))
  (param params (list TypeParam))
  (param seen (map String Bool))
  (for (in child ([] (. tree children) range))
    (let name (call type-name tree child))
    (if (!= (. name length) 0)
      (call add-type-param tree child name params seen)
    )
  )
)

(fn-do _ add-type-param _
  (param tree AST)
  (param id SyntaxId)
  (param name String)
  (param params (list TypeParam))
  (param seen (map String Bool))
  (let loc ([] (. tree nodes loc) id))
  (let key (str name ":" (. loc begin line) ":" (. loc begin column)))
  (if ([] seen key)
    (return)
  )
  (blank)
  (= ([] seen key) true)
  (+= params (call TypeParam name (. loc begin line) (. loc begin column)))
)
