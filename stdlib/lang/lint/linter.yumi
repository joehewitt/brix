━━━━━━━━━━━━━━━━━━━━
+ Linter

+ project-root String
+ search-path String
+ config LintConfig
+ catalog [LintRule]
+ active-rules [LintRule]
_ analyzer SymbolAnalyzer
_ declarations DeclarationStore

────────────────────
+ This
    - project-root String
    - search-path String
    - config LintConfig
    - catalog [LintRule]
    - selected [String]
    - semantic Bool = false

.. search-paths [Path] = Path(each) in search-path.split(":")
.. analyzer = SymbolAnalyzer(search-paths)
.. declarations = DeclarationStore(search-paths)

for rule in catalog
    if !config.rules[rule.id]
        continue
    if selected.length != 0 && selected.find(rule.id) == null
        continue
    if rule.phase == "semantic" && !semantic
        continue
    active-rules += rule

────────────────────
+ needs-phase Bool
    - phase String

!!matching

.. matching
    **? active-rules
    ?> each.phase == phase
    |> first

────────────────────
+ is-active Bool
    - id String

!!matching

.. matching
    **? active-rules
    ?> each.id == id
    |> first

────────────────────
+ has-file-rules Bool

!!found

.. found
    **? active-rules
    ?> each.phase != "semantic"
    |> first

────────────────────
+ do lint-file [LintDiagnostic]
    - file-path String
    - facts SemanticFacts? = null

. text = read-file-text(Path(file-path))
= lint-source(LintSource(file-path, text), facts)

────────────────────
+ do lint-source [LintDiagnostic]
    - source LintSource
    - facts SemanticFacts? = null

` The diagnostics of one pass of the active rules over one file: the static rules, or where the
` file's semantic `facts` are given, from a root that typed it, the semantic rules. They are in
` the order of where they are and then of their rules, as the reference's are.

. relative = relative-report-path(project-root, source.path)
if facts
    . found [LintDiagnostic]
    for rule in active-rules
        if rule.phase == "semantic"
            . context = RuleContext(relative, rule.id, config.rules[rule.id]!)
            run-semantic-rule(rule.id, source, facts, context)
            found ++= context.diagnostics
    = sort(found) • using compare-diagnostics

. tree AST? = null
do finally
    if tree
        tree.release()
if needs-phase("ast") || needs-phase("declaration")
    . parsed = catch analyzer.parse-source(source)
    if parsed is YumiSyntaxError
        = parse-error-diagnostics(relative, source, parsed)
    tree = parsed as AST

. analysis ModuleAnalysis? = null
if needs-phase("declaration")
    analysis = analyzer.analyze(source, tree!)

. diagnostics [LintDiagnostic]
for rule in active-rules
    . context = RuleContext(relative, rule.id, config.rules[rule.id]!)
    if rule.phase == "text" && source.is-brix
        run-brix-text-rule(rule.id, source, context)
    else if rule.phase == "text"
        run-text-rule(rule.id, source, context)
    else if rule.phase == "ast"
        run-ast-rule(rule.id, source, tree!, context)
    else if rule.phase == "declaration"
        run-declaration-rule(rule.id, analysis!, context)
    diagnostics ++= context.diagnostics
= sort(diagnostics) • using compare-diagnostics

────────────────────
+ do format-candidates [FormatCandidate]
    - source LintSource

` The formatting fixes of a source in a fix run, where the format rule is active: those of its
` lines, or where it has none and it parses, those of the order of its declarations.
. empty [FormatCandidate]
if !is-active("layout/format")
    = empty
if source.is-brix
    . formatted = brix-format(source)
    if formatted && formatted != source.text
        empty += FormatCandidate(0, source.text.length, formatted)
    = empty
. lengths = format-lengths(config.rules["layout/format"]!)
. found = line-format-candidates(source, lengths)
if found.length != 0
    = found
. parsed = catch analyzer.parse-source(source)
if parsed is YumiSyntaxError
    = found
. tree = use parsed as AST
. index MethodOrderIndex? = null
. declared = catch declarations.module-index(source, tree)
if declared is MethodOrderIndex
    index = declared as MethodOrderIndex
= order-format-candidates(source, lengths, tree, index)

────────────────────
_ do brix-format String?
    - source LintSource

. parsed = catch analyzer.parse-source(source)
=? catch? brix-formatted(source.text) if parsed is YumiSyntaxError
. tree = use parsed as AST
. declared = catch declarations.module-index(source, tree)
. index = declared as MethodOrderIndex if declared is MethodOrderIndex
= brix-ordered(source, tree, index)

────────────────────
_ do parse-error-diagnostics [LintDiagnostic]
    - relative String
    - source LintSource
    - error YumiSyntaxError

. diagnostics [LintDiagnostic]
for rule in active-rules
    if rule.id == "syntax/parse-error"
        . context = RuleContext(relative, rule.id, config.rules[rule.id]!)
        if source.is-brix
            lint-brix-parse-errors(source, context)
        else
            lint-parse-error(error, context)
        diagnostics ++= context.diagnostics
= diagnostics

━━━━━━━━━━━━━━━━━━━━
+ do format-lengths [Char = Int]
    - options [String = JSON]

` The lengths the format rule gives each divider character, by its options.
. lengths [Char = Int]
. configured = options["lengths"]
if configured
    do match? configured
        | entries [String = JSON]
            for key, value in entries
                if key.length == 1 && value is Int
                    lengths[key[0]] = value
= lengths

━━━━━━━━━━━━━━━━━━━━
+ compare-diagnostics Comparison
    - left LintDiagnostic
    - right LintDiagnostic

|? left.line != right.line
    compare-basic(left.line, right.line)
|? left.column != right.column
    compare-basic(left.column, right.column)
??
    compare-basic(left.rule-id, right.rule-id)

━━━━━━━━━━━━━━━━━━━━
+ relative-report-path String
    - project-root String
    - file-path String

|? file-path == project-root
    ""
|? file-path.starts-with(prefix)
    file-path[prefix.length ...]
??
    file-path

.. prefix = "$project-root/"

━━━━━━━━━━━━━━━━━━━━
+ resolve-target String
    - project-root String
    - target String

|? target.starts-with("/")
    strip-trailing-slash(target)
|? target == "." || target == "./"
    project-root
|? target.starts-with("./")
    strip-trailing-slash("$project-root/${target[2 ...]}")
??
    strip-trailing-slash("$project-root/$target")

━━━━━━━━━━━━━━━━━━━━
+ strip-trailing-slash String
    - path String

if path.length > 1 && path.ends-with("/") then path[0 .. < path.length - 1] else path

━━━━━━━━━━━━━━━━━━━━
+ do discover-lint-files [String]
    - project-root String
    - targets [String]

. ignore = load-git-ignore(project-root)
. files [String = Bool]
for target in targets
    add-target-files(project-root, resolve-target(project-root, target), files, ignore)

. found [String]
for path, listed in files
    found += path
= sort(found)

━━━━━━━━━━━━━━━━━━━━
_ do add-target-files ?! Error
    - project-root String
    - target String
    - files [String = Bool]
    - ignore GitIgnore

. target-path = Path(target)
if target-path.is-file
    if is-lint-path(target)
        files[target] = true
    =
if !target-path.is-dir
    =

. relative = relative-report-path(project-root, target)
if relative.starts-with("..") || is-ignored-directory-name(target-path.name)
    =

for entry in target-path.contents
    . entry-path = entry as String
    . entry-name = entry.name
    . entry-relative = relative-report-path(project-root, entry-path)
    if entry.is-dir
        . skipped = is-ignored-directory-name(entry-name) || ignore.ignores(entry-relative, true)
        if skipped || (entry / ".git").exists
            continue
        add-target-files(project-root, entry-path, files, ignore)
    else if entry.is-file && is-lint-path(entry-name) && !ignore.ignores(entry-relative, false)
        files[entry-path] = true

━━━━━━━━━━━━━━━━━━━━
+ is-ignored-directory-name Bool
    - name String

name == ".git" || name == ".ometer" || name == "dist" || name == "node_modules"

━━━━━━━━━━━━━━━━━━━━
+ GitIgnorePattern

+ negate Bool
+ directory-only Bool
+ has-slash Bool
+ glob String

────────────────────
+ This
    - negate Bool
    - directory-only Bool
    - has-slash Bool
    - glob String

━━━━━━━━━━━━━━━━━━━━
+ GitIgnore

+ patterns [GitIgnorePattern]

────────────────────
+ This

────────────────────
+ do ignores Bool
    - relative-path String
    - is-directory Bool

. normalized = normalize-ignore-path(relative-path)
if normalized.length == 0
    = false

. ignored = false
for pattern in patterns
    if matches-git-ignore(pattern, normalized, is-directory)
        ignored = !pattern.negate
= ignored

━━━━━━━━━━━━━━━━━━━━
+ do load-git-ignore GitIgnore
    - project-root String

. ignore = GitIgnore()
. path = Path(project-root) / ".gitignore"
if !path.is-file
    = ignore

. text = read-file-text(path)
for raw-line in text.split("\n")
    . parsed = parse-git-ignore-line(strip-carriage-return(raw-line))
    if parsed
        ignore.patterns += parsed
= ignore

━━━━━━━━━━━━━━━━━━━━
+ do parse-git-ignore-line GitIgnorePattern?
    - raw-line String

. line = strip-unescaped-trailing-spaces(raw-line)
if line.length == 0 || line.starts-with("#")
    = null

. negate = false
if line.starts-with("!")
    negate = true
    line = line[1 ...]
if line.starts-with("\\#") || line.starts-with("\\!")
    line = line[1 ...]

while line.starts-with("/")
    line = line[1 ...]
. directory-only = line.ends-with("/")
while line.ends-with("/")
    line = line[0 .. < line.length - 1]
if line.length == 0
    = null

= GitIgnorePattern(negate, directory-only, line.find("/") != null, line)

━━━━━━━━━━━━━━━━━━━━
+ do strip-unescaped-trailing-spaces String
    - line String

. end = line.length
while end > 0 && line[end - 1] == ' '
    . slashes = 0
    . index = end - 2
    while index >= 0 && line[index] == '\\'
        slashes += 1
        index -= 1

    if slashes % 2 == 1
        break
    end -= 1
= line[0 .. < end]

━━━━━━━━━━━━━━━━━━━━
+ normalize-ignore-path String
    - relative-path String

|? relative-path.starts-with("./")
    relative-path[2 ...]
??
    relative-path

━━━━━━━━━━━━━━━━━━━━
+ matches-git-ignore Bool
    - pattern GitIgnorePattern
    - normalized String
    - is-directory Bool

|? pattern.directory-only && !is-directory
    false
??
    glob-matches(pattern.glob, 0, subject, 0)

.. subject = if pattern.has-slash then normalized else Path(normalized).name

━━━━━━━━━━━━━━━━━━━━
+ glob-matches Bool
    - glob String
    - g Index
    - subject String
    - s Index

|? g >= glob.length
    s == subject.length
|? glob[g] == '*'
    star-matches(glob, g, subject, s)
|? s >= subject.length
    false
|? glob[g] == '?'
    subject[s] != '/' && glob-matches(glob, g + 1, subject, s + 1)
??
    literal == subject[s] && glob-matches(glob, next, subject, s + 1)

.. escaped = glob[g] == '\\' && g + 1 < glob.length
.. literal = if escaped then glob[g + 1] else glob[g]
.. next = if escaped then g + 2 else g + 1

━━━━━━━━━━━━━━━━━━━━
+ star-matches Bool
    - glob String
    - g Index
    - subject String
    - s Index

|? glob-matches(glob, rest, subject, s)
    true
|? s >= subject.length
    false
|? !deep && subject[s] == '/'
    false
??
    star-matches(glob, g, subject, s + 1)

.. deep = g + 1 < glob.length && glob[g + 1] == '*'
.. rest = if deep then g + 2 else g + 1
