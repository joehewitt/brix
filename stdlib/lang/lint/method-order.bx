(import ./format)
(import ./source)
(import ./symbols)
(import /core/atom-pool)
(import /lang/ast/ast)
(import /lang/ast/ast-children)
(import /lang/ast/ast-nodes)
(import /lang/ast/brix)
(import /lang/ast/error)
(import /lang/ast/module-resolver)
(import /lang/ast/operator)
(import /lang/ast/row-range)
(import /lang/ast/syntax-uses)
(import /lang/constants)
(import /os/file)
(import /os/path)
(import /stream/sort)
(blank)
(prop _ override-priority-base _ (= -2000000000))
(prop _ interface-priority-base _ (= -1000000000))
(prop _ group-stride _ (= 1000000))
(prop _ bucket-stride _ (= 10000))

(type + DeclarationStore
  ; The declarations of modules as the reference's module store makes them for ordering: the builtin
  ; modules first, which import nothing implicitly, and then each module the first time an import
  ; reaches it, which also imports the builtin modules.
  (prop + resolver ModuleResolver)
  (prop _ atoms AtomPool)
  (prop _ modules (map String DeclaredModule))
  (prop _ failures (map String String))
  (prop _ builtins (list DeclaredModule))
  (prop _ next-id _ (= 0))
  (prop _ is-initialized _ (= false))
  (prop _ initialize-error (? String))
  (fn-do + This _
    (param search-paths (list Path))
    (let c-paths (map String (list Path)))
    (= resolver (call ModuleResolver search-paths c-paths))
    (= atoms (call AtomPool))
  )
  (fn-expr + module-index (? MethodOrderIndex) (?! Error)
    (param source LintSource)
    (param tree AST)
    ; The places of the public functions of a source's classes that implement its interfaces or
    ; override its bases, or none where no function has one.
    (if-expr (== (. index metadata length) 0) null index)
    (where
      (lazy index (call method-order-index (call declare-source source tree)))
    )
  )
  (fn-do + declare-source DeclaredModule (?! Error)
    (param source LintSource)
    (param tree AST)
    ; A source declared as the reference declares it for ordering, as a module of its own apart from
    ; any module at its path.
    (call initialize)
    (let module (call new-module local-origin-name (. source path) false))
    (call declare module source tree)
    (return module)
  )
  (fn-do _ initialize _ (?! Error)
    (if (not is-initialized)
      (= is-initialized true)
      (let outcome (catch (call declare-builtins)))
      (if (is outcome Error)
        (= initialize-error (. (as outcome Error) message))
      )
    )
    (if initialize-error
      (throw (call Error initialize-error))
    )
  )
  (fn-do _ declare-builtins _ (?! Error)
    (let found (list DeclaredModule))
    (for (in name builtin-module-names)
      (+= found (call import-module name null))
    )
    (for (in name core-module-names)
      (call import-module name null)
    )
    (= builtins found)
  )
  (fn-do _ new-module DeclaredModule
    (param name String)
    (param path String)
    (param is-builtin Bool)
    (+= next-id 1)
    (return (call DeclaredModule next-id name path is-builtin))
  )
  (fn-do _ import-module DeclaredModule (?! Error)
    (param name String)
    (param scope (? DeclaredModule))
    (if (and scope (== (. scope name) name))
      (return scope)
    )
    (if (call (. name ends-with) ".h")
      (return (call c-module name scope))
    )
    (let resolved (call (. resolver resolve-module) name (only-if (. scope path) (if scope))))
    (if (not resolved)
      (throw (call Error (str "Module \"" name "\" not found")))
    )
    (let path (as (. resolved path) String))
    (let failed ([] failures path))
    (if failed
      (throw (call Error failed))
    )
    (let cached ([] modules path))
    (if cached
      (return cached)
    )
    (let module (call new-module (. resolved name) path (or (not scope) (. scope is-builtin))))
    (= ([] modules path) module)
    (let outcome (catch (call declare-file module)))
    (if (is outcome Error)
      (= ([] failures path) (. (as outcome Error) message))
      (throw (as outcome Error))
    )
    (return module)
  )
  (fn-do _ c-module DeclaredModule (?! Error)
    (param name String)
    (param scope (? DeclaredModule))
    (let key (str "c:" name))
    (let cached ([] modules key))
    (if cached
      (return cached)
    )
    (if (not (call (. resolver find-c-module) name))
      (throw (call Error (str "Module \"" name "\" not found")))
    )
    (let module (call new-module name key (or (not scope) (. scope is-builtin))))
    (= ([] modules key) module)
    (return module)
  )
  (fn-do _ declare-file _ (?! Error)
    (param module DeclaredModule)
    (let text (call read-file-text (call Path (. module path))))
    (let builder
      (call parse-brix text (. module path)
        (block
          (on-error YumiSyntaxError
            (throw (call Error "Syntax error"))
          )
        )
      )
    )
    (let tree (use (call (. builder finish) atoms)))
    (call declare module (call LintSource (. module path) text) tree)
  )
  (fn-do _ declare _ (?! Error)
    (param module DeclaredModule)
    (param source LintSource)
    (param tree AST)
    ; Declares a module's imports and classes in the order written, and then the modules that the
    ; syntax it uses imports, and the builtin modules once those are declared.
    (for (in id (call top-level-statements tree))
      (match? ([] (. tree nodes) id)
        (case (call .node-import-syntax row)
          (let imported (call import-module (call import-path-text tree (. row paths)) module))
          (if (!= (. imported id) (. module id))
            (+= (. module imports) (call DeclaredImport imported (. row is-export)))
          )
        )
        (case (call .node-class-block row)
          (call declare-class module source tree row)
        )
        (case (call .node-extension row)
          (call check-extension tree row)
        )
      )
    )
    (blank)
    (if (and (not (. module is-builtin)) (call uses-stream-syntax tree))
      (for (in name stream-module-names)
        (call import-implicitly module name)
      )
    )
    (if (and (call lacks module markup-module-name) (call uses-markup-syntax tree))
      (call import-implicitly module markup-module-name)
    )
    (if (and (call lacks module style-module-name) (call uses-style-sheet-syntax tree))
      (call import-implicitly module style-module-name)
    )
    (if (and is-initialized (not initialize-error) (!= (. builtins length) 0))
      (for (in builtin builtins)
        (+= (. module imports) (call DeclaredImport builtin false))
      )
    )
  )
  (fn-expr _ lacks Bool
    (param module DeclaredModule)
    (param name String)
    (and (!= (. module name) name) (not (call (. module imports-named) name)))
  )
  (fn-do _ import-implicitly _ (?! Error)
    (param module DeclaredModule)
    (param name String)
    (let imported (call import-module name module))
    (if (!= (. imported id) (. module id))
      (+= (. module imports) (call DeclaredImport imported false))
    )
  )
)

(type + DeclaredModule
  ; A module's classes and type aliases, and the modules it imports, as the reference declares a
  ; module for finding classes by name.
  (prop + id Int)
  (prop + name String)
  (prop + path String)
  (prop + is-builtin Bool)
  (prop + classes (list DeclaredClass))
  (prop + classes-by-name (map String (list DeclaredClass)))
  (prop + aliases (map String DeclaredClass))
  (prop + imports (list DeclaredImport))
  (fn-do + This _
    (param id Int)
    (param name String)
    (param path String)
    (param is-builtin Bool)
  )
  (fn-do + add-class _
    (param declared DeclaredClass)
    (= (. declared index) (as (. classes length) Int))
    (+= classes declared)
    (let named ([] classes-by-name (. declared name)))
    (if named
      (+= named declared)
      (else
        (let list (list DeclaredClass))
        (+= list declared)
        (= ([] classes-by-name (. declared name)) list)
      )
    )
  )
  (fn-do + imports-named Bool
    (param name String)
    (for (in imported imports)
      (if (== (. imported module name) name)
        (return true)
      )
    )
    (return false)
  )
  (fn-do + classes-named (list DeclaredClass)
    (param name String)
    ; The classes a name finds from this module: its own, and the public ones of the modules it
    ; imports and those they export. As in the reference, a module that exports nothing counts again
    ; each time an import reaches it.
    (let found (list DeclaredClass))
    (let visited (map Int Bool))
    (call collect name true visited found)
    (return found)
  )
  (fn-do + collect _
    (param name String)
    (param is-access Bool)
    (param visited (map Int Bool))
    (param found (list DeclaredClass))
    (if ([] visited id)
      (return)
    )
    (let is-marked false)
    (for (in imported imports)
      (if (or is-access (. imported is-export))
        (if (not is-marked)
          (= ([] visited id) true)
          (= is-marked true)
        )
        (call (. imported module collect) name false visited found)
      )
    )
    (let named ([] classes-by-name name))
    (if named
      (for (in declared named)
        (if (or (. declared is-public) is-access)
          (+= found declared)
        )
      )
    )
    (let alias ([] aliases name))
    (if (and alias (or (. alias is-public) is-access))
      (+= found alias)
    )
  )
)

(type + DeclaredImport (is Tuple)
  (prop + module DeclaredModule)
  (prop + is-export Bool)
)

(type + DeclaredClass
  ; A class as the reference declares it: its type parameters, its bases in the order written, and
  ; its public functions in the order of their buckets and then of where they are.
  (prop + name String)
  (prop + module DeclaredModule)
  (prop + line U32)
  (prop + index _ (= 0))
  (prop + is-public _ (= false))
  (prop + param-count _ (= 0))
  (prop + bases (list DeclaredBase))
  (prop + callables (list DeclaredCallable))
  (fn-do + This _
    (param name String)
    (param module DeclaredModule)
  )
)

(type + DeclaredBase (is Tuple)
  ; A type a class names as its base, where `is-inherited`, or as an interface it implements, with
  ; the name and type parameter count it refers to a class by, if it refers to one that way.
  (prop + is-inherited Bool)
  (prop + reference (? String))
  (prop + reference-params Int)
)

(type + DeclaredCallable (is Tuple)
  ; A public function of a class that an interface or base type can require, by the bucket it goes
  ; in, its signature, and its place among the class's public functions.
  (prop + bucket String)
  (prop + signature String)
  (prop + order Int)
  (prop + node SyntaxId)
)

(type + CallableEntry (is Tuple)
  (prop + bucket String)
  (prop + signature String)
  (prop + bucket-index Int)
  (prop + line U32)
  (prop + column U32)
  (prop + node SyntaxId)
)

(type + Requirement (is Tuple)
  ; A public function a base type or interface declares, which a class's function with the same
  ; signature implements.
  (prop + signature String)
  (prop + bucket String)
  (prop + order Int)
  (prop + group Int)
)

(type + ClassDeclaration
  ; The members of one class as the reference declares them, failing as it does on a member that
  ; redefines another, and the public functions among them.
  (prop + source LintSource)
  (prop + tree AST)
  (prop + declared DeclaredClass)
  (prop _ properties (map String Bool))
  (prop _ members (map String Bool))
  (prop _ style-rules (map String Bool))
  (prop _ has-content _ (= false))
  (prop _ entries (list CallableEntry))
  (fn-do + This _
    (param source LintSource)
    (param tree AST)
    (param declared DeclaredClass)
  )
  (fn-do + declare-members _ (?! Error)
    (param ids (of RowRange SyntaxId))
    (for (in id ([] (. tree children) ids))
      (call declare-member id)
    )
    (let sorted (call sort entries (:using compare-entries)))
    (let order 0)
    (for (in entry sorted)
      (+= (. declared callables) (call DeclaredCallable (. entry bucket) (. entry signature) order (. entry node)))
      (+= order 1)
    )
  )
  (fn-do _ declare-member _ (?! Error)
    (param id SyntaxId)
    (match? ([] (. tree nodes) id)
      (case (call .node-implements-declaration row)
        (+= (. declared bases) (call declared-base tree (. row type) false))
      )
      (case (call .node-property-syntax row)
        (call declare-property row)
      )
      (case (call .node-event-declaration row)
        (call add-member (. row name text))
      )
      (case (call .node-function-syntax row)
        (call declare-function id row false false)
      )
      (case (call .node-converter-syntax row)
        (call declare-converter id (. row access) (. row type) "public-converters")
      )
      (case (call .node-fromverter-syntax row)
        (call declare-converter id (. row access) (. row type) "public-fromverters")
      )
      (case (call .node-rule-syntax row)
        (call declare-style-rule row)
      )
      (case .node-content-block
        (call set-content)
      )
    )
  )
  (fn-do _ declare-property _ (?! Error)
    (param row ASTProperty)
    (match ([] (. tree nodes) (. row left))
      (case (call .node-type-capture capture)
        (call add-property (call expression-name tree (. capture id)))
      )
      (default
        (call add-member (call declared-type-name tree (. row left)))
      )
    )
  )
  (fn-do _ add-property _ (?! Error)
    (param name String)
    (if ([] members name)
      (throw (call Error "Redefinition of class member"))
    )
    (if ([] properties name)
      (throw (call Error "Redefinition of property"))
    )
    (= ([] properties name) true)
  )
  (fn-do _ add-member _ (?! Error)
    (param name String)
    (if (or ([] members name) ([] properties name))
      (throw (call Error "Redefinition of class member"))
    )
    (= ([] members name) true)
  )
  (fn-do _ set-content _ (?! Error)
    (if has-content
      (throw (call Error "Only one content section permitted"))
    )
    (= has-content true)
  )
  (fn-do _ declare-style-rule _ (?! Error)
    (param row ASTRule)
    (let name (. row name text))
    (if (and (== name "This") (!= (. row args count) 0))
      (throw (call Error "Style rule \"This\" must be parameterless"))
    )
    (let types (list String))
    (for (in arg ([] (. tree children) (. row args)))
      (+= types (call argument-type-name tree arg))
    )
    (let key (str name "\x00" (. row args count) "\x00" (call (. "\x00" join) types)))
    (if ([] style-rules key)
      (throw (call Error "Redefinition of style rule"))
    )
    (= ([] style-rules key) true)
  )
  (fn-do _ declare-converter _ (?! Error)
    (param id SyntaxId)
    (param access Access)
    (param type SyntaxId)
    (param bucket String)
    (if (!= access .public-access)
      (throw (call Error "Converters must be public"))
    )
    (let params (list String))
    (call declare-params tree type params)
    (call add-entry id bucket (str bucket "\x00" (call declared-type-name tree type)))
  )
  (fn-do _ declare-function _ (?! Error)
    (param id SyntaxId)
    (param row ASTFunction)
    (param getter Bool)
    (param setter Bool)
    (let is-getter (or getter (. row is-getter)))
    (let is-setter (or setter (. row is-setter)))
    (if (!= (. row names count) 1)
      (throw (call Error "Not yet implemented"))
    )
    (let name (. ([] (. tree atoms) (. row names start)) text))
    (if (and (. row is-static) (or is-getter is-setter (== name "This")))
      (throw (call Error "Static is only supported on ordinary type functions"))
    )
    (let params (call function-params tree row))
    (call check-defaults tree row)
    (if is-getter
      (call add-property name)
      (if (== (. row access) .public-access)
        (call add-entry id "public-getters" (call function-signature row name "public-getters" params))
      )
      (return)
    )
    (if is-setter
      (if (not ([] properties name))
        (call add-property name)
      )
      (if (== (. row access) .public-access)
        (call add-entry id "public-setters" (call function-signature row name "public-setters" params))
      )
      (return)
    )
    (if (or (== name "This") (. row is-static) (!= (. row access) .public-access))
      (return)
    )
    (let line (as (. ([] (. tree nodes loc) id) begin line) Index))
    (let header (if-expr (< line (. source lines length)) ([] (. source lines) line) ""))
    (let operator (call brix-header-operator name header))
    (let bucket (call operator-bucket operator))
    (let called (if-expr (!= (. operator length) 0) operator name))
    (call add-entry id bucket (call function-signature row called bucket params))
  )
  (fn-do _ function-signature String
    (param row ASTFunction)
    (param name String)
    (param bucket String)
    (param params (list String))
    (let args (list String))
    (for (in arg ([] (. tree children) (. row args)))
      (+= args (str (call argument-call-name tree arg) ":" (call argument-type-name tree arg)))
    )
    (return (str bucket "\x00" name "\x00" (. params length) "\x00" (call (. "\x00" join) args)))
  )
  (fn-do _ add-entry _
    (param id SyntaxId)
    (param bucket String)
    (param signature String)
    (let place (. ([] (. tree nodes loc) id) begin))
    (let index (call bucket-order-index bucket))
    (+= entries (call CallableEntry bucket signature index (. place line) (. place column) id))
  )
)

(fn-expr + compare-entries Comparison
  (param left CallableEntry)
  (param right CallableEntry)
  (case? (!= (. left bucket-index) (. right bucket-index))
    (call compare-basic (. left bucket-index) (. right bucket-index))
  )
  (case? (!= (. left line) (. right line))
    (call compare-basic (. left line) (. right line))
  )
  (default
    (call compare-basic (. left column) (. right column))
  )
)

(fn-expr + operator-bucket String
  (param operator String)
  (case? (== (. operator length) 0)
    "public-methods"
  )
  (case? (== operator "[]")
    "public-indexers"
  )
  (case? (== operator "[]=")
    "public-index-setters"
  )
  (case? (== operator "-=[]")
    "public-index-deleters"
  )
  (case? (call is-prefix-operator operator)
    "public-prefix-operators"
  )
  (default
    "public-operators"
  )
)

(fn-do + function-params (list String) (?! Error)
  (param tree AST)
  (param row ASTFunction)
  ; The names of a function's type parameters: those it lists, and those its arguments declare.
  (let params (list String))
  (for (in param ([] (. tree children) (. row type-args)))
    (+= params (call declared-type-name tree param))
  )
  (for (in arg ([] (. tree children) (. row args)))
    (match? ([] (. tree nodes) arg)
      (case (call .node-argument-decl decl)
        (call declare-params tree (. decl pattern) params)
      )
    )
  )
  (return params)
)

(fn-do + declare-params _ (?! Error)
  (param tree AST)
  (param type SyntaxId)
  (param params (list String))
  (if (== type 0)
    (return)
  )
  (match? ([] (. tree nodes) type)
    (case (call .node-type-identifier row)
      (if (. row is-declare)
        (let name (. row name text))
        (for (in param params)
          (if (== param name)
            (throw (call Error "Duplicate type parameter"))
          )
        )
        (+= params name)
      )
    )
    (case (call .node-type-arguments row)
      (for (in arg ([] (. tree children) (. row args)))
        (call declare-params tree arg params)
      )
    )
    (case (call .node-type-associated row)
      (call declare-params tree (. row owner) params)
      (for (in arg ([] (. tree children) (. row args)))
        (call declare-params tree arg params)
      )
    )
    (case (call .node-type-match row)
      (call declare-params tree (. row type) params)
    )
    (case (call .node-type-capture row)
      (call declare-params tree (. row type) params)
    )
  )
)

(fn-do + check-defaults _ (?! Error)
  (param tree AST)
  (param row ASTFunction)
  (let has-started false)
  (for (in arg ([] (. tree children) (. row args)))
    (if (call has-default tree arg)
      (= has-started true)
      (else-if has-started
        (throw (call Error "Default value required"))
      )
    )
  )
)

(fn-do + has-default Bool
  (param tree AST)
  (param arg SyntaxId)
  (match? ([] (. tree nodes) arg)
    (case (call .node-argument-decl decl)
      (return (!= (. decl default-value) 0))
    )
  )
  (return false)
)

(fn-do + argument-call-name String
  (param tree AST)
  (param arg SyntaxId)
  (match? ([] (. tree nodes) arg)
    (case (call .node-argument-decl decl)
      (return (call pattern-name tree (. decl pattern)))
    )
  )
  (return "")
)

(fn-do + argument-type-name String
  (param tree AST)
  (param arg SyntaxId)
  (match? ([] (. tree nodes) arg)
    (case (call .node-argument-decl decl)
      (let name (call declared-type-name tree (. decl pattern)))
      (if (. decl is-variadic)
        (return (str name "..."))
      )
      (return name)
    )
  )
  (return "")
)

(fn-expr + pattern-name String
  (param tree AST)
  (param pattern SyntaxId)
  (match ([] (. tree nodes) pattern)
    (case (call .node-type-capture row)
      (call expression-name tree (. row id))
    )
    (case (call .node-type-predicate row)
      (call expression-name tree (. row expr))
    )
    (default
      ""
    )
  )
)

(fn-do + declared-type-name String
  (param tree AST)
  (param type SyntaxId)
  ; The name the reference gives a type as written.
  (if (== type 0)
    (return "")
  )
  (match? ([] (. tree nodes) type)
    (case (call .node-type-identifier row)
      (return (. row name text))
    )
    (case (call .node-core-type-identifier row)
      (return (. row name text))
    )
    (case (call .node-type-arguments row)
      (let names (list String))
      (+= names (call declared-type-name tree (. row base)))
      (for (in arg ([] (. tree children) (. row args)))
        (+= names (call declared-type-name tree arg))
      )
      (return (call (. "'" join) names))
    )
    (case (call .node-type-associated row)
      (let text (str (call declared-type-name tree (. row owner)) "." (. row name text)))
      (for (in arg ([] (. tree children) (. row args)))
        (+= text (str "'" (call declared-type-name tree arg)))
      )
      (return text)
    )
    (case (call .node-type-match row)
      (return (call declared-type-name tree (. row type)))
    )
    (case (call .node-type-capture row)
      (return (call declared-type-name tree (. row type)))
    )
    (case (call .node-type-tuple row)
      (let names (list String))
      (for (in field ([] (. tree children) (. row field-types)))
        (+= names (call declared-type-name tree field))
      )
      (let kind (if-expr (. row is-struct) "struct" "tuple"))
      (return (str kind "(" (call (. "," join) names) ")"))
    )
    (case (call .node-type-list row)
      (let names (list String))
      (for (in pattern ([] (. tree children) (. row patterns)))
        (+= names (call declared-type-name tree pattern))
      )
      (return (str "list(" (call (. "," join) names) ")"))
    )
    (case (call .node-type-predicate row)
      (return (call expression-name tree (. row expr)))
    )
  )
  (return "")
)

(fn-expr + expression-name String
  (param tree AST)
  (param id SyntaxId)
  (match ([] (. tree nodes) id)
    (case (call .node-identifier row)
      (. row name text)
    )
    (default
      ""
    )
  )
)

(fn-do + declared-base DeclaredBase
  (param tree AST)
  (param type SyntaxId)
  (param is-inherited Bool)
  (match? ([] (. tree nodes) type)
    (case (call .node-type-identifier row)
      (return (call DeclaredBase is-inherited (. row name text) 0))
    )
    (case (call .node-type-arguments row)
      (match? ([] (. tree nodes) (. row base))
        (case (call .node-type-identifier base)
          (return (call DeclaredBase is-inherited (. base name text) (. row args count)))
        )
      )
    )
  )
  (return (call DeclaredBase is-inherited null 0))
)

(fn-do + declare-class _ (?! Error)
  (param module DeclaredModule)
  (param source LintSource)
  (param tree AST)
  (param row ASTClassBlock)
  (let declared (call DeclaredClass (. row name text) module))
  (= (. declared line) (. row loc begin line))
  (= (. declared is-public) (== (. row access) .public-access))
  (= (. declared param-count) (as (. row type-args count) Int))
  (if (!= (. row base) 0)
    (+= (. declared bases) (call declared-base tree (. row base) true))
  )
  (call (. (call ClassDeclaration source tree declared) declare-members) (. row members))
  (call (. module add-class) declared)
  (for (in offset (..< 0 (. row aliases count)))
    (= ([] (. module aliases) (. ([] (. tree atoms) (+ (. row aliases start) offset)) text)) declared)
  )
)

(fn-do + check-extension _ (?! Error)
  (param tree AST)
  (param row ASTExtension)
  (if (!= (. row as-types count) 0)
    (throw (call Error "Not yet implemented"))
  )
  (for (in member ([] (. tree children) (. row body)))
    (match ([] (. tree nodes) member)
      (case .node-property-syntax
        (throw (call Error "Stored properties are not allowed in extensions"))
      )
      (case (call .node-function-syntax function)
        (call check-extension-function tree function)
      )
      (case .node-converter-syntax
        (continue)
      )
      (case .node-fromverter-syntax
        (continue)
      )
      (throw (call Error "Statement can not be used in extensions"))
    )
  )
)

(fn-do + check-extension-function _ (?! Error)
  (param tree AST)
  (param row ASTFunction)
  (if (. row is-setter)
    (throw (call Error "Setters are not allowed in extensions"))
  )
  (if (!= (. row names count) 1)
    (throw (call Error "Not yet implemented"))
  )
  (if (== (. ([] (. tree atoms) (. row names start)) text) "This")
    (return)
  )
  (call function-params tree row)
  (call check-defaults tree row)
)

(fn-do + method-order-index MethodOrderIndex
  (param module DeclaredModule)
  (let index (call MethodOrderIndex))
  (for (in declared (. module classes))
    (call add-metadata declared index)
  )
  (return index)
)

(fn-do + add-metadata _
  (param declared DeclaredClass)
  (param index MethodOrderIndex)
  ; Places each public function of a class that overrides a function of a base type, and then each
  ; that implements a function of an interface.
  (let current (call unique-callables (. declared callables)))
  (if (== (. current length) 0)
    (return)
  )
  (let chain (call base-chain declared))
  (if (not chain)
    (return)
  )
  (let lineage
    (call (of List DeclaredClass)
      (block
        (spread chain)
        (item declared)
      )
    )
  )
  (let interfaces (call interface-order lineage))
  (let required (map String Bool))
  (let ordered (list Requirement))
  (let seen (map String Bool))
  (for (in group (..< 0 (. interfaces length)))
    (let iface ([] interfaces group))
    (let counts (call signature-counts (. iface callables)))
    (for (in callable (. iface callables))
      (= ([] required (. callable signature)) true)
      (if (not ([] seen (. callable signature)))
        (= ([] seen (. callable signature)) true)
        (if (== ([] counts (. callable signature)) 1)
          (+= ordered (call requirement callable group))
        )
      )
    )
  )
  (blank)
  (let base-counts (map String Int))
  (for (in resolved chain)
    (for (in callable (. resolved callables))
      (= ([] base-counts (. callable signature)) (+ (?? ([] base-counts (. callable signature)) 0) 1))
    )
  )
  (for (in group (..< 0 (. chain length)))
    (let resolved ([] chain group))
    (for (in callable (. resolved callables))
      (if (and (== ([] base-counts (. callable signature)) 1) (not ([] required (. callable signature))))
        (let found ([] current (. callable signature)))
        (if found
          (let item (call requirement callable group))
          (call add-method found override-priority-base item index)
        )
      )
    )
  )
  (for (in item ordered)
    (let found ([] current (. item signature)))
    (if found
      (call add-method found interface-priority-base item index)
    )
  )
)

(fn-expr + requirement Requirement
  (param callable DeclaredCallable)
  (param group Int)
  (call Requirement (. callable signature) (. callable bucket) (. callable order) group)
)

(fn-do + add-method _
  (param callable DeclaredCallable)
  (param base Int)
  (param item Requirement)
  (param index MethodOrderIndex)
  (if ([] (. index metadata) (. callable node))
    (return)
  )
  (let placement (+ (* (call bucket-order-index (. item bucket)) bucket-stride) (. item order)))
  (= ([] (. index metadata) (. callable node)) (call MethodOrderMetadata (+ base (* (. item group) group-stride) placement)))
)

(fn-do + base-chain (? (list DeclaredClass))
  (param declared DeclaredClass)
  ; The base types a class inherits from, its root first, or none where a class inherits from more
  ; than one or from one that is not found once.
  (let chain (list DeclaredClass))
  (let seen (list DeclaredClass))
  (+= seen declared)
  (let current declared)
  (while true
    (let inherited (list DeclaredBase))
    (for (in base (. current bases))
      (if (. base is-inherited)
        (+= inherited base)
      )
    )
    (if (== (. inherited length) 0)
      (break)
    )
    (if (!= (. inherited length) 1)
      (return null)
    )
    (let parent (call resolve-class current ([] inherited 0)))
    (if (or (not parent) (call contains-class seen parent))
      (return null)
    )
    (+= chain parent)
    (+= seen parent)
    (= current parent)
  )
  (let reversed (list DeclaredClass))
  (for (in offset (..< 0 (. chain length)))
    (+= reversed ([] chain (- (. chain length) 1 offset)))
  )
  (return reversed)
)

(fn-do + interface-order (list DeclaredClass)
  (param lineage (list DeclaredClass))
  (let interfaces (list DeclaredClass))
  (for (in declared lineage)
    (for (in base (. declared bases))
      (if (not (. base is-inherited))
        (let found (call resolve-class declared base))
        (if found
          (+= interfaces found)
        )
      )
    )
  )
  (return interfaces)
)

(fn-do + resolve-class (? DeclaredClass)
  (param owner DeclaredClass)
  (param base DeclaredBase)
  ; The one class a base names from its owner's module, with as many type parameters as it gives.
  (let reference (. base reference))
  (if (not reference)
    (return null)
  )
  (let found (? DeclaredClass) null)
  (let count 0)
  (for (in candidate (call (. owner module classes-named) reference))
    (if (== (. candidate param-count) (. base reference-params))
      (= found candidate)
      (+= count 1)
    )
  )
  (if (!= count 1)
    (return null)
  )
  (return found)
)

(fn-do + contains-class Bool
  (param list (list DeclaredClass))
  (param declared DeclaredClass)
  (for (in item list)
    (if (and (== (. item module id) (. declared module id)) (== (. item index) (. declared index)))
      (return true)
    )
  )
  (return false)
)

(fn-do + unique-callables (map String DeclaredCallable)
  (param callables (list DeclaredCallable))
  (let counts (call signature-counts callables))
  (let unique (map String DeclaredCallable))
  (for (in callable callables)
    (if (== ([] counts (. callable signature)) 1)
      (= ([] unique (. callable signature)) callable)
    )
  )
  (return unique)
)

(fn-do + signature-counts (map String Int)
  (param callables (list DeclaredCallable))
  (let counts (map String Int))
  (for (in callable callables)
    (= ([] counts (. callable signature)) (+ (?? ([] counts (. callable signature)) 0) 1))
  )
  (return counts)
)

(fn-expr + bucket-order-index Int
  (param bucket String)
  (if-expr found (. found index) 0)
  (where
    (lazy found ([] (call type-member-order-spec) bucket))
  )
)

(fn-do + top-level-statements (list SyntaxId)
  (param tree AST)
  (let found (list SyntaxId))
  (match? ([] (. tree nodes) (. tree root))
    (case (call .node-top-level-syntax root)
      (for (in id ([] (. tree children) (. root statements)))
        (+= found id)
      )
    )
  )
  (return found)
)
