./brix-fit
./brix-fix
./brix-shapes
./brix-source
./config
./diagnostics
./rule-context
./source
/code/structure/document
/core/table
/data/sexp
/data/source-sexp
/data/source-tree
/lang/ast/brix
/lang/ast/brix-catalog
/lang/brix/brix
/lang/brix/layout

━━━━━━━━━━━━━━━━━━━━
+ do lint-brix-width
    - source LintSource
    - context RuleContext

. max = option-int(context.options, "max", 100)
. shapes = catch? brix-row-shapes(source.text)
=? if !shapes
. fixes [U32 = LintFix]
if context.is-fixing
    fixes = brix-fit-fixes(source, shapes, max)
for shape in shapes
    if shape.columns > max && !shape.is-text
        . advice = "Name a part of it with (let …) or (lazy …), or write its arguments one to a row in a (block …)."
        context.report
            - "${shape.shown} makes a row ${shape.columns} columns wide, and the limit is $max. $advice"
            - shape.line
            - shape.column
            - "actionable"
            - fixes[shape.id]

━━━━━━━━━━━━━━━━━━━━
+ do lint-brix-depth
    - source LintSource
    - context RuleContext

. max = option-int(context.options, "max", 5)
. shapes = catch? brix-row-shapes(source.text)
=? if !shapes
. is-deep = false
for shape in shapes
    if shape.is-text
        continue
    . is-over = shape.indent > max
    if is-over && !is-deep
        . advice = "Move the inner rows into a function of their own."
        context.report
            - "${shape.shown} is nested ${shape.indent} levels deep, and the limit is $max. $advice"
            - shape.line
            - shape.column
    is-deep = is-over

━━━━━━━━━━━━━━━━━━━━
+ do lint-brix-parse-errors
    - source LintSource
    - context RuleContext

. fix = brix-mend-fix(source)
. is-first = true
for report in brix-reports(source.text)
    context.report
        - report.text
        - report.place.line + 1
        - report.place.column + 1
        - "actionable"
        - fix if is-first
    is-first = false

━━━━━━━━━━━━━━━━━━━━
_ do brix-mend-fix LintFix?
    - source LintSource

. store = use SourceStore()
. roots = catch? sexp-read(source.text, store)
=? null if !roots
. fixer = BrixFixer(brix-catalog, store)
. text = fixer.rewritten(roots)
=? null if fixer.notes.length == 0 || text == source.text
. edit = LintTextEdit(0, utf16-length(source.text), text, source.text)
= LintFix("safe", "Mend Brix forms: ${"; ".join(fixer.notes)}", [edit])

━━━━━━━━━━━━━━━━━━━━
+ do brix-formatted String ?! SexpError
    - text String

. store = use SourceStore()
. roots = sexp-read(text, store)
. nodes [ImmutableTableRow'SourceNode] = store.node(each) in roots
= brix-file-text(store, nodes)

━━━━━━━━━━━━━━━━━━━━
+ do run-brix-text-rule
    - rule-id String
    - source LintSource
    - context RuleContext

if rule-id == "layout/line-length"
    lint-brix-width(source, context)
if rule-id == "layout/depth"
    lint-brix-depth(source, context)
