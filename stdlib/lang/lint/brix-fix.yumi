/core/table
/data/source-sexp
/data/source-tree
/lang/ast/brix-catalog
/lang/ast/brix-check
/lang/brix/layout
/stream/aggregate

━━━━━━━━━━━━━━━━━━━━
+ BrixFixer

+ notes [String]

_ catalog BrixCatalog
_ store SourceStore

────────────────────
+ This
    - catalog
    - store

────────────────────
+ do rewritten String
    - roots [U32]

. nodes [ImmutableTableRow'SourceNode]
. is-loose = false
for root in roots
    . node = store.node(root)
    if store.is-form(node, "main")
        for row in store.listed(node, 1)
            nodes += mended(row)
        continue
    . fixed = mended(node)
    if !store.is-comment(fixed) && !brix-is-top(store.head(fixed) ?? "")
        is-loose = true
    nodes += fixed
if is-loose
    notes += "wrapped the code at the top level in (main …)"
= sexp-text(store, nodes, BrixLayout(store))

────────────────────
_ do mended ImmutableTableRow'SourceNode
    - node ImmutableTableRow'SourceNode

=? node if !store.is-list(node)
. items = store.listed(node)
. is-changed = false
for index in 0 .. < items.length
    . made = mended(items[index])
    if made.index != items[index].index
        items[index] = made
        is-changed = true
. head = store.head(node)
=? node if head == null && !is-changed
=? store.with-items(node, items) if head == null
if guarded has head && items.length == 3 && store.is-form(items[1], "if") && !ends-with-if
    . held = items[1]
    items[1] = items[2]
    items[2] = held
    is-changed = true
    notes += "moved (if …) to the end of ($head …)"
.. ends-with-if = store.is-form(items[2], "if")
= doing(if is-changed then store.with-items(node, items) else node, head)

.. guarded = ["return-if", "only-if", "throw"]

────────────────────
_ do doing ImmutableTableRow'SourceNode
    - node ImmutableTableRow'SourceNode
    - head String

=? doing-head(node, head) if brix-is-callable(head) && head.ends-with("-expr")
. senses = catalog.senses(head)
=? node if senses == null
. is-able = false
for sense in senses
    if sense.is-doing
        is-able = true
=? node if !is-able
for item in store.items(node)
    =? node if store.is-atom(item) && store.text(item) == ":do"
for sense in senses
    =? node if !sense.is-doing && fits(node, sense)
=? node if owes(node, head) && !returns(node, true)
. mark = store.atom(":do")
for slot in 1 .. store.count(node)
    . made = store.inserted(node, slot, mark)
    for sense in senses
        if sense.is-doing && fits(made, sense)
            notes += "added :do to ($head ${title(node)} …)"
            = made
= node

────────────────────
_ do doing-head ImmutableTableRow'SourceNode
    - node ImmutableTableRow'SourceNode
    - head String

for sense in catalog.senses(head) ?? List'BrixSense()
    =? node if fits(node, sense)
. twin = "${head[0 .. < head.length - 5]}-do"
=? node if owes(node, twin) && !returns(node, true)
. items = List'(ImmutableTableRow'SourceNode)(store.atom(twin))
items ++= store.listed(node, 1)
. made = store.with-items(node, items)
for sense in catalog.senses(twin) ?? List'BrixSense()
    if fits(made, sense)
        notes += "wrote ($twin ${title(node)} …) for ($head …)"
        = made
= node

────────────────────
_ fits Bool
    - node ImmutableTableRow'SourceNode
    - sense BrixSense

catch? brix-text-fits(sexp-inline-text(store, node), sense) ?? false

────────────────────
_ owes Bool
    - node ImmutableTableRow'SourceNode
    - head String

|? head == "fn-to-do"
    true
|? head != "fn-do" || store.count(node) < 4
    false
??
    !(store.is-atom(result) && store.text(result) == "_")

.. result = store.item(node, 3)

────────────────────
_ do returns Bool
    - node ImmutableTableRow'SourceNode
    - is-outer Bool

. head = store.head(node) ?? ""
=? true if leaving has head
=? false if !is-outer && nested has head
= some(store.items(node)) • where returns(each, false)

.. leaving = ["return", "return?", "return-if", "yield", "yield?", "yield-all", "yield-all?"]
.. nested = ["=>", "fn-do", "fn-expr", "fn-from-do", "fn-from-expr", "fn-to-do", "fn-to-expr"]

────────────────────
_ do title String
    - node ImmutableTableRow'SourceNode

for item in store.listed(node, 1)
    . text = if store.is-atom(item) then store.text(item) else (store.head(item) ?? "")
    if text != "+" && text != "_" && text != ""
        = text
= ""
