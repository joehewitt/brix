(import ./brix-fixes)
(import ./function-form)
(import ./rule-context)
(import ./source)
(import /lang/ast/ast)
(import /lang/ast/ast-children)
(import /lang/ast/ast-nodes)
(import /lang/ast/operator)
(import /lang/ast/row-range)

(fn-do + lint-redundant-null-fallback _
  (param source LintSource)
  (param tree AST)
  (param context RuleContext)
  (let attached (call attached-nodes tree))
  (let coalesced (call coalesced-sides tree))
  (for (in id (..< 1u32 (. tree nodes length)))
    (if (not ([] attached id))
      (continue)
    )
    (match? ([] (. tree nodes) id)
      (case (call .node-binary-expression row)
        (if (and (call is-null-fallback tree row) (not ([] coalesced id)))
          (let loc (. ([] (. tree nodes loc) id) begin))
          (let fix (call brix-null-fallback-fix source tree (as id SyntaxId)))
          (let message (call null-fallback-message))
          (call (. context report) message (+ (. loc line) 1) (+ (. loc column) 1) "actionable" fix)
        )
      )
    )
  )
)

(fn-expr + is-null-fallback Bool
  (param tree AST)
  (param row ASTBinaryExpression)
  (and (== (. row op) .else-op) (call is-named tree (. row rhs) "null"))
)

(fn-do _ coalesced-sides (list Bool)
  (param tree AST)
  (let sides (list Bool))
  (for (in _ (..< 0 (. tree nodes length)))
    (+= sides false)
  )
  (for (in id (..< 1u32 (. tree nodes length)))
    (match? ([] (. tree nodes) id)
      (case (call .node-binary-expression row)
        (if (== (. row op) .coalesce-op)
          (= ([] sides (. row lhs)) true)
          (match? ([] (. tree nodes) (. row lhs))
            (case (call .node-binary-expression inner)
              (if (and (== (. inner op) .coalesce-op) (== ([] (. tree nodes loc) (. row lhs)) ([] (. tree nodes loc) id)))
                (= ([] sides (. inner rhs)) true)
              )
            )
          )
        )
      )
    )
  )
  (return sides)
)

(fn-expr + null-fallback-message String
  (str head " " tail)
  (where
    (lazy head "Write `value if condition`: a value written with `if` is already null")
    (lazy tail "when its condition fails.")
  )
)

(fn-expr + operand-text String
  (param source LintSource)
  (param tree AST)
  (param id SyntaxId)
  (if-expr (call is-loose tree id) (str "(" (call node-text source tree id) ")") (call node-text source tree id))
)

(fn-expr + is-loose Bool
  (param tree AST)
  (param id SyntaxId)
  (match ([] (. tree nodes) id)
    (case (call .node-binary-expression row)
      (or (== (. row op) .coalesce-op) (== (. row op) .else-op) (== (. row op) .if-op))
    )
    (default
      false
    )
  )
)

(fn-do + lint-decision-tables _
  (param source LintSource)
  (param tree AST)
  (param context RuleContext)
  (let attached (call attached-nodes tree))
  (for (in id (..< 1u32 (. tree nodes length)))
    (if (not ([] attached id))
      (continue)
    )
    (match? ([] (. tree nodes) id)
      (case (call .node-function-syntax row)
        (if (not (call has-expression-form source tree row))
          (call report-return-chains tree (. row body) context)
        )
      )
    )
  )
)

(fn-do _ report-return-chains _
  (param tree AST)
  (param id SyntaxId)
  (param context RuleContext)
  (if (or (== id 0) (call is-function-node tree id))
    (return)
  )
  (match? ([] (. tree nodes) id)
    (case .node-for-block
      (return)
    )
    (case .node-while-block
      (return)
    )
    (case (call .node-block row)
      (call report-chains-in tree row context)
    )
  )
  (for (in child (call (. tree children-of) id))
    (call report-return-chains tree child context)
  )
)

(fn-do _ report-chains-in _
  (param tree AST)
  (param block ASTBlock)
  (param context RuleContext)
  (let first SyntaxId 0)
  (let count 0)
  (for (in statement ([] (. tree children) (. block body)))
    (if (call is-value-exit tree statement)
      (if (== count 0)
        (= first statement)
      )
      (+= count 1)
      (continue)
    )
    (if (and (>= count 2) (call is-value-return tree statement))
      (let loc (. ([] (. tree nodes loc) first) begin))
      (call (. context report) (call decision-table-message) (+ (. loc line) 1) (+ (. loc column) 1) "review")
    )
    (= count 0)
  )
)

(fn-expr + decision-table-message String
  (str head " " tail)
  (where
    (lazy head "Review these `=?` cases: when they choose the result rather than exit early,")
    (lazy tail "write them and the final `=` as one match or table (YS-02).")
  )
)

(fn-expr + is-value-exit Bool
  (param tree AST)
  (param id SyntaxId)
  (match ([] (. tree nodes) id)
    (case (call .node-return-if-true row)
      (!= (. row expr) 0)
    )
    (default
      false
    )
  )
)

(fn-expr + is-value-return Bool
  (param tree AST)
  (param id SyntaxId)
  (match ([] (. tree nodes) id)
    (case (call .node-return row)
      (and (!= (. row expr) 0) (not (is ([] (. tree nodes) (. row expr)) .node-optional-chain)))
    )
    (default
      false
    )
  )
)
