./brix-fixes
./diagnostics
./function-form
./rule-context
./source
/lang/ast/ast
/lang/ast/ast-children
/lang/ast/ast-nodes
/lang/ast/operator
/lang/ast/row-range

━━━━━━━━━━━━━━━━━━━━
+ do lint-redundant-null-fallback
    - source LintSource
    - tree AST
    - context RuleContext

. attached = attached-nodes(tree)
. coalesced = coalesced-sides(tree)
for id in 1u32 .. < tree.nodes.length
    if !attached[id]
        continue
    match? tree.nodes[id]
        | .node-binary-expression(row)
            if is-null-fallback(tree, row) && !coalesced[id]
                . loc = tree.nodes.loc[id].begin
                . fix = if source.is-brix then brix-fallback-fix else text-fallback-fix
                    .. brix-fallback-fix = brix-null-fallback-fix(source, tree, id as SyntaxId)
                    .. text-fallback-fix = null-fallback-fix(source, tree, id as SyntaxId, row)
                . message = null-fallback-message()
                context.report(message, loc.line + 1, loc.column + 1, "actionable", fix)

━━━━━━━━━━━━━━━━━━━━
+ is-null-fallback Bool
    - tree AST
    - row ASTBinaryExpression

row.op == .else-op && is-named(tree, row.rhs, "null")

━━━━━━━━━━━━━━━━━━━━
_ do coalesced-sides [Bool]
    - tree AST

. sides [Bool]
for _ in 0 .. < tree.nodes.length
    sides += false
for id in 1u32 .. < tree.nodes.length
    match? tree.nodes[id]
        | .node-binary-expression(row)
            if row.op == .coalesce-op
                sides[row.lhs] = true
                match? tree.nodes[row.lhs]
                    | .node-binary-expression(inner)
                        if inner.op == .coalesce-op && tree.nodes.loc[row.lhs] == tree.nodes.loc[id]
                            sides[inner.rhs] = true
= sides

━━━━━━━━━━━━━━━━━━━━
+ null-fallback-message String

"$head $tail"

.. head = "Write `value if condition`: a value written with `if` is already null"
.. tail = "when its condition fails."

━━━━━━━━━━━━━━━━━━━━
+ do null-fallback-fix LintFix?
    - source LintSource
    - tree AST
    - id SyntaxId
    - row ASTBinaryExpression

. start = node-start(source, tree, id)
. end = node-end(source, tree, row.rhs)
. written = if end > start then source.slice(start, end) else ""
if written.find("\n") != null || !written.starts-with("if ") || !written.ends-with(" else null")
    = null
match? tree.nodes[row.lhs]
    | .node-binary-expression(guarded)
        . value = operand-text(source, tree, guarded.lhs)
        . condition = operand-text(source, tree, guarded.rhs)
        = LintFix
            - "safe"
            - "Write a conditional value"
            - [text-edit(source, start, end, "$value if $condition")]
= null

━━━━━━━━━━━━━━━━━━━━
+ operand-text String
    - source LintSource
    - tree AST
    - id SyntaxId

if is-loose(tree, id) then "(${node-text(source, tree, id)})" else node-text(source, tree, id)

━━━━━━━━━━━━━━━━━━━━
+ is-loose Bool
    - tree AST
    - id SyntaxId

match tree.nodes[id]
    | .node-binary-expression(row)
        row.op == .coalesce-op || row.op == .else-op || row.op == .if-op
    ??
        false

━━━━━━━━━━━━━━━━━━━━
+ do lint-decision-tables
    - source LintSource
    - tree AST
    - context RuleContext

. attached = attached-nodes(tree)
for id in 1u32 .. < tree.nodes.length
    if !attached[id]
        continue
    match? tree.nodes[id]
        | .node-function-syntax(row)
            if !has-expression-form(source, tree, row)
                report-return-chains(tree, row.body, context)

━━━━━━━━━━━━━━━━━━━━
_ do report-return-chains
    - tree AST
    - id SyntaxId
    - context RuleContext

if id == 0 || is-function-node(tree, id)
    =
match? tree.nodes[id]
    | .node-for-block
        =
    | .node-while-block
        =
    | .node-block(row)
        report-chains-in(tree, row, context)
for child in tree.children-of(id)
    report-return-chains(tree, child, context)

━━━━━━━━━━━━━━━━━━━━
_ do report-chains-in
    - tree AST
    - block ASTBlock
    - context RuleContext

. first SyntaxId = 0
. count = 0
for statement in tree.children[block.body]
    if is-value-exit(tree, statement)
        if count == 0
            first = statement
        count += 1
        continue
    if count >= 2 && is-value-return(tree, statement)
        . loc = tree.nodes.loc[first].begin
        context.report(decision-table-message(), loc.line + 1, loc.column + 1, "review")
    count = 0

━━━━━━━━━━━━━━━━━━━━
+ decision-table-message String

"$head $tail"

.. head = "Review these `=?` cases: when they choose the result rather than exit early,"
.. tail = "write them and the final `=` as one match or table (YS-02)."

━━━━━━━━━━━━━━━━━━━━
+ is-value-exit Bool
    - tree AST
    - id SyntaxId

match tree.nodes[id]
    | .node-return-if-true(row)
        row.expr != 0
    ??
        false

━━━━━━━━━━━━━━━━━━━━
+ is-value-return Bool
    - tree AST
    - id SyntaxId

match tree.nodes[id]
    | .node-return(row)
        row.expr != 0 && !(tree.nodes[row.expr] is .node-optional-chain)
    ??
        false
