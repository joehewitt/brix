(import /core/table)
(import /data/source-sexp)
(import /data/source-tree)
(import /lang/ast/brix-catalog)
(import /lang/ast/brix-check)
(import /lang/ubrix/layout)
(import /stream/aggregate)

(type + BrixFixer
  (prop + notes (list String))
  (blank)
  (prop _ catalog BrixCatalog)
  (prop _ store SourceStore)
  (fn-do + This _
    (param catalog _)
    (param store _)
  )
  (fn-do + rewritten String
    (param roots (list U32))
    (let nodes (list (of ImmutableTableRow SourceNode)))
    (let is-loose false)
    (for (in root roots)
      (let node (call (. store node) root))
      (if (call (. store is-form) node "main")
        (for (in row (call (. store listed) node 1))
          (+= nodes (call mended row))
        )
        (continue)
      )
      (let fixed (call mended node))
      (if (and (not (call (. store is-comment) fixed)) (not (call ubrix-is-top (?? (call (. store head) fixed) ""))))
        (= is-loose true)
      )
      (+= nodes fixed)
    )
    (if is-loose
      (+= notes "wrapped the code at the top level in (main …)")
    )
    (return (call sexp-text store nodes (call UBrixLayout store)))
  )
  (fn-do _ mended (of ImmutableTableRow SourceNode)
    (param node (of ImmutableTableRow SourceNode))
    (return-if node (if (not (call (. store is-list) node))))
    (blank)
    (let items (call (. store listed) node))
    (let is-changed false)
    (for (in index (..< 0 (. items length)))
      (let made (call mended ([] items index)))
      (if (!= (. made index) (. ([] items index) index))
        (= ([] items index) made)
        (= is-changed true)
      )
    )
    (let head (call (. store head) node))
    (return-if node (if (and (== head null) (not is-changed))))
    (return-if (call (. store with-items) node items) (if (== head null)))
    (blank)
    (if (and (has guarded head) (== (. items length) 3) (call (. store is-form) ([] items 1) "if") (not ends-with-if))
      (let held ([] items 1))
      (= ([] items 1) ([] items 2))
      (= ([] items 2) held)
      (= is-changed true)
      (+= notes (str "moved (if …) to the end of (" head " …)"))
    )
    (lazy ends-with-if (call (. store is-form) ([] items 2) "if"))
    (return (call doing (if-expr is-changed (call (. store with-items) node items) node) head))
    (blank)
    (lazy guarded (list "return-if" "only-if" "throw"))
  )
  (fn-do _ doing (of ImmutableTableRow SourceNode)
    (param node (of ImmutableTableRow SourceNode))
    (param head String)
    (return-if (call doing-head node head) (if (and (call ubrix-is-callable head) (call (. head ends-with) "-expr"))))
    (blank)
    (let senses (call (. catalog senses) head))
    (return-if node (if (== senses null)))
    (blank)
    (let is-able false)
    (for (in sense senses)
      (if (. sense is-doing)
        (= is-able true)
      )
    )
    (return-if node (if (not is-able)))
    (blank)
    (for (in item (call (. store items) node))
      (return-if node (if (and (call (. store is-atom) item) (== (call (. store text) item) ":do"))))
    )
    (for (in sense senses)
      (return-if node (if (and (not (. sense is-doing)) (call fits node sense))))
    )
    (return-if node (if (and (call owes node head) (not (call returns node true)))))
    (blank)
    (let mark (call (. store atom) ":do"))
    (for (in slot (.. 1 (call (. store count) node)))
      (let made (call (. store inserted) node slot mark))
      (for (in sense senses)
        (if (and (. sense is-doing) (call fits made sense))
          (+= notes (str "added :do to (" head " " (call title node) " …)"))
          (return made)
        )
      )
    )
    (return node)
  )
  (fn-do _ doing-head (of ImmutableTableRow SourceNode)
    (param node (of ImmutableTableRow SourceNode))
    (param head String)
    (for (in sense (?? (call (. catalog senses) head) (call (of List BrixSense))))
      (return-if node (if (call fits node sense)))
    )
    (let twin (str ([] head (..< 0 (- (. head length) 5))) "-do"))
    (return-if node (if (and (call owes node twin) (not (call returns node true)))))
    (blank)
    (let items (call (of List (of ImmutableTableRow SourceNode)) (call (. store atom) twin)))
    (++= items (call (. store listed) node 1))
    (let made (call (. store with-items) node items))
    (for (in sense (?? (call (. catalog senses) twin) (call (of List BrixSense))))
      (if (call fits made sense)
        (+= notes (str "wrote (" twin " " (call title node) " …) for (" head " …)"))
        (return made)
      )
    )
    (return node)
  )
  (fn-expr _ fits Bool
    (param node (of ImmutableTableRow SourceNode))
    (param sense BrixSense)
    (?? (catch? (call brix-text-fits (call sexp-inline-text store node) sense)) false)
  )
  (fn-expr _ owes Bool
    (param node (of ImmutableTableRow SourceNode))
    (param head String)
    (case? (== head "fn-to-do")
      true
    )
    (case? (or (!= head "fn-do") (< (call (. store count) node) 4))
      false
    )
    (default
      (not (and (call (. store is-atom) result) (== (call (. store text) result) "_")))
    )
    (where
      (lazy result (call (. store item) node 3))
    )
  )
  (fn-do _ returns Bool
    (param node (of ImmutableTableRow SourceNode))
    (param is-outer Bool)
    (let head (?? (call (. store head) node) ""))
    (return-if true (if (has leaving head)))
    (return-if false (if (and (not is-outer) (has nested head))))
    (return (call some (call (. store items) node) (:where (call returns each false))))
    (blank)
    (lazy leaving (list "return" "return?" "return-if" "yield" "yield?" "yield-all" "yield-all?"))
    (lazy nested (list "=>" "fn-do" "fn-expr" "fn-from-do" "fn-from-expr" "fn-to-do" "fn-to-expr"))
  )
  (fn-do _ title String
    (param node (of ImmutableTableRow SourceNode))
    (for (in item (call (. store listed) node 1))
      (let text (if-expr (call (. store is-atom) item) (call (. store text) item) (?? (call (. store head) item) "")))
      (if (and (!= text "+") (!= text "_") (!= text ""))
        (return text)
      )
    )
    (return "")
  )
)
