./diagnostics
/data/json
/os/file
/os/path
/stream/aggregate

━━━━━━━━━━━━━━━━━━━━
+ LintConfig

+ path String?
+ search-path String?
+ semantic-roots [String]
+ rules [String = [String = JSON]]

────────────────────
+ This

━━━━━━━━━━━━━━━━━━━━
+ do load-lint-config LintConfig
    - project-root String
    - catalog [LintRule]
    - config-path String? = null

. config = LintConfig()
config.path = config-path ?? find-lint-config-path(project-root)

. root = config-object(config.path)
config.search-path = config-search-path(root, config-base(project-root, config.path))
config.semantic-roots = config-semantic-roots(root, config-base(project-root, config.path))
. settings = rule-settings(root, catalog)
. recommended = uses-recommended(root["extends"])
for rule in catalog
    . options = rule-options(rule, recommended, settings[rule.id])
    if options
        config.rules[rule.id] = options
= config

━━━━━━━━━━━━━━━━━━━━
+ find-lint-config-path String? ?! Error
    - dir String

|? Path(candidate).is-file
    candidate
|? parent.length == 0 || parent == dir
    null
??
    find-lint-config-path(parent)

.. candidate = "$dir/.yumi/lint.json"
.. parent = Path(dir).dir as String

━━━━━━━━━━━━━━━━━━━━
+ do config-object [String = JSON]
    - path String?

if !path
    = Map'String'JSON()

. decoded = JSON(read-file-text(Path(path)))
?! Error("The lint config must contain an object")
    if decoded is not [String = JSON]
= decoded

━━━━━━━━━━━━━━━━━━━━
+ config-base String
    - project-root String
    - config-path String?

|? !config-path
    project-root
|? dir.starts-with("/")
    dir
|? dir.length == 0
    project-root
??
    "$project-root/$dir"

.. folder = Path(config-path).dir
.. dir = (if folder.name == ".yumi" then folder.dir else folder) as String

━━━━━━━━━━━━━━━━━━━━
+ config-search-path String? ?! Error
    - root [String = JSON]
    - base String

|? !entries
    null
??
    match entries
        | paths List {all(it) • where each is String}
            ":".join(resolved-config-path(base, each as String) in paths)
        ?! Error("The lint config's searchPath must be an array of paths")

.. entries = root["searchPath"]

━━━━━━━━━━━━━━━━━━━━
+ do config-semantic-roots [String] ?! Error
    - root [String = JSON]
    - base String

` The roots `semantic.roots` names for the semantic rules, each against the config's directory.
. paths [String]
. semantic = root["semantic"]
if !semantic
    = paths
?! Error("The lint config's semantic must be an object")
    if semantic is not [String = JSON]
. roots = (semantic as [String = JSON])["roots"]
if !roots
    = paths
?! Error("The lint config's semantic.roots must be an array of paths")
    if roots is not [JSON]
for entry in roots as [JSON]
    ?! Error("The lint config's semantic.roots entries must be paths")
        if entry is not String
    paths += resolved-config-path(base, entry)
= paths

━━━━━━━━━━━━━━━━━━━━
+ resolved-config-path String
    - base String
    - entry String

|? entry.starts-with("/")
    entry
??
    "$base/$entry"

━━━━━━━━━━━━━━━━━━━━
+ do rule-settings [String = JSON]
    - root [String = JSON]
    - catalog [LintRule]

. settings = root["rules"]
if !settings
    = Map'String'JSON()
?! Error("The lint config's rules must be an object")
    if settings is not [String = JSON]

. listed = settings as [String = JSON]
for id, setting in listed
    ?! Error("Unknown lint rule: $id")
        if !find-rule(catalog, id)
= listed

━━━━━━━━━━━━━━━━━━━━
+ uses-recommended Bool
    - value JSON?

|? !value
    true
??
    match value
        | items List
            mentions-recommended(items)
        | word String
            word == "recommended"
        ??
            false

━━━━━━━━━━━━━━━━━━━━
+ mentions-recommended Bool
    - items [JSON]

!!found

.. found
    **? items
    ?> is-recommended-word(each)
    |> first

━━━━━━━━━━━━━━━━━━━━
+ is-recommended-word Bool
    - item JSON

item is String && item as String == "recommended"

━━━━━━━━━━━━━━━━━━━━
+ rule-options [String = JSON]?
    - rule LintRule
    - recommended Bool
    - setting JSON? = null

|? setting
    resolve-rule-setting(rule, setting)
|? recommended && rule.recommended
    default-options(rule)
??
    null

━━━━━━━━━━━━━━━━━━━━
+ resolve-rule-setting [String = JSON]?
    - rule LintRule
    - setting JSON

match setting
    | Bool {it}
        default-options(rule)
    | Bool
        null
    | String {it == "on"}
        default-options(rule)
    | String {it == "off"}
        null
    | overrides Map
        validated(rule, merge-options(rule.default-options, overrides))
    ?! Error("Invalid lint rule setting for ${rule.id}: ${to-json(setting)}")

━━━━━━━━━━━━━━━━━━━━
+ default-options [String = JSON]
    - rule LintRule

validated(rule, copy-options(rule.default-options))

━━━━━━━━━━━━━━━━━━━━
+ do validated [String = JSON]
    - rule LintRule
    - options [String = JSON]

if rule.id == "complexity/cyclomatic"
    . max = options["max"]
    . valid = max && max is Int && max as Int > 0
    ?! Error("Invalid lint rule configuration for ${rule.id}: max must be a positive integer")
        if !valid

= options

━━━━━━━━━━━━━━━━━━━━
+ do copy-options [String = JSON]
    - options [String = JSON]

. copied [String = JSON]
for key, value in options
    copied[key] = value
= copied

━━━━━━━━━━━━━━━━━━━━
+ do merge-options [String = JSON]
    - defaults [String = JSON]
    - overrides [String = JSON]

. merged = copy-options(defaults)
for key, value in overrides
    . existing = defaults[key]
    if existing && existing is [String = JSON] && value is [String = JSON]
        merged[key] = merge-options(existing, value)
    else
        merged[key] = value
= merged

━━━━━━━━━━━━━━━━━━━━
+ option-int Int
    - options [String = JSON]
    - key String
    - fallback Int

|? value && value is Int
    value as Int
??
    fallback

.. value = options[key]
