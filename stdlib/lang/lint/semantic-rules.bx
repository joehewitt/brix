(import ./brix-fixes)
(import ./rule-context)
(import ./semantic-facts)
(import ./source)

(fn-do + run-semantic-rule _
  (param rule-id String)
  (param source LintSource)
  (param facts SemanticFacts)
  (param context RuleContext)
  (if (== rule-id "style/no-redundant-default-initializer")
    (call lint-redundant-default source facts context)
  )
  (if (== rule-id "style/prefer-constructor-initializer")
    (call lint-constructor-overwrite source facts context)
  )
  (if (== rule-id "style/no-redundant-context-cast")
    (call lint-context-cast facts context)
  )
  (if (== rule-id "style/no-redundant-literal-suffix")
    (call lint-literal-suffix source facts context)
  )
  (if (== rule-id "events/no-effectful-payload")
    (call lint-payload-effects facts context)
  )
  (if (== rule-id "names/case-owner-conflict")
    (call lint-case-owners facts context)
  )
)

(fn-do + lint-payload-effects _
  (param facts SemanticFacts)
  (param context RuleContext)
  ; Reports the payload of an event that has effects, once for each set of effects instances found
  ; at it, as the reference's `events/no-effectful-payload` does.
  (let seen (map String Bool))
  (for (in payload (. facts payloads))
    (let key (str (. payload line) ":" (. payload column) ":" (. payload event) ":" (. payload effects)))
    (if ([] seen key)
      (continue)
    )
    (= ([] seen key) true)
    (let message (str "Move side effects out of event \"" (. payload event) "\" payload; event payloads run "))
    (+= message (str "lazily only when observed. Found " (. payload effects) "."))
    (call (. context report) message (. payload line) (. payload column))
  )
)

(fn-do + lint-case-owners _
  (param facts SemanticFacts)
  (param context RuleContext)
  ; Reports a case given by its symbol alone that functions a call may choose take as a case of
  ; more than one type, once for each place and name, as the reference's
  ; `names/case-owner-conflict` does.
  (let seen (map String Bool))
  (for (in found (. facts case-owners))
    (let key (str (. found line) ":" (. found column) ":" (. found name)))
    (if ([] seen key)
      (continue)
    )
    (= ([] seen key) true)
    (let quoted (list String))
    (for (in owner (. found owners))
      (+= quoted (str "'" owner "'"))
    )
    (let last ([] quoted (- (. quoted length) 1)))
    (call (. quoted pop))
    (let listed (str (call (. ", " join) quoted) " and " last))
    (let message (str "Write '" (. found chosen) "." (. found name) "'; overloads of this call accept "))
    (+= message (str "'." (. found name) "' from " listed ", and visibility order chose '" (. found chosen) "'."))
    (call (. context report) message (. found line) (. found column))
  )
)

(fn-do + lint-context-cast _
  (param facts SemanticFacts)
  (param context RuleContext)
  ; Reports a cast to the type its place already takes the value as, in an instance that typed
  ; it, as the reference's `style/no-redundant-context-cast` does: for review where instances
  ; cast to different types, or where the instance's function or class takes type parameters,
  ; since other type arguments may need the cast.
  (let order (list String))
  (let groups (map String (list SemanticCast)))
  (for (in cast (. facts casts))
    (let key (str (. cast line) ":" (. cast column)))
    (if (not ([] groups key))
      (+= order key)
      (let group (list SemanticCast))
      (= ([] groups key) group)
    )
    (+= (!! ([] groups key)) cast)
  )
  (for (in key order)
    (let group (!! ([] groups key)))
    (let first ([] group 0))
    (let review false)
    (for (in cast group)
      (if (or (!= (. cast target) (. first target)) (. cast is-generic))
        (= review true)
      )
    )
    (let target (str "cast to \"" (. first target) "\""))
    (if review
      (let written (and (!= (. first written length) 0) (!= (. first written) (. first target))))
      (let shown (if-expr written (str " (source target \"" (. first written) "\")") ""))
      (let message (str "Review observed redundant " target shown "; " (. first context) " provided that "))
      (+= message "type context in an observed instantiation, but this generic cast may affect ")
      (+= message "dispatch for other type arguments.")
      (call (. context report) message (. first line) (. first column) "review")
      (else
        (let message (str "Remove redundant " target "; " (. first context) " already provides that type context."))
        (call (. context report) message (. first line) (. first column))
      )
    )
  )
)

(fn-do + lint-literal-suffix _
  (param source LintSource)
  (param facts SemanticFacts)
  (param context RuleContext)
  (let seen (map String Bool))
  (for (in suffix (. facts suffixes))
    (let key (str (. suffix line) ":" (. suffix column)))
    (if ([] seen key)
      (continue)
    )
    (= ([] seen key) true)
    (let fix (call brix-suffix-fix source (. suffix line) (. suffix column) (. suffix unit)))
    (if (not fix)
      (continue)
    )
    (let lead (str "Remove redundant suffix \"" (. suffix unit) "\";"))
    (let message (str lead " where it is written, the number already takes that type."))
    (call (. context report) message (. suffix line) (. suffix column) "actionable" fix)
  )
)

(fn-do + lint-redundant-default _
  (param source LintSource)
  (param facts SemanticFacts)
  (param context RuleContext)
  ; Reports a value written as the default of the type it is declared as, where every instance
  ; that typed it declared one type, with a fix that removes it, as the reference's
  ; `style/no-redundant-default-initializer` does.
  (let order (list String))
  (let groups (map String (list SemanticDefault)))
  (for (in value (. facts defaults))
    (let key (str (. value line) ":" (. value column)))
    (if (not ([] groups key))
      (+= order key)
      (let group (list SemanticDefault))
      (= ([] groups key) group)
    )
    (+= (!! ([] groups key)) value)
  )
  (for (in key order)
    (let group (!! ([] groups key)))
    (let first ([] group 0))
    (let same true)
    (for (in value group)
      (if (!= (. value type-name) (. first type-name))
        (= same false)
      )
    )
    (if same
      (let message "Omit initializer; the declared type already supplies this default.")
      (let fix (call brix-default-fix source (. first line) (. first column)))
      (call (. context report) message (. first line) (. first column) "actionable" fix)
    )
  )
)

(fn-do + lint-constructor-overwrite _
  (param source LintSource)
  (param facts SemanticFacts)
  (param context RuleContext)
  ; Reports a constructor's assignment that discards the value the constructor built for a
  ; property, once for where it is written, as the instance typed first saw it, with a fix that
  ; makes it an initializer where one can take its place, as the reference's
  ; `style/prefer-constructor-initializer` does.
  (let seen (map String Bool))
  (for (in overwrite (. facts overwrites))
    (let key (str (. overwrite line) ":" (. overwrite column)))
    (if ([] seen key)
      (continue)
    )
    (= ([] seen key) true)
    (let name (. overwrite name))
    (let type (. overwrite type-name))
    (if (. overwrite actionable)
      (let lead (str "Initialize " name " with `..`; this assignment discards the default"))
      (let message (str lead " " type " the constructor already built."))
      (let fix (call brix-initializer-fix source (. overwrite line) (. overwrite column) name))
      (call (. context report) message (. overwrite line) (. overwrite column) "actionable" fix)
      (else
        (let lead (str "This assignment discards the default " type " the constructor already built"))
        (let tail "initialize it with `..` if its value does not depend on earlier statements.")
        (call (. context report) (str lead " for " name "; " tail) (. overwrite line) (. overwrite column) "review")
      )
    )
  )
)

