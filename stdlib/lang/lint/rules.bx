(import ./brix-fit)
(import ./brix-fixes)
(import ./conditionals)
(import ./config)
(import ./diagnostics)
(import ./function-form)
(import ./quantifiers)
(import ./rule-context)
(import ./source)
(import ./symbols)
(import ./templates)
(import /data/json)
(import /lang/ast/ast)
(import /lang/ast/ast-children)
(import /lang/ast/ast-nodes)
(import /lang/ast/error)
(import /lang/ast/operator)
(import /lang/ast/row-range)
(import /stream/aggregate)
(import /stream/sort)

(fn-do + run-text-rule _
  (param rule-id String)
  (param source LintSource)
  (param context RuleContext)
  (if (== rule-id "layout/line-length")
    (call lint-line-length source context)
  )
  (if (== rule-id "layout/divider-length")
    (call lint-divider-length source context)
  )
)

(fn-do + lint-divider-length _
  (param source LintSource)
  (param context RuleContext)
  (let index 0u32)
  (for (in line (. source lines))
    (let row index)
    (+= index 1)
    (if (!= (call classify-line line) .line-divider)
      (continue)
    )
    (blank)
    (let trimmed (call (. line trim)))
    (let replacement (* (str ([] trimmed 0)) 20))
    (if (== trimmed replacement)
      (continue)
    )
    (blank)
    (let indent Index 0)
    (for (in char line)
      (if (not (call is-space-char char))
        (break)
      )
      (+= indent 1)
    )
    (let start (+ ([] (. source utf16-line-starts) row) indent))
    (let edit (call LintTextEdit start (+ start (call utf16-length trimmed)) replacement trimmed))
    (let fix (only-if (call LintFix "safe" "Normalize divider width" (list edit)) (if (not (call mixed-divider trimmed)))))
    (call (. context report)
      (block
        (arg "Divider must contain exactly 20 identical divider characters.")
        (arg index)
        (arg (as (+ indent 1) U32))
        (arg "actionable")
        (arg fix)
      )
    )
  )
)

(fn-do + mixed-divider Bool
  (param line String)
  (for (in char line)
    (if (!= char ([] line 0))
      (return true)
    )
  )
  (return false)
)

(fn-do + run-ast-rule _
  (param rule-id String)
  (param source LintSource)
  (param tree AST)
  (param context RuleContext)
  (if (== rule-id "complexity/cyclomatic")
    (call lint-cyclomatic tree context)
  )
  (if (== rule-id "style/no-unused-catch-optional")
    (call lint-unused-catch-optional tree context)
  )
  (if (== rule-id "style/prefer-optional-match")
    (call lint-optional-match tree context)
  )
  (if (== rule-id "style/no-nested-match-assertions")
    (call lint-nested-match-assertions source tree context)
  )
  (if (== rule-id "style/prefer-map-literal")
    (call lint-map-literal source tree context)
  )
  (if (== rule-id "tui/prefer-shortcut-node")
    (call lint-shortcut-node tree context)
  )
  (if (== rule-id "style/prefer-expression-function")
    (call lint-expression-functions source tree context)
  )
  (if (== rule-id "style/no-redundant-null-fallback")
    (call lint-redundant-null-fallback source tree context)
  )
  (if (== rule-id "style/prefer-decision-table")
    (call lint-decision-tables source tree context)
  )
  (if (== rule-id "style/prefer-quantifier")
    (call lint-quantifiers source tree context)
  )
  (if (== rule-id "style/prefer-text-template")
    (call lint-text-templates source tree context)
  )
)

(fn-do + lint-parse-error _
  (param error YumiSyntaxError)
  (param context RuleContext)
  (call (. context report) (. error message) (+ (. error loc begin line) 1) (+ (. error loc begin column) 1))
)

(fn-do + run-declaration-rule _
  (param rule-id String)
  (param analysis ModuleAnalysis)
  (param context RuleContext)
  (if (== rule-id "imports/sort")
    (call lint-import-order analysis context)
  )
  (if (== rule-id "names/type-param-shadows-type")
    (call lint-type-param-shadows analysis context)
  )
  (if (== rule-id "names/import-conflicts")
    (call lint-import-conflicts analysis context)
  )
  (if (== rule-id "names/local-shadows-import")
    (call lint-local-shadows-import analysis context)
  )
  (if (== rule-id "style/prefer-shorthand")
    (call lint-shorthands analysis context)
  )
)

(fn-do + lint-line-length _
  (param source LintSource)
  (param context RuleContext)
  (let max (call option-int (. context options) "max" 100))
  (let template-text (call template-text-lines (. source lines)))
  (let longs (list U32))
  (let index 0u32)
  (for (in line (. source lines))
    (+= index 1)
    (let kind (call classify-line line))
    (if (and (!= kind .line-divider) (!= kind .line-comment) (not ([] template-text (- index 1))) (> (call visible-length line) max))
      (+= longs index)
    )
  )
  (let fixes (map U32 LintFix))
  (if (and (. context is-fixing) (!= (. longs length) 0))
    (= fixes (call yumi-fit-fixes source longs (as max Size)))
  )
  (for (in line longs)
    (let length (call visible-length ([] (. source lines) (as (- line 1) Index))))
    (call (. context report) (str "Line is " length " columns; expected " max " or fewer.") line (as (+ max 1) U32) "actionable" ([] fixes line))
  )
)

(type + ComplexityCounts
  (prop + if-branches Int)
  (prop + loops Int)
  (prop + loop-clauses Int)
  (prop + conditional-returns Int)
  (prop + conditional-asserts Int)
  (prop + catch-handlers Int)
  (prop + matches Int)
  (prop + short-circuit-operators Int)
  (fn-do + This _)
  (fn-expr + total Int :get
    (scope (+ branches exits catch-handlers matches short-circuit-operators)
      (lazy branches (+ if-branches loops loop-clauses))
      (lazy exits (+ conditional-returns conditional-asserts))
    )
  )
  (fn-expr + describe String :get
    (call (. ", " join) parts)
  )
  (fn-expr + parts (list String) :get
    (item? (only-if (call counted if-branches "if branch" "if branches") (if (!= if-branches 0))))
    (item? (only-if (call counted loops "loop" "loops") (if (!= loops 0))))
    (item? (only-if (call counted loop-clauses "loop clause" "loop clauses") (if (!= loop-clauses 0))))
    (item? (only-if (call counted conditional-returns "conditional return" "conditional returns") (if (!= conditional-returns 0))))
    (item? (only-if (call counted conditional-asserts "conditional assert" "conditional asserts") (if (!= conditional-asserts 0))))
    (item? (only-if (call counted catch-handlers "catch handler" "catch handlers") (if (!= catch-handlers 0))))
    (item? (only-if (call counted matches "match" "matches") (if (!= matches 0))))
    (item? (only-if (call counted short-circuit-operators "short-circuit operator" "short-circuit operators") (if (!= short-circuit-operators 0))))
  )
)

(fn-do + lint-cyclomatic _
  (param tree AST)
  (param context RuleContext)
  (let max (call option-int (. context options) "max" 15))
  (let total (. tree nodes length))
  (blank)
  (for (in id (..< 1u32 total))
    (let body (call function-body tree (as id SyntaxId)))
    (if (== body 0)
      (continue)
    )
    (blank)
    (let counts (call ComplexityCounts))
    (let seen (map U32 Bool))
    (call measure-complexity tree body counts seen)
    (blank)
    (let complexity (+ 1 (. counts total)))
    (if (<= complexity max)
      (continue)
    )
    (blank)
    (let loc ([] (. tree nodes loc) id))
    (let detail (. counts describe))
    (let message (str "Function has cyclomatic complexity " complexity "; expected " max " or fewer (" detail ")."))
    (call (. context report) message (+ (. loc begin line) 1) (+ (. loc begin column) 1))
  )
)

(fn-expr + function-body SyntaxId
  (param tree AST)
  (param id SyntaxId)
  (match ([] (. tree nodes) id)
    (case (call .node-function-syntax row)
      (. row body)
    )
    (case (call .node-getter-syntax row)
      (. row body)
    )
    (case (call .node-setter-syntax row)
      (. row body)
    )
    (default
      0
    )
  )
)

(fn-do _ measure-complexity _
  (param tree AST)
  (param id SyntaxId)
  (param counts ComplexityCounts)
  (param seen (map U32 Bool))
  (if (or (== id 0) ([] seen id))
    (return)
  )
  (= ([] seen id) true)
  (blank)
  (if (call is-function-node tree id)
    (return)
  )
  (blank)
  (match? ([] (. tree nodes) id)
    (case (call .node-if-block row)
      (if (!= (. row condition) 0)
        (+= (. counts if-branches) 1)
      )
    )
    (case (call .node-binary-expression row)
      (if (== (. row op) .if-op)
        (+= (. counts if-branches) 1)
        (else-if (or (== (. row op) .and-op) (== (. row op) .or-op) (== (. row op) .coalesce-op))
          (+= (. counts short-circuit-operators) 1)
        )
      )
    )
    (case .node-while-block
      (+= (. counts loops) 1)
    )
    (case .node-loop-syntax
      (+= (. counts loops) 1)
    )
    (case (call .node-clause row)
      (if (or (== (. row op) .when-clause) (== (. row op) .while-clause) (== (. row op) .until-clause))
        (+= (. counts loop-clauses) 1)
      )
    )
    (case .node-return-if-true
      (+= (. counts conditional-returns) 1)
    )
    (case (call .node-assertion-syntax row)
      (if (!= (. row condition) 0)
        (+= (. counts conditional-asserts) 1)
      )
    )
    (case (call .node-catch-expression row)
      (if (not (call is-error-transformer tree row))
        (+= (. counts catch-handlers) (. row catchers count))
      )
    )
    (case .node-match-expression
      (+= (. counts matches) 1)
    )
  )
  (blank)
  (for (in child (call (. tree children-of) id))
    (call measure-complexity tree child counts seen)
  )
)

(fn-expr + is-error-transformer Bool
  (param tree AST)
  (param row ASTCatchExpression)
  (and (!= (. row catchers count) 0) (call is-bare-assertion tree (. row body)))
)

(fn-expr + is-bare-assertion Bool
  (param tree AST)
  (param id SyntaxId)
  (match ([] (. tree nodes) id)
    (case (call .node-assertion-syntax row)
      (== (. row condition) 0)
    )
    (default
      false
    )
  )
)

(type + SortableImport
  (prop + import-path String)
  (prop + text String)
  (prop + original-index Int)
  (prop + start Index)
  (prop + end Index)
  (prop + line U32)
  (prop + column U32)
  (fn-do + This _
    (param import-path String)
    (param text String)
    (param original-index Int)
    (param start Index)
    (param end Index)
    (param line U32)
    (param column U32)
  )
)

(fn-do + lint-import-order _
  (param analysis ModuleAnalysis)
  (param context RuleContext)
  (let source (. analysis source))
  (let items (list SortableImport))
  (let index 0)
  (for (in entry (. analysis imports))
    (if (and (. entry resolved-path) (== (. entry begin-line) (. entry end-line)))
      (let start (call (. source offset-of) (. entry begin-line) (. entry begin-column)))
      (let end (+ (call (. source offset-of) (. entry end-line) (. entry end-column)) 1))
      (let text (call (. source slice) start end))
      (let line (+ (. entry begin-line) 1))
      (let column (+ (. entry begin-column) 1))
      (+= items (call SortableImport (. entry import-path) text index start end line column))
    )
    (+= index 1)
  )
  (blank)
  (let has-conflict (call has-import-name-conflict (. analysis imported-symbols)))
  (let group (list SortableImport))
  (for (in item items)
    (if (and (!= (. group length) 0) (not (call is-line-break (call (. source slice) (. ([] group (- (. group length) 1)) end) (. item start)))))
      (call report-import-group source group has-conflict context)
      (let fresh (list SortableImport))
      (= group fresh)
    )
    (+= group item)
  )
  (blank)
  (call report-import-group source group has-conflict context)
)

(fn-expr + is-line-break Bool
  (param text String)
  (or (== text "\n") (== text "\r\n"))
)

(fn-expr + conflict-message String
  (scope (str head " " tail)
    (lazy head "Sort module imports alphabetically after reviewing overlapping names;")
    (lazy tail "auto-fix skipped because import-order independence is not proven.")
  )
)

(fn-do _ report-import-group _
  (param source LintSource)
  (param group (list SortableImport))
  (param has-conflict Bool)
  (param context RuleContext)
  (if (< (. group length) 2)
    (return)
  )
  (blank)
  (let sorted (call sort group (:using compare-imports)))
  (let moved-at 0)
  (while (and (< moved-at (. group length)) (== ([] group moved-at) ([] sorted moved-at)))
    (+= moved-at 1)
  )
  (if (== moved-at (. group length))
    (return)
  )
  (blank)
  (let moved ([] group moved-at))
  (if has-conflict
    (call (. context report) (call conflict-message) (. moved line) (. moved column))
    (return)
  )
  (blank)
  (let first ([] group 0))
  (let last ([] group (- (. group length) 1)))
  (let line-break (call import-line-break source group))
  (let texts (list String))
  (for (in item sorted)
    (+= texts (. item text))
  )
  (blank)
  (let replacement (call (. line-break join) texts))
  (let edit (call LintTextEdit (. first start) (. last end) replacement (call (. source slice) (. first start) (. last end))))
  (let fix (call LintFix "safe" "Sort module imports alphabetically" (list edit)))
  (blank)
  (call (. context report) "Sort module imports alphabetically." (. moved line) (. moved column) "actionable" fix)
)

(fn-do + import-line-break String
  (param source LintSource)
  (param group (list SortableImport))
  (for (in position (..< 1 (. group length)))
    (let separator (call (. source slice) (. ([] group (- position 1)) end) (. ([] group position) start)))
    (if (call is-line-break separator)
      (return separator)
    )
  )
  (return "\n")
)

(fn-expr + compare-imports Comparison
  (param left SortableImport)
  (param right SortableImport)
  (case? (!= (. left import-path) (. right import-path))
    (call compare-basic (. left import-path) (. right import-path))
  )
  (default
    (call compare-basic (. left original-index) (. right original-index))
  )
)

(type + NameConflict (is U32)
  (variant conflict-none (= 0))
  (variant conflict-visibility (= 1))
  (variant conflict-overlap (= 2))
  (variant conflict-uncertain (= 3))
)

(type + SymbolGroups
  ; Symbols grouped by namespace and name, with the keys in the order each is first seen.
  (blank)
  (prop + keys (list String))
  (prop + groups (map String (list NameSymbol)))
  (fn-do + This _
    (param symbols (list NameSymbol))
    (for (in symbol symbols)
      (let key (. symbol key))
      (if (not ([] groups key))
        (let fresh (list NameSymbol))
        (= ([] groups key) fresh)
        (+= keys key)
      )
      (+= (!! ([] groups key)) symbol)
    )
  )
)

(fn-do + has-import-name-conflict Bool
  (param symbols (list NameSymbol))
  (let grouped (call SymbolGroups symbols))
  (for (in key (. grouped keys))
    (if (!= (call classify-name-conflict (!! ([] (. grouped groups) key))) .conflict-none)
      (return true)
    )
  )
  (return false)
)

(fn-do + classify-name-conflict NameConflict
  (param symbols (list NameSymbol))
  (param imported (? (list NameSymbol)) (= null))
  ; How symbols that share a name compete: not at all, by visibility alone, as functions a call
  ; with no arguments may choose between, or as overloads only a call site can settle. Without
  ; `imported` the symbols compete among themselves, and otherwise each competes with each imported.
  ; Symbols that no one build sees together do not compete.
  (if (and (not imported) (<= (. (call unique-conflict-origins symbols) length) 1))
    (return .conflict-none)
  )
  (let others (?? imported symbols))
  (let result (. NameConflict conflict-none))
  (for (in index (..< 0 (. symbols length)))
    (let left ([] symbols index))
    (let first (if-expr imported 0 (+ index 1)))
    (for (in position (..< first (. others length)))
      (let right ([] others position))
      (if (or (== (. left origin-key) (. right origin-key)) (not (call (. left shares-build) right)))
        (continue)
      )
      (if (and (not imported) (== (. left origin-path) (. right origin-path)))
        (if (== (. left origin-name) (. right origin-name))
          (continue)
        )
      )
      (if (or (!= (. left kind) "function") (!= (. right kind) "function"))
        (return .conflict-visibility)
      )
      (let a (. left call-shape))
      (let b (. right call-shape))
      (if (and a b)
        (if (call call-shapes-disjoint a b)
          (continue)
        )
        (if (and (. a no-args) (. b no-args))
          (= result .conflict-overlap)
          (continue)
        )
      )
      (if (!= result .conflict-overlap)
        (= result .conflict-uncertain)
      )
    )
  )
  (return result)
)

(fn-do + unique-conflict-origins (list NameSymbol)
  (param symbols (list NameSymbol))
  ; The first symbol of each module among `symbols`, where modules whose symbols are all C functions
  ; count as one when they declare the same functions.
  (let modules (list String))
  (let families (map String (list NameSymbol)))
  (for (in symbol symbols)
    (let key (. symbol module-key))
    (if (not ([] families key))
      (let fresh (list NameSymbol))
      (= ([] families key) fresh)
      (+= modules key)
    )
    (+= (!! ([] families key)) symbol)
  )
  (blank)
  (let seen (map String Bool))
  (let origins (list NameSymbol))
  (for (in module modules)
    (let family (!! ([] families module)))
    (let key (?? (call c-family-key family) module))
    (if (not ([] seen key))
      (= ([] seen key) true)
      (+= origins ([] family 0))
    )
  )
  (return origins)
)

(fn-do + c-family-key (? String)
  (param family (list NameSymbol))
  ; The declarations a module's C functions stand for, or none where one is not a C function.
  (let keys (map String Bool))
  (for (in symbol family)
    (if (!= (. symbol kind) "c-function")
      (return null)
    )
    (= ([] keys (. symbol origin-key)) true)
  )
  (let sorted (call sort (. keys keys)))
  (let joined (call (. "\n" join) sorted))
  (return (str "c-functions\n" joined))
)

(fn-expr + origin-list String
  (param symbols (list NameSymbol))
  (call (. ", " join) (*> symbols (. each origin-label)))
)

(fn-expr + namespace-label String
  (param namespace String)
  (if-expr (== namespace "c-value") "C value" namespace)
)

(fn-expr + conflict-status String
  (param conflict NameConflict)
  (if-expr (== conflict .conflict-uncertain) "review" "actionable")
)

(fn-expr + conflict-description String
  (param conflict NameConflict)
  (case? (== conflict .conflict-uncertain)
    (str uncertain " " resolution)
  )
  (case? (== conflict .conflict-overlap)
    "competing functions accept a no-argument call; candidate selection can depend on order"
  )
  (default
    "visibility overlaps; check the binding at each use before changing import order"
  )
  (where
    (lazy uncertain "possible overload competition; argument types, generic constraints, and")
    (lazy resolution "candidate ranking require call-site resolution")
  )
)

(fn-do + lint-import-conflicts _
  (param analysis ModuleAnalysis)
  (param context RuleContext)
  (let grouped (call SymbolGroups (. analysis imported-symbols)))
  (for (in key (. grouped keys))
    (let symbols (!! ([] (. grouped groups) key)))
    (let conflict (call classify-name-conflict symbols))
    (if (== conflict .conflict-none)
      (continue)
    )
    (blank)
    (let site ([] symbols 0))
    (for (in symbol symbols)
      (if (> (. symbol import-priority) (. site import-priority))
        (= site symbol)
      )
    )
    (let first ([] symbols 0))
    (let origins (call origin-list (call unique-conflict-origins symbols)))
    (let message (str "Imported " (call namespace-label (. first namespace)) " name \"" (. first name) "\" is exported "))
    (+= message (str "by " origins "; " (call conflict-description conflict) "."))
    (let status (call conflict-status conflict))
    (call (. context report) message (+ (. site import-line) 1) (+ (. site import-column) 1) status)
  )
)

(fn-do + lint-local-shadows-import _
  (param analysis ModuleAnalysis)
  (param context RuleContext)
  (let imported (call SymbolGroups (. analysis imported-symbols)))
  (let locals (call SymbolGroups (. analysis local-symbols)))
  (for (in key (. locals keys))
    (let group (!! ([] (. locals groups) key)))
    (let shadowed ([] (. imported groups) key))
    (if (not shadowed)
      (continue)
    )
    (let conflict (call classify-name-conflict group shadowed))
    (if (== conflict .conflict-none)
      (continue)
    )
    (blank)
    (let local ([] group 0))
    (for (in symbol group)
      (if (or (< (. symbol line) (. local line)) (and (== (. symbol line) (. local line)) (< (. symbol column) (. local column))))
        (= local symbol)
      )
    )
    (let origins (call origin-list (call unique-conflict-origins shadowed)))
    (let message (str "Local " (. local kind) " \"" (. local name) "\" overlaps imported "))
    (+= message (str (call namespace-label (. local namespace)) " name from " origins "; "))
    (+= message (str (call conflict-description conflict) "."))
    (call (. context report) message (+ (. local line) 1) (+ (. local column) 1) (call conflict-status conflict))
  )
)

(fn-do + call-shapes-disjoint Bool
  (param a FunctionCallShape)
  (param b FunctionCallShape)
  (if (and (>= (. a maximum) (. b minimum)) (>= (. b maximum) (. a minimum)))
    (return false)
  )
  (for (in index (..< 0 (. a labels length)))
    (let label ([] (. a labels) index))
    (if (== (. label length) 0)
      (continue)
    )
    (for (in other (..< 0 (. b labels length)))
      (if (and (== ([] (. b labels) other) label) (!= other index))
        (return false)
      )
    )
  )
  (return true)
)

(fn-do + lint-type-param-shadows _
  (param analysis ModuleAnalysis)
  (param context RuleContext)
  (let groups (map String (list NameSymbol)))
  (for (in symbol (. analysis local-symbols))
    (call add-type-symbol groups symbol)
  )
  (for (in symbol (. analysis imported-symbols))
    (call add-type-symbol groups symbol)
  )
  (blank)
  (for (in param (. analysis type-params))
    (let shadowed ([] groups (. param name)))
    (if (not shadowed)
      (continue)
    )
    (blank)
    (let origins (call origin-list (call unique-conflict-origins shadowed)))
    (let message (str "Type parameter \"" (. param name) "\" shadows type name from " origins "."))
    (call (. context report) message (+ (. param line) 1) (+ (. param column) 1))
  )
)

(fn-do _ add-type-symbol _
  (param groups (map String (list NameSymbol)))
  (param symbol NameSymbol)
  (if (!= (. symbol namespace) "type")
    (return)
  )
  (blank)
  (let existing ([] groups (. symbol name)))
  (if existing
    (+= existing symbol)
    (else
      (let fresh (list NameSymbol))
      (+= fresh symbol)
      (= ([] groups (. symbol name)) fresh)
    )
  )
)

(fn-do + lint-unused-catch-optional _
  (param tree AST)
  (param context RuleContext)
  (for (in id (..< 1u32 (. tree nodes length)))
    (match? ([] (. tree nodes) id)
      (case (call .node-block block)
        (for (in position (..< 0 (. block body count)))
          (let statement ([] (. tree children) (+ (. block body start) position)))
          (if (not (is ([] (. tree nodes) statement) .node-catch-optional-expression))
            (continue)
          )
          (if (and (== (+ position 1) (. block body count)) (not (call is-imperative-body tree (as id SyntaxId))))
            (continue)
          )
          (let loc ([] (. tree nodes loc) statement))
          (let message "Use catch instead of catch? when the optional result is unused.")
          (call (. context report) message (+ (. loc begin line) 1) (+ (. loc begin column) 1))
        )
      )
    )
  )
)

(fn-do + is-imperative-body Bool
  (param tree AST)
  (param block SyntaxId)
  ; Whether a block is the body of an imperative function, whose last statement gives no result.
  (match? ([] (. tree nodes) (call (. tree holder-of) block))
    (case (call .node-function-syntax row)
      (return (and (== (. row body) block) (. row imperative)))
    )
  )
  (return false)
)

(fn-do + lint-optional-match _
  (param tree AST)
  (param context RuleContext)
  (for (in id (..< 1u32 (. tree nodes length)))
    (let status (call optional-match-status tree (as id SyntaxId)))
    (if (== (. status length) 0)
      (continue)
    )
    (let loc ([] (. tree nodes loc) id))
    (let message "Prefer `match?`: remove the terminal `?? null` default arm.")
    (if (!= status "actionable")
      (= message "Review this match for `match?`; removing the terminal `?? null` default may ")
      (+= message "change `Result`, `Error`, or null-only result semantics.")
    )
    (call (. context report) message (+ (. loc begin line) 1) (+ (. loc begin column) 1) status)
  )
)

(fn-do + optional-match-status String
  (param tree AST)
  (param id SyntaxId)
  ; How a match that could be `match?` is reported: actionable where every other arm proves a value,
  ; review where one may not, or none where its last arm is not a bare `?? null`.
  (match? ([] (. tree nodes) id)
    (case (call .node-match-expression row)
      (let pattern (call structure-pattern tree (. row body)))
      (if (or (. row is-optional) (== pattern 0) (not (call requires-subject tree pattern)))
        (return "")
      )
      (let choices (list SyntaxId))
      (call gather-choices tree pattern choices)
      (if (< (. choices length) 2)
        (return "")
      )
      (match? ([] (. tree nodes) ([] choices (- (. choices length) 1)))
        (case (call .node-type-transform fallback)
          (if (and (== (. fallback pattern) 0) (call is-null-only tree (. fallback expr)))
            (for (in position (..< 0 (- (. choices length) 1)))
              (if (not (call proves-value tree ([] choices position)))
                (return "review")
              )
            )
            (return "actionable")
          )
        )
      )
    )
  )
  (return "")
)

(fn-expr + structure-pattern SyntaxId
  (param tree AST)
  (param body SyntaxId)
  (match ([] (. tree nodes) body)
    (case (call .node-structure-match row)
      (. row pattern)
    )
    (default
      0
    )
  )
)

(fn-do + gather-choices _
  (param tree AST)
  (param pattern SyntaxId)
  (param choices (list SyntaxId))
  ; Adds the alternatives of a match pattern to `choices`, in the order written.
  (match? ([] (. tree nodes) pattern)
    (case (call .node-type-or row)
      (call gather-choices tree (. row left) choices)
      (call gather-choices tree (. row right) choices)
      (return)
    )
  )
  (+= choices pattern)
)

(fn-expr + requires-subject Bool
  (param tree AST)
  (param pattern SyntaxId)
  ; Whether a match pattern tests a subject, rather than only conditions or a bare fallback.
  (match ([] (. tree nodes) pattern)
    (case (call .node-type-or row)
      (or (call requires-subject tree (. row left)) (call requires-subject tree (. row right)))
    )
    (case (call .node-type-transform row)
      (and (!= (. row pattern) 0) (call requires-subject tree (. row pattern)))
    )
    (case (call .node-type-panic row)
      (call requires-subject tree (. row pattern))
    )
    (case (call .node-type-predicate row)
      (. row is-contextual)
    )
    (default
      true
    )
  )
)

(fn-expr + is-null-only Bool
  (param tree AST)
  (param body SyntaxId)
  (match ([] (. tree nodes) (call single-statement tree body))
    (case (call .node-identifier row)
      (== (. row name text) "null")
    )
    (default
      false
    )
  )
)

(fn-expr + proves-value Bool
  (param tree AST)
  (param choice SyntaxId)
  (match ([] (. tree nodes) choice)
    (case .node-type-panic
      true
    )
    (case (call .node-type-transform row)
      (call is-literal-value tree (call single-statement tree (. row expr)))
    )
    (default
      false
    )
  )
)

(fn-expr + is-literal-value Bool
  (param tree AST)
  (param id SyntaxId)
  (match ([] (. tree nodes) id)
    (case (call .node-integer-syntax row)
      (not (. row unit))
    )
    (case (call .node-float-syntax row)
      (not (. row unit))
    )
    (case .node-string-syntax
      true
    )
    (case .node-symbol
      true
    )
    (case (call .node-identifier row)
      (or (== (. row name text) "true") (== (. row name text) "false"))
    )
    (case .node-tuple-syntax
      true
    )
    (case .node-list-syntax
      true
    )
    (default
      false
    )
  )
)

(fn-do + lint-nested-match-assertions _
  (param source LintSource)
  (param tree AST)
  (param context RuleContext)
  (for (in id (..< 1u32 (. tree nodes length)))
    (let fallback (call assertion-fallback tree (as id SyntaxId)))
    (if (== fallback 0)
      (continue)
    )
    (let fix
      (scope (if-expr (. source is-brix) brix-fix (call lift-assertions-fix source tree fallback))
        (lazy brix-fix (call brix-lift-fix source tree fallback))
      )
    )
    (if (not fix)
      (continue)
    )
    (let loc ([] (. tree nodes loc) fallback))
    (let message "Lift fallback assertions to match-arm level.")
    (call (. context report) message (+ (. loc begin line) 1) (+ (. loc begin column) 1) "actionable" fix)
  )
)

(fn-do + assertion-fallback SyntaxId
  (param tree AST)
  (param id SyntaxId)
  ; The last arm of a match or table where it is a bare `??` whose body only raises, or none.
  (match? ([] (. tree nodes) id)
    (case (call .node-structure-match row)
      (if (== (. row pattern) 0)
        (return 0)
      )
      (let choices (list SyntaxId))
      (call gather-choices tree (. row pattern) choices)
      (if (< (. choices length) 2)
        (return 0)
      )
      (let fallback ([] choices (- (. choices length) 1)))
      (match? ([] (. tree nodes) fallback)
        (case (call .node-type-transform transform)
          (if (and (== (. transform pattern) 0) (call is-assertion-block tree (. transform expr)))
            (return fallback)
          )
        )
      )
    )
  )
  (return 0)
)

(fn-do + is-assertion-block Bool
  (param tree AST)
  (param body SyntaxId)
  (match? ([] (. tree nodes) body)
    (case (call .node-block row)
      (if (== (. row body count) 0)
        (return false)
      )
      (for (in statement ([] (. tree children) (. row body)))
        (if (not (is ([] (. tree nodes) statement) .node-assertion-syntax))
          (return false)
        )
      )
      (return true)
    )
  )
  (return false)
)

(fn-do + lift-assertions-fix (? LintFix)
  (param source LintSource)
  (param tree AST)
  (param fallback SyntaxId)
  ; The edit that lifts the assertions of a bare `??` arm to the arm's own level, or none where its
  ; lines do not all share the indent removed.
  (let body
    (match ([] (. tree nodes) fallback)
      (case (call .node-type-transform row)
        (match ([] (. tree nodes) (. row expr))
          (case (call .node-block block)
            (. block body)
          )
          (throw (call Panic "Expected a block of assertions"))
        )
      )
      (throw (call Panic "Expected a match arm"))
    )
  )
  (let arm (. ([] (. tree nodes loc) fallback) begin))
  (let first (. ([] (. tree nodes loc) ([] (. tree children) (. body start))) begin))
  (let last (. ([] (. tree nodes loc) ([] (. tree children) (- (+ (. body start) (. body count)) 1))) end))
  (let offset (call (. source offset-of) (. arm line) (. arm column)))
  (let start ([] (. source line-starts) (. arm line)))
  (let end (call (. source offset-of) (. last line) (+ (. last column) 1)))
  (if (or (<= end offset) (!= (call (. source slice) offset (+ offset 2)) "??"))
    (return null)
  )
  (blank)
  (let expected (call (. source slice) start end))
  (let newline (call (. expected find) "\n"))
  (let width (if-expr (> (. first column) (. arm column)) (- (. first column) (. arm column)) 0u32))
  (if (or (not newline) (== width 0))
    (return null)
  )
  (blank)
  (let lines (list String) (call (. ([] expected (..< (+ newline 1) (. expected length))) split) "\n"))
  (let lifted (list String))
  (for (in line lines)
    (if (and (!= (. (call (. line trim)) length) 0) (not (call has-leading-space line width)))
      (return null)
    )
    (+= lifted (if-expr (> (. line length) width) ([] line (..< width (. line length))) ""))
  )
  (let edit
    (call LintTextEdit utf16-start utf16-end (call (. "\n" join) lifted) expected
      (block
        (lazy utf16-start (call (. source utf16-offset) (. arm line) 0))
        (lazy utf16-end (call (. source utf16-offset) (. last line) (+ (. last column) 1)))
      )
    )
  )
  (return (call LintFix "safe" "Lift match fallback assertions" (list edit)))
)

(fn-do + has-leading-space Bool
  (param line String)
  (param width U32)
  (if (< (. line length) width)
    (return false)
  )
  (for (in position (..< 0 width))
    (if (and (!= ([] line position) (char " ")) (!= ([] line position) (char "\t")))
      (return false)
    )
  )
  (return true)
)

(fn-do + lint-map-literal _
  (param source LintSource)
  (param tree AST)
  (param context RuleContext)
  (let attached (call attached-nodes tree))
  (for (in id (..< 1u32 (. tree nodes length)))
    (if (not ([] attached id))
      (continue)
    )
    (match? ([] (. tree nodes) id)
      (case (call .node-block block)
        (call lint-initial-map-entries source tree (. block body) context)
      )
      (case (call .node-call-expression call)
        (if (and (!= (. call args count) 0) is-map-constructor (call map-pairs tree (. call args)))
          (let loc (. ([] (. tree nodes loc) id) begin))
          (let message "Construct populated maps with map literal syntax.")
          (let fix
            (scope (if-expr (. source is-brix) brix-fix text-fix)
              (lazy brix-fix (call brix-map-constructor-fix source tree (as id SyntaxId)))
              (lazy text-fix (call map-constructor-fix source tree (as id SyntaxId) call))
            )
          )
          (call (. context report) message (+ (. loc line) 1) (+ (. loc column) 1) "actionable" fix)
        )
        (lazy is-map-constructor (call is-map-call source tree (as id SyntaxId) call))
      )
    )
  )
)

(fn-expr + is-map-call Bool
  (param source LintSource)
  (param tree AST)
  (param id SyntaxId)
  (param call ASTCallExpression)
  ; Whether a call constructs a map, with its arguments in parentheses after the type.
  (case? (not (call is-map-type tree (. call callable)))
    false
  )
  (case? (. source is-brix)
    (not (call brix-is-map-literal source tree id))
  )
  (default
    (== (call (. source slice) end (+ end 1)) "(")
  )
  (where
    (lazy end (call node-end source tree (. call callable)))
  )
)

(fn-expr + is-map-type Bool
  (param tree AST)
  (param id SyntaxId)
  (match ([] (. tree nodes) id)
    (case (call .node-type-identifier row)
      (== (. row name text) "Map")
    )
    (case (call .node-type-arguments row)
      (and (>= (. row args count) 2) (call is-map-type tree (. row base)))
    )
    (default
      false
    )
  )
)

(fn-do + map-pairs Bool
  (param tree AST)
  (param args (of RowRange SyntaxId))
  ; Whether every argument of a call is an unnamed pair.
  (for (in id ([] (. tree children) args))
    (if (not (call map-pair tree id))
      (return false)
    )
  )
  (return true)
)

(fn-expr + map-pair Bool
  (param tree AST)
  (param id SyntaxId)
  (match ([] (. tree nodes) id)
    (case (call .node-argument arg)
      (and (not (. arg name)) (not (. arg is-optional)) (call is-pair tree (. arg expr)))
    )
    (default
      false
    )
  )
)

(fn-expr + is-pair Bool
  (param tree AST)
  (param id SyntaxId)
  (match ([] (. tree nodes) id)
    (case (call .node-tuple-syntax row)
      (== (. row items count) 2)
    )
    (default
      false
    )
  )
)

(fn-do + pair-item SyntaxId
  (param tree AST)
  (param argument SyntaxId)
  (param position U32)
  ; An item of the pair an argument writes.
  (match ([] (. tree nodes) argument)
    (case (call .node-argument arg)
      (match ([] (. tree nodes) (. arg expr))
        (case (call .node-tuple-syntax row)
          (return ([] (. tree children) (+ (. row items start) position)))
        )
        (throw (call Panic "Expected a pair"))
      )
    )
    (throw (call Panic "Expected an argument"))
  )
)

(fn-do + lint-initial-map-entries _
  (param source LintSource)
  (param tree AST)
  (param body (of RowRange SyntaxId))
  (param context RuleContext)
  ; Reports each empty map a block declares and then fills by its first statements.
  (for (in index (..< 0 (. body count)))
    (let declaration ([] (. tree children) (+ (. body start) index)))
    (let name (call declared-local tree declaration))
    (let call (call empty-map-call source tree declaration))
    (if (or (== (. name length) 0) (== call 0))
      (continue)
    )
    (blank)
    (let statements (list SyntaxId))
    (for (in next (..< (+ index 1) (. body count)))
      (let statement ([] (. tree children) (+ (. body start) next)))
      (if (not (call is-map-entry tree statement name))
        (break)
      )
      (+= statements statement)
    )
    (if (== (. statements length) 0)
      (continue)
    )
    (blank)
    (let loc (. ([] (. tree nodes loc) call) begin))
    (let message "Construct initial map entries with a map literal.")
    (let fix
      (scope (if-expr (. source is-brix) brix-fix text-fix)
        (lazy brix-fix (call brix-initial-entries-fix source tree declaration statements))
        (lazy text-fix (call initial-entries-fix source tree declaration call statements))
      )
    )
    (call (. context report) message (+ (. loc line) 1) (+ (. loc column) 1) "actionable" fix)
  )
)

(fn-do + declared-local String
  (param tree AST)
  (param id SyntaxId)
  ; The name an eager declaration of one local gives, or none.
  (match? ([] (. tree nodes) id)
    (case (call .node-declare row)
      (if (. row is-lazy)
        (return "")
      )
      (match? ([] (. tree nodes) (. row left))
        (case (call .node-type-capture capture)
          (match? ([] (. tree nodes) (. capture id))
            (case (call .node-identifier name)
              (return (. name name text))
            )
          )
        )
      )
    )
  )
  (return "")
)

(fn-do + empty-map-call SyntaxId
  (param source LintSource)
  (param tree AST)
  (param id SyntaxId)
  ; The call that constructs an empty map as a declaration's value, or none.
  (match? ([] (. tree nodes) id)
    (case (call .node-declare row)
      (match? ([] (. tree nodes) (. row right))
        (case (call .node-call-expression call)
          (if (and (== (. call args count) 0) (call is-map-call source tree (. row right) call))
            (return (. row right))
          )
        )
      )
    )
  )
  (return 0)
)

(fn-do + is-map-entry Bool
  (param tree AST)
  (param id SyntaxId)
  (param name String)
  ; Whether a statement sets one entry of the map `name`, from keys and values that do not read it.
  (match? ([] (. tree nodes) id)
    (case (call .node-assign row)
      (if (!= (. row op) .eq-op)
        (return false)
      )
      (match? ([] (. tree nodes) (. row lhs))
        (case (call .node-index-expression index)
          (if (or (. index is-optional) (not (call is-named tree (. index object) name)))
            (return false)
          )
          (return (and (not (call references-name tree (. index index) name)) (not (call references-name tree (. row rhs) name))))
        )
      )
    )
  )
  (return false)
)

(fn-do + references-name Bool
  (param tree AST)
  (param id SyntaxId)
  (param name String)
  (if (call is-named tree id name)
    (return true)
  )
  (for (in child (call (. tree children-of) id))
    (if (call references-name tree child name)
      (return true)
    )
  )
  (return false)
)

(fn-do + map-entry-key SyntaxId
  (param tree AST)
  (param id SyntaxId)
  (match ([] (. tree nodes) id)
    (case (call .node-assign row)
      (match ([] (. tree nodes) (. row lhs))
        (case (call .node-index-expression index)
          (return (. index index))
        )
        (throw (call Panic "Expected an index"))
      )
    )
    (throw (call Panic "Expected an assignment"))
  )
)

(fn-do + map-entry-value SyntaxId
  (param tree AST)
  (param id SyntaxId)
  (match ([] (. tree nodes) id)
    (case (call .node-assign row)
      (return (. row rhs))
    )
    (throw (call Panic "Expected an assignment"))
  )
)

(fn-do + initial-entries-fix (? LintFix)
  (param source LintSource)
  (param tree AST)
  (param declaration SyntaxId)
  (param call SyntaxId)
  (param statements (list SyntaxId))
  ; The edit that writes the entries a map is first given as a map literal, or none where they are
  ; not each one line at the declaration's indent.
  (let call-loc ([] (. tree nodes loc) call))
  (if (!= (. call-loc begin line) (. call-loc end line))
    (return null)
  )
  (let callable
    (match ([] (. tree nodes) call)
      (case (call .node-call-expression row)
        (. row callable)
      )
      (throw (call Panic "Expected a call"))
    )
  )
  (let type-text (call node-text source tree callable))
  (if (!= (call node-text source tree call) (str type-text "()"))
    (return null)
  )
  (blank)
  (let place (. ([] (. tree nodes loc) declaration) begin))
  (let line ([] (. source lines) (. place line)))
  (if (or (> (. place column) (. line length)) (not (call is-blank-text ([] line (..< 0 (. place column))))))
    (return null)
  )
  (let base ([] line (..< 0 (. place column))))
  (let line-break (call entries-line-break source tree call statements base))
  (if (not line-break)
    (return null)
  )
  (blank)
  (let keys (list SyntaxId))
  (let values (list SyntaxId))
  (for (in statement statements)
    (+= keys (call map-entry-key tree statement))
    (+= values (call map-entry-value tree statement))
  )
  (let bullets (call map-pair-lines source tree keys values (str base "    ")))
  (if (not bullets)
    (return null)
  )
  (blank)
  (let start (call node-start source tree call))
  (let end (call node-end source tree ([] statements (- (. statements length) 1))))
  (let replacement (str type-text line-break (call (. line-break join) bullets)))
  (return (call LintFix "safe" "Use map literal syntax" (list (call text-edit source start end replacement))))
)

(fn-do + entries-line-break (? String)
  (param source LintSource)
  (param tree AST)
  (param call SyntaxId)
  (param statements (list SyntaxId))
  (param indent String)
  ; The line break between a map's declaration and each entry it is given, where each entry is one
  ; line at `indent` right after the last.
  (let previous call)
  (let found "")
  (for (in statement statements)
    (let loc ([] (. tree nodes loc) statement))
    (if (or (!= (. loc begin line) (. loc end line)) (!= (. loc begin column) (. indent length)))
      (return null)
    )
    (let gap (call (. source slice) (call node-end source tree previous) (call node-start source tree statement)))
    (let line-break (if-expr (call (. gap starts-with) "\r\n") "\r\n" "\n"))
    (if (or (!= gap (str line-break indent)) (and (!= (. found length) 0) (!= found line-break)))
      (return null)
    )
    (= found line-break)
    (= previous statement)
  )
  (return (only-if found (if (!= (. found length) 0))))
)

(fn-do + map-pair-lines (? (list String))
  (param source LintSource)
  (param tree AST)
  (param keys (list SyntaxId))
  (param values (list SyntaxId))
  (param indent String)
  ; The bullets of a map literal that write each key with its value, or none where one is not
  ; written on one line.
  (let lines (list String))
  (for (in position (..< 0 (. keys length)))
    (let key (call node-text source tree ([] keys position)))
    (let value (call node-text source tree ([] values position)))
    (if (or (== (. key length) 0) (== (. value length) 0) (call (. key find) "\n") (call (. value find) "\n"))
      (return null)
    )
    (let literal (if-expr (is ([] (. tree nodes) ([] keys position)) .node-string-syntax) key (str "(" key ")")))
    (+= lines (str indent "• " literal " " value))
  )
  (return lines)
)

(fn-do + map-constructor-fix (? LintFix)
  (param source LintSource)
  (param tree AST)
  (param id SyntaxId)
  (param call ASTCallExpression)
  ; The edit that writes the pairs a map is constructed from as a map literal, or none where each is
  ; not a bullet on a line of its own.
  (let args (list SyntaxId))
  (for (in arg ([] (. tree children) (. call args)))
    (+= args arg)
  )
  (let start (call node-start source tree id))
  (let type-end (call node-end source tree (. call callable)))
  (let end (call node-end source tree ([] args (- (. args length) 1))))
  (let gap (call (. source slice) type-end (call node-start source tree ([] args 0))))
  (if (not (call (. gap starts-with) "()"))
    (return null)
  )
  (let rest ([] gap (..< 2 (. gap length))))
  (let line-break (if-expr (call (. rest starts-with) "\r\n") "\r\n" "\n"))
  (if (not (call (. rest starts-with) line-break))
    (return null)
  )
  (let indent ([] rest (..< (. line-break length) (. rest length))))
  (if (not (call is-blank-text indent))
    (return null)
  )
  (blank)
  (for (in position (..< 0 (. args length)))
    (let loc ([] (. tree nodes loc) ([] args position)))
    (if (or (!= (. loc begin line) (. loc end line)) (not (call is-bullet-pair (call node-text source tree ([] args position)))))
      (return null)
    )
    (if (< (+ position 1) (. args length))
      (let ending (call node-end source tree ([] args position)))
      (let following (call node-start source tree ([] args (+ position 1))))
      (if (!= (call (. source slice) ending following) (str line-break indent))
        (return null)
      )
    )
  )
  (blank)
  (let keys (list SyntaxId))
  (let values (list SyntaxId))
  (for (in arg args)
    (+= keys (call pair-item tree arg 0))
    (+= values (call pair-item tree arg 1))
  )
  (let bullets (call map-pair-lines source tree keys values indent))
  (if (not bullets)
    (return null)
  )
  (blank)
  (let head (call (. source slice) start type-end))
  (let replacement (str head line-break (call (. line-break join) bullets)))
  (return (call LintFix "safe" "Use map literal syntax" (list (call text-edit source start end replacement))))
)

(fn-do + is-bullet-pair Bool
  (param text String)
  ; Whether an argument is written as a bullet of one parenthesized pair.
  (if (or (not (call (. text starts-with) "-")) (not (call (. text ends-with) ")")))
    (return false)
  )
  (let position 1)
  (while (and (< position (. text length)) (call is-space-char ([] text position)))
    (+= position 1)
  )
  (return (and (< (+ position 2) (. text length)) (== ([] text position) (char "("))))
)

(fn-do + is-blank-text Bool
  (param text String)
  (for (in char text)
    (if (and (!= char (char " ")) (!= char (char "\t")))
      (return false)
    )
  )
  (return true)
)

(type + HandlerUse
  ; What the body of a key handler does with its event: reads it other than to select by key,
  ; selects by key, and calls something other than to cancel it outside a condition.
  (blank)
  (prop + raw Bool)
  (prop + selector Bool)
  (prop + command Bool)
  (fn-do + This _)
)

(fn-do + lint-shortcut-node _
  (param tree AST)
  (param context RuleContext)
  (let attached (call attached-nodes tree))
  (for (in id (..< 1u32 (. tree nodes length)))
    (if (not ([] attached id))
      (continue)
    )
    (match? ([] (. tree nodes) id)
      (case (call .node-for-block row)
        (match? ([] (. tree nodes) (. row loop))
          (case (call .node-loop-syntax loop)
            (call report-shortcut-node tree row loop context)
          )
        )
      )
    )
  )
)

(fn-do _ report-shortcut-node _
  (param tree AST)
  (param handler ASTForBlock)
  (param loop ASTLoop)
  (param context RuleContext)
  (if (not (. loop is-subscriber))
    (return)
  )
  (let source-name
    (match ([] (. tree nodes) (. loop container))
      (case (call .node-identifier row)
        (. row name text)
      )
      (default
        ""
      )
    )
  )
  (if (and (!= source-name "key-press") (!= source-name "key-input"))
    (return)
  )
  (blank)
  (let purpose (call shortcut-purpose tree handler loop))
  (if (== purpose "raw")
    (return)
  )
  (let message (str "Review whether this " source-name " handler dispatches a command; "))
  (if (== purpose "command")
    (= message (str "Review " source-name " command dispatch as a <Shortcut> candidate; "))
  )
  (+= message "confirm a compatible <Shortcut> is available and preserve focus/modal eligibility, ")
  (+= message "cancellation, propagation, repeat/sequences, and handler order.")
  (let loc (. ([] (. tree nodes loc) (. handler loop)) begin))
  (call (. context report) message (+ (. loc line) 1) (+ (. loc column) 1) "review")
)

(fn-do + shortcut-purpose String
  (param tree AST)
  (param handler ASTForBlock)
  (param loop ASTLoop)
  ; Whether a key handler only reads raw input, dispatches a command by key, or neither is known.
  (let event (call declared-name tree (. loop pattern)))
  (if (or (== (. event length) 0) (== (. handler body) 0))
    (return "unknown")
  )
  (let use (call HandlerUse))
  (call gather-handler-use tree (. handler body) event false false false use)
  (if (or (. use raw) (call is-cancellation-only tree (. handler body) event))
    (return "raw")
  )
  (if (or (!= (. loop next) 0) (!= (. loop clause) 0) (!= (. handler next) 0))
    (return "unknown")
  )
  (return (if-expr (and (. use selector) (. use command)) "command" "unknown"))
)

(fn-do _ gather-handler-use _
  (param tree AST)
  (param id SyntaxId)
  (param event String)
  (param in-condition Bool)
  (param in-selector Bool)
  (param is-object Bool)
  (param use HandlerUse)
  ; Notes what a node of a handler's body does with its event, where `in-condition` says it is in
  ; an `if` condition, `in-selector` that it is in one or in a match subject, and `is-object` that it
  ; is the object a member is read from.
  (if (== id 0)
    (return)
  )
  (match? ([] (. tree nodes) id)
    (case (call .node-identifier row)
      (if (and (== (. row name text) event) (not is-object))
        (= (. use raw) true)
      )
    )
    (case (call .node-get-expression row)
      (if (call is-named tree (. row object) event)
        (let property (. row name text))
        (if (!= property "cancel")
          (if (and (!= property "key") (!= property "char") (!= property "modifier"))
            (= (. use raw) true)
            (else-if in-selector
              (= (. use selector) true)
            )
            (else
              (= (. use raw) true)
            )
          )
        )
      )
      (call gather-handler-use tree (. row object) event in-condition in-selector true use)
      (return)
    )
    (case .node-call-expression
      (if (and (not (call is-cancel tree id event)) (not in-condition))
        (= (. use command) true)
      )
    )
    (case (call .node-if-block row)
      (call gather-handler-use tree (. row condition) event true true false use)
      (call gather-handler-use tree (. row body) event in-condition in-selector false use)
      (call gather-handler-use tree (. row next) event in-condition in-selector false use)
      (return)
    )
    (case (call .node-match-expression row)
      (for (in child (call (. tree children-of) id))
        (let selects (or in-selector (== child (. row subject))))
        (call gather-handler-use tree child event in-condition selects false use)
      )
      (return)
    )
  )
  (blank)
  (for (in child (call (. tree children-of) id))
    (call gather-handler-use tree child event in-condition in-selector false use)
  )
)

(fn-do + is-cancellation-only Bool
  (param tree AST)
  (param id SyntaxId)
  (param event String)
  ; Whether a node only cancels the event, under conditions that call nothing.
  (match? ([] (. tree nodes) id)
    (case (call .node-block row)
      (if (== (. row body count) 0)
        (return false)
      )
      (for (in statement ([] (. tree children) (. row body)))
        (if (not (call is-cancellation-only tree statement event))
          (return false)
        )
      )
      (return true)
    )
    (case (call .node-if-block row)
      (if (or (call calls-anything tree (. row condition)) (not (call is-cancellation-only tree (. row body) event)))
        (return false)
      )
      (return (or (== (. row next) 0) (call is-cancellation-only tree (. row next) event)))
    )
  )
  (return (call is-cancel tree id event))
)

(fn-do + calls-anything Bool
  (param tree AST)
  (param id SyntaxId)
  (if (== id 0)
    (return false)
  )
  (if (is ([] (. tree nodes) id) .node-call-expression)
    (return true)
  )
  (for (in child (call (. tree children-of) id))
    (if (call calls-anything tree child)
      (return true)
    )
  )
  (return false)
)

(fn-do + is-cancel Bool
  (param tree AST)
  (param id SyntaxId)
  (param event String)
  ; Whether a node calls `cancel` on the event with no arguments.
  (match? ([] (. tree nodes) id)
    (case (call .node-call-expression call)
      (if (!= (. call operands count) 0)
        (return false)
      )
      (match? ([] (. tree nodes) (. call callable))
        (case (call .node-get-expression row)
          (return (and (== (. row name text) "cancel") (call is-named tree (. row object) event)))
        )
      )
    )
  )
  (return false)
)

(type + ShorthandScope
  ; The types an assignment in a style context can reach: those the linted module declares, and
  ; those its imports make visible, found by name from the module that names them.
  (blank)
  (prop + analysis ModuleAnalysis)
  (prop + locals (list StyleClass))
  (prop _ classes (map String (list StyleClass)))
  (fn-do + This _
    (param analysis ModuleAnalysis)
    (lazy locals (call collect-style-classes (. analysis tree) "" false))
  )
  (fn-do + local-class StyleClass
    (param id SyntaxId)
    ; The linted module's own type declared at `id`.
    (let key (str "#" id))
    (for (in found locals)
      (if (== (. found key) key)
        (return found)
      )
    )
    (throw (call Panic "Expected a class block"))
  )
  (fn-do + resolve (? StyleClass)
    (param name String)
    (param module-path String)
    ; The one type `name` names from a module, or none where it names none or several.
    (if (== (. name length) 0)
      (return null)
    )
    (if (== (. module-path length) 0)
      (let named (list StyleClass))
      (for (in found locals)
        (if (call (. found names) name)
          (+= named found)
        )
      )
      (if (!= (. named length) 0)
        (return (only-if ([] named 0) (if (== (. named length) 1))))
      )
    )
    (blank)
    (let key (str module-path "\n" name))
    (if (not ([] classes key))
      (= ([] classes key) (call visible-classes name module-path))
    )
    (let matches (!! ([] classes key)))
    (return (only-if ([] matches 0) (if (== (. matches length) 1))))
  )
  (fn-do _ visible-classes (list StyleClass)
    (param name String)
    (param module-path String)
    ; The types `name` names from a module: its own, then the public ones its imports export.
    (let found (list StyleClass))
    (let seen (map String Bool))
    (let visited (map String Bool))
    (= ([] visited module-path) true)
    (let analyzer (!! (. analysis analyzer)))
    (let imports (. analysis imports))
    (let origin (. analysis source path))
    (if (!= (. module-path length) 0)
      (let module (call (. analyzer module-at) module-path))
      (if (not module)
        (return found)
      )
      (for (in type (. module classes))
        (if (and (call (. type names) name) (not ([] seen (. type key))))
          (= ([] seen (. type key)) true)
          (+= found type)
        )
      )
      (= imports (. module imports))
      (= origin module-path)
    )
    (for (in entry imports)
      (let imported (call (. analyzer imported-module) entry origin))
      (if imported
        (call gather-exported imported name visited seen found)
      )
    )
    (return found)
  )
  (fn-do _ gather-exported _
    (param module ExportedModule)
    (param name String)
    (param visited (map String Bool))
    (param seen (map String Bool))
    (param found (list StyleClass))
    (if ([] visited (. module path))
      (return)
    )
    (= ([] visited (. module path)) true)
    (for (in type (. module classes))
      (if (and (. type is-public) (call (. type names) name) (not ([] seen (. type key))))
        (= ([] seen (. type key)) true)
        (+= found type)
      )
    )
    (for (in entry (. module exports))
      (let exported (call (. (!! (. analysis analyzer)) imported-module) entry (. module path)))
      (if exported
        (call gather-exported exported name visited seen found)
      )
    )
  )
  (fn-do + expand (list StyleClass)
    (param roots (list StyleClass))
    ; The types `roots` reach through the types each uses or implements.
    (let seen (map String Bool))
    (let result (list StyleClass))
    (let pending (list StyleClass))
    (for (in root roots)
      (+= pending root)
    )
    (while (!= (. pending length) 0)
      (let owner (call (. pending pop)))
      (if ([] seen (. owner key))
        (continue)
      )
      (= ([] seen (. owner key)) true)
      (+= result owner)
      (for (in reference (. owner references))
        (let found (call resolve reference (. owner module-path)))
        (if (and found (not ([] seen (. found key))))
          (+= pending found)
        )
      )
    )
    (return result)
  )
  (fn-do + owners-at (list StyleClass)
    (param stack (list SyntaxId))
    ; The types whose style an assignment sets, from the markups and types around it, innermost first;
    ; none outside a style rule or markup, or inside a function before one.
    (let tree (. analysis tree))
    (let owners (list StyleClass))
    (let in-context false)
    (for (in step (..< 0 (. stack length)))
      (let id ([] stack (- (. stack length) 1 step)))
      (match? ([] (. tree nodes) id)
        (case .node-function-syntax
          (if (not in-context)
            (return (call (of List StyleClass)))
          )
        )
        (case (call .node-markup row)
          (let owner (call resolve (call plain-type-name tree (. row type-id)) ""))
          (if (not owner)
            (return (call (of List StyleClass)))
          )
          (+= owners owner)
          (= in-context true)
        )
        (case .node-slot-outlet
          (return (call (of List StyleClass)))
        )
        (case .node-style-sheet-extension
          (return (call (of List StyleClass)))
        )
        (case .node-rule-syntax
          (= in-context true)
        )
        (case .node-class-block
          (if (not in-context)
            (return (call (of List StyleClass)))
          )
          (+= owners (call local-class id))
        )
      )
    )
    (if (not in-context)
      (return (call (of List StyleClass)))
    )
    (return owners)
  )
)

(fn-expr + property-styles (list StyleClass)
  (param owners (list StyleClass))
  (param property String)
  (in each owners (when (and (. each is-style) ([] (. each properties) property))))
)

(type + StyleShorthand (is Tuple)
  (prop + owner StyleClass)
  (prop + rule String)
)

(fn-do + lint-shorthands _
  (param analysis ModuleAnalysis)
  (param context RuleContext)
  (let scope (call ShorthandScope analysis))
  (let attached (call attached-nodes (. analysis tree)))
  (let stack (list SyntaxId))
  (call walk-shorthands scope (. analysis tree root) stack context)
)

(fn-do _ walk-shorthands _
  (param scope ShorthandScope)
  (param id SyntaxId)
  (param stack (list SyntaxId))
  (param context RuleContext)
  (let tree (. scope analysis tree))
  (match? ([] (. tree nodes) id)
    (case (call .node-assign row)
      (if (and (!= (. (call identifier-name tree (. row lhs)) length) 0) (not (call is-tracked-tree tree id)))
        (call report-shorthand scope row stack context)
      )
    )
  )
  (+= stack id)
  (for (in child (call (. tree children-of) id))
    (call walk-shorthands scope child stack context)
  )
  (call (. stack pop))
)

(fn-do + is-tracked-tree Bool
  (param tree AST)
  (param id SyntaxId)
  (match? ([] (. tree nodes) id)
    (case (call .node-identifier row)
      (if (. row is-tracked)
        (return true)
      )
    )
    (case (call .node-get-expression row)
      (if (. row is-tracked)
        (return true)
      )
    )
  )
  (for (in child (call (. tree children-of) id))
    (if (call is-tracked-tree tree child)
      (return true)
    )
  )
  (return false)
)

(fn-do _ report-shorthand _
  (param scope ShorthandScope)
  (param assignment ASTAssign)
  (param stack (list SyntaxId))
  (param context RuleContext)
  ; Reports the shortest style shorthand that forwards to the property an assignment sets, where
  ; one style the site sees declares the property and the shorthand's own type sees the same one.
  (let owners (call (. scope owners-at) stack))
  (if (== (. owners length) 0)
    (return)
  )
  (let tree (. scope analysis tree))
  (let property (call identifier-name tree (. assignment lhs)))
  (let visible (call (. scope expand) owners))
  (let site-styles (call property-styles visible property))
  (if (!= (. site-styles length) 1)
    (return)
  )
  (for (in owner visible)
    (if (and (not (. owner is-style)) ([] (. owner properties) property))
      (return)
    )
  )
  (blank)
  (let counts (map String Int))
  (for (in owner visible)
    (for (in rule (. owner rules))
      (= ([] counts rule) (+ (?? ([] counts rule) 0) 1))
    )
  )
  (blank)
  (let best (? StyleShorthand) null)
  (for (in owner visible)
    (for (in position (..< 0 (. owner rules length)))
      (let rule ([] (. owner rules) position))
      (if (or (!= ([] (. owner forwarded) position) property) (!= ([] counts rule) 1))
        (continue)
      )
      (if (call is-inside-rule tree stack rule)
        (continue)
      )
      (let styles (call property-styles (call (. scope expand) (list owner)) property))
      (if (or (!= (. styles length) 1) (!= (. ([] styles 0) key) (. ([] site-styles 0) key)))
        (continue)
      )
      (if (or (not best) (call is-shorter-name rule (. best rule)))
        (= best (call StyleShorthand owner rule))
      )
    )
  )
  (if (not best)
    (return)
  )
  (blank)
  (let found best)
  (let message (str "Review style shorthand \"" (. found rule) ":\" from " (. found owner name) " for \"" property "\"; "))
  (+= message "verify argument compatibility and style precedence before replacing the assignment.")
  (let loc (. ([] (. tree nodes loc) (. assignment lhs)) begin))
  (call (. context report) message (+ (. loc line) 1) (+ (. loc column) 1) "review")
)

(fn-do + is-inside-rule Bool
  (param tree AST)
  (param stack (list SyntaxId))
  (param name String)
  ; Whether a site is inside the style rule `name` or inside a style rule with arguments.
  (for (in id stack)
    (match? ([] (. tree nodes) id)
      (case (call .node-rule-syntax row)
        (if (or (== (. row name text) name) (!= (. row args count) 0))
          (return true)
        )
      )
    )
  )
  (return false)
)

(fn-expr + is-shorter-name Bool
  (param name String)
  (param other String)
  (if-expr (!= (. name length) (. other length)) (< (. name length) (. other length)) (< name other))
)
