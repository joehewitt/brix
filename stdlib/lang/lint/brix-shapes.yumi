./brix-source
/code/structure/document
/core/table
/data/sexp
/data/source-sexp
/data/source-tree
/lang/brix/brix

━━━━━━━━━━━━━━━━━━━━
+ BrixRowShape is Tuple

+ id U32
+ line U32
+ column U32
+ shown String
+ columns Size
+ indent Size
+ is-text Bool

━━━━━━━━━━━━━━━━━━━━
+ do brix-row-shapes [BrixRowShape] ?! SexpError
    - text String

. language = BrixLanguage()
. store = use language.store
. document = source-document-read(language, text)
. marked = use SourceStore()
. marks = SexpMarks(marked.latest-id)
sexp-read(text, marked, marks)
. shapes [BrixRowShape]
. place = BrixCursor(byte-view(text))
for index in 0 .. < document.declarations.length
    for outline in document.rows-of(index)
        . row = language.render(outline)
        . node = store.node-at(row.node)
        if node && !store.is-comment(node)
            . start = marks.start(node.id)
            if start > 0
                place.advance(start)
            shapes += BrixRowShape
                - node.id
                - place.line + 1
                - place.column + 1
                - shown(store, node)
                - row.columns
                - row.indent
                - outline.mode == brix-mode-text
        document.discard()
= shapes

━━━━━━━━━━━━━━━━━━━━
_ shown String
    - store SourceStore
    - node ImmutableTableRow'SourceNode

if head != null then "($head …)" else "`${store.text(node)}`"

.. head = store.head(node)
