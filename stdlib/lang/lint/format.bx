(import ./source)
(import /data/json)
(import /lang/ast/ast)
(import /lang/ast/ast-children)
(import /lang/ast/ast-nodes)
(import /lang/ast/operator)
(import /lang/ast/row-range)
(import /stream/aggregate)
(import /stream/sort)
(blank)
(prop _ divider-length _ (= 20))
(prop _ type-divider _ (= "━━━━━━━━━━━━━━━━━━━━"))

(fn-do + line-format-candidates (list FormatCandidate)
  (param source LintSource)
  (param lengths (map Char Int))
  ; The replacements the formatter proposes for the lines of a source in one pass: its final line
  ; break and the shapes, places and neighbors of its dividers. Where there are any, the formatter
  ; proposes nothing else in that pass.
  (let formatter (call Formatter source lengths))
  (call (. formatter add-final-newline))
  (call (. formatter add-divider-shapes))
  (call (. formatter add-function-type-dividers))
  (call (. formatter add-meaningless-dividers))
  (call (. formatter add-divider-adjacency))
  (return (call outermost-candidates (. formatter candidates)))
)

(fn-do + order-format-candidates (list FormatCandidate)
  (param source LintSource)
  (param lengths (map Char Int))
  (param tree AST)
  (param index (? MethodOrderIndex))
  ; The moves of a parsed source's declarations into order, where `index` places the functions that
  ; implement an interface or override a base type.
  (let order (call Formatter source lengths))
  (call (. (call LayoutOrder order tree index) format-module))
  (return (call outermost-candidates (. order candidates)))
)

(fn-do + outermost-candidates (list FormatCandidate)
  (param candidates (list FormatCandidate))
  ; The candidates that no earlier or wider candidate overlaps, by where they start and then the
  ; widest first.
  (let sorted (list FormatCandidate))
  (for (in candidate candidates)
    (let position (. sorted length))
    (while (and (> position 0) (call is-placed-before candidate ([] sorted (- position 1))))
      (-= position 1)
    )
    (call (. sorted insert) candidate position)
  )
  (let kept (list FormatCandidate))
  (for (in candidate sorted)
    (let overlaps false)
    (for (in other kept)
      (if (and (< (. candidate start) (. other end)) (< (. other start) (. candidate end)))
        (= overlaps true)
        (break)
      )
    )
    (if (not overlaps)
      (+= kept candidate)
    )
  )
  (return kept)
)

(fn-expr + is-placed-before Bool
  (param candidate FormatCandidate)
  (param other FormatCandidate)
  (or (< (. candidate start) (. other start)) (and (== (. candidate start) (. other start)) (> (. candidate end) (. other end))))
)

(type + FormatLineKind (is Union)
  (variant format-blank)
  (variant format-divider)
  (variant format-declaration-header)
  (variant format-event-header)
  (variant format-markup-open)
  (variant format-comment)
  (variant format-body)
)

(type + FormatLine (is Tuple)
  ; A source line as the formatter sees it, and where it is a divider, the glyph it repeats, how
  ; many characters it has once trimmed, and whether it mixes glyphs.
  (prop + kind FormatLineKind)
  (prop + glyph Char (= (char " ")))
  (prop + length Size (= 0))
  (prop + is-mixed Bool)
)

(type + FormatCandidate (is Tuple)
  ; A replacement of the text between two character offsets.
  (prop + start Index)
  (prop + end Index)
  (prop + replacement String)
)

(type + SignatureScan (is Tuple)
  (prop + next-index Index)
  (prop + has-inline-expression Bool)
)

(fn-expr + format-line FormatLine
  (param line String)
  ; The kind of a line, which the reference decides from the line with JavaScript whitespace
  ; trimmed away.
  (case? (== (. trimmed length) 0)
    (call FormatLine .format-blank)
  )
  (case? divider
    divider
  )
  (case? (== ([] trimmed 0) '`')
    (call FormatLine .format-comment)
  )
  (case? (call is-header-prefix trimmed)
    (call FormatLine .format-declaration-header)
  )
  (case? (call is-event-header-start trimmed)
    (call FormatLine .format-event-header)
  )
  (case? (call is-markup-start trimmed)
    (call FormatLine .format-markup-open)
  )
  (default
    (call FormatLine .format-body)
  )
  (where
    (lazy trimmed (call js-trim line))
    (lazy divider (call divider-line trimmed))
  )
)

(fn-expr + format-kind FormatLineKind
  (param line String)
  (. (call format-line line) kind)
)

(fn-do + divider-line (? FormatLine)
  (param trimmed String)
  ; The divider a trimmed line forms: a run of the divider glyphs alone.
  (let glyph ([] trimmed 0))
  (let mixed false)
  (for (in char trimmed)
    (if (not (call is-divider-glyph char))
      (return null)
    )
    (if (!= char glyph)
      (= mixed true)
    )
  )
  (return (call FormatLine .format-divider glyph (. trimmed length) mixed))
)

(fn-expr + is-header-prefix Bool
  (param trimmed String)
  (case? (and (!= first '+') (!= first '_') (!= first '^') (!= first (char "•")))
    false
  )
  (default
    (and (> (. trimmed length) 1) (call is-js-space ([] trimmed 1)))
  )
  (where
    (lazy first ([] trimmed 0))
  )
)

(fn-expr + is-access-header Bool
  (param trimmed String)
  ; Whether a trimmed line opens with `+`, `_` or `^` and whitespace.
  (case? (or (< (. trimmed length) 2) (and (!= ([] trimmed 0) '+') (!= ([] trimmed 0) '_') (!= ([] trimmed 0) '^')))
    false
  )
  (default
    (call is-js-space ([] trimmed 1))
  )
)

(fn-expr + is-event-header-start Bool
  (param trimmed String)
  (case? (not (call (. trimmed starts-with) "for"))
    false
  )
  (case? (== index 3)
    false
  )
  (default
    (call has-word-at trimmed index "event")
  )
  (where
    (lazy index (call skip-spaces trimmed 3))
  )
)

(fn-do + is-markup-start Bool
  (param trimmed String)
  (if (!= ([] trimmed 0) '<')
    (return false)
  )
  (let index Index 1)
  (if (and (< index (. trimmed length)) (== ([] trimmed index) '/'))
    (+= index 1)
  )
  (return (and (< index (. trimmed length)) (call is-ascii-letter ([] trimmed index))))
)

(fn-do + js-trim String
  (param text String)
  ; Text without the whitespace that JavaScript trims from both ends.
  (let start Index 0)
  (let end (. text length))
  (while (and (< start end) (call is-js-space ([] text start)))
    (+= start 1)
  )
  (while (and (> end start) (call is-js-space ([] text (- end 1))))
    (-= end 1)
  )
  (if (and (== start 0) (== end (. text length)))
    (return text)
  )
  (return (if-expr (> end start) ([] text (..< start end)) ""))
)

(fn-expr + is-js-space Bool
  (param char Char)
  ; Whether JavaScript counts a character as whitespace.
  (case? (or (== code 32) (and (>= code 9) (<= code 13)))
    true
  )
  (case? (< code 160)
    false
  )
  (case? (or (== code 160) (== code 5760) (and (>= code 8192) (<= code 8202)))
    true
  )
  (default
    (or (== code 8232) (== code 8233) (== code 8239) (== code 8287) (== code 12288) (== code 65279))
  )
  (where
    (lazy code (as char U32))
  )
)

(fn-expr + is-line-terminator Bool
  (param char Char)
  (or (== char (char "\n")) (== char (char "\r")) (== (as char U32) 8232) (== (as char U32) 8233))
)

(fn-expr + is-ascii-letter Bool
  (param char Char)
  (or (and (>= char 'a') (<= char 'z')) (and (>= char 'A') (<= char 'Z')))
)

(fn-expr + is-word-char Bool
  (param char Char)
  (or (call is-ascii-letter char) (and (>= char '0') (<= char '9')) (== char '_'))
)

(fn-do + skip-spaces Index
  (param text String)
  (param start Index)
  (let index start)
  (while (and (< index (. text length)) (call is-js-space ([] text index)))
    (+= index 1)
  )
  (return index)
)

(fn-expr + has-word-at Bool
  (param text String)
  (param index Index)
  (param word String)
  ; Whether a word starts at a place in text and ends at a word boundary.
  (case? (> (+ index (. word length)) (. text length))
    false
  )
  (case? (!= ([] text (..< index (+ index (. word length)))) word)
    false
  )
  (default
    (or (== following (. text length)) (not (call is-word-char ([] text following))))
  )
  (where
    (lazy following (+ index (. word length)))
  )
)

(fn-expr + has-word-boundary-before Bool
  (param text String)
  (param index Index)
  (or (== index 0) (not (call is-word-char ([] text (- index 1)))))
)

(fn-expr + header-key-start (? Index)
  (param trimmed String)
  ; Where the text after an access mark and its whitespace starts, where the line opens with
  ; `+` or `_` and whitespace and then a non-space.
  (case? (not (call is-access-header trimmed))
    null
  )
  (case? (>= index (. trimmed length))
    null
  )
  (default
    index
  )
  (where
    (lazy index (call skip-spaces trimmed 1))
  )
)

(fn-expr + line-break-for String
  (param text String)
  (if-expr (!= (call (. text find) "\r\n") null) "\r\n" "\n")
)

(fn-expr + split-break-lines (list String)
  (param text String)
  ; Text split at each line break, where `\r\n` and `\n` both break.
  (in (call strip-carriage-return each) (call (. text split) "\n"))
)

(fn-do + trim-outer-blank-lines String
  (param text String)
  ; Text without the lines of spaces and tabs that open it, and without the line breaks and spaces
  ; and tabs that close it.
  (let start Index 0)
  (while true
    (let index start)
    (while (and (< index (. text length)) (or (== ([] text index) (char " ")) (== ([] text index) (char "\t"))))
      (+= index 1)
    )
    (if (== index (. text length))
      (= start index)
      (break)
    )
    (if (== ([] text index) (char "\n"))
      (= start (+ index 1))
      (else-if (and (== ([] text index) (char "\r")) (< (+ index 1) (. text length)) (== ([] text (+ index 1)) (char "\n")))
        (= start (+ index 2))
      )
      (else
        (break)
      )
    )
  )
  (blank)
  (let end (. text length))
  (let cut end)
  (while true
    (let index cut)
    (while (and (> index start) (or (== ([] text (- index 1)) (char " ")) (== ([] text (- index 1)) (char "\t"))))
      (-= index 1)
    )
    (if (and (> index start) (== ([] text (- index 1)) (char "\n")))
      (-= index 1)
      (if (and (> index start) (== ([] text (- index 1)) (char "\r")))
        (-= index 1)
      )
      (= cut index)
      (else
        (break)
      )
    )
  )
  (if (and (== start 0) (== cut (. text length)))
    (return text)
  )
  (return (if-expr (> cut start) ([] text (..< start cut)) ""))
)

(fn-expr + without-trailing-line-break String
  (param text String)
  (case? (call (. text ends-with) "\r\n")
    (if-expr (> (. text length) 2) ([] text (..< 0 (- (. text length) 2))) "")
  )
  (case? (call (. text ends-with) "\n")
    (if-expr (> (. text length) 1) ([] text (..< 0 (- (. text length) 1))) "")
  )
  (default
    text
  )
)

(fn-expr + ends-with-line-break Bool
  (param text String)
  (and (!= (. text length) 0) (== ([] text (- (. text length) 1)) (char "\n")))
)

(type + Formatter
  ; The formatting of one source, which proposes replacements in the reference's order.
  (prop + source LintSource)
  (prop + lengths (map Char Int))
  (prop + candidates (list FormatCandidate))
  (prop _ kinds (list FormatLine))
  (prop _ line-break String)
  (fn-do + This _
    (param source LintSource)
    (param lengths (map Char Int))
    (= line-break (call line-break-for (. source text)))
    (let text (call template-text-lines (. source lines)))
    (for (in index (..< 0 (. source lines length)))
      (let line ([] (. source lines) index))
      (let is-text (and ([] text index) (!= (. (call (. line trim)) length) 0)))
      (+= kinds (if-expr is-text (call FormatLine .format-body) (call format-line line)))
    )
  )
  (fn-expr + line-count Index :get
    (. source lines length)
  )
  (fn-expr + line-at FormatLine
    (param index Index)
    (if-expr (< index (. kinds length)) ([] kinds index) (call FormatLine .format-blank))
  )
  (fn-expr + kind-at FormatLineKind
    (param index Index)
    (. (call line-at index) kind)
  )
  (fn-expr + text-at String
    (param index Index)
    (if-expr (< index (. source lines length)) ([] (. source lines) index) "")
  )
  (fn-expr + is-divider-at Bool
    (param index Index)
    (param glyph Char)
    (and (== (. line kind) .format-divider) (== (. line glyph) glyph))
    (where
      (lazy line (call line-at index))
    )
  )
  (fn-expr + line-start Index
    (param index Index)
    (if-expr (< index (. source line-starts length)) ([] (. source line-starts) index) (. source text length))
  )
  (fn-expr + line-end-including-break Index
    (param index Index)
    (call line-start (+ index 1))
  )
  (fn-expr + line-end Index
    (param index Index)
    (+ (call line-start index) (. (call text-at index) length))
  )
  (fn-do + line-index-at-offset Index
    (param offset Index)
    (let starts (. source line-starts))
    (let low Index 0)
    (let high (- (. starts length) 1))
    (while (< low high)
      (let middle (+ low (/ (+ (- high low) 1) 2)))
      (if (<= ([] starts middle) offset)
        (= low middle)
        (else
          (= high (- middle 1))
        )
      )
    )
    (return low)
  )
  (fn-expr + line-index-for-number Index
    (param number U32)
    (case? (== number 0)
      0
    )
    (case? (> index last)
      last
    )
    (default
      index
    )
    (where
      (lazy last (- (. source line-starts length) 1))
      (lazy index (as (- number 1) Index))
    )
  )
  (fn-do + first-non-blank (? Index)
    (param start Index)
    (for (in index (..< start line-count))
      (if (!= (call kind-at index) .format-blank)
        (return index)
      )
    )
    (return null)
  )
  (fn-do + previous-non-blank (? Index)
    (param start Index)
    (param floor Index (= 0))
    ; The last line at or before `start` and no earlier than `floor` that is not blank.
    (let index (+ start 1))
    (while (> index floor)
      (-= index 1)
      (if (!= (call kind-at index) .format-blank)
        (return index)
      )
    )
    (return null)
  )
  (fn-do + add _
    (param start Index)
    (param end Index)
    (param replacement String)
    (+= candidates (call FormatCandidate start end replacement))
  )
  (fn-do + add-final-newline _
    (let text (. source text))
    (if (or (== (. text length) 0) (== ([] text (- (. text length) 1)) (char "\n")))
      (return)
    )
    (call add (. text length) (. text length) line-break)
  )
  (fn-do + add-divider-shapes _
    (for (in index (..< 0 line-count))
      (let replacement (call formatted-divider index))
      (if (and replacement (!= replacement (call text-at index)))
        (call add (call line-start index) (call line-end index) replacement)
      )
    )
  )
  (fn-expr + formatted-divider (? String)
    (param index Index)
    (case? (!= (. line kind) .format-divider)
      null
    )
    (case? (or (. line is-mixed) (!= (. line length) (as expected Size)))
      (* (str (. line glyph)) expected)
    )
    (default
      (call js-trim (call text-at index))
    )
    (where
      (lazy line (call line-at index))
      (lazy expected (?? ([] lengths (. line glyph)) 0))
    )
  )
  (fn-do + add-function-type-dividers _
    (let end-line Index line-count)
    (for (in line (..< 0 line-count))
      (if (== (call kind-at line) .format-divider)
        (= end-line line)
        (break)
      )
    )
    (blank)
    (let starts (list Index))
    (let ends (list Index))
    (let texts (list String))
    (let index Index 0)
    (while (< index end-line)
      (if (not (call is-function-type-header (call text-at index)))
        (+= index 1)
        (continue)
      )
      (let start (call attached-comment-start index 0))
      (let signature (call scan-signature (+ index 1)))
      (let end (. signature next-index))
      (+= starts start)
      (+= ends end)
      (+= texts (call trim-outer-blank-lines (call joined-lines start end "\n")))
      (= index (if-expr (> end index) end (+ index 1)))
    )
    (if (== (. starts length) 0)
      (return)
    )
    (blank)
    (let removed (list Bool))
    (for (in _ (..< 0 line-count))
      (+= removed false)
    )
    (for (in position (..< 0 (. starts length)))
      (for (in line (..< ([] starts position) ([] ends position)))
        (if (< line line-count)
          (= ([] removed line) true)
        )
      )
    )
    (let kept (list String))
    (for (in line (..< 0 end-line))
      (if (not ([] removed line))
        (+= kept (call text-at line))
      )
    )
    (let kept-text (call trim-outer-blank-lines (call (. "\n" join) kept)))
    (let pieces (list String))
    (for (in text texts)
      (+= pieces (str type-divider line-break line-break text))
    )
    (let function-text (call (. (str line-break line-break) join) pieces))
    (let parts (list String))
    (if (!= (. kept-text length) 0)
      (+= parts kept-text)
    )
    (if (!= (. function-text length) 0)
      (+= parts function-text)
    )
    (let body (call (. (str line-break line-break) join) parts))
    (let replacement (if-expr (!= (. body length) 0) (str body line-break line-break) ""))
    (let start (call line-start 0))
    (let end (if-expr (< end-line line-count) (call line-start end-line) (. source text length)))
    (if (!= replacement (call (. source slice) start end))
      (call add start end replacement)
    )
  )
  (fn-do + joined-lines String
    (param start Index)
    (param end Index)
    (param separator String)
    (let pieces (list String))
    (for (in line (..< start end))
      (if (< line line-count)
        (+= pieces (call text-at line))
      )
    )
    (return (call (. separator join) pieces))
  )
  (fn-do + attached-comment-start Index
    (param start Index)
    (param floor Index)
    (let line start)
    (while (and (> line floor) (== (call kind-at (- line 1)) .format-comment))
      (-= line 1)
    )
    (return line)
  )
  (fn-do + scan-signature SignatureScan
    (param start Index)
    (let index start)
    (let inline false)
    (while (< index line-count)
      (let line (call text-at index))
      (if inline
        (if (call is-expression-boundary index)
          (break)
        )
        (+= index 1)
        (continue)
      )
      (if (call is-inline-expression-start line)
        (= inline true)
        (+= index 1)
        (continue)
      )
      (if (not (call is-signature-continuation line))
        (break)
      )
      (+= index 1)
    )
    (return (call SignatureScan index inline))
  )
  (fn-expr + is-expression-boundary Bool
    (param index Index)
    (or (== kind .format-blank) (== kind .format-divider) (call is-header-kind kind))
    (where
      (lazy kind (call kind-at index))
    )
  )
  (fn-do + add-meaningless-dividers _
    (for (in index (..< 0 line-count))
      (if (not (call is-divider-at index (char "━")))
        (continue)
      )
      (blank)
      (let content (call first-non-blank (+ index 1)))
      (if (and content (call is-divider-at content (char "━")))
        (let start (call line-start index))
        (let end (call line-start content))
        (if (< start end)
          (call add start end "")
        )
        (continue)
      )
      (blank)
      (if (> index 0)
        (let previous (call previous-non-blank (- index 1)))
        (if (and previous (!= (call kind-at previous) .format-declaration-header))
          (continue)
        )
      )
      (blank)
      (if (and content (not (call is-orphan-divider-follower (call text-at content))))
        (continue)
      )
      (if (and content (call is-required-header-after-divider content))
        (continue)
      )
      (blank)
      (let start (call line-start index))
      (let end (if-expr content (call line-start content) (. source text length)))
      (if (< start end)
        (call add start end "")
      )
    )
  )
  (fn-do + add-divider-adjacency _
    (for (in index (..< 0 line-count))
      (if (and (not (call is-divider-at index (char "━"))) (not (call is-divider-at index (char "─"))))
        (continue)
      )
      (if (>= (+ index 1) line-count)
        (continue)
      )
      (blank)
      (if (== (call kind-at (+ index 1)) .format-blank)
        (let content (call first-non-blank (+ index 2)))
        (if (and content (call is-required-header-after-divider content))
          (let start (call line-start (+ index 1)))
          (let end (call line-start content))
          (if (< start end)
            (call add start end "")
          )
        )
        (continue)
      )
      (blank)
      (if (not (call is-required-header-after-divider (+ index 1)))
        (let offset (call line-start (+ index 1)))
        (call add offset offset line-break)
        (continue)
      )
      (blank)
      (let signature (call scan-signature (+ index 2)))
      (if (. signature has-inline-expression)
        (continue)
      )
      (let body-index (. signature next-index))
      (let body (call kind-at body-index))
      (if (or (== body .format-body) (== body .format-markup-open))
        (let offset (call line-start body-index))
        (call add offset offset line-break)
      )
    )
  )
  (fn-expr + is-required-header-after-divider Bool
    (param index Index)
    (or (call is-required-declaration-header index) (call is-required-event-header (call text-at index)))
  )
  (fn-do + is-required-declaration-header Bool
    (param index Index)
    (let trimmed (call js-trim (call text-at index)))
    (if (and (> (. trimmed length) 1) (== ([] trimmed 0) (char "•")) (call is-js-space ([] trimmed 1)))
      (return true)
    )
    (if (not (call is-access-header trimmed))
      (return false)
    )
    (if (== (call kind-at (+ index 1)) .format-declaration-header)
      (return false)
    )
    (blank)
    (let key (call skip-spaces trimmed 1))
    (for (in word (list "do" "get" "This" "this" "to" "from"))
      (if (call has-word-at trimmed key word)
        (return true)
      )
    )
    (for (in token (list "=>" "==" "!=" "<=" ">="))
      (if (!= (call (. trimmed find) token) null)
        (return true)
      )
    )
    (for (in token (list "+=" "-=" "*=" "/=" "%="))
      (if (and (<= (+ key 2) (. trimmed length)) (== ([] trimmed (..< key (+ key 2))) token))
        (return true)
      )
    )
    (if (call has-plain-assignment trimmed)
      (return (call has-declaration-body index))
    )
    (return (== (. (call unbracketed-equals trimmed) length) 0))
  )
  (fn-expr + has-declaration-body Bool
    (param index Index)
    (case? (. signature has-inline-expression)
      true
    )
    (case? (or (== separator .format-body) (== separator .format-markup-open))
      true
    )
    (case? (!= separator .format-blank)
      false
    )
    (case? (not body)
      false
    )
    (default
      (and (!= kind .format-divider) (!= kind .format-declaration-header))
    )
    (where
      (lazy signature (call scan-signature (+ index 1)))
      (lazy separator (call kind-at (. signature next-index)))
      (lazy body (call first-non-blank (+ (. signature next-index) 1)))
      (lazy kind (call kind-at body))
    )
  )
  (fn-do + is-function-type-header Bool
    (param line String)
    ; Whether a header declares a function type: `+ Name is (...) Result`.
    (let trimmed (call js-trim line))
    (let key (call header-key-start trimmed))
    (if (not key)
      (return false)
    )
    (let position (+ key 1))
    (while (< (+ position 1) (. trimmed length))
      (if (and (> position (+ key 1)) (call is-line-terminator ([] trimmed (- position 1))))
        (return false)
      )
      (if (and (== ([] trimmed position) 'i') (== ([] trimmed (+ position 1)) 's'))
        (if (call has-word-boundary-before trimmed position)
          (if (call is-function-type-tail trimmed (+ position 2))
            (return true)
          )
        )
      )
      (+= position 1)
    )
    (return false)
  )
  (fn-do + is-function-type-tail Bool
    (param text String)
    (param start Index)
    (let open (call skip-spaces text start))
    (if (or (== open start) (>= open (. text length)) (!= ([] text open) (char "(")))
      (return false)
    )
    (let close (+ open 1))
    (while (and (< close (. text length)) (!= ([] text close) (char ")")))
      (+= close 1)
    )
    (if (>= close (. text length))
      (return false)
    )
    (let result (call skip-spaces text (+ close 1)))
    (return (and (> result (+ close 1)) (< result (. text length))))
  )
  (fn-do + is-orphan-divider-follower Bool
    (param line String)
    ; Whether a line declares with `is` after its name, which a divider never needs to precede.
    (let trimmed (call js-trim line))
    (let key (call header-key-start trimmed))
    (if (not key)
      (return false)
    )
    (let position (+ key 1))
    (while (< (+ position 1) (. trimmed length))
      (if (and (> position (+ key 1)) (call is-line-terminator ([] trimmed (- position 1))))
        (return false)
      )
      (if (and (call has-word-boundary-before trimmed position) (call has-word-at trimmed position "is"))
        (return true)
      )
      (+= position 1)
    )
    (return false)
  )
)

(fn-do + is-inline-expression-start Bool
  (param line String)
  (let trimmed (call js-trim line))
  (for (in token (list "=" "=?" "<=?" "|?" "|=" "??"))
    (if (call (. trimmed starts-with) token)
      (if (or (== (. trimmed length) (. token length)) (call is-js-space ([] trimmed (. token length))))
        (return true)
      )
    )
  )
  (return false)
)

(fn-do + is-signature-continuation Bool
  (param line String)
  (let trimmed (call js-trim line))
  (if (and (!= (. trimmed length) 0) (or (== ([] trimmed 0) '|') (== ([] trimmed 0) '`')))
    (return true)
  )
  (if (or (== (. line length) 0) (not (call is-js-space ([] line 0))))
    (return false)
  )
  (if (and (!= (. trimmed length) 0) (== ([] trimmed 0) '-'))
    (return true)
  )
  (if (and (call (. trimmed starts-with) "...") (or (== (. trimmed length) 3) (call is-js-space ([] trimmed 3))))
    (return true)
  )
  (for (in word (call continuation-words))
    (if (call has-word-at trimmed 0 word)
      (return true)
    )
  )
  (return false)
)

(fn-expr + continuation-words (list String)
  (item "and")
  (item "at")
  (item "before")
  (item "by")
  (item "during")
  (item "every")
  (item "from")
  (item "into")
  (item "is")
  (item "of")
  (item "to")
  (item "toward")
  (item "until")
  (item "using")
  (item "with")
  (item "within")
  (item "where")
)

(fn-do + has-plain-assignment Bool
  (param line String)
  ; Whether a line has an `=` outside brackets that no operator character opens and that is not
  ; `==` or `=>`.
  (for (in index (call unbracketed-equals line))
    (if (and (> index 0) (call is-assignment-prefix ([] line (- index 1))))
      (continue)
    )
    (if (and (< (+ index 1) (. line length)) (or (== ([] line (+ index 1)) '=') (== ([] line (+ index 1)) '>')))
      (continue)
    )
    (return true)
  )
  (return false)
)

(fn-do + unbracketed-equals (list Index)
  (param line String)
  (let places (list Index))
  (let depth Size 0)
  (for (in index (..< 0 (. line length)))
    (let char ([] line index))
    (if (or (== char '[') (== char (char "(")))
      (+= depth 1)
      (else-if (and (or (== char ']') (== char (char ")"))) (> depth 0))
        (-= depth 1)
      )
      (else-if (and (== char '=') (== depth 0))
        (+= places index)
      )
    )
  )
  (return places)
)

(fn-do + is-assignment-prefix Bool
  (param char Char)
  (for (in prefix "!<>=+-*/%")
    (if (== char prefix)
      (return true)
    )
  )
  (return false)
)

(fn-do + is-required-event-header Bool
  (param line String)
  (let trimmed (call js-trim line))
  (for (in word (list "when" "whenever" "on"))
    (if (call has-word-at trimmed 0 word)
      (return true)
    )
  )
  (if (not (call has-word-at trimmed 0 "for"))
    (return false)
  )
  (let position Index 4)
  (while (< (+ position 1) (. trimmed length))
    (if (call is-line-terminator ([] trimmed (- position 1)))
      (return false)
    )
    (if (and (call has-word-boundary-before trimmed position) (call has-word-at trimmed position "on"))
      (return true)
    )
    (+= position 1)
  )
  (return false)
)

(fn-expr + is-section-comment-line Bool
  (param line String)
  (and (call (. trimmed starts-with) "``") (or (== (. trimmed length) 2) (call is-js-space ([] trimmed 2))))
  (where
    (lazy trimmed (call js-trim line))
  )
)

(type + OrderInfo (is Tuple)
  (prop + index Int)
  (prop + section Int)
)

(type + SequenceKind (is Union)
  (variant sequence-module)
  (variant sequence-type)
  (variant sequence-sheet)
  (variant sequence-sheet-rule-body)
  (variant sequence-rule-body)
)

(type + LineRange (is Tuple)
  (prop + start-line Index)
  (prop + end-line Index)
)

(type + ChunkAnchor
  ; A declaration, with the lines that lead into it, that the formatter moves as one piece.
  (prop + node SyntaxId)
  (prop + bucket String)
  (prop + original-index Int)
  (prop + sort-priority Int)
  (prop + requires-type-divider Bool)
  (prop + start-line Index)
  (prop + end-line Index)
  (fn-do + This _
    (param node SyntaxId)
    (param bucket String)
    (param original-index Int)
    (param sort-priority Int)
    (param requires-type-divider Bool)
    (param start-line Index)
    (param end-line Index)
  )
)

(type + Chunk (is Tuple)
  ; A declaration's text and where it goes: its bucket's place and section in the order, and
  ; whether the bucket is one of the member functions that interfaces and base types order.
  (prop + start Index)
  (prop + end Index)
  (prop + bucket String)
  (prop + original-index Int)
  (prop + sort-priority Int)
  (prop + requires-type-divider Bool)
  (prop + text String)
  (prop + order-index Int)
  (prop + section Int)
  (prop + is-member-function Bool)
)

(type + MethodOrderMetadata (is Tuple)
  (prop + priority Int)
)

(type + MethodOrderIndex
  ; The places of the public functions of a module's types that implement an interface or a base
  ; type, by the functions' syntax.
  (prop + metadata (map SyntaxId MethodOrderMetadata))
  (fn-do + This _)
)

(fn-do + order-spec (map String OrderInfo)
  (param sections (list (list String)))
  (let infos (map String OrderInfo))
  (let index 0)
  (let section 0)
  (for (in buckets sections)
    (for (in bucket buckets)
      (= ([] infos bucket) (call OrderInfo index section))
      (+= index 1)
    )
    (+= section 1)
  )
  (return infos)
)

(fn-expr + module-order-spec (map String OrderInfo)
  (call order-spec sections)
  (where
    (lazy sections (list (list String))
      (block
        (item (list "imports"))
        (item (list "public-globals" "public-lazy-globals"))
        (item (list "private-globals" "private-lazy-globals"))
        (item (list "public-state-machine-globals" "private-state-machine-globals"))
        (item (list "public-one-line-types" "private-one-line-types" "public-unit-declarations"))
        (item (list "module-main-body"))
        (item (call test-function-buckets))
        (item (call declaration-buckets))
      )
    )
  )
)

(fn-expr + test-function-buckets (list String)
  (item "public-test-render-functions")
  (item "private-test-render-functions")
  (item "public-test-case-functions")
  (item "private-test-case-functions")
  (item "test-public-functions")
)

(fn-expr + declaration-buckets (list String)
  (item "style-sheets")
  (item "style-sheet-extensions")
  (item "module-subscriptions")
  (item "public-types")
  (item "public-extensions")
  (item "public-functions")
  (item "private-types")
  (item "private-extensions")
  (item "private-functions")
)

(fn-expr + type-member-order-spec (map String OrderInfo)
  (call order-spec sections)
  (where
    (lazy sections (list (list String))
      (block
        (item (list "implements"))
        (item (list "using-declarations"))
        (item (list "enum-cases"))
        (item (list "public-style-properties" "private-style-properties"))
        (item (list "public-properties" "public-lazy-properties" "public-inline-getter-properties"))
        (item (list "private-properties" "private-lazy-properties" "private-inline-getter-properties"))
        (item (list "delegates-for-properties"))
        (item (list "dependencies"))
        (item (list "style-annotations"))
        (item (list "style-rules"))
        (item (list "public-state-machine-properties" "private-state-machine-properties"))
        (item (list "content-block"))
        (item (call construction-buckets))
        (item (call member-function-buckets))
      )
    )
  )
)

(fn-expr + construction-buckets (list String)
  (item "public-constructors")
  (item "private-constructors")
  (item "public-fromverters")
  (item "public-converters")
  (item "subscriptions")
  (item "when-rules")
  (item "whenever-rules")
)

(fn-expr + member-function-buckets (list String)
  (item "public-getters")
  (item "private-getters")
  (item "public-setters")
  (item "private-setters")
  (item "public-operators")
  (item "private-operators")
  (item "public-indexers")
  (item "private-indexers")
  (item "public-index-setters")
  (item "private-index-setters")
  (item "public-index-deleters")
  (item "private-index-deleters")
  (item "public-prefix-operators")
  (item "private-prefix-operators")
  (item "public-methods")
  (item "private-methods")
)

(fn-expr + style-sheet-member-order-spec (map String OrderInfo)
  (call order-spec sections)
  (where
    (lazy sections (list (list String))
      (block
        (item (list "using-declarations"))
        (item (list "public-slots" "private-slots"))
        (item (list "public-lazy-slots" "private-lazy-slots"))
        (item (list "style-rules"))
      )
    )
  )
)

(fn-expr + style-sheet-rule-body-order-spec (map String OrderInfo)
  (call order-spec sections)
  (where
    (lazy sections (list (list String))
      (block
        (item (list "style-declarations"))
        (item (list "style-when-blocks"))
        (item (list "nested-style-rules"))
      )
    )
  )
)

(fn-expr + style-rule-body-order-spec (map String OrderInfo)
  (call order-spec sections)
  (where
    (lazy sections (list (list String))
      (block
        (item (list "style-declarations"))
        (item (list "style-when-blocks"))
        (item (list "generated-content-slots"))
        (item (list "nested-style-rules"))
        (item (list "content-body"))
      )
    )
  )
)

(type + LayoutOrder
  ; The declaration order of one parsed source, which proposes moves of its declarations into the
  ; order of their kinds.
  (prop + lines Formatter)
  (prop + tree AST)
  (prop + index (? MethodOrderIndex))
  (prop _ module-order (map String OrderInfo))
  (prop _ type-order (map String OrderInfo))
  (prop _ sheet-order (map String OrderInfo))
  (prop _ sheet-rule-order (map String OrderInfo))
  (prop _ rule-order (map String OrderInfo))
  (prop _ primary-names (map String Bool))
  (fn-do + This _
    (param lines Formatter)
    (param tree AST)
    (param index (? MethodOrderIndex))
    (lazy module-order (call module-order-spec))
    (lazy type-order (call type-member-order-spec))
    (lazy sheet-order (call style-sheet-member-order-spec))
    (lazy sheet-rule-order (call style-sheet-rule-body-order-spec))
    (lazy rule-order (call style-rule-body-order-spec))
    (lazy primary-names (call primary-type-names (. lines source path)))
  )
  (fn-do + format-module _
    (match ([] (. tree nodes) (. tree root))
      (case (call .node-top-level-syntax root)
        (let body ([] (. tree children) (. root statements)))
        (call add-sequence body .sequence-module)
        (for (in id body)
          (match? ([] (. tree nodes) id)
            (case (call .node-class-block row)
              (if (. row is-style-sheet)
                (call visit-sheet ([] (. tree children) (. row members)))
                (else
                  (call visit-type ([] (. tree children) (. row members)))
                )
              )
            )
            (case (call .node-style-sheet-extension row)
              (call visit-sheet ([] (. tree children) (. row body)))
            )
            (case (call .node-extension row)
              (call visit-type ([] (. tree children) (. row body)))
            )
          )
        )
      )
      (throw (call Panic "AST root has the wrong syntax case"))
    )
  )
  (fn-do + visit-sheet _
    (param members (list SyntaxId))
    (call add-sequence members .sequence-sheet)
    (for (in id members)
      (match? ([] (. tree nodes) id)
        (case (call .node-rule-syntax row)
          (call visit-rule (. row body) true)
        )
      )
    )
  )
  (fn-do + visit-type _
    (param members (list SyntaxId))
    (call add-sequence members .sequence-type)
    (for (in id members)
      (match? ([] (. tree nodes) id)
        (case (call .node-rule-syntax row)
          (call visit-rule (. row body) false)
        )
      )
    )
  )
  (fn-do + visit-rule _
    (param body SyntaxId)
    (param in-sheet Bool)
    (if (== body 0)
      (return)
    )
    (match? ([] (. tree nodes) body)
      (case (call .node-block block)
        (let ids ([] (. tree children) (. block body)))
        (call add-sequence ids (call rule-body-kind in-sheet))
        (for (in id ids)
          (match? ([] (. tree nodes) id)
            (case (call .node-rule-syntax row)
              (call visit-rule (. row body) in-sheet)
            )
            (case (call .node-style-when row)
              (call visit-when (. row body) in-sheet)
            )
          )
        )
      )
    )
  )
  (fn-do + visit-when _
    (param body SyntaxId)
    (param in-sheet Bool)
    (if (== body 0)
      (return)
    )
    (match? ([] (. tree nodes) body)
      (case (call .node-block block)
        (let ids ([] (. tree children) (. block body)))
        (call add-sequence ids (call rule-body-kind in-sheet))
        (for (in id ids)
          (match? ([] (. tree nodes) id)
            (case (call .node-rule-syntax row)
              (call visit-rule (. row body) in-sheet)
            )
          )
        )
      )
    )
  )
  (fn-expr + rule-body-kind SequenceKind
    (param in-sheet Bool)
    (if-expr in-sheet (. SequenceKind sequence-sheet-rule-body) (. SequenceKind sequence-rule-body))
  )
  (fn-expr + order-of (map String OrderInfo)
    (param kind SequenceKind)
    (match kind
      (case= .sequence-module
        module-order
      )
      (case= .sequence-type
        type-order
      )
      (case= .sequence-sheet
        sheet-order
      )
      (case= .sequence-sheet-rule-body
        sheet-rule-order
      )
      (default
        rule-order
      )
    )
  )
  (fn-do + add-sequence _
    (param ids (list SyntaxId))
    (param kind SequenceKind)
    (if (== (. ids length) 0)
      (return)
    )
    (let order (call order-of kind))
    (let found (call build-line-chunks ids kind order))
    (if (not found)
      (return)
    )
    (let chunks found)
    (if (or (== (. chunks length) 0) (call has-overlapping-ranges chunks))
      (return)
    )
    (let index Index 0)
    (while (< index (. chunks length))
      (while (and (< index (. chunks length)) (not (call is-sortable ([] chunks index) order)))
        (+= index 1)
      )
      (let start index)
      (while (and (< index (. chunks length)) (call is-sortable ([] chunks index) order))
        (+= index 1)
      )
      (if (< start index)
        (call add-sortable-region chunks start index order)
      )
    )
  )
  (fn-expr + is-sortable Bool
    (param chunk Chunk)
    (param order (map String OrderInfo))
    (and (!= (. chunk bucket length) 0) (!= ([] order (. chunk bucket)) null))
  )
  (fn-do + has-overlapping-ranges Bool
    (param chunks (list Chunk))
    (for (in index (..< 1 (. chunks length)))
      (if (< (. ([] chunks index) start) (. ([] chunks (- index 1)) end))
        (return true)
      )
    )
    (return false)
  )
  (fn-do + build-line-chunks (? (list Chunk))
    (param ids (list SyntaxId))
    (param kind SequenceKind)
    (param order (map String OrderInfo))
    (let anchors (list ChunkAnchor))
    (let index Index 0)
    (while (< index (. ids length))
      (let id ([] ids index))
      (if (call is-skipped-member id)
        (+= index 1)
        (continue)
      )
      (if (and (== kind .sequence-type) (call is-delegates id))
        (let next (call delegated-anchor ids index anchors))
        (if (not next)
          (return null)
        )
        (= index next)
        (continue)
      )
      (blank)
      (let range (call node-line-range id))
      (if (not range)
        (return null)
      )
      (let attached (call attached-start-line (. range start-line) (call anchor-minimum-line anchors)))
      (let end (. range end-line))
      (if (< end attached)
        (return null)
      )
      (let bucket (call classify id attached end kind))
      (let anchor
        (call ChunkAnchor
          (block
            (arg id)
            (arg bucket)
            (arg (. anchors length))
            (arg (call sort-priority id bucket kind))
            (arg (call requires-type-divider id bucket))
            (arg (call anchor-start-line bucket attached end))
            (arg (call anchor-end-line id bucket attached end))
          )
        )
      )
      (if (not (call push-anchor anchors anchor))
        (return null)
      )
      (+= index 1)
    )
    (return (call chunks-for-anchors anchors order))
  )
  (fn-do + delegated-anchor (? Index)
    (param ids (list SyntaxId))
    (param start Index)
    (param anchors (list ChunkAnchor))
    ; Bundles a run of delegate declarations with the property after them, and gives the place after
    ; the property.
    (let index start)
    (while (and (< index (. ids length)) (call is-delegates ([] ids index)))
      (+= index 1)
    )
    (if (or (>= index (. ids length)) (not (call is-property ([] ids index))))
      (return null)
    )
    (let first (call node-line-range ([] ids start)))
    (let last (call node-line-range ([] ids index)))
    (if (or (not first) (not last) (> (. first start-line) (. last end-line)))
      (return null)
    )
    (let bucket "delegates-for-properties")
    (let property ([] ids index))
    (let anchor
      (call ChunkAnchor
        (block
          (arg property)
          (arg bucket)
          (arg (. anchors length))
          (arg (call sort-priority property bucket .sequence-type))
          (arg false)
          (arg (call attached-start-line (. first start-line) (call anchor-minimum-line anchors)))
          (arg (. last end-line))
        )
      )
    )
    (if (not (call push-anchor anchors anchor))
      (return null)
    )
    (return (+ index 1))
  )
  (fn-do + push-anchor Bool
    (param anchors (list ChunkAnchor))
    (param anchor ChunkAnchor)
    (if (!= (. anchors length) 0)
      (let previous ([] anchors (- (. anchors length) 1)))
      (let merges (and (== (. anchor bucket) (. previous bucket)) (call is-opaque-bucket (. anchor bucket))))
      (if (and (<= (. anchor start-line) (. previous start-line)) (not merges))
        (return false)
      )
      (if merges
        (if (> (. anchor end-line) (. previous end-line))
          (= (. previous end-line) (. anchor end-line))
        )
        (return true)
      )
    )
    (+= anchors anchor)
    (return true)
  )
  (fn-expr + anchor-minimum-line Index
    (param anchors (list ChunkAnchor))
    (if-expr (!= (. anchors length) 0) (+ (. ([] anchors (- (. anchors length) 1)) start-line) 1) 0)
  )
  (fn-do + chunks-for-anchors (? (list Chunk))
    (param anchors (list ChunkAnchor))
    (param order (map String OrderInfo))
    (let chunks (list Chunk))
    (for (in position (..< 0 (. anchors length)))
      (let anchor ([] anchors position))
      (let end-line (? Index) null)
      (if (< (+ position 1) (. anchors length))
        (let next ([] anchors (+ position 1)))
        (if (> (. next start-line) 0)
          (= end-line (call (. lines previous-non-blank) (- (. next start-line) 1)))
        )
        (else
          (= end-line (call (. lines previous-non-blank) (. anchor end-line)))
        )
      )
      (if (or (not end-line) (< end-line (. anchor start-line)))
        (return null)
      )
      (let start (call (. lines line-start) (. anchor start-line)))
      (let end (call (. lines line-end-including-break) end-line))
      (let text (call without-trailing-line-break (call (. lines source slice) start end)))
      (let shaped (call chunk-text (. anchor bucket) text))
      (let info (only-if ([] order (. anchor bucket)) (if (!= (. anchor bucket length) 0))))
      (let order-index (if-expr info (. info index) -1))
      (let section (if-expr info (. info section) -1))
      (let member (call is-member-function-bucket (. anchor bucket)))
      (+= chunks
        (call Chunk
          (block
            (arg start)
            (arg end)
            (arg (. anchor bucket))
            (arg (. anchor original-index))
            (arg (. anchor sort-priority))
            (arg (. anchor requires-type-divider))
            (arg shaped)
            (arg order-index)
            (arg section)
            (arg member)
          )
        )
      )
    )
    (return chunks)
  )
  (fn-expr + node-line-range (? LineRange)
    (param id SyntaxId)
    (case? (== (+ end 1) start)
      (call LineRange end end)
    )
    (case? (< end start)
      null
    )
    (default
      (call LineRange start end)
    )
    (where
      (lazy loc ([] (. tree nodes loc) id))
      (lazy start (call (. lines line-index-for-number) (+ (. loc begin line) 1)))
      (lazy end (call (. lines line-index-for-number) (call node-end-number id)))
    )
  )
  (fn-expr + node-end-number U32
    (param id SyntaxId)
    (case? (and (!= body 0) (> body-end end))
      body-end
    )
    (default
      end
    )
    (where
      (lazy end (+ (. ([] (. tree nodes loc) id) end line) 1))
      (lazy body (call body-of id))
      (lazy body-end (+ (call subtree-end body) 1))
    )
  )
  (fn-expr + body-of SyntaxId
    (param id SyntaxId)
    (match ([] (. tree nodes) id)
      (case (call .node-function-syntax row)
        (. row body)
      )
      (case (call .node-converter-syntax row)
        (. row body)
      )
      (case (call .node-fromverter-syntax row)
        (. row body)
      )
      (case (call .node-rule-syntax row)
        (. row body)
      )
      (case (call .node-style-when row)
        (. row body)
      )
      (case (call .node-when-rule-syntax row)
        (. row body)
      )
      (case (call .node-whenever-rule-syntax row)
        (. row body)
      )
      (case (call .node-content-block row)
        (. row body)
      )
      (case (call .node-markup row)
        (. row body)
      )
      (default
        0
      )
    )
  )
  (fn-do + subtree-end U32
    (param id SyntaxId)
    ; The last line that a node or anything under it reaches, leaving out the places the parser
    ; gives blocks.
    (let end 0u32)
    (let pending (list SyntaxId))
    (+= pending id)
    (while (!= (. pending length) 0)
      (let next (call (. pending pop)))
      (if (not (call is-block next))
        (let line (. ([] (. tree nodes loc) next) end line))
        (= end (if-expr (> line end) line end))
      )
      (for (in child (call (. tree children-of) next))
        (+= pending child)
      )
    )
    (return end)
  )
  (fn-do + attached-start-line Index
    (param start Index)
    (param floor Index)
    (let line start)
    (while (and (> line floor) (call is-attached-leading-line (- line 1)))
      (-= line 1)
    )
    (return (call attached-section-comment-start line floor))
  )
  (fn-expr + is-attached-leading-line Bool
    (param index Index)
    (or (== kind .format-comment) (== kind .format-divider) (== (call js-trim (call (. lines text-at) index)) "≤"))
    (where
      (lazy kind (call (. lines kind-at) index))
    )
  )
  (fn-do + attached-section-comment-start Index
    (param start Index)
    (param floor Index)
    (if (or (< start (+ floor 2)) (!= (call (. lines kind-at) start) .format-divider))
      (return start)
    )
    (if (or (!= (call (. lines kind-at) (- start 1)) .format-blank) (not (call is-section-comment-line (call (. lines text-at) (- start 2)))))
      (return start)
    )
    (let line (- start 2))
    (while (and (> line floor) (call is-section-comment-line (call (. lines text-at) (- line 1))))
      (-= line 1)
    )
    (return line)
  )
  (fn-expr + is-block Bool
    (param id SyntaxId)
    (match ([] (. tree nodes) id)
      (case .node-block
        true
      )
      (default
        false
      )
    )
  )
  (fn-expr + is-skipped-member Bool
    (param id SyntaxId)
    (match ([] (. tree nodes) id)
      (case .node-noop
        true
      )
      (case .node-implements-declaration
        true
      )
      (case .node-using-declaration
        true
      )
      (case .node-sees-declaration
        true
      )
      (default
        false
      )
    )
  )
  (fn-expr + is-delegates Bool
    (param id SyntaxId)
    (match ([] (. tree nodes) id)
      (case .node-delegate-declaration
        true
      )
      (default
        false
      )
    )
  )
  (fn-expr + is-property Bool
    (param id SyntaxId)
    (match ([] (. tree nodes) id)
      (case .node-property-syntax
        true
      )
      (default
        false
      )
    )
  )
  (fn-expr + is-type-class Bool
    (param id SyntaxId)
    (match ([] (. tree nodes) id)
      (case (call .node-class-block row)
        (not (. row is-style-sheet))
      )
      (default
        false
      )
    )
  )
  (fn-expr + is-function-type-class Bool
    (param id SyntaxId)
    (match ([] (. tree nodes) id)
      (case (call .node-class-block row)
        (and (not (. row is-style-sheet)) (call is-function-type (. row base)))
      )
      (default
        false
      )
    )
  )
  (fn-expr + is-function-type Bool
    (param id SyntaxId)
    (and (!= id 0) (call is-type-function-node id))
  )
  (fn-expr + is-type-function-node Bool
    (param id SyntaxId)
    (match ([] (. tree nodes) id)
      (case .node-type-function
        true
      )
      (default
        false
      )
    )
  )
  (fn-do + declaration-header-index (? Index)
    (param start Index)
    (param end Index)
    (for (in line (.. start end))
      (if (== (call (. lines kind-at) line) .format-declaration-header)
        (return line)
      )
    )
    (return null)
  )
  (fn-do + previous-attached-divider (? Index)
    (param start Index)
    (let index (+ start 1))
    (while (> index 0)
      (-= index 1)
      (let kind (call (. lines kind-at) index))
      (if (or (== kind .format-blank) (== kind .format-comment))
        (continue)
      )
      (return (only-if index (if (== kind .format-divider))))
    )
    (return null)
  )
  (fn-expr + anchor-start-line Index
    (param bucket String)
    (param attached Index)
    (param end Index)
    (case? (not (call is-one-line-type-bucket bucket))
      attached
    )
    (case? (or (not header) (== header 0))
      attached
    )
    (default
      (?? (call previous-attached-divider (- header 1)) attached)
    )
    (where
      (lazy header (call declaration-header-index attached end))
    )
  )
  (fn-expr + anchor-end-line Index
    (param id SyntaxId)
    (param bucket String)
    (param attached Index)
    (param end Index)
    (case? (or (not (call is-type-class id)) (not (call is-one-line-type-bucket bucket)))
      end
    )
    (default
      (?? (call declaration-header-index attached end) end)
    )
  )
  (fn-expr + requires-type-divider Bool
    (param id SyntaxId)
    (param bucket String)
    (and (or (== bucket "public-types") (== bucket "private-types")) (call is-function-type-class id))
  )
  (fn-do + sort-priority Int
    (param id SyntaxId)
    (param bucket String)
    (param kind SequenceKind)
    (if (== kind .sequence-module)
      (if (or (!= bucket "public-types") (not (call is-type-class id)))
        (return 0)
      )
      (return (if-expr ([] primary-names (call normalized-name (call class-name id))) -1 0))
    )
    (if (or (!= kind .sequence-type) (not index) (not (call is-semantic-callable id bucket)))
      (return 0)
    )
    (let found ([] (. index metadata) id))
    (return (if-expr found (. found priority) 0))
  )
  (fn-expr + is-semantic-callable Bool
    (param id SyntaxId)
    (param bucket String)
    (and (call is-semantic-callable-bucket bucket) (call is-callable-node id))
  )
  (fn-expr + is-callable-node Bool
    (param id SyntaxId)
    (match ([] (. tree nodes) id)
      (case .node-function-syntax
        true
      )
      (case .node-converter-syntax
        true
      )
      (case .node-fromverter-syntax
        true
      )
      (default
        false
      )
    )
  )
  (fn-expr + class-name String
    (param id SyntaxId)
    (match ([] (. tree nodes) id)
      (case (call .node-class-block row)
        (. row name text)
      )
      (default
        ""
      )
    )
  )
  (fn-do + classify String
    (param id SyntaxId)
    (param start Index)
    (param end Index)
    (param kind SequenceKind)
    ; The bucket of a declaration whose lines run from `start` to `end`, or nothing where the
    ; declaration has no place of its own in the order.
    (match kind
      (case= .sequence-module
        (return (call classify-module-member id start end))
      )
      (case= .sequence-type
        (return (call classify-type-member id start end))
      )
      (case= .sequence-sheet
        (return (call classify-sheet-member id))
      )
      (case= .sequence-sheet-rule-body
        (return (call classify-sheet-rule-body-member id))
      )
      (default
        (return (call classify-rule-body-member id))
      )
    )
  )
  (fn-do + classify-module-member String
    (param id SyntaxId)
    (param start Index)
    (param end Index)
    (match ([] (. tree nodes) id)
      (case .node-import-syntax
        (return "imports")
      )
      (case .node-unit-declaration
        (return "")
      )
      (case (call .node-property-syntax row)
        (if (and (!= (. row value) 0) (call is-state-machine (. row value)) (call follows-divider start))
          (return (str (call access-prefix (. row access)) "-functions"))
        )
        (return (call property-bucket row "globals"))
      )
      (case (call .node-class-block row)
        (if (. row is-style-sheet)
          (return "style-sheets")
        )
        (if (call is-one-line-unit-type start end)
          (return "")
        )
        (let one-line (call one-line-type-bucket row start end))
        (if (!= (. one-line length) 0)
          (return one-line)
        )
        (return (str (call access-prefix (. row access)) "-types"))
      )
      (case .node-style-sheet-extension
        (return "style-sheet-extensions")
      )
      (case .node-subscriber-syntax
        (return "module-subscriptions")
      )
      (case (call .node-extension row)
        (return (str (call access-prefix (. row access)) "-extensions"))
      )
      (case (call .node-function-syntax row)
        (return (call module-function-bucket (. row access) (. row return-type)))
      )
      (case .node-converter-syntax
        (return "")
      )
      (case .node-fromverter-syntax
        (return "")
      )
      (case .node-when-rule-syntax
        (return "")
      )
      (case .node-whenever-rule-syntax
        (return "")
      )
      (default
        (return "module-main-body")
      )
    )
  )
  (fn-do + follows-divider Bool
    (param start Index)
    ; Whether the last line before a member's that is not blank is a divider of three or more of the
    ; glyphs that divide types and members, alone: a module's machine written so is one of its
    ; functions.
    (let index (call (. lines line-index-at-offset) start))
    (while (!= index 0)
      (-= index 1)
      (let text (call js-trim (call (. lines text-at) index)))
      (if (!= (. text length) 0)
        (if (< (. text length) 3)
          (return false)
        )
        (for (in char text)
          (if (and (!= char (char "━")) (!= char (char "─")))
            (return false)
          )
        )
        (return true)
      )
    )
    (return false)
  )
  (fn-expr + module-function-bucket String
    (param access Access)
    (param return-type SyntaxId)
    (case? (not (call is-tests-path (. lines source path)))
      (str prefix "-functions")
    )
    (case? (== name "testrender")
      (str prefix "-test-render-functions")
    )
    (case? (== name "testcase")
      (str prefix "-test-case-functions")
    )
    (case? (== prefix "public")
      "test-public-functions"
    )
    (default
      (str prefix "-functions")
    )
    (where
      (lazy prefix (call access-prefix access))
      (lazy name (call normalized-name (call type-name return-type)))
    )
  )
  (fn-expr + type-name String
    (param id SyntaxId)
    (if-expr (== id 0) "" (call declared-type-name id))
  )
  (fn-expr + declared-type-name String
    (param id SyntaxId)
    (match ([] (. tree nodes) id)
      (case (call .node-type-identifier row)
        (. row name text)
      )
      (case (call .node-core-type-identifier row)
        (. row name text)
      )
      (default
        ""
      )
    )
  )
  (fn-expr + property-bucket String
    (param row ASTProperty)
    (param scope String)
    (case? (and (!= (. row value) 0) (call is-state-machine (. row value)))
      (str prefix "-state-machine-" scope)
    )
    (case? (and (== scope "properties") (!= (. row annotations count) 0))
      (str prefix "-style-properties")
    )
    (case? (. row is-lazy)
      (str prefix "-lazy-" scope)
    )
    (default
      (str prefix "-" scope)
    )
    (where
      (lazy prefix (call access-prefix (. row access)))
    )
  )
  (fn-expr + is-state-machine Bool
    (param id SyntaxId)
    (match ([] (. tree nodes) id)
      (case .node-state-machine
        true
      )
      (default
        false
      )
    )
  )
  (fn-expr + one-line-type-bucket String
    (param row ASTClassBlock)
    (param start Index)
    (param end Index)
    (case? (or (not header) (call is-function-type (. row base)))
      ""
    )
    (case? (or (. signature has-inline-expression) (!= (. signature next-index) (+ header 1)))
      ""
    )
    (case? (and (== (. row base) 0) (== (. row or-bases count) 0))
      ""
    )
    (case? (not (call has-word (call js-trim (call (. lines text-at) header)) "is"))
      ""
    )
    (case? (!= (. row members count) 0)
      ""
    )
    (default
      (str (call access-prefix (. row access)) "-one-line-types")
    )
    (where
      (lazy header (call declaration-header-index start end))
      (lazy signature (call (. lines scan-signature) (+ header 1)))
    )
  )
  (fn-do + is-one-line-unit-type Bool
    (param start Index)
    (param end Index)
    ; Whether a type's header is a one-line unit type: `+ Name(...) is ...`.
    (let header (call declaration-header-index start end))
    (if (not header)
      (return false)
    )
    (let trimmed (call js-trim (call (. lines text-at) header)))
    (let key (call header-key-start trimmed))
    (if (not key)
      (return false)
    )
    (for (in open (..< (+ key 1) (. trimmed length)))
      (if (!= ([] trimmed open) (char "("))
        (continue)
      )
      (let close (+ open 1))
      (while (and (< close (. trimmed length)) (!= ([] trimmed close) (char ")")))
        (+= close 1)
      )
      (if (>= close (. trimmed length))
        (return false)
      )
      (let word (call skip-spaces trimmed (+ close 1)))
      (if (and (> word (+ close 1)) (call has-word-at trimmed word "is"))
        (return true)
      )
    )
    (return false)
  )
  (fn-do + classify-type-member String
    (param id SyntaxId)
    (param start Index)
    (param end Index)
    (match ([] (. tree nodes) id)
      (case .node-enum-declaration
        (return "enum-cases")
      )
      (case (call .node-property-syntax row)
        (return (call property-bucket row "properties"))
      )
      (case .node-dependency-declaration
        (return "dependencies")
      )
      (case .node-style-annotation
        (return "style-annotations")
      )
      (case .node-rule-syntax
        (return "style-rules")
      )
      (case .node-content-block
        (return "content-block")
      )
      (case (call .node-fromverter-syntax row)
        (return (if-expr (== (. row access) .public-access) "public-fromverters" ""))
      )
      (case (call .node-converter-syntax row)
        (return (if-expr (== (. row access) .public-access) "public-converters" ""))
      )
      (case .node-subscriber-syntax
        (return "subscriptions")
      )
      (case .node-when-rule-syntax
        (return "when-rules")
      )
      (case .node-whenever-rule-syntax
        (return "whenever-rules")
      )
      (case (call .node-function-syntax row)
        (return (call function-bucket row false false start end))
      )
      (default
        (return "")
      )
    )
  )
  (fn-do + function-bucket String
    (param row ASTFunction)
    (param getter Bool)
    (param setter Bool)
    (param start Index)
    (param end Index)
    (let prefix (call access-prefix (. row access)))
    (if (and (== (. row names count) 1) (== (. ([] (. tree atoms) (. row names start)) text) "This"))
      (return (str prefix "-constructors"))
    )
    (if (or getter (. row is-getter))
      (if (call has-explicit-getter-header start end)
        (return (str prefix "-getters"))
      )
      (return (str prefix "-inline-getter-properties"))
    )
    (if (or setter (. row is-setter))
      (return (str prefix "-setters"))
    )
    (let operator (call operator-token row start end))
    (if (== (. operator length) 0)
      (return (str prefix "-methods"))
    )
    (if (== operator "[]")
      (return (str prefix "-indexers"))
    )
    (if (== operator "[]=")
      (return (str prefix "-index-setters"))
    )
    (if (== operator "-=[]")
      (return (str prefix "-index-deleters"))
    )
    (if (call is-prefix-operator operator)
      (return (str prefix "-prefix-operators"))
    )
    (return (str prefix "-operators"))
  )
  (fn-expr + has-explicit-getter-header Bool
    (param start Index)
    (param end Index)
    (case? (not header)
      false
    )
    (case? (not key)
      false
    )
    (case? (and (call has-word-at trimmed key "do") (> following (+ key 2)) (call has-word-at trimmed following "get"))
      true
    )
    (default
      (call has-word-at trimmed key "get")
    )
    (where
      (lazy header (call declaration-header-index start end))
      (lazy trimmed (call js-trim (call (. lines text-at) header)))
      (lazy key (call header-key-start trimmed))
      (lazy following (call skip-spaces trimmed (+ key 2)))
    )
  )
  (fn-expr + operator-token String
    (param row ASTFunction)
    (param start Index)
    (param end Index)
    (case? (!= (. row names count) 1)
      ""
    )
    (default
      (call header-operator (. ([] (. tree atoms) (. row names start)) text) (if-expr header (call (. lines text-at) header) ""))
    )
    (where
      (lazy header (call declaration-header-index start end))
    )
  )
  (fn-do + classify-sheet-member String
    (param id SyntaxId)
    (match ([] (. tree nodes) id)
      (case (call .node-property-syntax row)
        (let lazy (if-expr (. row is-lazy) "lazy-" ""))
        (return (str (call access-prefix (. row access)) "-" lazy "slots"))
      )
      (case .node-rule-syntax
        (return "style-rules")
      )
      (default
        (return "")
      )
    )
  )
  (fn-do + classify-sheet-rule-body-member String
    (param id SyntaxId)
    (match ([] (. tree nodes) id)
      (case .node-assign
        (return "style-declarations")
      )
      (case .node-style-when
        (return "style-when-blocks")
      )
      (case .node-rule-syntax
        (return "nested-style-rules")
      )
      (default
        (return "")
      )
    )
  )
  (fn-do + classify-rule-body-member String
    (param id SyntaxId)
    (match ([] (. tree nodes) id)
      (case .node-assign
        (return "style-declarations")
      )
      (case .node-style-when
        (return "style-when-blocks")
      )
      (case .node-markup-slot-forward
        (return "generated-content-slots")
      )
      (case (call .node-markup row)
        (return (if-expr (!= (. row slot-binding) 0) "generated-content-slots" "content-body"))
      )
      (case .node-rule-syntax
        (return "nested-style-rules")
      )
      (default
        (return "content-body")
      )
    )
  )
  (fn-do + add-sortable-region _
    (param chunks (list Chunk))
    (param first Index)
    (param last Index)
    (param order (map String OrderInfo))
    ; Proposes the chunks from `first` up to `last` in their sorted order, where that moves them.
    (let start (. ([] chunks first) start))
    (let end (. ([] chunks (- last 1)) end))
    (let old (call (. lines source slice) start end))
    (let region (list Chunk))
    (for (in position (..< first last))
      (+= region ([] chunks position))
    )
    (let rendered (call render-sortable-chunks region order))
    (let needs-break (and (call ends-with-line-break old) (!= (. rendered length) 0)))
    (let replacement (if-expr needs-break (+ rendered (. lines line-break)) rendered))
    (if (!= replacement old)
      (call (. lines add) start end replacement)
    )
  )
  (fn-do + render-sortable-chunks String
    (param chunks (list Chunk))
    (param order (map String OrderInfo))
    (let sorted (call sort chunks (:using compare-chunks)))
    (let line-break (. lines line-break))
    (let parts (list String))
    (let previous (? Chunk) null)
    (for (in chunk sorted)
      (let text (call render-chunk-text chunk))
      (if previous
        (+= parts (call separator-between previous chunk order text))
      )
      (+= parts text)
      (= previous chunk)
    )
    (return (call (. "" join) parts))
  )
  (fn-expr + render-chunk-text String
    (param chunk Chunk)
    (if-expr (or (not (. chunk requires-type-divider)) (call starts-with-divider (. chunk text))) (. chunk text) divided)
    (where
      (lazy divided (str type-divider (. lines line-break) (. lines line-break) (. chunk text)))
    )
  )
  (fn-expr + separator-between String
    (param left Chunk)
    (param right Chunk)
    (param order (map String OrderInfo))
    (param right-text String)
    (case? (!= (. right section) (. left section))
      double
    )
    (case? (and (call is-style-rule-bucket (. left bucket)) (call is-style-rule-bucket (. right bucket)))
      double
    )
    (case? (or (call starts-with-comment right-text) (call starts-with-divider right-text))
      double
    )
    (default
      (. lines line-break)
    )
    (where
      (lazy double (str (. lines line-break) (. lines line-break)))
    )
  )
  (fn-do + chunk-text String
    (param bucket String)
    (param text String)
    (return (if-expr (call is-one-line-type-bucket bucket) (call strip-divider-lines text) text))
  )
  (fn-do + strip-divider-lines String
    (param text String)
    (let kept (list String))
    (for (in line (call split-break-lines text))
      (if (!= (call format-kind line) .format-divider)
        (+= kept line)
      )
    )
    (return (call trim-outer-blank-lines (call (. lines line-break join) kept)))
  )
)

(fn-expr + compare-chunks Comparison
  (param left Chunk)
  (param right Chunk)
  ; The order of two chunks: by bucket and then by priority, except that member functions with a
  ; priority from an interface or base type go by priority first.
  (case? (and semantic (!= (. left sort-priority) (. right sort-priority)))
    (call compare-basic (. left sort-priority) (. right sort-priority))
  )
  (case? (!= (. left order-index) (. right order-index))
    (call compare-basic (. left order-index) (. right order-index))
  )
  (case? (!= (. left sort-priority) (. right sort-priority))
    (call compare-basic (. left sort-priority) (. right sort-priority))
  )
  (default
    (call compare-basic (. left original-index) (. right original-index))
  )
  (where
    (lazy semantic (and has-priority (. left is-member-function) (. right is-member-function)))
    (lazy has-priority (or (!= (. left sort-priority) 0) (!= (. right sort-priority) 0)))
  )
)

(fn-do + first-break-line String
  (param text String)
  (let newline (call (. text find) "\n"))
  (if (not newline)
    (return text)
  )
  (let end newline)
  (if (and (> end 0) (== ([] text (- end 1)) (char "\r")))
    (-= end 1)
  )
  (return (if-expr (> end 0) ([] text (..< 0 end)) ""))
)

(fn-expr + starts-with-comment Bool
  (param text String)
  (== (call format-kind (call first-break-line text)) .format-comment)
)

(fn-do + starts-with-divider Bool
  (param text String)
  (let split (call split-break-lines text))
  (let index Index 0)
  (while (and (< index (. split length)) (call is-section-comment-line ([] split index)))
    (+= index 1)
  )
  (if (and (> index 0) (< index (. split length)) (== (call format-kind ([] split index)) .format-blank))
    (+= index 1)
  )
  (return (and (< index (. split length)) (== (call format-kind ([] split index)) .format-divider)))
)

(fn-expr + is-style-rule-bucket Bool
  (param bucket String)
  (or (== bucket "style-rules") (== bucket "nested-style-rules"))
)

(fn-expr + is-opaque-bucket Bool
  (param bucket String)
  (or (== bucket "module-main-body") (== bucket "content-body"))
)

(fn-expr + is-one-line-type-bucket Bool
  (param bucket String)
  (or (== bucket "public-one-line-types") (== bucket "private-one-line-types"))
)

(fn-do + is-member-function-bucket Bool
  (param bucket String)
  (for (in name (call member-function-buckets))
    (if (== name bucket)
      (return true)
    )
  )
  (return false)
)

(fn-do + is-semantic-callable-bucket Bool
  (param bucket String)
  (for (in name (call semantic-callable-buckets))
    (if (== bucket name)
      (return true)
    )
  )
  (return false)
)

(fn-expr + semantic-callable-buckets (list String)
  (item "public-getters")
  (item "public-setters")
  (item "public-operators")
  (item "public-indexers")
  (item "public-index-setters")
  (item "public-index-deleters")
  (item "public-prefix-operators")
  (item "public-methods")
)

(fn-expr + access-prefix String
  (param access Access)
  (if-expr (== access .public-access) "public" "private")
)

(fn-do + has-word Bool
  (param text String)
  (param word String)
  (for (in position (..< 0 (. text length)))
    (if (and (call has-word-boundary-before text position) (call has-word-at text position word))
      (return true)
    )
  )
  (return false)
)

(fn-do + normalized-name String
  (param name String)
  (let text String)
  (for (in char name)
    (if (or (call is-ascii-letter char) (and (>= char '0') (<= char '9')))
      (+= text (call lower-ascii char))
    )
  )
  (return text)
)

(fn-expr + lower-ascii Char
  (param char Char)
  (if-expr (and (>= char 'A') (<= char 'Z')) (as (+ (as char U32) 32) Char) char)
)

(fn-do + is-tests-path Bool
  (param path String)
  ; Whether a path has a `tests` folder in it, which the reference finds by its separators.
  (let start Index 0)
  (while true
    (let found (call (. path find) "tests" start))
    (if (not found)
      (return false)
    )
    (let at-start (or (== found 0) (== ([] path (- found 1)) '/') (== ([] path (- found 1)) (char "\\"))))
    (let following (+ found 5))
    (if (and at-start (< following (. path length)) (or (== ([] path following) '/') (== ([] path following) (char "\\"))))
      (return true)
    )
    (= start (+ found 1))
  )
  (return false)
)

(fn-do + primary-type-names (map String Bool)
  (param path String)
  ; The names that a source's file names its primary types by: the file's stem, and the stem as a
  ; singular where it ends in `ies` or `s`.
  (let names (map String Bool))
  (let stem (call normalized-name (call file-stem path)))
  (if (== (. stem length) 0)
    (return names)
  )
  (= ([] names stem) true)
  (if (and (call (. stem ends-with) "ies") (> (. stem length) 3))
    (= ([] names (str ([] stem (..< 0 (- (. stem length) 3))) "y")) true)
  )
  (if (and (call (. stem ends-with) "s") (> (. stem length) 1))
    (= ([] names ([] stem (..< 0 (- (. stem length) 1)))) true)
  )
  (return names)
)

(fn-do + file-stem String
  (param path String)
  (let start Index 0)
  (for (in index (..< 0 (. path length)))
    (if (or (== ([] path index) '/') (== ([] path index) (char "\\")))
      (= start (+ index 1))
    )
  )
  (let name (if-expr (< start (. path length)) ([] path (... start)) ""))
  (let dot (call (. name find-reverse) "."))
  (return (if-expr (and dot (> dot 0)) ([] name (..< 0 dot)) (if-expr dot "" name)))
)

(fn-do + header-operator String
  (param name String)
  (param header String)
  ; The operator a type function named `name` overloads, written as the reference names it, from the
  ; header line that declares it, or nothing, as for the function that calls a value.
  (if (== name "()")
    (return "")
  )
  (if (or (== name "[]") (== name "[]=") (== name "-=[]"))
    (return name)
  )
  (let trimmed (call js-trim header))
  (let key (call header-key-start trimmed))
  (if (not key)
    (return "")
  )
  (let position (call after-function-modifiers trimmed key))
  (if (call has-this-at trimmed position)
    (return name)
  )
  (for (in prefix (list "!" "-=" "-" "<-"))
    (let following (+ position (. prefix length)))
    (if (and (<= following (. trimmed length)) (== ([] trimmed (..< position following)) prefix))
      (if (call has-this-at trimmed (call skip-spaces trimmed following))
        (return (if-expr (== name "-=") "-=del" name))
      )
    )
  )
  (return "")
)

(fn-expr + brix-header-operator String
  (param name String)
  (param header String)
  (case? (== name "()")
    ""
  )
  (case? (or (== name "[]") (== name "[]=") (== name "-=[]"))
    name
  )
  (case? (< (. words length) 3)
    ""
  )
  (case? (== ([] words 2) "(infix")
    name
  )
  (case? (!= ([] words 2) "(prefix")
    ""
  )
  (case? (== name "-=")
    "-=del"
  )
  (default
    name
  )
  (where
    (lazy words (list String) (call (. (call js-trim header) split) " "))
  )
)

(fn-do + after-function-modifiers Index
  (param text String)
  (param start Index)
  (let position start)
  (if (call has-word-at text position "static")
    (let following (call skip-spaces text (+ position 6)))
    (if (> following (+ position 6))
      (= position following)
    )
  )
  (if (call has-word-at text position "do")
    (let following (call skip-spaces text (+ position 2)))
    (if (> following (+ position 2))
      (= position following)
    )
  )
  (return position)
)

(fn-expr + has-this-at Bool
  (param text String)
  (param position Index)
  (case? (or (> (+ position 4) (. text length)) (!= ([] text (..< position (+ position 4))) "this"))
    false
  )
  (default
    (or (== following (. text length)) (not (call is-name-char ([] text following))))
  )
  (where
    (lazy following (+ position 4))
  )
)

(fn-expr + is-name-char Bool
  (param char Char)
  (or (call is-word-char char) (== char '-'))
)

(fn-expr + is-prefix-operator Bool
  (param operator String)
  (or (== operator "!") (== operator "-=del") (== operator "-neg") (== operator "<-read"))
)

(fn-expr + is-header-kind Bool
  (param kind FormatLineKind)
  (or (== kind .format-declaration-header) (== kind .format-event-header))
)
