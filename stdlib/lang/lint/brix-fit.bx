(import ./brix-shapes)
(import ./brix-source)
(import ./diagnostics)
(import ./source)
(import /core/table)
(import /data/diff)
(import /data/sexp)
(import /data/source-sexp)
(import /data/source-tree)
(import /lang/ubrix/build)
(import /lang/ubrix/convert)
(import /lang/ubrix/layout)
(import /lang/ubrix/ubrix-print)
(import /stream/aggregate)
(blank)
(prop _ brix-fit-depth Size (= 5))
(prop _ brix-fit-title _ (= "Write the long rows over several rows"))

(type _ BrixFitter
  (prop _ store SourceStore)
  (prop _ max Size)
  (prop _ depth (? Size))
  (prop _ printer UBrixPrinter)
  (prop + scope (? (of ImmutableTableRow SourceNode)) (= null))
  (fn-do + This _
    (param store _)
    (param max _)
    (param depth _)
    (lazy printer (call UBrixPrinter store))
  )
  (fn-do + fitted (? (of ImmutableTableRow SourceNode))
    (param node (of ImmutableTableRow SourceNode))
    (param indent Size)
    (for (in made (call candidates node))
      (if (<= (call width made indent) max)
        (let done (call settle made indent))
        (return-if done (if done))
      )
    )
    (return null)
  )
  (fn-do + settle (? (of ImmutableTableRow SourceNode))
    (param node (of ImmutableTableRow SourceNode))
    (param indent Size)
    (return-if node (if (call (. store is-comment) node)))
    (return-if (call fitted node indent) (if (> (call width node indent) max)))
    (call (. printer scan-row) node)
    (return-if null (if (. printer armed)))
    (let holder (. printer holder))
    (return-if node (if (or (not holder) (call (. store is-form) holder "paragraph"))))
    (return-if null (if (and (!= depth null) (== indent depth))))
    (let start (. printer start))
    (let items (call (. store listed) holder))
    (let is-changed false)
    (for (in index (..< start (. items length)))
      (let done (call settle ([] items index) (+ indent 1)))
      (return-if null (if (not done)))
      (if (!= (. done index) (. ([] items index) index))
        (= ([] items index) done)
        (= is-changed true)
      )
    )
    (return-if node (if (not is-changed)))
    (return (call (. store replaced) node (. holder id) (call (. store with-items) holder items)))
  )
  (fn-do + width Size
    (param node (of ImmutableTableRow SourceNode))
    (param indent Size)
    (return (+ (. (call (. printer row) node) length) (* indent 4)))
  )
  (fn-do _ candidates (list (of ImmutableTableRow SourceNode))
    (param node (of ImmutableTableRow SourceNode))
    (let made (list (of ImmutableTableRow SourceNode)))
    (return-if made (if (call has-null-fallback node false)))
    (let items (call (. store listed) node))
    (if (call (. store is-form) node "prop")
      (let last ([] items (- (. items length) 1)))
      (return-if made (if (or (< (. items length) 4) (not (call (. store is-form) last "=")) (!= (call (. store count) last) 2))))
      (for (in value (call values (call (. store item) last 1) true true))
        (let given (call (of List (of ImmutableTableRow SourceNode)) (call (. store item) last 0) value))
        (+= made (call with-value node items (- (. items length) 1) (call (. store with-items) last given)))
      )
      (return made)
    )
    (let spot (?? (call slot node) 0))
    (if (== spot 0)
      (let call (call block-call node))
      (if call
        (+= made call)
      )
      (let exit (call guard node))
      (if exit
        (+= made exit)
      )
      (return made)
    )
    (let head (?? (call (. store head) node) ""))
    (let is-held (or (== head "let") (== head "lazy") (and (== head "=") (call is-local node))))
    (for (in value (call values ([] items spot) (or is-held (== head "return")) is-held))
      (+= made (call with-value node items spot value))
    )
    (return made)
  )
  (fn-do _ values (list (of ImmutableTableRow SourceNode))
    (param value (of ImmutableTableRow SourceNode))
    (param decides Bool)
    (param lowers Bool)
    (let made (list (of ImmutableTableRow SourceNode)))
    (let text (call text-block value))
    (if text
      (+= made text)
    )
    (let call (call block-call value))
    (if call
      (+= made call)
    )
    (let choice (only-if (call decision value) (if decides)))
    (if choice
      (+= made choice)
    )
    (if (and lowers (not (call (. store is-form) value "block")))
      (+= made (call (. store list) (call (of List (of ImmutableTableRow SourceNode)) (call (. store atom) "block") value)))
    )
    (return made)
  )
  (fn-do _ has-null-fallback Bool
    (param node (of ImmutableTableRow SourceNode))
    (param is-coalesced Bool)
    (return-if false (if (or (call (. store is-atom) node) (call (. store is-text) node))))
    (let items (call (. store listed) node))
    (return-if false (if (< (. items length) 2)))
    (let is-fallback (and (call (. store is-form) node "if-expr") (== (. items length) 4) (call is-null ([] items 3))))
    (return-if true (if (and is-fallback (not is-coalesced))))
    (let is-coalescing (call (. store is-form) node "??"))
    (return (call some (..< 1 (. items length)) (:where (call has-null-fallback ([] items each) (and is-coalescing (< each (- (. items length) 1)))))))
  )
  (fn-expr _ is-null Bool
    (param node (of ImmutableTableRow SourceNode))
    (and (call (. store is-atom) node) (== (call (. store text) node) "null"))
  )
  (fn-do _ is-local Bool
    (param node (of ImmutableTableRow SourceNode))
    (let target (call (. store item) node 1))
    (let root scope)
    (return-if false (if (or (not root) (not (call (. store is-atom) target)))))
    (return (?? (call visible root (. node id) (call (. store text) target) false) false))
  )
  (fn-do _ visible (? Bool)
    (param node (of ImmutableTableRow SourceNode))
    (param id U32)
    (param name String)
    (param known Bool)
    (return-if known (if (== (. node id) id)))
    (return-if null (if (or (call (. store is-atom) node) (call (. store is-text) node))))
    (let holds (call holds-statements node))
    (let seen (and known holds))
    (for (in item (call (. store listed) node))
      (let found (call visible item id name seen))
      (return-if found (if (!= found null)))
      (if (and holds (call declares item name))
        (= seen true)
      )
    )
    (return null)
  )
  (fn-expr _ holds-statements Bool
    (param node (of ImmutableTableRow SourceNode))
    (or is-body is-branch is-arm is-loop is-guarded)
    (where
      (lazy head (?? (call (. store head) node) ""))
      (lazy is-body (or (== head "fn-do") (== head "main") (== head "block") (== head "do") (== head "=>")))
      (lazy is-branch (or (== head "if") (== head "else-if") (== head "else") (call (. head starts-with) "match")))
      (lazy is-arm (or (call (. head starts-with) "case") (== head "default")))
      (lazy is-loop (or (== head "for") (== head "while") (call (. head starts-with) "subscribe")))
      (lazy is-guarded
        (block
          (or (== head "do-use") (== head "do-new-thread") (== head "on-error") (== head "finally"))
        )
      )
    )
  )
  (fn-expr _ declares Bool
    (param node (of ImmutableTableRow SourceNode))
    (param name String)
    (and is-binding (call (. store is-atom) target) (== (call (. store text) target) name))
    (where
      (lazy is-binding
        (block
          (and (or (call (. store is-form) node "let") (call (. store is-form) node "param")) (>= (call (. store count) node) 2))
        )
      )
      (lazy target (call (. store item) node 1))
    )
  )
  (fn-do _ with-value (of ImmutableTableRow SourceNode)
    (param node (of ImmutableTableRow SourceNode))
    (param items (list (of ImmutableTableRow SourceNode)))
    (param spot Size)
    (param value (of ImmutableTableRow SourceNode))
    (let made items)
    (= ([] made spot) value)
    (return (call (. store with-items) node made))
  )
  (fn-expr _ slot (? Size)
    (param node (of ImmutableTableRow SourceNode))
    (case? (or (== head "let") (== head "lazy"))
      (only-if (- count 1) (if (or (== count 4) (and (== count 3) (not (call ubrix-is-type-form store (call (. store item) node 2)))))))
    )
    (case? (or (== head "return") (== head "throw") (== head "arg") (== head "item") (call ubrix-is-keyword-head head))
      (only-if 1 (if (== count 2)))
    )
    (case? (and (== count 3) (== (call ubrix-precedence head) (call ubrix-precedence "=")))
      2
    )
    (default
      null
    )
    (where
      (lazy head (?? (call (. store head) node) ""))
      (lazy count (call (. store count) node))
    )
  )
  (fn-do _ block-call (? (of ImmutableTableRow SourceNode))
    (param node (of ImmutableTableRow SourceNode))
    (return-if null (if (or (not (call (. store is-form) node "call")) (< (call (. store count) node) 3))))
    (let items (call (. store listed) node))
    (let last ([] items (- (. items length) 1)))
    (return-if null (if (and (== (. items length) 3) (call (. store is-form) last "block"))))
    (let args (call (of List (of ImmutableTableRow SourceNode)) (call (. store atom) "block")))
    (for (in index (..< 2 (. items length)))
      (let item ([] items index))
      (if (and (== (+ index 1) (. items length)) (call (. store is-form) item "block"))
        (for (in inner (call (. store listed) item 1))
          (return-if null (if (not (or (call (. store is-form) inner "arg") (call is-named inner)))))
          (+= args inner)
        )
        (else-if (call is-named item)
          (+= args item)
        )
        (else
          (return-if null (if (not (call is-positional item))))
          (+= args (call (. store list) (call (of List (of ImmutableTableRow SourceNode)) (call (. store atom) "arg") item)))
        )
      )
    )
    (return (call (. store with-items) node (call (of List (of ImmutableTableRow SourceNode)) ([] items 0) ([] items 1) (call (. store list) args))))
  )
  (fn-do _ guard (? (of ImmutableTableRow SourceNode))
    (param node (of ImmutableTableRow SourceNode))
    (return-if (call raise-guard node) (if (call (. store is-form) node "throw")))
    (return-if null (if (not (call (. store is-form) node "return-if"))))
    (let items (call (. store listed) node))
    (let test ([] items (- (. items length) 1)))
    (return-if null (if (or (> (. items length) 3) (not (call (. store is-form) test "if")) (!= (call (. store count) test) 2))))
    (let exit (call (of List (of ImmutableTableRow SourceNode)) (call (. store atom) "return")))
    (if (== (. items length) 3)
      (+= exit ([] items 1))
    )
    (let made
      (call (of List (of ImmutableTableRow SourceNode))
        (block
          (arg (call (. store atom) "if"))
          (arg (call (. store item) test 1))
          (arg (call (. store list) exit))
        )
      )
    )
    (return (call (. store with-items) node made))
  )
  (fn-do _ raise-guard (? (of ImmutableTableRow SourceNode))
    (param node (of ImmutableTableRow SourceNode))
    (let items (call (. store listed) node))
    (return-if null (if (!= (. items length) 3)))
    (let test ([] items 2))
    (return-if null (if (or (not (call (. store is-form) test "if")) (!= (call (. store count) test) 2))))
    (let root scope)
    (return-if null (if (not root)))
    (let parent (call parent-of root (. node id)))
    (return-if null (if (or (not parent) (not (call runs-statements parent)))))
    (let raised (call (. store list) (call (of List (of ImmutableTableRow SourceNode)) (call (. store atom) "throw") ([] items 1))))
    (let made
      (call (of List (of ImmutableTableRow SourceNode))
        (block
          (arg (call (. store atom) "if"))
          (arg (call (. store item) test 1))
          (arg raised)
        )
      )
    )
    (return (call (. store with-items) node made))
  )
  (fn-expr _ runs-statements Bool
    (param node (of ImmutableTableRow SourceNode))
    (or (has bodies head) (has branches head) (and (== head "=>") is-steps))
    (where
      (lazy head (?? (call (. store head) node) ""))
      (lazy bodies (list "fn-do" "main" "do" "do-use" "do-new-thread" "on-error" "finally"))
      (lazy branches (list "if" "else-if" "else" "for" "while" "subscribe" "subscribe-for"))
      (lazy is-steps (call some (call (. store listed) node) (:where (call is-do-mark each))))
    )
  )
  (fn-expr _ is-do-mark Bool
    (param node (of ImmutableTableRow SourceNode))
    (and (call (. store is-atom) node) (== (call (. store text) node) ":do"))
  )
  (fn-do _ parent-of (? (of ImmutableTableRow SourceNode))
    (param node (of ImmutableTableRow SourceNode))
    (param id U32)
    (return-if null (if (or (call (. store is-atom) node) (call (. store is-text) node))))
    (for (in item (call (. store listed) node))
      (return-if node (if (== (. item id) id)))
      (let found (call parent-of item id))
      (return-if found (if found))
    )
    (return null)
  )
  (fn-do _ text-block (? (of ImmutableTableRow SourceNode))
    (param node (of ImmutableTableRow SourceNode))
    (if (and (call (. store is-form) node "++") (>= (call (. store count) node) 3))
      (let items (call (. store listed) node))
      (let block (call text-block ([] items (- (. items length) 1))))
      (return-if null (if (not block)))
      (= ([] items (- (. items length) 1)) block)
      (return (call (. store with-items) node items))
    )
    (let parts (list (of ImmutableTableRow SourceNode)))
    (if (call (. store is-text) node)
      (+= parts node)
      (else-if (call (. store is-form) node "str")
        (= parts (call (. store listed) node 1))
      )
      (else
        (return null)
      )
    )
    (let lines (call (of List (of ImmutableTableRow SourceNode)) (call (. store atom) "paragraph")))
    (let line (list (of ImmutableTableRow SourceNode)))
    (for (in part parts)
      (if (not (call (. store is-text) part))
        (+= line part)
        (continue)
      )
      (let text (call (. store text) part))
      (return-if null (if (or (!= (call (. text find) "\t") null) (!= (call (. text find) "\r") null))))
      (let pieces (call List (call (. text split) "\n")))
      (for (in index (..< 0 (. pieces length)))
        (if (> index 0)
          (return-if null (if (not (call is-text-line line))))
          (+= lines (call text-line line))
          (= line (call (of List (of ImmutableTableRow SourceNode))))
        )
        (if (> (. ([] pieces index) length) 0)
          (+= line (call (. store string) ([] pieces index)))
        )
      )
    )
    (return-if null (if (not (call is-text-line line))))
    (+= lines (call text-line line))
    (return-if null (if (or (call (. store is-blank) ([] lines 1)) (call (. store is-blank) ([] lines (- (. lines length) 1))))))
    (return (call (. store with-items) node lines))
  )
  (fn-expr _ is-text-line Bool
    (param parts (list (of ImmutableTableRow SourceNode)))
    (case? (== (. parts length) 0)
      true
    )
    (case? (call (. store is-text) last)
      (not (call (. (call (. store text) last) ends-with) " "))
    )
    (default
      true
    )
    (where
      (lazy last ([] parts (- (. parts length) 1)))
    )
  )
  (fn-do _ text-line (of ImmutableTableRow SourceNode)
    (param parts (list (of ImmutableTableRow SourceNode)))
    (return-if (call (. store blank)) (if (== (. parts length) 0)))
    (return-if ([] parts 0) (if (and (== (. parts length) 1) (call (. store is-text) ([] parts 0)))))
    (let items (call (of List (of ImmutableTableRow SourceNode)) (call (. store atom) "str")))
    (++= items parts)
    (return (call (. store list) items))
  )
  (fn-do _ decision (? (of ImmutableTableRow SourceNode))
    (param node (of ImmutableTableRow SourceNode))
    (return-if null (if (or (not (call (. store is-form) node "if-expr")) (!= (call (. store count) node) 4))))
    (let tests (list (of ImmutableTableRow SourceNode)))
    (let results (list (of ImmutableTableRow SourceNode)))
    (let rest node)
    (while (and (call (. store is-form) rest "if-expr") (== (call (. store count) rest) 4))
      (+= tests (call (. store item) rest 1))
      (+= results (call (. store item) rest 2))
      (= rest (call (. store item) rest 3))
    )
    (let subject (call subject-of tests))
    (let is-match (and (!= subject null) (not (call mentions-it node))))
    (let arms (call (of List (of ImmutableTableRow SourceNode)) (call (. store atom) (if-expr is-match "match" "block"))))
    (if (and subject is-match)
      (+= arms subject)
    )
    (for (in index (..< 0 (. tests length)))
      (let test (if-expr is-match (call (. store item) ([] tests index) 2) ([] tests index)))
      (+= arms
        (call (. store list)
          (block
            (arg
              (call (of List (of ImmutableTableRow SourceNode))
                (block
                  (arg (call (. store atom) (if-expr is-match "case=" "case?")))
                  (arg test)
                  (arg ([] results index))
                )
              )
            )
          )
        )
      )
    )
    (+= arms (call (. store list) (call (of List (of ImmutableTableRow SourceNode)) (call (. store atom) "default") rest)))
    (return (call (. store with-items) node arms))
  )
  (fn-do _ subject-of (? (of ImmutableTableRow SourceNode))
    (param tests (list (of ImmutableTableRow SourceNode)))
    (let first ([] tests 0))
    (return-if null (if (or (not (call (. store is-form) first "==")) (!= (call (. store count) first) 3))))
    (let subject (call (. store item) first 1))
    (return-if null (if (not (call is-pure subject))))
    (for (in test tests)
      (return-if null (if (or (not (call (. store is-form) test "==")) (!= (call (. store count) test) 3) (not (call (. store same) (call (. store item) test 1) subject)))))
    )
    (return subject)
  )
  (fn-expr _ is-pure Bool
    (param node (of ImmutableTableRow SourceNode))
    (case? (call (. store is-atom) node)
      true
    )
    (case? (call (. store is-form) node ".")
      (call all ([] (call (. store items) node) (... 1)) (:where (call is-pure each)))
    )
    (default
      false
    )
  )
  (fn-expr _ mentions-it Bool
    (param node (of ImmutableTableRow SourceNode))
    (case? (call (. store is-atom) node)
      (== (call (. store text) node) "it")
    )
    (default
      (call some (call (. store items) node) (:where (call mentions-it each)))
    )
  )
  (fn-expr _ is-named Bool
    (param node (of ImmutableTableRow SourceNode))
    (call ubrix-is-keyword-head (?? (call (. store head) node) ""))
  )
  (fn-expr _ is-positional Bool
    (param node (of ImmutableTableRow SourceNode))
    (not (or (call ubrix-is-keyword-head head) (== head "entry") (== head "entry?") (== head "block") (== head "inline")))
    (where
      (lazy head (?? (call (. store head) node) ""))
    )
  )
)

(type _ BrixFitted (is Tuple)
  (prop + unit (of ImmutableTableRow SourceNode))
  (prop + made (of ImmutableTableRow SourceNode))
  (prop + fixed (list U32))
  (prop + first U32)
  (prop + is-main Bool)
)

(fn-do + brix-fit-fixes (map U32 LintFix)
  (param source LintSource)
  (param shapes (list BrixRowShape))
  (param max Size)
  (let fixes (map U32 LintFix))
  (let brix (call read-brix-source source))
  (return-if fixes (if (not brix)))
  (for (in fit (call fitted-units brix shapes max brix-fit-depth))
    (let edits (list LintTextEdit))
    (for (in id (. fit fixed))
      (let old (call (. brix store find) (. fit unit) id))
      (let new (call (. brix store find) (. fit made) id))
      (if (and old new)
        (+= edits (call (. brix edit) old old (call (. brix text-of) new (call (. brix depth-of) old))))
      )
    )
    (= ([] fixes (. fit first)) (call LintFix "safe" brix-fit-title edits))
  )
  (call (. brix release))
  (return fixes)
)

(fn-do _ fitted-units (list BrixFitted)
  (param brix BrixSource)
  (param shapes (list BrixRowShape))
  (param max Size)
  (param depth (? Size))
  (let store (. brix store))
  (let units (list (of ImmutableTableRow SourceNode)))
  (let scopes (list (of ImmutableTableRow SourceNode)))
  (let mains (list Bool))
  (for (in root (. brix roots))
    (let node (call (. store node) root))
    (if (call (. store is-form) node "main")
      (for (in item (call (. store listed) node 1))
        (+= units item)
        (+= scopes node)
        (+= mains true)
      )
      (else
        (+= units node)
        (+= scopes node)
        (+= mains false)
      )
    )
  )
  (let owners (map U32 Index))
  (for (in index (..< 0 (. units length)))
    (call own store ([] units index) index owners)
  )
  (let fitter (call BrixFitter store max depth))
  (let found (list BrixFitted))
  (for (in index (..< 0 (. units length)))
    (let held (list BrixRowShape))
    (for (in shape shapes)
      (if (and (> (. shape columns) max) (not (. shape is-text)) (== ([] owners (. shape id)) index))
        (+= held shape)
      )
    )
    (if (!= (. held length) 0)
      (= (. fitter scope) ([] scopes index))
      (let fit (call fit-unit store fitter ([] units index) ([] mains index) held max depth))
      (if fit
        (+= found fit)
      )
    )
  )
  (return found)
)

(fn-do _ own _
  (param store SourceStore)
  (param node (of ImmutableTableRow SourceNode))
  (param unit Index)
  (param owners (map U32 Index))
  (= ([] owners (. node id)) unit)
  (for (in item (call (. store items) node))
    (call own store item unit owners)
  )
)

(fn-do _ fit-unit (? BrixFitted)
  (param store SourceStore)
  (param fitter BrixFitter)
  (param unit (of ImmutableTableRow SourceNode))
  (param is-main Bool)
  (param held (list BrixRowShape))
  (param max Size)
  (param depth (? Size))
  (let made unit)
  (let fixed (list U32))
  (for (in shape held)
    (let is-covered (call some fixed (:where (!= (call (. store find) (?? (call (. store find) made each) made) (. shape id)) null))))
    (let node (call (. store find) made (. shape id)))
    (if (and node (not is-covered))
      (let done (call (. fitter fitted) node (. shape indent)))
      (if done
        (= made (?? (call (. store replaced) made (. shape id) done) made))
        (+= fixed (. shape id))
      )
    )
  )
  (return-if null (if (== (. fixed length) 0)))
  (let before (call unit-text store unit is-main))
  (let after (call unit-text store made is-main))
  (if (or (not (call brix-round-trips before)) (not (call brix-round-trips after)) (not (call is-better before after max depth)))
    (return null)
  )
  (return (call BrixFitted unit made fixed (. ([] held 0) id) is-main))
)

(fn-expr _ bare String
  (param line String)
  ([] line (..< 0 end))
  (where
    (lazy end (call ending line))
  )
)

(fn-do _ ending Index
  (param line String)
  (let end (. line length))
  (while (and (> end 0) (== ([] line (- end 1)) (char " ")))
    (-= end 1)
  )
  (return end)
)

(fn-do _ anchored (? I64)
  (param lines (list String))
  (param rows (list String))
  (for (in index (..< 0 (. rows length)))
    (if (> (. (call (. ([] rows index) trim)) length) 3)
      (let place (call located lines rows index (+ index 1) 0 -1))
      (if place
        (let others (call located lines rows index (+ index 1) (+ place 1) -1))
        (return-if (- (as place I64) (as index I64)) (if (not others)))
      )
    )
  )
  (return null)
)

(fn-do _ located (? Index)
  (param lines (list String))
  (param rows (list String))
  (param start Index)
  (param end Index)
  (param from Index)
  (param near I64)
  (let count (- end start))
  (let found (? Index) null)
  (let gap I64 0)
  (let place from)
  (while (<= (+ place count) (. lines length))
    (if (call all (..< 0 count) (:where (== (call bare ([] lines (+ place each))) ([] rows (+ start each)))))
      (let distance (if-expr (> (as place I64) near) (- (as place I64) near) (- near (as place I64))))
      (if (< near 0)
        (return place)
      )
      (if (or (== found null) (< distance gap))
        (= found place)
        (= gap distance)
      )
    )
    (+= place 1)
  )
  (return found)
)

(fn-do _ edited String
  (param source LintSource)
  (param edits (list LintTextEdit))
  (let parts (list String))
  (let at Index 0)
  (for (in edit edits)
    (let start (call (. source char-of) (. edit start)))
    (+= parts (call (. source slice) at start))
    (+= parts (. edit replacement))
    (= at (call (. source char-of) (. edit end)))
  )
  (+= parts (call (. source slice) at (. source text length)))
  (return (call (. "" join) parts))
)

(fn-do _ unit-text String
  (param store SourceStore)
  (param node (of ImmutableTableRow SourceNode))
  (param is-main Bool)
  (let shown
    (block
      (case? is-main
        (call (. store list) (call (of List (of ImmutableTableRow SourceNode)) (call (. store atom) "main") node))
      )
      (default
        node
      )
    )
  )
  (return (call sexp-nested-text store shown (call UBrixLayout store) 0))
)

(fn-do _ brix-round-trips Bool
  (param text String)
  (let view (catch? (call brix-to-ubrix text)))
  (return-if false (if (not view)))
  (let back (catch? (call ubrix-to-brix view)))
  (return-if false (if (not back)))
  (let store (use (call SourceStore)))
  (let left (catch? (call sexp-read text store)))
  (let right (catch? (call sexp-read back store)))
  (return-if false (if (or (not left) (not right) (!= (. left length) (. right length)))))
  (return (call all (..< 0 (. left length)) (:where (call is-alike store (call (. store node) ([] left each)) (call (. store node) ([] right each))))))
)

(fn-do _ is-alike Bool
  (param store SourceStore)
  (param left (of ImmutableTableRow SourceNode))
  (param right (of ImmutableTableRow SourceNode))
  (return-if (call (. store same) left right) (if (or (not (call (. store is-list) left)) (not (call (. store is-list) right)))))
  (let one (call flat store left))
  (let two (call flat store right))
  (return-if false (if (!= (. one length) (. two length))))
  (return (call all (..< 0 (. one length)) (:where (call is-alike store ([] one each) ([] two each)))))
)

(fn-do _ flat (list (of ImmutableTableRow SourceNode))
  (param store SourceStore)
  (param node (of ImmutableTableRow SourceNode))
  (let items (list (of ImmutableTableRow SourceNode)))
  (for (in item (call (. store items) node))
    (if (not (call (. store is-blank) item))
      (+= items item)
    )
  )
  (return-if items (if (or (< (. items length) 2) (not (call (. store is-form) node ".")) (not (call (. store is-form) ([] items 1) ".")))))
  (let made (call flat store ([] items 1)))
  (for (in index (..< 2 (. items length)))
    (+= made ([] items index))
  )
  (return made)
)

(fn-do _ is-better Bool
  (param before String)
  (param after String)
  (param max Size)
  (param depth (? Size))
  (let old (catch? (call brix-row-shapes before)))
  (let new (catch? (call brix-row-shapes after)))
  (return-if false (if (or (not old) (not new))))
  (return-if false (if (>= (call misses new max) (call misses old max))))
  (return (or (== depth null) (<= (call deep new depth) (call deep old depth))))
)

(fn-do _ misses Size
  (param shapes (list BrixRowShape))
  (param max Size)
  (let found Size 0)
  (for (in shape shapes)
    (if (and (not (. shape is-text)) (> (. shape columns) max))
      (+= found 1)
    )
  )
  (return found)
)

(fn-do _ deep Size
  (param shapes (list BrixRowShape))
  (param depth Size)
  (let found Size 0)
  (let is-deep false)
  (for (in shape shapes)
    (if (. shape is-text)
      (continue)
    )
    (let is-over (> (. shape indent) depth))
    (if (and is-over (not is-deep))
      (+= found 1)
    )
    (= is-deep is-over)
  )
  (return found)
)
