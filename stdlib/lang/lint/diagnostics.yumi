━━━━━━━━━━━━━━━━━━━━
+ rule-catalog [LintRule]

* LintRule
    • id "syntax/parse-error"
    • description "Report sources that do not parse, and in Brix each form the catalog rejects; other rules skip them."
    • phase "ast"
    • default-options no-options()
    • fixable "safe"
* LintRule
    • id "complexity/cyclomatic"
    • description "Keep function cyclomatic complexity within a configured maximum."
    • phase "ast"
    • default-options max-options(15)
    • recommended false
* LintRule
    • id "layout/line-length"
    • description "Keep ordinary Yumi lines and the rows of Brix sources short; divider, comment, and template text lines are exempt."
    • phase "text"
    • default-options max-options(100)
    • fixable "safe"
* LintRule
    • id "layout/divider-length"
    • description "Use 20-character dividers in Yumi; labeled comments have 10 dashes on each side."
    • phase "text"
    • default-options no-options()
    • fixable "safe"
* LintRule
    • id "layout/depth"
    • description "Keep the rows of Brix sources from nesting too deep."
    • phase "text"
    • default-options max-options(5)
* LintRule
    • id "layout/format"
    • description "Apply fix-only formatting: Yumi layout and dividers, or Brix layout, and declaration order."
    • phase "text"
    • default-options format-options()
    • fixable "safe"
* LintRule
    • id "imports/sort"
    • description "Sort contiguous module import groups alphabetically."
    • phase "declaration"
    • default-options no-options()
    • fixable "safe"
* LintRule
    • id "names/import-conflicts"
    • description "Report imported visibility overlap and possible overload competition."
    • phase "declaration"
    • default-options no-options()
* LintRule
    • id "names/local-shadows-import"
    • description "Report local/imported visibility overlap and possible overload competition."
    • phase "declaration"
    • default-options no-options()
* LintRule
    • id "names/type-param-shadows-type"
    • description "Disallow local type parameters that shadow module-level or imported types."
    • phase "declaration"
    • default-options no-options()
* LintRule
    • id "names/case-owner-conflict"
    • description "Report bare cases that overloads resolve by visibility order."
    • phase "semantic"
    • default-options no-options()
* LintRule
    • id "events/no-effectful-payload"
    • description "Keep lazily evaluated event payload expressions free of side effects."
    • phase "semantic"
    • default-options no-options()
* LintRule
    • id "style/no-unused-catch-optional"
    • description "Use catch instead of catch? when the optional result is discarded."
    • phase "ast"
    • default-options no-options()
* LintRule
    • id "style/no-nested-match-assertions"
    • description "Lift assertion-only match and table fallbacks into direct raise arms."
    • phase "ast"
    • default-options no-options()
    • fixable "safe"
* LintRule
    • id "style/prefer-map-literal"
    • description "Construct populated maps with map literal syntax."
    • phase "ast"
    • default-options no-options()
    • fixable "safe"
* LintRule
    • id "style/prefer-optional-match"
    • description "Prefer optional matches over terminal null defaults."
    • phase "ast"
    • default-options no-options()
* LintRule
    • id "style/prefer-expression-function"
    • description "Prefer expression functions for value-selecting bodies."
    • phase "ast"
    • default-options no-options()
* LintRule
    • id "style/no-redundant-null-fallback"
    • description "Prefer a conditional value to a choice whose other side is null."
    • phase "ast"
    • default-options no-options()
    • fixable "safe"
* LintRule
    • id "style/prefer-decision-table"
    • description "Prefer one match or table over a chain of value-returning early exits."
    • phase "ast"
    • default-options no-options()
* LintRule
    • id "style/prefer-quantifier"
    • description "Prefer `some of` and `all of` over search loops and negated quantifiers."
    • phase "ast"
    • default-options no-options()
* LintRule
    • id "style/prefer-text-template"
    • description "Prefer `¶` templates for functions that build text."
    • phase "ast"
    • default-options no-options()
* LintRule
    • id "style/no-redundant-context-cast"
    • description "Disallow casts where an explicit surrounding type already provides context."
    • phase "semantic"
    • default-options no-options()
* LintRule
    • id "style/no-redundant-literal-suffix"
    • description "Omit a number's type suffix where its place already gives it that type."
    • phase "semantic"
    • default-options no-options()
    • fixable "safe"
* LintRule
    • id "style/no-redundant-default-initializer"
    • description "Omit explicit initializers that reproduce the declared type default."
    • phase "semantic"
    • default-options no-options()
    • fixable "safe"
* LintRule
    • id "style/prefer-constructor-initializer"
    • description "Prefer `..` over constructor assignments that discard a built default."
    • phase "semantic"
    • default-options no-options()
    • fixable "safe"
* LintRule
    • id "style/prefer-shorthand"
    • description "Review visible style shorthands that directly forward a property assignment."
    • phase "declaration"
    • default-options no-options()
* LintRule
    • id "tui/prefer-shortcut-node"
    • description "Review command handlers that could use a declarative <Shortcut>."
    • phase "ast"
    • default-options no-options()

━━━━━━━━━━━━━━━━━━━━
+ find-rule LintRule?
    - catalog [LintRule]
    - id String

catalog
?> each.id == id
|> first

