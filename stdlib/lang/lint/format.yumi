_ divider-length = 20
_ type-divider = "━━━━━━━━━━━━━━━━━━━━"

━━━━━━━━━━━━━━━━━━━━
+ do line-format-candidates [FormatCandidate]
    - source LintSource
    - lengths [Char = Int]

` The replacements the formatter proposes for the lines of a source in one pass: its final line
` break and the shapes, places and neighbors of its dividers. Where there are any, the formatter
` proposes nothing else in that pass.
. formatter = Formatter(source, lengths)
formatter.add-final-newline()
formatter.add-divider-shapes()
formatter.add-function-type-dividers()
formatter.add-meaningless-dividers()
formatter.add-divider-adjacency()
= outermost-candidates(formatter.candidates)

━━━━━━━━━━━━━━━━━━━━
+ do order-format-candidates [FormatCandidate]
    - source LintSource
    - lengths [Char = Int]
    - tree AST
    - index MethodOrderIndex?

` The moves of a parsed source's declarations into order, where `index` places the functions that
` implement an interface or override a base type.
. order = Formatter(source, lengths)
LayoutOrder(order, tree, index).format-module()
= outermost-candidates(order.candidates)

━━━━━━━━━━━━━━━━━━━━
+ do outermost-candidates [FormatCandidate]
    - candidates [FormatCandidate]

` The candidates that no earlier or wider candidate overlaps, by where they start and then the
` widest first.
. sorted [FormatCandidate]
for candidate in candidates
    . position = sorted.length
    while position > 0 && is-placed-before(candidate, sorted[position - 1])
        position -= 1
    sorted.insert(candidate, position)
. kept [FormatCandidate]
for candidate in sorted
    . overlaps = false
    for other in kept
        if candidate.start < other.end && other.start < candidate.end
            overlaps = true
            break
    if !overlaps
        kept += candidate
= kept

━━━━━━━━━━━━━━━━━━━━
+ is-placed-before Bool
    - candidate FormatCandidate
    - other FormatCandidate

candidate.start < other.start || (candidate.start == other.start && candidate.end > other.end)

━━━━━━━━━━━━━━━━━━━━
+ FormatLineKind is Union

| format-blank
| format-divider
| format-declaration-header
| format-event-header
| format-markup-open
| format-comment
| format-body

━━━━━━━━━━━━━━━━━━━━
+ FormatLine is Tuple

` A source line as the formatter sees it, and where it is a divider, the glyph it repeats, how
` many characters it has once trimmed, and whether it mixes glyphs.
+ kind FormatLineKind
+ glyph Char = ' '
+ length Size = 0
+ is-mixed Bool

━━━━━━━━━━━━━━━━━━━━
+ FormatCandidate is Tuple

` A replacement of the text between two character offsets.
+ start Index
+ end Index
+ replacement String

━━━━━━━━━━━━━━━━━━━━
+ SignatureScan is Tuple

+ next-index Index
+ has-inline-expression Bool

━━━━━━━━━━━━━━━━━━━━
+ format-line FormatLine
    - line String

` The kind of a line, which the reference decides from the line with JavaScript whitespace
` trimmed away.
|? trimmed.length == 0
    FormatLine(.format-blank)
|? divider
    divider
|? trimmed[0] == '`'
    FormatLine(.format-comment)
|? is-header-prefix(trimmed)
    FormatLine(.format-declaration-header)
|? is-event-header-start(trimmed)
    FormatLine(.format-event-header)
|? is-markup-start(trimmed)
    FormatLine(.format-markup-open)
??
    FormatLine(.format-body)

.. trimmed = js-trim(line)
.. divider = divider-line(trimmed)

━━━━━━━━━━━━━━━━━━━━
+ format-kind FormatLineKind
    - line String

format-line(line).kind

━━━━━━━━━━━━━━━━━━━━
+ do divider-line FormatLine?
    - trimmed String

` The divider a trimmed line forms: a run of the divider glyphs alone.
. glyph = trimmed[0]
. mixed = false
for char in trimmed
    if !is-divider-glyph(char)
        = null
    if char != glyph
        mixed = true
= FormatLine(.format-divider, glyph, trimmed.length, mixed)

━━━━━━━━━━━━━━━━━━━━
+ is-header-prefix Bool
    - trimmed String

|? first != '+' && first != '_' && first != '^' && first != '•'
    false
??
    trimmed.length > 1 && is-js-space(trimmed[1])

.. first = trimmed[0]

━━━━━━━━━━━━━━━━━━━━
+ is-access-header Bool
    - trimmed String

` Whether a trimmed line opens with `+`, `_` or `^` and whitespace.
|? trimmed.length < 2 || (trimmed[0] != '+' && trimmed[0] != '_' && trimmed[0] != '^')
    false
??
    is-js-space(trimmed[1])

━━━━━━━━━━━━━━━━━━━━
+ is-event-header-start Bool
    - trimmed String

|? !trimmed.starts-with("for")
    false
|? index == 3
    false
??
    has-word-at(trimmed, index, "event")

.. index = skip-spaces(trimmed, 3)

━━━━━━━━━━━━━━━━━━━━
+ do is-markup-start Bool
    - trimmed String

if trimmed[0] != '<'
    = false
. index Index = 1
if index < trimmed.length && trimmed[index] == '/'
    index += 1
= index < trimmed.length && is-ascii-letter(trimmed[index])

━━━━━━━━━━━━━━━━━━━━
+ do js-trim String
    - text String

` Text without the whitespace that JavaScript trims from both ends.
. start Index = 0
. end = text.length
while start < end && is-js-space(text[start])
    start += 1
while end > start && is-js-space(text[end - 1])
    end -= 1
if start == 0 && end == text.length
    = text
= if end > start then text[start .. < end] else ""

━━━━━━━━━━━━━━━━━━━━
+ is-js-space Bool
    - char Char

` Whether JavaScript counts a character as whitespace.
|? code == 32 || (code >= 9 && code <= 13)
    true
|? code < 160
    false
|? code == 160 || code == 5760 || (code >= 8192 && code <= 8202)
    true
??
    code == 8232 || code == 8233 || code == 8239 || code == 8287 || code == 12288 || code == 65279

.. code = char as U32

━━━━━━━━━━━━━━━━━━━━
+ is-line-terminator Bool
    - char Char

char == '\n' || char == '\r' || (char as U32) == 8232 || (char as U32) == 8233

━━━━━━━━━━━━━━━━━━━━
+ is-ascii-letter Bool
    - char Char

(char >= 'a' && char <= 'z') || (char >= 'A' && char <= 'Z')

━━━━━━━━━━━━━━━━━━━━
+ is-word-char Bool
    - char Char

is-ascii-letter(char) || (char >= '0' && char <= '9') || char == '_'

━━━━━━━━━━━━━━━━━━━━
+ do skip-spaces Index
    - text String
    - start Index

. index = start
while index < text.length && is-js-space(text[index])
    index += 1
= index

━━━━━━━━━━━━━━━━━━━━
+ has-word-at Bool
    - text String
    - index Index
    - word String

` Whether a word starts at a place in text and ends at a word boundary.
|? index + word.length > text.length
    false
|? text[index .. < index + word.length] != word
    false
??
    following == text.length || !is-word-char(text[following])

.. following = index + word.length

━━━━━━━━━━━━━━━━━━━━
+ has-word-boundary-before Bool
    - text String
    - index Index

index == 0 || !is-word-char(text[index - 1])

━━━━━━━━━━━━━━━━━━━━
+ header-key-start Index?
    - trimmed String

` Where the text after an access mark and its whitespace starts, where the line opens with
` `+` or `_` and whitespace and then a non-space.
|? !is-access-header(trimmed)
    null
|? index >= trimmed.length
    null
??
    index

.. index = skip-spaces(trimmed, 1)

━━━━━━━━━━━━━━━━━━━━
+ line-break-for String
    - text String

if text.find("\r\n") != null then "\r\n" else "\n"

━━━━━━━━━━━━━━━━━━━━
+ split-break-lines [String]
    - text String

` Text split at each line break, where `\r\n` and `\n` both break.
strip-carriage-return(each) in text.split("\n")

━━━━━━━━━━━━━━━━━━━━
+ do trim-outer-blank-lines String
    - text String

` Text without the lines of spaces and tabs that open it, and without the line breaks and spaces
` and tabs that close it.
. start Index = 0
while true
    . index = start
    while index < text.length && (text[index] == ' ' || text[index] == '\t')
        index += 1
    if index == text.length
        start = index
        break
    if text[index] == '\n'
        start = index + 1
    else if text[index] == '\r' && index + 1 < text.length && text[index + 1] == '\n'
        start = index + 2
    else
        break

. end = text.length
. cut = end
while true
    . index = cut
    while index > start && (text[index - 1] == ' ' || text[index - 1] == '\t')
        index -= 1
    if index > start && text[index - 1] == '\n'
        index -= 1
        if index > start && text[index - 1] == '\r'
            index -= 1
        cut = index
    else
        break
if start == 0 && cut == text.length
    = text
= if cut > start then text[start .. < cut] else ""

━━━━━━━━━━━━━━━━━━━━
+ without-trailing-line-break String
    - text String

|? text.ends-with("\r\n")
    if text.length > 2 then text[0 .. < text.length - 2] else ""
|? text.ends-with("\n")
    if text.length > 1 then text[0 .. < text.length - 1] else ""
??
    text

━━━━━━━━━━━━━━━━━━━━
+ ends-with-line-break Bool
    - text String

text.length != 0 && text[text.length - 1] == '\n'

━━━━━━━━━━━━━━━━━━━━
+ Formatter

` The formatting of one source, which proposes replacements in the reference's order.
+ source LintSource
+ lengths [Char = Int]
+ candidates [FormatCandidate]
_ kinds [FormatLine]
_ line-break String

────────────────────
+ This
    - source LintSource
    - lengths [Char = Int]

line-break = line-break-for(source.text)
. text = template-text-lines(source.lines)
for index in 0 .. < source.lines.length
    . line = source.lines[index]
    . is-text = text[index] && line.trim().length != 0
    kinds += if is-text then FormatLine(.format-body) else format-line(line)

────────────────────
+ get line-count Index

source.lines.length

────────────────────
+ line-at FormatLine
    - index Index

if index < kinds.length then kinds[index] else FormatLine(.format-blank)

────────────────────
+ kind-at FormatLineKind
    - index Index

line-at(index).kind

────────────────────
+ text-at String
    - index Index

if index < source.lines.length then source.lines[index] else ""

────────────────────
+ is-divider-at Bool
    - index Index
    - glyph Char

line.kind == .format-divider && line.glyph == glyph

.. line = line-at(index)

────────────────────
+ line-start Index
    - index Index

if index < source.line-starts.length then source.line-starts[index] else source.text.length

────────────────────
+ line-end-including-break Index
    - index Index

line-start(index + 1)

────────────────────
+ line-end Index
    - index Index

line-start(index) + text-at(index).length

────────────────────
+ do line-index-at-offset Index
    - offset Index

. starts = source.line-starts
. low Index = 0
. high = starts.length - 1
while low < high
    . middle = low + (high - low + 1) / 2
    if starts[middle] <= offset
        low = middle
    else
        high = middle - 1
= low

────────────────────
+ line-index-for-number Index
    - number U32

|? number == 0
    0
|? index > last
    last
??
    index

.. last = source.line-starts.length - 1
.. index = (number - 1) as Index

────────────────────
+ do first-non-blank Index?
    - start Index

for index in start .. < line-count
    if kind-at(index) != .format-blank
        = index
= null

────────────────────
+ do previous-non-blank Index?
    - start Index
    - floor Index = 0

` The last line at or before `start` and no earlier than `floor` that is not blank.
. index = start + 1
while index > floor
    index -= 1
    if kind-at(index) != .format-blank
        = index
= null

────────────────────
+ do add
    - start Index
    - end Index
    - replacement String

candidates += FormatCandidate(start, end, replacement)

────────────────────
+ do add-final-newline

. text = source.text
if text.length == 0 || text[text.length - 1] == '\n'
    =
add(text.length, text.length, line-break)

────────────────────
+ do add-divider-shapes

for index in 0 .. < line-count
    . replacement = formatted-divider(index)
    if replacement && replacement != text-at(index)
        add(line-start(index), line-end(index), replacement)

────────────────────
+ formatted-divider String?
    - index Index

|? line.kind != .format-divider
    null
|? line.is-mixed || line.length != expected as Size
    "${line.glyph}" * expected
??
    js-trim(text-at(index))

.. line = line-at(index)
.. expected = lengths[line.glyph] ?? 0

────────────────────
+ do add-function-type-dividers

. end-line Index = line-count
for line in 0 .. < line-count
    if kind-at(line) == .format-divider
        end-line = line
        break

. starts [Index]
. ends [Index]
. texts [String]
. index Index = 0
while index < end-line
    if !is-function-type-header(text-at(index))
        index += 1
        continue
    . start = attached-comment-start(index, 0)
    . signature = scan-signature(index + 1)
    . end = signature.next-index
    starts += start
    ends += end
    texts += trim-outer-blank-lines(joined-lines(start, end, "\n"))
    index = if end > index then end else index + 1
if starts.length == 0
    =

. removed [Bool]
for _ in 0 .. < line-count
    removed += false
for position in 0 .. < starts.length
    for line in starts[position] .. < ends[position]
        if line < line-count
            removed[line] = true
. kept [String]
for line in 0 .. < end-line
    if !removed[line]
        kept += text-at(line)
. kept-text = trim-outer-blank-lines("\n".join(kept))
. pieces [String]
for text in texts
    pieces += "$type-divider$line-break$line-break$text"
. function-text = "$line-break$line-break".join(pieces)
. parts [String]
if kept-text.length != 0
    parts += kept-text
if function-text.length != 0
    parts += function-text
. body = "$line-break$line-break".join(parts)
. replacement = if body.length != 0 then "$body$line-break$line-break" else ""
. start = line-start(0)
. end = if end-line < line-count then line-start(end-line) else source.text.length
if replacement != source.slice(start, end)
    add(start, end, replacement)

────────────────────
+ do joined-lines String
    - start Index
    - end Index
    - separator String

. pieces [String]
for line in start .. < end
    if line < line-count
        pieces += text-at(line)
= separator.join(pieces)

────────────────────
+ do attached-comment-start Index
    - start Index
    - floor Index

. line = start
while line > floor && kind-at(line - 1) == .format-comment
    line -= 1
= line

────────────────────
+ do scan-signature SignatureScan
    - start Index

. index = start
. inline = false
while index < line-count
    . line = text-at(index)
    if inline
        if is-expression-boundary(index)
            break
        index += 1
        continue
    if is-inline-expression-start(line)
        inline = true
        index += 1
        continue
    if !is-signature-continuation(line)
        break
    index += 1
= SignatureScan(index, inline)

────────────────────
+ is-expression-boundary Bool
    - index Index

kind == .format-blank || kind == .format-divider || is-header-kind(kind)

.. kind = kind-at(index)

────────────────────
+ do add-meaningless-dividers

for index in 0 .. < line-count
    if !is-divider-at(index, '━')
        continue

    . content = first-non-blank(index + 1)
    if content && is-divider-at(content, '━')
        . start = line-start(index)
        . end = line-start(content)
        if start < end
            add(start, end, "")
        continue

    if index > 0
        . previous = previous-non-blank(index - 1)
        if previous && kind-at(previous) != .format-declaration-header
            continue

    if content && !is-orphan-divider-follower(text-at(content))
        continue
    if content && is-required-header-after-divider(content)
        continue

    . start = line-start(index)
    . end = if content then line-start(content) else source.text.length
    if start < end
        add(start, end, "")

────────────────────
+ do add-divider-adjacency

for index in 0 .. < line-count
    if !is-divider-at(index, '━') && !is-divider-at(index, '─')
        continue
    if index + 1 >= line-count
        continue

    if kind-at(index + 1) == .format-blank
        . content = first-non-blank(index + 2)
        if content && is-required-header-after-divider(content)
            . start = line-start(index + 1)
            . end = line-start(content)
            if start < end
                add(start, end, "")
        continue

    if !is-required-header-after-divider(index + 1)
        . offset = line-start(index + 1)
        add(offset, offset, line-break)
        continue

    . signature = scan-signature(index + 2)
    if signature.has-inline-expression
        continue
    . body-index = signature.next-index
    . body = kind-at(body-index)
    if body == .format-body || body == .format-markup-open
        . offset = line-start(body-index)
        add(offset, offset, line-break)

────────────────────
+ is-required-header-after-divider Bool
    - index Index

is-required-declaration-header(index) || is-required-event-header(text-at(index))

────────────────────
+ do is-required-declaration-header Bool
    - index Index

. trimmed = js-trim(text-at(index))
if trimmed.length > 1 && trimmed[0] == '•' && is-js-space(trimmed[1])
    = true
if !is-access-header(trimmed)
    = false
if kind-at(index + 1) == .format-declaration-header
    = false

. key = skip-spaces(trimmed, 1)
for word in ["do", "get", "This", "this", "to", "from"]
    if has-word-at(trimmed, key, word)
        = true
for token in ["=>", "==", "!=", "<=", ">="]
    if trimmed.find(token) != null
        = true
for token in ["+=", "-=", "*=", "/=", "%="]
    if key + 2 <= trimmed.length && trimmed[key .. < key + 2] == token
        = true
if has-plain-assignment(trimmed)
    = has-declaration-body(index)
= unbracketed-equals(trimmed).length == 0

────────────────────
+ has-declaration-body Bool
    - index Index

|? signature.has-inline-expression
    true
|? separator == .format-body || separator == .format-markup-open
    true
|? separator != .format-blank
    false
|? !body
    false
??
    kind != .format-divider && kind != .format-declaration-header

.. signature = scan-signature(index + 1)
.. separator = kind-at(signature.next-index)
.. body = first-non-blank(signature.next-index + 1)
.. kind = kind-at(body)

────────────────────
+ do is-function-type-header Bool
    - line String

` Whether a header declares a function type: `+ Name is (...) Result`.
. trimmed = js-trim(line)
. key = header-key-start(trimmed)
if !key
    = false
. position = key + 1
while position + 1 < trimmed.length
    if position > key + 1 && is-line-terminator(trimmed[position - 1])
        = false
    if trimmed[position] == 'i' && trimmed[position + 1] == 's'
        if has-word-boundary-before(trimmed, position)
            if is-function-type-tail(trimmed, position + 2)
                = true
    position += 1
= false

────────────────────
+ do is-function-type-tail Bool
    - text String
    - start Index

. open = skip-spaces(text, start)
if open == start || open >= text.length || text[open] != '('
    = false
. close = open + 1
while close < text.length && text[close] != ')'
    close += 1
if close >= text.length
    = false
. result = skip-spaces(text, close + 1)
= result > close + 1 && result < text.length

────────────────────
+ do is-orphan-divider-follower Bool
    - line String

` Whether a line declares with `is` after its name, which a divider never needs to precede.
. trimmed = js-trim(line)
. key = header-key-start(trimmed)
if !key
    = false
. position = key + 1
while position + 1 < trimmed.length
    if position > key + 1 && is-line-terminator(trimmed[position - 1])
        = false
    if has-word-boundary-before(trimmed, position) && has-word-at(trimmed, position, "is")
        = true
    position += 1
= false

━━━━━━━━━━━━━━━━━━━━
+ do is-inline-expression-start Bool
    - line String

. trimmed = js-trim(line)
for token in ["=", "=?", "<=?", "|?", "|=", "??"]
    if trimmed.starts-with(token)
        if trimmed.length == token.length || is-js-space(trimmed[token.length])
            = true
= false

━━━━━━━━━━━━━━━━━━━━
+ do is-signature-continuation Bool
    - line String

. trimmed = js-trim(line)
if trimmed.length != 0 && (trimmed[0] == '|' || trimmed[0] == '`')
    = true
if line.length == 0 || !is-js-space(line[0])
    = false
if trimmed.length != 0 && trimmed[0] == '-'
    = true
if trimmed.starts-with("...") && (trimmed.length == 3 || is-js-space(trimmed[3]))
    = true
for word in continuation-words()
    if has-word-at(trimmed, 0, word)
        = true
= false

━━━━━━━━━━━━━━━━━━━━
