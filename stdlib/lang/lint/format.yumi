+ do order-spec [String = OrderInfo]
    - sections [[String]]

. infos [String = OrderInfo]
. index = 0
. section = 0
for buckets in sections
    for bucket in buckets
        infos[bucket] = OrderInfo(index, section)
        index += 1
    section += 1
= infos

