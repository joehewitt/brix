────────────────────
+ do format-module

match tree.nodes[tree.root]
    | .node-top-level-syntax(root)
        . body = tree.children[root.statements]
        add-sequence(body, .sequence-module)
        for id in body
            match? tree.nodes[id]
                | .node-class-block(row)
                    if row.is-style-sheet
                        visit-sheet(tree.children[row.members])
                    else
                        visit-type(tree.children[row.members])
                | .node-style-sheet-extension(row)
                    visit-sheet(tree.children[row.body])
                | .node-extension(row)
                    visit-type(tree.children[row.body])
    ?! Panic("AST root has the wrong syntax case")

────────────────────
+ do visit-sheet
    - members [SyntaxId]

add-sequence(members, .sequence-sheet)
for id in members
    match? tree.nodes[id]
        | .node-rule-syntax(row)
            visit-rule(row.body, true)

────────────────────
+ do visit-type
    - members [SyntaxId]

add-sequence(members, .sequence-type)
for id in members
    match? tree.nodes[id]
        | .node-rule-syntax(row)
            visit-rule(row.body, false)

────────────────────
+ do visit-rule
    - body SyntaxId
    - in-sheet Bool

if body == 0
    =
match? tree.nodes[body]
    | .node-block(block)
        . ids = tree.children[block.body]
        add-sequence(ids, rule-body-kind(in-sheet))
        for id in ids
            match? tree.nodes[id]
                | .node-rule-syntax(row)
                    visit-rule(row.body, in-sheet)
                | .node-style-when(row)
                    visit-when(row.body, in-sheet)

────────────────────
+ do visit-when
    - body SyntaxId
    - in-sheet Bool

if body == 0
    =
match? tree.nodes[body]
    | .node-block(block)
        . ids = tree.children[block.body]
        add-sequence(ids, rule-body-kind(in-sheet))
        for id in ids
            match? tree.nodes[id]
                | .node-rule-syntax(row)
                    visit-rule(row.body, in-sheet)

────────────────────
+ rule-body-kind SequenceKind
    - in-sheet Bool

if in-sheet then SequenceKind.sequence-sheet-rule-body else SequenceKind.sequence-rule-body

────────────────────
+ order-of [String = OrderInfo]
    - kind SequenceKind

match kind
    |= .sequence-module
        module-order
    |= .sequence-type
        type-order
    |= .sequence-sheet
        sheet-order
    |= .sequence-sheet-rule-body
        sheet-rule-order
    ??
        rule-order

────────────────────
+ do add-sequence
    - ids [SyntaxId]
    - kind SequenceKind

if ids.length == 0
    =
. order = order-of(kind)
. found = build-line-chunks(ids, kind, order)
if !found
    =
. chunks = found
if chunks.length == 0 || has-overlapping-ranges(chunks)
    =
. index Index = 0
while index < chunks.length
    while index < chunks.length && !is-sortable(chunks[index], order)
        index += 1
    . start = index
    while index < chunks.length && is-sortable(chunks[index], order)
        index += 1
    if start < index
        add-sortable-region(chunks, start, index, order)

────────────────────
+ is-sortable Bool
    - chunk Chunk
    - order [String = OrderInfo]

chunk.bucket.length != 0 && order[chunk.bucket] != null

────────────────────
+ do has-overlapping-ranges Bool
    - chunks [Chunk]

for index in 1 .. < chunks.length
    if chunks[index].start < chunks[index - 1].end
        = true
= false

────────────────────
+ do build-line-chunks [Chunk]?
    - ids [SyntaxId]
    - kind SequenceKind
    - order [String = OrderInfo]

. anchors [ChunkAnchor]
. index Index = 0
while index < ids.length
    . id = ids[index]
    if is-skipped-member(id)
        index += 1
        continue
    if kind == .sequence-type && is-delegates(id)
        . next = delegated-anchor(ids, index, anchors)
        if !next
            = null
        index = next
        continue

    . range = node-line-range(id)
    if !range
        = null
    . attached = attached-start-line(range.start-line, anchor-minimum-line(anchors))
    . end = range.end-line
    if end < attached
        = null
    . bucket = classify(id, attached, end, kind)
    . anchor = ChunkAnchor
        - id
        - bucket
        - anchors.length
        - sort-priority(id, bucket, kind)
        - requires-type-divider(id, bucket)
        - anchor-start-line(bucket, attached, end)
        - anchor-end-line(id, bucket, attached, end)
    if !push-anchor(anchors, anchor)
        = null
    index += 1
= chunks-for-anchors(anchors, order)

────────────────────
+ do delegated-anchor Index?
    - ids [SyntaxId]
    - start Index
    - anchors [ChunkAnchor]

` Bundles a run of delegate declarations with the property after them, and gives the place after
` the property.
. index = start
while index < ids.length && is-delegates(ids[index])
    index += 1
if index >= ids.length || !is-property(ids[index])
    = null
. first = node-line-range(ids[start])
. last = node-line-range(ids[index])
if !first || !last || first.start-line > last.end-line
    = null
. bucket = "delegates-for-properties"
. property = ids[index]
. anchor = ChunkAnchor
    - property
    - bucket
    - anchors.length
    - sort-priority(property, bucket, .sequence-type)
    - false
    - attached-start-line(first.start-line, anchor-minimum-line(anchors))
    - last.end-line
if !push-anchor(anchors, anchor)
    = null
= index + 1

────────────────────
+ do push-anchor Bool
    - anchors [ChunkAnchor]
    - anchor ChunkAnchor

if anchors.length != 0
    . previous = anchors[anchors.length - 1]
    . merges = anchor.bucket == previous.bucket && is-opaque-bucket(anchor.bucket)
    if anchor.start-line <= previous.start-line && !merges
        = false
    if merges
        if anchor.end-line > previous.end-line
            previous.end-line = anchor.end-line
        = true
anchors += anchor
= true

────────────────────
+ anchor-minimum-line Index
    - anchors [ChunkAnchor]

if anchors.length != 0 then anchors[anchors.length - 1].start-line + 1 else 0

────────────────────
+ do chunks-for-anchors [Chunk]?
    - anchors [ChunkAnchor]
    - order [String = OrderInfo]

. chunks [Chunk]
for position in 0 .. < anchors.length
    . anchor = anchors[position]
    . end-line Index? = null
    if position + 1 < anchors.length
        . next = anchors[position + 1]
        if next.start-line > 0
            end-line = lines.previous-non-blank(next.start-line - 1)
    else
        end-line = lines.previous-non-blank(anchor.end-line)
    if !end-line || end-line < anchor.start-line
        = null
    . start = lines.line-start(anchor.start-line)
    . end = lines.line-end-including-break(end-line)
    . text = without-trailing-line-break(lines.source.slice(start, end))
    . shaped = chunk-text(anchor.bucket, text)
    . info = order[anchor.bucket] if anchor.bucket.length != 0
    . order-index = if info then info.index else -1
    . section = if info then info.section else -1
    . member = is-member-function-bucket(anchor.bucket)
    chunks += Chunk
        - start
        - end
        - anchor.bucket
        - anchor.original-index
        - anchor.sort-priority
        - anchor.requires-type-divider
        - shaped
        - order-index
        - section
        - member
= chunks

────────────────────
+ node-line-range LineRange?
    - id SyntaxId

|? end + 1 == start
    LineRange(end, end)
|? end < start
    null
??
    LineRange(start, end)

.. loc = tree.nodes.loc[id]
.. start = lines.line-index-for-number(loc.begin.line + 1)
.. end = lines.line-index-for-number(node-end-number(id))

────────────────────
+ node-end-number U32
    - id SyntaxId

|? body != 0 && body-end > end
    body-end
??
    end

.. end = tree.nodes.loc[id].end.line + 1
.. body = body-of(id)
.. body-end = subtree-end(body) + 1

────────────────────
+ body-of SyntaxId
    - id SyntaxId

match tree.nodes[id]
    | .node-function-syntax(row)
        row.body
    | .node-converter-syntax(row)
        row.body
    | .node-fromverter-syntax(row)
        row.body
    | .node-rule-syntax(row)
        row.body
    | .node-style-when(row)
        row.body
    | .node-when-rule-syntax(row)
        row.body
    | .node-whenever-rule-syntax(row)
        row.body
    | .node-content-block(row)
        row.body
    | .node-markup(row)
        row.body
    ??
        0

────────────────────
+ do subtree-end U32
    - id SyntaxId

` The last line that a node or anything under it reaches, leaving out the places the parser
` gives blocks.
. end = 0u32
. pending [SyntaxId]
pending += id
while pending.length != 0
    . next = pending.pop()
    if !is-block(next)
        . line = tree.nodes.loc[next].end.line
        end = if line > end then line else end
    for child in tree.children-of(next)
        pending += child
= end

────────────────────
+ do attached-start-line Index
    - start Index
    - floor Index

. line = start
while line > floor && is-attached-leading-line(line - 1)
    line -= 1
= attached-section-comment-start(line, floor)

────────────────────
+ is-attached-leading-line Bool
    - index Index

kind == .format-comment || kind == .format-divider || js-trim(lines.text-at(index)) == "≤"

.. kind = lines.kind-at(index)

────────────────────
+ do attached-section-comment-start Index
    - start Index
    - floor Index

if start < floor + 2 || lines.kind-at(start) != .format-divider
    = start
if lines.kind-at(start - 1) != .format-blank || !is-section-comment-line(lines.text-at(start - 2))
    = start
. line = start - 2
while line > floor && is-section-comment-line(lines.text-at(line - 1))
    line -= 1
= line

────────────────────
+ is-block Bool
    - id SyntaxId

match tree.nodes[id]
    | .node-block
        true
    ??
        false

────────────────────
+ is-skipped-member Bool
    - id SyntaxId

match tree.nodes[id]
    | .node-noop
        true
    | .node-implements-declaration
        true
    | .node-using-declaration
        true
    | .node-sees-declaration
        true
    ??
        false

────────────────────
+ is-delegates Bool
    - id SyntaxId

match tree.nodes[id]
    | .node-delegate-declaration
        true
    ??
        false

────────────────────
+ is-property Bool
    - id SyntaxId

match tree.nodes[id]
    | .node-property-syntax
        true
    ??
        false

────────────────────
+ is-type-class Bool
    - id SyntaxId

match tree.nodes[id]
    | .node-class-block(row)
        !row.is-style-sheet
    ??
        false

────────────────────
+ is-function-type-class Bool
    - id SyntaxId

match tree.nodes[id]
    | .node-class-block(row)
        !row.is-style-sheet && is-function-type(row.base)
    ??
        false

────────────────────
+ is-function-type Bool
    - id SyntaxId

id != 0 && is-type-function-node(id)

────────────────────
+ is-type-function-node Bool
    - id SyntaxId

match tree.nodes[id]
    | .node-type-function
        true
    ??
        false

────────────────────
+ do declaration-header-index Index?
    - start Index
    - end Index

for line in start .. end
    if lines.kind-at(line) == .format-declaration-header
        = line
= null

────────────────────
+ do previous-attached-divider Index?
    - start Index

. index = start + 1
while index > 0
    index -= 1
    . kind = lines.kind-at(index)
    if kind == .format-blank || kind == .format-comment
        continue
    = index if kind == .format-divider
= null

────────────────────
+ anchor-start-line Index
    - bucket String
    - attached Index
    - end Index

|? !is-one-line-type-bucket(bucket)
    attached
|? !header || header == 0
    attached
??
    previous-attached-divider(header - 1) ?? attached

.. header = declaration-header-index(attached, end)

────────────────────
+ anchor-end-line Index
    - id SyntaxId
    - bucket String
    - attached Index
    - end Index

|? !is-type-class(id) || !is-one-line-type-bucket(bucket)
    end
??
    declaration-header-index(attached, end) ?? end

────────────────────
+ requires-type-divider Bool
    - id SyntaxId
    - bucket String

(bucket == "public-types" || bucket == "private-types") && is-function-type-class(id)

────────────────────
+ do sort-priority Int
    - id SyntaxId
    - bucket String
    - kind SequenceKind

if kind == .sequence-module
    if bucket != "public-types" || !is-type-class(id)
        = 0
    = if primary-names[normalized-name(class-name(id))] then -1 else 0
if kind != .sequence-type || !index || !is-semantic-callable(id, bucket)
    = 0
. found = index.metadata[id]
= if found then found.priority else 0

────────────────────
+ is-semantic-callable Bool
    - id SyntaxId
    - bucket String

is-semantic-callable-bucket(bucket) && is-callable-node(id)

────────────────────
+ is-callable-node Bool
    - id SyntaxId

match tree.nodes[id]
    | .node-function-syntax
        true
    | .node-converter-syntax
        true
    | .node-fromverter-syntax
        true
    ??
        false

────────────────────
+ class-name String
    - id SyntaxId

match tree.nodes[id]
    | .node-class-block(row)
        row.name.text
    ??
        ""

────────────────────
+ do classify String
    - id SyntaxId
    - start Index
    - end Index
    - kind SequenceKind

` The bucket of a declaration whose lines run from `start` to `end`, or nothing where the
` declaration has no place of its own in the order.
match kind
    |= .sequence-module
        = classify-module-member(id, start, end)
    |= .sequence-type
        = classify-type-member(id, start, end)
    |= .sequence-sheet
        = classify-sheet-member(id)
    |= .sequence-sheet-rule-body
        = classify-sheet-rule-body-member(id)
    ??
        = classify-rule-body-member(id)

────────────────────
+ do classify-module-member String
    - id SyntaxId
    - start Index
    - end Index

match tree.nodes[id]
    | .node-import-syntax
        = "imports"
    | .node-unit-declaration
        = ""
    | .node-property-syntax(row)
        if row.value != 0 && is-state-machine(row.value) && follows-divider(start)
            = "${access-prefix(row.access)}-functions"
        = property-bucket(row, "globals")
    | .node-class-block(row)
        if row.is-style-sheet
            = "style-sheets"
        if is-one-line-unit-type(start, end)
            = ""
        . one-line = one-line-type-bucket(row, start, end)
        if one-line.length != 0
            = one-line
        = "${access-prefix(row.access)}-types"
    | .node-style-sheet-extension
        = "style-sheet-extensions"
    | .node-subscriber-syntax
        = "module-subscriptions"
    | .node-extension(row)
        = "${access-prefix(row.access)}-extensions"
    | .node-function-syntax(row)
        = module-function-bucket(row.access, row.return-type)
    | .node-converter-syntax
        = ""
    | .node-fromverter-syntax
        = ""
    | .node-when-rule-syntax
        = ""
    | .node-whenever-rule-syntax
        = ""
    ??
        = "module-main-body"

────────────────────
+ do follows-divider Bool
    - start Index

` Whether the last line before a member's that is not blank is a divider of three or more of the
` glyphs that divide types and members, alone: a module's machine written so is one of its
` functions.
. index = lines.line-index-at-offset(start)
while index != 0
    index -= 1
    . text = js-trim(lines.text-at(index))
    if text.length != 0
        if text.length < 3
            = false
        for char in text
            if char != '━' && char != '─'
                = false
        = true
= false

────────────────────
+ module-function-bucket String
    - access Access
    - return-type SyntaxId

|? !is-tests-path(lines.source.path)
    "${prefix}-functions"
|? name == "testrender"
    "${prefix}-test-render-functions"
|? name == "testcase"
    "${prefix}-test-case-functions"
|? prefix == "public"
    "test-public-functions"
??
    "${prefix}-functions"

.. prefix = access-prefix(access)
.. name = normalized-name(type-name(return-type))

────────────────────
+ type-name String
    - id SyntaxId

if id == 0 then "" else declared-type-name(id)

────────────────────
+ declared-type-name String
    - id SyntaxId

match tree.nodes[id]
    | .node-type-identifier(row)
        row.name.text
    | .node-core-type-identifier(row)
        row.name.text
    ??
        ""

────────────────────
+ property-bucket String
    - row ASTProperty
    - scope String

|? row.value != 0 && is-state-machine(row.value)
    "${prefix}-state-machine-${scope}"
|? scope == "properties" && row.annotations.count != 0
    "${prefix}-style-properties"
|? row.is-lazy
    "${prefix}-lazy-${scope}"
??
    "${prefix}-${scope}"

.. prefix = access-prefix(row.access)

────────────────────
+ is-state-machine Bool
    - id SyntaxId

match tree.nodes[id]
    | .node-state-machine
        true
    ??
        false

────────────────────
+ one-line-type-bucket String
    - row ASTClassBlock
    - start Index
    - end Index

|? !header || is-function-type(row.base)
    ""
|? signature.has-inline-expression || signature.next-index != header + 1
    ""
|? row.base == 0 && row.or-bases.count == 0
    ""
|? !has-word(js-trim(lines.text-at(header)), "is")
    ""
|? row.members.count != 0
    ""
??
    "${access-prefix(row.access)}-one-line-types"

.. header = declaration-header-index(start, end)
.. signature = lines.scan-signature(header + 1)

────────────────────
+ do is-one-line-unit-type Bool
    - start Index
    - end Index

` Whether a type's header is a one-line unit type: `+ Name(...) is ...`.
. header = declaration-header-index(start, end)
if !header
    = false
. trimmed = js-trim(lines.text-at(header))
. key = header-key-start(trimmed)
if !key
    = false
for open in key + 1 .. < trimmed.length
    if trimmed[open] != '('
        continue
    . close = open + 1
    while close < trimmed.length && trimmed[close] != ')'
        close += 1
    if close >= trimmed.length
        = false
    . word = skip-spaces(trimmed, close + 1)
    if word > close + 1 && has-word-at(trimmed, word, "is")
        = true
= false

────────────────────
+ do classify-type-member String
    - id SyntaxId
    - start Index
    - end Index

match tree.nodes[id]
    | .node-enum-declaration
        = "enum-cases"
    | .node-property-syntax(row)
        = property-bucket(row, "properties")
    | .node-dependency-declaration
        = "dependencies"
    | .node-style-annotation
        = "style-annotations"
    | .node-rule-syntax
        = "style-rules"
    | .node-content-block
        = "content-block"
    | .node-fromverter-syntax(row)
        = if row.access == .public-access then "public-fromverters" else ""
    | .node-converter-syntax(row)
        = if row.access == .public-access then "public-converters" else ""
    | .node-subscriber-syntax
        = "subscriptions"
    | .node-when-rule-syntax
        = "when-rules"
    | .node-whenever-rule-syntax
        = "whenever-rules"
    | .node-function-syntax(row)
        = function-bucket(row, false, false, start, end)
    ??
        = ""

────────────────────
+ do function-bucket String
    - row ASTFunction
    - getter Bool
    - setter Bool
    - start Index
    - end Index

. prefix = access-prefix(row.access)
if row.names.count == 1 && tree.atoms[row.names.start].text == "This"
    = "${prefix}-constructors"
if getter || row.is-getter
    if has-explicit-getter-header(start, end)
        = "${prefix}-getters"
    = "${prefix}-inline-getter-properties"
if setter || row.is-setter
    = "${prefix}-setters"
. operator = operator-token(row, start, end)
if operator.length == 0
    = "${prefix}-methods"
if operator == "[]"
    = "${prefix}-indexers"
if operator == "[]="
    = "${prefix}-index-setters"
if operator == "-=[]"
    = "${prefix}-index-deleters"
if is-prefix-operator(operator)
    = "${prefix}-prefix-operators"
= "${prefix}-operators"

────────────────────
+ has-explicit-getter-header Bool
    - start Index
    - end Index

|? !header
    false
|? !key
    false
|? has-word-at(trimmed, key, "do") && following > key + 2 && has-word-at(trimmed, following, "get")
    true
??
    has-word-at(trimmed, key, "get")

.. header = declaration-header-index(start, end)
.. trimmed = js-trim(lines.text-at(header))
.. key = header-key-start(trimmed)
.. following = skip-spaces(trimmed, key + 2)

────────────────────
+ operator-token String
    - row ASTFunction
    - start Index
    - end Index

|? row.names.count != 1
    ""
??
    header-operator(tree.atoms[row.names.start].text, if header then lines.text-at(header) else "")

.. header = declaration-header-index(start, end)

────────────────────
+ do classify-sheet-member String
    - id SyntaxId

match tree.nodes[id]
    | .node-property-syntax(row)
        . lazy = if row.is-lazy then "lazy-" else ""
        = "${access-prefix(row.access)}-${lazy}slots"
    | .node-rule-syntax
        = "style-rules"
    ??
        = ""

────────────────────
+ do classify-sheet-rule-body-member String
    - id SyntaxId

match tree.nodes[id]
    | .node-assign
        = "style-declarations"
    | .node-style-when
        = "style-when-blocks"
    | .node-rule-syntax
        = "nested-style-rules"
    ??
        = ""

────────────────────
+ do classify-rule-body-member String
    - id SyntaxId

match tree.nodes[id]
    | .node-assign
        = "style-declarations"
    | .node-style-when
        = "style-when-blocks"
    | .node-markup-slot-forward
        = "generated-content-slots"
    | .node-markup(row)
        = if row.slot-binding != 0 then "generated-content-slots" else "content-body"
    | .node-rule-syntax
        = "nested-style-rules"
    ??
        = "content-body"

────────────────────
+ do add-sortable-region
    - chunks [Chunk]
    - first Index
    - last Index
    - order [String = OrderInfo]

` Proposes the chunks from `first` up to `last` in their sorted order, where that moves them.
. start = chunks[first].start
. end = chunks[last - 1].end
. old = lines.source.slice(start, end)
. region [Chunk]
for position in first .. < last
    region += chunks[position]
. rendered = render-sortable-chunks(region, order)
. needs-break = ends-with-line-break(old) && rendered.length != 0
. replacement = if needs-break then rendered + lines.line-break else rendered
if replacement != old
    lines.add(start, end, replacement)

────────────────────
+ do render-sortable-chunks String
    - chunks [Chunk]
    - order [String = OrderInfo]

. sorted = sort(chunks) • using compare-chunks
. line-break = lines.line-break
. parts [String]
. previous Chunk? = null
for chunk in sorted
    . text = render-chunk-text(chunk)
    if previous
        parts += separator-between(previous, chunk, order, text)
    parts += text
    previous = chunk
= "".join(parts)

────────────────────
+ render-chunk-text String
    - chunk Chunk

if !chunk.requires-type-divider || starts-with-divider(chunk.text) then chunk.text else divided

.. divided = "$type-divider${lines.line-break}${lines.line-break}${chunk.text}"

────────────────────
+ separator-between String
    - left Chunk
    - right Chunk
    - order [String = OrderInfo]
    - right-text String

|? right.section != left.section
    double
|? is-style-rule-bucket(left.bucket) && is-style-rule-bucket(right.bucket)
    double
|? starts-with-comment(right-text) || starts-with-divider(right-text)
    double
??
    lines.line-break

.. double = "${lines.line-break}${lines.line-break}"

────────────────────
+ do chunk-text String
    - bucket String
    - text String

= if is-one-line-type-bucket(bucket) then strip-divider-lines(text) else text

────────────────────
+ do strip-divider-lines String
    - text String

. kept [String]
for line in split-break-lines(text)
    if format-kind(line) != .format-divider
        kept += line
= trim-outer-blank-lines(lines.line-break.join(kept))

━━━━━━━━━━━━━━━━━━━━
+ compare-chunks Comparison
    - left Chunk
    - right Chunk

` The order of two chunks: by bucket and then by priority, except that member functions with a
` priority from an interface or base type go by priority first.
|? semantic && left.sort-priority != right.sort-priority
    compare-basic(left.sort-priority, right.sort-priority)
|? left.order-index != right.order-index
    compare-basic(left.order-index, right.order-index)
|? left.sort-priority != right.sort-priority
    compare-basic(left.sort-priority, right.sort-priority)
??
    compare-basic(left.original-index, right.original-index)

.. semantic = has-priority && left.is-member-function && right.is-member-function
.. has-priority = left.sort-priority != 0 || right.sort-priority != 0


━━━━━━━━━━━━━━━━━━━━
+ do first-break-line String
    - text String

. newline = text.find("\n")
if !newline
    = text
. end = newline
if end > 0 && text[end - 1] == '\r'
    end -= 1
= if end > 0 then text[0 .. < end] else ""

━━━━━━━━━━━━━━━━━━━━
+ starts-with-comment Bool
    - text String

format-kind(first-break-line(text)) == .format-comment

━━━━━━━━━━━━━━━━━━━━
+ do starts-with-divider Bool
    - text String

. split = split-break-lines(text)
. index Index = 0
while index < split.length && is-section-comment-line(split[index])
    index += 1
if index > 0 && index < split.length && format-kind(split[index]) == .format-blank
    index += 1
= index < split.length && format-kind(split[index]) == .format-divider

━━━━━━━━━━━━━━━━━━━━
+ is-style-rule-bucket Bool
    - bucket String

bucket == "style-rules" || bucket == "nested-style-rules"

━━━━━━━━━━━━━━━━━━━━
+ is-opaque-bucket Bool
    - bucket String

bucket == "module-main-body" || bucket == "content-body"

━━━━━━━━━━━━━━━━━━━━
+ is-one-line-type-bucket Bool
    - bucket String

bucket == "public-one-line-types" || bucket == "private-one-line-types"

━━━━━━━━━━━━━━━━━━━━
+ do is-member-function-bucket Bool
    - bucket String

for name in member-function-buckets()
    if name == bucket
        = true
= false

━━━━━━━━━━━━━━━━━━━━
+ do is-semantic-callable-bucket Bool
    - bucket String

for name in semantic-callable-buckets()
    if bucket == name
        = true
= false

━━━━━━━━━━━━━━━━━━━━
+ semantic-callable-buckets [String]

* "public-getters"
* "public-setters"
* "public-operators"
* "public-indexers"
* "public-index-setters"
* "public-index-deleters"
* "public-prefix-operators"
* "public-methods"

━━━━━━━━━━━━━━━━━━━━
+ access-prefix String
    - access Access

if access == .public-access then "public" else "private"

━━━━━━━━━━━━━━━━━━━━
+ do has-word Bool
    - text String
    - word String

for position in 0 .. < text.length
    if has-word-boundary-before(text, position) && has-word-at(text, position, word)
        = true
= false

━━━━━━━━━━━━━━━━━━━━
+ do normalized-name String
    - name String

. text String
for char in name
    if is-ascii-letter(char) || (char >= '0' && char <= '9')
        text += lower-ascii(char)
= text

━━━━━━━━━━━━━━━━━━━━
+ lower-ascii Char
    - char Char

if char >= 'A' && char <= 'Z' then ((char as U32) + 32) as Char else char

━━━━━━━━━━━━━━━━━━━━
+ do is-tests-path Bool
    - path String

` Whether a path has a `tests` folder in it, which the reference finds by its separators.
. start Index = 0
while true
    . found = path.find("tests", start)
    if !found
        = false
    . at-start = found == 0 || path[found - 1] == '/' || path[found - 1] == '\\'
    . following = found + 5
    if at-start && following < path.length && (path[following] == '/' || path[following] == '\\')
        = true
    start = found + 1
= false

━━━━━━━━━━━━━━━━━━━━
+ do primary-type-names [String = Bool]
    - path String

` The names that a source's file names its primary types by: the file's stem, and the stem as a
` singular where it ends in `ies` or `s`.
. names [String = Bool]
. stem = normalized-name(file-stem(path))
if stem.length == 0
    = names
names[stem] = true
if stem.ends-with("ies") && stem.length > 3
    names["${stem[0 .. < stem.length - 3]}y"] = true
if stem.ends-with("s") && stem.length > 1
    names[stem[0 .. < stem.length - 1]] = true
= names

━━━━━━━━━━━━━━━━━━━━
+ do file-stem String
    - path String

. start Index = 0
for index in 0 .. < path.length
    if path[index] == '/' || path[index] == '\\'
        start = index + 1
. name = if start < path.length then path[start ...] else ""
. dot = name.find-reverse(".")
= if dot && dot > 0 then name[0 .. < dot] else if dot then "" else name

━━━━━━━━━━━━━━━━━━━━
+ do header-operator String
    - name String
    - header String

` The operator a type function named `name` overloads, written as the reference names it, from the
` header line that declares it, or nothing, as for the function that calls a value.
if name == "()"
    = ""
if name == "[]" || name == "[]=" || name == "-=[]"
    = name
. trimmed = js-trim(header)
. key = header-key-start(trimmed)
if !key
    = ""
. position = after-function-modifiers(trimmed, key)
if has-this-at(trimmed, position)
    = name
for prefix in ["!", "-=", "-", "<-"]
    . following = position + prefix.length
    if following <= trimmed.length && trimmed[position .. < following] == prefix
        if has-this-at(trimmed, skip-spaces(trimmed, following))
            = if name == "-=" then "-=del" else name
= ""

━━━━━━━━━━━━━━━━━━━━
+ brix-header-operator String
    - name String
    - header String

|? name == "()"
    ""
|? name == "[]" || name == "[]=" || name == "-=[]"
    name
|? words.length < 3
    ""
|? words[2] == "(infix"
    name
|? words[2] != "(prefix"
    ""
|? name == "-="
    "-=del"
??
    name

.. words [String] = js-trim(header).split(" ")

━━━━━━━━━━━━━━━━━━━━
+ do after-function-modifiers Index
    - text String
    - start Index

. position = start
if has-word-at(text, position, "static")
    . following = skip-spaces(text, position + 6)
    if following > position + 6
        position = following
if has-word-at(text, position, "do")
    . following = skip-spaces(text, position + 2)
    if following > position + 2
        position = following
= position

━━━━━━━━━━━━━━━━━━━━
+ has-this-at Bool
    - text String
    - position Index

|? position + 4 > text.length || text[position .. < position + 4] != "this"
    false
??
    following == text.length || !is-name-char(text[following])

.. following = position + 4

━━━━━━━━━━━━━━━━━━━━
+ is-name-char Bool
    - char Char

is-word-char(char) || char == '-'

━━━━━━━━━━━━━━━━━━━━
+ is-prefix-operator Bool
    - operator String

operator == "!" || operator == "-=del" || operator == "-neg" || operator == "<-read"

━━━━━━━━━━━━━━━━━━━━
+ is-header-kind Bool
    - kind FormatLineKind

kind == .format-declaration-header || kind == .format-event-header
