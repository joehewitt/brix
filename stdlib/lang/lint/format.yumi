━━━━━━━━━━━━━━━━━━━━
+ do has-plain-assignment Bool
    - line String

` Whether a line has an `=` outside brackets that no operator character opens and that is not
` `==` or `=>`.
for index in unbracketed-equals(line)
    if index > 0 && is-assignment-prefix(line[index - 1])
        continue
    if index + 1 < line.length && (line[index + 1] == '=' || line[index + 1] == '>')
        continue
    = true
= false

━━━━━━━━━━━━━━━━━━━━
+ do unbracketed-equals [Index]
    - line String

. places [Index]
. depth Size = 0
for index in 0 .. < line.length
    . char = line[index]
    if char == '[' || char == '('
        depth += 1
    else if (char == ']' || char == ')') && depth > 0
        depth -= 1
    else if char == '=' && depth == 0
        places += index
= places

━━━━━━━━━━━━━━━━━━━━
+ do is-assignment-prefix Bool
    - char Char

for prefix in "!<>=+-*/%"
    if char == prefix
        = true
= false

━━━━━━━━━━━━━━━━━━━━
+ do is-required-event-header Bool
    - line String

. trimmed = js-trim(line)
for word in ["when", "whenever", "on"]
    if has-word-at(trimmed, 0, word)
        = true
if !has-word-at(trimmed, 0, "for")
    = false
. position Index = 4
while position + 1 < trimmed.length
    if is-line-terminator(trimmed[position - 1])
        = false
    if has-word-boundary-before(trimmed, position) && has-word-at(trimmed, position, "on")
        = true
    position += 1
= false

