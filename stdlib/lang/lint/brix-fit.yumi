./brix-shapes
./brix-source
./diagnostics
./source
/core/table
/data/diff
/data/sexp
/data/source-sexp
/data/source-tree
/lang/brix/brix-print
/lang/brix/build
/lang/brix/convert
/lang/brix/layout
/stream/aggregate

_ brix-fit-depth Size = 5
_ brix-fit-title = "Write the long rows over several rows"

━━━━━━━━━━━━━━━━━━━━
_ BrixFitter

_ store SourceStore
_ max Size
_ depth Size?
_ printer BrixPrinter
+ scope ImmutableTableRow'SourceNode? = null

────────────────────
+ This
    - store
    - max
    - depth

.. printer = BrixPrinter(store)

────────────────────
+ do fitted ImmutableTableRow'SourceNode?
    - node ImmutableTableRow'SourceNode
    - indent Size

for made in candidates(node)
    if width(made, indent) <= max
        . done = settle(made, indent)
        =? done if done
= null

────────────────────
+ do settle ImmutableTableRow'SourceNode?
    - node ImmutableTableRow'SourceNode
    - indent Size

=? node if store.is-comment(node)
=? fitted(node, indent) if width(node, indent) > max
printer.scan-row(node)
=? null if printer.armed
. holder = printer.holder
=? node if !holder || store.is-form(holder, "paragraph")
=? null if depth != null && indent == depth
. start = printer.start
. items = store.listed(holder)
. is-changed = false
for index in start .. < items.length
    . done = settle(items[index], indent + 1)
    =? null if !done
    if done.index != items[index].index
        items[index] = done
        is-changed = true
=? node if !is-changed
= store.replaced(node, holder.id, store.with-items(holder, items))

────────────────────
+ do width Size
    - node ImmutableTableRow'SourceNode
    - indent Size

= printer.row(node).length + indent * 4

────────────────────
_ do candidates [ImmutableTableRow'SourceNode]
    - node ImmutableTableRow'SourceNode

. made [ImmutableTableRow'SourceNode]
=? made if has-null-fallback(node, false)
. items = store.listed(node)
if store.is-form(node, "prop")
    . last = items[items.length - 1]
    =? made if items.length < 4 || !store.is-form(last, "=") || store.count(last) != 2
    for value in values(store.item(last, 1), true, true)
        . given = List'(ImmutableTableRow'SourceNode)(store.item(last, 0), value)
        made += with-value(node, items, items.length - 1, store.with-items(last, given))
    = made
. spot = slot(node) ?? 0
if spot == 0
    . call = block-call(node)
    if call
        made += call
    . exit = guard(node)
    if exit
        made += exit
    = made
. head = store.head(node) ?? ""
. is-held = head == "let" || head == "lazy" || (head == "=" && is-local(node))
for value in values(items[spot], is-held || head == "return", is-held)
    made += with-value(node, items, spot, value)
= made

────────────────────
_ do values [ImmutableTableRow'SourceNode]
    - value ImmutableTableRow'SourceNode
    - decides Bool
    - lowers Bool

. made [ImmutableTableRow'SourceNode]
. text = text-block(value)
if text
    made += text
. call = block-call(value)
if call
    made += call
. choice = if decides then decision(value) else null
if choice
    made += choice
if lowers && !store.is-form(value, "block")
    made += store.list(List'(ImmutableTableRow'SourceNode)(store.atom("block"), value))
= made

────────────────────
_ do has-null-fallback Bool
    - node ImmutableTableRow'SourceNode
    - is-coalesced Bool

=? false if store.is-atom(node) || store.is-text(node)
. items = store.listed(node)
=? false if items.length < 2
. is-fallback = store.is-form(node, "if-expr") && items.length == 4 && is-null(items[3])
=? true if is-fallback && !is-coalesced
. is-coalescing = store.is-form(node, "??")
= some(1 .. < items.length) • where has-null-fallback(items[each], is-coalescing && each < items.length - 1)

────────────────────
_ is-null Bool
    - node ImmutableTableRow'SourceNode

store.is-atom(node) && store.text(node) == "null"

────────────────────
_ do is-local Bool
    - node ImmutableTableRow'SourceNode

. target = store.item(node, 1)
. root = scope
=? false if !root || !store.is-atom(target)
= visible(root, node.id, store.text(target), false) ?? false

────────────────────
_ do visible Bool?
    - node ImmutableTableRow'SourceNode
    - id U32
    - name String
    - known Bool

=? known if node.id == id
=? null if store.is-atom(node) || store.is-text(node)
. holds = holds-statements(node)
. seen = known && holds
for item in store.listed(node)
    . found = visible(item, id, name, seen)
    =? found if found != null
    if holds && declares(item, name)
        seen = true
= null

────────────────────
_ holds-statements Bool
    - node ImmutableTableRow'SourceNode

is-body || is-branch || is-arm || is-loop || is-guarded

.. head = store.head(node) ?? ""
.. is-body = head == "fn-do" || head == "main" || head == "block" || head == "do" || head == "=>"
.. is-branch = head == "if" || head == "else-if" || head == "else" || head.starts-with("match")
.. is-arm = head.starts-with("case") || head == "default"
.. is-loop = head == "for" || head == "while" || head.starts-with("subscribe")
.. is-guarded = head == "do-use" || head == "do-new-thread" || head == "on-error" || head == "finally"

────────────────────
_ declares Bool
    - node ImmutableTableRow'SourceNode
    - name String

is-binding && store.is-atom(target) && store.text(target) == name

.. is-binding = (store.is-form(node, "let") || store.is-form(node, "param")) && store.count(node) >= 2
.. target = store.item(node, 1)

────────────────────
_ do with-value ImmutableTableRow'SourceNode
    - node ImmutableTableRow'SourceNode
    - items [ImmutableTableRow'SourceNode]
    - spot Size
    - value ImmutableTableRow'SourceNode

. made = items
made[spot] = value
= store.with-items(node, made)

────────────────────
_ slot Size?
    - node ImmutableTableRow'SourceNode

|? head == "let" || head == "lazy"
    if count == 4 || (count == 3 && !brix-is-type-form(store, store.item(node, 2))) then count - 1 else null
|? head == "return" || head == "arg" || head == "item"
    if count == 2 then 1 else null
|? count == 3 && brix-precedence(head) == brix-precedence("=")
    2
??
    null

.. head = store.head(node) ?? ""
.. count = store.count(node)

────────────────────
_ do block-call ImmutableTableRow'SourceNode?
    - node ImmutableTableRow'SourceNode

=? null if !store.is-form(node, "call") || store.count(node) < 3
. items = store.listed(node)
. last = items[items.length - 1]
=? null if items.length == 3 && store.is-form(last, "block")
. args = List'(ImmutableTableRow'SourceNode)(store.atom("block"))
for index in 2 .. < items.length
    . item = items[index]
    if index + 1 == items.length && store.is-form(item, "block")
        for inner in store.listed(item, 1)
            =? null if !store.is-form(inner, "arg")
            args += inner
    else
        =? null if !is-positional(item)
        args += store.list(List'(ImmutableTableRow'SourceNode)(store.atom("arg"), item))
= store.with-items(node, List'(ImmutableTableRow'SourceNode)(items[0], items[1], store.list(args)))

────────────────────
_ do guard ImmutableTableRow'SourceNode?
    - node ImmutableTableRow'SourceNode

=? null if !store.is-form(node, "return-if")
. items = store.listed(node)
. test = items[items.length - 1]
=? null if items.length > 3 || !store.is-form(test, "if") || store.count(test) != 2
. exit = List'(ImmutableTableRow'SourceNode)(store.atom("return"))
if items.length == 3
    exit += items[1]
. made = List'(ImmutableTableRow'SourceNode)(store.atom("if"), store.item(test, 1), store.list(exit))
= store.with-items(node, made)

────────────────────
_ do text-block ImmutableTableRow'SourceNode?
    - node ImmutableTableRow'SourceNode

if store.is-form(node, "++") && store.count(node) >= 3
    . items = store.listed(node)
    . block = text-block(items[items.length - 1])
    =? null if !block
    items[items.length - 1] = block
    = store.with-items(node, items)
. parts [ImmutableTableRow'SourceNode]
if store.is-text(node)
    parts += node
else if store.is-form(node, "str")
    parts = store.listed(node, 1)
else
    = null
. lines = List'(ImmutableTableRow'SourceNode)(store.atom("paragraph"))
. line [ImmutableTableRow'SourceNode]
for part in parts
    if !store.is-text(part)
        line += part
        continue
    . text = store.text(part)
    =? null if text.find("\t") != null || text.find("\r") != null
    . pieces = List(text.split("\n"))
    for index in 0 .. < pieces.length
        if index > 0
            =? null if !is-text-line(line)
            lines += text-line(line)
            line = List'(ImmutableTableRow'SourceNode)()
        if pieces[index].length > 0
            line += store.string(pieces[index])
=? null if !is-text-line(line)
lines += text-line(line)
=? null if store.is-blank(lines[1]) || store.is-blank(lines[lines.length - 1])
= store.with-items(node, lines)

────────────────────
_ is-text-line Bool
    - parts [ImmutableTableRow'SourceNode]

|? parts.length == 0
    true
|? store.is-text(last)
    !store.text(last).ends-with(" ")
??
    true

.. last = parts[parts.length - 1]

────────────────────
_ do text-line ImmutableTableRow'SourceNode
    - parts [ImmutableTableRow'SourceNode]

=? store.blank() if parts.length == 0
=? parts[0] if parts.length == 1 && store.is-text(parts[0])
. items = List'(ImmutableTableRow'SourceNode)(store.atom("str"))
items ++= parts
= store.list(items)

────────────────────
_ do decision ImmutableTableRow'SourceNode?
    - node ImmutableTableRow'SourceNode

=? null if !store.is-form(node, "if-expr") || store.count(node) != 4
. tests [ImmutableTableRow'SourceNode]
. results [ImmutableTableRow'SourceNode]
. rest = node
while store.is-form(rest, "if-expr") && store.count(rest) == 4
    tests += store.item(rest, 1)
    results += store.item(rest, 2)
    rest = store.item(rest, 3)
. subject = subject-of(tests)
. is-match = subject != null && !mentions-it(node)
. arms = List'(ImmutableTableRow'SourceNode)(store.atom(if is-match then "match" else "block"))
if subject && is-match
    arms += subject
for index in 0 .. < tests.length
    . test = if is-match then store.item(tests[index], 2) else tests[index]
    arms += store.list(List'(ImmutableTableRow'SourceNode)(store.atom(if is-match then "case=" else "case?"), test, results[index]))
arms += store.list(List'(ImmutableTableRow'SourceNode)(store.atom("default"), rest))
= store.with-items(node, arms)

────────────────────
_ do subject-of ImmutableTableRow'SourceNode?
    - tests [ImmutableTableRow'SourceNode]

. first = tests[0]
=? null if !store.is-form(first, "==") || store.count(first) != 3
. subject = store.item(first, 1)
=? null if !is-pure(subject)
for test in tests
    =? null if !store.is-form(test, "==") || store.count(test) != 3 || !store.same(store.item(test, 1), subject)
= subject

────────────────────
_ is-pure Bool
    - node ImmutableTableRow'SourceNode

|? store.is-atom(node)
    true
|? store.is-form(node, ".")
    all(store.items(node)[1 ...]) • where is-pure(each)
??
    false

────────────────────
_ mentions-it Bool
    - node ImmutableTableRow'SourceNode

|? store.is-atom(node)
    store.text(node) == "it"
??
    some(store.items(node)) • where mentions-it(each)

────────────────────
_ is-positional Bool
    - node ImmutableTableRow'SourceNode

!(brix-is-keyword-head(head) || head == "entry" || head == "entry?" || head == "block" || head == "inline")

.. head = store.head(node) ?? ""

━━━━━━━━━━━━━━━━━━━━
_ BrixFitted is Tuple

+ unit ImmutableTableRow'SourceNode
+ made ImmutableTableRow'SourceNode
+ fixed [U32]
+ first U32
+ is-main Bool

━━━━━━━━━━━━━━━━━━━━
+ do brix-fit-fixes [U32 = LintFix]
    - source LintSource
    - shapes [BrixRowShape]
    - max Size

. fixes [U32 = LintFix]
. brix = read-brix-source(source)
=? fixes if !brix
for fit in fitted-units(brix, shapes, max, brix-fit-depth)
    . edits [LintTextEdit]
    for id in fit.fixed
        . old = brix.store.find(fit.unit, id)
        . new = brix.store.find(fit.made, id)
        if old && new
            edits += brix.edit(old, old, brix.text-of(new, brix.depth-of(old)))
    fixes[fit.first] = LintFix("safe", brix-fit-title, edits)
brix.release()
= fixes

━━━━━━━━━━━━━━━━━━━━
+ do yumi-fit-fixes [U32 = LintFix]
    - source LintSource
    - longs [U32]
    - max Size

. fixes [U32 = LintFix]
. text = catch? brix-convert(source.text)
=? fixes if !text
. shapes = catch? brix-row-shapes(text)
=? fixes if !shapes
. brix = read-brix-source(LintSource(source.path, text))
=? fixes if !brix
. store = brix.store
. view = yumi-rows(text)
. mapped = line-map(source, view)
for fit in fitted-units(brix, shapes, max, null)
    . before = yumi-rows(unit-text(store, fit.unit, fit.is-main))
    . after = yumi-rows(unit-text(store, fit.made, fit.is-main))
    . edits = row-edits(source, view, mapped, before, after)
    . line = first-long(source, edits, longs)
    if line != 0 && reads-as(source, edits, brix, fit)
        fixes[line] = LintFix("safe", brix-fit-title, edits)
brix.release()
= fixes

━━━━━━━━━━━━━━━━━━━━
_ do fitted-units [BrixFitted]
    - brix BrixSource
    - shapes [BrixRowShape]
    - max Size
    - depth Size?

. store = brix.store
. units [ImmutableTableRow'SourceNode]
. scopes [ImmutableTableRow'SourceNode]
. mains [Bool]
for root in brix.roots
    . node = store.node(root)
    if store.is-form(node, "main")
        for item in store.listed(node, 1)
            units += item
            scopes += node
            mains += true
    else
        units += node
        scopes += node
        mains += false
. owners [U32 = Index]
for index in 0 .. < units.length
    own(store, units[index], index, owners)
. fitter = BrixFitter(store, max, depth)
. found [BrixFitted]
for index in 0 .. < units.length
    . held [BrixRowShape]
    for shape in shapes
        if shape.columns > max && !shape.is-text && owners[shape.id] == index
            held += shape
    if held.length != 0
        fitter.scope = scopes[index]
        . fit = fit-unit(store, fitter, units[index], mains[index], held, max, depth)
        if fit
            found += fit
= found

━━━━━━━━━━━━━━━━━━━━
_ do own
    - store SourceStore
    - node ImmutableTableRow'SourceNode
    - unit Index
    - owners [U32 = Index]

owners[node.id] = unit
for item in store.items(node)
    own(store, item, unit, owners)

━━━━━━━━━━━━━━━━━━━━
_ do fit-unit BrixFitted?
    - store SourceStore
    - fitter BrixFitter
    - unit ImmutableTableRow'SourceNode
    - is-main Bool
    - held [BrixRowShape]
    - max Size
    - depth Size?

. made = unit
. fixed [U32]
for shape in held
    . is-covered = some(fixed) • where store.find(store.find(made, each) ?? made, shape.id) != null
    . node = store.find(made, shape.id)
    if node && !is-covered
        . done = fitter.fitted(node, shape.indent)
        if done
            made = store.replaced(made, shape.id, done) ?? made
            fixed += shape.id
=? null if fixed.length == 0
. before = unit-text(store, unit, is-main)
. after = unit-text(store, made, is-main)
=? null if !brix-round-trips(before) || !brix-round-trips(after) || !is-better(before, after, max, depth)
= BrixFitted(unit, made, fixed, held[0].id, is-main)

━━━━━━━━━━━━━━━━━━━━
_ do yumi-rows [String]
    - text String

. view = catch? brix-yumi-text(text)
. rows [String]
=? rows if !view
for line in view.split("\n")
    rows += bare(line)
= rows

━━━━━━━━━━━━━━━━━━━━
_ bare String
    - line String

line[0 .. < end]

.. end = ending(line)

━━━━━━━━━━━━━━━━━━━━
_ do ending Index
    - line String

. end = line.length
while end > 0 && line[end - 1] == ' '
    end -= 1
= end

━━━━━━━━━━━━━━━━━━━━
_ do row-edits [LintTextEdit]
    - source LintSource
    - view [String]
    - mapped [I64]
    - before [String]
    - after [String]

. edits [LintTextEdit]
. none [LintTextEdit]
. anchor = anchored(view, before)
=? none if !anchor
. shift = anchor
. from Index = 0
. diff = diff-document("\n".join(before) as Byte[], "\n".join(after) as Byte[])
. runs = diff.runs
. index Index = 0
while index < runs.length
    if runs[index].kind == DiffKind.equal
        index += 1
        continue
    . old-start = runs[index].old-start
    . new-start = runs[index].new-start
    . old-end = old-start
    . new-end = new-start
    while index < runs.length && runs[index].kind != DiffKind.equal
        . run = runs[index]
        if run.kind == DiffKind.deleted
            old-end = run.old-start + run.count
        else if run.kind == DiffKind.inserted
            new-end = run.new-start + run.count
        else
            = none
        index += 1
    =? none if old-end == old-start || new-end == new-start
    . place = located(view, before, old-start as Index, old-end as Index, from, old-start + shift)
    =? none if !place
    shift = (place as I64) - old-start
    from = place + ((old-end - old-start) as Index)
    . first = mapped[place]
    =? none if first < 0
    for spot in place .. < from
        =? none if mapped[spot] != first + ((spot - place) as I64)
    . replaced [String]
    for spot in new-start .. < new-end
        replaced += after[spot as Index]
    . last = first + ((from - place) as I64) - 1
    edits += line-edit(source, first as Index, last as Index, "\n".join(replaced))
= edits

━━━━━━━━━━━━━━━━━━━━
_ do line-map [I64]
    - source LintSource
    - view [String]

. mapped [I64]
for _ in view
    mapped += -1
. diff = diff-document(source.text as Byte[], "${"\n".join(view)}\n" as Byte[])
. runs = diff.runs
. index Index = 0
while index < runs.length
    . run = runs[index]
    if run.kind == DiffKind.equal
        for offset in 0 .. < run.count
            mapped[(run.new-start + offset) as Index] = run.old-start + offset
        index += 1
        continue
    . old-start = run.old-start
    . new-start = run.new-start
    . old-end = old-start
    . new-end = new-start
    while index < runs.length && runs[index].kind != DiffKind.equal
        . held = runs[index]
        if held.kind == DiffKind.deleted
            old-end = held.old-start + held.count
        else if held.kind == DiffKind.inserted
            new-end = held.new-start + held.count
        index += 1
    if old-end - old-start == new-end - new-start
        for offset in 0 .. < new-end - new-start
            mapped[(new-start + offset) as Index] = old-start + offset
= mapped

━━━━━━━━━━━━━━━━━━━━
_ do anchored I64?
    - lines [String]
    - rows [String]

for index in 0 .. < rows.length
    if rows[index].trim().length > 3
        . place = located(lines, rows, index, index + 1, 0, -1)
        if place
            . others = located(lines, rows, index, index + 1, place + 1, -1)
            =? (place as I64) - (index as I64) if !others
= null

━━━━━━━━━━━━━━━━━━━━
_ do located Index?
    - lines [String]
    - rows [String]
    - start Index
    - end Index
    - from Index
    - near I64

. count = end - start
. found Index? = null
. gap I64 = 0
. place = from
while place + count <= lines.length
    if all(0 .. < count) • where bare(lines[place + each]) == rows[start + each]
        . distance = if (place as I64) > near then (place as I64) - near else near - (place as I64)
        if near < 0
            = place
        if found == null || distance < gap
            found = place
            gap = distance
    place += 1
= found

━━━━━━━━━━━━━━━━━━━━
_ do line-edit LintTextEdit
    - source LintSource
    - first Index
    - last Index
    - replacement String

. start = source.line-starts[first]
. end = source.line-starts[last] + source.lines[last].length
= LintTextEdit(source.utf16-of(start), source.utf16-of(end), replacement, source.slice(start, end))

━━━━━━━━━━━━━━━━━━━━
_ do first-long U32
    - source LintSource
    - edits [LintTextEdit]
    - longs [U32]

for edit in edits
    . start = source.char-of(edit.start)
    . end = source.char-of(edit.end)
    for line in longs
        . at = source.line-starts[(line - 1) as Index]
        =? line if at >= start && at < end
= 0

━━━━━━━━━━━━━━━━━━━━
_ do reads-as Bool
    - source LintSource
    - edits [LintTextEdit]
    - brix BrixSource
    - fit BrixFitted

. text = edited(source, edits)
. back = catch? brix-convert(text)
=? false if !back
. store = brix.store
. read = catch? sexp-read(back, store)
=? false if !read || read.length != brix.roots.length
for index in 0 .. < read.length
    . root = store.node(brix.roots[index])
    . expected = store.replaced(root, fit.unit.id, fit.made) ?? root
    =? false if !is-alike(store, expected, store.node(read[index]))
= true

━━━━━━━━━━━━━━━━━━━━
_ do edited String
    - source LintSource
    - edits [LintTextEdit]

. parts [String]
. at Index = 0
for edit in edits
    . start = source.char-of(edit.start)
    parts += source.slice(at, start)
    parts += edit.replacement
    at = source.char-of(edit.end)
parts += source.slice(at, source.text.length)
= "".join(parts)

━━━━━━━━━━━━━━━━━━━━
_ do unit-text String
    - store SourceStore
    - node ImmutableTableRow'SourceNode
    - is-main Bool

. shown = if is-main then store.list(List'(ImmutableTableRow'SourceNode)(store.atom("main"), node)) else node
= sexp-nested-text(store, shown, BrixLayout(store), 0)

━━━━━━━━━━━━━━━━━━━━
_ do brix-round-trips Bool
    - text String

. view = catch? brix-yumi-text(text)
=? false if !view
. back = catch? brix-convert(view)
=? false if !back
. store = use SourceStore()
. left = catch? sexp-read(text, store)
. right = catch? sexp-read(back, store)
=? false if !left || !right || left.length != right.length
= all(0 .. < left.length) • where is-alike(store, store.node(left[each]), store.node(right[each]))

━━━━━━━━━━━━━━━━━━━━
_ do is-alike Bool
    - store SourceStore
    - left ImmutableTableRow'SourceNode
    - right ImmutableTableRow'SourceNode

=? store.same(left, right) if !store.is-list(left) || !store.is-list(right)
. one = flat(store, left)
. two = flat(store, right)
=? false if one.length != two.length
= all(0 .. < one.length) • where is-alike(store, one[each], two[each])

━━━━━━━━━━━━━━━━━━━━
_ do flat [ImmutableTableRow'SourceNode]
    - store SourceStore
    - node ImmutableTableRow'SourceNode

. items [ImmutableTableRow'SourceNode]
for item in store.items(node)
    if !store.is-blank(item)
        items += item
=? items if items.length < 2 || !store.is-form(node, ".") || !store.is-form(items[1], ".")
. made = flat(store, items[1])
for index in 2 .. < items.length
    made += items[index]
= made

━━━━━━━━━━━━━━━━━━━━
_ do is-better Bool
    - before String
    - after String
    - max Size
    - depth Size?

. old = catch? brix-row-shapes(before)
. new = catch? brix-row-shapes(after)
=? false if !old || !new
=? false if misses(new, max) >= misses(old, max)
= depth == null || deep(new, depth) <= deep(old, depth)

━━━━━━━━━━━━━━━━━━━━
_ do misses Size
    - shapes [BrixRowShape]
    - max Size

. found Size = 0
for shape in shapes
    if !shape.is-text && shape.columns > max
        found += 1
= found

━━━━━━━━━━━━━━━━━━━━
_ do deep Size
    - shapes [BrixRowShape]
    - depth Size

. found Size = 0
. is-deep = false
for shape in shapes
    if shape.is-text
        continue
    . is-over = shape.indent > depth
    if is-over && !is-deep
        found += 1
    is-deep = is-over
= found
