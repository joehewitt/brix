/lang/ast/ast-builder
/lang/ast/brix
/lang/ast/error
/lang/ast/grammar
/lang/target
/stream/aggregate

━━━━━━━━━━━━━━━━━━━━
+ LintSource

+ path String
+ text String
+ lines [String]
+ line-starts [Index]
+ utf16-line-starts [Index]

────────────────────
+ This
    - path String
    - text String

.. lines = split-lines(text)

line-starts += 0
utf16-line-starts += 0
. index Index = 0
. utf16-index Index = 0
for char in text
    index += 1
    utf16-index += if (char as U32) > 65535 then 2 else 1
    if char == '\n'
        line-starts += index
        utf16-line-starts += utf16-index

────────────────────
+ get is-brix Bool

is-brix-path(path)

────────────────────
+ offset-of Index
    - line U32
    - column U32

line-starts[line] + column

────────────────────
+ do utf16-offset Index
    - line U32
    - column U32

` The offset in UTF-16 units of a place given by its line and column from zero.
. offset = utf16-line-starts[line]
. position = line-starts[line]
for char in text[position .. < position + column]
    offset += if (char as U32) > 65535 then 2 else 1
= offset

────────────────────
+ do utf16-of Index
    - offset Index

` The offset in UTF-16 units of a character offset.
. low Index = 0
. high = line-starts.length - 1
while low < high
    . middle = low + (high - low + 1) / 2
    if line-starts[middle] <= offset
        low = middle
    else
        high = middle - 1
= utf16-offset(low as U32, (offset - line-starts[low]) as U32)

────────────────────
+ do char-of Index
    - utf16 Index

` The character offset of an offset in UTF-16 units.
. low Index = 0
. high = utf16-line-starts.length - 1
while low < high
    . middle = low + (high - low + 1) / 2
    if utf16-line-starts[middle] <= utf16
        low = middle
    else
        high = middle - 1
. offset = line-starts[low]
. units = utf16-line-starts[low]
if low < lines.length
    for char in lines[low]
        if units >= utf16
            break
        units += if (char as U32) > 65535 then 2 else 1
        offset += 1
if units < utf16
    = offset + (utf16 - units)
= offset

────────────────────
+ slice String
    - start Index
    - end Index

if end > start then text[start .. < end] else ""

━━━━━━━━━━━━━━━━━━━━
+ is-brix-path Bool
    - path String

path.ends-with(brix-extension)

━━━━━━━━━━━━━━━━━━━━
+ is-lint-path Bool
    - path String

path.ends-with(yumi-extension) || is-brix-path(path)

━━━━━━━━━━━━━━━━━━━━
+ do parse-lint-text ASTBuilder ?! YumiSyntaxError
    - text String
    - path String

=? parse-brix(text, path) if is-brix-path(path)
= parse-yumi(text, path)

━━━━━━━━━━━━━━━━━━━━
+ LineKind is Union

| line-blank
| line-divider
| line-comment
| line-body

━━━━━━━━━━━━━━━━━━━━
+ do split-lines [String]
    - text String

. lines [String]
if text.length == 0
    lines += ""
    = lines

. body = if text.ends-with("\n") then text[0 .. < text.length - 1] else text
if body.length == 0
    lines += ""
    = lines

for line in body.split("\n")
    lines += strip-carriage-return(line)
= lines

━━━━━━━━━━━━━━━━━━━━
+ strip-carriage-return String
    - line String

if line.ends-with("\r") then line[0 .. < line.length - 1] else line

━━━━━━━━━━━━━━━━━━━━
+ classify-line LineKind
    - line String

|? trimmed.length == 0
    .line-blank
|? is-divider-line(trimmed)
    .line-divider
|? trimmed.starts-with("`")
    .line-comment
??
    .line-body

.. trimmed = line.trim()

━━━━━━━━━━━━━━━━━━━━
+ do is-divider-line Bool
    - trimmed String

. all-glyphs = true
for char in trimmed
    all-glyphs = all-glyphs && is-divider-glyph(char)
= all-glyphs || trimmed.starts-with("╌╌╌╌")

━━━━━━━━━━━━━━━━━━━━
+ is-divider-glyph Bool
    - char Char

char == '━' || char == '─' || char == '═' || char == '╌'

━━━━━━━━━━━━━━━━━━━━
+ do template-text-lines [Bool]
    - lines [String]

. text [Bool]
. is-expecting = false
. is-next-text = false
. is-text = false
for line in lines
    . trimmed = line.trim()
    if is-text
        is-text = !is-template-boundary(trimmed)
        text += is-text
    else if is-next-text
        is-next-text = false
        is-text = true
        text += true
    else
        if is-template-header(trimmed)
            is-expecting = true
        else if is-expecting && trimmed.length == 0
            is-expecting = false
            is-next-text = true
        else if is-divider-line(trimmed)
            is-expecting = false
        text += false
= text

━━━━━━━━━━━━━━━━━━━━
_ is-template-header Bool
    - trimmed String

trimmed.length > 2 && is-access && is-space-char(trimmed[1]) && is-marked

.. is-access = trimmed[0] == '+' || trimmed[0] == '_'
.. is-marked = rest.starts-with("¶") && (rest.length == 1 || is-space-char(rest[1]))
.. rest = trimmed[1 .. < trimmed.length].trim()

━━━━━━━━━━━━━━━━━━━━
_ do is-template-boundary Bool
    - trimmed String

=? false if trimmed.length < 3
. glyph = trimmed[0]
=? false if glyph != '━' && glyph != '─' && glyph != '═'
= all(trimmed) • where each == glyph

━━━━━━━━━━━━━━━━━━━━
+ visible-length Size
    - line String

line.length

━━━━━━━━━━━━━━━━━━━━
+ do utf16-length Index
    - text String

. length Index = 0
for char in text
    length += if (char as U32) > 65535 then 2 else 1
= length

━━━━━━━━━━━━━━━━━━━━
+ is-space-char Bool
    - char Char

char == ' ' || char == '\t' || char == '\r' || char == '\n'

━━━━━━━━━━━━━━━━━━━━
+ is-label-char Bool
    - char Char

!is-space-char(char) && char != '╌'
