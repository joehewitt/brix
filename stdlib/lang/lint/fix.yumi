./diagnostics
./format
./linter
./semantic
./source
/os/env
/os/file
/os/path
/stream/sort

_ max-fix-passes = 6

━━━━━━━━━━━━━━━━━━━━
+ FixEdit is Tuple

` A replacement of the text from `start` to `end`, in UTF-16 units, of the file at `path`, which
` holds `expected-text` there, from the rule `rule-id`.
+ path String
+ rule-id String
+ start Index
+ end Index
+ replacement String
+ expected-text String

━━━━━━━━━━━━━━━━━━━━
+ LintFixRun

` A run that lints its files in passes, applying the safe fixes of each pass to the text it holds
` for them, until a pass has none, as the reference's fix run does. It writes the files it changed
` unless it is a dry run, and keeps the diagnostics of the last pass.
+ linter Linter
+ files [String]
+ fix-rules [String]
+ is-dry-run Bool
+ semantic-roots [String]
+ sources [String = LintSource]
+ diagnostics [LintDiagnostic]
+ analysis SemanticAnalysis?
+ fixes = 0
+ passes = 0
+ changed [String]

────────────────────
+ This
    - linter Linter
    - files [String]
    - fix-rules [String]
    - is-dry-run Bool
    - semantic-roots [String]

for file in files
    sources[file] = LintSource(file, read-file-text(Path(file)))

────────────────────
+ do run ?! Error

linter.is-fixing = true
while true
    . edits = lint-pass()
    if edits.length == 0
        break
    if passes >= max-fix-passes
        ?! Error("brix lint --fix did not stabilize after $max-fix-passes passes")
    . applied = apply(edits)
    if applied == 0
        break
    fixes += applied
    passes += 1
if !is-dry-run
    for file in changed
        write-file-atomically(Path(file), sources[file]!.text)

────────────────────
_ do lint-pass [FixEdit] ?! Error

` Lints every file once: the format rule first, and where it changes a file, nothing else in it;
` then the other rules. The safe fixes of the diagnostics come first, and then each formatting
` fix that overlaps none before it.
. formatted [String = Bool]
. format-edits [FixEdit]
. found [String = [LintDiagnostic]]
for file in files
    . source = sources[file]!
    . candidates = format-candidates(source)
    if candidates.length != 0
        formatted[file] = true
        for candidate in candidates
            . start = source.utf16-of(candidate.start)
            . end = source.utf16-of(candidate.end)
            . expected = source.slice(candidate.start, candidate.end)
            . replacement = candidate.replacement
            format-edits += FixEdit(file, "layout/format", start, end, replacement, expected)
        continue
    if linter.has-file-rules()
        found[file] = linter.lint-source(source)

if linter.needs-phase("semantic")
    . texts [String = String]
    for file in files
        texts[file] = sources[file]!.text
    . semantic-ids [String] = each.id in linter.active-rules when each.phase == "semantic"
    . label = if semantic-ids.length == 1 then semantic-ids[0] else "${semantic-ids.length} rules"
    . search-paths [Path] = Path(each) in linter.search-path.split(":")
    . pass-analysis = SemanticAnalysis(linter.project-root, search-paths, false, label)
    pass-analysis.sources = texts
    pass-analysis.analyze(files, semantic-roots, linter.config.semantic-roots)
    analysis = pass-analysis
    if pass-analysis.failed()
        ?! Error(pass-analysis.failure-message())
    for file in files
        if !formatted[file] && pass-analysis.compiled[file]
            . semantic = linter.lint-source(sources[file]!, pass-analysis.facts[file])
            . existing = found[file]
            if existing
                existing ++= semantic
                found[file] = sort(existing) • using compare-diagnostics
            else
                found[file] = semantic

. reported [LintDiagnostic]
. edits [FixEdit]
for file in files
    . list = found[file]
    if !list
        continue
    for diagnostic in list
        reported += diagnostic
        if fix-rules.length != 0 && fix-rules.find(diagnostic.rule-id) == null
            continue
        . fix = diagnostic.fix
        if !fix || fix.kind != "safe"
            continue
        for edit in fix.edits
            edits += FixEdit
                - file
                - diagnostic.rule-id
                - edit.start
                - edit.end
                - edit.replacement
                - edit.expected-text
for edit in format-edits
    if !overlaps-any(edit, edits)
        edits += edit
diagnostics = reported
= edits

────────────────────
_ do format-candidates [FormatCandidate]
    - source LintSource

. empty [FormatCandidate]
if fix-rules.length != 0 && fix-rules.find("layout/format") == null
    = empty
= linter.format-candidates(source)

────────────────────
_ do apply Int ?! Error
    - edits [FixEdit]

` Applies the edits to the text of each file, in order of where they are, skipping those that
` replace text with itself, and counts those that change it.
. by-file [String = [FixEdit]]
. order [String]
for edit in edits
    . source = sources[edit.path]
    if !source
        ?! Error("Fix for ${edit.rule-id} targets ${edit.path}, which is not part of this lint run")
    if edit.start > edit.end
        ?! Error("Invalid fix range for ${edit.rule-id}")
    if edit.end > utf16-length(source.text)
        ?! Error("Fix range for ${edit.rule-id} is outside the source file")
    . list = by-file[edit.path]
    if list
        list += edit
    else
        . created [FixEdit]
        created += edit
        by-file[edit.path] = created
        order += edit.path

. applied = 0
for file in order
    . source = sources[file]!
    . sorted = sort(by-file[file]!) • using compare-edits
    for position in 1 .. < sorted.length
        if sorted[position].start < sorted[position - 1].end
            . previous = sorted[position - 1].rule-id
            . place = relative-report-path(cwd(), file)
            ?! Error("Overlapping fixes from $previous and ${sorted[position].rule-id} in $place")
    . parts [String]
    . cursor Index = 0
    for edit in sorted
        . start = source.char-of(edit.start)
        . end = source.char-of(edit.end)
        . current = source.slice(start, end)
        if current != edit.expected-text
            ?! Error("Fix precondition failed for ${edit.rule-id}")
        parts += source.slice(cursor, start)
        parts += edit.replacement
        cursor = end
        if current != edit.replacement
            applied += 1
    parts += source.slice(cursor, source.text.length)
    . text = "".join(parts)
    if text != source.text
        sources[file] = LintSource(file, text)
        if changed.find(file) == null
            changed += file
= applied

━━━━━━━━━━━━━━━━━━━━
+ compare-edits Comparison
    - left FixEdit
    - right FixEdit

|? left.start != right.start
    compare-basic(left.start, right.start)
??
    compare-basic(left.end, right.end)

━━━━━━━━━━━━━━━━━━━━
+ do overlaps-any Bool
    - edit FixEdit
    - edits [FixEdit]

for existing in edits
    if existing.path == edit.path && edit.start < existing.end && existing.start < edit.end
        = true
= false
