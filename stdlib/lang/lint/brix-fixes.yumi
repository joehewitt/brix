./brix-source
./diagnostics
./source
/core/table
/data/source-tree
/lang/ast/ast
/lang/ast/ast-nodes

━━━━━━━━━━━━━━━━━━━━
+ do brix-lift-fix LintFix?
    - source LintSource
    - tree AST
    - fallback SyntaxId

. read = read-brix-source(source)
=? null if !read
. brix = use read
. store = brix.store
. begin = tree.nodes.loc[fallback].begin
. arm = brix.form-at(begin.line, begin.column)
=? null if !arm || !store.is-form(arm, "default")
. depth = brix.depth-of(arm)
. edit = brix.edit(arm, arm, brix.rows-text(store.listed(arm, 1), depth))
= LintFix("safe", "Lift match fallback assertions", [edit])

━━━━━━━━━━━━━━━━━━━━
+ do brix-null-fallback-fix LintFix?
    - source LintSource
    - tree AST
    - id SyntaxId

. read = read-brix-source(source)
=? null if !read
. brix = use read
. store = brix.store
. begin = tree.nodes.loc[id].begin
. found = brix.form-at(begin.line, begin.column)
=? null if !found || !store.is-form(found, "if-expr") || store.count(found) != 4
. form = found
. fallback = store.item(form, 3)
=? null if !store.is-atom(fallback) || store.text(fallback) != "null"
. guard = store.list([store.atom("if"), store.item(form, 1)])
. made = store.list([store.atom("only-if"), store.item(form, 2), guard])
= LintFix
    - "safe"
    - "Write a conditional value"
    - [brix.edit(form, form, brix.text-of(made, brix.depth-of(form)))]

━━━━━━━━━━━━━━━━━━━━
+ do brix-is-map-literal Bool
    - source LintSource
    - tree AST
    - id SyntaxId

. read = read-brix-source(source)
=? false if !read
. brix = use read
. store = brix.store
. begin = tree.nodes.loc[id].begin
. form = brix.form-at(begin.line, begin.column)
=? false if !form
for item in store.listed(form, 2)
    if store.is-form(item, "block")
        for row in store.listed(item, 1)
            =? true if store.is-form(row, "entry")
= false

━━━━━━━━━━━━━━━━━━━━
+ do brix-map-constructor-fix LintFix?
    - source LintSource
    - tree AST
    - id SyntaxId

. read = read-brix-source(source)
=? null if !read
. brix = use read
. store = brix.store
. begin = tree.nodes.loc[id].begin
. found = brix.form-at(begin.line, begin.column)
=? null if !found || !store.is-form(found, "call") || store.count(found) != 3
. form = found
. block = store.item(form, 2)
=? null if !store.is-form(block, "block")
. rows [ImmutableTableRow'SourceNode]
rows += store.item(block, 0)
for row in store.listed(block, 1)
    =? null if !store.is-form(row, "arg") || store.count(row) != 2
    . pair = store.item(row, 1)
    =? null if !store.is-form(pair, "tuple") || store.count(pair) != 3
    rows += store.list([store.atom("entry"), store.item(pair, 1), store.item(pair, 2)])
. made = store.with-items
    - form
    - [store.item(form, 0), store.item(form, 1), store.with-items(block, rows)]
= LintFix
    - "safe"
    - "Use map literal syntax"
    - [brix.edit(form, form, brix.text-of(made, brix.depth-of(form)))]

━━━━━━━━━━━━━━━━━━━━
+ do brix-initial-entries-fix LintFix?
    - source LintSource
    - tree AST
    - declaration SyntaxId
    - statements [SyntaxId]

. read = read-brix-source(source)
=? null if !read
. brix = use read
. store = brix.store
. begin = tree.nodes.loc[declaration].begin
. found = brix.form-at(begin.line, begin.column)
=? null if !found || !store.is-form(found, "let")
. first = found
. count = store.count(first)
. call = store.item(first, count - 1)
=? null if count < 3 || !store.is-form(call, "call") || store.count(call) != 2
. entries [ImmutableTableRow'SourceNode]
entries += store.atom("block")
. last = first
for statement in statements
    . place = tree.nodes.loc[statement].begin
    . written = brix.form-at(place.line, place.column)
    =? null if !written || !store.is-form(written, "=") || store.count(written) != 3
    . form = written
    =? null if !brix.is-adjacent(last, form)
    . target = store.item(form, 1)
    =? null if !store.is-form(target, "[]") || store.count(target) != 3
    entries += store.list([store.atom("entry"), store.item(target, 2), store.item(form, 2)])
    last = form
. items = store.listed(first)
items[count - 1] = store.with-items
    - call
    - [store.item(call, 0), store.item(call, 1), store.list(entries)]
. made = store.with-items(first, items)
= LintFix
    - "safe"
    - "Use map literal syntax"
    - [brix.edit(first, last, brix.text-of(made, brix.depth-of(first)))]

━━━━━━━━━━━━━━━━━━━━
+ do brix-default-fix LintFix?
    - source LintSource
    - line U32
    - column U32

. read = read-brix-source(source)
=? null if !read
. brix = use read
. store = brix.store
. value = brix.form-at(line - 1, column - 1)
=? null if !value
. parent = brix.parent-of(value)
=? null if !parent
. is-wrapped = store.is-form(parent, "=") && store.count(parent) == 2
. owner = if is-wrapped then brix.parent-of(parent) else parent
=? null if !owner || !(store.is-form(owner, "prop") || store.is-form(owner, "let"))
. kept = store.listed(owner)
. last = kept.pop()
=? null if last.id != (if is-wrapped then parent.id else value.id)
. made = store.with-items(owner, kept)
= LintFix
    - "safe"
    - "Omit redundant default initializer"
    - [brix.edit(owner, owner, brix.text-of(made, brix.depth-of(owner)))]

━━━━━━━━━━━━━━━━━━━━
+ do brix-initializer-fix LintFix?
    - source LintSource
    - line U32
    - column U32
    - name String

. read = read-brix-source(source)
=? null if !read
. brix = use read
. store = brix.store
. found = brix.form-at(line - 1, column - 1)
=? null if !found || !store.is-form(found, "=") || store.count(found) != 3
. target = store.item(found, 1)
. is-named = store.is-atom(target) && store.text(target) == name
. is-this = is-member && has-this && store.text(store.item(target, 2)) == name
    .. is-member = store.is-form(target, ".") && store.count(target) == 3
    .. has-this = store.text(store.item(target, 1)) == "this"
=? null if !is-named && !is-this
. made = store.list([store.atom("lazy"), store.atom(name), store.item(found, 2)])
= LintFix
    - "safe"
    - "Initialize with `..`"
    - [brix.edit(found, found, brix.text-of(made, brix.depth-of(found)))]

━━━━━━━━━━━━━━━━━━━━
+ do brix-suffix-fix LintFix?
    - source LintSource
    - line U32
    - column U32
    - unit String

. read = read-brix-source(source)
=? null if !read
. brix = use read
. store = brix.store
. found = brix.form-at(line - 1, column - 1)
=? null if !found || !store.is-atom(found)
. text = store.text(found)
=? null if text.length <= unit.length || !text.ends-with(unit)
. kept = text[0 .. < text.length - unit.length]
= LintFix("safe", "Remove redundant suffix", [brix.edit(found, found, kept)])
