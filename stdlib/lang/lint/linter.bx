(import ./brix-order)
(import ./brix-rules)
(import ./config)
(import ./diagnostics)
(import ./format)
(import ./method-order)
(import ./rule-context)
(import ./rules)
(import ./semantic-facts)
(import ./semantic-rules)
(import ./source)
(import ./symbols)
(import /lang/ast/ast)
(import /lang/ast/error)
(import /os/file)
(import /os/path)
(import /stream/aggregate)
(import /stream/sort)

(type + Linter
  (prop + project-root String)
  (prop + search-path String)
  (prop + config LintConfig)
  (prop + catalog (list LintRule))
  (prop + active-rules (list LintRule))
  (prop + is-fixing _ (= false))
  (prop _ analyzer SymbolAnalyzer)
  (prop _ declarations DeclarationStore)
  (fn-do + This _
    (param project-root String)
    (param search-path String)
    (param config LintConfig)
    (param catalog (list LintRule))
    (param selected (list String))
    (param semantic Bool (= false))
    (lazy search-paths (list Path) (in (call Path each) (call (. search-path split) ":")))
    (lazy analyzer (call SymbolAnalyzer search-paths))
    (lazy declarations (call DeclarationStore search-paths))
    (blank)
    (for (in rule catalog)
      (if (not ([] (. config rules) (. rule id)))
        (continue)
      )
      (if (and (!= (. selected length) 0) (== (call (. selected find) (. rule id)) null))
        (continue)
      )
      (if (and (== (. rule phase) "semantic") (not semantic))
        (continue)
      )
      (+= active-rules rule)
    )
  )
  (fn-expr + needs-phase Bool
    (param phase String)
    (not (not matching))
    (where
      (lazy matching
        (block
          (spread? active-rules)
          (pipe ?> (== (. each phase) phase))
          (pipe |> first)
        )
      )
    )
  )
  (fn-expr + is-active Bool
    (param id String)
    (not (not matching))
    (where
      (lazy matching
        (block
          (spread? active-rules)
          (pipe ?> (== (. each id) id))
          (pipe |> first)
        )
      )
    )
  )
  (fn-expr + has-file-rules Bool
    (not (not found))
    (where
      (lazy found
        (block
          (spread? active-rules)
          (pipe ?> (!= (. each phase) "semantic"))
          (pipe |> first)
        )
      )
    )
  )
  (fn-do + lint-file (list LintDiagnostic)
    (param file-path String)
    (param facts (? SemanticFacts) (= null))
    (let text (call read-file-text (call Path file-path)))
    (return (call lint-source (call LintSource file-path text) facts))
  )
  (fn-do + lint-source (list LintDiagnostic)
    (param source LintSource)
    (param facts (? SemanticFacts) (= null))
    ; The diagnostics of one pass of the active rules over one file: the static rules, or where the
    ; file's semantic `facts` are given, from a root that typed it, the semantic rules. They are in
    ; the order of where they are and then of their rules, as the reference's are.
    (blank)
    (let relative (call relative-report-path project-root (. source path)))
    (if facts
      (let found (list LintDiagnostic))
      (for (in rule active-rules)
        (if (== (. rule phase) "semantic")
          (let context (call RuleContext relative (. rule id) (!! ([] (. config rules) (. rule id))) is-fixing))
          (call run-semantic-rule (. rule id) source facts context)
          (++= found (. context diagnostics))
        )
      )
      (return (call sort found (:using compare-diagnostics)))
    )
    (blank)
    (let tree (? AST) null)
    (finally
      (if tree
        (call (. tree release))
      )
    )
    (if (or (call needs-phase "ast") (call needs-phase "declaration"))
      (let parsed (catch (call (. analyzer parse-source) source)))
      (if (is parsed YumiSyntaxError)
        (return (call parse-error-diagnostics relative source))
      )
      (= tree (as parsed AST))
    )
    (blank)
    (let analysis (? ModuleAnalysis) null)
    (if (call needs-phase "declaration")
      (= analysis (call (. analyzer analyze) source (!! tree)))
    )
    (blank)
    (let diagnostics (list LintDiagnostic))
    (for (in rule active-rules)
      (let context (call RuleContext relative (. rule id) (!! ([] (. config rules) (. rule id))) is-fixing))
      (if (== (. rule phase) "text")
        (call run-brix-text-rule (. rule id) source context)
        (else-if (== (. rule phase) "ast")
          (call run-ast-rule (. rule id) source (!! tree) context)
        )
        (else-if (== (. rule phase) "declaration")
          (call run-declaration-rule (. rule id) (!! analysis) context)
        )
      )
      (++= diagnostics (. context diagnostics))
    )
    (return (call sort diagnostics (:using compare-diagnostics)))
  )
  (fn-do + format-candidates (list FormatCandidate)
    (param source LintSource)
    ; The formatting fix of a source in a fix run, where the format rule is active: its whole text
    ; as the format writes it, where that differs.
    (let found (list FormatCandidate))
    (if (not (call is-active "layout/format"))
      (return found)
    )
    (let formatted (call brix-format source))
    (if (and formatted (!= formatted (. source text)))
      (+= found (call FormatCandidate 0 (. source text length) formatted))
    )
    (return found)
  )
  (fn-do _ brix-format (? String)
    (param source LintSource)
    (let parsed (catch (call (. analyzer parse-source) source)))
    (return-if (catch? (call brix-formatted (. source text))) (if (is parsed YumiSyntaxError)))
    (let tree (use (as parsed AST)))
    (let declared (catch (call (. declarations module-index) source tree)))
    (let index (only-if (as declared MethodOrderIndex) (if (is declared MethodOrderIndex))))
    (return (call brix-ordered source tree index))
  )
  (fn-do _ parse-error-diagnostics (list LintDiagnostic)
    (param relative String)
    (param source LintSource)
    (let diagnostics (list LintDiagnostic))
    (for (in rule active-rules)
      (if (== (. rule id) "syntax/parse-error")
        (let context (call RuleContext relative (. rule id) (!! ([] (. config rules) (. rule id))) is-fixing))
        (call lint-brix-parse-errors source context)
        (++= diagnostics (. context diagnostics))
      )
    )
    (return diagnostics)
  )
)

(fn-expr + compare-diagnostics Comparison
  (param left LintDiagnostic)
  (param right LintDiagnostic)
  (case? (!= (. left line) (. right line))
    (call compare-basic (. left line) (. right line))
  )
  (case? (!= (. left column) (. right column))
    (call compare-basic (. left column) (. right column))
  )
  (default
    (call compare-basic (. left rule-id) (. right rule-id))
  )
)

(fn-expr + relative-report-path String
  (param project-root String)
  (param file-path String)
  (case? (== file-path project-root)
    ""
  )
  (case? (call (. file-path starts-with) prefix)
    ([] file-path (... (. prefix length)))
  )
  (default
    file-path
  )
  (where
    (lazy prefix (str project-root "/"))
  )
)

(fn-expr + resolve-target String
  (param project-root String)
  (param target String)
  (case? (call (. target starts-with) "/")
    (call strip-trailing-slash target)
  )
  (case? (or (== target ".") (== target "./"))
    project-root
  )
  (case? (call (. target starts-with) "./")
    (call strip-trailing-slash (str project-root "/" ([] target (... 2))))
  )
  (default
    (call strip-trailing-slash (str project-root "/" target))
  )
)

(fn-expr + strip-trailing-slash String
  (param path String)
  (if-expr (and (> (. path length) 1) (call (. path ends-with) "/")) ([] path (..< 0 (- (. path length) 1))) path)
)

(fn-do + discover-lint-files (list String)
  (param project-root String)
  (param targets (list String))
  (let ignore (call load-git-ignore project-root))
  (let files (map String Bool))
  (for (in target targets)
    (call add-target-files project-root (call resolve-target project-root target) files ignore)
  )
  (blank)
  (let found (list String))
  (for (in (tuple path listed) files)
    (+= found path)
  )
  (return (call sort found))
)

(fn-do _ add-target-files _ (?! Error)
  (param project-root String)
  (param target String)
  (param files (map String Bool))
  (param ignore GitIgnore)
  (let target-path (call Path target))
  (if (. target-path is-file)
    (if (call is-lint-path target)
      (= ([] files target) true)
    )
    (return)
  )
  (if (not (. target-path is-dir))
    (return)
  )
  (blank)
  (let relative (call relative-report-path project-root target))
  (if (or (call (. relative starts-with) "..") (call is-ignored-directory-name (. target-path name)))
    (return)
  )
  (blank)
  (for (in entry (. target-path contents))
    (let entry-path (as entry String))
    (let entry-name (. entry name))
    (let entry-relative (call relative-report-path project-root entry-path))
    (if (. entry is-dir)
      (let skipped (or (call is-ignored-directory-name entry-name) (call (. ignore ignores) entry-relative true)))
      (if (or skipped (. (/ entry ".git") exists))
        (continue)
      )
      (call add-target-files project-root entry-path files ignore)
      (else-if (and (. entry is-file) (call is-lint-path entry-name) (not (call (. ignore ignores) entry-relative false)))
        (= ([] files entry-path) true)
      )
    )
  )
)

(fn-expr + is-ignored-directory-name Bool
  (param name String)
  (or (== name ".git") (== name ".ometer") (== name "dist") (== name "node_modules"))
)

(type + GitIgnorePattern
  (prop + negate Bool)
  (prop + directory-only Bool)
  (prop + has-slash Bool)
  (prop + glob String)
  (fn-do + This _
    (param negate Bool)
    (param directory-only Bool)
    (param has-slash Bool)
    (param glob String)
  )
)

(type + GitIgnore
  (prop + patterns (list GitIgnorePattern))
  (fn-do + This _)
  (fn-do + ignores Bool
    (param relative-path String)
    (param is-directory Bool)
    (let normalized (call normalize-ignore-path relative-path))
    (if (== (. normalized length) 0)
      (return false)
    )
    (blank)
    (let ignored false)
    (for (in pattern patterns)
      (if (call matches-git-ignore pattern normalized is-directory)
        (= ignored (not (. pattern negate)))
      )
    )
    (return ignored)
  )
)

(fn-do + load-git-ignore GitIgnore
  (param project-root String)
  (let ignore (call GitIgnore))
  (let path (/ (call Path project-root) ".gitignore"))
  (if (not (. path is-file))
    (return ignore)
  )
  (blank)
  (let text (call read-file-text path))
  (for (in raw-line (call (. text split) "\n"))
    (let parsed (call parse-git-ignore-line (call strip-carriage-return raw-line)))
    (if parsed
      (+= (. ignore patterns) parsed)
    )
  )
  (return ignore)
)

(fn-do + parse-git-ignore-line (? GitIgnorePattern)
  (param raw-line String)
  (let line (call strip-unescaped-trailing-spaces raw-line))
  (if (or (== (. line length) 0) (call (. line starts-with) "#"))
    (return null)
  )
  (blank)
  (let negate false)
  (if (call (. line starts-with) "!")
    (= negate true)
    (= line ([] line (... 1)))
  )
  (if (or (call (. line starts-with) "\\#") (call (. line starts-with) "\\!"))
    (= line ([] line (... 1)))
  )
  (blank)
  (while (call (. line starts-with) "/")
    (= line ([] line (... 1)))
  )
  (let directory-only (call (. line ends-with) "/"))
  (while (call (. line ends-with) "/")
    (= line ([] line (..< 0 (- (. line length) 1))))
  )
  (if (== (. line length) 0)
    (return null)
  )
  (blank)
  (return (call GitIgnorePattern negate directory-only (!= (call (. line find) "/") null) line))
)

(fn-do + strip-unescaped-trailing-spaces String
  (param line String)
  (let end (. line length))
  (while (and (> end 0) (== ([] line (- end 1)) (char " ")))
    (let slashes 0)
    (let index (- end 2))
    (while (and (>= index 0) (== ([] line index) (char "\\")))
      (+= slashes 1)
      (-= index 1)
    )
    (blank)
    (if (== (% slashes 2) 1)
      (break)
    )
    (-= end 1)
  )
  (return ([] line (..< 0 end)))
)

(fn-expr + normalize-ignore-path String
  (param relative-path String)
  (case? (call (. relative-path starts-with) "./")
    ([] relative-path (... 2))
  )
  (default
    relative-path
  )
)

(fn-expr + matches-git-ignore Bool
  (param pattern GitIgnorePattern)
  (param normalized String)
  (param is-directory Bool)
  (case? (and (. pattern directory-only) (not is-directory))
    false
  )
  (default
    (call glob-matches (. pattern glob) 0 subject 0)
  )
  (where
    (lazy subject (if-expr (. pattern has-slash) normalized (. (call Path normalized) name)))
  )
)

(fn-expr + glob-matches Bool
  (param glob String)
  (param g Index)
  (param subject String)
  (param s Index)
  (case? (>= g (. glob length))
    (== s (. subject length))
  )
  (case? (== ([] glob g) '*')
    (call star-matches glob g subject s)
  )
  (case? (>= s (. subject length))
    false
  )
  (case? (== ([] glob g) '?')
    (and (!= ([] subject s) '/') (call glob-matches glob (+ g 1) subject (+ s 1)))
  )
  (default
    (and (== literal ([] subject s)) (call glob-matches glob next subject (+ s 1)))
  )
  (where
    (lazy escaped (and (== ([] glob g) (char "\\")) (< (+ g 1) (. glob length))))
    (lazy literal (if-expr escaped ([] glob (+ g 1)) ([] glob g)))
    (lazy next (if-expr escaped (+ g 2) (+ g 1)))
  )
)

(fn-expr + star-matches Bool
  (param glob String)
  (param g Index)
  (param subject String)
  (param s Index)
  (case? (call glob-matches glob rest subject s)
    true
  )
  (case? (>= s (. subject length))
    false
  )
  (case? (and (not deep) (== ([] subject s) '/'))
    false
  )
  (default
    (call star-matches glob g subject (+ s 1))
  )
  (where
    (lazy deep (and (< (+ g 1) (. glob length)) (== ([] glob (+ g 1)) '*')))
    (lazy rest (if-expr deep (+ g 2) (+ g 1)))
  )
)
