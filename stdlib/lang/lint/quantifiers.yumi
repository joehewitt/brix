./rule-context
./source
/lang/ast/ast
/lang/ast/ast-children
/lang/ast/ast-nodes
/lang/ast/operator
/lang/ast/row-range
/stream/aggregate

━━━━━━━━━━━━━━━━━━━━
+ do lint-quantifiers
    - source LintSource
    - tree AST
    - context RuleContext

. imported = if source.is-brix then "(import /stream/aggregate)" else "/stream/aggregate"
. imports = some(source.lines) • where each.trim() == imported
. definitions = quantifier-definitions(tree)
. attached = attached-nodes(tree)
for id in 1u32 .. < tree.nodes.length
    if !attached[id]
        continue
    do match? tree.nodes[id]
        | .node-block(row)
            report-search-loops(source, tree, row, imports, context)
        | .node-unary-expression(row)
            . quantifier = negated-quantifier(tree, row)
            if quantifier.length != 0 && !is-inside-any(tree, definitions, id as SyntaxId)
                . loc = tree.nodes.loc[id].begin
                context.report(negated-message(quantifier), loc.line + 1, loc.column + 1)

━━━━━━━━━━━━━━━━━━━━
_ do report-search-loops
    - source LintSource
    - tree AST
    - block ASTBlock
    - imports Bool
    - context RuleContext

for position in 0 .. < block.body.count
    . statement = tree.children[block.body.start + position]
    . following = position + 1
    . next = if has-following then tree.children[block.body.start + following] else 0u32
        .. has-following = following < block.body.count
    . found = search-result(tree, statement, next)
    if found.length == 0
        continue
    . status = if imports && is-simple-loop(tree, statement) then "actionable" else "review"
    . line = tree.nodes.loc[statement].begin.line
    context.report(search-message(found), line + 1, indent-column(source, line), status)

━━━━━━━━━━━━━━━━━━━━
+ search-result String
    - tree AST
    - statement SyntaxId
    - next SyntaxId

|? !row || is-subscriber-loop(tree, row.loop)
    ""
|? found.length != 0 && returned.length != 0 && returned != found
    found
??
    ""

.. row = match? tree.nodes[statement]
    | .node-for-block(loop)
        loop
.. exit = match tree.nodes[row.body]
    | .node-block(body)
        if body.body.count == 1 then tree.children[body.body.start] else 0u32
    ??
        0u32
.. found = exit-literal(tree, exit)
.. returned = return-literal(tree, next)

━━━━━━━━━━━━━━━━━━━━
+ is-subscriber-loop Bool
    - tree AST
    - id SyntaxId

match tree.nodes[id]
    | .node-loop-syntax(row)
        row.is-subscriber
    ??
        false

━━━━━━━━━━━━━━━━━━━━
+ exit-literal String
    - tree AST
    - id SyntaxId

match tree.nodes[id]
    | .node-return-if-true(row)
        if row.condition != 0 then boolean-literal(tree, row.expr) else ""
    ??
        ""

━━━━━━━━━━━━━━━━━━━━
+ return-literal String
    - tree AST
    - id SyntaxId

match tree.nodes[id]
    | .node-return(row)
        boolean-literal(tree, row.expr)
    ??
        ""

━━━━━━━━━━━━━━━━━━━━
+ boolean-literal String
    - tree AST
    - id SyntaxId

|? is-named(tree, id, "true")
    "true"
|? is-named(tree, id, "false")
    "false"
??
    ""

━━━━━━━━━━━━━━━━━━━━
+ do is-simple-loop Bool
    - tree AST
    - statement SyntaxId

do match? tree.nodes[statement]
    | .node-for-block(row)
        do match? tree.nodes[row.loop]
            | .node-loop-syntax(loop)
                if loop.container == 0 || loop.clause != 0 || loop.next != 0 || loop.is-match
                    = false
                do match? tree.nodes[loop.pattern]
                    | .node-type-capture(capture)
                        = capture.type == 0 && tree.nodes[capture.id] is .node-identifier
= false

━━━━━━━━━━━━━━━━━━━━
+ do indent-column U32
    - source LintSource
    - line U32

. column = 1u32
for char in source.lines[line]
    if char != ' ' && char != '\t'
        break
    column += 1
= column

━━━━━━━━━━━━━━━━━━━━
+ search-message String
    - found String

|? found == "true"
    "Replace this search loop and the `= false` after it with `some(…) • where …`."
??
    "$all-head $all-tail"

.. all-head = "Replace this search loop and the `= true` after it with"
.. all-tail = "`all(…) • where …`, negating the condition."

━━━━━━━━━━━━━━━━━━━━
+ do quantifier-definitions [SyntaxId]
    - tree AST

. found [SyntaxId]
for id in 1u32 .. < tree.nodes.length
    do match? tree.nodes[id]
        | .node-function-syntax(row)
            for position in 0 .. < row.names.count
                . name = tree.atoms[row.names.start + position].text
                if name == "some" || name == "all"
                    found += id as SyntaxId
= found

━━━━━━━━━━━━━━━━━━━━
+ is-inside-any Bool
    - tree AST
    - holders [SyntaxId]
    - id SyntaxId

some(holders) • where tree.subtree-start(each) <= id && id <= each

━━━━━━━━━━━━━━━━━━━━
+ do negated-quantifier String
    - tree AST
    - row ASTUnaryExpression

. call = match? tree.nodes[row.operand]
    | .node-call-expression(found)
        found
if row.op != .not-op || !call
    = ""
. quantifier = identifier-text(tree, call.callable)
if quantifier != "some" && quantifier != "all"
    = ""
for operand in tree.children[call.operands]
    do match? tree.nodes[operand]
        | .node-argument(argument)
            if (argument.name?.text ?? "") == "where"
                = if negates(tree, where-predicate(tree, argument.expr)) then quantifier else ""
= ""

━━━━━━━━━━━━━━━━━━━━
+ identifier-text String
    - tree AST
    - id SyntaxId

match tree.nodes[id]
    | .node-identifier(row)
        row.name.text
    ??
        ""

━━━━━━━━━━━━━━━━━━━━
+ where-predicate SyntaxId
    - tree AST
    - id SyntaxId

match tree.nodes[id]
    | .node-function-syntax(row)
        single-statement(tree, row.body)
    ??
        0

━━━━━━━━━━━━━━━━━━━━
+ negates Bool
    - tree AST
    - id SyntaxId

match tree.nodes[id]
    | .node-unary-expression(row)
        row.op == .not-op && row.operand != 0
    | .node-binary-expression(row)
        row.op == .not-equals-op
    ??
        false

━━━━━━━━━━━━━━━━━━━━
+ negated-message String
    - quantifier String

"Write `$opposite(…) • where p` instead of `!($quantifier(…) • where !p)`."

.. opposite = if quantifier == "some" then "all" else "some"
