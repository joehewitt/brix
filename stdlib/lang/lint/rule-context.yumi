./diagnostics
./source
/data/json
/lang/ast/ast
/lang/ast/ast-children
/lang/ast/ast-nodes

━━━━━━━━━━━━━━━━━━━━
+ RuleContext

+ path String
+ options [String = JSON]
+ diagnostics [LintDiagnostic]
+ is-fixing Bool
_ rule-id String

────────────────────
+ This
    - path String
    - rule-id String
    - options [String = JSON]
    - is-fixing Bool = false

────────────────────
+ do report
    - message String
    - line U32
    - column U32
    - status String = "actionable"
    - fix LintFix? = null

diagnostics += LintDiagnostic(path, rule-id, status, message, line, column, fix)

━━━━━━━━━━━━━━━━━━━━
+ counted String
    - count Int
    - singular String
    - plural String

"$count ${if count == 1 then singular else plural}"

━━━━━━━━━━━━━━━━━━━━
+ is-function-node Bool
    - tree AST
    - id SyntaxId

match tree.nodes[id]
    | .node-function-syntax
        true
    | .node-getter-syntax
        true
    | .node-setter-syntax
        true
    ??
        false

━━━━━━━━━━━━━━━━━━━━
+ single-statement SyntaxId
    - tree AST
    - body SyntaxId

match tree.nodes[body]
    | .node-block(row)
        if row.body.count == 1 then tree.children[row.body.start] else 0
    ??
        body

━━━━━━━━━━━━━━━━━━━━
+ do attached-nodes [Bool]
    - tree AST

` Which nodes the root of a tree reaches; the parser leaves nodes it replaced in its table.
. attached [Bool]
for _ in 0 .. < tree.nodes.length
    attached += false
. pending [SyntaxId]
pending += tree.root
attached[tree.root] = true
while pending.length != 0
    . id = pending.pop()
    for child in tree.children-of(id)
        if !attached[child]
            attached[child] = true
            pending += child
= attached

━━━━━━━━━━━━━━━━━━━━
+ node-start Index
    - source LintSource
    - tree AST
    - id SyntaxId

source.offset-of(begin.line, begin.column)

.. begin = tree.nodes.loc[id].begin

━━━━━━━━━━━━━━━━━━━━
+ node-end Index
    - source LintSource
    - tree AST
    - id SyntaxId

source.offset-of(end.line, end.column + 1)

.. end = tree.nodes.loc[id].end

━━━━━━━━━━━━━━━━━━━━
+ node-text String
    - source LintSource
    - tree AST
    - id SyntaxId

source.slice(node-start(source, tree, id), node-end(source, tree, id))

━━━━━━━━━━━━━━━━━━━━
+ text-edit LintTextEdit
    - source LintSource
    - start Index
    - end Index
    - replacement String

` An edit of the text between two character offsets, given in UTF-16 units.
LintTextEdit(source.utf16-of(start), source.utf16-of(end), replacement, source.slice(start, end))

━━━━━━━━━━━━━━━━━━━━
+ is-named Bool
    - tree AST
    - id SyntaxId
    - name String

match tree.nodes[id]
    | .node-identifier(row)
        row.name.text == name
    ??
        false
