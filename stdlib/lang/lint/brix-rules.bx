(import ./brix-fit)
(import ./brix-fix)
(import ./brix-shapes)
(import ./brix-source)
(import ./config)
(import ./diagnostics)
(import ./rule-context)
(import ./source)
(import /code/structure/document)
(import /core/table)
(import /data/sexp)
(import /data/source-sexp)
(import /data/source-tree)
(import /lang/ast/brix)
(import /lang/ast/brix-catalog)
(import /lang/ubrix/layout)
(import /lang/ubrix/ubrix)

(fn-do + lint-brix-width _
  (param source LintSource)
  (param context RuleContext)
  (let max (call option-int (. context options) "max" 100))
  (let shapes (catch? (call brix-row-shapes (. source text))))
  (return-if (if (not shapes)))
  (blank)
  (let fixes (map U32 LintFix))
  (if (. context is-fixing)
    (= fixes (call brix-fit-fixes source shapes max))
  )
  (for (in shape shapes)
    (if (and (> (. shape columns) max) (not (. shape is-text)))
      (let advice
        (paragraph
          "Name a part of it with (let …) or (lazy …), or write its arguments one to a row in a (block …)."
        )
      )
      (call (. context report)
        (block
          (arg
            (paragraph
              (str (. shape shown) " makes a row " (. shape columns) " columns wide, and the limit is " max ". " advice)
            )
          )
          (arg (. shape line))
          (arg (. shape column))
          (arg "actionable")
          (arg ([] fixes (. shape id)))
        )
      )
    )
  )
)

(fn-do + lint-brix-depth _
  (param source LintSource)
  (param context RuleContext)
  (let max (call option-int (. context options) "max" 5))
  (let shapes (catch? (call brix-row-shapes (. source text))))
  (return-if (if (not shapes)))
  (blank)
  (let is-deep false)
  (for (in shape shapes)
    (if (. shape is-text)
      (continue)
    )
    (let is-over (> (. shape indent) max))
    (if (and is-over (not is-deep))
      (let advice "Move the inner rows into a function of their own.")
      (call (. context report)
        (block
          (arg
            (paragraph
              (str (. shape shown) " is nested " (. shape indent) " levels deep, and the limit is " max ". " advice)
            )
          )
          (arg (. shape line))
          (arg (. shape column))
        )
      )
    )
    (= is-deep is-over)
  )
)

(fn-do + lint-brix-parse-errors _
  (param source LintSource)
  (param context RuleContext)
  (let fix (call brix-mend-fix source))
  (let is-first true)
  (for (in report (call brix-reports (. source text)))
    (call (. context report)
      (block
        (arg (. report text))
        (arg (+ (. report place line) 1))
        (arg (+ (. report place column) 1))
        (arg "actionable")
        (arg (only-if fix (if is-first)))
      )
    )
    (= is-first false)
  )
)

(fn-do _ brix-mend-fix (? LintFix)
  (param source LintSource)
  (let store (use (call SourceStore)))
  (let roots (catch? (call sexp-read (. source text) store)))
  (return-if null (if (not roots)))
  (blank)
  (let fixer (call BrixFixer brix-catalog store))
  (let text (call (. fixer rewritten) roots))
  (return-if null (if (or (== (. fixer notes length) 0) (== text (. source text)))))
  (blank)
  (let edit (call LintTextEdit 0 (call utf16-length (. source text)) text (. source text)))
  (return (call LintFix "safe" (str "Mend Brix forms: " (call (. "; " join) (. fixer notes))) (list edit)))
)

(fn-do + brix-formatted String (?! SexpError)
  (param text String)
  (let store (use (call SourceStore)))
  (let roots (call sexp-read text store))
  (let nodes (list (of ImmutableTableRow SourceNode)) (in (call (. store node) each) roots))
  (return (call brix-file-text store nodes))
)

(fn-do + run-brix-text-rule _
  (param rule-id String)
  (param source LintSource)
  (param context RuleContext)
  (if (== rule-id "layout/line-length")
    (call lint-brix-width source context)
  )
  (if (== rule-id "layout/depth")
    (call lint-brix-depth source context)
  )
)
