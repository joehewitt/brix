(import ./diagnostics)
(import ./format)
(import ./linter)
(import ./semantic)
(import ./source)
(import /os/env)
(import /os/file)
(import /os/path)
(import /stream/sort)
(blank)
(prop _ max-fix-passes _ (= 6))

(type + FixEdit (is Tuple)
  ; A replacement of the text from `start` to `end`, in UTF-16 units, of the file at `path`, which
  ; holds `expected-text` there, from the rule `rule-id`.
  (prop + path String)
  (prop + rule-id String)
  (prop + start Index)
  (prop + end Index)
  (prop + replacement String)
  (prop + expected-text String)
)

(type + LintFixRun
  ; A run that lints its files in passes, applying the safe fixes of each pass to the text it holds
  ; for them, until a pass has none, as the reference's fix run does. It writes the files it changed
  ; unless it is a dry run, and keeps the diagnostics of the last pass.
  (prop + linter Linter)
  (prop + files (list String))
  (prop + fix-rules (list String))
  (prop + is-dry-run Bool)
  (prop + semantic-roots (list String))
  (prop + sources (map String LintSource))
  (prop + diagnostics (list LintDiagnostic))
  (prop + analysis (? SemanticAnalysis))
  (prop + fixes _ (= 0))
  (prop + passes _ (= 0))
  (prop + changed (list String))
  (fn-do + This _
    (param linter Linter)
    (param files (list String))
    (param fix-rules (list String))
    (param is-dry-run Bool)
    (param semantic-roots (list String))
    (for (in file files)
      (= ([] sources file) (call LintSource file (call read-file-text (call Path file))))
    )
  )
  (fn-do + run _ (?! Error)
    (= (. linter is-fixing) true)
    (while true
      (let edits (call lint-pass))
      (if (== (. edits length) 0)
        (break)
      )
      (if (>= passes max-fix-passes)
        (throw (call Error (str "brix lint --fix did not stabilize after " max-fix-passes " passes")))
      )
      (let applied (call apply edits))
      (if (== applied 0)
        (break)
      )
      (+= fixes applied)
      (+= passes 1)
    )
    (if (not is-dry-run)
      (for (in file changed)
        (call write-file-atomically (call Path file) (. (!! ([] sources file)) text))
      )
    )
  )
  (fn-do _ lint-pass (list FixEdit) (?! Error)
    ; Lints every file once: the format rule first, and where it changes a file, nothing else in it;
    ; then the other rules. The safe fixes of the diagnostics come first, and then each formatting
    ; fix that overlaps none before it.
    (let formatted (map String Bool))
    (let format-edits (list FixEdit))
    (let found (map String (list LintDiagnostic)))
    (for (in file files)
      (let source (!! ([] sources file)))
      (let candidates (call format-candidates source))
      (if (!= (. candidates length) 0)
        (= ([] formatted file) true)
        (for (in candidate candidates)
          (let start (call (. source utf16-of) (. candidate start)))
          (let end (call (. source utf16-of) (. candidate end)))
          (let expected (call (. source slice) (. candidate start) (. candidate end)))
          (let replacement (. candidate replacement))
          (+= format-edits (call FixEdit file "layout/format" start end replacement expected))
        )
        (continue)
      )
      (if (call (. linter has-file-rules))
        (= ([] found file) (call (. linter lint-source) source))
      )
    )
    (blank)
    (if (call (. linter needs-phase) "semantic")
      (let texts (map String String))
      (for (in file files)
        (= ([] texts file) (. (!! ([] sources file)) text))
      )
      (let semantic-ids (list String) (in (. each id) (. linter active-rules) (when (== (. each phase) "semantic"))))
      (let label (if-expr (== (. semantic-ids length) 1) ([] semantic-ids 0) (str (. semantic-ids length) " rules")))
      (let search-paths (list Path) (in (call Path each) (call (. linter search-path split) ":")))
      (let pass-analysis (call SemanticAnalysis (. linter project-root) search-paths false label))
      (= (. pass-analysis sources) texts)
      (call (. pass-analysis analyze) files semantic-roots (. linter config semantic-roots))
      (= analysis pass-analysis)
      (if (call (. pass-analysis failed))
        (throw (call Error (call (. pass-analysis failure-message))))
      )
      (for (in file files)
        (if (and (not ([] formatted file)) ([] (. pass-analysis compiled) file))
          (let semantic (call (. linter lint-source) (!! ([] sources file)) ([] (. pass-analysis facts) file)))
          (let existing ([] found file))
          (if existing
            (++= existing semantic)
            (= ([] found file) (call sort existing (:using compare-diagnostics)))
            (else
              (= ([] found file) semantic)
            )
          )
        )
      )
    )
    (blank)
    (let reported (list LintDiagnostic))
    (let edits (list FixEdit))
    (for (in file files)
      (let list ([] found file))
      (if (not list)
        (continue)
      )
      (for (in diagnostic list)
        (+= reported diagnostic)
        (if (and (!= (. fix-rules length) 0) (== (call (. fix-rules find) (. diagnostic rule-id)) null))
          (continue)
        )
        (let fix (. diagnostic fix))
        (if (or (not fix) (!= (. fix kind) "safe"))
          (continue)
        )
        (for (in edit (. fix edits))
          (+= edits
            (call FixEdit
              (block
                (arg file)
                (arg (. diagnostic rule-id))
                (arg (. edit start))
                (arg (. edit end))
                (arg (. edit replacement))
                (arg (. edit expected-text))
              )
            )
          )
        )
      )
    )
    (for (in edit format-edits)
      (if (not (call overlaps-any edit edits))
        (+= edits edit)
      )
    )
    (= diagnostics reported)
    (return edits)
  )
  (fn-do _ format-candidates (list FormatCandidate)
    (param source LintSource)
    (let empty (list FormatCandidate))
    (if (and (!= (. fix-rules length) 0) (== (call (. fix-rules find) "layout/format") null))
      (return empty)
    )
    (return (call (. linter format-candidates) source))
  )
  (fn-do _ apply Int (?! Error)
    (param edits (list FixEdit))
    ; Applies the edits to the text of each file, in order of where they are, skipping those that
    ; replace text with itself, and counts those that change it.
    (let by-file (map String (list FixEdit)))
    (let order (list String))
    (for (in edit edits)
      (let source ([] sources (. edit path)))
      (if (not source)
        (throw (call Error (str "Fix for " (. edit rule-id) " targets " (. edit path) ", which is not part of this lint run")))
      )
      (if (> (. edit start) (. edit end))
        (throw (call Error (str "Invalid fix range for " (. edit rule-id))))
      )
      (if (> (. edit end) (call utf16-length (. source text)))
        (throw (call Error (str "Fix range for " (. edit rule-id) " is outside the source file")))
      )
      (let list ([] by-file (. edit path)))
      (if list
        (+= list edit)
        (else
          (let created (list FixEdit))
          (+= created edit)
          (= ([] by-file (. edit path)) created)
          (+= order (. edit path))
        )
      )
    )
    (blank)
    (let applied 0)
    (for (in file order)
      (let source (!! ([] sources file)))
      (let sorted (call sort (!! ([] by-file file)) (:using compare-edits)))
      (for (in position (..< 1 (. sorted length)))
        (if (< (. ([] sorted position) start) (. ([] sorted (- position 1)) end))
          (let previous (. ([] sorted (- position 1)) rule-id))
          (let place (call relative-report-path (call cwd) file))
          (throw (call Error (str "Overlapping fixes from " previous " and " (. ([] sorted position) rule-id) " in " place)))
        )
      )
      (let parts (list String))
      (let cursor Index 0)
      (for (in edit sorted)
        (let start (call (. source char-of) (. edit start)))
        (let end (call (. source char-of) (. edit end)))
        (let current (call (. source slice) start end))
        (if (!= current (. edit expected-text))
          (throw (call Error (str "Fix precondition failed for " (. edit rule-id))))
        )
        (+= parts (call (. source slice) cursor start))
        (+= parts (. edit replacement))
        (= cursor end)
        (if (!= current (. edit replacement))
          (+= applied 1)
        )
      )
      (+= parts (call (. source slice) cursor (. source text length)))
      (let text (call (. "" join) parts))
      (if (!= text (. source text))
        (= ([] sources file) (call LintSource file text))
        (if (== (call (. changed find) file) null)
          (+= changed file)
        )
      )
    )
    (return applied)
  )
)

(fn-expr + compare-edits Comparison
  (param left FixEdit)
  (param right FixEdit)
  (case? (!= (. left start) (. right start))
    (call compare-basic (. left start) (. right start))
  )
  (default
    (call compare-basic (. left end) (. right end))
  )
)

(fn-do + overlaps-any Bool
  (param edit FixEdit)
  (param edits (list FixEdit))
  (for (in existing edits)
    (if (and (== (. existing path) (. edit path)) (< (. edit start) (. existing end)) (< (. existing start) (. edit end)))
      (return true)
    )
  )
  (return false)
)
