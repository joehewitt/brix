(import /core/table)
(import /data/source-tree)
(import /stream/aggregate)
(blank)
(prop _ function-heads _ (= (list "fn-do" "fn-from-do" "fn-to-do")))
(prop _ exit-heads _ (= (list "return" "return?" "return-if" "throw")))
(prop _ yield-heads _ (= (list "yield" "yield?" "yield-all" "yield-all?")))
(prop _ joined-heads _ (= (list "else-if" "else" "and-for" "or-for" "on-error" "on-failure" "default")))
(prop _ branch-heads _ (= (list "if" "else-if" "else" "for" "and-for" "or-for" "while")))
(prop _ task-heads _ (= (list "do" "finally" "do-new" "do-new-thread" "do-use" "do-use?" "do-with")))
(prop _ arm-heads _ (= (list "on-error" "on-failure" "match" "match?" "block")))
(prop _ case-heads _ (= (list "case" "case?" "case=" "case-union" "case-union?" "case-union=" "default")))

(type + BrixSpacing
  (prop _ store SourceStore)
  (fn-do + This _
    (param store _)
  )
  (fn-do + spaced (of ImmutableTableRow SourceNode)
    (param node (of ImmutableTableRow SourceNode))
    (param is-steps Bool)
    (return-if node (if (not (call (. store is-list) node))))
    (blank)
    (let holds (call holds-steps node is-steps))
    (let items (call (. store listed) node))
    (let made (list (of ImmutableTableRow SourceNode)))
    (let is-changed false)
    (for (in index (..< 0 (. items length)))
      (let item ([] items index))
      (let fixed (call spaced item holds))
      (if (!= (. fixed index) (. item index))
        (= is-changed true)
      )
      (+= made fixed)
      (if (and holds (call is-exit item) (< (+ index 1) (. items length)) (call opens-section ([] items (+ index 1))))
        (+= made (call (. store blank)))
        (= is-changed true)
      )
    )
    (return (if-expr is-changed (call (. store with-items) node made) node))
  )
  (fn-expr _ holds-steps Bool
    (param node (of ImmutableTableRow SourceNode))
    (param is-steps Bool)
    (or (has function-heads head) (and (== head "=>") is-doing) (and is-steps is-block))
    (where
      (lazy head (?? (call (. store head) node) ""))
      (lazy is-doing (call some (call (. store listed) node) (:where (call is-do-mark each))))
      (lazy is-block (or (has branch-heads head) (has task-heads head) (has arm-heads head) (has case-heads head)))
    )
  )
  (fn-expr _ is-do-mark Bool
    (param node (of ImmutableTableRow SourceNode))
    (and (call (. store is-atom) node) (== (call (. store text) node) ":do"))
  )
  (fn-expr _ is-exit Bool
    (param node (of ImmutableTableRow SourceNode))
    (or (has exit-heads head) (has yield-heads head))
    (where
      (lazy head (?? (call (. store head) node) ""))
    )
  )
  (fn-expr _ opens-section Bool
    (param node (of ImmutableTableRow SourceNode))
    (not (or (call (. store is-blank) node) (call is-exit node) (has joined-heads head)))
    (where
      (lazy head (?? (call (. store head) node) ""))
    )
  )
)
