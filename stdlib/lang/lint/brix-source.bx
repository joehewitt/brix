(import ./diagnostics)
(import ./source)
(import /core/table)
(import /data/sexp)
(import /data/source-sexp)
(import /data/source-tree)
(import /lang/brix/layout)
(import /stream/aggregate)

(type + BrixSource
  (prop + source LintSource)
  (prop + store SourceStore)
  (prop + roots (list U32))
  (prop _ marks SexpMarks)
  (prop _ placed (map String (of ImmutableTableRow SourceNode)))
  (prop _ parents (map U32 (of ImmutableTableRow SourceNode)))
  (fn-do + This _
    (param source _)
    (param store _)
    (param roots _)
    (param marks _)
    (let place (call BrixCursor (call byte-view (. source text))))
    (for (in root roots)
      (call visit (call (. store node) root) place)
    )
  )
  (fn-do _ visit _
    (param node (of ImmutableTableRow SourceNode))
    (param place BrixCursor)
    (let start (call (. marks start) (. node id)))
    (if (or (> start 0) (== (. placed length) 0))
      (call (. place advance) start)
      (let key (str (. place line) ":" (. place column)))
      (if (not ([] placed key))
        (= ([] placed key) node)
      )
    )
    (for (in item (call (. store items) node))
      (= ([] parents (. item id)) node)
      (call visit item place)
    )
  )
  (fn-expr + begin-using _
    this
  )
  (fn-do + end-using _
    (call release)
  )
  (fn-do + release _
    (call (. store release))
  )
  (fn-expr + form-at (? (of ImmutableTableRow SourceNode))
    (param line U32)
    (param column U32)
    ([] placed (str line ":" column))
  )
  (fn-expr + parent-of (? (of ImmutableTableRow SourceNode))
    (param node (of ImmutableTableRow SourceNode))
    ([] parents (. node id))
  )
  (fn-do + is-adjacent Bool
    (param first (of ImmutableTableRow SourceNode))
    (param next (of ImmutableTableRow SourceNode))
    (let bytes (call byte-view (. source text)))
    (let end (call (. marks end) (. first id)))
    (let start (call (. marks start) (. next id)))
    (return-if false (if (< start end)))
    (return (call all (..< end start) (:where (or (== ([] bytes each) 32) (== ([] bytes each) 10)))))
  )
  (fn-do + depth-of Int
    (param node (of ImmutableTableRow SourceNode))
    (let start (call (. marks start) (. node id)))
    (let bytes (call byte-view (. source text)))
    (let line-start start)
    (while (and (> line-start 0) (!= ([] bytes (- line-start 1)) 10))
      (-= line-start 1)
    )
    (let spaces 0)
    (while (and (< (+ line-start spaces) (. bytes length)) (== ([] bytes (+ line-start spaces)) 32))
      (+= spaces 1)
    )
    (return (/ spaces 2))
  )
  (fn-expr + text-of String
    (param node (of ImmutableTableRow SourceNode))
    (param depth Int)
    (call sexp-nested-text store node (call BrixLayout store) depth)
  )
  (fn-expr + rows-text String
    (param nodes (list (of ImmutableTableRow SourceNode)))
    (param depth Int)
    (call (. (str "\n" (* "  " depth)) join) (in (call text-of each depth) nodes))
  )
  (fn-expr + edit LintTextEdit
    (param first (of ImmutableTableRow SourceNode))
    (param last (of ImmutableTableRow SourceNode))
    (param replacement String)
    (call LintTextEdit start end replacement ([] (. source text) (..< (call (. source char-of) start) (call (. source char-of) end))))
    (where
      (lazy start (call utf16-at (call (. marks start) (. first id))))
      (lazy end (call utf16-at (call (. marks end) (. last id))))
    )
  )
  (fn-do _ utf16-at Index
    (param offset Index)
    (let bytes (call byte-view (. source text)))
    (let units Index 0)
    (for (in index (..< 0 offset))
      (let byte ([] bytes index))
      (if (>= byte 240)
        (+= units 2)
        (else-if (or (< byte 128) (>= byte 192))
          (+= units 1)
        )
      )
    )
    (return units)
  )
)

(fn-do + read-brix-source (? BrixSource)
  (param source LintSource)
  (let store (call SourceStore))
  (let marks (call SexpMarks (. store latest-id)))
  (let roots (catch? (call sexp-read (. source text) store marks)))
  (if (not roots)
    (call (. store release))
    (return null)
  )
  (return (call BrixSource source store roots marks))
)

(type + BrixCursor
  (prop + line U32)
  (prop + column U32)
  (prop _ bytes (of ImmutableArray Byte))
  (prop _ offset Index)
  (fn-do + This _
    (param bytes _)
  )
  (fn-do + advance _
    (param target Index)
    (if (< target offset)
      (= offset 0)
      (= line 0)
      (= column 0)
    )
    (while (< offset target)
      (let byte ([] bytes offset))
      (if (== byte 10)
        (+= line 1)
        (= column 0)
        (else-if (or (< byte 128) (>= byte 192))
          (+= column 1)
        )
      )
      (+= offset 1)
    )
  )
)

(fn-do + brix-file-text String
  (param store SourceStore)
  (param nodes (list (of ImmutableTableRow SourceNode)))
  (let rows (list (of ImmutableTableRow SourceNode)))
  (for (in node nodes)
    (if (call (. store is-form) node "main")
      (++= rows (call (. store listed) node 1))
      (else
        (+= rows node)
      )
    )
  )
  (return (call sexp-text store rows (call BrixLayout store)))
)
