(import ./linter)
(import ./protocol)
(import ./semantic-facts)
(import ./semantic-plan)
(import /data/json)
(import /lang/ast/ast)
(import /lang/ast/ast-children)
(import /lang/ast/ast-nodes)
(import /lang/ast/ast-queries)
(import /lang/ast/decl)
(import /lang/ast/module)
(import /lang/ast/operator)
(import /lang/ast/program)
(import /lang/ast/row-range)
(import /lang/check/facts)
(import /lang/check/instances)
(import /lang/check/parallel-typing)
(import /lang/check/session)
(import /lang/check/type-store)
(import /lang/check/type-text)
(import /lang/check/types)
(import /lang/compiler)
(import /lang/report/facts-text)
(import /os/path)
(import /stream/aggregate)
(import /stream/sort)
(blank)
(prop + semantic-limit _ (= "Module reachability and root compilation do not prove that every generic function was exercised."))
(prop + failed-batch-limit _ (= "No semantic findings are returned from a failed shared compiler batch; successful-root traces are not treated as independent evidence."))

(type + SemanticAnalysis
  ; The facts the semantic rules read, by target path, from typing the roots the plan chose, in the
  ; batches the reference types them in, with the text of each file in `sources` in place of what is
  ; on disk. A target is `compiled` where a root covering it typed with no error; the rules run
  ; only on those. A root whose program does not parse or type has an error, which fails the run as
  ; it fails the reference's. Progress names the semantic rules by `rule-label`.
  (prop + project-root String)
  (prop + planner SemanticPlanner)
  (prop + plan SemanticCoveragePlan)
  (prop + sources (map String String))
  (prop + facts (map String SemanticFacts))
  (prop + compiled (map String Bool))
  (prop + reports-progress Bool)
  (prop + rule-label (? String))
  (fn-do + This _
    (param project-root String)
    (param search-paths (list Path))
    (param reports-progress Bool)
    (param rule-label (? String))
    (lazy planner (call SemanticPlanner project-root search-paths))
    (lazy plan (call SemanticCoveragePlan))
  )
  (fn-expr + failed Bool
    ; Whether a root has an error.
    (not (not failing))
    (where
      (lazy failing
        (block
          (spread? (. plan roots))
          (pipe ?> (. each error))
          (pipe |> first)
        )
      )
    )
  )
  (fn-do + analyze _
    (param targets (list String))
    (param overrides (list String))
    (param configured (list String))
    (call progress "plan" (. targets length))
    (= (. planner sources) sources)
    (= plan (call (. planner plan) targets overrides configured))
    (for (in target (. plan targets))
      (= ([] facts (. target path)) (call SemanticFacts))
    )
    (let index 0)
    (for (in batch (call semantic-root-batches (. plan roots)))
      (for (in root batch)
        (+= index 1)
        (call progress "compile" (. plan roots length) (. root path) index)
      )
      (call type-batch batch)
      (if (and (> (. batch length) 1) (call some batch (:where (!= (. each error) null))))
        (call type-alone batch)
      )
      (call progress "finish" (. batch length) (. ([] batch 0) path))
    )
    (for (in target (. plan targets))
      (for (in root (. plan roots))
        (if (and (. root compiled) (!= (call (. root covers find) (. target path)) null))
          (= ([] compiled (. target path)) true)
        )
      )
    )
  )
  (fn-expr + failure-message String
    ; The message the run fails with, naming each root with an error and the error, as the
    ; reference's does.
    (call (. "\n\n" join) parts)
    (where
      (lazy parts
        (call (of List String)
          (block
            (item "Semantic lint compiler failed.")
            (spread failures)
          )
        )
      )
      (lazy failures
        (case-each (in root (. plan roots) (when (. root error)))
          (str (. root path) ":1\n" (!! (. root error)))
        )
      )
    )
  )
  (fn-do + report JSON
    ; The coverage report the reference gives: which roots were typed and what each covers, which
    ; roots reach and cover each target and how many facts were gathered for it, the targets no root
    ; covers, and the errors. A failed run reports no target covered.
    (let failing (call failed))
    (let roots (list JSON))
    (for (in root (. plan roots))
      (let row
        (call (of Map String JSON)
          (block
            (:path (call relative (. root path)))
            (:covers (in (call relative each) (. root covers)))
            (entry "didCompile" (. root compiled))
            (:reason (. root reason))
            (:error? (only-if (. root error) (if (. root error))))
          )
        )
      )
      (+= roots row)
    )
    (let targets (list JSON))
    (for (in target (. plan targets))
      (let gathered ([] facts (. target path)))
      (let observed (if-expr (and gathered (not failing)) (call (. gathered trace-count)) 0))
      (let covered-by (list JSON))
      (if (not failing)
        (= covered-by (in (call relative each) (. target covered-by)))
      )
      (+= targets
        (call (of Map String JSON)
          (block
            (:path (call relative (. target path)))
            (entry "coveredBy" covered-by)
            (entry "reachableBy" (in (call relative each) (. target reachable-by)))
            (entry "observedTraces" observed)
            (entry "didCompile" (and (?? ([] compiled (. target path)) false) (not failing)))
          )
        )
      )
    )
    (let errors (list JSON))
    (for (in root (. plan roots))
      (if (. root error)
        (+= errors
          (call (of Map String JSON)
            (block
              (:message (. root error))
              (:root (call relative (. root path)))
              (:path (call relative (. root path)))
            )
          )
        )
      )
    )
    (let limits (list JSON))
    (+= limits semantic-limit)
    (if failing
      (+= limits failed-batch-limit)
    )
    (let uncovered (list JSON))
    (if failing
      (= uncovered (in (call relative (. each path)) (. plan targets)))
      (else
        (= uncovered (in (call relative each) (. plan uncovered)))
      )
    )
    (let status (if-expr (!= (. plan uncovered length) 0) "uncovered" "complete"))
    (return
      (call (of Map String JSON)
        (block
          (:status (if-expr failing "error" status))
          (:roots roots)
          (:targets targets)
          (:uncovered uncovered)
          (:errors errors)
          (:limits limits)
        )
      )
    )
  )
  (fn-expr _ relative String
    (param path String)
    (call relative-report-path project-root path)
  )
  (fn-do _ progress _
    (param step String)
    (param total Int)
    (param file (? String) (= null))
    (param index (? Int) (= null))
    (if reports-progress
      (call emit-semantic-progress total (only-if (call relative file) (if file)) index rule-label step)
    )
  )
  (fn-do _ type-batch _
    (param batch (list SemanticRootPlan))
    ; Types the roots of a batch in one program, every module's main and what they reach, and takes
    ; the facts of each instance written in a target. An error of a module goes to each root of the
    ; batch that reaches it, and to all of them where none does.
    (let named (list (tuple String String)))
    (for (in root batch)
      (if (not (. root error))
        (+= named (tuple (. root path) (call (. planner module-name) (. root path))))
      )
    )
    (if (== (. named length) 0)
      (return)
    )
    (let compiler (call BrixCompiler))
    (= (. compiler search-paths) (. planner search-paths))
    (= (. compiler sources) sources)
    (let built (catch (call (. compiler batch-to-ast) named)))
    (if (is built Error)
      (call fail-batch batch (. (as built Error) message))
      (return)
    )
    (let program (use (as built Program)))
    (let session (use (call Session program)))
    (= (. session facts traces-lint) true)
    (call type-program session)
    (let text (call FactsText session))
    (let failing false)
    (for (in position (..< 0 (. program modules length)))
      (let module (as position ModuleId))
      (let parts (list String))
      (let report (call (. text rendered-diagnostics) module))
      (if (!= (. report length) 0)
        (+= parts report)
      )
      (let declines (call (. text rendered-declines) module))
      (if (!= (. declines length) 0)
        (+= parts declines)
      )
      (if (!= (. parts length) 0)
        (call fail-batch batch (call (. "\n" join) parts) (. ([] (. program modules) module) path))
        (= failing true)
      )
    )
    (if failing
      (return)
    )
    (for (in root batch)
      (= (. root compiled) (not (. root error)))
    )
    (call (. session instances seal))
    (let graph (call call-graph session))
    (let roots (call compile-roots session graph))
    (let ranks (call compile-ranks session graph roots))
    (call gather-defaults session)
    (call gather-overwrites session ranks)
    (call gather-casts session ranks)
    (call gather-payloads session ranks)
    (call gather-case-owners session ranks)
  )
  (fn-do _ type-alone _
    (param batch (list SemanticRootPlan))
    ; Types each root of a batch that failed as a program of its own. Roots typed together share
    ; one program, so a fake one binds or an effect one declares can fail another that types alone.
    (for (in root batch)
      (= (. root error) null)
      (let alone (list SemanticRootPlan))
      (+= alone root)
      (call type-batch alone)
    )
  )
  (fn-do _ fail-batch _
    (param batch (list SemanticRootPlan))
    (param message String)
    (param path (? String) (= null))
    (let reaching (list SemanticRootPlan))
    (if path
      (= reaching (in each batch (when (!= (call (. each reachable find) path) null))))
    )
    (if (== (. reaching length) 0)
      (= reaching batch)
    )
    (for (in root reaching)
      (= (. root error) (if-expr (. root error) (str (. root error) "\n\n" message) message))
    )
  )
  (fn-do _ gather-defaults _
    (param session Session)
    ; The values of the instances written in targets that are written as the default of the type
    ; they are declared as, where the reference traces them for
    ; `style/no-redundant-default-initializer` (`traces-default`, `writes-default`).
    (let program (. session program))
    (let scanned (list Bool))
    (for (in _ (..< 0 (. program modules length)))
      (+= scanned false)
    )
    (let declares (map U64 SyntaxId))
    (for (in fact (. session facts declared-values))
      (let row ([] (. session instances rows) (. fact instance)))
      (let module ([] (. program modules) (. row module)))
      (let gathered ([] facts (. module path)))
      (if (not gathered)
        (continue)
      )
      (if (and (!= (. fact pattern) 0) (not ([] scanned (. row module))))
        (= ([] scanned (. row module)) true)
        (call note-declares (. module tree) (. row module) declares)
      )
      (if (or (not (call traces-default session fact declares)) (not (call writes-default session fact)))
        (continue)
      )
      (let value ([] (. module tree nodes loc) (. fact value)))
      (let annotation ([] (. module tree nodes loc) (. fact annotation)))
      (+= (. gathered defaults)
        (call SemanticDefault
          (block
            (arg (+ (. value begin line) 1))
            (arg (+ (. value begin column) 1))
            (arg (+ (. value end line) 1))
            (arg (+ (. value end column) 2))
            (arg (+ (. annotation end line) 1))
            (arg (+ (. annotation end column) 2))
            (arg (call owned (call type-display (. session types) (. fact declared))))
          )
        )
      )
    )
  )
  (fn-do _ note-declares _
    (param tree AST)
    (param module ModuleId)
    (param declares (map U64 SyntaxId))
    ; Notes the value of each declaration of a module that declares its locals as they are written,
    ; neither lazily nor as a pattern, by the module and what the declaration declares.
    (for (in id (..< 1u32 (. tree nodes length)))
      (match? ([] (. tree nodes) id)
        (case (call .node-declare row)
          (if (and (not (. row is-lazy)) (not (. row is-pattern)))
            (= ([] declares (call declare-key module (. row left))) (. row right))
          )
        )
      )
    )
  )
  (fn-expr _ declare-key U64
    (param module ModuleId)
    (param left SyntaxId)
    (/or/ (/lshift/ (as module U64) 32) (as left U64))
  )
  (fn-do _ traces-default Bool
    (param session Session)
    (param fact DeclaredValueFact)
    (param declares (map U64 SyntaxId))
    ; Whether the reference traces a declared value for being the default of its type: a local of a
    ; function no type parameters write, declared alone with its type written by name; a global that
    ; is no local of a task, a thread or a stack; or a property a class that takes no type
    ; parameters stores and writes without annotations, typed for that class, which takes no
    ; property of its name from a class above it.
    (let row ([] (. session instances rows) (. fact instance)))
    (let module ([] (. session program modules) (. row module)))
    (if (== (. fact property) 0)
      (if (!= ([] declares (call declare-key (. row module) (. fact pattern))) (. fact value))
        (return false)
      )
      (return (and (call (. module tree names-type) (. fact annotation)) (not (call takes-type-params session (. row module) (. row decl)))))
    )
    (match? ([] (. module decls) (. fact property))
      (case (call .decl-property property)
        (if (or (. property is-lazy) (. property decoration))
          (return false)
        )
        (if (== (. property owner) 0)
          (return true)
        )
        (if (call annotated (. module tree) (. property syntax))
          (return false)
        )
        (if (call takes-type-params session (. row module) (. property owner))
          (return false)
        )
        (let ref (call class-ref (. session types) (. row self-type)))
        (if (or (!= (. ref module) (. row module)) (!= (. ref decl) (. property owner)))
          (return false)
        )
        (let base (call (. session types base-of) (. row self-type)))
        (return (or (not base) (not (. property name)) (not (call (. session types property-named) base (. property name)))))
      )
    )
    (return false)
  )
  (fn-expr _ names-type Bool
    (param tree AST)
    (param type SyntaxId)
    ; Whether a type is written by its name, with its arguments, or as a list or a map.
    (match ([] (. tree nodes) type)
      (case .node-type-identifier
        true
      )
      (case .node-core-type-identifier
        true
      )
      (case .node-type-arguments
        true
      )
      (case .node-type-list
        true
      )
      (case .node-type-map
        true
      )
      (default
        false
      )
    )
  )
  (fn-expr _ annotated Bool
    (param tree AST)
    (param syntax SyntaxId)
    (match ([] (. tree nodes) syntax)
      (case (call .node-property-syntax row)
        (!= (. row annotations count) 0)
      )
      (default
        false
      )
    )
  )
  (fn-do _ takes-type-params Bool
    (param session Session)
    (param module ModuleId)
    (param decl DeclId)
    ; Whether a function or a class takes type parameters, or a function is a member of a class
    ; that does.
    (match? ([] (. ([] (. session program modules) module) decls) decl)
      (case (call .decl-function row)
        (if (!= (. row type-args count) 0)
          (return true)
        )
        (return (and (!= (. row owner) 0) (call takes-type-params session module (. row owner))))
      )
      (case (call .decl-class row)
        (return (!= (. row type-args count) 0))
      )
    )
    (return false)
  )
  (fn-do _ writes-default Bool
    (param session Session)
    (param fact DeclaredValueFact)
    ; Whether a declared value is written as the default of its type, as the reference reads it: an
    ; unsigned zero with no unit for a number the compiler builds in, an empty string for its
    ; string, `false` for its `Bool`, or a class's constructor called with nothing.
    (let types (. session types))
    (let completion ([] (. types completions) (. fact declared)))
    (let tree (. ([] (. session program modules) (. ([] (. session instances rows) (. fact instance)) module)) tree))
    (match? ([] (. tree nodes) (. fact value))
      (case (call .node-integer-syntax row)
        (return (and (not (. row unit)) (call is-zero (. row value)) (call builtin-number types (. fact declared))))
      )
      (case (call .node-float-syntax row)
        (return (and (not (. row unit)) (call is-zero (. row value)) (call builtin-number types (. fact declared))))
      )
      (case (call .node-string-syntax row)
        (return (and (== (. row text length) 0) (. completion is-builtin) (== (. completion intrinsic) .string)))
      )
      (case (call .node-identifier row)
        (return (and (. types false-atom) (== (. row name) (. types false-atom)) (== (. fact declared) (. types bool-type))))
      )
      (case (call .node-call-expression row)
        (if (or (!= (. row operands count) 0) (. row is-curried) (not (call is-type-syntax tree (. row callable))))
          (return false)
        )
        (return (and (== (. completion intrinsic) .class) (== (. fact found) (. fact declared))))
      )
    )
    (return false)
  )
  (fn-expr _ builtin-number Bool
    (param types Types)
    (param type TypeId)
    ; Whether a type is a number the compiler builds in whose default is zero.
    (and (. ([] (. types completions) type) is-builtin) (or (and (>= code first) (<= code last)) (== kind .char)))
    (where
      (lazy kind (. ([] (. types completions) type) intrinsic))
      (lazy code (as kind U32))
      (lazy first (as (. IntrinsicKind number) U32))
      (lazy last (as (. IntrinsicKind float64) U32))
    )
  )
  (fn-do _ is-zero Bool
    (param text String)
    ; Whether a number as written is zero: digits that are all zero, before any exponent.
    (if (call (. text starts-with) "-")
      (return false)
    )
    (let digits 0)
    (for (in char text)
      (if (or (== char 'e') (== char 'E'))
        (break)
      )
      (if (== char '0')
        (+= digits 1)
        (else-if (!= char '.')
          (return false)
        )
      )
    )
    (return (!= digits 0))
  )
  (fn-do _ gather-payloads _
    (param session Session)
    (param ranks (list U32))
    ; The payloads of events with effects written in targets, in the order the reference compiles
    ; the instances (`compile-ranks`), each with its effects in the order it met them.
    (let program (. session program))
    (let effects (. session facts payload-effects))
    (let keys (list U64))
    (for (in position (..< 0 (. effects length)))
      (let rank U64 ([] ranks (. ([] effects position) instance)))
      (+= keys (/or/ (/lshift/ rank 32) (as position U64)))
    )
    (let sorted (call sort keys))
    (let position 0)
    (while (< position (. sorted length))
      (let fact ([] effects (as (/and/ ([] sorted position) 0xffffffff) Index)))
      (let labels (list String))
      (while (< position (. sorted length))
        (let next ([] effects (as (/and/ ([] sorted position) 0xffffffff) Index)))
        (if (or (!= (. next instance) (. fact instance)) (!= (. next payload) (. fact payload)))
          (break)
        )
        (+= labels (call effect-label (. next kind)))
        (+= position 1)
      )
      (let module ([] (. program modules) (. ([] (. session instances rows) (. fact instance)) module)))
      (let gathered ([] facts (. module path)))
      (if gathered
        (let begin (. ([] (. module tree nodes loc) (. fact payload)) begin))
        (let event (call owned (. fact event text)))
        (let listed (call (. ", " join) labels))
        (+= (. gathered payloads) (call SemanticPayload (+ (. begin line) 1) (+ (. begin column) 1) event listed))
      )
    )
  )
  (fn-expr _ effect-label String
    (param kind PayloadEffectKind)
    ; An effect as the reference's message names it.
    (match kind
      (case= .effect-call
        "an imperative do call"
      )
      (case= .effect-assignment
        "an assignment"
      )
      (default
        "a channel write"
      )
    )
  )
  (fn-do _ gather-case-owners _
    (param session Session)
    (param ranks (list U32))
    ; The cases given by their symbols alone written in targets that functions a call may choose
    ; take as cases of more than one type, in the order the reference compiles the instances
    ; (`compile-ranks`), each with the names of those types in order.
    (let program (. session program))
    (let owners (. session facts case-owners))
    (let keys (list U64))
    (for (in position (..< 0 (. owners length)))
      (let rank U64 ([] ranks (. ([] owners position) instance)))
      (+= keys (/or/ (/lshift/ rank 32) (as position U64)))
    )
    (let sorted (call sort keys))
    (let position 0)
    (while (< position (. sorted length))
      (let fact ([] owners (as (/and/ ([] sorted position) 0xffffffff) Index)))
      (let names (list String))
      (let chosen "")
      (while (< position (. sorted length))
        (let next ([] owners (as (/and/ ([] sorted position) 0xffffffff) Index)))
        (if (or (!= (. next instance) (. fact instance)) (!= (. next syntax) (. fact syntax)) (!= (. next name) (. fact name)))
          (break)
        )
        (let named (call owned (call class-name session (. next owner))))
        (+= names named)
        (if (. next chosen)
          (= chosen named)
        )
        (+= position 1)
      )
      (let module ([] (. program modules) (. ([] (. session instances rows) (. fact instance)) module)))
      (let gathered ([] facts (. module path)))
      (if (and gathered (> (. names length) 1) (!= (. chosen length) 0))
        (let begin (. ([] (. module tree nodes loc) (. fact syntax)) begin))
        (let name (call owned (. fact name text)))
        (let listed (call sort names))
        (+= (. gathered case-owners)
          (call SemanticCaseOwner
            (block
              (arg (+ (. begin line) 1))
              (arg (+ (. begin column) 1))
              (arg name)
              (arg listed)
              (arg chosen)
            )
          )
        )
      )
    )
  )
  (fn-do _ class-name String
    (param session Session)
    (param type TypeId)
    ; The name a class is declared with, which the reference names a type of it by.
    (match? ([] (. session types rows) type)
      (case (call .type-class row)
        (match? ([] (. ([] (. session program modules) (. row module)) decls) (. row decl))
          (case (call .decl-class owner)
            (return (. owner name text))
          )
        )
      )
    )
    (return (call type-display (. session types) type))
  )
  (fn-do _ encloses-params Bool
    (param session Session)
    (param module ModuleId)
    (param decl DeclId)
    ; Whether the function an instance runs takes type parameters or is a member of a class that
    ; does, as the reference counts them for a rule: a closure takes none of its own.
    (match? ([] (. ([] (. session program modules) module) decls) decl)
      (case (call .decl-function row)
        (if (== (. row kind) .closure-decl)
          (return false)
        )
      )
    )
    (return (call takes-type-params session module decl))
  )
  (fn-do _ gather-casts _
    (param session Session)
    (param ranks (list U32))
    ; The casts of the instances written in targets to the type their place already takes the value
    ; as, in the order the reference compiles the instances (`compile-ranks`).
    (let program (. session program))
    (let casts (. session facts context-casts))
    (let keys (list U64))
    (for (in position (..< 0 (. casts length)))
      (let rank U64 ([] ranks (. ([] casts position) instance)))
      (+= keys (/or/ (/lshift/ rank 32) (as position U64)))
    )
    (let sorted (call sort keys))
    (for (in key sorted)
      (let fact ([] casts (as (/and/ key 0xffffffff) Index)))
      (let row ([] (. session instances rows) (. fact instance)))
      (let module ([] (. program modules) (. row module)))
      (let gathered ([] facts (. module path)))
      (if (and gathered (not (call answered-by-reference session (. fact instance))))
        (let unit (call suffix-unit (. module tree) (. fact syntax)))
        (if (not unit)
          (+= (. gathered casts) (call cast-of session fact))
          (else-if (not (call encloses-params session (. row module) (. row decl)))
            (let loc ([] (. module tree nodes loc) (. fact syntax)))
            (let found
              (call SemanticSuffix
                (block
                  (arg (+ (. loc begin line) 1))
                  (arg (+ (. loc begin column) 1))
                  (arg (+ (. loc end line) 1))
                  (arg (+ (. loc end column) 2))
                  (arg unit)
                )
              )
            )
            (+= (. gathered suffixes) found)
          )
        )
      )
    )
  )
  (fn-do _ suffix-unit (? String)
    (param tree AST)
    (param syntax SyntaxId)
    (let unit (? Atom))
    (match? ([] (. tree nodes) syntax)
      (case (call .node-integer-syntax row)
        (= unit (. row unit))
      )
      (case (call .node-float-syntax row)
        (= unit (. row unit))
      )
    )
    (return (only-if (call owned (. unit text)) (if unit)))
  )
  (fn-do _ cast-of SemanticCast
    (param session Session)
    (param fact ContextCastFact)
    ; A cast as the rule reads it.
    (let row ([] (. session instances rows) (. fact instance)))
    (let tree (. ([] (. session program modules) (. row module)) tree))
    (let begin (. ([] (. tree nodes loc) (. fact syntax)) begin))
    (let written SyntaxId 0)
    (match? ([] (. tree nodes) (. fact syntax))
      (case (call .node-cast-expression cast)
        (= written (. cast rhs))
      )
    )
    (let target (call owned (call type-display (. session types) (. fact target))))
    (let text (call owned (?? (call written-type tree written) "")))
    (let context (call cast-context (. fact kind)))
    (let generic (call encloses-params session (. row module) (. row decl)))
    (return (call SemanticCast (+ (. begin line) 1) (+ (. begin column) 1) context target text generic))
  )
  (fn-do _ answered-by-reference Bool
    (param session Session)
    (param instance InstanceId)
    ; Whether the reference answers what an instance computes without typing its body: a getter of
    ; an array's storage, size or length, of the size or length of a table, a view of one or an index
    ; span, of a table's capacity or mark, or of the length of an `ArrayBuilder` an arena backs.
    (let types (. session types))
    (let row ([] (. session instances rows) instance))
    (let name "")
    (match? ([] (. ([] (. session program modules) (. row module)) decls) (. row decl))
      (case (call .decl-function fn)
        (if (and (== (. fn kind) .getter-decl) (. fn name))
          (= name (. fn name text))
        )
      )
    )
    (if (or (== name "") (== (. row self-type) no-type))
      (return false)
    )
    (let measures (or (== name "size") (== name "length")))
    (let kind (call (. types intrinsic-of) (. row self-type)))
    (if (== kind .table)
      (return (or measures (== name "capacity") (== name "mark")))
    )
    (if (== kind .array-builder)
      (return (and (== name "length") (!= (call (. types builder-item) (. row self-type)) no-type)))
    )
    (let tables (or (== kind .immutable-table) (== kind .index-span)))
    (let spans (or (== kind .table-span) (== kind .immutable-table-span)))
    (let columns (or (== kind .table-column) (== kind .immutable-table-column)))
    (let selects (or (== kind .table-selection) (== kind .immutable-table-selection)))
    (if (or tables spans columns selects)
      (return measures)
    )
    (match? ([] (. types rows) (. row self-type))
      (case (call .type-class owner)
        (let array (and (call (. types array-decl refers-to) (. owner module) (. owner decl)) (== (. owner args count) 2)))
        (return (and array (or measures (== name "data"))))
      )
    )
    (return false)
  )
  (fn-expr _ cast-context String
    (param kind ContextCastKind)
    ; The place a cast is written, as the reference's message names it.
    (match kind
      (case= .cast-argument
        "the call argument"
      )
      (case= .cast-return
        "the function return type"
      )
      (case= .cast-assignment
        "the variable declaration"
      )
      (default
        "the pattern type"
      )
    )
  )
  (fn-do _ written-type (? String)
    (param tree AST)
    (param type SyntaxId)
    ; A type as the reference names it as written: by its name, with the names of its arguments.
    (match? ([] (. tree nodes) type)
      (case (call .node-type-identifier row)
        (return (. row name text))
      )
      (case (call .node-core-type-identifier row)
        (return (. row name text))
      )
      (case (call .node-type-arguments row)
        (let base (call written-type tree (. row base)))
        (if (not base)
          (return null)
        )
        (let text base)
        (for (in arg ([] (. tree children) (. row args)))
          (let named (call written-type tree arg))
          (if (not named)
            (return null)
          )
          (+= text (++ "'" named))
        )
        (return text)
      )
    )
    (return null)
  )
  (fn-do _ gather-overwrites _
    (param session Session)
    (param ranks (list U32))
    ; The assignments of the constructors written in targets that discard a value the constructor
    ; built, as the reference traces them for `style/prefer-constructor-initializer`, from each
    ; instance of a constructor in the order the reference compiles them (`trace-overwrites`).
    (let keys (list U64))
    (for (in position (..< 0 (. session instances length)))
      (+= keys (/or/ (/lshift/ (as ([] ranks position) U64) 32) (as position U64)))
    )
    (let sorted (call sort keys))
    (for (in key sorted)
      (let instance (as (/and/ key 0xffffffff) InstanceId))
      (let row ([] (. session instances rows) instance))
      (let module ([] (. session program modules) (. row module)))
      (let gathered ([] facts (. module path)))
      (if (not gathered)
        (continue)
      )
      (match? ([] (. module decls) (. row decl))
        (case (call .decl-function fn)
          (if (and (== (. fn kind) .constructor-decl) (not (. fn is-generated)) (!= (. fn body) 0))
            (call trace-overwrites session instance gathered)
          )
        )
      )
    )
  )
  (fn-do _ trace-overwrites _
    (param session Session)
    (param instance InstanceId)
    (param gathered SemanticFacts)
    ; The assignments a constructor's body writes among its statements that discard a value the
    ; constructor built for a property, as the reference traces them: an assignment by name or
    ; through `this` to a stored property the constructor is given no value for, whose value is built
    ; by a call, or is a class or a tuple constructed with nothing given. One can be an initializer
    ; where each statement before it is one too, the property has no value written, comes after the
    ; properties of those before it, has no setter, and no rule reads it, and the value reads nothing
    ; the body assigns or declares, no property a function answers, and not the object.
    (let types (. session types))
    (let row ([] (. session instances rows) instance))
    (let receiver (. row self-type))
    (let source ([] (. session program modules) (. row module)))
    (let tree (. source tree))
    (let body SyntaxId 0)
    (let given (list Atom))
    (let args (call (of RowRange ArgumentShape)))
    (match? ([] (. source decls) (. row decl))
      (case (call .decl-function fn)
        (= body (. fn body))
        (= args (. fn args))
      )
    )
    (for (in shape ([] (. source arg-pool) args))
      (if (and (. shape name) (call (. types property-named) receiver (. shape name)))
        (+= given (. shape name))
      )
    )
    (let range (call (of RowRange SyntaxId)))
    (match? ([] (. tree nodes) body)
      (case (call .node-block block)
        (= range (. block body))
      )
    )
    (let statements (list SyntaxId))
    (for (in statement ([] (. tree children) range))
      (let lazy (call lazy-declare tree statement))
      (if (and lazy (call (. types property-named) receiver lazy))
        (+= given lazy)
        (else-if (and (not lazy) (not (is ([] (. tree nodes) statement) .node-noop)))
          (+= statements statement)
        )
      )
    )
    (let locals (list Atom))
    (for (in statement statements)
      (for (in id (..< (call (. tree subtree-start) statement) (+ statement 1)))
        (match? ([] (. tree nodes) id)
          (case (call .node-declare declare)
            (let name (call declared-name tree (. declare left)))
            (if (and name (not (. declare is-lazy)))
              (+= locals name)
            )
          )
        )
      )
    )
    (let assigned (list Atom))
    (for (in statement statements)
      (for (in id (..< (call (. tree subtree-start) statement) (+ statement 1)))
        (match? ([] (. tree nodes) id)
          (case (call .node-assign assign)
            (let name (call assigned-name types receiver tree (. assign lhs) locals))
            (if name
              (+= assigned name)
            )
          )
        )
      )
    )
    (let accessors (list Atom))
    (for (in property (call (. types properties-of) receiver))
      (if (!= (. property storage-kind) .storage-eager)
        (+= accessors (. property name))
      )
    )
    (let methods (call method-names session receiver))
    (let leading true)
    (let last -1)
    (for (in statement statements)
      (let name (? Atom) null)
      (let target SyntaxId 0)
      (let value SyntaxId 0)
      (match? ([] (. tree nodes) statement)
        (case (call .node-assign assign)
          (if (== (. assign op) .eq-op)
            (= name (call assigned-name types receiver tree (. assign lhs) locals))
            (= target (. assign lhs))
            (= value (. assign rhs))
          )
        )
      )
      (let index (call property-index types receiver name))
      (if (or (< index 0) (!= (call (. given find) (!! name)) null))
        (= leading false)
        (continue)
      )
      (let property ([] (call (. types properties-of) receiver) (as index Index)))
      (let declared (call declaring-property session receiver (. property name)))
      (let stored (and (== (. property storage-kind) .storage-eager) (== (. declared element) 0)))
      (if (or (not stored) (not (call builds-value session property declared)))
        (= leading false)
        (continue)
      )
      (let reads (or (call reads-any tree value assigned) (call reads-any tree value locals)))
      (let accesses (or (call reads-any tree value accessors) (call reads-any tree value methods)))
      (let open (and (== (. declared value) 0) (> index last) (not (. declared has-setter))))
      (let observed (call observed-by-rule session receiver (. property name)))
      (let actionable (and leading open (not observed) (not reads) (not accesses)))
      (if actionable
        (= last index)
        (else
          (= leading false)
        )
      )
      (let begin (. ([] (. tree nodes loc) statement) begin))
      (let written ([] (. tree nodes loc) target))
      (+= (. gathered overwrites)
        (call SemanticOverwrite
          (block
            (arg (+ (. begin line) 1))
            (arg (+ (. begin column) 1))
            (arg (+ (. written begin line) 1))
            (arg (+ (. written begin column) 1))
            (arg (+ (. written end column) 2))
            (arg (call owned (. property name text)))
            (arg (call owned (call type-short-name types (. property type))))
            (arg actionable)
          )
        )
      )
    )
  )
  (fn-do _ lazy-declare (? Atom)
    (param tree AST)
    (param statement SyntaxId)
    ; The name a statement declares where it is a lazy declaration of one name.
    (match? ([] (. tree nodes) statement)
      (case (call .node-declare declare)
        (if (. declare is-lazy)
          (return (call declared-name tree (. declare left)))
        )
      )
    )
    (return null)
  )
  (fn-expr _ declared-name (? Atom)
    (param tree AST)
    (param left SyntaxId)
    ; The name a declaration declares where it declares one name.
    (match? ([] (. tree nodes) left)
      (case (call .node-type-capture row)
        (call declared-name tree (. row id))
      )
      (case (call .node-identifier row)
        (. row name)
      )
      (case (call .node-type-identifier row)
        (. row name)
      )
    )
  )
  (fn-do _ assigned-name (? Atom)
    (param types Types)
    (param receiver TypeId)
    (param tree AST)
    (param target SyntaxId)
    (param locals (list Atom))
    ; The property of the object an assignment's target names: by a name no local of the body
    ; declares, or through `this`.
    (match? ([] (. tree nodes) target)
      (case (call .node-identifier row)
        (if (and (== (call (. locals find) (. row name)) null) (call (. types property-named) receiver (. row name)))
          (return (. row name))
        )
      )
      (case (call .node-get-expression row)
        (match? ([] (. tree nodes) (. row object))
          (case (call .node-identifier object)
            (if (and (== (. object name text) "this") (call (. types property-named) receiver (. row name)))
              (return (. row name))
            )
          )
        )
      )
    )
    (return null)
  )
  (fn-do _ property-index Int
    (param types Types)
    (param receiver TypeId)
    (param name (? Atom))
    ; The place of a property of a type among its properties, or -1.
    (if (not name)
      (return -1)
    )
    (let index 0)
    (for (in property (call (. types properties-of) receiver))
      (if (== (. property name) name)
        (return index)
      )
      (+= index 1)
    )
    (return -1)
  )
  (fn-do _ declaring-property DeclaredProperty
    (param session Session)
    (param receiver TypeId)
    (param name Atom)
    ; The declaration of a property in the nearest class, from a class up through its bases, that
    ; declares it.
    (let current receiver)
    (while (!= current no-type)
      (let ref (call class-ref (. session types) current))
      (let module ([] (. session program modules) (. ref module)))
      (for (in member ([] (. module member-pool) (call class-members module (. ref decl))))
        (match? ([] (. module decls) member)
          (case (call .decl-property property)
            (if (and (. property name) (== (. property name) name))
              (let setter (call declares-setter module (. ref decl) name))
              (return (call DeclaredProperty (. ref module) (. property value) (. property element) setter))
            )
          )
        )
      )
      (= current (?? (call (. session types base-of) current) no-type))
    )
    (return (call DeclaredProperty 0 0 0 false))
  )
  (fn-do _ method-names (list Atom)
    (param session Session)
    (param receiver TypeId)
    (let names (list Atom))
    (let current receiver)
    (while (!= current no-type)
      (let ref (call class-ref (. session types) current))
      (let module ([] (. session program modules) (. ref module)))
      (for (in member ([] (. module member-pool) (call class-members module (. ref decl))))
        (match? ([] (. module decls) member)
          (case (call .decl-function fn)
            (if (and (== (. fn kind) .function-decl) (. fn name))
              (+= names (. fn name))
            )
          )
        )
      )
      (= current (?? (call (. session types base-of) current) no-type))
    )
    (return names)
  )
  (fn-do _ class-members (of RowRange DeclId)
    (param module Module)
    (param decl DeclId)
    (let members (call (of RowRange DeclId)))
    (match? ([] (. module decls) decl)
      (case (call .decl-class class)
        (= members (. class members))
      )
    )
    (return members)
  )
  (fn-do _ declares-setter Bool
    (param module Module)
    (param owner DeclId)
    (param name Atom)
    (for (in member ([] (. module member-pool) (call class-members module owner)))
      (match? ([] (. module decls) member)
        (case (call .decl-function fn)
          (if (and (== (. fn kind) .setter-decl) (. fn name) (== (. fn name) name))
            (return true)
          )
        )
      )
    )
    (return false)
  )
  (fn-do _ builds-value Bool
    (param session Session)
    (param property TypeProperty)
    (param declared DeclaredProperty)
    ; Whether the value a constructor builds for a property does work: a value written that calls
    ; something, of a class, or of a tuple with a constructor that is given nothing.
    (if (!= (. declared value) 0)
      (let tree (. ([] (. session program modules) (. declared module)) tree))
      (let calls false)
      (for (in id (..< (call (. tree subtree-start) (. declared value)) (+ (. declared value) 1)))
        (if (is ([] (. tree nodes) id) .node-call-expression)
          (= calls true)
        )
      )
      (if (not calls)
        (return false)
      )
    )
    (let kind (. ([] (. session types completions) (. property type)) intrinsic))
    (if (or (== kind .class) (== kind .style) (== kind .style-sheet))
      (return true)
    )
    (if (not (call is-tuple-kind kind))
      (return false)
    )
    (let ref (call class-ref (. session types) (. property type)))
    (let module ([] (. session program modules) (. ref module)))
    (for (in member ([] (. module member-pool) (call class-members module (. ref decl))))
      (let args (call constructor-args module member))
      (if (and args (call takes-nothing module args))
        (return true)
      )
    )
    (return false)
  )
  (fn-do _ constructor-args (? (of RowRange ArgumentShape))
    (param module Module)
    (param decl DeclId)
    (match? ([] (. module decls) decl)
      (case (call .decl-function fn)
        (if (== (. fn kind) .constructor-decl)
          (return (. fn args))
        )
      )
    )
    (return null)
  )
  (fn-do _ takes-nothing Bool
    (param module Module)
    (param args (of RowRange ArgumentShape))
    (for (in shape ([] (. module arg-pool) args))
      (if (not (. shape has-default))
        (return false)
      )
    )
    (return true)
  )
  (fn-expr _ is-tuple-kind Bool
    (param kind IntrinsicKind)
    ; Whether a type is a tuple as the reference builds it: a tuple, a struct, an array builder, or a
    ; table or a part of one.
    (or (== kind .tuple) (== kind .struct) (== kind .array-builder) (and (>= code first) (<= code last)))
    (where
      (lazy code (as kind U32))
      (lazy first (as (. IntrinsicKind table) U32))
      (lazy last (as (. IntrinsicKind table-mark) U32))
    )
  )
  (fn-do _ observed-by-rule Bool
    (param session Session)
    (param receiver TypeId)
    (param name Atom)
    ; Whether a rule of a class or of a class above it reads a property in its test: a `when`, or a
    ; `whenever` on a value.
    (let names (list Atom))
    (+= names name)
    (let current receiver)
    (while (!= current no-type)
      (let ref (call class-ref (. session types) current))
      (let module ([] (. session program modules) (. ref module)))
      (for (in member ([] (. module member-pool) (call class-members module (. ref decl))))
        (let test (call rule-test (. module tree) (call member-syntax module member)))
        (if (and (!= test 0) (call reads-any (. module tree) test names))
          (return true)
        )
      )
      (= current (?? (call (. session types base-of) current) no-type))
    )
    (return false)
  )
  (fn-do _ member-syntax SyntaxId
    (param module Module)
    (param decl DeclId)
    ; Where a rule of a class is written, or 0 for any other member.
    (match? ([] (. module decls) decl)
      (case (call .decl-rule rule)
        (return (. rule syntax))
      )
    )
    (return 0)
  )
  (fn-expr _ rule-test SyntaxId
    (param tree AST)
    (param syntax SyntaxId)
    (match ([] (. tree nodes) syntax)
      (case (call .node-when-rule-syntax row)
        (. row expr)
      )
      (case (call .node-whenever-rule-syntax row)
        (if-expr (== (. row kind text) "value") (. row expr) 0u32)
      )
      (default
        0u32
      )
    )
  )
  (fn-do _ reads-any Bool
    (param tree AST)
    (param expr SyntaxId)
    (param names (list Atom))
    ; Whether an expression reads the object, its base, or a name among `names`.
    (if (== expr 0)
      (return false)
    )
    (for (in id (..< (call (. tree subtree-start) expr) (+ expr 1)))
      (match? ([] (. tree nodes) id)
        (case (call .node-identifier row)
          (if (or (== (. row name text) "this") (== (. row name text) "super") (!= (call (. names find) (. row name)) null))
            (return true)
          )
        )
      )
    )
    (return false)
  )
  (fn-do _ compile-ranks (list U32)
    (param session Session)
    (param graph CallGraph)
    (param roots (list InstanceId))
    ; The order the reference compiles the instances of a program in: from each of `roots`
    ; (`compile-roots`), depth first through what each compiles, in the order of its body.
    (let ranks (list U32))
    (for (in _ (..< 0 (. session instances length)))
      (+= ranks (. U32 max))
    )
    (let next U32)
    (let stack (list InstanceId))
    (for (in root roots)
      (+= stack root)
      (while (!= (. stack length) 0)
        (let instance ([] stack (- (. stack length) 1)))
        (call (. stack pop))
        (if (!= ([] ranks instance) (. U32 max))
          (continue)
        )
        (= ([] ranks instance) next)
        (+= next 1)
        (let first ([] (. graph starts) instance))
        (let position ([] (. graph starts) (+ instance 1)))
        (while (> position first)
          (-= position 1)
          (let callee ([] (. graph callees) position))
          (if (== ([] ranks callee) (. U32 max))
            (+= stack callee)
          )
        )
      )
    )
    (return ranks)
  )
  (fn-do _ compile-roots (list InstanceId)
    (param session Session)
    (param graph CallGraph)
    ; The instances the reference begins compiling from, in order: the main of each module in the
    ; order the modules initialize, then the instances of the functions nothing compiles, then the
    ; rest, each in the order of the sealed instance table (`Instances.ordered`), as an id records
    ; only which instance typing reached first, which depends on how many passes typed the program.
    ; A function is reached where another instance compiles any of its instances (`function-key`).
    (let instances (. session instances))
    (let reached (map String Bool))
    (for (in position (..< 0 (. instances length)))
      (for (in offset (..< ([] (. graph starts) position) ([] (. graph starts) (+ position 1))))
        (let callee ([] (. graph callees) offset))
        (if (!= callee (as position InstanceId))
          (= ([] reached (call function-key instances callee)) true)
        )
      )
    )
    (let roots (list InstanceId))
    (let mains (call module-mains session))
    (for (in module (. session program init-order))
      (if (!= ([] mains module) no-instance)
        (+= roots ([] mains module))
      )
    )
    (let called (list InstanceId))
    (for (in instance (. instances ordered))
      (if ([] reached (call function-key instances instance))
        (+= called instance)
        (else
          (+= roots instance)
        )
      )
    )
    (return (++ roots called))
  )
  (fn-expr _ function-key String
    (param instances Instances)
    (param instance InstanceId)
    ; The function the reference compiles for an instance: its declaration, the type of its object,
    ; the instance it is written in, and the types it takes, but not its effects or the row it reads
    ; its object from, which the reference does not tell apart.
    (str (. row module) ":" (. row decl) ":" (. row self-type) ":" (. row enclosing) taken)
    (where
      (lazy row ([] (. instances rows) instance))
      (lazy signature ([] (. instances signatures) instance))
      (lazy first (- (. signature args start) (. signature param-count)))
      (lazy taken (call (. "" join) (in (str ":" ([] (. instances signature-types) each)) (..< first (+ (. signature args start) (. signature args count))))))
    )
  )
  (fn-do _ call-graph CallGraph
    (param session Session)
    ; What the reference compiles while it compiles each instance's body, in the order of the body:
    ; at each node, the closures written there, the instances its calls call, and what its
    ; conversions compile (`add-conversion`). The reference compiles a closure where it is written,
    ; and a function where a call, a conversion or a value of a function type first needs it.
    (let instances (. session instances))
    (let facts (. session facts))
    (let closures (call closures-by-node session))
    (let graph (call CallGraph))
    (for (in position (..< 0 (. instances length)))
      (+= (. graph starts) (as (. graph callees length) U32))
      (let row ([] (. instances rows) position))
      (if (== (. row node-start) (. U32 max))
        (continue)
      )
      (let written ([] closures position))
      (let next 0)
      (for (in offset (..< 0 (. row subtree count)))
        (while (and (< next (. written length)) (== (. ([] written next) offset) offset))
          (+= (. graph callees) (. ([] written next) closure))
          (+= next 1)
        )
        (let cursor ([] (. facts node-calls) (+ (. row node-start) offset)))
        (while (!= cursor no-fact)
          (let callee (. ([] (. facts calls) cursor) callee))
          (if (!= callee no-instance)
            (+= (. graph callees) callee)
          )
          (= cursor (. ([] (. facts calls) cursor) next))
        )
        (let conversion ([] (. facts node-conversions) (+ (. row node-start) offset)))
        (while (!= conversion no-fact)
          (call add-conversion facts ([] (. facts conversions) conversion) graph)
          (= conversion (. ([] (. facts conversions) conversion) next))
        )
      )
    )
    (+= (. graph starts) (as (. graph callees length) U32))
    (return graph)
  )
  (fn-do _ add-conversion _
    (param facts Facts)
    (param fact ConversionFact)
    (param graph CallGraph)
    ; Adds what a conversion compiles: the functions that convert its parts, the function that
    ; converts the value, and the function a value of a function type it makes runs.
    (let part (. fact parts))
    (while (!= part no-fact)
      (call add-conversion facts ([] (. facts conversion-parts) part) graph)
      (= part (. ([] (. facts conversion-parts) part) next))
    )
    (if (!= (. fact callee) no-instance)
      (+= (. graph callees) (. fact callee))
    )
    (if (!= (. fact runs) no-instance)
      (+= (. graph callees) (. fact runs))
    )
  )
  (fn-do _ closures-by-node (list (list WrittenClosure))
    (param session Session)
    ; The closures written in each instance with a body, by that instance, each at the node of the
    ; body it is written at, in the order of those nodes and then of the instance table.
    (let instances (. session instances))
    (let program (. session program))
    (let found (list (list WrittenClosure)))
    (for (in _ (..< 0 (. instances length)))
      (let none (list WrittenClosure))
      (+= found none)
    )
    (for (in instance (. instances ordered))
      (let row ([] (. instances rows) instance))
      (if (== (. row enclosing) no-instance)
        (continue)
      )
      (let outer ([] (. instances rows) (. row enclosing)))
      (if (== (. outer node-start) (. U32 max))
        (continue)
      )
      (match? ([] (. ([] (. program modules) (. row module)) decls) (. row decl))
        (case (call .decl-function fn)
          (let start (. outer subtree start))
          (if (and (>= (. fn syntax) start) (< (. fn syntax) (+ start (. outer subtree count))))
            (let offset (- (. fn syntax) start))
            (let list ([] found (. row enclosing)))
            (let place (. list length))
            (while (and (> place 0) (> (. ([] list (- place 1)) offset) offset))
              (-= place 1)
            )
            (call (. list insert) (call WrittenClosure offset instance) place)
          )
        )
      )
    )
    (return found)
  )
  (fn-do _ module-mains (list InstanceId)
    (param session Session)
    ; The instance of the main of each module, by module, or `no-instance` for one none runs.
    (let instances (. session instances))
    (let program (. session program))
    (let mains (list InstanceId))
    (for (in _ (..< 0 (. program modules length)))
      (+= mains no-instance)
    )
    (for (in position (..< 0 (. instances length)))
      (let row ([] (. instances rows) position))
      (if (and (== (. row enclosing) no-instance) (== (. row decl) (. ([] (. program modules) (. row module)) main-decl)))
        (if (== ([] mains (. row module)) no-instance)
          (= ([] mains (. row module)) (as position InstanceId))
        )
      )
    )
    (return mains)
  )
  (fn-expr _ owned String
    (param text String)
    ; `text` copied to collected memory: the name of a type can be text the program's arena holds,
    ; which the program releases before the rules read it.
    (call (. (call byte-view text) slice-string))
  )
)

(type _ DeclaredProperty (is Tuple)
  ; What the nearest class that declares a property writes for it: its module and value, whether it
  ; names a markup element, and whether the class declares a setter of its name.
  (prop + module ModuleId)
  (prop + value SyntaxId)
  (prop + element SyntaxId)
  (prop + has-setter Bool)
)

(type _ CallGraph
  ; What each instance of a program compiles while its body is compiled (`call-graph`): instance
  ; `i` compiles `callees[starts[i] .. < starts[i + 1]]`, in the order of its body.
  (prop + starts (list U32))
  (prop + callees (list InstanceId))
)

(type _ WrittenClosure (is Tuple)
  ; A closure written in an instance's body, at a node's offset in that body.
  (prop + offset U32)
  (prop + closure InstanceId)
)
