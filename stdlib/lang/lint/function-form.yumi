+ Plan

` A way through a `do` function's body to its results: an open end that gives no result, a
` statement before the rest, a returned result, or a choice among branches and a fallback.

+ kind PlanKind
+ statement SyntaxId
+ result SyntaxId
+ next Plan?
+ choice U32
+ conditions [SyntaxId]
+ branches [Plan]
+ fallback Plan?

────────────────────
+ This
    - kind PlanKind

━━━━━━━━━━━━━━━━━━━━
+ open-plan Plan

Plan(.plan-open)

━━━━━━━━━━━━━━━━━━━━
+ do prefix-plan Plan
    - statement SyntaxId
    - next Plan

. plan = Plan(.plan-prefix)
plan.statement = statement
plan.next = next
= plan

━━━━━━━━━━━━━━━━━━━━
+ do leaf-plan Plan
    - result SyntaxId
    - statement SyntaxId

. plan = Plan(.plan-leaf)
plan.result = result
plan.statement = statement
= plan

━━━━━━━━━━━━━━━━━━━━
+ do choice-plan Plan
    - choice U32
    - conditions [SyntaxId]
    - branches [Plan]
    - fallback Plan?

. plan = Plan(.plan-choice)
plan.choice = choice
plan.conditions = conditions
plan.branches = branches
plan.fallback = fallback
= plan

━━━━━━━━━━━━━━━━━━━━
+ do has-open-path Bool
    - plan Plan

` Whether some way through a plan ends without a result.
if plan.kind == .plan-open
    = true
if plan.kind == .plan-prefix
    = has-open-path(plan.next!)
if plan.kind == .plan-leaf
    = false
for branch in plan.branches
    if has-open-path(branch)
        = true
. fallback = plan.fallback
= !fallback || has-open-path(fallback)

━━━━━━━━━━━━━━━━━━━━
+ do replace-open-paths Plan
    - plan Plan
    - continuation Plan

` A plan whose open ends go on to `continuation`.
if plan.kind == .plan-open
    = continuation
if plan.kind == .plan-prefix
    = prefix-plan(plan.statement, replace-open-paths(plan.next!, continuation))
if plan.kind == .plan-leaf
    = plan
. branches [Plan]
for branch in plan.branches
    branches += replace-open-paths(branch, continuation)
. replaced = continuation
. fallback = plan.fallback
if fallback
    replaced = replace-open-paths(fallback, continuation)
= choice-plan(plan.choice, plan.conditions, branches, replaced)

━━━━━━━━━━━━━━━━━━━━
+ do normalized-plan Plan
    - tree AST
    - plan Plan

` A plan whose choices take in a fallback choice on the same subject, or on none, as more branches.
if plan.kind == .plan-prefix
    = prefix-plan(plan.statement, normalized-plan(tree, plan.next!))
if plan.kind != .plan-choice
    = plan
. branches [Plan]
for branch in plan.branches
    branches += normalized-plan(tree, branch)
. kept Plan? = null
. fallback = plan.fallback
if fallback
    kept = normalized-plan(tree, fallback)
. normalized = choice-plan(plan.choice, plan.conditions, branches, kept)
while true
    . inner = normalized.fallback
    if !inner || inner.kind != .plan-choice || !can-flatten(tree, normalized, inner)
        break
    . conditions [SyntaxId]
    conditions ++= normalized.conditions
    conditions ++= inner.conditions
    . joined [Plan]
    joined ++= normalized.branches
    joined ++= inner.branches
    normalized = choice-plan(normalized.choice, conditions, joined, inner.fallback)
= normalized

━━━━━━━━━━━━━━━━━━━━
+ can-flatten Bool
    - tree AST
    - outer Plan
    - fallback Plan

|? outer-subject.length == 0
    fallback-subject.length == 0
??
    outer-subject == fallback-subject

.. outer-subject = choice-subject(tree, outer)
.. fallback-subject = choice-subject(tree, fallback)

━━━━━━━━━━━━━━━━━━━━
+ do choice-subject String
    - tree AST
    - plan Plan

` The local every branch of a choice tests with `is` or `==`, or none.
. subject = ""
for condition in plan.conditions
    . direct = direct-subject(tree, condition)
    if direct.length == 0 || (subject.length != 0 && direct != subject)
        = ""
    subject = direct
= subject

━━━━━━━━━━━━━━━━━━━━
+ do direct-subject String
    - tree AST
    - condition SyntaxId

match? tree.nodes[guard-expression(tree, condition)]
    | .node-binary-expression(row)
        if row.op == .is-op || row.op == .equals-op
            match? tree.nodes[row.lhs]
                | .node-identifier(left)
                    if !left.is-tracked
                        = left.name.text
= ""

━━━━━━━━━━━━━━━━━━━━
+ guard-expression SyntaxId
    - tree AST
    - condition SyntaxId

match tree.nodes[condition]
    | .node-type-predicate(row)
        row.expr
    ??
        condition

━━━━━━━━━━━━━━━━━━━━
+ do after-prefixes Plan
    - plan Plan

. current = plan
while current.kind == .plan-prefix
    current = current.next!
= current

━━━━━━━━━━━━━━━━━━━━
+ do has-leading-assertions Bool
    - tree AST
    - plan Plan

. current = plan
while current.kind == .plan-prefix
    if tree.nodes[current.statement] is .node-assertion-syntax
        = true
    current = current.next!
= false

━━━━━━━━━━━━━━━━━━━━
+ Planner

` Builds the plan of a function's body, numbering its choices in the order they are made.

+ tree AST
_ choices U32

────────────────────
+ This
    - tree AST

────────────────────
_ do next-choice U32

choices += 1
= choices

────────────────────
+ do plan-block Plan?
    - block SyntaxId

` The plan of a block, with its lazy locals first, or none where a statement has no plan.
. lazies [SyntaxId]
. statements [SyntaxId]
match tree.nodes[block]
    | .node-block(row)
        for statement in tree.children[row.body]
            if is-lazy-local(tree, statement)
                if !has-local-value(tree, statement)
                    = null
                lazies += statement
            else
                statements += statement
    ?! Panic("Expected a block")
. body = plan-statements(statements, 0)
if !body
    = null
. plan = body
for step in 0 .. < lazies.length
    plan = prefix-plan(lazies[lazies.length - 1 - step], plan)
= plan

────────────────────
_ do plan-statements Plan?
    - statements [SyntaxId]
    - index Index

if index >= statements.length
    = open-plan()
. statement = statements[index]
match? tree.nodes[statement]
    | .node-declare(row)
        if row.is-pattern || row.right == 0
            = null
        . next = plan-statements(statements, index + 1)
        if !next
            = null
        = prefix-plan(statement, next)
    | .node-assertion-syntax
        . next = plan-statements(statements, index + 1)
        if !next
            = null
        = prefix-plan(statement, next)
    | .node-return(row)
        if !is-successful-value(tree, row.expr)
            = null
        = leaf-plan(row.expr, statement)
    | .node-return-if-true(row)
        if !is-successful-value(tree, row.expr)
            = null
        . fallback = plan-statements(statements, index + 1)
        if !fallback
            = null
        . conditions [SyntaxId]
        conditions += row.condition
        . branches [Plan]
        branches += leaf-plan(row.expr, statement)
        = choice-plan(next-choice(), conditions, branches, fallback)
    | .node-if-block
        = plan-if(statements, index)
= null

────────────────────
_ do plan-if Plan?
    - statements [SyntaxId]
    - index Index

` The plan of an `if` chain, whose branches that end without a result go on to what follows it.
. conditions [SyntaxId]
. branches [Plan]
. fallback Plan? = null
. branch = statements[index]
while branch != 0
    match tree.nodes[branch]
        | .node-if-block(row)
            if !(tree.nodes[row.body] is .node-block)
                = null
            . branch-plan = plan-block(row.body)
            if !branch-plan
                = null
            if row.condition != 0
                conditions += row.condition
                branches += branch-plan
            else
                fallback = branch-plan
                if row.next != 0
                    = null
            branch = row.next
        ??
            = null

. last = fallback ?? open-plan()
. open = has-open-path(last)
for each-plan in branches
    open = open || has-open-path(each-plan)
if open
    . continuation = plan-statements(statements, index + 1)
    if !continuation
        = null
    . replaced [Plan]
    for each-plan in branches
        replaced += replace-open-paths(each-plan, continuation)
    branches = replaced
    last = replace-open-paths(last, continuation)
= choice-plan(next-choice(), conditions, branches, last)

