+ has-local-value Bool
    - tree AST
    - id SyntaxId

match tree.nodes[id]
    | .node-declare(row)
        !row.is-pattern && row.right != 0
    ??
        false

━━━━━━━━━━━━━━━━━━━━
+ is-successful-value Bool
    - tree AST
    - id SyntaxId

` Whether a returned value is one that always succeeds as written: not optional, not caught.
id != 0 && !(tree.nodes[id] is .node-optional-chain) && !(tree.nodes[id] is .node-catch-expression)

━━━━━━━━━━━━━━━━━━━━
+ do local-name String
    - tree AST
    - id SyntaxId

` The name a declaration of one local gives, or none.
match? tree.nodes[id]
    | .node-declare(row)
        match? tree.nodes[row.left]
            | .node-type-capture(capture)
                = identifier-name(tree, capture.id)
= ""

━━━━━━━━━━━━━━━━━━━━
+ do local-display-name String
    - source LintSource
    - tree AST
    - id SyntaxId
    - name String

` The name of a local as written, where it is written as a plain name.
match? tree.nodes[id]
    | .node-declare(row)
        match? tree.nodes[row.left]
            | .node-type-capture(capture)
                . text = node-text(source, tree, capture.id)
                if is-plain-name(text)
                    = text
= name

━━━━━━━━━━━━━━━━━━━━
+ do is-plain-name Bool
    - text String

if text.length == 0 || !is-name-start(text[0])
    = false
for char in text
    if !is-name-start(char) && !(char >= '0' && char <= '9') && char != '-'
        = false
= true

━━━━━━━━━━━━━━━━━━━━
+ is-name-start Bool
    - char Char

(char >= 'a' && char <= 'z') || (char >= 'A' && char <= 'Z') || char == '_'

━━━━━━━━━━━━━━━━━━━━
+ local-value SyntaxId
    - tree AST
    - id SyntaxId

match tree.nodes[id]
    | .node-declare(row)
        row.right
    ??
        0

━━━━━━━━━━━━━━━━━━━━
+ is-direct-value Bool
    - tree AST
    - id SyntaxId

` Whether a value is written as an untracked name or a literal.
match tree.nodes[id]
    | .node-identifier(row)
        !row.is-tracked
    | .node-integer-syntax(row)
        !row.unit
    | .node-float-syntax(row)
        !row.unit
    | .node-string-syntax
        true
    | .node-symbol
        true
    ??
        false

━━━━━━━━━━━━━━━━━━━━
+ do is-proven-value Bool
    - tree AST
    - id SyntaxId

` Whether a value is written as one that cannot fail: a direct value, or a tuple or list of them.
if is-direct-value(tree, id)
    = true
match? tree.nodes[id]
    | .node-tuple-syntax(row)
        for item in tree.children[row.items]
            if !is-proven-value(tree, item)
                = false
        = true
    | .node-list-syntax(row)
        for item in tree.children[row.items]
            if !is-proven-value(tree, item)
                = false
        = true
= false

