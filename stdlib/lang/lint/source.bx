(import /lang/target)
(import /stream/aggregate)

(type + LintSource
  (prop + path String)
  (prop + text String)
  (prop + lines (list String))
  (prop + line-starts (list Index))
  (prop + utf16-line-starts (list Index))
  (fn-do + This _
    (param path String)
    (param text String)
    (lazy lines (call split-lines text))
    (blank)
    (+= line-starts 0)
    (+= utf16-line-starts 0)
    (let index Index 0)
    (let utf16-index Index 0)
    (for (in char text)
      (+= index 1)
      (+= utf16-index (if-expr (> (as char U32) 65535) 2 1))
      (if (== char (char "\n"))
        (+= line-starts index)
        (+= utf16-line-starts utf16-index)
      )
    )
  )
  (fn-expr + offset-of Index
    (param line U32)
    (param column U32)
    (+ ([] line-starts line) column)
  )
  (fn-do + utf16-offset Index
    (param line U32)
    (param column U32)
    ; The offset in UTF-16 units of a place given by its line and column from zero.
    (let offset ([] utf16-line-starts line))
    (let position ([] line-starts line))
    (for (in char ([] text (..< position (+ position column))))
      (+= offset (if-expr (> (as char U32) 65535) 2 1))
    )
    (return offset)
  )
  (fn-do + utf16-of Index
    (param offset Index)
    ; The offset in UTF-16 units of a character offset.
    (let low Index 0)
    (let high (- (. line-starts length) 1))
    (while (< low high)
      (let middle (+ low (/ (+ (- high low) 1) 2)))
      (if (<= ([] line-starts middle) offset)
        (= low middle)
        (else
          (= high (- middle 1))
        )
      )
    )
    (return (call utf16-offset (as low U32) (as (- offset ([] line-starts low)) U32)))
  )
  (fn-do + char-of Index
    (param utf16 Index)
    ; The character offset of an offset in UTF-16 units.
    (let low Index 0)
    (let high (- (. utf16-line-starts length) 1))
    (while (< low high)
      (let middle (+ low (/ (+ (- high low) 1) 2)))
      (if (<= ([] utf16-line-starts middle) utf16)
        (= low middle)
        (else
          (= high (- middle 1))
        )
      )
    )
    (let offset ([] line-starts low))
    (let units ([] utf16-line-starts low))
    (if (< low (. lines length))
      (for (in char ([] lines low))
        (if (>= units utf16)
          (break)
        )
        (+= units (if-expr (> (as char U32) 65535) 2 1))
        (+= offset 1)
      )
    )
    (if (< units utf16)
      (return (+ offset (- utf16 units)))
    )
    (return offset)
  )
  (fn-expr + slice String
    (param start Index)
    (param end Index)
    (if-expr (> last start) ([] text (..< start last)) "")
    (where
      (lazy last (if-expr (< end (. text length)) end (. text length)))
    )
  )
)

(fn-expr + is-lint-path Bool
  (param path String)
  (call (. path ends-with) brix-extension)
)

(fn-do + split-lines (list String)
  (param text String)
  (let lines (list String))
  (if (== (. text length) 0)
    (+= lines "")
    (return lines)
  )
  (blank)
  (let body (if-expr (call (. text ends-with) "\n") ([] text (..< 0 (- (. text length) 1))) text))
  (if (== (. body length) 0)
    (+= lines "")
    (return lines)
  )
  (blank)
  (for (in line (call (. body split) "\n"))
    (+= lines (call strip-carriage-return line))
  )
  (return lines)
)

(fn-expr + strip-carriage-return String
  (param line String)
  (if-expr (call (. line ends-with) "\r") ([] line (..< 0 (- (. line length) 1))) line)
)

(fn-expr + is-divider-glyph Bool
  (param char Char)
  (or (== char (char "━")) (== char (char "─")) (== char (char "═")))
)

(fn-do _ indent-level Size
  (param line String)
  (let spaces Size 0)
  (while (and (< spaces (. line length)) (== ([] line spaces) (char " ")))
    (+= spaces 1)
  )
  (return (/ spaces 4))
)

(fn-do + utf16-length Index
  (param text String)
  (let length Index 0)
  (for (in char text)
    (+= length (if-expr (> (as char U32) 65535) 2 1))
  )
  (return length)
)

(fn-expr + is-space-char Bool
  (param char Char)
  (or (== char (char " ")) (== char (char "\t")) (== char (char "\r")) (== char (char "\n")))
)
