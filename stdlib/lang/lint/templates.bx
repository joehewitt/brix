(import ./quantifiers)
(import ./rule-context)
(import ./source)
(import /lang/ast/ast)
(import /lang/ast/ast-children)
(import /lang/ast/ast-nodes)
(import /lang/ast/operator)
(import /lang/ast/row-range)

(fn-do + lint-text-templates _
  (param source LintSource)
  (param tree AST)
  (param context RuleContext)
  (let attached (call attached-nodes tree))
  (for (in id (..< 1u32 (. tree nodes length)))
    (if (not ([] attached id))
      (continue)
    )
    (match? ([] (. tree nodes) id)
      (case (call .node-function-syntax row)
        (let builder (call text-builder source tree row))
        (if (!= (. builder length) 0)
          (let loc (. ([] (. tree nodes loc) id) begin))
          (call (. context report) (call builder-message builder) (+ (. loc line) 1) (+ (. loc column) 1) "review")
        )
      )
    )
  )
)

(fn-expr + builder-message String
  (param builder String)
  (case? (== builder "appended-string")
    (str string-head " " string-tail)
  )
  (case? (== builder "appended-lines")
    (str lines-head " " lines-tail)
  )
  (default
    (str interpolation-head " " interpolation-tail)
  )
  (where
    (lazy string-head "Review this text builder: write the text as a text body instead of appending")
    (lazy string-tail "to a string, unless it works character by character (YS-04).")
    (lazy lines-head "Review this line builder: write the text as a text body, with repeated lines as")
    (lazy lines-tail "`(call (. \"\\n\" join) …)`, instead of appending to a list (YS-04).")
    (lazy interpolation-head "Review this long interpolated result: write it as a text body, with its")
    (lazy interpolation-tail "values as lazies in its `where` (YS-04).")
  )
)

(fn-do + text-builder String
  (param source LintSource)
  (param tree AST)
  (param function ASTFunction)
  (let statements
    (match? ([] (. tree nodes) (. function body))
      (case (call .node-block row)
        (. row body)
      )
    )
  )
  (if (not statements)
    (return "")
  )
  (let body statements)
  (let result (call result-expression tree body))
  (if (or (== result 0) (call is-paragraph source tree result))
    (return "")
  )
  (blank)
  (let locals (map String SyntaxId))
  (for (in statement ([] (. tree children) body))
    (let declared (call declared-name tree statement))
    (if (!= (. declared length) 0)
      (= ([] locals declared) statement)
    )
  )
  (let appended (list String))
  (call gather-appended tree (. function body) appended)
  (blank)
  (let name (call identifier-text tree result))
  (if (and (!= (. name length) 0) (has appended name) (call is-string-declaration tree (?? ([] locals name) 0)))
    (return "appended-string")
  )
  (let joined (call joined-name tree result))
  (if (and (!= (. joined length) 0) (has appended joined) (call is-lines-declaration tree (?? ([] locals joined) 0)))
    (return "appended-lines")
  )
  (if (and (call only-locals tree body result) (call is-long-interpolation source tree result locals))
    (return "long-interpolation")
  )
  (return "")
)

(fn-do + result-expression SyntaxId
  (param tree AST)
  (param body (of RowRange SyntaxId))
  (let last SyntaxId 0)
  (for (in statement ([] (. tree children) body))
    (if (not (call is-lazy-declaration tree statement))
      (= last statement)
    )
  )
  (return
    (match ([] (. tree nodes) last)
      (case (call .node-return row)
        (if-expr (not (is ([] (. tree nodes) (. row expr)) .node-optional-chain)) (. row expr) 0)
      )
      (case .node-identifier
        last
      )
      (case .node-binary-expression
        last
      )
      (case .node-call-expression
        last
      )
      (case .node-string-syntax
        last
      )
      (default
        0
      )
    )
  )
)

(fn-expr + is-lazy-declaration Bool
  (param tree AST)
  (param id SyntaxId)
  (match ([] (. tree nodes) id)
    (case (call .node-declare row)
      (. row is-lazy)
    )
    (default
      false
    )
  )
)

(fn-expr + declared-name String
  (param tree AST)
  (param id SyntaxId)
  (match ([] (. tree nodes) id)
    (case (call .node-declare row)
      (match ([] (. tree nodes) (. row left))
        (case (call .node-type-capture capture)
          (call identifier-text tree (. capture id))
        )
        (default
          ""
        )
      )
    )
    (default
      ""
    )
  )
)

(fn-do _ gather-appended _
  (param tree AST)
  (param id SyntaxId)
  (param names (list String))
  (match? ([] (. tree nodes) id)
    (case (call .node-assign row)
      (let name (call identifier-text tree (. row lhs)))
      (if (and (== (. row op) .add-eq-op) (!= (. name length) 0))
        (+= names name)
      )
    )
  )
  (for (in child (call (. tree children-of) id))
    (call gather-appended tree child names)
  )
)

(fn-do + is-string-declaration Bool
  (param tree AST)
  (param id SyntaxId)
  (match? ([] (. tree nodes) id)
    (case (call .node-declare row)
      (if (. row is-lazy)
        (return false)
      )
      (match? ([] (. tree nodes) (. row left))
        (case (call .node-type-capture capture)
          (if (!= (. row right) 0)
            (return (call is-string-expression tree (. row right)))
          )
          (return (call is-type-named tree (. capture type) "String"))
        )
      )
    )
  )
  (return false)
)

(fn-expr + is-string-expression Bool
  (param tree AST)
  (param id SyntaxId)
  (match ([] (. tree nodes) id)
    (case (call .node-binary-expression row)
      (scope (and (call is-concatenation (. row op)) (or (call is-string-expression tree (. row lhs)) has-string-right))
        (lazy has-string-right (call is-string-expression tree (. row rhs)))
      )
    )
    (case .node-string-syntax
      true
    )
    (default
      false
    )
  )
)

(fn-expr + is-concatenation Bool
  (param op Operator)
  (or (== op .concat-op) (== op .concat-string-op))
)

(fn-expr + is-type-named Bool
  (param tree AST)
  (param id SyntaxId)
  (param name String)
  (match ([] (. tree nodes) id)
    (case (call .node-type-identifier row)
      (== (. row name text) name)
    )
    (default
      false
    )
  )
)

(fn-do + is-lines-declaration Bool
  (param tree AST)
  (param id SyntaxId)
  (match? ([] (. tree nodes) id)
    (case (call .node-declare row)
      (if (. row is-lazy)
        (return false)
      )
      (match? ([] (. tree nodes) (. row left))
        (case (call .node-type-capture capture)
          (match? ([] (. tree nodes) (. capture type))
            (case (call .node-type-list list)
              (return (call is-string-type tree (. list patterns)))
            )
          )
          (return (call is-string-list-call tree (. row right)))
        )
      )
    )
  )
  (return false)
)

(fn-do + is-string-list-call Bool
  (param tree AST)
  (param id SyntaxId)
  (match? ([] (. tree nodes) id)
    (case (call .node-call-expression call)
      (match? ([] (. tree nodes) (. call callable))
        (case (call .node-type-arguments type)
          (return (and (call is-type-named tree (. type base) "List") (call is-string-type tree (. type args))))
        )
      )
    )
  )
  (return false)
)

(fn-expr + is-string-type Bool
  (param tree AST)
  (param range (of RowRange SyntaxId))
  (and (== (. range count) 1) (call is-type-named tree ([] (. tree children) (. range start)) "String"))
)

(fn-do + joined-name String
  (param tree AST)
  (param id SyntaxId)
  (match? ([] (. tree nodes) id)
    (case (call .node-call-expression call)
      (match? ([] (. tree nodes) (. call callable))
        (case (call .node-get-expression get)
          (if (!= (. get name text) "join")
            (return "")
          )
          (let object (call identifier-text tree (. get object)))
          (if (!= (. object length) 0)
            (return object)
          )
          (for (in operand ([] (. tree children) (. call operands)))
            (let name (call identifier-text tree (call argument-value tree operand)))
            (if (!= (. name length) 0)
              (return name)
            )
          )
        )
      )
    )
  )
  (return "")
)

(fn-expr + argument-value SyntaxId
  (param tree AST)
  (param id SyntaxId)
  (match ([] (. tree nodes) id)
    (case (call .node-argument row)
      (. row expr)
    )
    (default
      id
    )
  )
)

(fn-do + only-locals Bool
  (param tree AST)
  (param body (of RowRange SyntaxId))
  (param result SyntaxId)
  (for (in statement ([] (. tree children) body))
    (if (and (!= statement result) (not (call is-local-or-return tree statement result)))
      (return false)
    )
  )
  (return true)
)

(fn-expr + is-local-or-return Bool
  (param tree AST)
  (param statement SyntaxId)
  (param result SyntaxId)
  (match ([] (. tree nodes) statement)
    (case .node-declare
      true
    )
    (case (call .node-return row)
      (== (. row expr) result)
    )
    (default
      false
    )
  )
)

(fn-do + is-long-interpolation Bool
  (param source LintSource)
  (param tree AST)
  (param id SyntaxId)
  (param locals (map String SyntaxId))
  (let parts (list SyntaxId))
  (call gather-parts tree id parts)
  (if (< (. parts length) 2)
    (return false)
  )
  (let names (list String))
  (let has-text false)
  (for (in part parts)
    (if (is ([] (. tree nodes) part) .node-string-syntax)
      (= has-text true)
    )
    (let name (call identifier-text tree part))
    (if (and (!= (. name length) 0) (!= ([] locals name) null) (not (has names name)))
      (+= names name)
    )
  )
  (if (or (not has-text) (< (. names length) 2))
    (return false)
  )
  (return (call is-long-brix-interpolation source tree parts))
)

(fn-expr _ is-paragraph Bool
  (param source LintSource)
  (param tree AST)
  (param id SyntaxId)
  (== (call (. source slice) start (+ start 10)) "(paragraph")
  (where
    (lazy begin (. ([] (. tree nodes loc) id) begin))
    (lazy start (call (. source offset-of) (. begin line) (. begin column)))
  )
)

(fn-do _ is-long-brix-interpolation Bool
  (param source LintSource)
  (param tree AST)
  (param parts (list SyntaxId))
  (let length Index 2)
  (for (in part parts)
    (let name (call identifier-text tree part))
    (match ([] (. tree nodes) part)
      (case (call .node-string-syntax row)
        (for (in char (. row text))
          (return-if true (if (== char (char "\n"))))
          (blank)
          (+= length
            (scope (if-expr (or (== char (char "\"")) (== char (char "\\")) (== char '$') is-tab) 2 1)
              (lazy is-tab (== char (char "\t")))
            )
          )
        )
      )
      (default
        (+= length
          (scope (if-expr (!= (. name length) 0) (+ 1 (. name length)) (+ 3 text-length))
            (lazy text-length (call utf16-length (call node-text source tree part)))
          )
        )
      )
    )
  )
  (return (>= length 80))
)

(fn-do _ gather-parts _
  (param tree AST)
  (param id SyntaxId)
  (param parts (list SyntaxId))
  (match? ([] (. tree nodes) id)
    (case (call .node-binary-expression row)
      (if (call is-concatenation (. row op))
        (call gather-parts tree (. row lhs) parts)
        (call gather-parts tree (. row rhs) parts)
        (return)
      )
    )
  )
  (+= parts id)
)
