(import ./linter)
(import ./source)
(import ./symbols)
(import /core/atom-pool)
(import /lang/ast/ast)
(import /lang/ast/ast-children)
(import /lang/ast/ast-nodes)
(import /lang/ast/error)
(import /lang/ast/module-resolver)
(import /lang/ast/row-range)
(import /lang/reader/brix)
(import /os/file)
(import /os/path)
(import /stream/sort)
(blank)
(prop + semantic-batch-file-limit _ (= 200))

(type + SemanticRootPlan
  ; A program the semantic rules type, with why it was chosen, the targets it covers, and every
  ; file it reaches.
  (prop + path String)
  (prop + reason String)
  (prop + covers (list String))
  (prop + reachable (list String))
  (prop + error (? String))
  (prop + compiled Bool)
  (fn-do + This _
    (param path String)
    (param reason String)
  )
)

(type + SemanticTargetPlan
  ; A target of the semantic rules, with the candidate roots that reach it and the chosen roots that
  ; cover it.
  (prop + path String)
  (prop + reachable-by (list String))
  (prop + covered-by (list String))
  (fn-do + This _
    (param path String)
  )
)

(type + SemanticCoveragePlan
  (prop + roots (list SemanticRootPlan))
  (prop + targets (list SemanticTargetPlan))
  (prop + uncovered (list String))
  (fn-do + This _)
)

(type + SemanticPlanner
  ; Chooses the programs the semantic rules type, as the reference's `planSemanticCoverage` does:
  ; every lint file of the project is read for its imports and for whether it runs code; the
  ; roots given explicitly are the roots, and otherwise the configured roots, the tests, the
  ; examples, the other programs, and the targets that run code are candidates, from which the
  ; one covering the most targets not yet covered is taken, the higher priority first among
  ; those tied, until no candidate covers one more.
  (prop + project-root String)
  (prop + search-paths (list Path))
  (prop + resolver ModuleResolver)
  (prop + sources (map String String))
  (blank)
  (prop _ atoms AtomPool)
  (prop _ graph (map String SemanticGraphNode))
  (prop _ order (list String))
  (fn-do + This _
    (param project-root String)
    (param search-paths (list Path))
    (let c-paths (map String (list Path)))
    (= resolver (call ModuleResolver search-paths c-paths))
  )
  (fn-do + plan SemanticCoveragePlan
    (param targets (list String))
    (param overrides (list String))
    (param configured (list String))
    ; The plan for the targets, all absolute paths, from the roots given (`overrides`) or else
    ; those the configuration names (`configured`) and the candidates found.
    (let target-paths (call unique-paths targets))
    (let override-paths (call unique-paths overrides))
    (let configured-paths (call unique-paths configured))
    (let seeds (list String))
    (++= seeds override-paths)
    (++= seeds configured-paths)
    (call build-graph target-paths seeds)
    (blank)
    (let candidates (list CandidateRoot))
    (if (!= (. override-paths length) 0)
      (for (in path override-paths)
        (+= candidates (call candidate-for path "explicit" 1000))
      )
      (else
        (= candidates (call heuristic-candidates target-paths configured-paths))
      )
    )
    (let selected (list CandidateRoot))
    (if (!= (. override-paths length) 0)
      (= selected candidates)
      (else
        (= selected (call greedy-coverage candidates target-paths))
        (for (in candidate candidates)
          (if (and (== (. candidate reason) "configured") (. candidate error))
            (+= selected candidate)
          )
        )
      )
    )
    (blank)
    (let plan (call SemanticCoveragePlan))
    (for (in candidate selected)
      (let root (call SemanticRootPlan (. candidate path) (. candidate reason)))
      (= (. root covers) (in each target-paths (when ([] (. candidate reachable) each))))
      (= (. root reachable) (call sorted-keys (. candidate reachable)))
      (= (. root error) (. candidate error))
      (+= (. plan roots) root)
    )
    (for (in path target-paths)
      (let target (call SemanticTargetPlan path))
      (= (. target reachable-by) (in (. each path) candidates (when ([] (. each reachable) path))))
      (= (. target covered-by) (in (. each path) selected (when ([] (. each reachable) path))))
      (if (== (. target covered-by length) 0)
        (+= (. plan uncovered) path)
      )
      (+= (. plan targets) target)
    )
    (return plan)
  )
  (fn-do + module-name String
    (param path String)
    ; The name of the module a file is, as the reference's `moduleNameForPath` gives it: its path in
    ; the first search root that holds it, else in the project, else its file name, without
    ; `.bx`.
    (for (in root search-paths)
      (let prefix (str root "/"))
      (return-if (call strip-extension ([] path (... (. prefix length)))) (if (call (. path starts-with) prefix)))
    )
    (let prefix (str project-root "/"))
    (return-if (call strip-extension ([] path (... (. prefix length)))) (if (call (. path starts-with) prefix)))
    (return (call strip-extension (. (call Path path) name)))
  )
  (fn-do _ build-graph _
    (param targets (list String))
    (param seeds (list String))
    (let discovered (map String Bool))
    (for (in path (call discover-lint-files project-root (list ".")))
      (= ([] discovered path) true)
    )
    (let pending (map String Bool))
    (for (in (tuple path _) discovered)
      (= ([] pending path) true)
    )
    (for (in path targets)
      (= ([] pending path) true)
    )
    (for (in path seeds)
      (= ([] pending path) true)
    )
    (blank)
    (while (!= (. pending length) 0)
      (let batch (call sorted-keys pending))
      (call (. pending clear))
      (for (in path batch)
        (let node (call SemanticGraphNode path (?? ([] discovered path) false)))
        (= ([] graph path) node)
        (+= order path)
        (call scan node)
      )
      (for (in path batch)
        (for (in imported (. (!! ([] graph path)) imports))
          (if (not ([] graph imported))
            (= ([] pending imported) true)
          )
        )
      )
    )
  )
  (fn-do _ source-text String (?! Error)
    (param path String)
    (let held ([] sources path))
    (if held
      (return held)
    )
    (return (call file-text path))
  )
  (fn-do _ scan _
    (param node SemanticGraphNode)
    ; Reads a file for whether it runs code and the files it imports, or the error that keeps it out
    ; of every root's reach.
    (if (not (call is-lint-path (. node path)))
      (= (. node error) "Semantic roots must be .bx files")
      (return)
    )
    (let text (catch (call source-text (. node path))))
    (if (is text Error)
      (= (. node error) (. (as text Error) message))
      (return)
    )
    (let builder
      (call parse-brix text (. node path)
        (block
          (on-error (: failure BrixSyntaxError)
            (= (. node error) (. failure message))
            (return)
          )
        )
      )
    )
    (let tree (use (call (. builder finish) atoms)))
    (= (. node executable) (call has-executable-shape tree))
    (let found (map String Bool))
    (match ([] (. tree nodes) (. tree root))
      (case (call .node-top-level-syntax root)
        (for (in id ([] (. tree children) (. root statements)))
          (match? ([] (. tree nodes) id)
            (case (call .node-import-syntax import)
              (let text-path (call import-path-text tree (. import paths)))
              (if (not (call (. text-path ends-with) ".h"))
                (let resolved (call (. resolver resolve-module) text-path (. node path)))
                (if resolved
                  (= ([] found (as (. resolved path) String)) true)
                )
              )
            )
          )
        )
      )
      (throw (call Panic "AST root has the wrong syntax case"))
    )
    (= (. node imports) (call sorted-keys found))
  )
  (fn-do _ heuristic-candidates (list CandidateRoot)
    (param targets (list String))
    (param configured (list String))
    (let candidates (list CandidateRoot))
    (let positions (map String Index))
    (for (in path configured)
      (call add-candidate candidates positions (call candidate-for path "configured" 1000))
    )
    (for (in path order)
      (let node (!! ([] graph path)))
      (if (and (. node discovered) (. node executable))
        (let kind (call root-kind path))
        (call add-candidate candidates positions (call candidate-for path ([] kind 0) ([] kind 1)))
      )
    )
    (for (in path targets)
      (let node ([] graph path))
      (if (and node (. node executable))
        (call add-candidate candidates positions (call candidate-for path "target-executable" 100))
      )
    )
    (return candidates)
  )
  (fn-do _ add-candidate _
    (param candidates (list CandidateRoot))
    (param positions (map String Index))
    (param candidate CandidateRoot)
    (let position ([] positions (. candidate path)))
    (if (not position)
      (= ([] positions (. candidate path)) (. candidates length))
      (+= candidates candidate)
      (else-if (> (. candidate priority) (. ([] candidates position) priority))
        (= ([] candidates position) candidate)
      )
    )
  )
  (fn-expr _ candidate-for CandidateRoot
    (param path String)
    (param reason String)
    (param priority I64)
    (call CandidateRoot path reason priority (call reachable-files path) (only-if (. node error) (if node)))
    (where
      (lazy node ([] graph path))
    )
  )
  (fn-do _ reachable-files (map String Bool)
    (param path String)
    (let reachable (map String Bool))
    (let queue (list String))
    (+= queue path)
    (while (!= (. queue length) 0)
      (let current (call (. queue pop)))
      (if ([] reachable current)
        (continue)
      )
      (let node ([] graph current))
      (if (or (not node) (. node error))
        (continue)
      )
      (= ([] reachable current) true)
      (for (in imported (. node imports))
        (if (not ([] reachable imported))
          (+= queue imported)
        )
      )
    )
    (return reachable)
  )
)

(fn-do + semantic-root-batches (list (list SemanticRootPlan))
  (param roots (list SemanticRootPlan))
  ; The roots typed together, in order, as the reference batches them: a root joins the batch
  ; before it unless the files the batch and it reach would pass `semantic-batch-file-limit`.
  (let batches (list (list SemanticRootPlan)))
  (let batch (list SemanticRootPlan))
  (let reachable (map String Bool))
  (for (in root roots)
    (let combined (map String Bool))
    (for (in (tuple path _) reachable)
      (= ([] combined path) true)
    )
    (for (in path (. root reachable))
      (= ([] combined path) true)
    )
    (if (and (!= (. batch length) 0) (> (. combined length) semantic-batch-file-limit))
      (+= batches batch)
      (let fresh (list SemanticRootPlan))
      (= batch fresh)
      (call (. reachable clear))
      (for (in path (. root reachable))
        (= ([] reachable path) true)
      )
      (else
        (= reachable combined)
      )
    )
    (+= batch root)
  )
  (if (!= (. batch length) 0)
    (+= batches batch)
  )
  (return batches)
)

(fn-do + sorted-keys (list String)
  (param map (map String Bool))
  (let keys (list String))
  (for (in (tuple key _) map)
    (+= keys key)
  )
  (return (call sort keys))
)

(type _ SemanticGraphNode
  (prop + path String)
  (prop + imports (list String))
  (prop + discovered Bool)
  (prop + executable Bool)
  (prop + error (? String))
  (fn-do + This _
    (param path String)
    (param discovered Bool)
  )
)

(type _ CandidateRoot
  (prop + path String)
  (prop + reason String)
  (prop + priority I64)
  (prop + reachable (map String Bool))
  (prop + error (? String))
  (fn-do + This _
    (param path String)
    (param reason String)
    (param priority I64)
    (param reachable (map String Bool))
    (param error (? String))
  )
)

(fn-do _ greedy-coverage (list CandidateRoot)
  (param candidates (list CandidateRoot))
  (param targets (list String))
  (let remaining (map String Bool))
  (for (in path targets)
    (= ([] remaining path) true)
  )
  (let pool (list CandidateRoot))
  (++= pool candidates)
  (let selected (list CandidateRoot))
  (while (!= (. remaining length) 0)
    (let best -1)
    (let best-coverage 0)
    (let best-priority I64 -1)
    (for (in position (..< 0 (. pool length)))
      (let coverage (call covered-count (. ([] pool position) reachable) remaining))
      (let wider (> coverage best-coverage))
      (if (or wider (and (== coverage best-coverage) (> coverage 0) is-higher-priority))
        (= best position)
        (= best-coverage coverage)
        (= best-priority (. ([] pool position) priority))
      )
      (lazy is-higher-priority (> (. ([] pool position) priority) best-priority))
    )
    (if (or (< best 0) (== best-coverage 0))
      (break)
    )
    (let chosen ([] pool best))
    (call (. pool remove) best)
    (+= selected chosen)
    (for (in (tuple path _) (. chosen reachable))
      (-= ([] remaining path))
    )
  )
  (return selected)
)

(fn-do _ covered-count Int
  (param reachable (map String Bool))
  (param targets (map String Bool))
  (let count 0)
  (for (in (tuple path _) targets)
    (if ([] reachable path)
      (+= count 1)
    )
  )
  (return count)
)

(fn-expr _ root-kind (tuple String I64)
  (param path String)
  (case? (or (!= (call (. path find) "/test/") null) (!= (call (. path find) "/tests/") null) named-test)
    (tuple "test" 800)
  )
  (case? (or (!= (call (. path find) "/examples/") null) (call (. path starts-with) "examples/"))
    (tuple "example" 500)
  )
  (default
    (tuple "executable" 200)
  )
  (where
    (lazy name (. (call Path path) name))
    (lazy named-test (or (== name "test.bx") (== name "tests.bx")))
  )
)

(fn-do _ has-executable-shape Bool
  (param tree AST)
  ; Whether a module runs code of its own, as the reference's `hasExecutableShape` decides: a line
  ; that is not an import, a declaration of a type, function, extension, unit or converter, a rule,
  ; or a property, but for a property holding a state machine.
  (match ([] (. tree nodes) (. tree root))
    (case (call .node-top-level-syntax root)
      (for (in id ([] (. tree children) (. root statements)))
        (if (call runs-code tree id)
          (return true)
        )
      )
    )
    (throw (call Panic "AST root has the wrong syntax case"))
  )
  (return false)
)

(fn-expr _ runs-code Bool
  (param tree AST)
  (param id SyntaxId)
  (match ([] (. tree nodes) id)
    (case (call .node-property-syntax row)
      (is ([] (. tree nodes) (. row value)) .node-state-machine)
    )
    (case .node-import-syntax
      false
    )
    (case .node-class-block
      false
    )
    (case .node-function-syntax
      false
    )
    (case .node-getter-syntax
      false
    )
    (case .node-setter-syntax
      false
    )
    (case .node-extension
      false
    )
    (case .node-style-sheet-extension
      false
    )
    (case .node-unit-declaration
      false
    )
    (case .node-fromverter-syntax
      false
    )
    (case .node-converter-syntax
      false
    )
    (case .node-when-rule-syntax
      false
    )
    (case .node-whenever-rule-syntax
      false
    )
    (case .node-noop
      false
    )
    (default
      true
    )
  )
)

(fn-do _ unique-paths (list String)
  (param paths (list String))
  (let seen (map String Bool))
  (for (in path paths)
    (= ([] seen path) true)
  )
  (return (call sorted-keys seen))
)

(fn-expr _ strip-extension String
  (param path String)
  (if-expr (call (. path ends-with) ".bx") ([] path (..< 0 (- (. path length) 3))) path)
)

(fn-do _ file-text String (?! Error)
  (param path String)
  (let text-file (use (call File path)))
  (let text (as text-file String))
  (return text)
)
