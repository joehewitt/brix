./brix-fixes
./diagnostics
./rule-context
./semantic-facts
./source

━━━━━━━━━━━━━━━━━━━━
+ do run-semantic-rule
    - rule-id String
    - source LintSource
    - facts SemanticFacts
    - context RuleContext

if rule-id == "style/no-redundant-default-initializer"
    lint-redundant-default(source, facts, context)
if rule-id == "style/prefer-constructor-initializer"
    lint-constructor-overwrite(source, facts, context)
if rule-id == "style/no-redundant-context-cast"
    lint-context-cast(facts, context)
if rule-id == "style/no-redundant-literal-suffix"
    lint-literal-suffix(source, facts, context)
if rule-id == "events/no-effectful-payload"
    lint-payload-effects(facts, context)
if rule-id == "names/case-owner-conflict"
    lint-case-owners(facts, context)

━━━━━━━━━━━━━━━━━━━━
+ do lint-payload-effects
    - facts SemanticFacts
    - context RuleContext

` Reports the payload of an event that has effects, once for each set of effects instances found
` at it, as the reference's `events/no-effectful-payload` does.
. seen [String = Bool]
for payload in facts.payloads
    . key = "${payload.line}:${payload.column}:${payload.event}:${payload.effects}"
    if seen[key]
        continue
    seen[key] = true
    . message = "Move side effects out of event \"${payload.event}\" payload; event payloads run "
    message += "lazily only when observed. Found ${payload.effects}."
    context.report(message, payload.line, payload.column)

━━━━━━━━━━━━━━━━━━━━
+ do lint-case-owners
    - facts SemanticFacts
    - context RuleContext

` Reports a case given by its symbol alone that functions a call may choose take as a case of
` more than one type, once for each place and name, as the reference's
` `names/case-owner-conflict` does.
. seen [String = Bool]
for found in facts.case-owners
    . key = "${found.line}:${found.column}:${found.name}"
    if seen[key]
        continue
    seen[key] = true
    . quoted [String]
    for owner in found.owners
        quoted += "'$owner'"
    . last = quoted[quoted.length - 1]
    quoted.pop()
    . listed = "${", ".join(quoted)} and $last"
    . message = "Write '${found.chosen}.${found.name}'; overloads of this call accept "
    message += "'.${found.name}' from $listed, and visibility order chose '${found.chosen}'."
    context.report(message, found.line, found.column)

━━━━━━━━━━━━━━━━━━━━
+ do lint-context-cast
    - facts SemanticFacts
    - context RuleContext

` Reports a cast to the type its place already takes the value as, in an instance that typed
` it, as the reference's `style/no-redundant-context-cast` does: for review where instances
` cast to different types, or where the instance's function or class takes type parameters,
` since other type arguments may need the cast.
. order [String]
. groups [String = [SemanticCast]]
for cast in facts.casts
    . key = "${cast.line}:${cast.column}"
    if !groups[key]
        order += key
        . group [SemanticCast]
        groups[key] = group
    groups[key]! += cast
for key in order
    . group = groups[key]!
    . first = group[0]
    . review = false
    for cast in group
        if cast.target != first.target || cast.is-generic
            review = true
    . target = "cast to \"${first.target}\""
    if review
        . written = first.written.length != 0 && first.written != first.target
        . shown = if written then " (source target \"${first.written}\")" else ""
        . message = "Review observed redundant $target$shown; ${first.context} provided that "
        message += "type context in an observed instantiation, but this generic cast may affect "
        message += "dispatch for other type arguments."
        context.report(message, first.line, first.column, "review")
    else
        . message = "Remove redundant $target; ${first.context} already provides that type context."
        context.report(message, first.line, first.column)

━━━━━━━━━━━━━━━━━━━━
+ do lint-literal-suffix
    - source LintSource
    - facts SemanticFacts
    - context RuleContext

. seen [String = Bool]
for suffix in facts.suffixes
    . key = "${suffix.line}:${suffix.column}"
    if seen[key]
        continue
    seen[key] = true
    . fix = if source.is-brix then brix-fix else suffix-removal(source, suffix)
        .. brix-fix = brix-suffix-fix(source, suffix.line, suffix.column, suffix.unit)
    if !fix
        continue
    . lead = "Remove redundant suffix \"${suffix.unit}\";"
    . message = "$lead where it is written, the number already takes that type."
    context.report(message, suffix.line, suffix.column, "actionable", fix)

━━━━━━━━━━━━━━━━━━━━
+ suffix-removal LintFix?
    - source LintSource
    - suffix SemanticSuffix

|? suffix.end-line != suffix.line || cut <= suffix.column
    null
|? source.slice(start, end) != suffix.unit
    null
??
    LintFix("safe", "Remove redundant suffix", [edit])

.. row = suffix.line - 1
.. cut = suffix.end-column - (suffix.unit.length as U32)
.. start = source.offset-of(row, cut - 1)
.. end = source.offset-of(row, suffix.end-column - 1)
.. line = source.lines[row]
.. first = source.utf16-line-starts[row] + utf16-length(line[0 .. < cut - 1])
.. last = source.utf16-line-starts[row] + utf16-length(line[0 .. < suffix.end-column - 1])
.. edit = LintTextEdit(first, last, "", suffix.unit)

━━━━━━━━━━━━━━━━━━━━
+ do lint-redundant-default
    - source LintSource
    - facts SemanticFacts
    - context RuleContext

` Reports a value written as the default of the type it is declared as, where every instance
` that typed it declared one type, with a fix that removes it, as the reference's
` `style/no-redundant-default-initializer` does.
. order [String]
. groups [String = [SemanticDefault]]
for value in facts.defaults
    . key = "${value.line}:${value.column}"
    if !groups[key]
        order += key
        . group [SemanticDefault]
        groups[key] = group
    groups[key]! += value
for key in order
    . group = groups[key]!
    . first = group[0]
    . same = true
    for value in group
        if value.type-name != first.type-name
            same = false
    if same
        . message = "Omit initializer; the declared type already supplies this default."
        . fix = if source.is-brix then brix-fix else default-removal(source, first)
            .. brix-fix = brix-default-fix(source, first.line, first.column)
        context.report(message, first.line, first.column, "actionable", fix)

━━━━━━━━━━━━━━━━━━━━
+ default-removal LintFix?
    - source LintSource
    - value SemanticDefault

` The edit that removes a value and the `=` before it, from where its type ends, where both end
` on the line the value is written on and only spaces lie around the `=`.
|? value.type-end-line != value.line || value.end-line != value.line
    null
|? end <= begin || !is-assignment-gap(source.slice(start, begin))
    null
??
    LintFix("safe", "Omit redundant default initializer", [edit])

.. row = value.line - 1
.. start = source.offset-of(row, value.type-end-column - 1)
.. begin = source.offset-of(row, value.column - 1)
.. end = source.offset-of(row, value.end-column - 1)
.. line = source.lines[row]
.. first = source.utf16-line-starts[row] + utf16-length(line[0 .. < value.type-end-column - 1])
.. last = source.utf16-line-starts[row] + utf16-length(line[0 .. < value.end-column - 1])
.. edit = LintTextEdit(first, last, "", source.slice(start, end))

━━━━━━━━━━━━━━━━━━━━
+ do is-assignment-gap Bool
    - text String

` Whether text is one `=` with only spaces and tabs around it.
. equals = 0
for char in text
    if char == '='
        equals += 1
    else if char != ' ' && char != '\t'
        = false
= equals == 1

━━━━━━━━━━━━━━━━━━━━
+ do lint-constructor-overwrite
    - source LintSource
    - facts SemanticFacts
    - context RuleContext

` Reports a constructor's assignment that discards the value the constructor built for a
` property, once for where it is written, as the instance typed first saw it, with a fix that
` makes it an initializer where one can take its place, as the reference's
` `style/prefer-constructor-initializer` does.
. seen [String = Bool]
for overwrite in facts.overwrites
    . key = "${overwrite.line}:${overwrite.column}"
    if seen[key]
        continue
    seen[key] = true
    . name = overwrite.name
    . type = overwrite.type-name
    if overwrite.actionable
        . lead = "Initialize $name with `..`; this assignment discards the default"
        . message = "$lead $type the constructor already built."
        . fix = if source.is-brix then brix-fix else initializer-fix(source, overwrite)
            .. brix-fix = brix-initializer-fix(source, overwrite.line, overwrite.column, name)
        context.report(message, overwrite.line, overwrite.column, "actionable", fix)
    else
        . lead = "This assignment discards the default $type the constructor already built"
        . tail = "initialize it with `..` if its value does not depend on earlier statements."
        context.report("$lead for $name; $tail", overwrite.line, overwrite.column, "review")

━━━━━━━━━━━━━━━━━━━━
+ initializer-fix LintFix?
    - source LintSource
    - overwrite SemanticOverwrite

` The edit that makes an assignment's target, the property by its name or through `this`, an
` initializer of it.
|? target != name && target != "this.$name"
    null
??
    LintFix("safe", "Initialize with `..`", [edit])

.. row = overwrite.target-line - 1
.. start = source.offset-of(row, overwrite.target-column - 1)
.. end = source.offset-of(row, overwrite.target-end-column - 1)
.. target = source.slice(start, end)
.. name = overwrite.name
.. line = source.lines[row]
.. first = source.utf16-line-starts[row] + utf16-length(line[0 .. < overwrite.target-column - 1])
.. last = source.utf16-line-starts[row] + utf16-length(line[0 .. < overwrite.target-end-column - 1])
.. edit = LintTextEdit(first, last, ".. $name", target)
