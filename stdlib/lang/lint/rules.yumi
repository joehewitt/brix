+ map-pair Bool
    - tree AST
    - id SyntaxId

match tree.nodes[id]
    | .node-argument(arg)
        !arg.name && !arg.is-optional && is-pair(tree, arg.expr)
    ??
        false

━━━━━━━━━━━━━━━━━━━━
