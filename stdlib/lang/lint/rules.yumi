match tree.nodes[id]
    | .node-assign(row)
        = row.rhs
    ?! Panic("Expected an assignment")

━━━━━━━━━━━━━━━━━━━━
+ do initial-entries-fix LintFix?
    - source LintSource
    - tree AST
    - declaration SyntaxId
    - call SyntaxId
    - statements [SyntaxId]

` The edit that writes the entries a map is first given as a map literal, or none where they are
` not each one line at the declaration's indent.
. call-loc = tree.nodes.loc[call]
if call-loc.begin.line != call-loc.end.line
    = null
. callable = match tree.nodes[call]
    | .node-call-expression(row)
        row.callable
    ?! Panic("Expected a call")
. type-text = node-text(source, tree, callable)
if node-text(source, tree, call) != "$type-text()"
    = null

. place = tree.nodes.loc[declaration].begin
. line = source.lines[place.line]
if place.column > line.length || !is-blank-text(line[0 .. < place.column])
    = null
. base = line[0 .. < place.column]
. line-break = entries-line-break(source, tree, call, statements, base)
if !line-break
    = null

. keys [SyntaxId]
. values [SyntaxId]
for statement in statements
    keys += map-entry-key(tree, statement)
    values += map-entry-value(tree, statement)
. bullets = map-pair-lines(source, tree, keys, values, "$base    ")
if !bullets
    = null

. start = node-start(source, tree, call)
. end = node-end(source, tree, statements[statements.length - 1])
. replacement = "$type-text$line-break${line-break.join(bullets)}"
= LintFix("safe", "Use map literal syntax", [text-edit(source, start, end, replacement)])

━━━━━━━━━━━━━━━━━━━━
+ do entries-line-break String?
    - source LintSource
    - tree AST
    - call SyntaxId
    - statements [SyntaxId]
    - indent String

` The line break between a map's declaration and each entry it is given, where each entry is one
` line at `indent` right after the last.
. previous = call
. found = ""
for statement in statements
    . loc = tree.nodes.loc[statement]
    if loc.begin.line != loc.end.line || loc.begin.column != indent.length
        = null
    . gap = source.slice(node-end(source, tree, previous), node-start(source, tree, statement))
    . line-break = if gap.starts-with("\r\n") then "\r\n" else "\n"
    if gap != "$line-break$indent" || (found.length != 0 && found != line-break)
        = null
    found = line-break
    previous = statement
= found if found.length != 0

━━━━━━━━━━━━━━━━━━━━
+ do map-pair-lines [String]?
    - source LintSource
    - tree AST
    - keys [SyntaxId]
    - values [SyntaxId]
    - indent String

` The bullets of a map literal that write each key with its value, or none where one is not
` written on one line.
. lines [String]
for position in 0 .. < keys.length
    . key = node-text(source, tree, keys[position])
    . value = node-text(source, tree, values[position])
    if key.length == 0 || value.length == 0 || key.find("\n") || value.find("\n")
        = null
    . literal = if tree.nodes[keys[position]] is .node-string-syntax then key else "($key)"
    lines += "$indent• $literal $value"
= lines

━━━━━━━━━━━━━━━━━━━━
+ do map-constructor-fix LintFix?
    - source LintSource
    - tree AST
    - id SyntaxId
    - call ASTCallExpression

` The edit that writes the pairs a map is constructed from as a map literal, or none where each is
` not a bullet on a line of its own.
. args [SyntaxId]
for arg in tree.children[call.args]
    args += arg
. start = node-start(source, tree, id)
. type-end = node-end(source, tree, call.callable)
. end = node-end(source, tree, args[args.length - 1])
. gap = source.slice(type-end, node-start(source, tree, args[0]))
if !gap.starts-with("()")
    = null
. rest = gap[2 .. < gap.length]
. line-break = if rest.starts-with("\r\n") then "\r\n" else "\n"
if !rest.starts-with(line-break)
    = null
. indent = rest[line-break.length .. < rest.length]
if !is-blank-text(indent)
    = null

for position in 0 .. < args.length
    . loc = tree.nodes.loc[args[position]]
    if loc.begin.line != loc.end.line || !is-bullet-pair(node-text(source, tree, args[position]))
        = null
    if position + 1 < args.length
        . ending = node-end(source, tree, args[position])
        . following = node-start(source, tree, args[position + 1])
        if source.slice(ending, following) != "$line-break$indent"
            = null

. keys [SyntaxId]
. values [SyntaxId]
for arg in args
    keys += pair-item(tree, arg, 0)
    values += pair-item(tree, arg, 1)
. bullets = map-pair-lines(source, tree, keys, values, indent)
if !bullets
    = null

. head = source.slice(start, type-end)
. replacement = "$head$line-break${line-break.join(bullets)}"
= LintFix("safe", "Use map literal syntax", [text-edit(source, start, end, replacement)])

━━━━━━━━━━━━━━━━━━━━
+ do is-bullet-pair Bool
    - text String

` Whether an argument is written as a bullet of one parenthesized pair.
if !text.starts-with("-") || !text.ends-with(")")
    = false
. position = 1
while position < text.length && is-space-char(text[position])
    position += 1
= position + 2 < text.length && text[position] == '('

━━━━━━━━━━━━━━━━━━━━
+ do is-blank-text Bool
    - text String

for char in text
    if char != ' ' && char != '\t'
        = false
= true

━━━━━━━━━━━━━━━━━━━━
+ HandlerUse

` What the body of a key handler does with its event: reads it other than to select by key,
` selects by key, and calls something other than to cancel it outside a condition.

+ raw Bool
+ selector Bool
+ command Bool

────────────────────
+ This

━━━━━━━━━━━━━━━━━━━━
+ do lint-shortcut-node
    - tree AST
    - context RuleContext

. attached = attached-nodes(tree)
for id in 1u32 .. < tree.nodes.length
    if !attached[id]
        continue
    do match? tree.nodes[id]
        | .node-for-block(row)
            do match? tree.nodes[row.loop]
                | .node-loop-syntax(loop)
                    report-shortcut-node(tree, row, loop, context)

━━━━━━━━━━━━━━━━━━━━
_ do report-shortcut-node
    - tree AST
    - handler ASTForBlock
    - loop ASTLoop
    - context RuleContext

if !loop.is-subscriber
    =
. source-name = match tree.nodes[loop.container]
    | .node-identifier(row)
        row.name.text
    ??
        ""
if source-name != "key-press" && source-name != "key-input"
    =

. purpose = shortcut-purpose(tree, handler, loop)
if purpose == "raw"
    =
. message = "Review whether this $source-name handler dispatches a command; "
if purpose == "command"
    message = "Review $source-name command dispatch as a <Shortcut> candidate; "
message += "confirm a compatible <Shortcut> is available and preserve focus/modal eligibility, "
message += "cancellation, propagation, repeat/sequences, and handler order."
. loc = tree.nodes.loc[handler.loop].begin
context.report(message, loc.line + 1, loc.column + 1, "review")

━━━━━━━━━━━━━━━━━━━━
+ do shortcut-purpose String
    - tree AST
    - handler ASTForBlock
    - loop ASTLoop

` Whether a key handler only reads raw input, dispatches a command by key, or neither is known.
. event = declared-name(tree, loop.pattern)
if event.length == 0 || handler.body == 0
    = "unknown"
. use = HandlerUse()
gather-handler-use(tree, handler.body, event, false, false, false, use)
if use.raw || is-cancellation-only(tree, handler.body, event)
    = "raw"
if loop.next != 0 || loop.clause != 0 || handler.next != 0
    = "unknown"
= if use.selector && use.command then "command" else "unknown"

━━━━━━━━━━━━━━━━━━━━
_ do gather-handler-use
    - tree AST
    - id SyntaxId
    - event String
    - in-condition Bool
    - in-selector Bool
    - is-object Bool
    - use HandlerUse

` Notes what a node of a handler's body does with its event, where `in-condition` says it is in
` an `if` condition, `in-selector` that it is in one or in a match subject, and `is-object` that it
` is the object a member is read from.
if id == 0
    =
do match? tree.nodes[id]
    | .node-identifier(row)
        if row.name.text == event && !is-object
            use.raw = true
    | .node-get-expression(row)
        if is-named(tree, row.object, event)
            . property = row.name.text
            if property != "cancel"
                if property != "key" && property != "char" && property != "modifier"
                    use.raw = true
                else if in-selector
                    use.selector = true
                else
                    use.raw = true
        gather-handler-use(tree, row.object, event, in-condition, in-selector, true, use)
        =
    | .node-call-expression
        if !is-cancel(tree, id, event) && !in-condition
            use.command = true
    | .node-if-block(row)
        gather-handler-use(tree, row.condition, event, true, true, false, use)
        gather-handler-use(tree, row.body, event, in-condition, in-selector, false, use)
        gather-handler-use(tree, row.next, event, in-condition, in-selector, false, use)
        =
    | .node-match-expression(row)
        for child in tree.children-of(id)
            . selects = in-selector || child == row.subject
            gather-handler-use(tree, child, event, in-condition, selects, false, use)
        =

for child in tree.children-of(id)
    gather-handler-use(tree, child, event, in-condition, in-selector, false, use)

━━━━━━━━━━━━━━━━━━━━
+ do is-cancellation-only Bool
    - tree AST
    - id SyntaxId
    - event String

` Whether a node only cancels the event, under conditions that call nothing.
do match? tree.nodes[id]
    | .node-block(row)
        if row.body.count == 0
            = false
        for statement in tree.children[row.body]
            if !is-cancellation-only(tree, statement, event)
                = false
        = true
    | .node-if-block(row)
        if calls-anything(tree, row.condition) || !is-cancellation-only(tree, row.body, event)
            = false
        = row.next == 0 || is-cancellation-only(tree, row.next, event)
= is-cancel(tree, id, event)

━━━━━━━━━━━━━━━━━━━━
+ do calls-anything Bool
    - tree AST
    - id SyntaxId

if id == 0
    = false
if tree.nodes[id] is .node-call-expression
    = true
for child in tree.children-of(id)
    if calls-anything(tree, child)
        = true
= false

━━━━━━━━━━━━━━━━━━━━
+ do is-cancel Bool
    - tree AST
    - id SyntaxId
    - event String

` Whether a node calls `cancel` on the event with no arguments.
do match? tree.nodes[id]
    | .node-call-expression(call)
        if call.operands.count != 0
            = false
        do match? tree.nodes[call.callable]
            | .node-get-expression(row)
                = row.name.text == "cancel" && is-named(tree, row.object, event)
= false

━━━━━━━━━━━━━━━━━━━━
+ ShorthandScope

` The types an assignment in a style context can reach: those the linted module declares, and
` those its imports make visible, found by name from the module that names them.

+ analysis ModuleAnalysis
+ locals [StyleClass]
_ classes [String = [StyleClass]]

────────────────────
+ This
    - analysis ModuleAnalysis

.. locals = collect-style-classes(analysis.tree, "", false)

────────────────────
+ do local-class StyleClass
    - id SyntaxId

` The linted module's own type declared at `id`.
. key = "#$id"
for found in locals
    if found.key == key
        = found
?! Panic("Expected a class block")

────────────────────
+ do resolve StyleClass?
    - name String
    - module-path String

` The one type `name` names from a module, or none where it names none or several.
if name.length == 0
    = null
if module-path.length == 0
    . named [StyleClass]
    for found in locals
        if found.names(name)
            named += found
    if named.length != 0
        = named[0] if named.length == 1

. key = "$module-path\n$name"
if !classes[key]
    classes[key] = visible-classes(name, module-path)
. matches = classes[key]!
= matches[0] if matches.length == 1

────────────────────
_ do visible-classes [StyleClass]
    - name String
    - module-path String

` The types `name` names from a module: its own, then the public ones its imports export.
. found [StyleClass]
. seen [String = Bool]
. visited [String = Bool]
visited[module-path] = true
. analyzer = analysis.analyzer!
. imports = analysis.imports
. origin = analysis.source.path
if module-path.length != 0
    . module = analyzer.module-at(module-path)
    if !module
        = found
    for type in module.classes
        if type.names(name) && !seen[type.key]
            seen[type.key] = true
            found += type
    imports = module.imports
    origin = module-path
for entry in imports
    . imported = analyzer.imported-module(entry, origin)
    if imported
        gather-exported(imported, name, visited, seen, found)
= found

────────────────────
_ do gather-exported
    - module ExportedModule
    - name String
    - visited [String = Bool]
    - seen [String = Bool]
    - found [StyleClass]

if visited[module.path]
    =
visited[module.path] = true
for type in module.classes
    if type.is-public && type.names(name) && !seen[type.key]
        seen[type.key] = true
        found += type
for entry in module.exports
    . exported = analysis.analyzer!.imported-module(entry, module.path)
    if exported
        gather-exported(exported, name, visited, seen, found)

────────────────────
+ do expand [StyleClass]
    - roots [StyleClass]

` The types `roots` reach through the types each uses or implements.
. seen [String = Bool]
. result [StyleClass]
. pending [StyleClass]
for root in roots
    pending += root
while pending.length != 0
    . owner = pending.pop()
    if seen[owner.key]
        continue
    seen[owner.key] = true
    result += owner
    for reference in owner.references
        . found = resolve(reference, owner.module-path)
        if found && !seen[found.key]
            pending += found
= result

────────────────────
+ do owners-at [StyleClass]
    - stack [SyntaxId]

` The types whose style an assignment sets, from the markups and types around it, innermost first;
` none outside a style rule or markup, or inside a function before one.
. tree = analysis.tree
. owners [StyleClass]
. in-context = false
for step in 0 .. < stack.length
    . id = stack[stack.length - 1 - step]
    do match? tree.nodes[id]
        | .node-function-syntax
            if !in-context
                = List'StyleClass()
        | .node-markup(row)
            . owner = resolve(plain-type-name(tree, row.type-id), "")
            if !owner
                = List'StyleClass()
            owners += owner
            in-context = true
        | .node-slot-outlet
            = List'StyleClass()
        | .node-style-sheet-extension
            = List'StyleClass()
        | .node-rule-syntax
            in-context = true
        | .node-class-block
            if !in-context
                = List'StyleClass()
            owners += local-class(id)
if !in-context
    = List'StyleClass()
= owners

━━━━━━━━━━━━━━━━━━━━
+ property-styles [StyleClass]
    - owners [StyleClass]
    - property String

each in owners when each.is-style && each.properties[property]

━━━━━━━━━━━━━━━━━━━━
+ StyleShorthand is Tuple

+ owner StyleClass
+ rule String

━━━━━━━━━━━━━━━━━━━━
+ do lint-shorthands
    - analysis ModuleAnalysis
    - context RuleContext

. scope = ShorthandScope(analysis)
. attached = attached-nodes(analysis.tree)
. stack [SyntaxId]
walk-shorthands(scope, analysis.tree.root, stack, context)

━━━━━━━━━━━━━━━━━━━━
_ do walk-shorthands
    - scope ShorthandScope
    - id SyntaxId
    - stack [SyntaxId]
    - context RuleContext

. tree = scope.analysis.tree
do match? tree.nodes[id]
    | .node-assign(row)
        if identifier-name(tree, row.lhs).length != 0 && !is-tracked-tree(tree, id)
            report-shorthand(scope, row, stack, context)
stack += id
for child in tree.children-of(id)
    walk-shorthands(scope, child, stack, context)
stack.pop()

━━━━━━━━━━━━━━━━━━━━
+ do is-tracked-tree Bool
    - tree AST
    - id SyntaxId

do match? tree.nodes[id]
    | .node-identifier(row)
        if row.is-tracked
            = true
    | .node-get-expression(row)
        if row.is-tracked
            = true
for child in tree.children-of(id)
    if is-tracked-tree(tree, child)
        = true
= false

━━━━━━━━━━━━━━━━━━━━
_ do report-shorthand
    - scope ShorthandScope
    - assignment ASTAssign
    - stack [SyntaxId]
    - context RuleContext

` Reports the shortest style shorthand that forwards to the property an assignment sets, where
` one style the site sees declares the property and the shorthand's own type sees the same one.
. owners = scope.owners-at(stack)
if owners.length == 0
    =
. tree = scope.analysis.tree
. property = identifier-name(tree, assignment.lhs)
. visible = scope.expand(owners)
. site-styles = property-styles(visible, property)
if site-styles.length != 1
    =
for owner in visible
    if !owner.is-style && owner.properties[property]
        =

. counts [String = Int]
for owner in visible
    for rule in owner.rules
        counts[rule] = (counts[rule] ?? 0) + 1

. best StyleShorthand? = null
for owner in visible
    for position in 0 .. < owner.rules.length
        . rule = owner.rules[position]
        if owner.forwarded[position] != property || counts[rule] != 1
            continue
        if is-inside-rule(tree, stack, rule)
            continue
        . styles = property-styles(scope.expand([owner]), property)
        if styles.length != 1 || styles[0].key != site-styles[0].key
            continue
        if !best || is-shorter-name(rule, best.rule)
            best = StyleShorthand(owner, rule)
if !best
    =

. found = best
. message = "Review style shorthand \"${found.rule}:\" from ${found.owner.name} for \"$property\"; "
message += "verify argument compatibility and style precedence before replacing the assignment."
. loc = tree.nodes.loc[assignment.lhs].begin
context.report(message, loc.line + 1, loc.column + 1, "review")

━━━━━━━━━━━━━━━━━━━━
+ do is-inside-rule Bool
    - tree AST
    - stack [SyntaxId]
    - name String

` Whether a site is inside the style rule `name` or inside a style rule with arguments.
for id in stack
    do match? tree.nodes[id]
        | .node-rule-syntax(row)
            if row.name.text == name || row.args.count != 0
                = true
= false

━━━━━━━━━━━━━━━━━━━━
+ is-shorter-name Bool
    - name String
    - other String

if name.length != other.length then name.length < other.length else name < other
