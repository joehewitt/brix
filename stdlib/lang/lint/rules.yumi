    | .node-tuple-syntax(row)
        row.items.count == 2
    ??
        false

━━━━━━━━━━━━━━━━━━━━
+ do pair-item SyntaxId
    - tree AST
    - argument SyntaxId
    - position U32

` An item of the pair an argument writes.
match tree.nodes[argument]
    | .node-argument(arg)
        match tree.nodes[arg.expr]
            | .node-tuple-syntax(row)
                = tree.children[row.items.start + position]
            ?! Panic("Expected a pair")
    ?! Panic("Expected an argument")

━━━━━━━━━━━━━━━━━━━━
+ do lint-initial-map-entries
    - source LintSource
    - tree AST
    - body RowRange'SyntaxId
    - context RuleContext

` Reports each empty map a block declares and then fills by its first statements.
for index in 0 .. < body.count
    . declaration = tree.children[body.start + index]
    . name = declared-local(tree, declaration)
    . call = empty-map-call(source, tree, declaration)
    if name.length == 0 || call == 0
        continue

    . statements [SyntaxId]
    for next in index + 1 .. < body.count
        . statement = tree.children[body.start + next]
        if !is-map-entry(tree, statement, name)
            break
        statements += statement
    if statements.length == 0
        continue

    . loc = tree.nodes.loc[call].begin
    . message = "Construct initial map entries with a map literal."
    . fix = if source.is-brix then brix-fix else text-fix
        .. brix-fix = brix-initial-entries-fix(source, tree, declaration, statements)
        .. text-fix = initial-entries-fix(source, tree, declaration, call, statements)
    context.report(message, loc.line + 1, loc.column + 1, "actionable", fix)

━━━━━━━━━━━━━━━━━━━━
+ do declared-local String
    - tree AST
    - id SyntaxId

` The name an eager declaration of one local gives, or none.
do match? tree.nodes[id]
    | .node-declare(row)
        if row.is-lazy
            = ""
        do match? tree.nodes[row.left]
            | .node-type-capture(capture)
                do match? tree.nodes[capture.id]
                    | .node-identifier(name)
                        = name.name.text
= ""

━━━━━━━━━━━━━━━━━━━━
+ do empty-map-call SyntaxId
    - source LintSource
    - tree AST
    - id SyntaxId

` The call that constructs an empty map as a declaration's value, or none.
do match? tree.nodes[id]
    | .node-declare(row)
        do match? tree.nodes[row.right]
            | .node-call-expression(call)
                if call.args.count == 0 && is-map-call(source, tree, row.right, call)
                    = row.right
= 0

━━━━━━━━━━━━━━━━━━━━
+ do is-map-entry Bool
    - tree AST
    - id SyntaxId
    - name String

` Whether a statement sets one entry of the map `name`, from keys and values that do not read it.
do match? tree.nodes[id]
    | .node-assign(row)
        if row.op != .eq-op
            = false
        do match? tree.nodes[row.lhs]
            | .node-index-expression(index)
                if index.is-optional || !is-named(tree, index.object, name)
                    = false
                = !references-name(tree, index.index, name) && !references-name(tree, row.rhs, name)
= false

━━━━━━━━━━━━━━━━━━━━
+ do references-name Bool
    - tree AST
    - id SyntaxId
    - name String

if is-named(tree, id, name)
    = true
for child in tree.children-of(id)
    if references-name(tree, child, name)
        = true
= false

━━━━━━━━━━━━━━━━━━━━
+ do map-entry-key SyntaxId
    - tree AST
    - id SyntaxId

match tree.nodes[id]
    | .node-assign(row)
        match tree.nodes[row.lhs]
            | .node-index-expression(index)
                = index.index
            ?! Panic("Expected an index")
    ?! Panic("Expected an assignment")

━━━━━━━━━━━━━━━━━━━━
