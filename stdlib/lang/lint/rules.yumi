    - tree AST
    - id SyntaxId

match tree.nodes[id]
    | .node-type-identifier(row)
        row.name.text == "Map"
    | .node-type-arguments(row)
        row.args.count >= 2 && is-map-type(tree, row.base)
    ??
        false

