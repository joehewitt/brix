━━━━━━━━━━━━━━━━━━━━
+ do lint-line-length
    - source LintSource
    - context RuleContext

. max = option-int(context.options, "max", 100)
. template-text = template-text-lines(source.lines)
. index = 0u32
for line in source.lines
    index += 1

    . kind = classify-line(line)
    if kind == .line-divider || kind == .line-comment || template-text[index - 1]
        continue

    . length = visible-length(line)
    if length > max
        context.report("Line is $length columns; expected $max or fewer.", index, (max + 1) as U32)

━━━━━━━━━━━━━━━━━━━━
+ ComplexityCounts

+ if-branches Int
+ loops Int
+ loop-clauses Int
+ conditional-returns Int
+ conditional-asserts Int
+ catch-handlers Int
+ matches Int
+ short-circuit-operators Int

────────────────────
+ This

────────────────────
+ get total Int

branches + exits + catch-handlers + matches + short-circuit-operators
    .. branches = if-branches + loops + loop-clauses
    .. exits = conditional-returns + conditional-asserts

────────────────────
+ get describe String

", ".join(parts)

────────────────────
+ get parts [String]

*? counted(if-branches, "if branch", "if branches") if if-branches != 0
*? counted(loops, "loop", "loops") if loops != 0
*? counted(loop-clauses, "loop clause", "loop clauses") if loop-clauses != 0
*? counted(conditional-returns, "conditional return", "conditional returns") if conditional-returns != 0
*? counted(conditional-asserts, "conditional assert", "conditional asserts") if conditional-asserts != 0
*? counted(catch-handlers, "catch handler", "catch handlers") if catch-handlers != 0
*? counted(matches, "match", "matches") if matches != 0
*? counted(short-circuit-operators, "short-circuit operator", "short-circuit operators") if short-circuit-operators != 0

━━━━━━━━━━━━━━━━━━━━
+ do lint-cyclomatic
    - tree AST
    - context RuleContext

. max = option-int(context.options, "max", 15)
. total = tree.nodes.length

for id in 1u32 .. < total
    . body = function-body(tree, id as SyntaxId)
    if body == 0
        continue

    . counts = ComplexityCounts()
    . seen [U32 = Bool]
    measure-complexity(tree, body, counts, seen)

    . complexity = 1 + counts.total
    if complexity <= max
        continue

    . loc = tree.nodes.loc[id]
    . detail = counts.describe
    . message = "Function has cyclomatic complexity $complexity; expected $max or fewer ($detail)."
    context.report(message, loc.begin.line + 1, loc.begin.column + 1)

━━━━━━━━━━━━━━━━━━━━
+ function-body SyntaxId
    - tree AST
    - id SyntaxId

match tree.nodes[id]
    | .node-function-syntax(row)
        row.body
    | .node-getter-syntax(row)
        row.body
    | .node-setter-syntax(row)
        row.body
    ??
        0

━━━━━━━━━━━━━━━━━━━━
_ do measure-complexity
    - tree AST
    - id SyntaxId
    - counts ComplexityCounts
    - seen [U32 = Bool]

if id == 0 || seen[id]
    =
seen[id] = true

if is-function-node(tree, id)
    =

do match? tree.nodes[id]
    | .node-if-block(row)
        if row.condition != 0
            counts.if-branches += 1
    | .node-binary-expression(row)
        if row.op == .if-op
            counts.if-branches += 1
        else if row.op == .and-op || row.op == .or-op || row.op == .coalesce-op
            counts.short-circuit-operators += 1
    | .node-while-block
        counts.loops += 1
    | .node-loop-syntax
        counts.loops += 1
    | .node-clause(row)
        if row.op == .when-clause || row.op == .while-clause || row.op == .until-clause
            counts.loop-clauses += 1
    | .node-return-if-true
        counts.conditional-returns += 1
    | .node-assertion-syntax(row)
        if row.condition != 0
            counts.conditional-asserts += 1
    | .node-catch-expression(row)
        if !is-error-transformer(tree, row)
            counts.catch-handlers += row.catchers.count
    | .node-match-expression
        counts.matches += 1

for child in tree.children-of(id)
    measure-complexity(tree, child, counts, seen)

━━━━━━━━━━━━━━━━━━━━
+ is-error-transformer Bool
    - tree AST
    - row ASTCatchExpression

row.catchers.count != 0 && is-bare-assertion(tree, row.body)

━━━━━━━━━━━━━━━━━━━━
+ is-bare-assertion Bool
    - tree AST
    - id SyntaxId

match tree.nodes[id]
    | .node-assertion-syntax(row)
        row.condition == 0
    ??
        false

━━━━━━━━━━━━━━━━━━━━
+ SortableImport

+ import-path String
+ text String
+ original-index Int
+ start Index
+ end Index
+ line U32
+ column U32

────────────────────
+ This
    - import-path String
    - text String
    - original-index Int
    - start Index
    - end Index
    - line U32
    - column U32

━━━━━━━━━━━━━━━━━━━━
+ do lint-import-order
    - analysis ModuleAnalysis
    - context RuleContext

. source = analysis.source
. items [SortableImport]
. index = 0
for entry in analysis.imports
    if entry.resolved-path && entry.begin-line == entry.end-line
        . start = source.offset-of(entry.begin-line, entry.begin-column)
        . end = source.offset-of(entry.end-line, entry.end-column) + 1
        . text = source.slice(start, end)
        . line = entry.begin-line + 1
        . column = entry.begin-column + 1
        items += SortableImport(entry.import-path, text, index, start, end, line, column)
    index += 1

. has-conflict = has-import-name-conflict(analysis.imported-symbols)
. group [SortableImport]
for item in items
    if group.length != 0 && !is-line-break(source.slice(group[group.length - 1].end, item.start))
        report-import-group(source, group, has-conflict, context)
        . fresh [SortableImport]
        group = fresh
    group += item

report-import-group(source, group, has-conflict, context)

━━━━━━━━━━━━━━━━━━━━
+ is-line-break Bool
    - text String

text == "\n" || text == "\r\n"

━━━━━━━━━━━━━━━━━━━━
+ conflict-message String

"$head $tail"
    .. head = "Sort module imports alphabetically after reviewing overlapping names;"
    .. tail = "auto-fix skipped because import-order independence is not proven."

━━━━━━━━━━━━━━━━━━━━
_ do report-import-group
    - source LintSource
    - group [SortableImport]
    - has-conflict Bool
    - context RuleContext

if group.length < 2
    =

. sorted = sort(group) • using compare-imports
. moved-at = 0
while moved-at < group.length && group[moved-at] == sorted[moved-at]
    moved-at += 1
if moved-at == group.length
    =

. moved = group[moved-at]
if has-conflict
    context.report(conflict-message(), moved.line, moved.column)
    =

. first = group[0]
. last = group[group.length - 1]
. line-break = import-line-break(source, group)
. texts [String]
for item in sorted
    texts += item.text

. replacement = line-break.join(texts)
. edit = LintTextEdit(first.start, last.end, replacement, source.slice(first.start, last.end))
. fix = LintFix("safe", "Sort module imports alphabetically", [edit])

context.report("Sort module imports alphabetically.", moved.line, moved.column, "actionable", fix)

━━━━━━━━━━━━━━━━━━━━
+ do import-line-break String
    - source LintSource
    - group [SortableImport]

for position in 1 .. < group.length
    . separator = source.slice(group[position - 1].end, group[position].start)
    if is-line-break(separator)
        = separator
= "\n"

━━━━━━━━━━━━━━━━━━━━
+ compare-imports Comparison
    - left SortableImport
    - right SortableImport

|? left.import-path != right.import-path
    compare-basic(left.import-path, right.import-path)
??
    compare-basic(left.original-index, right.original-index)

━━━━━━━━━━━━━━━━━━━━
+ NameConflict is U32

| conflict-none = 0
| conflict-visibility = 1
| conflict-overlap = 2
| conflict-uncertain = 3

━━━━━━━━━━━━━━━━━━━━
+ SymbolGroups

` Symbols grouped by namespace and name, with the keys in the order each is first seen.

+ keys [String]
+ groups [String = [NameSymbol]]

────────────────────
+ This
    - symbols [NameSymbol]

for symbol in symbols
    . key = symbol.key
    if !groups[key]
        . fresh [NameSymbol]
        groups[key] = fresh
        keys += key
    groups[key]! += symbol

━━━━━━━━━━━━━━━━━━━━
+ do has-import-name-conflict Bool
    - symbols [NameSymbol]

. grouped = SymbolGroups(symbols)
for key in grouped.keys
    if classify-name-conflict(grouped.groups[key]!) != .conflict-none
        = true
= false

━━━━━━━━━━━━━━━━━━━━
+ do classify-name-conflict NameConflict
    - symbols [NameSymbol]
    - imported [NameSymbol]? = null

` How symbols that share a name compete: not at all, by visibility alone, as functions a call
` with no arguments may choose between, or as overloads only a call site can settle. Without
` `imported` the symbols compete among themselves, and otherwise each competes with each imported.
` Symbols that no one build sees together do not compete.
if !imported && unique-conflict-origins(symbols).length <= 1
    = .conflict-none
. others = imported ?? symbols
. result = NameConflict.conflict-none
for index in 0 .. < symbols.length
    . left = symbols[index]
    . first = if imported then 0 else index + 1
    for position in first .. < others.length
        . right = others[position]
        if left.origin-key == right.origin-key || !left.shares-build(right)
            continue
        if !imported && left.origin-path == right.origin-path
            if left.origin-name == right.origin-name
                continue
        if left.kind != "function" || right.kind != "function"
            = .conflict-visibility
        . a = left.call-shape
        . b = right.call-shape
        if a && b
            if call-shapes-disjoint(a, b)
                continue
            if a.no-args && b.no-args
                result = .conflict-overlap
                continue
        if result != .conflict-overlap
            result = .conflict-uncertain
= result

━━━━━━━━━━━━━━━━━━━━
+ do unique-conflict-origins [NameSymbol]
    - symbols [NameSymbol]

` The first symbol of each module among `symbols`, where modules whose symbols are all C functions
` count as one when they declare the same functions.
. modules [String]
. families [String = [NameSymbol]]
for symbol in symbols
    . key = symbol.module-key
    if !families[key]
        . fresh [NameSymbol]
        families[key] = fresh
        modules += key
    families[key]! += symbol

. seen [String = Bool]
. origins [NameSymbol]
for module in modules
    . family = families[module]!
    . key = c-family-key(family) ?? module
    if !seen[key]
        seen[key] = true
        origins += family[0]
= origins

━━━━━━━━━━━━━━━━━━━━
+ do c-family-key String?
    - family [NameSymbol]

` The declarations a module's C functions stand for, or none where one is not a C function.
. keys [String = Bool]
for symbol in family
    if symbol.kind != "c-function"
        = null
    keys[symbol.origin-key] = true
. sorted = sort(keys.keys)
. joined = "\n".join(sorted)
= "c-functions\n$joined"

━━━━━━━━━━━━━━━━━━━━
+ origin-list String
    - symbols [NameSymbol]

", ".join((symbols *> each.origin-label))

━━━━━━━━━━━━━━━━━━━━
+ namespace-label String
    - namespace String

if namespace == "c-value" then "C value" else namespace

━━━━━━━━━━━━━━━━━━━━
+ conflict-status String
    - conflict NameConflict

if conflict == .conflict-uncertain then "review" else "actionable"

━━━━━━━━━━━━━━━━━━━━
+ conflict-description String
    - conflict NameConflict

|? conflict == .conflict-uncertain
    "$uncertain $resolution"
|? conflict == .conflict-overlap
    "competing functions accept a no-argument call; candidate selection can depend on order"
??
    "visibility overlaps; check the binding at each use before changing import order"

.. uncertain = "possible overload competition; argument types, generic constraints, and"
.. resolution = "candidate ranking require call-site resolution"

━━━━━━━━━━━━━━━━━━━━
+ do lint-import-conflicts
    - analysis ModuleAnalysis
    - context RuleContext

. grouped = SymbolGroups(analysis.imported-symbols)
for key in grouped.keys
    . symbols = grouped.groups[key]!
    . conflict = classify-name-conflict(symbols)
    if conflict == .conflict-none
        continue

    . site = symbols[0]
    for symbol in symbols
        if symbol.import-priority > site.import-priority
            site = symbol
    . first = symbols[0]
    . origins = origin-list(unique-conflict-origins(symbols))
    . message = "Imported ${namespace-label(first.namespace)} name \"${first.name}\" is exported "
    message += "by $origins; ${conflict-description(conflict)}."
    . status = conflict-status(conflict)
    context.report(message, site.import-line + 1, site.import-column + 1, status)

━━━━━━━━━━━━━━━━━━━━
+ do lint-local-shadows-import
    - analysis ModuleAnalysis
    - context RuleContext

. imported = SymbolGroups(analysis.imported-symbols)
. locals = SymbolGroups(analysis.local-symbols)
for key in locals.keys
    . group = locals.groups[key]!
    . shadowed = imported.groups[key]
    if !shadowed
        continue
    . conflict = classify-name-conflict(group, shadowed)
    if conflict == .conflict-none
        continue

    . local = group[0]
    for symbol in group
        if symbol.line < local.line || (symbol.line == local.line && symbol.column < local.column)
            local = symbol
    . origins = origin-list(unique-conflict-origins(shadowed))
    . message = "Local ${local.kind} \"${local.name}\" overlaps imported "
    message += "${namespace-label(local.namespace)} name from $origins; "
    message += "${conflict-description(conflict)}."
    context.report(message, local.line + 1, local.column + 1, conflict-status(conflict))

━━━━━━━━━━━━━━━━━━━━
+ do call-shapes-disjoint Bool
    - a FunctionCallShape
    - b FunctionCallShape

if a.maximum >= b.minimum && b.maximum >= a.minimum
    = false
for index in 0 .. < a.labels.length
    . label = a.labels[index]
    if label.length == 0
        continue
    for other in 0 .. < b.labels.length
        if b.labels[other] == label && other != index
            = false
= true

━━━━━━━━━━━━━━━━━━━━
+ do lint-type-param-shadows
    - analysis ModuleAnalysis
    - context RuleContext

. groups [String = [NameSymbol]]
for symbol in analysis.local-symbols
    add-type-symbol(groups, symbol)
for symbol in analysis.imported-symbols
    add-type-symbol(groups, symbol)

for param in analysis.type-params
    . shadowed = groups[param.name]
    if !shadowed
        continue

    . origins = origin-list(unique-conflict-origins(shadowed))
    . message = "Type parameter \"${param.name}\" shadows type name from $origins."
    context.report(message, param.line + 1, param.column + 1)

━━━━━━━━━━━━━━━━━━━━
_ do add-type-symbol
    - groups [String = [NameSymbol]]
    - symbol NameSymbol

if symbol.namespace != "type"
    =

. existing = groups[symbol.name]
if existing
    existing += symbol
else
    . fresh [NameSymbol]
    fresh += symbol
    groups[symbol.name] = fresh

━━━━━━━━━━━━━━━━━━━━
+ do lint-unused-catch-optional
    - tree AST
    - context RuleContext

for id in 1u32 .. < tree.nodes.length
    do match? tree.nodes[id]
        | .node-block(block)
            for position in 0 .. < block.body.count
                . statement = tree.children[block.body.start + position]
                if !(tree.nodes[statement] is .node-catch-optional-expression)
                    continue
                if position + 1 == block.body.count && !is-imperative-body(tree, id as SyntaxId)
                    continue
                . loc = tree.nodes.loc[statement]
                . message = "Use catch instead of catch? when the optional result is unused."
                context.report(message, loc.begin.line + 1, loc.begin.column + 1)

━━━━━━━━━━━━━━━━━━━━
+ do is-imperative-body Bool
    - tree AST
    - block SyntaxId

` Whether a block is the body of an imperative function, whose last statement gives no result.
do match? tree.nodes[tree.holder-of(block)]
    | .node-function-syntax(row)
        = row.body == block && row.imperative
= false

━━━━━━━━━━━━━━━━━━━━
+ do lint-optional-match
    - tree AST
    - context RuleContext

for id in 1u32 .. < tree.nodes.length
    . status = optional-match-status(tree, id as SyntaxId)
    if status.length == 0
        continue
    . loc = tree.nodes.loc[id]
    . message = "Prefer `match?`: remove the terminal `?? null` default arm."
    if status != "actionable"
        message = "Review this match for `match?`; removing the terminal `?? null` default may "
        message += "change `Result`, `Error`, or null-only result semantics."
    context.report(message, loc.begin.line + 1, loc.begin.column + 1, status)

━━━━━━━━━━━━━━━━━━━━
+ do optional-match-status String
    - tree AST
    - id SyntaxId

` How a match that could be `match?` is reported: actionable where every other arm proves a value,
` review where one may not, or none where its last arm is not a bare `?? null`.
do match? tree.nodes[id]
    | .node-match-expression(row)
        . pattern = structure-pattern(tree, row.body)
        if row.is-optional || pattern == 0 || !requires-subject(tree, pattern)
            = ""
        . choices [SyntaxId]
        gather-choices(tree, pattern, choices)
        if choices.length < 2
            = ""
        do match? tree.nodes[choices[choices.length - 1]]
            | .node-type-transform(fallback)
                if fallback.pattern == 0 && is-null-only(tree, fallback.expr)
                    for position in 0 .. < choices.length - 1
                        if !proves-value(tree, choices[position])
                            = "review"
                    = "actionable"
= ""

━━━━━━━━━━━━━━━━━━━━
+ structure-pattern SyntaxId
    - tree AST
    - body SyntaxId

match tree.nodes[body]
    | .node-structure-match(row)
        row.pattern
    ??
        0

━━━━━━━━━━━━━━━━━━━━
+ do gather-choices
    - tree AST
    - pattern SyntaxId
    - choices [SyntaxId]

` Adds the alternatives of a match pattern to `choices`, in the order written.
do match? tree.nodes[pattern]
    | .node-type-or(row)
        gather-choices(tree, row.left, choices)
        gather-choices(tree, row.right, choices)
        =
choices += pattern

━━━━━━━━━━━━━━━━━━━━
+ requires-subject Bool
    - tree AST
    - pattern SyntaxId

` Whether a match pattern tests a subject, rather than only conditions or a bare fallback.
match tree.nodes[pattern]
    | .node-type-or(row)
        requires-subject(tree, row.left) || requires-subject(tree, row.right)
    | .node-type-transform(row)
        row.pattern != 0 && requires-subject(tree, row.pattern)
    | .node-type-panic(row)
        requires-subject(tree, row.pattern)
    | .node-type-predicate(row)
        row.is-contextual
    ??
        true

━━━━━━━━━━━━━━━━━━━━
+ is-null-only Bool
    - tree AST
    - body SyntaxId

match tree.nodes[single-statement(tree, body)]
    | .node-identifier(row)
        row.name.text == "null"
    ??
        false

━━━━━━━━━━━━━━━━━━━━
+ proves-value Bool
    - tree AST
    - choice SyntaxId

match tree.nodes[choice]
    | .node-type-panic
        true
    | .node-type-transform(row)
        is-literal-value(tree, single-statement(tree, row.expr))
    ??
        false

━━━━━━━━━━━━━━━━━━━━
+ is-literal-value Bool
    - tree AST
    - id SyntaxId

match tree.nodes[id]
    | .node-integer-syntax(row)
        !row.unit
    | .node-float-syntax(row)
        !row.unit
    | .node-string-syntax
        true
    | .node-symbol
        true
    | .node-identifier(row)
        row.name.text == "true" || row.name.text == "false"
    | .node-tuple-syntax
        true
    | .node-list-syntax
        true
    ??
        false

━━━━━━━━━━━━━━━━━━━━
+ do lint-nested-match-assertions
    - source LintSource
    - tree AST
    - context RuleContext

for id in 1u32 .. < tree.nodes.length
    . fallback = assertion-fallback(tree, id as SyntaxId)
    if fallback == 0
        continue
    . fix = if source.is-brix then brix-fix else lift-assertions-fix(source, tree, fallback)
        .. brix-fix = brix-lift-fix(source, tree, fallback)
    if !fix
        continue
    . loc = tree.nodes.loc[fallback]
    . message = "Lift fallback assertions to match-arm level."
    context.report(message, loc.begin.line + 1, loc.begin.column + 1, "actionable", fix)

━━━━━━━━━━━━━━━━━━━━
+ do assertion-fallback SyntaxId
    - tree AST
    - id SyntaxId

` The last arm of a match or table where it is a bare `??` whose body only raises, or none.
do match? tree.nodes[id]
    | .node-structure-match(row)
        if row.pattern == 0
            = 0
        . choices [SyntaxId]
        gather-choices(tree, row.pattern, choices)
        if choices.length < 2
            = 0
        . fallback = choices[choices.length - 1]
        do match? tree.nodes[fallback]
            | .node-type-transform(transform)
                if transform.pattern == 0 && is-assertion-block(tree, transform.expr)
                    = fallback
= 0

━━━━━━━━━━━━━━━━━━━━
+ do is-assertion-block Bool
    - tree AST
    - body SyntaxId

do match? tree.nodes[body]
    | .node-block(row)
        if row.body.count == 0
            = false
        for statement in tree.children[row.body]
            if !(tree.nodes[statement] is .node-assertion-syntax)
                = false
        = true
= false

━━━━━━━━━━━━━━━━━━━━
+ do lift-assertions-fix LintFix?
    - source LintSource
    - tree AST
    - fallback SyntaxId

` The edit that lifts the assertions of a bare `??` arm to the arm's own level, or none where its
` lines do not all share the indent removed.
. body = match tree.nodes[fallback]
    | .node-type-transform(row)
        match tree.nodes[row.expr]
            | .node-block(block)
                block.body
            ?! Panic("Expected a block of assertions")
    ?! Panic("Expected a match arm")
. arm = tree.nodes.loc[fallback].begin
. first = tree.nodes.loc[tree.children[body.start]].begin
. last = tree.nodes.loc[tree.children[body.start + body.count - 1]].end
. offset = source.offset-of(arm.line, arm.column)
. start = source.line-starts[arm.line]
. end = source.offset-of(last.line, last.column + 1)
if end <= offset || source.slice(offset, offset + 2) != "??"
    = null

. expected = source.slice(start, end)
. newline = expected.find("\n")
. width = if first.column > arm.column then first.column - arm.column else 0u32
if !newline || width == 0
    = null

. lines [String] = expected[newline + 1 .. < expected.length].split("\n")
. lifted [String]
for line in lines
    if line.trim().length != 0 && !has-leading-space(line, width)
        = null
    lifted += if line.length > width then line[width .. < line.length] else ""
. edit = LintTextEdit(utf16-start, utf16-end, "\n".join(lifted), expected)
    .. utf16-start = source.utf16-offset(arm.line, 0)
    .. utf16-end = source.utf16-offset(last.line, last.column + 1)
= LintFix("safe", "Lift match fallback assertions", [edit])

━━━━━━━━━━━━━━━━━━━━
+ do has-leading-space Bool
    - line String
    - width U32

if line.length < width
    = false
for position in 0 .. < width
    if line[position] != ' ' && line[position] != '\t'
        = false
= true

━━━━━━━━━━━━━━━━━━━━
+ do lint-map-literal
    - source LintSource
    - tree AST
    - context RuleContext

. attached = attached-nodes(tree)
for id in 1u32 .. < tree.nodes.length
    if !attached[id]
        continue
    do match? tree.nodes[id]
        | .node-block(block)
            lint-initial-map-entries(source, tree, block.body, context)
        | .node-call-expression(call)
            if call.args.count != 0 && is-map-constructor && map-pairs(tree, call.args)
                . loc = tree.nodes.loc[id].begin
                . message = "Construct populated maps with map literal syntax."
                . fix = if source.is-brix then brix-fix else text-fix
                    .. brix-fix = brix-map-constructor-fix(source, tree, id as SyntaxId)
                    .. text-fix = map-constructor-fix(source, tree, id as SyntaxId, call)
                context.report(message, loc.line + 1, loc.column + 1, "actionable", fix)
            .. is-map-constructor = is-map-call(source, tree, id as SyntaxId, call)

━━━━━━━━━━━━━━━━━━━━
+ is-map-call Bool
    - source LintSource
    - tree AST
    - id SyntaxId
    - call ASTCallExpression

` Whether a call constructs a map, with its arguments in parentheses after the type.
|? !is-map-type(tree, call.callable)
    false
|? source.is-brix
    !brix-is-map-literal(source, tree, id)
??
    source.slice(end, end + 1) == "("

.. end = node-end(source, tree, call.callable)

