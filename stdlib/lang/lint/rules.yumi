if rule-id == "layout/line-length"
    lint-line-length(source, context)
if rule-id == "layout/divider-length"
    lint-divider-length(source, context)

━━━━━━━━━━━━━━━━━━━━
+ do lint-divider-length
    - source LintSource
    - context RuleContext

. index = 0u32
for line in source.lines
    . row = index
    index += 1
    if classify-line(line) != .line-divider
        continue

    . trimmed = line.trim()
    . replacement = "${trimmed[0]}" * 20
    if trimmed == replacement
        continue

    . indent Index = 0
    for char in line
        if !is-space-char(char)
            break
        indent += 1
    . start = source.utf16-line-starts[row] + indent
    . edit = LintTextEdit(start, start + utf16-length(trimmed), replacement, trimmed)
    . fix = LintFix("safe", "Normalize divider width", [edit]) if !mixed-divider(trimmed)
    context.report
        - "Divider must contain exactly 20 identical divider characters."
        - index
        - (indent + 1) as U32
        - "actionable"
        - fix

━━━━━━━━━━━━━━━━━━━━
+ do mixed-divider Bool
    - line String

for char in line
    if char != line[0]
        = true
= false

