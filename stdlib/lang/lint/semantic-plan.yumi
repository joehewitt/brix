━━━━━━━━━━━━━━━━━━━━
+ SemanticPlanner

` Chooses the programs the semantic rules type, as the reference's `planSemanticCoverage` does:
` every lint file of the project is read for its imports and for whether it runs code; the
` roots given explicitly are the roots, and otherwise the configured roots, the tests, the
` examples, the other programs, and the targets that run code are candidates, from which the
` one covering the most targets not yet covered is taken, the higher priority first among
` those tied, until no candidate covers one more.
+ project-root String
+ search-paths [Path]
+ resolver ModuleResolver
+ sources [String = String]

_ atoms AtomPool
_ graph [String = SemanticGraphNode]
_ order [String]

────────────────────
+ This
    - project-root String
    - search-paths [Path]

. c-paths [String = [Path]]
resolver = ModuleResolver(search-paths, c-paths)

────────────────────
+ do plan SemanticCoveragePlan
    - targets [String]
    - overrides [String]
    - configured [String]

` The plan for the targets, all absolute paths, from the roots given (`overrides`) or else
` those the configuration names (`configured`) and the candidates found.
. target-paths = unique-paths(targets)
. override-paths = unique-paths(overrides)
. configured-paths = unique-paths(configured)
. seeds [String]
seeds ++= override-paths
seeds ++= configured-paths
build-graph(target-paths, seeds)

. candidates [CandidateRoot]
if override-paths.length != 0
    for path in override-paths
        candidates += candidate-for(path, "explicit", 1000)
else
    candidates = heuristic-candidates(target-paths, configured-paths)
. selected [CandidateRoot]
if override-paths.length != 0
    selected = candidates
else
    selected = greedy-coverage(candidates, target-paths)
    for candidate in candidates
        if candidate.reason == "configured" && candidate.error
            selected += candidate

. plan = SemanticCoveragePlan()
for candidate in selected
    . root = SemanticRootPlan(candidate.path, candidate.reason)
    root.covers = each in target-paths when candidate.reachable[each]
    root.reachable = sorted-keys(candidate.reachable)
    root.error = candidate.error
    plan.roots += root
for path in target-paths
    . target = SemanticTargetPlan(path)
    target.reachable-by = each.path in candidates when each.reachable[path]
    target.covered-by = each.path in selected when each.reachable[path]
    if target.covered-by.length == 0
        plan.uncovered += path
    plan.targets += target
= plan

────────────────────
+ do module-name String
    - path String

` The name of the module a file is, as the reference's `moduleNameForPath` gives it: its path in
` the first search root that holds it, else in the project, else its file name, without
` `.yumi`.
for root in search-paths
    . prefix = "$root/"
    =? strip-extension(path[prefix.length ...]) if path.starts-with(prefix)
. prefix = "$project-root/"
=? strip-extension(path[prefix.length ...]) if path.starts-with(prefix)
= strip-extension(Path(path).name)

────────────────────
_ do build-graph
    - targets [String]
    - seeds [String]

. discovered [String = Bool]
for path in discover-lint-files(project-root, ["."])
    discovered[path] = true
. pending [String = Bool]
for path, _ in discovered
    pending[path] = true
for path in targets
    pending[path] = true
for path in seeds
    pending[path] = true

while pending.length != 0
    . batch = sorted-keys(pending)
    pending.clear()
    for path in batch
        . node = SemanticGraphNode(path, discovered[path] ?? false)
        graph[path] = node
        order += path
        scan(node)
    for path in batch
        for imported in graph[path]!.imports
            if !graph[imported]
                pending[imported] = true

────────────────────
_ do source-text String ?! Error
    - path String

. held = sources[path]
if held
    = held
= file-text(path)

────────────────────
_ do scan
    - node SemanticGraphNode

` Reads a file for whether it runs code and the files it imports, or the error that keeps it out
` of every root's reach.
if !is-lint-path(node.path)
    node.error = "Semantic roots must be .yumi or .bx files"
    =
. text = catch source-text(node.path)
if text is Error
    node.error = (text as Error).message
    =
. builder = parse-lint-text(text, node.path)
    catch failure YumiSyntaxError
        node.error = failure.message
        =
. tree = use builder.finish(atoms)
node.executable = has-executable-shape(tree)
. found [String = Bool]
match tree.nodes[tree.root]
    | .node-top-level-syntax(root)
        for id in tree.children[root.statements]
            match? tree.nodes[id]
                | .node-import-syntax(import)
                    . text-path = import-path-text(tree, import.paths)
                    if !text-path.ends-with(".h")
                        . resolved = resolver.resolve-module(text-path, node.path)
                        if resolved
                            found[resolved.path as String] = true
    ?! Panic("AST root has the wrong syntax case")
node.imports = sorted-keys(found)

────────────────────
_ do heuristic-candidates [CandidateRoot]
    - targets [String]
    - configured [String]

. candidates [CandidateRoot]
. positions [String = Index]
for path in configured
    add-candidate(candidates, positions, candidate-for(path, "configured", 1000))
for path in order
    . node = graph[path]!
    if node.discovered && node.executable
        . kind = root-kind(path)
        add-candidate(candidates, positions, candidate-for(path, kind[0], kind[1]))
for path in targets
    . node = graph[path]
    if node && node.executable
        add-candidate(candidates, positions, candidate-for(path, "target-executable", 100))
= candidates

────────────────────
_ do add-candidate
    - candidates [CandidateRoot]
    - positions [String = Index]
    - candidate CandidateRoot

. position = positions[candidate.path]
if !position
    positions[candidate.path] = candidates.length
    candidates += candidate
else if candidate.priority > candidates[position].priority
    candidates[position] = candidate

────────────────────
_ candidate-for CandidateRoot
    - path String
    - reason String
    - priority I64

CandidateRoot(path, reason, priority, reachable-files(path), node.error if node)

.. node = graph[path]

────────────────────
_ do reachable-files [String = Bool]
    - path String

. reachable [String = Bool]
. queue [String]
queue += path
while queue.length != 0
    . current = queue.pop()
    if reachable[current]
        continue
    . node = graph[current]
    if !node || node.error
        continue
    reachable[current] = true
    for imported in node.imports
        if !reachable[imported]
            queue += imported
= reachable

━━━━━━━━━━━━━━━━━━━━
+ do semantic-root-batches [[SemanticRootPlan]]
    - roots [SemanticRootPlan]

` The roots typed together, in order, as the reference batches them: a root joins the batch
` before it unless the files the batch and it reach would pass `semantic-batch-file-limit`.
. batches [[SemanticRootPlan]]
. batch [SemanticRootPlan]
. reachable [String = Bool]
for root in roots
    . combined [String = Bool]
    for path, _ in reachable
        combined[path] = true
    for path in root.reachable
        combined[path] = true
    if batch.length != 0 && combined.length > semantic-batch-file-limit
        batches += batch
        . fresh [SemanticRootPlan]
        batch = fresh
        reachable.clear()
        for path in root.reachable
            reachable[path] = true
    else
        reachable = combined
    batch += root
if batch.length != 0
    batches += batch
= batches

━━━━━━━━━━━━━━━━━━━━
+ do sorted-keys [String]
    - map [String = Bool]

. keys [String]
for key, _ in map
    keys += key
= sort(keys)

