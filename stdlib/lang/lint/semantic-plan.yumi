━━━━━━━━━━━━━━━━━━━━
_ do greedy-coverage [CandidateRoot]
    - candidates [CandidateRoot]
    - targets [String]

. remaining [String = Bool]
for path in targets
    remaining[path] = true
. pool [CandidateRoot]
pool ++= candidates
. selected [CandidateRoot]
while remaining.length != 0
    . best = -1
    . best-coverage = 0
    . best-priority I64 = -1
    for position in 0 .. < pool.length
        . coverage = covered-count(pool[position].reachable, remaining)
        . wider = coverage > best-coverage
        if wider || (coverage == best-coverage && coverage > 0 && is-higher-priority)
            best = position
            best-coverage = coverage
            best-priority = pool[position].priority
        .. is-higher-priority = pool[position].priority > best-priority
    if best < 0 || best-coverage == 0
        break
    . chosen = pool[best]
    pool.remove(best)
    selected += chosen
    for path, _ in chosen.reachable
        -= remaining[path]
= selected

━━━━━━━━━━━━━━━━━━━━
_ do covered-count Int
    - reachable [String = Bool]
    - targets [String = Bool]

. count = 0
for path, _ in targets
    if reachable[path]
        count += 1
= count

━━━━━━━━━━━━━━━━━━━━
_ root-kind (String, I64)
    - path String

|? path.find("/test/") != null || path.find("/tests/") != null || named-test
    ("test", 800)
|? path.find("/examples/") != null || path.starts-with("examples/")
    ("example", 500)
??
    ("executable", 200)

.. name = Path(path).name
.. named-test = name == "test.yumi" || name == "tests.yumi"

━━━━━━━━━━━━━━━━━━━━
_ do has-executable-shape Bool
    - tree AST

` Whether a module runs code of its own, as the reference's `hasExecutableShape` decides: a line
` that is not an import, a declaration of a type, function, extension, unit or converter, a rule,
` or a property, but for a property holding a state machine.
match tree.nodes[tree.root]
    | .node-top-level-syntax(root)
        for id in tree.children[root.statements]
            if runs-code(tree, id)
                = true
    ?! Panic("AST root has the wrong syntax case")
= false

━━━━━━━━━━━━━━━━━━━━
_ runs-code Bool
    - tree AST
    - id SyntaxId

match tree.nodes[id]
    | .node-property-syntax(row)
        tree.nodes[row.value] is .node-state-machine
    | .node-import-syntax
        false
    | .node-class-block
        false
    | .node-function-syntax
        false
    | .node-getter-syntax
        false
    | .node-setter-syntax
        false
    | .node-extension
        false
    | .node-style-sheet-extension
        false
    | .node-unit-declaration
        false
    | .node-fromverter-syntax
        false
    | .node-converter-syntax
        false
    | .node-when-rule-syntax
        false
    | .node-whenever-rule-syntax
        false
    | .node-noop
        false
    ??
        true

━━━━━━━━━━━━━━━━━━━━
_ do unique-paths [String]
    - paths [String]

. seen [String = Bool]
for path in paths
    seen[path] = true
= sorted-keys(seen)

━━━━━━━━━━━━━━━━━━━━
_ strip-extension String
    - path String

if path.ends-with(".yumi") then path[0 .. < path.length - 5] else path

━━━━━━━━━━━━━━━━━━━━
_ do file-text String ?! Error
    - path String

. text-file = use File(path)
. text = text-file as String
= text
