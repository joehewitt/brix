━━━━━━━━━━━━━━━━━━━━
+ BrixSource

+ source LintSource
+ store SourceStore
+ roots [U32]
_ marks SexpMarks
_ placed [String = ImmutableTableRow'SourceNode]
_ parents [U32 = ImmutableTableRow'SourceNode]

────────────────────
+ This
    - source
    - store
    - roots
    - marks

. place = BrixCursor(byte-view(source.text))
for root in roots
    visit(store.node(root), place)

────────────────────
_ do visit
    - node ImmutableTableRow'SourceNode
    - place BrixCursor

. start = marks.start(node.id)
if start > 0 || placed.length == 0
    place.advance(start)
    . key = "${place.line}:${place.column}"
    if !placed[key]
        placed[key] = node
for item in store.items(node)
    parents[item.id] = node
    visit(item, place)

────────────────────
+ begin-using

this

────────────────────
+ do end-using

release()

────────────────────
+ do release

store.release()

────────────────────
+ form-at ImmutableTableRow'SourceNode?
    - line U32
    - column U32

placed["$line:$column"]

────────────────────
+ parent-of ImmutableTableRow'SourceNode?
    - node ImmutableTableRow'SourceNode

parents[node.id]

────────────────────
+ do is-adjacent Bool
    - first ImmutableTableRow'SourceNode
    - next ImmutableTableRow'SourceNode

. bytes = byte-view(source.text)
. end = marks.end(first.id)
. start = marks.start(next.id)
=? false if start < end
= all(end .. < start) • where bytes[each] == 32 || bytes[each] == 10

────────────────────
+ do depth-of Int
    - node ImmutableTableRow'SourceNode

. start = marks.start(node.id)
. bytes = byte-view(source.text)
. line-start = start
while line-start > 0 && bytes[line-start - 1] != 10
    line-start -= 1
. spaces = 0
while line-start + spaces < bytes.length && bytes[line-start + spaces] == 32
    spaces += 1
= spaces / 2

────────────────────
+ text-of String
    - node ImmutableTableRow'SourceNode
    - depth Int

sexp-nested-text(store, node, BrixLayout(store), depth)

────────────────────
+ rows-text String
    - nodes [ImmutableTableRow'SourceNode]
    - depth Int

"\n${"  " * depth}".join((text-of(each, depth) in nodes))

────────────────────
+ edit LintTextEdit
    - first ImmutableTableRow'SourceNode
    - last ImmutableTableRow'SourceNode
    - replacement String

LintTextEdit(start, end, replacement, source.text[source.char-of(start) .. < source.char-of(end)])

.. start = utf16-at(marks.start(first.id))
.. end = utf16-at(marks.end(last.id))

────────────────────
_ do utf16-at Index
    - offset Index

. bytes = byte-view(source.text)
. units Index = 0
for index in 0 .. < offset
    . byte = bytes[index]
    if byte >= 240
        units += 2
    else if byte < 128 || byte >= 192
        units += 1
= units

━━━━━━━━━━━━━━━━━━━━
+ do read-brix-source BrixSource?
    - source LintSource

. store = SourceStore()
. marks = SexpMarks(store.latest-id)
. roots = catch? sexp-read(source.text, store, marks)
if !roots
    store.release()
    = null
= BrixSource(source, store, roots, marks)

━━━━━━━━━━━━━━━━━━━━
+ BrixCursor

+ line U32
+ column U32
_ bytes Byte[]
_ offset Index

────────────────────
+ This
    - bytes

────────────────────
+ do advance
    - target Index

if target < offset
    offset = 0
    line = 0
    column = 0
while offset < target
    . byte = bytes[offset]
    if byte == 10
        line += 1
        column = 0
    else if byte < 128 || byte >= 192
        column += 1
    offset += 1

━━━━━━━━━━━━━━━━━━━━
+ do brix-file-text String
    - store SourceStore
    - nodes [ImmutableTableRow'SourceNode]

. rows [ImmutableTableRow'SourceNode]
for node in nodes
    if store.is-form(node, "main")
        rows ++= store.listed(node, 1)
    else
        rows += node
= sexp-text(store, rows, BrixLayout(store))
