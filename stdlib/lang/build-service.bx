(import /core/arena)
(import /data/json)
(import /data/jsonl)
(import /data/jsonrpc)
(import /os/env)
(import /os/file)
(import /os/path)
(import /os/process)

(type + BuildServiceCommand (is Tuple)
  (prop + arguments (list String))
  (prop + variables (map String String))
)

(type + BuildOutcome (is Tuple)
  (prop + status Int)
  (prop + output String)
  (prop + product (? String))
  (prop + number Int)
)

(type + BuildService
  (implements Closable)
  (prop + root String)
  (event + notified JSONRPCNotification)
  (event + stopped Int)
  (prop _ process (? Process))
  (prop _ identity (? String))
  (prop _ generation _ (= 0))
  (prop _ next-request _ (= 0))
  (prop _ waiting (map Int (of Semaphore JSON)))
  (prop _ watched (map String (list String)))
  (prop _ lock _ (= (call Mutex)))
  (fn-do + This _
    (param root String)
  )
  (fn-do + build (? BuildOutcome)
    (param command BuildServiceCommand)
    (param arguments (list String))
    (param watches _ (= false))
    (if watches
      (call remember arguments)
    )
    (let params
      (call (of Map String JSON)
        (block
          (:arguments (as (call (of List JSON) (in (as each JSON) arguments)) JSON))
          (:watch? (only-if true (if watches)))
        )
      )
    )
    (let reply (call JSONReader "build" (call ask command "build" params)))
    (return-if null (if (not (. reply is-present))))
    (return (catch? (call read-build-outcome reply)))
  )
  (fn-do + watch _
    (param command BuildServiceCommand)
    (param arguments (list String))
    (use lock)
    (= ([] watched (call (. "\n" join) arguments)) (call (of List String) arguments))
    (let started generation)
    (return-if (if (not (call ensure-running command))))
    (blank)
    (if (== generation started)
      (call send-watch arguments)
    )
  )
  (fn-do + unwatch _
    (param command BuildServiceCommand)
    (param arguments (list String))
    (return-if (if (not (call forget arguments))))
    (blank)
    (let params
      (call (of Map String JSON)
        (block
          (:arguments (as (call (of List JSON) (in (as each JSON) arguments)) JSON))
        )
      )
    )
    (call ask command "unwatch" params)
  )
  (fn-do + start (? Int)
    (param command BuildServiceCommand)
    (use lock)
    (return-if null (if (not (call ensure-running command))))
    (return generation)
  )
  (fn-do + ask JSON
    (param command BuildServiceCommand)
    (param method String)
    (param params JSON)
    (let done (call (of Semaphore JSON)))
    (return-if null (if (not (call enqueue command method params done))))
    (return (?? (call (. done await)) (as null JSON)))
  )
  (fn-do + tell _
    (param command BuildServiceCommand)
    (param method String)
    (param params JSON)
    (use lock)
    (if (call ensure-running command)
      (call send (str (call JSONRPCNotification method params)))
    )
  )
  (fn-do + cancel _
    (use lock)
    (call stop)
  )
  (fn-do + close _
    (call cancel)
  )
  (fn-do _ enqueue Bool
    (param command BuildServiceCommand)
    (param method String)
    (param params JSON)
    (param done (of Semaphore JSON))
    (use lock)
    (return-if false (if (not (call ensure-running command))))
    (blank)
    (+= next-request 1)
    (let id next-request)
    (= ([] waiting id) done)
    (if (not (call send (str (call JSONRPCRequest id method params))))
      (-= ([] waiting id))
      (return false)
    )
    (return true)
  )
  (fn-do _ ensure-running Bool
    (param command BuildServiceCommand)
    (let executable (call service-executable root ([] (. command arguments) 0)))
    (let current (call service-identity executable command))
    (return-if true (if (and process (== identity current))))
    (blank)
    (call stop)
    (let started (catch (call Process executable (. ProcessStderr inherit) ([] (. command arguments) (... 1)) root (. command variables))))
    (return-if false (if (is started Error)))
    (blank)
    (let running (as started Process))
    (= process running)
    (= identity current)
    (+= generation 1)
    (do-new @detached
      (call read running)
      (on-failure failed
        (<- stderr (str "The build service's reader ended with a panic: " failed "\n"))
        (call (. running terminate))
        (let lost (call ended running))
        (if lost
          (<- stopped lost)
        )
      )
    )
    (for (in (tuple _ arguments) watched)
      (call send-watch arguments)
    )
    (return true)
  )
  (fn-do _ remember _
    (param arguments (list String))
    (use lock)
    (= ([] watched (call (. "\n" join) arguments)) (call (of List String) arguments))
  )
  (fn-do _ forget Bool
    (param arguments (list String))
    (use lock)
    (-= ([] watched (call (. "\n" join) arguments)))
    (return (!= process null))
  )
  (fn-do _ send-watch _
    (param arguments (list String))
    (+= next-request 1)
    (let params
      (call (of Map String JSON)
        (block
          (:arguments (as (call (of List JSON) (in (as each JSON) arguments)) JSON))
          (:watch true)
        )
      )
    )
    (call send (str (call JSONRPCRequest next-request "build" params)))
  )
  (fn-do _ stop _
    (let running process)
    (= process null)
    (= identity null)
    (if running
      (call (. running terminate))
    )
    (call settle)
  )
  (fn-do _ read _
    (param running Process)
    (catch (call receive running))
    (call (. running wait) null)
    (let lost (call ended running))
    (if lost
      (<- stopped lost)
    )
  )
  (fn-do _ ended (? Int)
    (param running Process)
    (use lock)
    (return-if null (if (!= process running)))
    (blank)
    (= process null)
    (= identity null)
    (call settle)
    (return generation)
  )
  (fn-do _ receive _ (?! Error)
    (param running Process)
    (let scratch (use (call Arena)))
    (for (in line (~> running \json-line (with (call JSONParser scratch))))
      (call deliver line)
    )
  )
  (fn-do _ deliver _
    (param line JSON)
    (let message (catch? (call json-rpc-message line)))
    (match? message
      (case (: response JSONRPCResponse)
        (let id
          (match? (. response id)
            (case (: number Int)
              number
            )
          )
        )
        (return-if (if (not id)))
        (blank)
        (let done (call take id))
        (return-if (if (not done)))
        (blank)
        (match (. response outcome)
          (case (call .result value)
            (call (. done post) value)
          )
          (case .error
            (call (. done post) null)
          )
        )
      )
      (case (: notification JSONRPCNotification)
        (<- notified notification)
      )
    )
  )
  (fn-do _ take (? (of Semaphore JSON))
    (param id Int)
    (use lock)
    (let done ([] waiting id))
    (if done
      (-= ([] waiting id))
    )
    (return done)
  )
  (fn-do _ settle _
    (let pending (list (of Semaphore JSON)))
    (for (in (tuple _ done) waiting)
      (+= pending done)
    )
    (call (. waiting clear))
    (for (in done pending)
      (call (. done post) null)
    )
  )
  (fn-do _ send Bool
    (param line String)
    (let running process)
    (return-if false (if (not running)))
    (blank)
    (let wrote (catch? (call (. running write) (str line "\n"))))
    (return (!= wrote null))
  )
)

(fn-do + find-brix-checkout (? Path)
  (param start Path)
  (let directory (? Path) start)
  (while directory
    (let candidate directory)
    (return-if candidate (if (call holds-brix-checkout candidate)))
    (blank)
    (let linked (call linked-checkout (/ candidate ".release.json")))
    (return-if linked (if linked))
    (blank)
    (= directory (. candidate parent))
  )
  (return null)
)

(fn-do _ linked-checkout (? Path)
  (param manifest Path)
  (return-if null (if (not (. manifest is-link))))
  (blank)
  (let resolved
    (scope (. manifest resolved)
      (on-error (: error Error)
        (return null)
      )
    )
  )
  (let folder (. resolved dir))
  (return-if folder (if (call holds-brix-checkout folder)))
  (return null)
)

(fn-expr _ holds-brix-checkout Bool
  (param folder Path)
  (and (. (/ folder "bin" "brix") is-file) (. (/ folder "stdlib") is-dir))
)

(fn-do + checkout-service-command BuildServiceCommand (?! Error)
  (param checkout Path)
  (param search-paths (list Path))
  (let variables (call environment))
  (= ([] variables "BRIXPATH") (call (. ":" join) (in (str each) search-paths)))
  (= ([] variables "BRIX_BUILD_PATH") (str (/ checkout ".tmp" "build")))
  (return (call BuildServiceCommand (list (call checkout-compiler checkout variables) "--serve") variables))
)

(fn-do _ checkout-compiler String (?! Error)
  (param checkout Path)
  (param variables (map String String))
  (let process
    (call Process
      (block
        (arg (str (/ checkout "bin" "brix")))
        (arg (. ProcessStderr inherit))
        (arg (list "--build-only"))
        (arg (str checkout))
        (arg variables)
      )
    )
  )
  (let output (as process String))
  (let status (?? (call (. process wait) null) 1))
  (call (. process close))
  (let lines (list String) (call (. (call (. output trim)) split) "\n"))
  (throw (call Error (str "The compiler in " checkout " did not build: " (call (. output trim)))) (if (or (!= status 0) (== (. lines length) 0))))
  (return ([] lines (- (. lines length) 1)))
)

(fn-expr + read-build-outcome BuildOutcome (?! Error)
  (param reply JSONReader)
  (call BuildOutcome (call (. ([] fields "status") int)) (call (. ([] fields "output") string)) product (call (. ([] fields "number") int)))
  (where
    (lazy fields (call (. reply object)))
    (lazy product (only-if (call (. ([] fields "product") string)) (if (call (. fields has) "product"))))
  )
)

(fn-expr _ service-executable String
  (param root String)
  (param command String)
  (if-expr (and (!= (call (. command find) "/") null) (not (call (. command starts-with) "/"))) (str root "/" command) command)
)

(fn-do _ service-identity String
  (param executable String)
  (param command BuildServiceCommand)
  (let parts (list String))
  (+= parts executable)
  (++= parts (. command arguments))
  (for (in (tuple name value) (. command variables))
    (+= parts (str name "=" value))
  )
  (let stat (catch? (. (call Path executable 0) stat)))
  (if stat
    (+= parts (str (. stat size) " " (. stat mtime s) " " (. stat mtime ns)))
  )
  (return (call (. "\n" join) parts))
)
