/core/arena
/data/json
/data/jsonl
/data/jsonrpc
/os/env
/os/file
/os/path
/os/process

━━━━━━━━━━━━━━━━━━━━
+ BuildServiceCommand is Tuple

+ arguments [String]
+ variables [String = String]

━━━━━━━━━━━━━━━━━━━━
+ BuildOutcome is Tuple

+ status Int
+ output String
+ product String?
+ number Int

━━━━━━━━━━━━━━━━━━━━
+ BuildService
    is Closable

+ root String
+ event notified JSONRPCNotification
+ event stopped Int
_ process Process?
_ identity String?
_ generation = 0
_ next-request = 0
_ waiting [Int = Semaphore'JSON]
_ watched [String = [String]]
_ lock = Mutex()

────────────────────
+ This
    - root String

────────────────────
+ do build BuildOutcome?
    - command BuildServiceCommand
    - arguments [String]
    - watches = false

if watches
    remember(arguments)
. params = Map'String'JSON
    • arguments List'JSON(each as JSON in arguments) as JSON
    •? watch true if watches
. reply = JSONReader("build", ask(command, "build", params))
=? null if !reply.is-present
= catch? read-build-outcome(reply)

────────────────────
+ do watch
    - command BuildServiceCommand
    - arguments [String]

use lock
watched["\n".join(arguments)] = List'String(arguments)
. started = generation
=? if !ensure-running(command)
if generation == started
    send-watch(arguments)

────────────────────
+ do unwatch
    - command BuildServiceCommand
    - arguments [String]

=? if !forget(arguments)
. params = Map'String'JSON
    • arguments List'JSON(each as JSON in arguments) as JSON
ask(command, "unwatch", params)

────────────────────
+ do start Int?
    - command BuildServiceCommand

use lock
=? null if !ensure-running(command)
= generation

────────────────────
+ do ask JSON
    - command BuildServiceCommand
    - method String
    - params JSON

. done = Semaphore'JSON()
=? null if !enqueue(command, method, params, done)
= done.await() ?? (null as JSON)

────────────────────
+ do tell
    - command BuildServiceCommand
    - method String
    - params JSON

use lock
if ensure-running(command)
    send("${JSONRPCNotification(method, params)}")

────────────────────
+ do cancel

use lock
stop()

────────────────────
+ do close

cancel()

────────────────────
_ do enqueue Bool
    - command BuildServiceCommand
    - method String
    - params JSON
    - done Semaphore'JSON

use lock
=? false if !ensure-running(command)
next-request += 1
. id = next-request
waiting[id] = done
if !send("${JSONRPCRequest(id, method, params)}")
    -= waiting[id]
    = false
= true

────────────────────
_ do ensure-running Bool
    - command BuildServiceCommand

. executable = service-executable(root, command.arguments[0])
. current = service-identity(executable, command)
=? true if process && identity == current
stop()
. started = catch Process(executable, ProcessStderr.inherit, command.arguments[1 ...], root, command.variables)
=? false if started is Error
. running = started as Process
process = running
identity = current
generation += 1
do new @detached
    read(running)
catch failed
    stderr <- "The build service's reader ended with a panic: ${failed}\n"
    running.terminate()
    . lost = ended(running)
    if lost
        stopped <- lost
for _, arguments in watched
    send-watch(arguments)
= true

────────────────────
_ do remember
    - arguments [String]

use lock
watched["\n".join(arguments)] = List'String(arguments)

────────────────────
_ do forget Bool
    - arguments [String]

use lock
-= watched["\n".join(arguments)]
= process != null

────────────────────
_ do send-watch
    - arguments [String]

next-request += 1
. params = Map'String'JSON
    • arguments List'JSON(each as JSON in arguments) as JSON
    • watch true
send("${JSONRPCRequest(next-request, "build", params)}")

────────────────────
_ do stop

. running = process
process = null
identity = null
if running
    running.terminate()
settle()

────────────────────
_ do read
    - running Process

catch receive(running)
running.wait(null)
. lost = ended(running)
if lost
    stopped <- lost

────────────────────
_ do ended Int?
    - running Process

use lock
=? null if process != running
process = null
identity = null
settle()
= generation

────────────────────
_ do receive ?! Error
    - running Process

. scratch = use Arena()
for line in running ~> \json-line with JSONParser(scratch)
    deliver(line)

────────────────────
_ do deliver
    - line JSON

. message = catch? json-rpc-message(line)
do match? message
    | response JSONRPCResponse
        . id = match? response.id
            | number Int
                number
        =? if !id
        . done = take(id)
        =? if !done
        do match response.outcome
            | .result(value)
                done.post(value)
            | .error
                done.post(null)
    | notification JSONRPCNotification
        notified <- notification

────────────────────
_ do take Semaphore'JSON?
    - id Int

use lock
. done = waiting[id]
if done
    -= waiting[id]
= done

────────────────────
_ do settle

. pending [Semaphore'JSON]
for _, done in waiting
    pending += done
waiting.clear()
for done in pending
    done.post(null)

────────────────────
_ do send Bool
    - line String

. running = process
=? false if !running
. wrote = catch? running.write("$line\n")
= wrote != null

━━━━━━━━━━━━━━━━━━━━
+ do find-yumi-checkout Path?
    - start Path

. directory Path? = start
while directory
    . candidate = directory
    =? candidate if holds-yumi-checkout(candidate)
    . linked = linked-checkout(candidate / ".release.json")
    =? linked if linked
    directory = candidate.parent
= null

━━━━━━━━━━━━━━━━━━━━
_ do linked-checkout Path?
    - manifest Path

=? null if !manifest.is-link
. resolved = manifest.resolved
    catch error Error
        = null
. folder = resolved.dir
=? folder if holds-yumi-checkout(folder)
= null

━━━━━━━━━━━━━━━━━━━━
_ holds-yumi-checkout Bool
    - folder Path

(folder / "bin" / "yumi").is-file && (folder / "stdlib").is-dir

━━━━━━━━━━━━━━━━━━━━
+ do checkout-service-command BuildServiceCommand ?! Error
    - checkout Path
    - search-paths [Path]

. variables = environment()
variables["YUMIPATH"] = ":".join("$each" in search-paths)
variables["YUMI_BUILD_PATH"] = "${checkout / ".tmp" / "build"}"
= BuildServiceCommand([checkout-compiler(checkout, variables), "--serve"], variables)

━━━━━━━━━━━━━━━━━━━━
_ do checkout-compiler String ?! Error
    - checkout Path
    - variables [String = String]

. process = Process
    - "${checkout / "bin" / "yumi"}"
    - ProcessStderr.inherit
    - ["--build-only"]
    - "$checkout"
    - variables
. output = process as String
. status = process.wait(null) ?? 1
process.close()
. lines [String] = output.trim().split("\n")
?! Error("The compiler in $checkout did not build: ${output.trim()}")
    if status != 0 || lines.length == 0
= lines[lines.length - 1]

━━━━━━━━━━━━━━━━━━━━
+ read-build-outcome BuildOutcome ?! Error
    - reply JSONReader

BuildOutcome(fields["status"].int(), fields["output"].string(), product, fields["number"].int())

.. fields = reply.object()
.. product = fields["product"].string() if fields.has("product")

━━━━━━━━━━━━━━━━━━━━
_ service-executable String
    - root String
    - command String

if command.find("/") != null && !command.starts-with("/") then "$root/$command" else command

━━━━━━━━━━━━━━━━━━━━
_ do service-identity String
    - executable String
    - command BuildServiceCommand

. parts [String]
parts += executable
parts ++= command.arguments
for name, value in command.variables
    parts += "$name=$value"
. stat = catch? Path(executable, 0).stat
if stat
    parts += "${stat.size} ${stat.mtime.s} ${stat.mtime.ns}"
= "\n".join(parts)
