(import /os/path)
(blank)
(prop + host-target-name _ (= "linux"))

(fn-do + apple-sdk-path Path (?! Error)
  (param sdk (? String))
  ; Apple SDKs come with Xcode, which a Linux host does not have.
  (throw (call Error "Apple SDKs are only on macOS; on Linux, build for an Apple target with --object-only and --c-headers, given a snapshot a Mac wrote with --record-c-headers"))
)

(fn-do + apple-linker-path String (?! Error)
  ; Apple's linker comes with Xcode, which a Linux host does not have.
  (throw (call Error "Apple's linker is only on macOS; on Linux, build for an Apple target with --object-only"))
)
