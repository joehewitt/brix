      (let block ([] order position))
      (let instructions (call (. builder take-instructions) block))
      (= cached-reload no-id)
      (+= home-stamp 1)
      (let ending no-id)
      (if (. scan has-pieces)
        (call emit-piece-reloads ([] (. scan start-reloads) block))
        (if (!= (. ([] (. scan end-reloads) block) length) 0)
