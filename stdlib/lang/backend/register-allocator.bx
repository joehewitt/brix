      (if (!= (. free length) 0)
        (= object ([] free (- (. free length) 1)))
        (= free (call IdList (. free data) (- (. free length) 1) (. free capacity)))
        (else
          (= object (call (. builder add-frame-object) root-slot pointer-type-id 0 false false))
        )
      )
      (call set-root-home id object)
      (= active (call (. active appended) arena (call (. liveness end) id)))
      (= active (call (. active appended) arena object))
    )
  )
  (fn-do _ set-root-home _
    (param id U32)
