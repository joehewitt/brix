      (let objects (. ([] (. function slots) ([] (. function frame-slots) position)) objects))
      (for (in index (..< 0 (. objects length)))
        (let object ([] (. function frame-objects) ([] objects index)))
        (if (or (. object is-spill) (not (. object gc-root)) (. object can-promote))
