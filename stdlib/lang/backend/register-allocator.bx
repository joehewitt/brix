    (let drops false)
    (if (and (or (== opcode .mov) (== opcode .fmov)) (> (. operands length) 1))
      (let destination (call preg-of ([] operands 0)))
      (if (and (!= destination no-register) (== destination (call preg-of ([] operands 1))) full-width)
        (= drops true)
        (else-if (and (== opcode .mov) copies-self (== (call register-class destination) .gpr32) unneeded)
          (return)
        )
      )
      (lazy full-width (and (!= (call register-class destination) .gpr32) (!= (call register-class destination) .fpr32)))
      (lazy copies-self (and (!= destination no-register) (== destination (call preg-of ([] operands 1)))))
      (lazy unneeded (and (!= moved no-id) (== ([] wide (call checked-id moved)) 0) (== (. def-reloads length) 0)))
    )
    (if (and drops (== (. def-reloads length) 0))
      (return)
    )
    (if (not drops)
      (call (. builder append) id)
    )
    (let cursor U32)
    (while (< cursor (. def-reloads length))
      (call (. builder str)
        (block
          (arg (call (. builder preg) ([] def-reloads cursor)))
          (arg (call (. builder frame-object-operand) ([] def-reloads (+ cursor 1))))
        )
      )
      (+= cursor 2)
    )
    (for (in index (..< 0 (. defined-homes length)))
      (= ([] live-homes ([] defined-homes index)) 0)
    )
  )
  (fn-do _ rewrite-spilled-move Bool
    (param operands IdList)
    ; Gives a copy that writes a value to its spill slot as a store of the register it copies, and
    ; one that reads a value from its spill slot into a register as a load into that register, in
    ; place of a copy through the register the value would be reloaded into or stored from.
    (let target (call view-of ([] operands 0)))
    (let source (call view-of ([] operands 1)))
    (if (or (and (== target no-id) (== (call preg-of ([] operands 0)) no-register)) source-not-register)
      (return false)
    )
    (lazy source-not-register (and (== source no-id) (== (call preg-of ([] operands 1)) no-register)))
    (if (!= (call operand-class ([] operands 0)) (call operand-class ([] operands 1)))
      (return false)
    )
    (let stored (call memory-slot target false))
    (if (!= stored no-frame-object)
      (let value (if-expr (!= source no-id) (call resolve ([] operands 1) source false true) ([] operands 1)))
      (if (== cached-reload (call checked-id target))
        (= cached-reload no-id)
      )
      (call (. builder str) value (call (. builder frame-object-operand) stored))
      (return true)
    )
    (let loaded (call memory-slot source true))
    (if (or (== loaded no-frame-object) (and (!= target no-id) target-unallocated))
      (return false)
    )
    (lazy target-unallocated (== (. ([] (. scan allocations) (call checked-id target)) kind) .unallocated))
    (let destination (if-expr (!= target no-id) (call resolve ([] operands 0) target true false) ([] operands 0)))
    (if (== (call register-parent (call preg-of destination)) scratch-register)
      (= cached-reload no-id)
    )
    (call (. builder ldr) destination (call (. builder frame-object-operand) loaded))
    (let cursor U32)
    (while (< cursor (. def-reloads length))
      (call (. builder str)
        (block
          (arg (call (. builder preg) ([] def-reloads cursor)))
          (arg (call (. builder frame-object-operand) ([] def-reloads (+ cursor 1))))
        )
      )
      (+= cursor 2)
    )
    (return true)
  )
  (fn-expr _ operand-class RegClass
    (param operand OperandId)
    (if-expr (!= view no-id) (. ([] (. function vregs) view) reg-class) (call register-class (call preg-of operand)))
    (where
      (lazy view (call view-of operand))
    )
  )
  (fn-expr _ memory-slot FrameObjectId
    (param view VRegId)
    (param is-use Bool)
    ; The spill slot an instruction at the current position reads or writes `view` through, or none
    ; when a register holds it there.
    (case? (or (== view no-id) (!= (. ([] (. scan allocations) id) kind) .in-spill) (and is-use (== cached-reload id)))
      no-frame-object
    )
    (case? (and (. scan has-pieces) has-position (!= (call (. scan piece-register) id slot) no-register))
      no-frame-object
    )
    (default
      (. ([] (. scan allocations) id) spill-slot)
    )
    (where
      (lazy id (call checked-id view))
      (lazy slot (if-expr is-use (* current-position 2) (+ (* current-position 2) 1)))
    )
  )
  (fn-do _ reserve-operand _
    (param operand OperandId)
    (let base no-operand)
    (let offset no-operand)
    (match? ([] (. function operands) operand)
      (case (call .preg-operand row)
        (= reserved (call (. reserved with) (call register-parent (. row register))))
      )
      (case (call .load-address-operand row)
        (= base (. row base))
        (= offset (. row offset))
      )
    )
    (if (!= base no-operand)
      (call reserve-operand base)
    )
    (if (!= offset no-operand)
      (call reserve-operand offset)
    )
  )
  (fn-do _ resolve OperandId
    (param operand OperandId)
    (param view VRegId)
    (param is-def Bool)
    (param is-use Bool)
    (let id (call checked-id view))
    (if (== (. ([] (. scan allocations) id) kind) .unallocated)
      (return operand)
    )
    (let reg-class (. ([] (. function vregs) view) reg-class))
    (if (== (. ([] (. scan allocations) id) kind) .in-register)
      (return (call (. builder preg) (call register-view (. ([] (. scan allocations) id) register) reg-class)))
    )
    (if (== (. ([] (. scan allocations) id) kind) .recomputed)
      (return (call recomputed-operand id reg-class reserved (* current-position 2) true))
    )
    (blank)
    (let slot (. ([] (. scan allocations) id) spill-slot))
    (if (and (. scan has-pieces) has-position)
      (let held
        (call (. scan piece-register)
          (block
            (arg id)
            (arg (if-expr is-use (* current-position 2) (+ (* current-position 2) 1)))
          )
        )
      )
      (if (!= held no-register)
        (let kept (call register-view held reg-class))
        (if is-def
          (if (== cached-reload id)
            (= cached-reload no-id)
          )
          (= def-reloads (call (. def-reloads appended) arena kept))
          (= def-reloads (call (. def-reloads appended) arena slot))
        )
        (return (call (. builder preg) kept))
      )
    )
    (if (and is-use (== cached-reload id) (not (call (. taken has) scratch-register)) (not (call (. reserved has) scratch-register)))
      (= taken (call (. taken with) scratch-register))
      (let cached (call register-view scratch-register reg-class))
      (if is-def
        (= def-reloads (call (. def-reloads appended) arena cached))
        (= def-reloads (call (. def-reloads appended) arena slot))
      )
      (return (call (. builder preg) cached))
    )
    (blank)
    (let register (call pick-reload-register reg-class reserved (* current-position 2)))
    (let parent (call register-parent register))
    (= taken (call (. taken with) parent))
    (if is-use
      (call (. builder ldr) (call (. builder preg) register) (call (. builder frame-object-operand) slot))
      (if (== parent scratch-register)
        (= cached-reload id)
      )
    )
    (if is-def
      (if (== parent scratch-register)
        (= cached-reload no-id)
      )
      (= def-reloads (call (. def-reloads appended) arena register))
      (= def-reloads (call (. def-reloads appended) arena slot))
    )
    (return (call (. builder preg) register))
  )
  (fn-do _ pick-reload-register RegisterId
    (param reg-class RegClass)
    (param excluded RegisterSet)
    (param use-slot U32)
    (let is-general (call is-general-class reg-class))
    (if (and is-general (not (call (. taken has) scratch-register)) (not (call (. excluded has) scratch-register)))
      (return (call register-view scratch-register reg-class))
    )
    (for (in index (..< 0 (. available length)))
      (let parent ([] available index))
      (if (or (== parent scratch-register) (call is-float-scratch parent))
        (continue)
      )
      (if (or (call (. taken has) parent) (call (. excluded has) parent) (call (. scan is-parent-live-at) parent use-slot))
        (continue)
      )
      (if (== (call is-general-class (call register-class parent)) is-general)
        (call (. scan mark-used) parent)
        (return (call register-view parent reg-class))
      )
    )
    (if is-general
      (if (and (not (call (. taken has) 16)) (not (call (. excluded has) 16)))
        (return (call register-view 16 reg-class))
      )
      (if (and (not (call (. taken has) 17)) (not (call (. excluded has) 17)))
        (return (call register-view 17 reg-class))
      )
      (else
        (if (and (not (call (. taken has) float-scratch-register)) (not (call (. excluded has) float-scratch-register)))
          (return (call register-view float-scratch-register reg-class))
        )
        (if (and (not (call (. taken has) 64)) (not (call (. excluded has) 64)))
          (return (call register-view 64 reg-class))
        )
        (if (and (not (call (. taken has) 65)) (not (call (. excluded has) 65)))
          (return (call register-view 65 reg-class))
        )
      )
    )
    (throw (call Panic "No scratch register available for spill reload"))
  )
  (fn-do _ read-register OperandId
    (param operand OperandId)
    (param view VRegId)
    (param slot U32)
    (param excluded RegisterSet)
    (let id (call checked-id view))
    (if (== (. ([] (. scan allocations) id) kind) .unallocated)
      (if (== operand no-operand)
        (return (call (. builder vreg-operand) view))
      )
      (return operand)
    )
    (let reg-class (. ([] (. function vregs) view) reg-class))
    (if (== (. ([] (. scan allocations) id) kind) .in-register)
      (return (call (. builder preg) (call register-view (. ([] (. scan allocations) id) register) reg-class)))
    )
    (if (== (. ([] (. scan allocations) id) kind) .recomputed)
      (return (call recomputed-operand id reg-class excluded slot false))
    )
    (let register (call (. builder preg) (call pick-reload-register reg-class excluded slot)))
    (call (. builder ldr) register (call (. builder frame-object-operand) (. ([] (. scan allocations) id) spill-slot)))
    (return register)
  )
  (fn-expr _ is-recomputed Bool
    (param view VRegId)
    (and (!= view no-id) (== (. ([] (. scan allocations) (call checked-id view)) kind) .recomputed))
  )
  (fn-do _ recomputed-operand OperandId
    (param id U32)
    (param reg-class RegClass)
    (param excluded RegisterSet)
    (param use-slot U32)
    (param caches Bool)
    ; A register holding the value of `id` where it is read: the register a copy reads, or one its
    ; instructions are given again into.
    (let defined ([] ([] recompute-defs id) 0))
    (if (== (. ([] (. function instructions) defined) opcode) .mov)
      (let source (call checked-id (call view-of ([] (. ([] (. function instructions) defined) operands) 1))))
      (return (call (. builder preg) (call register-view (call register-parent (. ([] (. scan allocations) source) register)) reg-class)))
    )
    (if (and caches (== cached-reload id) (not (call (. taken has) scratch-register)) (not (call (. excluded has) scratch-register)))
      (= taken (call (. taken with) scratch-register))
      (return (call (. builder preg) (call register-view scratch-register reg-class)))
    )
    (let register (call pick-reload-register reg-class excluded use-slot))
    (let parent (call register-parent register))
    (call recompute parent id)
    (if caches
      (= taken (call (. taken with) parent))
      (if (== parent scratch-register)
        (= cached-reload id)
      )
    )
    (return (call (. builder preg) register))
  )
  (fn-do _ recompute _
    (param parent RegisterId)
    (param id U32)
    ; Gives the instructions that define `id` again, into `parent`, reading their other registers
    ; where they were left.
    (let defs ([] recompute-defs id))
    (for (in index (..< 0 (. defs length)))
      (let operands (. ([] (. function instructions) ([] defs index)) operands))
      (let made (call new-id-list arena (. operands length)))
      (for (in entry (..< 0 (. operands length)))
        (let operand ([] operands entry))
        (let view (call view-of operand))
        (if (!= view no-id)
          (let source (call checked-id view))
          (let register
            (scope (if-expr (== source id) parent source-register)
              (lazy source-register (call register-parent (. ([] (. scan allocations) source) register)))
            )
          )
          (= operand (call (. builder preg) (call register-view register (. ([] (. function vregs) view) reg-class))))
        )
        (= ([] (. made data) entry) operand)
      )
      (let first ([] (. made data) 0))
      (let second (if-expr (> (. operands length) 1) ([] (. made data) 1) no-operand))
      (let third (if-expr (> (. operands length) 2) ([] (. made data) 2) no-operand))
      (call (. builder asm) (. ([] (. function instructions) ([] defs index)) opcode) first second third)
    )
  )
  (fn-do _ bind-return _
    (param return-type MIRTypeId)
    (param return-operand OperandId)
    (param buffer FrameObjectId)
    (let view (call view-of return-operand))
    (if (== view no-id)
      (return)
    )
    (let id (call checked-id view))
    (let kind (. ([] (. scan allocations) id) kind))
    (if (== kind .unallocated)
      (return)
    )
    (let slot (. ([] (. scan allocations) id) spill-slot))
    (let format (call struct-format return-type))
    (if (== format no-id)
      (let return-class (. ([] (. function vregs) view) reg-class))
      (let result (call register-of return-class 0))
      (if (== kind .in-register)
        (let destination (call register-view (. ([] (. scan allocations) id) register) return-class))
        (if (!= destination result)
          (call (. builder move) (call (. builder preg) destination) (call (. builder preg) result))
        )
        (else
          (call (. builder str) (call (. builder preg) result) (call (. builder frame-object-operand) slot))
        )
      )
      (return)
    )
    (blank)
    (let destination (if-expr (== kind .in-register) (. ([] (. scan allocations) id) register) scratch-register))
    (let scratch (call (. builder preg) scratch-register))
    (if (== format (as (. StructFormat large-format) U32))
      (call (. builder add-pointer) (call (. builder preg) destination) (call (. builder frame-object-operand) buffer))
      (if (== kind .in-spill)
        (call (. builder str) (call (. builder preg) destination) (call (. builder frame-object-operand) slot))
      )
      (return)
    )
    (call (. builder add-pointer) scratch (call (. builder frame-object-operand) buffer))
    (if (== format (as (. StructFormat small-format) U32))
      (let count U32 (if-expr (<= (. ([] (. function types) return-type) size) 8) 1 2))
      (for (in index (..< 0 count))
        (call (. builder store)
          (block
            (arg (call (. builder load-address-offset) scratch (* index 8)))
            (arg (call (. builder preg-argument) index .gpr64))
            (arg u64-type-id)
          )
        )
      )
      (else
        (= hfa-types (call IdList (. hfa-types data) 0 (. hfa-types capacity)))
        (= hfa-offsets (call IdList (. hfa-offsets data) 0 (. hfa-offsets capacity)))
        (call collect-hfa-fields return-type 0)
        (throw (call Panic "An HFA return has no floating fields") (if (== (. hfa-types length) 0)))
        (blank)
        (let field-type ([] hfa-types 0))
        (let field-class (call (. builder type-reg-class) field-type))
        (for (in index (..< 0 (. hfa-types length)))
          (call (. builder store)
            (block
              (arg (call (. builder load-address-offset) scratch ([] hfa-offsets index)))
              (arg (call (. builder preg-argument) index field-class))
              (arg field-type)
            )
          )
        )
      )
    )
    (if (!= destination scratch-register)
      (call (. builder move) (call (. builder preg) destination) scratch)
    )
    (if (== kind .in-spill)
      (call (. builder str) (call (. builder preg) destination) (call (. builder frame-object-operand) slot))
    )
  )
  (fn-do _ bind-parts _
    (param operand OperandId)
    ; Moves the parts of a struct a call returns in registers to the places allocated to them. A
    ; part that lives in the frame is stored first, before the moves can overwrite the register it
    ; arrives in.
    (let members Span)
    (match? ([] (. function operands) operand)
      (case (call .vreg-group-operand group)
        (= members (. group vregs))
      )
    )
    (for (in index (..< 0 (. members count)))
      (let view ([] (. function group-vregs) (+ (. members start) index)))
      (let id (call checked-id view))
      (if (== (. ([] (. scan allocations) id) kind) .in-spill)
        (let result (call register-of (. ([] (. function vregs) view) reg-class) index))
        (call (. builder str)
          (block
            (arg (call (. builder preg) result))
            (arg (call (. builder frame-object-operand) (. ([] (. scan allocations) id) spill-slot)))
          )
        )
      )
    )
    (let start (. move-destinations length))
    (for (in index (..< 0 (. members count)))
      (let view ([] (. function group-vregs) (+ (. members start) index)))
      (let id (call checked-id view))
      (= ([] live-homes id) 0)
      (if (== (. ([] (. scan allocations) id) kind) .in-register)
        (let reg-class (. ([] (. function vregs) view) reg-class))
        (= move-destinations
          (call (. move-destinations appended)
            (block
              (arg arena)
              (arg (call register-view (. ([] (. scan allocations) id) register) reg-class))
            )
          )
        )
        (= move-sources (call (. move-sources appended) arena (call register-of reg-class index)))
        (= move-classes (call (. move-classes appended) arena reg-class))
      )
    )
    (call emit-parallel-moves (call Span start (- (. move-destinations length) start)))
  )
  (fn-do _ is-group-operand Bool
    (param operand OperandId)
    (if (== operand no-operand)
      (return false)
    )
    (match? ([] (. function operands) operand)
      (case .vreg-group-operand
        (return true)
      )
    )
    (return false)
  )
  (fn-do _ collect-hfa-fields _
    (param type MIRTypeId)
    (param offset U32)
    (let fields Span)
    (let is-struct false)
    (let is-float false)
    (match? ([] (. function types) type)
      (case (call .struct-type row)
        (= is-struct true)
        (= fields (. row fields))
      )
      (case .float-type
        (= is-float true)
      )
    )
    (if is-float
      (= hfa-types (call (. hfa-types appended) arena type))
      (= hfa-offsets (call (. hfa-offsets appended) arena offset))
      (return)
    )
    (throw (call Panic "HFA contains a non-floating field") (if (not is-struct)))
    (blank)
    (for (in index (..< (. fields start) (. fields end)))
      (call collect-hfa-fields
        (block
          (arg (. ([] (. function struct-fields) index) type))
          (arg (+ offset (. ([] (. function struct-fields) index) offset)))
        )
      )
    )
  )
  (fn-do _ emit-parallel-moves _
    (param moves Span)
    (let destinations (call (of (. arena allocate) U32) (. moves count)))
    (let sources (call (of (. arena allocate) U32) (. moves count)))
    (let classes (call (of (. arena allocate) U32) (. moves count)))
    (let count U32)
    (for (in move (..< (. moves start) (. moves end)))
      (if (!= ([] move-sources move) ([] move-destinations move))
        (= ([] destinations count) ([] move-destinations move))
        (= ([] sources count) ([] move-sources move))
        (= ([] classes count) ([] move-classes move))
        (+= count 1)
      )
    )
    (while (> count 0)
      (let ready no-id)
      (for (in index (..< 0 count))
        (let is-read false)
        (let parent (call register-parent ([] destinations index)))
        (for (in other (..< 0 count))
          (if (and (!= other index) (== (call register-parent ([] sources other)) parent))
            (= is-read true)
            (break)
          )
        )
        (if (not is-read)
          (= ready index)
          (break)
        )
      )
      (if (!= ready no-id)
        (call (. builder move) (call (. builder preg) ([] destinations ready)) (call (. builder preg) ([] sources ready)))
        (-= count 1)
        (for (in index (..< ready count))
          (= ([] destinations index) ([] destinations (+ index 1)))
          (= ([] sources index) ([] sources (+ index 1)))
          (= ([] classes index) ([] classes (+ index 1)))
        )
        (continue)
      )
      (blank)
      (let cycle-parent (call register-parent ([] destinations 0)))
      (let scratch-class (as ([] classes 0) RegClass))
      (let first-source-class RegClass .gpr64)
      (let has-source false)
      (let has-wide-source false)
      (for (in index (..< 0 count))
        (if (!= (call register-parent ([] sources index)) cycle-parent)
          (continue)
        )
        (let source-class (as ([] classes index) RegClass))
        (if (not has-source)
          (= has-source true)
          (= first-source-class source-class)
        )
        (if (or (== source-class .gpr64) (== source-class .fpr64))
          (= has-wide-source true)
        )
      )
      (if has-wide-source
        (= scratch-class (if-expr (call is-general-class first-source-class) .gpr64 .fpr64))
      )
      (let scratch (call scratch-for-class scratch-class))
      (call (. builder move) (call (. builder preg) scratch) (call (. builder preg) (call register-view cycle-parent scratch-class)))
      (for (in index (..< 0 count))
        (if (== (call register-parent ([] sources index)) cycle-parent)
          (= ([] sources index) (call register-view (call register-parent scratch) (as ([] classes index) RegClass)))
        )
      )
    )
  )
  (fn-expr _ scratch-for-class RegisterId
    (param reg-class RegClass)
    (if-expr (call is-general-class reg-class) (call register-view scratch-register reg-class) float-scratch)
    (where
      (lazy float-scratch (call register-view float-scratch-register reg-class))
    )
  )
)

(fn-expr _ is-cheap-opcode Bool
  (param opcode Opcode)
  (param count U32)
  (case? (== count 3)
    (or (== opcode .add) (== opcode .sub) (== opcode .lsl) (== opcode .lsr) (== opcode .asr) (== opcode .and) (== opcode .orr) (== opcode .eor))
  )
  (default
    (and (== count 2) (or unsigned-copy (== opcode .sxtb) (== opcode .sxth) (== opcode .sxtw)))
  )
  (where
    (lazy unsigned-copy (or (== opcode .mov) (== opcode .uxtb) (== opcode .uxth) (== opcode .uxtw)))
  )
)

(fn-do _ holds-slot Bool
  (param ranges IdList)
  (param slot U32)
  (let low U32)
  (let high (/ (. ranges length) 2))
  (while (< low high)
    (let middle (/ (+ low high) 2))
    (if (<= ([] ranges (+ (* middle 2) 1)) slot)
      (= low (+ middle 1))
      (else
        (= high middle)
      )
    )
  )
  (return (and (< (* low 2) (. ranges length)) (<= ([] ranges (* low 2)) slot)))
)

(fn-expr _ is-general-class Bool
  (param reg-class RegClass)
  (or (== reg-class .gpr32) (== reg-class .gpr64))
)

(fn-expr _ is-float-scratch Bool
  (param register RegisterId)
  (or (== register float-scratch-register) (== register 64) (== register 65))
)

(fn-expr _ is-terminator Bool
  (param opcode Opcode)
  (or (== opcode .b) (== opcode .b-cond) (== opcode .cbz) (== opcode .cbnz) (== opcode .tbz) (== opcode .tbnz) (== opcode .br) (== opcode .ret))
)
