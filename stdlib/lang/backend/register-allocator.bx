      (if (and (== (. ([] (. liveness intervals) id) reg-class) .gpr64) (== (. ([] (. scan allocations) id) kind) .in-register))
        (= homes (call (. homes appended) arena id))
      )
    )
    (let ends (call (of (. arena allocate) U32) (. homes length)))
    (for (in index (..< 0 (. homes length)))
      (= ([] ends index) (call (. liveness end) ([] homes index)))
    )
    (= homes (call stable-order arena homes ends))
    (let starts (call (of (. arena allocate) U32) (. homes length)))
    (for (in index (..< 0 (. homes length)))
      (= ([] starts index) (call (. liveness start) ([] homes index)))
    )
    (= homes (call stable-order arena homes starts))
    (blank)
    (let active IdList)
    (let free IdList)
    (for (in index (..< 0 (. homes length)))
      (let id ([] homes index))
      (let start (call (. liveness start) id))
      (let cursor (. active length))
      (while (> cursor 0)
        (-= cursor 2)
        (if (<= ([] active cursor) start)
          (= free (call (. free appended) arena ([] active (+ cursor 1))))
          (for (in position (..< (+ cursor 2) (. active length)))
            (= ([] (. active data) (- position 2)) ([] active position))
