  (fn-do _ rewrite-instructions _
    (= live-homes (call (of (. arena allocate) U32) vreg-count))
    (= home-stamp 0)
    (= seen-vregs (call (of (. arena allocate) U32) vreg-count))
    (= seen-capacity (as (+ (. function frame-objects length) vreg-count 1) U32))
    (= seen-objects (call (of (. arena allocate) U32) seen-capacity))
    (= seen-stamp 0)
    (= def-reloads (call IdList))
    (= defined-homes (call IdList))
    (= materializations (call IdList))
    (= hfa-types (call IdList))
    (= hfa-offsets (call IdList))
