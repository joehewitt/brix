    (if (== ([] root-homes id) 0)
      (if (== root-slot no-id)
        (= root-slot (call (. builder frame-slot)))
      )
      (call set-root-home id (call (. builder add-frame-object) root-slot pointer-type-id 0 false false))
    )
    (let object (- ([] root-homes id) 1))
    (= (. ([] (. function frame-objects) object) gc-root) true)
    (return object)
