  (fn-expr _ home-order U64
    (param object FrameObjectId)
    (+ (* (as (+ slot 0x40000000) U64) 0x100000000) (as (+ index 0x40000000) U64))
    (where
      (lazy slot I64 (. ([] (. function slots) (. ([] (. function frame-objects) object) slot)) index))
      (lazy index I64 (. ([] (. function frame-objects) object) index))
    )
  )
  (fn-do _ emit-materializations _
    (let pairs materializations)
    (let count (/ (. pairs length) 2))
    (if (== count 0)
      (return)
    )
    (for (in position (..< 1 count))
      (let register ([] pairs (* position 2)))
      (let object ([] pairs (+ (* position 2) 1)))
      (let key (call home-order object))
      (let target position)
      (while (and (> target 0) (> (call home-order ([] pairs (- (* target 2) 1))) key))
        (= ([] (. pairs data) (* target 2)) ([] pairs (- (* target 2) 2)))
        (= ([] (. pairs data) (+ (* target 2) 1)) ([] pairs (- (* target 2) 1)))
        (-= target 1)
