(import ./builder)
(import ./bundle)
(import ./frame-coloring)
(import ./linear-scan)
(import ./liveness)
(import ./mir)
(import ./pointer-flow)
(import ./prologue-epilogue)
(import /core/arena)
(import /core/table)
(blank)
(prop _ max-aligned-stack-immediate I64 (= 4080))
(prop _ scratch-register RegisterId (= 9))
(prop _ float-scratch-register RegisterId (= 95))
(prop _ struct-return-register RegisterId (= 8))
(prop _ panic-signal-register RegisterId (= 15))
(prop _ preserved-callee-register RegisterId (= 17))
(prop _ layout-thunk-register RegisterId (= 27))
(prop _ layout-context-register RegisterId (= 28))
(prop _ no-end U32 (= (. U32 max)))

(type _ CallPlan (is Struct)
  (prop + callee OperandId)
  (prop + return-operand OperandId)
  (prop + call-use-slot U32)
  (prop + moves Span)
  (prop + reloads Span)
  (prop + overflow-entries Span)
  (prop + struct-return-buffer FrameObjectId)
  (prop + struct-return-destination OperandId)
  (prop + argument-registers RegisterSet)
  (prop + safepoint U32)
)

(type + MIRRegisterAllocator
  (prop _ builder MIRBuilder)
  (prop _ bundle Bundle)
  (prop _ function MIRFunction)
  (prop + liveness MIRLiveness)
  (prop + coloring MIRFrameColoring)
  (prop + scan MIRLinearScan)
  (prop _ frame MIRPrologueEpilogue)
  (prop _ flow MIRPointerFlow)
  (prop _ use-counts (of CPointer U32))
  (prop _ vreg-count U32)
  (prop _ available IdList)
  (prop _ root-slot MIRSlotId)
  (prop _ root-homes (of CPointer U32))
  (prop _ root-home-count U32)
  (prop _ relevant IdList)
  (prop _ relevant-marks (of CPointer Byte))
  (prop _ return-sizes IdMap)
  (prop _ return-counts IdList)
  (prop _ return-active (of CPointer IdList))
  (prop _ return-free (of CPointer IdList))
  (prop _ has-return-flow Bool)
  (prop _ return-roots (of CPointer U32))
  (prop _ return-root-ends (of CPointer U32))
  (prop _ safepoint-positions IdList)
  (prop _ safepoint-roots (of CPointer IdList))
  (prop _ plans (of CPointer CallPlan))
  (prop _ plan-of (of CPointer U32))
  (prop _ plan-capacity U32)
  (prop _ outgoing-size I64)
  (prop _ call-overflow-slot MIRSlotId)
  (prop _ move-destinations IdList)
  (prop _ move-sources IdList)
  (prop _ move-classes IdList)
  (prop _ reload-destinations IdList)
  (prop _ reload-slots IdList)
  (prop _ reload-views IdList)
  (prop _ overflow-slots IdList)
  (prop _ overflow-sources IdList)
  (prop _ next-general-argument U32)
  (prop _ next-float-argument U32)
  (prop _ current-position U32)
  (prop _ has-position Bool)
  (prop _ reserved RegisterSet)
  (prop _ taken RegisterSet)
  (prop _ def-reloads IdList)
  (prop _ cached-reload U32)
  (prop _ live-homes (of CPointer U32))
  (prop _ home-stamp U32)
  (prop _ seen-vregs (of CPointer U32))
  (prop _ seen-objects (of CPointer U32))
  (prop _ seen-capacity U32)
  (prop _ seen-stamp U32)
  (prop _ materializations IdList)
  (prop _ defined-homes IdList)
  (prop _ hfa-types IdList)
  (prop _ hfa-offsets IdList)
  (prop _ cheap (of CPointer Byte))
  (prop _ wide (of CPointer Byte))
  (prop _ recompute-sources (of CPointer IdList))
  (prop _ recompute-defs (of CPointer IdList))
  (fn-do + This _
    (param builder MIRBuilder)
    (lazy bundle (. builder bundle))
    (lazy function (. builder function))
    (lazy liveness (call MIRLiveness builder))
    (lazy flow (call MIRPointerFlow builder))
    (lazy coloring (call MIRFrameColoring builder liveness flow))
    (lazy scan (call MIRLinearScan builder liveness))
    (lazy frame (call MIRPrologueEpilogue builder coloring))
  )
  (fn-expr _ arena Arena :get @inline
    (. function arena)
  )
  (fn-do + form-post-indexed-loads _
    (= use-counts (call (of (. arena allocate) U32) (. function vreg-count)))
    (while (call form-post-indexed-load)
      (continue)
    )
  )
  (fn-do _ form-post-indexed-load Bool
    (call count-post-index-uses)
    (let order (. function block-order))
    (for (in position (..< 0 (. order length)))
      (let block ([] order position))
      (let instructions (. ([] (. function blocks) block) instructions))
      (for (in index (..< 0 (. instructions length)))
        (let add ([] instructions index))
        (let opcode (. ([] (. function instructions) add) opcode))
        (if (and (!= opcode .add) (!= opcode .addptr))
          (continue)
        )
        (let operands (. ([] (. function instructions) add) operands))
        (if (< (. operands length) 3)
          (continue)
        )
        (let next (call vreg-of ([] operands 0)))
        (let current (call vreg-of ([] operands 1)))
        (if (or (== next no-id) (== current no-id) (not (call is-post-index-stride ([] operands 2))))
          (continue)
        )
        (if (or (!= (call block-use-count instructions current) 2) reused (not (call has-move-use next)))
          (continue)
        )
        (lazy reused (!= ([] use-counts next) 1))
        (blank)
        (let load-index (call previous-instruction instructions index))
        (if (== load-index no-id)
          (continue)
        )
        (let load ([] instructions load-index))
        (let load-opcode (. ([] (. function instructions) load) opcode))
        (if (and (!= load-opcode .ldr) not-narrow (!= load-opcode .ldrsw))
          (continue)
        )
        (lazy not-narrow (and (!= load-opcode .ldrb) (!= load-opcode .ldrh)))
        (let load-operands (. ([] (. function instructions) load) operands))
        (if (!= (. load-operands length) 2)
          (continue)
        )
        (let loaded (call vreg-of ([] load-operands 0)))
        (if (or (== loaded no-id) (== loaded current))
          (continue)
        )
        (let base no-operand)
        (let offset no-operand)
        (let is-plain-address false)
        (match? ([] (. function operands) ([] load-operands 1))
          (case (call .load-address-operand address)
            (= base (. address base))
            (= offset (. address offset))
            (= is-plain-address (not (. address is-pre-index)))
          )
        )
        (if (or (not is-plain-address) (not (call is-zero-or-missing offset)))
          (continue)
        )
        (blank)
        (let alias-index no-id)
        (let base-vreg (call vreg-of base))
        (if (!= base-vreg current)
          (= alias-index (call previous-instruction instructions load-index))
          (if (or (== base-vreg no-id) (!= ([] use-counts base-vreg) 1) (== alias-index no-id))
            (continue)
          )
          (let alias ([] instructions alias-index))
          (let alias-operands (. ([] (. function instructions) alias) operands))
          (if (or (!= (. ([] (. function instructions) alias) opcode) .mov) (< (. alias-operands length) 2))
            (continue)
          )
          (if (or (!= (call vreg-of ([] alias-operands 0)) base-vreg) (!= (call vreg-of ([] alias-operands 1)) current))
            (continue)
          )
        )
        (blank)
        (let rewritten (call new-id-list arena 3))
        (= rewritten (call (. rewritten appended) arena ([] load-operands 0)))
        (= rewritten (call (. rewritten appended) arena (call (. builder load-address) ([] operands 1) offset)))
        (= rewritten (call (. rewritten appended) arena ([] operands 2)))
        (= (. ([] (. function instructions) load) operands) rewritten)
        (call rename-uses next ([] operands 1) add)
        (let kept U32)
        (for (in read (..< 0 (. instructions length)))
          (if (and (!= read index) (!= read alias-index))
            (= ([] (. instructions data) kept) ([] instructions read))
            (+= kept 1)
          )
        )
        (= (. ([] (. function blocks) block) instructions) (call IdList (. instructions data) kept (. instructions capacity)))
        (return true)
      )
    )
    (return false)
  )
  (fn-do _ vreg-of U32
    (param operand OperandId)
    (if (== operand no-operand)
      (return no-id)
    )
    (match? ([] (. function operands) operand)
      (case (call .vreg-operand row)
        (return (. ([] (. function vregs) (. row vreg)) id))
      )
    )
    (return no-id)
  )
  (fn-do _ is-post-index-stride Bool
    (param operand OperandId)
    (match? ([] (. function operands) operand)
      (case (call .int-operand row)
        (if (. row value is-negative)
          (return (>= (as (. row value bits) I64) -256))
        )
        (return (<= (. row value bits) 255))
      )
    )
    (return false)
  )
  (fn-do _ is-zero-or-missing Bool
    (param operand OperandId)
    (if (== operand no-operand)
      (return true)
    )
    (match? ([] (. function operands) operand)
      (case (call .int-operand row)
        (return (== (. row value bits) 0))
      )
    )
    (return false)
  )
  (fn-do _ previous-instruction U32
    (param instructions IdList)
    (param before U32)
    (let index before)
    (while (> index 0)
      (-= index 1)
      (if (!= (. ([] (. function instructions) ([] instructions index)) opcode) .comment)
        (return index)
      )
    )
    (return no-id)
  )
  (fn-do _ count-post-index-uses _
    (for (in id (..< 0 (. function vreg-count)))
      (= ([] use-counts id) 0)
    )
    (let order (. function block-order))
    (for (in position (..< 0 (. order length)))
      (let instructions (. ([] (. function blocks) ([] order position)) instructions))
      (for (in index (..< 0 (. instructions length)))
        (let id ([] instructions index))
        (let roles (call (. function operand-roles) id))
        (let operands (. ([] (. function instructions) id) operands))
        (for (in operand (..< 0 (. operands length)))
          (if (== (/and/ (call role-at roles operand) use-role) 0)
            (continue)
          )
          (let vreg (call used-vreg ([] operands operand)))
          (if (!= vreg no-id)
            (= ([] use-counts vreg) (+ ([] use-counts vreg) 1))
          )
        )
      )
    )
  )
  (fn-do _ used-vreg U32
    (param operand OperandId)
    (match? ([] (. function operands) operand)
      (case (call .vreg-operand row)
        (return (. ([] (. function vregs) (. row vreg)) id))
      )
      (case (call .load-address-operand row)
        (return (call vreg-of (. row base)))
      )
    )
    (return no-id)
  )
  (fn-do _ block-use-count U32
    (param instructions IdList)
    (param target U32)
    (let count U32)
    (for (in index (..< 0 (. instructions length)))
      (let id ([] instructions index))
      (let roles (call (. function operand-roles) id))
      (let operands (. ([] (. function instructions) id) operands))
      (for (in operand (..< 0 (. operands length)))
        (if (and (!= (/and/ (call role-at roles operand) use-role) 0) (== (call used-vreg ([] operands operand)) target))
          (+= count 1)
        )
      )
    )
    (return count)
  )
  (fn-do _ has-move-use Bool
    (param next U32)
    (let order (. function block-order))
    (for (in position (..< 0 (. order length)))
      (let instructions (. ([] (. function blocks) ([] order position)) instructions))
      (for (in index (..< 0 (. instructions length)))
        (let id ([] instructions index))
        (if (!= (. ([] (. function instructions) id) opcode) .mov)
          (continue)
        )
        (let operands (. ([] (. function instructions) id) operands))
        (if (and (> (. operands length) 1) (== (call vreg-of ([] operands 1)) next))
          (return true)
        )
      )
    )
    (return false)
  )
  (fn-do _ rename-uses _
    (param from U32)
    (param to OperandId)
    (param excluded InstructionId)
    (let order (. function block-order))
    (for (in position (..< 0 (. order length)))
      (let instructions (. ([] (. function blocks) ([] order position)) instructions))
      (for (in index (..< 0 (. instructions length)))
        (let id ([] instructions index))
        (if (== id excluded)
          (continue)
        )
        (let roles (call (. function operand-roles) id))
        (let operands (. ([] (. function instructions) id) operands))
        (for (in operand (..< 0 (. operands length)))
          (if (== (/and/ (call role-at roles operand) use-role) 0)
            (continue)
          )
          (if (== (call vreg-of ([] operands operand)) from)
            (= ([] (. operands data) operand) to)
            (continue)
          )
          (match? ([] (. function operands) ([] operands operand))
            (case (call .load-address-operand row)
              (if (== (call vreg-of (. row base)) from)
                (= (. row base) to)
              )
            )
          )
        )
      )
    )
  )
  (fn-do + begin _
    (= available (call IdList))
    (for (in register (..< 0 register-count))
      (let reg-class (call register-class register))
      (if (or (not (call is-general-register register)) (and (!= reg-class .gpr64) (!= reg-class .fpr64)))
        (continue)
      )
      (if (or (== register layout-thunk-register) holds-context)
        (continue)
      )
      (lazy holds-context (and (. function uses-layout-context) (== register layout-context-register)))
      (= available (call (. available appended) arena register))
    )
  )
  (fn-do + scan-intervals _
    (let allocatable IdList)
    (for (in index (..< 0 (. available length)))
      (let register ([] available index))
      (if (and (!= register scratch-register) (not (call is-float-scratch register)))
        (= allocatable (call (. allocatable appended) arena register))
      )
    )
    (call prefer-call-registers)
    (call find-recomputable)
    (call (. scan run) allocatable cheap recompute-sources)
  )
  (fn-do _ find-recomputable _
    ; Marks each register that its uses can compute again rather than load from the frame. One
    ; that only a constant, a symbol's address or a frame object's address defines reads no other
    ; register. One that a single cheap instruction defines reads registers that hold the same values
    ; wherever it is used, and no call reads it, since a call's moves may take those registers.
    ; Every view of either is as wide as the one it is defined in, so a view computed again into a
    ; register that keeps it is the value the definition gave.
    (= vreg-count (. liveness vreg-count))
    (= cheap (call (of (. arena allocate) Byte) vreg-count))
    (= recompute-sources (call (of (. arena allocate) IdList) vreg-count))
    (= recompute-defs (call (of (. arena allocate) IdList) vreg-count))
    (let called (call (of (. arena allocate) Byte) vreg-count))
    (let broken (call (of (. arena allocate) Byte) vreg-count))
    (let widths (call (of (. arena allocate) Byte) vreg-count))
    (let order (. function block-order))
    (for (in position (..< 0 (. order length)))
      (let instructions (. ([] (. function blocks) ([] order position)) instructions))
      (for (in index (..< 0 (. instructions length)))
        (let id ([] instructions index))
        (let opcode (. ([] (. function instructions) id) opcode))
        (let roles (call (. function operand-roles) id))
        (let operands (. ([] (. function instructions) id) operands))
        (for (in entry (..< 0 (. operands length)))
          (let operand ([] operands entry))
          (let role (call role-at roles entry))
          (match? ([] (. function operands) operand)
            (case (call .vreg-operand row)
              (let vreg (call checked-id (. row vreg)))
              (call note-width widths broken (. row vreg))
              (if (and (== opcode .call) (== ([] called vreg) 0))
                (= ([] called vreg) 1)
              )
              (if (!= (/and/ role def-role) 0)
                (let defs ([] recompute-defs vreg))
                (if (and (!= (. defs length) 0) detached)
                  (= ([] broken vreg) 1)
                )
                (lazy detached (or (== index 0) (!= ([] instructions (- index 1)) ([] defs (- (. defs length) 1)))))
                (= ([] recompute-defs vreg) (call (. defs appended) arena id))
              )
            )
            (case (call .vreg-group-operand group)
              (for (in member (..< (. group vregs start) (. group vregs end)))
                (let vreg (call checked-id ([] (. function group-vregs) member)))
                (= ([] called vreg) 2)
                (= ([] broken vreg) 1)
              )
            )
            (case (call .load-address-operand row)
              (let base (call vreg-of (. row base)))
              (if (!= base no-id)
                (call note-width widths broken (call view-of (. row base)))
                (if (and (== opcode .call) (== ([] called base) 0))
                  (= ([] called base) 1)
                )
                (if (!= (/and/ role def-role) 0)
                  (= ([] broken base) 1)
                )
              )
              (let offset (call vreg-of (. row offset)))
              (if (!= offset no-id)
                (call note-width widths broken (call view-of (. row offset)))
                (if (and (== opcode .call) (== ([] called offset) 0))
                  (= ([] called offset) 1)
                )
              )
            )
          )
        )
      )
    )
    (for (in vreg (..< 0 vreg-count))
      (if (and (== ([] broken vreg) 0) (!= ([] called vreg) 2))
        (= ([] cheap vreg) (call recompute-kind vreg (!= ([] called vreg) 0)))
      )
    )
  )
  (fn-do _ note-width _
    (param widths (of CPointer Byte))
    (param broken (of CPointer Byte))
    (param view VRegId)
    (let vreg (call checked-id view))
    (let width (as (+ (as (. ([] (. function vregs) view) reg-class) U32) 1) Byte))
    (if (== ([] widths vreg) 0)
      (= ([] widths vreg) width)
      (else-if (!= ([] widths vreg) width)
        (= ([] broken vreg) 1)
      )
    )
  )
  (fn-do _ recompute-kind Byte
    (param vreg U32)
    (param is-called Bool)
    (let interval ([] (. liveness intervals) vreg))
    (let defs ([] recompute-defs vreg))
    (if (or (not (. interval exists)) (== (. interval view) no-id) (!= (. interval pinned) no-register) (== (. defs length) 0))
      (return 0)
    )
    (let first ([] defs 0))
    (let operands (. ([] (. function instructions) first) operands))
    (let view (call view-of ([] operands 0)))
    (if (or (== view no-id) (. ([] (. function vregs) view) gc-root) (. ([] (. function vregs) (. interval view)) gc-root))
      (return 0)
    )
    (let opcode (. ([] (. function instructions) first) opcode))
    (if (> (. defs length) 1)
      (return (if-expr (call is-constant-chain defs) 1 0))
    )
    (if (and moves-wide (== (. operands length) 3) (call is-int-operand ([] operands 1)) (call is-int-operand ([] operands 2)))
      (return 1)
    )
    (lazy moves-wide (or (== opcode .movz) (== opcode .movn)))
    (if (and (or (== opcode .adrp) (== opcode .adr)) (== (. operands length) 2) (call is-symbol-operand ([] operands 1)))
      (return 1)
    )
    (if (and (== opcode .addptr) (== (. operands length) 2))
      (match? ([] (. function operands) ([] operands 1))
        (case .frame-object-operand
          (return 1)
        )
      )
    )
    (if (or is-called (not (call is-cheap-opcode opcode (. operands length))))
      (return 0)
    )
    (let sources IdList)
    (for (in entry (..< 1 (. operands length)))
      (let source-view (call view-of ([] operands entry)))
      (if (!= source-view no-id)
        (let source (call checked-id source-view))
        (if (or (== source vreg) (not (call holds-same-value source vreg)))
          (return 0)
        )
        (= sources (call (. sources appended) arena source))
        (else-if (not (call is-int-operand ([] operands entry)))
          (return 0)
        )
      )
    )
    (if (and (== opcode .mov) (or (!= (. sources length) 1) class-differs))
      (return 0)
    )
    (lazy class-differs (!= (. ([] (. function vregs) (call view-of ([] operands 1))) reg-class) (. ([] (. function vregs) view) reg-class)))
    (= ([] recompute-sources vreg) sources)
    (return 2)
  )
  (fn-do _ is-constant-chain Bool
    (param defs IdList)
    (let first (. ([] (. function instructions) ([] defs 0)) opcode))
    (let operands (. ([] (. function instructions) ([] defs 0)) operands))
    (if (== first .adrp)
      (if (or (!= (. defs length) 2) (!= (. ([] (. function instructions) ([] defs 1)) opcode) .add))
        (return false)
      )
      (let added (. ([] (. function instructions) ([] defs 1)) operands))
      (return (and (== (. added length) 3) (== (call vreg-of ([] added 1)) (call vreg-of ([] operands 0))) (call is-symbol-operand ([] added 2))))
    )
    (if (and (!= first .movz) (!= first .movn))
      (return false)
    )
    (for (in index (..< 0 (. defs length)))
      (let part ([] (. function instructions) ([] defs index)))
      (if (and (!= index 0) (!= (. part opcode) .movk))
        (return false)
      )
      (if (or (!= (. part operands length) 3) (not (call is-int-operand ([] (. part operands) 1))) (not int-shift))
        (return false)
      )
      (lazy int-shift (call is-int-operand ([] (. part operands) 2)))
    )
    (return true)
  )
  (fn-do _ is-symbol-operand Bool
    (param operand OperandId)
    (match? ([] (. function operands) operand)
      (case .symbol-operand
        (return true)
      )
      (case .label-operand
        (return true)
      )
    )
    (return false)
  )
  (fn-do _ is-int-operand Bool
    (param operand OperandId)
    (match? ([] (. function operands) operand)
      (case .int-operand
        (return true)
      )
    )
    (return false)
  )
  (fn-do _ holds-same-value Bool
    (param source U32)
    (param vreg U32)
    ; Whether `source` is live wherever `vreg` is read and no write to it falls where `vreg` is live,
    ; so it holds at each read of `vreg` the value it had where `vreg` was defined.
    (if (not (. ([] (. liveness intervals) source) exists))
      (return false)
    )
    (let source-ranges (. ([] (. liveness intervals) source) ranges))
    (let ranges (. ([] (. liveness intervals) vreg) ranges))
    (let uses (. ([] (. liveness intervals) vreg) uses))
    (for (in index (..< 0 (. uses length)))
      (if (and (== (/and/ ([] uses index) 1) 0) (not (call holds-slot source-ranges ([] uses index))))
        (return false)
      )
    )
    (let writes (. ([] (. liveness intervals) source) uses))
    (for (in index (..< 0 (. writes length)))
      (if (and (!= (/and/ ([] writes index) 1) 0) (call holds-slot ranges ([] writes index)))
        (return false)
      )
    )
    (return true)
  )
  (fn-do _ prefer-call-registers _
    (= vreg-count (. liveness vreg-count))
    (let calls (. liveness call-instructions))
    (for (in index (..< 0 (. calls length)))
      (let call ([] calls index))
      (let operands (. ([] (. function instructions) call) operands))
      (let return-type (call call-return-type call))
      (let first U32 1)
      (if (not (call is-void return-type))
        (= first 2)
        (let view (call view-of ([] operands 1)))
        (if (and (!= view no-id) (== (call struct-format return-type) no-id))
          (call prefer-register view (call register-of (. ([] (. function vregs) view) reg-class) 0))
        )
        (match? ([] (. function operands) ([] operands 1))
          (case (call .vreg-group-operand row)
            (for (in member (..< (. row vregs start) (. row vregs end)))
              (let part ([] (. function group-vregs) member))
              (call prefer-register
                (block
                  (arg part)
                  (arg (call register-of (. ([] (. function vregs) part) reg-class) (- member (. row vregs start))))
                )
              )
            )
          )
        )
      )
      (let last (. operands length))
      (if (call is-direct-return call)
        (-= last 1)
      )
      (= next-general-argument 0)
