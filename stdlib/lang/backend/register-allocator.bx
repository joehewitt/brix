  (fn-do _ add-root-for-view _
    (param view VRegId)
    (if (or (== view no-id) (not (. ([] (. function vregs) view) gc-root)))
      (return)
    )
    (let id (call checked-id view))
    (let descriptor (. ([] (. function vregs) view) gc-descriptor))
    (let mode (. ([] (. function vregs) view) gc-root-mode))
    (if (== (. ([] (. scan allocations) id) kind) .in-register)
      (if (== ([] seen-vregs id) seen-stamp)
        (return)
      )
      (let register (call register-parent (. ([] (. scan allocations) id) register)))
      (if (!= (call register-class register) .gpr64)
        (return)
      )
      (= ([] seen-vregs id) seen-stamp)
      (let object (call root-home-for id))
      (if (!= ([] live-homes id) home-stamp)
        (= materializations (call (. materializations appended) arena register))
        (= materializations (call (. materializations appended) arena object))
        (= ([] live-homes id) home-stamp)
      )
      (call mark-object-seen object)
      (call (. function roots append) (call StackRoot object descriptor mode))
      (else-if (== (. ([] (. scan allocations) id) kind) .in-spill)
        (let slot (. ([] (. scan allocations) id) spill-slot))
        (= (. ([] (. function frame-objects) slot) gc-root) true)
        (if (call mark-object-seen slot)
          (call (. function roots append) (call StackRoot slot descriptor mode))
        )
      )
    )
  )
  (fn-do _ mark-object-seen Bool
    (param object FrameObjectId)
    (throw (call Panic (str "Frame object " object " is outside the " seen-capacity " objects the allocator tracks")) (if (>= object seen-capacity)))
    (blank)
    (if (== ([] seen-objects object) seen-stamp)
      (return false)
    )
    (= ([] seen-objects object) seen-stamp)
    (return true)
