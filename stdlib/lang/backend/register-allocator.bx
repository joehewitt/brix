      (= ([] (. pairs data) (* target 2)) register)
      (= ([] (. pairs data) (+ (* target 2) 1)) object)
    )
    (let index U32)
    (while (< index count)
      (let register ([] pairs (* index 2)))
      (let object ([] pairs (+ (* index 2) 1)))
      (if (< (+ index 1) count)
        (let next ([] pairs (+ (* index 2) 3)))
        (let is-adjacent (== (. ([] (. function frame-objects) object) slot) (. ([] (. function frame-objects) next) slot)))
        (if (and is-adjacent (== (+ (. ([] (. function frame-objects) object) index) 1) next-index))
          (call (. builder stp)
            (block
              (arg (call (. builder preg) ([] pairs (+ (* index 2) 2))))
              (arg (call (. builder preg) register))
              (arg (call (. builder frame-object-operand) next))
            )
          )
          (+= index 2)
          (continue)
        )
        (lazy next-index (. ([] (. function frame-objects) next) index))
      )
      (call (. builder store)
        (block
          (arg (call (. builder frame-object-operand) object))
          (arg (call (. builder preg) register))
          (arg (. ([] (. function frame-objects) object) type))
        )
      )
      (+= index 1)
    )
  )
  (fn-do _ rewrite-normal _
    (param id InstructionId)
    (let roles (call (. function operand-roles) id))
    (let operands (. ([] (. function instructions) id) operands))
    (if (and (!= (. operands length) 0) (!= (/and/ (call role-at roles 0) def-role) 0) defines-recomputed)
      (return)
    )
    (lazy defines-recomputed (call is-recomputed (call view-of ([] operands 0))))
    (if (and (== (. ([] (. function instructions) id) opcode) .mov) (== (. operands length) 2) copies-recomputed)
      (let destination (call view-of ([] operands 0)))
