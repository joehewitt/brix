      (let id ([] pairs cursor))
      (let register (call register-view ([] pairs (+ cursor 1)) (. ([] (. liveness intervals) id) reg-class)))
      (call (. builder ldr)
        (block
          (arg (call (. builder preg) register))
          (arg (call (. builder frame-object-operand) (. ([] (. scan allocations) id) spill-slot)))
        )
      )
      (+= cursor 2)
    )
  )
  (fn-do _ find-wide _
    (param order IdList)
