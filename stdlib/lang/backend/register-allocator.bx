  (fn-do _ add-root-for-operand _
    (param operand OperandId)
    (let view no-id)
    (let base no-operand)
    (let members Span)
    (match? ([] (. function operands) operand)
      (case (call .vreg-operand row)
        (= view (. row vreg))
      )
      (case (call .vreg-group-operand row)
        (= members (. row vregs))
      )
      (case (call .load-address-operand row)
        (= base (. row base))
      )
    )
    (if (!= view no-id)
      (call add-root-for-view view)
    )
    (for (in index (..< (. members start) (. members end)))
      (call add-root-for-view ([] (. function group-vregs) index))
