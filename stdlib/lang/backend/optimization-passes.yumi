./aarch64-encoder
./builder
./mir
./variables-to-registers
/core/arena
/core/table

_ no-condition U32 = U32.max

_ unknown-width U32 = 64

_ all-bits U64 = 0xffffffffffffffff
_ low-word U64 = 0xffffffff
_ halfword-bits U64 = 0xffff
_ forwarded-object-bytes U32 = 64

━━━━━━━━━━━━━━━━━━━━
_ Rewrite is U32

| unchanged
| rewritten
| dropped

━━━━━━━━━━━━━━━━━━━━
_ Condition is U32

| equal
| unequal
| negative = 4
| positive = 5
| greater-equal = 10
| less = 11
| always = 14

━━━━━━━━━━━━━━━━━━━━
_ Definer is U32

| none
| several
| first

━━━━━━━━━━━━━━━━━━━━
_ LatticeState is Byte

| top
| constant
| varying

━━━━━━━━━━━━━━━━━━━━
_ BranchState is U32

| open
| taken
| skipped

━━━━━━━━━━━━━━━━━━━━
_ BoxUse is U32

| unused
| loaded
| stored
| escaped
| barrier

━━━━━━━━━━━━━━━━━━━━
+ MIRLocalCleanupPass

_ builder MIRBuilder
_ function MIRFunction
_ knows-bits Bool
_ tracked CPointer'U32
_ widths CPointer'Byte
_ definers CPointer'U32
_ copies IdList
_ firsts CPointer'U32
_ lasts CPointer'U32
_ sites IdList

────────────────────
+ This
    - builder MIRBuilder
    - knows-bits Bool = false

.. function = builder.function

────────────────────
+ do run Bool

. simplified = simplify-local-instructions()
function.count-uses()
. extensions = simplify-extension-pairs()
. extended = remove-redundant-extensions()
. forwarded = forward-single-use-moves()
. removed = remove-dead-definitions(function, true)
. flags-removed = remove-dead-comparisons(function)
if flags-removed
    remove-dead-definitions(function, true)
= simplified || extensions || extended || forwarded || removed || flags-removed

────────────────────
_ do simplify-local-instructions Bool

. changed = false
. order = function.block-order
for position in 0 .. < order.length
    . block = order[position]
    . instructions = function.blocks[block].instructions
    . kept U32
    for index in 0 .. < instructions.length
        . id = instructions[index]
        . outcome = simplify-instruction(id)
        if outcome != Rewrite.unchanged
            changed = true
        if outcome == Rewrite.dropped
            function.drop-uses(id)
            continue
        instructions.data[kept] = id
        kept += 1
    function.blocks[block].instructions = IdList(instructions.data, kept, instructions.capacity)
= changed

────────────────────
_ do simplify-instruction U32
    - id InstructionId

. arena = function.arena
. opcode = function.instructions[id].opcode
. operands = function.instructions[id].operands
if opcode == .mov && same-operand(function, operands[0], operands[1])
    = Rewrite.dropped
if operands.length < 3
    = Rewrite.unchanged
. dest = operands[0]
. lhs = operands[1]
. is-int = false
. value MIRInt
do match? function.operands[operands[2]]
    | .int-operand(operand)
        is-int = true
        value = operand.value
if !is-int
    = Rewrite.unchanged

. is-zero = value.bits == 0
. is-one = value.bits == 1 && !value.is-negative
. is-power = !value.is-negative && value.bits > 1 && (value.bits /and/ (value.bits - 1)) == 0
if opcode == .add || opcode == .sub || opcode == .orr || opcode == .eor || is-shift
    if is-zero
        = as-move(id, dest, lhs)
else if opcode == .mul
    if is-zero
        = as-move(id, dest, builder.small-int(0))
    if is-one
        = as-move(id, dest, lhs)
    if is-power
        rewrite-assembly
            - function
            - id
            - .lsl
            - triple(arena, dest, lhs, builder.small-int(log2(value.bits)))
        = Rewrite.rewritten
else if opcode == .udiv
    if is-one
        = as-move(id, dest, lhs)
    if is-power
        rewrite-assembly
            - function
            - id
            - .lsr
            - triple(arena, dest, lhs, builder.small-int(log2(value.bits)))
        = Rewrite.rewritten
else if opcode == .and
    if is-zero
        = as-move(id, dest, builder.small-int(0))
.. is-shift = opcode == .lsl || opcode == .lsr || opcode == .asr
= Rewrite.unchanged

────────────────────
_ do as-move U32
    - id InstructionId
    - dest OperandId
    - src OperandId

if same-operand(function, dest, src)
    = Rewrite.dropped
rewrite-assembly(function, id, .mov, pair(function.arena, dest, src))
= Rewrite.rewritten

────────────────────
_ do simplify-extension-pairs Bool

. changed = false
. order = function.block-order
for position in 0 .. < order.length
    . block = order[position]
    . instructions = function.blocks[block].instructions
    . kept U32
    for index in 0 .. < instructions.length
        . id = instructions[index]
        . opcode = function.instructions[id].opcode
        . bits = extension-bits(opcode)
        if bits != 0 && fold-extension(id, opcode, bits, instructions, kept)
            kept -= 1
            changed = true
        instructions.data[kept] = id
        kept += 1
    function.blocks[block].instructions = IdList(instructions.data, kept, instructions.capacity)
= changed

────────────────────
_ do fold-extension Bool
    - id InstructionId
    - opcode Opcode
    - bits U32
    - instructions IdList
    - kept U32

. operands = function.instructions[id].operands
if operands.length < 2
    = false
. source = vreg-id(function, operands[1])
if source == no-id
    = false
. previous-index = previous-real(function, instructions, kept)
if previous-index == no-id
    = false
. previous = instructions[previous-index]
. previous-def = function.instruction-def(previous)
if previous-def == no-id || defines-other || function.vregs[previous-def].gc-root
    = false
.. defines-other = function.vregs[previous-def].id != source
if function.use-count(source) != 1 || bits > extension-bits(function.instructions[previous].opcode)
    = false

function.drop-uses(previous)
. following = previous-index + 1
for index in following .. < kept
    instructions.data[index - 1] = instructions[index]
rewrite-assembly
    - function
    - id
    - opcode
    - pair(function.arena, operands[0], function.instructions[previous].operands[1])
= true

────────────────────
_ do remove-redundant-extensions Bool

. arena = function.arena
. order = function.block-order
. count = function.vreg-count
. candidates = IdList()
for position in 0 .. < order.length
    . block = order[position]
    . instructions = function.blocks[block].instructions
    for index in 0 .. < instructions.length
        . id = instructions[index]
        if narrow-extension-width(function.instructions[id].opcode) == 0
            continue
        . operands = function.instructions[id].operands
        . dest = vreg-id(function, operands[0])
        . source = vreg-id(function, operands[1])
        if dest == no-id || source == no-id || dest == source
            continue
        if candidates.length == 0
            tracked = arena.allocate'U32(count)
        tracked[dest] = 1
        tracked[source] = 1
        candidates = candidates.appended(arena, block)
        candidates = candidates.appended(arena, id)
if candidates.length == 0
    = false

widths = arena.allocate'Byte(count)
definers = arena.allocate'U32(count)
copies = IdList()
firsts = arena.allocate'U32(count)
lasts = arena.allocate'U32(count)
sites = IdList()
for position in 0 .. < order.length
    . instructions = function.blocks[order[position]].instructions
    for index in 0 .. < instructions.length
        . id = instructions[index]
        . roles = function.operand-roles(id)
        . operands = function.instructions[id].operands
        for entry in 0 .. < operands.length
            if (role-at(roles, entry) /and/ def-role) != 0
                note-sites(id, entry, operands[entry])
. pending = IdList()
for vreg in 0 .. < count
    if tracked[vreg] != 0
        pending = pending.appended(arena, vreg)
while pending.length != 0
    . vreg = pending[pending.length - 1]
    pending = IdList(pending.data, pending.length - 1, pending.capacity)
    . site = firsts[vreg]
    while site != 0
        pending = define-site(vreg, site - 1, pending)
        site = sites[(site - 1) * 4 + 3]
for vreg in 0 .. < count
    if tracked[vreg] != 0 && definers[vreg] == Definer.none
        widths[vreg] = unknown-width as Byte
. settled = false
while !settled
    settled = true
    . index U32
    while index < copies.length
        . width = widths[copies[index + 1]]
        if width > widths[copies[index]]
            widths[copies[index]] = width
            settled = false
        index += 2

. changed = false
. removed = IdList()
. candidate U32
while candidate < candidates.length
    . outcome = remove-extension(candidates[candidate + 1])
    if outcome != Rewrite.unchanged
        changed = true
    if outcome == Rewrite.dropped
        removed = removed.appended(arena, candidates[candidate])
        removed = removed.appended(arena, candidates[candidate + 1])
    candidate += 2
. next U32
while next < removed.length
    . block = removed[next]
    . instructions = function.blocks[block].instructions
    . kept U32
    for index in 0 .. < instructions.length
        . id = instructions[index]
        if next < removed.length && removed[next] == block && removed[next + 1] == id
            next += 2
            continue
        instructions.data[kept] = id
        kept += 1
    function.blocks[block].instructions = IdList(instructions.data, kept, instructions.capacity)
= changed

────────────────────
_ do note-sites
    - id InstructionId
    - entry U32
    - operand OperandId

` Lists where an instruction defines each vreg an operand it writes names, in the order the
` blocks hold them, so that each vreg a copy reaches has its definitions settled once.
do match? function.operands[operand]
    | .vreg-operand(register)
        note-site(function.vregs[register.vreg].id, id, entry, register.vreg)
    | .vreg-group-operand(group)
        for index in group.vregs.start .. < group.vregs.end
            note-site(function.vregs[function.group-vregs[index]].id, id, entry, no-id)
    | .load-address-operand(address)
        if address.base != no-operand
            . base = vreg-id(function, address.base)
            if base != no-id
                note-site(base, id, entry, no-id)
        if address.offset != no-operand
            . offset = vreg-id(function, address.offset)
            if offset != no-id
                note-site(offset, id, entry, no-id)

────────────────────
_ do note-site
    - vreg U32
    - id InstructionId
    - entry U32
    - row VRegId

. arena = function.arena
. site U32 = sites.length / 4
sites = sites.appended(arena, id)
sites = sites.appended(arena, entry)
sites = sites.appended(arena, row)
sites = sites.appended(arena, 0)
if lasts[vreg] == 0
    firsts[vreg] = site + 1
else
    sites.data[(lasts[vreg] - 1) * 4 + 3] = site + 1
lasts[vreg] = site + 1

────────────────────
_ do define-site IdList
    - vreg U32
    - site U32
    - pending IdList

. id = sites[site * 4]
. entry = sites[site * 4 + 1]
. row = sites[site * 4 + 2]
if row == no-id
    define(vreg, unknown-width, id)
    = pending
if entry == 0 && function.vregs[row].hint == no-register && knows-bits && is-bitwise-join(id)
    define(vreg, 0, id)
    . joined = join-source(vreg, function.instructions[id].operands[1], pending)
    = join-source(vreg, function.instructions[id].operands[2], joined)
if entry != 0 || function.vregs[row].hint != no-register || !is-register-copy(function, id)
    define(vreg, if entry == 0 then defined-width(id, row) else unknown-width, id)
    = pending
. source = vreg-id(function, function.instructions[id].operands[1])
copies = copies.appended(function.arena, vreg)
copies = copies.appended(function.arena, source)
define(vreg, 0, id)
= tracks(source, pending)

────────────────────
_ is-bitwise-join Bool
    - id InstructionId

|? (opcode != .orr && opcode != .eor) || operands.length != 3
    false
|? dest == no-id || left == no-id || right == no-id
    false
??
    function.vregs[left].reg-class == reg-class && function.vregs[right].reg-class == reg-class

.. opcode = function.instructions[id].opcode
.. operands = function.instructions[id].operands
.. dest = vreg-row(function, operands[0])
.. left = vreg-row(function, operands[1])
.. right = vreg-row(function, operands[2])
.. reg-class = function.vregs[dest].reg-class

────────────────────
_ do join-source IdList
    - vreg U32
    - operand OperandId
    - pending IdList

. source = vreg-id(function, operand)
copies = copies.appended(function.arena, vreg)
copies = copies.appended(function.arena, source)
= tracks(source, pending)

────────────────────
_ do tracks IdList
    - vreg U32
    - pending IdList

if tracked[vreg] != 0
    = pending
tracked[vreg] = 1
= pending.appended(function.arena, vreg)

────────────────────
_ do define
    - vreg U32
    - width U32
    - id InstructionId

if definers[vreg] == Definer.none
    definers[vreg] = id + Definer.first
    widths[vreg] = width as Byte
    =
definers[vreg] = Definer.several
if width > widths[vreg] as U32
    widths[vreg] = width as Byte

────────────────────
_ do defined-width U32
    - id InstructionId
    - defined VRegId

if function.vregs[defined].hint != no-register
    = unknown-width
. opcode = function.instructions[id].opcode
. operands = function.instructions[id].operands
if opcode == .cset
    = 1
if opcode == .ldrb || opcode == .uxtb
    = 8
if opcode == .ldrh || opcode == .uxth
    = 16
if opcode == .movz
    if operands.length > 2
        . shift = known-int(function, operands[2])
        if !shift.is-known || shift.bits != 0
            = unknown-width
    = value-width(known-int(function, operands[1]))
if opcode == .mov
    = value-width(known-int(function, operands[1]))
if !knows-bits
    = unknown-width
. bits = class-size(function.vregs[defined].reg-class) * 8
if opcode == .and && operands.length == 3
    . mask = known-int(function, operands[2])
    if mask.is-known && !mask.is-negative
        = bit-length(mask.bits)
if opcode == .lsr && operands.length == 3
    . amount = known-int(function, operands[2])
    if amount.is-known && !amount.is-negative && amount.bits < bits
        = (bits - amount.bits) as U32
if opcode == .ubfx && operands.length == 4
    . field = known-int(function, operands[3])
    if field.is-known && !field.is-negative && field.bits <= bits
        = field.bits as U32
= unknown-width

────────────────────
_ do remove-extension U32
    - id InstructionId

. limit = narrow-extension-width(function.instructions[id].opcode)
if limit == 0
    = Rewrite.unchanged
. operands = function.instructions[id].operands
. dest-row = vreg-row(function, operands[0])
. source-row = vreg-row(function, operands[1])
if dest-row == no-id || source-row == no-id
    = Rewrite.unchanged
. dest = function.vregs[dest-row].id
. source = function.vregs[source-row].id
if dest == source || widths[source] as U32 > limit
    = Rewrite.unchanged

. definer = definers[source]
if definer >= Definer.first && definers[dest] == id + Definer.first && used-once
    . definition = definer - Definer.first
    if unhinted && !function.vregs[dest-row].gc-root && !copies-register
        function.instructions[definition].operands.data[0] = operands[0]
        definers[dest] = definer
        function.drop-uses(id)
        = Rewrite.dropped
    .. unhinted = function.vregs[dest-row].hint == no-register
    .. copies-register = is-register-copy(function, definition)
.. used-once = function.use-count(source) == 1
if function.vregs[dest-row].reg-class == function.vregs[source-row].reg-class
    rewrite-assembly(function, id, .mov, operands)
    = Rewrite.rewritten
= Rewrite.unchanged

────────────────────
_ do forward-single-use-moves Bool

. changed = false
. order = function.block-order
for position in 0 .. < order.length
    . block = order[position]
    . instructions = function.blocks[block].instructions
    . kept U32
    for index in 0 .. < instructions.length
        . id = instructions[index]
        . opcode = function.instructions[id].opcode
        if (opcode == .mov || opcode == .addptr) && forward(id, opcode, instructions, index)
            changed = true
            continue
        instructions.data[kept] = id
        kept += 1
    function.blocks[block].instructions = IdList(instructions.data, kept, instructions.capacity)
= changed

────────────────────
_ do forward Bool
    - id InstructionId
    - opcode Opcode
    - instructions IdList
    - index U32

. dest = function.instruction-def(id)
if dest == no-id
    = false
. dest-id = function.vregs[dest].id
if function.use-count(dest-id) != 1
    = false
. next-index = next-real(function, instructions, index + 1)
if next-index == no-id
    = false
. next = instructions[next-index]
. source = function.instructions[id].operands[1]
if opcode == .addptr
    if !is-load-address(function, source)
        = false
    = forward-into(id, next, dest-id, source, true)
if function.vregs[dest].gc-root
    = false
. next-def = function.instruction-def(next)
if next-def != no-id && function.vregs[next-def].id == dest-id
    = false
if !is-forwardable-value-into(next, dest-id, source)
    = false
= forward-into(id, next, dest-id, source, false)

────────────────────
_ do forward-into Bool
    - id InstructionId
    - next InstructionId
    - vreg U32
    - source OperandId
    - is-address Bool

function.drop-uses(next)
. replaced = if is-address then replace-address-base(next, vreg, source) else replace-vreg-uses(next, vreg, source)
function.add-uses(next)
if replaced
    function.drop-uses(id)
= replaced

────────────────────
_ do is-forwardable-value-into Bool
    - id InstructionId
    - vreg U32
    - operand OperandId

. is-int = false
. value MIRInt
do match? function.operands[operand]
    | .vreg-operand
        = true
    | .preg-operand
        = true
    | .int-operand(row)
        is-int = true
        value = row.value
if !is-int
    = false
. opcode = function.instructions[id].opcode
. operands = function.instructions[id].operands
for position in 0 .. < operands.length
    if address-uses-vreg(operands[position], vreg)
        = false
    if uses-vreg && !can-use-immediate(opcode, operands, position, value)
        = false
    .. uses-vreg = vreg-id(function, operands[position]) == vreg
= true

────────────────────
_ do address-uses-vreg Bool
    - operand OperandId
    - vreg U32

if operand == no-operand
    = false
do match? function.operands[operand]
    | .load-address-operand(address)
        if vreg-id(function, address.base) == vreg || vreg-id(function, address.offset) == vreg
            = true
        = address-uses-vreg(address.base, vreg) || address-uses-vreg(address.offset, vreg)
= false

────────────────────
_ can-use-immediate Bool
    - opcode Opcode
    - operands IdList
    - position U32
    - value MIRInt

|? opcode == .add || opcode == .sub
    position == 2 && is-add-sub-immediate(value)
|? opcode == .cmp
    position == 1 && is-add-sub-immediate(value)
|? opcode == .lsl || opcode == .lsr || opcode == .asr
    position == 2 && !value.is-negative && value.bits < shift-width(operands[0])
|? opcode == .and || opcode == .orr || opcode == .eor
    position == 2 && !value.is-negative && low-mask
??
    false

.. low-mask = value.bits == 0xff || value.bits == 0xffff || value.bits == 0xffffffff

────────────────────
_ do shift-width U64
    - dest OperandId

do match? function.operands[dest]
    | .vreg-operand(operand)
        = if function.vregs[operand.vreg].reg-class == .gpr64 then 64 else 32
    | .preg-operand(operand)
        = if register-class(operand.register) == .gpr64 then 64 else 32
= 64

────────────────────
_ do replace-vreg-uses Bool
    - id InstructionId
    - vreg U32
    - replacement OperandId

. changed = false
. roles = function.operand-roles(id)
. operands = function.instructions[id].operands
for position in 0 .. < operands.length
    if (role-at(roles, position) /and/ def-role) != 0
        continue
    . replaced = replace-vreg-in-operand(operands[position], vreg, replacement)
    if replaced != no-operand
        operands.data[position] = replaced
        changed = true
= changed

────────────────────
_ do replace-vreg-in-operand OperandId
    - operand OperandId
    - vreg U32
    - replacement OperandId

if vreg-id(function, operand) == vreg
    = as-wide-as(replacement, operand)
. is-address = false
. base = no-operand
. offset = no-operand
. is-pre-index = false
do match? function.operands[operand]
    | .load-address-operand(address)
        is-address = true
        base = address.base
        offset = address.offset
        is-pre-index = address.is-pre-index
if !is-address
    = no-operand
. new-base = replace-vreg-in-operand(base, vreg, replacement)
. new-offset = no-operand
if offset != no-operand
    new-offset = replace-vreg-in-operand(offset, vreg, replacement)
if new-base == no-operand && new-offset == no-operand
    = no-operand
if new-base == no-operand
    new-base = base
if new-offset == no-operand
    new-offset = offset
= builder.add-operand(LoadAddressOperand(new-base, new-offset, is-pre-index))

────────────────────
_ do as-wide-as OperandId
    - replacement OperandId
    - use OperandId

` A replacement for a use of a register, read at the use's width: a use of the low 32 bits of a
` register reads the low 32 bits of a 64-bit replacement.
. use-row = vreg-row(function, use)
=? replacement if use-row == no-id || function.vregs[use-row].reg-class != .gpr32
do match? function.operands[replacement]
    | .vreg-operand
        = builder.narrow-view(replacement)
    | .preg-operand(operand)
        if register-class(operand.register) == .gpr64
            = builder.preg(register-view(operand.register, .gpr32))
= replacement

────────────────────
_ do replace-address-base Bool
    - id InstructionId
    - vreg U32
    - replacement OperandId

. changed = false
. roles = function.operand-roles(id)
. operands = function.instructions[id].operands
for position in 0 .. < operands.length
    if (role-at(roles, position) /and/ def-role) != 0
        continue
    . operand = operands[position]
    . base = no-operand
    do match? function.operands[operand]
        | .load-address-operand(address)
            base = address.base
    if base == no-operand || vreg-id(function, base) != vreg
        continue
    . merged = merge-addresses(replacement, operand)
    if merged != no-operand && is-encodable-address(id, merged)
        operands.data[position] = merged
        changed = true
= changed

────────────────────
_ do merge-addresses OperandId
    - base OperandId
    - address OperandId

. base-register = no-operand
. base-offset = no-operand
do match? function.operands[base]
    | .load-address-operand(row)
        base-register = row.base
        base-offset = row.offset
. use-offset = no-operand
. is-pre-index = false
do match? function.operands[address]
    | .load-address-operand(row)
        use-offset = row.offset
        is-pre-index = row.is-pre-index

if base-offset == no-operand
    = builder.add-operand(LoadAddressOperand(base-register, use-offset, is-pre-index))
if use-offset == no-operand
    = base
. used = known-int(function, use-offset)
if used.is-known && used.bits == 0
    = base
. based = known-int(function, base-offset)
if !based.is-known || !used.is-known
    = no-operand
. sum = signed-value(based) + signed-value(used)
= builder.add-operand(LoadAddressOperand(base-register, builder.small-int(sum), is-pre-index))

────────────────────
_ do is-encodable-address Bool
    - id InstructionId
    - address OperandId

. opcode = function.instructions[id].opcode
. offset-operand = no-operand
. is-pre-index = false
do match? function.operands[address]
    | .load-address-operand(row)
        offset-operand = row.offset
        is-pre-index = row.is-pre-index
. offset = Known(true, 0, false)
. is-label = false
. is-page-offset = false
if offset-operand != no-operand
    offset = known-int(function, offset-operand)
    do match? function.operands[offset-operand]
        | .label-operand(label)
            is-label = true
            is-page-offset = label.reloc == .pageoff-reloc

if opcode == .ldar || opcode == .ldarb || opcode == .stlrb
    = !is-pre-index && offset.is-known && offset.bits == 0
if !is-load-store(opcode)
    = true
. operands = function.instructions[id].operands
if is-label
    = is-page-offset && !is-pre-index && pair-scale(opcode, operands) == 0 && byte-access
        .. byte-access = access-size(opcode, operands) == 1
if !offset.is-known
    = false
if !offset.is-negative && offset.bits > 0x7fffffffffffffff
    = false
. value = offset.bits as I64
if is-pre-index
    = fits-signed-bits(value, 9)
. scale = pair-scale(opcode, operands)
if scale != 0
    = value % scale == 0 && fits-signed-bits(value / scale, 7)
. size = access-size(opcode, operands)
if value >= 0 && value % size == 0 && value / size <= 4095
    = true
= fits-signed-bits(value, 9)

────────────────────
_ access-size I64
    - opcode Opcode
    - operands IdList

|? opcode == .ldrb || opcode == .strb || opcode == .ldrsb
    1
|? opcode == .ldrh || opcode == .strh || opcode == .ldrsh
    2
|? opcode == .ldrsw
    4
??
    operand-access-size(operands[0])

────────────────────
_ pair-scale I64
    - opcode Opcode
    - operands IdList

if opcode != .ldp && opcode != .stp then 0 else operand-access-size(operands[0])

────────────────────
_ do operand-access-size I64
    - operand OperandId

. reg-class RegClass = .gpr64
do match? function.operands[operand]
    | .vreg-operand(row)
        reg-class = function.vregs[row.vreg].reg-class
    | .preg-operand(row)
        reg-class = register-class(row.register)
if reg-class == .gpr32 || reg-class == .fpr32
    = 4
= 8

━━━━━━━━━━━━━━━━━━━━
+ MIRConstantFoldingPass

_ builder MIRBuilder
_ function MIRFunction
_ definitions CPointer'U32
_ chained CPointer'Byte
_ chain-values CPointer'U64
_ states CPointer'Byte
_ values CPointer'U64
_ live CPointer'Byte
_ edges CPointer'IdList
_ flags-state Byte = 2
_ flags-left U64
_ flags-right U64
_ flags-width U64 = 64
_ changed Bool
_ owners CPointer'U32
_ owner-blocks CPointer'U32
_ seen CPointer'U32
_ table-flags CPointer'U32
_ generation U32
_ known-flag OperandId = no-operand
_ unknown-flag OperandId = no-operand
_ derived-vregs IdList
_ derived-offsets IdList
_ derived-rows IdList
_ derived-blocks IdList
_ promoted-objects IdList

────────────────────
+ This
    - builder MIRBuilder

.. function = builder.function

────────────────────
+ do run Bool

if function.block-order.length == 0
    = false
count-definitions()
if settle-inlined-names()
    count-definitions()
. forwarded = rewrite-allocations(false)
if rewrite-allocations(true)
    forwarded = true
if promote-allocations()
    forwarded = true
    count-definitions()
. arena = function.arena
. block-count = function.blocks.length
states = arena.allocate'Byte(function.vreg-count)
values = arena.allocate'U64(function.vreg-count)
live = arena.allocate'Byte(block-count)
edges = arena.allocate'IdList(block-count)
for vreg in 0 .. < function.vreg-count
    states[vreg] = if starts-top then LatticeState.top else LatticeState.varying
    .. starts-top = definitions[vreg] == 1 || chained[vreg] != 0
. post = function.post-order()
if post.length == 0
    = forwarded
live[post[post.length - 1]] = 1
changed = true
while changed
    changed = false
    for back in 0 .. < post.length
        . block = post[post.length - 1 - back]
        if live[block] != 0
            visit(block)
. folded = false
. order = function.block-order
for position in 0 .. < order.length
    . block = order[position]
    if live[block] != 0 && fold-block(block)
        folded = true
. dropped = drop-dead-edges()
if dropped || folded
    repair-predecessors(function)
    builder.prune-unreachable-blocks()
    drop-unaddressed-tables()
. merged = remove-trivial-phis()
. removed = remove-dead-definitions(function)
. reallocated = false
if dropped || folded || merged
    count-definitions()
    reallocated = rewrite-allocations(false)
    if rewrite-allocations(true)
        reallocated = true
    if promote-allocations()
        reallocated = true
= forwarded || dropped || folded || merged || removed || reallocated

────────────────────
_ do drop-unaddressed-tables

` Drops each jump table no instruction addresses any more, where a folded branch now goes
` around the dispatch that read it: the blocks it names may since merge or go.
. kept Size = 0
for index in 0 .. < function.jump-tables.length
    if addressed(function.jump-tables[index].name)
        if kept != index
            function.jump-tables[kept].name = function.jump-tables[index].name
            function.jump-tables[kept].labels = function.jump-tables[index].labels
        kept += 1
function.jump-tables.truncate(kept)

────────────────────
_ do addressed Bool
    - name StringId

. order = function.block-order
for position in 0 .. < order.length
    . instructions = function.blocks[order[position]].instructions
    for index in 0 .. < instructions.length
        . operands = function.instructions[instructions[index]].operands
        for operand in 0 .. < operands.length
            if label-name(function, operands[operand]) == name
                = true
= false

────────────────────
_ do settle-inlined-names Bool

. arena = function.arena
. sites = IdList()
. homes = IdList()
. order = function.block-order
for position in 0 .. < order.length
    . instructions = function.blocks[order[position]].instructions
    for index in 0 .. < instructions.length
        if function.instructions[instructions[index]].opcode == .inlined-name
            sites = sites.appended(arena, instructions[index])
            homes = homes.appended(arena, order[position])
if sites.length == 0
    = false
. count = function.vreg-count
owners = arena.allocate'U32(count)
owner-blocks = arena.allocate'U32(count)
seen = arena.allocate'U32(count)
table-flags = arena.allocate'U32(count)
for vreg in 0 .. < count
    owners[vreg] = no-id
    seen[vreg] = 0
    table-flags[vreg] = no-operand
known-flag = no-operand
unknown-flag = no-operand
for position in 0 .. < order.length
    . block = order[position]
    . instructions = function.blocks[block].instructions
    for index in 0 .. < instructions.length
        . id = instructions[index]
        do match? function.instructions[id]
            | .phi-instruction(phi)
                own(phi.reg, id, block)
                continue
        . roles = function.operand-roles(id)
        . operands = function.instructions[id].operands
        for entry in 0 .. < operands.length
            if (role-at(roles, entry) /and/ def-role) != 0
                own(operands[entry], id, block)
for index in 0 .. < sites.length
    settle-inlined-name(homes[index], sites[index])
= true

────────────────────
_ do own
    - operand OperandId
    - id InstructionId
    - block BlockId

. vreg = vreg-id(function, operand)
if vreg != no-id
    owners[vreg] = id
    owner-blocks[vreg] = block

────────────────────
_ do settle-inlined-name
    - block BlockId
    - id InstructionId

. arena = function.arena
. operands = function.instructions[id].operands
. dest = operands[0]
. descriptor = operands[1]
. fallback = operands[2]
. table = described-table(descriptor)
generation += 1
. kind = if table == no-operand then 2u32 else table-kind(table)
if kind == 1
    rewrite-assembly
        - function
        - id
        - .ldr
        - pair(arena, dest, builder.load-address-offset(descriptor, 0))
    =
if kind != 3
    rewrite-assembly(function, id, .mov, pair(arena, dest, fallback))
    =
. flag = table-flag(table)
. name = builder.vreg(.gpr64)
rewrite-assembly(function, id, .ldr, pair(arena, name, builder.load-address-offset(descriptor, 0)))
. compare = builder.new-assembly(.cmp, flag, builder.small-int(0))
. select = builder.new-assembly
    - .csel
    - dest
    - name
    - fallback
    - builder.add-operand(CondOperand(Condition.unequal))
. instructions = function.blocks[block].instructions
for index in 0 .. < instructions.length
    if instructions[index] == id
        function.blocks[block].instructions = instructions.inserted(arena, index + 1, compare).inserted(arena, index + 2, select)
        =

────────────────────
_ do described-table OperandId
    - descriptor OperandId

. vreg = vreg-id(function, descriptor)
if vreg == no-id || definitions[vreg] != 1 || owners[vreg] == no-id
    = no-operand
. row = function.instructions[owners[vreg]]
if row.opcode != .ldr || row.operands.length != 2
    = no-operand
do match? function.operands[row.operands[1]]
    | .load-address-operand(address)
        if address.is-pre-index
            = no-operand
        if address.offset != no-operand
            . offset = known-int(function, address.offset)
            if !offset.is-known || offset.bits != 0
                = no-operand
        = address.base
= no-operand

────────────────────
_ do table-kind U32
    - operand OperandId

. vreg = vreg-id(function, operand)
if vreg == no-id || owners[vreg] == no-id
    = 2
if seen[vreg] == generation
    = 0
seen[vreg] = generation
do match? function.instructions[owners[vreg]]
    | .phi-instruction(phi)
        . kind U32
        for entry in 0 .. < phi.exprs.length
            kind = kind /or/ table-kind(phi.exprs[entry])
        = kind
    | .assembly-instruction(row)
        if is-table-address(vreg, row.opcode, row.operands)
            = 1
        if row.opcode == .mov && row.operands.length == 2 && definitions[vreg] == 1
            = table-kind(row.operands[1])
= 2

────────────────────
_ do table-flag OperandId
    - operand OperandId

. vreg = vreg-id(function, operand)
if vreg == no-id || owners[vreg] == no-id
    = constant-flag(false)
if table-flags[vreg] != no-operand
    = table-flags[vreg]
do match? function.instructions[owners[vreg]]
    | .phi-instruction(phi)
        . flag = builder.vreg(.gpr64)
        table-flags[vreg] = flag
        . exprs = IdList()
        for entry in 0 .. < phi.exprs.length
            exprs = exprs.appended(function.arena, table-flag(phi.exprs[entry]))
        . saved = builder.insertion-block
        builder.insertion-block = owner-blocks[vreg]
        builder.phi-of(flag, exprs, phi.blocks)
        builder.insertion-block = saved
        = flag
    | .assembly-instruction(row)
        if is-table-address(vreg, row.opcode, row.operands)
            = constant-flag(true)
        if row.opcode == .mov && row.operands.length == 2 && definitions[vreg] == 1
            . flag = table-flag(row.operands[1])
            table-flags[vreg] = flag
            = flag
= constant-flag(false)

────────────────────
_ do constant-flag OperandId
    - known Bool

. existing = if known then known-flag else unknown-flag
if existing != no-operand
    = existing
. flag = builder.vreg(.gpr64)
. made = builder.new-assembly
    - .movz
    - flag
    - builder.small-int(if known then 1 else 0)
    - builder.small-int(0)
. entry = function.block-order[0]
function.blocks[entry].instructions = function.blocks[entry].instructions.inserted
    - function.arena
    - 0
    - made
if known
    known-flag = flag
else
    unknown-flag = flag
= flag

────────────────────
_ is-table-address Bool
    - vreg U32
    - opcode Opcode
    - operands IdList

|? opcode == .adr && operands.length == 2 && definitions[vreg] == 1
    is-symbolic(operands[1])
|? opcode != .add || operands.length != 3 || !is-symbolic(operands[2])
    false
??
    definitions[vreg] == 1 || (definitions[vreg] == 2 && vreg-id(function, operands[1]) == vreg)

────────────────────
_ do is-symbolic Bool
    - operand OperandId

do match? function.operands[operand]
    | .symbol-operand
        = true
    | .label-operand
        = true
= false

────────────────────
_ do count-definitions

definitions = function.arena.allocate'U32(function.vreg-count)
. order = function.block-order
for position in 0 .. < order.length
    . instructions = function.blocks[order[position]].instructions
    for index in 0 .. < instructions.length
        . id = instructions[index]
        do match? function.instructions[id]
            | .phi-instruction(phi)
                define(phi.reg, 1)
                continue
        . roles = function.operand-roles(id)
        . operands = function.instructions[id].operands
        for entry in 0 .. < operands.length
            if (role-at(roles, entry) /and/ def-role) != 0
                define(operands[entry], 1)
find-constant-chains()

────────────────────
_ do find-constant-chains

` Marks each vreg that only a MOVZ or MOVN and the MOVKs right after it define, with the constant
` they build together.
. arena = function.arena
chained = arena.allocate'Byte(function.vreg-count)
chain-values = arena.allocate'U64(function.vreg-count)
. order = function.block-order
for position in 0 .. < order.length
    . instructions = function.blocks[order[position]].instructions
    . index U32
    while index < instructions.length
        . id = instructions[index]
        index += 1
        . opcode = function.instructions[id].opcode
        if opcode != .movz && opcode != .movn
            continue
        . row = function.instruction-def(id)
        . part = wide-part(id)
        if row == no-id || part.shift >= 64
            continue
        . vreg = function.vregs[row].id
        . bits = if opcode == .movz then part.bits else part.bits /xor/ all-bits
        . count U32 = 1
        while index < instructions.length
            . next = instructions[index]
            . next-row = function.instruction-def(next)
            if not-movk || next-row == no-id || function.vregs[next-row].id != vreg
                break
            .. not-movk = function.instructions[next].opcode != .movk
            . inserted = wide-part(next)
            if inserted.shift >= 64
                break
            . field U64 = 0xffff
            bits = (bits /and/ ((field /lshift/ inserted.shift) /xor/ all-bits)) /or/ inserted.bits
            count += 1
            index += 1
        if count > 1 && definitions[vreg] == count
            chained[vreg] = 1
            chain-values[vreg] = bits

────────────────────
_ wide-part WidePart
    - id InstructionId

|? operands.length != 3
    WidePart(0, 64)
|? !immediate.is-known || !shift.is-known || immediate.bits > 0xffff || shift.bits >= 64
    WidePart(0, 64)
??
    WidePart(immediate.bits /lshift/ shift.bits, shift.bits)

.. operands = function.instructions[id].operands
.. immediate = known-int(function, operands[1])
.. shift = known-int(function, operands[2])

────────────────────
_ do define
    - operand OperandId
    - weight U32

do match? function.operands[operand]
    | .vreg-operand(row)
        . vreg = function.vregs[row.vreg].id
        definitions[vreg] = definitions[vreg] + weight
    | .vreg-group-operand(group)
        for index in group.vregs.start .. < group.vregs.end
            . vreg = function.vregs[function.group-vregs[index]].id
            definitions[vreg] = definitions[vreg] + 2
    | .load-address-operand(address)
        define(address.base, 2)

────────────────────
_ do visit
    - block BlockId

flags-state = LatticeState.varying
. instructions = function.blocks[block].instructions
for index in 0 .. < instructions.length
    . id = instructions[index]
    . opcode = function.instructions[id].opcode
    if opcode == .comment
        continue
    if opcode == .phi
        visit-phi(block, id)
        continue
    if opcode == .b
        follow(block, first-operand(function, id))
        =
    if opcode == .cbz || opcode == .cbnz || opcode == .b-cond
        . decision = decide(id)
        if decision != BranchState.skipped
            follow(block, conditional-branch-target(function, id))
        if decision == BranchState.taken
            =
        continue
    if opcode == .br || opcode == .ret
        follow-all(block)
        =
    evaluate(id)
    if has-panic-target(id)
        follow-all(block)
follow-all(block)

────────────────────
_ do visit-phi
    - block BlockId
    - id InstructionId

do match? function.instructions[id]
    | .phi-instruction(phi)
        . merged = Lattice(LatticeState.top, 0)
        for entry in 0 .. < phi.blocks.length
            . source = builder.get-block(phi.blocks[entry])
            if source == no-id || !includes(edges[source], block)
                continue
            merged = meet(merged, value-of(phi.exprs[entry]))
        settle(phi.reg, merged)

────────────────────
_ do has-panic-target Bool
    - id InstructionId

do match? function.instructions[id]
    | .call-instruction(call)
        = call.panic-target != no-operand
= false

────────────────────
_ do follow
    - block BlockId
    - target OperandId

. name = label-name(function, target)
. successor = if name == no-string then no-id else builder.get-block(name)
if successor == no-id
    follow-all(block)
    =
mark(block, successor)

────────────────────
_ do follow-all
    - block BlockId

. successors = function.blocks[block].successors
for index in 0 .. < successors.length
    mark(block, successors[index])

────────────────────
_ do mark
    - block BlockId
    - successor BlockId

if includes(edges[block], successor)
    =
edges[block] = edges[block].appended(function.arena, successor)
live[successor] = 1
changed = true

────────────────────
_ do evaluate
    - id InstructionId

. opcode = function.instructions[id].opcode
if opcode == .cmp
    compare(id)
    =
clobber(opcode)
. roles = function.operand-roles(id)
. operands = function.instructions[id].operands
. result = compute(id)
for position in 0 .. < operands.length
    if (role-at(roles, position) /and/ def-role) != 0
        settle
            - operands[position]
            - if position == 0 then result else Lattice(LatticeState.varying, 0)

────────────────────
_ do clobber
    - opcode Opcode

if is-flag-compare(opcode) || clobbers-flags(opcode) || opcode == .gc-alloc || opcode == .gc-barrier
    flags-state = LatticeState.varying

────────────────────
_ do compare
    - id InstructionId

. operands = function.instructions[id].operands
if operands.length != 2
    flags-state = LatticeState.varying
    =
. left = value-of(operands[0])
. right = value-of(operands[1])
flags-state = merged-state(left, right)
flags-left = left.bits
flags-right = right.bits
flags-width = if operand-mask(operands[0]) == low-word then 32 else 64

────────────────────
_ do settle
    - operand OperandId
    - value Lattice

. row = vreg-row(function, operand)
if row == no-id
    =
. vreg = function.vregs[row].id
. current = states[vreg]
if current == LatticeState.varying || value.state == LatticeState.top
    =
. mask = class-mask(function.vregs[row].reg-class)
if value.state == LatticeState.constant && mask != 0
    . bits = value.bits /and/ mask
    if current == LatticeState.constant && values[vreg] == bits
        =
    if current == LatticeState.top
        states[vreg] = LatticeState.constant
        values[vreg] = bits
        changed = true
        =
states[vreg] = LatticeState.varying
changed = true

────────────────────
_ do value-of Lattice
    - operand OperandId

if operand == no-operand
    = Lattice(LatticeState.varying, 0)
do match? function.operands[operand]
    | .int-operand(row)
        = Lattice(LatticeState.constant, row.value.bits)
    | .vreg-operand(row)
        . vreg = function.vregs[row.vreg].id
        . state = states[vreg]
        if state != LatticeState.constant
            = Lattice(state, 0)
        = Lattice(state, values[vreg] /and/ class-mask(function.vregs[row.vreg].reg-class))
    | .preg-operand(row)
        if row.register == zero-register || row.register == zero-register-32
            = Lattice(LatticeState.constant, 0)
= Lattice(LatticeState.varying, 0)

────────────────────
_ operand-mask U64
    - operand OperandId

if row == no-id then 0 else class-mask(function.vregs[row].reg-class)

.. row = vreg-row(function, operand)

────────────────────
_ do compute Lattice
    - id InstructionId

. varying = Lattice(LatticeState.varying, 0)
. opcode = function.instructions[id].opcode
. operands = function.instructions[id].operands
. count = operands.length
if count < 2 || operand-mask(operands[0]) == 0
    = varying
if opcode == .movz || opcode == .movn || opcode == .movk
    . row = vreg-row(function, operands[0])
    if row != no-id && chained[function.vregs[row].id] != 0
        = Lattice(LatticeState.constant, chain-values[function.vregs[row].id])
if opcode == .movz || opcode == .movn
    if count != 3
        = varying
    . immediate = value-of(operands[1])
    . shift = value-of(operands[2])
    . state = merged-state(immediate, shift)
    if state != LatticeState.constant || shift.bits >= 64
        = if state != LatticeState.constant then Lattice(state, 0) else varying
    . shifted = immediate.bits /lshift/ shift.bits
    = Lattice(state, if opcode == .movz then shifted else shifted /xor/ all-bits)
if opcode == .mov
    = if count == 2 then value-of(operands[1]) else varying
if opcode == .cset
    = if count == 2 then holds(operands[1]) else varying
if opcode == .csel
    if count != 4
        = varying
    . held = holds(operands[3])
    if held.state != LatticeState.constant
        = held
    = if held.bits != 0 then value-of(operands[1]) else value-of(operands[2])
if count == 2
    . input = value-of(operands[1])
    if input.state != LatticeState.constant
        = input
    = unary(opcode, input.bits)
if count != 3
    = varying
. left = value-of(operands[1])
. right = value-of(operands[2])
. state = merged-state(left, right)
if state != LatticeState.constant
    = Lattice(state, 0)
= binary(opcode, left.bits, right.bits, operand-mask(operands[0]))

────────────────────
_ unary Lattice
    - opcode Opcode
    - bits U64

match opcode
    |= .neg
        Lattice(LatticeState.constant, 0 - bits)
    |= .mvn
        Lattice(LatticeState.constant, bits /xor/ all-bits)
    |= .uxtb
        Lattice(LatticeState.constant, bits /and/ 0xff)
    |= .uxth
        Lattice(LatticeState.constant, bits /and/ 0xffff)
    |= .uxtw
        Lattice(LatticeState.constant, bits /and/ low-word)
    |= .sxtb
        Lattice(LatticeState.constant, sign-extended(bits, 8))
    |= .sxth
        Lattice(LatticeState.constant, sign-extended(bits, 16))
    |= .sxtw
        Lattice(LatticeState.constant, sign-extended(bits, 32))
    ??
        Lattice(LatticeState.varying, 0)

────────────────────
_ do binary Lattice
    - opcode Opcode
    - left U64
    - right U64
    - mask U64

. width U64 = if mask == low-word then 32 else 64
if opcode == .add
    = Lattice(LatticeState.constant, left + right)
if opcode == .sub
    = Lattice(LatticeState.constant, left - right)
if opcode == .mul
    = Lattice(LatticeState.constant, left * right)
if opcode == .and
    = Lattice(LatticeState.constant, left /and/ right)
if opcode == .orr
    = Lattice(LatticeState.constant, left /or/ right)
if opcode == .eor
    = Lattice(LatticeState.constant, left /xor/ right)
if right >= width
    = Lattice(LatticeState.varying, 0)
if opcode == .lsl
    = Lattice(LatticeState.constant, left /lshift/ right)
if opcode == .lsr
    = Lattice(LatticeState.constant, (left /and/ mask) /zrshift/ right)
if opcode == .asr
    . extended = sign-extended(left /and/ mask, width)
    . shifted = extended /zrshift/ right
    if right != 0 && (extended /and/ (1u64 /lshift/ 63)) != 0
        = Lattice(LatticeState.constant, shifted /or/ (all-bits /lshift/ (64 - right)))
    = Lattice(LatticeState.constant, shifted)
= Lattice(LatticeState.varying, 0)

────────────────────
_ holds Lattice
    - operand OperandId

|? flags-state != LatticeState.constant
    Lattice(flags-state, 0)
|? code > Condition.always
    Lattice(LatticeState.varying, 0)
??
    Lattice(LatticeState.constant, if condition-holds then 1u64 else 0u64)

.. code = condition-of(operand)
.. condition-holds = holds-for(code, compare-flags(flags-left, flags-right, flags-width))

────────────────────
_ do condition-of U32
    - operand OperandId

if operand == no-operand
    = no-condition
do match? function.operands[operand]
    | .cond-operand(row)
        = row.code
= no-condition

────────────────────
_ do decide U32
    - id InstructionId

. opcode = function.instructions[id].opcode
. operands = function.instructions[id].operands
. tested Lattice
if opcode == .b-cond
    if operands.length < 2
        = BranchState.open
    tested = holds(operands[1])
    if tested.state != LatticeState.constant
        = BranchState.open
    = if tested.bits != 0 then BranchState.taken else BranchState.skipped
if operands.length < 2
    = BranchState.open
tested = value-of(operands[0])
if tested.state != LatticeState.constant
    = BranchState.open
= if (tested.bits == 0) == (opcode == .cbz) then BranchState.taken else BranchState.skipped

────────────────────
_ do fold-block Bool
    - block BlockId

flags-state = LatticeState.varying
. arena = function.arena
. instructions = function.blocks[block].instructions
. rebuilt = new-id-list(arena, instructions.length + 1)
. settled = IdList()
. in-phis = true
. folded = false
for index in 0 .. < instructions.length
    . id = instructions[index]
    . opcode = function.instructions[id].opcode
    if opcode == .phi
        . made = constant-phi(id)
        if made == no-id
            rebuilt = rebuilt.appended(arena, id)
        else
            settled = settled.appended(arena, made)
            folded = true
        continue
    if in-phis && opcode != .comment
        in-phis = false
        for entry in 0 .. < settled.length
            rebuilt = rebuilt.appended(arena, settled[entry])
    if opcode == .cbz || opcode == .cbnz || opcode == .b-cond
        . decision = decide(id)
        . target = conditional-branch-target(function, id)
        if decision == BranchState.skipped && target != no-operand
            folded = true
            continue
        if decision == BranchState.taken && target != no-operand
            rewrite-assembly(function, id, .b, IdList().appended(arena, target))
            function.blocks[block].instructions = rebuilt.appended(arena, id)
            = true
    else if opcode == .cmp
        compare(id)
        use-immediates(id)
    else if opcode != .comment
        clobber(opcode)
        fold-definition(id)
        use-immediates(id)
    rebuilt = rebuilt.appended(arena, id)
if in-phis
    for entry in 0 .. < settled.length
        rebuilt = rebuilt.appended(arena, settled[entry])
function.blocks[block].instructions = rebuilt
= folded

────────────────────
_ do constant-phi InstructionId
    - id InstructionId

do match? function.instructions[id]
    | .phi-instruction(phi)
        . row = vreg-row(function, phi.reg)
        if row == no-id || function.vregs[row].hint != no-register
            = no-id
        . vreg = function.vregs[row].id
        . mask = class-mask(function.vregs[row].reg-class)
        if states[vreg] != LatticeState.constant || mask == 0
            = no-id
        = materialize(phi.reg, values[vreg] /and/ mask, mask, no-id)
= no-id

────────────────────
_ do materialize InstructionId
    - target OperandId
    - bits U64
    - mask U64
    - id InstructionId

. inverted = (bits /xor/ all-bits) /and/ mask
. opcode = if bits <= 0xffff then Opcode.movz else Opcode.movn
. immediate = if bits <= 0xffff then bits else inverted
if immediate > 0xffff
    = no-id
. operands = triple
    - function.arena
    - target
    - builder.small-int(immediate as I64)
    - builder.small-int(0)
if id == no-id
    = builder.new-assembly(opcode, operands[0], operands[1], operands[2])
rewrite-assembly(function, id, opcode, operands)
= id

────────────────────
_ do fold-definition
    - id InstructionId

. opcode = function.instructions[id].opcode
if !is-pure-def(opcode) || opcode == .movz || opcode == .movn
    =
. operands = function.instructions[id].operands
. row = function.instruction-def(id)
if row == no-id || operands.length == 0 || vreg-row(function, operands[0]) != row
    =
. vreg = function.vregs[row].id
. mask = class-mask(function.vregs[row].reg-class)
if states[vreg] != LatticeState.constant || mask == 0
    =
materialize(operands[0], values[vreg] /and/ mask, mask, id)

────────────────────
_ do use-immediates
    - id InstructionId

` Puts each constant an instruction reads into its immediate, where the instruction has one. An
` addition of a constant whose negation fits becomes a subtraction, and the other way round, and a
` subtraction from zero a negation; a shift by a register the constant names becomes a shift by an
` immediate; a multiply by a power of two becomes a shift to the left, and an unsigned division by
` one a shift to the right.
. arena = function.arena
. opcode = function.instructions[id].opcode
. operands = function.instructions[id].operands
if opcode == .fmov
    use-float-immediate(operands)
    =
if operands.length < 2
    =
. mask = operand-mask(operands[0])
if mask == 0
    =
. width U64 = if mask == low-word then 32 else 64
if opcode == .cmp
    . compared = register-constant(operands[1], mask)
    if operands.length == 2 && compared.is-known && is-add-sub-bits(compared.bits)
        operands.data[1] = builder.small-int(compared.bits as I64)
    =
if operands.length != 3
    =
. destination = operands[0]
. left = register-constant(operands[1], mask)
. right = register-constant(operands[2], mask)
. swaps = vreg-row(function, operands[2]) != no-id
if opcode == .add || opcode == .sub
    . negated = (0 - right.bits) /and/ mask
    if right.is-known && is-add-sub-bits(right.bits)
        operands.data[2] = builder.small-int(right.bits as I64)
    else if right.is-known && is-add-sub-bits(negated)
        rewrite-assembly
            - function
            - id
            - if opcode == .add then Opcode.sub else Opcode.add
            - triple(arena, destination, operands[1], builder.small-int(negated as I64))
    else if opcode == .add && swaps && left.is-known && is-add-sub-bits(left.bits)
        rewrite-assembly
            - function
            - id
            - .add
            - triple(arena, destination, operands[2], builder.small-int(left.bits as I64))
    else if opcode == .sub && left.is-known && left.bits == 0 && right-vreg
        rewrite-assembly(function, id, .neg, pair(arena, destination, operands[2]))
    .. right-vreg = vreg-row(function, operands[2]) != no-id
else if opcode == .and || opcode == .orr || opcode == .eor
    if right.is-known && encode-logical-immediate(right.bits, width as U32).is-encodable
        operands.data[2] = builder.small-int(right.bits as I64)
    else if swaps && left.is-known && encode-logical-immediate(left.bits, width as U32).is-encodable
        rewrite-assembly
            - function
            - id
            - opcode
            - triple(arena, destination, operands[2], builder.small-int(left.bits as I64))
else if opcode == .lslv || opcode == .lsrv || opcode == .asrv
    if right.is-known
        . shift = Opcode.lsl
        if opcode == .lsrv
            shift = .lsr
        else if opcode == .asrv
            shift = .asr
        rewrite-assembly
            - function
            - id
            - shift
            - triple
                - arena
                - destination
                - operands[1]
                - builder.small-int((right.bits /and/ (width - 1)) as I64)
else if opcode == .lsl || opcode == .lsr || opcode == .asr
    if right.is-known && right.bits < width
        operands.data[2] = builder.small-int(right.bits as I64)
else if opcode == .mul
    if right.is-known && is-power-of-two(right.bits)
        rewrite-assembly
            - function
            - id
            - .lsl
            - triple(arena, destination, operands[1], builder.small-int(log2(right.bits)))
    else if swaps && left.is-known && is-power-of-two(left.bits)
        rewrite-assembly
            - function
            - id
            - .lsl
            - triple(arena, destination, operands[2], builder.small-int(log2(left.bits)))
else if opcode == .udiv
    if right.is-known && is-power-of-two(right.bits)
        rewrite-assembly
            - function
            - id
            - .lsr
            - triple(arena, destination, operands[1], builder.small-int(log2(right.bits)))

────────────────────
_ do use-float-immediate
    - operands IdList

` Moves a constant into a float without a general register: zero from the zero register, and a
` float FMOV can encode as its immediate.
if operands.length != 2
    =
. destination = vreg-row(function, operands[0])
. mask = operand-mask(operands[1])
if destination == no-id || mask == 0
    =
. reg-class = function.vregs[destination].reg-class
. is-double = reg-class == .fpr64
if (!is-double && reg-class != .fpr32) || is-double != (mask == all-bits)
    =
. value = register-constant(operands[1], mask)
if !value.is-known
    =
if value.bits == 0
    operands.data[1] = builder.preg(if is-double then zero-register else zero-register-32)
else if float-immediate(value.bits, is-double) != no-float-immediate
    operands.data[1] = builder.small-int(value.bits as I64)

────────────────────
_ register-constant Known
    - operand OperandId
    - mask U64

|? vreg-row(function, operand) == no-id
    Known()
|? value.state != LatticeState.constant
    Known()
??
    Known(true, value.bits /and/ mask, false)

.. value = value-of(operand)

────────────────────
_ do drop-dead-edges Bool

. dropped = false
. order = function.block-order
for position in 0 .. < order.length
    . block = order[position]
    if live[block] == 0
        continue
    . successors = function.blocks[block].successors
    . kept U32
    for index in 0 .. < successors.length
        if includes(edges[block], successors[index])
            successors.data[kept] = successors[index]
            kept += 1
    if kept != successors.length
        dropped = true
        function.blocks[block].successors = IdList(successors.data, kept, successors.capacity)
for position in 0 .. < order.length
    . block = order[position]
    if live[block] == 0
        continue
    . instructions = function.blocks[block].instructions
    for index in 0 .. < instructions.length
        do match? function.instructions[instructions[index]]
            | .phi-instruction(phi)
                . exprs = phi.exprs
                . names = phi.blocks
                . kept U32
                for entry in 0 .. < names.length
                    . source = builder.get-block(names[entry])
                    if source == no-id || live[source] == 0 || !includes(edges[source], block)
                        continue
                    exprs.data[kept] = exprs[entry]
                    names.data[kept] = names[entry]
                    kept += 1
                if kept != names.length
                    dropped = true
                    phi.exprs = IdList(exprs.data, kept, exprs.capacity)
                    phi.blocks = IdList(names.data, kept, names.capacity)
= dropped

────────────────────
_ do remove-trivial-phis Bool

. arena = function.arena
. replacements = arena.allocate'U32(function.vreg-count)
. removed = arena.allocate'Byte(function.instructions.length)
. order = function.block-order
. any = false
. changed = true
while changed
    changed = false
    for position in 0 .. < order.length
        . instructions = function.blocks[order[position]].instructions
        for index in 0 .. < instructions.length
            . id = instructions[index]
            if removed[id] != 0
                continue
            do match? function.instructions[id]
                | .phi-instruction(phi)
                    . same = trivial-input(phi.reg, phi.exprs, replacements)
                    if same != no-operand
                        replacements[vreg-id(function, phi.reg)] = same + 1
                        removed[id] = 1
                        changed = true
                        any = true
if !any
    = false
for position in 0 .. < order.length
    . block = order[position]
    . instructions = function.blocks[block].instructions
    . kept U32
    for index in 0 .. < instructions.length
        . id = instructions[index]
        if removed[id] != 0
            continue
        substitute(id, replacements)
        instructions.data[kept] = id
        kept += 1
    function.blocks[block].instructions = IdList(instructions.data, kept, instructions.capacity)
= true

────────────────────
_ do trivial-input OperandId
    - reg OperandId
    - exprs IdList
    - replacements CPointer'U32

. row = vreg-row(function, reg)
if row == no-id || function.vregs[row].hint != no-register
    = no-operand
. vreg = function.vregs[row].id
if definitions[vreg] != 1
    = no-operand
. same = no-operand
. same-id = no-id
for entry in 0 .. < exprs.length
    . input = resolved(exprs[entry], replacements)
    . input-row = vreg-row(function, input)
    if input-row == no-id
        = no-operand
    . input-id = function.vregs[input-row].id
    if input-id == vreg
        continue
    if function.vregs[input-row].reg-class != function.vregs[row].reg-class
        = no-operand
    if same-id == no-id
        same = input
        same-id = input-id
    else if input-id != same-id
        = no-operand
= same

────────────────────
_ do resolved OperandId
    - operand OperandId
    - replacements CPointer'U32

. current = operand
for _ in 0 .. < function.vreg-count
    . vreg = vreg-id(function, current)
    if vreg == no-id || replacements[vreg] == 0
        = current
    current = replacements[vreg] - 1
= current

────────────────────
_ do substitute
    - id InstructionId
    - replacements CPointer'U32

do match? function.instructions[id]
    | .phi-instruction(phi)
        for entry in 0 .. < phi.exprs.length
            . replaced = substituted(phi.exprs[entry], replacements)
            if replaced != no-operand
                phi.exprs.data[entry] = replaced
        =
. operands = function.instructions[id].operands
for position in 0 .. < operands.length
    . replaced = substituted(operands[position], replacements)
    if replaced != no-operand
        operands.data[position] = replaced

────────────────────
_ do substituted OperandId
    - operand OperandId
    - replacements CPointer'U32

if operand == no-operand
    = no-operand
do match? function.operands[operand]
    | .vreg-operand(row)
        if replacements[function.vregs[row.vreg].id] == 0
            = no-operand
        = adapted(resolved(operand, replacements), row.vreg)
    | .load-address-operand(address)
        . base = substituted(address.base, replacements)
        . offset = substituted(address.offset, replacements)
        if base == no-operand && offset == no-operand
            = no-operand
        = builder.load-address
            - if base == no-operand then address.base else base
            - if offset == no-operand then address.offset else offset
            - address.is-pre-index
    | .vreg-group-operand(group)
        for index in group.vregs.start .. < group.vregs.end
            . member = function.group-vregs[index]
            . vreg = function.vregs[member].id
            if replacements[vreg] != 0
                . target = adapted(resolved(replacements[vreg] - 1, replacements), member)
                function.group-vregs.data[index] = vreg-row(function, target)
= no-operand

────────────────────
_ do adapted OperandId
    - target OperandId
    - use VRegId

. target-row = vreg-row(function, target)
if function.vregs[use].reg-class == .gpr32 && function.vregs[target-row].reg-class == .gpr64
    = builder.narrow-view(target)
= target

────────────────────
_ do rewrite-allocations Bool
    - dropping Bool

. symbol = builder.bundle.allocate-object-symbol
. allocations = IdList()
. homes = IdList()
. order = function.block-order
for position in 0 .. < order.length
    . block = order[position]
    . instructions = function.blocks[block].instructions
    for index in 0 .. < instructions.length
        if allocates(instructions[index], symbol)
            allocations = allocations.appended(function.arena, instructions[index])
            homes = homes.appended(function.arena, block)
=? false if allocations.length == 0
. blocks = box-blocks(allocations)
. changed = false
for index in 0 .. < allocations.length
    . rewritten = false
    if dropping
        rewritten = drop-allocation(homes[index], allocations[index], blocks[index])
    else
        rewritten = forward-allocation(homes[index], allocations[index], blocks[index])
    if rewritten
        changed = true
        if index + 1 < allocations.length
            blocks = box-blocks(allocations)
= changed

────────────────────
_ do promote-allocations Bool

` Keeps in the frame each object allocated here that only plain loads and stores at known places
` reach, as one variable for each place they read or write, zeroed where the object was made as
` the collector zeroes what it allocates, and then promotes those variables to registers. So the
` environment of a nested function inlined where it is written, which no other code is given,
` needs no heap. Variables that all promote take no room in the frame.
. symbol = builder.bundle.allocate-object-symbol
. allocations = IdList()
. homes = IdList()
. order = function.block-order
for position in 0 .. < order.length
    . block = order[position]
    . instructions = function.blocks[block].instructions
    for index in 0 .. < instructions.length
        if allocates(instructions[index], symbol)
            allocations = allocations.appended(function.arena, instructions[index])
            homes = homes.appended(function.arena, block)
=? false if allocations.length == 0
. slots = function.frame-slots.length
. blocks = box-blocks(allocations)
promoted-objects = IdList()
for index in 0 .. < allocations.length
    if stack-allocation(homes[index], allocations[index], blocks[index]) && has-next
        blocks = box-blocks(allocations)
    .. has-next = index + 1 < allocations.length
=? false if promoted-objects.length == 0
. kept = function.vars
function.vars = promoted-objects
MIRVariablesToRegisters(builder).run()
function.vars = kept
. promoted = true
for index in 0 .. < promoted-objects.length
    if !function.frame-objects[promoted-objects[index]].can-promote
        promoted = false
if promoted
    function.frame-slots = IdList(function.frame-slots.data, slots, function.frame-slots.capacity)
function.forget-use-counts()
= true

────────────────────
_ do stack-allocation Bool
    - home BlockId
    - allocation InstructionId
    - order IdList

` Replaces one allocation with variables of the frame where `promote-allocations` can: each load
` or store of the object is a plain one of a register at a known place, the places do not
` overlap, and each place is read and written in one size and one class of register. A place
` that holds a pointer the collector follows is a root.
. box = box-of(allocation)
if box == no-id
    = false
note-derivations(box, order)
. arena = function.arena
. accesses = IdList()
. barriers = IdList()
. barrier-blocks = IdList()
for position in 0 .. < order.length
    . block = order[position]
    . instructions = function.blocks[block].instructions
    for index in 0 .. < instructions.length
        . id = instructions[index]
        if id == allocation
            continue
        . use = box-access(id, box)
        if use == BoxUse.escaped
            = false
        if use == BoxUse.barrier
            barriers = barriers.appended(arena, id)
            barrier-blocks = barrier-blocks.appended(arena, block)
        else if use != BoxUse.unused
            . opcode = function.instructions[id].opcode
            . plain = opcode == .ldr || opcode == .str || opcode == .ldrb || opcode == .strb || opcode == .ldrh || opcode == .strh
            if !plain || function.instructions[id].operands.length != 2
                = false
            accesses = accesses.appended(arena, id)
. places = IdList()
. sizes = IdList()
. classes = IdList()
. roots = IdList()
. fields = IdList()
for index in 0 .. < accesses.length
    . id = accesses[index]
    . value = function.instructions[id].operands[0]
    . row = vreg-row(function, value)
    . offset = access-offset(id)
    . size = slot-size(id)
    if row == no-id || offset == U64.max || size == 0 || offset > (U32.max as U64)
        = false
    . class = function.vregs[row].reg-class as U32
    . field = no-id
    for entry in 0 .. < places.length
        . start = places[entry] as U64
        if start == offset
            field = entry
        else if start < offset + size && offset < start + (sizes[entry] as U64)
            = false
    if field == no-id
        field = places.length
        places = places.appended(arena, offset as U32)
        sizes = sizes.appended(arena, size as U32)
        classes = classes.appended(arena, class)
        roots = roots.appended(arena, no-id)
    else if (sizes[field] as U64) != size || classes[field] != class
        = false
    if roots[field] == no-id && function.vregs[row].gc-root
        roots.data[field] = row
    fields = fields.appended(arena, field)
. objects = IdList()
for entry in 0 .. < places.length
    . slot = builder.frame-slot()
    . class = classes[entry] as RegClass
    . root = roots[entry]
    . type = field-type(sizes[entry], class, root != no-id)
    if root == no-id
        objects = objects.appended(arena, builder.add-frame-object(slot, type))
    else
        . held = function.vregs[root]
        objects = objects.appended
            - arena
            - builder.add-frame-object
                - slot
                - type
                - 0
                - true
                - true
                - held.gc-descriptor
                - held.gc-root-mode
for index in 0 .. < accesses.length
    . id = accesses[index]
    . operands = new-id-list(arena, 2)
    operands = operands.appended(arena, function.instructions[id].operands[0])
    operands = operands.appended(arena, builder.frame-object-operand(objects[fields[index]]))
    rewrite-assembly(function, id, function.instructions[id].opcode, operands)
for index in 0 .. < barriers.length
    remove-instruction(function, barrier-blocks[index], barriers[index])
remove-derivations()
. zeros = IdList()
. wide = no-operand
. narrow = no-operand
for entry in 0 .. < places.length
    . class = classes[entry] as RegClass
    . words = class == .gpr64 || class == .fpr64
    if words && wide == no-operand
        wide = builder.vreg(.gpr64)
        zeros = zeros.appended
            - arena
            - builder.new-assembly(.movz, wide, builder.small-int(0), builder.small-int(0))
    if !words && narrow == no-operand
        narrow = builder.vreg(.gpr32)
        zeros = zeros.appended
            - arena
            - builder.new-assembly(.movz, narrow, builder.small-int(0), builder.small-int(0))
    . zero = if words then wide else narrow
    if class == .fpr64 || class == .fpr32
        . bits = zero
        zero = builder.vreg(class)
        zeros = zeros.appended(arena, builder.new-assembly(.fmov, zero, bits))
    zeros = zeros.appended
        - arena
        - builder.new-assembly(.str, zero, builder.frame-object-operand(objects[entry]))
. instructions = function.blocks[home].instructions
. rebuilt = new-id-list(arena, instructions.length + zeros.length)
for index in 0 .. < instructions.length
    if instructions[index] != allocation
        rebuilt = rebuilt.appended(arena, instructions[index])
        continue
    for zero in 0 .. < zeros.length
        rebuilt = rebuilt.appended(arena, zeros[zero])
function.drop-uses(allocation)
function.blocks[home].instructions = rebuilt
for entry in 0 .. < objects.length
    promoted-objects = promoted-objects.appended(arena, objects[entry])
= true

────────────────────
_ field-type MIRTypeId
    - size U32
    - class RegClass
    - rooted Bool

` The type of a variable that holds a place of an object as `stack-allocation` read it.
|? class == .fpr64
    f64-type-id
|? class == .fpr32
    f32-type-id
|? size == 1
    u8-type-id
|? size == 2
    u16-type-id
|? class == .gpr32
    u32-type-id
|? rooted
    pointer-type-id
??
    i64-type-id

────────────────────
_ do box-blocks CPointer'IdList
    - allocations IdList

. arena = function.arena
. limit = function.vreg-count
. holders = arena.allocate'U32(limit)
for vreg in 0 .. < limit
    holders[vreg] = U32.max
. found = arena.allocate'IdList(allocations.length)
for index in 0 .. < allocations.length
    found[index] = IdList()
    . box = box-of(allocations[index])
    if box != no-id && box < limit
        holders[box] = index as U32
. order = function.block-order
for position in 0 .. < order.length
    . instructions = function.blocks[order[position]].instructions
    for index in 0 .. < instructions.length
        hold-derivation(holders, instructions[index])
for position in 0 .. < order.length
    . block = order[position]
    . instructions = function.blocks[block].instructions
    for index in 0 .. < instructions.length
        do match? function.instructions[instructions[index]]
            | .phi-instruction(phi)
                note-box-block(found, holders, block, vreg-id(function, phi.reg))
                for entry in 0 .. < phi.exprs.length
                    note-box-block(found, holders, block, vreg-id(function, phi.exprs[entry]))
                continue
        . operands = function.instructions[instructions[index]].operands
        for entry in 0 .. < operands.length
            do match? function.operands[operands[entry]]
                | .vreg-operand(row)
                    note-box-block(found, holders, block, function.vregs[row.vreg].id)
                | .vreg-group-operand(group)
                    for member in group.vregs.start .. < group.vregs.end
                        note-box-block
                            - found
                            - holders
                            - block
                            - function.vregs[function.group-vregs[member]].id
                | .load-address-operand(address)
                    note-box-block(found, holders, block, vreg-id(function, address.offset))
                    note-box-block(found, holders, block, vreg-id(function, address.base))
= found

────────────────────
_ do hold-derivation
    - holders CPointer'U32
    - id InstructionId

. row = function.instructions[id]
=? if row.opcode != .addptr || row.operands.length != 2
. derived = vreg-id(function, row.operands[0])
=? if derived == no-id || derived >= function.vreg-count || definitions[derived] != 1 || held
.. held = holders[derived] != U32.max
do match? function.operands[row.operands[1]]
    | .load-address-operand(address)
        . base = vreg-id(function, address.base)
        if base != no-id && base < function.vreg-count
            holders[derived] = holders[base]

────────────────────
_ do note-box-block
    - found CPointer'IdList
    - holders CPointer'U32
    - block BlockId
    - vreg U32

=? if vreg == no-id || vreg >= function.vreg-count || holders[vreg] == U32.max
. held = found[holders[vreg]]
=? if held.length != 0 && held[held.length - 1] == block
found[holders[vreg]] = held.appended(function.arena, block)

────────────────────
_ do allocates Bool
    - id InstructionId
    - symbol StringId

. row = function.instructions[id]
if row.opcode == .gc-alloc
    = row.operands.length != 0
if row.opcode != .call || symbol == no-string || row.operands.length < 2
    = false
do match? function.operands[row.operands[0]]
    | .symbol-operand(target)
        = target.name == symbol
= false

────────────────────
_ box-of U32
    - allocation InstructionId

if box == no-id || definitions[box] != 1 then no-id else box

.. row = function.instructions[allocation]
.. box = vreg-id(function, row.operands[if row.opcode == .gc-alloc then 0 else 1])

────────────────────
_ do drop-allocation Bool
    - home BlockId
    - allocation InstructionId
    - order IdList

. box = box-of(allocation)
if box == no-id
    = false
note-derivations(box, order)
. arena = function.arena
. writes = IdList()
. blocks = IdList()
for position in 0 .. < order.length
    . block = order[position]
    . instructions = function.blocks[block].instructions
    for index in 0 .. < instructions.length
        . id = instructions[index]
        if id == allocation
            continue
        . use = box-access(id, box)
        if use == BoxUse.escaped || use == BoxUse.loaded
            = false
        if use != BoxUse.unused
            writes = writes.appended(arena, id)
            blocks = blocks.appended(arena, block)
for index in 0 .. < writes.length
    remove-instruction(function, blocks[index], writes[index])
remove-derivations()
remove-instruction(function, home, allocation)
= true

────────────────────
_ do forward-allocation Bool
    - home BlockId
    - allocation InstructionId
    - order IdList

. box = box-of(allocation)
if box == no-id
    = false
note-derivations(box, order)
. arena = function.arena
. stores = IdList()
. barriers = IdList()
. loads = IdList()
. load-blocks = IdList()
for position in 0 .. < order.length
    . block = order[position]
    . instructions = function.blocks[block].instructions
    . passed = block != home
    . called = false
    . loaded = false
    for index in 0 .. < instructions.length
        . id = instructions[index]
        if id == allocation
            passed = true
            continue
        . use = box-access(id, box)
        if use == BoxUse.escaped
            = false
        if use == BoxUse.stored || use == BoxUse.barrier
            if block != home || !passed || called || loaded
                = false
            if use == BoxUse.stored
                stores = stores.appended(arena, id)
            else
                barriers = barriers.appended(arena, id)
        else if use == BoxUse.loaded
            if !passed
                = false
            loaded = true
            loads = loads.appended(arena, id)
            load-blocks = load-blocks.appended(arena, block)
        else if block == home && passed && function.instructions[id].opcode == .call
            called = true
for first in 0 .. < stores.length
    . low = access-offset(stores[first])
    if low == U64.max || slot-size(stores[first]) == 0
        = false
    for second in first + 1 .. < stores.length
        . high = access-offset(stores[second])
        if high == U64.max
            = false
        if low < high + span-size(stores[second]) && high < low + span-size(stores[first])
            = false
. complete = true
. changed = false
for index in 0 .. < loads.length
    if forward-access(load-blocks[index], loads[index], stores)
        changed = true
    else
        complete = false
if !complete
    = changed
for index in 0 .. < stores.length
    remove-instruction(function, home, stores[index])
for index in 0 .. < barriers.length
    remove-instruction(function, home, barriers[index])
remove-derivations()
remove-instruction(function, home, allocation)
= true

────────────────────
_ do note-derivations
    - box U32
    - order IdList

. arena = function.arena
derived-vregs = IdList()
derived-offsets = IdList()
derived-rows = IdList()
derived-blocks = IdList()
for position in 0 .. < order.length
    . block = order[position]
    . instructions = function.blocks[block].instructions
    for index in 0 .. < instructions.length
        . id = instructions[index]
        . row = function.instructions[id]
        if row.opcode != .addptr || row.operands.length != 2
            continue
        . derived = vreg-id(function, row.operands[0])
        if derived == no-id || definitions[derived] != 1
            continue
        do match? function.operands[row.operands[1]]
            | .load-address-operand(address)
                if based-on-box && !address.is-pre-index && address.index-shift == 0
                    . offset = if no-offset then Known(true, 0, false) else known-offset
                        .. no-offset = address.offset == no-operand
                        .. known-offset = known-int(function, address.offset)
                    if offset.is-known && !offset.is-negative && offset.bits <= (U32.max as U64)
                        derived-vregs = derived-vregs.appended(arena, derived)
                        derived-offsets = derived-offsets.appended(arena, offset.bits as U32)
                        derived-rows = derived-rows.appended(arena, id)
                        derived-blocks = derived-blocks.appended(arena, block)
                .. based-on-box = vreg-id(function, address.base) == box

────────────────────
_ do remove-derivations

for index in 0 .. < derived-rows.length
    remove-instruction(function, derived-blocks[index], derived-rows[index])

────────────────────
_ do derived-offset U64
    - vreg U32

for index in 0 .. < derived-vregs.length
    =? derived-offsets[index] if derived-vregs[index] == vreg
= U64.max

────────────────────
_ do box-access U32
    - id InstructionId
    - box U32

for index in 0 .. < derived-rows.length
    =? BoxUse.unused if derived-rows[index] == id
. found = box-use(id, box)
=? found if found == BoxUse.escaped
for index in 0 .. < derived-vregs.length
    . use = box-use(id, derived-vregs[index])
    =? BoxUse.escaped if use == BoxUse.escaped || (use != BoxUse.unused && found != BoxUse.unused)
    if use != BoxUse.unused
        found = use
= found

────────────────────
_ do box-use U32
    - id InstructionId
    - box U32

do match? function.instructions[id]
    | .phi-instruction(phi)
        if vreg-id(function, phi.reg) == box
            = BoxUse.escaped
        for entry in 0 .. < phi.exprs.length
            if vreg-id(function, phi.exprs[entry]) == box
                = BoxUse.escaped
        = BoxUse.unused
. opcode = function.instructions[id].opcode
. operands = function.instructions[id].operands
. last = operands.length - 1
. found = BoxUse.unused
for position in 0 .. < operands.length
    do match? function.operands[operands[position]]
        | .vreg-operand(row)
            if function.vregs[row.vreg].id == box
                if opcode != .gc-barrier || position != 0
                    = BoxUse.escaped
                found = BoxUse.barrier
        | .vreg-group-operand(group)
            for index in group.vregs.start .. < group.vregs.end
                if function.vregs[function.group-vregs[index]].id == box
                    = BoxUse.escaped
        | .load-address-operand(address)
            if vreg-id(function, address.offset) == box
                = BoxUse.escaped
            if vreg-id(function, address.base) == box
                if address.is-pre-index || position != last || (has-offset && !offset-known)
                    = BoxUse.escaped
                .. has-offset = address.offset != no-operand
                .. offset-known = known-int(function, address.offset).is-known
                if slot-count(opcode) == 1 && last != 1
                    = BoxUse.escaped
                if slot-count(opcode) == 2 && last != 2
                    = BoxUse.escaped
                if opcode == .ldr || narrow-load || opcode == .ldrsw || opcode == .ldp
                    found = BoxUse.loaded
                else if opcode == .str || opcode == .strb || opcode == .strh || opcode == .stp
                    found = BoxUse.stored
                else
                    = BoxUse.escaped
                .. narrow-load = opcode == .ldrb || opcode == .ldrh
= found

────────────────────
_ slot-count U32
    - opcode Opcode

if opcode == .ldp || opcode == .stp then 2 else 1

────────────────────
_ do access-offset U64
    - id InstructionId

. operands = function.instructions[id].operands
do match? function.operands[operands[operands.length - 1]]
    | .load-address-operand(address)
        . derived = derived-offset(vreg-id(function, address.base))
        . start = if derived == U64.max then 0u64 else derived
        if address.offset == no-operand
            = start
        . offset = known-int(function, address.offset)
        if offset.is-known && !offset.is-negative
            = start + offset.bits
= U64.max

────────────────────
_ span-size U64
    - id InstructionId

slot-size(id) * (slot-count(function.instructions[id].opcode) as U64)

────────────────────
_ do slot-size U64
    - id InstructionId

. opcode = function.instructions[id].opcode
if opcode == .strb || opcode == .ldrb
    = 1
if opcode == .strh || opcode == .ldrh
    = 2
if opcode == .ldrsw
    = 4
if opcode != .str && opcode != .stp && opcode != .ldr && opcode != .ldp
    = 0
. value = function.instructions[id].operands[0]
do match? function.operands[value]
    | .preg-operand(row)
        if row.register == zero-register
            = 8
        if row.register == zero-register-32
            = 4
        = 0
= class-size(operand-class(value))

────────────────────
_ operand-class U32
    - operand OperandId

if row == no-id then U32.max else function.vregs[row].reg-class as U32

.. row = vreg-row(function, operand)

────────────────────
_ do forward-access Bool
    - block BlockId
    - load InstructionId
    - stores IdList

. opcode = function.instructions[load].opcode
. operands = function.instructions[load].operands
. offset = access-offset(load)
. size = slot-size(load)
. count = slot-count(opcode)
if offset == U64.max || size == 0
    = false
. moves = IdList()
for slot in 0 .. < count
    . wanted = offset + (slot as U64) * size
    . source = no-operand
    for entry in 0 .. < stores.length
        . store = stores[entry]
        . base = access-offset(store)
        if slot-size(store) == size
            for part in 0 .. < slot-count(function.instructions[store].opcode)
                if base + (part as U64) * size == wanted
                    source = function.instructions[store].operands[part]
    if source == no-operand
        = false
    . made = forwarded-move(opcode, operands[slot], source)
    if made == no-id
        = false
    moves = moves.appended(function.arena, made)
do match? function.instructions[moves[0]]
    | .assembly-instruction(row)
        rewrite-assembly(function, load, row.opcode, row.operands)
if count == 2
    . instructions = function.blocks[block].instructions
    for index in 0 .. < instructions.length
        if instructions[index] == load
            function.blocks[block].instructions = instructions.inserted
                - function.arena
                - index + 1
                - moves[1]
            = true
= true

────────────────────
_ do forwarded-move InstructionId
    - opcode Opcode
    - target OperandId
    - value OperandId

. target-class = operand-class(target)
if target-class == U32.max
    = no-id
. is-float = target-class == RegClass.fpr32 as U32 || target-class == RegClass.fpr64 as U32
do match? function.operands[value]
    | .preg-operand(row)
        if is-float || (row.register != zero-register && row.register != zero-register-32)
            = no-id
        = builder.new-assembly(.movz, target, builder.small-int(0), builder.small-int(0))
. row = vreg-row(function, value)
if row == no-id || definitions[function.vregs[row].id] != 1
    = no-id
. value-class = function.vregs[row].reg-class as U32
if opcode == .ldrb
    = builder.new-assembly(.uxtb, target, value)
if opcode == .ldrh
    = builder.new-assembly(.uxth, target, value)
if opcode == .ldrsw
    = builder.new-assembly(.sxtw, target, value)
if value-class != target-class
    . is-value-float = value-class == RegClass.fpr32 as U32 || value-class == RegClass.fpr64 as U32
    . is-wide = target-class == RegClass.gpr64 as U32 || target-class == RegClass.fpr64 as U32
    . is-value-wide = value-class == RegClass.gpr64 as U32 || value-class == RegClass.fpr64 as U32
    =? no-id if is-float == is-value-float || is-wide != is-value-wide
= builder.new-assembly
    - if is-float || value-class != target-class then Opcode.fmov else Opcode.mov
    - target
    - value

━━━━━━━━━━━━━━━━━━━━
+ MIRValueNumberingPass

` Numbers the values of a function in SSA form, walking its blocks down the dominator tree, so
` that values computed the same way from the same numbers share one, as do loads of one place
` while memory is unchanged. An instruction whose value a dominating instruction already computed
` becomes a copy of it, unless it only gives the truth of a condition, which costs less to give
` again than to keep. A branch's condition is a fact in the blocks only one of its edges
` reaches, and a branch a fact settles jumps straight to its side. The facts one side of a
` diamond leaves at its join hold again on that side of a later branch on the same condition,
` and a phi joining the same values on the same sides of the same condition as an earlier phi
` is that phi. Dead definitions and the comparisons nothing reads are then removed, and a branch
` whose sides are left empty and give its join the same values jumps to the join.

_ builder MIRBuilder
_ function MIRFunction
_ blocks IdList
_ post-indexes CPointer'U32
_ doms CPointer'U32
_ climbed CPointer'U32
_ children CPointer'IdList
_ entered CPointer'U32
_ exited CPointer'U32
_ writes CPointer'Byte
_ marks CPointer'U32
_ mark U32
_ generations CPointer'U32
_ generation U32
_ generation-count U32
_ definitions CPointer'U32
_ def-classes CPointer'Byte
_ visited-defs CPointer'Byte
_ numbers CPointer'U32
_ truths CPointer'U32
_ negated CPointer'Byte
_ booleans CPointer'Byte
_ facts CPointer'Byte
_ fact-stack IdList
_ arm-keys IdList
_ arm-heads IdList
_ arm-blocks IdList
_ arm-heights IdList
_ implied-index CPointer'U32
_ implied-joins IdList
_ implied-facts IdList
_ implied-starts IdList
_ implied-ends IdList
_ branch-keys CPointer'U32
_ branch-negated CPointer'Byte
_ branch-taken CPointer'U32
_ branch-fallen CPointer'U32
_ heads CPointer'U64
_ firsts CPointer'U64
_ seconds CPointer'U64
_ thirds CPointer'U64
_ slot-numbers CPointer'U32
_ slot-leaders CPointer'U32
_ slot-blocks CPointer'U32
_ mask U32
_ key-head U64
_ key-first U64
_ key-second U64
_ key-third U64
_ encoded-tag U64
_ encoded-value U64
_ replaced-phis IdList
_ replacing-moves IdList
_ vreg-limit U32
_ number-limit U32
_ next-number U32
_ flags U32
_ changed Bool

────────────────────
+ This
    - builder MIRBuilder

.. function = builder.function

────────────────────
_ get arena Arena @inline

function.arena

────────────────────
+ do run Bool

function.forget-use-counts()
. order = function.post-order()
. count = order.length
if count == 0
    = false
. block-count U32 = function.blocks.length as U32
post-indexes = arena.allocate'U32(block-count)
for index in 0 .. < count
    post-indexes[order[index]] = index
blocks = new-id-list(arena, count)
for index in 0 .. < count
    blocks = blocks.appended(arena, order[count - 1 - index])
vreg-limit = function.vreg-count
. live U32
for position in 0 .. < count
    live += function.blocks[blocks[position]].instructions.length
number-limit = vreg-limit + live + 2
next-number = vreg-limit + 1
find-dominators(block-count)
number-tree(block-count)
count-definitions(block-count)
numbers = arena.allocate'U32(vreg-limit + 1)
truths = arena.allocate'U32(number-limit + 1)
negated = arena.allocate'Byte(number-limit + 1)
booleans = arena.allocate'Byte(number-limit + 1)
facts = arena.allocate'Byte(number-limit + 1)
implied-index = arena.allocate'U32(number-limit * 2 + 2)
generations = arena.allocate'U32(block-count)
marks = arena.allocate'U32(block-count)
branch-keys = arena.allocate'U32(block-count)
branch-negated = arena.allocate'Byte(block-count)
branch-taken = arena.allocate'U32(block-count)
branch-fallen = arena.allocate'U32(block-count)
. capacity U32 = 64
while capacity < live * 4
    capacity = capacity * 2
mask = capacity - 1
heads = arena.allocate'U64(capacity)
firsts = arena.allocate'U64(capacity)
seconds = arena.allocate'U64(capacity)
thirds = arena.allocate'U64(capacity)
slot-numbers = arena.allocate'U32(capacity)
slot-leaders = arena.allocate'U32(capacity)
slot-blocks = arena.allocate'U32(capacity)
fact-stack = IdList()
arm-keys = IdList()
arm-heads = IdList()
arm-blocks = IdList()
arm-heights = IdList()
implied-joins = IdList()
implied-facts = IdList()
implied-starts = IdList()
implied-ends = IdList()
changed = false
walk()
if changed
    builder.prune-unreachable-blocks()
if remove-dead-definitions(function)
    changed = true
while remove-dead-comparisons(function)
    remove-dead-definitions(function)
    changed = true
function.forget-use-counts()
if collapse-empty-branches()
    changed = true
    builder.prune-unreachable-blocks()
= changed

────────────────────
_ do find-dominators
    - block-count U32

doms = arena.allocate'U32(block-count)
climbed = arena.allocate'U32(block-count)
for block in 0 .. < block-count
    doms[block] = no-id
. entry = blocks[0]
doms[entry] = entry
. join U32
. moved = true
while moved
    moved = false
    for position in 1 .. < blocks.length
        . block = blocks[position]
        . predecessors = function.blocks[block].predecessors
        . dominator = no-id
        join += 1
        for index in 0 .. < predecessors.length
            . predecessor = predecessors[index]
            if doms[predecessor] == no-id
                continue
            if dominator == no-id
                dominator = predecessor
            else
                dominator = intersect(predecessor, dominator, join)
        if dominator != no-id && doms[block] != dominator
            doms[block] = dominator
            moved = true
children = arena.allocate'IdList(block-count)
for position in 1 .. < blocks.length
    . block = blocks[position]
    . dominator = doms[block]
    if dominator != no-id && dominator != block
        children[dominator] = children[dominator].appended(arena, block)

────────────────────
_ do intersect BlockId
    - left BlockId
    - right BlockId
    - join U32

. first = left
. second = right
while first != second
    while post-indexes[first] < post-indexes[second]
        if climbed[first] == join
            = second
        climbed[first] = join
        first = doms[first]
    while post-indexes[second] < post-indexes[first]
        climbed[second] = join
        second = doms[second]
= first

────────────────────
_ do number-tree
    - block-count U32

entered = arena.allocate'U32(block-count)
exited = arena.allocate'U32(block-count)
. pending = arena.allocate'U32(blocks.length + 1)
. cursors = arena.allocate'U32(blocks.length + 1)
. clock U32 = 1
. depth U32 = 1
pending[0] = blocks[0]
entered[blocks[0]] = clock
while depth != 0
    . block = pending[depth - 1]
    . kids = children[block]
    . cursor = cursors[depth - 1]
    if cursor < kids.length
        cursors[depth - 1] = cursor + 1
        clock += 1
        entered[kids[cursor]] = clock
        pending[depth] = kids[cursor]
        cursors[depth] = 0
        depth += 1
        continue
    clock += 1
    exited[block] = clock
    depth -= 1

────────────────────
_ dominates Bool
    - upper BlockId
    - lower BlockId

entered[upper] != 0 && entered[upper] <= entered[lower] && exited[lower] <= exited[upper]

────────────────────
_ do count-definitions
    - block-count U32

definitions = arena.allocate'U32(vreg-limit + 1)
def-classes = arena.allocate'Byte(vreg-limit + 1)
visited-defs = arena.allocate'Byte(vreg-limit + 1)
writes = arena.allocate'Byte(block-count)
for position in 0 .. < blocks.length
    . block = blocks[position]
    . instructions = function.blocks[block].instructions
    for index in 0 .. < instructions.length
        . id = instructions[index]
        if !keeps-memory(function.instructions[id].opcode)
            writes[block] = 1
        do match? function.instructions[id]
            | .phi-instruction(phi)
                note-definition(phi.reg)
                continue
        . roles = function.operand-roles(id)
        . operands = function.instructions[id].operands
        for entry in 0 .. < operands.length
            if (role-at(roles, entry) /and/ def-role) == 0
                continue
            do match? function.operands[operands[entry]]
                | .vreg-operand
                    note-definition(operands[entry])
                | .vreg-group-operand(group)
                    for item in group.vregs.start .. < group.vregs.end
                        . vreg = function.vregs[function.group-vregs[item]].id
                        if vreg < vreg-limit
                            definitions[vreg] = definitions[vreg] + 2
                | .load-address-operand(address)
                    . base = vreg-id(function, address.base)
                    if base != no-id && base < vreg-limit
                        definitions[base] = definitions[base] + 2

────────────────────
_ do note-definition
    - operand OperandId

. row = vreg-row(function, operand)
if row == no-id
    =
. vreg = function.vregs[row].id
if vreg >= vreg-limit
    =
definitions[vreg] = definitions[vreg] + 1
def-classes[vreg] = ((function.vregs[row].reg-class as U32) + 1) as Byte

────────────────────
_ do walk

. pending = arena.allocate'U32(blocks.length + 1)
. cursors = arena.allocate'U32(blocks.length + 1)
. fact-heights = arena.allocate'U32(blocks.length + 1)
. arm-counts = arena.allocate'U32(blocks.length + 1)
. depth U32 = 1
pending[0] = blocks[0]
fact-heights[0] = 0
arm-counts[0] = 0
enter(blocks[0])
while depth != 0
    . block = pending[depth - 1]
    . kids = children[block]
    . cursor = cursors[depth - 1]
    if cursor < kids.length
        cursors[depth - 1] = cursor + 1
        pending[depth] = kids[cursor]
        cursors[depth] = 0
        fact-heights[depth] = fact-stack.length
        arm-counts[depth] = arm-keys.length
        depth += 1
        enter(kids[cursor])
        continue
    depth -= 1
    pop-facts(fact-heights[depth])
    . arms = arm-counts[depth]
    arm-keys = IdList(arm-keys.data, arms, arm-keys.capacity)
    arm-heads = IdList(arm-heads.data, arms, arm-heads.capacity)
    arm-blocks = IdList(arm-blocks.data, arms, arm-blocks.capacity)
    arm-heights = IdList(arm-heights.data, arms, arm-heights.capacity)

────────────────────
_ do enter
    - block BlockId

. dominator = doms[block]
if block == blocks[0]
    generation = fresh-generation()
else
    generation = entry-generation(block, dominator)
flags = 0
replaced-phis = IdList()
replacing-moves = IdList()
note-edge(block, dominator)
. instructions = function.blocks[block].instructions
for index in 0 .. < instructions.length
    visit(block, instructions[index])
if replaced-phis.length != 0
    place-replacements(block)
settle-branch(block)
generations[block] = generation

────────────────────
_ do fresh-generation U32

generation-count += 1
= generation-count

────────────────────
_ do entry-generation U32
    - block BlockId
    - dominator BlockId

. predecessors = function.blocks[block].predecessors
if predecessors.length == 1 && predecessors[0] == dominator
    = generations[dominator]
for index in 0 .. < predecessors.length
    . predecessor = predecessors[index]
    if predecessor == block || post-indexes[predecessor] <= post-indexes[block]
        = fresh-generation()
if writes-between(block, dominator)
    = fresh-generation()
= generations[dominator]

────────────────────
_ do writes-between Bool
    - block BlockId
    - dominator BlockId

` Whether a block on a path from `dominator` to `block`, other than the two, may write memory.
mark += 1
. pending = new-id-list(arena, 8)
. predecessors = function.blocks[block].predecessors
for index in 0 .. < predecessors.length
    pending = pending.appended(arena, predecessors[index])
. visited U32
while pending.length != 0
    . current = pending[pending.length - 1]
    pending = IdList(pending.data, pending.length - 1, pending.capacity)
    if current == dominator || marks[current] == mark
        continue
    marks[current] = mark
    visited += 1
    if visited > 64 || writes[current] != 0 || current == block
        = true
    . above = function.blocks[current].predecessors
    for index in 0 .. < above.length
        pending = pending.appended(arena, above[index])
= false

────────────────────
_ do note-edge
    - block BlockId
    - head BlockId

. predecessors = function.blocks[block].predecessors
if predecessors.length != 1 || predecessors[0] != head || head == block
    =
. key = branch-keys[head]
if key == 0
    =
. taken = branch-taken[head]
. fallen = branch-fallen[head]
if taken == fallen
    =
. is-negated = branch-negated[head] != 0
. holds = if block == taken then !is-negated else is-negated
arm-keys = arm-keys.appended(arena, key * 2 + (if holds then 1 else 0))
arm-heads = arm-heads.appended(arena, head)
arm-blocks = arm-blocks.appended(arena, block)
arm-heights = arm-heights.appended(arena, fact-stack.length)
push-fact(key, holds)
import-implied(key * 2 + (if holds then 1 else 0), head)

────────────────────
_ do push-fact
    - key U32
    - holds Bool

if key == 0 || facts[key] != 0
    =
facts[key] = if holds then 1 else 2
fact-stack = fact-stack.appended(arena, key)

────────────────────
_ do pop-facts
    - height U32

while fact-stack.length > height
    facts[fact-stack[fact-stack.length - 1]] = 0
    fact-stack = IdList(fact-stack.data, fact-stack.length - 1, fact-stack.capacity)

────────────────────
_ do import-implied
    - slot U32
    - head BlockId

. record = implied-index[slot]
if record == 0
    =
if !dominates(implied-joins[record - 1], head)
    =
for entry in implied-starts[record - 1] .. < implied-ends[record - 1]
    . packed = implied-facts[entry]
    push-fact(packed /zrshift/ 1, (packed /and/ 1) != 0)

────────────────────
_ do record-implied
    - block BlockId
    - join BlockId

` Keeps the facts in force where `block` jumps to `join`, for the side of the branch that
` `join` closes, when that side leaves only through this jump or through blocks that end the
` function.
if function.blocks[join].predecessors.length < 2
    =
. frame = arm-keys.length
while frame > 0
    frame -= 1
    . head = arm-heads[frame]
    if doms[join] != head
        continue
    . arm = arm-blocks[frame]
    . predecessors = function.blocks[join].predecessors
    . under U32
    for index in 0 .. < predecessors.length
        if dominates(arm, predecessors[index])
            under += 1
    if under != 1 || !leaves-only-to(arm, join)
        =
    . start = implied-facts.length
    for entry in arm-heights[frame] .. < fact-stack.length
        . key = fact-stack[entry]
        implied-facts = implied-facts.appended(arena, key * 2 + (if facts[key] == 1 then 1 else 0))
    implied-joins = implied-joins.appended(arena, join)
    implied-starts = implied-starts.appended(arena, start)
    implied-ends = implied-ends.appended(arena, implied-facts.length)
    implied-index[arm-keys[frame]] = implied-joins.length
    =

────────────────────
_ do leaves-only-to Bool
    - arm BlockId
    - join BlockId

. pending = new-id-list(arena, 8)
pending = pending.appended(arena, arm)
. visited U32
while pending.length != 0
    . current = pending[pending.length - 1]
    pending = IdList(pending.data, pending.length - 1, pending.capacity)
    visited += 1
    if visited > 64
        = false
    . successors = function.blocks[current].successors
    for index in 0 .. < successors.length
        . successor = successors[index]
        if successor != join && !dominates(arm, successor) && has-successors
            = false
        .. has-successors = function.blocks[successor].successors.length != 0
    . kids = children[current]
    for index in 0 .. < kids.length
        pending = pending.appended(arena, kids[index])
= true

────────────────────
_ do visit
    - block BlockId
    - id InstructionId

. opcode = function.instructions[id].opcode
if opcode == .comment || opcode == .nop || opcode == .inlined-name
    =
if opcode == .phi
    visit-phi(block, id)
    =
mark-defs(id)
if is-branch-opcode(opcode) || opcode == .br || opcode == .ret
    =
if is-flag-compare(opcode)
    flags = compare-number(id, opcode)
    =
if !keeps-memory(opcode)
    generation = fresh-generation()
    flags = 0
    give-own-numbers(id)
    =
if clobbers-flags(opcode)
    flags = 0
. dest = single-def(id)
if dest == no-operand
    give-own-numbers(id)
    =
. vreg = vreg-id(function, dest)
if numbers[vreg] != 0
    =
number-def(block, id, opcode, dest, vreg)

────────────────────
_ do single-def OperandId
    - id InstructionId

. operands = function.instructions[id].operands
if operands.length == 0 || (role-at(function.operand-roles(id), 0) /and/ def-role) == 0
    = no-operand
for position in 1 .. < operands.length
    if (role-at(function.operand-roles(id), position) /and/ def-role) != 0
        = no-operand
. vreg = vreg-id(function, operands[0])
if vreg == no-id || vreg >= vreg-limit || definitions[vreg] != 1
    = no-operand
= operands[0]

────────────────────
_ do mark-defs
    - id InstructionId

. roles = function.operand-roles(id)
. operands = function.instructions[id].operands
for position in 0 .. < operands.length
    if (role-at(roles, position) /and/ def-role) == 0
        continue
    . vreg = vreg-id(function, operands[position])
    if vreg != no-id && vreg < vreg-limit
        visited-defs[vreg] = 1

────────────────────
_ do give-own-numbers
    - id InstructionId

. roles = function.operand-roles(id)
. operands = function.instructions[id].operands
for position in 0 .. < operands.length
    if (role-at(roles, position) /and/ def-role) == 0
        continue
    . vreg = vreg-id(function, operands[position])
    if vreg != no-id && vreg < vreg-limit && numbers[vreg] == 0
        numbers[vreg] = vreg + 1

────────────────────
_ do number-of-vreg U32
    - vreg U32

if numbers[vreg] == 0
    numbers[vreg] = vreg + 1
= numbers[vreg]

────────────────────
_ do encode Bool
    - operand OperandId

if operand == no-operand
    = false
do match? function.operands[operand]
    | .vreg-operand(row)
        . vreg = function.vregs[row.vreg].id
        if vreg >= vreg-limit || definitions[vreg] > 1
            = false
        encoded-tag = 1
        encoded-value = ((number-of-vreg(vreg) as U64) /lshift/ 4) /or/ class-bits
        .. class-bits = function.vregs[row.vreg].reg-class as U64
        = true
    | .int-operand(row)
        encoded-tag = if row.value.is-negative then 3 else 2
        encoded-value = row.value.bits
        = true
    | .cond-operand(row)
        encoded-tag = 4
        encoded-value = row.code as U64
        = true
    | .shift-operand(row)
        encoded-tag = 5
        encoded-value = ((row.kind as U64) /lshift/ 32) /or/ (row.amount as U64)
        = true
    | .frame-object-operand(row)
        encoded-tag = 6
        encoded-value = row.object as U64
        = true
= false

────────────────────
_ do build-key Bool
    - id InstructionId
    - opcode Opcode
    - class U64

` Sets the key of an instruction's value from its opcode, the class it defines and what it
` reads; a load also keys on the generation of memory, and a reader of the flags on their
` number.
. operands = function.instructions[id].operands
. count = operands.length
if count < 2 || count > 4
    = false
key-head = (opcode as U64) /or/ (class /lshift/ 8)
key-first = 0
key-second = 0
key-third = 0
. slot U32
for position in 1 .. < count
    . operand = operands[position]
    do match? function.operands[operand]
        | .load-address-operand(address)
            if address.is-pre-index || position != 1 || count != 2
                = false
            if !encode(address.base)
                = false
            set-slot(0, encoded-tag, encoded-value)
            if address.offset == no-operand
                set-slot(1, 2, 0)
            else
                if !encode(address.offset)
                    = false
                set-slot(1, encoded-tag, encoded-value)
            key-head = key-head /or/ ((address.index-shift as U64) /lshift/ 24)
            slot = 2
            continue
    if slot > 2 || !encode(operand)
        = false
    set-slot(slot, encoded-tag, encoded-value)
    slot += 1
if is-load-opcode(opcode)
    key-head = key-head /or/ ((generation as U64) /lshift/ 32)
if reads-flags(opcode)
    if flags == 0
        = false
    key-head = key-head /or/ ((flags as U64) /lshift/ 32)
= true

────────────────────
_ do set-slot
    - slot U32
    - tag U64
    - value U64

key-head = key-head /or/ (tag /lshift/ (12 + slot * 4))
if slot == 0
    key-first = value
else if slot == 1
    key-second = value
else
    key-third = value

────────────────────
_ do find-slot U32

. hash = partial-hash + key-second * 0x165667b19e3779f9 + key-third * 0x27d4eb2f165667c5
    .. partial-hash = key-head * 0x9e3779b97f4a7c15 + key-first * 0xc2b2ae3d27d4eb4f
hash = hash /xor/ (hash /zrshift/ 29)
. slot = (hash as U32) /and/ mask
while slot-numbers[slot] != 0
    if heads[slot] == key-head && firsts[slot] == key-first && same-tail
        = slot
    .. same-tail = seconds[slot] == key-second && thirds[slot] == key-third
    slot = (slot + 1) /and/ mask
= slot

────────────────────
_ do fill-slot
    - slot U32
    - number U32
    - leader OperandId
    - block BlockId

heads[slot] = key-head
firsts[slot] = key-first
seconds[slot] = key-second
thirds[slot] = key-third
slot-numbers[slot] = number
slot-leaders[slot] = leader
slot-blocks[slot] = block

────────────────────
_ do fresh-number U32

if next-number > number-limit
    = 0
. number = next-number
next-number += 1
= number

────────────────────
_ do synthetic-number U32

` The number of the current key, given one when it has none, for a value no register holds.
. slot = find-slot()
if slot-numbers[slot] != 0
    = slot-numbers[slot]
. number = fresh-number()
if number != 0
    fill-slot(slot, number, no-operand, no-id)
= number

────────────────────
_ do compare-number U32
    - id InstructionId
    - opcode Opcode

. operands = function.instructions[id].operands
if operands.length != 2 || !encode(operands[0])
    = 0
key-head = (opcode as U64) /or/ (encoded-tag /lshift/ 12)
key-first = encoded-value
key-second = 0
key-third = 0
if !encode(operands[1])
    = 0
key-head = key-head /or/ (encoded-tag /lshift/ 16)
key-second = encoded-value
= synthetic-number()

────────────────────
_ do condition-number U32
    - code U32

` The number of the truth of condition `code`, or of its inverse, on the flags.
if flags == 0 || code >= 14
    = 0
key-head = (Opcode.cset as U64) /or/ ((8 as U64) /lshift/ 12) /or/ ((flags as U64) /lshift/ 32)
key-first = (code /and/ 0xfffffffe) as U64
key-second = 0
key-third = 0
= synthetic-number()

────────────────────
_ do number-def
    - block BlockId
    - id InstructionId
    - opcode Opcode
    - dest OperandId
    - vreg U32

. own = vreg + 1
. row = vreg-row(function, dest)
. class = function.vregs[row].reg-class
. operands = function.instructions[id].operands
if (is-move || zero-extends) && operands.length == 2 && copies(dest, operands[1], opcode)
    numbers[vreg] = number-of-operand(operands[1])
    =
.. is-move = opcode == .mov || opcode == .fmov
.. zero-extends = opcode == .uxtb || opcode == .uxth || opcode == .uxtw
if !build-key(id, opcode, class)
    numbers[vreg] = own
    if opcode == .cset
        booleans[own] = 1
    =
. slot = find-slot()
if slot-numbers[slot] == 0
    fill-slot(slot, own, dest, block)
    numbers[vreg] = own
    note-truth(own, opcode, operands)
    =
. number = slot-numbers[slot]
numbers[vreg] = number
. leader = slot-leaders[slot]
if leader != no-operand && truths[number] == 0 && replaceable
    rewrite-assembly(function, id, builder.copy-opcode(dest), pair(arena, dest, leader))
    changed = true
    =
.. replaceable = is-replaceable(opcode, dest, leader) && dominates(slot-blocks[slot], block)
slot-leaders[slot] = dest
slot-blocks[slot] = block

────────────────────
_ do number-of-operand U32
    - operand OperandId

. vreg = vreg-id(function, operand)
if vreg == no-id || vreg >= vreg-limit
    = 0
= number-of-vreg(vreg)

────────────────────
_ do copies Bool
    - dest OperandId
    - source OperandId
    - opcode Opcode

` Whether an instruction gives `dest` the very value of `source`: a copy within one class whose
` value fills it, or an extension of a value that is zero or one.
. source-row = vreg-row(function, source)
. dest-row = vreg-row(function, dest)
if source-row == no-id || dest-row == no-id
    = false
. vreg = function.vregs[source-row].id
if vreg >= vreg-limit || definitions[vreg] > 1
    = false
. class = function.vregs[dest-row].reg-class
if function.vregs[source-row].reg-class != class
    = false
if opcode == .mov || opcode == .fmov
    = class == .gpr64 || class == .fpr64 || def-classes[vreg] == ((class as U32) + 1) as Byte
= booleans[number-of-vreg(vreg)] != 0

────────────────────
_ is-replaceable Bool
    - opcode Opcode
    - dest OperandId
    - leader OperandId

|? opcode == .movz || opcode == .movn || opcode == .adr || opcode == .adrp
    false
|? dest-row == no-id || leader-row == no-id
    false
??
    dest-reg.reg-class == leader-reg.reg-class && dest-reg.gc-root == leader-reg.gc-root

.. dest-row = vreg-row(function, dest)
.. leader-row = vreg-row(function, leader)
.. dest-reg = function.vregs[dest-row]
.. leader-reg = function.vregs[leader-row]

────────────────────
_ do note-truth
    - number U32
    - opcode Opcode
    - operands IdList

if opcode == .cset && operands.length == 2
    booleans[number] = 1
    do match? function.operands[operands[1]]
        | .cond-operand(cond)
            . base = condition-number(cond.code)
            if base != 0
                truths[number] = base
                negated[number] = (cond.code /and/ 1) as Byte
    =
if operands.length == 2 && (opcode == .uxtb || opcode == .uxth || opcode == .uxtw)
    . source = number-of-operand(operands[1])
    if source != 0 && booleans[source] != 0
        booleans[number] = 1
        truths[number] = truths[source]
        negated[number] = negated[source]
    =
if operands.length != 3
    =
. left = number-of-operand(operands[1])
if left == 0 || booleans[left] == 0
    =
if opcode == .eor
    . known = known-int(function, operands[2])
    if known.is-known && known.bits == 1
        booleans[number] = 1
        truths[number] = if truths[left] != 0 then truths[left] else left
        negated[number] = if truths[left] != 0 then (1 - (negated[left] as U32)) as Byte else 1
    =
. right = number-of-operand(operands[2])
if (opcode == .and || opcode == .orr) && right != 0 && booleans[right] != 0
    booleans[number] = 1

────────────────────
_ do visit-phi
    - block BlockId
    - id InstructionId

do match? function.instructions[id]
    | .phi-instruction(phi)
        . row = vreg-row(function, phi.reg)
        if row == no-id
            =
        . vreg = function.vregs[row].id
        if vreg >= vreg-limit || numbers[vreg] != 0
            =
        visited-defs[vreg] = 1
        . own = vreg + 1
        if definitions[vreg] != 1 || phi.exprs.length == 0
            numbers[vreg] = own
            =
        . class = function.vregs[row].reg-class as U64
        . first = phi-input(phi.exprs[0])
        . same = first != 0
        for entry in 1 .. < phi.exprs.length
            if phi-input(phi.exprs[entry]) != first
                same = false
        if same && first /zrshift/ 60 == 1 && (first /and/ 15) == class
            numbers[vreg] = number-of-operand(phi.exprs[0])
            =
        if !diamond-key(block, phi, class)
            numbers[vreg] = own
            =
        . slot = find-slot()
        if slot-numbers[slot] == 0
            fill-slot(slot, own, phi.reg, block)
            numbers[vreg] = own
            =
        numbers[vreg] = slot-numbers[slot]
        . leader = slot-leaders[slot]
        if leader != no-operand && is-replaceable(.phi, phi.reg, leader) && leader-dominates
            replaced-phis = replaced-phis.appended(arena, id)
            replacing-moves = replacing-moves.appended
                - arena
                - builder.new-assembly(builder.copy-opcode(phi.reg), phi.reg, leader)
            changed = true
            =
        .. leader-dominates = dominates(slot-blocks[slot], block)
        slot-leaders[slot] = phi.reg
        slot-blocks[slot] = block

────────────────────
_ do phi-input U64
    - operand OperandId

` The key of a phi's input: its number and class, or its constant, with a tag above both.
. vreg = vreg-id(function, operand)
if vreg != no-id && vreg < vreg-limit && definitions[vreg] != 0 && visited-defs[vreg] == 0
    = 0
if !encode(operand) || (encoded-tag != 1 && encoded-value /zrshift/ 56 != 0)
    = 0
= (encoded-tag /lshift/ 60) /or/ encoded-value

────────────────────
_ do diamond-key Bool
    - block BlockId
    - phi PhiInstruction
    - class U64

` Keys a phi at the join of a diamond, or of a triangle, by its branch's condition and the value
` each side gives.
. predecessors = function.blocks[block].predecessors
if phi.exprs.length != 2 || predecessors.length != 2
    = false
. head = doms[block]
if head == no-id
    = false
. key = branch-keys[head]
if key == 0
    = false
. taken = branch-taken[head]
. fallen = branch-fallen[head]
. taken-value U64
. fallen-value U64
for entry in 0 .. < 2
    . source = builder.get-block(phi.blocks[entry])
    if source == no-id
        = false
    . value = phi-input(phi.exprs[entry])
    if value == 0
        = false
    if source == head
        if block == taken
            taken-value = value
        else if block == fallen
            fallen-value = value
        else
            = false
    else if is-arm(taken, head) && dominates(taken, source)
        taken-value = value
    else if is-arm(fallen, head) && dominates(fallen, source)
        fallen-value = value
    else
        = false
if taken-value == 0 || fallen-value == 0
    = false
. holding = if branch-negated[head] != 0 then fallen-value else taken-value
. failing = if branch-negated[head] != 0 then taken-value else fallen-value
key-head = (Opcode.phi as U64) /or/ (class /lshift/ 8) /or/ ((7 as U64) /lshift/ 12)
key-first = key as U64
key-second = holding
key-third = failing
= true

────────────────────
_ is-arm Bool
    - block BlockId
    - head BlockId

predecessors.length == 1 && predecessors[0] == head && block != head

.. predecessors = function.blocks[block].predecessors

────────────────────
_ do place-replacements
    - block BlockId

. instructions = function.blocks[block].instructions
. kept = new-id-list(arena, instructions.length + 1)
. placed = false
for index in 0 .. < instructions.length
    . id = instructions[index]
    . opcode = function.instructions[id].opcode
    if !placed && opcode != .phi && opcode != .comment
        for entry in 0 .. < replacing-moves.length
            kept = kept.appended(arena, replacing-moves[entry])
        placed = true
    . is-replaced = false
    for entry in 0 .. < replaced-phis.length
        if replaced-phis[entry] == id
            is-replaced = true
    if !is-replaced
        kept = kept.appended(arena, id)
if !placed
    for entry in 0 .. < replacing-moves.length
        kept = kept.appended(arena, replacing-moves[entry])
function.blocks[block].instructions = kept

────────────────────
_ do settle-branch
    - block BlockId

. instructions = function.blocks[block].instructions
. last-index = previous-real(function, instructions, instructions.length)
if last-index == no-id
    =
. last = instructions[last-index]
if function.instructions[last].opcode != .b || function.instructions[last].operands.length != 1
    =
. fallen = builder.get-block(label-name(function, first-operand(function, last)))
if fallen == no-id
    =
. test-index = previous-real(function, instructions, last-index)
. test = if test-index == no-id then no-id else instructions[test-index]
. test-opcode = if test == no-id then Opcode.nop else function.instructions[test].opcode
if test-opcode != .cbz && test-opcode != .cbnz && test-opcode != .b-cond
    record-implied(block, fallen)
    =
. taken = builder.get-block(label-name(function, conditional-branch-target(function, test)))
if taken == no-id
    =
. leading = IdList(instructions.data, test-index, instructions.capacity)
if names-block(function, leading, function.blocks[taken].name) || names-fallen
    =
.. names-fallen = names-block(function, leading, function.blocks[fallen].name)
if taken == fallen
    fold(block, test-index, taken, no-id)
    =
. key U32
. is-negated = false
. operands = function.instructions[test].operands
if test-opcode == .b-cond
    if operands.length < 2
        =
    do match? function.operands[operands[1]]
        | .cond-operand(cond)
            key = condition-number(cond.code)
            is-negated = (cond.code /and/ 1) != 0
else
    . tested = vreg-id(function, operands[0])
    if tested == no-id || tested >= vreg-limit || definitions[tested] > 1
        =
    . number = number-of-vreg(tested)
    key = if truths[number] != 0 then truths[number] else number
    is-negated = if truths[number] != 0 then negated[number] != 0 else false
    if test-opcode == .cbz
        is-negated = !is-negated
if key == 0
    =
if facts[key] != 0
    . takes = (facts[key] == 1) != is-negated
    fold(block, test-index, if takes then taken else fallen, if takes then fallen else taken)
    =
branch-keys[block] = key
branch-negated[block] = if is-negated then 1 else 0
branch-taken[block] = taken
branch-fallen[block] = fallen

────────────────────
_ do fold
    - block BlockId
    - test-index U32
    - kept-target BlockId
    - dropped BlockId

` Removes a branch's test so that the block only jumps to `kept-target`, the edge to `dropped`
` going with it.
retarget(block, test-index, kept-target)
if dropped != no-id && dropped != kept-target
    drop-edge(block, dropped)
keep-one-edge(block, kept-target)
changed = true

────────────────────
_ do retarget
    - block BlockId
    - test-index U32
    - target BlockId

. instructions = function.blocks[block].instructions
. rebuilt = new-id-list(arena, instructions.length)
for index in 0 .. < instructions.length
    if index != test-index
        rebuilt = rebuilt.appended(arena, instructions[index])
. last-index = previous-real(function, rebuilt, rebuilt.length)
rewrite-assembly
    - function
    - rebuilt[last-index]
    - .b
    - IdList().appended(arena, builder.label(function.blocks[target].name))
function.blocks[block].instructions = rebuilt

────────────────────
_ do drop-edge
    - block BlockId
    - target BlockId

. successors = function.blocks[block].successors
. kept = IdList()
for index in 0 .. < successors.length
    if successors[index] != target
        kept = kept.appended(arena, successors[index])
function.blocks[block].successors = kept
. predecessors = function.blocks[target].predecessors
. remaining = IdList()
for index in 0 .. < predecessors.length
    if predecessors[index] != block
        remaining = remaining.appended(arena, predecessors[index])
function.blocks[target].predecessors = remaining
drop-phi-inputs(target, function.blocks[block].name)

────────────────────
_ do keep-one-edge
    - block BlockId
    - target BlockId

. successors = function.blocks[block].successors
. kept = IdList()
. seen = false
for index in 0 .. < successors.length
    if successors[index] == target
        if seen
            continue
        seen = true
    kept = kept.appended(arena, successors[index])
if !seen
    kept = kept.appended(arena, target)
function.blocks[block].successors = kept
. predecessors = function.blocks[target].predecessors
. listed = IdList()
. found = false
for index in 0 .. < predecessors.length
    if predecessors[index] == block
        if found
            continue
        found = true
    listed = listed.appended(arena, predecessors[index])
if !found
    listed = listed.appended(arena, block)
function.blocks[target].predecessors = listed

────────────────────
_ do drop-phi-inputs
    - block BlockId
    - source StringId

. instructions = function.blocks[block].instructions
for index in 0 .. < instructions.length
    do match? function.instructions[instructions[index]]
        | .phi-instruction(phi)
            . kept U32
            for entry in 0 .. < phi.blocks.length
                if phi.blocks[entry] != source
                    phi.exprs.data[kept] = phi.exprs[entry]
                    phi.blocks.data[kept] = phi.blocks[entry]
                    kept += 1
            phi.exprs = IdList(phi.exprs.data, kept, phi.exprs.capacity)
            phi.blocks = IdList(phi.blocks.data, kept, phi.blocks.capacity)

────────────────────
_ do collapse-empty-branches Bool

` Turns a branch whose sides are empty, and give the block they join the same values, into a jump
` to that block.
. any = false
. order = function.block-order
for position in 0 .. < order.length
    . block = order[position]
    . instructions = function.blocks[block].instructions
    . last-index = previous-real(function, instructions, instructions.length)
    if last-index == no-id
        continue
    . last = instructions[last-index]
    if function.instructions[last].opcode != .b
        continue
    . test-index = previous-real(function, instructions, last-index)
    if test-index == no-id
        continue
    . test = instructions[test-index]
    . test-opcode = function.instructions[test].opcode
    if test-opcode != .cbz && test-opcode != .cbnz && test-opcode != .b-cond
        continue
    . taken = builder.get-block(label-name(function, conditional-branch-target(function, test)))
    . fallen = builder.get-block(label-name(function, first-operand(function, last)))
    if taken == no-id || fallen == no-id
        continue
    . leading = IdList(instructions.data, test-index, instructions.capacity)
    if names-block(function, leading, function.blocks[taken].name) || names-fallen
        continue
    .. names-fallen = names-block(function, leading, function.blocks[fallen].name)
    . join = forwarded(taken, block)
    if join != forwarded(fallen, block) || join == block
        continue
    . taken-source = if taken != join then taken else block
    . fallen-source = if fallen != join then fallen else block
    if !gives-same(join, function.blocks[taken-source].name, function.blocks[fallen-source].name)
        continue
    merge-sources(join, block, taken-source, fallen-source)
    retarget(block, test-index, join)
    . successors = function.blocks[block].successors
    . kept = IdList()
    for index in 0 .. < successors.length
        if successors[index] != taken && successors[index] != fallen && successors[index] != join
            kept = kept.appended(arena, successors[index])
    function.blocks[block].successors = kept.appended(arena, join)
    any = true
= any

────────────────────
_ forwarded BlockId
    - target BlockId
    - block BlockId

` Where an empty block that only `block` reaches jumps to, or `target` itself.
|? target == block
    target
|? predecessors.length != 1 || predecessors[0] != block
    target
|? last-index == no-id || previous-real(function, instructions, last-index) != no-id
    target
|? function.instructions[last].opcode != .b
    target
|? next == no-id
    target
??
    next

.. predecessors = function.blocks[target].predecessors
.. instructions = function.blocks[target].instructions
.. last-index = previous-real(function, instructions, instructions.length)
.. last = instructions[last-index]
.. next = builder.get-block(label-name(function, first-operand(function, last)))

────────────────────
_ do gives-same Bool
    - join BlockId
    - first StringId
    - second StringId

. instructions = function.blocks[join].instructions
for index in 0 .. < instructions.length
    do match? function.instructions[instructions[index]]
        | .phi-instruction(phi)
            . left = no-operand
            . right = no-operand
            for entry in 0 .. < phi.blocks.length
                if phi.blocks[entry] == first
                    left = phi.exprs[entry]
                if phi.blocks[entry] == second
                    right = phi.exprs[entry]
            if left == no-operand || right == no-operand || different
                = false
            .. different = left != right && !same-operand(function, left, right)
= true

────────────────────
_ do merge-sources
    - join BlockId
    - block BlockId
    - taken-source BlockId
    - fallen-source BlockId

` Makes `block` the one predecessor of `join` in place of the sides it is about to skip.
. name = function.blocks[block].name
. taken-name = function.blocks[taken-source].name
. fallen-name = function.blocks[fallen-source].name
. instructions = function.blocks[join].instructions
for index in 0 .. < instructions.length
    do match? function.instructions[instructions[index]]
        | .phi-instruction(phi)
            . value = no-operand
            . kept U32
            for entry in 0 .. < phi.blocks.length
                . source = phi.blocks[entry]
                if source == taken-name || source == fallen-name || source == name
                    value = phi.exprs[entry]
                    continue
                phi.exprs.data[kept] = phi.exprs[entry]
                phi.blocks.data[kept] = source
                kept += 1
            phi.exprs = IdList(phi.exprs.data, kept, phi.exprs.capacity).appended(arena, value)
            phi.blocks = IdList(phi.blocks.data, kept, phi.blocks.capacity).appended(arena, name)
. predecessors = function.blocks[join].predecessors
. listed = IdList()
for index in 0 .. < predecessors.length
    . predecessor = predecessors[index]
    if predecessor != taken-source && predecessor != fallen-source && predecessor != block
        listed = listed.appended(arena, predecessor)
function.blocks[join].predecessors = listed.appended(arena, block)

━━━━━━━━━━━━━━━━━━━━
_ do names-block Bool
    - function MIRFunction
    - instructions IdList
    - name StringId

for index in 0 .. < instructions.length
    . id = instructions[index]
    . operands = function.instructions[id].operands
    for entry in 0 .. < operands.length
        if label-name(function, operands[entry]) == name
            = true
    do match? function.instructions[id]
        | .call-instruction(call)
            if label-name(function, call.panic-target) == name
                = true
= false

━━━━━━━━━━━━━━━━━━━━
_ keeps-memory Bool
    - opcode Opcode

` Whether an instruction leaves memory as it was, and orders nothing around it.
|? is-pure-def(opcode) || is-flag-compare(opcode) || is-branch-opcode(opcode) || is-load
    true
??
    opcode == .ldp || opcode == .movk || opcode == .fmov || opcode == .adr || opcode == .adrp || opcode == .addptr || opcode == .phi || opcode == .comment || opcode == .nop || opcode == .inlined-name || opcode == .br || opcode == .ret || opcode == .ccmp || opcode == .bfi

.. is-load = is-load-opcode(opcode)

━━━━━━━━━━━━━━━━━━━━
_ is-load-opcode Bool @inline
    - opcode Opcode

plain-load || opcode == .ldrsw || opcode == .ldrsb || opcode == .ldrsh

.. plain-load = opcode == .ldr || opcode == .ldrb || opcode == .ldrh

━━━━━━━━━━━━━━━━━━━━
+ MIRIfConversionPass

` Turns each small diamond or triangle that a conditional branch opens and a phi closes into
` straight code, while the function is still in SSA form. The blocks on either side may hold only
` a couple of pure instructions, which then run on both paths, and each phi whose inputs differ
` becomes a CSEL or FCSEL on the branch's condition. A side that only compares and sets a flag,
` against a constant the other path gives, becomes CCMP, so that `a && b` and `a || b` are one
` comparison chained to another. A block whose only predecessor jumps to it, as a join left with
` one predecessor does, is merged into that predecessor.

_ builder MIRBuilder
_ function MIRFunction
_ definitions CPointer'U32
_ definers CPointer'U32
_ dead CPointer'Byte
_ phis IdList
_ taken-values IdList
_ fallen-values IdList
_ resolved IdList
_ vreg-limit U32

────────────────────
+ This
    - builder MIRBuilder

.. function = builder.function

────────────────────
+ do run Bool

. changed = false
for _ in 0 .. < 4
    . arena = function.arena
    vreg-limit = function.vreg-count
    definitions = arena.allocate'U32(vreg-limit)
    definers = arena.allocate'U32(vreg-limit)
    dead = arena.allocate'Byte(function.blocks.length)
    . order = function.block-order
    for position in 0 .. < order.length
        . instructions = function.blocks[order[position]].instructions
        for index in 0 .. < instructions.length
            note-definitions(instructions[index])
    . converted = false
    for position in 0 .. < order.length
        if merge-chain(order[position])
            converted = true
        if convert(order[position])
            converted = true
    if !converted
        break
    builder.prune-unreachable-blocks()
    changed = true
= changed

────────────────────
_ do note-definitions
    - id InstructionId

do match? function.instructions[id]
    | .phi-instruction(phi)
        note-definition(id, phi.reg)
        =
. roles = function.operand-roles(id)
. operands = function.instructions[id].operands
for position in 0 .. < operands.length
    if (role-at(roles, position) /and/ def-role) == 0
        continue
    do match? function.operands[operands[position]]
        | .vreg-operand
            note-definition(id, operands[position])
        | .vreg-group-operand(group)
            for index in group.vregs.start .. < group.vregs.end
                . vreg = function.vregs[function.group-vregs[index]].id
                if vreg < vreg-limit
                    definitions[vreg] = definitions[vreg] + 1
        | .load-address-operand(address)
            . base = vreg-id(function, address.base)
            if base != no-id && base < vreg-limit
                definitions[base] = definitions[base] + 1

────────────────────
_ do note-definition
    - id InstructionId
    - operand OperandId

. vreg = vreg-id(function, operand)
if vreg != no-id && vreg < vreg-limit
    definitions[vreg] = definitions[vreg] + 1
    definers[vreg] = id

────────────────────
_ do convert Bool
    - block BlockId

if dead[block] != 0 || function.blocks[block].successors.length != 2
    = false
. instructions = function.blocks[block].instructions
. jump-index = previous-real(function, instructions, instructions.length)
if jump-index == no-id
    = false
. jump = instructions[jump-index]
if function.instructions[jump].opcode != .b || function.instructions[jump].operands.length != 1
    = false
. test-index = previous-real(function, instructions, jump-index)
if test-index == no-id
    = false
. test = instructions[test-index]
. test-opcode = function.instructions[test].opcode
if test-opcode != .cbz && test-opcode != .cbnz && test-opcode != .b-cond
    = false
. taken = builder.get-block(label-name(function, conditional-branch-target(function, test)))
. fallen = builder.get-block(label-name(function, first-operand(function, jump)))
if taken == no-id || fallen == no-id || taken == fallen || dead[taken] != 0 || dead[fallen] != 0
    = false
. taken-side = no-id
. fallen-side = no-id
. join = no-id
if is-side(taken, block) && is-side(fallen, block) && same-join
    taken-side = taken
    fallen-side = fallen
    join = side-successor(taken)
else if is-side(taken, block) && side-successor(taken) == fallen
    taken-side = taken
    join = fallen
else if is-side(fallen, block) && side-successor(fallen) == taken
    fallen-side = fallen
    join = taken
else
    = false
.. same-join = side-successor(taken) == side-successor(fallen)
if join == block || dead[join] != 0
    = false
. taken-source = if taken-side != no-id then taken-side else block
. fallen-source = if fallen-side != no-id then fallen-side else block
if !collect-phis(join, taken-source, fallen-source)
    = false

. condition = branch-condition(instructions, test-index, test)
. tested = function.instructions[test].operands[0]
. needs-compare = condition == no-operand
if needs-compare
    if test-opcode == .b-cond || !is-integer-vreg(tested)
        = false
    condition = builder.add-operand
        - CondOperand(if test-opcode == .cbnz then Condition.unequal else Condition.equal)
. inverse = invert-condition(builder, condition)
if inverse == no-operand
    = false
. taken-body = side-body(taken-side)
. fallen-body = side-body(fallen-side)
. merges = only-from && !names-block(function, leading, function.blocks[join].name)
    .. only-from = is-only-from(join, block, taken-side, fallen-side)
    .. leading = IdList(instructions.data, test-index, instructions.capacity)
. arena = function.arena
. emitted = new-id-list(arena, 8)
if is-speculable(taken-body) && is-speculable(fallen-body)
    for index in 0 .. < taken-body.length
        emitted = emitted.appended(arena, taken-body[index])
    for index in 0 .. < fallen-body.length
        emitted = emitted.appended(arena, fallen-body[index])
    if needs-compare
        emitted = emitted.appended(arena, builder.new-assembly(.cmp, tested, builder.small-int(0)))
    emitted = select-phis(emitted, condition, merges)
else if taken-side != no-id && fallen-body.length == 0 && is-compare-pair(taken-body)
    if needs-compare
        emitted = emitted.appended(arena, builder.new-assembly(.cmp, tested, builder.small-int(0)))
    emitted = chain(emitted, taken-body, condition)
else if fallen-side != no-id && taken-body.length == 0 && is-compare-pair(fallen-body)
    if needs-compare
        emitted = emitted.appended(arena, builder.new-assembly(.cmp, tested, builder.small-int(0)))
    emitted = chain(emitted, fallen-body, inverse)
else
    = false
if emitted.length == 0
    = false
finish(block, test-index, emitted, join, taken-side, fallen-side, merges)
= true

────────────────────
_ do collect-phis Bool
    - join BlockId
    - taken-source BlockId
    - fallen-source BlockId

. arena = function.arena
phis = IdList()
taken-values = IdList()
fallen-values = IdList()
resolved = IdList()
. taken-name = function.blocks[taken-source].name
. fallen-name = function.blocks[fallen-source].name
. instructions = function.blocks[join].instructions
for index in 0 .. < instructions.length
    . id = instructions[index]
    . opcode = function.instructions[id].opcode
    if opcode == .comment
        continue
    if opcode != .phi
        break
    . reg = no-operand
    . taken-value = no-operand
    . fallen-value = no-operand
    do match? function.instructions[id]
        | .phi-instruction(phi)
            reg = phi.reg
            for entry in 0 .. < phi.blocks.length
                if entry < phi.exprs.length && phi.blocks[entry] == taken-name
                    taken-value = phi.exprs[entry]
                if entry < phi.exprs.length && phi.blocks[entry] == fallen-name
                    fallen-value = phi.exprs[entry]
    . row = vreg-row(function, reg)
    if row == no-id || function.vregs[row].hint != no-register || missing-value
        = false
    .. missing-value = taken-value == no-operand || fallen-value == no-operand
    if vreg-row(function, taken-value) == no-id || vreg-row(function, fallen-value) == no-id
        = false
    phis = phis.appended(arena, id)
    taken-values = taken-values.appended(arena, taken-value)
    fallen-values = fallen-values.appended(arena, fallen-value)
    resolved = resolved.appended(arena, no-operand)
= true

────────────────────
_ do branch-condition OperandId
    - instructions IdList
    - test-index U32
    - test InstructionId

. opcode = function.instructions[test].opcode
. operands = function.instructions[test].operands
if opcode == .b-cond
    = operands[1]
. tested = vreg-id(function, operands[0])
if tested == no-id || tested >= vreg-limit || definitions[tested] != 1
    = no-operand
. definer = definers[tested]
if function.instructions[definer].opcode == .uxtb
    . source = vreg-id(function, function.instructions[definer].operands[1])
    if source == no-id || source >= vreg-limit || definitions[source] != 1
        = no-operand
    definer = definers[source]
if function.instructions[definer].opcode != .cset
    = no-operand
. position = no-id
for index in 0 .. < test-index
    if instructions[index] == definer
        position = index
if position == no-id
    = no-operand
for index in position + 1 .. < test-index
    if clobbers-flags(function.instructions[instructions[index]].opcode)
        = no-operand
. condition = function.instructions[definer].operands[1]
if opcode == .cbz
    = invert-condition(builder, condition)
= condition

────────────────────
_ is-side Bool
    - side BlockId
    - block BlockId

|? side == block || dead[side] != 0 || side == function.block-order[0]
    false
|? other-entry || successors.length != 1 || successors[0] == side
    false
|? last == no-id || function.instructions[last].opcode != .b
    false
??
    builder.get-block(label-name(function, first-operand(function, last))) == successors[0]

.. predecessors = function.blocks[side].predecessors
.. successors = function.blocks[side].successors
.. last = last-real(function, side)
.. other-entry = predecessors.length != 1 || predecessors[0] != block

────────────────────
_ side-successor BlockId
    - side BlockId

function.blocks[side].successors[0]

────────────────────
_ do side-body IdList
    - side BlockId

if side == no-id
    = IdList()
. arena = function.arena
. body = IdList()
. last = last-real(function, side)
. instructions = function.blocks[side].instructions
for index in 0 .. < instructions.length
    . id = instructions[index]
    if id != last && function.instructions[id].opcode != .comment
        body = body.appended(arena, id)
= body

────────────────────
_ do is-only-from Bool
    - join BlockId
    - block BlockId
    - taken-side BlockId
    - fallen-side BlockId

. predecessors = function.blocks[join].predecessors
for index in 0 .. < predecessors.length
    . predecessor = predecessors[index]
    if predecessor != block && predecessor != taken-side && predecessor != fallen-side
        = false
= join != function.block-order[0]

────────────────────
_ do is-speculable Bool
    - body IdList

if body.length > 2
    = false
for index in 0 .. < body.length
    . id = body[index]
    . is-assembly = false
    do match? function.instructions[id]
        | .assembly-instruction
            is-assembly = true
    . opcode = function.instructions[id].opcode
    if !is-assembly || !is-pure-def(opcode) || reads-flags(opcode) || is-costly
        = false
    .. is-costly = opcode == .sdiv || opcode == .udiv || opcode == .fdiv || opcode == .fsqrt
    . defined = function.instruction-def(id)
    if defined == no-id || hinted || beyond-limit || definitions[function.vregs[defined].id] != 1
        = false
    .. hinted = function.vregs[defined].hint != no-register
    .. beyond-limit = function.vregs[defined].id >= vreg-limit
= true

────────────────────
_ is-compare-pair Bool
    - body IdList

|? body.length != 2 || function.instructions[body[0]].opcode != .cmp || not-cset
    false
|? operands.length != 2 || !is-integer-vreg(operands[0])
    false
|? !is-integer-vreg(operands[1]) && (!value.is-known || value.is-negative || value.bits > 0xffff)
    false
??
    flag.length == 2 && vreg-row(function, flag[0]) != no-id

.. operands = function.instructions[body[0]].operands
.. value = known-int(function, operands[1])
.. flag = function.instructions[body[1]].operands
.. not-cset = function.instructions[body[1]].opcode != .cset

────────────────────
_ do select-phis IdList
    - emitted IdList
    - condition OperandId
    - merges Bool

. arena = function.arena
. result = emitted
for index in 0 .. < phis.length
    . taken-value = taken-values[index]
    . fallen-value = fallen-values[index]
    if same-operand(function, taken-value, fallen-value)
        resolved.data[index] = taken-value
        continue
    . reg = no-operand
    do match? function.instructions[phis[index]]
        | .phi-instruction(phi)
            reg = phi.reg
    . row = function.vregs[vreg-row(function, reg)]
    . dest = reg
    if !merges
        dest = builder.vreg-operand
            - builder.new-vreg
                - row.reg-class
                - no-register
                - row.gc-root
                - row.gc-descriptor
                - row.gc-root-mode
    . is-float = row.reg-class == .fpr32 || row.reg-class == .fpr64
    result = result.appended
        - arena
        - builder.new-assembly
            - if is-float then Opcode.fcsel else Opcode.csel
            - dest
            - taken-value
            - fallen-value
            - condition
    resolved.data[index] = dest
= result

────────────────────
_ do chain IdList
    - emitted IdList
    - body IdList
    - condition OperandId

. compare = body[0]
. flag = body[1]
. flag-dest = function.instructions[flag].operands[0]
. flag-vreg = vreg-id(function, flag-dest)
. constant = no-id
for index in 0 .. < phis.length
    . first = taken-values[index]
    . second = fallen-values[index]
    if same-operand(function, first, second)
        resolved.data[index] = first
        continue
    . other = no-operand
    if vreg-id(function, first) == flag-vreg
        other = second
    else if vreg-id(function, second) == flag-vreg
        other = first
    if other == no-operand || constant != no-id
        = IdList()
    constant = phi-constant(other)
    if constant == no-id
        = IdList()
    resolved.data[index] = flag-dest
if constant == no-id
    = IdList()
. nzcv = flags-for(condition-code(function, function.instructions[flag].operands[1]), constant)
if nzcv == no-id
    = IdList()
. arena = function.arena
. result = emitted
. operands = function.instructions[compare].operands
. right = operands[1]
. value = known-int(function, right)
if value.is-known && value.bits > 31
    right = builder.vreg-operand
        - builder.new-vreg(function.vregs[vreg-row(function, operands[0])].reg-class)
    result = result.appended
        - arena
        - builder.new-assembly
            - .movz
            - right
            - builder.small-int(value.bits as I64)
            - builder.small-int(0)
rewrite-assembly
    - function
    - compare
    - .ccmp
    - quad(arena, operands[0], right, builder.small-int(nzcv), condition)
result = result.appended(arena, compare)
= result.appended(arena, flag)

────────────────────
_ phi-constant U32
    - operand OperandId

|? vreg == no-id || vreg >= vreg-limit || definitions[vreg] != 1
    no-id
|? opcode != .movz || operands.length < 2
    no-id
|? operands.length > 2 && (!shift.is-known || shift.bits != 0)
    no-id
|? !value.is-known || value.is-negative || value.bits > 1
    no-id
??
    value.bits as U32

.. vreg = vreg-id(function, operand)
.. definer = definers[vreg]
.. opcode = function.instructions[definer].opcode
.. operands = function.instructions[definer].operands
.. shift = known-int(function, operands[2])
.. value = known-int(function, operands[1])

────────────────────
_ do finish
    - block BlockId
    - test-index U32
    - emitted IdList
    - join BlockId
    - taken-side BlockId
    - fallen-side BlockId
    - merges Bool

. arena = function.arena
. instructions = function.blocks[block].instructions
. kept = new-id-list(arena, instructions.length + emitted.length + 2)
for index in 0 .. < test-index
    kept = kept.appended(arena, instructions[index])
for index in 0 .. < emitted.length
    kept = kept.appended(arena, emitted[index])
if taken-side != no-id
    dead[taken-side] = 1
if fallen-side != no-id
    dead[fallen-side] = 1
. join-row = function.blocks[join]
. name = function.blocks[block].name
if merges
    for index in 0 .. < phis.length
        . reg = no-operand
        do match? function.instructions[phis[index]]
            | .phi-instruction(phi)
                reg = phi.reg
        if !same-operand(function, reg, resolved[index])
            kept = kept.appended
                - arena
                - builder.new-assembly(builder.copy-opcode(reg), reg, resolved[index])
    merge-into(block, join, kept)
    =
for index in 0 .. < phis.length
    set-phi-source(phis[index], taken-side, fallen-side, block, resolved[index])
kept = kept.appended(arena, builder.new-assembly(.b, builder.label(join-row.name)))
function.blocks[block].instructions = kept
function.blocks[block].successors = IdList().appended(arena, join)
. predecessors = join-row.predecessors
. listed = IdList()
for index in 0 .. < predecessors.length
    . predecessor = predecessors[index]
    if predecessor != taken-side && predecessor != fallen-side && predecessor != block
        listed = listed.appended(arena, predecessor)
function.blocks[join].predecessors = listed.appended(arena, block)

────────────────────
_ do merge-chain Bool
    - block BlockId

. merged = false
while dead[block] == 0 && function.blocks[block].successors.length == 1
    . instructions = function.blocks[block].instructions
    . jump-index = previous-real(function, instructions, instructions.length)
    if jump-index == no-id
        break
    . jump = instructions[jump-index]
    if function.instructions[jump].opcode != .b || function.instructions[jump].operands.length != 1
        break
    . join = function.blocks[block].successors[0]
    . predecessors = function.blocks[join].predecessors
    if join == block || dead[join] != 0 || join == function.block-order[0] || other-entry
        break
    .. other-entry = predecessors.length != 1 || predecessors[0] != block
    . join-name = function.blocks[join].name
    if jumps-elsewhere || names-block(function, leading, join-name)
        break
    .. jumps-elsewhere = label-name(function, first-operand(function, jump)) != join-name
    .. leading = IdList(instructions.data, jump-index, instructions.capacity)
    . arena = function.arena
    . kept = new-id-list(arena, instructions.length)
    for index in 0 .. < instructions.length
        if index != jump-index
            kept = kept.appended(arena, instructions[index])
    . name = function.blocks[block].name
    . joined = function.blocks[join].instructions
    . is-simple = true
    for index in 0 .. < joined.length
        do match? function.instructions[joined[index]]
            | .phi-instruction(phi)
                if phi.blocks.length != 1 || phi.exprs.length != 1 || phi.blocks[0] != name
                    is-simple = false
                else
                    kept = kept.appended
                        - arena
                        - builder.new-assembly(builder.copy-opcode(phi.reg), phi.reg, phi.exprs[0])
    if !is-simple
        break
    merge-into(block, join, kept)
    merged = true
= merged

────────────────────
_ do merge-into
    - block BlockId
    - join BlockId
    - kept IdList

. arena = function.arena
. merged = kept
. join-row = function.blocks[join]
. joined = join-row.instructions
for index in 0 .. < joined.length
    if function.instructions[joined[index]].opcode != .phi
        merged = merged.appended(arena, joined[index])
function.blocks[block].instructions = merged
function.blocks[block].successors = join-row.successors
. name = function.blocks[block].name
. successors = join-row.successors
for index in 0 .. < successors.length
    . successor = successors[index]
    . predecessors = function.blocks[successor].predecessors
    for entry in 0 .. < predecessors.length
        if predecessors[entry] == join
            predecessors.data[entry] = block
    rename-phi-source(successor, join-row.name, name)
function.blocks[join].predecessors = IdList()
function.blocks[join].successors = IdList()
dead[join] = 1

────────────────────
_ do set-phi-source
    - id InstructionId
    - taken-side BlockId
    - fallen-side BlockId
    - block BlockId
    - value OperandId

. arena = function.arena
. name = function.blocks[block].name
. taken-name = if taken-side != no-id then function.blocks[taken-side].name else no-string
. fallen-name = if fallen-side != no-id then function.blocks[fallen-side].name else no-string
do match? function.instructions[id]
    | .phi-instruction(phi)
        . exprs = IdList()
        . blocks = IdList()
        for entry in 0 .. < phi.blocks.length
            . source = phi.blocks[entry]
            if source == name || source == taken-name || source == fallen-name
                continue
            exprs = exprs.appended(arena, phi.exprs[entry])
            blocks = blocks.appended(arena, source)
        phi.exprs = exprs.appended(arena, value)
        phi.blocks = blocks.appended(arena, name)

────────────────────
_ do rename-phi-source
    - block BlockId
    - from StringId
    - to StringId

. instructions = function.blocks[block].instructions
for index in 0 .. < instructions.length
    do match? function.instructions[instructions[index]]
        | .phi-instruction(phi)
            for entry in 0 .. < phi.blocks.length
                if phi.blocks[entry] == from
                    phi.blocks.data[entry] = to

────────────────────
_ is-integer-vreg Bool
    - operand OperandId

row != no-id && (function.vregs[row].reg-class == .gpr32 || function.vregs[row].reg-class == .gpr64)

.. row = vreg-row(function, operand)

━━━━━━━━━━━━━━━━━━━━
_ do condition-code U32
    - function MIRFunction
    - operand OperandId

do match? function.operands[operand]
    | .cond-operand(row)
        = row.code
= no-condition

━━━━━━━━━━━━━━━━━━━━
_ do flags-for U32
    - code U32
    - value U32

if code == no-condition || code >= Condition.always
    = no-id
for nzcv in 0 .. < 16
    if holds-for(code, nzcv as U32) == (value != 0)
        = nzcv as U32
= no-id

━━━━━━━━━━━━━━━━━━━━
_ compare-flags U32
    - left U64
    - right U64
    - width U64

` The NZCV flags that comparing `left` with `right` at `width` bits sets.
(if negative then 8u32 else 0) /or/ (if low == high then 4 else 0) /or/ (if low >= high then 2 else 0) /or/ (if overflow then 1 else 0)

.. mask = if width == 32 then low-word else all-bits
.. low = left /and/ mask
.. high = right /and/ mask
.. sign = 1u64 /lshift/ (width - 1)
.. difference = (low - high) /and/ mask
.. negative = (difference /and/ sign) != 0
.. overflow = ((low /xor/ high) /and/ (low /xor/ difference) /and/ sign) != 0

━━━━━━━━━━━━━━━━━━━━
_ do holds-for Bool
    - code U32
    - nzcv U32

. negative = (nzcv /and/ 8) != 0
. zero = (nzcv /and/ 4) != 0
. carry = (nzcv /and/ 2) != 0
. overflow = (nzcv /and/ 1) != 0
. base = code /zrshift/ 1
. holds = true
if base == 0
    holds = zero
else if base == 1
    holds = carry
else if base == 2
    holds = negative
else if base == 3
    holds = overflow
else if base == 4
    holds = carry && !zero
else if base == 5
    holds = negative == overflow
else if base == 6
    holds = !zero && negative == overflow
= if (code /and/ 1) != 0 then !holds else holds

━━━━━━━━━━━━━━━━━━━━
+ MIRJumpThreadingPass

` Sends a block that jumps on to a conditional branch straight to the side that branch takes,
` when the constants it leaves settle the branch. With `orders`, a compare of two constants
` settles every condition a CSET reads after it; without, only whether they are equal.
_ builder MIRBuilder
_ function MIRFunction
_ orders Bool
_ constants CPointer'U64
_ is-constant CPointer'Byte
_ constant-ids IdList
_ constant-count U32
_ is-compared Bool
_ is-equal Bool
_ compared-left U64
_ compared-right U64
_ compared-width U64

────────────────────
+ This
    - builder MIRBuilder
    - orders Bool = true

.. function = builder.function

────────────────────
+ do run Bool

. arena = function.arena
. changed = false
constants = arena.allocate'U64(function.vreg-count)
is-constant = arena.allocate'Byte(function.vreg-count)
constant-ids = IdList()
constant-count = 0
is-compared = false
. visited = arena.allocate'U32(function.blocks.length)
. visit U32
. incoming = arena.allocate'U32(8)
. copied = new-id-list(arena, 64)
. order = function.block-order
for position in 0 .. < order.length
    . predecessor = order[position]
    . successors = function.blocks[predecessor].successors
    if successors.length != 1 || has-conditional-branch(predecessor)
        continue

    copied = IdList(copied.data, 0, copied.capacity)
    visit += 1
    visited[predecessor] = visit
    . visited-count U32 = 1
    . block = successors[0]
    . branch = no-id
    while visited-count <= 8 && copied.length <= 32
        if visited[block] == visit
            break
        visited[block] = visit
        visited-count += 1
        . is-stopped = false
        . instructions = function.blocks[block].instructions
        . block-successors = function.blocks[block].successors
        for index in 0 .. < instructions.length
            . id = instructions[index]
            . opcode = function.instructions[id].opcode
            if opcode == .b || opcode == .comment
                continue
            if opcode == .cbz || opcode == .cbnz
                if block-successors.length == 2
                    branch = id
                is-stopped = true
                break
            if !is-pure-def(opcode) && opcode != .cmp
                is-stopped = true
                break
            copied = copied.appended(arena, id)
        if is-stopped || block-successors.length != 1
            break
        block = block-successors[0]
    if branch == no-id || copied.length > 32
        continue
    . target-name = label-name(function, conditional-branch-target(function, branch))
    if target-name == no-string
        continue

    clear-constants()
    is-compared = false
    . incoming-count U32 = 1
    incoming[0] = predecessor
    while incoming-count < 8
        . predecessors = function.blocks[incoming[incoming-count - 1]].predecessors
        if predecessors.length != 1
            break
        . prior = predecessors[0]
        . is-repeated = false
        for index in 0 .. < incoming-count
            if incoming[index] == prior
                is-repeated = true
        if is-repeated
            break
        incoming[incoming-count] = prior
        incoming-count += 1
    . remaining = incoming-count
    while remaining > 0
        remaining -= 1
        . prior-instructions = function.blocks[incoming[remaining]].instructions
        for index in 0 .. < prior-instructions.length
            evaluate(prior-instructions[index])
    if constant-count == 0
        continue
    for index in 0 .. < copied.length
        evaluate(copied[index])
    . condition = value-of(function.instructions[branch].operands[0])
    if !condition.is-known
        continue

    . is-taken = condition.bits == 0
    if function.instructions[branch].opcode != .cbz
        is-taken = !is-taken
    . target = no-id
    . branch-successors = function.blocks[block].successors
    for index in 0 .. < branch-successors.length
        . candidate = branch-successors[index]
        if (function.blocks[candidate].name == target-name) == is-taken
            target = candidate
            break
    if target == no-id || visited[target] == visit
        continue

    . last = last-real(function, predecessor)
    if last != no-id && function.instructions[last].opcode == .b
        remove-instruction(function, predecessor, last)
    . threaded = function.blocks[predecessor].instructions
    for index in 0 .. < copied.length
        . copy = copy-instruction(copied[index])
        function.add-uses(copy)
        threaded = threaded.appended(arena, copy)
    threaded = threaded.appended
        - arena
        - builder.new-assembly(.b, builder.label(function.blocks[target].name))
    function.blocks[predecessor].instructions = threaded

    . previous = successors[0]
    . previous-predecessors = function.blocks[previous].predecessors
    . kept U32
    for index in 0 .. < previous-predecessors.length
        if previous-predecessors[index] != predecessor
            previous-predecessors.data[kept] = previous-predecessors[index]
            kept += 1
    function.blocks[previous].predecessors = IdList
        - previous-predecessors.data
        - kept
        - previous-predecessors.capacity
    function.blocks[predecessor].successors = IdList().appended(arena, target)
    if !includes(function.blocks[target].predecessors, predecessor)
        function.blocks[target].predecessors = function.blocks[target].predecessors.appended
            - arena
            - predecessor
    changed = true

if changed
    repair-predecessors(function)
    builder.prune-unreachable-blocks()
= changed

────────────────────
_ do has-conditional-branch Bool
    - block BlockId

. instructions = function.blocks[block].instructions
for index in 0 .. < instructions.length
    . opcode = function.instructions[instructions[index]].opcode
    if opcode == .b-cond || opcode == .cbz || opcode == .cbnz
        = true
= false

────────────────────
_ do copy-instruction InstructionId
    - id InstructionId

. arena = function.arena
. opcode Opcode = .nop
. operands IdList
. loc = no-loc
. position = no-position
. gc-free-zone = false
. gc-exceptional-safepoint = false
. gc-safepoint = false
. has-gc-roots = false
. gc-roots Span
. is-assembly = false
do match? function.instructions[id]
    | .assembly-instruction(row)
        is-assembly = true
        opcode = row.opcode
        operands = row.operands
        loc = row.loc
        position = row.position
        gc-free-zone = row.gc-free-zone
        gc-exceptional-safepoint = row.gc-exceptional-safepoint
        gc-safepoint = row.gc-safepoint
        has-gc-roots = row.has-gc-roots
        gc-roots = row.gc-roots
?! Panic("Jump threading copies an instruction that is not an assembly instruction")
    if !is-assembly
. copy = new-id-list(arena, operands.length)
for index in 0 .. < operands.length
    copy = copy.appended(arena, operands[index])
. copied InstructionId = function.instructions.length as InstructionId
function.instructions.append
    AssemblyInstruction
        - opcode
        - copy
        - loc
        - position
        - gc-free-zone
        - gc-exceptional-safepoint
        - gc-safepoint
        - false
        - has-gc-roots
        - gc-roots
= copied

────────────────────
_ do value-of Known
    - operand OperandId

if operand == no-operand
    = Known()
do match? function.operands[operand]
    | .int-operand(row)
        = Known(true, row.value.bits, row.value.is-negative)
    | .vreg-operand(row)
        . vreg = function.vregs[row.vreg].id
        if is-constant[vreg] != 0
            = Known(true, constants[vreg], false)
= Known()

────────────────────
_ do evaluate
    - id InstructionId

. opcode = function.instructions[id].opcode
. operands = function.instructions[id].operands
. dest = no-operand
. source = no-operand
. extra = no-operand
if operands.length > 0
    dest = operands[0]
if operands.length > 1
    source = operands[1]
if operands.length > 2
    extra = operands[2]
if opcode == .cmp
    . left = value-of(dest)
    . right = value-of(source)
    . row = vreg-row(function, dest)
    is-compared = left.is-known && right.is-known && (operands.length == 2 || !orders)
    is-equal = left.bits == right.bits && left.is-negative == right.is-negative
    compared-left = left.bits
    compared-right = right.bits
    compared-width = if is-narrow then 32 else 64
    .. is-narrow = row != no-id && class-mask(function.vregs[row].reg-class) == low-word
    =

. defined = function.instruction-def(id)
. input = value-of(source)
. is-known = false
. bits U64
. extension = extension-bits(opcode)
if opcode == .mov
    is-known = input.is-known
    bits = input.bits
else if opcode == .movz && input.is-known
    . shift = value-of(extra)
    ?! Panic("MOVZ shifts by a negative amount")
        if shift.is-known && shift.is-negative
    is-known = true
    if !shift.is-known
        bits = input.bits
    else if shift.bits < 64
        bits = input.bits /lshift/ shift.bits
else if opcode == .cset && is-compared && settles(condition-code(source))
    is-known = true
    if holds(condition-code(source))
        bits = 1
else if input.is-known && extension != 0
    is-known = true
    . mask U64 = (1u64 /lshift/ extension) - 1
    bits = input.bits /and/ mask
    if is-signed-extension(opcode) && (input.bits /and/ (1u64 /lshift/ (extension - 1))) != 0
        bits = bits /or/ (0xffffffffffffffff /xor/ mask)

if defined != no-id
    if function.vregs[defined].reg-class == .gpr32
        bits = bits /and/ 0xffffffff
    set-constant(function.vregs[defined].id, is-known, bits)
if opcode != .comment && !is-pure-def(opcode) && !is-branch-opcode(opcode)
    is-compared = false
    clear-constants()

────────────────────
_ settles Bool
    - code U32

|? orders
    code <= Condition.always
??
    code == Condition.equal || code == Condition.unequal

────────────────────
_ holds Bool
    - code U32

|? orders
    holds-for(code, compare-flags(compared-left, compared-right, compared-width))
??
    (code == Condition.equal) == is-equal

────────────────────
_ do condition-code U32
    - operand OperandId

if operand == no-operand
    = no-condition
do match? function.operands[operand]
    | .cond-operand(row)
        = row.code
= no-condition

────────────────────
_ do set-constant
    - vreg U32
    - is-known Bool
    - bits U64

if is-constant[vreg] != 0
    constant-count -= 1
    is-constant[vreg] = 0
if is-known
    constants[vreg] = bits
    is-constant[vreg] = 1
    constant-count += 1
    constant-ids = constant-ids.appended(function.arena, vreg)

────────────────────
_ do clear-constants

for index in 0 .. < constant-ids.length
    is-constant[constant-ids[index]] = 0
constant-ids = IdList(constant-ids.data, 0, constant-ids.capacity)
constant-count = 0

━━━━━━━━━━━━━━━━━━━━
+ MIRCFGCleanupPass

_ builder MIRBuilder
_ function MIRFunction

────────────────────
+ This
    - builder MIRBuilder

.. function = builder.function

────────────────────
+ do run Bool

. changed = false
for _ in 0 .. < 4
    . rewrote-branches = rewrite-branch-chains()
    . removed-blocks = remove-trivial-blocks()
    . removed-branches = remove-branches-to-layout-successor()
    . merged-blocks = merge-fallthrough-blocks()
    if !rewrote-branches && !removed-blocks && !removed-branches && !merged-blocks
        break
    changed = true
    builder.prune-unreachable-blocks()
= changed

────────────────────
_ do rewrite-branch-chains Bool

. changed = false
. order = function.block-order
for position in 0 .. < order.length
    . block = order[position]
    . instructions = function.blocks[block].instructions
    for index in 0 .. < instructions.length
        . id = instructions[index]
        if !is-branch-opcode(function.instructions[id].opcode)
            continue
        . operands = function.instructions[id].operands
        for entry in 0 .. < operands.length
            . name = label-name(function, operands[entry])
            if name == no-string
                continue
            . target = builder.get-block(name)
            if target == no-id
                continue
            . resolved = branch-chain-target(target)
            if resolved == no-id || function.blocks[resolved].name == name
                continue
            operands.data[entry] = builder.label(function.blocks[resolved].name)
            replace-successor(function, block, target, resolved)
            changed = true

for table in 0 .. < function.jump-tables.length
    . labels = function.jump-tables[table].labels
    for index in labels.start .. < labels.end
        . name = function.names[index]
        . target = builder.get-block(name)
        if target == no-id
            continue
        . resolved = branch-chain-target(target)
        if resolved != no-id && function.blocks[resolved].name != name
            function.names.data[index] = function.blocks[resolved].name
            changed = true
if changed
    repair-predecessors(function)
= changed

────────────────────
_ branch-chain-target BlockId
    - block BlockId

|? instruction == no-id || function.instructions[instruction].opcode != .b
    no-id
|? name == no-string || name == function.blocks[block].name
    no-id
??
    builder.get-block(name)

.. instruction = single-real(function, block)
.. name = label-name(function, first-operand(function, instruction))

────────────────────
_ do remove-trivial-blocks Bool

. changed = false
. order = function.block-order
. removed = function.arena.allocate'Byte(function.blocks.length)
for position in 1 .. < order.length
    . block = order[position]
    . predecessors = function.blocks[block].predecessors
    . successors = function.blocks[block].successors
    if predecessors.length == 0 || successors.length != 1
        continue
    . instruction = single-real(function, block)
    if instruction == no-id || function.instructions[instruction].opcode != .b
        continue
    . name = function.blocks[block].name
    . is-targeted = true
    for index in 0 .. < predecessors.length
        if !has-explicit-branch-to(function, predecessors[index], name)
            is-targeted = false
            break
    if !is-targeted
        continue
    . successor = successors[0]
    . successor-name = function.blocks[successor].name
    for index in 0 .. < predecessors.length
        rewrite-branch-label(builder, predecessors[index], name, successor-name)
        replace-successor(function, predecessors[index], block, successor)
    . dropped = function.blocks[block].instructions
    for index in 0 .. < dropped.length
        function.drop-uses(dropped[index])
    removed[block] = 1
    changed = true

if changed
    . kept U32
    for position in 0 .. < order.length
        if removed[order[position]] == 0
            order.data[kept] = order[position]
            kept += 1
    function.block-order = IdList(order.data, kept, order.capacity)
    repair-predecessors(function)
= changed

────────────────────
_ do remove-branches-to-layout-successor Bool

. changed = false
. order = function.block-order
for position in 1 .. < order.length
    . block = order[position - 1]
    . last = last-real(function, block)
    if last == no-id || function.instructions[last].opcode != .b
        continue
    . name = label-name(function, first-operand(function, last))
    if name != no-string && name == function.blocks[order[position]].name
        remove-instruction(function, block, last)
        changed = true
= changed

────────────────────
_ do merge-fallthrough-blocks Bool

` Joins each block to the one before it in the layout where that one is all that reaches it and
` it is all that one goes on to, so the passes that read one block at a time see them as one.
. changed = false
. order = function.block-order
. arena = function.arena
. removed = arena.allocate'Byte(function.blocks.length)
. host = order[0]
for position in 1 .. < order.length
    . block = order[position]
    . successors = function.blocks[host].successors
    . predecessors = function.blocks[block].predecessors
    if successors.length != 1 || successors[0] != block || other-entry
        host = block
        continue
    .. other-entry = predecessors.length != 1 || predecessors[0] != host
    . last = last-real(function, host)
    if last != no-id && is-branch-opcode(function.instructions[last].opcode)
        if function.instructions[last].opcode != .b
            host = block
            continue
        remove-instruction(function, host, last)
    . joined = function.blocks[host].instructions
    . moved = function.blocks[block].instructions
    for index in 0 .. < moved.length
        joined = joined.appended(arena, moved[index])
    function.blocks[host].instructions = joined
    function.blocks[block].instructions = IdList()
    function.blocks[host].successors = function.blocks[block].successors
    function.blocks[block].successors = IdList()
    removed[block] = 1
    changed = true

if changed
    . kept U32
    for position in 0 .. < order.length
        if removed[order[position]] == 0
            order.data[kept] = order[position]
            kept += 1
    function.block-order = IdList(order.data, kept, order.capacity)
    repair-predecessors(function)
= changed

━━━━━━━━━━━━━━━━━━━━
+ MIRBranchFoldingPass

` Skips the blocks that register allocation leaves only branching on, once their copies turned
` out to be from a register to itself: a branch to one goes on to where the chain of them leads,
` and one that nothing reaches any longer is dropped. A block that still falls into one, names it
` or lists it in a jump table keeps it.

_ builder MIRBuilder
_ function MIRFunction
_ targets CPointer'U32
_ tabled CPointer'Byte

────────────────────
+ This
    - builder MIRBuilder

.. function = builder.function

────────────────────
+ do run Bool

. arena = function.arena
. order = function.block-order
targets = arena.allocate'U32(function.blocks.length)
tabled = arena.allocate'Byte(function.blocks.length)
for table in 0 .. < function.jump-tables.length
    . labels = function.jump-tables[table].labels
    for index in labels.start .. < labels.end
        . target = builder.get-block(function.names[index])
        if target != no-id
            tabled[target] = 1
. changed = false
. sources = new-id-list(arena, 4)
. finals = new-id-list(arena, 4)
for position in 0 .. < order.length
    . block = order[position]
    sources = IdList(sources.data, 0, sources.capacity)
    finals = IdList(finals.data, 0, finals.capacity)
    . instructions = function.blocks[block].instructions
    for index in 0 .. < instructions.length
        . id = instructions[index]
        if !is-branch-opcode(function.instructions[id].opcode)
            continue
        . operands = function.instructions[id].operands
        for entry in 0 .. < operands.length
            . name = label-name(function, operands[entry])
            if name == no-string
                continue
            . target = builder.get-block(name)
            if target == no-id
                continue
            . resolved = folded-target(target)
            if resolved == target
                continue
            operands.data[entry] = builder.label(function.blocks[resolved].name)
            if !includes(sources, target)
                sources = sources.appended(arena, target)
                finals = finals.appended(arena, resolved)
            changed = true
    . next = if position + 1 < order.length then order[position + 1] else no-id
    for index in 0 .. < sources.length
        . source = sources[index]
        if source != next && tabled[source] == 0 && !names-label(block, source-name)
            replace-successor(function, block, source, finals[index])
        else if !includes(function.blocks[block].successors, finals[index])
            function.blocks[block].successors = function.blocks[block].successors.appended
                - arena
                - finals[index]
        .. source-name = function.blocks[source].name
if changed
    repair-predecessors(function)
    builder.prune-unreachable-blocks()
= changed

────────────────────
_ do names-label Bool
    - block BlockId
    - name StringId

. instructions = function.blocks[block].instructions
for index in 0 .. < instructions.length
    . operands = function.instructions[instructions[index]].operands
    for entry in 0 .. < operands.length
        if label-name(function, operands[entry]) == name
            = true
= false

────────────────────
_ do folded-target BlockId
    - block BlockId

if targets[block] != 0
    = targets[block] - 1
. current = block
for _ in 0 .. < 8
    . successor = branch-only-successor(current)
    if successor == no-id || successor == block
        break
    current = successor
targets[block] = current + 1
= current

────────────────────
_ branch-only-successor BlockId
    - block BlockId

|? block == function.block-order[0]
    no-id
|? instruction == no-id || !is-plain-branch(function, instruction)
    no-id
|? successors.length != 1 || target != function.blocks[successors[0]].name
    no-id
??
    successors[0]

.. instruction = single-real(function, block)
.. successors = function.blocks[block].successors
.. target = label-name(function, first-operand(function, instruction))

━━━━━━━━━━━━━━━━━━━━
+ MIRAddressFoldingPass

` Folds into each load and store the arithmetic that only makes its address. An address that adds
` a register is indexed by it, scaled by the access's size where a shift by that size made the
` index; one that adds a constant or a page offset takes it as its offset; and a copy that only
` names its base or its index is read through. Each instruction folded made a register the access
` alone read, and goes, so it must be the nearest writer of that register in the access's block,
` with what it read unchanged up to the access. A root is only replaced by a root.

_ builder MIRBuilder
_ function MIRFunction
_ removed CPointer'Byte

────────────────────
+ This
    - builder MIRBuilder

.. function = builder.function

────────────────────
+ do run Bool

function.count-uses()
removed = function.arena.allocate'Byte(function.instructions.length)
. changed = false
. order = function.block-order
for position in 0 .. < order.length
    . block = order[position]
    . instructions = function.blocks[block].instructions
    . folded = false
    for index in 0 .. < instructions.length
        if fold-access(instructions, index)
            folded = true
    if !folded
        continue
    changed = true
    . kept U32
    for index in 0 .. < instructions.length
        if removed[instructions[index]] == 0
            instructions.data[kept] = instructions[index]
            kept += 1
    function.blocks[block].instructions = IdList(instructions.data, kept, instructions.capacity)
= changed

────────────────────
_ do fold-access Bool
    - instructions IdList
    - index U32

. id = instructions[index]
if removed[id] != 0
    = false
. size = access-bytes(id)
if size == 0
    = false
. operands = function.instructions[id].operands
. changed = false
for _ in 0 .. < 6
    . folded = fold-address(instructions, index, operands[1], size)
    if folded == no-operand
        break
    function.drop-uses(id)
    operands.data[1] = folded
    function.add-uses(id)
    changed = true
= changed

────────────────────
_ access-bytes I64
    - id InstructionId

|? operands.length != 2
    0
|? opcode == .ldrb || opcode == .strb
    1
|? opcode == .ldrh || opcode == .strh
    2
|? opcode == .ldrsw
    4
|? opcode != .ldr && opcode != .str
    0
|? row == no-id
    0
|? reg-class == .gpr32 || reg-class == .fpr32
    4
??
    8

.. opcode = function.instructions[id].opcode
.. operands = function.instructions[id].operands
.. row = vreg-row(function, operands[0])
.. reg-class = function.vregs[row].reg-class

────────────────────
_ do fold-address OperandId
    - instructions IdList
    - index U32
    - address OperandId
    - size I64

. base = no-operand
. offset = no-operand
. index-shift U32
. is-plain = false
do match? function.operands[address]
    | .load-address-operand(row)
        is-plain = !row.is-pre-index
        base = row.base
        offset = row.offset
        index-shift = row.index-shift
if !is-plain || !is-wide-register(base)
    = no-operand
. has-index = is-wide-register(offset)
if !has-index && is-zero-offset(offset)
    . found = sum-definer(instructions, index, base)
    if found != no-id
        . definer = instructions[found]
        . left = function.instructions[definer].operands[1]
        . right = function.instructions[definer].operands[2]
        if is-wide-register(right)
            if keeps-root(base, left)
                = folded(definer, builder.load-address(left, right))
            if keeps-root(base, right)
                = folded(definer, builder.load-address(right, left))
        else if fits-offset(right, size) && keeps-root(base, left)
            = folded(definer, builder.load-address(left, right))
. base-found = copy-definer(instructions, index, base)
if base-found != no-id
    . source = function.instructions[instructions[base-found]].operands[1]
    = folded(instructions[base-found], builder.load-address(source, offset, false, index-shift))
if !has-index
    = no-operand
if index-shift == 0 && size > 1
    . shift-found = shift-definer(instructions, index, offset, size)
    if shift-found != no-id
        . shifted = function.instructions[instructions[shift-found]].operands[1]
        = folded
            - instructions[shift-found]
            - builder.load-address(base, shifted, false, log2(size as U64) as U32)
. index-found = copy-definer(instructions, index, offset)
if index-found != no-id
    . source = function.instructions[instructions[index-found]].operands[1]
    = folded(instructions[index-found], builder.load-address(base, source, false, index-shift))
= no-operand

────────────────────
_ sum-definer U32
    - instructions IdList
    - index U32
    - register OperandId

|? found == no-id
    no-id
|? not-add || operands.length != 3 || !is-wide-register(operands[0])
    no-id
|? !is-only-reader(function, vreg, definer) || !is-wide-register(operands[1]) || !base-intact
    no-id
|? is-wide-register(operands[2]) && !offset-intact
    no-id
??
    found

.. vreg = vreg-id(function, register)
.. found = nearest-writer(function, removed, instructions, index, vreg)
.. definer = instructions[found]
.. operands = function.instructions[definer].operands
.. not-add = function.instructions[definer].opcode != .add
.. base-intact = holds-between(function, removed, instructions, found, index, operands[1])
.. offset-intact = holds-between(function, removed, instructions, found, index, operands[2])

────────────────────
_ copy-definer U32
    - instructions IdList
    - index U32
    - register OperandId

|? found == no-id
    no-id
|? function.instructions[definer].opcode != .mov || phi-copy || operands.length != 2
    no-id
|? !is-wide-register(operands[0]) || !is-wide-register(operands[1]) || self-copy
    no-id
|? !is-only-reader(function, vreg, definer) || !keeps-root(register, operands[1]) || !intact
    no-id
??
    found

.. vreg = vreg-id(function, register)
.. found = nearest-writer(function, removed, instructions, index, vreg)
.. definer = instructions[found]
.. operands = function.instructions[definer].operands
.. phi-copy = function.instructions[definer].is-phi-copy
.. self-copy = vreg-id(function, operands[1]) == vreg
.. intact = holds-between(function, removed, instructions, found, index, operands[1])

────────────────────
_ shift-definer U32
    - instructions IdList
    - index U32
    - register OperandId
    - size I64

|? found == no-id
    no-id
|? not-lsl || operands.length != 3 || not-wide
    no-id
|? !amount.is-known || amount.is-negative || amount.bits != log2(size as U64) as U64
    no-id
|? !is-only-reader(function, vreg, definer) || !intact
    no-id
??
    found

.. vreg = vreg-id(function, register)
.. found = nearest-writer(function, removed, instructions, index, vreg)
.. definer = instructions[found]
.. operands = function.instructions[definer].operands
.. not-lsl = function.instructions[definer].opcode != .lsl
.. not-wide = !is-wide-register(operands[0]) || !is-wide-register(operands[1])
.. intact = holds-between(function, removed, instructions, found, index, operands[1])
.. amount = known-int(function, operands[2])

────────────────────
_ keeps-root Bool
    - replaced OperandId
    - replacement OperandId

!function.vregs[vreg-row(function, replaced)].gc-root || replacement-root

.. replacement-root = function.vregs[vreg-row(function, replacement)].gc-root

────────────────────
_ is-wide-register Bool
    - operand OperandId

operand != no-operand && row != no-id && function.vregs[row].reg-class == .gpr64 && unhinted

.. row = vreg-row(function, operand)
.. unhinted = function.vregs[row].hint == no-register

────────────────────
_ is-zero-offset Bool
    - offset OperandId

offset == no-operand || (value.is-known && value.bits == 0)

.. value = known-int(function, offset)

────────────────────
_ do fits-offset Bool
    - operand OperandId
    - size I64

do match? function.operands[operand]
    | .int-operand(row)
        if row.value.is-negative
            = (row.value.bits as I64) >= -256
        = row.value.bits <= 255 || (row.value.bits % (size as U64) == 0 && in-range)
            .. in-range = row.value.bits / (size as U64) <= 4095
    | .label-operand(label)
        = label.reloc == .pageoff-reloc && aligned
            .. aligned = size == 1 || (builder.bundle.symbol-alignment(label.name) as I64) >= size
= false

────────────────────
_ do folded OperandId
    - definer InstructionId
    - replacement OperandId

removed[definer] = 1
function.drop-uses(definer)
= replacement

━━━━━━━━━━━━━━━━━━━━
+ MIRInstructionCombiningPass

` Combines each instruction with the arithmetic that only makes one of its registers, where one
` AArch64 instruction does both: a product that a sum reads becomes MADD or MSUB; a shift by a
` constant that a sum, a bitwise operation or a comparison reads becomes its shifted register; a
` shift and a mask, or two shifts, become UBFX or SBFX; a field cleared and then filled from
` another register becomes BFI; a choice of one more than, the complement of or the negation of a
` register becomes CSINC, CSINV or CSNEG; a narrow load that a sign extension reads becomes a
` signed load; and a branch on one bit, on zero or on the sign becomes TBZ, TBNZ, CBZ or CBNZ. A
` division by a constant becomes a multiply by its reciprocal and shifts. As in address folding,
` each instruction folded is the nearest writer of its register in the reader's block, read by
` nothing else, with what it read unchanged up to the reader.

_ builder MIRBuilder
_ function MIRFunction
_ removed CPointer'Byte
_ definitions CPointer'U32
_ definers CPointer'U32
_ prefixes CPointer'IdList
_ vreg-limit U32
_ instruction-limit U32

────────────────────
+ This
    - builder MIRBuilder

.. function = builder.function

────────────────────
+ do run Bool

. arena = function.arena
vreg-limit = function.vreg-count
instruction-limit = function.instructions.length as U32
function.count-uses()
removed = arena.allocate'Byte(instruction-limit)
prefixes = arena.allocate'IdList(instruction-limit)
definitions = arena.allocate'U32(vreg-limit)
definers = arena.allocate'U32(vreg-limit)
. order = function.block-order
for position in 0 .. < order.length
    . instructions = function.blocks[order[position]].instructions
    for index in 0 .. < instructions.length
        note-definitions(instructions[index])
. changed = false
for position in 0 .. < order.length
    . block = order[position]
    . instructions = function.blocks[block].instructions
    . combined = false
    for index in 0 .. < instructions.length
        if combine(instructions, index)
            combined = true
    if combined
        changed = true
        rebuild(block)
= changed

────────────────────
_ do note-definitions
    - id InstructionId

. roles = function.operand-roles(id)
. operands = function.instructions[id].operands
for position in 0 .. < operands.length
    if (role-at(roles, position) /and/ def-role) == 0
        continue
    do match? function.operands[operands[position]]
        | .vreg-operand(row)
            . vreg = function.vregs[row.vreg].id
            definitions[vreg] = definitions[vreg] + 1
            definers[vreg] = id
        | .vreg-group-operand(group)
            for index in group.vregs.start .. < group.vregs.end
                . vreg = function.vregs[function.group-vregs[index]].id
                definitions[vreg] = definitions[vreg] + 1
        | .load-address-operand(address)
            . base = vreg-id(function, address.base)
            if base != no-id
                definitions[base] = definitions[base] + 1

────────────────────
_ do combine Bool
    - instructions IdList
    - index U32

. id = instructions[index]
if removed[id] != 0
    = false
. is-assembly = false
do match? function.instructions[id]
    | .assembly-instruction
        is-assembly = true
if !is-assembly
    = false
. opcode = function.instructions[id].opcode
. operands = function.instructions[id].operands
. count = operands.length
if (opcode == .udiv || opcode == .sdiv) && count == 3
    = divide(id, opcode, operands)
if (opcode == .add || opcode == .sub) && count == 3
    = combine-sum(instructions, index, id, opcode, operands)
if (opcode == .and || opcode == .orr || opcode == .eor) && count == 3
    = combine-logical(instructions, index, id, opcode, operands)
if (opcode == .lsr || opcode == .asr) && count == 3
    = combine-shifts(instructions, index, id, opcode, operands)
if opcode == .cmp && count == 2
    = combine-compare(instructions, index, id, operands)
if opcode == .csel && count == 4
    = combine-select(instructions, index, id, operands)
if (opcode == .sxtb || opcode == .sxth || opcode == .sxtw) && count == 2
    = combine-extension(instructions, index, id, opcode, operands)
if (opcode == .cbz || opcode == .cbnz) && count == 2
    = combine-bit-test(instructions, index, id, opcode, operands)
if opcode == .b-cond && count == 2
    = combine-zero-test(instructions, index, id, operands)
= false

────────────────────
_ do combine-sum Bool
    - instructions IdList
    - index U32
    - id InstructionId
    - opcode Opcode
    - operands IdList

. dest = operands[0]
. left = operands[1]
. right = operands[2]
if !is-integer-register(dest) || !same-class(dest, left) || !same-class(dest, right)
    = false
. arena = function.arena
. is-add = opcode == .add
. product = product-definer(instructions, index, right)
if product != no-id
    . factors = function.instructions[instructions[product]].operands
    absorb(instructions, product)
    rewrite-assembly
        - function
        - id
        - if is-add then Opcode.madd else Opcode.msub
        - quad(arena, dest, factors[1], factors[2], left)
    = true
if is-add
    product = product-definer(instructions, index, left)
    if product != no-id
        . factors = function.instructions[instructions[product]].operands
        absorb(instructions, product)
        rewrite-assembly(function, id, .madd, quad(arena, dest, factors[1], factors[2], right))
        = true
. shifted = shift-definer(instructions, index, right)
if shifted != no-id
    = shift-into(instructions, shifted, id, opcode, dest, left, right)
if is-add
    shifted = shift-definer(instructions, index, left)
    if shifted != no-id
        = shift-into(instructions, shifted, id, opcode, dest, right, left)
= false

────────────────────
_ do combine-logical Bool
    - instructions IdList
    - index U32
    - id InstructionId
    - opcode Opcode
    - operands IdList

. dest = operands[0]
. left = operands[1]
. right = operands[2]
if !is-integer-register(dest) || !same-class(dest, left)
    = false
. mask = known-int(function, right)
if mask.is-known
    if opcode == .and
        = extract-field(instructions, index, id, dest, left, mask.bits)
    = false
if !same-class(dest, right)
    = false
if opcode == .orr && (insert-field(instructions, index, id, dest, left, right) || insert-field(instructions, index, id, dest, right, left))
    = true
. shifted = shift-definer(instructions, index, right)
if shifted != no-id
    = shift-into(instructions, shifted, id, opcode, dest, left, right)
shifted = shift-definer(instructions, index, left)
if shifted != no-id
    = shift-into(instructions, shifted, id, opcode, dest, right, left)
= false

────────────────────
_ do combine-shifts Bool
    - instructions IdList
    - index U32
    - id InstructionId
    - opcode Opcode
    - operands IdList

. dest = operands[0]
. source = operands[1]
if !is-integer-register(dest) || !same-class(dest, source)
    = false
. width = register-width(dest)
. amount = known-int(function, operands[2])
if !amount.is-known || amount.is-negative || amount.bits == 0 || amount.bits >= width
    = false
. found = shift-definer(instructions, index, source)
if found == no-id || function.instructions[instructions[found]].opcode != .lsl
    = false
. inner = function.instructions[instructions[found]].operands
. moved = known-int(function, inner[2]).bits
if moved > amount.bits
    = false
absorb(instructions, found)
. field = builder.small-int((width - amount.bits) as I64)
rewrite-assembly
    - function
    - id
    - if opcode == .lsr then Opcode.ubfx else Opcode.sbfx
    - quad(function.arena, dest, inner[1], builder.small-int((amount.bits - moved) as I64), field)
= true

────────────────────
_ do combine-compare Bool
    - instructions IdList
    - index U32
    - id InstructionId
    - operands IdList

. left = operands[0]
. right = operands[1]
if !is-integer-register(left) || !same-class(left, right)
    = false
. found = shift-definer(instructions, index, right)
if found == no-id
    = false
. shift = function.instructions[instructions[found]].operands
. kind = shift-kind(function.instructions[instructions[found]].opcode)
. amount = known-int(function, shift[2]).bits as U32
absorb(instructions, found)
rewrite-assembly
    - function
    - id
    - .cmp
    - triple(function.arena, left, shift[1], builder.add-operand(ShiftOperand(kind, amount)))
= true

────────────────────
_ do combine-select Bool
    - instructions IdList
    - index U32
    - id InstructionId
    - operands IdList

. dest = operands[0]
. first = operands[1]
. second = operands[2]
. condition = operands[3]
if !is-integer-register(dest) || !same-class(dest, first) || !same-class(dest, second)
    = false
. arena = function.arena
. reg-class = function.vregs[vreg-row(function, dest)].reg-class
. mask = class-mask(reg-class)
. zero = builder.preg(if reg-class == .gpr64 then zero-register else zero-register-32)
. inverse = invert-condition(builder, condition)
. first-value = constant-of(first)
. second-value = constant-of(second)
. changed = false
if first-value.is-known && first-value.bits == 0
    first = zero
    changed = true
if second-value.is-known && second-value.bits == 0
    second = zero
    changed = true
if second-value.is-known && second-value.bits == 1
    rewrite-assembly(function, id, .csinc, quad(arena, dest, first, zero, condition))
    = true
if second-value.is-known && second-value.bits == mask
    rewrite-assembly(function, id, .csinv, quad(arena, dest, first, zero, condition))
    = true
if inverse != no-operand && first-value.is-known && first-value.bits == 1
    rewrite-assembly(function, id, .csinc, quad(arena, dest, second, zero, inverse))
    = true
if inverse != no-operand && first-value.is-known && first-value.bits == mask
    rewrite-assembly(function, id, .csinv, quad(arena, dest, second, zero, inverse))
    = true
if select-from(instructions, index, id, dest, first, second, condition)
    = true
if inverse != no-operand && select-from(instructions, index, id, dest, second, first, inverse)
    = true
if changed
    rewrite-assembly(function, id, .csel, quad(arena, dest, first, second, condition))
= changed

────────────────────
_ do select-from Bool
    - instructions IdList
    - index U32
    - id InstructionId
    - dest OperandId
    - kept OperandId
    - made OperandId
    - condition OperandId

if vreg-row(function, made) == no-id
    = false
. found = definer(instructions, index, made)
if found == no-id
    = false
. opcode = function.instructions[instructions[found]].opcode
. operands = function.instructions[instructions[found]].operands
. select = Opcode.csel
if opcode == .add && operands.length == 3
    . step = known-int(function, operands[2])
    if step.is-known && !step.is-negative && step.bits == 1
        select = .csinc
else if opcode == .mvn && operands.length == 2
    select = .csinv
else if opcode == .neg && operands.length == 2
    select = .csneg
if select == .csel || !same-class(dest, operands[1])
    = false
absorb(instructions, found)
rewrite-assembly(function, id, select, quad(function.arena, dest, kept, operands[1], condition))
= true

────────────────────
_ do combine-extension Bool
    - instructions IdList
    - index U32
    - id InstructionId
    - opcode Opcode
    - operands IdList

. dest = operands[0]
. source = operands[1]
. dest-row = vreg-row(function, dest)
if dest-row == no-id || hinted || function.vregs[dest-row].gc-root || !is-integer-register(dest)
    = false
.. hinted = function.vregs[dest-row].hint != no-register
if opcode == .sxtw && function.vregs[dest-row].reg-class != .gpr64
    = false
. load = Opcode.ldrb
. signed = Opcode.ldrsb
if opcode == .sxth
    load = .ldrh
    signed = .ldrsh
else if opcode == .sxtw
    load = .ldr
    signed = .ldrsw
. found = definer(instructions, index, source)
if found == no-id
    = false
. loaded = instructions[found]
. loaded-operands = function.instructions[loaded].operands
if function.instructions[loaded].opcode != load || loaded-operands.length != 2
    = false
if opcode == .sxtw && function.vregs[vreg-row(function, loaded-operands[0])].reg-class != .gpr32
    = false
. vreg = function.vregs[dest-row].id
for position in found + 1 .. < index
    . passed = instructions[position]
    if removed[passed] == 0 && (writes-vreg(function, passed, vreg) || reads-vreg(passed, vreg))
        = false
loaded-operands.data[0] = dest
rewrite-assembly(function, loaded, signed, loaded-operands)
removed[id] = 1
function.drop-uses(id)
= true

────────────────────
_ do combine-bit-test Bool
    - instructions IdList
    - index U32
    - id InstructionId
    - opcode Opcode
    - operands IdList

. found = definer(instructions, index, operands[0])
if found == no-id || function.instructions[instructions[found]].opcode != .and
    = false
. masking = function.instructions[instructions[found]].operands
if masking.length != 3 || !is-integer-register(masking[1])
    = false
. mask = known-int(function, masking[2])
if !mask.is-known || mask.is-negative || !is-power-of-two(mask.bits)
    = false
. bit = log2(mask.bits)
if (bit as U64) >= register-width(masking[1])
    = false
absorb(instructions, found)
rewrite-assembly
    - function
    - id
    - if opcode == .cbnz then Opcode.tbnz else Opcode.tbz
    - triple(function.arena, masking[1], builder.small-int(bit), operands[1])
= true

────────────────────
_ do combine-zero-test Bool
    - instructions IdList
    - index U32
    - id InstructionId
    - operands IdList

. previous = previous-real(function, instructions, index)
if previous == no-id || removed[instructions[previous]] != 0
    = false
. compare = instructions[previous]
. compared = function.instructions[compare].operands
if not-cmp || compared.length != 2 || !is-integer-register(compared[0])
    = false
.. not-cmp = function.instructions[compare].opcode != .cmp
. zero = known-int(function, compared[1])
if !zero.is-known || zero.bits != 0
    = false
. code = condition-code(function, operands[1])
. source = compared[0]
. target = operands[0]
. arena = function.arena
. sign = builder.small-int((register-width(source) - 1) as I64)
if code == Condition.equal
    rewrite-assembly(function, id, .cbz, pair(arena, source, target))
else if code == Condition.unequal
    rewrite-assembly(function, id, .cbnz, pair(arena, source, target))
else if code == Condition.negative || code == Condition.less
    rewrite-assembly(function, id, .tbnz, triple(arena, source, sign, target))
else if code == Condition.positive || code == Condition.greater-equal
    rewrite-assembly(function, id, .tbz, triple(arena, source, sign, target))
else
    = false
= true

────────────────────
_ do extract-field Bool
    - instructions IdList
    - index U32
    - id InstructionId
    - dest OperandId
    - source OperandId
    - mask U64

. width = register-width(dest)
if mask == 0 || !is-power-of-two(mask + 1)
    = false
. field = log2(mask + 1) as U64
if field >= width
    = false
. found = shift-definer(instructions, index, source)
if found == no-id || function.instructions[instructions[found]].opcode == .lsl
    = false
. shift = function.instructions[instructions[found]].operands
. lsb = known-int(function, shift[2]).bits
if lsb + field > width
    = false
absorb(instructions, found)
rewrite-assembly
    - function
    - id
    - .ubfx
    - quad
        - function.arena
        - dest
        - shift[1]
        - builder.small-int(lsb as I64)
        - builder.small-int(field as I64)
= true

────────────────────
_ do insert-field Bool
    - instructions IdList
    - index U32
    - id InstructionId
    - dest OperandId
    - cleared OperandId
    - filled OperandId

. width = register-width(dest)
. mask = class-mask(function.vregs[vreg-row(function, dest)].reg-class)
. clearing = definer(instructions, index, cleared)
if clearing == no-id || function.instructions[instructions[clearing]].opcode != .and
    = false
. clear = function.instructions[instructions[clearing]].operands
. kept-bits = known-int(function, clear[2])
if !kept-bits.is-known || !same-class(dest, clear[1])
    = false
. filling = definer(instructions, index, filled)
if filling == no-id
    = false
. fill-opcode = function.instructions[instructions[filling]].opcode
. fill = function.instructions[instructions[filling]].operands
. lsb U64
. masked = filled
. masking = filling
if fill-opcode == .lsl && fill.length == 3
    . moved = known-int(function, fill[2])
    if !moved.is-known || moved.is-negative || moved.bits >= width
        = false
    lsb = moved.bits
    masked = fill[1]
    masking = definer(instructions, filling, masked)
    if masking == no-id
        = false
else if fill-opcode != .and
    = false
. field-operands = function.instructions[instructions[masking]].operands
if function.instructions[instructions[masking]].opcode != .and || field-operands.length != 3
    = false
. field-mask = known-int(function, field-operands[2])
if !field-mask.is-known || field-mask.bits == 0 || !is-power-of-two(field-mask.bits + 1)
    = false
. field = log2(field-mask.bits + 1) as U64
. value = field-operands[1]
if lsb + field > width || !same-class(dest, value) || same-vreg
    = false
.. same-vreg = vreg-id(function, dest) == vreg-id(function, value)
if (kept-bits.bits /and/ mask) != ((field-mask.bits /lshift/ lsb) /xor/ mask)
    = false
if !holds-between(function, removed, instructions, masking, index, value)
    = false
. base = clear[1]
absorb(instructions, clearing)
absorb(instructions, filling)
if masking != filling
    absorb(instructions, masking)
if vreg-id(function, dest) != vreg-id(function, base)
    emit(id, builder.new-assembly(.mov, dest, base))
rewrite-assembly
    - function
    - id
    - .bfi
    - quad
        - function.arena
        - dest
        - value
        - builder.small-int(lsb as I64)
        - builder.small-int(field as I64)
= true

────────────────────
_ do shift-into Bool
    - instructions IdList
    - found U32
    - id InstructionId
    - opcode Opcode
    - dest OperandId
    - kept OperandId
    - replaced OperandId

. shift = function.instructions[instructions[found]].operands
. kind = shift-kind(function.instructions[instructions[found]].opcode)
. amount = known-int(function, shift[2]).bits as U32
absorb(instructions, found)
rewrite-assembly
    - function
    - id
    - opcode
    - quad(function.arena, dest, kept, shift[1], builder.add-operand(ShiftOperand(kind, amount)))
= true

────────────────────
_ product-definer U32
    - instructions IdList
    - index U32
    - operand OperandId

|? found == no-id
    no-id
|? not-mul || operands.length != 3 || other-class
    no-id
??
    found

.. found = definer(instructions, index, operand)
.. operands = function.instructions[instructions[found]].operands
.. not-mul = function.instructions[instructions[found]].opcode != .mul
.. other-class = !same-class(operand, operands[1]) || !same-class(operand, operands[2])

────────────────────
_ shift-definer U32
    - instructions IdList
    - index U32
    - operand OperandId

|? found == no-id
    no-id
|? not-shift || operands.length != 3 || !same-class(operand, operands[1])
    no-id
|? !amount.is-known || amount.is-negative || amount.bits == 0 || too-wide
    no-id
??
    found

.. found = definer(instructions, index, operand)
.. operands = function.instructions[instructions[found]].operands
.. amount = known-int(function, operands[2])
.. not-shift = shift-kind(function.instructions[instructions[found]].opcode) == no-id
.. too-wide = amount.bits >= register-width(operand)

────────────────────
_ do definer U32
    - instructions IdList
    - index U32
    - operand OperandId

. row = vreg-row(function, operand)
if row == no-id || function.vregs[row].gc-root
    = no-id
. vreg = function.vregs[row].id
if vreg >= vreg-limit
    = no-id
. found = nearest-writer(function, removed, instructions, index, vreg)
if found == no-id
    = no-id
. id = instructions[found]
. is-assembly = false
do match? function.instructions[id]
    | .assembly-instruction
        is-assembly = true
if !is-assembly || function.instructions[id].is-phi-copy || id >= instruction-limit
    = no-id
. operands = function.instructions[id].operands
if operands.length == 0
    = no-id
. defined = vreg-row(function, operands[0])
if defined == no-id || function.vregs[defined].id != vreg || other-class
    = no-id
.. other-class = function.vregs[defined].reg-class != function.vregs[row].reg-class
if hinted || function.vregs[defined].gc-root || !is-only-reader(function, vreg, id)
    = no-id
.. hinted = function.vregs[defined].hint != no-register
. roles = function.operand-roles(id)
for position in 1 .. < operands.length
    if is-use && vreg-id(function, operands[position]) != no-id && !intact
        = no-id
    .. is-use = (role-at(roles, position) /and/ use-role) != 0
    .. intact = holds-between(function, removed, instructions, found, index, operands[position])
= found

────────────────────
_ do absorb
    - instructions IdList
    - found U32

removed[instructions[found]] = 1
function.drop-uses(instructions[found])

────────────────────
_ do reads-vreg Bool
    - id InstructionId
    - vreg U32

. roles = function.operand-roles(id)
. operands = function.instructions[id].operands
for position in 0 .. < operands.length
    if (role-at(roles, position) /and/ use-role) != 0 && reads-operand(operands[position], vreg)
        = true
= false

────────────────────
_ do reads-operand Bool
    - operand OperandId
    - vreg U32

if operand == no-operand
    = false
do match? function.operands[operand]
    | .vreg-operand(row)
        = function.vregs[row.vreg].id == vreg
    | .vreg-group-operand(group)
        for index in group.vregs.start .. < group.vregs.end
            if function.vregs[function.group-vregs[index]].id == vreg
                = true
    | .load-address-operand(address)
        = reads-operand(address.base, vreg) || reads-operand(address.offset, vreg)
= false

────────────────────
_ do constant-of Known
    - operand OperandId

. row = vreg-row(function, operand)
if row == no-id
    = Known()
. vreg = function.vregs[row].id
if vreg >= vreg-limit || definitions[vreg] != 1
    = Known()
. definer = definers[vreg]
. opcode = function.instructions[definer].opcode
. operands = function.instructions[definer].operands
. defined = vreg-row(function, operands[0])
if defined == no-id
    = Known()
. mask = class-mask(function.vregs[defined].reg-class) /and/ row-mask
    .. row-mask = class-mask(function.vregs[row].reg-class)
if mask == 0
    = Known()
if (opcode == .movz || opcode == .movn) && operands.length >= 2
    . value = known-int(function, operands[1])
    . shift = Known(true, 0, false)
    if operands.length > 2
        shift = known-int(function, operands[2])
    if !value.is-known || !shift.is-known || shift.bits > 48
        = Known()
    . bits = value.bits /lshift/ (shift.bits as U32)
    if opcode == .movn
        bits = bits /xor/ all-bits
    = Known(true, bits /and/ mask, false)
if opcode == .mov && operands.length == 2
    . value = known-int(function, operands[1])
    if value.is-known
        = Known(true, value.bits /and/ mask, false)
= Known()

────────────────────
_ do divide Bool
    - id InstructionId
    - opcode Opcode
    - operands IdList

. dest = operands[0]
. dividend = operands[1]
if !is-integer-register(dest) || !same-class(dest, dividend)
    = false
. divisor = constant-of(operands[2])
if !divisor.is-known
    = false
. reg-class = function.vregs[vreg-row(function, dest)].reg-class
. bits U32 = if reg-class == .gpr64 then 64 else 32
if opcode == .udiv
    = divide-unsigned(id, reg-class, dest, dividend, divisor.bits, bits)
= divide-signed(id, reg-class, dest, dividend, sign-extended(divisor.bits, bits) as I64, bits)

────────────────────
_ do divide-unsigned Bool
    - id InstructionId
    - reg-class RegClass
    - dest OperandId
    - dividend OperandId
    - divisor U64
    - bits U32

if divisor < 3 || is-power-of-two(divisor) || divisor >= (1u64 /lshift/ (bits - 1))
    = false
. magic = unsigned-magic(divisor, bits)
. multiplier = constant-register(id, magic.multiplier, reg-class)
. high = builder.vreg(.gpr64)
. top = high
if bits == 64
    emit(id, builder.new-assembly(.umulh, high, dividend, multiplier))
else
    . product = builder.vreg(.gpr64)
    emit(id, builder.new-assembly(.umull, product, dividend, multiplier))
    if !magic.adds
        emit(id, builder.new-assembly(.lsr, high, product, builder.small-int(32 + magic.shift)))
        rewrite-assembly(function, id, .mov, pair(function.arena, dest, builder.narrow-view(high)))
        = true
    emit(id, builder.new-assembly(.lsr, high, product, builder.small-int(32)))
    top = builder.narrow-view(high)
if !magic.adds
    finish-shift(id, .lsr, dest, top, magic.shift)
    = true
. difference = builder.vreg(reg-class)
emit(id, builder.new-assembly(.sub, difference, dividend, top))
. sum = builder.vreg(reg-class)
emit
    - id
    - builder.new-assembly
        - .add
        - sum
        - top
        - difference
        - builder.add-operand(ShiftOperand(MIRShift.right, 1))
finish-shift(id, .lsr, dest, sum, magic.shift - 1)
= true

────────────────────
_ do divide-signed Bool
    - id InstructionId
    - reg-class RegClass
    - dest OperandId
    - dividend OperandId
    - divisor I64
    - bits U32

. magnitude = divisor as U64
if divisor < 0
    magnitude = (0 - divisor) as U64
if magnitude < 3 || is-power-of-two(magnitude) || magnitude > 0x40000000
    = false
. magic = signed-magic(divisor, bits)
. is-negative = ((magic.multiplier /zrshift/ (bits - 1)) /and/ 1) != 0
. corrects = (divisor > 0 && is-negative) || (divisor < 0 && !is-negative)
. multiplier = constant-register(id, magic.multiplier, reg-class)
. high = builder.vreg(.gpr64)
. top = high
if bits == 64
    emit(id, builder.new-assembly(.smulh, high, dividend, multiplier))
else
    . product = builder.vreg(.gpr64)
    emit(id, builder.new-assembly(.smull, product, dividend, multiplier))
    if !corrects
        emit(id, builder.new-assembly(.asr, high, product, builder.small-int(32 + magic.shift)))
        . quotient = builder.narrow-view(high)
        rewrite-assembly
            - function
            - id
            - .add
            - quad
                - function.arena
                - dest
                - quotient
                - quotient
                - builder.add-operand(ShiftOperand(MIRShift.right, 31))
        = true
    emit(id, builder.new-assembly(.asr, high, product, builder.small-int(32)))
    top = builder.narrow-view(high)
. adjusted = top
if corrects
    adjusted = builder.vreg(reg-class)
    emit
        - id
        - builder.new-assembly
            - if divisor > 0 then Opcode.add else Opcode.sub
            - adjusted
            - top
            - dividend
. shifted = adjusted
if magic.shift > 0
    shifted = builder.vreg(reg-class)
    emit(id, builder.new-assembly(.asr, shifted, adjusted, builder.small-int(magic.shift)))
rewrite-assembly
    - function
    - id
    - .add
    - quad
        - function.arena
        - dest
        - shifted
        - shifted
        - builder.add-operand(ShiftOperand(MIRShift.right, bits - 1))
= true

────────────────────
_ do finish-shift
    - id InstructionId
    - opcode Opcode
    - dest OperandId
    - source OperandId
    - amount U32

if amount == 0
    rewrite-assembly(function, id, .mov, pair(function.arena, dest, source))
else
    rewrite-assembly
        - function
        - id
        - opcode
        - triple(function.arena, dest, source, builder.small-int(amount))

────────────────────
_ do constant-register OperandId
    - id InstructionId
    - value U64
    - reg-class RegClass

. width U32 = if reg-class == .gpr64 then 64 else 32
. masked = value /and/ class-mask(reg-class)
. register = builder.vreg(reg-class)
if encode-move-wide-immediate(masked, width).is-encodable || encodes-logical
    emit(id, builder.new-assembly(.mov, register, builder.small-int(masked as I64)))
    = register
.. encodes-logical = encode-logical-immediate(masked, width).is-encodable
. count = width / 16
. zeros U32
. ones U32
for target in 0 .. < count
    . chunk = (masked /zrshift/ (target * 16)) /and/ 0xffff
    if chunk == 0
        zeros += 1
    else if chunk == 0xffff
        ones += 1
    for source in 0 .. < count
        . filler = (masked /zrshift/ (source * 16)) /and/ 0xffff
        . candidate = cleared /or/ (filler /lshift/ (target * 16))
            .. cleared = masked /and/ ((halfword-bits /lshift/ (target * 16)) /xor/ all-bits)
        if source != target && encode-logical-immediate(candidate, width).is-encodable
            emit(id, builder.new-assembly(.mov, register, builder.small-int(candidate as I64)))
            emit
                - id
                - builder.new-assembly
                    - .movk
                    - register
                    - builder.small-int(chunk as I64)
                    - builder.small-int(target * 16)
            = register
. is-inverted = ones > zeros
. is-first = true
for halfword in 0 .. < count
    . chunk = (masked /zrshift/ (halfword * 16)) /and/ 0xffff
    if chunk == (if is-inverted then halfword-bits else 0)
        continue
    . shift = builder.small-int(halfword * 16)
    if !is-first
        emit(id, builder.new-assembly(.movk, register, builder.small-int(chunk as I64), shift))
    else if is-inverted
        emit
            - id
            - builder.new-assembly
                - .movn
                - register
                - builder.small-int((chunk /xor/ 0xffff) as I64)
                - shift
    else
        emit(id, builder.new-assembly(.movz, register, builder.small-int(chunk as I64), shift))
    is-first = false
= register

────────────────────
_ do emit
    - id InstructionId
    - instruction InstructionId

prefixes[id] = prefixes[id].appended(function.arena, instruction)
function.add-uses(instruction)

────────────────────
_ do rebuild
    - block BlockId

. arena = function.arena
. instructions = function.blocks[block].instructions
. extra U32
for index in 0 .. < instructions.length
    . id = instructions[index]
    if id < instruction-limit
        extra += prefixes[id].length
. rebuilt = new-id-list(arena, instructions.length + extra)
for index in 0 .. < instructions.length
    . id = instructions[index]
    if id < instruction-limit
        . leading = prefixes[id]
        for entry in 0 .. < leading.length
            rebuilt = rebuilt.appended(arena, leading[entry])
        if removed[id] != 0
            continue
    rebuilt = rebuilt.appended(arena, id)
function.blocks[block].instructions = rebuilt

────────────────────
_ is-integer-register Bool
    - operand OperandId

row != no-id && (function.vregs[row].reg-class == .gpr32 || function.vregs[row].reg-class == .gpr64)

.. row = vreg-row(function, operand)

────────────────────
_ same-class Bool
    - first OperandId
    - second OperandId

left != no-id && right != no-id && function.vregs[left].reg-class == function.vregs[right].reg-class

.. left = vreg-row(function, first)
.. right = vreg-row(function, second)

────────────────────
_ register-width U64
    - operand OperandId

if function.vregs[vreg-row(function, operand)].reg-class == .gpr64 then 64 else 32

━━━━━━━━━━━━━━━━━━━━
_ DivisionMagic is Tuple

+ multiplier U64
+ shift U32
+ adds Bool

━━━━━━━━━━━━━━━━━━━━
_ PowerQuotient is Tuple

+ high U64
+ low U64
+ remainder U64

━━━━━━━━━━━━━━━━━━━━
_ do unsigned-magic DivisionMagic
    - divisor U64
    - bits U32

` The multiplier and shift that divide an unsigned number of `bits` bits by `divisor`. The
` smallest shift whose multiplier fits the register, and errs by no more than one part in two to
` the shift, needs no more; otherwise the multiplier is one bit wider, and the division adds the
` dividend back in halves.
. ceiling U32
while (1u64 /lshift/ ceiling) < divisor
    ceiling += 1
. limit = if bits == 64 then all-bits else low-word
. shift U32
while shift < ceiling
    . quotient = power-quotient(bits + shift, divisor)
    if quotient.high != 0 || quotient.low >= limit
        break
    if divisor - quotient.remainder <= (1u64 /lshift/ shift)
        = DivisionMagic(quotient.low + 1, shift, false)
    shift += 1
. quotient = power-quotient(bits + ceiling, divisor)
= DivisionMagic((quotient.low + 1) /and/ limit, ceiling, true)

━━━━━━━━━━━━━━━━━━━━
_ do signed-magic DivisionMagic
    - divisor I64
    - bits U32

` The multiplier and shift that divide a signed number of `bits` bits by `divisor`, as Hacker's
` Delight finds them: the shift grows until the multiplier's error falls below what the largest
` dividend can notice.
. half = 1u64 /lshift/ (bits - 1)
. magnitude = divisor as U64
. bound = half
if divisor < 0
    magnitude = (0 - divisor) as U64
    bound += 1
. largest = bound - 1 - bound % magnitude
. power = bits - 1
. first-quotient = half / largest
. first-remainder = half - first-quotient * largest
. second-quotient = half / magnitude
. second-remainder = half - second-quotient * magnitude
while true
    power += 1
    first-quotient = first-quotient * 2
    first-remainder = first-remainder * 2
    if first-remainder >= largest
        first-quotient += 1
        first-remainder -= largest
    second-quotient = second-quotient * 2
    second-remainder = second-remainder * 2
    if second-remainder >= magnitude
        second-quotient += 1
        second-remainder -= magnitude
    . delta = magnitude - second-remainder
    if first-quotient > delta || (first-quotient == delta && first-remainder != 0)
        break
. limit = if bits == 64 then all-bits else low-word
. multiplier = (second-quotient + 1) /and/ limit
if divisor < 0
    multiplier = (0 - multiplier) /and/ limit
= DivisionMagic(multiplier, power - bits, false)

━━━━━━━━━━━━━━━━━━━━
_ do power-quotient PowerQuotient
    - power U32
    - divisor U64

. high U64
. low U64
. remainder U64
. position U32 = 128
while position > 0
    position -= 1
    . carry = remainder /zrshift/ 63
    remainder = remainder /lshift/ 1
    if position == power
        remainder = remainder /or/ 1
    if carry != 0 || remainder >= divisor
        remainder -= divisor
        if position >= 64
            high = high /or/ (1u64 /lshift/ (position - 64))
        else
            low = low /or/ (1u64 /lshift/ position)
= PowerQuotient(high, low, remainder)

━━━━━━━━━━━━━━━━━━━━
+ MIRFrameForwardingPass

` Forwards to each load from a small frame object what its block last stored there, where the
` object's address reaches nothing but plain loads and stores at constant offsets. A load whose
` bytes one register stored whole reads that register, one whose bytes all hold constants reads
` the constant, and one whose low bytes one register stored and whose other bytes hold constants
` reads that register widened, with the constants set over it. The stores to an object no load is
` left to read go, with its addresses.

_ builder MIRBuilder
_ function MIRFunction
_ objects CPointer'U32
_ bases CPointer'U32
_ pins CPointer'Byte
_ versions CPointer'U32
_ constant-stamps CPointer'U32
_ constant-versions CPointer'U32
_ constants CPointer'U64
_ byte-stamps CPointer'U32
_ byte-sources CPointer'U32
_ byte-versions CPointer'U32
_ byte-lanes CPointer'Byte
_ byte-widths CPointer'Byte
_ byte-values CPointer'Byte
_ read CPointer'Byte
_ prefixes CPointer'U32
_ instruction-count U32
_ stamp U32

────────────────────
+ This
    - builder MIRBuilder

.. function = builder.function

────────────────────
+ do run Bool

. arena = function.arena
. object-count = function.frame-objects.length
objects = arena.allocate'U32(object-count)
. total U32
for position in 0 .. < function.frame-slots.length
    . row = function.slots[function.frame-slots[position]]
    if row.is-stack || row.objects.length != 1
        continue
    . object = row.objects[0]
    . size = function.types[function.frame-objects[object].type].size
    if size != 0 && size <= forwarded-object-bytes && !is-kept-object(object)
        objects[object] = total + 1
        total += size
if total == 0
    = false
. vreg-count = function.vreg-count
bases = arena.allocate'U32(vreg-count)
pins = arena.allocate'Byte(vreg-count)
versions = arena.allocate'U32(vreg-count)
constant-stamps = arena.allocate'U32(vreg-count)
constant-versions = arena.allocate'U32(vreg-count)
constants = arena.allocate'U64(vreg-count)
find-bases()
check-uses()
byte-stamps = arena.allocate'U32(total)
byte-sources = arena.allocate'U32(total)
byte-versions = arena.allocate'U32(total)
byte-lanes = arena.allocate'Byte(total)
byte-widths = arena.allocate'Byte(total)
byte-values = arena.allocate'Byte(total)
read = arena.allocate'Byte(object-count)
instruction-count = function.instructions.length as U32
prefixes = arena.allocate'U32(instruction-count)
stamp = 0
. changed = false
. order = function.block-order
for position in 0 .. < order.length
    stamp += 1
    . instructions = function.blocks[order[position]].instructions
    for index in 0 .. < instructions.length
        if forward(instructions[index])
            changed = true
        note-definitions(instructions[index])
if rebuild-blocks()
    changed = true
= changed

────────────────────
_ is-kept-object Bool
    - object FrameObjectId

flagged || object == function.closure-root || object == function.capture-closure-root || is-var

.. row = function.frame-objects[object]
.. flagged = row.gc-root || row.can-promote || row.is-spill
.. is-var = includes(function.vars, object)

────────────────────
_ do find-bases

. definitions = function.arena.allocate'U32(function.vreg-count)
. order = function.block-order
for position in 0 .. < order.length
    . instructions = function.blocks[order[position]].instructions
    for index in 0 .. < instructions.length
        . id = instructions[index]
        . roles = function.operand-roles(id)
        . operands = function.instructions[id].operands
        . is-address = function.instructions[id].opcode == .addptr && operands.length == 2
        for entry in 0 .. < operands.length
            . object = object-of(operands[entry])
            if object != no-frame-object
                . base = if is-address && entry == 1 then vreg-id(function, operands[0]) else no-id
                if base == no-id || is-root(operands[0]) || other-base
                    objects[object] = 0
                else
                    bases[base] = object + 1
                .. other-base = bases[base] != 0 && bases[base] != object + 1
            if (role-at(roles, entry) /and/ def-role) != 0
                count-definitions(definitions, operands[entry])
            note-pins(operands[entry])
for vreg in 0 .. < function.vreg-count
    if bases[vreg] != 0 && definitions[vreg] != 1
        objects[bases[vreg] - 1] = 0

────────────────────
_ do object-of FrameObjectId
    - operand OperandId

if operand == no-operand
    = no-frame-object
do match? function.operands[operand]
    | .frame-object-operand(row)
        = row.object
    | .load-address-operand(address)
        . object = object-of(address.base)
        if object != no-frame-object
            objects[object] = 0
= no-frame-object

────────────────────
_ do count-definitions
    - counts CPointer'U32
    - operand OperandId

do match? function.operands[operand]
    | .vreg-operand(row)
        . vreg = function.vregs[row.vreg].id
        counts[vreg] = counts[vreg] + 1
    | .vreg-group-operand(group)
        for index in group.vregs.start .. < group.vregs.end
            . vreg = function.vregs[function.group-vregs[index]].id
            counts[vreg] = counts[vreg] + 1
    | .load-address-operand(address)
        . vreg = vreg-id(function, address.base)
        if vreg != no-id
            counts[vreg] = counts[vreg] + 1

────────────────────
_ do check-uses

. order = function.block-order
for position in 0 .. < order.length
    . instructions = function.blocks[order[position]].instructions
    for index in 0 .. < instructions.length
        . id = instructions[index]
        . operands = function.instructions[id].operands
        . address = address-entry(id)
        . is-address = function.instructions[id].opcode == .addptr
        for entry in 0 .. < operands.length
            if entry == address
                check-address(id, operands[entry])
            else if entry != 0 || !is-address
                drop-named(operands[entry])

────────────────────
_ do check-address
    - id InstructionId
    - operand OperandId

do match? function.operands[operand]
    | .load-address-operand(address)
        drop-named(address.offset)
        . vreg = vreg-id(function, address.base)
        if vreg == no-id || bases[vreg] == 0
            =
        . object = bases[vreg] - 1
        . size = function.types[function.frame-objects[object].type].size as U64
        . width = access-width(id) as U64
        . offset = if address.offset == no-operand then Known(true, 0, false) else known-offset
            .. known-offset = known-int(function, address.offset)
        . limit = if is-store(id) then size else (size + 7) /and/ 0xfffffffffffffff8
        if address.is-pre-index || address.index-shift != 0 || !offset.is-known || offset.is-negative || width == 0 || offset.bits >= size || offset.bits + width > limit || is-root(address.base)
            objects[object] = 0

────────────────────
_ is-store Bool
    - id InstructionId

opcode == .str || opcode == .strb || opcode == .strh || opcode == .stp

.. opcode = function.instructions[id].opcode

────────────────────
_ is-root Bool
    - operand OperandId

row != no-id && function.vregs[row].gc-root

.. row = vreg-row(function, operand)

────────────────────
_ is-pinned Bool
    - operand OperandId

vreg != no-id && pins[vreg] != 0

.. vreg = vreg-id(function, operand)

────────────────────
_ do note-pins
    - operand OperandId

if operand == no-operand
    =
do match? function.operands[operand]
    | .vreg-operand(row)
        if function.vregs[row.vreg].hint != no-register
            pins[function.vregs[row.vreg].id] = 1
    | .vreg-group-operand(group)
        for index in group.vregs.start .. < group.vregs.end
            . member = function.group-vregs[index]
            if function.vregs[member].hint != no-register
                pins[function.vregs[member].id] = 1
    | .load-address-operand(address)
        note-pins(address.base)
        note-pins(address.offset)

────────────────────
_ do drop-named
    - operand OperandId

if operand == no-operand
    =
do match? function.operands[operand]
    | .vreg-operand(row)
        drop-base(function.vregs[row.vreg].id)
    | .vreg-group-operand(group)
        for index in group.vregs.start .. < group.vregs.end
            drop-base(function.vregs[function.group-vregs[index]].id)
    | .load-address-operand(address)
        drop-named(address.base)
        drop-named(address.offset)

────────────────────
_ do drop-base
    - vreg U32

if bases[vreg] != 0
    objects[bases[vreg] - 1] = 0

────────────────────
_ address-entry U32
    - id InstructionId

|? count == 2 && (opcode == .ldr || opcode == .str || narrow-access || opcode == .ldrsw)
    1
|? count == 3 && (opcode == .ldp || opcode == .stp)
    2
??
    no-id

.. opcode = function.instructions[id].opcode
.. count = function.instructions[id].operands.length
.. narrow-access = opcode == .ldrb || opcode == .strb || opcode == .ldrh || opcode == .strh

────────────────────
_ access-width U32
    - id InstructionId

|? opcode == .ldrb || opcode == .strb
    1
|? opcode == .ldrh || opcode == .strh
    2
|? opcode == .ldrsw
    4
|? opcode == .ldp || opcode == .stp
    width * 2
??
    width

.. opcode = function.instructions[id].opcode
.. width = operand-width(function.instructions[id].operands[0])

────────────────────
_ do operand-width U32
    - operand OperandId

do match? function.operands[operand]
    | .vreg-operand(row)
        = class-size(function.vregs[row.vreg].reg-class) as U32
    | .preg-operand(row)
        = class-size(register-class(row.register)) as U32
= 0

────────────────────
_ do target-object FrameObjectId
    - operand OperandId

do match? function.operands[operand]
    | .load-address-operand(address)
        . vreg = vreg-id(function, address.base)
        if vreg != no-id && bases[vreg] != 0 && objects[bases[vreg] - 1] != 0
            = bases[vreg] - 1
= no-frame-object

────────────────────
_ do target-byte U32
    - object FrameObjectId
    - operand OperandId

. start = objects[object] - 1
do match? function.operands[operand]
    | .load-address-operand(address)
        if address.offset != no-operand
            = start + (known-int(function, address.offset).bits as U32)
= start

────────────────────
_ do forward Bool
    - id InstructionId

. address = address-entry(id)
if address == no-id
    = false
. operands = function.instructions[id].operands
. object = target-object(operands[address])
if object == no-frame-object
    = false
. start = target-byte(object, operands[address])
. opcode = function.instructions[id].opcode
if is-store(id) && opcode != .stp
    store(start, operands[0], access-width(id))
    = false
if opcode == .stp
    . width = operand-width(operands[0])
    store(start, operands[0], width)
    store(start + width, operands[1], width)
    = false
if load(id, start, objects[object] - 1 + function.types[function.frame-objects[object].type].size)
    = true
read[object] = 1
= false

────────────────────
_ do store
    - start U32
    - value OperandId
    - width U32

. constant = constant-of(value)
. vreg = vreg-id(function, value)
for lane in 0 .. < width
    . place = start + lane
    byte-stamps[place] = stamp
    byte-sources[place] = no-operand
    byte-lanes[place] = lane as Byte
    byte-widths[place] = width as Byte
    if constant.is-known
        byte-values[place] = ((constant.bits /zrshift/ ((lane * 8) as U64)) /and/ 0xff) as Byte
    else if vreg != no-id && !is-pinned(value)
        byte-sources[place] = value
        byte-versions[place] = versions[vreg]
    else
        byte-stamps[place] = 0

────────────────────
_ do load Bool
    - id InstructionId
    - start U32
    - end U32

. opcode = function.instructions[id].opcode
if opcode != .ldr && opcode != .ldrb && opcode != .ldrh
    = false
. destination = function.instructions[id].operands[0]
. row = vreg-row(function, destination)
if row == no-id
    = false
. reg-class = function.vregs[row].reg-class
if reg-class != .gpr32 && reg-class != .gpr64
    = false
. width = access-width(id)
. bits U64
. is-constant = true
for lane in 0 .. < width
    . place = start + lane
    if place >= end
        continue
    if byte-stamps[place] != stamp
        = false
    if byte-sources[place] != no-operand
        is-constant = false
    else
        bits = bits /or/ ((byte-values[place] as U64) /lshift/ ((lane * 8) as U64))
if is-constant
    = move-constant(id, destination, bits, class-mask(reg-class))
. source = byte-sources[start]
. vreg = vreg-id(function, source)
. stored = byte-widths[start] as U32
if vreg == no-id || stored > width || (is-root(destination) && !is-root(source))
    = false
for lane in 0 .. < width
    . place = start + lane
    if lane >= stored
        if place < end && byte-sources[place] != no-operand
            = false
    else if other-vreg || other-lane || byte-versions[place] != versions[vreg]
        = false
    .. other-vreg = vreg-id(function, byte-sources[place]) != vreg
    .. other-lane = byte-lanes[place] != lane as Byte || byte-widths[place] != stored as Byte
. source-class = function.vregs[vreg-row(function, source)].reg-class
if stored != width
    = widen(id, destination, source, source-class, reg-class, stored, width, bits)
if opcode == .ldr
    if source-class != reg-class
        = false
    rewrite-assembly(function, id, .mov, pair(function.arena, destination, source))
    = true
if source-class != .gpr32 || reg-class != .gpr32
    = false
rewrite-assembly
    - function
    - id
    - if opcode == .ldrb then Opcode.uxtb else Opcode.uxth
    - pair(function.arena, destination, source)
= true

────────────────────
_ do widen Bool
    - id InstructionId
    - destination OperandId
    - source OperandId
    - source-class RegClass
    - reg-class RegClass
    - stored U32
    - width U32
    - high U64

if source-class != .gpr32 && source-class != .gpr64
    = false
. opcode = Opcode.uxtb
if stored == 2
    opcode = .uxth
else if stored == 4
    opcode = .uxtw
else if stored != 1
    = false
. arena = function.arena
if high == 0
    rewrite-assembly(function, id, opcode, pair(arena, destination, source))
    = true
if !encode-logical-immediate(high, width * 8).is-encodable
    = false
. widened = builder.vreg-operand(builder.new-vreg(reg-class))
prefixes[id] = builder.new-assembly(opcode, widened, source) + 1
rewrite-assembly
    - function
    - id
    - .orr
    - triple(arena, destination, widened, builder.small-int(high as I64))
= true

────────────────────
_ do move-constant Bool
    - id InstructionId
    - destination OperandId
    - bits U64
    - mask U64

. inverted = (bits /xor/ all-bits) /and/ mask
if bits > 0xffff && inverted > 0xffff
    = false
. opcode = if bits <= 0xffff then Opcode.movz else Opcode.movn
. immediate = if bits <= 0xffff then bits else inverted
rewrite-assembly
    - function
    - id
    - opcode
    - triple(function.arena, destination, builder.small-int(immediate as I64), builder.small-int(0))
= true

────────────────────
_ do constant-of Known
    - value OperandId

do match? function.operands[value]
    | .preg-operand(row)
        if row.register == zero-register || row.register == zero-register-32
            = Known(true, 0, false)
    | .vreg-operand(row)
        . vreg = function.vregs[row.vreg].id
        if constant-stamps[vreg] == stamp && constant-versions[vreg] == versions[vreg]
            = Known(true, constants[vreg], false)
= Known()

────────────────────
_ defined-constant Known
    - id InstructionId

|? moves-wide && operands.length == 3 && immediate.is-known && shift.is-known && shift.bits < 64
    Known(true, if opcode == .movz then bits else bits /xor/ all-bits, false)
|? opcode == .mov && operands.length == 2
    constant-of(operands[1])
??
    Known()

.. opcode = function.instructions[id].opcode
.. operands = function.instructions[id].operands
.. immediate = known-int(function, operands[1])
.. shift = known-int(function, operands[2])
.. bits = immediate.bits /lshift/ shift.bits
.. moves-wide = opcode == .movz || opcode == .movn

────────────────────
_ do note-definitions
    - id InstructionId

. operands = function.instructions[id].operands
. row = if operands.length != 0 then vreg-row(function, operands[0]) else no-id
. value = if row != no-id then defined-constant(id) else Known()
. roles = function.operand-roles(id)
for entry in 0 .. < operands.length
    if (role-at(roles, entry) /and/ def-role) != 0
        count-definitions(versions, operands[entry])
if value.is-known
    . vreg = function.vregs[row].id
    constant-stamps[vreg] = stamp
    constant-versions[vreg] = versions[vreg]
    constants[vreg] = value.bits /and/ class-mask(function.vregs[row].reg-class)

────────────────────
_ do rebuild-blocks Bool

for object in 0 .. < function.frame-objects.length
    if read[object] != 0
        objects[object] = 0
. removed = false
. order = function.block-order
for position in 0 .. < order.length
    . block = order[position]
    . instructions = function.blocks[block].instructions
    . extra U32
    for index in 0 .. < instructions.length
        if prefix-of(instructions[index]) != no-id
            extra += 1
    . rebuilt = if extra == 0 then instructions else new-id-list(function.arena, instructions.length + extra)
    . kept U32
    for index in 0 .. < instructions.length
        . id = instructions[index]
        . object = dead-object(id)
        if object != no-frame-object
            function.drop-uses(id)
            read[object] = 2
            removed = true
            continue
        . prefix = prefix-of(id)
        if prefix != no-id
            function.add-uses(prefix)
            rebuilt.data[kept] = prefix
            kept += 1
        rebuilt.data[kept] = id
        kept += 1
    function.blocks[block].instructions = IdList(rebuilt.data, kept, rebuilt.capacity)
for object in 0 .. < function.frame-objects.length
    if read[object] == 2
        function.slots[function.frame-objects[object].slot].objects = IdList()
= removed

────────────────────
_ prefix-of InstructionId
    - id InstructionId

if id >= instruction-count || prefixes[id] == 0 then no-id else prefixes[id] - 1

────────────────────
_ do dead-object FrameObjectId
    - id InstructionId

. operands = function.instructions[id].operands
if function.instructions[id].opcode == .addptr && operands.length == 2
    . vreg = vreg-id(function, operands[0])
    if vreg != no-id && bases[vreg] != 0 && objects[bases[vreg] - 1] != 0
        = bases[vreg] - 1
    = no-frame-object
. address = address-entry(id)
= if address != no-id then target-object(operands[address]) else no-frame-object

━━━━━━━━━━━━━━━━━━━━
+ MIRBlockLayoutPass

_ builder MIRBuilder
_ function MIRFunction
_ branch-targets CPointer'U32
_ path-marks CPointer'U32
_ path-mark U32
_ path IdList
_ components CPointer'U32
_ component-sizes IdList
_ is-cold CPointer'Byte
_ is-placed CPointer'Byte
_ successor-marks CPointer'U32
_ successor-mark U32

────────────────────
+ This
    - builder MIRBuilder

.. function = builder.function

────────────────────
+ do run Bool

. retargeted = rewrite-safe-branch-chains()
. moved = layout-blocks()
. simplified = rewrite-fallthrough-branches()
= retargeted || moved || simplified

────────────────────
_ do rewrite-safe-branch-chains Bool

. arena = function.arena
. changed = false
. block-count = function.blocks.length
branch-targets = arena.allocate'U32(block-count)
path-marks = arena.allocate'U32(block-count)
path-mark = 0
path = IdList()
. sources = new-id-list(arena, 8)
. finals = new-id-list(arena, 8)
. order = function.block-order
for position in 0 .. < order.length
    . block = order[position]
    sources = IdList(sources.data, 0, sources.capacity)
    finals = IdList(finals.data, 0, finals.capacity)
    . instructions = function.blocks[block].instructions
    for index in 0 .. < instructions.length
        . id = instructions[index]
        if !is-branch-opcode(function.instructions[id].opcode)
            continue
        . operands = function.instructions[id].operands
        for entry in 0 .. < operands.length
            . name = label-name(function, operands[entry])
            if name == no-string
                continue
            . target = builder.get-block(name)
            if target == no-id
                continue
            . resolved = chain-target(target)
            if resolved == target
                continue
            operands.data[entry] = builder.label(function.blocks[resolved].name)
            if !includes(sources, target)
                sources = sources.appended(arena, target)
                finals = finals.appended(arena, resolved)
            changed = true
    for index in 0 .. < sources.length
        replace-successor(function, block, sources[index], finals[index])

for table in 0 .. < function.jump-tables.length
    . labels = function.jump-tables[table].labels
    for index in labels.start .. < labels.end
        . name = function.names[index]
        . target = builder.get-block(name)
        if target == no-id
            continue
        . resolved-name = function.blocks[chain-target(target)].name
        if resolved-name != name
            function.names.data[index] = resolved-name
            changed = true

if changed
    repair-predecessors(function)
    builder.prune-unreachable-blocks()
= changed

────────────────────
_ do chain-target BlockId
    - first BlockId

. arena = function.arena
path = IdList(path.data, 0, path.capacity)
path-mark += 1
. current = first
while true
    . cached = branch-targets[current]
    if cached != 0
        remember(cached - 1)
        = cached - 1
    if path-marks[current] == path-mark
        for index in 0 .. < path.length
            branch-targets[path[index]] = path[index] + 1
        = first
    path-marks[current] = path-mark
    path = path.appended(arena, current)
    . successor = safe-branch-only-successor(current)
    if successor == no-id
        remember(current)
        = current
    current = successor

────────────────────
_ do remember
    - target BlockId

for index in 0 .. < path.length
    branch-targets[path[index]] = target + 1

────────────────────
_ safe-branch-only-successor BlockId
    - block BlockId

|? instructions.length != 1 || successors.length != 1
    no-id
|? !is-plain-branch(function, id)
    no-id
|? label-name(function, first-operand(function, id)) != function.blocks[successors[0]].name
    no-id
??
    successors[0]

.. instructions = function.blocks[block].instructions
.. successors = function.blocks[block].successors
.. id = instructions[0]

────────────────────
_ do layout-blocks Bool

. arena = function.arena
. original = function.block-order
if original.length < 2
    = false
. block-count = function.blocks.length
build-loop-components(original)
collect-cold-targets()
is-placed = arena.allocate'Byte(block-count)
successor-marks = arena.allocate'U32(block-count)
successor-mark = 0
. ordered = new-id-list(arena, original.length)
. start U32
while start <= original.length
    . block = original[0]
    if start != 0
        block = original[start - 1]
    start += 1
    while block != no-id && is-placed[block] == 0
        is-placed[block] = 1
        ordered = ordered.appended(arena, block)
        block = preferred-successor(block)

. moved = false
for index in 0 .. < original.length
    if original[index] != ordered[index]
        moved = true
if moved
    function.block-order = ordered
= moved

────────────────────
_ do build-loop-components
    - blocks IdList

. arena = function.arena
. block-count = function.blocks.length
. is-listed = arena.allocate'Byte(block-count)
for index in 0 .. < blocks.length
    is-listed[blocks[index]] = 1
. is-visited = arena.allocate'Byte(block-count)
. pending = arena.allocate'U32(blocks.length)
. cursors = arena.allocate'U32(blocks.length)
. post-order = new-id-list(arena, blocks.length)
for index in 0 .. < blocks.length
    . root = blocks[index]
    if is-visited[root] != 0
        continue
    is-visited[root] = 1
    . depth U32 = 1
    pending[0] = root
    cursors[0] = 0
    while depth != 0
        . block = pending[depth - 1]
        . successors = function.blocks[block].successors
        . cursor = cursors[depth - 1]
        if cursor < successors.length
            cursors[depth - 1] = cursor + 1
            . successor = successors[cursor]
            if is-listed[successor] != 0 && is-visited[successor] == 0
                is-visited[successor] = 1
                pending[depth] = successor
                cursors[depth] = 0
                depth += 1
            continue
        post-order = post-order.appended(arena, block)
        depth -= 1

components = arena.allocate'U32(block-count)
component-sizes = IdList()
. index = post-order.length
while index > 0
    index -= 1
    . root = post-order[index]
    if components[root] != 0
        continue
    . component = component-sizes.length + 1
    . size U32
    . depth U32 = 1
    pending[0] = root
    components[root] = component
    while depth != 0
        depth -= 1
        . block = pending[depth]
        size += 1
        . predecessors = function.blocks[block].predecessors
        for entry in 0 .. < predecessors.length
            . predecessor = predecessors[entry]
            if is-listed[predecessor] == 0 || components[predecessor] != 0
                continue
            components[predecessor] = component
            pending[depth] = predecessor
            depth += 1
    component-sizes = component-sizes.appended(arena, size)

────────────────────
_ do collect-cold-targets

is-cold = function.arena.allocate'Byte(function.blocks.length)
. order = function.block-order
for position in 0 .. < order.length
    . instructions = function.blocks[order[position]].instructions
    for index in 0 .. < instructions.length
        . panic-target = no-operand
        do match? function.instructions[instructions[index]]
            | .call-instruction(call)
                panic-target = call.panic-target
        . name = label-name(function, panic-target)
        if name == no-string
            continue
        . target = builder.get-block(name)
        if target != no-id
            is-cold[target] = 1

────────────────────
_ do preferred-successor BlockId
    - block BlockId

successor-mark += 1
. unique-count U32
. first-unplaced = no-id
. loop-count U32
. loop-successor = no-id
. successors = function.blocks[block].successors
for index in 0 .. < successors.length
    . successor = successors[index]
    if successor-marks[successor] == successor-mark
        continue
    successor-marks[successor] = successor-mark
    unique-count += 1
    if is-placed[successor] != 0
        continue
    if first-unplaced == no-id
        first-unplaced = successor
    if is-cold[successor] == 0 && is-same-loop-component(block, successor)
        loop-count += 1
        if loop-count == 1
            loop-successor = successor
if first-unplaced == no-id
    = no-id
if unique-count == 1
    = first-unplaced
if loop-count == 1
    = loop-successor

. last = last-real(function, block)
if last == no-id || function.instructions[last].opcode != .b
    = no-id
. name = label-name(function, first-operand(function, last))
if name == no-string
    = no-id
. target = builder.get-block(name)
if target != no-id && is-placed[target] == 0 && is-cold[target] == 0
    = target
= no-id

────────────────────
_ is-same-loop-component Bool
    - from BlockId
    - to BlockId

component != 0 && component == components[to] && (component-sizes[component - 1] > 1 || from == to)

.. component = components[from]

────────────────────
+ do rewrite-fallthrough-branches Bool

. changed = false
. order = function.block-order
for position in 1 .. < order.length
    . block = order[position - 1]
    . next-name = function.blocks[order[position]].name
    . instructions = function.blocks[block].instructions
    . branch-index = previous-real(function, instructions, instructions.length)
    if branch-index == no-id
        continue
    . branch = instructions[branch-index]
    if !is-plain-branch(function, branch)
        continue
    . branch-target = first-operand(function, branch)
    . target-name = label-name(function, branch-target)
    if target-name == no-string
        continue

    . conditional-index = previous-real(function, instructions, branch-index)
    . is-inverted = false
    if conditional-index != no-id
        . conditional = instructions[conditional-index]
        if label-name(function, conditional-branch-target(function, conditional)) == next-name
            is-inverted = invert-conditional-branch(conditional, branch-target)
    if is-inverted || target-name == next-name
        remove-instruction(function, block, branch)
        changed = true
= changed

────────────────────
_ do invert-conditional-branch Bool
    - id InstructionId
    - target OperandId

. opcode = function.instructions[id].opcode
. operands = function.instructions[id].operands
if opcode == .cbnz
    operands.data[1] = target
    rewrite-assembly(function, id, .cbz, operands)
    = true
if opcode == .cbz
    operands.data[1] = target
    rewrite-assembly(function, id, .cbnz, operands)
    = true
if opcode == .tbz || opcode == .tbnz
    operands.data[2] = target
    rewrite-assembly(function, id, if opcode == .tbz then Opcode.tbnz else Opcode.tbz, operands)
    = true
if opcode != .b-cond
    = false
. inverse = invert-condition(builder, operands[1])
if inverse == no-operand
    = false
operands.data[0] = target
operands.data[1] = inverse
= true

━━━━━━━━━━━━━━━━━━━━
+ MIRCompareBranchFusionPass

_ builder MIRBuilder
_ function MIRFunction

────────────────────
+ This
    - builder MIRBuilder

.. function = builder.function

────────────────────
+ do run Bool

. arena = function.arena
. changed = false
. order = function.block-order
for position in 0 .. < order.length
    . block = order[position]
    . instructions = function.blocks[block].instructions
    . has-kept = false
    . kept IdList
    for index in 0 .. < instructions.length
        . id = instructions[index]
        . opcode = function.instructions[id].opcode
        . cset = no-id
        if opcode == .cbnz || opcode == .cbz
            cset = fusable-condition(id, instructions, index)
        . condition = no-operand
        if cset != no-id
            . operands = function.instructions[id].operands
            function.count-uses()
            if function.use-count(vreg-id(function, operands[0])) == 1
                condition = function.instructions[cset].operands[1]
                if opcode == .cbz
                    condition = invert-condition(builder, condition)
        if condition == no-operand
            if has-kept
                kept = kept.appended(arena, id)
            continue

        if !has-kept
            has-kept = true
            kept = new-id-list(arena, instructions.length)
            for entry in 0 .. < index
                kept = kept.appended(arena, instructions[entry])
        . found = kept.length
        while found > 0
            found -= 1
            if kept[found] == cset
                function.drop-uses(cset)
                . following = found + 1
                for entry in following .. < kept.length
                    kept.data[entry - 1] = kept[entry]
                kept = IdList(kept.data, kept.length - 1, kept.capacity)
                break
        rewrite-assembly
            - function
            - id
            - .b-cond
            - pair(arena, function.instructions[id].operands[1], condition)
        kept = kept.appended(arena, id)
        changed = true
    if has-kept
        function.blocks[block].instructions = kept
= changed

────────────────────
_ fusable-condition InstructionId
    - id InstructionId
    - instructions IdList
    - index U32

|? tested == no-id
    no-id
|? cset-index == no-id || cmp-index == no-id
    no-id
|? function.instructions[cset].opcode != .cset
    no-id
|? !same-operand(function, function.instructions[cset].operands[0], operands[0])
    no-id
|? !is-flag-compare(function.instructions[instructions[cmp-index]].opcode)
    no-id
??
    cset

.. operands = function.instructions[id].operands
.. tested = vreg-id(function, operands[0])
.. cset-index = cset-before(instructions, index, tested)
.. cmp-index = previous-real(function, instructions, cset-index)
.. cset = instructions[cset-index]

────────────────────
_ do cset-before U32
    - instructions IdList
    - index U32
    - tested U32

. cursor = previous-real(function, instructions, index)
while cursor != no-id && function.instructions[instructions[cursor]].opcode != .cset
    . between = instructions[cursor]
    . opcode = function.instructions[between].opcode
    =? no-id if !is-pure-def(opcode) || clobbers-flags(opcode)
    . defined = function.instruction-def(between)
    =? no-id if defined != no-id && function.vregs[defined].id == tested
    cursor = previous-real(function, instructions, cursor)
= cursor

━━━━━━━━━━━━━━━━━━━━
_ Lattice is Tuple

+ state Byte
+ bits U64

━━━━━━━━━━━━━━━━━━━━
_ WidePart is Tuple

+ bits U64
+ shift U64

━━━━━━━━━━━━━━━━━━━━
_ meet Lattice
    - left Lattice
    - right Lattice

|? left.state == LatticeState.top
    right
|? right.state == LatticeState.top
    left
|? left.state == LatticeState.constant && right.state == LatticeState.constant && same-bits
    left
??
    Lattice(LatticeState.varying, 0)

.. same-bits = left.bits == right.bits

━━━━━━━━━━━━━━━━━━━━
_ merged-state Byte
    - left Lattice
    - right Lattice

|? left.state == LatticeState.varying || right.state == LatticeState.varying
    LatticeState.varying
|? left.state == LatticeState.top || right.state == LatticeState.top
    LatticeState.top
??
    LatticeState.constant

━━━━━━━━━━━━━━━━━━━━
_ class-mask U64
    - reg-class RegClass

match reg-class
    |= .gpr32
        low-word
    |= .gpr64
        all-bits
    ??
        0

━━━━━━━━━━━━━━━━━━━━
_ class-size U64
    - reg-class U32

|? reg-class == RegClass.gpr32 as U32 || reg-class == RegClass.fpr32 as U32
    4
|? reg-class == RegClass.gpr64 as U32 || reg-class == RegClass.fpr64 as U32
    8
??
    0

━━━━━━━━━━━━━━━━━━━━
_ sign-extended U64
    - bits U64
    - width U64

|? width >= 64
    bits
|? (low /and/ (1u64 /lshift/ (width - 1))) != 0
    low /or/ (field /xor/ all-bits)
??
    low

.. field = (1u64 /lshift/ width) - 1
.. low = bits /and/ field

━━━━━━━━━━━━━━━━━━━━
_ Known is Tuple

+ is-known Bool
+ bits U64
+ is-negative Bool

━━━━━━━━━━━━━━━━━━━━
_ do known-int Known
    - function MIRFunction
    - operand OperandId

do match? function.operands[operand]
    | .int-operand(row)
        = Known(true, row.value.bits, row.value.is-negative)
= Known()

━━━━━━━━━━━━━━━━━━━━
_ signed-value I64
    - value Known

?! Panic("MIR address offset ${value.bits} does not fit a signed offset")
    if !value.is-negative && value.bits > 0x7fffffffffffffff

value.bits as I64

━━━━━━━━━━━━━━━━━━━━
_ fits-signed-bits Bool
    - value I64
    - bits I64

value >= 0 - limit && value < limit

.. limit I64 = 1 /lshift/ (bits - 1)

━━━━━━━━━━━━━━━━━━━━
_ is-add-sub-bits Bool
    - bits U64

bits <= 4095 || (bits % 4096 == 0 && bits / 4096 <= 4095)

━━━━━━━━━━━━━━━━━━━━
_ is-power-of-two Bool
    - bits U64

bits != 0 && (bits /and/ (bits - 1)) == 0

━━━━━━━━━━━━━━━━━━━━
_ is-add-sub-immediate Bool
    - value MIRInt

!value.is-negative && (value.bits <= 4095 || (value.bits % 4096 == 0 && value.bits / 4096 <= 4095))

━━━━━━━━━━━━━━━━━━━━
_ do log2 I64
    - value U64

. shift I64
. rest = value
while rest > 1
    rest = rest /zrshift/ 1
    shift += 1
= shift

━━━━━━━━━━━━━━━━━━━━
_ do nearest-writer U32
    - function MIRFunction
    - removed CPointer'Byte
    - instructions IdList
    - index U32
    - vreg U32

if vreg == no-id
    = no-id
. position = index
while position > 0
    position -= 1
    . id = instructions[position]
    if removed[id] == 0 && writes-vreg(function, id, vreg)
        = position
= no-id

━━━━━━━━━━━━━━━━━━━━
_ do holds-between Bool
    - function MIRFunction
    - removed CPointer'Byte
    - instructions IdList
    - from U32
    - to U32
    - operand OperandId

. vreg = vreg-id(function, operand)
for position in from + 1 .. < to
    . id = instructions[position]
    if removed[id] == 0 && writes-vreg(function, id, vreg)
        = false
= true

━━━━━━━━━━━━━━━━━━━━
_ do writes-vreg Bool
    - function MIRFunction
    - id InstructionId
    - vreg U32

. roles = function.operand-roles(id)
. operands = function.instructions[id].operands
for position in 0 .. < operands.length
    if is-def && names-vreg(function, operands[position], vreg)
        = true
    .. is-def = (role-at(roles, position) /and/ def-role) != 0
= false

━━━━━━━━━━━━━━━━━━━━
_ do names-vreg Bool
    - function MIRFunction
    - operand OperandId
    - vreg U32

do match? function.operands[operand]
    | .vreg-operand(row)
        = function.vregs[row.vreg].id == vreg
    | .vreg-group-operand(group)
        for index in group.vregs.start .. < group.vregs.end
            if function.vregs[function.group-vregs[index]].id == vreg
                = true
    | .load-address-operand(address)
        = vreg-id(function, address.base) == vreg
= false

━━━━━━━━━━━━━━━━━━━━
_ do is-only-reader Bool
    - function MIRFunction
    - vreg U32
    - definer InstructionId

. own U32
. roles = function.operand-roles(definer)
. operands = function.instructions[definer].operands
for position in 0 .. < operands.length
    if is-use && vreg-id(function, operands[position]) == vreg
        own += 1
    .. is-use = (role-at(roles, position) /and/ use-role) != 0
= function.use-count(vreg) == own + 1

━━━━━━━━━━━━━━━━━━━━
_ do pair IdList
    - arena Arena
    - first OperandId
    - second OperandId

. list = new-id-list(arena, 2)
list.data[0] = first
list.data[1] = second
= IdList(list.data, 2, 2)

━━━━━━━━━━━━━━━━━━━━
_ do triple IdList
    - arena Arena
    - first OperandId
    - second OperandId
    - third OperandId

. list = new-id-list(arena, 3)
list.data[0] = first
list.data[1] = second
list.data[2] = third
= IdList(list.data, 3, 3)

━━━━━━━━━━━━━━━━━━━━
_ do quad IdList
    - arena Arena
    - first OperandId
    - second OperandId
    - third OperandId
    - fourth OperandId

. list = new-id-list(arena, 4)
list.data[0] = first
list.data[1] = second
list.data[2] = third
list.data[3] = fourth
= IdList(list.data, 4, 4)

━━━━━━━━━━━━━━━━━━━━
_ do rewrite-assembly
    - function MIRFunction
    - id InstructionId
    - opcode Opcode
    - operands IdList

function.drop-uses(id)
do match? function.instructions[id]
    | .assembly-instruction(row)
        row.opcode = opcode
        row.operands = operands
function.add-uses(id)

━━━━━━━━━━━━━━━━━━━━
_ do vreg-id U32
    - function MIRFunction
    - operand OperandId

if operand == no-operand
    = no-id
do match? function.operands[operand]
    | .vreg-operand(row)
        = function.vregs[row.vreg].id
= no-id

━━━━━━━━━━━━━━━━━━━━
_ do is-load-address Bool
    - function MIRFunction
    - operand OperandId

do match? function.operands[operand]
    | .load-address-operand
        = true
= false

━━━━━━━━━━━━━━━━━━━━
_ do label-name StringId
    - function MIRFunction
    - operand OperandId

if operand == no-operand
    = no-string
do match? function.operands[operand]
    | .label-operand(label)
        = label.name
= no-string

━━━━━━━━━━━━━━━━━━━━
_ first-operand OperandId
    - function MIRFunction
    - id InstructionId

if operands.length == 0 then no-operand else operands[0]

.. operands = function.instructions[id].operands

━━━━━━━━━━━━━━━━━━━━
_ do same-operand Bool
    - function MIRFunction
    - left OperandId
    - right OperandId

do match? function.operands[left]
    | .vreg-operand(first)
        do match? function.operands[right]
            | .vreg-operand(second)
                = function.vregs[first.vreg].id == function.vregs[second.vreg].id
        = false
    | .preg-operand(first)
        do match? function.operands[right]
            | .preg-operand(second)
                = first.register == second.register
        = false
    | .int-operand(first)
        do match? function.operands[right]
            | .int-operand(second)
                = first.value.bits == second.value.bits && same-sign
                    .. same-sign = first.value.is-negative == second.value.is-negative
        = false
= false

━━━━━━━━━━━━━━━━━━━━
_ do invert-condition OperandId
    - builder MIRBuilder
    - operand OperandId

. code = no-condition
do match? builder.function.operands[operand]
    | .cond-operand(row)
        code = row.code
if code == no-condition || code == Condition.always
    = no-operand
= builder.add-operand(CondOperand(code /xor/ 1))

━━━━━━━━━━━━━━━━━━━━
_ do conditional-branch-target OperandId
    - function MIRFunction
    - id InstructionId

. opcode = function.instructions[id].opcode
. operands = function.instructions[id].operands
. target = no-operand
if opcode == .b-cond && operands.length > 0
    target = operands[0]
else if (opcode == .cbz || opcode == .cbnz) && operands.length > 1
    target = operands[1]
else if (opcode == .tbz || opcode == .tbnz) && operands.length > 2
    target = operands[2]
if label-name(function, target) == no-string
    = no-operand
= target

━━━━━━━━━━━━━━━━━━━━
_ do is-plain-branch Bool
    - function MIRFunction
    - id InstructionId

do match? function.instructions[id]
    | .assembly-instruction(row)
        = row.opcode == .b && row.loc == no-loc && !row.gc-safepoint && !has-roots
            .. has-roots = row.has-gc-roots && row.gc-roots.count != 0
= false

━━━━━━━━━━━━━━━━━━━━
_ do previous-real U32
    - function MIRFunction
    - instructions IdList
    - end U32

. index = end
while index > 0
    index -= 1
    if function.instructions[instructions[index]].opcode != .comment
        = index
= no-id

━━━━━━━━━━━━━━━━━━━━
_ do next-real U32
    - function MIRFunction
    - instructions IdList
    - start U32

. index = start
while index < instructions.length
    if function.instructions[instructions[index]].opcode != .comment
        = index
    index += 1
= no-id

━━━━━━━━━━━━━━━━━━━━
_ do single-real InstructionId
    - function MIRFunction
    - block BlockId

. found = no-id
. instructions = function.blocks[block].instructions
for index in 0 .. < instructions.length
    . id = instructions[index]
    if function.instructions[id].opcode == .comment
        continue
    if found != no-id
        = no-id
    found = id
= found

━━━━━━━━━━━━━━━━━━━━
_ last-real InstructionId
    - function MIRFunction
    - block BlockId

if index == no-id then no-id else instructions[index]

.. instructions = function.blocks[block].instructions
.. index = previous-real(function, instructions, instructions.length)

━━━━━━━━━━━━━━━━━━━━
_ do remove-instruction
    - function MIRFunction
    - block BlockId
    - instruction InstructionId

. instructions = function.blocks[block].instructions
for index in 0 .. < instructions.length
    if instructions[index] != instruction
        continue
    function.drop-uses(instruction)
    . following = index + 1
    for entry in following .. < instructions.length
        instructions.data[entry - 1] = instructions[entry]
    function.blocks[block].instructions = IdList
        - instructions.data
        - instructions.length - 1
        - instructions.capacity
    =

━━━━━━━━━━━━━━━━━━━━
_ do includes Bool
    - list IdList
    - id U32

for index in 0 .. < list.length
    if list[index] == id
        = true
= false

━━━━━━━━━━━━━━━━━━━━
_ is-branch-opcode Bool @inline
    - opcode Opcode

plain-branch || opcode == .cbz || opcode == .cbnz || opcode == .tbz || opcode == .tbnz

.. plain-branch = opcode == .b || opcode == .b-cond

━━━━━━━━━━━━━━━━━━━━
_ is-flag-compare Bool @inline
    - opcode Opcode

opcode == .cmp || opcode == .fcmps || opcode == .fcmpd

━━━━━━━━━━━━━━━━━━━━
_ reads-flags Bool @inline
    - opcode Opcode

select-or-branch || opcode == .csinc || opcode == .csinv || opcode == .csneg || opcode == .ccmp

.. select-or-branch = opcode == .cset || opcode == .csel || opcode == .fcsel || opcode == .b-cond

━━━━━━━━━━━━━━━━━━━━
_ clobbers-flags Bool @inline
    - opcode Opcode

is-flag-compare(opcode) || opcode == .ccmp || opcode == .call || opcode == .bl || opcode == .blr

━━━━━━━━━━━━━━━━━━━━
_ is-load-store Bool
    - opcode Opcode

opcode == .ldr || opcode == .str || opcode == .ldrb || opcode == .strb || opcode == .ldrh || opcode == .strh || opcode == .ldrsw || opcode == .ldrsb || opcode == .ldrsh || opcode == .ldp || opcode == .stp

━━━━━━━━━━━━━━━━━━━━
_ is-pure-def Bool @inline
    - opcode Opcode

code <= 25 || code == 29 || code == 30 || code == 32 || code == 34 || code == 35 || (code >= 57 && code <= 68) || (code >= 76 && code <= 84) || code == 87 || code == 88

.. code = opcode as U32

━━━━━━━━━━━━━━━━━━━━
_ shift-kind U32
    - opcode Opcode

match opcode
    |= .lsl
        MIRShift.left
    |= .lsr
        MIRShift.right
    |= .asr
        MIRShift.right-signed
    ??
        no-id

━━━━━━━━━━━━━━━━━━━━
_ extension-bits U32
    - opcode Opcode

|? opcode == .uxtb || opcode == .sxtb
    8
|? opcode == .uxth || opcode == .sxth
    16
|? opcode == .uxtw || opcode == .sxtw
    32
??
    0

━━━━━━━━━━━━━━━━━━━━
_ is-signed-extension Bool
    - opcode Opcode

opcode == .sxtb || opcode == .sxth || opcode == .sxtw

━━━━━━━━━━━━━━━━━━━━
_ narrow-extension-width U32
    - opcode Opcode

|? bits == 0 || bits > 16
    0
|? is-signed-extension(opcode)
    bits - 1
??
    bits

.. bits = extension-bits(opcode)

━━━━━━━━━━━━━━━━━━━━
_ is-register-copy Bool
    - function MIRFunction
    - id InstructionId

function.instructions[id].opcode == .mov && copies-vreg

.. copies-vreg = vreg-id(function, function.instructions[id].operands[1]) != no-id

━━━━━━━━━━━━━━━━━━━━
_ do value-width U32
    - value Known

if !value.is-known || value.is-negative || value.bits > 0xffff
    = unknown-width
. width U32
. rest = value.bits
while rest != 0
    rest = rest /zrshift/ 1
    width += 1
= width

━━━━━━━━━━━━━━━━━━━━
_ do bit-length U32
    - bits U64

. width U32
. rest = bits
while rest != 0
    rest = rest /zrshift/ 1
    width += 1
= width

━━━━━━━━━━━━━━━━━━━━
_ do vreg-row VRegId @inline
    - function MIRFunction
    - operand OperandId

do match? function.operands[operand]
    | .vreg-operand(row)
        = row.vreg
= no-id

━━━━━━━━━━━━━━━━━━━━
_ do rewrite-branch-label
    - builder MIRBuilder
    - block BlockId
    - from StringId
    - to StringId

. function = builder.function
. instructions = function.blocks[block].instructions
for index in 0 .. < instructions.length
    . operands = function.instructions[instructions[index]].operands
    for entry in 0 .. < operands.length
        if label-name(function, operands[entry]) == from
            operands.data[entry] = builder.label(to)

━━━━━━━━━━━━━━━━━━━━
_ do has-explicit-branch-to Bool
    - function MIRFunction
    - block BlockId
    - target StringId

. instructions = function.blocks[block].instructions
for index in 0 .. < instructions.length
    . id = instructions[index]
    if !is-branch-opcode(function.instructions[id].opcode)
        continue
    . operands = function.instructions[id].operands
    for entry in 0 .. < operands.length
        if label-name(function, operands[entry]) == target
            = true
= false

━━━━━━━━━━━━━━━━━━━━
_ do replace-successor
    - function MIRFunction
    - block BlockId
    - from BlockId
    - to BlockId

. successors = function.blocks[block].successors
for index in 0 .. < successors.length
    if successors[index] == from
        successors.data[index] = to

━━━━━━━━━━━━━━━━━━━━
_ do repair-predecessors
    - function MIRFunction

. arena = function.arena
. order = function.block-order
. block-count = function.blocks.length
. is-listed = arena.allocate'Byte(block-count)
for position in 0 .. < order.length
    is-listed[order[position]] = 1
    function.blocks[order[position]].predecessors = IdList()
. marks = arena.allocate'U32(block-count)
for position in 0 .. < order.length
    . block = order[position]
    . mark = position + 1
    . successors = function.blocks[block].successors
    . kept U32
    for index in 0 .. < successors.length
        . successor = successors[index]
        if marks[successor] == mark
            continue
        marks[successor] = mark
        successors.data[kept] = successor
        kept += 1
    function.blocks[block].successors = IdList(successors.data, kept, successors.capacity)
    for index in 0 .. < kept
        . successor = successors[index]
        . predecessors = function.blocks[successor].predecessors
        if is-listed[successor] == 0 && includes(predecessors, block)
            continue
        function.blocks[successor].predecessors = predecessors.appended(arena, block)

━━━━━━━━━━━━━━━━━━━━
_ DefinitionChains is Tuple

+ firsts CPointer'U32
+ nexts CPointer'U32
+ own-reads CPointer'U32
+ vregs CPointer'U32

━━━━━━━━━━━━━━━━━━━━
_ do remove-dead-definitions Bool
    - function MIRFunction
    - pure-only Bool = false

` Removes each definition whose vreg nothing reads. With `pure-only`, as the reference's backend
` does, only a pure definition no instruction reads goes. Otherwise a load, MOVK, ADRP or phi may
` go too, and so may a vreg that only its own definitions read, as the ADRP and ADD of a symbol's
` address.
. arena = function.arena
function.count-uses()
. instruction-count = function.instructions.length
. chains = DefinitionChains
    - arena.allocate'U32(function.vreg-count)
    - arena.allocate'U32(instruction-count)
    - arena.allocate'U32(function.vreg-count)
    - arena.allocate'U32(instruction-count)
. order = function.block-order
for position in 0 .. < order.length
    . instructions = function.blocks[order[position]].instructions
    for index in 0 .. < instructions.length
        . id = instructions[index]
        . vreg = removable-definition(function, id, pure-only)
        if vreg == no-id
            continue
        chains.vregs[id] = vreg
        chains.nexts[id] = chains.firsts[vreg]
        chains.firsts[vreg] = id + 1
        if !pure-only
            chains.own-reads[vreg] = chains.own-reads[vreg] + own-reads(function, id, vreg)
. pending = IdList()
for vreg in 0 .. < function.vreg-count
    if chains.firsts[vreg] != 0
        pending = pushed-chain(function, vreg, chains, pending)
. removed = arena.allocate'Byte(instruction-count)
. any = false
while pending.length != 0
    . id = pending[pending.length - 1]
    pending = IdList(pending.data, pending.length - 1, pending.capacity)
    . vreg = chains.vregs[id]
    if removed[id] != 0 || function.use-count(vreg) != chains.own-reads[vreg]
        continue
    removed[id] = 1
    any = true
    if !pure-only
        chains.own-reads[vreg] = chains.own-reads[vreg] - own-reads(function, id, vreg)
    function.drop-uses(id)
    do match? function.instructions[id]
        | .phi-instruction(phi)
            for entry in 0 .. < phi.exprs.length
                pending = pushed-definers(function, phi.exprs[entry], chains, pending)
            continue
    . roles = function.operand-roles(id)
    . operands = function.instructions[id].operands
    for entry in 0 .. < operands.length
        if (role-at(roles, entry) /and/ use-role) != 0
            pending = pushed-definers(function, operands[entry], chains, pending)
if !any
    = false
for position in 0 .. < order.length
    . block = order[position]
    . instructions = function.blocks[block].instructions
    . kept U32
    for index in 0 .. < instructions.length
        if removed[instructions[index]] == 0
            instructions.data[kept] = instructions[index]
            kept += 1
    function.blocks[block].instructions = IdList(instructions.data, kept, instructions.capacity)
= true

━━━━━━━━━━━━━━━━━━━━
_ do removable-definition U32
    - function MIRFunction
    - id InstructionId
    - pure-only Bool

. row = no-id
. opcode = function.instructions[id].opcode
if opcode == .phi
    if pure-only
        = no-id
    do match? function.instructions[id]
        | .phi-instruction(phi)
            row = vreg-row(function, phi.reg)
else if opcode != .call && opcode != .comment
    if !is-pure-def(opcode)
        if pure-only
            = no-id
        . operands = function.instructions[id].operands
        . is-load = loads && operands.length == 2 && !writes-back
            .. loads = opcode == .ldr || opcode == .ldrb || opcode == .ldrh || opcode == .ldrsw
            .. writes-back = is-writeback-address(function, operands[1])
        if !is-load && opcode != .movk && opcode != .adrp && opcode != .adr
            = no-id
    row = function.def-with(id, opcode)
if row == no-id || hinted || (pure-only && function.vregs[row].gc-root)
    = no-id
.. hinted = function.vregs[row].hint != no-register
= function.vregs[row].id

━━━━━━━━━━━━━━━━━━━━
_ do own-reads U32
    - function MIRFunction
    - id InstructionId
    - vreg U32

` How many times a definition of `vreg` reads `vreg` itself, as a MOVK reads the value it puts
` bits into, or the ADD of a symbol's address reads the page its ADRP puts there. A vreg that
` only its own definitions read is dead along with all of them.
. count U32
do match? function.instructions[id]
    | .phi-instruction(phi)
        for entry in 0 .. < phi.exprs.length
            count += operand-reads(function, phi.exprs[entry], vreg)
        = count
. roles = function.operand-roles(id)
. operands = function.instructions[id].operands
for entry in 0 .. < operands.length
    if (role-at(roles, entry) /and/ use-role) != 0
        count += operand-reads(function, operands[entry], vreg)
= count

━━━━━━━━━━━━━━━━━━━━
_ do operand-reads U32
    - function MIRFunction
    - operand OperandId
    - vreg U32

if operand == no-operand
    = 0
do match? function.operands[operand]
    | .vreg-operand(row)
        = if function.vregs[row.vreg].id == vreg then 1 else 0
    | .vreg-group-operand(group)
        . count U32
        for index in group.vregs.start .. < group.vregs.end
            if function.vregs[function.group-vregs[index]].id == vreg
                count += 1
        = count
    | .load-address-operand(address)
        = operand-reads(function, address.base, vreg) + offset-reads
            .. offset-reads = operand-reads(function, address.offset, vreg)
= 0

━━━━━━━━━━━━━━━━━━━━
_ do pushed-definers IdList
    - function MIRFunction
    - operand OperandId
    - chains DefinitionChains
    - pending IdList

if operand == no-operand
    = pending
. result = pending
do match? function.operands[operand]
    | .vreg-operand(row)
        result = pushed-chain(function, function.vregs[row.vreg].id, chains, result)
    | .vreg-group-operand(group)
        for index in group.vregs.start .. < group.vregs.end
            result = pushed-chain
                - function
                - function.vregs[function.group-vregs[index]].id
                - chains
                - result
    | .load-address-operand(address)
        result = pushed-definers(function, address.base, chains, result)
        result = pushed-definers(function, address.offset, chains, result)
= result

━━━━━━━━━━━━━━━━━━━━
_ do pushed-chain IdList
    - function MIRFunction
    - vreg U32
    - chains DefinitionChains
    - pending IdList

if function.use-count(vreg) != chains.own-reads[vreg]
    = pending
. result = pending
. definer = chains.firsts[vreg]
while definer != 0
    result = result.appended(function.arena, definer - 1)
    definer = chains.nexts[definer - 1]
= result

━━━━━━━━━━━━━━━━━━━━
_ do remove-dead-comparisons Bool
    - function MIRFunction

. arena = function.arena
. order = function.block-order
. block-count = function.blocks.length
. live-in = arena.allocate'Byte(block-count)
. transparent = arena.allocate'Byte(block-count)
. work = new-id-list(arena, order.length)
for position in 0 .. < order.length
    . block = order[position]
    . instructions = function.blocks[block].instructions
    . is-transparent = true
    for index in 0 .. < instructions.length
        . opcode = function.instructions[instructions[index]].opcode
        if reads-flags(opcode)
            is-transparent = false
            live-in[block] = 1
            work = work.appended(arena, block)
            break
        if clobbers-flags(opcode)
            is-transparent = false
            break
    if is-transparent
        transparent[block] = 1

while work.length != 0
    . block = work[work.length - 1]
    work = IdList(work.data, work.length - 1, work.capacity)
    . predecessors = function.blocks[block].predecessors
    for index in 0 .. < predecessors.length
        . predecessor = predecessors[index]
        if transparent[predecessor] == 0 || live-in[predecessor] != 0
            continue
        live-in[predecessor] = 1
        work = work.appended(arena, predecessor)

. removed = false
for position in 0 .. < order.length
    . block = order[position]
    . is-live = false
    . successors = function.blocks[block].successors
    for index in 0 .. < successors.length
        if live-in[successors[index]] != 0
            is-live = true
    . instructions = function.blocks[block].instructions
    . length = instructions.length
    . write = length
    . index = length
    while index > 0
        index -= 1
        . id = instructions[index]
        . opcode = function.instructions[id].opcode
        if opcode == .ccmp
            if !is-live
                function.drop-uses(id)
                removed = true
                continue
        else if is-flag-compare(opcode)
            if !is-live
                function.drop-uses(id)
                removed = true
                continue
            is-live = false
        else if clobbers-flags(opcode)
            is-live = false
        else if reads-flags(opcode)
            is-live = true
        write -= 1
        instructions.data[write] = id
    if write != 0
        . remaining = length - write
        for offset in 0 .. < remaining
            instructions.data[offset] = instructions[write + offset]
        function.blocks[block].instructions = IdList
            - instructions.data
            - length - write
            - instructions.capacity
= removed

━━━━━━━━━━━━━━━━━━━━
_ do is-writeback-address Bool
    - function MIRFunction
    - operand OperandId

do match? function.operands[operand]
    | .load-address-operand(address)
        = address.is-pre-index
= true
