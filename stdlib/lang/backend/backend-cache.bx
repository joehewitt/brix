(import ./compact)
(import ./mir)
(import ./mir-digest)
(import ./pipeline)
(import ./relocations)
(import /core/arena)
(import /string.h)
(blank)
(prop _ kept-rounds U64 (= 4))

(type + CachedRecord (is Tuple)
  (prop + digest MIRDigest)
  (prop + record CompactFunction)
  (prop + counts FunctionCounts)
  (prop + pool U32)
  (prop + strings (of CPointer U32))
  (prop + string-count U32)
  (prop + round U64)
)

(type + BackendCache
  (implements (of Usable Void))
  (prop + round U64)
  (prop + hits U64)
  (prop + misses U64)
  (prop _ entries (list CachedRecord))
  (prop _ places (map U64 U32))
  (prop _ arenas (list Arena))
  (prop _ stores (list RecordStore))
  (fn-expr + begin-using _
    this
  )
  (fn-do + end-using _
    (call release)
  )
  (fn-do + release _
    (for (in store stores)
      (call (. store arena release))
    )
    (call (. stores clear))
    (for (in arena arenas)
      (call (. arena release))
    )
    (call (. arenas clear))
    (call (. entries clear))
    (call (. places clear))
  )
  (fn-do + begin-round _
    (param worker-count Size)
    (for (in store stores)
      (call (. store arena release))
    )
    (call (. stores clear))
    (+= round 1)
    (= hits 0)
    (= misses 0)
    (for (in _ (..< 0 worker-count))
      (+= stores (call RecordStore this))
    )
  )
  (fn-expr + store-for RecordStore
    (param worker Size)
    ([] stores worker)
  )
  (fn-expr + find (? U32)
    (param digest MIRDigest)
    (case? (or (not place) (!= (. ([] entries place) digest low) (. digest low)))
      null
    )
    (default
      place
    )
    (where
      (lazy place ([] places (. digest high)))
    )
  )
  (fn-expr + entry CachedRecord
    (param place U32)
    ([] entries place)
  )
  (fn-do + finish-round _
    (for (in store stores)
      (+= hits (as (. store used length) U64))
      (+= misses (as (. store kept length) U64))
      (for (in place (. store used))
        (let entry ([] entries place))
        (= ([] entries place) (= (. entry round) round))
      )
      (for (in entry (. store kept))
        (let place ([] places (. entry digest high)))
        (if place
          (= ([] entries place) entry)
          (else
            (= ([] places (. entry digest high)) (as (. entries length) U32))
            (+= entries entry)
          )
        )
      )
      (+= arenas (. store arena))
    )
    (call (. stores clear))
    (let live 0u64)
    (for (in entry entries)
      (if (> (+ (. entry round) kept-rounds) round)
        (+= live 1)
      )
    )
    (if (> (as (. entries length) U64) (* live 2))
      (call compact)
    )
  )
  (fn-do _ compact _
    (let arena (call Arena))
    (let kept (list CachedRecord))
    (for (in entry entries)
      (if (> (+ (. entry round) kept-rounds) round)
        (+= kept
          (call CachedRecord
            (block
              (arg (. entry digest))
              (arg (call copied-record arena (. entry record)))
              (arg (. entry counts))
              (arg (. entry pool))
              (arg (call copied-ids arena (. entry strings) (. entry string-count)))
              (arg (. entry string-count))
              (arg (. entry round))
            )
          )
        )
      )
    )
    (for (in old arenas)
      (call (. old release))
    )
    (call (. arenas clear))
    (+= arenas arena)
    (call (. entries clear))
    (call (. places clear))
    (for (in entry kept)
      (= ([] places (. entry digest high)) (as (. entries length) U32))
      (+= entries entry)
    )
  )
)

(type + RecordStore
  (prop + arena Arena)
  (prop + kept (list CachedRecord))
  (prop + used (list U32))
  (prop + cache BackendCache)
  (fn-do + This _
    (param cache BackendCache)
    (= (. this cache) cache)
  )
  (fn-do + keep _
    (param digest MIRDigest)
    (param record CompactFunction)
    (param counts FunctionCounts)
    (param pool U32)
    (param strings IdList)
    (+= kept
      (call CachedRecord
        (block
          (arg digest)
          (arg (call copied-record arena record))
          (arg counts)
          (arg pool)
          (arg (call copied-ids arena (. strings data) (. strings length)))
          (arg (. strings length))
          (arg (. cache round))
        )
      )
    )
  )
  (fn-do + reuse (? CompactFunction)
    (param place U32)
    (param results Arena)
    (param scratch Arena)
    (param order U32)
    (param pool U32)
    (param strings IdList)
    (let entry (call (. cache entry) place))
    (return-if null (if (!= (. entry string-count) (. strings length))))
    (blank)
    (let names (call new-id-map scratch (. entry string-count)))
    (for (in index (..< 0 (. entry string-count)))
      (= names (call (. names inserted) scratch ([] (. entry strings) index) ([] strings index)))
    )
    (let renaming (call StringRenaming names (. entry pool) pool))
    (let source (. entry record))
    (let symbol (call (. renaming renamed) (. source symbol)))
    (let display-name (call (. renaming renamed) (. source display-name)))
    (let source-file (call (. renaming renamed) (. source source-file)))
    (return-if null (if (or (not symbol) (not display-name) (not source-file))))
    (blank)
    (let relocations (call (of (. results allocate) Relocation) (. source relocation-count)))
    (for (in index (..< 0 (. source relocation-count)))
      (let relocation ([] (. source relocations) index))
      (let renamed (call (. renaming renamed) (. relocation symbol)))
      (return-if null (if (not renamed)))
      (blank)
      (= ([] relocations index) (call Relocation (. relocation offset) renamed (. relocation kind)))
    )
    (let jump-tables (call (of (. results allocate) CompactJumpTable) (. source jump-table-count)))
    (for (in index (..< 0 (. source jump-table-count)))
      (let table ([] (. source jump-tables) index))
      (let renamed (call (. renaming renamed) (. table name)))
      (return-if null (if (not renamed)))
      (blank)
      (= ([] jump-tables index) (call CompactJumpTable renamed (. table offset)))
    )
    (let line-records (call (of (. results allocate) CompactLineRecord) (. source line-record-count)))
    (for (in index (..< 0 (. source line-record-count)))
      (let line ([] (. source line-records) index))
      (let renamed (call (. renaming renamed) (. line file)))
      (return-if null (if (not renamed)))
      (blank)
      (= ([] line-records index) (call CompactLineRecord (. line pc-offset) renamed (. line line) (. line column)))
    )
    (let locations (call (of (. results allocate) CompactRootLocation) (. source location-count)))
    (for (in index (..< 0 (. source location-count)))
      (let location ([] (. source locations) index))
      (let renamed (call (. renaming renamed) (. location descriptor)))
      (return-if null (if (not renamed)))
      (blank)
      (= ([] locations index)
        (call CompactRootLocation
          (block
            (arg (. location kind))
            (arg (. location register))
            (arg (. location offset))
            (arg renamed)
          )
        )
      )
    )
    (+= used place)
    (return
      (call CompactFunction
        (block
          (arg (. source is-encoded))
          (arg order)
          (arg symbol)
          (arg (. source is-external))
          (arg (. source code))
          (arg relocations)
          (arg (. source relocation-count))
          (arg jump-tables)
          (arg (. source jump-table-count))
          (arg display-name)
          (arg source-file)
          (arg (. source source-line))
          (arg (. source source-column))
          (arg line-records)
          (arg (. source line-record-count))
          (arg (. source safepoints))
          (arg (. source safepoint-count))
          (arg locations)
          (arg (. source location-count))
          (arg (. source saved-registers))
          (arg (. source saved-register-count))
          (arg (. source pads))
          (arg (. source pad-count))
        )
      )
    )
  )
)

(type _ StringRenaming (is Tuple)
  (prop + names IdMap)
  (prop + from-pool U32)
  (prop + to-pool U32)
  (fn-expr + renamed (? StringId)
    (param id StringId)
    (case? (== id no-string)
      id
    )
    (case? (>= id from-pool)
      (+ (- id from-pool) to-pool)
    )
    (case? (== found no-id)
      null
    )
    (default
      found
    )
    (where
      (lazy found (call (. names get) id))
    )
  )
)

(fn-do _ copied-record CompactFunction
  (param arena Arena)
  (param source CompactFunction)
  (let code (call (. arena allocate-raw) (if-expr (!= (. source code length) 0) (. source code length) 1) 16))
  (call C:memcpy code (. source code data) (. source code length))
  (let relocations (call (of (. arena allocate) Relocation) (. source relocation-count)))
  (call C:memcpy
    (block
      (arg (as relocations (of CPointer Byte)))
      (arg (as (. source relocations) (of CPointer Byte)))
      (arg (* (. source relocation-count) (. Relocation size)))
    )
  )
  (let jump-tables (call (of (. arena allocate) CompactJumpTable) (. source jump-table-count)))
  (call C:memcpy
    (block
      (arg (as jump-tables (of CPointer Byte)))
      (arg (as (. source jump-tables) (of CPointer Byte)))
      (arg (* (. source jump-table-count) (. CompactJumpTable size)))
    )
  )
  (let line-records (call (of (. arena allocate) CompactLineRecord) (. source line-record-count)))
  (call C:memcpy
    (block
      (arg (as line-records (of CPointer Byte)))
      (arg (as (. source line-records) (of CPointer Byte)))
      (arg (* (. source line-record-count) (. CompactLineRecord size)))
    )
  )
  (let safepoints (call (of (. arena allocate) CompactSafepoint) (. source safepoint-count)))
  (call C:memcpy
    (block
      (arg (as safepoints (of CPointer Byte)))
      (arg (as (. source safepoints) (of CPointer Byte)))
      (arg (* (. source safepoint-count) (. CompactSafepoint size)))
    )
  )
  (let locations (call (of (. arena allocate) CompactRootLocation) (. source location-count)))
  (call C:memcpy
    (block
      (arg (as locations (of CPointer Byte)))
      (arg (as (. source locations) (of CPointer Byte)))
      (arg (* (. source location-count) (. CompactRootLocation size)))
    )
  )
  (let saved-registers (call (of (. arena allocate) CompactSavedRegister) (. source saved-register-count)))
  (call C:memcpy
    (block
      (arg (as saved-registers (of CPointer Byte)))
      (arg (as (. source saved-registers) (of CPointer Byte)))
      (arg (* (. source saved-register-count) (. CompactSavedRegister size)))
    )
  )
  (let pads (call (of (. arena allocate) CompactPad) (. source pad-count)))
  (call C:memcpy
    (block
      (arg (as pads (of CPointer Byte)))
      (arg (as (. source pads) (of CPointer Byte)))
      (arg (* (. source pad-count) (. CompactPad size)))
    )
  )
  (return
    (call CompactFunction
      (block
        (arg (. source is-encoded))
        (arg (. source order))
        (arg (. source symbol))
        (arg (. source is-external))
        (arg (call ByteSpan code (. source code length)))
        (arg relocations)
        (arg (. source relocation-count))
        (arg jump-tables)
        (arg (. source jump-table-count))
        (arg (. source display-name))
        (arg (. source source-file))
        (arg (. source source-line))
        (arg (. source source-column))
        (arg line-records)
        (arg (. source line-record-count))
        (arg safepoints)
        (arg (. source safepoint-count))
        (arg locations)
        (arg (. source location-count))
        (arg saved-registers)
        (arg (. source saved-register-count))
        (arg pads)
        (arg (. source pad-count))
      )
    )
  )
)

(fn-do _ copied-ids (of CPointer U32)
  (param arena Arena)
  (param source (of CPointer U32))
  (param count U32)
  (let copy (call (of (. arena allocate) U32) count))
  (call C:memcpy (as copy (of CPointer Byte)) (as source (of CPointer Byte)) (* (as count Size) 4))
  (return copy)
)
