(import ./builder)
(import ./mir)
(import /core/arena)
(import /core/table)

(type + MIRVariablesToRegisters
  (prop _ builder MIRBuilder)
  (prop _ function MIRFunction)
  (prop _ blocks IdList)
  (prop _ post-indexes (of CPointer U32))
  (prop _ doms (of CPointer U32))
  (prop _ climbed (of CPointer U32))
  (prop _ children (of CPointer IdList))
  (prop _ frontiers (of CPointer IdList))
  (prop _ promotable (of CPointer Byte))
  (prop _ promoted IdList)
  (prop _ def-blocks (of CPointer IdList))
  (prop _ exposed-use-blocks (of CPointer IdList))
  (prop _ block-phis (of CPointer IdList))
  (prop _ block-phi-variables (of CPointer IdList))
  (prop _ def-marks (of CPointer U32))
  (prop _ live-marks (of CPointer U32))
  (prop _ phi-marks (of CPointer U32))
  (prop _ variable-mark U32)
  (prop _ tops (of CPointer U32))
  (prop _ stack-variables IdList)
  (prop _ stack-values IdList)
  (prop _ stack-previous IdList)
  (prop _ alias-by-view (of CPointer U32))
  (prop _ alias-by-vreg (of CPointer U32))
  (prop _ view-count U32)
  (prop _ seen-vregs (of CPointer U32))
  (prop _ seen-mark U32)
  (prop _ promotes-narrow Bool)
  (fn-do + This _
    (param builder MIRBuilder)
    (param promotes-narrow Bool (= true))
    ; Without `promotes-narrow`, an object a byte or half-word access reads or writes stays in the
    ; frame, as the reference's backend leaves it.
    (lazy function (. builder function))
  )
  (fn-expr _ arena Arena :get @inline
    (. function arena)
  )
  (fn-do + run _
    (let order (call (. function post-order)))
    (let count (. order length))
    (if (== count 0)
      (return)
    )
    (= post-indexes (call (of (. arena allocate) U32) (. function blocks length)))
    (for (in index (..< 0 count))
      (= ([] post-indexes ([] order index)) index)
    )
    (= blocks (call new-id-list arena count))
    (for (in index (..< 0 count))
      (= blocks (call (. blocks appended) arena ([] order (- count 1 index))))
    )
    (call find-immediate-dominators)
    (call find-dominator-frontiers)
    (call find-promotable-variables)
    (call collect-def-blocks)
    (call promote)
  )
  (fn-do _ find-immediate-dominators _
    (let block-count (. function blocks length))
    (= doms (call (of (. arena allocate) U32) block-count))
    (= climbed (call (of (. arena allocate) U32) block-count))
    (for (in block (..< 0 block-count))
      (= ([] doms block) no-id)
    )
    (let entry ([] blocks 0))
    (= ([] doms entry) entry)
    (let join U32)
    (let changed true)
    (while changed
      (= changed false)
      (for (in position (..< 1 (. blocks length)))
        (let block ([] blocks position))
        (let predecessors (. ([] (. function blocks) block) predecessors))
        (let dominator no-id)
        (+= join 1)
        (for (in index (..< 0 (. predecessors length)))
          (let predecessor ([] predecessors index))
          (if (== ([] doms predecessor) no-id)
            (continue)
          )
          (if (== dominator no-id)
            (= dominator predecessor)
            (else
              (= dominator (call intersect predecessor dominator join))
            )
          )
        )
        (if (and (!= dominator no-id) (!= ([] doms block) dominator))
          (= ([] doms block) dominator)
          (= changed true)
        )
      )
    )
  )
  (fn-do _ intersect BlockId
    (param left BlockId)
    (param right BlockId)
    (param join U32)
    ; The nearest block that dominates both. `right` dominates the predecessors already joined at
    ; one block, and `join` numbers that block's turn. Every block a climb leaves is under the
    ; answer and is marked with the turn, so a later predecessor that climbs to a marked block is
    ; under `right` too, and no block is climbed twice in one turn.
    (let first left)
    (let second right)
    (while (!= first second)
      (while (< ([] post-indexes first) ([] post-indexes second))
        (if (== ([] climbed first) join)
          (return second)
        )
        (= ([] climbed first) join)
        (= first ([] doms first))
      )
      (while (< ([] post-indexes second) ([] post-indexes first))
        (= ([] climbed second) join)
        (= second ([] doms second))
      )
    )
    (return first)
  )
  (fn-do _ find-dominator-frontiers _
    (let block-count (. function blocks length))
    (= children (call (of (. arena allocate) IdList) block-count))
    (= frontiers (call (of (. arena allocate) IdList) block-count))
    (for (in position (..< 0 (. blocks length)))
      (let block ([] blocks position))
      (let dominator ([] doms block))
      (if (and (!= dominator no-id) (!= dominator block))
        (= ([] children dominator) (call (. ([] children dominator) appended) arena block))
      )
    )
    (blank)
    (let marks (call (of (. arena allocate) U32) block-count))
    (let order (call dominator-post-order ([] doms ([] blocks 0))))
    (for (in position (..< 0 (. order length)))
      (let block ([] order position))
      (let mark (+ block 1))
      (let frontier (call IdList))
      (let successors (. ([] (. function blocks) block) successors))
      (for (in index (..< 0 (. successors length)))
        (let successor ([] successors index))
        (if (and (!= ([] doms successor) block) (!= ([] marks successor) mark))
          (= ([] marks successor) mark)
          (= frontier (call (. frontier appended) arena successor))
        )
      )
      (let kids ([] children block))
      (for (in index (..< 0 (. kids length)))
        (let inherited ([] frontiers ([] kids index)))
        (for (in entry (..< 0 (. inherited length)))
          (let candidate ([] inherited entry))
          (if (and (!= ([] doms candidate) block) (!= ([] marks candidate) mark))
            (= ([] marks candidate) mark)
            (= frontier (call (. frontier appended) arena candidate))
          )
        )
      )
      (= ([] frontiers block) frontier)
    )
  )
  (fn-do _ dominator-post-order IdList
    (param root BlockId)
    (let order (call new-id-list arena (. blocks length)))
    (let pending (call (of (. arena allocate) U32) (. blocks length)))
    (let cursors (call (of (. arena allocate) U32) (. blocks length)))
    (let depth U32 1)
    (= ([] pending 0) root)
    (while (!= depth 0)
      (let block ([] pending (- depth 1)))
      (let kids ([] children block))
      (let cursor ([] cursors (- depth 1)))
      (if (< cursor (. kids length))
        (= ([] cursors (- depth 1)) (+ cursor 1))
        (= ([] pending depth) ([] kids cursor))
        (= ([] cursors depth) 0)
        (+= depth 1)
        (continue)
      )
      (= order (call (. order appended) arena block))
      (-= depth 1)
    )
    (return order)
  )
  (fn-do _ find-promotable-variables _
    (let object-count (. function frame-objects length))
    (= promotable (call (of (. arena allocate) Byte) object-count))
    (let vars (. function vars))
    (for (in index (..< 0 (. vars length)))
      (let variable ([] vars index))
      (if (. ([] (. function frame-objects) variable) can-promote)
        (= ([] promotable variable) 1)
      )
    )
    (blank)
    (for (in position (..< 0 (. blocks length)))
      (let instructions (. ([] (. function blocks) ([] blocks position)) instructions))
      (for (in index (..< 0 (. instructions length)))
        (let row ([] (. function instructions) ([] instructions index)))
        (let opcode (. row opcode))
        (let operands (. row operands))
        (for (in entry (..< 0 (. operands length)))
          (let object (call frame-object-of ([] operands entry)))
          (if (or (== object no-frame-object) (== ([] promotable object) 0))
            (continue)
          )
          (if (and (!= opcode .ldr) (!= opcode .str) (or (!= entry 1) (not promotes-narrow) (not is-narrow)))
            (= ([] promotable object) 0)
            (else-if (not (call has-compatible-register-class ([] operands 0) object))
              (= ([] promotable object) 0)
            )
          )
          (lazy is-narrow (call is-narrow-access opcode object))
        )
      )
    )
    (blank)
    (= promoted (call new-id-list arena (. vars length)))
    (for (in index (..< 0 (. vars length)))
      (let variable ([] vars index))
      (if (== ([] promotable variable) 1)
        (= ([] promotable variable) 2)
        (= promoted (call (. promoted appended) arena variable))
        (else-if (and (== ([] promotable variable) 0) (. ([] (. function frame-objects) variable) can-promote))
          (= (. ([] (. function frame-objects) variable) can-promote) false)
        )
      )
    )
    (if promotes-narrow
      (call widen-promoted-accesses)
    )
  )
  (fn-expr _ is-narrow-access Bool
    (param opcode Opcode)
    (param object FrameObjectId)
    (or (and byte-opcode (== size 1)) (and (or (== opcode .ldrh) (== opcode .strh)) (== size 2)))
    (where
      (lazy size (. ([] (. function types) (. ([] (. function frame-objects) object) type)) size))
      (lazy byte-opcode (or (== opcode .ldrb) (== opcode .strb)))
    )
  )
  (fn-do _ widen-promoted-accesses _
    (for (in position (..< 0 (. blocks length)))
      (let block ([] blocks position))
      (let instructions (. ([] (. function blocks) block) instructions))
      (let rebuilt (call new-id-list arena (. instructions length)))
      (let count U32)
      (for (in index (..< 0 (. instructions length)))
        (let id ([] instructions index))
        (let row ([] (. function instructions) id))
        (let opcode (. row opcode))
        (let operands (. row operands))
        (if (and narrow-opcode (!= (call promoted-object operands) no-frame-object))
          (if (or (== opcode .strb) (== opcode .strh))
            (let stored ([] operands 0))
            (let held (call view-of stored))
            (if (!= held no-id)
              (let narrowed
                (call (. builder vreg-operand)
                  (block
                    (arg (call (. builder new-vreg) (. ([] (. function vregs) held) reg-class)))
                  )
                )
              )
              (= rebuilt
                (call (. rebuilt appended)
                  (block
                    (arg arena)
                    (arg
                      (call (. builder new-assembly)
                        (block
                          (arg (if-expr (== opcode .strb) .uxtb .uxth))
                          (arg narrowed)
                          (arg stored)
                        )
                      )
                    )
                  )
                )
              )
              (= ([] (. operands data) 0) narrowed)
              (+= count 1)
            )
            (call rewrite-opcode id .str)
            (else
              (call rewrite-opcode id .ldr)
            )
          )
        )
        (lazy narrow-opcode (or (== opcode .strb) (== opcode .strh) (== opcode .ldrb) (== opcode .ldrh)))
        (= rebuilt (call (. rebuilt appended) arena id))
      )
      (if (!= count 0)
        (= (. ([] (. function blocks) block) instructions) rebuilt)
      )
    )
  )
  (fn-do _ rewrite-opcode _
    (param id InstructionId)
    (param opcode Opcode)
    (match? ([] (. function instructions) id)
      (case (call .assembly-instruction row)
        (= (. row opcode) opcode)
      )
    )
  )
  (fn-do _ has-compatible-register-class Bool
    (param value OperandId)
    (param variable FrameObjectId)
    (let type (. ([] (. function frame-objects) variable) type))
    (match? ([] (. function types) type)
      (case .array-type
        (return false)
      )
      (case .void-type
        (return false)
      )
    )
    (let expected (call (. builder type-reg-class) type))
    (match? ([] (. function operands) value)
      (case (call .vreg-operand operand)
        (return (== (. ([] (. function vregs) (. operand vreg)) reg-class) expected))
      )
      (case .preg-operand
        (return false)
      )
    )
    (return true)
  )
  (fn-do _ frame-object-of FrameObjectId
    (param operand OperandId)
    (match? ([] (. function operands) operand)
      (case (call .frame-object-operand row)
        (return (. row object))
      )
    )
    (return no-frame-object)
  )
  (fn-do _ collect-def-blocks _
    (let object-count (. function frame-objects length))
    (= def-blocks (call (of (. arena allocate) IdList) object-count))
    (= exposed-use-blocks (call (of (. arena allocate) IdList) object-count))
    (let defined (call (of (. arena allocate) U32) object-count))
    (for (in position (..< 0 (. blocks length)))
      (let block ([] blocks position))
      (let mark (+ position 1))
      (let instructions (. ([] (. function blocks) block) instructions))
      (for (in index (..< 0 (. instructions length)))
        (let row ([] (. function instructions) ([] instructions index)))
        (let opcode (. row opcode))
        (if (and (!= opcode .str) (!= opcode .ldr))
          (continue)
        )
        (let operands (. row operands))
        (if (< (. operands length) 2)
          (continue)
        )
        (let object (call frame-object-of ([] operands 1)))
        (if (== object no-frame-object)
          (continue)
        )
        (if (== opcode .str)
          (= ([] def-blocks object) (call with-block ([] def-blocks object) block))
          (= ([] defined object) mark)
          (else-if (!= ([] defined object) mark)
            (= ([] exposed-use-blocks object) (call with-block ([] exposed-use-blocks object) block))
          )
        )
      )
    )
  )
  (fn-do _ with-block IdList
    (param list IdList)
    (param block BlockId)
    (if (and (!= (. list length) 0) (== ([] list (- (. list length) 1)) block))
      (return list)
    )
    (return (call (. list appended) arena block))
  )
  (fn-do _ promote _
    (let block-count (. function blocks length))
    (let object-count (. function frame-objects length))
    (= block-phis (call (of (. arena allocate) IdList) block-count))
    (= block-phi-variables (call (of (. arena allocate) IdList) block-count))
    (= def-marks (call (of (. arena allocate) U32) block-count))
    (= live-marks (call (of (. arena allocate) U32) block-count))
    (= phi-marks (call (of (. arena allocate) U32) block-count))
    (= variable-mark 0)
    (for (in index (..< 0 (. promoted length)))
      (call place-phi-nodes ([] promoted index))
    )
    (blank)
    (= tops (call (of (. arena allocate) U32) object-count))
    (= stack-variables (call IdList))
    (= stack-values (call IdList))
    (= stack-previous (call IdList))
    (= view-count (as (. function vregs length) U32))
    (= alias-by-view (call (of (. arena allocate) U32) view-count))
    (= alias-by-vreg (call (of (. arena allocate) U32) (. function vreg-count)))
    (= seen-vregs (call (of (. arena allocate) U32) (. function vreg-count)))
    (= seen-mark 0)
    (call rewrite)
    (call settle-phis)
  )
  (fn-do _ settle-phis _
    ; Resolves again what each phi takes from its predecessors. A phi the function had before this
    ; pass, as one an earlier promotion placed at the head of a loop, can take a value loaded in a
    ; block the dominator walk reaches after the phi's own, which only then has the value it loads.
    (for (in position (..< 0 (. blocks length)))
      (let instructions (. ([] (. function blocks) ([] blocks position)) instructions))
      (for (in index (..< 0 (. instructions length)))
        (let id ([] instructions index))
        (if (== (. ([] (. function instructions) id) opcode) .phi)
          (let exprs (call phi-exprs id))
          (for (in entry (..< 0 (. exprs length)))
            (= ([] (. exprs data) entry) (call resolve-alias ([] exprs entry)))
          )
        )
      )
    )
  )
  (fn-do _ place-phi-nodes _
    (param variable FrameObjectId)
    (+= variable-mark 1)
    (let mark variable-mark)
    (let defs ([] def-blocks variable))
    (for (in index (..< 0 (. defs length)))
      (= ([] def-marks ([] defs index)) mark)
    )
    (blank)
    (let work (call copied ([] exposed-use-blocks variable)))
    (while (!= (. work length) 0)
      (let block ([] work (- (. work length) 1)))
      (= work (call IdList (. work data) (- (. work length) 1) (. work capacity)))
      (if (== ([] live-marks block) mark)
        (continue)
      )
      (= ([] live-marks block) mark)
      (let predecessors (. ([] (. function blocks) block) predecessors))
      (for (in index (..< 0 (. predecessors length)))
        (let predecessor ([] predecessors index))
        (if (and (!= ([] live-marks predecessor) mark) (!= ([] def-marks predecessor) mark))
          (= work (call (. work appended) arena predecessor))
        )
      )
    )
    (blank)
    (= work (call copied defs))
    (while (!= (. work length) 0)
      (let block ([] work (- (. work length) 1)))
      (= work (call IdList (. work data) (- (. work length) 1) (. work capacity)))
      (let frontier ([] frontiers block))
      (for (in index (..< 0 (. frontier length)))
        (let target ([] frontier index))
        (if (or (== ([] phi-marks target) mark) (!= ([] live-marks target) mark))
          (continue)
        )
        (call insert-phi-stub target variable)
        (= ([] phi-marks target) mark)
        (if (!= ([] def-marks target) mark)
          (= ([] def-marks target) mark)
          (= work (call (. work appended) arena target))
        )
      )
    )
  )
  (fn-do _ copied IdList
    (param list IdList)
    (let copy (call new-id-list arena (. list length)))
    (for (in index (..< 0 (. list length)))
      (= ([] (. copy data) index) ([] list index))
    )
    (return (call IdList (. copy data) (. list length) (. copy capacity)))
  )
  (fn-do _ insert-phi-stub _
    (param block BlockId)
    (param variable FrameObjectId)
    (let type (. ([] (. function frame-objects) variable) type))
    (let gc-root (. ([] (. function frame-objects) variable) gc-root))
    (let gc-descriptor (. ([] (. function frame-objects) variable) gc-descriptor))
    (let gc-root-mode (. ([] (. function frame-objects) variable) gc-root-mode))
    (call (. builder set-insert-block) block)
    (let register
      (call (. builder new-vreg)
        (block
          (arg (call (. builder type-reg-class) type))
          (arg no-register)
          (arg gc-root)
          (arg gc-descriptor)
          (arg gc-root-mode)
        )
      )
    )
    (let phi (call (. builder phi) (call (. builder vreg-operand) register)))
    (blank)
    (let predecessors (. ([] (. function blocks) block) predecessors))
    (let exprs (call new-id-list arena (. predecessors length)))
    (let names (call new-id-list arena (. predecessors length)))
    (for (in index (..< 0 (. predecessors length)))
      (= exprs (call (. exprs appended) arena (call (. builder add-operand) (call PlaceholderOperand))))
      (= names (call (. names appended) arena (. ([] (. function blocks) ([] predecessors index)) name)))
    )
    (match? ([] (. function instructions) phi)
      (case (call .phi-instruction row)
        (= (. row exprs) exprs)
        (= (. row blocks) names)
      )
    )
    (= ([] block-phis block) (call (. ([] block-phis block) appended) arena phi))
    (= ([] block-phi-variables block) (call (. ([] block-phi-variables block) appended) arena variable))
  )
  (fn-do _ rewrite _
    (let count (. blocks length))
    (let frame-blocks (call (of (. arena allocate) U32) count))
    (let frame-cursors (call (of (. arena allocate) U32) count))
    (let frame-starts (call (of (. arena allocate) U32) count))
    (let frame-entered (call (of (. arena allocate) Byte) count))
    (let depth U32 1)
    (= ([] frame-blocks 0) ([] blocks 0))
    (while (!= depth 0)
      (let top (- depth 1))
      (let block ([] frame-blocks top))
      (if (== ([] frame-entered top) 0)
        (= ([] frame-entered top) 1)
        (= ([] frame-starts top) (. stack-values length))
        (call rewrite-block-contents block)
      )
      (let kids ([] children block))
      (let cursor ([] frame-cursors top))
      (if (< cursor (. kids length))
        (= ([] frame-cursors top) (+ cursor 1))
        (= ([] frame-blocks depth) ([] kids cursor))
        (= ([] frame-cursors depth) 0)
        (= ([] frame-entered depth) 0)
        (+= depth 1)
        (continue)
      )
      (call unwind ([] frame-starts top))
      (-= depth 1)
    )
  )
  (fn-do _ rewrite-block-contents _
    (param block BlockId)
    (let phis ([] block-phis block))
    (let variables ([] block-phi-variables block))
    (for (in index (..< 0 (. phis length)))
      (call push ([] variables index) (call phi-register ([] phis index)))
    )
    (blank)
    (let instructions (call (. builder take-instructions) block))
    (for (in index (..< 0 (. instructions length)))
      (let id ([] instructions index))
      (let row ([] (. function instructions) id))
      (let opcode (. row opcode))
      (let operands (. row operands))
      (let variable no-frame-object)
      (if (or (== opcode .str) (== opcode .ldr))
        (= variable (call promoted-object operands))
      )
      (if (== variable no-frame-object)
        (call rewrite-instruction id opcode operands)
        (call (. builder append) id)
        (else-if (== opcode .str)
          (call push variable (call resolve-alias ([] operands 0)))
        )
        (else
          (let value (call top-value variable))
          (if (!= value no-operand)
            (call set-alias ([] operands 0) (call resolve-alias value))
          )
        )
      )
    )
    (blank)
    (let successors (. ([] (. function blocks) block) successors))
    (for (in index (..< 0 (. successors length)))
      (let successor ([] successors index))
      (let incoming ([] block-phis successor))
      (if (== (. incoming length) 0)
        (continue)
      )
      (let argument (call predecessor-index successor block))
      (if (== argument no-id)
        (continue)
      )
      (let incoming-variables ([] block-phi-variables successor))
      (for (in entry (..< 0 (. incoming length)))
        (let value (call top-value ([] incoming-variables entry)))
        (if (!= value no-operand)
          (= ([] (. (call phi-exprs ([] incoming entry)) data) argument) value)
        )
      )
    )
  )
  (fn-do _ rewrite-instruction _
    (param id InstructionId)
    (param opcode Opcode)
    (param operands IdList)
    (for (in position (..< 0 (. operands length)))
      (let operand ([] operands position))
      (let replacement (call resolve-alias operand))
      (if (!= replacement operand)
        (= ([] (. operands data) position) replacement)
      )
      (call rewrite-operand-vregs operand)
    )
    (if (== opcode .phi)
      (let exprs (call phi-exprs id))
      (for (in position (..< 0 (. exprs length)))
        (= ([] (. exprs data) position) (call resolve-alias ([] exprs position)))
      )
    )
  )
  (fn-do _ rewrite-operand-vregs _
    (param operand OperandId)
    (let is-address false)
    (let base no-operand)
    (let offset no-operand)
    (let members Span)
    (match? ([] (. function operands) operand)
      (case (call .load-address-operand address)
        (= is-address true)
        (= base (. address base))
        (= offset (. address offset))
      )
      (case (call .vreg-group-operand group)
        (= members (. group vregs))
      )
    )
    (if is-address
      (let new-base base)
      (if (call is-vreg base)
        (= new-base (call resolve-alias base))
      )
      (let new-offset offset)
      (if (and (!= offset no-operand) (call is-vreg offset))
        (= new-offset (call resolve-alias offset))
      )
      (if (or (!= new-base base) (!= new-offset offset))
        (match? ([] (. function operands) operand)
          (case (call .load-address-operand address)
            (= (. address base) new-base)
            (= (. address offset) new-offset)
          )
        )
      )
      (return)
    )
    (for (in index (..< (. members start) (. members end)))
      (let view ([] (. function group-vregs) index))
      (if (== (call view-alias view) no-operand)
        (continue)
      )
      (let replacement (call resolve-alias (call (. builder vreg-operand) view)))
      (let aliased (call view-of replacement))
      (throw (call Panic "A register group member is replaced by a value that is not a register") (if (== aliased no-id)))
      (= ([] (. function group-vregs data) index) aliased)
    )
  )
  (fn-expr _ promoted-object FrameObjectId
    (param operands IdList)
    (case? (< (. operands length) 2)
      no-frame-object
    )
    (case? (and (!= object no-frame-object) (!= ([] promotable object) 0))
      object
    )
    (default
      no-frame-object
    )
    (where
      (lazy object (call frame-object-of ([] operands 1)))
    )
  )
  (fn-do _ phi-register OperandId
    (param phi InstructionId)
    (match? ([] (. function instructions) phi)
      (case (call .phi-instruction row)
        (return (. row reg))
      )
    )
    (return no-operand)
  )
  (fn-do _ phi-exprs IdList
    (param phi InstructionId)
    (match? ([] (. function instructions) phi)
      (case (call .phi-instruction row)
        (return (. row exprs))
      )
    )
    (return (call IdList))
  )
  (fn-do _ predecessor-index U32
    (param block BlockId)
    (param predecessor BlockId)
    (let predecessors (. ([] (. function blocks) block) predecessors))
    (let found no-id)
    (for (in index (..< 0 (. predecessors length)))
      (if (== ([] predecessors index) predecessor)
        (= found index)
      )
    )
    (return found)
  )
  (fn-do _ push _
    (param variable FrameObjectId)
    (param value OperandId)
    (= stack-previous (call (. stack-previous appended) arena ([] tops variable)))
    (= stack-variables (call (. stack-variables appended) arena variable))
    (= stack-values (call (. stack-values appended) arena value))
    (= ([] tops variable) (. stack-values length))
  )
  (fn-expr _ top-value OperandId
    (param variable FrameObjectId)
    (if-expr (== top 0) no-operand ([] stack-values (- top 1)))
    (where
      (lazy top ([] tops variable))
    )
  )
  (fn-do _ unwind _
    (param start U32)
    (let length (. stack-values length))
    (while (> length start)
      (-= length 1)
      (= ([] tops ([] stack-variables length)) ([] stack-previous length))
    )
    (= stack-previous (call IdList (. stack-previous data) start (. stack-previous capacity)))
    (= stack-variables (call IdList (. stack-variables data) start (. stack-variables capacity)))
    (= stack-values (call IdList (. stack-values data) start (. stack-values capacity)))
  )
  (fn-do _ set-alias _
    (param from OperandId)
    (param to OperandId)
    (match? ([] (. function operands) from)
      (case (call .vreg-operand row)
        (throw (call Panic "A promoted load targets a register view made during promotion") (if (>= (. row vreg) view-count)))
        (= ([] alias-by-view (. row vreg)) (+ to 1))
        (= ([] alias-by-vreg (. ([] (. function vregs) (. row vreg)) id)) (+ to 1))
      )
    )
  )
  (fn-do _ resolve-alias OperandId
    (param operand OperandId)
    (let first (call direct-alias operand))
    (if (== first no-operand)
      (return operand)
    )
    (if (call same-key operand first)
      (return (call coerced operand first))
    )
    (let second (call direct-alias first))
    (if (== second no-operand)
      (return (call coerced operand first))
    )
    (blank)
    (+= seen-mark 1)
    (call mark-seen operand)
    (call mark-seen first)
    (let current second)
    (while true
      (if (call mark-seen current)
        (break)
      )
      (let next (call direct-alias current))
      (if (== next no-operand)
        (break)
      )
      (= current next)
    )
    (return (call coerced operand current))
  )
  (fn-do _ direct-alias OperandId
    (param operand OperandId)
    (match? ([] (. function operands) operand)
      (case (call .vreg-operand row)
        (return (call view-alias (. row vreg)))
      )
    )
    (return no-operand)
  )
  (fn-expr _ view-alias OperandId
    (param view VRegId)
    (case? (and (< view view-count) (!= direct 0))
      (- direct 1)
    )
    (case? (!= shared 0)
      (- shared 1)
    )
    (default
      no-operand
    )
    (where
      (lazy direct ([] alias-by-view view))
      (lazy shared ([] alias-by-vreg (. ([] (. function vregs) view) id)))
    )
  )
  (fn-expr _ same-key Bool
    (param left OperandId)
    (param right OperandId)
    (or (== left right) (and (!= vreg no-id) (== vreg (call vreg-id right))))
    (where
      (lazy vreg (call vreg-id left))
    )
  )
  (fn-do _ mark-seen Bool
    (param operand OperandId)
    (let vreg (call vreg-id operand))
    (if (!= vreg no-id)
      (let was-seen (== ([] seen-vregs vreg) seen-mark))
      (= ([] seen-vregs vreg) seen-mark)
      (return was-seen)
    )
    (return false)
  )
  (fn-do _ coerced OperandId
    (param original OperandId)
    (param alias OperandId)
    (let original-view (call view-of original))
    (let alias-view (call view-of alias))
    (if (or (== original-view no-id) (== alias-view no-id))
      (return alias)
    )
    (let reg-class (. ([] (. function vregs) original-view) reg-class))
    (if (== reg-class (. ([] (. function vregs) alias-view) reg-class))
      (return alias)
    )
    (let id (. ([] (. function vregs) alias-view) id))
    (let hint (. ([] (. function vregs) alias-view) hint))
    (let gc-root (or (. ([] (. function vregs) original-view) gc-root) (. ([] (. function vregs) alias-view) gc-root)))
    (let gc-descriptor (. ([] (. function vregs) original-view) gc-descriptor))
    (if (== gc-descriptor no-string)
      (= gc-descriptor (. ([] (. function vregs) alias-view) gc-descriptor))
    )
    (let gc-root-mode (. ([] (. function vregs) original-view) gc-root-mode))
    (let view VRegId (as (. function vregs length) VRegId))
    (call (. function vregs append) (call MIRVirtualRegister id reg-class hint gc-root gc-descriptor gc-root-mode))
    (return (call (. builder vreg-operand) view))
  )
  (fn-do _ view-of VRegId
    (param operand OperandId)
    (match? ([] (. function operands) operand)
      (case (call .vreg-operand row)
        (return (. row vreg))
      )
    )
    (return no-id)
  )
  (fn-do _ vreg-id U32
    (param operand OperandId)
    (match? ([] (. function operands) operand)
      (case (call .vreg-operand row)
        (return (. ([] (. function vregs) (. row vreg)) id))
      )
    )
    (return no-id)
  )
  (fn-do _ is-vreg Bool
    (param operand OperandId)
    (match? ([] (. function operands) operand)
      (case .vreg-operand
        (return true)
      )
    )
    (return false)
  )
)
