(import ./builder)
(import ./bundle)
(import ./mir)
(import /core/arena)
(import /core/table)
(blank)
(prop _ site-buffer-offset I64 (= 48))
(prop _ cursor-offset I64)
(prop _ limit-offset I64 (= 8))
(prop _ slot-size-offset I64 (= 24))
(prop _ generation-offset I64 (= 48))
(prop _ handshake-requested-bit I64 (= 8))
(prop _ sweep-generation-shift I64 (= 32))
(prop _ not-equal-condition U32 (= 1))
(prop _ higher-condition U32 (= 8))

(type + MIRGCWriteBarrierLowering
  (prop _ builder MIRBuilder)
  (prop _ bundle Bundle)
  (prop _ function MIRFunction)
  (fn-do + This _
    (param builder MIRBuilder)
    (lazy bundle (. builder bundle))
    (lazy function (. builder function))
  )
  (fn-do + run _
    (call lower-barriers)
    (call lower-allocations)
  )
  (fn-do _ lower-barriers _
    (if (not (call has .gc-barrier))
      (return)
    )
    (let arena (. function arena))
    (let control-address (call control-address))
    (let next-id U32 1)
    (let position U32)
    (while (< position (. function block-order length))
      (let block ([] (. function block-order) position))
      (+= position 1)
      (while true
        (let instructions (. ([] (. function blocks) block) instructions))
        (let barrier-index (call first instructions .gc-barrier))
        (if (== barrier-index no-id)
          (break)
        )
        (let barrier ([] (. function instructions) ([] instructions barrier-index)))
        (let given (. barrier operands))
        (let loc (. barrier loc))
        (let zone (. barrier gc-free-zone))
        (let suffix-length (- (. instructions length) barrier-index 1))
        (let suffix (call new-id-list arena suffix-length))
        (for (in index (..< 0 suffix-length))
          (= suffix (call (. suffix appended) arena ([] instructions (+ barrier-index 1 index))))
        )
        (= (. ([] (. function blocks) block) instructions)
          (call IdList
            (block
              (arg (. instructions data))
              (arg barrier-index)
              (arg (. instructions capacity))
            )
          )
        )
        (blank)
        (let original-successors (. ([] (. function blocks) block) successors))
        (let id next-id)
        (+= next-id 1)
        (let record-block
          (call (. builder add-block)
            (block
              (arg (call (. function add-local-name) .barrier-record-name no-string no-string id))
            )
          )
        )
        (let after-block
          (call (. builder add-block)
            (block
              (arg (call (. function add-local-name) .barrier-after-name no-string no-string id))
            )
          )
        )
        (= (. ([] (. function blocks) after-block) instructions) suffix)
        (= (. ([] (. function blocks) after-block) successors) original-successors)
        (let block-name (. ([] (. function blocks) block) name))
        (let after-name (. ([] (. function blocks) after-block) name))
        (for (in index (..< 0 (. original-successors length)))
          (call retarget-successor
            (block
              (arg ([] original-successors index))
              (arg block)
              (arg after-block)
              (arg block-name)
              (arg after-name)
            )
          )
        )
        (blank)
        (= (. ([] (. function blocks) block) successors) (call IdList))
        (call (. builder set-insert-block) block)
        (let after-label (call (. builder block-label) after-block))
        (let record-label (call (. builder block-label) record-block))
        (let control (call (. builder vreg) .gpr64))
        (let phase (call (. builder vreg) .gpr64))
        (call (. builder load-acquire) control control-address u64-type-id)
        (call (. builder and) phase control (call (. builder small-int) (. bundle gc-control-phase-mask)))
        (call (. builder cbnz) phase record-label)
        (call (. builder b) after-label)
        (call link block record-block)
        (call link block after-block)
        (blank)
        (call (. builder set-insert-block) record-block)
        (if (== (. given length) 4)
          (call (. builder runtime-call)
            (block
              (arg (. bundle bulk-write-barrier-symbol))
              (arg loc)
              (arg ([] given 0))
              (arg ([] given 1))
              (arg ([] given 2))
              (arg ([] given 3))
            )
          )
          (else
            (call (. builder runtime-call) (. bundle write-barrier-record-symbol) loc ([] given 0) ([] given 1))
          )
        )
        (call (. builder b) after-label)
        (call link record-block after-block)
        (call set-zone (. ([] (. function blocks) block) instructions) barrier-index zone)
        (call set-zone (. ([] (. function blocks) record-block) instructions) 0 zone)
        (throw (call Panic "GC barrier continuation lost its predecessors") (if (== (. ([] (. function blocks) after-block) predecessors length) 0)))
      )
    )
  )
  (fn-do _ lower-allocations _
    (if (not (call has .gc-alloc))
      (return)
    )
    (let arena (. function arena))
    (let control-address (call control-address))
    (let next-id U32 1)
    (let position U32)
    (while (< position (. function block-order length))
      (let block ([] (. function block-order) position))
      (+= position 1)
      (while true
        (let instructions (. ([] (. function blocks) block) instructions))
        (let allocation-index (call first instructions .gc-alloc))
        (if (== allocation-index no-id)
          (break)
        )
        (let allocation ([] (. function instructions) ([] instructions allocation-index)))
        (let result ([] (. allocation operands) 0))
        (let site ([] (. allocation operands) 1))
        (let loc (. allocation loc))
        (let suffix-length (- (. instructions length) allocation-index 1))
        (let suffix (call new-id-list arena suffix-length))
        (for (in index (..< 0 suffix-length))
          (= suffix (call (. suffix appended) arena ([] instructions (+ allocation-index 1 index))))
        )
        (= (. ([] (. function blocks) block) instructions)
          (call IdList
            (block
              (arg (. instructions data))
              (arg allocation-index)
              (arg (. instructions capacity))
            )
          )
        )
        (blank)
        (let original-successors (. ([] (. function blocks) block) successors))
        (let id next-id)
        (+= next-id 1)
        (let slow-block
          (call (. builder add-block)
            (block
              (arg (call (. function add-local-name) .allocation-slow-name no-string no-string id))
            )
          )
        )
        (let after-block
          (call (. builder add-block)
            (block
              (arg (call (. function add-local-name) .allocation-after-name no-string no-string id))
            )
          )
        )
        (= (. ([] (. function blocks) after-block) instructions) suffix)
        (= (. ([] (. function blocks) after-block) successors) original-successors)
        (let block-name (. ([] (. function blocks) block) name))
        (let after-name (. ([] (. function blocks) after-block) name))
        (for (in index (..< 0 (. original-successors length)))
          (call retarget-successor
            (block
              (arg ([] original-successors index))
              (arg block)
              (arg after-block)
              (arg block-name)
              (arg after-name)
            )
          )
        )
        (blank)
        (= (. ([] (. function blocks) block) successors) (call IdList))
        (call (. builder set-insert-block) block)
        (let slow-label (call (. builder block-label) slow-block))
        (let after-label (call (. builder block-label) after-block))
        (let offset (call (. builder vreg) .gpr64))
        (call (. builder load) offset (call (. builder load-address-offset) site site-buffer-offset) u64-type-id)
        (call (. builder asm) .cbz offset slow-label)
        (let base (call (. builder vreg) .gpr64))
        (call (. builder call)
          (block
            (arg pointer-type-id)
            (arg (call (. builder symbol) (. bundle thread-cache-symbol)))
            (arg base)
            (arg no-loc)
            (arg (call IdList))
            (arg (call IdList))
          )
        )
        (let cache (call (. builder vreg) .gpr64))
        (call (. builder load) cache base pointer-type-id)
        (let buffer (call (. builder vreg) .gpr64))
        (call (. builder add) buffer cache offset)
        (let control (call (. builder vreg) .gpr64))
        (let handshake (call (. builder vreg) .gpr64))
        (call (. builder load-acquire) control control-address u64-type-id)
        (call (. builder and) handshake control (call (. builder small-int) handshake-requested-bit))
        (call (. builder cbnz) handshake slow-label)
        (let cursor (call (. builder vreg) .gpr64))
        (let limit (call (. builder vreg) .gpr64))
        (let slot-size (call (. builder vreg) .gpr64))
        (let generation (call (. builder vreg) .gpr64))
        (let published (call (. builder vreg) .gpr64))
        (call (. builder load) cursor (call (. builder load-address-offset) buffer cursor-offset) pointer-type-id)
        (call (. builder load) limit (call (. builder load-address-offset) buffer limit-offset) pointer-type-id)
        (call (. builder load) slot-size (call (. builder load-address-offset) buffer slot-size-offset) u64-type-id)
        (call (. builder load)
          (block
            (arg generation)
            (arg (call (. builder load-address-offset) buffer generation-offset))
            (arg u64-type-id)
          )
        )
        (call (. builder asm) .lsr published control (call (. builder small-int) sweep-generation-shift))
        (call (. builder asm) .cmp generation published)
        (call (. builder asm) .b-cond slow-label (call (. builder add-operand) (call CondOperand not-equal-condition)))
        (call (. builder asm) .cbz cursor slow-label)
        (let next (call (. builder vreg) .gpr64))
        (call (. builder add) next cursor slot-size)
        (call (. builder asm) .cmp next limit)
        (call (. builder asm) .b-cond slow-label (call (. builder add-operand) (call CondOperand higher-condition)))
        (call (. builder store) (call (. builder load-address-offset) buffer cursor-offset) next pointer-type-id)
        (call (. builder b) after-label)
        (call link block slow-block)
        (call link block after-block)
        (blank)
        (call (. builder set-insert-block) slow-block)
        (let refilled (call (. builder vreg) .gpr64))
        (let arguments (call (. (call new-id-list arena 1) appended) arena site))
        (let types (call (. (call new-id-list arena 1) appended) arena pointer-type-id))
        (call (. builder call)
          (block
            (arg pointer-type-id)
            (arg (call (. builder symbol) (. bundle allocation-refill-symbol)))
            (arg refilled)
            (arg loc)
            (arg arguments)
            (arg types)
          )
        )
        (call (. builder b) after-label)
        (call link slow-block after-block)
        (blank)
        (call (. builder set-insert-block) after-block)
        (let exprs (call (. (call (. (call new-id-list arena 2) appended) arena cursor) appended) arena refilled))
        (let names
          (call (. (call (. (call new-id-list arena 2) appended) arena block-name) appended)
            (block
              (arg arena)
              (arg (. ([] (. function blocks) slow-block) name))
            )
          )
        )
        (call (. builder phi-of) result exprs names)
      )
    )
  )
  (fn-do _ has Bool
    (param opcode Opcode)
    (let order (. function block-order))
    (for (in position (..< 0 (. order length)))
      (if (!= (call first (. ([] (. function blocks) ([] order position)) instructions) opcode) no-id)
        (return true)
      )
    )
    (return false)
  )
  (fn-do _ first U32
    (param instructions IdList)
    (param opcode Opcode)
    (for (in index (..< 0 (. instructions length)))
      (if (== (. ([] (. function instructions) ([] instructions index)) opcode) opcode)
        (return index)
      )
    )
    (return no-id)
  )
  (fn-do _ set-zone _
    (param instructions IdList)
    (param start U32)
    (param zone Bool)
    (for (in index (..< start (. instructions length)))
      (= (. ([] (. function instructions) ([] instructions index)) gc-free-zone) zone)
    )
  )
  (fn-do _ retarget-successor _
    (param successor BlockId)
    (param block BlockId)
    (param after-block BlockId)
    (param block-name StringId)
    (param after-name StringId)
    (let predecessors (. ([] (. function blocks) successor) predecessors))
    (for (in index (..< 0 (. predecessors length)))
      (if (== ([] predecessors index) block)
        (= ([] (. predecessors data) index) after-block)
      )
    )
    (let instructions (. ([] (. function blocks) successor) instructions))
    (for (in index (..< 0 (. instructions length)))
      (match? ([] (. function instructions) ([] instructions index))
        (case (call .phi-instruction phi)
          (let names (. phi blocks))
          (for (in entry (..< 0 (. names length)))
            (if (== ([] names entry) block-name)
              (= ([] (. names data) entry) after-name)
            )
          )
        )
      )
    )
  )
  (fn-do _ link _
    (param from BlockId)
    (param to BlockId)
    (let arena (. function arena))
    (= (. ([] (. function blocks) from) successors) (call (. ([] (. function blocks) from) successors appended) arena to))
    (= (. ([] (. function blocks) to) predecessors) (call (. ([] (. function blocks) to) predecessors appended) arena from))
  )
  (fn-do _ control-address OperandId
    (let arena (. function arena))
    (let entry ([] (. function block-order) 0))
    (let previous-length (. ([] (. function blocks) entry) instructions length))
    (call (. builder set-insert-block) entry)
    (let address (call (. builder symbol-address) (call (. builder symbol) (. bundle gc-public-control-word-symbol))))
    (blank)
    (let instructions (. ([] (. function blocks) entry) instructions))
    (let insertion U32)
    (while (and (< insertion previous-length) (== (. ([] (. function instructions) ([] instructions insertion)) opcode) .phi))
      (+= insertion 1)
    )
    (let count (- (. instructions length) previous-length))
    (let reordered (call new-id-list arena (. instructions length)))
    (for (in index (..< 0 insertion))
      (= ([] (. reordered data) index) ([] instructions index))
    )
    (for (in index (..< 0 count))
      (= ([] (. reordered data) (+ insertion index)) ([] instructions (+ previous-length index)))
    )
    (for (in index (..< insertion previous-length))
      (= ([] (. reordered data) (+ count index)) ([] instructions index))
    )
    (= (. ([] (. function blocks) entry) instructions)
      (call IdList
        (block
          (arg (. reordered data))
          (arg (. instructions length))
          (arg (. reordered capacity))
        )
      )
    )
    (return address)
  )
)
