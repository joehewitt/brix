./builder
./bundle
./mir
/core/arena
/core/table

_ site-buffer-offset I64 = 48
_ cursor-offset I64
_ limit-offset I64 = 8
_ slot-size-offset I64 = 24
_ generation-offset I64 = 48
_ handshake-requested-bit I64 = 8
_ sweep-generation-shift I64 = 32
_ not-equal-condition U32 = 1
_ higher-condition U32 = 8

━━━━━━━━━━━━━━━━━━━━
+ MIRGCWriteBarrierLowering

_ builder MIRBuilder
_ bundle Bundle
_ function MIRFunction

────────────────────
+ This
    - builder MIRBuilder

.. bundle = builder.bundle
.. function = builder.function

────────────────────
+ do run

lower-barriers()
lower-allocations()

────────────────────
_ do lower-barriers

if !has(.gc-barrier)
    =
. arena = function.arena
. control-address = control-address()
. next-id U32 = 1
. position U32
while position < function.block-order.length
    . block = function.block-order[position]
    position += 1
    while true
        . instructions = function.blocks[block].instructions
        . barrier-index = first(instructions, .gc-barrier)
        if barrier-index == no-id
            break
        . barrier = function.instructions[instructions[barrier-index]]
        . given = barrier.operands
        . loc = barrier.loc
        . zone = barrier.gc-free-zone
        . suffix-length = instructions.length - barrier-index - 1
        . suffix = new-id-list(arena, suffix-length)
        for index in 0 .. < suffix-length
            suffix = suffix.appended(arena, instructions[barrier-index + 1 + index])
        function.blocks[block].instructions = IdList
            - instructions.data
            - barrier-index
            - instructions.capacity

        . original-successors = function.blocks[block].successors
        . id = next-id
        next-id += 1
        . record-block = builder.add-block
            - function.add-local-name(.barrier-record-name, no-string, no-string, id)
        . after-block = builder.add-block
            - function.add-local-name(.barrier-after-name, no-string, no-string, id)
        function.blocks[after-block].instructions = suffix
        function.blocks[after-block].successors = original-successors
        . block-name = function.blocks[block].name
        . after-name = function.blocks[after-block].name
        for index in 0 .. < original-successors.length
            retarget-successor
                - original-successors[index]
                - block
                - after-block
                - block-name
                - after-name

        function.blocks[block].successors = IdList()
        builder.set-insert-block(block)
        . after-label = builder.block-label(after-block)
        . record-label = builder.block-label(record-block)
        . control = builder.vreg(.gpr64)
        . phase = builder.vreg(.gpr64)
        builder.load-acquire(control, control-address, u64-type-id)
        builder.and(phase, control, builder.small-int(bundle.gc-control-phase-mask))
        builder.cbnz(phase, record-label)
        builder.b(after-label)
        link(block, record-block)
        link(block, after-block)

        builder.set-insert-block(record-block)
        if given.length == 4
            builder.runtime-call
                - bundle.bulk-write-barrier-symbol
                - loc
                - given[0]
                - given[1]
                - given[2]
                - given[3]
        else
            builder.runtime-call(bundle.write-barrier-record-symbol, loc, given[0], given[1])
        builder.b(after-label)
        link(record-block, after-block)
        set-zone(function.blocks[block].instructions, barrier-index, zone)
        set-zone(function.blocks[record-block].instructions, 0, zone)
        ?! Panic("GC barrier continuation lost its predecessors")
            if function.blocks[after-block].predecessors.length == 0

────────────────────
_ do lower-allocations

if !has(.gc-alloc)
    =
. arena = function.arena
. control-address = control-address()
. next-id U32 = 1
. position U32
while position < function.block-order.length
    . block = function.block-order[position]
    position += 1
    while true
        . instructions = function.blocks[block].instructions
        . allocation-index = first(instructions, .gc-alloc)
        if allocation-index == no-id
            break
        . allocation = function.instructions[instructions[allocation-index]]
        . result = allocation.operands[0]
        . site = allocation.operands[1]
        . loc = allocation.loc
        . suffix-length = instructions.length - allocation-index - 1
        . suffix = new-id-list(arena, suffix-length)
        for index in 0 .. < suffix-length
            suffix = suffix.appended(arena, instructions[allocation-index + 1 + index])
        function.blocks[block].instructions = IdList
            - instructions.data
            - allocation-index
            - instructions.capacity

        . original-successors = function.blocks[block].successors
        . id = next-id
        next-id += 1
        . slow-block = builder.add-block
            - function.add-local-name(.allocation-slow-name, no-string, no-string, id)
        . after-block = builder.add-block
            - function.add-local-name(.allocation-after-name, no-string, no-string, id)
        function.blocks[after-block].instructions = suffix
        function.blocks[after-block].successors = original-successors
        . block-name = function.blocks[block].name
        . after-name = function.blocks[after-block].name
        for index in 0 .. < original-successors.length
            retarget-successor
                - original-successors[index]
                - block
                - after-block
                - block-name
                - after-name

        function.blocks[block].successors = IdList()
        builder.set-insert-block(block)
        . slow-label = builder.block-label(slow-block)
        . after-label = builder.block-label(after-block)
        . offset = builder.vreg(.gpr64)
        builder.load(offset, builder.load-address-offset(site, site-buffer-offset), u64-type-id)
        builder.asm(.cbz, offset, slow-label)
        . base = builder.vreg(.gpr64)
        builder.call
            - pointer-type-id
            - builder.symbol(bundle.thread-cache-symbol)
            - base
            - no-loc
            - IdList()
            - IdList()
        . cache = builder.vreg(.gpr64)
        builder.load(cache, base, pointer-type-id)
        . buffer = builder.vreg(.gpr64)
        builder.add(buffer, cache, offset)
        . control = builder.vreg(.gpr64)
        . handshake = builder.vreg(.gpr64)
        builder.load-acquire(control, control-address, u64-type-id)
        builder.and(handshake, control, builder.small-int(handshake-requested-bit))
        builder.cbnz(handshake, slow-label)
        . cursor = builder.vreg(.gpr64)
        . limit = builder.vreg(.gpr64)
        . slot-size = builder.vreg(.gpr64)
        . generation = builder.vreg(.gpr64)
        . published = builder.vreg(.gpr64)
        builder.load(cursor, builder.load-address-offset(buffer, cursor-offset), pointer-type-id)
        builder.load(limit, builder.load-address-offset(buffer, limit-offset), pointer-type-id)
        builder.load(slot-size, builder.load-address-offset(buffer, slot-size-offset), u64-type-id)
        builder.load
            - generation
            - builder.load-address-offset(buffer, generation-offset)
            - u64-type-id
        builder.asm(.lsr, published, control, builder.small-int(sweep-generation-shift))
        builder.asm(.cmp, generation, published)
        builder.asm(.b-cond, slow-label, builder.add-operand(CondOperand(not-equal-condition)))
        builder.asm(.cbz, cursor, slow-label)
        . next = builder.vreg(.gpr64)
        builder.add(next, cursor, slot-size)
        builder.asm(.cmp, next, limit)
        builder.asm(.b-cond, slow-label, builder.add-operand(CondOperand(higher-condition)))
        builder.store(builder.load-address-offset(buffer, cursor-offset), next, pointer-type-id)
        builder.b(after-label)
        link(block, slow-block)
        link(block, after-block)

        builder.set-insert-block(slow-block)
        . refilled = builder.vreg(.gpr64)
        . arguments = new-id-list(arena, 1).appended(arena, site)
        . types = new-id-list(arena, 1).appended(arena, pointer-type-id)
        builder.call
            - pointer-type-id
            - builder.symbol(bundle.allocation-refill-symbol)
            - refilled
            - loc
            - arguments
            - types
        builder.b(after-label)
        link(slow-block, after-block)

        builder.set-insert-block(after-block)
        . exprs = new-id-list(arena, 2).appended(arena, cursor).appended(arena, refilled)
        . names = new-id-list(arena, 2).appended(arena, block-name).appended
            - arena
            - function.blocks[slow-block].name
        builder.phi-of(result, exprs, names)

────────────────────
_ do has Bool
    - opcode Opcode

. order = function.block-order
for position in 0 .. < order.length
    if first(function.blocks[order[position]].instructions, opcode) != no-id
        = true
= false

────────────────────
_ do first U32
    - instructions IdList
    - opcode Opcode

for index in 0 .. < instructions.length
    if function.instructions[instructions[index]].opcode == opcode
        = index
= no-id

────────────────────
_ do set-zone
    - instructions IdList
    - start U32
    - zone Bool

for index in start .. < instructions.length
    function.instructions[instructions[index]].gc-free-zone = zone

────────────────────
_ do retarget-successor
    - successor BlockId
    - block BlockId
    - after-block BlockId
    - block-name StringId
    - after-name StringId

. predecessors = function.blocks[successor].predecessors
for index in 0 .. < predecessors.length
    if predecessors[index] == block
        predecessors.data[index] = after-block
. instructions = function.blocks[successor].instructions
for index in 0 .. < instructions.length
    do match? function.instructions[instructions[index]]
        | .phi-instruction(phi)
            . names = phi.blocks
            for entry in 0 .. < names.length
                if names[entry] == block-name
                    names.data[entry] = after-name

────────────────────
_ do link
    - from BlockId
    - to BlockId

. arena = function.arena
function.blocks[from].successors = function.blocks[from].successors.appended(arena, to)
function.blocks[to].predecessors = function.blocks[to].predecessors.appended(arena, from)

────────────────────
_ do control-address OperandId

. arena = function.arena
. entry = function.block-order[0]
. previous-length = function.blocks[entry].instructions.length
builder.set-insert-block(entry)
. address = builder.symbol-address(builder.symbol(bundle.gc-public-control-word-symbol))

. instructions = function.blocks[entry].instructions
. insertion U32
while insertion < previous-length && function.instructions[instructions[insertion]].opcode == .phi
    insertion += 1
. count = instructions.length - previous-length
. reordered = new-id-list(arena, instructions.length)
for index in 0 .. < insertion
    reordered.data[index] = instructions[index]
for index in 0 .. < count
    reordered.data[insertion + index] = instructions[previous-length + index]
for index in insertion .. < previous-length
    reordered.data[count + index] = instructions[index]
function.blocks[entry].instructions = IdList
    - reordered.data
    - instructions.length
    - reordered.capacity
= address
