./builder
./bundle
./compact
./critical-edge-splitter
./gc-write-barrier-lowering
./mir
./mir-text
./optimization-passes
./phi-elimination
./register-allocator
./variables-to-registers
/YuCore/YuCore.h
/core/arena
/core/table

+ stage-names [String] = ["decoded", "pruned", "mem2reg", "write-barriers", "edge-split", "phi-elimination", "block-layout", "local-cleanup", "cfg-cleanup", "jump-threading", "compare-branch-fusion", "cursor-plan", "liveness", "frame-coloring", "linear-scan", "rewrite", "prologue-epilogue", "register-allocation", "record"]

━━━━━━━━━━━━━━━━━━━━
+ Stage is U32

| decoded = 0
| pruned = 1
| mem2reg = 2
| write-barriers = 3
| edge-split = 4
| phi-elimination = 5
| block-layout = 6
| local-cleanup = 7
| cfg-cleanup = 8
| jump-threading = 9
| compare-branch-fusion = 10
| cursor-plan = 11
| liveness = 12
| frame-coloring = 13
| linear-scan = 14
| rewrite = 15
| prologue-epilogue = 16
| register-allocation = 17
| record = 18

━━━━━━━━━━━━━━━━━━━━
+ MIRCounts

+ functions U64
+ blocks U64
+ instructions U64
+ frame-bytes U64
+ max-blocks U64
+ max-instructions U64
+ max-frame-bytes U64

────────────────────
+ do add
    - other MIRCounts

functions += other.functions
blocks += other.blocks
instructions += other.instructions
frame-bytes += other.frame-bytes
max-blocks = if other.max-blocks > max-blocks then other.max-blocks else max-blocks
max-instructions = if more-instructions then other.max-instructions else max-instructions
.. more-instructions = other.max-instructions > max-instructions
max-frame-bytes = if more-frame-bytes then other.max-frame-bytes else max-frame-bytes
.. more-frame-bytes = other.max-frame-bytes > max-frame-bytes

────────────────────
+ do add-function
    - counts FunctionCounts

functions += counts.functions
blocks += counts.blocks
instructions += counts.instructions
frame-bytes += counts.frame-bytes
max-blocks = if counts.blocks > max-blocks then counts.blocks else max-blocks
max-instructions = if more-instructions then counts.instructions else max-instructions
.. more-instructions = counts.instructions > max-instructions
max-frame-bytes = if more-frame-bytes then counts.frame-bytes else max-frame-bytes
.. more-frame-bytes = counts.frame-bytes > max-frame-bytes

━━━━━━━━━━━━━━━━━━━━
+ FunctionCounts is Tuple

+ functions U64
+ blocks U64
+ instructions U64
+ frame-bytes U64

━━━━━━━━━━━━━━━━━━━━
+ StageHash is Tuple

+ stage Stage
+ hash U64

━━━━━━━━━━━━━━━━━━━━
+ FunctionDump is Tuple

+ stages CPointer'StageHash
+ stage-count U32
+ text ByteSpan

━━━━━━━━━━━━━━━━━━━━
+ FunctionPipeline

` One worker's path from a built MIR function to its compact record: the passes, register
` allocation and encoding, over one function arena that each function resets. A caller fills
` `function` through `builder` or a decoder, then lowers and encodes it. With `reference`, it
` runs the passes as the reference's backend does, without constant folding, value numbering,
` if-conversion, the widths that known bits give, the promotion of narrow accesses, the
` forwarding of frame stores, the folding of addresses, the combining of instructions, the
` narrower roots, the threading of jumps through conditions other than equality, the coalescing
` of copies and call registers, the loads and stores that copies of spilled values become, the
` computing again of cheap values in place of spilling them, the registers spilled values are
` given between calls or the folding of branches after allocation, so that a bundle the
` reference captured lowers to the reference's object, as the backend comparison needs.

+ bundle Bundle
+ function MIRFunction
+ builder MIRBuilder
+ results Arena
+ through Stage = .record
+ dumps-stages Bool
+ built MIRCounts
+ allocated MIRCounts
+ counted FunctionCounts
_ mem2reg MIRVariablesToRegisters
_ constant-folding MIRConstantFoldingPass
_ value-numbering MIRValueNumberingPass
_ if-conversion MIRIfConversionPass
_ barrier-lowering MIRGCWriteBarrierLowering
_ edge-splitter MIRCriticalEdgeSplitter
_ phi-elimination MIRPhiElimination
_ block-layout MIRBlockLayoutPass
_ local-cleanup MIRLocalCleanupPass
_ cfg-cleanup MIRCFGCleanupPass
_ jump-threading MIRJumpThreadingPass
_ compare-branch-fusion MIRCompareBranchFusionPass
_ branch-folding MIRBranchFoldingPass
_ address-folding MIRAddressFoldingPass
_ combining MIRInstructionCombiningPass
_ frame-forwarding MIRFrameForwardingPass
_ allocator MIRRegisterAllocator
_ encoder FunctionEncoder
_ text MIRText
_ kept TextBuffer
_ stages Array'StageHash
_ stage-count U32
_ keeps-text Bool
_ reference Bool

────────────────────
+ This
    - bundle Bundle
    - through Stage = .record
    - dumps-stages Bool = false
    - reference Bool = false

function.pool-size = bundle.string-count

.. builder = MIRBuilder(bundle, function)
.. mem2reg = MIRVariablesToRegisters(builder, !reference)
.. constant-folding = MIRConstantFoldingPass(builder)
.. value-numbering = MIRValueNumberingPass(builder)
.. if-conversion = MIRIfConversionPass(builder)
.. barrier-lowering = MIRGCWriteBarrierLowering(builder)
.. edge-splitter = MIRCriticalEdgeSplitter(builder)
.. phi-elimination = MIRPhiElimination(builder)
.. block-layout = MIRBlockLayoutPass(builder)
.. local-cleanup = MIRLocalCleanupPass(builder, !reference)
.. cfg-cleanup = MIRCFGCleanupPass(builder)
.. jump-threading = MIRJumpThreadingPass(builder, !reference)
.. compare-branch-fusion = MIRCompareBranchFusionPass(builder)
.. branch-folding = MIRBranchFoldingPass(builder)
.. address-folding = MIRAddressFoldingPass(builder)
.. combining = MIRInstructionCombiningPass(builder)
.. frame-forwarding = MIRFrameForwardingPass(builder)
.. allocator = MIRRegisterAllocator(builder, !reference, !reference, !reference, !reference)
.. encoder = FunctionEncoder(bundle, function, results)
.. text = MIRText(bundle, function)
.. stages = Array'StageHash(32)

────────────────────
+ do release

function.release()
results.release()

────────────────────
+ do begin
    - keeps-stage-text Bool

stage-count = 0
keeps-text = keeps-stage-text
kept.clear()
counted = FunctionCounts()

────────────────────
+ do lower Bool

if ends(.decoded)
    = false
if function.is-lowered
    = true
builder.adopt()
builder.validate()
count-function(false)
builder.prune-unreachable-blocks()
if ends(.pruned)
    = false
mem2reg.run()
if ends(.mem2reg)
    = false
if !reference
    constant-folding.run()
    value-numbering.run()
    if-conversion.run()
barrier-lowering.run()
if ends(.write-barriers)
    = false
edge-splitter.run()
if ends(.edge-split)
    = false
phi-elimination.run()
if ends(.phi-elimination)
    = false
block-layout.run()
if ends(.block-layout)
    = false
local-cleanup.run()
if ends(.local-cleanup)
    = false
if cfg-cleanup.run()
    local-cleanup.run()
if ends(.cfg-cleanup)
    = false
if jump-threading.run()
    local-cleanup.run()
    if cfg-cleanup.run()
        local-cleanup.run()
if ends(.jump-threading)
    = false
compare-branch-fusion.run()
if ends(.compare-branch-fusion)
    = false

if function.uses-table-union-cursor-plan
    local-cleanup.run()
    compare-branch-fusion.run()
    allocator.form-post-indexed-loads()
    function.forget-use-counts()
    if ends(.cursor-plan)
        = false
if !reference
    if frame-forwarding.run()
        local-cleanup.run()
    address-folding.run()
    if combining.run()
        local-cleanup.run()
function.forget-use-counts()
allocator.liveness.run()
if ends(.liveness)
    = false
allocator.coloring.plan()
if ends(.frame-coloring)
    = false
allocator.begin()
allocator.scan-intervals()
if ends(.linear-scan)
    = false
allocator.rewrite()
if ends(.rewrite)
    = false
allocator.finish-frame()
if ends(.prologue-epilogue)
    = false
allocator.remove-panic-check-fallthrough-branches()
if !reference
    branch-folding.run()
    block-layout.rewrite-fallthrough-branches()
if ends(.register-allocation)
    = false
count-function(true)
builder.validate()
= true

────────────────────
+ do encode CompactFunction

. compact = encoder.encode()
if dumps-stages
    text.out.clear()
    compact-record-text(text.out, bundle, compact)
    keep-stage(.record)
= compact

────────────────────
+ do finished-dump FunctionDump

. hashes = results.allocate'StageHash(stage-count)
for index in 0 .. < stage-count
    hashes[index] = stages[index]
. kept-text ByteSpan
if keeps-text
    . copy = results.allocate-raw(kept.length)
    C:yumiArrayCopySlice(copy, kept.bytes.data, kept.length)
    kept-text = ByteSpan(copy, kept.length)
= FunctionDump(hashes, stage-count, kept-text)

────────────────────
_ do count-function
    - is-allocated Bool

. blocks U64 = function.block-order.length
. instructions U64 = builder.instruction-count()
. frame-bytes U64 = function.frame-bytes
. counts = FunctionCounts(1, blocks, instructions, frame-bytes)
if is-allocated
    //lang.backend.mir.alloc -> function.order, blocks, instructions, frame-bytes
    allocated.add-function(counts)
    counted = counts
else
    //lang.backend.mir.pre -> function.order, blocks, instructions, frame-bytes
    built.add-function(counts)

────────────────────
_ do ends Bool
    - stage Stage

if dumps-stages
    text.out.clear()
    text.function-text()
    if stage == .liveness
        allocator.liveness.write-text(text)
    else if stage == .linear-scan
        allocator.scan.write-text(text)
    keep-stage(stage)
= through == stage

────────────────────
_ do keep-stage
    - stage Stage

stages[stage-count] = StageHash(stage, text.out.hash)
stage-count += 1
if keeps-text
    kept.text("== ")
    kept.text(stage-names[stage])
    kept.byte(10)
    kept.span(ByteSpan(text.out.bytes.data, text.out.length))
