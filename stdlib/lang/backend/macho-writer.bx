(import ./binary-writer)
(import ./mir)
(import ./object-builder)
(import ./relocations)
(import /core/arena)
(import /lang/target)
(blank)
(prop _ mh-magic-64 U32 (= 0xfeedfacf))
(prop _ cpu-type-arm64 U32 (= 0x0100000c))
(prop _ cpu-subtype-arm64-all U32)
(prop _ mh-object U32 (= 1))
(prop _ lc-segment-64 U32 (= 0x19))
(prop _ lc-symtab U32 (= 2))
(prop _ lc-dysymtab U32 (= 0xb))
(prop _ lc-build-version U32 (= 0x32))
(prop _ s-attr-pure-instructions U32 (= 0x80000000))
(prop _ s-attr-some-instructions U32 (= 0x00000400))
(prop _ n-ext U32 (= 1))
(prop _ section-names (list String)
  (=
    (call List
      (block
        (item "__text")
        (item "__cstring")
        (item "__const")
        (item "__brix_trace")
        (item "__brix_gcmap")
        (item "__brix_gcroots")
        (item "__brix_pads")
        (item "__bss")
      )
    )
  )
)
(prop _ segment-names (list String)
  (=
    (block
      (list "__TEXT" "__TEXT" "__DATA" "__DATA" "__DATA" "__DATA" "__DATA" "__DATA")
    )
  )
)

(fn-do + write-macho ByteSpan
  (param builder ObjectBuilder)
  (param platform Target)
  ; The object as Mach-O: one unnamed segment that holds every section at its own address, with
  ; symbol values that are those addresses.
  (call layout-sections builder)
  (let sections (. builder sections))
  (let symbols (. builder symbols))
  (let order (. builder symbol-order))
  (let string-table (. builder string-table))
  (let section-count U32 (as (. sections length) U32))
  (let symbol-count U32 (as (. symbols length) U32))
  (let header-size U64 32)
  (let segment-command-size U32 (+ 72 (* section-count 80)))
  (let size-of-commands U32 (+ segment-command-size 24 24 80))
  (blank)
  (let cursor (+ header-size size-of-commands))
  (for (in target sections)
    (if (. target is-zero-fill)
      (= (. target file-offset) 0)
      (else
        (= cursor (call align-value cursor (/lshift/ 1u64 (. target alignment-power))))
        (= (. target file-offset) cursor)
        (+= cursor (. target size))
      )
    )
  )
  (blank)
  (let segment-file-offset cursor)
  (for (in target sections)
    (if (and (not (. target is-zero-fill)) (> (. target size) 0))
      (= segment-file-offset (. target file-offset))
      (break)
    )
  )
  (let segment-file-end segment-file-offset)
  (let segment-vm-size U64)
  (for (in target sections)
    (if (and (not (. target is-zero-fill)) (> (+ (. target file-offset) (. target size)) segment-file-end))
      (= segment-file-end (+ (. target file-offset) (. target size)))
    )
    (if (> (+ (. target address) (. target size)) segment-vm-size)
      (= segment-vm-size (+ (. target address) (. target size)))
    )
  )
  (blank)
  (= cursor (call align-value cursor 8))
  (for (in target sections)
    (if (== (. target relocations length) 0)
      (= (. target reloc-offset) 0)
      (else
        (= (. target reloc-offset) cursor)
        (+= cursor (* (. target relocations length) 8))
      )
    )
  )
  (blank)
  (let symbol-offset (call align-value cursor 8))
  (let string-offset (+ symbol-offset (* symbol-count 16)))
  (let total (+ string-offset (. string-table length)))
  (call check-layout total)
  (blank)
  (let writer (call BinaryWriter (. builder arena) (as total Size)))
  (call (. writer u32) mh-magic-64)
  (call (. writer u32) cpu-type-arm64)
  (call (. writer u32) cpu-subtype-arm64-all)
  (call (. writer u32) mh-object)
  (call (. writer u32) 4)
  (call (. writer u32) size-of-commands)
  (call (. writer u32) 0)
  (call (. writer u32) 0)
  (blank)
  (call (. writer u32) lc-segment-64)
  (call (. writer u32) segment-command-size)
  (call fixed-string writer "")
  (call (. writer u64) 0)
  (call (. writer u64) segment-vm-size)
  (call (. writer u64) segment-file-offset)
  (call (. writer u64) (- segment-file-end segment-file-offset))
  (call (. writer u32) 7)
  (call (. writer u32) 7)
  (call (. writer u32) section-count)
  (call (. writer u32) 0)
  (for (in index (..< 0 section-count))
    (let target ([] sections index))
    (call fixed-string writer ([] section-names index))
    (call fixed-string writer ([] segment-names index))
    (call (. writer u64) (. target address))
    (call (. writer u64) (. target size))
    (call (. writer u32) (as (. target file-offset) U32))
    (call (. writer u32) (. target alignment-power))
    (call (. writer u32) (as (. target reloc-offset) U32))
    (call (. writer u32) (as (. target relocations length) U32))
    (call (. writer u32) (call section-flags index))
    (call (. writer u32) 0)
    (call (. writer u32) 0)
    (call (. writer u32) 0)
  )
  (blank)
  (call (. writer u32) lc-build-version)
  (call (. writer u32) 24)
  (call (. writer u32) (. platform macho-platform))
  (call (. writer u32) (. platform minimum-os-version))
  (call (. writer u32) 0)
  (call (. writer u32) 0)
  (blank)
  (call (. writer u32) lc-symtab)
  (call (. writer u32) 24)
  (call (. writer u32) (as symbol-offset U32))
  (call (. writer u32) symbol-count)
  (call (. writer u32) (as string-offset U32))
  (call (. writer u32) (as (. string-table length) U32))
  (blank)
  (call (. writer u32) lc-dysymtab)
  (call (. writer u32) 80)
  (call (. writer u32) 0)
  (call (. writer u32) (. builder local-count))
  (call (. writer u32) (. builder local-count))
  (call (. writer u32) (. builder external-count))
  (call (. writer u32) (+ (. builder local-count) (. builder external-count)))
  (call (. writer u32) (. builder undefined-count))
  (call (. writer zeros) 48)
  (blank)
  (for (in target sections)
    (if (not (. target is-zero-fill))
      (if (> (. target file-offset) (. writer length))
        (call (. writer zeros) (as (- (. target file-offset) (. writer length)) Size))
      )
      (call (. writer bytes) (. target data))
    )
  )
  (blank)
  (for (in target sections)
    (let count (. target relocations length))
    (if (!= count 0)
      (if (> (. target reloc-offset) (. writer length))
        (call (. writer zeros) (as (- (. target reloc-offset) (. writer length)) Size))
      )
      (for (in position (..< 0 count))
        (let relocation ([] (. target relocations) (- count 1 position)))
        (let kind (. relocation kind))
        (let pc-relative U32
          (block
            (case? (or (call is-branch26-relocation kind) (== kind .page21-relocation))
              1
            )
            (default
              0
            )
          )
        )
        (call (. writer u32) (. relocation offset))
        (call (. writer u32)
          (block
            (arg (/or/ (. ([] symbols (. relocation symbol)) index) (/lshift/ pc-relative 24) (/lshift/ (if-expr (== kind .unsigned-relocation) 3u32 2u32) 25) (/lshift/ 1u32 27) (/lshift/ (call relocation-type kind) 28)))
          )
        )
      )
    )
  )
  (blank)
  (call (. writer align) 8)
  (for (in position (..< 0 symbol-count))
    (let symbol ([] symbols ([] order position)))
    (call (. writer u32) (. symbol string-offset))
    (if (!= (. symbol section) (. SectionId none))
      (call (. writer u8) (/or/ (if-expr (. symbol is-external) n-ext 0) (. MachOSymbolType sect)))
      (call (. writer u8) (. symbol section))
      (call (. writer u16) 0)
      (call (. writer u64) (. symbol value))
      (else
        (call (. writer u8) (/or/ n-ext (. MachOSymbolType undf)))
        (call (. writer u8) 0)
        (call (. writer u16) 0)
        (call (. writer u64) 0)
      )
    )
  )
  (call (. writer bytes) string-table)
  (return (. writer view))
)

(type _ MachOSectionType (is U32)
  (variant regular)
  (variant zerofill)
  (variant cstring-literals)
)

(type _ MachOSymbolType (is U32)
  (variant undf)
  (variant sect (= 0xe))
)

(fn-do _ layout-sections _
  (param builder ObjectBuilder)
  (let address U64)
  (for (in target (. builder sections))
    (= address (call align-value address (/lshift/ 1u64 (. target alignment-power))))
    (= (. target address) address)
    (+= address (. target size))
  )
  (for (in row (..< 0 (. builder symbols length)))
    (let index (. ([] (. builder symbols) row) section))
    (if (!= index (. SectionId none))
      (= (. ([] (. builder symbols) row) value) (+ (. ([] (. builder symbols) row) value) (. (call (. builder section) index) address)))
    )
  )
)

(fn-expr _ section-flags U32
  (param index Size)
  (case? (== index 0)
    (/or/ s-attr-pure-instructions s-attr-some-instructions (. MachOSectionType regular))
  )
  (case? (== index 1)
    (. MachOSectionType cstring-literals)
  )
  (case? (== index 7)
    (. MachOSectionType zerofill)
  )
  (default
    (. MachOSectionType regular)
  )
)

(fn-expr _ relocation-type U32
  (param kind RelocationKind)
  (case? (call is-branch26-relocation kind)
    2
  )
  (case? (== kind .page21-relocation)
    3
  )
  (case? (== kind .unsigned-relocation)
    0
  )
  (default
    4
  )
)

(fn-do _ fixed-string _
  (param writer BinaryWriter)
  (param text String)
  (throw (call Panic (str "Mach-O fixed string is too long: " text)) (if (> (. text size) 16)))
  (call (. writer text) text)
  (call (. writer zeros) (- 16 (. text size)))
)
