(import ./bundle)
(import ./mir)
(blank)
(prop _ first-multiplier U64 (= 0x9e3779b97f4a7c15))
(prop _ second-multiplier U64 (= 0xc2b2ae3d27d4eb4f))
(prop _ first-offset U64 (= 0x165667b19e3779f9))
(prop _ second-offset U64 (= 0x27d4eb2f165667c5))
(prop _ local-string-mark U64 (= 0x4c4f43414c))
(prop _ new-string-mark U64 (= 0x4e4557))
(prop _ seen-string-mark U64 (= 0x5345454e))
(prop _ absent-mark U64 (= 0x4142534e54))

(type + MIRDigest (is Tuple)
  (prop + high U64)
  (prop + low U64)
)

(type + MIRDigester
  (prop + strings IdList)
  (prop _ bundle Bundle)
  (prop _ function MIRFunction)
  (prop _ seen IdMap)
  (prop _ specials (list StringId))
  (prop _ first U64)
  (prop _ second U64)
  (fn-do + This _
    (param bundle Bundle)
    (param function MIRFunction)
    (lazy specials (list (. bundle entry-name) (. bundle main-name) (. bundle gc-public-control-word-symbol) (. bundle write-barrier-record-symbol) (. bundle zero-stack-frame-symbol) (. bundle memory-copy-symbol) (. bundle memory-zero-symbol) (. bundle bulk-write-barrier-symbol) (. bundle thread-cache-symbol) (. bundle allocation-refill-symbol) (. bundle allocate-object-symbol)))
  )
  (fn-do + digest MIRDigest
    (param seed MIRDigest)
    (= first (. seed high))
    (= second (. seed low))
    (= seen (call new-id-map (. function arena) 64))
    (= strings (call new-id-list (. function arena) 32))
    (for (in symbol specials)
      (call string symbol)
    )
    (call header)
    (call locs)
    (call types)
    (call frame)
    (call vregs)
    (call operands)
    (call roots)
    (call instructions)
    (call blocks)
    (call names)
    (return (call MIRDigest (call settled first) (call settled second)))
  )
  (fn-do _ header _
    (let f function)
    (call string (. f label))
    (call string (. f symbol))
    (call flag (. f is-lowered))
    (call string (. f name))
    (call string (. f display-name))
    (call word (. f compilation-effects))
    (call flag (. f is-exported))
    (call flag (. f uses-table-union-cursor-plan))
    (call word (. f loc))
    (call word (. f vreg-count))
    (call flag (. f uses-layout-context))
    (call word (. f closure-root))
    (call word (. f capture-closure-root))
    (call word (. f frame-bytes))
    (let overflow (. f overflow))
    (call flag (. overflow is-present))
    (call flag (. overflow is-stack))
    (call word (. overflow slot))
    (call signed (. overflow size))
    (call signed (. overflow alignment))
    (call signed (. overflow length))
    (call signed (. overflow count))
    (call signed (. overflow offset))
    (call ids (. f frame-slots))
    (call ids (. f vars))
    (call ids (. f block-order))
    (call span (. f gc-roots))
    (call ids (. f group-vregs))
    (call ids (. f lifetimes))
    (call ids (. f words))
  )
  (fn-do _ locs _
    (let table (. function locs))
    (call word (as (. table length) U64))
    (for (in index (..< 0 (. table length)))
      (let loc ([] table index))
      (call string (. loc file))
      (call flag (. loc is-known))
      (call signed (. loc line))
      (call signed (. loc column))
      (call signed (. loc offset))
      (call signed (. loc end-offset))
    )
  )
  (fn-do _ types _
    (let table (. function types))
    (call word (as (. table length) U64))
    (for (in index (..< 0 (. table length)))
      (match ([] table index)
        (case (call .void-type row)
          (call layout 0 (. row size) (. row alignment))
        )
        (case (call .int-type row)
          (call layout 1 (. row size) (. row alignment))
          (call word (. row bit-size))
          (call flag (. row is-signed))
          (call word (. row reg-class))
        )
        (case (call .float-type row)
          (call layout 2 (. row size) (. row alignment))
          (call word (. row bit-size))
          (call word (. row reg-class))
        )
        (case (call .pointer-type row)
          (call layout 3 (. row size) (. row alignment))
          (call word (. row reg-class))
        )
        (case (call .struct-type row)
          (call layout 4 (. row size) (. row alignment))
          (call word (. row format))
          (call span (. row fields))
        )
        (case (call .array-type row)
          (call layout 5 (. row size) (. row alignment))
          (call word (. row item))
          (call word (. row length))
        )
      )
    )
    (let fields (. function struct-fields))
    (call word (as (. fields length) U64))
    (for (in index (..< 0 (. fields length)))
      (let field ([] fields index))
      (call word (. field type))
      (call word (. field offset))
    )
  )
  (fn-do _ frame _
    (let slots (. function slots))
    (call word (as (. slots length) U64))
    (for (in index (..< 0 (. slots length)))
      (let slot ([] slots index))
      (call signed (. slot index))
      (call flag (. slot is-stack))
      (call ids (. slot objects))
    )
    (let objects (. function frame-objects))
    (call word (as (. objects length) U64))
    (for (in index (..< 0 (. objects length)))
      (let object ([] objects index))
      (call word (. object slot))
      (call signed (. object index))
      (call word (. object type))
      (call signed (. object offset))
      (call flag (. object can-promote))
      (call flag (. object gc-root))
      (call string (. object gc-descriptor))
      (call word (. object gc-root-mode))
      (call flag (. object is-spill))
      (call span (. object lifetime))
    )
    (let saved (. function saved-registers))
    (call word (as (. saved length) U64))
    (for (in index (..< 0 (. saved length)))
      (call word (. ([] saved index) register))
      (call signed (. ([] saved index) fp-offset))
    )
  )
  (fn-do _ vregs _
    (let table (. function vregs))
    (call word (as (. table length) U64))
    (for (in index (..< 0 (. table length)))
      (let vreg ([] table index))
      (call word (. vreg id))
      (call word (. vreg reg-class))
      (call word (. vreg hint))
      (call flag (. vreg gc-root))
      (call string (. vreg gc-descriptor))
      (call word (. vreg gc-root-mode))
    )
  )
  (fn-do _ operands _
    (let table (. function operands))
    (call word (as (. table length) U64))
    (for (in index (..< 0 (. table length)))
      (match ([] table index)
        (case (call .vreg-operand row)
          (call word 0)
          (call word (. row vreg))
        )
        (case (call .preg-operand row)
          (call word 1)
          (call word (. row register))
        )
        (case (call .vreg-group-operand row)
          (call word 2)
          (call word (. row reg-class))
          (call span (. row vregs))
        )
        (case (call .label-operand row)
          (call word 3)
          (call string (. row name))
          (call word (. row reloc))
        )
        (case (call .symbol-operand row)
          (call word 4)
          (call string (. row name))
          (call word (. row reloc))
        )
        (case (call .label-address-operand row)
          (call word 5)
          (call word (. row base))
        )
        (case (call .load-address-operand row)
          (call word 6)
          (call word (. row base))
          (call word (. row offset))
          (call flag (. row is-pre-index))
          (call word (. row index-shift))
        )
        (case (call .frame-object-operand row)
          (call word 7)
          (call word (. row object))
        )
        (case (call .int-operand row)
          (call word 8)
          (call word (. row value bits))
          (call flag (. row value is-negative))
        )
        (case (call .cond-operand row)
          (call word 9)
          (call word (. row code))
        )
        (case .placeholder-operand
          (call word 10)
        )
        (case (call .shift-operand row)
          (call word 11)
          (call word (. row kind))
          (call word (. row amount))
        )
      )
    )
  )
  (fn-do _ roots _
    (let table (. function roots))
    (call word (as (. table length) U64))
    (for (in index (..< 0 (. table length)))
      (match ([] table index)
        (case (call .register-root row)
          (call word 0)
          (call word (. row register))
        )
        (case (call .stack-root row)
          (call word 1)
          (call word (. row object))
          (call string (. row gc-descriptor))
          (call word (. row gc-root-mode))
        )
      )
    )
  )
  (fn-do _ instructions _
    (let table (. function instructions))
    (call word (as (. table length) U64))
    (for (in index (..< 0 (. table length)))
      (match ([] table index)
        (case (call .assembly-instruction row)
          (call word 0)
          (call instruction
            (block
              (arg (. row opcode))
              (arg (. row operands))
              (arg (. row loc))
              (arg (. row position))
              (arg (. row gc-free-zone))
              (arg (. row gc-exceptional-safepoint))
              (arg (. row gc-safepoint))
              (arg (. row is-phi-copy))
              (arg (. row has-gc-roots))
              (arg (. row gc-roots))
            )
          )
        )
        (case (call .call-instruction row)
          (call word 1)
          (call instruction
            (block
              (arg (. row opcode))
              (arg (. row operands))
              (arg (. row loc))
              (arg (. row position))
              (arg (. row gc-free-zone))
              (arg (. row gc-exceptional-safepoint))
              (arg (. row gc-safepoint))
              (arg (. row is-phi-copy))
              (arg (. row has-gc-roots))
              (arg (. row gc-roots))
            )
          )
          (call word (. row return-type))
          (call span (. row copied-struct-arguments))
          (call span (. row argument-sizes))
          (call word (. row panic-target))
          (call flag (. row gc-safepoint-proven-free))
          (call flag (. row direct-struct-return))
        )
        (case (call .phi-instruction row)
          (call word 2)
          (call instruction
            (block
              (arg (. row opcode))
              (arg (. row operands))
              (arg (. row loc))
              (arg (. row position))
              (arg (. row gc-free-zone))
              (arg (. row gc-exceptional-safepoint))
              (arg (. row gc-safepoint))
              (arg (. row is-phi-copy))
              (arg (. row has-gc-roots))
              (arg (. row gc-roots))
            )
          )
          (call word (. row reg))
          (call ids (. row exprs))
          (call ids (. row blocks))
        )
        (case (call .comment-instruction row)
          (call word 3)
          (call instruction
            (block
              (arg (. row opcode))
              (arg (. row operands))
              (arg (. row loc))
              (arg (. row position))
              (arg (. row gc-free-zone))
              (arg (. row gc-exceptional-safepoint))
              (arg (. row gc-safepoint))
              (arg (. row is-phi-copy))
              (arg (. row has-gc-roots))
              (arg (. row gc-roots))
            )
          )
          (call string (. row text))
        )
      )
    )
  )
  (fn-do _ instruction _
    (param opcode Opcode)
    (param operands IdList)
    (param loc LocId)
    (param position I32)
    (param gc-free-zone Bool)
    (param gc-exceptional-safepoint Bool)
    (param gc-safepoint Bool)
    (param is-phi-copy Bool)
    (param has-gc-roots Bool)
    (param gc-roots Span)
    (call word opcode)
    (call ids operands)
    (call word loc)
    (call signed position)
    (call flag gc-free-zone)
    (call flag gc-exceptional-safepoint)
    (call flag gc-safepoint)
    (call flag is-phi-copy)
    (call flag has-gc-roots)
    (call span gc-roots)
  )
  (fn-do _ blocks _
    (let table (. function blocks))
    (call word (as (. table length) U64))
    (for (in index (..< 0 (. table length)))
      (let block ([] table index))
      (call string (. block name))
      (call ids (. block instructions))
      (call ids (. block successors))
      (call ids (. block predecessors))
    )
    (let tables (. function jump-tables))
    (call word (as (. tables length) U64))
    (for (in index (..< 0 (. tables length)))
      (call string (. ([] tables index) name))
      (call span (. ([] tables index) labels))
    )
  )
  (fn-do _ names _
    (let listed (. function names))
    (call word (. listed length))
    (for (in index (..< 0 (. listed length)))
      (call string ([] listed index))
    )
    (let locals (. function local-names))
    (call word (as (. locals length) U64))
    (for (in index (..< 0 (. locals length)))
      (let local ([] locals index))
      (call word (. local kind))
      (call string (. local first))
      (call string (. local second))
      (call word (. local index))
    )
  )
  (fn-do _ string _
    (param id StringId)
    (if (== id no-string)
      (call word absent-mark)
      (return)
    )
    (if (>= id (. function pool-size))
      (call word local-string-mark)
      (call word (- id (. function pool-size)))
      (return)
    )
    (let ordinal (call (. seen get) id))
    (if (!= ordinal no-id)
      (call word seen-string-mark)
      (call word ordinal)
      (return)
    )
    (= seen (call (. seen inserted) (. function arena) id (. strings length)))
    (= strings (call (. strings appended) (. function arena) id))
    (call word new-string-mark)
    (call word (call (. bundle string-facts) id))
    (let text (call (. bundle string) id))
    (call word (as (. text length) U64))
    (let packed 0u64)
    (for (in index (..< 0 (. text length)))
      (= packed (/or/ (/lshift/ packed 8) (as ([] (. text data) index) U64)))
      (if (== (% index 8) 7)
        (call word packed)
        (= packed 0)
      )
    )
    (call word packed)
  )
  (fn-do _ ids _
    (param list IdList)
    (call word (. list length))
    (for (in index (..< 0 (. list length)))
      (call word ([] list index))
    )
  )
  (fn-do _ span _
    (param range Span)
    (call word (. range start))
    (call word (. range count))
  )
  (fn-do _ layout _
    (param kind U64)
    (param size U32)
    (param alignment U32)
    (call word kind)
    (call word size)
    (call word alignment)
  )
  (fn-do _ flag _
    (param value Bool)
    (call word (if-expr value 1u64 0u64))
  )
  (fn-do _ signed _
    (param value I32)
    (call word (as (as value I64) U64))
  )
  (fn-do _ word _ @inline
    (param value U64)
    (= first (call mixed first value first-multiplier))
    (= second (call mixed second (/xor/ value second-offset) second-multiplier))
  )
)

(fn-do + bundle-seed MIRDigest
  (param bundle Bundle)
  (let first first-offset)
  (let second second-offset)
  (let values (list U64))
  (+= values (if-expr (. bundle gc-enabled) 1u64 0u64))
  (+= values (if-expr (. bundle stack-trace-metadata) 1u64 0u64))
  (+= values (if-expr (. bundle apple-abi) 1u64 0u64))
  (+= values (. bundle output-mode))
  (+= values (. bundle gc-allocation-buffer-version))
  (+= values (. bundle gc-control-phase-mask))
  (for (in value values)
    (= first (call mixed first value first-multiplier))
    (= second (call mixed second (/xor/ value second-offset) second-multiplier))
  )
  (return (call MIRDigest first second))
)

(fn-expr _ mixed U64 @inline
  (param hash U64)
  (param value U64)
  (param multiplier U64)
  (+ (* (/or/ (/lshift/ combined 27) (/zrshift/ combined 37)) multiplier) first-offset)
  (where
    (lazy combined (/xor/ hash (* value multiplier)))
  )
)

(fn-expr _ settled U64
  (param hash U64)
  (* (/xor/ folded (/zrshift/ folded 29)) first-multiplier)
  (where
    (lazy folded (* (/xor/ hash (/zrshift/ hash 33)) second-multiplier))
  )
)
