(import ./mir)
(import /core/arena)
(import /core/table)
(import /os/file)
(import /os/path)
(import /string.h)
(blank)
(prop _ bundle-magic U32 (= 0x42424d59))
(prop _ bundle-version U32 (= 1))
(prop _ read-chunk-size Size (= 67108864))
(prop _ runtime-symbol-count U32 (= 4))
(prop _ safepoint-free-flag Byte (= 1))
(prop _ inferred-safepoint-free-flag Byte (= 2))
(prop _ memory-copy-callee-flag Byte (= 4))
(prop _ safe-struct-callee-flag Byte (= 8))
(prop _ known-flags Byte (= 15))
(prop _ alignment-shift Byte (= 4))

(type + ConstantKind (is U32)
  (variant byte-constant (= 0))
  (variant short-constant (= 1))
  (variant long-constant (= 2))
  (variant quad-constant (= 3))
  (variant string-constant (= 4))
  (variant label-constant (= 5))
)

(type + GCRootKind (is U32)
  (variant global-root (= 0))
  (variant task-local-root (= 1))
  (variant thread-local-root (= 2))
)

(type + StringLiteral (is Struct)
  (prop + name StringId)
  (prop + character-length U32)
  (prop + flags U32)
  (prop + bytes ByteSpan)
)

(type + NumberConstant (is Struct)
  (prop + name StringId)
  (prop + size U32)
  (prop + bits U64)
)

(type + ConstantTable (is Struct)
  (prop + name StringId)
  (prop + alignment U32)
  (prop + items Span)
)

(type + ConstantItem (is Struct)
  (prop + kind ConstantKind)
  (prop + bits U64)
  (prop + name StringId)
)

(type + GlobalData (is Struct)
  (prop + name StringId)
  (prop + size U32)
  (prop + alignment U32)
)

(type + GCRootRecord (is Struct)
  (prop + kind GCRootKind)
  (prop + symbol StringId)
  (prop + descriptor StringId)
)

(type + FunctionRecord (is Struct)
  (prop + order U32)
  (prop + label StringId)
  (prop + symbol StringId)
  (prop + is-lowered Bool)
  (prop + string-count U32)
  (prop + word-count U32)
  (prop + strings (of CPointer U32))
  (prop + words (of CPointer I32))
)

(type + StringPool (is Tuple)
  ; A copy of a bundle's pool of strings, read by id after the bundle is gone.
  (blank)
  (prop + starts (of CPointer U32))
  (prop + bytes (of CPointer Byte))
  (prop + count U32)
  (fn-expr + string ByteSpan @inline
    (param id StringId)
    (call ByteSpan (+ bytes ([] starts id)) (- ([] starts (+ id 1)) ([] starts id)))
  )
)

(type + Bundle
  (implements (of Usable Void))
  (prop + gc-enabled Bool)
  (prop + stack-trace-metadata Bool)
  (prop + apple-abi Bool)
  (prop + output-mode U32)
  (prop + gc-allocation-buffer-version U32)
  (prop + gc-control-phase-mask U32)
  (prop + string-count U32)
  (prop + entry-name StringId (= no-string))
  (prop + main-name StringId (= no-string))
  (prop + gc-public-control-word-symbol StringId (= no-string))
  (prop + write-barrier-record-symbol StringId (= no-string))
  (prop + zero-stack-frame-symbol StringId (= no-string))
  (prop + memory-copy-symbol StringId (= no-string))
  (prop + memory-zero-symbol StringId (= no-string))
  (prop + bulk-write-barrier-symbol StringId (= no-string))
  (prop + thread-cache-symbol StringId (= no-string))
  (prop + allocation-refill-symbol StringId (= no-string))
  (prop + allocate-object-symbol StringId (= no-string))
  (prop + safepoint-free IdList)
  (prop + inferred-safepoint-free IdList)
  (prop + cold-callees IdList)
  (prop + literals (of Table StringLiteral))
  (prop + numbers (of Table NumberConstant))
  (prop + constant-tables (of Table ConstantTable))
  (prop + constant-items (of Table ConstantItem))
  (prop + globals (of Table GlobalData))
  (prop + gc-roots (of Table GCRootRecord))
  (prop + functions (of Table FunctionRecord))
  (prop _ arena Arena)
  (prop _ words (of CPointer U32))
  (prop _ word-count Size)
  (prop _ cursor Size)
  (prop _ string-starts (of CPointer U32))
  (prop _ string-base (of CPointer Byte))
  (prop _ symbol-flags (of CPointer Byte))
  (prop _ string-capacity U32)
  (prop _ byte-length U32)
  (prop _ byte-capacity U32)
  (prop _ interned (of CPointer U32))
  (prop _ interned-capacity U32)
  (prop _ released Bool)
  (fn-do + This _
    (lazy literals (call (of Table StringLiteral) arena 256))
    (lazy numbers (call (of Table NumberConstant) arena 64))
    (lazy constant-tables (call (of Table ConstantTable) arena 256))
    (lazy constant-items (call (of Table ConstantItem) arena 1024))
    (lazy globals (call (of Table GlobalData) arena 64))
    (lazy gc-roots (call (of Table GCRootRecord) arena 64))
    (lazy functions (call (of Table FunctionRecord) arena 1024))
  )
  (fn-expr + begin-using _
    this
  )
  (fn-do + end-using _
    (call release)
  )
  (fn-do + release _
    (if (not released)
      (call (. arena release))
      (= released true)
    )
  )
  (fn-expr + string ByteSpan @inline
    (param id StringId)
    (call ByteSpan (+ string-base start) (- ([] string-starts (+ id 1)) start))
    (where
      (lazy start ([] string-starts id))
    )
  )
  (fn-expr + non-empty StringId
    (param id StringId)
    (if-expr (and (!= id no-string) (== ([] string-starts (+ id 1)) ([] string-starts id))) no-string id)
  )
  (fn-expr + string-facts U32 @inline
    (param id StringId)
    (/or/ (as ([] symbol-flags id) U32) (if-expr (== ([] string-starts (+ id 1)) ([] string-starts id)) 256u32 0u32))
  )
  (fn-expr + text String
    (param id StringId)
    (call (. (call (of Array Byte) (. span data) (. span length)) slice-string) (..< 0 (. span length)))
    (where
      (lazy span (call string id))
    )
  )
  (fn-expr + is-safepoint-free Bool @inline
    (param symbol StringId)
    (!= (/and/ ([] symbol-flags symbol) safepoint-free-flag) 0)
  )
  (fn-expr + is-inferred-safepoint-free Bool @inline
    (param symbol StringId)
    (!= (/and/ ([] symbol-flags symbol) inferred-safepoint-free-flag) 0)
  )
  (fn-expr + is-memory-copy-callee Bool @inline
    (param symbol StringId)
    (and (!= symbol no-string) (!= (/and/ ([] symbol-flags symbol) memory-copy-callee-flag) 0))
  )
  (fn-expr + is-safe-struct-callee Bool @inline
    (param symbol StringId)
    (and (!= symbol no-string) (!= (/and/ ([] symbol-flags symbol) safe-struct-callee-flag) 0))
  )
  (fn-do _ find-string StringId
    (param text String)
    (for (in id (..< 0 string-count))
      (if (== (- ([] string-starts (+ id 1)) ([] string-starts id)) (. text size))
        (if (== (call C:memcmp (+ string-base ([] string-starts id)) (as text (of CPointer Byte)) (. text size)) 0)
          (return id)
        )
      )
    )
    (return no-string)
  )
  (fn-do + begin-building _
    ; Starts a bundle built in memory rather than read from a file. Its strings are interned as
    ; they are named and its manifest tables are appended to directly; the pool must be whole
    ; before any worker reads it.
    (= string-capacity 256)
    (= byte-capacity 16384)
    (= interned-capacity 1024)
    (= string-starts (call (of (. arena allocate) U32) (+ string-capacity 1)))
    (= string-base (call (. arena allocate-raw) byte-capacity))
    (= symbol-flags (call (of (. arena allocate) Byte) string-capacity))
    (= interned (call (of (. arena allocate) U32) interned-capacity))
    (= entry-name (call intern "entry"))
    (= main-name (call intern "main"))
  )
  (fn-do + intern StringId
    (param text String)
    (return (call intern-span (call ByteSpan text (. text size))))
  )
  (fn-do + intern-span StringId
    (param span ByteSpan)
    ; The id of a string of a bundle built in memory, added to the pool on first sight.
    (let hash (call fnv-hash (. span data) (. span length)))
    (let mask (- interned-capacity 1))
    (let slot (as (/and/ (/xor/ hash (/zrshift/ hash 32)) mask) U32))
    (while (!= ([] interned slot) 0)
      (let id (- ([] interned slot) 1))
      (let start ([] string-starts id))
      (if (== (- ([] string-starts (+ id 1)) start) (. span length))
        (if (== (call C:memcmp (+ string-base start) (. span data) (. span length)) 0)
          (return id)
        )
      )
      (= slot (/and/ (+ slot 1) mask))
    )
    (let id (call add-string span))
    (= ([] interned slot) (+ id 1))
    (if (> (* string-count 2) interned-capacity)
      (call grow-interned)
    )
    (return id)
  )
  (fn-do + found StringId
    (param span ByteSpan)
    ; The id of a string the pool holds, found by its bytes without adding it, or none. Workers
    ; may ask while the pool is whole.
    (let hash (call fnv-hash (. span data) (. span length)))
    (let mask (- interned-capacity 1))
    (let slot (as (/and/ (/xor/ hash (/zrshift/ hash 32)) mask) U32))
    (while (!= ([] interned slot) 0)
      (let id (- ([] interned slot) 1))
      (let start ([] string-starts id))
      (if (== (- ([] string-starts (+ id 1)) start) (. span length))
        (if (== (call C:memcmp (+ string-base start) (. span data) (. span length)) 0)
          (return id)
        )
      )
      (= slot (/and/ (+ slot 1) mask))
    )
    (return no-string)
  )
  (fn-do + copied-pool StringPool
    (param arena Arena)
    ; The pool of strings as it stands, copied into an arena that outlives the bundle.
    (let starts (call (of (. arena allocate) U32) (+ string-count 1)))
    (call C:memcpy (as starts (of CPointer Byte)) (as string-starts (of CPointer Byte)) (* (as (+ string-count 1) Size) 4))
    (let bytes (call (. arena allocate-raw) (if-expr (!= byte-length 0) byte-length 1)))
    (call C:memcpy bytes string-base (as byte-length Size))
    (return (call StringPool starts bytes string-count))
  )
  (fn-do _ add-string StringId
    (param span ByteSpan)
    (let id string-count)
    (if (== id string-capacity)
      (let capacity (* string-capacity 2))
      (let starts (call (of (. arena allocate) U32) (+ capacity 1)))
      (let flags (call (of (. arena allocate) Byte) capacity))
      (for (in index (..< 0 string-capacity))
        (= ([] starts index) ([] string-starts index))
        (= ([] flags index) ([] symbol-flags index))
      )
      (= string-starts starts)
      (= symbol-flags flags)
      (= string-capacity capacity)
    )
    (let length U32 (as (. span length) U32))
    (if (> (+ byte-length length) byte-capacity)
      (let capacity (* byte-capacity 2))
      (while (> (+ byte-length length) capacity)
        (*= capacity 2)
      )
      (let bytes (call (. arena allocate-raw) capacity))
      (call C:memcpy bytes string-base byte-length)
      (= string-base bytes)
      (= byte-capacity capacity)
    )
    (call C:memcpy (+ string-base byte-length) (. span data) length)
    (= ([] string-starts id) byte-length)
    (+= byte-length length)
    (= ([] string-starts (+ id 1)) byte-length)
    (= string-count (+ id 1))
    (return id)
  )
  (fn-do _ grow-interned _
    (let capacity (* interned-capacity 2))
    (let slots (call (of (. arena allocate) U32) capacity))
    (let mask (- capacity 1))
    (for (in id (..< 0 string-count))
      (let span (call string id))
      (let hash (call fnv-hash (. span data) (. span length)))
      (let slot (as (/and/ (/xor/ hash (/zrshift/ hash 32)) mask) U32))
      (while (!= ([] slots slot) 0)
        (= slot (/and/ (+ slot 1) mask))
      )
      (= ([] slots slot) (+ id 1))
    )
    (= interned slots)
    (= interned-capacity capacity)
  )
  (fn-do + mark-safepoint-free _
    (param symbol StringId)
    ; Names a callee that never enters the runtime's safepoint protocol.
    (if (not (call is-safepoint-free symbol))
      (= safepoint-free (call (. safepoint-free appended) arena symbol))
      (= ([] symbol-flags symbol) (/or/ ([] symbol-flags symbol) safepoint-free-flag))
    )
  )
  (fn-do + note-alignments _
    ; Records how far each data symbol the bundle defines is aligned, up to eight bytes, so that an
    ; access takes a symbol's page offset only where the linker can scale it by the access's size.
    (for (in literal literals)
      (call note-alignment (. literal name) 8)
    )
    (for (in number numbers)
      (call note-alignment (. number name) (. number size))
    )
    (for (in table constant-tables)
      (call note-alignment (. table name) (. table alignment))
    )
    (for (in global globals)
      (call note-alignment (. global name) (. global alignment))
    )
  )
  (fn-do _ note-alignment _
    (param symbol StringId)
    (param alignment U32)
    (if (>= symbol string-count)
      (return)
    )
    (let power U32)
    (while (and (< power 3) (<= (/lshift/ 2u32 power) alignment))
      (+= power 1)
    )
    (= ([] symbol-flags symbol) (/or/ (/and/ ([] symbol-flags symbol) known-flags) alignment-bits))
    (lazy alignment-bits (/lshift/ (as (+ power 1) Byte) alignment-shift))
  )
  (fn-expr + symbol-alignment U32 @inline
    (param symbol StringId)
    ; How far a data symbol is aligned, or 0 for one whose alignment the bundle does not know.
    (case? (or (>= symbol string-count) (== code 0))
      0
    )
    (default
      (/lshift/ 1u32 (- code 1))
    )
    (where
      (lazy code (as (/zrshift/ ([] symbol-flags symbol) alignment-shift) U32))
    )
  )
  (fn-do + mark-cold-callee _
    (param symbol StringId)
    ; Names a callee that a block calls only on its way to a panic, so that block layout places the
    ; block after the code that runs. A bundle read from a file names none.
    (= cold-callees (call (. cold-callees appended) arena symbol))
  )
  (fn-do + is-cold-callee Bool
    (param symbol StringId)
    (for (in index (..< 0 (. cold-callees length)))
      (if (== ([] cold-callees index) symbol)
        (return true)
      )
    )
    (return false)
  )
  (fn-do + mark-memory-copy-callee _
    (param symbol StringId)
    (= ([] symbol-flags symbol) (/or/ ([] symbol-flags symbol) memory-copy-callee-flag))
  )
  (fn-do + mark-safe-struct-callee _
    (param symbol StringId)
    (= ([] symbol-flags symbol) (/or/ ([] symbol-flags symbol) safe-struct-callee-flag))
  )
  (fn-do + copy-bytes ByteSpan
    (param span ByteSpan)
    ; A copy of bytes that lives as long as the bundle, for a literal a worker's arena held.
    (let bytes (call (. arena allocate-raw) (if-expr (!= (. span length) 0) (. span length) 1)))
    (call C:memcpy bytes (. span data) (. span length))
    (return (call ByteSpan bytes (. span length)))
  )
  (fn-do + load _ (?! Error)
    (param path String)
    (call read-file path)
    (= cursor 0)
    (throw (call Error (str path " is not a backend bundle")) (if (!= (call next) bundle-magic)))
    (let version (call next))
    (throw (call Error (str "Backend bundle version " version " is not " bundle-version)) (if (!= version bundle-version)))
    (let flags (call next))
    (= gc-enabled (!= (/and/ flags 1) 0))
    (= stack-trace-metadata (!= (/and/ flags 2) 0))
    (= output-mode (call next))
    (call read-string-pool)
    (= entry-name (call find-string "entry"))
    (= main-name (call find-string "main"))
    (= safepoint-free (call read-symbol-set))
    (= inferred-safepoint-free (call read-symbol-set))
    (call read-runtime-symbols)
    (call flag-symbols)
    (call flag-symbol-set memory-copy-callee-flag)
    (call flag-symbol-set safe-struct-callee-flag)
    (call read-manifest)
    (call read-functions)
    (throw (call Error (str path " has " (- word-count cursor) " words after its last function")) (if (!= cursor word-count)))
  )
  (fn-do _ read-file _ (?! Error)
    (param path String)
    (let location Path path)
    (let size Size (. location size))
    (throw (call Error (str path " is not a backend bundle")) (if (or (< size 24) (!= (% size 4) 0))))
    (let file (use (call File path)))
    (let data (call (. arena allocate-raw) size 8))
    (let contents (call (of Array Byte) data size))
    (let filled Size 0)
    (while (< filled size)
      (let wanted (- size filled))
      (if (> wanted read-chunk-size)
        (= wanted read-chunk-size)
      )
      (let count (call (. file read) wanted ([] contents (... filled))))
      (if (== count 0)
        (break)
      )
      (+= filled count)
    )
    (throw (call Error (str path " changed while it was read")) (if (!= filled size)))
    (= words (as data (of CPointer U32)))
    (= word-count (/ size 4))
  )
  (fn-do _ next U32 @inline
    (throw (call Panic "The backend bundle is truncated") (if (>= cursor word-count)))
    (let value ([] words cursor))
    (+= cursor 1)
    (return value)
  )
  (fn-do _ next-u64 U64
    (let low U64 (call next))
    (let high U64 (call next))
    (return (/or/ low (/lshift/ high 32)))
  )
  (fn-do _ next-string StringId
    (let id (call next))
    (throw (call Panic (str "The backend bundle names string " id " of " string-count)) (if (>= id string-count)))
    (return id)
  )
  (fn-do _ skip-bytes ByteSpan
    (param length Size)
    (let span (call ByteSpan (as (+ words cursor) (of CPointer Byte)) length))
    (+= cursor (/ (+ length 3) 4))
    (throw (call Panic "The backend bundle is truncated") (if (> cursor word-count)))
    (return span)
  )
  (fn-do _ read-string-pool _
    (= string-count (call next))
    (let total Size (call next))
    (let starts (call (of (. arena allocate) U32) (+ string-count 1)))
    (let offset U32)
    (for (in index (..< 0 string-count))
      (= ([] starts index) offset)
      (+= offset (call next))
    )
    (= ([] starts string-count) offset)
    (throw (call Panic "The backend bundle's string pool is inconsistent") (if (!= offset total)))
    (= string-starts starts)
    (= string-base (. (call skip-bytes total) data))
  )
  (fn-do _ read-symbol-set IdList
    (let count (call next))
    (let symbols (call new-id-list arena count))
    (for (in _ (..< 0 count))
      (= symbols (call (. symbols appended) arena (call next-string)))
    )
    (return symbols)
  )
  (fn-do _ read-runtime-symbols _
    (let symbols (call read-symbol-set))
    (throw (call Panic (str "The backend bundle names " (. symbols length) " runtime symbols, not " runtime-symbol-count)) (if (!= (. symbols length) runtime-symbol-count)))
    (= gc-public-control-word-symbol ([] symbols 0))
    (= write-barrier-record-symbol ([] symbols 1))
    (= zero-stack-frame-symbol ([] symbols 2))
    (= bulk-write-barrier-symbol ([] symbols 3))
  )
  (fn-do _ flag-symbols _
    (let flags (call (of (. arena allocate) Byte) string-count))
    (for (in index (..< 0 (. safepoint-free length)))
      (let symbol ([] safepoint-free index))
      (= ([] flags symbol) (/or/ ([] flags symbol) safepoint-free-flag))
    )
    (for (in index (..< 0 (. inferred-safepoint-free length)))
      (let symbol ([] inferred-safepoint-free index))
      (= ([] flags symbol) (/or/ ([] flags symbol) inferred-safepoint-free-flag))
    )
    (= symbol-flags flags)
  )
  (fn-do _ flag-symbol-set _
    (param flag Byte)
    (for (in _ (..< 0 (call next)))
      (let symbol (call next-string))
      (= ([] symbol-flags symbol) (/or/ ([] symbol-flags symbol) flag))
    )
  )
  (fn-do _ read-manifest _
    (for (in _ (..< 0 (call next)))
      (let name (call next-string))
      (let character-length (call next))
      (let flags (call next))
      (let length (call next))
      (call (. literals append) (call StringLiteral name character-length flags (call skip-bytes length)))
    )
    (for (in _ (..< 0 (call next)))
      (let name (call next-string))
      (let size (call next))
      (call (. numbers append) (call NumberConstant name size (call next-u64)))
    )
    (for (in _ (..< 0 (call next)))
      (let name (call next-string))
      (let alignment (call next))
      (let count (call next))
      (call (. constant-tables append)
        (block
          (arg (call ConstantTable name alignment (call Span (as (. constant-items length) U32) count)))
        )
      )
      (for (in _ (..< 0 count))
        (call (. constant-items append) (call read-constant))
      )
    )
    (for (in _ (..< 0 (call next)))
      (let name (call next-string))
      (let size (call next))
      (call (. globals append) (call GlobalData name size (call next)))
    )
    (for (in _ (..< 0 (call next)))
      (let kind (as (call next) GCRootKind))
      (let symbol (call next))
      (call (. gc-roots append) (call GCRootRecord kind symbol (call next-string)))
    )
    (= gc-allocation-buffer-version (call next))
    (= gc-control-phase-mask (call next))
  )
  (fn-do _ read-constant ConstantItem
    (let kind (as (call next) ConstantKind))
    (return
      (match kind
        (case= .string-constant
          (call ConstantItem kind 0 (call next-string))
        )
        (case= .label-constant
          (call ConstantItem kind 0 (call next-string))
        )
        (case= .quad-constant
          (call ConstantItem kind (call next-u64) no-string)
        )
        (default
          (call ConstantItem kind (call next) no-string)
        )
      )
    )
  )
  (fn-do _ read-functions _
    (for (in _ (..< 0 (call next)))
      (let order (call next))
      (let label (call next-string))
      (let symbol (call next-string))
      (let is-lowered (!= (call next) 0))
      (let job-string-count (call next))
      (let job-word-count (call next))
      (let strings (+ words cursor))
      (+= cursor job-string-count)
      (let job-words (as (+ words cursor) (of CPointer I32)))
      (+= cursor job-word-count)
      (throw (call Panic "The backend bundle is truncated") (if (> cursor word-count)))
      (call (. functions append)
        (block
          (call FunctionRecord
            (block
              (arg order)
              (arg label)
              (arg symbol)
              (arg is-lowered)
              (arg job-string-count)
              (arg job-word-count)
              (arg strings)
              (arg job-words)
            )
          )
        )
      )
    )
  )
)

(fn-do + read-bundle Bundle (?! Error)
  (param path String)
  (let bundle (call Bundle))
  (call (. bundle load) path)
  (return bundle)
)
