(import ./binary-writer)
(import ./bundle)
(import ./compact)
(import ./mir)
(import ./mir-text)
(import ./relocations)
(import /core/arena)
(import /core/table)
(import /string.h)
(blank)
(prop _ gc-roots-magic U32 (= 0x52594359))
(prop _ trace-magic U32 (= 0x43525459))
(prop _ gc-map-magic U32 (= 0x4d434759))
(prop _ pads-magic U32 (= 0x44415059))
(prop _ pads-header-size U32 (= 16))
(prop _ pads-record-size U32 (= 16))
(prop _ trace-header-size U32 (= 24))
(prop _ trace-record-size U32 (= 40))
(prop _ gc-function-record-size U32 (= 32))
(prop _ gc-location-size U32 (= 12))
(prop _ layout-limit U64 (= 0x80000000))

(type + ObjectBuilder
  (implements (of Usable Void))
  ; The format-independent part of writing an object: its sections' data and relocations, and its
  ; symbols, ordered locals first, then defined externals, then undefined symbols. Symbol values are
  ; offsets in their sections.
  (blank)
  (prop + sections (list ObjectSection))
  (prop + symbols (of Table ObjectSymbol))
  (prop + symbol-order (of CPointer U32))
  (prop + string-table ByteSpan)
  (prop + local-count U32)
  (prop + external-count U32)
  (prop + undefined-count U32)
  (prop + arena Arena)
  (blank)
  (prop _ bundle Bundle)
  (prop _ symbol-rows (of CPointer U32))
  (prop _ descriptor-indexes (of CPointer U32))
  (prop _ descriptors IdList)
  (prop _ released Bool)
  (fn-do + This _
    (param bundle Bundle)
    (= symbol-rows (call (of (. arena allocate) U32) (. bundle string-count)))
    (+= sections (call ObjectSection 2 false arena))
    (+= sections (call ObjectSection 0 false arena))
    (+= sections (call ObjectSection 3 false arena))
    (+= sections (call ObjectSection 3 false arena))
    (+= sections (call ObjectSection 3 false arena))
    (+= sections (call ObjectSection 3 false arena))
    (+= sections (call ObjectSection 3 false arena))
    (+= sections (call ObjectSection 3 true arena))
    (blank)
    (lazy symbols (call (of Table ObjectSymbol) arena 1024))
  )
  (fn-expr + begin-using _
    this
  )
  (fn-do + end-using _
    (call release)
  )
  (fn-do + release _
    (if (not released)
      (call (. arena release))
      (= released true)
    )
  )
  (fn-do + build _
    (param functions (of CPointer CompactFunction))
    (param ordered (list U32))
    (call emit-data-sections)
    (if (. bundle gc-enabled)
      (call emit-gc-root-metadata)
    )
    (call emit-text-section functions ordered)
    (if (. bundle stack-trace-metadata)
      (call emit-trace-metadata functions ordered)
    )
    (if (. bundle gc-enabled)
      (call emit-gc-map-metadata functions ordered)
    )
    (call emit-pad-metadata functions ordered)
    (= symbol-order (call finalize-symbols))
    (= string-table (call build-string-table symbol-order))
  )
  (fn-expr + section ObjectSection
    (param index U32)
    ([] sections (- index 1))
  )
  (fn-expr + symbol-name ByteSpan
    (param symbol ObjectSymbol)
    (call (. bundle string) (. symbol name))
  )
  (fn-do _ emit-data-sections _
    (let data (call BinaryWriter arena 65536))
    (for (in literal (. bundle literals))
      (call (. data align) 8)
      (call (. data u64) (as (. literal bytes length) U64))
      (call (. data u32) (. literal character-length))
      (call (. data u32) (. literal flags))
      (call define-symbol (. literal name) (. SectionId const) (as (. data length) U64) false)
      (call (. data bytes) (. literal bytes))
      (call (. data u8) 0)
    )
    (for (in number (. bundle numbers))
      (call (. data align) (. number size))
      (call define-symbol (. number name) (. SectionId const) (as (. data length) U64) false)
      (if (== (. number size) 8)
        (call (. data u64) (. number bits))
        (else
          (call (. data u32) (as (/and/ (. number bits) 0xffffffff) U32))
        )
      )
    )
    (for (in table (. bundle constant-tables))
      (call (. data align) (. table alignment))
      (call define-symbol (. table name) (. SectionId const) (as (. data length) U64) false)
      (for (in index (..< (. table items start) (. table items end)))
        (let item ([] (. bundle constant-items) index))
        (let kind (. item kind))
        (if (== kind .byte-constant)
          (call (. data u8) (as (/and/ (. item bits) 0xff) U32))
          (else-if (== kind .short-constant)
            (call (. data u16) (as (/and/ (. item bits) 0xffff) U32))
          )
          (else-if (== kind .long-constant)
            (call (. data u32) (as (/and/ (. item bits) 0xffffffff) U32))
          )
          (else-if (== kind .quad-constant)
            (call (. data u64) (. item bits))
          )
          (else-if (== kind .string-constant)
            (call (. data bytes) (call (. bundle string) (. item name)))
            (call (. data u8) 0)
          )
          (else
            (let offset U32 (as (. data length) U32))
            (call (. data u64) 0)
            (call add-relocation (. SectionId const) offset (. item name) .unsigned-relocation)
          )
        )
      )
    )
    (call finish-section (. SectionId const) data)
    (blank)
    (let bss (call section (. SectionId bss)))
    (let globals-external (== (. bundle output-mode) 0))
    (for (in global (. bundle globals))
      (= (. bss size) (call align-value (. bss size) (. global alignment)))
      (call define-symbol (. global name) (. SectionId bss) (. bss size) globals-external)
      (+= (. bss size) (. global size))
    )
  )
  (fn-do _ emit-gc-root-metadata _
    (let writer (call BinaryWriter arena 4096))
    (let count U32 (as (. bundle gc-roots length) U32))
    (call (. writer u32) gc-roots-magic)
    (call (. writer u16) 1)
    (call (. writer u16) 8)
    (call (. writer u32) count)
    (call (. writer u32) 0)
    (for (in record (. bundle gc-roots))
      (let kind U32 (. record kind))
      (call (. writer u8) (+ kind 1))
      (call (. writer u8) 0)
      (call (. writer u16) 0)
      (call (. writer u32) 0)
      (let symbol (call (. bundle non-empty) (. record symbol)))
      (if (!= symbol no-string)
        (call add-relocation (. SectionId gc-roots) (as (. writer length) U32) symbol .unsigned-relocation)
      )
      (call (. writer u64) 0)
      (call add-relocation
        (block
          (arg (. SectionId gc-roots))
          (arg (as (. writer length) U32))
          (arg (. record descriptor))
          (arg .unsigned-relocation)
        )
      )
      (call (. writer u64) 0)
    )
    (call finish-section (. SectionId gc-roots) writer)
  )
  (fn-do _ emit-text-section _
    (param functions (of CPointer CompactFunction))
    (param ordered (list U32))
    (let count (. ordered length))
    (let starts (call (of (. arena allocate) U32) count))
    (let size U64)
    (for (in index (..< 0 count))
      (let compact ([] functions ([] ordered index)))
      (= ([] starts index) (as size U32))
      (call define-symbol (. compact symbol) (. SectionId text) size (. compact is-external))
      (let row (- ([] symbol-rows (. compact symbol)) 1))
      (= (. ([] symbols row) size) (as (. compact code length) U64))
      (= (. ([] symbols row) is-function) true)
      (for (in position (..< 0 (. compact jump-table-count)))
        (let table ([] (. compact jump-tables) position))
        (call define-symbol (. table name) (. SectionId text) (+ size (. table offset)) false)
      )
      (+= size (. compact code length))
    )
    (call check-layout size)
    (blank)
    (let data (call (. arena allocate-raw) (as size Size) 8))
    (for (in index (..< 0 count))
      (let compact ([] functions ([] ordered index)))
      (let start ([] starts index))
      (call C:memcpy (+ data start) (. compact code data) (. compact code length))
      (for (in position (..< 0 (. compact relocation-count)))
        (let relocation ([] (. compact relocations) position))
        (let offset (+ start (. relocation offset)))
        (let row ([] symbol-rows (. relocation symbol)))
        (if (and (call is-branch26-relocation (. relocation kind)) (!= row 0) targets-text)
          (let target I64 (as (. ([] symbols (- row 1)) value) I64))
          (let source I64 offset)
          (call patch-local-branch (as (+ data offset) (of CPointer U32)) (- target source))
          (else
            (call add-relocation (. SectionId text) offset (. relocation symbol) (. relocation kind))
          )
        )
        (lazy targets-text (== (. ([] symbols (- row 1)) section) (. SectionId text)))
      )
    )
    (let text (call section (. SectionId text)))
    (= (. text data) (call ByteSpan data (as size Size)))
    (= (. text size) size)
  )
  (fn-do _ patch-local-branch _
    (param word (of CPointer U32))
    (param delta I64)
    (throw (call Panic (str "Unaligned local branch delta " delta)) (if (!= (% delta 4) 0)))
    (blank)
    (let immediate (/ delta 4))
    (throw (call Panic (str "Local branch is out of range: " delta)) (if (or (< immediate -33554432) (> immediate 33554431))))
    (blank)
    (= ([] word 0) (/or/ (/and/ ([] word 0) 0xfc000000) (/and/ (as immediate U32) 0x03ffffff)))
  )
  (fn-do _ emit-trace-metadata _
    (param functions (of CPointer CompactFunction))
    (param ordered (list U32))
    (let strings (call StringOffsets bundle arena))
    (let records (call BinaryWriter arena 65536))
    (let lines (call BinaryWriter arena 65536))
    (let record-count U32)
    (let line-count U32)
    (for (in index (..< 0 (. ordered length)))
      (let compact ([] functions ([] ordered index)))
      (if (== (. compact code length) 0)
        (continue)
      )
      (let file-offset (call (. strings add-file) (. compact source-file)))
      (let first-line line-count)
      (for (in position (..< 0 (. compact line-record-count)))
        (let line ([] (. compact line-records) position))
        (let line-file (call (. strings add-file) (. line file)))
        (call (. lines u32) (. line pc-offset))
        (call (. lines u32) line-file)
        (call (. lines i32) (. line line))
        (call (. lines u16) (as (. line column) U32))
        (call (. lines u16) 0)
        (+= line-count 1)
      )
      (let name-offset (call (. strings add) (. compact display-name)))
      (let record-offset (+ trace-header-size (* record-count trace-record-size)))
      (call add-relocation (. SectionId trace) record-offset (. compact symbol) .unsigned-relocation)
      (call (. records u64) 0)
      (call (. records u32) (as (. compact code length) U32))
      (call (. records u32) name-offset)
      (call (. records u32) file-offset)
      (call (. records i32) (. compact source-line))
      (call (. records i32) (. compact source-column))
      (call (. records u32) first-line)
      (call (. records u32) (- line-count first-line))
      (call (. records u32) 0)
      (+= record-count 1)
    )
    (blank)
    (let writer
      (call BinaryWriter
        (block
          (arg arena)
          (arg (+ trace-header-size (. records length) (. lines length) (. strings strings length)))
        )
      )
    )
    (call (. writer u32) trace-magic)
    (call (. writer u16) 2)
    (call (. writer u16) 0)
    (call (. writer u32) record-count)
    (call (. writer u32) line-count)
    (call (. writer u32) (. strings file-count))
    (call (. writer u32) (as (. strings strings length) U32))
    (call (. writer bytes) (. records view))
    (call (. writer bytes) (. lines view))
    (call (. writer bytes) (. strings strings view))
    (call finish-section (. SectionId trace) writer)
  )
  (fn-do _ emit-pad-metadata _
    (param functions (of CPointer CompactFunction))
    (param ordered (list U32))
    ; Each function's checked calls, by return address, with the landing pad a panic returned to
    ; that address goes to: a header, a record for each function that has any, giving its address,
    ; its first entry and how many it has, then the entries as offsets in the function.
    (let records (call BinaryWriter arena 4096))
    (let entries (call BinaryWriter arena 65536))
    (let function-symbols (call IdList))
    (let entry-count U32)
    (for (in index (..< 0 (. ordered length)))
      (let compact ([] functions ([] ordered index)))
      (if (or (== (. compact code length) 0) (== (. compact pad-count) 0))
        (continue)
      )
      (call (. records u64) 0)
      (call (. records u32) entry-count)
      (call (. records u32) (. compact pad-count))
      (for (in position (..< 0 (. compact pad-count)))
        (let pad ([] (. compact pads) position))
        (call (. entries u32) (. pad return-offset))
        (call (. entries u32) (. pad pad-offset))
      )
      (+= entry-count (. compact pad-count))
      (= function-symbols (call (. function-symbols appended) arena (. compact symbol)))
    )
    (blank)
    (if (== (. function-symbols length) 0)
      (return)
    )
    (blank)
    (let writer (call BinaryWriter arena (+ pads-header-size (. records length) (. entries length))))
    (call (. writer u32) pads-magic)
    (call (. writer u16) 1)
    (call (. writer u16) 0)
    (call (. writer u32) (. function-symbols length))
    (call (. writer u32) entry-count)
    (for (in index (..< 0 (. function-symbols length)))
      (call add-relocation
        (block
          (arg (. SectionId pads))
          (arg (+ pads-header-size (* index pads-record-size)))
          (arg ([] function-symbols index))
          (arg .unsigned-relocation)
        )
      )
    )
    (call (. writer bytes) (. records view))
    (call (. writer bytes) (. entries view))
    (call finish-section (. SectionId pads) writer)
  )
  (fn-do _ emit-gc-map-metadata _
    (param functions (of CPointer CompactFunction))
    (param ordered (list U32))
    (let function-records (call BinaryWriter arena 65536))
    (let safepoint-records (call BinaryWriter arena 65536))
    (let location-records (call BinaryWriter arena 65536))
    (let saved-records (call BinaryWriter arena 4096))
    (let run (call BinaryWriter arena 4096))
    (let runs (call LocationRuns arena))
    (let function-symbols (call IdList))
    (let function-count U32)
    (let safepoint-count U32)
    (let location-count U32)
    (let saved-count U32)
    (= descriptor-indexes (call (of (. arena allocate) U32) (. bundle string-count)))
    (= descriptors (call IdList))
    (blank)
    (for (in index (..< 0 (. ordered length)))
      (let compact ([] functions ([] ordered index)))
      (if (== (. compact code length) 0)
        (continue)
      )
      (let first-safepoint safepoint-count)
      (for (in position (..< 0 (. compact safepoint-count)))
        (let safepoint ([] (. compact safepoints) position))
        (call (. run clear))
        (for (in offset (..< 0 (. safepoint location-count)))
          (let location ([] (. compact locations) (+ (. safepoint first-location) offset)))
          (call (. run u8) (. location kind))
          (call (. run u8) (. location register))
          (call (. run u16) 0)
          (call (. run i32) (. location offset))
          (call (. run u32) (call descriptor-index (. location descriptor)))
        )
        (let wide-hash (call fnv-hash (. run data) (. run length)))
        (let hash (as (/and/ (/xor/ wide-hash (/zrshift/ wide-hash 32)) 0xffffffff) U32))
        (let first-location (call (. runs find) (. run view) hash (. location-records data)))
        (if (== first-location no-id)
          (= first-location location-count)
          (call (. runs add) first-location (. safepoint location-count) hash)
          (call (. location-records bytes) (. run view))
          (+= location-count (. safepoint location-count))
        )
        (call (. safepoint-records u32) (. safepoint pc-offset))
        (call (. safepoint-records u32) first-location)
        (call (. safepoint-records u32) (. safepoint location-count))
        (+= safepoint-count 1)
      )
      (let first-saved saved-count)
      (for (in position (..< 0 (. compact saved-register-count)))
        (let saved ([] (. compact saved-registers) position))
        (call (. saved-records u8) (. saved register))
        (call (. saved-records u8) 0)
        (call (. saved-records u16) 0)
        (call (. saved-records i32) (. saved fp-offset))
        (+= saved-count 1)
      )
      (call (. function-records u64) 0)
      (call (. function-records u32) (as (. compact code length) U32))
      (call (. function-records u32) first-safepoint)
      (call (. function-records u32) (- safepoint-count first-safepoint))
      (call (. function-records u32) first-saved)
      (call (. function-records u32) (- saved-count first-saved))
      (call (. function-records u32) 0)
      (= function-symbols (call (. function-symbols appended) arena (. compact symbol)))
      (+= function-count 1)
    )
    (blank)
    (if (== function-count 0)
      (return)
    )
    (blank)
    (let writer (call BinaryWriter arena 65536))
    (call (. writer u32) gc-map-magic)
    (call (. writer u16) 3)
    (call (. writer u16) 8)
    (call (. writer u32) function-count)
    (call (. writer u32) safepoint-count)
    (call (. writer u32) location-count)
    (call (. writer u32) saved-count)
    (call (. writer u32) (. descriptors length))
    (call (. writer u32) (. bundle gc-allocation-buffer-version))
    (for (in index (..< 0 (. descriptors length)))
      (call add-relocation (. SectionId gc-map) (as (. writer length) U32) ([] descriptors index) .unsigned-relocation)
      (call (. writer u64) 0)
    )
    (let function-records-offset U32 (as (. writer length) U32))
    (call (. writer bytes) (. function-records view))
    (for (in index (..< 0 (. function-symbols length)))
      (call add-relocation
        (block
          (arg (. SectionId gc-map))
          (arg (+ function-records-offset (* index gc-function-record-size)))
          (arg ([] function-symbols index))
          (arg .unsigned-relocation)
        )
      )
    )
    (call (. writer bytes) (. safepoint-records view))
    (call (. writer bytes) (. location-records view))
    (call (. writer bytes) (. saved-records view))
    (call finish-section (. SectionId gc-map) writer)
  )
  (fn-do _ descriptor-index U32
    (param descriptor StringId)
    (if (== descriptor no-string)
      (return 0)
    )
    (let known ([] descriptor-indexes descriptor))
    (if (!= known 0)
      (return known)
    )
    (= descriptors (call (. descriptors appended) arena descriptor))
    (= ([] descriptor-indexes descriptor) (. descriptors length))
    (return (. descriptors length))
  )
  (fn-do _ finish-section _
    (param index U32)
    (param writer BinaryWriter)
    (let target (call section index))
    (= (. target data) (. writer view))
    (= (. target size) (as (. writer length) U64))
  )
  (fn-do _ define-symbol _
    (param name StringId)
    (param section-index U32)
    (param offset U64)
    (param is-external Bool)
    (let row ([] symbol-rows name))
    (if (!= row 0)
      (throw (call Panic (str "Symbol " (call (. bundle text) name) " is defined twice")) (if (!= (. ([] symbols (- row 1)) section) (. SectionId none))))
      (blank)
      (= (. ([] symbols (- row 1)) section) section-index)
      (= (. ([] symbols (- row 1)) value) offset)
      (= (. ([] symbols (- row 1)) is-external) is-external)
      (return)
    )
    (call (. symbols append) (call ObjectSymbol name section-index offset 0 false is-external 0 0))
    (= ([] symbol-rows name) (as (. symbols length) U32))
  )
  (fn-do _ reference-symbol U32
    (param name StringId)
    (let row ([] symbol-rows name))
    (if (!= row 0)
      (return (- row 1))
    )
    (call (. symbols append) (call ObjectSymbol name (. SectionId none) 0 0 false true 0 0))
    (= ([] symbol-rows name) (as (. symbols length) U32))
    (return (- ([] symbol-rows name) 1))
  )
  (fn-do _ add-relocation _
    (param section-index U32)
    (param offset U32)
    (param name StringId)
    (param kind RelocationKind)
    (let symbol (call reference-symbol name))
    (call (. (call section section-index) relocations append) (call ObjectRelocation offset symbol kind))
  )
  (fn-do _ finalize-symbols (of CPointer U32)
    (let count U32 (as (. symbols length) U32))
    (let order (call (of (. arena allocate) U32) count))
    (let next U32)
    (for (in group (..< 0 3))
      (for (in row (..< 0 count))
        (let symbol ([] symbols row))
        (let symbol-group U32 2)
        (if (!= (. symbol section) (. SectionId none))
          (= symbol-group (if-expr (. symbol is-external) 1 0))
        )
        (if (== symbol-group group)
          (= ([] order next) row)
          (= (. ([] symbols row) index) next)
          (+= next 1)
        )
      )
      (if (== group 0)
        (= local-count next)
        (else-if (== group 1)
          (= external-count (- next local-count))
        )
      )
    )
    (= undefined-count (- count local-count external-count))
    (return order)
  )
  (fn-do _ build-string-table ByteSpan
    (param order (of CPointer U32))
    (let writer (call BinaryWriter arena 65536))
    (call (. writer u8) 0)
    (for (in position (..< 0 (. symbols length)))
      (let row ([] order position))
      (= (. ([] symbols row) string-offset) (as (. writer length) U32))
      (call (. writer bytes) (call (. bundle string) (. ([] symbols row) name)))
      (call (. writer u8) 0)
    )
    (return (. writer view))
  )
)

(type + SectionId (is U32)
  (variant none)
  (variant text)
  (variant cstring)
  (variant const)
  (variant trace)
  (variant gc-map)
  (variant gc-roots)
  (variant pads)
  (variant bss)
)

(type + ObjectRelocation (is Struct)
  (prop + offset U32)
  (prop + symbol U32)
  (prop + kind RelocationKind)
)

(type + ObjectSymbol (is Struct)
  (prop + name StringId)
  (prop + section U32)
  (prop + value U64)
  (prop + size U64)
  (prop + is-function Bool)
  (prop + is-external Bool)
  (prop + string-offset U32)
  (prop + index U32)
)

(type + ObjectSection
  ; A section of the object, by what it holds; each writer names it and lays it out in its format.
  (blank)
  (prop + alignment-power U32)
  (prop + is-zero-fill Bool)
  (prop + arena Arena)
  (prop + relocations (of Table ObjectRelocation))
  (prop + data ByteSpan)
  (prop + size U64)
  (prop + address U64)
  (prop + file-offset U64)
  (prop + reloc-offset U64)
  (fn-do + This _
    (param alignment-power U32)
    (param is-zero-fill Bool)
    (param arena Arena)
    (lazy relocations (call (of Table ObjectRelocation) arena 16))
  )
)

(fn-do + check-layout _
  (param value U64)
  (throw (call Panic (str "Object layout value " value " is out of range")) (if (>= value layout-limit)))
)

(fn-do + align-value U64
  (param value U64)
  (param alignment U64)
  (call check-layout value)
  (if (<= alignment 1)
    (return value)
  )
  (return (/and/ (- (+ value alignment) 1) (/xor/ (- alignment 1) (. U64 max))))
)

(type _ StringOffsets
  (prop + strings BinaryWriter)
  (prop + file-count U32)
  (blank)
  (prop _ bundle Bundle)
  (prop _ arena Arena)
  (prop _ offsets (of CPointer U32))
  (prop _ files (of CPointer Byte))
  (prop _ empty-offset U32 (= no-id))
  (fn-do + This _
    (param bundle Bundle)
    (param arena Arena)
    (= offsets (call (of (. arena allocate) U32) (. bundle string-count)))
    (= files (call (of (. arena allocate) Byte) (. bundle string-count)))
    (blank)
    (lazy strings (call BinaryWriter arena 65536))
  )
  (fn-do + add U32
    (param name StringId)
    (let id (call (. bundle non-empty) name))
    (if (== id no-string)
      (if (== empty-offset no-id)
        (= empty-offset (as (. strings length) U32))
        (call (. strings u8) 0)
      )
      (return empty-offset)
    )
    (let known ([] offsets id))
    (if (!= known 0)
      (return (- known 1))
    )
    (let offset U32 (as (. strings length) U32))
    (= ([] offsets id) (+ offset 1))
    (call (. strings bytes) (call (. bundle string) id))
    (call (. strings u8) 0)
    (return offset)
  )
  (fn-do + add-file U32
    (param name StringId)
    (let id (call (. bundle non-empty) name))
    (if (and (!= id no-string) (== ([] files id) 0))
      (= ([] files id) 1)
      (+= file-count 1)
    )
    (return (call add id))
  )
)

(type _ LocationRuns
  (prop _ arena Arena)
  (prop _ slots (of CPointer U32))
  (prop _ capacity U32)
  (prop _ count U32)
  (fn-do + This _
    (param arena Arena)
    (= capacity 1024)
    (= slots (call (of (. arena allocate) U32) (* capacity 3)))
  )
  (fn-do + find U32
    (param run ByteSpan)
    (param hash U32)
    (param records (of CPointer Byte))
    (let mask (- capacity 1))
    (let index (/and/ hash mask))
    (let location-count U32 (as (/ (. run length) gc-location-size) U32))
    (while true
      (let first ([] slots (* index 3)))
      (if (== first 0)
        (return no-id)
      )
      (if (and (== ([] slots (+ (* index 3) 2)) hash) (== ([] slots (+ (* index 3) 1)) location-count))
        (let start (* (- first 1) gc-location-size))
        (if (== (call C:memcmp (+ records start) (. run data) (. run length)) 0)
          (return (- first 1))
        )
      )
      (= index (/and/ (+ index 1) mask))
    )
  )
  (fn-do + add _
    (param first U32)
    (param location-count U32)
    (param hash U32)
    (if (> (* (+ count 1) 2) capacity)
      (call grow)
    )
    (call place (+ first 1) location-count hash)
    (+= count 1)
  )
  (fn-do _ place _
    (param marked-first U32)
    (param location-count U32)
    (param hash U32)
    (let mask (- capacity 1))
    (let index (/and/ hash mask))
    (while (!= ([] slots (* index 3)) 0)
      (= index (/and/ (+ index 1) mask))
    )
    (= ([] slots (* index 3)) marked-first)
    (= ([] slots (+ (* index 3) 1)) location-count)
    (= ([] slots (+ (* index 3) 2)) hash)
  )
  (fn-do _ grow _
    (let old-slots slots)
    (let old-capacity capacity)
    (= capacity (* old-capacity 2))
    (= slots (call (of (. arena allocate) U32) (* capacity 3)))
    (for (in index (..< 0 old-capacity))
      (if (!= ([] old-slots (* index 3)) 0)
        (call place ([] old-slots (* index 3)) ([] old-slots (+ (* index 3) 1)) ([] old-slots (+ (* index 3) 2)))
      )
    )
  )
)
