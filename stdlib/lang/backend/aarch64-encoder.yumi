            . ones = bit-mask(ones-length)
            for immr in 0 .. < size
                if rotate-right(ones, immr, size) == pattern
                    . n U32 = if bits == 64 && size == 64 then 1 else 0
                    . imms = (size-prefix /or/ ((ones-length - 1) as U32)) /and/ 0x3f
                        .. size-prefix = ((size - 1) /xor/ U32.max) /lshift/ 1
                    = LogicalImmediate(true, n, immr, imms)
    size *= 2
= LogicalImmediate()

