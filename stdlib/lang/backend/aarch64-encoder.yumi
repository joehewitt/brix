────────────────────
+ This
    - bundle Bundle
    - function MIRFunction
    - labels TextLabels

────────────────────
+ do encode U32
    - id InstructionId
    - offset U32

. row = function.instructions[id]
= encode-operation(row.opcode, row.operands, offset)

────────────────────
+ do encode-operation U32
    - opcode Opcode
    - operands IdList
    - offset U32

current-offset = offset
has-relocation = false
. a = operand(operands, 0)
. b = operand(operands, 1)
. c = operand(operands, 2)
. d = operand(operands, 3)
= match opcode
    |= .nop
        0xd503201f
    |= .ret
        0xd65f0000 /or/ ((if a == no-operand then link-register else reg(a)) /lshift/ 5)
    |= .br
        0xd61f0000 /or/ (reg(a) /lshift/ 5)
    |= .blr
        0xd63f0000 /or/ (reg(a) /lshift/ 5)
    |= .b
        jump(0x14000000, .jump26-relocation, a, offset, true)
    |= .bl
        jump(0x94000000, .call26-relocation, a, offset, false)
    |= .cbz
        compare-branch(false, a, local-label-offset(b), offset)
    |= .cbnz
        compare-branch(true, a, local-label-offset(b), offset)
    |= .tbz
        test-branch(false, a, b, local-label-offset(c), offset)
    |= .tbnz
        test-branch(true, a, b, local-label-offset(c), offset)
    |= .b-cond
        conditional-branch(operands, local-label-offset(a), offset)
    |= .adr
        adr(a, b, offset)
    |= .adrp
        adrp(a, b)
    |= .mov
        mov(a, b)
    |= .movz
        move-wide(0x52800000, 0xd2800000, a, b, c)
    |= .movk
        move-wide(0x72800000, 0xf2800000, a, b, c)
    |= .movn
        move-wide(0x12800000, 0x92800000, a, b, c)
    |= .fmov
        fmov(a, b)
    |= .neg
        neg(a, b)
    |= .add
        add-sub(false, a, b, c, d)
    |= .sub
        add-sub(true, a, b, c, d)
    |= .mul
        three-reg(0x1b007c00, 0x9b007c00, a, b, c)
    |= .madd
        four-reg(0x1b000000, 0x9b000000, a, b, c, d)
    |= .msub
        four-reg(0x1b008000, 0x9b008000, a, b, c, d)
    |= .umulh
        three-reg(0x9bc07c00, 0x9bc07c00, a, b, c)
    |= .smulh
        three-reg(0x9b407c00, 0x9b407c00, a, b, c)
    |= .umull
        three-reg(0x9ba07c00, 0x9ba07c00, a, b, c)
    |= .smull
        three-reg(0x9b207c00, 0x9b207c00, a, b, c)
    |= .sdiv
        three-reg(0x1ac00c00, 0x9ac00c00, a, b, c)
    |= .udiv
        three-reg(0x1ac00800, 0x9ac00800, a, b, c)
    |= .and
        logical(0x0a000000, 0x8a000000, a, b, c, d)
    |= .orr
        logical(0x2a000000, 0xaa000000, a, b, c, d)
    |= .eor
        logical(0x4a000000, 0xca000000, a, b, c, d)
    |= .mvn
        mvn(a, b)
    |= .clz
        two-reg(0x5ac01000, 0xdac01000, a, b)
    |= .lsl
        shift(0, a, b, c)
    |= .lsr
        shift(1, a, b, c)
    |= .asr
        shift(2, a, b, c)
    |= .lslv
        three-reg(0x1ac02000, 0x9ac02000, a, b, c)
    |= .lsrv
        three-reg(0x1ac02400, 0x9ac02400, a, b, c)
    |= .asrv
        three-reg(0x1ac02800, 0x9ac02800, a, b, c)
    |= .cmp
        cmp(a, b, c)
    |= .ccmp
        conditional-compare(a, b, c, d)
    |= .csel
        conditional-select(0x1a800000, 0x9a800000, a, b, c, d)
    |= .csinc
        conditional-select(0x1a800400, 0x9a800400, a, b, c, d)
    |= .csinv
        conditional-select(0x5a800000, 0xda800000, a, b, c, d)
    |= .csneg
        conditional-select(0x5a800400, 0xda800400, a, b, c, d)
    |= .fcsel
        conditional-select(0x1e200c00, 0x1e600c00, a, b, c, d)
    |= .cset
        cset(a, b)
    |= .ldr
        load-store(true, a, b, c, 0, false)
    |= .ldar
        load-acquire(a, b)
    |= .ldarb
        byte-acquire-release(0x08dffc00, a, b)
    |= .stlrb
        byte-acquire-release(0x089ffc00, a, b)
    |= .str
        load-store(false, a, b, c, 0, false)
    |= .ldrb
        load-store(true, a, b, c, 1, false)
    |= .strb
        load-store(false, a, b, c, 1, false)
    |= .ldrh
        load-store(true, a, b, c, 2, false)
    |= .strh
        load-store(false, a, b, c, 2, false)
    |= .ldrsw
        load-store(true, a, b, c, 4, true)
    |= .ldrsb
        load-store(true, a, b, c, 1, true)
    |= .ldrsh
        load-store(true, a, b, c, 2, true)
    |= .stp
        load-store-pair(false, a, b, c, d)
    |= .ldp
        load-store-pair(true, a, b, c, d)
    |= .fneg
        two-reg(0x1e214000, 0x1e614000, a, b)
    |= .fnegs
        two-reg(0x1e214000, 0x1e614000, a, b)
    |= .fnegd
        two-reg(0x1e214000, 0x1e614000, a, b)
    |= .fadd
        three-reg(0x1e202800, 0x1e602800, a, b, c)
    |= .fsub
        three-reg(0x1e203800, 0x1e603800, a, b, c)
    |= .fmul
        three-reg(0x1e200800, 0x1e600800, a, b, c)
    |= .fdiv
        three-reg(0x1e201800, 0x1e601800, a, b, c)
    |= .fabs
        two-reg(0x1e20c000, 0x1e60c000, a, b)
    |= .fsqrt
        two-reg(0x1e21c000, 0x1e61c000, a, b)
    |= .fcmps
        fcmp(a, b)
    |= .fcmpd
        fcmp(a, b)
    |= .scvtf
        int-float-convert(0x1e220000, 0x9e220000, a, b)
    |= .ucvtf
        int-float-convert(0x1e230000, 0x9e230000, a, b)
    |= .fcvtzs
        float-int-convert(0x1e380000, 0x9e380000, a, b)
    |= .fcvtzu
        float-int-convert(0x1e390000, 0x9e390000, a, b)
    |= .fcvt
        fcvt(a, b)
    |= .uxtw
        extend(a, b, false, 31)
    |= .sxtw
        extend(a, b, true, 31)
    |= .uxth
        extend(a, b, false, 15)
    |= .sxth
        extend(a, b, true, 15)
    |= .uxtb
        extend(a, b, false, 7)
    |= .sxtb
        extend(a, b, true, 7)
    |= .ubfx
        bitfield(0x53000000, 0xd3400000, a, b, c, d, false)
    |= .sbfx
        bitfield(0x13000000, 0x93400000, a, b, c, d, false)
    |= .bfi
        bitfield(0x33000000, 0xb3400000, a, b, c, d, true)
    ??
        unsupported(opcode)

────────────────────
+ do branch-to U32
    - target-offset U32
    - offset U32

current-offset = offset
has-relocation = false
= branch(0x14000000, target-offset, offset, 26)

────────────────────
+ do conditional-branch-to U32
    - id InstructionId
    - target-offset U32
    - offset U32

current-offset = offset
has-relocation = false
. row = function.instructions[id]
if row.opcode == .b-cond
    = conditional-branch(row.operands, target-offset, offset)
if row.opcode == .tbz || row.opcode == .tbnz
    = test-branch
        - row.opcode == .tbnz
        - operand(row.operands, 0)
        - operand(row.operands, 1)
        - target-offset
        - offset
= compare-branch(row.opcode == .cbnz, operand(row.operands, 0), target-offset, offset)

────────────────────
+ branch-target OperandId
    - id InstructionId

|? row.opcode == .tbz || row.opcode == .tbnz
    operand(row.operands, 2)
??
    operand(row.operands, if row.opcode == .b-cond then 0 else 1)

.. row = function.instructions[id]

────────────────────
+ do jump-to U32
    - target OperandId
    - offset U32

current-offset = offset
has-relocation = false
= jump(0x14000000, .jump26-relocation, target, offset, true)

────────────────────
_ do unsupported U32
    - opcode Opcode

?! Panic("Unsupported AArch64 instruction: ${opcode-names[opcode]}")

────────────────────
_ operand OperandId
    - operands IdList
    - index U32

if index >= operands.length then no-operand else operands[index]

────────────────────
_ do jump U32
    - base U32
    - kind RelocationKind
    - target OperandId
    - offset U32
    - uses-blocks Bool

. name = symbol-name(target)
. target-offset = no-label
if uses-blocks && is-label(target)
    target-offset = labels.label-offset(name)
else
    target-offset = labels.symbol-offset(name)
if target-offset != no-label
    = branch(base, target-offset, offset, 26)
emit-relocation(kind, name)
= base

────────────────────
_ do branch U32
    - base U32
    - target-offset U32
    - offset U32
    - bits U32

. delta = (target-offset as I32) - (offset as I32)
?! Panic("Unaligned branch target")
    if delta % 4 != 0
. imm = delta /rshift/ 2
check-signed-range(imm, bits, "branch")
= base /or/ ((imm as U32) /and/ ((1u32 /lshift/ bits) - 1))

────────────────────
_ do compare-branch U32
    - nonzero Bool
    - register OperandId
    - target-offset U32
    - offset U32

. delta = (target-offset as I32) - (offset as I32)
?! Panic("Unaligned compare-branch target")
    if delta % 4 != 0
. imm = delta /rshift/ 2
check-signed-range(imm, 19, "compare-branch")
. base U32 = 0x34000000
if nonzero
    base = if is-64(register) then 0xb5000000 else 0x35000000
else if is-64(register)
    base = 0xb4000000
= base /or/ (((imm as U32) /and/ 0x7ffff) /lshift/ 5) /or/ reg(register)

────────────────────
_ do test-branch U32
    - nonzero Bool
    - register OperandId
    - bit-operand OperandId
    - target-offset U32
    - offset U32

. bit = int(bit-operand)
?! Panic("TBZ/TBNZ bit $bit is out of range")
    if bit < 0 || bit >= (if is-64(register) then 64 else 32)
. delta = (target-offset as I32) - (offset as I32)
?! Panic("Unaligned test-branch target")
    if delta % 4 != 0
. imm = delta /rshift/ 2
check-signed-range(imm, 14, "test-branch")
. base U32 = if nonzero then 0x37000000 else 0x36000000
. bits = bit as U32
= with-bit /or/ (((imm as U32) /and/ 0x3fff) /lshift/ 5) /or/ reg(register)
    .. with-bit = base /or/ ((bits /zrshift/ 5) /lshift/ 31) /or/ ((bits /and/ 31) /lshift/ 19)

────────────────────
_ do conditional-branch U32
    - operands IdList
    - target-offset U32
    - offset U32

?! Panic("B.cond requires a label and condition operand")
    if operands.length != 2
. condition = cond(operands[1])
. delta = (target-offset as I32) - (offset as I32)
?! Panic("Unaligned B.cond target")
    if delta % 4 != 0
. imm = delta /rshift/ 2
check-signed-range(imm, 19, "B.cond")
. base U32 = 0x54000000
= base /or/ (((imm as U32) /and/ 0x7ffff) /lshift/ 5) /or/ condition

────────────────────
_ do adr U32
    - dest OperandId
    - label OperandId
    - offset U32

. imm = (local-label-offset(label) as I32) - (offset as I32)
check-signed-range(imm, 21, "ADR")
. bits = imm as U32
. low = bits /and/ 3
. high = (bits /zrshift/ 2) /and/ 0x7ffff
. base U32 = 0x10000000
= base /or/ (low /lshift/ 29) /or/ (high /lshift/ 5) /or/ reg(dest)

────────────────────
_ do adrp U32
    - dest OperandId
    - label OperandId

emit-relocation(.page21-relocation, symbol-name(label))
. base U32 = 0x90000000
= base /or/ reg(dest)

────────────────────
_ do mov U32
    - dest OperandId
    - src OperandId

if is-int(src)
    = mov-immediate(dest, int-value(src))
?! Panic("MOV moves only general registers")
    if is-float(dest) || is-float(src)
if is-stack-pointer(dest) || is-stack-pointer(src)
    . base U32 = if is-64(dest) then 0x91000000 else 0x11000000
    = base /or/ (reg(src) /lshift/ 5) /or/ reg(dest)
. base U32 = if is-64(dest) then 0xaa0003e0 else 0x2a0003e0
= base /or/ (reg(src) /lshift/ 16) /or/ reg(dest)

────────────────────
_ do mov-immediate U32
    - dest OperandId
    - value MIRInt

. wide = is-64(dest)
. bits U32 = if wide then 64 else 32
. normalized = if wide then value.bits else value.bits /and/ 0xffffffff
. move-wide = encode-move-wide-immediate(normalized, bits)
if move-wide.is-encodable
    . base U32 = 0x52800000
    if move-wide.is-negated
        base = if wide then 0x92800000 else 0x12800000
    else if wide
        base = 0xd2800000
    = base /or/ (move-wide.halfword /lshift/ 21) /or/ (move-wide.imm16 /lshift/ 5) /or/ reg(dest)
. logical = encode-logical-immediate(normalized, bits)
?! Panic("MOV immediate is out of direct range")
    if !logical.is-encodable
. base U32 = if wide then 0xb2000000 else 0x32000000
= with-immr /or/ (logical.imms /lshift/ 10) /or/ (31u32 /lshift/ 5) /or/ reg(dest)
    .. with-immr = base /or/ (logical.n /lshift/ 22) /or/ (logical.immr /lshift/ 16)

────────────────────
_ do move-wide U32
    - base32 U32
    - base64 U32
    - dest OperandId
    - imm OperandId
    - shift-operand OperandId

. value = int(imm)
?! Panic("Move-wide immediate must fit in 16 bits: $value")
    if value < 0 || value > 0xffff
. shift I64
if shift-operand != no-operand
    shift = int(shift-operand)
?! Panic("Move-wide shift must be a multiple of 16: $shift")
    if shift % 16 != 0
. halfword = shift / 16
?! Panic("Move-wide shift is out of range: $shift")
    if halfword < 0 || halfword > (if is-64(dest) then 3 else 1)
. base = if is-64(dest) then base64 else base32
= base /or/ ((halfword as U32) /lshift/ 21) /or/ ((value as U32) /lshift/ 5) /or/ reg(dest)

────────────────────
_ do fmov U32
    - dest OperandId
    - src OperandId

if is-int(src)
    . immediate = float-immediate(int-value(src).bits, is-64(dest))
    ?! Panic("FMOV has no immediate for the float ${int-value(src).bits}")
        if immediate == no-float-immediate || !is-float(dest)
    = (if is-64(dest) then 0x1e601000 else 0x1e201000) /or/ (immediate /lshift/ 13) /or/ reg(dest)
. dest-float = is-float(dest)
. src-float = is-float(src)
. base U32
if dest-float && src-float
    base = if is-64(dest) then 0x1e604000 else 0x1e204000
else if src-float
    base = if is-64(dest) then 0x9e660000 else 0x1e260000
else if dest-float
    base = if is-64(dest) then 0x9e670000 else 0x1e270000
else
    ?! Panic("FMOV requires at least one floating-point register")
= base /or/ (reg(src) /lshift/ 5) /or/ reg(dest)

────────────────────
_ neg U32
    - dest OperandId
    - src OperandId

base /or/ (reg(src) /lshift/ 16) /or/ reg(dest)

.. base U32 = if is-64(dest) then 0xcb0003e0 else 0x4b0003e0

────────────────────
_ do add-sub U32
    - is-sub Bool
    - dest OperandId
    - lhs OperandId
    - rhs OperandId
    - shift-operand OperandId

. label = page-offset-label(rhs)
if label != no-string
    emit-relocation(.add-pageoff12-relocation, label)
    . base U32 = if is-64(dest) then 0x91000000 else 0x11000000
    = base /or/ (reg(lhs) /lshift/ 5) /or/ reg(dest)
. wide = is-64(dest)
if is-int(rhs)
    . base U32 = 0x11000000
    if is-sub
        base = if wide then 0xd1000000 else 0x51000000
    else if wide
        base = 0x91000000
    = base /or/ add-sub-immediate(int(rhs)) /or/ (reg(lhs) /lshift/ 5) /or/ reg(dest)
. base U32 = 0x0b000000
if is-sub
    base = if wide then 0xcb000000 else 0x4b000000
else if wide
    base = 0x8b000000
= base /or/ shift-field /or/ (reg(rhs) /lshift/ 16) /or/ (reg(lhs) /lshift/ 5) /or/ reg(dest)
    .. shift-field = shift-bits(shift-operand, dest, false)

────────────────────
_ do add-sub-immediate U32
    - imm I64

if imm >= 0 && imm <= 4095
    = (imm as U32) /lshift/ 10
if imm >= 0 && imm % 4096 == 0 && imm / 4096 <= 4095
    = (1u32 /lshift/ 22) /or/ (((imm / 4096) as U32) /lshift/ 10)
?! Panic("ADD/SUB immediate out of range: $imm")

────────────────────
_ three-reg U32
    - base32 U32
    - base64 U32
    - dest OperandId
    - lhs OperandId
    - rhs OperandId

base /or/ (reg(rhs) /lshift/ 16) /or/ (reg(lhs) /lshift/ 5) /or/ reg(dest)

.. base = if is-64(dest) then base64 else base32

────────────────────
_ four-reg U32
    - base32 U32
    - base64 U32
    - dest OperandId
    - lhs OperandId
    - rhs OperandId
    - addend OperandId

base /or/ (reg(rhs) /lshift/ 16) /or/ addend-field /or/ (reg(lhs) /lshift/ 5) /or/ reg(dest)

.. base = if is-64(dest) then base64 else base32
.. addend-field = reg(addend) /lshift/ 10

────────────────────
_ two-reg U32
    - base32 U32
    - base64 U32
    - dest OperandId
    - src OperandId

base /or/ (reg(src) /lshift/ 5) /or/ reg(dest)

.. base = if is-64(dest) then base64 else base32

────────────────────
_ do logical U32
    - base32 U32
    - base64 U32
    - dest OperandId
    - lhs OperandId
    - rhs OperandId
    - shift-operand OperandId

. wide = is-64(dest)
if !is-int(rhs)
    = shifted /or/ (reg(rhs) /lshift/ 16) /or/ (reg(lhs) /lshift/ 5) /or/ reg(dest)
        .. shifted = (if wide then base64 else base32) /or/ shift-bits(shift-operand, dest, true)
. value = int-value(rhs)
. encoded = encode-logical-immediate(value.bits, if wide then 64 else 32)
?! Panic("Unsupported logical immediate")
    if !encoded.is-encodable
. base U32
if base32 == 0x0a000000
    base = if wide then 0x92000000 else 0x12000000
else if base32 == 0x2a000000
    base = if wide then 0xb2000000 else 0x32000000
else
    base = if wide then 0xd2000000 else 0x52000000
= with-immr /or/ (encoded.imms /lshift/ 10) /or/ (reg(lhs) /lshift/ 5) /or/ reg(dest)
    .. with-immr = base /or/ (encoded.n /lshift/ 22) /or/ (encoded.immr /lshift/ 16)

────────────────────
_ mvn U32
    - dest OperandId
    - src OperandId

base /or/ (reg(src) /lshift/ 16) /or/ reg(dest)

.. base U32 = if is-64(dest) then 0xaa2003e0 else 0x2a2003e0

────────────────────
_ do shift U32
    - kind U32
    - dest OperandId
    - lhs OperandId
    - rhs OperandId

. wide = is-64(dest)
if !is-int(rhs)
    . base U32 = 0x1ac02000 + kind * 0x400
    if wide
        base = base /or/ 0x80000000
    = base /or/ (reg(rhs) /lshift/ 16) /or/ (reg(lhs) /lshift/ 5) /or/ reg(dest)
. bits I64 = if wide then 64 else 32
. amount = int(rhs)
?! Panic("Shift immediate out of range: $amount")
    if amount < 0 || amount >= bits
. immr = amount as U32
. imms = (bits - 1) as U32
. base U32 = if wide then 0xd3400000 else 0x53000000
if kind == 0
    immr = ((bits - amount) /and/ (bits - 1)) as U32
    imms = (bits - 1 - amount) as U32
else if kind == 2
    base = if wide then 0x93400000 else 0x13000000
= base /or/ (immr /lshift/ 16) /or/ (imms /lshift/ 10) /or/ (reg(lhs) /lshift/ 5) /or/ reg(dest)

────────────────────
_ do cmp U32
    - lhs OperandId
    - rhs OperandId
    - shift-operand OperandId

if is-int(rhs)
