|? !is-double && (bits /zrshift/ 32) != 0
    no-float-immediate
|? repeated != (if b != 0 then ((1u64 /lshift/ exponent-bits) - 1) else 0)
    no-float-immediate
|? ((bits /zrshift/ (top - 1)) /and/ 1) == b
    no-float-immediate
??
    ((sign /lshift/ 7) /or/ (b /lshift/ 6) /or/ low) as U32

.. fraction-bits U64 = if is-double then 48 else 19
.. exponent-bits U64 = if is-double then 8 else 5
.. top = if is-double then 63u64 else 31u64
.. low = (bits /zrshift/ fraction-bits) /and/ 0x3f
.. repeated = (bits /zrshift/ (fraction-bits + 6)) /and/ ((1u64 /lshift/ exponent-bits) - 1)
.. b = repeated /and/ 1
.. sign = (bits /zrshift/ top) /and/ 1

