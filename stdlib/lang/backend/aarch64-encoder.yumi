./bundle
./mir
./mir-text
./relocations
/core/arena
/core/table

+ no-label U32 = U32.max
+ no-float-immediate U32 = U32.max
_ condition-always U32 = 14

━━━━━━━━━━━━━━━━━━━━
+ TextLabels

_ bundle Bundle
_ function MIRFunction
_ blocks IdMap
_ symbols IdMap
_ arena Arena

────────────────────
+ This
    - bundle Bundle
    - function MIRFunction

────────────────────
+ do reset
    - storage Arena
    - block-count U32
    - symbol-count U32

arena = storage
blocks = new-id-map(storage, block-count)
symbols = new-id-map(storage, symbol-count)

────────────────────
+ do define-block
    - name StringId
    - offset U32

?! Panic("Text label for block ${name-string(bundle, function, name)} is defined twice")
    if blocks.get(name) != no-id
blocks = blocks.inserted(arena, name, offset)

────────────────────
+ do define-symbol
    - name StringId
    - offset U32

?! Panic("Text label ${bundle.text(name)} is defined twice")
    if symbols.get(name) != no-id
symbols = symbols.inserted(arena, name, offset)

────────────────────
+ block-offset U32
    - name StringId

blocks.get(name)

────────────────────
+ symbol-offset U32
    - name StringId

symbols.get(name)

────────────────────
+ label-offset U32
    - name StringId

if offset != no-label then offset else symbols.get(name)

.. offset = blocks.get(name)

━━━━━━━━━━━━━━━━━━━━
