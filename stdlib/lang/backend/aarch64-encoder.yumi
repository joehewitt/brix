    . shift = halfword * 16
    . mask = chunk /lshift/ shift
    if (value /and/ (mask /xor/ U64.max)) == 0
        = MoveWideImmediate(true, false, halfword, ((value /zrshift/ shift) /and/ 0xffff) as U32)
. inverted = (value /xor/ U64.max) /and/ bit-mask(bits)
for halfword in 0 .. < halfword-count
    . shift = halfword * 16
    . mask = chunk /lshift/ shift
    if (inverted /and/ (mask /xor/ U64.max)) == 0
        = MoveWideImmediate(true, true, halfword, ((inverted /zrshift/ shift) /and/ 0xffff) as U32)
