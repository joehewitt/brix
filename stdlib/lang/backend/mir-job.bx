(import ./bundle)
(import ./mir)
(import /core/arena)
(import /core/table)
(blank)
(prop _ int-signed I32)
(blank)
(prop _ flag-has-loc I32 (= 1))
(prop _ flag-has-panic-target I32 (= 2))
(prop _ flag-gc-free-zone I32 (= 4))
(prop _ flag-gc-exceptional-safepoint I32 (= 8))
(prop _ flag-gc-safepoint I32 (= 16))
(prop _ flag-gc-safepoint-proven-free I32 (= 32))
(prop _ flag-direct-struct-return I32 (= 64))
(prop _ flag-has-gc-roots I32 (= 128))
(blank)
(prop _ root-register I32)

(type _ MIROperandKind (is I32)
  (variant vreg)
  (variant preg)
  (variant vreg-group)
  (variant label)
  (variant symbol)
  (variant label-address)
  (variant load-address)
  (variant frame-object)
  (variant int)
  (variant cond)
  (variant placeholder)
  (variant null)
)

(type _ MIRTypeKind (is I32)
  (variant named)
  (variant void)
  (variant int)
  (variant float)
  (variant pointer)
  (variant struct)
  (variant array)
)

(type + JobDecoder
  (prop _ function MIRFunction)
  (prop _ words (of CPointer I32))
  (prop _ word-count Size)
  (prop _ cursor Size)
  (prop _ strings (of CPointer U32))
  (prop _ string-count U32)
  (prop _ type-ids IdList)
  (prop _ frame-object-ids IdList)
  (fn-do + This _
    (param function MIRFunction)
  )
  (fn-do + decode _
    (param record FunctionRecord)
    (call (. function reset))
    (= (. function order) (. record order))
    (= (. function label) (. record label))
    (= (. function symbol) (. record symbol))
    (= (. function is-lowered) (. record is-lowered))
    (= words (. record words))
    (= word-count (. record word-count))
    (= strings (. record strings))
    (= string-count (. record string-count))
    (= cursor 1)
    (call read-locs)
    (call read-types)
    (call read-slots)
    (call read-vregs)
    (call read-frame-objects)
    (call read-header)
    (call read-frame)
    (call read-blocks)
    (if (. record is-lowered)
      (= (. function gc-roots) (call read-roots))
      (for (in _ (..< 0 (call next)))
        (let register (call next))
        (call (. function saved-registers append) (call SavedRegister (as register RegisterId) (call next)))
      )
    )
    (throw (call Panic (str "MIR job for function " (. record order) " has " (- word-count cursor) " unread words")) (if (!= cursor word-count)))
  )
  (fn-do _ next I32 @inline
    (throw (call Panic "MIR job is truncated") (if (>= cursor word-count)))
    (let value ([] words cursor))
    (+= cursor 1)
    (return value)
  )
  (fn-do _ next-bit Bool @inline
    (return (!= (call next) 0))
  )
  (fn-do _ next-string StringId
    (let index (call next))
    (if (< index 0)
      (return no-string)
    )
    (throw (call Panic (str "MIR job names string " index " of " string-count)) (if (>= index string-count)))
    (return ([] strings index))
  )
  (fn-do _ next-ids IdList
    (param count U32)
    (let ids (call new-id-list (. function arena) count))
    (for (in index (..< 0 count))
      (= ([] (. ids data) index) (as (call next) U32))
    )
    (return (call IdList (. ids data) count count))
  )
  (fn-do _ read-locs _
    (for (in _ (..< 0 (call next)))
      (let file (call next-string))
      (let is-known (call next-bit))
      (let line (call next))
      (let column (call next))
      (let offset (call next))
      (call (. function locs append) (call MIRLoc file is-known line column offset (call next)))
    )
  )
  (fn-do _ read-types _
    (let count (call next))
    (= type-ids (call new-id-list (. function arena) (as count U32)))
    (for (in _ (..< 0 count))
      (= type-ids (call (. type-ids appended) (. function arena) (call read-type)))
    )
  )
  (fn-do _ read-type MIRTypeId
    (let tag (call next))
    (if (== tag (. MIRTypeKind named))
      (return (as (call next) MIRTypeId))
    )
    (let id MIRTypeId (as (. function types length) MIRTypeId))
    (if (== tag (. MIRTypeKind struct))
      (let format (as (call next) StructFormat))
      (let size (as (call next) U32))
      (let alignment (as (call next) U32))
      (let field-count (call next))
      (let fields (call Span (as (. function struct-fields length) U32) (as field-count U32)))
      (for (in _ (..< 0 field-count))
        (let type ([] type-ids (call next)))
        (call (. function struct-fields append) (call StructField type (as (call next) U32)))
      )
      (call (. function types append) (call MIRStructType size alignment format fields))
      (else-if (== tag (. MIRTypeKind array))
        (let size (as (call next) U32))
        (let alignment (as (call next) U32))
        (let item ([] type-ids (call next)))
        (call (. function types append) (call ArrayType size alignment item (as (call next) U32)))
      )
      (else-if (== tag (. MIRTypeKind void))
        (let size (as (call next) U32))
        (call (. function types append) (call VoidType size (as (call next) U32)))
      )
      (else-if (== tag (. MIRTypeKind int))
        (let size (as (call next) U32))
        (let alignment (as (call next) U32))
        (let bit-size (as (call next) U32))
        (let is-signed (call next-bit))
        (call (. function types append) (call IntType size alignment bit-size is-signed (as (call next) RegClass)))
      )
      (else-if (== tag (. MIRTypeKind float))
        (let size (as (call next) U32))
        (let alignment (as (call next) U32))
        (let bit-size (as (call next) U32))
        (call (. function types append) (call FloatType size alignment bit-size (as (call next) RegClass)))
      )
      (else-if (== tag (. MIRTypeKind pointer))
        (let size (as (call next) U32))
        (let alignment (as (call next) U32))
        (call (. function types append) (call PointerType size alignment (as (call next) RegClass)))
      )
      (else
        (throw (call Panic (str "Unexpected MIR type tag " tag)))
      )
    )
    (return id)
  )
  (fn-do _ read-slots _
    (for (in _ (..< 0 (call next)))
      (let slot MIRSlotId (as (. function slots length) MIRSlotId))
      (let index (call next))
      (let is-stack (call next-bit))
      (let object-count (call next))
      (let objects (call new-id-list (. function arena) (as object-count U32)))
      (for (in position (..< 0 object-count))
        (let type ([] type-ids (call next)))
        (let offset (call next))
        (let can-promote (call next-bit))
        (let gc-root (call next-bit))
        (let gc-descriptor (call next-string))
        (let gc-root-mode (as (call next) GCRootMode))
        (= objects (call (. objects appended) (. function arena) (as (. function frame-objects length) U32)))
        (call (. function frame-objects append)
          (block
            (call MIRFrameObject
              (block
                (arg slot)
                (arg position)
                (arg type)
                (arg offset)
                (arg can-promote)
                (arg gc-root)
                (arg gc-descriptor)
                (arg gc-root-mode)
                (arg (call next-bit))
              )
            )
          )
        )
      )
      (call (. function slots append) (call MIRFrameSlot index is-stack objects))
    )
  )
  (fn-do _ read-vregs _
    (for (in _ (..< 0 (call next)))
      (let id (call next))
      (let reg-class (as (call next) RegClass))
      (let hint (call next))
      (let gc-root (call next-bit))
      (let gc-descriptor (call next-string))
      (call (. function vregs append)
        (block
          (call MIRVirtualRegister
            (block
              (arg (as id U32))
              (arg reg-class)
              (arg (if-expr (< hint 0) no-register (as hint RegisterId)))
              (arg gc-root)
              (arg gc-descriptor)
              (arg (as (call next) GCRootMode))
            )
          )
        )
      )
    )
  )
  (fn-do _ read-frame-objects _
    (let count (call next))
    (= frame-object-ids (call new-id-list (. function arena) (as count U32)))
    (for (in _ (..< 0 count))
      (let slot MIRSlotId (as (call next) MIRSlotId))
      (let index (call next))
      (let objects (. ([] (. function slots) slot) objects))
      (let id FrameObjectId (as (. function frame-objects length) FrameObjectId))
      (if (and (>= index 0) (< index (. objects length)))
        (= id ([] objects index))
        (else
          (call (. function frame-objects append)
            (block
              (call MIRFrameObject slot -1 void-type-id 0 false false no-string .value-root false)
            )
          )
        )
      )
      (= frame-object-ids (call (. frame-object-ids appended) (. function arena) id))
    )
  )
  (fn-do _ next-frame-object FrameObjectId
    (let index (call next))
    (if (< index 0)
      (return no-frame-object)
    )
    (return ([] frame-object-ids index))
  )
  (fn-do _ read-header _
    (= (. function name) (call next-string))
    (= (. function display-name) (call next-string))
    (= (. function compilation-effects) (as (call next) U32))
    (= (. function is-exported) (call next-bit))
    (= (. function uses-table-union-cursor-plan) (call next-bit))
    (let loc (call next))
    (= (. function loc) (if-expr (< loc 0) no-loc (as loc LocId)))
    (= (. function vreg-count) (as (call next) U32))
    (= (. function uses-layout-context) (call next-bit))
    (= (. function closure-root) (call next-frame-object))
    (= (. function capture-closure-root) (call next-frame-object))
  )
  (fn-do _ read-frame _
    (= (. function frame-slots) (call next-ids (as (call next) U32)))
    (if (call next-bit)
      (let is-stack (call next-bit))
      (let slot (call next))
      (let size (call next))
      (let alignment (call next))
      (let length (call next))
      (let count (call next))
      (= (. function overflow)
        (call MIRCallOverflow
          (block
            (arg true)
            (arg is-stack)
            (arg (as slot MIRSlotId))
            (arg size)
            (arg alignment)
            (arg length)
            (arg count)
            (arg (call next))
          )
        )
      )
    )
    (let var-count (call next))
    (let vars (call new-id-list (. function arena) (as var-count U32)))
    (for (in _ (..< 0 var-count))
      (= vars (call (. vars appended) (. function arena) (call next-frame-object)))
    )
    (= (. function vars) vars)
    (for (in _ (..< 0 (call next)))
      (let name (call next-string))
      (call (. function jump-tables append) (call MIRJumpTable name (call next-names)))
    )
  )
  (fn-do _ next-names Span
    (let count (call next))
    (let names (. function names))
    (let start (. names length))
    (for (in _ (..< 0 count))
      (= names (call (. names appended) (. function arena) (call next-string)))
    )
    (= (. function names) names)
    (return (call Span start (as count U32)))
  )
  (fn-do _ next-name-list IdList
    (let count (call next))
    (let names (call new-id-list (. function arena) (as count U32)))
    (for (in _ (..< 0 count))
      (= names (call (. names appended) (. function arena) (call next-string)))
    )
    (return names)
  )
  (fn-do _ read-blocks _
    (let function-block-count (call next))
    (let order (call new-id-list (. function arena) (as function-block-count U32)))
    (for (in block (..< 0 function-block-count))
      (= order (call (. order appended) (. function arena) (as block U32)))
    )
    (= (. function block-order) order)
    (for (in _ (..< 0 (call next)))
      (let name (call next-string))
      (let successors (call next-ids (as (call next) U32)))
      (let predecessors (call next-ids (as (call next) U32)))
      (let instruction-count (call next))
      (let instructions (call new-id-list (. function arena) (as instruction-count U32)))
      (for (in _ (..< 0 instruction-count))
        (= instructions (call (. instructions appended) (. function arena) (call read-instruction)))
      )
      (call (. function blocks append) (call MIRBlock name instructions successors predecessors))
    )
  )
  (fn-do _ read-instruction InstructionId
    (let id InstructionId (as (. function instructions length) InstructionId))
    (let opcode (as (call next) Opcode))
    (let flags (call next))
    (let loc no-loc)
    (if (!= (/and/ flags flag-has-loc) 0)
      (= loc (as (call next) LocId))
    )
    (let operand-count (call next))
    (let operands (call new-id-list (. function arena) (as operand-count U32)))
    (for (in _ (..< 0 operand-count))
      (= operands (call (. operands appended) (. function arena) (call read-operand)))
    )
    (let has-gc-roots (!= (/and/ flags flag-has-gc-roots) 0))
    (let gc-roots Span)
    (if has-gc-roots
      (= gc-roots (call read-roots))
    )
    (let gc-free-zone (!= (/and/ flags flag-gc-free-zone) 0))
    (let gc-exceptional-safepoint (!= (/and/ flags flag-gc-exceptional-safepoint) 0))
    (let gc-safepoint (!= (/and/ flags flag-gc-safepoint) 0))
    (if (== opcode .call)
      (let return-type ([] type-ids (call next)))
      (let copied-count (as (call next) U32))
      (let words (. function words))
      (let copied (call Span (. words length) copied-count))
      (for (in _ (..< 0 copied-count))
        (= words (call (. words appended) (. function arena) (as (call next) U32)))
      )
      (let size-count (call next))
      (let sizes (call Span (. words length) (as size-count U32)))
      (for (in _ (..< 0 size-count))
        (= words (call (. words appended) (. function arena) (as (call next) U32)))
      )
      (= (. function words) words)
      (let panic-target no-operand)
      (if (!= (/and/ flags flag-has-panic-target) 0)
        (= panic-target (call read-operand))
      )
      (call (. function instructions append)
        (block
          (call CallInstruction
            (block
              (arg opcode)
              (arg operands)
              (arg loc)
              (arg no-position)
              (arg gc-free-zone)
              (arg gc-exceptional-safepoint)
              (arg gc-safepoint)
              (arg false)
              (arg has-gc-roots)
              (arg gc-roots)
              (arg return-type)
              (arg copied)
              (arg sizes)
              (arg panic-target)
              (arg (!= (/and/ flags flag-gc-safepoint-proven-free) 0))
              (arg (!= (/and/ flags flag-direct-struct-return) 0))
            )
          )
        )
      )
      (else-if (== opcode .comment)
        (call (. function instructions append)
          (block
            (call CommentInstruction
              (block
                (arg opcode)
                (arg operands)
                (arg loc)
                (arg no-position)
                (arg gc-free-zone)
                (arg gc-exceptional-safepoint)
                (arg gc-safepoint)
                (arg false)
                (arg has-gc-roots)
                (arg gc-roots)
                (arg (call next-string))
              )
            )
          )
        )
      )
      (else-if (== opcode .phi)
        (let reg (call read-operand))
        (let expr-count (call next))
        (let exprs (call new-id-list (. function arena) (as expr-count U32)))
        (for (in _ (..< 0 expr-count))
          (= exprs (call (. exprs appended) (. function arena) (call read-operand)))
        )
        (call (. function instructions append)
          (block
            (call PhiInstruction
              (block
                (arg opcode)
                (arg operands)
                (arg loc)
                (arg no-position)
                (arg gc-free-zone)
                (arg gc-exceptional-safepoint)
                (arg gc-safepoint)
                (arg false)
                (arg has-gc-roots)
                (arg gc-roots)
                (arg reg)
                (arg exprs)
                (arg (call next-name-list))
              )
            )
          )
        )
      )
      (else
        (call (. function instructions append)
          (block
            (call AssemblyInstruction
              (block
                (arg opcode)
                (arg operands)
                (arg loc)
                (arg no-position)
                (arg gc-free-zone)
                (arg gc-exceptional-safepoint)
                (arg gc-safepoint)
                (arg false)
                (arg has-gc-roots)
                (arg gc-roots)
              )
            )
          )
        )
      )
    )
    (return id)
  )
  (fn-do _ read-roots Span
    (let count (call next))
    (let start (. function roots length))
    (for (in _ (..< 0 count))
      (if (== (call next) root-register)
        (call (. function roots append) (call RegisterRoot (as (call next) RegisterId)))
        (else
          (let object (call next-frame-object))
          (let gc-descriptor (call next-string))
          (call (. function roots append) (call StackRoot object gc-descriptor (as (call next) GCRootMode)))
        )
      )
    )
    (return (call Span (as start U32) (as count U32)))
  )
  (fn-do _ read-operand OperandId
    (let tag (call next))
    (if (== tag (. MIROperandKind null))
      (return no-operand)
    )
    (if (== tag (. MIROperandKind vreg))
      (return (call add-operand (call VRegOperand (as (call next) VRegId))))
    )
    (if (== tag (. MIROperandKind preg))
      (return (call add-operand (call PRegOperand (as (call next) RegisterId))))
    )
    (if (== tag (. MIROperandKind vreg-group))
      (let reg-class (as (call next) RegClass))
      (let count (as (call next) U32))
      (let vregs (. function group-vregs))
      (let span (call Span (. vregs length) count))
      (for (in _ (..< 0 count))
        (= vregs (call (. vregs appended) (. function arena) (as (call next) U32)))
      )
      (= (. function group-vregs) vregs)
      (return (call add-operand (call VRegGroupOperand reg-class span)))
    )
    (if (== tag (. MIROperandKind label))
      (let name (call next-string))
      (return (call add-operand (call LabelOperand name (as (call next) Reloc))))
    )
    (if (== tag (. MIROperandKind symbol))
      (let name (call next-string))
      (return (call add-operand (call SymbolOperand name (as (call next) Reloc))))
    )
    (if (== tag (. MIROperandKind label-address))
      (return (call add-operand (call LabelAddressOperand (call read-operand))))
    )
    (if (== tag (. MIROperandKind load-address))
      (let is-pre-index (call next-bit))
      (let base (call read-operand))
      (return (call add-operand (call LoadAddressOperand base (call read-operand) is-pre-index)))
    )
    (if (== tag (. MIROperandKind frame-object))
      (return (call add-operand (call FrameObjectOperand (call next-frame-object))))
    )
    (if (== tag (. MIROperandKind int))
      (let mode (call next))
      (let low U64 (as (call next) U32))
      (let high U64 (as (call next) U32))
      (let bits (/or/ low (/lshift/ high 32)))
      (let is-negative (and (== mode int-signed) (!= (/zrshift/ bits 63) 0)))
      (return (call add-operand (call IntOperand (call MIRInt bits is-negative))))
    )
    (if (== tag (. MIROperandKind cond))
      (return (call add-operand (call CondOperand (as (call next) U32))))
    )
    (if (== tag (. MIROperandKind placeholder))
      (return (call add-operand (call PlaceholderOperand)))
    )
    (throw (call Panic (str "Unexpected MIR operand tag " tag)))
  )
  (fn-do _ add-operand OperandId
    (param operand MIROperand)
    (let id OperandId (as (. function operands length) OperandId))
    (call (. function operands append) operand)
    (return id)
  )
)
