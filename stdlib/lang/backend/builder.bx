    (param src OperandId)
    (param type MIRTypeId)
    (let is-byte false)
    (match? ([] (. function types) type)
      (case .int-type
        (= is-byte (== (. ([] (. function types) type) size) 1))
      )
    )
    (throw (call Panic "Release store requires an 8-bit integer value") (if (not is-byte)))
    (call stlrb src (call unindexed-address dest))
  )
  (fn-do _ unindexed-address OperandId
    (param address OperandId)
    (if (call is-register address)
      (return (call load-address-offset address 0))
    )
    (match? ([] (. function operands) address)
      (case (call .load-address-operand operand)
        (if (not (. operand is-pre-index))
          (if (== (. operand offset) no-operand)
            (return address)
          )
          (match? ([] (. function operands) (. operand offset))
            (case (call .int-operand offset)
              (return-if address (if (== (call int-value (. offset value)) 0)))
            )
          )
        )
      )
    )
    (let pointer (call vreg .gpr64))
    (call add-pointer pointer address)
    (return (call load-address-offset pointer 0))
  )
  (fn-do + store _
    (param dest OperandId)
    (param src OperandId)
    (param type MIRTypeId (= no-mir-type))
    (let target dest)
    (if (call is-vreg dest)
      (= target (call load-address-offset dest 0))
    )
    (let object no-frame-object)
    (let is-symbol false)
    (match? ([] (. function operands) src)
      (case (call .frame-object-operand operand)
        (= object (. operand object))
      )
      (case .symbol-operand
        (= is-symbol true)
      )
    )
    (if (!= object no-frame-object)
      (let object-type (. ([] (. function frame-objects) object) type))
      (let temporary (call vreg (call type-reg-class object-type)))
      (call load temporary src object-type)
      (call store target temporary object-type)
      (return)
    )
    (if is-symbol
      (let address (call symbol-address src))
      (call store target address (if-expr (== type no-mir-type) pointer-type-id type))
      (return)
    )
    (if (== type no-mir-type)
      (call str src target)
      (return)
    )
    (let safe (call safe-load-store-address target type))
    (let size (. ([] (. function types) type) size))
    (if (and (call is-scalar type) (== size 1))
      (call strb src safe)
      (else-if (and (call is-scalar type) (== size 2))
        (call strh src safe)
      )
      (else
        (call str src safe)
      )
    )
  )
  (fn-do + safe-load-store-address OperandId
    (param address OperandId)
    (param type MIRTypeId)
    (let base no-operand)
    (let offset-operand no-operand)
    (match? ([] (. function operands) address)
      (case (call .load-address-operand operand)
        (= base (. operand base))
        (= offset-operand (. operand offset))
      )
    )
    (if (or (== base no-operand) (== offset-operand no-operand) (not (call is-register base)))
      (return address)
    )
    (let has-offset false)
    (let offset I64)
    (match? ([] (. function operands) offset-operand)
      (case (call .int-operand operand)
        (= has-offset true)
        (= offset (call int-value (. operand value)))
      )
    )
    (if (not has-offset)
      (return address)
    )
    (blank)
    (let size I64 (. ([] (. function types) type) size))
    (if (< size 1)
      (= size 1)
    )
    (if (> size 8)
      (= size 8)
    )
    (let max-offset I64 32760)
    (if (== size 1)
      (= max-offset 4095)
      (else-if (== size 2)
        (= max-offset 8190)
      )
      (else-if (== size 4)
        (= max-offset 16380)
      )
    )
    (if (and (>= offset 0) (<= offset max-offset) (== (% offset size) 0))
      (return address)
    )
    (blank)
    (let pointer (call vreg .gpr64))
    (if (>= offset 0)
      (call add-immediate pointer base offset)
      (else
        (call sub-immediate pointer base (- 0 offset))
      )
    )
    (return (call load-address-offset pointer 0))
  )
  (fn-do + add-pointer InstructionId
    (param dest OperandId)
    (param src OperandId)
    (return (call asm .addptr dest src))
  )
  (fn-do + add InstructionId
    (param dest OperandId)
    (param left OperandId)
    (param right OperandId)
    (return (call asm .add dest left right))
  )
  (fn-do + and InstructionId
    (param dest OperandId)
    (param left OperandId)
    (param right OperandId)
    (return (call asm .and dest left right))
  )
  (fn-do + mov InstructionId
    (param dest OperandId)
    (param src OperandId)
    (return (call asm .mov dest src))
  )
  (fn-do + fmov InstructionId
    (param dest OperandId)
    (param src OperandId)
    (return (call asm .fmov dest src))
  )
  (fn-do + scvtf InstructionId
    (param dest OperandId)
    (param src OperandId)
    (return (call asm .scvtf dest src))
  )
  (fn-do + fcvt InstructionId
    (param dest OperandId)
    (param src OperandId)
    (return (call asm .fcvt dest src))
  )
  (fn-do + ldr InstructionId
    (param dest OperandId)
    (param address OperandId)
    (param offset OperandId (= no-operand))
    (return (call asm .ldr dest address offset))
  )
  (fn-do + ldar InstructionId
    (param dest OperandId)
    (param address OperandId)
    (return (call asm .ldar dest address))
  )
  (fn-do + ldarb InstructionId
    (param dest OperandId)
    (param address OperandId)
    (return (call asm .ldarb dest address))
  )
  (fn-do + stlrb InstructionId
    (param src OperandId)
    (param address OperandId)
    (return (call asm .stlrb src address))
  )
  (fn-do + ldrb InstructionId
    (param dest OperandId)
    (param address OperandId)
    (return (call asm .ldrb dest address))
  )
  (fn-do + ldrh InstructionId
    (param dest OperandId)
    (param address OperandId)
    (return (call asm .ldrh dest address))
  )
  (fn-do + str InstructionId
    (param src OperandId)
    (param address OperandId)
    (return (call asm .str src address))
  )
  (fn-do + strb InstructionId
    (param src OperandId)
    (param address OperandId)
    (return (call asm .strb src address))
  )
  (fn-do + strh InstructionId
    (param src OperandId)
    (param address OperandId)
    (return (call asm .strh src address))
  )
  (fn-do + stp InstructionId
    (param first OperandId)
    (param second OperandId)
    (param address OperandId)
    (return (call asm .stp first second address))
  )
  (fn-do + ldp InstructionId
    (param first OperandId)
    (param second OperandId)
    (param address OperandId)
    (param offset OperandId (= no-operand))
    (return (call asm .ldp first second address offset))
  )
  (fn-do + adrp InstructionId
    (param dest OperandId)
    (param target OperandId)
    (return (call asm .adrp dest target))
  )
  (fn-do + b InstructionId
    (param target OperandId)
    (return (call asm .b target))
  )
  (fn-do + bl InstructionId
    (param target OperandId)
    (return (call asm .bl target))
  )
  (fn-do + blr InstructionId
    (param register OperandId)
    (return (call asm .blr register))
  )
  (fn-do + cbnz InstructionId
    (param condition OperandId)
    (param target OperandId)
    (return (call asm .cbnz condition target))
  )
)

(fn-expr _ int-value I64
  (param value MIRInt)
  (before
    (throw (call Panic (str "MIR immediate " (. value bits) " does not fit a signed offset")) (if (and (not (. value is-negative)) (> (. value bits) 0x7fffffffffffffff))))
  )
  (as (. value bits) I64)
)

(fn-do _ add-sub-immediate-chunk I64
  (param remaining I64)
  (param max-chunk I64)
  (let capped (if-expr (< remaining max-chunk) remaining max-chunk))
  (if (<= capped max-add-sub-immediate)
    (return capped)
  )
  (let units (/ capped 4096))
  (if (> units max-add-sub-immediate)
    (= units max-add-sub-immediate)
  )
  (if (> units 0)
    (return (* units 4096))
  )
  (return max-add-sub-immediate)
)
