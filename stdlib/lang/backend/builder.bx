(import ./bundle)
(import ./mir)
(import ./mir-text)
(import /core/arena)
(import /core/table)
(blank)
(prop _ max-add-sub-immediate I64 (= 4095))
(prop _ max-add-sub-immediate-chunk I64 (= 16773120))
(prop _ max-inline-copy U32 (= 128))

(type + MIRBuilder
  (prop + bundle Bundle)
  (prop + function MIRFunction)
  (prop + insertion-block BlockId (= no-id))
  (prop + part-types IdList)
  (prop + part-offsets IdList)
  (prop _ blocks-by-name IdMap)
  (prop _ preg-operands (of CPointer U32))
  (fn-do + This _
    (param bundle Bundle)
    (param function MIRFunction)
  )
  (fn-do + adopt _
    (let order (. function block-order))
    (= insertion-block no-id)
    (= part-types (call IdList))
    (= part-offsets (call IdList))
    (= preg-operands (call (of (. function arena allocate) U32) register-count))
    (= blocks-by-name (call new-id-map (. function arena) (. order length)))
    (for (in position (..< 0 (. order length)))
      (call register-block ([] order position))
    )
  )
  (fn-do + validate _
    (call validate-inferred-safepoint-free)
    (call validate-gc-free)
  )
  (fn-do _ validate-inferred-safepoint-free _
    (if (not (call (. bundle is-inferred-safepoint-free) (. function symbol)))
      (return)
    )
    (let order (call (. function post-order)))
    (for (in position (..< 0 (. order length)))
      (let instructions (. ([] (. function blocks) ([] order position)) instructions))
      (for (in index (..< 0 (. instructions length)))
        (match? ([] (. function instructions) ([] instructions index))
          (case (call .call-instruction call)
            (throw (call Panic (str "Inferred safepoint-free MIR function '" (call (. bundle text) (. function display-name)) "' contains unproven call '" (call callee-text (. call operands)) "'")) (if (not (. call gc-safepoint-proven-free))))
          )
        )
      )
    )
  )
  (fn-do _ callee-text String
    (param operands IdList)
    (if (!= (. operands length) 0)
      (match? ([] (. function operands) ([] operands 0))
        (case (call .symbol-operand callee)
          (return (call (. bundle text) (. callee name)))
        )
      )
    )
    (return "<indirect>")
  )
  (fn-do _ validate-gc-free _
    (if (not (. function is-gc-free))
      (return)
    )
    (let order (. function block-order))
    (for (in position (..< 0 (. order length)))
      (let instructions (. ([] (. function blocks) ([] order position)) instructions))
      (for (in index (..< 0 (. instructions length)))
        (let row ([] (. function instructions) ([] instructions index)))
        (if (not (. row gc-free-zone))
          (continue)
        )
        (throw (call Panic (str "GC-free MIR function '" barrier-owner "' contains a write barrier")) (if (== (. row opcode) .gc-barrier)))
        (lazy barrier-owner (call (. bundle text) (. function display-name)))
        (throw (call Panic (str "GC-free MIR function '" safepoint-owner "' contains a safepoint")) (if (and (. row gc-safepoint) (not (. row gc-exceptional-safepoint)))))
        (lazy safepoint-owner (call (. bundle text) (. function display-name)))
        (throw (call Panic (str "GC-free MIR function '" roots-owner "' contains stack-map roots")) (if (and (. row has-gc-roots) (!= (. row gc-roots count) 0) (not (. row gc-exceptional-safepoint)))))
        (lazy roots-owner (call (. bundle text) (. function display-name)))
      )
    )
  )
  (fn-do + instruction-count U32
    (let count U32)
    (let order (. function block-order))
    (for (in position (..< 0 (. order length)))
      (+= count (. ([] (. function blocks) ([] order position)) instructions length))
    )
    (return count)
  )
  (fn-expr + get-block BlockId
    (param name StringId)
    (call (. blocks-by-name get) name)
  )
  (fn-do + set-insert-block _
    (param block BlockId)
    (= insertion-block block)
  )
  (fn-do + add-block BlockId
    (param name StringId)
    (let block BlockId (as (. function blocks length) BlockId))
    (call (. function blocks append) (call MIRBlock name (call IdList) (call IdList) (call IdList)))
    (call register-block block)
    (= (. function block-order) (call (. function block-order appended) (. function arena) block))
    (return block)
  )
  (fn-do + register-block _
    (param block BlockId)
    (let name (. ([] (. function blocks) block) name))
    (throw (call Panic (str "Block " block-name " is defined twice in " (call (. bundle text) (. function name)))) (if (!= (call (. blocks-by-name get) name) no-id)))
    (lazy block-name (call name-string bundle function name))
    (= blocks-by-name (call (. blocks-by-name inserted) (. function arena) name block))
  )
  (fn-do + prune-unreachable-blocks _
    (let listed (. function block-order))
    (if (== (. listed length) 0)
      (return)
    )
    (let arena (. function arena))
    (let block-count (. function blocks length))
    (let order (call (. function post-order)))
    (let reachable (call (of (. arena allocate) Byte) block-count))
    (for (in position (..< 0 (. order length)))
      (= ([] reachable ([] order position)) 1)
    )
    (let is-listed (call (of (. arena allocate) Byte) block-count))
    (for (in position (..< 0 (. listed length)))
      (= ([] is-listed ([] listed position)) 1)
    )
    (for (in position (..< 0 (. order length)))
      (let block ([] order position))
      (throw (call Panic (str "Reachable block " block-name " is not in " (call (. bundle text) (. function name)))) (if (== ([] is-listed block) 0)))
      (lazy block-name (call name-string bundle function (. ([] (. function blocks) block) name)))
    )
    (blank)
    (let kept U32)
    (for (in position (..< 0 (. listed length)))
      (let block ([] listed position))
      (if (!= ([] reachable block) 0)
        (= ([] (. listed data) kept) block)
        (+= kept 1)
        (else
          (let dropped (. ([] (. function blocks) block) instructions))
          (for (in index (..< 0 (. dropped length)))
            (call (. function drop-uses) ([] dropped index))
          )
        )
      )
    )
    (= (. function block-order) (call IdList (. listed data) kept (. listed capacity)))
    (= blocks-by-name (call new-id-map arena kept))
    (for (in position (..< 0 kept))
      (call register-block ([] listed position))
    )
    (blank)
    (let predecessor-marks (call (of (. arena allocate) U32) block-count))
    (let visit-marks (call (of (. arena allocate) U32) block-count))
    (let visit U32)
    (for (in position (..< 0 kept))
      (let block ([] listed position))
      (let mark (+ position 1))
      (let predecessors (call kept-blocks (. ([] (. function blocks) block) predecessors) reachable))
      (= (. ([] (. function blocks) block) predecessors) predecessors)
      (= (. ([] (. function blocks) block) successors) (call kept-blocks (. ([] (. function blocks) block) successors) reachable))
      (for (in index (..< 0 (. predecessors length)))
        (= ([] predecessor-marks ([] predecessors index)) mark)
      )
      (let instructions (. ([] (. function blocks) block) instructions))
      (for (in index (..< 0 (. instructions length)))
        (match? ([] (. function instructions) ([] instructions index))
          (case (call .phi-instruction phi)
            (let exprs (. phi exprs))
            (let names (. phi blocks))
            (throw (call Panic (str "A phi in " owner " names " (. names length) " blocks for " (. exprs length) " values")) (if (< (. exprs length) (. names length))))
            (lazy owner (call (. bundle text) (. function name)))
            (let count U32)
            (for (in entry (..< 0 (. names length)))
              (let name ([] names entry))
              (let source (call (. blocks-by-name get) name))
              (if (== source no-id)
                (call (. function drop-operand-uses) ([] exprs entry))
                (continue)
              )
              (if (!= ([] predecessor-marks source) mark)
                (+= visit 1)
                (= name
                  (call unique-phi-predecessor
                    (block
                      (arg block)
                      (arg source)
                      (arg predecessor-marks)
                      (arg mark)
                      (arg visit-marks)
                      (arg visit)
                    )
                  )
                )
                (if (== name no-string)
                  (call (. function drop-operand-uses) ([] exprs entry))
                  (continue)
                )
              )
              (= ([] (. exprs data) count) ([] exprs entry))
              (= ([] (. names data) count) name)
              (+= count 1)
            )
            (for (in entry (..< (. names length) (. exprs length)))
              (call (. function drop-operand-uses) ([] exprs entry))
            )
            (= (. phi exprs) (call IdList (. exprs data) count (. exprs capacity)))
            (= (. phi blocks) (call IdList (. names data) count (. names capacity)))
          )
        )
      )
    )
  )
  (fn-do _ kept-blocks IdList
    (param blocks IdList)
    (param reachable (of CPointer Byte))
    (let kept U32)
    (for (in index (..< 0 (. blocks length)))
      (let block ([] blocks index))
      (if (!= ([] reachable block) 0)
        (= ([] (. blocks data) kept) block)
        (+= kept 1)
      )
    )
    (return (call IdList (. blocks data) kept (. blocks capacity)))
  )
  (fn-do _ unique-phi-predecessor StringId
    (param target BlockId)
    (param source BlockId)
    (param predecessor-marks (of CPointer U32))
    (param mark U32)
    (param visit-marks (of CPointer U32))
    (param visit U32)
    (let arena (. function arena))
    (let candidate no-string)
    (let candidates U32)
    (let pending (call new-id-list arena 8))
    (= pending (call (. pending appended) arena source))
    (while (!= (. pending length) 0)
      (let block ([] pending (- (. pending length) 1)))
      (= pending (call IdList (. pending data) (- (. pending length) 1) (. pending capacity)))
      (if (== ([] visit-marks block) visit)
        (continue)
      )
      (= ([] visit-marks block) visit)
      (let successors (. ([] (. function blocks) block) successors))
      (let reaches-target false)
      (for (in index (..< 0 (. successors length)))
        (let successor ([] successors index))
        (if (== successor target)
          (= reaches-target true)
          (else-if (!= ([] visit-marks successor) visit)
            (= pending (call (. pending appended) arena successor))
          )
        )
      )
      (if (and reaches-target (== ([] predecessor-marks block) mark))
        (= candidate (. ([] (. function blocks) block) name))
        (+= candidates 1)
      )
    )
    (if (== candidates 1)
      (return candidate)
    )
    (return no-string)
  )
  (fn-do + add-operand OperandId
    (param operand MIROperand)
    (let id OperandId (as (. function operands length) OperandId))
    (call (. function operands append) operand)
    (return id)
  )
  (fn-do + new-vreg VRegId
    (param reg-class RegClass (= .gpr64))
    (param hint RegisterId (= no-register))
    (param gc-root Bool (= false))
    (param gc-descriptor StringId (= no-string))
    (param gc-root-mode GCRootMode (= .value-root))
    (let row VRegId (as (. function vregs length) VRegId))
    (call (. function vregs append)
      (block
        (call MIRVirtualRegister (. function vreg-count) reg-class hint gc-root gc-descriptor gc-root-mode)
      )
    )
    (+= (. function vreg-count) 1)
    (return row)
  )
  (fn-do + vreg-operand OperandId
    (param vreg VRegId)
    (return (call add-operand (call VRegOperand vreg)))
  )
  (fn-do + vreg OperandId
    (param reg-class RegClass (= .gpr64))
    (return (call vreg-operand (call new-vreg reg-class)))
  )
  (fn-do + narrow-view OperandId
    (param value OperandId)
    ; The low 32 bits of a 64-bit virtual register, as an operand of the same register.
    (match? ([] (. function operands) value)
      (case (call .vreg-operand operand)
        (let row ([] (. function vregs) (. operand vreg)))
        (if (!= (. row reg-class) .gpr64)
          (return value)
        )
        (let view VRegId (as (. function vregs length) VRegId))
        (call (. function vregs append)
          (block
            (call MIRVirtualRegister (. row id) .gpr32 (. row hint) false no-string .value-root)
          )
        )
        (return (call vreg-operand view))
      )
    )
    (return value)
  )
  (fn-do + preg OperandId
    (param register RegisterId)
    (let cached ([] preg-operands register))
    (if (!= cached 0)
      (return (- cached 1))
    )
    (let id (call add-operand (call PRegOperand register)))
    (= ([] preg-operands register) (+ id 1))
    (return id)
  )
  (fn-do + preg-argument OperandId
    (param index U32)
    (param reg-class RegClass)
    (return (call preg (call register-of reg-class index)))
  )
  (fn-do + small-int OperandId
    (param value I64)
    (return (call add-operand (call IntOperand (call MIRInt (as value U64) (< value 0)))))
  )
  (fn-do + label OperandId
    (param name StringId)
    (param reloc Reloc (= .no-reloc))
    (return (call add-operand (call LabelOperand name reloc)))
  )
  (fn-do + symbol OperandId
    (param name StringId)
    (param reloc Reloc (= .no-reloc))
    (return (call add-operand (call SymbolOperand name reloc)))
  )
  (fn-do + block-label OperandId
    (param block BlockId)
    (return (call label (. ([] (. function blocks) block) name)))
  )
  (fn-do + load-address OperandId
    (param base OperandId)
    (param offset OperandId (= no-operand))
    (param is-pre-index Bool (= false))
    (param index-shift U32 (= 0))
    (return (call add-operand (call LoadAddressOperand base offset is-pre-index index-shift)))
  )
  (fn-do + load-address-offset OperandId
    (param base OperandId)
    (param offset I64)
    (param is-pre-index Bool (= false))
    (return (call add-operand (call LoadAddressOperand base (call small-int offset) is-pre-index)))
  )
  (fn-do + frame-object-operand OperandId
    (param object FrameObjectId)
    (return (call add-operand (call FrameObjectOperand object)))
  )
  (fn-do + operand-reg-class RegClass
    (param id OperandId)
    (match? ([] (. function operands) id)
      (case (call .preg-operand operand)
        (return (call register-class (. operand register)))
      )
      (case (call .vreg-operand operand)
        (return (. ([] (. function vregs) (. operand vreg)) reg-class))
      )
      (case (call .vreg-group-operand operand)
        (return (. operand reg-class))
      )
      (case (call .frame-object-operand operand)
        (return (call type-reg-class (. ([] (. function frame-objects) (. operand object)) type)))
      )
      (case .int-operand
        (return .gpr64)
      )
    )
    (throw (call Panic "Operand can't fit in register"))
  )
  (fn-expr + copy-opcode Opcode
    (param dest OperandId)
    (if-expr (or (== class .fpr32) (== class .fpr64)) (. Opcode fmov) (. Opcode mov))
    (where
      (lazy class (call operand-reg-class dest))
    )
  )
  (fn-do + type-reg-class RegClass
    (param type MIRTypeId)
    (match? ([] (. function types) type)
      (case (call .int-type row)
        (return (. row reg-class))
      )
      (case (call .float-type row)
        (return (. row reg-class))
      )
      (case (call .pointer-type row)
        (return (. row reg-class))
      )
      (case .struct-type
        (return .gpr64)
      )
    )
    (throw (call Panic "Type can't be stored in a register"))
  )
  (fn-expr + reg-class-type MIRTypeId
    (param reg-class RegClass)
    (match reg-class
      (case= .gpr64
        i64-type-id
      )
      (case= .gpr32
        i32-type-id
      )
      (case= .fpr64
        f64-type-id
      )
      (default
        f32-type-id
      )
    )
  )
  (fn-do _ is-vreg Bool
    (param id OperandId)
    (match? ([] (. function operands) id)
      (case .vreg-operand
        (return true)
      )
    )
    (return false)
  )
  (fn-do _ is-register Bool
    (param id OperandId)
    (match? ([] (. function operands) id)
      (case .vreg-operand
        (return true)
      )
      (case .preg-operand
        (return true)
      )
    )
    (return false)
  )
  (fn-do _ is-scalar Bool
    (param type MIRTypeId)
    (match? ([] (. function types) type)
      (case .int-type
        (return true)
      )
      (case .float-type
        (return true)
      )
      (case .pointer-type
        (return true)
      )
    )
    (return false)
  )
  (fn-do + frame-slot MIRSlotId
    (param is-stack Bool (= false))
    (let slot MIRSlotId (as (. function slots length) MIRSlotId))
    (call (. function slots append) (call MIRFrameSlot (as (. function frame-slots length) I32) is-stack (call IdList)))
    (= (. function frame-slots) (call (. function frame-slots appended) (. function arena) slot))
    (return slot)
  )
  (fn-do + add-frame-object FrameObjectId
    (param slot MIRSlotId)
    (param type MIRTypeId)
    (param offset I32 (= 0))
    (param can-promote Bool (= true))
    (param gc-root Bool (= false))
    (param gc-descriptor StringId (= no-string))
    (param gc-root-mode GCRootMode (= .value-root))
    (let objects (. ([] (. function slots) slot) objects))
    (let id FrameObjectId (as (. function frame-objects length) FrameObjectId))
    (call (. function frame-objects append)
      (block
        (call MIRFrameObject
          (block
            (arg slot)
            (arg (as (. objects length) I32))
            (arg type)
            (arg offset)
            (arg can-promote)
            (arg gc-root)
            (arg gc-descriptor)
            (arg gc-root-mode)
            (arg false)
          )
        )
      )
    )
    (= (. ([] (. function slots) slot) objects) (call (. objects appended) (. function arena) id))
    (return id)
  )
  (fn-do + overflow-object FrameObjectId
    (param type MIRTypeId)
    ; An argument that arrives on the stack: the next object of the area a caller passes the
    ; arguments in that no register is left for.
    (if (not (. function overflow is-present))
      (let slot MIRSlotId (as (. function slots length) MIRSlotId))
      (call (. function slots append) (call MIRFrameSlot -1 false (call IdList)))
      (= (. function overflow) (call MIRCallOverflow true false slot 0 0 0 0 0))
    )
    (return (call add-frame-object (. function overflow slot) type))
  )
  (fn-do + frame-object-size U32
    (param type MIRTypeId)
    (let size (. ([] (. function types) type) size))
    (match? ([] (. function types) type)
      (case .int-type
        (if (< size 4)
          (return 4)
        )
      )
    )
    (return size)
  )
  (fn-do + frame-object-alignment U32
    (param type MIRTypeId)
    (let alignment (. ([] (. function types) type) alignment))
    (match? ([] (. function types) type)
      (case .int-type
        (if (< alignment 4)
          (return 4)
        )
      )
    )
    (return alignment)
  )
  (fn-do + finalize-stack U32
    (let offset U32 8)
    (for (in position (..< 0 (. function frame-slots length)))
      (let objects (. ([] (. function slots) ([] (. function frame-slots) position)) objects))
      (for (in index (..< 0 (. objects length)))
        (let object ([] objects index))
        (let type (. ([] (. function frame-objects) object) type))
        (let alignment (call frame-object-alignment type))
        (if (!= alignment 0)
          (+= offset (call frame-object-size type))
          (= offset (/and/ (- (+ offset alignment) 1) (/xor/ (- alignment 1) (. U32 max))))
        )
        (= (. ([] (. function frame-objects) object) offset) (- 0 (as offset I32)))
      )
    )
    (return (/and/ (+ offset 15) 0xfffffff0))
  )
  (fn-do + finalize-overflow I32
    (param slot MIRSlotId)
    (param prologue-offset I32)
    ; Places the arguments a call passes on the stack, from `prologue-offset` on, and answers where
    ; they end. Under Apple's ABI each is at the alignment of its own type and takes only its own
    ; size; under AAPCS64 each takes a slot that is a multiple of 8 bytes, at an alignment of at
    ; least 8.
    (let objects (. ([] (. function slots) slot) objects))
    (let offset (as prologue-offset U32))
    (let slot-unit (if-expr (. bundle apple-abi) 1u32 8u32))
    (for (in index (..< 0 (. objects length)))
      (let type ([] (. function types) (. ([] (. function frame-objects) ([] objects index)) type)))
      (let alignment (if-expr (> (. type alignment) slot-unit) (. type alignment) slot-unit))
      (= offset (/and/ (- (+ offset alignment) 1) (/xor/ (- alignment 1) (. U32 max))))
      (= (. ([] (. function frame-objects) ([] objects index)) offset) (as offset I32))
      (+= offset (/and/ (- (+ (. type size) slot-unit) 1) (/xor/ (- slot-unit 1) (. U32 max))))
    )
    (return (as offset I32))
  )
  (fn-do + new-assembly InstructionId
    (param opcode Opcode)
    (param first OperandId (= no-operand))
    (param second OperandId (= no-operand))
    (param third OperandId (= no-operand))
    (param fourth OperandId (= no-operand))
    (let count U32)
    (if (!= first no-operand)
      (= count 1)
      (if (!= second no-operand)
        (= count 2)
        (if (!= third no-operand)
          (= count 3)
          (if (!= fourth no-operand)
            (= count 4)
          )
        )
      )
    )
    (let operands (call new-id-list (. function arena) count))
    (if (> count 0)
      (= ([] (. operands data) 0) first)
    )
    (if (> count 1)
      (= ([] (. operands data) 1) second)
    )
    (if (> count 2)
      (= ([] (. operands data) 2) third)
    )
    (if (> count 3)
      (= ([] (. operands data) 3) fourth)
    )
    (let id InstructionId (as (. function instructions length) InstructionId))
    (call (. function instructions append)
      (block
        (call AssemblyInstruction
          (block
            (arg opcode)
            (arg (call IdList (. operands data) count count))
            (arg no-loc)
            (arg no-position)
            (arg (. function is-gc-free))
            (arg false)
            (arg false)
            (arg false)
            (arg false)
            (arg (call Span))
          )
        )
      )
    )
    (return id)
  )
  (fn-do + asm InstructionId
    (param opcode Opcode)
    (param first OperandId (= no-operand))
    (param second OperandId (= no-operand))
    (param third OperandId (= no-operand))
    (param fourth OperandId (= no-operand))
    (let id (call new-assembly opcode first second third fourth))
    (call append id)
    (return id)
  )
  (fn-do + append _
    (param instruction InstructionId)
    (let instructions (. ([] (. function blocks) insertion-block) instructions))
    (= (. ([] (. function blocks) insertion-block) instructions) (call (. instructions appended) (. function arena) instruction))
  )
  (fn-do + prepend _
    (param instruction InstructionId)
    (let instructions (. ([] (. function blocks) insertion-block) instructions))
    (= (. ([] (. function blocks) insertion-block) instructions)
      (call (. instructions inserted)
        (block
          (arg (. function arena))
          (arg 0)
          (arg instruction)
        )
      )
    )
  )
  (fn-do + take-instructions IdList
    (param block BlockId)
    (let instructions (. ([] (. function blocks) block) instructions))
    (= (. ([] (. function blocks) block) instructions) (call IdList))
    (= insertion-block block)
    (return instructions)
  )
  (fn-do + comment InstructionId
    (param text StringId)
    (let id InstructionId (as (. function instructions length) InstructionId))
    (call (. function instructions append)
      (block
        (call CommentInstruction
          (block
            (arg .comment)
            (arg (call IdList))
            (arg no-loc)
            (arg no-position)
            (arg (. function is-gc-free))
            (arg false)
            (arg false)
            (arg false)
            (arg false)
            (arg (call Span))
            (arg text)
          )
        )
      )
    )
    (call append id)
    (return id)
  )
  (fn-do + phi InstructionId
    (param reg OperandId)
