./bundle
./mir
./mir-text
/core/arena
/core/table

_ max-add-sub-immediate I64 = 4095
_ max-add-sub-immediate-chunk I64 = 16773120
_ max-inline-copy U32 = 128

━━━━━━━━━━━━━━━━━━━━
+ MIRBuilder

+ bundle Bundle
+ function MIRFunction
+ insertion-block BlockId = no-id
+ part-types IdList
+ part-offsets IdList
_ blocks-by-name IdMap
_ preg-operands CPointer'U32

────────────────────
+ This
    - bundle Bundle
    - function MIRFunction

────────────────────
+ do adopt

. order = function.block-order
insertion-block = no-id
part-types = IdList()
part-offsets = IdList()
preg-operands = function.arena.allocate'U32(register-count)
blocks-by-name = new-id-map(function.arena, order.length)
for position in 0 .. < order.length
    register-block(order[position])

────────────────────
+ do validate

validate-inferred-safepoint-free()
validate-gc-free()

────────────────────
_ do validate-inferred-safepoint-free

if !bundle.is-inferred-safepoint-free(function.symbol)
    =
. order = function.post-order()
for position in 0 .. < order.length
    . instructions = function.blocks[order[position]].instructions
    for index in 0 .. < instructions.length
        do match? function.instructions[instructions[index]]
            | .call-instruction(call)
                ?! Panic("Inferred safepoint-free MIR function '${bundle.text(function.display-name)}' contains unproven call '${callee-text(call.operands)}'")
                    if !call.gc-safepoint-proven-free

────────────────────
_ do callee-text String
    - operands IdList

if operands.length != 0
    do match? function.operands[operands[0]]
        | .symbol-operand(callee)
            = bundle.text(callee.name)
= "<indirect>"

────────────────────
_ do validate-gc-free

if !function.is-gc-free
    =
. order = function.block-order
for position in 0 .. < order.length
    . instructions = function.blocks[order[position]].instructions
    for index in 0 .. < instructions.length
        . row = function.instructions[instructions[index]]
        if !row.gc-free-zone
            continue
        ?! Panic("GC-free MIR function '${barrier-owner}' contains a write barrier")
            if row.opcode == .gc-barrier
        .. barrier-owner = bundle.text(function.display-name)
        ?! Panic("GC-free MIR function '${safepoint-owner}' contains a safepoint")
            if row.gc-safepoint && !row.gc-exceptional-safepoint
        .. safepoint-owner = bundle.text(function.display-name)
        ?! Panic("GC-free MIR function '${roots-owner}' contains stack-map roots")
            if row.has-gc-roots && row.gc-roots.count != 0 && !row.gc-exceptional-safepoint
        .. roots-owner = bundle.text(function.display-name)

────────────────────
+ do instruction-count U32

. count U32
. order = function.block-order
for position in 0 .. < order.length
    count += function.blocks[order[position]].instructions.length
= count

────────────────────
+ get-block BlockId
    - name StringId

blocks-by-name.get(name)

────────────────────
+ do set-insert-block
    - block BlockId

insertion-block = block

────────────────────
+ do add-block BlockId
    - name StringId

. block BlockId = function.blocks.length as BlockId
function.blocks.append(MIRBlock(name, IdList(), IdList(), IdList()))
register-block(block)
function.block-order = function.block-order.appended(function.arena, block)
= block

────────────────────
+ do register-block
    - block BlockId

. name = function.blocks[block].name
?! Panic("Block ${block-name} is defined twice in ${bundle.text(function.name)}")
    if blocks-by-name.get(name) != no-id
.. block-name = name-string(bundle, function, name)
blocks-by-name = blocks-by-name.inserted(function.arena, name, block)

────────────────────
+ do prune-unreachable-blocks

. listed = function.block-order
if listed.length == 0
    =
. arena = function.arena
. block-count = function.blocks.length
. order = function.post-order()
. reachable = arena.allocate'Byte(block-count)
for position in 0 .. < order.length
    reachable[order[position]] = 1
. is-listed = arena.allocate'Byte(block-count)
for position in 0 .. < listed.length
    is-listed[listed[position]] = 1
for position in 0 .. < order.length
    . block = order[position]
    ?! Panic("Reachable block ${block-name} is not in ${bundle.text(function.name)}")
        if is-listed[block] == 0
    .. block-name = name-string(bundle, function, function.blocks[block].name)

. kept U32
for position in 0 .. < listed.length
    . block = listed[position]
    if reachable[block] != 0
        listed.data[kept] = block
        kept += 1
    else
        . dropped = function.blocks[block].instructions
        for index in 0 .. < dropped.length
            function.drop-uses(dropped[index])
function.block-order = IdList(listed.data, kept, listed.capacity)
blocks-by-name = new-id-map(arena, kept)
for position in 0 .. < kept
    register-block(listed[position])

. predecessor-marks = arena.allocate'U32(block-count)
. visit-marks = arena.allocate'U32(block-count)
. visit U32
for position in 0 .. < kept
    . block = listed[position]
    . mark = position + 1
    . predecessors = kept-blocks(function.blocks[block].predecessors, reachable)
    function.blocks[block].predecessors = predecessors
    function.blocks[block].successors = kept-blocks(function.blocks[block].successors, reachable)
    for index in 0 .. < predecessors.length
        predecessor-marks[predecessors[index]] = mark
    . instructions = function.blocks[block].instructions
    for index in 0 .. < instructions.length
        do match? function.instructions[instructions[index]]
            | .phi-instruction(phi)
                . exprs = phi.exprs
                . names = phi.blocks
                ?! Panic("A phi in $owner names ${names.length} blocks for ${exprs.length} values")
                    if exprs.length < names.length
                .. owner = bundle.text(function.name)
                . count U32
                for entry in 0 .. < names.length
                    . name = names[entry]
                    . source = blocks-by-name.get(name)
                    if source == no-id
                        function.drop-operand-uses(exprs[entry])
                        continue
                    if predecessor-marks[source] != mark
                        visit += 1
                        name = unique-phi-predecessor
                            - block
                            - source
                            - predecessor-marks
                            - mark
                            - visit-marks
                            - visit
                        if name == no-string
                            function.drop-operand-uses(exprs[entry])
                            continue
                    exprs.data[count] = exprs[entry]
                    names.data[count] = name
                    count += 1
                for entry in names.length .. < exprs.length
                    function.drop-operand-uses(exprs[entry])
                phi.exprs = IdList(exprs.data, count, exprs.capacity)
                phi.blocks = IdList(names.data, count, names.capacity)

────────────────────
_ do kept-blocks IdList
    - blocks IdList
    - reachable CPointer'Byte

. kept U32
for index in 0 .. < blocks.length
    . block = blocks[index]
    if reachable[block] != 0
        blocks.data[kept] = block
        kept += 1
= IdList(blocks.data, kept, blocks.capacity)

────────────────────
_ do unique-phi-predecessor StringId
    - target BlockId
    - source BlockId
    - predecessor-marks CPointer'U32
    - mark U32
    - visit-marks CPointer'U32
    - visit U32

. arena = function.arena
. candidate = no-string
. candidates U32
. pending = new-id-list(arena, 8)
pending = pending.appended(arena, source)
while pending.length != 0
    . block = pending[pending.length - 1]
    pending = IdList(pending.data, pending.length - 1, pending.capacity)
    if visit-marks[block] == visit
        continue
    visit-marks[block] = visit
    . successors = function.blocks[block].successors
    . reaches-target = false
    for index in 0 .. < successors.length
        . successor = successors[index]
        if successor == target
            reaches-target = true
        else if visit-marks[successor] != visit
            pending = pending.appended(arena, successor)
    if reaches-target && predecessor-marks[block] == mark
        candidate = function.blocks[block].name
        candidates += 1
if candidates == 1
    = candidate
= no-string

────────────────────
+ do add-operand OperandId
    - operand MIROperand

. id OperandId = function.operands.length as OperandId
function.operands.append(operand)
= id

────────────────────
+ do new-vreg VRegId
    - reg-class RegClass = .gpr64
    - hint RegisterId = no-register
    - gc-root Bool = false
    - gc-descriptor StringId = no-string
    - gc-root-mode GCRootMode = .value-root

. row VRegId = function.vregs.length as VRegId
function.vregs.append
    MIRVirtualRegister(function.vreg-count, reg-class, hint, gc-root, gc-descriptor, gc-root-mode)
function.vreg-count += 1
= row

────────────────────
+ do vreg-operand OperandId
    - vreg VRegId

= add-operand(VRegOperand(vreg))

────────────────────
+ do vreg OperandId
    - reg-class RegClass = .gpr64

= vreg-operand(new-vreg(reg-class))

────────────────────
+ do narrow-view OperandId
    - value OperandId

` The low 32 bits of a 64-bit virtual register, as an operand of the same register.
do match? function.operands[value]
    | .vreg-operand(operand)
        . row = function.vregs[operand.vreg]
        if row.reg-class != .gpr64
            = value
        . view VRegId = function.vregs.length as VRegId
        function.vregs.append
            MIRVirtualRegister(row.id, .gpr32, row.hint, false, no-string, .value-root)
        = vreg-operand(view)
= value

────────────────────
+ do preg OperandId
    - register RegisterId

. cached = preg-operands[register]
if cached != 0
    = cached - 1
. id = add-operand(PRegOperand(register))
preg-operands[register] = id + 1
= id

────────────────────
+ do preg-argument OperandId
    - index U32
    - reg-class RegClass

= preg(register-of(reg-class, index))

────────────────────
+ do small-int OperandId
    - value I64

= add-operand(IntOperand(MIRInt(value as U64, value < 0)))

────────────────────
+ do label OperandId
    - name StringId
    - reloc Reloc = .no-reloc

= add-operand(LabelOperand(name, reloc))

────────────────────
+ do symbol OperandId
    - name StringId
    - reloc Reloc = .no-reloc

= add-operand(SymbolOperand(name, reloc))

────────────────────
+ do block-label OperandId
    - block BlockId

= label(function.blocks[block].name)

────────────────────
+ do load-address OperandId
    - base OperandId
    - offset OperandId = no-operand
    - is-pre-index Bool = false
    - index-shift U32 = 0

= add-operand(LoadAddressOperand(base, offset, is-pre-index, index-shift))

────────────────────
+ do load-address-offset OperandId
    - base OperandId
    - offset I64
    - is-pre-index Bool = false

= add-operand(LoadAddressOperand(base, small-int(offset), is-pre-index))

────────────────────
+ do frame-object-operand OperandId
    - object FrameObjectId

= add-operand(FrameObjectOperand(object))

────────────────────
+ do operand-reg-class RegClass
    - id OperandId

do match? function.operands[id]
    | .preg-operand(operand)
        = register-class(operand.register)
    | .vreg-operand(operand)
        = function.vregs[operand.vreg].reg-class
    | .vreg-group-operand(operand)
        = operand.reg-class
    | .frame-object-operand(operand)
        = type-reg-class(function.frame-objects[operand.object].type)
    | .int-operand
        = .gpr64
?! Panic("Operand can't fit in register")

────────────────────
+ copy-opcode Opcode
    - dest OperandId

if class == .fpr32 || class == .fpr64 then Opcode.fmov else Opcode.mov

.. class = operand-reg-class(dest)

────────────────────
+ do type-reg-class RegClass
    - type MIRTypeId

do match? function.types[type]
    | .int-type(row)
        = row.reg-class
    | .float-type(row)
        = row.reg-class
    | .pointer-type(row)
        = row.reg-class
    | .struct-type
        = .gpr64
?! Panic("Type can't be stored in a register")

────────────────────
+ reg-class-type MIRTypeId
    - reg-class RegClass

match reg-class
    |= .gpr64
        i64-type-id
    |= .gpr32
        i32-type-id
    |= .fpr64
        f64-type-id
    ??
        f32-type-id

────────────────────
_ do is-vreg Bool
    - id OperandId

do match? function.operands[id]
    | .vreg-operand
        = true
= false

────────────────────
_ do is-register Bool
    - id OperandId

do match? function.operands[id]
    | .vreg-operand
        = true
    | .preg-operand
        = true
= false

────────────────────
_ do is-scalar Bool
    - type MIRTypeId

do match? function.types[type]
    | .int-type
        = true
    | .float-type
        = true
    | .pointer-type
        = true
= false

────────────────────
+ do frame-slot MIRSlotId
    - is-stack Bool = false

. slot MIRSlotId = function.slots.length as MIRSlotId
function.slots.append(MIRFrameSlot(function.frame-slots.length as I32, is-stack, IdList()))
function.frame-slots = function.frame-slots.appended(function.arena, slot)
= slot

────────────────────
+ do add-frame-object FrameObjectId
    - slot MIRSlotId
    - type MIRTypeId
    - offset I32 = 0
    - can-promote Bool = true
    - gc-root Bool = false
    - gc-descriptor StringId = no-string
    - gc-root-mode GCRootMode = .value-root

. objects = function.slots[slot].objects
. id FrameObjectId = function.frame-objects.length as FrameObjectId
function.frame-objects.append
    MIRFrameObject
        - slot
        - objects.length as I32
        - type
        - offset
        - can-promote
        - gc-root
        - gc-descriptor
        - gc-root-mode
        - false
function.slots[slot].objects = objects.appended(function.arena, id)
= id

────────────────────
+ do overflow-object FrameObjectId
    - type MIRTypeId

` An argument that arrives on the stack: the next object of the area a caller passes the
` arguments in that no register is left for.
if !function.overflow.is-present
    . slot MIRSlotId = function.slots.length as MIRSlotId
    function.slots.append(MIRFrameSlot(-1, false, IdList()))
    function.overflow = MIRCallOverflow(true, false, slot, 0, 0, 0, 0, 0)
= add-frame-object(function.overflow.slot, type)

────────────────────
+ do frame-object-size U32
    - type MIRTypeId

. size = function.types[type].size
do match? function.types[type]
    | .int-type
        if size < 4
            = 4
= size

────────────────────
+ do frame-object-alignment U32
    - type MIRTypeId

. alignment = function.types[type].alignment
do match? function.types[type]
    | .int-type
        if alignment < 4
            = 4
= alignment

────────────────────
+ do finalize-stack U32

. offset U32 = 8
for position in 0 .. < function.frame-slots.length
    . objects = function.slots[function.frame-slots[position]].objects
    for index in 0 .. < objects.length
        . object = objects[index]
        . type = function.frame-objects[object].type
        . alignment = frame-object-alignment(type)
        if alignment != 0
            offset += frame-object-size(type)
            offset = (offset + alignment - 1) /and/ ((alignment - 1) /xor/ U32.max)
        function.frame-objects[object].offset = 0 - (offset as I32)
= (offset + 15) /and/ 0xfffffff0

────────────────────
+ do finalize-overflow I32
    - slot MIRSlotId
    - prologue-offset I32

` Places the arguments a call passes on the stack, from `prologue-offset` on, and answers where
` they end. Under Apple's ABI each is at the alignment of its own type and takes only its own
` size; under AAPCS64 each takes a slot that is a multiple of 8 bytes, at an alignment of at
` least 8.
. objects = function.slots[slot].objects
. offset = prologue-offset as U32
. slot-unit = if bundle.apple-abi then 1u32 else 8u32
for index in 0 .. < objects.length
    . type = function.types[function.frame-objects[objects[index]].type]
    . alignment = if type.alignment > slot-unit then type.alignment else slot-unit
    offset = (offset + alignment - 1) /and/ ((alignment - 1) /xor/ U32.max)
    function.frame-objects[objects[index]].offset = offset as I32
    offset += (type.size + slot-unit - 1) /and/ ((slot-unit - 1) /xor/ U32.max)
= offset as I32

────────────────────
+ do new-assembly InstructionId
    - opcode Opcode
    - first OperandId = no-operand
    - second OperandId = no-operand
    - third OperandId = no-operand
    - fourth OperandId = no-operand

. count U32
if first != no-operand
    count = 1
    if second != no-operand
        count = 2
        if third != no-operand
            count = 3
            if fourth != no-operand
                count = 4
. operands = new-id-list(function.arena, count)
if count > 0
    operands.data[0] = first
if count > 1
    operands.data[1] = second
if count > 2
    operands.data[2] = third
if count > 3
    operands.data[3] = fourth
. id InstructionId = function.instructions.length as InstructionId
function.instructions.append
    AssemblyInstruction
        - opcode
        - IdList(operands.data, count, count)
        - no-loc
        - no-position
        - function.is-gc-free
        - false
        - false
        - false
        - false
        - Span()
= id

────────────────────
+ do asm InstructionId
    - opcode Opcode
    - first OperandId = no-operand
    - second OperandId = no-operand
    - third OperandId = no-operand
    - fourth OperandId = no-operand

. id = new-assembly(opcode, first, second, third, fourth)
append(id)
= id

────────────────────
+ do append
    - instruction InstructionId

. instructions = function.blocks[insertion-block].instructions
function.blocks[insertion-block].instructions = instructions.appended(function.arena, instruction)

────────────────────
+ do prepend
    - instruction InstructionId

. instructions = function.blocks[insertion-block].instructions
function.blocks[insertion-block].instructions = instructions.inserted
    - function.arena
    - 0
    - instruction

────────────────────
+ do take-instructions IdList
    - block BlockId

. instructions = function.blocks[block].instructions
function.blocks[block].instructions = IdList()
insertion-block = block
= instructions

────────────────────
+ do comment InstructionId
    - text StringId

. id InstructionId = function.instructions.length as InstructionId
function.instructions.append
    CommentInstruction
        - .comment
        - IdList()
        - no-loc
        - no-position
        - function.is-gc-free
        - false
        - false
        - false
        - false
        - Span()
        - text
append(id)
= id

────────────────────
+ do phi InstructionId
    - reg OperandId

. id InstructionId = function.instructions.length as InstructionId
function.instructions.append
    PhiInstruction
        - .phi
        - IdList()
        - no-loc
        - no-position
        - function.is-gc-free
        - false
        - false
        - false
        - false
        - Span()
        - reg
        - IdList()
        - IdList()
prepend(id)
= id

────────────────────
+ do phi-of InstructionId
    - reg OperandId
    - exprs IdList
    - blocks IdList

` A phi with its inputs: an operand for each predecessor block, named in the same order.
. id InstructionId = function.instructions.length as InstructionId
function.instructions.append
    PhiInstruction
        - .phi
        - IdList()
        - no-loc
        - no-position
        - function.is-gc-free
        - false
        - false
        - false
        - false
        - Span()
        - reg
        - exprs
        - blocks
prepend(id)
= id

────────────────────
+ do link
    - source BlockId
    - target BlockId

` Records that control can pass from one block to another.
. arena = function.arena
. successors = function.blocks[source].successors
function.blocks[source].successors = successors.appended(arena, target)
. predecessors = function.blocks[target].predecessors
function.blocks[target].predecessors = predecessors.appended(arena, source)

────────────────────
+ do runtime-call InstructionId
    - name StringId
    - loc LocId
    - first OperandId = no-operand
    - second OperandId = no-operand
    - third OperandId = no-operand
    - fourth OperandId = no-operand

. arena = function.arena
. callee = symbol(name)
. operands = new-id-list(arena, 5)
operands = operands.appended(arena, callee)
if first != no-operand
    operands = operands.appended(arena, vreg-mov(memory-pointer(first), .gpr64))
if second != no-operand
    operands = operands.appended(arena, vreg-mov(memory-pointer(second), .gpr64))
if third != no-operand
    operands = operands.appended(arena, vreg-mov(memory-pointer(third), .gpr64))
if fourth != no-operand
    operands = operands.appended(arena, vreg-mov(memory-pointer(fourth), .gpr64))
= append-call(void-type-id, callee, loc, operands, no-operand, IdList())

────────────────────
+ do call InstructionId
    - return-type MIRTypeId
    - callee OperandId
    - returned OperandId
    - loc LocId
    - arguments IdList
    - argument-types IdList
    - panic-target OperandId = no-operand
    - packed IdList = IdList()

` A call. A scalar argument is moved into a register of its type's class, a symbol is passed
` by its address, and an argument of no size is not passed. A struct too large for registers
` is copied to the frame and passed by the copy's address, and any other struct is loaded
` into the registers it travels in, unless `packed` already gives those registers for it.
` `returned` is the register the result arrives in, or no operand for a call that returns
` nothing. `panic-target` is the block the call leaves to when its callee returns a panic.
` Where a scalar narrower than 4 bytes is passed, the call records the size of each argument,
` which one passed on the stack takes there.
. arena = function.arena
. operands = new-id-list(arena, arguments.length + 2)
. copied = new-id-list(arena, 2)
. sizes = new-id-list(arena, arguments.length)
. narrow = false
operands = operands.appended(arena, callee)
if returned != no-operand
    operands = operands.appended(arena, returned)
for index in 0 .. < arguments.length
    . type = argument-types[index]
    . size = function.types[type].size
    if size == 0
        continue
    if is-scalar(type)
        . value = vreg-mov(memory-pointer(arguments[index]), type-reg-class(type))
        operands = operands.appended(arena, value)
        sizes = sizes.appended(arena, if size < 4 then size else 8)
        narrow = narrow || size < 4
        continue
    sizes = sizes.appended(arena, 8)
    if index < packed.length && packed[index] != no-operand
        operands = operands.appended(arena, packed[index])
        continue
    if !is-large-struct(type)
        operands = operands.appended(arena, load-parts(arguments[index], type))
        continue
    . object = add-frame-object(frame-slot(), type)
    copy-memory(frame-object-operand(object), arguments[index], size)
    . pointer = vreg(.gpr64)
    add-pointer(pointer, frame-object-operand(object))
    copied = copied.appended(arena, operands.length)
    operands = operands.appended(arena, pointer)
= append-call
    - return-type
    - callee
    - loc
    - operands
    - panic-target
    - copied
    - if narrow then sizes else IdList()

────────────────────
_ do is-large-struct Bool
    - type MIRTypeId

do match? function.types[type]
    | .struct-type(row)
        = row.format == .large-format
= false

────────────────────
+ do struct-parts U32
    - type MIRTypeId

` Lists what a struct small enough for registers travels as, in `part-types` and
` `part-offsets`: each float of a struct made only of floats, or else its one or two words.
part-types = IdList(part-types.data, 0, part-types.capacity)
part-offsets = IdList(part-offsets.data, 0, part-offsets.capacity)
. is-floats = false
do match? function.types[type]
    | .struct-type(row)
        is-floats = row.format == .hfa-format
if is-floats
    add-float-parts(type, 0)
    = part-types.length
add-part(u64-type-id, 0)
if function.types[type].size > 8
    add-part(u64-type-id, 8)
= part-types.length

────────────────────
_ do add-float-parts
    - type MIRTypeId
    - offset U32

. fields Span
. is-struct = false
do match? function.types[type]
    | .struct-type(row)
        is-struct = true
        fields = row.fields
if !is-struct
    add-part(type, offset)
    =
for index in fields.start .. < fields.end
    . field = function.struct-fields[index]
    add-float-parts(field.type, offset + field.offset)

────────────────────
_ do add-part
    - type MIRTypeId
    - offset U32

part-types = part-types.appended(function.arena, type)
part-offsets = part-offsets.appended(function.arena, offset)

────────────────────
_ do load-parts OperandId
    - value OperandId
    - type MIRTypeId

` Loads a struct small enough for registers into the registers it travels in: one, or a
` group the call takes together.
. source = memory-pointer(value)
. count = struct-parts(type)
. reg-class = type-reg-class(part-types[0])
. members = new-id-list(function.arena, count)
for index in 0 .. < count
    . member = new-vreg(reg-class)
    load-part(vreg-operand(member), source, type, index)
    members = members.appended(function.arena, member)
= travel(members, reg-class)

────────────────────
+ do load-part
    - dest OperandId
    - source OperandId
    - type MIRTypeId
    - index U32

. size = function.types[type].size
. offset = part-offsets[index]
. part = part-types[index]
. span = size - offset
if part != u64-type-id || span >= 8
    load(dest, load-address-offset(source, offset), part)
    =
if size >= 8
    . whole = vreg(.gpr64)
    load(whole, load-address-offset(source, size - 8), u64-type-id)
    asm(.lsr, dest, whole, small-int((8 - span) * 8))
    =
. chunk U32 = if span >= 4 then 4 else if span >= 2 then 2 else 1
if chunk == span
    load-narrow(dest, source, offset, chunk)
    =
. low = vreg(.gpr64)
load-narrow(low, source, offset, chunk)
. high = vreg(.gpr64)
load-narrow(high, source, offset + span - chunk, chunk)
. shifted = vreg(.gpr64)
asm(.lsl, shifted, high, small-int((span - chunk) * 8))
asm(.orr, dest, low, shifted)

────────────────────
_ do load-narrow
    - dest OperandId
    - source OperandId
    - offset U32
    - width U32

. narrow = vreg(.gpr32)
if width == 4
    load(narrow, load-address-offset(source, offset), u32-type-id)
    asm(.uxtw, dest, narrow)
else if width == 2
    load(narrow, load-address-offset(source, offset), u16-type-id)
    asm(.uxth, dest, narrow)
else
    load(narrow, load-address-offset(source, offset), u8-type-id)
    asm(.uxtb, dest, narrow)

────────────────────
+ do travel OperandId
    - members IdList
    - reg-class RegClass

` The registers a struct small enough for registers travels in to a call, given as the
` virtual registers of its parts: one, or a group the call takes together.
if members.length == 1
    = vreg-operand(members[0])
= group(members, reg-class)

────────────────────
+ do group OperandId
    - members IdList
    - reg-class RegClass

` The virtual registers of a struct's parts as one operand, which a call takes together as an
` argument or defines together as its result.
. vregs = function.group-vregs
. start U32 = vregs.length
for index in 0 .. < members.length
    vregs = vregs.appended(function.arena, members[index])
function.group-vregs = vregs
= add-operand(VRegGroupOperand(reg-class, Span(start, members.length)))

────────────────────
+ do copy-memory
    - dest OperandId
    - src OperandId
    - size U32

` Copies a struct between two places in memory, a pair of words at a time. One too large to
` copy inline is copied by the C library.
. target = memory-pointer(dest)
. source = memory-pointer(src)
if size > max-inline-copy
    ?! Panic("The bundle names no function that copies memory")
        if bundle.memory-copy-symbol == no-string
    call-memory(bundle.memory-copy-symbol, target, source, pointer-type-id, size)
    =
. offset U32
while offset + 16 <= size
    . low = vreg(.gpr64)
    . high = vreg(.gpr64)
    ldp(low, high, load-address-offset(source, offset))
    stp(low, high, load-address-offset(target, offset))
    offset += 16
while offset + 8 <= size
    copy-chunk(target, source, offset, u64-type-id, .gpr64)
    offset += 8
if offset + 4 <= size
    copy-chunk(target, source, offset, u32-type-id, .gpr32)
    offset += 4
if offset + 2 <= size
    copy-chunk(target, source, offset, u16-type-id, .gpr32)
    offset += 2
if offset < size
    copy-chunk(target, source, offset, u8-type-id, .gpr32)

────────────────────
_ do call-memory
    - callee StringId
    - target OperandId
    - value OperandId
    - value-type MIRTypeId
    - size U32

. arena = function.arena
. given = new-id-list(arena, 3)
. types = new-id-list(arena, 3)
given = given.appended(arena, target)
types = types.appended(arena, pointer-type-id)
given = given.appended(arena, value)
types = types.appended(arena, value-type)
given = given.appended(arena, small-int(size))
types = types.appended(arena, u64-type-id)
call(void-type-id, symbol(callee), no-operand, no-loc, given, types)

────────────────────
_ do copy-chunk
    - target OperandId
    - source OperandId
    - offset U32
    - type MIRTypeId
    - reg-class RegClass

. chunk = vreg(reg-class)
load(chunk, load-address-offset(source, offset), type)
store(load-address-offset(target, offset), chunk, type)

────────────────────
+ do zero-memory
    - dest OperandId
    - size U32

` Clears a struct in memory, a pair of words at a time. One too large to clear inline is cleared
` by the C library.
. target = memory-pointer(dest)
if size > max-inline-copy
    ?! Panic("The bundle names no function that clears memory")
        if bundle.memory-zero-symbol == no-string
    call-memory(bundle.memory-zero-symbol, target, small-int(0), i32-type-id, size)
    =
. wide = preg(zero-register)
. narrow = preg(zero-register-32)
. offset U32
while offset + 16 <= size
    stp(wide, wide, load-address-offset(target, offset))
    offset += 16
while offset + 8 <= size
    store(load-address-offset(target, offset), wide, u64-type-id)
    offset += 8
if offset + 4 <= size
    store(load-address-offset(target, offset), narrow, u32-type-id)
    offset += 4
if offset + 2 <= size
    store(load-address-offset(target, offset), narrow, u16-type-id)
    offset += 2
if offset < size
    store(load-address-offset(target, offset), narrow, u8-type-id)

────────────────────
+ do gc-barrier InstructionId
    - address OperandId
    - value OperandId
    - loc LocId
    - size OperandId = no-operand
    - descriptor OperandId = no-operand

` The write barrier of a store of a managed pointer: the place stored to, and the pointer.
` The barrier of a copy of a struct is given the struct, its size and its descriptor too.
. id = asm(.gc-barrier, address, value, size, descriptor)
function.instructions[id].loc = if bundle.stack-trace-metadata then loc else no-loc
= id

────────────────────
+ do gc-alloc InstructionId
    - result OperandId
    - site OperandId
    - loc LocId

. id = asm(.gc-alloc, result, site)
function.instructions[id].loc = if bundle.stack-trace-metadata then loc else no-loc
= id

────────────────────
+ do literal-address OperandId
    - index U32
    - gc-root Bool

` The address of the function's literal of this index, in a new register. The label is local
` to the function; the merge after the round names the literal and patches the relocations.
. name = function.add-local-name(.literal-name, no-string, no-string, index)
. result = vreg-operand(new-vreg(.gpr64, no-register, gc-root))
adrp(result, label(name, .page-reloc))
add(result, result, label(name, .pageoff-reloc))
= result

────────────────────
+ do add-loc LocId
    - loc MIRLoc

. id LocId = function.locs.length as LocId
function.locs.append(loc)
= id

────────────────────
_ do append-call InstructionId
    - return-type MIRTypeId
    - callee OperandId
    - loc LocId
    - operands IdList
    - panic-target OperandId
    - copied IdList
    - sizes IdList = IdList()

. words = function.words
. copied-span = Span(words.length, copied.length)
for index in 0 .. < copied.length
    words = words.appended(function.arena, copied[index])
. sizes-span = Span(words.length, sizes.length)
for index in 0 .. < sizes.length
    words = words.appended(function.arena, sizes[index])
function.words = words
. is-proven-free = false
do match? function.operands[callee]
    | .symbol-operand(operand)
        is-proven-free = bundle.is-safepoint-free(operand.name)
. is-safepoint = bundle.gc-enabled && !is-proven-free && allows-safepoint
    .. allows-safepoint = (function.compilation-effects /and/ no-safepoint-effect) == 0
. id InstructionId = function.instructions.length as InstructionId
function.instructions.append
    CallInstruction
        - .call
        - operands
        - if bundle.stack-trace-metadata then loc else no-loc
        - no-position
        - function.is-gc-free
        - false
        - is-safepoint
        - false
        - false
        - Span()
        - return-type
        - copied-span
        - sizes-span
        - panic-target
        - bundle.gc-enabled && is-proven-free
        - false
append(id)
= id

────────────────────
+ do symbol-address OperandId
    - symbol OperandId

. name = no-string
do match? function.operands[symbol]
    | .symbol-operand(operand)
        name = operand.name
if name == no-string
    = symbol
. result = vreg(.gpr64)
adrp(result, label(name, .page-reloc))
add(result, result, label(name, .pageoff-reloc))
= result

────────────────────
+ do memory-pointer OperandId
    - operand OperandId

. is-memory = false
do match? function.operands[operand]
    | .frame-object-operand
        is-memory = true
    | .load-address-operand
        is-memory = true
if !is-memory
    = operand
. pointer = vreg(.gpr64)
add-pointer(pointer, operand)
= pointer

────────────────────
+ do vreg-mov OperandId
    - value OperandId
    - reg-class RegClass

. is-symbol = false
do match? function.operands[value]
    | .vreg-operand
        = value
    | .symbol-operand
        is-symbol = true
if is-symbol
    = symbol-address(value)
. register = vreg(reg-class)
if reg-class == .fpr32 || reg-class == .fpr64
    fmov(register, value)
else
    mov(register, value)
= register

────────────────────
+ do move InstructionId
    - dest OperandId
    - src OperandId

. dest-class = operand-reg-class(dest)
. src-class = operand-reg-class(src)
if dest-class == .fpr32 || dest-class == .fpr64
    if src-class == .gpr32 || src-class == .gpr64
        = scvtf(dest, src)
    if src-class == dest-class
        = fmov(dest, src)
    = fcvt(dest, src)
if src-class == dest-class
    = mov(dest, src)
?! Panic("Incompatible registers")

────────────────────
+ do add-immediate
    - dest OperandId
    - base OperandId
    - value I64
    - max-chunk I64 = max-add-sub-immediate-chunk

add-sub-immediate(.add, dest, base, value, max-chunk)

────────────────────
+ do sub-immediate
    - dest OperandId
    - base OperandId
    - value I64
    - max-chunk I64 = max-add-sub-immediate-chunk

add-sub-immediate(.sub, dest, base, value, max-chunk)

────────────────────
_ do add-sub-immediate
    - opcode Opcode
    - dest OperandId
    - base OperandId
    - value I64
    - max-chunk I64

?! Panic("Invalid AArch64 add/sub immediate")
    if value < 0 || max-chunk < 1 || max-chunk > max-add-sub-immediate-chunk
if value == 0
    move(dest, base)
    =
. remaining = value
. current = base
while remaining > 0
    . chunk = add-sub-immediate-chunk(remaining, max-chunk)
    asm(opcode, dest, current, small-int(chunk))
    current = dest
    remaining -= chunk

────────────────────
+ do load
    - dest OperandId
    - src OperandId
    - type MIRTypeId = no-mir-type

. loaded = type
if loaded == no-mir-type
    loaded = reg-class-type(operand-reg-class(dest))
. address = src
if is-register(src)
    address = load-address-offset(src, 0)
address = safe-load-store-address(address, loaded)
. size = function.types[loaded].size
do match function.types[loaded]
    | .struct-type
        ldr(dest, address)
    | .array-type
        ?! Panic("Array loads are not implemented")
    | .void-type
        ?! Panic("Type can not be loaded")
    ??
        if size == 1
            ldrb(dest, address)
        else if size == 2
            ldrh(dest, address)
        else
            ldr(dest, address)

────────────────────
+ do load-acquire
    - dest OperandId
    - src OperandId
    - type MIRTypeId = no-mir-type

. loaded = type
if loaded == no-mir-type
    loaded = reg-class-type(operand-reg-class(dest))
. address = src
if is-register(src)
    address = load-address-offset(src, 0)
address = safe-load-store-address(address, loaded)
. size = function.types[loaded].size
. is-integer = false
do match? function.types[loaded]
    | .int-type
        is-integer = true
    | .pointer-type
        is-integer = true
if is-integer && size == 1
    ldarb(dest, unindexed-address(address))
    =
?! Panic("Acquire load requires an 8-bit, 32-bit or 64-bit integer value")
    if !is-integer || (size != 4 && size != 8)
ldar(dest, address)

────────────────────
+ do store-release
    - dest OperandId
    - src OperandId
    - type MIRTypeId

. is-byte = false
do match? function.types[type]
    | .int-type
        is-byte = function.types[type].size == 1
?! Panic("Release store requires an 8-bit integer value")
    if !is-byte
stlrb(src, unindexed-address(dest))

────────────────────
_ do unindexed-address OperandId
    - address OperandId

if is-register(address)
    = load-address-offset(address, 0)
do match? function.operands[address]
    | .load-address-operand(operand)
        if !operand.is-pre-index
            if operand.offset == no-operand
                = address
            do match? function.operands[operand.offset]
                | .int-operand(offset)
                    =? address if int-value(offset.value) == 0
. pointer = vreg(.gpr64)
add-pointer(pointer, address)
= load-address-offset(pointer, 0)

────────────────────
+ do store
    - dest OperandId
    - src OperandId
    - type MIRTypeId = no-mir-type

. target = dest
if is-vreg(dest)
    target = load-address-offset(dest, 0)
. object = no-frame-object
. is-symbol = false
do match? function.operands[src]
    | .frame-object-operand(operand)
        object = operand.object
    | .symbol-operand
        is-symbol = true
if object != no-frame-object
    . object-type = function.frame-objects[object].type
    . temporary = vreg(type-reg-class(object-type))
    load(temporary, src, object-type)
    store(target, temporary, object-type)
    =
if is-symbol
    . address = symbol-address(src)
    store(target, address, if type == no-mir-type then pointer-type-id else type)
    =
if type == no-mir-type
    str(src, target)
    =
. safe = safe-load-store-address(target, type)
. size = function.types[type].size
if is-scalar(type) && size == 1
    strb(src, safe)
else if is-scalar(type) && size == 2
    strh(src, safe)
else
    str(src, safe)

────────────────────
+ do safe-load-store-address OperandId
    - address OperandId
    - type MIRTypeId

. base = no-operand
. offset-operand = no-operand
do match? function.operands[address]
    | .load-address-operand(operand)
        base = operand.base
        offset-operand = operand.offset
if base == no-operand || offset-operand == no-operand || !is-register(base)
    = address
. has-offset = false
. offset I64
do match? function.operands[offset-operand]
    | .int-operand(operand)
        has-offset = true
        offset = int-value(operand.value)
if !has-offset
    = address

. size I64 = function.types[type].size
if size < 1
    size = 1
if size > 8
    size = 8
. max-offset I64 = 32760
if size == 1
    max-offset = 4095
else if size == 2
    max-offset = 8190
else if size == 4
    max-offset = 16380
if offset >= 0 && offset <= max-offset && offset % size == 0
    = address

. pointer = vreg(.gpr64)
if offset >= 0
    add-immediate(pointer, base, offset)
else
    sub-immediate(pointer, base, 0 - offset)
= load-address-offset(pointer, 0)

