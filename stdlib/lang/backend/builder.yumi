────────────────────
+ do stlrb InstructionId
    - src OperandId
    - address OperandId

= asm(.stlrb, src, address)

────────────────────
+ do ldrb InstructionId
    - dest OperandId
    - address OperandId

= asm(.ldrb, dest, address)

────────────────────
+ do ldrh InstructionId
    - dest OperandId
    - address OperandId

= asm(.ldrh, dest, address)

────────────────────
+ do str InstructionId
    - src OperandId
    - address OperandId

= asm(.str, src, address)

────────────────────
+ do strb InstructionId
    - src OperandId
    - address OperandId

= asm(.strb, src, address)

────────────────────
+ do strh InstructionId
    - src OperandId
    - address OperandId

= asm(.strh, src, address)

────────────────────
+ do stp InstructionId
    - first OperandId
