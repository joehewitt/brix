━━━━━━━━━━━━━━━━━━━━
_ int-value I64
    - value MIRInt

?! Panic("MIR immediate ${value.bits} does not fit a signed offset")
    if !value.is-negative && value.bits > 0x7fffffffffffffff

value.bits as I64

━━━━━━━━━━━━━━━━━━━━
_ do add-sub-immediate-chunk I64
    - remaining I64
    - max-chunk I64

. capped = if remaining < max-chunk then remaining else max-chunk
if capped <= max-add-sub-immediate
    = capped
. units = capped / 4096
if units > max-add-sub-immediate
    units = max-add-sub-immediate
if units > 0
    = units * 4096
= max-add-sub-immediate
