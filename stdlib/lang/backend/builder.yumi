+ do add-pointer InstructionId
    - dest OperandId
    - src OperandId

= asm(.addptr, dest, src)

────────────────────
+ do add InstructionId
    - dest OperandId
    - left OperandId
    - right OperandId

= asm(.add, dest, left, right)

────────────────────
+ do and InstructionId
    - dest OperandId
    - left OperandId
    - right OperandId

= asm(.and, dest, left, right)

────────────────────
+ do mov InstructionId
    - dest OperandId
    - src OperandId

= asm(.mov, dest, src)

────────────────────
+ do fmov InstructionId
    - dest OperandId
    - src OperandId

