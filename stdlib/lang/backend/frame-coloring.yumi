./liveness
./mir
./pointer-flow
/core/arena
/core/table

━━━━━━━━━━━━━━━━━━━━
+ MIRFrameColoring

_ builder MIRBuilder
_ function MIRFunction
_ flow MIRPointerFlow
_ liveness MIRLiveness
_ word-count U32
_ block-count U32
_ masks CPointer'U32
_ seen-roots CPointer'U32
_ seen-mask U32
_ taken IdList
_ narrows-roots Bool

────────────────────
+ This
    - builder MIRBuilder
    - liveness MIRLiveness
    - flow MIRPointerFlow
    - narrows-roots Bool = true

` Without `narrows-roots`, every frame object that may hold a pointer stays a root, and every
` one keeps its place in the frame, as the reference's backend keeps them (see
` `derive-lifetimes`).
.. function = builder.function

────────────────────
_ get arena Arena @inline

function.arena

────────────────────
+ do plan

. objects IdList
. closure-slot = root-slot(function.closure-root)
. capture-slot = root-slot(function.capture-closure-root)
for position in 0 .. < function.frame-slots.length
    . slot = function.frame-slots[position]
    . row = function.slots[slot]
    if row.is-stack || row.objects.length != 1
        continue
    . object = row.objects[0]
    if function.frame-objects[object].is-spill || is-zero-size
        continue
    .. is-zero-size = function.types[function.frame-objects[object].type].size == 0
    if slot == closure-slot || slot == capture-slot
        continue
    objects = objects.appended(arena, object)
derive-lifetimes(objects)

────────────────────
_ root-slot MIRSlotId
    - object FrameObjectId

if object == no-frame-object then no-id else function.frame-objects[object].slot

────────────────────
_ do derive-lifetimes
    - objects IdList

` Gives each frame object whose address does not escape the positions it lives over. With
` `narrows-roots`, one that no code refers to, as a variable promoted to registers, leaves its
` slot and takes no place in the frame. It and one that lives over no call where the collector
` may run hold no root, and no safepoint lists them.
flow.run-objects(liveness.blocks, objects)
. candidates IdList
for root in 0 .. < objects.length
    if flow.escapes[root] != 0
        continue
    if flow.references[root].length != 0
        candidates = candidates.appended(arena, root)
    else if narrows-roots
        . object = objects[root]
        function.frame-objects[object].gc-root = false
        function.slots[function.frame-objects[object].slot].objects = IdList()
. count = candidates.length
word-count = (count + 31) / 32
if word-count == 0
    =
block-count = liveness.blocks.length
?! Panic("A function with $block-count blocks and $count frame objects is too large to color")
    if (block-count as U64) * count > 0xffffffff
. total = block-count * word-count
masks = arena.allocate'U32(total)
. locals = new-id-map(arena, count)
. local-ranges IdList
for id in 0 .. < count
    . references = flow.references[candidates[id]]
    for index in 0 .. < references.length
        . position = function.instructions[references[index]].position as U32
        . block = block-of-position(position)
        . key = block * count + id
        . entry = locals.get(key)
        if entry == no-id
            locals = locals.inserted(arena, key, local-ranges.length)
            local-ranges = local-ranges.appended(arena, position)
            local-ranges = local-ranges.appended(arena, position + 1)
        else
            if position < local-ranges[entry]
                local-ranges.data[entry] = position
            if position + 1 > local-ranges[entry + 1]
                local-ranges.data[entry + 1] = position + 1
        set-bit(masks + block * word-count, id)

. reached-before = reach(true)
. reached-after = reach(false)
. lifetimes = arena.allocate'IdList(count)
for block in 0 .. < block-count
    . block-mask = masks + block * word-count
    . block-before = reached-before + block * word-count
    . block-after = reached-after + block * word-count
    for word in 0 .. < word-count
        . bits = block-mask[word] /or/ (block-before[word] /and/ block-after[word])
        . id = word * 32
        while bits != 0
            if (bits /and/ 1) != 0
                . entry = locals.get(block * count + id)
                . start = liveness.block-start[block]
                if !has-bit(block-before, id)
                    start = local-ranges[entry]
                . end = liveness.block-end[block]
                if !has-bit(block-after, id)
                    end = local-ranges[entry + 1]
                . ranges = lifetimes[id]
                if ranges.length != 0 && ranges[ranges.length - 1] >= start
                    ranges.data[ranges.length - 1] = end
                else
                    ranges = ranges.appended(arena, start)
                    lifetimes[id] = ranges.appended(arena, end)
            bits = bits /zrshift/ 1
            id += 1

. flat = function.lifetimes
for id in 0 .. < count
    . ranges = lifetimes[id]
    . first = flat.length
    for index in 0 .. < ranges.length
        flat = flat.appended(arena, ranges[index])
    function.frame-objects[objects[candidates[id]]].lifetime = Span(first, ranges.length)
function.lifetimes = flat
if !narrows-roots
    =
. safepoints = safepoint-positions()
for id in 0 .. < count
    if !crosses-safepoint(lifetimes[id], safepoints)
        function.frame-objects[objects[candidates[id]]].gc-root = false

────────────────────
_ do safepoint-positions IdList

. positions IdList
. calls = liveness.call-instructions
for index in 0 .. < calls.length
    if function.instructions[calls[index]].gc-safepoint
        positions = positions.appended(arena, function.instructions[calls[index]].position as U32)
= positions

────────────────────
_ do crosses-safepoint Bool
    - ranges IdList
    - safepoints IdList

. cursor U32
while cursor < ranges.length
    . low U32
    . high = safepoints.length
    while low < high
        . middle = (low + high) / 2
        if safepoints[middle] < ranges[cursor]
            low = middle + 1
        else
            high = middle
    if low < safepoints.length && safepoints[low] < ranges[cursor + 1]
        = true
    cursor += 2
= false

────────────────────
_ do block-of-position U32
    - position U32

. low U32
. high = block-count - 1
while low < high
    . middle = (low + high + 1) / 2
    if liveness.block-start[middle] <= position
        low = middle
    else
        high = middle - 1
= low

────────────────────
_ do reach CPointer'U32
    - is-forward Bool

. total = block-count * word-count
. incoming = arena.allocate'U32(total)
. outgoing = arena.allocate'U32(total)
for index in 0 .. < total
    outgoing[index] = masks[index]
. pending = new-id-list(arena, block-count)
. queued = arena.allocate'Byte(block-count)
for index in 0 .. < block-count
    pending = pending.appended(arena, if is-forward then index else block-count - index - 1)
    queued[index] = 1
. cursor U32
while cursor < pending.length
    . index = pending[cursor]
    cursor += 1
    queued[index] = 0
    . block = function.blocks[liveness.blocks[index]]
    . adjacent = if is-forward then block.successors else block.predecessors
    . source = outgoing + index * word-count
    for position in 0 .. < adjacent.length
        . target = liveness.block-index[adjacent[position]]
        if target == no-id
            continue
        . target-incoming = incoming + target * word-count
        . target-outgoing = outgoing + target * word-count
        . target-mask = masks + target * word-count
        . changed = false
        for word in 0 .. < word-count
            . combined = target-incoming[word] /or/ source[word]
            if combined != target-incoming[word]
                target-incoming[word] = combined
                . next = combined /or/ target-mask[word]
                if next != target-outgoing[word]
                    changed = true
                target-outgoing[word] = next
        if changed && queued[target] == 0
            queued[target] = 1
            pending = pending.appended(arena, target)
= incoming

────────────────────
+ do pack-frame-objects U32
    - original-size U32

` Gives each frame object with a lifetime the lowest place that no object placed before it
` disputes, taking them in the order their lifetimes start. An object placed is compared
` again only while it can still decide a place: the first to take its bytes, which answers
` for every later one that shares them, and any whose lifetime has not ended where the next
` one starts. The place tried only rises, so an object it has passed is left out of the
` rest of that object's search.
. records IdList
for position in 0 .. < function.frame-slots.length
    . objects = function.slots[function.frame-slots[position]].objects
    for index in 0 .. < objects.length
        records = records.appended(arena, objects[index])
. candidates IdList
for index in 0 .. < records.length
    if function.frame-objects[records[index]].lifetime.count != 0
        candidates = candidates.appended(arena, records[index])
. count = candidates.length
if count == 0
    = original-size
. saved-offsets = arena.allocate'I32(records.length)
for index in 0 .. < records.length
    saved-offsets[index] = function.frame-objects[records[index]].offset
. starts = arena.allocate'U32(count)
for index in 0 .. < count
    starts[index] = function.lifetimes[function.frame-objects[candidates[index]].lifetime.start]
candidates = stable-order(arena, candidates, starts)

. placed-start = arena.allocate'U32(count)
. placed-end = arena.allocate'U32(count)
. placed-last = arena.allocate'U32(count)
. leads = arena.allocate'Byte(count)
. compared = arena.allocate'U32(count)
. following = arena.allocate'U32(count)
. compared-count U32
. limit U32 = 8
for position in 0 .. < count
    . object = candidates[position]
    . type = function.frame-objects[object].type
    . size = builder.frame-object-size(type)
    . alignment = builder.frame-object-alignment(type)
    ?! Panic("A frame object with a lifetime has no alignment")
        if alignment == 0
    . is-root = function.frame-objects[object].gc-root
    . lifetime = function.frame-objects[object].lifetime
    . begins = function.lifetimes[lifetime.start]
    . kept U32
    for slot in 0 .. < compared-count
        . index = compared[slot]
        if leads[index] != 0 || placed-last[index] > begins
            compared[kept] = index
            kept += 1
    compared-count = kept
    for slot in 0 .. < compared-count
        following[slot] = slot + 1
    . first U32
    . end = align(8 + size, alignment)
    . shares = false
    while true
        . conflict = no-id
        shares = false
        . kept-slot = no-id
        . slot = first
        while slot < compared-count
            . index = compared[slot]
            . other-end = placed-end[index]
            if end - size >= other-end
                if kept-slot == no-id
                    first = following[slot]
                else
                    following[kept-slot] = following[slot]
                slot = following[slot]
                continue
            kept-slot = slot
            slot = following[slot]
            if end <= placed-start[index]
                continue
            . other = candidates[index]
            . other-is-root = function.frame-objects[other].gc-root
            . paired = is-root && other-is-root && end == other-end
            if (is-root || other-is-root) && !paired
                conflict = index
                break
            if lifetimes-overlap(lifetime, function.frame-objects[other].lifetime)
                conflict = index
                break
            if paired && !has-same-shape(object, other)
                conflict = index
                break
            if is-root == other-is-root && end == other-end && end - size == placed-start[index]
                shares = true
        if conflict == no-id
            break
        end = align(placed-end[conflict] + size, alignment)
    function.frame-objects[object].offset = 0 - (end as I32)
    if end > limit
        limit = end
    placed-start[position] = end - size
    placed-end[position] = end
    placed-last[position] = function.lifetimes[lifetime.end - 1]
    leads[position] = if shares then 0 else 1
    compared[compared-count] = position
    compared-count += 1

for index in 0 .. < records.length
    . object = records[index]
    if function.frame-objects[object].lifetime.count != 0
        continue
    . type = function.frame-objects[object].type
    . alignment = builder.frame-object-alignment(type)
    if alignment != 0
        limit = align(limit + builder.frame-object-size(type), alignment)
    function.frame-objects[object].offset = 0 - (limit as I32)
. size = align(limit, 16)
if size > original-size
    for index in 0 .. < records.length
        function.frame-objects[records[index]].offset = saved-offsets[index]
    = original-size
= size

────────────────────
_ do lifetimes-overlap Bool
    - left Span
    - right Span

. ranges = function.lifetimes
. a = left.start
. b = right.start
while a < left.end && b < right.end
    if ranges[a + 1] <= ranges[b]
        a += 2
    else if ranges[b + 1] <= ranges[a]
        b += 2
    else
        = true
= false

────────────────────
_ has-same-shape Bool
    - left FrameObjectId
    - right FrameObjectId

a.gc-descriptor == b.gc-descriptor && a.gc-root-mode == b.gc-root-mode && same-type

.. a = function.frame-objects[left]
.. b = function.frame-objects[right]
.. same-type = has-same-type(a.type, b.type)

────────────────────
_ do has-same-type Bool
    - left MIRTypeId
    - right MIRTypeId

if left == right
    = true
if function.types[left].size != function.types[right].size
    = false
if function.types[left].alignment != function.types[right].alignment
    = false
match function.types[left]
    | .void-type
        match? function.types[right]
            | .void-type
                = true
    | .int-type(first)
        match? function.types[right]
            | .int-type(second)
                = same-bit-size && first.is-signed == second.is-signed && same-class
                    .. same-bit-size = first.bit-size == second.bit-size
                    .. same-class = first.reg-class == second.reg-class
    | .float-type(first)
        match? function.types[right]
            | .float-type(second)
                = first.bit-size == second.bit-size && first.reg-class == second.reg-class
    | .pointer-type(first)
        match? function.types[right]
            | .pointer-type(second)
                = first.reg-class == second.reg-class
    | .array-type(first)
        match? function.types[right]
            | .array-type(second)
                = first.length == second.length && has-same-type(first.item, second.item)
    | .struct-type(first)
        match? function.types[right]
            | .struct-type(second)
                if first.format != second.format || first.fields.count != second.fields.count
                    = false
                for index in 0 .. < first.fields.count
                    . x = function.struct-fields[first.fields.start + index]
                    . y = function.struct-fields[second.fields.start + index]
                    if x.offset != y.offset || !has-same-type(x.type, y.type)
                        = false
                = true
= false

────────────────────
+ do deduplicate-roots

` Leaves each root once among the function's and once among each instruction's, in the order
` they were first listed. The roots seen are kept in a table that a root's own key leads
` to: the function's stay in it, and an instruction's are taken out when it is done.
if function.lifetimes.length == 0
    =
. order = function.block-order
. most = function.gc-roots.count
for position in 0 .. < order.length
    . instructions = function.blocks[order[position]].instructions
    for index in 0 .. < instructions.length
        . id = instructions[index]
        if !function.instructions[id].has-gc-roots
            continue
        . listed = function.gc-roots.count + function.instructions[id].gc-roots.count
        if listed > most
            most = listed
. capacity U32 = 8
while capacity < most * 2
    capacity *= 2
seen-roots = arena.allocate'U32(capacity)
seen-mask = capacity - 1
taken = IdList()
function.gc-roots = unique-roots(function.gc-roots)
taken = IdList()
for position in 0 .. < order.length
    . instructions = function.blocks[order[position]].instructions
    for index in 0 .. < instructions.length
        . id = instructions[index]
        if !function.instructions[id].has-gc-roots
            continue
        function.instructions[id].gc-roots = unique-roots(function.instructions[id].gc-roots)
        for entry in 0 .. < taken.length
            seen-roots[taken[entry]] = 0
        taken = IdList(taken.data, 0, taken.capacity)

────────────────────
_ do unique-roots Span
    - roots Span

. first = function.roots.length
for root in roots.start .. < roots.end
    . slot = root-slot(root)
    . is-seen = false
    while seen-roots[slot] != 0
        if is-same-root(seen-roots[slot] - 1, root)
            is-seen = true
            break
        slot = (slot + 1) /and/ seen-mask
    if is-seen
        continue
    seen-roots[slot] = root + 1
    taken = taken.appended(arena, slot)
    match function.roots[root]
        | .register-root(row)
            function.roots.append(RegisterRoot(row.register))
        | .stack-root(row)
            function.roots.append(StackRoot(row.object, row.gc-descriptor, row.gc-root-mode))
= Span(first as U32, (function.roots.length - first) as U32)

────────────────────
_ do root-slot U32
    - root U32

` Where the table starts to look for a root: by what `is-same-root` compares.
. key U32
match function.roots[root]
    | .register-root(row)
        key = row.register * 2
    | .stack-root(row)
        . offset = function.frame-objects[row.object].offset as U32
        key = ((offset * 31 + row.gc-descriptor) * 31 + (row.gc-root-mode as U32)) * 2 + 1
. hash = key * 2654435769
= (hash /xor/ (hash /zrshift/ 16)) /and/ seen-mask

────────────────────
_ do is-same-root Bool
    - left U32
    - right U32

match function.roots[left]
    | .register-root(a)
        match? function.roots[right]
            | .register-root(b)
                = a.register == b.register
    | .stack-root(a)
        match? function.roots[right]
            | .stack-root(b)
                = a.gc-descriptor == b.gc-descriptor && a.gc-root-mode == b.gc-root-mode && function.frame-objects[a.object].offset == function.frame-objects[b.object].offset
= false

━━━━━━━━━━━━━━━━━━━━
_ align U32
    - value U32
    - alignment U32

((value + alignment - 1) / alignment) * alignment
