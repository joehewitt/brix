./mir
/core/arena
/string.h

━━━━━━━━━━━━━━━━━━━━
+ BinaryWriter

+ data CPointer'Byte
+ length Size
_ capacity Size
_ arena Arena

────────────────────
+ This
    - arena Arena
    - initial-capacity Size = 4096

capacity = initial-capacity
data = arena.allocate-raw(initial-capacity, 8)

────────────────────
+ get view ByteSpan

ByteSpan(data, length)

────────────────────
+ do clear

length = 0

────────────────────
_ do reserve @inline
    - count Size

if length + count > capacity
    grow(length + count)

────────────────────
_ do grow
    - needed Size

. next = if capacity >= 64 then capacity * 2 else 64
while next < needed
    next *= 2
. replacement = arena.allocate-raw(next, 8)
C:memcpy(replacement, data, length)
data = replacement
capacity = next

────────────────────
+ do u8
    - value U32

reserve(1)
data[length] = (value /and/ 0xff) as Byte
length += 1

────────────────────
+ do u16
    - value U32

reserve(2)
. target = (data + length) as CPointer'U16
target[0] = (value /and/ 0xffff) as U16
length += 2

────────────────────
+ do u32
    - value U32

reserve(4)
. target = (data + length) as CPointer'U32
target[0] = value
length += 4

────────────────────
+ do put-u32
    - value U32
    - offset Size

. target = (data + offset) as CPointer'U32
target[0] = value

────────────────────
+ do i32
    - value I32

reserve(4)
. target = (data + length) as CPointer'I32
target[0] = value
length += 4

────────────────────
+ do u64
    - value U64

reserve(8)
. target = (data + length) as CPointer'U64
target[0] = value
length += 8

────────────────────
+ do bytes
    - value ByteSpan

reserve(value.length)
C:memcpy(data + length, value.data, value.length)
length += value.length

────────────────────
+ do text
    - value String

bytes(ByteSpan(value, value.size))

────────────────────
+ do zeros
    - count Size

reserve(count)
C:memset(data + length, 0, count)
length += count

────────────────────
+ do align
    - alignment Size

. mask = alignment - 1
?! Panic("Alignment must be a power of two: $alignment")
    if alignment == 0 || (alignment /and/ mask) != 0
zeros(((length + mask) /and/ (mask /xor/ Size.max)) - length)
