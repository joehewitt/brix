(import ./binary-writer)
(import ./bundle)
(import ./compact)
(import ./mir)
(import ./mir-job)
(import ./mir-text)
(import ./object-builder)
(import ./object-file)
(import ./pipeline)
(import /core/arena)
(import /core/table)
(import /lang/target)
(import /os/env)
(import /os/file)
(import /os/path)
(import /stream/sort)
(blank)
(prop _ no-job U32 (= (. U32 max)))
(prop _ records-magic U32 (= 0x52424d59))
(prop _ records-version U32 (= 1))
(prop _ default-worker-count _ (= (/ (+ (* (call usable-core-count) 2) 2) 3)))
(prop _ functions-per-worker _ (= 200))
(prop _ output-file-perms _ (= (+ user-read-perm user-write-perm group-read-perm other-read-perm)))
(prop _ output-mode-names (list String) (= (list "executable" "static-lib")))
(prop _ constant-kind-names (list String) (= (list "byte" "short" "long" "quad" "string" "label")))
(prop _ gc-root-kind-names (list String) (= (list "global" "taskLocal" "threadLocal")))

(type + BackendOptions
  (prop + bundle-path String)
  (prop + object-path String)
  (prop + records-path String)
  (prop + dump-directory String)
  (prop + dump-all-text Bool)
  (prop + dump-text (list U32))
  (prop + worker-count Int)
  (prop + through Stage (= .record))
  (prop + reference Bool)
  (prop + target _ (= (call host-target)))
  (fn-do + stop-after _ (?! Error)
    (param name String)
    (for (in index (..< 0 (. stage-names length)))
      (if (== ([] stage-names index) name)
        (= through (as index Stage))
        (return)
      )
    )
    (throw (call Error (str "Unknown stage " name)))
  )
  (fn-expr + dumps-text Bool
    (param order U32)
    (and (!= (. dump-directory size) 0) (or dump-all-text (has dump-text order)))
  )
)

(fn-do + run-backend _ (?! Error)
  (param options BackendOptions)
  (let bundle (use (call read-bundle (. options bundle-path))))
  (= (. bundle apple-abi) (. options target uses-apple-abi))
  (let function-count (. bundle functions length))
  (let count (call worker-count options function-count))
  (let queue (call JobQueue bundle))
  (let dumps (call (of Array FunctionDump) function-count))
  (let arena (use (call Arena)))
  (let records (call (of (. arena allocate) CompactFunction) function-count))
  (let workers (list BackendWorker))
  (for (in _ (..< 0 count))
    (+= workers (call BackendWorker bundle options queue dumps records))
  )
  (finally
    (for (in worker workers)
      (call (. worker release))
    )
  )
  (blank)
  (let pool (call Worker count))
  (finally
    (call (. pool stop))
  )
  (let group (call TaskGroup))
  (for (in worker workers)
    (let task
      (do-new (worker: pool)
        (call (. worker run))
        (on-failure failed
          (call (. group keep) failed)
        )
      )
    )
    (call (. group add) task)
  )
  (call (. group wait))
  (blank)
  (let built (call MIRCounts))
  (let allocated (call MIRCounts))
  (for (in worker workers)
    (call (. built add) (. worker pipeline built))
    (call (. allocated add) (. worker pipeline allocated))
  )
  (probe-log lang.backend.mir.program.pre (items: (. built functions) (. built blocks) (. built instructions) (. built frame-bytes)))
  (probe-log lang.backend.mir.program.alloc (items: (. allocated functions) (. allocated blocks) (. allocated instructions) (. allocated frame-bytes)))
  (blank)
  (let ordered (call ordered-positions bundle))
  (if (!= (. options dump-directory size) 0)
    (call write-dump bundle options dumps ordered)
  )
  (if (!= (. options records-path size) 0)
    (call write-records bundle (. options records-path) records ordered)
  )
  (if (!= (. options object-path size) 0)
    (throw (call Error (str "No object can be written when functions stop after " ([] stage-names (. options through)))) (if (!= (. options through) .record)))
    (blank)
    (let builder (use (call ObjectBuilder bundle)))
    (call (. builder build) records ordered)
    (call write-file (. options object-path) (call object-file builder (. options target)))
  )
)

(type _ JobQueue
  (prop _ lock Mutex)
  (prop _ positions (list U32))
  (prop _ cursor Size)
  (fn-do + This _
    (param bundle Bundle)
    (let keys (list U64))
    (for (in position (..< 0 (. bundle functions length)))
      (let words U64 (. ([] (. bundle functions) position) word-count))
      (+= keys (/or/ (/lshift/ words 32) (as position U64)))
    )
    (let sorted (call sort keys))
    (for (in index (..< 0 (. sorted length)))
      (+= positions (as (/and/ ([] sorted (- (. sorted length) 1 index)) 0xffffffff) U32))
    )
  )
  (fn-do + take U32
    (use lock)
    (if (== cursor (. positions length))
      (return no-job)
    )
    (let position ([] positions cursor))
    (+= cursor 1)
    (return position)
  )
)

(type _ BackendWorker
  (prop + pipeline FunctionPipeline)
  (blank)
  (prop _ bundle Bundle)
  (prop _ options BackendOptions)
  (prop _ queue JobQueue)
  (prop _ dumps (of Array FunctionDump))
  (prop _ records (of CPointer CompactFunction))
  (prop _ decoder JobDecoder)
  (fn-do + This _
    (param bundle Bundle)
    (param options BackendOptions)
    (param queue JobQueue)
    (param dumps (of Array FunctionDump))
    (param records (of CPointer CompactFunction))
    (lazy pipeline
      (call FunctionPipeline
        (block
          (arg bundle)
          (arg (. options through))
          (arg (!= (. options dump-directory size) 0))
          (arg (. options reference))
        )
      )
    )
    (lazy decoder (call JobDecoder (. pipeline function)))
  )
  (fn-do + release _
    (call (. pipeline release))
  )
  (fn-do + run _
    (while true
      (let position (call (. queue take)))
      (if (== position no-job)
        (break)
      )
      (call compile position)
    )
  )
  (fn-do _ compile _
    (param position U32)
    (let record ([] (. bundle functions) position))
    (call (. pipeline begin) (call (. options dumps-text) (. record order)))
    (call (. decoder decode) record)
    (if (call (. pipeline lower))
      (= ([] records position) (call (. pipeline encode)))
    )
    (= ([] dumps position) (call (. pipeline finished-dump)))
  )
)

(fn-do _ ordered-positions (list U32)
  (param bundle Bundle)
  (let keys (list U64))
  (for (in position (..< 0 (. bundle functions length)))
    (let order U64 (. ([] (. bundle functions) position) order))
    (+= keys (/or/ (/lshift/ order 32) (as position U64)))
  )
  (let sorted (call sort keys))
  (let positions (list U32))
  (for (in key sorted)
    (+= positions (as (/and/ key 0xffffffff) U32))
  )
  (return positions)
)

(fn-do _ write-records _ (?! Error)
  (param bundle Bundle)
  (param path String)
  (param records (of CPointer CompactFunction))
  (param ordered (list U32))
  (let arena (use (call Arena)))
  (let writer (call BinaryWriter arena 1048576))
  (call (. writer u32) records-magic)
  (call (. writer u32) records-version)
  (call (. writer u32) (as (. ordered length) U32))
  (for (in position ordered)
    (let start (. writer length))
    (call (. writer u32) 0)
    (let compact ([] records position))
    (if (. compact is-encoded)
      (call write-compact-record writer bundle compact)
    )
    (call (. writer put-u32) (as (- (. writer length) start 4) U32) start)
  )
  (call write-file path (. writer view))
)

(fn-do _ worker-count Int
  (param options BackendOptions)
  (param function-count Size)
  (let count (. options worker-count))
  (if (<= count 0)
    (= count (/ (- (+ function-count functions-per-worker) 1) functions-per-worker))
    (if (> count default-worker-count)
      (= count default-worker-count)
    )
  )
  (if (<= count 0)
    (= count 1)
  )
  (return count)
)

(fn-do _ write-dump _ (?! Error)
  (param bundle Bundle)
  (param options BackendOptions)
  (param dumps (of Array FunctionDump))
  (param ordered (list U32))
  (let directory Path (. options dump-directory))
  (call make-directories directory)
  (blank)
  (let out TextBuffer)
  (for (in position ordered)
    (let record ([] (. bundle functions) position))
    (let dump ([] dumps position))
    (call (. out unsigned) (. record order))
    (call (. out byte) 32)
    (call (. out span) (call (. bundle string) (. record label)))
    (for (in index (..< 0 (. dump stage-count)))
      (let stage ([] (. dump stages) index))
      (call (. out byte) 32)
      (call (. out text) ([] stage-names (. stage stage)))
      (call (. out byte) 61)
      (call (. out hex64) (. stage hash))
    )
    (call (. out byte) 10)
    (if (!= (. dump text length) 0)
      (call write-file (/ directory (str (. record order) ".txt")) (. dump text))
    )
  )
  (call write-file (/ directory "stages.txt") (call ByteSpan (. out bytes data) (. out length)))
  (blank)
  (call (. out clear))
  (call manifest-text bundle out)
  (call write-file (/ directory "manifest.txt") (call ByteSpan (. out bytes data) (. out length)))
)

(fn-do _ manifest-text _
  (param bundle Bundle)
  (param out TextBuffer)
  (call (. out text) "options gc=")
  (call (. out unsigned) (if-expr (. bundle gc-enabled) 1 0))
  (call (. out text) " trace=")
  (call (. out unsigned) (if-expr (. bundle stack-trace-metadata) 1 0))
  (call (. out text) " output=")
  (call (. out text) ([] output-mode-names (. bundle output-mode)))
  (call (. out text) " allocation-buffer=")
  (call (. out unsigned) (. bundle gc-allocation-buffer-version))
  (call (. out byte) 10)
  (for (in index (..< 0 (. bundle safepoint-free length)))
    (call (. out text) "safepoint-free ")
    (call (. out span) (call (. bundle string) ([] (. bundle safepoint-free) index)))
    (call (. out byte) 10)
  )
  (for (in index (..< 0 (. bundle inferred-safepoint-free length)))
    (call (. out text) "inferred-safepoint-free ")
    (call (. out span) (call (. bundle string) ([] (. bundle inferred-safepoint-free) index)))
    (call (. out byte) 10)
  )
  (for (in literal (. bundle literals))
    (call (. out text) "string ")
    (call (. out span) (call (. bundle string) (. literal name)))
    (call (. out text) " chars=")
    (call (. out unsigned) (. literal character-length))
    (call (. out text) " flags=")
    (call (. out unsigned) (. literal flags))
    (call (. out text) " bytes=")
    (call (. out hex) (. literal bytes))
    (call (. out byte) 10)
  )
  (for (in number (. bundle numbers))
    (call (. out text) "number ")
    (call (. out span) (call (. bundle string) (. number name)))
    (call (. out text) " size=")
    (call (. out unsigned) (. number size))
    (call (. out text) " bits=")
    (call (. out hex64) (. number bits))
    (call (. out byte) 10)
  )
  (for (in table (. bundle constant-tables))
    (call (. out text) "constants ")
    (call (. out span) (call (. bundle string) (. table name)))
    (call (. out text) " align=")
    (call (. out unsigned) (. table alignment))
    (call (. out byte) 10)
    (for (in index (..< (. table items start) (. table items end)))
      (let item ([] (. bundle constant-items) index))
      (call (. out text) "  ")
      (call (. out text) ([] constant-kind-names (. item kind)))
      (call (. out byte) 32)
      (if (== (. item kind) .string-constant)
        (call (. out escaped) (call (. bundle string) (. item name)))
        (else-if (== (. item kind) .label-constant)
          (call (. out span) (call (. bundle string) (. item name)))
        )
        (else
          (call (. out unsigned) (. item bits))
        )
      )
      (call (. out byte) 10)
    )
  )
  (for (in global (. bundle globals))
    (call (. out text) "global ")
    (call (. out span) (call (. bundle string) (. global name)))
    (call (. out text) " size=")
    (call (. out unsigned) (. global size))
    (call (. out text) " align=")
    (call (. out unsigned) (. global alignment))
    (call (. out byte) 10)
  )
  (for (in root (. bundle gc-roots))
    (call (. out text) "gc-root ")
    (call (. out text) ([] gc-root-kind-names (. root kind)))
    (call (. out byte) 32)
    (if (== (. root symbol) no-string)
      (call (. out byte) 45)
      (else
        (call (. out span) (call (. bundle string) (. root symbol)))
      )
    )
    (call (. out byte) 32)
    (call (. out span) (call (. bundle string) (. root descriptor)))
    (call (. out byte) 10)
  )
)

(fn-do _ make-directories _ (?! Error)
  (param directory Path)
  (if (or (not directory) (. directory is-dir))
    (return)
  )
  (call make-directories (. directory dir))
  (call (. directory make-directory) "" 493)
)

(fn-do _ write-file _ (?! Error)
  (param path Path)
  (param contents ByteSpan)
  (let mode (+ (. FileFlags write-mode) (. FileFlags create-mode) (. FileFlags truncate-mode)))
  (let file (use (call File path mode output-file-perms)))
  (if (!= (. contents length) 0)
    (call (. file write) (call (of Array Byte) (. contents data) (. contents length)) (. contents length))
  )
)
