      (let target ([] entries (+ entry 1)))
      (if (== ([] entries entry) (. ReloadPlace block-start))
        (= ([] start-reloads target) (call (. (call (. ([] start-reloads target) appended) arena id) appended) arena parent))
        (else-if (== ([] entries entry) (. ReloadPlace block-end))
          (= ([] end-reloads target) (call (. (call (. ([] end-reloads target) appended) arena id) appended) arena parent))
        )
        (else
          (= ([] call-reloads target) (call (. (call (. ([] call-reloads target) appended) arena id) appended) arena parent))
        )
      )
      (+= entry 2)
    )
    (= has-pieces true)
  )
  (fn-do _ free-parent RegisterId
    (param id U32)
    (param start U32)
    (param end U32)
    (param parents IdList)
    (param should-be-used Bool)
    (for (in index (..< 0 (. parents length)))
      (let parent ([] parents index))
      (if (!= (!= ([] used parent) 0) should-be-used)
        (continue)
      )
      (let ranges (. ([] (. liveness intervals) id) ranges))
      (let cursor (call (. liveness first-range-ending-after) ranges start))
      (let fits true)
      (while (and fits (< cursor (. ranges length)) (< ([] ranges cursor) end))
        (= fits
          (call is-free
            (block
              (arg parent)
              (arg (if-expr (> ([] ranges cursor) start) ([] ranges cursor) start))
              (arg (if-expr (< ([] ranges (+ cursor 1)) end) ([] ranges (+ cursor 1)) end))
            )
          )
        )
        (+= cursor 2)
      )
      (if fits
        (return parent)
      )
    )
    (return no-register)
