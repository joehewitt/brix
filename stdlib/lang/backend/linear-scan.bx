              (arg arena)
              (arg (+ ([] ranges (+ cursor 1)) (/and/ ([] ranges (+ cursor 1)) 1)))
            )
          )
        )
        (+= cursor 2)
      )
    )
    (if has-pieces
      (for (in index (..< 0 (. order length)))
        (let id ([] order index))
        (let held ([] pieces id))
        (let ranges (. ([] (. liveness intervals) id) ranges))
        (let piece U32)
        (while (< piece (. held length))
          (let parent ([] held (+ piece 2)))
          (let start ([] held piece))
          (let end ([] held (+ piece 1)))
          (let cursor (call (. liveness first-range-ending-after) ranges start))
          (while (and (< cursor (. ranges length)) (< ([] ranges cursor) end))
            (let from (if-expr (> ([] ranges cursor) start) ([] ranges cursor) start))
            (let to (if-expr (< ([] ranges (+ cursor 1)) end) ([] ranges (+ cursor 1)) end))
            (= ([] starts parent) (call (. ([] starts parent) appended) arena (+ from (/and/ from 1))))
            (= ([] ends parent) (call (. ([] ends parent) appended) arena (+ to (/and/ to 1))))
            (+= cursor 2)
          )
          (+= piece 3)
        )
      )
    )
