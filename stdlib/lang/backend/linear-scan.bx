  (fn-expr _ is-call-at Bool
    (param position U32)
    (and (< index (. calls length)) (== ([] calls index) position))
    (where
      (lazy calls (. liveness call-positions))
      (lazy index (call first-call-from (+ (* position 2) 1)))
    )
  )
  (fn-do _ first-use-from U32
    (param uses IdList)
    (param slot U32)
    (let low U32)
    (let high (. uses length))
    (while (< low high)
      (let middle (/ (+ low high) 2))
      (if (< ([] uses middle) slot)
        (= low (+ middle 1))
        (else
          (= high middle)
        )
      )
    )
    (return low)
  )
  (fn-do _ block-at U32
    (param position U32)
    (let low U32)
    (let high (. liveness blocks length))
    (while (< low high)
      (let middle (/ (+ low high) 2))
      (if (<= ([] (. liveness block-start) middle) position)
        (= low (+ middle 1))
        (else
          (= high middle)
        )
      )
    )
    (let index (- low 1))
    (while (and (> index 0) (<= ([] (. liveness block-end) index) position))
      (-= index 1)
    )
    (return index)
  )
  (fn-do _ first-block-from U32
    (param slot U32)
    (let low U32)
    (let high (. liveness blocks length))
    (while (< low high)
      (let middle (/ (+ low high) 2))
      (if (< (* ([] (. liveness block-start) middle) 2) slot)
        (= low (+ middle 1))
        (else
          (= high middle)
        )
      )
    )
    (return low)
  )
  (fn-expr _ block-weight U32
    (param index U32)
    (/lshift/ 1u32 (* 3 (if-expr (> depth 6) 6u32 depth)))
    (where
      (lazy depth ([] depths index))
    )
