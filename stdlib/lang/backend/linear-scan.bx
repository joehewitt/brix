  (fn-do _ find-depths _
    ; How deeply each block is nested in loops, counting a loop as the blocks in order from a header
    ; to the last block that branches back to it.
    (let count (. liveness blocks length))
    (let latest (call (of (. arena allocate) U32) count))
    (for (in index (..< 0 count))
      (let successors (. ([] (. function blocks) ([] (. liveness blocks) index)) successors))
      (for (in position (..< 0 (. successors length)))
        (let header ([] (. liveness block-index) ([] successors position)))
        (if (and (!= header no-id) (<= header index) (> (+ index 1) ([] latest header)))
          (= ([] latest header) (+ index 1))
        )
      )
    )
    (let opens (call (of (. arena allocate) U32) (+ count 1)))
    (let closes (call (of (. arena allocate) U32) (+ count 1)))
    (for (in header (..< 0 count))
      (if (!= ([] latest header) 0)
        (+= ([] opens header) 1)
        (+= ([] closes ([] latest header)) 1)
      )
    )
    (= depths (call (of (. arena allocate) U32) count))
    (let running U32)
    (for (in index (..< 0 count))
      (= running (- (+ running ([] opens index)) ([] closes index)))
      (= ([] depths index) running)
    )
  )
  (fn-do _ find-incoming _
    (let count (. liveness blocks length))
    (= incoming (call (of (. arena allocate) IdList) count))
    (for (in index (..< 0 count))
      (let successors (. ([] (. function blocks) ([] (. liveness blocks) index)) successors))
      (for (in position (..< 0 (. successors length)))
        (let target ([] (. liveness block-index) ([] successors position)))
        (if (!= target no-id)
          (= ([] incoming target) (call (. ([] incoming target) appended) arena index))
        )
      )
    )
  )
  (fn-do _ find-occupied _
    ; The slots each register holds an interval in, as sorted ranges that do not overlap.
    (let raw (call (of (. arena allocate) IdList) register-count))
    (let order (. liveness order))
    (for (in index (..< 0 (. order length)))
      (let id ([] order index))
      (if (!= (. ([] allocations id) kind) .in-register)
        (continue)
      )
      (let parent (call register-parent (. ([] allocations id) register)))
      (let ranges (. ([] (. liveness intervals) id) ranges))
      (for (in cursor (..< 0 (. ranges length)))
        (= ([] raw parent) (call (. ([] raw parent) appended) arena ([] ranges cursor)))
      )
    )
    (= occupied (call (of (. arena allocate) IdList) register-count))
    (for (in parent (..< 0 register-count))
      (let count (/ (. ([] raw parent) length) 2))
      (if (== count 0)
        (continue)
      )
      (let packed (call (of (. arena allocate) U64) count))
      (for (in index (..< 0 count))
        (= ([] packed index) (/or/ (/lshift/ (as ([] ([] raw parent) (* index 2)) U64) 32) range-end))
        (lazy range-end (as ([] ([] raw parent) (+ (* index 2) 1)) U64))
      )
      (call sort-u64 arena packed count)
      (let merged IdList)
      (for (in index (..< 0 count))
        (let start (as (/zrshift/ ([] packed index) 32) U32))
        (let end (as (/and/ ([] packed index) 0xffffffff) U32))
        (if (and (!= (. merged length) 0) (<= start ([] merged (- (. merged length) 1))))
          (if (> end ([] merged (- (. merged length) 1)))
            (= ([] (. merged data) (- (. merged length) 1)) end)
          )
          (else
            (= merged (call (. merged appended) arena start))
            (= merged (call (. merged appended) arena end))
          )
        )
      )
      (= ([] occupied parent) merged)
    )
