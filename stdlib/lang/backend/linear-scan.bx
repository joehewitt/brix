    (let held ([] pieces id))
    (let at (. held length))
    (while (and (> at 0) (> ([] held (- at 3)) start))
      (-= at 3)
    )
    (= held (call (. held inserted) arena at parent))
    (= held (call (. held inserted) arena at end))
    (= ([] pieces id) (call (. held inserted) arena at start))
