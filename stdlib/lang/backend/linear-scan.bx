  (fn-expr _ is-free Bool
    (param parent RegisterId)
    (param start U32)
    (param end U32)
    (or (>= index (. ranges length)) (>= ([] ranges index) end))
    (where
      (lazy ranges ([] occupied parent))
      (lazy index (call (. liveness first-range-ending-after) ranges start))
    )
  )
  (fn-do _ occupy _
    (param parent RegisterId)
    (param start U32)
    (param end U32)
    (let index (call (. liveness first-range-ending-after) ([] occupied parent) start))
    (= ([] occupied parent) (call (. (call (. ([] occupied parent) inserted) arena index end) inserted) arena index start))
  )
  (fn-do _ first-call-from U32
    (param slot U32)
    (let calls (. liveness call-positions))
    (let low U32)
    (let high (. calls length))
    (while (< low high)
      (let middle (/ (+ low high) 2))
      (if (< (+ (* ([] calls middle) 2) 1) slot)
        (= low (+ middle 1))
        (else
          (= high middle)
        )
      )
    )
    (return low)
