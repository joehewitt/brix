      (call index-live-ranges)
      (= has-live-ranges true)
    )
    (let ranges ([] live-ranges parent))
    (let low U32)
    (let high (/ (. ranges length) 2))
    (while (< low high)
      (let middle (/ (+ low high) 2))
      (if (<= ([] ranges (* middle 2)) slot)
        (= low (+ middle 1))
        (else
          (= high middle)
        )
      )
    )
    (return (and (> low 0) (< slot ([] ranges (- (* low 2) 1)))))
  )
  (fn-do _ index-live-ranges _
    (let starts (call (of (. arena allocate) IdList) register-count))
    (let ends (call (of (. arena allocate) IdList) register-count))
    (let order (. liveness order))
    (for (in index (..< 0 (. order length)))
      (let id ([] order index))
      (if (!= (. ([] allocations id) kind) .in-register)
        (continue)
      )
      (let parent (call register-parent (. ([] allocations id) register)))
      (let ranges (. ([] (. liveness intervals) id) ranges))
      (let cursor U32)
      (while (< cursor (. ranges length))
        (= ([] starts parent) (call (. ([] starts parent) appended) arena (+ ([] ranges cursor) (/and/ ([] ranges cursor) 1))))
        (= ([] ends parent)
          (call (. ([] ends parent) appended)
