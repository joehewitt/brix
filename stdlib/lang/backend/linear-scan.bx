          (arg parent)
          (arg (if-expr (> ([] ranges cursor) start) ([] ranges cursor) start))
          (arg (if-expr (< ([] ranges (+ cursor 1)) end) ([] ranges (+ cursor 1)) end))
        )
      )
      (+= cursor 2)
    )
