  (fn-do _ sorted-values IdList
    (param values IdList)
    (let count (. values length))
    (let wide (call (of (. arena allocate) U64) count))
    (for (in index (..< 0 count))
      (= ([] wide index) ([] values index))
    )
    (call sort-u64 arena wide count)
    (for (in index (..< 0 count))
      (= ([] (. values data) index) (as ([] wide index) U32))
    )
    (return values)
  )
  (fn-do _ live-use-slot-ranges IdList
    (param starts IdList)
    (param ends IdList)
    (param limit U32)
    (let ranges IdList)
    (let start-index U32)
    (let end-index U32)
    (let live-count U32)
    (let live-from U32)
    (while (or (< start-index (. starts length)) (< end-index (. ends length)))
      (let next no-slot)
      (if (< start-index (. starts length))
        (= next ([] starts start-index))
      )
      (if (and (< end-index (. ends length)) (< ([] ends end-index) next))
        (= next ([] ends end-index))
      )
      (if (>= next limit)
        (break)
      )
      (let was-live (> live-count 0))
      (while (and (< end-index (. ends length)) (== ([] ends end-index) next))
        (if (> live-count 0)
          (-= live-count 1)
        )
        (+= end-index 1)
      )
      (while (and (< start-index (. starts length)) (== ([] starts start-index) next))
        (+= live-count 1)
        (+= start-index 1)
      )
      (if (and (not was-live) (> live-count 0))
        (= live-from next)
        (else-if (and was-live (== live-count 0))
          (= ranges (call (. ranges appended) arena live-from))
          (= ranges (call (. ranges appended) arena next))
        )
      )
    )
    (if (> live-count 0)
      (= ranges (call (. ranges appended) arena live-from))
      (= ranges (call (. ranges appended) arena limit))
    )
    (return ranges)
  )
  (fn-do + write-text _
    (param text MIRText)
    (let out (. text out))
    (call (. out text) "allocations\n")
    (for (in id (..< 0 (. liveness vreg-count)))
      (if (== (. ([] allocations id) kind) .unallocated)
        (continue)
      )
      (call (. out text) "  V")
      (call (. out unsigned) id)
      (call (. out byte) 46)
      (call (. text reg-class-suffix) (. ([] allocations id) reg-class))
      (if (== (. ([] allocations id) kind) .in-register)
        (call (. out text) " reg ")
        (call (. text register-text) (. ([] allocations id) register))
        (else-if (== (. ([] allocations id) kind) .recomputed)
          (call (. out text) " recomputed")
        )
        (else
          (call (. out text) " spill ")
          (call (. text frame-object-text) (. ([] allocations id) spill-slot))
          (if has-pieces
            (let held ([] pieces id))
            (let piece U32)
            (while (< piece (. held length))
              (call (. out text) (if-expr (== piece 0) " pieces=" ","))
              (call (. out unsigned) ([] held piece))
              (call (. out byte) 45)
              (call (. out unsigned) ([] held (+ piece 1)))
              (call (. out byte) 58)
              (call (. text register-text) ([] held (+ piece 2)))
              (+= piece 3)
            )
          )
        )
      )
      (call (. out byte) 10)
    )
    (call (. out text) "used ")
    (for (in index (..< 0 (. used-order length)))
      (if (!= index 0)
        (call (. out byte) 32)
      )
      (call (. text register-text) ([] used-order index))
    )
    (call (. out byte) 10)
  )
)

(fn-expr _ is-gpr-class Bool
  (param reg-class RegClass)
  (or (== reg-class .gpr32) (== reg-class .gpr64))
)

(fn-expr _ sum-of U32
  (param left U32)
  (param right U32)
  (if-expr (> left (- 0x40000000 right)) 0x40000000 (+ left right))
)

(fn-do _ without IdList
  (param ids IdList)
  (param id U32)
  (for (in index (..< 0 (. ids length)))
    (if (== ([] ids index) id)
      (for (in position (..< (+ index 1) (. ids length)))
        (= ([] (. ids data) (- position 1)) ([] ids position))
      )
      (return (call IdList (. ids data) (- (. ids length) 1) (. ids capacity)))
    )
  )
  (return ids)
)
