  (fn-do _ find-stretches _
    (param id U32)
    (let ranges (. ([] (. liveness intervals) id) ranges))
    (let calls (. liveness call-positions))
    (let low ([] ranges 0))
    (let cursor U32)
    (while (< cursor (. ranges length))
      (let call (call first-call-from (if-expr (> ([] ranges cursor) low) ([] ranges cursor) low)))
      (while (and (< call (. calls length)) (< (+ (* ([] calls call) 2) 1) ([] ranges (+ cursor 1))))
        (if (> (+ (* ([] calls call) 2) 1) low)
          (= low (call consider-stretch id low (+ (* ([] calls call) 2) 1)))
        )
        (+= call 1)
      )
      (+= cursor 2)
    )
    (if (> ([] ranges (- (. ranges length) 1)) low)
      (call consider-stretch id low ([] ranges (- (. ranges length) 1)))
    )
  )
  (fn-do _ consider-stretch U32
    (param id U32)
    (param low U32)
    (param high U32)
    ; Notes the stretch of an interval from the block of its first use between two slots to its last
    ; use there, with the loads that bring its value in, when the reads it saves are worth more. Where
    ; the stretch is in a loop, it is also noted carried on to the last block that branches back, over
    ; any calls in the way, after each of which the value is loaded again; that wider stretch is
    ; chosen first when it saves more, and the narrower one where no register is free for it. Where
    ; the wider stretch ends, or `high`.
    (let uses (. ([] (. liveness intervals) id) uses))
    (let first (call first-use-from uses low))
    (return-if high (if (or (>= first (. uses length)) (>= ([] uses first) high))))
    (blank)
    (let last first)
    (while (and (< (+ last 1) (. uses length)) (< ([] uses (+ last 1)) high))
      (+= last 1)
    )
    (let ranges (. ([] (. liveness intervals) id) ranges))
    (let used ([] uses first))
    (let start ([] ranges (call (. liveness first-range-ending-after) ranges used)))
    (if (< start low)
      (= start low)
    )
    (let block-from (* ([] (. liveness block-start) (call block-at (/ used 2))) 2))
    (if (> block-from start)
      (= start block-from)
    )
    (let end (+ ([] uses last) 1))
    (let tail (* ([] (. liveness block-end) (call block-at (/ ([] uses last) 2))) 2))
    (if (and (<= tail high) (call (. liveness covers) id (- tail 1)))
      (= end tail)
    )
    (let mark (. entries length))
    (let cost (call measure-stretch id start end))
    (if (== cost (. U32 max))
      (= entries (call IdList (. entries data) mark (. entries capacity)))
      (return high)
    )
    (let gain (call gain-before uses first end))
    (let narrow (if-expr (> gain cost) (- gain cost) 0))
    (let narrowed (. entries length))
    (let wide end)
    (let wide-cost cost)
    (while (and (> reach wide) (!= wide-cost (. U32 max)))
      (= wide reach)
      (= entries (call IdList (. entries data) narrowed (. entries capacity)))
      (= wide-cost (call measure-stretch id start wide))
    )
    (if (and (> wide end) (!= wide-cost (. U32 max)))
      (let wide-gain (call gain-before uses first wide))
      (if (and (> wide-gain wide-cost) (> (- wide-gain wide-cost) narrow))
        (let alternate
          (block
            (case? (!= narrow 0)
              (call note-stretch id start end mark narrowed narrow false)
            )
            (default
              no-id
            )
          )
        )
        (call note-stretch id start wide narrowed (. entries length) (- wide-gain wide-cost) true)
        (= ([] (. candidate-alternates data) (- (. candidate-alternates length) 1)) alternate)
        (return (if-expr (> wide high) wide high))
      )
    )
    (= entries (call IdList (. entries data) narrowed (. entries capacity)))
    (if (== narrow 0)
      (= entries (call IdList (. entries data) mark (. entries capacity)))
      (return high)
    )
    (call note-stretch id start end mark narrowed narrow true)
    (return high)
  )
  (fn-do _ measure-stretch U32
    (param id U32)
    (param start U32)
    (param end U32)
    ; What the loads that bring a stretch's value in cost, which it notes in `entries`, or the most a
    ; U32 holds where one has no place. A load after a call is counted as if a loop out, since it
    ; costs little beside the call. `reach` becomes the end of the last block past the stretch
    ; that branches back into it while the value lives on.
    (= reach end)
    (let cost U32)
    (let calls (. liveness call-positions))
    (let call (call first-call-from start))
    (while (and (< call (. calls length)) (< (+ (* ([] calls call) 2) 1) end))
      (if (call (. liveness covers) id (+ (* ([] calls call) 2) 1))
        (= entries (call (. entries appended) arena (. ReloadPlace after-call)))
        (= entries (call (. entries appended) arena ([] calls call)))
        (let weight (call block-weight (call block-at ([] calls call))))
        (= cost (call sum-of cost (if-expr (> weight 8) (/ weight 8) 1)))
      )
      (+= call 1)
    )
    (let ranges (. ([] (. liveness intervals) id) ranges))
    (let cursor (call (. liveness first-range-ending-after) ranges start))
    (while (and (< cursor (. ranges length)) (< ([] ranges cursor) end))
      (let to (if-expr (< ([] ranges (+ cursor 1)) end) ([] ranges (+ cursor 1)) end))
      (let block (call first-block-from (if-expr (> ([] ranges cursor) start) ([] ranges cursor) start)))
      (while (and (< block (. liveness blocks length)) (< (* ([] (. liveness block-start) block) 2) to))
        (let added (call entry-cost id block start end))
        (return-if (. U32 max) (if (== added (. U32 max))))
        (blank)
        (= cost (call sum-of cost added))
        (+= block 1)
      )
      (+= cursor 2)
    )
    (return cost)
  )
  (fn-do _ gain-before U32
    (param uses IdList)
    (param first U32)
    (param end U32)
    (let gain U32)
    (let index first)
    (while (and (< index (. uses length)) (< ([] uses index) end))
      (if (== (/and/ ([] uses index) 1) 0)
        (= gain (call sum-of gain (call block-weight (call block-at (/ ([] uses index) 2)))))
      )
      (+= index 1)
    )
    (return gain)
  )
  (fn-do _ note-stretch U32
    (param id U32)
    (param start U32)
    (param end U32)
    (param from U32)
    (param to U32)
    (param gain U32)
    (param ranked Bool)
    (= candidate-ids (call (. candidate-ids appended) arena id))
    (= candidate-starts (call (. candidate-starts appended) arena start))
    (= candidate-ends (call (. candidate-ends appended) arena end))
    (= candidate-firsts (call (. candidate-firsts appended) arena from))
    (= candidate-lasts (call (. candidate-lasts appended) arena to))
    (= candidate-gains (call (. candidate-gains appended) arena gain))
    (= candidate-alternates (call (. candidate-alternates appended) arena no-id))
    (= candidate-ranked (call (. candidate-ranked appended) arena (if-expr ranked 1u32 0u32)))
    (return (- (. candidate-ids length) 1))
  )
  (fn-do _ entry-cost U32
    (param id U32)
    (param index U32)
    (param start U32)
    (param end U32)
    ; What loading a stretch's value costs where control enters a block it holds the value at the
    ; start of, from each block that leads there without holding it, or the most a U32 holds where
    ; some such edge has no place for the load: neither its source's only way out nor its target's
    ; only way in. A later block that branches back while the value lives on to its end moves
    ; `reach` to that end, so the stretch can hold a loop whole.
    (let block ([] (. liveness blocks) index))
    (let sources ([] incoming index))
    (return-if (. U32 max) (if (or (== (. sources length) 0) (== ([] (. liveness block-start) index) ([] (. liveness block-end) index)))))
    (blank)
    (let cost U32)
    (for (in position (..< 0 (. sources length)))
      (let source ([] sources position))
      (return-if (. U32 max) (if (== ([] (. liveness block-start) source) ([] (. liveness block-end) source))))
      (blank)
      (let exit (- (* ([] (. liveness block-end) source) 2) 1))
      (let panics (call panics-to ([] (. liveness blocks) source) block))
      (if (and (not panics) (>= exit start) (< exit end) (call (. liveness covers) id exit))
        (continue)
      )
      (if (and (not panics) (>= source index) (>= exit end) (> (+ exit 1) reach) (call (. liveness covers) id exit))
        (= reach (+ exit 1))
      )
      (if (and (not panics) (== (. ([] (. function blocks) ([] (. liveness blocks) source)) successors length) 1))
        (= entries (call (. entries appended) arena (. ReloadPlace block-end)))
        (= entries (call (. entries appended) arena ([] (. liveness blocks) source)))
        (= cost (call sum-of cost (call block-weight source)))
        (else-if (== (. sources length) 1)
          (= entries (call (. entries appended) arena (. ReloadPlace block-start)))
          (= entries (call (. entries appended) arena block))
          (= cost (call sum-of cost (call block-weight index)))
        )
        (else
          (return (. U32 max))
        )
      )
    )
    (return cost)
  )
  (fn-do _ panics-to Bool
    (param source BlockId)
    (param target BlockId)
    (let name (. ([] (. function blocks) target) name))
    (let instructions (. ([] (. function blocks) source) instructions))
    (for (in index (..< 0 (. instructions length)))
      (match? ([] (. function instructions) ([] instructions index))
        (case (call .call-instruction call)
          (if (!= (. call panic-target) no-operand)
            (match? ([] (. function operands) (. call panic-target))
              (case (call .label-operand label)
                (if (== (. label name) name)
                  (return true)
                )
              )
            )
          )
        )
      )
    )
    (return false)
  )
  (fn-do _ place-stretch _
    (param candidate U32)
    (let id ([] candidate-ids candidate))
    (let start ([] candidate-starts candidate))
    (let end ([] candidate-ends candidate))
    (let first U32 (if-expr (call is-gpr-class (. ([] (. liveness intervals) id) reg-class)) 0 4))
    (let parent (call free-parent id start end ([] orders first) true))
    (if (== parent no-register)
      (= parent (call free-parent id start end ([] orders first) false))
    )
    (if (== parent no-register)
      (= parent (call free-parent id start end ([] orders (+ first 1)) true))
    )
    (if (== parent no-register)
      (= parent (call free-parent id start end ([] orders (+ first 1)) false))
    )
    (if (== parent no-register)
