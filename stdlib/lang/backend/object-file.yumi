./elf-writer
./macho-writer
./mir
./object-builder
/lang/target

━━━━━━━━━━━━━━━━━━━━
+ do object-file ByteSpan
    - builder ObjectBuilder
    - target Target

` The built object in the format the target's linker reads.
= match target.object-format
    |= .macho
        write-macho(builder, target)
    |= .elf
        write-elf(builder)
