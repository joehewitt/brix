(import ./builder)
(import ./mir)
(import ./mir-text)
(import /core/arena)
(import /core/table)
(blank)
(prop + no-slot U32 (= (. U32 max)))

(type + LiveInterval (is Struct)
  (prop + exists Bool)
  (prop + view VRegId)
  (prop + reg-class RegClass)
  (prop + ranges IdList)
  (prop + uses IdList)
  (prop + pinned RegisterId)
  (prop + preferred RegisterId)
  (prop + crosses-call Bool)
  (prop + scan-active Bool)
  (prop + next-use-cursor U32)
)

(fn-expr + has-bit Bool @inline
  (param words (of CPointer U32))
  (param id U32)
  (!= (/and/ ([] words (/zrshift/ id 5)) (/lshift/ 1u32 (/and/ id 31))) 0)
)

(fn-do + set-bit _ @inline
  (param words (of CPointer U32))
  (param id U32)
  (let word (/zrshift/ id 5))
  (= ([] words word) (/or/ ([] words word) (/lshift/ 1u32 (/and/ id 31))))
)

(type + MIRLiveness
  (prop _ builder MIRBuilder)
  (prop _ function MIRFunction)
  (prop + blocks IdList)
  (prop + block-index (of CPointer U32))
  (prop + block-start (of CPointer U32))
  (prop + block-end (of CPointer U32))
  (prop + live-in (of CPointer IdList))
  (prop + live-out (of CPointer IdList))
  (prop + intervals (of CPointer LiveInterval))
  (prop + order IdList)
  (prop + call-positions IdList)
  (prop + call-instructions IdList)
  (prop + copy-preferences (of CPointer IdList))
  (prop + instruction-count U32)
  (prop + vreg-count U32)
  (prop _ readers (of CPointer IdList))
  (prop _ writers (of CPointer IdList))
  (prop _ read-at (of CPointer U32))
  (prop _ written-at (of CPointer U32))
  (prop _ coalesces Bool)
  (fn-do + This _
    (param builder MIRBuilder)
    (param coalesces Bool (= true))
    (lazy function (. builder function))
  )
  (fn-expr _ arena Arena :get @inline
    (. function arena)
  )
  (fn-do + run _
    (let post-order (call (. function post-order)))
    (let count (. post-order length))
    (let block-count (. function blocks length))
    (= blocks (call new-id-list arena count))
    (= block-index (call (of (. arena allocate) U32) block-count))
    (for (in block (..< 0 block-count))
      (= ([] block-index block) no-id)
    )
    (for (in index (..< 0 count))
      (let block ([] post-order (- count 1 index)))
      (= ([] block-index block) index)
      (= blocks (call (. blocks appended) arena block))
    )
    (= block-start (call (of (. arena allocate) U32) count))
    (= block-end (call (of (. arena allocate) U32) count))
    (= vreg-count (. function vreg-count))
    (call number-instructions)
    (call compute-liveness)
    (call build-intervals)
  )
  (fn-do _ number-instructions _
    (let position U32)
    (= call-positions (call IdList))
    (= call-instructions (call IdList))
    (for (in index (..< 0 (. blocks length)))
      (= ([] block-start index) position)
      (let instructions (. ([] (. function blocks) ([] blocks index)) instructions))
      (for (in offset (..< 0 (. instructions length)))
        (let id ([] instructions offset))
        (= (. ([] (. function instructions) id) position) (as position I32))
        (let opcode (. ([] (. function instructions) id) opcode))
        (if (or (== opcode .call) (== opcode .bl) (== opcode .blr))
          (= call-positions (call (. call-positions appended) arena position))
        )
        (if (== opcode .call)
          (= call-instructions (call (. call-instructions appended) arena id))
        )
        (+= position 1)
      )
      (= ([] block-end index) position)
    )
    (= instruction-count position)
  )
  (fn-do _ compute-liveness _
    ; The registers live into each block and out of it, each list in the order of their ids. A
    ; register is live into a block that reads it before writing it, and out of every block that
    ; reaches such a block without passing one that writes it. Each register is followed on its
    ; own, back from the blocks that read it, so the work and the memory are the size of what is
    ; live.
    ; 1. Each block's instructions say which registers it reads first and which it writes.
    ; 2. The blocks that lead to each block are listed from the successors the answer is
    ;    defined by.
    ; 3. Each register is followed back from its readers. A block is marked with the register
    ;    it was last visited for, so no set of registers is kept for a block.
    (let block-count (. blocks length))
    (= live-in (call (of (. arena allocate) IdList) block-count))
    (= live-out (call (of (. arena allocate) IdList) block-count))
    (= copy-preferences (call (of (. arena allocate) IdList) vreg-count))
    (= readers (call (of (. arena allocate) IdList) vreg-count))
    (= writers (call (of (. arena allocate) IdList) vreg-count))
    (= read-at (call (of (. arena allocate) U32) vreg-count))
    (= written-at (call (of (. arena allocate) U32) vreg-count))
    (for (in index (..< 0 block-count))
      (let instructions (. ([] (. function blocks) ([] blocks index)) instructions))
      (for (in offset (..< 0 (. instructions length)))
        (let id ([] instructions offset))
        (let roles (call (. function operand-roles) id))
        (let operands (. ([] (. function instructions) id) operands))
        (for (in position (..< 0 (. operands length)))
          (call mark-operand ([] operands position) (call role-at roles position) index)
        )
        (let opcode (. ([] (. function instructions) id) opcode))
        (if (or (== opcode .mov) (and coalesces (== opcode .fmov)))
          (call note-copy operands (. ([] (. function instructions) id) is-phi-copy))
        )
      )
    )
    (blank)
    (let first-incoming (call (of (. arena allocate) U32) (+ block-count 1)))
    (for (in index (..< 0 block-count))
      (let successors (. ([] (. function blocks) ([] blocks index)) successors))
      (for (in position (..< 0 (. successors length)))
        (+= ([] first-incoming (+ ([] block-index ([] successors position)) 1)) 1)
      )
    )
    (for (in index (..< 0 block-count))
      (+= ([] first-incoming (+ index 1)) ([] first-incoming index))
    )
    (let incoming (call (of (. arena allocate) U32) ([] first-incoming block-count)))
    (let filled (call (of (. arena allocate) U32) block-count))
    (for (in index (..< 0 block-count))
      (let successors (. ([] (. function blocks) ([] blocks index)) successors))
      (for (in position (..< 0 (. successors length)))
        (let successor ([] block-index ([] successors position)))
        (= ([] incoming (+ ([] first-incoming successor) ([] filled successor))) index)
        (+= ([] filled successor) 1)
      )
    )
    (blank)
    (let live-into (call (of (. arena allocate) U32) block-count))
    (let live-from (call (of (. arena allocate) U32) block-count))
    (let writes (call (of (. arena allocate) U32) block-count))
    (let pending (call (of (. arena allocate) U32) block-count))
    (for (in id (..< 0 vreg-count))
      (let starts ([] readers id))
      (if (== (. starts length) 0)
        (continue)
      )
      (let mark (+ id 1))
      (let written ([] writers id))
      (for (in position (..< 0 (. written length)))
        (= ([] writes ([] written position)) mark)
      )
      (let depth U32)
      (for (in position (..< 0 (. starts length)))
        (let start ([] starts position))
        (= ([] live-into start) mark)
        (= ([] live-in start) (call (. ([] live-in start) appended) arena id))
        (= ([] pending depth) start)
        (+= depth 1)
      )
      (while (!= depth 0)
        (-= depth 1)
        (let block ([] pending depth))
        (for (in edge (..< ([] first-incoming block) ([] first-incoming (+ block 1))))
          (let source ([] incoming edge))
          (if (== ([] live-from source) mark)
            (continue)
          )
          (= ([] live-from source) mark)
          (= ([] live-out source) (call (. ([] live-out source) appended) arena id))
          (if (and (!= ([] writes source) mark) (!= ([] live-into source) mark))
            (= ([] live-into source) mark)
            (= ([] live-in source) (call (. ([] live-in source) appended) arena id))
            (= ([] pending depth) source)
            (+= depth 1)
          )
        )
      )
    )
  )
  (fn-expr _ checked-id U32
    (param view VRegId)
    (before
      (throw (call Panic (str "V" id " is outside the " vreg-count " registers of its function")) (if (>= id vreg-count)))
    )
    id
    (where
      (lazy id (. ([] (. function vregs) view) id))
    )
  )
  (fn-do _ mark-operand _
    (param operand OperandId)
    (param role U32)
    (param block U32)
    (if (== role 0)
      (return)
    )
    (match? ([] (. function operands) operand)
      (case (call .vreg-operand row)
        (call mark-vreg (call checked-id (. row vreg)) role block)
      )
      (case (call .vreg-group-operand row)
        (for (in index (..< (. row vregs start) (. row vregs end)))
          (call mark-vreg (call checked-id ([] (. function group-vregs) index)) role block)
        )
      )
      (case (call .load-address-operand row)
        (match? ([] (. function operands) (. row base))
          (case (call .vreg-operand base)
            (call mark-vreg (call checked-id (. base vreg)) role block)
          )
        )
        (if (!= (. row offset) no-operand)
          (match? ([] (. function operands) (. row offset))
            (case (call .vreg-operand index)
              (call mark-vreg (call checked-id (. index vreg)) use-role block)
            )
          )
        )
      )
    )
  )
  (fn-do _ mark-vreg _
    (param id U32)
    (param role U32)
    (param block U32)
    ; Notes a block as one that reads a register before writing it, or as one that writes it.
    ; Each register remembers the last block noted, so a block is listed once.
    (let mark (+ block 1))
    (if (and (!= (/and/ role use-role) 0) (!= ([] written-at id) mark) (!= ([] read-at id) mark))
      (= ([] read-at id) mark)
      (= ([] readers id) (call (. ([] readers id) appended) arena block))
    )
    (if (and (!= (/and/ role def-role) 0) (!= ([] written-at id) mark))
      (= ([] written-at id) mark)
      (= ([] writers id) (call (. ([] writers id) appended) arena block))
    )
  )
  (fn-do _ note-copy _
    (param operands IdList)
    (param is-phi-copy Bool)
    (if (< (. operands length) 2)
      (return)
    )
    (let destination no-id)
    (let source no-id)
    (match? ([] (. function operands) ([] operands 0))
      (case (call .vreg-operand row)
        (= destination (. row vreg))
      )
    )
    (match? ([] (. function operands) ([] operands 1))
      (case (call .vreg-operand row)
        (= source (. row vreg))
      )
    )
    (if (or (== destination no-id) (== source no-id))
      (return)
    )
    (let reg-class (. ([] (. function vregs) destination) reg-class))
    (if (or (!= reg-class (. ([] (. function vregs) source) reg-class)) (== reg-class .gpr32) (== reg-class .fpr32))
      (return)
    )
    (if (and (== reg-class .gpr64) is-phi-copy (not coalesces))
      (return)
    )
    (let destination-id (call checked-id destination))
    (let source-id (call checked-id source))
    (call add-copy-preference destination-id source-id)
    (call add-copy-preference source-id destination-id)
  )
  (fn-do _ add-copy-preference _
    (param id U32)
    (param preferred U32)
    (let list ([] copy-preferences id))
    (for (in index (..< 0 (. list length)))
      (if (== ([] list index) preferred)
        (return)
      )
    )
    (= ([] copy-preferences id) (call (. list appended) arena preferred))
  )
  (fn-do _ build-intervals _
    (= intervals (call (of (. arena allocate) LiveInterval) vreg-count))
    (= order (call IdList))
    (let remaining (. blocks length))
    (while (> remaining 0)
      (-= remaining 1)
      (let block-from ([] block-start remaining))
      (let block-to ([] block-end remaining))
      (let out ([] live-out remaining))
      (for (in position (..< 0 (. out length)))
        (call touch-interval ([] out position) no-id)
        (call add-range-front ([] out position) (* block-from 2) (* block-to 2))
      )
      (let instructions (. ([] (. function blocks) ([] blocks remaining)) instructions))
      (let offset (. instructions length))
      (while (> offset 0)
        (-= offset 1)
        (let instruction ([] instructions offset))
        (let position (as (. ([] (. function instructions) instruction) position) U32))
        (let roles (call (. function operand-roles) instruction))
        (let operands (. ([] (. function instructions) instruction) operands))
        (for (in operand (..< 0 (. operands length)))
          (call add-operand-uses ([] operands operand) (call role-at roles operand) position block-from)
        )
      )
    )
    (blank)
    (for (in index (..< 0 (. order length)))
      (let id ([] order index))
      (call reverse-pairs (. ([] intervals id) ranges))
      (let uses (. ([] intervals id) uses))
      (call reverse-ids uses)
      (let kept U32)
      (for (in read (..< 0 (. uses length)))
        (if (or (== kept 0) (!= ([] uses read) ([] uses (- kept 1))))
          (= ([] (. uses data) kept) ([] uses read))
          (+= kept 1)
        )
      )
      (= (. ([] intervals id) uses) (call IdList (. uses data) kept (. uses capacity)))
      (= (. ([] intervals id) crosses-call) (call crosses-call (. ([] intervals id) ranges)))
      (let view (. ([] intervals id) view))
      (if (!= view no-id)
        (= (. ([] intervals id) pinned) (. ([] (. function vregs) view) hint))
      )
    )
  )
  (fn-do _ add-operand-uses _
    (param operand OperandId)
    (param role U32)
    (param position U32)
    (param block-from U32)
    (match? ([] (. function operands) operand)
      (case (call .vreg-operand row)
        (call add-interval-use (. row vreg) role position block-from)
      )
      (case (call .vreg-group-operand row)
        (for (in index (..< (. row vregs start) (. row vregs end)))
          (call add-interval-use ([] (. function group-vregs) index) role position block-from)
        )
      )
      (case (call .load-address-operand row)
        (match? ([] (. function operands) (. row base))
          (case (call .vreg-operand base)
            (call add-interval-use (. base vreg) role position block-from)
          )
        )
        (if (!= (. row offset) no-operand)
          (match? ([] (. function operands) (. row offset))
            (case (call .vreg-operand index)
              (call add-interval-use (. index vreg) use-role position block-from)
            )
          )
        )
      )
    )
  )
  (fn-do _ add-interval-use _
    (param view VRegId)
    (param role U32)
    (param position U32)
    (param block-from U32)
    (let id (call checked-id view))
    (call touch-interval id view)
    (if (!= (/and/ role use-role) 0)
      (call add-range-front id (* block-from 2) (+ (* position 2) 1))
      (= (. ([] intervals id) uses) (call (. ([] intervals id) uses appended) arena (* position 2)))
    )
    (if (!= (/and/ role def-role) 0)
      (call set-range-from id (+ (* position 2) 1))
      (= (. ([] intervals id) uses) (call (. ([] intervals id) uses appended) arena (+ (* position 2) 1)))
    )
  )
  (fn-do _ touch-interval _
    (param id U32)
    (param view VRegId)
    (if (not (. ([] intervals id) exists))
      (= (. ([] intervals id) exists) true)
      (= (. ([] intervals id) view) view)
      (= (. ([] intervals id) reg-class) .gpr64)
      (= (. ([] intervals id) pinned) no-register)
      (= (. ([] intervals id) preferred) no-register)
      (= order (call (. order appended) arena id))
      (if (!= view no-id)
        (= (. ([] intervals id) reg-class) (. ([] (. function vregs) view) reg-class))
      )
      (else-if (!= view no-id)
        (= (. ([] intervals id) view) view)
        (= (. ([] intervals id) reg-class) (. ([] (. function vregs) view) reg-class))
      )
    )
  )
  (fn-do _ add-range-front _
    (param id U32)
    (param from U32)
    (param to U32)
    (let ranges (. ([] intervals id) ranges))
    (let length (. ranges length))
    (if (and (!= length 0) (<= ([] ranges (- length 2)) to))
      (if (< from ([] ranges (- length 2)))
        (= ([] (. ranges data) (- length 2)) from)
      )
      (if (> to ([] ranges (- length 1)))
        (= ([] (. ranges data) (- length 1)) to)
      )
      (return)
    )
    (= ranges (call (. ranges appended) arena from))
    (= (. ([] intervals id) ranges) (call (. ranges appended) arena to))
  )
  (fn-do _ set-range-from _
    (param id U32)
    (param from U32)
    (let ranges (. ([] intervals id) ranges))
    (let length (. ranges length))
    (if (and (!= length 0) (<= ([] ranges (- length 2)) from) (< from ([] ranges (- length 1))))
      (= ([] (. ranges data) (- length 2)) from)
      (else
        (call add-range-front id from (+ from 1))
      )
    )
  )
  (fn-do _ crosses-call Bool
    (param ranges IdList)
    (if (== (. call-positions length) 0)
      (return false)
    )
    (let skip U32 (if-expr coalesces 1 0))
    (let index U32)
    (while (< index (. ranges length))
      (if (< (call first-call-through-slot (+ ([] ranges index) skip)) ([] ranges (+ index 1)))
        (return true)
      )
      (+= index 2)
    )
    (return false)
  )
  (fn-do _ first-call-through-slot U32
    (param slot U32)
    (let low U32)
    (let high (. call-positions length))
    (while (< low high)
      (let middle (/ (+ low high) 2))
      (if (< (+ (* ([] call-positions middle) 2) 1) slot)
        (= low (+ middle 1))
        (else
          (= high middle)
        )
      )
    )
    (if (< low (. call-positions length))
      (return (+ (* ([] call-positions low) 2) 1))
    )
    (return no-slot)
  )
  (fn-expr + start U32 @inline
    (param id U32)
    (if-expr (== (. ranges length) 0) no-slot ([] ranges 0))
    (where
      (lazy ranges (. ([] intervals id) ranges))
    )
  )
  (fn-expr + end U32 @inline
    (param id U32)
    (if-expr (== (. ranges length) 0) 0 ([] ranges (- (. ranges length) 1)))
    (where
      (lazy ranges (. ([] intervals id) ranges))
    )
  )
  (fn-do + overlaps Bool
    (param left U32)
    (param right U32)
    (let a (. ([] intervals left) ranges))
    (let b (. ([] intervals right) ranges))
    (if (or (== (. a length) 0) (== (. b length) 0))
      (return false)
    )
    (let i (call first-range-ending-after a ([] b 0)))
    (let j (call first-range-ending-after b ([] a 0)))
    (while (and (< i (. a length)) (< j (. b length)))
      (if (<= ([] a (+ i 1)) ([] b j))
        (+= i 2)
        (else-if (<= ([] b (+ j 1)) ([] a i))
          (+= j 2)
        )
        (else
          (return true)
        )
      )
    )
    (return false)
  )
  (fn-expr + covers Bool
    (param id U32)
    (param slot U32)
    (and (< index (. ranges length)) (<= ([] ranges index) slot))
    (where
      (lazy ranges (. ([] intervals id) ranges))
      (lazy index (call first-range-ending-after ranges slot))
    )
  )
  (fn-do + first-range-ending-after U32
    (param ranges IdList)
    (param slot U32)
    ; The first range that ends after a slot, or the length when none does. An interval of many
    ; ranges is not read from its start for each one it is compared with.
    (let low U32)
    (let high (/ (. ranges length) 2))
    (while (< low high)
      (let middle (/ (+ low high) 2))
      (if (<= ([] ranges (+ (* middle 2) 1)) slot)
        (= low (+ middle 1))
        (else
          (= high middle)
        )
      )
    )
    (return (* low 2))
  )
  (fn-do + next-use-after U32
    (param id U32)
    (param position U32)
    (let uses (. ([] intervals id) uses))
    (let cursor (. ([] intervals id) next-use-cursor))
    (while (< cursor (. uses length))
      (let slot ([] uses cursor))
      (if (and (>= slot position) (== (/and/ slot 1) 0))
        (= (. ([] intervals id) next-use-cursor) cursor)
        (return slot)
      )
      (+= cursor 1)
    )
    (= (. ([] intervals id) next-use-cursor) cursor)
    (return no-slot)
  )
  (fn-do + write-text _
    (param text MIRText)
    (let out (. text out))
    (call (. out text) "intervals\n")
    (for (in index (..< 0 (. order length)))
      (let id ([] order index))
      (call (. out text) "  V")
      (call (. out unsigned) id)
      (call (. out byte) 46)
      (call (. text reg-class-suffix) (. ([] intervals id) reg-class))
      (call (. out text) " ranges=")
      (let ranges (. ([] intervals id) ranges))
      (let cursor U32)
      (while (< cursor (. ranges length))
        (if (!= cursor 0)
          (call (. out byte) 44)
        )
        (call (. out unsigned) ([] ranges cursor))
        (call (. out byte) 45)
        (call (. out unsigned) ([] ranges (+ cursor 1)))
        (+= cursor 2)
      )
      (call (. out text) " uses=")
      (let uses (. ([] intervals id) uses))
      (for (in position (..< 0 (. uses length)))
        (if (!= position 0)
          (call (. out byte) 44)
        )
        (call (. out unsigned) ([] uses position))
      )
      (if (!= (. ([] intervals id) pinned) no-register)
        (call (. out text) " pinned=")
        (call (. text register-text) (. ([] intervals id) pinned))
      )
      (if (. ([] intervals id) crosses-call)
        (call (. out text) " call")
      )
      (call (. out byte) 10)
    )
    (call (. out text) "copy-preferences\n")
    (for (in id (..< 0 vreg-count))
      (let preferences ([] copy-preferences id))
      (if (== (. preferences length) 0)
        (continue)
      )
      (call (. out text) "  V")
      (call (. out unsigned) id)
      (call (. out byte) 58)
      (for (in index (..< 0 (. preferences length)))
        (call (. out byte) 32)
        (call (. out unsigned) ([] preferences index))
      )
      (call (. out byte) 10)
    )
    (call (. out text) "calls ")
    (for (in index (..< 0 (. call-positions length)))
      (if (!= index 0)
        (call (. out byte) 32)
      )
      (call (. out unsigned) ([] call-positions index))
    )
    (call (. out byte) 10)
    (for (in index (..< 0 (. blocks length)))
      (call (. out text) "live ")
      (call (. text name-text) (. ([] (. function blocks) ([] blocks index)) name))
      (call (. out byte) 32)
      (call (. out unsigned) ([] block-start index))
      (call (. out byte) 45)
      (call (. out unsigned) ([] block-end index))
      (call (. out text) " in=")
      (call listed-ids out ([] live-in index))
      (call (. out text) " out=")
      (call listed-ids out ([] live-out index))
      (call (. out byte) 10)
    )
  )
  (fn-do _ listed-ids _
    (param out TextBuffer)
    (param ids IdList)
    (for (in position (..< 0 (. ids length)))
      (if (!= position 0)
        (call (. out byte) 44)
      )
      (call (. out unsigned) ([] ids position))
    )
  )
)

(fn-do _ reverse-ids _
  (param ids IdList)
  (if (< (. ids length) 2)
    (return)
  )
  (let low U32)
  (let high (- (. ids length) 1))
  (while (< low high)
    (let kept ([] ids low))
    (= ([] (. ids data) low) ([] ids high))
    (= ([] (. ids data) high) kept)
    (+= low 1)
    (-= high 1)
  )
)

(fn-do _ reverse-pairs _
  (param pairs IdList)
  (if (< (. pairs length) 4)
    (return)
  )
  (let low U32)
  (let high (- (. pairs length) 2))
  (while (< low high)
    (let first ([] pairs low))
    (let second ([] pairs (+ low 1)))
    (= ([] (. pairs data) low) ([] pairs high))
    (= ([] (. pairs data) (+ low 1)) ([] pairs (+ high 1)))
    (= ([] (. pairs data) high) first)
    (= ([] (. pairs data) (+ high 1)) second)
    (+= low 2)
    (-= high 2)
  )
)
