(import ./builder)
(import ./bundle)
(import ./compact)
(import ./critical-edge-splitter)
(import ./gc-write-barrier-lowering)
(import ./mir)
(import ./mir-text)
(import ./optimization-passes)
(import ./phi-elimination)
(import ./register-allocator)
(import ./variables-to-registers)
(import /BxCore/BxCore.h)
(import /core/arena)
(import /core/table)
(blank)
(prop + stage-names (list String)
  (=
    (call List
      (block
        (item "decoded")
        (item "pruned")
        (item "mem2reg")
        (item "write-barriers")
        (item "edge-split")
        (item "phi-elimination")
        (item "block-layout")
        (item "local-cleanup")
        (item "cfg-cleanup")
        (item "jump-threading")
        (item "compare-branch-fusion")
        (item "cursor-plan")
        (item "liveness")
        (item "frame-coloring")
        (item "linear-scan")
        (item "rewrite")
        (item "prologue-epilogue")
        (item "register-allocation")
        (item "record")
      )
    )
  )
)

(type + Stage (is U32)
  (variant decoded (= 0))
  (variant pruned (= 1))
  (variant mem2reg (= 2))
  (variant write-barriers (= 3))
  (variant edge-split (= 4))
  (variant phi-elimination (= 5))
  (variant block-layout (= 6))
  (variant local-cleanup (= 7))
  (variant cfg-cleanup (= 8))
  (variant jump-threading (= 9))
  (variant compare-branch-fusion (= 10))
  (variant cursor-plan (= 11))
  (variant liveness (= 12))
  (variant frame-coloring (= 13))
  (variant linear-scan (= 14))
  (variant rewrite (= 15))
  (variant prologue-epilogue (= 16))
  (variant register-allocation (= 17))
  (variant record (= 18))
)

(type + MIRCounts
  (prop + functions U64)
  (prop + blocks U64)
  (prop + instructions U64)
  (prop + frame-bytes U64)
  (prop + max-blocks U64)
  (prop + max-instructions U64)
  (prop + max-frame-bytes U64)
  (fn-do + add _
    (param other MIRCounts)
    (+= functions (. other functions))
    (+= blocks (. other blocks))
    (+= instructions (. other instructions))
    (+= frame-bytes (. other frame-bytes))
    (= max-blocks (if-expr (> (. other max-blocks) max-blocks) (. other max-blocks) max-blocks))
    (= max-instructions (if-expr more-instructions (. other max-instructions) max-instructions))
    (lazy more-instructions (> (. other max-instructions) max-instructions))
    (= max-frame-bytes (if-expr more-frame-bytes (. other max-frame-bytes) max-frame-bytes))
    (lazy more-frame-bytes (> (. other max-frame-bytes) max-frame-bytes))
  )
  (fn-do + add-function _
    (param counts FunctionCounts)
    (+= functions (. counts functions))
    (+= blocks (. counts blocks))
    (+= instructions (. counts instructions))
    (+= frame-bytes (. counts frame-bytes))
    (= max-blocks (if-expr (> (. counts blocks) max-blocks) (. counts blocks) max-blocks))
    (= max-instructions (if-expr more-instructions (. counts instructions) max-instructions))
    (lazy more-instructions (> (. counts instructions) max-instructions))
    (= max-frame-bytes (if-expr more-frame-bytes (. counts frame-bytes) max-frame-bytes))
    (lazy more-frame-bytes (> (. counts frame-bytes) max-frame-bytes))
  )
)

(type + FunctionCounts (is Tuple)
  (prop + functions U64)
  (prop + blocks U64)
  (prop + instructions U64)
  (prop + frame-bytes U64)
)

(type + StageHash (is Tuple)
  (prop + stage Stage)
  (prop + hash U64)
)

(type + FunctionDump (is Tuple)
  (prop + stages (of CPointer StageHash))
  (prop + stage-count U32)
  (prop + text ByteSpan)
)

(type + FunctionPipeline
  ; One worker's path from a built MIR function to its compact record: the passes, register
  ; allocation and encoding, over one function arena that each function resets. A caller fills
  ; `function` through `builder` or a decoder, then lowers and encodes it. With `reference`, it
  ; runs the passes as the reference's backend does, without constant folding, value numbering,
  ; if-conversion, the widths that known bits give, the promotion of narrow accesses, the
  ; forwarding of frame stores, the folding of addresses, the combining of instructions, the
  ; narrower roots, the threading of jumps through conditions other than equality, the coalescing
  ; of copies and call registers, the loads and stores that copies of spilled values become, the
  ; computing again of cheap values in place of spilling them, the registers spilled values are
  ; given between calls or the folding of branches after allocation, so that a bundle the
  ; reference captured lowers to the reference's object, as the backend comparison needs.
  (blank)
  (prop + bundle Bundle)
  (prop + function MIRFunction)
  (prop + builder MIRBuilder)
  (prop + results Arena)
  (prop + through Stage (= .record))
  (prop + dumps-stages Bool)
  (prop + built MIRCounts)
  (prop + allocated MIRCounts)
  (prop + counted FunctionCounts)
  (prop _ mem2reg MIRVariablesToRegisters)
  (prop _ constant-folding MIRConstantFoldingPass)
  (prop _ value-numbering MIRValueNumberingPass)
  (prop _ if-conversion MIRIfConversionPass)
  (prop _ barrier-lowering MIRGCWriteBarrierLowering)
  (prop _ edge-splitter MIRCriticalEdgeSplitter)
  (prop _ phi-elimination MIRPhiElimination)
  (prop _ block-layout MIRBlockLayoutPass)
  (prop _ local-cleanup MIRLocalCleanupPass)
  (prop _ cfg-cleanup MIRCFGCleanupPass)
  (prop _ jump-threading MIRJumpThreadingPass)
  (prop _ compare-branch-fusion MIRCompareBranchFusionPass)
  (prop _ branch-folding MIRBranchFoldingPass)
  (prop _ address-folding MIRAddressFoldingPass)
  (prop _ combining MIRInstructionCombiningPass)
  (prop _ frame-forwarding MIRFrameForwardingPass)
  (prop _ allocator MIRRegisterAllocator)
  (prop _ encoder FunctionEncoder)
  (prop _ text MIRText)
  (prop _ kept TextBuffer)
  (prop _ stages (of Array StageHash))
  (prop _ stage-count U32)
  (prop _ keeps-text Bool)
  (prop _ reference Bool)
  (fn-do + This _
    (param bundle Bundle)
    (param through Stage (= .record))
    (param dumps-stages Bool (= false))
    (param reference Bool (= false))
    (= (. function pool-size) (. bundle string-count))
    (blank)
    (lazy builder (call MIRBuilder bundle function))
    (lazy mem2reg (call MIRVariablesToRegisters builder (not reference)))
    (lazy constant-folding (call MIRConstantFoldingPass builder))
    (lazy value-numbering (call MIRValueNumberingPass builder))
    (lazy if-conversion (call MIRIfConversionPass builder))
    (lazy barrier-lowering (call MIRGCWriteBarrierLowering builder))
    (lazy edge-splitter (call MIRCriticalEdgeSplitter builder))
    (lazy phi-elimination (call MIRPhiElimination builder))
    (lazy block-layout (call MIRBlockLayoutPass builder))
    (lazy local-cleanup (call MIRLocalCleanupPass builder (not reference)))
    (lazy cfg-cleanup (call MIRCFGCleanupPass builder))
    (lazy jump-threading (call MIRJumpThreadingPass builder (not reference)))
    (lazy compare-branch-fusion (call MIRCompareBranchFusionPass builder))
    (lazy branch-folding (call MIRBranchFoldingPass builder))
    (lazy address-folding (call MIRAddressFoldingPass builder))
    (lazy combining (call MIRInstructionCombiningPass builder))
    (lazy frame-forwarding (call MIRFrameForwardingPass builder))
    (lazy allocator (call MIRRegisterAllocator builder (not reference) (not reference) (not reference) (not reference)))
    (lazy encoder (call FunctionEncoder bundle function results))
    (lazy text (call MIRText bundle function))
    (lazy stages (call (of Array StageHash) 32))
  )
  (fn-do + release _
    (call (. function release))
    (call (. results release))
  )
  (fn-do + begin _
    (param keeps-stage-text Bool)
    (= stage-count 0)
    (= keeps-text keeps-stage-text)
    (call (. kept clear))
    (= counted (call FunctionCounts))
  )
  (fn-do + lower Bool
    (if (call ends .decoded)
      (return false)
    )
    (if (. function is-lowered)
      (return true)
    )
    (call (. builder adopt))
    (call (. builder validate))
    (call count-function false)
    (call (. builder prune-unreachable-blocks))
    (if (call ends .pruned)
      (return false)
    )
    (call (. mem2reg run))
    (if (call ends .mem2reg)
      (return false)
    )
    (if (not reference)
      (call (. constant-folding run))
      (call (. value-numbering run))
      (call (. if-conversion run))
    )
    (call (. barrier-lowering run))
    (if (call ends .write-barriers)
      (return false)
    )
    (call (. edge-splitter run))
    (if (call ends .edge-split)
      (return false)
    )
    (call (. phi-elimination run))
    (if (call ends .phi-elimination)
      (return false)
    )
    (call (. block-layout run))
    (if (call ends .block-layout)
      (return false)
    )
    (call (. local-cleanup run))
    (if (call ends .local-cleanup)
      (return false)
    )
    (if (call (. cfg-cleanup run))
      (call (. local-cleanup run))
    )
    (if (call ends .cfg-cleanup)
      (return false)
    )
    (if (call (. jump-threading run))
      (call (. local-cleanup run))
      (if (call (. cfg-cleanup run))
        (call (. local-cleanup run))
      )
    )
    (if (call ends .jump-threading)
      (return false)
    )
    (call (. compare-branch-fusion run))
    (if (call ends .compare-branch-fusion)
      (return false)
    )
    (blank)
    (if (. function uses-table-union-cursor-plan)
      (call (. local-cleanup run))
      (call (. compare-branch-fusion run))
      (call (. allocator form-post-indexed-loads))
      (call (. function forget-use-counts))
      (if (call ends .cursor-plan)
        (return false)
      )
    )
    (if (not reference)
      (if (call (. frame-forwarding run))
        (call (. local-cleanup run))
      )
      (call (. address-folding run))
      (if (call (. combining run))
        (call (. local-cleanup run))
      )
    )
    (call (. function forget-use-counts))
    (call (. allocator liveness run))
    (if (call ends .liveness)
      (return false)
    )
    (call (. allocator coloring plan))
    (if (call ends .frame-coloring)
      (return false)
    )
    (call (. allocator begin))
    (call (. allocator scan-intervals))
    (if (call ends .linear-scan)
      (return false)
    )
    (call (. allocator rewrite))
    (if (call ends .rewrite)
      (return false)
    )
    (call (. allocator finish-frame))
    (if (call ends .prologue-epilogue)
      (return false)
    )
    (call (. allocator remove-panic-check-fallthrough-branches))
    (if (not reference)
      (call (. branch-folding run))
      (call (. block-layout rewrite-fallthrough-branches))
    )
    (if (call ends .register-allocation)
      (return false)
    )
    (call count-function true)
    (call (. builder validate))
    (return true)
  )
  (fn-do + encode CompactFunction
    (let compact (call (. encoder encode)))
    (if dumps-stages
      (call (. text out clear))
      (call compact-record-text (. text out) bundle compact)
      (call keep-stage .record)
    )
    (return compact)
  )
  (fn-do + finished-dump FunctionDump
    (let hashes (call (of (. results allocate) StageHash) stage-count))
    (for (in index (..< 0 stage-count))
      (= ([] hashes index) ([] stages index))
    )
    (let kept-text ByteSpan)
    (if keeps-text
      (let copy (call (. results allocate-raw) (. kept length)))
      (call C:brixArrayCopySlice copy (. kept bytes data) (. kept length))
      (= kept-text (call ByteSpan copy (. kept length)))
    )
    (return (call FunctionDump hashes stage-count kept-text))
  )
  (fn-do _ count-function _
    (param is-allocated Bool)
    (let blocks U64 (. function block-order length))
    (let instructions U64 (call (. builder instruction-count)))
    (let frame-bytes U64 (. function frame-bytes))
    (let counts (call FunctionCounts 1 blocks instructions frame-bytes))
    (if is-allocated
      (probe-log lang.backend.mir.alloc (items: (. function order) blocks instructions frame-bytes))
      (call (. allocated add-function) counts)
      (= counted counts)
      (else
        (probe-log lang.backend.mir.pre (items: (. function order) blocks instructions frame-bytes))
        (call (. built add-function) counts)
      )
    )
  )
  (fn-do _ ends Bool
    (param stage Stage)
    (if dumps-stages
      (call (. text out clear))
      (call (. text function-text))
      (if (== stage .liveness)
        (call (. allocator liveness write-text) text)
        (else-if (== stage .linear-scan)
          (call (. allocator scan write-text) text)
        )
      )
      (call keep-stage stage)
    )
    (return (== through stage))
  )
  (fn-do _ keep-stage _
    (param stage Stage)
    (= ([] stages stage-count) (call StageHash stage (. text out hash)))
    (+= stage-count 1)
    (if keeps-text
      (call (. kept text) "== ")
      (call (. kept text) ([] stage-names stage))
      (call (. kept byte) 10)
      (call (. kept span) (call ByteSpan (. text out bytes data) (. text out length)))
    )
  )
)
