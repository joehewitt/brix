+ order U32
+ label StringId
+ symbol StringId
+ is-lowered Bool
+ string-count U32
+ word-count U32
+ strings CPointer'U32
+ words CPointer'I32

━━━━━━━━━━━━━━━━━━━━
+ StringPool is Tuple

` A copy of a bundle's pool of strings, read by id after the bundle is gone.

+ starts CPointer'U32
+ bytes CPointer'Byte
+ count U32

────────────────────
+ string ByteSpan @inline
    - id StringId

ByteSpan(bytes + starts[id], starts[id + 1] - starts[id])

━━━━━━━━━━━━━━━━━━━━
+ Bundle
    is Usable'Void

+ gc-enabled Bool
+ stack-trace-metadata Bool
+ apple-abi Bool
+ output-mode U32
+ gc-allocation-buffer-version U32
+ gc-control-phase-mask U32
+ string-count U32
+ entry-name StringId = no-string
+ main-name StringId = no-string
+ gc-public-control-word-symbol StringId = no-string
+ write-barrier-record-symbol StringId = no-string
+ zero-stack-frame-symbol StringId = no-string
+ memory-copy-symbol StringId = no-string
+ memory-zero-symbol StringId = no-string
+ bulk-write-barrier-symbol StringId = no-string
+ thread-cache-symbol StringId = no-string
+ allocation-refill-symbol StringId = no-string
+ allocate-object-symbol StringId = no-string
+ safepoint-free IdList
+ inferred-safepoint-free IdList
+ cold-callees IdList
+ literals Table'StringLiteral
+ numbers Table'NumberConstant
+ constant-tables Table'ConstantTable
+ constant-items Table'ConstantItem
+ globals Table'GlobalData
+ gc-roots Table'GCRootRecord
+ functions Table'FunctionRecord
_ arena Arena
_ words CPointer'U32
_ word-count Size
_ cursor Size
_ string-starts CPointer'U32
_ string-base CPointer'Byte
_ symbol-flags CPointer'Byte
_ string-capacity U32
_ byte-length U32
_ byte-capacity U32
_ interned CPointer'U32
_ interned-capacity U32
_ released Bool

────────────────────
+ This

.. literals = Table'StringLiteral(arena, 256)
.. numbers = Table'NumberConstant(arena, 64)
.. constant-tables = Table'ConstantTable(arena, 256)
.. constant-items = Table'ConstantItem(arena, 1024)
.. globals = Table'GlobalData(arena, 64)
.. gc-roots = Table'GCRootRecord(arena, 64)
.. functions = Table'FunctionRecord(arena, 1024)

────────────────────
+ begin-using

this

────────────────────
+ do end-using

release()

────────────────────
+ do release

if !released
    arena.release()
    released = true

────────────────────
+ string ByteSpan @inline
    - id StringId

ByteSpan(string-base + start, string-starts[id + 1] - start)

.. start = string-starts[id]

────────────────────
+ non-empty StringId
    - id StringId

if id != no-string && string-starts[id + 1] == string-starts[id] then no-string else id

────────────────────
+ string-facts U32 @inline
    - id StringId

(symbol-flags[id] as U32) /or/ (if string-starts[id + 1] == string-starts[id] then 256u32 else 0u32)

────────────────────
+ text String
    - id StringId

Array'Byte(span.data, span.length).slice-string(0 .. < span.length)

.. span = string(id)

────────────────────
+ is-safepoint-free Bool @inline
    - symbol StringId

(symbol-flags[symbol] /and/ safepoint-free-flag) != 0

────────────────────
+ is-inferred-safepoint-free Bool @inline
    - symbol StringId

(symbol-flags[symbol] /and/ inferred-safepoint-free-flag) != 0

────────────────────
+ is-memory-copy-callee Bool @inline
    - symbol StringId

symbol != no-string && (symbol-flags[symbol] /and/ memory-copy-callee-flag) != 0

────────────────────
+ is-safe-struct-callee Bool @inline
    - symbol StringId

symbol != no-string && (symbol-flags[symbol] /and/ safe-struct-callee-flag) != 0

────────────────────
_ do find-string StringId
    - text String

for id in 0 .. < string-count
    if string-starts[id + 1] - string-starts[id] == text.size
        if C:memcmp(string-base + string-starts[id], text as CPointer'Byte, text.size) == 0
            = id
= no-string

────────────────────
+ do begin-building

` Starts a bundle built in memory rather than read from a file. Its strings are interned as
` they are named and its manifest tables are appended to directly; the pool must be whole
` before any worker reads it.
string-capacity = 256
byte-capacity = 16384
interned-capacity = 1024
string-starts = arena.allocate'U32(string-capacity + 1)
string-base = arena.allocate-raw(byte-capacity)
symbol-flags = arena.allocate'Byte(string-capacity)
interned = arena.allocate'U32(interned-capacity)
entry-name = intern("entry")
main-name = intern("main")

────────────────────
+ do intern StringId
    - text String

= intern-span(ByteSpan(text, text.size))

────────────────────
+ do intern-span StringId
    - span ByteSpan

` The id of a string of a bundle built in memory, added to the pool on first sight.
. hash = fnv-hash(span.data, span.length)
. mask = interned-capacity - 1
. slot = ((hash /xor/ (hash /zrshift/ 32)) /and/ mask) as U32
while interned[slot] != 0
    . id = interned[slot] - 1
    . start = string-starts[id]
    if string-starts[id + 1] - start == span.length
        if C:memcmp(string-base + start, span.data, span.length) == 0
            = id
    slot = (slot + 1) /and/ mask
. id = add-string(span)
interned[slot] = id + 1
if string-count * 2 > interned-capacity
    grow-interned()
= id

────────────────────
+ do found StringId
    - span ByteSpan

` The id of a string the pool holds, found by its bytes without adding it, or none. Workers
` may ask while the pool is whole.
. hash = fnv-hash(span.data, span.length)
. mask = interned-capacity - 1
. slot = ((hash /xor/ (hash /zrshift/ 32)) /and/ mask) as U32
while interned[slot] != 0
    . id = interned[slot] - 1
    . start = string-starts[id]
    if string-starts[id + 1] - start == span.length
        if C:memcmp(string-base + start, span.data, span.length) == 0
            = id
    slot = (slot + 1) /and/ mask
= no-string

────────────────────
+ do copied-pool StringPool
    - arena Arena

` The pool of strings as it stands, copied into an arena that outlives the bundle.
. starts = arena.allocate'U32(string-count + 1)
C:memcpy(starts as CPointer'Byte, string-starts as CPointer'Byte, ((string-count + 1) as Size) * 4)
. bytes = arena.allocate-raw(if byte-length != 0 then byte-length else 1)
C:memcpy(bytes, string-base, byte-length as Size)
= StringPool(starts, bytes, string-count)

────────────────────
_ do add-string StringId
    - span ByteSpan

. id = string-count
if id == string-capacity
    . capacity = string-capacity * 2
    . starts = arena.allocate'U32(capacity + 1)
    . flags = arena.allocate'Byte(capacity)
    for index in 0 .. < string-capacity
        starts[index] = string-starts[index]
        flags[index] = symbol-flags[index]
    string-starts = starts
    symbol-flags = flags
    string-capacity = capacity
. length U32 = span.length as U32
if byte-length + length > byte-capacity
    . capacity = byte-capacity * 2
    while byte-length + length > capacity
        capacity *= 2
    . bytes = arena.allocate-raw(capacity)
    C:memcpy(bytes, string-base, byte-length)
    string-base = bytes
    byte-capacity = capacity
C:memcpy(string-base + byte-length, span.data, length)
string-starts[id] = byte-length
byte-length += length
string-starts[id + 1] = byte-length
string-count = id + 1
= id

────────────────────
_ do grow-interned

. capacity = interned-capacity * 2
. slots = arena.allocate'U32(capacity)
. mask = capacity - 1
for id in 0 .. < string-count
    . span = string(id)
    . hash = fnv-hash(span.data, span.length)
    . slot = ((hash /xor/ (hash /zrshift/ 32)) /and/ mask) as U32
    while slots[slot] != 0
        slot = (slot + 1) /and/ mask
    slots[slot] = id + 1
interned = slots
interned-capacity = capacity

────────────────────
+ do mark-safepoint-free
    - symbol StringId

` Names a callee that never enters the runtime's safepoint protocol.
if !is-safepoint-free(symbol)
    safepoint-free = safepoint-free.appended(arena, symbol)
    symbol-flags[symbol] = symbol-flags[symbol] /or/ safepoint-free-flag

────────────────────
+ do note-alignments

` Records how far each data symbol the bundle defines is aligned, up to eight bytes, so that an
` access takes a symbol's page offset only where the linker can scale it by the access's size.
for literal in literals
    note-alignment(literal.name, 8)
for number in numbers
    note-alignment(number.name, number.size)
for table in constant-tables
    note-alignment(table.name, table.alignment)
for global in globals
    note-alignment(global.name, global.alignment)

────────────────────
_ do note-alignment
    - symbol StringId
    - alignment U32

if symbol >= string-count
    =
. power U32
while power < 3 && (2u32 /lshift/ power) <= alignment
    power += 1
symbol-flags[symbol] = (symbol-flags[symbol] /and/ known-flags) /or/ alignment-bits
.. alignment-bits = ((power + 1) as Byte) /lshift/ alignment-shift

────────────────────
+ symbol-alignment U32 @inline
    - symbol StringId

` How far a data symbol is aligned, or 0 for one whose alignment the bundle does not know.
|? symbol >= string-count || code == 0
    0
??
    1u32 /lshift/ (code - 1)

.. code = (symbol-flags[symbol] /zrshift/ alignment-shift) as U32

────────────────────
+ do mark-cold-callee
    - symbol StringId

` Names a callee that a block calls only on its way to a panic, so that block layout places the
` block after the code that runs. A bundle read from a file names none.
cold-callees = cold-callees.appended(arena, symbol)

────────────────────
+ do is-cold-callee Bool
    - symbol StringId

for index in 0 .. < cold-callees.length
    if cold-callees[index] == symbol
        = true
= false

────────────────────
+ do mark-memory-copy-callee
    - symbol StringId

symbol-flags[symbol] = symbol-flags[symbol] /or/ memory-copy-callee-flag

────────────────────
+ do mark-safe-struct-callee
    - symbol StringId

symbol-flags[symbol] = symbol-flags[symbol] /or/ safe-struct-callee-flag

────────────────────
+ do copy-bytes ByteSpan
    - span ByteSpan

` A copy of bytes that lives as long as the bundle, for a literal a worker's arena held.
. bytes = arena.allocate-raw(if span.length != 0 then span.length else 1)
C:memcpy(bytes, span.data, span.length)
= ByteSpan(bytes, span.length)

────────────────────
+ do load ?! Error
    - path String

read-file(path)
cursor = 0
?! Error("$path is not a backend bundle")
    if next() != bundle-magic
. version = next()
?! Error("Backend bundle version $version is not $bundle-version")
    if version != bundle-version
. flags = next()
gc-enabled = (flags /and/ 1) != 0
stack-trace-metadata = (flags /and/ 2) != 0
output-mode = next()
read-string-pool()
entry-name = find-string("entry")
main-name = find-string("main")
safepoint-free = read-symbol-set()
inferred-safepoint-free = read-symbol-set()
read-runtime-symbols()
flag-symbols()
flag-symbol-set(memory-copy-callee-flag)
flag-symbol-set(safe-struct-callee-flag)
read-manifest()
read-functions()
?! Error("$path has ${word-count - cursor} words after its last function")
    if cursor != word-count

────────────────────
_ do read-file ?! Error
    - path String

. location Path = path
. size Size = location.size
?! Error("$path is not a backend bundle")
    if size < 24 || size % 4 != 0
. file = use File(path)
. data = arena.allocate-raw(size, 8)
. contents = Array'Byte(data, size)
. filled Size = 0
while filled < size
    . wanted = size - filled
    if wanted > read-chunk-size
        wanted = read-chunk-size
    . count = file.read(wanted, contents[filled ...])
    if count == 0
        break
    filled += count
?! Error("$path changed while it was read")
    if filled != size
words = data as CPointer'U32
word-count = size / 4

────────────────────
_ do next U32 @inline

?! Panic("The backend bundle is truncated")
    if cursor >= word-count
. value = words[cursor]
cursor += 1
= value

────────────────────
_ do next-u64 U64

. low U64 = next()
. high U64 = next()
= low /or/ (high /lshift/ 32)

────────────────────
_ do next-string StringId

. id = next()
?! Panic("The backend bundle names string $id of $string-count")
    if id >= string-count
= id

────────────────────
_ do skip-bytes ByteSpan
    - length Size

. span = ByteSpan((words + cursor) as CPointer'Byte, length)
cursor += (length + 3) / 4
?! Panic("The backend bundle is truncated")
    if cursor > word-count
= span

────────────────────
_ do read-string-pool

string-count = next()
. total Size = next()
. starts = arena.allocate'U32(string-count + 1)
. offset U32
for index in 0 .. < string-count
    starts[index] = offset
    offset += next()
starts[string-count] = offset
?! Panic("The backend bundle's string pool is inconsistent")
    if offset != total
string-starts = starts
string-base = skip-bytes(total).data

────────────────────
_ do read-symbol-set IdList

. count = next()
. symbols = new-id-list(arena, count)
for _ in 0 .. < count
    symbols = symbols.appended(arena, next-string())
= symbols

────────────────────
_ do read-runtime-symbols

. symbols = read-symbol-set()
?! Panic("The backend bundle names ${symbols.length} runtime symbols, not $runtime-symbol-count")
    if symbols.length != runtime-symbol-count
gc-public-control-word-symbol = symbols[0]
write-barrier-record-symbol = symbols[1]
zero-stack-frame-symbol = symbols[2]
bulk-write-barrier-symbol = symbols[3]

────────────────────
_ do flag-symbols

. flags = arena.allocate'Byte(string-count)
for index in 0 .. < safepoint-free.length
    . symbol = safepoint-free[index]
    flags[symbol] = flags[symbol] /or/ safepoint-free-flag
for index in 0 .. < inferred-safepoint-free.length
    . symbol = inferred-safepoint-free[index]
    flags[symbol] = flags[symbol] /or/ inferred-safepoint-free-flag
symbol-flags = flags

────────────────────
_ do flag-symbol-set
    - flag Byte

for _ in 0 .. < next()
    . symbol = next-string()
    symbol-flags[symbol] = symbol-flags[symbol] /or/ flag

────────────────────
_ do read-manifest

for _ in 0 .. < next()
    . name = next-string()
    . character-length = next()
    . flags = next()
    . length = next()
    literals.append(StringLiteral(name, character-length, flags, skip-bytes(length)))
for _ in 0 .. < next()
    . name = next-string()
    . size = next()
    numbers.append(NumberConstant(name, size, next-u64()))
for _ in 0 .. < next()
    . name = next-string()
    . alignment = next()
    . count = next()
    constant-tables.append
        - ConstantTable(name, alignment, Span(constant-items.length as U32, count))
    for _ in 0 .. < count
        constant-items.append(read-constant())
for _ in 0 .. < next()
    . name = next-string()
    . size = next()
    globals.append(GlobalData(name, size, next()))
for _ in 0 .. < next()
    . kind = next() as GCRootKind
    . symbol = next()
    gc-roots.append(GCRootRecord(kind, symbol, next-string()))
gc-allocation-buffer-version = next()
gc-control-phase-mask = next()

────────────────────
_ do read-constant ConstantItem

. kind = next() as ConstantKind
= match kind
    |= .string-constant
        ConstantItem(kind, 0, next-string())
    |= .label-constant
        ConstantItem(kind, 0, next-string())
    |= .quad-constant
        ConstantItem(kind, next-u64(), no-string)
    ??
        ConstantItem(kind, next(), no-string)

────────────────────
_ do read-functions

for _ in 0 .. < next()
    . order = next()
    . label = next-string()
    . symbol = next-string()
    . is-lowered = next() != 0
    . job-string-count = next()
    . job-word-count = next()
    . strings = words + cursor
    cursor += job-string-count
    . job-words = (words + cursor) as CPointer'I32
    cursor += job-word-count
    ?! Panic("The backend bundle is truncated")
        if cursor > word-count
    functions.append
        FunctionRecord
            - order
            - label
            - symbol
            - is-lowered
            - job-string-count
            - job-word-count
            - strings
            - job-words

━━━━━━━━━━━━━━━━━━━━
+ do read-bundle Bundle ?! Error
    - path String

. bundle = Bundle()
bundle.load(path)
= bundle
