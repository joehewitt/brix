./mir
/core/arena
/core/table
/os/file
/os/path
/string.h

_ bundle-magic U32 = 0x42424d59
_ bundle-version U32 = 1
_ read-chunk-size Size = 67108864
_ runtime-symbol-count U32 = 4
_ safepoint-free-flag Byte = 1
_ inferred-safepoint-free-flag Byte = 2
_ memory-copy-callee-flag Byte = 4
_ safe-struct-callee-flag Byte = 8
_ known-flags Byte = 15
_ alignment-shift Byte = 4

━━━━━━━━━━━━━━━━━━━━
+ ConstantKind is U32

| byte-constant = 0
| short-constant = 1
| long-constant = 2
| quad-constant = 3
| string-constant = 4
| label-constant = 5

━━━━━━━━━━━━━━━━━━━━
+ GCRootKind is U32

| global-root = 0
| task-local-root = 1
| thread-local-root = 2

━━━━━━━━━━━━━━━━━━━━
+ StringLiteral is Struct

+ name StringId
+ character-length U32
+ flags U32
+ bytes ByteSpan

━━━━━━━━━━━━━━━━━━━━
