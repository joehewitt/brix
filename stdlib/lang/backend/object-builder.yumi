━━━━━━━━━━━━━━━━━━━━
+ do check-layout
    - value U64

?! Panic("Object layout value $value is out of range")
    if value >= layout-limit

━━━━━━━━━━━━━━━━━━━━
+ do align-value U64
    - value U64
    - alignment U64

check-layout(value)
if alignment <= 1
    = value
= (value + alignment - 1) /and/ ((alignment - 1) /xor/ U64.max)

