/core/arena
/core/table
/string.h

_ gc-roots-magic U32 = 0x52594359
_ trace-magic U32 = 0x43525459
_ gc-map-magic U32 = 0x4d434759
_ pads-magic U32 = 0x44415059
_ pads-header-size U32 = 16
_ pads-record-size U32 = 16
_ trace-header-size U32 = 24
_ trace-record-size U32 = 40
_ gc-function-record-size U32 = 32
_ gc-location-size U32 = 12
_ layout-limit U64 = 0x80000000

━━━━━━━━━━━━━━━━━━━━
+ ObjectBuilder
    is Usable'Void

` The format-independent part of writing an object: its sections' data and relocations, and its
` symbols, ordered locals first, then defined externals, then undefined symbols. Symbol values are
` offsets in their sections.

+ sections [ObjectSection]
+ symbols Table'ObjectSymbol
+ symbol-order CPointer'U32
+ string-table ByteSpan
+ local-count U32
+ external-count U32
+ undefined-count U32
+ arena Arena

_ bundle Bundle
_ symbol-rows CPointer'U32
_ descriptor-indexes CPointer'U32
_ descriptors IdList
_ released Bool

────────────────────
+ This
    - bundle Bundle

symbol-rows = arena.allocate'U32(bundle.string-count)
sections += ObjectSection(2, false, arena)
sections += ObjectSection(0, false, arena)
sections += ObjectSection(3, false, arena)
sections += ObjectSection(3, false, arena)
sections += ObjectSection(3, false, arena)
sections += ObjectSection(3, false, arena)
sections += ObjectSection(3, false, arena)
sections += ObjectSection(3, true, arena)

.. symbols = Table'ObjectSymbol(arena, 1024)

────────────────────
+ begin-using

this

────────────────────
+ do end-using

release()

────────────────────
+ do release

if !released
    arena.release()
    released = true

────────────────────
+ do build
    - functions CPointer'CompactFunction
    - ordered [U32]

emit-data-sections()
if bundle.gc-enabled
    emit-gc-root-metadata()
emit-text-section(functions, ordered)
if bundle.stack-trace-metadata
    emit-trace-metadata(functions, ordered)
if bundle.gc-enabled
    emit-gc-map-metadata(functions, ordered)
emit-pad-metadata(functions, ordered)
symbol-order = finalize-symbols()
string-table = build-string-table(symbol-order)

────────────────────
+ section ObjectSection
    - index U32

sections[index - 1]

────────────────────
+ symbol-name ByteSpan
    - symbol ObjectSymbol

bundle.string(symbol.name)

────────────────────
_ do emit-data-sections

. data = BinaryWriter(arena, 65536)
for literal in bundle.literals
    data.align(8)
    data.u64(literal.bytes.length as U64)
    data.u32(literal.character-length)
    data.u32(literal.flags)
    define-symbol(literal.name, SectionId.const, data.length as U64, false)
    data.bytes(literal.bytes)
    data.u8(0)
for number in bundle.numbers
    data.align(number.size)
    define-symbol(number.name, SectionId.const, data.length as U64, false)
    if number.size == 8
        data.u64(number.bits)
    else
        data.u32((number.bits /and/ 0xffffffff) as U32)
for table in bundle.constant-tables
    data.align(table.alignment)
    define-symbol(table.name, SectionId.const, data.length as U64, false)
    for index in table.items.start .. < table.items.end
        . item = bundle.constant-items[index]
        . kind = item.kind
        if kind == .byte-constant
            data.u8((item.bits /and/ 0xff) as U32)
        else if kind == .short-constant
            data.u16((item.bits /and/ 0xffff) as U32)
        else if kind == .long-constant
            data.u32((item.bits /and/ 0xffffffff) as U32)
        else if kind == .quad-constant
            data.u64(item.bits)
        else if kind == .string-constant
            data.bytes(bundle.string(item.name))
            data.u8(0)
        else
            . offset U32 = data.length as U32
            data.u64(0)
            add-relocation(SectionId.const, offset, item.name, .unsigned-relocation)
finish-section(SectionId.const, data)

. bss = section(SectionId.bss)
. globals-external = bundle.output-mode == 0
for global in bundle.globals
    bss.size = align-value(bss.size, global.alignment)
    define-symbol(global.name, SectionId.bss, bss.size, globals-external)
    bss.size += global.size

────────────────────
_ do emit-gc-root-metadata

. writer = BinaryWriter(arena, 4096)
. count U32 = bundle.gc-roots.length as U32
writer.u32(gc-roots-magic)
writer.u16(1)
writer.u16(8)
writer.u32(count)
writer.u32(0)
for record in bundle.gc-roots
    . kind U32 = record.kind
    writer.u8(kind + 1)
    writer.u8(0)
    writer.u16(0)
    writer.u32(0)
    . symbol = bundle.non-empty(record.symbol)
    if symbol != no-string
        add-relocation(SectionId.gc-roots, writer.length as U32, symbol, .unsigned-relocation)
    writer.u64(0)
    add-relocation
        - SectionId.gc-roots
        - writer.length as U32
        - record.descriptor
        - .unsigned-relocation
    writer.u64(0)
finish-section(SectionId.gc-roots, writer)

────────────────────
_ do emit-text-section
    - functions CPointer'CompactFunction
    - ordered [U32]

. count = ordered.length
. starts = arena.allocate'U32(count)
. size U64
for index in 0 .. < count
    . compact = functions[ordered[index]]
    starts[index] = size as U32
    define-symbol(compact.symbol, SectionId.text, size, compact.is-external)
    . row = symbol-rows[compact.symbol] - 1
    symbols[row].size = compact.code.length as U64
    symbols[row].is-function = true
    for position in 0 .. < compact.jump-table-count
        . table = compact.jump-tables[position]
        define-symbol(table.name, SectionId.text, size + table.offset, false)
    size += compact.code.length
check-layout(size)

. data = arena.allocate-raw(size as Size, 8)
for index in 0 .. < count
    . compact = functions[ordered[index]]
    . start = starts[index]
    C:memcpy(data + start, compact.code.data, compact.code.length)
    for position in 0 .. < compact.relocation-count
        . relocation = compact.relocations[position]
        . offset = start + relocation.offset
        . row = symbol-rows[relocation.symbol]
        if is-branch26-relocation(relocation.kind) && row != 0 && targets-text
            . target I64 = symbols[row - 1].value as I64
            . source I64 = offset
            patch-local-branch((data + offset) as CPointer'U32, target - source)
        else
            add-relocation(SectionId.text, offset, relocation.symbol, relocation.kind)
        .. targets-text = symbols[row - 1].section == SectionId.text
. text = section(SectionId.text)
text.data = ByteSpan(data, size as Size)
text.size = size

────────────────────
_ do patch-local-branch
    - word CPointer'U32
    - delta I64

?! Panic("Unaligned local branch delta $delta")
    if delta % 4 != 0
. immediate = delta / 4
?! Panic("Local branch is out of range: $delta")
    if immediate < -33554432 || immediate > 33554431
word[0] = (word[0] /and/ 0xfc000000) /or/ ((immediate as U32) /and/ 0x03ffffff)

────────────────────
_ do emit-trace-metadata
    - functions CPointer'CompactFunction
    - ordered [U32]

. strings = StringOffsets(bundle, arena)
. records = BinaryWriter(arena, 65536)
. lines = BinaryWriter(arena, 65536)
. record-count U32
. line-count U32
for index in 0 .. < ordered.length
    . compact = functions[ordered[index]]
    if compact.code.length == 0
        continue
    . file-offset = strings.add-file(compact.source-file)
    . first-line = line-count
    for position in 0 .. < compact.line-record-count
        . line = compact.line-records[position]
        . line-file = strings.add-file(line.file)
        lines.u32(line.pc-offset)
        lines.u32(line-file)
        lines.i32(line.line)
        lines.u16(line.column as U32)
        lines.u16(0)
        line-count += 1
    . name-offset = strings.add(compact.display-name)
    . record-offset = trace-header-size + record-count * trace-record-size
    add-relocation(SectionId.trace, record-offset, compact.symbol, .unsigned-relocation)
    records.u64(0)
    records.u32(compact.code.length as U32)
    records.u32(name-offset)
    records.u32(file-offset)
    records.i32(compact.source-line)
    records.i32(compact.source-column)
    records.u32(first-line)
    records.u32(line-count - first-line)
    records.u32(0)
    record-count += 1

. writer = BinaryWriter
    - arena
    - trace-header-size + records.length + lines.length + strings.strings.length
writer.u32(trace-magic)
writer.u16(2)
writer.u16(0)
writer.u32(record-count)
writer.u32(line-count)
writer.u32(strings.file-count)
writer.u32(strings.strings.length as U32)
writer.bytes(records.view)
writer.bytes(lines.view)
writer.bytes(strings.strings.view)
finish-section(SectionId.trace, writer)

────────────────────
_ do emit-pad-metadata
    - functions CPointer'CompactFunction
    - ordered [U32]

` Each function's checked calls, by return address, with the landing pad a panic returned to
` that address goes to: a header, a record for each function that has any, giving its address,
` its first entry and how many it has, then the entries as offsets in the function.
. records = BinaryWriter(arena, 4096)
. entries = BinaryWriter(arena, 65536)
. function-symbols = IdList()
. entry-count U32
for index in 0 .. < ordered.length
    . compact = functions[ordered[index]]
    if compact.code.length == 0 || compact.pad-count == 0
        continue
    records.u64(0)
    records.u32(entry-count)
    records.u32(compact.pad-count)
    for position in 0 .. < compact.pad-count
        . pad = compact.pads[position]
        entries.u32(pad.return-offset)
        entries.u32(pad.pad-offset)
    entry-count += compact.pad-count
    function-symbols = function-symbols.appended(arena, compact.symbol)

if function-symbols.length == 0
    =

. writer = BinaryWriter(arena, pads-header-size + records.length + entries.length)
writer.u32(pads-magic)
writer.u16(1)
writer.u16(0)
writer.u32(function-symbols.length)
writer.u32(entry-count)
for index in 0 .. < function-symbols.length
    add-relocation
        - SectionId.pads
        - pads-header-size + index * pads-record-size
        - function-symbols[index]
        - .unsigned-relocation
writer.bytes(records.view)
writer.bytes(entries.view)
finish-section(SectionId.pads, writer)

────────────────────
_ do emit-gc-map-metadata
    - functions CPointer'CompactFunction
    - ordered [U32]

. function-records = BinaryWriter(arena, 65536)
. safepoint-records = BinaryWriter(arena, 65536)
. location-records = BinaryWriter(arena, 65536)
. saved-records = BinaryWriter(arena, 4096)
. run = BinaryWriter(arena, 4096)
. runs = LocationRuns(arena)
. function-symbols = IdList()
. function-count U32
. safepoint-count U32
. location-count U32
. saved-count U32
descriptor-indexes = arena.allocate'U32(bundle.string-count)
descriptors = IdList()

for index in 0 .. < ordered.length
    . compact = functions[ordered[index]]
    if compact.code.length == 0
        continue
    . first-safepoint = safepoint-count
    for position in 0 .. < compact.safepoint-count
        . safepoint = compact.safepoints[position]
        run.clear()
        for offset in 0 .. < safepoint.location-count
            . location = compact.locations[safepoint.first-location + offset]
            run.u8(location.kind)
            run.u8(location.register)
            run.u16(0)
            run.i32(location.offset)
            run.u32(descriptor-index(location.descriptor))
        . wide-hash = fnv-hash(run.data, run.length)
        . hash = ((wide-hash /xor/ (wide-hash /zrshift/ 32)) /and/ 0xffffffff) as U32
        . first-location = runs.find(run.view, hash, location-records.data)
        if first-location == no-id
            first-location = location-count
            runs.add(first-location, safepoint.location-count, hash)
            location-records.bytes(run.view)
            location-count += safepoint.location-count
        safepoint-records.u32(safepoint.pc-offset)
        safepoint-records.u32(first-location)
        safepoint-records.u32(safepoint.location-count)
        safepoint-count += 1
    . first-saved = saved-count
    for position in 0 .. < compact.saved-register-count
        . saved = compact.saved-registers[position]
        saved-records.u8(saved.register)
        saved-records.u8(0)
        saved-records.u16(0)
        saved-records.i32(saved.fp-offset)
        saved-count += 1
    function-records.u64(0)
    function-records.u32(compact.code.length as U32)
    function-records.u32(first-safepoint)
    function-records.u32(safepoint-count - first-safepoint)
    function-records.u32(first-saved)
    function-records.u32(saved-count - first-saved)
    function-records.u32(0)
    function-symbols = function-symbols.appended(arena, compact.symbol)
    function-count += 1

if function-count == 0
    =

. writer = BinaryWriter(arena, 65536)
writer.u32(gc-map-magic)
writer.u16(3)
writer.u16(8)
writer.u32(function-count)
writer.u32(safepoint-count)
writer.u32(location-count)
writer.u32(saved-count)
writer.u32(descriptors.length)
writer.u32(bundle.gc-allocation-buffer-version)
for index in 0 .. < descriptors.length
    add-relocation(SectionId.gc-map, writer.length as U32, descriptors[index], .unsigned-relocation)
    writer.u64(0)
. function-records-offset U32 = writer.length as U32
writer.bytes(function-records.view)
for index in 0 .. < function-symbols.length
    add-relocation
        - SectionId.gc-map
        - function-records-offset + index * gc-function-record-size
        - function-symbols[index]
        - .unsigned-relocation
writer.bytes(safepoint-records.view)
writer.bytes(location-records.view)
writer.bytes(saved-records.view)
finish-section(SectionId.gc-map, writer)

────────────────────
_ do descriptor-index U32
    - descriptor StringId

if descriptor == no-string
    = 0
. known = descriptor-indexes[descriptor]
if known != 0
    = known
descriptors = descriptors.appended(arena, descriptor)
descriptor-indexes[descriptor] = descriptors.length
= descriptors.length

────────────────────
_ do finish-section
    - index U32
    - writer BinaryWriter

. target = section(index)
target.data = writer.view
target.size = writer.length as U64

────────────────────
_ do define-symbol
    - name StringId
    - section-index U32
    - offset U64
    - is-external Bool

. row = symbol-rows[name]
if row != 0
    ?! Panic("Symbol ${bundle.text(name)} is defined twice")
        if symbols[row - 1].section != SectionId.none
    symbols[row - 1].section = section-index
    symbols[row - 1].value = offset
    symbols[row - 1].is-external = is-external
    =
symbols.append(ObjectSymbol(name, section-index, offset, 0, false, is-external, 0, 0))
symbol-rows[name] = symbols.length as U32

────────────────────
_ do reference-symbol U32
    - name StringId

. row = symbol-rows[name]
if row != 0
    = row - 1
symbols.append(ObjectSymbol(name, SectionId.none, 0, 0, false, true, 0, 0))
symbol-rows[name] = symbols.length as U32
= symbol-rows[name] - 1

────────────────────
_ do add-relocation
    - section-index U32
    - offset U32
    - name StringId
    - kind RelocationKind

. symbol = reference-symbol(name)
section(section-index).relocations.append(ObjectRelocation(offset, symbol, kind))

────────────────────
_ do finalize-symbols CPointer'U32

. count U32 = symbols.length as U32
. order = arena.allocate'U32(count)
. next U32
for group in 0 .. < 3
    for row in 0 .. < count
        . symbol = symbols[row]
        . symbol-group U32 = 2
        if symbol.section != SectionId.none
            symbol-group = if symbol.is-external then 1 else 0
        if symbol-group == group
            order[next] = row
            symbols[row].index = next
            next += 1
    if group == 0
        local-count = next
    else if group == 1
        external-count = next - local-count
undefined-count = count - local-count - external-count
= order

────────────────────
_ do build-string-table ByteSpan
    - order CPointer'U32

. writer = BinaryWriter(arena, 65536)
writer.u8(0)
for position in 0 .. < symbols.length
    . row = order[position]
    symbols[row].string-offset = writer.length as U32
    writer.bytes(bundle.string(symbols[row].name))
    writer.u8(0)
= writer.view

