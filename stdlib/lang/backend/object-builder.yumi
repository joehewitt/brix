────────────────────
+ This
    - bundle Bundle
    - arena Arena

offsets = arena.allocate'U32(bundle.string-count)
files = arena.allocate'Byte(bundle.string-count)

.. strings = BinaryWriter(arena, 65536)

────────────────────
+ do add U32
    - name StringId

. id = bundle.non-empty(name)
if id == no-string
    if empty-offset == no-id
        empty-offset = strings.length as U32
        strings.u8(0)
    = empty-offset
. known = offsets[id]
if known != 0
    = known - 1
. offset U32 = strings.length as U32
offsets[id] = offset + 1
strings.bytes(bundle.string(id))
strings.u8(0)
= offset

────────────────────
+ do add-file U32
    - name StringId

. id = bundle.non-empty(name)
if id != no-string && files[id] == 0
    files[id] = 1
    file-count += 1
= add(id)

━━━━━━━━━━━━━━━━━━━━
_ LocationRuns

_ arena Arena
_ slots CPointer'U32
_ capacity U32
_ count U32

────────────────────
+ This
    - arena Arena

capacity = 1024
slots = arena.allocate'U32(capacity * 3)

────────────────────
+ do find U32
    - run ByteSpan
    - hash U32
    - records CPointer'Byte

. mask = capacity - 1
. index = hash /and/ mask
. location-count U32 = (run.length / gc-location-size) as U32
while true
    . first = slots[index * 3]
    if first == 0
        = no-id
    if slots[index * 3 + 2] == hash && slots[index * 3 + 1] == location-count
        . start = (first - 1) * gc-location-size
        if C:memcmp(records + start, run.data, run.length) == 0
            = first - 1
    index = (index + 1) /and/ mask

────────────────────
+ do add
    - first U32
    - location-count U32
    - hash U32

if (count + 1) * 2 > capacity
    grow()
place(first + 1, location-count, hash)
count += 1

────────────────────
_ do place
    - marked-first U32
    - location-count U32
    - hash U32

. mask = capacity - 1
. index = hash /and/ mask
while slots[index * 3] != 0
    index = (index + 1) /and/ mask
slots[index * 3] = marked-first
slots[index * 3 + 1] = location-count
slots[index * 3 + 2] = hash

────────────────────
_ do grow

. old-slots = slots
. old-capacity = capacity
capacity = old-capacity * 2
slots = arena.allocate'U32(capacity * 3)
for index in 0 .. < old-capacity
    if old-slots[index * 3] != 0
        place(old-slots[index * 3], old-slots[index * 3 + 1], old-slots[index * 3 + 2])
