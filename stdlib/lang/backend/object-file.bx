(import ./elf-writer)
(import ./macho-writer)
(import ./mir)
(import ./object-builder)
(import /lang/target)

(fn-do + object-file ByteSpan
  (param builder ObjectBuilder)
  (param target Target)
  ; The built object in the format the target's linker reads.
  (return
    (match (. target object-format)
      (case= .macho
        (call write-macho builder target)
      )
      (case= .elf
        (call write-elf builder)
      )
    )
  )
)
