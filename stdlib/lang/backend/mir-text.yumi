./bundle
./mir
/BxCore/BxCore.h
/core/arena
/core/table

━━━━━━━━━━━━━━━━━━━━
+ TextBuffer

+ bytes Byte[]
+ length Size
_ digits Byte[]

────────────────────
+ This

.. bytes = Byte[65536]
.. digits = Byte[20]

────────────────────
+ do clear

length = 0

────────────────────
+ get hash U64

fnv-hash(bytes.data, length)

────────────────────
_ do reserve @inline
    - count Size

if length + count > bytes.size
    grow(length + count)

────────────────────
_ do grow
    - needed Size

. capacity = bytes.size * 2
while capacity < needed
    capacity *= 2
bytes = bytes.resize(capacity)

────────────────────
+ do byte
    - value Byte

reserve(1)
bytes.data[length] = value
length += 1

────────────────────
+ do text
    - value String

span(ByteSpan(value, value.size))

────────────────────
+ do span
    - value ByteSpan

reserve(value.length)
C:brixArrayCopySlice(bytes.data + length, value.data, value.length)
length += value.length

────────────────────
+ do escaped
    - value ByteSpan

reserve(value.length * 2)
. data = bytes.data
. cursor = length
for index in 0 .. < value.length
    . character = value.data[index]
    if character == 92
        data[cursor] = 92
        data[cursor + 1] = 92
        cursor += 2
    else if character == 10
        data[cursor] = 92
        data[cursor + 1] = 110
        cursor += 2
    else if character == 13
        data[cursor] = 92
        data[cursor + 1] = 114
        cursor += 2
    else
        data[cursor] = character
        cursor += 1
length = cursor

────────────────────
+ do unsigned
    - value U64

. count Size = 0
. rest = value
while true
    digits.data[count] = 48 + (rest % 10) as Byte
    count += 1
    rest /= 10
    if rest == 0
        break
reserve(count)
for index in 0 .. < count
    bytes.data[length + index] = digits.data[count - 1 - index]
length += count

────────────────────
+ do signed
    - value I64

if value < 0
    byte(45)
    unsigned(0 - (value as U64))
else
    unsigned(value as U64)

────────────────────
+ do hex
    - value ByteSpan

reserve(value.length * 2)
for index in 0 .. < value.length
    . high = value.data[index] /zrshift/ 4
    . low = value.data[index] /and/ 15
    bytes.data[length + index * 2] = if high < 10 then high + 48 else high + 87
    bytes.data[length + index * 2 + 1] = if low < 10 then low + 48 else low + 87
length += value.length * 2

────────────────────
+ do hex64
    - value U64

reserve(16)
for index in 0 .. < 16
    . nibble = ((value /zrshift/ ((15 - index) * 4)) /and/ 15) as Byte
    bytes.data[length + index] = if nibble < 10 then nibble + 48 else nibble + 87
length += 16

━━━━━━━━━━━━━━━━━━━━
+ MIRText

+ out TextBuffer
_ bundle Bundle
_ function MIRFunction
_ referenced [MIRSlotId]
_ is-referenced [Bool]

────────────────────
+ This
    - bundle Bundle
    - function MIRFunction

────────────────────
+ do function-text

out.text("function ")
out.span(bundle.string(function.name))
out.text(" effects=")
out.unsigned(function.compilation-effects)
out.text(" vregs=")
out.unsigned(function.vreg-count)
if function.is-exported
    out.text(" exported")
if function.uses-table-union-cursor-plan
    out.text(" cursor-plan")
if function.uses-layout-context
    out.text(" layout-context")
loc-text(function.loc)
out.text("\ndisplay ")
out.escaped(bundle.string(function.display-name))
out.byte(10)
if function.closure-root != no-frame-object
    out.text("closure-root ")
    frame-object-text(function.closure-root)
    out.byte(10)
if function.capture-closure-root != no-frame-object
    out.text("capture-closure-root ")
    frame-object-text(function.capture-closure-root)
    out.byte(10)
if function.vars.length != 0
    out.text("vars")
    for index in 0 .. < function.vars.length
        out.byte(32)
        frame-object-text(function.vars[index])
    out.byte(10)
if function.overflow.is-present
    overflow-text()
collect-referenced-slots()
for slot in referenced
    slot-text(slot)
if function.frame-bytes != 0
    out.text("frame-bytes ")
    out.unsigned(function.frame-bytes)
    out.byte(10)
if function.gc-roots.count != 0
    out.text("roots")
    for root in function.gc-roots.start .. < function.gc-roots.end
        out.byte(32)
        root-text(root)
    out.byte(10)
if function.saved-registers.length != 0
    out.text("saved")
    for saved in function.saved-registers
        out.byte(32)
        register-text(saved.register)
        out.byte(64)
        out.signed(saved.fp-offset)
    out.byte(10)
for table in function.jump-tables
    out.text("jump-table ")
    name-text(table.name)
    out.byte(58)
    for index in table.labels.start .. < table.labels.end
        out.byte(32)
        name-text(function.names[index])
    out.byte(10)
for position in 0 .. < function.block-order.length
    block-text(function.block-order[position])

────────────────────
_ do overflow-text

. overflow = function.overflow
. slot = function.slots[overflow.slot]
out.text("overflow slot=")
out.signed(slot.index)
if slot.is-stack
    out.text(" stack")
out.text(" size=")
out.signed(overflow.size)
out.text(" align=")
out.signed(overflow.alignment)
out.text(" length=")
out.signed(overflow.length)
out.text(" count=")
out.signed(overflow.count)
out.text(" offset=")
out.signed(overflow.offset)
out.byte(10)

────────────────────
_ do block-text
    - id BlockId

. block = function.blocks[id]
out.text("block ")
name-text(block.name)
out.text(" succ=[")
block-names(block.successors)
out.text("] pred=[")
block-names(block.predecessors)
out.text("]\n")
for index in 0 .. < block.instructions.length
    out.text("  ")
    instruction-text(block.instructions[index])
    out.byte(10)

────────────────────
_ do block-names
    - ids IdList

for index in 0 .. < ids.length
    if index != 0
        out.byte(32)
    name-text(function.blocks[ids[index]].name)

────────────────────
+ do instruction-text
    - id InstructionId

match function.instructions[id]
    | .assembly-instruction(row)
        instruction-head(row.opcode, row.operands, false)
        instruction-tail
            - row.position
            - row.gc-free-zone
            - row.gc-exceptional-safepoint
            - row.gc-safepoint
        instruction-end(false, false, row.is-phi-copy, row.has-gc-roots, row.gc-roots, row.loc)
    | .comment-instruction(row)
        out.text("COMMENT ")
        comment-text(row.text)
        instruction-head(row.opcode, row.operands, true)
        instruction-tail
            - row.position
            - row.gc-free-zone
            - row.gc-exceptional-safepoint
            - row.gc-safepoint
        instruction-end(false, false, row.is-phi-copy, row.has-gc-roots, row.gc-roots, row.loc)
    | .phi-instruction(row)
        out.text("PHI ")
        operand-text(row.reg)
        out.text(" = ")
        for index in 0 .. < row.exprs.length
            if index != 0
                out.text(", ")
            operand-text(row.exprs[index])
            out.byte(32)
            if index < row.blocks.length
                name-text(row.blocks[index])
            else
                out.text("undefined")
        instruction-head(row.opcode, row.operands, true)
        instruction-tail
            - row.position
            - row.gc-free-zone
            - row.gc-exceptional-safepoint
            - row.gc-safepoint
        instruction-end(false, false, row.is-phi-copy, row.has-gc-roots, row.gc-roots, row.loc)
    | .call-instruction(row)
        instruction-head(row.opcode, row.operands, false)
        out.text(" ret=")
        type-text(row.return-type)
        if row.copied-struct-arguments.count != 0
            out.text(" copied=")
            for index in 0 .. < row.copied-struct-arguments.count
                if index != 0
                    out.byte(44)
                out.unsigned(function.words[row.copied-struct-arguments.start + index])
        if row.argument-sizes.count != 0
            out.text(" sizes=")
            for index in 0 .. < row.argument-sizes.count
                if index != 0
                    out.byte(44)
                out.unsigned(function.words[row.argument-sizes.start + index])
        if row.panic-target != no-operand
            out.text(" panic=")
            operand-text(row.panic-target)
        instruction-tail
            - row.position
            - row.gc-free-zone
            - row.gc-exceptional-safepoint
            - row.gc-safepoint
        instruction-end
            - row.gc-safepoint-proven-free
            - row.direct-struct-return
            - row.is-phi-copy
            - row.has-gc-roots
            - row.gc-roots
            - row.loc

────────────────────
+ do name-text
    - id StringId

if id < function.pool-size
    out.span(bundle.string(id))
    =
. name = function.local-names[id - function.pool-size]
match name.kind
    |= .edge-block-name
        name-text(name.first)
        out.text(".edge.")
        name-text(name.second)
        out.byte(46)
        out.unsigned(name.index)
    |= .barrier-record-name
        out.text("gc_barrier.record.")
        out.unsigned(name.index)
    |= .barrier-after-name
        out.text("gc_barrier.after.")
        out.unsigned(name.index)
    |= .phi-copy-name
        out.text("phi V")
        out.unsigned(name.index)
        out.text(" <- edge ")
        name-text(name.first)
        out.text("->")
        name-text(name.second)
    |= .phi-cycle-name
        out.text("phi cycle save V")
        out.unsigned(name.index)
        out.text(" on edge ")
        name-text(name.first)
        out.text("->")
        name-text(name.second)
    |= .save-layout-context-name
        out.text("save generic layout context")
    |= .save-callee-saved-name
        out.text("save callee-saved registers")
    |= .save-frame-name
        out.text("save fp/lr and shift sp")
    |= .restore-frame-name
        out.text("restore fp/lr and reset sp")
    |= .restore-callee-saved-name
        out.text("restore callee-saved registers")
    |= .restore-layout-context-name
        out.text("restore generic layout context")
    |= .literal-name
        out.text("literal.")
        out.unsigned(name.index)
    |= .block-name
        out.text("b")
        out.unsigned(name.index)
    |= .jump-table-name
        out.text("jump_table.")
        out.unsigned(name.index)
    |= .allocation-slow-name
        out.text("gc_alloc.slow.")
        out.unsigned(name.index)
    |= .allocation-after-name
        out.text("gc_alloc.after.")
        out.unsigned(name.index)
    |= .switch-tree-name
        out.text("switch_tree.")
        out.unsigned(name.index)

────────────────────
_ do comment-text
    - id StringId

if id < function.pool-size
    out.escaped(bundle.string(id))
else
    name-text(id)

────────────────────
_ do instruction-head
    - opcode Opcode
    - operands IdList
    - has-name Bool

if !has-name
    out.text(opcode-names[opcode])
for index in 0 .. < operands.length
    out.text(if index == 0 then " " else ", ")
    operand-text(operands[index])

────────────────────
_ do instruction-tail
    - position I32
    - gc-free-zone Bool
    - gc-exceptional-safepoint Bool
    - gc-safepoint Bool

if position != no-position
    out.text(" pos=")
    out.signed(position)
if gc-free-zone
    out.text(" gcfree")
if gc-exceptional-safepoint
    out.text(" exceptional")
if gc-safepoint
    out.text(" safepoint")

────────────────────
_ do instruction-end
    - gc-safepoint-proven-free Bool
    - direct-struct-return Bool
    - is-phi-copy Bool
    - has-gc-roots Bool
    - gc-roots Span
    - loc LocId

if gc-safepoint-proven-free
    out.text(" provenfree")
if direct-struct-return
    out.text(" structret")
if is-phi-copy
    out.text(" phicopy")
if has-gc-roots
    out.text(" roots=[")
    for root in gc-roots.start .. < gc-roots.end
        if root != gc-roots.start
            out.byte(32)
        root-text(root)
    out.byte(93)
loc-text(loc)

────────────────────
_ do loc-text
    - id LocId

if id == no-loc
    =
. loc = function.locs[id]
out.text(" loc=")
if loc.file == no-string
    out.byte(45)
else
    out.span(bundle.string(loc.file))
out.byte(58)
if !loc.is-known
    out.byte(63)
    =
out.signed(loc.line)
out.byte(58)
out.signed(loc.column)

────────────────────
+ do type-text
    - id MIRTypeId

match function.types[id]
    | .void-type
        out.text("void")
    | .int-type(type)
        out.byte(if type.is-signed then 105 else 117)
        out.unsigned(type.bit-size)
    | .float-type(type)
        out.byte(102)
        out.unsigned(type.bit-size)
    | .pointer-type
        out.text("ptr")
    | .array-type(type)
        out.byte(91)
        type-text(type.item)
        out.text(" x ")
        out.unsigned(type.length)
        out.text(" size=")
        out.unsigned(type.size)
        out.text(" align=")
        out.unsigned(type.alignment)
        out.byte(93)
    | .struct-type(type)
        out.byte(123)
        out.unsigned(type.format)
        out.text(" size=")
        out.unsigned(type.size)
        out.text(" align=")
        out.unsigned(type.alignment)
        out.byte(58)
        for index in type.fields.start .. < type.fields.end
            . field = function.struct-fields[index]
            out.byte(32)
            type-text(field.type)
            out.byte(64)
            out.unsigned(field.offset)
        if type.fields.count == 0
            out.byte(32)
        out.byte(125)

────────────────────
+ do register-text
    - id RegisterId

if id < 32
    out.byte(120)
    out.unsigned(id)
else if id < 64
    out.byte(119)
    out.unsigned(id - 32)
else if id < 96
    out.byte(100)
    out.unsigned(id - 64)
else if id < 128
    out.byte(115)
    out.unsigned(id - 96)
else if id == 128
    out.text("sp")
else
    out.text("pc")

────────────────────
+ do reg-class-suffix
    - reg-class RegClass

match reg-class
    |= .gpr32
        out.byte(119)
    |= .gpr64
        out.byte(120)
    |= .fpr32
        out.byte(115)
    |= .fpr64
        out.byte(100)

────────────────────
_ do root-mode-text
    - mode GCRootMode

out.text(if mode == .value-root then "value" else "address")

────────────────────
_ do descriptor-text
    - descriptor StringId

if descriptor == no-string
    out.byte(45)
else
    out.span(bundle.string(descriptor))

────────────────────
+ do vreg-text
    - id VRegId

. vreg = function.vregs[id]
out.byte(86)
out.unsigned(vreg.id)
out.byte(46)
reg-class-suffix(vreg.reg-class)
if vreg.hint != no-register
    out.text("[hint ")
    register-text(vreg.hint)
    out.byte(93)
if vreg.gc-root
    out.text("[root ")
    root-mode-text(vreg.gc-root-mode)
    out.byte(32)
    descriptor-text(vreg.gc-descriptor)
    out.byte(93)

────────────────────
+ do frame-object-text
    - id FrameObjectId

. object = function.frame-objects[id]
out.byte(70)
out.signed(function.slots[object.slot].index)
out.byte(46)
out.signed(object.index)

────────────────────
_ do reloc-text
    - reloc Reloc

if reloc == .page-reloc
    out.text("@PAGE")
else if reloc == .pageoff-reloc
    out.text("@PAGEOFF")

────────────────────
+ do operand-text
    - id OperandId

if id == no-operand
    out.byte(45)
    =
match function.operands[id]
    | .vreg-operand(operand)
        vreg-text(operand.vreg)
    | .preg-operand(operand)
        register-text(operand.register)
    | .vreg-group-operand(operand)
        out.byte(123)
        for index in operand.vregs.start .. < operand.vregs.end
            if index != operand.vregs.start
                out.byte(32)
            vreg-text(function.group-vregs[index])
        out.text("}.")
        reg-class-suffix(operand.reg-class)
    | .label-operand(operand)
        out.text("L(")
        name-text(operand.name)
        out.byte(41)
        reloc-text(operand.reloc)
    | .symbol-operand(operand)
        out.text("S(")
        out.span(bundle.string(operand.name))
        out.byte(41)
        reloc-text(operand.reloc)
    | .label-address-operand(operand)
        out.byte(38)
        operand-text(operand.base)
    | .load-address-operand(operand)
        out.byte(91)
        operand-text(operand.base)
        out.text(", ")
        operand-text(operand.offset)
        if operand.index-shift != 0
            out.text(", lsl #")
            out.unsigned(operand.index-shift)
        out.byte(93)
        if operand.is-pre-index
            out.byte(33)
    | .frame-object-operand(operand)
        frame-object-text(operand.object)
    | .int-operand(operand)
        out.byte(35)
        if operand.value.is-negative
            out.signed(operand.value.bits as I64)
        else
            out.unsigned(operand.value.bits)
    | .cond-operand(operand)
        out.byte(63)
        out.unsigned(operand.code)
    | .placeholder-operand
        out.byte(95)
    | .shift-operand(operand)
        if operand.kind == MIRShift.left
            out.text("lsl #")
        else if operand.kind == MIRShift.right
            out.text("lsr #")
        else
            out.text("asr #")
        out.unsigned(operand.amount)

────────────────────
_ do root-text
    - id U32

match function.roots[id]
    | .register-root(root)
        register-text(root.register)
    | .stack-root(root)
        frame-object-text(root.object)
        out.byte(58)
        root-mode-text(root.gc-root-mode)
        out.byte(58)
        descriptor-text(root.gc-descriptor)

────────────────────
_ do slot-text
    - id MIRSlotId

. slot = function.slots[id]
out.text("slot ")
out.signed(slot.index)
if slot.is-stack
    out.text(" stack")
out.byte(10)
for position in 0 .. < slot.objects.length
    . object = function.frame-objects[slot.objects[position]]
    out.text("  object ")
    out.signed(object.index)
    out.byte(32)
    type-text(object.type)
    out.text(" offset=")
    out.signed(object.offset)
    if object.can-promote
        out.text(" promote")
    if object.gc-root
        out.text(" root ")
        root-mode-text(object.gc-root-mode)
        out.byte(32)
        descriptor-text(object.gc-descriptor)
    if object.is-spill
        out.text(" spill")
    if object.lifetime.count != 0
        out.text(" life=")
        . cursor = object.lifetime.start
        while cursor < object.lifetime.end
            if cursor != object.lifetime.start
                out.byte(44)
            out.unsigned(function.lifetimes[cursor])
            out.byte(45)
            out.unsigned(function.lifetimes[cursor + 1])
            cursor += 2
    out.byte(10)

────────────────────
_ do collect-referenced-slots

referenced.clear()
is-referenced.clear()
for _ in 0 .. < function.slots.length
    is-referenced += false
for index in 0 .. < function.frame-slots.length
    reference-slot(function.frame-slots[index])
if function.overflow.is-present
    reference-slot(function.overflow.slot)
for index in 0 .. < function.vars.length
    reference-object(function.vars[index])
reference-roots(function.gc-roots)
for position in 0 .. < function.block-order.length
    . block = function.blocks[function.block-order[position]]
    for index in 0 .. < block.instructions.length
        reference-instruction(block.instructions[index])
sort-referenced-slots()

────────────────────
_ do reference-slot
    - slot MIRSlotId

if !is-referenced[slot]
    is-referenced[slot] = true
    referenced += slot

────────────────────
_ do reference-object
    - object FrameObjectId

reference-slot(function.frame-objects[object].slot)

────────────────────
_ do reference-roots
    - roots Span

for id in roots.start .. < roots.end
    match? function.roots[id]
        | .stack-root(root)
            reference-object(root.object)

────────────────────
_ do reference-instruction
    - id InstructionId

match function.instructions[id]
    | .assembly-instruction(row)
        reference-operands(row.operands)
        reference-roots(row.gc-roots)
    | .comment-instruction(row)
        reference-operands(row.operands)
        reference-roots(row.gc-roots)
    | .phi-instruction(row)
        reference-operands(row.operands)
        reference-roots(row.gc-roots)
    | .call-instruction(row)
        reference-operands(row.operands)
        reference-operand(row.panic-target)
        reference-roots(row.gc-roots)

────────────────────
_ do reference-operands
    - operands IdList

for index in 0 .. < operands.length
    reference-operand(operands[index])

────────────────────
_ do reference-operand
    - id OperandId

if id == no-operand
    =
match? function.operands[id]
    | .frame-object-operand(operand)
        reference-object(operand.object)
    | .load-address-operand(operand)
        reference-operand(operand.base)
        reference-operand(operand.offset)
    | .label-address-operand(operand)
        reference-operand(operand.base)

────────────────────
_ do sort-referenced-slots

if referenced.length < 2
    =
for position in 1 .. < referenced.length
    . slot = referenced[position]
    . index = function.slots[slot].index
    . target = position
    while target > 0 && function.slots[referenced[target - 1]].index > index
        referenced[target] = referenced[target - 1]
        target -= 1
    referenced[target] = slot

━━━━━━━━━━━━━━━━━━━━
+ do name-string String
    - bundle Bundle
    - function MIRFunction
    - id StringId

. text = MIRText(bundle, function)
text.name-text(id)
= text.out.bytes.slice-string(0 .. < text.out.length)
