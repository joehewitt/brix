(import ./aarch64-encoder)
(import ./binary-writer)
(import ./bundle)
(import ./mir)
(import ./mir-text)
(import ./relocations)
(import /core/arena)
(import /core/table)
(import /string.h)
(blank)
(prop _ long-conditional-branch-threshold U32 (= 200000))
(prop _ long-test-branch-threshold U32 (= 8000))
(prop _ root-stack-untyped U32 (= 1))
(prop _ root-register U32 (= 2))
(prop _ root-stack-address U32 (= 3))
(prop _ root-stack-value U32 (= 4))
(prop _ relocation-kind-names (list String) (= (list "call26" "jump26" "page21" "add-pageoff12" "load-store8-pageoff12" "load-store16-pageoff12" "load-store32-pageoff12" "load-store64-pageoff12" "load-store128-pageoff12" "unsigned")))

(type + CompactJumpTable (is Tuple)
  (prop + name StringId)
  (prop + offset U32)
)

(type + CompactLineRecord (is Tuple)
  (prop + pc-offset U32)
  (prop + file StringId)
  (prop + line I32)
  (prop + column I32)
)

(type + CompactRootLocation (is Tuple)
  (prop + kind U32)
  (prop + register U32)
  (prop + offset I32)
  (prop + descriptor StringId)
)

(type + CompactSafepoint (is Tuple)
  (prop + pc-offset U32)
  (prop + first-location U32)
  (prop + location-count U32)
)

(type + CompactPad (is Tuple)
  ; A checked call's return address and the landing pad it fails into, as offsets in the function.
  (prop + return-offset U32)
  (prop + pad-offset U32)
)

(type + CompactSavedRegister (is Tuple)
  (prop + register U32)
  (prop + fp-offset I32)
)

(type + CompactFunction (is Tuple)
  (prop + is-encoded Bool)
  (prop + order U32)
  (prop + symbol StringId)
  (prop + is-external Bool)
  (prop + code ByteSpan)
  (prop + relocations (of CPointer Relocation))
  (prop + relocation-count U32)
  (prop + jump-tables (of CPointer CompactJumpTable))
  (prop + jump-table-count U32)
  (prop + display-name StringId)
  (prop + source-file StringId)
  (prop + source-line I32)
  (prop + source-column I32)
  (prop + line-records (of CPointer CompactLineRecord))
  (prop + line-record-count U32)
  (prop + safepoints (of CPointer CompactSafepoint))
  (prop + safepoint-count U32)
  (prop + locations (of CPointer CompactRootLocation))
  (prop + location-count U32)
  (prop + saved-registers (of CPointer CompactSavedRegister))
  (prop + saved-register-count U32)
  (prop + pads (of CPointer CompactPad))
  (prop + pad-count U32)
)

(type + FunctionEncoder
  (prop _ bundle Bundle)
  (prop _ function MIRFunction)
  (prop _ results Arena)
  (prop _ labels TextLabels)
  (prop _ encoder AArch64Encoder)
  (prop _ plan (of CPointer PlanEntry))
  (prop _ plan-count U32)
  (prop _ safepoints (of CPointer PlanSafepoint))
  (prop _ safepoint-count U32)
  (prop _ lines (of CPointer CompactLineRecord))
  (prop _ line-count U32)
  (prop _ call-offsets (of CPointer U32))
  (prop _ call-ends (of CPointer U32))
  (prop _ pad-checks (of CPointer Byte))
  (prop _ text-size U32)
  (fn-do + This _
    (param bundle Bundle)
    (param function MIRFunction)
    (param results Arena)
    (lazy labels (call TextLabels bundle function))
    (lazy encoder (call AArch64Encoder bundle function labels))
  )
  (fn-do + encode CompactFunction
    (call layout)
    (let code (call (. results allocate-raw) text-size 8))
    (let relocations (call (of (. function arena allocate) Relocation) plan-count))
    (let relocation-count (call encode-text code relocations))
    (blank)
    (let kept-relocations (call (of (. results allocate) Relocation) relocation-count))
    (for (in index (..< 0 relocation-count))
      (= ([] kept-relocations index) ([] relocations index))
    )
    (blank)
    (let table-count U32)
    (for (in table (. function jump-tables))
      (if (< (. table name) (. function pool-size))
        (+= table-count 1)
      )
    )
    (let tables (call (of (. results allocate) CompactJumpTable) table-count))
    (let kept U32)
    (for (in table (. function jump-tables))
      (if (< (. table name) (. function pool-size))
        (= ([] tables kept) (call CompactJumpTable (. table name) (call (. labels symbol-offset) (. table name))))
        (+= kept 1)
      )
    )
    (blank)
    (let kept-lines (call (of (. results allocate) CompactLineRecord) line-count))
    (for (in index (..< 0 line-count))
      (= ([] kept-lines index) ([] lines index))
    )
    (blank)
    (let function-roots (. function gc-roots))
    (let location-total (* safepoint-count (. function-roots count)))
    (for (in index (..< 0 safepoint-count))
      (let row ([] (. function instructions) (. ([] safepoints index) instruction)))
      (if (. row has-gc-roots)
        (+= location-total (. row gc-roots count))
      )
    )
    (let kept-safepoints (call (of (. results allocate) CompactSafepoint) safepoint-count))
    (let locations (call (of (. results allocate) CompactRootLocation) location-total))
    (let location-count U32)
    (for (in index (..< 0 safepoint-count))
      (let safepoint ([] safepoints index))
      (let row ([] (. function instructions) (. safepoint instruction)))
      (let first location-count)
      (for (in root (..< (. function-roots start) (. function-roots end)))
        (= ([] locations location-count) (call root-location root))
        (+= location-count 1)
      )
      (if (. row has-gc-roots)
        (for (in root (..< (. row gc-roots start) (. row gc-roots end)))
          (= ([] locations location-count) (call root-location root))
          (+= location-count 1)
        )
      )
      (= ([] kept-safepoints index) (call CompactSafepoint (+ (. safepoint offset) 4) first (- location-count first)))
    )
    (blank)
    (let saved (call (of (. results allocate) CompactSavedRegister) (. function saved-registers length)))
    (let saved-count U32)
    (for (in entry (. function saved-registers))
      (if (== (call register-class (. entry register)) .gpr64)
        (= ([] saved saved-count)
          (call CompactSavedRegister
            (block
              (arg (call gc-register-number (. entry register)))
              (arg (. entry fp-offset))
            )
          )
        )
        (+= saved-count 1)
      )
    )
    (blank)
    (let pads (call (of (. results allocate) CompactPad) (. function pad-sites length)))
    (let pad-count U32)
    (for (in site (. function pad-sites))
      (if (== ([] call-offsets (. site call)) no-label)
        (continue)
      )
      (= ([] pads pad-count) (call CompactPad (+ ([] call-offsets (. site call)) 4) (call pad-offset (. site check))))
      (+= pad-count 1)
    )
    (blank)
    (let display-name (call (. bundle non-empty) (. function display-name)))
    (if (== display-name no-string)
      (= display-name (. function name))
    )
    (let source-file no-string)
    (let source-line I32)
    (let source-column I32)
    (if (!= (. function loc) no-loc)
      (let loc ([] (. function locs) (. function loc)))
      (= source-file (call (. bundle non-empty) (. loc file)))
      (if (. loc is-known)
        (= source-line (. loc line))
        (= source-column (. loc column))
      )
    )
    (blank)
    (let is-main
      (scope (and (== (. bundle output-mode) 0) (!= (. bundle main-name) no-string) named-main)
        (lazy named-main (== (. function name) (. bundle main-name)))
      )
    )
    (let is-external (or (. function is-exported) is-main))
    (blank)
    (return
      (call CompactFunction
        (block
          (arg true)
          (arg (. function order))
          (arg (. function symbol))
          (arg is-external)
          (arg (call ByteSpan code text-size))
          (arg kept-relocations)
          (arg relocation-count)
          (arg tables)
          (arg table-count)
          (arg display-name)
          (arg source-file)
          (arg source-line)
          (arg source-column)
          (arg kept-lines)
          (arg line-count)
          (arg kept-safepoints)
          (arg safepoint-count)
          (arg locations)
          (arg location-count)
          (arg saved)
          (arg saved-count)
          (arg pads)
          (arg pad-count)
        )
      )
    )
  )
  (fn-do _ layout _
    (let block-count (. function block-order length))
    (let total U32)
    (for (in position (..< 0 block-count))
      (+= total (. ([] (. function blocks) ([] (. function block-order) position)) instructions length))
    )
    (let uses-islands (> total long-conditional-branch-threshold))
    (let uses-test-islands (> total long-test-branch-threshold))
    (let arena (. function arena))
    (= plan (call (of (. arena allocate) PlanEntry) (if-expr uses-test-islands (* total 3) total)))
    (= plan-count 0)
    (= safepoints (call (of (. arena allocate) PlanSafepoint) total))
    (= safepoint-count 0)
    (= lines (call (of (. arena allocate) CompactLineRecord) total))
    (= line-count 0)
    (let records-calls (!= (. function pad-sites length) 0))
    (if records-calls
      (= call-offsets (call (of (. arena allocate) U32) (. function instructions length)))
      (= call-ends (call (of (. arena allocate) U32) (. function instructions length)))
      (= pad-checks (call (of (. arena allocate) Byte) (. function instructions length)))
      (for (in index (..< 0 (. function instructions length)))
        (= ([] call-offsets index) no-label)
      )
      (for (in site (. function pad-sites))
        (= ([] pad-checks (. site check)) 1)
      )
    )
    (let symbol-count U32 (as (+ (. function jump-tables length) 1) U32))
    (call (. labels reset) arena block-count symbol-count)
    (blank)
    (let offset U32)
    (for (in position (..< 0 block-count))
      (let block ([] (. function blocks) ([] (. function block-order) position)))
      (if (== position 0)
        (call (. labels define-symbol) (. function symbol) 0)
      )
      (if (and (!= (. block name) (. bundle entry-name)) (or (!= position 0) (!= (. block name) (. function symbol))))
        (call (. labels define-block) (. block name) offset)
      )
      (let instructions (. block instructions))
      (for (in index (..< 0 (. instructions length)))
        (let id ([] instructions index))
        (let row ([] (. function instructions) id))
        (let opcode (. row opcode))
        (if (or (== opcode .comment) (== opcode .phi))
          (continue)
        )
        (throw (call Panic (str "Unexpected lowered MIR instruction in final emission: " ([] opcode-names opcode))) (if (or (== opcode .call) (== opcode .addptr))))
        (if (. row gc-safepoint)
          (= ([] safepoints safepoint-count) (call PlanSafepoint id offset))
          (+= safepoint-count 1)
        )
        (if records-calls
          (= ([] call-offsets id) offset)
        )
        (if (and records-calls (!= ([] pad-checks id) 0))
          (if (== opcode .cbz)
            (= ([] plan plan-count) (call PlanEntry id (. CompactForm island-jump)))
            (+= plan-count 1)
            (+= offset 4)
          )
          (= ([] call-ends id) offset)
          (continue)
        )
        (call record-trace-line offset (. row loc))
        (if (or (and uses-islands (or (== opcode .cbz) (== opcode .cbnz) (== opcode .b-cond))) test-island)
          (= ([] plan plan-count) (call PlanEntry id (. CompactForm island-test)))
          (= ([] plan (+ plan-count 1)) (call PlanEntry id (. CompactForm island-skip)))
          (= ([] plan (+ plan-count 2)) (call PlanEntry id (. CompactForm island-jump)))
          (+= plan-count 3)
          (+= offset 12)
          (else
            (= ([] plan plan-count) (call PlanEntry id (. CompactForm instruction)))
            (+= plan-count 1)
            (+= offset 4)
          )
        )
        (if records-calls
          (= ([] call-ends id) offset)
        )
        (lazy test-island (and uses-test-islands (or (== opcode .tbz) (== opcode .tbnz))))
      )
    )
    (blank)
    (if (!= (. function jump-tables length) 0)
      (= offset (/and/ (+ offset 7) 0xfffffff8))
      (for (in table (. function jump-tables))
        (call (. labels define-symbol) (. table name) offset)
        (+= offset (* (. table labels count) 4))
      )
    )
    (= text-size offset)
  )
  (fn-do _ pad-offset U32
    (param check InstructionId)
    ; Where the landing pad of a checked call starts: the target of the test after it, or, where the
    ; test was inverted to branch past the pad, the code that follows it. The test itself is not
    ; encoded, since a callee returning a panic returns into the pad, and an inverted one becomes a
    ; branch past the pad.
    (if (== (. ([] (. function instructions) check) opcode) .cbz)
      (return ([] call-ends check))
    )
    (let name no-string)
    (let operands (. ([] (. function instructions) check) operands))
    (match? ([] (. function operands) ([] operands (- (. operands length) 1)))
      (case (call .label-operand operand)
        (= name (. operand name))
      )
    )
    (let offset (call (. labels block-offset) name))
    (throw (call Panic (str "Landing pad " (call name-string bundle function name) " has no offset")) (if (or (== name no-string) (== offset no-label))))
    (return offset)
  )
  (fn-do _ record-trace-line _
    (param offset U32)
    (param id LocId)
    (if (== id no-loc)
      (return)
    )
    (let loc ([] (. function locs) id))
    (if (not (. loc is-known))
      (return)
    )
    (let file (call (. bundle non-empty) (. loc file)))
    (if (!= line-count 0)
      (let last ([] lines (- line-count 1)))
      (if (and (== (. last file) file) (== (. last line) (. loc line)) (== (. last column) (. loc column)))
        (return)
      )
    )
    (= ([] lines line-count) (call CompactLineRecord offset file (. loc line) (. loc column)))
    (+= line-count 1)
  )
  (fn-do _ encode-text U32
    (param code (of CPointer Byte))
    (param relocations (of CPointer Relocation))
    (let words (as code (of CPointer U32)))
    (let relocation-count U32)
    (for (in index (..< 0 plan-count))
      (let entry ([] plan index))
      (let offset (* index 4))
      (let word U32)
      (if (== (. entry form) (. CompactForm instruction))
        (= word (call (. encoder encode) (. entry instruction) offset))
        (else-if (== (. entry form) (. CompactForm island-test))
          (= word (call (. encoder conditional-branch-to) (. entry instruction) (+ offset 8) offset))
        )
        (else-if (== (. entry form) (. CompactForm island-skip))
          (= word (call (. encoder branch-to) (+ offset 8) offset))
        )
        (else
          (= word (call (. encoder jump-to) (call (. encoder branch-target) (. entry instruction)) offset))
        )
      )
      (= ([] words index) word)
      (if (. encoder has-relocation)
        (= ([] relocations relocation-count)
          (call Relocation
            (block
              (arg (. encoder relocation-offset))
              (arg (. encoder relocation-symbol))
              (arg (. encoder relocation-kind))
            )
          )
        )
        (+= relocation-count 1)
      )
    )
    (blank)
    (if (!= (. function jump-tables length) 0)
      (if (!= (% plan-count 2) 0)
        (= ([] words plan-count) 0)
      )
      (for (in table (. function jump-tables))
        (let table-offset (call (. labels symbol-offset) (. table name)))
        (let entries (as (+ code table-offset) (of CPointer I32)))
        (for (in index (..< 0 (. table labels count)))
          (let name ([] (. function names) (+ (. table labels start) index)))
          (let target (call (. labels label-offset) name))
          (throw (call Panic (str "Missing jump-table target label " (call name-string bundle function name))) (if (== target no-label)))
          (= ([] entries index) (- (as target I32) (as table-offset I32)))
        )
      )
    )
    (return relocation-count)
  )
  (fn-do _ root-location CompactRootLocation
    (param id U32)
    (match ([] (. function roots) id)
      (case (call .register-root root)
        (return (call CompactRootLocation root-register (call gc-register-number (. root register)) 0 no-string))
      )
      (case (call .stack-root root)
        (throw (call Panic "GC stack root refers to a frame object outside its slot") (if (== (. root object) no-frame-object)))
        (let object ([] (. function frame-objects) (. root object)))
        (throw (call Panic "GC stack root refers to a frame object outside its slot") (if (< (. object index) 0)))
        (let descriptor (call (. bundle non-empty) (. root gc-descriptor)))
        (if (== descriptor no-string)
          (return (call CompactRootLocation root-stack-untyped 0 (. object offset) no-string))
        )
        (if (and (== (. root gc-root-mode) .address-root) (call is-struct (. object type)))
          (return (call CompactRootLocation root-stack-address 0 (. object offset) descriptor))
        )
        (return (call CompactRootLocation root-stack-value 0 (. object offset) descriptor))
      )
    )
  )
  (fn-do _ is-struct Bool
    (param id MIRTypeId)
    (match? ([] (. function types) id)
      (case .struct-type
        (return true)
      )
    )
    (return false)
  )
  (fn-expr _ gc-register-number U32
    (param register RegisterId)
    (before
      (throw (call Panic (str "GC metadata cannot describe register " register)) (if (or (!= (call register-class register) .gpr64) (< number 0) (> number 30))))
    )
    (as number U32)
    (where
      (lazy number (call register-number register))
    )
  )
)

(fn-do + compact-record-text _
  (param out TextBuffer)
  (param bundle Bundle)
  (param compact CompactFunction)
  (call (. out text) "record ")
  (call (. out span) (call (. bundle string) (. compact symbol)))
  (call (. out text) " order=")
  (call (. out unsigned) (. compact order))
  (if (. compact is-external)
    (call (. out text) " external")
  )
  (call (. out text) "\ndisplay ")
  (call (. out escaped) (call (. bundle string) (. compact display-name)))
  (call (. out text) "\nsource ")
  (call file-text out bundle (. compact source-file))
  (call (. out byte) 58)
  (call (. out signed) (. compact source-line))
  (call (. out byte) 58)
  (call (. out signed) (. compact source-column))
  (call (. out byte) 10)
  (let offset Size 0)
  (while (< offset (. compact code length))
    (let count (- (. compact code length) offset))
    (if (> count 32)
      (= count 32)
    )
    (call (. out text) "code ")
    (call (. out unsigned) (as offset U64))
    (call (. out text) ": ")
    (call (. out hex) (call ByteSpan (+ (. compact code data) offset) count))
    (call (. out byte) 10)
    (+= offset 32)
  )
  (for (in index (..< 0 (. compact relocation-count)))
    (let relocation ([] (. compact relocations) index))
    (call (. out text) "reloc ")
    (call (. out unsigned) (. relocation offset))
    (call (. out byte) 32)
    (call (. out text) ([] relocation-kind-names (. relocation kind)))
    (call (. out byte) 32)
    (call (. out span) (call (. bundle string) (. relocation symbol)))
    (call (. out byte) 10)
  )
  (for (in index (..< 0 (. compact jump-table-count)))
    (let table ([] (. compact jump-tables) index))
    (call (. out text) "jump-table ")
    (call (. out span) (call (. bundle string) (. table name)))
    (call (. out byte) 32)
    (call (. out unsigned) (. table offset))
    (call (. out byte) 10)
  )
  (for (in index (..< 0 (. compact line-record-count)))
    (let line ([] (. compact line-records) index))
    (call (. out text) "line ")
    (call (. out unsigned) (. line pc-offset))
    (call (. out byte) 32)
    (call file-text out bundle (. line file))
    (call (. out byte) 58)
    (call (. out signed) (. line line))
    (call (. out byte) 58)
    (call (. out signed) (. line column))
    (call (. out byte) 10)
  )
  (for (in index (..< 0 (. compact safepoint-count)))
    (let safepoint ([] (. compact safepoints) index))
    (call (. out text) "safepoint ")
    (call (. out unsigned) (. safepoint pc-offset))
    (call (. out byte) 32)
    (for (in position (..< 0 (. safepoint location-count)))
      (let location ([] (. compact locations) (+ (. safepoint first-location) position)))
      (if (!= position 0)
        (call (. out byte) 32)
      )
      (call (. out unsigned) (. location kind))
      (call (. out byte) 58)
      (call (. out unsigned) (. location register))
      (call (. out byte) 58)
      (call (. out signed) (. location offset))
      (call (. out byte) 58)
      (call file-text out bundle (. location descriptor))
    )
    (call (. out byte) 10)
  )
  (for (in index (..< 0 (. compact saved-register-count)))
    (let saved ([] (. compact saved-registers) index))
    (call (. out text) "saved x")
    (call (. out unsigned) (. saved register))
    (call (. out byte) 64)
    (call (. out signed) (. saved fp-offset))
    (call (. out byte) 10)
  )
)

(fn-do + write-compact-record _
  (param writer BinaryWriter)
  (param bundle Bundle)
  (param compact CompactFunction)
  (call (. writer u32) (. compact order))
  (call write-string writer bundle (. compact symbol))
  (call (. writer u32) (if-expr (. compact is-external) 1 0))
  (call (. writer u32) (as (. compact code length) U32))
  (call (. writer bytes) (. compact code))
  (call (. writer align) 4)
  (call (. writer u32) (. compact relocation-count))
  (for (in index (..< 0 (. compact relocation-count)))
    (let relocation ([] (. compact relocations) index))
    (call (. writer u32) (. relocation offset))
    (call write-string writer bundle (. relocation symbol))
    (call (. writer u32) (. relocation kind))
  )
  (call (. writer u32) (. compact jump-table-count))
  (for (in index (..< 0 (. compact jump-table-count)))
    (let table ([] (. compact jump-tables) index))
    (call write-string writer bundle (. table name))
    (call (. writer u32) (. table offset))
  )
  (call write-string writer bundle (. compact display-name))
  (call write-string writer bundle (. compact source-file))
  (call (. writer i32) (. compact source-line))
  (call (. writer i32) (. compact source-column))
  (call (. writer u32) (. compact line-record-count))
  (for (in index (..< 0 (. compact line-record-count)))
    (let line ([] (. compact line-records) index))
    (call (. writer u32) (. line pc-offset))
    (call write-string writer bundle (. line file))
    (call (. writer i32) (. line line))
    (call (. writer i32) (. line column))
  )
  (call (. writer u32) (. compact safepoint-count))
  (for (in index (..< 0 (. compact safepoint-count)))
    (let safepoint ([] (. compact safepoints) index))
    (call (. writer u32) (. safepoint pc-offset))
    (call (. writer u32) (. safepoint location-count))
    (for (in position (..< 0 (. safepoint location-count)))
      (let location ([] (. compact locations) (+ (. safepoint first-location) position)))
      (call (. writer u32) (. location kind))
      (call (. writer u32) (. location register))
      (call (. writer i32) (. location offset))
      (call write-string writer bundle (. location descriptor))
    )
  )
  (call (. writer u32) (. compact saved-register-count))
  (for (in index (..< 0 (. compact saved-register-count)))
    (let saved ([] (. compact saved-registers) index))
    (call (. writer u32) (. saved register))
    (call (. writer i32) (. saved fp-offset))
  )
)

(type _ CompactForm (is U32)
  (variant instruction)
  (variant island-test)
  (variant island-skip)
  (variant island-jump)
)

(type _ PlanEntry (is Tuple)
  (prop + instruction InstructionId)
  (prop + form U32)
)

(type _ PlanSafepoint (is Tuple)
  (prop + instruction InstructionId)
  (prop + offset U32)
)

(fn-do _ file-text _
  (param out TextBuffer)
  (param bundle Bundle)
  (param id StringId)
  (if (== id no-string)
    (call (. out byte) 45)
    (else
      (call (. out span) (call (. bundle string) id))
    )
  )
)

(fn-do _ write-string _
  (param writer BinaryWriter)
  (param bundle Bundle)
  (param id StringId)
  (if (== id no-string)
    (call (. writer u32) 0)
    (return)
  )
  (let span (call (. bundle string) id))
  (call (. writer u32) (as (. span length) U32))
  (call (. writer bytes) span)
  (call (. writer align) 4)
)
