(import ./builder)
(import ./mir)
(import /core/arena)
(import /core/table)

(type + MIRCriticalEdgeSplitter
  (prop _ builder MIRBuilder)
  (prop _ function MIRFunction)
  (prop _ split-counter U32)
  (prop _ split-sources IdList)
  (prop _ split-targets IdList)
  (prop _ split-edges IdList)
  (fn-do + This _
    (param builder MIRBuilder)
    (lazy function (. builder function))
  )
  (fn-do + run _
    (let arena (. function arena))
    (let original (. function block-order))
    (let order (call new-id-list arena (. original length)))
    (let marks (call (of (. arena allocate) U32) (. function blocks length)))
    (= split-counter 0)
    (= split-sources (call IdList))
    (= split-targets (call IdList))
    (= split-edges (call IdList))
    (for (in position (..< 0 (. original length)))
      (let pred ([] original position))
      (= order (call (. order appended) arena pred))
      (let successors (. ([] (. function blocks) pred) successors))
      (if (< (. successors length) 2)
        (continue)
      )
      (let mark (+ position 1))
      (let unique (call new-id-list arena (. successors length)))
      (for (in index (..< 0 (. successors length)))
        (let successor ([] successors index))
        (if (!= ([] marks successor) mark)
          (= ([] marks successor) mark)
          (= unique (call (. unique appended) arena successor))
        )
      )
      (blank)
      (let start (. order length))
      (for (in index (..< 0 (. unique length)))
        (let successor ([] unique index))
        (if (or (>= (. ([] (. function blocks) successor) predecessors length) 2) (call begins-with-phi successor))
          (= order (call (. order appended) arena (call split-edge pred successor)))
        )
      )
      (let low start)
      (let high (. order length))
      (while (< (+ low 1) high)
        (-= high 1)
        (let swapped ([] order low))
        (= ([] (. order data) low) ([] order high))
        (= ([] (. order data) high) swapped)
        (+= low 1)
      )
    )
    (= (. function block-order) order)
    (call replace-predecessors)
  )
  (fn-do _ begins-with-phi Bool
    (param block BlockId)
    ; Whether a block starts with a phi. One left with a single predecessor, where the others
    ; were never reached, still takes its copies on the edge it is entered by.
    (let instructions (. ([] (. function blocks) block) instructions))
    (if (== (. instructions length) 0)
      (return false)
    )
    (match? ([] (. function instructions) ([] instructions 0))
      (case .phi-instruction
        (return true)
      )
    )
    (return false)
  )
  (fn-do _ replace-predecessors _
    ; Gives each block that edges were split before the edge blocks in place of the blocks the
    ; edges came from. A block's splits are taken together, so its predecessors are read once
    ; however many of its edges were split.
    (let arena (. function arena))
    (let block-count (. function blocks length))
    (let count (. split-edges length))
    (let first (call (of (. arena allocate) U32) block-count))
    (let next (call (of (. arena allocate) U32) count))
    (let replacement (call (of (. arena allocate) U32) block-count))
    (let replaced-for (call (of (. arena allocate) U32) block-count))
    (for (in split (..< 0 count))
      (let target ([] split-targets split))
      (= ([] next split) ([] first target))
      (= ([] first target) (+ split 1))
    )
    (for (in split (..< 0 count))
      (let target ([] split-targets split))
      (let cursor ([] first target))
      (if (== cursor 0)
        (continue)
      )
      (= ([] first target) 0)
      (while (!= cursor 0)
        (let source ([] split-sources (- cursor 1)))
        (= ([] replacement source) ([] split-edges (- cursor 1)))
        (= ([] replaced-for source) (+ target 1))
        (= cursor ([] next (- cursor 1)))
      )
      (let predecessors (. ([] (. function blocks) target) predecessors))
      (for (in position (..< 0 (. predecessors length)))
        (let predecessor ([] predecessors position))
        (if (== ([] replaced-for predecessor) (+ target 1))
          (= ([] (. predecessors data) position) ([] replacement predecessor))
        )
      )
    )
  )
  (fn-do _ split-edge BlockId
    (param pred BlockId)
    (param succ BlockId)
    (let arena (. function arena))
    (let pred-name (. ([] (. function blocks) pred) name))
    (let succ-name (. ([] (. function blocks) succ) name))
    (let name (call (. function add-local-name) .edge-block-name pred-name succ-name split-counter))
    (+= split-counter 1)
    (let edge BlockId (as (. function blocks length) BlockId))
    (call (. function blocks append) (call MIRBlock name (call IdList) (call IdList) (call IdList)))
    (blank)
    (call replace-block (. ([] (. function blocks) pred) successors) succ edge)
    (= split-sources (call (. split-sources appended) arena pred))
    (= split-targets (call (. split-targets appended) arena succ))
    (= split-edges (call (. split-edges appended) arena edge))
    (= (. ([] (. function blocks) edge) predecessors) (call (. (call IdList) appended) arena pred))
    (= (. ([] (. function blocks) edge) successors) (call (. (call IdList) appended) arena succ))
    (blank)
    (call rewrite-branch-targets pred succ-name name)
    (call rewrite-jump-tables pred succ-name name)
    (call rewrite-phi-blocks succ pred-name name)
    (blank)
    (let branch (call (. builder new-assembly) .b (call (. builder label) succ-name)))
    (= (. ([] (. function blocks) edge) instructions) (call (. (call IdList) appended) arena branch))
    (call (. builder register-block) edge)
    (return edge)
  )
  (fn-do _ replace-block _
    (param blocks IdList)
    (param from BlockId)
    (param to BlockId)
    (for (in index (..< 0 (. blocks length)))
      (if (== ([] blocks index) from)
        (= ([] (. blocks data) index) to)
      )
    )
  )
  (fn-do _ label-name StringId
    (param operand OperandId)
    (if (== operand no-operand)
      (return no-string)
    )
    (match? ([] (. function operands) operand)
      (case (call .label-operand label)
        (return (. label name))
      )
    )
    (return no-string)
  )
  (fn-do _ rewrite-branch-targets _
    (param pred BlockId)
    (param old-name StringId)
    (param new-name StringId)
    (let instructions (. ([] (. function blocks) pred) instructions))
    (for (in index (..< 0 (. instructions length)))
      (let id ([] instructions index))
      (let operands (. ([] (. function instructions) id) operands))
      (for (in position (..< 0 (. operands length)))
        (if (== (call label-name ([] operands position)) old-name)
          (= ([] (. operands data) position) (call (. builder label) new-name))
        )
      )
      (let panic-target no-operand)
      (match? ([] (. function instructions) id)
        (case (call .call-instruction call)
          (= panic-target (. call panic-target))
        )
      )
      (if (== (call label-name panic-target) old-name)
        (let replacement (call (. builder label) new-name))
        (match? ([] (. function instructions) id)
          (case (call .call-instruction call)
            (= (. call panic-target) replacement)
          )
        )
      )
    )
  )
  (fn-do _ rewrite-jump-tables _
    (param pred BlockId)
    (param old-name StringId)
    (param new-name StringId)
    (for (in table (..< 0 (. function jump-tables length)))
      (if (not (call references pred (. ([] (. function jump-tables) table) name)))
        (continue)
      )
      (let labels (. ([] (. function jump-tables) table) labels))
      (for (in index (..< (. labels start) (. labels end)))
        (if (== ([] (. function names) index) old-name)
          (= ([] (. function names data) index) new-name)
        )
      )
    )
  )
  (fn-do _ references Bool
    (param block BlockId)
    (param name StringId)
    (let instructions (. ([] (. function blocks) block) instructions))
    (for (in index (..< 0 (. instructions length)))
      (let operands (. ([] (. function instructions) ([] instructions index)) operands))
      (for (in position (..< 0 (. operands length)))
        (if (== (call label-name ([] operands position)) name)
          (return true)
        )
      )
    )
    (return false)
  )
  (fn-do _ rewrite-phi-blocks _
    (param succ BlockId)
    (param old-name StringId)
    (param new-name StringId)
    (let instructions (. ([] (. function blocks) succ) instructions))
    (for (in index (..< 0 (. instructions length)))
      (match? ([] (. function instructions) ([] instructions index))
        (case (call .phi-instruction phi)
          (let names (. phi blocks))
          (for (in entry (..< 0 (. names length)))
            (if (== ([] names entry) old-name)
              (= ([] (. names data) entry) new-name)
            )
          )
        )
      )
    )
  )
)
