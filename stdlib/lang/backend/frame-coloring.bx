(import ./builder)
(import ./liveness)
(import ./mir)
(import ./pointer-flow)
(import /core/arena)
(import /core/table)

(type + MIRFrameColoring
  (prop _ builder MIRBuilder)
  (prop _ function MIRFunction)
  (prop _ flow MIRPointerFlow)
  (prop _ liveness MIRLiveness)
  (prop _ word-count U32)
  (prop _ block-count U32)
  (prop _ masks (of CPointer U32))
  (prop _ seen-roots (of CPointer U32))
  (prop _ seen-mask U32)
  (prop _ taken IdList)
  (prop _ narrows-roots Bool)
  (fn-do + This _
    (param builder MIRBuilder)
    (param liveness MIRLiveness)
    (param flow MIRPointerFlow)
    (param narrows-roots Bool (= true))
    ; Without `narrows-roots`, every frame object that may hold a pointer stays a root, and every
    ; one keeps its place in the frame, as the reference's backend keeps them (see
    ; `derive-lifetimes`).
    (lazy function (. builder function))
  )
  (fn-expr _ arena Arena :get @inline
    (. function arena)
  )
  (fn-do + plan _
    (let objects IdList)
    (let closure-slot (call root-slot (. function closure-root)))
    (let capture-slot (call root-slot (. function capture-closure-root)))
    (for (in position (..< 0 (. function frame-slots length)))
      (let slot ([] (. function frame-slots) position))
      (let row ([] (. function slots) slot))
      (if (or (. row is-stack) (!= (. row objects length) 1))
        (continue)
      )
      (let object ([] (. row objects) 0))
      (if (or (. ([] (. function frame-objects) object) is-spill) is-zero-size)
        (continue)
      )
      (lazy is-zero-size (== (. ([] (. function types) (. ([] (. function frame-objects) object) type)) size) 0))
      (if (or (== slot closure-slot) (== slot capture-slot))
        (continue)
      )
      (= objects (call (. objects appended) arena object))
    )
    (call derive-lifetimes objects)
  )
  (fn-expr _ root-slot MIRSlotId
    (param object FrameObjectId)
    (if-expr (== object no-frame-object) no-id (. ([] (. function frame-objects) object) slot))
  )
  (fn-do _ derive-lifetimes _
    (param objects IdList)
    ; Gives each frame object whose address does not escape the positions it lives over. With
    ; `narrows-roots`, one that no code refers to, as a variable promoted to registers, leaves its
    ; slot and takes no place in the frame. It and one that lives over no call where the collector
    ; may run hold no root, and no safepoint lists them.
    (call (. flow run-objects) (. liveness blocks) objects)
    (let candidates IdList)
    (for (in root (..< 0 (. objects length)))
      (if (!= ([] (. flow escapes) root) 0)
        (continue)
      )
      (if (!= (. ([] (. flow references) root) length) 0)
        (= candidates (call (. candidates appended) arena root))
        (else-if narrows-roots
          (let object ([] objects root))
          (= (. ([] (. function frame-objects) object) gc-root) false)
          (= (. ([] (. function slots) (. ([] (. function frame-objects) object) slot)) objects) (call IdList))
        )
      )
    )
    (let count (. candidates length))
    (= word-count (/ (+ count 31) 32))
    (if (== word-count 0)
      (return)
    )
    (= block-count (. liveness blocks length))
    (throw (call Panic (str "A function with " block-count " blocks and " count " frame objects is too large to color")) (if (> (* (as block-count U64) count) 0xffffffff)))
    (let total (* block-count word-count))
    (= masks (call (of (. arena allocate) U32) total))
    (let locals (call new-id-map arena count))
    (let local-ranges IdList)
    (for (in id (..< 0 count))
      (let references ([] (. flow references) ([] candidates id)))
      (for (in index (..< 0 (. references length)))
        (let position (as (. ([] (. function instructions) ([] references index)) position) U32))
        (let block (call block-of-position position))
        (let key (+ (* block count) id))
        (let entry (call (. locals get) key))
        (if (== entry no-id)
          (= locals (call (. locals inserted) arena key (. local-ranges length)))
          (= local-ranges (call (. local-ranges appended) arena position))
          (= local-ranges (call (. local-ranges appended) arena (+ position 1)))
          (else
            (if (< position ([] local-ranges entry))
              (= ([] (. local-ranges data) entry) position)
            )
            (if (> (+ position 1) ([] local-ranges (+ entry 1)))
              (= ([] (. local-ranges data) (+ entry 1)) (+ position 1))
            )
          )
        )
        (call set-bit (+ masks (* block word-count)) id)
      )
    )
    (blank)
    (let reached-before (call reach true))
    (let reached-after (call reach false))
    (let lifetimes (call (of (. arena allocate) IdList) count))
    (for (in block (..< 0 block-count))
      (let block-mask (+ masks (* block word-count)))
      (let block-before (+ reached-before (* block word-count)))
      (let block-after (+ reached-after (* block word-count)))
      (for (in word (..< 0 word-count))
        (let bits (/or/ ([] block-mask word) (/and/ ([] block-before word) ([] block-after word))))
        (let id (* word 32))
        (while (!= bits 0)
          (if (!= (/and/ bits 1) 0)
            (let entry (call (. locals get) (+ (* block count) id)))
            (let start ([] (. liveness block-start) block))
            (if (not (call has-bit block-before id))
              (= start ([] local-ranges entry))
            )
            (let end ([] (. liveness block-end) block))
            (if (not (call has-bit block-after id))
              (= end ([] local-ranges (+ entry 1)))
            )
            (let ranges ([] lifetimes id))
            (if (and (!= (. ranges length) 0) (>= ([] ranges (- (. ranges length) 1)) start))
              (= ([] (. ranges data) (- (. ranges length) 1)) end)
              (else
                (= ranges (call (. ranges appended) arena start))
                (= ([] lifetimes id) (call (. ranges appended) arena end))
              )
            )
          )
          (= bits (/zrshift/ bits 1))
          (+= id 1)
        )
      )
    )
    (blank)
    (let flat (. function lifetimes))
    (for (in id (..< 0 count))
      (let ranges ([] lifetimes id))
      (let first (. flat length))
      (for (in index (..< 0 (. ranges length)))
        (= flat (call (. flat appended) arena ([] ranges index)))
      )
      (= (. ([] (. function frame-objects) ([] objects ([] candidates id))) lifetime) (call Span first (. ranges length)))
    )
    (= (. function lifetimes) flat)
    (if (not narrows-roots)
      (return)
    )
    (let safepoints (call safepoint-positions))
    (for (in id (..< 0 count))
      (if (not (call crosses-safepoint ([] lifetimes id) safepoints))
        (= (. ([] (. function frame-objects) ([] objects ([] candidates id))) gc-root) false)
      )
    )
  )
  (fn-do _ safepoint-positions IdList
    (let positions IdList)
    (let calls (. liveness call-instructions))
    (for (in index (..< 0 (. calls length)))
      (if (. ([] (. function instructions) ([] calls index)) gc-safepoint)
        (= positions (call (. positions appended) arena (as (. ([] (. function instructions) ([] calls index)) position) U32)))
      )
    )
    (return positions)
  )
  (fn-do _ crosses-safepoint Bool
    (param ranges IdList)
    (param safepoints IdList)
    (let cursor U32)
    (while (< cursor (. ranges length))
      (let low U32)
      (let high (. safepoints length))
      (while (< low high)
        (let middle (/ (+ low high) 2))
        (if (< ([] safepoints middle) ([] ranges cursor))
          (= low (+ middle 1))
          (else
            (= high middle)
          )
        )
      )
      (if (and (< low (. safepoints length)) (< ([] safepoints low) ([] ranges (+ cursor 1))))
        (return true)
      )
      (+= cursor 2)
    )
    (return false)
  )
  (fn-do _ block-of-position U32
    (param position U32)
    (let low U32)
    (let high (- block-count 1))
    (while (< low high)
      (let middle (/ (+ low high 1) 2))
      (if (<= ([] (. liveness block-start) middle) position)
        (= low middle)
        (else
          (= high (- middle 1))
        )
      )
    )
    (return low)
  )
  (fn-do _ reach (of CPointer U32)
    (param is-forward Bool)
    (let total (* block-count word-count))
    (let incoming (call (of (. arena allocate) U32) total))
    (let outgoing (call (of (. arena allocate) U32) total))
    (for (in index (..< 0 total))
      (= ([] outgoing index) ([] masks index))
    )
    (let pending (call new-id-list arena block-count))
    (let queued (call (of (. arena allocate) Byte) block-count))
    (for (in index (..< 0 block-count))
      (= pending (call (. pending appended) arena (if-expr is-forward index (- block-count index 1))))
      (= ([] queued index) 1)
    )
    (let cursor U32)
    (while (< cursor (. pending length))
      (let index ([] pending cursor))
      (+= cursor 1)
      (= ([] queued index) 0)
      (let block ([] (. function blocks) ([] (. liveness blocks) index)))
      (let adjacent (if-expr is-forward (. block successors) (. block predecessors)))
      (let source (+ outgoing (* index word-count)))
      (for (in position (..< 0 (. adjacent length)))
        (let target ([] (. liveness block-index) ([] adjacent position)))
        (if (== target no-id)
          (continue)
        )
        (let target-incoming (+ incoming (* target word-count)))
        (let target-outgoing (+ outgoing (* target word-count)))
        (let target-mask (+ masks (* target word-count)))
        (let changed false)
        (for (in word (..< 0 word-count))
          (let combined (/or/ ([] target-incoming word) ([] source word)))
          (if (!= combined ([] target-incoming word))
            (= ([] target-incoming word) combined)
            (let next (/or/ combined ([] target-mask word)))
            (if (!= next ([] target-outgoing word))
              (= changed true)
            )
            (= ([] target-outgoing word) next)
          )
        )
        (if (and changed (== ([] queued target) 0))
          (= ([] queued target) 1)
          (= pending (call (. pending appended) arena target))
        )
      )
    )
    (return incoming)
  )
  (fn-do + pack-frame-objects U32
    (param original-size U32)
    ; Gives each frame object with a lifetime the lowest place that no object placed before it
    ; disputes, taking them in the order their lifetimes start. An object placed is compared
    ; again only while it can still decide a place: the first to take its bytes, which answers
    ; for every later one that shares them, and any whose lifetime has not ended where the next
    ; one starts. The place tried only rises, so an object it has passed is left out of the
    ; rest of that object's search.
    (let records IdList)
    (for (in position (..< 0 (. function frame-slots length)))
      (let objects (. ([] (. function slots) ([] (. function frame-slots) position)) objects))
      (for (in index (..< 0 (. objects length)))
        (= records (call (. records appended) arena ([] objects index)))
      )
    )
    (let candidates IdList)
    (for (in index (..< 0 (. records length)))
      (if (!= (. ([] (. function frame-objects) ([] records index)) lifetime count) 0)
        (= candidates (call (. candidates appended) arena ([] records index)))
      )
    )
    (let count (. candidates length))
    (if (== count 0)
      (return original-size)
    )
    (let saved-offsets (call (of (. arena allocate) I32) (. records length)))
    (for (in index (..< 0 (. records length)))
      (= ([] saved-offsets index) (. ([] (. function frame-objects) ([] records index)) offset))
    )
    (let starts (call (of (. arena allocate) U32) count))
    (for (in index (..< 0 count))
      (= ([] starts index) ([] (. function lifetimes) (. ([] (. function frame-objects) ([] candidates index)) lifetime start)))
    )
    (= candidates (call stable-order arena candidates starts))
    (blank)
    (let placed-start (call (of (. arena allocate) U32) count))
    (let placed-end (call (of (. arena allocate) U32) count))
    (let placed-last (call (of (. arena allocate) U32) count))
    (let leads (call (of (. arena allocate) Byte) count))
    (let compared (call (of (. arena allocate) U32) count))
    (let following (call (of (. arena allocate) U32) count))
    (let compared-count U32)
    (let limit U32 8)
    (for (in position (..< 0 count))
      (let object ([] candidates position))
      (let type (. ([] (. function frame-objects) object) type))
      (let size (call (. builder frame-object-size) type))
      (let alignment (call (. builder frame-object-alignment) type))
      (throw (call Panic "A frame object with a lifetime has no alignment") (if (== alignment 0)))
      (let is-root (. ([] (. function frame-objects) object) gc-root))
      (let lifetime (. ([] (. function frame-objects) object) lifetime))
      (let begins ([] (. function lifetimes) (. lifetime start)))
      (let kept U32)
      (for (in slot (..< 0 compared-count))
        (let index ([] compared slot))
        (if (or (!= ([] leads index) 0) (> ([] placed-last index) begins))
          (= ([] compared kept) index)
          (+= kept 1)
        )
      )
      (= compared-count kept)
      (for (in slot (..< 0 compared-count))
        (= ([] following slot) (+ slot 1))
      )
      (let first U32)
      (let end (call align (+ 8 size) alignment))
      (let shares false)
      (while true
        (let conflict no-id)
        (= shares false)
        (let kept-slot no-id)
        (let slot first)
        (while (< slot compared-count)
          (let index ([] compared slot))
          (let other-end ([] placed-end index))
          (if (>= (- end size) other-end)
            (if (== kept-slot no-id)
              (= first ([] following slot))
              (else
                (= ([] following kept-slot) ([] following slot))
              )
            )
            (= slot ([] following slot))
            (continue)
          )
          (= kept-slot slot)
          (= slot ([] following slot))
          (if (<= end ([] placed-start index))
            (continue)
          )
          (let other ([] candidates index))
          (let other-is-root (. ([] (. function frame-objects) other) gc-root))
          (let paired (and is-root other-is-root (== end other-end)))
          (if (and (or is-root other-is-root) (not paired))
            (= conflict index)
            (break)
          )
          (if (call lifetimes-overlap lifetime (. ([] (. function frame-objects) other) lifetime))
            (= conflict index)
            (break)
          )
          (if (and paired (not (call has-same-shape object other)))
            (= conflict index)
            (break)
          )
          (if (and (== is-root other-is-root) (== end other-end) (== (- end size) ([] placed-start index)))
            (= shares true)
          )
        )
        (if (== conflict no-id)
          (break)
        )
        (= end (call align (+ ([] placed-end conflict) size) alignment))
      )
      (= (. ([] (. function frame-objects) object) offset) (- 0 (as end I32)))
      (if (> end limit)
        (= limit end)
      )
      (= ([] placed-start position) (- end size))
      (= ([] placed-end position) end)
      (= ([] placed-last position) ([] (. function lifetimes) (- (. lifetime end) 1)))
      (= ([] leads position) (if-expr shares 0 1))
      (= ([] compared compared-count) position)
      (+= compared-count 1)
    )
    (blank)
    (for (in index (..< 0 (. records length)))
      (let object ([] records index))
      (if (!= (. ([] (. function frame-objects) object) lifetime count) 0)
        (continue)
      )
      (let type (. ([] (. function frame-objects) object) type))
      (let alignment (call (. builder frame-object-alignment) type))
      (if (!= alignment 0)
        (= limit (call align (+ limit (call (. builder frame-object-size) type)) alignment))
      )
      (= (. ([] (. function frame-objects) object) offset) (- 0 (as limit I32)))
    )
    (let size (call align limit 16))
    (if (> size original-size)
      (for (in index (..< 0 (. records length)))
        (= (. ([] (. function frame-objects) ([] records index)) offset) ([] saved-offsets index))
      )
      (return original-size)
    )
    (return size)
  )
  (fn-do _ lifetimes-overlap Bool
    (param left Span)
    (param right Span)
    (let ranges (. function lifetimes))
    (let a (. left start))
    (let b (. right start))
    (while (and (< a (. left end)) (< b (. right end)))
      (if (<= ([] ranges (+ a 1)) ([] ranges b))
        (+= a 2)
        (else-if (<= ([] ranges (+ b 1)) ([] ranges a))
          (+= b 2)
        )
        (else
          (return true)
        )
      )
    )
    (return false)
  )
  (fn-expr _ has-same-shape Bool
    (param left FrameObjectId)
    (param right FrameObjectId)
    (and (== (. a gc-descriptor) (. b gc-descriptor)) (== (. a gc-root-mode) (. b gc-root-mode)) same-type)
    (where
      (lazy a ([] (. function frame-objects) left))
      (lazy b ([] (. function frame-objects) right))
      (lazy same-type (call has-same-type (. a type) (. b type)))
    )
  )
  (fn-do _ has-same-type Bool
    (param left MIRTypeId)
    (param right MIRTypeId)
    (if (== left right)
      (return true)
    )
    (if (!= (. ([] (. function types) left) size) (. ([] (. function types) right) size))
      (return false)
    )
    (if (!= (. ([] (. function types) left) alignment) (. ([] (. function types) right) alignment))
      (return false)
    )
    (match ([] (. function types) left)
      (case .void-type
        (match? ([] (. function types) right)
          (case .void-type
            (return true)
          )
        )
      )
      (case (call .int-type first)
        (match? ([] (. function types) right)
          (case (call .int-type second)
            (return
              (scope (and same-bit-size (== (. first is-signed) (. second is-signed)) same-class)
                (lazy same-bit-size (== (. first bit-size) (. second bit-size)))
                (lazy same-class (== (. first reg-class) (. second reg-class)))
              )
            )
          )
        )
      )
      (case (call .float-type first)
        (match? ([] (. function types) right)
          (case (call .float-type second)
            (return (and (== (. first bit-size) (. second bit-size)) (== (. first reg-class) (. second reg-class))))
          )
        )
      )
      (case (call .pointer-type first)
        (match? ([] (. function types) right)
          (case (call .pointer-type second)
            (return (== (. first reg-class) (. second reg-class)))
          )
        )
      )
      (case (call .array-type first)
        (match? ([] (. function types) right)
          (case (call .array-type second)
            (return (and (== (. first length) (. second length)) (call has-same-type (. first item) (. second item))))
          )
        )
      )
      (case (call .struct-type first)
        (match? ([] (. function types) right)
          (case (call .struct-type second)
            (if (or (!= (. first format) (. second format)) (!= (. first fields count) (. second fields count)))
              (return false)
            )
            (for (in index (..< 0 (. first fields count)))
              (let x ([] (. function struct-fields) (+ (. first fields start) index)))
              (let y ([] (. function struct-fields) (+ (. second fields start) index)))
              (if (or (!= (. x offset) (. y offset)) (not (call has-same-type (. x type) (. y type))))
                (return false)
              )
            )
            (return true)
          )
        )
      )
    )
    (return false)
  )
  (fn-do + deduplicate-roots _
    ; Leaves each root once among the function's and once among each instruction's, in the order
    ; they were first listed. The roots seen are kept in a table that a root's own key leads
    ; to: the function's stay in it, and an instruction's are taken out when it is done.
    (if (== (. function lifetimes length) 0)
      (return)
    )
    (let order (. function block-order))
    (let most (. function gc-roots count))
    (for (in position (..< 0 (. order length)))
      (let instructions (. ([] (. function blocks) ([] order position)) instructions))
      (for (in index (..< 0 (. instructions length)))
        (let id ([] instructions index))
        (if (not (. ([] (. function instructions) id) has-gc-roots))
          (continue)
        )
        (let listed (+ (. function gc-roots count) (. ([] (. function instructions) id) gc-roots count)))
        (if (> listed most)
          (= most listed)
        )
      )
    )
    (let capacity U32 8)
    (while (< capacity (* most 2))
      (*= capacity 2)
    )
    (= seen-roots (call (of (. arena allocate) U32) capacity))
    (= seen-mask (- capacity 1))
    (= taken (call IdList))
    (= (. function gc-roots) (call unique-roots (. function gc-roots)))
    (= taken (call IdList))
    (for (in position (..< 0 (. order length)))
      (let instructions (. ([] (. function blocks) ([] order position)) instructions))
      (for (in index (..< 0 (. instructions length)))
        (let id ([] instructions index))
        (if (not (. ([] (. function instructions) id) has-gc-roots))
          (continue)
        )
        (= (. ([] (. function instructions) id) gc-roots) (call unique-roots (. ([] (. function instructions) id) gc-roots)))
        (for (in entry (..< 0 (. taken length)))
          (= ([] seen-roots ([] taken entry)) 0)
        )
        (= taken (call IdList (. taken data) 0 (. taken capacity)))
      )
    )
  )
  (fn-do _ unique-roots Span
    (param roots Span)
    (let first (. function roots length))
    (for (in root (..< (. roots start) (. roots end)))
      (let slot (call root-slot root))
      (let is-seen false)
      (while (!= ([] seen-roots slot) 0)
        (if (call is-same-root (- ([] seen-roots slot) 1) root)
          (= is-seen true)
          (break)
        )
        (= slot (/and/ (+ slot 1) seen-mask))
      )
      (if is-seen
        (continue)
      )
      (= ([] seen-roots slot) (+ root 1))
      (= taken (call (. taken appended) arena slot))
      (match ([] (. function roots) root)
        (case (call .register-root row)
          (call (. function roots append) (call RegisterRoot (. row register)))
        )
        (case (call .stack-root row)
          (call (. function roots append) (call StackRoot (. row object) (. row gc-descriptor) (. row gc-root-mode)))
        )
      )
    )
    (return (call Span (as first U32) (as (- (. function roots length) first) U32)))
  )
  (fn-do _ root-slot U32
    (param root U32)
    ; Where the table starts to look for a root: by what `is-same-root` compares.
    (let key U32)
    (match ([] (. function roots) root)
      (case (call .register-root row)
        (= key (* (. row register) 2))
      )
      (case (call .stack-root row)
        (let offset (as (. ([] (. function frame-objects) (. row object)) offset) U32))
        (= key (+ (* (+ (* (+ (* offset 31) (. row gc-descriptor)) 31) (as (. row gc-root-mode) U32)) 2) 1))
      )
    )
    (let hash (* key 2654435769))
    (return (/and/ (/xor/ hash (/zrshift/ hash 16)) seen-mask))
  )
  (fn-do _ is-same-root Bool
    (param left U32)
    (param right U32)
    (match ([] (. function roots) left)
      (case (call .register-root a)
        (match? ([] (. function roots) right)
          (case (call .register-root b)
            (return (== (. a register) (. b register)))
          )
        )
      )
      (case (call .stack-root a)
        (match? ([] (. function roots) right)
          (case (call .stack-root b)
            (return (and (== (. a gc-descriptor) (. b gc-descriptor)) (== (. a gc-root-mode) (. b gc-root-mode)) (== (. ([] (. function frame-objects) (. a object)) offset) (. ([] (. function frame-objects) (. b object)) offset))))
          )
        )
      )
    )
    (return false)
  )
)

(fn-expr _ align U32
  (param value U32)
  (param alignment U32)
  (* (/ (- (+ value alignment) 1) alignment) alignment)
)
