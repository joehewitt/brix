(import ./mir)
(import /core/arena)
(import /string.h)

(type + BinaryWriter
  (prop + data (of CPointer Byte))
  (prop + length Size)
  (prop _ capacity Size)
  (prop _ arena Arena)
  (fn-do + This _
    (param arena Arena)
    (param initial-capacity Size (= 4096))
    (= capacity initial-capacity)
    (= data (call (. arena allocate-raw) initial-capacity 8))
  )
  (fn-expr + view ByteSpan :get
    (call ByteSpan data length)
  )
  (fn-do + clear _
    (= length 0)
  )
  (fn-do _ reserve _ @inline
    (param count Size)
    (if (> (+ length count) capacity)
      (call grow (+ length count))
    )
  )
  (fn-do _ grow _
    (param needed Size)
    (let next (if-expr (>= capacity 64) (* capacity 2) 64))
    (while (< next needed)
      (*= next 2)
    )
    (let replacement (call (. arena allocate-raw) next 8))
    (call C:memcpy replacement data length)
    (= data replacement)
    (= capacity next)
  )
  (fn-do + u8 _
    (param value U32)
    (call reserve 1)
    (= ([] data length) (as (/and/ value 0xff) Byte))
    (+= length 1)
  )
  (fn-do + u16 _
    (param value U32)
    (call reserve 2)
    (let target (as (+ data length) (of CPointer U16)))
    (= ([] target 0) (as (/and/ value 0xffff) U16))
    (+= length 2)
  )
  (fn-do + u32 _
    (param value U32)
    (call reserve 4)
    (let target (as (+ data length) (of CPointer U32)))
    (= ([] target 0) value)
    (+= length 4)
  )
  (fn-do + put-u32 _
    (param value U32)
    (param offset Size)
    (let target (as (+ data offset) (of CPointer U32)))
    (= ([] target 0) value)
  )
  (fn-do + i32 _
    (param value I32)
    (call reserve 4)
    (let target (as (+ data length) (of CPointer I32)))
    (= ([] target 0) value)
    (+= length 4)
  )
  (fn-do + u64 _
    (param value U64)
    (call reserve 8)
    (let target (as (+ data length) (of CPointer U64)))
    (= ([] target 0) value)
    (+= length 8)
  )
  (fn-do + bytes _
    (param value ByteSpan)
    (call reserve (. value length))
    (call C:memcpy (+ data length) (. value data) (. value length))
    (+= length (. value length))
  )
  (fn-do + text _
    (param value String)
    (call bytes (call ByteSpan value (. value size)))
  )
  (fn-do + zeros _
    (param count Size)
    (call reserve count)
    (call C:memset (+ data length) 0 count)
    (+= length count)
  )
  (fn-do + align _
    (param alignment Size)
    (let mask (- alignment 1))
    (throw (call Panic (str "Alignment must be a power of two: " alignment)) (if (or (== alignment 0) (!= (/and/ alignment mask) 0))))
    (call zeros (- (/and/ (+ length mask) (/xor/ mask (. Size max))) length))
  )
)
