./binary-writer
./bundle
./compact
./mir
./mir-job
./mir-text
./object-builder
./object-file
./pipeline
/core/arena
/core/table
/lang/target
/os/env
/os/file
/os/path
/stream/sort

_ no-job U32 = U32.max
_ records-magic U32 = 0x52424d59
_ records-version U32 = 1
_ default-worker-count = (usable-core-count() * 2 + 2) / 3
_ functions-per-worker = 200
_ output-file-perms = user-read-perm + user-write-perm + group-read-perm + other-read-perm
_ output-mode-names [String] = ["executable", "static-lib"]
_ constant-kind-names [String] = ["byte", "short", "long", "quad", "string", "label"]
_ gc-root-kind-names [String] = ["global", "taskLocal", "threadLocal"]

━━━━━━━━━━━━━━━━━━━━
+ BackendOptions

+ bundle-path String
+ object-path String
+ records-path String
+ dump-directory String
+ dump-all-text Bool
+ dump-text [U32]
+ worker-count Int
+ through Stage = .record
+ reference Bool
+ target = host-target()

────────────────────
+ do stop-after ?! Error
    - name String

for index in 0 .. < stage-names.length
    if stage-names[index] == name
        through = index as Stage
        =
?! Error("Unknown stage $name")

────────────────────
+ dumps-text Bool
    - order U32

dump-directory.size != 0 && (dump-all-text || dump-text has order)

━━━━━━━━━━━━━━━━━━━━
_ JobQueue

_ lock Mutex
_ positions [U32]
_ cursor Size

────────────────────
+ This
    - bundle Bundle

. keys [U64]
for position in 0 .. < bundle.functions.length
    . words U64 = bundle.functions[position].word-count
    keys += (words /lshift/ 32) /or/ (position as U64)
. sorted = sort(keys)
for index in 0 .. < sorted.length
    positions += (sorted[sorted.length - 1 - index] /and/ 0xffffffff) as U32

────────────────────
+ do take U32

use lock
if cursor == positions.length
    = no-job
. position = positions[cursor]
cursor += 1
= position

━━━━━━━━━━━━━━━━━━━━
_ BackendWorker

_ bundle Bundle
_ options BackendOptions
_ queue JobQueue
_ dumps Array'FunctionDump
_ records CPointer'CompactFunction
_ decoder JobDecoder
+ pipeline FunctionPipeline

────────────────────
+ This
    - bundle Bundle
    - options BackendOptions
    - queue JobQueue
    - dumps Array'FunctionDump
    - records CPointer'CompactFunction

.. pipeline = FunctionPipeline
    - bundle
    - options.through
    - options.dump-directory.size != 0
    - options.reference
.. decoder = JobDecoder(pipeline.function)

────────────────────
+ do release

pipeline.release()

────────────────────
+ do run

while true
    . position = queue.take()
    if position == no-job
        break
    compile(position)

────────────────────
_ do compile
    - position U32

. record = bundle.functions[position]
pipeline.begin(options.dumps-text(record.order))
decoder.decode(record)
if pipeline.lower()
    records[position] = pipeline.encode()
dumps[position] = pipeline.finished-dump()

━━━━━━━━━━━━━━━━━━━━
+ do run-backend ?! Error
    - options BackendOptions

. bundle = use read-bundle(options.bundle-path)
bundle.apple-abi = options.target.uses-apple-abi
. function-count = bundle.functions.length
. count = worker-count(options, function-count)
. queue = JobQueue(bundle)
. dumps = Array'FunctionDump(function-count)
. arena = use Arena()
. records = arena.allocate'CompactFunction(function-count)
. workers [BackendWorker]
for _ in 0 .. < count
    workers += BackendWorker(bundle, options, queue, dumps, records)
do finally
    for worker in workers
        worker.release()

. pool = Worker(count)
. finished SyncBufferedChannel'Bool
for worker in workers
    do (pool) new
        worker.run()
        finished <- true
for _ in 0 .. < count
    <- finished
pool.stop()

. built = MIRCounts()
. allocated = MIRCounts()
for worker in workers
    built.add(worker.pipeline.built)
    allocated.add(worker.pipeline.allocated)
//lang.backend.mir.program.pre -> built.functions, built.blocks, built.instructions, built.frame-bytes
//lang.backend.mir.program.alloc -> allocated.functions, allocated.blocks, allocated.instructions, allocated.frame-bytes

. ordered = ordered-positions(bundle)
if options.dump-directory.size != 0
    write-dump(bundle, options, dumps, ordered)
if options.records-path.size != 0
    write-records(bundle, options.records-path, records, ordered)
if options.object-path.size != 0
    ?! Error("No object can be written when functions stop after ${stage-names[options.through]}")
        if options.through != .record
    . builder = use ObjectBuilder(bundle)
    builder.build(records, ordered)
    write-file(options.object-path, object-file(builder, options.target))

━━━━━━━━━━━━━━━━━━━━
_ do ordered-positions [U32]
    - bundle Bundle

. keys [U64]
for position in 0 .. < bundle.functions.length
    . order U64 = bundle.functions[position].order
    keys += (order /lshift/ 32) /or/ (position as U64)
. sorted = sort(keys)
. positions [U32]
for key in sorted
    positions += (key /and/ 0xffffffff) as U32
= positions

━━━━━━━━━━━━━━━━━━━━
_ do write-records ?! Error
    - bundle Bundle
    - path String
    - records CPointer'CompactFunction
    - ordered [U32]

. arena = use Arena()
. writer = BinaryWriter(arena, 1048576)
writer.u32(records-magic)
writer.u32(records-version)
writer.u32(ordered.length as U32)
for position in ordered
    . start = writer.length
    writer.u32(0)
    . compact = records[position]
    if compact.is-encoded
        write-compact-record(writer, bundle, compact)
    writer.put-u32((writer.length - start - 4) as U32, start)
write-file(path, writer.view)

━━━━━━━━━━━━━━━━━━━━
_ do worker-count Int
    - options BackendOptions
    - function-count Size

. count = options.worker-count
if count <= 0
    count = (function-count + functions-per-worker - 1) / functions-per-worker
    if count > default-worker-count
        count = default-worker-count
if count <= 0
    count = 1
= count

━━━━━━━━━━━━━━━━━━━━
_ do write-dump ?! Error
    - bundle Bundle
    - options BackendOptions
    - dumps Array'FunctionDump
    - ordered [U32]

. directory Path = options.dump-directory
make-directories(directory)

. out TextBuffer
for position in ordered
    . record = bundle.functions[position]
    . dump = dumps[position]
    out.unsigned(record.order)
    out.byte(32)
    out.span(bundle.string(record.label))
    for index in 0 .. < dump.stage-count
        . stage = dump.stages[index]
        out.byte(32)
        out.text(stage-names[stage.stage])
        out.byte(61)
        out.hex64(stage.hash)
    out.byte(10)
    if dump.text.length != 0
        write-file(directory / "${record.order}.txt", dump.text)
write-file(directory / "stages.txt", ByteSpan(out.bytes.data, out.length))

out.clear()
manifest-text(bundle, out)
write-file(directory / "manifest.txt", ByteSpan(out.bytes.data, out.length))

━━━━━━━━━━━━━━━━━━━━
_ do manifest-text
    - bundle Bundle
    - out TextBuffer

out.text("options gc=")
out.unsigned(if bundle.gc-enabled then 1 else 0)
out.text(" trace=")
out.unsigned(if bundle.stack-trace-metadata then 1 else 0)
out.text(" output=")
out.text(output-mode-names[bundle.output-mode])
out.text(" allocation-buffer=")
out.unsigned(bundle.gc-allocation-buffer-version)
out.byte(10)
for index in 0 .. < bundle.safepoint-free.length
    out.text("safepoint-free ")
    out.span(bundle.string(bundle.safepoint-free[index]))
    out.byte(10)
for index in 0 .. < bundle.inferred-safepoint-free.length
    out.text("inferred-safepoint-free ")
    out.span(bundle.string(bundle.inferred-safepoint-free[index]))
    out.byte(10)
for literal in bundle.literals
    out.text("string ")
    out.span(bundle.string(literal.name))
    out.text(" chars=")
    out.unsigned(literal.character-length)
    out.text(" flags=")
    out.unsigned(literal.flags)
    out.text(" bytes=")
    out.hex(literal.bytes)
    out.byte(10)
for number in bundle.numbers
    out.text("number ")
    out.span(bundle.string(number.name))
    out.text(" size=")
    out.unsigned(number.size)
    out.text(" bits=")
    out.hex64(number.bits)
    out.byte(10)
for table in bundle.constant-tables
    out.text("constants ")
    out.span(bundle.string(table.name))
    out.text(" align=")
    out.unsigned(table.alignment)
    out.byte(10)
    for index in table.items.start .. < table.items.end
        . item = bundle.constant-items[index]
        out.text("  ")
        out.text(constant-kind-names[item.kind])
        out.byte(32)
        if item.kind == .string-constant
            out.escaped(bundle.string(item.name))
        else if item.kind == .label-constant
            out.span(bundle.string(item.name))
        else
            out.unsigned(item.bits)
        out.byte(10)
for global in bundle.globals
    out.text("global ")
    out.span(bundle.string(global.name))
    out.text(" size=")
    out.unsigned(global.size)
    out.text(" align=")
    out.unsigned(global.alignment)
    out.byte(10)
for root in bundle.gc-roots
    out.text("gc-root ")
    out.text(gc-root-kind-names[root.kind])
    out.byte(32)
    if root.symbol == no-string
        out.byte(45)
    else
        out.span(bundle.string(root.symbol))
    out.byte(32)
    out.span(bundle.string(root.descriptor))
    out.byte(10)

━━━━━━━━━━━━━━━━━━━━
_ do make-directories ?! Error
    - directory Path

if !directory || directory.is-dir
    =
make-directories(directory.dir)
directory.make-directory("", 493)

━━━━━━━━━━━━━━━━━━━━
_ do write-file ?! Error
    - path Path
    - contents ByteSpan

. mode = FileFlags.write-mode + FileFlags.create-mode + FileFlags.truncate-mode
. file = use File(path, mode, output-file-perms)
if contents.length != 0
    file.write(Array'Byte(contents.data, contents.length), contents.length)
