(import ./builder)
(import ./bundle)
(import ./mir)
(import ./mir-text)
(import /core/arena)
(import /core/table)

(type _ PhiSource (is U32)
  (variant register)
  (variant int)
  (variant frame-object)
  (variant symbol)
  (variant unsupported)
)

(type + MIRPhiElimination
  (prop _ builder MIRBuilder)
  (prop _ function MIRFunction)
  (prop _ copies-by-block (of CPointer IdList))
  (prop _ copy-successors IdList)
  (prop _ copy-destinations IdList)
  (prop _ copy-sources IdList)
  (fn-do + This _
    (param builder MIRBuilder)
    (lazy function (. builder function))
  )
  (fn-do + run _
    (let arena (. function arena))
    (let order (. function block-order))
    (= copies-by-block (call (of (. arena allocate) IdList) (. function blocks length)))
    (= copy-successors (call IdList))
    (= copy-destinations (call IdList))
    (= copy-sources (call IdList))
    (for (in position (..< 0 (. order length)))
      (let block ([] order position))
      (let instructions (. ([] (. function blocks) block) instructions))
      (let kept U32)
      (for (in index (..< 0 (. instructions length)))
        (let id ([] instructions index))
        (if (== (. ([] (. function instructions) id) opcode) .phi)
          (call collect-phi-copies block id)
          (else
            (= ([] (. instructions data) kept) id)
            (+= kept 1)
          )
        )
      )
      (= (. ([] (. function blocks) block) instructions) (call IdList (. instructions data) kept (. instructions capacity)))
    )
    (blank)
    (for (in position (..< 0 (. order length)))
      (let pred ([] order position))
      (let copies ([] copies-by-block pred))
      (let start U32)
      (while (< start (. copies length))
        (let succ ([] copy-successors ([] copies start)))
        (let end (+ start 1))
        (while (and (< end (. copies length)) (== ([] copy-successors ([] copies end)) succ))
          (+= end 1)
        )
        (call emit-copies-on-edge pred succ copies start end)
        (= start end)
      )
    )
  )
  (fn-do _ collect-phi-copies _
    (param block BlockId)
    (param phi InstructionId)
    (let arena (. function arena))
    (let register no-operand)
    (let exprs IdList)
    (let names IdList)
    (match? ([] (. function instructions) phi)
      (case (call .phi-instruction row)
        (= register (. row reg))
        (= exprs (. row exprs))
        (= names (. row blocks))
      )
    )
    (for (in index (..< 0 (. names length)))
      (let pred (call (. builder get-block) ([] names index)))
      (throw (call Panic (str "Phi references missing predecessor " missing-name)) (if (== pred no-id)))
      (blank)
      (lazy missing-name (call name-string (. builder bundle) function ([] names index)))
      (let expr ([] exprs index))
      (if (call is-placeholder expr)
        (continue)
      )
      (let copy U32 (. copy-successors length))
      (= copy-successors (call (. copy-successors appended) arena block))
      (= copy-destinations (call (. copy-destinations appended) arena register))
      (= copy-sources (call (. copy-sources appended) arena expr))
      (= ([] copies-by-block pred) (call (. ([] copies-by-block pred) appended) arena copy))
    )
  )
  (fn-do _ is-placeholder Bool
    (param operand OperandId)
    (match? ([] (. function operands) operand)
      (case .placeholder-operand
        (return true)
      )
    )
    (return false)
  )
  (fn-do _ emit-copies-on-edge _
    (param pred BlockId)
    (param succ BlockId)
    (param copies IdList)
    (param start U32)
    (param end U32)
    (let arena (. function arena))
    (let pred-name (. ([] (. function blocks) pred) name))
    (let succ-name (. ([] (. function blocks) succ) name))
    (let successors (. ([] (. function blocks) pred) successors))
    (for (in index (..< 1 (. successors length)))
      (throw (call Panic (str "Phi copies for " pred-text "->" succ-text " need a split edge")) (if (!= ([] successors index) ([] successors 0))))
      (blank)
      (lazy pred-text (call name-string (. builder bundle) function pred-name))
      (lazy succ-text (call name-string (. builder bundle) function succ-name))
    )
    (blank)
    (let instructions (. ([] (. function blocks) pred) instructions))
    (let terminator (call terminator-index instructions))
    (let tail-length (- (. instructions length) terminator))
    (let tail (call (of (. arena allocate) U32) tail-length))
    (for (in index (..< 0 tail-length))
      (= ([] tail index) ([] instructions (+ terminator index)))
    )
    (= (. ([] (. function blocks) pred) instructions) (call IdList (. instructions data) terminator (. instructions capacity)))
    (call (. builder set-insert-block) pred)
    (blank)
    (let destinations (call (of (. arena allocate) U32) (- end start)))
    (let sources (call (of (. arena allocate) U32) (- end start)))
    (let count U32)
    (for (in index (..< start end))
      (let copy ([] copies index))
      (if (not (call is-same-register ([] copy-destinations copy) ([] copy-sources copy)))
        (= ([] destinations count) ([] copy-destinations copy))
        (= ([] sources count) ([] copy-sources copy))
        (+= count 1)
      )
    )
    (blank)
    (while (> count 0)
      (let ready no-id)
      (for (in index (..< 0 count))
        (let is-read false)
        (for (in other (..< 0 count))
          (if (call is-same-register ([] destinations index) ([] sources other))
            (= is-read true)
            (break)
          )
        )
        (if (not is-read)
          (= ready index)
          (break)
        )
      )
      (if (!= ready no-id)
        (let destination ([] destinations ready))
        (let source ([] sources ready))
        (-= count 1)
        (for (in index (..< ready count))
          (= ([] destinations index) ([] destinations (+ index 1)))
          (= ([] sources index) ([] sources (+ index 1)))
        )
        (call (. builder comment)
          (block
            (arg
              (call (. function add-local-name)
                (block
                  (arg .phi-copy-name)
                  (arg pred-name)
                  (arg succ-name)
                  (arg (call register-id destination))
                )
              )
            )
          )
        )
        (call emit-copy destination source)
        (continue)
      )
      (blank)
      (let saved ([] destinations 0))
      (let temporary (call (. builder vreg) (call (. builder operand-reg-class) saved)))
      (call (. builder comment)
        (block
          (arg (call (. function add-local-name) .phi-cycle-name pred-name succ-name (call register-id saved)))
        )
      )
      (call emit-copy temporary saved)
      (for (in index (..< 0 count))
        (if (call is-same-register saved ([] sources index))
          (= ([] sources index) temporary)
        )
      )
    )
    (blank)
    (let merged (. ([] (. function blocks) pred) instructions))
    (for (in index (..< 0 tail-length))
      (= merged (call (. merged appended) arena ([] tail index)))
    )
    (= (. ([] (. function blocks) pred) instructions) merged)
  )
  (fn-do _ emit-copy _
    (param destination OperandId)
    (param source OperandId)
    (let kind (. PhiSource unsupported))
    (let name no-string)
    (let type no-mir-type)
    (match? ([] (. function operands) source)
      (case .vreg-operand
        (= kind (. PhiSource register))
      )
      (case .preg-operand
        (= kind (. PhiSource register))
      )
      (case .int-operand
        (= kind (. PhiSource int))
      )
      (case (call .frame-object-operand operand)
        (= kind (. PhiSource frame-object))
        (= type (. ([] (. function frame-objects) (. operand object)) type))
      )
      (case (call .symbol-operand operand)
        (= kind (. PhiSource symbol))
        (= name (. operand name))
      )
    )
    (if (== kind (. PhiSource register))
      (let copy (call (. builder move) destination source))
      (match? ([] (. function instructions) copy)
        (case (call .assembly-instruction row)
          (= (. row is-phi-copy) true)
        )
      )
      (else-if (== kind (. PhiSource int))
        (call (. builder mov) destination source)
      )
      (else-if (== kind (. PhiSource frame-object))
        (call (. builder load) destination source type)
      )
      (else-if (== kind (. PhiSource symbol))
        (call (. builder adrp) destination (call (. builder label) name .page-reloc))
        (call (. builder add) destination destination (call (. builder label) name .pageoff-reloc))
      )
      (else
        (throw (call Panic "Unsupported phi expression kind"))
      )
    )
  )
  (fn-do _ terminator-index U32
    (param instructions IdList)
    (let index (. instructions length))
    (while (> index 0)
      (-= index 1)
      (let opcode (. ([] (. function instructions) ([] instructions index)) opcode))
      (if (or (== opcode .b) (== opcode .b-cond) compares-zero (== opcode .br) (== opcode .ret))
        (return index)
      )
      (lazy compares-zero (or (== opcode .cbz) (== opcode .cbnz)))
    )
    (return (. instructions length))
  )
  (fn-do _ register-id U32
    (param operand OperandId)
    (match? ([] (. function operands) operand)
      (case (call .vreg-operand row)
        (return (. ([] (. function vregs) (. row vreg)) id))
      )
    )
    (return no-id)
  )
  (fn-expr _ is-same-register Bool
    (param register OperandId)
    (param operand OperandId)
    (and (!= id no-id) (== id (call register-id register)))
    (where
      (lazy id (call register-id operand))
    )
  )
)
