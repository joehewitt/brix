./compact
./mir
./mir-digest
./pipeline
./relocations
/core/arena
/string.h

_ kept-rounds U64 = 4

━━━━━━━━━━━━━━━━━━━━
+ CachedRecord is Tuple

+ digest MIRDigest
+ record CompactFunction
+ counts FunctionCounts
+ pool U32
+ strings CPointer'U32
+ string-count U32
+ round U64

━━━━━━━━━━━━━━━━━━━━
+ BackendCache
    is Usable'Void

+ round U64
+ hits U64
+ misses U64
_ entries [CachedRecord]
_ places [U64 = U32]
_ arenas [Arena]
_ stores [RecordStore]

────────────────────
+ begin-using

this

────────────────────
+ do end-using

release()

────────────────────
+ do release

for store in stores
    store.arena.release()
stores.clear()
for arena in arenas
    arena.release()
arenas.clear()
entries.clear()
places.clear()

────────────────────
+ do begin-round
    - worker-count Size

for store in stores
    store.arena.release()
stores.clear()
round += 1
hits = 0
misses = 0
for _ in 0 .. < worker-count
    stores += RecordStore(this)

────────────────────
+ store-for RecordStore
    - worker Size

stores[worker]

────────────────────
+ find U32?
    - digest MIRDigest

|? !place || entries[place].digest.low != digest.low
    null
??
    place

.. place = places[digest.high]

────────────────────
+ entry CachedRecord
    - place U32

entries[place]

────────────────────
+ do finish-round

for store in stores
    hits += store.used.length as U64
    misses += store.kept.length as U64
    for place in store.used
        . entry = entries[place]
        entries[place] = entry.round = round
    for entry in store.kept
        . place = places[entry.digest.high]
        if place
            entries[place] = entry
        else
            places[entry.digest.high] = entries.length as U32
            entries += entry
    arenas += store.arena
stores.clear()
. live = 0u64
for entry in entries
    if entry.round + kept-rounds > round
        live += 1
if entries.length as U64 > live * 2
    compact()

────────────────────
_ do compact

. arena = Arena()
. kept [CachedRecord]
for entry in entries
    if entry.round + kept-rounds > round
        kept += CachedRecord
            - entry.digest
            - copied-record(arena, entry.record)
            - entry.counts
            - entry.pool
            - copied-ids(arena, entry.strings, entry.string-count)
            - entry.string-count
            - entry.round
for old in arenas
    old.release()
arenas.clear()
arenas += arena
entries.clear()
places.clear()
for entry in kept
    places[entry.digest.high] = entries.length as U32
    entries += entry

━━━━━━━━━━━━━━━━━━━━
+ RecordStore

+ arena Arena
+ kept [CachedRecord]
+ used [U32]
+ cache BackendCache

────────────────────
+ This
    - cache BackendCache

this.cache = cache

────────────────────
+ do keep
    - digest MIRDigest
    - record CompactFunction
    - counts FunctionCounts
    - pool U32
    - strings IdList

kept += CachedRecord
    - digest
    - copied-record(arena, record)
    - counts
    - pool
    - copied-ids(arena, strings.data, strings.length)
    - strings.length
    - cache.round

────────────────────
+ do reuse CompactFunction?
    - place U32
    - results Arena
    - scratch Arena
    - order U32
    - pool U32
    - strings IdList

. entry = cache.entry(place)
=? null if entry.string-count != strings.length
. names = new-id-map(scratch, entry.string-count)
for index in 0 .. < entry.string-count
    names = names.inserted(scratch, entry.strings[index], strings[index])
. renaming = StringRenaming(names, entry.pool, pool)
. source = entry.record
. symbol = renaming.renamed(source.symbol)
. display-name = renaming.renamed(source.display-name)
. source-file = renaming.renamed(source.source-file)
=? null if !symbol || !display-name || !source-file
. relocations = results.allocate'Relocation(source.relocation-count)
for index in 0 .. < source.relocation-count
    . relocation = source.relocations[index]
    . renamed = renaming.renamed(relocation.symbol)
    =? null if !renamed
    relocations[index] = Relocation(relocation.offset, renamed, relocation.kind)
. jump-tables = results.allocate'CompactJumpTable(source.jump-table-count)
for index in 0 .. < source.jump-table-count
    . table = source.jump-tables[index]
    . renamed = renaming.renamed(table.name)
    =? null if !renamed
    jump-tables[index] = CompactJumpTable(renamed, table.offset)
. line-records = results.allocate'CompactLineRecord(source.line-record-count)
for index in 0 .. < source.line-record-count
    . line = source.line-records[index]
    . renamed = renaming.renamed(line.file)
    =? null if !renamed
    line-records[index] = CompactLineRecord(line.pc-offset, renamed, line.line, line.column)
. locations = results.allocate'CompactRootLocation(source.location-count)
for index in 0 .. < source.location-count
    . location = source.locations[index]
    . renamed = renaming.renamed(location.descriptor)
    =? null if !renamed
    locations[index] = CompactRootLocation
        - location.kind
        - location.register
        - location.offset
        - renamed
used += place
= CompactFunction
    - source.is-encoded
    - order
    - symbol
    - source.is-external
    - source.code
    - relocations
    - source.relocation-count
    - jump-tables
    - source.jump-table-count
    - display-name
    - source-file
    - source.source-line
    - source.source-column
    - line-records
    - source.line-record-count
    - source.safepoints
    - source.safepoint-count
    - locations
    - source.location-count
    - source.saved-registers
    - source.saved-register-count

━━━━━━━━━━━━━━━━━━━━
_ StringRenaming is Tuple

+ names IdMap
+ from-pool U32
+ to-pool U32

────────────────────
+ renamed StringId?
    - id StringId

|? id == no-string
    id
|? id >= from-pool
    id - from-pool + to-pool
|? found == no-id
    null
??
    found

.. found = names.get(id)

━━━━━━━━━━━━━━━━━━━━
_ do copied-record CompactFunction
    - arena Arena
    - source CompactFunction

. code = arena.allocate-raw(if source.code.length != 0 then source.code.length else 1, 16)
C:memcpy(code, source.code.data, source.code.length)
. relocations = arena.allocate'Relocation(source.relocation-count)
C:memcpy
    - relocations as CPointer'Byte
    - source.relocations as CPointer'Byte
    - source.relocation-count * Relocation.size
. jump-tables = arena.allocate'CompactJumpTable(source.jump-table-count)
C:memcpy
    - jump-tables as CPointer'Byte
    - source.jump-tables as CPointer'Byte
    - source.jump-table-count * CompactJumpTable.size
. line-records = arena.allocate'CompactLineRecord(source.line-record-count)
C:memcpy
    - line-records as CPointer'Byte
    - source.line-records as CPointer'Byte
    - source.line-record-count * CompactLineRecord.size
. safepoints = arena.allocate'CompactSafepoint(source.safepoint-count)
C:memcpy
    - safepoints as CPointer'Byte
    - source.safepoints as CPointer'Byte
    - source.safepoint-count * CompactSafepoint.size
. locations = arena.allocate'CompactRootLocation(source.location-count)
C:memcpy
    - locations as CPointer'Byte
    - source.locations as CPointer'Byte
    - source.location-count * CompactRootLocation.size
. saved-registers = arena.allocate'CompactSavedRegister(source.saved-register-count)
C:memcpy
    - saved-registers as CPointer'Byte
    - source.saved-registers as CPointer'Byte
    - source.saved-register-count * CompactSavedRegister.size
= CompactFunction
    - source.is-encoded
    - source.order
    - source.symbol
    - source.is-external
    - ByteSpan(code, source.code.length)
    - relocations
    - source.relocation-count
    - jump-tables
    - source.jump-table-count
    - source.display-name
    - source.source-file
    - source.source-line
    - source.source-column
    - line-records
    - source.line-record-count
    - safepoints
    - source.safepoint-count
    - locations
    - source.location-count
    - saved-registers
    - source.saved-register-count

━━━━━━━━━━━━━━━━━━━━
_ do copied-ids CPointer'U32
    - arena Arena
    - source CPointer'U32
    - count U32

. copy = arena.allocate'U32(count)
C:memcpy(copy as CPointer'Byte, source as CPointer'Byte, (count as Size) * 4)
= copy
