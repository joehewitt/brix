(import ./binary-writer)
(import ./mir)
(import ./object-builder)
(import ./relocations)
(import /core/arena)
(import /core/table)
(blank)
(prop _ et-rel U32 (= 1))
(prop _ em-aarch64 U32 (= 183))
(prop _ sht-progbits U32 (= 1))
(prop _ sht-symtab U32 (= 2))
(prop _ sht-strtab U32 (= 3))
(prop _ sht-rela U32 (= 4))
(prop _ sht-nobits U32 (= 8))
(prop _ shf-write U64 (= 1))
(prop _ shf-alloc U64 (= 2))
(prop _ shf-execinstr U64 (= 4))
(prop _ shf-info-link U64 (= 0x40))
(prop _ header-size U64 (= 64))
(prop _ section-header-size U32 (= 64))
(prop _ symbol-size U64 (= 24))
(prop _ rela-size U64 (= 24))
(prop _ section-names (list String)
  (=
    (block
      (list ".text" "" ".data.rel.ro" "brix_trace" "brix_gcmap" "brix_gcroots" "brix_pads" ".bss")
    )
  )
)

(fn-do + write-elf ByteSpan
  (param builder ObjectBuilder)
  ; The object as an AArch64 ELF relocatable. Its sections are the builder's, except the empty C
  ; string section, then a `.rela` section for each that has relocations, the symbol and string
  ; tables, and an empty `.note.GNU-stack`, which keeps the stack from being executable.
  (let arena (. builder arena))
  (let names (call BinaryWriter arena 256))
  (call (. names u8) 0)
  (let empty (call ByteSpan (. names data) 0))
  (let sections (call (of Table ElfSection) arena 16))
  (call (. sections append) (call ElfSection 0 0 0 0 empty 0 0 0 0 0))
  (let indexes (call (of (. arena allocate) U32) (+ (. builder sections length) 1)))
  (let relocated U32)
  (for (in position (..< 0 (. builder sections length)))
    (let index U32 (as (+ position 1) U32))
    (if (== index (. SectionId cstring))
      (continue)
    )
    (let source ([] (. builder sections) position))
    (let type (if-expr (. source is-zero-fill) sht-nobits sht-progbits))
    (let flags
      (scope (if-expr (== index (. SectionId text)) executable-flags (/or/ shf-alloc shf-write))
        (lazy executable-flags (/or/ shf-alloc shf-execinstr))
      )
    )
    (= ([] indexes index) (as (. sections length) U32))
    (call (. sections append)
      (block
        (arg
          (call ElfSection
            (block
              (arg (call add-name names ([] section-names position)))
              (arg type)
              (arg flags)
              (arg 0)
              (arg (. source data))
              (arg (. source size))
              (arg 0)
              (arg 0)
              (arg (/lshift/ 1u64 (. source alignment-power)))
              (arg 0)
            )
          )
        )
      )
    )
    (if (!= (. source relocations length) 0)
      (+= relocated 1)
    )
  )
  (blank)
  (let symbol-table-index U32 (as (+ (. sections length) relocated) U32))
  (for (in position (..< 0 (. builder sections length)))
    (let index U32 (as (+ position 1) U32))
    (let source ([] (. builder sections) position))
    (if (and (!= index (. SectionId cstring)) (!= (. source relocations length) 0))
      (let entries (call relocation-entries builder source))
      (let name (call add-name names (str ".rela" ([] section-names position))))
      (call (. sections append)
        (block
          (arg
            (call ElfSection
              (block
                (arg name)
                (arg sht-rela)
                (arg shf-info-link)
                (arg 0)
                (arg entries)
                (arg (as (. entries length) U64))
                (arg symbol-table-index)
                (arg ([] indexes index))
                (arg 8)
                (arg rela-size)
              )
            )
          )
        )
      )
    )
  )
  (blank)
  (let symbols (call symbol-entries builder indexes))
  (let symbol-name (call add-name names ".symtab"))
  (call (. sections append)
    (block
      (arg
        (call ElfSection
          (block
            (arg symbol-name)
            (arg sht-symtab)
            (arg 0)
            (arg 0)
            (arg symbols)
            (arg (as (. symbols length) U64))
            (arg (+ symbol-table-index 1))
            (arg (+ 1 (. builder local-count)))
            (arg 8)
            (arg symbol-size)
          )
        )
      )
    )
  )
  (let string-name (call add-name names ".strtab"))
  (call (. sections append)
    (block
      (arg
        (call ElfSection
          (block
            (arg string-name)
            (arg sht-strtab)
            (arg 0)
            (arg 0)
            (arg (. builder string-table))
            (arg (as (. builder string-table length) U64))
            (arg 0)
            (arg 0)
            (arg 1)
            (arg 0)
          )
        )
      )
    )
  )
  (let note-name (call add-name names ".note.GNU-stack"))
  (let section-name-index U32 (as (. sections length) U32))
  (let section-names-name (call add-name names ".shstrtab"))
  (call (. sections append)
    (block
      (arg (call ElfSection section-names-name sht-strtab 0 0 (. names view) (as (. names length) U64) 0 0 1 0))
    )
  )
  (call (. sections append) (call ElfSection note-name sht-progbits 0 0 empty 0 0 0 1 0))
  (blank)
  (let cursor header-size)
  (for (in index (..< 1 (. sections length)))
    (= cursor (call align-value cursor (. ([] sections index) alignment)))
    (= (. ([] sections index) offset) cursor)
    (if (!= (. ([] sections index) type) sht-nobits)
      (+= cursor (. ([] sections index) size))
    )
  )
  (let section-headers (call align-value cursor 8))
  (let total (+ section-headers (* (. sections length) section-header-size)))
  (call check-layout total)
  (blank)
  (let writer (call BinaryWriter arena (as total Size)))
  (call (. writer u8) 0x7f)
  (call (. writer text) "ELF")
  (call (. writer u8) 2)
  (call (. writer u8) 1)
  (call (. writer u8) 1)
  (call (. writer zeros) 9)
  (call (. writer u16) et-rel)
  (call (. writer u16) em-aarch64)
  (call (. writer u32) 1)
  (call (. writer u64) 0)
  (call (. writer u64) 0)
  (call (. writer u64) section-headers)
  (call (. writer u32) 0)
  (call (. writer u16) (as header-size U32))
  (call (. writer u16) 0)
  (call (. writer u16) 0)
  (call (. writer u16) section-header-size)
  (call (. writer u16) (as (. sections length) U32))
  (call (. writer u16) section-name-index)
  (blank)
  (for (in index (..< 1 (. sections length)))
    (if (and (!= (. ([] sections index) type) sht-nobits) (!= (. ([] sections index) size) 0))
      (call (. writer zeros) (as (- (. ([] sections index) offset) (. writer length)) Size))
      (call (. writer bytes) (. ([] sections index) data))
    )
  )
  (call (. writer zeros) (as (- section-headers (. writer length)) Size))
  (for (in index (..< 0 (. sections length)))
    (let section ([] sections index))
    (call (. writer u32) (. section name))
    (call (. writer u32) (. section type))
    (call (. writer u64) (. section flags))
    (call (. writer u64) 0)
    (call (. writer u64) (. section offset))
    (call (. writer u64) (. section size))
    (call (. writer u32) (. section link))
    (call (. writer u32) (. section info))
    (call (. writer u64) (. section alignment))
    (call (. writer u64) (. section entry-size))
  )
  (return (. writer view))
)

(type _ ElfBinding (is U32)
  (variant local)
  (variant global)
)

(type _ ElfSymbolType (is U32)
  (variant notype)
  (variant object)
  (variant func)
)

(type _ ElfSection (is Struct)
  (prop + name U32)
  (prop + type U32)
  (prop + flags U64)
  (prop + offset U64)
  (prop + data ByteSpan)
  (prop + size U64)
  (prop + link U32)
  (prop + info U32)
  (prop + alignment U64)
  (prop + entry-size U64)
)

(fn-do _ add-name U32
  (param names BinaryWriter)
  (param name String)
  (let offset U32 (as (. names length) U32))
  (call (. names text) name)
  (call (. names u8) 0)
  (return offset)
)

(fn-do _ relocation-entries ByteSpan
  (param builder ObjectBuilder)
  (param section ObjectSection)
  (let count (. section relocations length))
  (let writer (call BinaryWriter (. builder arena) (as (* count rela-size) Size)))
  (for (in position (..< 0 count))
    (let relocation ([] (. section relocations) position))
    (let symbol U64 (+ (. ([] (. builder symbols) (. relocation symbol)) index) 1))
    (call (. writer u64) (. relocation offset))
    (call (. writer u64) (/or/ (/lshift/ symbol 32) (call relocation-type (. relocation kind))))
    (call (. writer u64) 0)
  )
  (return (. writer view))
)

(fn-do _ symbol-entries ByteSpan
  (param builder ObjectBuilder)
  (param indexes (of CPointer U32))
  (let count (. builder symbols length))
  (let writer (call BinaryWriter (. builder arena) (as (* (+ count 1) symbol-size) Size)))
  (call (. writer zeros) (as symbol-size Size))
  (for (in position (..< 0 count))
    (let symbol ([] (. builder symbols) ([] (. builder symbol-order) position)))
    (let defined (!= (. symbol section) (. SectionId none)))
    (let binding (if-expr (and defined (not (. symbol is-external))) (. ElfBinding local) (. ElfBinding global)))
    (let type (. ElfSymbolType notype))
    (if (. symbol is-function)
      (= type (. ElfSymbolType func))
      (else-if (and defined (!= (. symbol section) (. SectionId text)))
        (= type (. ElfSymbolType object))
      )
    )
    (call (. writer u32) (. symbol string-offset))
    (call (. writer u8) (/or/ (/lshift/ (as binding U32) 4) type))
    (call (. writer u8) 0)
    (call (. writer u16) (if-expr defined ([] indexes (. symbol section)) 0))
    (call (. writer u64) (. symbol value))
    (call (. writer u64) (. symbol size))
  )
  (return (. writer view))
)

(fn-expr _ relocation-type U64
  (param kind RelocationKind)
  (match kind
    (case= .call26-relocation
      283
    )
    (case= .jump26-relocation
      282
    )
    (case= .page21-relocation
      275
    )
    (case= .add-pageoff12-relocation
      277
    )
    (case= .load-store8-pageoff12-relocation
      278
    )
    (case= .load-store16-pageoff12-relocation
      284
    )
    (case= .load-store32-pageoff12-relocation
      285
    )
    (case= .load-store64-pageoff12-relocation
      286
    )
    (case= .load-store128-pageoff12-relocation
      299
    )
    (case= .unsigned-relocation
      257
    )
  )
)
