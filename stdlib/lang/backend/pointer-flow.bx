(import ./builder)
(import ./bundle)
(import ./mir)
(import /core/arena)
(import /core/table)
(blank)
(prop _ first-source U32 (= 2))
(prop _ choice-sources U32 (= 6))

(type _ PointerKind (is U32)
  (variant skipped)
  (variant register)
  (variant pinned)
  (variant direct)
  (variant other)
)

(type + MIRPointerFlow
  (prop _ builder MIRBuilder)
  (prop _ bundle Bundle)
  (prop _ function MIRFunction)
  (prop + origins (of CPointer IdList))
  (prop + references (of CPointer IdList))
  (prop + escapes (of CPointer Byte))
  (prop + root-count U32)
  (prop _ blocks IdList)
  (prop _ edges (of CPointer IdList))
  (prop _ object-roots (of CPointer U32))
  (prop _ object-count U32)
  (prop _ origin-order IdList)
  (prop _ keys IdList)
  (fn-do + This _
    (param builder MIRBuilder)
    (lazy bundle (. builder bundle))
    (lazy function (. builder function))
  )
  (fn-expr _ arena Arena :get @inline
    (. function arena)
  )
  (fn-do + run-objects _
    (param order IdList)
    (param objects IdList)
    (call begin order (. objects length))
    (= object-count (as (. function frame-objects length) U32))
    (= object-roots (call (of (. arena allocate) U32) object-count))
    (for (in root (..< 0 (. objects length)))
      (= ([] object-roots ([] objects root)) (+ root 1))
    )
    (call scan)
  )
  (fn-do + run-vregs _
    (param order IdList)
    (param vregs IdList)
    (call begin order (. vregs length))
    (= object-count 0)
    (for (in root (..< 0 (. vregs length)))
      (call add-origin ([] vregs root) root)
    )
    (call scan)
  )
  (fn-do _ begin _
    (param order IdList)
    (param count U32)
    (= blocks order)
    (= root-count count)
    (= origins (call (of (. arena allocate) IdList) (. function vreg-count)))
    (= edges (call (of (. arena allocate) IdList) (. function vreg-count)))
    (= references (call (of (. arena allocate) IdList) count))
    (= escapes (call (of (. arena allocate) Byte) count))
    (= origin-order (call IdList))
    (= keys (call IdList))
  )
  (fn-do _ scan _
    (call collect-sources)
    (call propagate)
    (if (== root-count 0)
      (return)
    )
    (for (in position (..< 0 (. blocks length)))
      (let instructions (. ([] (. function blocks) ([] blocks position)) instructions))
      (for (in offset (..< 0 (. instructions length)))
        (call scan-instruction ([] instructions offset))
      )
    )
  )
  (fn-do _ collect-sources _
    (for (in position (..< 0 (. blocks length)))
      (let instructions (. ([] (. function blocks) ([] blocks position)) instructions))
      (for (in offset (..< 0 (. instructions length)))
        (let id ([] instructions offset))
        (let operands (. ([] (. function instructions) id) operands))
        (match? ([] (. function instructions) id)
          (case (call .call-instruction call)
            (if (and (> (. operands length) 2) (not (call is-void (. call return-type))) copies-memory)
              (let returned (call vreg-of ([] operands 1)))
              (if (!= returned no-id)
                (call add-source returned ([] operands 2))
              )
            )
            (lazy copies-memory (call (. bundle is-memory-copy-callee) (call callee-name operands)))
          )
        )
        (if (== (. operands length) 0)
          (continue)
        )
        (let destination (call vreg-of ([] operands 0)))
        (if (== destination no-id)
          (continue)
        )
        (let sources (call pointer-copy-sources id))
        (if (and (!= (/and/ sources 2) 0) (> (. operands length) 1))
          (call add-source destination ([] operands 1))
        )
        (if (and (!= (/and/ sources 4) 0) (> (. operands length) 2))
          (call add-source destination ([] operands 2))
        )
      )
    )
  )
  (fn-do _ propagate _
    (let pending (call new-id-list arena (. origin-order length)))
    (let queued (call (of (. arena allocate) Byte) (. function vreg-count)))
    (for (in index (..< 0 (. origin-order length)))
      (= pending (call (. pending appended) arena ([] origin-order index)))
      (= ([] queued ([] origin-order index)) 1)
    )
    (let cursor U32)
    (while (< cursor (. pending length))
      (let source ([] pending cursor))
      (+= cursor 1)
      (= ([] queued source) 0)
      (let destinations ([] edges source))
      (for (in index (..< 0 (. destinations length)))
        (let destination ([] destinations index))
        (let changed false)
        (let count (. ([] origins source) length))
        (for (in key (..< 0 count))
          (if (call add-origin destination ([] ([] origins source) key))
            (= changed true)
          )
        )
        (if (and changed (== ([] queued destination) 0))
          (= ([] queued destination) 1)
          (= pending (call (. pending appended) arena destination))
        )
      )
    )
  )
  (fn-do _ scan-instruction _
    (param id InstructionId)
    (let roles (call (. function operand-roles) id))
    (let operands (. ([] (. function instructions) id) operands))
    (for (in index (..< 0 (. operands length)))
      (let operand ([] operands index))
      (let kind (call operand-kind operand))
      (if (== kind (. PointerKind skipped))
        (continue)
      )
      (let vreg no-id)
      (let offset no-operand)
      (match? ([] (. function operands) operand)
        (case (call .vreg-operand row)
          (= vreg (. ([] (. function vregs) (. row vreg)) id))
        )
        (case (call .load-address-operand row)
          (= offset (. row offset))
        )
      )
      (if (and (!= vreg no-id) (== (. ([] origins vreg) length) 0))
        (continue)
      )
      (if (!= offset no-operand)
        (call take-keys offset)
        (call escape-keys)
      )
      (call take-keys operand)
      (if (== (. keys length) 0)
        (continue)
      )
      (let role (call role-at roles index))
      (let is-used (!= (/and/ role use-role) 0))
      (let is-defined (!= (/and/ role def-role) 0))
      (if (or is-used is-defined (== kind (. PointerKind direct)))
        (for (in key (..< 0 (. keys length)))
          (call add-reference ([] keys key) id)
        )
      )
      (if (and is-used (not (call is-safe-use id operands index kind)))
        (call escape-keys)
      )
      (if (and (== kind (. PointerKind pinned)) is-defined)
        (call escape-keys)
      )
    )
  )
  (fn-do _ operand-kind U32
    (param operand OperandId)
    (match? ([] (. function operands) operand)
      (case (call .vreg-operand row)
        (if (!= (. ([] (. function vregs) (. row vreg)) hint) no-register)
          (return (. PointerKind pinned))
        )
        (return (. PointerKind register))
      )
      (case .int-operand
        (return (. PointerKind skipped))
      )
      (case .label-operand
        (return (. PointerKind skipped))
      )
      (case .symbol-operand
        (return (. PointerKind skipped))
      )
      (case .preg-operand
        (return (. PointerKind skipped))
      )
      (case .cond-operand
        (return (. PointerKind skipped))
      )
      (case .shift-operand
        (return (. PointerKind skipped))
      )
      (case .load-address-operand
        (return (. PointerKind direct))
      )
      (case .frame-object-operand
        (return (. PointerKind direct))
      )
    )
    (return (. PointerKind other))
  )
  (fn-do _ is-safe-use Bool
    (param id InstructionId)
    (param operands IdList)
    (param index U32)
    (param kind U32)
    (let sources (call pointer-copy-sources id))
    (if (and (< index 3) (!= (/and/ sources (/lshift/ 1u32 index)) 0))
      (match? ([] (. function operands) ([] operands 0))
        (case (call .vreg-operand row)
          (return (== (. ([] (. function vregs) (. row vreg)) hint) no-register))
        )
      )
      (return false)
    )
    (let opcode (. ([] (. function instructions) id) opcode))
    (if (== kind (. PointerKind direct))
      (if (and (== index 1) (call is-single-memory-opcode opcode))
        (return true)
      )
      (if (and (== index 2) (or (== opcode .ldp) (== opcode .stp)))
        (return true)
      )
    )
    (match? ([] (. function instructions) id)
      (case (call .call-instruction call)
        (if (and (== index (- (. operands length) 1)) (. call direct-struct-return))
          (return true)
        )
        (let first-argument U32 (if-expr (call is-void (. call return-type)) 1 2))
        (if (and (>= index first-argument) (call (. bundle is-safe-struct-callee) (call callee-name operands)))
          (return true)
        )
        (for (in position (..< (. call copied-struct-arguments start) (. call copied-struct-arguments end)))
          (if (== ([] (. function words) position) index)
            (return true)
          )
        )
      )
    )
    (return false)
  )
  (fn-do _ pointer-copy-sources U32
    (param id InstructionId)
    (let opcode (. ([] (. function instructions) id) opcode))
    (if (or (== opcode .mov) (== opcode .addptr))
      (return first-source)
    )
    (if (== opcode .csel)
      (return choice-sources)
    )
    (if (or (== opcode .add) (== opcode .sub))
      (let operands (. ([] (. function instructions) id) operands))
      (if (> (. operands length) 2)
        (match? ([] (. function operands) ([] operands 2))
          (case .int-operand
            (return first-source)
          )
        )
      )
    )
    (return 0)
  )
  (fn-do _ callee-name StringId
    (param operands IdList)
    (match? ([] (. function operands) ([] operands 0))
      (case (call .symbol-operand row)
        (return (. row name))
      )
    )
    (return no-string)
  )
  (fn-do _ is-void Bool
    (param type MIRTypeId)
    (match? ([] (. function types) type)
      (case .void-type
        (return true)
      )
    )
    (return false)
  )
  (fn-do _ vreg-of U32
    (param operand OperandId)
    (match? ([] (. function operands) operand)
      (case (call .vreg-operand row)
        (return (. ([] (. function vregs) (. row vreg)) id))
      )
    )
    (return no-id)
  )
  (fn-do _ take-keys _
    (param operand OperandId)
    (= keys (call IdList (. keys data) 0 (. keys capacity)))
    (call collect-keys operand)
  )
  (fn-do _ collect-keys _
    (param operand OperandId)
    (if (== operand no-operand)
      (return)
    )
    (match? ([] (. function operands) operand)
      (case (call .vreg-operand row)
        (call collect-origins (. row vreg))
      )
      (case (call .frame-object-operand row)
        (if (and (< (. row object) object-count) (!= ([] object-roots (. row object)) 0))
          (= keys (call (. keys appended) arena (- ([] object-roots (. row object)) 1)))
        )
      )
      (case (call .load-address-operand row)
        (call collect-keys (. row base))
        (call collect-keys (. row offset))
      )
      (case (call .vreg-group-operand row)
        (for (in index (..< (. row vregs start) (. row vregs end)))
          (call collect-origins ([] (. function group-vregs) index))
        )
      )
      (case (call .label-address-operand row)
        (call collect-keys (. row base))
      )
    )
  )
  (fn-do _ collect-origins _
    (param view VRegId)
    (let list ([] origins (. ([] (. function vregs) view) id)))
    (for (in index (..< 0 (. list length)))
      (= keys (call (. keys appended) arena ([] list index)))
    )
  )
  (fn-do _ escape-keys _
    (for (in index (..< 0 (. keys length)))
      (= ([] escapes ([] keys index)) 1)
    )
  )
  (fn-do _ add-reference _
    (param root U32)
    (param id InstructionId)
    (let list ([] references root))
    (if (and (!= (. list length) 0) (== ([] list (- (. list length) 1)) id))
      (return)
    )
    (= ([] references root) (call (. list appended) arena id))
  )
  (fn-do _ add-origin Bool
    (param id U32)
    (param key U32)
    (let list ([] origins id))
    (for (in index (..< 0 (. list length)))
      (if (== ([] list index) key)
        (return false)
      )
    )
    (if (== (. list length) 0)
      (= origin-order (call (. origin-order appended) arena id))
    )
    (= ([] origins id) (call (. list appended) arena key))
    (return true)
  )
  (fn-do _ add-source _
    (param destination U32)
    (param source OperandId)
    (let base no-operand)
    (let vreg no-id)
    (match? ([] (. function operands) source)
      (case (call .load-address-operand row)
        (= base (. row base))
      )
      (case (call .vreg-operand row)
        (= vreg (. ([] (. function vregs) (. row vreg)) id))
      )
    )
    (if (!= base no-operand)
      (call add-source destination base)
      (return)
    )
    (if (!= vreg no-id)
      (let list ([] edges vreg))
      (if (or (== (. list length) 0) (!= ([] list (- (. list length) 1)) destination))
        (= ([] edges vreg) (call (. list appended) arena destination))
      )
      (return)
    )
    (call take-keys source)
    (for (in index (..< 0 (. keys length)))
      (call add-origin destination ([] keys index))
    )
  )
)

(fn-expr _ is-single-memory-opcode Bool
  (param opcode Opcode)
  (or (== opcode .ldr) (== opcode .ldrb) (== opcode .ldrh) (== opcode .ldrsw) (== opcode .ldrsb) (== opcode .ldrsh) (== opcode .ldar) (== opcode .ldarb) (== opcode .str) (== opcode .strb) (== opcode .strh) (== opcode .stlrb))
)
