(import ./bundle)
(import ./mir)
(import /BxCore/BxCore.h)
(import /core/arena)
(import /core/table)

(type + TextBuffer
  (prop + bytes ([] Byte))
  (prop + length Size)
  (prop _ digits ([] Byte))
  (fn-do + This _
    (lazy bytes ([] Byte 65536))
    (lazy digits ([] Byte 20))
  )
  (fn-do + clear _
    (= length 0)
  )
  (fn-expr + hash U64 :get
    (call fnv-hash (. bytes data) length)
  )
  (fn-do _ reserve _ @inline
    (param count Size)
    (if (> (+ length count) (. bytes size))
      (call grow (+ length count))
    )
  )
  (fn-do _ grow _
    (param needed Size)
    (let capacity (* (. bytes size) 2))
    (while (< capacity needed)
      (*= capacity 2)
    )
    (= bytes (call (. bytes resize) capacity))
  )
  (fn-do + byte _
    (param value Byte)
    (call reserve 1)
    (= ([] (. bytes data) length) value)
    (+= length 1)
  )
  (fn-do + text _
    (param value String)
    (call span (call ByteSpan value (. value size)))
  )
  (fn-do + span _
    (param value ByteSpan)
    (call reserve (. value length))
    (call C:brixArrayCopySlice (+ (. bytes data) length) (. value data) (. value length))
    (+= length (. value length))
  )
  (fn-do + escaped _
    (param value ByteSpan)
    (call reserve (* (. value length) 2))
    (let data (. bytes data))
    (let cursor length)
    (for (in index (..< 0 (. value length)))
      (let character ([] (. value data) index))
      (if (== character 92)
        (= ([] data cursor) 92)
        (= ([] data (+ cursor 1)) 92)
        (+= cursor 2)
        (else-if (== character 10)
          (= ([] data cursor) 92)
          (= ([] data (+ cursor 1)) 110)
          (+= cursor 2)
        )
        (else-if (== character 13)
          (= ([] data cursor) 92)
          (= ([] data (+ cursor 1)) 114)
          (+= cursor 2)
        )
        (else
          (= ([] data cursor) character)
          (+= cursor 1)
        )
      )
    )
    (= length cursor)
  )
  (fn-do + unsigned _
    (param value U64)
    (let count Size 0)
    (let rest value)
    (while true
      (= ([] (. digits data) count) (as (+ 48 (% rest 10)) Byte))
      (+= count 1)
      (/= rest 10)
      (if (== rest 0)
        (break)
      )
    )
    (call reserve count)
    (for (in index (..< 0 count))
      (= ([] (. bytes data) (+ length index)) ([] (. digits data) (- count 1 index)))
    )
    (+= length count)
  )
  (fn-do + signed _
    (param value I64)
    (if (< value 0)
      (call byte 45)
      (call unsigned (- 0 (as value U64)))
      (else
        (call unsigned (as value U64))
      )
    )
  )
  (fn-do + hex _
    (param value ByteSpan)
    (call reserve (* (. value length) 2))
    (for (in index (..< 0 (. value length)))
      (let high (/zrshift/ ([] (. value data) index) 4))
      (let low (/and/ ([] (. value data) index) 15))
      (= ([] (. bytes data) (+ length (* index 2))) (if-expr (< high 10) (+ high 48) (+ high 87)))
      (= ([] (. bytes data) (+ length (* index 2) 1)) (if-expr (< low 10) (+ low 48) (+ low 87)))
    )
    (+= length (* (. value length) 2))
  )
  (fn-do + hex64 _
    (param value U64)
    (call reserve 16)
    (for (in index (..< 0 16))
      (let nibble (as (/and/ (/zrshift/ value (* (- 15 index) 4)) 15) Byte))
      (= ([] (. bytes data) (+ length index)) (if-expr (< nibble 10) (+ nibble 48) (+ nibble 87)))
    )
    (+= length 16)
  )
)

(type + MIRText
  (prop + out TextBuffer)
  (prop _ bundle Bundle)
  (prop _ function MIRFunction)
  (prop _ referenced (list MIRSlotId))
  (prop _ is-referenced (list Bool))
  (fn-do + This _
    (param bundle Bundle)
    (param function MIRFunction)
  )
  (fn-do + function-text _
    (call (. out text) "function ")
    (call (. out span) (call (. bundle string) (. function name)))
    (call (. out text) " effects=")
    (call (. out unsigned) (. function compilation-effects))
    (call (. out text) " vregs=")
    (call (. out unsigned) (. function vreg-count))
    (if (. function is-exported)
      (call (. out text) " exported")
    )
    (if (. function uses-table-union-cursor-plan)
      (call (. out text) " cursor-plan")
    )
    (if (. function uses-layout-context)
      (call (. out text) " layout-context")
    )
    (call loc-text (. function loc))
    (call (. out text) "\ndisplay ")
    (call (. out escaped) (call (. bundle string) (. function display-name)))
    (call (. out byte) 10)
    (if (!= (. function closure-root) no-frame-object)
      (call (. out text) "closure-root ")
      (call frame-object-text (. function closure-root))
      (call (. out byte) 10)
    )
    (if (!= (. function capture-closure-root) no-frame-object)
      (call (. out text) "capture-closure-root ")
      (call frame-object-text (. function capture-closure-root))
      (call (. out byte) 10)
    )
    (if (!= (. function vars length) 0)
      (call (. out text) "vars")
      (for (in index (..< 0 (. function vars length)))
        (call (. out byte) 32)
        (call frame-object-text ([] (. function vars) index))
      )
      (call (. out byte) 10)
    )
    (if (. function overflow is-present)
      (call overflow-text)
    )
    (call collect-referenced-slots)
    (for (in slot referenced)
      (call slot-text slot)
    )
    (if (!= (. function frame-bytes) 0)
      (call (. out text) "frame-bytes ")
      (call (. out unsigned) (. function frame-bytes))
      (call (. out byte) 10)
    )
    (if (!= (. function gc-roots count) 0)
      (call (. out text) "roots")
      (for (in root (..< (. function gc-roots start) (. function gc-roots end)))
        (call (. out byte) 32)
        (call root-text root)
      )
      (call (. out byte) 10)
    )
    (if (!= (. function saved-registers length) 0)
      (call (. out text) "saved")
      (for (in saved (. function saved-registers))
        (call (. out byte) 32)
        (call register-text (. saved register))
        (call (. out byte) 64)
        (call (. out signed) (. saved fp-offset))
      )
      (call (. out byte) 10)
    )
    (for (in table (. function jump-tables))
      (call (. out text) "jump-table ")
      (call name-text (. table name))
      (call (. out byte) 58)
      (for (in index (..< (. table labels start) (. table labels end)))
        (call (. out byte) 32)
        (call name-text ([] (. function names) index))
      )
      (call (. out byte) 10)
    )
    (for (in position (..< 0 (. function block-order length)))
      (call block-text ([] (. function block-order) position))
    )
  )
  (fn-do _ overflow-text _
    (let overflow (. function overflow))
    (let slot ([] (. function slots) (. overflow slot)))
    (call (. out text) "overflow slot=")
    (call (. out signed) (. slot index))
    (if (. slot is-stack)
      (call (. out text) " stack")
    )
    (call (. out text) " size=")
    (call (. out signed) (. overflow size))
    (call (. out text) " align=")
    (call (. out signed) (. overflow alignment))
    (call (. out text) " length=")
    (call (. out signed) (. overflow length))
    (call (. out text) " count=")
    (call (. out signed) (. overflow count))
    (call (. out text) " offset=")
    (call (. out signed) (. overflow offset))
    (call (. out byte) 10)
  )
  (fn-do _ block-text _
    (param id BlockId)
    (let block ([] (. function blocks) id))
    (call (. out text) "block ")
    (call name-text (. block name))
    (call (. out text) " succ=[")
    (call block-names (. block successors))
    (call (. out text) "] pred=[")
    (call block-names (. block predecessors))
    (call (. out text) "]\n")
    (for (in index (..< 0 (. block instructions length)))
      (call (. out text) "  ")
      (call instruction-text ([] (. block instructions) index))
      (call (. out byte) 10)
    )
  )
  (fn-do _ block-names _
    (param ids IdList)
    (for (in index (..< 0 (. ids length)))
      (if (!= index 0)
        (call (. out byte) 32)
      )
      (call name-text (. ([] (. function blocks) ([] ids index)) name))
    )
  )
  (fn-do + instruction-text _
    (param id InstructionId)
    (match ([] (. function instructions) id)
      (case (call .assembly-instruction row)
        (call instruction-head (. row opcode) (. row operands) false)
        (call instruction-tail
          (block
            (arg (. row position))
            (arg (. row gc-free-zone))
            (arg (. row gc-exceptional-safepoint))
            (arg (. row gc-safepoint))
          )
        )
        (call instruction-end false false (. row is-phi-copy) (. row has-gc-roots) (. row gc-roots) (. row loc))
      )
      (case (call .comment-instruction row)
        (call (. out text) "COMMENT ")
        (call comment-text (. row text))
        (call instruction-head (. row opcode) (. row operands) true)
        (call instruction-tail
          (block
            (arg (. row position))
            (arg (. row gc-free-zone))
            (arg (. row gc-exceptional-safepoint))
            (arg (. row gc-safepoint))
          )
        )
        (call instruction-end false false (. row is-phi-copy) (. row has-gc-roots) (. row gc-roots) (. row loc))
      )
      (case (call .phi-instruction row)
        (call (. out text) "PHI ")
        (call operand-text (. row reg))
        (call (. out text) " = ")
        (for (in index (..< 0 (. row exprs length)))
          (if (!= index 0)
            (call (. out text) ", ")
          )
          (call operand-text ([] (. row exprs) index))
          (call (. out byte) 32)
          (if (< index (. row blocks length))
            (call name-text ([] (. row blocks) index))
            (else
              (call (. out text) "undefined")
            )
          )
        )
        (call instruction-head (. row opcode) (. row operands) true)
        (call instruction-tail
          (block
            (arg (. row position))
            (arg (. row gc-free-zone))
            (arg (. row gc-exceptional-safepoint))
            (arg (. row gc-safepoint))
          )
        )
        (call instruction-end false false (. row is-phi-copy) (. row has-gc-roots) (. row gc-roots) (. row loc))
      )
      (case (call .call-instruction row)
        (call instruction-head (. row opcode) (. row operands) false)
        (call (. out text) " ret=")
        (call type-text (. row return-type))
        (if (!= (. row copied-struct-arguments count) 0)
          (call (. out text) " copied=")
          (for (in index (..< 0 (. row copied-struct-arguments count)))
            (if (!= index 0)
              (call (. out byte) 44)
            )
            (call (. out unsigned) ([] (. function words) (+ (. row copied-struct-arguments start) index)))
          )
        )
        (if (!= (. row argument-sizes count) 0)
          (call (. out text) " sizes=")
          (for (in index (..< 0 (. row argument-sizes count)))
            (if (!= index 0)
              (call (. out byte) 44)
            )
            (call (. out unsigned) ([] (. function words) (+ (. row argument-sizes start) index)))
          )
        )
        (if (!= (. row panic-target) no-operand)
          (call (. out text) " panic=")
          (call operand-text (. row panic-target))
        )
        (call instruction-tail
          (block
            (arg (. row position))
            (arg (. row gc-free-zone))
            (arg (. row gc-exceptional-safepoint))
            (arg (. row gc-safepoint))
          )
        )
        (call instruction-end
          (block
            (arg (. row gc-safepoint-proven-free))
            (arg (. row direct-struct-return))
            (arg (. row is-phi-copy))
            (arg (. row has-gc-roots))
            (arg (. row gc-roots))
            (arg (. row loc))
          )
        )
      )
    )
  )
  (fn-do + name-text _
    (param id StringId)
    (if (< id (. function pool-size))
      (call (. out span) (call (. bundle string) id))
      (return)
    )
    (let name ([] (. function local-names) (- id (. function pool-size))))
    (match (. name kind)
      (case= .edge-block-name
        (call name-text (. name first))
        (call (. out text) ".edge.")
        (call name-text (. name second))
        (call (. out byte) 46)
        (call (. out unsigned) (. name index))
      )
      (case= .barrier-record-name
        (call (. out text) "gc_barrier.record.")
        (call (. out unsigned) (. name index))
      )
      (case= .barrier-after-name
        (call (. out text) "gc_barrier.after.")
        (call (. out unsigned) (. name index))
      )
      (case= .phi-copy-name
        (call (. out text) "phi V")
        (call (. out unsigned) (. name index))
        (call (. out text) " <- edge ")
        (call name-text (. name first))
        (call (. out text) "->")
        (call name-text (. name second))
      )
      (case= .phi-cycle-name
        (call (. out text) "phi cycle save V")
        (call (. out unsigned) (. name index))
        (call (. out text) " on edge ")
        (call name-text (. name first))
        (call (. out text) "->")
        (call name-text (. name second))
      )
      (case= .save-layout-context-name
        (call (. out text) "save generic layout context")
      )
      (case= .save-callee-saved-name
        (call (. out text) "save callee-saved registers")
      )
      (case= .save-frame-name
        (call (. out text) "save fp/lr and shift sp")
      )
      (case= .restore-frame-name
        (call (. out text) "restore fp/lr and reset sp")
      )
      (case= .restore-callee-saved-name
        (call (. out text) "restore callee-saved registers")
      )
      (case= .restore-layout-context-name
        (call (. out text) "restore generic layout context")
      )
      (case= .literal-name
        (call (. out text) "literal.")
        (call (. out unsigned) (. name index))
      )
      (case= .block-name
        (call (. out text) "b")
        (call (. out unsigned) (. name index))
      )
      (case= .jump-table-name
        (call (. out text) "jump_table.")
        (call (. out unsigned) (. name index))
      )
      (case= .allocation-slow-name
        (call (. out text) "gc_alloc.slow.")
        (call (. out unsigned) (. name index))
      )
      (case= .allocation-after-name
        (call (. out text) "gc_alloc.after.")
        (call (. out unsigned) (. name index))
      )
      (case= .switch-tree-name
        (call (. out text) "switch_tree.")
        (call (. out unsigned) (. name index))
      )
    )
  )
  (fn-do _ comment-text _
    (param id StringId)
    (if (< id (. function pool-size))
      (call (. out escaped) (call (. bundle string) id))
      (else
        (call name-text id)
      )
    )
  )
  (fn-do _ instruction-head _
    (param opcode Opcode)
    (param operands IdList)
    (param has-name Bool)
    (if (not has-name)
      (call (. out text) ([] opcode-names opcode))
    )
    (for (in index (..< 0 (. operands length)))
      (call (. out text) (if-expr (== index 0) " " ", "))
      (call operand-text ([] operands index))
    )
  )
  (fn-do _ instruction-tail _
    (param position I32)
    (param gc-free-zone Bool)
    (param gc-exceptional-safepoint Bool)
    (param gc-safepoint Bool)
    (if (!= position no-position)
      (call (. out text) " pos=")
      (call (. out signed) position)
    )
    (if gc-free-zone
      (call (. out text) " gcfree")
    )
    (if gc-exceptional-safepoint
      (call (. out text) " exceptional")
    )
    (if gc-safepoint
      (call (. out text) " safepoint")
    )
  )
  (fn-do _ instruction-end _
    (param gc-safepoint-proven-free Bool)
    (param direct-struct-return Bool)
    (param is-phi-copy Bool)
    (param has-gc-roots Bool)
    (param gc-roots Span)
    (param loc LocId)
    (if gc-safepoint-proven-free
      (call (. out text) " provenfree")
    )
    (if direct-struct-return
      (call (. out text) " structret")
    )
    (if is-phi-copy
      (call (. out text) " phicopy")
    )
    (if has-gc-roots
      (call (. out text) " roots=[")
      (for (in root (..< (. gc-roots start) (. gc-roots end)))
        (if (!= root (. gc-roots start))
          (call (. out byte) 32)
        )
        (call root-text root)
      )
      (call (. out byte) 93)
    )
    (call loc-text loc)
  )
  (fn-do _ loc-text _
    (param id LocId)
    (if (== id no-loc)
      (return)
    )
    (let loc ([] (. function locs) id))
    (call (. out text) " loc=")
    (if (== (. loc file) no-string)
      (call (. out byte) 45)
      (else
        (call (. out span) (call (. bundle string) (. loc file)))
      )
    )
    (call (. out byte) 58)
    (if (not (. loc is-known))
      (call (. out byte) 63)
      (return)
    )
    (call (. out signed) (. loc line))
    (call (. out byte) 58)
    (call (. out signed) (. loc column))
  )
  (fn-do + type-text _
    (param id MIRTypeId)
    (match ([] (. function types) id)
      (case .void-type
        (call (. out text) "void")
      )
      (case (call .int-type type)
        (call (. out byte) (if-expr (. type is-signed) 105 117))
        (call (. out unsigned) (. type bit-size))
      )
      (case (call .float-type type)
        (call (. out byte) 102)
        (call (. out unsigned) (. type bit-size))
      )
      (case .pointer-type
        (call (. out text) "ptr")
      )
      (case (call .array-type type)
        (call (. out byte) 91)
        (call type-text (. type item))
        (call (. out text) " x ")
        (call (. out unsigned) (. type length))
        (call (. out text) " size=")
        (call (. out unsigned) (. type size))
        (call (. out text) " align=")
        (call (. out unsigned) (. type alignment))
        (call (. out byte) 93)
      )
      (case (call .struct-type type)
        (call (. out byte) 123)
        (call (. out unsigned) (. type format))
        (call (. out text) " size=")
        (call (. out unsigned) (. type size))
        (call (. out text) " align=")
        (call (. out unsigned) (. type alignment))
        (call (. out byte) 58)
        (for (in index (..< (. type fields start) (. type fields end)))
          (let field ([] (. function struct-fields) index))
          (call (. out byte) 32)
          (call type-text (. field type))
          (call (. out byte) 64)
          (call (. out unsigned) (. field offset))
        )
        (if (== (. type fields count) 0)
          (call (. out byte) 32)
        )
        (call (. out byte) 125)
      )
    )
  )
  (fn-do + register-text _
    (param id RegisterId)
    (if (< id 32)
      (call (. out byte) 120)
      (call (. out unsigned) id)
      (else-if (< id 64)
        (call (. out byte) 119)
        (call (. out unsigned) (- id 32))
      )
      (else-if (< id 96)
        (call (. out byte) 100)
        (call (. out unsigned) (- id 64))
      )
      (else-if (< id 128)
        (call (. out byte) 115)
        (call (. out unsigned) (- id 96))
      )
      (else-if (== id 128)
        (call (. out text) "sp")
      )
      (else
        (call (. out text) "pc")
      )
    )
  )
  (fn-do + reg-class-suffix _
    (param reg-class RegClass)
    (match reg-class
      (case= .gpr32
        (call (. out byte) 119)
      )
      (case= .gpr64
        (call (. out byte) 120)
      )
      (case= .fpr32
        (call (. out byte) 115)
      )
      (case= .fpr64
        (call (. out byte) 100)
      )
    )
  )
  (fn-do _ root-mode-text _
    (param mode GCRootMode)
    (call (. out text) (if-expr (== mode .value-root) "value" "address"))
  )
  (fn-do _ descriptor-text _
    (param descriptor StringId)
    (if (== descriptor no-string)
      (call (. out byte) 45)
      (else
        (call (. out span) (call (. bundle string) descriptor))
      )
    )
  )
  (fn-do + vreg-text _
    (param id VRegId)
    (let vreg ([] (. function vregs) id))
    (call (. out byte) 86)
    (call (. out unsigned) (. vreg id))
    (call (. out byte) 46)
    (call reg-class-suffix (. vreg reg-class))
    (if (!= (. vreg hint) no-register)
      (call (. out text) "[hint ")
      (call register-text (. vreg hint))
      (call (. out byte) 93)
    )
    (if (. vreg gc-root)
      (call (. out text) "[root ")
      (call root-mode-text (. vreg gc-root-mode))
      (call (. out byte) 32)
      (call descriptor-text (. vreg gc-descriptor))
      (call (. out byte) 93)
    )
  )
  (fn-do + frame-object-text _
    (param id FrameObjectId)
    (let object ([] (. function frame-objects) id))
    (call (. out byte) 70)
    (call (. out signed) (. ([] (. function slots) (. object slot)) index))
    (call (. out byte) 46)
    (call (. out signed) (. object index))
  )
  (fn-do _ reloc-text _
    (param reloc Reloc)
    (if (== reloc .page-reloc)
      (call (. out text) "@PAGE")
      (else-if (== reloc .pageoff-reloc)
        (call (. out text) "@PAGEOFF")
      )
    )
  )
  (fn-do + operand-text _
    (param id OperandId)
    (if (== id no-operand)
      (call (. out byte) 45)
      (return)
    )
    (match ([] (. function operands) id)
      (case (call .vreg-operand operand)
        (call vreg-text (. operand vreg))
      )
      (case (call .preg-operand operand)
        (call register-text (. operand register))
      )
      (case (call .vreg-group-operand operand)
        (call (. out byte) 123)
        (for (in index (..< (. operand vregs start) (. operand vregs end)))
          (if (!= index (. operand vregs start))
            (call (. out byte) 32)
          )
          (call vreg-text ([] (. function group-vregs) index))
        )
        (call (. out text) "}.")
        (call reg-class-suffix (. operand reg-class))
      )
      (case (call .label-operand operand)
        (call (. out text) "L(")
        (call name-text (. operand name))
        (call (. out byte) 41)
        (call reloc-text (. operand reloc))
      )
      (case (call .symbol-operand operand)
        (call (. out text) "S(")
        (call (. out span) (call (. bundle string) (. operand name)))
        (call (. out byte) 41)
        (call reloc-text (. operand reloc))
      )
      (case (call .label-address-operand operand)
        (call (. out byte) 38)
        (call operand-text (. operand base))
      )
      (case (call .load-address-operand operand)
        (call (. out byte) 91)
        (call operand-text (. operand base))
        (call (. out text) ", ")
        (call operand-text (. operand offset))
        (if (!= (. operand index-shift) 0)
          (call (. out text) ", lsl #")
          (call (. out unsigned) (. operand index-shift))
        )
        (call (. out byte) 93)
        (if (. operand is-pre-index)
          (call (. out byte) 33)
        )
      )
      (case (call .frame-object-operand operand)
        (call frame-object-text (. operand object))
      )
      (case (call .int-operand operand)
        (call (. out byte) 35)
        (if (. operand value is-negative)
          (call (. out signed) (as (. operand value bits) I64))
          (else
            (call (. out unsigned) (. operand value bits))
          )
        )
      )
      (case (call .cond-operand operand)
        (call (. out byte) 63)
        (call (. out unsigned) (. operand code))
      )
      (case .placeholder-operand
        (call (. out byte) 95)
      )
      (case (call .shift-operand operand)
        (if (== (. operand kind) (. MIRShift left))
          (call (. out text) "lsl #")
          (else-if (== (. operand kind) (. MIRShift right))
            (call (. out text) "lsr #")
          )
          (else
            (call (. out text) "asr #")
          )
        )
        (call (. out unsigned) (. operand amount))
      )
    )
  )
  (fn-do _ root-text _
    (param id U32)
    (match ([] (. function roots) id)
      (case (call .register-root root)
        (call register-text (. root register))
      )
      (case (call .stack-root root)
        (call frame-object-text (. root object))
        (call (. out byte) 58)
        (call root-mode-text (. root gc-root-mode))
        (call (. out byte) 58)
        (call descriptor-text (. root gc-descriptor))
      )
    )
  )
  (fn-do _ slot-text _
    (param id MIRSlotId)
    (let slot ([] (. function slots) id))
    (call (. out text) "slot ")
    (call (. out signed) (. slot index))
    (if (. slot is-stack)
      (call (. out text) " stack")
    )
    (call (. out byte) 10)
    (for (in position (..< 0 (. slot objects length)))
      (let object ([] (. function frame-objects) ([] (. slot objects) position)))
      (call (. out text) "  object ")
      (call (. out signed) (. object index))
      (call (. out byte) 32)
      (call type-text (. object type))
      (call (. out text) " offset=")
      (call (. out signed) (. object offset))
      (if (. object can-promote)
        (call (. out text) " promote")
      )
      (if (. object gc-root)
        (call (. out text) " root ")
        (call root-mode-text (. object gc-root-mode))
        (call (. out byte) 32)
        (call descriptor-text (. object gc-descriptor))
      )
      (if (. object is-spill)
        (call (. out text) " spill")
      )
      (if (!= (. object lifetime count) 0)
        (call (. out text) " life=")
        (let cursor (. object lifetime start))
        (while (< cursor (. object lifetime end))
          (if (!= cursor (. object lifetime start))
            (call (. out byte) 44)
          )
          (call (. out unsigned) ([] (. function lifetimes) cursor))
          (call (. out byte) 45)
          (call (. out unsigned) ([] (. function lifetimes) (+ cursor 1)))
          (+= cursor 2)
        )
      )
      (call (. out byte) 10)
    )
  )
  (fn-do _ collect-referenced-slots _
    (call (. referenced clear))
    (call (. is-referenced clear))
    (for (in _ (..< 0 (. function slots length)))
      (+= is-referenced false)
    )
    (for (in index (..< 0 (. function frame-slots length)))
      (call reference-slot ([] (. function frame-slots) index))
    )
    (if (. function overflow is-present)
      (call reference-slot (. function overflow slot))
    )
    (for (in index (..< 0 (. function vars length)))
      (call reference-object ([] (. function vars) index))
    )
    (call reference-roots (. function gc-roots))
    (for (in position (..< 0 (. function block-order length)))
      (let block ([] (. function blocks) ([] (. function block-order) position)))
      (for (in index (..< 0 (. block instructions length)))
        (call reference-instruction ([] (. block instructions) index))
      )
    )
    (call sort-referenced-slots)
  )
  (fn-do _ reference-slot _
    (param slot MIRSlotId)
    (if (not ([] is-referenced slot))
      (= ([] is-referenced slot) true)
      (+= referenced slot)
    )
  )
  (fn-do _ reference-object _
    (param object FrameObjectId)
    (call reference-slot (. ([] (. function frame-objects) object) slot))
  )
  (fn-do _ reference-roots _
    (param roots Span)
    (for (in id (..< (. roots start) (. roots end)))
      (match? ([] (. function roots) id)
        (case (call .stack-root root)
          (call reference-object (. root object))
        )
      )
    )
  )
  (fn-do _ reference-instruction _
    (param id InstructionId)
    (match ([] (. function instructions) id)
      (case (call .assembly-instruction row)
        (call reference-operands (. row operands))
        (call reference-roots (. row gc-roots))
      )
      (case (call .comment-instruction row)
        (call reference-operands (. row operands))
        (call reference-roots (. row gc-roots))
      )
      (case (call .phi-instruction row)
        (call reference-operands (. row operands))
        (call reference-roots (. row gc-roots))
      )
      (case (call .call-instruction row)
        (call reference-operands (. row operands))
        (call reference-operand (. row panic-target))
        (call reference-roots (. row gc-roots))
      )
    )
  )
  (fn-do _ reference-operands _
    (param operands IdList)
    (for (in index (..< 0 (. operands length)))
      (call reference-operand ([] operands index))
    )
  )
  (fn-do _ reference-operand _
    (param id OperandId)
    (if (== id no-operand)
      (return)
    )
    (match? ([] (. function operands) id)
      (case (call .frame-object-operand operand)
        (call reference-object (. operand object))
      )
      (case (call .load-address-operand operand)
        (call reference-operand (. operand base))
        (call reference-operand (. operand offset))
      )
      (case (call .label-address-operand operand)
        (call reference-operand (. operand base))
      )
    )
  )
  (fn-do _ sort-referenced-slots _
    (if (< (. referenced length) 2)
      (return)
    )
    (for (in position (..< 1 (. referenced length)))
      (let slot ([] referenced position))
      (let index (. ([] (. function slots) slot) index))
      (let target position)
      (while (and (> target 0) (> (. ([] (. function slots) ([] referenced (- target 1))) index) index))
        (= ([] referenced target) ([] referenced (- target 1)))
        (-= target 1)
      )
      (= ([] referenced target) slot)
    )
  )
)

(fn-do + name-string String
  (param bundle Bundle)
  (param function MIRFunction)
  (param id StringId)
  (let text (call MIRText bundle function))
  (call (. text name-text) id)
  (return (call (. text out bytes slice-string) (..< 0 (. text out length))))
)
