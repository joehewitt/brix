(type + Span (is Tuple)
  (prop + start U32)
  (prop + count U32)
  (fn-expr + end U32 :get @inline
    (+ start count)
  )
)

(type + IdList (is Tuple)
  (prop + data (of CPointer U32))
  (prop + length U32)
  (prop + capacity U32)
  (fn-expr + (index-get this (param index Index)) U32 @inline
    ([] data index)
  )
  (fn-do + appended This @inline
    (param arena Arena)
    (param id U32)
    (let grown this)
    (if (== length capacity)
      (= grown (call resized arena (if-expr (>= capacity 4) (* capacity 2) 4)))
    )
    (= ([] (. grown data) length) id)
    (return (call IdList (. grown data) (+ length 1) (. grown capacity)))
  )
  (fn-do + inserted This
    (param arena Arena)
    (param index U32)
    (param id U32)
    (let grown this)
    (if (== length capacity)
      (= grown (call resized arena (if-expr (>= capacity 4) (* capacity 2) 4)))
    )
    (let offset length)
    (while (> offset index)
      (= ([] (. grown data) offset) ([] (. grown data) (- offset 1)))
      (-= offset 1)
    )
    (= ([] (. grown data) index) id)
    (return (call IdList (. grown data) (+ length 1) (. grown capacity)))
  )
  (fn-do + resized This
    (param arena Arena)
    (param new-capacity U32)
    (let replacement (call (of (. arena allocate) U32) new-capacity))
    (for (in offset (..< 0 length))
      (= ([] replacement offset) ([] data offset))
    )
    (return (call IdList replacement length new-capacity))
  )
)

(fn-do + new-id-list IdList
  (param arena Arena)
  (param capacity U32)
  (if (== capacity 0)
    (return (call IdList))
  )
  (return (call IdList (call (of (. arena allocate) U32) capacity) 0 capacity))
)

(fn-do + sort-u64 _
  (param arena Arena)
  (param values (of CPointer U64))
  (param count U32)
  (if (< count 2)
    (return)
  )
  (if (<= count 16)
    (for (in position (..< 1 count))
      (let value ([] values position))
      (let target position)
      (while (and (> target 0) (> ([] values (- target 1)) value))
        (= ([] values target) ([] values (- target 1)))
        (-= target 1)
      )
      (= ([] values target) value)
    )
    (return)
  )
  (let source values)
  (let target (call (of (. arena allocate) U64) count))
  (let is-swapped false)
  (let width U32 1)
  (while (< width count)
    (let start U32)
    (while (< start count)
      (let middle (+ start width))
      (if (> middle count)
        (= middle count)
      )
      (let end (+ middle width))
      (if (> end count)
        (= end count)
      )
      (let left start)
      (let right middle)
      (let write start)
      (while (and (< left middle) (< right end))
        (if (< ([] source right) ([] source left))
          (= ([] target write) ([] source right))
          (+= right 1)
          (else
            (= ([] target write) ([] source left))
            (+= left 1)
          )
        )
        (+= write 1)
      )
      (while (< left middle)
        (= ([] target write) ([] source left))
        (+= left 1)
        (+= write 1)
      )
      (while (< right end)
        (= ([] target write) ([] source right))
        (+= right 1)
        (+= write 1)
      )
      (= start end)
    )
    (let swapped source)
    (= source target)
    (= target swapped)
    (= is-swapped (not is-swapped))
    (*= width 2)
  )
  (if is-swapped
    (for (in position (..< 0 count))
      (= ([] values position) ([] source position))
    )
  )
)

(fn-do + stable-order IdList
  (param arena Arena)
  (param ids IdList)
  (param keys (of CPointer U32))
  (let count (. ids length))
  (if (< count 2)
    (return ids)
  )
  (let composite (call (of (. arena allocate) U64) count))
  (for (in position (..< 0 count))
    (= ([] composite position) (/or/ (/lshift/ (as ([] keys position) U64) 32) position))
  )
  (call sort-u64 arena composite count)
  (let sorted (call new-id-list arena count))
  (for (in position (..< 0 count))
    (= ([] (. sorted data) position) ([] ids (as (/and/ ([] composite position) 0xffffffff) U32)))
  )
  (return (call IdList (. sorted data) count count))
)

(type + IdMap (is Tuple)
  (prop + slots (of CPointer U32))
  (prop + capacity U32)
  (prop + count U32)
  (fn-do + get U32
    (param key U32)
    (if (== capacity 0)
      (return no-id)
    )
    (let mask (- capacity 1))
    (let index (call id-slot key mask))
    (while true
      (let found ([] slots (* index 2)))
      (if (== found (+ key 1))
        (return ([] slots (+ (* index 2) 1)))
      )
      (if (== found 0)
        (return no-id)
      )
      (= index (/and/ (+ index 1) mask))
    )
  )
  (fn-do + inserted This
    (param arena Arena)
    (param key U32)
    (param value U32)
    (let map this)
    (if (> (* (+ count 1) 2) capacity)
      (= map (call resized arena (if-expr (>= capacity 8) (* capacity 2) 8)))
    )
    (let mask (- (. map capacity) 1))
    (let index (call id-slot key mask))
    (while true
      (let found ([] (. map slots) (* index 2)))
      (if (== found 0)
        (= ([] (. map slots) (* index 2)) (+ key 1))
        (= ([] (. map slots) (+ (* index 2) 1)) value)
        (return (call IdMap (. map slots) (. map capacity) (+ (. map count) 1)))
      )
      (if (== found (+ key 1))
        (= ([] (. map slots) (+ (* index 2) 1)) value)
        (return map)
      )
      (= index (/and/ (+ index 1) mask))
    )
  )
  (fn-do + resized This
    (param arena Arena)
    (param new-capacity U32)
    (let map (call IdMap (call (of (. arena allocate) U32) (* new-capacity 2)) new-capacity 0))
    (for (in index (..< 0 capacity))
      (let found ([] slots (* index 2)))
      (if (!= found 0)
        (= map (call (. map inserted) arena (- found 1) ([] slots (+ (* index 2) 1))))
      )
    )
    (return map)
  )
)

(fn-expr _ id-slot U32 @inline
  (param key U32)
  (param mask U32)
  (/and/ (/xor/ hash (/zrshift/ hash 16)) mask)
  (where
    (lazy hash (* key 2654435769))
  )
)

(fn-do + new-id-map IdMap
  (param arena Arena)
  (param expected U32)
  (let capacity U32 8)
  (while (< capacity (* expected 2))
    (*= capacity 2)
  )
  (return (call IdMap (call (of (. arena allocate) U32) (* capacity 2)) capacity 0))
)

(type + ByteSpan (is Tuple)
  (prop + data (of CPointer Byte))
  (prop + length Size)
)

(fn-expr + register-number I32
  (param register RegisterId)
  (case? (< register 128)
    (as (% register 32) I32)
  )
  (case? (== register stack-pointer-register)
    31
  )
  (default
    -1
  )
)

(fn-do + role-at U32 @inline
  (param roles U32)
  (param position U32)
  (if (!= (/and/ roles call-roles) 0)
    (if (and (== position 1) (!= (/and/ roles value-call-roles) 0))
      (return def-role)
    )
    (return use-role)
  )
  (if (> position 15)
    (return 0)
  )
  (return (/and/ (/zrshift/ roles (* position 2)) 3))
)

(fn-expr + register-of RegisterId
  (param reg-class RegClass)
  (param number U32)
  (match reg-class
    (case= .gpr64
      number
    )
    (case= .gpr32
      (+ 32 number)
    )
    (case= .fpr64
      (+ 64 number)
    )
    (case= .fpr32
      (+ 96 number)
    )
  )
)

(fn-expr + register-class RegClass
  (param register RegisterId)
  (case? (< register 32)
    .gpr64
  )
  (case? (< register 64)
    .gpr32
  )
  (case? (< register 96)
    .fpr64
  )
  (case? (< register 128)
    .fpr32
  )
  (default
    .gpr64
  )
)

(fn-expr + register-parent RegisterId
  (param register RegisterId)
  (if-expr (or (and (>= register 32) (< register 64)) (and (>= register 96) (< register 128))) parent register)
  (where
    (lazy parent (- register 32))
  )
)

(fn-do + register-view RegisterId
  (param register RegisterId)
  (param reg-class RegClass)
  (let current (call register-class register))
  (if (== current reg-class)
    (return register)
  )
  (if (or (and (== reg-class .gpr32) (== current .gpr64)) (and (== reg-class .fpr32) (== current .fpr64)))
    (return (+ register 32))
  )
  (if (or (and (== reg-class .gpr64) (== current .gpr32)) (and (== reg-class .fpr64) (== current .fpr32)))
    (return (- register 32))
  )
  (throw (call Panic (str "Register " register " has no view of the requested class")))
)

(fn-expr + is-caller-saved-register Bool
  (param register RegisterId)
  (case? (>= register 128)
    false
  )
  (case? (< register 64)
    (<= number 15)
  )
  (default
    (or (<= number 7) (>= number 16))
  )
  (where
    (lazy number (% register 32))
  )
)

(fn-expr + is-callee-saved-register Bool
  (param register RegisterId)
  (case? (>= register 128)
    false
  )
  (case? (< register 64)
    (and (>= number 19) (<= number 28))
  )
  (default
    (and (>= number 8) (<= number 15))
  )
  (where
    (lazy number (% register 32))
  )
)

(fn-expr + is-general-register Bool
  (param register RegisterId)
  (case? (>= register 128)
    false
  )
  (case? (< register 64)
    (or (<= number 15) (and (>= number 19) (<= number 28)))
  )
  (default
    (>= number 8)
  )
  (where
    (lazy number (% register 32))
  )
)

(type + RegisterSet (is Tuple)
  (prop + low U64)
  (prop + middle U64)
  (prop + high U64)
  (fn-expr + has Bool
    (param register RegisterId)
    (case? (< register 64)
      (!= (/and/ low (/lshift/ 1u64 register)) 0)
    )
    (case? (< register 128)
      (!= (/and/ middle (/lshift/ 1u64 (- register 64))) 0)
    )
    (default
      (!= (/and/ high (/lshift/ 1u64 (- register 128))) 0)
    )
  )
  (fn-expr + with This
    (param register RegisterId)
    (case? (< register 64)
      (call RegisterSet (/or/ low (/lshift/ 1u64 register)) middle high)
    )
    (case? (< register 128)
      (call RegisterSet low (/or/ middle (/lshift/ 1u64 (- register 64))) high)
    )
    (default
      (call RegisterSet low middle (/or/ high (/lshift/ 1u64 (- register 128))))
    )
  )
)

