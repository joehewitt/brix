(type + InstructionRow (is Tuple)
  (prop + opcode Opcode)
  (prop + operands IdList)
  (prop + loc LocId)
  (prop + position I32)
  (prop + gc-free-zone Bool)
  (prop + gc-exceptional-safepoint Bool)
  (prop + gc-safepoint Bool)
  (prop + is-phi-copy Bool)
  (prop + has-gc-roots Bool)
  (prop + gc-roots Span)
)

(type + AssemblyInstruction (is InstructionRow))

(type + CallInstruction (is InstructionRow)
  (prop + return-type MIRTypeId)
  (prop + copied-struct-arguments Span)
  (prop + argument-sizes Span)
  (prop + panic-target OperandId)
  (prop + gc-safepoint-proven-free Bool)
