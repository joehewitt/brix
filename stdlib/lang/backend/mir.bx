(prop + u32-type-id MIRTypeId (= 7))
(prop + u64-type-id MIRTypeId (= 8))
(prop + f32-type-id MIRTypeId (= 9))
(prop + f64-type-id MIRTypeId (= 10))
(prop + pointer-type-id MIRTypeId (= 11))
(prop + register-count U32 (= 130))
(prop + frame-pointer-register RegisterId (= 29))
(prop + link-register RegisterId (= 30))
(prop + zero-register RegisterId (= 31))
(prop + zero-register-32 RegisterId (= 63))
(prop + stack-pointer-register RegisterId (= 128))
(prop + no-safepoint-effect U32 (= 4))
(prop + gc-free-effect U32 (= 64))
(blank)
(prop + use-role U32 (= 1))
(prop + def-role U32 (= 2))
(prop _ call-roles U32 (= 0x80000000))
(prop _ value-call-roles U32 (= 0x40000000))
(prop _ opcode-roles (list U32) (= (list 6 22 22 22 22 22 6 22 22 22 22 6 6 6 6 22 22 22 22 22 22 22 22 22 6 6 5 5 5 6 2 7 2 6 22 22 6 6 5 6 5 6 5 6 21 26 2 2 0 0 5 5 1 0 1 1 0 6 6 6 6 6 6 6 6 6 6 6 6 0 9 85 0 6 6 22 22 22 22 22 86 86 22 22 22 1 1 6 6 7 5 6 6 6 5)))
(blank)
(prop + opcode-names (list String) (= (list "NEG" "ADD" "SUB" "MUL" "SDIV" "UDIV" "FNEG" "FADD" "FSUB" "FMUL" "FDIV" "FABS" "FSQRT" "FNEGS" "FNEGD" "AND" "ORR" "EOR" "LSL" "LSR" "ASR" "LSLV" "LSRV" "ASRV" "MVN" "CLZ" "CMP" "FCMPS" "FCMPD" "MOV" "MOVZ" "MOVK" "MOVN" "FMOV" "CSEL" "FCSEL" "LDR" "LDAR" "STR" "LDRB" "STRB" "LDRH" "STRH" "LDRSW" "STP" "LDP" "ADR" "ADRP" "B" "B.cond" "CBZ" "CBNZ" "BR" "BL" "BLR" "RET" "NOP" "SCVTF" "UCVTF" "FCVT" "FCVTZS" "FCVTZU" "UXTW" "SXTW" "UXTH" "SXTH" "UXTB" "SXTB" "CSET" "COMMENT" "CALL" "GC_BARRIER" "PHI" "ADDPTR" "GC_ALLOC" "INLINED_NAME" "UMULH" "SMULH" "UMULL" "SMULL" "MADD" "MSUB" "CSINC" "CSINV" "CSNEG" "TBZ" "TBNZ" "UBFX" "SBFX" "BFI" "CCMP" "LDRSB" "LDRSH" "LDARB" "STLRB")))

