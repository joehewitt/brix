(type + PhiInstruction (is InstructionRow)
  (prop + reg OperandId)
  (prop + exprs IdList)
  (prop + blocks IdList)
)

(type + CommentInstruction (is InstructionRow)
  (prop + text StringId)
)

(type + MIRBlock (is Struct)
  (prop + name StringId)
  (prop + instructions IdList)
  (prop + successors IdList)
  (prop + predecessors IdList)
)

(type + MIRJumpTable (is Struct)
  (prop + name StringId)
  (prop + labels Span)
)

(type + LocalNameKind (is U32)
  (variant edge-block-name (= 0))
  (variant barrier-record-name (= 1))
  (variant barrier-after-name (= 2))
  (variant phi-copy-name (= 3))
  (variant phi-cycle-name (= 4))
  (variant save-layout-context-name (= 5))
  (variant save-callee-saved-name (= 6))
  (variant save-frame-name (= 7))
  (variant restore-frame-name (= 8))
  (variant restore-callee-saved-name (= 9))
  (variant restore-layout-context-name (= 10))
  (variant literal-name (= 11))
  (variant block-name (= 12))
  (variant jump-table-name (= 13))
  (variant allocation-slow-name (= 14))
  (variant allocation-after-name (= 15))
  (variant switch-tree-name (= 16))
)

(type + LocalName (is Struct)
  (prop + kind LocalNameKind)
  (prop + first StringId)
  (prop + second StringId)
  (prop + index U32)
)

(type + MIRCallOverflow (is Tuple)
  (prop + is-present Bool)
  (prop + is-stack Bool)
  (prop + slot MIRSlotId)
  (prop + size I32)
  (prop + alignment I32)
  (prop + length I32)
  (prop + count I32)
  (prop + offset I32)
)

(type + MIRFunction
  (implements (of Usable Void))
  (prop + arena Arena)
  (prop + pool-size U32)
  (prop + order U32)
  (prop + label StringId (= no-string))
  (prop + symbol StringId (= no-string))
  (prop + is-lowered Bool)
  (prop + name StringId (= no-string))
  (prop + display-name StringId (= no-string))
  (prop + compilation-effects U32)
  (prop + is-exported Bool)
  (prop + uses-table-union-cursor-plan Bool)
  (prop + loc LocId (= no-loc))
  (prop + vreg-count U32)
  (prop + uses-layout-context Bool)
  (prop + closure-root FrameObjectId (= no-frame-object))
  (prop + capture-closure-root FrameObjectId (= no-frame-object))
  (prop + frame-bytes U32)
  (prop + overflow MIRCallOverflow)
  (prop + frame-slots IdList)
  (prop + vars IdList)
  (prop + block-order IdList)
  (prop + gc-roots Span)
  (prop + locs (of Table MIRLoc))
  (prop + types (of Table MIRType))
  (prop + struct-fields (of Table StructField))
  (prop + slots (of Table MIRFrameSlot))
  (prop + frame-objects (of Table MIRFrameObject))
  (prop + vregs (of Table MIRVirtualRegister))
  (prop + operands (of Table MIROperand))
  (prop + group-vregs IdList)
  (prop + lifetimes IdList)
  (prop + roots (of Table MIRGCRoot))
  (prop + saved-registers (of Table SavedRegister))
  (prop + instructions (of Table MIRInstruction))
  (prop + words IdList)
  (prop + names IdList)
  (prop + blocks (of Table MIRBlock))
  (prop + jump-tables (of Table MIRJumpTable))
  (prop + pad-sites (of Table PadSite))
  (prop + local-names (of Table LocalName))
  (prop _ use-counts (of CPointer U32))
  (prop _ use-count-capacity U32)
  (prop _ has-use-counts Bool)
  (prop _ released Bool)
  (fn-do + This _
    (call add-named-types)
    (blank)
    (lazy locs (call (of Table MIRLoc) arena 16))
    (lazy types (call (of Table MIRType) arena 16))
    (lazy struct-fields (call (of Table StructField) arena 4))
    (lazy slots (call (of Table MIRFrameSlot) arena 8))
    (lazy frame-objects (call (of Table MIRFrameObject) arena 8))
    (lazy vregs (call (of Table MIRVirtualRegister) arena 32))
    (lazy operands (call (of Table MIROperand) arena 128))
    (lazy roots (call (of Table MIRGCRoot) arena 4))
    (lazy saved-registers (call (of Table SavedRegister) arena 4))
    (lazy instructions (call (of Table MIRInstruction) arena 64))
    (lazy blocks (call (of Table MIRBlock) arena 8))
    (lazy jump-tables (call (of Table MIRJumpTable) arena 4))
    (lazy pad-sites (call (of Table PadSite) arena 4))
    (lazy local-names (call (of Table LocalName) arena 4))
  )
  (fn-expr + begin-using _
    this
  )
  (fn-do + end-using _
    (call release)
  )
  (fn-do + release _
    (if (not released)
      (call (. arena release))
      (= released true)
    )
  )
  (fn-do + reset _
    (call (. arena reset))
    (= order 0)
    (= label no-string)
    (= symbol no-string)
    (= is-lowered false)
    (= name no-string)
    (= display-name no-string)
    (= compilation-effects 0)
    (= is-exported false)
    (= uses-table-union-cursor-plan false)
    (= loc no-loc)
    (= vreg-count 0)
    (= uses-layout-context false)
    (= closure-root no-frame-object)
    (= capture-closure-root no-frame-object)
    (= frame-bytes 0)
    (= overflow (call MIRCallOverflow))
    (= frame-slots (call IdList))
    (= vars (call IdList))
    (= block-order (call IdList))
    (= gc-roots (call Span))
    (= locs (call (of Table MIRLoc) arena 16))
    (= types (call (of Table MIRType) arena 16))
    (= struct-fields (call (of Table StructField) arena 4))
    (= slots (call (of Table MIRFrameSlot) arena 8))
    (= frame-objects (call (of Table MIRFrameObject) arena 8))
    (= vregs (call (of Table MIRVirtualRegister) arena 32))
    (= operands (call (of Table MIROperand) arena 128))
    (= group-vregs (call IdList))
    (= lifetimes (call IdList))
    (= roots (call (of Table MIRGCRoot) arena 4))
    (= saved-registers (call (of Table SavedRegister) arena 4))
    (= instructions (call (of Table MIRInstruction) arena 64))
    (= words (call IdList))
    (= names (call IdList))
    (= blocks (call (of Table MIRBlock) arena 8))
    (= jump-tables (call (of Table MIRJumpTable) arena 4))
    (= pad-sites (call (of Table PadSite) arena 4))
    (= local-names (call (of Table LocalName) arena 4))
    (= has-use-counts false)
    (= use-count-capacity 0)
    (call add-named-types)
  )
  (fn-do + add-local-name StringId
    (param kind LocalNameKind)
    (param first StringId)
    (param second StringId)
    (param index U32)
    (let row U32 (as (. local-names length) U32))
    (call (. local-names append) (call LocalName kind first second index))
    (return (+ pool-size row))
  )
  (fn-expr + is-gc-free Bool :get
    (!= (/and/ compilation-effects gc-free-effect) 0)
  )
  (fn-expr + operand-roles U32 @inline
    (param id InstructionId)
    (call roles-with id (. ([] instructions id) opcode))
  )
  (fn-do + roles-with U32 @inline
    (param id InstructionId)
    (param opcode Opcode)
    ; The role of each operand of an instruction whose opcode is read already. Only a call is a call
    ; instruction, so its kind is read only where its opcode is a call's.
    (if (== opcode .call)
      (match? ([] instructions id)
        (case (call .call-instruction call)
          (match? ([] types (. call return-type))
            (case .void-type
              (return call-roles)
            )
          )
          (return (/or/ call-roles value-call-roles))
        )
      )
    )
    (let roles ([] opcode-roles opcode))
    (if (and (or plain-load signed-load) (== (. ([] instructions id) operands length) 3))
      (= roles (/or/ roles 12))
    )
    (lazy plain-load (or (== opcode .ldr) (== opcode .ldrb) (== opcode .ldrh)))
    (lazy signed-load (or (== opcode .ldrsw) (== opcode .ldrsb) (== opcode .ldrsh)))
    (return roles)
  )
  (fn-expr + instruction-def VRegId
    (param id InstructionId)
    (call def-with id (. ([] instructions id) opcode))
  )
  (fn-do + def-with VRegId
    (param id InstructionId)
    (param opcode Opcode)
    ; The vreg an instruction whose opcode is read already defines first.
    (let roles (call roles-with id opcode))
    (let list (. ([] instructions id) operands))
    (for (in position (..< 0 (. list length)))
      (if (== (/and/ (call role-at roles position) def-role) 0)
        (continue)
      )
      (match? ([] operands ([] list position))
        (case (call .vreg-operand operand)
          (return (. operand vreg))
        )
      )
    )
    (return no-id)
  )
  (fn-do + count-uses _
    (if has-use-counts
      (return)
    )
    (= use-count-capacity (+ vreg-count (/ vreg-count 2) 16))
    (= use-counts (call (of (. arena allocate) U32) use-count-capacity))
    (= has-use-counts true)
    (for (in position (..< 0 (. block-order length)))
      (let list (. ([] blocks ([] block-order position)) instructions))
      (for (in index (..< 0 (. list length)))
        (call tally-uses ([] list index) true)
      )
    )
  )
  (fn-expr + use-count U32 @inline
    (param vreg U32)
    (if-expr (< vreg use-count-capacity) ([] use-counts vreg) 0)
  )
  (fn-do + forget-use-counts _
    (= has-use-counts false)
  )
  (fn-do + add-uses _
    (param id InstructionId)
    (if has-use-counts
      (call tally-uses id true)
    )
  )
  (fn-do + drop-uses _
    (param id InstructionId)
    (if has-use-counts
      (call tally-uses id false)
    )
  )
  (fn-do + drop-operand-uses _
    (param operand OperandId)
    (if has-use-counts
      (call tally-operand operand false)
    )
  )
  (fn-do _ tally-uses _
    (param id InstructionId)
    (param adds Bool)
    (let opcode (. ([] instructions id) opcode))
    (if (== opcode .phi)
      (match? ([] instructions id)
        (case (call .phi-instruction phi)
          (for (in entry (..< 0 (. phi exprs length)))
            (call tally-operand ([] (. phi exprs) entry) adds)
          )
        )
      )
      (return)
    )
    (let roles (call roles-with id opcode))
    (let list (. ([] instructions id) operands))
    (for (in position (..< 0 (. list length)))
      (if (!= (/and/ (call role-at roles position) use-role) 0)
        (call tally-operand ([] list position) adds)
      )
    )
  )
  (fn-do _ tally-operand _
    (param operand OperandId)
    (param adds Bool)
    (if (== operand no-operand)
      (return)
    )
    (match? ([] operands operand)
      (case (call .vreg-operand row)
        (call tally (. ([] vregs (. row vreg)) id) adds)
      )
      (case (call .vreg-group-operand group)
        (for (in index (..< (. group vregs start) (. group vregs end)))
          (call tally (. ([] vregs ([] group-vregs index)) id) adds)
        )
      )
      (case (call .load-address-operand address)
        (call tally-operand (. address base) adds)
        (call tally-operand (. address offset) adds)
      )
    )
  )
  (fn-do _ tally _
    (param vreg U32)
    (param adds Bool)
    (if adds
      (if (>= vreg use-count-capacity)
        (let grown-capacity (+ vreg (/ vreg 2) 16))
        (let grown (call (of (. arena allocate) U32) grown-capacity))
        (for (in index (..< 0 use-count-capacity))
          (= ([] grown index) ([] use-counts index))
        )
        (= use-counts grown)
        (= use-count-capacity grown-capacity)
      )
      (= ([] use-counts vreg) (+ ([] use-counts vreg) 1))
      (return)
    )
    (throw (call Panic (str "A use of V" vreg " is released that was never counted")) (if (or (>= vreg use-count-capacity) (== ([] use-counts vreg) 0))))
    (= ([] use-counts vreg) (- ([] use-counts vreg) 1))
  )
  (fn-do + post-order IdList
    (let count U32 (as (. blocks length) U32))
    (let order (call new-id-list arena count))
    (if (== (. block-order length) 0)
      (return order)
    )
    (let visited (call (of (. arena allocate) Byte) count))
    (let pending (call (of (. arena allocate) U32) count))
    (let cursors (call (of (. arena allocate) U32) count))
    (let root ([] block-order 0))
    (let depth U32 1)
    (= ([] pending 0) root)
    (= ([] visited root) 1)
    (while (!= depth 0)
      (let block ([] pending (- depth 1)))
      (let successors (. ([] blocks block) successors))
      (let cursor ([] cursors (- depth 1)))
      (if (< cursor (. successors length))
        (= ([] cursors (- depth 1)) (+ cursor 1))
        (let successor ([] successors cursor))
        (if (== ([] visited successor) 0)
          (= ([] visited successor) 1)
          (= ([] pending depth) successor)
          (= ([] cursors depth) 0)
          (+= depth 1)
        )
        (continue)
      )
      (= order (call (. order appended) arena block))
      (-= depth 1)
    )
    (return order)
  )
  (fn-do _ add-named-types _
    (call (. types append) (call VoidType 0 0))
    (call (. types append) (call IntType 1 1 8 true .gpr32))
    (call (. types append) (call IntType 2 2 16 true .gpr32))
    (call (. types append) (call IntType 4 4 32 true .gpr32))
    (call (. types append) (call IntType 8 8 64 true .gpr64))
    (call (. types append) (call IntType 1 1 8 false .gpr32))
    (call (. types append) (call IntType 2 2 16 false .gpr32))
    (call (. types append) (call IntType 4 4 32 false .gpr32))
    (call (. types append) (call IntType 8 8 64 false .gpr64))
    (call (. types append) (call FloatType 4 4 32 .fpr32))
    (call (. types append) (call FloatType 8 8 64 .fpr64))
    (call (. types append) (call PointerType 8 8 .gpr64))
  )
)
