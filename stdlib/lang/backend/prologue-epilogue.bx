(import ./builder)
(import ./bundle)
(import ./frame-coloring)
(import ./mir)
(import /core/arena)
(import /core/table)
(blank)
(prop _ max-aligned-stack-immediate I64 (= 4080))
(prop _ max-frame-address-immediate I64 (= 16773120))
(prop _ stack-probe-threshold I64 (= 0x8000))
(prop _ stack-probe-interval I64 (= 0x4000))
(prop _ zero-stack-frame-stub-threshold I32 (= 128))
(prop _ saved-frame-size I32 (= 16))
(prop _ first-address-scratch RegisterId (= 16))
(prop _ second-address-scratch RegisterId (= 17))
(prop _ layout-context-register RegisterId (= 28))

(type + MIRPrologueEpilogue
  (prop _ builder MIRBuilder)
  (prop _ bundle Bundle)
  (prop _ function MIRFunction)
  (prop _ coloring MIRFrameColoring)
  (prop _ stack-size I64)
  (prop _ scratch-register RegisterId)
  (prop _ address-scratch RegisterId)
  (prop _ first-pairs IdList)
  (prop _ second-pairs IdList)
  (fn-do + This _
    (param builder MIRBuilder)
    (param coloring MIRFrameColoring)
    (lazy bundle (. builder bundle))
    (lazy function (. builder function))
  )
  (fn-expr _ arena Arena :get @inline
    (. function arena)
  )
  (fn-do + run _
    (param used-callee-saved IdList)
    (param scratch RegisterId)
    (param outgoing I64)
    (let size (call (. coloring pack-frame-objects) (call (. builder finalize-stack))))
    (call (. coloring deduplicate-roots))
    (= stack-size (+ (as size I64) outgoing))
    (= scratch-register scratch)
    (= (. function frame-bytes) (as stack-size U32))
    (call write-prologue-and-epilogue used-callee-saved)
    (call rewrite-frame-operands)
  )
  (fn-do _ write-prologue-and-epilogue _
    (param used-callee-saved IdList)
    (let order (. function block-order))
    (if (== (. order length) 0)
      (return)
    )
    (let fp (call (. builder preg) frame-pointer-register))
    (let lr (call (. builder preg) link-register))
    (let sp (call (. builder preg) stack-pointer-register))
    (let entry ([] order 0))
    (let entry-instructions (call (. builder take-instructions) entry))
    (let callee-saved-size I32)
    (let saved-registers IdList)
    (let saved-offsets (call (of (. arena allocate) I32) (+ (. used-callee-saved length) 1)))
    (blank)
    (if (. function uses-layout-context)
      (call (. builder comment) (call (. function add-local-name) .save-layout-context-name no-string no-string 0))
      (call (. builder str) (call (. builder preg) first-address-scratch) (call (. builder load-address-offset) sp -16 true))
      (+= callee-saved-size 16)
      (= ([] saved-offsets (. saved-registers length)) (- 0 callee-saved-size))
      (= saved-registers (call (. saved-registers appended) arena layout-context-register))
    )
    (blank)
    (call (. builder comment) (call (. function add-local-name) .save-callee-saved-name no-string no-string 0))
    (call group-pairs used-callee-saved)
    (let cursor U32)
    (while (< cursor (. first-pairs length))
      (let first ([] first-pairs cursor))
      (let second ([] second-pairs cursor))
      (+= cursor 1)
      (let address (call (. builder load-address-offset) sp -16 true))
      (+= callee-saved-size 16)
      (= ([] saved-offsets (. saved-registers length)) (- 0 callee-saved-size))
      (= saved-registers (call (. saved-registers appended) arena first))
      (if (== second no-register)
        (call (. builder str) (call (. builder preg) first) address)
        (else
          (call (. builder stp) (call (. builder preg) first) (call (. builder preg) second) address)
          (= ([] saved-offsets (. saved-registers length)) (- 8 callee-saved-size))
          (= saved-registers (call (. saved-registers appended) arena second))
        )
      )
    )
    (for (in index (..< 0 (. saved-registers length)))
      (call (. function saved-registers append)
        (block
          (call SavedRegister
            (block
              (arg ([] saved-registers index))
              (arg (+ ([] saved-offsets index) callee-saved-size saved-frame-size))
            )
          )
        )
      )
    )
    (blank)
    (call (. builder comment) (call (. function add-local-name) .save-frame-name no-string no-string 0))
    (call (. builder stp) fp lr (call (. builder load-address-offset) sp -16 true))
    (call (. builder mov) fp sp)
    (blank)
    (if (. function overflow is-present)
      (let overflow (. function overflow))
      (let count (+ (. overflow count) (as (. ([] (. function slots) (. overflow slot)) objects length) I32)))
      (let start (+ saved-frame-size callee-saved-size))
      (let offset (call (. builder finalize-overflow) (. overflow slot) start))
      (let size (* (/ (+ (- offset start) 15) 16) 16))
      (= (. function overflow)
        (call MIRCallOverflow
          (block
            (arg true)
            (arg (. overflow is-stack))
            (arg (. overflow slot))
            (arg size)
            (arg size)
            (arg count)
            (arg count)
            (arg offset)
          )
        )
      )
    )
    (blank)
    (call allocate-frame sp)
    (call zero-root-frame-objects fp)
    (blank)
    (let merged (. ([] (. function blocks) entry) instructions))
    (for (in index (..< 0 (. entry-instructions length)))
      (= merged (call (. merged appended) arena ([] entry-instructions index)))
    )
    (= (. ([] (. function blocks) entry) instructions) merged)
    (blank)
    (for (in position (..< 0 (. order length)))
      (let instructions (call (. builder take-instructions) ([] order position)))
      (for (in index (..< 0 (. instructions length)))
        (let id ([] instructions index))
        (if (== (. ([] (. function instructions) id) opcode) .ret)
          (call write-epilogue fp lr sp)
        )
        (call (. builder append) id)
      )
    )
  )
  (fn-do _ allocate-frame _
    (param sp OperandId)
    ; Moves the stack pointer down over the frame. A frame larger than the probe threshold is
    ; taken a probe interval at a time, each step stored to as it is taken, so that a stack that
    ; overflows faults in the guard below it rather than past the guard.
    (let remaining stack-size)
    (if (> remaining stack-probe-threshold)
      (let zero (call (. builder preg) zero-register))
      (while (> remaining stack-probe-interval)
        (call (. builder sub-immediate) sp sp stack-probe-interval stack-probe-interval)
        (call (. builder str) zero (call (. builder load-address) sp))
        (-= remaining stack-probe-interval)
      )
    )
    (if (> remaining 0)
      (call (. builder sub-immediate) sp sp remaining max-aligned-stack-immediate)
    )
  )
  (fn-do _ write-epilogue _
    (param fp OperandId)
    (param lr OperandId)
    (param sp OperandId)
    (if (> stack-size 0)
      (call (. builder add-immediate) sp sp stack-size max-aligned-stack-immediate)
    )
    (call (. builder comment) (call (. function add-local-name) .restore-frame-name no-string no-string 0))
    (call (. builder ldp) fp lr (call (. builder load-address) sp) (call (. builder small-int) 16))
    (if (!= (. first-pairs length) 0)
      (call (. builder comment) (call (. function add-local-name) .restore-callee-saved-name no-string no-string 0))
      (let address (call (. builder load-address) sp))
      (let cursor (. first-pairs length))
      (while (> cursor 0)
        (-= cursor 1)
        (if (== ([] second-pairs cursor) no-register)
          (call (. builder ldr) (call (. builder preg) ([] first-pairs cursor)) address (call (. builder small-int) 16))
          (else
            (call (. builder ldp)
              (block
                (arg (call (. builder preg) ([] first-pairs cursor)))
                (arg (call (. builder preg) ([] second-pairs cursor)))
                (arg address)
                (arg (call (. builder small-int) 16))
              )
            )
          )
        )
      )
    )
    (if (. function uses-layout-context)
      (call (. builder comment) (call (. function add-local-name) .restore-layout-context-name no-string no-string 0))
      (call (. builder ldr)
        (block
          (arg (call (. builder preg) layout-context-register))
          (arg (call (. builder load-address) sp))
          (arg (call (. builder small-int) 16))
        )
      )
    )
  )
  (fn-do _ group-pairs _
    (param registers IdList)
    (= first-pairs (call IdList))
    (= second-pairs (call IdList))
    (if (== (. registers length) 0)
      (return)
    )
    (let first-class (call register-class ([] registers 0)))
    (call add-pairs registers first-class true)
    (call add-pairs registers first-class false)
  )
  (fn-do _ add-pairs _
    (param registers IdList)
    (param first-class RegClass)
    (param is-first-class Bool)
    (let pending no-register)
    (for (in index (..< 0 (. registers length)))
      (let register ([] registers index))
      (if (!= (== (call register-class register) first-class) is-first-class)
        (continue)
      )
      (if (== pending no-register)
        (= pending register)
        (else
          (= first-pairs (call (. first-pairs appended) arena pending))
          (= second-pairs (call (. second-pairs appended) arena register))
          (= pending no-register)
        )
      )
    )
    (if (!= pending no-register)
      (= first-pairs (call (. first-pairs appended) arena pending))
      (= second-pairs (call (. second-pairs appended) arena no-register))
    )
  )
  (fn-do _ zero-root-frame-objects _
    (param fp OperandId)
    (let objects IdList)
    (for (in position (..< 0 (. function frame-slots length)))
      (let slot-objects (. ([] (. function slots) ([] (. function frame-slots) position)) objects))
      (for (in index (..< 0 (. slot-objects length)))
        (let object ([] slot-objects index))
        (if (and (. ([] (. function frame-objects) object) gc-root) (not (. ([] (. function frame-objects) object) can-promote)))
          (= objects (call (. objects appended) arena object))
        )
      )
    )
    (let count (. objects length))
    (if (== count 0)
      (return)
    )
    (let keys (call (of (. arena allocate) U32) count))
    (for (in index (..< 0 count))
      (= ([] keys index) (as (+ (as (. ([] (. function frame-objects) ([] objects index)) offset) I64) 0x80000000) U32))
    )
    (= objects (call stable-order arena objects keys))
    (blank)
    (let scratch (call (. builder preg) first-address-scratch))
    (let address (call (. builder preg) 0))
    (let byte-count (call (. builder preg) 1))
    (let sp (call (. builder preg) stack-pointer-register))
    (let xzr (call (. builder preg) zero-register))
    (let wzr (call (. builder preg) zero-register-32))
    (let index U32)
    (while (< index count)
      (let start (. ([] (. function frame-objects) ([] objects index)) offset))
      (let end (+ start (as (call (. builder frame-object-size) (. ([] (. function frame-objects) ([] objects index)) type)) I32)))
      (+= index 1)
      (while (and (< index count) (<= (. ([] (. function frame-objects) ([] objects index)) offset) end))
        (let other ([] objects index))
        (let other-end
          (scope (+ (. ([] (. function frame-objects) other) offset) other-size)
            (lazy other-size (as (call (. builder frame-object-size) (. ([] (. function frame-objects) other) type)) I32))
          )
        )
        (if (> other-end end)
          (= end other-end)
        )
        (+= index 1)
      )
      (blank)
      (let size (- end start))
      (if (>= size zero-stack-frame-stub-threshold)
        (call (. builder stp) address byte-count (call (. builder load-address-offset) sp -16 true))
        (call materialize-frame-address fp address start)
        (call (. builder mov) byte-count (call (. builder small-int) size))
        (call (. builder bl) (call (. builder symbol) (. bundle zero-stack-frame-symbol)))
        (call (. builder ldp) address byte-count (call (. builder load-address) sp) (call (. builder small-int) 16))
        (continue)
      )
      (blank)
      (let offset start)
      (while (<= (+ offset 16) end)
        (call (. builder stp) xzr xzr (call frame-pair-address fp scratch offset))
        (+= offset 16)
      )
      (if (<= (+ offset 8) end)
        (call (. builder str) xzr (call frame-address fp scratch offset))
        (+= offset 8)
      )
      (if (<= (+ offset 4) end)
        (call (. builder str) wzr (call frame-address fp scratch offset))
        (+= offset 4)
      )
      (if (<= (+ offset 2) end)
        (call (. builder strh) wzr (call frame-address fp scratch offset))
        (+= offset 2)
      )
      (if (< offset end)
        (call (. builder strb) wzr (call frame-address fp scratch offset))
      )
    )
  )
  (fn-do _ frame-pair-address OperandId
    (param fp OperandId)
    (param scratch OperandId)
    (param offset I32)
    (if (and (== (% offset 8) 0) (>= offset -512) (<= offset 504))
      (return (call (. builder load-address-offset) fp offset))
    )
    (call materialize-frame-address fp scratch offset)
    (return (call (. builder load-address-offset) scratch 0))
  )
  (fn-do _ frame-address OperandId
    (param fp OperandId)
    (param scratch OperandId)
    (param offset I32)
    (if (and (>= offset -255) (<= offset 4095))
      (return (call (. builder load-address-offset) fp offset))
    )
    (call materialize-frame-address fp scratch offset)
    (return (call (. builder load-address-offset) scratch 0))
  )
  (fn-do _ materialize-frame-address _
    (param fp OperandId)
    (param scratch OperandId)
    (param offset I64)
    (if (< offset 0)
      (call (. builder sub-immediate) scratch fp (- 0 offset) max-frame-address-immediate)
      (else
        (call (. builder add-immediate) scratch fp offset max-frame-address-immediate)
      )
    )
  )
  (fn-do _ rewrite-frame-operands _
    (let order (. function block-order))
    (for (in position (..< 0 (. order length)))
      (let instructions (call (. builder take-instructions) ([] order position)))
      (for (in index (..< 0 (. instructions length)))
        (let id ([] instructions index))
        (let opcode (. ([] (. function instructions) id) opcode))
        (let operands (. ([] (. function instructions) id) operands))
        (let count (. operands length))
        (let lowers-address
          (scope (or (== opcode .addptr) (and (== opcode .mov) (> count 1) loads-address))
            (lazy loads-address (call is-load-address ([] operands 1)))
          )
        )
        (if (and (not lowers-address) (not (call has-frame-operand operands)))
          (call (. builder append) id)
          (continue)
        )
        (= address-scratch no-register)
        (let rewritten (call new-id-list arena count))
        (for (in operand (..< 0 count))
          (= ([] (. rewritten data) operand) (call rewrite-operand id operands operand))
        )
        (= (. ([] (. function instructions) id) operands) (call IdList (. rewritten data) count count))
        (throw (call Panic "An address is lowered from an instruction without a source") (if (and lowers-address (< count 2))))
        (if (or (== opcode .addptr) (and (== opcode .mov) (> count 1) (call is-load-address ([] (. rewritten data) 1))))
          (call add-address ([] (. rewritten data) 0) ([] (. rewritten data) 1))
          (else
            (call (. builder append) id)
          )
        )
      )
    )
  )
  (fn-do _ is-load-address Bool
    (param operand OperandId)
    (match? ([] (. function operands) operand)
      (case .load-address-operand
        (return true)
      )
    )
    (return false)
  )
  (fn-do _ frame-object-of FrameObjectId
    (param operand OperandId)
    (let base no-operand)
    (match? ([] (. function operands) operand)
      (case (call .frame-object-operand row)
        (return (. row object))
      )
      (case (call .load-address-operand row)
        (= base (. row base))
      )
    )
    (if (!= base no-operand)
      (match? ([] (. function operands) base)
        (case (call .frame-object-operand row)
          (return (. row object))
        )
      )
    )
    (return no-frame-object)
  )
  (fn-do _ has-frame-operand Bool
    (param operands IdList)
    (for (in index (..< 0 (. operands length)))
      (if (call has-frame-base ([] operands index))
        (return true)
      )
    )
    (return false)
  )
  (fn-do _ has-frame-base Bool
    (param operand OperandId)
    (let base no-operand)
    (match? ([] (. function operands) operand)
      (case .frame-object-operand
        (return true)
      )
      (case (call .load-address-operand row)
        (= base (. row base))
      )
    )
    (if (!= base no-operand)
      (return (call has-frame-base base))
    )
    (return false)
  )
  (fn-do _ take-address-scratch RegisterId
    (param id InstructionId)
    (param operands IdList)
    (if (!= address-scratch no-register)
      (return address-scratch)
    )
    (let unavailable RegisterSet)
    (for (in index (..< 0 (. operands length)))
      (= unavailable (call reserved-registers unavailable ([] operands index)))
    )
    (if (not (call (. unavailable has) first-address-scratch))
      (= address-scratch first-address-scratch)
      (else-if (not (call (. unavailable has) second-address-scratch))
        (= address-scratch second-address-scratch)
      )
      (else-if (not (call (. unavailable has) scratch-register))
        (= address-scratch scratch-register)
      )
    )
    (throw (call Panic (str "No frame-address scratch available while rewriting " opcode-name)) (if (== address-scratch no-register)))
    (lazy opcode-name ([] opcode-names (. ([] (. function instructions) id) opcode)))
    (return address-scratch)
  )
  (fn-do _ reserved-registers RegisterSet
    (param registers RegisterSet)
    (param operand OperandId)
    (let base no-operand)
    (let offset no-operand)
    (match? ([] (. function operands) operand)
      (case (call .preg-operand row)
        (return (call (. registers with) (call register-parent (. row register))))
      )
      (case (call .load-address-operand row)
        (= base (. row base))
        (= offset (. row offset))
      )
    )
    (let reserved registers)
    (if (!= base no-operand)
      (= reserved (call reserved-registers reserved base))
    )
    (if (!= offset no-operand)
      (= reserved (call reserved-registers reserved offset))
    )
    (return reserved)
  )
  (fn-do _ rewrite-operand OperandId
    (param id InstructionId)
    (param operands IdList)
    (param index U32)
    (let operand ([] operands index))
    (let object (call frame-object-of operand))
    (if (== object no-frame-object)
      (return operand)
    )
    (if (< (. ([] (. function frame-objects) object) index) 0)
      (return (call (. builder load-address-offset) (call (. builder preg) (call take-address-scratch id operands)) 0))
    )
    (blank)
    (let opcode (. ([] (. function instructions) id) opcode))
    (let size (call address-size opcode operands index))
    (let frame-offset I64 (. ([] (. function frame-objects) object) offset))
    (let base frame-pointer-register)
    (let offset frame-offset)
    (if (. ([] (. function slots) (. ([] (. function frame-objects) object) slot)) is-stack)
      (= base stack-pointer-register)
      (else
        (let stack-offset (+ stack-size frame-offset))
        (if (and (>= stack-offset 0) (< (call offset-cost stack-offset size) (call offset-cost frame-offset size)))
          (= base stack-pointer-register)
          (= offset stack-offset)
        )
      )
    )
    (let pair (call pair-size opcode operands index))
    (let fits (if-expr (> pair 0) (call can-address-pair offset pair) (call can-address offset size)))
    (if fits
      (return (call (. builder load-address-offset) (call (. builder preg) base) offset))
    )
    (let scratch (call (. builder preg) (call take-address-scratch id operands)))
    (if (< offset 0)
      (call (. builder sub-immediate) scratch (call (. builder preg) base) (- 0 offset) max-frame-address-immediate)
      (else
        (call (. builder add-immediate) scratch (call (. builder preg) base) offset max-frame-address-immediate)
      )
    )
    (return (call (. builder load-address-offset) scratch 0))
  )
  (fn-do _ address-size I64
    (param opcode Opcode)
    (param operands IdList)
    (param index U32)
    (if (!= index 1)
      (return 0)
    )
    (if (or (== opcode .ldrb) (== opcode .strb) (== opcode .ldrsb) (== opcode .ldarb) (== opcode .stlrb))
      (return 1)
    )
    (if (or (== opcode .ldrh) (== opcode .strh) (== opcode .ldrsh))
      (return 2)
    )
    (if (== opcode .ldrsw)
      (return 4)
    )
    (if (or (== opcode .ldr) (== opcode .ldar) (== opcode .str))
      (match? ([] (. function operands) ([] operands 0))
        (case (call .preg-operand row)
          (let reg-class (call register-class (. row register)))
          (return (if-expr (or (== reg-class .gpr32) (== reg-class .fpr32)) 4 8))
        )
      )
    )
    (return 0)
  )
  (fn-do _ pair-size I64
    (param opcode Opcode)
    (param operands IdList)
    (param index U32)
    (if (or (!= index 2) (and (!= opcode .ldp) (!= opcode .stp)))
      (return 0)
    )
    (match? ([] (. function operands) ([] operands 0))
      (case (call .preg-operand row)
        (let reg-class (call register-class (. row register)))
        (return (if-expr (or (== reg-class .gpr32) (== reg-class .fpr32)) 4 8))
      )
    )
    (return 8)
  )
  (fn-do _ add-address _
    (param destination OperandId)
    (param address OperandId)
    (let base no-operand)
    (let offset no-operand)
    (match? ([] (. function operands) address)
      (case (call .load-address-operand row)
        (= base (. row base))
        (= offset (. row offset))
      )
    )
    (throw (call Panic "A lowered address is not a load address") (if (== base no-operand)))
    (match? ([] (. function operands) base)
      (case (call .preg-operand row)
        (if (== (call register-class (. row register)) .gpr32)
          (= base (call (. builder preg) (call register-parent (. row register))))
        )
      )
    )
    (if (== offset no-operand)
      (call (. builder mov) destination base)
      (return)
    )
    (let is-int false)
    (let value I64)
    (match? ([] (. function operands) offset)
      (case (call .int-operand row)
        (= is-int true)
        (= value (as (. row value bits) I64))
      )
    )
    (if (not is-int)
      (call (. builder add) destination base offset)
      (else-if (< value 0)
        (call (. builder sub-immediate) destination base (- 0 value) max-frame-address-immediate)
      )
      (else
        (call (. builder add-immediate) destination base value max-frame-address-immediate)
      )
    )
  )
)

(fn-expr _ can-address Bool
  (param offset I64)
  (param size I64)
  (case? (and (>= offset -255) (<= offset 255))
    true
  )
  (case? (> size 0)
    (and (>= offset 0) (== (% offset size) 0) (<= (/ offset size) 4095))
  )
  (default
    (and (>= offset 0) (<= offset 4095))
  )
)

(fn-expr _ can-address-pair Bool
  (param offset I64)
  (param size I64)
  (and (== (% offset size) 0) (>= (/ offset size) -64) (<= (/ offset size) 63))
)

(fn-do _ offset-cost U32
  (param offset I64)
  (param size I64)
  (if (call can-address offset size)
    (return 0)
  )
  (let remaining (if-expr (>= offset 0) offset (- 0 offset)))
  (if (== remaining 0)
    (return 1)
  )
  (let count U32)
  (while (> remaining 0)
    (if (<= remaining 4095)
      (= remaining 0)
      (else
        (let units (/ remaining 4096))
        (if (> units 4095)
          (= units 4095)
        )
        (-= remaining (* units 4096))
      )
    )
    (+= count 1)
  )
  (return count)
)
