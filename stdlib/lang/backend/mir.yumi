────────────────────
+ begin-using

this

────────────────────
+ do end-using

release()

────────────────────
+ do release

if !released
    arena.release()
    released = true

────────────────────
+ do reset

arena.reset()
order = 0
label = no-string
symbol = no-string
is-lowered = false
name = no-string
display-name = no-string
compilation-effects = 0
is-exported = false
uses-table-union-cursor-plan = false
loc = no-loc
vreg-count = 0
uses-layout-context = false
closure-root = no-frame-object
capture-closure-root = no-frame-object
frame-bytes = 0
overflow = MIRCallOverflow()
frame-slots = IdList()
vars = IdList()
block-order = IdList()
gc-roots = Span()
locs = Table'MIRLoc(arena, 16)
types = Table'MIRType(arena, 16)
struct-fields = Table'StructField(arena, 4)
slots = Table'MIRFrameSlot(arena, 8)
frame-objects = Table'MIRFrameObject(arena, 8)
vregs = Table'MIRVirtualRegister(arena, 32)
operands = Table'MIROperand(arena, 128)
group-vregs = IdList()
lifetimes = IdList()
roots = Table'MIRGCRoot(arena, 4)
saved-registers = Table'SavedRegister(arena, 4)
instructions = Table'MIRInstruction(arena, 64)
words = IdList()
names = IdList()
blocks = Table'MIRBlock(arena, 8)
jump-tables = Table'MIRJumpTable(arena, 4)
local-names = Table'LocalName(arena, 4)
has-use-counts = false
use-count-capacity = 0
add-named-types()

────────────────────
+ do add-local-name StringId
    - kind LocalNameKind
    - first StringId
    - second StringId
    - index U32

. row U32 = local-names.length as U32
local-names.append(LocalName(kind, first, second, index))
= pool-size + row

────────────────────
+ get is-gc-free Bool

(compilation-effects /and/ gc-free-effect) != 0

────────────────────
+ operand-roles U32 @inline
    - id InstructionId

roles-with(id, instructions[id].opcode)

────────────────────
+ do roles-with U32 @inline
    - id InstructionId
    - opcode Opcode

` The role of each operand of an instruction whose opcode is read already. Only a call is a call
` instruction, so its kind is read only where its opcode is a call's.
if opcode == .call
    do match? instructions[id]
        | .call-instruction(call)
            do match? types[call.return-type]
                | .void-type
                    = call-roles
            = call-roles /or/ value-call-roles
. roles = opcode-roles[opcode]
if (plain-load || signed-load) && instructions[id].operands.length == 3
    roles = roles /or/ 12
.. plain-load = opcode == .ldr || opcode == .ldrb || opcode == .ldrh
.. signed-load = opcode == .ldrsw || opcode == .ldrsb || opcode == .ldrsh
= roles

────────────────────
+ instruction-def VRegId
    - id InstructionId

def-with(id, instructions[id].opcode)

────────────────────
+ do def-with VRegId
    - id InstructionId
    - opcode Opcode

` The vreg an instruction whose opcode is read already defines first.
. roles = roles-with(id, opcode)
. list = instructions[id].operands
for position in 0 .. < list.length
    if (role-at(roles, position) /and/ def-role) == 0
        continue
    do match? operands[list[position]]
        | .vreg-operand(operand)
            = operand.vreg
= no-id

────────────────────
+ do count-uses

if has-use-counts
    =
use-count-capacity = vreg-count + vreg-count / 2 + 16
use-counts = arena.allocate'U32(use-count-capacity)
has-use-counts = true
for position in 0 .. < block-order.length
    . list = blocks[block-order[position]].instructions
    for index in 0 .. < list.length
        tally-uses(list[index], true)

────────────────────
+ use-count U32 @inline
    - vreg U32

if vreg < use-count-capacity then use-counts[vreg] else 0

────────────────────
+ do forget-use-counts

has-use-counts = false

────────────────────
+ do add-uses
    - id InstructionId

if has-use-counts
    tally-uses(id, true)

────────────────────
+ do drop-uses
    - id InstructionId

if has-use-counts
    tally-uses(id, false)

────────────────────
+ do drop-operand-uses
    - operand OperandId

if has-use-counts
    tally-operand(operand, false)

────────────────────
_ do tally-uses
    - id InstructionId
    - adds Bool

. opcode = instructions[id].opcode
if opcode == .phi
    do match? instructions[id]
        | .phi-instruction(phi)
            for entry in 0 .. < phi.exprs.length
                tally-operand(phi.exprs[entry], adds)
    =
. roles = roles-with(id, opcode)
. list = instructions[id].operands
for position in 0 .. < list.length
    if (role-at(roles, position) /and/ use-role) != 0
        tally-operand(list[position], adds)

────────────────────
_ do tally-operand
    - operand OperandId
    - adds Bool

if operand == no-operand
    =
do match? operands[operand]
    | .vreg-operand(row)
        tally(vregs[row.vreg].id, adds)
    | .vreg-group-operand(group)
        for index in group.vregs.start .. < group.vregs.end
            tally(vregs[group-vregs[index]].id, adds)
    | .load-address-operand(address)
        tally-operand(address.base, adds)
        tally-operand(address.offset, adds)

────────────────────
_ do tally
    - vreg U32
    - adds Bool

if adds
    if vreg >= use-count-capacity
        . grown-capacity = vreg + vreg / 2 + 16
        . grown = arena.allocate'U32(grown-capacity)
        for index in 0 .. < use-count-capacity
            grown[index] = use-counts[index]
        use-counts = grown
        use-count-capacity = grown-capacity
    use-counts[vreg] = use-counts[vreg] + 1
    =
?! Panic("A use of V$vreg is released that was never counted")
    if vreg >= use-count-capacity || use-counts[vreg] == 0
use-counts[vreg] = use-counts[vreg] - 1

────────────────────
+ do post-order IdList

. count U32 = blocks.length as U32
. order = new-id-list(arena, count)
if block-order.length == 0
    = order
. visited = arena.allocate'Byte(count)
. pending = arena.allocate'U32(count)
. cursors = arena.allocate'U32(count)
. root = block-order[0]
. depth U32 = 1
pending[0] = root
visited[root] = 1
while depth != 0
    . block = pending[depth - 1]
    . successors = blocks[block].successors
    . cursor = cursors[depth - 1]
    if cursor < successors.length
        cursors[depth - 1] = cursor + 1
        . successor = successors[cursor]
        if visited[successor] == 0
            visited[successor] = 1
            pending[depth] = successor
            cursors[depth] = 0
            depth += 1
        continue
    order = order.appended(arena, block)
    depth -= 1
= order

────────────────────
_ do add-named-types

types.append(VoidType(0, 0))
types.append(IntType(1, 1, 8, true, .gpr32))
types.append(IntType(2, 2, 16, true, .gpr32))
types.append(IntType(4, 4, 32, true, .gpr32))
types.append(IntType(8, 8, 64, true, .gpr64))
types.append(IntType(1, 1, 8, false, .gpr32))
types.append(IntType(2, 2, 16, false, .gpr32))
types.append(IntType(4, 4, 32, false, .gpr32))
types.append(IntType(8, 8, 64, false, .gpr64))
types.append(FloatType(4, 4, 32, .fpr32))
types.append(FloatType(8, 8, 64, .fpr64))
types.append(PointerType(8, 8, .gpr64))
