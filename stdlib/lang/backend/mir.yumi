+ IdList is Tuple

+ data CPointer'U32
+ length U32
+ capacity U32

────────────────────
+ this[index Index] U32 @inline

data[index]

────────────────────
+ do appended This @inline
    - arena Arena
    - id U32

. grown = this
if length == capacity
    grown = resized(arena, if capacity >= 4 then capacity * 2 else 4)
grown.data[length] = id
= IdList(grown.data, length + 1, grown.capacity)

────────────────────
+ do inserted This
    - arena Arena
    - index U32
    - id U32

. grown = this
if length == capacity
    grown = resized(arena, if capacity >= 4 then capacity * 2 else 4)
. offset = length
while offset > index
    grown.data[offset] = grown.data[offset - 1]
    offset -= 1
grown.data[index] = id
= IdList(grown.data, length + 1, grown.capacity)

────────────────────
+ do resized This
    - arena Arena
    - new-capacity U32

. replacement = arena.allocate'U32(new-capacity)
for offset in 0 .. < length
    replacement[offset] = data[offset]
= IdList(replacement, length, new-capacity)

