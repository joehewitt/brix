+ register-number I32
    - register RegisterId

|? register < 128
    (register % 32) as I32
|? register == stack-pointer-register
    31
??
    -1

━━━━━━━━━━━━━━━━━━━━
+ do role-at U32 @inline
    - roles U32
    - position U32

if (roles /and/ call-roles) != 0
    if position == 1 && (roles /and/ value-call-roles) != 0
        = def-role
    = use-role
if position > 15
    = 0
= (roles /zrshift/ (position * 2)) /and/ 3

━━━━━━━━━━━━━━━━━━━━
+ register-of RegisterId
    - reg-class RegClass
    - number U32

match reg-class
    |= .gpr64
        number
    |= .gpr32
        32 + number
    |= .fpr64
        64 + number
    |= .fpr32
        96 + number

━━━━━━━━━━━━━━━━━━━━
+ register-class RegClass
    - register RegisterId

|? register < 32
    .gpr64
|? register < 64
    .gpr32
|? register < 96
    .fpr64
|? register < 128
    .fpr32
??
    .gpr64

━━━━━━━━━━━━━━━━━━━━
+ register-parent RegisterId
    - register RegisterId

if (register >= 32 && register < 64) || (register >= 96 && register < 128) then parent else register

.. parent = register - 32

━━━━━━━━━━━━━━━━━━━━
+ do register-view RegisterId
    - register RegisterId
    - reg-class RegClass

. current = register-class(register)
if current == reg-class
    = register
if (reg-class == .gpr32 && current == .gpr64) || (reg-class == .fpr32 && current == .fpr64)
    = register + 32
if (reg-class == .gpr64 && current == .gpr32) || (reg-class == .fpr64 && current == .fpr32)
    = register - 32
?! Panic("Register $register has no view of the requested class")

━━━━━━━━━━━━━━━━━━━━
+ is-caller-saved-register Bool
    - register RegisterId

|? register >= 128
    false
|? register < 64
    number <= 15
??
    number <= 7 || number >= 16

.. number = register % 32

━━━━━━━━━━━━━━━━━━━━
+ is-callee-saved-register Bool
    - register RegisterId

|? register >= 128
    false
|? register < 64
    number >= 19 && number <= 28
??
    number >= 8 && number <= 15

.. number = register % 32

━━━━━━━━━━━━━━━━━━━━
+ is-general-register Bool
    - register RegisterId

|? register >= 128
    false
|? register < 64
    number <= 15 || (number >= 19 && number <= 28)
??
    number >= 8

.. number = register % 32

━━━━━━━━━━━━━━━━━━━━
+ RegisterSet is Tuple

+ low U64
+ middle U64
+ high U64

────────────────────
+ has Bool
    - register RegisterId

|? register < 64
    (low /and/ (1u64 /lshift/ register)) != 0
|? register < 128
    (middle /and/ (1u64 /lshift/ (register - 64))) != 0
??
    (high /and/ (1u64 /lshift/ (register - 128))) != 0

────────────────────
+ with This
    - register RegisterId

|? register < 64
    RegisterSet(low /or/ (1u64 /lshift/ register), middle, high)
|? register < 128
    RegisterSet(low, middle /or/ (1u64 /lshift/ (register - 64)), high)
??
    RegisterSet(low, middle, high /or/ (1u64 /lshift/ (register - 128)))

