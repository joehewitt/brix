+ do new-id-list IdList
    - arena Arena
    - capacity U32

if capacity == 0
    = IdList()
= IdList(arena.allocate'U32(capacity), 0, capacity)

━━━━━━━━━━━━━━━━━━━━
+ do sort-u64
    - arena Arena
    - values CPointer'U64
    - count U32

if count < 2
    =
if count <= 16
    for position in 1 .. < count
        . value = values[position]
        . target = position
        while target > 0 && values[target - 1] > value
            values[target] = values[target - 1]
            target -= 1
        values[target] = value
    =
. source = values
. target = arena.allocate'U64(count)
. is-swapped = false
. width U32 = 1
while width < count
    . start U32
    while start < count
        . middle = start + width
        if middle > count
            middle = count
        . end = middle + width
        if end > count
            end = count
        . left = start
        . right = middle
        . write = start
        while left < middle && right < end
            if source[right] < source[left]
                target[write] = source[right]
                right += 1
            else
                target[write] = source[left]
                left += 1
            write += 1
        while left < middle
            target[write] = source[left]
            left += 1
            write += 1
        while right < end
            target[write] = source[right]
            right += 1
            write += 1
        start = end
    . swapped = source
    source = target
    target = swapped
    is-swapped = !is-swapped
    width *= 2
if is-swapped
    for position in 0 .. < count
        values[position] = source[position]

━━━━━━━━━━━━━━━━━━━━
+ do stable-order IdList
    - arena Arena
    - ids IdList
    - keys CPointer'U32

. count = ids.length
if count < 2
    = ids
. composite = arena.allocate'U64(count)
for position in 0 .. < count
    composite[position] = ((keys[position] as U64) /lshift/ 32) /or/ position
sort-u64(arena, composite, count)
. sorted = new-id-list(arena, count)
for position in 0 .. < count
    sorted.data[position] = ids[(composite[position] /and/ 0xffffffff) as U32]
= IdList(sorted.data, count, count)

━━━━━━━━━━━━━━━━━━━━
+ IdMap is Tuple

+ slots CPointer'U32
+ capacity U32
+ count U32

────────────────────
+ do get U32
    - key U32

if capacity == 0
    = no-id
. mask = capacity - 1
. index = id-slot(key, mask)
while true
    . found = slots[index * 2]
    if found == key + 1
        = slots[index * 2 + 1]
    if found == 0
        = no-id
    index = (index + 1) /and/ mask

────────────────────
+ do inserted This
    - arena Arena
    - key U32
    - value U32

. map = this
if (count + 1) * 2 > capacity
    map = resized(arena, if capacity >= 8 then capacity * 2 else 8)
. mask = map.capacity - 1
. index = id-slot(key, mask)
while true
    . found = map.slots[index * 2]
    if found == 0
        map.slots[index * 2] = key + 1
        map.slots[index * 2 + 1] = value
        = IdMap(map.slots, map.capacity, map.count + 1)
    if found == key + 1
        map.slots[index * 2 + 1] = value
        = map
    index = (index + 1) /and/ mask

────────────────────
+ do resized This
    - arena Arena
    - new-capacity U32

. map = IdMap(arena.allocate'U32(new-capacity * 2), new-capacity, 0)
for index in 0 .. < capacity
    . found = slots[index * 2]
    if found != 0
        map = map.inserted(arena, found - 1, slots[index * 2 + 1])
= map

━━━━━━━━━━━━━━━━━━━━
_ id-slot U32 @inline
    - key U32
    - mask U32

(hash /xor/ (hash /zrshift/ 16)) /and/ mask

.. hash = key * 2654435769

━━━━━━━━━━━━━━━━━━━━
+ do new-id-map IdMap
    - arena Arena
    - expected U32

. capacity U32 = 8
while capacity < expected * 2
    capacity *= 2
= IdMap(arena.allocate'U32(capacity * 2), capacity, 0)

