(import ./bundle)
(import ./mir)
(import ./mir-text)
(import ./relocations)
(import /core/arena)
(import /core/table)
(blank)
(prop + no-label U32 (= (. U32 max)))
(prop + no-float-immediate U32 (= (. U32 max)))
(prop _ condition-always U32 (= 14))

(type + TextLabels
  (prop _ bundle Bundle)
  (prop _ function MIRFunction)
  (prop _ blocks IdMap)
  (prop _ symbols IdMap)
  (prop _ arena Arena)
  (fn-do + This _
    (param bundle Bundle)
    (param function MIRFunction)
  )
  (fn-do + reset _
    (param storage Arena)
    (param block-count U32)
    (param symbol-count U32)
    (= arena storage)
    (= blocks (call new-id-map storage block-count))
    (= symbols (call new-id-map storage symbol-count))
  )
  (fn-do + define-block _
    (param name StringId)
    (param offset U32)
    (throw (call Panic (str "Text label for block " (call name-string bundle function name) " is defined twice")) (if (!= (call (. blocks get) name) no-id)))
    (blank)
    (= blocks (call (. blocks inserted) arena name offset))
  )
  (fn-do + define-symbol _
    (param name StringId)
    (param offset U32)
    (throw (call Panic (str "Text label " (call (. bundle text) name) " is defined twice")) (if (!= (call (. symbols get) name) no-id)))
    (blank)
    (= symbols (call (. symbols inserted) arena name offset))
  )
  (fn-expr + block-offset U32
    (param name StringId)
    (call (. blocks get) name)
  )
  (fn-expr + symbol-offset U32
    (param name StringId)
    (call (. symbols get) name)
  )
  (fn-expr + label-offset U32
    (param name StringId)
    (if-expr (!= offset no-label) offset (call (. symbols get) name))
    (where
      (lazy offset (call (. blocks get) name))
    )
  )
)

(type + MoveWideImmediate (is Tuple)
  (prop + is-encodable Bool)
  (prop + is-negated Bool)
  (prop + halfword U32)
  (prop + imm16 U32)
)

(type + LogicalImmediate (is Tuple)
  (prop + is-encodable Bool)
  (prop + n U32)
  (prop + immr U32)
  (prop + imms U32)
)

(type + AArch64Encoder
  (prop + has-relocation Bool)
  (prop + relocation-kind RelocationKind)
  (prop + relocation-symbol StringId)
  (prop + relocation-offset U32)
  (prop _ bundle Bundle)
  (prop _ function MIRFunction)
  (prop _ labels TextLabels)
  (prop _ current-offset U32)
  (fn-do + This _
    (param bundle Bundle)
    (param function MIRFunction)
    (param labels TextLabels)
  )
  (fn-do + encode U32
    (param id InstructionId)
    (param offset U32)
    (let row ([] (. function instructions) id))
    (return (call encode-operation (. row opcode) (. row operands) offset))
  )
  (fn-do + encode-operation U32
    (param opcode Opcode)
    (param operands IdList)
    (param offset U32)
    (= current-offset offset)
    (= has-relocation false)
    (let a (call operand operands 0))
    (let b (call operand operands 1))
    (let c (call operand operands 2))
    (let d (call operand operands 3))
    (return
      (match opcode
        (case= .nop
          0xd503201f
        )
        (case= .ret
          (/or/ 0xd65f0000 (/lshift/ (if-expr (== a no-operand) link-register (call reg a)) 5))
        )
        (case= .br
          (/or/ 0xd61f0000 (/lshift/ (call reg a) 5))
        )
        (case= .blr
          (/or/ 0xd63f0000 (/lshift/ (call reg a) 5))
        )
        (case= .b
          (call jump 0x14000000 .jump26-relocation a offset true)
        )
        (case= .bl
          (call jump 0x94000000 .call26-relocation a offset false)
        )
        (case= .cbz
          (call compare-branch false a (call local-label-offset b) offset)
        )
        (case= .cbnz
          (call compare-branch true a (call local-label-offset b) offset)
        )
        (case= .tbz
          (call test-branch false a b (call local-label-offset c) offset)
        )
        (case= .tbnz
          (call test-branch true a b (call local-label-offset c) offset)
        )
        (case= .b-cond
          (call conditional-branch operands (call local-label-offset a) offset)
        )
        (case= .adr
          (call adr a b offset)
        )
        (case= .adrp
          (call adrp a b)
        )
        (case= .mov
          (call mov a b)
        )
        (case= .movz
          (call move-wide 0x52800000 0xd2800000 a b c)
        )
        (case= .movk
          (call move-wide 0x72800000 0xf2800000 a b c)
        )
        (case= .movn
          (call move-wide 0x12800000 0x92800000 a b c)
        )
        (case= .fmov
          (call fmov a b)
        )
        (case= .neg
          (call neg a b)
        )
        (case= .add
          (call add-sub false a b c d)
        )
        (case= .sub
          (call add-sub true a b c d)
        )
        (case= .mul
          (call three-reg 0x1b007c00 0x9b007c00 a b c)
        )
        (case= .madd
          (call four-reg 0x1b000000 0x9b000000 a b c d)
        )
        (case= .msub
          (call four-reg 0x1b008000 0x9b008000 a b c d)
        )
        (case= .umulh
          (call three-reg 0x9bc07c00 0x9bc07c00 a b c)
        )
        (case= .smulh
          (call three-reg 0x9b407c00 0x9b407c00 a b c)
        )
        (case= .umull
          (call three-reg 0x9ba07c00 0x9ba07c00 a b c)
        )
        (case= .smull
          (call three-reg 0x9b207c00 0x9b207c00 a b c)
        )
        (case= .sdiv
          (call three-reg 0x1ac00c00 0x9ac00c00 a b c)
        )
        (case= .udiv
          (call three-reg 0x1ac00800 0x9ac00800 a b c)
        )
        (case= .and
          (call logical 0x0a000000 0x8a000000 a b c d)
        )
        (case= .orr
          (call logical 0x2a000000 0xaa000000 a b c d)
        )
        (case= .eor
          (call logical 0x4a000000 0xca000000 a b c d)
        )
        (case= .mvn
          (call mvn a b)
        )
        (case= .clz
          (call two-reg 0x5ac01000 0xdac01000 a b)
        )
        (case= .lsl
          (call shift 0 a b c)
        )
        (case= .lsr
          (call shift 1 a b c)
        )
        (case= .asr
          (call shift 2 a b c)
        )
        (case= .lslv
          (call three-reg 0x1ac02000 0x9ac02000 a b c)
        )
        (case= .lsrv
          (call three-reg 0x1ac02400 0x9ac02400 a b c)
        )
        (case= .asrv
          (call three-reg 0x1ac02800 0x9ac02800 a b c)
        )
        (case= .cmp
          (call cmp a b c)
        )
        (case= .ccmp
          (call conditional-compare a b c d)
        )
        (case= .csel
          (call conditional-select 0x1a800000 0x9a800000 a b c d)
        )
        (case= .csinc
          (call conditional-select 0x1a800400 0x9a800400 a b c d)
        )
        (case= .csinv
          (call conditional-select 0x5a800000 0xda800000 a b c d)
        )
        (case= .csneg
          (call conditional-select 0x5a800400 0xda800400 a b c d)
        )
        (case= .fcsel
          (call conditional-select 0x1e200c00 0x1e600c00 a b c d)
        )
        (case= .cset
          (call cset a b)
        )
        (case= .ldr
          (call load-store true a b c 0 false)
        )
        (case= .ldar
          (call load-acquire a b)
        )
        (case= .ldarb
          (call byte-acquire-release 0x08dffc00 a b)
        )
        (case= .stlrb
          (call byte-acquire-release 0x089ffc00 a b)
        )
        (case= .str
          (call load-store false a b c 0 false)
        )
        (case= .ldrb
          (call load-store true a b c 1 false)
        )
        (case= .strb
          (call load-store false a b c 1 false)
        )
        (case= .ldrh
          (call load-store true a b c 2 false)
        )
        (case= .strh
          (call load-store false a b c 2 false)
        )
        (case= .ldrsw
          (call load-store true a b c 4 true)
        )
        (case= .ldrsb
          (call load-store true a b c 1 true)
        )
        (case= .ldrsh
          (call load-store true a b c 2 true)
        )
        (case= .stp
          (call load-store-pair false a b c d)
        )
        (case= .ldp
          (call load-store-pair true a b c d)
        )
        (case= .fneg
          (call two-reg 0x1e214000 0x1e614000 a b)
        )
        (case= .fnegs
          (call two-reg 0x1e214000 0x1e614000 a b)
        )
        (case= .fnegd
          (call two-reg 0x1e214000 0x1e614000 a b)
        )
        (case= .fadd
          (call three-reg 0x1e202800 0x1e602800 a b c)
        )
        (case= .fsub
          (call three-reg 0x1e203800 0x1e603800 a b c)
        )
        (case= .fmul
          (call three-reg 0x1e200800 0x1e600800 a b c)
        )
        (case= .fdiv
          (call three-reg 0x1e201800 0x1e601800 a b c)
        )
        (case= .fabs
          (call two-reg 0x1e20c000 0x1e60c000 a b)
        )
        (case= .fsqrt
          (call two-reg 0x1e21c000 0x1e61c000 a b)
        )
        (case= .fcmps
          (call fcmp a b)
        )
        (case= .fcmpd
          (call fcmp a b)
        )
        (case= .scvtf
          (call int-float-convert 0x1e220000 0x9e220000 a b)
        )
        (case= .ucvtf
          (call int-float-convert 0x1e230000 0x9e230000 a b)
        )
        (case= .fcvtzs
          (call float-int-convert 0x1e380000 0x9e380000 a b)
        )
        (case= .fcvtzu
          (call float-int-convert 0x1e390000 0x9e390000 a b)
        )
        (case= .fcvt
          (call fcvt a b)
        )
        (case= .uxtw
          (call extend a b false 31)
        )
        (case= .sxtw
          (call extend a b true 31)
        )
        (case= .uxth
          (call extend a b false 15)
        )
        (case= .sxth
          (call extend a b true 15)
        )
        (case= .uxtb
          (call extend a b false 7)
        )
        (case= .sxtb
          (call extend a b true 7)
        )
        (case= .ubfx
          (call bitfield 0x53000000 0xd3400000 a b c d false)
        )
        (case= .sbfx
          (call bitfield 0x13000000 0x93400000 a b c d false)
        )
        (case= .bfi
          (call bitfield 0x33000000 0xb3400000 a b c d true)
        )
        (default
          (call unsupported opcode)
        )
      )
    )
  )
  (fn-do + branch-to U32
    (param target-offset U32)
    (param offset U32)
    (= current-offset offset)
    (= has-relocation false)
    (return (call branch 0x14000000 target-offset offset 26))
  )
  (fn-do + conditional-branch-to U32
    (param id InstructionId)
    (param target-offset U32)
    (param offset U32)
    (= current-offset offset)
    (= has-relocation false)
    (let row ([] (. function instructions) id))
    (if (== (. row opcode) .b-cond)
      (return (call conditional-branch (. row operands) target-offset offset))
    )
    (if (or (== (. row opcode) .tbz) (== (. row opcode) .tbnz))
      (return
        (call test-branch
          (block
            (arg (== (. row opcode) .tbnz))
            (arg (call operand (. row operands) 0))
            (arg (call operand (. row operands) 1))
            (arg target-offset)
            (arg offset)
          )
        )
      )
    )
    (return (call compare-branch (== (. row opcode) .cbnz) (call operand (. row operands) 0) target-offset offset))
  )
  (fn-expr + branch-target OperandId
    (param id InstructionId)
    (case? (or (== (. row opcode) .tbz) (== (. row opcode) .tbnz))
      (call operand (. row operands) 2)
    )
    (default
      (call operand (. row operands) (if-expr (== (. row opcode) .b-cond) 0 1))
    )
    (where
      (lazy row ([] (. function instructions) id))
    )
  )
  (fn-do + jump-to U32
    (param target OperandId)
    (param offset U32)
    (= current-offset offset)
    (= has-relocation false)
    (return (call jump 0x14000000 .jump26-relocation target offset true))
  )
  (fn-do _ unsupported U32
    (param opcode Opcode)
    (throw (call Panic (str "Unsupported AArch64 instruction: " ([] opcode-names opcode))))
  )
  (fn-expr _ operand OperandId
    (param operands IdList)
    (param index U32)
    (if-expr (>= index (. operands length)) no-operand ([] operands index))
  )
  (fn-do _ jump U32
    (param base U32)
    (param kind RelocationKind)
    (param target OperandId)
    (param offset U32)
    (param uses-blocks Bool)
    (let name (call symbol-name target))
    (let target-offset no-label)
    (if (and uses-blocks (call is-label target))
      (= target-offset (call (. labels label-offset) name))
      (else
        (= target-offset (call (. labels symbol-offset) name))
      )
    )
    (if (!= target-offset no-label)
      (return (call branch base target-offset offset 26))
    )
    (call emit-relocation kind name)
    (return base)
  )
  (fn-do _ branch U32
    (param base U32)
    (param target-offset U32)
    (param offset U32)
    (param bits U32)
    (let delta (- (as target-offset I32) (as offset I32)))
    (throw (call Panic "Unaligned branch target") (if (!= (% delta 4) 0)))
    (blank)
    (let imm (/rshift/ delta 2))
    (call check-signed-range imm bits "branch")
    (return (/or/ base (/and/ (as imm U32) (- (/lshift/ 1u32 bits) 1))))
  )
  (fn-do _ compare-branch U32
    (param nonzero Bool)
    (param register OperandId)
    (param target-offset U32)
    (param offset U32)
    (let delta (- (as target-offset I32) (as offset I32)))
    (throw (call Panic "Unaligned compare-branch target") (if (!= (% delta 4) 0)))
    (blank)
    (let imm (/rshift/ delta 2))
    (call check-signed-range imm 19 "compare-branch")
    (let base U32 0x34000000)
    (if nonzero
      (= base (if-expr (call is-64 register) 0xb5000000 0x35000000))
      (else-if (call is-64 register)
        (= base 0xb4000000)
      )
    )
    (return (/or/ base (/lshift/ (/and/ (as imm U32) 0x7ffff) 5) (call reg register)))
  )
  (fn-do _ test-branch U32
    (param nonzero Bool)
    (param register OperandId)
    (param bit-operand OperandId)
    (param target-offset U32)
    (param offset U32)
    (let bit (call int bit-operand))
    (throw (call Panic (str "TBZ/TBNZ bit " bit " is out of range")) (if (or (< bit 0) (>= bit (if-expr (call is-64 register) 64 32)))))
    (blank)
    (let delta (- (as target-offset I32) (as offset I32)))
    (throw (call Panic "Unaligned test-branch target") (if (!= (% delta 4) 0)))
    (blank)
    (let imm (/rshift/ delta 2))
    (call check-signed-range imm 14 "test-branch")
    (let base U32 (if-expr nonzero 0x37000000 0x36000000))
    (let bits (as bit U32))
    (return
      (scope (/or/ with-bit (/lshift/ (/and/ (as imm U32) 0x3fff) 5) (call reg register))
        (lazy with-bit (/or/ base (/lshift/ (/zrshift/ bits 5) 31) (/lshift/ (/and/ bits 31) 19)))
      )
    )
  )
  (fn-do _ conditional-branch U32
    (param operands IdList)
    (param target-offset U32)
    (param offset U32)
    (throw (call Panic "B.cond requires a label and condition operand") (if (!= (. operands length) 2)))
    (blank)
    (let condition (call cond ([] operands 1)))
    (let delta (- (as target-offset I32) (as offset I32)))
    (throw (call Panic "Unaligned B.cond target") (if (!= (% delta 4) 0)))
    (blank)
    (let imm (/rshift/ delta 2))
    (call check-signed-range imm 19 "B.cond")
    (let base U32 0x54000000)
    (return (/or/ base (/lshift/ (/and/ (as imm U32) 0x7ffff) 5) condition))
  )
  (fn-do _ adr U32
    (param dest OperandId)
    (param label OperandId)
    (param offset U32)
    (let imm (- (as (call local-label-offset label) I32) (as offset I32)))
    (call check-signed-range imm 21 "ADR")
    (let bits (as imm U32))
    (let low (/and/ bits 3))
    (let high (/and/ (/zrshift/ bits 2) 0x7ffff))
    (let base U32 0x10000000)
    (return (/or/ base (/lshift/ low 29) (/lshift/ high 5) (call reg dest)))
  )
  (fn-do _ adrp U32
    (param dest OperandId)
    (param label OperandId)
    (call emit-relocation .page21-relocation (call symbol-name label))
    (let base U32 0x90000000)
    (return (/or/ base (call reg dest)))
  )
  (fn-do _ mov U32
    (param dest OperandId)
    (param src OperandId)
    (if (call is-int src)
      (return (call mov-immediate dest (call int-value src)))
    )
    (throw (call Panic "MOV moves only general registers") (if (or (call is-float dest) (call is-float src))))
    (blank)
    (if (or (call is-stack-pointer dest) (call is-stack-pointer src))
      (let base U32 (if-expr (call is-64 dest) 0x91000000 0x11000000))
      (return (/or/ base (/lshift/ (call reg src) 5) (call reg dest)))
    )
    (let base U32 (if-expr (call is-64 dest) 0xaa0003e0 0x2a0003e0))
    (return (/or/ base (/lshift/ (call reg src) 16) (call reg dest)))
  )
  (fn-do _ mov-immediate U32
    (param dest OperandId)
    (param value MIRInt)
    (let wide (call is-64 dest))
    (let bits U32 (if-expr wide 64 32))
    (let normalized (if-expr wide (. value bits) (/and/ (. value bits) 0xffffffff)))
    (let move-wide (call encode-move-wide-immediate normalized bits))
    (if (. move-wide is-encodable)
      (let base U32 0x52800000)
      (if (. move-wide is-negated)
        (= base (if-expr wide 0x92800000 0x12800000))
        (else-if wide
          (= base 0xd2800000)
        )
      )
      (return (/or/ base (/lshift/ (. move-wide halfword) 21) (/lshift/ (. move-wide imm16) 5) (call reg dest)))
    )
    (let logical (call encode-logical-immediate normalized bits))
    (throw (call Panic "MOV immediate is out of direct range") (if (not (. logical is-encodable))))
    (blank)
    (let base U32 (if-expr wide 0xb2000000 0x32000000))
    (return
      (scope (/or/ with-immr (/lshift/ (. logical imms) 10) (/lshift/ 31u32 5) (call reg dest))
        (lazy with-immr (/or/ base (/lshift/ (. logical n) 22) (/lshift/ (. logical immr) 16)))
      )
    )
  )
  (fn-do _ move-wide U32
    (param base32 U32)
    (param base64 U32)
    (param dest OperandId)
    (param imm OperandId)
    (param shift-operand OperandId)
    (let value (call int imm))
    (throw (call Panic (str "Move-wide immediate must fit in 16 bits: " value)) (if (or (< value 0) (> value 0xffff))))
    (blank)
    (let shift I64)
    (if (!= shift-operand no-operand)
      (= shift (call int shift-operand))
    )
    (throw (call Panic (str "Move-wide shift must be a multiple of 16: " shift)) (if (!= (% shift 16) 0)))
    (blank)
    (let halfword (/ shift 16))
    (throw (call Panic (str "Move-wide shift is out of range: " shift)) (if (or (< halfword 0) (> halfword (if-expr (call is-64 dest) 3 1)))))
    (blank)
    (let base (if-expr (call is-64 dest) base64 base32))
    (return (/or/ base (/lshift/ (as halfword U32) 21) (/lshift/ (as value U32) 5) (call reg dest)))
  )
  (fn-do _ fmov U32
    (param dest OperandId)
    (param src OperandId)
    (if (call is-int src)
      (let immediate (call float-immediate (. (call int-value src) bits) (call is-64 dest)))
      (throw (call Panic (str "FMOV has no immediate for the float " (. (call int-value src) bits))) (if (or (== immediate no-float-immediate) (not (call is-float dest)))))
      (return (/or/ (if-expr (call is-64 dest) 0x1e601000 0x1e201000) (/lshift/ immediate 13) (call reg dest)))
    )
    (let dest-float (call is-float dest))
    (let src-float (call is-float src))
    (let base U32)
    (if (and dest-float src-float)
      (= base (if-expr (call is-64 dest) 0x1e604000 0x1e204000))
      (else-if src-float
        (= base (if-expr (call is-64 dest) 0x9e660000 0x1e260000))
      )
      (else-if dest-float
        (= base (if-expr (call is-64 dest) 0x9e670000 0x1e270000))
      )
      (else
        (throw (call Panic "FMOV requires at least one floating-point register"))
      )
    )
    (return (/or/ base (/lshift/ (call reg src) 5) (call reg dest)))
  )
  (fn-expr _ neg U32
    (param dest OperandId)
    (param src OperandId)
    (/or/ base (/lshift/ (call reg src) 16) (call reg dest))
    (where
      (lazy base U32 (if-expr (call is-64 dest) 0xcb0003e0 0x4b0003e0))
    )
  )
  (fn-do _ add-sub U32
    (param is-sub Bool)
    (param dest OperandId)
    (param lhs OperandId)
    (param rhs OperandId)
    (param shift-operand OperandId)
    (let label (call page-offset-label rhs))
    (if (!= label no-string)
      (call emit-relocation .add-pageoff12-relocation label)
      (let base U32 (if-expr (call is-64 dest) 0x91000000 0x11000000))
      (return (/or/ base (/lshift/ (call reg lhs) 5) (call reg dest)))
    )
    (let wide (call is-64 dest))
    (if (call is-int rhs)
      (let base U32 0x11000000)
      (if is-sub
        (= base (if-expr wide 0xd1000000 0x51000000))
        (else-if wide
          (= base 0x91000000)
        )
      )
      (return (/or/ base (call add-sub-immediate (call int rhs)) (/lshift/ (call reg lhs) 5) (call reg dest)))
    )
    (let base U32 0x0b000000)
    (if is-sub
      (= base (if-expr wide 0xcb000000 0x4b000000))
      (else-if wide
        (= base 0x8b000000)
      )
    )
    (return
      (scope (/or/ base shift-field (/lshift/ (call reg rhs) 16) (/lshift/ (call reg lhs) 5) (call reg dest))
        (lazy shift-field (call shift-bits shift-operand dest false))
      )
    )
  )
  (fn-do _ add-sub-immediate U32
    (param imm I64)
    (if (and (>= imm 0) (<= imm 4095))
      (return (/lshift/ (as imm U32) 10))
    )
    (if (and (>= imm 0) (== (% imm 4096) 0) (<= (/ imm 4096) 4095))
