    (where
      (lazy register (call register-of id))
      (lazy reg-class (call register-class register))
    )
  )
  (fn-expr _ is-float Bool
    (param id OperandId)
    (and (!= register no-register) (or (== reg-class .fpr32) (== reg-class .fpr64)))
    (where
      (lazy register (call register-of id))
      (lazy reg-class (call register-class register))
    )
  )
  (fn-expr _ is-stack-pointer Bool
    (param id OperandId)
    (== (call register-of id) stack-pointer-register)
  )
  (fn-do _ cond U32
    (param id OperandId)
    (if (!= id no-operand)
      (match? ([] (. function operands) id)
        (case (call .cond-operand operand)
          (return (. operand code))
        )
      )
    )
    (throw (call Panic "Expected condition operand"))
  )
  (fn-do _ check-signed-range _
    (param value I64)
    (param bits U32)
    (param context String)
    (let limit I64 1)
    (= limit (/lshift/ limit (- bits 1)))
    (throw (call Panic (str context " is out of range: " value)) (if (or (< value (- 0 limit)) (> value (- limit 1)))))
  )
  (fn-do _ emit-relocation _
    (param kind RelocationKind)
    (param symbol StringId)
    (= has-relocation true)
    (= relocation-kind kind)
    (= relocation-symbol symbol)
    (= relocation-offset current-offset)
  )
)

(fn-do + encode-move-wide-immediate MoveWideImmediate
  (param value U64)
  (param bits U32)
  (let halfword-count (/ bits 16))
  (let chunk U64 0xffff)
  (for (in halfword (..< 0 halfword-count))
    (let shift (* halfword 16))
    (let mask (/lshift/ chunk shift))
    (if (== (/and/ value (/xor/ mask (. U64 max))) 0)
      (return (call MoveWideImmediate true false halfword (as (/and/ (/zrshift/ value shift) 0xffff) U32)))
    )
  )
  (let inverted (/and/ (/xor/ value (. U64 max)) (call bit-mask bits)))
  (for (in halfword (..< 0 halfword-count))
    (let shift (* halfword 16))
    (let mask (/lshift/ chunk shift))
    (if (== (/and/ inverted (/xor/ mask (. U64 max))) 0)
      (return (call MoveWideImmediate true true halfword (as (/and/ (/zrshift/ inverted shift) 0xffff) U32)))
    )
  )
  (return (call MoveWideImmediate))
)

(fn-expr + float-immediate U32
  (param bits U64)
  (param is-double Bool)
  ; The eight bits FMOV takes for a float, or none when the float has no such form: a sign, an
  ; exponent of three bits that is not all of the exponent's, and the top four bits of a fraction.
  (case? (!= (/and/ bits (- (/lshift/ 1u64 fraction-bits) 1)) 0)
    no-float-immediate
  )
  (case? (and (not is-double) (!= (/zrshift/ bits 32) 0))
    no-float-immediate
  )
  (case? (!= repeated (if-expr (!= b 0) (- (/lshift/ 1u64 exponent-bits) 1) 0))
    no-float-immediate
  )
  (case? (== (/and/ (/zrshift/ bits (- top 1)) 1) b)
    no-float-immediate
  )
  (default
    (as (/or/ (/lshift/ sign 7) (/lshift/ b 6) low) U32)
  )
  (where
    (lazy fraction-bits U64 (if-expr is-double 48 19))
    (lazy exponent-bits U64 (if-expr is-double 8 5))
    (lazy top (if-expr is-double 63u64 31u64))
    (lazy low (/and/ (/zrshift/ bits fraction-bits) 0x3f))
    (lazy repeated (/and/ (/zrshift/ bits (+ fraction-bits 6)) (- (/lshift/ 1u64 exponent-bits) 1)))
    (lazy b (/and/ repeated 1))
    (lazy sign (/and/ (/zrshift/ bits top) 1))
  )
)

(fn-do + encode-logical-immediate LogicalImmediate
  (param value U64)
  (param bits U32)
  (let full-mask (call bit-mask bits))
  (let normalized (/and/ value full-mask))
  (if (or (== normalized 0) (== normalized full-mask))
    (return (call LogicalImmediate))
  )
  (let size U32 2)
  (while (<= size bits)
    (let pattern (/and/ normalized (call bit-mask size)))
    (if (== (call replicate pattern size bits) normalized)
      (for (in ones-length (..< 1 size))
        (let ones (call bit-mask ones-length))
        (for (in immr (..< 0 size))
          (if (== (call rotate-right ones immr size) pattern)
            (let n U32 (if-expr (and (== bits 64) (== size 64)) 1 0))
            (let imms
              (scope (/and/ (/or/ size-prefix (as (- ones-length 1) U32)) 0x3f)
                (lazy size-prefix (/lshift/ (/xor/ (- size 1) (. U32 max)) 1))
              )
            )
            (return (call LogicalImmediate true n immr imms))
          )
        )
      )
    )
    (*= size 2)
  )
  (return (call LogicalImmediate))
)

(fn-expr _ bit-mask U64
  (param bits U32)
  (if-expr (>= bits 64) (. U64 max) (- (/lshift/ 1u64 bits) 1))
)

(fn-do _ replicate U64
  (param pattern U64)
  (param size U32)
  (param bits U32)
  (let value U64)
  (let offset U32)
  (while (< offset bits)
    (= value (/or/ value (/lshift/ pattern offset)))
    (+= offset size)
  )
  (return value)
)

(fn-expr _ rotate-right U64
  (param value U64)
  (param shift U32)
  (param bits U32)
  (if-expr (== amount 0) (/and/ value mask) (/and/ (/or/ (/zrshift/ value amount) wrapped) mask))
  (where
    (lazy mask (call bit-mask bits))
    (lazy amount (% shift bits))
    (lazy wrapped (/lshift/ value (- bits amount)))
  )
)
