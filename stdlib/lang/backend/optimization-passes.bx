          )
          (call set-slot 0 encoded-tag encoded-value)
          (if (== (. address offset) no-operand)
            (call set-slot 1 2 0)
            (else
              (if (not (call encode (. address offset)))
                (return false)
              )
              (call set-slot 1 encoded-tag encoded-value)
            )
          )
          (= key-head (/or/ key-head (/lshift/ (as (. address index-shift) U64) 24)))
          (= slot 2)
          (continue)
        )
      )
      (if (or (> slot 2) (not (call encode operand)))
        (return false)
      )
      (call set-slot slot encoded-tag encoded-value)
      (+= slot 1)
    )
    (let derives (call derives-pointer operands))
    (if (and derives (call reads-flags opcode))
      (return false)
    )
    (if (or (call is-load-opcode opcode) derives)
      (= key-head (/or/ key-head (/lshift/ (as generation U64) 32)))
    )
    (if (call reads-flags opcode)
      (if (== flags 0)
        (return false)
      )
      (= key-head (/or/ key-head (/lshift/ (as flags U64) 32)))
    )
    (return true)
  )
  (fn-do _ derives-pointer Bool
    (param operands IdList)
    ; Whether an instruction makes a value the collector does not see from a register it does, such
    ; as the address of an item of an array. The collector keeps what that pointer holds only while
    ; the pointer is live, so the value is not shared across a call.
    (let dest-row (call vreg-row function ([] operands 0)))
    (if (or (== dest-row no-id) (. ([] (. function vregs) dest-row) gc-root))
      (return false)
    )
    (for (in position (..< 1 (. operands length)))
      (let row (call vreg-row function ([] operands position)))
      (if (and (!= row no-id) (. ([] (. function vregs) row) gc-root))
        (return true)
      )
    )
    (return false)
  )
  (fn-do _ set-slot _
    (param slot U32)
    (param tag U64)
    (param value U64)
    (= key-head (/or/ key-head (/lshift/ tag (+ 12 (* slot 4)))))
