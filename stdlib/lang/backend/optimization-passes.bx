  (fn-expr _ is-arm Bool
    (param block BlockId)
    (param head BlockId)
    (and (== (. predecessors length) 1) (== ([] predecessors 0) head) (!= block head))
    (where
      (lazy predecessors (. ([] (. function blocks) block) predecessors))
    )
  )
  (fn-do _ place-replacements _
    (param block BlockId)
    (let instructions (. ([] (. function blocks) block) instructions))
    (let kept (call new-id-list arena (+ (. instructions length) 1)))
    (let placed false)
    (for (in index (..< 0 (. instructions length)))
      (let id ([] instructions index))
      (let opcode (. ([] (. function instructions) id) opcode))
      (if (and (not placed) (!= opcode .phi) (!= opcode .comment))
        (for (in entry (..< 0 (. replacing-moves length)))
          (= kept (call (. kept appended) arena ([] replacing-moves entry)))
        )
        (= placed true)
      )
      (let is-replaced false)
      (for (in entry (..< 0 (. replaced-phis length)))
        (if (== ([] replaced-phis entry) id)
          (= is-replaced true)
        )
      )
      (if (not is-replaced)
        (= kept (call (. kept appended) arena id))
      )
    )
    (if (not placed)
      (for (in entry (..< 0 (. replacing-moves length)))
        (= kept (call (. kept appended) arena ([] replacing-moves entry)))
      )
    )
    (= (. ([] (. function blocks) block) instructions) kept)
  )
  (fn-do _ settle-branch _
    (param block BlockId)
    (let instructions (. ([] (. function blocks) block) instructions))
    (let last-index (call previous-real function instructions (. instructions length)))
    (if (== last-index no-id)
      (return)
    )
    (let last ([] instructions last-index))
    (if (or (!= (. ([] (. function instructions) last) opcode) .b) (!= (. ([] (. function instructions) last) operands length) 1))
      (return)
    )
    (let fallen (call (. builder get-block) (call label-name function (call first-operand function last))))
    (if (== fallen no-id)
      (return)
    )
    (let test-index (call previous-real function instructions last-index))
    (let test (if-expr (== test-index no-id) no-id ([] instructions test-index)))
    (let test-opcode (if-expr (== test no-id) (. Opcode nop) (. ([] (. function instructions) test) opcode)))
    (if (and (!= test-opcode .cbz) (!= test-opcode .cbnz) (!= test-opcode .b-cond))
      (call record-implied block fallen)
      (return)
    )
    (let taken (call (. builder get-block) (call label-name function (call conditional-branch-target function test))))
    (if (== taken no-id)
      (return)
    )
    (let leading (call IdList (. instructions data) test-index (. instructions capacity)))
    (if (or (call names-block function leading (. ([] (. function blocks) taken) name)) names-fallen)
      (return)
    )
    (lazy names-fallen (call names-block function leading (. ([] (. function blocks) fallen) name)))
    (if (== taken fallen)
      (call fold block test-index taken no-id)
      (return)
    )
    (let key U32)
    (let is-negated false)
    (let operands (. ([] (. function instructions) test) operands))
    (if (== test-opcode .b-cond)
      (if (< (. operands length) 2)
        (return)
      )
      (match? ([] (. function operands) ([] operands 1))
        (case (call .cond-operand cond)
          (= key (call condition-number (. cond code)))
          (= is-negated (!= (/and/ (. cond code) 1) 0))
        )
      )
      (else
        (let tested (call vreg-id function ([] operands 0)))
        (if (or (== tested no-id) (>= tested vreg-limit) (> ([] definitions tested) 1))
          (return)
        )
        (let number (call number-of-vreg tested))
        (= key (if-expr (!= ([] truths number) 0) ([] truths number) number))
        (= is-negated (if-expr (!= ([] truths number) 0) (!= ([] negated number) 0) false))
        (if (== test-opcode .cbz)
          (= is-negated (not is-negated))
        )
      )
    )
    (if (== key 0)
      (return)
    )
    (if (!= ([] facts key) 0)
      (let takes (!= (== ([] facts key) 1) is-negated))
      (call fold block test-index (if-expr takes taken fallen) (if-expr takes fallen taken))
      (return)
    )
    (= ([] branch-keys block) key)
    (= ([] branch-negated block) (if-expr is-negated 1 0))
    (= ([] branch-taken block) taken)
    (= ([] branch-fallen block) fallen)
