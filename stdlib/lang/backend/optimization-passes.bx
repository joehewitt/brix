  (fn-do _ compare-number U32
    (param id InstructionId)
    (param opcode Opcode)
    (let operands (. ([] (. function instructions) id) operands))
    (if (or (!= (. operands length) 2) (not (call encode ([] operands 0))))
      (return 0)
    )
    (= key-head (/or/ (as opcode U64) (/lshift/ encoded-tag 12)))
    (= key-first encoded-value)
    (= key-second 0)
    (= key-third 0)
    (if (not (call encode ([] operands 1)))
      (return 0)
    )
    (= key-head (/or/ key-head (/lshift/ encoded-tag 16)))
    (= key-second encoded-value)
