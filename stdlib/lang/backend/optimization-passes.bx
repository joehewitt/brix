    (if (or (== flags 0) (>= code 14))
      (return 0)
    )
    (= key-head (/or/ (as (. Opcode cset) U64) (/lshift/ (as 8 U64) 12) (/lshift/ (as flags U64) 32)))
    (= key-first (as (/and/ code 0xfffffffe) U64))
    (= key-second 0)
    (= key-third 0)
    (return (call synthetic-number))
  )
  (fn-do _ number-def _
    (param block BlockId)
    (param id InstructionId)
    (param opcode Opcode)
    (param dest OperandId)
    (param vreg U32)
    (let own (+ vreg 1))
    (let row (call vreg-row function dest))
    (let class (. ([] (. function vregs) row) reg-class))
    (let operands (. ([] (. function instructions) id) operands))
    (if (and (or is-move zero-extends) (== (. operands length) 2) (call copies dest ([] operands 1) opcode))
      (= ([] numbers vreg) (call number-of-operand ([] operands 1)))
      (return)
    )
    (lazy is-move (or (== opcode .mov) (== opcode .fmov)))
    (lazy zero-extends (or (== opcode .uxtb) (== opcode .uxth) (== opcode .uxtw)))
    (if (not (call build-key id opcode class))
      (= ([] numbers vreg) own)
      (if (== opcode .cset)
        (= ([] booleans own) 1)
      )
      (return)
    )
    (let slot (call find-slot))
    (if (== ([] slot-numbers slot) 0)
      (call fill-slot slot own dest block)
      (= ([] numbers vreg) own)
      (call note-truth own opcode operands)
      (return)
    )
    (let number ([] slot-numbers slot))
    (= ([] numbers vreg) number)
    (let leader ([] slot-leaders slot))
    (if (and (!= leader no-operand) (== ([] truths number) 0) replaceable)
      (call rewrite-assembly function id (call (. builder copy-opcode) dest) (call pair arena dest leader))
      (= changed true)
      (return)
    )
    (lazy replaceable (and (call is-replaceable opcode dest leader) (call dominates ([] slot-blocks slot) block)))
    (= ([] slot-leaders slot) dest)
    (= ([] slot-blocks slot) block)
