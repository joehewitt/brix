  (fn-do _ phi-input U64
    (param operand OperandId)
    ; The key of a phi's input: its number and class, or its constant, with a tag above both.
    (let vreg (call vreg-id function operand))
    (if (and (!= vreg no-id) (< vreg vreg-limit) (!= ([] definitions vreg) 0) (== ([] visited-defs vreg) 0))
      (return 0)
    )
    (if (or (not (call encode operand)) (and (!= encoded-tag 1) (!= (/zrshift/ encoded-value 56) 0)))
      (return 0)
    )
    (return (/or/ (/lshift/ encoded-tag 60) encoded-value))
  )
  (fn-do _ diamond-key Bool
    (param block BlockId)
    (param phi PhiInstruction)
    (param class U64)
    ; Keys a phi at the join of a diamond, or of a triangle, by its branch's condition and the value
    ; each side gives.
    (let predecessors (. ([] (. function blocks) block) predecessors))
    (if (or (!= (. phi exprs length) 2) (!= (. predecessors length) 2))
      (return false)
    )
    (let head ([] doms block))
    (if (== head no-id)
      (return false)
    )
    (let key ([] branch-keys head))
    (if (== key 0)
      (return false)
    )
    (let taken ([] branch-taken head))
    (let fallen ([] branch-fallen head))
    (let taken-value U64)
    (let fallen-value U64)
    (for (in entry (..< 0 2))
      (let source (call (. builder get-block) ([] (. phi blocks) entry)))
      (if (== source no-id)
        (return false)
      )
      (let value (call phi-input ([] (. phi exprs) entry)))
      (if (== value 0)
        (return false)
      )
      (if (== source head)
        (if (== block taken)
          (= taken-value value)
          (else-if (== block fallen)
            (= fallen-value value)
          )
          (else
            (return false)
          )
        )
        (else-if (and (call is-arm taken head) (call dominates taken source))
          (= taken-value value)
        )
        (else-if (and (call is-arm fallen head) (call dominates fallen source))
          (= fallen-value value)
        )
        (else
          (return false)
        )
      )
    )
    (if (or (== taken-value 0) (== fallen-value 0))
      (return false)
    )
    (let holding (if-expr (!= ([] branch-negated head) 0) fallen-value taken-value))
    (let failing (if-expr (!= ([] branch-negated head) 0) taken-value fallen-value))
    (= key-head (/or/ (as (. Opcode phi) U64) (/lshift/ class 8) (/lshift/ (as 7 U64) 12)))
    (= key-first (as key U64))
    (= key-second holding)
    (= key-third failing)
