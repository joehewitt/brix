  (fn-do _ fold _
    (param block BlockId)
    (param test-index U32)
    (param kept-target BlockId)
    (param dropped BlockId)
    ; Removes a branch's test so that the block only jumps to `kept-target`, the edge to `dropped`
    ; going with it.
    (call retarget block test-index kept-target)
    (if (and (!= dropped no-id) (!= dropped kept-target))
      (call drop-edge block dropped)
    )
    (call keep-one-edge block kept-target)
    (= changed true)
  )
  (fn-do _ retarget _
    (param block BlockId)
    (param test-index U32)
    (param target BlockId)
    (let instructions (. ([] (. function blocks) block) instructions))
    (let rebuilt (call new-id-list arena (. instructions length)))
    (for (in index (..< 0 (. instructions length)))
      (if (!= index test-index)
        (= rebuilt (call (. rebuilt appended) arena ([] instructions index)))
      )
    )
    (let last-index (call previous-real function rebuilt (. rebuilt length)))
    (call rewrite-assembly
      (block
        (arg function)
        (arg ([] rebuilt last-index))
        (arg .b)
        (arg (call (. (call IdList) appended) arena (call (. builder label) (. ([] (. function blocks) target) name))))
      )
    )
    (= (. ([] (. function blocks) block) instructions) rebuilt)
  )
  (fn-do _ drop-edge _
    (param block BlockId)
    (param target BlockId)
    (let successors (. ([] (. function blocks) block) successors))
    (let kept (call IdList))
    (for (in index (..< 0 (. successors length)))
      (if (!= ([] successors index) target)
        (= kept (call (. kept appended) arena ([] successors index)))
      )
    )
    (= (. ([] (. function blocks) block) successors) kept)
    (let predecessors (. ([] (. function blocks) target) predecessors))
    (let remaining (call IdList))
    (for (in index (..< 0 (. predecessors length)))
      (if (!= ([] predecessors index) block)
        (= remaining (call (. remaining appended) arena ([] predecessors index)))
      )
    )
    (= (. ([] (. function blocks) target) predecessors) remaining)
    (call drop-phi-inputs target (. ([] (. function blocks) block) name))
  )
  (fn-do _ keep-one-edge _
    (param block BlockId)
    (param target BlockId)
    (let successors (. ([] (. function blocks) block) successors))
    (let kept (call IdList))
    (let seen false)
    (for (in index (..< 0 (. successors length)))
      (if (== ([] successors index) target)
        (if seen
          (continue)
        )
        (= seen true)
      )
      (= kept (call (. kept appended) arena ([] successors index)))
    )
    (if (not seen)
      (= kept (call (. kept appended) arena target))
    )
    (= (. ([] (. function blocks) block) successors) kept)
    (let predecessors (. ([] (. function blocks) target) predecessors))
    (let listed (call IdList))
    (let found false)
    (for (in index (..< 0 (. predecessors length)))
      (if (== ([] predecessors index) block)
        (if found
          (continue)
        )
        (= found true)
      )
      (= listed (call (. listed appended) arena ([] predecessors index)))
    )
    (if (not found)
      (= listed (call (. listed appended) arena block))
    )
    (= (. ([] (. function blocks) target) predecessors) listed)
  )
  (fn-do _ drop-phi-inputs _
    (param block BlockId)
    (param source StringId)
    (let instructions (. ([] (. function blocks) block) instructions))
    (for (in index (..< 0 (. instructions length)))
      (match? ([] (. function instructions) ([] instructions index))
        (case (call .phi-instruction phi)
          (let kept U32)
          (for (in entry (..< 0 (. phi blocks length)))
            (if (!= ([] (. phi blocks) entry) source)
              (= ([] (. phi exprs data) kept) ([] (. phi exprs) entry))
              (= ([] (. phi blocks data) kept) ([] (. phi blocks) entry))
              (+= kept 1)
            )
          )
          (= (. phi exprs) (call IdList (. phi exprs data) kept (. phi exprs capacity)))
          (= (. phi blocks) (call IdList (. phi blocks data) kept (. phi blocks capacity)))
        )
      )
    )
  )
  (fn-do _ collapse-empty-branches Bool
    ; Turns a branch whose sides are empty, and give the block they join the same values, into a jump
    ; to that block.
    (let any false)
    (let order (. function block-order))
    (for (in position (..< 0 (. order length)))
      (let block ([] order position))
      (let instructions (. ([] (. function blocks) block) instructions))
      (let last-index (call previous-real function instructions (. instructions length)))
      (if (== last-index no-id)
        (continue)
      )
      (let last ([] instructions last-index))
      (if (!= (. ([] (. function instructions) last) opcode) .b)
        (continue)
      )
      (let test-index (call previous-real function instructions last-index))
      (if (== test-index no-id)
        (continue)
      )
      (let test ([] instructions test-index))
      (let test-opcode (. ([] (. function instructions) test) opcode))
      (if (and (!= test-opcode .cbz) (!= test-opcode .cbnz) (!= test-opcode .b-cond))
        (continue)
      )
      (let taken (call (. builder get-block) (call label-name function (call conditional-branch-target function test))))
      (let fallen (call (. builder get-block) (call label-name function (call first-operand function last))))
      (if (or (== taken no-id) (== fallen no-id))
        (continue)
      )
      (let leading (call IdList (. instructions data) test-index (. instructions capacity)))
      (if (or (call names-block function leading (. ([] (. function blocks) taken) name)) names-fallen)
        (continue)
      )
      (lazy names-fallen (call names-block function leading (. ([] (. function blocks) fallen) name)))
      (let join (call forwarded taken block))
      (if (or (!= join (call forwarded fallen block)) (== join block))
        (continue)
      )
      (let taken-source (if-expr (!= taken join) taken block))
      (let fallen-source (if-expr (!= fallen join) fallen block))
      (if (not (call gives-same join (. ([] (. function blocks) taken-source) name) (. ([] (. function blocks) fallen-source) name)))
        (continue)
      )
      (call merge-sources join block taken-source fallen-source)
      (call retarget block test-index join)
      (let successors (. ([] (. function blocks) block) successors))
      (let kept (call IdList))
      (for (in index (..< 0 (. successors length)))
        (if (and (!= ([] successors index) taken) (!= ([] successors index) fallen) (!= ([] successors index) join))
          (= kept (call (. kept appended) arena ([] successors index)))
        )
      )
      (= (. ([] (. function blocks) block) successors) (call (. kept appended) arena join))
      (= any true)
    )
    (return any)
  )
  (fn-expr _ forwarded BlockId
    (param target BlockId)
    (param block BlockId)
    ; Where an empty block that only `block` reaches jumps to, or `target` itself.
    (case? (== target block)
      target
    )
    (case? (or (!= (. predecessors length) 1) (!= ([] predecessors 0) block))
      target
    )
    (case? (or (== last-index no-id) (!= (call previous-real function instructions last-index) no-id))
      target
    )
    (case? (!= (. ([] (. function instructions) last) opcode) .b)
      target
    )
    (case? (== next no-id)
      target
    )
    (default
      next
    )
    (where
      (lazy predecessors (. ([] (. function blocks) target) predecessors))
      (lazy instructions (. ([] (. function blocks) target) instructions))
      (lazy last-index (call previous-real function instructions (. instructions length)))
      (lazy last ([] instructions last-index))
      (lazy next (call (. builder get-block) (call label-name function (call first-operand function last))))
    )
  )
  (fn-do _ gives-same Bool
    (param join BlockId)
    (param first StringId)
    (param second StringId)
    (let instructions (. ([] (. function blocks) join) instructions))
    (for (in index (..< 0 (. instructions length)))
      (match? ([] (. function instructions) ([] instructions index))
        (case (call .phi-instruction phi)
          (let left no-operand)
          (let right no-operand)
          (for (in entry (..< 0 (. phi blocks length)))
            (if (== ([] (. phi blocks) entry) first)
              (= left ([] (. phi exprs) entry))
            )
            (if (== ([] (. phi blocks) entry) second)
              (= right ([] (. phi exprs) entry))
            )
          )
          (if (or (== left no-operand) (== right no-operand) different)
            (return false)
          )
          (lazy different (and (!= left right) (not (call same-operand function left right))))
        )
      )
    )
    (return true)
  )
  (fn-do _ merge-sources _
    (param join BlockId)
    (param block BlockId)
    (param taken-source BlockId)
    (param fallen-source BlockId)
    ; Makes `block` the one predecessor of `join` in place of the sides it is about to skip.
    (let name (. ([] (. function blocks) block) name))
    (let taken-name (. ([] (. function blocks) taken-source) name))
    (let fallen-name (. ([] (. function blocks) fallen-source) name))
    (let instructions (. ([] (. function blocks) join) instructions))
    (for (in index (..< 0 (. instructions length)))
      (match? ([] (. function instructions) ([] instructions index))
        (case (call .phi-instruction phi)
          (let value no-operand)
          (let kept U32)
          (for (in entry (..< 0 (. phi blocks length)))
            (let source ([] (. phi blocks) entry))
            (if (or (== source taken-name) (== source fallen-name) (== source name))
              (= value ([] (. phi exprs) entry))
              (continue)
            )
            (= ([] (. phi exprs data) kept) ([] (. phi exprs) entry))
            (= ([] (. phi blocks data) kept) source)
            (+= kept 1)
          )
          (= (. phi exprs) (call (. (call IdList (. phi exprs data) kept (. phi exprs capacity)) appended) arena value))
          (= (. phi blocks) (call (. (call IdList (. phi blocks data) kept (. phi blocks capacity)) appended) arena name))
        )
      )
    )
    (let predecessors (. ([] (. function blocks) join) predecessors))
    (let listed (call IdList))
    (for (in index (..< 0 (. predecessors length)))
      (let predecessor ([] predecessors index))
      (if (and (!= predecessor taken-source) (!= predecessor fallen-source) (!= predecessor block))
        (= listed (call (. listed appended) arena predecessor))
      )
    )
    (= (. ([] (. function blocks) join) predecessors) (call (. listed appended) arena block))
  )
)

(fn-do _ names-block Bool
  (param function MIRFunction)
  (param instructions IdList)
  (param name StringId)
  (for (in index (..< 0 (. instructions length)))
    (let id ([] instructions index))
    (let operands (. ([] (. function instructions) id) operands))
    (for (in entry (..< 0 (. operands length)))
      (if (== (call label-name function ([] operands entry)) name)
        (return true)
      )
    )
    (match? ([] (. function instructions) id)
      (case (call .call-instruction call)
        (if (== (call label-name function (. call panic-target)) name)
          (return true)
        )
      )
    )
  )
  (return false)
)

(fn-expr _ keeps-memory Bool
  (param opcode Opcode)
  ; Whether an instruction leaves memory as it was, and orders nothing around it.
  (case? (or (call is-pure-def opcode) (call is-flag-compare opcode) (call is-branch-opcode opcode) is-load)
    true
  )
  (default
    (or (== opcode .ldp) (== opcode .movk) (== opcode .fmov) (== opcode .adr) (== opcode .adrp) (== opcode .addptr) (== opcode .phi) (== opcode .comment) (== opcode .nop) (== opcode .inlined-name) (== opcode .br) (== opcode .ret) (== opcode .ccmp) (== opcode .bfi))
  )
  (where
    (lazy is-load (call is-load-opcode opcode))
  )
)

(fn-expr _ is-load-opcode Bool @inline
  (param opcode Opcode)
  (or plain-load (== opcode .ldrsw) (== opcode .ldrsb) (== opcode .ldrsh))
  (where
    (lazy plain-load (or (== opcode .ldr) (== opcode .ldrb) (== opcode .ldrh)))
  )
)

(type + MIRIfConversionPass
  ; Turns each small diamond or triangle that a conditional branch opens and a phi closes into
  ; straight code, while the function is still in SSA form. The blocks on either side may hold only
  ; a couple of pure instructions, which then run on both paths, and each phi whose inputs differ
  ; becomes a CSEL or FCSEL on the branch's condition. A side that only compares and sets a flag,
  ; against a constant the other path gives, becomes CCMP, so that `a && b` and `a || b` are one
  ; comparison chained to another. A block whose only predecessor jumps to it, as a join left with
  ; one predecessor does, is merged into that predecessor.
  (blank)
  (prop _ builder MIRBuilder)
  (prop _ function MIRFunction)
  (prop _ definitions (of CPointer U32))
  (prop _ definers (of CPointer U32))
  (prop _ dead (of CPointer Byte))
  (prop _ phis IdList)
  (prop _ taken-values IdList)
  (prop _ fallen-values IdList)
  (prop _ resolved IdList)
  (prop _ vreg-limit U32)
  (fn-do + This _
    (param builder MIRBuilder)
    (lazy function (. builder function))
  )
  (fn-do + run Bool
    (let changed false)
    (for (in _ (..< 0 4))
      (let arena (. function arena))
      (= vreg-limit (. function vreg-count))
      (= definitions (call (of (. arena allocate) U32) vreg-limit))
      (= definers (call (of (. arena allocate) U32) vreg-limit))
      (= dead (call (of (. arena allocate) Byte) (. function blocks length)))
      (let order (. function block-order))
      (for (in position (..< 0 (. order length)))
        (let instructions (. ([] (. function blocks) ([] order position)) instructions))
        (for (in index (..< 0 (. instructions length)))
          (call note-definitions ([] instructions index))
        )
      )
      (let converted false)
      (for (in position (..< 0 (. order length)))
        (if (call merge-chain ([] order position))
          (= converted true)
        )
        (if (call convert ([] order position))
          (= converted true)
        )
      )
      (if (not converted)
        (break)
      )
      (call (. builder prune-unreachable-blocks))
      (= changed true)
    )
    (return changed)
  )
  (fn-do _ note-definitions _
    (param id InstructionId)
    (match? ([] (. function instructions) id)
      (case (call .phi-instruction phi)
        (call note-definition id (. phi reg))
        (return)
      )
    )
    (let roles (call (. function operand-roles) id))
    (let operands (. ([] (. function instructions) id) operands))
    (for (in position (..< 0 (. operands length)))
      (if (== (/and/ (call role-at roles position) def-role) 0)
        (continue)
      )
      (match? ([] (. function operands) ([] operands position))
        (case .vreg-operand
          (call note-definition id ([] operands position))
        )
        (case (call .vreg-group-operand group)
          (for (in index (..< (. group vregs start) (. group vregs end)))
            (let vreg (. ([] (. function vregs) ([] (. function group-vregs) index)) id))
            (if (< vreg vreg-limit)
              (= ([] definitions vreg) (+ ([] definitions vreg) 1))
            )
          )
        )
        (case (call .load-address-operand address)
          (let base (call vreg-id function (. address base)))
          (if (and (!= base no-id) (< base vreg-limit))
            (= ([] definitions base) (+ ([] definitions base) 1))
          )
        )
      )
    )
  )
  (fn-do _ note-definition _
    (param id InstructionId)
    (param operand OperandId)
    (let vreg (call vreg-id function operand))
    (if (and (!= vreg no-id) (< vreg vreg-limit))
      (= ([] definitions vreg) (+ ([] definitions vreg) 1))
      (= ([] definers vreg) id)
    )
  )
  (fn-do _ convert Bool
    (param block BlockId)
    (if (or (!= ([] dead block) 0) (!= (. ([] (. function blocks) block) successors length) 2))
      (return false)
    )
    (let instructions (. ([] (. function blocks) block) instructions))
    (let jump-index (call previous-real function instructions (. instructions length)))
    (if (== jump-index no-id)
      (return false)
    )
    (let jump ([] instructions jump-index))
    (if (or (!= (. ([] (. function instructions) jump) opcode) .b) (!= (. ([] (. function instructions) jump) operands length) 1))
      (return false)
    )
    (let test-index (call previous-real function instructions jump-index))
    (if (== test-index no-id)
      (return false)
    )
    (let test ([] instructions test-index))
    (let test-opcode (. ([] (. function instructions) test) opcode))
    (if (and (!= test-opcode .cbz) (!= test-opcode .cbnz) (!= test-opcode .b-cond))
      (return false)
    )
    (let taken (call (. builder get-block) (call label-name function (call conditional-branch-target function test))))
    (let fallen (call (. builder get-block) (call label-name function (call first-operand function jump))))
    (if (or (== taken no-id) (== fallen no-id) (== taken fallen) (!= ([] dead taken) 0) (!= ([] dead fallen) 0))
      (return false)
    )
    (let taken-side no-id)
    (let fallen-side no-id)
    (let join no-id)
    (if (and (call is-side taken block) (call is-side fallen block) same-join)
      (= taken-side taken)
      (= fallen-side fallen)
      (= join (call side-successor taken))
      (else-if (and (call is-side taken block) (== (call side-successor taken) fallen))
        (= taken-side taken)
        (= join fallen)
      )
      (else-if (and (call is-side fallen block) (== (call side-successor fallen) taken))
        (= fallen-side fallen)
        (= join taken)
      )
      (else
        (return false)
      )
    )
    (lazy same-join (== (call side-successor taken) (call side-successor fallen)))
    (if (or (== join block) (!= ([] dead join) 0))
      (return false)
    )
    (let taken-source (if-expr (!= taken-side no-id) taken-side block))
    (let fallen-source (if-expr (!= fallen-side no-id) fallen-side block))
    (if (not (call collect-phis join taken-source fallen-source))
      (return false)
    )
    (blank)
    (let condition (call branch-condition instructions test-index test))
    (let tested ([] (. ([] (. function instructions) test) operands) 0))
    (let needs-compare (== condition no-operand))
    (if needs-compare
      (if (or (== test-opcode .b-cond) (not (call is-integer-vreg tested)))
        (return false)
      )
      (= condition
        (call (. builder add-operand)
          (block
            (arg (call CondOperand (if-expr (== test-opcode .cbnz) (. Condition unequal) (. Condition equal))))
          )
        )
      )
    )
    (let inverse (call invert-condition builder condition))
    (if (== inverse no-operand)
      (return false)
    )
    (let taken-body (call side-body taken-side))
    (let fallen-body (call side-body fallen-side))
    (let merges
      (scope (and only-from (not (call names-block function leading (. ([] (. function blocks) join) name))))
        (lazy only-from (call is-only-from join block taken-side fallen-side))
        (lazy leading (call IdList (. instructions data) test-index (. instructions capacity)))
      )
    )
    (let arena (. function arena))
    (let emitted (call new-id-list arena 8))
    (if (and (call is-speculable taken-body) (call is-speculable fallen-body))
      (for (in index (..< 0 (. taken-body length)))
        (= emitted (call (. emitted appended) arena ([] taken-body index)))
      )
      (for (in index (..< 0 (. fallen-body length)))
        (= emitted (call (. emitted appended) arena ([] fallen-body index)))
      )
      (if needs-compare
        (= emitted (call (. emitted appended) arena (call (. builder new-assembly) .cmp tested (call (. builder small-int) 0))))
      )
      (= emitted (call select-phis emitted condition merges))
      (else-if (and (!= taken-side no-id) (== (. fallen-body length) 0) (call is-compare-pair taken-body))
        (if needs-compare
          (= emitted (call (. emitted appended) arena (call (. builder new-assembly) .cmp tested (call (. builder small-int) 0))))
        )
        (= emitted (call chain emitted taken-body condition))
      )
      (else-if (and (!= fallen-side no-id) (== (. taken-body length) 0) (call is-compare-pair fallen-body))
        (if needs-compare
          (= emitted (call (. emitted appended) arena (call (. builder new-assembly) .cmp tested (call (. builder small-int) 0))))
        )
        (= emitted (call chain emitted fallen-body inverse))
      )
      (else
        (return false)
      )
    )
    (if (== (. emitted length) 0)
      (return false)
    )
    (call finish block test-index emitted join taken-side fallen-side merges)
    (return true)
  )
  (fn-do _ collect-phis Bool
    (param join BlockId)
    (param taken-source BlockId)
    (param fallen-source BlockId)
    (let arena (. function arena))
    (= phis (call IdList))
    (= taken-values (call IdList))
    (= fallen-values (call IdList))
    (= resolved (call IdList))
    (let taken-name (. ([] (. function blocks) taken-source) name))
    (let fallen-name (. ([] (. function blocks) fallen-source) name))
    (let instructions (. ([] (. function blocks) join) instructions))
    (for (in index (..< 0 (. instructions length)))
      (let id ([] instructions index))
      (let opcode (. ([] (. function instructions) id) opcode))
      (if (== opcode .comment)
        (continue)
      )
      (if (!= opcode .phi)
        (break)
      )
      (let reg no-operand)
      (let taken-value no-operand)
      (let fallen-value no-operand)
      (match? ([] (. function instructions) id)
        (case (call .phi-instruction phi)
          (= reg (. phi reg))
          (for (in entry (..< 0 (. phi blocks length)))
            (if (and (< entry (. phi exprs length)) (== ([] (. phi blocks) entry) taken-name))
              (= taken-value ([] (. phi exprs) entry))
            )
            (if (and (< entry (. phi exprs length)) (== ([] (. phi blocks) entry) fallen-name))
              (= fallen-value ([] (. phi exprs) entry))
            )
          )
        )
      )
      (let row (call vreg-row function reg))
      (if (or (== row no-id) (!= (. ([] (. function vregs) row) hint) no-register) missing-value)
        (return false)
      )
      (lazy missing-value (or (== taken-value no-operand) (== fallen-value no-operand)))
      (if (or (== (call vreg-row function taken-value) no-id) (== (call vreg-row function fallen-value) no-id))
        (return false)
      )
      (= phis (call (. phis appended) arena id))
      (= taken-values (call (. taken-values appended) arena taken-value))
      (= fallen-values (call (. fallen-values appended) arena fallen-value))
      (= resolved (call (. resolved appended) arena no-operand))
    )
    (return true)
  )
  (fn-do _ branch-condition OperandId
    (param instructions IdList)
    (param test-index U32)
    (param test InstructionId)
    (let opcode (. ([] (. function instructions) test) opcode))
    (let operands (. ([] (. function instructions) test) operands))
    (if (== opcode .b-cond)
      (return ([] operands 1))
    )
    (let tested (call vreg-id function ([] operands 0)))
    (if (or (== tested no-id) (>= tested vreg-limit) (!= ([] definitions tested) 1))
      (return no-operand)
    )
    (let definer ([] definers tested))
    (if (== (. ([] (. function instructions) definer) opcode) .uxtb)
      (let source (call vreg-id function ([] (. ([] (. function instructions) definer) operands) 1)))
      (if (or (== source no-id) (>= source vreg-limit) (!= ([] definitions source) 1))
        (return no-operand)
      )
      (= definer ([] definers source))
    )
    (if (!= (. ([] (. function instructions) definer) opcode) .cset)
      (return no-operand)
    )
    (let position no-id)
    (for (in index (..< 0 test-index))
      (if (== ([] instructions index) definer)
        (= position index)
      )
    )
    (if (== position no-id)
      (return no-operand)
    )
    (for (in index (..< (+ position 1) test-index))
      (if (call clobbers-flags (. ([] (. function instructions) ([] instructions index)) opcode))
        (return no-operand)
      )
    )
    (let condition ([] (. ([] (. function instructions) definer) operands) 1))
    (if (== opcode .cbz)
      (return (call invert-condition builder condition))
    )
    (return condition)
  )
  (fn-expr _ is-side Bool
    (param side BlockId)
    (param block BlockId)
    (case? (or (== side block) (!= ([] dead side) 0) (== side ([] (. function block-order) 0)))
      false
    )
    (case? (or other-entry (!= (. successors length) 1) (== ([] successors 0) side))
      false
    )
    (case? (or (== last no-id) (!= (. ([] (. function instructions) last) opcode) .b))
      false
    )
    (default
      (== (call (. builder get-block) (call label-name function (call first-operand function last))) ([] successors 0))
    )
    (where
      (lazy predecessors (. ([] (. function blocks) side) predecessors))
      (lazy successors (. ([] (. function blocks) side) successors))
      (lazy last (call last-real function side))
      (lazy other-entry (or (!= (. predecessors length) 1) (!= ([] predecessors 0) block)))
    )
  )
  (fn-expr _ side-successor BlockId
    (param side BlockId)
    ([] (. ([] (. function blocks) side) successors) 0)
  )
  (fn-do _ side-body IdList
    (param side BlockId)
    (if (== side no-id)
      (return (call IdList))
    )
    (let arena (. function arena))
    (let body (call IdList))
    (let last (call last-real function side))
    (let instructions (. ([] (. function blocks) side) instructions))
    (for (in index (..< 0 (. instructions length)))
      (let id ([] instructions index))
      (if (and (!= id last) (!= (. ([] (. function instructions) id) opcode) .comment))
        (= body (call (. body appended) arena id))
      )
    )
    (return body)
  )
  (fn-do _ is-only-from Bool
    (param join BlockId)
    (param block BlockId)
    (param taken-side BlockId)
    (param fallen-side BlockId)
    (let predecessors (. ([] (. function blocks) join) predecessors))
    (for (in index (..< 0 (. predecessors length)))
      (let predecessor ([] predecessors index))
      (if (and (!= predecessor block) (!= predecessor taken-side) (!= predecessor fallen-side))
        (return false)
      )
    )
    (return (!= join ([] (. function block-order) 0)))
  )
  (fn-do _ is-speculable Bool
    (param body IdList)
    (if (> (. body length) 2)
      (return false)
    )
    (for (in index (..< 0 (. body length)))
      (let id ([] body index))
      (let is-assembly false)
      (match? ([] (. function instructions) id)
        (case .assembly-instruction
          (= is-assembly true)
        )
      )
      (let opcode (. ([] (. function instructions) id) opcode))
      (if (or (not is-assembly) (not (call is-pure-def opcode)) (call reads-flags opcode) is-costly)
        (return false)
      )
      (lazy is-costly (or (== opcode .sdiv) (== opcode .udiv) (== opcode .fdiv) (== opcode .fsqrt)))
      (let defined (call (. function instruction-def) id))
      (if (or (== defined no-id) hinted beyond-limit (!= ([] definitions (. ([] (. function vregs) defined) id)) 1))
        (return false)
      )
      (lazy hinted (!= (. ([] (. function vregs) defined) hint) no-register))
      (lazy beyond-limit (>= (. ([] (. function vregs) defined) id) vreg-limit))
    )
    (return true)
  )
  (fn-expr _ is-compare-pair Bool
    (param body IdList)
    (case? (or (!= (. body length) 2) (!= (. ([] (. function instructions) ([] body 0)) opcode) .cmp) not-cset)
      false
    )
    (case? (or (!= (. operands length) 2) (not (call is-integer-vreg ([] operands 0))))
      false
    )
    (case? (and (not (call is-integer-vreg ([] operands 1))) (or (not (. value is-known)) (. value is-negative) (> (. value bits) 0xffff)))
      false
    )
    (default
      (and (== (. flag length) 2) (!= (call vreg-row function ([] flag 0)) no-id))
    )
    (where
      (lazy operands (. ([] (. function instructions) ([] body 0)) operands))
      (lazy value (call known-int function ([] operands 1)))
      (lazy flag (. ([] (. function instructions) ([] body 1)) operands))
      (lazy not-cset (!= (. ([] (. function instructions) ([] body 1)) opcode) .cset))
    )
  )
  (fn-do _ select-phis IdList
    (param emitted IdList)
    (param condition OperandId)
    (param merges Bool)
    (let arena (. function arena))
    (let result emitted)
    (for (in index (..< 0 (. phis length)))
      (let taken-value ([] taken-values index))
      (let fallen-value ([] fallen-values index))
      (if (call same-operand function taken-value fallen-value)
        (= ([] (. resolved data) index) taken-value)
        (continue)
      )
      (let reg no-operand)
      (match? ([] (. function instructions) ([] phis index))
        (case (call .phi-instruction phi)
          (= reg (. phi reg))
        )
      )
      (let row ([] (. function vregs) (call vreg-row function reg)))
      (let dest reg)
      (if (not merges)
        (= dest
          (call (. builder vreg-operand)
            (block
              (arg
                (call (. builder new-vreg)
                  (block
                    (arg (. row reg-class))
                    (arg no-register)
                    (arg (. row gc-root))
                    (arg (. row gc-descriptor))
                    (arg (. row gc-root-mode))
                  )
                )
              )
            )
          )
        )
      )
      (let is-float (or (== (. row reg-class) .fpr32) (== (. row reg-class) .fpr64)))
      (= result
        (call (. result appended)
          (block
            (arg arena)
            (arg
              (call (. builder new-assembly)
                (block
                  (arg (if-expr is-float (. Opcode fcsel) (. Opcode csel)))
                  (arg dest)
                  (arg taken-value)
                  (arg fallen-value)
                  (arg condition)
                )
              )
            )
          )
        )
      )
      (= ([] (. resolved data) index) dest)
    )
    (return result)
  )
  (fn-do _ chain IdList
    (param emitted IdList)
    (param body IdList)
    (param condition OperandId)
    (let compare ([] body 0))
    (let flag ([] body 1))
    (let flag-dest ([] (. ([] (. function instructions) flag) operands) 0))
    (let flag-vreg (call vreg-id function flag-dest))
    (let constant no-id)
    (for (in index (..< 0 (. phis length)))
      (let first ([] taken-values index))
      (let second ([] fallen-values index))
      (if (call same-operand function first second)
        (= ([] (. resolved data) index) first)
        (continue)
      )
      (let other no-operand)
      (if (== (call vreg-id function first) flag-vreg)
        (= other second)
        (else-if (== (call vreg-id function second) flag-vreg)
          (= other first)
        )
      )
      (if (or (== other no-operand) (!= constant no-id))
        (return (call IdList))
      )
      (= constant (call phi-constant other))
      (if (== constant no-id)
        (return (call IdList))
      )
      (= ([] (. resolved data) index) flag-dest)
    )
    (if (== constant no-id)
      (return (call IdList))
    )
    (let nzcv (call flags-for (call condition-code function ([] (. ([] (. function instructions) flag) operands) 1)) constant))
    (if (== nzcv no-id)
      (return (call IdList))
    )
    (let arena (. function arena))
    (let result emitted)
    (let operands (. ([] (. function instructions) compare) operands))
    (let right ([] operands 1))
    (let value (call known-int function right))
    (if (and (. value is-known) (> (. value bits) 31))
      (= right
        (call (. builder vreg-operand)
          (block
            (arg (call (. builder new-vreg) (. ([] (. function vregs) (call vreg-row function ([] operands 0))) reg-class)))
          )
        )
      )
      (= result
        (call (. result appended)
          (block
            (arg arena)
            (arg
              (call (. builder new-assembly)
                (block
                  (arg .movz)
                  (arg right)
                  (arg (call (. builder small-int) (as (. value bits) I64)))
                  (arg (call (. builder small-int) 0))
                )
              )
            )
          )
        )
      )
    )
    (call rewrite-assembly
      (block
        (arg function)
        (arg compare)
        (arg .ccmp)
        (arg (call quad arena ([] operands 0) right (call (. builder small-int) nzcv) condition))
      )
    )
    (= result (call (. result appended) arena compare))
    (return (call (. result appended) arena flag))
  )
  (fn-expr _ phi-constant U32
    (param operand OperandId)
    (case? (or (== vreg no-id) (>= vreg vreg-limit) (!= ([] definitions vreg) 1))
      no-id
    )
    (case? (or (!= opcode .movz) (< (. operands length) 2))
      no-id
    )
    (case? (and (> (. operands length) 2) (or (not (. shift is-known)) (!= (. shift bits) 0)))
      no-id
    )
    (case? (or (not (. value is-known)) (. value is-negative) (> (. value bits) 1))
      no-id
    )
    (default
      (as (. value bits) U32)
    )
    (where
      (lazy vreg (call vreg-id function operand))
      (lazy definer ([] definers vreg))
      (lazy opcode (. ([] (. function instructions) definer) opcode))
      (lazy operands (. ([] (. function instructions) definer) operands))
      (lazy shift (call known-int function ([] operands 2)))
      (lazy value (call known-int function ([] operands 1)))
    )
  )
  (fn-do _ finish _
    (param block BlockId)
    (param test-index U32)
    (param emitted IdList)
    (param join BlockId)
    (param taken-side BlockId)
    (param fallen-side BlockId)
    (param merges Bool)
    (let arena (. function arena))
    (let instructions (. ([] (. function blocks) block) instructions))
    (let kept (call new-id-list arena (+ (. instructions length) (. emitted length) 2)))
    (for (in index (..< 0 test-index))
      (= kept (call (. kept appended) arena ([] instructions index)))
    )
    (for (in index (..< 0 (. emitted length)))
      (= kept (call (. kept appended) arena ([] emitted index)))
    )
    (if (!= taken-side no-id)
      (= ([] dead taken-side) 1)
    )
    (if (!= fallen-side no-id)
      (= ([] dead fallen-side) 1)
    )
    (let join-row ([] (. function blocks) join))
    (let name (. ([] (. function blocks) block) name))
    (if merges
      (for (in index (..< 0 (. phis length)))
        (let reg no-operand)
        (match? ([] (. function instructions) ([] phis index))
          (case (call .phi-instruction phi)
            (= reg (. phi reg))
          )
        )
        (if (not (call same-operand function reg ([] resolved index)))
          (= kept
            (call (. kept appended)
              (block
                (arg arena)
                (arg (call (. builder new-assembly) (call (. builder copy-opcode) reg) reg ([] resolved index)))
              )
            )
          )
        )
      )
      (call merge-into block join kept)
      (return)
    )
    (for (in index (..< 0 (. phis length)))
      (call set-phi-source ([] phis index) taken-side fallen-side block ([] resolved index))
    )
    (= kept (call (. kept appended) arena (call (. builder new-assembly) .b (call (. builder label) (. join-row name)))))
    (= (. ([] (. function blocks) block) instructions) kept)
    (= (. ([] (. function blocks) block) successors) (call (. (call IdList) appended) arena join))
    (let predecessors (. join-row predecessors))
    (let listed (call IdList))
    (for (in index (..< 0 (. predecessors length)))
      (let predecessor ([] predecessors index))
      (if (and (!= predecessor taken-side) (!= predecessor fallen-side) (!= predecessor block))
        (= listed (call (. listed appended) arena predecessor))
      )
    )
    (= (. ([] (. function blocks) join) predecessors) (call (. listed appended) arena block))
  )
  (fn-do _ merge-chain Bool
    (param block BlockId)
    (let merged false)
    (while (and (== ([] dead block) 0) (== (. ([] (. function blocks) block) successors length) 1))
      (let instructions (. ([] (. function blocks) block) instructions))
      (let jump-index (call previous-real function instructions (. instructions length)))
      (if (== jump-index no-id)
        (break)
      )
      (let jump ([] instructions jump-index))
      (if (or (!= (. ([] (. function instructions) jump) opcode) .b) (!= (. ([] (. function instructions) jump) operands length) 1))
        (break)
      )
      (let join ([] (. ([] (. function blocks) block) successors) 0))
      (let predecessors (. ([] (. function blocks) join) predecessors))
      (if (or (== join block) (!= ([] dead join) 0) (== join ([] (. function block-order) 0)) other-entry)
        (break)
      )
      (lazy other-entry (or (!= (. predecessors length) 1) (!= ([] predecessors 0) block)))
      (let join-name (. ([] (. function blocks) join) name))
      (if (or jumps-elsewhere (call names-block function leading join-name))
        (break)
      )
      (lazy jumps-elsewhere (!= (call label-name function (call first-operand function jump)) join-name))
      (lazy leading (call IdList (. instructions data) jump-index (. instructions capacity)))
      (let arena (. function arena))
      (let kept (call new-id-list arena (. instructions length)))
      (for (in index (..< 0 (. instructions length)))
        (if (!= index jump-index)
          (= kept (call (. kept appended) arena ([] instructions index)))
        )
      )
      (let name (. ([] (. function blocks) block) name))
      (let joined (. ([] (. function blocks) join) instructions))
      (let is-simple true)
      (for (in index (..< 0 (. joined length)))
        (match? ([] (. function instructions) ([] joined index))
          (case (call .phi-instruction phi)
            (if (or (!= (. phi blocks length) 1) (!= (. phi exprs length) 1) (!= ([] (. phi blocks) 0) name))
              (= is-simple false)
              (else
                (= kept
                  (call (. kept appended)
                    (block
                      (arg arena)
                      (arg (call (. builder new-assembly) (call (. builder copy-opcode) (. phi reg)) (. phi reg) ([] (. phi exprs) 0)))
                    )
                  )
                )
              )
            )
          )
        )
      )
      (if (not is-simple)
        (break)
      )
      (call merge-into block join kept)
      (= merged true)
    )
    (return merged)
  )
  (fn-do _ merge-into _
    (param block BlockId)
    (param join BlockId)
    (param kept IdList)
    (let arena (. function arena))
    (let merged kept)
    (let join-row ([] (. function blocks) join))
    (let joined (. join-row instructions))
    (for (in index (..< 0 (. joined length)))
      (if (!= (. ([] (. function instructions) ([] joined index)) opcode) .phi)
        (= merged (call (. merged appended) arena ([] joined index)))
      )
    )
    (= (. ([] (. function blocks) block) instructions) merged)
    (= (. ([] (. function blocks) block) successors) (. join-row successors))
    (let name (. ([] (. function blocks) block) name))
    (let successors (. join-row successors))
    (for (in index (..< 0 (. successors length)))
      (let successor ([] successors index))
      (let predecessors (. ([] (. function blocks) successor) predecessors))
      (for (in entry (..< 0 (. predecessors length)))
        (if (== ([] predecessors entry) join)
          (= ([] (. predecessors data) entry) block)
        )
      )
      (call rename-phi-source successor (. join-row name) name)
    )
    (= (. ([] (. function blocks) join) predecessors) (call IdList))
    (= (. ([] (. function blocks) join) successors) (call IdList))
    (= ([] dead join) 1)
  )
  (fn-do _ set-phi-source _
    (param id InstructionId)
    (param taken-side BlockId)
    (param fallen-side BlockId)
    (param block BlockId)
    (param value OperandId)
    (let arena (. function arena))
    (let name (. ([] (. function blocks) block) name))
    (let taken-name (if-expr (!= taken-side no-id) (. ([] (. function blocks) taken-side) name) no-string))
    (let fallen-name (if-expr (!= fallen-side no-id) (. ([] (. function blocks) fallen-side) name) no-string))
    (match? ([] (. function instructions) id)
      (case (call .phi-instruction phi)
        (let exprs (call IdList))
        (let blocks (call IdList))
        (for (in entry (..< 0 (. phi blocks length)))
          (let source ([] (. phi blocks) entry))
          (if (or (== source name) (== source taken-name) (== source fallen-name))
            (continue)
          )
          (= exprs (call (. exprs appended) arena ([] (. phi exprs) entry)))
          (= blocks (call (. blocks appended) arena source))
        )
        (= (. phi exprs) (call (. exprs appended) arena value))
        (= (. phi blocks) (call (. blocks appended) arena name))
      )
    )
  )
  (fn-do _ rename-phi-source _
    (param block BlockId)
    (param from StringId)
    (param to StringId)
    (let instructions (. ([] (. function blocks) block) instructions))
    (for (in index (..< 0 (. instructions length)))
      (match? ([] (. function instructions) ([] instructions index))
        (case (call .phi-instruction phi)
          (for (in entry (..< 0 (. phi blocks length)))
            (if (== ([] (. phi blocks) entry) from)
              (= ([] (. phi blocks data) entry) to)
            )
          )
        )
      )
    )
  )
  (fn-expr _ is-integer-vreg Bool
    (param operand OperandId)
    (and (!= row no-id) (or (== (. ([] (. function vregs) row) reg-class) .gpr32) (== (. ([] (. function vregs) row) reg-class) .gpr64)))
    (where
      (lazy row (call vreg-row function operand))
    )
  )
)

(fn-do _ condition-code U32
  (param function MIRFunction)
  (param operand OperandId)
  (match? ([] (. function operands) operand)
    (case (call .cond-operand row)
      (return (. row code))
    )
  )
  (return no-condition)
)

(fn-do _ flags-for U32
  (param code U32)
  (param value U32)
  (if (or (== code no-condition) (>= code (. Condition always)))
    (return no-id)
  )
  (for (in nzcv (..< 0 16))
    (if (== (call holds-for code (as nzcv U32)) (!= value 0))
      (return (as nzcv U32))
    )
  )
  (return no-id)
)

(fn-expr _ compare-flags U32
  (param left U64)
  (param right U64)
  (param width U64)
  ; The NZCV flags that comparing `left` with `right` at `width` bits sets.
  (/or/ (if-expr negative 8u32 0) (if-expr (== low high) 4 0) (if-expr (>= low high) 2 0) (if-expr overflow 1 0))
  (where
    (lazy mask (if-expr (== width 32) low-word all-bits))
    (lazy low (/and/ left mask))
    (lazy high (/and/ right mask))
    (lazy sign (/lshift/ 1u64 (- width 1)))
    (lazy difference (/and/ (- low high) mask))
    (lazy negative (!= (/and/ difference sign) 0))
    (lazy overflow (!= (/and/ (/xor/ low high) (/xor/ low difference) sign) 0))
  )
)

(fn-do _ holds-for Bool
  (param code U32)
  (param nzcv U32)
  (let negative (!= (/and/ nzcv 8) 0))
  (let zero (!= (/and/ nzcv 4) 0))
  (let carry (!= (/and/ nzcv 2) 0))
  (let overflow (!= (/and/ nzcv 1) 0))
  (let base (/zrshift/ code 1))
  (let holds true)
  (if (== base 0)
    (= holds zero)
    (else-if (== base 1)
      (= holds carry)
    )
    (else-if (== base 2)
      (= holds negative)
    )
    (else-if (== base 3)
      (= holds overflow)
    )
    (else-if (== base 4)
      (= holds (and carry (not zero)))
    )
    (else-if (== base 5)
      (= holds (== negative overflow))
    )
    (else-if (== base 6)
      (= holds (and (not zero) (== negative overflow)))
    )
  )
  (return (if-expr (!= (/and/ code 1) 0) (not holds) holds))
)

(type + MIRJumpThreadingPass
  ; Sends a block that jumps on to a conditional branch straight to the side that branch takes,
  ; when the constants it leaves settle the branch. With `orders`, a compare of two constants
  ; settles every condition a CSET reads after it; without, only whether they are equal.
  (prop _ builder MIRBuilder)
  (prop _ function MIRFunction)
  (prop _ orders Bool)
  (prop _ constants (of CPointer U64))
  (prop _ is-constant (of CPointer Byte))
  (prop _ constant-ids IdList)
  (prop _ constant-count U32)
  (prop _ is-compared Bool)
  (prop _ is-equal Bool)
  (prop _ compared-left U64)
  (prop _ compared-right U64)
  (prop _ compared-width U64)
  (fn-do + This _
    (param builder MIRBuilder)
    (param orders Bool (= true))
    (lazy function (. builder function))
  )
  (fn-do + run Bool
    (let arena (. function arena))
    (let changed false)
    (= constants (call (of (. arena allocate) U64) (. function vreg-count)))
    (= is-constant (call (of (. arena allocate) Byte) (. function vreg-count)))
    (= constant-ids (call IdList))
    (= constant-count 0)
    (= is-compared false)
    (let visited (call (of (. arena allocate) U32) (. function blocks length)))
    (let visit U32)
    (let incoming (call (of (. arena allocate) U32) 8))
    (let copied (call new-id-list arena 64))
    (let order (. function block-order))
    (for (in position (..< 0 (. order length)))
      (let predecessor ([] order position))
      (let successors (. ([] (. function blocks) predecessor) successors))
      (if (or (!= (. successors length) 1) (call has-conditional-branch predecessor))
        (continue)
      )
      (blank)
      (= copied (call IdList (. copied data) 0 (. copied capacity)))
      (+= visit 1)
      (= ([] visited predecessor) visit)
      (let visited-count U32 1)
      (let block ([] successors 0))
      (let branch no-id)
      (while (and (<= visited-count 8) (<= (. copied length) 32))
        (if (== ([] visited block) visit)
          (break)
        )
        (= ([] visited block) visit)
        (+= visited-count 1)
        (let is-stopped false)
        (let instructions (. ([] (. function blocks) block) instructions))
        (let block-successors (. ([] (. function blocks) block) successors))
        (for (in index (..< 0 (. instructions length)))
          (let id ([] instructions index))
          (let opcode (. ([] (. function instructions) id) opcode))
          (if (or (== opcode .b) (== opcode .comment))
            (continue)
          )
          (if (or (== opcode .cbz) (== opcode .cbnz))
            (if (== (. block-successors length) 2)
              (= branch id)
            )
            (= is-stopped true)
            (break)
          )
          (if (and (not (call is-pure-def opcode)) (!= opcode .cmp))
            (= is-stopped true)
            (break)
          )
          (= copied (call (. copied appended) arena id))
        )
        (if (or is-stopped (!= (. block-successors length) 1))
          (break)
        )
        (= block ([] block-successors 0))
      )
      (if (or (== branch no-id) (> (. copied length) 32))
        (continue)
      )
      (let target-name (call label-name function (call conditional-branch-target function branch)))
      (if (== target-name no-string)
        (continue)
      )
      (blank)
      (call clear-constants)
      (= is-compared false)
      (let incoming-count U32 1)
      (= ([] incoming 0) predecessor)
      (while (< incoming-count 8)
        (let predecessors (. ([] (. function blocks) ([] incoming (- incoming-count 1))) predecessors))
        (if (!= (. predecessors length) 1)
          (break)
        )
        (let prior ([] predecessors 0))
        (let is-repeated false)
        (for (in index (..< 0 incoming-count))
          (if (== ([] incoming index) prior)
            (= is-repeated true)
          )
        )
        (if is-repeated
          (break)
        )
        (= ([] incoming incoming-count) prior)
        (+= incoming-count 1)
      )
      (let remaining incoming-count)
      (while (> remaining 0)
        (-= remaining 1)
        (let prior-instructions (. ([] (. function blocks) ([] incoming remaining)) instructions))
        (for (in index (..< 0 (. prior-instructions length)))
          (call evaluate ([] prior-instructions index))
        )
      )
      (if (== constant-count 0)
        (continue)
      )
      (for (in index (..< 0 (. copied length)))
        (call evaluate ([] copied index))
      )
      (let condition (call value-of ([] (. ([] (. function instructions) branch) operands) 0)))
      (if (not (. condition is-known))
        (continue)
      )
      (blank)
      (let is-taken (== (. condition bits) 0))
      (if (!= (. ([] (. function instructions) branch) opcode) .cbz)
        (= is-taken (not is-taken))
      )
      (let target no-id)
      (let branch-successors (. ([] (. function blocks) block) successors))
      (for (in index (..< 0 (. branch-successors length)))
        (let candidate ([] branch-successors index))
        (if (== (== (. ([] (. function blocks) candidate) name) target-name) is-taken)
          (= target candidate)
          (break)
        )
      )
      (if (or (== target no-id) (== ([] visited target) visit))
        (continue)
      )
      (blank)
      (let last (call last-real function predecessor))
      (if (and (!= last no-id) (== (. ([] (. function instructions) last) opcode) .b))
        (call remove-instruction function predecessor last)
      )
      (let threaded (. ([] (. function blocks) predecessor) instructions))
      (for (in index (..< 0 (. copied length)))
        (let copy (call copy-instruction ([] copied index)))
        (call (. function add-uses) copy)
        (= threaded (call (. threaded appended) arena copy))
      )
      (= threaded
        (call (. threaded appended)
          (block
            (arg arena)
            (arg (call (. builder new-assembly) .b (call (. builder label) (. ([] (. function blocks) target) name))))
          )
        )
      )
      (= (. ([] (. function blocks) predecessor) instructions) threaded)
      (blank)
      (let previous ([] successors 0))
      (let previous-predecessors (. ([] (. function blocks) previous) predecessors))
      (let kept U32)
      (for (in index (..< 0 (. previous-predecessors length)))
        (if (!= ([] previous-predecessors index) predecessor)
          (= ([] (. previous-predecessors data) kept) ([] previous-predecessors index))
          (+= kept 1)
        )
      )
      (= (. ([] (. function blocks) previous) predecessors)
        (call IdList
          (block
            (arg (. previous-predecessors data))
            (arg kept)
            (arg (. previous-predecessors capacity))
          )
        )
      )
      (= (. ([] (. function blocks) predecessor) successors) (call (. (call IdList) appended) arena target))
      (if (not (call includes (. ([] (. function blocks) target) predecessors) predecessor))
        (= (. ([] (. function blocks) target) predecessors)
          (call (. ([] (. function blocks) target) predecessors appended)
            (block
              (arg arena)
              (arg predecessor)
            )
          )
        )
      )
      (= changed true)
    )
    (blank)
    (if changed
      (call repair-predecessors function)
      (call (. builder prune-unreachable-blocks))
    )
    (return changed)
  )
  (fn-do _ has-conditional-branch Bool
    (param block BlockId)
    (let instructions (. ([] (. function blocks) block) instructions))
    (for (in index (..< 0 (. instructions length)))
      (let opcode (. ([] (. function instructions) ([] instructions index)) opcode))
      (if (or (== opcode .b-cond) (== opcode .cbz) (== opcode .cbnz))
        (return true)
      )
    )
    (return false)
  )
  (fn-do _ copy-instruction InstructionId
    (param id InstructionId)
    (let arena (. function arena))
    (let opcode Opcode .nop)
    (let operands IdList)
    (let loc no-loc)
    (let position no-position)
    (let gc-free-zone false)
    (let gc-exceptional-safepoint false)
    (let gc-safepoint false)
    (let has-gc-roots false)
    (let gc-roots Span)
    (let is-assembly false)
    (match? ([] (. function instructions) id)
      (case (call .assembly-instruction row)
        (= is-assembly true)
        (= opcode (. row opcode))
        (= operands (. row operands))
        (= loc (. row loc))
        (= position (. row position))
        (= gc-free-zone (. row gc-free-zone))
        (= gc-exceptional-safepoint (. row gc-exceptional-safepoint))
        (= gc-safepoint (. row gc-safepoint))
        (= has-gc-roots (. row has-gc-roots))
        (= gc-roots (. row gc-roots))
      )
    )
    (throw (call Panic "Jump threading copies an instruction that is not an assembly instruction") (if (not is-assembly)))
    (blank)
    (let copy (call new-id-list arena (. operands length)))
    (for (in index (..< 0 (. operands length)))
      (= copy (call (. copy appended) arena ([] operands index)))
    )
    (let copied InstructionId (as (. function instructions length) InstructionId))
    (call (. function instructions append)
      (block
        (call AssemblyInstruction
          (block
            (arg opcode)
            (arg copy)
            (arg loc)
            (arg position)
            (arg gc-free-zone)
            (arg gc-exceptional-safepoint)
            (arg gc-safepoint)
            (arg false)
            (arg has-gc-roots)
            (arg gc-roots)
          )
        )
      )
    )
    (return copied)
  )
  (fn-do _ value-of Known
    (param operand OperandId)
    (if (== operand no-operand)
      (return (call Known))
    )
    (match? ([] (. function operands) operand)
      (case (call .int-operand row)
        (return (call Known true (. row value bits) (. row value is-negative)))
      )
      (case (call .vreg-operand row)
        (let vreg (. ([] (. function vregs) (. row vreg)) id))
        (if (!= ([] is-constant vreg) 0)
          (return (call Known true ([] constants vreg) false))
        )
      )
    )
    (return (call Known))
  )
  (fn-do _ evaluate _
    (param id InstructionId)
    (let opcode (. ([] (. function instructions) id) opcode))
    (let operands (. ([] (. function instructions) id) operands))
    (let dest no-operand)
    (let source no-operand)
    (let extra no-operand)
    (if (> (. operands length) 0)
      (= dest ([] operands 0))
    )
    (if (> (. operands length) 1)
      (= source ([] operands 1))
    )
    (if (> (. operands length) 2)
      (= extra ([] operands 2))
    )
    (if (== opcode .cmp)
      (let left (call value-of dest))
      (let right (call value-of source))
      (let row (call vreg-row function dest))
      (= is-compared (and (. left is-known) (. right is-known) (or (== (. operands length) 2) (not orders))))
      (= is-equal (and (== (. left bits) (. right bits)) (== (. left is-negative) (. right is-negative))))
      (= compared-left (. left bits))
      (= compared-right (. right bits))
      (= compared-width (if-expr is-narrow 32 64))
      (lazy is-narrow (and (!= row no-id) (== (call class-mask (. ([] (. function vregs) row) reg-class)) low-word)))
      (return)
    )
    (blank)
    (let defined (call (. function instruction-def) id))
    (let input (call value-of source))
    (let is-known false)
    (let bits U64)
    (let extension (call extension-bits opcode))
    (if (== opcode .mov)
      (= is-known (. input is-known))
      (= bits (. input bits))
      (else-if (and (== opcode .movz) (. input is-known))
        (let shift (call value-of extra))
        (throw (call Panic "MOVZ shifts by a negative amount") (if (and (. shift is-known) (. shift is-negative))))
        (blank)
        (= is-known true)
        (if (not (. shift is-known))
          (= bits (. input bits))
          (else-if (< (. shift bits) 64)
            (= bits (/lshift/ (. input bits) (. shift bits)))
          )
        )
      )
      (else-if (and (== opcode .cset) is-compared (call settles (call condition-code source)))
        (= is-known true)
        (if (call holds (call condition-code source))
          (= bits 1)
        )
      )
      (else-if (and (. input is-known) (!= extension 0))
        (= is-known true)
        (let mask U64 (- (/lshift/ 1u64 extension) 1))
        (= bits (/and/ (. input bits) mask))
        (if (and (call is-signed-extension opcode) (!= (/and/ (. input bits) (/lshift/ 1u64 (- extension 1))) 0))
          (= bits (/or/ bits (/xor/ 0xffffffffffffffff mask)))
        )
      )
    )
    (blank)
    (if (!= defined no-id)
      (if (== (. ([] (. function vregs) defined) reg-class) .gpr32)
        (= bits (/and/ bits 0xffffffff))
      )
      (call set-constant (. ([] (. function vregs) defined) id) is-known bits)
    )
    (if (and (!= opcode .comment) (not (call is-pure-def opcode)) (not (call is-branch-opcode opcode)))
      (= is-compared false)
      (call clear-constants)
    )
  )
  (fn-expr _ settles Bool
    (param code U32)
    (case? orders
      (<= code (. Condition always))
    )
    (default
      (or (== code (. Condition equal)) (== code (. Condition unequal)))
    )
  )
  (fn-expr _ holds Bool
    (param code U32)
    (case? orders
      (call holds-for code (call compare-flags compared-left compared-right compared-width))
    )
    (default
      (== (== code (. Condition equal)) is-equal)
    )
  )
  (fn-do _ condition-code U32
    (param operand OperandId)
    (if (== operand no-operand)
      (return no-condition)
    )
    (match? ([] (. function operands) operand)
      (case (call .cond-operand row)
        (return (. row code))
      )
    )
    (return no-condition)
  )
  (fn-do _ set-constant _
    (param vreg U32)
    (param is-known Bool)
    (param bits U64)
    (if (!= ([] is-constant vreg) 0)
      (-= constant-count 1)
      (= ([] is-constant vreg) 0)
    )
    (if is-known
      (= ([] constants vreg) bits)
      (= ([] is-constant vreg) 1)
      (+= constant-count 1)
      (= constant-ids (call (. constant-ids appended) (. function arena) vreg))
    )
  )
  (fn-do _ clear-constants _
    (for (in index (..< 0 (. constant-ids length)))
      (= ([] is-constant ([] constant-ids index)) 0)
    )
    (= constant-ids (call IdList (. constant-ids data) 0 (. constant-ids capacity)))
    (= constant-count 0)
  )
)

(type + MIRCFGCleanupPass
  (prop _ builder MIRBuilder)
  (prop _ function MIRFunction)
  (fn-do + This _
    (param builder MIRBuilder)
    (lazy function (. builder function))
  )
  (fn-do + run Bool
    (let changed false)
    (for (in _ (..< 0 4))
      (let rewrote-branches (call rewrite-branch-chains))
      (let removed-blocks (call remove-trivial-blocks))
      (let removed-branches (call remove-branches-to-layout-successor))
      (let merged-blocks (call merge-fallthrough-blocks))
      (if (and (not rewrote-branches) (not removed-blocks) (not removed-branches) (not merged-blocks))
        (break)
      )
      (= changed true)
      (call (. builder prune-unreachable-blocks))
    )
    (return changed)
  )
  (fn-do _ rewrite-branch-chains Bool
    (let changed false)
    (let order (. function block-order))
    (for (in position (..< 0 (. order length)))
      (let block ([] order position))
      (let instructions (. ([] (. function blocks) block) instructions))
      (for (in index (..< 0 (. instructions length)))
        (let id ([] instructions index))
        (if (not (call is-branch-opcode (. ([] (. function instructions) id) opcode)))
          (continue)
        )
        (let operands (. ([] (. function instructions) id) operands))
        (for (in entry (..< 0 (. operands length)))
          (let name (call label-name function ([] operands entry)))
          (if (== name no-string)
            (continue)
          )
          (let target (call (. builder get-block) name))
          (if (== target no-id)
            (continue)
          )
          (let resolved (call branch-chain-target target))
          (if (or (== resolved no-id) (== (. ([] (. function blocks) resolved) name) name))
            (continue)
          )
          (= ([] (. operands data) entry) (call (. builder label) (. ([] (. function blocks) resolved) name)))
          (call replace-successor function block target resolved)
          (= changed true)
        )
      )
    )
    (blank)
    (for (in table (..< 0 (. function jump-tables length)))
      (let labels (. ([] (. function jump-tables) table) labels))
      (for (in index (..< (. labels start) (. labels end)))
        (let name ([] (. function names) index))
        (let target (call (. builder get-block) name))
        (if (== target no-id)
          (continue)
        )
        (let resolved (call branch-chain-target target))
        (if (and (!= resolved no-id) (!= (. ([] (. function blocks) resolved) name) name))
          (= ([] (. function names data) index) (. ([] (. function blocks) resolved) name))
          (= changed true)
        )
      )
    )
    (if changed
      (call repair-predecessors function)
    )
    (return changed)
  )
  (fn-expr _ branch-chain-target BlockId
    (param block BlockId)
    (case? (or (== instruction no-id) (!= (. ([] (. function instructions) instruction) opcode) .b))
      no-id
    )
    (case? (or (== name no-string) (== name (. ([] (. function blocks) block) name)))
      no-id
    )
    (default
      (call (. builder get-block) name)
    )
    (where
      (lazy instruction (call single-real function block))
      (lazy name (call label-name function (call first-operand function instruction)))
    )
  )
  (fn-do _ remove-trivial-blocks Bool
    (let changed false)
    (let order (. function block-order))
    (let removed (call (of (. function arena allocate) Byte) (. function blocks length)))
    (for (in position (..< 1 (. order length)))
      (let block ([] order position))
      (let predecessors (. ([] (. function blocks) block) predecessors))
      (let successors (. ([] (. function blocks) block) successors))
      (if (or (== (. predecessors length) 0) (!= (. successors length) 1))
        (continue)
      )
      (let instruction (call single-real function block))
      (if (or (== instruction no-id) (!= (. ([] (. function instructions) instruction) opcode) .b))
        (continue)
      )
      (let name (. ([] (. function blocks) block) name))
      (let is-targeted true)
      (for (in index (..< 0 (. predecessors length)))
        (if (not (call has-explicit-branch-to function ([] predecessors index) name))
          (= is-targeted false)
          (break)
        )
      )
      (if (not is-targeted)
        (continue)
      )
      (let successor ([] successors 0))
      (let successor-name (. ([] (. function blocks) successor) name))
      (for (in index (..< 0 (. predecessors length)))
        (call rewrite-branch-label builder ([] predecessors index) name successor-name)
        (call replace-successor function ([] predecessors index) block successor)
      )
      (let dropped (. ([] (. function blocks) block) instructions))
      (for (in index (..< 0 (. dropped length)))
        (call (. function drop-uses) ([] dropped index))
      )
      (= ([] removed block) 1)
      (= changed true)
    )
    (blank)
    (if changed
      (let kept U32)
      (for (in position (..< 0 (. order length)))
        (if (== ([] removed ([] order position)) 0)
          (= ([] (. order data) kept) ([] order position))
          (+= kept 1)
        )
      )
      (= (. function block-order) (call IdList (. order data) kept (. order capacity)))
      (call repair-predecessors function)
    )
    (return changed)
  )
  (fn-do _ remove-branches-to-layout-successor Bool
    (let changed false)
    (let order (. function block-order))
    (for (in position (..< 1 (. order length)))
      (let block ([] order (- position 1)))
      (let last (call last-real function block))
      (if (or (== last no-id) (!= (. ([] (. function instructions) last) opcode) .b))
        (continue)
      )
      (let name (call label-name function (call first-operand function last)))
      (if (and (!= name no-string) (== name (. ([] (. function blocks) ([] order position)) name)))
        (call remove-instruction function block last)
        (= changed true)
      )
    )
    (return changed)
  )
  (fn-do _ merge-fallthrough-blocks Bool
    ; Joins each block to the one before it in the layout where that one is all that reaches it and
    ; it is all that one goes on to, so the passes that read one block at a time see them as one.
    (let changed false)
    (let order (. function block-order))
    (let arena (. function arena))
    (let removed (call (of (. arena allocate) Byte) (. function blocks length)))
    (let host ([] order 0))
    (for (in position (..< 1 (. order length)))
      (let block ([] order position))
      (let successors (. ([] (. function blocks) host) successors))
      (let predecessors (. ([] (. function blocks) block) predecessors))
      (if (or (!= (. successors length) 1) (!= ([] successors 0) block) other-entry)
        (= host block)
        (continue)
      )
      (lazy other-entry (or (!= (. predecessors length) 1) (!= ([] predecessors 0) host)))
      (let last (call last-real function host))
      (if (and (!= last no-id) (call is-branch-opcode (. ([] (. function instructions) last) opcode)))
        (if (!= (. ([] (. function instructions) last) opcode) .b)
          (= host block)
          (continue)
        )
        (call remove-instruction function host last)
      )
      (let joined (. ([] (. function blocks) host) instructions))
      (let moved (. ([] (. function blocks) block) instructions))
      (for (in index (..< 0 (. moved length)))
        (= joined (call (. joined appended) arena ([] moved index)))
      )
      (= (. ([] (. function blocks) host) instructions) joined)
      (= (. ([] (. function blocks) block) instructions) (call IdList))
      (= (. ([] (. function blocks) host) successors) (. ([] (. function blocks) block) successors))
      (= (. ([] (. function blocks) block) successors) (call IdList))
      (= ([] removed block) 1)
      (= changed true)
    )
    (blank)
    (if changed
      (let kept U32)
      (for (in position (..< 0 (. order length)))
        (if (== ([] removed ([] order position)) 0)
          (= ([] (. order data) kept) ([] order position))
          (+= kept 1)
        )
      )
      (= (. function block-order) (call IdList (. order data) kept (. order capacity)))
      (call repair-predecessors function)
    )
    (return changed)
  )
)

(type + MIRBranchFoldingPass
  ; Skips the blocks that register allocation leaves only branching on, once their copies turned
  ; out to be from a register to itself: a branch to one goes on to where the chain of them leads,
  ; and one that nothing reaches any longer is dropped. A block that still falls into one, names it
  ; or lists it in a jump table keeps it.
  (blank)
  (prop _ builder MIRBuilder)
  (prop _ function MIRFunction)
  (prop _ targets (of CPointer U32))
  (prop _ tabled (of CPointer Byte))
  (fn-do + This _
    (param builder MIRBuilder)
    (lazy function (. builder function))
  )
  (fn-do + run Bool
    (let arena (. function arena))
    (let order (. function block-order))
    (= targets (call (of (. arena allocate) U32) (. function blocks length)))
    (= tabled (call (of (. arena allocate) Byte) (. function blocks length)))
    (for (in table (..< 0 (. function jump-tables length)))
      (let labels (. ([] (. function jump-tables) table) labels))
      (for (in index (..< (. labels start) (. labels end)))
        (let target (call (. builder get-block) ([] (. function names) index)))
        (if (!= target no-id)
          (= ([] tabled target) 1)
        )
      )
    )
    (let changed false)
    (let sources (call new-id-list arena 4))
    (let finals (call new-id-list arena 4))
    (for (in position (..< 0 (. order length)))
      (let block ([] order position))
      (= sources (call IdList (. sources data) 0 (. sources capacity)))
      (= finals (call IdList (. finals data) 0 (. finals capacity)))
      (let instructions (. ([] (. function blocks) block) instructions))
      (for (in index (..< 0 (. instructions length)))
        (let id ([] instructions index))
        (if (not (call is-branch-opcode (. ([] (. function instructions) id) opcode)))
          (continue)
        )
        (let operands (. ([] (. function instructions) id) operands))
        (for (in entry (..< 0 (. operands length)))
          (let name (call label-name function ([] operands entry)))
          (if (== name no-string)
            (continue)
          )
          (let target (call (. builder get-block) name))
          (if (== target no-id)
            (continue)
          )
          (let resolved (call folded-target target))
          (if (== resolved target)
            (continue)
          )
          (= ([] (. operands data) entry) (call (. builder label) (. ([] (. function blocks) resolved) name)))
          (if (not (call includes sources target))
            (= sources (call (. sources appended) arena target))
            (= finals (call (. finals appended) arena resolved))
          )
          (= changed true)
        )
      )
      (let next (if-expr (< (+ position 1) (. order length)) ([] order (+ position 1)) no-id))
      (for (in index (..< 0 (. sources length)))
        (let source ([] sources index))
        (if (and (!= source next) (== ([] tabled source) 0) (not (call names-label block source-name)))
          (call replace-successor function block source ([] finals index))
          (else-if (not (call includes (. ([] (. function blocks) block) successors) ([] finals index)))
            (= (. ([] (. function blocks) block) successors)
              (call (. ([] (. function blocks) block) successors appended)
                (block
                  (arg arena)
                  (arg ([] finals index))
                )
              )
            )
          )
        )
        (lazy source-name (. ([] (. function blocks) source) name))
      )
    )
    (if changed
      (call repair-predecessors function)
      (call (. builder prune-unreachable-blocks))
    )
    (return changed)
  )
  (fn-do _ names-label Bool
    (param block BlockId)
    (param name StringId)
    (let instructions (. ([] (. function blocks) block) instructions))
    (for (in index (..< 0 (. instructions length)))
      (let operands (. ([] (. function instructions) ([] instructions index)) operands))
      (for (in entry (..< 0 (. operands length)))
        (if (== (call label-name function ([] operands entry)) name)
          (return true)
        )
      )
    )
    (return false)
  )
  (fn-do _ folded-target BlockId
    (param block BlockId)
    (if (!= ([] targets block) 0)
      (return (- ([] targets block) 1))
    )
    (let current block)
    (for (in _ (..< 0 8))
      (let successor (call branch-only-successor current))
      (if (or (== successor no-id) (== successor block))
        (break)
      )
      (= current successor)
    )
    (= ([] targets block) (+ current 1))
    (return current)
  )
  (fn-expr _ branch-only-successor BlockId
    (param block BlockId)
    (case? (== block ([] (. function block-order) 0))
      no-id
    )
    (case? (or (== instruction no-id) (not (call is-plain-branch function instruction)))
      no-id
    )
    (case? (or (!= (. successors length) 1) (!= target (. ([] (. function blocks) ([] successors 0)) name)))
      no-id
    )
    (default
      ([] successors 0)
    )
    (where
      (lazy instruction (call single-real function block))
      (lazy successors (. ([] (. function blocks) block) successors))
      (lazy target (call label-name function (call first-operand function instruction)))
    )
  )
)

(type + MIRAddressFoldingPass
  ; Folds into each load and store the arithmetic that only makes its address. An address that adds
  ; a register is indexed by it, scaled by the access's size where a shift by that size made the
  ; index; one that adds a constant or a page offset takes it as its offset; and a copy that only
  ; names its base or its index is read through. Each instruction folded made a register the access
  ; alone read, and goes, so it must be the nearest writer of that register in the access's block,
  ; with what it read unchanged up to the access. A root is only replaced by a root.
  (blank)
  (prop _ builder MIRBuilder)
  (prop _ function MIRFunction)
  (prop _ removed (of CPointer Byte))
  (fn-do + This _
    (param builder MIRBuilder)
    (lazy function (. builder function))
  )
  (fn-do + run Bool
    (call (. function count-uses))
    (= removed (call (of (. function arena allocate) Byte) (. function instructions length)))
    (let changed false)
    (let order (. function block-order))
    (for (in position (..< 0 (. order length)))
      (let block ([] order position))
      (let instructions (. ([] (. function blocks) block) instructions))
      (let folded false)
      (for (in index (..< 0 (. instructions length)))
        (if (call fold-access instructions index)
          (= folded true)
        )
      )
      (if (not folded)
        (continue)
      )
      (= changed true)
      (let kept U32)
      (for (in index (..< 0 (. instructions length)))
        (if (== ([] removed ([] instructions index)) 0)
          (= ([] (. instructions data) kept) ([] instructions index))
          (+= kept 1)
        )
      )
      (= (. ([] (. function blocks) block) instructions) (call IdList (. instructions data) kept (. instructions capacity)))
    )
    (return changed)
  )
  (fn-do _ fold-access Bool
    (param instructions IdList)
    (param index U32)
    (let id ([] instructions index))
    (if (!= ([] removed id) 0)
      (return false)
    )
    (let size (call access-bytes id))
    (if (== size 0)
      (return false)
    )
    (let operands (. ([] (. function instructions) id) operands))
    (let changed false)
    (for (in _ (..< 0 6))
      (let folded (call fold-address instructions index ([] operands 1) size))
      (if (== folded no-operand)
        (break)
      )
      (call (. function drop-uses) id)
      (= ([] (. operands data) 1) folded)
      (call (. function add-uses) id)
      (= changed true)
    )
    (return changed)
  )
  (fn-expr _ access-bytes I64
    (param id InstructionId)
    (case? (!= (. operands length) 2)
      0
    )
    (case? (or (== opcode .ldrb) (== opcode .strb))
      1
    )
    (case? (or (== opcode .ldrh) (== opcode .strh))
      2
    )
    (case? (== opcode .ldrsw)
      4
    )
    (case? (and (!= opcode .ldr) (!= opcode .str))
      0
    )
    (case? (== row no-id)
      0
    )
    (case? (or (== reg-class .gpr32) (== reg-class .fpr32))
      4
    )
    (default
      8
    )
    (where
      (lazy opcode (. ([] (. function instructions) id) opcode))
      (lazy operands (. ([] (. function instructions) id) operands))
      (lazy row (call vreg-row function ([] operands 0)))
      (lazy reg-class (. ([] (. function vregs) row) reg-class))
    )
  )
  (fn-do _ fold-address OperandId
    (param instructions IdList)
    (param index U32)
    (param address OperandId)
    (param size I64)
    (let base no-operand)
    (let offset no-operand)
    (let index-shift U32)
    (let is-plain false)
    (match? ([] (. function operands) address)
      (case (call .load-address-operand row)
        (= is-plain (not (. row is-pre-index)))
        (= base (. row base))
        (= offset (. row offset))
        (= index-shift (. row index-shift))
      )
    )
    (if (or (not is-plain) (not (call is-wide-register base)))
      (return no-operand)
    )
    (let has-index (call is-wide-register offset))
    (if (and (not has-index) (call is-zero-offset offset))
      (let found (call sum-definer instructions index base))
      (if (!= found no-id)
        (let definer ([] instructions found))
        (let left ([] (. ([] (. function instructions) definer) operands) 1))
        (let right ([] (. ([] (. function instructions) definer) operands) 2))
        (if (call is-wide-register right)
          (if (call keeps-root base left)
            (return (call folded definer (call (. builder load-address) left right)))
          )
          (if (call keeps-root base right)
            (return (call folded definer (call (. builder load-address) right left)))
          )
          (else-if (and (call fits-offset right size) (call keeps-root base left))
            (return (call folded definer (call (. builder load-address) left right)))
          )
        )
      )
    )
    (let base-found (call copy-definer instructions index base))
    (if (!= base-found no-id)
      (let source ([] (. ([] (. function instructions) ([] instructions base-found)) operands) 1))
      (return (call folded ([] instructions base-found) (call (. builder load-address) source offset false index-shift)))
    )
    (if (not has-index)
      (return no-operand)
    )
    (if (and (== index-shift 0) (> size 1))
      (let shift-found (call shift-definer instructions index offset size))
      (if (!= shift-found no-id)
        (let shifted ([] (. ([] (. function instructions) ([] instructions shift-found)) operands) 1))
        (return
          (call folded
            (block
              (arg ([] instructions shift-found))
              (arg (call (. builder load-address) base shifted false (as (call log2 (as size U64)) U32)))
            )
          )
        )
      )
    )
    (let index-found (call copy-definer instructions index offset))
    (if (!= index-found no-id)
      (let source ([] (. ([] (. function instructions) ([] instructions index-found)) operands) 1))
      (return (call folded ([] instructions index-found) (call (. builder load-address) base source false index-shift)))
    )
    (return no-operand)
  )
  (fn-expr _ sum-definer U32
    (param instructions IdList)
    (param index U32)
    (param register OperandId)
    (case? (== found no-id)
      no-id
    )
    (case? (or not-add (!= (. operands length) 3) (not (call is-wide-register ([] operands 0))))
      no-id
    )
    (case? (or (not (call is-only-reader function vreg definer)) (not (call is-wide-register ([] operands 1))) (not base-intact))
      no-id
    )
    (case? (and (call is-wide-register ([] operands 2)) (not offset-intact))
      no-id
    )
    (default
      found
    )
    (where
      (lazy vreg (call vreg-id function register))
      (lazy found (call nearest-writer function removed instructions index vreg))
      (lazy definer ([] instructions found))
      (lazy operands (. ([] (. function instructions) definer) operands))
      (lazy not-add (!= (. ([] (. function instructions) definer) opcode) .add))
      (lazy base-intact (call holds-between function removed instructions found index ([] operands 1)))
      (lazy offset-intact (call holds-between function removed instructions found index ([] operands 2)))
    )
  )
  (fn-expr _ copy-definer U32
    (param instructions IdList)
    (param index U32)
    (param register OperandId)
    (case? (== found no-id)
      no-id
    )
    (case? (or (!= (. ([] (. function instructions) definer) opcode) .mov) phi-copy (!= (. operands length) 2))
      no-id
    )
    (case? (or (not (call is-wide-register ([] operands 0))) (not (call is-wide-register ([] operands 1))) self-copy)
      no-id
    )
    (case? (or (not (call is-only-reader function vreg definer)) (not (call keeps-root register ([] operands 1))) (not intact))
      no-id
    )
    (default
      found
    )
    (where
      (lazy vreg (call vreg-id function register))
      (lazy found (call nearest-writer function removed instructions index vreg))
      (lazy definer ([] instructions found))
      (lazy operands (. ([] (. function instructions) definer) operands))
      (lazy phi-copy (. ([] (. function instructions) definer) is-phi-copy))
      (lazy self-copy (== (call vreg-id function ([] operands 1)) vreg))
      (lazy intact (call holds-between function removed instructions found index ([] operands 1)))
    )
  )
  (fn-expr _ shift-definer U32
    (param instructions IdList)
    (param index U32)
    (param register OperandId)
    (param size I64)
    (case? (== found no-id)
      no-id
    )
    (case? (or not-lsl (!= (. operands length) 3) not-wide)
      no-id
    )
    (case? (or (not (. amount is-known)) (. amount is-negative) (!= (. amount bits) (as (call log2 (as size U64)) U64)))
      no-id
    )
    (case? (or (not (call is-only-reader function vreg definer)) (not intact))
      no-id
    )
    (default
      found
    )
    (where
      (lazy vreg (call vreg-id function register))
      (lazy found (call nearest-writer function removed instructions index vreg))
      (lazy definer ([] instructions found))
      (lazy operands (. ([] (. function instructions) definer) operands))
      (lazy not-lsl (!= (. ([] (. function instructions) definer) opcode) .lsl))
      (lazy not-wide (or (not (call is-wide-register ([] operands 0))) (not (call is-wide-register ([] operands 1)))))
      (lazy intact (call holds-between function removed instructions found index ([] operands 1)))
      (lazy amount (call known-int function ([] operands 2)))
    )
  )
  (fn-expr _ keeps-root Bool
    (param replaced OperandId)
    (param replacement OperandId)
    (or (not (. ([] (. function vregs) (call vreg-row function replaced)) gc-root)) replacement-root)
    (where
      (lazy replacement-root (. ([] (. function vregs) (call vreg-row function replacement)) gc-root))
    )
  )
  (fn-expr _ is-wide-register Bool
    (param operand OperandId)
    (and (!= operand no-operand) (!= row no-id) (== (. ([] (. function vregs) row) reg-class) .gpr64) unhinted)
    (where
      (lazy row (call vreg-row function operand))
      (lazy unhinted (== (. ([] (. function vregs) row) hint) no-register))
    )
  )
  (fn-expr _ is-zero-offset Bool
    (param offset OperandId)
    (or (== offset no-operand) (and (. value is-known) (== (. value bits) 0)))
    (where
      (lazy value (call known-int function offset))
    )
  )
  (fn-do _ fits-offset Bool
    (param operand OperandId)
    (param size I64)
    (match? ([] (. function operands) operand)
      (case (call .int-operand row)
        (if (. row value is-negative)
          (return (>= (as (. row value bits) I64) -256))
        )
        (return
          (scope (or (<= (. row value bits) 255) (and (== (% (. row value bits) (as size U64)) 0) in-range))
            (lazy in-range (<= (/ (. row value bits) (as size U64)) 4095))
          )
        )
      )
      (case (call .label-operand label)
        (return
          (scope (and (== (. label reloc) .pageoff-reloc) aligned)
            (lazy aligned (or (== size 1) (>= (as (call (. builder bundle symbol-alignment) (. label name)) I64) size)))
          )
        )
      )
    )
    (return false)
  )
  (fn-do _ folded OperandId
    (param definer InstructionId)
    (param replacement OperandId)
    (= ([] removed definer) 1)
    (call (. function drop-uses) definer)
    (return replacement)
  )
)

(type + MIRInstructionCombiningPass
  ; Combines each instruction with the arithmetic that only makes one of its registers, where one
  ; AArch64 instruction does both: a product that a sum reads becomes MADD or MSUB; a shift by a
  ; constant that a sum, a bitwise operation or a comparison reads becomes its shifted register; a
  ; shift and a mask, or two shifts, become UBFX or SBFX; a field cleared and then filled from
  ; another register becomes BFI; a choice of one more than, the complement of or the negation of a
  ; register becomes CSINC, CSINV or CSNEG; a narrow load that a sign extension reads becomes a
  ; signed load; and a branch on one bit, on zero or on the sign becomes TBZ, TBNZ, CBZ or CBNZ. A
  ; division by a constant becomes a multiply by its reciprocal and shifts. As in address folding,
  ; each instruction folded is the nearest writer of its register in the reader's block, read by
  ; nothing else, with what it read unchanged up to the reader.
  (blank)
  (prop _ builder MIRBuilder)
  (prop _ function MIRFunction)
  (prop _ removed (of CPointer Byte))
  (prop _ definitions (of CPointer U32))
  (prop _ definers (of CPointer U32))
  (prop _ prefixes (of CPointer IdList))
  (prop _ vreg-limit U32)
  (prop _ instruction-limit U32)
  (fn-do + This _
    (param builder MIRBuilder)
    (lazy function (. builder function))
  )
  (fn-do + run Bool
    (let arena (. function arena))
    (= vreg-limit (. function vreg-count))
    (= instruction-limit (as (. function instructions length) U32))
    (call (. function count-uses))
    (= removed (call (of (. arena allocate) Byte) instruction-limit))
    (= prefixes (call (of (. arena allocate) IdList) instruction-limit))
    (= definitions (call (of (. arena allocate) U32) vreg-limit))
    (= definers (call (of (. arena allocate) U32) vreg-limit))
    (let order (. function block-order))
    (for (in position (..< 0 (. order length)))
      (let instructions (. ([] (. function blocks) ([] order position)) instructions))
      (for (in index (..< 0 (. instructions length)))
        (call note-definitions ([] instructions index))
      )
    )
    (let changed false)
    (for (in position (..< 0 (. order length)))
      (let block ([] order position))
      (let instructions (. ([] (. function blocks) block) instructions))
      (let combined false)
      (for (in index (..< 0 (. instructions length)))
        (if (call combine instructions index)
          (= combined true)
        )
      )
      (if combined
        (= changed true)
        (call rebuild block)
      )
    )
    (return changed)
  )
  (fn-do _ note-definitions _
    (param id InstructionId)
    (let roles (call (. function operand-roles) id))
    (let operands (. ([] (. function instructions) id) operands))
    (for (in position (..< 0 (. operands length)))
      (if (== (/and/ (call role-at roles position) def-role) 0)
        (continue)
      )
      (match? ([] (. function operands) ([] operands position))
        (case (call .vreg-operand row)
          (let vreg (. ([] (. function vregs) (. row vreg)) id))
          (= ([] definitions vreg) (+ ([] definitions vreg) 1))
          (= ([] definers vreg) id)
        )
        (case (call .vreg-group-operand group)
          (for (in index (..< (. group vregs start) (. group vregs end)))
            (let vreg (. ([] (. function vregs) ([] (. function group-vregs) index)) id))
            (= ([] definitions vreg) (+ ([] definitions vreg) 1))
          )
        )
        (case (call .load-address-operand address)
          (let base (call vreg-id function (. address base)))
          (if (!= base no-id)
            (= ([] definitions base) (+ ([] definitions base) 1))
          )
        )
      )
    )
  )
  (fn-do _ combine Bool
    (param instructions IdList)
    (param index U32)
    (let id ([] instructions index))
    (if (!= ([] removed id) 0)
      (return false)
    )
    (let is-assembly false)
    (match? ([] (. function instructions) id)
      (case .assembly-instruction
        (= is-assembly true)
      )
    )
    (if (not is-assembly)
      (return false)
    )
    (let opcode (. ([] (. function instructions) id) opcode))
    (let operands (. ([] (. function instructions) id) operands))
    (let count (. operands length))
    (if (and (or (== opcode .udiv) (== opcode .sdiv)) (== count 3))
      (return (call divide id opcode operands))
    )
    (if (and (or (== opcode .add) (== opcode .sub)) (== count 3))
      (return (call combine-sum instructions index id opcode operands))
    )
    (if (and (or (== opcode .and) (== opcode .orr) (== opcode .eor)) (== count 3))
      (return (call combine-logical instructions index id opcode operands))
    )
    (if (and (or (== opcode .lsr) (== opcode .asr)) (== count 3))
      (return (call combine-shifts instructions index id opcode operands))
    )
    (if (and (== opcode .cmp) (== count 2))
      (return (call combine-compare instructions index id operands))
    )
    (if (and (== opcode .csel) (== count 4))
      (return (call combine-select instructions index id operands))
    )
    (if (and (or (== opcode .sxtb) (== opcode .sxth) (== opcode .sxtw)) (== count 2))
      (return (call combine-extension instructions index id opcode operands))
    )
    (if (and (or (== opcode .cbz) (== opcode .cbnz)) (== count 2))
      (return (call combine-bit-test instructions index id opcode operands))
    )
    (if (and (== opcode .b-cond) (== count 2))
      (return (call combine-zero-test instructions index id operands))
    )
    (return false)
  )
  (fn-do _ combine-sum Bool
    (param instructions IdList)
    (param index U32)
    (param id InstructionId)
    (param opcode Opcode)
    (param operands IdList)
    (let dest ([] operands 0))
    (let left ([] operands 1))
    (let right ([] operands 2))
    (if (or (not (call is-integer-register dest)) (not (call same-class dest left)) (not (call same-class dest right)))
      (return false)
    )
    (let arena (. function arena))
    (let is-add (== opcode .add))
    (let product (call product-definer instructions index right))
    (if (!= product no-id)
      (let factors (. ([] (. function instructions) ([] instructions product)) operands))
      (call absorb instructions product)
      (call rewrite-assembly
        (block
          (arg function)
          (arg id)
          (arg (if-expr is-add (. Opcode madd) (. Opcode msub)))
          (arg (call quad arena dest ([] factors 1) ([] factors 2) left))
        )
      )
      (return true)
    )
    (if is-add
      (= product (call product-definer instructions index left))
      (if (!= product no-id)
        (let factors (. ([] (. function instructions) ([] instructions product)) operands))
        (call absorb instructions product)
        (call rewrite-assembly function id .madd (call quad arena dest ([] factors 1) ([] factors 2) right))
        (return true)
      )
    )
    (let shifted (call shift-definer instructions index right))
    (if (!= shifted no-id)
      (return (call shift-into instructions shifted id opcode dest left right))
    )
    (if is-add
      (= shifted (call shift-definer instructions index left))
      (if (!= shifted no-id)
        (return (call shift-into instructions shifted id opcode dest right left))
      )
    )
    (return false)
  )
  (fn-do _ combine-logical Bool
    (param instructions IdList)
    (param index U32)
    (param id InstructionId)
    (param opcode Opcode)
    (param operands IdList)
    (let dest ([] operands 0))
    (let left ([] operands 1))
    (let right ([] operands 2))
    (if (or (not (call is-integer-register dest)) (not (call same-class dest left)))
      (return false)
    )
    (let mask (call known-int function right))
    (if (. mask is-known)
      (if (== opcode .and)
        (return (call extract-field instructions index id dest left (. mask bits)))
      )
      (return false)
    )
    (if (not (call same-class dest right))
      (return false)
    )
    (if (and (== opcode .orr) (or (call insert-field instructions index id dest left right) (call insert-field instructions index id dest right left)))
      (return true)
    )
    (let shifted (call shift-definer instructions index right))
    (if (!= shifted no-id)
      (return (call shift-into instructions shifted id opcode dest left right))
    )
    (= shifted (call shift-definer instructions index left))
    (if (!= shifted no-id)
      (return (call shift-into instructions shifted id opcode dest right left))
    )
    (return false)
  )
  (fn-do _ combine-shifts Bool
    (param instructions IdList)
    (param index U32)
    (param id InstructionId)
    (param opcode Opcode)
    (param operands IdList)
    (let dest ([] operands 0))
    (let source ([] operands 1))
    (if (or (not (call is-integer-register dest)) (not (call same-class dest source)))
      (return false)
    )
    (let width (call register-width dest))
    (let amount (call known-int function ([] operands 2)))
    (if (or (not (. amount is-known)) (. amount is-negative) (== (. amount bits) 0) (>= (. amount bits) width))
      (return false)
    )
    (let found (call shift-definer instructions index source))
    (if (or (== found no-id) (!= (. ([] (. function instructions) ([] instructions found)) opcode) .lsl))
      (return false)
    )
    (let inner (. ([] (. function instructions) ([] instructions found)) operands))
    (let moved (. (call known-int function ([] inner 2)) bits))
    (if (> moved (. amount bits))
      (return false)
    )
    (call absorb instructions found)
    (let field (call (. builder small-int) (as (- width (. amount bits)) I64)))
    (call rewrite-assembly
      (block
        (arg function)
        (arg id)
        (arg (if-expr (== opcode .lsr) (. Opcode ubfx) (. Opcode sbfx)))
        (arg (call quad (. function arena) dest ([] inner 1) (call (. builder small-int) (as (- (. amount bits) moved) I64)) field))
      )
    )
    (return true)
  )
  (fn-do _ combine-compare Bool
    (param instructions IdList)
    (param index U32)
    (param id InstructionId)
    (param operands IdList)
    (let left ([] operands 0))
    (let right ([] operands 1))
    (if (or (not (call is-integer-register left)) (not (call same-class left right)))
      (return false)
    )
    (let found (call shift-definer instructions index right))
    (if (== found no-id)
      (return false)
    )
    (let shift (. ([] (. function instructions) ([] instructions found)) operands))
    (let kind (call shift-kind (. ([] (. function instructions) ([] instructions found)) opcode)))
    (let amount (as (. (call known-int function ([] shift 2)) bits) U32))
    (call absorb instructions found)
    (call rewrite-assembly
      (block
        (arg function)
        (arg id)
        (arg .cmp)
        (arg (call triple (. function arena) left ([] shift 1) (call (. builder add-operand) (call ShiftOperand kind amount))))
      )
    )
    (return true)
  )
  (fn-do _ combine-select Bool
    (param instructions IdList)
    (param index U32)
    (param id InstructionId)
    (param operands IdList)
    (let dest ([] operands 0))
    (let first ([] operands 1))
    (let second ([] operands 2))
    (let condition ([] operands 3))
    (if (or (not (call is-integer-register dest)) (not (call same-class dest first)) (not (call same-class dest second)))
      (return false)
    )
    (let arena (. function arena))
    (let reg-class (. ([] (. function vregs) (call vreg-row function dest)) reg-class))
    (let mask (call class-mask reg-class))
    (let zero (call (. builder preg) (if-expr (== reg-class .gpr64) zero-register zero-register-32)))
    (let inverse (call invert-condition builder condition))
    (let first-value (call constant-of first))
    (let second-value (call constant-of second))
    (let changed false)
    (if (and (. first-value is-known) (== (. first-value bits) 0))
      (= first zero)
      (= changed true)
    )
    (if (and (. second-value is-known) (== (. second-value bits) 0))
      (= second zero)
      (= changed true)
    )
    (if (and (. second-value is-known) (== (. second-value bits) 1))
      (call rewrite-assembly function id .csinc (call quad arena dest first zero condition))
      (return true)
    )
    (if (and (. second-value is-known) (== (. second-value bits) mask))
      (call rewrite-assembly function id .csinv (call quad arena dest first zero condition))
      (return true)
    )
    (if (and (!= inverse no-operand) (. first-value is-known) (== (. first-value bits) 1))
      (call rewrite-assembly function id .csinc (call quad arena dest second zero inverse))
      (return true)
    )
    (if (and (!= inverse no-operand) (. first-value is-known) (== (. first-value bits) mask))
      (call rewrite-assembly function id .csinv (call quad arena dest second zero inverse))
      (return true)
    )
    (if (call select-from instructions index id dest first second condition)
      (return true)
    )
    (if (and (!= inverse no-operand) (call select-from instructions index id dest second first inverse))
      (return true)
    )
    (if changed
      (call rewrite-assembly function id .csel (call quad arena dest first second condition))
    )
    (return changed)
  )
  (fn-do _ select-from Bool
    (param instructions IdList)
    (param index U32)
    (param id InstructionId)
    (param dest OperandId)
    (param kept OperandId)
    (param made OperandId)
    (param condition OperandId)
    (if (== (call vreg-row function made) no-id)
      (return false)
    )
    (let found (call definer instructions index made))
    (if (== found no-id)
      (return false)
    )
    (let opcode (. ([] (. function instructions) ([] instructions found)) opcode))
    (let operands (. ([] (. function instructions) ([] instructions found)) operands))
    (let select (. Opcode csel))
    (if (and (== opcode .add) (== (. operands length) 3))
      (let step (call known-int function ([] operands 2)))
      (if (and (. step is-known) (not (. step is-negative)) (== (. step bits) 1))
        (= select .csinc)
      )
      (else-if (and (== opcode .mvn) (== (. operands length) 2))
        (= select .csinv)
      )
      (else-if (and (== opcode .neg) (== (. operands length) 2))
        (= select .csneg)
      )
    )
    (if (or (== select .csel) (not (call same-class dest ([] operands 1))))
      (return false)
    )
    (call absorb instructions found)
    (call rewrite-assembly function id select (call quad (. function arena) dest kept ([] operands 1) condition))
    (return true)
  )
  (fn-do _ combine-extension Bool
    (param instructions IdList)
    (param index U32)
    (param id InstructionId)
    (param opcode Opcode)
    (param operands IdList)
    (let dest ([] operands 0))
    (let source ([] operands 1))
    (let dest-row (call vreg-row function dest))
    (if (or (== dest-row no-id) hinted (. ([] (. function vregs) dest-row) gc-root) (not (call is-integer-register dest)))
      (return false)
    )
    (lazy hinted (!= (. ([] (. function vregs) dest-row) hint) no-register))
    (if (and (== opcode .sxtw) (!= (. ([] (. function vregs) dest-row) reg-class) .gpr64))
      (return false)
    )
    (let load (. Opcode ldrb))
    (let signed (. Opcode ldrsb))
    (if (== opcode .sxth)
      (= load .ldrh)
      (= signed .ldrsh)
      (else-if (== opcode .sxtw)
        (= load .ldr)
        (= signed .ldrsw)
      )
    )
    (let found (call definer instructions index source))
    (if (== found no-id)
      (return false)
    )
    (let loaded ([] instructions found))
    (let loaded-operands (. ([] (. function instructions) loaded) operands))
    (if (or (!= (. ([] (. function instructions) loaded) opcode) load) (!= (. loaded-operands length) 2))
      (return false)
    )
    (if (and (== opcode .sxtw) (!= (. ([] (. function vregs) (call vreg-row function ([] loaded-operands 0))) reg-class) .gpr32))
      (return false)
    )
    (let vreg (. ([] (. function vregs) dest-row) id))
    (for (in position (..< (+ found 1) index))
      (let passed ([] instructions position))
      (if (and (== ([] removed passed) 0) (or (call writes-vreg function passed vreg) (call reads-vreg passed vreg)))
        (return false)
      )
    )
    (= ([] (. loaded-operands data) 0) dest)
    (call rewrite-assembly function loaded signed loaded-operands)
    (= ([] removed id) 1)
    (call (. function drop-uses) id)
    (return true)
  )
  (fn-do _ combine-bit-test Bool
    (param instructions IdList)
    (param index U32)
    (param id InstructionId)
    (param opcode Opcode)
    (param operands IdList)
    (let found (call definer instructions index ([] operands 0)))
    (if (or (== found no-id) (!= (. ([] (. function instructions) ([] instructions found)) opcode) .and))
      (return false)
    )
    (let masking (. ([] (. function instructions) ([] instructions found)) operands))
    (if (or (!= (. masking length) 3) (not (call is-integer-register ([] masking 1))))
      (return false)
    )
    (let mask (call known-int function ([] masking 2)))
    (if (or (not (. mask is-known)) (. mask is-negative) (not (call is-power-of-two (. mask bits))))
      (return false)
    )
    (let bit (call log2 (. mask bits)))
    (if (>= (as bit U64) (call register-width ([] masking 1)))
      (return false)
    )
    (call absorb instructions found)
    (call rewrite-assembly
      (block
        (arg function)
        (arg id)
        (arg (if-expr (== opcode .cbnz) (. Opcode tbnz) (. Opcode tbz)))
        (arg (call triple (. function arena) ([] masking 1) (call (. builder small-int) bit) ([] operands 1)))
      )
    )
    (return true)
  )
  (fn-do _ combine-zero-test Bool
    (param instructions IdList)
    (param index U32)
    (param id InstructionId)
    (param operands IdList)
    (let previous (call previous-real function instructions index))
    (if (or (== previous no-id) (!= ([] removed ([] instructions previous)) 0))
      (return false)
    )
    (let compare ([] instructions previous))
    (let compared (. ([] (. function instructions) compare) operands))
    (if (or not-cmp (!= (. compared length) 2) (not (call is-integer-register ([] compared 0))))
      (return false)
    )
    (lazy not-cmp (!= (. ([] (. function instructions) compare) opcode) .cmp))
    (let zero (call known-int function ([] compared 1)))
    (if (or (not (. zero is-known)) (!= (. zero bits) 0))
      (return false)
    )
    (let code (call condition-code function ([] operands 1)))
    (let source ([] compared 0))
    (let target ([] operands 0))
    (let arena (. function arena))
    (let sign (call (. builder small-int) (as (- (call register-width source) 1) I64)))
    (if (== code (. Condition equal))
      (call rewrite-assembly function id .cbz (call pair arena source target))
      (else-if (== code (. Condition unequal))
        (call rewrite-assembly function id .cbnz (call pair arena source target))
      )
      (else-if (or (== code (. Condition negative)) (== code (. Condition less)))
        (call rewrite-assembly function id .tbnz (call triple arena source sign target))
      )
      (else-if (or (== code (. Condition positive)) (== code (. Condition greater-equal)))
        (call rewrite-assembly function id .tbz (call triple arena source sign target))
      )
      (else
        (return false)
      )
    )
    (return true)
  )
  (fn-do _ extract-field Bool
    (param instructions IdList)
    (param index U32)
    (param id InstructionId)
    (param dest OperandId)
    (param source OperandId)
    (param mask U64)
    (let width (call register-width dest))
    (if (or (== mask 0) (not (call is-power-of-two (+ mask 1))))
      (return false)
    )
    (let field (as (call log2 (+ mask 1)) U64))
    (if (>= field width)
      (return false)
    )
    (let found (call shift-definer instructions index source))
    (if (or (== found no-id) (== (. ([] (. function instructions) ([] instructions found)) opcode) .lsl))
      (return false)
    )
    (let shift (. ([] (. function instructions) ([] instructions found)) operands))
    (let lsb (. (call known-int function ([] shift 2)) bits))
    (if (> (+ lsb field) width)
      (return false)
    )
    (call absorb instructions found)
    (call rewrite-assembly
      (block
        (arg function)
        (arg id)
        (arg .ubfx)
        (arg
          (call quad
            (block
              (arg (. function arena))
              (arg dest)
              (arg ([] shift 1))
              (arg (call (. builder small-int) (as lsb I64)))
              (arg (call (. builder small-int) (as field I64)))
            )
          )
        )
      )
    )
    (return true)
  )
  (fn-do _ insert-field Bool
    (param instructions IdList)
    (param index U32)
    (param id InstructionId)
    (param dest OperandId)
    (param cleared OperandId)
    (param filled OperandId)
    (let width (call register-width dest))
    (let mask (call class-mask (. ([] (. function vregs) (call vreg-row function dest)) reg-class)))
    (let clearing (call definer instructions index cleared))
    (if (or (== clearing no-id) (!= (. ([] (. function instructions) ([] instructions clearing)) opcode) .and))
      (return false)
    )
    (let clear (. ([] (. function instructions) ([] instructions clearing)) operands))
    (let kept-bits (call known-int function ([] clear 2)))
    (if (or (not (. kept-bits is-known)) (not (call same-class dest ([] clear 1))))
      (return false)
    )
    (let filling (call definer instructions index filled))
    (if (== filling no-id)
      (return false)
    )
    (let fill-opcode (. ([] (. function instructions) ([] instructions filling)) opcode))
    (let fill (. ([] (. function instructions) ([] instructions filling)) operands))
    (let lsb U64)
    (let masked filled)
    (let masking filling)
    (if (and (== fill-opcode .lsl) (== (. fill length) 3))
      (let moved (call known-int function ([] fill 2)))
      (if (or (not (. moved is-known)) (. moved is-negative) (>= (. moved bits) width))
        (return false)
      )
      (= lsb (. moved bits))
      (= masked ([] fill 1))
      (= masking (call definer instructions filling masked))
      (if (== masking no-id)
        (return false)
      )
      (else-if (!= fill-opcode .and)
        (return false)
      )
    )
    (let field-operands (. ([] (. function instructions) ([] instructions masking)) operands))
    (if (or (!= (. ([] (. function instructions) ([] instructions masking)) opcode) .and) (!= (. field-operands length) 3))
      (return false)
    )
    (let field-mask (call known-int function ([] field-operands 2)))
    (if (or (not (. field-mask is-known)) (== (. field-mask bits) 0) (not (call is-power-of-two (+ (. field-mask bits) 1))))
      (return false)
    )
    (let field (as (call log2 (+ (. field-mask bits) 1)) U64))
    (let value ([] field-operands 1))
    (if (or (> (+ lsb field) width) (not (call same-class dest value)) same-vreg)
      (return false)
    )
    (lazy same-vreg (== (call vreg-id function dest) (call vreg-id function value)))
    (if (!= (/and/ (. kept-bits bits) mask) (/xor/ (/lshift/ (. field-mask bits) lsb) mask))
      (return false)
    )
    (if (not (call holds-between function removed instructions masking index value))
      (return false)
    )
    (let base ([] clear 1))
    (call absorb instructions clearing)
    (call absorb instructions filling)
    (if (!= masking filling)
      (call absorb instructions masking)
    )
    (if (!= (call vreg-id function dest) (call vreg-id function base))
      (call emit id (call (. builder new-assembly) .mov dest base))
    )
    (call rewrite-assembly
      (block
        (arg function)
        (arg id)
        (arg .bfi)
        (arg
          (call quad
            (block
              (arg (. function arena))
              (arg dest)
              (arg value)
              (arg (call (. builder small-int) (as lsb I64)))
              (arg (call (. builder small-int) (as field I64)))
            )
          )
        )
      )
    )
    (return true)
  )
  (fn-do _ shift-into Bool
    (param instructions IdList)
    (param found U32)
    (param id InstructionId)
    (param opcode Opcode)
    (param dest OperandId)
    (param kept OperandId)
    (param replaced OperandId)
    (let shift (. ([] (. function instructions) ([] instructions found)) operands))
    (let kind (call shift-kind (. ([] (. function instructions) ([] instructions found)) opcode)))
    (let amount (as (. (call known-int function ([] shift 2)) bits) U32))
    (call absorb instructions found)
    (call rewrite-assembly
      (block
        (arg function)
        (arg id)
        (arg opcode)
        (arg (call quad (. function arena) dest kept ([] shift 1) (call (. builder add-operand) (call ShiftOperand kind amount))))
      )
    )
    (return true)
  )
  (fn-expr _ product-definer U32
    (param instructions IdList)
    (param index U32)
    (param operand OperandId)
    (case? (== found no-id)
      no-id
    )
    (case? (or not-mul (!= (. operands length) 3) other-class)
      no-id
    )
    (default
      found
    )
    (where
      (lazy found (call definer instructions index operand))
      (lazy operands (. ([] (. function instructions) ([] instructions found)) operands))
      (lazy not-mul (!= (. ([] (. function instructions) ([] instructions found)) opcode) .mul))
      (lazy other-class (or (not (call same-class operand ([] operands 1))) (not (call same-class operand ([] operands 2)))))
    )
  )
  (fn-expr _ shift-definer U32
    (param instructions IdList)
    (param index U32)
    (param operand OperandId)
    (case? (== found no-id)
      no-id
    )
    (case? (or not-shift (!= (. operands length) 3) (not (call same-class operand ([] operands 1))))
      no-id
    )
    (case? (or (not (. amount is-known)) (. amount is-negative) (== (. amount bits) 0) too-wide)
      no-id
    )
    (default
      found
    )
    (where
      (lazy found (call definer instructions index operand))
      (lazy operands (. ([] (. function instructions) ([] instructions found)) operands))
      (lazy amount (call known-int function ([] operands 2)))
      (lazy not-shift (== (call shift-kind (. ([] (. function instructions) ([] instructions found)) opcode)) no-id))
      (lazy too-wide (>= (. amount bits) (call register-width operand)))
    )
  )
  (fn-do _ definer U32
    (param instructions IdList)
    (param index U32)
    (param operand OperandId)
    (let row (call vreg-row function operand))
    (if (or (== row no-id) (. ([] (. function vregs) row) gc-root))
      (return no-id)
    )
    (let vreg (. ([] (. function vregs) row) id))
    (if (>= vreg vreg-limit)
      (return no-id)
    )
    (let found (call nearest-writer function removed instructions index vreg))
    (if (== found no-id)
      (return no-id)
    )
    (let id ([] instructions found))
    (let is-assembly false)
    (match? ([] (. function instructions) id)
      (case .assembly-instruction
        (= is-assembly true)
      )
    )
    (if (or (not is-assembly) (. ([] (. function instructions) id) is-phi-copy) (>= id instruction-limit))
      (return no-id)
    )
    (let operands (. ([] (. function instructions) id) operands))
    (if (== (. operands length) 0)
      (return no-id)
    )
    (let defined (call vreg-row function ([] operands 0)))
    (if (or (== defined no-id) (!= (. ([] (. function vregs) defined) id) vreg) other-class)
      (return no-id)
    )
    (lazy other-class (!= (. ([] (. function vregs) defined) reg-class) (. ([] (. function vregs) row) reg-class)))
    (if (or hinted (. ([] (. function vregs) defined) gc-root) (not (call is-only-reader function vreg id)))
      (return no-id)
    )
    (lazy hinted (!= (. ([] (. function vregs) defined) hint) no-register))
    (let roles (call (. function operand-roles) id))
    (for (in position (..< 1 (. operands length)))
      (if (and is-use (!= (call vreg-id function ([] operands position)) no-id) (not intact))
        (return no-id)
      )
      (lazy is-use (!= (/and/ (call role-at roles position) use-role) 0))
      (lazy intact (call holds-between function removed instructions found index ([] operands position)))
    )
    (return found)
  )
  (fn-do _ absorb _
    (param instructions IdList)
    (param found U32)
    (= ([] removed ([] instructions found)) 1)
    (call (. function drop-uses) ([] instructions found))
  )
  (fn-do _ reads-vreg Bool
    (param id InstructionId)
    (param vreg U32)
    (let roles (call (. function operand-roles) id))
    (let operands (. ([] (. function instructions) id) operands))
    (for (in position (..< 0 (. operands length)))
      (if (and (!= (/and/ (call role-at roles position) use-role) 0) (call reads-operand ([] operands position) vreg))
        (return true)
      )
    )
    (return false)
  )
  (fn-do _ reads-operand Bool
    (param operand OperandId)
    (param vreg U32)
    (if (== operand no-operand)
      (return false)
    )
    (match? ([] (. function operands) operand)
      (case (call .vreg-operand row)
        (return (== (. ([] (. function vregs) (. row vreg)) id) vreg))
      )
      (case (call .vreg-group-operand group)
        (for (in index (..< (. group vregs start) (. group vregs end)))
          (if (== (. ([] (. function vregs) ([] (. function group-vregs) index)) id) vreg)
            (return true)
          )
        )
      )
      (case (call .load-address-operand address)
        (return (or (call reads-operand (. address base) vreg) (call reads-operand (. address offset) vreg)))
      )
    )
    (return false)
  )
  (fn-do _ constant-of Known
    (param operand OperandId)
    (let row (call vreg-row function operand))
    (if (== row no-id)
      (return (call Known))
    )
    (let vreg (. ([] (. function vregs) row) id))
    (if (or (>= vreg vreg-limit) (!= ([] definitions vreg) 1))
      (return (call Known))
    )
    (let definer ([] definers vreg))
    (let opcode (. ([] (. function instructions) definer) opcode))
    (let operands (. ([] (. function instructions) definer) operands))
    (let defined (call vreg-row function ([] operands 0)))
    (if (== defined no-id)
      (return (call Known))
    )
    (let mask
      (scope (/and/ (call class-mask (. ([] (. function vregs) defined) reg-class)) row-mask)
        (lazy row-mask (call class-mask (. ([] (. function vregs) row) reg-class)))
      )
    )
    (if (== mask 0)
      (return (call Known))
    )
    (if (and (or (== opcode .movz) (== opcode .movn)) (>= (. operands length) 2))
      (let value (call known-int function ([] operands 1)))
      (let shift (call Known true 0 false))
      (if (> (. operands length) 2)
        (= shift (call known-int function ([] operands 2)))
      )
      (if (or (not (. value is-known)) (not (. shift is-known)) (> (. shift bits) 48))
        (return (call Known))
      )
      (let bits (/lshift/ (. value bits) (as (. shift bits) U32)))
      (if (== opcode .movn)
        (= bits (/xor/ bits all-bits))
      )
      (return (call Known true (/and/ bits mask) false))
    )
    (if (and (== opcode .mov) (== (. operands length) 2))
      (let value (call known-int function ([] operands 1)))
      (if (. value is-known)
        (return (call Known true (/and/ (. value bits) mask) false))
      )
    )
    (return (call Known))
  )
  (fn-do _ divide Bool
    (param id InstructionId)
    (param opcode Opcode)
    (param operands IdList)
    (let dest ([] operands 0))
    (let dividend ([] operands 1))
    (if (or (not (call is-integer-register dest)) (not (call same-class dest dividend)))
      (return false)
    )
    (let divisor (call constant-of ([] operands 2)))
    (if (not (. divisor is-known))
      (return false)
    )
    (let reg-class (. ([] (. function vregs) (call vreg-row function dest)) reg-class))
    (let bits U32 (if-expr (== reg-class .gpr64) 64 32))
    (if (== opcode .udiv)
      (return (call divide-unsigned id reg-class dest dividend (. divisor bits) bits))
    )
    (return (call divide-signed id reg-class dest dividend (as (call sign-extended (. divisor bits) bits) I64) bits))
  )
  (fn-do _ divide-unsigned Bool
    (param id InstructionId)
    (param reg-class RegClass)
    (param dest OperandId)
    (param dividend OperandId)
    (param divisor U64)
    (param bits U32)
    (if (or (< divisor 3) (call is-power-of-two divisor) (>= divisor (/lshift/ 1u64 (- bits 1))))
      (return false)
    )
    (let magic (call unsigned-magic divisor bits))
    (let multiplier (call constant-register id (. magic multiplier) reg-class))
    (let high (call (. builder vreg) .gpr64))
    (let top high)
    (if (== bits 64)
      (call emit id (call (. builder new-assembly) .umulh high dividend multiplier))
      (else
        (let product (call (. builder vreg) .gpr64))
        (call emit id (call (. builder new-assembly) .umull product dividend multiplier))
        (if (not (. magic adds))
          (call emit id (call (. builder new-assembly) .lsr high product (call (. builder small-int) (+ 32 (. magic shift)))))
          (call rewrite-assembly function id .mov (call pair (. function arena) dest (call (. builder narrow-view) high)))
          (return true)
        )
        (call emit id (call (. builder new-assembly) .lsr high product (call (. builder small-int) 32)))
        (= top (call (. builder narrow-view) high))
      )
    )
    (if (not (. magic adds))
      (call finish-shift id .lsr dest top (. magic shift))
      (return true)
    )
    (let difference (call (. builder vreg) reg-class))
    (call emit id (call (. builder new-assembly) .sub difference dividend top))
    (let sum (call (. builder vreg) reg-class))
    (call emit
      (block
        (arg id)
        (arg
          (call (. builder new-assembly)
            (block
              (arg .add)
              (arg sum)
              (arg top)
              (arg difference)
              (arg (call (. builder add-operand) (call ShiftOperand (. MIRShift right) 1)))
            )
          )
        )
      )
    )
    (call finish-shift id .lsr dest sum (- (. magic shift) 1))
    (return true)
  )
  (fn-do _ divide-signed Bool
    (param id InstructionId)
    (param reg-class RegClass)
    (param dest OperandId)
    (param dividend OperandId)
    (param divisor I64)
    (param bits U32)
    (let magnitude (as divisor U64))
    (if (< divisor 0)
      (= magnitude (as (- 0 divisor) U64))
    )
    (if (or (< magnitude 3) (call is-power-of-two magnitude) (> magnitude 0x40000000))
      (return false)
    )
    (let magic (call signed-magic divisor bits))
    (let is-negative (!= (/and/ (/zrshift/ (. magic multiplier) (- bits 1)) 1) 0))
    (let corrects (or (and (> divisor 0) is-negative) (and (< divisor 0) (not is-negative))))
    (let multiplier (call constant-register id (. magic multiplier) reg-class))
    (let high (call (. builder vreg) .gpr64))
    (let top high)
    (if (== bits 64)
      (call emit id (call (. builder new-assembly) .smulh high dividend multiplier))
      (else
        (let product (call (. builder vreg) .gpr64))
        (call emit id (call (. builder new-assembly) .smull product dividend multiplier))
        (if (not corrects)
          (call emit id (call (. builder new-assembly) .asr high product (call (. builder small-int) (+ 32 (. magic shift)))))
          (let quotient (call (. builder narrow-view) high))
          (call rewrite-assembly
            (block
              (arg function)
              (arg id)
              (arg .add)
              (arg
                (call quad
                  (block
                    (arg (. function arena))
                    (arg dest)
                    (arg quotient)
                    (arg quotient)
                    (arg (call (. builder add-operand) (call ShiftOperand (. MIRShift right) 31)))
                  )
                )
              )
            )
          )
          (return true)
        )
        (call emit id (call (. builder new-assembly) .asr high product (call (. builder small-int) 32)))
        (= top (call (. builder narrow-view) high))
      )
    )
    (let adjusted top)
    (if corrects
      (= adjusted (call (. builder vreg) reg-class))
      (call emit
        (block
          (arg id)
          (arg
            (call (. builder new-assembly)
              (block
                (arg (if-expr (> divisor 0) (. Opcode add) (. Opcode sub)))
                (arg adjusted)
                (arg top)
                (arg dividend)
              )
            )
          )
        )
      )
    )
    (let shifted adjusted)
    (if (> (. magic shift) 0)
      (= shifted (call (. builder vreg) reg-class))
      (call emit id (call (. builder new-assembly) .asr shifted adjusted (call (. builder small-int) (. magic shift))))
    )
    (call rewrite-assembly
      (block
        (arg function)
        (arg id)
        (arg .add)
        (arg
          (call quad
            (block
              (arg (. function arena))
              (arg dest)
              (arg shifted)
              (arg shifted)
              (arg (call (. builder add-operand) (call ShiftOperand (. MIRShift right) (- bits 1))))
            )
          )
        )
      )
    )
    (return true)
  )
  (fn-do _ finish-shift _
    (param id InstructionId)
    (param opcode Opcode)
    (param dest OperandId)
    (param source OperandId)
    (param amount U32)
    (if (== amount 0)
      (call rewrite-assembly function id .mov (call pair (. function arena) dest source))
      (else
        (call rewrite-assembly
          (block
            (arg function)
            (arg id)
            (arg opcode)
            (arg (call triple (. function arena) dest source (call (. builder small-int) amount)))
          )
        )
      )
    )
  )
  (fn-do _ constant-register OperandId
    (param id InstructionId)
    (param value U64)
    (param reg-class RegClass)
    (let width U32 (if-expr (== reg-class .gpr64) 64 32))
    (let masked (/and/ value (call class-mask reg-class)))
    (let register (call (. builder vreg) reg-class))
    (if (or (. (call encode-move-wide-immediate masked width) is-encodable) encodes-logical)
      (call emit id (call (. builder new-assembly) .mov register (call (. builder small-int) (as masked I64))))
      (return register)
    )
    (lazy encodes-logical (. (call encode-logical-immediate masked width) is-encodable))
    (let count (/ width 16))
    (let zeros U32)
    (let ones U32)
    (for (in target (..< 0 count))
      (let chunk (/and/ (/zrshift/ masked (* target 16)) 0xffff))
      (if (== chunk 0)
        (+= zeros 1)
        (else-if (== chunk 0xffff)
          (+= ones 1)
        )
      )
      (for (in source (..< 0 count))
        (let filler (/and/ (/zrshift/ masked (* source 16)) 0xffff))
        (let candidate
          (scope (/or/ cleared (/lshift/ filler (* target 16)))
            (lazy cleared (/and/ masked (/xor/ (/lshift/ halfword-bits (* target 16)) all-bits)))
          )
        )
        (if (and (!= source target) (. (call encode-logical-immediate candidate width) is-encodable))
          (call emit id (call (. builder new-assembly) .mov register (call (. builder small-int) (as candidate I64))))
          (call emit
            (block
              (arg id)
              (arg
                (call (. builder new-assembly)
                  (block
                    (arg .movk)
                    (arg register)
                    (arg (call (. builder small-int) (as chunk I64)))
                    (arg (call (. builder small-int) (* target 16)))
                  )
                )
              )
            )
          )
          (return register)
        )
      )
    )
    (let is-inverted (> ones zeros))
    (let is-first true)
    (for (in halfword (..< 0 count))
      (let chunk (/and/ (/zrshift/ masked (* halfword 16)) 0xffff))
      (if (== chunk (if-expr is-inverted halfword-bits 0))
        (continue)
      )
      (let shift (call (. builder small-int) (* halfword 16)))
      (if (not is-first)
        (call emit id (call (. builder new-assembly) .movk register (call (. builder small-int) (as chunk I64)) shift))
        (else-if is-inverted
          (call emit
            (block
              (arg id)
              (arg
                (call (. builder new-assembly)
                  (block
                    (arg .movn)
                    (arg register)
                    (arg (call (. builder small-int) (as (/xor/ chunk 0xffff) I64)))
                    (arg shift)
                  )
                )
              )
            )
          )
        )
        (else
          (call emit id (call (. builder new-assembly) .movz register (call (. builder small-int) (as chunk I64)) shift))
        )
      )
      (= is-first false)
    )
    (return register)
  )
  (fn-do _ emit _
    (param id InstructionId)
    (param instruction InstructionId)
    (= ([] prefixes id) (call (. ([] prefixes id) appended) (. function arena) instruction))
    (call (. function add-uses) instruction)
  )
  (fn-do _ rebuild _
    (param block BlockId)
    (let arena (. function arena))
    (let instructions (. ([] (. function blocks) block) instructions))
    (let extra U32)
    (for (in index (..< 0 (. instructions length)))
      (let id ([] instructions index))
      (if (< id instruction-limit)
        (+= extra (. ([] prefixes id) length))
      )
    )
    (let rebuilt (call new-id-list arena (+ (. instructions length) extra)))
    (for (in index (..< 0 (. instructions length)))
      (let id ([] instructions index))
      (if (< id instruction-limit)
        (let leading ([] prefixes id))
        (for (in entry (..< 0 (. leading length)))
          (= rebuilt (call (. rebuilt appended) arena ([] leading entry)))
        )
        (if (!= ([] removed id) 0)
          (continue)
        )
      )
      (= rebuilt (call (. rebuilt appended) arena id))
    )
    (= (. ([] (. function blocks) block) instructions) rebuilt)
  )
  (fn-expr _ is-integer-register Bool
    (param operand OperandId)
    (and (!= row no-id) (or (== (. ([] (. function vregs) row) reg-class) .gpr32) (== (. ([] (. function vregs) row) reg-class) .gpr64)))
    (where
      (lazy row (call vreg-row function operand))
    )
  )
  (fn-expr _ same-class Bool
    (param first OperandId)
    (param second OperandId)
    (and (!= left no-id) (!= right no-id) (== (. ([] (. function vregs) left) reg-class) (. ([] (. function vregs) right) reg-class)))
    (where
      (lazy left (call vreg-row function first))
      (lazy right (call vreg-row function second))
    )
  )
  (fn-expr _ register-width U64
    (param operand OperandId)
    (if-expr (== (. ([] (. function vregs) (call vreg-row function operand)) reg-class) .gpr64) 64 32)
  )
)

(type _ DivisionMagic (is Tuple)
  (prop + multiplier U64)
  (prop + shift U32)
  (prop + adds Bool)
)

(type _ PowerQuotient (is Tuple)
  (prop + high U64)
  (prop + low U64)
  (prop + remainder U64)
)

(fn-do _ unsigned-magic DivisionMagic
  (param divisor U64)
  (param bits U32)
  ; The multiplier and shift that divide an unsigned number of `bits` bits by `divisor`. The
  ; smallest shift whose multiplier fits the register, and errs by no more than one part in two to
  ; the shift, needs no more; otherwise the multiplier is one bit wider, and the division adds the
  ; dividend back in halves.
  (let ceiling U32)
  (while (< (/lshift/ 1u64 ceiling) divisor)
    (+= ceiling 1)
  )
  (let limit (if-expr (== bits 64) all-bits low-word))
  (let shift U32)
  (while (< shift ceiling)
    (let quotient (call power-quotient (+ bits shift) divisor))
    (if (or (!= (. quotient high) 0) (>= (. quotient low) limit))
      (break)
    )
    (if (<= (- divisor (. quotient remainder)) (/lshift/ 1u64 shift))
      (return (call DivisionMagic (+ (. quotient low) 1) shift false))
    )
    (+= shift 1)
  )
  (let quotient (call power-quotient (+ bits ceiling) divisor))
  (return (call DivisionMagic (/and/ (+ (. quotient low) 1) limit) ceiling true))
)

(fn-do _ signed-magic DivisionMagic
  (param divisor I64)
  (param bits U32)
  ; The multiplier and shift that divide a signed number of `bits` bits by `divisor`, as Hacker's
  ; Delight finds them: the shift grows until the multiplier's error falls below what the largest
  ; dividend can notice.
  (let half (/lshift/ 1u64 (- bits 1)))
  (let magnitude (as divisor U64))
  (let bound half)
  (if (< divisor 0)
    (= magnitude (as (- 0 divisor) U64))
    (+= bound 1)
  )
  (let largest (- bound 1 (% bound magnitude)))
  (let power (- bits 1))
  (let first-quotient (/ half largest))
  (let first-remainder (- half (* first-quotient largest)))
  (let second-quotient (/ half magnitude))
  (let second-remainder (- half (* second-quotient magnitude)))
  (while true
    (+= power 1)
    (= first-quotient (* first-quotient 2))
    (= first-remainder (* first-remainder 2))
    (if (>= first-remainder largest)
      (+= first-quotient 1)
      (-= first-remainder largest)
    )
    (= second-quotient (* second-quotient 2))
    (= second-remainder (* second-remainder 2))
    (if (>= second-remainder magnitude)
      (+= second-quotient 1)
      (-= second-remainder magnitude)
    )
    (let delta (- magnitude second-remainder))
    (if (or (> first-quotient delta) (and (== first-quotient delta) (!= first-remainder 0)))
      (break)
    )
  )
  (let limit (if-expr (== bits 64) all-bits low-word))
  (let multiplier (/and/ (+ second-quotient 1) limit))
  (if (< divisor 0)
    (= multiplier (/and/ (- 0 multiplier) limit))
  )
  (return (call DivisionMagic multiplier (- power bits) false))
)

(fn-do _ power-quotient PowerQuotient
  (param power U32)
  (param divisor U64)
  (let high U64)
  (let low U64)
  (let remainder U64)
  (let position U32 128)
  (while (> position 0)
    (-= position 1)
    (let carry (/zrshift/ remainder 63))
    (= remainder (/lshift/ remainder 1))
    (if (== position power)
      (= remainder (/or/ remainder 1))
    )
    (if (or (!= carry 0) (>= remainder divisor))
      (-= remainder divisor)
      (if (>= position 64)
        (= high (/or/ high (/lshift/ 1u64 (- position 64))))
        (else
          (= low (/or/ low (/lshift/ 1u64 position)))
        )
      )
    )
  )
  (return (call PowerQuotient high low remainder))
)

(type + MIRFrameForwardingPass
  ; Forwards to each load from a small frame object what its block last stored there, where the
  ; object's address reaches nothing but plain loads and stores at constant offsets. A load whose
  ; bytes one register stored whole reads that register, one whose bytes all hold constants reads
  ; the constant, and one whose low bytes one register stored and whose other bytes hold constants
  ; reads that register widened, with the constants set over it. The stores to an object no load is
  ; left to read go, with its addresses.
  (blank)
  (prop _ builder MIRBuilder)
  (prop _ function MIRFunction)
  (prop _ objects (of CPointer U32))
  (prop _ bases (of CPointer U32))
  (prop _ pins (of CPointer Byte))
  (prop _ versions (of CPointer U32))
  (prop _ constant-stamps (of CPointer U32))
  (prop _ constant-versions (of CPointer U32))
  (prop _ constants (of CPointer U64))
  (prop _ byte-stamps (of CPointer U32))
  (prop _ byte-sources (of CPointer U32))
  (prop _ byte-versions (of CPointer U32))
  (prop _ byte-lanes (of CPointer Byte))
  (prop _ byte-widths (of CPointer Byte))
  (prop _ byte-values (of CPointer Byte))
  (prop _ read (of CPointer Byte))
  (prop _ prefixes (of CPointer U32))
  (prop _ instruction-count U32)
  (prop _ stamp U32)
  (fn-do + This _
    (param builder MIRBuilder)
    (lazy function (. builder function))
  )
  (fn-do + run Bool
    (let arena (. function arena))
    (let object-count (. function frame-objects length))
    (= objects (call (of (. arena allocate) U32) object-count))
    (let total U32)
    (for (in position (..< 0 (. function frame-slots length)))
      (let row ([] (. function slots) ([] (. function frame-slots) position)))
      (if (or (. row is-stack) (!= (. row objects length) 1))
        (continue)
      )
      (let object ([] (. row objects) 0))
      (let size (. ([] (. function types) (. ([] (. function frame-objects) object) type)) size))
      (if (and (!= size 0) (<= size forwarded-object-bytes) (not (call is-kept-object object)))
        (= ([] objects object) (+ total 1))
        (+= total size)
      )
    )
    (if (== total 0)
      (return false)
    )
    (let vreg-count (. function vreg-count))
    (= bases (call (of (. arena allocate) U32) vreg-count))
    (= pins (call (of (. arena allocate) Byte) vreg-count))
    (= versions (call (of (. arena allocate) U32) vreg-count))
    (= constant-stamps (call (of (. arena allocate) U32) vreg-count))
    (= constant-versions (call (of (. arena allocate) U32) vreg-count))
    (= constants (call (of (. arena allocate) U64) vreg-count))
    (call find-bases)
    (call check-uses)
    (= byte-stamps (call (of (. arena allocate) U32) total))
    (= byte-sources (call (of (. arena allocate) U32) total))
    (= byte-versions (call (of (. arena allocate) U32) total))
    (= byte-lanes (call (of (. arena allocate) Byte) total))
    (= byte-widths (call (of (. arena allocate) Byte) total))
    (= byte-values (call (of (. arena allocate) Byte) total))
    (= read (call (of (. arena allocate) Byte) object-count))
    (= instruction-count (as (. function instructions length) U32))
    (= prefixes (call (of (. arena allocate) U32) instruction-count))
    (= stamp 0)
    (let changed false)
    (let order (. function block-order))
    (for (in position (..< 0 (. order length)))
      (+= stamp 1)
      (let instructions (. ([] (. function blocks) ([] order position)) instructions))
      (for (in index (..< 0 (. instructions length)))
        (if (call forward ([] instructions index))
          (= changed true)
        )
        (call note-definitions ([] instructions index))
      )
    )
    (if (call rebuild-blocks)
      (= changed true)
    )
    (return changed)
  )
  (fn-expr _ is-kept-object Bool
    (param object FrameObjectId)
    (or flagged (== object (. function closure-root)) (== object (. function capture-closure-root)) is-var)
    (where
      (lazy row ([] (. function frame-objects) object))
      (lazy flagged (or (. row gc-root) (. row can-promote) (. row is-spill)))
      (lazy is-var (call includes (. function vars) object))
    )
  )
  (fn-do _ find-bases _
    (let definitions (call (of (. function arena allocate) U32) (. function vreg-count)))
    (let order (. function block-order))
    (for (in position (..< 0 (. order length)))
      (let instructions (. ([] (. function blocks) ([] order position)) instructions))
      (for (in index (..< 0 (. instructions length)))
        (let id ([] instructions index))
        (let roles (call (. function operand-roles) id))
        (let operands (. ([] (. function instructions) id) operands))
        (let is-address (and (== (. ([] (. function instructions) id) opcode) .addptr) (== (. operands length) 2)))
        (for (in entry (..< 0 (. operands length)))
          (let object (call object-of ([] operands entry)))
          (if (!= object no-frame-object)
            (let base (if-expr (and is-address (== entry 1)) (call vreg-id function ([] operands 0)) no-id))
            (if (or (== base no-id) (call is-root ([] operands 0)) other-base)
              (= ([] objects object) 0)
              (else
                (= ([] bases base) (+ object 1))
              )
            )
            (lazy other-base (and (!= ([] bases base) 0) (!= ([] bases base) (+ object 1))))
          )
          (if (!= (/and/ (call role-at roles entry) def-role) 0)
            (call count-definitions definitions ([] operands entry))
          )
          (call note-pins ([] operands entry))
        )
      )
    )
    (for (in vreg (..< 0 (. function vreg-count)))
      (if (and (!= ([] bases vreg) 0) (!= ([] definitions vreg) 1))
        (= ([] objects (- ([] bases vreg) 1)) 0)
      )
    )
  )
  (fn-do _ object-of FrameObjectId
    (param operand OperandId)
    (if (== operand no-operand)
      (return no-frame-object)
    )
    (match? ([] (. function operands) operand)
      (case (call .frame-object-operand row)
        (return (. row object))
      )
      (case (call .load-address-operand address)
        (let object (call object-of (. address base)))
        (if (!= object no-frame-object)
          (= ([] objects object) 0)
        )
      )
    )
    (return no-frame-object)
  )
  (fn-do _ count-definitions _
    (param counts (of CPointer U32))
    (param operand OperandId)
    (match? ([] (. function operands) operand)
      (case (call .vreg-operand row)
        (let vreg (. ([] (. function vregs) (. row vreg)) id))
        (= ([] counts vreg) (+ ([] counts vreg) 1))
      )
      (case (call .vreg-group-operand group)
        (for (in index (..< (. group vregs start) (. group vregs end)))
          (let vreg (. ([] (. function vregs) ([] (. function group-vregs) index)) id))
          (= ([] counts vreg) (+ ([] counts vreg) 1))
        )
      )
      (case (call .load-address-operand address)
        (let vreg (call vreg-id function (. address base)))
        (if (!= vreg no-id)
          (= ([] counts vreg) (+ ([] counts vreg) 1))
        )
      )
    )
  )
  (fn-do _ check-uses _
    (let order (. function block-order))
    (for (in position (..< 0 (. order length)))
      (let instructions (. ([] (. function blocks) ([] order position)) instructions))
      (for (in index (..< 0 (. instructions length)))
        (let id ([] instructions index))
        (let operands (. ([] (. function instructions) id) operands))
        (let address (call address-entry id))
        (let is-address (== (. ([] (. function instructions) id) opcode) .addptr))
        (for (in entry (..< 0 (. operands length)))
          (if (== entry address)
            (call check-address id ([] operands entry))
            (else-if (or (!= entry 0) (not is-address))
              (call drop-named ([] operands entry))
            )
          )
        )
      )
    )
  )
  (fn-do _ check-address _
    (param id InstructionId)
    (param operand OperandId)
    (match? ([] (. function operands) operand)
      (case (call .load-address-operand address)
        (call drop-named (. address offset))
        (let vreg (call vreg-id function (. address base)))
        (if (or (== vreg no-id) (== ([] bases vreg) 0))
          (return)
        )
        (let object (- ([] bases vreg) 1))
        (let size (as (. ([] (. function types) (. ([] (. function frame-objects) object) type)) size) U64))
        (let width (as (call access-width id) U64))
        (let offset
          (scope (if-expr (== (. address offset) no-operand) (call Known true 0 false) known-offset)
            (lazy known-offset (call known-int function (. address offset)))
          )
        )
        (let limit (if-expr (call is-store id) size (/and/ (+ size 7) 0xfffffffffffffff8)))
        (if (or (. address is-pre-index) (!= (. address index-shift) 0) (not (. offset is-known)) (. offset is-negative) (== width 0) (>= (. offset bits) size) (> (+ (. offset bits) width) limit) (call is-root (. address base)))
          (= ([] objects object) 0)
        )
      )
    )
  )
  (fn-expr _ is-store Bool
    (param id InstructionId)
    (or (== opcode .str) (== opcode .strb) (== opcode .strh) (== opcode .stp))
    (where
      (lazy opcode (. ([] (. function instructions) id) opcode))
    )
  )
  (fn-expr _ is-root Bool
    (param operand OperandId)
    (and (!= row no-id) (. ([] (. function vregs) row) gc-root))
    (where
      (lazy row (call vreg-row function operand))
    )
  )
  (fn-expr _ is-pinned Bool
    (param operand OperandId)
    (and (!= vreg no-id) (!= ([] pins vreg) 0))
    (where
      (lazy vreg (call vreg-id function operand))
    )
  )
  (fn-do _ note-pins _
    (param operand OperandId)
    (if (== operand no-operand)
      (return)
    )
    (match? ([] (. function operands) operand)
      (case (call .vreg-operand row)
        (if (!= (. ([] (. function vregs) (. row vreg)) hint) no-register)
          (= ([] pins (. ([] (. function vregs) (. row vreg)) id)) 1)
        )
      )
      (case (call .vreg-group-operand group)
        (for (in index (..< (. group vregs start) (. group vregs end)))
          (let member ([] (. function group-vregs) index))
          (if (!= (. ([] (. function vregs) member) hint) no-register)
            (= ([] pins (. ([] (. function vregs) member) id)) 1)
          )
        )
      )
      (case (call .load-address-operand address)
        (call note-pins (. address base))
        (call note-pins (. address offset))
      )
    )
  )
  (fn-do _ drop-named _
    (param operand OperandId)
    (if (== operand no-operand)
      (return)
    )
    (match? ([] (. function operands) operand)
      (case (call .vreg-operand row)
        (call drop-base (. ([] (. function vregs) (. row vreg)) id))
      )
      (case (call .vreg-group-operand group)
        (for (in index (..< (. group vregs start) (. group vregs end)))
          (call drop-base (. ([] (. function vregs) ([] (. function group-vregs) index)) id))
        )
      )
      (case (call .load-address-operand address)
        (call drop-named (. address base))
        (call drop-named (. address offset))
      )
    )
  )
  (fn-do _ drop-base _
    (param vreg U32)
    (if (!= ([] bases vreg) 0)
      (= ([] objects (- ([] bases vreg) 1)) 0)
    )
  )
  (fn-expr _ address-entry U32
    (param id InstructionId)
    (case? (and (== count 2) (or (== opcode .ldr) (== opcode .str) narrow-access (== opcode .ldrsw)))
      1
    )
    (case? (and (== count 3) (or (== opcode .ldp) (== opcode .stp)))
      2
    )
    (default
      no-id
    )
    (where
      (lazy opcode (. ([] (. function instructions) id) opcode))
      (lazy count (. ([] (. function instructions) id) operands length))
      (lazy narrow-access (or (== opcode .ldrb) (== opcode .strb) (== opcode .ldrh) (== opcode .strh)))
    )
  )
  (fn-expr _ access-width U32
    (param id InstructionId)
    (case? (or (== opcode .ldrb) (== opcode .strb))
      1
    )
    (case? (or (== opcode .ldrh) (== opcode .strh))
      2
    )
    (case? (== opcode .ldrsw)
      4
    )
    (case? (or (== opcode .ldp) (== opcode .stp))
      (* width 2)
    )
    (default
      width
    )
    (where
      (lazy opcode (. ([] (. function instructions) id) opcode))
      (lazy width (call operand-width ([] (. ([] (. function instructions) id) operands) 0)))
    )
  )
  (fn-do _ operand-width U32
    (param operand OperandId)
    (match? ([] (. function operands) operand)
      (case (call .vreg-operand row)
        (return (as (call class-size (. ([] (. function vregs) (. row vreg)) reg-class)) U32))
      )
      (case (call .preg-operand row)
        (return (as (call class-size (call register-class (. row register))) U32))
      )
    )
    (return 0)
  )
  (fn-do _ target-object FrameObjectId
    (param operand OperandId)
    (match? ([] (. function operands) operand)
      (case (call .load-address-operand address)
        (let vreg (call vreg-id function (. address base)))
        (if (and (!= vreg no-id) (!= ([] bases vreg) 0) (!= ([] objects (- ([] bases vreg) 1)) 0))
          (return (- ([] bases vreg) 1))
        )
      )
    )
    (return no-frame-object)
  )
  (fn-do _ target-byte U32
    (param object FrameObjectId)
    (param operand OperandId)
    (let start (- ([] objects object) 1))
    (match? ([] (. function operands) operand)
      (case (call .load-address-operand address)
        (if (!= (. address offset) no-operand)
          (return (+ start (as (. (call known-int function (. address offset)) bits) U32)))
        )
      )
    )
    (return start)
  )
  (fn-do _ forward Bool
    (param id InstructionId)
    (let address (call address-entry id))
    (if (== address no-id)
      (return false)
    )
    (let operands (. ([] (. function instructions) id) operands))
    (let object (call target-object ([] operands address)))
    (if (== object no-frame-object)
      (return false)
    )
    (let start (call target-byte object ([] operands address)))
    (let opcode (. ([] (. function instructions) id) opcode))
    (if (and (call is-store id) (!= opcode .stp))
      (call store start ([] operands 0) (call access-width id))
      (return false)
    )
    (if (== opcode .stp)
      (let width (call operand-width ([] operands 0)))
      (call store start ([] operands 0) width)
      (call store (+ start width) ([] operands 1) width)
      (return false)
    )
    (if (call load id start (+ (- ([] objects object) 1) (. ([] (. function types) (. ([] (. function frame-objects) object) type)) size)))
      (return true)
    )
    (= ([] read object) 1)
    (return false)
  )
  (fn-do _ store _
    (param start U32)
    (param value OperandId)
    (param width U32)
    (let constant (call constant-of value))
    (let vreg (call vreg-id function value))
    (for (in lane (..< 0 width))
      (let place (+ start lane))
      (= ([] byte-stamps place) stamp)
      (= ([] byte-sources place) no-operand)
      (= ([] byte-lanes place) (as lane Byte))
      (= ([] byte-widths place) (as width Byte))
      (if (. constant is-known)
        (= ([] byte-values place) (as (/and/ (/zrshift/ (. constant bits) (as (* lane 8) U64)) 0xff) Byte))
        (else-if (and (!= vreg no-id) (not (call is-pinned value)))
          (= ([] byte-sources place) value)
          (= ([] byte-versions place) ([] versions vreg))
        )
        (else
          (= ([] byte-stamps place) 0)
        )
      )
    )
  )
  (fn-do _ load Bool
    (param id InstructionId)
    (param start U32)
    (param end U32)
    (let opcode (. ([] (. function instructions) id) opcode))
    (if (and (!= opcode .ldr) (!= opcode .ldrb) (!= opcode .ldrh))
      (return false)
    )
    (let destination ([] (. ([] (. function instructions) id) operands) 0))
    (let row (call vreg-row function destination))
    (if (== row no-id)
      (return false)
    )
    (let reg-class (. ([] (. function vregs) row) reg-class))
    (if (and (!= reg-class .gpr32) (!= reg-class .gpr64))
      (return false)
    )
    (let width (call access-width id))
    (let bits U64)
    (let is-constant true)
    (for (in lane (..< 0 width))
      (let place (+ start lane))
      (if (>= place end)
        (continue)
      )
      (if (!= ([] byte-stamps place) stamp)
        (return false)
      )
      (if (!= ([] byte-sources place) no-operand)
        (= is-constant false)
        (else
          (= bits (/or/ bits (/lshift/ (as ([] byte-values place) U64) (as (* lane 8) U64))))
        )
      )
    )
    (if is-constant
      (return (call move-constant id destination bits (call class-mask reg-class)))
    )
    (let source ([] byte-sources start))
    (let vreg (call vreg-id function source))
    (let stored (as ([] byte-widths start) U32))
    (if (or (== vreg no-id) (> stored width) (and (call is-root destination) (not (call is-root source))))
      (return false)
    )
    (for (in lane (..< 0 width))
      (let place (+ start lane))
      (if (>= lane stored)
        (if (and (< place end) (!= ([] byte-sources place) no-operand))
          (return false)
        )
        (else-if (or other-vreg other-lane (!= ([] byte-versions place) ([] versions vreg)))
          (return false)
        )
      )
      (lazy other-vreg (!= (call vreg-id function ([] byte-sources place)) vreg))
      (lazy other-lane (or (!= ([] byte-lanes place) (as lane Byte)) (!= ([] byte-widths place) (as stored Byte))))
    )
    (let source-class (. ([] (. function vregs) (call vreg-row function source)) reg-class))
    (if (!= stored width)
      (return (call widen id destination source source-class reg-class stored width bits))
    )
    (if (== opcode .ldr)
      (if (!= source-class reg-class)
        (return false)
      )
      (call rewrite-assembly function id .mov (call pair (. function arena) destination source))
      (return true)
    )
    (if (or (!= source-class .gpr32) (!= reg-class .gpr32))
      (return false)
    )
    (call rewrite-assembly
      (block
        (arg function)
        (arg id)
        (arg (if-expr (== opcode .ldrb) (. Opcode uxtb) (. Opcode uxth)))
        (arg (call pair (. function arena) destination source))
      )
    )
    (return true)
  )
  (fn-do _ widen Bool
    (param id InstructionId)
    (param destination OperandId)
    (param source OperandId)
    (param source-class RegClass)
    (param reg-class RegClass)
    (param stored U32)
    (param width U32)
    (param high U64)
    (if (and (!= source-class .gpr32) (!= source-class .gpr64))
      (return false)
    )
    (let opcode (. Opcode uxtb))
    (if (== stored 2)
      (= opcode .uxth)
      (else-if (== stored 4)
        (= opcode .uxtw)
      )
      (else-if (!= stored 1)
        (return false)
      )
    )
    (let arena (. function arena))
    (if (== high 0)
      (call rewrite-assembly function id opcode (call pair arena destination source))
      (return true)
    )
    (if (not (. (call encode-logical-immediate high (* width 8)) is-encodable))
      (return false)
    )
    (let widened (call (. builder vreg-operand) (call (. builder new-vreg) reg-class)))
    (= ([] prefixes id) (+ (call (. builder new-assembly) opcode widened source) 1))
    (call rewrite-assembly
      (block
        (arg function)
        (arg id)
        (arg .orr)
        (arg (call triple arena destination widened (call (. builder small-int) (as high I64))))
      )
    )
    (return true)
  )
  (fn-do _ move-constant Bool
    (param id InstructionId)
    (param destination OperandId)
    (param bits U64)
    (param mask U64)
    (let inverted (/and/ (/xor/ bits all-bits) mask))
    (if (and (> bits 0xffff) (> inverted 0xffff))
      (return false)
    )
    (let opcode (if-expr (<= bits 0xffff) (. Opcode movz) (. Opcode movn)))
    (let immediate (if-expr (<= bits 0xffff) bits inverted))
    (call rewrite-assembly
      (block
        (arg function)
        (arg id)
        (arg opcode)
        (arg (call triple (. function arena) destination (call (. builder small-int) (as immediate I64)) (call (. builder small-int) 0)))
      )
    )
    (return true)
  )
  (fn-do _ constant-of Known
    (param value OperandId)
    (match? ([] (. function operands) value)
      (case (call .preg-operand row)
        (if (or (== (. row register) zero-register) (== (. row register) zero-register-32))
          (return (call Known true 0 false))
        )
      )
      (case (call .vreg-operand row)
        (let vreg (. ([] (. function vregs) (. row vreg)) id))
        (if (and (== ([] constant-stamps vreg) stamp) (== ([] constant-versions vreg) ([] versions vreg)))
          (return (call Known true ([] constants vreg) false))
        )
      )
    )
    (return (call Known))
  )
  (fn-expr _ defined-constant Known
    (param id InstructionId)
    (case? (and moves-wide (== (. operands length) 3) (. immediate is-known) (. shift is-known) (< (. shift bits) 64))
      (call Known true (if-expr (== opcode .movz) bits (/xor/ bits all-bits)) false)
    )
    (case? (and (== opcode .mov) (== (. operands length) 2))
      (call constant-of ([] operands 1))
    )
    (default
      (call Known)
    )
    (where
      (lazy opcode (. ([] (. function instructions) id) opcode))
      (lazy operands (. ([] (. function instructions) id) operands))
      (lazy immediate (call known-int function ([] operands 1)))
      (lazy shift (call known-int function ([] operands 2)))
      (lazy bits (/lshift/ (. immediate bits) (. shift bits)))
      (lazy moves-wide (or (== opcode .movz) (== opcode .movn)))
    )
  )
  (fn-do _ note-definitions _
    (param id InstructionId)
    (let operands (. ([] (. function instructions) id) operands))
    (let row (if-expr (!= (. operands length) 0) (call vreg-row function ([] operands 0)) no-id))
    (let value (if-expr (!= row no-id) (call defined-constant id) (call Known)))
    (let roles (call (. function operand-roles) id))
    (for (in entry (..< 0 (. operands length)))
      (if (!= (/and/ (call role-at roles entry) def-role) 0)
        (call count-definitions versions ([] operands entry))
      )
    )
    (if (. value is-known)
      (let vreg (. ([] (. function vregs) row) id))
      (= ([] constant-stamps vreg) stamp)
      (= ([] constant-versions vreg) ([] versions vreg))
      (= ([] constants vreg) (/and/ (. value bits) (call class-mask (. ([] (. function vregs) row) reg-class))))
    )
  )
  (fn-do _ rebuild-blocks Bool
    (for (in object (..< 0 (. function frame-objects length)))
      (if (!= ([] read object) 0)
        (= ([] objects object) 0)
      )
    )
    (let removed false)
    (let order (. function block-order))
    (for (in position (..< 0 (. order length)))
      (let block ([] order position))
      (let instructions (. ([] (. function blocks) block) instructions))
      (let extra U32)
      (for (in index (..< 0 (. instructions length)))
        (if (!= (call prefix-of ([] instructions index)) no-id)
          (+= extra 1)
        )
      )
      (let rebuilt
        (match extra
          (case= 0
            instructions
          )
          (default
            (call new-id-list (. function arena) (+ (. instructions length) extra))
          )
        )
      )
      (let kept U32)
      (for (in index (..< 0 (. instructions length)))
        (let id ([] instructions index))
        (let object (call dead-object id))
        (if (!= object no-frame-object)
          (call (. function drop-uses) id)
          (= ([] read object) 2)
          (= removed true)
          (continue)
        )
        (let prefix (call prefix-of id))
        (if (!= prefix no-id)
          (call (. function add-uses) prefix)
          (= ([] (. rebuilt data) kept) prefix)
          (+= kept 1)
        )
        (= ([] (. rebuilt data) kept) id)
        (+= kept 1)
      )
      (= (. ([] (. function blocks) block) instructions) (call IdList (. rebuilt data) kept (. rebuilt capacity)))
    )
    (for (in object (..< 0 (. function frame-objects length)))
      (if (== ([] read object) 2)
        (= (. ([] (. function slots) (. ([] (. function frame-objects) object) slot)) objects) (call IdList))
      )
    )
    (return removed)
  )
  (fn-expr _ prefix-of InstructionId
    (param id InstructionId)
    (if-expr (or (>= id instruction-count) (== ([] prefixes id) 0)) no-id (- ([] prefixes id) 1))
  )
  (fn-do _ dead-object FrameObjectId
    (param id InstructionId)
    (let operands (. ([] (. function instructions) id) operands))
    (if (and (== (. ([] (. function instructions) id) opcode) .addptr) (== (. operands length) 2))
      (let vreg (call vreg-id function ([] operands 0)))
      (if (and (!= vreg no-id) (!= ([] bases vreg) 0) (!= ([] objects (- ([] bases vreg) 1)) 0))
        (return (- ([] bases vreg) 1))
      )
      (return no-frame-object)
    )
    (let address (call address-entry id))
    (return (if-expr (!= address no-id) (call target-object ([] operands address)) no-frame-object))
  )
)

(type + MIRBlockLayoutPass
  (prop _ builder MIRBuilder)
  (prop _ function MIRFunction)
  (prop _ branch-targets (of CPointer U32))
  (prop _ path-marks (of CPointer U32))
  (prop _ path-mark U32)
  (prop _ path IdList)
  (prop _ components (of CPointer U32))
  (prop _ component-sizes IdList)
  (prop _ is-cold (of CPointer Byte))
  (prop _ is-placed (of CPointer Byte))
  (prop _ successor-marks (of CPointer U32))
  (prop _ successor-mark U32)
  (fn-do + This _
    (param builder MIRBuilder)
    (lazy function (. builder function))
  )
  (fn-do + run Bool
    (let retargeted (call rewrite-safe-branch-chains))
    (let moved (call layout-blocks))
    (let simplified (call rewrite-fallthrough-branches))
    (return (or retargeted moved simplified))
  )
  (fn-do _ rewrite-safe-branch-chains Bool
    (let arena (. function arena))
    (let changed false)
    (let block-count (. function blocks length))
    (= branch-targets (call (of (. arena allocate) U32) block-count))
    (= path-marks (call (of (. arena allocate) U32) block-count))
    (= path-mark 0)
    (= path (call IdList))
    (let sources (call new-id-list arena 8))
    (let finals (call new-id-list arena 8))
    (let order (. function block-order))
    (for (in position (..< 0 (. order length)))
      (let block ([] order position))
      (= sources (call IdList (. sources data) 0 (. sources capacity)))
      (= finals (call IdList (. finals data) 0 (. finals capacity)))
      (let instructions (. ([] (. function blocks) block) instructions))
      (for (in index (..< 0 (. instructions length)))
        (let id ([] instructions index))
        (if (not (call is-branch-opcode (. ([] (. function instructions) id) opcode)))
          (continue)
        )
        (let operands (. ([] (. function instructions) id) operands))
        (for (in entry (..< 0 (. operands length)))
          (let name (call label-name function ([] operands entry)))
          (if (== name no-string)
            (continue)
          )
          (let target (call (. builder get-block) name))
          (if (== target no-id)
            (continue)
          )
          (let resolved (call chain-target target))
          (if (== resolved target)
            (continue)
          )
          (= ([] (. operands data) entry) (call (. builder label) (. ([] (. function blocks) resolved) name)))
          (if (not (call includes sources target))
            (= sources (call (. sources appended) arena target))
            (= finals (call (. finals appended) arena resolved))
          )
          (= changed true)
        )
      )
      (for (in index (..< 0 (. sources length)))
        (call replace-successor function block ([] sources index) ([] finals index))
      )
    )
    (blank)
    (for (in table (..< 0 (. function jump-tables length)))
      (let labels (. ([] (. function jump-tables) table) labels))
      (for (in index (..< (. labels start) (. labels end)))
        (let name ([] (. function names) index))
        (let target (call (. builder get-block) name))
        (if (== target no-id)
          (continue)
        )
        (let resolved-name (. ([] (. function blocks) (call chain-target target)) name))
        (if (!= resolved-name name)
          (= ([] (. function names data) index) resolved-name)
          (= changed true)
        )
      )
    )
    (blank)
    (if changed
      (call repair-predecessors function)
      (call (. builder prune-unreachable-blocks))
    )
    (return changed)
  )
  (fn-do _ chain-target BlockId
    (param first BlockId)
    (let arena (. function arena))
    (= path (call IdList (. path data) 0 (. path capacity)))
    (+= path-mark 1)
    (let current first)
    (while true
      (let cached ([] branch-targets current))
      (if (!= cached 0)
        (call remember (- cached 1))
        (return (- cached 1))
      )
      (if (== ([] path-marks current) path-mark)
        (for (in index (..< 0 (. path length)))
          (= ([] branch-targets ([] path index)) (+ ([] path index) 1))
        )
        (return first)
      )
      (= ([] path-marks current) path-mark)
      (= path (call (. path appended) arena current))
      (let successor (call safe-branch-only-successor current))
      (if (== successor no-id)
        (call remember current)
        (return current)
      )
      (= current successor)
    )
  )
  (fn-do _ remember _
    (param target BlockId)
    (for (in index (..< 0 (. path length)))
      (= ([] branch-targets ([] path index)) (+ target 1))
    )
  )
  (fn-expr _ safe-branch-only-successor BlockId
    (param block BlockId)
    (case? (or (!= (. instructions length) 1) (!= (. successors length) 1))
      no-id
    )
    (case? (not (call is-plain-branch function id))
      no-id
    )
    (case? (!= (call label-name function (call first-operand function id)) (. ([] (. function blocks) ([] successors 0)) name))
      no-id
    )
    (default
      ([] successors 0)
    )
    (where
      (lazy instructions (. ([] (. function blocks) block) instructions))
      (lazy successors (. ([] (. function blocks) block) successors))
      (lazy id ([] instructions 0))
    )
  )
  (fn-do _ layout-blocks Bool
    (let arena (. function arena))
    (let original (. function block-order))
    (if (< (. original length) 2)
      (return false)
    )
    (let block-count (. function blocks length))
    (call build-loop-components original)
    (call collect-cold-targets)
    (= is-placed (call (of (. arena allocate) Byte) block-count))
    (= successor-marks (call (of (. arena allocate) U32) block-count))
    (= successor-mark 0)
    (let ordered (call new-id-list arena (. original length)))
    (for (in pass (..< 0 2))
      (for (in index (..< 0 (. original length)))
        (let block ([] original index))
        (if (or (!= ([] is-placed block) 0) (and (== pass 0) (!= index 0) (!= ([] is-cold block) 0)))
          (continue)
        )
        (while (and (!= block no-id) (== ([] is-placed block) 0))
          (= ([] is-placed block) 1)
          (= ordered (call (. ordered appended) arena block))
          (= block (call preferred-successor block))
        )
      )
    )
    (blank)
    (let moved false)
    (for (in index (..< 0 (. original length)))
      (if (!= ([] original index) ([] ordered index))
        (= moved true)
      )
    )
    (if moved
      (= (. function block-order) ordered)
    )
    (return moved)
  )
  (fn-do _ build-loop-components _
    (param blocks IdList)
    (let arena (. function arena))
    (let block-count (. function blocks length))
    (let is-listed (call (of (. arena allocate) Byte) block-count))
    (for (in index (..< 0 (. blocks length)))
      (= ([] is-listed ([] blocks index)) 1)
    )
    (let is-visited (call (of (. arena allocate) Byte) block-count))
    (let pending (call (of (. arena allocate) U32) (. blocks length)))
    (let cursors (call (of (. arena allocate) U32) (. blocks length)))
    (let post-order (call new-id-list arena (. blocks length)))
    (for (in index (..< 0 (. blocks length)))
      (let root ([] blocks index))
      (if (!= ([] is-visited root) 0)
        (continue)
      )
      (= ([] is-visited root) 1)
      (let depth U32 1)
      (= ([] pending 0) root)
      (= ([] cursors 0) 0)
      (while (!= depth 0)
        (let block ([] pending (- depth 1)))
        (let successors (. ([] (. function blocks) block) successors))
        (let cursor ([] cursors (- depth 1)))
        (if (< cursor (. successors length))
          (= ([] cursors (- depth 1)) (+ cursor 1))
          (let successor ([] successors cursor))
          (if (and (!= ([] is-listed successor) 0) (== ([] is-visited successor) 0))
            (= ([] is-visited successor) 1)
            (= ([] pending depth) successor)
            (= ([] cursors depth) 0)
            (+= depth 1)
          )
          (continue)
        )
        (= post-order (call (. post-order appended) arena block))
        (-= depth 1)
      )
    )
    (blank)
    (= components (call (of (. arena allocate) U32) block-count))
    (= component-sizes (call IdList))
    (let index (. post-order length))
    (while (> index 0)
      (-= index 1)
      (let root ([] post-order index))
      (if (!= ([] components root) 0)
        (continue)
      )
      (let component (+ (. component-sizes length) 1))
      (let size U32)
      (let depth U32 1)
      (= ([] pending 0) root)
      (= ([] components root) component)
      (while (!= depth 0)
        (-= depth 1)
        (let block ([] pending depth))
        (+= size 1)
        (let predecessors (. ([] (. function blocks) block) predecessors))
        (for (in entry (..< 0 (. predecessors length)))
          (let predecessor ([] predecessors entry))
          (if (or (== ([] is-listed predecessor) 0) (!= ([] components predecessor) 0))
            (continue)
          )
          (= ([] components predecessor) component)
          (= ([] pending depth) predecessor)
          (+= depth 1)
        )
      )
      (= component-sizes (call (. component-sizes appended) arena size))
    )
  )
  (fn-do _ collect-cold-targets _
    ; Marks the blocks that run only on the way to a panic: the landing pads of calls, the blocks that
    ; call a function that raises one (`Bundle.is-cold-callee`), and the blocks only those lead to.
    (= is-cold (call (of (. function arena allocate) Byte) (. function blocks length)))
    (let order (. function block-order))
    (for (in position (..< 0 (. order length)))
      (let block ([] order position))
      (let instructions (. ([] (. function blocks) block) instructions))
      (for (in index (..< 0 (. instructions length)))
        (let id ([] instructions index))
        (let panic-target no-operand)
        (match? ([] (. function instructions) id)
          (case (call .call-instruction call)
            (= panic-target (. call panic-target))
            (if (call raises (call first-operand function id))
              (= ([] is-cold block) 1)
            )
          )
        )
        (let name (call label-name function panic-target))
        (if (== name no-string)
          (continue)
        )
        (let target (call (. builder get-block) name))
        (if (!= target no-id)
          (= ([] is-cold target) 1)
        )
      )
    )
    (let changed true)
    (while changed
      (= changed false)
      (for (in position (..< 1 (. order length)))
        (let block ([] order position))
        (if (and (== ([] is-cold block) 0) (call is-cold-only block))
          (= ([] is-cold block) 1)
          (= changed true)
        )
      )
    )
  )
  (fn-do _ raises Bool
    (param callee OperandId)
    (return-if false (if (== callee no-operand)))
    (blank)
    (match? ([] (. function operands) callee)
      (case (call .symbol-operand operand)
        (return (call (. builder bundle is-cold-callee) (. operand name)))
      )
    )
    (return false)
  )
  (fn-do _ is-cold-only Bool
    (param block BlockId)
    ; Whether every block that leads to a block is cold, where any does.
    (let predecessors (. ([] (. function blocks) block) predecessors))
    (return-if false (if (== (. predecessors length) 0)))
    (blank)
    (for (in index (..< 0 (. predecessors length)))
      (return-if false (if (== ([] is-cold ([] predecessors index)) 0)))
    )
    (return true)
  )
  (fn-do _ preferred-successor BlockId
    (param block BlockId)
    (+= successor-mark 1)
    (let unique-count U32)
    (let first-unplaced no-id)
    (let loop-count U32)
    (let loop-successor no-id)
    (let successors (. ([] (. function blocks) block) successors))
    (for (in index (..< 0 (. successors length)))
      (let successor ([] successors index))
      (if (== ([] successor-marks successor) successor-mark)
        (continue)
      )
      (= ([] successor-marks successor) successor-mark)
      (+= unique-count 1)
      (if (!= ([] is-placed successor) 0)
        (continue)
      )
      (if (== first-unplaced no-id)
        (= first-unplaced successor)
      )
      (if (and (== ([] is-cold successor) 0) (call is-same-loop-component block successor))
        (+= loop-count 1)
        (if (== loop-count 1)
          (= loop-successor successor)
        )
      )
    )
    (if (== first-unplaced no-id)
      (return no-id)
    )
    (if (== unique-count 1)
      (return (if-expr (and (!= ([] is-cold first-unplaced) 0) (== ([] is-cold block) 0)) no-id first-unplaced))
    )
    (if (== loop-count 1)
      (return loop-successor)
    )
    (blank)
    (let last (call last-real function block))
    (if (or (== last no-id) (!= (. ([] (. function instructions) last) opcode) .b))
      (return no-id)
    )
    (let name (call label-name function (call first-operand function last)))
    (if (== name no-string)
      (return no-id)
    )
    (let target (call (. builder get-block) name))
    (if (and (!= target no-id) (== ([] is-placed target) 0) (== ([] is-cold target) 0))
      (return target)
    )
    (return no-id)
  )
  (fn-expr _ is-same-loop-component Bool
    (param from BlockId)
    (param to BlockId)
    (and (!= component 0) (== component ([] components to)) (or (> ([] component-sizes (- component 1)) 1) (== from to)))
    (where
      (lazy component ([] components from))
    )
  )
  (fn-do + rewrite-fallthrough-branches Bool
    (let changed false)
    (let order (. function block-order))
    (for (in position (..< 1 (. order length)))
      (let block ([] order (- position 1)))
      (let next-name (. ([] (. function blocks) ([] order position)) name))
      (let instructions (. ([] (. function blocks) block) instructions))
      (let branch-index (call previous-real function instructions (. instructions length)))
      (if (== branch-index no-id)
        (continue)
      )
      (let branch ([] instructions branch-index))
      (if (not (call is-plain-branch function branch))
        (continue)
      )
      (let branch-target (call first-operand function branch))
      (let target-name (call label-name function branch-target))
      (if (== target-name no-string)
        (continue)
      )
      (blank)
      (let conditional-index (call previous-real function instructions branch-index))
      (let is-inverted false)
      (if (!= conditional-index no-id)
        (let conditional ([] instructions conditional-index))
        (if (== (call label-name function (call conditional-branch-target function conditional)) next-name)
          (= is-inverted (call invert-conditional-branch conditional branch-target))
        )
      )
      (if (or is-inverted (== target-name next-name))
        (call remove-instruction function block branch)
        (= changed true)
      )
    )
    (return changed)
  )
  (fn-do _ invert-conditional-branch Bool
    (param id InstructionId)
    (param target OperandId)
    (let opcode (. ([] (. function instructions) id) opcode))
    (let operands (. ([] (. function instructions) id) operands))
    (if (== opcode .cbnz)
      (= ([] (. operands data) 1) target)
      (call rewrite-assembly function id .cbz operands)
      (return true)
    )
    (if (== opcode .cbz)
      (= ([] (. operands data) 1) target)
      (call rewrite-assembly function id .cbnz operands)
      (return true)
    )
    (if (or (== opcode .tbz) (== opcode .tbnz))
      (= ([] (. operands data) 2) target)
      (call rewrite-assembly function id (if-expr (== opcode .tbz) (. Opcode tbnz) (. Opcode tbz)) operands)
      (return true)
    )
    (if (!= opcode .b-cond)
      (return false)
    )
    (let inverse (call invert-condition builder ([] operands 1)))
    (if (== inverse no-operand)
      (return false)
    )
    (= ([] (. operands data) 0) target)
    (= ([] (. operands data) 1) inverse)
    (return true)
  )
)

(type + MIRCompareBranchFusionPass
  (prop _ builder MIRBuilder)
  (prop _ function MIRFunction)
  (fn-do + This _
    (param builder MIRBuilder)
    (lazy function (. builder function))
  )
  (fn-do + run Bool
    (let arena (. function arena))
    (let changed false)
    (let order (. function block-order))
    (for (in position (..< 0 (. order length)))
      (let block ([] order position))
      (let instructions (. ([] (. function blocks) block) instructions))
      (let has-kept false)
      (let kept IdList)
      (for (in index (..< 0 (. instructions length)))
        (let id ([] instructions index))
        (let opcode (. ([] (. function instructions) id) opcode))
        (let cset no-id)
        (if (or (== opcode .cbnz) (== opcode .cbz))
          (= cset (call fusable-condition id instructions index))
        )
        (let condition no-operand)
        (if (!= cset no-id)
          (let operands (. ([] (. function instructions) id) operands))
          (call (. function count-uses))
          (if (== (call (. function use-count) (call vreg-id function ([] operands 0))) 1)
            (= condition ([] (. ([] (. function instructions) cset) operands) 1))
            (if (== opcode .cbz)
              (= condition (call invert-condition builder condition))
            )
          )
        )
        (if (== condition no-operand)
          (if has-kept
            (= kept (call (. kept appended) arena id))
          )
          (continue)
        )
        (blank)
        (if (not has-kept)
          (= has-kept true)
          (= kept (call new-id-list arena (. instructions length)))
          (for (in entry (..< 0 index))
            (= kept (call (. kept appended) arena ([] instructions entry)))
          )
        )
        (let found (. kept length))
        (while (> found 0)
          (-= found 1)
          (if (== ([] kept found) cset)
            (call (. function drop-uses) cset)
            (let following (+ found 1))
            (for (in entry (..< following (. kept length)))
              (= ([] (. kept data) (- entry 1)) ([] kept entry))
            )
            (= kept (call IdList (. kept data) (- (. kept length) 1) (. kept capacity)))
            (break)
          )
        )
        (call rewrite-assembly
          (block
            (arg function)
            (arg id)
            (arg .b-cond)
            (arg (call pair arena ([] (. ([] (. function instructions) id) operands) 1) condition))
          )
        )
        (= kept (call (. kept appended) arena id))
        (= changed true)
      )
      (if has-kept
        (= (. ([] (. function blocks) block) instructions) kept)
      )
    )
    (return changed)
  )
  (fn-expr _ fusable-condition InstructionId
    (param id InstructionId)
    (param instructions IdList)
    (param index U32)
    (case? (== tested no-id)
      no-id
    )
    (case? (or (== cset-index no-id) (== cmp-index no-id))
      no-id
    )
    (case? (!= (. ([] (. function instructions) cset) opcode) .cset)
      no-id
    )
    (case? (not (call same-operand function ([] (. ([] (. function instructions) cset) operands) 0) ([] operands 0)))
      no-id
    )
    (case? (not (call is-flag-compare (. ([] (. function instructions) ([] instructions cmp-index)) opcode)))
      no-id
    )
    (default
      cset
    )
    (where
      (lazy operands (. ([] (. function instructions) id) operands))
      (lazy tested (call vreg-id function ([] operands 0)))
      (lazy cset-index (call cset-before instructions index tested))
      (lazy cmp-index (call previous-real function instructions cset-index))
      (lazy cset ([] instructions cset-index))
    )
  )
  (fn-do _ cset-before U32
    (param instructions IdList)
    (param index U32)
    (param tested U32)
    (let cursor (call previous-real function instructions index))
    (while (and (!= cursor no-id) (!= (. ([] (. function instructions) ([] instructions cursor)) opcode) .cset))
      (let between ([] instructions cursor))
      (let opcode (. ([] (. function instructions) between) opcode))
      (return-if no-id (if (or (not (call is-pure-def opcode)) (call clobbers-flags opcode))))
      (blank)
      (let defined (call (. function instruction-def) between))
      (return-if no-id (if (and (!= defined no-id) (== (. ([] (. function vregs) defined) id) tested))))
      (blank)
      (= cursor (call previous-real function instructions cursor))
    )
    (return cursor)
  )
)

(type _ Lattice (is Tuple)
  (prop + state Byte)
  (prop + bits U64)
)

(type _ WidePart (is Tuple)
  (prop + bits U64)
  (prop + shift U64)
)

(fn-expr _ meet Lattice
  (param left Lattice)
  (param right Lattice)
  (case? (== (. left state) (. LatticeState top))
    right
  )
  (case? (== (. right state) (. LatticeState top))
    left
  )
  (case? (and (== (. left state) (. LatticeState constant)) (== (. right state) (. LatticeState constant)) same-bits)
    left
  )
  (default
    (call Lattice (. LatticeState varying) 0)
  )
  (where
    (lazy same-bits (== (. left bits) (. right bits)))
  )
)

(fn-expr _ merged-state Byte
  (param left Lattice)
  (param right Lattice)
  (case? (or (== (. left state) (. LatticeState varying)) (== (. right state) (. LatticeState varying)))
    (. LatticeState varying)
  )
  (case? (or (== (. left state) (. LatticeState top)) (== (. right state) (. LatticeState top)))
    (. LatticeState top)
  )
  (default
    (. LatticeState constant)
  )
)

(fn-expr _ class-mask U64
  (param reg-class RegClass)
  (match reg-class
    (case= .gpr32
      low-word
    )
    (case= .gpr64
      all-bits
    )
    (default
      0
    )
  )
)

(fn-expr _ class-size U64
  (param reg-class U32)
  (case? (or (== reg-class (as (. RegClass gpr32) U32)) (== reg-class (as (. RegClass fpr32) U32)))
    4
  )
  (case? (or (== reg-class (as (. RegClass gpr64) U32)) (== reg-class (as (. RegClass fpr64) U32)))
    8
  )
  (default
    0
  )
)

(fn-expr _ sign-extended U64
  (param bits U64)
  (param width U64)
  (case? (>= width 64)
    bits
  )
  (case? (!= (/and/ low (/lshift/ 1u64 (- width 1))) 0)
    (/or/ low (/xor/ field all-bits))
  )
  (default
    low
  )
  (where
    (lazy field (- (/lshift/ 1u64 width) 1))
    (lazy low (/and/ bits field))
  )
)

(type _ Known (is Tuple)
  (prop + is-known Bool)
  (prop + bits U64)
  (prop + is-negative Bool)
)

(fn-do _ known-int Known
  (param function MIRFunction)
  (param operand OperandId)
  (match? ([] (. function operands) operand)
    (case (call .int-operand row)
      (return (call Known true (. row value bits) (. row value is-negative)))
    )
  )
  (return (call Known))
)

(fn-expr _ signed-value I64
  (param value Known)
  (before
    (throw (call Panic (str "MIR address offset " (. value bits) " does not fit a signed offset")) (if (and (not (. value is-negative)) (> (. value bits) 0x7fffffffffffffff))))
  )
  (as (. value bits) I64)
)

(fn-expr _ fits-signed-bits Bool
  (param value I64)
  (param bits I64)
  (and (>= value (- 0 limit)) (< value limit))
  (where
    (lazy limit I64 (/lshift/ 1 (- bits 1)))
  )
)

(fn-expr _ is-add-sub-bits Bool
  (param bits U64)
  (or (<= bits 4095) (and (== (% bits 4096) 0) (<= (/ bits 4096) 4095)))
)

(fn-expr _ is-power-of-two Bool
  (param bits U64)
  (and (!= bits 0) (== (/and/ bits (- bits 1)) 0))
)

(fn-expr _ is-add-sub-immediate Bool
  (param value MIRInt)
  (and (not (. value is-negative)) (or (<= (. value bits) 4095) (and (== (% (. value bits) 4096) 0) (<= (/ (. value bits) 4096) 4095))))
)

(fn-do _ log2 I64
  (param value U64)
  (let shift I64)
  (let rest value)
  (while (> rest 1)
    (= rest (/zrshift/ rest 1))
    (+= shift 1)
  )
  (return shift)
)

(fn-do _ nearest-writer U32
  (param function MIRFunction)
  (param removed (of CPointer Byte))
  (param instructions IdList)
  (param index U32)
  (param vreg U32)
  (if (== vreg no-id)
    (return no-id)
  )
  (let position index)
  (while (> position 0)
    (-= position 1)
    (let id ([] instructions position))
    (if (and (== ([] removed id) 0) (call writes-vreg function id vreg))
      (return position)
    )
  )
  (return no-id)
)

(fn-do _ holds-between Bool
  (param function MIRFunction)
  (param removed (of CPointer Byte))
  (param instructions IdList)
  (param from U32)
  (param to U32)
  (param operand OperandId)
  (let vreg (call vreg-id function operand))
  (for (in position (..< (+ from 1) to))
    (let id ([] instructions position))
    (if (and (== ([] removed id) 0) (call writes-vreg function id vreg))
      (return false)
    )
  )
  (return true)
)

(fn-do _ writes-vreg Bool
  (param function MIRFunction)
  (param id InstructionId)
  (param vreg U32)
  (let roles (call (. function operand-roles) id))
  (let operands (. ([] (. function instructions) id) operands))
  (for (in position (..< 0 (. operands length)))
    (if (and is-def (call names-vreg function ([] operands position) vreg))
      (return true)
    )
    (lazy is-def (!= (/and/ (call role-at roles position) def-role) 0))
  )
  (return false)
)

(fn-do _ names-vreg Bool
  (param function MIRFunction)
  (param operand OperandId)
  (param vreg U32)
  (match? ([] (. function operands) operand)
    (case (call .vreg-operand row)
      (return (== (. ([] (. function vregs) (. row vreg)) id) vreg))
    )
    (case (call .vreg-group-operand group)
      (for (in index (..< (. group vregs start) (. group vregs end)))
        (if (== (. ([] (. function vregs) ([] (. function group-vregs) index)) id) vreg)
          (return true)
        )
      )
    )
    (case (call .load-address-operand address)
      (return (== (call vreg-id function (. address base)) vreg))
    )
  )
  (return false)
)

(fn-do _ is-only-reader Bool
  (param function MIRFunction)
  (param vreg U32)
  (param definer InstructionId)
  (let own U32)
  (let roles (call (. function operand-roles) definer))
  (let operands (. ([] (. function instructions) definer) operands))
  (for (in position (..< 0 (. operands length)))
    (if (and is-use (== (call vreg-id function ([] operands position)) vreg))
      (+= own 1)
    )
    (lazy is-use (!= (/and/ (call role-at roles position) use-role) 0))
  )
  (return (== (call (. function use-count) vreg) (+ own 1)))
)

(fn-do _ pair IdList
  (param arena Arena)
  (param first OperandId)
  (param second OperandId)
  (let list (call new-id-list arena 2))
  (= ([] (. list data) 0) first)
  (= ([] (. list data) 1) second)
  (return (call IdList (. list data) 2 2))
)

(fn-do _ triple IdList
  (param arena Arena)
  (param first OperandId)
  (param second OperandId)
  (param third OperandId)
  (let list (call new-id-list arena 3))
  (= ([] (. list data) 0) first)
  (= ([] (. list data) 1) second)
  (= ([] (. list data) 2) third)
  (return (call IdList (. list data) 3 3))
)

(fn-do _ quad IdList
  (param arena Arena)
  (param first OperandId)
  (param second OperandId)
  (param third OperandId)
  (param fourth OperandId)
  (let list (call new-id-list arena 4))
  (= ([] (. list data) 0) first)
  (= ([] (. list data) 1) second)
  (= ([] (. list data) 2) third)
  (= ([] (. list data) 3) fourth)
  (return (call IdList (. list data) 4 4))
)

(fn-do _ rewrite-assembly _
  (param function MIRFunction)
  (param id InstructionId)
  (param opcode Opcode)
  (param operands IdList)
  (call (. function drop-uses) id)
  (match? ([] (. function instructions) id)
    (case (call .assembly-instruction row)
      (= (. row opcode) opcode)
      (= (. row operands) operands)
    )
  )
  (call (. function add-uses) id)
)

(fn-do _ vreg-id U32
  (param function MIRFunction)
  (param operand OperandId)
  (if (== operand no-operand)
    (return no-id)
  )
  (match? ([] (. function operands) operand)
    (case (call .vreg-operand row)
      (return (. ([] (. function vregs) (. row vreg)) id))
    )
  )
  (return no-id)
)

(fn-do _ is-load-address Bool
  (param function MIRFunction)
  (param operand OperandId)
  (match? ([] (. function operands) operand)
    (case .load-address-operand
      (return true)
    )
  )
  (return false)
)

(fn-do _ label-name StringId
  (param function MIRFunction)
  (param operand OperandId)
  (if (== operand no-operand)
    (return no-string)
  )
  (match? ([] (. function operands) operand)
    (case (call .label-operand label)
      (return (. label name))
    )
  )
  (return no-string)
)

(fn-expr _ first-operand OperandId
  (param function MIRFunction)
  (param id InstructionId)
  (if-expr (== (. operands length) 0) no-operand ([] operands 0))
  (where
    (lazy operands (. ([] (. function instructions) id) operands))
  )
)

(fn-do _ same-operand Bool
  (param function MIRFunction)
  (param left OperandId)
  (param right OperandId)
  (match? ([] (. function operands) left)
    (case (call .vreg-operand first)
      (match? ([] (. function operands) right)
        (case (call .vreg-operand second)
          (return (== (. ([] (. function vregs) (. first vreg)) id) (. ([] (. function vregs) (. second vreg)) id)))
        )
      )
      (return false)
    )
    (case (call .preg-operand first)
      (match? ([] (. function operands) right)
        (case (call .preg-operand second)
          (return (== (. first register) (. second register)))
        )
      )
      (return false)
    )
    (case (call .int-operand first)
      (match? ([] (. function operands) right)
        (case (call .int-operand second)
          (return
            (scope (and (== (. first value bits) (. second value bits)) same-sign)
              (lazy same-sign (== (. first value is-negative) (. second value is-negative)))
            )
          )
        )
      )
      (return false)
    )
  )
  (return false)
)

(fn-do _ invert-condition OperandId
  (param builder MIRBuilder)
  (param operand OperandId)
  (let code no-condition)
  (match? ([] (. builder function operands) operand)
    (case (call .cond-operand row)
      (= code (. row code))
    )
  )
  (if (or (== code no-condition) (== code (. Condition always)))
    (return no-operand)
  )
  (return (call (. builder add-operand) (call CondOperand (/xor/ code 1))))
)

(fn-do _ conditional-branch-target OperandId
  (param function MIRFunction)
  (param id InstructionId)
  (let opcode (. ([] (. function instructions) id) opcode))
  (let operands (. ([] (. function instructions) id) operands))
  (let target no-operand)
  (if (and (== opcode .b-cond) (> (. operands length) 0))
    (= target ([] operands 0))
    (else-if (and (or (== opcode .cbz) (== opcode .cbnz)) (> (. operands length) 1))
      (= target ([] operands 1))
    )
    (else-if (and (or (== opcode .tbz) (== opcode .tbnz)) (> (. operands length) 2))
      (= target ([] operands 2))
    )
  )
  (if (== (call label-name function target) no-string)
    (return no-operand)
  )
  (return target)
)

(fn-do _ is-plain-branch Bool
  (param function MIRFunction)
  (param id InstructionId)
  (match? ([] (. function instructions) id)
    (case (call .assembly-instruction row)
      (return
        (scope (and (== (. row opcode) .b) (== (. row loc) no-loc) (not (. row gc-safepoint)) (not has-roots))
          (lazy has-roots (and (. row has-gc-roots) (!= (. row gc-roots count) 0)))
        )
      )
    )
  )
  (return false)
)

(fn-do _ previous-real U32
  (param function MIRFunction)
  (param instructions IdList)
  (param end U32)
  (let index end)
  (while (> index 0)
    (-= index 1)
    (if (!= (. ([] (. function instructions) ([] instructions index)) opcode) .comment)
      (return index)
    )
  )
  (return no-id)
)

(fn-do _ next-real U32
  (param function MIRFunction)
  (param instructions IdList)
  (param start U32)
  (let index start)
  (while (< index (. instructions length))
    (if (!= (. ([] (. function instructions) ([] instructions index)) opcode) .comment)
      (return index)
    )
    (+= index 1)
  )
  (return no-id)
)

(fn-do _ single-real InstructionId
  (param function MIRFunction)
  (param block BlockId)
  (let found no-id)
  (let instructions (. ([] (. function blocks) block) instructions))
  (for (in index (..< 0 (. instructions length)))
    (let id ([] instructions index))
    (if (== (. ([] (. function instructions) id) opcode) .comment)
      (continue)
    )
    (if (!= found no-id)
      (return no-id)
    )
    (= found id)
  )
  (return found)
)

(fn-expr _ last-real InstructionId
  (param function MIRFunction)
  (param block BlockId)
  (if-expr (== index no-id) no-id ([] instructions index))
  (where
    (lazy instructions (. ([] (. function blocks) block) instructions))
    (lazy index (call previous-real function instructions (. instructions length)))
  )
)

(fn-do _ remove-instruction _
  (param function MIRFunction)
  (param block BlockId)
  (param instruction InstructionId)
  (let instructions (. ([] (. function blocks) block) instructions))
  (for (in index (..< 0 (. instructions length)))
    (if (!= ([] instructions index) instruction)
      (continue)
    )
    (call (. function drop-uses) instruction)
    (let following (+ index 1))
    (for (in entry (..< following (. instructions length)))
      (= ([] (. instructions data) (- entry 1)) ([] instructions entry))
    )
    (= (. ([] (. function blocks) block) instructions)
      (call IdList
        (block
          (arg (. instructions data))
          (arg (- (. instructions length) 1))
          (arg (. instructions capacity))
        )
      )
    )
    (return)
  )
)

(fn-do _ includes Bool
  (param list IdList)
  (param id U32)
  (for (in index (..< 0 (. list length)))
    (if (== ([] list index) id)
      (return true)
    )
  )
  (return false)
)

(fn-expr _ is-branch-opcode Bool @inline
  (param opcode Opcode)
  (or plain-branch (== opcode .cbz) (== opcode .cbnz) (== opcode .tbz) (== opcode .tbnz))
  (where
    (lazy plain-branch (or (== opcode .b) (== opcode .b-cond)))
  )
)

(fn-expr _ is-flag-compare Bool @inline
  (param opcode Opcode)
  (or (== opcode .cmp) (== opcode .fcmps) (== opcode .fcmpd))
)

(fn-expr _ reads-flags Bool @inline
  (param opcode Opcode)
  (or select-or-branch (== opcode .csinc) (== opcode .csinv) (== opcode .csneg) (== opcode .ccmp))
  (where
    (lazy select-or-branch (or (== opcode .cset) (== opcode .csel) (== opcode .fcsel) (== opcode .b-cond)))
  )
)

(fn-expr _ clobbers-flags Bool @inline
  (param opcode Opcode)
  (or (call is-flag-compare opcode) (== opcode .ccmp) (== opcode .call) (== opcode .bl) (== opcode .blr))
)

(fn-expr _ is-load-store Bool
  (param opcode Opcode)
  (or (== opcode .ldr) (== opcode .str) (== opcode .ldrb) (== opcode .strb) (== opcode .ldrh) (== opcode .strh) (== opcode .ldrsw) (== opcode .ldrsb) (== opcode .ldrsh) (== opcode .ldp) (== opcode .stp))
)

(fn-expr _ is-pure-def Bool @inline
  (param opcode Opcode)
  (or (<= code 25) (== code 29) (== code 30) (== code 32) (== code 34) (== code 35) (and (>= code 57) (<= code 68)) (and (>= code 76) (<= code 84)) (== code 87) (== code 88))
  (where
    (lazy code (as opcode U32))
  )
)

(fn-expr _ shift-kind U32
  (param opcode Opcode)
  (match opcode
    (case= .lsl
      (. MIRShift left)
    )
    (case= .lsr
      (. MIRShift right)
    )
    (case= .asr
      (. MIRShift right-signed)
    )
    (default
      no-id
    )
  )
)

(fn-expr _ extension-bits U32
  (param opcode Opcode)
  (case? (or (== opcode .uxtb) (== opcode .sxtb))
    8
  )
  (case? (or (== opcode .uxth) (== opcode .sxth))
    16
  )
  (case? (or (== opcode .uxtw) (== opcode .sxtw))
    32
  )
  (default
    0
  )
)

(fn-expr _ is-signed-extension Bool
  (param opcode Opcode)
  (or (== opcode .sxtb) (== opcode .sxth) (== opcode .sxtw))
)

(fn-expr _ narrow-extension-width U32
  (param opcode Opcode)
  (case? (or (== bits 0) (> bits 16))
    0
  )
  (case? (call is-signed-extension opcode)
    (- bits 1)
  )
  (default
    bits
  )
  (where
    (lazy bits (call extension-bits opcode))
  )
)

(fn-expr _ is-register-copy Bool
  (param function MIRFunction)
  (param id InstructionId)
  (and (== (. ([] (. function instructions) id) opcode) .mov) copies-vreg)
  (where
    (lazy copies-vreg (!= (call vreg-id function ([] (. ([] (. function instructions) id) operands) 1)) no-id))
  )
)

(fn-do _ value-width U32
  (param value Known)
  (if (or (not (. value is-known)) (. value is-negative) (> (. value bits) 0xffff))
    (return unknown-width)
  )
  (let width U32)
  (let rest (. value bits))
  (while (!= rest 0)
    (= rest (/zrshift/ rest 1))
    (+= width 1)
  )
  (return width)
)

(fn-do _ bit-length U32
  (param bits U64)
  (let width U32)
  (let rest bits)
  (while (!= rest 0)
    (= rest (/zrshift/ rest 1))
    (+= width 1)
  )
  (return width)
)

(fn-do _ vreg-row VRegId @inline
  (param function MIRFunction)
  (param operand OperandId)
  (match? ([] (. function operands) operand)
    (case (call .vreg-operand row)
      (return (. row vreg))
    )
  )
  (return no-id)
)

(fn-do _ rewrite-branch-label _
  (param builder MIRBuilder)
  (param block BlockId)
  (param from StringId)
  (param to StringId)
  (let function (. builder function))
  (let instructions (. ([] (. function blocks) block) instructions))
  (for (in index (..< 0 (. instructions length)))
    (let operands (. ([] (. function instructions) ([] instructions index)) operands))
    (for (in entry (..< 0 (. operands length)))
      (if (== (call label-name function ([] operands entry)) from)
        (= ([] (. operands data) entry) (call (. builder label) to))
      )
    )
  )
)

(fn-do _ has-explicit-branch-to Bool
  (param function MIRFunction)
  (param block BlockId)
  (param target StringId)
  (let instructions (. ([] (. function blocks) block) instructions))
  (for (in index (..< 0 (. instructions length)))
    (let id ([] instructions index))
    (if (not (call is-branch-opcode (. ([] (. function instructions) id) opcode)))
      (continue)
    )
    (let operands (. ([] (. function instructions) id) operands))
    (for (in entry (..< 0 (. operands length)))
      (if (== (call label-name function ([] operands entry)) target)
        (return true)
      )
    )
  )
  (return false)
)

(fn-do _ replace-successor _
  (param function MIRFunction)
  (param block BlockId)
  (param from BlockId)
  (param to BlockId)
  (let successors (. ([] (. function blocks) block) successors))
  (for (in index (..< 0 (. successors length)))
    (if (== ([] successors index) from)
      (= ([] (. successors data) index) to)
    )
  )
)

(fn-do _ repair-predecessors _
  (param function MIRFunction)
  (let arena (. function arena))
  (let order (. function block-order))
  (let block-count (. function blocks length))
  (let is-listed (call (of (. arena allocate) Byte) block-count))
  (for (in position (..< 0 (. order length)))
    (= ([] is-listed ([] order position)) 1)
    (= (. ([] (. function blocks) ([] order position)) predecessors) (call IdList))
  )
  (let marks (call (of (. arena allocate) U32) block-count))
  (for (in position (..< 0 (. order length)))
    (let block ([] order position))
    (let mark (+ position 1))
    (let successors (. ([] (. function blocks) block) successors))
    (let kept U32)
    (for (in index (..< 0 (. successors length)))
      (let successor ([] successors index))
      (if (== ([] marks successor) mark)
        (continue)
      )
      (= ([] marks successor) mark)
      (= ([] (. successors data) kept) successor)
      (+= kept 1)
    )
    (= (. ([] (. function blocks) block) successors) (call IdList (. successors data) kept (. successors capacity)))
    (for (in index (..< 0 kept))
      (let successor ([] successors index))
      (let predecessors (. ([] (. function blocks) successor) predecessors))
      (if (and (== ([] is-listed successor) 0) (call includes predecessors block))
        (continue)
      )
      (= (. ([] (. function blocks) successor) predecessors) (call (. predecessors appended) arena block))
    )
  )
)

(type _ DefinitionChains (is Tuple)
  (prop + firsts (of CPointer U32))
  (prop + nexts (of CPointer U32))
  (prop + own-reads (of CPointer U32))
  (prop + vregs (of CPointer U32))
)

(fn-do _ remove-dead-definitions Bool
  (param function MIRFunction)
  (param pure-only Bool (= false))
  ; Removes each definition whose vreg nothing reads. With `pure-only`, as the reference's backend
  ; does, only a pure definition no instruction reads goes. Otherwise a load, MOVK, ADRP or phi may
  ; go too, and so may a vreg that only its own definitions read, as the ADRP and ADD of a symbol's
  ; address.
  (let arena (. function arena))
  (call (. function count-uses))
  (let instruction-count (. function instructions length))
  (let chains
    (call DefinitionChains
      (block
        (arg (call (of (. arena allocate) U32) (. function vreg-count)))
        (arg (call (of (. arena allocate) U32) instruction-count))
        (arg (call (of (. arena allocate) U32) (. function vreg-count)))
        (arg (call (of (. arena allocate) U32) instruction-count))
      )
    )
  )
  (let order (. function block-order))
  (for (in position (..< 0 (. order length)))
    (let instructions (. ([] (. function blocks) ([] order position)) instructions))
    (for (in index (..< 0 (. instructions length)))
      (let id ([] instructions index))
      (let vreg (call removable-definition function id pure-only))
      (if (== vreg no-id)
        (continue)
      )
      (= ([] (. chains vregs) id) vreg)
      (= ([] (. chains nexts) id) ([] (. chains firsts) vreg))
      (= ([] (. chains firsts) vreg) (+ id 1))
      (if (not pure-only)
        (= ([] (. chains own-reads) vreg) (+ ([] (. chains own-reads) vreg) (call own-reads function id vreg)))
      )
    )
  )
  (let pending (call IdList))
  (for (in vreg (..< 0 (. function vreg-count)))
    (if (!= ([] (. chains firsts) vreg) 0)
      (= pending (call pushed-chain function vreg chains pending))
    )
  )
  (let removed (call (of (. arena allocate) Byte) instruction-count))
  (let any false)
  (while (!= (. pending length) 0)
    (let id ([] pending (- (. pending length) 1)))
    (= pending (call IdList (. pending data) (- (. pending length) 1) (. pending capacity)))
    (let vreg ([] (. chains vregs) id))
    (if (or (!= ([] removed id) 0) (!= (call (. function use-count) vreg) ([] (. chains own-reads) vreg)))
      (continue)
    )
    (= ([] removed id) 1)
    (= any true)
    (if (not pure-only)
      (= ([] (. chains own-reads) vreg) (- ([] (. chains own-reads) vreg) (call own-reads function id vreg)))
    )
    (call (. function drop-uses) id)
    (match? ([] (. function instructions) id)
      (case (call .phi-instruction phi)
        (for (in entry (..< 0 (. phi exprs length)))
          (= pending (call pushed-definers function ([] (. phi exprs) entry) chains pending))
        )
        (continue)
      )
    )
    (let roles (call (. function operand-roles) id))
    (let operands (. ([] (. function instructions) id) operands))
    (for (in entry (..< 0 (. operands length)))
      (if (!= (/and/ (call role-at roles entry) use-role) 0)
        (= pending (call pushed-definers function ([] operands entry) chains pending))
      )
    )
  )
  (if (not any)
    (return false)
  )
  (for (in position (..< 0 (. order length)))
    (let block ([] order position))
    (let instructions (. ([] (. function blocks) block) instructions))
    (let kept U32)
    (for (in index (..< 0 (. instructions length)))
      (if (== ([] removed ([] instructions index)) 0)
        (= ([] (. instructions data) kept) ([] instructions index))
        (+= kept 1)
      )
    )
    (= (. ([] (. function blocks) block) instructions) (call IdList (. instructions data) kept (. instructions capacity)))
  )
  (return true)
)

(fn-do _ removable-definition U32
  (param function MIRFunction)
  (param id InstructionId)
  (param pure-only Bool)
  (let row no-id)
  (let opcode (. ([] (. function instructions) id) opcode))
  (if (== opcode .phi)
    (if pure-only
      (return no-id)
    )
    (match? ([] (. function instructions) id)
      (case (call .phi-instruction phi)
        (= row (call vreg-row function (. phi reg)))
      )
    )
    (else-if (and (!= opcode .call) (!= opcode .comment))
      (if (not (call is-pure-def opcode))
        (if pure-only
          (return no-id)
        )
        (let operands (. ([] (. function instructions) id) operands))
        (let is-load
          (scope (and loads (== (. operands length) 2) (not writes-back))
            (lazy loads (or (== opcode .ldr) (== opcode .ldrb) (== opcode .ldrh) (== opcode .ldrsw)))
            (lazy writes-back (call is-writeback-address function ([] operands 1)))
          )
        )
        (if (and (not is-load) (!= opcode .movk) (!= opcode .adrp) (!= opcode .adr))
          (return no-id)
        )
      )
      (= row (call (. function def-with) id opcode))
    )
  )
  (if (or (== row no-id) hinted (and pure-only (. ([] (. function vregs) row) gc-root)))
    (return no-id)
  )
  (lazy hinted (!= (. ([] (. function vregs) row) hint) no-register))
  (return (. ([] (. function vregs) row) id))
)

(fn-do _ own-reads U32
  (param function MIRFunction)
  (param id InstructionId)
  (param vreg U32)
  ; How many times a definition of `vreg` reads `vreg` itself, as a MOVK reads the value it puts
  ; bits into, or the ADD of a symbol's address reads the page its ADRP puts there. A vreg that
  ; only its own definitions read is dead along with all of them.
  (let count U32)
  (match? ([] (. function instructions) id)
    (case (call .phi-instruction phi)
      (for (in entry (..< 0 (. phi exprs length)))
        (+= count (call operand-reads function ([] (. phi exprs) entry) vreg))
      )
      (return count)
    )
  )
  (let roles (call (. function operand-roles) id))
  (let operands (. ([] (. function instructions) id) operands))
  (for (in entry (..< 0 (. operands length)))
    (if (!= (/and/ (call role-at roles entry) use-role) 0)
      (+= count (call operand-reads function ([] operands entry) vreg))
    )
  )
  (return count)
)

(fn-do _ operand-reads U32
  (param function MIRFunction)
  (param operand OperandId)
  (param vreg U32)
  (if (== operand no-operand)
    (return 0)
  )
  (match? ([] (. function operands) operand)
    (case (call .vreg-operand row)
      (return (if-expr (== (. ([] (. function vregs) (. row vreg)) id) vreg) 1 0))
    )
    (case (call .vreg-group-operand group)
      (let count U32)
      (for (in index (..< (. group vregs start) (. group vregs end)))
        (if (== (. ([] (. function vregs) ([] (. function group-vregs) index)) id) vreg)
          (+= count 1)
        )
      )
      (return count)
    )
    (case (call .load-address-operand address)
      (return
        (scope (+ (call operand-reads function (. address base) vreg) offset-reads)
          (lazy offset-reads (call operand-reads function (. address offset) vreg))
        )
      )
    )
  )
  (return 0)
)

(fn-do _ pushed-definers IdList
  (param function MIRFunction)
  (param operand OperandId)
  (param chains DefinitionChains)
  (param pending IdList)
  (if (== operand no-operand)
    (return pending)
  )
  (let result pending)
  (match? ([] (. function operands) operand)
    (case (call .vreg-operand row)
      (= result (call pushed-chain function (. ([] (. function vregs) (. row vreg)) id) chains result))
    )
    (case (call .vreg-group-operand group)
      (for (in index (..< (. group vregs start) (. group vregs end)))
        (= result
          (call pushed-chain
            (block
              (arg function)
              (arg (. ([] (. function vregs) ([] (. function group-vregs) index)) id))
              (arg chains)
              (arg result)
            )
          )
        )
      )
    )
    (case (call .load-address-operand address)
      (= result (call pushed-definers function (. address base) chains result))
      (= result (call pushed-definers function (. address offset) chains result))
    )
  )
  (return result)
)

(fn-do _ pushed-chain IdList
  (param function MIRFunction)
  (param vreg U32)
  (param chains DefinitionChains)
  (param pending IdList)
  (if (!= (call (. function use-count) vreg) ([] (. chains own-reads) vreg))
    (return pending)
  )
  (let result pending)
  (let definer ([] (. chains firsts) vreg))
  (while (!= definer 0)
    (= result (call (. result appended) (. function arena) (- definer 1)))
    (= definer ([] (. chains nexts) (- definer 1)))
  )
  (return result)
)

(fn-do _ remove-dead-comparisons Bool
  (param function MIRFunction)
  (let arena (. function arena))
  (let order (. function block-order))
  (let block-count (. function blocks length))
  (let live-in (call (of (. arena allocate) Byte) block-count))
  (let transparent (call (of (. arena allocate) Byte) block-count))
  (let work (call new-id-list arena (. order length)))
  (for (in position (..< 0 (. order length)))
    (let block ([] order position))
    (let instructions (. ([] (. function blocks) block) instructions))
    (let is-transparent true)
    (for (in index (..< 0 (. instructions length)))
      (let opcode (. ([] (. function instructions) ([] instructions index)) opcode))
      (if (call reads-flags opcode)
        (= is-transparent false)
        (= ([] live-in block) 1)
        (= work (call (. work appended) arena block))
        (break)
      )
      (if (call clobbers-flags opcode)
        (= is-transparent false)
        (break)
      )
    )
    (if is-transparent
      (= ([] transparent block) 1)
    )
  )
  (blank)
  (while (!= (. work length) 0)
    (let block ([] work (- (. work length) 1)))
    (= work (call IdList (. work data) (- (. work length) 1) (. work capacity)))
    (let predecessors (. ([] (. function blocks) block) predecessors))
    (for (in index (..< 0 (. predecessors length)))
      (let predecessor ([] predecessors index))
      (if (or (== ([] transparent predecessor) 0) (!= ([] live-in predecessor) 0))
        (continue)
      )
      (= ([] live-in predecessor) 1)
      (= work (call (. work appended) arena predecessor))
    )
  )
  (blank)
  (let removed false)
  (for (in position (..< 0 (. order length)))
    (let block ([] order position))
    (let is-live false)
    (let successors (. ([] (. function blocks) block) successors))
    (for (in index (..< 0 (. successors length)))
      (if (!= ([] live-in ([] successors index)) 0)
        (= is-live true)
      )
    )
    (let instructions (. ([] (. function blocks) block) instructions))
    (let length (. instructions length))
    (let write length)
    (let index length)
    (while (> index 0)
      (-= index 1)
      (let id ([] instructions index))
      (let opcode (. ([] (. function instructions) id) opcode))
      (if (== opcode .ccmp)
        (if (not is-live)
          (call (. function drop-uses) id)
          (= removed true)
          (continue)
        )
        (else-if (call is-flag-compare opcode)
          (if (not is-live)
            (call (. function drop-uses) id)
            (= removed true)
            (continue)
          )
          (= is-live false)
        )
        (else-if (call clobbers-flags opcode)
          (= is-live false)
        )
        (else-if (call reads-flags opcode)
          (= is-live true)
        )
      )
      (-= write 1)
      (= ([] (. instructions data) write) id)
    )
    (if (!= write 0)
      (let remaining (- length write))
      (for (in offset (..< 0 remaining))
        (= ([] (. instructions data) offset) ([] instructions (+ write offset)))
      )
      (= (. ([] (. function blocks) block) instructions)
        (call IdList
          (block
            (arg (. instructions data))
            (arg (- length write))
            (arg (. instructions capacity))
          )
        )
      )
    )
  )
  (return removed)
)

(fn-do _ is-writeback-address Bool
  (param function MIRFunction)
  (param operand OperandId)
  (match? ([] (. function operands) operand)
    (case (call .load-address-operand address)
      (return (. address is-pre-index))
    )
  )
  (return true)
)
