  (fn-do _ visit-phi _
    (param block BlockId)
    (param id InstructionId)
    (match? ([] (. function instructions) id)
      (case (call .phi-instruction phi)
        (let row (call vreg-row function (. phi reg)))
        (if (== row no-id)
          (return)
        )
        (let vreg (. ([] (. function vregs) row) id))
        (if (or (>= vreg vreg-limit) (!= ([] numbers vreg) 0))
          (return)
        )
        (= ([] visited-defs vreg) 1)
        (let own (+ vreg 1))
        (if (or (!= ([] definitions vreg) 1) (== (. phi exprs length) 0))
          (= ([] numbers vreg) own)
          (return)
        )
        (let class (as (. ([] (. function vregs) row) reg-class) U64))
        (let first (call phi-input ([] (. phi exprs) 0)))
        (let same (!= first 0))
        (for (in entry (..< 1 (. phi exprs length)))
          (if (!= (call phi-input ([] (. phi exprs) entry)) first)
            (= same false)
          )
        )
        (if (and same (== (/zrshift/ first 60) 1) (== (/and/ first 15) class))
          (= ([] numbers vreg) (call number-of-operand ([] (. phi exprs) 0)))
          (return)
        )
        (if (not (call diamond-key block phi class))
          (= ([] numbers vreg) own)
          (return)
        )
        (let slot (call find-slot))
        (if (== ([] slot-numbers slot) 0)
          (call fill-slot slot own (. phi reg) block)
          (= ([] numbers vreg) own)
          (return)
        )
        (= ([] numbers vreg) ([] slot-numbers slot))
        (let leader ([] slot-leaders slot))
        (if (and (!= leader no-operand) (call is-replaceable .phi (. phi reg) leader) leader-dominates)
          (= replaced-phis (call (. replaced-phis appended) arena id))
          (= replacing-moves
            (call (. replacing-moves appended)
              (block
                (arg arena)
                (arg (call (. builder new-assembly) (call (. builder copy-opcode) (. phi reg)) (. phi reg) leader))
              )
            )
          )
          (= changed true)
          (return)
        )
        (lazy leader-dominates (call dominates ([] slot-blocks slot) block))
        (= ([] slot-leaders slot) (. phi reg))
        (= ([] slot-blocks slot) block)
      )
    )
