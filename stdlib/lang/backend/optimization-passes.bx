(import ./aarch64-encoder)
(import ./builder)
(import ./mir)
(import ./variables-to-registers)
(import /core/arena)
(import /core/table)
(blank)
(prop _ no-condition U32 (= (. U32 max)))
(blank)
(prop _ unknown-width U32 (= 64))
(blank)
(prop _ all-bits U64 (= 0xffffffffffffffff))
(prop _ low-word U64 (= 0xffffffff))
(prop _ halfword-bits U64 (= 0xffff))
(prop _ forwarded-object-bytes U32 (= 64))

(type _ Rewrite (is U32)
  (variant unchanged)
  (variant rewritten)
  (variant dropped)
)

(type _ Condition (is U32)
  (variant equal)
  (variant unequal)
  (variant negative (= 4))
  (variant positive (= 5))
  (variant greater-equal (= 10))
  (variant less (= 11))
  (variant always (= 14))
)

(type _ Definer (is U32)
  (variant none)
  (variant several)
  (variant first)
)

(type _ LatticeState (is Byte)
  (variant top)
  (variant constant)
  (variant varying)
)

(type _ BranchState (is U32)
  (variant open)
  (variant taken)
  (variant skipped)
)

(type _ BoxUse (is U32)
  (variant unused)
  (variant loaded)
  (variant stored)
  (variant escaped)
  (variant barrier)
)

(type + MIRLocalCleanupPass
  (prop _ builder MIRBuilder)
  (prop _ function MIRFunction)
  (prop _ knows-bits Bool)
  (prop _ tracked (of CPointer U32))
  (prop _ widths (of CPointer Byte))
  (prop _ definers (of CPointer U32))
  (prop _ copies IdList)
  (prop _ firsts (of CPointer U32))
  (prop _ lasts (of CPointer U32))
  (prop _ sites IdList)
  (fn-do + This _
    (param builder MIRBuilder)
    (param knows-bits Bool (= false))
    (lazy function (. builder function))
  )
  (fn-do + run Bool
    (let simplified (call simplify-local-instructions))
    (call (. function count-uses))
    (let extensions (call simplify-extension-pairs))
    (let extended (call remove-redundant-extensions))
    (let forwarded (call forward-single-use-moves))
    (let removed (call remove-dead-definitions function true))
    (let flags-removed (call remove-dead-comparisons function))
    (if flags-removed
      (call remove-dead-definitions function true)
    )
    (return (or simplified extensions extended forwarded removed flags-removed))
  )
  (fn-do _ simplify-local-instructions Bool
    (let changed false)
    (let order (. function block-order))
    (for (in position (..< 0 (. order length)))
      (let block ([] order position))
      (let instructions (. ([] (. function blocks) block) instructions))
      (let kept U32)
      (for (in index (..< 0 (. instructions length)))
        (let id ([] instructions index))
        (let outcome (call simplify-instruction id))
        (if (!= outcome (. Rewrite unchanged))
          (= changed true)
        )
        (if (== outcome (. Rewrite dropped))
          (call (. function drop-uses) id)
          (continue)
        )
        (= ([] (. instructions data) kept) id)
        (+= kept 1)
      )
      (= (. ([] (. function blocks) block) instructions) (call IdList (. instructions data) kept (. instructions capacity)))
    )
    (return changed)
  )
  (fn-do _ simplify-instruction U32
    (param id InstructionId)
    (let arena (. function arena))
    (let opcode (. ([] (. function instructions) id) opcode))
    (let operands (. ([] (. function instructions) id) operands))
    (if (and (== opcode .mov) (call same-operand function ([] operands 0) ([] operands 1)))
      (return (. Rewrite dropped))
    )
    (if (< (. operands length) 3)
      (return (. Rewrite unchanged))
    )
    (let dest ([] operands 0))
    (let lhs ([] operands 1))
    (let is-int false)
    (let value MIRInt)
    (match? ([] (. function operands) ([] operands 2))
      (case (call .int-operand operand)
        (= is-int true)
        (= value (. operand value))
      )
    )
    (if (not is-int)
      (return (. Rewrite unchanged))
    )
    (blank)
    (let is-zero (== (. value bits) 0))
    (let is-one (and (== (. value bits) 1) (not (. value is-negative))))
    (let is-power (and (not (. value is-negative)) (> (. value bits) 1) (== (/and/ (. value bits) (- (. value bits) 1)) 0)))
    (if (or (== opcode .add) (== opcode .sub) (== opcode .orr) (== opcode .eor) is-shift)
      (if is-zero
        (return (call as-move id dest lhs))
      )
      (else-if (== opcode .mul)
        (if is-zero
          (return (call as-move id dest (call (. builder small-int) 0)))
        )
        (if is-one
          (return (call as-move id dest lhs))
        )
        (if is-power
          (call rewrite-assembly
            (block
              (arg function)
              (arg id)
              (arg .lsl)
              (arg (call triple arena dest lhs (call (. builder small-int) (call log2 (. value bits)))))
            )
          )
          (return (. Rewrite rewritten))
        )
      )
      (else-if (== opcode .udiv)
        (if is-one
          (return (call as-move id dest lhs))
        )
        (if is-power
          (call rewrite-assembly
            (block
              (arg function)
              (arg id)
              (arg .lsr)
              (arg (call triple arena dest lhs (call (. builder small-int) (call log2 (. value bits)))))
            )
          )
          (return (. Rewrite rewritten))
        )
      )
      (else-if (== opcode .and)
        (if is-zero
          (return (call as-move id dest (call (. builder small-int) 0)))
        )
      )
    )
    (lazy is-shift (or (== opcode .lsl) (== opcode .lsr) (== opcode .asr)))
    (return (. Rewrite unchanged))
  )
  (fn-do _ as-move U32
    (param id InstructionId)
    (param dest OperandId)
    (param src OperandId)
    (if (call same-operand function dest src)
      (return (. Rewrite dropped))
    )
    (call rewrite-assembly function id .mov (call pair (. function arena) dest src))
    (return (. Rewrite rewritten))
  )
  (fn-do _ simplify-extension-pairs Bool
    (let changed false)
    (let order (. function block-order))
    (for (in position (..< 0 (. order length)))
      (let block ([] order position))
      (let instructions (. ([] (. function blocks) block) instructions))
      (let kept U32)
      (for (in index (..< 0 (. instructions length)))
        (let id ([] instructions index))
        (let opcode (. ([] (. function instructions) id) opcode))
        (let bits (call extension-bits opcode))
        (if (and (!= bits 0) (call fold-extension id opcode bits instructions kept))
          (-= kept 1)
          (= changed true)
        )
        (= ([] (. instructions data) kept) id)
        (+= kept 1)
      )
      (= (. ([] (. function blocks) block) instructions) (call IdList (. instructions data) kept (. instructions capacity)))
    )
    (return changed)
  )
  (fn-do _ fold-extension Bool
    (param id InstructionId)
    (param opcode Opcode)
    (param bits U32)
    (param instructions IdList)
    (param kept U32)
    (let operands (. ([] (. function instructions) id) operands))
    (if (< (. operands length) 2)
      (return false)
    )
    (let source (call vreg-id function ([] operands 1)))
    (if (== source no-id)
      (return false)
    )
    (let previous-index (call previous-real function instructions kept))
    (if (== previous-index no-id)
      (return false)
    )
    (let previous ([] instructions previous-index))
    (let previous-def (call (. function instruction-def) previous))
    (if (or (== previous-def no-id) defines-other (. ([] (. function vregs) previous-def) gc-root))
      (return false)
    )
    (lazy defines-other (!= (. ([] (. function vregs) previous-def) id) source))
    (if (or (!= (call (. function use-count) source) 1) (> bits (call extension-bits (. ([] (. function instructions) previous) opcode))))
      (return false)
    )
    (blank)
    (call (. function drop-uses) previous)
    (let following (+ previous-index 1))
    (for (in index (..< following kept))
      (= ([] (. instructions data) (- index 1)) ([] instructions index))
    )
    (call rewrite-assembly
      (block
        (arg function)
        (arg id)
        (arg opcode)
        (arg (call pair (. function arena) ([] operands 0) ([] (. ([] (. function instructions) previous) operands) 1)))
      )
    )
    (return true)
  )
  (fn-do _ remove-redundant-extensions Bool
    (let arena (. function arena))
    (let order (. function block-order))
    (let count (. function vreg-count))
    (let candidates (call IdList))
    (for (in position (..< 0 (. order length)))
      (let block ([] order position))
      (let instructions (. ([] (. function blocks) block) instructions))
      (for (in index (..< 0 (. instructions length)))
        (let id ([] instructions index))
        (if (== (call narrow-extension-width (. ([] (. function instructions) id) opcode)) 0)
          (continue)
        )
        (let operands (. ([] (. function instructions) id) operands))
        (let dest (call vreg-id function ([] operands 0)))
        (let source (call vreg-id function ([] operands 1)))
        (if (or (== dest no-id) (== source no-id) (== dest source))
          (continue)
        )
        (if (== (. candidates length) 0)
          (= tracked (call (of (. arena allocate) U32) count))
        )
        (= ([] tracked dest) 1)
        (= ([] tracked source) 1)
        (= candidates (call (. candidates appended) arena block))
        (= candidates (call (. candidates appended) arena id))
      )
    )
    (if (== (. candidates length) 0)
      (return false)
    )
    (blank)
    (= widths (call (of (. arena allocate) Byte) count))
    (= definers (call (of (. arena allocate) U32) count))
    (= copies (call IdList))
    (= firsts (call (of (. arena allocate) U32) count))
    (= lasts (call (of (. arena allocate) U32) count))
    (= sites (call IdList))
    (for (in position (..< 0 (. order length)))
      (let instructions (. ([] (. function blocks) ([] order position)) instructions))
      (for (in index (..< 0 (. instructions length)))
        (let id ([] instructions index))
        (let roles (call (. function operand-roles) id))
        (let operands (. ([] (. function instructions) id) operands))
        (for (in entry (..< 0 (. operands length)))
          (if (!= (/and/ (call role-at roles entry) def-role) 0)
            (call note-sites id entry ([] operands entry))
          )
        )
      )
    )
    (let pending (call IdList))
    (for (in vreg (..< 0 count))
      (if (!= ([] tracked vreg) 0)
        (= pending (call (. pending appended) arena vreg))
      )
    )
    (while (!= (. pending length) 0)
      (let vreg ([] pending (- (. pending length) 1)))
      (= pending (call IdList (. pending data) (- (. pending length) 1) (. pending capacity)))
      (let site ([] firsts vreg))
      (while (!= site 0)
        (= pending (call define-site vreg (- site 1) pending))
        (= site ([] sites (+ (* (- site 1) 4) 3)))
      )
    )
    (for (in vreg (..< 0 count))
      (if (and (!= ([] tracked vreg) 0) (== ([] definers vreg) (. Definer none)))
        (= ([] widths vreg) (as unknown-width Byte))
      )
    )
    (let settled false)
    (while (not settled)
      (= settled true)
      (let index U32)
      (while (< index (. copies length))
        (let width ([] widths ([] copies (+ index 1))))
        (if (> width ([] widths ([] copies index)))
          (= ([] widths ([] copies index)) width)
          (= settled false)
        )
        (+= index 2)
      )
    )
    (blank)
    (let changed false)
    (let removed (call IdList))
    (let candidate U32)
    (while (< candidate (. candidates length))
      (let outcome (call remove-extension ([] candidates (+ candidate 1))))
      (if (!= outcome (. Rewrite unchanged))
        (= changed true)
      )
      (if (== outcome (. Rewrite dropped))
        (= removed (call (. removed appended) arena ([] candidates candidate)))
        (= removed (call (. removed appended) arena ([] candidates (+ candidate 1))))
      )
      (+= candidate 2)
    )
    (let next U32)
    (while (< next (. removed length))
      (let block ([] removed next))
      (let instructions (. ([] (. function blocks) block) instructions))
      (let kept U32)
      (for (in index (..< 0 (. instructions length)))
        (let id ([] instructions index))
        (if (and (< next (. removed length)) (== ([] removed next) block) (== ([] removed (+ next 1)) id))
          (+= next 2)
          (continue)
        )
        (= ([] (. instructions data) kept) id)
        (+= kept 1)
      )
      (= (. ([] (. function blocks) block) instructions) (call IdList (. instructions data) kept (. instructions capacity)))
    )
    (return changed)
  )
  (fn-do _ note-sites _
    (param id InstructionId)
    (param entry U32)
    (param operand OperandId)
    ; Lists where an instruction defines each vreg an operand it writes names, in the order the
    ; blocks hold them, so that each vreg a copy reaches has its definitions settled once.
    (match? ([] (. function operands) operand)
      (case (call .vreg-operand register)
        (call note-site (. ([] (. function vregs) (. register vreg)) id) id entry (. register vreg))
      )
      (case (call .vreg-group-operand group)
        (for (in index (..< (. group vregs start) (. group vregs end)))
          (call note-site (. ([] (. function vregs) ([] (. function group-vregs) index)) id) id entry no-id)
        )
      )
      (case (call .load-address-operand address)
        (if (!= (. address base) no-operand)
          (let base (call vreg-id function (. address base)))
          (if (!= base no-id)
            (call note-site base id entry no-id)
          )
        )
        (if (!= (. address offset) no-operand)
          (let offset (call vreg-id function (. address offset)))
          (if (!= offset no-id)
            (call note-site offset id entry no-id)
          )
        )
      )
    )
  )
  (fn-do _ note-site _
    (param vreg U32)
    (param id InstructionId)
    (param entry U32)
    (param row VRegId)
    (let arena (. function arena))
    (let site U32 (/ (. sites length) 4))
    (= sites (call (. sites appended) arena id))
    (= sites (call (. sites appended) arena entry))
    (= sites (call (. sites appended) arena row))
    (= sites (call (. sites appended) arena 0))
    (if (== ([] lasts vreg) 0)
      (= ([] firsts vreg) (+ site 1))
      (else
        (= ([] (. sites data) (+ (* (- ([] lasts vreg) 1) 4) 3)) (+ site 1))
      )
    )
    (= ([] lasts vreg) (+ site 1))
  )
  (fn-do _ define-site IdList
    (param vreg U32)
    (param site U32)
    (param pending IdList)
    (let id ([] sites (* site 4)))
    (let entry ([] sites (+ (* site 4) 1)))
    (let row ([] sites (+ (* site 4) 2)))
    (if (== row no-id)
      (call define vreg unknown-width id)
      (return pending)
    )
    (if (and (== entry 0) (== (. ([] (. function vregs) row) hint) no-register) knows-bits (call is-bitwise-join id))
      (call define vreg 0 id)
      (let joined (call join-source vreg ([] (. ([] (. function instructions) id) operands) 1) pending))
      (return (call join-source vreg ([] (. ([] (. function instructions) id) operands) 2) joined))
    )
    (if (or (!= entry 0) (!= (. ([] (. function vregs) row) hint) no-register) (not (call is-register-copy function id)))
      (call define vreg (if-expr (== entry 0) (call defined-width id row) unknown-width) id)
      (return pending)
    )
    (let source (call vreg-id function ([] (. ([] (. function instructions) id) operands) 1)))
    (= copies (call (. copies appended) (. function arena) vreg))
    (= copies (call (. copies appended) (. function arena) source))
    (call define vreg 0 id)
    (return (call tracks source pending))
  )
  (fn-expr _ is-bitwise-join Bool
    (param id InstructionId)
    (case? (or (and (!= opcode .orr) (!= opcode .eor)) (!= (. operands length) 3))
      false
    )
    (case? (or (== dest no-id) (== left no-id) (== right no-id))
      false
    )
    (default
      (and (== (. ([] (. function vregs) left) reg-class) reg-class) (== (. ([] (. function vregs) right) reg-class) reg-class))
    )
    (where
      (lazy opcode (. ([] (. function instructions) id) opcode))
      (lazy operands (. ([] (. function instructions) id) operands))
      (lazy dest (call vreg-row function ([] operands 0)))
      (lazy left (call vreg-row function ([] operands 1)))
      (lazy right (call vreg-row function ([] operands 2)))
      (lazy reg-class (. ([] (. function vregs) dest) reg-class))
    )
  )
  (fn-do _ join-source IdList
    (param vreg U32)
    (param operand OperandId)
    (param pending IdList)
    (let source (call vreg-id function operand))
    (= copies (call (. copies appended) (. function arena) vreg))
    (= copies (call (. copies appended) (. function arena) source))
    (return (call tracks source pending))
  )
  (fn-do _ tracks IdList
    (param vreg U32)
    (param pending IdList)
    (if (!= ([] tracked vreg) 0)
      (return pending)
    )
    (= ([] tracked vreg) 1)
    (return (call (. pending appended) (. function arena) vreg))
  )
  (fn-do _ define _
    (param vreg U32)
    (param width U32)
    (param id InstructionId)
    (if (== ([] definers vreg) (. Definer none))
      (= ([] definers vreg) (+ id (. Definer first)))
      (= ([] widths vreg) (as width Byte))
      (return)
    )
    (= ([] definers vreg) (. Definer several))
    (if (> width (as ([] widths vreg) U32))
      (= ([] widths vreg) (as width Byte))
    )
  )
  (fn-do _ defined-width U32
    (param id InstructionId)
    (param defined VRegId)
    (if (!= (. ([] (. function vregs) defined) hint) no-register)
      (return unknown-width)
    )
    (let opcode (. ([] (. function instructions) id) opcode))
    (let operands (. ([] (. function instructions) id) operands))
    (if (== opcode .cset)
      (return 1)
    )
    (if (or (== opcode .ldrb) (== opcode .uxtb))
      (return 8)
    )
    (if (or (== opcode .ldrh) (== opcode .uxth))
      (return 16)
    )
    (if (== opcode .movz)
      (if (> (. operands length) 2)
        (let shift (call known-int function ([] operands 2)))
        (if (or (not (. shift is-known)) (!= (. shift bits) 0))
          (return unknown-width)
        )
      )
      (return (call value-width (call known-int function ([] operands 1))))
    )
    (if (== opcode .mov)
      (return (call value-width (call known-int function ([] operands 1))))
    )
    (if (not knows-bits)
      (return unknown-width)
    )
    (let bits (* (call class-size (. ([] (. function vregs) defined) reg-class)) 8))
    (if (and (== opcode .and) (== (. operands length) 3))
      (let mask (call known-int function ([] operands 2)))
      (if (and (. mask is-known) (not (. mask is-negative)))
        (return (call bit-length (. mask bits)))
      )
    )
    (if (and (== opcode .lsr) (== (. operands length) 3))
      (let amount (call known-int function ([] operands 2)))
      (if (and (. amount is-known) (not (. amount is-negative)) (< (. amount bits) bits))
        (return (as (- bits (. amount bits)) U32))
      )
    )
    (if (and (== opcode .ubfx) (== (. operands length) 4))
      (let field (call known-int function ([] operands 3)))
      (if (and (. field is-known) (not (. field is-negative)) (<= (. field bits) bits))
        (return (as (. field bits) U32))
      )
    )
    (return unknown-width)
  )
  (fn-do _ remove-extension U32
    (param id InstructionId)
    (let limit (call narrow-extension-width (. ([] (. function instructions) id) opcode)))
    (if (== limit 0)
      (return (. Rewrite unchanged))
    )
    (let operands (. ([] (. function instructions) id) operands))
    (let dest-row (call vreg-row function ([] operands 0)))
    (let source-row (call vreg-row function ([] operands 1)))
    (if (or (== dest-row no-id) (== source-row no-id))
      (return (. Rewrite unchanged))
    )
    (let dest (. ([] (. function vregs) dest-row) id))
    (let source (. ([] (. function vregs) source-row) id))
    (if (or (== dest source) (> (as ([] widths source) U32) limit))
      (return (. Rewrite unchanged))
    )
    (blank)
    (let definer ([] definers source))
    (if (and (>= definer (. Definer first)) (== ([] definers dest) (+ id (. Definer first))) used-once)
      (let definition (- definer (. Definer first)))
      (let defined-row (call vreg-row function ([] (. ([] (. function instructions) definition) operands) 0)))
      (let opcode (. ([] (. function instructions) definition) opcode))
      (if (and unhinted keeps-bits (not (. ([] (. function vregs) dest-row) gc-root)) (not copies-register))
        (= ([] (. ([] (. function instructions) definition) operands data) 0) ([] operands 0))
        (= ([] definers dest) definer)
        (call (. function drop-uses) id)
        (return (. Rewrite dropped))
      )
      (lazy unhinted (== (. ([] (. function vregs) dest-row) hint) no-register))
      (lazy keeps-bits (or (and (!= opcode .lsr) (!= opcode .ubfx)) keeps-width))
      (lazy keeps-width (== (. ([] (. function vregs) defined-row) reg-class) (. ([] (. function vregs) dest-row) reg-class)))
      (lazy copies-register (call is-register-copy function definition))
    )
    (lazy used-once (== (call (. function use-count) source) 1))
    (if (== (. ([] (. function vregs) dest-row) reg-class) (. ([] (. function vregs) source-row) reg-class))
      (call rewrite-assembly function id .mov operands)
      (return (. Rewrite rewritten))
    )
    (return (. Rewrite unchanged))
  )
  (fn-do _ forward-single-use-moves Bool
    (let changed false)
    (let order (. function block-order))
    (for (in position (..< 0 (. order length)))
      (let block ([] order position))
      (let instructions (. ([] (. function blocks) block) instructions))
      (let kept U32)
      (for (in index (..< 0 (. instructions length)))
        (let id ([] instructions index))
        (let opcode (. ([] (. function instructions) id) opcode))
        (if (and (or (== opcode .mov) (== opcode .addptr)) (call forward id opcode instructions index))
          (= changed true)
          (continue)
        )
        (= ([] (. instructions data) kept) id)
        (+= kept 1)
      )
      (= (. ([] (. function blocks) block) instructions) (call IdList (. instructions data) kept (. instructions capacity)))
    )
    (return changed)
  )
  (fn-do _ forward Bool
    (param id InstructionId)
    (param opcode Opcode)
    (param instructions IdList)
    (param index U32)
    (let dest (call (. function instruction-def) id))
    (if (== dest no-id)
      (return false)
    )
    (let dest-id (. ([] (. function vregs) dest) id))
    (if (!= (call (. function use-count) dest-id) 1)
      (return false)
    )
    (let next-index (call next-real function instructions (+ index 1)))
    (if (== next-index no-id)
      (return false)
    )
    (let next ([] instructions next-index))
    (let source ([] (. ([] (. function instructions) id) operands) 1))
    (if (== opcode .addptr)
      (if (not (call is-load-address function source))
        (return false)
      )
      (return (call forward-into id next dest-id source true))
    )
    (if (. ([] (. function vregs) dest) gc-root)
      (return false)
    )
    (let next-def (call (. function instruction-def) next))
    (if (and (!= next-def no-id) (== (. ([] (. function vregs) next-def) id) dest-id))
      (return false)
    )
    (if (not (call is-forwardable-value-into next dest-id source))
      (return false)
    )
    (return (call forward-into id next dest-id source false))
  )
  (fn-do _ forward-into Bool
    (param id InstructionId)
    (param next InstructionId)
    (param vreg U32)
    (param source OperandId)
    (param is-address Bool)
    (call (. function drop-uses) next)
    (let replaced
      (block
        (case? is-address
          (call replace-address-base next vreg source)
        )
        (default
          (call replace-vreg-uses next vreg source)
        )
      )
    )
    (call (. function add-uses) next)
    (if replaced
      (call (. function drop-uses) id)
    )
    (return replaced)
  )
  (fn-do _ is-forwardable-value-into Bool
    (param id InstructionId)
    (param vreg U32)
    (param operand OperandId)
    (let is-int false)
    (let value MIRInt)
    (match? ([] (. function operands) operand)
      (case .vreg-operand
        (return true)
      )
      (case .preg-operand
        (return true)
      )
      (case (call .int-operand row)
        (= is-int true)
        (= value (. row value))
      )
    )
    (if (not is-int)
      (return false)
    )
    (let opcode (. ([] (. function instructions) id) opcode))
    (let operands (. ([] (. function instructions) id) operands))
    (for (in position (..< 0 (. operands length)))
      (if (call address-uses-vreg ([] operands position) vreg)
        (return false)
      )
      (if (and uses-vreg (not (call can-use-immediate opcode operands position value)))
        (return false)
      )
      (lazy uses-vreg (== (call vreg-id function ([] operands position)) vreg))
    )
    (return true)
  )
  (fn-do _ address-uses-vreg Bool
    (param operand OperandId)
    (param vreg U32)
    (if (== operand no-operand)
      (return false)
    )
    (match? ([] (. function operands) operand)
      (case (call .load-address-operand address)
        (if (or (== (call vreg-id function (. address base)) vreg) (== (call vreg-id function (. address offset)) vreg))
          (return true)
        )
        (return (or (call address-uses-vreg (. address base) vreg) (call address-uses-vreg (. address offset) vreg)))
      )
    )
    (return false)
  )
  (fn-expr _ can-use-immediate Bool
    (param opcode Opcode)
    (param operands IdList)
    (param position U32)
    (param value MIRInt)
    (case? (or (== opcode .add) (== opcode .sub))
      (and (== position 2) (call is-add-sub-immediate value))
    )
    (case? (== opcode .cmp)
      (and (== position 1) (call is-add-sub-immediate value))
    )
    (case? (or (== opcode .lsl) (== opcode .lsr) (== opcode .asr))
      (and (== position 2) (not (. value is-negative)) (< (. value bits) (call shift-width ([] operands 0))))
    )
    (case? (or (== opcode .and) (== opcode .orr) (== opcode .eor))
      (and (== position 2) (not (. value is-negative)) low-mask)
    )
    (default
      false
    )
    (where
      (lazy low-mask (or (== (. value bits) 0xff) (== (. value bits) 0xffff) (== (. value bits) 0xffffffff)))
    )
  )
  (fn-do _ shift-width U64
    (param dest OperandId)
    (match? ([] (. function operands) dest)
      (case (call .vreg-operand operand)
        (return (if-expr (== (. ([] (. function vregs) (. operand vreg)) reg-class) .gpr64) 64 32))
      )
      (case (call .preg-operand operand)
        (return (if-expr (== (call register-class (. operand register)) .gpr64) 64 32))
      )
    )
    (return 64)
  )
  (fn-do _ replace-vreg-uses Bool
    (param id InstructionId)
    (param vreg U32)
    (param replacement OperandId)
    (let changed false)
    (let roles (call (. function operand-roles) id))
    (let operands (. ([] (. function instructions) id) operands))
    (for (in position (..< 0 (. operands length)))
      (if (!= (/and/ (call role-at roles position) def-role) 0)
        (continue)
      )
      (let replaced (call replace-vreg-in-operand ([] operands position) vreg replacement))
      (if (!= replaced no-operand)
        (= ([] (. operands data) position) replaced)
        (= changed true)
      )
    )
    (return changed)
  )
  (fn-do _ replace-vreg-in-operand OperandId
    (param operand OperandId)
    (param vreg U32)
    (param replacement OperandId)
    (if (== (call vreg-id function operand) vreg)
      (return (call as-wide-as replacement operand))
    )
    (let is-address false)
    (let base no-operand)
    (let offset no-operand)
    (let is-pre-index false)
    (match? ([] (. function operands) operand)
      (case (call .load-address-operand address)
        (= is-address true)
        (= base (. address base))
        (= offset (. address offset))
        (= is-pre-index (. address is-pre-index))
      )
    )
    (if (not is-address)
      (return no-operand)
    )
    (let new-base (call replace-vreg-in-operand base vreg replacement))
    (let new-offset no-operand)
    (if (!= offset no-operand)
      (= new-offset (call replace-vreg-in-operand offset vreg replacement))
    )
    (if (and (== new-base no-operand) (== new-offset no-operand))
      (return no-operand)
    )
    (if (== new-base no-operand)
      (= new-base base)
    )
    (if (== new-offset no-operand)
      (= new-offset offset)
    )
    (return (call (. builder add-operand) (call LoadAddressOperand new-base new-offset is-pre-index)))
  )
  (fn-do _ as-wide-as OperandId
    (param replacement OperandId)
    (param use OperandId)
    ; A replacement for a use of a register, read at the use's width: a use of the low 32 bits of a
    ; register reads the low 32 bits of a 64-bit replacement.
    (let use-row (call vreg-row function use))
    (return-if replacement (if (or (== use-row no-id) (!= (. ([] (. function vregs) use-row) reg-class) .gpr32))))
    (blank)
    (match? ([] (. function operands) replacement)
      (case .vreg-operand
        (return (call (. builder narrow-view) replacement))
      )
      (case (call .preg-operand operand)
        (if (== (call register-class (. operand register)) .gpr64)
          (return (call (. builder preg) (call register-view (. operand register) .gpr32)))
        )
      )
    )
    (return replacement)
  )
  (fn-do _ replace-address-base Bool
    (param id InstructionId)
    (param vreg U32)
    (param replacement OperandId)
    (let changed false)
    (let roles (call (. function operand-roles) id))
    (let operands (. ([] (. function instructions) id) operands))
    (for (in position (..< 0 (. operands length)))
      (if (!= (/and/ (call role-at roles position) def-role) 0)
        (continue)
      )
      (let operand ([] operands position))
      (let base no-operand)
      (match? ([] (. function operands) operand)
        (case (call .load-address-operand address)
          (= base (. address base))
        )
      )
      (if (or (== base no-operand) (!= (call vreg-id function base) vreg))
        (continue)
      )
      (let merged (call merge-addresses replacement operand))
      (if (and (!= merged no-operand) (call is-encodable-address id merged))
        (= ([] (. operands data) position) merged)
        (= changed true)
      )
    )
    (return changed)
  )
  (fn-do _ merge-addresses OperandId
    (param base OperandId)
    (param address OperandId)
    (let base-register no-operand)
    (let base-offset no-operand)
    (match? ([] (. function operands) base)
      (case (call .load-address-operand row)
        (= base-register (. row base))
        (= base-offset (. row offset))
      )
    )
    (let use-offset no-operand)
    (let is-pre-index false)
    (match? ([] (. function operands) address)
      (case (call .load-address-operand row)
        (= use-offset (. row offset))
        (= is-pre-index (. row is-pre-index))
      )
    )
    (blank)
    (if (== base-offset no-operand)
      (return (call (. builder add-operand) (call LoadAddressOperand base-register use-offset is-pre-index)))
    )
    (if (== use-offset no-operand)
      (return base)
    )
    (let used (call known-int function use-offset))
    (if (and (. used is-known) (== (. used bits) 0))
      (return base)
    )
    (let based (call known-int function base-offset))
    (if (or (not (. based is-known)) (not (. used is-known)))
      (return no-operand)
    )
    (let sum (+ (call signed-value based) (call signed-value used)))
    (return (call (. builder add-operand) (call LoadAddressOperand base-register (call (. builder small-int) sum) is-pre-index)))
  )
  (fn-do _ is-encodable-address Bool
    (param id InstructionId)
    (param address OperandId)
    (let opcode (. ([] (. function instructions) id) opcode))
    (let offset-operand no-operand)
    (let is-pre-index false)
    (match? ([] (. function operands) address)
      (case (call .load-address-operand row)
        (= offset-operand (. row offset))
        (= is-pre-index (. row is-pre-index))
      )
    )
    (let offset (call Known true 0 false))
    (let is-label false)
    (let is-page-offset false)
    (if (!= offset-operand no-operand)
      (= offset (call known-int function offset-operand))
      (match? ([] (. function operands) offset-operand)
        (case (call .label-operand label)
          (= is-label true)
          (= is-page-offset (== (. label reloc) .pageoff-reloc))
        )
      )
    )
    (blank)
    (if (or (== opcode .ldar) (== opcode .ldarb) (== opcode .stlrb))
      (return (and (not is-pre-index) (. offset is-known) (== (. offset bits) 0)))
    )
    (if (not (call is-load-store opcode))
      (return true)
    )
    (let operands (. ([] (. function instructions) id) operands))
    (if is-label
      (return
        (scope (and is-page-offset (not is-pre-index) (== (call pair-scale opcode operands) 0) byte-access)
          (lazy byte-access (== (call access-size opcode operands) 1))
        )
      )
    )
    (if (not (. offset is-known))
      (return false)
    )
    (if (and (not (. offset is-negative)) (> (. offset bits) 0x7fffffffffffffff))
      (return false)
    )
    (let value (as (. offset bits) I64))
    (if is-pre-index
      (return (call fits-signed-bits value 9))
    )
    (let scale (call pair-scale opcode operands))
    (if (!= scale 0)
      (return (and (== (% value scale) 0) (call fits-signed-bits (/ value scale) 7)))
    )
    (let size (call access-size opcode operands))
    (if (and (>= value 0) (== (% value size) 0) (<= (/ value size) 4095))
      (return true)
    )
    (return (call fits-signed-bits value 9))
  )
  (fn-expr _ access-size I64
    (param opcode Opcode)
    (param operands IdList)
    (case? (or (== opcode .ldrb) (== opcode .strb) (== opcode .ldrsb))
      1
    )
    (case? (or (== opcode .ldrh) (== opcode .strh) (== opcode .ldrsh))
      2
    )
    (case? (== opcode .ldrsw)
      4
    )
    (default
      (call operand-access-size ([] operands 0))
    )
  )
  (fn-expr _ pair-scale I64
    (param opcode Opcode)
    (param operands IdList)
    (if-expr (and (!= opcode .ldp) (!= opcode .stp)) 0 (call operand-access-size ([] operands 0)))
  )
  (fn-do _ operand-access-size I64
    (param operand OperandId)
    (let reg-class RegClass .gpr64)
    (match? ([] (. function operands) operand)
      (case (call .vreg-operand row)
        (= reg-class (. ([] (. function vregs) (. row vreg)) reg-class))
      )
      (case (call .preg-operand row)
        (= reg-class (call register-class (. row register)))
      )
    )
    (if (or (== reg-class .gpr32) (== reg-class .fpr32))
      (return 4)
    )
    (return 8)
  )
)

(type + MIRConstantFoldingPass
  (prop _ builder MIRBuilder)
  (prop _ function MIRFunction)
  (prop _ definitions (of CPointer U32))
  (prop _ chained (of CPointer Byte))
  (prop _ chain-values (of CPointer U64))
  (prop _ states (of CPointer Byte))
  (prop _ values (of CPointer U64))
  (prop _ live (of CPointer Byte))
  (prop _ edges (of CPointer IdList))
  (prop _ flags-state Byte (= 2))
  (prop _ flags-left U64)
  (prop _ flags-right U64)
  (prop _ flags-width U64 (= 64))
  (prop _ changed Bool)
  (prop _ owners (of CPointer U32))
  (prop _ owner-blocks (of CPointer U32))
  (prop _ seen (of CPointer U32))
  (prop _ table-flags (of CPointer U32))
  (prop _ generation U32)
  (prop _ known-flag OperandId (= no-operand))
  (prop _ unknown-flag OperandId (= no-operand))
  (prop _ derived-vregs IdList)
  (prop _ derived-offsets IdList)
  (prop _ derived-rows IdList)
  (prop _ derived-blocks IdList)
  (prop _ promoted-objects IdList)
  (fn-do + This _
    (param builder MIRBuilder)
    (lazy function (. builder function))
  )
  (fn-do + run Bool
    (if (== (. function block-order length) 0)
      (return false)
    )
    (call count-definitions)
    (if (call settle-inlined-names)
      (call count-definitions)
    )
    (let forwarded (call rewrite-allocations false))
    (if (call rewrite-allocations true)
      (= forwarded true)
    )
    (if (call promote-allocations)
      (= forwarded true)
      (call count-definitions)
    )
    (let arena (. function arena))
    (let block-count (. function blocks length))
    (= states (call (of (. arena allocate) Byte) (. function vreg-count)))
    (= values (call (of (. arena allocate) U64) (. function vreg-count)))
    (= live (call (of (. arena allocate) Byte) block-count))
    (= edges (call (of (. arena allocate) IdList) block-count))
    (for (in vreg (..< 0 (. function vreg-count)))
      (= ([] states vreg) (if-expr starts-top (. LatticeState top) (. LatticeState varying)))
      (lazy starts-top (or (== ([] definitions vreg) 1) (!= ([] chained vreg) 0)))
    )
    (let post (call (. function post-order)))
    (if (== (. post length) 0)
      (return forwarded)
    )
    (= ([] live ([] post (- (. post length) 1))) 1)
    (= changed true)
    (while changed
      (= changed false)
      (for (in back (..< 0 (. post length)))
        (let block ([] post (- (. post length) 1 back)))
        (if (!= ([] live block) 0)
          (call visit block)
        )
      )
    )
    (let folded false)
    (let order (. function block-order))
    (for (in position (..< 0 (. order length)))
      (let block ([] order position))
      (if (and (!= ([] live block) 0) (call fold-block block))
        (= folded true)
      )
    )
    (let dropped (call drop-dead-edges))
    (if (or dropped folded)
      (call repair-predecessors function)
      (call (. builder prune-unreachable-blocks))
      (call drop-unaddressed-tables)
    )
    (let merged (call remove-trivial-phis))
    (let removed (call remove-dead-definitions function))
    (let reallocated false)
    (if (or dropped folded merged)
      (call count-definitions)
      (= reallocated (call rewrite-allocations false))
      (if (call rewrite-allocations true)
        (= reallocated true)
      )
      (if (call promote-allocations)
        (= reallocated true)
      )
    )
    (return (or forwarded dropped folded merged removed reallocated))
  )
  (fn-do _ drop-unaddressed-tables _
    ; Drops each jump table no instruction addresses any more, where a folded branch now goes
    ; around the dispatch that read it: the blocks it names may since merge or go.
    (let kept Size 0)
    (for (in index (..< 0 (. function jump-tables length)))
      (if (call addressed (. ([] (. function jump-tables) index) name))
        (if (!= kept index)
          (= (. ([] (. function jump-tables) kept) name) (. ([] (. function jump-tables) index) name))
          (= (. ([] (. function jump-tables) kept) labels) (. ([] (. function jump-tables) index) labels))
        )
        (+= kept 1)
      )
    )
    (call (. function jump-tables truncate) kept)
  )
  (fn-do _ addressed Bool
    (param name StringId)
    (let order (. function block-order))
    (for (in position (..< 0 (. order length)))
      (let instructions (. ([] (. function blocks) ([] order position)) instructions))
      (for (in index (..< 0 (. instructions length)))
        (let operands (. ([] (. function instructions) ([] instructions index)) operands))
        (for (in operand (..< 0 (. operands length)))
          (if (== (call label-name function ([] operands operand)) name)
            (return true)
          )
        )
      )
    )
    (return false)
  )
  (fn-do _ settle-inlined-names Bool
    (let arena (. function arena))
    (let sites (call IdList))
    (let homes (call IdList))
    (let order (. function block-order))
    (for (in position (..< 0 (. order length)))
      (let instructions (. ([] (. function blocks) ([] order position)) instructions))
      (for (in index (..< 0 (. instructions length)))
        (if (== (. ([] (. function instructions) ([] instructions index)) opcode) .inlined-name)
          (= sites (call (. sites appended) arena ([] instructions index)))
          (= homes (call (. homes appended) arena ([] order position)))
        )
      )
    )
    (if (== (. sites length) 0)
      (return false)
    )
    (let count (. function vreg-count))
    (= owners (call (of (. arena allocate) U32) count))
    (= owner-blocks (call (of (. arena allocate) U32) count))
    (= seen (call (of (. arena allocate) U32) count))
    (= table-flags (call (of (. arena allocate) U32) count))
    (for (in vreg (..< 0 count))
      (= ([] owners vreg) no-id)
      (= ([] seen vreg) 0)
      (= ([] table-flags vreg) no-operand)
    )
    (= known-flag no-operand)
    (= unknown-flag no-operand)
    (for (in position (..< 0 (. order length)))
      (let block ([] order position))
      (let instructions (. ([] (. function blocks) block) instructions))
      (for (in index (..< 0 (. instructions length)))
        (let id ([] instructions index))
        (match? ([] (. function instructions) id)
          (case (call .phi-instruction phi)
            (call own (. phi reg) id block)
            (continue)
          )
        )
        (let roles (call (. function operand-roles) id))
        (let operands (. ([] (. function instructions) id) operands))
        (for (in entry (..< 0 (. operands length)))
          (if (!= (/and/ (call role-at roles entry) def-role) 0)
            (call own ([] operands entry) id block)
          )
        )
      )
    )
    (for (in index (..< 0 (. sites length)))
      (call settle-inlined-name ([] homes index) ([] sites index))
    )
    (return true)
  )
  (fn-do _ own _
    (param operand OperandId)
    (param id InstructionId)
    (param block BlockId)
    (let vreg (call vreg-id function operand))
    (if (!= vreg no-id)
      (= ([] owners vreg) id)
      (= ([] owner-blocks vreg) block)
    )
  )
  (fn-do _ settle-inlined-name _
    (param block BlockId)
    (param id InstructionId)
    (let arena (. function arena))
    (let operands (. ([] (. function instructions) id) operands))
    (let dest ([] operands 0))
    (let descriptor ([] operands 1))
    (let fallback ([] operands 2))
    (let table (call described-table descriptor))
    (+= generation 1)
    (let kind (if-expr (== table no-operand) 2u32 (call table-kind table)))
    (if (== kind 1)
      (call rewrite-assembly
        (block
          (arg function)
          (arg id)
          (arg .ldr)
          (arg (call pair arena dest (call (. builder load-address-offset) descriptor 0)))
        )
      )
      (return)
    )
    (if (!= kind 3)
      (call rewrite-assembly function id .mov (call pair arena dest fallback))
      (return)
    )
    (let flag (call table-flag table))
    (let name (call (. builder vreg) .gpr64))
    (call rewrite-assembly function id .ldr (call pair arena name (call (. builder load-address-offset) descriptor 0)))
    (let compare (call (. builder new-assembly) .cmp flag (call (. builder small-int) 0)))
    (let select
      (call (. builder new-assembly)
        (block
          (arg .csel)
          (arg dest)
          (arg name)
          (arg fallback)
          (arg (call (. builder add-operand) (call CondOperand (. Condition unequal))))
        )
      )
    )
    (let instructions (. ([] (. function blocks) block) instructions))
    (for (in index (..< 0 (. instructions length)))
      (if (== ([] instructions index) id)
        (= (. ([] (. function blocks) block) instructions) (call (. (call (. instructions inserted) arena (+ index 1) compare) inserted) arena (+ index 2) select))
        (return)
      )
    )
  )
  (fn-do _ described-table OperandId
    (param descriptor OperandId)
    (let vreg (call vreg-id function descriptor))
    (if (or (== vreg no-id) (!= ([] definitions vreg) 1) (== ([] owners vreg) no-id))
      (return no-operand)
    )
    (let row ([] (. function instructions) ([] owners vreg)))
    (if (or (!= (. row opcode) .ldr) (!= (. row operands length) 2))
      (return no-operand)
    )
    (match? ([] (. function operands) ([] (. row operands) 1))
      (case (call .load-address-operand address)
        (if (. address is-pre-index)
          (return no-operand)
        )
        (if (!= (. address offset) no-operand)
          (let offset (call known-int function (. address offset)))
          (if (or (not (. offset is-known)) (!= (. offset bits) 0))
            (return no-operand)
          )
        )
        (return (. address base))
      )
    )
    (return no-operand)
  )
  (fn-do _ table-kind U32
    (param operand OperandId)
    (let vreg (call vreg-id function operand))
    (if (or (== vreg no-id) (== ([] owners vreg) no-id))
      (return 2)
    )
    (if (== ([] seen vreg) generation)
      (return 0)
    )
    (= ([] seen vreg) generation)
    (match? ([] (. function instructions) ([] owners vreg))
      (case (call .phi-instruction phi)
        (let kind U32)
        (for (in entry (..< 0 (. phi exprs length)))
          (= kind (/or/ kind (call table-kind ([] (. phi exprs) entry))))
        )
        (return kind)
      )
      (case (call .assembly-instruction row)
        (if (call is-table-address vreg (. row opcode) (. row operands))
          (return 1)
        )
        (if (and (== (. row opcode) .mov) (== (. row operands length) 2) (== ([] definitions vreg) 1))
          (return (call table-kind ([] (. row operands) 1)))
        )
      )
    )
    (return 2)
  )
  (fn-do _ table-flag OperandId
    (param operand OperandId)
    (let vreg (call vreg-id function operand))
    (if (or (== vreg no-id) (== ([] owners vreg) no-id))
      (return (call constant-flag false))
    )
    (if (!= ([] table-flags vreg) no-operand)
      (return ([] table-flags vreg))
    )
    (match? ([] (. function instructions) ([] owners vreg))
      (case (call .phi-instruction phi)
        (let flag (call (. builder vreg) .gpr64))
        (= ([] table-flags vreg) flag)
        (let exprs (call IdList))
        (for (in entry (..< 0 (. phi exprs length)))
          (= exprs (call (. exprs appended) (. function arena) (call table-flag ([] (. phi exprs) entry))))
        )
        (let saved (. builder insertion-block))
        (= (. builder insertion-block) ([] owner-blocks vreg))
        (call (. builder phi-of) flag exprs (. phi blocks))
        (= (. builder insertion-block) saved)
        (return flag)
      )
      (case (call .assembly-instruction row)
        (if (call is-table-address vreg (. row opcode) (. row operands))
          (return (call constant-flag true))
        )
        (if (and (== (. row opcode) .mov) (== (. row operands length) 2) (== ([] definitions vreg) 1))
          (let flag (call table-flag ([] (. row operands) 1)))
          (= ([] table-flags vreg) flag)
          (return flag)
        )
      )
    )
    (return (call constant-flag false))
  )
  (fn-do _ constant-flag OperandId
    (param known Bool)
    (let existing (if-expr known known-flag unknown-flag))
    (if (!= existing no-operand)
      (return existing)
    )
    (let flag (call (. builder vreg) .gpr64))
    (let made
      (call (. builder new-assembly)
        (block
          (arg .movz)
          (arg flag)
          (arg (call (. builder small-int) (if-expr known 1 0)))
          (arg (call (. builder small-int) 0))
        )
      )
    )
    (let entry ([] (. function block-order) 0))
    (= (. ([] (. function blocks) entry) instructions)
      (call (. ([] (. function blocks) entry) instructions inserted)
        (block
          (arg (. function arena))
          (arg 0)
          (arg made)
        )
      )
    )
    (if known
      (= known-flag flag)
      (else
        (= unknown-flag flag)
      )
    )
    (return flag)
  )
  (fn-expr _ is-table-address Bool
    (param vreg U32)
    (param opcode Opcode)
    (param operands IdList)
    (case? (and (== opcode .adr) (== (. operands length) 2) (== ([] definitions vreg) 1))
      (call is-symbolic ([] operands 1))
    )
    (case? (or (!= opcode .add) (!= (. operands length) 3) (not (call is-symbolic ([] operands 2))))
      false
    )
    (default
      (or (== ([] definitions vreg) 1) (and (== ([] definitions vreg) 2) (== (call vreg-id function ([] operands 1)) vreg)))
    )
  )
  (fn-do _ is-symbolic Bool
    (param operand OperandId)
    (match? ([] (. function operands) operand)
      (case .symbol-operand
        (return true)
      )
      (case .label-operand
        (return true)
      )
    )
    (return false)
  )
  (fn-do _ count-definitions _
    (= definitions (call (of (. function arena allocate) U32) (. function vreg-count)))
    (let order (. function block-order))
    (for (in position (..< 0 (. order length)))
      (let instructions (. ([] (. function blocks) ([] order position)) instructions))
      (for (in index (..< 0 (. instructions length)))
        (let id ([] instructions index))
        (match? ([] (. function instructions) id)
          (case (call .phi-instruction phi)
            (call define (. phi reg) 1)
            (continue)
          )
        )
        (let roles (call (. function operand-roles) id))
        (let operands (. ([] (. function instructions) id) operands))
        (for (in entry (..< 0 (. operands length)))
          (if (!= (/and/ (call role-at roles entry) def-role) 0)
            (call define ([] operands entry) 1)
          )
        )
      )
    )
    (call find-constant-chains)
  )
  (fn-do _ find-constant-chains _
    ; Marks each vreg that only a MOVZ or MOVN and the MOVKs right after it define, with the constant
    ; they build together.
    (let arena (. function arena))
    (= chained (call (of (. arena allocate) Byte) (. function vreg-count)))
    (= chain-values (call (of (. arena allocate) U64) (. function vreg-count)))
    (let order (. function block-order))
    (for (in position (..< 0 (. order length)))
      (let instructions (. ([] (. function blocks) ([] order position)) instructions))
      (let index U32)
      (while (< index (. instructions length))
        (let id ([] instructions index))
        (+= index 1)
        (let opcode (. ([] (. function instructions) id) opcode))
        (if (and (!= opcode .movz) (!= opcode .movn))
          (continue)
        )
        (let row (call (. function instruction-def) id))
        (let part (call wide-part id))
        (if (or (== row no-id) (>= (. part shift) 64))
          (continue)
        )
        (let vreg (. ([] (. function vregs) row) id))
        (let bits (if-expr (== opcode .movz) (. part bits) (/xor/ (. part bits) all-bits)))
        (let count U32 1)
        (while (< index (. instructions length))
          (let next ([] instructions index))
          (let next-row (call (. function instruction-def) next))
          (if (or not-movk (== next-row no-id) (!= (. ([] (. function vregs) next-row) id) vreg))
            (break)
          )
          (lazy not-movk (!= (. ([] (. function instructions) next) opcode) .movk))
          (let inserted (call wide-part next))
          (if (>= (. inserted shift) 64)
            (break)
          )
          (let field U64 0xffff)
          (= bits (/or/ (/and/ bits (/xor/ (/lshift/ field (. inserted shift)) all-bits)) (. inserted bits)))
          (+= count 1)
          (+= index 1)
        )
        (if (and (> count 1) (== ([] definitions vreg) count))
          (= ([] chained vreg) 1)
          (= ([] chain-values vreg) bits)
        )
      )
    )
  )
  (fn-expr _ wide-part WidePart
    (param id InstructionId)
    (case? (!= (. operands length) 3)
      (call WidePart 0 64)
    )
    (case? (or (not (. immediate is-known)) (not (. shift is-known)) (> (. immediate bits) 0xffff) (>= (. shift bits) 64))
      (call WidePart 0 64)
    )
    (default
      (call WidePart (/lshift/ (. immediate bits) (. shift bits)) (. shift bits))
    )
    (where
      (lazy operands (. ([] (. function instructions) id) operands))
      (lazy immediate (call known-int function ([] operands 1)))
      (lazy shift (call known-int function ([] operands 2)))
    )
  )
  (fn-do _ define _
    (param operand OperandId)
    (param weight U32)
    (match? ([] (. function operands) operand)
      (case (call .vreg-operand row)
        (let vreg (. ([] (. function vregs) (. row vreg)) id))
        (= ([] definitions vreg) (+ ([] definitions vreg) weight))
      )
      (case (call .vreg-group-operand group)
        (for (in index (..< (. group vregs start) (. group vregs end)))
          (let vreg (. ([] (. function vregs) ([] (. function group-vregs) index)) id))
          (= ([] definitions vreg) (+ ([] definitions vreg) 2))
        )
      )
      (case (call .load-address-operand address)
        (call define (. address base) 2)
      )
    )
  )
  (fn-do _ visit _
    (param block BlockId)
    (= flags-state (. LatticeState varying))
    (let instructions (. ([] (. function blocks) block) instructions))
    (for (in index (..< 0 (. instructions length)))
      (let id ([] instructions index))
      (let opcode (. ([] (. function instructions) id) opcode))
      (if (== opcode .comment)
        (continue)
      )
      (if (== opcode .phi)
        (call visit-phi block id)
        (continue)
      )
      (if (== opcode .b)
        (call follow block (call first-operand function id))
        (return)
      )
      (if (or (== opcode .cbz) (== opcode .cbnz) (== opcode .b-cond))
        (let decision (call decide id))
        (if (!= decision (. BranchState skipped))
          (call follow block (call conditional-branch-target function id))
        )
        (if (== decision (. BranchState taken))
          (return)
        )
        (continue)
      )
      (if (or (== opcode .br) (== opcode .ret))
        (call follow-all block)
        (return)
      )
      (call evaluate id)
      (if (call has-panic-target id)
        (call follow-all block)
      )
    )
    (call follow-all block)
  )
  (fn-do _ visit-phi _
    (param block BlockId)
    (param id InstructionId)
    (match? ([] (. function instructions) id)
      (case (call .phi-instruction phi)
        (let merged (call Lattice (. LatticeState top) 0))
        (for (in entry (..< 0 (. phi blocks length)))
          (let source (call (. builder get-block) ([] (. phi blocks) entry)))
          (if (or (== source no-id) (not (call includes ([] edges source) block)))
            (continue)
          )
          (= merged (call meet merged (call value-of ([] (. phi exprs) entry))))
        )
        (call settle (. phi reg) merged)
      )
    )
  )
  (fn-do _ has-panic-target Bool
    (param id InstructionId)
    (match? ([] (. function instructions) id)
      (case (call .call-instruction call)
        (return (!= (. call panic-target) no-operand))
      )
    )
    (return false)
  )
  (fn-do _ follow _
    (param block BlockId)
    (param target OperandId)
    (let name (call label-name function target))
    (let successor (if-expr (== name no-string) no-id (call (. builder get-block) name)))
    (if (== successor no-id)
      (call follow-all block)
      (return)
    )
    (call mark block successor)
  )
  (fn-do _ follow-all _
    (param block BlockId)
    (let successors (. ([] (. function blocks) block) successors))
    (for (in index (..< 0 (. successors length)))
      (call mark block ([] successors index))
    )
  )
  (fn-do _ mark _
    (param block BlockId)
    (param successor BlockId)
    (if (call includes ([] edges block) successor)
      (return)
    )
    (= ([] edges block) (call (. ([] edges block) appended) (. function arena) successor))
    (= ([] live successor) 1)
    (= changed true)
  )
  (fn-do _ evaluate _
    (param id InstructionId)
    (let opcode (. ([] (. function instructions) id) opcode))
    (if (== opcode .cmp)
      (call compare id)
      (return)
    )
    (call clobber opcode)
    (let roles (call (. function operand-roles) id))
    (let operands (. ([] (. function instructions) id) operands))
    (let result (call compute id))
    (for (in position (..< 0 (. operands length)))
      (if (!= (/and/ (call role-at roles position) def-role) 0)
        (call settle
          (block
            (arg ([] operands position))
            (arg (if-expr (== position 0) result (call Lattice (. LatticeState varying) 0)))
          )
        )
      )
    )
  )
  (fn-do _ clobber _
    (param opcode Opcode)
    (if (or (call is-flag-compare opcode) (call clobbers-flags opcode) (== opcode .gc-alloc) (== opcode .gc-barrier))
      (= flags-state (. LatticeState varying))
    )
  )
  (fn-do _ compare _
    (param id InstructionId)
    (let operands (. ([] (. function instructions) id) operands))
    (if (!= (. operands length) 2)
      (= flags-state (. LatticeState varying))
      (return)
    )
    (let left (call value-of ([] operands 0)))
    (let right (call value-of ([] operands 1)))
    (= flags-state (call merged-state left right))
    (= flags-left (. left bits))
    (= flags-right (. right bits))
    (= flags-width (if-expr (== (call operand-mask ([] operands 0)) low-word) 32 64))
  )
  (fn-do _ settle _
    (param operand OperandId)
    (param value Lattice)
    (let row (call vreg-row function operand))
    (if (== row no-id)
      (return)
    )
    (let vreg (. ([] (. function vregs) row) id))
    (let current ([] states vreg))
    (if (or (== current (. LatticeState varying)) (== (. value state) (. LatticeState top)))
      (return)
    )
    (let mask (call class-mask (. ([] (. function vregs) row) reg-class)))
    (if (and (== (. value state) (. LatticeState constant)) (!= mask 0))
      (let bits (/and/ (. value bits) mask))
      (if (and (== current (. LatticeState constant)) (== ([] values vreg) bits))
        (return)
      )
      (if (== current (. LatticeState top))
        (= ([] states vreg) (. LatticeState constant))
        (= ([] values vreg) bits)
        (= changed true)
        (return)
      )
    )
    (= ([] states vreg) (. LatticeState varying))
    (= changed true)
  )
  (fn-do _ value-of Lattice
    (param operand OperandId)
    (if (== operand no-operand)
      (return (call Lattice (. LatticeState varying) 0))
    )
    (match? ([] (. function operands) operand)
      (case (call .int-operand row)
        (return (call Lattice (. LatticeState constant) (. row value bits)))
      )
      (case (call .vreg-operand row)
        (let vreg (. ([] (. function vregs) (. row vreg)) id))
        (let state ([] states vreg))
        (if (!= state (. LatticeState constant))
          (return (call Lattice state 0))
        )
        (return (call Lattice state (/and/ ([] values vreg) (call class-mask (. ([] (. function vregs) (. row vreg)) reg-class)))))
      )
      (case (call .preg-operand row)
        (if (or (== (. row register) zero-register) (== (. row register) zero-register-32))
          (return (call Lattice (. LatticeState constant) 0))
        )
      )
    )
    (return (call Lattice (. LatticeState varying) 0))
  )
  (fn-expr _ operand-mask U64
    (param operand OperandId)
    (if-expr (== row no-id) 0 (call class-mask (. ([] (. function vregs) row) reg-class)))
    (where
      (lazy row (call vreg-row function operand))
    )
  )
  (fn-do _ compute Lattice
    (param id InstructionId)
    (let varying (call Lattice (. LatticeState varying) 0))
    (let opcode (. ([] (. function instructions) id) opcode))
    (let operands (. ([] (. function instructions) id) operands))
    (let count (. operands length))
    (if (or (< count 2) (== (call operand-mask ([] operands 0)) 0))
      (return varying)
    )
    (if (or (== opcode .movz) (== opcode .movn) (== opcode .movk))
      (let row (call vreg-row function ([] operands 0)))
      (if (and (!= row no-id) (!= ([] chained (. ([] (. function vregs) row) id)) 0))
        (return (call Lattice (. LatticeState constant) ([] chain-values (. ([] (. function vregs) row) id))))
      )
    )
    (if (or (== opcode .movz) (== opcode .movn))
      (if (!= count 3)
        (return varying)
      )
      (let immediate (call value-of ([] operands 1)))
      (let shift (call value-of ([] operands 2)))
      (let state (call merged-state immediate shift))
      (if (or (!= state (. LatticeState constant)) (>= (. shift bits) 64))
        (return (if-expr (!= state (. LatticeState constant)) (call Lattice state 0) varying))
      )
      (let shifted (/lshift/ (. immediate bits) (. shift bits)))
      (return (call Lattice state (if-expr (== opcode .movz) shifted (/xor/ shifted all-bits))))
    )
    (if (== opcode .mov)
      (return (if-expr (== count 2) (call value-of ([] operands 1)) varying))
    )
    (if (== opcode .cset)
      (return (if-expr (== count 2) (call holds ([] operands 1)) varying))
    )
    (if (== opcode .csel)
      (if (!= count 4)
        (return varying)
      )
      (let held (call holds ([] operands 3)))
      (if (!= (. held state) (. LatticeState constant))
        (return held)
      )
      (return (if-expr (!= (. held bits) 0) (call value-of ([] operands 1)) (call value-of ([] operands 2))))
    )
    (if (== count 2)
      (let input (call value-of ([] operands 1)))
      (if (!= (. input state) (. LatticeState constant))
        (return input)
      )
      (return (call unary opcode (. input bits)))
    )
    (if (!= count 3)
      (return varying)
    )
    (let left (call value-of ([] operands 1)))
    (let right (call value-of ([] operands 2)))
    (let state (call merged-state left right))
    (if (!= state (. LatticeState constant))
      (return (call Lattice state 0))
    )
    (return (call binary opcode (. left bits) (. right bits) (call operand-mask ([] operands 0))))
  )
  (fn-expr _ unary Lattice
    (param opcode Opcode)
    (param bits U64)
    (match opcode
      (case= .neg
        (call Lattice (. LatticeState constant) (- 0 bits))
      )
      (case= .mvn
        (call Lattice (. LatticeState constant) (/xor/ bits all-bits))
      )
      (case= .uxtb
        (call Lattice (. LatticeState constant) (/and/ bits 0xff))
      )
      (case= .uxth
        (call Lattice (. LatticeState constant) (/and/ bits 0xffff))
      )
      (case= .uxtw
        (call Lattice (. LatticeState constant) (/and/ bits low-word))
      )
      (case= .sxtb
        (call Lattice (. LatticeState constant) (call sign-extended bits 8))
      )
      (case= .sxth
        (call Lattice (. LatticeState constant) (call sign-extended bits 16))
      )
      (case= .sxtw
        (call Lattice (. LatticeState constant) (call sign-extended bits 32))
      )
      (default
        (call Lattice (. LatticeState varying) 0)
      )
    )
  )
  (fn-do _ binary Lattice
    (param opcode Opcode)
    (param left U64)
    (param right U64)
    (param mask U64)
    (let width U64 (if-expr (== mask low-word) 32 64))
    (if (== opcode .add)
      (return (call Lattice (. LatticeState constant) (+ left right)))
    )
    (if (== opcode .sub)
      (return (call Lattice (. LatticeState constant) (- left right)))
    )
    (if (== opcode .mul)
      (return (call Lattice (. LatticeState constant) (* left right)))
    )
    (if (== opcode .and)
      (return (call Lattice (. LatticeState constant) (/and/ left right)))
    )
    (if (== opcode .orr)
      (return (call Lattice (. LatticeState constant) (/or/ left right)))
    )
    (if (== opcode .eor)
      (return (call Lattice (. LatticeState constant) (/xor/ left right)))
    )
    (if (>= right width)
      (return (call Lattice (. LatticeState varying) 0))
    )
    (if (== opcode .lsl)
      (return (call Lattice (. LatticeState constant) (/lshift/ left right)))
    )
    (if (== opcode .lsr)
      (return (call Lattice (. LatticeState constant) (/zrshift/ (/and/ left mask) right)))
    )
    (if (== opcode .asr)
      (let extended (call sign-extended (/and/ left mask) width))
      (let shifted (/zrshift/ extended right))
      (if (and (!= right 0) (!= (/and/ extended (/lshift/ 1u64 63)) 0))
        (return (call Lattice (. LatticeState constant) (/or/ shifted (/lshift/ all-bits (- 64 right)))))
      )
      (return (call Lattice (. LatticeState constant) shifted))
    )
    (return (call Lattice (. LatticeState varying) 0))
  )
  (fn-expr _ holds Lattice
    (param operand OperandId)
    (case? (!= flags-state (. LatticeState constant))
      (call Lattice flags-state 0)
    )
    (case? (> code (. Condition always))
      (call Lattice (. LatticeState varying) 0)
    )
    (default
      (call Lattice (. LatticeState constant) (if-expr condition-holds 1u64 0u64))
    )
    (where
      (lazy code (call condition-of operand))
      (lazy condition-holds (call holds-for code (call compare-flags flags-left flags-right flags-width)))
    )
  )
  (fn-do _ condition-of U32
    (param operand OperandId)
    (if (== operand no-operand)
      (return no-condition)
    )
    (match? ([] (. function operands) operand)
      (case (call .cond-operand row)
        (return (. row code))
      )
    )
    (return no-condition)
  )
  (fn-do _ decide U32
    (param id InstructionId)
    (let opcode (. ([] (. function instructions) id) opcode))
    (let operands (. ([] (. function instructions) id) operands))
    (let tested Lattice)
    (if (== opcode .b-cond)
      (if (< (. operands length) 2)
        (return (. BranchState open))
      )
      (= tested (call holds ([] operands 1)))
      (if (!= (. tested state) (. LatticeState constant))
        (return (. BranchState open))
      )
      (return (if-expr (!= (. tested bits) 0) (. BranchState taken) (. BranchState skipped)))
    )
    (if (< (. operands length) 2)
      (return (. BranchState open))
    )
    (= tested (call value-of ([] operands 0)))
    (if (!= (. tested state) (. LatticeState constant))
      (return (. BranchState open))
    )
    (return (if-expr (== (== (. tested bits) 0) (== opcode .cbz)) (. BranchState taken) (. BranchState skipped)))
  )
  (fn-do _ fold-block Bool
    (param block BlockId)
    (= flags-state (. LatticeState varying))
    (let arena (. function arena))
    (let instructions (. ([] (. function blocks) block) instructions))
    (let rebuilt (call new-id-list arena (+ (. instructions length) 1)))
    (let settled (call IdList))
    (let in-phis true)
    (let folded false)
    (for (in index (..< 0 (. instructions length)))
      (let id ([] instructions index))
      (let opcode (. ([] (. function instructions) id) opcode))
      (if (== opcode .phi)
        (let made (call constant-phi id))
        (if (== made no-id)
          (= rebuilt (call (. rebuilt appended) arena id))
          (else
            (= settled (call (. settled appended) arena made))
            (= folded true)
          )
        )
        (continue)
      )
      (if (and in-phis (!= opcode .comment))
        (= in-phis false)
        (for (in entry (..< 0 (. settled length)))
          (= rebuilt (call (. rebuilt appended) arena ([] settled entry)))
        )
      )
      (if (or (== opcode .cbz) (== opcode .cbnz) (== opcode .b-cond))
        (let decision (call decide id))
        (let target (call conditional-branch-target function id))
        (if (and (== decision (. BranchState skipped)) (!= target no-operand))
          (= folded true)
          (continue)
        )
        (if (and (== decision (. BranchState taken)) (!= target no-operand))
          (call rewrite-assembly function id .b (call (. (call IdList) appended) arena target))
          (= (. ([] (. function blocks) block) instructions) (call (. rebuilt appended) arena id))
          (return true)
        )
        (else-if (== opcode .cmp)
          (call compare id)
          (call use-immediates id)
        )
        (else-if (!= opcode .comment)
          (call clobber opcode)
          (call fold-definition id)
          (call use-immediates id)
        )
      )
      (= rebuilt (call (. rebuilt appended) arena id))
    )
    (if in-phis
      (for (in entry (..< 0 (. settled length)))
        (= rebuilt (call (. rebuilt appended) arena ([] settled entry)))
      )
    )
    (= (. ([] (. function blocks) block) instructions) rebuilt)
    (return folded)
  )
  (fn-do _ constant-phi InstructionId
    (param id InstructionId)
    (match? ([] (. function instructions) id)
      (case (call .phi-instruction phi)
        (let row (call vreg-row function (. phi reg)))
        (if (or (== row no-id) (!= (. ([] (. function vregs) row) hint) no-register))
          (return no-id)
        )
        (let vreg (. ([] (. function vregs) row) id))
        (let mask (call class-mask (. ([] (. function vregs) row) reg-class)))
        (if (or (!= ([] states vreg) (. LatticeState constant)) (== mask 0))
          (return no-id)
        )
        (return (call materialize (. phi reg) (/and/ ([] values vreg) mask) mask no-id))
      )
    )
    (return no-id)
  )
  (fn-do _ materialize InstructionId
    (param target OperandId)
    (param bits U64)
    (param mask U64)
    (param id InstructionId)
    (let inverted (/and/ (/xor/ bits all-bits) mask))
    (let opcode (if-expr (<= bits 0xffff) (. Opcode movz) (. Opcode movn)))
    (let immediate (if-expr (<= bits 0xffff) bits inverted))
    (if (> immediate 0xffff)
      (return no-id)
    )
    (let operands
      (call triple
        (block
          (arg (. function arena))
          (arg target)
          (arg (call (. builder small-int) (as immediate I64)))
          (arg (call (. builder small-int) 0))
        )
      )
    )
    (if (== id no-id)
      (return (call (. builder new-assembly) opcode ([] operands 0) ([] operands 1) ([] operands 2)))
    )
    (call rewrite-assembly function id opcode operands)
    (return id)
  )
  (fn-do _ fold-definition _
    (param id InstructionId)
    (let opcode (. ([] (. function instructions) id) opcode))
    (if (or (not (call is-pure-def opcode)) (== opcode .movz) (== opcode .movn))
      (return)
    )
    (let operands (. ([] (. function instructions) id) operands))
    (let row (call (. function instruction-def) id))
    (if (or (== row no-id) (== (. operands length) 0) (!= (call vreg-row function ([] operands 0)) row))
      (return)
    )
    (let vreg (. ([] (. function vregs) row) id))
    (let mask (call class-mask (. ([] (. function vregs) row) reg-class)))
    (if (or (!= ([] states vreg) (. LatticeState constant)) (== mask 0))
      (return)
    )
    (call materialize ([] operands 0) (/and/ ([] values vreg) mask) mask id)
  )
  (fn-do _ use-immediates _
    (param id InstructionId)
    ; Puts each constant an instruction reads into its immediate, where the instruction has one. An
    ; addition of a constant whose negation fits becomes a subtraction, and the other way round, and a
    ; subtraction from zero a negation; a shift by a register the constant names becomes a shift by an
    ; immediate; a multiply by a power of two becomes a shift to the left, and an unsigned division by
    ; one a shift to the right.
    (let arena (. function arena))
    (let opcode (. ([] (. function instructions) id) opcode))
    (let operands (. ([] (. function instructions) id) operands))
    (if (== opcode .fmov)
      (call use-float-immediate operands)
      (return)
    )
    (if (< (. operands length) 2)
      (return)
    )
    (let mask (call operand-mask ([] operands 0)))
    (if (== mask 0)
      (return)
    )
    (let width U64 (if-expr (== mask low-word) 32 64))
    (if (== opcode .cmp)
      (let compared (call register-constant ([] operands 1) mask))
      (if (and (== (. operands length) 2) (. compared is-known) (call is-add-sub-bits (. compared bits)))
        (= ([] (. operands data) 1) (call (. builder small-int) (as (. compared bits) I64)))
      )
      (return)
    )
    (if (!= (. operands length) 3)
      (return)
    )
    (let destination ([] operands 0))
    (let left (call register-constant ([] operands 1) mask))
    (let right (call register-constant ([] operands 2) mask))
    (let swaps (!= (call vreg-row function ([] operands 2)) no-id))
    (if (or (== opcode .add) (== opcode .sub))
      (let negated (/and/ (- 0 (. right bits)) mask))
      (if (and (. right is-known) (call is-add-sub-bits (. right bits)))
        (= ([] (. operands data) 2) (call (. builder small-int) (as (. right bits) I64)))
        (else-if (and (. right is-known) (call is-add-sub-bits negated))
          (call rewrite-assembly
            (block
              (arg function)
              (arg id)
              (arg (if-expr (== opcode .add) (. Opcode sub) (. Opcode add)))
              (arg (call triple arena destination ([] operands 1) (call (. builder small-int) (as negated I64))))
            )
          )
        )
        (else-if (and (== opcode .add) swaps (. left is-known) (call is-add-sub-bits (. left bits)))
          (call rewrite-assembly
            (block
              (arg function)
              (arg id)
              (arg .add)
              (arg (call triple arena destination ([] operands 2) (call (. builder small-int) (as (. left bits) I64))))
            )
          )
        )
        (else-if (and (== opcode .sub) (. left is-known) (== (. left bits) 0) right-vreg)
          (call rewrite-assembly function id .neg (call pair arena destination ([] operands 2)))
        )
      )
      (lazy right-vreg (!= (call vreg-row function ([] operands 2)) no-id))
      (else-if (or (== opcode .and) (== opcode .orr) (== opcode .eor))
        (if (and (. right is-known) (. (call encode-logical-immediate (. right bits) (as width U32)) is-encodable))
          (= ([] (. operands data) 2) (call (. builder small-int) (as (. right bits) I64)))
          (else-if (and swaps (. left is-known) (. (call encode-logical-immediate (. left bits) (as width U32)) is-encodable))
            (call rewrite-assembly
              (block
                (arg function)
                (arg id)
                (arg opcode)
                (arg (call triple arena destination ([] operands 2) (call (. builder small-int) (as (. left bits) I64))))
              )
            )
          )
        )
      )
      (else-if (or (== opcode .lslv) (== opcode .lsrv) (== opcode .asrv))
        (if (. right is-known)
          (let shift (. Opcode lsl))
          (if (== opcode .lsrv)
            (= shift .lsr)
            (else-if (== opcode .asrv)
              (= shift .asr)
            )
          )
          (call rewrite-assembly
            (block
              (arg function)
              (arg id)
              (arg shift)
              (arg
                (call triple
                  (block
                    (arg arena)
                    (arg destination)
                    (arg ([] operands 1))
                    (arg (call (. builder small-int) (as (/and/ (. right bits) (- width 1)) I64)))
                  )
                )
              )
            )
          )
        )
      )
      (else-if (or (== opcode .lsl) (== opcode .lsr) (== opcode .asr))
        (if (and (. right is-known) (< (. right bits) width))
          (= ([] (. operands data) 2) (call (. builder small-int) (as (. right bits) I64)))
        )
      )
      (else-if (== opcode .mul)
        (if (and (. right is-known) (call is-power-of-two (. right bits)))
          (call rewrite-assembly
            (block
              (arg function)
              (arg id)
              (arg .lsl)
              (arg (call triple arena destination ([] operands 1) (call (. builder small-int) (call log2 (. right bits)))))
            )
          )
          (else-if (and swaps (. left is-known) (call is-power-of-two (. left bits)))
            (call rewrite-assembly
              (block
                (arg function)
                (arg id)
                (arg .lsl)
                (arg (call triple arena destination ([] operands 2) (call (. builder small-int) (call log2 (. left bits)))))
              )
            )
          )
        )
      )
      (else-if (== opcode .udiv)
        (if (and (. right is-known) (call is-power-of-two (. right bits)))
          (call rewrite-assembly
            (block
              (arg function)
              (arg id)
              (arg .lsr)
              (arg (call triple arena destination ([] operands 1) (call (. builder small-int) (call log2 (. right bits)))))
            )
          )
        )
      )
    )
  )
  (fn-do _ use-float-immediate _
    (param operands IdList)
    ; Moves a constant into a float without a general register: zero from the zero register, and a
    ; float FMOV can encode as its immediate.
    (if (!= (. operands length) 2)
      (return)
    )
    (let destination (call vreg-row function ([] operands 0)))
    (let mask (call operand-mask ([] operands 1)))
    (if (or (== destination no-id) (== mask 0))
      (return)
    )
    (let reg-class (. ([] (. function vregs) destination) reg-class))
    (let is-double (== reg-class .fpr64))
    (if (or (and (not is-double) (!= reg-class .fpr32)) (!= is-double (== mask all-bits)))
      (return)
    )
    (let value (call register-constant ([] operands 1) mask))
    (if (not (. value is-known))
      (return)
    )
    (if (== (. value bits) 0)
      (= ([] (. operands data) 1) (call (. builder preg) (if-expr is-double zero-register zero-register-32)))
      (else-if (!= (call float-immediate (. value bits) is-double) no-float-immediate)
        (= ([] (. operands data) 1) (call (. builder small-int) (as (. value bits) I64)))
      )
    )
  )
  (fn-expr _ register-constant Known
    (param operand OperandId)
    (param mask U64)
    (case? (== (call vreg-row function operand) no-id)
      (call Known)
    )
    (case? (!= (. value state) (. LatticeState constant))
      (call Known)
    )
    (default
      (call Known true (/and/ (. value bits) mask) false)
    )
    (where
      (lazy value (call value-of operand))
    )
  )
  (fn-do _ drop-dead-edges Bool
    (let dropped false)
    (let order (. function block-order))
    (for (in position (..< 0 (. order length)))
      (let block ([] order position))
      (if (== ([] live block) 0)
        (continue)
      )
      (let successors (. ([] (. function blocks) block) successors))
      (let kept U32)
      (for (in index (..< 0 (. successors length)))
        (if (call includes ([] edges block) ([] successors index))
          (= ([] (. successors data) kept) ([] successors index))
          (+= kept 1)
        )
      )
      (if (!= kept (. successors length))
        (= dropped true)
        (= (. ([] (. function blocks) block) successors) (call IdList (. successors data) kept (. successors capacity)))
      )
    )
    (for (in position (..< 0 (. order length)))
      (let block ([] order position))
      (if (== ([] live block) 0)
        (continue)
      )
      (let instructions (. ([] (. function blocks) block) instructions))
      (for (in index (..< 0 (. instructions length)))
        (match? ([] (. function instructions) ([] instructions index))
          (case (call .phi-instruction phi)
            (let exprs (. phi exprs))
            (let names (. phi blocks))
            (let kept U32)
            (for (in entry (..< 0 (. names length)))
              (let source (call (. builder get-block) ([] names entry)))
              (if (or (== source no-id) (== ([] live source) 0) (not (call includes ([] edges source) block)))
                (continue)
              )
              (= ([] (. exprs data) kept) ([] exprs entry))
              (= ([] (. names data) kept) ([] names entry))
              (+= kept 1)
            )
            (if (!= kept (. names length))
              (= dropped true)
              (= (. phi exprs) (call IdList (. exprs data) kept (. exprs capacity)))
              (= (. phi blocks) (call IdList (. names data) kept (. names capacity)))
            )
          )
        )
      )
    )
    (return dropped)
  )
  (fn-do _ remove-trivial-phis Bool
    (let arena (. function arena))
    (let replacements (call (of (. arena allocate) U32) (. function vreg-count)))
    (let removed (call (of (. arena allocate) Byte) (. function instructions length)))
    (let order (. function block-order))
    (let any false)
    (let changed true)
    (while changed
      (= changed false)
      (for (in position (..< 0 (. order length)))
        (let instructions (. ([] (. function blocks) ([] order position)) instructions))
        (for (in index (..< 0 (. instructions length)))
          (let id ([] instructions index))
          (if (!= ([] removed id) 0)
            (continue)
          )
          (match? ([] (. function instructions) id)
            (case (call .phi-instruction phi)
              (let same (call trivial-input (. phi reg) (. phi exprs) replacements))
              (if (!= same no-operand)
                (= ([] replacements (call vreg-id function (. phi reg))) (+ same 1))
                (= ([] removed id) 1)
                (= changed true)
                (= any true)
              )
            )
          )
        )
      )
    )
    (if (not any)
      (return false)
    )
    (for (in position (..< 0 (. order length)))
      (let block ([] order position))
      (let instructions (. ([] (. function blocks) block) instructions))
      (let kept U32)
      (for (in index (..< 0 (. instructions length)))
        (let id ([] instructions index))
        (if (!= ([] removed id) 0)
          (continue)
        )
        (call substitute id replacements)
        (= ([] (. instructions data) kept) id)
        (+= kept 1)
      )
      (= (. ([] (. function blocks) block) instructions) (call IdList (. instructions data) kept (. instructions capacity)))
    )
    (return true)
  )
  (fn-do _ trivial-input OperandId
    (param reg OperandId)
    (param exprs IdList)
    (param replacements (of CPointer U32))
    (let row (call vreg-row function reg))
    (if (or (== row no-id) (!= (. ([] (. function vregs) row) hint) no-register))
      (return no-operand)
    )
    (let vreg (. ([] (. function vregs) row) id))
    (if (!= ([] definitions vreg) 1)
      (return no-operand)
    )
    (let same no-operand)
    (let same-id no-id)
    (for (in entry (..< 0 (. exprs length)))
      (let input (call resolved ([] exprs entry) replacements))
      (let input-row (call vreg-row function input))
      (if (== input-row no-id)
        (return no-operand)
      )
      (let input-id (. ([] (. function vregs) input-row) id))
      (if (== input-id vreg)
        (continue)
      )
      (if (!= (. ([] (. function vregs) input-row) reg-class) (. ([] (. function vregs) row) reg-class))
        (return no-operand)
      )
      (if (== same-id no-id)
        (= same input)
        (= same-id input-id)
        (else-if (!= input-id same-id)
          (return no-operand)
        )
      )
    )
    (return same)
  )
  (fn-do _ resolved OperandId
    (param operand OperandId)
    (param replacements (of CPointer U32))
    (let current operand)
    (for (in _ (..< 0 (. function vreg-count)))
      (let vreg (call vreg-id function current))
      (if (or (== vreg no-id) (== ([] replacements vreg) 0))
        (return current)
      )
      (= current (- ([] replacements vreg) 1))
    )
    (return current)
  )
  (fn-do _ substitute _
    (param id InstructionId)
    (param replacements (of CPointer U32))
    (match? ([] (. function instructions) id)
      (case (call .phi-instruction phi)
        (for (in entry (..< 0 (. phi exprs length)))
          (let replaced (call substituted ([] (. phi exprs) entry) replacements))
          (if (!= replaced no-operand)
            (= ([] (. phi exprs data) entry) replaced)
          )
        )
        (return)
      )
    )
    (let operands (. ([] (. function instructions) id) operands))
    (for (in position (..< 0 (. operands length)))
      (let replaced (call substituted ([] operands position) replacements))
      (if (!= replaced no-operand)
        (= ([] (. operands data) position) replaced)
      )
    )
  )
  (fn-do _ substituted OperandId
    (param operand OperandId)
    (param replacements (of CPointer U32))
    (if (== operand no-operand)
      (return no-operand)
    )
    (match? ([] (. function operands) operand)
      (case (call .vreg-operand row)
        (if (== ([] replacements (. ([] (. function vregs) (. row vreg)) id)) 0)
          (return no-operand)
        )
        (return (call adapted (call resolved operand replacements) (. row vreg)))
      )
      (case (call .load-address-operand address)
        (let base (call substituted (. address base) replacements))
        (let offset (call substituted (. address offset) replacements))
        (if (and (== base no-operand) (== offset no-operand))
          (return no-operand)
        )
        (return
          (call (. builder load-address)
            (block
              (arg (if-expr (== base no-operand) (. address base) base))
              (arg (if-expr (== offset no-operand) (. address offset) offset))
              (arg (. address is-pre-index))
            )
          )
        )
      )
      (case (call .vreg-group-operand group)
        (for (in index (..< (. group vregs start) (. group vregs end)))
          (let member ([] (. function group-vregs) index))
          (let vreg (. ([] (. function vregs) member) id))
          (if (!= ([] replacements vreg) 0)
            (let target (call adapted (call resolved (- ([] replacements vreg) 1) replacements) member))
            (= ([] (. function group-vregs data) index) (call vreg-row function target))
          )
        )
      )
    )
    (return no-operand)
  )
  (fn-do _ adapted OperandId
    (param target OperandId)
    (param use VRegId)
    (let target-row (call vreg-row function target))
    (if (and (== (. ([] (. function vregs) use) reg-class) .gpr32) (== (. ([] (. function vregs) target-row) reg-class) .gpr64))
      (return (call (. builder narrow-view) target))
    )
    (return target)
  )
  (fn-do _ rewrite-allocations Bool
    (param dropping Bool)
    (let symbol (. builder bundle allocate-object-symbol))
    (let allocations (call IdList))
    (let homes (call IdList))
    (let order (. function block-order))
    (for (in position (..< 0 (. order length)))
      (let block ([] order position))
      (let instructions (. ([] (. function blocks) block) instructions))
      (for (in index (..< 0 (. instructions length)))
        (if (call allocates ([] instructions index) symbol)
          (= allocations (call (. allocations appended) (. function arena) ([] instructions index)))
          (= homes (call (. homes appended) (. function arena) block))
        )
      )
    )
    (return-if false (if (== (. allocations length) 0)))
    (blank)
    (let blocks (call box-blocks allocations))
    (let changed false)
    (for (in index (..< 0 (. allocations length)))
      (let rewritten false)
      (if dropping
        (= rewritten (call drop-allocation ([] homes index) ([] allocations index) ([] blocks index)))
        (else
          (= rewritten (call forward-allocation ([] homes index) ([] allocations index) ([] blocks index)))
        )
      )
      (if rewritten
        (= changed true)
        (if (< (+ index 1) (. allocations length))
          (= blocks (call box-blocks allocations))
        )
      )
    )
    (return changed)
  )
  (fn-do _ promote-allocations Bool
    ; Keeps in the frame each object allocated here that only plain loads and stores at known places
    ; reach, as one variable for each place they read or write, zeroed where the object was made as
    ; the collector zeroes what it allocates, and then promotes those variables to registers. So the
    ; environment of a nested function inlined where it is written, which no other code is given,
    ; needs no heap. Variables that all promote take no room in the frame.
    (let symbol (. builder bundle allocate-object-symbol))
    (let allocations (call IdList))
    (let homes (call IdList))
    (let order (. function block-order))
    (for (in position (..< 0 (. order length)))
      (let block ([] order position))
      (let instructions (. ([] (. function blocks) block) instructions))
      (for (in index (..< 0 (. instructions length)))
        (if (call allocates ([] instructions index) symbol)
          (= allocations (call (. allocations appended) (. function arena) ([] instructions index)))
          (= homes (call (. homes appended) (. function arena) block))
        )
      )
    )
    (return-if false (if (== (. allocations length) 0)))
    (blank)
    (let slots (. function frame-slots length))
    (let blocks (call box-blocks allocations))
    (= promoted-objects (call IdList))
    (for (in index (..< 0 (. allocations length)))
      (if (and (call stack-allocation ([] homes index) ([] allocations index) ([] blocks index)) has-next)
        (= blocks (call box-blocks allocations))
      )
      (lazy has-next (< (+ index 1) (. allocations length)))
    )
    (return-if false (if (== (. promoted-objects length) 0)))
    (blank)
    (let kept (. function vars))
    (= (. function vars) promoted-objects)
    (call (. (call MIRVariablesToRegisters builder) run))
    (= (. function vars) kept)
    (let promoted true)
    (for (in index (..< 0 (. promoted-objects length)))
      (if (not (. ([] (. function frame-objects) ([] promoted-objects index)) can-promote))
        (= promoted false)
      )
    )
    (if promoted
      (= (. function frame-slots) (call IdList (. function frame-slots data) slots (. function frame-slots capacity)))
    )
    (call (. function forget-use-counts))
    (return true)
  )
  (fn-do _ stack-allocation Bool
    (param home BlockId)
    (param allocation InstructionId)
    (param order IdList)
    ; Replaces one allocation with variables of the frame where `promote-allocations` can: each load
    ; or store of the object is a plain one of a register at a known place, the places do not
    ; overlap, and each place is read and written in one size and one class of register. A place
    ; that holds a pointer the collector follows is a root.
    (let box (call box-of allocation))
    (if (== box no-id)
      (return false)
    )
    (call note-derivations box order)
    (let arena (. function arena))
    (let accesses (call IdList))
    (let barriers (call IdList))
    (let barrier-blocks (call IdList))
    (for (in position (..< 0 (. order length)))
      (let block ([] order position))
      (let instructions (. ([] (. function blocks) block) instructions))
      (for (in index (..< 0 (. instructions length)))
        (let id ([] instructions index))
        (if (== id allocation)
          (continue)
        )
        (let use (call box-access id box))
        (if (== use (. BoxUse escaped))
          (return false)
        )
        (if (== use (. BoxUse barrier))
          (= barriers (call (. barriers appended) arena id))
          (= barrier-blocks (call (. barrier-blocks appended) arena block))
          (else-if (!= use (. BoxUse unused))
            (let opcode (. ([] (. function instructions) id) opcode))
            (let plain (or (== opcode .ldr) (== opcode .str) (== opcode .ldrb) (== opcode .strb) (== opcode .ldrh) (== opcode .strh)))
            (if (or (not plain) (!= (. ([] (. function instructions) id) operands length) 2))
              (return false)
            )
            (= accesses (call (. accesses appended) arena id))
          )
        )
      )
    )
    (let places (call IdList))
    (let sizes (call IdList))
    (let classes (call IdList))
    (let roots (call IdList))
    (let fields (call IdList))
    (for (in index (..< 0 (. accesses length)))
      (let id ([] accesses index))
      (let value ([] (. ([] (. function instructions) id) operands) 0))
      (let row (call vreg-row function value))
      (let offset (call access-offset id))
      (let size (call slot-size id))
      (if (or (== row no-id) (== offset (. U64 max)) (== size 0) (> offset (as (. U32 max) U64)))
        (return false)
      )
      (let class (as (. ([] (. function vregs) row) reg-class) U32))
      (let field no-id)
      (for (in entry (..< 0 (. places length)))
        (let start (as ([] places entry) U64))
        (if (== start offset)
          (= field entry)
          (else-if (and (< start (+ offset size)) (< offset (+ start (as ([] sizes entry) U64))))
            (return false)
          )
        )
      )
      (if (== field no-id)
        (= field (. places length))
        (= places (call (. places appended) arena (as offset U32)))
        (= sizes (call (. sizes appended) arena (as size U32)))
        (= classes (call (. classes appended) arena class))
        (= roots (call (. roots appended) arena no-id))
        (else-if (or (!= (as ([] sizes field) U64) size) (!= ([] classes field) class))
          (return false)
        )
      )
      (if (and (== ([] roots field) no-id) (. ([] (. function vregs) row) gc-root))
        (= ([] (. roots data) field) row)
      )
      (= fields (call (. fields appended) arena field))
    )
    (let objects (call IdList))
    (for (in entry (..< 0 (. places length)))
      (let slot (call (. builder frame-slot)))
      (let class (as ([] classes entry) RegClass))
      (let root ([] roots entry))
      (let type (call field-type ([] sizes entry) class (!= root no-id)))
      (if (== root no-id)
        (= objects (call (. objects appended) arena (call (. builder add-frame-object) slot type)))
        (else
          (let held ([] (. function vregs) root))
          (= objects
            (call (. objects appended)
              (block
                (arg arena)
                (arg
                  (call (. builder add-frame-object)
                    (block
                      (arg slot)
                      (arg type)
                      (arg 0)
                      (arg true)
                      (arg true)
                      (arg (. held gc-descriptor))
                      (arg (. held gc-root-mode))
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
    (for (in index (..< 0 (. accesses length)))
      (let id ([] accesses index))
      (let operands (call new-id-list arena 2))
      (= operands (call (. operands appended) arena ([] (. ([] (. function instructions) id) operands) 0)))
      (= operands (call (. operands appended) arena (call (. builder frame-object-operand) ([] objects ([] fields index)))))
      (call rewrite-assembly function id (. ([] (. function instructions) id) opcode) operands)
    )
    (for (in index (..< 0 (. barriers length)))
      (call remove-instruction function ([] barrier-blocks index) ([] barriers index))
    )
    (call remove-derivations)
    (let zeros (call IdList))
    (let wide no-operand)
    (let narrow no-operand)
    (for (in entry (..< 0 (. places length)))
      (let class (as ([] classes entry) RegClass))
      (let words (or (== class .gpr64) (== class .fpr64)))
      (if (and words (== wide no-operand))
        (= wide (call (. builder vreg) .gpr64))
        (= zeros
          (call (. zeros appended)
            (block
              (arg arena)
              (arg (call (. builder new-assembly) .movz wide (call (. builder small-int) 0) (call (. builder small-int) 0)))
            )
          )
        )
      )
      (if (and (not words) (== narrow no-operand))
        (= narrow (call (. builder vreg) .gpr32))
        (= zeros
          (call (. zeros appended)
            (block
              (arg arena)
              (arg (call (. builder new-assembly) .movz narrow (call (. builder small-int) 0) (call (. builder small-int) 0)))
            )
          )
        )
      )
      (let zero (if-expr words wide narrow))
      (if (or (== class .fpr64) (== class .fpr32))
        (let bits zero)
        (= zero (call (. builder vreg) class))
        (= zeros (call (. zeros appended) arena (call (. builder new-assembly) .fmov zero bits)))
      )
      (= zeros
        (call (. zeros appended)
          (block
            (arg arena)
            (arg (call (. builder new-assembly) .str zero (call (. builder frame-object-operand) ([] objects entry))))
          )
        )
      )
    )
    (let instructions (. ([] (. function blocks) home) instructions))
    (let rebuilt (call new-id-list arena (+ (. instructions length) (. zeros length))))
    (for (in index (..< 0 (. instructions length)))
      (if (!= ([] instructions index) allocation)
        (= rebuilt (call (. rebuilt appended) arena ([] instructions index)))
        (continue)
      )
      (for (in zero (..< 0 (. zeros length)))
        (= rebuilt (call (. rebuilt appended) arena ([] zeros zero)))
      )
    )
    (call (. function drop-uses) allocation)
    (= (. ([] (. function blocks) home) instructions) rebuilt)
    (for (in entry (..< 0 (. objects length)))
      (= promoted-objects (call (. promoted-objects appended) arena ([] objects entry)))
    )
    (return true)
  )
  (fn-expr _ field-type MIRTypeId
    (param size U32)
    (param class RegClass)
    (param rooted Bool)
    ; The type of a variable that holds a place of an object as `stack-allocation` read it.
    (case? (== class .fpr64)
      f64-type-id
    )
    (case? (== class .fpr32)
      f32-type-id
    )
    (case? (== size 1)
      u8-type-id
    )
    (case? (== size 2)
      u16-type-id
    )
    (case? (== class .gpr32)
      u32-type-id
    )
    (case? rooted
      pointer-type-id
    )
    (default
      i64-type-id
    )
  )
  (fn-do _ box-blocks (of CPointer IdList)
    (param allocations IdList)
    (let arena (. function arena))
    (let limit (. function vreg-count))
    (let holders (call (of (. arena allocate) U32) limit))
    (for (in vreg (..< 0 limit))
      (= ([] holders vreg) (. U32 max))
    )
    (let found (call (of (. arena allocate) IdList) (. allocations length)))
    (for (in index (..< 0 (. allocations length)))
      (= ([] found index) (call IdList))
      (let box (call box-of ([] allocations index)))
      (if (and (!= box no-id) (< box limit))
        (= ([] holders box) (as index U32))
      )
    )
    (let order (. function block-order))
    (for (in position (..< 0 (. order length)))
      (let instructions (. ([] (. function blocks) ([] order position)) instructions))
      (for (in index (..< 0 (. instructions length)))
        (call hold-derivation holders ([] instructions index))
      )
    )
    (for (in position (..< 0 (. order length)))
      (let block ([] order position))
      (let instructions (. ([] (. function blocks) block) instructions))
      (for (in index (..< 0 (. instructions length)))
        (match? ([] (. function instructions) ([] instructions index))
          (case (call .phi-instruction phi)
            (call note-box-block found holders block (call vreg-id function (. phi reg)))
            (for (in entry (..< 0 (. phi exprs length)))
              (call note-box-block found holders block (call vreg-id function ([] (. phi exprs) entry)))
            )
            (continue)
          )
        )
        (let operands (. ([] (. function instructions) ([] instructions index)) operands))
        (for (in entry (..< 0 (. operands length)))
          (match? ([] (. function operands) ([] operands entry))
            (case (call .vreg-operand row)
              (call note-box-block found holders block (. ([] (. function vregs) (. row vreg)) id))
            )
            (case (call .vreg-group-operand group)
              (for (in member (..< (. group vregs start) (. group vregs end)))
                (call note-box-block
                  (block
                    (arg found)
                    (arg holders)
                    (arg block)
                    (arg (. ([] (. function vregs) ([] (. function group-vregs) member)) id))
                  )
                )
              )
            )
            (case (call .load-address-operand address)
              (call note-box-block found holders block (call vreg-id function (. address offset)))
              (call note-box-block found holders block (call vreg-id function (. address base)))
            )
          )
        )
      )
    )
    (return found)
  )
  (fn-do _ hold-derivation _
    (param holders (of CPointer U32))
    (param id InstructionId)
    (let row ([] (. function instructions) id))
    (return-if (if (or (!= (. row opcode) .addptr) (!= (. row operands length) 2))))
    (blank)
    (let derived (call vreg-id function ([] (. row operands) 0)))
    (return-if (if (or (== derived no-id) (>= derived (. function vreg-count)) (!= ([] definitions derived) 1) held)))
    (blank)
    (lazy held (!= ([] holders derived) (. U32 max)))
    (match? ([] (. function operands) ([] (. row operands) 1))
      (case (call .load-address-operand address)
        (let base (call vreg-id function (. address base)))
        (if (and (!= base no-id) (< base (. function vreg-count)))
          (= ([] holders derived) ([] holders base))
        )
      )
    )
  )
  (fn-do _ note-box-block _
    (param found (of CPointer IdList))
    (param holders (of CPointer U32))
    (param block BlockId)
    (param vreg U32)
    (return-if (if (or (== vreg no-id) (>= vreg (. function vreg-count)) (== ([] holders vreg) (. U32 max)))))
    (blank)
    (let held ([] found ([] holders vreg)))
    (return-if (if (and (!= (. held length) 0) (== ([] held (- (. held length) 1)) block))))
    (blank)
    (= ([] found ([] holders vreg)) (call (. held appended) (. function arena) block))
  )
  (fn-do _ allocates Bool
    (param id InstructionId)
    (param symbol StringId)
    (let row ([] (. function instructions) id))
    (if (== (. row opcode) .gc-alloc)
      (return (!= (. row operands length) 0))
    )
    (if (or (!= (. row opcode) .call) (== symbol no-string) (< (. row operands length) 2))
      (return false)
    )
    (match? ([] (. function operands) ([] (. row operands) 0))
      (case (call .symbol-operand target)
        (return (== (. target name) symbol))
      )
    )
    (return false)
  )
  (fn-expr _ box-of U32
    (param allocation InstructionId)
    (if-expr (or (== box no-id) (!= ([] definitions box) 1)) no-id box)
    (where
      (lazy row ([] (. function instructions) allocation))
      (lazy box (call vreg-id function ([] (. row operands) (if-expr (== (. row opcode) .gc-alloc) 0 1))))
    )
  )
  (fn-do _ drop-allocation Bool
    (param home BlockId)
    (param allocation InstructionId)
    (param order IdList)
    (let box (call box-of allocation))
    (if (== box no-id)
      (return false)
    )
    (call note-derivations box order)
    (let arena (. function arena))
    (let writes (call IdList))
    (let blocks (call IdList))
    (for (in position (..< 0 (. order length)))
      (let block ([] order position))
      (let instructions (. ([] (. function blocks) block) instructions))
      (for (in index (..< 0 (. instructions length)))
        (let id ([] instructions index))
        (if (== id allocation)
          (continue)
        )
        (let use (call box-access id box))
        (if (or (== use (. BoxUse escaped)) (== use (. BoxUse loaded)))
          (return false)
        )
        (if (!= use (. BoxUse unused))
          (= writes (call (. writes appended) arena id))
          (= blocks (call (. blocks appended) arena block))
        )
      )
    )
    (for (in index (..< 0 (. writes length)))
      (call remove-instruction function ([] blocks index) ([] writes index))
    )
    (call remove-derivations)
    (call remove-instruction function home allocation)
    (return true)
  )
  (fn-do _ forward-allocation Bool
    (param home BlockId)
    (param allocation InstructionId)
    (param order IdList)
    (let box (call box-of allocation))
    (if (== box no-id)
      (return false)
    )
    (call note-derivations box order)
    (let arena (. function arena))
    (let stores (call IdList))
    (let barriers (call IdList))
    (let loads (call IdList))
    (let load-blocks (call IdList))
    (for (in position (..< 0 (. order length)))
      (let block ([] order position))
      (let instructions (. ([] (. function blocks) block) instructions))
      (let passed (!= block home))
      (let called false)
      (let loaded false)
      (for (in index (..< 0 (. instructions length)))
        (let id ([] instructions index))
        (if (== id allocation)
          (= passed true)
          (continue)
        )
        (let use (call box-access id box))
        (if (== use (. BoxUse escaped))
          (return false)
        )
        (if (or (== use (. BoxUse stored)) (== use (. BoxUse barrier)))
          (if (or (!= block home) (not passed) called loaded)
            (return false)
          )
          (if (== use (. BoxUse stored))
            (= stores (call (. stores appended) arena id))
            (else
              (= barriers (call (. barriers appended) arena id))
            )
          )
          (else-if (== use (. BoxUse loaded))
            (if (not passed)
              (return false)
            )
            (= loaded true)
            (= loads (call (. loads appended) arena id))
            (= load-blocks (call (. load-blocks appended) arena block))
          )
          (else-if (and (== block home) passed (== (. ([] (. function instructions) id) opcode) .call))
            (= called true)
          )
        )
      )
    )
    (for (in first (..< 0 (. stores length)))
      (let low (call access-offset ([] stores first)))
      (if (or (== low (. U64 max)) (== (call slot-size ([] stores first)) 0))
        (return false)
      )
      (for (in second (..< (+ first 1) (. stores length)))
        (let high (call access-offset ([] stores second)))
        (if (== high (. U64 max))
          (return false)
        )
        (if (and (< low (+ high (call span-size ([] stores second)))) (< high (+ low (call span-size ([] stores first)))))
          (return false)
        )
      )
    )
    (let complete true)
    (let changed false)
    (for (in index (..< 0 (. loads length)))
      (if (call forward-access ([] load-blocks index) ([] loads index) stores)
        (= changed true)
        (else
          (= complete false)
        )
      )
    )
    (if (not complete)
      (return changed)
    )
    (for (in index (..< 0 (. stores length)))
      (call remove-instruction function home ([] stores index))
    )
    (for (in index (..< 0 (. barriers length)))
      (call remove-instruction function home ([] barriers index))
    )
    (call remove-derivations)
    (call remove-instruction function home allocation)
    (return true)
  )
  (fn-do _ note-derivations _
    (param box U32)
    (param order IdList)
    (let arena (. function arena))
    (= derived-vregs (call IdList))
    (= derived-offsets (call IdList))
    (= derived-rows (call IdList))
    (= derived-blocks (call IdList))
    (for (in position (..< 0 (. order length)))
      (let block ([] order position))
      (let instructions (. ([] (. function blocks) block) instructions))
      (for (in index (..< 0 (. instructions length)))
        (let id ([] instructions index))
        (let row ([] (. function instructions) id))
        (if (or (!= (. row opcode) .addptr) (!= (. row operands length) 2))
          (continue)
        )
        (let derived (call vreg-id function ([] (. row operands) 0)))
        (if (or (== derived no-id) (!= ([] definitions derived) 1))
          (continue)
        )
        (match? ([] (. function operands) ([] (. row operands) 1))
          (case (call .load-address-operand address)
            (if (and based-on-box (not (. address is-pre-index)) (== (. address index-shift) 0))
              (let offset
                (scope (if-expr no-offset (call Known true 0 false) known-offset)
                  (lazy no-offset (== (. address offset) no-operand))
                  (lazy known-offset (call known-int function (. address offset)))
                )
              )
              (if (and (. offset is-known) (not (. offset is-negative)) (<= (. offset bits) (as (. U32 max) U64)))
                (= derived-vregs (call (. derived-vregs appended) arena derived))
                (= derived-offsets (call (. derived-offsets appended) arena (as (. offset bits) U32)))
                (= derived-rows (call (. derived-rows appended) arena id))
                (= derived-blocks (call (. derived-blocks appended) arena block))
              )
            )
            (lazy based-on-box (== (call vreg-id function (. address base)) box))
          )
        )
      )
    )
  )
  (fn-do _ remove-derivations _
    (for (in index (..< 0 (. derived-rows length)))
      (call remove-instruction function ([] derived-blocks index) ([] derived-rows index))
    )
  )
  (fn-do _ derived-offset U64
    (param vreg U32)
    (for (in index (..< 0 (. derived-vregs length)))
      (return-if ([] derived-offsets index) (if (== ([] derived-vregs index) vreg)))
    )
    (return (. U64 max))
  )
  (fn-do _ box-access U32
    (param id InstructionId)
    (param box U32)
    (for (in index (..< 0 (. derived-rows length)))
      (return-if (. BoxUse unused) (if (== ([] derived-rows index) id)))
    )
    (let found (call box-use id box))
    (return-if found (if (== found (. BoxUse escaped))))
    (blank)
    (for (in index (..< 0 (. derived-vregs length)))
      (let use (call box-use id ([] derived-vregs index)))
      (return-if (. BoxUse escaped) (if (or (== use (. BoxUse escaped)) (and (!= use (. BoxUse unused)) (!= found (. BoxUse unused))))))
      (blank)
      (if (!= use (. BoxUse unused))
        (= found use)
      )
    )
    (return found)
  )
  (fn-do _ box-use U32
    (param id InstructionId)
    (param box U32)
    (match? ([] (. function instructions) id)
      (case (call .phi-instruction phi)
        (if (== (call vreg-id function (. phi reg)) box)
          (return (. BoxUse escaped))
        )
        (for (in entry (..< 0 (. phi exprs length)))
          (if (== (call vreg-id function ([] (. phi exprs) entry)) box)
            (return (. BoxUse escaped))
          )
        )
        (return (. BoxUse unused))
      )
    )
    (let opcode (. ([] (. function instructions) id) opcode))
    (let operands (. ([] (. function instructions) id) operands))
    (let last (- (. operands length) 1))
    (let found (. BoxUse unused))
    (for (in position (..< 0 (. operands length)))
      (match? ([] (. function operands) ([] operands position))
        (case (call .vreg-operand row)
          (if (== (. ([] (. function vregs) (. row vreg)) id) box)
            (if (or (!= opcode .gc-barrier) (!= position 0))
              (return (. BoxUse escaped))
            )
            (= found (. BoxUse barrier))
          )
        )
        (case (call .vreg-group-operand group)
          (for (in index (..< (. group vregs start) (. group vregs end)))
            (if (== (. ([] (. function vregs) ([] (. function group-vregs) index)) id) box)
              (return (. BoxUse escaped))
            )
          )
        )
        (case (call .load-address-operand address)
          (if (== (call vreg-id function (. address offset)) box)
            (return (. BoxUse escaped))
          )
          (if (== (call vreg-id function (. address base)) box)
            (if (or (. address is-pre-index) (!= position last) (and has-offset (not offset-known)))
              (return (. BoxUse escaped))
            )
            (lazy has-offset (!= (. address offset) no-operand))
            (lazy offset-known (. (call known-int function (. address offset)) is-known))
            (if (and (== (call slot-count opcode) 1) (!= last 1))
              (return (. BoxUse escaped))
            )
            (if (and (== (call slot-count opcode) 2) (!= last 2))
              (return (. BoxUse escaped))
            )
            (if (or (== opcode .ldr) narrow-load (== opcode .ldrsw) (== opcode .ldp))
              (= found (. BoxUse loaded))
              (else-if (or (== opcode .str) (== opcode .strb) (== opcode .strh) (== opcode .stp))
                (= found (. BoxUse stored))
              )
              (else
                (return (. BoxUse escaped))
              )
            )
            (lazy narrow-load (or (== opcode .ldrb) (== opcode .ldrh)))
          )
        )
      )
    )
    (return found)
  )
  (fn-expr _ slot-count U32
    (param opcode Opcode)
    (if-expr (or (== opcode .ldp) (== opcode .stp)) 2 1)
  )
  (fn-do _ access-offset U64
    (param id InstructionId)
    (let operands (. ([] (. function instructions) id) operands))
    (match? ([] (. function operands) ([] operands (- (. operands length) 1)))
      (case (call .load-address-operand address)
        (let derived (call derived-offset (call vreg-id function (. address base))))
        (let start (if-expr (== derived (. U64 max)) 0u64 derived))
        (if (== (. address offset) no-operand)
          (return start)
        )
        (let offset (call known-int function (. address offset)))
        (if (and (. offset is-known) (not (. offset is-negative)))
          (return (+ start (. offset bits)))
        )
      )
    )
    (return (. U64 max))
  )
  (fn-expr _ span-size U64
    (param id InstructionId)
    (* (call slot-size id) (as (call slot-count (. ([] (. function instructions) id) opcode)) U64))
  )
  (fn-do _ slot-size U64
    (param id InstructionId)
    (let opcode (. ([] (. function instructions) id) opcode))
    (if (or (== opcode .strb) (== opcode .ldrb))
      (return 1)
    )
    (if (or (== opcode .strh) (== opcode .ldrh))
      (return 2)
    )
    (if (== opcode .ldrsw)
      (return 4)
    )
    (if (and (!= opcode .str) (!= opcode .stp) (!= opcode .ldr) (!= opcode .ldp))
      (return 0)
    )
    (let value ([] (. ([] (. function instructions) id) operands) 0))
    (match? ([] (. function operands) value)
      (case (call .preg-operand row)
        (if (== (. row register) zero-register)
          (return 8)
        )
        (if (== (. row register) zero-register-32)
          (return 4)
        )
        (return 0)
      )
    )
    (return (call class-size (call operand-class value)))
  )
  (fn-expr _ operand-class U32
    (param operand OperandId)
    (if-expr (== row no-id) (. U32 max) (as (. ([] (. function vregs) row) reg-class) U32))
    (where
      (lazy row (call vreg-row function operand))
    )
  )
  (fn-do _ forward-access Bool
    (param block BlockId)
    (param load InstructionId)
    (param stores IdList)
    (let opcode (. ([] (. function instructions) load) opcode))
    (let operands (. ([] (. function instructions) load) operands))
    (let offset (call access-offset load))
    (let size (call slot-size load))
    (let count (call slot-count opcode))
    (if (or (== offset (. U64 max)) (== size 0))
      (return false)
    )
    (let moves (call IdList))
    (for (in slot (..< 0 count))
      (let wanted (+ offset (* (as slot U64) size)))
      (let source no-operand)
      (for (in entry (..< 0 (. stores length)))
        (let store ([] stores entry))
        (let base (call access-offset store))
        (if (== (call slot-size store) size)
          (for (in part (..< 0 (call slot-count (. ([] (. function instructions) store) opcode))))
            (if (== (+ base (* (as part U64) size)) wanted)
              (= source ([] (. ([] (. function instructions) store) operands) part))
            )
          )
        )
      )
      (if (== source no-operand)
        (return false)
      )
      (let made (call forwarded-move opcode ([] operands slot) source))
      (if (== made no-id)
        (return false)
      )
      (= moves (call (. moves appended) (. function arena) made))
    )
    (match? ([] (. function instructions) ([] moves 0))
      (case (call .assembly-instruction row)
        (call rewrite-assembly function load (. row opcode) (. row operands))
      )
    )
    (if (== count 2)
      (let instructions (. ([] (. function blocks) block) instructions))
      (for (in index (..< 0 (. instructions length)))
        (if (== ([] instructions index) load)
          (= (. ([] (. function blocks) block) instructions)
            (call (. instructions inserted)
              (block
                (arg (. function arena))
                (arg (+ index 1))
                (arg ([] moves 1))
              )
            )
          )
          (return true)
        )
      )
    )
    (return true)
  )
  (fn-do _ forwarded-move InstructionId
    (param opcode Opcode)
    (param target OperandId)
    (param value OperandId)
    (let target-class (call operand-class target))
    (if (== target-class (. U32 max))
      (return no-id)
    )
    (let is-float (or (== target-class (as (. RegClass fpr32) U32)) (== target-class (as (. RegClass fpr64) U32))))
    (match? ([] (. function operands) value)
      (case (call .preg-operand row)
        (if (or is-float (and (!= (. row register) zero-register) (!= (. row register) zero-register-32)))
          (return no-id)
        )
        (return (call (. builder new-assembly) .movz target (call (. builder small-int) 0) (call (. builder small-int) 0)))
      )
    )
    (let row (call vreg-row function value))
    (if (or (== row no-id) (!= ([] definitions (. ([] (. function vregs) row) id)) 1))
      (return no-id)
    )
    (let value-class (as (. ([] (. function vregs) row) reg-class) U32))
    (if (== opcode .ldrb)
      (return (call (. builder new-assembly) .uxtb target value))
    )
    (if (== opcode .ldrh)
      (return (call (. builder new-assembly) .uxth target value))
    )
    (if (== opcode .ldrsw)
      (return (call (. builder new-assembly) .sxtw target value))
    )
    (if (!= value-class target-class)
      (let is-value-float (or (== value-class (as (. RegClass fpr32) U32)) (== value-class (as (. RegClass fpr64) U32))))
      (let is-wide (or (== target-class (as (. RegClass gpr64) U32)) (== target-class (as (. RegClass fpr64) U32))))
      (let is-value-wide (or (== value-class (as (. RegClass gpr64) U32)) (== value-class (as (. RegClass fpr64) U32))))
      (return-if no-id (if (or (== is-float is-value-float) (!= is-wide is-value-wide))))
    )
    (return
      (call (. builder new-assembly)
        (block
          (arg (if-expr (or is-float (!= value-class target-class)) (. Opcode fmov) (. Opcode mov)))
          (arg target)
          (arg value)
        )
      )
    )
  )
)

(type + MIRValueNumberingPass
  ; Numbers the values of a function in SSA form, walking its blocks down the dominator tree, so
  ; that values computed the same way from the same numbers share one, as do loads of one place
  ; while memory is unchanged. So do values made from a pointer the collector sees, held where it
  ; does not see them, since a call between two of them may collect what that pointer holds. An
  ; instruction whose value a dominating instruction already computed
  ; becomes a copy of it, unless it only gives the truth of a condition, which costs less to give
  ; again than to keep. A branch's condition is a fact in the blocks only one of its edges
  ; reaches, and a branch a fact settles jumps straight to its side. The facts one side of a
  ; diamond leaves at its join hold again on that side of a later branch on the same condition,
  ; and a phi joining the same values on the same sides of the same condition as an earlier phi
  ; is that phi. Dead definitions and the comparisons nothing reads are then removed, and a branch
  ; whose sides are left empty and give its join the same values jumps to the join.
  (blank)
  (prop _ builder MIRBuilder)
  (prop _ function MIRFunction)
  (prop _ blocks IdList)
  (prop _ post-indexes (of CPointer U32))
  (prop _ doms (of CPointer U32))
  (prop _ climbed (of CPointer U32))
  (prop _ children (of CPointer IdList))
  (prop _ entered (of CPointer U32))
  (prop _ exited (of CPointer U32))
  (prop _ writes (of CPointer Byte))
  (prop _ marks (of CPointer U32))
  (prop _ mark U32)
  (prop _ generations (of CPointer U32))
  (prop _ generation U32)
  (prop _ generation-count U32)
  (prop _ definitions (of CPointer U32))
  (prop _ def-classes (of CPointer Byte))
  (prop _ visited-defs (of CPointer Byte))
  (prop _ numbers (of CPointer U32))
  (prop _ truths (of CPointer U32))
  (prop _ negated (of CPointer Byte))
  (prop _ booleans (of CPointer Byte))
  (prop _ facts (of CPointer Byte))
  (prop _ fact-stack IdList)
  (prop _ arm-keys IdList)
  (prop _ arm-heads IdList)
  (prop _ arm-blocks IdList)
  (prop _ arm-heights IdList)
  (prop _ implied-index (of CPointer U32))
  (prop _ implied-joins IdList)
  (prop _ implied-facts IdList)
  (prop _ implied-starts IdList)
  (prop _ implied-ends IdList)
  (prop _ branch-keys (of CPointer U32))
  (prop _ branch-negated (of CPointer Byte))
  (prop _ branch-taken (of CPointer U32))
  (prop _ branch-fallen (of CPointer U32))
  (prop _ heads (of CPointer U64))
  (prop _ firsts (of CPointer U64))
  (prop _ seconds (of CPointer U64))
