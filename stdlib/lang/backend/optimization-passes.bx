    (if (or (== vreg no-id) (>= vreg vreg-limit))
      (return 0)
    )
    (return (call number-of-vreg vreg))
  )
  (fn-do _ copies Bool
    (param dest OperandId)
    (param source OperandId)
    (param opcode Opcode)
    ; Whether an instruction gives `dest` the very value of `source`: a copy within one class whose
    ; value fills it, or an extension of a value that is zero or one. A copy of a pointer the
    ; collector sees into a register it does not is a value of its own (`derives-pointer`).
    (let source-row (call vreg-row function source))
    (let dest-row (call vreg-row function dest))
    (if (or (== source-row no-id) (== dest-row no-id))
      (return false)
    )
    (if (and (. ([] (. function vregs) source-row) gc-root) (not (. ([] (. function vregs) dest-row) gc-root)))
      (return false)
    )
    (let vreg (. ([] (. function vregs) source-row) id))
    (if (or (>= vreg vreg-limit) (> ([] definitions vreg) 1))
      (return false)
    )
    (let class (. ([] (. function vregs) dest-row) reg-class))
    (if (!= (. ([] (. function vregs) source-row) reg-class) class)
      (return false)
    )
    (if (or (== opcode .mov) (== opcode .fmov))
      (return (or (== class .gpr64) (== class .fpr64) (== ([] def-classes vreg) (as (+ (as class U32) 1) Byte))))
    )
    (return (!= ([] booleans (call number-of-vreg vreg)) 0))
  )
  (fn-expr _ is-replaceable Bool
    (param opcode Opcode)
    (param dest OperandId)
    (param leader OperandId)
    (case? (or (== opcode .movz) (== opcode .movn) (== opcode .adr) (== opcode .adrp))
      false
    )
    (case? (or (== dest-row no-id) (== leader-row no-id))
      false
    )
    (default
      (and (== (. dest-reg reg-class) (. leader-reg reg-class)) (== (. dest-reg gc-root) (. leader-reg gc-root)))
    )
    (where
      (lazy dest-row (call vreg-row function dest))
      (lazy leader-row (call vreg-row function leader))
      (lazy dest-reg ([] (. function vregs) dest-row))
      (lazy leader-reg ([] (. function vregs) leader-row))
    )
  )
  (fn-do _ note-truth _
    (param number U32)
    (param opcode Opcode)
    (param operands IdList)
    (if (and (== opcode .cset) (== (. operands length) 2))
      (= ([] booleans number) 1)
      (match? ([] (. function operands) ([] operands 1))
        (case (call .cond-operand cond)
          (let base (call condition-number (. cond code)))
          (if (!= base 0)
            (= ([] truths number) base)
            (= ([] negated number) (as (/and/ (. cond code) 1) Byte))
          )
        )
      )
      (return)
    )
    (if (and (== (. operands length) 2) (or (== opcode .uxtb) (== opcode .uxth) (== opcode .uxtw)))
      (let source (call number-of-operand ([] operands 1)))
      (if (and (!= source 0) (!= ([] booleans source) 0))
        (= ([] booleans number) 1)
        (= ([] truths number) ([] truths source))
        (= ([] negated number) ([] negated source))
      )
      (return)
    )
    (if (!= (. operands length) 3)
      (return)
    )
    (let left (call number-of-operand ([] operands 1)))
    (if (or (== left 0) (== ([] booleans left) 0))
      (return)
    )
    (if (== opcode .eor)
      (let known (call known-int function ([] operands 2)))
      (if (and (. known is-known) (== (. known bits) 1))
        (= ([] booleans number) 1)
        (= ([] truths number) (if-expr (!= ([] truths left) 0) ([] truths left) left))
        (= ([] negated number) (if-expr (!= ([] truths left) 0) (as (- 1 (as ([] negated left) U32)) Byte) 1))
      )
      (return)
    )
    (let right (call number-of-operand ([] operands 2)))
    (if (and (or (== opcode .and) (== opcode .orr)) (!= right 0) (!= ([] booleans right) 0))
      (= ([] booleans number) 1)
    )
