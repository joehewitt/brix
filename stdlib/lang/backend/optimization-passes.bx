  (fn-do _ find-slot U32
    (let hash
      (scope (+ partial-hash (* key-second 0x165667b19e3779f9) (* key-third 0x27d4eb2f165667c5))
        (lazy partial-hash (+ (* key-head 0x9e3779b97f4a7c15) (* key-first 0xc2b2ae3d27d4eb4f)))
      )
    )
    (= hash (/xor/ hash (/zrshift/ hash 29)))
    (let slot (/and/ (as hash U32) mask))
    (while (!= ([] slot-numbers slot) 0)
      (if (and (== ([] heads slot) key-head) (== ([] firsts slot) key-first) same-tail)
        (return slot)
      )
      (lazy same-tail (and (== ([] seconds slot) key-second) (== ([] thirds slot) key-third)))
      (= slot (/and/ (+ slot 1) mask))
    )
    (return slot)
  )
  (fn-do _ fill-slot _
    (param slot U32)
    (param number U32)
    (param leader OperandId)
    (param block BlockId)
    (= ([] heads slot) key-head)
    (= ([] firsts slot) key-first)
    (= ([] seconds slot) key-second)
    (= ([] thirds slot) key-third)
    (= ([] slot-numbers slot) number)
    (= ([] slot-leaders slot) leader)
    (= ([] slot-blocks slot) block)
