(import ./emitter)
(import ./emitter.cleanups)
(import ./emitter.styles)
(import ./emitter.tables)
(import ./layouts)
(import ./program-tables)
(import ./receiver-stability)
(import ./runtime)
(import ./table-layouts)
(import /core/arena)
(import /core/table)
(import /lang/ast/ast)
(import /lang/ast/ast-children)
(import /lang/ast/ast-nodes)
(import /lang/ast/ast-queries)
(import /lang/ast/decl)
(import /lang/ast/module)
(import /lang/ast/operator)
(import /lang/ast/program)
(import /lang/ast/row-range)
(import /lang/ast/state-machines)
(import /lang/backend/mir)
(import /lang/check/binding)
(import /lang/check/claims)
(import /lang/check/facts)
(import /lang/check/instances)
(import /lang/check/machine-composite)
(import /lang/check/numeric)
(import /lang/check/pattern-helper)
(import /lang/check/probe-casts)
(import /lang/check/table-rows)
(import /lang/check/type-signature)
(import /lang/check/type-store)
(import /lang/check/type-text)
(import /lang/check/types)
(import /lang/ir/ir)
(import /stream/sort)

(type _ GeneratedBodies (facet-of FunctionEmitter)
  (sees Cleanups)
  (sees Styles)
  (sees Tables)
  (fn-do + emit-event-registrations _
    ; The function that puts the sections the classes of a module run from their tables in the event
    ; runtime's tables as the module starts, at the head of the module's init: for each, the event's
    ; number, the function that says whether an object is of the class, the function that runs the
    ; section, and where it falls among the event's, in the order the tables took them, with
    ; `event-register-lowered-arrival` for one that hears only what arrives at its object. Then so
    ; for each group of a machine's event transitions run from those tables, which says it is a
    ; machine's.
    (for (in index (. tables lowered-order))
      (let handler ([] (. tables lowered-functions) index))
      (let row ([] (. facts lowered-handlers) index))
      (if (or (== handler no-function) (!= (. (call class-ref types (. row type)) module) (. function module)))
        (continue)
      )
      (let matcher ([] (. tables lowered-matchers) index))
      (let mark (. pending length))
      (+= pending (call integer .machine-u64 (call (. tables event-number) (. row owner) (. row name))))
      (call (. ir depend) .callee-function matcher 0)
      (+= pending (call make-operand .operand-symbol (. ([] (. tables functions) matcher) symbol)))
      (call (. ir depend) .callee-function handler 0)
      (+= pending (call make-operand .operand-symbol (. ([] (. tables functions) handler) symbol)))
      (+= pending (call integer .machine-u64 (. row order)))
      (+= pending (call integer .machine-u8 0))
      (do
        (inline
          (call call-instance registrar 0 mark
            (block
              (lazy registrar (if-expr (. row arrives) (. facts event-register-arrival) (. facts event-register)))
            )
          )
        )
      )
    )
    (for (in row (. tables machine-descriptors))
      (if (!= (. (call class-ref types (. row type)) module) (. function module))
        (continue)
      )
      (let used ([] (. facts event-uses) (. ([] (. facts machine-groups) (. row group)) event)))
      (let mark (. pending length))
      (+= pending (call integer .machine-u64 (call (. tables event-number) (. used owner) (. used name))))
      (call (. ir depend) .callee-function (. row matcher) 0)
      (+= pending (call make-operand .operand-symbol (. ([] (. tables functions) (. row matcher)) symbol)))
      (call (. ir depend) .callee-function (. row descriptor) 0)
      (+= pending (call make-operand .operand-symbol (. ([] (. tables functions) (. row descriptor)) symbol)))
      (+= pending (call integer .machine-u64 0))
      (+= pending (call integer .machine-u8 1))
      (do
        (inline (call call-instance (. facts event-register) 0 mark))
      )
    )
    (call return-nothing)
  )
  (fn-do + emit-style-registration _
    ; The function that registers a style, made for each style the program uses and called at the
    ; head of the init of the style's module: where the runtime holds the style already it answers
    ; that; else it makes the style's record, makes the object whose properties give the style's
    ; first values, registers each property, base first, with its first value as the bits of a slot,
    ; whether that is none, its flags, the domains a change to it raises and which of its bits name
    ; boxed values, and registers the record by the style's number, which it answers. Each call is
    ; placed at the declaration of the constructor that first used the style.
    (let use ([] (. tables style-uses) (. function place)))
    (let runtime (. facts style-runtime))
    (let info-type (. ([] (. instances signatures) (. runtime register)) returns))
    (= unit (= (. unit source-module) (. use module)))
    (let site (. use site))
    (= returns-type info-type)
    (= (. ir returns) (call layout-of info-type site))
    (let key (call type-key types (. use type)))
    (let mark (. pending length))
    (+= pending (call make-operand .operand-constant (call (. ir add-string) key)))
    (let existing (call call-instance (. runtime info-for) site mark))
    (let held (call (. ir reserve-block)))
    (let making (call (. ir reserve-block)))
    (call branch (. (call present site existing) operand) held making)
    (call (. ir start-block) held)
    (call return-value
      (block
        (arg (. (call payload site (call Typed (. existing operand) (. ([] (. instances signatures) (. runtime info-for)) returns))) operand))
        (arg site)
      )
    )
    (call (. ir start-block) making)
    (= mark (. pending length))
    (+= pending (call make-operand .operand-constant (call (. ir add-string) key)))
    (+= pending (call make-operand .operand-constant (call (. ir add-string) (call type-short-name types (. use type)))))
    (+= pending (call integer .machine-u64 (. use count)))
    (let info (call call-instance (. runtime info) site mark))
    (= mark (. pending length))
    (let made (call call-instance (. use singleton) site mark))
    (let object ([] (. tables layouts objects) (. use type)))
    (if (== object no-layout)
      (call refuse .refused-function site)
      (return)
    )
    (for (in position (..< (. use first) (+ (. use first) (. use count))))
      (let property ([] (. facts style-properties) position))
      (let field (call (. tables layouts field) object (+ object-header-fields (. property slot))))
      (let value (call take (. made operand) field site))
      (let none (call integer .machine-u8 0))
      (if (call (. types is-optional) (. property type))
        (= none
          (call compare
            (block
              (arg site)
              (arg .compare-equal)
              (arg (. (call present site (call Typed value (. property type))) operand))
              (arg (call integer .machine-u8 0))
            )
          )
        )
      )
      (let bits (call style-bits site (. property type) value))
      (= mark (. pending length))
      (+= pending (. info operand))
      (+= pending (call integer .machine-u64 (- position (. use first))))
      (+= pending (call make-operand .operand-constant (call (. ir add-string) (. property name text))))
      (+= pending bits)
      (+= pending none)
      (+= pending (call integer .machine-u32 (. property flags)))
      (+= pending (call integer .machine-u32 (call (. tables property-mask) position false)))
      (+= pending (call integer .machine-u32 (call (. tables property-mask) position true)))
      (+= pending (call integer .machine-u32 (. property wide-shift)))
      (+= pending (call integer .machine-u64 (. property wide-tags)))
      (call call-instance (. runtime register-property) site mark)
    )
    (= mark (. pending length))
    (+= pending (. info operand))
    (+= pending (call integer .machine-i64 (. function place)))
    (let registered (call call-instance (. runtime register) site mark))
    (call return-value (. registered operand) site)
  )
  (fn-do + emit-sheet-registration _
    ; The function that registers a style sheet, made for each the program reads a slot of and
    ; called at the head of the init of the sheet's module, after the styles it registers there:
    ; where the runtime holds the sheet already it answers that; else it makes the sheet's record,
    ; makes the object whose properties give the slots' first values, registers each slot with its
    ; first value as bits, whether that is none and its flags, and registers the record by the
    ; sheet's number, which it answers. Each call is placed at the declaration that first took the
    ; value of one of its slots.
    (let use ([] (. tables style-sheet-uses) (. function place)))
    (let runtime (. facts style-runtime))
    (let info-type (. ([] (. instances signatures) (. runtime sheet-register)) returns))
    (= unit (= (. unit source-module) (. use module)))
    (let site (. use site))
    (= returns-type info-type)
    (= (. ir returns) (call layout-of info-type site))
    (let key (call type-key types (. use type)))
    (let mark (. pending length))
    (+= pending (call make-operand .operand-constant (call (. ir add-string) key)))
    (let existing (call call-instance (. runtime sheet-info-for) site mark))
    (let held (call (. ir reserve-block)))
    (let making (call (. ir reserve-block)))
    (call branch (. (call present site existing) operand) held making)
    (call (. ir start-block) held)
    (call return-value (. (call payload site (call Typed (. existing operand) (. ([] (. instances signatures) (. runtime sheet-info-for)) returns))) operand) site)
    (call (. ir start-block) making)
    (= mark (. pending length))
    (+= pending (call make-operand .operand-constant (call (. ir add-string) key)))
    (+= pending (call make-operand .operand-constant (call (. ir add-string) (call type-short-name types (. use type)))))
    (+= pending (call integer .machine-u64 (. use count)))
    (let info (call call-instance (. runtime sheet-info) site mark))
    (= mark (. pending length))
    (let made (call call-instance (. use singleton) site mark))
    (let object ([] (. tables layouts objects) (. use type)))
    (if (== object no-layout)
      (call refuse .refused-function site)
      (return)
    )
    (for (in offset (..< 0 (. use count)))
      (let slot ([] (. facts sheet-slots) (+ (. use first) offset)))
      (let field (call (. tables layouts field) object (+ object-header-fields (. slot slot))))
      (let value (call take (. made operand) field site))
      (let none (call integer .machine-u8 0))
      (if (call (. types is-optional) (. slot type))
        (= none
          (call compare
            (block
              (arg site)
              (arg .compare-equal)
              (arg (. (call present site (call Typed value (. slot type))) operand))
              (arg (call integer .machine-u8 0))
            )
          )
        )
      )
      (let bits (call style-bits site (. slot type) value))
      (= mark (. pending length))
      (+= pending (. info operand))
      (+= pending (call integer .machine-u64 offset))
      (+= pending (call make-operand .operand-constant (call (. ir add-string) (. slot name text))))
      (+= pending bits)
      (+= pending none)
      (+= pending (call integer .machine-u32 (. slot flags)))
      (+= pending (call integer .machine-u32 (call runtime-domains (. slot domains))))
      (call call-instance (. runtime sheet-register-slot) site mark)
    )
    (= mark (. pending length))
    (+= pending (. info operand))
    (+= pending (call integer .machine-i64 (. function place)))
    (let registered (call call-instance (. runtime sheet-register) site mark))
    (let place 0u32)
    (let family (list TypeId))
    (for (in member (. facts sheet-members))
      (if (== (. member root) (. use type))
        (+= place 1)
        (+= family (. member type))
        (let found (call (. family find) (?? (call (. types base-of) (. member type)) (. use type))))
        (let parent (if-expr found (+ (as found U32) 1) 0u32))
        (call register-sheet-member member use (. registered operand) site place parent)
      )
    )
    (call return-value (. registered operand) site)
  )
  (fn-do _ runtime-domains U32
    (param domains U32)
    (let mask 0u32)
    (for (in index (..< 0 32))
      (if (!= (/and/ domains (/lshift/ 1u32 index)) 0)
        (= mask (/or/ mask (/lshift/ 1u32 (as (call (. tables domain-number) (as index U32)) Size))))
      )
    )
    (return mask)
  )
  (fn-do _ register-sheet-member _
    (param member SheetMember)
    (param use PlacedStyle)
    (param info Operand)
    (param site SyntaxId)
    (param place U32)
    (param parent U32)
    (let runtime (. facts style-runtime))
    (let mark (. pending length))
    (+= pending info)
    (+= pending (call make-operand .operand-constant (call (. ir add-string) (call type-key types (. member type)))))
    (+= pending (call make-operand .operand-constant (call (. ir add-string) (call type-short-name types (. member type)))))
    (+= pending (call integer .machine-u32 place))
    (+= pending (call integer .machine-u32 parent))
    (let record (call call-instance (. runtime sheet-register-member) site mark))
    (let ref (call class-ref types (. member type)))
    (let owner ([] (. program modules) (. ref module)))
    (match? ([] (. owner decls) (. ref decl))
      (case (call .decl-class declared)
        (match? ([] (. owner tree nodes) (. declared syntax))
          (case (call .node-class-block row)
            (for (in offset (..< 0 (. row tags count)))
              (= mark (. pending length))
              (+= pending (. record operand))
              (+= pending
                (call make-operand
                  (block
                    (arg .operand-constant)
                    (arg (call (. ir add-string) (. ([] (. owner tree atoms) (+ (. row tags start) offset)) text)))
                  )
                )
              )
              (call call-instance (. runtime sheet-member-tag) site mark)
            )
          )
        )
      )
    )
    (= mark (. pending length))
    (let made (call call-instance (. member singleton) site mark))
    (let object ([] (. tables layouts objects) (. member type)))
    (if (== object no-layout)
      (call refuse .refused-function site)
      (return)
    )
    (for (in position (..< 0 (. member count)))
      (let offset ([] (. facts sheet-member-slots) (+ (. member first) position)))
      (let slot ([] (. facts sheet-slots) (+ (. use first) offset)))
      (let field (call (. tables layouts field) object (+ object-header-fields (. slot slot))))
      (let value (call take (. made operand) field site))
      (let none (call integer .machine-u8 0))
      (if (call (. types is-optional) (. slot type))
        (= none
          (call compare
            (block
              (arg site)
              (arg .compare-equal)
              (arg (. (call present site (call Typed value (. slot type))) operand))
              (arg (call integer .machine-u8 0))
            )
          )
        )
      )
      (let bits (call style-bits site (. slot type) value))
      (= mark (. pending length))
      (+= pending (. record operand))
      (+= pending (call integer .machine-u64 offset))
      (+= pending bits)
      (+= pending none)
      (call call-instance (. runtime sheet-member-slot) site mark)
    )
  )
  (fn-do + emit-storage-growth _
    ; The function that grows the storage of tables of one type of row in their arena, named
    ; `cold-storage-rows` or `cold-storage-spill`: given a table's header, its arena's handle and
    ; incarnation, and for the rows the capacity it has and the rows needed, or for the outside
    ; bytes of a union's rows the bytes used, the capacity and the bytes needed. It grows them as
    ; `grow-rows` or `grow-spill` says, and answers the message of what failed, or nothing where
    ; nothing did.
    (let row (. function type))
    (let count U32 (if-expr (== (. function place) 0) 5 6))
    (for (in position (..< 0 count))
      (call (. ir add-argument) u64-layout)
    )
    (= (. ir returns) managed-layout)
    (let nothing (call integer .machine-u64 0))
    (let meta
      (call TableMeta
        (block
          (arg (call make-operand .operand-argument 0))
          (arg (call make-operand .operand-argument 1))
          (arg (call make-operand .operand-argument 2))
          (arg nothing)
          (arg nothing)
        )
      )
    )
    (let first (call make-operand .operand-argument 3))
    (let second (call make-operand .operand-argument 4))
    (= cold true)
    (if (== (. function place) 0)
      (let row-layout (call layout-of row 0))
      (call grow-rows 0 row row-layout meta first second)
      (else
        (let place (call (. tables unions of) row))
        (if (== place (. U32 max))
          (call refuse-class row)
          (else
            (call grow-spill
              (block
                (arg 0)
                (arg ([] (. tables unions layouts) place))
                (arg meta)
                (arg first)
                (arg second)
                (arg (call make-operand .operand-argument 5))
              )
            )
          )
        )
      )
    )
    (= cold false)
    (call return-value (call num-cast 0 nothing u64-layout managed-layout) 0)
  )
  (fn-do + emit-union-dispatch _
    ; The function made for a member a union forwards, `union-dispatch-N`, placed where it is
    ; forwarded first and read with the facts typed there. It takes the union and the arguments
    ; written, and answers as the member made in place does. A row of a table of unions it takes is
    ; gathered there as the case it holds, its storage checked, and a case's member that runs on the
    ; row is given the row and the columns found then. Where the cases' calls let errors out it
    ; answers with them, as the type pass recorded. That of a setter takes the union and the value,
    ; sets the case the union holds, and answers nothing; one whose cases let errors out has no
    ; shape here.
    (let forward ([] (. facts forwards) (. function place)))
    (= unit (= (. unit reading) (. forward instance)))
    (let id (. forward syntax))
    (let object SyntaxId 0)
    (let name (? Atom) null)
    (match? ([] (. tree nodes) (call (. tables forward-get) forward))
      (case (call .node-get-expression read)
        (= object (. read object))
        (= name (. read name))
      )
    )
    (if (!= (. forward given) 0)
      (call set-forwarded id object forward)
      (return)
    )
    (let operands (call (. tables forward-arguments) forward))
    (if (or (!= (. operands count) 0) (!= (call (. facts role-count) (. unit reading) id .role-case) 0))
      (= name null)
    )
    (let whole (call (. facts node-type) (. unit reading) object))
    (let union (if-expr (call holds-row whole) (call table-row-type whole) whole))
    (let type (call (. facts node-type) (. unit reading) id))
    (let layout (call layout-of union id))
    (call (. ir add-argument) (call layout-of whole id))
    (let position U32 1)
    (for (in argument ([] (. tree children) operands))
      (let expression (call (. tree argument-value) argument))
      (let given (call (. facts node-type) (. unit reading) expression))
      (call (. ir add-argument) (call layout-of given id))
      (call pin expression (call make-operand .operand-argument position) given)
      (+= position 1)
    )
    (= returns-type type)
    (= (. ir returns) (call layout-of type id))
    (if (!= (. forward result) no-type)
      (call return-results (. forward result) id)
    )
    (let held (call make-operand .operand-argument 0))
    (if (call holds-row whole)
      (= held (. (call table-row-item id held whole) operand))
      (if (call takes-dispatch-row id whole)
        (let row (call make-operand .operand-argument 0))
        (= dispatch-columns (. (call value-cursor id row whole) columns))
        (= dispatch-row row)
        (= dispatch-type whole)
      )
    )
    (let answer (call dispatch-cases id object operands held layout type name))
    (= dispatch-type no-type)
    (if (and (== type (. types void-type)) (== result-type no-type))
      (call return-nothing)
      (else
        (call return-value (. answer operand) id)
      )
    )
  )
  (fn-do _ takes-dispatch-row Bool
    (param id SyntaxId)
    (param row TypeId)
    ; Whether a case's member a union forwards from a row runs on the row.
    (let fact (call (. facts first-call) (. unit reading) id))
    (while (!= fact no-fact)
      (let callee (. ([] (. facts calls) fact) callee))
      (if (and (call answers-node (. ([] (. facts calls) fact) form)) (!= callee no-instance) (call runs-on-row callee row))
        (return true)
      )
      (= fact (. ([] (. facts calls) fact) next))
    )
    (return false)
  )
  (fn-do _ set-forwarded _
    (param id SyntaxId)
    (param object SyntaxId)
    (param forward ForwardFact)
    ; The function made for a setter a union forwards: it takes the union and the value, and
    ; sets the case the union holds.
    (let union (call (. facts node-type) (. unit reading) object))
    (let given (call (. facts node-type) (. unit reading) (. forward given)))
    (call (. ir add-argument) (call layout-of union id))
    (call (. ir add-argument) (call layout-of given id))
    (call pin (. forward given) (call make-operand .operand-argument 1) given)
    (= returns-type (. types void-type))
    (= (. ir returns) void-layout)
    (let layout (call layout-of union id))
    (if (or (!= (. forward result) no-type) (not (call (. tables layouts is-union) layout)))
      (call refuse .refused-function id)
    )
    (call set-cases id id object (. forward given) (call make-operand .operand-argument 0) layout)
    (call return-nothing)
  )
  (fn-do + emit-interface-equality _
    ; The function a witness table holds for equality, `InterfaceEquality`, which has no place of
    ; its own in a stack trace. It takes two values of the table's interface, both of the table's
    ; type, out of their boxes, and compares them as the type pass planned the comparison of two
    ; values of that type: by the `==` the type declares, by the machine, as one object, or part by
    ; part.
    (let compared (. function instance))
    (let value (. ([] (. instances rows) compared) self-type))
    (let site (. ([] (. instances rows) compared) subtree start))
    (let plan (call (. facts plan-of) (. unit reading) site))
    (call (. ir add-argument) (. tables layouts interface-layout))
    (call (. ir add-argument) (. tables layouts interface-layout))
    (= returns-type (. types bool-type))
    (= (. ir returns) u8-layout)
    (if (and (!= plan .plan-call) (!= plan .plan-fields) (!= plan .plan-identity) (!= plan .plan-builtin))
      (call refuse-own)
      (return)
    )
    (let layout (call layout-of value 0))
    (= field-call (if-expr (== plan .plan-call) (call (. facts answer-call) (. unit reading) site .role-answer) (call (. facts role-call) (call (. facts first-call) (. unit reading) site) .role-field)))
    (= field-site site)
    (if (and (== plan .plan-call) (or (== field-call no-fact) uncompared))
      (call refuse-own)
      (return)
    )
    (lazy uncompared (not (call compares-pair (. ([] (. facts calls) field-call) callee) value)))
    (let left (call unbox 0 value (call make-operand .operand-argument 0)))
    (let right (call unbox 0 value (call make-operand .operand-argument 1)))
    (let differ (call (. ir reserve-block)))
    (let joined (call (. ir reserve-block)))
    (let whole (call LayoutField 0 layout value))
    (call compare-pair 0 (. left operand) whole (. right operand) whole differ)
    (if (!= field-call no-fact)
      (call refuse-own)
    )
    (= field-call no-fact)
    (= field-site 0)
    (let same (. ir current))
    (call jump joined)
    (call (. ir start-block) differ)
    (call jump joined)
    (call (. ir start-block) joined)
    (call return-value (call phi u8-layout (call integer .machine-u8 1) same (call integer .machine-u8 0) differ) 0)
  )
  (fn-expr _ compares-pair Bool
    (param callee InstanceId)
    (param value TypeId)
    ; Whether a function is the `==` of two values of a type, called on the first with the
    ; second as it is, or as the type pass recorded converting it for the call.
    (and (!= callee no-instance) (== (. ([] (. instances rows) callee) self-type) value) (call takes-argument callee value))
  )
  (fn-do + emit-witness _
    ; The function a slot of a witness table holds for a type with a function of its own. Its first
    ; argument is the interface value and the rest are the prototype's. It takes out what the value
    ; holds, as the type holds it, and calls the type's function with that and the arguments. A
    ; function of another type than the value's or a class it is derived from has no shape here, but
    ; one a property the type delegates to answers, called with what that property holds and chosen
    ; by the class of that object. An argument such a function takes as another type than the
    ; interface's gives is converted as the type pass recorded at the function's declaration.
    ; The call is made where the function is declared, the place a stack trace names, or where the
    ; interface declares its own where an argument is converted; one declared in another module has
    ; no shape then. An answer of another type than the interface's function gives is converted as
    ; the type pass recorded at that declaration. Where the interface's function raises errors, the
    ; answer is the value with no error for a type's function that raises none, and what the type's
    ; function answers for one that raises the same, or errors of classes below them, each then held
    ; as the nearest class above it that the interface's function raises, and its value converted as
    ; above. Where it raises none and the type carries errors of its own, as a generator that raises
    ; does, an error the type's function raises is a panic, with the error's text. A type's function
    ; that takes more arguments than the interface's is given the defaults of the rest, as a call
    ; that leaves them out is.
    (let row ([] (. tables witness-functions) (. function place)))
    (let theirs ([] (. instances signatures) (. row proto)))
    (if (== (. row callee) no-instance)
      (call emit-accessor row)
      (return)
    )
    (let mine ([] (. instances signatures) (. row callee)))
    (let written ([] (. instances rows) (. row callee)))
    (let fits (!= ([] (. tables instance-functions) (. row callee)) no-function))
    (if (or (not fits) (> (. theirs args count) (. mine args count)))
      (call refuse-instance (. row callee))
      (return)
    )
    (let forwards (!= (. mine errors count) 0))
    (let panics (and forwards (== (. theirs errors count) 0) (call carries-own-errors types (. row value))))
    (if panics
      (= forwards false)
    )
    (if (and forwards (== (. theirs errors count) 0))
      (call refuse-instance (. row callee))
      (return)
    )
    (let direct
      (scope (or (== (. written self-type) (. row value)) derived-class)
        (lazy derived-class (and (call (. tables is-class) (. row value)) (call (. tables derives) (. row value) (. written self-type))))
      )
    )
    (if (and (not direct) (== (. row through count) 0))
      (call refuse-instance (. row callee))
      (return)
    )
    (call (. ir add-argument) (. tables layouts interface-layout))
    (for (in position (..< 0 (. theirs args count)))
      (call (. ir add-argument) (call layout-of (call (. instances argument-type) (. row proto) position) 0))
    )
    (let converts (. row converts))
    (let declared ([] (. instances rows) (. row proto)))
    (if (and converts (or (== (. row through count) 0) other-module (== (. declared subtree count) 0)))
      (call refuse-instance (. row callee))
    )
    (lazy other-module (!= (. declared module) (. written module)))
    (= returns-type (. theirs returns))
    (= (. ir returns) (call layout-of returns-type 0))
    (if (!= (. theirs errors count) 0)
      (call return-results (. theirs result) 0)
    )
    (let kept (- (+ (. written subtree start) (. written subtree count)) 1))
    (let site kept)
    (if converts
      (= site (- (+ (. declared subtree start) (. declared subtree count)) 1))
    )
    (let mark (. pending length))
    (let taken (call unbox 0 (. row value) (call make-operand .operand-argument 0)))
    (let reached (call read-through site (call Typed (. taken operand) (. row value)) (. row through)))
    (+= pending (. reached operand))
    (if (and (!= (. row through count) 0) unrelated-value)
      (call refuse-instance (. row callee))
    )
    (lazy unrelated-value
      (block
        (and (!= (. reached type) (. written self-type)) (not (call is-derived (. reached type) (. written self-type))))
      )
    )
    (for (in position (..< 0 (. theirs args count)))
      (let own (call make-operand .operand-argument (+ position 1)))
      (let wanted (call (. instances argument-type) (. row callee) position))
      (if (!= (call (. instances argument-type) (. row proto) position) wanted)
        (= own (. (call convert-recorded (. row callee) kept .reason-argument site (call Typed own (call (. instances argument-type) (. row proto) position)) wanted) operand))
      )
      (+= pending own)
    )
    (let own-unit unit)
    (= unit (= (. unit reading) (. row callee)))
    (for (in position (..< (. theirs args count) (. mine args count)))
      (let expected (call (. instances argument-type) (. row callee) position))
      (let argumented
        (call default-argument
          (block
            (arg kept)
            (arg (. row callee))
            (arg (call parameter-default (. row callee) position))
            (arg expected)
          )
        )
      )
      (+= pending (. argumented operand))
      (if (!= (. argumented type) expected)
        (call refuse .refused-conversion kept)
      )
    )
    (= unit own-unit)
    (= takes-result (or forwards panics))
    (let answer (call call-method (. row callee) site mark (== (. row through count) 0)))
    (if panics
      (= answer (call panic-on-error site (. row callee) (. answer operand)))
    )
    (if (and (not forwards) (!= (. theirs returns) (. mine returns)))
      (= answer (call convert-recorded (. row callee) kept .reason-return site answer (. theirs returns)))
    )
    (if (and forwards (!= (. theirs result) (. mine result)))
      (call return-recased
        (block
          (arg (. answer operand))
          (arg (. mine result))
          (arg site)
          (arg (if-expr (!= (. theirs returns) (. mine returns)) (. row callee) no-instance))
          (arg kept)
        )
      )
      (else-if forwards
        (call return-held (. answer operand))
      )
      (else-if (and (== returns-type (. types void-type)) (== result-type no-type))
        (call return-nothing)
      )
      (else
        (call return-value (. answer operand) 0)
      )
    )
  )
  (fn-do _ emit-accessor _
    (param row WitnessFunction)
    ; The function a slot of a witness table holds for a getter or a setter that a class
    ; answers with a property it stores: it reads the property of the object the interface
    ; value holds, or stores its argument there. A getter a tuple or a struct answers with a
    ; field reads it where the value was boxed. A getter or a setter a property the class
    ; delegates to answers reads the properties the type pass named to reach it first. A property
    ; that holds what the optional a getter answers holds is wrapped in it. A property of any
    ; other type than the getter answers or the setter is given has no shape here, no setter
    ; of a value that is no object has, and nor has a lazy property reached so.
    (let theirs ([] (. instances signatures) (. row proto)))
    (let place (. row property))
    (if (or (> (. theirs args count) 1) (!= (. theirs errors count) 0) (>= place (. types properties length)))
      (call refuse-class (. row value))
      (return)
    )
    (let lent (!= (. row through count) 0))
    (if (and lent (!= (. ([] (. types properties) place) storage-kind) .storage-eager))
      (call refuse-class (. row value))
      (return)
    )
    (if (and plain-value (or (== (. theirs args count) 1) (not (call (. tables layouts is-struct) (call layout-of (. row value) 0)))))
      (call refuse-class (. row value))
      (return)
    )
    (lazy plain-value (not (call (. tables is-class) (. row value))))
    (call (. ir add-argument) (. tables layouts interface-layout))
    (let object (call load (call make-operand .operand-argument 0) 0 managed-layout 0))
    (if (== (. theirs args count) 1)
      (let given (call (. instances argument-type) (. row proto) 0))
      (call (. ir add-argument) (call layout-of given 0))
      (if (!= (. theirs returns) (. types void-type))
        (call refuse-class (. row value))
      )
      (let holder (call read-through 0 (call Typed object (. row value)) (. row through)))
      (call store-held (. holder operand) 0 (. holder type) place (call make-operand .operand-argument 1) given 0)
      (call return-nothing)
      (return)
    )
    (= returns-type (. theirs returns))
    (= (. ir returns) (call layout-of returns-type 0))
    (let holder (call read-through 0 (call Typed object (. row value)) (. row through)))
    (let answer
      (call load-property
        (block
          (arg 0)
          (arg (. holder operand))
          (arg (. holder type))
          (arg (. ([] (. types properties) place) name))
          (arg true)
          (arg returns-type)
        )
      )
    )
    (if (and (!= (. answer type) returns-type) wraps-value)
      (= answer (call wrap 0 answer returns-type))
    )
    (lazy wraps-value
      (block
        (and (call (. types is-optional) returns-type) (== (call (. types optional-inner) returns-type) (. answer type)))
      )
    )
    (if (!= (. answer type) returns-type)
      (call refuse-class (. row value))
      (return)
    )
    (call return-value (. answer operand) 0)
  )
)
