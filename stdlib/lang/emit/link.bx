(import /data/json)
(import /lang/ast/program)
(import /lang/constants)
(import /lang/host.linux)
(import /lang/host.macos)
(import /lang/runtime-config)
(import /lang/target)
(import /os/env)
(import /os/file)
(import /os/path)
(import /os/process)
(import /unistd.h)

(type + LinkPlan (is Tuple)
  ; A link's linker command line, and the files besides the object that it reads.
  (blank)
  (prop + arguments (list String))
  (prop + inputs (list String))
)

(fn-do + link-plan LinkPlan (?! Error)
  (param program Program)
  (param object-path String)
  (param executable-path String)
  (param target Target)
  ; Plans how to link an object into an executable for a target, with the linker of its object format
  ; and the arguments the project's runtime build config names. It links the components the config
  ; always links, those whose headers the program imports, and every component they require. The
  ; target's entry in the config names its family, triple and libraries, and for Apple targets its
  ; SDK, the default SDK when it names none, or for Linux its sysroot and linker. The host's runtime
  ; is built with the toolchain and has every component; another target's entry names its build
  ; directory and the components built for it, and its runtime is built here when it is stale. On
  ; the host, the runtime is the variant the environment chooses, and a sanitizer's runtime library
  ; is linked with it.
  (let config (call runtime-config))
  (let platform (call target-config config target))
  (let variant (call runtime-variant config))
  (throw (call Error (str "BRIX_GC_MODE, BRIX_SANITIZER and BRIX_BENCH_RUNTIME choose a runtime only for " (. (call host-target) name))) (if (and (!= (. target name) (. (call host-target) name)) (. variant is-chosen))))
  (throw (call Error "BRIX_SANITIZER is supported only for Apple targets") (if (and (. variant sanitizer) (!= (. target object-format) .macho))))
  (let build-path (call (. variant build-path) (call target-build-path target platform)))
  (if (!= (. target name) (. (call host-target) name))
    (call build-runtime target build-path)
  )
  (let components (call link-components config program target platform))
  (let family (call config-string platform "family"))
  (let linked
    (call LinkInputs
      (block
        (arg config)
        (arg platform)
        (arg build-path)
        (arg components)
        (arg family)
        (arg (call (. variant omitted-archives) config build-path))
      )
    )
  )
  (let arguments
    (match (. target object-format)
      (case= .macho
        (call apple-link-arguments
          (block
            (arg linked)
            (arg target)
            (arg object-path)
            (arg executable-path)
            (arg (call sanitizer-library config variant))
          )
        )
      )
      (case= .elf
        (call linux-link-arguments linked object-path executable-path)
      )
    )
  )
  (let inputs (list String))
  (+= inputs (as (call runtime-config-path) String))
  (++= inputs (. linked library-files))
  (++= inputs (. linked archives))
  (return (call LinkPlan arguments inputs))
)

(fn-do + link-executable _ (?! Error)
  (param plan LinkPlan)
  (param record-path (? String))
  ; Runs a link plan's linker, and writes its command line to the record path when one is given.
  (let process (call Process ([] (. plan arguments) 0) ([] (. plan arguments) (... 1))))
  (let output (as process String))
  (let status (?? (call (. process wait) null) 1))
  (call (. process close))
  (throw (call Error (str "Linking failed with status " status "\n" output)) (if (!= status 0)))
  (if record-path
    (call write-file-atomically (call Path record-path) (call to-json (call link-record (. plan arguments))))
  )
)

(fn-do + run-executable Int
  (param path String)
  (param arguments (list String))
  ; Replaces this process with the program, so its output, input and exit status are the
  ; program's own. Returns only when the program could not be started.
  (let argv ([] String (+ (. arguments length) 2)))
  (= ([] argv 0) path)
  (for (in index (..< 0 (. arguments length)))
    (= ([] argv (+ index 1)) ([] arguments index))
  )
  (call C:execv path argv)
  (<- stderr (str "Unable to run " path "\n"))
  (return 1)
)

(type _ LinkInputs (is Tuple)
  ; What a link reads from the runtime build config: the config, the target's entry in it, where the
  ; target's runtime is built, the components the program links, the target's family, and the
  ; archives the runtime's GC mode does not build.
  (blank)
  (prop + config JSON)
  (prop + platform JSON)
  (prop + build-path Path)
  (prop + components (list JSON))
  (prop + family String)
  (prop + omitted (list String))
  (fn-do + library-files (list String) :get
    ; The prebuilt libraries the components name.
    (let files (list String))
    (for (in component components)
      (for (in path (call component-strings component family "libraryPaths"))
        (+= files (as (call runtime-file path build-path) String))
      )
    )
    (return files)
  )
  (fn-do + archives (list String) :get
    ; The archives the runtime build makes for the components.
    (let paths (list String))
    (for (in component components)
      (let archive ([] (as component (map String JSON)) "archive"))
      (if (and archive (is archive String))
        (let path (as (/ build-path (as archive String)) String))
        (if (not (has omitted path))
          (+= paths path)
        )
      )
    )
    (return paths)
  )
)

(type _ RuntimeVariant (is Tuple)
  ; The host runtime a link uses: the GC mode `BRIX_GC_MODE` names, `normal` when it names none, the
  ; sanitizer `BRIX_SANITIZER` names, if any, and whether `BRIX_BENCH_RUNTIME` asks for the runtime
  ; built with benchmark metrics.
  (blank)
  (prop + gc-mode-name String)
  (prop + gc-mode JSON)
  (prop + sanitizer (? JSON))
  (prop + bench Bool)
  (fn-expr + is-chosen Bool :get
    (or (!= gc-mode-name "normal") (!= sanitizer null) bench)
  )
  (fn-do + build-path Path (?! Error)
    (param root Path)
    ; Where the variant's runtime is built under a build root: in the GC mode's build directory and
    ; then the sanitizer's, when they name one and the root is not already there, and in `bench` for
    ; the benchmark runtime.
    (let path root)
    (let mode-directory (call config-optional-string gc-mode "buildDirectory"))
    (if (and mode-directory (!= (. path name) mode-directory))
      (= path (/ path mode-directory))
    )
    (if sanitizer
      (let sanitizer-directory (call config-string sanitizer "buildDirectory"))
      (if (!= (. path name) sanitizer-directory)
        (= path (/ path sanitizer-directory))
      )
    )
    (if bench
      (= path (/ path "bench"))
    )
    (return path)
  )
  (fn-do + omitted-archives (list String) (?! Error)
    (param config JSON)
    (param build-path Path)
    ; The archives of the runtime projects the GC mode leaves out of its runtime.
    (let projects (call config-member config "runtimeProjects"))
    (let archives (list String))
    (for (in name (call config-strings gc-mode "omitProjects"))
      (+= archives (as (/ build-path (call config-string (call config-member projects name) "archive")) String))
    )
    (return archives)
  )
)

(fn-do _ runtime-variant RuntimeVariant (?! Error)
  (param config JSON)
  ; The host runtime the environment chooses. A benchmark-only GC mode needs the benchmark runtime.
  (let mode-name (. (call (. (?? (call env "BRIX_GC_MODE") "") trim)) lowercased))
  (let name (if-expr (!= mode-name "") mode-name "normal"))
  (let modes (call config-member config "gcModes"))
  (let mode (only-if ([] (as modes (map String JSON)) name) (if (is modes (map String JSON)))))
  (let names (list String))
  (for (in (tuple key _) (as modes (map String JSON)))
    (+= names key)
  )
  (throw (call Error (str "BRIX_GC_MODE must be one of " (call (. ", " join) names))) (if (not mode)))
  (let bench (call environment-flag "BRIX_BENCH_RUNTIME"))
  (let benchmark-only (only-if ([] (as mode (map String JSON)) "benchmarkOnly") (if (is mode (map String JSON)))))
  (throw (call Error (str "BRIX_GC_MODE=" name " is benchmark-only; set BRIX_BENCH_RUNTIME=1")) (if (and benchmark-only (is benchmark-only Bool) (as benchmark-only Bool) (not bench))))
  (return (call RuntimeVariant name mode (call runtime-sanitizer config) bench))
)

(fn-do _ runtime-sanitizer (? JSON) (?! Error)
  (param config JSON)
  ; The sanitizer `BRIX_SANITIZER` names by its name in the runtime build config or by its build
  ; directory, or none when it is empty, `off` or `none`.
  (let value (. (call (. (?? (call env "BRIX_SANITIZER") "") trim)) lowercased))
  (return-if null (if (or (== value "") (== value "off") (== value "none"))))
  (let sanitizers (call config-member config "sanitizers"))
  (let names (list String))
  (for (in (tuple name sanitizer) (as sanitizers (map String JSON)))
    (return-if sanitizer (if (or (== name value) (== (call config-optional-string sanitizer "buildDirectory") value))))
    (+= names name)
  )
  (throw (call Error (str "BRIX_SANITIZER must be off, none or one of " (call (. ", " join) names))))
)

(fn-expr _ environment-flag Bool (?! Error)
  (param name String)
  (before
    ; Whether an environment variable is set to true: 1, true, yes or on, against empty, 0, false, no or
    ; off.
    (throw (call Error (str name " must be 0 or 1")) (if (and (not truth) (not (has (list "" "0" "false" "no" "off") value)))))
  )
  truth
  (where
    (lazy value (. (call (. (?? (call env name) "") trim)) lowercased))
    (lazy truth (has (list "1" "true" "yes" "on") value))
  )
)

(fn-do _ sanitizer-library (? Path) (?! Error)
  (param config JSON)
  (param variant RuntimeVariant)
  ; The runtime library of the variant's sanitizer, where the toolchain's C compiler keeps it.
  (return-if null (if (not (. variant sanitizer))))
  (let name (call config-string (. variant sanitizer) "library"))
  (let compiler (call config-string (call config-member config "toolchain") "cCompiler"))
  (let process (call Process "/usr/bin/xcrun" compiler (str "-print-file-name=" name)))
  (let output (as process String))
  (let status (?? (call (. process wait) null) 1))
  (call (. process close))
  (let library (call Path (call (. output trim))))
  (throw (call Error (str "The toolchain's " compiler " has no " name " for BRIX_SANITIZER")) (if (or (!= status 0) (not (. library is-file)))))
  (return library)
)

(fn-do _ apple-link-arguments (list String) (?! Error)
  (param linked LinkInputs)
  (param target Target)
  (param object-path String)
  (param executable-path String)
  (param sanitizer-library (? Path))
  ; The link ld makes for an Apple target. A sanitizer's runtime library is linked with a search path
  ; that finds it where the toolchain keeps it.
  (let platform (. linked platform))
  (let triple-parts (list String) (call (. (call config-string platform "triple") split) "-"))
  (let sdk-name (call config-optional-string platform "sdk"))
  (let sdk (if-expr sdk-name (call apple-sdk-path sdk-name) sdk-root))
  (let arguments (list String))
  (+= arguments (call apple-linker-path))
  (+= arguments "-dynamic")
  (+= arguments "-arch")
  (+= arguments ([] triple-parts 0))
  (+= arguments "-platform_version")
  (+= arguments (. target name))
  (+= arguments (call os-version-text (. target minimum-os-version)))
  (+= arguments (call sdk-version sdk))
  (+= arguments "-syslibroot")
  (+= arguments (as sdk String))
  (let frameworks (list String))
  (for (in component (. linked components))
    (for (in framework (call component-strings component (. linked family) "frameworks"))
      (if (not (has frameworks framework))
        (+= frameworks framework)
      )
    )
  )
  (for (in framework frameworks)
    (+= arguments "-framework")
    (+= arguments framework)
  )
  (++= arguments (. linked library-files))
  (if sanitizer-library
    (+= arguments (as sanitizer-library String))
    (+= arguments "-rpath")
    (+= arguments (as (. sanitizer-library dir) String))
  )
  (for (in library (call config-strings platform "libraries"))
    (+= arguments (str "-l" library))
  )
  (++= arguments (. linked archives))
  (for (in flag (call config-strings (call config-member (. linked config) "runtimeLink") "warningFlags"))
    (+= arguments flag)
  )
  (+= arguments "-o")
  (+= arguments executable-path)
  (+= arguments object-path)
  (+= arguments "-lSystem")
  (return arguments)
)

(fn-do _ linux-link-arguments (list String) (?! Error)
  (param linked LinkInputs)
  (param object-path String)
  (param executable-path String)
  ; The link clang's driver makes for a position-independent executable against the sysroot's
  ; shared glibc, with libstdc++ and libgcc linked statically.
  (let platform (. linked platform))
  (let sysroot (call runtime-file (call config-string platform "sysroot") (. linked build-path)))
  (let gcc (/ sysroot (call config-string platform "gccInstallDirectory")))
  (let libraries (/ sysroot "usr/lib64"))
  (let arguments (list String))
  (+= arguments (as (call runtime-file (call config-string platform "linker") (. linked build-path)) String))
  (+= arguments (str "--sysroot=" sysroot))
  (++= arguments (list "-EL" "--hash-style=gnu" "--eh-frame-hdr" "-m" "aarch64linux" "-pie" "-z" "relro" "-z" "now"))
  (++= arguments (list "-dynamic-linker" "/lib/ld-linux-aarch64.so.1"))
  (+= arguments "-o")
  (+= arguments executable-path)
  (+= arguments (as (/ libraries "Scrt1.o") String))
  (+= arguments (as (/ libraries "crti.o") String))
  (+= arguments (as (/ gcc "crtbeginS.o") String))
  (+= arguments (str "-L" gcc))
  (+= arguments (str "-L" libraries))
  (+= arguments object-path)
  (++= arguments (. linked archives))
  (++= arguments (. linked library-files))
  (for (in library (call config-strings platform "libraries"))
    (+= arguments (str "-l" library))
  )
  (++= arguments (list "-Bstatic" "-lstdc++" "-Bdynamic" "-lm" "-lgcc" "-lgcc_eh" "-lc" "-lgcc" "-lgcc_eh"))
  (+= arguments (as (/ gcc "crtendS.o") String))
  (+= arguments (as (/ libraries "crtn.o") String))
  (return arguments)
)

(fn-expr _ link-record (map String JSON)
  (param arguments (list String))
  (call (of Map String JSON)
    (block
      (entry "arguments" (as (call json-strings arguments) JSON))
    )
  )
)

(fn-expr _ json-strings (list JSON)
  (param values (list String))
  (case-each (in value values)
    (as value JSON)
  )
)

(fn-do _ link-components (list JSON) (?! Error)
  (param config JSON)
  (param program Program)
  (param target Target)
  (param platform JSON)
  (let components (map String JSON))
  (for (in group (list "runtimeProjects" "externalLibraries"))
    (let found (only-if ([] (as config (map String JSON)) group) (if (is config (map String JSON)))))
    (if (and found (is found (map String JSON)))
      (for (in (tuple name component) (as found (map String JSON)))
        (if (is component (map String JSON))
          (= ([] components name) component)
        )
      )
    )
  )
  (let providers (map String String))
  (for (in (tuple name component) components)
    (let exports ([] (as component (map String JSON)) "exports"))
    (if (and exports (is exports (map String JSON)))
      (for (in (tuple _ root) (as exports (map String JSON)))
        (if (is root String)
          (= ([] providers root) name)
        )
      )
    )
  )
  (blank)
  (let pending (list (tuple String String)))
  (for (in name (call config-strings (call config-member config "runtimeLink") "always"))
    (+= pending (tuple name "runtimeLink.always"))
  )
  (for (in module (. program modules))
    (let slash (?? (call (. module name find) "/") 0))
    (if (and (> slash 0) (call (. module name ends-with) ".h"))
      (let provider ([] providers ([] (. module name) (..< 0 slash))))
      (if provider
        (+= pending (tuple provider (. module name)))
      )
    )
  )
  (let required (map String Bool))
  (let index Size)
  (while (< index (. pending length))
    (let name ([] ([] pending index) 0))
    (let required-by ([] ([] pending index) 1))
    (+= index 1)
    (if (not ([] required name))
      (let component ([] components name))
      (throw (call Error (str "The runtime build config's " required-by " requires unknown " name)) (if (not component)))
      (throw (call Error (str required-by " requires " name ", which the runtime build config does not build for " (. target name))) (if (and (!= (. target name) (. (call host-target) name)) (not builds-component))))
      (lazy builds-component (has (call config-strings platform "components") name))
      (= ([] required name) true)
      (for (in dependency (call config-strings component "requires"))
        (+= pending (tuple dependency name))
      )
    )
  )
  (blank)
  (let linked (list JSON))
  (for (in (tuple name component) components)
    (if ([] required name)
      (+= linked component)
    )
  )
  (return linked)
)

(fn-expr _ component-strings (list String)
  (param component JSON)
  (param family String)
  (param name String)
  ; A component's list for a family of targets: the family's own list when the component names one,
  ; and the component's list otherwise.
  (case? (and override (is override (map String JSON)) ([] (as override (map String JSON)) name))
    (call config-strings override name)
  )
  (default
    (call config-strings component name)
  )
  (where
    (lazy overrides (only-if ([] (as component (map String JSON)) "targets") (if (is component (map String JSON)))))
    (lazy override (only-if ([] (as overrides (map String JSON)) family) (if (and overrides (is overrides (map String JSON))))))
  )
)

(fn-do _ sdk-version String (?! Error)
  (param sdk Path)
  (return (call config-string (call JSON (call read-file-text (/ sdk "SDKSettings.json"))) "Version"))
)

(fn-expr _ os-version-text String
  (param version U32)
  (str (/zrshift/ version 16) "." (/and/ (/zrshift/ version 8) 0xff) "." (/and/ version 0xff))
)
