(import /core/arena)
(import /core/table)
(import /lang/ast/decl)
(import /lang/ast/program)
(import /lang/backend/bundle)
(import /lang/backend/mir)
(import /lang/check/stable-key)
(import /lang/check/type-store)
(import /lang/check/types)
(blank)
(prop + no-layout LayoutId (= (. U32 max)))
(prop + first-struct-layout LayoutId (= 14))
(prop + object-header-fields U32 (= 2))
(prop + large-struct-size U32 (= 16))
(prop + void-layout LayoutId (= 0))
(prop + pointer-layout LayoutId (= 1))
(prop + managed-layout LayoutId (= 2))
(prop + u8-layout LayoutId (= 3))
(prop + i8-layout LayoutId (= 4))
(prop + u16-layout LayoutId (= 5))
(prop + i16-layout LayoutId (= 6))
(prop + u32-layout LayoutId (= 7))
(prop + i32-layout LayoutId (= 8))
(prop + u64-layout LayoutId (= 9))
(prop + i64-layout LayoutId (= 10))
(prop + f32-layout LayoutId (= 11))
(prop + f64-layout LayoutId (= 12))
(prop + compiler-buffer-count U32 (= 512))
(prop + plain-site-count U32 (= 129))
(blank)
(prop _ empty-vector-name _ (= "gcvec.empty"))
(prop _ pointer-descriptor-name _ (= "gcdesc.pointer"))
(prop _ pointer-buffer-name _ (= "gcbufdesc.pointer"))
(prop _ function-descriptor-name _ (= "gcdesc.function"))
(prop _ function-buffer-name _ (= "gcbufdesc.function"))
(prop _ interface-descriptor-name _ (= "gcdesc.interface"))
(prop _ interface-buffer-name _ (= "gcbufdesc.interface"))
(prop _ inline-allocation-limit U64 (= 1024))
(prop _ site-key-size U64 (= 48))
(prop _ thread-cache-compiler-buffers-offset U64 (= 104))
(prop _ runtime-buffer-size U64 (= 80))
(blank)
(type-line + LayoutId (is U32))

(fn-expr + is-integer Bool
  (param layout LayoutId)
  (and (>= layout u8-layout) (<= layout i64-layout))
)

(fn-expr + is-signed Bool
  (param layout LayoutId)
  (or (== layout i8-layout) (== layout i16-layout) (== layout i32-layout) (== layout i64-layout))
)

(fn-expr + is-float Bool
  (param layout LayoutId)
  (or (== layout f32-layout) (== layout f64-layout))
)

(fn-expr + is-number Bool
  (param layout LayoutId)
  (or (call is-integer layout) (call is-float layout))
)

(fn-expr + is-pointer Bool
  (param layout LayoutId)
  (or (== layout pointer-layout) (== layout managed-layout))
)

(fn-expr + is-managed-pointer Bool
  (param layout LayoutId)
  (== layout managed-layout)
)

(type + Layout (is Struct)
  ; How a value is held. A scalar is one machine kind in a register. A struct is `size` bytes
  ; of fields in memory, and its value in a register is its address. `descriptor` names the GC
  ; descriptor of a layout that holds managed pointers, `buffer` that of a buffer of such
  ; values, and `type` is the type it was built for. `format` is how a struct travels to a
  ; function and back. A union is a struct of its tag alone, with `cases` the payload each case
  ; holds behind the tag, all at one place.
  (blank)
  (prop + kind MachineKind)
  (prop + size U32)
  (prop + alignment U32)
  (prop + fields Span)
  (prop + is-managed Bool)
  (prop + descriptor StringId (= no-string))
  (prop + type TypeId (= no-type))
  (prop + format StructFormat (= .small-format))
  (prop + buffer StringId (= no-string))
  (prop + cases Span (= (call Span)))
  (prop + site StringId (= no-string))
  (prop + shape LayoutId (= no-layout))
)

(type + Layouts
  ; The machine layout of every type of the sealed store that has one, built once before
  ; emission and read by every worker. A scalar's layout id is its machine kind. `values` gives
  ; the layout of a value of a type, and `objects` the layout of the object a class's value
  ; points to. `function-layout` is that of a value of any function type: the code it runs, and
  ; the data that code is given first. `interface-layout` is that of a value of any interface
  ; type: what it holds, which the collector follows, and the witness table of what it holds.
  ; A type without a layout is one emission has no shape for yet.
  (blank)
  (prop + rows (of Table Layout))
  (prop + fields (of Table LayoutField))
  (prop + values (of CPointer U32))
  (prop + objects (of CPointer U32))
  (prop + function-layout LayoutId (= no-layout))
  (prop + interface-layout LayoutId (= no-layout))
  (prop + memo-places (? (of CPointer Byte)))
  (blank)
  (prop _ types Types)
  (prop _ bundle Bundle)
  (prop _ arena Arena)
  (prop _ states (of CPointer Byte))
  (prop _ placed (of CPointer Byte))
  (prop _ described (list Byte))
  (prop _ buffered (list Byte))
  (prop _ plain-sites (list StringId))
  (prop _ empty-slot StringId (= no-string))
  (prop _ shapes (of Map Size U32 ArenaBacking))
  (prop _ memo-flags _ (= (call (of Map Size U32))))
  (fn-do + This _
    (param types Types)
    (param bundle Bundle)
    (param arena Arena)
    (lazy rows (call (of Table Layout) arena 64))
    (lazy fields (call (of Table LayoutField) arena 64))
    (lazy shapes (call (of Map Size U32) arena))
  )
  (fn-expr + count U32 :get
    (as (. rows length) U32)
  )
  (fn-do + build _
    ; Lays out every type the seal reached. Scalars come first, in the order of their machine kinds,
    ; so a kind is its own layout id, and then the types in their ranked order.
    (let count (. types rows length))
    (= values (call (of (. arena allocate) U32) count))
    (= objects (call (of (. arena allocate) U32) count))
    (= states (call (of (. arena allocate) Byte) count))
    (= placed (call (of (. arena allocate) Byte) count))
    (for (in id (..< 0 count))
      (= ([] values id) no-layout)
      (= ([] objects id) no-layout)
      (= ([] states id) 0)
      (= ([] placed id) 0)
    )
    (for (in slots (..< 0 plain-site-count))
      (+= plain-sites (call (. bundle intern) (str "gcsite.plain." (* slots 8))))
    )
    (call add-scalar .machine-void 0)
    (call add-scalar .machine-pointer 8)
    (call add-scalar .machine-managed-pointer 8)
    (call add-scalar .machine-u8 1)
    (call add-scalar .machine-i8 1)
    (call add-scalar .machine-u16 2)
    (call add-scalar .machine-i16 2)
    (call add-scalar .machine-u32 4)
    (call add-scalar .machine-i32 4)
    (call add-scalar .machine-u64 8)
    (call add-scalar .machine-i64 8)
    (call add-scalar .machine-f32 4)
    (call add-scalar .machine-f64 8)
    (call (. rows append) (call Layout .machine-struct 0 1 (call Span) false))
    (= (. ([] rows managed-layout) descriptor) (call (. bundle intern) pointer-descriptor-name))
    (= (. ([] rows managed-layout) buffer) (call (. bundle intern) pointer-buffer-name))
    (let parts (list LayoutId))
    (+= parts pointer-layout)
    (+= parts managed-layout)
    (let held (list TypeId))
    (+= held no-type)
    (+= held no-type)
    (= function-layout (call placed-fields parts held false no-type))
    (= (. ([] rows function-layout) descriptor) (call (. bundle intern) function-descriptor-name))
    (= (. ([] rows function-layout) buffer) (call (. bundle intern) function-buffer-name))
    (let words (list LayoutId))
    (+= words managed-layout)
    (+= words pointer-layout)
    (= interface-layout (call placed-fields words held false no-type))
    (= (. ([] rows interface-layout) descriptor) (call (. bundle intern) interface-descriptor-name))
    (= (. ([] rows interface-layout) buffer) (call (. bundle intern) interface-buffer-name))
    (for (in id (. types ranked))
      (if (!= id invalid-type)
        (call value-layout id)
      )
    )
    (for (in id (. types ranked))
      (if (!= id invalid-type)
        (call object-layout id)
      )
    )
    (let total U32 (as (. rows length) U32))
    (for (in id (..< 0 total))
      (+= described 0)
      (+= buffered 0)
      (let row ([] rows id))
      (if (and (== (. row kind) .machine-struct) (. row is-managed) (!= (. row type) no-type))
        (let shape (call share id))
        (if (!= shape id)
          (= (. ([] rows id) descriptor) (. ([] rows shape) descriptor))
          (= (. ([] rows id) site) (. ([] rows shape) site))
          (= (. ([] rows id) buffer) (. ([] rows shape) buffer))
          (continue)
        )
        (let key (call hex-text ([] (. types stable-keys) (. row type))))
        (= (. ([] rows id) descriptor) (call (. bundle intern) (str "gcdesc." key)))
        (= (. ([] rows id) site) (call (. bundle intern) (str "gcsite." key)))
        (= (. ([] rows id) buffer) (call (. bundle intern) (str "gcbufdesc." key)))
      )
    )
  )
  (fn-expr + kind-of MachineKind @inline
    (param layout LayoutId)
    (. ([] rows layout) kind)
  )
  (fn-expr + is-struct Bool @inline
    (param layout LayoutId)
    (>= layout first-struct-layout)
  )
  (fn-expr + is-large Bool
    (param layout LayoutId)
    ; Whether a struct travels through memory: the caller passes the address of a copy, and gives
    ; the address a result is written to.
    (and (>= layout first-struct-layout) (== (. ([] rows layout) format) .large-format))
  )
  (fn-expr + field LayoutField
    (param layout LayoutId)
    (param index U32)
    ([] fields (+ (. ([] rows layout) fields start) index))
  )
  (fn-expr + memo-flag U32
    (param layout LayoutId)
    (param index U32)
    (?? ([] memo-flags (+ (. ([] rows layout) fields start) index)) (. U32 max))
  )
  (fn-expr + stack-descriptor StringId
    (param layout LayoutId)
    ; The descriptor the collector reads memory of a layout by, when the memory is a struct that
    ; holds managed pointers. A pointer alone needs none.
    (if-expr (or (< layout first-struct-layout) (not (. ([] rows layout) is-managed))) no-string struct-descriptor)
    (where
      (lazy struct-descriptor (. ([] rows layout) descriptor))
    )
  )
  (fn-do + pointee-size U32
    (param type TypeId)
    ; The size of what a C pointer points at, which a count added to the pointer steps by. A
    ; pointer to nothing steps by the size of a pointer, and one whose type does not say by one
    ; byte.
    (let owner (call (. types type-decl) .cpointer))
    (let current type)
    (while (!= current no-type)
      (match? ([] (. types rows) current)
        (case (call .type-class row)
          (if (and (== (. row module) (. owner module)) (== (. row decl) (. owner decl)) (== (. row args count) 1))
            (let pointee (call (. types child-type) (. row args) 0))
            (if (or (== pointee no-type) (== pointee invalid-type))
              (return 1)
            )
            (let layout ([] values pointee))
            (if (== layout void-layout)
              (return (. ([] rows pointer-layout) size))
            )
            (if (or (== layout no-layout) (== (. ([] rows layout) size) 0))
              (return 1)
            )
            (return (. ([] rows layout) size))
          )
        )
      )
      (= current (. ([] (. types completions) current) base))
    )
    (return 1)
  )
  (fn-do + pointee-type TypeId
    (param type TypeId)
    ; What a C pointer points at, or no type for a type that is not a C pointer or does not say.
    (let owner (call (. types type-decl) .cpointer))
    (let current type)
    (while (!= current no-type)
      (match? ([] (. types rows) current)
        (case (call .type-class row)
          (if (and (== (. row module) (. owner module)) (== (. row decl) (. owner decl)) (== (. row args count) 1))
            (return (call (. types child-type) (. row args) 0))
          )
        )
      )
      (= current (. ([] (. types completions) current) base))
    )
    (return no-type)
  )
  (fn-do + environment LayoutId
    (param children (list LayoutId))
    (param held (list TypeId))
    (param name String)
    ; The layout of an environment, which holds the locals of one run of a scope that nested
    ; functions capture: the fields given, the first of them the link to the environment around
    ; it. The capture of a spawned task's body is laid out so too, with no link, and the memory
    ; of a task's locals. No type has any of them, so each is named for what describes it to the
    ; collector.
    (let id (call placed-fields children held false no-type))
    (+= described 0)
    (+= buffered 0)
    (if (. ([] rows id) is-managed)
      (let shape (call share id))
      (if (!= shape id)
        (= (. ([] rows id) descriptor) (. ([] rows shape) descriptor))
        (= (. ([] rows id) site) (. ([] rows shape) site))
        (return id)
      )
    )
    (= (. ([] rows id) descriptor) (call (. bundle intern) (str "gcdesc." name)))
    (= (. ([] rows id) site) (call (. bundle intern) (str "gcsite." name)))
    (return id)
  )
  (fn-expr + is-union Bool
    (param layout LayoutId)
    (and (>= layout first-struct-layout) (!= (. ([] rows layout) cases count) 0))
  )
  (fn-expr + case-field LayoutField
    (param layout LayoutId)
    (param index U32)
    ([] fields (+ (. ([] rows layout) cases start) index))
  )
  (fn-expr + shared LayoutId
    (param layout LayoutId)
    (if-expr (!= (. ([] rows layout) shape) no-layout) (. ([] rows layout) shape) layout)
  )
  (fn-do + add-descriptor _
    (param layout LayoutId)
    ; Adds a layout's GC descriptor to the object, and the descriptors it names, each once: the
    ; layout's size, the offsets of its managed pointers, and a range for each optional or union
    ; that holds them. A range names what describes each case by the number the tag gives it,
    ; and nothing for a case that holds no pointers.
    (if (== layout no-layout)
      (return)
    )
    (let own (call shared layout))
    (if (!= ([] described own) 0)
      (return)
    )
    (= ([] described own) 1)
    (let row ([] rows own))
    (if (not (. row is-managed))
      (return)
    )
    (let pointers (list U32))
    (let ranges (list TaggedRange))
    (call collect own 0 pointers ranges)
    (for (in range ranges)
      (if (. range is-union)
        (let held (. ([] rows (. range layout)) cases))
        (for (in position (..< (. held start) (. held end)))
          (call add-descriptor (. ([] fields position) layout))
        )
        (else
          (call add-descriptor (. range layout))
        )
      )
    )
    (let name (call (. bundle text) (. row descriptor)))
    (let pointer-items (list ConstantItem))
    (for (in offset pointers)
      (+= pointer-items (call quad offset))
    )
    (let pointer-slot (call vector (str name ".ptrs") pointer-items))
    (let range-items (list ConstantItem))
    (let index 0)
    (for (in range ranges)
      (let case-items (list ConstantItem))
      (for (in described-case (call case-descriptors range))
        (+= case-items (if-expr (!= described-case no-string) (call label described-case) (call quad 0)))
      )
      (let cases (call vector (str name ".range" index ".cases") case-items))
      (let range-name (call (. bundle intern) (str name ".range" index)))
      (let entry (list ConstantItem))
      (+= entry (call quad (. range flag)))
      (+= entry (call quad (. range payload)))
      (+= entry (call label cases))
      (call add-table range-name entry)
      (+= range-items (call label range-name))
      (+= index 1)
    )
    (let range-slot (call vector (str name ".unions") range-items))
    (let none (list ConstantItem))
    (let nothing (call vector "" none))
    (let items (list ConstantItem))
    (+= items (call quad (. row size)))
    (+= items (call label pointer-slot))
    (+= items (call label nothing))
    (+= items (call quad 0))
    (+= items (call label nothing))
    (+= items (call quad 0))
    (+= items (call label range-slot))
    (+= items (call ConstantItem .byte-constant 0 no-string))
    (+= items (call ConstantItem .byte-constant 0 no-string))
    (call add-table (. row descriptor) items)
  )
  (fn-do + add-buffer-descriptor _
    (param layout LayoutId)
    ; Adds to the object the GC descriptor of a buffer of items of a layout, once, and the
    ; descriptor of an item, which it names: no object, the size of an item, and what describes
    ; one.
    (let own (call shared layout))
    (let row ([] rows own))
    (if (or (== (. row buffer) no-string) (!= ([] buffered own) 0))
      (return)
    )
    (= ([] buffered own) 1)
    (call add-descriptor own)
    (let none (list ConstantItem))
    (let nothing (call vector "" none))
    (let items (list ConstantItem))
    (+= items (call quad 0))
    (+= items (call label nothing))
    (+= items (call label nothing))
    (+= items (call quad (. row size)))
    (+= items (call label nothing))
    (+= items (call label (. row descriptor)))
    (+= items (call label nothing))
    (+= items (call ConstantItem .byte-constant 1 no-string))
    (+= items (call ConstantItem .byte-constant 0 no-string))
    (call add-table (. row buffer) items)
  )
  (fn-expr + descriptor-order Comparison
    (param layout LayoutId)
    (param other LayoutId)
    ; Orders two layouts as their GC descriptors go in the object: by the stable keys of their types,
    ; then by the names of their descriptors, which tell apart those of no type, and then by number,
    ; an order that does not depend on the order typing interned the types or the program tables
    ; laid them out.
    (case? (< key held)
      (. Comparison lesser)
    )
    (case? (> key held)
      (. Comparison greater)
    )
    (case? (< name other-name)
      (. Comparison lesser)
    )
    (case? (> name other-name)
      (. Comparison greater)
    )
    (case? (< layout other)
      (. Comparison lesser)
    )
    (case? (> layout other)
      (. Comparison greater)
    )
    (default
      (. Comparison equal)
    )
    (where
      (lazy key (if-expr (!= (. ([] rows layout) type) no-type) (as ([] (. types stable-keys) (. ([] rows layout) type)) U64) 0u64))
      (lazy held (if-expr (!= (. ([] rows other) type) no-type) (as ([] (. types stable-keys) (. ([] rows other) type)) U64) 0u64))
      (lazy name (if-expr (!= (. ([] rows layout) descriptor) no-string) (call (. bundle text) (. ([] rows layout) descriptor)) ""))
      (lazy other-name
        (block
          (case? (!= (. ([] rows other) descriptor) no-string)
            (call (. bundle text) (. ([] rows other) descriptor))
          )
          (default
            ""
          )
        )
      )
    )
  )
  (fn-do + add-site-key _
    (param layout LayoutId)
    (param index U32)
    (let row ([] rows layout))
    (call add-table (. row site) (call site-items (. row size) (call label (. row descriptor)) 1 index))
  )
  (fn-expr + plain-site StringId
    (param requested U64)
    ([] plain-sites (as (/ (call allocated-size requested) 8) U32))
  )
  (fn-do + add-plain-site-key _
    (param allocated U64)
    (param index U32)
    (call add-table (call plain-site allocated) (call site-items allocated (call quad 0) 0 index))
  )
  (fn-do _ add-scalar _
    (param kind MachineKind)
    (param size U32)
    (let alignment (if-expr (!= size 0) size 1u32))
    (call (. rows append) (call Layout kind size alignment (call Span) (== kind .machine-managed-pointer)))
  )
  (fn-do _ value-layout LayoutId
    (param type TypeId)
    ; The layout of a value of a type, built when first asked for. A type that holds itself by
    ; value has none.
    (if (or (== type no-type) (== type invalid-type))
      (return no-layout)
    )
    (if (== ([] states type) 2)
      (return ([] values type))
    )
    (if (== ([] states type) 1)
      (return no-layout)
    )
    (= ([] states type) 1)
    (let layout (call build-value type))
    (= ([] values type) layout)
    (= ([] states type) 2)
    (return layout)
  )
  (fn-do _ build-value LayoutId
    (param type TypeId)
    (let completion ([] (. types completions) type))
    (if (or (!= (. completion completion) .completion-done) (. completion has-variables))
      (return no-layout)
    )
    (let fn (call function-row types type))
    (if (!= fn no-type)
      (match? ([] (. types rows) fn)
        (case (call .type-function row)
          (return (if-expr (. row is-c) pointer-layout function-layout))
        )
      )
    )
    (match (. completion intrinsic)
      (case= .void
        (return void-layout)
      )
      (case= .string
        (return managed-layout)
      )
      (case= .class
        (return managed-layout)
      )
      (case= .style
        (return managed-layout)
      )
      (case= .style-sheet
        (return managed-layout)
      )
      (case= .cpointer
        (if (call traces-pointer type)
          (return managed-layout)
        )
        (return pointer-layout)
      )
      (case= .bool
        (return u8-layout)
      )
      (case= .int1
        (return u8-layout)
      )
      (case= .char
        (return u32-layout)
      )
      (case= .float32
        (return f32-layout)
      )
      (case= .float64
        (return f64-layout)
      )
      (case= .int8
        (return i8-layout)
      )
      (case= .uint8
        (return u8-layout)
      )
      (case= .int16
        (return i16-layout)
      )
      (case= .uint16
        (return u16-layout)
      )
      (case= .int32
        (return i32-layout)
      )
      (case= .uint32
        (return u32-layout)
      )
      (case= .int64
        (return i64-layout)
      )
      (case= .uint64
        (return u64-layout)
      )
      (case= .tuple
        (return (call struct-layout type false (call collects-storage type)))
      )
      (case= .array-builder
        (return (call struct-layout type false))
      )
      (case= .struct
        (return (call struct-layout type false))
      )
      (case= .table
        (return (call struct-layout type false true))
      )
      (case= .table-row
        (return (call struct-layout type false true))
      )
      (case= .table-span
        (return (call struct-layout type false true))
      )
      (case= .table-column
        (return (call struct-layout type false true))
      )
      (case= .immutable-table
        (return (call struct-layout type false true))
      )
      (case= .immutable-table-row
        (return (call struct-layout type false true))
      )
      (case= .immutable-table-span
        (return (call struct-layout type false true))
      )
      (case= .immutable-table-column
        (return (call struct-layout type false true))
      )
      (case= .table-selection
        (return (call struct-layout type false))
      )
      (case= .immutable-table-selection
        (return (call struct-layout type false))
      )
      (case= .index-span
        (return (call struct-layout type false))
      )
      (case= .table-mark
        (return (call struct-layout type false))
      )
      (case= .optional
        (return (call optional-layout type))
      )
      (case= .union
        (return (call union-layout type))
      )
      (case= .type-info
        (return pointer-layout)
      )
      (case= .atom
        (return pointer-layout)
      )
      (case= .binding
        (return (call binding-layout type))
      )
      (case= .closure
        (return managed-layout)
      )
      (case= .interface
        (return interface-layout)
      )
      (default
        (return no-layout)
      )
    )
    (return no-layout)
  )
  (fn-do _ traces-pointer Bool
    (param type TypeId)
    ; Whether the collector follows a C pointer: one that points at values, not at pointers.
    (let owner (call (. types type-decl) .cpointer))
    (let current type)
    (while (!= current no-type)
      (match? ([] (. types rows) current)
        (case (call .type-class row)
          (if (and (== (. row module) (. owner module)) (== (. row decl) (. owner decl)) (== (. row args count) 1))
            (let pointee (call (. types child-type) (. row args) 0))
            (if (or (== pointee no-type) (== pointee invalid-type))
              (return false)
            )
            (return (!= (. ([] (. types completions) pointee) intrinsic) .cpointer))
          )
        )
      )
      (= current (. ([] (. types completions) current) base))
    )
    (return false)
  )
  (fn-do _ collects-storage Bool
    (param type TypeId)
    ; Whether a type is an array or an immutable array on the collected heap, whose first field, the
    ; storage, the collector follows however its items are typed.
    (match? ([] (. types rows) type)
      (case (call .type-class row)
        (let array (call (. types array-decl refers-to) (. row module) (. row decl)))
        (let immutable (call (. types immutable-array-decl refers-to) (. row module) (. row decl)))
        (let backed (and (== (. row args count) 2) (== (call (. types child-type) (. row args) 1) (. types gc-backing-type))))
        (return (and (or array immutable) backed))
      )
    )
    (return false)
  )
  (fn-do _ object-layout _
    (param type TypeId)
    ; Lays out the object of a class after the objects of the classes above it, each once.
    (let waiting (list TypeId))
    (let current type)
    (while (and (!= current no-type) (== ([] placed current) 0))
      (= ([] placed current) 1)
      (+= waiting current)
      (= current (. ([] (. types completions) current) base))
    )
    (for (in offset (..< 0 (. waiting length)))
      (call place-object ([] waiting (- (. waiting length) 1 offset)))
    )
  )
  (fn-do _ place-object _
    (param type TypeId)
    ; The layout of the object a class's value points to: the class table's address, the
    ; object's id, and the stored properties. An object of a class is also an object of its
    ; base, so a class has no object here when its base has none, or when it gives a property
    ; another type than its base does: a read through the base would find another value at the
    ; property's place.
    (let completion ([] (. types completions) type))
    (if (or (!= (. completion completion) .completion-done) (. completion has-variables))
      (return)
    )
    (if (not (call intrinsic-is-class (. completion intrinsic)))
      (return)
    )
    (match? ([] (. types rows) type)
      (case .type-class
        (if (call holds-base type)
          (= ([] objects type) (call struct-layout type true))
        )
      )
    )
  )
  (fn-do _ holds-base Bool
    (param type TypeId)
    (let completion ([] (. types completions) type))
    (let base (. completion base))
    (if (== base no-type)
      (return true)
    )
    (if (== ([] objects base) no-layout)
      (return false)
    )
    (let above (. ([] (. types completions) base) properties))
    (if (> (. above count) (. completion properties count))
      (return false)
    )
    (for (in position (..< 0 (. above count)))
      (let theirs ([] (. types properties) (+ (. above start) position)))
      (let mine ([] (. types properties) (+ (. completion properties start) position)))
      (if (and (!= (. theirs storage-kind) .storage-getter) (!= (. theirs type) (. mine type)))
        (return false)
      )
    )
    (return true)
  )
  (fn-do _ struct-layout LayoutId
    (param type TypeId)
    (param is-object Bool)
    (param traces-first Bool (= false))
    ; A struct of a type's stored properties, each at the next multiple of its alignment, behind the
    ; object header when it lays out an object. A lazy property is held with a byte beside it that
    ; says whether it has its value, so both are at one place in an object of the class that
    ; declares the property and of every class derived from it. A table and its views, and an array
    ; on the collected heap (`collects-storage`), trace their first field, the columns or the data,
    ; however it is typed.
    (let range (. ([] (. types completions) type) properties))
    (let children (list LayoutId))
    (let held (list TypeId))
    (let memos (list Bool))
    (for (in position (..< 0 (. range count)))
      (let place (+ (. range start) position))
      (let property ([] (. types properties) place))
      (if (== (. property storage-kind) .storage-getter)
        (continue)
      )
      (let child (call value-layout (. property type)))
      (if (== child no-layout)
        (return no-layout)
      )
      (if (and traces-first (== (. children length) 0))
        (= child managed-layout)
      )
      (if (== (. property storage-kind) .storage-lazy)
        (= child (call flagged-layout child (. property type)))
      )
      (+= children child)
      (+= held (. property type))
      (+= memos (and is-object (call is-memo-place place)))
    )
    (return (call placed-fields children held is-object type memos))
  )
  (fn-expr _ is-memo-place Bool
    (param place U32)
    (if-expr found (!= ([] found place) 0) false)
    (where
      (lazy found memo-places)
    )
  )
  (fn-do _ binding-layout LayoutId
    (param type TypeId)
    ; A binding as the tuple of what it holds: the value it calls on or calls, where it has one,
    ; then the arguments bound so far, each as it was given. One that holds nothing has no size.
    (let children (list LayoutId))
    (let held (list TypeId))
    (match? ([] (. types rows) type)
      (case (call .type-binding row)
        (if (and (!= (. row object) no-type) (!= (. row form) .bound-constructor))
          (+= held (. row object))
        )
        (for (in offset (..< (. row param-count) (. row items count)))
          (+= held (call (. types child-type) (. row items) offset))
        )
      )
    )
    (let sized false)
    (for (in item held)
      (let child (call value-layout item))
      (if (== child no-layout)
        (return no-layout)
      )
      (if (!= child void-layout)
        (= sized true)
      )
      (+= children child)
    )
    (if (not sized)
      (return void-layout)
    )
    (return (call placed-fields children held false type))
  )
  (fn-do _ placed-fields LayoutId
    (param children (list LayoutId))
    (param held (list TypeId))
    (param is-object Bool)
    (param type TypeId)
    (param memos (? (list Bool)) (= null))
    ; A struct of fields of these layouts, each at the next multiple of its alignment, behind
    ; the object header when it lays out an object.
    (let start U32 (as (. fields length) U32))
    (let offset U32)
    (let alignment U32 1)
    (let managed false)
    (if is-object
      (call (. fields append) (call LayoutField 0 pointer-layout))
      (call (. fields append) (call LayoutField 8 u32-layout))
      (= offset 12)
      (= alignment 8)
    )
    (let position 0)
    (for (in child children)
      (let row ([] rows child))
      (if (!= (. row size) 0)
        (= offset (call aligned offset (. row alignment)))
        (if (> (. row alignment) alignment)
          (= alignment (. row alignment))
        )
      )
      (call (. fields append) (call LayoutField offset child ([] held position)))
      (+= offset (. row size))
      (if (and memos ([] memos position))
        (= ([] memo-flags (- (. fields length) 1)) offset)
        (+= offset 1)
      )
      (+= position 1)
      (if (. row is-managed)
        (= managed true)
      )
    )
    (let size (call aligned offset alignment))
    (let id LayoutId (as (. rows length) LayoutId))
    (let count U32 (as (- (. fields length) start) U32))
    (call (. rows append) (call Layout .machine-struct size alignment (call Span start count) managed no-string type))
    (= (. ([] rows id) format) (call format-of id))
    (return id)
  )
  (fn-do _ flagged-layout LayoutId
    (param child LayoutId)
    (param inner TypeId)
    ; A lazy property as an object holds it: its value, and a byte that is set once it has one.
    (let row ([] rows child))
    (let alignment (if-expr (!= (. row alignment) 0) (. row alignment) 1))
    (let start U32 (as (. fields length) U32))
    (call (. fields append) (call LayoutField 0 child inner))
    (call (. fields append) (call LayoutField (. row size) u8-layout))
    (let size (call aligned (+ (. row size) 1) alignment))
    (let id LayoutId (as (. rows length) LayoutId))
    (call (. rows append)
      (block
        (arg (call Layout .machine-struct size alignment (call Span start 2) (. row is-managed) no-string no-type))
      )
    )
    (= (. ([] rows id) format) (call format-of id))
    (return id)
  )
  (fn-do _ optional-layout LayoutId
    (param type TypeId)
    ; An optional is its value and a byte that says whether it has one. An optional of an atom
    ; or a class is the pointer, which points at nothing where there is none. `Null`'s own value
    ; is that pointer, so an optional of it keeps the byte.
    (let inner (call (. types optional-inner) type))
    (if (== inner type)
      (return no-layout)
    )
    (let held (. ([] (. types completions) inner) intrinsic))
    (if (or (== held .atom) (and (== held .class) (!= inner (. types null-type))))
      (return (call value-layout inner))
    )
    (let child (call value-layout inner))
    (if (== child no-layout)
      (return no-layout)
    )
    (let row ([] rows child))
    (let start U32 (as (. fields length) U32))
    (call (. fields append) (call LayoutField 0 child inner))
    (call (. fields append) (call LayoutField (. row size) i8-layout))
    (let size (call aligned (+ (. row size) 1) (. row alignment)))
    (let id LayoutId (as (. rows length) LayoutId))
    (let fields-span (call Span start 2))
    (call (. rows append)
      (block
        (arg (call Layout .machine-struct size (. row alignment) fields-span (. row is-managed) no-string type))
      )
    )
    (= (. ([] rows id) format) (call format-of id))
    (return id)
  )
  (fn-do _ union-layout LayoutId
    (param type TypeId)
    ; A union is a byte that says which case it holds and then the case, with no padding between
    ; or after: as large as its largest case and one byte. A case with no value of its own holds
    ; a byte.
    (let children (list LayoutId))
    (let held (list TypeId))
    (for (in fact (call (. types cases-of) type))
      (let child (call value-layout (. fact type)))
      (if (== child no-layout)
        (return no-layout)
      )
      (+= children child)
      (+= held (. fact type))
    )
    (if (or (== (. children length) 0) (> (. children length) 256))
      (return no-layout)
    )
    (let start U32 (as (. fields length) U32))
    (call (. fields append) (call LayoutField 0 u8-layout))
    (let largest U32)
    (let managed false)
    (let position 0)
    (for (in child children)
      (let row ([] rows child))
      (if (> (. row size) largest)
        (= largest (. row size))
      )
      (if (. row is-managed)
        (= managed true)
      )
      (call (. fields append) (call LayoutField 1 child ([] held position)))
      (+= position 1)
    )
    (let id LayoutId (as (. rows length) LayoutId))
    (call (. rows append) (call Layout .machine-struct (+ largest 1) 1 (call Span start 1) managed no-string type))
    (= (. ([] rows id) cases) (call Span (+ start 1) (as (. children length) U32)))
    (= (. ([] rows id) format) (call format-of id))
    (return id)
  )
  (fn-expr _ format-of StructFormat
    (param layout LayoutId)
    ; How a struct travels: up to four floats of one size in float registers, 16 bytes or less
    ; in one or two general registers, and anything else through memory.
    (case? (and (or (== leaf f32-layout) (== leaf f64-layout)) (<= (call leaf-count layout leaf) 4))
      (. StructFormat hfa-format)
    )
    (case? (> (. ([] rows layout) size) large-struct-size)
      (. StructFormat large-format)
    )
    (default
      (. StructFormat small-format)
    )
    (where
      (lazy leaf (call first-leaf layout))
    )
  )
  (fn-do _ first-leaf LayoutId
    (param layout LayoutId)
    ; The first field of a struct that is no struct itself, or nothing for a struct without one.
    (let current layout)
    (while (>= current first-struct-layout)
      (if (== (. ([] rows current) fields count) 0)
        (return void-layout)
      )
      (= current (. ([] fields (. ([] rows current) fields start)) layout))
    )
    (return current)
  )
  (fn-do _ leaf-count U32
    (param layout LayoutId)
    (param leaf LayoutId)
    ; How many fields a struct holds when each is of one scalar layout, inside any struct it
    ; holds too. More than four for a struct that holds anything else, or none.
    (if (< layout first-struct-layout)
      (return (if-expr (== layout leaf) 1 5))
    )
    (let row ([] rows layout))
    (if (== (. row fields count) 0)
      (return 5)
    )
    (let count U32)
    (for (in position (..< (. row fields start) (. row fields end)))
      (+= count (call leaf-count (. ([] fields position) layout) leaf))
      (if (> count 4)
        (return 5)
      )
    )
    (return count)
  )
  (fn-do _ share LayoutId
    (param layout LayoutId)
    (let words (call shape-words layout))
    (let key stable-key-seed)
    (for (in word words)
      (= key (call mixed key word))
    )
    (let slot (as key Size))
    (let held (?? ([] shapes slot) no-layout))
    (while (and (!= held no-layout) (!= (call shape-words held) words))
      (+= slot 1)
      (= held (?? ([] shapes slot) no-layout))
    )
    (if (== held no-layout)
      (= ([] shapes slot) layout)
      (= held layout)
    )
    (= (. ([] rows layout) shape) held)
    (return held)
  )
  (fn-do _ shape-words (list U64)
    (param layout LayoutId)
    (let pointers (list U32))
    (let ranges (list TaggedRange))
    (call collect layout 0 pointers ranges)
    (let words (list U64))
    (+= words (. ([] rows layout) size))
    (+= words (as (. pointers length) U64))
    (for (in offset pointers)
      (+= words offset)
    )
    (+= words (as (. ranges length) U64))
    (for (in range ranges)
      (let cases (call case-descriptors range))
      (+= words (. range flag))
      (+= words (. range payload))
      (+= words (as (. cases length) U64))
      (for (in described-case cases)
        (+= words described-case)
      )
    )
    (return words)
  )
  (fn-do _ case-descriptors (list StringId)
    (param range TaggedRange)
    (let cases (list StringId))
    (if (not (. range is-union))
      (+= cases no-string)
      (+= cases (. ([] rows (. range layout)) descriptor))
      (return cases)
    )
    (let held (. ([] rows (. range layout)) cases))
    (for (in position (..< (. held start) (. held end)))
      (let child ([] rows (. ([] fields position) layout)))
      (+= cases (if-expr (. child is-managed) (. child descriptor) no-string))
    )
    (return cases)
  )
  (fn-do _ collect _
    (param layout LayoutId)
    (param base U32)
    (param pointers (list U32))
    (param ranges (list TaggedRange))
    (let row ([] rows layout))
    (if (== (. row kind) .machine-managed-pointer)
      (+= pointers base)
      (return)
    )
    (if (or (!= (. row kind) .machine-struct) (not (. row is-managed)))
      (return)
    )
    (let first (. row fields start))
    (if (!= (. row cases count) 0)
      (+= ranges (call TaggedRange base (+ base 1) layout true))
      (return)
    )
    (if (call is-optional-value layout)
      (let payload ([] fields first))
      (if (. ([] rows (. payload layout)) is-managed)
        (let flag (+ base (. ([] fields (+ first 1)) offset)))
        (+= ranges (call TaggedRange flag (+ base (. payload offset)) (. payload layout) false))
      )
      (return)
    )
    (for (in position (..< first (. row fields end)))
      (call collect (. ([] fields position) layout) (+ base (. ([] fields position) offset)) pointers ranges)
    )
  )
  (fn-expr _ is-optional-value Bool
    (param layout LayoutId)
    (case? (or (== type no-type) (!= ([] values type) layout))
      false
    )
    (default
      (== (. ([] (. types completions) type) intrinsic) .optional)
    )
    (where
      (lazy type (. ([] rows layout) type))
    )
  )
  (fn-do _ vector StringId
    (param name String)
    (param items (list ConstantItem))
    ; A list the runtime reads: a slot that points at its state, which points at its items. Every
    ; empty list is the same one.
    (if (== (. items length) 0)
      (if (== empty-slot no-string)
        (let empty-state (call (. bundle intern) (str empty-vector-name ".state")))
        (let state (list ConstantItem))
        (+= state (call quad 0))
        (+= state (call quad 0))
        (+= state (call quad 0))
        (call add-table empty-state state)
        (= empty-slot (call (. bundle intern) (str empty-vector-name ".slot")))
        (let slot (list ConstantItem))
        (+= slot (call label empty-state))
        (call add-table empty-slot slot)
      )
      (return empty-slot)
    )
    (let items-name (call (. bundle intern) (str name ".items")))
    (call add-table items-name items)
    (let state-name (call (. bundle intern) (str name ".state")))
    (let state (list ConstantItem))
    (+= state (call label items-name))
    (+= state (call quad (as (. items length) U64)))
    (+= state (call quad (as (. items length) U64)))
    (call add-table state-name state)
    (let slot-name (call (. bundle intern) (str name ".slot")))
    (let slot (list ConstantItem))
    (+= slot (call label state-name))
    (call add-table slot-name slot)
    (return slot-name)
  )
  (fn-do _ add-table _
    (param name StringId)
    (param items (list ConstantItem))
    (let start U32 (as (. bundle constant-items length) U32))
    (for (in item items)
      (call (. bundle constant-items append) item)
    )
    (call (. bundle constant-tables append) (call ConstantTable name 8 (call Span start (as (. items length) U32))))
  )
  (fn-do _ site-items (list ConstantItem)
    (param requested U64)
    (param descriptor ConstantItem)
    (param pointer-kind U64)
    (param index U32)
    (let allocated (call allocated-size requested))
    (let offset 0u64)
    (if (!= index 0)
      (= offset (+ thread-cache-compiler-buffers-offset (* (as (- index 1) U64) runtime-buffer-size)))
    )
    (let items (list ConstantItem))
    (+= items (call quad (/ allocated 8)))
    (+= items (call quad requested))
    (+= items (call quad allocated))
    (+= items descriptor)
    (+= items (call quad (/or/ (as index U64) (/lshift/ pointer-kind 32))))
    (+= items (call quad (/or/ (as (. bundle gc-allocation-buffer-version) U64) (/lshift/ site-key-size 32))))
    (+= items (call quad offset))
    (return items)
  )
)

(type + MachineKind (is U32)
  (variant machine-void (= 0))
  (variant machine-pointer (= 1))
  (variant machine-managed-pointer (= 2))
  (variant machine-u8 (= 3))
  (variant machine-i8 (= 4))
  (variant machine-u16 (= 5))
  (variant machine-i16 (= 6))
  (variant machine-u32 (= 7))
  (variant machine-i32 (= 8))
  (variant machine-u64 (= 9))
  (variant machine-i64 (= 10))
  (variant machine-f32 (= 11))
  (variant machine-f64 (= 12))
  (variant machine-struct (= 13))
)

(type + LayoutField (is Struct)
  ; Where a struct holds a field, how the field is held, and the type of the property it
  ; holds, when it holds one.
  (blank)
  (prop + offset U32)
  (prop + layout LayoutId)
  (prop + type TypeId (= no-type))
)

(fn-expr + allocated-size U64
  (param requested U64)
  (* (/ (+ least 7) 8) 8)
  (where
    (lazy least (if-expr (> requested 8) requested 8u64))
  )
)

(fn-expr + inlines-allocation Bool
  (param requested U64)
  (and (!= requested 0) (<= (call allocated-size requested) inline-allocation-limit))
)

(fn-do + hex-text String
  (param value U64)
  (let text ([] Byte 16))
  (for (in position (..< 0 16))
    (let digit (as (/and/ (/zrshift/ value (- 60 (* position 4))) 15) U32))
    (= ([] text position) (as (if-expr (< digit 10) (+ digit 48) (+ digit 87)) Byte))
  )
  (return (call (. text slice-string) (..< 0 16)))
)

(type _ TaggedRange (is Tuple)
  ; Where an optional or a union that holds managed pointers lies in a layout: its flag or tag,
  ; what it holds, and the layout of the optional's value or of the union.
  (blank)
  (prop + flag U32)
  (prop + payload U32)
  (prop + layout LayoutId)
  (prop + is-union Bool)
)

(fn-expr _ quad ConstantItem
  (param value U64)
  (call ConstantItem .quad-constant value no-string)
)

(fn-expr _ label ConstantItem
  (param name StringId)
  (call ConstantItem .label-constant 0 name)
)

(fn-expr _ aligned U32
  (param offset U32)
  (param alignment U32)
  (* (/ (- (+ offset alignment) 1) alignment) alignment)
)
