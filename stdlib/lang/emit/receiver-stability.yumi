./program-tables
./runtime
/lang/ast/decl
/lang/ast/program
/lang/backend/mir
/lang/check/instances
/lang/check/types
/lang/ir/ir

━━━━━━━━━━━━━━━━━━━━
+ Stability is U32

` What code may do to the storage of a row of a table of unions, as TypeScript judges it from
` the code: `stable` where nothing in it may move the storage, `unstable` where something
` may, and `unsure` where what decides it is not read here.

| stable = 0
| unstable = 1
| unsure = 2

━━━━━━━━━━━━━━━━━━━━
+ CallJudgment is Tuple

` What a call may do to storage. A call of a function TypeScript judges by the function's own
` code names the function as `callee`, and is `unsure` until that code is read.

+ stability Stability
+ callee FunctionId = no-function

━━━━━━━━━━━━━━━━━━━━
+ CalleeScan is Tuple

` What a function's own code may do to storage, and the functions it calls that are judged by
` their own code in turn.

+ stability Stability
+ callees [U32]

━━━━━━━━━━━━━━━━━━━━
+ ReceiverReads is Tuple

` Where a function reads its receiver. A row's `roots` is the frame or the local whose memory
` its value addresses, `made` says the row's value is made from the receiver, and `ahead` that
` the receiver is read after the row.

+ roots [U32]
+ made [Bool]
+ ahead [Bool]

━━━━━━━━━━━━━━━━━━━━
+ do receiver-reads ReceiverReads
    - ir IRFunction
    - watched [U32]

` Where a function reads its receiver, which is the arguments `watched` and any value made from
` them: the value of a row that reads one, and a frame or a local's memory that such a row
` writes or that a call reading one is given. A local holds no receiver, as TypeScript's
` variables hold none: a value read from one is its own.
. count = ir.instructions.length
. roots = frame-roots(ir)
. made [Bool]
. ahead [Bool]
for _ in 0 .. < count
    made += false
    ahead += false
. changed = true
while changed
    changed = false
    for id in 0 .. < count
        . span = ir.instructions[id].operands
        if !reads-receiver(ir, span, made, watched)
            continue
        if !made[id]
            made[id] = true
            changed = true
        for position in span.start .. < span.end
            . operand = ir.operands[position]
            if operand-kind(operand) == .operand-value
                . root = roots[operand-payload(operand)]
                if root != U32.max && !made[root]
                    made[root] = true
                    changed = true

. later [Bool]
for _ in 0 .. < ir.blocks.length
    later += false
for position in 0 .. < ir.order.length
    . block = ir.order[position]
    . rows = ir.blocks[block].instructions
    for id in rows.start .. < rows.end
        if reads-receiver(ir, ir.instructions[id].operands, made, watched)
            later[block] = true
changed = true
while changed
    changed = false
    for position in 0 .. < ir.order.length
        . block = ir.order[position]
        if !later[block] && leads-to-read(ir, block, later)
            later[block] = true
            changed = true
for position in 0 .. < ir.order.length
    . block = ir.order[position]
    . rows = ir.blocks[block].instructions
    . reread = leads-to-read(ir, block, later)
    . id = rows.end
    while id > rows.start
        id -= 1
        ahead[id] = reread
        if reads-receiver(ir, ir.instructions[id].operands, made, watched)
            reread = true
= ReceiverReads(roots, made, ahead)

━━━━━━━━━━━━━━━━━━━━
+ do receiver-callees [U32]
    - ir IRFunction
    - tables ProgramTables
    - instances Instances
    - program Program
    - reads ReceiverReads

` The functions judged by their own code that a function calls where it reads its receiver
` after the call.
. callees [U32]
for id in 0 .. < ir.instructions.length
    . row = ir.instructions[id]
    if !reads.ahead[id] || (row.op != .op-call && row.op != .op-call-void)
        continue
    . judgment = call-judgment(ir, tables, instances, program, row, true)
    if judgment.callee != no-function && callees.find(judgment.callee) == null
        callees += judgment.callee
= callees

━━━━━━━━━━━━━━━━━━━━
+ do receiver-stability Stability
    - ir IRFunction
    - tables ProgramTables
    - instances Instances
    - program Program
    - reads ReceiverReads
    - watched [U32]
    - judged [U32]
    - verdicts [Stability]

` Whether a function may move its receiver's storage before it reads the receiver again, as
` TypeScript's `tableUnionCaseReceiverIsStable` judges it. A write into the receiver, a frame,
` a local's memory or the function's result moves nothing. A call does, unless it is of one
` of the runtime's functions that allocate or poll, the check for a terminating task, or a
` function whose code was judged so: `verdicts` holds what each function of `judged` was
` judged to do. So does a call TypeScript makes of a function it generates.
for position in 0 .. < ir.made-calls.length
    if reads.ahead[ir.made-calls[position]]
        = .unstable
. verdict = Stability.stable
for id in 0 .. < ir.instructions.length
    if !reads.ahead[id]
        continue
    . row = ir.instructions[id]
    . moved = Stability.stable
    if stores || row.op == .op-copy || row.op == .op-zero
        moved = if writes then .unstable else .stable
        .. writes = writes-outside(ir, row, reads.roots, reads.made, watched)
    else if row.op == .op-call || row.op == .op-call-void
        . judgment = call-judgment(ir, tables, instances, program, row, true)
        moved = judgment.stability
        if judgment.callee != no-function
            moved = .unsure
            for position in 0 .. < judged.length
                if judged[position] == judgment.callee
                    moved = verdicts[position]
    .. stores = row.op == .op-store || row.op == .op-store-release
    if moved == .unstable
        = .unstable
    if moved == .unsure
        verdict = .unsure
= verdict

━━━━━━━━━━━━━━━━━━━━
+ do own-stability CalleeScan
    - ir IRFunction
    - tables ProgramTables
    - instances Instances
    - program Program

` What a function's own code may do to storage, as TypeScript's
` `tableUnionCaseFunctionStorageStable` reads it: any write outside the function's frame, its
` locals' memory and its result moves storage, and so does any call that may, among them one
` TypeScript makes of a function it generates.
. callees [U32]
if ir.made-calls.length != 0
    = CalleeScan(.unstable, callees)
. roots = frame-roots(ir)
. none [Bool]
for _ in 0 .. < ir.instructions.length
    none += false
. unwatched [U32]
. verdict = Stability.stable
for id in 0 .. < ir.instructions.length
    . row = ir.instructions[id]
    if stores || row.op == .op-copy || row.op == .op-zero
        if writes-outside(ir, row, roots, none, unwatched)
            = CalleeScan(.unstable, callees)
    else if row.op == .op-call || row.op == .op-call-void
        . judgment = call-judgment(ir, tables, instances, program, row, false)
        if judgment.stability == .unstable
            = CalleeScan(.unstable, callees)
        if judgment.callee != no-function
            if callees.find(judgment.callee) == null
                callees += judgment.callee
        else if judgment.stability == .unsure
            verdict = .unsure
    .. stores = row.op == .op-store || row.op == .op-store-release
= CalleeScan(verdict, callees)

━━━━━━━━━━━━━━━━━━━━
_ do frame-roots [U32]
    - ir IRFunction

` For each row of a function, the frame or the local whose memory its value addresses, if any.
. roots [U32]
for id in 0 .. < ir.instructions.length
    . row = ir.instructions[id]
    . root = U32.max
    if row.op == .op-frame || row.op == .op-local-address
        root = id as U32
    else if row.op == .op-address
        . base = ir.operands[row.operands.start]
        if operand-kind(base) == .operand-value
            root = roots[operand-payload(base)]
    roots += root
= roots

━━━━━━━━━━━━━━━━━━━━
_ do reads-receiver Bool
    - ir IRFunction
    - span Span
    - made [Bool]
    - watched [U32]

for position in span.start .. < span.end
    . operand = ir.operands[position]
    . kind = operand-kind(operand)
    if kind == .operand-value && made[operand-payload(operand)]
        = true
    if kind == .operand-argument && watched.find(operand-payload(operand)) != null
        = true
= false

━━━━━━━━━━━━━━━━━━━━
_ do leads-to-read Bool
    - ir IRFunction
    - block IRBlockId
    - later [Bool]

` Whether a block jumps, branches or lands on a block from which the receiver is read.
. rows = ir.blocks[block].instructions
for id in rows.start .. < rows.end
    if ir.instructions[id].op == .op-phi
        continue
    . span = ir.instructions[id].operands
    for position in span.start .. < span.end
        . operand = ir.operands[position]
        if operand-kind(operand) == .operand-block && later[operand-payload(operand)]
            = true
= false

━━━━━━━━━━━━━━━━━━━━
_ writes-outside Bool
    - ir IRFunction
    - row IRInstruction
    - roots [U32]
    - made [Bool]
    - watched [U32]

` Whether a store, a copy or a fill writes memory other than the receiver, a frame, a local's
` memory or the function's result.
match kind
    |= .operand-value
        roots[payload] == U32.max && !made[payload]
    |= .operand-result
        false
    ??
        kind != .operand-argument || watched.find(payload) == null

.. target = ir.operands[row.operands.start]
.. kind = operand-kind(target)
.. payload = operand-payload(target)

━━━━━━━━━━━━━━━━━━━━
_ do call-judgment CallJudgment
    - ir IRFunction
    - tables ProgramTables
    - instances Instances
    - program Program
    - row IRInstruction
    - top Bool

` What a call may do to storage. TypeScript lets a call of a function of the runtime that
` allocates or polls run, and from the function judged itself the check for a terminating
` task. A call of any other function of the runtime, of C, of a value or of one of its own
` generated functions may move storage, and so may one of a function written with `do`, of a
` generator or of a closure. Any other function is judged by its own code.
. callee = operand-payload(ir.operands[row.operands.start])
. kind = (row.aux /and/ callee-kind-mask) as CalleeKind
if kind == .callee-runtime
    = CallJudgment(if is-steady(tables, callee) then .stable else .unstable)
if kind != .callee-function
    = CallJudgment(.unstable)
for dependency in 0 .. < ir.dependencies.length
    . listed = ir.dependencies[dependency]
    if listed.kind == .callee-function && tables.functions[listed.symbol].symbol == callee
        = function-judgment(tables, instances, program, listed.symbol, top)
= CallJudgment(.unsure)

━━━━━━━━━━━━━━━━━━━━
_ function-judgment CallJudgment
    - tables ProgramTables
    - instances Instances
    - program Program
    - callee FunctionId
    - top Bool

|? target.kind != .instance-body
    CallJudgment(.unstable)
|? !described
    CallJudgment(.unsure)
|? described.kind == .termination-panic-decl
    CallJudgment(if top then .stable else .unstable)
|? row.is-generator || described.is-imperative || is-closure-like(described.kind)
    CallJudgment(.unstable)
|? row.row-receiver != no-type
    CallJudgment(.unsure)
??
    CallJudgment(.unsure, callee)

.. target = tables.functions[callee]
.. row = instances.rows[target.instance]
.. described = describe(program, row.module, row.decl)

━━━━━━━━━━━━━━━━━━━━
_ do is-steady Bool
    - tables ProgramTables
    - symbol U32

` Whether a function of the runtime is one TypeScript lets run between two reads of a
` receiver: one that allocates, a safepoint, or the one that finds the running task.
for position in 0 .. < runtime-function-names.length
    if tables.runtime-symbols[position] == symbol
        . name = runtime-function-names[position]
        = allocates || name == "brixGCSafepoint" || name == "brixTaskSafepoint" || finds-task
            .. allocates = name.starts-with("brixAlloc") || name.starts-with("brixGCAlloc")
            .. finds-task = name == "brixGetActiveTaskHandle"
= false
