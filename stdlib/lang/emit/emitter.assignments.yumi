    refuse(.refused-conversion, id)
    = Typed(nothing, no-type)
.. index-differs = index-type != instances.argument-type(callee, 1)
. layout = layout-of(item-type, id)
. counted = layout-of(index-type, id)
. held = layout-of(pointer-type, id)
if !is-pointer(held) || !is-integer(counted) || layout == void-layout
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. step = integer(.machine-u64, tables.layouts.rows[layout].size)
. distance = arithmetic
    - id
    - .arithmetic-multiply
    - num-cast(id, index.operand, counted, u64-layout)
    - step
    - u64-layout
. moved = arithmetic
    - id
    - .arithmetic-add
    - num-cast(id, pointer.operand, held, u64-layout)
    - distance
    - u64-layout
. place = num-cast(id, moved, u64-layout, held)
if tables.layouts.is-struct(layout)
    copy
        - address(place, 0, layout, id)
        - item
        - layout
        - traced && tables.layouts.rows[layout].is-managed
        - id
else
    store(place, 0, item, traced && is-managed-pointer(layout), id)
= Typed(nothing, types.void-type)

────────────────────
_ do emit-array-store Assignment
    - site SyntaxId
    - callee InstanceId
    - object SyntaxId
    - index SyntaxId
    - rhs SyntaxId

. emitted = emit-expression(rhs)
. value = apart(emitted, rhs, !is-inert(object) || !is-inert(index))
. given = emitted.type
. receiver = convert(object, .reason-receiver, emit-expression(object))
. receiver-type = receiver.type
. key = convert(index, .reason-argument, emit-expression(index))
. key-type = key.type
. stored = convert(rhs, .reason-argument, Typed(value, given))
if receiver-type != instances.rows[callee].self-type || key-differs || value-differs
    refuse(.refused-conversion, site)
    = Assignment()
.. key-differs = key-type != instances.argument-type(callee, 0)
.. value-differs = stored.type != instances.argument-type(callee, 1)
. layout = layout-of(receiver-type, site)
. key-layout = layout-of(key-type, site)
. item-layout = layout-of(stored.type, site)
. data = part(receiver.operand, layout, 0, site)
. data-layout = layout-of(data.type, site)
. proven = facts.constant-of(unit.reading, site) != no-fact
. size = if proven then Typed(integer(.machine-u64, 0), types.size-type) else part(receiver.operand, layout, 1, site)
. size-layout = if proven then u64-layout else layout-of(size.type, site)
if !is-pointer(data-layout) || !is-integer(size-layout) || !is-integer(key-layout) || struct-item
    refuse(.refused-type, site)
    = Assignment()
.. struct-item = tables.layouts.is-struct(item-layout)
. wide = num-cast(site, key.operand, key-layout, u64-layout)
. stride = integer(.machine-u64, tables.layouts.rows[item-layout].size)
. assignment = Assignment(Typed(stored.operand, instances.argument-type(callee, 1)), Typed(value, given))
if proven
    . moved = moved-bytes
        - site
        - num-cast(site, data.operand, data-layout, pointer-layout)
        - arithmetic(site, .arithmetic-multiply, wide, stride, u64-layout)
    store(moved, 0, stored.operand, false, site)
    = assignment
. inside = ir.reserve-block()
. outside = ir.reserve-block()
. joined = ir.reserve-block()
branch
    - compare(site, .compare-less, wide, num-cast(site, size.operand, size-layout, u64-layout))
    - inside
    - outside
ir.start-block(inside)
store
    - moved-bytes
        - site
        - num-cast(site, data.operand, data-layout, pointer-layout)
        - arithmetic(site, .arithmetic-multiply, wide, stride, u64-layout)
    - 0
    - stored.operand
    - false
    - site
jump(joined)
ir.start-block(outside)
. mark = pending.length
pending += receiver.operand
pending += key.operand
pending += stored.operand
do call-method(callee, site, mark)
jump(joined)
ir.start-block(joined)
= assignment

────────────────────
_ do emit-index-store Assignment
    - site SyntaxId
    - fact CallFact
    - object SyntaxId
    - index SyntaxId
    - rhs SyntaxId

` An index assigned through the function that answers `[]=`, which stores the value: the
` function is called on the object with the key and the value. The value is evaluated
` first, then the object, then the key, as TypeScript does, and each takes the conversion
` recorded for it. The value of the assignment is what the function answers, or when it answers
` nothing, the value written, as given or as stored. Where the type pass planned the answer to be stored, it
` is stored where the object was read from, which then only names storage; an object that is
` itself an index has it stored through that index.
. callee = fact.callee
if callee == no-instance || fact.is-partial || !is-callable(callee)
    refuse(.refused-statement, site)
    = Assignment()
. owner = instances.rows[callee].self-type
. answers = instances.signatures[callee].returns
if !fills-in-order(fact, callee, 2) || names-slot(object, .slot-super)
    refuse(.refused-statement, site)
    = Assignment()
. stores-back = facts.plan-of(unit.reading, site) == .plan-store-answer
if owner == no-type || (is-numeric-type(owner) && !stores-back)
    refuse(.refused-statement, site)
    = Assignment()
if !stores-back && answers == owner && !tables.is-class(owner)
    refuse(.refused-statement, site)
    = Assignment()
do match? tree.nodes[object]
    | .node-index-expression(row)
        if !tables.is-class(owner)
            . outer = stored-through(object)
            if !stores-back || answers != owner || outer == no-fact || chained
                refuse(.refused-statement, site)
                = Assignment()
            .. chained = chains-at(object, row.is-optional)
            = emit-store-through(site, fact, facts.calls[outer], object, index, rhs)
if stores-back && (answers != owner || !is-place(object) || retyped)
    refuse(.refused-statement, site)
    = Assignment()
.. retyped = facts.node-type(unit.reading, object) != owner
. emitted = emit-expression(rhs)
. value = apart(emitted, rhs, !is-inert(object) || !is-inert(index))
. given = emitted.type
. pin-mark = pins.length
if stores-back
    pin-holder(object)
. receiver = convert(object, .reason-receiver, emit-expression(object))
. receiver-type = receiver.type
. key = receiver
. key-type = no-type
key = convert(index, .reason-argument, emit-expression(index))
key-type = key.type
. stored = convert(rhs, .reason-argument, Typed(value, given))
if receiver-type != owner
    refuse(.refused-conversion, object)
if key-type != instances.argument-type(callee, 0)
    refuse(.refused-conversion, index)
if stored.type != instances.argument-type(callee, 1)
    refuse(.refused-conversion, rhs)
. answer = stored
. replaced = call-at(site, .call-replaced)
if replaced != no-fact
    . read-mark = pending.length
    pending += receiver.operand
    pending += key.operand
    . old = call-method(facts.calls[replaced].callee, site, read-mark)
    . old-type = old.type
    if is-array-type(old-type)
        replace-storage(site, old.operand, old-type, value, given)
. mark = pending.length
pending += receiver.operand
pending += key.operand
pending += stored.operand
answer = call-method(callee, site, mark)
if stores-back
    store-place(object, answer.operand, owner, site)
unpin(pin-mark)
if answers != types.void-type
    . answered = Typed(answer.operand, answers)
    = Assignment(answered, answered)
= Assignment(Typed(stored.operand, instances.argument-type(callee, 1)), Typed(value, given))

────────────────────
_ do emit-index-update Assignment
    - site SyntaxId
    - op Operator
    - object SyntaxId
    - index SyntaxId
    - rhs SyntaxId

` An index given a value an assigning operator makes from the one it holds: the function that
` answers `[]` reads the item, the machine operation of numbers, or the function that answers
` the operator the assignment applies, makes the new value of it and the value written, and the
` function that answers `[]=` stores that, as the reference does.
` The reference evaluates the object and the key for the read and again for the store, so only
` an object that names storage has a shape here, read once, and only where `[]=` stores in
` place: on an object, or on a value it does not answer anew. A key that changes nothing is read
` once too; another is evaluated again for the store where it can be.
. read = call-at(site, .call-operator)
. store = next-operator(read)
. plan = facts.plan-of(unit.reading, site)
. combined = no-fact
if plan == .plan-call
    combined = store
    store = next-operator(combined)
. increment = increment-base(op)
. inert = is-inert(index)
if store == no-fact || !increment || increment == .concat-op || other-plan || unrepeatable
    refuse(.refused-statement, site)
    = Assignment()
.. other-plan = plan != .plan-builtin && plan != .plan-call
.. unrepeatable = !is-place(object) || (!inert && !is-repeatable(index))
. getter = facts.calls[read].callee
. setter = facts.calls[store].callee
if getter == no-instance || setter == no-instance || partial-call || uncallable
    refuse(.refused-statement, site)
    = Assignment()
.. partial-call = facts.calls[read].is-partial || facts.calls[store].is-partial
.. uncallable = !is-callable(getter) || !is-callable(setter)
. owner = instances.rows[setter].self-type
if owner == no-type || returns-owner || !getter-fills || !setter-fills
    refuse(.refused-statement, site)
    = Assignment()
.. returns-owner = !tables.is-class(owner) && instances.signatures[setter].returns == owner
.. getter-fills = fills-in-order(facts.calls[read], getter, 1)
.. setter-fills = fills-in-order(facts.calls[store], setter, 2)
. receiver = convert(object, .reason-receiver, emit-expression(object))
. receiver-type = receiver.type
. key = receiver
. key-type = no-type
key = convert(index, .reason-argument, emit-expression(index), 0, true)
key-type = key.type
if receiver-type != owner || instances.rows[getter].self-type != owner
    refuse(.refused-conversion, object)
    = Assignment()
if key-type != instances.argument-type(getter, 0) || key-type != instances.argument-type(setter, 0)
    refuse(.refused-conversion, index)
    = Assignment()
. read-mark = pending.length
pending += receiver.operand
pending += key.operand
. current = call-method(getter, site, read-mark)
. current-type = current.type
. value = current
if combined == no-fact
    value = combine-builtin(site, increment, site, current.operand, current-type, rhs, true)
else
    . given = emit-expression(rhs)
    . given-type = given.type
    value = call-operator(site, combined, site, current.operand, current-type, rhs, given.operand, given-type)
. computed = value
value = convert(site, .reason-assignment, value)
if value.type != instances.argument-type(setter, 1)
    refuse(.refused-conversion, site)
    = Assignment()
. assignment = Assignment(value, computed)
if !inert
    key = convert(index, .reason-argument, emit-expression(index), 0, true)
    if key.type != key-type
        refuse(.refused-conversion, index)
        = Assignment()
. mark = pending.length
pending += receiver.operand
pending += key.operand
pending += value.operand
call-method(setter, site, mark)
= assignment

────────────────────
_ do next-operator FactId
    - fact FactId

` The call of an operator recorded at a node after the one given, or none.
. next = if fact != no-fact then facts.calls[fact].next else no-fact
while next != no-fact && facts.calls[next].form != .call-operator
    next = facts.calls[next].next
= next

────────────────────
_ do emit-item-answer
    - site SyntaxId
    - object SyntaxId
    - index SyntaxId
    - rhs SyntaxId

` An assigning operator on an item that a function of its own name answers, where the item holds
` no struct or tuple: the item is read by the function that answers `[]`, the value is evaluated,
` and the function is called on the item with it, as the reference compiles it for an object.
` Nothing is stored.
. read = call-at(site, .call-operator)
. answer = next-operator(read)
if answer == no-fact
    refuse(.refused-statement, site)
    =
. item = emit-index-call(site, facts.calls[read], object, index)
. item-type = item.type
. given = emit-expression(rhs)
. given-type = given.type
call-operator(site, answer, site, item.operand, item-type, rhs, given.operand, given-type)

────────────────────
_ do is-repeatable Bool
    - id SyntaxId

` Whether an operand can be emitted again where the reference evaluates it again: a literal, a
` name, or a read, a call, a cast or an operation of such operands, none of which makes a function.
do match? tree.nodes[id]
    | .node-argument(named)
        = is-repeatable(named.expr)
    | .node-cast-expression(row)
        = is-repeatable(row.lhs)
    | .node-binary-expression(row)
        = is-repeatable(row.lhs) && is-repeatable(row.rhs)
    | .node-unary-expression(row)
        = is-repeatable(row.operand)
    | .node-get-expression(row)
        = row.object == 0 || is-repeatable(row.object)
    | .node-index-expression(row)
        = is-repeatable(row.object) && is-repeatable(row.index)
    | .node-call-expression(row)
        for argument in tree.children[row.args]
            if !is-repeatable(argument)
                = false
        = is-repeatable(row.callable)
    | .node-integer-syntax
        = true
    | .node-float-syntax
        = true
    | .node-string-syntax
        = true
    | .node-identifier
        = true
= false

────────────────────
_ do stored-through FactId
    - id SyntaxId

` The call recorded at an inner index of the function that stores what `[]=` answered for
` the item the index gave. No fact where the type pass recorded none.
. fact = facts.first-call(unit.reading, id)
while fact != no-fact
    if facts.calls[fact].form == .call-store-through
        = fact
    fact = facts.calls[fact].next
= no-fact

────────────────────
_ do emit-store-through Assignment
    - site SyntaxId
    - fact CallFact
    - outer CallFact
    - held SyntaxId
    - index SyntaxId
    - rhs SyntaxId

` An index of an index assigned, where the inner index gives a struct or a number and the
` type pass planned what `[]=` answers for it to be stored. In TypeScript's order:
` 1. The value is evaluated, and then the object the inner index reads from and its key,
`    once each. A struct among them is copied, since the calls that follow may change the
`    storage it was read from.
` 2. The item is read with the inner index's own function, or as TypeScript reads an item of
`    an array of numbers, where the type pass planned it so.
` 3. The key is evaluated, and `[]=` is called on the item.
` 4. What it answers is stored with the `[]=` of the object, under the same key.
` The value of the assignment is the value written. An object held by value whose `[]=`
` answers one of its own type would have that stored in turn, which has no shape yet.
. callee = fact.callee
. owner = instances.rows[callee].self-type
. reads = own-call(held)
. stores = outer.callee
. object = 0u32
. key-syntax = 0u32
do match? tree.nodes[held]
    | .node-index-expression(row)
        object = row.object
        key-syntax = row.index
if reads == no-fact || stores == no-instance || object == 0 || names-slot(object, .slot-super)
    refuse(.refused-statement, site)
    = Assignment()
. read = facts.calls[reads]
. reader = read.callee
if read.form != .call-operator || read.is-partial || outer.is-partial || reader == no-instance
    refuse(.refused-statement, site)
    = Assignment()
if tables.instance-functions[reader] == no-function || no-stores-function
    refuse(.refused-statement, site)
    = Assignment()
.. no-stores-function = tables.instance-functions[stores] == no-function
if !fills-in-order(read, reader, 1) || !fills-in-order(outer, stores, 2)
    refuse(.refused-statement, site)
    = Assignment()
. holder = instances.rows[stores].self-type
. keyed = instances.argument-type(reader, 0)
if instances.rows[reader].self-type != holder
    refuse(.refused-statement, site)
    = Assignment()
if instances.argument-type(stores, 0) != keyed || instances.argument-type(stores, 1) != owner
    refuse(.refused-statement, site)
    = Assignment()
if instances.signatures[stores].returns == holder && !tables.is-class(holder)
    refuse(.refused-statement, site)
    = Assignment()
. emitted = emit-expression(rhs)
. value = apart(emitted, rhs, true)
. given = emitted.type
. container = convert(object, .reason-receiver, emit-expression(object))
if container.type != holder
    refuse(.refused-conversion, object)
    = Assignment()
container = Typed(apart(container, object, true), container.type)
. key = convert(key-syntax, .reason-argument, emit-expression(key-syntax))
if key.type != keyed
    refuse(.refused-conversion, key-syntax)
    = Assignment()
key = Typed(apart(key, key-syntax, true), key.type)
. read-item = Typed(make-operand(.operand-void, 0), no-type)
if facts.plan-of(unit.reading, held) == .plan-array-item
    read-item = array-item(held, reader, container.operand, holder, key.operand, keyed)
else
    . mark = pending.length
    pending += container.operand
    pending += key.operand
    read-item = call-method(reader, held, mark)
. item = convert(held, .reason-receiver, read-item)
if item.type != owner
    refuse(.refused-conversion, held)
    = Assignment()
item = Typed(apart(item, held, !is-inert(index)), item.type)
. place = convert(index, .reason-argument, emit-expression(index))
. place-type = place.type
. stored = convert(rhs, .reason-argument, Typed(value, given))
if place-type != instances.argument-type(callee, 0)
    refuse(.refused-conversion, index)
    = Assignment()
if stored.type != instances.argument-type(callee, 1)
    refuse(.refused-conversion, rhs)
    = Assignment()
. store-mark = pending.length
pending += item.operand
pending += place.operand
pending += stored.operand
. answer = call-method(callee, site, store-mark)
if answer.type != owner
    refuse(.refused-conversion, site)
    = Assignment()
. back-mark = pending.length
pending += container.operand
pending += key.operand
pending += answer.operand
call-method(stores, held, back-mark)
= Assignment(Typed(stored.operand, instances.argument-type(callee, 1)), Typed(value, given))

────────────────────
+ do store-place
    - place SyntaxId
    - value Operand
    - type TypeId
    - site SyntaxId

` Stores a value in the storage an expression names, which holds the value's type: a local,
` an argument that is a struct, a local or an argument nested functions capture, in the
` environment that holds it, a global, a field or a property of the receiver named alone, or a
` stored field or property of what such an expression names. The object of a property is the
` one kept when the place was read, where one was kept.
. layout = layout-of(type, site)
do match? tree.nodes[place]
    | .node-identifier(row)
        if is-own-field(place)
            . owner = unit.owner-type
            . found = property-of(owner, row.name)
            if !found || reads-getter(place)
                refuse(.refused-statement, site)
                =
            store-held(unit.self, 0, owner, found, value, type, site)
            =
        . kept = assigned-global(place, site)
        if kept != no-storage
            . global = tables.storage[kept]
            if global.type != type || tables.global-kind(global.module, global.decl) == .global-lazy
                refuse(.refused-statement, site)
                =
            store-global(global, value, site)
            =
        . slot = local-slot(place, site, true)
        if is-captured(slot)
            if bindings.slots[slot].kind == .slot-lazy
                refuse(.refused-statement, site)
                =
            keep-captured(slot, value, type, site)
            =
        . offset = slot-offset(slot, site)
        if facts.slot-type(unit.instance, offset) != type
            refuse(.refused-statement, site)
            =
        if unit.cells[offset] != no-local
            store-local(unit.cells[offset], value, site)
            =
        . memory = argument-memory(slot, type, site)
        copy(memory, value, layout, false, site)
        =
    | .node-get-expression(row)
        . owner = facts.node-type(unit.reading, row.object)
        . known = owner != no-type && owner != invalid-type
        . found = property-of(owner, row.name) if known
        if !found || reads-getter(place)
            refuse(.refused-statement, site)
            =
        . base = emit-expression(row.object)
        store-held(base.operand, row.object, owner, found, value, type, site)
        =
refuse(.refused-statement, site)

────────────────────
+ do restore-stacks
    - callee InstanceId
    - saved [LocalId]
    - site SyntaxId

` After such a call each slot set before it is put back as it was.
if saved.length == 0
    =
. rows = tables.stack-needs(callee)
for index in 0 .. < saved.length
    if saved[index] != no-local
        . kept = tables.storage[rows[index]]
        copy
            - stack-slot(kept, site)
            - load-local(saved[index], site)
            - kept.layout
            - tables.layouts.rows[kept.layout].is-managed
            - site

────────────────────
_ do put-lent
    - target Operand
    - field LayoutField
    - value Operand
    - syntax SyntaxId

` Stores a value at a field of a struct that lies in storage, which may be an object: a managed
` pointer written goes through the write barrier.
if tables.layouts.is-struct(field.layout)
    store-struct(target, field, value, syntax)
else if field.layout != void-layout
    store(target, field.offset, value, is-managed-pointer(field.layout), syntax)
