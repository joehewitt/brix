. place = filling.start + position
. property = types.properties[place]
. pair = tables.layouts.field
    - tables.layouts.objects[filling.type]
    - object-header-fields + property.slot
if !tables.layouts.is-struct(pair.layout)
    refuse(.refused-function, syntax)
    =
. held = tables.layouts.field(pair.layout, 0)
. slot = LayoutField(pair.offset + held.offset, held.layout)
store-default(unit.self, slot, property, place, filling.type, syntax)
store
    - unit.self
    - pair.offset + tables.layouts.field(pair.layout, 1).offset
    - integer(.machine-u8, 1)
    - false
    - syntax
filling.filled[position] = 2

