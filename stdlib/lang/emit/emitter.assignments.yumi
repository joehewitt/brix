_ do store-fill
    - object Operand
    - field LayoutField
    - property TypeProperty
    - place U32
    - owner TypeId
    - fact FillFact
    - syntax SyntaxId

` Stores the argument a constructor fills a property from. An optional argument fills it only
` when it has a value; when it has none the property gets its default. An optional held as a
` pointer has a value where the pointer points at something. A lazy local of the
` property's name fills it with its value, read as any read made while the properties are
` given their values.
. binding = instances.rows[unit.instance].binding
if binding == no-binding || !is-own-slot(fact.slot)
    refuse(.refused-function, syntax)
    =
if bindings.slots[fact.slot].kind == .slot-lazy
    . held = facts.slot-type(unit.instance, slot-offset(fact.slot, syntax))
    . value = read-lazy-local(fact.slot, syntax, held)
    if field.layout != void-layout
        store-converted(object, field, property, fact.site, Typed(value.operand, held), syntax)
    =
if bindings.slots[fact.slot].kind != .slot-argument
    refuse(.refused-function, syntax)
    =
. position = argument-position(fact.slot)
. given = instances.argument-type(unit.instance, position)
. argument = make-operand(.operand-argument, if unit.takes-self then position + 1 else position)
if !types.is-optional(given)
