. made = emit-expression(rhs)
. value = apart(made, rhs, !is-inert(object))
. given = made.type
. held = emit-whole(object)
. layout = layout-of(held.type, id)
if !tables.layouts.is-union(layout) || tables.layouts.rows[layout].cases.count != count-answered
