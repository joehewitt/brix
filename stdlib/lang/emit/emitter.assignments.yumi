_ do store-lazy-fill
    - property TypeProperty
    - fact FillFact
    - syntax SyntaxId

` Stores the argument a constructor fills a lazy property from, and marks the property as
` having its value. An optional argument, which may leave the property to be evaluated, has
` no shape here. A lazy local of the property's name fills it with its value, evaluated
` here, as it fills a property that is not lazy.
. binding = instances.rows[unit.instance].binding
. kind = if binding == no-binding || !is-own-slot(fact.slot) then SlotKind.slot-local else slot-kind
    .. slot-kind = bindings.slots[fact.slot].kind
. pair = tables.layouts.field
    - tables.layouts.objects[filling.type]
    - object-header-fields + property.slot
if (kind != .slot-argument && kind != .slot-lazy) || !tables.layouts.is-struct(pair.layout)
    refuse(.refused-function, syntax)
    =
. inner = tables.layouts.field(pair.layout, 0)
. field = LayoutField(pair.offset + inner.offset, inner.layout)
. argument = Typed(make-operand(.operand-void, 0), no-type)
if kind == .slot-lazy
    . held = facts.slot-type(unit.instance, slot-offset(fact.slot, syntax))
    argument = Typed(read-lazy-local(fact.slot, syntax, held).operand, held)
else
    . position = argument-position(fact.slot)
    argument = Typed(make-operand(.operand-argument, if unit.takes-self then position + 1 else position), instances.argument-type(unit.instance, position))
