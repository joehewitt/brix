. item-type = tables.layouts.pointee-type(place.type)
. converted = convert(site, .reason-assignment, given)
. value = converted.operand
if converted.type != item-type
    refuse(.refused-conversion, id)
    = Assignment()
. layout = layout-of(item-type, id)
. assignment = Assignment(converted, given)
