if tables.layouts.is-struct(field.layout)
    value = null-value(property.type, field.layout, syntax).operand
if tables.layouts.is-struct(field.layout)
    store-struct(unit.self, field, value, syntax)
else if field.layout != void-layout
    store(unit.self, field.offset, value, is-managed-pointer(field.layout), syntax)

────────────────────
_ do store-given
    - field LayoutField
    - property TypeProperty
    - argument U32
    - syntax SyntaxId

` Stores the value a markup element gives a constructor for a property, which arrives as an
` argument of the property's type: a managed pointer through the write barrier, and a
` struct by a copy.
if instances.argument-type(unit.instance, argument) != property.type
    refuse(.refused-conversion, syntax)
    =
. value = make-operand(.operand-argument, if unit.takes-self then argument + 1 else argument)
if tables.layouts.is-struct(field.layout)
    store-struct(unit.self, field, value, syntax)
else if field.layout != void-layout
    store(unit.self, field.offset, value, is-managed-pointer(field.layout), syntax)

