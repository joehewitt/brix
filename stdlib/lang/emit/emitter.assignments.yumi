━━━━━━━━━━━━━━━━━━━━
_ Assignments is facet of FunctionEmitter
    sees Calls
    sees Lazies
    sees LiveActions
    sees Loops
    sees MatchArms
    sees Styles
    sees Tables
    sees Tasks

────────────────────
_ do clear-fills

` Gives each lazy local of a constructor the flag that says whether it has been evaluated
` for the properties' first values, cleared here before the first of them.
for offset in 0 .. < unit.slot-count
    if bindings.slots[unit.slot-start + offset].kind != .slot-lazy
        continue
    . flag = ir.add-local(u8-layout)
    unit.fill-flags[offset] = flag
    store-local(flag, integer(.machine-u8, 0), 0)

────────────────────
_ do clear-checks

` Gives each property of the object being made that a value may first read on some of its paths
` alone the flag that says whether it has its first value, cleared here before the first of
` them, as the reference keeps one where such a read gives the property its value: so may a
` value given on some paths alone, which a flagged property's is. Where a read or its own turn
` finds the flag clear, the property is given its value (`check-property`). One whose value runs
` in a live action of its own has the trackers of the action made here, as the reference makes
` them, for whichever path gives it its value.
filling = filling.checks = storage.allocate'U32(filling.count + 1)
filling = filling.trackers = storage.allocate'U32(filling.count + 1)
for position in 0 .. < filling.count
    filling.checks[position] = no-local
    filling.trackers[position] = no-local
. changed = true
while changed
    changed = false
    for position in 0 .. < filling.count
        . unit-id = tables.value-unit(filling.start + position)
        if unit-id == no-instance
            continue
        . read = tables.first-read(unit-id)
        while read != no-fact
            . found = property-read(filling.type, read)
            . unsure = unsure-read || filling.checks[position] != no-local
                .. unsure-read = instances.rows[unit-id].branches && !facts.value-reads[read].surely
            if found && unsure
                . held = (found as U32) - filling.start
                if held < filling.count && filling.checks[held] == no-local
                    . flag = ir.add-local(u8-layout)
                    filling.checks[held] = flag
                    store-local(flag, integer(.machine-u8, 0), 0)
                    changed = true
            read = tables.next-read(read)
for position in 0 .. < filling.count
    . unit-id = tables.value-unit(filling.start + position)
    if filling.checks[position] != no-local && unit-id != no-instance && instances.rows[unit-id].is-live
        filling.trackers[position] = open-trackers(0)

────────────────────
+ do store-named
    - id SyntaxId
    - place U32
    - value Typed

` Stores what the name of a markup element holds in the property of that name of the
` object the function runs on, converted as the type pass recorded at the element for a
` value the property is given.
. stored = convert(id, .reason-declaration, value)
if !unit.has-self
    refuse(.refused-statement, id)
    =
store-argument(unit.self, unit.owner-type, place, stored.operand, stored.type, id)

────────────────────
+ do store-argument
    - object Operand
    - type TypeId
    - place U32
    - value Operand
    - given TypeId
    - site SyntaxId

` Stores an argument of a markup element in the property of its parameter's name, as an
` assignment to the property stores a value of the property's type: a lazy property is
` marked as having its value.
. property = types.properties[place]
. held = if tables.is-class(type) then tables.layouts.objects[type] else no-layout
. is-lazy = property.storage-kind == .storage-lazy
if held == no-layout || unstored || given != property.type
    refuse(.refused-statement, site)
    =
.. unstored = property.storage-kind != .storage-eager && !is-lazy
. field = tables.layouts.field(held, object-header-fields + property.slot)
. flag-offset U32 = U32.max
if is-lazy
    if !tables.layouts.is-struct(field.layout)
        refuse(.refused-statement, site)
        =
    . pair = field
    . inner = tables.layouts.field(pair.layout, 0)
    flag-offset = pair.offset + tables.layouts.field(pair.layout, 1).offset
    field = LayoutField(pair.offset + inner.offset, inner.layout)
put-property(object, field, property, value, site, flag-offset, false, memo-flag-of(type, property))

────────────────────
+ do store-part
    - id SyntaxId
    - name SyntaxId
    - slot SlotId
    - offset U32
    - part Operand
    - held TypeId
    - kept LayoutId
    - declares Bool

` Stores a part of a value taken apart in the local a name gives it: in the environment that
` holds the local, or in its cell, which a declaration gives it unless it is a lazy one that
` keeps the cell it was first given.
if kept == void-layout
    =
if is-captured(slot)
    if bindings.slots[slot].kind == .slot-lazy
        refuse(.refused-statement, name)
        =
    keep-captured(slot, part, held, id)
    =
if declares && (unit.cells[offset] == no-local || bindings.slots[slot].kind != .slot-lazy)
    . taken = (bindings.slots[slot].flags /and/ SlotFlag.slot-address-taken) != 0
    unit.cells[offset] = ir.add-local(kept, taken)
if unit.cells[offset] == no-local
    refuse(.refused-statement, name)
    =
store-local(unit.cells[offset], part, id)

────────────────────
+ do store-part-global
    - name SyntaxId
    - kept U32
    - part Operand
    - type TypeId

` Stores a part of a value taken apart in the global a name gives it, where the global has the
` part's type, as an assignment of the global does.
. global = tables.storage[kept]
if type != global.type
    refuse(.refused-conversion, name)
    =
store-global(global, part, name)
if tables.global-kind(global.module, global.decl) == .global-lazy
    store-release(make-operand(.operand-symbol, global.state), 0, integer(.machine-u8, 1), name)

────────────────────
_ do assigned-lazy SlotId
    - name SyntaxId

` The slot of a lazy local a name is assigned through, when a flag of this function says
` whether the local has its value.
. binding = instances.rows[unit.reading].binding
if binding == no-binding || unit.reading != unit.instance
    = no-slot
do match? tree.nodes[name]
    | .node-identifier
        . resolution = bindings.resolution-of(binding, name)
        if resolution.kind != .resolve-slot || !is-own-slot(resolution.slot)
            = no-slot
        if bindings.slots[resolution.slot].kind != .slot-lazy
            = no-slot
        if unit.lazy-flags[resolution.slot - unit.slot-start] != no-local
            = resolution.slot
= no-slot

────────────────────
+ do emit-assign Assignment ?! Refused
    - id SyntaxId
    - op Operator
    - lhs SyntaxId
    - rhs SyntaxId

` Stores a value in a local or a global: the one written, or for an assigning operator what its
` operator gives for the place and the value, in the way the type pass planned it. The value takes
` the conversion recorded for the store, and the store answers it with the value given
` (`Assignment`). A lazy global assigned is marked as having its value, which is then never
` evaluated. An assigning operator that a function of its own name answers stores nothing, unless
` the type pass planned its answer to be stored. A field is assigned in its own way, and so are the
` locals a tuple is taken apart into, the flag of a domain of styles, and a name of an object that
` declares a style for it. A local of no size, as a `Void` is, keeps nothing: its value is evaluated
` and goes nowhere. An array stored over an array where the value or the place is a link of an
` optional chain has no shape here: the runtime is told of no replaced storage there. A store to a
` local some read tracks runs the actions that read it where its bits change, as `watches` says,
` those of a struct against a copy taken before the store: a lazy one only where it had its value,
` since no action can read it before.
. chains = (is-chained(rhs) && !is-pinned(rhs)) || (is-link(lhs) && !is-pinned(receiver-of(lhs)))
if chains && facts.is-replacing(unit.reading, id)
    refuse(.refused-statement, id)
    = Assignment()
if is-chained(rhs) && !is-pinned(rhs)
    emit-withheld(id, op, lhs, rhs, false)
    = Assignment()
if is-link(lhs) && !is-pinned(receiver-of(lhs))
    emit-chained-assign(id, op, lhs, rhs)
    = Assignment()
. answered = op != .eq-op && assigning-call(lhs) != no-fact
. plan = facts.plan-of(unit.reading, id)
if answered && plan != .plan-store-answer
    emit-assigning-call(id, assigning-call(lhs), lhs, rhs)
    = Assignment()
do match? tree.nodes[lhs]
    | .node-style-read-expression(row)
        emit-style-write(id, row.object, rhs)
        = Assignment()
    | .node-get-expression(row)
        . styled = facts.style-write-of(unit.reading, id)
        if styled
            emit-style-assign(id, row.object, rhs, styled)
            = Assignment()
        if facts.plan-of(unit.reading, lhs) == .plan-view
            = emit-view-field-assign(id, op, lhs, row.object, rhs)
        if facts.plan-of(unit.reading, lhs) == .plan-table
            = emit-table-field-assign(id, op, lhs, row.object, rhs)
        = emit-field-assign(id, op, lhs, row.object, rhs)
    | .node-index-expression(row)
        if facts.plan-of(unit.reading, lhs) == .plan-view
            = emit-view-index-assign(id, op, lhs, row.object, row.index, rhs)
        if facts.plan-of(unit.reading, lhs) == .plan-table
            if op != .eq-op
                refuse(.refused-statement, id)
                = Assignment()
            if table-op(lhs) == TableOp.table-item-store
                emit-table-item-store(lhs, row.object, row.index, rhs)
                = Assignment()
            if table-op(lhs) == TableOp.table-range-store
                emit-table-range-store(lhs, row.object, row.index, rhs)
                = Assignment()
            emit-table-store(lhs, row.object, row.index, rhs)
            = Assignment()
        if facts.plan-of(unit.reading, lhs) == .plan-item
            = emit-item-assign(id, op, lhs, row.object, row.index, rhs)
        . stores = own-call(lhs)
        if op == .eq-op && stores != no-fact && facts.plan-of(unit.reading, lhs) == .plan-array-item
            = emit-array-store(lhs, facts.calls[stores].callee, row.object, row.index, rhs)
        if op == .eq-op && stores != no-fact && facts.calls[stores].form != .call-setter
            = emit-index-store(lhs, facts.calls[stores], row.object, row.index, rhs)
        . reached = !chains-at(lhs, row.is-optional) || is-pinned(row.object)
        if op != .eq-op && reached && facts.plan-of(unit.reading, lhs) == .plan-answer-item
            emit-item-answer(lhs, row.object, row.index, rhs)
            = Assignment()
        if op != .eq-op && reached && call-at(lhs, .call-operator) != no-fact
            = emit-index-update(lhs, op, row.object, row.index, rhs)
        = emit-field-assign(id, op, lhs, row.object, rhs)
    | .node-tuple-syntax(row)
        if op == .eq-op
            emit-destructure(id, row.items, rhs, false)
            = Assignment()
    | .node-identifier
        . styled = facts.style-write-of(unit.reading, id)
        if styled
            emit-style-assign(id, 0, rhs, styled)
            = Assignment()
        if is-own-field(lhs) || is-case-member(lhs)
            = emit-field-assign(id, op, lhs, 0, rhs)
        . setter = own-call(lhs)
        if setter != no-fact && facts.calls[setter].form == .call-setter && op == .eq-op
            emit-module-setter(lhs, rhs, facts.calls[setter])
            = Assignment()
        if op != .eq-op && call-at(lhs, .call-store-setter) != no-fact
            = emit-setter-update(id, op, lhs, 0, rhs, false)
. kept = assigned-global(lhs, id)
. local = no-local
. target = no-type
. memory = make-operand(.operand-void, 0)
. shared = no-slot
. written = no-local
. watched = no-slot
if kept == no-storage
    . slot = assigned-lazy(lhs)
    if slot == no-slot
        slot = local-slot(lhs, id, true, false, true)
    . offset = slot-offset(slot, id)
    if watches(slot, id)
        watched = slot
    if is-captured(slot)
        shared = slot
        target = find-captured(slot, id).type
    else
        target = facts.slot-type(unit.instance, offset)
        if unit.lazy-flags[offset] != no-local
            written = unit.lazy-flags[offset]
            if unit.cells[offset] == no-local && target != no-type && target != invalid-type
                . taken = (bindings.slots[slot].flags /and/ SlotFlag.slot-address-taken) != 0
                unit.cells[offset] = ir.add-local(layout-of(target, id), taken)
        local = unit.cells[offset]
        if local == no-local && layout-of(target, id) != void-layout
            memory = argument-memory(slot, target, id)
else
    target = tables.storage[kept].type
. given = Typed(make-operand(.operand-void, 0), no-type)
. base = increment-base(op)
if op == .eq-op
    given = emit-expression(rhs)
else if answered
    given = emit-assigning-call(id, assigning-call(lhs), lhs, rhs)
else if base && base == .concat-op
    given = emit-concat(id, lhs, rhs, false)
else if base && plan == .plan-builtin
    given = emit-builtin(id, base, lhs, rhs, true)
else if base && plan == .plan-call
    given = emit-operator-call(id, lhs, rhs, .plan-call, true)
else
    refuse(.refused-statement, id)
. converted = convert(id, .reason-assignment, given)
. value = converted.operand
if converted.type != target
    refuse(.refused-conversion, id)
    = Assignment()
. assignment = Assignment(converted, given)
if facts.is-replacing(unit.reading, id)
    . old = memory
    if shared != no-slot
        old = read-captured(shared, id, target).operand
    else if kept != no-storage
        old = load-global(tables.storage[kept], id).operand
    else if local != no-local
        old = load-local(local, id)
    replace-storage(id, old, target, given.operand, given.type)
. prior = make-operand(.operand-void, 0)
. armed = make-operand(.operand-void, 0)
if watched != no-slot
    if local == no-local && shared == no-slot
        refuse(.refused-statement, id)
        = Assignment()
    prior = if shared != no-slot then read-captured(shared, id, target).operand else load-local(local, id)
    . held = layout-of(target, id)
    if tables.layouts.is-struct(held)
        . saved = frame(held)
        copy(saved, prior, held, false, id)
        prior = saved
    if written != no-local
        armed = load-local(written, id)
if shared != no-slot
    if fills-share() && !filling.storing && bindings.slots[shared].kind == .slot-lazy
        refuse(.refused-statement, id)
        = Assignment()
    keep-captured(shared, value, target, id)
    if bindings.slots[shared].kind == .slot-lazy && !task-holds(shared)
        settle-shared(shared, id)
    if watched != no-slot
        dispatch-local(watched, prior, read-captured(shared, id, target).operand, target, id)
    = assignment
if kept == no-storage && local == no-local
    if layout-of(target, id) != void-layout
        copy(memory, value, layout-of(target, id), false, id)
    = assignment
if kept == no-storage
    store-local(local, value, id)
    if written != no-local
        store-local(written, integer(.machine-u8, 1), id)
    if watched != no-slot
        dispatch-local(watched, prior, load-local(local, id), target, id, armed)
    = assignment
. global = tables.storage[kept]
store-global(global, value, id)
if tables.global-kind(global.module, global.decl) == .global-lazy
    store-release(make-operand(.operand-symbol, global.state), 0, integer(.machine-u8, 1), id)
= assignment

────────────────────
+ do assigned-global U32
    - lhs SyntaxId
    - id SyntaxId

` The storage of the global an assignment names, or none when it names something else. A
` global with no storage has no shape here.
. binding = instances.rows[unit.reading].binding
if binding == no-binding
    = no-storage
do match? tree.nodes[lhs]
    | .node-identifier
        . resolution = bindings.resolution-of(binding, lhs)
        if resolution.kind == .resolve-global
            . row = tables.storage-of(resolution.module, resolution.decl)
            if row == no-storage
                refuse(.refused-statement, id)
            = row
= no-storage

────────────────────
_ do assigning-call FactId
    - lhs SyntaxId

` The call of an assigning operator that a function of its own name answers, which the type
` pass records as an operator's call at the place assigned. No fact when the operator is not
` such a one.
do match? tree.nodes[lhs]
    | .node-index-expression
        = no-fact
. fact = own-call(lhs)
if fact == no-fact || facts.calls[fact].form != .call-operator
    = no-fact
= fact

────────────────────
_ do emit-assigning-call Typed
    - id SyntaxId
    - fact FactId
    - lhs SyntaxId
    - rhs SyntaxId

` An assigning operator that a function of its own name answers: the function is called on
` what the place holds with the value. A struct or a tuple is given as the place itself, so the
` function reads what the place holds when it is called, after the value is evaluated; a
` number or an object is read before. Nothing is stored here: where the type pass planned the
` answer to be stored, the assignment that called for it stores it.
. nothing = make-operand(.operand-void, 0)
. left = emit-expression(lhs)
. left-type = left.type
. right = emit-expression(rhs)
. right-type = right.type
= call-operator(id, fact, lhs, left.operand, left-type, rhs, right.operand, right-type)

────────────────────
_ do emit-field-assign Assignment
    - id SyntaxId
    - op Operator
    - lhs SyntaxId
    - object SyntaxId
    - rhs SyntaxId

` An assignment to a field. A struct's field is stored in place: at its address inside the
` local, or inside the field, that holds the struct, or inside the receiver when no object is
` written. A tuple's field is stored only by its own constructor, which is making it: any
` other assignment gives a new tuple, which a statement drops. A property of an object is
` assigned in its own way. A store into a struct that an object holds has no shape yet when
` it writes a managed pointer. The value is evaluated before the object, as TypeScript does. An assigning operator whose answer
` the type pass planned to be stored stores it as any value, and has no shape in a tuple's
` field. A value named alone that a getter answers has no shape here unless it is an object. A
` struct that lies in storage, as `places-item` finds it, is stored where it lies, a managed
` pointer through the write barrier, as TypeScript stores once it has inlined what reads it;
` any other struct an index answered by a function gave has no shape here, since TypeScript
` stores into a copy of it. A field of the case of a row a name stands for is written in its
` cell, and so is one named alone in a member that runs on the case.
. cursor = if object != 0 then case-cursor-of(object) else this-cursor
if cursor != U32.max
    . named = member-name(lhs)
    . field = case-field(cursor, named) if named
    if !field
        refuse(.refused-statement, id)
        = Assignment()
    = emit-case-field-assign(id, op, lhs, cursor, field, rhs)
if object != 0 && is-getter-name(object) && !tables.is-class(held-type(object))
    refuse(.refused-statement, id)
    = Assignment()
if facts.plan-of(unit.reading, lhs) == .plan-forward
    emit-forward-set(id, op, lhs, object, rhs)
    = Assignment()
if op != .eq-op && call-at(lhs, .call-store-setter) != no-fact
    = emit-setter-update(id, op, lhs, object, rhs, true)
. owner = if object == 0 then unit.owner-type else held-type(object)
if owner != no-type && owner != invalid-type && tables.is-class(owner)
    = emit-property-assign(id, op, lhs, object, rhs, owner)
. setter = own-call(lhs)
if setter != no-fact && facts.calls[setter].form == .call-setter && op == .eq-op
    emit-setter(lhs, object, rhs, facts.calls[setter])
    = Assignment()
if owner == no-type || owner == invalid-type || !is-stored(owner, object)
    if facts.plan-of(unit.reading, id) == .plan-store-answer
        refuse(.refused-statement, id)
        = Assignment()
    emit-update(id, op, lhs, rhs)
    = Assignment()
. placed = object != 0 && places-item(object)
if object != 0 && !placed && through-answer(object)
    refuse(.refused-statement, id)
    = Assignment()
. layout = layout-of(owner, id)
. position = field-position(lhs, owner)
if !tables.layouts.is-struct(layout) || position >= tables.layouts.rows[layout].fields.count
    refuse(.refused-statement, id)
    = Assignment()
if managed-field && !is-framed(object) && !placed
    refuse(.refused-statement, id)
    = Assignment()
.. managed-field = tables.layouts.rows[tables.layouts.field(layout, position).layout].is-managed
. given = Typed(make-operand(.operand-void, 0), no-type)
. increment = increment-base(op)
. site = id
do match? tree.nodes[lhs]
    | .node-index-expression
        site = lhs
. stores-answer = facts.plan-of(unit.reading, site) == .plan-store-answer
if op == .eq-op
    . made = emit-expression(rhs)
    given = Typed(apart(made, rhs, object != 0 && !is-inert(object)), made.type)
else if stores-answer && assigning-call(lhs) != no-fact && (object == 0 || is-place(object))
    given = emit-assigning-call(site, assigning-call(lhs), lhs, rhs)
else if increment && builtin-plan && (object == 0 || is-place(object) || placed)
    given = emit-builtin(site, increment, lhs, rhs, true)
else
    refuse(.refused-statement, id)
.. builtin-plan = facts.plan-of(unit.reading, site) == .plan-builtin
. converted = convert(site, .reason-assignment, given)
. value = converted.operand
if converted.type != field-type(owner, position)
    refuse(.refused-conversion, id)
    = Assignment()
. assignment = Assignment(converted, given)
. base = if object == 0 then unit.self else if placed then place-of(object).operand else emit-expression(object).operand
if facts.is-replacing(unit.reading, id)
    replace-storage
        - id
        - take(base, tables.layouts.field(layout, position), id)
        - field-type(owner, position)
        - given.operand
        - given.type
if placed
    put-lent(base, tables.layouts.field(layout, position), value, id)
else
    put(base, tables.layouts.field(layout, position), value, id)
= assignment

────────────────────
_ do is-getter-name Bool
    - id SyntaxId

` Whether an expression is a name alone that a getter answers.
do match? tree.nodes[id]
    | .node-identifier
        = reads-getter(id)
= false

────────────────────
_ do emit-property-assign Assignment
    - id SyntaxId
    - op Operator
    - lhs SyntaxId
    - object SyntaxId
    - rhs SyntaxId
    - owner TypeId
    - received Bool = false

` An assignment to a property of an object: of the value written before the property's
` name, or of the receiver when none is, or where the name alone is `received`, of the markup
` element `received-object` finds. A setter is called with the value. A stored
` property is stored at its place in the object: a managed pointer through the write
` barrier, and a struct by a copy. A lazy property is stored the same way and marked as
` having its value, which is then never evaluated. The value is evaluated before the object,
` as TypeScript does. An assigning operator reads the property first and then stores it, so
` its object is read twice. A tracked property runs the actions that read it where the store changed it.
. name = member-name(lhs)
. setter = own-call(lhs)
if setter != no-fact && facts.calls[setter].form == .call-setter && op == .eq-op
    emit-setter(lhs, object, rhs, facts.calls[setter])
    = Assignment()
. found = property-of(owner, name) if name
. held = tables.layouts.objects[owner]
if !found || held == no-layout
    refuse(.refused-statement, id)
    = Assignment()
. property = types.properties[found]
. is-lazy = property.storage-kind == .storage-lazy
if property.storage-kind != .storage-eager && !is-lazy
    refuse(.refused-statement, id)
    = Assignment()
. field = tables.layouts.field(held, object-header-fields + property.slot)
. flag-offset U32
if is-lazy
    if !tables.layouts.is-struct(field.layout)
        refuse(.refused-statement, id)
        = Assignment()
    . pair = field
    . inner = tables.layouts.field(pair.layout, 0)
    flag-offset = pair.offset + tables.layouts.field(pair.layout, 1).offset
    field = LayoutField(pair.offset + inner.offset, inner.layout)
if op == .eq-op && object == 0 && !received && !is-lazy
    . updated = emit-own-update(id, lhs, rhs, owner, property, field)
    if updated
        = updated
. given = Typed(make-operand(.operand-void, 0), no-type)
. increment = increment-base(op)
. plan = facts.plan-of(unit.reading, id)
if op == .eq-op
    . made = emit-expression(rhs)
    given = Typed(apart(made, rhs, object != 0 && !is-inert(object)), made.type)
else if plan == .plan-store-answer
    given = emit-assigning-call(id, assigning-call(lhs), lhs, rhs)
else if increment
    if increment == .concat-op
        given = emit-concat(id, lhs, rhs, false)
    else if plan == .plan-builtin
        given = emit-builtin(id, increment, lhs, rhs, true)
    else if plan == .plan-call
        given = emit-operator-call(id, lhs, rhs, .plan-call, true)
    else
        refuse(.refused-statement, id)
else
    refuse(.refused-statement, id)
. converted = convert(id, .reason-assignment, given)
. value = converted.operand
if converted.type != property.type
    refuse(.refused-conversion, id)
    = Assignment()
. assignment = Assignment(converted, given)
. base = if received then received-object(lhs, name!).operand else if object == 0 then unit.self else emit-expression(object).operand
if facts.is-replacing(unit.reading, id)
    if is-lazy
        refuse(.refused-statement, id)
        = Assignment()
    replace-storage(id, take(base, field, id), property.type, given.operand, given.type)
put-property
    - base
    - field
    - property
    - value
    - id
    - if is-lazy then flag-offset else U32.max
    - false
    - memo-flag-of(owner, property)
= assignment

────────────────────
_ do emit-own-update Assignment?
    - id SyntaxId
    - lhs SyntaxId
    - rhs SyntaxId
    - owner TypeId
    - property TypeProperty
    - field LayoutField

` An assignment to a field of the receiver that holds a tuple, of that tuple with one of its
` own fields assigned, as `frame = frame.depth = 2` is: the one field is stored where it lies
` inside the receiver, since the tuple stored would differ from the old one only there. The
` assignment gives the tuple as it then lies. Nothing is emitted where the assignment is other
` than that, or where the field stores more than its bits: one some read tracks, a memo, or
` storage the assignment replaces.
. named = member-name(lhs)
if !named || !tables.layouts.is-struct(field.layout) || tracks(property)
    = null
if memo-flag-of(owner, property) != U32.max || facts.is-replacing(unit.reading, id)
    = null
if facts.is-replacing(unit.reading, rhs) || tables.live-statement-of(unit.reading, rhs)
    = null
if facts.node-type(unit.reading, rhs) != property.type
    = null
. target SyntaxId = 0
. value SyntaxId = 0
do match? tree.nodes[rhs]
    | .node-assign(row)
        if row.op == .eq-op && !is-chained(row.rhs)
            target = row.lhs
            value = row.rhs
=? null if target == 0
. object SyntaxId = 0
. member Atom? = null
do match? tree.nodes[target]
    | .node-get-expression(row)
        if !row.is-optional
            object = row.object
            member = row.name
=? null if object == 0 || !member
. same = false
do match? tree.nodes[object]
    | .node-identifier(row)
        same = row.name == named && is-own-field(object)
. plan = facts.plan-of(unit.reading, rhs)
if !same || plan == .plan-extend || plan == .plan-truncate || stores-place(target)
    = null
. found = property-of(property.type, member)
if !found || types.properties[found].storage-kind != .storage-eager
    = null
. position = types.properties[found].slot
if position >= tables.layouts.rows[field.layout].fields.count
    = null
. converted = convert(rhs, .reason-assignment, emit-expression(value))
if converted.type != field-type(property.type, position)
    refuse(.refused-conversion, rhs)
    = Assignment()
. base = field-value(unit.self, field, id)
put-lent(base, tables.layouts.field(field.layout, position), converted.operand, id)
. stored = Typed(base, property.type)
= Assignment(stored, stored)

────────────────────
_ member-name Atom?
    - lhs SyntaxId

` The name an assignment gives a property by: after an object, or alone.
match? tree.nodes[lhs]
    | .node-get-expression(row)
        row.name
    | .node-identifier(row)
        row.name

────────────────────
_ do emit-setter-update Assignment
    - id SyntaxId
    - op Operator
    - lhs SyntaxId
    - object SyntaxId
    - rhs SyntaxId
    - is-member Bool

` An assigning operator on a property, of an object or of a module, that a getter and a setter
` answer: the getter reads the value, the machine operation of numbers, the join of text or the
` function that answers the operator makes the new value of it and the value written, and the
` setter stores that, as the reference does. The reference evaluates the object for the read and
` again for the store, so only an object that names storage has a shape here, read once before
` the value for both calls.
. read = call-at(lhs, .call-getter)
. store = call-at(lhs, .call-store-setter)
. increment = increment-base(op)
. plan = facts.plan-of(unit.reading, id)
if read == no-fact || store == no-fact || !increment || other-plan || unplaced
    refuse(.refused-statement, id)
    = Assignment()
.. other-plan = increment != .concat-op && plan != .plan-builtin && plan != .plan-call
.. unplaced = object != 0 && !is-place(object)
. getter = facts.calls[read].callee
. setter = facts.calls[store].callee
if getter == no-instance || setter == no-instance || partial-call || uncallable
    refuse(.refused-statement, id)
    = Assignment()
.. partial-call = facts.calls[read].is-partial || facts.calls[store].is-partial
.. uncallable = !is-callable(getter) || !is-callable(setter)
if instances.signatures[getter].args.count != 0 || instances.signatures[setter].args.count != 1
    refuse(.refused-statement, id)
    = Assignment()
. receiver = make-operand(.operand-void, 0)
if is-member
    . received = emit-receiver(lhs, object, true)
    receiver = received.operand
    if received.type != instances.rows[getter].self-type || other-setter
        refuse(.refused-conversion, lhs)
    .. other-setter = received.type != instances.rows[setter].self-type
. read-mark = pending.length
if is-member
    pending += receiver
. current = if is-member then call-method(getter, lhs, read-mark) else call-instance(getter, lhs, read-mark)
. current-type = current.type
. value = current
if increment == .concat-op
    value = join-text(id, lhs, current.operand, current-type, rhs, false)
else if plan == .plan-builtin
    value = combine-builtin(id, increment, lhs, current.operand, current-type, rhs, true)
else
    . combined = answering(facts.first-call(unit.reading, id))
    if combined == no-fact || answering(facts.calls[combined].next) != no-fact
        refuse(.refused-statement, id)
        = Assignment()
    . given = emit-expression(rhs)
    . given-type = given.type
    value = call-operator(id, combined, lhs, current.operand, current-type, rhs, given.operand, given-type)
. computed = value
value = convert(id, .reason-assignment, value)
value = convert(lhs, .reason-argument, value)
if value.type != instances.argument-type(setter, 0)
    refuse(.refused-conversion, id)
    = Assignment()
. assignment = Assignment(value, computed)
. mark = pending.length
if is-member
    pending += receiver
pending += value.operand
if is-member
    call-method(setter, lhs, mark)
else
    call-instance(setter, lhs, mark)
= assignment

────────────────────
_ do emit-module-setter
    - lhs SyntaxId
    - rhs SyntaxId
    - fact CallFact

. callee = fact.callee
if callee == no-instance || fact.is-partial || !is-callable(callee)
    refuse(.refused-statement, lhs)
    =
if instances.signatures[callee].args.count != 1
    refuse(.refused-statement, lhs)
    =
. value = convert(rhs, .reason-argument, emit-expression(rhs))
if value.type != instances.argument-type(callee, 0)
    refuse(.refused-conversion, rhs)
    =
. mark = pending.length
pending += value.operand
call-instance(callee, lhs, mark)

────────────────────
_ do field-position U32
    - lhs SyntaxId
    - owner TypeId

` Which stored field the left side of an assignment names: by a constant index the type pass
` recorded, or by the name of a property the type stores.
do match? tree.nodes[lhs]
    | .node-index-expression
        . place = indexed-field(lhs)
        if place != no-fact
            = facts.constants[place].bits as U32
    | .node-get-expression(row)
        . found = property-of(owner, row.name)
        if found && types.properties[found].storage-kind == .storage-eager
            = types.properties[found].slot
    | .node-identifier(row)
        . found = property-of(owner, row.name)
        if found && types.properties[found].storage-kind == .storage-eager
            = types.properties[found].slot
refuse(.refused-statement, lhs)
= 0

────────────────────
_ is-case-member Bool
    - name SyntaxId

` Whether a name is a member of the receiver, in a member that runs on the case of a row.
|? binding == no-binding || unit.reading != unit.instance || this-cursor == U32.max
    false
??
    bindings.resolution-of(binding, name).kind == .resolve-member

.. binding = instances.rows[unit.reading].binding

────────────────────
+ is-stored Bool
    - owner TypeId
    - object SyntaxId

` Whether an assignment to a field of a type stores it in place: a struct's, or that of the
` tuple a constructor is making, written by its name alone.
is-mutable-value(owner) || (object == 0 && builds && intrinsic(owner) == .tuple)

────────────────────
_ do through-answer Bool
    - id SyntaxId

` Whether a struct is read from what an index answered by a function gave, itself or as a
` field of it. A store into it would change a value nothing names. A property of an object
` is stored in the object, wherever the object came from.
do match? tree.nodes[id]
    | .node-get-expression(row)
        . owner = facts.node-type(unit.reading, row.object)
        if owner == no-type || owner == invalid-type || tables.is-class(owner)
            = false
        = through-answer(row.object)
    | .node-index-expression(row)
        if !names-field(id)
            = true
        = through-answer(row.object)
= false

────────────────────
_ do stores-place Bool
    - lhs SyntaxId

` Whether an assignment stores into the place it names: a name that is no field, a field
` of an object or of a struct, or an item of a text, which is stored whole. A tuple's field
` is not one: assigning it gives a new tuple. A field of a row of a table or of an array, and
` one of the case of a row a name stands for, is one, kept in its cell.
. owner = no-type
. indexes = false
do match? tree.nodes[lhs]
    | .node-identifier
        if !is-own-field(lhs)
            = true
        owner = unit.owner-type
    | .node-get-expression(row)
        . plan = facts.plan-of(unit.reading, lhs)
        if case-cursor-of(row.object) != U32.max || plan == .plan-view || plan == .plan-table
            = true
        owner = facts.node-type(unit.reading, row.object)
    | .node-index-expression(row)
        owner = facts.node-type(unit.reading, row.object)
        indexes = true
if owner == no-type || owner == invalid-type
    = false
= tables.is-class(owner) || is-mutable-value(owner) || (indexes && intrinsic(owner) == .string)

────────────────────
_ do stores-by-call Bool
    - lhs SyntaxId

` Whether an index is assigned through the function that answers `[]=`, which stores the value
` wherever the object keeps it.
do match? tree.nodes[lhs]
    | .node-index-expression
        if facts.plan-of(unit.reading, lhs) == .plan-item
            = false
        . stores = own-call(lhs)
        = stores != no-fact && facts.calls[stores].form != .call-setter
= false

────────────────────
+ do emit-update Typed ?! Refused
    - id SyntaxId
    - op Operator
    - lhs SyntaxId
    - rhs SyntaxId

` What an assignment gives as a value. An assigning operator that a function answers gives
` what the function answers; where the type pass planned the answer to be stored it is stored
` first, and the value is the one stored, when storing it changed its type in no way. An
` assignment that stores into the place it names gives the value stored, as a copy when it
` is a struct, or the value as it was before the store converted it: whichever is of the
` type the type pass gave the assignment.
` An assignment to a tuple's field gives a new tuple: its fields are those of
` the old one, but for the one assigned, which an assigning operator gives from the field's
` value. An extension adds a field, and a truncation keeps
` the first. The old tuple is evaluated after the value assigned, as TypeScript evaluates it,
` and that value is kept apart from what evaluating it may change. A live statement has no
` shape here as a value.
. nothing = make-operand(.operand-void, 0)
. type = facts.node-type(unit.reading, id)
. plan = facts.plan-of(unit.reading, id)
if tables.live-statement-of(unit.reading, id)
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
if is-chained(rhs) && !is-pinned(rhs) && facts.is-replacing(unit.reading, id)
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
if is-chained(rhs) && !is-pinned(rhs)
    = emit-withheld(id, op, lhs, rhs, true)
if is-link(lhs)
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
if op != .eq-op && plan == .plan-store-answer
    . assignment = emit-assign(id, op, lhs, rhs)
    if assignment.stored.type != type
        refuse(.refused-conversion, id)
        = Typed(nothing, no-type)
    = assignment.stored
if op != .eq-op && assigning-call(lhs) != no-fact
    . answer = emit-assigning-call(id, assigning-call(lhs), lhs, rhs)
    if answer.type != type
        refuse(.refused-conversion, id)
    = answer
if plan != .plan-extend && plan != .plan-truncate && places-store
    . assignment = emit-assign(id, op, lhs, rhs)
    . unconverted = assignment.stored.type != type && assignment.given.type == type
    . gives = if unconverted then assignment.given else assignment.stored
    if gives.type != type
        refuse(.refused-conversion, id)
        = Typed(nothing, no-type)
    . stored = layout-of(type, id)
    = if tables.layouts.is-struct(stored) then Typed(snapshot(gives.operand, stored, id), type) else gives
.. places-store = stores-place(lhs) || (op == .eq-op && stores-by-call(lhs))
. extends = plan == .plan-extend && op == .add-eq-op
. object = lhs
if !extends
    do match? tree.nodes[lhs]
        | .node-get-expression(row)
            object = row.object
        | .node-index-expression(row)
            object = row.object
    if object == lhs
        refuse(.refused-expression, id)
        = Typed(nothing, no-type)
. given = nothing
. given-type = no-type
. increment = increment-base(op)
if !extends && op != .eq-op && (!increment || plan != .plan-builtin)
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
if extends || plan != .plan-truncate
    . value = if extends || op == .eq-op then emit-expression(rhs) else emit-builtin(id, increment!, lhs, rhs, true)
    if !extends
        . site = id
        do match? tree.nodes[lhs]
            | .node-index-expression
                site = lhs
        value = convert(site, .reason-assignment, value)
    given = apart(value, rhs, !is-place(object))
    given-type = value.type
. source = emit-expression(object)
. owner = source.type
. held-layout = layout-of(owner, id)
. layout = layout-of(type, id)
if !tables.layouts.is-struct(held-layout) || !tables.layouts.is-struct(layout) || mutable-owner
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
.. mutable-owner = is-mutable-value(owner)
. held = tables.layouts.rows[held-layout].fields.count
. count = tables.layouts.rows[layout].fields.count
. position = U32.max
if extends
    position = held
else if plan != .plan-truncate
    position = field-position(lhs, owner)
if position != U32.max && (position >= count || given-type != field-type(type, position))
    refuse(.refused-conversion, id)
    = Typed(nothing, no-type)
. made = frame(layout)
for index in 0 .. < count
    . field = tables.layouts.field(layout, index)
    if index == position
        put(made, field, given, id)
        continue
    if index >= held || field-type(type, index) != field-type(owner, index)
        refuse(.refused-conversion, id)
        = Typed(nothing, no-type)
    put(made, field, take(source.operand, tables.layouts.field(held-layout, index), id), id)
= Typed(made, type)

────────────────────
+ do emit-probe-assign
    - id SyntaxId
    - row ASTProbeAssign

` The assignment of a property a probe makes writes an event of the key and the value, of the
` object it is written of where it has one, through the calls the type pass recorded at it.
. number = tables.probe-number(unit.reading, id)
if number == 0
    refuse(.refused-probe, id)
    =
. made = probe-calls(id)
. start = given.length
gather-probe-object(row.object)
. values = given.length
given += Typed(make-operand(.operand-constant, ir.add-string(row.key.text)), types.string-type)
. value = emit-expression(row.content)
given += value
. converted = convert(row.content, .reason-print, Typed(value.operand, given[values + 1].type))
given[values + 1] = converted
. head = pending.length
pending += integer(.machine-u16, number)
push-probe-object(row.object, start)
. snapshots [Bool]
emit-probe-record(id, made, 0, head, values, snapshots)
drop-given(start)

────────────────────
+ do emit-updater

` The function that evaluates again the value of a property that reads something tracked,
` which the live action the constructor made for it runs through its adapter, given the
` object. The trackers of the action that runs it are those it notes reads in, and the value
` is stored as an assignment stores it.
. type = function.type
. place = function.place
. property = types.properties[place]
. object = if tables.is-class(type) then tables.layouts.objects[type] else no-layout
. default = tables.default-of(type, place)
. unit-id = tables.value-unit(place)
. live = instances.live
unit = unit.source-module = default.module
if object == no-layout || not-eager || default.value == 0 || unit-id == no-instance
    refuse(.refused-function, default.site)
    =
.. not-eager = property.storage-kind != .storage-eager
if tables.environments[unit-id] != no-layout || unchained
    refuse(.refused-function, default.site)
    =
.. unchained = live.previous == no-instance || live.next == no-instance
. field = tables.layouts.field(object, object-header-fields + property.slot)
unit = unit.takes-self = true
unit = unit.has-self = true
unit = unit.self-type = type
unit = unit.self = make-operand(.operand-argument, 0)
ir.add-argument(managed-layout)
returns-type = types.void-type
ir.returns = void-layout
. previous = ir.add-local(managed-layout)
store-local(previous, call-instance(live.previous, default.site, pending.length).operand, default.site)
. next = ir.add-local(managed-layout)
store-local(next, call-instance(live.next, default.site, pending.length).operand, default.site)
live-actions += LiveTrackers(previous, next)
. value = first-value(property, place, type, field.layout, default.site)
live-actions.pop()
put-property
    - unit.self
    - field
    - property
    - value.operand
    - default.site
    - U32.max
    - false
    - memo-flag-of(type, property)
return-value(make-operand(.operand-void, 0), default.site)

────────────────────
+ do restore-properties
    - type TypeId
    - declared SyntaxId

` Stores again the properties an initializer's arguments fill, and each property whose
` value reads one stored again, in the order the properties are declared. The rest have
` their values already. A lazy property whose value reads one stored again is stale: what
` it holds, if it was evaluated, was computed from what is replaced. It is evaluated again
` where a value stored again reads it, and is otherwise left as it is.
. range = types.completions[type].properties
filling = filling.type = type
filling = filling.start = range.start
filling = filling.count = range.count
filling = filling.filled = storage.allocate'Byte(range.count + 1)
for position in 0 .. < range.count
    . property = types.properties[range.start + position]
    . refills = property.storage-kind != .storage-getter && has-fill
        .. has-fill = tables.fill-of(unit.instance, property.name) != no-fact
    filling.filled[position] = if refills then 0 else 2
. changed = true
while changed
    changed = false
    for position in 0 .. < range.count
        if filling.filled[position] == 2 && reads-refilled(type, range.start + position)
            . is-lazy = types.properties[range.start + position].storage-kind == .storage-lazy
            filling.filled[position] = if is-lazy then 3 else 0
            changed = true
clear-fills()
clear-checks()
filling = filling.storing = true
for position in 0 .. < range.count
    if filling.filled[position] == 0 || filling.filled[position] == 4
        store-property(position, declared)
filling = filling.storing = false
filling = filling.count = 0

────────────────────
_ do reads-refilled Bool
    - type TypeId
    - place U32

` Whether the value a class writes for a stored or lazy property reads a property that is
` being stored again, or a lazy one that is stale, as the type pass recorded what the value
` reads: by a name the binder resolved to a member, or after the receiver. A value no
` instance typed may read any.
if types.properties[place].storage-kind == .storage-getter
    = false
if tables.default-of(type, place).value == 0
    = false
. unit-id = tables.value-unit(place)
if unit-id == no-instance
    = true
. read = tables.first-read(unit-id)
while read != no-fact
    . found = property-read(type, read)
    if found && filling.filled[(found as U32) - filling.start] != 2
        = true
    read = tables.next-read(read)
= false

────────────────────
+ do store-properties
    - type TypeId
    - declared SyntaxId

` Gives each stored property of the object being made its first value, in the order the
` properties are declared, base first. `filled` says which have theirs: a value that reads
` a property gives that one its value first. The live actions of the values that read
` something tracked are made once all have theirs.
. range = types.completions[type].properties
filling = filling.type = type
filling = filling.start = range.start
filling = filling.count = range.count
filling = filling.filled = storage.allocate'Byte(range.count + 1)
for position in 0 .. < range.count
    filling.filled[position] = 0
clear-fills()
clear-checks()
filling = filling.storing = true
for position in 0 .. < range.count
    store-property(position, declared)
filling = filling.storing = false
subscribe-values(declared)
filling = filling.count = 0

────────────────────
+ do store-property
    - position U32
    - syntax SyntaxId

` Gives one property of the object being made its first value, unless it has it: the
` argument of the property's name, or else the value its class writes for it, or the zero
` of its type. A lazy property is given only an argument of its name. A property whose
` value is being evaluated has no value to read. One whose value the constructor puts off
` holds nothing until the markup of the class has run. One a read gave its value on some paths
` alone is given it where its flag says it has none (`check-property`).
if filling.filled[position] == 4
    check-property(position, syntax)
    filling.filled[position] = if checking != 0 then 4 else 2
    =
if filling.filled[position] == 2
    =
if filling.filled[position] == 1
    refuse(.refused-expression, syntax)
    =
filling.filled[position] = 1
. place = filling.start + position
. property = types.properties[place]
if property.storage-kind == .storage-eager
    . object = tables.layouts.objects[filling.type]
    . field = tables.layouts.field(object, object-header-fields + property.slot)
    . fill = tables.fill-of(unit.instance, property.name)
    if facts.defers(unit.instance, place)
        store-unset(field, property, syntax)
    else if fill == no-fact
        store-default(unit.self, field, property, place, filling.type, syntax)
    else if facts.fills[fill].argument != U32.max
