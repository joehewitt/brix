if converted.type != property.type
    refuse(.refused-conversion, syntax)
    =
if tables.layouts.is-struct(field.layout)
    store-struct(object, field, converted.operand, syntax)
else if field.layout != void-layout
    store(object, field.offset, converted.operand, is-managed-pointer(field.layout), syntax)

────────────────────
+ do store-default
    - object Operand
    - field LayoutField
    - property TypeProperty
    - place U32
    - owner TypeId
    - syntax SyntaxId

` Stores a property's first value in an object. `place` is the property's place among all
` properties. A value that reads something tracked, while a constructor gives the values or
` those it put off, runs in a live action of its own, whose trackers are kept to make the
` action with: those made for it where the constructor began, where it was. A value put off is
` stored as an assignment stores it, since the markup that ran before it may already read it.
. unit-id = tables.value-unit(place)
. live = (filling.storing || unit.deferred-type != no-type) && unit-id != no-instance && live-unit
    .. live-unit = instances.rows[unit-id].is-live
. opened = if filling.count != 0 && place >= filling.start && place - filling.start < filling.count then filling.trackers[place - filling.start] else no-local
. trackers = no-local
if live
    trackers = if opened != no-local then opened else open-trackers(syntax)
    live-actions += LiveTrackers(trackers, trackers)
. value = first-value(property, place, owner, field.layout, syntax)
if live
    live-actions.pop()
if unit.deferred-type != no-type
    put-property(object, field, property, value.operand, syntax)
else if tables.layouts.is-struct(field.layout)
    store-struct(object, field, value.operand, syntax)
else if field.layout != void-layout
    store(object, field.offset, value.operand, is-managed-pointer(field.layout), syntax)
if live && (opened == no-local || !keeps-trackers(place))
    place-trackers += LivePlace(place, trackers)

