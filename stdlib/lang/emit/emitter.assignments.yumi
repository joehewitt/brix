_ do emit-withheld Typed
    - id SyntaxId
    - op Operator
    - lhs SyntaxId
    - rhs SyntaxId
    - wanted Bool

` An assignment whose value is written after `?`. The value is evaluated first. Where the
` flow knows it to hold a value, it is assigned as any value is. Otherwise it is an optional,
` tested once: where it holds a value, what it holds is assigned, and where it holds nothing
` the place is read and nothing is stored, as TypeScript does. The assignment then gives
` what the place holds: `wanted` says its value is used. Only a place that names storage has
` a shape here, and none that is a link of an optional chain. Nor has a name alone that holds
` an optional, tested so: TypeScript takes it to hold a value afterwards, whatever was stored.
. nothing = make-operand(.operand-void, 0)
. written = 0u32
do match? tree.nodes[rhs]
    | .node-optional-chain(row)
        written = row.expr
if written == 0 || is-link(lhs) || !is-place(lhs)
    refuse(.refused-statement, id)
    = Typed(nothing, no-type)
. given = emit-expression(written)
. held = given.type
. type = facts.node-type(unit.reading, id)
if !types.is-optional(held)
    . known = pins.length
    pin(rhs, given.operand, held)
    . plain = Typed(nothing, no-type)
    if wanted
        plain = emit-update(id, op, lhs, rhs)
    else
        emit-assign(id, op, lhs, rhs)
    unpin(known)
    = plain
. named = match tree.nodes[lhs]
    | .node-identifier
        true
    ??
        false
. kept-type = facts.node-type(unit.reading, lhs)
if op == .eq-op && named && optional-kept
    refuse(.refused-statement, id)
    = Typed(nothing, no-type)
.. optional-kept = kept-type == no-type || kept-type == invalid-type || types.is-optional(kept-type)
. layout = if wanted then layout-of(type, id) else void-layout
. tested = present(written, given)
. filled = ir.reserve-block()
. empty = ir.reserve-block()
. joined = ir.reserve-block()
. slot = if wanted then join-slot(layout) else nothing
. mark = joins.length
branch(tested.operand, filled, empty)
ir.start-block(filled)
. inside = payload(written, Typed(given.operand, held))
. pin-mark = pins.length
pin(rhs, inside.operand, inside.type)
. assignment = emit-assign(id, op, lhs, rhs)
unpin(pin-mark)
if wanted && assignment.stored.type != type
    refuse(.refused-conversion, id)
if wanted
    arrive(id, assignment.stored.operand, joined, slot)
else
    jump(joined)
ir.start-block(empty)
. kept = emit-expression(lhs)
if wanted && kept.type != type
    refuse(.refused-conversion, id)
if wanted
    arrive(id, kept.operand, joined, slot)
    = Typed(close-joins(joined, mark, layout, slot), type)
jump(joined)
ir.start-block(joined)
= Typed(nothing, kept.type)

