. target = apart(emitted, object, !is-inert(index))
. held = emitted.type
. range = emit-expression(index)
. range-type = range.type
. layout = layout-of(held, id)
. source-layout = layout-of(source-type, id)
. item-layout = layout-of(viewed-item(held), id)
