    branch(load(argument, flag.offset, flag.layout, syntax), present, absent)
ir.start-block(absent)
store-default(object, field, property, place, owner, syntax)
jump(stored)
ir.start-block(present)
. value = argument
if !nullable
    . inner = tables.layouts.field(layout, 0)
    if tables.layouts.is-struct(inner.layout)
        value = address(argument, inner.offset, inner.layout, syntax)
    else
        value = load(argument, inner.offset, inner.layout, syntax)
store-converted(object, field, property, fact.site, Typed(value, types.optional-inner(given)), syntax)
jump(stored)
ir.start-block(stored)

