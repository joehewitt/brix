(import ./emitter)
(import ./emitter.cleanups)
(import ./emitter.live-actions)
(import ./emitter.match-arms)
(import ./emitter.streams)
(import ./emitter.tables)
(import ./layouts)
(import ./program-tables)
(import ./receiver-stability)
(import ./runtime)
(import ./table-layouts)
(import /core/arena)
(import /core/table)
(import /lang/ast/ast)
(import /lang/ast/ast-children)
(import /lang/ast/ast-nodes)
(import /lang/ast/ast-queries)
(import /lang/ast/decl)
(import /lang/ast/module)
(import /lang/ast/operator)
(import /lang/ast/program)
(import /lang/ast/row-range)
(import /lang/ast/state-machines)
(import /lang/backend/mir)
(import /lang/check/binding)
(import /lang/check/claims)
(import /lang/check/facts)
(import /lang/check/instances)
(import /lang/check/machine-composite)
(import /lang/check/numeric)
(import /lang/check/pattern-helper)
(import /lang/check/probe-casts)
(import /lang/check/table-rows)
(import /lang/check/type-signature)
(import /lang/check/type-store)
(import /lang/check/type-text)
(import /lang/check/types)
(import /lang/ir/ir)
(import /stream/sort)

(type _ Loops (facet-of FunctionEmitter)
  (sees Cleanups)
  (sees LiveActions)
  (sees MatchArms)
  (sees Streams)
  (sees Tables)
  (fn-do + emit-while _
    (param id SyntaxId)
    (param condition SyntaxId)
    (param body SyntaxId)
    ; A loop that runs its body for as long as its condition tests as true. Each pass polls
    ; before the test. The loop is one to leave or to go on with from its condition on: written
    ; with a pattern, its body runs in the arm of the match that is the condition. A turn
    ; whose locals nested functions capture has an environment of its own. A condition that
    ; opens a cleanup, reading a lazy local whose value is a `use`, has no shape: TypeScript
    ; runs that cleanup where the body ends, and not at all where the condition first fails.
    (let nothing (call make-operand .operand-void 0))
    (let head (call (. ir reserve-block)))
    (let inside (call (. ir reserve-block)))
    (let done (call (. ir reserve-block)))
    (call jump head)
    (call (. ir start-block) head)
    (call emit-poll id)
    (let open (. open-cleanups length))
    (+= loops (call EmittedLoop id head done nothing no-type open no-slot))
    (call branch-on condition inside done)
    (if (!= (. open-cleanups length) open)
      (call refuse .refused-expression condition)
    )
    (call (. ir start-block) inside)
    (let turns (. open-turns length))
    (call open-turn id nothing no-type)
    (call emit-block body)
    (call close-turns turns)
    (call (. loops pop))
    (call jump head)
    (call (. ir start-block) done)
  )
  (fn-do + emit-for _
    (param id SyntaxId)
    (param loop SyntaxId)
    (param body SyntaxId)
    ; A loop over items, run as the type pass planned it: one that counts through a range of
    ; integers written in its header, or one over the container of each of its headers. One on a
    ; stream subscribes where it is written, and runs for an item in the function generated for
    ; it.
    (match? ([] (. tree nodes) loop)
      (case (call .node-loop-syntax row)
        (if (== (call (. facts plan-of) (. unit reading) loop) .plan-range-loop)
          (match? ([] (. tree nodes) (. row container))
            (case (call .node-range-expression range)
              (call emit-range-loop loop (. range op) (. range left) (. range right) (. row clause) body)
              (return)
            )
          )
          (else-if (not (. row is-subscriber))
            (call emit-headed loop (. row container) (. row clause) body)
            (return)
          )
          (else-if (== subscribing id)
            (call emit-subscriber loop (call tested loop (. row clause)) body)
            (return)
          )
          (else
            (call emit-subscription id loop (. row container))
            (return)
          )
        )
      )
    )
    (call refuse .refused-statement id)
  )
  (fn-do + hold-container TypeId
    (param loop SyntaxId)
    (param container SyntaxId)
    (param slot SlotId)
    (param kept Bool (= false))
    ; Evaluates the container of a loop, once, and keeps it in the first of the loop's slots,
    ; converted as the type pass recorded where it is written, and answers its type. The loop of
    ; a comprehension keeps its container already: the function generated for it was given the
    ; container where it was called. So does the loop of a feed, which kept it where the feed
    ; began, as `kept` says.
    (= holding (call make-operand .operand-void 0))
    (if (and (== (call (. facts plan-of) (. unit reading) loop) .plan-table-loop) kept)
      (call refuse .refused-statement loop)
      (return no-type)
    )
    (if (== (call (. facts plan-of) (. unit reading) loop) .plan-table-loop)
      (return (call hold-rows loop container slot))
    )
    (if (or (== loop given-loop) kept)
      (let kept (call state slot loop))
      (= holding (. kept operand))
      (return (. kept type))
    )
    (if (call reads-place loop)
      (let base (call (. facts loop-base) (. unit reading) loop))
      (if (== base (. U32 max))
        (call refuse .refused-statement loop)
        (return no-type)
      )
      (if (!= base 0)
        (let object (call emit-expression base))
        (call pin base (. object operand) (. object type))
      )
      (let emitted (call emit-expression container))
      (if (not (call (. tables layouts is-struct) (call layout-of (. emitted type) loop)))
        (call refuse .refused-statement loop)
      )
      (return (. emitted type))
    )
    (let held (call convert container .reason-operand (call emit-expression container)))
    (let type (. held type))
    (call keep-state slot (. held operand) type loop)
    (= holding (. held operand))
    (return type)
  )
  (fn-do _ hold-rows TypeId
    (param loop SyntaxId)
    (param container SyntaxId)
    (param slot SlotId)
    ; Begins a loop over a table or a span of one, as TypeScript begins it: the container is
    ; evaluated, once, and its rows found, checked where the table grows; the first row is kept,
    ; and the count of rows. An index span is kept, and its length. Answers the container's type.
    ; The loop of a comprehension reads the container it was given from the slot after its item.
    (let table
      (match loop
        (case= given-loop
          (call state (+ slot loop-state-count) loop)
        )
        (default
          (call convert container .reason-operand (call emit-expression container))
        )
      )
    )
    (let type (. table type))
    (if (or (== (call intrinsic type) .table-selection) (== (call intrinsic type) .immutable-table-selection))
      (call hold-selection loop (. table operand) type slot)
      (return type)
    )
    (if (== (call intrinsic type) .index-span)
      (let layout (call layout-of type loop))
      (call keep-state slot (. table operand) type loop)
      (call keep-state (+ slot 1) (call word-at loop (. table operand) layout 3) (. types size-type) loop)
      (return type)
    )
    (let offset (call slot-offset slot loop))
    (let row (call (. facts slot-type) (. unit instance) offset))
    (let layout (call layout-of type loop))
    (let row-layout (call layout-of row loop))
    (let source (call table-source loop (. table operand) type layout))
    (let made (call frame row-layout))
    (if (call is-immutable-view (call intrinsic type))
      (call put
        (block
          (arg made)
          (arg (call (. tables layouts field) row-layout 0))
          (arg (call num-cast loop (. source columns) pointer-layout managed-layout))
          (arg loop)
        )
      )
      (call put made (call (. tables layouts field) row-layout 1) (. source offset) loop)
      (else
        (call put
          (block
            (arg made)
            (arg (call (. tables layouts field) row-layout 0))
            (arg (call view-columns loop (. source meta) (. source columns)))
            (arg loop)
          )
        )
        (call put made (call (. tables layouts field) row-layout 1) (. source offset) loop)
        (call put-meta loop made row-layout 2 (. source meta))
      )
    )
    (call keep-state slot made row loop)
    (call keep-state (+ slot 1) (. source length) (. types size-type) loop)
    (let kind (call intrinsic type))
    (if (and (!= (call (. facts constant-of) (. unit reading) loop) no-fact) (or (== kind .table) (== kind .table-span)))
      (let named (call loop-name-slot loop))
      (if (!= named no-slot)
        (+= proven-items (call ProvenItem loop named (. source columns)))
      )
    )
    (return type)
  )
  (fn-do _ hold-selection _
    (param loop SyntaxId)
    (param selection Operand)
    (param type TypeId)
    (param slot SlotId)
    ; Begins a loop over a selection of a table's rows, as TypeScript's loop over rows begins it:
    ; the indices are resolved, then the table's columns and length found, checked where it
    ; grows. The selection is kept as a finished table of those columns and that length, read
    ; with no metadata, and, where the indices are not resolved again on each pass, with the
    ; indices where they lie; then the count of indices. A loop TypeScript leaves to the
    ; selection's own iteration is refused.
    (let constant (call (. facts constant-of) (. unit reading) loop))
    (let reads (if-expr (!= constant no-fact) (. ([] (. facts constants) constant) bits) 2u64))
    (if (== reads 2)
      (call refuse .refused-statement loop)
      (return)
    )
    (let layout (call layout-of type loop))
    (let table-type (call field-type type 0))
    (let span-type (call field-type type 1))
    (let table-layout (call layout-of table-type loop))
    (let span-layout (call layout-of span-type loop))
    (let table (call part selection layout 0 loop))
    (let span (call part selection layout 1 loop))
    (let resolved (call resolve-span loop (. span operand) span-layout))
    (let source (call table-source loop (. table operand) table-type table-layout))
    (let made (call frame layout))
    (call copy made selection layout false loop)
    (let kept-table (call address made (. (call (. tables layouts field) layout 0) offset) table-layout loop))
    (call put-word loop kept-table table-layout 0 (. source columns) pointer-layout)
    (call put-word loop kept-table table-layout 1 (. source length) u64-layout)
    (for (in position (..< 2 (. ([] (. tables layouts rows) table-layout) fields count)))
      (call put-word loop kept-table table-layout position (call integer .machine-u64 0) u64-layout)
    )
    (if (== reads 0)
      (let kept-span (call address made (. (call (. tables layouts field) layout 1) offset) span-layout loop))
      (call put-word loop kept-span span-layout 0 (. resolved data) u64-layout)
      (call put-word loop kept-span span-layout 1 (call integer .machine-u64 0) u64-layout)
    )
    (call keep-state slot made type loop)
    (call keep-state (+ slot 1) (call word-at loop (. span operand) span-layout 3) (. types size-type) loop)
  )
  (fn-do _ read-selected Typed
    (param loop SyntaxId)
    (param slot SlotId)
    (param type TypeId)
    (param done IRBlockId)
    ; The next row of a loop over a selection of a table's rows, or a leave to `done` once the
    ; count read reaches the count of indices: the indices are resolved, again where the loop
    ; finds them on each pass, the index read at the count, and checked against the table's
    ; length as found when the loop began; the row there holds no metadata.
    (let none (call make-operand .operand-void 0))
    (let item-slot (call slot-offset (- (+ slot loop-state-count) 1) loop))
    (let row (call (. facts slot-type) (. unit instance) item-slot))
    (let row-kind (call intrinsic row))
    (if (and (!= row-kind .table-row) (!= row-kind .immutable-table-row))
      (call refuse .refused-statement loop)
      (return (call Typed none no-type))
    )
    (let layout (call layout-of type loop))
    (let table-type (call field-type type 0))
    (let span-type (call field-type type 1))
    (let table-layout (call layout-of table-type loop))
    (let span-layout (call layout-of span-type loop))
    (let item (call viewed-item span-type))
    (let item-layout (call layout-of item loop))
    (let row-layout (call layout-of row loop))
    (let inside (call (. ir reserve-block)))
    (call branch
      (block
        (arg (call compare loop .compare-less (. (call state (+ slot 2) loop) operand) (. (call state (+ slot 1) loop) operand)))
        (arg inside)
        (arg done)
      )
    )
    (call (. ir start-block) inside)
    (let count (call state (+ slot 2) loop))
    (call keep-state
      (block
        (arg (+ slot 2))
        (arg (call arithmetic loop .arithmetic-add (. count operand) (call integer .machine-u64 1) u64-layout))
        (arg (. types size-type))
        (arg loop)
      )
    )
    (let selection (call state slot loop))
    (let table (call part (. selection operand) layout 0 loop))
    (let span (call part (. selection operand) layout 1 loop))
    (let index
      (call selected-index
        (block
          (arg loop)
          (arg (call resolve-span loop (. span operand) span-layout))
          (arg (. count operand))
          (arg item)
          (arg item-layout)
        )
      )
    )
    (call fail-if
      (block
        (arg loop)
        (arg (call compare loop .compare-greater-equal index (call word-at loop (. table operand) table-layout 1)))
        (arg "TableSelection index is out of bounds")
      )
    )
    (let made (call frame row-layout))
    (call put-word loop made row-layout 0 (call word-at loop (. table operand) table-layout 0) u64-layout)
    (call put made (call (. tables layouts field) row-layout 1) index loop)
    (for (in position (..< 2 (. ([] (. tables layouts rows) row-layout) fields count)))
      (call put-word loop made row-layout position (call integer .machine-u64 0) u64-layout)
    )
    (return (call Typed made row))
  )
  (fn-do _ read-index Typed
    (param loop SyntaxId)
    (param slot SlotId)
    (param type TypeId)
    (param done IRBlockId)
    ; The next index of a loop over an index span, or a leave to `done` once the count read
    ; reaches the length read when the loop began: the span is resolved, and the index read at
    ; the count, as `s[i]` reads it.
    (let layout (call layout-of type loop))
    (let item (call viewed-item type))
    (let item-layout (call layout-of item loop))
    (let inside (call (. ir reserve-block)))
    (call branch
      (block
        (arg (call compare loop .compare-less (. (call state (+ slot 2) loop) operand) (. (call state (+ slot 1) loop) operand)))
        (arg inside)
        (arg done)
      )
    )
    (call (. ir start-block) inside)
    (let count (call state (+ slot 2) loop))
    (call keep-state
      (block
        (arg (+ slot 2))
        (arg (call arithmetic loop .arithmetic-add (. count operand) (call integer .machine-u64 1) u64-layout))
        (arg (. types size-type))
        (arg loop)
      )
    )
    (let span (call state slot loop))
    (let value (call span-item loop (call resolve-span loop (. span operand) layout) (. count operand) item-layout))
    (return (call Typed value item))
  )
  (fn-expr _ reads-place Bool
    (param loop SyntaxId)
    ; Whether a loop reads its container where it is kept at each item, as the type pass
    ; planned it: in a function that yields the loop keeps the container, as the reference's
    ; does there, and so does the loop of a comprehension, which is given it.
    (and (not stepping) (!= loop given-loop) (call is-place-loop-plan (call (. facts plan-of) (. unit reading) loop)))
  )
  (fn-do _ container-of Typed
    (param loop SyntaxId)
    (param written SyntaxId)
    (param slot SlotId)
    ; What a loop reads its items from: what it keeps, or its container read anew where it is
    ; kept, with the object it is a property of as that was when the loop began.
    (if (not (call reads-place loop))
      (return (call state slot loop))
    )
    (return (call emit-expression written))
  )
  (fn-expr _ protocol-calls FactId
    (param loop SyntaxId)
    ; The calls the type pass recorded for the protocol of a loop, in the order the loop makes
    ; them: at the header of a loop, and for a spread of a container from
    ; the first the type pass kept for it, beside others where it kept them, as at a feed that
    ; also keeps those of the first feed of its list.
    (case? (or (!= (call (. facts feed-site) (. unit reading) loop) loop) (!= start no-fact))
      start
    )
    (default
      (call (. facts first-call) (. unit reading) loop)
    )
    (where
      (lazy start (call (. facts protocol-start) (. unit reading) loop))
    )
  )
  (fn-do _ open-turn _
    (param loop SyntaxId)
    (param item Operand)
    (param type TypeId)
    ; Starts a turn of a loop whose body declares a local that nested functions capture. The
    ; turn has an environment of its own: an object the collector owns, which arrives zeroed,
    ; with the link to the environment in force around the loop. A nested function written in
    ; the turn is given it, so that each turn's functions read that turn's locals. The item of
    ; the turn is copied there under each name it is captured by: the one the loop writes for
    ; it, `each` and `it`. A local holds the environment of the turn; in a function that
    ; yields, a field of the function's own environment does, which keeps it from one step to
    ; the next.
    (if (== (. unit instance) no-instance)
      (return)
    )
    (let scope (call (. tables turn-scope) (. ([] (. instances rows) (. unit instance)) module) loop))
    (if (== scope no-scope)
      (return)
    )
    (let layout (call (. tables turn-environment) (. unit instance) scope))
    (if (or (!= (. unit reading) (. unit instance)) (== layout no-layout) (== layout unbuilt-environment))
      (call refuse .refused-statement loop)
      (return)
    )
    (let place (if-expr stepping (call (. tables turn-place) (. unit instance) scope) no-place))
    (if (and stepping (or (== place no-place) (== (. unit environment) no-local)))
      (call refuse .refused-statement loop)
      (return)
    )
    (let link (call written-environment loop))
    (let mark (. pending length))
    (+= pending (call integer .machine-u64 (. ([] (. tables layouts rows) layout) size)))
    (+= pending (call make-operand .operand-descriptor layout))
    (let made (call call-runtime .runtime-allocate-object loop mark managed-layout))
    (let local no-local)
    (if stepping
      (let field (call (. tables layouts field) ([] (. tables environments) (. unit instance)) place))
      (call store (call load-local (. unit environment) loop) (. field offset) made true loop)
      (else
        (= local (call (. ir add-local) managed-layout))
        (call store-local local made loop)
      )
    )
    (call store made 0 link true loop)
    (+= open-turns (call TurnScope scope local place))
    (for (in offset (..< 0 (. unit slot-count)))
      (let slot (+ (. unit slot-start) offset))
      (let kind (. ([] (. bindings slots) slot) kind))
      (if (!= ([] (. tables slot-homes) slot) scope)
        (continue)
      )
      (if (or (== kind .slot-each) (== kind .slot-it) whole-item)
        (call keep-captured slot item type loop)
      )
      (lazy whole-item (and (== kind .slot-loop-item) (== (call (. facts loop-take) (. unit reading) loop) .take-whole)))
    )
  )
  (fn-do + close-turns _
    (param mark Size)
    ; Ends the turns opened since `mark`, where the body of their loop has been emitted.
    (while (> (. open-turns length) mark)
      (call (. open-turns pop))
    )
  )
  (fn-do + loop-slots SlotId
    (param loop SyntaxId)
    ; The first of the slots the binder declared for what a loop keeps, in the function whose
    ; facts are being read, which is the one emitted.
    (let binding (. ([] (. instances rows) (. unit reading)) binding))
    (let slot no-slot)
    (if (and (!= binding no-binding) (== (. unit reading) (. unit instance)))
      (= slot (call (. bindings loop-state) binding loop))
    )
    (if (== slot no-slot)
      (call refuse .refused-statement loop)
    )
    (return slot)
  )
  (fn-do + emit-headed _
    (param first SyntaxId)
    (param written SyntaxId)
    (param clause SyntaxId)
    (param body SyntaxId)
    (param kept Bool (= false))
    ; A loop over the container of each of its headers, by the protocol the type pass planned
    ; for each: by its indexes, by a cursor, or as a stream. A spread of
    ; a container is such a loop of one header, whose container the feed keeps already (`kept`).
    ; 1. Every container is evaluated, in the order written, and then each is begun. From there
    ;    on, telling the streams among them that the loop has ended is a cleanup: it runs
    ;    however the loop is left, as the body of a `do finally` written there would.
    ; 2. A turn reads an item of each header in order. The head of a header polls and reads,
    ;    and a container with no more ends the loop. The header takes the item and tests its
    ;    clause; an item that does not match, or a `when` that fails, reads that header again.
    ; 3. The body runs. `continue` goes to the first head, as the end of the body does. The
    ;    body of a comprehension's loop is an expression, and is yielded, and a feed has no
    ;    body and yields the item.
    ; In a cleanup being run, a check made in the loop lands where the cleanup ends, as in the rest
    ; of it, leaving its streams unended, as TypeScript's does (`end-in-cleanup`). A header that
    ; subscribes, the loop of a comprehension whose first header writes a pattern that is no match,
    ; and a stream read where the collector never looks have no shape.
    (let chain (list SyntaxId))
    (let containers (list SyntaxId))
    (let clauses (list SyntaxId))
    (let streams false)
    (let header first)
    (let container written)
    (let tested clause)
    (while (!= header 0)
      (let plan (call (. facts plan-of) (. unit reading) header))
      (let next SyntaxId 0)
      (match? ([] (. tree nodes) header)
        (case (call .node-loop-syntax row)
          (= next (. row next))
          (if (or (. row is-subscriber) (and (== header given-loop) (not (call takes-item header))))
            (call refuse .refused-statement header)
          )
        )
      )
      (if (== plan .plan-stream-loop)
        (= streams true)
        (else-if (and (not (call is-index-loop-plan plan)) (not (call is-cursor-loop-plan plan)) other-loop-plan)
          (call refuse .refused-statement header)
        )
      )
      (lazy other-loop-plan (and (!= plan .plan-table-loop) (!= plan .plan-pattern-loop)))
      (+= chain header)
      (+= containers container)
      (+= clauses tested)
      (= header next)
      (match? ([] (. tree nodes) header)
        (case (call .node-loop-syntax row)
          (= container (. row container))
          (= tested (. row clause))
        )
      )
    )
    (let caught landing)
    (if (and streams (or (call is-free (. unit instance)) (and (. scoping cleaning) (== caught no-block))))
      (call refuse .refused-statement first)
      (return)
    )
    (let pin-mark (. pins length))
    (let slots (list SlotId))
    (let kinds (list TypeId))
    (let made (call make-operand .operand-void 0))
    (for (in position (..< 0 (. chain length)))
      (let slot (call loop-slots ([] chain position)))
      (let kind (call hold-container ([] chain position) ([] containers position) slot (and kept (== position 0))))
      (= made holding)
      (+= slots slot)
      (+= kinds kind)
    )
    (= protocol-row (. U32 max))
    (for (in position (..< 0 (. chain length)))
      (call begin-items ([] chain position) ([] containers position) ([] slots position) ([] kinds position))
    )
    (let stream (. U32 max))
    (if (and (== (. chain length) 1) streams (not stepping) value-made)
      (= stream (as (. ir streams length) U32))
      (call (. ir streams append) (call IRStream made protocol-row (. U32 max) (call IdList)))
      (+= stream-loops first)
    )
    (lazy value-made (or (== (call operand-kind made) .operand-value) (== (call operand-kind made) .operand-argument)))
    (let mark (. open-cleanups length))
    (let own-scoping scoping)
    (if streams
      (= scoping (= (. scoping block-base) mark))
      (call open-cleanup first (call UseCell no-local no-local no-type))
      (if (. scoping cleaning)
        (= landing caught)
      )
    )
    (let root (call (. ir reserve-block)))
    (let done (call (. ir reserve-block)))
    (let turns (. open-turns length))
    (let depth (. loops length))
    (let named (. bound length))
    (let captured (. stream-captures length))
    (let last no-slot)
    (call jump root)
    (let head root)
    (for (in position (..< 0 (. chain length)))
      (let loop ([] chain position))
      (if (!= position 0)
        (= head (call (. ir reserve-block)))
        (call jump head)
      )
      (call (. ir start-block) head)
      (call emit-poll loop)
      (let polled (. ir current))
      (= protocol-row (. U32 max))
      (let item (call read-items loop first ([] containers position) ([] slots position) ([] kinds position) done))
      (if (!= stream (. U32 max))
        (= (. ([] (. ir streams) stream) read) protocol-row)
        (= (. ([] (. ir streams) stream) head) head)
        (= (. ([] (. ir streams) stream) polled) polled)
        (= (. ([] (. ir streams) stream) done) done)
      )
      (let type (. item type))
      (= last (- (+ ([] slots position) loop-state-count) 1))
      (call take-item loop last (. item operand) type head)
