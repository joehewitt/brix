        (call refuse .refused-statement loop)
        (return)
      )
      (call keep-state (+ slot 1) (. length operand) (. types size-type) loop)
      (call keep-state (+ slot 2) (call integer .machine-u64 0) (. types size-type) loop)
      (return)
    )
