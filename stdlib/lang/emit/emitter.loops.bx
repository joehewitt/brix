          (block
            (arg place)
            (arg reads)
            (arg (. (call container-of loop container slot) operand))
            (arg type)
            (arg (. index operand))
            (arg (. types index-type))
          )
        )
      )
    )
    (let next nothing)
    (let given no-type)
    (if (call is-cursor-loop-plan plan)
