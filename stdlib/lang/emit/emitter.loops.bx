      (= falls (. (call state (+ kept 2) loop) operand))
    )
    (let item (if-expr stepping (call state kept loop) (call Typed (call load-local index loop) type)))
    (let below (if-expr takes-end .compare-less-equal .compare-less))
    (if rising
      (call branch (call compare loop below (. item operand) (. end operand)) inside done)
      (else
        (let up (call (. ir reserve-block)))
        (let down (call (. ir reserve-block)))
        (call branch falls down up)
        (call (. ir start-block) down)
        (call branch
          (block
            (arg
              (call compare
                (block
                  (arg loop)
                  (arg (if-expr takes-end .compare-greater-equal .compare-greater))
                  (arg (. item operand))
                  (arg (. end operand))
                )
              )
            )
            (arg inside)
            (arg done)
          )
        )
        (call (. ir start-block) up)
        (call branch (call compare loop below (. item operand) (. end operand)) inside done)
      )
    )
    (blank)
    (call (. ir start-block) inside)
    (call emit-loop-body loop (. item operand) type step done kept clause body)
    (blank)
    (call (. ir start-block) step)
    (if stepping
      (= item (call state kept loop))
      (= end (call state (+ kept 1) loop))
      (= pace (call range-pace loop (. (call state (+ kept 2) loop) operand) wide rising))
    )
    (if takes-end
      (let moving (call (. ir reserve-block)))
      (call branch (call compare loop .compare-equal (. item operand) (. end operand)) done moving)
      (call (. ir start-block) moving)
    )
    (let moved
      (call num-cast
        (block
          (arg loop)
          (arg (call arithmetic loop .arithmetic-add (call num-cast loop (. item operand) layout wide) pace wide))
          (arg wide)
          (arg layout)
        )
      )
    )
    (if stepping
      (call keep-state kept moved type loop)
      (else
        (call store-local index moved loop)
      )
    )
    (call jump head)
    (call (. ir start-block) done)
    (call forget-proven loop)
  )
  (fn-do _ range-pace Operand
    (param loop SyntaxId)
    (param falls Operand)
    (param wide LayoutId)
    (param rising Bool)
    (if rising
      (return (call integer (as wide MachineKind) 1))
    )
    (let rises (call bitwise loop .bitwise-xor falls (call integer .machine-u8 1) u8-layout))
    (return
      (call arithmetic
        (block
          (arg loop)
          (arg .arithmetic-subtract)
          (arg (call num-cast loop rises u8-layout wide))
          (arg (call num-cast loop falls u8-layout wide))
          (arg wide)
        )
      )
    )
  )
  (fn-do _ counted-end Typed
    (param loop SyntaxId)
    (param last SyntaxId)
    (match? ([] (. tree nodes) last)
      (case (call .node-get-expression get)
        (if (and table-plan (== (call table-op last) (. TableOp table-length)) row-source)
          (let held (call emit-expression (. get object)))
          (let type (. held type))
          (let layout (call layout-of type last))
          (let source (call table-source last (. held operand) type layout))
          (+= proven-tables (call ProvenTable loop (call intrinsic type) source))
          (return (call Typed (. source length) (. types size-type)))
        )
        (lazy table-plan (== (call (. facts plan-of) (. unit reading) last) .plan-table))
        (lazy row-source (call is-row-source (call intrinsic (call (. facts node-type) (. unit reading) (. get object)))))
      )
    )
    (return (call emit-expression last))
  )
  (fn-do _ emit-counted-loop _
    (param loop SyntaxId)
    (param start Operand)
    (param end Operand)
    (param type TypeId)
    (param layout LayoutId)
    (param clause SyntaxId)
    (param body SyntaxId)
    (let index (call (. ir add-local) layout))
    (call store-local index start loop)
    (let hoist (call (. ir reserve-block)))
    (let head (call (. ir reserve-block)))
    (let inside (call (. ir reserve-block)))
    (let step (call (. ir reserve-block)))
    (let done (call (. ir reserve-block)))
    (call jump hoist)
    (blank)
    (call (. ir start-block) head)
    (call emit-poll loop)
    (let item (call load-local index loop))
    (call branch (call compare loop .compare-less item end) inside done)
    (blank)
    (call (. ir start-block) inside)
    (call emit-loop-body loop item type step done no-slot clause body)
    (blank)
    (call (. ir start-block) step)
    (let wide (if-expr (>= (. ([] (. tables layouts rows) layout) size) 4) layout i32-layout))
    (let moved
      (call arithmetic
        (block
          (arg loop)
          (arg .arithmetic-add)
          (arg (call num-cast loop item layout wide))
          (arg (call integer (as wide MachineKind) 1))
          (arg wide)
        )
      )
    )
    (call store-local index (call num-cast loop moved wide layout) loop)
    (call jump head)
    (blank)
    (call (. ir start-block) hoist)
    (call hoist-columns loop)
    (call jump head)
    (call (. ir start-block) done)
    (call forget-proven loop)
  )
  (fn-do _ emit-loop-body _
    (param loop SyntaxId)
    (param item Operand)
    (param type TypeId)
    (param step IRBlockId)
    (param done IRBlockId)
    (param kept SlotId)
    (param clause SyntaxId)
    (param body SyntaxId)
    ; Emits a pass of a range loop over `item`, of `type`, which `continue` leaves for `step` and
    ; `break` for `done`: its clause, then its body, or where it has none and gives items, the item
    ; it gives.
    (let turns (. open-turns length))
    (call open-turn loop item type)
    (+= loops (call EmittedLoop loop step done item type (. open-cleanups length) kept))
    (call emit-clause clause step done)
    (if (call (. tree gives-items) loop body)
      (call give-item loop (call (. facts feed-site) (. unit reading) loop) (call read-item loop loop type))
      (else-if (!= body 0)
        (call emit-block body)
      )
    )
    (call close-turns turns)
    (call (. loops pop))
    (call jump step)
  )
  (fn-do _ hoist-columns _
    (param loop SyntaxId)
    (let found (call proven-loop loop))
    (if (== found (. U32 max))
      (return)
    )
    (let columns (. ([] proven-tables found) source columns))
    (while (and (!= (. proven-columns length) 0) (== (. ([] proven-columns (- (. proven-columns length) 1)) loop) loop))
      (let held ([] proven-columns (- (. proven-columns length) 1)))
      (call store-local (. held local) (call load columns (* (. held column) 8) pointer-layout loop) loop)
      (call (. proven-columns pop))
    )
  )
  (fn-do _ forget-proven _
    (param loop SyntaxId)
    (while (and (!= (. proven-tables length) 0) (== (. ([] proven-tables (- (. proven-tables length) 1)) loop) loop))
      (call (. proven-tables pop))
    )
    (let kept (list ProvenRead))
    (for (in held proven-reads)
      (if (!= (. held loop) loop)
        (+= kept held)
      )
    )
    (call (. proven-reads clear))
    (for (in held kept)
      (+= proven-reads held)
    )
  )
  (fn-do _ loop-name-slot SlotId
    (param loop SyntaxId)
    (let binding (. ([] (. instances rows) (. unit reading)) binding))
    (if (or (== binding no-binding) (!= (. unit reading) (. unit instance)))
      (return no-slot)
    )
    (match? ([] (. tree nodes) loop)
      (case (call .node-loop-syntax row)
        (let identifier (. row pattern))
        (match? ([] (. tree nodes) (. row pattern))
          (case (call .node-type-capture capture)
            (= identifier (. capture id))
          )
        )
        (let resolution (call (. bindings resolution-of) binding identifier))
        (if (== (. resolution kind) .resolve-slot)
          (return (. resolution slot))
        )
      )
    )
    (return no-slot)
  )
  (fn-do _ forget-item _
    (param loop SyntaxId)
    (while (and (!= (. proven-items length) 0) (== (. ([] proven-items (- (. proven-items length) 1)) loop) loop))
      (call (. proven-items pop))
    )
  )
  (fn-do + forget-read _
    (param loop SyntaxId)
    (param column U32)
    (let kept (list ProvenRead))
    (for (in held proven-reads)
      (if (or (!= (. held loop) loop) (!= (. held column) column))
        (+= kept held)
      )
    )
    (call (. proven-reads clear))
    (for (in held kept)
      (+= proven-reads held)
    )
  )
  (fn-expr + innermost-loop SyntaxId
    (if-expr (== (. loops length) 0) 0 (. ([] loops (- (. loops length) 1)) syntax))
  )
  (fn-do + emit-clause _
    (param clause SyntaxId)
    (param step IRBlockId)
    (param done IRBlockId)
    ; The clauses of a loop, tested in the order written before its body on each pass. A `when`
    ; that fails goes on to the next pass. A `while` that fails ends the loop, and so does an
    ; `until` that holds. The first clause that decides wins: the clauses after it are not tested.
    ; A `whenever` says whether a loop on a stream is subscribed and is not tested here.
    (let current (call first-tested clause))
    (while (!= current 0)
      (let expr SyntaxId 0)
      (let next SyntaxId 0)
      (let passes no-block)
      (let fails no-block)
      (let resumed (call (. ir reserve-block)))
      (match? ([] (. tree nodes) current)
        (case (call .node-clause row)
          (= expr (. row expr))
          (= next (. row next))
          (match? (. row op)
            (case .when-clause
              (= passes resumed)
              (= fails step)
            )
            (case .while-clause
              (= passes resumed)
              (= fails done)
            )
            (case .until-clause
              (= passes done)
              (= fails resumed)
            )
          )
        )
      )
      (if (== passes no-block)
        (call refuse .refused-statement current)
        (return)
      )
      (let tested (call test expr (call emit-expression expr)))
      (call branch (. tested operand) passes fails)
      (call (. ir start-block) resumed)
      (= current (call first-tested next))
    )
  )
  (fn-do _ first-tested SyntaxId
    (param clause SyntaxId)
    ; A clause, or the first written after it, that is tested before a loop's body: one that is not
    ; a `whenever`. None where there is none.
    (if (== clause 0)
      (return 0)
    )
    (match? ([] (. tree nodes) clause)
      (case (call .node-clause row)
        (if (== (. row op) .whenever-clause)
          (return (call first-tested (. row next)))
        )
      )
    )
    (return clause)
  )
)
