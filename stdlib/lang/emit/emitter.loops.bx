      (call emit-yield body body false)
      (else-if (call (. tree gives-items) first body)
        (call give-item first (call (. facts feed-site) (. unit reading) first) (call state last first))
      )
      (else-if (!= body 0)
        (call emit-block body)
      )
    )
    (call close-turns turns)
    (call drop-bound named)
    (call drop-captures captured)
    (while (> (. loops length) depth)
      (call (. loops pop))
    )
    (for (in ended chain)
      (call forget-item ended)
