    (let pattern (call (. tree step-pattern) loop))
    (let result (if-expr (!= pattern 0) (call (. facts node-type) (. unit reading) pattern) no-type))
    (let made (call stream-maker loop))
    (let viewed (if-expr (!= made no-fact) (call next-call made) (call (. facts first-call) (. unit reading) loop)))
    (let commits (call next-call viewed))
    (let extends (call next-call commits))
    (let asks (call next-call extends))
    (if (or (== result no-type) (== result invalid-type) (== asks no-fact))
      (call refuse .refused-statement loop)
      (return (call Typed nothing no-type))
    )
    (let stream (call state (+ slot 1) loop))
    (let stream-type (. stream type))
    (let more (call call-protocol loop asks (. stream operand) stream-type nothing))
    (if (!= (. more type) (. types bool-type))
      (call refuse .refused-statement loop)
      (return (call Typed nothing no-type))
    )
    (let reading (call (. ir reserve-block)))
    (call branch (call compare loop .compare-not-equal (. more operand) (call integer .machine-u8 0)) reading done)
    (call (. ir start-block) reading)
    (let refills
      (scope (or (== made no-fact) chunked)
        (lazy chunked (call same-decl (call class-ref types stream-type) (. types chunked-token-stream-decl)))
      )
    )
    (let run (call view-stream loop (. stream operand) stream-type refills viewed extends))
    (let value (call attempt-arms loop pattern result run false commits done true))
    (return-if value (if (== (. value type) no-type)))
    (blank)
    (let moved (call (. ir reserve-block)))
    (let stuck (call (. ir reserve-block)))
    (call branch (call compare loop .compare-greater (call load-local attempt-end loop) (. run start)) moved stuck)
    (call (. ir start-block) stuck)
    (call raise-text loop "Grammar loop made no input progress")
    (call (. ir start-block) moved)
    (return value)
  )
