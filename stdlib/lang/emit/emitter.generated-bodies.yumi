_ GeneratedBodies is facet of FunctionEmitter
    sees Cleanups
    sees Styles
    sees Tables

────────────────────
+ do emit-event-registrations

` The function that puts the sections the classes of a module run from their tables in the
` event runtime's tables as the module starts, as the reference does at the head of the
` module's init: for each, the event's number, the function that says whether an object is of
` the class, the function that runs the section, and where it falls among the event's, in the
` order the tables took them, with `event-register-lowered-arrival` for one that hears only
` what arrives at its object. Then so for each group of a machine's event transitions run from
` those tables, which says it is a machine's.
for index in tables.lowered-order
    . handler = tables.lowered-functions[index]
    . row = facts.lowered-handlers[index]
    if handler == no-function || class-ref(types, row.type).module != function.module
        continue
    . matcher = tables.lowered-matchers[index]
    . mark = pending.length
    pending += integer(.machine-u64, tables.event-number(row.owner, row.name))
    ir.depend(.callee-function, matcher, 0)
    pending += make-operand(.operand-symbol, tables.functions[matcher].symbol)
    ir.depend(.callee-function, handler, 0)
    pending += make-operand(.operand-symbol, tables.functions[handler].symbol)
    pending += integer(.machine-u64, row.order)
    pending += integer(.machine-u8, 0)
    do call-instance(registrar, 0, mark)
        .. registrar = if row.arrives then facts.event-register-arrival else facts.event-register
for row in tables.machine-descriptors
    if class-ref(types, row.type).module != function.module
        continue
    . used = facts.event-uses[facts.machine-groups[row.group].event]
    . mark = pending.length
    pending += integer(.machine-u64, tables.event-number(used.owner, used.name))
    ir.depend(.callee-function, row.matcher, 0)
    pending += make-operand(.operand-symbol, tables.functions[row.matcher].symbol)
    ir.depend(.callee-function, row.descriptor, 0)
    pending += make-operand(.operand-symbol, tables.functions[row.descriptor].symbol)
    pending += integer(.machine-u64, 0)
    pending += integer(.machine-u8, 1)
    do call-instance(facts.event-register, 0, mark)
return-nothing()

────────────────────
+ do emit-style-registration

` The function that registers a style, which the reference makes for each style the program
` uses and calls at the head of the init of the style's module: where the runtime holds the
` style already it answers that; else it makes the style's record, makes the object whose
` properties give the style's first values, registers each property, base first, with its
` first value as the bits of a slot, whether that is none, its flags, the domains a change to
` it raises and which of its bits name boxed values, and registers the record by the style's
` number, which it answers. Each call is placed at the declaration of the constructor that
` first used the style.
. use = tables.style-uses[function.place]
. runtime = facts.style-runtime
. info-type = instances.signatures[runtime.register].returns
unit = unit.source-module = use.module
. site = use.site
returns-type = info-type
ir.returns = layout-of(info-type, site)
. key = type-key(types, use.type)
. mark = pending.length
pending += make-operand(.operand-constant, ir.add-string(key))
. existing = call-instance(runtime.info-for, site, mark)
. held = ir.reserve-block()
. making = ir.reserve-block()
branch(present(site, existing).operand, held, making)
ir.start-block(held)
return-value(payload(site, Typed(existing.operand, instances.signatures[runtime.info-for].returns)).operand, site)
ir.start-block(making)
mark = pending.length
pending += make-operand(.operand-constant, ir.add-string(key))
pending += make-operand(.operand-constant, ir.add-string(type-short-name(types, use.type)))
pending += integer(.machine-u64, use.count)
. info = call-instance(runtime.info, site, mark)
mark = pending.length
. made = call-instance(use.singleton, site, mark)
. object = tables.layouts.objects[use.type]
if object == no-layout
    refuse(.refused-function, site)
    =
for position in use.first .. < use.first + use.count
    . property = facts.style-properties[position]
    . field = tables.layouts.field(object, object-header-fields + property.slot)
    . value = take(made.operand, field, site)
    . none = integer(.machine-u8, 0)
    if types.is-optional(property.type)
        none = compare(site, .compare-equal, present(site, Typed(value, property.type)).operand, integer(.machine-u8, 0))
    . bits = style-bits(site, property.type, value)
    mark = pending.length
    pending += info.operand
    pending += integer(.machine-u64, position - use.first)
    pending += make-operand(.operand-constant, ir.add-string(property.name.text))
    pending += bits
    pending += none
    pending += integer(.machine-u32, property.flags)
    pending += integer(.machine-u32, tables.property-mask(position, false))
    pending += integer(.machine-u32, tables.property-mask(position, true))
    pending += integer(.machine-u32, property.wide-shift)
    pending += integer(.machine-u64, property.wide-tags)
    call-instance(runtime.register-property, site, mark)
mark = pending.length
pending += info.operand
pending += integer(.machine-i64, function.place)
. registered = call-instance(runtime.register, site, mark)
return-value(registered.operand, site)

────────────────────
+ do emit-sheet-registration

` The function that registers a style sheet, which the reference makes for each the program
` reads a slot of and calls at the head of the init of the sheet's module, after the styles it
` registers there: where the runtime holds the sheet already it answers that; else it makes the
` sheet's record, makes the object whose properties give the slots' first values, registers each
` slot with its first value as bits, whether that is none and its flags, and registers the
` record by the sheet's number, which it answers. Each call is placed at the declaration that
` first took the value of one of its slots.
. use = tables.style-sheet-uses[function.place]
. runtime = facts.style-runtime
. info-type = instances.signatures[runtime.sheet-register].returns
unit = unit.source-module = use.module
. site = use.site
returns-type = info-type
ir.returns = layout-of(info-type, site)
. key = type-key(types, use.type)
. mark = pending.length
pending += make-operand(.operand-constant, ir.add-string(key))
. existing = call-instance(runtime.sheet-info-for, site, mark)
. held = ir.reserve-block()
. making = ir.reserve-block()
branch(present(site, existing).operand, held, making)
ir.start-block(held)
return-value(payload(site, Typed(existing.operand, instances.signatures[runtime.sheet-info-for].returns)).operand, site)
ir.start-block(making)
mark = pending.length
pending += make-operand(.operand-constant, ir.add-string(key))
pending += make-operand(.operand-constant, ir.add-string(type-short-name(types, use.type)))
pending += integer(.machine-u64, use.count)
. info = call-instance(runtime.sheet-info, site, mark)
mark = pending.length
. made = call-instance(use.singleton, site, mark)
. object = tables.layouts.objects[use.type]
if object == no-layout
    refuse(.refused-function, site)
    =
for offset in 0 .. < use.count
    . slot = facts.sheet-slots[use.first + offset]
    . field = tables.layouts.field(object, object-header-fields + slot.slot)
    . value = take(made.operand, field, site)
    . none = integer(.machine-u8, 0)
    if types.is-optional(slot.type)
        none = compare(site, .compare-equal, present(site, Typed(value, slot.type)).operand, integer(.machine-u8, 0))
    . bits = style-bits(site, slot.type, value)
    mark = pending.length
    pending += info.operand
    pending += integer(.machine-u64, offset)
    pending += make-operand(.operand-constant, ir.add-string(slot.name.text))
    pending += bits
    pending += none
    pending += integer(.machine-u32, slot.flags)
    pending += integer(.machine-u32, runtime-domains(slot.domains))
    call-instance(runtime.sheet-register-slot, site, mark)
mark = pending.length
pending += info.operand
pending += integer(.machine-i64, function.place)
. registered = call-instance(runtime.sheet-register, site, mark)
. place = 0u32
. family [TypeId]
for member in facts.sheet-members
    if member.root == use.type
        place += 1
        family += member.type
        . found = family.find(types.base-of(member.type) ?? use.type)
        . parent = if found then (found as U32) + 1 else 0u32
        register-sheet-member(member, use, registered.operand, site, place, parent)
return-value(registered.operand, site)

────────────────────
_ do runtime-domains U32
    - domains U32

. mask = 0u32
for index in 0 .. < 32
    if (domains /and/ (1u32 /lshift/ index)) != 0
        mask = mask /or/ (1u32 /lshift/ (tables.domain-number(index as U32) as Size))
= mask

────────────────────
_ do register-sheet-member
    - member SheetMember
    - use PlacedStyle
    - info Operand
    - site SyntaxId
    - place U32
    - parent U32

. runtime = facts.style-runtime
. mark = pending.length
pending += info
pending += make-operand(.operand-constant, ir.add-string(type-key(types, member.type)))
pending += make-operand(.operand-constant, ir.add-string(type-short-name(types, member.type)))
pending += integer(.machine-u32, place)
pending += integer(.machine-u32, parent)
. record = call-instance(runtime.sheet-register-member, site, mark)
. ref = class-ref(types, member.type)
. owner = program.modules[ref.module]
match? owner.decls[ref.decl]
    | .decl-class(declared)
        match? owner.tree.nodes[declared.syntax]
            | .node-class-block(row)
                for offset in 0 .. < row.tags.count
                    mark = pending.length
                    pending += record.operand
                    pending += make-operand
                        - .operand-constant
                        - ir.add-string(owner.tree.atoms[row.tags.start + offset].text)
                    call-instance(runtime.sheet-member-tag, site, mark)
mark = pending.length
. made = call-instance(member.singleton, site, mark)
. object = tables.layouts.objects[member.type]
if object == no-layout
    refuse(.refused-function, site)
    =
for position in 0 .. < member.count
    . offset = facts.sheet-member-slots[member.first + position]
    . slot = facts.sheet-slots[use.first + offset]
    . field = tables.layouts.field(object, object-header-fields + slot.slot)
    . value = take(made.operand, field, site)
    . none = integer(.machine-u8, 0)
    if types.is-optional(slot.type)
        none = compare(site, .compare-equal, present(site, Typed(value, slot.type)).operand, integer(.machine-u8, 0))
    . bits = style-bits(site, slot.type, value)
    mark = pending.length
    pending += record.operand
    pending += integer(.machine-u64, offset)
    pending += bits
    pending += none
    call-instance(runtime.sheet-member-slot, site, mark)

────────────────────
+ do emit-storage-growth

` The function that grows the storage of tables of one type of row in their arena, which the
` reference names `cold-storage-rows` or `cold-storage-spill`: given a table's header, its
` arena's handle and incarnation, and for the rows the capacity it has and the rows needed, or
` for the outside bytes of a union's rows the bytes used, the capacity and the bytes needed. It
` grows them as `grow-rows` or `grow-spill` says, and answers the message of what failed, or
` nothing where nothing did.
. row = function.type
. count U32 = if function.place == 0 then 5 else 6
for position in 0 .. < count
    ir.add-argument(u64-layout)
ir.returns = managed-layout
. nothing = integer(.machine-u64, 0)
. meta = TableMeta
    - make-operand(.operand-argument, 0)
    - make-operand(.operand-argument, 1)
    - make-operand(.operand-argument, 2)
    - nothing
    - nothing
. first = make-operand(.operand-argument, 3)
. second = make-operand(.operand-argument, 4)
cold = true
if function.place == 0
    . row-layout = layout-of(row, 0)
    grow-rows(0, row, row-layout, meta, first, second)
else
    . place = tables.unions.of(row)
    if place == U32.max
        refuse-class(row)
    else
        grow-spill
            - 0
            - tables.unions.layouts[place]
            - meta
            - first
            - second
            - make-operand(.operand-argument, 5)
cold = false
return-value(num-cast(0, nothing, u64-layout, managed-layout), 0)

────────────────────
+ do emit-union-dispatch

` The function TypeScript makes for a member a union forwards, `union-dispatch-N`, placed
` where it is forwarded first and read with the facts typed there. It takes the union and the
` arguments written, and answers as the member made in place does. A row of a table of unions
` it takes is gathered there as the case it holds, its storage checked, and a case's member
` that runs on the row is given the row and the columns found then. Where the cases' calls
` let errors out it answers with them, as the type pass recorded. That of a setter takes the
` union and the value, sets the case the union holds, and answers nothing; one whose cases
` let errors out has no shape here.
. forward = facts.forwards[function.place]
unit = unit.reading = forward.instance
. id = forward.syntax
. object SyntaxId = 0
. name Atom? = null
match? tree.nodes[tables.forward-get(forward)]
    | .node-get-expression(read)
        object = read.object
        name = read.name
if forward.given != 0
    set-forwarded(id, object, forward)
    =
. operands = tables.forward-arguments(forward)
if operands.count != 0 || answer-count(id) != 0
    name = null
. whole = facts.node-type(unit.reading, object)
. union = if holds-row(whole) then table-row-type(whole) else whole
. type = facts.node-type(unit.reading, id)
. layout = layout-of(union, id)
ir.add-argument(layout-of(whole, id))
. position U32 = 1
for argument in tree.children[operands]
    . expression = tree.argument-value(argument)
    . given = facts.node-type(unit.reading, expression)
    ir.add-argument(layout-of(given, id))
    pin(expression, make-operand(.operand-argument, position), given)
    position += 1
returns-type = type
ir.returns = layout-of(type, id)
if forward.result != no-type
    return-results(forward.result, id)
. held = make-operand(.operand-argument, 0)
if holds-row(whole)
    held = table-row-item(id, held, whole).operand
    if takes-dispatch-row(id, whole)
        . row = make-operand(.operand-argument, 0)
        dispatch-columns = value-cursor(id, row, whole).columns
        dispatch-row = row
        dispatch-type = whole
. answer = dispatch-cases(id, object, operands, held, layout, type, name)
dispatch-type = no-type
if type == types.void-type && result-type == no-type
    return-nothing()
else
    return-value(answer.operand, id)

────────────────────
_ do takes-dispatch-row Bool
    - id SyntaxId
    - row TypeId

` Whether a case's member a union forwards from a row runs on the row.
. fact = facts.first-call(unit.reading, id)
while fact != no-fact
    . callee = facts.calls[fact].callee
    if answers-node(facts.calls[fact].form) && callee != no-instance && runs-on-row(callee, row)
        = true
    fact = facts.calls[fact].next
= false

────────────────────
_ do set-forwarded
    - id SyntaxId
    - object SyntaxId
    - forward ForwardFact

` The function made for a setter a union forwards: it takes the union and the value, and
` sets the case the union holds.
. union = facts.node-type(unit.reading, object)
. given = facts.node-type(unit.reading, forward.given)
ir.add-argument(layout-of(union, id))
ir.add-argument(layout-of(given, id))
pin(forward.given, make-operand(.operand-argument, 1), given)
returns-type = types.void-type
ir.returns = void-layout
. layout = layout-of(union, id)
if forward.result != no-type || !tables.layouts.is-union(layout)
    refuse(.refused-function, id)
set-cases(id, id, object, forward.given, make-operand(.operand-argument, 0), layout)
return-nothing()

────────────────────
+ do emit-interface-equality

` The function a witness table holds for equality, TypeScript's `InterfaceEquality`, which
` has no place of its own in a stack trace. It takes two values of the table's interface,
` both of the table's type, out of their boxes, and compares them as the type pass planned
` the comparison of two values of that type: by the `==` the type declares, by the machine,
` as one object, or part by part.
. compared = function.instance
. value = instances.rows[compared].self-type
. site = instances.rows[compared].subtree.start
. plan = facts.plan-of(unit.reading, site)
ir.add-argument(tables.layouts.interface-layout)
ir.add-argument(tables.layouts.interface-layout)
returns-type = types.bool-type
ir.returns = u8-layout
if plan != .plan-call && plan != .plan-fields && plan != .plan-identity && plan != .plan-builtin
    refuse-own()
    =
. layout = layout-of(value, 0)
field-call = facts.first-call(unit.reading, site)
field-site = site
if plan == .plan-call && (field-call == no-fact || uncompared)
    refuse-own()
    =
.. uncompared = !compares-pair(facts.calls[field-call].callee, value)
. left = unbox(0, value, make-operand(.operand-argument, 0))
. right = unbox(0, value, make-operand(.operand-argument, 1))
. differ = ir.reserve-block()
. joined = ir.reserve-block()
. whole = LayoutField(0, layout, value)
compare-pair(0, left.operand, whole, right.operand, whole, differ)
if field-call != no-fact
    refuse-own()
field-call = no-fact
field-site = 0
. same = ir.current
jump(joined)
ir.start-block(differ)
jump(joined)
ir.start-block(joined)
return-value(phi(u8-layout, integer(.machine-u8, 1), same, integer(.machine-u8, 0), differ), 0)

────────────────────
_ compares-pair Bool
    - callee InstanceId
    - value TypeId

` Whether a function is the `==` of two values of a type, called on the first with the
` second as it is, or as the type pass recorded converting it for the call.
callee != no-instance && instances.rows[callee].self-type == value && takes-argument(callee, value)

────────────────────
+ do emit-witness

` The function a slot of a witness table holds for a type with a function of its own. Its
` first argument is the interface value and the rest are the prototype's. It takes out
` what the value holds, as the type holds it, and calls the type's function with that and
` the arguments. A function of another type
` than the value's or a class it is derived from has no shape here, but one a
` property the type delegates to answers, called with what that property holds and chosen
` by the class of that object. An argument such a function takes as another type than the
` interface's gives is converted as the type pass recorded at the function's declaration.
` The call is made where the function is declared, the place a stack trace names, or where
` the interface declares its own where an argument is converted, as in the reference; one
` declared in another module has no shape then. An answer of another
` type than the interface's function gives is converted as the type pass recorded at that
` declaration. Where the interface's function raises errors, the answer is the value with
` no error for a type's function that raises none, and what the type's function answers
` for one that raises the same, or errors of classes below them, each then held as the
` nearest class above it that the interface's function raises, and its value converted as
` above. Where it raises none and the
` type carries errors of its own, as a generator that raises does, an error the type's
` function raises is a panic, with the error's text. A type's function that takes more
` arguments than the interface's is given the defaults of the rest, as a call that leaves
` them out is.
. row = tables.witness-functions[function.place]
. theirs = instances.signatures[row.proto]
if row.callee == no-instance
    emit-accessor(row)
    =
. mine = instances.signatures[row.callee]
. written = instances.rows[row.callee]
. fits = tables.instance-functions[row.callee] != no-function
if !fits || theirs.args.count > mine.args.count
    refuse-instance(row.callee)
    =
. forwards = mine.errors.count != 0
. panics = forwards && theirs.errors.count == 0 && carries-own-errors(types, row.value)
if panics
    forwards = false
if forwards && theirs.errors.count == 0
    refuse-instance(row.callee)
    =
. direct = written.self-type == row.value || derived-class
    .. derived-class = tables.is-class(row.value) && tables.derives(row.value, written.self-type)
if !direct && row.through.count == 0
    refuse-instance(row.callee)
    =
ir.add-argument(tables.layouts.interface-layout)
for position in 0 .. < theirs.args.count
    ir.add-argument(layout-of(instances.argument-type(row.proto, position), 0))
. converts = row.converts
. declared = instances.rows[row.proto]
if converts && (row.through.count == 0 || other-module || declared.subtree.count == 0)
    refuse-instance(row.callee)
.. other-module = declared.module != written.module
returns-type = theirs.returns
ir.returns = layout-of(returns-type, 0)
if theirs.errors.count != 0
    return-results(theirs.result, 0)
. kept = written.subtree.start + written.subtree.count - 1
. site = kept
if converts
    site = declared.subtree.start + declared.subtree.count - 1
. mark = pending.length
. taken = unbox(0, row.value, make-operand(.operand-argument, 0))
. reached = read-through(site, Typed(taken.operand, row.value), row.through)
pending += reached.operand
if row.through.count != 0 && unrelated-value
    refuse-instance(row.callee)
.. unrelated-value = reached.type != written.self-type && !is-derived(reached.type, written.self-type)
for position in 0 .. < theirs.args.count
    . own = make-operand(.operand-argument, position + 1)
    . wanted = instances.argument-type(row.callee, position)
    if instances.argument-type(row.proto, position) != wanted
        own = convert-recorded(row.callee, kept, .reason-argument, site, Typed(own, instances.argument-type(row.proto, position)), wanted).operand
    pending += own
. own-unit = unit
unit = unit.reading = row.callee
for position in theirs.args.count .. < mine.args.count
    . expected = instances.argument-type(row.callee, position)
    . argumented = default-argument(kept, row.callee, parameter-default(row.callee, position), expected)
    pending += argumented.operand
    if argumented.type != expected
        refuse(.refused-conversion, kept)
unit = own-unit
takes-result = forwards || panics
. answer = call-method(row.callee, site, mark, row.through.count == 0)
if panics
    answer = panic-on-error(site, row.callee, answer.operand)
if !forwards && theirs.returns != mine.returns
    answer = convert-recorded(row.callee, kept, .reason-return, site, answer, theirs.returns)
if forwards && theirs.result != mine.result
    return-recased
        - answer.operand
        - mine.result
        - site
        - if theirs.returns != mine.returns then row.callee else no-instance
        - kept
else if forwards
    return-held(answer.operand)
else if returns-type == types.void-type && result-type == no-type
    return-nothing()
else
    return-value(answer.operand, 0)

────────────────────
_ do emit-accessor
    - row WitnessFunction

` The function a slot of a witness table holds for a getter or a setter that a class
` answers with a property it stores: it reads the property of the object the interface
` value holds, or stores its argument there. A getter a tuple or a struct answers with a
` field reads it where the value was boxed. A getter a property the class delegates to
` answers reads the properties the type pass named to reach it first. A property that holds
` what the optional a getter answers holds is wrapped in it. A property of any other type
` than the getter answers or the setter is given has no shape here, no setter
` of a value that is no object has, and nor has a setter or a lazy property reached so.
. theirs = instances.signatures[row.proto]
. place = row.property
if theirs.args.count > 1 || theirs.errors.count != 0 || place >= types.properties.length
    refuse-class(row.value)
    =
. lent = row.through.count != 0
if lent && (theirs.args.count == 1 || types.properties[place].storage-kind != .storage-eager)
    refuse-class(row.value)
    =
if plain-value && (theirs.args.count == 1 || !tables.layouts.is-struct(layout-of(row.value, 0)))
    refuse-class(row.value)
    =
.. plain-value = !tables.is-class(row.value)
ir.add-argument(tables.layouts.interface-layout)
. object = load(make-operand(.operand-argument, 0), 0, managed-layout, 0)
if theirs.args.count == 1
    . given = instances.argument-type(row.proto, 0)
    ir.add-argument(layout-of(given, 0))
    if theirs.returns != types.void-type
        refuse-class(row.value)
    store-held(object, 0, row.value, place, make-operand(.operand-argument, 1), given, 0)
    return-nothing()
    =
returns-type = theirs.returns
ir.returns = layout-of(returns-type, 0)
. holder = read-through(0, Typed(object, row.value), row.through)
. answer = load-property(0, holder.operand, holder.type, types.properties[place].name, true, returns-type)
if answer.type != returns-type && wraps-value
    answer = wrap(0, answer, returns-type)
.. wraps-value = types.is-optional(returns-type) && types.optional-inner(returns-type) == answer.type
if answer.type != returns-type
    refuse-class(row.value)
    =
return-value(answer.operand, 0)
