━━━━━━━━━━━━━━━━━━━━
_ MatchArms is facet of FunctionEmitter
    sees Loops
    sees StateMachines
    sees Tables

_ switching = false
_ switched-subject Operand = 0
_ switched-value U64 = 0
_ refined-flag LocalId = no-local
_ refined-payload LocalId = no-local

────────────────────
+ do place-match Typed
    - id SyntaxId
    - pattern SyntaxId

` Where the struct a match with no subject answers lies, in an inlined body: its arms are tested
` in order, and the place the arm taken answers is the match's. Arms that end in no else have
` no shape here.
. nothing = make-operand(.operand-void, 0)
. type = facts.node-type(unit.reading, id)
. layout = layout-of(type, id)
if pattern == 0 || !tables.layouts.is-struct(layout)
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. joined = ir.reserve-block()
. mark = joins.length
. is-closed = emit-arms(id, pattern, type, joined, nothing, true)
if !is-closed
    refuse(.refused-expression, id)
. result = close-joins(joined, mark, layout, nothing)
= Typed(result, type)

────────────────────
_ do place-arm
    - body SyntaxId
    - type TypeId
    - joined IRBlockId

` Leaves the place the answer of an arm gives for its match, and goes to the join. A body
` written as a block runs its statements first, and one that opens a cleanup has no shape here.
. opens = is-block(body)
. mark = open-cleanups.length
. own-scoping = scoping
if opens
    scoping = scoping.block-base = mark
. last = ending(body)
if last == 0
    refuse(.refused-expression, body)
. place = make-operand(.operand-void, 0)
. answered = place-answer(last)
place = answered.operand
scoping = own-scoping
if open-cleanups.length != mark
    refuse(.refused-expression, body)
if answered.type != type
    refuse(.refused-conversion, body)
    =
joins += place
joins += make-operand(.operand-block, ir.current)
jump(joined)

────────────────────
_ do arm-leaves Bool
    - arm SyntaxId
    - body SyntaxId

` Whether an arm gives its match no value because what it gives is an error, which the type
` pass planned to leave the function at the arm. It is emitted here: the error is evaluated
` and raised, and what follows is never run. A panic given so has no shape here.
if facts.plan-of(unit.reading, arm) != .plan-raise
    = false
. expression = only-expression(body)
if expression == 0
    refuse(.refused-expression, body)
    = true
. raised = emit-expression(expression)
if !extends(raised.type, types.error-type) || extends(raised.type, types.panic-type)
    refuse(.refused-expression, expression)
    = true
leave-with(raised.operand, raised.type, arm)
ir.start-block(ir.reserve-block())
= true

────────────────────
+ do emit-match-statement Bool
    - body SyntaxId

` Emits `do match` of a subject, whose arms are run for what they do, and says whether the
` body of a `do` was one.
do match? tree.nodes[body]
    | .node-match-expression(row)
        if row.subject != 0 && helper-runs(row.helper)
            emit-subject-match(body, row.subject, row.body, row.is-optional, row.helper, true)
            = true
= false

────────────────────
+ helper-runs Bool
    - helper SyntaxId

` Whether a match runs as its subject's: one with no helper, or with one the type pass planned.
helper == 0 || plan == .plan-pattern-helper

.. plan = if helper != 0 then facts.plan-of(unit.reading, helper) else OperatorPlan.plan-none

────────────────────
+ do emit-subject-match Typed
    - id SyntaxId
    - subject SyntaxId
    - body SyntaxId
    - is-optional Bool
    - helper SyntaxId
    - is-statement Bool

` A match with a subject. The subject is evaluated once, and the arms are tried in the order
` written: each tests the subject against its pattern, and the first
` that matches gives the match its value, converted as the arms record for a side of its type. A
` struct is copied first, so nothing an arm runs changes what is matched. The arms may stand in a
` block with the lazy locals they read, which emit nothing there. Where no arm matches, `match`
` panics, `match?` and a match written on one line give an optional that holds nothing, and `do
` match?` goes on. The match `if` or `while` tests a pattern with gives false there. The arms after
` one that always matches are not emitted. With `is-statement` the arms are run for what they do and
` give no value. A stream pattern is run as `emit-stream-match` runs it, whose optional is that of
` `match?` too.
. nothing = make-operand(.operand-void, 0)
. pattern SyntaxId = 0
. inner = body
do match? tree.nodes[body]
    | .node-block(block)
        inner = 0
        for statement in tree.children[block.body]
            if !is-lazy-local(statement)
                inner = if inner == 0 then statement else body
do match? tree.nodes[inner]
    | .node-structure-match(arms)
        pattern = arms.pattern
    | .node-stream-match
        = emit-stream-match(id, subject, inner, helper, is-statement)
if pattern == 0
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. type = if is-statement then no-type else facts.node-type(unit.reading, id)
. given = if is-statement then no-type else facts.node-type(unit.reading, inner)
. layout = void-layout
if !is-statement
    if type == no-type || type == invalid-type || given == no-type || given == invalid-type
        refuse(.refused-expression, id)
        = Typed(nothing, no-type)
    layout = layout-of(type, id)
. value = emit-expression(subject)
. held = value.type
value = Typed(apart(value, subject, true), value.type)
. joined = ir.reserve-block()
. slot = if is-statement then nothing else join-slot(layout)
. mark = joins.length
. named = bound.length
. own-matching = matching
matching = matching.checks-row = facts.is-checked-row(unit.reading, subject)
matching = matching.checked-row = value.operand
matching = matching.checked-made = if matching.checks-row then made-row(value.operand) else U32.max
. proven = proven-item(subject)
if proven != U32.max && intrinsic(held) == .table-row
    made-rows += MadeRow
        - value.operand
        - TableCursor
            - proven-items[proven].columns
            - part(value.operand, layout-of(held, subject), 1, subject).operand
            - no-meta()
    matching = matching.checks-row = true
    matching = matching.checked-made = (made-rows.length - 1) as U32
matching = matching.case-subject = subject
. is-closed = match-arms(inner, pattern, value.operand, held, given, type, joined, slot)
matching = own-matching
drop-bound(named)
. absent = is-optional || facts.plan-of(unit.reading, inner) == .plan-unmatched-absent
if !is-closed
    if absent && is-statement
        jump(joined)
    else if absent
        arrive(id, empty-optional(type, layout).operand, joined, slot)
    else if facts.plan-of(unit.reading, inner) == .plan-open && !is-statement && type == types.bool-type
        arrive(id, integer(.machine-u8, 0), joined, slot)
    else if !function.may-panic || facts.plan-of(unit.reading, inner) != .plan-unmatched
        refuse(.refused-expression, id)
    else
        raise-text(first-arm(pattern), "Pattern match failed")
if is-statement
    ir.start-block(joined)
    = Typed(nothing, type)
if joins.length == mark && layout == void-layout
    ir.start-block(joined)
    = Typed(nothing, type)
. result = close-joins(joined, mark, layout, slot)
= Typed(result, type)

────────────────────
+ do emit-is Typed
    - id SyntaxId
    - lhs SyntaxId
    - rhs SyntaxId
    - negated Bool

` `is` or `is not` between a value and a pattern: whether the value matches the pattern, as
` an arm of a match tests it. Nothing is converted and no name is bound, and a pattern of
` items or of texts reads no rest. A pattern the type
` pass found can not match is never matched, and the value is evaluated all the same. A case
` of a state machine a property of a class holds is tested by the object's flag of the case,
` but where the tag is compared (`tests-tag`); one of a machine a module's property is, written
` on the property's name, by the flag alone, which the machine sets before its cases run. A value
` of a machine's union read from elsewhere is tested as `within-case` tests it.
. nothing = make-operand(.operand-void, 0)
. member = machine-of-union(facts.node-type(unit.reading, lhs)) if tree.nodes[rhs] is .node-symbol
if member && member.store == .store-member && !tests-tag() && reads-machine(lhs, member)
    . flag = member-flag(lhs, rhs, member)
    = Typed(if negated then compare(id, .compare-equal, flag.operand, integer(.machine-u8, 0)) else flag.operand, types.bool-type)
. value = Typed(nothing, no-type)
if member && member.store == .store-global && names-global(lhs, member)
    value = Typed(nothing, facts.node-type(unit.reading, lhs))
else
    value = emit-expression(lhs)
. yes = integer(.machine-u8, 1)
. no = integer(.machine-u8, 0)
. is-case = false
do match? tree.nodes[rhs]
    | .node-symbol
        is-case = true
    | .node-type-case
        is-case = true
if !is-case && facts.plan-of(unit.reading, rhs) == .plan-never
    = if negated then Typed(yes, types.bool-type) else Typed(no, types.bool-type)
. failed = ir.reserve-block()
. joined = ir.reserve-block()
. own-matching = matching
. named = bound.length
matching = matching.testing = true
matching = matching.tested = lhs
do match tree.nodes[rhs]
    | .node-symbol
        match-case(rhs, 0, value, failed)
    | .node-type-case(row)
        match-case(rhs, row.value, value, failed)
    | .node-type-list
        emit-pattern(rhs, value, failed)
    | .node-type-map
        emit-pattern(rhs, value, failed)
    | .node-type-and { facts.plan-of(unit.reading, rhs) == .plan-text-pattern }
        emit-pattern(rhs, value, failed)
    ??
        match-type(rhs, value, failed)
matching = own-matching
drop-bound(named)
. same = ir.current
jump(joined)
ir.start-block(failed)
jump(joined)
ir.start-block(joined)
= Typed(phi(u8-layout, if negated then no else yes, same, if negated then yes else no, failed), types.bool-type)

────────────────────
+ do reads-machine Bool
    - id SyntaxId
    - machine MachineFact

` Whether an expression reads a state machine itself, whose flags say which of its cases are
` active, rather than a value of its union read from elsewhere, which holds the one case the
` machine was in when it was read: the name alone of the module's property it is, the name of
` the local it is kept in or that a named machine written in a case of another declares, or
` the class's property it is, written after an object or alone.
if id == 0
    = false
if machine.store == .store-global
    = names-global(id, machine)
if machine.store == .store-member
    . property = decl-name(machine.module, machine.decl)
    do match? tree.nodes[id]
        | .node-get-expression(row)
            = property && row.name == property && !is-link(id)
        | .node-identifier(row)
            = property && row.name == property && resolves-member(id)
    = false
if machine.store != .store-local && machine.store != .store-nested
    = false
. row = bindings.machine-slots(machine.module, machine.syntax)
. binding = instances.rows[unit.reading].binding
if !row || row.bound == no-slot || binding == no-binding || !(tree.nodes[id] is .node-identifier)
    = false
. resolution = bindings.resolution-of(binding, id)
= resolution.kind == .resolve-slot && resolution.slot == row.bound

────────────────────
_ do within-cases [U32]
    - machine MachineFact
    - index U32

` The numbers of a state machine's case and of each case written in it, at any depth.
. machine-tree = program.modules[machine.module].tree
. items = machine-tree.state-items(machine-tree.state-body(machine.syntax))
. cases = machine-tree.machine-cases(items)
. found [U32]
if index >= cases.length as U32
    found += index
    = found
for position in 0 .. < cases.length
    if machine-tree.path-to(items, cases[position]).find(cases[index]) != null
        found += position as U32
= found

────────────────────
_ do pass-within
    - site SyntaxId
    - machine MachineFact
    - value Operand
    - index U32
    - failed IRBlockId

` Goes on where a value of a state machine's union read from elsewhere than the machine holds a
` case or a case written in it, as a case test of the machine finds the case active then, and
` leaves to `failed` where it holds another: the value holds the innermost case the machine was
` in when it was read.
. tag = load(value, 0, u8-layout, site)
. passed = ir.reserve-block()
for position in within-cases(machine, index)
    . next = ir.reserve-block()
    branch(compare(site, .compare-equal, tag, integer(.machine-u8, position)), passed, next)
    ir.start-block(next)
jump(failed)
fail-jumps += 1
ir.start-block(passed)

────────────────────
_ names-global Bool
    - id SyntaxId
    - machine MachineFact

` Whether a node is the name alone of the module's property a machine is.
|? !(tree.nodes[id] is .node-identifier) || machine.module != unit.source-module
    false
??
    resolution.kind == .resolve-global && resolution.decl == machine.decl

.. binding = instances.rows[unit.reading].binding
.. resolution = if binding != no-binding then bindings.resolution-of(binding, id) else Resolution(.resolve-none, 0)

────────────────────
_ do first-arm SyntaxId
    - pattern SyntaxId

` The arm written first of the arms of a match, where a match no arm matches panics.
do match? tree.nodes[pattern]
    | .node-type-or(row)
        = first-arm(row.left)
= pattern

────────────────────
+ do match-arms Bool ?! Refused
    - site SyntaxId
    - pattern SyntaxId
    - subject Operand
    - held TypeId
    - given TypeId
    - type TypeId
    - joined IRBlockId
    - slot Operand
    - raises SyntaxId = 0
    - alternative SyntaxId = 0

` Emits the arms of a match on a subject of type `held`, and says whether one that always
` matches ended them. An arm the type pass found can not match is passed over, as is one whose
` pattern names a case a refinement adds that no object reaches (`unreached-refined`), and an arm
` that raises a panic for whatever is left ends them. The arms of a loop's header declare
` the names their patterns write, as the header does; the body of an arm declares none.
` `given` is the
` type the arms join as and `type` the type of the match, an optional of it for `match?`;
` `given` is no type where the arms are run for what they do. An arm written with
` alternatives is an arm for each in turn, with the one body: `alternative` is the one
` tested. An arm that raises where its pattern matches is given the node that says so as
` `raises`. Whether an arm always matches is settled by its pattern, before its body, which
` may hold tests of its own, is emitted.
if alternative == 0 && raises == 0 && facts.plan-of(unit.reading, pattern) == .plan-switch
    = switch-arms(site, pattern, subject, held, given, type, joined, slot)
do match? tree.nodes[pattern]
    | .node-type-or(row)
        if match-arms(site, row.left, subject, held, given, type, joined, slot)
            = true
        if facts.plan-of(unit.reading, pattern) != .plan-present-after
            = match-arms(site, row.right, subject, held, given, type, joined, slot)
        . present = payload(site, Typed(subject, held))
        = match-arms
            - site
            - row.right
            - present.operand
            - types.optional-inner(held)
            - given
            - type
            - joined
            - slot
    | .node-type-transform(row)
        if facts.plan-of(unit.reading, pattern) == .plan-never
            = false
        . tested = if alternative != 0 then alternative else row.pattern
        if tested != 0
            do match? tree.nodes[tested]
                | .node-type-or(both)
                    if match-arms(site, pattern, subject, held, given, type, joined, slot, raises, both.left)
                        = true
                    = match-arms
                        - site
                        - pattern
                        - subject
                        - held
                        - given
                        - type
                        - joined
                        - slot
                        - raises
                        - both.right
        if alternative != 0 && facts.plan-of(unit.reading, alternative) == .plan-never
            = false
        if tested != 0 && unreached-refined(matching.case-subject, tested)
            = false
        . next = ir.reserve-block()
        . jumps = fail-jumps
        . named = bound.length
        . own-matching = matching
        matching = matching.arm-it = arm-slot-of(pattern, .slot-it)
        . passed = Typed(subject, held)
        if tested != 0
            passed = emit-pattern(tested, Typed(subject, held), next)
        switching = false
        . closes = fail-jumps == jumps
        arm-body(site, pattern, row.expr, passed, raises, given, type, joined, slot)
        matching = own-matching
        drop-bound(named)
        if closes
            = true
        ir.start-block(next)
        = false
    | .node-type-panic(row)
        do match? tree.nodes[row.pattern]
            | .node-type-transform(arm)
                if arm.expr != 0
                    = match-arms
                        - site
                        - row.pattern
                        - subject
                        - held
                        - given
                        - type
                        - joined
                        - slot
                        - pattern
        refuse(.refused-expression, pattern)
        = false
if facts.plan-of(unit.reading, pattern) == .plan-never || unreached-refined(matching.case-subject, pattern)
    = false
. next = ir.reserve-block()
. jumps = fail-jumps
. named = bound.length
. passed = emit-pattern(pattern, Typed(subject, held), next)
if given == no-type
    jump(joined)
else
    if passed.type != given
        passed = join(site, passed)
    if passed.type != given
        refuse(.refused-conversion, pattern)
    give-arm(site, passed, given, type, joined, slot)
drop-bound(named)
if fail-jumps == jumps
    = true
ir.start-block(next)
= false

────────────────────
_ do switch-arms Bool
    - site SyntaxId
    - pattern SyntaxId
    - subject Operand
    - held TypeId
    - given TypeId
    - type TypeId
    - joined IRBlockId
    - slot Operand

. arms [SyntaxId]
gather-arms(pattern, arms)
. cases = facts.constants[facts.constant-of(unit.reading, pattern)].bits == 1
. values [U64]
. owners [U32]
. fallback-arm SyntaxId = 0
for arm in arms
    . tested = arm-test(arm)
    if tested == 0
        fallback-arm = arm
        owners += U32.max
        continue
    . value = if cases then switch-case(tested) else switch-number(equality-expr(tested))
    . found = U32.max
    for position in 0 .. < values.length
        if values[position] == value
            found = position as U32
    if found == U32.max
        found = values.length as U32
        values += value
    owners += found
. discriminant = switch-subject(arm-test(arms[0]), subject, held, cases)
. fallback = ir.reserve-block()
. blocks [IRBlockId]
for _ in values
    blocks += ir.reserve-block()
switch(discriminant, fallback, values, blocks)
for bucket in 0 .. < values.length
    ir.start-block(blocks[bucket])
    if cases && share-bucket(site, arms, owners, bucket as U32, values[bucket], subject, held, given, type, joined, slot, fallback)
        continue
    . closed = false
    for position in 0 .. < arms.length
        if closed || owners[position] != bucket as U32
            continue
        switching = true
        switched-subject = subject
        switched-value = values[bucket]
        closed = match-arms(site, arms[position], subject, held, given, type, joined, slot)
        switching = false
    if !closed
        jump(fallback)
ir.start-block(fallback)
if fallback-arm != 0
    = match-arms(site, fallback-arm, subject, held, given, type, joined, slot)
= false

────────────────────
_ do arm-body
    - site SyntaxId
    - pattern SyntaxId
    - body SyntaxId
    - passed Typed
    - raises SyntaxId
    - given TypeId
    - type TypeId
    - joined IRBlockId
    - slot Operand

. own-matching = matching
matching = matching.declaring = false
if matching.arm-it != no-slot
    bound += BoundValue(matching.arm-it, passed.type, passed.operand)
if raises != 0
    raise-given(raises, body, pattern)
else if !arm-leaves(pattern, body)
    if given == no-type
        emit-block(body)
        jump(joined)
    else if !arm-raises(body)
        give-arm
            - site
            - arm-value(site, body, given, true, type, U32.max, operand-kind(slot) != .operand-void)
            - given
            - type
            - joined
            - slot
matching = own-matching

────────────────────
_ do share-bucket Bool
    - site SyntaxId
    - arms [SyntaxId]
    - owners [U32]
    - bucket U32
    - index U64
    - subject Operand
    - held TypeId
    - given TypeId
    - type TypeId
    - joined IRBlockId
    - slot Operand
    - fallback IRBlockId

if intrinsic(held) != .union
    = false
. members [SyntaxId]
. has-inner = false
for position in 0 .. < arms.length
    if owners[position] != bucket
        continue
    . tested = arm-test(arms[position])
    if tested == 0 || facts.plan-of(unit.reading, tested) != .plan-case
        = false
    has-inner = has-inner || case-inner(tested) != 0
    members += arms[position]
if members.length < 2
    = false
. layout = layout-of(held, site)
. field = tables.layouts.case-field(layout, index as U32)
if has-inner && (field.type == no-type || field.type == invalid-type)
    = false
. nothing = make-operand(.operand-void, 0)
. payload = if has-inner then take(subject, field, site) else nothing
. mark = match-steps.length
. sharing [SharedArm]
for arm in members
    . start = match-steps.length as U32
    . inner = case-inner(arm-test(arm))
    if inner != 0
        match-steps += MatchStep
            - .step-held
            - payload-part(inner, field.type)
            - payload
            - field.type
            - nothing
            - true
    sharing += settled(arm, start, subject, held)
shared-arms(site, sharing, given, type, joined, slot, fallback)
while match-steps.length > mark
    match-steps.pop()
= true

────────────────────
_ case-inner SyntaxId
    - pattern SyntaxId

match tree.nodes[pattern]
    | .node-type-case(row)
        row.value
    ??
        0

────────────────────
_ do payload-part SyntaxId
    - inner SyntaxId
    - held TypeId

do match? tree.nodes[inner]
    | .node-type-tuple(row)
        if row.field-types.count == 1 && intrinsic(held) != .tuple
            = tree.children[row.field-types.start]
= inner

────────────────────
_ transform-body SyntaxId
    - arm SyntaxId

match tree.nodes[arm]
    | .node-type-transform(row)
        row.expr
    ??
        0

────────────────────
_ do carry-steps
    - arm SharedArm
    - skipped U32

for position in arm.first + skipped .. < arm.first + arm.count
    match-steps += match-steps[position]

────────────────────
_ do shared-arms ?! Refused
    - site SyntaxId
    - arms [SharedArm]
    - given TypeId
    - type TypeId
    - joined IRBlockId
    - slot Operand
    - missed IRBlockId

. start Size = 0
while start < arms.length
    . next = ir.reserve-block()
    . head = step-head(arms[start])
    . end = start + 1
    if head != .head-none
        . shared = match-steps[arms[start].first].subject
        while end < arms.length && step-head(arms[end]) == head && match-steps[arms[end].first].subject == shared
            end += 1
    if end - start > 1
        . run [SharedArm]
        for position in start .. < end
            run += arms[position]
        if head == .head-case
            case-run(site, run, given, type, joined, slot, next)
        else if head == .head-tuple
            tuple-run(site, run, given, type, joined, slot, next)
        else
            list-run(site, run, given, type, joined, slot, next)
    else
        leaf-arm(site, arms[start], given, type, joined, slot, next)
    ir.start-block(next)
    start = end
jump(missed)

────────────────────
_ do step-head MatchHead
    - arm SharedArm

if arm.count == 0
    = .head-none
. step = match-steps[arm.first]
if step.kind != .step-held
    = .head-none
. kind = intrinsic(step.type)
do match? tree.nodes[step.pattern]
    | .node-type-case(row)
        . constant = facts.constant-of(unit.reading, step.pattern)
        if not-case-plan || kind != .union || constant == no-fact || machine-case
            = .head-none
        .. not-case-plan = facts.plan-of(unit.reading, step.pattern) != .plan-case
        .. machine-case = machine-of-union(step.type) != null
        . layout = layout-of(step.type, step.pattern)
        if !tables.layouts.is-union(layout)
            = .head-none
        . index = facts.constants[constant].bits
        if index >= tables.layouts.rows[layout].cases.count as U64
            = .head-none
        if row.value != 0
            . field = tables.layouts.case-field(layout, index as U32)
            if field.type == no-type || field.type == invalid-type
                = .head-none
        = .head-case
    | .node-type-tuple(row)
        if optional-step || kind == .union || is-row-source(kind) || !is-aggregate(step.type)
            = .head-none
        .. optional-step = types.is-optional(step.type)
        . layout = layout-of(step.type, step.pattern)
        if !tables.layouts.is-struct(layout) || too-few-fields
            = .head-none
        .. too-few-fields = tables.layouts.rows[layout].fields.count < row.field-types.count
        = .head-tuple
    | .node-type-list
        if not-list-plan || types.is-optional(step.type) || kind == .union || views-held
            = .head-none
        .. not-list-plan = facts.plan-of(unit.reading, step.pattern) != .plan-list-pattern
        .. views-held = reads-views(step.pattern, step.type)
        = .head-list
= .head-none

────────────────────
_ do case-run
    - site SyntaxId
    - arms [SharedArm]
    - given TypeId
    - type TypeId
    - joined IRBlockId
    - slot Operand
    - missed IRBlockId

. head = match-steps[arms[0].first]
. layout = layout-of(head.type, head.pattern)
. values [U64]
. owners [U32]
for arm in arms
    . index = facts.constants[facts.constant-of(unit.reading, match-steps[arm.first].pattern)].bits
    . found = U32.max
    for position in 0 .. < values.length
        if values[position] == index
            found = position as U32
    if found == U32.max
        found = values.length as U32
        values += index
    owners += found
. miss = ir.reserve-block()
. blocks [IRBlockId]
for _ in values
    blocks += ir.reserve-block()
switch(load(head.subject, 0, u8-layout, head.pattern), miss, values, blocks)
. nothing = make-operand(.operand-void, 0)
for bucket in 0 .. < values.length
    ir.start-block(blocks[bucket])
    . field = tables.layouts.case-field(layout, values[bucket] as U32)
    . payload = nothing
    for position in 0 .. < arms.length
        if owners[position] == bucket as U32 && inner-case
            payload = take(head.subject, field, head.pattern)
            break
        .. inner-case = case-inner(match-steps[arms[position].first].pattern) != 0
    . members [SharedArm]
    for position in 0 .. < arms.length
        if owners[position] != bucket as U32
            continue
        . arm = arms[position]
        . step = match-steps[arm.first]
        . inner = case-inner(step.pattern)
        . start = match-steps.length as U32
        . result = arm.result
        . result-type = arm.result-type
        if inner != 0
            match-steps += MatchStep
                - .step-held
                - payload-part(inner, field.type)
                - payload
                - field.type
                - nothing
                - step.carries
        else if step.carries
            result = head.subject
            result-type = head.type
        carry-steps(arm, 1)
        members += settled(arm.arm, start, result, result-type)
    shared-arms(site, members, given, type, joined, slot, missed)
ir.start-block(miss)
jump(missed)

────────────────────
_ do tuple-run
    - site SyntaxId
    - arms [SharedArm]
    - given TypeId
    - type TypeId
    - joined IRBlockId
    - slot Operand
    - missed IRBlockId

. head = match-steps[arms[0].first]
. layout = layout-of(head.type, head.pattern)
. nothing = make-operand(.operand-void, 0)
. fields [Operand]
. field-types [TypeId]
for _ in 0 .. < tables.layouts.rows[layout].fields.count
    fields += nothing
    field-types += no-type
. members [SharedArm]
for arm in arms
    . step = match-steps[arm.first]
    . start = match-steps.length as U32
    do match? tree.nodes[step.pattern]
        | .node-type-tuple(row)
            for position in 0 .. < row.field-types.count
                . part = tree.children[row.field-types.start + position]
                if tree.nodes[part] is .node-type-wildcard
                    continue
                if field-types[position] == no-type
                    fields[position] = take
                        - head.subject
                        - tables.layouts.field(layout, position)
                        - step.pattern
                    field-types[position] = field-type(head.type, position)
                match-steps += MatchStep
                    - .step-held
                    - part
                    - fields[position]
                    - field-types[position]
                    - nothing
    carry-steps(arm, 1)
    . result = if step.carries then head.subject else arm.result
    . result-type = if step.carries then head.type else arm.result-type
    members += settled(arm.arm, start, result, result-type)
shared-arms(site, members, given, type, joined, slot, missed)

────────────────────
_ do list-run
    - site SyntaxId
    - arms [SharedArm]
    - given TypeId
    - type TypeId
    - joined IRBlockId
    - slot Operand
    - missed IRBlockId

. head = match-steps[arms[0].first]
. length = list-length(head.pattern, head.subject, head.type, false, no-layout)
. nothing = make-operand(.operand-void, 0)
. start Size = 0
while start < arms.length
    . has-first = first-item(match-steps[arms[start].first].pattern) != 0
    . end = start + 1
    while end < arms.length && (first-item(match-steps[arms[end].first].pattern) != 0) == has-first
        end += 1
    . next = ir.reserve-block()
    . first = nothing
    . first-type = no-type
    . sharing = has-first && end - start > 1
    if sharing
        pass-or-fail
            - compare(head.pattern, .compare-greater-equal, length.operand, integer(.machine-u64, 1))
            - next
        . item = first-item(match-steps[arms[start].first].pattern)
        . read = read-part
            - item
            - call-at(item, .call-item-read)
            - head.subject
            - head.type
            - integer(.machine-u64, 0)
            - types.index-type
        first = read.operand
        first-type = read.type
    . members [SharedArm]
    for position in start .. < end
        . arm = arms[position]
        . step = match-steps[arm.first]
        . begin = match-steps.length as U32
        list-steps(step.pattern, head.subject, head.type, length.operand, first, first-type, sharing)
        carry-steps(arm, 1)
        . result = if step.carries then head.subject else arm.result
        . result-type = if step.carries then head.type else arm.result-type
        members += settled(arm.arm, begin, result, result-type)
    shared-arms(site, members, given, type, joined, slot, next)
    ir.start-block(next)
    start = end
jump(missed)

────────────────────
_ do first-item SyntaxId
    - pattern SyntaxId

do match? tree.nodes[pattern]
    | .node-type-list(row)
        if row.patterns.count != 0
            . item = tree.children[row.patterns.start]
            if !(tree.nodes[item] is .node-type-remainder)
                = item
= 0

────────────────────
_ do list-steps
    - pattern SyntaxId
    - list Operand
    - type TypeId
    - length Operand
    - first Operand
    - first-type TypeId
    - sharing Bool

do match? tree.nodes[pattern]
    | .node-type-list(row)
        . count = row.patterns.count
        . rest = count
        for position in 0 .. < count
            if tree.nodes[tree.children[row.patterns.start + position]] is .node-type-remainder
                rest = position
        . fixed = if rest == count then count else count - 1
        if sharing
            match-steps += MatchStep
                - .step-held
                - tree.children[row.patterns.start]
                - first
                - first-type
                - length
        if !sharing || rest == count || fixed > 1
            match-steps += MatchStep
                - .step-length
                - pattern
                - list
                - type
                - length
                - false
                - fixed
                - 0
                - rest == count
        . opening U32 = if sharing then 1 else 0
        if opening < rest
            for position in opening .. < rest
                match-steps += MatchStep
                    - .step-item
                    - tree.children[row.patterns.start + position]
                    - list
                    - type
                    - length
                    - false
                    - position
        if rest + 1 < count
            for position in rest + 1 .. < count
                match-steps += MatchStep
                    - .step-from-end
                    - tree.children[row.patterns.start + position]
                    - list
                    - type
                    - length
                    - false
                    - position
                    - count - position
        if rest != count && !matching.testing && has-name(tree.children[row.patterns.start + rest])
            match-steps += MatchStep
                - .step-rest
                - tree.children[row.patterns.start + rest]
                - list
                - type
                - length
                - false
                - rest
                - count - rest - 1

────────────────────
_ do leaf-arm
    - site SyntaxId
    - arm SharedArm
    - given TypeId
    - type TypeId
    - joined IRBlockId
    - slot Operand
    - missed IRBlockId

. named = bound.length
. own-matching = matching
matching = matching.arm-it = arm-slot-of(arm.arm, .slot-it)
. last = arm.first + arm.count
for position in arm.first .. < last
    . step = match-steps[position]
    if step.kind == .step-length
        . wanted = integer(.machine-u64, step.position)
        pass-or-fail
            - compare
                - step.pattern
                - if step.exact then .compare-equal else .compare-greater-equal
                - step.length
                - wanted
            - missed
. result = arm.result
. result-type = arm.result-type
for position in arm.first .. < last
    . step = match-steps[position]
    if step.kind == .step-length
        continue
    if step.kind == .step-rest
        . end = step.length
        if step.back != 0
            end = arithmetic
                - step.pattern
                - .arithmetic-subtract
                - step.length
                - integer(.machine-u64, step.back)
                - u64-layout
        match-rest
            - step.pattern
            - step.subject
            - step.type
            - integer(.machine-u64, step.position)
            - end
            - false
            - missed
        continue
    . value = Typed(step.subject, step.type)
    if step.kind != .step-held
        . index = integer(.machine-u64, step.position)
        if step.kind == .step-from-end
            index = arithmetic
                - step.pattern
                - .arithmetic-subtract
                - step.length
                - integer(.machine-u64, step.back)
                - u64-layout
        . read = read-part
            - step.pattern
            - call-at(step.pattern, .call-item-read)
            - step.subject
            - step.type
            - index
            - types.index-type
        value = read
    . passed = emit-pattern(step.pattern, value, missed)
    if step.carries
        result = passed.operand
        result-type = passed.type
arm-body(site, arm.arm, transform-body(arm.arm), Typed(result, result-type), 0, given, type, joined, slot)
matching = own-matching
drop-bound(named)

────────────────────
_ do gather-arms
    - pattern SyntaxId
    - arms [SyntaxId]

do match? tree.nodes[pattern]
    | .node-type-or(row)
        gather-arms(row.left, arms)
        gather-arms(row.right, arms)
        =
arms += pattern

────────────────────
_ arm-test SyntaxId
    - arm SyntaxId

match tree.nodes[arm]
    | .node-type-transform(row)
        if row.pattern == 0 || tree.nodes[row.pattern] is .node-type-wildcard then 0 else row.pattern
    ??
        0

────────────────────
_ switch-case U64
    - pattern SyntaxId

facts.constants[facts.constant-of(unit.reading, pattern)].bits

────────────────────
_ equality-expr SyntaxId
    - pattern SyntaxId

match tree.nodes[pattern]
    | .node-type-equality(row)
        row.expr
    ??
        0

────────────────────
_ switch-number U64
    - expr SyntaxId

match tree.nodes[expr]
    | .node-integer-syntax(row)
        parse-integer-literal(row.value).value
    ??
        U64.max

────────────────────
_ do switch-subject Operand
    - pattern SyntaxId
    - subject Operand
    - held TypeId
    - cases Bool

if !cases
    = subject
. kind = intrinsic(held)
if kind == .table-row || kind == .immutable-table-row
    . located = subject-place(pattern, subject, held)
    = load(table-cell(pattern, located.columns, located.index, 0, u8-layout), 0, u8-layout, pattern)
= load(subject, 0, u8-layout, pattern)

────────────────────
+ do arm-value Typed
    - site SyntaxId
    - body SyntaxId
    - type TypeId
    - guards Bool = false
    - whole TypeId = no-type
    - remade U32 = U32.max
    - in-place Bool = false

` The value of the body of an arm, converted as the arms record for a side of its type. With
` `guards` an error is a value where the type of the match holds it, and has no shape where
` that type carries errors. A side the arms record a conversion for straight to the type of the
` match, `whole`, arrives as that. A body written as a block is a block of its own: the
` cleanups opened in it run where it ends. A value a helper makes again, `remade`, is what
` `remake` makes of the body's. With `in-place` the value is copied where the arms join as soon
` as it is read, so a struct is read from where it lies.
. opens = is-block(body)
. mark = open-cleanups.length
. own-scoping = scoping
if opens
    scoping = scoping.block-base = mark
. expression = ending(body)
if expression == 0
    refuse(.refused-expression, body)
    scoping = own-scoping
    = Typed(make-operand(.operand-void, 0), no-type)
. own-matching = matching
if in-place
    matching = matching.read-in-place = expression
. value = emit-expression(expression)
matching = own-matching
if remade != U32.max
    value = remake(site, remade, value.operand, value.type)
if guards && extends(value.type, types.error-type) && carries-error(type)
    refuse(.refused-expression, expression)
if value.type != type
    value = join(site, value)
if value.type != type && value.type != whole
    refuse(.refused-conversion, expression)
= if opens then close-value(value, mark, own-scoping, body) else value

────────────────────
+ is-block Bool
    - body SyntaxId

match tree.nodes[body]
    | .node-block
        true
    ??
        false

────────────────────
_ do give-arm
    - site SyntaxId
    - value Typed
    - given TypeId
    - type TypeId
    - joined IRBlockId
    - slot Operand

` Leaves the value of an arm for its match: as it is, held by the optional `match?` gives, or
` converted to the type the match was asked for as the arms record for the type they join
` as. One that arrived in the type of the match already is left as it is.
. left = value
if type != given && left.type != type
    left = if types.optional-inner(type) == given then wrap(site, Typed(value.operand, given), type) else join(site, Typed(value.operand, given))
arrive(site, left.operand, joined, slot)

────────────────────
_ do bind-case-cursor
    - name SyntaxId
    - row Operand
    - type TypeId
    - place U32
    - case-index U32
    - located TableCursor

` Gives a name a pattern declares the case of a row of a table of unions it matched: the name
` stands for the row's cells. A name that nested functions capture, or a declaration's, has
` no shape here.
if matching.testing
    =
. binding = instances.rows[unit.reading].binding
if binding == no-binding || unit.reading != unit.instance || matching.declaring
    refuse(.refused-expression, name)
    =
. resolution = bindings.resolution-of(binding, name)
if resolution.kind != .resolve-slot
    refuse(.refused-expression, name)
    =
. held = bindings.slots[resolution.slot]
if held.kind != .slot-pattern || is-captured(resolution.slot)
    refuse(.refused-expression, name)
    =
. case-type = tables.unions.cases[tables.unions.layouts[place].cases.start + case-index].type
. offset = slot-offset(resolution.slot, name)
if facts.slot-type(unit.instance, offset) != case-type
    refuse(.refused-conversion, name)
    =
bound += BoundValue(resolution.slot, case-type, row, case-cursors.length as U32)
. checked = matching.checks-row && row == matching.checked-row
case-cursors += CaseCursor(row, type, place, case-index, checked, located.columns, located.index)

────────────────────
+ do case-cursor-of U32
    - object SyntaxId

` The case of a row a name read as an object stands for, or `U32.max` where it stands for none.
do match? tree.nodes[object]
    | .node-identifier
        . binding = instances.rows[unit.reading].binding
        if binding == no-binding || unit.reading != unit.instance
            = U32.max
        . resolution = bindings.resolution-of(binding, object)
        if resolution.kind != .resolve-slot
            = U32.max
        . position = bound.length
        while position != 0
            position -= 1
            if bound[position].slot == resolution.slot
                = bound[position].cursor
= U32.max

────────────────────
+ do gather-cursor Typed
    - id SyntaxId
    - cursor U32
    - type TypeId

` The case a name stands for, gathered from its row's cells where the name is used as a value.
. nothing = make-operand(.operand-void, 0)
. held = case-cursors[cursor]
. case-type = tables.unions.cases[case-base + held.case-index].type
    .. case-base = tables.unions.layouts[held.place].cases.start
if type != case-type
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. found = gathered-at(cursor)
if found != U32.max
    = Typed(case-gathers[found].value, case-type)
. located = case-place(id, held)
. made = gather-union-case(id, held.place, held.case-index, located.columns, located.index)
case-gathers += CaseGather(cursor, made.operand, ir.current)
= Typed(made.operand, case-type)

────────────────────
_ do gathered-at U32
    - cursor U32

` Where among `case-gathers` the newest gather of the case a name stands for that dominates
` the block being emitted is, or `U32.max` where none does. In the body of a loop with a
` header only one made in the same block does, as TypeScript, which joins the blocks of such a
` loop to the function only once its body is emitted, finds no other to dominate there.
. headed = in-headed-loop()
. position = case-gathers.length
while position != 0
    position -= 1
    . kept = case-gathers[position]
    if kept.cursor == cursor && (kept.block == ir.current || dominated)
        = position as U32
    .. dominated = !headed && ir.dominates(kept.block, ir.current)
= U32.max

────────────────────
_ do in-headed-loop Bool

` Whether the body of a loop with a header is being emitted: any loop but a `while`.
for loop in loops
    do match? tree.nodes[loop.syntax]
        | .node-while-block
            continue
    = true
= false

────────────────────
+ do case-field UnionField?
    - cursor U32
    - name Atom

` The field of the case a name stands for that a name reads, where the case stores one.
. held = case-cursors[cursor]
. union = tables.unions.layouts[held.place]
. kept = tables.unions.cases[union.cases.start + held.case-index]
. found = types.property-named(kept.type, name)
if !found
    = null
. slot = types.properties[found].slot
for position in 0 .. < kept.fields.count
    . field = tables.unions.fields[kept.fields.start + position]
    if field.slot == slot
        = field
= null

────────────────────
_ do case-row TableCursor
    - id SyntaxId
    - cursor U32

` The row of the case a name stands for, its table checked again where it grows.
= case-place(id, case-cursors[cursor])

────────────────────
+ do case-place TableCursor
    - id SyntaxId
    - held CaseCursor

` Where the row of a case is read: the columns its subject `t[i]` found, with no metadata, or
` else those of the row's value, its table checked again where it grows.
if held.checked
    = TableCursor(held.columns, held.index, no-meta())
= value-cursor(id, held.row, held.type)

────────────────────
_ do subject-place TableCursor
    - id SyntaxId
    - row Operand
    - type TypeId

` Where the row a pattern tests is read: the columns and the index the subject `t[i]` of the
` match found and checked, as TypeScript reads its cursor, and else those of the row's value,
` its table checked again where it grows.
if matching.checks-row && row == matching.checked-row && matching.checked-made != U32.max
    . cursor = made-rows[matching.checked-made].cursor
    = TableCursor(cursor.columns, cursor.index, no-meta())
= value-cursor(id, row, type)

────────────────────
_ do case-cell Operand
    - id SyntaxId
    - cursor U32
    - located TableCursor
    - field UnionField
    - stored LayoutField

` Where the row of the case a name stands for keeps a field.
. held = case-cursors[cursor]
. handle = integer(.machine-u32, 0)
if field.region == .region-external
    handle = union-handle(id, held.place, located.columns, located.index)
= union-cell(id, held.place, located.columns, located.index, field, stored.layout, handle)

────────────────────
_ do case-stored LayoutField
    - id SyntaxId
    - cursor U32
    - field UnionField

` How the case a name stands for holds a field it keeps in its row.
. held = case-cursors[cursor]
. case-type = tables.unions.cases[case-base + held.case-index].type
    .. case-base = tables.unions.layouts[held.place].cases.start
. case-layout = layout-of(case-type, id)
= tables.layouts.field(case-layout, field.slot)

────────────────────
+ do emit-case-field Typed
    - id SyntaxId
    - cursor U32
    - field UnionField

` A field of the case of a row a name stands for, read from its cell, or from what was gathered
` of the case where that dominates. Where the type pass knows an optional field to hold a
` value, the read is of what it holds, with no test, as a property's is.
. stored = case-stored(id, cursor, field)
. narrowed = !is-link(id) && holds(stored.type, facts.node-type(unit.reading, id))
. read = make-operand(.operand-void, 0)
. found = gathered-at(cursor)
if found != U32.max
    read = take(case-gathers[found].value, stored, id)
else
    . located = case-row(id, cursor)
    . cell = case-cell(id, cursor, located, field, stored)
    read = take(cell, LayoutField(0, stored.layout, stored.type), id)
if narrowed
    = payload(id, Typed(read, stored.type))
= Typed(read, stored.type)

────────────────────
+ do emit-case-field-assign Assignment
    - id SyntaxId
    - op Operator
    - lhs SyntaxId
    - cursor U32
    - field UnionField
    - rhs SyntaxId

` A field of the case of a row a name stands for written in its cell, as TypeScript writes it:
` the value is read, converted to the field's type and stored; where the table grows the
` table is checked first and its mutation generation counted on after, unless the row's
` storage was checked where the case was read. An assigning operator reads the field through
` the row first. A row of a finished table is not written.
if intrinsic(case-cursors[cursor].type) != .table-row
    refuse(.refused-statement, id)
    = Assignment()
. given = Typed(make-operand(.operand-void, 0), no-type)
. increment = increment-base(op)
if op == .eq-op
    given = emit-expression(rhs)
else if increment && facts.plan-of(unit.reading, id) == .plan-builtin
    given = emit-builtin(id, increment, lhs, rhs, true)
else
    refuse(.refused-statement, id)
. stored = case-stored(lhs, cursor, field)
. value = convert(id, .reason-assignment, given)
if value.type != stored.type
    refuse(.refused-conversion, rhs)
. located = case-row(lhs, cursor)
. cell = case-cell(lhs, cursor, located, field, stored)
store-row-cell(lhs, cell, stored.layout, value.operand, located.meta)
if !case-cursors[cursor].checked
    invalidate-marks(lhs, located.meta)
= Assignment(Typed(value.operand, stored.type), given)

────────────────────
+ do pass-or-fail
    - tested Operand
    - failed IRBlockId

` Goes on where a test of a pattern holds, and leaves to `failed` where it does not.
. passed = ir.reserve-block()
branch(tested, passed, failed)
fail-jumps += 1
ir.start-block(passed)

────────────────────
+ names-type Bool
    - pattern SyntaxId

` Whether a pattern is a type named and no more.
match tree.nodes[pattern]
    | .node-type-identifier
        true
    | .node-type-arguments
        true
    | .node-type-optional
        true
    ??
        false

────────────────────
+ do emit-pattern Typed ?! Refused
    - pattern SyntaxId
    - value Typed
    - failed IRBlockId

` Tests a value against a pattern, and gives what the pattern passes on where it matches, with its
` type. Where it does not match nothing panics: `failed` is where it leaves to. A name the pattern
` declares is bound to what it captured. A pattern the type pass planned nothing for has no shape
` here.
. nothing = make-operand(.operand-void, 0)
if pattern == 0
    = value
do match? tree.nodes[pattern]
    | .node-type-wildcard
        = value
    | .node-type-identifier
        = match-type(pattern, value, failed)
    | .node-type-arguments
        = match-type(pattern, value, failed)
    | .node-type-optional
        = match-type(pattern, value, failed)
    | .node-type-match(row)
        if names-type(row.type)
            = match-type(row.type, value, failed)
        = emit-pattern(row.type, value, failed)
    | .node-type-capture(row)
        . passed = value
        if row.type != 0 && names-type(row.type)
            passed = match-type(row.type, value, failed)
        else if row.type != 0
            passed = emit-pattern(row.type, value, failed)
        bind-name(row.id, passed)
        = passed
    | .node-type-and(row)
        if facts.plan-of(unit.reading, pattern) == .plan-text-pattern
            = match-text(pattern, value, failed)
        . left = emit-pattern(row.left, value, failed)
        = emit-pattern(row.right, left, failed)
    | .node-type-equality(row)
        = match-equal(pattern, row.expr, value, failed)
    | .node-type-predicate(row)
        = match-predicate(pattern, row.expr, value, failed)
    | .node-type-case(row)
        = match-case(pattern, row.value, value, failed)
    | .node-type-tuple(row)
        = match-fields(pattern, row.field-types, value, failed)
    | .node-type-property(row)
        = match-property(pattern, row.name, value)
    | .node-type-list(row)
        if facts.plan-of(unit.reading, pattern) == .plan-list-pattern
            = match-items(pattern, row.patterns, value, failed)
        = match-type(pattern, value, failed)
    | .node-type-map(row)
        if facts.plan-of(unit.reading, pattern) == .plan-map-pattern
            = match-keys(pattern, row.patterns, value, failed)
        = match-type(pattern, value, failed)
    | .node-identifier
        bind-name(pattern, value)
        = value
refuse(.refused-expression, pattern)
= Typed(nothing, no-type)

────────────────────
_ do match-property Typed
    - pattern SyntaxId
    - name Atom
    - value Typed

` A pattern that reads a name from what it is given, as the type pass recorded the read at
` the pattern: it always matches, passes what the name gives, and binds the name to that
` where the pattern declares one.
. mark = pins.length
pin(pattern, value.operand, value.type)
. read = emit-get(pattern, pattern, name)
unpin(mark)
. binding = instances.rows[unit.reading].binding
if binding != no-binding && bindings.resolution-of(binding, pattern).kind == .resolve-slot
    bind-name(pattern, read)
= read

────────────────────
_ do pattern-row FactId
    - pattern SyntaxId
    - source TypeId

` The conversion the type pass recorded at a type named as a pattern for a value of a type
` given to it whole, or none.
. fact = facts.first-conversion(unit.reading, pattern)
while fact != no-fact
    . row = facts.conversions[fact]
    if row.reason == .reason-pattern && row.guard == U32.max && row.from == source
        = fact
    fact = row.next
= no-fact

────────────────────
+ do match-type Typed
    - pattern SyntaxId
    - value Typed
    - failed IRBlockId

` A type named as a pattern, as the type pass planned it. A value the pattern has a
` conversion for is tested where the conversion can fail, and converted. An optional it has
` none for is tested for a value, and matched as what it holds. A union it has none for is
` matched by its cases.
. nothing = make-operand(.operand-void, 0)
. held = value
if pattern-row(pattern, held.type) == no-fact && types.is-optional(held.type)
    . type = held.type
    . tested = present(pattern, held)
    pass-or-fail(tested.operand, failed)
    held = payload(pattern, Typed(held.operand, type))
. whole = pattern-row(pattern, held.type)
if whole != no-fact
    = pass-leaf(pattern, facts.conversions[whole], held, failed)
if intrinsic(held.type) != .union
    refuse(.refused-conversion, pattern)
    = Typed(nothing, no-type)
= match-cases(pattern, held, failed)

────────────────────
_ do match-cases Typed
    - pattern SyntaxId
    - value Typed
    - failed IRBlockId

` A union matched by its cases: each case the type pass recorded a conversion for is tested
` in turn, and what it holds is converted. An optional a case holds is tested for a value
` first. A union that holds any other case does not match. A pattern that only tests passes
` the union itself.
. nothing = make-operand(.operand-void, 0)
. union = value.type
. layout = layout-of(value.type, pattern)
. target = no-type
. fact = facts.first-conversion(unit.reading, pattern)
while fact != no-fact
    . row = facts.conversions[fact]
    if row.reason == .reason-pattern && row.guard != U32.max && target == no-type
        target = row.to
    fact = row.next
if target == no-type || !tables.layouts.is-union(layout)
    refuse(.refused-conversion, pattern)
    = Typed(nothing, no-type)
. result = layout-of(target, pattern)
. joined = ir.reserve-block()
. slot = join-slot(result)
. mark = joins.length
fact = facts.first-conversion(unit.reading, pattern)
while fact != no-fact
    . row = facts.conversions[fact]
    fact = row.next
    if row.reason != .reason-pattern || row.guard == U32.max
        continue
    if row.guard >= tables.layouts.rows[layout].cases.count || row.to != target
        refuse(.refused-conversion, pattern)
        continue
    . matched = ir.reserve-block()
    . missed = ir.reserve-block()
    branch(case-test(pattern, value.operand, row.guard), matched, missed)
    ir.start-block(matched)
    . field = tables.layouts.case-field(layout, row.guard)
    . inner = Typed(take(value.operand, field, pattern), field.type)
    if types.is-optional(field.type) && row.from != field.type
        . tested = present(pattern, inner)
        pass-or-fail(tested.operand, failed)
        inner = payload(pattern, inner)
    . passed = pass-leaf(pattern, row, inner, failed)
    if matching.testing
        jump(joined)
    else
        arrive(pattern, passed.operand, joined, slot)
    ir.start-block(missed)
jump(failed)
fail-jumps += 1
if matching.testing
    ir.start-block(joined)
    = Typed(value.operand, union)
. passed = close-joins(joined, mark, result, slot)
= Typed(passed, target)

────────────────────
_ do pass-leaf Typed
    - pattern SyntaxId
    - row ConversionFact
    - value Typed
    - failed IRBlockId

` Converts a value as a type named as a pattern records, where the value passes the test the
` conversion's kind makes: a union holds the case, an object is of the class. A value that
` fails it does not match. A union matches text only where it holds the case the type pass
` picked for text, though cast to text it gives the text of any case. A case that holds text
` gives its text as it is, and any other case is cast to text. A value of an
` interface is of the type it holds. TypeScript never matches a value that is no object cast
` up. A value already of the type asked for passes as it is, but an object tested for its
` class alone, which may be of a class derived from the one it is known by.
if row.from != value.type
    refuse(.refused-conversion, pattern)
    = value
. kind = row.kind
. exact = facts.plan-of(unit.reading, pattern) == .plan-exact-class
if kind == .relation-same && row.from == row.to
    if exact && tables.is-class(row.to)
        = exact-class-pass(pattern, value, failed)
    = value
. objects = tables.is-class(row.from) && tables.is-class(row.to)
if kind == .relation-illegal || (kind == .relation-up-cast && !objects)
    refuse(.refused-conversion, pattern)
    = value
if kind == .relation-unwrap-cast && intrinsic(row.from) == .union && row.to == types.string-type
    if row.case-index == U32.max
        refuse(.refused-conversion, pattern)
        = value
    pass-or-fail(case-test(pattern, value.operand, row.case-index), failed)
    if matching.testing
        = Typed(value.operand, row.from)
    . layout = layout-of(row.from, pattern)
    . field = tables.layouts.case-field(layout, row.case-index)
    if field.type == types.string-type
        = Typed(take(value.operand, field, pattern), field.type)
. tests = kind == .relation-unwrap-cast || kind == .relation-down-cast || interface-cast
    .. interface-cast = kind == .relation-interface-down-cast
if matching.testing && !tests
    = value
. own-matching = matching
matching = matching.failing = failed
matching = matching.exact-class = exact
. passed = convert-one(pattern, row, value)
matching = own-matching
= passed

────────────────────
_ do exact-class-pass Typed
    - pattern SyntaxId
    - value Typed
    - failed IRBlockId

` An object tested for the class it is known by alone: it passes as it is where it is of that
` class, and does not match where it is of one derived from it.
. own-matching = matching
matching = matching.exact-class = true
. passed = ir.reserve-block()
class-branch(pattern, value.operand, value.type, passed, failed)
fail-jumps += 1
matching = own-matching
ir.start-block(passed)
= value

────────────────────
_ do match-equal Typed
    - pattern SyntaxId
    - expr SyntaxId
    - value Typed
    - failed IRBlockId

` An equality pattern: its subject is compared with a value by the plan of `==` the type pass
` recorded at the pattern, whose node stands for the subject. The pattern passes its subject.
. nothing = make-operand(.operand-void, 0)
. type = value.type
if switching && value.operand == switched-subject && switch-number(expr) == switched-value
    switching = false
    = value
. pin-mark = pins.length
pin(pattern, value.operand, type)
. tested = emit-binary(pattern, .equals-op, pattern, expr)
unpin(pin-mark)
pass-or-fail(tested.operand, failed)
= Typed(value.operand, type)

────────────────────
_ do match-predicate Typed
    - pattern SyntaxId
    - expr SyntaxId
    - value Typed
    - failed IRBlockId

` A pattern that is a condition: `it` is what the pattern is given while the condition is
` evaluated, and the pattern passes that where the condition tests as true.
. nothing = make-operand(.operand-void, 0)
. type = value.type
. slot = arm-slot-of(pattern, .slot-it)
if slot == no-slot
    slot = matching.arm-it
if slot == no-slot
    slot = it-read(expr)
. named = bound.length
if slot != no-slot
    bound += BoundValue(slot, type, value.operand)
. tested = test(expr, emit-expression(expr))
drop-bound(named)
pass-or-fail(tested.operand, failed)
= Typed(value.operand, type)

────────────────────
_ do it-read SlotId
    - expr SyntaxId

` The slot a condition reads `it` through where its pattern declares none and no arm has
` one: that of an earlier pattern of the same block.
. binding = instances.rows[unit.reading].binding
if binding == no-binding || unit.reading != unit.instance
    = no-slot
for id in tree.subtree-start(expr) .. expr
    do match? tree.nodes[id]
        | .node-identifier
            . resolution = bindings.resolution-of(binding, id)
            if resolution.kind == .resolve-slot && bindings.slots[resolution.slot].kind == .slot-it
                = resolution.slot
= no-slot

────────────────────
_ do match-case Typed
    - pattern SyntaxId
    - inner SyntaxId
    - value Typed
    - failed IRBlockId

` A pattern that names a case of a union, by the number the type pass recorded. An optional
` is tested for a value first. With a pattern written for what the case holds, that is
` matched and what it passes is passed; with none, the union is, but where `is` tests a state
` machine it is the case's flag that is tested, as the reference tests it, unless the tag is
` (`tests-tag`), and where it tests a value of a machine's union read from elsewhere, the tag of
` the case or of one written in it (`pass-within`). One pattern in parentheses for a case that holds no tuple is the pattern
` of what the case holds. A case its subject is no union of matches nothing. A case a refinement
` of the machine adds is tested as `refined-case` reads it, and matches nothing where no object
` reaches the test (`unreached-refined`).
. nothing = make-operand(.operand-void, 0)
if facts.plan-of(unit.reading, pattern) == .plan-never || unreached-refined(matching.case-subject, pattern)
    jump(failed)
    fail-jumps += 1
    ir.start-block(ir.reserve-block())
    = value
if facts.plan-of(unit.reading, pattern) == .plan-refined-case
    . union = value.type
    . held = refined-case(matching.case-subject, pattern, inner != 0)
    pass-or-fail(load-local(refined-flag, pattern), failed)
    if inner == 0
        = Typed(value.operand, union)
    = emit-pattern(payload-part(inner, held), Typed(load-local(refined-payload, pattern), held), failed)
. held = value
if types.is-optional(held.type)
    . type = held.type
    . tested = present(pattern, held)
    pass-or-fail(tested.operand, failed)
    held = payload(pattern, Typed(held.operand, type))
. union = held.type
if intrinsic(union) == .table-row || intrinsic(union) == .immutable-table-row
    = match-row-case(pattern, inner, held, failed)
. constant = facts.constant-of(unit.reading, pattern)
. layout = layout-of(union, pattern)
if facts.plan-of(unit.reading, pattern) != .plan-case || constant == no-fact || not-union
    refuse(.refused-expression, pattern)
    = Typed(nothing, no-type)
.. not-union = !tables.layouts.is-union(layout)
. index = facts.constants[constant].bits as U32
if index >= tables.layouts.rows[layout].cases.count
    refuse(.refused-expression, pattern)
    = Typed(nothing, no-type)
. machine = machine-of-union(union)
if switching && value.operand == switched-subject && switched-value == index as U64
    switching = false
else if machine && inner == 0 && matching.testing && !reads-machine(matching.tested, machine)
    pass-within(pattern, machine, held.operand, index, failed)
else if machine && inner == 0 && matching.testing && (machine.store != .store-member || !tests-tag())
    pass-or-fail(machine-flag(pattern, machine, index, failed).operand, failed)
else
    pass-or-fail(case-test(pattern, held.operand, index), failed)
if inner == 0
    = Typed(held.operand, union)
. field = tables.layouts.case-field(layout, index)
if field.type == no-type || field.type == invalid-type
    refuse(.refused-expression, pattern)
    = Typed(nothing, no-type)
= emit-pattern(payload-part(inner, field.type), Typed(take(held.operand, field, pattern), field.type), failed)

────────────────────
_ do member-flag Typed
    - lhs SyntaxId
    - pattern SyntaxId
    - machine MachineFact

` Whether the case a pattern names of a state machine a property of a class holds is active,
` as the reference tests it: the object's flag of the case, read from the object written before
` the property's name, which is evaluated once, or from the object a name alone is read from
` (`self-owner`), where a name written tracked is tracked as it is read. Any other value of the
` machine's union has no shape here. A case a refinement of the machine adds is tested as
` `refined-case` reads it, and is not active where no object reaches the test
` (`unreached-refined`).
. nothing = make-operand(.operand-void, 0)
if facts.plan-of(unit.reading, pattern) == .plan-refined-case
    if unreached-refined(lhs, pattern)
        = Typed(integer(.machine-u8, 0), types.bool-type)
    do refined-case(lhs, pattern, false)
    = Typed(load-local(refined-flag, pattern), types.bool-type)
. constant = facts.constant-of(unit.reading, pattern)
. property = decl-name(machine.module, machine.decl)
. machine-tree = program.modules[machine.module].tree
. cases = machine-tree.machine-cases
    - machine-tree.state-items(machine-tree.state-body(machine.syntax))
if facts.plan-of(unit.reading, pattern) != .plan-case || constant == no-fact || !property || past-cases
    refuse(.refused-expression, pattern)
    = Typed(nothing, no-type)
.. past-cases = facts.constants[constant].bits >= cases.length as U64
. name = program.store-atom("(${property.text}-${state-text}-active)")
    .. state-text = machine-tree.state-name(cases[facts.constants[constant].bits as U32])!.text
. base = nothing
. owner = no-type
do match? tree.nodes[lhs]
    | .node-get-expression(row)
        if row.name == property && !is-link(lhs)
            owner = held-type(row.object)
            base = emit-expression(row.object).operand
    | .node-identifier(row)
        . binding = instances.rows[unit.reading].binding
        . resolution = if binding != no-binding then resolved else Resolution(.resolve-none, 0)
            .. resolved = bindings.resolution-of(binding, lhs)
        if row.name == property && resolution.kind == .resolve-member
            owner = self-owner()
            base = unit.self
            if owner != no-type && row.is-tracked && live-actions.length != 0
                track-name(lhs, row.name)
if owner == no-type || owner == invalid-type || !tables.is-class(owner)
    refuse(.refused-expression, lhs)
    = Typed(nothing, no-type)
. found = property-of(owner, name)
if !found
    refuse(.refused-expression, lhs)
    = Typed(nothing, no-type)
. field = held-field(lhs, owner, found)
= Typed(load(base, field.offset, field.layout, lhs), types.bool-type)

────────────────────
_ do refined-case TypeId
    - subject SyntaxId
    - pattern SyntaxId
    - reads Bool

` Reads, for a pattern that names a case a refinement of the machine of a property of a class
` adds, whether the case is active, into `refined-flag`, and what it holds, into
` `refined-payload`, and answers its type, as the reference reads them: from the object the
` property is read from, a local or the one a name alone is read from, by the composite of the
` object's class, the object's flag of the case and what the object keeps for the piece that
` writes it, where it holds anything and that `reads` it, else `Void`. An object of a class whose
` composite has none of it is not in the case. A class the object is written as that no
` composite with the case is of, nor any class below it, has no shape here.
refined-flag = no-local
refined-payload = no-local
. name = pattern-case-name(pattern)
. union = if subject != 0 then facts.node-type(unit.reading, subject) else no-type
. root = machine-of-union(union)
. property = decl-name(root.module, root.decl) if root
. owner = refined-owner(subject, pattern)
. object = make-operand(.operand-void, 0)
if owner != no-type
    do match? tree.nodes[subject]
        | .node-get-expression(row)
            object = emit-expression(row.object).operand
        | .node-identifier
            object = unit.self
if owner == no-type || owner == invalid-type || !tables.is-class(owner)
    refuse(.refused-expression, pattern)
    = no-type
. held = no-type
. found = false
refined-flag = ir.add-local(u8-layout)
store-local(refined-flag, integer(.machine-u8, 0), pattern)
. joined = ir.reserve-block()
for position in tables.machine-order
    . fact = facts.machines[position]
    . classes = composite-classes(fact, root!, owner)
    . level = tables.machine-receiver(fact)
    . composite = compose-machine(program, facts, fact) if classes.length != 0
    . case = if composite then composite.case-named(name!) else U32.max
    if case == U32.max || composite!.owners[case] == 0
        continue
    . fragment = composite!.pieces[composite!.owners[case]]
    . node = composite!.node(case, composite!.owners[case])
    found = true
    . missed = ir.reserve-block()
    . matched = ir.reserve-block()
    classes-branch(pattern, object, classes, matched, missed)
    ir.start-block(matched)
    . flagged = property-of(level, flag-name(property!, name!))
    if !flagged
        refuse(.refused-expression, pattern)
        = no-type
    . flag = held-field(pattern, level, flagged)
    store-local(refined-flag, load(object, flag.offset, flag.layout, pattern), pattern)
    if !reads || !union-case-holds(fragment.union, name!)
        if held != no-type && held != types.void-type
            refuse(.refused-expression, pattern)
            = no-type
        held = types.void-type
        jump(joined)
        ir.start-block(missed)
        continue
    . kept = refinement-payload(fragment, node, level, object, pattern)
    if held == no-type
        held = kept.type
        refined-payload = ir.add-local(layout-of(held, pattern))
    if held != kept.type
        refuse(.refused-expression, pattern)
        = no-type
    store-local(refined-payload, kept.operand, pattern)
    jump(joined)
    ir.start-block(missed)
if !found
    refuse(.refused-expression, pattern)
    = no-type
jump(joined)
ir.start-block(joined)
= held

────────────────────
_ do refined-owner TypeId
    - subject SyntaxId
    - pattern SyntaxId

` The class of the object `refined-case` reads a case a refinement adds from: that of the local
` written before the property's name, or of the object a name alone is read from, or no type.
. name = pattern-case-name(pattern)
. union = if subject != 0 then facts.node-type(unit.reading, subject) else no-type
. root = machine-of-union(union)
. property = decl-name(root.module, root.decl) if root
. owner = no-type
if property && name
    do match? tree.nodes[subject]
        | .node-get-expression(row)
            . named = tree.nodes[row.object] is .node-identifier
            if row.name == property && !is-link(subject) && named
                owner = held-type(row.object)
        | .node-identifier(row)
            if row.name == property && resolves-member(subject)
                owner = self-owner()
= owner

────────────────────
_ unreached-refined Bool
    - subject SyntaxId
    - pattern SyntaxId

` Whether a pattern names a case a refinement of a machine adds that no object reaches: the
` program constructs no class the object `refined-case` reads it from is written as, nor any
` class below it.
|? facts.plan-of(unit.reading, pattern) != .plan-refined-case
    false
??
    owner != no-type && owner != invalid-type && tables.is-class(owner) && !tables.constructs-from(owner)

.. owner = refined-owner(subject, pattern)

────────────────────
_ do refinement-payload Typed
    - fragment MachineFact
    - node SyntaxId
    - level TypeId
    - object Operand
    - site SyntaxId

` What a case a refinement adds holds, read from what an object of a class keeps for the
` refinement: the environment of the refinement's function, which the property that holds its
` part holds (`part-name`). One that holds a tuple or a struct has no shape here.
. nothing = make-operand(.operand-void, 0)
. holder = part-name(fragment)
. found = property-of(level, holder) if holder
. row = bindings.machine-slots(fragment.module, fragment.syntax)
. slot = if row then bindings.machine-slot(row, node, program.store-atom("(payload)")) else no-slot
. layout = tables.environments[fragment.instance]
if !found || slot == no-slot || layout == no-layout || layout == unbuilt-environment
    refuse(.refused-expression, site)
    = Typed(nothing, no-type)
. field = held-field(site, level, found)
. data = tables.layouts.field(tables.layouts.function-layout, 1).offset
. environment = load(object, field.offset + data, managed-layout, site)
. kept = tables.layouts.field(layout, 1 + tables.slot-fields[slot])
if tables.layouts.is-struct(kept.layout)
    refuse(.refused-expression, site)
    = Typed(nothing, no-type)
= Typed(load(environment, kept.offset, kept.layout, site), kept.type)

────────────────────
_ do union-case-holds Bool
    - union TypeId
    - name Atom

` Whether the case of a name of a state machine's union holds a value.
. position = 0u32
for fact in types.cases[types.completion-of(union).cases]
    if fact.name && fact.name! == name
        do match? types.rows[union]
            | .type-named-union(row)
                = types.child-type(row.cases, position) != types.void-type
        = false
    position += 1
= false

────────────────────
_ pattern-case-name Atom?
    - pattern SyntaxId

` The name of the case a pattern names.
match? tree.nodes[pattern]
    | .node-type-case(row)
        row.name
    | .node-symbol(row)
        row.name

────────────────────
_ tests-tag Bool

` Whether a case test of a state machine a property of a class holds compares the tag of its
` union, as the reference compiles it before it declares the machine's flags: in the first
` value of a property, and in the function that evaluates it again.
function.kind == .property-updater || (filling.count != 0 && unit.reading != unit.instance)

────────────────────
_ do match-row-case Typed
    - pattern SyntaxId
    - inner SyntaxId
    - value Typed
    - failed IRBlockId

` A pattern that names a case of a row of a table of unions: the row's tag is tested, and a
` name the pattern declares for what the case holds stands for the row's cells. Any other
` pattern for what the case holds is matched against the case gathered from them.
. nothing = make-operand(.operand-void, 0)
. type = value.type
. place = tables.unions.of(table-row-type(type))
. constant = facts.constant-of(unit.reading, pattern)
if place == U32.max || facts.plan-of(unit.reading, pattern) != .plan-case || constant == no-fact
    refuse(.refused-expression, pattern)
    = Typed(nothing, no-type)
. union = tables.unions.layouts[place]
. index = facts.constants[constant].bits as U32
if index >= union.cases.count
    refuse(.refused-expression, pattern)
    = Typed(nothing, no-type)
. located = subject-place(pattern, value.operand, type)
if switching && value.operand == switched-subject && switched-value == index as U64
    switching = false
else
    . tag = load
        - table-cell(pattern, located.columns, located.index, 0, u8-layout)
        - 0
        - u8-layout
        - pattern
    pass-or-fail(compare(pattern, .compare-equal, tag, integer(.machine-u8, index)), failed)
if inner == 0
    = Typed(value.operand, type)
. case-type = tables.unions.cases[union.cases.start + index].type
. part = inner
do match? tree.nodes[inner]
    | .node-type-tuple(row)
        if row.field-types.count == 1 && intrinsic(case-type) != .tuple
            part = tree.children[row.field-types.start]
do match? tree.nodes[part]
    | .node-identifier
        bind-case-cursor(part, value.operand, type, place, index, located)
        = Typed(value.operand, type)
    | .node-type-capture(row)
        if row.type == 0
            bind-case-cursor(row.id, value.operand, type, place, index, located)
            = Typed(value.operand, type)
. gathered = gather-union-case(pattern, place, index, located.columns, located.index)
= emit-pattern(part, gathered, failed)

────────────────────
_ do match-fields Typed ?! Refused
    - pattern SyntaxId
    - fields RowRange'SyntaxId
    - value Typed
    - failed IRBlockId

` A pattern of several in parentheses: each is matched against the field of a tuple or a
` struct in its place, and the pattern passes the whole. An optional is tested for a value
` first, and matched as what it holds; a union of tuples has no shape here. A table or a span
` of one is taken apart into its columns.
. nothing = make-operand(.operand-void, 0)
if types.is-optional(value.type)
    . type = value.type
    . tested = present(pattern, value)
    pass-or-fail(tested.operand, failed)
    . held = payload(pattern, Typed(value.operand, type))
    = match-fields(pattern, fields, held, failed)
. owner = value.type
. layout = layout-of(owner, pattern)
if is-row-source(intrinsic(owner))
    = match-columns(fields, value, layout)
if !is-aggregate(owner) || !tables.layouts.is-struct(layout)
    refuse(.refused-expression, pattern)
    = Typed(nothing, no-type)
if tables.layouts.rows[layout].fields.count < fields.count
    refuse(.refused-expression, pattern)
    = Typed(nothing, no-type)
for position in 0 .. < fields.count
    . field = tables.layouts.field(layout, position)
    emit-pattern(tree.children[fields.start + position], Typed(take(value.operand, field, pattern), field-type(owner, position)), failed)
= Typed(value.operand, owner)

────────────────────
_ do match-columns Typed
    - fields RowRange'SyntaxId
    - value Typed
    - layout LayoutId

` A pattern of several in parentheses matched against a table or a span of one, which it
` takes apart as TypeScript does: each field is a view of its column, of the type the name
` written for it holds, and the name is bound to it. One written as `_` still has the table
` checked. Any other pattern of a column has no shape here. The pattern passes the table.
. owner = value.type
. binding = instances.rows[unit.reading].binding
for position in 0 .. < fields.count
    . field = tree.children[fields.start + position]
    . name SyntaxId = 0
    do match? tree.nodes[field]
        | .node-type-wildcard
            table-source(field, value.operand, owner, layout)
            continue
        | .node-identifier
            name = field
        | .node-type-capture(row)
            if row.type == 0
                name = row.id
    if name == 0 || binding == no-binding || unit.reading != unit.instance
        refuse(.refused-expression, field)
        break
    . resolution = bindings.resolution-of(binding, name)
    if resolution.kind != .resolve-slot
        refuse(.refused-expression, field)
        break
    . held = facts.slot-type(unit.instance, slot-offset(resolution.slot, name))
    . view = table-view(field, value.operand, owner, layout, position, held)
    bind-name(name, Typed(view.operand, held))
= Typed(value.operand, owner)

────────────────────
_ do read-part Typed
    - site SyntaxId
    - fact FactId
    - subject Operand
    - type TypeId
    - argument Operand
    - given TypeId = no-type

` A call a pattern of a list makes on its subject, which the type pass recorded at the
` pattern or at the pattern of an item. One whose function raises an error has no shape.
if fact != no-fact && facts.calls[fact].callee != no-instance
    if instances.signatures[facts.calls[fact].callee].errors.count != 0
        refuse(.refused-expression, site)
        = Typed(make-operand(.operand-void, 0), no-type)
= call-protocol(site, fact, subject, type, argument, given, false)

────────────────────
_ do match-text Typed
    - pattern SyntaxId
    - value Typed
    - failed IRBlockId

` A pattern of texts, as the type pass planned it for a `String`. Its length is read and is
` to be no less than that of the texts written; then the texts before the rest are to start
` it and those after to end it, by the calls recorded at the pattern. Unless the pattern only
` tests, a name given a text is bound to that text, and a rest with a name to what lies
` between, read by its range from the length read again. The pattern passes the subject.
. nothing = make-operand(.operand-void, 0)
. type = value.type
. parts [SyntaxId]
tree.text-parts(pattern, parts)
. prefix = ""
. suffix = ""
. rest SyntaxId = 0
for part in parts
    . text = tree.text-of(part)
    if !text
        rest = part
    else if rest == 0
        prefix = "$prefix${text}"
    else
        suffix = "$suffix${text}"
. measured = call-at(pattern, .call-getter)
if rest == 0 || measured == no-fact
    refuse(.refused-expression, pattern)
    = Typed(nothing, no-type)
. length = read-part(pattern, measured, value.operand, type, nothing)
if length.type != types.size-type
    refuse(.refused-expression, pattern)
    = Typed(nothing, no-type)
. least = integer(.machine-u64, (prefix.length + suffix.length) as U64)
pass-or-fail(compare(pattern, .compare-greater-equal, length.operand, least), failed)
. fact = call-at(pattern, .call-method)
for text in [prefix, suffix]
    if text.length == 0
        continue
    . tested = read-part
        - pattern
        - fact
        - value.operand
        - type
        - make-operand(.operand-constant, ir.add-string(text))
        - types.string-type
    if tested.type != types.bool-type
        refuse(.refused-expression, pattern)
        = Typed(nothing, no-type)
    pass-or-fail(tested.operand, failed)
    fact = next-call(fact)
if !matching.testing
    for part in parts
        do match? tree.nodes[part]
            | .node-type-capture(row)
                bind-name
                    - row.id
                    - Typed(make-operand(.operand-constant, ir.add-string(tree.text-of(part)!)), types.string-type)
if !matching.testing && has-name(rest)
    . again = read-part(pattern, measured, value.operand, type, nothing)
    . end = again.operand
    if suffix.length != 0
        end = arithmetic
            - pattern
            - .arithmetic-subtract
            - again.operand
            - integer(.machine-u64, suffix.length as U64)
            - u64-layout
    match-rest(rest, value.operand, type, integer(.machine-u64, prefix.length as U64), end, false, failed)
= Typed(value.operand, type)

────────────────────
_ do match-items Typed
    - pattern SyntaxId
    - items RowRange'SyntaxId
    - value Typed
    - failed IRBlockId

` A pattern of a list, as the type pass planned it. The subject is first what an optional
` holds, or the case of a union the pattern has conversions for. Its length is read once
` and tested: as many items as the pattern writes, or no fewer where it writes a rest. Each
` item before the rest is then read at its place and matched, each after the rest at its
` place from the end, and last a rest with a name is read by the range of what lies
` between, unless the pattern only tests. The rows of a table or a span of one, and the items
` of a view of a field's column, are counted and read as TypeScript answers `t.length` and
` `t[i]`, and a rest of them with a name is the span or the view `t[a .. < b]` gives. The
` pattern passes the subject.
. nothing = make-operand(.operand-void, 0)
. subject = value
if types.is-optional(subject.type) || intrinsic(subject.type) == .union
    subject = match-type(pattern, Typed(value.operand, subject.type), failed)
. type = subject.type
. views = reads-views(pattern, type)
. layout = if views then layout-of(type, pattern) else no-layout
. count = items.count
. rest = count
for position in 0 .. < count
    do match? tree.nodes[tree.children[items.start + position]]
        | .node-type-remainder
            rest = position
. fixed = if rest == count then count else count - 1
. length = list-length(pattern, subject.operand, type, views, layout)
. wanted = integer(.machine-u64, fixed)
pass-or-fail
    - compare
        - pattern
        - if rest == count then .compare-equal else .compare-greater-equal
        - length.operand
        - wanted
    - failed
for position in 0 .. < count
    if position == rest
        continue
    . item = tree.children[items.start + position]
    . index = integer(.machine-u64, position)
    if position > rest
        index = arithmetic
            - item
            - .arithmetic-subtract
            - length.operand
            - integer(.machine-u64, count - position)
            - u64-layout
    . reading-call = call-at(item, .call-item-read)
    . read = Typed(nothing, no-type)
    if views
        read = view-item(item, reading-call, subject.operand, type, layout, index)
    else
        read = read-part(item, reading-call, subject.operand, type, index, types.index-type)
    emit-pattern(item, read, failed)
if rest != count && !matching.testing
    . end = length
    if rest + 1 != count
        . arithmeticd = arithmetic
            - pattern
            - .arithmetic-subtract
            - length.operand
            - integer(.machine-u64, count - rest - 1)
            - u64-layout
        end = Typed(arithmeticd, end.type)
    match-rest
        - tree.children[items.start + rest]
        - subject.operand
        - type
        - integer(.machine-u64, rest)
        - end.operand
        - views
        - failed
= Typed(subject.operand, type)

────────────────────
_ do list-length Typed
    - pattern SyntaxId
    - subject Operand
    - type TypeId
    - views Bool
    - layout LayoutId

. nothing = make-operand(.operand-void, 0)
. measured = call-at(pattern, .call-getter)
. length = Typed(nothing, no-type)
if views
    length = view-length(pattern, subject, type, layout)
else if measured != no-fact
    length = read-part(pattern, measured, subject, type, nothing)
else
    length = array-length(pattern, subject, type)
if length.type != types.size-type
    refuse(.refused-expression, pattern)
    = Typed(nothing, no-type)
= length

────────────────────
_ reads-views Bool
    - pattern SyntaxId
    - type TypeId

` Whether the type pass planned a pattern of a list to read the rows of a table or a span of
` one, or the items of a view of a field's column, as TypeScript answers them.
constant != no-fact && facts.constants[constant].bits == 2 && viewed

.. constant = facts.constant-of(unit.reading, pattern)
.. kind = intrinsic(type)
.. viewed = is-row-source(kind) || kind == .table-column || kind == .immutable-table-column

────────────────────
_ do view-length Typed
    - id SyntaxId
    - held Operand
    - type TypeId
    - layout LayoutId

` How many rows a table or a span of one holds, or how many items a view of a field's column
` does, as TypeScript counts them.
if is-row-source(intrinsic(type))
    = rows-length(id, held, type, layout)
. counted = column-length(id, held, layout)
= Typed(counted.operand, types.size-type)

────────────────────
_ do view-item Typed
    - site SyntaxId
    - fact FactId
    - subject Operand
    - type TypeId
    - layout LayoutId
    - index Operand

` The row at an index of a table or a span of one, or the item at an index of a view of a
` field's column, that a pattern of an item is matched against, as `t[i]` reads it.
if is-row-source(intrinsic(type))
    = row-at(site, fact, subject, type, layout, index)
= column-item(site, subject, type, index)

────────────────────
_ do row-at Typed
    - site SyntaxId
    - fact FactId
    - subject Operand
    - type TypeId
    - layout LayoutId
    - index Operand

` The row at an index of a table or a span of one that a pattern of an item is matched
` against, as `t[i]` reads it: of the type the read recorded at the item gives.
if fact == no-fact || facts.calls[fact].callee == no-instance
    refuse(.refused-expression, site)
    = Typed(make-operand(.operand-void, 0), no-type)
. cursor = row-place(site, subject, type, layout, index)
= row-value(site, cursor, instances.signatures[facts.calls[fact].callee].returns)

────────────────────
_ has-name Bool
    - remainder SyntaxId

` Whether the rest of a pattern of a list has a name.
match tree.nodes[remainder]
    | .node-type-remainder(row)
        row.name != 0
    ??
        false

────────────────────
_ do match-rest
    - remainder SyntaxId
    - subject Operand
    - type TypeId
    - start Operand
    - end Operand
    - views Bool
    - failed IRBlockId

` The rest of a pattern of a list, where it has a name: the range from `start` to `end` is
` made by the construction the type pass recorded at the rest, with a step of one, and the
` subject is read by it with the call recorded after, or of the rows of a table, a span of one or
` a view of a field's column, made their span or view as `t[a .. < b]` makes it. What it gives is
` matched by the name.
. name SyntaxId = 0
do match? tree.nodes[remainder]
    | .node-type-remainder(row)
        name = row.name
if name == 0
    =
. made = call-at(remainder, .call-constructor)
. sliced = if made == no-fact then no-fact else facts.calls[made].next
if sliced == no-fact || facts.calls[sliced].callee == no-instance
    refuse(.refused-expression, remainder)
    =
. range = instances.argument-type(facts.calls[sliced].callee, 0)
. layout = layout-of(range, remainder)
. mark = given.length
given += Typed(start, types.index-type)
given += Typed(end, types.index-type)
given += Typed(integer(.machine-u64, 1), types.index-type)
. span = make-fields(range, layout, facts.calls[made].fills, mark, 3, remainder)
drop-given(mark)
. sliced-type = instances.signatures[facts.calls[sliced].callee].returns
. read = if views then span-of(remainder, subject, type, span, range, 0, sliced-type) else read-part(remainder, sliced, subject, type, span, range)
emit-pattern(name, read, failed)

────────────────────
_ do match-keys Typed
    - pattern SyntaxId
    - items RowRange'SyntaxId
    - value Typed
    - failed IRBlockId

` A pattern of a map, as the type pass planned it. The subject is first what an optional
` holds, or the case of a union the pattern has conversions for. Each key written is
` evaluated, converted as recorded at the key, and read by the call recorded at its item: a
` key the map lacks does not match, and what a key holds is matched by the pattern written
` for it. Last a rest with a name is the subject without the keys matched, unless the
` pattern only tests. The pattern passes the subject.
. nothing = make-operand(.operand-void, 0)
. subject = value
if types.is-optional(subject.type) || intrinsic(subject.type) == .union
    subject = match-type(pattern, Typed(value.operand, subject.type), failed)
. type = subject.type
. mark = given.length
. rest SyntaxId = 0
for item in tree.children[items]
    do match tree.nodes[item]
        | .node-type-map-item(row)
            . key = convert(row.key, .reason-argument, emit-expression(key-of(row.key)))
            . keyed = key.type
            . read = read-part(item, call-at(item, .call-item-read), subject.operand, type, key.operand, keyed)
            if types.is-optional(read.type)
                . maybe = read.type
                pass-or-fail(present(item, read).operand, failed)
                read = payload(item, Typed(read.operand, maybe))
            given += Typed(key.operand, keyed)
            given += read
            emit-pattern(row.value, read, failed)
        | .node-type-remainder(row)
            if row.name != 0
                rest = item
        ??
            refuse(.refused-expression, item)
            = Typed(nothing, no-type)
if rest != 0 && !matching.testing
    match-unmatched(rest, subject.operand, type, mark, failed)
drop-given(mark)
= Typed(subject.operand, type)

────────────────────
_ key-of SyntaxId
    - key SyntaxId

` The expression a key of a map pattern is compared to: what is written, or the name read.
match tree.nodes[key]
    | .node-type-equality(row)
        row.expr
    ??
        key

────────────────────
_ do match-unmatched
    - remainder SyntaxId
    - subject Operand
    - type TypeId
    - mark Size
    - failed IRBlockId

` The rest of a pattern of a map, where it has a name: an empty map of the subject's type is
` made by the construction the type pass recorded at the rest, each key matched, held with
` what it holds from `mark` on, is stored in it by the call recorded next, and the rest is
` what the last call recorded gives of the subject and that map. The name matches it.
. name SyntaxId = 0
do match? tree.nodes[remainder]
    | .node-type-remainder(row)
        name = row.name
. made = call-at(remainder, .call-constructor)
. stored = if made == no-fact then no-fact else facts.calls[made].next
. taken = if stored == no-fact then no-fact else facts.calls[stored].next
if taken == no-fact
    refuse(.refused-expression, remainder)
    =
. matched = emit-fact-call(remainder, facts.calls[made], 0, RowRange'SyntaxId(), 0, 0, type)
if matched.type != type
    refuse(.refused-expression, remainder)
    =
. end = given.length
. position = mark
while position < end
    call-made(remainder, stored, matched.operand, type, position, 2)
    position += 2
given += Typed(matched.operand, type)
. left = call-made(remainder, taken, subject, type, end, 1)
drop-given(end)
emit-pattern(name, left, failed)

────────────────────
_ do call-made Typed
    - site SyntaxId
    - fact FactId
    - receiver Operand
    - type TypeId
    - start Size
    - count U32

` A call a pattern makes that no call in the source writes, which the type pass recorded at
` the pattern: of a function declared for the receiver's type that raises no error, with the
` receiver as it is and the arguments held from `start` on, each of the type the function
` takes. A function some class declares again is chosen by the class of the object. Any
` other has no shape here.
. nothing = make-operand(.operand-void, 0)
if fact == no-fact || facts.calls[fact].callee == no-instance || uncallable
    refuse(.refused-expression, site)
    = Typed(nothing, no-type)
.. uncallable = !is-callable(facts.calls[fact].callee)
. callee = facts.calls[fact].callee
. signature = instances.signatures[callee]
if instances.rows[callee].self-type != type || signature.args.count != count || signature-raises
    refuse(.refused-expression, site)
    = Typed(nothing, no-type)
.. signature-raises = signature.errors.count != 0
for offset in 0 .. < count
    if instances.argument-type(callee, offset) != given[start + offset].type
        refuse(.refused-expression, site)
        = Typed(nothing, no-type)
. pended = pending.length
pending += receiver
for offset in 0 .. < count
    pending += given[start + offset].operand
if tables.is-class(type) && tables.is-overridden(callee)
    = call-method(callee, site, pended)
= call-instance(callee, site, pended)

────────────────────
+ do emit-match Typed
    - id SyntaxId
    - pattern SyntaxId

` A match with no subject, whose arms are conditions tested in order. The value of the arm
` taken is the value of the match. Where the arms end in no else and none is taken, the
` match is an optional that holds nothing, as the type pass typed it.
. nothing = make-operand(.operand-void, 0)
if pattern == 0
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. type = facts.node-type(unit.reading, id)
. layout = layout-of(type, id)
. joined = ir.reserve-block()
. slot = join-slot(layout)
. mark = joins.length
. is-closed = emit-arms(id, pattern, type, joined, slot)
if !is-closed
    if types.is-optional(type)
        arrive(id, empty-optional(type, layout).operand, joined, slot)
    else
        refuse(.refused-expression, id)
. result = close-joins(joined, mark, layout, slot)
= Typed(result, type)

────────────────────
+ do run-arms
    - id SyntaxId
    - pattern SyntaxId

` A match with no subject whose arms give no value: the conditions are tested in order, and
` the arm taken is run for what it does. Where none is taken nothing is run.
if pattern == 0
    refuse(.refused-statement, id)
    =
. joined = ir.reserve-block()
. is-closed = emit-arms(id, pattern, no-type, joined, make-operand(.operand-void, 0))
if !is-closed
    jump(joined)
ir.start-block(joined)

────────────────────
_ do emit-arms Bool ?! Refused
    - site SyntaxId
    - pattern SyntaxId
    - type TypeId
    - joined IRBlockId
    - slot Operand
    - places Bool = false

` Emits the arms of a match in order, and says whether an else ended them. Each arm leaves
` its value and the block it ends in for the match to join, or where it `places`, in an inlined
` body, the place its answer gives (`place-arm`). An arm that is a test and no more gives what
` it tested where that tests as true: of an optional, what it holds. The body of an arm that
` tests a condition reads what the condition gave as its `it`. An arm that raises for whatever
` is left ends them as an else does. Where the arms place, an arm that is a test and no more and
` an arm that raises have no shape.
do match? tree.nodes[pattern]
    | .node-type-or(row)
        if emit-arms(site, row.left, type, joined, slot, places)
            = true
        = emit-arms(site, row.right, type, joined, slot, places)
    | .node-type-transform(row)
        . condition SyntaxId = 0
        . is-else = row.pattern == 0
        if !is-else
            do match? tree.nodes[row.pattern]
                | .node-type-wildcard
                    is-else = true
                | .node-type-predicate(predicate)
                    condition = predicate.expr
        if places && facts.plan-of(unit.reading, pattern) == .plan-raise
            refuse(.refused-expression, pattern)
            = false
        if is-else
            leave-arm(site, pattern, row.expr, type, joined, slot, places)
            = true
        if condition == 0
            refuse(.refused-expression, pattern)
            = false
        . given = emit-expression(condition)
        . given-type = given.type
        . tested = test(condition, given)
        . taken = ir.reserve-block()
        . passed = ir.reserve-block()
        branch(tested.operand, taken, passed)
        ir.start-block(taken)
        . named = bound.length
        . it-slot = arm-slot-of(pattern, .slot-it)
        if it-slot != no-slot
            bound += BoundValue(it-slot, given-type, given.operand)
        leave-arm(site, pattern, row.expr, type, joined, slot, places)
        drop-bound(named)
        ir.start-block(passed)
        = false
    | .node-type-predicate(row)
        if places
            refuse(.refused-expression, pattern)
            = false
        . subject = emit-expression(row.expr)
        . held = subject.type
        . tested = test(row.expr, Typed(subject.operand, held))
        . taken = ir.reserve-block()
        . passed = ir.reserve-block()
        branch(tested.operand, taken, passed)
        ir.start-block(taken)
        . value = Typed(subject.operand, held)
        if held != type && holds(held, type)
            value = payload(row.expr, value)
        if value.type != type
            value = join(site, value)
        if value.type != type
            refuse(.refused-conversion, pattern)
        arrive(site, value.operand, joined, slot)
        ir.start-block(passed)
        = false
    | .node-type-panic(row)
        if places
            refuse(.refused-expression, pattern)
            = false
        do match? tree.nodes[row.pattern]
            | .node-type-transform(arm)
                if arm.pattern == 0 && arm.expr != 0
                    raise-given(pattern, arm.expr, row.pattern)
                    = true
                if arm.expr != 0
                    do match? tree.nodes[arm.pattern]
                        | .node-type-predicate(predicate)
                            . given = emit-expression(predicate.expr)
                            . tested = test(predicate.expr, given)
                            . taken = ir.reserve-block()
                            . passed = ir.reserve-block()
                            branch(tested.operand, taken, passed)
                            ir.start-block(taken)
                            raise-given(pattern, arm.expr, row.pattern)
                            ir.start-block(passed)
                            = false
refuse(.refused-expression, pattern)
= false

────────────────────
_ do leave-arm ?! Refused
    - site SyntaxId
    - pattern SyntaxId
    - body SyntaxId
    - type TypeId
    - joined IRBlockId
    - slot Operand
    - places Bool

` Runs the body of an arm `emit-arms` takes: leaves the place its answer gives where the arms
` place, and otherwise its value, unless it leaves the match or raises.
if places
    place-arm(body, type, joined)
else if !arm-leaves(pattern, body) && !arm-raises(body)
    emit-arm(site, body, type, joined, slot, true)
