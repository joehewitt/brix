(import ./emitter)
(import ./emitter.live-actions)
(import ./layouts)
(import ./program-tables)
(import ./receiver-stability)
(import ./runtime)
(import ./table-layouts)
(import /core/arena)
(import /core/table)
(import /lang/ast/ast)
(import /lang/ast/ast-children)
(import /lang/ast/ast-queries)
(import /lang/ast/ast-nodes)
(import /lang/ast/decl)
(import /lang/ast/module)
(import /lang/ast/operator)
(import /lang/ast/program)
(import /lang/ast/row-range)
(import /lang/ast/state-machines)
(import /lang/backend/mir)
(import /lang/check/binding)
(import /lang/check/claims)
(import /lang/check/facts)
(import /lang/check/instances)
(import /lang/check/machine-composite)
(import /lang/check/numeric)
(import /lang/check/pattern-helper)
(import /lang/check/probe-casts)
(import /lang/check/table-rows)
(import /lang/check/type-signature)
(import /lang/check/type-store)
(import /lang/check/type-text)
(import /lang/check/types)
(import /lang/ir/ir)
(import /stream/sort)

(type _ Lazies (facet-of FunctionEmitter)
  (sees LiveActions)
  (prop _ lazy-claim _ (= (call LayoutField 0 no-layout)))
  (fn-do + clear-lazies _
    ; Gives each lazy local that is evaluated once in a run of the function the flag that says
    ; whether it has been, cleared here where the function starts, and notes whether any is
    ; evaluated by its one read. The locals one declaration names together have one flag. A lazy
    ; local held as an eager local is (`holds-lazy`) has its flag here, not in the environment.
    (= unit (= (. unit inlines) false))
    (for (in offset (..< 0 (. unit slot-count)))
      (if (or (!= (. ([] (. bindings slots) (+ (. unit slot-start) offset)) kind) .slot-lazy) (not (call owns (+ (. unit slot-start) offset))))
        (continue)
      )
      (let held (call (. tables holds-lazy) (+ (. unit slot-start) offset)))
      (if (and (call is-captured (+ (. unit slot-start) offset)) (not held))
        (continue)
      )
      (if (call (. bindings lazy-inlines) (+ (. unit slot-start) offset))
        (= unit (= (. unit inlines) true))
      )
      (if (and (!= (call (. bindings lazy-policy) (+ (. unit slot-start) offset)) .lazy-memo) (not held))
        (continue)
      )
      (let group (. ([] (. bindings slots) (+ (. unit slot-start) offset)) group))
      (if (and (!= offset 0) (!= ([] (. unit lazy-flags) (- offset 1)) no-local) same-group)
        (= ([] (. unit lazy-flags) offset) ([] (. unit lazy-flags) (- offset 1)))
        (continue)
      )
      (lazy same-group (== (. ([] (. bindings slots) (- (+ (. unit slot-start) offset) 1)) group) group))
      (let flag (call (. ir add-local) u8-layout))
      (= ([] (. unit lazy-flags) offset) flag)
      (call store-local flag (call integer .machine-u8 0) 0)
    )
  )
  (fn-do + clear-turn-lazies _
    (param body SyntaxId)
    ; Clears again the flag of each lazy local a block declares in a loop that is evaluated once
    ; a turn, here where the block starts each turn, before any read of it.
    (match? ([] (. tree nodes) body)
      (case (call .node-block row)
        (for (in statement ([] (. tree children) (. row body)))
          (if (not (call is-lazy-local statement))
            (continue)
          )
          (for (in offset (..< 0 (. unit slot-count)))
            (let lazy ([] (. bindings slots) (+ (. unit slot-start) offset)))
            (if (or (!= (. lazy group) statement) (== ([] (. unit lazy-flags) offset) no-local))
              (continue)
            )
            (if (!= (/and/ slot-use (. LazyUseFlag declared-in-loop)) 0)
              (call store-local ([] (. unit lazy-flags) offset) (call integer .machine-u8 0) 0)
            )
            (lazy slot-use (. (call (. bindings lazy-use-of) (+ (. unit slot-start) offset)) flags))
          )
        )
      )
    )
  )
  (fn-do + emit-lazy _
    ; The function of a lazy property: it takes the object and answers the property's value, or
    ; for a struct the address of the value stored in the object, which a read then reads where
    ; it lies, as a stored struct is read. When the object has none yet, the function claims the
    ; property from the runtime, which holds a task that reads it from elsewhere meanwhile until
    ; it has its value, then evaluates the value its class writes, stores it in the object, and
    ; releases the property as there. A read from the task evaluating it evaluates it again. A
    ; value that panics leaves the object without one, and so does one that lets out an error,
    ; which leaves the function with it; either gives up the claim (`abandon-lazy`). A value
    ; whose nested functions read what it declares is evaluated as the getter's own body: the
    ; getter takes the value's instance as its own, makes the environment of the value's scope,
    ; and shares its receiver there, as a method does.
    (let type (. function type))
    (let place (. function place))
    (let property ([] (. types properties) place))
    (let object (if-expr (call (. tables is-class) type) ([] (. tables layouts objects) type) no-layout))
    (let default (call (. tables default-of) type place))
    (= unit (= (. unit source-module) (. default module)))
    (if (or (== object no-layout) (!= (. property storage-kind) .storage-lazy) (== (. default value) 0))
      (call refuse .refused-function (. default site))
      (return)
    )
    (let unit-id (call (. tables value-unit) place))
    (if (and (!= unit-id no-instance) (!= ([] (. tables environments) unit-id) no-layout))
      (call read-instance unit-id)
      (call bind-slots)
      (call clear-lazies)
    )
    (let pair (call (. tables layouts field) object (+ object-header-fields (. property slot))))
    (if (not (call (. tables layouts is-struct) (. pair layout)))
      (call refuse .refused-function (. default site))
      (return)
    )
    (let held (call (. tables layouts field) (. pair layout) 0))
    (let flag (call (. tables layouts field) (. pair layout) 1))
    (let slot (call LayoutField (+ (. pair offset) (. held offset)) (. held layout)))
    (= unit (= (. unit takes-self) true))
    (= unit (= (. unit has-self) true))
    (= unit (= (. unit self-type) type))
    (= unit (= (. unit self) (call make-operand .operand-argument 0)))
    (call (. ir add-argument) managed-layout)
    (= returns-type (. property type))
    (= (. ir returns) (call layout-of (. property type) (. default site)))
    (if (call (. tables layouts is-struct) (. held layout))
      (= (. ir returns) pointer-layout)
    )
    (let raised (call (. tables lazy-function-result) place))
    (if (!= raised no-type)
      (call return-results raised (. default site))
    )
    (let state (call LayoutField (+ (. pair offset) (. flag offset)) (. flag layout)))
    (let claiming (call (. ir reserve-block)))
    (let evaluate (call (. ir reserve-block)))
    (let ready (call (. ir reserve-block)))
    (let given (call load-acquire (. unit self) (. state offset) (. state layout) (. default site)))
    (call branch (call compare (. default site) .compare-equal given (call integer .machine-u8 1)) ready claiming)
    (call (. ir start-block) claiming)
    (let mark (. pending length))
    (+= pending (call address (. unit self) (. state offset) (. state layout) (. default site)))
    (let claim (call call-runtime .runtime-claim-lazy-global (. default site) mark i32-layout))
    (call branch (call compare (. default site) .compare-equal claim (call integer .machine-i32 1)) ready evaluate)
    (call (. ir start-block) evaluate)
    (= lazy-claim state)
    (if (!= (. unit instance) no-instance)
      (call open-environment (. default site))
      (call share-self (. default site))
    )
    (let value (call first-value property place type (. held layout) (. default site)))
    (if (call (. tables layouts is-struct) (. held layout))
      (call store-struct (. unit self) slot (. value operand) (. default site))
      (else-if (!= (. held layout) void-layout)
        (call store (. unit self) (. slot offset) (. value operand) (call is-managed-pointer (. held layout)) (. default site))
      )
    )
    (let released (. pending length))
    (+= pending (call address (. unit self) (. state offset) (. state layout) (. default site)))
    (call call-runtime .runtime-release-lazy-global (. default site) released)
    (call jump ready)
    (call (. ir start-block) ready)
    (if (== (. held layout) void-layout)
      (call return-nothing)
      (else-if (call (. tables layouts is-struct) (. held layout))
        (call return-value (call address (. unit self) (. slot offset) (. held layout) (. default site)) (. default site))
      )
      (else
        (call return-value (call load (. unit self) (. slot offset) (. held layout) (. default site)) (. default site))
      )
    )
  )
  (fn-do + read-lazy Typed
    (param id SyntaxId)
    (param object Operand)
    (param place U32)
    ; Reads a lazy property of an object: the function in the property's slot of the object's
    ; class table is called with the object, and answers the value, which it evaluates when the
    ; object has none yet. A struct is read where the object stores it, at the address the
    ; function answers. The call is checked when the value some class writes may panic,
    ; which the type pass must have said of the reader too. Where the value lets out errors, the
    ; function answers the value or one of them: the errors leave the reader with the read, or
    ; under `catch`, which the type pass typed the read as answering them, are answered.
    (let nothing (call make-operand .operand-void 0))
    (let slot ([] (. tables lazy-slots) place))
    (let property ([] (. types properties) place))
    (let raises (call (. tables lazy-raises) place))
    (let raised (call (. tables lazy-result) place))
    (if (or (and raises (not (. function may-panic)) (not in-landing)) (== raised invalid-type))
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (let caught (and (!= raised no-type) (== (call (. facts node-type) (. unit reading) id) raised)))
    (let returns (call layout-of (if-expr (== raised no-type) (. property type) raised) id))
    (if (and (!= raised no-type) (call (. tables layouts is-struct) (call layout-of (. property type) id)))
      (call refuse .refused-expression id)
    )
    (let table (call load object 0 pointer-layout id))
    (let method (call load table (+ table-header-size (* slot table-slot-size)) pointer-layout id))
    (let mark (. pending length))
    (+= pending object)
    (if in-zone
      (call cross-zone id false)
    )
    (let in-place (and (== raised no-type) (call (. tables layouts is-struct) returns)))
    (let result
      (call call
        (block
          (arg method)
          (arg id)
          (arg mark)
          (arg .callee-value)
          (arg (if-expr in-place pointer-layout returns))
          (arg (and raises (not in-landing)))
        )
      )
    )
    (if in-zone
      (call cross-zone id true)
    )
    (if caught
      (return (call Typed result raised))
    )
    (if (!= raised no-type)
      (return (call propagate-held id raised result))
    )
    (if in-place
      (return (call Typed (call address result 0 returns id) (. property type)))
    )
    (return (call Typed result (. property type)))
  )
  (fn-do + emit-lazy-global _
    ; The function that evaluates a lazy global, which a read calls while the global has no
    ; value. The runtime gives the global to one task to evaluate, and holds a task that reads it
    ; from elsewhere meanwhile until it has its value; a read from the task evaluating it is one
    ; its own value made, and raises a panic. A value that panics leaves the global held so.
    (let kept ([] (. tables storage) (. function place)))
    (let state (call make-operand .operand-symbol (. kept state)))
    (= unit (= (. unit source-module) (. kept module)))
    (= unit (= (. unit reading) ([] (. tables main-instances) (. kept module))))
    (match? ([] (. ([] (. program modules) (. kept module)) decls) (. kept decl))
      (case (call .decl-property property)
        (let syntax (. property syntax))
        (let ready (call (. ir reserve-block)))
        (let unready (call (. ir reserve-block)))
        (let busy (call (. ir reserve-block)))
        (let evaluate (call (. ir reserve-block)))
        (let mark (. pending length))
        (+= pending state)
        (let claim (call call-runtime .runtime-claim-lazy-global syntax mark i32-layout))
        (call branch (call compare syntax .compare-equal claim (call integer .machine-i32 1)) ready unready)
        (call (. ir start-block) ready)
        (call return-nothing)
        (call (. ir start-block) unready)
        (call branch (call compare syntax .compare-equal claim (call integer .machine-i32 2)) busy evaluate)
        (call (. ir start-block) busy)
        (call raise-text syntax (str "Global '" (call (. tables global-name) kept) "' is read before it is initialized"))
        (call (. ir start-block) evaluate)
        (call store-global kept (. (call global-value kept property) operand) syntax)
        (let released (. pending length))
        (+= pending state)
        (call call-runtime .runtime-release-lazy-global syntax released)
      )
    )
    (call return-nothing)
  )
  (fn-do + read-lent-lazy Typed
    (param slot SlotId)
    (param id SyntaxId)
    (param type TypeId)
    ; A lazy local of the function whose syntax is read for another, which no environment keeps:
    ; one each read evaluates is evaluated in place, and one evaluated once by the cells
    ; `open-lent-lazies` gave it, typed as the instance that declares it typed it. A read the type
    ; pass narrowed is of what the local holds. One whose value is being evaluated, one declared
    ; with others, and one with no cells, have no shape here.
    (let nothing (call make-operand .operand-void 0))
    (for (in open lazy-open)
      (if (== open slot)
        (call refuse .refused-expression id)
        (return (call Typed nothing no-type))
      )
    )
    (let binding (. ([] (. instances rows) (. unit reading)) binding))
    (let held (call (. facts slot-type) (. unit reading) (- slot (. ([] (. bindings bindings) binding) slots start))))
    (let group (. ([] (. bindings slots) slot) group))
    (let policy (call (. bindings lazy-policy) slot))
    (let position (. lent-lazies length))
    (let kept false)
    (while (and (!= position 0) (not kept))
      (-= position 1)
      (= kept (== (. ([] lent-lazies position) slot) slot))
    )
    (let narrowed (and (!= held type) (call holds held type)))
    (let typed
      (block
        (or (== held type) (and narrowed (or (== shared-depth 0) (call (. facts is-inside-read) (. unit reading) id))))
      )
    )
    (if (or (not typed) (== held no-type) (call (. bindings lazy-together) slot) (and (!= policy .lazy-inline) (not kept)))
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (match? ([] (. tree nodes) group)
      (case (call .node-declare row)
        (let name (. row left))
        (let annotation SyntaxId 0)
        (match? ([] (. tree nodes) (. row left))
          (case (call .node-type-capture capture)
            (= name (. capture id))
            (= annotation (. capture type))
          )
        )
        (if (and (is ([] (. tree nodes) name) .node-identifier) (!= (. row right) 0))
          (let ready (if-expr kept (call (. ir reserve-block)) no-block))
          (if kept
            (let evaluate (call (. ir reserve-block)))
            (call branch (call load-local (. ([] lent-lazies position) flag) id) ready evaluate)
            (call (. ir start-block) evaluate)
          )
          (+= lazy-open slot)
          (let value (call declared-value name annotation (. row right) held))
          (call (. lazy-open pop))
          (call claim-lazy group (. value operand) held)
          (if kept
            (if (!= (. ([] lent-lazies position) cell) no-local)
              (call store-local (. ([] lent-lazies position) cell) (. value operand) id)
            )
            (call store-local (. ([] lent-lazies position) flag) (call integer .machine-u8 1) id)
            (call jump ready)
            (call (. ir start-block) ready)
            (= value
              (scope (if-expr (!= (. ([] lent-lazies position) cell) no-local) (call Typed (call load-local cell id) held) (call Typed nothing held))
                (lazy cell (. ([] lent-lazies position) cell))
              )
            )
          )
          (if narrowed
            (return (call payload id (call Typed (. value operand) held)))
          )
          (return (call Typed (. value operand) held))
        )
      )
    )
    (call refuse .refused-expression id)
    (return (call Typed nothing no-type))
  )
  (fn-do _ open-lent-lazies _
    (param value SyntaxId)
    (param site SyntaxId)
    ; Gives each lazy local declared inside the value of a lazy local that a function written in the
    ; one declaring them evaluates, which no environment keeps and which is evaluated once, the
    ; flag that says whether it has its value and the cell that holds the value, both cleared here
    ; where the value starts: every read of it lies in the value. A function written in the value
    ; declares its own.
    (let binding (. ([] (. instances rows) (. unit reading)) binding))
    (if (== binding no-binding)
      (return)
    )
    (let bound (. ([] (. bindings bindings) binding) slots))
    (let low (call (. tree subtree-start) value))
    (for (in offset (..< 0 (. bound count)))
      (let slot (+ (. bound start) offset))
      (let row ([] (. bindings slots) slot))
      (if (or (!= (. row kind) .slot-lazy) (!= (call (. bindings lazy-policy) slot) .lazy-memo) (call is-captured slot))
        (continue)
      )
      (if (or (< (. row syntax) low) (> (. row syntax) value) other-scope)
        (continue)
      )
      (lazy other-scope (!= ([] (. tables slot-functions) slot) ([] (. tables instance-scopes) (. unit reading))))
      (let layout (call layout-of (call (. facts slot-type) (. unit reading) offset) site))
      (let flag (call (. ir add-local) u8-layout))
      (call store-local flag (call integer .machine-u8 0) site)
      (let cell (if-expr (!= layout void-layout) (call (. ir add-local) layout true) no-local))
      (if (!= cell no-local)
        (call zero
          (block
            (arg
              (call make-operand
                (block
                  (arg .operand-value)
                  (arg (call append .op-local-address site (call Span) cell pointer-layout))
                )
              )
            )
            (arg layout)
          )
        )
      )
      (+= lent-lazies (call LentLazy slot flag cell))
    )
  )
  (fn-do _ close-lent-lazies _
    (param mark Size)
    ; Drops the cells `open-lent-lazies` gave past a mark.
    (while (> (. lent-lazies length) mark)
      (call (. lent-lazies pop))
    )
  )
  (fn-do + read-lazy-local Typed
    (param slot SlotId)
    (param id SyntaxId)
    (param type TypeId)
    ; The value of a lazy local, evaluated where the binding's policy for it says: by this read
    ; each time it runs, by the first read emitted each time that one runs, or by whichever read
    ; runs first, which tests the local's flag and sets it. The value is evaluated in place, so
    ; one read in several places is evaluated in each. A local whose value is being evaluated
    ; is not read by that value. One whose value lets errors out, read where other transformers
    ; are declared than where it was typed, has no shape here. In a function that yields, whose
    ; environment keeps its locals from step to step, one evaluated once is kept there with its
    ; flag, as one nested functions capture is; one a loop declares, whose flag each turn clears,
    ; has no shape there. One held as an eager local is (`holds-lazy`) is read as `read-held` says,
    ; or where the function keeps it in a local, as one evaluated once.
    (let nothing (call make-operand .operand-void 0))
    (if (call (. facts lazy-unheld) (. unit reading) slot)
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (let held (call (. tables holds-lazy) slot))
    (let policy (if-expr held (. LazyPolicy lazy-memo) (call (. bindings lazy-policy) slot)))
    (let is-open false)
    (for (in open lazy-open)
      (if (== open slot)
        (= is-open true)
      )
    )
    (if (and held (not is-open) (call is-captured slot))
      (return (call read-held slot id type))
    )
    (if (and (== policy .lazy-shared) (not is-open))
      (return (call read-shared slot id type))
    )
    (let offset (call slot-offset slot id))
    (if (and (. filling storing) (not is-open))
      (return (call read-filling slot offset id type))
    )
    (if (or (== policy .lazy-unsettled) is-open)
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (if (and (not held) (call evaluates-in-place slot policy id type))
      (return (call evaluate-in-place slot type))
    )
    (if (and (== policy .lazy-memo) (call is-captured slot) outside-loop)
      (return (call read-shared slot id type))
    )
    (lazy outside-loop (== (/and/ (. (call (. bindings lazy-use-of) slot) flags) (. LazyUseFlag declared-in-loop)) 0))
    (if (== policy .lazy-memo)
      (let flag ([] (. unit lazy-flags) offset))
      (if (== flag no-local)
        (call refuse .refused-expression id)
        (return (call Typed nothing no-type))
      )
      (if (call evaluated-before flag)
        (return (call read-local slot id type))
      )
      (let evaluate (call (. ir reserve-block)))
      (let ready (call (. ir reserve-block)))
      (call branch (call load-local flag id) ready evaluate)
      (call (. ir start-block) evaluate)
      (let wavers (call read-wavers slot id))
      (if wavers
        (+= shared-depth 1)
      )
      (call evaluate-lazy slot offset id)
      (if wavers
        (-= shared-depth 1)
      )
      (call store-local flag (call integer .machine-u8 1) id)
      (call jump ready)
      (call (. ir start-block) ready)
      (+= ready-lazies (call ReadyLazy flag ready))
      (else
        (if (and (== policy .lazy-first-read) (== ([] (. unit lazy-readers) offset) 0))
          (= ([] (. unit lazy-readers) offset) id)
        )
        (if (or (== policy .lazy-inline) (== ([] (. unit lazy-readers) offset) id))
          (call evaluate-lazy slot offset id)
        )
      )
    )
    (return (call read-local slot id type))
  )
  (fn-do _ evaluates-in-place Bool
    (param slot SlotId)
    (param policy LazyPolicy)
    (param id SyntaxId)
    (param type TypeId)
    (let once (or (== policy .lazy-inline) (and (== policy .lazy-memo) (call (. bindings lazy-reads-once) slot))))
    (if (or (not once) (not (call is-own-slot slot)) (call is-captured slot) (call (. bindings lazy-together) slot))
      (return false)
    )
    (if (or (call read-wavers slot id) (call (. facts address-claim-of) (. unit reading) (. ([] (. bindings slots) slot) group)))
      (return false)
    )
    (let kept (call (. facts slot-type) (. unit instance) (- slot (. unit slot-start))))
    (if (or (!= kept type) (== type no-type) (== type invalid-type))
      (return false)
    )
    (match? ([] (. tree nodes) (. ([] (. bindings slots) slot) group))
      (case (call .node-declare row)
        (let named (. row left))
        (match? ([] (. tree nodes) (. row left))
          (case (call .node-type-capture capture)
            (= named (. capture id))
          )
        )
        (return (and (!= (. row right) 0) (is ([] (. tree nodes) named) .node-identifier)))
      )
    )
    (return false)
  )
  (fn-do _ evaluate-in-place Typed
    (param slot SlotId)
    (param type TypeId)
    (let nothing (call make-operand .operand-void 0))
    (match? ([] (. tree nodes) (. ([] (. bindings slots) slot) group))
      (case (call .node-declare row)
        (let named (. row left))
        (let annotation SyntaxId 0)
        (match? ([] (. tree nodes) (. row left))
          (case (call .node-type-capture capture)
            (= named (. capture id))
            (= annotation (. capture type))
          )
        )
        (+= lazy-open slot)
        (let value (call declared-value named annotation (. row right) type))
        (call (. lazy-open pop))
        (return value)
      )
    )
    (return (call Typed nothing type))
  )
  (fn-do _ shared-evaluated-before Bool
    (param slot SlotId)
    ; Whether an evaluation of a lazy local nested functions capture, emitted in the function, ended
    ; in a block every way here passes (`evaluated-before`).
    (for (in position (..< 0 (. shared-ready length)))
      (if (and (== (. ([] shared-ready position) slot) slot) ready-before)
        (return true)
      )
      (lazy ready-before (call (. ir dominates) (. ([] shared-ready position) block) (. ir current)))
    )
    (return false)
  )
  (fn-do _ read-held Typed
    (param slot SlotId)
    (param id SyntaxId)
    (param type TypeId)
    ; The value of a lazy local held as an eager local is (`holds-lazy`), which the environment of
    ; the function that declares it holds with no flag. That function gives it its value at its
    ; first read, or where it makes a nested function that reads it (`force-held`), and keeps the
    ; flag that says it has one; any other function reads it as it reads a captured local, since
    ; the function that declares it made that one after the local had its value.
    (let nothing (call make-operand .operand-void 0))
    (if (and (call owns slot) (== (. unit reading) (. unit instance)))
      (call force-held slot id)
    )
    (return (call read-captured slot id type))
  )
  (fn-do _ read-shared Typed
    (param slot SlotId)
    (param id SyntaxId)
    (param type TypeId)
    ; The value of a lazy local that nested functions capture. Its environment holds it, and after
    ; it the byte that says whether it has its value, which arrives cleared with the environment.
    ; Whichever read runs first, in the function that declares the local or in one written in it,
    ; evaluates the value there and sets the byte. The value is typed by the instance that declares
    ; the local, so a nested function reads that instance's facts while it evaluates it; one that
    ; returns nothing is evaluated for what it does, and a closable one is claimed as `claim-lazy`
    ; says. What the flow knows in the value holds wherever it is evaluated, unless the type pass
    ; found a read where a local the value reads is known otherwise than at the first.
    ; A constructor whose properties read such a local, or make a nested function, has no shape
    ; where its body reads one too. The value of a live declaration is evaluated in a live action
    ; whose trackers note what it reads, and the action is then made with the function that runs the
    ; declaration again, as `own-declared` makes it; one evaluated by a function written in the one
    ; that declares it, or in a turn of a loop that keeps an environment, has no shape here. The
    ; function that runs a statement of that one again reads it as it is: each read there is plain,
    ; so the statement's first run gave it its value.
    (let nothing (call make-operand .operand-void 0))
    (let field (call find-captured slot id))
    (let owner home-owner)
    (let declared (call (. tables live-statement-of) owner (. ([] (. bindings slots) slot) group)))
    (if (and declared (!= (. declared rerun) no-instance) (!= owner (. unit instance)) (call reruns-in owner))
      (return (call read-captured slot id type))
    )
    (if (or (call (. facts lazy-unheld) owner slot) (!= ([] (. tables capture-rows) owner) no-place))
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (if (and (not (. filling storing)) (== owner (. unit instance)) (call fills-share))
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (if (call shared-evaluated-before slot)
      (return (call read-captured slot id type))
    )
    (let flag (call lazy-flag slot id))
    (let evaluate (call (. ir reserve-block)))
    (let ready (call (. ir reserve-block)))
    (call branch (call load (call captured-base id) (. flag offset) (. flag layout) id) ready evaluate)
    (call (. ir start-block) evaluate)
    (let group (. ([] (. bindings slots) slot) group))
    (let row ([] (. tree nodes) group))
    (let live (call (. tables live-statement-of) owner group))
    (let trackers no-local)
    (if live
      (if (or (!= owner (. unit instance)) (!= (. open-turns length) 0) (== (. live rerun) no-instance))
        (call refuse .refused-expression id)
        (return (call Typed nothing no-type))
      )
      (= trackers (call open-trackers id))
      (+= live-actions (call LiveTrackers trackers trackers))
    )
    (let own-unit unit)
    (if (!= owner (. unit instance))
      (= unit (= (. unit lender) owner))
      (= unit (= (. unit reading) owner))
    )
    (let wavers
      (scope (or (call (. facts lazy-wavers) owner slot) dominated-read)
        (lazy dominated-read
          (block
            (and (== (. own-unit reading) (. unit instance)) (call (. facts is-dominated-read) (. unit instance) id))
          )
        )
      )
    )
    (if wavers
      (+= shared-depth 1)
    )
    (+= sharing 1)
    (+= lazy-open slot)
    (let initial nothing)
    (match row
      (case (call .node-declare declaration)
        (let name (. declaration left))
        (let annotation SyntaxId 0)
        (match? ([] (. tree nodes) (. declaration left))
          (case (call .node-type-capture capture)
            (= name (. capture id))
            (= annotation (. capture type))
          )
        )
        (if (or (== (. field type) no-type) (== (. field type) invalid-type))
          (call refuse .refused-expression id)
          (else-if (call (. bindings lazy-together) slot)
            (call share-together (. declaration left) (. declaration right) id)
          )
          (else-if (== (. declaration right) 0)
            (= initial (. (call default-value annotation (. field type) (. field layout) id) operand))
          )
          (else
            (let opened (. lent-lazies length))
            (if (!= owner (. unit instance))
              (call open-lent-lazies (. declaration right) id)
            )
            (= initial (. (call declared-value name annotation (. declaration right) (. field type)) operand))
            (call close-lent-lazies opened)
            (call claim-lazy group initial (. field type))
          )
        )
      )
      (default
        (call refuse .refused-expression id)
      )
    )
    (call (. lazy-open pop))
    (if wavers
      (-= shared-depth 1)
    )
    (-= sharing 1)
    (= unit own-unit)
    (if live
      (call (. live-actions pop))
    )
    (if (not (call (. bindings lazy-together) slot))
      (call keep-captured slot initial (. field type) id)
      (call settle-shared slot id)
    )
    (if live
      (call own-declared id live trackers)
    )
    (call jump ready)
    (call (. ir start-block) ready)
    (+= shared-ready (call SharedReady slot ready))
    (return (call read-captured slot id type))
  )
  (fn-do + claim-lazy _
    (param group SyntaxId)
    (param value Operand)
    (param type TypeId)
    ; A closable value a lazy declaration holds, given where it is evaluated to the innermost markup
    ; element being built, or else the object `self` names, as the type pass claimed it
    ; (`AddressClaim`): made a `Closable` at the declaration and given to the `ClosableTracker`
    ; recorded there, which is made a `Tracker` and added to the trackers of a live action of that
    ; object, whose callback does nothing. Where neither is in force, nothing owns it.
    (let claimed (call (. facts address-claim-of) (. unit reading) group))
    (if (or (not claimed) (and (== (. content-hosts length) 0) (not (and (. unit has-self) (call (. tables is-class) (. unit owner-type))))))
      (return)
    )
    (let closable (call convert group .reason-argument (call Typed value type)))
    (let mark (. pending length))
    (+= pending (. closable operand))
    (let tracker (call call-instance (. claimed closer) group mark))
    (let given (call convert group .reason-argument tracker))
    (let trackers (call open-trackers group))
    (call add-tracker (call load-local trackers group) (. given operand) group)
    (do
      (inline
        (call own-callback (call load-local trackers group) idle (call integer .machine-managed-pointer 0) group
          (block
            (lazy idle (. tables idle-action))
          )
        )
      )
    )
  )
  (fn-do _ own-declared _
    (param id SyntaxId)
    (param live LiveStatement)
    (param trackers LocalId)
    ; The live action of a lazy declaration whose value read something tracked, made once the value
    ; is kept, with the trackers the value noted and a callback that runs the declaration again
    ; with the environment in force here: it is owned by the innermost markup element being built,
    ; or else by the object `self` names, and made as the type pass chose for an owner of that type
    ; (`LiveStatement`). It is made at whichever read evaluates the value first; at a read where no
    ; object is in force, it is a plain one, owned by nothing.
    (let code (call (. tables live-adapter-of) ([] (. tables instance-functions) (. live rerun))))
    (let top (. content-hosts length))
    (let owner (if-expr (!= top 0) (. ([] content-hosts (- top 1)) operand) (. unit self)))
    (let holder
      (scope (if-expr (!= top 0) (. ([] content-hosts (- top 1)) type) own-holder)
        (lazy own-holder
          (block
            (case? (and (. unit has-self) (call (. tables is-class) (. unit owner-type)))
              (. unit owner-type)
            )
            (default
              no-type
            )
          )
        )
      )
    )
    (if (and (!= holder (. live holder)) (!= holder no-type))
      (call refuse .refused-expression id)
      (return)
    )
    (if (or (== (. live owned) no-instance) (!= holder (. live holder)))
      (let action (call make-action (call load-local trackers id) code (call written-environment id) id))
      (if (!= holder no-type)
        (call attach-action owner (. action operand) id)
      )
      (return)
    )
    (let callback (call make-callback code (call written-environment id) id))
    (let given
      (call convert
        (block
          (arg (. live site))
          (arg (if-expr (. live rooted) .reason-markup-batch .reason-markup-host))
          (arg (call Typed owner holder))
        )
      )
    )
    (let mark (. pending length))
    (+= pending (call load-local trackers id))
    (+= pending callback)
    (+= pending (. given operand))
    (let action (call raising-call (. live site) (. live owned) mark))
    (call attach-action owner (. action operand) id)
  )
  (fn-do _ share-together _
    (param left SyntaxId)
    (param value SyntaxId)
    (param site SyntaxId)
    ; Evaluates the value of lazy locals declared together that an environment holds, and stores
    ; each first field of it in the field of the local its name declares, with the byte after it
    ; set. A name written as `_` takes nothing. A field of another type than its local's, a name
    ; written as a tuple, and locals declared together with no value have no shape here.
    (let names (call (of RowRange SyntaxId)))
    (match? ([] (. tree nodes) left)
      (case (call .node-tuple-syntax row)
        (= names (. row items))
      )
      (case (call .node-type-tuple row)
        (= names (. row field-types))
      )
    )
    (if (or (== value 0) (== (. names count) 0))
      (call refuse .refused-expression site)
      (return)
    )
    (let source (call emit-expression value))
    (let owner (. source type))
    (let layout (call layout-of owner site))
    (if (or (not (call (. tables layouts is-struct) layout)) (< (. ([] (. tables layouts rows) layout) fields count) (. names count)))
      (call refuse .refused-expression site)
      (return)
    )
    (let binding (. ([] (. instances rows) (. unit reading)) binding))
    (for (in position (..< 0 (. names count)))
      (let name ([] (. tree children) (+ (. names start) position)))
      (let skipped false)
      (match? ([] (. tree nodes) name)
        (case (call .node-type-capture row)
          (= name (. row id))
        )
        (case .node-type-wildcard
          (= skipped true)
        )
      )
      (if skipped
        (continue)
      )
      (let resolution (call (. bindings resolution-of) binding name))
      (if (or (!= (. resolution kind) .resolve-slot) (!= (. ([] (. bindings slots) (. resolution slot)) kind) .slot-lazy))
        (call refuse .refused-expression name)
        (return)
      )
      (let part (call take (. source operand) (call (. tables layouts field) layout position) site))
      (call keep-captured (. resolution slot) part (call field-type owner position) site)
      (call settle-shared (. resolution slot) site)
    )
  )
  (fn-do + settle-shared _
    (param slot SlotId)
    (param site SyntaxId)
    ; Says a lazy local an environment holds has its value: sets the byte after it.
    (call find-captured slot site)
    (let flag (call lazy-flag slot site))
    (let base (call captured-base site))
    (call store base (. flag offset) (call integer .machine-u8 1) false site)
  )
  (fn-do + unsettle-shared _
    (param slot SlotId)
    (param site SyntaxId)
    (call find-captured slot site)
    (let flag (call lazy-flag slot site))
    (let base (call captured-base site))
    (call store base (. flag offset) (call integer .machine-u8 0) false site)
  )
  (fn-do _ lazy-flag LayoutField
    (param slot SlotId)
    (param site SyntaxId)
    ; The byte that says a lazy local `find-captured` has just found has its value: the field
    ; after the local's in the environment that holds it, the function's or that of a turn of
    ; a loop.
    (let place (+ 2 ([] (. tables slot-fields) slot)))
    (if (or (== home-layout no-layout) (>= place (. ([] (. tables layouts rows) home-layout) fields count)))
      (call refuse .refused-expression site)
      (return (call LayoutField 0 void-layout))
    )
    (return (call (. tables layouts field) home-layout place))
  )
  (fn-do _ read-filling Typed
    (param slot SlotId)
    (param offset U32)
    (param id SyntaxId)
    (param type TypeId)
    ; The value of a lazy local read while a constructor gives the properties their first values:
    ; whichever such read runs first evaluates it, into a cell of its own, and sets its flag. The
    ; body's reads evaluate the value again, as the binding's policy says. A tracked read of one
    ; tracks nothing, since nothing stores to it. A local that a nested function reads has no shape
    ; here, nor has one declared together with others.
    (let nothing (call make-operand .operand-void 0))
    (let flag ([] (. unit fill-flags) offset))
    (if (or (== flag no-local) (!= (/and/ (. ([] (. bindings slots) slot) flags) (. SlotFlag slot-captured)) 0))
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (if (call (. bindings lazy-together) slot)
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (let own ([] (. unit cells) offset))
    (= ([] (. unit cells) offset) ([] (. unit fill-cells) offset))
    (let evaluate (call (. ir reserve-block)))
    (let ready (call (. ir reserve-block)))
    (call branch (call load-local flag id) ready evaluate)
    (call (. ir start-block) evaluate)
    (+= shared-depth 1)
    (call evaluate-lazy slot offset id)
    (-= shared-depth 1)
    (let value nothing)
    (call store-local flag (call integer .machine-u8 1) id)
    (call jump ready)
    (call (. ir start-block) ready)
    (let localed (call read-local slot id type))
    (= value (. localed operand))
    (= ([] (. unit fill-cells) offset) ([] (. unit cells) offset))
    (= ([] (. unit cells) offset) own)
    (return (call Typed value (. localed type)))
  )
  (fn-do _ evaluate-lazy _
    (param slot SlotId)
    (param offset U32)
    (param site SyntaxId)
    ; Evaluates the value a lazy local is declared with and stores it in the local's cell, which
    ; it is given the first time. The value is converted to the type written for the local, and
    ; one with no value written is what its type has for one; a closable one is claimed as
    ; `claim-lazy` says. The locals a declaration names together are declared together, as where
    ; the declaration is not lazy.
    (let group (. ([] (. bindings slots) slot) group))
    (if (call (. bindings lazy-together) slot)
      (match? ([] (. tree nodes) group)
        (case (call .node-declare row)
          (let opened (. lazy-open length))
          (for (in position (..< 0 (. unit slot-count)))
            (if (== (. ([] (. bindings slots) (+ (. unit slot-start) position)) group) group)
              (+= lazy-open (+ (. unit slot-start) position))
            )
          )
          (call emit-declare group (. row left) (call (. tree machine-or-value) (. row left) (. row right)))
          (while (!= (. lazy-open length) opened)
            (call (. lazy-open pop))
          )
          (return)
        )
      )
    )
    (+= lazy-open slot)
    (match ([] (. tree nodes) group)
      (case (call .node-declare row)
        (let name (. row left))
        (let annotation SyntaxId 0)
        (match? ([] (. tree nodes) (. row left))
          (case (call .node-type-capture capture)
            (= name (. capture id))
            (= annotation (. capture type))
          )
        )
        (let type (call (. facts slot-type) (. unit instance) offset))
        (let plain false)
        (match? ([] (. tree nodes) name)
          (case .node-identifier
            (= plain true)
          )
        )
        (if (or (not plain) (== type no-type) (== type invalid-type))
          (call refuse .refused-expression site)
        )
        (let layout (call layout-of type site))
        (let initial
          (match (. row right)
            (case= 0
              (call default-value annotation type layout site)
            )
            (default
              (call declared-value name annotation (. row right) type)
            )
          )
        )
        (if (!= (. row right) 0)
          (call claim-lazy group (. initial operand) type)
        )
        (if (!= layout void-layout)
          (if (== ([] (. unit cells) offset) no-local)
            (let taken (!= (/and/ (. ([] (. bindings slots) slot) flags) (. SlotFlag slot-address-taken)) 0))
            (= ([] (. unit cells) offset) (call (. ir add-local) layout taken))
          )
          (call store-local ([] (. unit cells) offset) (. initial operand) site)
        )
      )
      (default
        (call refuse .refused-expression site)
      )
    )
    (call (. lazy-open pop))
  )
  (fn-do + logic-lazy SlotId
    (param name SyntaxId)
    (param site SyntaxId)
    (param is-right Bool)
    (if (or (== name 0) (== (. unit instance) no-instance) (!= (. unit reading) (. unit instance)) (. filling storing))
      (return no-slot)
    )
    (let resolution (call (. bindings resolution-of) (. ([] (. instances rows) (. unit instance)) binding) name))
    (if (!= (. resolution kind) .resolve-slot)
      (return no-slot)
    )
    (let slot (. resolution slot))
    (let policy (call (. bindings lazy-policy) slot))
    (let once (or (== policy .lazy-inline) (and (== policy .lazy-memo) (call (. bindings lazy-reads-once) slot))))
    (if (or (!= (. ([] (. bindings slots) slot) kind) .slot-lazy) (not once) (not (call is-own-slot slot)) (call is-captured slot))
      (return no-slot)
    )
    (if (or (call (. tables holds-lazy) slot) (call (. bindings lazy-together) slot) (call (. facts lazy-unheld) (. unit reading) slot))
      (return no-slot)
    )
    (if (call read-wavers slot name)
      (return no-slot)
    )
    (for (in open lazy-open)
      (if (== open slot)
        (return no-slot)
      )
    )
    (let declared (call (. tree lazy-value) (. ([] (. bindings slots) slot) group)))
    (if (or (== declared 0) (not (call (. tree is-logic) declared)))
      (return no-slot)
    )
    (match? ([] (. tree nodes) (. ([] (. bindings slots) slot) group))
      (case (call .node-declare row)
        (let named (. row left))
        (let annotation SyntaxId 0)
        (match? ([] (. tree nodes) (. row left))
          (case (call .node-type-capture capture)
            (= named (. capture id))
            (= annotation (. capture type))
          )
        )
        (let plain (is ([] (. tree nodes) named) .node-identifier))
        (if (and plain (or (== annotation 0) (== (call (. facts first-conversion) (. unit reading) annotation) no-fact)))
          (let kept (call (. facts slot-type) (. unit instance) (- slot (. unit slot-start))))
          (if (call reads-plainly name declared kept site is-right)
            (return slot)
          )
        )
      )
    )
    (return no-slot)
  )
  (fn-do _ reads-plainly Bool
    (param name SyntaxId)
    (param declared SyntaxId)
    (param kept TypeId)
    (param site SyntaxId)
    (param is-right Bool)
    (if (or (!= kept (. types bool-type)) (and (!= (. pins length) 0) (or (call pin-of name) (call pin-of declared))))
      (return false)
    )
    (if (!= (call (. facts first-conversion) (. unit reading) name) no-fact)
      (return false)
    )
    (if (!= (call (. facts first-conversion) (. unit reading) declared) no-fact)
      (return false)
    )
    (let truth (if-expr (== site 0) (call truth-call name false false) (call truth-call site true is-right)))
    (if (or (!= truth no-fact) (!= (call (. facts answer-type) (. unit reading) name) kept))
      (return false)
    )
    (return (== (call (. facts answer-type) (. unit reading) declared) kept))
  )
  (fn-do + is-lazy-local Bool
    (param statement SyntaxId)
    ; Whether a statement declares a lazy local, or a local of a row of a markup loop region read
    ; as a getter, which emits nothing where it stands.
    (match? ([] (. tree nodes) statement)
      (case (call .node-declare row)
        (return (or (. row is-lazy) (call declares-getter (. row left))))
      )
    )
    (return false)
  )
  (fn-do + shared-slot SlotId
    ; The lazy local whose value is being evaluated by a function written in the one that declares
    ; it (`read-shared`), where that one has an environment, which holds the local; or none. One
    ; declared inside that value and evaluated with it, which no environment keeps, is passed over.
    (if (or (== (. unit reading) (. unit instance)) (== sharing 0) (== (. lazy-open length) 0) no-environment)
      (return no-slot)
    )
    (lazy no-environment (== ([] (. tables environments) (. unit reading)) no-layout))
    (let position (. lazy-open length))
    (while (!= position 0)
      (-= position 1)
      (if (call is-captured ([] lazy-open position))
        (return ([] lazy-open position))
      )
    )
    (return no-slot)
  )
  (fn-do + shared-written SlotId
    (param id SyntaxId)
    ; The lazy local a nested function is written as the value of, while a function written in
    ; the one that declares the local evaluates it, as `read-shared` does; or none. One whose
    ; function keeps the state of a global `do with` binds has no shape there.
    (if (or (and (== shared-depth 0) (== sharing 0)) (== (. lazy-open length) 0) (call (. tables holds-stacks) (. unit reading)))
      (return no-slot)
    )
    (let slot ([] lazy-open (- (. lazy-open length) 1)))
    (match? ([] (. tree nodes) (. ([] (. bindings slots) slot) group))
      (case (call .node-declare declaration)
        (if (and (== (. declaration right) id) (call is-captured slot))
          (return slot)
        )
      )
    )
    (return no-slot)
  )
  (fn-do + shares-lazy Bool
    ; Whether the function declares a lazy local that nested functions capture.
    (for (in offset (..< 0 (. unit slot-count)))
      (let slot (+ (. unit slot-start) offset))
      (if (and (== (. ([] (. bindings slots) slot) kind) .slot-lazy) (call is-captured slot))
        (return true)
      )
    )
    (return false)
  )
  (fn-do + abandon-lazy _
    (param site SyntaxId)
    ; Gives up the claim a lazy property's function took on its object (`emit-lazy`) where the
    ; value panics or lets out an error, so that a task the runtime holds on the property, or the
    ; next read, evaluates it again. The runtime does nothing where the property is not claimed.
    (return-if (if (== (. lazy-claim layout) no-layout)))
    (blank)
    (let mark (. pending length))
    (+= pending (call address (. unit self) (. lazy-claim offset) (. lazy-claim layout) site))
    (call call-runtime .runtime-abandon-lazy-global site mark)
  )
)
