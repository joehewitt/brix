./layouts
/core/arena
/core/map
/core/table
/lang/backend/mir
/lang/check/table-rows
/lang/check/type-store
/lang/check/type-text
/lang/check/types

+ inline-budget U32 = 16

━━━━━━━━━━━━━━━━━━━━
+ TableRegion is U8

` Where a table of union rows keeps a field of a case: in the column of a field every case
` shares, among the row's inline bytes, or among the bytes outside the row its handle leads to.

| region-common = 0
| region-inline = 1
| region-external = 2

━━━━━━━━━━━━━━━━━━━━
+ UnionField is Struct

` Where a table of union rows keeps a field of a case: `slot` is its place in the case's own
` layout, `offset` where it lies in its region, and `column` the column of a shared field.

+ slot U32
+ region TableRegion
+ offset U32
+ column U32
+ is-hot Bool

━━━━━━━━━━━━━━━━━━━━
+ UnionCase is Struct

` A case of a union a table's rows hold: its fields in the order the case declares them, and
` the bytes of its own fields kept inline and outside the row.

+ type TypeId
+ fields Span
+ inline-size U32
+ inline-alignment U32
+ external-size U32
+ external-alignment U32

━━━━━━━━━━━━━━━━━━━━
+ UnionLayout is Struct

` How a table keeps rows of a union, as TypeScript lays it out: the tag in column 0, then a
` column for each field every case shares, the inline bytes of each row, and the handle of
` the bytes each row keeps outside it, in a buffer the directory's last slot holds. `columns`
` is how many slots the directory has; `commons` are the shared fields of the first case.

+ union TypeId
+ controlled Bool
+ commons Span
+ cases Span
+ inline-column U32 = U32.max
+ inline-stride U32
+ inline-alignment U32 = 1
+ handle-column U32 = U32.max
+ external-column U32 = U32.max
+ external-stride U32
+ external-alignment U32 = 1
+ columns U32 = 1

━━━━━━━━━━━━━━━━━━━━
+ UnionTables

` The layout of each union the rows of a table hold, built once before emission and read by
` every worker, with the text each gives for `.layout`: `fixed-texts` for a table that does
` not grow, and `growing-texts` for one that grows in an arena.

+ layouts Table'UnionLayout
+ cases Table'UnionCase
+ fields Table'UnionField
+ fixed-texts [String]
+ growing-texts [String]

_ rows Map'Size'U32'ArenaBacking
_ types Types
_ values Layouts
_ sizes [U32]
_ alignments [U32]
_ taken [Bool]
_ best [U32]
_ found Bool
_ best-size U32
_ best-count U32
_ budget U32
_ prefix-sizes [U32]
_ prefix-alignments [U32]

────────────────────
+ This
    - types Types
    - values Layouts
    - arena Arena

.. layouts = Table'UnionLayout(arena, 4)
.. cases = Table'UnionCase(arena, 4)
.. fields = Table'UnionField(arena, 16)
.. rows = Map'Size'U32(arena)

────────────────────
+ of U32
    - union TypeId

` The place of a union's layout among `layouts`, or `U32.max` where no table holds it.
rows[union] ?? U32.max

────────────────────
+ do build

` Lays out each union a table, a row, a span or a selection holds rows of.
for id in types.ranked
    . row = row-union(types, id as TypeId)
    if row != no-type && rows[row] == null
        lay-out(row)

────────────────────
_ is-done Bool
    - type TypeId

` Whether a type was completed before the store was sealed, which emission may read.
completed(types, type)

────────────────────
_ do lay-out
    - union TypeId

` Lays out a union's rows as TypeScript's `createTableUnionLayout` does. A union one of whose
` cases has no layout yet is left out, and a table of it has no shape.
. held = types.cases-of(union)
if held.length == 0
    =
for fact in held
    if fact.is-default || !is-done(fact.type)
        =
    . layout = values.values[fact.type]
    if layout == no-layout || !values.is-struct(layout)
        =
. first = held[0].type
. commons-start = fields.length as U32
for property in types.properties-of(first)
    if property.storage-kind == .storage-eager && is-common-field(types, union, property)
        . column = (fields.length as U32) - commons-start + 1
        fields.append(UnionField(property.slot, .region-common, 0, column, false))
. commons = Span(commons-start, (fields.length as U32) - commons-start)
. controlled = false
for fact in held
    for property in types.properties-of(fact.type)
        if own-field(union, property) && is-hot-field(types, property)
            controlled = true
. stride = inline-budget
if controlled
    . hot-size U32
    . hot-alignment U32 = 1
    for fact in held
        clear-fields()
        for property in types.properties-of(fact.type)
            if own-field(union, property) && is-hot-field(types, property)
                add-field(fact.type, property)
        . hot = region(sizes, alignments)
        hot-size = larger(hot-size, hot.size)
        hot-alignment = larger(hot-alignment, hot.alignment)
    stride = align-to(larger(inline-budget, hot-size), hot-alignment)
. cases-start = cases.length as U32
. any-inline = false
. inline-alignment U32 = 1
. external-stride U32
. external-alignment U32 = 1
. widest U32
for fact in held
    . laid = lay-out-case(union, fact.type, controlled, stride, commons)
    any-inline = any-inline || laid.inline-size > 0
    widest = larger(widest, laid.inline-size)
    inline-alignment = larger(inline-alignment, laid.inline-alignment)
    external-stride = larger(external-stride, laid.external-size)
    external-alignment = larger(external-alignment, laid.external-alignment)
    cases.append(laid)
external-stride = align-to(external-stride, external-alignment)
. made = UnionLayout
    - union
    - controlled
    - commons
    - Span(cases-start, (cases.length as U32) - cases-start)
made.inline-alignment = inline-alignment
made.external-alignment = external-alignment
. next = commons.count + 1
if any-inline
    made.inline-column = next
    made.inline-stride = smaller(stride, align-to(widest, inline-alignment))
    next += 1
if external-stride != 0
    made.handle-column = next
    made.external-stride = external-stride
    next += 1
    made.external-column = next
    next += 1
made.columns = next
rows[union] = layouts.length as U32
layouts.append(made)
fixed-texts += fixed-text(made)
growing-texts += growing-text(made)

────────────────────
_ own-field Bool
    - union TypeId
    - property TypeProperty

` Whether a case keeps a field of its own, which the table packs: one stored, which not every
` case shares.
property.storage-kind == .storage-eager && !is-common-field(types, union, property)

────────────────────
_ do lay-out-case UnionCase
    - union TypeId
    - type TypeId
    - controlled Bool
    - stride U32
    - commons Span

` Lays out a case's own fields: the shared ones in their columns, and the rest packed, the hot
` ones first where any field is hot. The others pack in the order the case declares them, or
` from the widest alignment down where that leaves fewer bytes or fields outside.
. own [TypeProperty]
. sorted [TypeProperty]
. hot [TypeProperty]
for property in types.properties-of(type)
    if own-field(union, property)
        if controlled && is-hot-field(types, property)
            hot += property
        else
            own += property
            sorted.insert(property, placed(type, sorted, property))
prefix-sizes.clear()
prefix-alignments.clear()
for property in hot
    . field = values.field(values.values[type], property.slot)
    prefix-sizes += values.rows[field.layout].size
    prefix-alignments += values.rows[field.layout].alignment
pack-fields(type, own, stride)
. declared-size = best-size
. declared-count = best-count
pack-fields(type, sorted, stride)
if best-size < declared-size || (best-size == declared-size && best-count < declared-count)
    own = sorted
else
    pack-fields(type, own, stride)
. inline-sizes [U32]
. inline-alignments [U32]
. external-sizes [U32]
. external-alignments [U32]
for position in 0 .. < prefix-sizes.length
    inline-sizes += prefix-sizes[position]
    inline-alignments += prefix-alignments[position]
. chosen = 0
for position in 0 .. < own.length
    if chosen < best.length && best[chosen] == position as U32
        inline-sizes += sizes[position]
        inline-alignments += alignments[position]
        chosen += 1
    else
        external-sizes += sizes[position]
        external-alignments += alignments[position]
. inline = region(inline-sizes, inline-alignments)
. external = region(external-sizes, external-alignments)
. start = fields.length as U32
for property in types.properties-of(type)
    if property.storage-kind != .storage-eager
        continue
    if !own-field(union, property)
        . column = common-column(union, commons, property)
        fields.append(UnionField(property.slot, .region-common, 0, column, false))
        continue
    . hot-at = hot-place(hot, property)
    if hot-at != U32.max
        fields.append(UnionField(property.slot, .region-inline, inline.offsets[hot-at], 0, true))
        continue
    . position = own-place(own, property)
    . is-hot = controlled && is-hot-field(types, property)
    if best-has(position)
        . offset = inline.offsets[prefix-sizes.length + inline-rank(position)]
        fields.append(UnionField(property.slot, .region-inline, offset, 0, is-hot))
    else
        fields.append
            - UnionField
                - property.slot
                - .region-external
                - external.offsets[position - inline-rank(position)]
                - 0
                - is-hot
= UnionCase
    - type
    - Span(start, (fields.length as U32) - start)
    - inline.size
    - inline.alignment
    - external.size
    - external.alignment

────────────────────
_ do common-column U32
    - union TypeId
    - commons Span
    - property TypeProperty

` The column of a shared field: that of the first case's field of the same name.
. first = types.cases-of(union)[0].type
for position in 0 .. < commons.count
    . common = fields[commons.start + position]
    for candidate in types.properties-of(first)
        if candidate.slot == common.slot && candidate.name == property.name
            = common.column
= 0

────────────────────
_ do pack-fields
    - type TypeId
    - own [TypeProperty]
    - stride U32

` Packs a case's own fields in the order given.
clear-fields()
for property in own
    add-field(type, property)
pack(stride)

────────────────────
_ do placed Index
    - type TypeId
    - own [TypeProperty]
    - property TypeProperty

` Where a field goes among a case's own fields sorted from the widest alignment down, after
` those as wide.
. aligned = alignment-of(type, property)
for position in 0 .. < own.length
    if alignment-of(type, own[position]) < aligned
        = position
= own.length

────────────────────
_ alignment-of U32
    - type TypeId
    - property TypeProperty

values.rows[values.field(values.values[type], property.slot).layout].alignment

────────────────────
_ hot-place U32
    - hot [TypeProperty]
    - property TypeProperty

` The place of a hot field among a case's hot fields, or `U32.max`.
place-of(hot, property)

────────────────────
_ own-place U32
    - own [TypeProperty]
    - property TypeProperty

place-of(own, property)

────────────────────
_ do place-of U32
    - list [TypeProperty]
    - property TypeProperty

for position in 0 .. < list.length
    if list[position].slot == property.slot && list[position].name == property.name
        = position as U32
= U32.max

────────────────────
_ do best-has Bool
    - position U32

for each in best
    if each == position
        = true
= false

────────────────────
_ do inline-rank U32
    - position U32

` How many of the fields packed inline come before a field.
. rank U32
for each in best
    if each < position
        rank += 1
= rank

────────────────────
_ do clear-fields

sizes.clear()
alignments.clear()

────────────────────
_ do add-field
    - type TypeId
    - property TypeProperty

. field = values.field(values.values[type], property.slot)
sizes += values.rows[field.layout].size
alignments += values.rows[field.layout].alignment

────────────────────
_ do pack
    - stride U32

` Chooses the fields kept inline within a budget, as TypeScript's `tableUnionPackCase` does:
` every set is tried, each field left out before it is taken in; a set is kept where it fits
` and the budget is a multiple of its alignment, and the one kept leaves the fewest bytes
` outside, then the fewest fields, then has the earliest fields first. A set whose first fields
` already leave more outside than the one kept is not tried further, as no set it grows into is
` kept.
budget = stride
found = false
best.clear()
taken.clear()
for position in 0 .. < sizes.length
    taken += false
. offset U32
. alignment U32 = 1
for position in 0 .. < prefix-sizes.length
    alignment = larger(alignment, prefix-alignments[position])
    offset = align-to(offset, prefix-alignments[position]) + prefix-sizes[position]
choose(0, offset, alignment, 0, 1, 0)

────────────────────
_ do choose
    - index U32
    - offset U32
    - alignment U32
    - outside U32
    - outside-alignment U32
    - count U32

` Tries the sets that take in or leave out each field from `index` on, with the fields before
` laid out inline to `offset` and outside to `outside`, `count` of them.
if align-to(offset, alignment) > budget
    =
if found && (outside > best-size || (outside == best-size && count > best-count))
    =
if index < sizes.length as U32
    . size = sizes[index]
    . aligned = alignments[index]
    choose
        - index + 1
        - offset
        - alignment
        - align-to(outside, aligned) + size
        - larger(outside-alignment, aligned)
        - count + 1
    taken[index] = true
    choose
        - index + 1
        - align-to(offset, aligned) + size
        - larger(alignment, aligned)
        - outside
        - outside-alignment
        - count
    taken[index] = false
    =
if budget % alignment != 0
    =
. external = align-to(outside, outside-alignment)
if found
    if external > best-size
        =
    if external == best-size
        if count > best-count
            =
        if count == best-count && !comes-first()
            =
found = true
best-size = external
best-count = count
best.clear()
for position in 0 .. < sizes.length
    if taken[position]
        best += position as U32

────────────────────
_ do comes-first Bool

` Whether the fields taken in come before the best set so far, by the first field they differ in.
. position = 0
for index in 0 .. < sizes.length
    if taken[index]
        if position >= best.length
            = false
        if index as U32 != best[position]
            = (index as U32) < best[position]
        position += 1
= false

────────────────────
_ do region Region
    - sizes [U32]
    - alignments [U32]

` Lays out fields in turn, as TypeScript's `tableUnionRegionLayout` does.
. offsets [U32]
. offset U32
. alignment U32 = 1
for position in 0 .. < sizes.length
    alignment = larger(alignment, alignments[position])
    offset = align-to(offset, alignments[position])
    offsets += offset
    offset += sizes[position]
= Region(offsets, align-to(offset, alignment), alignment)

────────────────────
_ do fixed-text String
    - made UnionLayout

` The text `.layout` gives for a table of the union that does not grow.
. lines = ["Table'${type-runtime-name(types, made.union)}", packing-text(made), "tag column[0] U8"]
for position in 0 .. < made.commons.count
    . common = fields[made.commons.start + position]
    . field = values.field(values.values[types.cases-of(made.union)[0].type], common.slot)
    . name = slot-name(types.cases-of(made.union)[0].type, common.slot)
    lines += "common column[${common.column}] $name ${type-runtime-name(types, field.type)}"
if made.inline-column != U32.max
    lines += "inline column[$column] stride=${made.inline-stride} align=${made.inline-alignment}"
    .. column = made.inline-column
if made.handle-column != U32.max
    lines += "spill-handles column[${made.handle-column}] U32 offset+1"
    lines += "external arena stride=${made.external-stride} align=${made.external-alignment}"
case-lines(made, lines)
= "\n".join(lines)

────────────────────
_ do growing-text String
    - made UnionLayout

` The text `.layout` gives for a table of the union that grows in an arena.
. lines = ["Table'${type-runtime-name(types, made.union)}", "storage arena-growable", "row-layout union", packing-text(made), "growth shared geometric", "region column[0] tag width=1 align=1"]
. first = types.cases-of(made.union)[0].type
for position in 0 .. < made.commons.count
    . common = fields[made.commons.start + position]
    . field = values.field(values.values[first], common.slot)
    . row = values.rows[field.layout]
    lines += "region column[${common.column}] common $name width=${row.size} align=${row.alignment}"
    .. name = slot-name(first, common.slot)
if made.inline-column != U32.max
    lines += "region column[${made.inline-column}] inline width=$width align=$inline-align"
    .. width = made.inline-stride
    .. inline-align = made.inline-alignment
if made.handle-column != U32.max
    lines += "region column[${made.handle-column}] spill-handles width=4 align=4"
    lines += "compact external column[$column] offset+1 U32 limit=4294967295 align=$external-align"
    .. column = made.external-column
    .. external-align = made.external-alignment
case-lines(made, lines)
= "\n".join(lines)

────────────────────
_ packing-text String
    - made UnionLayout

if made.controlled then "packing controlled @hot" else "packing automatic budget=$inline-budget"

────────────────────
_ do case-lines
    - made UnionLayout
    - lines [String]

for position in 0 .. < made.cases.count
    . held = cases[made.cases.start + position]
    . fact = types.cases-of(made.union)[position]
    . name = if fact.name then fact.name!.text else ""
    lines += "case $position $name ${type-runtime-name(types, held.type)}"
    for offset in 0 .. < held.fields.count
        . field = fields[held.fields.start + offset]
        . place = values.field(values.values[held.type], field.slot)
        . located = place-text(field)
        . hot = if made.controlled && outside-common && field.is-hot then " @hot" else ""
            .. outside-common = field.region != .region-common
        lines += "  ${field-name} ${type-runtime-name(types, place.type)} $located$hot"
        .. field-name = slot-name(held.type, field.slot)

────────────────────
_ place-text String
    - field UnionField

|? field.region == .region-common
    "common[${field.column}]"
|? field.region == .region-inline
    "inline+${field.offset}"
??
    "external+${field.offset}"

────────────────────
_ do slot-name String
    - type TypeId
    - slot U32

` The name of the field at a place of a tuple's layout.
for property in types.properties-of(type)
    if property.storage-kind == .storage-eager && property.slot == slot
        = property.name.text
= "field $slot"

━━━━━━━━━━━━━━━━━━━━
+ row-union TypeId
    - types Types
    - type TypeId

` The union a table, a row, a span or a selection holds rows of, or no type where it holds none.
|? !completed(types, type)
    no-type
|? kind != .table && kind != .immutable-table && not-row && !spans
    no-type
|? !completed(types, row) || types.completions[row].intrinsic != .union
    no-type
??
    row

.. kind = types.completions[type].intrinsic
.. not-row = kind != .table-row && kind != .immutable-table-row
.. spans = kind == .table-span || kind == .immutable-table-span || kind == .table-selection || kind == .immutable-table-selection
.. row = class-arg(types, type, 0)

━━━━━━━━━━━━━━━━━━━━
+ table-row TypeId
    - types Types
    - type TypeId

` The type of the rows a table holds, or no type for any other type.
|? !completed(types, type) || types.completions[type].intrinsic != .table
    no-type
|? !completed(types, row)
    no-type
??
    row

.. row = class-arg(types, type, 0)

━━━━━━━━━━━━━━━━━━━━
+ align-to U32
    - offset U32
    - alignment U32

` An offset moved up to the next multiple of an alignment.
if alignment <= 1 then offset else (offset + alignment - 1) / alignment * alignment

━━━━━━━━━━━━━━━━━━━━
_ Region is Tuple

` Fields laid out in turn, each at the next offset its alignment allows: where each lies, and
` the size and alignment of the whole.

+ offsets [U32]
+ size U32
+ alignment U32

━━━━━━━━━━━━━━━━━━━━
_ completed Bool
    - types Types
    - type TypeId

` Whether a type was completed before the store was sealed, which emission may read.
type != no-type && type != invalid-type && types.completions[type].completion == .completion-done

━━━━━━━━━━━━━━━━━━━━
_ larger U32
    - left U32
    - right U32

if left > right then left else right

━━━━━━━━━━━━━━━━━━━━
_ smaller U32
    - left U32
    - right U32

if left < right then left else right
