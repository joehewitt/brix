              (arg (. ([] place-trackers index) place))
              (arg (. ([] place-trackers index) trackers))
              (arg (. filling type))
              (arg site)
            )
          )
        )
      )
    )
    (call (. place-trackers clear))
  )
  (fn-do + subscribe-value _
    (param place U32)
