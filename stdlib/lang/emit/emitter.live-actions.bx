      (call refuse .refused-statement site)
      (return)
    )
    (lazy other-self (!= broadcaster (. ([] (. instances rows) callee) self-type)))
    (let raising (!= (. ([] (. instances signatures) callee) errors count) 0))
    (let mark (. pending length))
    (+= pending stream)
    (+= pending given)
    (= takes-result raising)
    (let answer (call call-instance callee site mark false true))
    (= takes-result false)
    (if raising
      (do
        (inline (call report-result site (. ([] (. instances signatures) callee) result) (. answer operand) true))
      )
    )
  )
  (fn-do + emit-retest _
    (param clause SyntaxId)
    ; The function a live action runs to test a `whenever` clause again, given the environment the
    ; loop was written in, as the reference's closure does: the clause's value, with the trackers
    ; of the action that runs it noting what it reads, is compared with the one the clause last
    ; gave, kept where the loop was written. Where it differs it is kept instead, and the
    ; subscription kept there is given to the broadcaster's `subscribe` where the value holds, or
    ; else to its `unsubscribe`, as `call-subscription` says. Where an object owns the
    ; subscription, the clause is tested as `retrack` says instead.
    (let live (. instances live))
    (let calls (call (. facts whenever-calls-of) (. unit instance)))
    (let slot (call channel-slot clause))
    (if (or (== (. live previous) no-instance) (== (. live next) no-instance) (not calls) (== slot no-slot))
      (call refuse .refused-function clause)
      (return)
    )
    (let previous (call (. ir add-local) managed-layout))
    (call store-local previous (. (call call-instance (. live previous) clause (. pending length)) operand) clause)
    (let next (call (. ir add-local) managed-layout))
    (call store-local next (. (call call-instance (. live next) clause (. pending length)) operand) clause)
    (+= live-actions (call LiveTrackers previous next))
    (let passed (call emit-expression (call (. tree clause-expr) clause)))
    (call (. live-actions pop))
    (if (. calls owns)
      (call retrack clause (+ slot 1) (. passed operand) next)
      (return)
    )
    (let last (call read-captured slot clause (. types bool-type)))
    (let wrapped (. (call find-captured (+ slot 1) clause) type))
    (let broadcaster (. (call find-captured (+ slot 2) clause) type))
    (let changing (call (. ir reserve-block)))
    (let done (call (. ir reserve-block)))
    (call branch (call compare clause .compare-not-equal (. passed operand) (. last operand)) changing done)
    (call (. ir start-block) changing)
    (call keep-captured slot (. passed operand) (. types bool-type) clause)
    (let stream (call read-captured (+ slot 2) clause broadcaster))
    (let subscription (call read-captured (+ slot 1) clause wrapped))
    (let given (call convert clause .reason-argument (call Typed (. subscription operand) wrapped)))
    (let given-type (. given type))
    (let adding (call (. ir reserve-block)))
    (let dropping (call (. ir reserve-block)))
    (call branch (. passed operand) adding dropping)
    (call (. ir start-block) adding)
    (call call-subscription clause (. calls subscribe) (. stream operand) broadcaster (. given operand) given-type)
    (call jump done)
    (call (. ir start-block) dropping)
    (call call-subscription clause (. calls unsubscribe) (. stream operand) broadcaster (. given operand) given-type)
    (call jump done)
    (call (. ir start-block) done)
    (call emit-end clause)
