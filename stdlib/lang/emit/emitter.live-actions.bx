      (return false)
    )
    (match? ([] (. ([] (. program modules) (. ([] (. instances rows) (. unit instance)) module)) decls) (. ([] (. instances rows) (. unit instance)) decl))
      (case (call .decl-function fn)
        (return (== (. fn kind) .live-decl))
      )
    )
    (return false)
  )
  (fn-do _ store-again _
    (param statement SyntaxId)
    (param kept SyntaxId)
    (param name Atom)
