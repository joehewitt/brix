    (let list (call local-subscribers slot site))
    (let mark (. pending length))
    (+= pending list)
    (+= pending (call make-operand .operand-constant (call (. ir add-string) (. ([] (. bindings slots) slot) name text))))
    (do
      (inline (call call-instance (. live dispatch) site mark))
    )
    (call jump done)
    (call (. ir start-block) done)
  )
  (fn-do + emit-tracked-get Typed
    (param id SyntaxId)
    (param object SyntaxId)
    (param name Atom)
    ; A tracked read of a stored property of an object in a live action: the object is read once,
    ; the read is noted in the action's trackers, and the property is read from the object. An
    ; object written as a member of the receiver or a local named alone is tracked as it is read,
    ; as the reference tracks the start of the chain. Any other tracked read has no shape there.
    (let owner (call held-type object))
    (let fact (call own-call id))
    (let getter (and (!= fact no-fact) (== (. ([] (. facts calls) fact) form) .call-getter)))
    (if (or (== owner no-type) (== owner invalid-type) (not (call (. tables is-class) owner)) planned getter)
      (call refuse .refused-expression id)
      (return (call Typed (call make-operand .operand-void 0) no-type))
    )
    (lazy planned (!= (call (. facts plan-of) (. unit reading) id) .plan-none))
    (let root (call tracked-root object))
    (if (and root (not (call pin-of object)))
      (call track object (. unit self) root)
    )
    (let local (if-expr (not (call pin-of object)) (call tracked-root-local object) no-slot))
    (if (and (!= local no-slot) (not (call settles-once local)) (!= (. live-actions length) 0))
      (let list (call local-subscribers local object))
      (call track-in object list list (. ([] (. bindings slots) local) name))
    )
    (let base (call emit-expression object))
    (call track id (. base operand) name)
    (let value (call load-property id (. base operand) owner name))
    (call track-collection id value)
    (return value)
  )
  (fn-do _ settles-once Bool
    (param slot SlotId)
    ; Whether a local is a lazy one whose declaration no live action runs again, so that nothing
    ; stores to it after its value is evaluated and a read of it tracks nothing.
    (let row ([] (. bindings slots) slot))
    (if (!= (. row kind) .slot-lazy)
      (return false)
    )
    (let binding (. ([] (. instances rows) (. unit reading)) binding))
    (let nested (. ([] (. bindings bindings) binding) nested))
    (for (in offset (..< 0 (. nested count)))
      (let held ([] (. bindings nested) (+ (. nested start) offset)))
      (if (== (. held syntax) (. row group))
        (match? ([] (. ([] (. program modules) (. unit source-module)) decls) (. held decl))
          (case (call .decl-function fn)
            (if (== (. fn kind) .live-decl)
              (return false)
            )
          )
        )
      )
    )
    (return true)
  )
  (fn-do + tracked-root (? Atom)
    (param object SyntaxId)
    ; The name of the member of the receiver a tracked read reads from, where its object is that
    ; member named alone and untracked, or none.
    (let binding (. ([] (. instances rows) (. unit reading)) binding))
    (if (== binding no-binding)
      (return null)
    )
    (match? ([] (. tree nodes) object)
      (case (call .node-identifier row)
        (if (and (not (. row is-tracked)) (== (. (call (. bindings resolution-of) binding object) kind) .resolve-member))
          (return (. row name))
        )
      )
    )
    (return null)
  )
  (fn-do _ tracked-root-local SlotId
    (param object SyntaxId)
    ; The local a tracked read reads from, where its object is that local named alone and
    ; untracked, or none.
    (match? ([] (. tree nodes) object)
      (case (call .node-identifier row)
        (if (not (. row is-tracked))
          (return (call tracked-local object))
        )
      )
    )
    (return no-slot)
  )
  (fn-expr + tracks Bool
    (param property TypeProperty)
    ; Whether some read tracks a property, by the topmost class that declares it (`tracked-root`),
    ; which an override shares.
    (case? (or (== (. property owner) no-type) (== (. property owner) invalid-type) undispatched)
      false
    )
    (default
      (call (. facts is-tracked) (. ref module) (. ref decl) (. property name))
    )
    (where
      (lazy undispatched (== (. instances live dispatch) no-instance))
      (lazy ref (call class-ref types (call (. types tracked-root) (. property owner) (. property name))))
    )
  )
  (fn-do + keeps-trackers Bool
    (param place U32)
    ; Whether the trackers of a property's own live action are kept (`place-trackers`).
    (for (in kept place-trackers)
      (if (== (. kept place) place)
        (return true)
      )
    )
    (return false)
  )
  (fn-do + tracks-link Bool
    (param id SyntaxId)
    ; Whether a link of an optional chain is a tracked read made in a live action.
    (if (== (. live-actions length) 0)
      (return false)
    )
    (match? ([] (. tree nodes) id)
      (case (call .node-get-expression row)
        (return (. row is-tracked))
      )
    )
    (return false)
  )
  (fn-do + emit-latest Typed
    (param id SyntaxId)
    (param value SyntaxId)
    ; The latest item of a stream, `##` of it, as the reference reads it in a live action. Where
    ; the action is made, the stream is made a `Broadcastable` and given, with the empty value of
    ; its item, to a `BroadcasterTracker`, which is kept in the local the node declares and added
    ; to the action's trackers, and the read is that empty value. The function that runs the
    ; action again adds the tracker it captures to its trackers and reads its `latest`. A read
    ; where no action is open, or in a function written in the action, has no shape here.
    (let nothing (call make-operand .operand-void 0))
    (let row (call (. facts latest-read-of) (. unit reading) id))
    (let binding (. ([] (. instances rows) (. unit reading)) binding))
    (if (or (not row) (== binding no-binding) (== (. live-actions length) 0))
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (let resolution (call (. bindings resolution-of) binding id))
    (if (!= (. resolution kind) .resolve-slot)
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (let slot (. resolution slot))
    (let item (call (. facts node-type) (. unit reading) id))
    (let tracking (. ([] (. instances signatures) (. row tracker)) returns))
    (let trackers (. ([] live-actions (- (. live-actions length) 1)) next))
    (let own (and (call is-own-slot slot) (call owns slot)))
    (if (and rerunning (not own))
      (let kept (call read-captured slot id tracking))
      (call add-tracker
        (block
          (arg (call load-local trackers id))
          (arg (. (call convert id .reason-argument (call Typed (. kept operand) tracking)) operand))
          (arg id)
        )
      )
      (return (call load-property id (. kept operand) tracking (call (. program store-atom) "latest") false item))
    )
    (if (or rerunning (not own))
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (let held (call emit-expression value))
    (let stream (call Typed nothing no-type))
    (if (!= (. row publisher) no-instance)
      (let mark (. pending length))
      (+= pending (. (call convert value .reason-argument held) operand))
      (= stream (call call-instance (. row publisher) id mark))
      (else
        (= stream (call convert value .reason-argument held))
      )
    )
    (if (!= (. stream type) (. row stream))
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (let latest (call default-value 0 item (call layout-of item id) id))
    (let making (. pending length))
    (+= pending (. stream operand))
    (+= pending (. latest operand))
    (let made (call call-instance (. row tracker) id making))
    (call keep-captured slot (. made operand) tracking id)
    (call add-tracker
      (block
        (arg (call load-local trackers id))
        (arg (. (call convert id .reason-argument (call Typed (. made operand) tracking)) operand))
        (arg id)
      )
    )
    (return (call Typed (. latest operand) item))
  )
  (fn-do _ unit-machine (? MachineFact)
    (param unit-id InstanceId)
    ; The state machine of a property that the instance typing its value starts, or none.
    (for (in machine (. facts machines))
      (let member (and (== (. machine store) .store-member) (== (. machine outer) 0)))
      (if (and member (== (. ([] (. instances rows) (. machine instance)) enclosing) unit-id))
        (return machine)
      )
    )
    (return null)
  )
)
