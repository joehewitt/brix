        (arg (. U32 max))
        (arg false)
        (arg (call memo-flag-of type property))
      )
    )
  )
  (fn-do _ store-back _
    (param anchor SyntaxId)
    (param statement SyntaxId)
    ; A binding's element given again to its place, as its property changes: the property is read
    ; from the element's object, kept where the element was made, in the action's trackers, and
    ; stored in the place as an assignment to it stores. Where the type pass recorded a conversion
    ; back, the value stored is given back to the element, which then shows what the place holds.
    (let slot (call channel-slot statement))
    (let name (call (. tree identifier-name) anchor))
    (if (or (== slot no-slot) (not name))
      (call refuse .refused-statement statement)
      (return)
    )
    (let type (. (call find-captured slot anchor) type))
    (let place (call (. types property-named) type name))
    (let held (if-expr (call (. tables is-class) type) ([] (. tables layouts objects) type) no-layout))
    (if (or (not place) (== held no-layout) (!= (. ([] (. types properties) place) storage-kind) .storage-eager))
      (call refuse .refused-statement statement)
      (return)
    )
    (let property ([] (. types properties) place))
    (let object (call read-captured slot anchor type))
    (call track anchor (. object operand) name)
    (let read (call load-property anchor (. object operand) type name true))
    (let tracking (call (. live-actions pop)))
    (let unwraps (and (call (. types is-optional) (. read type)) (== (call (. facts node-type) (. unit reading) anchor) (call (. types optional-inner) (. read type)))))
    (let onward (if-expr unwraps (call (. ir reserve-block)) no-block))
    (if unwraps
      (let filled (call (. ir reserve-block)))
      (call branch (. (call present anchor read) operand) filled onward)
      (call (. ir start-block) filled)
    )
    (let value (if-expr unwraps (call payload anchor read) read))
    (let mark (. pins length))
    (call pin anchor (. value operand) (. value type))
    (match? ([] (. tree nodes) statement)
      (case (call .node-assign row)
        (let assignment (call emit-assign anchor .eq-op (. row rhs) anchor))
        (call unpin mark)
        (if (and (not unwraps) (!= (. assignment stored type) no-type) (!= (. assignment stored type) (. property type)))
          (let back (call convert statement .reason-assignment (. assignment stored)))
          (if (== (. back type) (. property type))
            (call put-property
              (block
                (arg (. object operand))
                (arg (call (. tables layouts field) held (+ object-header-fields (. property slot))))
                (arg property)
                (arg (. back operand))
                (arg statement)
                (arg (. U32 max))
                (arg false)
                (arg (call memo-flag-of type property))
              )
            )
          )
        )
      )
    )
    (if unwraps
      (call jump onward)
      (call (. ir start-block) onward)
    )
    (+= live-actions tracking)
  )
  (fn-do _ set-again _
    (param statement SyntaxId)
    (param target SyntaxId)
    (param rhs SyntaxId)
    (param callee InstanceId)
    (let slot (call channel-slot statement))
    (if (or (== slot no-slot) (== callee no-instance) (not (call is-callable callee)) other-arity)
      (call refuse .refused-statement statement)
      (return)
    )
    (lazy other-arity (!= (. ([] (. instances signatures) callee) args count) 1))
    (let type (. (call find-captured slot statement) type))
    (let given (call convert rhs .reason-argument (call emit-expression rhs)))
    (if (!= (. given type) (call (. instances argument-type) callee 0))
      (call refuse .refused-conversion statement)
      (return)
    )
    (let object (call read-captured slot statement type))
    (let receiver (call convert target .reason-receiver (call Typed (. object operand) type)))
    (if (!= (. receiver type) (. ([] (. instances rows) callee) self-type))
      (call refuse .refused-conversion statement)
      (return)
    )
    (let mark (. pending length))
    (+= pending (. receiver operand))
    (+= pending (. given operand))
    (call call-method callee target mark)
  )
  (fn-do _ replaces Bool
    (param statement SyntaxId)
    ; Whether a line of a markup element's body that a live action gives again replaces what the
    ; element took, rather than being absorbed again.
    (let slot (call line-keeper statement))
    (if (== slot no-slot)
      (return false)
    )
    (let found (call find-captured (+ slot 1) statement))
    (return (!= (. found type) (. types void-type)))
  )
  (fn-do _ replace-again _
    (param statement SyntaxId)
    ; A line of a markup element's body given again in place of what the element took before, as
    ; the reference's replacer gives it: the element's object and what it took, kept where the
    ; element was made, are read, and the line's value is made the node a markup host's
    ; `markup-content` makes of it, which the markup runtime's `markup-replace` puts in place of the
    ; one before, or is given with the one before to the element's `replace`, whose answer, where it
    ; gives one, is kept in place of the value. What was taken before is closed, by its `close` or
    ; by closing each action it owns, and what is kept now is kept in its place.
    (let nothing (call make-operand .operand-void 0))
    (let slot (call line-keeper statement))
    (let link (call (. facts content-link-of) (. unit reading) statement))
    (if (or (== slot no-slot) (== link (. U32 max)))
      (call refuse .refused-statement statement)
      (return)
    )
    (let row ([] (. facts content-links) link))
    (let kept-slot (as (+ slot 1) SlotId))
    (let held (call find-captured slot statement))
    (let object (call read-captured slot statement (. held type)))
    (let earlier (call find-captured kept-slot statement))
    (let previous (call read-captured kept-slot statement (. earlier type)))
    (+= content-hosts (call Typed (. object operand) (. held type)))
    (let value (call emit-expression statement))
    (call (. content-hosts pop))
    (let kept value)
    (let kept-type (. kept type))
    (if (!= (. row append) no-instance)
      (let given (call convert statement .reason-argument (call Typed (. value operand) (. kept type))))
      (if (!= (. given type) (. row taken))
        (call refuse .refused-conversion statement)
      )
      (= kept
        (call call-protocol
          (block
            (arg statement)
            (arg (. row call))
            (arg (. object operand))
            (arg (. row parent))
            (arg (. given operand))
            (arg (. row taken))
            (arg false)
          )
        )
      )
      (= kept-type (. kept type))
      (let mark (. pending length))
      (+= pending (. object operand))
      (+= pending (. previous operand))
      (+= pending (. kept operand))
      (do
        (inline (call call-instance (. row append) statement mark))
      )
      (else
        (let answer
          (call call-protocol
            (block
              (arg statement)
              (arg (. row call))
              (arg (. object operand))
              (arg (. row parent))
              (arg (. previous operand))
              (arg (. earlier type))
              (arg false)
              (arg (. value operand))
              (arg kept-type)
            )
          )
        )
        (if (!= (. answer type) (. types void-type))
          (= kept answer)
          (= kept-type (. kept type))
        )
      )
    )
    (if (!= (. row close) no-fact)
      (do
        (inline (call call-protocol statement (. row close) (. previous operand) (. earlier type) nothing))
      )
      (else
        (call close-actions statement (. previous operand))
      )
    )
    (call keep-captured kept-slot (. kept operand) kept-type statement)
  )
  (fn-do _ absorb-again _
    (param statement SyntaxId)
    ; A line of a markup element's body that gives content, given the element again, as the
    ; reference's absorber gives it: the element's object, kept at the line where the element was
    ; made, is the element being built while the line runs as content, as the type pass typed it.
    (let slot (call line-keeper statement))
    (let link (call (. facts content-link-of) (. unit reading) statement))
    (if (or (== slot no-slot) (== link (. U32 max)))
      (call refuse .refused-statement statement)
      (return)
    )
    (let found (call find-captured slot statement))
    (let object (call read-captured slot statement (. found type)))
    (+= content-hosts (call Typed (. object operand) (. found type)))
    (call emit-content statement ([] (. facts content-links) link))
    (call (. content-hosts pop))
  )
  (fn-do _ declare-again _
    (param statement SyntaxId)
    (param left SyntaxId)
    (param right SyntaxId)
    ; A lazy declaration run again, as the reference's `var` function runs it: its value is
    ; evaluated and stored in the local it declares, held by the environment of the function that
    ; declares it, which then has its value; the store runs the actions that read the local where
    ; its bits change, as an assignment's does. One that holds a struct has no shape here where a
    ; read tracks it.
    (let slot (call declared-slot statement))
    (if (or (== slot no-slot) (not (call is-captured slot)))
      (call refuse .refused-statement statement)
      (return)
    )
    (let field (call find-captured slot statement))
    (let value (call declared-value left 0 right (. field type)))
    (let watched (call watches slot statement))
    (if (and watched (call (. tables layouts is-struct) (. field layout)))
      (call refuse .refused-statement statement)
    )
    (let prior
      (scope (if-expr watched (. (call read-captured slot statement (. field type)) operand) no-prior)
        (lazy no-prior (call make-operand .operand-void 0))
      )
    )
    (call keep-captured slot (. value operand) (. field type) statement)
    (call settle-shared slot statement)
    (if watched
      (call dispatch-local
        (block
          (arg slot)
          (arg prior)
          (arg (. (call read-captured slot statement (. field type)) operand))
          (arg (. field type))
          (arg statement)
        )
      )
    )
  )
  (fn-do _ declared-slot SlotId
    (param statement SyntaxId)
    ; The lazy local a declaration declares, of those the function's binding holds, or none.
    (for (in offset (..< 0 (. unit slot-count)))
      (let row ([] (. bindings slots) (+ (. unit slot-start) offset)))
      (if (and (== (. row kind) .slot-lazy) (== (. row group) statement))
        (return (+ (. unit slot-start) offset))
      )
    )
    (return no-slot)
  )
  (fn-do + run-class-rules _
    (param type TypeId)
    (param site SyntaxId)
    ; Runs each rule of the class of the object a constructor has made, and of the classes above
    ; it, base first, once the constructor's body has run, as the reference runs them: each in a
    ; live action of its own whose trackers note what it reads, which is then the object's. What
    ; the rule keeps for the object is made here, holding the object, and is the data of the
    ; action's callback, which runs the rule again. A rule is read through the facts of the
    ; instance that types it, and a local it declares has no shape here. A section the event
    ; runtime runs from the table of the class is not subscribed. A state machine a property holds
    ; starts among them (see `start-member-machine`). The queries of the markup the
    ; object is in that each class declares are registered once its rules have run, and then its
    ; style defaults are declared (see `register-queries`, `apply-style-defaults`).
    (let chain (list TypeId))
    (let level (? TypeId) type)
    (while (and level (call (. tables is-class) level))
      (+= chain level)
      (= level (call (. types base-of) level))
    )
    (let next U32)
    (for (in index (call (. tables class-rules-of) type))
      (let rule ([] (. tables class-rules) index))
      (while (and (< next (. chain length)) (!= ([] chain (- (. chain length) 1 next)) (. rule level)))
        (call register-queries ([] chain (- (. chain length) 1 next)))
        (call apply-style-defaults ([] chain (- (. chain length) 1 next)))
        (+= next 1)
      )
      (if (== next (. chain length))
        (call refuse .refused-function site)
        (break)
      )
      (if (is ([] (. ([] (. program modules) (. rule module)) tree nodes) (. rule syntax)) .node-state-machine)
        (call start-member-machine type rule site)
        (continue)
      )
      (call run-class-rule rule (call (. facts lowers) type (. rule module) (call section-of rule)) site)
    )
    (while (< next (. chain length))
      (call register-queries ([] chain (- (. chain length) 1 next)))
      (call apply-style-defaults ([] chain (- (. chain length) 1 next)))
      (+= next 1)
    )
  )
  (fn-do _ start-member-machine _
    (param type TypeId)
    (param rule ClassRule)
    (param site SyntaxId)
    ; Starts a state machine a property of the object's class holds, as the reference starts it
    ; once the constructor's body has run: through the facts of the instance that types the
    ; property's value for the object's class. The machine keeps its value in the property. Where
    ; the class refines the machine of its base's property, the machine it refines starts with it
    ; (`start-refined`), and not by a rule of its own.
    (let name (call decl-name (. rule module) (. rule decl)))
    (let found (only-if (call property-of type name) (if name)))
    (let unit-id (if-expr found (call (. tables value-unit) (as found U32)) no-instance))
    (if (== unit-id no-instance)
      (call refuse .refused-function site)
      (return)
    )
    (let started (call unit-machine unit-id))
    (if (and started (!= (. started refined) no-instance))
      (if (and (== (. started module) (. rule module)) (== (. started syntax) (. rule syntax)))
        (call start-refined started)
      )
      (return)
    )
    (let own-unit unit)
    (let own-filling filling)
    (= unit (= (. unit source-module) (. rule module)))
    (= unit (= (. unit reading) unit-id))
    (= filling (= (. filling root) (. rule syntax)))
    (do
      (inline (call emit-expression (. rule syntax)))
    )
    (= unit own-unit)
    (= filling own-filling)
  )
  (fn-do _ register-queries _
    (param level TypeId)
    ; The registrations a constructor makes once the rules of a class of its object have run, as
    ; the type pass recorded them (`QueryRegistration`): each markup query the class declares, in
    ; order, given to the markup runtime with the object as its host and a callback that runs each
    ; function made for the query with the object; then the object as a target of each descendant
    ; query that looks for the class or one above it (`ProgramTables.target-ids-of`), given with the
    ; number of its target, in the order of those numbers.
    (let keys (list U64))
    (for (in position (..< 0 (. facts query-registrations length)))
      (let held ([] (. facts query-registrations) position))
      (if (and (== (. held instance) (. unit instance)) (== (. held level) level))
        (if (!= (. held query) (. U32 max))
          (+= keys (as position U64))
          (else
            (for (in target-id (call (. tables target-ids-of) level))
              (+= keys
                (scope (/or/ (/lshift/ target-bits 32) (as position U64))
                  (lazy target-bits (as (call (. tables target-number) target-id) U64))
                )
              )
            )
          )
        )
      )
    )
    (let ordered-keys (call sort keys))
    (for (in key ordered-keys)
      (let registration ([] (. facts query-registrations) (as (/and/ key 0xffffffff) Size)))
      (let site (. registration site))
      (let owner (call convert-self site .reason-markup-host))
      (let mark (. pending length))
      (+= pending (. owner operand))
      (if (== (. registration query) (. U32 max))
        (+= pending (call integer .machine-u64 (/rshift/ key 32)))
        (else
          (let query ([] (. facts markup-queries) (. registration query)))
          (if (!= (. query target-id) 0)
            (+= pending (call integer .machine-u64 (call (. tables target-number) (. query target-id))))
          )
          (+= pending (call make-callback (call (. tables query-function-of) (. registration query)) (. unit self) site))
          (if (!= (. query target-id) 0)
            (+= pending
              (call make-callback
                (block
                  (arg (call (. tables query-function-of) (. registration query) true))
                  (arg (. unit self))
                  (arg site)
                )
              )
            )
          )
        )
      )
      (do
        (inline (call raising-call site (. registration register) mark))
      )
    )
  )
  (fn-do + run-class-rule _
    (param rule ClassRule)
    (param tabled Bool)
    (param site SyntaxId)
    (match? ([] (. ([] (. program modules) (. rule module)) tree nodes) (. rule syntax))
      (case (call .node-dependency-declaration dependency)
        (call subscribe-dependency rule (. dependency left) (. dependency right) site)
        (return)
      )
      (case (call .node-subscriber-syntax section)
        (if (not tabled)
          (call run-section rule (. section iterator) site)
        )
        (return)
      )
    )
    (if (or (== (. rule unit) no-instance) (== (. rule kept) no-layout) (== (. rule updater) no-function))
      (call refuse .refused-function site)
      (return)
    )
    (let kept (call make-kept rule site))
    (let trigger (call (. facts markup-trigger-of) (. rule unit)))
    (if trigger
      (call run-markup-trigger rule trigger kept site)
      (return)
    )
    (let trackers (call open-trackers site))
    (+= live-actions (call LiveTrackers trackers trackers))
    (let own-unit unit)
    (= unit (= (. unit source-module) (. rule module)))
    (= unit (= (. unit reading) (. rule unit)))
    (= unit (= (. unit self-type) (. rule level)))
    (= unit (= (. unit running-rule) true))
    (call run-rule-first rule (call load-local kept site))
    (= unit (= (. unit running-rule) false))
    (= unit own-unit)
    (call (. live-actions pop))
    (do
      (inline (call own-action (call load-local trackers site) (. rule updater) (call load-local kept site) site))
    )
  )
  (fn-do _ make-kept LocalId
    (param rule ClassRule)
    (param site SyntaxId)
    ; What a rule of a class keeps for the object being made, made here, which holds the object.
    (let layout ([] (. tables layouts rows) (. rule kept)))
    (let mark (. pending length))
    (+= pending (call integer .machine-u64 (. layout size)))
    (+= pending (call make-operand .operand-descriptor (. rule kept)))
    (let kept (call (. ir add-local) managed-layout))
    (call store-local kept (call call-runtime .runtime-allocate-object site mark managed-layout) site)
    (call store (call load-local kept site) (. (call (. tables layouts field) (. rule kept) 0) offset) (. unit self) true site)
    (return kept)
  )
  (fn-do _ run-rule-first _
    (param rule ClassRule)
    (param object Operand)
    ; Runs a rule of a class the first time, where the constructor runs it, as the instance that
    ; types the rule, which the function a live action runs it again with is too: the locals the
    ; rule declares are the constructor's for the run, and what the constructor keeps of its own
    ; slots is put back after it. A rule whose nested functions read what it declares makes the
    ; environment of its scope for the run and shares the object there, as a method does.
    (let run (call enter-unit (. rule unit)))
    (= unit (= (. unit environment) no-local))
    (= unit (= (. unit received) false))
    (call open-environment (. rule syntax))
    (call share-self (. rule syntax))
    (call apply-class-rule rule object true)
    (call leave-unit run)
  )
  (fn-do _ run-section _
    (param rule ClassRule)
    (param iterator SyntaxId)
    (param site SyntaxId)
    ; Subscribes the loop a section of a class writes to its stream for the object being made,
    ; which owns the subscription, recorded at the loop or at its `whenever` clause. The loop is
    ; read through the facts of the instance that types the section. One that follows an element a
    ; branch of the markup makes is subscribed in a live action of its own (`first-rebinding`).
    (if (== (. rule unit) no-instance)
      (call refuse .refused-function site)
      (return)
    )
    (let own-unit unit)
    (= unit (= (. unit source-module) (. rule module)))
    (= unit (= (. unit reading) (. rule unit)))
    (= unit (= (. unit self-type) (. rule level)))
    (= unit (= (. unit running-rule) true))
    (let found false)
    (if (call (. facts rebinds-section) (. rule level) (. rule module) iterator)
      (= found true)
      (call first-rebinding rule iterator site)
      (else
        (match? ([] (. tree nodes) iterator)
          (case (call .node-for-block block)
            (match? ([] (. tree nodes) (. block loop))
              (case (call .node-loop-syntax row)
                (let retested (call (. tree whenever-clause) (. block loop)))
                (let owned
                  (scope (or (call (. tables owned-subscription-of) (. unit reading) iterator) retest-owned)
                    (lazy retest-owned (call (. tables owned-subscription-of) (. unit reading) retested))
                  )
                )
                (if (and (. row is-subscriber) owned)
                  (= found true)
                  (call emit-subscription iterator (. block loop) (. row container))
                )
              )
            )
          )
        )
      )
    )
    (if (not found)
      (call refuse .refused-statement iterator)
    )
    (= unit (= (. unit running-rule) false))
    (= unit own-unit)
  )
  (fn-do _ first-rebinding _
    (param rule ClassRule)
    (param iterator SyntaxId)
    (param site SyntaxId)
    ; Subscribes a section that follows an element a branch of the markup makes, as the reference's
    ; `loopAsRebindingSubscription` does: what it keeps for the object holds the object, the stream
    ; is read in a live action of its own (`rebind-section`), and a live action of the object holds
    ; the trackers it noted, with a callback that does it again as the branch makes the element.
    (if (or (== (. rule kept) no-layout) (== (. rule updater) no-function))
      (call refuse .refused-function site)
      (return)
    )
    (let kept (call make-kept rule site))
    (let trackers (call open-trackers site))
    (+= live-actions (call LiveTrackers trackers trackers))
    (call rebind-section rule iterator (call load-local kept site) true)
    (call (. live-actions pop))
    (do
      (inline
        (call own-callback (call load-local trackers site) adapter (call load-local kept site) site
          (block
            (lazy adapter (call (. tables live-adapter-of) (. rule updater)))
          )
        )
      )
    )
  )
  (fn-do _ rebind-section _
    (param rule ClassRule)
    (param iterator SyntaxId)
    (param kept Operand)
    (param first Bool)
    ; Reads the stream of a section that follows an element a branch of the markup makes, with the
    ; element's name read tracked, and adds to the trackers of the live action open the tracker of
    ; a subscription to it the object owns, of the closure the section's loop subscribes: made and
    ; kept the first time, and read from what the section keeps after that. A loop on an event that
    ; is not live subscribes nothing.
    (let loop SyntaxId 0)
    (let container SyntaxId 0)
    (match? ([] (. tree nodes) iterator)
      (case (call .node-for-block block)
        (= loop (. block loop))
        (match? ([] (. tree nodes) (. block loop))
          (case (call .node-loop-syntax row)
            (= container (. row container))
          )
        )
      )
    )
    (let root container)
    (let reached false)
    (while (not reached)
      (match ([] (. tree nodes) root)
        (case (call .node-get-expression get)
          (= root (. get object))
        )
        (default
          (= reached true)
        )
      )
    )
    (let name (? Atom) null)
    (match? ([] (. tree nodes) root)
      (case (call .node-identifier read)
        (= name (. read name))
      )
    )
    (let owned (call (. tables owned-subscription-of) (. unit reading) iterator))
    (let closure (call subscriber-closure iterator))
    (if (or (== loop 0) (not name) (not owned) (== closure no-type))
      (call refuse .refused-statement iterator)
      (return)
    )
    (call track root (. unit self) name)
    (let used (call (. tables event-use-of) (. unit reading) iterator))
    (let stream (call make-operand .operand-void 0))
    (if (and used (== (. used second) no-instance))
      (call refuse .refused-statement iterator)
      (return)
    )
    (if used
      (let owner (call event-owner (. used reference) (. used owner)))
      (let number (call (. tables event-number) (. used owner) (. used name)))
      (if (== number (. U32 max))
        (return)
      )
      (if (!= (. used address) 0)
        (call refuse .refused-statement iterator)
        (return)
      )
      (= stream (. (call event-endpoint loop (. used first) (. owner operand) number) operand))
      (else
        (= stream (. (call emit-broadcastable loop container) operand))
      )
    )
    (let field (call (. tables layouts field) (. rule kept) 1))
    (let written (call make-operand .operand-void 0))
    (if first
      (let lone (call lone-environment iterator no-slot))
      (= written (call load-local lone iterator))
      (call store kept (. field offset) written true iterator)
      (else
        (= written (call load kept (. field offset) managed-layout iterator))
      )
    )
    (let subscriber (call convert iterator .reason-argument (call Typed written closure)))
    (let tracker (call own-tracker iterator owned stream (. subscriber operand) (!= used null) (call arrives loop)))
    (let given (call convert iterator .reason-argument tracker))
    (call add-tracker
      (block
        (arg (call load-local (. ([] live-actions (- (. live-actions length) 1)) next) iterator))
        (arg (. given operand))
        (arg iterator)
      )
    )
  )
  (fn-do _ subscribe-dependency _
    (param rule ClassRule)
    (param left SyntaxId)
    (param rights (of RowRange SyntaxId))
    (param site SyntaxId)
    ; Subscribes the method a dependency of a class names, read as a value of the object being
