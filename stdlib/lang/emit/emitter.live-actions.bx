  (fn-do + reruns-statement Bool :get
    ; Whether the function being emitted is one a live action runs a live statement again with.
    (if (or (!= (. function kind) .instance-body) (== (. unit instance) no-instance))
      (return false)
    )
    (let row ([] (. instances rows) (. unit instance)))
    (match? ([] (. ([] (. program modules) (. row module)) decls) (. row decl))
      (case (call .decl-function fn)
        (return (== (. fn kind) .live-decl))
      )
    )
    (return false)
  )
  (fn-do + open-trackers LocalId
    (param site SyntaxId)
