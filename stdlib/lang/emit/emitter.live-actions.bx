    (+= pending callback)
    (+= pending (call num-cast site (. unit self) managed-layout pointer-layout))
    (+= pending (call integer .machine-u64 flag))
    (+= pending (call make-operand .operand-constant (call (. ir add-string) (. ([] (. types properties) place) name text))))
    (let action (call call-instance (. live memo-action) site mark))
    (call attach-action (. unit self) (. action operand) site)
  )
  (fn-do + own-action Operand
    (param trackers Operand)
