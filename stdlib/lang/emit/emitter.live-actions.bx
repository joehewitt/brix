    (let owner (. ([] (. instances rows) (. unit instance)) enclosing))
    (for (in offset (..< 0 (. unit slot-count)))
      (let slot (+ (. unit slot-start) offset))
      (let row ([] (. bindings slots) slot))
      (let inside (and (>= (. row group) start) (< (. row group) statement)))
      (if (or (!= (. row kind) .slot-lazy) (not inside) (call (. tables live-statement-of) owner (. row group)))
