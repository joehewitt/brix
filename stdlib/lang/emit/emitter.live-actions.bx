(import ./emitter)
(import ./emitter.assignments)
(import ./emitter.lazies)
(import ./emitter.loops)
(import ./emitter.markup)
(import ./emitter.state-machines)
(import ./emitter.styles)
(import ./layouts)
(import ./program-tables)
(import ./receiver-stability)
(import ./runtime)
(import ./table-layouts)
(import /core/arena)
(import /core/table)
(import /lang/ast/ast)
(import /lang/ast/ast-children)
(import /lang/ast/ast-queries)
(import /lang/ast/ast-nodes)
(import /lang/ast/decl)
(import /lang/ast/module)
(import /lang/ast/operator)
(import /lang/ast/program)
(import /lang/ast/row-range)
(import /lang/ast/state-machines)
(import /lang/backend/mir)
(import /lang/check/binding)
(import /lang/check/claims)
(import /lang/check/facts)
(import /lang/check/instances)
(import /lang/check/machine-composite)
(import /lang/check/numeric)
(import /lang/check/pattern-helper)
(import /lang/check/probe-casts)
(import /lang/check/table-rows)
(import /lang/check/type-signature)
(import /lang/check/type-store)
(import /lang/check/type-text)
(import /lang/check/types)
(import /lang/ir/ir)
(import /stream/sort)

(type _ LiveActions (facet-of FunctionEmitter)
  (sees Assignments)
  (sees Lazies)
  (sees Loops)
  (sees Markup)
  (sees StateMachines)
  (sees Styles)
  (fn-do + bind-cells _
    (param site SyntaxId)
    (param subject Operand)
    ; Binds the state cells made at a site of this instance, in the order made (`bind-cell`): at a
    ; markup element once its object is made, or, for none, in the function that fills an object
    ; with its class's markup before the markup runs.
    (for (in index (..< 0 (. facts scope-cells length)))
      (let held ([] (. facts scope-cells) index))
      (if (and (== (. held instance) (. unit reading)) (== (. held site) site))
        (call bind-cell (as index U32) subject)
      )
    )
  )
  (fn-do + make-cells _
    (param site SyntaxId)
    ; Makes the state cells of a site of this instance, as the reference's
    ; `createStyleScopeState` does, each kept in a local of its own (`state-cells`).
    (for (in index (..< 0 (. facts scope-cells length)))
      (let held ([] (. facts scope-cells) index))
      (if (or (!= (. held instance) (. unit reading)) (!= (. held site) site))
        (continue)
      )
      (let own-unit unit)
      (= unit (= (. unit source-module) (. held module)))
      (let local (call (. ir add-local) managed-layout))
      (call store-local
        (block
          (arg local)
          (arg (. (call call-instance (. facts style-runtime scope-state) (. held when) (. pending length)) operand))
          (arg (. held when))
        )
      )
      (+= state-cells (call StateCell (as index U32) local))
      (= unit own-unit)
    )
  )
  (fn-do + take-cells _
    (param declared SyntaxId)
    ; Keeps the state cells the function that fills an object with its class's markup is given, each
    ; in a local of its own (`state-cells`).
    (for (in index (..< 0 (. facts scope-cells length)))
      (let held ([] (. facts scope-cells) index))
      (if (or (!= (. held instance) (. unit reading)) (== (. held argument) (. U32 max)))
        (continue)
      )
      (let place (call (. instances value-argument) (. unit instance) (. held argument)))
      (let local (call (. ir add-local) managed-layout))
      (call store-local
        (block
          (arg local)
          (arg (call make-operand .operand-argument (if-expr (. unit takes-self) (+ place 1) place)))
          (arg declared)
        )
      )
      (+= state-cells (call StateCell (as index U32) local))
    )
  )
  (fn-do + keep-cells _
    (param declared SyntaxId)
    ; Keeps, in a function that builds markup, the state cells it keeps of the function it is written
    ; in, which the environment it is given holds after the one that function had in force where it
    ; made it (`kept-layout-of`), which is the environment it reads from, and then the values of rules
    ; it keeps (`taken-values`); then those it reads from the cells the slot outlet that mounts what it
    ; builds holds, as the reference's `style-outlet-state` reads one; each in a local of its own
    ; (`state-cells`).
    (let layout (call (. tables kept-layout-of) (. unit instance)))
    (if (!= layout no-layout)
      (let wrapper (call make-operand .operand-argument 0))
      (= made-environment (call (. ir add-local) managed-layout))
      (call store-local
        (block
          (arg made-environment)
          (arg (call load wrapper (. (call (. tables layouts field) layout 0) offset) managed-layout declared))
          (arg declared)
        )
      )
      (let place U32 1)
      (for (in index (..< 0 (. facts scope-cells length)))
        (let held ([] (. facts scope-cells) index))
        (if (or (!= (. held instance) (. unit reading)) (== (. held kept) (. U32 max)))
          (continue)
        )
        (let local (call (. ir add-local) managed-layout))
        (call store-local
          (block
            (arg local)
            (arg
              (call load
                (block
                  (arg wrapper)
                  (arg (. (call (. tables layouts field) layout (+ (. held kept) 1)) offset))
                  (arg managed-layout)
                  (arg declared)
                )
              )
            )
            (arg declared)
          )
        )
        (+= state-cells (call StateCell (as index U32) local))
        (+= place 1)
      )
      (for (in index (..< 0 (. facts scope-values length)))
        (let held ([] (. facts scope-values) index))
        (if (or (!= (. held instance) (. unit reading)) (== (. held kept) (. U32 max)))
          (continue)
        )
        (+= taken-values (call TakenValues (as index U32) (as (. around-values length) U32)))
        (for (in position (..< (. held type-first) (+ (. held type-first) (. held count))))
          (let field (call (. tables layouts field) layout place))
          (if (call (. tables layouts is-struct) (. field layout))
            (call refuse .refused-function declared)
            (return)
          )
          (let local (call (. ir add-local) (. field layout) false))
          (call store-local local (call load wrapper (. field offset) (. field layout) declared) declared)
          (+= around-values (call AroundValue 0 local ([] (. facts scope-value-types) position)))
          (+= place 1)
        )
      )
    )
    (for (in index (..< 0 (. facts scope-cells length)))
      (let held ([] (. facts scope-cells) index))
      (if (or (!= (. held instance) (. unit reading)) (not (. held read)))
        (continue)
      )
      (let mark (. pending length))
      (+= pending (call integer .machine-u32 (call (. tables state-key-number) (. held key))))
      (let local (call (. ir add-local) managed-layout))
      (call store-local
        (block
          (arg local)
          (arg (. (call call-instance (. facts style-runtime outlet-state) declared mark) operand))
          (arg declared)
        )
      )
      (+= state-cells (call StateCell (as index U32) local))
    )
  )
  (fn-do + kept-cells Operand
    (param id SyntaxId)
    (param type TypeId)
    (param written Operand)
    ; The environment a nested function written at a node is given where it keeps state cells or
    ; values of rules of the function it is written in (`kept-layout-of`): the environment in force
    ; where it is written, then each cell it keeps, as made or given here, then each value
    ; (`around-local`). The environment in force alone where it keeps none. One made by a function it
    ; is not written in has no shape.
    (let callee (call kept-callee type))
    (if (== callee no-instance)
      (return written)
    )
    (if (!= (. ([] (. instances rows) callee) enclosing) (. unit reading))
      (call refuse .refused-expression id)
      (return written)
    )
    (let layout (call (. tables kept-layout-of) callee))
    (let mark (. pending length))
    (+= pending (call integer .machine-u64 (. ([] (. tables layouts rows) layout) size)))
    (+= pending (call make-operand .operand-descriptor layout))
    (let kept (call (. ir add-local) managed-layout))
    (call store-local kept (call call-runtime .runtime-allocate-object id mark managed-layout) id)
    (call store (call load-local kept id) (. (call (. tables layouts field) layout 0) offset) written true id)
    (let place U32 1)
    (for (in held (. facts scope-cells))
      (if (or (!= (. held instance) callee) (== (. held kept) (. U32 max)))
        (continue)
      )
      (let local (call cell-local (. held source)))
      (if (== local no-local)
        (call refuse .refused-expression id)
        (return written)
      )
      (call store
        (block
          (arg (call load-local kept id))
          (arg (. (call (. tables layouts field) layout (+ (. held kept) 1)) offset))
          (arg (call load-local local id))
          (arg true)
          (arg id)
        )
      )
      (+= place 1)
    )
    (for (in held (. facts scope-values))
      (if (or (!= (. held instance) callee) (== (. held kept) (. U32 max)))
        (continue)
      )
      (for (in position (..< 0 (. held count)))
        (let (tuple local type) (call around-local (. held source) position))
        (let field (call (. tables layouts field) layout place))
        (if (or (== local no-local) other-type (call (. tables layouts is-struct) (. field layout)))
          (call refuse .refused-expression id)
          (return written)
        )
        (lazy other-type (!= type ([] (. facts scope-value-types) (+ (. held type-first) position))))
        (call store
          (block
            (arg (call load-local kept id))
            (arg (. field offset))
            (arg (call load-local local id))
            (arg (call is-managed-pointer (. field layout)))
            (arg id)
          )
        )
        (+= place 1)
      )
    )
    (return (call load-local kept id))
  )
  (fn-do _ kept-callee InstanceId
    (param type TypeId)
    ; The instance a closure type runs where it keeps state cells of the function it is written in,
    ; or none.
    (match? ([] (. types rows) type)
      (case (call .type-closure row)
        (for (in held (. tables kept-instances))
          (let shape ([] (. instances rows) held))
          (if (and (== (. shape module) (. row module)) (== (. shape decl) (. row decl)) same-enclosing)
            (return held)
          )
          (lazy same-enclosing (== (. shape enclosing) (. row enclosing)))
        )
      )
    )
    (return no-instance)
  )
  (fn-do _ bind-cell _
    (param index U32)
    (param subject Operand)
    ; Binds a state cell `make-cells` made to an object, read as of the cell's `owner`, as the
    ; reference's `bindStyleScopeState` does: the cell is given its value once in a live action of
    ; its own to gather what it reads (`set-cell`), and a live action with those trackers runs the
    ; cell's function (`emit-scope-cell`) with what it keeps: the object and the cell. The object
    ; owns that action (`attach-action`), since the trackers hold it only weakly.
    (let held ([] (. facts scope-cells) index))
    (let own-unit unit)
    (= unit (= (. unit source-module) (. held module)))
    (let site (. held when))
    (let local (call cell-local index))
    (if (== local no-local)
      (call refuse .refused-statement site)
      (= unit own-unit)
      (return)
    )
    (let code ([] (. tables cell-functions) index))
    (let trackers (call open-trackers site))
    (+= live-actions (call LiveTrackers trackers trackers))
    (call set-cell held subject (. held owner) (call load-local local site))
    (call (. live-actions pop))
    (let layout ([] (. tables cell-layouts) index))
    (let size (. ([] (. tables layouts rows) layout) size))
    (let mark (. pending length))
    (+= pending (call integer .machine-u64 size))
    (+= pending (call make-operand .operand-descriptor layout))
    (let kept (call (. ir add-local) managed-layout))
    (call store-local kept (call call-runtime .runtime-allocate-object site mark managed-layout) site)
    (call store (call load-local kept site) (. (call (. tables layouts field) layout 0) offset) subject true site)
    (call store
      (block
        (arg (call load-local kept site))
        (arg (. (call (. tables layouts field) layout 1) offset))
        (arg (call load-local local site))
        (arg true)
        (arg site)
      )
    )
    (let action
      (call make-action
        (block
          (arg (call load-local trackers site))
          (arg (call (. tables live-adapter-of) code))
          (arg (call load-local kept site))
          (arg site)
        )
      )
    )
    (call attach-action subject (. action operand) site)
    (= unit own-unit)
  )
  (fn-do _ set-cell _
    (param held ScopeCell)
    (param subject Operand)
    (param type TypeId)
    (param target Operand)
    ; Gives a state cell whether the state its `when` names holds on an object of a type, read
    ; tracked, as the reference's `bindStyleScopeState` assigns it: true, or where the `when` is
    ; negated, false. The cell's `is-on` is set as an assignment sets it.
    (match? ([] (. tree nodes) (. held when))
      (case (call .node-style-when row)
        (call track (. held when) subject (. row state))
        (let value (call read-state (. held when) subject type (. row state)))
        (if (. row is-negated)
          (= value (call compare-zero (. held when) value .compare-equal))
        )
        (let cell (call (. tables cell-type)))
        (let found (call property-of cell (call (. program store-atom) "is-on")))
        (if (not found)
          (call refuse .refused-statement (. held when))
          (return)
        )
        (let field (call held-field (. held when) cell found))
        (call put-property target field ([] (. types properties) found) (. value operand) (. held when))
      )
    )
  )
  (fn-do + give-cells _
    (param id SyntaxId)
    (param count U32)
    ; Gives the constructor of a markup element the state cells the element's context gives, in the
    ; order the type pass recorded them (`CarriedCell`), each as made or given where code is
    ; emitted, and then the values of the rules around rules written in rules it gives
    ; (`CarriedValues`), each as kept where code is emitted (`around-local`).
    (let given U32)
    (for (in held (. facts carried-cells))
      (if (or (!= (. held instance) (. unit reading)) (!= (. held site) id))
        (continue)
      )
      (let local (call cell-local (. held cell)))
      (if (== local no-local)
        (call refuse .refused-expression id)
        (return)
      )
      (+= pending (call load-local local id))
      (+= given 1)
    )
    (for (in held (. facts carried-values))
      (if (or (!= (. held instance) (. unit reading)) (!= (. held site) id))
        (continue)
      )
      (for (in position (..< 0 (call around-count (. held values))))
        (let (tuple local type) (call around-local (. held values) position))
        (if (== local no-local)
          (call refuse .refused-expression id)
          (return)
        )
        (+= pending (call load-local local id))
        (+= given 1)
      )
    )
    (if (!= given count)
      (call refuse .refused-expression id)
    )
  )
  (fn-do + emit-subscription _
    (param id SyntaxId)
    (param loop SyntaxId)
    (param container SyntaxId)
    ; A loop on a stream where it is written: the container is made a `Broadcastable`, and the
    ; loop's subscriber, the environment in force here, is made a `Subscriber` and given to the
    ; broadcaster's `subscribe`, whose errors leave the function as the type pass said, or, where
    ; an object owns it, to the object (see `own-subscription`), or where it has a `whenever`
    ; clause, as `subscribe-whenever` says. A section of a class, which a constructor runs, has an
    ; environment of its own: see `lone-environment`.
    (let used (call (. tables event-use-of) (. unit reading) id))
    (let source (call Typed (call make-operand .operand-void 0) no-type))
    (if (and used (== (. used second) no-instance))
      (call refuse .refused-statement id)
      (return)
    )
    (if used
      (let owner (call event-owner (. used reference) (. used owner)))
      (let number (call (. tables event-number) (. used owner) (. used name)))
      (if (== number (. U32 max))
        (return)
      )
      (if (!= (. used address) 0)
        (let endpoint (call keyed-endpoint id used (. owner operand) number))
        (= source (call convert loop .reason-argument endpoint))
        (else
          (= source (call event-endpoint loop (. used first) (. owner operand) number))
        )
      )
      (else
        (= source (call emit-broadcastable loop container))
      )
    )
    (let stream (. source operand))
    (let broadcaster (. source type))
    (let written (call Typed (call make-operand .operand-void 0) no-type))
    (if (== (. unit reading) (. unit instance))
      (= written (call emit-closure id))
      (else
        (let closure (call subscriber-closure id))
        (let lone (call lone-environment id no-slot))
        (if (== closure no-type)
          (call refuse .refused-statement id)
          (return)
        )
        (= written (call Typed (call load-local lone id) closure))
      )
    )
    (let subscriber (call convert id .reason-argument written))
    (let given (. subscriber type))
    (let owned (call (. tables owned-subscription-of) (. unit reading) id))
    (let retested (call (. tree whenever-clause) loop))
    (let retest (only-if (call (. tables live-statement-of) (. unit reading) retested) (if (!= retested 0))))
    (if retest
      (call subscribe-whenever id retested retest stream broadcaster (. subscriber operand))
      (else-if (!= retested 0)
        (call refuse .refused-statement retested)
      )
      (else-if owned
        (call own-subscription id owned stream (. subscriber operand) (!= used null) (call arrives loop))
      )
      (else-if used
        (let wrapping (. pending length))
        (+= pending (. subscriber operand))
        (+= pending (call integer .machine-u8 (if-expr (call arrives loop) 1 0)))
        (let subscription (call call-instance (. used second) id wrapping))
        (do
          (inline (call call-protocol id (call own-call id) stream broadcaster (. subscription operand) (. subscription type)))
        )
      )
      (else
        (do
          (inline (call call-protocol id (call own-call id) stream broadcaster (. subscriber operand) given))
        )
      )
    )
  )
  (fn-do + subscribe-whenever _
    (param id SyntaxId)
    (param clause SyntaxId)
    (param retest LiveStatement)
    (param stream Operand)
    (param broadcaster TypeId)
    (param subscriber Operand)
    ; A loop or a comprehension on a stream with a `whenever` clause, subscribed as the reference
    ; subscribes it: the clause's value is evaluated while a live action of its own is open, whose
    ; trackers note what it reads. Where no object owns the subscription, the subscriber is
    ; wrapped in a `Subscription`, which is given to the broadcaster's `subscribe` where the value
    ; holds, whose errors leave the function as the type pass said. Where an object owns it, the
    ; tracker `own-tracker` makes of it is added to the action's trackers where the value holds.
    ; What the value gave, the subscription or its tracker, and the broadcaster are kept in the
    ; locals declared at the clause, and the action is made with those trackers and a callback
    ; that tests the clause again through the function written for it, given the environment in
    ; force here, or one of its own where none is (see `lone-environment`). The object that owns
    ; the subscription owns the action.
    (let slot (call channel-slot clause))
    (let code
      (scope (if-expr (!= (. retest rerun) no-instance) rerun-function no-function)
        (lazy rerun-function ([] (. tables instance-functions) (. retest rerun)))
      )
    )
    (let owned (call (. tables owned-subscription-of) (. unit reading) clause))
    (let made (call call-at clause .call-constructor))
    (let activation (if-expr owned (call activation-owner id) (call make-operand .operand-void 0)))
    (let by-case (!= (call operand-kind activation) .operand-void))
    (if (or (== slot no-slot) (== code no-function) (and (not owned) (== made no-fact)) (and owned (not by-case) (not (. unit has-self))))
      (call refuse .refused-statement clause)
      (return)
    )
    (let lone (if-expr (!= (. unit reading) (. unit instance)) (call lone-environment clause slot 3) no-local))
    (let trackers (call open-trackers clause))
    (+= live-actions (call LiveTrackers trackers trackers))
    (let passed (call emit-expression (call (. tree clause-expr) clause)))
    (call (. live-actions pop))
    (let kept (call Typed (call make-operand .operand-void 0) no-type))
    (if owned
      (= kept (call own-tracker clause owned stream subscriber))
      (else
        (let mark (. pending length))
        (+= pending subscriber)
        (= kept (call call-instance (. ([] (. facts calls) made) callee) clause mark))
      )
    )
    (call keep-hidden lone (+ slot 1) (. kept operand) (. kept type) clause)
    (call keep-hidden lone slot (. passed operand) (. types bool-type) clause)
    (let adding (call (. ir reserve-block)))
    (let done (call (. ir reserve-block)))
    (call branch (. passed operand) adding done)
    (call (. ir start-block) adding)
    (let given (call convert clause .reason-argument kept))
    (let given-type (. given type))
    (if owned
      (call add-tracker (call load-local trackers clause) (. given operand) clause)
      (else
        (do
          (inline (call call-protocol id (call (. facts call-in-role) (. unit reading) id .role-subscribe) stream broadcaster (. given operand) given-type))
        )
      )
    )
    (call jump done)
    (call (. ir start-block) done)
    (call keep-hidden lone (+ slot 2) stream broadcaster clause)
    (let environment (if-expr (!= lone no-local) (call load-local lone clause) (call written-environment clause)))
    (if by-case
      (let action (call make-action (call load-local trackers clause) (call (. tables live-adapter-of) code) environment clause))
      (call attach-action activation (. action operand) clause)
      (else-if owned
        (do
          (inline (call own-action (call load-local trackers clause) code environment clause))
        )
      )
      (else
        (do
          (inline (call make-action (call load-local trackers clause) (call (. tables live-adapter-of) code) environment clause))
        )
      )
    )
  )
  (fn-do _ keep-hidden _
    (param lone LocalId)
    (param slot SlotId)
    (param value Operand)
    (param type TypeId)
    (param site SyntaxId)
    ; Stores a value in a local no name reaches that a nested function captures: in the
    ; environment `lone` made for that function alone, where there is one.
    (if (!= lone no-local)
      (call keep-lone lone slot value type site)
      (else
        (call keep-captured slot value type site)
      )
    )
  )
  (fn-do + add-tracker _
    (param trackers Operand)
    (param tracker Operand)
    (param site SyntaxId)
    ; Adds a tracker, made a `Tracker`, to a list of trackers.
    (let adding (. pending length))
    (+= pending trackers)
    (+= pending tracker)
    (do
      (inline (call call-instance (. instances live add-tracker) site adding))
    )
  )
  (fn-do _ retrack _
    (param clause SyntaxId)
    (param slot SlotId)
    (param passed Operand)
    (param next LocalId)
    ; The rest of a test of a `whenever` clause again where an object owns the subscription: where
    ; the value holds, the tracker kept in `slot` is added to the trackers the action now has, so
    ; that it stays attached, and the subscription with it; where not, the action detaches it.
    (let type (. (call find-captured slot clause) type))
    (let adding (call (. ir reserve-block)))
    (let done (call (. ir reserve-block)))
    (call branch passed adding done)
    (call (. ir start-block) adding)
    (let tracker (call read-captured slot clause type))
    (let given (call convert clause .reason-argument (call Typed (. tracker operand) type)))
    (call add-tracker (call load-local next clause) (. given operand) clause)
    (call jump done)
    (call (. ir start-block) done)
    (call emit-end clause)
  )
  (fn-do + own-subscription _
    (param id SyntaxId)
    (param row OwnedSubscription)
    (param stream Operand)
    (param subscriber Operand)
    (param event Bool (= false))
    (param arrival Bool (= false))
    ; A subscription the object owns, as the reference makes it: the tracker `own-tracker` makes
    ; of it is added to the trackers of a live action of the object, whose constructor attaches the
    ; tracker, which subscribes, and whose callback does nothing.
    (let tracker (call own-tracker id row stream subscriber event arrival))
    (let given (call convert id .reason-argument tracker))
    (let trackers (call open-trackers id))
    (call add-tracker (call load-local trackers id) (. given operand) id)
    (let activation (call activation-owner id))
    (if (!= (call operand-kind activation) .operand-void)
      (let action (call make-action (call load-local trackers id) (. tables idle-action) (call integer .machine-managed-pointer 0) id))
      (call attach-action activation (. action operand) id)
      (return)
    )
    (do
      (inline
        (call own-callback (call load-local trackers id) idle (call integer .machine-managed-pointer 0) id
          (block
            (lazy idle (. tables idle-action))
          )
        )
      )
    )
  )
  (fn-do _ activation-owner Operand
    (param site SyntaxId)
    (let nothing (call make-operand .operand-void 0))
    (if (!= (. content-hosts length) 0)
      (return nothing)
    )
    (let binding (. ([] (. instances rows) (. unit reading)) binding))
    (let tasks (call (. bindings activation-tasks) binding site (call (. program store-atom) "(tasks)")))
    (if (== tasks no-slot)
      (return nothing)
    )
    (return (. (call read-captured tasks site (. (call find-captured tasks site) type)) operand))
  )
  (fn-do _ own-tracker Typed
    (param id SyntaxId)
    (param row OwnedSubscription)
    (param stream Operand)
    (param subscriber Operand)
    (param event Bool (= false))
    (param arrival Bool (= false))
    ; The tracker that subscribes a subscription an object owns: the subscriber is wrapped in a
    ; `Subscription`, or for an `event` in the event runtime's subscription, which hears every
    ; publication or with `arrival` only those the object is the target of, and given with the
    ; broadcaster to a `SubscriptionTracker`, whose type it has.
    (let nothing (call make-operand .operand-void 0))
    (let mark (. pending length))
    (+= pending subscriber)
    (if event
      (+= pending (call integer .machine-u8 (if-expr arrival 1 0)))
    )
    (let made (call call-instance (. row subscription) id mark))
    (let wrapped (call convert id .reason-argument made))
    (let tracking (. pending length))
    (+= pending stream)
    (+= pending (. wrapped operand))
    (return (call call-instance (. row tracker) id tracking))
  )
  (fn-do + subscriber-closure TypeId
    (param id SyntaxId)
    ; The closure a comprehension on a stream subscribes, as the conversion recorded where it is
    ; made a `Subscriber` gives it.
    (let scan (call (. facts first-conversion) (. unit reading) id))
    (while (!= scan no-fact)
      (let row ([] (. facts conversions) scan))
      (if (and (== (. row reason) .reason-argument) (call is-closure (. row from)))
        (return (. row from))
      )
      (= scan (. row next))
    )
    (return no-type)
  )
  (fn-do + emit-subscriber _
    (param loop SyntaxId)
    (param clause SyntaxId)
    (param body SyntaxId)
    (param writes SyntaxId (= 0))
    ; The function a loop on a stream runs for each item it is given, after the environment it
    ; was made with: the header's pattern takes the item, and a `when` that fails or an item a
    ; match passes over returns. A `while` or an `until` that fails unsubscribes and returns.
    ; Then the body runs, where a `break` that leaves no loop of the body unsubscribes and returns.
    ; That of a comprehension on a stream, which `writes` to the
    ; comprehension's channel, tests its clauses in the order written and writes what its body
    ; gives.
    (let type (call (. instances argument-type) (. unit instance) 0))
    (let last (- (+ (call loop-slots loop) loop-state-count) 1))
    (let skip (call (. ir reserve-block)))
    (let ended (call (. ir reserve-block)))
    (let item (call make-operand .operand-argument 1))
    (call take-item loop last item type skip)
    (let turned (call (. facts slot-type) (. unit instance) (call slot-offset last loop)))
    (let depth (. loops length))
    (+= loops (call EmittedLoop loop skip ended item turned (. open-cleanups length) last))
    (call emit-clause clause skip ended)
    (if (!= writes 0)
      (call emit-write writes body)
      (else
        (call emit-block body)
      )
    )
    (while (> (. loops length) depth)
      (call (. loops pop))
    )
    (call jump skip)
    (call (. ir start-block) ended)
    (if (!= (call own-call loop) no-fact)
      (call unsubscribe loop)
    )
    (call jump skip)
    (call (. ir start-block) skip)
  )
  (fn-do _ emit-write _
    (param id SyntaxId)
    (param body SyntaxId)
    ; What the body of a comprehension on a stream gives, written to the channel the comprehension
    ; made, read from the environment it was kept in, by the call of `<-` the type pass recorded
    ; at the comprehension.
    (let value (call emit-expression body))
    (let written (. value type))
    (let fact (call call-at id .call-operator))
    (let slot (call channel-slot id))
    (if (or (== fact no-fact) (== slot no-slot) (== (. ([] (. facts calls) fact) callee) no-instance))
      (call refuse .refused-expression id)
      (return)
    )
    (let channel (. ([] (. instances rows) (. ([] (. facts calls) fact) callee)) self-type))
    (let held (call read-captured slot id channel))
    (do
      (inline (call call-operator id fact id (. held operand) channel body (. value operand) written))
    )
  )
  (fn-do + breaks-subscription Bool
    ; Whether a `break` here unsubscribes: the innermost loop is the one on a stream that the
    ; function being emitted runs for an item.
    (if (or (== subscribing 0) (== (. loops length) 0))
      (return false)
    )
    (match? ([] (. tree nodes) subscribing)
      (case (call .node-for-block row)
        (return (== (. ([] loops (- (. loops length) 1)) syntax) (. row loop)))
      )
    )
    (return false)
  )
  (fn-do + unsubscribe _
    (param site SyntaxId)
    ; The subscriber being run, made a `Subscriber` again by the conversion recorded where it was
    ; subscribed, so it is the same value, given to `unsubscribe` of the stream it was given, as
    ; the type pass recorded at the node that unsubscribes. An error that leaves `unsubscribe` is
    ; given to the global `unhandled-error` and what follows runs, as the reference's raw call does.
    (let fact (call own-call site))
    (let closure (call (. facts node-type) (. unit reading) subscribing))
    (let enclosing (call facts-owner (. ([] (. instances rows) (. unit instance)) enclosing)))
    (let made no-fact)
    (let scan
      (scope (if-expr (!= enclosing no-instance) enclosing-first no-fact)
        (lazy enclosing-first (call (. facts first-conversion) enclosing subscribing))
      )
    )
    (while (!= scan no-fact)
      (let row ([] (. facts conversions) scan))
      (if (and (== (. row reason) .reason-argument) (== (. row from) closure))
        (= made scan)
      )
      (= scan (. row next))
    )
    (if (or (== fact no-fact) (== made no-fact))
      (call refuse .refused-statement site)
      (return)
    )
    (let subscriber
      (call convert-one
        (block
          (arg site)
          (arg ([] (. facts conversions) made))
          (arg (call Typed (call make-operand .operand-argument 0) closure))
        )
      )
    )
    (let given (. subscriber type))
    (let stream (call make-operand .operand-argument 2))
    (let broadcaster (call (. instances argument-type) (. unit instance) 1))
    (call call-subscription site fact stream broadcaster (. subscriber operand) given)
