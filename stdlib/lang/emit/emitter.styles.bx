(import ./emitter)
(import ./emitter.assignments)
(import ./emitter.live-actions)
(import ./emitter.state-machines)
(import ./layouts)
(import ./program-tables)
(import ./receiver-stability)
(import ./runtime)
(import ./table-layouts)
(import /core/arena)
(import /core/table)
(import /lang/ast/ast)
(import /lang/ast/ast-children)
(import /lang/ast/ast-queries)
(import /lang/ast/ast-nodes)
(import /lang/ast/decl)
(import /lang/ast/module)
(import /lang/ast/operator)
(import /lang/ast/program)
(import /lang/ast/row-range)
(import /lang/ast/state-machines)
(import /lang/backend/mir)
(import /lang/check/binding)
(import /lang/check/claims)
(import /lang/check/facts)
(import /lang/check/instances)
(import /lang/check/machine-composite)
(import /lang/check/numeric)
(import /lang/check/pattern-helper)
(import /lang/check/probe-casts)
(import /lang/check/table-rows)
(import /lang/check/type-signature)
(import /lang/check/type-store)
(import /lang/check/type-text)
(import /lang/check/types)
(import /lang/ir/ir)
(import /stream/sort)

(type _ Styles (facet-of FunctionEmitter)
  (sees Assignments)
  (sees LiveActions)
  (sees StateMachines)
  (prop _ style-order U32 (= 0))
  (prop _ site-param (? Operand) (= null))
  (prop _ order-param (? Operand) (= null))
  (prop _ shared-rule U32 (= (. U32 max)))
  (prop _ theme-record Operand (= 0))
  (prop _ site-self Operand (= 0))
  (prop _ site-self-type TypeId (= no-type))
  (prop _ site-has-self Bool (= false))
  (prop _ site-deferred TypeId (= no-type))
  (fn-do + declare-styles Operand
    (param id SyntaxId)
    (param made Operand)
    (param type TypeId)
    ; The style declarations of a markup element, made after its object and before its
    ; properties are stored, as the reference makes them: those of the style rules it applies, in
    ; order, then its own, in the order written (see `declare-style`). Answers the association of
    ; the object with the element's site, or nothing where none was made. Rules that declare no
    ; style still set the properties they name, where the element has no site.
    (let nothing (call make-operand .operand-void 0))
    (let site (call (. facts style-site-of) (. unit reading) (. unit source-module) id))
    (let number (if-expr site (. site number) (. U32 max)))
    (call begin-recording id (. unit source-module) number)
    (let association nothing)
    (let own-styling styling)
    (= styling (= (. styling gate) (. U32 max)))
    (let applied (call (. tables first-application) (. unit reading)))
    (while (!= applied (. U32 max))
      (let application ([] (. facts style-applications) applied))
      (if (and applied-here (== (. application outer) (. U32 max)))
        (= association (call apply-style-rule applied number made type association (. U32 max)))
      )
      (lazy applied-here (and (== (. application module) (. unit source-module)) (== (. application site) id)))
      (= applied (call (. tables next-application) applied))
    )
    (= styling own-styling)
    (if (not site)
      (return nothing)
    )
    (let place (call (. facts first-style-declaration) (. unit reading)))
    (while (!= place (. U32 max))
      (let row ([] (. facts style-declarations) place))
      (if (== (. row element) id)
        (= association (call declare-style row (. row layer) (. row order) (. site number) made type association))
      )
      (= place (call (. facts next-style-declaration) place))
    )
    (return association)
  )
  (fn-do _ apply-style-rule Operand
    (param index U32)
    (param number U32)
    (param made Operand)
    (param type TypeId)
    (param association Operand)
    (param inherited U32)
    ; A style rule applied to an object at a site, as the reference applies one, read through the
    ; instance that types the rule for the class that writes it, which is the receiver's class
    ; while it is: first the rules it applies after its name, recorded after it with it as their
    ; `outer`; then its lines but its `when`s, in the order written, each declaration at the
    ; application's layer and each property the rule sets stored in the object
    ; (`update-rule-property`); then each `when`, gated by its condition made under those the
    ; rule is applied under (`inherited`): the rules its body applies, then its declarations. A
    ; rule applied under conditions gates its lines by them. Gated declarations take the
    ; conditional layer at least, and a default's the gated defaults layer (see `enter-gate`).
    ; Orders count on from the application's first, where the site applies it. The values a
    ; written application gives the rule are converted first, where the element or the rule that
    ; applies it is (`bind-rule-values`). A
    ; `shared` rule is applied by calling the reference's function for it (`call-shared-rule`),
    ; except in that function (`emit-style-rule`). The application's `action` makes the action of each
    ; declaration whose value reads something tracked. Answers the association, as
    ; `declare-style` does. Where the application has `live-values`, each declaration that reads
    ; them is declared again as they change (`declare-given-style`). A rule applied under the state
    ; cell of a `when` is applied under the
    ; condition of the cell first (`cell-condition`). The content the rule's lines generate follows
    ; its declarations, and that of each `when` the `when`'s (`generate-content`). What a site
    ; applies is read in the module the site is written in, which may be another's than this
    ; instance's for the defaults of a class (`emit-defaults`). One the site applies under a
    ; condition written with it gates everything under that too (`applied-condition`).
    (let application ([] (. facts style-applications) index))
    (let unit-id (. application unit))
    (if (and (== (. application outer) (. U32 max)) (!= shared-rule index))
      (= style-order (. application order))
    )
    (if (and (. application shared) (!= shared-rule index))
      (return (call call-shared-rule index number made type association))
    )
    (let conditions (call cell-condition (. application cell) (. application outer-cells) inherited))
    (if (== (. application outer) (. U32 max))
      (= conditions (call applied-condition application conditions))
      (= site-self (. unit self))
      (= site-self-type (. unit self-type))
      (= site-has-self (. unit has-self))
      (= site-deferred (. unit deferred-type))
    )
    (let own-styling styling)
    (= styling (= (. styling action) (. application action)))
    (let opening association)
    (let bound (. rule-names length))
    (let own-unit unit)
    (if (== (. application outer) (. U32 max))
      (= unit (= (. unit source-module) (. application module)))
    )
    (if (!= (. application written) 0)
      (call bind-rule-values
        (block
          (arg (. application written))
          (arg unit-id)
          (arg (or (!= (. application outer) (. U32 max)) (is ([] (. tree nodes) (. application site)) .node-slot-outlet)))
          (arg (. application values))
        )
      )
    )
    (if (!= (. application around-values) (. U32 max))
      (call bind-around-values (. application around-values) unit-id (. application site))
    )
    (let own-filling filling)
    (= unit (= (. unit source-module) (. ([] (. instances rows) unit-id) module)))
    (= unit (= (. unit reading) unit-id))
    (= unit (= (. unit self-type) (. ([] (. instances rows) unit-id) self-type)))
    (= unit (= (. unit self) made))
    (= unit (= (. unit has-self) true))
    (= filling (= (. filling count) 0))
    (= unit (= (. unit deferred-type) no-type))
    (= unit (= (. unit running-rule) true))
    (let associated (call apply-inner-rules index 0 number made type opening conditions))
    (let lines ([] (. tree children) (call rule-lines unit-id)))
    (let marked (call marks-up unit-id))
    (let lined false)
    (let written (list SyntaxId))
    (for (in statement lines)
      (+= written statement)
      (if (and (!= (. application family) (. U32 max)) (is ([] (. tree nodes) statement) .node-markup))
        (call refuse .refused-statement statement)
      )
      (if (and (not is-when) (not is-rule) (not is-markup) (not (and marked (not (call (. tree rule-part) statement)))))
        (= lined true)
      )
      (lazy is-when (is ([] (. tree nodes) statement) .node-style-when))
      (lazy is-rule (is ([] (. tree nodes) statement) .node-rule-syntax))
      (lazy is-markup (is ([] (. tree nodes) statement) .node-markup))
    )
    (let gate (. U32 max))
    (if (and lined (!= conditions (. U32 max)))
      (= gate (call enter-gate conditions made type associated))
    )
    (= styling (= (. styling live) (if-expr (. application live-values) index (. U32 max))))
    (= styling (= (. styling family-gated) (!= (. application family) (. U32 max))))
    (if (and (. styling family-gated) lined (!= number (. U32 max)))
      (call record-family application number true)
    )
    (for (in statement lines)
      (if (or when-node (is ([] (. tree nodes) statement) .node-rule-syntax) markup-node)
        (continue)
      )
      (lazy when-node (is ([] (. tree nodes) statement) .node-style-when))
      (lazy markup-node (is ([] (. tree nodes) statement) .node-markup))
      (if (and marked (not (call (. tree rule-part) statement)))
        (continue)
      )
      (let row (call (. facts bound-declaration) unit-id statement index))
      (let update (call (. facts rule-update-of) unit-id statement))
      (if (and row (!= number (. U32 max)))
        (= associated
          (call declare-rule-style
            (block
              (arg row)
              (arg (. application layer))
              (arg (!= conditions (. U32 max)))
              (arg number)
              (arg made)
              (arg type)
              (arg associated)
            )
          )
        )
        (else-if (and update (== conditions (. U32 max)) (not (. styling family-gated)))
          (call update-rule-property update made application)
        )
        (else
          (call refuse .refused-statement statement)
        )
      )
    )
    (if (and (. styling family-gated) lined (!= number (. U32 max)))
      (call record-family application number false)
    )
    (= styling (= (. styling family-gated) (. own-styling family-gated)))
    (call leave-gate gate made type associated)
    (= associated (call generate-content index written conditions number made type associated))
    (for (in statement lines)
      (if (not (is ([] (. tree nodes) statement) .node-style-when))
        (continue)
      )
      (let condition (as (. style-conditions length) U32))
      (+= style-conditions (call StyleCondition (call StyleWhen (. unit source-module) statement) conditions))
      (let entered (call enter-gate condition made type associated))
      (= associated (call apply-inner-rules index statement number made type associated condition))
      (= styling (= (. styling family-gated) (!= (. application family) (. U32 max))))
      (if (and (. styling family-gated) (!= number (. U32 max)))
        (call record-family application number true)
      )
      (for (in line (call (. tree when-lines) statement))
        (if (and (. styling family-gated) (is ([] (. tree nodes) line) .node-markup))
          (call refuse .refused-statement line)
        )
        (if (or applies-rule (is ([] (. tree nodes) line) .node-rule-syntax) (is ([] (. tree nodes) line) .node-markup))
          (continue)
        )
        (lazy applies-rule (is ([] (. tree nodes) line) .node-style-rule-application))
        (let row (call (. facts bound-declaration) unit-id line index))
        (if (and row (!= number (. U32 max)))
          (= associated
            (call declare-rule-style
              (block
                (arg row)
                (arg (. application layer))
                (arg true)
                (arg number)
                (arg made)
                (arg type)
                (arg associated)
              )
            )
          )
          (else
            (call refuse .refused-statement line)
          )
        )
      )
      (if (and (. styling family-gated) (!= number (. U32 max)))
        (call record-family application number false)
      )
      (= styling (= (. styling family-gated) (. own-styling family-gated)))
      (call leave-gate entered made type associated)
      (= associated
        (call generate-content
          (block
            (arg index)
            (arg (call (. tree when-lines) statement))
            (arg condition)
            (arg number)
            (arg made)
            (arg type)
            (arg associated)
          )
        )
      )
    )
    (= unit own-unit)
    (= filling own-filling)
    (= styling own-styling)
    (while (> (. rule-names length) bound)
      (call (. rule-names pop))
    )
    (return associated)
  )
  (fn-do _ applied-condition U32
    (param application StyleApplication)
    (param conditions U32)
    ; The condition a style rule written after `•` on a markup element is applied under, made under
    ; those given, as the reference puts it after the state cells: tested where each gate it is part
    ; of is made, and again by the function written for it. Those given where it writes none.
    (match? ([] (. ([] (. program modules) (. application module)) tree nodes) (. application written))
      (case (call .node-style-rule-application applied)
        (if (!= (. applied condition) 0)
          (let live (call (. tables live-statement-of) (. application instance) (. applied condition)))
          (if (not live)
            (call refuse .refused-statement (. application site))
            (return conditions)
          )
          (let next (as (. style-conditions length) U32))
          (+= style-conditions
            (call StyleCondition
              (block
                (arg (call StyleWhen (. application module) (. applied condition) (. U32 max) (. live rerun)))
                (arg conditions)
              )
            )
          )
          (return next)
        )
      )
    )
    (return conditions)
  )
  (fn-do _ marks-up Bool
    (param unit-id InstanceId)
    ; Whether the lines of the style rule an instance types that are not its own are the markup of
    ; the class that writes it, which its markup function runs: the rule is the class's `• This`,
    ; kept as its content (`defaults-content`).
    (let row ([] (. instances rows) unit-id))
    (let owner ([] (. program modules) (. row module)))
    (match? ([] (. owner decls) (. row initializer))
      (case (call .decl-style-rule rule)
        (match? ([] (. owner decls) (. rule owner))
          (case (call .decl-class class)
            (return (== (. class content) (. rule syntax)))
          )
        )
      )
    )
    (return false)
  )
  (fn-do _ generate-content Operand
    (param index U32)
    (param lines (list SyntaxId))
    (param conditions U32)
    (param number U32)
    (param made Operand)
    (param type TypeId)
    (param association Operand)
    ; The content the lines given of a style rule applied at a site by the application `index`
    ; generate, in the order written, as the reference's `compileGuardedContent` makes it: the
    ; object made a `MarkupElement` once, the function of each line made a `MarkupSlotBuilder` of it, and
    ; the record of the line's content made for the association at the next order. Under conditions,
    ; the record is enabled as they hold (`enable-content`). A line the type pass generated nothing for
    ; is passed over. Answers the association, as `declare-style` does.
    (let associated association)
    (let target (call make-operand .operand-void 0))
    (for (in line lines)
      (if (not (is ([] (. tree nodes) line) .node-markup))
        (continue)
      )
      (let found (call content-of index line))
      (if (not found)
        (continue)
      )
      (let row found)
      (if (== number (. U32 max))
        (call refuse .refused-statement line)
        (break)
      )
      (if (== (call operand-kind associated) .operand-void)
        (= associated (call associate-style-site line made type number))
      )
      (if (== (call operand-kind target) .operand-void)
        (= target (. (call content-target (. row site) line made type) operand))
      )
      (let builder (call content-builder row line))
      (let mark (. pending length))
      (+= pending associated)
      (+= pending target)
      (+= pending (call integer .machine-u32 (. row slot)))
      (+= pending (call order-value line style-order))
      (+= pending (. builder operand))
      (+= style-order 1)
      (let record (call call-instance (. facts style-runtime template-content) line mark))
      (if (!= conditions (. U32 max))
        (call enable-content conditions (. record operand) made type associated line)
      )
    )
    (return associated)
  )
  (fn-do _ content-of (? StyleContent)
    (param index U32)
    (param line SyntaxId)
    ; The content a line of a style rule generates where the application `index` applies it at the
    ; site of the instance emitted, as the type pass recorded it, or none.
    (for (in row (. facts style-contents))
      (if (and (== (. row instance) (. unit instance)) (== (. row application) index) (== (. row line) line))
        (return row)
      )
    )
    (return null)
  )
  (fn-do _ content-target Typed
    (param site SyntaxId)
    (param line SyntaxId)
    (param made Operand)
    (param type TypeId)
    ; The object generated content is made for, as the `MarkupElement` the style runtime takes it as,
    ; converted as the type pass recorded at its markup element.
    (let fact (call (. facts first-conversion) (. unit instance) site))
    (while (!= fact no-fact)
      (let row ([] (. facts conversions) fact))
      (if (and (== (. row reason) .reason-markup-host) (== (. row from) type))
        (return (call convert-one line row (call Typed made type)))
      )
      (= fact (. row next))
    )
    (call refuse .refused-conversion line)
    (return (call Typed made no-type))
  )
  (fn-do _ content-builder Typed
    (param row StyleContent)
    (param line SyntaxId)
    ; The function that builds the content a line of a style rule generates, made the
    ; `MarkupSlotBuilder` the style runtime takes, as the type pass recorded it in that function:
    ; a closure that captures nothing, whose environment is none or holds the values it keeps
    ; (`content-environment`).
    (let fact (call (. facts first-conversion) (. row builder) (. row line)))
    (while (!= fact no-fact)
      (let held ([] (. facts conversions) fact))
      (if (and (== (. held reason) .reason-markup-slot) (== (. held from) (. row closure)))
        (let environment (call content-environment row line))
        (return (call make-function line held environment))
      )
      (= fact (. held next))
    )
    (call refuse .refused-conversion line)
    (return (call Typed (call make-operand .operand-void 0) no-type))
  )
  (fn-do _ content-environment Operand
    (param row StyleContent)
    (param line SyntaxId)
    ; The environment of the function that builds generated content where it keeps state cells or
    ; values of the rules around rules written in rules (`kept-layout-of`): no environment in force,
    ; then each state cell the markup element it is generated at holds of those it keeps, then each
    ; value, in turn (`around-local`). None where it keeps none.
    (let layout (call (. tables kept-layout-of) (. row builder)))
    (if (== layout no-layout)
      (return (call integer .machine-managed-pointer 0))
    )
    (let mark (. pending length))
    (+= pending (call integer .machine-u64 (. ([] (. tables layouts rows) layout) size)))
    (+= pending (call make-operand .operand-descriptor layout))
    (let kept (call (. ir add-local) managed-layout))
    (call store-local kept (call call-runtime .runtime-allocate-object line mark managed-layout) line)
    (let place U32 1)
    (let taken U32)
    (for (in held (. facts scope-cells))
      (if (or (!= (. held instance) (. row builder)) (== (. held kept) (. U32 max)))
        (continue)
      )
      (let local
        (scope (if-expr (< (. held kept) (. row cells)) (call cell-local kept-cell) no-local)
          (lazy kept-cell ([] (. facts content-cells) (+ (. row cell-first) (. held kept))))
        )
      )
      (if (== local no-local)
        (call refuse .refused-expression line)
        (return (call load-local kept line))
      )
      (call store
        (block
          (arg (call load-local kept line))
          (arg (. (call (. tables layouts field) layout (+ (. held kept) 1)) offset))
          (arg (call load-local local line))
          (arg true)
          (arg line)
        )
      )
      (+= place 1)
    )
    (for (in held (. facts scope-values))
      (if (or (!= (. held instance) (. row builder)) (== (. held kept) (. U32 max)))
        (continue)
      )
      (if (>= taken (. row values))
        (call refuse .refused-expression line)
        (return (call load-local kept line))
      )
      (let source ([] (. facts content-values) (+ (. row value-first) taken)))
      (for (in position (..< 0 (. held count)))
        (let (tuple local type) (call around-local source position))
        (let field (call (. tables layouts field) layout place))
        (if (or (== local no-local) other-type (call (. tables layouts is-struct) (. field layout)))
          (call refuse .refused-expression line)
          (return (call load-local kept line))
        )
        (lazy other-type (!= type ([] (. facts scope-value-types) (+ (. held type-first) position))))
        (call store
          (block
            (arg (call load-local kept line))
            (arg (. field offset))
            (arg (call load-local local line))
            (arg (call is-managed-pointer (. field layout)))
            (arg line)
          )
        )
        (+= place 1)
      )
      (+= taken 1)
    )
    (return (call load-local kept line))
  )
  (fn-do _ enable-content _
    (param conditions U32)
    (param record Operand)
    (param made Operand)
    (param type TypeId)
    (param association Operand)
    (param site SyntaxId)
    ; Enables the record of generated content as the conditions it is made under hold, as the
    ; reference's `compileGuardedContent` does: they are evaluated once in a live action of their
    ; own, which gathers what they read, and the record is enabled or disabled there; then the
    ; association is given an action with those trackers that runs the function of the row of
    ; `style-gates` for the content (`emit-style-gate`) with what it keeps: the object, the record and
    ; what `gate-locals` holds. An error enabling it raises leaves the function.
    (let whens (call gate-whens conditions))
    (let row (call (. facts gate-of) type whens true))
    (if (== row (. U32 max))
      (call refuse .refused-statement site)
      (return)
    )
    (let cells (call gate-locals whens site))
    (let runtime (. facts style-runtime))
    (let kept-record (call (. ir add-local) managed-layout))
    (call store-local kept-record record site)
    (let trackers (call open-trackers site))
    (+= live-actions (call LiveTrackers trackers trackers))
    (let loaded (list Operand))
    (for (in cell cells)
      (+= loaded (call load-local cell site))
    )
    (let enabled (call gate-conditions whens made type loaded true))
    (let mark (. pending length))
    (+= pending (call load-local kept-record site))
    (+= pending enabled)
    (do
      (inline (call raising-call site (. runtime content-enabled) mark))
    )
    (call (. live-actions pop))
    (let layout ([] (. tables gate-layouts) row))
    (let size (. ([] (. tables layouts rows) layout) size))
    (= mark (. pending length))
    (+= pending (call integer .machine-u64 size))
    (+= pending (call make-operand .operand-descriptor layout))
    (let kept (call (. ir add-local) managed-layout))
    (call store-local kept (call call-runtime .runtime-allocate-object site mark managed-layout) site)
    (call store (call load-local kept site) (. (call (. tables layouts field) layout 0) offset) made true site)
    (call store
      (block
        (arg (call load-local kept site))
        (arg (. (call (. tables layouts field) layout 1) offset))
        (arg (call load-local kept-record site))
        (arg true)
        (arg site)
      )
    )
    (for (in position (..< 0 (. cells length)))
      (call store
        (block
          (arg (call load-local kept site))
          (arg (. (call (. tables layouts field) layout (+ (as position U32) 2)) offset))
          (arg (call load-local ([] cells position) site))
          (arg true)
          (arg site)
        )
      )
    )
    (let callback
      (call make-callback
        (block
          (arg (call (. tables live-adapter-of) ([] (. tables gate-functions) row)))
          (arg (call load-local kept site))
          (arg site)
        )
      )
    )
    (= mark (. pending length))
    (+= pending made)
    (+= pending (call load-local trackers site))
    (+= pending callback)
    (let action (call call-instance (. ([] (. facts style-gates) row) action) site mark))
    (= mark (. pending length))
    (+= pending association)
    (+= pending (. action operand))
    (do
      (inline (call call-instance (. runtime dynamic) site mark))
    )
  )
  (fn-do _ call-shared-rule Operand
    (param index U32)
    (param number U32)
    (param made Operand)
    (param type TypeId)
    (param association Operand)
    ; A `shared` application of a style rule, as the reference's `callStyleRuleFunction` makes one,
    ; at the type the element names, as the rule is matched by: the object's association with the
    ; site made first, then the function given the object, the association, the site's number and
    ; the order its declarations start from, which count on after them.
    (let application ([] (. facts style-applications) index))
    (let code (call (. tables rule-function-of) index))
    (if (or (== code no-function) (== number (. U32 max)))
      (call refuse .refused-statement (. application site))
      (return association)
    )
    (let own-unit unit)
    (= unit (= (. unit source-module) (. application module)))
    (let called (. application site))
    (match? ([] (. tree nodes) called)
      (case (call .node-markup row)
        (= called (. row type-id))
      )
    )
    (let opening association)
    (if (== (call operand-kind opening) .operand-void)
      (= opening (call associate-style-site called made type number))
    )
    (let target ([] (. tables functions) code))
    (let mark (. pending length))
    (+= pending made)
    (+= pending opening)
    (+= pending (call site-value number))
    (+= pending (call order-value called style-order))
    (call (. ir depend) .callee-function code may-panic-dependency)
    (call call
      (block
        (arg (call make-operand .operand-symbol (. target symbol)))
        (arg called)
        (arg mark)
        (arg .callee-function)
        (arg void-layout)
        (arg (not in-landing))
      )
    )
    (= unit own-unit)
    (+= style-order (. application span))
    (return opening)
  )
  (fn-do + emit-style-rule _
    ; The function the reference makes for a style rule applied `shared`, given the object, its
    ; association with the site, the site's number and the order to start from: the rule applied
    ; as at an element, its declarations at the number and orders given.
    (let index (. function place))
    (let application ([] (. facts style-applications) index))
    (let runtime (. facts style-runtime))
    (= unit (= (. unit source-module) (. ([] (. instances rows) (. application unit)) module)))
    (let association-layout (call layout-of (. ([] (. instances signatures) (. runtime associate)) returns) (. application site)))
    (call (. ir add-argument) managed-layout)
    (call (. ir add-argument) association-layout)
    (call (. ir add-argument) u64-layout)
    (call (. ir add-argument) u32-layout)
    (= returns-type (. types void-type))
    (= (. ir returns) void-layout)
    (= site-param (call make-operand .operand-argument 2))
    (= order-param (call make-operand .operand-argument 3))
    (= shared-rule index)
    (= style-order 0)
    (call begin-recording (. application site) (. application module) 0)
    (do
      (inline
        (call apply-style-rule index 0 styled (. application made) (call make-operand .operand-argument 1) (. U32 max)
          (block
            (lazy styled (call make-operand .operand-argument 0))
          )
        )
      )
    )
    (call return-value (call make-operand .operand-void 0) (. application site))
  )
  (fn-do _ site-value Operand
    (param number U32)
    ; The number of a style site as the runtime takes it: that given the function of a `shared`
    ; rule, or the site's own.
    (if site-param
      (return site-param)
    )
    (return (call integer .machine-u64 number))
  )
  (fn-do _ order-value Operand
    (param site SyntaxId)
    (param order U32)
    ; An order of a declaration as the runtime takes it: counted from that given the function of a
    ; `shared` rule, or as it is.
    (if order-param
      (return (call arithmetic site .arithmetic-add order-param (call integer .machine-u32 order) u32-layout))
    )
    (return (call integer .machine-u32 order))
  )
  (fn-do _ apply-inner-rules Operand (?! Refused)
    (param index U32)
    (param within SyntaxId)
    (param number U32)
    (param made Operand)
    (param type TypeId)
    (param association Operand)
    (param inherited U32)
    ; Applies the rules a style rule applied at a site applies, after its name or, `within` the
    ; body of one of its `when`s, there, in the order recorded, under the conditions given.
    (let associated association)
    (let position (+ index 1))
    (while (< position (. facts style-applications length))
      (let nested ([] (. facts style-applications) position))
      (if (or (== (. nested outer) (. U32 max)) (< (. nested outer) index))
        (break)
      )
      (if (and (== (. nested outer) index) (== (. nested within) within))
        (= associated (call apply-style-rule position number made type associated inherited))
      )
      (+= position 1)
    )
    (return associated)
  )
  (fn-do _ declare-rule-style Operand
    (param row StyleDeclaration)
    (param layer U32)
    (param gated Bool)
    (param number U32)
    (param made Operand)
    (param type TypeId)
    (param association Operand)
    ; A declaration of a style rule applied at a site, at the next order: in the block of the gate
    ; in force, opened for it where none is, at the conditional layer at least, or a default's at
    ; the gated defaults layer, where it is `gated`.
    (let order style-order)
    (+= style-order 1)
    (if (not gated)
      (return (call declare-style row layer order number made type association))
    )
    (let associated (call open-gate (. styling gate) (. row site) made type number association))
    (let floor (if-expr (== layer 0) 3u32 4u32))
    (return
      (call declare-style
        (block
          (arg row)
          (arg (if-expr (> layer floor) layer floor))
          (arg order)
          (arg number)
          (arg made)
          (arg type)
          (arg associated)
          (arg true)
        )
      )
    )
  )
  (fn-do _ cell-condition U32
    (param cell U32)
    (param outer-cells U32)
    (param inherited U32)
    ; The condition a style rule applied under the state cells of `when`s is gated by, as the
    ; reference's `styleScopeStateConditions` puts the cells before those it is applied under: those
    ; of the `when`s further out (`outer-cells`), the outermost first, then the innermost's, then each
    ; of those made again over them. Those given where there is no cell.
    (if (== cell (. U32 max))
      (return inherited)
    )
    (let chain (list U32))
    (call (. facts link-cells) outer-cells chain)
    (+= chain cell)
    (let top (. U32 max))
    (for (in place chain)
      (let held ([] (. facts scope-cells) place))
      (let next (as (. style-conditions length) U32))
      (+= style-conditions (call StyleCondition (call StyleWhen (. held module) (. held when) place) top))
      (= top next)
    )
    (if (== inherited (. U32 max))
      (return top)
    )
    (for (in place (call gate-whens inherited))
      (let next (as (. style-conditions length) U32))
      (+= style-conditions (call StyleCondition place top))
      (= top next)
    )
    (return top)
  )
  (fn-do _ enter-gate U32
    (param top U32)
    (param made Operand)
    (param type TypeId)
    (param association Operand)
    ; Gates the declarations that follow at a site by a condition and those it was made under, as
    ; the reference's `compileStyleGatedBlock` does: they join the gate in force where it has the
    ; same conditions; otherwise that gate is closed and a gate of their own is entered. Answers
    ; the gate to leave, or `U32.max` where none was entered.
    (if (and (!= (. styling gate) (. U32 max)) (== (. ([] site-gates (. styling gate)) top) top))
      (return (. U32 max))
    )
    (if (!= (. styling gate) (. U32 max))
      (call close-gate (. styling gate) made type association)
    )
    (let gate (as (. site-gates length) U32))
    (+= site-gates (call SiteGate top no-local (. styling gate)))
    (= styling (= (. styling gate) gate))
    (return gate)
  )
  (fn-do _ leave-gate _
    (param gate U32)
    (param made Operand)
    (param type TypeId)
    (param association Operand)
    ; Leaves a gate `enter-gate` entered: the gate in force where it was entered is in force
    ; again, closed, and the gate is closed.
    (if (== gate (. U32 max))
      (return)
    )
    (= styling (= (. styling gate) (. ([] site-gates gate) outer)))
    (call close-gate gate made type association)
  )
  (fn-do _ open-gate Operand
    (param gate U32)
    (param site SyntaxId)
    (param made Operand)
    (param type TypeId)
    (param number U32)
    (param association Operand)
    ; Opens a block of declarations for a gate at its first declaration, as the reference's
    ; `openStyleGate` does: the object is associated with the site where it was not, and the
    ; number of the block the association opens is kept. Answers the association.
    (if (!= (. ([] site-gates gate) block) no-local)
      (return association)
    )
    (let associated association)
    (if (== (call operand-kind associated) .operand-void)
      (= associated (call associate-style-site site made type number))
    )
    (let mark (. pending length))
    (+= pending associated)
    (let block (call call-instance (. facts style-runtime open-block) site mark))
    (let local (call (. ir add-local) i64-layout))
    (call store-local local (. block operand) site)
    (= ([] site-gates gate) (= (. ([] site-gates gate) block) local))
    (return associated)
  )
  (fn-do _ close-gate _
    (param gate U32)
    (param made Operand)
    (param type TypeId)
    (param association Operand)
    ; Closes the block a gate has open, as the reference's `closeStyleGate` does, at its innermost
    ; `when`: the association closes it, its conditions are evaluated once in a live action of
    ; their own to gather what they read, and the association is given an action with those
    ; trackers that runs the gate's function (`emit-style-gate`) with what it keeps: the object, the
    ; block and what `gate-locals` holds. A gate with no block open does nothing.
    (let local (. ([] site-gates gate) block))
    (if (== local no-local)
      (return)
    )
    (= ([] site-gates gate) (= (. ([] site-gates gate) block) no-local))
    (let whens (call gate-whens (. ([] site-gates gate) top)))
    (let row (call (. facts gate-of) type whens))
    (let place ([] whens (- (. whens length) 1)))
    (let own-unit unit)
    (= unit (= (. unit source-module) (. place module)))
    (let site (. place syntax))
    (if (== row (. U32 max))
      (call refuse .refused-statement site)
      (= unit own-unit)
      (return)
    )
    (let cells (call gate-locals whens site))
    (let runtime (. facts style-runtime))
    (let mark (. pending length))
    (+= pending association)
    (+= pending (call load-local local site))
    (do
      (inline (call call-instance (. runtime close-block) site mark))
    )
    (let trackers (call open-trackers site))
    (+= live-actions (call LiveTrackers trackers trackers))
    (let loaded (list Operand))
    (for (in cell cells)
      (+= loaded (call load-local cell site))
    )
    (call gate-conditions whens made type loaded true)
    (call (. live-actions pop))
    (let layout ([] (. tables gate-layouts) row))
    (let size (. ([] (. tables layouts rows) layout) size))
    (= mark (. pending length))
    (+= pending (call integer .machine-u64 size))
    (+= pending (call make-operand .operand-descriptor layout))
    (let kept (call (. ir add-local) managed-layout))
    (call store-local kept (call call-runtime .runtime-allocate-object site mark managed-layout) site)
    (call store (call load-local kept site) (. (call (. tables layouts field) layout 0) offset) made true site)
    (call store
      (block
        (arg (call load-local kept site))
        (arg (. (call (. tables layouts field) layout 1) offset))
        (arg (call load-local local site))
        (arg false)
        (arg site)
      )
    )
    (for (in position (..< 0 (. cells length)))
      (call store
        (block
          (arg (call load-local kept site))
          (arg (. (call (. tables layouts field) layout (+ (as position U32) 2)) offset))
          (arg (call load-local ([] cells position) site))
          (arg true)
          (arg site)
        )
      )
    )
    (let callback
      (call make-callback
        (block
          (arg (call (. tables live-adapter-of) ([] (. tables gate-functions) row)))
          (arg (call load-local kept site))
          (arg site)
        )
      )
    )
    (= mark (. pending length))
    (+= pending made)
    (+= pending (call load-local trackers site))
    (+= pending callback)
    (let action (call call-instance (. ([] (. facts style-gates) row) action) site mark))
    (= mark (. pending length))
    (+= pending association)
    (+= pending (. action operand))
    (do
      (inline (call call-instance (. runtime dynamic) site mark))
    )
    (= unit own-unit)
  )
  (fn-do _ gate-locals (list LocalId)
    (param whens (list StyleWhen))
    (param site SyntaxId)
    ; The locals holding what the function of a gate keeps for its `when`s, in turn: the state cell
    ; of each that is one, and for each condition a rule is applied under the environment in force
    ; here, from which the function written for it reads what it captured. Refused where a cell is
    ; not made here.
    (let locals (list LocalId))
    (for (in held whens)
      (if (!= (. held cell) (. U32 max))
        (let local (call cell-local (. held cell)))
        (if (== local no-local)
          (call refuse .refused-statement site)
          (return locals)
        )
        (+= locals local)
        (else-if (!= (. held test) no-instance)
          (let local (call (. ir add-local) managed-layout))
          (call store-local local (call written-environment site) site)
          (+= locals local)
        )
      )
    )
    (return locals)
  )
  (fn-do _ gate-whens (list StyleWhen)
    (param top U32)
    ; The `when`s of a condition made at a site and of those it was made under, the outermost
    ; first.
    (let upward (list StyleWhen))
    (let condition top)
    (while (!= condition (. U32 max))
      (+= upward (. ([] style-conditions condition) when))
      (= condition (. ([] style-conditions condition) parent))
    )
    (let whens (list StyleWhen))
    (for (in position (..< 0 (. upward length)))
      (+= whens ([] upward (- (. upward length) 1 position)))
    )
    (return whens)
  )
  (fn-do _ gate-conditions Operand
    (param whens (list StyleWhen))
    (param object Operand)
    (param type TypeId)
    (param cells (list Operand))
    (param at-site Bool)
    ; Evaluates the states the `when`s given name, the outermost first, on an object, as the
    ; reference evaluates their conjunction: each read tracked, true or, where it is negated,
    ; false, and each but the first only where those before hold. The `when` of a state cell reads
    ; `is-on` of the cell, tracked. A condition a rule is applied under is evaluated where the
    ; element is written, `at-site` (`site-condition`), or else by the function written for it,
    ; given the environment kept for it. `cells` gives the cells and the environments in turn.
    ; Answers whether all hold.
    (let own-unit unit)
    (let place ([] whens 0))
    (= unit (= (. unit source-module) (. place module)))
    (let layout (call layout-of (. types bool-type) (. place syntax)))
    (let held (call (. ir add-local) layout))
    (let done (call (. ir reserve-block)))
    (let celled 0)
    (for (in position (..< 0 (. whens length)))
      (= place ([] whens position))
      (= unit (= (. unit source-module) (. place module)))
      (let value (call make-operand .operand-void 0))
      (if (!= (. place cell) (. U32 max))
        (let is-on (call (. program store-atom) "is-on"))
        (call track (. place syntax) ([] cells celled) is-on)
        (= value (. (call read-state (. place syntax) ([] cells celled) (call (. tables cell-type)) is-on) operand))
        (+= celled 1)
        (else-if (!= (. place test) no-instance)
          (if at-site
            (= value (. (call site-condition place) operand))
            (else
              (let mark (. pending length))
              (+= pending ([] cells celled))
              (= value (. (call call-instance (. place test) (. place syntax) mark) operand))
            )
          )
          (+= celled 1)
        )
        (else
          (match? ([] (. tree nodes) (. place syntax))
            (case (call .node-style-when row)
              (call track (. place syntax) object (. row state))
              (let state-read (call read-state (. place syntax) object type (. row state)))
              (= value (. state-read operand))
              (if (. row is-negated)
                (= value (. (call compare-zero (. place syntax) (call Typed value (. state-read type)) .compare-equal) operand))
              )
            )
          )
        )
      )
      (call store-local held value (. place syntax))
      (if (< (+ position 1) (. whens length))
        (let next (call (. ir reserve-block)))
        (call branch (call load-local held (. place syntax)) next done)
        (call (. ir start-block) next)
      )
    )
    (call jump done)
    (call (. ir start-block) done)
    (let holds (call load-local held (. place syntax)))
    (= unit own-unit)
    (return holds)
  )
  (fn-do _ site-condition Typed
    (param place StyleWhen)
    ; The condition a style rule written on a markup element is applied under, evaluated where the
    ; element is written, with the trackers of the live action open noting what it reads: as the
    ; instance that writes it types it, with the receiver there.
    (let own-unit unit)
    (= unit (= (. unit reading) (. ([] (. instances rows) (. place test)) enclosing)))
    (= unit (= (. unit self) site-self))
    (= unit (= (. unit self-type) site-self-type))
    (= unit (= (. unit has-self) site-has-self))
    (= unit (= (. unit running-rule) false))
    (= unit (= (. unit deferred-type) site-deferred))
    (let value (call emit-expression (. place syntax)))
    (= unit own-unit)
    (return (call Typed (. value operand) (. types bool-type)))
  )
  (fn-do + gives-rule-values Bool
    (param id SyntaxId)
    ; Whether a markup element writes a style rule application that gives values, or applies a rule
    ; that the reference evaluates the values of once more as it prepares the element (`prepared`).
    (match? ([] (. tree nodes) id)
      (case (call .node-markup element)
        (for (in application ([] (. tree children) (. element style-rule-applications)))
          (match? ([] (. tree nodes) application)
            (case (call .node-style-rule-application applied)
              (if (!= (. applied args count) 0)
                (return true)
              )
            )
          )
        )
      )
    )
    (let place (call (. tables first-application) (. unit reading)))
    (while (!= place (. U32 max))
      (let held ([] (. facts style-applications) place))
      (if (and (. held prepared) (== (. held module) (. unit source-module)) (== (. held site) id))
        (return true)
      )
      (= place (call (. tables next-application) place))
    )
    (return false)
  )
  (fn-do + emit-rule-values _
    (param id SyntaxId)
    ; Evaluates the values given to the style rules written on a markup element, in the order
    ; written, once its attributes are and before its object is made, as the reference evaluates
    ; them, whether or not a rule takes them: each is kept as evaluated, to be converted where its
    ; rule is applied. Those of a rule the rules written in it read (`ScopeValues`) are converted
    ; now, for the constructor to be given them too (`around-values`). The values the reference
    ; evaluates once more as it prepares the element are evaluated and let go after those of the
    ; application that applies their rules, those of rules the element applies by none first
    ; (`prepare-applied`).
    (match? ([] (. tree nodes) id)
      (case (call .node-markup element)
        (call prepare-applied id 0)
        (for (in application ([] (. tree children) (. element style-rule-applications)))
          (match? ([] (. tree nodes) application)
            (case (call .node-style-rule-application applied)
              (let read (call reads-around application))
              (for (in value ([] (. tree children) (. applied args)))
                (if (call (. facts theme-read-of) (. unit reading) value)
                  (continue)
                )
                (let kept (call emit-expression value))
                (+= rule-givens (call RuleValue (call apart kept value true) (. kept type) value))
                (if read
                  (let converted (call convert value .reason-argument kept))
                  (let layout (call layout-of (. converted type) value))
                  (let local (call (. ir add-local) layout false))
                  (call store-local local (. converted operand) value)
                  (+= around-values (call AroundValue value local (. converted type)))
                )
              )
              (call prepare-applied id application)
            )
          )
        )
      )
    )
  )
  (fn-do _ prepare-applied _
    (param site SyntaxId)
    (param written SyntaxId)
    ; Evaluates the values the reference evaluates once more as it prepares a markup element, of the
    ; rules after the names of those the element applies by the application `written`, or by none
    ; it writes (`prepare-rule-values`).
    (let place (call (. tables first-application) (. unit reading)))
    (while (!= place (. U32 max))
      (let held ([] (. facts style-applications) place))
      (if (and (== (. held module) (. unit source-module)) (== (. held site) site) top-written)
        (call prepare-rule-values place)
      )
      (lazy top-written (and (== (. held outer) (. U32 max)) (== (. held written) written)))
      (= place (call (. tables next-application) place))
    )
  )
  (fn-do _ prepare-rule-values _ (?! Refused)
    (param index U32)
    ; Evaluates, and lets go, the values that call a function given to the rules written after the
    ; name of the rule the application `index` applies, and after theirs in turn, in order, as the
    ; reference evaluates them as it prepares the markup element (`nestedRuleScopesForPrepared`),
    ; before its object is made (`prepared`): in the instance that types the rule that writes them,
    ; where there is no object yet, nor the values of the rules around. They are evaluated again as
    ; their rules are applied.
    (let position (+ index 1))
    (while (< position (. facts style-applications length))
      (let nested ([] (. facts style-applications) position))
      (if (or (== (. nested outer) (. U32 max)) (< (. nested outer) index))
        (break)
      )
      (if (and (== (. nested outer) index) (== (. nested within) 0))
        (if (. nested prepared)
          (call drop-rule-values (. nested written) (. ([] (. facts style-applications) index) unit))
        )
        (call prepare-rule-values position)
      )
      (+= position 1)
    )
  )
  (fn-do _ drop-rule-values _
    (param written SyntaxId)
    (param unit-id InstanceId)
    ; Evaluates the values a written application gives, in the instance `unit-id` that types them, and
    ; lets them go (`prepare-rule-values`).
    (let own-unit unit)
    (let own-filling filling)
    (= unit (= (. unit source-module) (. ([] (. instances rows) unit-id) module)))
    (= unit (= (. unit reading) unit-id))
    (= unit (= (. unit self-type) (. ([] (. instances rows) unit-id) self-type)))
    (= unit (= (. unit has-self) false))
    (= filling (= (. filling count) 0))
    (= unit (= (. unit deferred-type) no-type))
    (= unit (= (. unit running-rule) false))
    (match? ([] (. tree nodes) written)
      (case (call .node-style-rule-application applied)
        (for (in value ([] (. tree children) (. applied args)))
          (call emit-expression value)
        )
      )
    )
    (= unit own-unit)
    (= filling own-filling)
  )
  (fn-do _ reads-around Bool
    (param application SyntaxId)
    ; Whether the values an application written after `•` here gives are read by the rules written
    ; in the rule it applies (`ScopeValues`).
    (for (in held (. facts scope-values))
      (if (and (== (. held instance) (. unit instance)) (== (. held site) application) (== (. held module) (. unit source-module)))
        (return true)
      )
    )
    (return false)
  )
  (fn-do _ bind-rule-values _
    (param written SyntaxId)
    (param unit-id InstanceId)
    (param now Bool)
    (param values InstanceId)
    ; Converts each value a written application gives a style rule, at its node, to the type the
    ; rule takes it as, and keeps it in a local of its own for the rule's reads of the name that
    ; takes it. The values an element gives were evaluated before its object was made
    ; (`emit-rule-values`); those a rule gives a rule it applies are evaluated `now`, in it, as are
    ; those a slot outlet gives once its node is mounted, and those an instance of their own types
    ; (`values`), read through its facts. Those an element gives are kept for the rules written in
    ; the rule too (`around-values`).
    (let row ([] (. instances rows) unit-id))
    (let owner ([] (. program modules) (. row module)))
    (let names (list SyntaxId))
    (match? ([] (. owner decls) (. row initializer))
      (case (call .decl-style-rule rule)
        (match? ([] (. owner tree nodes) (. rule syntax))
          (case (call .node-rule-syntax declared)
            (for (in arg ([] (. owner tree children) (. declared args)))
              (match? ([] (. owner tree nodes) arg)
                (case (call .node-argument-decl shape)
                  (match? ([] (. owner tree nodes) (. shape pattern))
                    (case (call .node-type-capture capture)
                      (+= names (. capture id))
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
    (match? ([] (. tree nodes) written)
      (case (call .node-style-rule-application applied)
        (if (!= (. applied args count) (. names length))
          (call refuse .refused-statement written)
          (return)
        )
        (for (in position (..< 0 (. applied args count)))
          (let value ([] (. tree children) (+ (. applied args start) position)))
          (if (and (== values no-instance) (call (. facts theme-read-of) (. unit reading) value))
            (continue)
          )
          (let given (call Typed (call make-operand .operand-void 0) no-type))
          (let converted given)
          (if (!= values no-instance)
            (= converted (call root-value value values))
            (else
              (if (not now)
                (let found (call around-place value))
                (if found
                  (+= rule-names
                    (call RuleName
                      (block
                        (arg (. (call (. bindings resolution-of) (. row binding) ([] names position)) slot))
                        (arg (. ([] around-values found) local))
                        (arg (. ([] around-values found) type))
                      )
                    )
                  )
                  (continue)
                )
              )
              (if now
                (= given (call emit-expression value))
                (else
                  (let index (. rule-givens length))
                  (while (and (!= index 0) (!= (. ([] rule-givens (- index 1)) written) value))
                    (-= index 1)
                  )
                  (if (== index 0)
                    (call refuse .refused-expression value)
                    (return)
                  )
                  (= given (call Typed (. ([] rule-givens (- index 1)) value) (. ([] rule-givens (- index 1)) type)))
                )
              )
              (= converted (call convert value .reason-argument given))
            )
          )
          (let layout (call layout-of (. converted type) value))
          (let local (call (. ir add-local) layout false))
          (call store-local local (. converted operand) value)
          (+= rule-names
            (call RuleName
              (block
                (arg (. (call (. bindings resolution-of) (. row binding) ([] names position)) slot))
                (arg local)
                (arg (. converted type))
              )
            )
          )
        )
        (return)
      )
    )
    (call refuse .refused-statement written)
  )
  (fn-do _ bind-around-values _
    (param index U32)
    (param unit-id InstanceId)
    (param site SyntaxId)
    ; Gives a rule written in a rule, for its reads of the names the rule around it takes values by,
    ; the values the markup element that applied that rule gave it (`ScopeValues`), as the
    ; reference defines them in the frames it is applied within (`withStyleRuleLexicalFrames`): each
    ; as kept, converted, where the rule around was applied, or as given (`around-local`).
    (let names (call around-names index))
    (for (in position (..< 0 (. names length)))
      (let (tuple local type) (call around-local index (as position U32)))
      (if (== local no-local)
        (call refuse .refused-statement site)
        (return)
      )
      (+= rule-names
        (call RuleName
          (block
            (arg (. (call (. bindings resolution-of) (. ([] (. instances rows) unit-id) binding) ([] names position)) slot))
            (arg local)
            (arg type)
          )
        )
      )
    )
  )
  (fn-do _ root-value Typed
    (param value SyntaxId)
    (param values InstanceId)
    ; A value a root `<This` gives a style rule its constructor applies, converted to the type the
    ; rule takes it as, read through the instance that types it (`check-root-values`) as a value
    ; written for the receiver's class is.
    (let own-unit unit)
    (= unit (= (. unit reading) values))
    (= unit (= (. unit running-rule) true))
    (= unit (= (. unit self-type) (. ([] (. instances rows) values) self-type)))
    (let given (call emit-expression value))
    (let converted given)
    (= converted (call convert value .reason-argument (call Typed (. given operand) (. converted type))))
    (= unit own-unit)
    (return converted)
  )
  (fn-do + read-rule-value Typed
    (param slot SlotId)
    (param id SyntaxId)
    (param type TypeId)
    ; A value a style rule takes, read in the rule where it is applied: what the local it is kept
    ; in holds, or what that holds where the type pass narrowed it.
    (let nothing (call make-operand .operand-void 0))
    (let position (. rule-names length))
    (while (!= position 0)
      (-= position 1)
      (if (== (. ([] rule-names position) slot) slot)
        (let held (. ([] rule-names position) type))
        (let cased (and (!= held type) (== (call (. facts plan-of) (. unit reading) id) .plan-case-read)))
        (if (and (!= held type) (or (!= shared-depth 0) (and (not (call holds held type)) (not cased))))
          (call refuse .refused-expression id)
          (return (call Typed nothing no-type))
        )
        (let value (call load-local (. ([] rule-names position) cell) id))
        (if (== held type)
          (return (call Typed value held))
        )
        (if cased
          (return (call read-case id value held type))
        )
        (return (call payload id (call Typed value held)))
      )
    )
    (call refuse .refused-expression id)
    (return (call Typed nothing no-type))
  )
  (fn-do _ rule-lines (of RowRange SyntaxId)
    (param unit-id InstanceId)
    ; The lines of the body of the style rule an instance types, or none where the rule has no
    ; body of lines, which has no shape here; or the line of a root `<This` that declares a style,
    ; which an instance of its own types (`check-root-style`).
    (let row ([] (. instances rows) unit-id))
    (let owner ([] (. program modules) (. row module)))
    (match? ([] (. owner decls) (. row initializer))
      (case (call .decl-style-rule rule)
        (match? ([] (. owner tree nodes) (. rule syntax))
          (case (call .node-rule-syntax written)
            (if (== (. written body) 0)
              (return (call (of RowRange SyntaxId)))
            )
            (match? ([] (. owner tree nodes) (. written body))
              (case (call .node-block block)
                (return (. block body))
              )
            )
          )
        )
      )
      (case (call .decl-property property)
        (match? ([] (. owner decls) (. property owner))
          (case (call .decl-class class)
            (match? ([] (. owner tree nodes) (call (. owner tree root-this) (. class content)))
              (case (call .node-markup root)
                (match? ([] (. owner tree nodes) (. root body))
                  (case (call .node-block block)
                    (for (in position (..< 0 (. block body count)))
                      (if (== statement (. property syntax))
                        (return (call (of RowRange SyntaxId) (+ (. block body start) position) 1))
                      )
                      (lazy statement ([] (. owner tree children) (+ (. block body start) position)))
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
    (call refuse-instance unit-id)
    (return (call (of RowRange SyntaxId)))
  )
  (fn-do _ update-rule-property _
    (param row RuleUpdate)
    (param made Operand)
    (param application StyleApplication)
    ; Stores the value a line of a style rule gives a property of the class that writes it in the
    ; object the rule is applied to, as a markup element's attribute is stored. One whose value read
    ; something tracked is evaluated in a live action of its own, whose trackers make the action that
    ; sets it again (`update-again`), and so is one whose value reads values an application with
    ; `live-values` gives (`update-given`).
    (let given
      (scope (if-expr (and (!= (. styling live) (. U32 max)) (. row reads-given)) author-place (. U32 max))
        (lazy author-place (call (. tables given-author) (. styling live) (. row site)))
      )
    )
    (if (!= given (. U32 max))
      (call update-given row given made application)
      (return)
    )
    (match? ([] (. tree nodes) (. row site))
      (case (call .node-assign line)
        (let live (call (. tables live-statement-of) (. unit reading) (. row site)))
        (let trackers (if-expr live (call open-trackers (. row site)) no-local))
        (if live
          (+= live-actions (call LiveTrackers trackers trackers))
        )
        (let value (call convert (. row site) .reason-assignment (call emit-expression (. line rhs))))
        (if live
          (call (. live-actions pop))
        )
        (call store-argument made (. unit self-type) (. row property) (. value operand) (. value type) (. row site))
        (if live
          (call update-again live trackers made application)
        )
      )
    )
  )
  (fn-do _ update-given _
    (param row RuleUpdate)
    (param place U32)
    (param made Operand)
    (param application StyleApplication)
    ; A line of a style rule that sets a property of the class with a value reading values an
    ; application with `live-values` gives: the values, evaluated again where they are written
    ; (`bind-live-values`), and the line's value are evaluated in a live action of their own to gather
    ; what they read, the value is stored, and the object owns an action with those trackers that runs
    ; the function of `given-functions` with what it keeps (`own-update`): the object, then the
    ; receiver where the values the site applies are written.
    (let code ([] (. tables given-functions) place))
    (let layout ([] (. tables given-layouts) place))
    (if (or (== code no-function) (. application shared))
      (call refuse .refused-statement (. row site))
      (return)
    )
    (let trackers (call open-trackers (. row site)))
    (+= live-actions (call LiveTrackers trackers trackers))
    (let bound (. rule-names length))
    (call bind-live-values (. styling live) made site-self site-deferred)
    (let value (call Typed (call make-operand .operand-void 0) no-type))
    (match? ([] (. tree nodes) (. row site))
      (case (call .node-assign line)
        (= value (call convert (. row site) .reason-assignment (call emit-expression (. line rhs))))
      )
    )
    (while (> (. rule-names length) bound)
      (call (. rule-names pop))
    )
    (call (. live-actions pop))
    (call store-argument made (. unit self-type) (. row property) (. value operand) (. value type) (. row site))
    (let mark (. pending length))
    (+= pending (call integer .machine-u64 (. ([] (. tables layouts rows) layout) size)))
    (+= pending (call make-operand .operand-descriptor layout))
    (let kept (call (. ir add-local) managed-layout))
    (call store-local kept (call call-runtime .runtime-allocate-object (. row site) mark managed-layout) (. row site))
    (call store (call load-local kept (. row site)) (. (call (. tables layouts field) layout 0) offset) made true (. row site))
    (call store
      (block
        (arg (call load-local kept (. row site)))
        (arg (. (call (. tables layouts field) layout 1) offset))
        (arg (call integer .machine-i64 (. U64 max)))
        (arg false)
        (arg (. row site))
      )
    )
    (call store
      (block
        (arg (call load-local kept (. row site)))
        (arg (. (call (. tables layouts field) layout 2) offset))
        (arg (call integer .machine-u32 0))
        (arg false)
        (arg (. row site))
      )
    )
    (call store
      (block
        (arg (call load-local kept (. row site)))
        (arg (. (call (. tables layouts field) layout 3) offset))
        (arg (call integer .machine-u32 0))
        (arg false)
        (arg (. row site))
      )
    )
    (call store (call load-local kept (. row site)) (. (call (. tables layouts field) layout 4) offset) site-self true (. row site))
    (call keep-given-row-items place (call load-local kept (. row site)) (. row site))
    (call own-update (. row site) trackers code (call load-local kept (. row site)) made application)
  )
  (fn-do _ update-again _
    (param live LiveStatement)
    (param trackers LocalId)
    (param made Operand)
    (param application StyleApplication)
    ; The live action of a line of a style rule whose value read something tracked, as the
    ; reference's `markupLiveAction` makes it for the object the rule is applied to: the object is
    ; kept in the local no name reaches declared at the line, in an environment of the rule's own
    ; layout made for the action alone (`lone-environment`), and the action, with the trackers the
    ; value noted and a callback that runs the line's function with that environment, is owned by
    ; the object: a plain one, or one the markup runtime makes, given the object where it is a
    ; batch, else the batch in force where the application chose one, else the object as its host.
    ; A rule a class shares among its elements has no shape here.
    (let site (. live site))
    (let slot (call channel-slot site))
    (let code (if-expr (!= (. live rerun) no-instance) ([] (. tables instance-functions) (. live rerun)) no-function))
    (if (or (== code no-function) (== slot no-slot) (. application shared))
      (call refuse .refused-statement site)
      (return)
    )
    (let lone (call lone-environment site slot))
    (call keep-lone lone slot made (. unit self-type) site)
    (let environment (call load-local lone site))
    (call own-update site trackers code environment made application)
  )
  (fn-do _ own-update _
    (param site SyntaxId)
    (param trackers LocalId)
    (param code FunctionId)
    (param environment Operand)
    (param made Operand)
    (param application StyleApplication)
    ; Makes the live action that sets a property a line of a style rule sets again, with the
    ; trackers given and a callback that runs a function with the environment given, owned by the
    ; object, as `update-again` says.
    (if (. application plain-updates)
      (let action
        (call make-action
          (block
            (arg (call load-local trackers site))
            (arg (call (. tables live-adapter-of) code))
            (arg environment)
            (arg site)
          )
        )
      )
      (call attach-action made (. action operand) site)
      (return)
    )
    (let updater (. application updater))
    (if (or (== updater no-instance) (!= (. ([] (. instances signatures) updater) errors count) 0))
      (call refuse .refused-statement site)
      (return)
    )
    (let callback (call make-callback (call (. tables live-adapter-of) code) environment site))
    (let owner (call make-operand .operand-void 0))
    (if (and (. application rooted) (call converts-for site .reason-markup-batch))
      (= owner (. (call convert site .reason-markup-batch (call Typed made (. unit self-type))) operand))
      (else-if (and (. application rooted) (!= (. content-roots length) 0))
        (= owner ([] content-roots (- (. content-roots length) 1)))
      )
      (else-if (not (. application rooted))
        (= owner (. (call convert site .reason-markup-host (call Typed made (. unit self-type))) operand))
      )
    )
    (if (== (call operand-kind owner) .operand-void)
      (call refuse .refused-statement site)
    )
    (let mark (. pending length))
    (+= pending (call load-local trackers site))
    (+= pending callback)
    (+= pending owner)
    (let action (call raising-call site updater mark))
    (call attach-action made (. action operand) site)
  )
  (fn-do _ converts-for Bool
    (param site SyntaxId)
    (param reason ConversionReason)
    ; Whether the type pass recorded a conversion at a site for a reason.
    (let fact (call (. facts first-conversion) (. unit reading) site))
    (while (!= fact no-fact)
      (if (== (. ([] (. facts conversions) fact) reason) reason)
        (return true)
      )
      (= fact (. ([] (. facts conversions) fact) next))
    )
    (return false)
  )
  (fn-do _ declare-style Operand
    (param row StyleDeclaration)
    (param layer U32)
    (param order U32)
    (param number U32)
    (param made Operand)
    (param type TypeId)
    (param association Operand)
    (param gated Bool (= false))
    ; A style declaration for an object at the site numbered `number`, as the reference makes one:
    ; the record of the property's style, by the style's number, then the bits of the value,
    ; declared for the site where the value reads nothing that differs from one making to the
    ; next, in the block of the gate in force where `gated`, and otherwise for the association of
    ; the object with the site, made at the first such. One whose value read something tracked is
    ; declared by a live action instead (`declare-live-style`), and so is one of a style rule
    ; (`declare-authored-style`), and one of a rule whose value reads values an application with
    ; `live-values` gives (`declare-given-style`). `inherit` is declared with no value, for the site. A value the
    ; runtime holds a handle to is declared for the association by a holder (`author-value`), or
    ; where the reference evaluates it once for every making, as `declare-cached` says, and the
    ; slot of a style sheet as `declare-sheet-slot` says. An optional that holds nothing is flagged
    ; none. Answers the association, or the one given where none was made.
    (let nothing (call make-operand .operand-void 0))
    (let live (call (. tables live-statement-of) (. unit reading) (. row site)))
    (let author (call (. facts style-author-of) (. unit reading) (. row site)))
    (let given (call given-place row))
    (let property ([] (. facts style-properties) (. row property)))
    (let sited
      (scope (or persistent (!= (. row themed) (. U32 max)) (and (. row fixed) (not (call holds-style-handle (. property type)))))
        (lazy persistent (or (. row inherits) (. row cached) (. row once) (!= (. row sheet) (. U32 max))))
      )
    )
    (if (and (. styling family-gated) (or (and live (not gated)) (!= author (. U32 max)) (!= given (. U32 max)) (not sited)))
      (call refuse .refused-statement (. row site))
      (return association)
    )
    (if (!= given (. U32 max))
      (return (call declare-given-style row given layer order gated number made type association))
    )
    (if (and live (not gated))
      (return (call declare-live-style row live number made type association))
    )
    (if (!= author (. U32 max))
      (return (call declare-authored-style row author layer order gated number made type association))
    )
    (let runtime (. facts style-runtime))
    (let index (call style-number (. row site) (. row style)))
    (let use ([] (. tables style-uses) index))
    (if sited
      (return (call declare-site-style row layer order number association))
    )
    (let mark (. pending length))
    (+= pending (call integer .machine-u64 index))
    (let info (call call-instance (. runtime info-required) (. row site) mark))
    (let value nothing)
    (match? ([] (. tree nodes) (. row site))
      (case (call .node-assign attribute)
        (= value (. (call convert (. row site) .reason-assignment (call emit-expression (. attribute rhs))) operand))
      )
    )
    (if (call holds-style-handle (. property type))
      (let held association)
      (if (== (call operand-kind held) .operand-void)
        (= held (call associate-style-site (. row site) made type number))
      )
      (let head (list Operand))
      (+= head held)
      (+= head (. info operand))
      (+= head (call integer .machine-u64 (- (. row property) (. use first))))
      (+= head (call integer .machine-u32 layer))
      (+= head (call order-value (. row site) order))
      (call author-value
        (block
          (arg (. row site))
          (arg (. property type))
          (arg value)
          (arg head)
          (arg (. runtime template-static))
          (arg (. runtime template-object))
        )
      )
      (return held)
    )
    (let none (call none-flag (. row site) (. property type) value))
    (let bits (call style-bits (. row site) (. property type) value))
    (let associated association)
    (if (== (call operand-kind associated) .operand-void)
      (= associated (call associate-style-site (. row site) made type number))
    )
    (= mark (. pending length))
    (+= pending associated)
    (+= pending (. info operand))
    (+= pending (call integer .machine-u64 (- (. row property) (. use first))))
    (+= pending (call integer .machine-u32 layer))
    (+= pending (call order-value (. row site) order))
    (+= pending bits)
    (+= pending (. none operand))
    (do
      (inline (call call-instance (. runtime template-static) (. row site) mark))
    )
    (return associated)
  )
  (fn-do _ declare-site-style Operand
    (param row StyleDeclaration)
    (param layer U32)
    (param order U32)
    (param number U32)
    (param association Operand)
    (let recording (call recording-local number))
    (if (== recording no-local)
      (call refuse .refused-statement (. row site))
      (return association)
    )
    (let making (call (. ir reserve-block)))
    (let joined (call (. ir reserve-block)))
    (call branch (call load-local recording (. row site)) making joined)
    (call (. ir start-block) making)
    (do
      (inline (call record-site-style row layer order number association))
    )
    (call jump joined)
    (call (. ir start-block) joined)
    (return association)
  )
  (fn-do _ record-site-style Operand
    (param row StyleDeclaration)
    (param layer U32)
    (param order U32)
    (param number U32)
    (param association Operand)
    (let runtime (. facts style-runtime))
    (let mark (. pending length))
    (+= pending (call integer .machine-u64 (call style-number (. row site) (. row style))))
    (let info (call call-instance (. runtime info-required) (. row site) mark))
    (if (. row inherits)
      (return (call declare-inherit row (. info operand) layer order number association))
    )
    (if (. row cached)
      (return (call declare-cached row (. info operand) layer order number association))
    )
    (if (!= (. row themed) (. U32 max))
      (return (call declare-themed row (. info operand) layer order number association))
    )
    (if (!= (. row sheet) (. U32 max))
      (return (call declare-sheet-slot row (. info operand) layer order number association))
    )
    (return (call declare-fixed row (. info operand) layer order number association))
  )
  (fn-do _ declare-fixed Operand
    (param row StyleDeclaration)
    (param info Operand)
    (param layer U32)
    (param order U32)
    (param number U32)
    (param association Operand)
    (let use ([] (. tables style-uses) (call style-number (. row site) (. row style))))
    (let property ([] (. facts style-properties) (. row property)))
    (let value (call make-operand .operand-void 0))
    (match? ([] (. tree nodes) (. row site))
      (case (call .node-assign attribute)
        (= value (. (call convert (. row site) .reason-assignment (call emit-expression (. attribute rhs))) operand))
      )
    )
    (let none (call none-flag (. row site) (. property type) value))
    (let bits (call style-bits (. row site) (. property type) value))
    (let mark (. pending length))
    (+= pending (call site-value number))
    (+= pending info)
    (+= pending (call integer .machine-u64 (- (. row property) (. use first))))
    (+= pending (call integer .machine-u32 layer))
    (+= pending (call order-value (. row site) order))
    (+= pending bits)
    (+= pending (. none operand))
    (do
      (inline (call call-instance (. facts style-runtime site-static) (. row site) mark))
    )
    (return association)
  )
  (fn-do _ record-family _
    (param application StyleApplication)
    (param number U32)
    (param entering Bool)
    (let recording (call recording-local number))
    (if (== recording no-local)
      (call refuse .refused-statement (. application site))
      (return)
    )
    (let own-unit unit)
    (= unit (= (. unit source-module) (. application module)))
    (let at (. application site))
    (let making (call (. ir reserve-block)))
    (let joined (call (. ir reserve-block)))
    (call branch (call load-local recording at) making joined)
    (call (. ir start-block) making)
    (let runtime (. facts style-runtime))
    (let mark (. pending length))
    (+= pending (call site-value number))
    (if entering
      (let held (. pending length))
      (+= pending (call integer .machine-u64 (call (. tables sheet-number) (. application family))))
      (let sheet (call call-instance (. runtime sheet-info-required) at held))
      (+= pending (. sheet operand))
      (+= pending (call integer .machine-u64 (. application members)))
      (do
        (inline (call call-instance (. runtime site-family) at mark))
      )
      (else
        (do
          (inline (call call-instance (. runtime site-family-end) at mark))
        )
      )
    )
    (call jump joined)
    (call (. ir start-block) joined)
    (= unit own-unit)
  )
  (fn-do _ begin-recording _
    (param at SyntaxId)
    (param module ModuleId)
    (param number U32)
    (return-if (if (== number (. U32 max))))
    (blank)
    (let own-unit unit)
    (= unit (= (. unit source-module) module))
    (let mark (. pending length))
    (+= pending (call site-value number))
    (let recording (call call-instance (. facts style-runtime site-recording) at mark))
    (let local (call (. ir add-local) u8-layout))
    (call store-local local (. recording operand) at)
    (= unit own-unit)
    (let found (call recording-place number))
    (if found
      (= ([] recordings found) (= (. ([] recordings found) local) local))
      (return)
    )
    (+= recordings (call RecordedLocal number local))
  )
  (fn-expr _ recording-local LocalId
    (param number U32)
    (if-expr found (. ([] recordings found) local) no-local)
    (where
      (lazy found (call recording-place number))
    )
  )
  (fn-do _ recording-place (? Size)
    (param number U32)
    ; Where `recordings` keeps the local of a number the function records a value under.
    (for (in position (..< 0 (. recordings length)))
      (if (== (. ([] recordings position) number) number)
        (return position)
      )
    )
    (return null)
  )
  (fn-do _ declare-cached Operand
    (param row StyleDeclaration)
    (param info Operand)
    (param layer U32)
    (param order U32)
    (param number U32)
    (param association Operand)
    ; A declaration whose value the reference evaluates once for every making, as its
    ; `compileStaticStyleObjectDeclaration` makes one: the runtime is given the number of the value,
    ; that of its function, and a function that evaluates it and gives its bits (`emit-static-value`),
    ; which it calls the first time only; for the site.
    (let place (call (. facts style-static-value-of) (. unit source-module) (. row site)))
    (let code (if-expr (!= place (. U32 max)) ([] (. tables static-value-functions) place) no-function))
    (if (== code no-function)
      (call refuse .refused-statement (. row site))
      (return association)
    )
    (let maker (call make-callback code (call integer (as managed-layout MachineKind) 0) (. row site)))
    (let use ([] (. tables style-uses) (call style-number (. row site) (. row style))))
    (let runtime (. facts style-runtime))
    (let mark (. pending length))
    (+= pending (call site-value number))
    (+= pending info)
    (+= pending (call integer .machine-u64 (- (. row property) (. use first))))
    (+= pending (call integer .machine-u32 layer))
    (+= pending (call order-value (. row site) order))
    (+= pending (call integer .machine-u64 (. ([] (. tables functions) code) number)))
    (+= pending maker)
    (do
      (inline (call call-instance (. runtime site-cached) (. row site) mark))
    )
    (return association)
  )
  (fn-do _ declare-themed Operand
