    (param layer U32)
    (param order U32)
    (param gated Bool)
    (param number U32)
    (param made Operand)
    (param type TypeId)
    (param association Operand)
    ; A declaration of a style rule whose value reads values an application with `live-values`
    ; gives, as `declare-authored-style` makes one whose own value reads something tracked: the
    ; values, evaluated again where they are written (`bind-live-values`), and the declaration's
    ; value are evaluated once in a live action of their own to gather what they read, and the
    ; association of the object with the site is given an action, made by the application's
    ; `action`, with those trackers, that runs the function of `given-functions` with what it keeps:
    ; the object, the block of the gate in force, or none, the layer, the order, and the receiver
    ; where the values the site applies are written. Answers the association.
    (let code ([] (. tables given-functions) place))
    (let layout ([] (. tables given-layouts) place))
    (if (or (== code no-function) (== (. styling action) no-instance))
      (call refuse .refused-statement (. row site))
      (return association)
    )
    (let trackers (call open-trackers (. row site)))
    (+= live-actions (call LiveTrackers trackers trackers))
    (let bound (. rule-names length))
    (call bind-live-values (. styling live) made site-self site-deferred)
    (match? ([] (. tree nodes) (. row site))
      (case (call .node-assign line)
        (do
          (inline (call convert (. row site) .reason-assignment (call emit-expression (. line rhs))))
        )
      )
    )
    (while (> (. rule-names length) bound)
      (call (. rule-names pop))
    )
    (call (. live-actions pop))
    (let block (call integer .machine-i64 (. U64 max)))
    (if gated
      (= block (call load-local (. ([] site-gates (. styling gate)) block) (. row site)))
    )
    (let mark (. pending length))
    (+= pending (call integer .machine-u64 (. ([] (. tables layouts rows) layout) size)))
    (+= pending (call make-operand .operand-descriptor layout))
    (let kept (call (. ir add-local) managed-layout))
    (call store-local kept (call call-runtime .runtime-allocate-object (. row site) mark managed-layout) (. row site))
    (call store (call load-local kept (. row site)) (. (call (. tables layouts field) layout 0) offset) made true (. row site))
    (call store (call load-local kept (. row site)) (. (call (. tables layouts field) layout 1) offset) block false (. row site))
    (call store
      (block
        (arg (call load-local kept (. row site)))
        (arg (. (call (. tables layouts field) layout 2) offset))
        (arg (call integer .machine-u32 layer))
        (arg false)
        (arg (. row site))
      )
    )
    (call store
      (block
        (arg (call load-local kept (. row site)))
        (arg (. (call (. tables layouts field) layout 3) offset))
        (arg (call order-value (. row site) order))
        (arg false)
        (arg (. row site))
      )
    )
    (call store (call load-local kept (. row site)) (. (call (. tables layouts field) layout 4) offset) site-self true (. row site))
    (call keep-given-row-items place (call load-local kept (. row site)) (. row site))
    (let callback (call make-callback (call (. tables live-adapter-of) code) (call load-local kept (. row site)) (. row site)))
    (= mark (. pending length))
    (+= pending made)
    (+= pending (call load-local trackers (. row site)))
    (+= pending callback)
    (let action (call call-instance (. styling action) (. row site) mark))
    (let associated association)
    (if (== (call operand-kind associated) .operand-void)
      (= associated (call associate-style-site (. row site) made type number))
    )
    (= mark (. pending length))
    (+= pending associated)
    (+= pending (. action operand))
    (do
      (inline (call call-instance (. facts style-runtime dynamic) (. row site) mark))
    )
    (return associated)
  )
  (fn-do _ keep-given-row-items _
    (param place U32)
    (param kept Operand)
    (param site SyntaxId)
    (let own-unit unit)
    (let field U32 5)
    (let layout ([] (. tables given-layouts) place))
    (for (in item (call (. tables given-row-items) ([] (. tables given-applications) place)))
      (= unit (= (. unit reading) (. item instance)))
      (= unit (= (. unit source-module) (. ([] (. instances rows) (. unit reading)) module)))
      (match? ([] (. tree nodes) (. item site))
        (case (call .node-identifier named)
          (let value (call emit-identifier (. item site) (. named name) (. item held)))
          (call store kept (. (call (. tables layouts field) layout field) offset) (. value operand) true site)
        )
      )
      (+= field 1)
    )
    (= unit own-unit)
  )
  (fn-do _ bind-given-row-items _
    (param place U32)
    (param kept Operand)
    (param site SyntaxId)
    (let field U32 5)
    (let layout ([] (. tables given-layouts) place))
    (for (in item (call (. tables given-row-items) ([] (. tables given-applications) place)))
      (let binding (. ([] (. instances rows) (. item instance)) binding))
      (let slot (. (call (. bindings resolution-of) binding (. item site)) slot))
      (let local (call (. ir add-local) managed-layout))
      (call store-local
        (block
          (arg local)
          (arg (call load kept (. (call (. tables layouts field) layout field) offset) managed-layout site))
          (arg site)
        )
      )
      (+= rule-names (call RuleName slot local (. item held)))
      (+= field 1)
    )
  )
  (fn-do _ bind-live-values _
    (param index U32)
    (param made Operand)
    (param receiver Operand)
    (param deferred TypeId)
    ; Evaluates again the values given by the applications from the one a site applies out to the
    ; application `index` of `style-applications`, the outermost first, each where it is written, and
    ; binds them for the rules' reads of the names that take them, as `bind-rule-values` does: those
    ; the site gives on the receiver where they are written, read through the instance that types
    ; them, and those a rule gives on the object, read through the instance that types that rule.
    ; Values of the rules around a rule written in a rule, and a rule shared, have no shape here.
    (let chain (list U32))
    (let position index)
    (while true
      (+= chain position)
      (let held ([] (. facts style-applications) position))
      (if (or (!= (. held around-values) (. U32 max)) (. held shared))
        (call refuse .refused-statement (. held site))
        (return)
      )
      (if (== (. held outer) (. U32 max))
        (break)
      )
      (= position (. held outer))
    )
    (let own-unit unit)
    (let own-filling filling)
    (let step (. chain length))
    (while (!= step 0)
      (-= step 1)
      (let held ([] (. facts style-applications) ([] chain step)))
      (if (== (. held written) 0)
        (continue)
      )
      (if (== (. held outer) (. U32 max))
        (= unit (= (. unit source-module) (. held module)))
        (= unit (= (. unit reading) (. held instance)))
        (= unit (= (. unit self) receiver))
        (= unit (= (. unit self-type) (call (. tables given-receiver) ([] chain step))))
        (= unit (= (. unit running-rule) (!= (. unit reading) (. unit instance))))
        (= unit (= (. unit deferred-type) deferred))
        (else
          (let around (. ([] (. facts style-applications) (. held outer)) unit))
          (= unit (= (. unit source-module) (. ([] (. instances rows) around) module)))
          (= unit (= (. unit reading) around))
          (= unit (= (. unit self) made))
          (= unit (= (. unit self-type) (. ([] (. instances rows) around) self-type)))
          (= unit (= (. unit running-rule) true))
          (= unit (= (. unit deferred-type) no-type))
        )
      )
      (= unit (= (. unit has-self) true))
      (= filling (= (. filling count) 0))
      (call bind-rule-values (. held written) (. held unit) true (. held values))
    )
    (= unit own-unit)
    (= filling own-filling)
  )
  (fn-do + finish-styles _
    (param id SyntaxId)
    (param made Operand)
    (param type TypeId)
    (param association Operand)
    ; Makes the style site of a markup element ready once its properties are stored (see
    ; `finish-style-site`).
    (let site (call (. facts style-site-of) (. unit reading) (. unit source-module) id))
    (if site
      (call finish-style-site id made type association (. site number))
    )
  )
  (fn-do _ finish-style-site _
    (param at SyntaxId)
    (param made Operand)
    (param type TypeId)
    (param association Operand)
    (param number U32)
    ; Makes a style site ready for an object, associating the object with the site first where no
    ; declaration did, as the reference finishes a site.
    (if (== (call operand-kind association) .operand-void)
      (call associate-style-site at made type number)
    )
    (let recording (call recording-local number))
    (if (!= recording no-local)
      (let marking (call (. ir reserve-block)))
      (let joined (call (. ir reserve-block)))
      (call branch (call load-local recording at) marking joined)
      (call (. ir start-block) marking)
      (let site (. pending length))
      (+= pending (call site-value number))
      (do
        (inline (call call-instance (. facts style-runtime site-recorded) at site))
      )
      (call jump joined)
      (call (. ir start-block) joined)
    )
    (let subject (call style-subject at made type))
    (let mark (. pending length))
    (+= pending subject)
    (call call-instance (. facts style-runtime site-ready) at mark)
  )
  (fn-do _ associate-style-site Operand
    (param at SyntaxId)
    (param made Operand)
    (param type TypeId)
    (param number U32)
    ; The association of an object with a style site, made at `at`.
    (let subject (call style-subject at made type))
    (let mark (. pending length))
    (+= pending subject)
    (+= pending (call site-value number))
    (return (. (call call-instance (. facts style-runtime associate) at mark) operand))
  )
  (fn-do _ style-subject Operand
    (param site SyntaxId)
    (param value Operand)
    (param type TypeId)
    ; An object as the `Pointer` the style runtime takes it as, cast as the reference casts it:
    ; that of an interface is the object it holds.
    (let layout (call layout-of type site))
    (if (== (call intrinsic type) .interface)
      (return (call num-cast site (call load value 0 managed-layout site) managed-layout pointer-layout))
    )
    (if (not (call is-pointer layout))
      (call refuse .refused-type site)
      (return value)
    )
    (return (call num-cast site value layout pointer-layout))
  )
  (fn-do _ style-number U32
    (param site SyntaxId)
    (param style TypeId)
    ; The number of a style the program registers. One the program does not register, where only a
    ; function it does not reach was seen to use it, has no shape here.
    (let number U32)
    (while (and (< number (. tables style-uses length)) (!= (. ([] (. tables style-uses) number) type) style))
      (+= number 1)
    )
    (if (and (< number (. tables style-uses length)) (not (. ([] (. tables style-uses) number) registered)))
      (call refuse .refused-function site)
    )
    (return number)
  )
  (fn-do + emit-style-assign _
    (param id SyntaxId)
    (param object SyntaxId)
    (param rhs SyntaxId)
    (param row StyleWrite)
    ; An assignment that declares a style for an object, as the reference's
    ; `compileImperativeStyleWrite` makes one: the value, converted as assigned, then the object,
    ; cast to the runtime's `Pointer`, with the record of the property's style, given to the
    ; runtime's declaration at the imperative layer, by a holder where the runtime holds a handle
    ; to the value (`author-value`). The object is `this` where none is written, the receiver of
    ; the function, or the object a value of its class is evaluated for.
    (if (and (== object 0) (not (. unit has-self)))
      (call refuse .refused-statement id)
      (return)
    )
    (let value (call convert id .reason-assignment (call emit-expression rhs)))
    (let subject (call own-subject))
    (if (!= object 0)
      (= subject (call emit-expression object))
    )
    (let pointer (call style-subject id (. subject operand) (. subject type)))
    (let runtime (. facts style-runtime))
    (let index (call style-number id (. row style)))
    (let property ([] (. facts style-properties) (. row property)))
    (let mark (. pending length))
    (+= pending (call integer .machine-u64 index))
    (let info (call call-instance (. runtime info-required) id mark))
    (let head (list Operand))
    (+= head pointer)
    (+= head (. info operand))
    (+= head (call integer .machine-u64 (- (. row property) (. ([] (. tables style-uses) index) first))))
    (if (call holds-style-handle (. property type))
      (call author-value
        (block
          (arg id)
          (arg (. property type))
          (arg (. value operand))
          (arg head)
          (arg (. runtime imperative))
          (arg (. runtime imperative-object))
        )
      )
      (return)
    )
    (let none (call none-flag id (. property type) (. value operand)))
    (let bits (call style-bits id (. property type) (. value operand)))
    (call call-bits id head bits (. none operand) (. runtime imperative))
  )
  (fn-do + emit-gate-test _
    (param condition SyntaxId)
    ; The function that tests again the condition a style rule written on a markup element is
    ; applied under, given the environment the element was written in, as the reference's gate
    ; evaluates it: the condition's value, with the trackers of the action that runs the gate
    ; noting what it reads.
    (let live (. instances live))
    (if (or (== (. live previous) no-instance) (== (. live next) no-instance))
      (call refuse .refused-function condition)
      (return)
    )
    (let previous (call (. ir add-local) managed-layout))
    (call store-local previous (. (call call-instance (. live previous) condition (. pending length)) operand) condition)
    (let next (call (. ir add-local) managed-layout))
    (call store-local next (. (call call-instance (. live next) condition (. pending length)) operand) condition)
    (+= live-actions (call LiveTrackers previous next))
    (let passed (call emit-expression condition))
    (call (. live-actions pop))
    (call return-value (. passed operand) condition)
  )
  (fn-do + emit-rule _
    (param declared SyntaxId)
    (param body SyntaxId)
    ; A rule a module declares, as the function a grammar calls: it is given the stream,
    ; as a `TokenStream` of its items, and the arguments written, then the address the stream's
    ; items start at, the cursor to start from and the count of items, as indexes, and the
    ; addresses where it keeps where it ended, how far it read and the farthest cursor a part of
    ; it failed at, which starts as the cursor it started from. Its arms are tried in turn from
    ; the cursor, as those of a local rule are, and the first that passes gives what it gave. It
    ; returns an optional of that, which holds nothing where no arm passed. One that raises
    ; returns that or an error raised in an action, and one made for a pattern that may raise,
    ; that or an error the pattern raised. One typed for the helper a pattern calls it
    ; under is given that helper after where it keeps the farthest cursor, and its pattern runs
    ; under it; one given its own helper as an argument runs under that. One whose pattern holds a
    ; rollback mark is then given where to keep the mark it holds as it passes. Its arms join as
    ; the type the optional it returns holds, which a rule that states its type states.
    (let signature ([] (. instances signatures) (. unit instance)))
    (let matched (call (. tree stream-statement) body))
    (let pattern SyntaxId 0)
    (match? ([] (. tree nodes) matched)
      (case (call .node-stream-match row)
        (= pattern (. row pattern))
      )
    )
    (let returned (. signature returns))
    (let result
      (scope (if-expr (and (!= pattern 0) (call (. types is-optional) returned)) returned-inner no-type)
        (lazy returned-inner (call (. types optional-inner) returned))
      )
    )
    (let buffer-type (call (. facts node-type) (. unit reading) declared))
    (if (or (== pattern 0) (== result no-type) (not (call (. types is-optional) returned)) unbuffered)
      (call refuse .refused-function declared)
      (return)
    )
    (lazy unbuffered (or (== buffer-type no-type) (== (. signature args count) 0)))
    (let stream-type (call (. instances argument-type) (. unit instance) 0))
    (call (. ir add-argument) (call layout-of stream-type declared))
    (for (in position (..< 1 (. signature args count)))
      (call (. ir add-argument) (call layout-of (call (. instances argument-type) (. unit instance) position) declared))
    )
    (let index-layout (call layout-of (. types index-type) declared))
    (let buffer-layout (call layout-of buffer-type declared))
    (call layout-of (call class-arg types buffer-type 0) declared)
    (= returns-type returned)
    (= (. ir returns) (call layout-of returned declared))
    (if (!= (. signature errors count) 0)
      (call return-results (. signature result) declared)
    )
    (if (!= carried-result no-type)
      (call return-results carried-result declared)
    )
    (if (or unstructured unpaired-buffer (not (call is-integer index-layout)))
      (call refuse .refused-type declared)
      (return)
    )
    (lazy unstructured (not (call (. tables layouts is-struct) buffer-layout)))
    (lazy unpaired-buffer (!= (. ([] (. tables layouts rows) buffer-layout) fields count) 2))
    (let first U32 (. ir arguments length))
    (call (. ir add-argument) pointer-layout)
    (call (. ir add-argument) index-layout)
    (call (. ir add-argument) index-layout)
    (call (. ir add-argument) pointer-layout)
    (call (. ir add-argument) pointer-layout)
    (call (. ir add-argument) pointer-layout)
    (let helped (. ([] (. instances rows) (. unit instance)) helper))
    (if (!= helped no-type)
      (call add-helper-argument helped declared)
      (else
        (call ambient-helper)
      )
    )
    (if (call carries (. unit instance))
      (call add-mark-argument)
    )
    (for (in name collector-args)
      (call (. ir add-argument) pointer-layout)
    )
    (call open-environment declared)
    (call bind-arguments declared)
    (= rule-arguments true)
    (let views (call (. facts call-in-role) (. unit reading) matched .role-view))
    (call match-direct
      (block
        (arg declared)
        (arg matched)
        (arg pattern)
        (arg result)
        (arg returned)
        (arg stream-type)
        (arg buffer-type)
        (arg first)
        (arg views)
        (arg (call (. facts call-in-role) (. unit reading) matched .role-extend))
        (arg matched)
        (arg (== (. function kind) .mapped-rule))
      )
    )
  )
  (fn-do + author-again _
    (param statement SyntaxId)
    (param rhs SyntaxId)
    (param row StyleDeclaration)
    ; A style declaration made again, as the reference's `style-` function makes it: its value,
    ; converted as where it is written, is declared by the style runtime for the object kept where
    ; the element was made, at the declaration's layer and order and in no block.
    (let slot (call channel-slot statement))
    (if (== slot no-slot)
      (call refuse .refused-statement statement)
      (return)
    )
    (let type (. (call find-captured slot statement) type))
    (let subject (call style-subject statement (. (call read-captured slot statement type) operand) type))
    (let value (call convert statement .reason-assignment (call emit-expression rhs)))
    (let runtime (. facts style-runtime))
    (let index (call style-number statement (. row style)))
    (let property ([] (. facts style-properties) (. row property)))
    (let mark (. pending length))
    (+= pending (call integer .machine-u64 index))
    (let info (call call-instance (. runtime info-required) statement mark))
    (let head (list Operand))
    (+= head subject)
    (+= head (. info operand))
    (+= head (call integer .machine-u64 (- (. row property) (. ([] (. tables style-uses) index) first))))
    (+= head (call integer .machine-u32 (. row layer)))
    (+= head (call integer .machine-u32 (. row order)))
    (+= head (call integer .machine-i64 (. U64 max)))
    (call author-again-value statement (. property type) (. value operand) head)
  )
  (fn-do _ author-again-value _
    (param site SyntaxId)
    (param type TypeId)
    (param value Operand)
    (param head (list Operand))
    ; Declares a value made again for an object, after what comes before it: by a holder where the
    ; runtime holds a handle to it (`author-value`), and otherwise its bits, flagged none where an
    ; optional holds nothing.
    (let runtime (. facts style-runtime))
    (if (call holds-style-handle type)
      (call author-value site type value head (. runtime author-dynamic) (. runtime author-object))
      (return)
    )
    (let none (call none-flag site type value))
    (let bits (call style-bits site type value))
    (call call-bits site head bits (. none operand) (. runtime author-dynamic))
  )
  (fn-do + apply-style-defaults _
    (param level TypeId)
    ; The style defaults of a class of the object a constructor has made, which its rule `• This`
    ; declares at the defaults layer, as the reference applies them once the class's rules have
    ; run: at a site of their own, which is then made ready, in the module that writes the rule;
    ; then the rules its root `<This` applies, which share one site, made ready after the last. A
    ; rule that declares no style has no site, and only sets the properties it names.
    (let association (call make-operand .operand-void 0))
    (let place (call (. tables first-application) (. unit instance)))
    (let began (. U32 max))
    (while (!= place (. U32 max))
      (let application ([] (. facts style-applications) place))
      (let next (call (. tables next-application) place))
      (if (call is-default application level)
        (let row (call (. facts style-site-of) (. unit instance) (. application module) (. application site)))
        (let number (if-expr row (. row number) (. U32 max)))
        (if (!= number began)
          (call begin-recording (. application site) (. application module) number)
          (= began number)
        )
        (= association (call apply-style-rule place number (. unit self) level association (. U32 max)))
        (if (not (call shares-default-site next application level))
          (let own-unit unit)
          (= unit (= (. unit source-module) (. application module)))
          (if row
            (call finish-style-site (. application site) (. unit self) level association number)
          )
          (= unit own-unit)
          (= association (call make-operand .operand-void 0))
          (= began (. U32 max))
        )
      )
      (= place next)
    )
  )
  (fn-do _ shares-default-site Bool
    (param place U32)
    (param application StyleApplication)
    (param level TypeId)
    ; Whether the next default of the class `level` this instance applies, from the place `place` of
    ; its applications on, is applied at the same site as `application`, and so shares its site.
    (while (!= place (. U32 max))
      (let later ([] (. facts style-applications) place))
      (if (call is-default later level)
        (return (and (== (. later module) (. application module)) (== (. later site) (. application site))))
      )
      (= place (call (. tables next-application) place))
    )
    (return false)
  )
  (fn-do + apply-class-rule _
    (param rule ClassRule)
    (param kept Operand)
    (param first Bool)
    ; Runs a rule of a class on the object its kept memory holds. A `when` rule tests its value
    ; and runs its body where the test holds. A `whenever` rule takes its value: the first
    ; time it keeps it, and after that, where it changed as `value-changed` tells, it keeps the
    ; new one and runs its body. One on the markup an object is in runs its body where the markup
    ; changed since it last ran (`apply-markup-trigger`).
    (let trigger (call (. facts markup-trigger-of) (. rule unit)))
    (if trigger
      (call apply-markup-trigger rule trigger kept)
      (return)
    )
    (match? ([] (. ([] (. program modules) (. rule module)) tree nodes) (. rule syntax))
      (case (call .node-when-rule-syntax when)
        (let tested (call test (. when expr) (call emit-expression (. when expr))))
        (let holds (call (. ir reserve-block)))
        (let done (call (. ir reserve-block)))
        (call branch (. tested operand) holds done)
        (call (. ir start-block) holds)
        (call emit-rule-body (. when body) done)
        (call jump done)
        (call (. ir start-block) done)
      )
      (case (call .node-whenever-rule-syntax whenever)
        (let field (call (. tables layouts field) (. rule kept) 1))
        (let latest (call emit-expression (. whenever expr)))
        (if first
          (call keep-rule-value kept field (. latest operand) (. whenever expr))
          (return)
        )
        (let tester (call (. facts change-test-of) (. rule unit)))
        (if (== tester no-instance)
          (call refuse .refused-statement (. whenever expr))
          (return)
        )
        (let prior
          (block
            (case? (call (. tables layouts is-struct) (. field layout))
              (call snapshot (call field-value kept field (. whenever expr)) (. field layout) (. whenever expr))
            )
            (default
              (call load kept (. field offset) (. field layout) (. whenever expr))
            )
          )
        )
        (let mark (. pending length))
        (+= pending prior)
        (+= pending (. latest operand))
        (let changed (call call-instance tester (. whenever expr) mark))
        (let fires (call (. ir reserve-block)))
        (let done (call (. ir reserve-block)))
        (call branch (. changed operand) fires done)
        (call (. ir start-block) fires)
        (call keep-rule-value kept field (. latest operand) (. whenever expr))
        (call emit-rule-body (. whenever body) done)
        (call jump done)
        (call (. ir start-block) done)
      )
    )
  )
  (fn-do _ emit-rule-body _
    (param body SyntaxId)
    (param done IRBlockId)
    ; Emits the body of a `when` or `whenever` rule of a class on a value, where a return leaves
    ; only the body and goes on at `done`.
    (let own-scoping scoping)
    (= scoping (= (. scoping rule-leaving) done))
    (= scoping (= (. scoping rule-cleanups) (as (. open-cleanups length) U32)))
    (call emit-block body)
    (= scoping own-scoping)
  )
  (fn-do _ apply-markup-trigger _
    (param rule ClassRule)
    (param trigger MarkupTrigger)
    (param kept Operand)
    ; Runs a `whenever` rule on the markup an object is in where the markup changed since it last
    ; ran: it notes that it has run, gives the changes it names to its body as a local, runs the
    ; body, and empties them.
    (let site (. rule syntax))
    (let dirty (call (. tables layouts field) (. rule kept) 1))
    (let changes (call (. tables layouts field) (. rule kept) 4))
    (let fires (call (. ir reserve-block)))
    (let done (call (. ir reserve-block)))
    (call branch (call load kept (. dirty offset) (. dirty layout) site) fires done)
    (call (. ir start-block) fires)
    (call store kept (. dirty offset) (call integer .machine-u8 0) false site)
    (match? ([] (. tree nodes) (. rule syntax))
      (case (call .node-whenever-rule-syntax whenever)
        (if (!= (. trigger changes) no-type)
          (call give-changes (. whenever args) (call load kept (. changes offset) managed-layout site) site)
        )
        (call emit-block (. whenever body))
      )
    )
    (if (!= (. trigger changes) no-type)
      (let mark (. pending length))
      (+= pending (call load kept (. changes offset) managed-layout site))
      (do
        (inline (call call-method (. trigger clear) site mark))
      )
    )
    (call jump done)
    (call (. ir start-block) done)
  )
  (fn-do _ give-changes _
    (param args (of RowRange SyntaxId))
    (param changes Operand)
    (param site SyntaxId)
    ; Gives the local the one argument of a `whenever` rule on the markup an object is in names
    ; the changes the rule keeps.
    (let name SyntaxId 0)
    (for (in arg ([] (. tree children) args))
      (match? ([] (. tree nodes) arg)
        (case (call .node-argument-decl row)
          (match? ([] (. tree nodes) (. row pattern))
            (case .node-identifier
              (= name (. row pattern))
            )
            (case (call .node-type-capture capture)
              (= name (. capture id))
            )
          )
        )
      )
    )
    (let slot (call local-slot name site true))
    (let offset (call slot-offset slot site))
    (let type (call (. facts slot-type) (. unit instance) offset))
    (if (call is-captured slot)
      (call keep-captured slot changes type site)
      (return)
    )
    (let local (call (. ir add-local) managed-layout))
    (= ([] (. unit cells) offset) local)
    (call store-local local changes site)
  )
  (fn-do + keep-rule-value _
    (param kept Operand)
    (param field LayoutField)
    (param value Operand)
    (param site SyntaxId)
    ; Keeps the value of a `whenever` rule in what it keeps for an object: a managed pointer
    ; through the write barrier, and a struct by a copy.
    (if (call (. tables layouts is-struct) (. field layout))
      (call store-struct kept field value site)
      (else-if (!= (. field layout) void-layout)
        (call store kept (. field offset) value (call is-managed-pointer (. field layout)) site)
      )
    )
  )
  (fn-do + emit-style-gate _
    ; The function the action that gates a block of style declarations runs, given what it keeps,
    ; as the reference's `style-gate` function does: the conditions of its row of `style-gates`
    ; are evaluated again on the object, the state cells and the environments kept, with the
    ; trackers of the action that runs it noting what they read, and the block is enabled where
    ; they hold and disabled where they do not; the record of generated content kept so, for a row
    ; that gates content, as the reference's `style-content` function enables it, which answers as
    ; the callback's type does: an error enabling it raises leaves with the answer.
    (let gate ([] (. facts style-gates) (. function place)))
    (let layout ([] (. tables gate-layouts) (. function place)))
    (let live (. instances live))
    (let place ([] (. facts style-gate-whens) (- (+ (. gate first) (. gate count)) 1)))
    (= unit (= (. unit source-module) (. place module)))
    (let site (. place syntax))
    (if (or (== (. live previous) no-instance) (== (. live next) no-instance))
      (call refuse .refused-function site)
      (return)
    )
    (call (. ir add-argument) managed-layout)
    (= returns-type (. types void-type))
    (= (. ir returns) void-layout)
    (if (. gate content)
      (call return-results (. live callback-result) site)
    )
    (let kept (call make-operand .operand-argument 0))
    (let object (call load kept (. (call (. tables layouts field) layout 0) offset) managed-layout site))
    (let previous (call (. ir add-local) managed-layout))
    (call store-local previous (. (call call-instance (. live previous) site (. pending length)) operand) site)
    (let next (call (. ir add-local) managed-layout))
    (call store-local next (. (call call-instance (. live next) site (. pending length)) operand) site)
    (+= live-actions (call LiveTrackers previous next))
    (let whens (list StyleWhen))
    (let cells (list Operand))
    (for (in position (..< 0 (. gate count)))
      (let held ([] (. facts style-gate-whens) (+ (. gate first) position)))
      (+= whens held)
      (if (or (!= (. held cell) (. U32 max)) (!= (. held test) no-instance))
        (+= cells
          (call load
            (block
              (arg kept)
              (arg (. (call (. tables layouts field) layout (+ (as (. cells length) U32) 2)) offset))
              (arg managed-layout)
              (arg site)
            )
          )
        )
      )
    )
    (let enabled (call gate-conditions whens object (. gate type) cells false))
    (call (. live-actions pop))
    (let mark (. pending length))
    (if (. gate content)
      (+= pending (call load kept (. (call (. tables layouts field) layout 1) offset) managed-layout site))
      (+= pending enabled)
      (do
        (inline (call raising-call site (. facts style-runtime content-enabled) mark))
      )
      (else
        (+= pending (call num-cast site object managed-layout pointer-layout))
        (+= pending (call load kept (. (call (. tables layouts field) layout 1) offset) i64-layout site))
        (+= pending enabled)
        (do
          (inline (call call-instance (. facts style-runtime block-enabled) site mark))
        )
      )
    )
    (call return-value (call make-operand .operand-void 0) site)
  )
  (fn-do + emit-style-author _
    ; The function the action of a declaration of a style rule whose value read something tracked
    ; runs, given what it keeps, as the reference's `style-` function does: the value is evaluated
    ; again on the object, read through the instance that types the rule, with the trackers of the
    ; action that runs it noting what it reads, and declared by the style runtime for the object at
    ; the layer, the order and in the block kept, as `author-again-value` says.
    (let author ([] (. facts style-authors) (. function place)))
    (let layout ([] (. tables author-layouts) (. function place)))
    (let row (call (. facts style-declaration-of) (. author instance) (. author site)))
    (let live (. instances live))
    (let site (. author site))
    (= unit (= (. unit source-module) (. ([] (. instances rows) (. author instance)) module)))
    (if (or (not row) (== (. live previous) no-instance) (== (. live next) no-instance))
      (call refuse .refused-function site)
      (return)
    )
    (call (. ir add-argument) managed-layout)
    (= returns-type (. types void-type))
    (= (. ir returns) void-layout)
    (let kept (call make-operand .operand-argument 0))
    (= unit (= (. unit reading) (. author instance)))
    (= unit (= (. unit self-type) (. ([] (. instances rows) (. author instance)) self-type)))
    (= unit (= (. unit self) (call load kept (. (call (. tables layouts field) layout 0) offset) managed-layout site)))
    (= unit (= (. unit has-self) true))
    (= unit (= (. unit running-rule) true))
    (let previous (call (. ir add-local) managed-layout))
    (call store-local previous (. (call call-instance (. live previous) site (. pending length)) operand) site)
    (let next (call (. ir add-local) managed-layout))
    (call store-local next (. (call call-instance (. live next) site (. pending length)) operand) site)
    (+= live-actions (call LiveTrackers previous next))
    (let value (call make-operand .operand-void 0))
    (match? ([] (. tree nodes) site)
      (case (call .node-assign line)
        (= value (. (call convert site .reason-assignment (call emit-expression (. line rhs))) operand))
      )
    )
    (call (. live-actions pop))
    (let runtime (. facts style-runtime))
    (let index (call style-number site (. row style)))
    (let property ([] (. facts style-properties) (. row property)))
    (let mark (. pending length))
    (+= pending (call integer .machine-u64 index))
    (let info (call call-instance (. runtime info-required) site mark))
    (let head (list Operand))
    (+= head (call num-cast site (. unit self) managed-layout pointer-layout))
    (+= head (. info operand))
    (+= head (call integer .machine-u64 (- (. row property) (. ([] (. tables style-uses) index) first))))
    (+= head (call load kept (. (call (. tables layouts field) layout 2) offset) u32-layout site))
    (+= head (call load kept (. (call (. tables layouts field) layout 3) offset) u32-layout site))
    (+= head (call load kept (. (call (. tables layouts field) layout 1) offset) i64-layout site))
    (call author-again-value site (. property type) value head)
    (call return-value (call make-operand .operand-void 0) site)
  )
  (fn-do + emit-given-author _
    ; The function the action of a line of a style rule whose value reads values an application with
    ; `live-values` gives runs, given what it keeps, as `emit-style-author` runs one whose own value
    ; reads something tracked: the values are evaluated again where they are written
    ; (`bind-live-values`) and the line's value on the object, read through the instance that types
    ; the rule, with the trackers of the action that runs it noting what they read. A declaration's
    ; value is declared by the style runtime for the object at the layer, the order and in the block
    ; kept, as `author-again-value` says, and one that sets a property is stored in it.
    (let index ([] (. tables given-applications) (. function place)))
    (let layout ([] (. tables given-layouts) (. function place)))
    (let site ([] (. tables given-sites) (. function place)))
    (let unit-id (. ([] (. facts style-applications) index) unit))
    (let row (call (. facts style-declaration-of) unit-id site))
    (let update (call (. facts rule-update-of) unit-id site))
    (let live (. instances live))
    (= unit (= (. unit source-module) (. ([] (. instances rows) unit-id) module)))
    (if (or (and (not row) (not update)) (== (. live previous) no-instance) (== (. live next) no-instance))
      (call refuse .refused-function site)
      (return)
    )
    (call (. ir add-argument) managed-layout)
    (= returns-type (. types void-type))
    (= (. ir returns) void-layout)
    (let kept (call make-operand .operand-argument 0))
    (= unit (= (. unit reading) unit-id))
    (= unit (= (. unit self-type) (. ([] (. instances rows) unit-id) self-type)))
    (= unit (= (. unit self) (call load kept (. (call (. tables layouts field) layout 0) offset) managed-layout site)))
    (= unit (= (. unit has-self) true))
    (= unit (= (. unit running-rule) true))
    (let receiver (call load kept (. (call (. tables layouts field) layout 4) offset) managed-layout site))
    (let previous (call (. ir add-local) managed-layout))
    (call store-local previous (. (call call-instance (. live previous) site (. pending length)) operand) site)
    (let next (call (. ir add-local) managed-layout))
    (call store-local next (. (call call-instance (. live next) site (. pending length)) operand) site)
    (+= live-actions (call LiveTrackers previous next))
    (call bind-given-row-items (. function place) kept site)
    (call bind-live-values index (. unit self) receiver no-type)
    (let value (call Typed (call make-operand .operand-void 0) no-type))
    (match? ([] (. tree nodes) site)
      (case (call .node-assign line)
        (= value (call convert site .reason-assignment (call emit-expression (. line rhs))))
      )
    )
    (call (. live-actions pop))
    (if (not row)
      (call store-argument (. unit self) (. unit self-type) (. (!! update) property) (. value operand) (. value type) site)
      (call return-value (call make-operand .operand-void 0) site)
      (return)
    )
    (let runtime (. facts style-runtime))
    (let number (call style-number site (. row style)))
    (let property ([] (. facts style-properties) (. row property)))
    (let mark (. pending length))
    (+= pending (call integer .machine-u64 number))
    (let info (call call-instance (. runtime info-required) site mark))
    (let head (list Operand))
    (+= head (call num-cast site (. unit self) managed-layout pointer-layout))
    (+= head (. info operand))
    (+= head (call integer .machine-u64 (- (. row property) (. ([] (. tables style-uses) number) first))))
    (+= head (call load kept (. (call (. tables layouts field) layout 2) offset) u32-layout site))
    (+= head (call load kept (. (call (. tables layouts field) layout 3) offset) u32-layout site))
    (+= head (call load kept (. (call (. tables layouts field) layout 1) offset) i64-layout site))
    (call author-again-value site (. property type) (. value operand) head)
    (call return-value (call make-operand .operand-void 0) site)
  )
  (fn-do + register-styles SyntaxId
    (param placed SyntaxId)
    ; Registers, at the head of a module's init as the reference does, the domains of invalidation
    ; the program numbers where the module is the style runtime's, in the order of their places
    ; (`Facts.domain-order`), and the styles the module declares, each where the reference places it,
    ; in the file of the module that holds the place: the call of the module's main is then placed
    ; where the last was. Where the init also puts sections in the event runtime's tables at its head,
    ; it is placed at the later in the file of the last registration and the constructor `placed`
    ; names, as the reference places it at the last it compiled, in source order here; one where those
    ; are in two files has no shape where the init calls the main, which a stack trace through it then
    ; names.
    (let site placed)
    (let events (!= (call (. tables init-constructor) (. function module)) no-instance))
    (= placing true)
    (if (== (. function module) (call (. tables style-module)))
      (for (in index (. facts domain-order))
        (let domain ([] (. facts domain-places) index))
        (= unit (= (. unit source-module) (. domain module)))
        (let mark (. pending length))
        (+= pending
          (call make-operand
            (block
              (arg .operand-constant)
              (arg (call (. ir add-string) (. ([] (. facts style-domains) index) name text)))
            )
          )
        )
        (+= pending (call integer .machine-u64 (call (. tables domain-number) index)))
        (call call-instance (. facts style-runtime register-domain) (. domain site) mark)
        (= site (. domain site))
      )
    )
    (for (in id (call (. tables style-registrations) (. function module)))
      (let use ([] (. tables style-uses) (. ([] (. tables functions) id) place)))
      (= unit (= (. unit source-module) (. use module)))
      (call call-function id (. use site))
      (= site (. use site))
    )
    (for (in id (call (. tables sheet-registrations) (. function module)))
      (let use ([] (. tables style-sheet-uses) (. ([] (. tables functions) id) place)))
      (= unit (= (. unit source-module) (. use module)))
      (call call-function id (. use site))
      (= site (. use site))
    )
    (if (or (not events) (== site placed) (== (. function calls start) (. function calls end)))
      (return site)
    )
    (if (or (== placed 0) (!= (. unit source-module) (. function module)))
      (call refuse .refused-function site)
      (return site)
    )
    (let last (. ([] (. tree nodes) site) loc begin))
    (let made (. ([] (. tree nodes) placed) loc begin))
    (if (or (> (. made line) (. last line)) (and (== (. made line) (. last line)) (> (. made column) (. last column))))
      (return placed)
    )
    (return site)
  )
  (fn-do + style-bits Operand
    (param site SyntaxId)
    (param type TypeId)
    (param value Operand)
    ; The bits of a style slot a value of a style property's type is: a number's own, cast; an
    ; object's number as the runtime interns it; a union's case number below the bits of what the
    ; case holds; and any other value's box, interned. An optional that holds nothing is no bits,
    ; and an object is interned as the optional it is.
    (if (not (call (. types is-optional) type))
      (return (call held-style-bits site type value))
    )
    (let inner (call (. types optional-inner) type))
    (if (== (call intrinsic inner) .class)
      (return (call intern-style-object site inner value true))
    )
    (let present-flag (call present site (call Typed value type)))
    (let cell (call (. ir add-local) i64-layout))
    (call store-local cell (call integer .machine-i64 0) site)
    (let holding (call (. ir reserve-block)))
    (let joined (call (. ir reserve-block)))
    (call branch (. present-flag operand) holding joined)
    (call (. ir start-block) holding)
    (let inside (call payload site (call Typed value type)))
    (call store-local cell (call held-style-bits site inner (. inside operand)) site)
    (call jump joined)
    (call (. ir start-block) joined)
    (return (call load-local cell site))
  )
  (fn-do _ held-style-bits Operand
    (param site SyntaxId)
    (param type TypeId)
    (param value Operand)
    ; The bits of a style slot that a value of a type other than an optional is.
    (let kind (call intrinsic type))
    (if (== kind .class)
      (return (call intern-style-object site type value false))
    )
    (if (== kind .union)
      (return (call union-style-bits site type value))
    )
    (if (call boxed-style kind)
      (return (call boxed-style-bits site type value))
    )
    (let layout (call layout-of type site))
    (if (or (== layout f32-layout) (== layout f64-layout))
      (let wide (call num-cast site value layout f64-layout))
      (let cell (call frame f64-layout))
      (call store cell 0 wide false site)
      (return (call load cell 0 i64-layout site))
    )
    (if (not (call is-number layout))
      (call refuse .refused-type site)
      (return value)
    )
    (return (call num-cast site value layout i64-layout))
  )
  (fn-do _ union-style-bits Operand
    (param site SyntaxId)
    (param type TypeId)
    (param value Operand)
    ; The bits of a style slot a union is: the number of the case it holds, below the bits of
    ; what the case holds, a whole number of at most 32 bits its own, an object interned, and any
    ; other value boxed and interned; none where it holds no case it has.
    (let layout (call layout-of type site))
    (let cell (call (. ir add-local) i64-layout))
    (call store-local cell (call integer .machine-i64 0) site)
    (let joined (call (. ir reserve-block)))
    (let cases (call (. types cases-of) type))
    (for (in index (..< 0 (. cases length)))
      (let case-type (. ([] cases index) type))
      (let holding (call (. ir reserve-block)))
      (let next (call (. ir reserve-block)))
      (call branch (call case-test site value (as index U32)) holding next)
      (call (. ir start-block) holding)
      (let field (call (. tables layouts case-field) layout (as index U32)))
      (let held (call take value field site))
      (let kind (call intrinsic case-type))
      (let bits held)
      (if (and (call is-integer-kind kind) (> (. ([] (. types completions) case-type) bit-size) 0) small-bits)
        (= bits (call num-cast site held (. field layout) i64-layout))
        (else-if (== kind .class)
          (= bits (call intern-style-object site case-type held false))
        )
        (else
          (= bits (call boxed-style-bits site case-type held))
        )
      )
      (lazy small-bits (<= (. ([] (. types completions) case-type) bit-size) 32))
      (let shifted (call bitwise site .bitwise-shift-left bits (call integer .machine-i64 8) i64-layout))
      (call store-local
        (block
          (arg cell)
          (arg (call bitwise site .bitwise-or shifted (call integer .machine-i64 (as index U64)) i64-layout))
          (arg site)
        )
      )
      (call jump joined)
      (call (. ir start-block) next)
    )
    (call jump joined)
    (call (. ir start-block) joined)
    (return (call load-local cell site))
  )
  (fn-do _ intern-style-object Operand
    (param site SyntaxId)
    (param type TypeId)
    (param value Operand)
    (param optional Bool)
    ; The number the style runtime interns an object as, which it takes as the optional of its
    ; class: a value given as the class is wrapped in it.
    (for (in coding (. facts style-codings))
      (if (and (== (. coding type) type) (!= (. coding intern) no-instance))
        (let taken value)
        (if (not optional)
          (= taken (. (call wrap site (call Typed value type) (. coding taken)) operand))
        )
        (let mark (. pending length))
        (+= pending taken)
        (return (. (call call-instance (. coding intern) site mark) operand))
      )
    )
    (call refuse .refused-function site)
    (return value)
  )
  (fn-do _ boxed-style-bits Operand
    (param site SyntaxId)
    (param type TypeId)
    (param value Operand)
    ; The number the style runtime interns the box of a value as.
    (let optional (call wide-holder site type value))
    (let mark (. pending length))
    (+= pending (. optional operand))
    (return (. (call call-instance (. facts style-runtime intern-holder) site mark) operand))
  )
  (fn-do + emit-style-property Typed
    (param id SyntaxId)
    (let found (call (. facts style-read-of) (. unit reading) id))
    (if (or (not found) (not (. found is-reference)))
      (call refuse .refused-expression id)
      (return (call Typed (call make-operand .operand-void 0) no-type))
    )
    (let read found)
    (let number (call style-number id (. read style)))
    (let mark (. pending length))
    (+= pending (call integer .machine-u64 number))
    (+= pending (call integer .machine-u64 (- (. read property) (. ([] (. tables style-uses) number) first))))
    (if (!= (. read component) (. U32 max))
      (+= pending (call integer .machine-u64 (. read component)))
    )
    (return (call call-instance (. read reader) id mark))
  )
  (fn-do + emit-style-read Typed
    (param id SyntaxId)
    (param object SyntaxId)
    ; A read of a style property, `$name`: the subject, `this` where none is written, cast to the
    ; runtime's `Pointer`, given with the number of the property's style and the property's place
    ; in it to the runtime's reader, and the bits it answers taken as the property's type
    ; (`decode-style`). An optional's reader answers its bits with whether it holds nothing, and
    ; what it holds is taken from them where it holds something, or for a number or an object
    ; whatever it holds. A read of the flag of a domain gives the subject and the domain's number
    ; to the runtime's reader of the flag.
    (let nothing (call make-operand .operand-void 0))
    (let read (call (. facts style-read-of) (. unit reading) id))
    (let flag (call (. facts style-flag-of) (. unit reading) id))
    (if (or (and (not read) (not flag)) (and (== object 0) (not (. unit has-self))))
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (let subject (call own-subject))
    (if (!= object 0)
      (= subject (call emit-expression object))
    )
    (let pointer
      (block
        (case? (and read (. read hosted))
          (. subject operand)
        )
        (default
          (call style-subject id (. subject operand) (. subject type))
        )
      )
    )
    (if flag
      (let flagged (. pending length))
      (+= pending pointer)
      (+= pending (call integer .machine-u64 (call (. tables domain-number) (. flag domain))))
      (return (call call-instance (. flag call) id flagged))
    )
    (let read-type
      (scope (if-expr (!= (. (!! read) sheet) (. U32 max)) (. (!! read) type) property-type)
        (lazy property-type (. ([] (. facts style-properties) (. (!! read) property)) type))
      )
    )
    (let tracked
      (scope (and (!= (. (!! read) sheet) (. U32 max)) (!= (. live-actions length) 0) tracks-collection)
        (lazy tracks-collection (!= (. instances live track-collection) no-instance))
      )
    )
    (if tracked
      (let watched pointer)
      (if (. (!! read) hosted)
        (let held
          (block
            (case? (== (call intrinsic (. subject type)) .interface)
              (call load (. subject operand) 0 managed-layout id)
            )
            (default
              (. subject operand)
            )
          )
        )
        (= watched (call num-cast id held managed-layout pointer-layout))
      )
      (let tracking (. pending length))
      (+= pending (call load-local (. ([] live-actions (- (. live-actions length) 1)) previous) id))
      (+= pending (call load-local (. ([] live-actions (- (. live-actions length) 1)) next) id))
      (+= pending watched)
      (do
        (inline (call call-instance (. instances live track-collection) id tracking))
      )
    )
    (let mark (. pending length))
    (+= pending pointer)
    (if (!= (. (!! read) sheet) (. U32 max))
      (+= pending (call integer .machine-u64 (call (. tables sheet-number) (. (!! read) sheet))))
      (+= pending (call integer .machine-u64 (. (!! read) offset)))
      (+= pending (call integer .machine-u8 (if-expr tracked 1 0)))
      (else
        (let number (call style-number id (. (!! read) style)))
        (+= pending (call integer .machine-u64 number))
        (+= pending (call integer .machine-u64 (- (. (!! read) property) (. ([] (. tables style-uses) number) first))))
      )
    )
    (let answer (call call-instance (. (!! read) reader) id mark))
    (if (not (call (. types is-optional) read-type))
      (return (call decode-style id (. answer operand) read-type))
    )
    (let pair (call layout-of (. ([] (. instances signatures) (. (!! read) reader)) returns) id))
    (let bits (call load (. answer operand) (. (call (. tables layouts field) pair 0) offset) i64-layout id))
    (let none (call load (. answer operand) (. (call (. tables layouts field) pair 1) offset) u8-layout id))
    (let there (call compare id .compare-equal none (call integer .machine-u8 0)))
    (let inner (call (. types optional-inner) read-type))
    (let kind (call intrinsic inner))
    (let layout (call layout-of read-type id))
    (let cell (call (. ir add-local) layout))
    (let holding (call (. ir reserve-block)))
    (let empty (call (. ir reserve-block)))
    (let joined (call (. ir reserve-block)))
    (if (or (== kind .union) (call boxed-style kind))
      (call branch there holding empty)
      (call (. ir start-block) holding)
      (let held (call decode-style id bits inner))
      (call store-local cell (. (call wrap id held read-type) operand) id)
      (call jump joined)
      (else
        (let held (call decode-style id bits inner))
        (call branch there holding empty)
        (call (. ir start-block) holding)
        (call store-local cell (. (call wrap id (call Typed (. held operand) inner) read-type) operand) id)
        (call jump joined)
      )
    )
    (call (. ir start-block) empty)
    (call store-local cell (. (call empty-optional read-type layout) operand) id)
    (call jump joined)
    (call (. ir start-block) joined)
    (return (call Typed (call load-local cell id) read-type))
  )
  (fn-do _ decode-style Typed
    (param site SyntaxId)
    (param bits Operand)
    (param type TypeId)
    ; A value of a style property's type that is no optional taken from the bits of its slot, as the
    ; reference's `decodeStyleScalar` takes it: a number's own, a float's by the `F64` they are, an
    ; object as the runtime resolves its handle, a union as `decode-style-union` says, and any other
    ; value from the box the runtime resolves its handle to.
    (let kind (call intrinsic type))
    (if (== kind .class)
      (let pointer (call object-pointer site bits))
      (return (call Typed (call num-cast site (. pointer operand) pointer-layout managed-layout) type))
    )
    (if (== kind .union)
      (return (call decode-style-union site bits type))
    )
    (if (call boxed-style kind)
      (return (call unbox-style site bits type))
    )
    (let layout (call layout-of type site))
    (if (or (== layout f32-layout) (== layout f64-layout))
      (let cell (call frame i64-layout))
      (call store cell 0 bits false site)
      (return (call Typed (call num-cast site (call load cell 0 f64-layout site) f64-layout layout) type))
    )
    (if (not (call is-number layout))
      (call refuse .refused-type site)
      (return (call Typed bits no-type))
    )
    (return (call Typed (call num-cast site bits i64-layout layout) type))
  )
  (fn-do _ object-pointer Typed
    (param site SyntaxId)
    (param bits Operand)
    ; The pointer the style runtime resolves the bits of a handle to.
    (let mark (. pending length))
    (+= pending bits)
    (return (call call-instance (. facts style-runtime object-pointer) site mark))
  )
  (fn-do _ unbox-style Typed
    (param site SyntaxId)
    (param bits Operand)
    (param type TypeId)
    ; A value from the box the bits of its handle resolve to, as the reference's
    ; `decodeStyleWideValue` reads it.
    (for (in coding (. facts style-codings))
      (if (and (== (. coding type) type) (!= (. coding holder) no-instance))
        (let box (. ([] (. instances rows) (. coding holder)) self-type))
        (let object
          (call num-cast
            (block
              (arg site)
              (arg (. (call object-pointer site bits) operand))
              (arg pointer-layout)
              (arg managed-layout)
            )
          )
        )
        (let value (call load-property site object box (call (. program store-atom) "value") true))
        (return (call Typed (. value operand) type))
      )
    )
    (call refuse .refused-type site)
    (return (call Typed bits no-type))
  )
  (fn-do _ decode-style-union Typed
    (param site SyntaxId)
    (param bits Operand)
    (param type TypeId)
    ; A union taken from the bits of its slot, as the reference's `decodeStyleUnion` takes it: the
    ; number of its case below, and above, what the case holds, a whole number of at most 32 bits
    ; its own, an object or a box by its handle. Bits of no case it has give the union with nothing
    ; written.
    (let layout (call layout-of type site))
    (let result (call null-value type layout site))
    (let tag
      (call num-cast
        (block
          (arg site)
          (arg (call bitwise site .bitwise-and bits (call integer .machine-i64 255) i64-layout))
          (arg i64-layout)
          (arg u8-layout)
        )
      )
    )
    (let above (call bitwise site .bitwise-shift-right bits (call integer .machine-i64 8) i64-layout))
    (let cases (call (. types cases-of) type))
    (let joined (call (. ir reserve-block)))
    (for (in index (..< 0 (. cases length)))
      (let case-type (. ([] cases index) type))
      (let holding (call (. ir reserve-block)))
      (let next (call (. ir reserve-block)))
      (call branch (call compare site .compare-equal tag (call integer .machine-u8 (as index U64))) holding next)
      (call (. ir start-block) holding)
      (let field (call (. tables layouts case-field) layout (as index U32)))
      (let held above)
      (if (call inline-style-case case-type)
        (= held (call num-cast site above i64-layout (. field layout)))
        (else-if (== (call intrinsic case-type) .class)
          (= held (call num-cast site (. (call object-pointer site above) operand) pointer-layout managed-layout))
        )
        (else
          (= held (. (call unbox-style site above case-type) operand))
        )
      )
      (call store (. result operand) 0 (call integer .machine-u8 (as index U64)) false site)
      (call put (. result operand) field held site)
      (call jump joined)
      (call (. ir start-block) next)
    )
    (call jump joined)
    (call (. ir start-block) joined)
    (return (call Typed (. result operand) type))
  )
  (fn-do + emit-style-write _
    (param id SyntaxId)
    (param object SyntaxId)
    (param rhs SyntaxId)
    ; A write of the flag of a domain, as the reference writes it: the value, then the subject,
    ; `this` where none is written, cast to the runtime's `Pointer`, given with the domain's
    ; number and the value to the runtime's writer of the flag.
    (let flag (call (. facts style-flag-of) (. unit reading) id))
    (if (or (not flag) (and (== object 0) (not (. unit has-self))))
      (call refuse .refused-statement id)
      (return)
    )
    (let value (call emit-expression rhs))
    (let subject (call own-subject))
    (if (!= object 0)
      (= subject (call emit-expression object))
    )
    (let pointer (call style-subject id (. subject operand) (. subject type)))
    (let mark (. pending length))
    (+= pending pointer)
    (+= pending (call integer .machine-u64 (call (. tables domain-number) (. flag domain))))
    (+= pending (. value operand))
    (call call-instance (. flag call) id mark)
  )
)
