    =
match? program.modules[rule.module].tree.nodes[rule.syntax]
    | .node-when-rule-syntax(when)
        . tested = test(when.expr, emit-expression(when.expr))
        . holds = ir.reserve-block()
        . done = ir.reserve-block()
        branch(tested.operand, holds, done)
        ir.start-block(holds)
        emit-rule-body(when.body, done)
        jump(done)
        ir.start-block(done)
    | .node-whenever-rule-syntax(whenever)
