. slot = channel-slot(row.site)
if code == no-function || slot == no-slot || live.owned == no-instance
    refuse(.refused-statement, row.site)
    = association
. trackers = open-trackers(row.site)
live-actions += LiveTrackers(trackers, trackers)
match? tree.nodes[row.site]
    | .node-assign(attribute)
