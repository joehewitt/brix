    - type TypeId

` A value from the box the bits of its handle resolve to, as the reference's
` `decodeStyleWideValue` reads it.
for coding in facts.style-codings
    if coding.type == type && coding.holder != no-instance
        . box = instances.rows[coding.holder].self-type
        . object = num-cast(site, object-pointer(site, bits).operand, pointer-layout, managed-layout)
        . value = load-property(site, object, box, program.store-atom("value"), true)
        = Typed(value.operand, type)
refuse(.refused-type, site)
= Typed(bits, no-type)

────────────────────
_ do decode-style-union Typed
    - site SyntaxId
    - bits Operand
    - type TypeId

` A union taken from the bits of its slot, as the reference's `decodeStyleUnion` takes it: the
` number of its case below, and above, what the case holds, a whole number of at most 32 bits
` its own, an object or a box by its handle. Bits of no case it has give the union with nothing
` written.
. layout = layout-of(type, site)
. result = null-value(type, layout, site)
. tag = num-cast
    - site
    - bitwise(site, .bitwise-and, bits, integer(.machine-i64, 255), i64-layout)
    - i64-layout
    - u8-layout
. above = bitwise(site, .bitwise-shift-right, bits, integer(.machine-i64, 8), i64-layout)
. cases = types.cases-of(type)
. joined = ir.reserve-block()
for index in 0 .. < cases.length
    . case-type = cases[index].type
    . holding = ir.reserve-block()
    . next = ir.reserve-block()
    branch(compare(site, .compare-equal, tag, integer(.machine-u8, index as U64)), holding, next)
    ir.start-block(holding)
    . field = tables.layouts.case-field(layout, index as U32)
    . held = above
    if inline-style-case(case-type)
        held = num-cast(site, above, i64-layout, field.layout)
    else if intrinsic(case-type) == .class
        held = num-cast(site, object-pointer(site, above).operand, pointer-layout, managed-layout)
    else
        held = unbox-style(site, above, case-type).operand
    store(result.operand, 0, integer(.machine-u8, index as U64), false, site)
    put(result.operand, field, held, site)
    jump(joined)
    ir.start-block(next)
jump(joined)
ir.start-block(joined)
= Typed(result.operand, type)

────────────────────
+ do emit-style-write
    - id SyntaxId
    - object SyntaxId
    - rhs SyntaxId

` A write of the flag of a domain, as the reference writes it: the value, then the subject,
` `this` where none is written, cast to the runtime's `Pointer`, given with the domain's
` number and the value to the runtime's writer of the flag.
. flag = facts.style-flag-of(unit.reading, id)
if !flag || (object == 0 && !unit.has-self)
    refuse(.refused-statement, id)
    =
. value = emit-expression(rhs)
. subject = own-subject()
if object != 0
    subject = emit-expression(object)
. pointer = style-subject(id, subject.operand, subject.type)
. mark = pending.length
pending += pointer
pending += integer(.machine-u64, tables.domain-number(flag.domain))
pending += value.operand
call-instance(flag.call, id, mark)
