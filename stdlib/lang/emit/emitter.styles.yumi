= association

────────────────────
+ do emit-themed-value

. row = facts.style-themed-values[function.place]
. site = row.site
unit = unit.source-module = row.module
unit = unit.reading = row.instance
ir.add-argument(managed-layout)
ir.add-argument(managed-layout)
theme-record = make-operand(.operand-argument, 1)
. made-type = facts.style-runtime.themed-made
. layout = layout-of(made-type, site)
returns-type = made-type
ir.returns = layout
bind-themed-givens(row)
. value = make-operand(.operand-void, 0)
match? tree.nodes[site]
    | .node-assign(line)
        value = convert(site, .reason-assignment, emit-expression(line.rhs)).operand
. none = none-flag(site, row.type, value)
. bits = style-bits(site, row.type, value)
. made = frame(layout)
put(made, tables.layouts.field(layout, 0), bits, site)
put(made, tables.layouts.field(layout, 1), none.operand, site)
return-value(made, site)

────────────────────
_ do bind-themed-givens
    - row StyleThemedValue

` Keeps each value a style rule takes as a slot of a style sheet, which a line of the rule
` computes with, in a local read from the subtree's record, for the line's reads of the rule's
` value (`read-rule-value`).
for position in 0 .. < row.given-count
    . given = facts.themed-givens[row.given + position]
    . type = facts.sheet-slots[sheet-first + given.slot].type
        .. sheet-first = tables.style-sheet-uses[tables.sheet-number(row.sheet)].first
    . value = read-theme
        - row.site
        - ThemeRead(row.instance, row.module, row.site, row.sheet, given.slot)
    . layout = layout-of(type, row.site)
    . local = ir.add-local(layout, false)
    store-local(local, value.operand, row.site)
    rule-names += RuleName(given.param, local, type)

────────────────────
+ do read-theme Typed
    - id SyntaxId
    - read ThemeRead

. nothing = make-operand(.operand-void, 0)
if function.kind != .style-themed-value
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. runtime = facts.style-runtime
. use = tables.style-sheet-uses[tables.sheet-number(read.sheet)]
. type = facts.sheet-slots[use.first + read.slot].type
. mark = pending.length
pending += theme-record
pending += integer(.machine-u64, read.slot)
. bits = call-instance(runtime.themed-slot, id, mark)
if !types.is-optional(type)
    = decode-style(id, bits.operand, type)
mark = pending.length
pending += theme-record
pending += integer(.machine-u64, read.slot)
. none = call-instance(runtime.themed-none, id, mark)
. there = compare(id, .compare-equal, none.operand, integer(.machine-u8, 0))
. inner = types.optional-inner(type)
. layout = layout-of(type, id)
. cell = ir.add-local(layout)
. holding = ir.reserve-block()
. empty = ir.reserve-block()
. joined = ir.reserve-block()
branch(there, holding, empty)
ir.start-block(holding)
. held = decode-style(id, bits.operand, inner)
store-local(cell, wrap(id, held, type).operand, id)
jump(joined)
ir.start-block(empty)
store-local(cell, empty-optional(type, layout).operand, id)
jump(joined)
ir.start-block(joined)
= Typed(load-local(cell, id), type)

────────────────────
+ do emit-static-value

` The function that evaluates the value of a style declaration once for every making, which
` the style runtime calls through the function value it is given, as the reference's
` `style-static-value` does: the value, read through the instance that types the declaration
` and converted as where it is written, and the bits the runtime interns it as, packed with
` whether it holds nothing: twice one more than the bits, and one more again where it does.
. row = facts.style-static-values[function.place]
. site = row.site
unit = unit.source-module = row.module
unit = unit.reading = row.instance
ir.add-argument(managed-layout)
returns-type = types.type-row(.int64)
ir.returns = i64-layout
. value = make-operand(.operand-void, 0)
match? tree.nodes[site]
    | .node-assign(line)
        value = convert(site, .reason-assignment, emit-expression(line.rhs)).operand
. none = none-flag(site, row.type, value)
. bits = style-bits(site, row.type, value)
. more = arithmetic(site, .arithmetic-add, bits, integer(.machine-i64, 1), i64-layout)
. doubled = arithmetic(site, .arithmetic-add, more, more, i64-layout)
return-value
    - arithmetic
        - site
        - .arithmetic-add
        - doubled
        - num-cast(site, none.operand, u8-layout, i64-layout)
        - i64-layout
    - site

────────────────────
_ do declare-sheet-slot Operand
    - row StyleDeclaration
    - info Operand
    - layer U32
    - order U32
    - number U32
    - association Operand

` A declaration that takes its value from the slot of a style sheet, as the reference's
` `compileStyleDeclaration` makes one: the record of the sheet by its number, then the runtime's
` declaration of the slot for the site. The runtime reads the slot's value as it settles, and
` where the slot is of another type than the property makes the property's bits of the slot's as
` the projection says.
. associated = association
. runtime = facts.style-runtime
. mark = pending.length
pending += integer(.machine-u64, tables.sheet-number(row.sheet))
. sheet = call-instance(runtime.sheet-info-required, row.site, mark)
. use = tables.style-uses[style-number(row.site, row.style)]
mark = pending.length
pending += site-value(number)
pending += info
pending += integer(.machine-u64, row.property - use.first)
pending += integer(.machine-u32, layer)
pending += order-value(row.site, order)
pending += sheet.operand
pending += integer(.machine-u64, row.sheet-slot)
if row.projection == U32.max
    do call-instance(runtime.site-sheet, row.site, mark)
    = associated
. projection = facts.style-projections[row.projection]
pending += integer(.machine-u32, projection.kind)
pending += integer(.machine-i64, projection.tag)
pending += integer
    - .machine-u64
    - if projection.kind == 2 then tables.remap-number(row.projection) else 0u32
pending += integer(.machine-u8, if projection.preserves-none then 1 else 0u64)
. remap = layout-of(runtime.remap-tags, row.site)
if projection.kind == 2
    . wrapped = wrap
        - row.site
        - Typed(make-operand(.operand-symbol, tables.remap-symbol(row.projection)), types.optional-inner(runtime.remap-tags))
        - runtime.remap-tags
    pending += wrapped.operand
else
    pending += empty-optional(runtime.remap-tags, remap).operand
do call-instance(runtime.site-projected, row.site, mark)
= associated

────────────────────
_ do none-flag Typed
    - site SyntaxId
    - type TypeId
    - value Operand

` Whether a value of a style property's type is none: an optional that holds nothing.
if !types.is-optional(type)
    = Typed(integer(.machine-u8, 0), types.bool-type)
. there = present(site, Typed(value, type))
. none = compare(site, .compare-equal, there.operand, integer(.machine-u8, 0))
= Typed(none, types.bool-type)

────────────────────
_ do holds-style-handle Bool
    - type TypeId

` Whether the runtime holds a handle to a value of a style property's type, as the reference's
` `styleValueNeedsHolder` says: an object, a value boxed, or a union with a case that is no
` whole number of at most 32 bits.
. inner = if types.is-optional(type) then types.optional-inner(type) else type
. kind = intrinsic(inner)
if intrinsic-is-numeric(kind) && kind != .cpointer && kind != .number
    = false
if kind != .union
    = true
for item in types.cases-of(inner)
    if !inline-style-case(item.type)
        = true
= false

────────────────────
_ inline-style-case Bool
    - type TypeId

` Whether a case of a union style value is kept in the slot's bits above its number: a whole
` number of at most 32 bits.
is-integer-kind(intrinsic(type)) && size > 0 && size <= 32

.. size = types.completions[type].bit-size

────────────────────
_ do author-value
    - site SyntaxId
    - type TypeId
    - value Operand
    - head [Operand]
    - bits-call InstanceId
    - object-call InstanceId

` Declares a value the runtime holds a handle to, as the reference's `compileStyleHolderValue`
` does, by calls given what comes before the value: an object by a holder of its own, which an
` optional that holds nothing is too, flagged none; an optional of any other value that holds
` nothing as no bits, flagged none; and what it holds otherwise as `author-held` says.
. inner = if types.is-optional(type) then types.optional-inner(type) else type
. optional = types.is-optional(type)
if intrinsic(inner) == .class
    . none = none-flag(site, type, value)
    . holder = value-holder(site, inner, value, optional)
    call-held(site, head, none.operand, holder.operand, 0, 0, object-call)
    =
if !optional
    author-held(site, inner, value, head, bits-call, object-call)
    =
. there = present(site, Typed(value, type))
. holding = ir.reserve-block()
. empty = ir.reserve-block()
. joined = ir.reserve-block()
branch(there.operand, holding, empty)
ir.start-block(holding)
author-held(site, inner, payload(site, Typed(value, type)).operand, head, bits-call, object-call)
jump(joined)
ir.start-block(empty)
call-bits(site, head, integer(.machine-i64, 0), integer(.machine-u8, 1), bits-call)
jump(joined)
ir.start-block(joined)

────────────────────
_ do author-held
    - site SyntaxId
    - type TypeId
    - value Operand
    - head [Operand]
    - bits-call InstanceId
    - object-call InstanceId

` A value that is no optional and no object, declared by a holder: its box, or for a union the
` case it holds, a whole number of at most 32 bits as bits above the case's number, an object
` by a holder of its own and any other value by its box, framed by the case's number.
. no = integer(.machine-u8, 0)
if intrinsic(type) != .union
    . box = wide-holder(site, type, value)
    call-held(site, head, no, box.operand, 0, 0, object-call)
    =
. layout = layout-of(type, site)
. cases = types.cases-of(type)
. joined = ir.reserve-block()
for index in 0 .. < cases.length
    . case-type = cases[index].type
    . holding = ir.reserve-block()
    . next = ir.reserve-block()
    branch(case-test(site, value, index as U32), holding, next)
    ir.start-block(holding)
    . field = tables.layouts.case-field(layout, index as U32)
    . held = take(value, field, site)
    if inline-style-case(case-type)
        . bits = num-cast(site, held, field.layout, i64-layout)
        . shifted = bitwise(site, .bitwise-shift-left, bits, integer(.machine-i64, 8), i64-layout)
        call-bits
            - site
            - head
            - bitwise(site, .bitwise-or, shifted, integer(.machine-i64, index as U64), i64-layout)
            - no
            - bits-call
    else if intrinsic(case-type) == .class
        . holder = value-holder(site, case-type, held, false)
        call-held(site, head, no, holder.operand, 8, index as U32, object-call)
    else
        . box = wide-holder(site, case-type, held)
        call-held(site, head, no, box.operand, 8, index as U32, object-call)
    jump(joined)
    ir.start-block(next)
jump(joined)
ir.start-block(joined)

────────────────────
_ do call-bits
    - site SyntaxId
    - head [Operand]
    - bits Operand
    - none Operand
    - callee InstanceId

` Declares the bits of a value by the call given, after what comes before the value.
. mark = pending.length
for operand in head
    pending += operand
pending += bits
pending += none
do call-instance(callee, site, mark)

────────────────────
_ do call-held
    - site SyntaxId
    - head [Operand]
    - none Operand
    - holder Operand
    - shift U32
    - tag U32
    - callee InstanceId

` Declares a value by its holder by the call given, after what comes before the value: whether
` it is none, the holder, and the shift and number of the union case that frames it.
. mark = pending.length
for operand in head
    pending += operand
pending += none
pending += holder
pending += integer(.machine-u32, shift)
pending += integer(.machine-i64, tag)
do call-instance(callee, site, mark)

────────────────────
_ do value-holder Typed
    - site SyntaxId
    - type TypeId
    - value Operand
    - optional Bool

` The runtime's holder of an object a declaration holds, which takes it as the optional of its
` class, as the reference's `makeStyleObjectHolder` makes one: a value given as the class is
` wrapped in it. The holder is given as the optional of the holders' base.
for coding in facts.style-codings
    if coding.type == type && coding.value-holder != no-instance
        . taken = value
        if !optional
            taken = wrap(site, Typed(value, type), coding.taken).operand
        . mark = pending.length
        pending += taken
        . holder = call-instance(coding.value-holder, site, mark)
        . held = facts.style-runtime.held
        = wrap(site, Typed(holder.operand, types.optional-inner(held)), held)
refuse(.refused-function, site)
= Typed(value, no-type)

────────────────────
_ do wide-holder Typed
    - site SyntaxId
    - type TypeId
    - value Operand

` The runtime's box of a value of a type no number fits, as the reference's
` `makeStyleWideHolder` makes one, given as the optional of the holders' base.
for coding in facts.style-codings
    if coding.type == type && coding.holder != no-instance
        . mark = pending.length
        pending += value
        . box = call-instance(coding.holder, site, mark)
        . held = facts.style-runtime.held
        = wrap(site, Typed(box.operand, types.optional-inner(held)), held)
