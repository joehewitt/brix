. trackers = open-trackers(row.site)
live-actions += LiveTrackers(trackers, trackers)
match? tree.nodes[row.site]
    | .node-assign(line)
        do convert(row.site, .reason-assignment, emit-expression(line.rhs))
live-actions.pop()
. block = integer(.machine-i64, U64.max)
if gated
    block = load-local(site-gates[styling.gate].block, row.site)
. mark = pending.length
pending += integer(.machine-u64, tables.layouts.rows[layout].size)
pending += make-operand(.operand-descriptor, layout)
. kept = ir.add-local(managed-layout)
store-local(kept, call-runtime(.runtime-allocate-object, row.site, mark, managed-layout), row.site)
store(load-local(kept, row.site), tables.layouts.field(layout, 0).offset, made, true, row.site)
store(load-local(kept, row.site), tables.layouts.field(layout, 1).offset, block, false, row.site)
store
    - load-local(kept, row.site)
    - tables.layouts.field(layout, 2).offset
    - integer(.machine-u32, layer)
    - false
    - row.site
store
    - load-local(kept, row.site)
    - tables.layouts.field(layout, 3).offset
