. layout = tables.given-layouts[place]
if code == no-function || styling.action == no-instance
    refuse(.refused-statement, row.site)
    = association
. trackers = open-trackers(row.site)
live-actions += LiveTrackers(trackers, trackers)
. bound = rule-names.length
bind-live-values(styling.live, made, site-self, site-deferred)
match? tree.nodes[row.site]
    | .node-assign(line)
        do convert(row.site, .reason-assignment, emit-expression(line.rhs))
while rule-names.length > bound
