────────────────────
_ do keep-given-row-items
    - place U32
    - kept Operand
    - site SyntaxId

. own-unit = unit
. field U32 = 5
. layout = tables.given-layouts[place]
for item in tables.given-row-items(tables.given-applications[place])
    unit = unit.reading = item.instance
    unit = unit.source-module = instances.rows[unit.reading].module
    match? tree.nodes[item.site]
        | .node-identifier(named)
            . value = emit-identifier(item.site, named.name, item.held)
            store(kept, tables.layouts.field(layout, field).offset, value.operand, true, site)
    field += 1
unit = own-unit

────────────────────
_ do bind-given-row-items
    - place U32
    - kept Operand
    - site SyntaxId

. field U32 = 5
. layout = tables.given-layouts[place]
for item in tables.given-row-items(tables.given-applications[place])
    . binding = instances.rows[item.instance].binding
    . slot = bindings.resolution-of(binding, item.site).slot
    . local = ir.add-local(managed-layout)
    store-local(local, load(kept, tables.layouts.field(layout, field).offset, managed-layout, site), site)
    rule-names += RuleName(slot, local, item.held)
    field += 1

────────────────────
_ do bind-live-values
    - index U32
    - made Operand
    - receiver Operand
    - deferred TypeId

` Evaluates again the values given by the applications from the one a site applies out to the
` application `index` of `style-applications`, the outermost first, each where it is written, and
` binds them for the rules' reads of the names that take them, as `bind-rule-values` does: those
` the site gives on the receiver where they are written, read through the instance that types
` them, and those a rule gives on the object, read through the instance that types that rule.
` Values of the rules around a rule written in a rule, and a rule shared, have no shape here.
. chain [U32]
. position = index
while true
    chain += position
    . held = facts.style-applications[position]
    if held.around-values != U32.max || held.shared
        refuse(.refused-statement, held.site)
        =
    if held.outer == U32.max
        break
    position = held.outer
. own-unit = unit
. own-filling = filling
. step = chain.length
while step != 0
    step -= 1
    . held = facts.style-applications[chain[step]]
    if held.written == 0
        continue
    if held.outer == U32.max
        unit = unit.source-module = held.module
        unit = unit.reading = held.instance
        unit = unit.self = receiver
        unit = unit.self-type = tables.given-receiver(chain[step])
        unit = unit.running-rule = unit.reading != unit.instance
        unit = unit.deferred-type = deferred
    else
        . around = facts.style-applications[held.outer].unit
        unit = unit.source-module = instances.rows[around].module
        unit = unit.reading = around
        unit = unit.self = made
        unit = unit.self-type = instances.rows[around].self-type
        unit = unit.running-rule = true
        unit = unit.deferred-type = no-type
    unit = unit.has-self = true
    filling = filling.count = 0
    bind-rule-values(held.written, held.unit, true, held.values)
unit = own-unit
filling = own-filling

────────────────────
+ do finish-styles
    - id SyntaxId
    - made Operand
    - type TypeId
    - association Operand

` Makes the style site of a markup element ready once its properties are stored (see
` `finish-style-site`).
. site = facts.style-site-of(unit.reading, unit.source-module, id)
if site
    finish-style-site(id, made, type, association, site.number)

────────────────────
_ do finish-style-site
    - at SyntaxId
    - made Operand
    - type TypeId
    - association Operand
    - number U32

` Makes a style site ready for an object, associating the object with the site first where no
` declaration did, as the reference finishes a site.
if operand-kind(association) == .operand-void
    associate-style-site(at, made, type, number)
. recording = recording-local(number)
if recording != no-local
    . marking = ir.reserve-block()
    . joined = ir.reserve-block()
    branch(load-local(recording, at), marking, joined)
    ir.start-block(marking)
    . site = pending.length
    pending += site-value(number)
    do call-instance(facts.style-runtime.site-recorded, at, site)
    jump(joined)
    ir.start-block(joined)
. subject = style-subject(at, made, type)
. mark = pending.length
pending += subject
call-instance(facts.style-runtime.site-ready, at, mark)

────────────────────
_ do associate-style-site Operand
    - at SyntaxId
    - made Operand
    - type TypeId
    - number U32

` The association of an object with a style site, made at `at`.
. subject = style-subject(at, made, type)
. mark = pending.length
pending += subject
pending += site-value(number)
= call-instance(facts.style-runtime.associate, at, mark).operand

────────────────────
_ do style-subject Operand
    - site SyntaxId
    - value Operand
    - type TypeId

` An object as the `Pointer` the style runtime takes it as, cast as the reference casts it:
` that of an interface is the object it holds.
. layout = layout-of(type, site)
if intrinsic(type) == .interface
    = num-cast(site, load(value, 0, managed-layout, site), managed-layout, pointer-layout)
if !is-pointer(layout)
    refuse(.refused-type, site)
    = value
= num-cast(site, value, layout, pointer-layout)

────────────────────
_ do style-number U32
    - site SyntaxId
    - style TypeId

` The number of a style the program registers. One the program does not register, where only a
` function it does not reach was seen to use it, has no shape here.
. number U32
while number < tables.style-uses.length && tables.style-uses[number].type != style
    number += 1
if number < tables.style-uses.length && !tables.style-uses[number].registered
    refuse(.refused-function, site)
= number

────────────────────
+ do emit-style-assign
    - id SyntaxId
    - object SyntaxId
    - rhs SyntaxId
    - row StyleWrite

` An assignment that declares a style for an object, as the reference's
` `compileImperativeStyleWrite` makes one: the value, converted as assigned, then the object,
` cast to the runtime's `Pointer`, with the record of the property's style, given to the
` runtime's declaration at the imperative layer, by a holder where the runtime holds a handle
` to the value (`author-value`). The object is `this` where none is written, the receiver of
` the function, or the object a value of its class is evaluated for.
if object == 0 && !unit.has-self
    refuse(.refused-statement, id)
    =
. value = convert(id, .reason-assignment, emit-expression(rhs))
. subject = own-subject()
if object != 0
    subject = emit-expression(object)
. pointer = style-subject(id, subject.operand, subject.type)
. runtime = facts.style-runtime
. index = style-number(id, row.style)
. property = facts.style-properties[row.property]
. mark = pending.length
pending += integer(.machine-u64, index)
. info = call-instance(runtime.info-required, id, mark)
. head [Operand]
head += pointer
head += info.operand
head += integer(.machine-u64, row.property - tables.style-uses[index].first)
if holds-style-handle(property.type)
    author-value(id, property.type, value.operand, head, runtime.imperative, runtime.imperative-object)
    =
. none = none-flag(id, property.type, value.operand)
. bits = style-bits(id, property.type, value.operand)
call-bits(id, head, bits, none.operand, runtime.imperative)

────────────────────
+ do emit-gate-test
    - condition SyntaxId

` The function that tests again the condition a style rule written on a markup element is
` applied under, given the environment the element was written in, as the reference's gate
` evaluates it: the condition's value, with the trackers of the action that runs the gate
` noting what it reads.
. live = instances.live
if live.previous == no-instance || live.next == no-instance
    refuse(.refused-function, condition)
    =
. previous = ir.add-local(managed-layout)
store-local(previous, call-instance(live.previous, condition, pending.length).operand, condition)
. next = ir.add-local(managed-layout)
store-local(next, call-instance(live.next, condition, pending.length).operand, condition)
live-actions += LiveTrackers(previous, next)
. passed = emit-expression(condition)
live-actions.pop()
return-value(passed.operand, condition)

────────────────────
+ do emit-rule
    - declared SyntaxId
    - body SyntaxId

` A rule a module declares, as the function a grammar calls: it is given the stream,
` as a `TokenStream` of its items, and the arguments written, then the address the stream's
` items start at, the cursor to start from and the count of items, as indexes, and the
` addresses where it keeps where it ended, how far it read and the farthest cursor a part of
` it failed at, which starts as the cursor it started from. Its arms are tried in turn from
` the cursor, as those of a local rule are, and the first that passes gives what it gave. It
` returns an optional of that, which holds nothing where no arm passed. One that raises
` returns that or an error raised in an action, and one made for a pattern that may raise,
` that or an error the pattern raised. One typed for the helper a pattern calls it
` under is given that helper after where it keeps the farthest cursor, and its pattern runs
` under it; one given its own helper as an argument runs under that. One whose pattern holds a
` rollback mark is then given where to keep the mark it holds as it passes. Its arms join as
` the type the optional it returns holds, which a rule that states its type states.
. signature = instances.signatures[unit.instance]
. matched = tree.stream-statement(body)
. pattern SyntaxId = 0
match? tree.nodes[matched]
    | .node-stream-match(row)
        pattern = row.pattern
. returned = signature.returns
. result = if pattern != 0 && types.is-optional(returned) then returned-inner else no-type
    .. returned-inner = types.optional-inner(returned)
. buffer-type = facts.node-type(unit.reading, declared)
if pattern == 0 || result == no-type || !types.is-optional(returned) || unbuffered
    refuse(.refused-function, declared)
    =
.. unbuffered = buffer-type == no-type || signature.args.count == 0
. stream-type = instances.argument-type(unit.instance, 0)
ir.add-argument(layout-of(stream-type, declared))
for position in 1 .. < signature.args.count
    ir.add-argument(layout-of(instances.argument-type(unit.instance, position), declared))
. index-layout = layout-of(types.index-type, declared)
. buffer-layout = layout-of(buffer-type, declared)
layout-of(class-arg(types, buffer-type, 0), declared)
returns-type = returned
ir.returns = layout-of(returned, declared)
if signature.errors.count != 0
    return-results(signature.result, declared)
if carried-result != no-type
    return-results(carried-result, declared)
if unstructured || unpaired-buffer || !is-integer(index-layout)
    refuse(.refused-type, declared)
    =
.. unstructured = !tables.layouts.is-struct(buffer-layout)
.. unpaired-buffer = tables.layouts.rows[buffer-layout].fields.count != 2
. first U32 = ir.arguments.length
ir.add-argument(pointer-layout)
ir.add-argument(index-layout)
ir.add-argument(index-layout)
ir.add-argument(pointer-layout)
ir.add-argument(pointer-layout)
ir.add-argument(pointer-layout)
. helped = instances.rows[unit.instance].helper
if helped != no-type
    add-helper-argument(helped, declared)
else
    ambient-helper()
if carries(unit.instance)
    add-mark-argument()
for name in collector-args
    ir.add-argument(pointer-layout)
open-environment(declared)
bind-arguments(declared)
rule-arguments = true
. views = facts.first-call(unit.reading, matched)
match-direct
    - declared
    - matched
    - pattern
    - result
    - returned
    - stream-type
    - buffer-type
    - first
    - views
    - next-call(views)
    - matched
    - function.kind == .mapped-rule

────────────────────
+ do author-again
    - statement SyntaxId
    - rhs SyntaxId
    - row StyleDeclaration

` A style declaration made again, as the reference's `style-` function makes it: its value,
` converted as where it is written, is declared by the style runtime for the object kept where
` the element was made, at the declaration's layer and order and in no block.
. slot = channel-slot(statement)
if slot == no-slot
    refuse(.refused-statement, statement)
    =
. type = find-captured(slot, statement).type
. subject = style-subject(statement, read-captured(slot, statement, type).operand, type)
. value = convert(statement, .reason-assignment, emit-expression(rhs))
. runtime = facts.style-runtime
. index = style-number(statement, row.style)
. property = facts.style-properties[row.property]
. mark = pending.length
pending += integer(.machine-u64, index)
. info = call-instance(runtime.info-required, statement, mark)
. head [Operand]
head += subject
head += info.operand
head += integer(.machine-u64, row.property - tables.style-uses[index].first)
head += integer(.machine-u32, row.layer)
head += integer(.machine-u32, row.order)
head += integer(.machine-i64, U64.max)
author-again-value(statement, property.type, value.operand, head)

────────────────────
_ do author-again-value
    - site SyntaxId
    - type TypeId
    - value Operand
    - head [Operand]

` Declares a value made again for an object, after what comes before it: by a holder where the
` runtime holds a handle to it (`author-value`), and otherwise its bits, flagged none where an
` optional holds nothing.
. runtime = facts.style-runtime
if holds-style-handle(type)
    author-value(site, type, value, head, runtime.author-dynamic, runtime.author-object)
    =
. none = none-flag(site, type, value)
. bits = style-bits(site, type, value)
call-bits(site, head, bits, none.operand, runtime.author-dynamic)

────────────────────
+ do apply-style-defaults
    - level TypeId

` The style defaults of a class of the object a constructor has made, which its rule `• This`
` declares at the defaults layer, as the reference applies them once the class's rules have
` run: at a site of their own, which is then made ready, in the module that writes the rule;
` then the rules its root `<This` applies, which share one site, made ready after the last. A
` rule that declares no style has no site, and only sets the properties it names.
. association = make-operand(.operand-void, 0)
. place = tables.first-application(unit.instance)
. began = U32.max
while place != U32.max
    . application = facts.style-applications[place]
    . next = tables.next-application(place)
    if is-default(application, level)
        . row = facts.style-site-of(unit.instance, application.module, application.site)
        . number = if row then row.number else U32.max
        if number != began
            begin-recording(application.site, application.module, number)
            began = number
        association = apply-style-rule(place, number, unit.self, level, association, U32.max)
        if !shares-default-site(next, application, level)
            . own-unit = unit
            unit = unit.source-module = application.module
            if row
                finish-style-site(application.site, unit.self, level, association, number)
            unit = own-unit
            association = make-operand(.operand-void, 0)
            began = U32.max
