━━━━━━━━━━━━━━━━━━━━
_ Styles is facet of FunctionEmitter
    sees Assignments
    sees LiveActions
    sees StateMachines

_ style-order U32 = 0
_ site-param Operand? = null
_ order-param Operand? = null
_ shared-rule U32 = U32.max
_ theme-record Operand = 0
_ site-self Operand = 0
_ site-self-type TypeId = no-type
_ site-has-self Bool = false
_ site-deferred TypeId = no-type

────────────────────
+ do declare-styles Operand
    - id SyntaxId
    - made Operand
    - type TypeId

` The style declarations of a markup element, made after its object and before its
` properties are stored, as the reference makes them: those of the style rules it applies, in
` order, then its own, in the order written (see `declare-style`). Answers the association of
` the object with the element's site, or nothing where none was made. Rules that declare no
` style still set the properties they name, where the element has no site.
. nothing = make-operand(.operand-void, 0)
. site = facts.style-site-of(unit.reading, unit.source-module, id)
. number = if site then site.number else U32.max
begin-recording(id, unit.source-module, number)
. association = nothing
. own-styling = styling
styling = styling.gate = U32.max
. applied = tables.first-application(unit.reading)
while applied != U32.max
    . application = facts.style-applications[applied]
    if applied-here && application.outer == U32.max
        association = apply-style-rule(applied, number, made, type, association, U32.max)
    .. applied-here = application.module == unit.source-module && application.site == id
    applied = tables.next-application(applied)
styling = own-styling
if !site
    = nothing
. place = facts.first-style-declaration(unit.reading)
while place != U32.max
    . row = facts.style-declarations[place]
    if row.element == id
        association = declare-style(row, row.layer, row.order, site.number, made, type, association)
    place = facts.next-style-declaration(place)
= association

────────────────────
_ do apply-style-rule Operand
    - index U32
    - number U32
    - made Operand
    - type TypeId
    - association Operand
    - inherited U32

` A style rule applied to an object at a site, as the reference applies one, read through the
` instance that types the rule for the class that writes it, which is the receiver's class
` while it is: first the rules it applies after its name, recorded after it with it as their
` `outer`; then its lines but its `when`s, in the order written, each declaration at the
` application's layer and each property the rule sets stored in the object
` (`update-rule-property`); then each `when`, gated by its condition made under those the
` rule is applied under (`inherited`): the rules its body applies, then its declarations. A
` rule applied under conditions gates its lines by them. Gated declarations take the
` conditional layer at least, and a default's the gated defaults layer (see `enter-gate`).
` Orders count on from the application's first, where the site applies it. The values a
` written application gives the rule are converted first, where the element or the rule that
` applies it is (`bind-rule-values`). A
` `shared` rule is applied by calling the reference's function for it (`call-shared-rule`),
` except in that function (`emit-style-rule`). The application's `action` makes the action of each
` declaration whose value reads something tracked. Answers the association, as
` `declare-style` does. Where the application has `live-values`, each declaration that reads
` them is declared again as they change (`declare-given-style`). A rule applied under the state
` cell of a `when` is applied under the
` condition of the cell first (`cell-condition`). The content the rule's lines generate follows
` its declarations, and that of each `when` the `when`'s (`generate-content`). What a site
` applies is read in the module the site is written in, which may be another's than this
` instance's for the defaults of a class (`emit-defaults`). One the site applies under a
` condition written with it gates everything under that too (`applied-condition`).
. application = facts.style-applications[index]
. unit-id = application.unit
if application.outer == U32.max && shared-rule != index
    style-order = application.order
if application.shared && shared-rule != index
    = call-shared-rule(index, number, made, type, association)
. conditions = cell-condition(application.cell, application.outer-cells, inherited)
if application.outer == U32.max
    conditions = applied-condition(application, conditions)
    site-self = unit.self
    site-self-type = unit.self-type
    site-has-self = unit.has-self
    site-deferred = unit.deferred-type
. own-styling = styling
styling = styling.action = application.action
. opening = association
. bound = rule-names.length
. own-unit = unit
if application.outer == U32.max
    unit = unit.source-module = application.module
if application.written != 0
    bind-rule-values
        - application.written
        - unit-id
        - application.outer != U32.max || tree.nodes[application.site] is .node-slot-outlet
        - application.values
if application.around-values != U32.max
    bind-around-values(application.around-values, unit-id, application.site)
. own-filling = filling
unit = unit.source-module = instances.rows[unit-id].module
unit = unit.reading = unit-id
unit = unit.self-type = instances.rows[unit-id].self-type
unit = unit.self = made
unit = unit.has-self = true
filling = filling.count = 0
unit = unit.deferred-type = no-type
unit = unit.running-rule = true
. associated = apply-inner-rules(index, 0, number, made, type, opening, conditions)
. lines = tree.children[rule-lines(unit-id)]
. marked = marks-up(unit-id)
. lined = false
. written [SyntaxId]
for statement in lines
    written += statement
    if application.family != U32.max && tree.nodes[statement] is .node-markup
        refuse(.refused-statement, statement)
    if !is-when && !is-rule && !is-markup && !(marked && !tree.rule-part(statement))
        lined = true
    .. is-when = tree.nodes[statement] is .node-style-when
    .. is-rule = tree.nodes[statement] is .node-rule-syntax
    .. is-markup = tree.nodes[statement] is .node-markup
. gate = U32.max
if lined && conditions != U32.max
    gate = enter-gate(conditions, made, type, associated)
styling = styling.live = if application.live-values then index else U32.max
styling = styling.family-gated = application.family != U32.max
if styling.family-gated && lined && number != U32.max
    record-family(application, number, true)
for statement in lines
    if when-node || tree.nodes[statement] is .node-rule-syntax || markup-node
        continue
    .. when-node = tree.nodes[statement] is .node-style-when
    .. markup-node = tree.nodes[statement] is .node-markup
    if marked && !tree.rule-part(statement)
        continue
    . row = facts.bound-declaration(unit-id, statement, index)
    . update = facts.rule-update-of(unit-id, statement)
    if row && number != U32.max
        associated = declare-rule-style
            - row
            - application.layer
            - conditions != U32.max
            - number
            - made
            - type
            - associated
    else if update && conditions == U32.max && !styling.family-gated
        update-rule-property(update, made, application)
    else
        refuse(.refused-statement, statement)
if styling.family-gated && lined && number != U32.max
    record-family(application, number, false)
styling = styling.family-gated = own-styling.family-gated
leave-gate(gate, made, type, associated)
associated = generate-content(index, written, conditions, number, made, type, associated)
for statement in lines
    if !(tree.nodes[statement] is .node-style-when)
        continue
    . condition = style-conditions.length as U32
    style-conditions += StyleCondition(StyleWhen(unit.source-module, statement), conditions)
    . entered = enter-gate(condition, made, type, associated)
    associated = apply-inner-rules(index, statement, number, made, type, associated, condition)
    styling = styling.family-gated = application.family != U32.max
    if styling.family-gated && number != U32.max
        record-family(application, number, true)
    for line in tree.when-lines(statement)
        if styling.family-gated && tree.nodes[line] is .node-markup
            refuse(.refused-statement, line)
        if applies-rule || tree.nodes[line] is .node-rule-syntax || tree.nodes[line] is .node-markup
            continue
        .. applies-rule = tree.nodes[line] is .node-style-rule-application
        . row = facts.bound-declaration(unit-id, line, index)
        if row && number != U32.max
            associated = declare-rule-style
                - row
                - application.layer
                - true
                - number
                - made
                - type
                - associated
        else
            refuse(.refused-statement, line)
    if styling.family-gated && number != U32.max
        record-family(application, number, false)
    styling = styling.family-gated = own-styling.family-gated
    leave-gate(entered, made, type, associated)
    associated = generate-content
        - index
        - tree.when-lines(statement)
        - condition
        - number
        - made
        - type
        - associated
unit = own-unit
filling = own-filling
styling = own-styling
while rule-names.length > bound
    rule-names.pop()
= associated

────────────────────
_ do applied-condition U32
    - application StyleApplication
    - conditions U32

` The condition a style rule written after `•` on a markup element is applied under, made under
` those given, as the reference puts it after the state cells: tested where each gate it is part
` of is made, and again by the function written for it. Those given where it writes none.
match? program.modules[application.module].tree.nodes[application.written]
    | .node-style-rule-application(applied)
        if applied.condition != 0
            . live = tables.live-statement-of(application.instance, applied.condition)
            if !live
                refuse(.refused-statement, application.site)
                = conditions
            . next = style-conditions.length as U32
            style-conditions += StyleCondition(StyleWhen(application.module, applied.condition, U32.max, live.rerun), conditions)
            = next
= conditions

────────────────────
_ do marks-up Bool
    - unit-id InstanceId

` Whether the lines of the style rule an instance types that are not its own are the markup of
` the class that writes it, which its markup function runs: the rule is the class's `• This`,
` kept as its content (`defaults-content`).
. row = instances.rows[unit-id]
. owner = program.modules[row.module]
match? owner.decls[row.initializer]
    | .decl-style-rule(rule)
        match? owner.decls[rule.owner]
            | .decl-class(class)
                = class.content == rule.syntax
= false

────────────────────
_ do generate-content Operand
    - index U32
    - lines [SyntaxId]
    - conditions U32
    - number U32
    - made Operand
    - type TypeId
    - association Operand

` The content the lines given of a style rule applied at a site by the application `index`
` generate, in the order written, as the reference's `compileGuardedContent` makes it: the
` object made a `MarkupElement` once, the function of each line made a `MarkupSlotBuilder` of it, and
` the record of the line's content made for the association at the next order. Under conditions,
` the record is enabled as they hold (`enable-content`). A line the type pass generated nothing for
` is passed over. Answers the association, as `declare-style` does.
. associated = association
. target = make-operand(.operand-void, 0)
for line in lines
    if !(tree.nodes[line] is .node-markup)
        continue
    . found = content-of(index, line)
    if !found
        continue
    . row = found
    if number == U32.max
        refuse(.refused-statement, line)
        break
    if operand-kind(associated) == .operand-void
        associated = associate-style-site(line, made, type, number)
    if operand-kind(target) == .operand-void
        target = content-target(row.site, line, made, type).operand
    . builder = content-builder(row, line)
    . mark = pending.length
    pending += associated
    pending += target
    pending += integer(.machine-u32, row.slot)
    pending += order-value(line, style-order)
    pending += builder.operand
    style-order += 1
    . record = call-instance(facts.style-runtime.template-content, line, mark)
    if conditions != U32.max
        enable-content(conditions, record.operand, made, type, associated, line)
= associated

────────────────────
_ do content-of StyleContent?
    - index U32
    - line SyntaxId

` The content a line of a style rule generates where the application `index` applies it at the
` site of the instance emitted, as the type pass recorded it, or none.
for row in facts.style-contents
    if row.instance == unit.instance && row.application == index && row.line == line
        = row
= null

────────────────────
_ do content-target Typed
    - site SyntaxId
    - line SyntaxId
    - made Operand
    - type TypeId

` The object generated content is made for, as the `MarkupElement` the style runtime takes it as,
` converted as the type pass recorded at its markup element.
. fact = facts.first-conversion(unit.instance, site)
while fact != no-fact
    . row = facts.conversions[fact]
    if row.reason == .reason-markup-host && row.from == type
        = convert-one(line, row, Typed(made, type))
    fact = row.next
refuse(.refused-conversion, line)
= Typed(made, no-type)

────────────────────
_ do content-builder Typed
    - row StyleContent
    - line SyntaxId

` The function that builds the content a line of a style rule generates, made the
` `MarkupSlotBuilder` the style runtime takes, as the type pass recorded it in that function:
` a closure that captures nothing, whose environment is none or holds the values it keeps
` (`content-environment`).
. fact = facts.first-conversion(row.builder, row.line)
while fact != no-fact
    . held = facts.conversions[fact]
    if held.reason == .reason-markup-slot && held.from == row.closure
        . environment = content-environment(row, line)
        = make-function(line, held, environment)
    fact = held.next
refuse(.refused-conversion, line)
= Typed(make-operand(.operand-void, 0), no-type)

────────────────────
_ do content-environment Operand
    - row StyleContent
    - line SyntaxId

` The environment of the function that builds generated content where it keeps state cells or
` values of the rules around rules written in rules (`kept-layout-of`): no environment in force,
` then each state cell the markup element it is generated at holds of those it keeps, then each
` value, in turn (`around-local`). None where it keeps none.
. layout = tables.kept-layout-of(row.builder)
if layout == no-layout
    = integer(.machine-managed-pointer, 0)
. mark = pending.length
pending += integer(.machine-u64, tables.layouts.rows[layout].size)
pending += make-operand(.operand-descriptor, layout)
. kept = ir.add-local(managed-layout)
store-local(kept, call-runtime(.runtime-allocate-object, line, mark, managed-layout), line)
. place U32 = 1
. taken U32
for held in facts.scope-cells
    if held.instance != row.builder || held.kept == U32.max
        continue
    . local = if held.kept < row.cells then cell-local(kept-cell) else no-local
        .. kept-cell = facts.content-cells[row.cell-first + held.kept]
    if local == no-local
        refuse(.refused-expression, line)
        = load-local(kept, line)
    store
        - load-local(kept, line)
        - tables.layouts.field(layout, held.kept + 1).offset
        - load-local(local, line)
        - true
        - line
    place += 1
for held in facts.scope-values
    if held.instance != row.builder || held.kept == U32.max
        continue
    if taken >= row.values
        refuse(.refused-expression, line)
        = load-local(kept, line)
    . source = facts.content-values[row.value-first + taken]
    for position in 0 .. < held.count
        . (local, type) = around-local(source, position)
        . field = tables.layouts.field(layout, place)
        if local == no-local || other-type || tables.layouts.is-struct(field.layout)
            refuse(.refused-expression, line)
            = load-local(kept, line)
        .. other-type = type != facts.scope-value-types[held.type-first + position]
        store
            - load-local(kept, line)
            - field.offset
            - load-local(local, line)
            - is-managed-pointer(field.layout)
            - line
        place += 1
    taken += 1
= load-local(kept, line)

────────────────────
_ do enable-content
    - conditions U32
    - record Operand
    - made Operand
    - type TypeId
    - association Operand
    - site SyntaxId

` Enables the record of generated content as the conditions it is made under hold, as the
` reference's `compileGuardedContent` does: they are evaluated once in a live action of their
` own, which gathers what they read, and the record is enabled or disabled there; then the
` association is given an action with those trackers that runs the function of the row of
` `style-gates` for the content (`emit-style-gate`) with what it keeps: the object, the record and
` what `gate-locals` holds. An error enabling it raises leaves the function.
. whens = gate-whens(conditions)
. row = facts.gate-of(type, whens, true)
if row == U32.max
    refuse(.refused-statement, site)
    =
. cells = gate-locals(whens, site)
. runtime = facts.style-runtime
. kept-record = ir.add-local(managed-layout)
store-local(kept-record, record, site)
. trackers = open-trackers(site)
live-actions += LiveTrackers(trackers, trackers)
. loaded [Operand]
for cell in cells
    loaded += load-local(cell, site)
. enabled = gate-conditions(whens, made, type, loaded, true)
. mark = pending.length
pending += load-local(kept-record, site)
pending += enabled
do raising-call(site, runtime.content-enabled, mark)
live-actions.pop()
. layout = tables.gate-layouts[row]
. size = tables.layouts.rows[layout].size
mark = pending.length
pending += integer(.machine-u64, size)
pending += make-operand(.operand-descriptor, layout)
. kept = ir.add-local(managed-layout)
store-local(kept, call-runtime(.runtime-allocate-object, site, mark, managed-layout), site)
store(load-local(kept, site), tables.layouts.field(layout, 0).offset, made, true, site)
store
    - load-local(kept, site)
    - tables.layouts.field(layout, 1).offset
    - load-local(kept-record, site)
    - true
    - site
for position in 0 .. < cells.length
    store
        - load-local(kept, site)
        - tables.layouts.field(layout, (position as U32) + 2).offset
        - load-local(cells[position], site)
        - true
        - site
. callback = make-callback
    - tables.live-adapter-of(tables.gate-functions[row])
    - load-local(kept, site)
    - site
mark = pending.length
pending += made
pending += load-local(trackers, site)
pending += callback
. action = call-instance(facts.style-gates[row].action, site, mark)
mark = pending.length
pending += association
pending += action.operand
do call-instance(runtime.dynamic, site, mark)

────────────────────
_ do call-shared-rule Operand
    - index U32
    - number U32
    - made Operand
    - type TypeId
    - association Operand

` A `shared` application of a style rule, as the reference's `callStyleRuleFunction` makes one,
` at the type the element names, as the rule is matched by: the object's association with the
` site made first, then the function given the object, the association, the site's number and
` the order its declarations start from, which count on after them.
. application = facts.style-applications[index]
. code = tables.rule-function-of(index)
if code == no-function || number == U32.max
    refuse(.refused-statement, application.site)
    = association
. own-unit = unit
unit = unit.source-module = application.module
. called = application.site
match? tree.nodes[called]
    | .node-markup(row)
        called = row.type-id
. opening = association
if operand-kind(opening) == .operand-void
    opening = associate-style-site(called, made, type, number)
. target = tables.functions[code]
. mark = pending.length
pending += made
pending += opening
pending += site-value(number)
pending += order-value(called, style-order)
ir.depend(.callee-function, code, may-panic-dependency)
call
    - make-operand(.operand-symbol, target.symbol)
    - called
    - mark
    - .callee-function
    - void-layout
    - !in-landing
unit = own-unit
style-order += application.span
= opening

────────────────────
+ do emit-style-rule

` The function the reference makes for a style rule applied `shared`, given the object, its
` association with the site, the site's number and the order to start from: the rule applied
` as at an element, its declarations at the number and orders given.
. index = function.place
. application = facts.style-applications[index]
. runtime = facts.style-runtime
unit = unit.source-module = instances.rows[application.unit].module
. association-layout = layout-of(instances.signatures[runtime.associate].returns, application.site)
ir.add-argument(managed-layout)
ir.add-argument(association-layout)
ir.add-argument(u64-layout)
ir.add-argument(u32-layout)
returns-type = types.void-type
ir.returns = void-layout
site-param = make-operand(.operand-argument, 2)
order-param = make-operand(.operand-argument, 3)
shared-rule = index
style-order = 0
begin-recording(application.site, application.module, 0)
do apply-style-rule(index, 0, styled, application.made, make-operand(.operand-argument, 1), U32.max)
    .. styled = make-operand(.operand-argument, 0)
return-value(make-operand(.operand-void, 0), application.site)

────────────────────
_ do site-value Operand
    - number U32

` The number of a style site as the runtime takes it: that given the function of a `shared`
` rule, or the site's own.
if site-param
    = site-param
= integer(.machine-u64, number)

────────────────────
_ do order-value Operand
    - site SyntaxId
    - order U32

` An order of a declaration as the runtime takes it: counted from that given the function of a
` `shared` rule, or as it is.
if order-param
    = arithmetic(site, .arithmetic-add, order-param, integer(.machine-u32, order), u32-layout)
= integer(.machine-u32, order)

────────────────────
_ do apply-inner-rules Operand ?! Refused
    - index U32
    - within SyntaxId
    - number U32
    - made Operand
    - type TypeId
    - association Operand
    - inherited U32

` Applies the rules a style rule applied at a site applies, after its name or, `within` the
` body of one of its `when`s, there, in the order recorded, under the conditions given.
. associated = association
. position = index + 1
while position < facts.style-applications.length
    . nested = facts.style-applications[position]
    if nested.outer == U32.max || nested.outer < index
        break
    if nested.outer == index && nested.within == within
        associated = apply-style-rule(position, number, made, type, associated, inherited)
    position += 1
= associated

────────────────────
_ do declare-rule-style Operand
    - row StyleDeclaration
    - layer U32
    - gated Bool
    - number U32
    - made Operand
    - type TypeId
    - association Operand

` A declaration of a style rule applied at a site, at the next order: in the block of the gate
` in force, opened for it where none is, at the conditional layer at least, or a default's at
` the gated defaults layer, where it is `gated`.
. order = style-order
style-order += 1
if !gated
    = declare-style(row, layer, order, number, made, type, association)
. associated = open-gate(styling.gate, row.site, made, type, number, association)
. floor = if layer == 0 then 3u32 else 4u32
= declare-style
    - row
    - if layer > floor then layer else floor
    - order
    - number
    - made
    - type
    - associated
    - true

────────────────────
_ do cell-condition U32
    - cell U32
    - outer-cells U32
    - inherited U32

` The condition a style rule applied under the state cells of `when`s is gated by, as the
` reference's `styleScopeStateConditions` puts the cells before those it is applied under: those
` of the `when`s further out (`outer-cells`), the outermost first, then the innermost's, then each
` of those made again over them. Those given where there is no cell.
if cell == U32.max
    = inherited
. chain [U32]
facts.link-cells(outer-cells, chain)
chain += cell
. top = U32.max
for place in chain
    . held = facts.scope-cells[place]
    . next = style-conditions.length as U32
    style-conditions += StyleCondition(StyleWhen(held.module, held.when, place), top)
    top = next
if inherited == U32.max
    = top
for place in gate-whens(inherited)
    . next = style-conditions.length as U32
    style-conditions += StyleCondition(place, top)
    top = next
= top

────────────────────
_ do enter-gate U32
    - top U32
    - made Operand
    - type TypeId
    - association Operand

` Gates the declarations that follow at a site by a condition and those it was made under, as
` the reference's `compileStyleGatedBlock` does: they join the gate in force where it has the
` same conditions; otherwise that gate is closed and a gate of their own is entered. Answers
` the gate to leave, or `U32.max` where none was entered.
if styling.gate != U32.max && site-gates[styling.gate].top == top
    = U32.max
if styling.gate != U32.max
    close-gate(styling.gate, made, type, association)
. gate = site-gates.length as U32
site-gates += SiteGate(top, no-local, styling.gate)
styling = styling.gate = gate
= gate

────────────────────
_ do leave-gate
    - gate U32
    - made Operand
    - type TypeId
    - association Operand

` Leaves a gate `enter-gate` entered: the gate in force where it was entered is in force
` again, closed, and the gate is closed.
if gate == U32.max
    =
styling = styling.gate = site-gates[gate].outer
close-gate(gate, made, type, association)

────────────────────
_ do open-gate Operand
    - gate U32
    - site SyntaxId
    - made Operand
    - type TypeId
    - number U32
    - association Operand

` Opens a block of declarations for a gate at its first declaration, as the reference's
` `openStyleGate` does: the object is associated with the site where it was not, and the
` number of the block the association opens is kept. Answers the association.
if site-gates[gate].block != no-local
    = association
. associated = association
if operand-kind(associated) == .operand-void
    associated = associate-style-site(site, made, type, number)
. mark = pending.length
pending += associated
. block = call-instance(facts.style-runtime.open-block, site, mark)
. local = ir.add-local(i64-layout)
store-local(local, block.operand, site)
site-gates[gate] = site-gates[gate].block = local
= associated

────────────────────
_ do close-gate
    - gate U32
    - made Operand
    - type TypeId
    - association Operand

` Closes the block a gate has open, as the reference's `closeStyleGate` does, at its innermost
` `when`: the association closes it, its conditions are evaluated once in a live action of
` their own to gather what they read, and the association is given an action with those
` trackers that runs the gate's function (`emit-style-gate`) with what it keeps: the object, the
` block and what `gate-locals` holds. A gate with no block open does nothing.
. local = site-gates[gate].block
if local == no-local
    =
site-gates[gate] = site-gates[gate].block = no-local
. whens = gate-whens(site-gates[gate].top)
. row = facts.gate-of(type, whens)
. place = whens[whens.length - 1]
. own-unit = unit
unit = unit.source-module = place.module
. site = place.syntax
if row == U32.max
    refuse(.refused-statement, site)
    unit = own-unit
    =
. cells = gate-locals(whens, site)
. runtime = facts.style-runtime
. mark = pending.length
pending += association
pending += load-local(local, site)
do call-instance(runtime.close-block, site, mark)
. trackers = open-trackers(site)
live-actions += LiveTrackers(trackers, trackers)
. loaded [Operand]
for cell in cells
    loaded += load-local(cell, site)
gate-conditions(whens, made, type, loaded, true)
live-actions.pop()
. layout = tables.gate-layouts[row]
. size = tables.layouts.rows[layout].size
mark = pending.length
pending += integer(.machine-u64, size)
pending += make-operand(.operand-descriptor, layout)
. kept = ir.add-local(managed-layout)
store-local(kept, call-runtime(.runtime-allocate-object, site, mark, managed-layout), site)
store(load-local(kept, site), tables.layouts.field(layout, 0).offset, made, true, site)
store
    - load-local(kept, site)
    - tables.layouts.field(layout, 1).offset
    - load-local(local, site)
    - false
    - site
for position in 0 .. < cells.length
    store
        - load-local(kept, site)
        - tables.layouts.field(layout, (position as U32) + 2).offset
        - load-local(cells[position], site)
        - true
        - site
. callback = make-callback
    - tables.live-adapter-of(tables.gate-functions[row])
    - load-local(kept, site)
    - site
mark = pending.length
pending += made
pending += load-local(trackers, site)
pending += callback
. action = call-instance(facts.style-gates[row].action, site, mark)
mark = pending.length
pending += association
pending += action.operand
do call-instance(runtime.dynamic, site, mark)
unit = own-unit

────────────────────
_ do gate-locals [LocalId]
    - whens [StyleWhen]
    - site SyntaxId

` The locals holding what the function of a gate keeps for its `when`s, in turn: the state cell
` of each that is one, and for each condition a rule is applied under the environment in force
` here, from which the function written for it reads what it captured. Refused where a cell is
` not made here.
. locals [LocalId]
for held in whens
    if held.cell != U32.max
        . local = cell-local(held.cell)
        if local == no-local
            refuse(.refused-statement, site)
            = locals
        locals += local
    else if held.test != no-instance
        . local = ir.add-local(managed-layout)
        store-local(local, written-environment(site), site)
        locals += local
= locals

────────────────────
_ do gate-whens [StyleWhen]
    - top U32

` The `when`s of a condition made at a site and of those it was made under, the outermost
` first.
. upward [StyleWhen]
. condition = top
while condition != U32.max
    upward += style-conditions[condition].when
    condition = style-conditions[condition].parent
. whens [StyleWhen]
for position in 0 .. < upward.length
    whens += upward[upward.length - 1 - position]
= whens

────────────────────
_ do gate-conditions Operand
    - whens [StyleWhen]
    - object Operand
    - type TypeId
    - cells [Operand]
    - at-site Bool

` Evaluates the states the `when`s given name, the outermost first, on an object, as the
` reference evaluates their conjunction: each read tracked, true or, where it is negated,
` false, and each but the first only where those before hold. The `when` of a state cell reads
` `is-on` of the cell, tracked. A condition a rule is applied under is evaluated where the
` element is written, `at-site` (`site-condition`), or else by the function written for it,
` given the environment kept for it. `cells` gives the cells and the environments in turn.
` Answers whether all hold.
. own-unit = unit
. place = whens[0]
unit = unit.source-module = place.module
. layout = layout-of(types.bool-type, place.syntax)
. held = ir.add-local(layout)
. done = ir.reserve-block()
. celled = 0
for position in 0 .. < whens.length
    place = whens[position]
    unit = unit.source-module = place.module
    . value = make-operand(.operand-void, 0)
    if place.cell != U32.max
        . is-on = program.store-atom("is-on")
        track(place.syntax, cells[celled], is-on)
        value = read-state(place.syntax, cells[celled], tables.cell-type(), is-on).operand
        celled += 1
    else if place.test != no-instance
        if at-site
            value = site-condition(place).operand
        else
            . mark = pending.length
            pending += cells[celled]
            value = call-instance(place.test, place.syntax, mark).operand
        celled += 1
    else
        match? tree.nodes[place.syntax]
            | .node-style-when(row)
                track(place.syntax, object, row.state)
                . state-read = read-state(place.syntax, object, type, row.state)
                value = state-read.operand
                if row.is-negated
                    value = compare-zero(place.syntax, Typed(value, state-read.type), .compare-equal).operand
    store-local(held, value, place.syntax)
    if position + 1 < whens.length
        . next = ir.reserve-block()
        branch(load-local(held, place.syntax), next, done)
        ir.start-block(next)
jump(done)
ir.start-block(done)
. holds = load-local(held, place.syntax)
unit = own-unit
= holds

────────────────────
_ do site-condition Typed
    - place StyleWhen

` The condition a style rule written on a markup element is applied under, evaluated where the
` element is written, with the trackers of the live action open noting what it reads: as the
` instance that writes it types it, with the receiver there.
. own-unit = unit
unit = unit.reading = instances.rows[place.test].enclosing
unit = unit.self = site-self
unit = unit.self-type = site-self-type
unit = unit.has-self = site-has-self
unit = unit.running-rule = false
unit = unit.deferred-type = site-deferred
. value = emit-expression(place.syntax)
unit = own-unit
= Typed(value.operand, types.bool-type)

────────────────────
+ do gives-rule-values Bool
    - id SyntaxId

` Whether a markup element writes a style rule application that gives values, or applies a rule
` that the reference evaluates the values of once more as it prepares the element (`prepared`).
match? tree.nodes[id]
    | .node-markup(element)
        for application in tree.children[element.style-rule-applications]
            match? tree.nodes[application]
                | .node-style-rule-application(applied)
                    if applied.args.count != 0
                        = true
. place = tables.first-application(unit.reading)
while place != U32.max
    . held = facts.style-applications[place]
    if held.prepared && held.module == unit.source-module && held.site == id
        = true
    place = tables.next-application(place)
= false

────────────────────
+ do emit-rule-values
    - id SyntaxId

` Evaluates the values given to the style rules written on a markup element, in the order
` written, once its attributes are and before its object is made, as the reference evaluates
` them, whether or not a rule takes them: each is kept as evaluated, to be converted where its
` rule is applied. Those of a rule the rules written in it read (`ScopeValues`) are converted
` now, for the constructor to be given them too (`around-values`). The values the reference
` evaluates once more as it prepares the element are evaluated and let go after those of the
` application that applies their rules, those of rules the element applies by none first
` (`prepare-applied`).
match? tree.nodes[id]
    | .node-markup(element)
        prepare-applied(id, 0)
        for application in tree.children[element.style-rule-applications]
            match? tree.nodes[application]
                | .node-style-rule-application(applied)
                    . read = reads-around(application)
                    for value in tree.children[applied.args]
                        if facts.theme-read-of(unit.reading, value)
                            continue
                        . kept = emit-expression(value)
                        rule-givens += RuleValue(apart(kept, value, true), kept.type, value)
                        if read
                            . converted = convert(value, .reason-argument, kept)
                            . layout = layout-of(converted.type, value)
                            . local = ir.add-local(layout, false)
                            store-local(local, converted.operand, value)
                            around-values += AroundValue(value, local, converted.type)
                    prepare-applied(id, application)

────────────────────
_ do prepare-applied
    - site SyntaxId
    - written SyntaxId

` Evaluates the values the reference evaluates once more as it prepares a markup element, of the
` rules after the names of those the element applies by the application `written`, or by none
` it writes (`prepare-rule-values`).
. place = tables.first-application(unit.reading)
while place != U32.max
    . held = facts.style-applications[place]
    if held.module == unit.source-module && held.site == site && top-written
        prepare-rule-values(place)
    .. top-written = held.outer == U32.max && held.written == written
    place = tables.next-application(place)

────────────────────
_ do prepare-rule-values ?! Refused
    - index U32

` Evaluates, and lets go, the values that call a function given to the rules written after the
` name of the rule the application `index` applies, and after theirs in turn, in order, as the
` reference evaluates them as it prepares the markup element (`nestedRuleScopesForPrepared`),
` before its object is made (`prepared`): in the instance that types the rule that writes them,
` where there is no object yet, nor the values of the rules around. They are evaluated again as
` their rules are applied.
. position = index + 1
while position < facts.style-applications.length
    . nested = facts.style-applications[position]
    if nested.outer == U32.max || nested.outer < index
        break
    if nested.outer == index && nested.within == 0
        if nested.prepared
            drop-rule-values(nested.written, facts.style-applications[index].unit)
        prepare-rule-values(position)
    position += 1

────────────────────
_ do drop-rule-values
    - written SyntaxId
    - unit-id InstanceId

` Evaluates the values a written application gives, in the instance `unit-id` that types them, and
` lets them go (`prepare-rule-values`).
. own-unit = unit
. own-filling = filling
unit = unit.source-module = instances.rows[unit-id].module
unit = unit.reading = unit-id
unit = unit.self-type = instances.rows[unit-id].self-type
unit = unit.has-self = false
filling = filling.count = 0
unit = unit.deferred-type = no-type
unit = unit.running-rule = false
match? tree.nodes[written]
    | .node-style-rule-application(applied)
        for value in tree.children[applied.args]
            emit-expression(value)
unit = own-unit
filling = own-filling

────────────────────
_ do reads-around Bool
    - application SyntaxId

` Whether the values an application written after `•` here gives are read by the rules written
` in the rule it applies (`ScopeValues`).
for held in facts.scope-values
    if held.instance == unit.instance && held.site == application && held.module == unit.source-module
        = true
= false

────────────────────
_ do bind-rule-values
    - written SyntaxId
    - unit-id InstanceId
    - now Bool
    - values InstanceId

` Converts each value a written application gives a style rule, at its node, to the type the
` rule takes it as, and keeps it in a local of its own for the rule's reads of the name that
` takes it. The values an element gives were evaluated before its object was made
` (`emit-rule-values`); those a rule gives a rule it applies are evaluated `now`, in it, as are
` those a slot outlet gives once its node is mounted, and those an instance of their own types
` (`values`), read through its facts. Those an element gives are kept for the rules written in
` the rule too (`around-values`).
. row = instances.rows[unit-id]
. owner = program.modules[row.module]
. names [SyntaxId]
match? owner.decls[row.initializer]
    | .decl-style-rule(rule)
        match? owner.tree.nodes[rule.syntax]
            | .node-rule-syntax(declared)
                for arg in owner.tree.children[declared.args]
                    match? owner.tree.nodes[arg]
                        | .node-argument-decl(shape)
                            match? owner.tree.nodes[shape.pattern]
                                | .node-type-capture(capture)
                                    names += capture.id
match? tree.nodes[written]
    | .node-style-rule-application(applied)
        if applied.args.count != names.length
            refuse(.refused-statement, written)
            =
        for position in 0 .. < applied.args.count
            . value = tree.children[applied.args.start + position]
            if values == no-instance && facts.theme-read-of(unit.reading, value)
                continue
            . given = Typed(make-operand(.operand-void, 0), no-type)
            . converted = given
            if values != no-instance
                converted = root-value(value, values)
            else
                if !now
                    . found = around-place(value)
                    if found
                        rule-names += RuleName(bindings.resolution-of(row.binding, names[position]).slot, around-values[found].local, around-values[found].type)
                        continue
                if now
                    given = emit-expression(value)
                else
                    . index = rule-givens.length
                    while index != 0 && rule-givens[index - 1].written != value
                        index -= 1
                    if index == 0
                        refuse(.refused-expression, value)
                        =
                    given = Typed(rule-givens[index - 1].value, rule-givens[index - 1].type)
                converted = convert(value, .reason-argument, given)
            . layout = layout-of(converted.type, value)
            . local = ir.add-local(layout, false)
            store-local(local, converted.operand, value)
            rule-names += RuleName(bindings.resolution-of(row.binding, names[position]).slot, local, converted.type)
        =
refuse(.refused-statement, written)

────────────────────
_ do bind-around-values
    - index U32
    - unit-id InstanceId
    - site SyntaxId

` Gives a rule written in a rule, for its reads of the names the rule around it takes values by,
` the values the markup element that applied that rule gave it (`ScopeValues`), as the
` reference defines them in the frames it is applied within (`withStyleRuleLexicalFrames`): each
` as kept, converted, where the rule around was applied, or as given (`around-local`).
. names = around-names(index)
for position in 0 .. < names.length
    . (local, type) = around-local(index, position as U32)
    if local == no-local
        refuse(.refused-statement, site)
        =
    rule-names += RuleName(bindings.resolution-of(instances.rows[unit-id].binding, names[position]).slot, local, type)

────────────────────
_ do root-value Typed
    - value SyntaxId
    - values InstanceId

` A value a root `<This` gives a style rule its constructor applies, converted to the type the
` rule takes it as, read through the instance that types it (`check-root-values`) as a value
` written for the receiver's class is.
. own-unit = unit
unit = unit.reading = values
unit = unit.running-rule = true
unit = unit.self-type = instances.rows[values].self-type
. given = emit-expression(value)
. converted = given
converted = convert(value, .reason-argument, Typed(given.operand, converted.type))
unit = own-unit
= converted

────────────────────
+ do read-rule-value Typed
    - slot SlotId
    - id SyntaxId
    - type TypeId

` A value a style rule takes, read in the rule where it is applied: what the local it is kept
` in holds, or what that holds where the type pass narrowed it.
. nothing = make-operand(.operand-void, 0)
. position = rule-names.length
while position != 0
    position -= 1
    if rule-names[position].slot == slot
        . held = rule-names[position].type
        . cased = held != type && facts.plan-of(unit.reading, id) == .plan-case-read
        if held != type && (shared-depth != 0 || (!holds(held, type) && !cased))
            refuse(.refused-expression, id)
            = Typed(nothing, no-type)
        . value = load-local(rule-names[position].cell, id)
        if held == type
            = Typed(value, held)
        if cased
            = read-case(id, value, held, type)
        = payload(id, Typed(value, held))
refuse(.refused-expression, id)
= Typed(nothing, no-type)

────────────────────
_ do rule-lines RowRange'SyntaxId
    - unit-id InstanceId

` The lines of the body of the style rule an instance types, or none where the rule has no
` body of lines, which has no shape here; or the line of a root `<This` that declares a style,
` which an instance of its own types (`check-root-style`).
. row = instances.rows[unit-id]
. owner = program.modules[row.module]
match? owner.decls[row.initializer]
    | .decl-style-rule(rule)
        match? owner.tree.nodes[rule.syntax]
            | .node-rule-syntax(written)
                if written.body == 0
                    = RowRange'SyntaxId()
                match? owner.tree.nodes[written.body]
                    | .node-block(block)
                        = block.body
    | .decl-property(property)
        match? owner.decls[property.owner]
            | .decl-class(class)
                match? owner.tree.nodes[owner.tree.root-this(class.content)]
                    | .node-markup(root)
                        match? owner.tree.nodes[root.body]
                            | .node-block(block)
                                for position in 0 .. < block.body.count
                                    if statement == property.syntax
                                        = RowRange'SyntaxId(block.body.start + position, 1)
                                    .. statement = owner.tree.children[block.body.start + position]
refuse-instance(unit-id)
= RowRange'SyntaxId()

────────────────────
_ do update-rule-property
    - row RuleUpdate
    - made Operand
    - application StyleApplication

` Stores the value a line of a style rule gives a property of the class that writes it in the
` object the rule is applied to, as a markup element's attribute is stored. One whose value read
` something tracked is evaluated in a live action of its own, whose trackers make the action that
` sets it again (`update-again`), and so is one whose value reads values an application with
` `live-values` gives (`update-given`).
. given = if styling.live != U32.max && row.reads-given then author-place else U32.max
    .. author-place = tables.given-author(styling.live, row.site)
if given != U32.max
    update-given(row, given, made, application)
    =
match? tree.nodes[row.site]
    | .node-assign(line)
        . live = tables.live-statement-of(unit.reading, row.site)
        . trackers = if live then open-trackers(row.site) else no-local
        if live
            live-actions += LiveTrackers(trackers, trackers)
        . value = convert(row.site, .reason-assignment, emit-expression(line.rhs))
        if live
            live-actions.pop()
        store-argument(made, unit.self-type, row.property, value.operand, value.type, row.site)
        if live
            update-again(live, trackers, made, application)

────────────────────
_ do update-given
    - row RuleUpdate
    - place U32
    - made Operand
    - application StyleApplication

` A line of a style rule that sets a property of the class with a value reading values an
` application with `live-values` gives: the values, evaluated again where they are written
` (`bind-live-values`), and the line's value are evaluated in a live action of their own to gather
` what they read, the value is stored, and the object owns an action with those trackers that runs
` the function of `given-functions` with what it keeps (`own-update`): the object, then the
` receiver where the values the site applies are written.
. code = tables.given-functions[place]
. layout = tables.given-layouts[place]
if code == no-function || application.shared
    refuse(.refused-statement, row.site)
    =
. trackers = open-trackers(row.site)
live-actions += LiveTrackers(trackers, trackers)
. bound = rule-names.length
bind-live-values(styling.live, made, site-self, site-deferred)
. value = Typed(make-operand(.operand-void, 0), no-type)
match? tree.nodes[row.site]
    | .node-assign(line)
        value = convert(row.site, .reason-assignment, emit-expression(line.rhs))
while rule-names.length > bound
    rule-names.pop()
live-actions.pop()
store-argument(made, unit.self-type, row.property, value.operand, value.type, row.site)
. mark = pending.length
pending += integer(.machine-u64, tables.layouts.rows[layout].size)
pending += make-operand(.operand-descriptor, layout)
. kept = ir.add-local(managed-layout)
store-local(kept, call-runtime(.runtime-allocate-object, row.site, mark, managed-layout), row.site)
store(load-local(kept, row.site), tables.layouts.field(layout, 0).offset, made, true, row.site)
store
    - load-local(kept, row.site)
    - tables.layouts.field(layout, 1).offset
    - integer(.machine-i64, U64.max)
    - false
    - row.site
store
    - load-local(kept, row.site)
    - tables.layouts.field(layout, 2).offset
    - integer(.machine-u32, 0)
    - false
    - row.site
store
    - load-local(kept, row.site)
    - tables.layouts.field(layout, 3).offset
    - integer(.machine-u32, 0)
    - false
    - row.site
store(load-local(kept, row.site), tables.layouts.field(layout, 4).offset, site-self, true, row.site)
keep-given-row-items(place, load-local(kept, row.site), row.site)
own-update(row.site, trackers, code, load-local(kept, row.site), made, application)

────────────────────
_ do update-again
    - live LiveStatement
    - trackers LocalId
    - made Operand
    - application StyleApplication

` The live action of a line of a style rule whose value read something tracked, as the
` reference's `markupLiveAction` makes it for the object the rule is applied to: the object is
` kept in the local no name reaches declared at the line, in an environment of the rule's own
` layout made for the action alone (`lone-environment`), and the action, with the trackers the
` value noted and a callback that runs the line's function with that environment, is owned by
` the object: a plain one, or one the markup runtime makes, given the object where it is a
` batch, else the batch in force where the application chose one, else the object as its host.
` A rule a class shares among its elements has no shape here.
. site = live.site
. slot = channel-slot(site)
. code = if live.rerun != no-instance then tables.instance-functions[live.rerun] else no-function
if code == no-function || slot == no-slot || application.shared
    refuse(.refused-statement, site)
    =
. lone = lone-environment(site, slot)
keep-lone(lone, slot, made, unit.self-type, site)
. environment = load-local(lone, site)
own-update(site, trackers, code, environment, made, application)

────────────────────
_ do own-update
    - site SyntaxId
    - trackers LocalId
    - code FunctionId
    - environment Operand
    - made Operand
    - application StyleApplication

` Makes the live action that sets a property a line of a style rule sets again, with the
` trackers given and a callback that runs a function with the environment given, owned by the
` object, as `update-again` says.
if application.plain-updates
    . action = make-action
        - load-local(trackers, site)
        - tables.live-adapter-of(code)
        - environment
        - site
    attach-action(made, action.operand, site)
    =
. updater = application.updater
if updater == no-instance || instances.signatures[updater].errors.count != 0
    refuse(.refused-statement, site)
    =
. callback = make-callback(tables.live-adapter-of(code), environment, site)
. owner = make-operand(.operand-void, 0)
if application.rooted && converts-for(site, .reason-markup-batch)
    owner = convert(site, .reason-markup-batch, Typed(made, unit.self-type)).operand
else if application.rooted && content-roots.length != 0
    owner = content-roots[content-roots.length - 1]
else if !application.rooted
    owner = convert(site, .reason-markup-host, Typed(made, unit.self-type)).operand
if operand-kind(owner) == .operand-void
    refuse(.refused-statement, site)
. mark = pending.length
pending += load-local(trackers, site)
pending += callback
pending += owner
. action = raising-call(site, updater, mark)
attach-action(made, action.operand, site)

────────────────────
_ do converts-for Bool
    - site SyntaxId
    - reason ConversionReason

` Whether the type pass recorded a conversion at a site for a reason.
. fact = facts.first-conversion(unit.reading, site)
while fact != no-fact
    if facts.conversions[fact].reason == reason
        = true
    fact = facts.conversions[fact].next
= false

────────────────────
_ do declare-style Operand
    - row StyleDeclaration
    - layer U32
    - order U32
    - number U32
    - made Operand
    - type TypeId
    - association Operand
    - gated Bool = false

` A style declaration for an object at the site numbered `number`, as the reference makes one:
` the record of the property's style, by the style's number, then the bits of the value,
` declared for the site where the value reads nothing that differs from one making to the
` next, in the block of the gate in force where `gated`, and otherwise for the association of
` the object with the site, made at the first such. One whose value read something tracked is
` declared by a live action instead (`declare-live-style`), and so is one of a style rule
` (`declare-authored-style`), and one of a rule whose value reads values an application with
` `live-values` gives (`declare-given-style`). `inherit` is declared with no value, for the site. A value the
` runtime holds a handle to is declared for the association by a holder (`author-value`), or
` where the reference evaluates it once for every making, as `declare-cached` says, and the
` slot of a style sheet as `declare-sheet-slot` says. An optional that holds nothing is flagged
` none. Answers the association, or the one given where none was made.
. nothing = make-operand(.operand-void, 0)
. live = tables.live-statement-of(unit.reading, row.site)
. author = facts.style-author-of(unit.reading, row.site)
. given = given-place(row)
. property = facts.style-properties[row.property]
. sited = persistent || row.themed != U32.max || (row.fixed && !holds-style-handle(property.type))
    .. persistent = row.inherits || row.cached || row.once || row.sheet != U32.max
if styling.family-gated && ((live && !gated) || author != U32.max || given != U32.max || !sited)
    refuse(.refused-statement, row.site)
    = association
if given != U32.max
    = declare-given-style(row, given, layer, order, gated, number, made, type, association)
if live && !gated
    = declare-live-style(row, live, number, made, type, association)
if author != U32.max
    = declare-authored-style(row, author, layer, order, gated, number, made, type, association)
. runtime = facts.style-runtime
. index = style-number(row.site, row.style)
. use = tables.style-uses[index]
if sited
    = declare-site-style(row, layer, order, number, association)
. mark = pending.length
pending += integer(.machine-u64, index)
. info = call-instance(runtime.info-required, row.site, mark)
. value = nothing
match? tree.nodes[row.site]
    | .node-assign(attribute)
        value = convert(row.site, .reason-assignment, emit-expression(attribute.rhs)).operand
if holds-style-handle(property.type)
    . held = association
    if operand-kind(held) == .operand-void
        held = associate-style-site(row.site, made, type, number)
    . head [Operand]
    head += held
    head += info.operand
    head += integer(.machine-u64, row.property - use.first)
    head += integer(.machine-u32, layer)
    head += order-value(row.site, order)
    author-value
        - row.site
        - property.type
        - value
        - head
        - runtime.template-static
        - runtime.template-object
    = held
. none = none-flag(row.site, property.type, value)
. bits = style-bits(row.site, property.type, value)
. associated = association
if operand-kind(associated) == .operand-void
    associated = associate-style-site(row.site, made, type, number)
mark = pending.length
pending += associated
pending += info.operand
pending += integer(.machine-u64, row.property - use.first)
pending += integer(.machine-u32, layer)
pending += order-value(row.site, order)
pending += bits
pending += none.operand
do call-instance(runtime.template-static, row.site, mark)
= associated

────────────────────
_ do declare-site-style Operand
    - row StyleDeclaration
    - layer U32
    - order U32
    - number U32
    - association Operand

. recording = recording-local(number)
if recording == no-local
    refuse(.refused-statement, row.site)
    = association
. making = ir.reserve-block()
. joined = ir.reserve-block()
branch(load-local(recording, row.site), making, joined)
ir.start-block(making)
do record-site-style(row, layer, order, number, association)
jump(joined)
ir.start-block(joined)
= association

────────────────────
_ do record-site-style Operand
    - row StyleDeclaration
    - layer U32
    - order U32
    - number U32
    - association Operand

. runtime = facts.style-runtime
. mark = pending.length
pending += integer(.machine-u64, style-number(row.site, row.style))
. info = call-instance(runtime.info-required, row.site, mark)
if row.inherits
    = declare-inherit(row, info.operand, layer, order, number, association)
if row.cached
    = declare-cached(row, info.operand, layer, order, number, association)
if row.themed != U32.max
    = declare-themed(row, info.operand, layer, order, number, association)
if row.sheet != U32.max
    = declare-sheet-slot(row, info.operand, layer, order, number, association)
= declare-fixed(row, info.operand, layer, order, number, association)

────────────────────
_ do declare-fixed Operand
    - row StyleDeclaration
    - info Operand
    - layer U32
    - order U32
    - number U32
    - association Operand

. use = tables.style-uses[style-number(row.site, row.style)]
. property = facts.style-properties[row.property]
. value = make-operand(.operand-void, 0)
match? tree.nodes[row.site]
    | .node-assign(attribute)
        value = convert(row.site, .reason-assignment, emit-expression(attribute.rhs)).operand
. none = none-flag(row.site, property.type, value)
. bits = style-bits(row.site, property.type, value)
. mark = pending.length
pending += site-value(number)
pending += info
pending += integer(.machine-u64, row.property - use.first)
pending += integer(.machine-u32, layer)
pending += order-value(row.site, order)
pending += bits
pending += none.operand
do call-instance(facts.style-runtime.site-static, row.site, mark)
= association

────────────────────
_ do record-family
    - application StyleApplication
    - number U32
    - entering Bool

. recording = recording-local(number)
if recording == no-local
    refuse(.refused-statement, application.site)
    =
. own-unit = unit
unit = unit.source-module = application.module
. at = application.site
. making = ir.reserve-block()
. joined = ir.reserve-block()
branch(load-local(recording, at), making, joined)
ir.start-block(making)
. runtime = facts.style-runtime
. mark = pending.length
pending += site-value(number)
if entering
    . held = pending.length
    pending += integer(.machine-u64, tables.sheet-number(application.family))
    . sheet = call-instance(runtime.sheet-info-required, at, held)
    pending += sheet.operand
    pending += integer(.machine-u64, application.members)
    do call-instance(runtime.site-family, at, mark)
else
    do call-instance(runtime.site-family-end, at, mark)
jump(joined)
ir.start-block(joined)
unit = own-unit

────────────────────
_ do begin-recording
    - at SyntaxId
    - module ModuleId
    - number U32

=? if number == U32.max
. own-unit = unit
unit = unit.source-module = module
. mark = pending.length
pending += site-value(number)
. recording = call-instance(facts.style-runtime.site-recording, at, mark)
. local = ir.add-local(u8-layout)
store-local(local, recording.operand, at)
unit = own-unit
. found = recording-place(number)
if found
    recordings[found] = recordings[found].local = local
    =
recordings += RecordedLocal(number, local)

────────────────────
_ recording-local LocalId
    - number U32

if found then recordings[found].local else no-local

.. found = recording-place(number)

────────────────────
_ do recording-place Size?
    - number U32

` Where `recordings` keeps the local of a number the function records a value under.
for position in 0 .. < recordings.length
    if recordings[position].number == number
        = position
= null

────────────────────
_ do declare-cached Operand
    - row StyleDeclaration
    - info Operand
    - layer U32
    - order U32
    - number U32
    - association Operand

` A declaration whose value the reference evaluates once for every making, as its
` `compileStaticStyleObjectDeclaration` makes one: the runtime is given the number of the value,
` that of its function, and a function that evaluates it and gives its bits (`emit-static-value`),
` which it calls the first time only; for the site.
. place = facts.style-static-value-of(unit.source-module, row.site)
. code = if place != U32.max then tables.static-value-functions[place] else no-function
if code == no-function
    refuse(.refused-statement, row.site)
    = association
. maker = make-callback(code, integer(managed-layout as MachineKind, 0), row.site)
. use = tables.style-uses[style-number(row.site, row.style)]
. runtime = facts.style-runtime
. mark = pending.length
pending += site-value(number)
pending += info
pending += integer(.machine-u64, row.property - use.first)
pending += integer(.machine-u32, layer)
pending += order-value(row.site, order)
pending += integer(.machine-u64, tables.functions[code].number)
pending += maker
do call-instance(runtime.site-cached, row.site, mark)
= association

────────────────────
_ do declare-themed Operand
    - row StyleDeclaration
    - info Operand
    - layer U32
    - order U32
    - number U32
    - association Operand

. themed = facts.style-themed-values[row.themed]
. code = tables.themed-value-functions[row.themed]
if code == no-function
    refuse(.refused-statement, row.site)
    = association
. runtime = facts.style-runtime
. mark = pending.length
pending += integer(.machine-u64, tables.sheet-number(themed.sheet))
. sheet = call-instance(runtime.sheet-info-required, row.site, mark)
. maker = make-callback(code, integer(managed-layout as MachineKind, 0), row.site)
. use = tables.style-uses[style-number(row.site, row.style)]
mark = pending.length
pending += site-value(number)
pending += info
pending += integer(.machine-u64, row.property - use.first)
pending += integer(.machine-u32, layer)
pending += order-value(row.site, order)
pending += sheet.operand
pending += integer(.machine-u64, tables.functions[code].number)
pending += maker
