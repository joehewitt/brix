(import ./emitter)
(import ./emitter.lazies)
(import ./emitter.loops)
(import ./emitter.match-arms)
(import ./emitter.tasks)
(import ./layouts)
(import ./program-tables)
(import ./receiver-stability)
(import ./runtime)
(import ./table-layouts)
(import /core/arena)
(import /core/table)
(import /lang/ast/ast)
(import /lang/ast/ast-children)
(import /lang/ast/ast-nodes)
(import /lang/ast/decl)
(import /lang/ast/module)
(import /lang/ast/operator)
(import /lang/ast/program)
(import /lang/ast/row-range)
(import /lang/ast/state-machines)
(import /lang/backend/mir)
(import /lang/check/binding)
(import /lang/check/claims)
(import /lang/check/facts)
(import /lang/check/instances)
(import /lang/check/machine-composite)
(import /lang/check/numeric)
(import /lang/check/pattern-helper)
(import /lang/check/probe-casts)
(import /lang/check/table-rows)
(import /lang/check/type-signature)
(import /lang/check/type-store)
(import /lang/check/type-text)
(import /lang/check/types)
(import /lang/ir/ir)
(import /stream/sort)

(type _ Cleanups (facet-of FunctionEmitter)
  (sees Lazies)
  (sees Loops)
  (sees MatchArms)
  (sees Tasks)
  (prop _ handling-failure _ (= false))
  (prop _ cleanup-raised LocalId (= no-local))
  (fn-do + emit-finally _
    (param id SyntaxId)
    (param body SyntaxId)
    ; Opens a cleanup: a body that runs when the block it is written in is left, by any way out.
    ; A panic raised from here on runs it too, so the checks that follow land on a pad of their
    ; own. One written in a cleanup has no shape.
    (if (. scoping cleaning)
      (call refuse .refused-statement id)
      (return)
    )
    (call open-cleanup body (call UseCell no-local no-local no-type))
  )
  (fn-do + open-cleanup _
    (param item SyntaxId)
    (param cell UseCell)
    ; Opens a cleanup in the block being emitted, which runs where the block is left: a body, a
    ; loop's streams or a `use`, with what a `use` reads. A panic raised from here on runs it
    ; too, so the checks that follow land on a pad of their own.
    (+= open-cleanups (call OpenCleanup item (. scoping block-base) cell block-effects (call is-giving)))
    (= landing no-block)
  )
  (fn-expr + is-giving Bool
    (and (. scoping giving) (== (. lazy-open length) (. scoping giving-lazies)))
  )
  (fn-do + given-top Size
    (param mark Size)
    (let position (. open-cleanups length))
    (while (> position mark)
      (return-if position (if (. ([] open-cleanups (- position 1)) gives)))
      (-= position 1)
    )
    (return mark)
  )
  (fn-do + hand-on-cleanups _
    (param mark Size)
    (param kept Size)
    (let gives (call is-giving))
    (for (in position (..< mark kept))
      (let opened ([] open-cleanups position))
      (= ([] open-cleanups position)
        (call OpenCleanup
          (block
            (arg (. opened body))
            (arg (. scoping block-base))
            (arg (. opened cell))
            (arg (. opened effects))
            (arg gives)
          )
        )
      )
    )
  )
  (fn-expr _ ending-call FactId
    (param begins FactId)
    ; The call that ends a `use`: `end-using`, the second the type pass recorded at the node, or
    ; `close`, the only one, where the use only closes.
    (if-expr (call only-closes begins) begins (. ([] (. facts calls) begins) next))
  )
  (fn-do _ unbind-stack _
    (param id SyntaxId)
    (param cell UseCell)
    ; Puts the slot of the global a `do with` bound back as it was before, where a way out of its
    ; body runs it.
    (let row (call stack-row id))
    (if (== row no-storage)
      (call refuse .refused-statement id)
      (return)
    )
    (let kept ([] (. tables storage) row))
    (call copy
      (block
        (arg (call stack-slot kept id))
        (arg (call load-local (. cell held) id))
        (arg (. kept layout))
        (arg (. ([] (. tables layouts rows) (. kept layout)) is-managed))
        (arg id)
      )
    )
  )
  (fn-do + run-cleanups _ (?! Refused)
    (param mark Size)
    (param open Size)
    (param unwinding Bool (= false))
    ; Runs the cleanups from one of those open down to a mark, newest first, where the function
    ; is on a way out. Each is emitted again here. A panic raised in one ends that one and the
    ; rest still run: its checks land on what follows it. With `unwinding` a panic made the way
    ; out, and one raised here takes its place. On any other way out a panic raised here goes
    ; on once the cleanups of the block that opened them have run: it leaves through the landing
    ; pad of the cleanups still open, as a panic raised after the block would.
    ; A cleanup that may run while a panic is the task's, on a way out a panic made or after one
    ; of the block raised one, runs with that panic set aside. While one runs, `cleaning-open`
    ; counts the cleanups open around it, which an error it raises runs on its way out, and
    ; `cleaning-top` those open where they began to run, above which are those opened in it.
    ; A panic leaves the zone the collector never sees before it lands, so one that may be raised
    ; in a cleanup run in the zone has no shape. Each runs kept from what the `do` blocks around it
    ; were where it was opened, not where it runs.
    (let saved landing)
    (let inside block-effects)
    (let own-scoping scoping)
    (= scoping (= (. scoping cleaning) true))
    (= scoping (= (. scoping cleaning-top) (. open-cleanups length)))
    (let position open)
    (while (> position mark)
      (let base (. ([] open-cleanups (- position 1)) base))
      (if (< base mark)
        (= base mark)
      )
      (let entered landings)
      (if (not unwinding)
        (if (== cleanup-raised no-local)
          (= cleanup-raised (call (. ir add-local) u8-layout))
        )
        (call store-local cleanup-raised (call integer .machine-u8 0) 0)
      )
      (while (> position base)
        (-= position 1)
        (let following (call (. ir reserve-block)))
        (let raised (if-expr unwinding following (call (. ir reserve-block))))
        (let checks landings)
        (= landing raised)
        (if unwinding
          (= scoping (= (. scoping unwinding-from) (. ([] open-cleanups position) body)))
        )
        (let aside (if-expr (or unwinding (!= landings entered)) (call set-panic-aside) no-local))
        (= scoping (= (. scoping cleaning-open) position))
        (= block-effects (. ([] open-cleanups position) effects))
        (call run-cleanup (. ([] open-cleanups position) body) (. ([] open-cleanups position) cell))
        (= block-effects inside)
        (if (and (!= landings checks) (not unwinding) in-zone)
          (call refuse .refused-statement (. ([] open-cleanups position) body))
        )
        (call jump following)
        (if (and (!= landings checks) (not unwinding))
          (call (. ir start-block) raised)
          (call store-local cleanup-raised (call integer .machine-u8 1) 0)
          (call jump following)
        )
        (call (. ir start-block) following)
        (if (!= aside no-local)
          (call take-panic-back aside)
        )
      )
      (if (and (!= landings entered) (not unwinding))
        (= landing saved)
        (= scoping (= (. scoping cleaning) (. own-scoping cleaning)))
        (call resume-panic base)
        (= scoping (= (. scoping cleaning) true))
      )
    )
    (= scoping own-scoping)
    (= landing saved)
  )
  (fn-do _ set-panic-aside LocalId
    ; Where a cleanup may run while a panic is the task's: the panic, where there is one, is set
    ; aside while the cleanup runs, so that nothing the cleanup calls sees it, though
    ; `Task().failure` reads it. The local says whether one was.
    (let active (call make-operand .operand-value (call append .op-load-task-panic 0 (call Span) 0 managed-layout)))
    (let flag (call (. ir add-local) u8-layout))
    (call store-local
      (block
        (arg flag)
        (arg (call compare 0 .compare-not-equal active (call integer (as managed-layout MachineKind) 0)))
        (arg 0)
      )
    )
    (let aside (call (. ir reserve-block)))
    (let body (call (. ir reserve-block)))
    (call branch active aside body)
    (call (. ir start-block) aside)
    (call call-runtime .runtime-panic-begin-cleanup 0 (. pending length))
    (call jump body)
    (call (. ir start-block) body)
    (return flag)
  )
  (fn-do _ take-panic-back _
    (param flag LocalId)
    ; Where a cleanup that set a panic aside ends: the panic is the task's again, unless the
    ; cleanup raised another, which takes its place.
    (let back (call (. ir reserve-block)))
    (let done (call (. ir reserve-block)))
    (call branch (call load-local flag 0) back done)
    (call (. ir start-block) back)
    (call call-runtime .runtime-panic-end-cleanup 0 (. pending length))
    (call jump done)
    (call (. ir start-block) done)
  )
  (fn-do _ resume-panic _
    (param open Size)
    ; Where the cleanups of a block have run on a way out no panic made: a panic one of them
    ; raised leaves through the landing pad of the cleanups still `open`.
    (let flagged (call (. ir reserve-block)))
    (let resumed (call (. ir reserve-block)))
    (call branch (call load-local cleanup-raised 0) flagged resumed)
    (call (. ir start-block) flagged)
    (call jump (call pad-at open unsourced))
    (call (. ir start-block) resumed)
  )
  (fn-do + pad-at IRBlockId
    (param open Size)
    (param site SyntaxId (= 0))
    ; The landing pad of the checks made with a number of cleanups open, which may be fewer
    ; than are open where the function is, made with `site` as its first check where there is
    ; none. The pads are in the order of those numbers.
    (let position (. pads length))
    (while (and (!= position 0) (> (. ([] pads (- position 1)) cleanups) open))
      (-= position 1)
    )
    (if (and (!= position 0) (== (. ([] pads (- position 1)) cleanups) open))
      (return (. ([] pads (- position 1)) block))
    )
    (let block (call (. ir reserve-block)))
    (+= pads (call LandingPad block open site (. unit source-module)))
    (let moved (- (. pads length) 1))
    (while (> moved position)
      (= ([] pads moved) ([] pads (- moved 1)))
      (-= moved 1)
    )
    (= ([] pads position) (call LandingPad block open site (. unit source-module)))
    (return block)
  )
  (fn-do + close-cleanups _
    (param mark Size)
    ; Ends a block that opened cleanups. Where the block ends they run, newest first. Each
    ; landing pad made while they were open runs the ones open at its checks and goes on to the
    ; pad of the block around, which runs its own. In a module's main or a spawned task's body a
    ; pad that knows its first check runs every cleanup open and reports the panic there itself.
    ; A panic reaches a pad outside the zone the collector never sees, so its cleanups run there.
    ; They are open no longer.
    (if (== (. open-cleanups length) mark)
      (return)
    )
    (let zoned in-zone)
    (call run-cleanups mark (. open-cleanups length))
    (let resumed (call (. ir reserve-block)))
    (call jump resumed)
    (let first (. pads length))
    (while (and (!= first 0) (> (. ([] pads (- first 1)) cleanups) mark))
      (-= first 1)
    )
    (let outer no-block)
    (let made false)
    (if (and (!= first 0) (== (. ([] pads (- first 1)) cleanups) mark))
      (= outer (. ([] pads (- first 1)) block))
    )
    (for (in position (..< first (. pads length)))
      (let pad ([] pads position))
      (call (. ir start-block) (. pad block))
      (= in-zone false)
      (if (and (or (== (. function kind) .module-main) (== (. function kind) .task-body)) (!= (. pad site) 0))
        (call run-cleanups 0 (. pad cleanups) true)
        (call leave-pad pad)
        (= in-zone zoned)
        (continue)
      )
      (call run-cleanups mark (. pad cleanups) true)
      (= in-zone zoned)
      (if (== outer no-block)
        (= outer (call (. ir reserve-block)))
        (= made true)
      )
      (call jump outer)
    )
    (while (> (. pads length) first)
      (call (. pads pop))
    )
    (while (> (. open-cleanups length) mark)
      (call (. open-cleanups pop))
    )
    (if made
      (+= pads (call LandingPad outer mark (call opening-site 0) (. unit source-module)))
    )
    (= landing no-block)
    (if (and (!= (. pads length) 0) (== (. ([] pads (- (. pads length) 1)) cleanups) mark))
      (= landing (. ([] pads (- (. pads length) 1)) block))
    )
    (call (. ir start-block) resumed)
  )
  (fn-do + run-cleanup _
    (param body SyntaxId)
    (param cell UseCell)
    ; One cleanup, emitted where a way out runs it: the body of a `do finally`, for the first
    ; header of a loop that reads a stream, a spread of one, or a pipe
    ; whose loop writes each item of one, the calls that end the iteration of its streams, for a
    ; `use` or `do use` the call that ends the use of its object, and for a `do without cancel`
    ; block the call that lets go of its hold on cancellation.
    (if (. cell is-live-call)
      (do
        (inline (call call-instance (. instances live leave) body (. pending length)))
      )
      (return)
    )
    (if (call writes-each body)
      (call end-streams body)
      (return)
    )
    (match? ([] (. tree nodes) body)
      (case .node-loop-syntax
        (call end-streams body)
        (return)
      )
      (case .node-feed-expression
        (call end-streams body)
        (return)
      )
      (case .node-use-expression
        (call end-use body cell)
        (return)
      )
      (case .node-use-block
        (call end-use body cell)
        (return)
      )
      (case .node-stack-local-binding-block
        (call unbind-stack body cell)
        (return)
      )
      (case .node-probe-group
        (call emit-probe-group-end body 1)
        (return)
      )
      (case .node-do-block
        (call call-runtime .runtime-leave-cancel-shield body (. pending length))
        (return)
      )
    )
    (call emit-block body)
  )
  (fn-do _ end-use _
    (param id SyntaxId)
    (param cell UseCell)
    ; Ends a use where a way out of its block runs it: `ending-call` is called on the object kept.
    ; The object of a `use` is kept only where its flag says so, or its slot holds it, and is taken
    ; out first: a copy is made and the flag or the slot cleared, so a way out that runs it again
    ; ends nothing.
    (let begins (call (. facts first-call) (. unit reading) id))
    (let ends (if-expr (== begins no-fact) no-fact (call ending-call begins)))
    (if (== (. cell held) no-local)
      (call end-kept-use id ends (. cell type))
      (return)
    )
    (let layout (. ([] (. ir locals) (. cell held)) layout))
    (let ended no-block)
    (if (!= (. cell flag) no-local)
      (let filled (call (. ir reserve-block)))
      (= ended (call (. ir reserve-block)))
      (call branch (call load-local (. cell flag) id) filled ended)
      (call (. ir start-block) filled)
    )
    (let object (call load-local (. cell held) id))
    (if (call (. tables layouts is-struct) layout)
      (= object (call snapshot object layout id))
    )
    (if (!= (. cell flag) no-local)
      (call store-local (. cell flag) (call integer .machine-u8 0) id)
    )
    (call call-protocol id ends object (. cell type) (call make-operand .operand-void 0))
    (if (!= ended no-block)
      (call jump ended)
      (call (. ir start-block) ended)
    )
  )
  (fn-do _ end-kept-use _
    (param id SyntaxId)
    (param ends FactId)
    (param type TypeId)
    ; Ends a `use` whose slot keeps its object, where the slot holds one.
    (let slot (call using-slot id))
    (let kept (call state slot id))
    (let kept-type (. kept type))
    (let filled (call (. ir reserve-block)))
    (let ended (call (. ir reserve-block)))
    (call branch (. (call present id kept) operand) filled ended)
    (call (. ir start-block) filled)
    (let object (call payload id (call Typed (. kept operand) kept-type)))
    (let layout (call layout-of type id))
    (if (!= (. object type) type)
      (call refuse .refused-statement id)
      (return)
    )
    (if (call (. tables layouts is-struct) layout)
      (= object (call Typed (call snapshot (. object operand) layout id) (. object type)))
    )
    (call keep-state slot (. (call empty-optional kept-type (call layout-of kept-type id)) operand) kept-type id)
    (call call-protocol id ends (. object operand) type (call make-operand .operand-void 0))
    (call jump ended)
    (call (. ir start-block) ended)
  )
  (fn-do + panic-on-error Typed
    (param id SyntaxId)
    (param callee InstanceId)
    (param result Operand)
    ; The value of a call that converts a text written in source. What the callee returned
    ; holds its value or one of its errors. An error is a panic there, with the error's text as
    ; its message, and what follows runs with the value.
    (let nothing (call make-operand .operand-void 0))
    (let text (. instances report error-text))
    (let layout (call layout-of (. ([] (. instances signatures) callee) result) id))
    (let is-ready (and (!= text no-instance) (!= ([] (. tables instance-functions) text) no-function)))
    (if (or (not (call (. tables layouts is-union) layout)) (not is-ready) (not (. function may-panic)))
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (let count (. ([] (. tables layouts rows) layout) cases count))
    (let given (call (. ir reserve-block)))
    (let raised (call (. ir reserve-block)))
    (call branch (call case-test id result 0) given raised)
    (call (. ir start-block) raised)
    (for (in index (..< 1 count))
      (let field (call (. tables layouts case-field) layout index))
      (let next no-block)
      (if (!= (+ index 1) count)
        (let held (call (. ir reserve-block)))
        (= next (call (. ir reserve-block)))
        (call branch (call case-test id result index) held next)
        (call (. ir start-block) held)
      )
      (let mark (. pending length))
      (+= pending (call take result field id))
      (let message (call call-method text id mark))
      (call raise-message id (. message operand))
      (if (!= next no-block)
        (call (. ir start-block) next)
      )
    )
    (call (. ir start-block) given)
    (let field (call (. tables layouts case-field) layout 0))
    (return (call Typed (call take result field id) (. field type)))
  )
  (fn-do + compiler-panic Operand
    (param id SyntaxId)
    (param message Operand)
    ; A panic the compiler makes with a message, at a node, or none where the program has no
    ; panic to make. Its constructor is given the message, and nothing for what else it takes.
    ; A function the collector never sees leaves that zone to make it.
    (let nothing (call make-operand .operand-void 0))
    (let report (. instances report))
    (let object ([] (. tables layouts objects) (. types panic-type)))
    (let is-ready (and (!= object no-layout) (!= (. report source-slot) (. U32 max)) (!= (. report trace-slot) (. U32 max))))
    (let made (. report panic))
    (if (or (not is-ready) (== made no-instance) (== ([] (. tables instance-functions) (. report source)) no-function))
      (call refuse .refused-expression id)
      (return nothing)
    )
    (if (== ([] (. tables instance-functions) made) no-function)
      (call refuse .refused-expression id)
      (return nothing)
    )
    (if in-zone
      (call cross-zone id false)
      (= in-zone false)
    )
    (let signature ([] (. instances signatures) made))
    (if (or (== (. signature args count) 0) (!= (call (. instances argument-type) made 0) (. types string-type)))
      (call refuse .refused-expression id)
      (return nothing)
    )
    (let mark (. pending length))
    (+= pending message)
    (for (in position (..< 1 (. signature args count)))
      (+= pending (. (call absent-argument id (call (. instances argument-type) made position)) operand))
    )
    (return (. (call call-instance made id mark) operand))
  )
  (fn-do + emit-raise-panic _
    ; The function each place that raises a panic calls, given the panic, the path of the module, a
    ; line and a column (`raise-at`).
    (call add-raiser-arguments)
    (call raise-at (call make-operand .operand-argument 0))
  )
  (fn-do _ writes-each Bool
    (param pipe SyntaxId)
    ; Whether a pipe's loop, which writes each item it reads, is being emitted.
    (for (in write writes)
      (if (== (. write pipe) pipe)
        (return true)
      )
    )
    (return false)
  )
  (fn-do + closing-pad IRBlockId
    (param entering Bool)
    ; The pad a checked call that `entering` the zone for it lands on, where the caller runs outside
    ; the zone, to end that zone before the landing pad; none for any other call.
    (return-if no-block (if (or (not entering) (call is-free (. unit instance)))))
    (return (call (. ir reserve-block)))
  )
  (fn-do + landing-block IRBlockId
    (param site SyntaxId)
    ; The landing pad of the checks made where the function is: one for each set of cleanups
    ; open. It keeps the node of the first check that lands there, a panic raised being none.
    (+= landings 1)
    (if (== landing no-block)
      (= landing (call (. ir reserve-block)))
      (+= pads (call LandingPad landing (. open-cleanups length) (call opening-site site) (. unit source-module)))
      (else-if (!= site 0)
        (let position (. pads length))
        (while (!= position 0)
          (-= position 1)
          (if (== (. ([] pads position) block) landing)
            (if (== (. ([] pads position) site) 0)
              (= ([] pads position)
                (call LandingPad
                  (block
                    (arg landing)
                    (arg (. ([] pads position) cleanups))
                    (arg site)
                    (arg (. unit source-module))
                  )
                )
              )
            )
            (break)
          )
        )
      )
    )
    (return landing)
  )
  (fn-expr _ opening-site SyntaxId
    (param site SyntaxId)
    ; The first check of a landing pad made for the cleanups open now. In a spawned task's body
    ; that of the pad of none is where the body starts, at no node.
    (if-expr (and (== (. function kind) .task-body) (== (. open-cleanups length) 0)) unsourced site)
  )
  (fn-do + finish-landing _
    ; The landing pads the checks of the function branch to once every cleanup has run, each
    ; left as `leave-pad` says, and then the handlers of a task body, with the pads their checks make.
    (let position Size 0)
    (while true
      (while (< position (. pads length))
        (call (. ir start-block) (. ([] pads position) block))
        (call leave-pad ([] pads position))
        (+= position 1)
      )
      (if (or (== task-failing no-block) handling-failure)
        (return)
      )
      (call handle-failure)
    )
  )
  (fn-do _ leave-pad _
    (param pad LandingPad)
    ; Where a panic leaves the function once every cleanup has run. A module's main reports the
    ; panic nobody handled at the first check of the pad, in the module of its node, unless the pad
    ; is unsourced (`report-at`); a task's main reports it and ends the task, after forking the end
    ; of its case in a batch. A spawned task's body reports it as a module's main does, and ends the
    ; task, unless the task has handlers: it then gives the panic the source of the pad and goes to
    ; them (`task-failing`). `threadinit` reports it and ends the process. The task that closes the record of probes
    ; reports it and ends, and the functions that flush and look in on probes report it and return,
    ; as no caller handles it. Any other panic is then returned to the caller.
    (call abandon-lazy 0)
    (if (or (== (. function kind) .probe-flush) (== (. function kind) .probe-safepoint))
      (call emit-report false 0)
      (call return-nothing)
      (return)
    )
    (if (== (. function kind) .module-main)
      (call report-at pad)
      (else-if (== (. function kind) .thread-init)
        (call emit-report false 0 true)
      )
      (else-if (== (. function kind) .probe-closer)
        (call emit-report false 0)
        (call call-runtime .runtime-terminate-active-task 0 (. pending length))
      )
      (else-if (== (. function kind) .task-body)
        (if (and (!= task-failing no-block) (not handling-failure))
          (call attach-pad-source pad)
          (call jump task-failing)
          (return)
        )
        (call report-at pad)
        (call call-runtime .runtime-terminate-active-task 0 (. pending length))
      )
      (else-if (== (. function kind) .task-main)
        (call emit-report false 0)
        (if (. program is-batch)
          (call fork-batch ([] (. tables batch-finishes) (. function place)))
        )
        (call call-runtime .runtime-terminate-active-task 0 (. pending length))
      )
    )
    (if in-callback
      (call call-runtime (call callback-exit) 0 (. pending length))
    )
    (call return-panic)
  )
  (fn-do _ attach-pad-source _
    (param pad LandingPad)
    ; Gives the active panic, where it has no source, that of the first check of a pad, as
    ; `report-at` would, where the pad is not unsourced.
    (return-if (if (or (== (. pad site) unsourced) (== (. pad site) 0))))
    (let own-unit unit)
    (= unit (= (. unit source-module) (. pad module)))
    (let attaching (call (. ir reserve-block)))
    (let done (call (. ir reserve-block)))
    (let active (call make-operand .operand-value (call append .op-load-task-panic 0 (call Span) 0 managed-layout)))
    (call branch active attaching done)
    (call (. ir start-block) attaching)
    (let begin (. ([] (. tree nodes) (. pad site)) loc begin))
    (call attach-source active (+ (. begin line) 1) (+ (. begin column) 1) (. pad site))
    (call jump done)
    (call (. ir start-block) done)
    (= unit own-unit)
  )
  (fn-do _ handle-failure _
    ; Where a panic ends a task whose spawn site has handlers, once every cleanup has run: the
    ; handlers are tried in order. A terminating task and one canceled try none. The panic is
    ; taken from the task, and the first handler whose pattern it matches binds it and
    ; runs; the task then ends as where its body ends. Where none matches, the panic is set again
    ; and reported as where there are no handlers. A panic raised in a handler lands on a pad of
    ; its own, which reports it.
    (= handling-failure true)
    (call (. ir start-block) task-failing)
    (= landing no-block)
    (let reporting (call (. ir reserve-block)))
    (let live (call (. ir reserve-block)))
    (let open (call (. ir reserve-block)))
    (let taking (call (. ir reserve-block)))
    (let active (call make-operand .operand-value (call append .op-load-task-panic 0 (call Span) 0 managed-layout)))
    (call branch active live reporting)
    (call (. ir start-block) live)
    (let terminating (call call-runtime .runtime-task-is-terminating 0 (. pending length) u8-layout))
    (call branch terminating reporting open)
    (call (. ir start-block) open)
    (let cancelation (. types cancelation-type))
    (if (and (!= cancelation invalid-type) (call (. tables is-class) cancelation))
      (let raised
        (call make-operand
          (block
            (arg .operand-value)
            (arg (call append .op-load-task-panic 0 (call Span) 0 managed-layout))
          )
        )
      )
      (call class-branch 0 raised cancelation reporting taking)
      (else
        (call jump taking)
      )
    )
    (call (. ir start-block) taking)
    (let taken (call call-runtime .runtime-take-panic 0 (. pending length) managed-layout))
    (call set-task-end task-end-panicked)
    (for (in handler ([] (. tree children) task-handlers))
      (match? ([] (. tree nodes) handler)
        (case (call .node-catcher row)
          (let next (call (. ir reserve-block)))
          (let named (. bound length))
          (call emit-pattern (. row type) (call Typed taken (. types panic-type)) next)
          (call emit-block (. row body))
          (call drop-bound named)
          (call jump task-leaving)
          (call (. ir start-block) next)
        )
      )
    )
    (let mark (. pending length))
    (+= pending taken)
    (call call-runtime .runtime-panic-set 0 mark)
    (call jump reporting)
    (call (. ir start-block) reporting)
    (call emit-report false 0)
    (call call-runtime .runtime-terminate-active-task 0 (. pending length))
    (call return-nothing)
  )
  (fn-do _ report-at _
    (param pad LandingPad)
    ; Reports the active panic at the first check of a pad, as a module's main does, where the pad
    ; is not unsourced, read in the module of its node.
    (let own-unit unit)
    (= unit (= (. unit source-module) (. pad module)))
    (call emit-report (!= (. pad site) unsourced) (. pad site))
    (= unit own-unit)
  )
  (fn-do _ emit-report _
    (param attaches Bool)
    (param site SyntaxId)
    (param fatal _ (= false))
    ; Reports the active panic when no caller is left to handle it:
    ; 1. Nothing is reported when no panic is active, and the panic of a terminating task, or one
    ;    that cancels a task, is cleared. A `fatal` report runs where no task is, and the runtime
    ;    ends the process once it is made.
    ; 2. A module's main gives a panic that has no source its own path, at the first check that
    ;    reached this landing pad. A pad no check with a node reached, as a cleanup's that
    ;    panicked where its block ended, gives it none.
    ; 3. The panic is set aside while its text is made, through its class table, with the text
    ;    of its source, and then given to the runtime with its stack trace.
    (let report (. instances report))
    (let object ([] (. tables layouts objects) (. types panic-type)))
    (let slot ([] (. tables slots) (. report message)))
    (throw (call Panic "The report of an unhandled panic is missing from the program tables") (if (or (== object no-layout) (== slot no-slot-index))))
    (throw (call Panic "The panic class has no source or no stack trace") (if (or (== (. report source-slot) (. U32 max)) (== (. report trace-slot) (. U32 max)))))
    (= in-landing true)
    (let layouts (. tables layouts))
    (let managed managed-layout)
    (let source-field (call (. layouts field) object (+ object-header-fields (. report source-slot))))
    (let trace-field (call (. layouts field) object (+ object-header-fields (. report trace-slot))))
    (throw (call Panic "The source of a panic is not an optional struct") (if (not (call (. layouts is-struct) (. source-field layout)))))
    (let done (call (. ir reserve-block)))
    (let reporting (call (. ir reserve-block)))
    (let active (call make-operand .operand-value (call append .op-load-task-panic 0 (call Span) 0 managed)))
    (call branch active reporting done)
    (blank)
    (call (. ir start-block) reporting)
    (let unhandled (call (. ir reserve-block)))
    (if fatal
      (call jump unhandled)
      (else
        (let suppress (call (. ir reserve-block)))
        (let canceling (call (. ir reserve-block)))
        (let terminating (call call-runtime .runtime-task-is-terminating 0 (. pending length) u8-layout))
        (call branch terminating suppress canceling)
        (blank)
        (call (. ir start-block) canceling)
        (let cancelation (. types cancelation-type))
        (if (and (!= cancelation invalid-type) (call (. tables is-class) cancelation))
          (let raised (call make-operand .operand-value (call append .op-load-task-panic 0 (call Span) 0 managed)))
          (call class-branch 0 raised cancelation suppress unhandled)
          (else
            (call jump unhandled)
          )
        )
        (blank)
        (call (. ir start-block) suppress)
        (call call-runtime .runtime-panic-clear 0 (. pending length))
        (call jump done)
      )
    )
    (blank)
    (call (. ir start-block) unhandled)
    (let panic (call make-operand .operand-value (call append .op-load-task-panic 0 (call Span) 0 managed)))
    (if (and attaches (!= site 0))
      (let begin (. ([] (. tree nodes) site) loc begin))
      (call attach-source panic (+ (. begin line) 1) (+ (. begin column) 1) site)
    )
    (let mark (. pending length))
    (+= pending (call address panic (. trace-field offset) managed 0))
    (call call-runtime .runtime-ensure-stack-trace 0 mark)
    (let suspended (call call-runtime .runtime-panic-suspend 0 (. pending length) managed))
    (let message (call raised-text panic slot false))
    (let placed-text (call raised-place panic))
    (let trace (call load panic (. trace-field offset) (. trace-field layout) 0))
    (+= pending suspended)
    (call call-runtime .runtime-panic-resume 0 mark)
    (+= pending panic)
    (+= pending message)
    (+= pending (. placed-text operand))
    (+= pending trace)
    (call call-runtime
      (block
        (arg (if-expr fatal .runtime-report-fatal-panic .runtime-report-unhandled-panic))
        (arg 0)
        (arg mark)
      )
    )
    (call jump done)
    (call (. ir start-block) done)
    (= in-landing false)
  )
  (fn-do + return-panic _
    ; Returns the active panic to the caller, with the zero of the type the function returns.
    (call return-zero .return-panic)
  )
)
