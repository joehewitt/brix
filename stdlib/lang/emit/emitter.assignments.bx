    (if (call (. tables layouts is-struct) (. field layout))
      (call store-struct (. unit self) field value syntax)
      (else-if (!= (. field layout) void-layout)
        (call store (. unit self) (. field offset) value (call is-managed-pointer (. field layout)) syntax)
      )
    )
  )
  (fn-do + store-stale _
    (param position U32)
    (param syntax SyntaxId)
