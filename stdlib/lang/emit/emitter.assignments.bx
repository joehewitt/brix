      (block
        (arg id)
        (arg item-layout)
        (arg (. (call part (. spanned operand) layout 0 id) operand))
        (arg (. (call part (. spanned operand) layout 1 id) operand))
        (arg snapshot)
        (arg stride)
        (arg (. length operand))
      )
    )
