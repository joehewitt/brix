      (call refuse .refused-probe id)
      (return)
    )
    (let made (call probe-calls id))
    (let start (. given length))
    (call gather-probe-object (. row object))
    (let values (. given length))
    (+= given (call Typed (call make-operand .operand-constant (call (. ir add-string) (. row key text))) (. types string-type)))
    (let value (call emit-expression (. row content)))
    (+= given value)
    (let converted (call convert (. row content) .reason-print (call Typed (. value operand) (. ([] given (+ values 1)) type))))
    (= ([] given (+ values 1)) converted)
    (let head (. pending length))
    (+= pending (call integer .machine-u16 number))
    (call push-probe-object (. row object) start)
    (let snapshots (list Bool))
    (call emit-probe-record id made 0 head values snapshots)
    (call drop-given start)
  )
  (fn-do + emit-updater _
    ; The function that evaluates again the value of a property that reads something tracked,
    ; which the live action the constructor made for it runs through its adapter, given the
    ; object. The trackers of the action that runs it are those it notes reads in, and the value
    ; is stored as an assignment stores it.
