    (if (or (!= ([] (. tables environments) unit-id) no-layout) unchained)
      (call refuse .refused-function (. default site))
      (return)
    )
    (lazy unchained (or (== (. live previous) no-instance) (== (. live next) no-instance)))
    (let field (call (. tables layouts field) object (+ object-header-fields (. property slot))))
    (= unit (= (. unit takes-self) true))
    (= unit (= (. unit has-self) true))
    (= unit (= (. unit self-type) type))
    (= unit (= (. unit self) (call make-operand .operand-argument 0)))
    (call (. ir add-argument) managed-layout)
    (= returns-type (. types void-type))
    (= (. ir returns) void-layout)
    (let previous (call (. ir add-local) managed-layout))
    (call store-local
      (block
        (arg previous)
        (arg (. (call call-instance (. live previous) (. default site) (. pending length)) operand))
        (arg (. default site))
      )
    )
    (let next (call (. ir add-local) managed-layout))
    (call store-local next (. (call call-instance (. live next) (. default site) (. pending length)) operand) (. default site))
    (+= live-actions (call LiveTrackers previous next))
    (let value (call first-value property place type (. field layout) (. default site)))
    (call (. live-actions pop))
