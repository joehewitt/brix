      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (lazy mutable-owner (call is-mutable-value owner))
    (let held (. ([] (. tables layouts rows) held-layout) fields count))
    (let count (. ([] (. tables layouts rows) layout) fields count))
    (let position (. U32 max))
    (if extends
      (= position held)
      (else-if (!= plan .plan-truncate)
        (= position (call field-position lhs owner))
