(import ./emitter)
(import ./emitter.calls)
(import ./emitter.lazies)
(import ./emitter.live-actions)
(import ./emitter.loops)
(import ./emitter.match-arms)
(import ./emitter.styles)
(import ./emitter.tables)
(import ./emitter.tasks)
(import ./layouts)
(import ./program-tables)
(import ./receiver-stability)
(import ./runtime)
(import ./table-layouts)
(import /core/arena)
(import /core/table)
(import /lang/ast/ast)
(import /lang/ast/ast-children)
(import /lang/ast/ast-nodes)
(import /lang/ast/ast-queries)
(import /lang/ast/decl)
(import /lang/ast/module)
(import /lang/ast/operator)
(import /lang/ast/program)
(import /lang/ast/row-range)
(import /lang/ast/state-machines)
(import /lang/backend/mir)
(import /lang/check/binding)
(import /lang/check/claims)
(import /lang/check/facts)
(import /lang/check/instances)
(import /lang/check/machine-composite)
(import /lang/check/numeric)
(import /lang/check/pattern-helper)
(import /lang/check/probe-casts)
(import /lang/check/table-rows)
(import /lang/check/type-signature)
(import /lang/check/type-store)
(import /lang/check/type-text)
(import /lang/check/types)
(import /lang/ir/ir)
(import /stream/sort)

(type _ Assignments (facet-of FunctionEmitter)
  (sees Calls)
  (sees Lazies)
  (sees LiveActions)
  (sees Loops)
  (sees MatchArms)
  (sees Styles)
  (sees Tables)
  (sees Tasks)
  (fn-do _ clear-fills _
    ; Gives each lazy local of a constructor the flag that says whether it has been evaluated
    ; for the properties' first values, cleared here before the first of them.
    (for (in offset (..< 0 (. unit slot-count)))
      (if (!= (. ([] (. bindings slots) (+ (. unit slot-start) offset)) kind) .slot-lazy)
        (continue)
      )
      (let flag (call (. ir add-local) u8-layout))
      (= ([] (. unit fill-flags) offset) flag)
      (call store-local flag (call integer .machine-u8 0) 0)
    )
  )
  (fn-do _ clear-checks _
    ; Gives each property of the object being made that a value may first read on some of its paths
    ; alone the flag that says whether it has its first value, cleared here before the first of
    ; them, as the reference keeps one where such a read gives the property its value: so may a
    ; value given on some paths alone, which a flagged property's is. Where a read or its own turn
    ; finds the flag clear, the property is given its value (`check-property`). One whose value runs
    ; in a live action of its own has the trackers of the action made here, as the reference makes
    ; them, for whichever path gives it its value.
    (= filling (= (. filling checks) (call (of (. storage allocate) U32) (+ (. filling count) 1))))
    (= filling (= (. filling trackers) (call (of (. storage allocate) U32) (+ (. filling count) 1))))
    (for (in position (..< 0 (. filling count)))
      (= ([] (. filling checks) position) no-local)
      (= ([] (. filling trackers) position) no-local)
    )
    (let changed true)
    (while changed
      (= changed false)
      (for (in position (..< 0 (. filling count)))
        (let unit-id (call (. tables value-unit) (+ (. filling start) position)))
        (if (== unit-id no-instance)
          (continue)
        )
        (let read (call (. tables first-read) unit-id))
        (while (!= read no-fact)
          (let found (call property-read (. filling type) read))
          (let unsure
            (scope (or unsure-read (!= ([] (. filling checks) position) no-local))
              (lazy unsure-read (and (. ([] (. instances rows) unit-id) branches) (not (. ([] (. facts value-reads) read) surely))))
            )
          )
          (if (and found unsure)
            (let held (- (as found U32) (. filling start)))
            (if (and (< held (. filling count)) (== ([] (. filling checks) held) no-local))
              (let flag (call (. ir add-local) u8-layout))
              (= ([] (. filling checks) held) flag)
              (call store-local flag (call integer .machine-u8 0) 0)
              (= changed true)
            )
          )
          (= read (call (. tables next-read) read))
        )
      )
    )
    (for (in position (..< 0 (. filling count)))
      (let unit-id (call (. tables value-unit) (+ (. filling start) position)))
      (if (and (!= ([] (. filling checks) position) no-local) (!= unit-id no-instance) (. ([] (. instances rows) unit-id) is-live))
        (= ([] (. filling trackers) position) (call open-trackers 0))
      )
    )
  )
  (fn-do + store-named _
    (param id SyntaxId)
    (param place U32)
    (param value Typed)
    ; Stores what the name of a markup element holds in the property of that name of the
    ; object the function runs on, converted as the type pass recorded at the element for a
    ; value the property is given.
    (let stored (call convert id .reason-declaration value))
    (if (not (. unit has-self))
      (call refuse .refused-statement id)
      (return)
    )
    (call store-argument (. unit self) (. unit owner-type) place (. stored operand) (. stored type) id)
  )
  (fn-do + store-argument _
    (param object Operand)
    (param type TypeId)
    (param place U32)
    (param value Operand)
    (param given TypeId)
    (param site SyntaxId)
    ; Stores an argument of a markup element in the property of its parameter's name, as an
    ; assignment to the property stores a value of the property's type: a lazy property is
    ; marked as having its value.
    (let property ([] (. types properties) place))
    (let held (if-expr (call (. tables is-class) type) ([] (. tables layouts objects) type) no-layout))
    (let is-lazy (== (. property storage-kind) .storage-lazy))
    (if (or (== held no-layout) unstored (!= given (. property type)))
      (call refuse .refused-statement site)
      (return)
    )
    (lazy unstored (and (!= (. property storage-kind) .storage-eager) (not is-lazy)))
    (let field (call (. tables layouts field) held (+ object-header-fields (. property slot))))
    (let flag-offset U32 (. U32 max))
    (if is-lazy
      (if (not (call (. tables layouts is-struct) (. field layout)))
        (call refuse .refused-statement site)
        (return)
      )
      (let pair field)
      (let inner (call (. tables layouts field) (. pair layout) 0))
      (= flag-offset (+ (. pair offset) (. (call (. tables layouts field) (. pair layout) 1) offset)))
      (= field (call LayoutField (+ (. pair offset) (. inner offset)) (. inner layout)))
    )
    (call put-property object field property value site flag-offset false (call memo-flag-of type property))
  )
  (fn-do + store-part _
    (param id SyntaxId)
    (param name SyntaxId)
    (param slot SlotId)
    (param offset U32)
    (param part Operand)
    (param held TypeId)
    (param kept LayoutId)
    (param declares Bool)
    ; Stores a part of a value taken apart in the local a name gives it: in the environment that
    ; holds the local, or in its cell, which a declaration gives it unless it is a lazy one that
    ; keeps the cell it was first given.
    (if (== kept void-layout)
      (return)
    )
    (if (call is-captured slot)
      (if (== (. ([] (. bindings slots) slot) kind) .slot-lazy)
        (call refuse .refused-statement name)
        (return)
      )
      (call keep-captured slot part held id)
      (return)
    )
    (if (and declares (or (== ([] (. unit cells) offset) no-local) (!= (. ([] (. bindings slots) slot) kind) .slot-lazy)))
      (let taken (!= (/and/ (. ([] (. bindings slots) slot) flags) (. SlotFlag slot-address-taken)) 0))
      (= ([] (. unit cells) offset) (call (. ir add-local) kept taken))
    )
    (if (== ([] (. unit cells) offset) no-local)
      (call refuse .refused-statement name)
      (return)
    )
    (call store-local ([] (. unit cells) offset) part id)
  )
  (fn-do + store-part-global _
    (param name SyntaxId)
    (param kept U32)
    (param part Operand)
    (param type TypeId)
    ; Stores a part of a value taken apart in the global a name gives it, where the global has the
    ; part's type, as an assignment of the global does.
    (let global ([] (. tables storage) kept))
    (if (!= type (. global type))
      (call refuse .refused-conversion name)
      (return)
    )
    (call store-global global part name)
    (if (== (call (. tables global-kind) (. global module) (. global decl)) .global-lazy)
      (call store-release (call make-operand .operand-symbol (. global state)) 0 (call integer .machine-u8 1) name)
    )
  )
  (fn-do _ assigned-lazy SlotId
    (param name SyntaxId)
    ; The slot of a lazy local a name is assigned through, when a flag of this function says
    ; whether the local has its value.
    (let binding (. ([] (. instances rows) (. unit reading)) binding))
    (if (or (== binding no-binding) (!= (. unit reading) (. unit instance)))
      (return no-slot)
    )
    (match? ([] (. tree nodes) name)
      (case .node-identifier
        (let resolution (call (. bindings resolution-of) binding name))
        (if (or (!= (. resolution kind) .resolve-slot) (not (call is-own-slot (. resolution slot))))
          (return no-slot)
        )
        (if (!= (. ([] (. bindings slots) (. resolution slot)) kind) .slot-lazy)
          (return no-slot)
        )
        (if (!= ([] (. unit lazy-flags) (- (. resolution slot) (. unit slot-start))) no-local)
          (return (. resolution slot))
        )
      )
    )
    (return no-slot)
  )
  (fn-do + emit-assign Assignment (?! Refused)
    (param id SyntaxId)
    (param op Operator)
    (param lhs SyntaxId)
    (param rhs SyntaxId)
    ; Stores a value in a local or a global: the one written, or for an assigning operator what its
    ; operator gives for the place and the value, in the way the type pass planned it. The value takes
    ; the conversion recorded for the store, and the store answers it with the value given
    ; (`Assignment`). A lazy global assigned is marked as having its value, which is then never
    ; evaluated. An assigning operator that a function of its own name answers stores nothing, unless
    ; the type pass planned its answer to be stored. A field is assigned in its own way, and so are the
    ; locals a tuple is taken apart into, the flag of a domain of styles, and a name of an object that
    ; declares a style for it. A local of no size, as a `Void` is, keeps nothing: its value is evaluated
    ; and goes nowhere. An array stored over an array where the value or the place is a link of an
    ; optional chain has no shape here: the runtime is told of no replaced storage there. A store to a
    ; local some read tracks runs the actions that read it where its bits change, as `watches` says,
    ; those of a struct against a copy taken before the store: a lazy one only where it had its value,
    ; since no action can read it before.
    (let chains
      (scope (or chained-rhs (and (call is-link lhs) (not (call is-pinned (call receiver-of lhs)))))
        (lazy chained-rhs (and (call (. tree is-chained) rhs) (not (call is-pinned rhs))))
      )
    )
    (if (and chains (call (. facts is-replacing) (. unit reading) id))
      (call refuse .refused-statement id)
      (return (call Assignment))
    )
    (if (and (call (. tree is-chained) rhs) (not (call is-pinned rhs)))
      (call emit-withheld id op lhs rhs false)
      (return (call Assignment))
    )
    (if (and (call is-link lhs) (not (call is-pinned (call receiver-of lhs))))
      (call emit-chained-assign id op lhs rhs)
      (return (call Assignment))
    )
    (let answered (and (!= op .eq-op) (!= (call assigning-call lhs) no-fact)))
    (let plan (call (. facts plan-of) (. unit reading) id))
    (if (and answered (!= plan .plan-store-answer))
      (call emit-assigning-call id (call assigning-call lhs) lhs rhs)
      (return (call Assignment))
    )
    (match? ([] (. tree nodes) lhs)
      (case (call .node-style-read-expression row)
        (call emit-style-write id (. row object) rhs)
        (return (call Assignment))
      )
      (case (call .node-get-expression row)
        (let styled (call (. facts style-write-of) (. unit reading) id))
        (if styled
          (call emit-style-assign id (. row object) rhs styled)
          (return (call Assignment))
        )
        (if (== (call (. facts plan-of) (. unit reading) lhs) .plan-view)
          (return (call emit-view-field-assign id op lhs (. row object) rhs))
        )
        (if (== (call (. facts plan-of) (. unit reading) lhs) .plan-table)
          (return (call emit-table-field-assign id op lhs (. row object) rhs))
        )
        (return (call emit-field-assign id op lhs (. row object) rhs))
      )
      (case (call .node-index-expression row)
        (if (== (call (. facts plan-of) (. unit reading) lhs) .plan-view)
          (return (call emit-view-index-assign id op lhs (. row object) (. row index) rhs))
        )
        (if (== (call (. facts plan-of) (. unit reading) lhs) .plan-table)
          (if (!= op .eq-op)
            (call refuse .refused-statement id)
            (return (call Assignment))
          )
          (if (== (call table-op lhs) (. TableOp table-item-store))
            (call emit-table-item-store lhs (. row object) (. row index) rhs)
            (return (call Assignment))
          )
          (if (== (call table-op lhs) (. TableOp table-range-store))
            (call emit-table-range-store lhs (. row object) (. row index) rhs)
            (return (call Assignment))
          )
          (call emit-table-store lhs (. row object) (. row index) rhs)
          (return (call Assignment))
        )
        (if (== (call (. facts plan-of) (. unit reading) lhs) .plan-item)
          (return (call emit-item-assign id op lhs (. row object) (. row index) rhs))
        )
        (let stores (call own-call lhs))
        (if (and (== op .eq-op) (!= stores no-fact) (== (call (. facts plan-of) (. unit reading) lhs) .plan-array-item))
          (return (call emit-array-store lhs (. ([] (. facts calls) stores) callee) (. row object) (. row index) rhs))
        )
        (if (and (== op .eq-op) (!= stores no-fact) (!= (. ([] (. facts calls) stores) form) .call-setter))
          (return (call emit-index-store lhs ([] (. facts calls) stores) (. row object) (. row index) rhs))
        )
        (let reached (or (not (call chains-at lhs (. row is-optional))) (call is-pinned (. row object))))
        (if (and (!= op .eq-op) reached (== (call (. facts plan-of) (. unit reading) lhs) .plan-answer-item))
          (call emit-item-answer lhs (. row object) (. row index) rhs)
          (return (call Assignment))
        )
        (if (and (!= op .eq-op) reached (!= (call call-at lhs .call-operator) no-fact))
          (return (call emit-index-update lhs op (. row object) (. row index) rhs))
        )
        (return (call emit-field-assign id op lhs (. row object) rhs))
      )
      (case (call .node-tuple-syntax row)
        (if (== op .eq-op)
          (call emit-destructure id (. row items) rhs false)
          (return (call Assignment))
        )
      )
      (case .node-identifier
        (let styled (call (. facts style-write-of) (. unit reading) id))
        (if styled
          (call emit-style-assign id 0 rhs styled)
          (return (call Assignment))
        )
        (if (or (call is-own-field lhs) (call is-case-member lhs))
          (return (call emit-field-assign id op lhs 0 rhs))
        )
        (let setter (call own-call lhs))
        (if (and (!= setter no-fact) (== (. ([] (. facts calls) setter) form) .call-setter) (== op .eq-op))
          (call emit-module-setter lhs rhs ([] (. facts calls) setter))
          (return (call Assignment))
        )
        (if (and (!= op .eq-op) (!= (call call-at lhs .call-store-setter) no-fact))
          (return (call emit-setter-update id op lhs 0 rhs false))
        )
      )
    )
    (let kept (call assigned-global lhs id))
    (let local no-local)
    (let target no-type)
    (let memory (call make-operand .operand-void 0))
    (let shared no-slot)
    (let written no-local)
    (let watched no-slot)
    (if (== kept no-storage)
      (let slot (call assigned-lazy lhs))
      (if (== slot no-slot)
        (= slot (call local-slot lhs id true false true))
      )
      (let offset (call slot-offset slot id))
      (if (call watches slot id)
        (= watched slot)
      )
      (if (call is-captured slot)
        (= shared slot)
        (= target (. (call find-captured slot id) type))
        (else
          (= target (call (. facts slot-type) (. unit instance) offset))
          (if (!= ([] (. unit lazy-flags) offset) no-local)
            (= written ([] (. unit lazy-flags) offset))
            (if (and (== ([] (. unit cells) offset) no-local) (!= target no-type) (!= target invalid-type))
              (let taken (!= (/and/ (. ([] (. bindings slots) slot) flags) (. SlotFlag slot-address-taken)) 0))
              (= ([] (. unit cells) offset) (call (. ir add-local) (call layout-of target id) taken))
            )
          )
          (= local ([] (. unit cells) offset))
          (if (and (== local no-local) (!= (call layout-of target id) void-layout))
            (= memory (call argument-memory slot target id))
          )
        )
      )
      (else
        (= target (. ([] (. tables storage) kept) type))
      )
    )
    (let given (call Typed (call make-operand .operand-void 0) no-type))
    (let base (call increment-base op))
    (if (== op .eq-op)
      (= given (call emit-expression rhs))
      (else-if answered
        (= given (call emit-assigning-call id (call assigning-call lhs) lhs rhs))
      )
      (else-if (and base (== base .concat-op))
        (= given (call emit-concat id lhs rhs false))
      )
      (else-if (and base (== plan .plan-builtin))
        (= given (call emit-builtin id base lhs rhs true))
      )
      (else-if (and base (== plan .plan-call))
        (= given (call emit-operator-call id lhs rhs .plan-call true))
      )
      (else
        (call refuse .refused-statement id)
      )
    )
    (let converted (call convert id .reason-assignment given))
    (let value (. converted operand))
    (if (!= (. converted type) target)
      (call refuse .refused-conversion id)
      (return (call Assignment))
    )
    (let assignment (call Assignment converted given))
    (if (call (. facts is-replacing) (. unit reading) id)
      (let old memory)
      (if (!= shared no-slot)
        (= old (. (call read-captured shared id target) operand))
        (else-if (!= kept no-storage)
          (= old (. (call load-global ([] (. tables storage) kept) id) operand))
        )
        (else-if (!= local no-local)
          (= old (call load-local local id))
        )
      )
      (call replace-storage id old target (. given operand) (. given type))
    )
    (let prior (call make-operand .operand-void 0))
    (let armed (call make-operand .operand-void 0))
    (if (!= watched no-slot)
      (if (and (== local no-local) (== shared no-slot))
        (call refuse .refused-statement id)
        (return (call Assignment))
      )
      (= prior
        (block
          (case? (!= shared no-slot)
            (. (call read-captured shared id target) operand)
          )
          (default
            (call load-local local id)
          )
        )
      )
      (let held (call layout-of target id))
      (if (call (. tables layouts is-struct) held)
        (let saved (call frame held))
        (call copy saved prior held false id)
        (= prior saved)
      )
      (if (!= written no-local)
        (= armed (call load-local written id))
      )
    )
    (if (!= shared no-slot)
      (if (and (call fills-share) (not (. filling storing)) (== (. ([] (. bindings slots) shared) kind) .slot-lazy))
        (call refuse .refused-statement id)
        (return (call Assignment))
      )
      (call keep-captured shared value target id)
      (if (and (== (. ([] (. bindings slots) shared) kind) .slot-lazy) (not (call task-holds shared)))
        (call settle-shared shared id)
      )
      (if (!= watched no-slot)
        (call dispatch-local watched prior (. (call read-captured shared id target) operand) target id)
      )
      (return assignment)
    )
    (if (and (== kept no-storage) (== local no-local))
      (if (!= (call layout-of target id) void-layout)
        (call copy memory value (call layout-of target id) false id)
      )
      (return assignment)
    )
    (if (== kept no-storage)
      (call store-local local value id)
      (if (!= written no-local)
        (call store-local written (call integer .machine-u8 1) id)
      )
      (if (!= watched no-slot)
        (call dispatch-local watched prior (call load-local local id) target id armed)
      )
      (return assignment)
    )
    (let global ([] (. tables storage) kept))
    (call store-global global value id)
    (if (== (call (. tables global-kind) (. global module) (. global decl)) .global-lazy)
      (call store-release (call make-operand .operand-symbol (. global state)) 0 (call integer .machine-u8 1) id)
    )
    (return assignment)
  )
  (fn-do + assigned-global U32
    (param lhs SyntaxId)
    (param id SyntaxId)
    ; The storage of the global an assignment names, or none when it names something else. A
    ; global with no storage has no shape here.
    (let binding (. ([] (. instances rows) (. unit reading)) binding))
    (if (== binding no-binding)
      (return no-storage)
    )
    (match? ([] (. tree nodes) lhs)
      (case .node-identifier
        (let resolution (call (. bindings resolution-of) binding lhs))
        (if (== (. resolution kind) .resolve-global)
          (let row (call (. tables storage-of) (. resolution module) (. resolution decl)))
          (if (== row no-storage)
            (call refuse .refused-statement id)
          )
          (return row)
        )
      )
    )
    (return no-storage)
  )
  (fn-do _ assigning-call FactId
    (param lhs SyntaxId)
    ; The call of an assigning operator that a function of its own name answers, which the type
    ; pass records as an operator's call at the place assigned. No fact when the operator is not
    ; such a one.
    (match? ([] (. tree nodes) lhs)
      (case .node-index-expression
        (return no-fact)
      )
    )
    (let fact (call own-call lhs))
    (if (or (== fact no-fact) (!= (. ([] (. facts calls) fact) form) .call-operator))
      (return no-fact)
    )
    (return fact)
  )
  (fn-do _ emit-assigning-call Typed
    (param id SyntaxId)
    (param fact FactId)
    (param lhs SyntaxId)
    (param rhs SyntaxId)
    ; An assigning operator that a function of its own name answers: the function is called on
    ; what the place holds with the value. A struct or a tuple is given as the place itself, so the
    ; function reads what the place holds when it is called, after the value is evaluated; a
    ; number or an object is read before. Nothing is stored here: where the type pass planned the
    ; answer to be stored, the assignment that called for it stores it.
    (let nothing (call make-operand .operand-void 0))
    (let left (call emit-expression lhs))
    (let left-type (. left type))
    (let right (call emit-expression rhs))
    (let right-type (. right type))
    (return (call call-operator id fact lhs (. left operand) left-type rhs (. right operand) right-type))
  )
  (fn-do _ emit-field-assign Assignment
    (param id SyntaxId)
    (param op Operator)
    (param lhs SyntaxId)
    (param object SyntaxId)
    (param rhs SyntaxId)
    ; An assignment to a field. A struct's field is stored in place: at its address inside the
    ; local, or inside the field, that holds the struct, or inside the receiver when no object is
    ; written. A tuple's field is stored only by its own constructor, which is making it: any
    ; other assignment gives a new tuple, which a statement drops. A property of an object is
    ; assigned in its own way. A store into a struct that an object holds has no shape yet when
    ; it writes a managed pointer. The value is evaluated before the object, as TypeScript does. An assigning operator whose answer
    ; the type pass planned to be stored stores it as any value, and has no shape in a tuple's
    ; field. A value named alone that a getter answers has no shape here unless it is an object. A
    ; struct that lies in storage, as `places-item` finds it, is stored where it lies, a managed
    ; pointer through the write barrier, as TypeScript stores once it has inlined what reads it;
    ; any other struct an index answered by a function gave has no shape here, since TypeScript
    ; stores into a copy of it. A field of the case of a row a name stands for is written in its
    ; cell, and so is one named alone in a member that runs on the case.
    (let cursor (if-expr (!= object 0) (call case-cursor-of object) this-cursor))
    (if (!= cursor (. U32 max))
      (let named (call (. tree member-name) lhs))
      (let field (only-if (call case-field cursor named) (if named)))
      (if (not field)
        (call refuse .refused-statement id)
        (return (call Assignment))
      )
      (return (call emit-case-field-assign id op lhs cursor field rhs))
    )
    (if (and (!= object 0) (call is-getter-name object) (not (call (. tables is-class) (call held-type object))))
      (call refuse .refused-statement id)
      (return (call Assignment))
    )
    (if (== (call (. facts plan-of) (. unit reading) lhs) .plan-forward)
      (call emit-forward-set id op lhs object rhs)
      (return (call Assignment))
    )
    (if (and (!= op .eq-op) (!= (call call-at lhs .call-store-setter) no-fact))
      (return (call emit-setter-update id op lhs object rhs true))
    )
    (let owner (if-expr (== object 0) (. unit owner-type) (call held-type object)))
    (if (and (!= owner no-type) (!= owner invalid-type) (call (. tables is-class) owner))
      (return (call emit-property-assign id op lhs object rhs owner))
    )
    (let setter (call own-call lhs))
    (if (and (!= setter no-fact) (== (. ([] (. facts calls) setter) form) .call-setter) (== op .eq-op))
      (call emit-setter lhs object rhs ([] (. facts calls) setter))
      (return (call Assignment))
    )
    (if (or (== owner no-type) (== owner invalid-type) (not (call is-stored owner object)))
      (if (== (call (. facts plan-of) (. unit reading) id) .plan-store-answer)
        (call refuse .refused-statement id)
        (return (call Assignment))
      )
      (call emit-update id op lhs rhs)
      (return (call Assignment))
    )
    (let placed (and (!= object 0) (call places-item object)))
    (if (and (!= object 0) (not placed) (call through-answer object))
      (call refuse .refused-statement id)
      (return (call Assignment))
    )
    (let layout (call layout-of owner id))
    (let position (call field-position lhs owner))
    (if (or (not (call (. tables layouts is-struct) layout)) (>= position (. ([] (. tables layouts rows) layout) fields count)))
      (call refuse .refused-statement id)
      (return (call Assignment))
    )
    (if (and managed-field (not (call is-framed object)) (not placed))
      (call refuse .refused-statement id)
      (return (call Assignment))
    )
    (lazy managed-field (. ([] (. tables layouts rows) (. (call (. tables layouts field) layout position) layout)) is-managed))
    (let given (call Typed (call make-operand .operand-void 0) no-type))
    (let increment (call increment-base op))
    (let site id)
    (match? ([] (. tree nodes) lhs)
      (case .node-index-expression
        (= site lhs)
      )
    )
    (let stores-answer (== (call (. facts plan-of) (. unit reading) site) .plan-store-answer))
    (if (== op .eq-op)
      (let made (call emit-expression rhs))
      (= given (call Typed (call apart made rhs (and (!= object 0) (not (call is-inert object)))) (. made type)))
      (else-if (and stores-answer (!= (call assigning-call lhs) no-fact) (or (== object 0) (call is-place object)))
        (= given (call emit-assigning-call site (call assigning-call lhs) lhs rhs))
      )
      (else-if (and increment builtin-plan (or (== object 0) (call is-place object) placed))
        (= given (call emit-builtin site increment lhs rhs true))
      )
      (else
        (call refuse .refused-statement id)
      )
    )
    (lazy builtin-plan (== (call (. facts plan-of) (. unit reading) site) .plan-builtin))
    (let converted (call convert site .reason-assignment given))
    (let value (. converted operand))
    (if (!= (. converted type) (call field-type owner position))
      (call refuse .refused-conversion id)
      (return (call Assignment))
    )
    (let assignment (call Assignment converted given))
    (let base
      (block
        (case? (== object 0)
          (. unit self)
        )
        (case? placed
          (. (call place-of object) operand)
        )
        (default
          (. (call emit-expression object) operand)
        )
      )
    )
    (if (call (. facts is-replacing) (. unit reading) id)
      (call replace-storage
        (block
          (arg id)
          (arg (call take base (call (. tables layouts field) layout position) id))
          (arg (call field-type owner position))
          (arg (. given operand))
          (arg (. given type))
        )
      )
    )
    (if placed
      (call put-lent base (call (. tables layouts field) layout position) value id)
      (else
        (call put base (call (. tables layouts field) layout position) value id)
      )
    )
    (return assignment)
  )
  (fn-do _ is-getter-name Bool
    (param id SyntaxId)
    ; Whether an expression is a name alone that a getter answers.
    (match? ([] (. tree nodes) id)
      (case .node-identifier
        (return (call reads-getter id))
      )
    )
    (return false)
  )
  (fn-do _ emit-property-assign Assignment
    (param id SyntaxId)
    (param op Operator)
    (param lhs SyntaxId)
    (param object SyntaxId)
    (param rhs SyntaxId)
    (param owner TypeId)
    (param received Bool (= false))
    ; An assignment to a property of an object: of the value written before the property's
    ; name, or of the receiver when none is, or where the name alone is `received`, of the markup
    ; element `received-object` finds. A setter is called with the value. A stored
    ; property is stored at its place in the object: a managed pointer through the write
    ; barrier, and a struct by a copy. A lazy property is stored the same way and marked as
    ; having its value, which is then never evaluated. The value is evaluated before the object,
    ; as TypeScript does. An assigning operator reads the property first and then stores it, so
    ; its object is read twice. A tracked property runs the actions that read it where the store changed it.
    (let name (call (. tree member-name) lhs))
    (let setter (call own-call lhs))
    (if (and (!= setter no-fact) (== (. ([] (. facts calls) setter) form) .call-setter) (== op .eq-op))
      (call emit-setter lhs object rhs ([] (. facts calls) setter))
      (return (call Assignment))
    )
    (let found (only-if (call property-of owner name) (if name)))
    (let held ([] (. tables layouts objects) owner))
    (if (or (not found) (== held no-layout))
      (call refuse .refused-statement id)
      (return (call Assignment))
    )
    (let property ([] (. types properties) found))
    (let is-lazy (== (. property storage-kind) .storage-lazy))
    (if (and (!= (. property storage-kind) .storage-eager) (not is-lazy))
      (call refuse .refused-statement id)
      (return (call Assignment))
    )
    (let field (call (. tables layouts field) held (+ object-header-fields (. property slot))))
    (let flag-offset U32)
    (if is-lazy
      (if (not (call (. tables layouts is-struct) (. field layout)))
        (call refuse .refused-statement id)
        (return (call Assignment))
      )
      (let pair field)
      (let inner (call (. tables layouts field) (. pair layout) 0))
      (= flag-offset (+ (. pair offset) (. (call (. tables layouts field) (. pair layout) 1) offset)))
      (= field (call LayoutField (+ (. pair offset) (. inner offset)) (. inner layout)))
    )
    (if (and (== op .eq-op) (== object 0) (not received) (not is-lazy))
      (let updated (call emit-own-update id lhs rhs owner property field))
      (if updated
        (return updated)
      )
    )
    (let given (call Typed (call make-operand .operand-void 0) no-type))
    (let increment (call increment-base op))
    (let plan (call (. facts plan-of) (. unit reading) id))
    (if (== op .eq-op)
      (let made (call emit-expression rhs))
      (= given (call Typed (call apart made rhs (and (!= object 0) (not (call is-inert object)))) (. made type)))
      (else-if (== plan .plan-store-answer)
        (= given (call emit-assigning-call id (call assigning-call lhs) lhs rhs))
      )
      (else-if increment
        (if (== increment .concat-op)
          (= given (call emit-concat id lhs rhs false))
          (else-if (== plan .plan-builtin)
            (= given (call emit-builtin id increment lhs rhs true))
          )
          (else-if (== plan .plan-call)
            (= given (call emit-operator-call id lhs rhs .plan-call true))
          )
          (else
            (call refuse .refused-statement id)
          )
        )
      )
      (else
        (call refuse .refused-statement id)
      )
    )
    (let converted (call convert id .reason-assignment given))
    (let value (. converted operand))
    (if (!= (. converted type) (. property type))
      (call refuse .refused-conversion id)
      (return (call Assignment))
    )
    (let assignment (call Assignment converted given))
    (let base
      (block
        (case? received
          (. (call received-object lhs (!! name)) operand)
        )
        (case? (== object 0)
          (. unit self)
        )
        (default
          (. (call emit-expression object) operand)
        )
      )
    )
    (if (call (. facts is-replacing) (. unit reading) id)
      (if is-lazy
        (call refuse .refused-statement id)
        (return (call Assignment))
      )
      (call replace-storage id (call take base field id) (. property type) (. given operand) (. given type))
    )
    (call put-property
      (block
        (arg base)
        (arg field)
        (arg property)
        (arg value)
        (arg id)
        (arg (if-expr is-lazy flag-offset (. U32 max)))
        (arg false)
        (arg (call memo-flag-of owner property))
      )
    )
    (return assignment)
  )
  (fn-do _ emit-own-update (? Assignment)
    (param id SyntaxId)
    (param lhs SyntaxId)
    (param rhs SyntaxId)
    (param owner TypeId)
    (param property TypeProperty)
    (param field LayoutField)
    ; An assignment to a field of the receiver that holds a tuple, of that tuple with one of its
    ; own fields assigned, as `frame = frame.depth = 2` is: the one field is stored where it lies
    ; inside the receiver, since the tuple stored would differ from the old one only there. The
    ; assignment gives the tuple as it then lies. Nothing is emitted where the assignment is other
    ; than that, or where the field stores more than its bits: one some read tracks, a memo, or
    ; storage the assignment replaces.
    (let named (call (. tree member-name) lhs))
    (if (or (not named) (not (call (. tables layouts is-struct) (. field layout))) (call tracks property))
      (return null)
    )
    (if (or (!= (call memo-flag-of owner property) (. U32 max)) (call (. facts is-replacing) (. unit reading) id))
      (return null)
    )
    (if (or (call (. facts is-replacing) (. unit reading) rhs) (call (. tables live-statement-of) (. unit reading) rhs))
      (return null)
    )
    (if (!= (call (. facts node-type) (. unit reading) rhs) (. property type))
      (return null)
    )
    (let target SyntaxId 0)
    (let value SyntaxId 0)
    (match? ([] (. tree nodes) rhs)
      (case (call .node-assign row)
        (if (and (== (. row op) .eq-op) (not (call (. tree is-chained) (. row rhs))))
          (= target (. row lhs))
          (= value (. row rhs))
        )
      )
    )
    (return-if null (if (== target 0)))
    (blank)
    (let object SyntaxId 0)
    (let member (? Atom) null)
    (match? ([] (. tree nodes) target)
      (case (call .node-get-expression row)
        (if (not (. row is-optional))
          (= object (. row object))
          (= member (. row name))
        )
      )
    )
    (return-if null (if (or (== object 0) (not member))))
    (blank)
    (let same false)
    (match? ([] (. tree nodes) object)
      (case (call .node-identifier row)
        (= same (and (== (. row name) named) (call is-own-field object)))
      )
    )
    (let plan (call (. facts plan-of) (. unit reading) rhs))
    (if (or (not same) (== plan .plan-extend) (== plan .plan-truncate) (call stores-place target))
      (return null)
    )
    (let found (call property-of (. property type) member))
    (if (or (not found) (!= (. ([] (. types properties) found) storage-kind) .storage-eager))
      (return null)
    )
    (let position (. ([] (. types properties) found) slot))
    (if (>= position (. ([] (. tables layouts rows) (. field layout)) fields count))
      (return null)
    )
    (let converted (call convert rhs .reason-assignment (call emit-expression value)))
    (if (!= (. converted type) (call field-type (. property type) position))
      (call refuse .refused-conversion rhs)
      (return (call Assignment))
    )
    (let base (call field-value (. unit self) field id))
    (call put-lent base (call (. tables layouts field) (. field layout) position) (. converted operand) id)
    (let stored (call Typed base (. property type)))
    (return (call Assignment stored stored))
  )
  (fn-do _ emit-setter-update Assignment
    (param id SyntaxId)
    (param op Operator)
    (param lhs SyntaxId)
    (param object SyntaxId)
    (param rhs SyntaxId)
    (param is-member Bool)
    ; An assigning operator on a property, of an object or of a module, that a getter and a setter
    ; answer: the getter reads the value, the machine operation of numbers, the join of text or the
    ; function that answers the operator makes the new value of it and the value written, and the
    ; setter stores that, as the reference does. The reference evaluates the object for the read and
    ; again for the store, so only an object that names storage has a shape here, read once before
    ; the value for both calls.
    (let read (call call-at lhs .call-getter))
    (let store (call call-at lhs .call-store-setter))
    (let increment (call increment-base op))
    (let plan (call (. facts plan-of) (. unit reading) id))
    (if (or (== read no-fact) (== store no-fact) (not increment) other-plan unplaced)
      (call refuse .refused-statement id)
      (return (call Assignment))
    )
    (lazy other-plan (and (!= increment .concat-op) (!= plan .plan-builtin) (!= plan .plan-call)))
    (lazy unplaced (and (!= object 0) (not (call is-place object))))
    (let getter (. ([] (. facts calls) read) callee))
    (let setter (. ([] (. facts calls) store) callee))
    (if (or (== getter no-instance) (== setter no-instance) partial-call uncallable)
      (call refuse .refused-statement id)
      (return (call Assignment))
    )
    (lazy partial-call (or (. ([] (. facts calls) read) is-partial) (. ([] (. facts calls) store) is-partial)))
    (lazy uncallable (or (not (call is-callable getter)) (not (call is-callable setter))))
    (if (or (!= (. ([] (. instances signatures) getter) args count) 0) (!= (. ([] (. instances signatures) setter) args count) 1))
      (call refuse .refused-statement id)
      (return (call Assignment))
    )
    (let receiver (call make-operand .operand-void 0))
    (if is-member
      (let received (call emit-receiver lhs object true))
      (= receiver (. received operand))
      (if (or (!= (. received type) (. ([] (. instances rows) getter) self-type)) other-setter)
        (call refuse .refused-conversion lhs)
      )
      (lazy other-setter (!= (. received type) (. ([] (. instances rows) setter) self-type)))
    )
    (let read-mark (. pending length))
    (if is-member
      (+= pending receiver)
    )
    (let current
      (block
        (case? is-member
          (call call-method getter lhs read-mark)
        )
        (default
          (call call-instance getter lhs read-mark)
        )
      )
    )
    (let current-type (. current type))
    (let value current)
    (if (== increment .concat-op)
      (= value (call join-text id lhs (. current operand) current-type rhs false))
      (else-if (== plan .plan-builtin)
        (= value (call combine-builtin id increment lhs (. current operand) current-type rhs true))
      )
      (else
        (let combined (call answering (call (. facts first-call) (. unit reading) id)))
        (if (or (== combined no-fact) (!= (call answering (. ([] (. facts calls) combined) next)) no-fact))
          (call refuse .refused-statement id)
          (return (call Assignment))
        )
        (let given (call emit-expression rhs))
        (let given-type (. given type))
        (= value
          (call call-operator
            (block
              (arg id)
              (arg combined)
              (arg lhs)
              (arg (. current operand))
              (arg current-type)
              (arg rhs)
              (arg (. given operand))
              (arg given-type)
            )
          )
        )
      )
    )
    (let computed value)
    (= value (call convert id .reason-assignment value))
    (= value (call convert lhs .reason-argument value))
    (if (!= (. value type) (call (. instances argument-type) setter 0))
      (call refuse .refused-conversion id)
      (return (call Assignment))
    )
    (let assignment (call Assignment value computed))
    (let mark (. pending length))
    (if is-member
      (+= pending receiver)
    )
    (+= pending (. value operand))
    (if is-member
      (call call-method setter lhs mark)
      (else
        (call call-instance setter lhs mark)
      )
    )
    (return assignment)
  )
  (fn-do _ emit-module-setter _
    (param lhs SyntaxId)
    (param rhs SyntaxId)
    (param fact CallFact)
    (let callee (. fact callee))
    (if (or (== callee no-instance) (. fact is-partial) (not (call is-callable callee)))
      (call refuse .refused-statement lhs)
      (return)
    )
    (if (!= (. ([] (. instances signatures) callee) args count) 1)
      (call refuse .refused-statement lhs)
      (return)
    )
    (let value (call convert rhs .reason-argument (call emit-expression rhs)))
    (if (!= (. value type) (call (. instances argument-type) callee 0))
      (call refuse .refused-conversion rhs)
      (return)
    )
    (let mark (. pending length))
    (+= pending (. value operand))
    (call call-instance callee lhs mark)
  )
  (fn-do _ field-position U32
    (param lhs SyntaxId)
    (param owner TypeId)
    ; Which stored field the left side of an assignment names: by a constant index the type pass
    ; recorded, or by the name of a property the type stores.
    (match? ([] (. tree nodes) lhs)
      (case .node-index-expression
        (let place (call indexed-field lhs))
        (if (!= place no-fact)
          (return (as (. ([] (. facts constants) place) bits) U32))
        )
      )
      (case (call .node-get-expression row)
        (let found (call property-of owner (. row name)))
        (if (and found (== (. ([] (. types properties) found) storage-kind) .storage-eager))
          (return (. ([] (. types properties) found) slot))
        )
      )
      (case (call .node-identifier row)
        (let found (call property-of owner (. row name)))
        (if (and found (== (. ([] (. types properties) found) storage-kind) .storage-eager))
          (return (. ([] (. types properties) found) slot))
        )
      )
    )
    (call refuse .refused-statement lhs)
    (return 0)
  )
  (fn-expr _ is-case-member Bool
    (param name SyntaxId)
    ; Whether a name is a member of the receiver, in a member that runs on the case of a row.
    (case? (or (== binding no-binding) (!= (. unit reading) (. unit instance)) (== this-cursor (. U32 max)))
      false
    )
    (default
      (== (. (call (. bindings resolution-of) binding name) kind) .resolve-member)
    )
    (where
      (lazy binding (. ([] (. instances rows) (. unit reading)) binding))
    )
  )
  (fn-expr + is-stored Bool
    (param owner TypeId)
    (param object SyntaxId)
    ; Whether an assignment to a field of a type stores it in place: a struct's, or that of the
    ; tuple a constructor is making, written by its name alone.
    (or (call is-mutable-value owner) (and (== object 0) builds (== (call intrinsic owner) .tuple)))
  )
  (fn-do _ through-answer Bool
    (param id SyntaxId)
    ; Whether a struct is read from what an index answered by a function gave, itself or as a
    ; field of it. A store into it would change a value nothing names. A property of an object
    ; is stored in the object, wherever the object came from.
    (match? ([] (. tree nodes) id)
      (case (call .node-get-expression row)
        (let owner (call (. facts node-type) (. unit reading) (. row object)))
        (if (or (== owner no-type) (== owner invalid-type) (call (. tables is-class) owner))
          (return false)
        )
        (return (call through-answer (. row object)))
      )
      (case (call .node-index-expression row)
        (if (not (call names-field id))
          (return true)
        )
        (return (call through-answer (. row object)))
      )
    )
    (return false)
  )
  (fn-do _ stores-place Bool
    (param lhs SyntaxId)
    ; Whether an assignment stores into the place it names: a name that is no field, a field
    ; of an object or of a struct, or an item of a text, which is stored whole. A tuple's field
    ; is not one: assigning it gives a new tuple. A field of a row of a table or of an array, and
    ; one of the case of a row a name stands for, is one, kept in its cell.
    (let owner no-type)
    (let indexes false)
    (match? ([] (. tree nodes) lhs)
      (case .node-identifier
        (if (not (call is-own-field lhs))
          (return true)
        )
        (= owner (. unit owner-type))
      )
      (case (call .node-get-expression row)
        (let plan (call (. facts plan-of) (. unit reading) lhs))
        (if (or (!= (call case-cursor-of (. row object)) (. U32 max)) (== plan .plan-view) (== plan .plan-table))
          (return true)
        )
        (= owner (call (. facts node-type) (. unit reading) (. row object)))
      )
      (case (call .node-index-expression row)
        (= owner (call (. facts node-type) (. unit reading) (. row object)))
        (= indexes true)
      )
    )
    (if (or (== owner no-type) (== owner invalid-type))
      (return false)
    )
    (return (or (call (. tables is-class) owner) (call is-mutable-value owner) (and indexes (== (call intrinsic owner) .string))))
  )
  (fn-do _ stores-by-call Bool
    (param lhs SyntaxId)
    ; Whether an index is assigned through the function that answers `[]=`, which stores the value
    ; wherever the object keeps it.
    (match? ([] (. tree nodes) lhs)
      (case .node-index-expression
        (if (== (call (. facts plan-of) (. unit reading) lhs) .plan-item)
          (return false)
        )
        (let stores (call own-call lhs))
        (return (and (!= stores no-fact) (!= (. ([] (. facts calls) stores) form) .call-setter)))
      )
    )
    (return false)
  )
  (fn-do + emit-update Typed (?! Refused)
    (param id SyntaxId)
    (param op Operator)
    (param lhs SyntaxId)
    (param rhs SyntaxId)
    ; What an assignment gives as a value. An assigning operator that a function answers gives
    ; what the function answers; where the type pass planned the answer to be stored it is stored
    ; first, and the value is the one stored, when storing it changed its type in no way. An
    ; assignment that stores into the place it names gives the value stored, as a copy when it
    ; is a struct, or the value as it was before the store converted it: whichever is of the
    ; type the type pass gave the assignment.
    ; An assignment to a tuple's field gives a new tuple: its fields are those of
    ; the old one, but for the one assigned, which an assigning operator gives from the field's
    ; value. An extension adds a field, and a truncation keeps
    ; the first. The old tuple is evaluated after the value assigned, as TypeScript evaluates it,
    ; and that value is kept apart from what evaluating it may change. A live statement has no
    ; shape here as a value.
    (let nothing (call make-operand .operand-void 0))
    (let type (call (. facts node-type) (. unit reading) id))
    (let plan (call (. facts plan-of) (. unit reading) id))
    (if (call (. tables live-statement-of) (. unit reading) id)
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (if (and (call (. tree is-chained) rhs) (not (call is-pinned rhs)) (call (. facts is-replacing) (. unit reading) id))
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (if (and (call (. tree is-chained) rhs) (not (call is-pinned rhs)))
      (return (call emit-withheld id op lhs rhs true))
    )
    (if (call is-link lhs)
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (if (and (!= op .eq-op) (== plan .plan-store-answer))
      (let assignment (call emit-assign id op lhs rhs))
      (if (!= (. assignment stored type) type)
        (call refuse .refused-conversion id)
        (return (call Typed nothing no-type))
      )
      (return (. assignment stored))
    )
    (if (and (!= op .eq-op) (!= (call assigning-call lhs) no-fact))
      (let answer (call emit-assigning-call id (call assigning-call lhs) lhs rhs))
      (if (!= (. answer type) type)
        (call refuse .refused-conversion id)
      )
      (return answer)
    )
    (if (and (!= plan .plan-extend) (!= plan .plan-truncate) places-store)
      (let assignment (call emit-assign id op lhs rhs))
      (let unconverted (and (!= (. assignment stored type) type) (== (. assignment given type) type)))
      (let gives (if-expr unconverted (. assignment given) (. assignment stored)))
      (if (!= (. gives type) type)
        (call refuse .refused-conversion id)
        (return (call Typed nothing no-type))
      )
      (let stored (call layout-of type id))
      (return
        (block
          (case? (call (. tables layouts is-struct) stored)
            (call Typed (call snapshot (. gives operand) stored id) type)
          )
          (default
            gives
          )
        )
      )
    )
    (lazy places-store (or (call stores-place lhs) (and (== op .eq-op) (call stores-by-call lhs))))
    (let extends (and (== plan .plan-extend) (== op .add-eq-op)))
    (let object lhs)
    (if (not extends)
      (match? ([] (. tree nodes) lhs)
        (case (call .node-get-expression row)
          (= object (. row object))
        )
        (case (call .node-index-expression row)
          (= object (. row object))
