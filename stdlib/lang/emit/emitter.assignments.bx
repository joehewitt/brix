      )
      (call unpin known)
      (return plain)
    )
    (let named
      (match ([] (. tree nodes) lhs)
        (case .node-identifier
          true
        )
        (default
          false
        )
      )
    )
    (let kept-type (call (. facts node-type) (. unit reading) lhs))
    (if (and (== op .eq-op) named optional-kept)
      (call refuse .refused-statement id)
      (return (call Typed nothing no-type))
    )
    (lazy optional-kept (or (== kept-type no-type) (== kept-type invalid-type) (call (. types is-optional) kept-type)))
    (let layout (if-expr wanted (call layout-of type id) void-layout))
    (let tested (call present written given))
    (let filled (call (. ir reserve-block)))
    (let empty (call (. ir reserve-block)))
    (let joined (call (. ir reserve-block)))
    (let slot (if-expr wanted (call join-slot layout) nothing))
    (let mark (. joins length))
    (call branch (. tested operand) filled empty)
    (call (. ir start-block) filled)
