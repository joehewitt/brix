        (else-if (!= (. ([] (. facts fills) fill) argument) (. U32 max))
          (call store-given field property (. ([] (. facts fills) fill) argument) syntax)
        )
        (else
          (call store-fill (. unit self) field property place (. filling type) ([] (. facts fills) fill) syntax)
        )
      )
      (else-if (== (. property storage-kind) .storage-lazy)
        (let fill (call (. tables fill-of) (. unit instance) (. property name)))
        (if (and (!= fill no-fact) (!= (. ([] (. facts fills) fill) argument) (. U32 max)))
          (let pair
            (call (. tables layouts field)
              (block
                (arg ([] (. tables layouts objects) (. filling type)))
                (arg (+ object-header-fields (. property slot)))
              )
            )
          )
          (if (not (call (. tables layouts is-struct) (. pair layout)))
            (call refuse .refused-function syntax)
            (else
              (let inner (call (. tables layouts field) (. pair layout) 0))
              (call store-given
                (block
                  (arg (call LayoutField (+ (. pair offset) (. inner offset)) (. inner layout)))
                  (arg property)
                  (arg (. ([] (. facts fills) fill) argument))
                  (arg syntax)
