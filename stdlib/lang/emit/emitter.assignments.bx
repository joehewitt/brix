      (call refuse .refused-function syntax)
      (return)
    )
    (if (== (. ([] (. bindings slots) (. fact slot)) kind) .slot-lazy)
      (let held (call (. facts slot-type) (. unit instance) (call slot-offset (. fact slot) syntax)))
      (let value (call read-lazy-local (. fact slot) syntax held))
      (if (!= (. field layout) void-layout)
