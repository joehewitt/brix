      (if (or (>= index held) (!= (call field-type type index) (call field-type owner index)))
        (call refuse .refused-conversion id)
        (return (call Typed nothing no-type))
      )
      (call put made field (call take (. source operand) (call (. tables layouts field) held-layout index) id) id)
    )
    (return (call Typed made type))
  )
  (fn-do + emit-probe-assign _
    (param id SyntaxId)
    (param row ASTProbeAssign)
    ; The assignment of a property a probe makes writes an event of the key and the value, of the
    ; object it is written of where it has one, through the calls the type pass recorded at it.
