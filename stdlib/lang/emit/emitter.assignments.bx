    (= filling (= (. filling type) type))
    (= filling (= (. filling start) (. range start)))
    (= filling (= (. filling count) (. range count)))
    (= filling (= (. filling filled) (call (of (. storage allocate) Byte) (+ (. range count) 1))))
    (for (in position (..< 0 (. range count)))
      (let property ([] (. types properties) (+ (. range start) position)))
      (let refills
        (scope (and (!= (. property storage-kind) .storage-getter) has-fill)
          (lazy has-fill (!= (call (. tables fill-of) (. unit instance) (. property name)) no-fact))
        )
      )
      (= ([] (. filling filled) position) (if-expr refills 0 2))
    )
