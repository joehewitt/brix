    )
    (if (== ([] (. filling filled) position) 2)
      (return)
    )
    (if (== ([] (. filling filled) position) 1)
      (call refuse .refused-expression syntax)
      (return)
    )
    (= ([] (. filling filled) position) 1)
    (let place (+ (. filling start) position))
    (let property ([] (. types properties) place))
    (if (== (. property storage-kind) .storage-eager)
      (let object ([] (. tables layouts objects) (. filling type)))
      (let field (call (. tables layouts field) object (+ object-header-fields (. property slot))))
      (let fill (call (. tables fill-of) (. unit instance) (. property name)))
