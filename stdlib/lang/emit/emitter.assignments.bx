    (let given (call (. instances argument-type) (. unit instance) position))
    (let argument (call make-operand .operand-argument (if-expr (. unit takes-self) (+ position 1) position)))
    (if (not (call (. types is-optional) given))
      (call store-converted object field property (. fact site) (call Typed argument given) syntax)
      (return)
