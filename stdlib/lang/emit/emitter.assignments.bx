          (let is-lazy (== (. ([] (. types properties) (+ (. range start) position)) storage-kind) .storage-lazy))
          (= ([] (. filling filled) position) (if-expr is-lazy 3 0))
          (= changed true)
        )
      )
    )
    (call clear-fills)
    (call clear-checks)
    (= filling (= (. filling storing) true))
    (for (in position (..< 0 (. range count)))
      (if (or (== ([] (. filling filled) position) 0) (== ([] (. filling filled) position) 4))
        (call store-property position declared)
      )
    )
    (= filling (= (. filling storing) false))
    (= filling (= (. filling count) 0))
  )
  (fn-do _ reads-refilled Bool
    (param type TypeId)
    (param place U32)
    ; Whether the value a class writes for a stored or lazy property reads a property that is
    ; being stored again, or a lazy one that is stale, as the type pass recorded what the value
    ; reads: by a name the binder resolved to a member, or after the receiver. A value no
    ; instance typed may read any.
    (if (== (. ([] (. types properties) place) storage-kind) .storage-getter)
      (return false)
    )
    (if (== (. (call (. tables default-of) type place) value) 0)
      (return false)
    )
    (let unit-id (call (. tables value-unit) place))
    (if (== unit-id no-instance)
      (return true)
    )
    (let read (call (. tables first-read) unit-id))
    (while (!= read no-fact)
      (let found (call property-read type read))
      (if (and found (!= ([] (. filling filled) (- (as found U32) (. filling start))) 2))
        (return true)
      )
      (= read (call (. tables next-read) read))
    )
    (return false)
  )
  (fn-do + store-properties _
    (param type TypeId)
    (param declared SyntaxId)
    ; Gives each stored property of the object being made its first value, in the order the
    ; properties are declared, base first. `filled` says which have theirs: a value that reads
    ; a property gives that one its value first. The live actions of the values that read
    ; something tracked are made once all have theirs.
    (let range (. ([] (. types completions) type) properties))
    (= filling (= (. filling type) type))
    (= filling (= (. filling start) (. range start)))
    (= filling (= (. filling count) (. range count)))
    (= filling (= (. filling filled) (call (of (. storage allocate) Byte) (+ (. range count) 1))))
    (for (in position (..< 0 (. range count)))
      (= ([] (. filling filled) position) 0)
    )
    (call clear-fills)
    (call clear-checks)
    (= filling (= (. filling storing) true))
    (for (in position (..< 0 (. range count)))
      (call store-property position declared)
    )
    (= filling (= (. filling storing) false))
    (call subscribe-values declared)
    (= filling (= (. filling count) 0))
  )
  (fn-do + store-property _
    (param position U32)
    (param syntax SyntaxId)
