      (return (call Assignment))
    )
    (let stores-back (== (call (. facts plan-of) (. unit reading) site) .plan-store-answer))
    (if (or (== owner no-type) (and (call is-numeric-type owner) (not stores-back)))
      (call refuse .refused-statement site)
      (return (call Assignment))
    )
    (if (and (not stores-back) (== answers owner) (not (call (. tables is-class) owner)))
      (call refuse .refused-statement site)
      (return (call Assignment))
    )
    (match? ([] (. tree nodes) object)
      (case (call .node-index-expression row)
        (if (not (call (. tables is-class) owner))
          (let outer (call stored-through object))
          (if (or (not stores-back) (!= answers owner) (== outer no-fact) chained)
            (call refuse .refused-statement site)
            (return (call Assignment))
          )
          (lazy chained (call chains-at object (. row is-optional)))
          (return (call emit-store-through site fact ([] (. facts calls) outer) object index rhs))
        )
      )
    )
    (if (and stores-back (or (!= answers owner) (not (call is-place object)) retyped))
      (call refuse .refused-statement site)
      (return (call Assignment))
    )
    (lazy retyped (!= (call (. facts node-type) (. unit reading) object) owner))
    (let emitted (call emit-expression rhs))
    (let value (call apart emitted rhs (or (not (call is-inert object)) (not (call is-inert index)))))
    (let given (. emitted type))
    (let pin-mark (. pins length))
    (if stores-back
      (call pin-holder object)
    )
    (let receiver (call convert object .reason-receiver (call emit-expression object)))
    (let receiver-type (. receiver type))
    (let key receiver)
    (let key-type no-type)
    (= key (call convert index .reason-argument (call emit-expression index)))
    (= key-type (. key type))
    (let stored (call convert rhs .reason-argument (call Typed value given)))
    (if (!= receiver-type owner)
      (call refuse .refused-conversion object)
    )
    (if (!= key-type (call (. instances argument-type) callee 0))
      (call refuse .refused-conversion index)
    )
    (if (!= (. stored type) (call (. instances argument-type) callee 1))
      (call refuse .refused-conversion rhs)
    )
    (let answer stored)
    (let replaced (call call-at site .call-replaced))
    (if (!= replaced no-fact)
      (let read-mark (. pending length))
      (+= pending (. receiver operand))
      (+= pending (. key operand))
      (let old (call call-method (. ([] (. facts calls) replaced) callee) site read-mark))
      (let old-type (. old type))
      (if (call is-array-type old-type)
        (call replace-storage site (. old operand) old-type value given)
      )
    )
    (let mark (. pending length))
    (+= pending (. receiver operand))
    (+= pending (. key operand))
    (+= pending (. stored operand))
    (= answer (call call-method callee site mark))
    (if stores-back
      (call store-place object (. answer operand) owner site)
    )
    (call unpin pin-mark)
    (if (!= answers (. types void-type))
      (let answered (call Typed (. answer operand) answers))
      (return (call Assignment answered answered))
    )
    (return (call Assignment (call Typed (. stored operand) (call (. instances argument-type) callee 1)) (call Typed value given)))
  )
  (fn-do _ emit-index-update Assignment
    (param site SyntaxId)
    (param op Operator)
    (param object SyntaxId)
    (param index SyntaxId)
    (param rhs SyntaxId)
    ; An index given a value an assigning operator makes from the one it holds: the function that
    ; answers `[]` reads the item, the machine operation of numbers, or the function that answers
    ; the operator the assignment applies, makes the new value of it and the value written, and the
    ; function that answers `[]=` stores that, as the reference does.
    ; The reference evaluates the object and the key for the read and again for the store, so only
    ; an object that names storage has a shape here, read once, and only where `[]=` stores in
    ; place: on an object, or on a value it does not answer anew. A key that changes nothing is read
    ; once too; another is evaluated again for the store where it can be.
    (let read (call call-at site .call-operator))
    (let store (call next-operator read))
    (let plan (call (. facts plan-of) (. unit reading) site))
    (let combined no-fact)
    (if (== plan .plan-call)
      (= combined store)
      (= store (call next-operator combined))
    )
    (let increment (call increment-base op))
    (let inert (call is-inert index))
    (if (or (== store no-fact) (not increment) (== increment .concat-op) other-plan unrepeatable)
      (call refuse .refused-statement site)
      (return (call Assignment))
    )
    (lazy other-plan (and (!= plan .plan-builtin) (!= plan .plan-call)))
    (lazy unrepeatable (or (not (call is-place object)) (and (not inert) (not (call is-repeatable index)))))
    (let getter (. ([] (. facts calls) read) callee))
    (let setter (. ([] (. facts calls) store) callee))
    (if (or (== getter no-instance) (== setter no-instance) partial-call uncallable)
      (call refuse .refused-statement site)
      (return (call Assignment))
    )
    (lazy partial-call (or (. ([] (. facts calls) read) is-partial) (. ([] (. facts calls) store) is-partial)))
    (lazy uncallable (or (not (call is-callable getter)) (not (call is-callable setter))))
    (let owner (. ([] (. instances rows) setter) self-type))
    (if (or (== owner no-type) returns-owner (not getter-fills) (not setter-fills))
      (call refuse .refused-statement site)
      (return (call Assignment))
    )
    (lazy returns-owner (and (not (call (. tables is-class) owner)) (== (. ([] (. instances signatures) setter) returns) owner)))
    (lazy getter-fills (call fills-in-order ([] (. facts calls) read) getter 1))
    (lazy setter-fills (call fills-in-order ([] (. facts calls) store) setter 2))
    (let receiver (call convert object .reason-receiver (call emit-expression object)))
    (let receiver-type (. receiver type))
    (let key receiver)
    (let key-type no-type)
    (= key (call convert index .reason-argument (call emit-expression index) 0 true))
    (= key-type (. key type))
    (if (or (!= receiver-type owner) (!= (. ([] (. instances rows) getter) self-type) owner))
      (call refuse .refused-conversion object)
      (return (call Assignment))
    )
    (if (or (!= key-type (call (. instances argument-type) getter 0)) (!= key-type (call (. instances argument-type) setter 0)))
      (call refuse .refused-conversion index)
      (return (call Assignment))
    )
    (let read-mark (. pending length))
    (+= pending (. receiver operand))
    (+= pending (. key operand))
    (let current (call call-method getter site read-mark))
    (let current-type (. current type))
    (let value current)
    (if (== combined no-fact)
      (= value (call combine-builtin site increment site (. current operand) current-type rhs true))
      (else
        (let given (call emit-expression rhs))
        (let given-type (. given type))
        (= value
          (call call-operator
            (block
              (arg site)
              (arg combined)
              (arg site)
              (arg (. current operand))
              (arg current-type)
              (arg rhs)
              (arg (. given operand))
              (arg given-type)
            )
          )
        )
      )
    )
    (let computed value)
    (= value (call convert site .reason-assignment value))
    (if (!= (. value type) (call (. instances argument-type) setter 1))
      (call refuse .refused-conversion site)
      (return (call Assignment))
    )
    (let assignment (call Assignment value computed))
    (if (not inert)
      (= key (call convert index .reason-argument (call emit-expression index) 0 true))
      (if (!= (. key type) key-type)
        (call refuse .refused-conversion index)
        (return (call Assignment))
      )
    )
    (let mark (. pending length))
    (+= pending (. receiver operand))
    (+= pending (. key operand))
    (+= pending (. value operand))
    (call call-method setter site mark)
    (return assignment)
  )
  (fn-do _ next-operator FactId
    (param fact FactId)
    ; The call of an operator recorded at a node after the one given, or none.
    (let next (if-expr (!= fact no-fact) (. ([] (. facts calls) fact) next) no-fact))
    (while (and (!= next no-fact) (!= (. ([] (. facts calls) next) form) .call-operator))
      (= next (. ([] (. facts calls) next) next))
    )
    (return next)
  )
  (fn-do _ emit-item-answer _
    (param site SyntaxId)
    (param object SyntaxId)
    (param index SyntaxId)
    (param rhs SyntaxId)
    ; An assigning operator on an item that a function of its own name answers, where the item holds
    ; no struct or tuple: the item is read by the function that answers `[]`, the value is evaluated,
    ; and the function is called on the item with it, as the reference compiles it for an object.
    ; Nothing is stored.
    (let read (call call-at site .call-operator))
    (let answer (call next-operator read))
    (if (== answer no-fact)
      (call refuse .refused-statement site)
      (return)
    )
    (let item (call emit-index-call site ([] (. facts calls) read) object index))
    (let item-type (. item type))
    (let given (call emit-expression rhs))
    (let given-type (. given type))
    (call call-operator site answer site (. item operand) item-type rhs (. given operand) given-type)
  )
  (fn-do _ is-repeatable Bool
    (param id SyntaxId)
    ; Whether an operand can be emitted again where the reference evaluates it again: a literal, a
    ; name, or a read, a call, a cast or an operation of such operands, none of which makes a function.
    (match? ([] (. tree nodes) id)
      (case (call .node-argument named)
        (return (call is-repeatable (. named expr)))
      )
      (case (call .node-cast-expression row)
        (return (call is-repeatable (. row lhs)))
      )
      (case (call .node-binary-expression row)
        (return (and (call is-repeatable (. row lhs)) (call is-repeatable (. row rhs))))
      )
      (case (call .node-unary-expression row)
        (return (call is-repeatable (. row operand)))
      )
      (case (call .node-get-expression row)
        (return (or (== (. row object) 0) (call is-repeatable (. row object))))
      )
      (case (call .node-index-expression row)
        (return (and (call is-repeatable (. row object)) (call is-repeatable (. row index))))
      )
      (case (call .node-call-expression row)
        (for (in argument ([] (. tree children) (. row args)))
          (if (not (call is-repeatable argument))
            (return false)
          )
        )
        (return (call is-repeatable (. row callable)))
      )
      (case .node-integer-syntax
        (return true)
      )
      (case .node-float-syntax
        (return true)
      )
      (case .node-string-syntax
        (return true)
      )
      (case .node-identifier
        (return true)
      )
    )
    (return false)
  )
  (fn-do _ stored-through FactId
    (param id SyntaxId)
    ; The call recorded at an inner index of the function that stores what `[]=` answered for
    ; the item the index gave. No fact where the type pass recorded none.
    (let fact (call (. facts first-call) (. unit reading) id))
    (while (!= fact no-fact)
      (if (== (. ([] (. facts calls) fact) form) .call-store-through)
        (return fact)
      )
      (= fact (. ([] (. facts calls) fact) next))
    )
    (return no-fact)
  )
  (fn-do _ emit-store-through Assignment
    (param site SyntaxId)
    (param fact CallFact)
    (param outer CallFact)
    (param held SyntaxId)
    (param index SyntaxId)
    (param rhs SyntaxId)
    ; An index of an index assigned, where the inner index gives a struct or a number and the
    ; type pass planned what `[]=` answers for it to be stored. In TypeScript's order:
    ; 1. The value is evaluated, and then the object the inner index reads from and its key,
    ;    once each. A struct among them is copied, since the calls that follow may change the
    ;    storage it was read from.
    ; 2. The item is read with the inner index's own function, or as TypeScript reads an item of
    ;    an array of numbers, where the type pass planned it so.
    ; 3. The key is evaluated, and `[]=` is called on the item.
    ; 4. What it answers is stored with the `[]=` of the object, under the same key.
    ; The value of the assignment is the value written. An object held by value whose `[]=`
    ; answers one of its own type would have that stored in turn, which has no shape yet.
    (let callee (. fact callee))
    (let owner (. ([] (. instances rows) callee) self-type))
    (let reads (call own-call held))
    (let stores (. outer callee))
    (let object 0u32)
    (let key-syntax 0u32)
    (match? ([] (. tree nodes) held)
      (case (call .node-index-expression row)
        (= object (. row object))
        (= key-syntax (. row index))
      )
    )
    (if (or (== reads no-fact) (== stores no-instance) (== object 0) (call names-slot object .slot-super))
      (call refuse .refused-statement site)
      (return (call Assignment))
    )
    (let read ([] (. facts calls) reads))
    (let reader (. read callee))
    (if (or (!= (. read form) .call-operator) (. read is-partial) (. outer is-partial) (== reader no-instance))
      (call refuse .refused-statement site)
      (return (call Assignment))
    )
    (if (or (== ([] (. tables instance-functions) reader) no-function) no-stores-function)
      (call refuse .refused-statement site)
      (return (call Assignment))
    )
    (lazy no-stores-function (== ([] (. tables instance-functions) stores) no-function))
    (if (or (not (call fills-in-order read reader 1)) (not (call fills-in-order outer stores 2)))
      (call refuse .refused-statement site)
      (return (call Assignment))
    )
    (let holder (. ([] (. instances rows) stores) self-type))
    (let keyed (call (. instances argument-type) reader 0))
    (if (!= (. ([] (. instances rows) reader) self-type) holder)
      (call refuse .refused-statement site)
      (return (call Assignment))
    )
    (if (or (!= (call (. instances argument-type) stores 0) keyed) (!= (call (. instances argument-type) stores 1) owner))
      (call refuse .refused-statement site)
      (return (call Assignment))
    )
    (if (and (== (. ([] (. instances signatures) stores) returns) holder) (not (call (. tables is-class) holder)))
      (call refuse .refused-statement site)
      (return (call Assignment))
    )
    (let emitted (call emit-expression rhs))
    (let value (call apart emitted rhs true))
    (let given (. emitted type))
    (let container (call convert object .reason-receiver (call emit-expression object)))
    (if (!= (. container type) holder)
      (call refuse .refused-conversion object)
      (return (call Assignment))
    )
    (= container (call Typed (call apart container object true) (. container type)))
    (let key (call convert key-syntax .reason-argument (call emit-expression key-syntax)))
    (if (!= (. key type) keyed)
      (call refuse .refused-conversion key-syntax)
      (return (call Assignment))
    )
    (= key (call Typed (call apart key key-syntax true) (. key type)))
    (let read-item (call Typed (call make-operand .operand-void 0) no-type))
    (if (== (call (. facts plan-of) (. unit reading) held) .plan-array-item)
      (= read-item (call array-item held reader (. container operand) holder (. key operand) keyed))
      (else
        (let mark (. pending length))
        (+= pending (. container operand))
        (+= pending (. key operand))
        (= read-item (call call-method reader held mark))
      )
    )
    (let item (call convert held .reason-receiver read-item))
    (if (!= (. item type) owner)
      (call refuse .refused-conversion held)
      (return (call Assignment))
    )
    (= item (call Typed (call apart item held (not (call is-inert index))) (. item type)))
    (let place (call convert index .reason-argument (call emit-expression index)))
    (let place-type (. place type))
    (let stored (call convert rhs .reason-argument (call Typed value given)))
    (if (!= place-type (call (. instances argument-type) callee 0))
      (call refuse .refused-conversion index)
      (return (call Assignment))
    )
    (if (!= (. stored type) (call (. instances argument-type) callee 1))
      (call refuse .refused-conversion rhs)
      (return (call Assignment))
    )
    (let store-mark (. pending length))
    (+= pending (. item operand))
    (+= pending (. place operand))
    (+= pending (. stored operand))
    (let answer (call call-method callee site store-mark))
    (if (!= (. answer type) owner)
      (call refuse .refused-conversion site)
      (return (call Assignment))
    )
    (let back-mark (. pending length))
    (+= pending (. container operand))
    (+= pending (. key operand))
    (+= pending (. answer operand))
    (call call-method stores held back-mark)
    (return (call Assignment (call Typed (. stored operand) (call (. instances argument-type) callee 1)) (call Typed value given)))
  )
  (fn-do + store-place _
    (param place SyntaxId)
    (param value Operand)
    (param type TypeId)
    (param site SyntaxId)
    ; Stores a value in the storage an expression names, which holds the value's type: a local,
    ; an argument that is a struct, a local or an argument nested functions capture, in the
    ; environment that holds it, a global, a field or a property of the receiver named alone, or a
    ; stored field or property of what such an expression names. The object of a property is the
    ; one kept when the place was read, where one was kept.
    (let layout (call layout-of type site))
    (match? ([] (. tree nodes) place)
      (case (call .node-identifier row)
        (if (call is-own-field place)
          (let owner (. unit owner-type))
          (let found (call property-of owner (. row name)))
          (if (or (not found) (call reads-getter place))
            (call refuse .refused-statement site)
            (return)
          )
          (call store-held (. unit self) 0 owner found value type site)
          (return)
        )
        (let kept (call assigned-global place site))
        (if (!= kept no-storage)
          (let global ([] (. tables storage) kept))
          (if (or (!= (. global type) type) (== (call (. tables global-kind) (. global module) (. global decl)) .global-lazy))
            (call refuse .refused-statement site)
            (return)
          )
          (call store-global global value site)
          (return)
        )
        (let slot (call local-slot place site true))
        (if (call is-captured slot)
          (if (== (. ([] (. bindings slots) slot) kind) .slot-lazy)
            (call refuse .refused-statement site)
            (return)
          )
          (call keep-captured slot value type site)
          (return)
        )
        (let offset (call slot-offset slot site))
        (if (!= (call (. facts slot-type) (. unit instance) offset) type)
          (call refuse .refused-statement site)
          (return)
        )
        (if (!= ([] (. unit cells) offset) no-local)
          (call store-local ([] (. unit cells) offset) value site)
          (return)
        )
        (let memory (call argument-memory slot type site))
        (call copy memory value layout false site)
        (return)
      )
      (case (call .node-get-expression row)
        (let owner (call (. facts node-type) (. unit reading) (. row object)))
        (let known (and (!= owner no-type) (!= owner invalid-type)))
        (let found (only-if (call property-of owner (. row name)) (if known)))
        (if (or (not found) (call reads-getter place))
          (call refuse .refused-statement site)
          (return)
        )
        (let base (call emit-expression (. row object)))
        (call store-held (. base operand) (. row object) owner found value type site)
        (return)
      )
    )
    (call refuse .refused-statement site)
  )
  (fn-do + restore-stacks _
    (param callee InstanceId)
    (param saved (list LocalId))
    (param site SyntaxId)
    ; After such a call each slot set before it is put back as it was.
    (if (== (. saved length) 0)
      (return)
    )
    (let rows (call (. tables stack-needs) callee))
    (for (in index (..< 0 (. saved length)))
      (if (!= ([] saved index) no-local)
        (let kept ([] (. tables storage) ([] rows index)))
        (call copy
          (block
            (arg (call stack-slot kept site))
            (arg (call load-local ([] saved index) site))
            (arg (. kept layout))
            (arg (. ([] (. tables layouts rows) (. kept layout)) is-managed))
            (arg site)
          )
        )
      )
    )
  )
  (fn-do _ put-lent _
    (param target Operand)
    (param field LayoutField)
    (param value Operand)
    (param syntax SyntaxId)
    ; Stores a value at a field of a struct that lies in storage, which may be an object: a managed
    ; pointer written goes through the write barrier.
    (if (call (. tables layouts is-struct) (. field layout))
      (call store-struct target field value syntax)
      (else-if (!= (. field layout) void-layout)
        (call store target (. field offset) value (call is-managed-pointer (. field layout)) syntax)
      )
    )
  )
)
