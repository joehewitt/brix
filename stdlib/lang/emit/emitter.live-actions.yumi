            refuse(.refused-statement, statement)
rerunning = false
live-actions.pop()
emit-end(declared)

────────────────────
+ do reruns-in Bool
    - owner InstanceId

` Whether the function being emitted runs again a statement the instance given writes.
if instances.rows[unit.instance].enclosing != owner
    = false
do match? program.modules[instances.rows[unit.instance].module].decls[instances.rows[unit.instance].decl]
    | .decl-function(fn)
        = fn.kind == .live-decl
= false

────────────────────
_ do store-again
    - statement SyntaxId
    - kept SyntaxId
    - name Atom
    - rhs SyntaxId

` An attribute of a markup element, or an argument given by position, given again, as the
` reference's `prop-` function gives it: its value, converted as where it is written, is
` stored in the property of `name` of the element's object, kept at `kept` where the element
` was made, as an assignment to the property stores it.
. slot = channel-slot(kept)
if slot == no-slot
    refuse(.refused-statement, statement)
    =
. found = find-captured(slot, statement)
. type = found.type
. place = types.property-named(type, name)
. held = if tables.is-class(type) then tables.layouts.objects[type] else no-layout
if !place || held == no-layout
    refuse(.refused-statement, statement)
    =
. property = types.properties[place]
if property.storage-kind != .storage-eager
    refuse(.refused-statement, statement)
    =
. value = convert(statement, .reason-assignment, emit-expression(rhs))
if value.type != property.type
    refuse(.refused-conversion, statement)
    =
. object = read-captured(slot, statement, type)
put-property
    - object.operand
    - tables.layouts.field(held, object-header-fields + property.slot)
    - property
    - value.operand
    - statement
    - U32.max
    - false
    - memo-flag-of(type, property)

────────────────────
_ do store-back
    - anchor SyntaxId
    - statement SyntaxId

` A binding's element given again to its place, as its property changes: the property is read
` from the element's object, kept where the element was made, in the action's trackers, and
` stored in the place as an assignment to it stores. Where the type pass recorded a conversion
` back, the value stored is given back to the element, which then shows what the place holds.
. slot = channel-slot(statement)
. name = tree.identifier-name(anchor)
if slot == no-slot || !name
    refuse(.refused-statement, statement)
    =
. type = find-captured(slot, anchor).type
. place = types.property-named(type, name)
. held = if tables.is-class(type) then tables.layouts.objects[type] else no-layout
if !place || held == no-layout || types.properties[place].storage-kind != .storage-eager
    refuse(.refused-statement, statement)
    =
. property = types.properties[place]
. object = read-captured(slot, anchor, type)
track(anchor, object.operand, name)
. read = load-property(anchor, object.operand, type, name, true)
. tracking = live-actions.pop()
. unwraps = types.is-optional(read.type) && facts.node-type(unit.reading, anchor) == types.optional-inner(read.type)
. onward = if unwraps then ir.reserve-block() else no-block
if unwraps
    . filled = ir.reserve-block()
    branch(present(anchor, read).operand, filled, onward)
    ir.start-block(filled)
. value = if unwraps then payload(anchor, read) else read
. mark = pins.length
pin(anchor, value.operand, value.type)
do match? tree.nodes[statement]
    | .node-assign(row)
        . assignment = emit-assign(anchor, .eq-op, row.rhs, anchor)
        unpin(mark)
        if !unwraps && assignment.stored.type != no-type && assignment.stored.type != property.type
            . back = convert(statement, .reason-assignment, assignment.stored)
