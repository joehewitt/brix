                    - object.operand
                    - tables.layouts.field(held, object-header-fields + property.slot)
                    - property
                    - back.operand
                    - statement
                    - U32.max
                    - false
                    - memo-flag-of(type, property)
if unwraps
    jump(onward)
    ir.start-block(onward)
live-actions += tracking

────────────────────
_ do set-again
    - statement SyntaxId
    - target SyntaxId
    - rhs SyntaxId
    - callee InstanceId

. slot = channel-slot(statement)
if slot == no-slot || callee == no-instance || !is-callable(callee) || other-arity
    refuse(.refused-statement, statement)
    =
.. other-arity = instances.signatures[callee].args.count != 1
. type = find-captured(slot, statement).type
. given = convert(rhs, .reason-argument, emit-expression(rhs))
if given.type != instances.argument-type(callee, 0)
    refuse(.refused-conversion, statement)
    =
. object = read-captured(slot, statement, type)
. receiver = convert(target, .reason-receiver, Typed(object.operand, type))
if receiver.type != instances.rows[callee].self-type
    refuse(.refused-conversion, statement)
    =
. mark = pending.length
pending += receiver.operand
pending += given.operand
call-method(callee, target, mark)

────────────────────
_ do replaces Bool
    - statement SyntaxId

` Whether a line of a markup element's body that a live action gives again replaces what the
` element took, rather than being absorbed again.
. slot = line-keeper(statement)
if slot == no-slot
    = false
. found = find-captured(slot + 1, statement)
= found.type != types.void-type

────────────────────
_ do replace-again
    - statement SyntaxId

` A line of a markup element's body given again in place of what the element took before, as
` the reference's replacer gives it: the element's object and what it took, kept where the
` element was made, are read, and the line's value is made the node a markup host's
` `markup-content` makes of it, which the markup runtime's `markup-replace` puts in place of the
` one before, or is given with the one before to the element's `replace`, whose answer, where it
` gives one, is kept in place of the value. What was taken before is closed, by its `close` or
` by closing each action it owns, and what is kept now is kept in its place.
. nothing = make-operand(.operand-void, 0)
. slot = line-keeper(statement)
. link = facts.content-link-of(unit.reading, statement)
if slot == no-slot || link == U32.max
    refuse(.refused-statement, statement)
    =
. row = facts.content-links[link]
. kept-slot = (slot + 1) as SlotId
. held = find-captured(slot, statement)
. object = read-captured(slot, statement, held.type)
. earlier = find-captured(kept-slot, statement)
. previous = read-captured(kept-slot, statement, earlier.type)
content-hosts += Typed(object.operand, held.type)
. value = emit-expression(statement)
content-hosts.pop()
. kept = value
. kept-type = kept.type
if row.append != no-instance
    . given = convert(statement, .reason-argument, Typed(value.operand, kept.type))
    if given.type != row.taken
        refuse(.refused-conversion, statement)
    kept = call-protocol(statement, row.call, object.operand, row.parent, given.operand, row.taken, false)
    kept-type = kept.type
    . mark = pending.length
    pending += object.operand
    pending += previous.operand
    pending += kept.operand
    do call-instance(row.append, statement, mark)
else
    . answer = call-protocol
        - statement
        - row.call
        - object.operand
        - row.parent
        - previous.operand
        - earlier.type
        - false
        - value.operand
        - kept-type
    if answer.type != types.void-type
        kept = answer
        kept-type = kept.type
if row.close != no-fact
    do call-protocol(statement, row.close, previous.operand, earlier.type, nothing)
else
    close-actions(statement, previous.operand)
keep-captured(kept-slot, kept.operand, kept-type, statement)

────────────────────
_ do absorb-again
    - statement SyntaxId

` A line of a markup element's body that gives content, given the element again, as the
` reference's absorber gives it: the element's object, kept at the line where the element was
` made, is the element being built while the line runs as content, as the type pass typed it.
. slot = line-keeper(statement)
. link = facts.content-link-of(unit.reading, statement)
if slot == no-slot || link == U32.max
    refuse(.refused-statement, statement)
    =
. found = find-captured(slot, statement)
. object = read-captured(slot, statement, found.type)
content-hosts += Typed(object.operand, found.type)
emit-content(statement, facts.content-links[link])
content-hosts.pop()

────────────────────
_ do declare-again
    - statement SyntaxId
    - left SyntaxId
    - right SyntaxId

` A lazy declaration run again, as the reference's `var` function runs it: its value is
` evaluated and stored in the local it declares, held by the environment of the function that
` declares it, which then has its value; the store runs the actions that read the local where
` its bits change, as an assignment's does. One that holds a struct has no shape here where a
` read tracks it.
. slot = declared-slot(statement)
if slot == no-slot || !is-captured(slot)
    refuse(.refused-statement, statement)
    =
. field = find-captured(slot, statement)
. value = declared-value(left, 0, right, field.type)
. watched = watches(slot, statement)
if watched && tables.layouts.is-struct(field.layout)
    refuse(.refused-statement, statement)
. prior = if watched then read-captured(slot, statement, field.type).operand else no-prior
    .. no-prior = make-operand(.operand-void, 0)
keep-captured(slot, value.operand, field.type, statement)
settle-shared(slot, statement)
if watched
    dispatch-local(slot, prior, read-captured(slot, statement, field.type).operand, field.type, statement)

────────────────────
_ do declared-slot SlotId
    - statement SyntaxId

` The lazy local a declaration declares, of those the function's binding holds, or none.
for offset in 0 .. < unit.slot-count
    . row = bindings.slots[unit.slot-start + offset]
    if row.kind == .slot-lazy && row.group == statement
        = unit.slot-start + offset
= no-slot

────────────────────
+ do run-class-rules
    - type TypeId
    - site SyntaxId

` Runs each rule of the class of the object a constructor has made, and of the classes above
` it, base first, once the constructor's body has run, as the reference runs them: each in a
` live action of its own whose trackers note what it reads, which is then the object's. What
` the rule keeps for the object is made here, holding the object, and is the data of the
` action's callback, which runs the rule again. A rule is read through the facts of the
` instance that types it, and a local it declares has no shape here. A section the event
` runtime runs from the table of the class is not subscribed. A state machine a property holds
` starts among them (see `start-member-machine`). The queries of the markup the
` object is in that each class declares are registered once its rules have run, and then its
` style defaults are declared (see `register-queries`, `apply-style-defaults`).
. chain [TypeId]
. level TypeId? = type
while level && tables.is-class(level)
    chain += level
    level = types.base-of(level)
. next U32
for index in tables.class-rules-of(type)
    . rule = tables.class-rules[index]
    while next < chain.length && chain[chain.length - 1 - next] != rule.level
        register-queries(chain[chain.length - 1 - next])
        apply-style-defaults(chain[chain.length - 1 - next])
        next += 1
    if next == chain.length
        refuse(.refused-function, site)
        break
    if program.modules[rule.module].tree.nodes[rule.syntax] is .node-state-machine
        start-member-machine(type, rule, site)
        continue
    run-class-rule(rule, facts.lowers(type, rule.module, section-of(rule)), site)
while next < chain.length
    register-queries(chain[chain.length - 1 - next])
    apply-style-defaults(chain[chain.length - 1 - next])
    next += 1

────────────────────
_ do start-member-machine
    - type TypeId
    - rule ClassRule
    - site SyntaxId

` Starts a state machine a property of the object's class holds, as the reference starts it
` once the constructor's body has run: through the facts of the instance that types the
` property's value for the object's class. The machine keeps its value in the property. Where
` the class refines the machine of its base's property, the machine it refines starts with it
` (`start-refined`), and not by a rule of its own.
. name = decl-name(rule.module, rule.decl)
. found = property-of(type, name) if name
. unit-id = if found then tables.value-unit(found as U32) else no-instance
if unit-id == no-instance
    refuse(.refused-function, site)
    =
. started = unit-machine(unit-id)
if started && started.refined != no-instance
    if started.module == rule.module && started.syntax == rule.syntax
        start-refined(started)
    =
. own-unit = unit
. own-filling = filling
unit = unit.source-module = rule.module
unit = unit.reading = unit-id
filling = filling.root = rule.syntax
do emit-expression(rule.syntax)
unit = own-unit
filling = own-filling

────────────────────
_ do register-queries
    - level TypeId

` The registrations a constructor makes once the rules of a class of its object have run, as
