━━━━━━━━━━━━━━━━━━━━
_ LiveActions is facet of FunctionEmitter
    sees Assignments
    sees Lazies
    sees Loops
    sees Markup
    sees StateMachines
    sees Styles

────────────────────
+ do bind-cells
    - site SyntaxId
    - subject Operand

` Binds the state cells made at a site of this instance, in the order made (`bind-cell`): at a
` markup element once its object is made, or, for none, in the function that fills an object
` with its class's markup before the markup runs.
for index in 0 .. < facts.scope-cells.length
    . held = facts.scope-cells[index]
    if held.instance == unit.reading && held.site == site
        bind-cell(index as U32, subject)

────────────────────
+ do make-cells
    - site SyntaxId

` Makes the state cells of a site of this instance, as the reference's
` `createStyleScopeState` does, each kept in a local of its own (`state-cells`).
for index in 0 .. < facts.scope-cells.length
    . held = facts.scope-cells[index]
    if held.instance != unit.reading || held.site != site
        continue
    . own-unit = unit
    unit = unit.source-module = held.module
    . local = ir.add-local(managed-layout)
    store-local
        - local
        - call-instance(facts.style-runtime.scope-state, held.when, pending.length).operand
        - held.when
    state-cells += StateCell(index as U32, local)
    unit = own-unit

────────────────────
+ do take-cells
    - declared SyntaxId

` Keeps the state cells the function that fills an object with its class's markup is given, each
` in a local of its own (`state-cells`).
for index in 0 .. < facts.scope-cells.length
    . held = facts.scope-cells[index]
    if held.instance != unit.reading || held.argument == U32.max
        continue
    . place = instances.value-argument(unit.instance, held.argument)
    . local = ir.add-local(managed-layout)
    store-local
        - local
        - make-operand(.operand-argument, if unit.takes-self then place + 1 else place)
        - declared
    state-cells += StateCell(index as U32, local)

────────────────────
+ do keep-cells
    - declared SyntaxId

` Keeps, in a function that builds markup, the state cells it keeps of the function it is written
` in, which the environment it is given holds after the one that function had in force where it
` made it (`kept-layout-of`), which is the environment it reads from, and then the values of rules
` it keeps (`taken-values`); then those it reads from the cells the slot outlet that mounts what it
` builds holds, as the reference's `style-outlet-state` reads one; each in a local of its own
` (`state-cells`).
. layout = tables.kept-layout-of(unit.instance)
if layout != no-layout
    . wrapper = make-operand(.operand-argument, 0)
    made-environment = ir.add-local(managed-layout)
    store-local
        - made-environment
        - load(wrapper, tables.layouts.field(layout, 0).offset, managed-layout, declared)
        - declared
    . place U32 = 1
    for index in 0 .. < facts.scope-cells.length
        . held = facts.scope-cells[index]
        if held.instance != unit.reading || held.kept == U32.max
            continue
        . local = ir.add-local(managed-layout)
        store-local
            - local
            - load
                - wrapper
                - tables.layouts.field(layout, held.kept + 1).offset
                - managed-layout
                - declared
            - declared
        state-cells += StateCell(index as U32, local)
        place += 1
    for index in 0 .. < facts.scope-values.length
        . held = facts.scope-values[index]
        if held.instance != unit.reading || held.kept == U32.max
            continue
        taken-values += TakenValues(index as U32, around-values.length as U32)
        for position in held.type-first .. < held.type-first + held.count
            . field = tables.layouts.field(layout, place)
            if tables.layouts.is-struct(field.layout)
                refuse(.refused-function, declared)
                =
            . local = ir.add-local(field.layout, false)
            store-local(local, load(wrapper, field.offset, field.layout, declared), declared)
            around-values += AroundValue(0, local, facts.scope-value-types[position])
            place += 1
for index in 0 .. < facts.scope-cells.length
    . held = facts.scope-cells[index]
    if held.instance != unit.reading || !held.read
        continue
    . mark = pending.length
    pending += integer(.machine-u32, tables.state-key-number(held.key))
    . local = ir.add-local(managed-layout)
    store-local(local, call-instance(facts.style-runtime.outlet-state, declared, mark).operand, declared)
    state-cells += StateCell(index as U32, local)

────────────────────
+ do kept-cells Operand
    - id SyntaxId
    - type TypeId
    - written Operand

` The environment a nested function written at a node is given where it keeps state cells or
` values of rules of the function it is written in (`kept-layout-of`): the environment in force
` where it is written, then each cell it keeps, as made or given here, then each value
` (`around-local`). The environment in force alone where it keeps none. One made by a function it
` is not written in has no shape.
. callee = kept-callee(type)
if callee == no-instance
    = written
if instances.rows[callee].enclosing != unit.reading
    refuse(.refused-expression, id)
    = written
. layout = tables.kept-layout-of(callee)
. mark = pending.length
pending += integer(.machine-u64, tables.layouts.rows[layout].size)
pending += make-operand(.operand-descriptor, layout)
. kept = ir.add-local(managed-layout)
store-local(kept, call-runtime(.runtime-allocate-object, id, mark, managed-layout), id)
store(load-local(kept, id), tables.layouts.field(layout, 0).offset, written, true, id)
. place U32 = 1
for held in facts.scope-cells
    if held.instance != callee || held.kept == U32.max
        continue
    . local = cell-local(held.source)
    if local == no-local
        refuse(.refused-expression, id)
        = written
    store
        - load-local(kept, id)
        - tables.layouts.field(layout, held.kept + 1).offset
        - load-local(local, id)
        - true
        - id
    place += 1
for held in facts.scope-values
    if held.instance != callee || held.kept == U32.max
        continue
    for position in 0 .. < held.count
        . (local, type) = around-local(held.source, position)
        . field = tables.layouts.field(layout, place)
        if local == no-local || other-type || tables.layouts.is-struct(field.layout)
            refuse(.refused-expression, id)
            = written
        .. other-type = type != facts.scope-value-types[held.type-first + position]
        store
            - load-local(kept, id)
            - field.offset
            - load-local(local, id)
            - is-managed-pointer(field.layout)
            - id
        place += 1
= load-local(kept, id)

────────────────────
_ do kept-callee InstanceId
    - type TypeId

` The instance a closure type runs where it keeps state cells of the function it is written in,
` or none.
do match? types.rows[type]
    | .type-closure(row)
        for held in tables.kept-instances
            . shape = instances.rows[held]
            if shape.module == row.module && shape.decl == row.decl && same-enclosing
                = held
            .. same-enclosing = shape.enclosing == row.enclosing
= no-instance

────────────────────
_ do bind-cell
    - index U32
    - subject Operand

` Binds a state cell `make-cells` made to an object, read as of the cell's `owner`, as the
` reference's `bindStyleScopeState` does: the cell is given its value once in a live action of
` its own to gather what it reads (`set-cell`), and a live action with those trackers runs the
` cell's function (`emit-scope-cell`) with what it keeps: the object and the cell. The object
` owns that action (`attach-action`), since the trackers hold it only weakly.
. held = facts.scope-cells[index]
. own-unit = unit
unit = unit.source-module = held.module
. site = held.when
. local = cell-local(index)
if local == no-local
    refuse(.refused-statement, site)
    unit = own-unit
    =
. code = tables.cell-functions[index]
. trackers = open-trackers(site)
live-actions += LiveTrackers(trackers, trackers)
set-cell(held, subject, held.owner, load-local(local, site))
live-actions.pop()
. layout = tables.cell-layouts[index]
. size = tables.layouts.rows[layout].size
. mark = pending.length
pending += integer(.machine-u64, size)
pending += make-operand(.operand-descriptor, layout)
. kept = ir.add-local(managed-layout)
store-local(kept, call-runtime(.runtime-allocate-object, site, mark, managed-layout), site)
store(load-local(kept, site), tables.layouts.field(layout, 0).offset, subject, true, site)
store
    - load-local(kept, site)
    - tables.layouts.field(layout, 1).offset
    - load-local(local, site)
    - true
    - site
. action = make-action
    - load-local(trackers, site)
    - tables.live-adapter-of(code)
    - load-local(kept, site)
    - site
attach-action(subject, action.operand, site)
unit = own-unit

────────────────────
_ do set-cell
    - held ScopeCell
    - subject Operand
    - type TypeId
    - target Operand

` Gives a state cell whether the state its `when` names holds on an object of a type, read
` tracked, as the reference's `bindStyleScopeState` assigns it: true, or where the `when` is
` negated, false. The cell's `is-on` is set as an assignment sets it.
do match? tree.nodes[held.when]
    | .node-style-when(row)
        track(held.when, subject, row.state)
        . value = read-state(held.when, subject, type, row.state)
        if row.is-negated
            value = compare-zero(held.when, value, .compare-equal)
        . cell = tables.cell-type()
        . found = property-of(cell, program.store-atom("is-on"))
        if !found
            refuse(.refused-statement, held.when)
            =
        . field = held-field(held.when, cell, found)
        put-property(target, field, types.properties[found], value.operand, held.when)

────────────────────
+ do give-cells
    - id SyntaxId
    - count U32

` Gives the constructor of a markup element the state cells the element's context gives, in the
` order the type pass recorded them (`CarriedCell`), each as made or given where code is
` emitted, and then the values of the rules around rules written in rules it gives
` (`CarriedValues`), each as kept where code is emitted (`around-local`).
. given U32
for held in facts.carried-cells
    if held.instance != unit.reading || held.site != id
        continue
    . local = cell-local(held.cell)
    if local == no-local
        refuse(.refused-expression, id)
        =
    pending += load-local(local, id)
    given += 1
for held in facts.carried-values
    if held.instance != unit.reading || held.site != id
        continue
    for position in 0 .. < around-count(held.values)
        . (local, type) = around-local(held.values, position)
        if local == no-local
            refuse(.refused-expression, id)
            =
        pending += load-local(local, id)
        given += 1
if given != count
    refuse(.refused-expression, id)

────────────────────
+ do emit-subscription
    - id SyntaxId
    - loop SyntaxId
    - container SyntaxId

` A loop on a stream where it is written: the container is made a `Broadcastable`, and the
` loop's subscriber, the environment in force here, is made a `Subscriber` and given to the
` broadcaster's `subscribe`, whose errors leave the function as the type pass said, or, where
` an object owns it, to the object (see `own-subscription`), or where it has a `whenever`
` clause, as `subscribe-whenever` says. A section of a class, which a constructor runs, has an
` environment of its own: see `lone-environment`.
. used = tables.event-use-of(unit.reading, id)
. source = Typed(make-operand(.operand-void, 0), no-type)
if used && used.second == no-instance
    refuse(.refused-statement, id)
    =
if used
    . owner = event-owner(used.reference, used.owner)
    . number = tables.event-number(used.owner, used.name)
    if number == U32.max
        =
    if used.address != 0
        . endpoint = keyed-endpoint(id, used, owner.operand, number)
        source = convert(loop, .reason-argument, endpoint)
    else
        source = event-endpoint(loop, used.first, owner.operand, number)
else
    source = emit-broadcastable(loop, container)
. stream = source.operand
. broadcaster = source.type
. written = Typed(make-operand(.operand-void, 0), no-type)
if unit.reading == unit.instance
    written = emit-closure(id)
else
    . closure = subscriber-closure(id)
    . lone = lone-environment(id, no-slot)
    if closure == no-type
        refuse(.refused-statement, id)
        =
    written = Typed(load-local(lone, id), closure)
. subscriber = convert(id, .reason-argument, written)
. given = subscriber.type
. owned = tables.owned-subscription-of(unit.reading, id)
. retested = tree.whenever-clause(loop)
. retest = tables.live-statement-of(unit.reading, retested) if retested != 0
if retest
    subscribe-whenever(id, retested, retest, stream, broadcaster, subscriber.operand)
else if retested != 0
    refuse(.refused-statement, retested)
else if owned
    own-subscription(id, owned, stream, subscriber.operand, used != null, arrives(loop))
else if used
    . wrapping = pending.length
    pending += subscriber.operand
    pending += integer(.machine-u8, if arrives(loop) then 1 else 0)
    . subscription = call-instance(used.second, id, wrapping)
    do call-protocol(id, own-call(id), stream, broadcaster, subscription.operand, subscription.type)
else
    do call-protocol(id, own-call(id), stream, broadcaster, subscriber.operand, given)

────────────────────
+ do subscribe-whenever
    - id SyntaxId
    - clause SyntaxId
    - retest LiveStatement
    - stream Operand
    - broadcaster TypeId
    - subscriber Operand

` A loop or a comprehension on a stream with a `whenever` clause, subscribed as the reference
` subscribes it: the clause's value is evaluated while a live action of its own is open, whose
` trackers note what it reads. Where no object owns the subscription, the subscriber is
` wrapped in a `Subscription`, which is given to the broadcaster's `subscribe` where the value
` holds, whose errors leave the function as the type pass said. Where an object owns it, the
` tracker `own-tracker` makes of it is added to the action's trackers where the value holds.
` What the value gave, the subscription or its tracker, and the broadcaster are kept in the
` locals declared at the clause, and the action is made with those trackers and a callback
` that tests the clause again through the function written for it, given the environment in
` force here, or one of its own where none is (see `lone-environment`). The object that owns
` the subscription owns the action.
. slot = channel-slot(clause)
. code = if retest.rerun != no-instance then rerun-function else no-function
    .. rerun-function = tables.instance-functions[retest.rerun]
. owned = tables.owned-subscription-of(unit.reading, clause)
. made = call-at(clause, .call-constructor)
if slot == no-slot || code == no-function || (!owned && made == no-fact) || (owned && !unit.has-self)
    refuse(.refused-statement, clause)
    =
. lone = if unit.reading != unit.instance then lone-environment(clause, slot, 3) else no-local
. trackers = open-trackers(clause)
live-actions += LiveTrackers(trackers, trackers)
. passed = emit-expression(tree.clause-expr(clause))
live-actions.pop()
. kept = Typed(make-operand(.operand-void, 0), no-type)
if owned
    kept = own-tracker(clause, owned, stream, subscriber)
else
    . mark = pending.length
    pending += subscriber
    kept = call-instance(facts.calls[made].callee, clause, mark)
keep-hidden(lone, slot + 1, kept.operand, kept.type, clause)
keep-hidden(lone, slot, passed.operand, types.bool-type, clause)
. adding = ir.reserve-block()
. done = ir.reserve-block()
branch(passed.operand, adding, done)
ir.start-block(adding)
. given = convert(clause, .reason-argument, kept)
. given-type = given.type
if owned
    add-tracker(load-local(trackers, clause), given.operand, clause)
else
    do call-protocol(id, call-at(id, .call-method), stream, broadcaster, given.operand, given-type)
jump(done)
ir.start-block(done)
keep-hidden(lone, slot + 2, stream, broadcaster, clause)
. environment = if lone != no-local then load-local(lone, clause) else written-environment(clause)
if owned
    do own-action(load-local(trackers, clause), code, environment, clause)
else
    do make-action(load-local(trackers, clause), tables.live-adapter-of(code), environment, clause)

────────────────────
_ do keep-hidden
    - lone LocalId
    - slot SlotId
    - value Operand
    - type TypeId
    - site SyntaxId

` Stores a value in a local no name reaches that a nested function captures: in the
` environment `lone` made for that function alone, where there is one.
if lone != no-local
    keep-lone(lone, slot, value, type, site)
else
    keep-captured(slot, value, type, site)

────────────────────
+ do add-tracker
    - trackers Operand
    - tracker Operand
    - site SyntaxId

` Adds a tracker, made a `Tracker`, to a list of trackers.
. adding = pending.length
pending += trackers
pending += tracker
do call-instance(instances.live.add-tracker, site, adding)

────────────────────
_ do retrack
    - clause SyntaxId
    - slot SlotId
    - passed Operand
    - next LocalId

` The rest of a test of a `whenever` clause again where an object owns the subscription: where
` the value holds, the tracker kept in `slot` is added to the trackers the action now has, so
` that it stays attached, and the subscription with it; where not, the action detaches it.
. type = find-captured(slot, clause).type
. adding = ir.reserve-block()
. done = ir.reserve-block()
branch(passed, adding, done)
ir.start-block(adding)
. tracker = read-captured(slot, clause, type)
. given = convert(clause, .reason-argument, Typed(tracker.operand, type))
add-tracker(load-local(next, clause), given.operand, clause)
jump(done)
ir.start-block(done)
emit-end(clause)

────────────────────
+ do own-subscription
    - id SyntaxId
    - row OwnedSubscription
    - stream Operand
    - subscriber Operand
    - event Bool = false
    - arrival Bool = false

` A subscription the object owns, as the reference makes it: the tracker `own-tracker` makes
` of it is added to the trackers of a live action of the object, whose constructor attaches the
` tracker, which subscribes, and whose callback does nothing.
. tracker = own-tracker(id, row, stream, subscriber, event, arrival)
. given = convert(id, .reason-argument, tracker)
. trackers = open-trackers(id)
add-tracker(load-local(trackers, id), given.operand, id)
do own-callback(load-local(trackers, id), idle, integer(.machine-managed-pointer, 0), id)
    .. idle = tables.idle-action

────────────────────
_ do own-tracker Typed
    - id SyntaxId
    - row OwnedSubscription
    - stream Operand
    - subscriber Operand
    - event Bool = false
    - arrival Bool = false

` The tracker that subscribes a subscription an object owns: the subscriber is wrapped in a
` `Subscription`, or for an `event` in the event runtime's subscription, which hears every
` publication or with `arrival` only those the object is the target of, and given with the
` broadcaster to a `SubscriptionTracker`, whose type it has.
. nothing = make-operand(.operand-void, 0)
. mark = pending.length
pending += subscriber
if event
    pending += integer(.machine-u8, if arrival then 1 else 0)
. made = call-instance(row.subscription, id, mark)
. wrapped = convert(id, .reason-argument, made)
. tracking = pending.length
pending += stream
pending += wrapped.operand
= call-instance(row.tracker, id, tracking)

────────────────────
+ do subscriber-closure TypeId
    - id SyntaxId

` The closure a comprehension on a stream subscribes, as the conversion recorded where it is
` made a `Subscriber` gives it.
. scan = facts.first-conversion(unit.reading, id)
while scan != no-fact
    . row = facts.conversions[scan]
    if row.reason == .reason-argument && is-closure(row.from)
        = row.from
    scan = row.next
= no-type

────────────────────
+ do emit-subscriber
    - loop SyntaxId
    - clause SyntaxId
    - body SyntaxId
    - writes SyntaxId = 0

` The function a loop on a stream runs for each item it is given, after the environment it
` was made with: the header's pattern takes the item, and a `when` that fails or an item a
` match passes over returns. A `while` or an `until` that fails unsubscribes and returns.
` Then the body runs, where a `break` that leaves no loop of the body unsubscribes and returns.
` That of a comprehension on a stream, which `writes` to the
` comprehension's channel, tests its clauses in the order written and writes what its body
` gives.
. type = instances.argument-type(unit.instance, 0)
. last = loop-slots(loop) + loop-state-count - 1
. skip = ir.reserve-block()
. ended = ir.reserve-block()
. item = make-operand(.operand-argument, 1)
take-item(loop, last, item, type, skip)
. turned = facts.slot-type(unit.instance, slot-offset(last, loop))
. depth = loops.length
loops += EmittedLoop(loop, skip, ended, item, turned, open-cleanups.length, last)
emit-clause(clause, skip, ended)
if writes != 0
    emit-write(writes, body)
else
    emit-block(body)
while loops.length > depth
    loops.pop()
jump(skip)
ir.start-block(ended)
if own-call(loop) != no-fact
    unsubscribe(loop)
jump(skip)
ir.start-block(skip)

────────────────────
_ do emit-write
    - id SyntaxId
    - body SyntaxId

` What the body of a comprehension on a stream gives, written to the channel the comprehension
` made, read from the environment it was kept in, by the call of `<-` the type pass recorded
` at the comprehension.
. value = emit-expression(body)
. written = value.type
. fact = call-at(id, .call-operator)
. slot = channel-slot(id)
if fact == no-fact || slot == no-slot || facts.calls[fact].callee == no-instance
    refuse(.refused-expression, id)
    =
. channel = instances.rows[facts.calls[fact].callee].self-type
. held = read-captured(slot, id, channel)
do call-operator(id, fact, id, held.operand, channel, body, value.operand, written)

────────────────────
+ do breaks-subscription Bool

` Whether a `break` here unsubscribes: the innermost loop is the one on a stream that the
` function being emitted runs for an item.
if subscribing == 0 || loops.length == 0
    = false
do match? tree.nodes[subscribing]
    | .node-for-block(row)
        = loops[loops.length - 1].syntax == row.loop
= false

────────────────────
+ do unsubscribe
    - site SyntaxId

` The subscriber being run, made a `Subscriber` again by the conversion recorded where it was
` subscribed, so it is the same value, given to `unsubscribe` of the stream it was given, as
` the type pass recorded at the node that unsubscribes. An error that leaves `unsubscribe` is
` given to the global `unhandled-error` and what follows runs, as the reference's raw call does.
. fact = own-call(site)
. closure = facts.node-type(unit.reading, subscribing)
. enclosing = facts-owner(instances.rows[unit.instance].enclosing)
. made = no-fact
. scan = if enclosing != no-instance then enclosing-first else no-fact
    .. enclosing-first = facts.first-conversion(enclosing, subscribing)
while scan != no-fact
    . row = facts.conversions[scan]
    if row.reason == .reason-argument && row.from == closure
        made = scan
    scan = row.next
if fact == no-fact || made == no-fact
    refuse(.refused-statement, site)
    =
. subscriber = convert-one(site, facts.conversions[made], Typed(make-operand(.operand-argument, 0), closure))
. given = subscriber.type
. stream = make-operand(.operand-argument, 2)
. broadcaster = instances.argument-type(unit.instance, 1)
call-subscription(site, fact, stream, broadcaster, subscriber.operand, given)

────────────────────
+ do call-subscription
    - site SyntaxId
    - fact FactId
    - stream Operand
    - broadcaster TypeId
    - given Operand
    - given-type TypeId

` The broadcaster's `subscribe` or `unsubscribe` the type pass recorded as `fact`, given a
` subscriber or a subscription, as the reference's raw call makes it: an error that leaves it is
` given to the global `unhandled-error` and what follows runs.
. callee = facts.calls[fact].callee
if layout-of(given-type, site) != layout-of(instances.argument-type(callee, 0), site) || other-self
    refuse(.refused-statement, site)
    =
.. other-self = broadcaster != instances.rows[callee].self-type
. raising = instances.signatures[callee].errors.count != 0
. mark = pending.length
pending += stream
pending += given
takes-result = raising
. answer = call-instance(callee, site, mark, false, true)
takes-result = false
if raising
    do report-result(site, instances.signatures[callee].result, answer.operand, true)

────────────────────
+ do emit-retest
    - clause SyntaxId

` The function a live action runs to test a `whenever` clause again, given the environment the
` loop was written in, as the reference's closure does: the clause's value, with the trackers
` of the action that runs it noting what it reads, is compared with the one the clause last
` gave, kept where the loop was written. Where it differs it is kept instead, and the
` subscription kept there is given to the broadcaster's `subscribe` where the value holds, or
` else to its `unsubscribe`, as `call-subscription` says. Where an object owns the
` subscription, the clause is tested as `retrack` says instead.
. live = instances.live
. calls = facts.whenever-calls-of(unit.instance)
. slot = channel-slot(clause)
if live.previous == no-instance || live.next == no-instance || !calls || slot == no-slot
    refuse(.refused-function, clause)
    =
. previous = ir.add-local(managed-layout)
store-local(previous, call-instance(live.previous, clause, pending.length).operand, clause)
. next = ir.add-local(managed-layout)
store-local(next, call-instance(live.next, clause, pending.length).operand, clause)
live-actions += LiveTrackers(previous, next)
. passed = emit-expression(tree.clause-expr(clause))
live-actions.pop()
if calls.owns
    retrack(clause, slot + 1, passed.operand, next)
    =
. last = read-captured(slot, clause, types.bool-type)
. wrapped = find-captured(slot + 1, clause).type
. broadcaster = find-captured(slot + 2, clause).type
. changing = ir.reserve-block()
. done = ir.reserve-block()
branch(compare(clause, .compare-not-equal, passed.operand, last.operand), changing, done)
ir.start-block(changing)
keep-captured(slot, passed.operand, types.bool-type, clause)
. stream = read-captured(slot + 2, clause, broadcaster)
. subscription = read-captured(slot + 1, clause, wrapped)
. given = convert(clause, .reason-argument, Typed(subscription.operand, wrapped))
. given-type = given.type
. adding = ir.reserve-block()
. dropping = ir.reserve-block()
branch(passed.operand, adding, dropping)
ir.start-block(adding)
call-subscription(clause, calls.subscribe, stream.operand, broadcaster, given.operand, given-type)
jump(done)
ir.start-block(dropping)
call-subscription(clause, calls.unsubscribe, stream.operand, broadcaster, given.operand, given-type)
jump(done)
ir.start-block(done)
emit-end(clause)

────────────────────
+ do get reruns-statement Bool

` Whether the function being emitted is one a live action runs a live statement again with.
if function.kind != .instance-body || unit.instance == no-instance
    = false
. row = instances.rows[unit.instance]
do match? program.modules[row.module].decls[row.decl]
    | .decl-function(fn)
        = fn.kind == .live-decl
= false

────────────────────
+ do open-trackers LocalId
    - site SyntaxId

` A new list of trackers for a live action a value runs in, or one that owns a subscription,
` kept in a local of its own.
. made = call-instance(instances.live.trackers, site, pending.length)
. kept = ir.add-local(managed-layout)
store-local(kept, made.operand, site)
= kept

────────────────────
+ do subscribe-values
    - site SyntaxId

` Makes the live action of each value that read something tracked as the constructor gave it,
` in the order the properties are declared, with the trackers it noted and its property's
` updater as the callback, and gives the object the action.
for position in 0 .. < filling.count
    for index in 0 .. < place-trackers.length
        if place-trackers[index].place == filling.start + position
            subscribe-value(place-trackers[index].place, place-trackers[index].trackers, filling.type, site)
place-trackers.clear()

────────────────────
+ do subscribe-value
    - place U32
    - trackers LocalId
    - owner TypeId
    - site SyntaxId

` A live action of the object being made, with the trackers a value noted and a callback that
` runs the property's updater with the object. Where the object's class keeps a flag for the
` property, the action is its memo, which a change of what the value read marks rather than
` runs, and a read settles.
. code = tables.updater-of(place)
if code == no-function
    refuse(.refused-function, site)
    =
. flag = memo-flag-of(owner, types.properties[place])
. live = instances.live
if flag == U32.max || live.memo-action == no-instance
    do own-action(load-local(trackers, site), code, unit.self, site)
    =
. callback = make-callback(tables.live-adapter-of(code), unit.self, site)
. mark = pending.length
pending += load-local(trackers, site)
pending += callback
pending += num-cast(site, unit.self, managed-layout, pointer-layout)
pending += integer(.machine-u64, flag)
pending += make-operand(.operand-constant, ir.add-string(types.properties[place].name.text))
. action = call-instance(live.memo-action, site, mark)
attach-action(unit.self, action.operand, site)

────────────────────
+ do own-action Operand
    - trackers Operand
    - code FunctionId
    - data Operand
    - site SyntaxId

` Gives the object being made a live action with the trackers given and a callback that runs
` a function again with the data given, through the function's adapter, and answers it. Where
` no markup element is being built and the object's class is a markup host or batch, the action
` is made the way the type pass chose (`SelfAction`), or refused where it chose none.
. nothing = make-operand(.operand-void, 0)
. owned = facts.self-action-of(unit.reading) if content-hosts.length == 0 && unit.has-self
if !owned
    = own-callback(trackers, tables.live-adapter-of(code), data, site)
if owned.maker == no-instance
    refuse(.refused-function, site)
    = nothing
. callback = make-callback(tables.live-adapter-of(code), data, site)
. owner = convert-self
    - owned.site
    - if owned.rooted then .reason-markup-batch else .reason-markup-host
. mark = pending.length
pending += trackers
pending += callback
pending += owner.operand
. action = raising-call(owned.site, owned.maker, mark)
attach-action(unit.self, action.operand, site)
= action.operand

────────────────────
+ do emit-live-statement
    - id SyntaxId
    - row LiveStatement
    - lhs SyntaxId
    - rhs SyntaxId

` An assignment whose value reads something tracked, as the reference compiles it: it is
` stored as any assignment is, while a live action of its own is open, whose trackers note what
` the value reads. Then the action is made with those trackers and a callback that runs the
` statement again through the function written for it, given the environment in force here,
` and the object named alone whose property is assigned, read again, owns the action where it
` is of a class. Where that class is a markup host or batch, the action is made as the type
` pass chose for it (`LiveStatement`), given the object as its host or its batch.
. code = if row.rerun != no-instance then tables.instance-functions[row.rerun] else no-function
if code == no-function || tree.is-chained(rhs) || is-link(lhs)
    refuse(.refused-statement, id)
    =
. trackers = open-trackers(id)
live-actions += LiveTrackers(trackers, trackers)
emit-assign(id, .eq-op, lhs, rhs)
live-actions.pop()
. owner = make-operand(.operand-void, 0)
. held = no-type
. owned = false
do match? tree.nodes[lhs]
    | .node-get-expression(get)
        . emitted = emit-expression(get.object)
        owner = emitted.operand
        held = emitted.type
        owned = tables.is-class(emitted.type)
. adapter = tables.live-adapter-of(code)
if row.owned != no-instance
    if !owned || held != row.holder
        refuse(.refused-statement, id)
        =
    . callback = make-callback(adapter, written-environment(id), id)
    . given = convert
        - id
        - if row.rooted then .reason-markup-batch else .reason-markup-host
        - Typed(owner, held)
    . mark = pending.length
    pending += load-local(trackers, id)
    pending += callback
    pending += given.operand
    . made = raising-call(id, row.owned, mark)
    attach-action(owner, made.operand, id)
    =
. action = make-action(load-local(trackers, id), adapter, written-environment(id), id)
if owned
    attach-action(owner, action.operand, id)

────────────────────
_ do write-again
    - statement SyntaxId
    - expr SyntaxId

` The value of a stream of a value as it changes, given again by its live action: evaluated with
` the trackers of the action noting what it reads, and written by `<-write` to the channel kept
` where the stream was made.
. slot = channel-slot(statement)
. write = stream-call(statement, .call-method)
if slot == no-slot || write == no-fact
    refuse(.refused-statement, statement)
    =
. found = find-captured(slot, statement)
. channel = read-captured(slot, statement, found.type)
. value = emit-expression(expr)
. held = value.type
do call-protocol(statement, write, channel.operand, found.type, value.operand, held, false)

────────────────────
+ do emit-rerun
    - declared SyntaxId
    - statement SyntaxId

` The function a live action runs a live statement again with, given the environment the
` statement was written in: the statement runs again with the trackers of the action that runs
` it noting what its value reads, as the reference's closure does, an assignment as one, and so
` a line of a class's markup that declares a property (`content-property`), a declaration as
` `declare-again` says, a line of a markup element's body that gives content
` as `absorb-again` or `replace-again` says, and the value of a stream as `write-again` says. An
` attribute of an element and a line of a style rule that sets a property are stored again in the
` object kept where they were written (`store-again`).
. live = instances.live
if live.previous == no-instance || live.next == no-instance
    refuse(.refused-function, declared)
    =
. previous = ir.add-local(managed-layout)
store-local(previous, call-instance(live.previous, statement, pending.length).operand, statement)
. next = ir.add-local(managed-layout)
store-local(next, call-instance(live.next, statement, pending.length).operand, statement)
live-actions += LiveTrackers(previous, next)
rerunning = true
. element = tree.argument-element(statement)
. streamed SyntaxId = 0
do match? tree.nodes[statement]
    | .node-iterable-expression(row)
        streamed = row.expr
if streamed != 0
    write-again(statement, streamed)
else if element != 0
    . row = tables.live-statement-of(instances.rows[unit.instance].enclosing, statement)
    if row && row.property != U32.max
        store-again(statement, element, types.properties[row.property].name, statement)
    else
        refuse(.refused-statement, statement)
else if tree.content-line(statement)
    if replaces(statement)
        replace-again(statement)
    else
        absorb-again(statement)
else if tree.bound-attribute(statement) != 0
    store-back(statement, tree.bound-attribute(statement))
else
    do match tree.nodes[statement]
        | .node-assign(row)
            . styled = facts.style-declaration-of(instances.rows[unit.instance].enclosing, statement)
            if styled
                author-again(statement, row.rhs, styled)
            else if tree.attribute-element(statement) != 0 || rule-update
                . name = tree.identifier-name(row.lhs)
                . setter = own-call(row.lhs)
                if setter != no-fact && facts.calls[setter].form == .call-setter
                    set-again(statement, row.lhs, row.rhs, facts.calls[setter].callee)
                else if name
                    store-again(statement, statement, name, row.rhs)
                else
                    refuse(.refused-statement, statement)
            else
                emit-assign(statement, row.op, row.lhs, row.rhs)
            .. rule-update = facts.rule-update-of(instances.rows[unit.instance].enclosing, statement)
        | .node-property-syntax(row)
            emit-assign(statement, .eq-op, tree.content-property-name(statement), row.value)
        | .node-declare(row)
            declare-again(statement, row.left, row.right)
