. nothing = make-operand(.operand-void, 0)
. list = subscribers-slot(slot)
if list == no-slot
    refuse(.refused-expression, site)
    = nothing
if is-captured(list)
    . field = find-captured(list, site)
    = take(captured-base(site), field, site)
. offset = list - unit.slot-start
if !owns(list) || unit.cells[offset] == no-local
    refuse(.refused-expression, site)
    = nothing
= load-local(unit.cells[offset], site)

────────────────────
_ do subscribers-slot SlotId
    - slot SlotId

` The hidden local that holds the list of subscribers of the function that declares a local.
. home = bindings.slots[slot].scope
while bindings.scopes[home].kind != .scope-function && bindings.scopes[home].kind != .scope-nested
    home = bindings.scopes[home].parent
for offset in 0 .. < unit.slot-count
    . row = bindings.slots[unit.slot-start + offset]
    if row.kind == .slot-subscribers && row.scope == home
        = unit.slot-start + offset
= no-slot

────────────────────
+ do make-subscribers
    - site SyntaxId

` Makes the lists of subscribers the function keeps for the locals it declares that some read
` tracks, where it starts, as the reference does in its head. One that nested functions read
` is kept in the environment.
. live = instances.live
if unit.instance == no-instance || live.subscribers == no-instance
    =
for offset in 0 .. < unit.slot-count
    . slot = unit.slot-start + offset
    if bindings.slots[slot].kind != .slot-subscribers || !owns(slot)
        continue
    . type = facts.slot-type(unit.instance, offset)
    if type == no-type || type == invalid-type
        continue
    . made = call-instance(live.subscribers, site, pending.length)
    if is-captured(slot)
        keep-captured(slot, made.operand, type, site)
    else
        unit.cells[offset] = ir.add-local(managed-layout)
        store-local(unit.cells[offset], made.operand, site)

────────────────────
+ watches Bool
    - slot SlotId
    - id SyntaxId

` Whether a store to a local runs the actions that read it: some read tracks it, and the
` function that declares it has made its list of subscribers by then, as the reference makes
` it at the first tracked read of one of its locals that it compiles. The function that runs a
` live statement again stores after that, and so does any other function written in the one
` that declares the local, where that one reads one of its locals tracked.
|? (bindings.slots[slot].flags /and/ SlotFlag.slot-tracked) == 0 || undispatched
    false
|? kind != .slot-local && kind != .slot-lazy && kind != .slot-argument
    false
|? tables.is-rerun(unit.instance)
    facts.tracked-locals-from(instances.rows[unit.instance].enclosing) != 0
|? !owns(slot)
    declarer(slot) != no-instance && facts.tracked-locals-from(declarer(slot)) != 0
??
    first != 0 && first < id

.. undispatched = instances.live.dispatch == no-instance
.. kind = bindings.slots[slot].kind
.. first = facts.tracked-locals-from(unit.instance)

────────────────────
_ do declarer InstanceId
    - slot SlotId

` The function the emitted one is written in that declares a slot, or none.
. owner = unit.instance
while owner != no-instance && tables.instance-scopes[owner] != tables.slot-functions[slot]
    owner = instances.rows[owner].enclosing
= owner

────────────────────
+ do dispatch-local
    - slot SlotId
    - prior Operand
    - latest Operand
    - type TypeId
    - site SyntaxId
    - armed Operand = make-operand(.operand-void, 0)

` Runs the actions that read a tracked local where a store changed its bits, as `bits-differ`
` says, through the list of subscribers of the function that declares it, under the local's
` name; where `armed` is given, only where it is set.
. live = instances.live
. changed = bits-differ(prior, latest, layout-of(type, site), site)
if operand-kind(armed) != .operand-void
    changed = bitwise(site, .bitwise-and, changed, armed, u8-layout)
. sending = ir.reserve-block()
. done = ir.reserve-block()
branch(changed, sending, done)
ir.start-block(sending)
. list = local-subscribers(slot, site)
. mark = pending.length
pending += list
pending += make-operand(.operand-constant, ir.add-string(bindings.slots[slot].name.text))
do call-instance(live.dispatch, site, mark)
jump(done)
ir.start-block(done)

────────────────────
+ do emit-tracked-get Typed
    - id SyntaxId
    - object SyntaxId
    - name Atom

` A tracked read of a stored property of an object in a live action: the object is read once,
` the read is noted in the action's trackers, and the property is read from the object. An
` object written as a member of the receiver or a local named alone is tracked as it is read,
` as the reference tracks the start of the chain. Any other tracked read has no shape there.
. owner = held-type(object)
. fact = own-call(id)
. getter = fact != no-fact && facts.calls[fact].form == .call-getter
if owner == no-type || owner == invalid-type || !tables.is-class(owner) || planned || getter
    refuse(.refused-expression, id)
    = Typed(make-operand(.operand-void, 0), no-type)
.. planned = facts.plan-of(unit.reading, id) != .plan-none
. root = tracked-root(object)
if root && !pin-of(object)
    track(object, unit.self, root)
. local = if !pin-of(object) then tracked-root-local(object) else no-slot
if local != no-slot && !settles-once(local) && live-actions.length != 0
    . list = local-subscribers(local, object)
    track-in(object, list, list, bindings.slots[local].name)
. base = emit-expression(object)
track(id, base.operand, name)
. value = load-property(id, base.operand, owner, name)
track-collection(id, value)
= value

────────────────────
_ do settles-once Bool
    - slot SlotId

` Whether a local is a lazy one whose declaration no live action runs again, so that nothing
` stores to it after its value is evaluated and a read of it tracks nothing.
. row = bindings.slots[slot]
if row.kind != .slot-lazy
    = false
. binding = instances.rows[unit.reading].binding
. nested = bindings.bindings[binding].nested
for offset in 0 .. < nested.count
    . held = bindings.nested[nested.start + offset]
    if held.syntax == row.group
        do match? program.modules[unit.source-module].decls[held.decl]
            | .decl-function(fn)
                if fn.kind == .live-decl
                    = false
= true

────────────────────
+ do tracked-root Atom?
    - object SyntaxId

` The name of the member of the receiver a tracked read reads from, where its object is that
` member named alone and untracked, or none.
. binding = instances.rows[unit.reading].binding
if binding == no-binding
    = null
do match? tree.nodes[object]
    | .node-identifier(row)
        if !row.is-tracked && bindings.resolution-of(binding, object).kind == .resolve-member
            = row.name
= null

────────────────────
_ do tracked-root-local SlotId
    - object SyntaxId

` The local a tracked read reads from, where its object is that local named alone and
` untracked, or none.
do match? tree.nodes[object]
    | .node-identifier(row)
        if !row.is-tracked
            = tracked-local(object)
= no-slot

────────────────────
+ tracks Bool
    - property TypeProperty

` Whether some read tracks a property, by the topmost class that declares it (`tracked-root`),
` which an override shares.
|? property.owner == no-type || property.owner == invalid-type || undispatched
    false
??
    facts.is-tracked(ref.module, ref.decl, property.name)

.. undispatched = instances.live.dispatch == no-instance
.. ref = class-ref(types, types.tracked-root(property.owner, property.name))

────────────────────
+ do keeps-trackers Bool
    - place U32

` Whether the trackers of a property's own live action are kept (`place-trackers`).
for kept in place-trackers
    if kept.place == place
        = true
= false

────────────────────
+ do tracks-link Bool
    - id SyntaxId

` Whether a link of an optional chain is a tracked read made in a live action.
if live-actions.length == 0
    = false
do match? tree.nodes[id]
    | .node-get-expression(row)
        = row.is-tracked
= false

────────────────────
+ do emit-latest Typed
    - id SyntaxId
    - value SyntaxId

` The latest item of a stream, `##` of it, as the reference reads it in a live action. Where
` the action is made, the stream is made a `Broadcastable` and given, with the empty value of
` its item, to a `BroadcasterTracker`, which is kept in the local the node declares and added
` to the action's trackers, and the read is that empty value. The function that runs the
` action again adds the tracker it captures to its trackers and reads its `latest`. A read
` where no action is open, or in a function written in the action, has no shape here.
. nothing = make-operand(.operand-void, 0)
. row = facts.latest-read-of(unit.reading, id)
. binding = instances.rows[unit.reading].binding
if !row || binding == no-binding || live-actions.length == 0
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. resolution = bindings.resolution-of(binding, id)
if resolution.kind != .resolve-slot
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. slot = resolution.slot
. item = facts.node-type(unit.reading, id)
. tracking = instances.signatures[row.tracker].returns
. trackers = live-actions[live-actions.length - 1].next
. own = is-own-slot(slot) && owns(slot)
if rerunning && !own
    . kept = read-captured(slot, id, tracking)
    add-tracker(load-local(trackers, id), convert(id, .reason-argument, Typed(kept.operand, tracking)).operand, id)
    = load-property(id, kept.operand, tracking, program.store-atom("latest"), false, item)
if rerunning || !own
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. held = emit-expression(value)
. stream = Typed(nothing, no-type)
if row.publisher != no-instance
    . mark = pending.length
    pending += convert(value, .reason-argument, held).operand
    stream = call-instance(row.publisher, id, mark)
else
    stream = convert(value, .reason-argument, held)
if stream.type != row.stream
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. latest = default-value(0, item, layout-of(item, id), id)
. making = pending.length
pending += stream.operand
pending += latest.operand
. made = call-instance(row.tracker, id, making)
keep-captured(slot, made.operand, tracking, id)
add-tracker(load-local(trackers, id), convert(id, .reason-argument, Typed(made.operand, tracking)).operand, id)
= Typed(latest.operand, item)

────────────────────
_ do unit-machine MachineFact?
    - unit-id InstanceId

` The state machine of a property that the instance typing its value starts, or none.
for machine in facts.machines
    . member = machine.store == .store-member && machine.outer == 0
    if member && instances.rows[machine.instance].enclosing == unit-id
        = machine
= null
