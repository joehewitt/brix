    (let place (. ([] (. tables layouts rows) managed-layout) size))
    (let code (call load (. unit self) 0 pointer-layout declared))
    (let data (call load (. unit self) (. (call (. tables layouts field) layout 1) offset) managed-layout declared))
    (let step (call load data place i32-layout declared))
    (let waiting (call (. ir reserve-block)))
    (let ended (call (. ir reserve-block)))
    (call branch (call compare declared .compare-greater-equal step (call integer .machine-i32 0)) waiting ended)
    (call (. ir start-block) waiting)
    (let last
      (call arithmetic
        (block
          (arg declared)
          (arg .arithmetic-subtract)
          (arg (call integer .machine-i32 finished-step))
          (arg step)
          (arg i32-layout)
        )
      )
    )
