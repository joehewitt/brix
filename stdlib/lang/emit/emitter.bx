    (let table (call load ([] pending mark) (. (call (. tables layouts field) layout 1) offset) pointer-layout syntax))
    (let place (* (+ witness-header-slots ([] (. tables slots) callee)) table-slot-size))
    (let method (call load table place pointer-layout syntax))
    (let result (call call method syntax mark .callee-value returns (and checked (not in-landing))))
