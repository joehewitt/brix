          (else
            (call fill-stack (call stack-slot kept (. property syntax)) kept (. value operand) (. property syntax))
          )
        )
      )
    )
    (call return-nothing)
  )
  (fn-do _ global-value Typed
    (param kept GlobalStorage)
    (param property PropertyDecl)
