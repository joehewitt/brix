    (for (in position (..< 0 (. signature args count)))
      (call (. ir add-argument) (call layout-of (call (. instances argument-type) (. unit instance) position) declared))
    )
    (= returns-type (. signature returns))
    (= (. ir returns) (call layout-of (. signature returns) declared))
    (if forwards
      (call return-results (. signature result) declared)
    )
    (let mark (. pending length))
    (let view (call (. tables receiver-view) (. unit instance)))
    (+= pending (. (call make-interface declared (. row self-type) view (call make-operand .operand-argument 0)) operand))
    (for (in position (..< 0 (. signature args count)))
      (+= pending (call make-operand .operand-argument (+ position 1)))
    )
