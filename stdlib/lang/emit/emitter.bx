    ; managed code first and leaves it after the call, and where the call panics. A C function a
    ; binding names is called as it is, with no marks around the call. A C function type's takes
    ; no data, so its binding holds nothing, and TypeScript places its call where the type is
    ; declared.
    ; A type that carries errors returns its value or one of them: an error what runs gives
    ; leaves the function made as one raised at the call would, and is one the type carries,
    ; as the type pass requires.
    (let row ([] (. tables adapters) (. function place)))
    (if (== (. row runs) no-instance)
      (call emit-cast row)
      (return)
    )
    (let callee (. row runs))
    (let closes (call is-closure (. row from)))
    (= line-shift (if-expr (. row below) 1 0))
    (let count (if-expr closes 0 (call bound-count (. row from))))
    (let receives (and (not closes) (call binds-object (. row from))))
    (let fits closes)
    (let nests false)
    (let foreign false)
    (let constructs false)
    (match? ([] (. types rows) (. row from))
      (case (call .type-binding shape)
        (= nests (== (. shape form) .bound-closure))
        (= foreign (== (. shape form) .bound-c-function))
        (= constructs (== (. shape form) .bound-constructor))
        (= fits
          (scope (or nests foreign constructs function-bound (== (. shape form) .bound-method))
            (lazy function-bound (== (. shape form) .bound-function))
          )
        )
      )
    )
    (let owner ([] (. instances rows) callee))
    (let written (and constructs (== (. owner bound-call) .bound-call-constructor)))
    (let named
      (scope (and (not constructs) matches)
        (lazy matches (== (. owner bound-call) (if-expr receives .bound-call-method .bound-call-function)))
      )
    )
    (= fits (and fits (or closes nests foreign written named)))
    (let held ([] (. tables layouts values) (. row from)))
    (let symbol (if-expr foreign ([] (. tables c-symbols) callee) no-string))
    (let emitted (or (!= ([] (. tables instance-functions) callee) no-function) (call (. tables is-prototype) callee)))
    (if foreign
      (= emitted
        (scope (and (!= symbol no-string) (== ([] (. tables c-suspends) callee) 0) undescribed)
          (lazy undescribed (== ([] (. tables c-described) callee) no-runtime-function))
        )
      )
    )
    (if (or (not fits) (== held no-layout) (not (call runs-as callee count (. row to))) (not emitted))
      (call refuse-own)
      (return)
    )
    (let bare (call is-c-function types (. row to)))
    (if (and bare (or closes (!= held void-layout)))
      (call refuse-own)
      (return)
    )
    (if (not bare)
      (call (. ir add-argument) managed-layout)
    )
    (let site (. row site))
    (if bare
      (= (. ir signals) false)
      (= site (call c-type-site (. row to)))
      (if (== site 0)
        (call refuse-own)
        (return)
      )
    )
    (match? ([] (. types rows) (call function-row types (. row to)))
      (case (call .type-function shape)
        (for (in offset (..< 0 (. shape args count)))
          (call (. ir add-argument) (call layout-of (call (. types child-type) (. shape args) offset) 0))
        )
        (= returns-type (call value-returned (. shape return-type)))
      )
    )
    (= (. ir returns) (call layout-of returns-type 0))
    (let target (call function-row types (. row to)))
    (let carried (if-expr (call carries target) (call (. facts carried-result) target) no-type))
    (if (!= carried no-type)
      (call return-results carried 0)
    )
    (let raising (and (not foreign) (!= (. ([] (. instances signatures) callee) errors count) 0)))
    (let answers void-layout)
    (if foreign
      (= answers (call layout-of (. ([] (. instances signatures) callee) returns) 0))
    )
    (let data (call make-operand .operand-argument 0))
    (let first U32 (if-expr bare 0 1))
    (let mark (. pending length))
    (let place U32)
    (if (not closes)
      (= in-callback true)
      (= foreign-callback bare)
      (call call-runtime (call callback-entry) 0 (. pending length))
    )
    (if closes
      (+= pending data)
    )
    (if receives
      (let piece (call part data held 0 0))
      (+= pending (. piece operand))
      (= place 1)
      (let derived (and (call (. tables is-class) (. piece type)) (call (. tables derives) (. piece type) (. owner self-type))))
      (if (and (!= (. piece type) (. owner self-type)) (not nests) (not derived))
        (call refuse-own)
      )
    )
    (for (in offset (..< 0 count))
      (let kept (call part data held (+ place offset) 0))
      (let taken (call (. instances argument-type) callee offset))
