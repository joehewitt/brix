      (block
        (case? (!= (. content-hosts length) 0)
          (. ([] content-hosts (- (. content-hosts length) 1)) operand)
        )
        (default
          (. unit self)
        )
      )
    )
    (let action (call make-action trackers code data site))
    (call attach-action owner (. action operand) site)
    (return (. action operand))
  )
  (fn-do _ read-received Typed
    (param id SyntaxId)
    (param name Atom)
    ; Reads a member of a markup element being built by its name alone: the property of the
    ; element `received-object` finds.
    (let object (call received-object id name))
    (return (call load-property id (. object operand) (. object type) name))
  )
  (fn-do _ received-object Typed
    (param id SyntaxId)
    (param name Atom)
    ; The object of the markup element whose member a name alone reads or assigns, with its class
    ; as the value's type: the innermost element whose class has it (`received-position`), or in a
    ; function written in the element's body, the element kept where it was made (`read-kept`).
    (let kept (call received-kept id))
    (if (!= kept no-slot)
      (return (call read-kept kept id))
    )
    (let position (call received-position name))
    (if (not position)
      (call refuse .refused-expression id)
      (return (call Typed (call make-operand .operand-void 0) no-type))
    )
    (return ([] content-hosts position))
  )
  (fn-do _ read-unmade Typed
    (param id SyntaxId)
    (param name Atom)
    ; The name of a markup element of a class's markup read in a closure the markup makes before
    ; the element is made: the receiver's property of the name, as the reference reads it, which
    ; panics where the closure runs before the element is made.
    (if (not (. unit has-self))
      (call refuse .refused-expression id)
      (return (call Typed (call make-operand .operand-void 0) no-type))
    )
    (return (call guard-element id (call load-property id (. unit self) (. unit owner-type) name) name))
  )
  (fn-expr _ received-kept SlotId
    (param id SyntaxId)
    ; The local that keeps the object of the markup element whose member a name alone reads, where
    ; the read is in a function written in the element's body, or none.
    (if-expr (!= binding no-binding) (. (call (. bindings resolution-of) binding id) slot) no-slot)
    (where
      (lazy binding (. ([] (. instances rows) (. unit reading)) binding))
    )
  )
  (fn-do _ read-kept Typed
    (param kept SlotId)
    (param site SyntaxId)
    ; The object of a markup element, kept where it was made, read in a function written in its
    ; body, with its type as the value's.
    (let found (call find-captured kept site))
    (let object (call read-captured kept site (. found type)))
    (return (call Typed (. object operand) (. found type)))
  )
  (fn-do _ received-position (? Size)
    (param name Atom)
    ; Where the innermost markup element being built whose class has a member of a name is kept,
    ; apart from one whose class's markup declares that member for an element, which is hidden
    ; there.
    (let position (. content-hosts length))
    (while (!= position 0)
      (-= position 1)
      (let parent (. ([] content-hosts position) type))
      (let place (only-if (call (. types property-named) parent name) (if (== (call intrinsic parent) .class))))
      (if (and place (not (call names-element types ([] (. types properties) place))))
        (return position)
      )
    )
    (return null)
  )
  (fn-do _ make-action Typed
    (param trackers Operand)
    (param code FunctionId)
    (param data Operand)
    (param site SyntaxId)
    ; A live action with the trackers given and a callback that calls a function with the data
    ; given.
    (let live (. instances live))
    (if (== (. live action) no-instance)
      (call refuse .refused-function site)
      (return (call Typed (call make-operand .operand-void 0) no-type))
    )
    (let callback (call make-callback code data site))
    (let mark (. pending length))
    (+= pending trackers)
    (+= pending callback)
    (return (call call-instance (. live action) site mark))
  )
  (fn-do _ make-callback Operand
    (param code FunctionId)
    (param data Operand)
    (param site SyntaxId)
    ; A callback that calls a function with the data given.
    (let layout (. tables layouts function-layout))
    (if (or (== layout no-layout) (== code no-function))
      (call refuse .refused-function site)
      (return (call make-operand .operand-void 0))
    )
    (call (. ir depend) .callee-function code 0)
    (let callback (call frame layout))
    (call store callback 0 (call make-operand .operand-symbol (. ([] (. tables functions) code) symbol)) false site)
    (call store callback (. (call (. tables layouts field) layout 1) offset) data false site)
    (return callback)
  )
  (fn-do _ attach-action _
    (param owner Operand)
    (param action Operand)
    (param site SyntaxId)
    ; Gives an object a live action to own, in the list of its actions in a side lane of the
    ; collector, which its `close` closes.
    (let live (. instances live))
    (let actions (call side-list site owner 1 (. live actions)))
    (let adding (. pending length))
    (+= pending (. actions operand))
    (+= pending action)
    (do
      (inline (call call-instance (. live add-action) site adding))
    )
  )
  (fn-do _ emit-stream Typed
    (param id SyntaxId)
    (param expr SyntaxId)
    ; A stream of a value as it changes, as the reference makes it: the value is evaluated while a
    ; live action of its own is open, whose trackers note what it reads; the channel the type pass
    ; found is made, given the value by `<-write`, and kept in the local no name reaches declared at
    ; the stream; then the action is made with those trackers and a callback that writes the value
    ; again through the function written for it, given the environment in force here.
    (let nothing (call make-operand .operand-void 0))
    (let row (call (. tables live-statement-of) (. unit reading) id))
    (let code
      (block
        (case? (and row (!= (. row rerun) no-instance))
          ([] (. tables instance-functions) (. row rerun))
        )
        (default
          no-function
        )
      )
    )
    (let slot (call channel-slot id))
    (let made (call stream-call id .call-constructor))
    (let write (call stream-call id .call-method))
    (if (or (== code no-function) (== slot no-slot) (== made no-fact) (== write no-fact))
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (let trackers (call open-trackers id))
    (+= live-actions (call LiveTrackers trackers trackers))
    (let value (call emit-expression expr))
    (let held (. value type))
    (call (. live-actions pop))
    (let type (call (. facts node-type) (. unit reading) id))
    (let channel (call emit-fact-call id ([] (. facts calls) made) 0 (call (of RowRange SyntaxId)) 0 0 type))
    (if (!= (. channel type) type)
      (call refuse .refused-conversion id)
    )
    (do
      (inline (call call-protocol id write (. channel operand) type (. value operand) held false))
    )
    (call keep-captured slot (. channel operand) type id)
    (do
      (inline
        (call make-action (call load-local trackers id) adapter (call written-environment id) id
          (block
            (lazy adapter (call (. tables live-adapter-of) code))
          )
        )
      )
    )
    (return (call Typed (. channel operand) type))
  )
  (fn-do _ stream-call FactId (?! Refused)
    (param id SyntaxId)
    (param form CallForm)
    ; The call of a form the type pass recorded at a stream of a value as it changes: the constructor
    ; of its channel, or its `<-write`.
    (let fact (call (. facts first-call) (. unit reading) id))
    (while (!= fact no-fact)
      (if (== (. ([] (. facts calls) fact) form) form)
        (return fact)
      )
      (= fact (. ([] (. facts calls) fact) next))
    )
    (return no-fact)
  )
  (fn-do _ decl-name (? Atom)
    (param module ModuleId)
    (param decl DeclId)
    ; The name of a property declared in a module.
    (match? ([] (. ([] (. program modules) module) decls) decl)
      (case (call .decl-property row)
        (return (. row name))
      )
    )
    (return null)
  )
  (fn-do _ enter-query MarkupQuery
    ; Begins a function made for a markup query, whose data, the object, is its first argument,
    ; read as an object of the class that declares the query, in the module that writes it: it
    ; answers a `Bool`.
    (let query ([] (. facts markup-queries) (. function place)))
    (= unit (= (. unit source-module) (. query module)))
    (= unit (= (. unit has-self) true))
    (= unit (= (. unit self-type) (. query level)))
    (= unit (= (. unit self) (call make-operand .operand-argument 0)))
    (= returns-type (. types bool-type))
    (= (. ir returns) (call layout-of (. types bool-type) (. query site)))
    (return query)
  )
  (fn-do _ host-object Typed
    (param site SyntaxId)
    (param host Operand)
    (param type TypeId)
    (param missed IRBlockId)
    ; The object a markup host holds, as an object of a class, as the reference reads it for a
    ; query of the markup: where the object, by its own table, is of the class or of one derived
    ; from it, and else it leaves to `missed`.
    (let object (call load host 0 managed-layout site))
    (let passed (call (. ir reserve-block)))
    (call class-branch site object type passed missed)
    (call (. ir start-block) passed)
    (return (call Typed object type))
  )
  (fn-do _ emit-descendant-query _
    (param removes Bool)
    ; A function made for a descendant query of the markup an object is in, which the markup
    ; runtime runs with a markup host and the object as its data: where the host's object is of
    ; the class the query looks for, the markup runtime adds it to the list the property holds, in
    ; the order of the markup, or takes it from it, and where that changed the list it is stored
    ; again, which runs what reads the property though the list is the same. It answers whether
    ; the list changed.
    (let written ([] (. facts markup-queries) (. function place)))
    (let host-type (. ([] (. facts conversions) (. written hosted)) to))
    (let host-layout (call layout-of host-type (. written site)))
    (call (. ir add-argument) managed-layout)
    (call (. ir add-argument) host-layout)
    (let query (call enter-query))
    (let site (. query site))
    (let object (if-expr (call (. tables is-class) (. query level)) ([] (. tables layouts objects) (. query level)) no-layout))
    (let property ([] (. types properties) (. query place)))
    (let callee (if-expr removes (. query remove) (. query add)))
    (if (or (== object no-layout) (== callee no-instance))
      (call refuse .refused-function site)
      (return)
    )
    (let candidate (call (. ir add-local) host-layout))
    (call store-local candidate (call make-operand .operand-argument 1) site)
    (let field (call (. tables layouts field) object (+ object-header-fields (. property slot))))
    (let owner (call convert-one site ([] (. facts conversions) (. query hosted)) (call Typed (. unit self) (. query level))))
    (let missed (call (. ir reserve-block)))
    (let target (call host-object site (call load-local candidate site) (. query target) missed))
    (let current (call field-value (. unit self) field site))
    (let mark (. pending length))
    (+= pending current)
    (+= pending (. owner operand))
    (+= pending (. target operand))
    (let changed (call call-instance callee site mark))
    (let storing (call (. ir reserve-block)))
    (let done (call (. ir reserve-block)))
    (call branch (. changed operand) storing done)
    (call (. ir start-block) storing)
    (call put-property (. unit self) field property (call field-value (. unit self) field site) site (. U32 max) true)
    (call jump done)
    (call (. ir start-block) done)
    (call return-value (. changed operand) site)
    (call (. ir start-block) missed)
    (call return-value (call integer .machine-u8 0) site)
  )
  (fn-expr _ is-default Bool
    (param application StyleApplication)
    (param level TypeId)
    ; Whether a style rule applied by this instance is one of the defaults of the class `level`.
    (and own-base (== (. application outer) (. U32 max)) (== (. application made) level))
    (where
      (lazy own-base (and (== (. application instance) (. unit instance)) (== (. application layer) 0)))
    )
  )
  (fn-do _ section-of SyntaxId
    (param rule ClassRule)
    ; The loop of a rule that is a section, or none.
    (match? ([] (. ([] (. program modules) (. rule module)) tree nodes) (. rule syntax))
      (case (call .node-subscriber-syntax section)
        (return (. section iterator))
      )
    )
    (return 0)
  )
  (fn-do _ enter-unit UnitRun
    (param unit-id InstanceId)
    ; Makes the function emitted that of another instance for a while, whose locals are its own for
    ; the run, and answers what the function kept of its own.
    (let run (call UnitRun unit in-zone block-effects))
    (= block-effects 0)
    (call read-instance unit-id)
    (call bind-slots)
    (call clear-lazies)
    (return run)
  )
  (fn-do _ leave-unit _
    (param run UnitRun)
    ; Puts back what `enter-unit` kept of the function's own.
    (= unit (. run unit))
    (= in-zone (. run in-zone))
    (= block-effects (. run block-effects))
  )
  (fn-do _ forward-builder Typed
    (param line SyntaxId)
    (param forwarded Typed)
    ; The builder a line that forwards a slot gives where it holds state cells (`SlotForward`): the
    ; function of `slot-forward-functions` for it, with what it keeps, the builder `forwarded` it
    ; forwards and each cell, as made or given here. The builder forwarded where it holds none.
    (let index (. U32 max))
    (for (in position (..< 0 (. facts slot-forwards length)))
      (if (and (== (. ([] (. facts slot-forwards) position) instance) (. unit reading)) same-line)
        (= index (as position U32))
      )
      (lazy same-line (== (. ([] (. facts slot-forwards) position) line) line))
    )
    (if (== index (. U32 max))
      (return forwarded)
    )
    (let builder (. forwarded type))
    (let function-layout (call layout-of builder line))
    (let layout ([] (. tables slot-forward-layouts) index))
    (if (!= function-layout (. tables layouts function-layout))
      (call refuse .refused-expression line)
      (return forwarded)
    )
    (let mark (. pending length))
    (+= pending (call integer .machine-u64 (. ([] (. tables layouts rows) layout) size)))
    (+= pending (call make-operand .operand-descriptor layout))
    (let kept (call (. ir add-local) managed-layout))
    (call store-local kept (call call-runtime .runtime-allocate-object line mark managed-layout) line)
    (call store
      (block
        (arg (call load-local kept line))
        (arg (. (call (. tables layouts field) layout 0) offset))
        (arg (call load (. forwarded operand) 0 pointer-layout line))
        (arg false)
        (arg line)
      )
    )
    (call store
      (block
        (arg (call load-local kept line))
        (arg (. (call (. tables layouts field) layout 1) offset))
        (arg (call load (. forwarded operand) (. (call (. tables layouts field) function-layout 1) offset) managed-layout line))
        (arg true)
        (arg line)
      )
    )
    (let place U32)
    (for (in held (. facts outlet-cells))
      (if (or (!= (. held instance) (. unit reading)) (!= (. held outlet) line))
        (continue)
      )
      (let local (call cell-local (. held cell)))
      (if (== local no-local)
        (call refuse .refused-expression line)
        (return forwarded)
      )
      (call store
        (block
          (arg (call load-local kept line))
          (arg (. (call (. tables layouts field) layout (+ 2 place)) offset))
          (arg (call load-local local line))
          (arg true)
          (arg line)
        )
      )
      (+= place 1)
    )
    (let code ([] (. tables slot-forward-functions) index))
    (call (. ir depend) .callee-function code 0)
    (let made (call frame function-layout))
    (call store made 0 (call make-operand .operand-symbol (. ([] (. tables functions) code) symbol)) false line)
    (call store made (. (call (. tables layouts field) function-layout 1) offset) (call load-local kept line) false line)
    (return (call Typed made builder))
  )
  (fn-do _ emit-event-handler _
    ; The function the event runtime calls for a section of a class that it runs from the table of
    ; the class, given the object and what was published, as the reference compiles it: the body of
    ; the section's subscriber, given the environment the section would make for the object, as
    ; the constructor would subscribe it (see `open-handler`). It returns nothing: an error its
    ; subscriber lets out is given to the global `unhandled-error` where it leaves (see
    ; `hand-off`).
    (let handler ([] (. tables event-handlers) (. function place)))
    (if (or (== (. unit instance) no-instance) unhandled-raise)
      (call refuse .refused-function (. handler syntax))
      (return)
    )
    (lazy unhandled-raise (and (!= (. ([] (. instances signatures) (. unit instance)) errors count) 0) (not (. facts unhandled-error))))
    (call emit-body)
  )
  (fn-do _ open-handler _
    ; Makes the environment a section of a class would make for the object the function the event
    ; runtime calls for it is given, as its first argument, which the body of the section's
    ; subscriber then reads as the environment it was given.
    (let handler ([] (. tables event-handlers) (. function place)))
    (= unit (= (. unit reading) (. handler unit)))
    (= unit (= (. unit self) (call make-operand .operand-argument 0)))
    (= unit (= (. unit self-type) (. handler level)))
    (= unit (= (. unit owner-type) (. handler level)))
    (= unit (= (. unit has-self) true))
    (= made-environment (call lone-environment (. handler syntax) no-slot))
    (= unit (= (. unit reading) (. unit instance)))
    (= unit (= (. unit self) (call make-operand .operand-void 0)))
    (= unit (= (. unit self-type) no-type))
    (= unit (= (. unit owner-type) (. ([] (. instances rows) (. unit instance)) self-type)))
    (= unit (= (. unit has-self) false))
  )
  (fn-do _ init-site SyntaxId
    ; Where the reference places the call of a module's main from its init: at the constructor of
    ; the class whose sections it puts last in the event runtime's tables at the head of the init,
    ; or nowhere.
    (let making (call (. tables init-constructor) (. function module)))
    (if (or (== making no-instance) (!= (. ([] (. instances rows) making) module) (. function module)))
      (return 0)
    )
    (let row ([] (. instances rows) making))
    (match? ([] (. ([] (. program modules) (. row module)) decls) (. row decl))
      (case (call .decl-function fn)
        (return (if-expr (. fn is-generated) (call class-site (. row module) (. fn owner)) (. fn syntax)))
      )
    )
    (return 0)
  )
  (fn-do _ emit-event-matcher _
    ; The function the event runtime asks whether an object is of a class whose table runs sections,
    ; and not of a class below it: the table the object names is the class's own.
    (let symbol ([] (. tables table-symbols) (. function type)))
    (call (. ir add-argument) pointer-layout)
    (= returns-type (. types bool-type))
    (= (. ir returns) u8-layout)
    (if (== symbol no-string)
      (call refuse-class (. function type))
      (return)
    )
    (let table (call load (call make-operand .operand-argument 0) 0 pointer-layout 0))
    (call return-value (call compare 0 .compare-equal table (call make-operand .operand-symbol symbol)) 0)
  )
  (fn-do _ emit-idle-action _
    ; The function the live action that owns a subscription or the endpoint at the address of a
    ; keyed event calls, which does nothing: the subscription delivers to its subscriber itself,
    ; and the endpoint is only closed with the action.
    (let live (. instances live))
    (call (. ir add-argument) managed-layout)
    (= returns-type (. types void-type))
    (= (. ir returns) void-layout)
    (let site (. tables idle-site))
    (= unit (= (. unit source-module) (. ([] (. instances rows) (. tables idle-instance)) module)))
    (if (!= (. live callback-result) no-type)
      (call return-results (. live callback-result) site)
    )
    (call return-value (call make-operand .operand-void 0) site)
  )
  (fn-do _ side-list Typed
    (param site SyntaxId)
    (param object Operand)
    (param lane U64)
    (param maker InstanceId)
    ; The list an object keeps in a side lane of the collector: the subscribers of its properties
    ; in lane 0, its live actions in lane 1. One is made and published there where it has none.
    (let owner (call num-cast site object managed-layout pointer-layout))
    (let mark (. pending length))
    (+= pending owner)
    (+= pending (call integer .machine-u64 lane))
    (let raw (call call-runtime .runtime-object-side-payload site mark managed-layout))
    (let held (call (. ir add-local) managed-layout))
    (call store-local held raw site)
    (let making (call (. ir reserve-block)))
    (let ready (call (. ir reserve-block)))
    (call branch
      (block
        (arg
          (call compare
            (block
              (arg site)
              (arg .compare-equal)
              (arg (call num-cast site raw managed-layout u64-layout))
              (arg (call integer .machine-u64 0))
            )
          )
        )
        (arg making)
        (arg ready)
      )
    )
    (call (. ir start-block) making)
    (let made (call call-instance maker site (. pending length)))
    (let publishing (. pending length))
    (+= pending owner)
    (+= pending (call integer .machine-u64 lane))
    (+= pending (. made operand))
    (call store-local
      (block
        (arg held)
        (arg (call call-runtime .runtime-publish-side-payload site publishing managed-layout))
        (arg site)
      )
    )
    (call jump ready)
    (call (. ir start-block) ready)
    (return (call Typed (call load-local held site) (. made type)))
  )
  (fn-do _ put-property _
    (param object Operand)
    (param field LayoutField)
    (param property TypeProperty)
    (param value Operand)
    (param site SyntaxId)
    (param flag-offset U32 (= (. U32 max)))
    (param always Bool (= false))
    (param memo-flag U32 (= (. U32 max)))
    ; Stores a value in a property of an object as an assignment does: a managed pointer through
    ; the write barrier, and a struct by a copy, and a lazy property is marked, at `flag-offset`,
    ; as having its value. A property whose value is a memo has its flag, at `memo-flag`, cleared,
    ; so a read keeps the value stored. A property some read tracks keeps a copy of its bits from
    ; before the store and runs the actions that read it where they changed, or `always`. One that
    ; holds nothing has no shape there yet.
    (let tracked (call tracks property))
    (if (and tracked (== (. field layout) void-layout))
      (call refuse .refused-statement site)
      (return)
    )
    (let prior (call make-operand .operand-void 0))
    (if tracked
      (= prior
        (block
          (case? (call (. tables layouts is-struct) (. field layout))
            (call snapshot (call field-value object field site) (. field layout) site)
          )
          (default
            (call load object (. field offset) (. field layout) site)
          )
        )
      )
    )
    (if (call (. tables layouts is-struct) (. field layout))
      (call store-struct object field value site)
      (else-if (!= (. field layout) void-layout)
        (call store object (. field offset) value (call is-managed-pointer (. field layout)) site)
      )
    )
    (if (!= flag-offset (. U32 max))
      (call store-release object flag-offset (call integer .machine-u8 1) site)
    )
    (if (!= memo-flag (. U32 max))
      (call store object memo-flag (call integer .machine-u8 0) false site)
    )
    (if tracked
      (call dispatch-change
        (block
          (arg object)
          (arg prior)
          (arg (call field-value object field site))
          (arg (. field layout))
          (arg (. property name))
          (arg site)
          (arg always)
        )
      )
    )
  )
  (fn-do _ dispatch-change _
    (param object Operand)
    (param prior Operand)
    (param latest Operand)
    (param layout LayoutId)
    (param name Atom)
    (param site SyntaxId)
    (param always Bool (= false))
    ; Runs the actions that read a tracked property of an object where a store changed its bits,
    ; as `bits-differ` says, or `always`. Nothing runs where the object keeps no list of
    ; subscribers.
    (let live (. instances live))
    (let changed
      (scope (if-expr (not always) (call bits-differ prior latest layout site) unchanged)
        (lazy unchanged (call make-operand .operand-void 0))
      )
    )
    (let checking (call (. ir reserve-block)))
    (let sending (call (. ir reserve-block)))
    (let done (call (. ir reserve-block)))
    (if always
      (call jump checking)
      (else
        (call branch changed checking done)
      )
    )
    (call (. ir start-block) checking)
    (let mark (. pending length))
    (+= pending (call num-cast site object managed-layout pointer-layout))
    (+= pending (call integer .machine-u64 0))
    (let subscribers (call call-runtime .runtime-object-side-payload site mark managed-layout))
    (call branch
      (block
        (arg
          (call compare
            (block
              (arg site)
              (arg .compare-not-equal)
              (arg (call num-cast site subscribers managed-layout u64-layout))
              (arg (call integer .machine-u64 0))
            )
          )
        )
        (arg sending)
        (arg done)
      )
    )
    (call (. ir start-block) sending)
    (let sent (. pending length))
    (+= pending subscribers)
    (+= pending (call make-operand .operand-constant (call (. ir add-string) (. name text))))
    (do
      (inline (call call-instance (. live dispatch) site sent))
    )
    (call jump done)
    (call (. ir start-block) done)
  )
  (fn-do _ bits-differ Operand (?! Refused)
    (param prior Operand)
    (param latest Operand)
    (param layout LayoutId)
    (param site SyntaxId)
    ; Whether two stored values differ in their bits: a float by its bits, not its value, a
    ; reference by what it points at, a struct by each of its fields, and a union by the case it
    ; holds and, where both hold one case, by that case's value, as the reference compares the
    ; value whole.
    (if (not (call (. tables layouts is-struct) layout))
      (return
        (call compare
          (block
            (arg site)
            (arg .compare-not-equal)
            (arg (call stored-bits prior layout site))
            (arg (call stored-bits latest layout site))
          )
        )
      )
    )
    (if (call (. tables layouts is-union) layout)
      (let cases
        (call compare
          (block
            (arg site)
            (arg .compare-not-equal)
            (arg (call load prior 0 u8-layout site))
            (arg (call load latest 0 u8-layout site))
          )
        )
      )
      (for (in index (..< 0 (. ([] (. tables layouts rows) layout) cases count)))
        (let field (call (. tables layouts case-field) layout index))
        (if (== (. field type) (. types void-type))
          (continue)
        )
        (let part
          (call bits-differ
            (block
              (arg (call field-value prior field site))
              (arg (call field-value latest field site))
              (arg (. field layout))
              (arg site)
            )
          )
        )
        (let held (call bitwise site .bitwise-and (call case-test site prior index) part u8-layout))
        (= cases (call bitwise site .bitwise-or cases held u8-layout))
      )
      (return cases)
    )
    (let differ (call integer .machine-u8 0))
    (for (in index (..< 0 (. ([] (. tables layouts rows) layout) fields count)))
      (let field (call (. tables layouts field) layout index))
      (let part
        (call bits-differ
          (block
            (arg (call field-value prior field site))
            (arg (call field-value latest field site))
            (arg (. field layout))
            (arg site)
          )
        )
      )
      (= differ (call bitwise site .bitwise-or differ part u8-layout))
    )
    (return differ)
  )
  (fn-do _ field-value Operand
    (param base Operand)
    (param field LayoutField)
    (param site SyntaxId)
    ; A field held in memory: a struct as its address, and anything else loaded.
    (if (call (. tables layouts is-struct) (. field layout))
      (return (call address base (. field offset) (. field layout) site))
    )
    (return (call load base (. field offset) (. field layout) site))
  )
  (fn-do _ stored-bits Operand
    (param value Operand)
    (param layout LayoutId)
    (param site SyntaxId)
    ; A stored value as the bits it is stored as: a float is read back from memory as an integer of
    ; its width.
    (if (and (!= layout f64-layout) (!= layout f32-layout))
      (return value)
    )
    (let held (call frame layout))
    (call store held 0 value false site)
    (return (call load held 0 (if-expr (== layout f64-layout) u64-layout u32-layout) site))
  )
  (fn-do _ closes-actions Bool
    ; Whether the function is a class's `close` that takes no arguments, which closes the live
    ; actions the object owns, where the program makes any, and stops the machines its properties hold
    ; and its markup writes, where the program starts any, as it starts, and closes the live actions
    ; made since and the object's events, where its class has any, and cancels the tasks it owns,
    ; where the program spawns any an object owns, as it leaves.
    (if (or (== (. unit instance) no-instance) (not (. unit has-self)) (!= (. function kind) .instance-body))
      (return false)
    )
    (if (and (== (. instances live has-actions) no-instance) (not (call closes-events)) (not (call stops-machines)) (not (. tables owns-tasks)))
      (return false)
    )
    (if (not (call (. tables is-class) (. unit owner-type)))
      (return false)
    )
    (let row ([] (. instances rows) (. unit instance)))
    (match? ([] (. ([] (. program modules) (. row module)) decls) (. row decl))
      (case (call .decl-function fn)
        (if (and (!= (. fn owner) 0) (== (. fn args count) 0) (. fn name))
          (let named (. fn name))
          (return (== (. named text) "close"))
        )
      )
    )
    (return false)
  )
  (fn-do _ stop-owned _
    (param site SyntaxId)
    ; Closes each live action the receiver owns, then stops each machine its properties hold and its
    ; markup writes, as the event runtime keeps them (`event-stop-machines`), before the body of
    ; `close` runs: nothing the object does again on its own runs while the body closes what it owns,
    ; and the machines' exit rows see the object as it was.
    (if (!= (. instances live has-actions) no-instance)
      (call close-actions site (. unit self))
    )
    (if (call stops-machines)
      (let stopping (. pending length))
      (+= pending (call num-cast site (. unit self) managed-layout pointer-layout))
      (do
        (inline (call call-instance (. facts machine-stop) site stopping))
      )
    )
  )
  (fn-do _ close-owned _
    (param site SyntaxId)
    ; Closes each live action the receiver owns, taking it off the list the receiver keeps in lane 1,
    ; and then clears the lane, as the reference's `close` does as it leaves; then closes the
    ; receiver's events, where its class has any, or where `stop-owned` stopped its machines; then
    ; cancels the tasks the receiver owns, where the program spawns any an object owns, without
    ; waiting for them or yielding to them. A task that closes its own owner is not cancelled.
    (if (!= (. instances live has-actions) no-instance)
      (call close-actions site (. unit self))
    )
    (if (call closes-events)
      (let mark (. pending length))
      (+= pending (call num-cast site (. unit self) managed-layout pointer-layout))
      (do
        (inline (call call-instance (. facts event-close) site mark))
      )
      (else-if (call closes-stopped)
        (let mark (. pending length))
        (+= pending (call num-cast site (. unit self) managed-layout pointer-layout))
        (do
          (inline (call call-instance (. facts machine-close) site mark))
        )
      )
    )
    (if (. tables owns-tasks)
      (let cancelling (. pending length))
      (+= pending (call num-cast site (. unit self) managed-layout pointer-layout))
      (call call-runtime .runtime-cancel-owned-tasks site cancelling)
    )
  )
  (fn-expr _ stops-machines Bool
    ; Whether the program starts a machine a class's property holds or its markup writes, which each
    ; class's `close` stops (`own-machine`).
    (and (!= (. facts machine-stop) no-instance) (!= ([] (. tables instance-functions) (. facts machine-stop)) no-function))
  )
  (fn-expr _ closes-stopped Bool
    (and (call stops-machines) (!= (. facts machine-close) no-instance) (!= ([] (. tables instance-functions) (. facts machine-close)) no-function))
  )
  (fn-do _ closes-events Bool
    ; Whether the function is a `close` whose class has events, which it closes as it leaves.
    (if (== (. facts event-close) no-instance)
      (return false)
    )
    (for (in closer (. facts event-closers))
      (if (== closer (. unit instance))
        (return true)
      )
    )
    (return false)
  )
  (fn-do _ close-actions _
    (param site SyntaxId)
    (param owner Operand)
    ; Closes each live action an object owns, taking it off the list the object keeps in lane 1,
    ; and then clears the lane.
    (let live (. instances live))
    (let mark (. pending length))
    (+= pending (call num-cast site owner managed-layout pointer-layout))
    (+= pending (call integer .machine-u64 1))
    (let actions (call call-runtime .runtime-object-side-payload site mark managed-layout))
    (let looping (call (. ir reserve-block)))
    (let closing (call (. ir reserve-block)))
    (let clearing (call (. ir reserve-block)))
    (let done (call (. ir reserve-block)))
    (call branch
      (block
        (arg
          (call compare
            (block
              (arg site)
              (arg .compare-not-equal)
              (arg (call num-cast site actions managed-layout u64-layout))
              (arg (call integer .machine-u64 0))
            )
          )
        )
        (arg looping)
        (arg done)
      )
    )
    (call (. ir start-block) looping)
    (let asking (. pending length))
    (+= pending actions)
    (let empty (call call-instance (. live has-actions) site asking))
    (call branch (. empty operand) clearing closing)
    (call (. ir start-block) closing)
    (let popping (. pending length))
    (+= pending actions)
    (let action (call call-instance (. live pop) site popping))
    (let shutting (. pending length))
    (+= pending (. action operand))
    (do
      (inline (call call-method (. live close) site shutting))
    )
    (call jump looping)
    (call (. ir start-block) clearing)
    (let clear (. pending length))
    (+= pending (call num-cast site owner managed-layout pointer-layout))
    (+= pending (call integer .machine-u64 1))
    (call call-runtime .runtime-clear-side-payload site clear)
    (call jump done)
    (call (. ir start-block) done)
  )
  (fn-do _ unread-value Typed
    (param type TypeId)
    (param layout LayoutId)
    (param site SyntaxId)
    ; What a read that never runs stands for: the value a type has with nothing written, in its
    ; layout.
    (if (call (. tables layouts is-struct) layout)
      (return (call null-value type layout site))
    )
    (if (call is-float layout)
      (return (call Typed (call float-number layout 0.0) type))
    )
    (return (call Typed (call integer (call (. tables layouts kind-of) layout) 0) type))
  )
  (fn-do _ emit-globals _
    (param kind GlobalKind)
    ; The function that gives a module's globals of one kind their first values, in the order
    ; they are declared: the constants, before any module starts, or the globals whose values
    ; run code, as the module starts. Each of the second kind is then marked as having its
    ; value. A value nothing reads is evaluated for what it does.
    (let module (. function module))
    (let owner ([] (. program modules) module))
    (= unit (= (. unit source-module) module))
    (= unit (= (. unit reading) ([] (. tables main-instances) module)))
    (for (in index (..< 0 (. owner decls length)))
      (if (!= (call (. tables global-kind) module (as index DeclId)) kind)
        (continue)
      )
      (let row (call (. tables storage-of) module (as index DeclId)))
      (match? ([] (. owner decls) index)
        (case (call .decl-property property)
          (if (== row no-storage)
            (if (and (!= (. property value) 0) (== kind .global-eager))
              (call emit-expression (. property value))
            )
            (else-if (or (!= (. property value) 0) (== kind .global-eager))
              (let kept ([] (. tables storage) row))
              (call store-global kept (. (call global-value kept property) operand) (. property syntax))
              (if (== kind .global-eager)
                (call store
                  (block
                    (arg (call make-operand .operand-symbol (. kept state)))
                    (arg 0)
                    (arg (call integer .machine-u8 1))
                    (arg false)
                    (arg (. property syntax))
                  )
                )
              )
            )
          )
        )
      )
    )
    (call return-nothing)
  )
  (fn-do _ enum-value Typed
    (param kept GlobalStorage)
    (param case CaseDecl)
    (param decl DeclId)
    ; What a module makes for a value of an enum as it starts. A constructor the type pass
    ; recorded where the value is declared makes it, given the value written or nothing. Any
    ; other is the value written, or the number of the value among those its enum declares,
    ; converted as recorded where it is written or declared.
    (let nothing (call make-operand .operand-void 0))
    (let made no-fact)
    (let fact (call (. facts first-call) (. unit reading) (. case syntax)))
    (while (!= fact no-fact)
      (if (== (. ([] (. facts calls) fact) form) .call-constructor)
        (= made fact)
      )
      (= fact (. ([] (. facts calls) fact) next))
    )
    (if (!= made no-fact)
      (let none (call (of RowRange SyntaxId)))
      (let object (call emit-fact-call (. case syntax) ([] (. facts calls) made) 0 none 0 (. case value) (. kept type)))
      (if (!= (. object type) (. kept type))
        (call refuse .refused-conversion (. case syntax))
      )
      (return object)
    )
    (let site (. case syntax))
    (let value (call Typed nothing no-type))
    (if (!= (. case value) 0)
      (= site (. case value))
      (= value (call emit-expression (. case value)))
      (else
        (let counted (call (. types type-row) .int64))
        (let layout (call layout-of counted site))
        (= value (call Typed (call integer (call (. tables layouts kind-of) layout) (call enum-ordinal decl)) counted))
      )
    )
    (if (!= (. value type) (. kept type))
      (= value (call convert site .reason-assignment value))
    )
    (if (!= (. value type) (. kept type))
      (call refuse .refused-conversion site)
    )
    (return value)
  )
  (fn-do _ enum-ordinal U32
    (param decl DeclId)
    ; The number of a value of an enum among those its enum declares, in their order.
    (let owner ([] (. program modules) (. unit source-module)))
    (let declares DeclId 0)
    (match? ([] (. owner decls) decl)
      (case (call .decl-case case)
        (= declares (. case owner))
      )
    )
    (let ordinal U32)
    (for (in index (..< 0 decl))
      (match? ([] (. owner decls) index)
        (case (call .decl-case case)
          (if (== (. case owner) declares)
            (+= ordinal 1)
          )
        )
      )
    )
    (return ordinal)
  )
  (fn-do _ read-enum Typed
    (param id SyntaxId)
    ; A value of an enum named: read from where the module that declares it keeps it, which made
    ; it as it started.
    (let nothing (call make-operand .operand-void 0))
    (let constant (call (. facts constant-of) (. unit reading) id))
    (if (== constant no-fact)
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (let bits (. ([] (. facts constants) constant) bits))
    (let module ModuleId (as (/ bits 4294967296) U32))
    (let decl DeclId (as (% bits 4294967296) U32))
    (if (or (>= module (. program modules length)) (>= decl (. ([] (. program modules) module) decls length)))
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (let row (call (. tables storage-of) module decl))
    (if (or (== row no-storage) (!= (call (. tables global-kind) module decl) .global-enum))
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (let kept ([] (. tables storage) row))
    (if (!= (. kept type) (call (. facts node-type) (. unit reading) id))
      (call refuse .refused-conversion id)
      (return (call Typed nothing no-type))
    )
    (return (call load-global kept id))
  )
  (fn-do _ emit-statics _
    ; The function that makes what a module keeps of its types as it starts, before its globals
    ; have their values, as TypeScript's statics: the values of its enums that an emitted
    ; function reads, in the order they are declared, then the defaults of its parameters that
    ; run code and are kept, once each.
    (let module (. function module))
    (let owner ([] (. program modules) module))
    (= unit (= (. unit source-module) module))
    (= unit (= (. unit reading) ([] (. tables main-instances) module)))
    (for (in index (..< 0 (. owner decls length)))
      (let row (call (. tables storage-of) module (as index DeclId)))
      (if (or (== row no-storage) (!= (call (. tables global-kind) module (as index DeclId)) .global-enum))
        (continue)
      )
      (match? ([] (. owner decls) index)
        (case (call .decl-case case)
          (let kept ([] (. tables storage) row))
          (call store-global kept (. (call enum-value kept case (as index DeclId)) operand) (. case syntax))
        )
      )
    )
    (let default (call (. tables first-default) (. function module)))
    (while (!= default no-storage)
      (let kept ([] (. tables storage) default))
      (= unit (= (. unit reading) (. kept owner)))
      (let value (call emit-expression (. kept syntax)))
      (if (!= (. value type) (. kept type))
        (call refuse .refused-conversion (. kept syntax))
      )
      (call store-global kept (. value operand) (. kept syntax))
      (= default (. kept next))
    )
    (call return-nothing)
  )
  (fn-do _ emit-argument-default _
    ; The function that evaluates the default of a parameter, which each call that leaves the
    ; argument out calls: it answers the default's value, typed by the instance whose parameter it
    ; is.
    (let kept ([] (. tables storage) (. function place)))
    (= unit (= (. unit source-module) (. ([] (. instances rows) (. kept owner)) module)))
    (= unit (= (. unit reading) (. kept owner)))
    (= returns-type (. kept type))
    (= (. ir returns) (call layout-of (. kept type) (. kept syntax)))
    (let value (call emit-expression (. kept syntax)))
    (if (!= (. value type) (. kept type))
      (call refuse .refused-conversion (. kept syntax))
    )
    (call return-value (. value operand) (. kept syntax))
  )
  (fn-do _ emit-stream-action _
    ; The function the reference runs an action of a grammar in, which a panic in it
    ; shows. It is given what the arm binds that the action reads, in the order the type pass
    ; recorded them: `location`, `it` and the names the match captures. It binds each, runs the
    ; action and answers its value, or in an instance that raises errors its value or one of
    ; them, as `return-results` says.
    (let row ([] (. facts outlined) (. function place)))
    (let body SyntaxId 0)
    (match? ([] (. tree nodes) (. row arm))
      (case (call .node-stream-transform arm)
        (= body (. arm right))
      )
    )
    (let type (call (. facts node-type) (. unit reading) (. row arm)))
    (if (or (== body 0) (== type no-type) (== type invalid-type))
      (call refuse .refused-function (. row arm))
      (return)
    )
    (let named (. bound length))
    (for (in position (..< (. row params start) (+ (. row params start) (. row params count))))
      (let given ([] (. facts action-types) position))
      (+= bound
        (call BoundValue
          (block
            (arg ([] (. facts action-slots) position))
            (arg given)
            (arg (call make-operand .operand-argument (. ir arguments length)))
          )
        )
      )
      (call (. ir add-argument) (call layout-of given (. row arm)))
    )
    (= returns-type type)
    (= (. ir returns) (call layout-of type (. row arm)))
    (if (!= (. ([] (. instances signatures) (. row instance)) errors count) 0)
      (call return-results (. row result) (. row arm))
    )
    (let value (call arm-value (. row arm) body type))
    (call return-value (. value operand) body)
    (call drop-bound named)
  )
  (fn-do _ emit-pattern-helper _
    ; The function the reference makes of a pattern given to a rule where it is written,
    ; `static-inline-match-direct`: it takes what the function of a rule takes but the arguments
    ; written, matches the pattern from the cursor as a rule's arms are matched, and returns an
    ; optional of what the pattern gives, which holds nothing where it did not match. One written
    ; under a helper takes the helper as a rule typed for it does, and runs under it; under one
    ; that can roll back, it gives the rollback mark it holds as a rule does. Last it takes the
    ; data the value it is passed as holds: the address of what the names the type pass kept
    ; for it held where the pattern was passed, which it binds each name to, and reads the
    ; arguments of the rule it is written in from where it runs a local rule of that rule. One
    ; that runs a local rule of a rule that raises errors as a function returns its answer or one
    ; of them, as `return-results` says, and the rule it is given to lets an error pass to the
    ; rule that wrote it.
    (let row ([] (. facts pattern-arguments) (. function place)))
    (let pattern SyntaxId 0)
    (match? ([] (. tree nodes) (. row syntax))
      (case (call .node-stream-match written)
        (= pattern (. written pattern))
      )
    )
    (if (== pattern 0)
      (call refuse .refused-function (. row syntax))
      (return)
    )
    (call (. ir add-argument) (call layout-of (. row stream) (. row syntax)))
    (= returns-type (. row answer))
    (= (. ir returns) (call layout-of (. row answer) (. row syntax)))
    (let raised (call (. tables pattern-raises) (. row instance) (. row syntax)))
    (if (!= raised no-type)
      (call return-results raised (. row syntax))
    )
    (if (not (call direct-arguments (. row buffer) (. row syntax) (. row helper) (call helper-marks (. row helper))))
      (return)
    )
    (let given (call make-operand .operand-argument (. ir arguments length)))
    (call (. ir add-argument) pointer-layout)
    (let named (. bound length))
    (if (!= (. row params count) 0)
      (let layout (call (. tables pattern-environment) (. function place)))
      (if (== layout no-layout)
        (call refuse .refused-function (. row syntax))
        (return)
      )
      (for (in offset (..< 0 (. row params count)))
        (let position (+ (. row params start) offset))
        (+= bound
          (call BoundValue
            (block
              (arg ([] (. facts action-slots) position))
              (arg ([] (. facts action-types) position))
              (arg (call take given (call (. tables layouts field) layout offset) (. row syntax)))
            )
          )
        )
      )
    )
    (= given-slots true)
    (= rule-arguments
      (scope (!= (call rule-match program instance-module (. ([] (. instances rows) (. unit instance)) decl)) 0)
        (lazy instance-module (. ([] (. instances rows) (. unit instance)) module))
      )
    )
    (let views (call (. facts first-call) (. unit reading) (. row syntax)))
    (call match-direct
      (block
        (arg (. row syntax))
        (arg (. row syntax))
        (arg pattern)
        (arg (. row result))
        (arg (. row answer))
        (arg (. row stream))
        (arg (. row buffer))
        (arg 1)
        (arg views)
        (arg (call next-call views))
        (arg (. row syntax))
      )
    )
    (call drop-bound named)
  )
  (fn-do _ emit-pattern-cast _
    ; The function the reference passes for a pattern given to a rule that is a call of a rule a
    ; module declares written alone, `Casting`: it takes what the rule's function takes and runs
    ; it, at the call, as the reference's cast of that function to the type the parameter takes
    ; does. One written under a helper takes the helper, which it gives a rule typed for it; under
    ; one that can roll back, it gives the rollback mark the rule gives, or none where the rule
    ; gives none. Last it takes the data the value it is passed as holds, which is none.
    (let row ([] (. facts pattern-arguments) (. function place)))
    (let signature ([] (. instances signatures) (. row rule)))
    (let site (. row syntax))
    (match? ([] (. tree nodes) (. row syntax))
      (case (call .node-stream-match written)
        (= site (. written pattern))
      )
    )
    (let helped (. ([] (. instances rows) (. row rule)) helper))
    (let carried (call carries (. row rule)))
    (let marked (call helper-marks (. row helper)))
    (if (or other-shape unfit-stream (and (!= helped no-type) (!= helped (. row helper))) unmarked-state)
      (call refuse .refused-function site)
      (return)
    )
    (lazy other-shape (or (!= (. signature returns) (. row answer)) (!= (. signature args count) 1)))
    (lazy unfit-stream (or (!= (. signature errors count) 0) (!= (call (. instances argument-type) (. row rule) 0) (. row stream))))
    (lazy unmarked-state (or (!= (. collector-args length) 0) (and carried (or (== helped no-type) (not marked)))))
    (call (. ir add-argument) (call layout-of (. row stream) site))
    (= returns-type (. row answer))
    (= (. ir returns) (call layout-of (. row answer) site))
    (if (not (call direct-arguments (. row buffer) site (. row helper) marked))
      (return)
    )
    (call (. ir add-argument) pointer-layout)
    (if marked
      (call open-marks (. row syntax))
      (if (== (. streaming rollback-mark) no-local)
        (call refuse .refused-function site)
        (return)
      )
    )
    (let mark (. pending length))
    (for (in position (..< 0 7))
      (+= pending (call make-operand .operand-argument (as position U32)))
    )
    (if (!= helped no-type)
      (+= pending (. streaming pattern-helper))
    )
    (if carried
      (+= pending (. streaming marked-argument))
    )
    (= calls-rule true)
    (let answer (call call-instance (. row rule) site mark))
    (if (and marked (not carried))
      (call give-mark site)
    )
    (call return-value (. answer operand) site)
  )
  (fn-do _ direct-arguments Bool
    (param buffer-type TypeId)
    (param site SyntaxId)
    (param helper TypeId (= no-type))
    (param marked Bool (= false))
    ; Adds the arguments every function a grammar calls takes after the stream and those
    ; written: the address the items start at, the cursor and the count of items, and the
    ; addresses of where it ended, how far it read and the farthest cursor a part failed at; then
    ; the helper of the pattern calling it, where it is given one; then where to keep the rollback
    ; mark it holds as it passes, where it is `marked`; then a pointer to each collector a set of
    ; them gives it. A buffer that is no array has no shape here.
    (let index-layout (call layout-of (. types index-type) site))
    (let buffer-layout (call layout-of buffer-type site))
