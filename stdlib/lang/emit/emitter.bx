      (return capture)
    )
    (if (== layout no-layout)
      (return capture)
    )
    (let mark (. pending length))
    (+= pending (call integer .machine-u64 (. ([] (. tables layouts rows) layout) size)))
    (if (. ([] (. tables layouts rows) layout) is-managed)
      (+= pending (call make-operand .operand-descriptor layout))
      (else
        (+= pending (call integer .machine-pointer 0))
      )
    )
    (= capture (call call-runtime .runtime-allocate-object id mark managed-layout))
