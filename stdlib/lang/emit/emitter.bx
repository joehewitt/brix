    (if (or (< slot (. bound start)) (>= slot (+ (. bound start) (. bound count))))
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (let kept (call (. facts slot-type) (. unit reading) (- slot (. bound start))))
    (let held (if-expr (== kept no-type) type kept))
    (let inline (and (call (. bindings lazy-reads-once) slot) (== held type) (!= type no-type)))
