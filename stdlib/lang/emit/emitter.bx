  (fn-do _ emit-statements _
    (match? ([] (. tree nodes) (. tree root))
      (case (call .node-top-level-syntax row)
        (for (in statement ([] (. tree children) (. row statements)))
          (if (call (. tables runs-statement) (. unit source-module) (call probe-decl) tree statement)
            (call emit-statement statement)
          )
        )
      )
    )
  )
  (fn-do _ end-main _
    ; Where the statements of the program's main end, before its cleanups run: the call of `end-main`
    ; of core that the type pass recorded at the main's node.
    (return-if (if (not (call (. program runs-main) (. function module)))))
    (blank)
    (let fact (call (. facts first-call) (. unit reading) (. tree root)))
    (if (!= fact no-fact)
      (call call-instance (. ([] (. facts calls) fact) callee) (. tree root) (. pending length))
    )
  )
  (fn-do _ emit-block _
    (param body SyntaxId)
    (param ruled Bool (= false))
    ; The statements of a body in order: those of a block, or the one statement the body is, but
    ; the lines that are the rule's own where the body is a class's `• This` that writes its markup
    ; (`ruled`), and with the lines of a class's markup that declare properties it gives values
    ; (`content-property`). The cleanups the body opens run where it ends. Nothing after a
    ; statement that leaves is emitted, as the type pass checked none of it.
    (let mark (. open-cleanups length))
    (let own-scoping scoping)
    (= scoping (= (. scoping block-base) mark))
    (call clear-turn-lazies body)
    (call raise-elements body)
    (match? ([] (. tree nodes) body)
      (case (call .node-block row)
        (for (in statement ([] (. tree children) (. row body)))
          (let runs (or (call (. tables runs-statement) (. unit source-module) (call probe-decl) tree statement) (and (is ([] (. tree nodes) statement) .node-property-syntax) (call (. tree content-property) statement))))
          (if (and runs (not (and ruled (call (. tree rule-part) statement))))
            (call emit-statement statement)
          )
          (if (call (. facts is-leaving) (. unit reading) statement)
            (break)
          )
        )
        (call close-cleanups mark)
        (= scoping own-scoping)
        (return)
      )
    )
    (call emit-statement body)
    (call close-cleanups mark)
    (= scoping own-scoping)
  )
  (fn-do _ emit-do-body _
    (param id SyntaxId)
    (param body SyntaxId)
    (param effects CompilationEffect)
    (param bans EffectMask)
    ; The body of a `do` block. One kept from the collector, written outside the zone, is a region
    ; of its own; any other runs in place, kept from what the block names as well.
    (if (and (!= (/and/ effects (. CompilationEffect gc-free)) 0) (not in-zone))
      (call emit-region id)
      (return)
    )
    (let outer block-effects)
    (= block-effects (/or/ block-effects (call restrictions-of (call dispatch-effects effects))))
    (let mark (call enter-bans id bans))
    (if (== mark (. open-cleanups length))
      (call emit-block body)
      (= block-effects outer)
      (return)
    )
    (let own-scoping scoping)
    (= scoping (= (. scoping block-base) mark))
    (call emit-block body)
    (call close-cleanups mark)
    (= scoping own-scoping)
    (= block-effects outer)
  )
  (fn-do _ emit-cancel-held _
    (param id SyntaxId)
    (param body SyntaxId)
    (param effects CompilationEffect)
    (param bans EffectMask)
    ; `do without cancel`: the task holds off its cancellation from where the block begins to where
    ; it is left, by any way out, as a cleanup the block opens lets go. In a cleanup being run, the
    ; hold is let go where the block ends, by a pad of its own that a check made in it lands on
    ; before the cleanup's landing, and where an error or a `break` leaves it (`leave-held`).
    (let caught landing)
    (if (and (. scoping cleaning) (== caught no-block))
      (call refuse .refused-statement id)
      (return)
    )
    (call call-runtime .runtime-enter-cancel-shield id (. pending length))
    (let mark (. open-cleanups length))
    (let own-scoping scoping)
    (= scoping (= (. scoping block-base) mark))
    (call open-cleanup id (call UseCell no-local no-local no-type))
    (if (not (. scoping cleaning))
      (call emit-do-body id body effects bans)
      (call close-cleanups mark)
      (= scoping own-scoping)
      (return)
    )
    (let pad (call (. ir reserve-block)))
    (let checks landings)
    (= landing pad)
    (call emit-do-body id body effects bans)
    (let landed (!= landings checks))
    (call end-in-cleanup mark caught)
    (if landed
      (let onward (call (. ir reserve-block)))
      (call jump onward)
      (call (. ir start-block) pad)
      (call call-runtime .runtime-leave-cancel-shield id (. pending length))
      (call jump caught)
      (call (. ir start-block) onward)
    )
    (= scoping own-scoping)
  )
  (fn-do _ leave-held Bool
    (param from Size)
    (param site SyntaxId)
    ; Where a way out of a cleanup being run leaves what was opened in it from `from` on: each
    ; `do without cancel` block's hold is let go, newest first. Anything else opened there has no
    ; shape on such a way out, and then nothing is let go.
    (for (in position (..< from (. open-cleanups length)))
      (let opened ([] open-cleanups position))
      (return-if false (if (or (. opened cell is-live-call) (not (is ([] (. tree nodes) (. opened body)) .node-do-block)))))
    )
    (let position (. open-cleanups length))
    (while (> position from)
      (-= position 1)
      (call call-runtime .runtime-leave-cancel-shield site (. pending length))
    )
    (return true)
  )
  (fn-do _ open-uses _
    ; Where the function's binding has a `use`, the entry goes on to a head emitted once the body
    ; is, which clears the flag of each cell a `use` keeps its object in, and the body starts in a
    ; block of its own.
    (= use-head no-block)
    (while (!= (. use-flags length) 0)
      (call (. use-flags pop))
    )
    (if (or (== (. unit instance) no-instance) stepping (== (. ([] (. instances rows) (. unit instance)) binding) no-binding))
      (return)
    )
    (let range (. ([] (. bindings bindings) (. ([] (. instances rows) (. unit instance)) binding)) scans))
    (let found false)
    (for (in scan (..< (. range start) (+ (. range start) (. range count))))
      (if (!= (. ([] (. bindings scans) scan) use-expressions) 0)
        (= found true)
      )
    )
    (if (not found)
      (return)
    )
    (= use-head (call (. ir reserve-block)))
    (= use-body (call (. ir reserve-block)))
    (call jump use-head)
    (call (. ir start-block) use-body)
  )
  (fn-do _ close-uses _
    ; The head the entry goes on to in a function that has a `use`: each flag cleared, then the
    ; body.
    (if (== use-head no-block)
      (return)
    )
    (call (. ir start-block) use-head)
    (for (in flag use-flags)
      (call store-local flag (call integer .machine-u8 0) 0)
    )
    (call jump use-body)
  )
  (fn-expr _ can-use Bool
    (param kept Bool)
    ; Whether a `use` has a shape here: reading its own facts, and wherever `do finally` has one.
    ; One that keeps its object in a cell needs a function whose head clears the flags of its
    ; cells. In a generator, only one that keeps its object has a shape, which its slot keeps,
    ; and not in the loop of a comprehension or a list of feeds.
    (and allowed (not (call is-free (. unit instance))) (or stepping (not kept) (!= use-head no-block)))
    (where
      (lazy allowed (and (== (. unit reading) (. unit instance)) (not (. scoping cleaning)) (not builds) (not initializes) (or (not stepping) generates)))
      (lazy generates (and kept (== given-loop 0) (== feeds 0)))
    )
  )
  (fn-do _ use-cell UseCell
    (param id SyntaxId)
    (param type TypeId)
    ; The cell a `use` keeps its object in, in the block being emitted: the one the cleanup the
    ; block opened for the node reads, or else a new one and the cleanup that reads it. A
    ; generator has none: its slot keeps the object.
    (for (in position (..< (. scoping block-base) (. open-cleanups length)))
      (if (== (. ([] open-cleanups position) body) id)
        (return (. ([] open-cleanups position) cell))
      )
    )
    (let layout (call layout-of type id))
    (let cell
      (block
        (case? stepping
          (call UseCell no-local no-local type)
        )
        (default
          (call UseCell (call (. ir add-local) u8-layout) (call (. ir add-local) layout) type)
        )
      )
    )
    (if (not stepping)
      (+= use-flags (. cell flag))
    )
    (call open-cleanup id cell)
    (return cell)
  )
  (fn-do _ keep-used _
    (param id SyntaxId)
    (param cell UseCell)
    (param object Operand)
    ; Keeps the object of a `use` where its end reads it: in its cell, with its flag set, or in
    ; the slot the binder declared for it, as an optional that holds it.
    (if (!= (. cell held) no-local)
      (call store-local (. cell held) object id)
      (call store-local (. cell flag) (call integer .machine-u8 1) id)
      (return)
    )
    (let slot (call using-slot id))
    (let kept (call (. facts slot-type) (. unit instance) (call slot-offset slot id)))
    (if (!= (call (. types optional-inner) kept) (. cell type))
      (call refuse .refused-expression id)
      (return)
    )
    (let wrapped (call wrap id (call Typed object (. cell type)) kept))
    (call keep-state slot (. wrapped operand) kept id)
  )
  (fn-do _ using-slot SlotId
    (param id SyntaxId)
    ; The slot the binder declared for a `use`, in the function emitted.
    (let binding (. ([] (. instances rows) (. unit reading)) binding))
    (let slot no-slot)
    (if (and (!= binding no-binding) (== (. unit reading) (. unit instance)))
      (= slot (call (. bindings using-slot) binding id))
    )
    (if (== slot no-slot)
      (call refuse .refused-expression id)
    )
    (return slot)
  )
  (fn-do _ emit-use Typed
    (param id SyntaxId)
    (param expr SyntaxId)
    ; `use`: the subject is evaluated, and its `begin-using`, the first call the type pass recorded
    ; at the node, gives the value, or the subject itself where it only closes (`only-closes`). The
    ; object is then kept in the node's cell of the block being emitted, whose cleanup ends it where
    ; the block is left, by any way out. A subject written `use?` that holds nothing is used by
    ; nothing, and gives the optional that holds nothing; one that holds a value, or that the flow
    ; knows does, gives what `begin-using` gives, or itself, as an optional.
    (let nothing (call make-operand .operand-void 0))
    (let type (call (. facts node-type) (. unit reading) id))
    (let begins (call (. facts first-call) (. unit reading) id))
    (if (or (not (call can-use true)) (== begins no-fact))
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (let chain (call (. tree chained-subject) expr))
    (let subject (call emit-expression (if-expr (!= chain 0) chain expr)))
    (let joined no-block)
    (let made void-layout)
    (let slot nothing)
    (let mark (. joins length))
    (let tests (and (!= chain 0) (call (. types is-optional) (. subject type))))
    (if tests
      (let held (. subject type))
      (= made (call layout-of type id))
      (let empty (call (. ir reserve-block)))
      (let filled (call (. ir reserve-block)))
      (= joined (call (. ir reserve-block)))
      (= slot (call join-slot made))
      (call branch (. (call present id subject) operand) filled empty)
      (call (. ir start-block) empty)
      (call arrive id (. (call empty-optional type made) operand) joined slot)
      (call (. ir start-block) filled)
      (= subject (call payload id (call Typed (. subject operand) held)))
    )
    (let object-type (. subject type))
    (let cell (call use-cell id object-type))
    (let used subject)
    (if (not (call only-closes begins))
      (let called (call call-protocol id begins (. subject operand) object-type nothing))
      (= used (call Typed (. called operand) (. ([] (. instances signatures) (. ([] (. facts calls) begins) callee)) returns)))
    )
    (call keep-used id cell (. subject operand))
    (if (and (!= chain 0) (!= (. used type) type))
      (= used (call wrap id used type))
    )
    (if (not tests)
      (return used)
    )
    (call arrive id (. used operand) joined slot)
    (return (call Typed (call close-joins joined mark made slot) type))
  )
  (fn-do _ emit-use-block _
    (param id SyntaxId)
    (param subject SyntaxId)
    (param body SyntaxId)
    ; `do use`: the subject is evaluated, and its `begin-using`, where it has one, called and what
    ; it gives dropped. The body runs in a block of its own, which ends the use of the subject where
    ; it is left, by any way out. A subject written `use?` that holds nothing runs nothing.
    (let begins (call (. facts first-call) (. unit reading) id))
    (if (or (not (call can-use false)) (== begins no-fact))
      (call refuse .refused-statement id)
      (return)
    )
    (let chain (call (. tree chained-subject) subject))
    (let object (call emit-expression (if-expr (!= chain 0) chain subject)))
    (let done no-block)
    (if (and (!= chain 0) (call (. types is-optional) (. object type)))
      (let held (. object type))
      (let filled (call (. ir reserve-block)))
      (= done (call (. ir reserve-block)))
      (call branch (. (call present id object) operand) filled done)
      (call (. ir start-block) filled)
      (= object (call payload id (call Typed (. object operand) held)))
    )
    (let type (. object type))
    (let cell (call UseCell no-local (call (. ir add-local) (call layout-of type id)) type))
    (if (not (call only-closes begins))
      (call call-protocol id begins (. object operand) type (call make-operand .operand-void 0))
    )
    (call store-local (. cell held) (. object operand) id)
    (let mark (. open-cleanups length))
    (let own-scoping scoping)
    (= scoping (= (. scoping block-base) mark))
    (call open-cleanup id cell)
    (call emit-block body)
    (call close-cleanups mark)
    (= scoping own-scoping)
    (if (!= done no-block)
      (call jump done)
      (call (. ir start-block) done)
    )
  )
  (fn-expr _ only-closes Bool
    (param begins FactId)
    ; Whether a `use` closes what it uses, which has no `begin-using`: the type pass recorded only
    ; its `close` at the node.
    (== (. ([] (. facts calls) begins) next) no-fact)
  )
  (fn-do _ emit-forwarder _
    (param forward SwapForward)
    ; A door a fake answers under a `do with`: it reads the fake from its effect's slot, where the
    ; `do with` or what holds its state put it, and calls the fake's method with it and the door's
    ; arguments, giving what that gives. The method runs with the slot as the `do with` found it,
    ; put back as the method ends by any way out (`enter-outer`). Typed only under the binding, it
    ; finds the slot bound. Where the fake's class has no method that answers it, which only a door
    ; a function value reaches lets through, it panics.
    (let row ([] (. instances rows) (. unit instance)))
    (let declared
      (match ([] (. ([] (. program modules) (. row module)) decls) (. row decl))
        (case (call .decl-function fn)
          (. fn syntax)
        )
        (default
          0u32
        )
      )
    )
    (let own ([] (. instances signatures) (. unit instance)))
    (for (in position (..< 0 (. own args count)))
      (call (. ir add-argument) (call layout-of (call (. instances argument-type) (. unit instance) position) declared))
    )
    (= returns-type (. own returns))
    (= (. ir returns) (call layout-of (. own returns) declared))
    (if (!= (. own errors count) 0)
      (call return-results (. own result) declared)
    )
    (if (== (. forward callee) no-instance)
      (let name (. ([] (. program effects names) (. forward effect)) text))
      (call raise-text
        (block
          (arg declared)
          (arg (str "The fake bound to '" name "' has no method '" (call paths-name row) "' to answer its door"))
        )
      )
      (return)
    )
    (let slot (call (. tables storage-of) (. forward module) (. forward decl)))
    (if (or (== slot no-storage) (== ([] (. tables instance-functions) (. forward callee)) no-function))
      (call refuse .refused-function declared)
      (return)
    )
    (let theirs ([] (. instances signatures) (. forward callee)))
    (let kept ([] (. tables storage) slot))
    (let state (call stack-state slot declared))
    (let fake (call take state (call (. tables layouts field) (. kept layout) 1) declared))
    (let outside (call enter-outer slot declared))
    (let mark (. pending length))
    (+= pending fake)
    (for (in position (..< 0 (. own args count)))
      (+= pending (call make-operand .operand-argument position))
    )
    (let forwards (!= (. theirs errors count) 0))
    (= takes-result forwards)
    (let answer (call call-method (. forward callee) declared mark true))
    (call close-cleanups outside)
    (if (and forwards (!= (. theirs result) (. own result)))
      (call return-recased (. answer operand) (. theirs result) declared no-instance declared)
      (else-if forwards
        (call return-held (. answer operand))
      )
      (else-if (== (. own returns) (. types void-type))
        (call return-nothing)
      )
      (else
        (call return-value (. answer operand) 0)
      )
    )
  )
  (fn-do _ enter-outer Size
    (param row U32)
    (param site SyntaxId)
    (let kept ([] (. tables storage) row))
    (let target (call stack-slot kept site))
    (let saved (call (. ir add-local) (. kept layout)))
    (call store-local saved target site)
    (let flag (call (. tables layouts field) (. kept layout) 0))
    (let held (call (. tables layouts field) (. kept layout) 1))
    (let link (call (. tables layouts field) (. kept layout) 2))
    (let outer (call load target (. link offset) (. link layout) site))
    (let unbound (call (. ir reserve-block)))
    (let bound (call (. ir reserve-block)))
    (let done (call (. ir reserve-block)))
    (call branch (call compare site .compare-equal outer (call integer (as managed-layout MachineKind) 0)) unbound bound)
    (call (. ir start-block) unbound)
    (call store target (. flag offset) (call integer .machine-u8 0) false site)
    (call store target (. held offset) (call integer (as managed-layout MachineKind) 0) true site)
    (call jump done)
    (call (. ir start-block) bound)
    (call copy target outer (. kept layout) (. ([] (. tables layouts rows) (. kept layout)) is-managed) site)
    (call jump done)
    (call (. ir start-block) done)
    (let mark (. open-cleanups length))
    (call open-cleanup site (call UseCell no-local saved no-type false row))
    (return mark)
  )
  (fn-expr _ refused-kind U32
    255
  )
  (fn-do _ refused-slot U32
    (param effect U32)
    (return-if no-storage (if (or (>= effect (call most-effects)) (== (/and/ (. tables refused-effects) (call ban-bit effect)) 0))))
    (return (call (. tables storage-of) (as ([] (. program effects modules) effect) ModuleId) (as ([] (. program effects decls) effect) DeclId)))
  )
  (fn-do _ emit-refused-branch _
    (param declared SyntaxId)
    (let row ([] (. instances rows) (. unit instance)))
    (let door (call (. program effects door-of) (. row module) (. row decl)))
    (return-if (if (not door)))
    (blank)
    (let slot (call refused-slot door))
    (return-if (if (== slot no-storage)))
    (blank)
    (let kept ([] (. tables storage) slot))
    (let flag (call (. tables layouts field) (. kept layout) 0))
    (let kind (call load (call stack-state slot declared) (. flag offset) (. flag layout) declared))
    (let refused (call (. ir reserve-block)))
    (let next (call (. ir reserve-block)))
    (call branch (call compare declared .compare-equal kind (call integer .machine-u8 (as (call refused-kind) U64))) refused next)
    (call (. ir start-block) refused)
    (let name (. ([] (. program effects names) door) text))
    (call raise-text declared (str (call paths-name row) " reached a door of '" name "' under 'without " name "'"))
    (call (. ir start-block) next)
  )
  (fn-do _ is-refused-row Bool
    (param row U32)
    (let kept ([] (. tables storage) row))
    (let effect (call (. program effects index-of) (. kept module) (. kept decl)))
    (return (and effect (== (call refused-slot effect) row)))
  )
  (fn-do _ enter-bans Size
    (param declared SyntaxId)
    (param bans EffectMask)
    (let mark (. open-cleanups length))
    (let effect U32 0)
    (while (< effect (call most-effects))
      (let slot (call refused-slot effect))
      (if (and (!= slot no-storage) (!= (/and/ bans (call ban-bit effect)) 0))
        (let kept ([] (. tables storage) slot))
        (let target (call stack-slot kept declared))
        (let previous (call (. ir add-local) (. kept layout)))
        (call store-local previous target declared)
        (let flag (call (. tables layouts field) (. kept layout) 0))
        (call store target (. flag offset) (call integer .machine-u8 (as (call refused-kind) U64)) false declared)
        (call open-cleanup declared (call UseCell no-local previous no-type false slot))
      )
      (+= effect 1)
    )
    (return mark)
  )
  (fn-do _ inherit-refusals _
    (param declared SyntaxId)
    (for (in row (call (. tables stack-holds) (. unit instance)))
      (if (and (!= row no-storage) (call is-refused-row row))
        (let kept ([] (. tables storage) row))
        (call copy (call stack-slot kept declared) (call stack-state row declared) (. kept layout) (. ([] (. tables layouts rows) (. kept layout)) is-managed) declared)
      )
    )
  )
  (fn-do _ emit-dispatch _
    (param declared SyntaxId)
    (param signature InstanceSignature)
    ; A door of an effect the program binds a fake to somewhere: where the effect's slot holds a
    ; fake, it calls the door typed under a binding of that fake's class with its arguments and
    ; gives what that gives, which panics where that class has no method that answers it. It runs
    ; its body where the slot holds none.
    (let kind (call make-operand .operand-void 0))
    (let read false)
    (for (in dispatch (. facts swap-dispatches))
      (if (== (. dispatch instance) (. unit instance))
        (let slot (call (. tables storage-of) (. dispatch module) (. dispatch decl)))
        (if (== slot no-storage)
          (call refuse .refused-function declared)
          (return)
        )
        (if (not read)
          (let kept ([] (. tables storage) slot))
          (let flag (call (. tables layouts field) (. kept layout) 0))
          (= kind (call load (call stack-state slot declared) (. flag offset) (. flag layout) declared))
          (= read true)
        )
        (let chosen (call (. ir reserve-block)))
        (let next (call (. ir reserve-block)))
        (call branch
          (block
            (arg (call compare declared .compare-equal kind (call integer .machine-u8 (as (. dispatch kind) U64))))
            (arg chosen)
            (arg next)
          )
        )
        (call (. ir start-block) chosen)
        (let mark (. pending length))
        (for (in position (..< 0 (. signature args count)))
          (+= pending (call make-operand .operand-argument position))
        )
        (let theirs ([] (. instances signatures) (. dispatch forwarder)))
        (let forwards (!= (. theirs errors count) 0))
        (= takes-result forwards)
        (let answer (call call-instance (. dispatch forwarder) declared mark))
        (if (and forwards (!= (. theirs result) (. signature result)))
          (call return-recased (. answer operand) (. theirs result) declared no-instance declared)
          (else-if forwards
            (call return-held (. answer operand))
          )
          (else-if (== (. signature returns) (. types void-type))
            (call return-nothing)
          )
          (else
            (call return-value (. answer operand) 0)
          )
        )
        (call (. ir start-block) next)
      )
    )
  )
  (fn-do _ emit-unanswered _
    (param declared SyntaxId)
    (for (in dispatch (. facts swap-dispatches))
      (if (== (. dispatch instance) (. unit instance))
        (let slot (call (. tables storage-of) (. dispatch module) (. dispatch decl)))
        (if (== slot no-storage)
          (call refuse .refused-function declared)
          (return)
        )
        (let kept ([] (. tables storage) slot))
        (let flag (call (. tables layouts field) (. kept layout) 0))
        (let kind (call load (call stack-state slot declared) (. flag offset) (. flag layout) declared))
        (let faked (call (. ir reserve-block)))
        (let next (call (. ir reserve-block)))
        (call branch (call compare declared .compare-equal kind (call integer .machine-u8 0)) next faked)
        (call (. ir start-block) faked)
        (let row ([] (. instances rows) (. unit instance)))
        (let name (. ([] (. program effects names) (?? (call (. program effects index-of) (. dispatch module) (. dispatch decl)) 0)) text))
        (call raise-text declared (str "The fake bound to '" name "' cannot answer " (call paths-name row) ", a door of it that is not a function of its module"))
        (call (. ir start-block) next)
        (return)
      )
    )
  )
  (fn-do _ paths-name String
    (param row Instance)
    (return
      (match ([] (. ([] (. program modules) (. row module)) decls) (. row decl))
        (case (call .decl-function fn)
          (if-expr (. fn name) (. fn name text) "")
        )
        (default
          ""
        )
      )
    )
  )
  (fn-do _ emit-stack-binding _
    (param id SyntaxId)
    (param value SyntaxId)
    (param body SyntaxId)
    ; `do with`: the global is bound to the value, converted to its type, for the body. The slot's
    ; state is kept and the slot bound, and the body runs in a block of its own, whose reads of
    ; the global read the value, and which puts the slot back as it was where it is left, by any
    ; way out. One written where `do finally` has no shape has none. An effect is bound to a fake,
    ; an object of any class, as it is, and the slot keeps a copy of what it held before where that
    ; was a fake or a ban (`outer-state`).
    (if (or (. scoping cleaning) builds initializes (call is-free (. unit instance)) (!= (. unit reading) (. unit instance)))
      (call refuse .refused-statement id)
      (return)
    )
    (let row (call stack-row id))
    (if (== row no-storage)
      (call refuse .refused-statement id)
      (return)
    )
    (let kept ([] (. tables storage) row))
    (let fakes (is ([] (. ([] (. program modules) (. kept module)) decls) (. kept decl)) .decl-effect))
    (let bound
      (block
        (case? fakes
          (call emit-expression value)
        )
        (default
          (call convert id .reason-assignment (call emit-expression value))
        )
      )
    )
    (if (and (!= (. bound type) (. kept type)) (not fakes))
      (call refuse .refused-conversion id)
      (return)
    )
    (let held (call (. ir add-local) (if-expr fakes managed-layout (call layout-of (. kept type) id))))
    (call store-local held (. bound operand) id)
    (let previous (call (. ir add-local) (. kept layout)))
    (let slot (call stack-slot kept id))
    (call store-local previous slot id)
    (let flag (if-expr fakes (call fake-kind kept (. bound type)) 1u32))
    (if (or (== flag 0) (>= flag (call refused-kind)))
      (call refuse .refused-statement id)
      (return)
    )
    (call fill-stack slot kept (call load-local held id) id flag)
    (if fakes
      (let link (call (. tables layouts field) (. kept layout) 2))
      (call store slot (. link offset) (call outer-state previous kept id) true id)
    )
    (let mark (. open-cleanups length))
    (let own-scoping scoping)
    (= scoping (= (. scoping block-base) mark))
    (call open-cleanup id (call UseCell no-local previous no-type))
    (+= stack-bindings (call StackBinding row held flag))
    (call emit-block body)
    (call (. stack-bindings pop))
    (call close-cleanups mark)
    (= scoping own-scoping)
  )
  (fn-do _ outer-state Operand
    (param previous LocalId)
    (param kept GlobalStorage)
    (param site SyntaxId)
    (let outer (call (. ir add-local) managed-layout))
    (call store-local outer (call integer (as managed-layout MachineKind) 0) site)
    (let flag (call (. tables layouts field) (. kept layout) 0))
    (let kind (call load (call load-local previous site) (. flag offset) (. flag layout) site))
    (let boxing (call (. ir reserve-block)))
    (let done (call (. ir reserve-block)))
    (call branch (call compare site .compare-equal kind (call integer .machine-u8 0)) done boxing)
    (call (. ir start-block) boxing)
    (let mark (. pending length))
    (+= pending (call integer .machine-u64 (. ([] (. tables layouts rows) (. kept layout)) size)))
    (+= pending (call make-operand .operand-descriptor (. kept layout)))
    (let made (call call-runtime .runtime-allocate-object site mark managed-layout))
    (call copy made (call load-local previous site) (. kept layout) true site)
    (call store-local outer made site)
    (call jump done)
    (call (. ir start-block) done)
    (return (call load-local outer site))
  )
  (fn-do _ fake-kind U32
    (param kept GlobalStorage)
    (param fake TypeId)
    (let effect (call (. program effects index-of) (. kept module) (. kept decl)))
    (return (if-expr effect (call (. instances fake-kind) effect fake) 0))
  )
  (fn-expr _ stack-row U32
    (param id SyntaxId)
    ; The storage of the global a `do with` binds.
    (case? (or (!= (. global kind) .resolve-global) (!= (call (. tables global-kind) (. global module) (. global decl)) .global-stack))
      no-storage
    )
    (default
      (call (. tables storage-of) (. global module) (. global decl))
    )
    (where
      (lazy global (call (. bindings resolution-of) (. ([] (. instances rows) (. unit reading)) binding) id))
    )
  )
  (fn-do _ stack-bound Bool
    (param row U32)
    ; Whether a binding of a global `do with` binds is open around what is being emitted.
    (for (in bound stack-bindings)
      (if (== (. bound bind) row)
        (return true)
      )
    )
    (return false)
  )
  (fn-do _ stack-slot Operand
    (param kept GlobalStorage)
    (param site SyntaxId)
    ; The slot of a global `do with` binds, in the memory of the task running.
    (return (call address (call task-locals site) (. kept offset) (. kept layout) site))
  )
  (fn-do _ fill-stack _
    (param target Operand)
    (param kept GlobalStorage)
    (param value Operand)
    (param site SyntaxId)
    (param bound U32 (= 1))
    ; Binds the state of a global `do with` binds, where it is kept, to a value: the flag is set,
    ; for an effect to the number of the fake's class, and the value stored, through the write barrier
    ; where it is a managed pointer.
    (let flag (call (. tables layouts field) (. kept layout) 0))
    (let held (call (. tables layouts field) (. kept layout) 1))
    (call store target (. flag offset) (call integer .machine-u8 (as bound U64)) false site)
    (if (call (. tables layouts is-struct) (. held layout))
      (call copy
        (block
          (arg (call address target (. held offset) (. held layout) site))
          (arg value)
          (arg (. held layout))
          (arg (. ([] (. tables layouts rows) (. held layout)) is-managed))
          (arg site)
        )
      )
      (else-if (!= (. held layout) void-layout)
        (call store target (. held offset) value (call is-managed-pointer (. held layout)) site)
      )
    )
  )
  (fn-do _ read-stack Typed
    (param id SyntaxId)
    (param row U32)
    ; A read of a global `do with` binds: the value of a binding of it open around the read in
    ; the function, or else the value its state holds, which raises a panic where it is not
    ; bound. That state is what a spawned task's body captured, or else the slot of the task
    ; running. A cleanup a landing pad runs is emitted once for all the checks that land there,
    ; where TypeScript reads what is bound where the panic was made, so a read in one is refused
    ; where a `do with` after the cleanup binds the global.
    (let nothing (call make-operand .operand-void 0))
    (let kept ([] (. tables storage) row))
    (if (or (!= (. unit reading) (. unit instance)) (and (!= (. scoping unwinding-from) 0) (call binds-after row (. scoping unwinding-from))))
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (let position (. stack-bindings length))
    (while (!= position 0)
      (-= position 1)
      (if (== (. ([] stack-bindings position) bind) row)
        (return (call Typed (call load-local (. ([] stack-bindings position) value) id) (. kept type)))
      )
    )
    (if (and (not (. function may-panic)) (not in-landing))
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (let state (call stack-state row id))
    (let flag (call (. tables layouts field) (. kept layout) 0))
    (let unbound (call (. ir reserve-block)))
    (let ready (call (. ir reserve-block)))
    (let current (call load state (. flag offset) (. flag layout) id))
    (call branch (call compare id .compare-equal current (call integer .machine-u8 1)) ready unbound)
    (call (. ir start-block) unbound)
    (call raise-text id (str "Stack-local variable '" (call (. tables global-name) kept) "' is not bound"))
    (call (. ir start-block) ready)
    (return (call Typed (call take state (call (. tables layouts field) (. kept layout) 1) id) (. kept type)))
  )
  (fn-do _ binds-after Bool
    (param row U32)
    (param site SyntaxId)
    ; Whether a `do with` of the function that begins after a node binds a global.
    (for (in scope (. facts stack-scopes))
      (if (and (== (. scope instance) (. unit reading)) (> (. scope first) site) same-storage)
        (return true)
      )
      (lazy same-storage (== (call (. tables storage-of) (. scope module) (. scope decl)) row))
    )
    (return false)
  )
  (fn-do _ stack-state Operand
    (param row U32)
    (param site SyntaxId)
    ; Where the state of a global `do with` binds is read: in a spawned task's body, the capture
    ; it was given; in a lambda or a comprehension, the place that holds it in the environment it
    ; was given, as it was where it was made, which the steps of one that yields reach through the
    ; link of their own, and so in the body of a loop on a stream for an effect's slot; and
    ; anywhere else the slot of the task running.
    (let kept ([] (. tables storage) row))
    (if (call is-closure-body)
      (let place (call made-place row))
      (if (!= place no-place)
        (return (call made-state place site))
      )
      (call refuse .refused-expression site)
      (return (call make-operand .operand-void 0))
    )
    (if (call reads-made-state row)
      (return (call made-state (call made-place row) site))
    )
    (if (!= (. function kind) .task-body)
      (return (call stack-slot kept site))
    )
    (let layout ([] (. tables captures) (. unit instance)))
    (let stacks (call (. tables stack-holds) (. unit instance)))
    (if (and (!= layout no-layout) (!= layout unbuilt-environment) (!= ([] (. tables capture-rows) (. unit instance)) no-place))
      (for (in index (..< 0 (. stacks length)))
        (if (== ([] stacks index) row)
          (let held (+ (call (. tables capture-stacks) (. unit instance)) index))
          (let field (call (. tables layouts field) layout (as held U32)))
          (return (call address (call make-operand .operand-argument 0) (. field offset) (. field layout) site))
        )
      )
    )
    (call refuse .refused-expression site)
    (return (call make-operand .operand-void 0))
  )
  (fn-do _ made-place U32
    (param row U32)
    (let owner (. ([] (. instances rows) (. unit instance)) enclosing))
    (let held (if-expr (!= owner no-instance) ([] (. tables environments) owner) no-layout))
    (return-if no-place (if (or (== held no-layout) (== held unbuilt-environment))))
    (blank)
    (return (call (. tables stack-place) owner (. ([] (. instances rows) (. unit instance)) decl) row))
  )
  (fn-do _ made-state Operand
    (param place U32)
    (param site SyntaxId)
    (let owner (. ([] (. instances rows) (. unit instance)) enclosing))
    (let field (call (. tables layouts field) ([] (. tables environments) owner) place))
    (let held-environment (call given-environment site))
    (if stepping
      (= held-environment (call load held-environment 0 managed-layout site))
    )
    (return (call address held-environment (. field offset) (. field layout) site))
  )
  (fn-do _ reads-made-state Bool
    (param row U32)
    (let kept ([] (. tables storage) row))
    (if (or (not (. unit received)) (!= (. function kind) .instance-body))
      (return false)
    )
    (let made ([] (. instances rows) (. unit instance)))
    (match? ([] (. ([] (. program modules) (. made module)) decls) (. made decl))
      (case (call .decl-function fn)
        (if (!= (. fn kind) .subscriber-decl)
          (return false)
        )
      )
    )
    (return (and (!= (call (. program effects index-of) (. kept module) (. kept decl)) null) (!= (call made-place row) no-place)))
  )
  (fn-do _ capture-stack _
    (param capture Operand)
    (param field LayoutField)
    (param row U32)
    (param site SyntaxId)
    ; Stores in the capture of a spawned task, or in the environment a lambda is made with, the
    ; state of a global `do with` binds as it is where the task is spawned or the lambda made:
    ; bound to the value of a binding of it open there, or else as the function reads it.
    (if (== row no-storage)
      (call refuse .refused-statement site)
      (return)
    )
    (let kept ([] (. tables storage) row))
    (let target (call address capture (. field offset) (. field layout) site))
    (let position (. stack-bindings length))
    (while (!= position 0)
      (-= position 1)
      (if (== (. ([] stack-bindings position) bind) row)
        (call fill-stack
          (block
            (arg target)
            (arg kept)
            (arg (call load-local (. ([] stack-bindings position) value) site))
            (arg site)
            (arg (. ([] stack-bindings position) flag))
          )
        )
        (return)
      )
    )
    (call copy target (call stack-state row site) (. kept layout) (. ([] (. tables layouts rows) (. kept layout)) is-managed) site)
  )
  (fn-do _ emit-statement _ (?! Refused)
    (param id SyntaxId)
    ; One statement. An expression written as a statement is evaluated, and its value dropped: one that
    ; is no call and whose value is an error has no shape here. A probe is compiled only where probes
    ; are asked for (`emit-probe-statement`): elsewhere it emits nothing, and nothing of it is
    ; evaluated. A lazy
    ; local emits nothing where it is declared: its value is evaluated where it is read. Nor does a
    ; local of a row of a markup loop region read as a getter. A block written for a feature of the
    ; compiler the program does not use emits nothing: the type pass typed none of it. Nor does the body
    ; of a branch written with a pattern, whose statements run in the arm of its condition. A match of a
    ; subject is run for what its arms do, as the reference compiles one written as a statement. A line
    ; of a markup element's body that the element takes is given to it. A statement that follows one
    ; that left a call crossing the zone the collector never sees unsettled has no shape. A line of a
    ; class's markup that declares a property stores its value there as an assignment does
    ; (`content-property`).
    (if (!= zone-answer 0)
      (call refuse .refused-statement id)
      (return)
    )
    (if (call (. tree is-probe) id)
      (if (call compiles-probe id)
        (call emit-probe-statement id)
      )
      (return)
    )
    (let link (call (. facts content-link-of) (. unit reading) id))
    (if (!= link (. U32 max))
      (if (!= (. ([] (. facts content-links) link) call) no-fact)
        (call emit-content id ([] (. facts content-links) link))
      )
      (return)
    )
    (let named (call (. facts named-store-of) (. unit reading) id))
    (if (!= named (. U32 max))
      (let made (call emit-expression id))
      (call store-named id named made)
      (return)
    )
    (match ([] (. tree nodes) id)
      (case .node-noop
        (return)
      )
      (case (call .node-slot-outlet row)
        (do
          (inline (call emit-outlet id (. row name) (. row body)))
        )
      )
      (case (call .node-print row)
        (call emit-print id (. row body))
      )
      (case (call .node-assertion-syntax row)
        (call emit-raise id (. row exception) (. row condition))
      )
      (case .node-probe-snapshot
        (call refuse .refused-probe id)
      )
      (case .node-probe-preview
        (call refuse .refused-probe id)
      )
      (case (call .node-declare row)
        (if (and (. row rollback) (not (. row is-lazy)))
          (call refuse .refused-statement id)
          (else-if (and (not (. row is-lazy)) (not (call declares-getter (. row left))))
            (call emit-declare id (. row left) (call (. tree machine-or-value) (. row left) (. row right)))
          )
        )
      )
      (case (call .node-assign row)
        (let live (call (. tables live-statement-of) (. unit instance) id))
        (if (and live (== (. unit reading) (. unit instance)))
          (call emit-live-statement id live (. row lhs) (. row rhs))
          (else
            (call emit-assign id (. row op) (. row lhs) (. row rhs))
          )
        )
      )
      (case (call .node-property-syntax row)
        (let live (call (. tables live-statement-of) (. unit instance) id))
        (if (and live (== (. unit reading) (. unit instance)))
          (call emit-live-statement id live (call (. tree content-property-name) id) (. row value))
          (else
            (call emit-assign id .eq-op (call (. tree content-property-name) id) (. row value))
          )
        )
      )
      (case (call .node-if-block row)
        (if (. row is-optional)
          (call refuse .refused-statement id)
          (else
            (call emit-if id (. row condition) (. row body) (. row next))
          )
        )
      )
      (case (call .node-while-block row)
        (if (. row is-optional)
          (call refuse .refused-statement id)
          (else
            (call emit-while id (. row condition) (. row body))
          )
        )
      )
      (case (call .node-for-block row)
        (if (!= (. row next) 0)
          (call refuse .refused-statement id)
          (else
            (call emit-for id (. row loop) (. row body))
          )
        )
      )
      (case (all (call .node-iterator-expression row) ({} (== (call (. facts plan-of) (. unit reading) id) .plan-content-loop)))
        (if (!= (. row next) 0)
          (call refuse .refused-statement id)
          (else
            (call emit-for id (. row loop) (. row body))
          )
        )
      )
      (case (all (call .node-iterator-expression row) ({} (== subscribing id)))
        (match? ([] (. tree nodes) (. row loop))
          (case (call .node-loop-syntax loop)
            (call emit-subscriber (. row loop) (call tested (. row loop) (. loop clause)) (. row body) id)
          )
        )
      )
      (case (call .node-do-block row)
        (let is-off (not (call (. tables compiles-features) (. row feature-gate-features))))
        (let bans (call (. program bans-named) (. ([] (. instances rows) (. unit instance)) module) (. row bans)))
        (if (and (. row holds-cancel) (not is-off))
          (call emit-cancel-held id (. row body) (. row compilation-effects) bans)
          (else-if (not is-off)
            (call emit-do-body id (. row body) (. row compilation-effects) bans)
          )
        )
      )
      (case .node-block
        (call emit-block id)
      )
      (case (call .node-do-finally-block row)
        (call emit-finally id (. row body))
      )
      (case (call .node-use-block row)
        (call emit-use-block id (. row subject) (. row body))
      )
      (case (call .node-stack-local-binding-block row)
        (call emit-stack-binding id (. row value) (. row body))
      )
      (case (call .node-do-task-block row)
        (let worker (if-expr (. row is-parallel) 0 (. row worker)))
        (do
          (inline (call emit-spawn id worker (. row is-parallel) (== (. row scheduling) .task-scheduling-priority) (. row large-stack)))
        )
      )
      (case .node-break
        (if (call breaks-subscription)
          (call unsubscribe id)
          (call emit-leave id false)
          (else
            (call emit-leave id true)
          )
        )
      )
      (case .node-continue
        (call emit-leave id false)
      )
      (case (call .node-yield row)
        (call emit-yield id (. row expr) (. row does-yield-all))
      )
      (case (call .node-return row)
        (call emit-return id (. row expr))
      )
      (case (call .node-return-if-true row)
        (call emit-return-if id (. row condition) (. row expr))
      )
      (case (call .node-match-expression row)
        (if (and (!= (. row subject) 0) (call helper-runs (. row helper)))
          (call emit-subject-match id (. row subject) (. row body) (. row is-optional) (. row helper) true)
          (else
            (call emit-expression id)
          )
        )
      )
      (case (call .node-structure-match row)
        (let type (call (. facts node-type) (. unit reading) id))
        (if (or (== type no-type) (== type invalid-type) (== type (. types void-type)))
          (call run-arms id (. row pattern))
          (else
            (call emit-expression id)
          )
        )
      )
      (case (call .node-catch-expression row)
        (let handled (and (!= (. row catchers count) 0) (call is-caught (. row body))))
        (if (!= (call (. tree transformer-exception) (. row body) (. row catchers)) 0)
          (if (and (> (. row catchers count) 1) (call (. tree catchers-bind) (. row catchers)))
            (call refuse .refused-statement id)
          )
          (else-if (and handled (not (call carries-error (call (. facts node-type) (. unit reading) id))))
            (call emit-handled id (. row body) (. row catchers) true)
          )
          (else
            (let emitted (call emit-expression id))
            (if (and (!= (. emitted type) no-type) (call extends (. emitted type) (. types error-type)))
              (call refuse .refused-statement id)
            )
          )
        )
      )
      (default
        (let emitted (call emit-expression id))
        (if (and (!= (. emitted type) no-type) uncaught-error)
          (call refuse .refused-statement id)
        )
        (lazy uncaught-error (and (call extends (. emitted type) (. types error-type)) (not (call is-caught id))))
      )
    )
  )
  (fn-do _ emit-arm-index Typed
    (param id SyntaxId)
    (param selected TypeId)
    (param keeps LocalId (= no-local))
    ; The index of the arm of a markup branch region to select, as the reference's
    ; `markupIfConditionArm` chooses it: that of the first arm whose condition holds, the
    ; conditions tested in turn, or else that of the first arm with no condition, or none. An arm
    ; written with a pattern holds where its subject matches it, tested binding nothing, as the
    ; reference's `markupIfActiveArm` tests it; an arm so chosen is selected again whatever arm the
    ; region holds, which `keeps` says where it is given: false for such an arm, else true. That of
    ; a match region is `emit-pattern-index`'s. That of a slot outlet that is a region is its one
    ; arm's, once the name its parameter gives is read, as the reference's `selectArm` reads it.
    (let nothing (call make-operand .operand-void 0))
    (let layout (call layout-of selected id))
    (if (or (call is-null-form selected) (not (call (. tables layouts is-struct) layout)))
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (let inner (call (. tables layouts field) layout 0))
    (let flag (call (. tables layouts field) layout 1))
    (if (not (call is-integer (. inner layout)))
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (let held (call frame layout))
    (call zero held layout)
    (if (is ([] (. tree nodes) id) .node-match-expression)
      (call emit-pattern-index id held inner flag)
      (return (call Typed held selected))
    )
    (match? ([] (. tree nodes) id)
      (case (call .node-markup-slot-parameter row)
        (do
          (inline (call emit-expression (. row name)))
        )
        (call store held (. inner offset) (call integer (as (. inner layout) MachineKind) 0) false id)
        (call store held (. flag offset) (call integer .machine-i8 1) false id)
        (return (call Typed held selected))
      )
    )
    (let done (call (. ir reserve-block)))
    (if (!= keeps no-local)
      (call store-local keeps (call integer .machine-u8 1) id)
    )
    (let fallback U32 (. U32 max))
    (let index U32)
    (let arm id)
    (while (!= arm 0)
      (let next SyntaxId 0)
      (match? ([] (. tree nodes) arm)
        (case (call .node-if-block row)
          (let pattern (call (. tree pattern-arm) arm))
          (if (!= pattern 0)
            (if (not (call test-arm pattern (call (. tree matched-subject) (. row condition)) held inner flag index done keeps))
              (call (. ir start-block) done)
              (return (call Typed held selected))
            )
            (else-if (== (. row condition) 0)
              (if (== fallback (. U32 max))
                (= fallback index)
              )
            )
            (else
              (let tested (call test (. row condition) (call emit-expression (. row condition))))
              (let chosen (call (. ir reserve-block)))
              (let later (call (. ir reserve-block)))
              (call branch (. tested operand) chosen later)
              (call (. ir start-block) chosen)
              (call store
                (block
                  (arg held)
                  (arg (. inner offset))
                  (arg (call integer (as (. inner layout) MachineKind) index))
                  (arg false)
                  (arg arm)
                )
              )
              (call store held (. flag offset) (call integer .machine-i8 1) false arm)
              (call jump done)
              (call (. ir start-block) later)
            )
          )
          (= next (. row next))
        )
      )
      (+= index 1)
      (= arm next)
    )
    (if (!= fallback (. U32 max))
      (call store held (. inner offset) (call integer (as (. inner layout) MachineKind) fallback) false id)
      (call store held (. flag offset) (call integer .machine-i8 1) false id)
    )
    (call jump done)
    (call (. ir start-block) done)
    (return (call Typed held selected))
  )
  (fn-do _ test-arm Bool
    (param arm SyntaxId)
    (param subject SyntaxId)
    (param held Operand)
    (param inner LayoutField)
    (param flag LayoutField)
    (param index U32)
    (param done IRBlockId)
    (param keeps LocalId)
    ; Tests an arm of a markup branch region written with a pattern: its subject read, a struct
    ; copied, and matched against the pattern binding nothing; where it matches, `held` gets the
    ; arm's index, `keeps` false, and the test goes to `done`, and else on. False where the pattern
    ; always matches, so no arm after it is tested, or once refused.
    (if (== (call (. facts plan-of) (. unit reading) arm) .plan-never)
      (return true)
    )
    (let value (call emit-expression subject))
    (let type (. value type))
    (= value (call Typed (call apart value subject true) (. value type)))
    (let later (call (. ir reserve-block)))
    (let jumps fail-jumps)
    (let own-matching matching)
    (= matching (= (. matching testing) true))
    (= matching (= (. matching tested) subject))
    (match? ([] (. tree nodes) arm)
      (case (call .node-type-transform row)
        (if (!= (. row pattern) 0)
          (call emit-pattern (. row pattern) (call Typed (. value operand) type) later)
        )
      )
    )
    (= matching own-matching)
    (call store held (. inner offset) (call integer (as (. inner layout) MachineKind) index) false arm)
    (call store held (. flag offset) (call integer .machine-i8 1) false arm)
    (if (!= keeps no-local)
      (call store-local keeps (call integer .machine-u8 0) arm)
    )
    (call jump done)
    (if (== fail-jumps jumps)
      (return false)
    )
    (call (. ir start-block) later)
    (return true)
  )
  (fn-do _ emit-pattern-index _
    (param id SyntaxId)
    (param held Operand)
    (param inner LayoutField)
    (param flag LayoutField)
    ; Stores in `held` the index of the arm of a markup match region to select, as the reference's
    ; `markupMatchActiveArm` chooses it: the subject is read once, a struct copied, and each arm's
    ; pattern tested against it in turn, binding nothing; that of the first that matches, or none.
    ; The arms after one that always matches are not tested.
    (let subject SyntaxId 0)
    (match? ([] (. tree nodes) id)
      (case (call .node-match-expression row)
        (= subject (. row subject))
      )
    )
    (let value (call emit-expression subject))
    (let type (. value type))
    (= value (call Typed (call apart value subject true) (. value type)))
    (let done (call (. ir reserve-block)))
    (let index U32)
    (for (in arm (call (. tree region-arms) id))
      (if (!= (call (. facts plan-of) (. unit reading) arm) .plan-never)
        (let later (call (. ir reserve-block)))
        (let jumps fail-jumps)
        (let own-matching matching)
        (= matching (= (. matching testing) true))
        (= matching (= (. matching tested) subject))
        (match? ([] (. tree nodes) arm)
          (case (call .node-type-transform row)
            (if (!= (. row pattern) 0)
              (call emit-pattern (. row pattern) (call Typed (. value operand) type) later)
            )
          )
        )
        (= matching own-matching)
        (call store held (. inner offset) (call integer (as (. inner layout) MachineKind) index) false arm)
        (call store held (. flag offset) (call integer .machine-i8 1) false arm)
        (call jump done)
        (if (== fail-jumps jumps)
          (call (. ir start-block) done)
          (return)
        )
        (call (. ir start-block) later)
      )
      (+= index 1)
    )
    (call jump done)
    (call (. ir start-block) done)
  )
  (fn-do _ emit-resource _
    (param declared SyntaxId)
    (param id SyntaxId)
    ; The function the action of a markup loop region runs, given the environment the region was
    ; made in: the container is read again with the trackers of the action noting what it reads,
    ; the members of the region's host read by their names alone, and given to the region, read
    ; from where it was kept, by the markup runtime's replacer the type pass recorded at the `for`,
    ; as the reference's `collection-source` function does.
    (let live (. instances live))
    (let region (call (. facts loop-region-of) (. ([] (. instances rows) (. unit instance)) enclosing) id))
    (let slot (call channel-slot id))
    (let container (call (. tree region-container) id))
    (if (or (not region) (== slot no-slot) (== (. region replace) no-instance) unanchored)
      (call refuse .refused-function declared)
      (return)
    )
    (lazy unanchored (or (== container 0) (== (. live previous) no-instance) (== (. live next) no-instance)))
    (let previous (call (. ir add-local) managed-layout))
    (call store-local previous (. (call call-instance (. live previous) id (. pending length)) operand) id)
    (let next (call (. ir add-local) managed-layout))
    (call store-local next (. (call call-instance (. live next) id (. pending length)) operand) id)
    (let made-type (. ([] (. instances signatures) (. region create)) returns))
    (let host (call read-captured slot id (. region host)))
    (let made (call read-captured (+ slot 1) id made-type))
    (+= live-actions (call LiveTrackers previous next))
    (+= content-hosts (call Typed (. host operand) (. region host)))
    (+= content-roots (call make-operand .operand-void 0))
    (let source (call emit-expression container))
    (call (. content-hosts pop))
    (call (. content-roots pop))
    (call (. live-actions pop))
    (if (!= (. source type) (. region source))
      (= source (call convert container .reason-argument source))
    )
    (if (!= (. source type) (. region source))
      (call refuse .refused-conversion container)
      (return)
    )
    (let mark (. pending length))
    (+= pending (. made operand))
    (+= pending (. source operand))
    (do
      (inline (call raising-call id (. region replace) mark))
    )
    (call emit-end declared)
  )
  (fn-do _ emit-row-item Typed
    (param id SyntaxId)
    (param name Atom)
    ; A name the row of a keyed markup loop region gives its item by: the row's argument, the
    ; `MarkupRowItem` that holds the item, is read, the read of its `item` noted in the trackers of
    ; the live action open where one is, and its `item` read, as the reference's
    ; `readMarkupRowItem` does.
    (let held (call (. facts row-item-of) (. unit reading) id))
    (if (not (call (. tables is-class) held))
      (call refuse .refused-expression id)
      (return (call Typed (call make-operand .operand-void 0) no-type))
    )
    (let base (call emit-identifier id name held))
    (let item (call (. program store-atom) "item"))
    (if (or (!= (. live-actions length) 0) (call (. facts pulls) (. unit reading) id))
      (call track id (. base operand) item)
    )
    (return (call load-property id (. base operand) held item))
  )
  (fn-do _ emit-reselect _
    (param declared SyntaxId)
    (param id SyntaxId)
    ; The function the action of a markup branch region runs, given the environment the region was
    ; made in: the index of the arm to select is read again with the trackers of the action noting
    ; what the conditions read, the members of the region's host read by their names alone, and
    ; where the region does not keep that arm, the actions the region owns are closed and the
    ; markup runtime selects it, as the reference's `markup-branch` function does. That of a match
    ; region selects the arm whatever arm the region holds, as does that of a branch region for an
    ; arm written with a pattern (`emit-arm-index`).
    (let live (. instances live))
    (let region (call (. facts branch-region-of) (. ([] (. instances rows) (. unit instance)) enclosing) id))
    (let slot (call channel-slot id))
    (if (or (not region) (== slot no-slot) (== (. live previous) no-instance) (== (. live next) no-instance))
      (call refuse .refused-function declared)
      (return)
    )
    (let previous (call (. ir add-local) managed-layout))
    (call store-local previous (. (call call-instance (. live previous) id (. pending length)) operand) id)
    (let next (call (. ir add-local) managed-layout))
    (call store-local next (. (call call-instance (. live next) id (. pending length)) operand) id)
    (+= live-actions (call LiveTrackers previous next))
    (let host (call read-captured slot id (. region host)))
    (+= content-hosts (call Typed (. host operand) (. region host)))
    (+= content-roots (call make-operand .operand-void 0))
    (let patterned (call (. tree has-pattern-arm) id))
    (let kept (if-expr patterned (call (. ir add-local) u8-layout) no-local))
    (let selected (call emit-arm-index id (. region selected) kept))
    (call (. content-hosts pop))
    (call (. content-roots pop))
    (call (. live-actions pop))
    (let made-type (. ([] (. instances signatures) (. region create)) returns))
    (let made (call read-captured (+ slot 1) id made-type))
    (let given (call convert id .reason-argument (call Typed (. made operand) made-type)))
    (let selecting (call (. ir reserve-block)))
    (let done (call (. ir reserve-block)))
    (if (== (. region keeps) no-instance)
      (call jump selecting)
      (else
        (if patterned
          (let asking-block (call (. ir reserve-block)))
          (call branch (call load-local kept id) asking-block selecting)
          (call (. ir start-block) asking-block)
        )
        (let asking (. pending length))
        (+= pending (. given operand))
        (+= pending (. selected operand))
        (let keeps (call raising-call id (. region keeps) asking))
        (call branch (. keeps operand) done selecting)
      )
    )
    (call (. ir start-block) selecting)
    (call close-actions id (. made operand))
    (let choosing (. pending length))
    (+= pending (. given operand))
    (+= pending (. selected operand))
    (do
      (inline (call raising-call id (. region select) choosing))
    )
    (call jump done)
    (call (. ir start-block) done)
    (call emit-end declared)
  )
  (fn-do _ emit-arm _ (?! Refused)
    (param declared SyntaxId)
    (param body SyntaxId)
    ; The function that builds an arm of a markup branch region: the arm's body runs as content of
    ; the region it is given, under the batch in force where the region is written, where the type
    ; pass found one, read from where it was kept; the region is put under it first, twice, as the
    ; reference's builder and then its `compileContents` each do. That of an arm of a match region
    ; runs its body only where its pattern matches the subject (`match-subject`).
    (let parent (call make-operand .operand-argument 1))
    (let type (call (. instances argument-type) (. unit instance) 0))
    (let batch (call make-operand .operand-void 0))
    (let root (call (. facts region-root-of) (. unit reading) body))
    (if root
      (= batch (. (call read-captured (. root slot) body (. root batch)) operand))
      (if (!= (. root ensure) no-instance)
        (for (in pass (..< 0 2))
          (let host (call convert body .reason-markup-host (call Typed parent type)))
          (let given (call convert-from body .reason-markup-root batch))
          (let mark (. pending length))
          (+= pending (. host operand))
          (+= pending (. given operand))
          (call call-instance (. root ensure) body mark)
        )
      )
    )
    (let matched (call (. tree body-arm) body))
    (let failed (call (. ir reserve-block)))
    (let jumps fail-jumps)
    (let named (. bound length))
    (if (and (!= matched 0) (not (call match-subject matched failed)))
      (call drop-bound named)
      (call emit-end declared)
      (return)
    )
    (+= content-hosts (call Typed parent type))
    (+= content-roots batch)
    (call emit-block body)
    (call (. content-hosts pop))
    (call (. content-roots pop))
    (call drop-bound named)
    (if (!= fail-jumps jumps)
      (let finished (call (. ir reserve-block)))
      (call jump finished)
      (call (. ir start-block) failed)
      (call jump finished)
      (call (. ir start-block) finished)
    )
    (call emit-end declared)
  )
  (fn-do _ match-subject Bool
    (param arm SyntaxId)
    (param failed IRBlockId)
    ; Reads the subject of the match an arm of a markup match region, or of a branch region written
    ; with a pattern, is one of again, where a member of the region's host read by its name alone is
    ; read from the host kept where the region was made, copies a struct, and matches the arm's
    ; pattern against it, going to `failed` where it does not match, binding `it` and the names the
    ; pattern declares, as the reference's `markupCompileMatchedArm` does. False where the arm can
    ; never match, or once refused.
    (if (== (call (. facts plan-of) (. unit reading) arm) .plan-never)
      (return false)
    )
    (let subject (call (. tree matched-subject) (call (. tree arm-match) arm)))
    (let slot (call channel-slot (call (. tree arm-site) arm)))
    (let binding (. ([] (. instances rows) (. unit reading)) binding))
    (let site (if-expr (and (!= slot no-slot) (!= binding no-binding)) (. ([] (. bindings slots) slot) syntax) 0))
    (let region (call (. facts branch-region-of) (. ([] (. instances rows) (. unit instance)) enclosing) site))
    (if (or (not region) (== slot no-slot) (== subject 0))
      (call refuse .refused-function arm)
      (return false)
    )
    (let host (call read-captured slot arm (. region host)))
    (+= content-hosts (call Typed (. host operand) (. region host)))
    (+= content-roots (call make-operand .operand-void 0))
    (let value (call emit-expression subject))
    (let type (. value type))
    (call (. content-hosts pop))
    (call (. content-roots pop))
    (= value (call Typed (call apart value subject true) (. value type)))
    (let passed value)
    (match? ([] (. tree nodes) arm)
      (case (call .node-type-transform row)
        (if (!= (. row pattern) 0)
          (= passed (call emit-pattern (. row pattern) (call Typed (. value operand) type) failed))
        )
      )
    )
    (let it (call arm-slot-of arm .slot-it))
    (if (!= it no-slot)
      (+= bound (call BoundValue it (. passed type) (. passed operand)))
    )
    (return true)
  )
  (fn-do _ read-state Typed
    (param id SyntaxId)
    (param object Operand)
    (param type TypeId)
    (param state Atom)
    ; Reads the state a style `when` names on an object, as a `Bool`. No instance types the
    ; `when`, whose node is in the module that writes it, so the read consults no instance's facts.
    (let own-unit unit)
    (= unit (= (. unit reading) no-instance))
    (let value (call load-property id object type state true (. types bool-type)))
    (= unit own-unit)
    (return value)
  )
  (fn-do _ cell-local LocalId
    (param cell U32)
    ; The local that keeps a state cell made where code is emitted, or none.
    (for (in kept state-cells)
      (if (== (. kept row) cell)
        (return (. kept local))
      )
    )
    (return no-local)
  )
  (fn-do _ around-names (list SyntaxId)
    (param index U32)
    ; The names the rule of the frame of values of a rule around rules written in it
    ; (`ScopeValues`) takes them by, in order.
    (let frame ([] (. instances frames) (. ([] (. facts scope-values) index) frame)))
    (let owner ([] (. program modules) (. frame module)))
    (let names (list SyntaxId))
    (match? ([] (. owner decls) (. frame decl))
      (case (call .decl-style-rule rule)
        (match? ([] (. owner tree nodes) (. rule syntax))
          (case (call .node-rule-syntax declared)
            (for (in arg ([] (. owner tree children) (. declared args)))
              (match? ([] (. owner tree nodes) arg)
                (case (call .node-argument-decl shape)
                  (match? ([] (. owner tree nodes) (. shape pattern))
                    (case (call .node-type-capture capture)
                      (+= names (. capture id))
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
    (return names)
  )
  (fn-expr _ around-count U32
    (param index U32)
    ; How many values the rule around rules written in it takes (`ScopeValues`).
    (as (. (call around-names index) length) U32)
  )
  (fn-do _ around-local (tuple LocalId TypeId)
    (param index U32)
    (param position U32)
    ; The local that keeps a value of a rule around rules written in it (`ScopeValues`), by its place
    ; among them, where code is emitted, and its type: kept where the markup element that gave it
    ; applied the rule (`bind-rule-values`), or given this function (`take-values`); none where it is
    ; neither.
    (let held ([] (. facts scope-values) index))
    (if (!= (. held instance) (. unit instance))
      (return (tuple no-local no-type))
    )
    (if (or (!= (. held argument) (. U32 max)) (!= (. held kept) (. U32 max)))
      (let found (call taken-place index))
      (if (not found)
        (return (tuple no-local no-type))
      )
      (let place (+ (. ([] taken-values found) first) position))
      (return (tuple (. ([] around-values place) local) (. ([] around-values place) type)))
    )
    (let written (. ([] (. program modules) (. held module)) tree))
    (match? ([] (. written nodes) (. held site))
      (case (call .node-style-rule-application applied)
        (if (< position (. applied args count))
          (let found (call around-place ([] (. written children) (+ (. applied args start) position))))
          (if found
            (return (tuple (. ([] around-values found) local) (. ([] around-values found) type)))
          )
        )
      )
    )
    (return (tuple no-local no-type))
  )
  (fn-do _ around-place (? Size)
    (param written SyntaxId)
    ; Where `around-values` keeps the value a style rule written on a markup element gave for a node.
    (for (in position (..< 0 (. around-values length)))
      (if (== (. ([] around-values position) written) written)
        (return position)
      )
    )
    (return null)
  )
  (fn-do _ taken-place (? Size)
    (param row U32)
    ; Where `taken-values` keeps a row of `scope-values` the function was given.
    (for (in position (..< 0 (. taken-values length)))
      (if (== (. ([] taken-values position) row) row)
        (return position)
      )
    )
    (return null)
  )
  (fn-do _ take-values _
    (param declared SyntaxId)
    ; Keeps the values of the rules around rules written in rules that the function that fills an
    ; object with its class's markup is given, each in a local of its own (`taken-values`).
    (let held (. ([] (. instances rows) (. unit instance)) context))
    (if (== held (. U32 max))
      (return)
    )
    (let context ([] (. instances contexts) held))
    (for (in index (..< 0 (. facts scope-values length)))
      (let row ([] (. facts scope-values) index))
      (if (or (!= (. row instance) (. unit reading)) (== (. row argument) (. U32 max)) (!= (call taken-place (as index U32)) null))
        (continue)
      )
      (+= taken-values (call TakenValues (as index U32) (as (. around-values length) U32)))
      (for (in position (..< 0 (call around-count (as index U32))))
        (let place (call (. instances value-argument) (. unit instance) (+ (. row argument) position)))
        (let offset (- (+ (. row argument) position) (call (. instances context-cell-count) held)))
        (let type ([] (. instances context-value-types) (+ (. context value-first) offset)))
        (let local (call (. ir add-local) (call layout-of type declared) false))
        (call store-local
          (block
            (arg local)
            (arg (call make-operand .operand-argument (if-expr (. unit takes-self) (+ place 1) place)))
            (arg declared)
          )
        )
        (+= around-values (call AroundValue 0 local type))
      )
    )
  )
  (fn-do _ builder-value Typed
    (param line SyntaxId)
    ; What a line that gives a slot content gives as the slot's builder: its function, made the
    ; builder the type pass recorded at the line, with the batch in force kept first where the type
    ; pass found one, in the local the function reads it from; or, where it forwards a slot, the
    ; builder of that name this function was given, or reaches through the local that holds it.
    (let nothing (call make-operand .operand-void 0))
    (match? ([] (. tree nodes) line)
      (case (call .node-markup-slot-forward row)
        (let fact (call (. facts slot-outlet-of) (. unit reading) (. row outlet)))
        (if (and fact (!= (. fact argument) (. U32 max)))
          (let position (. fact argument))
          (return
            (call forward-builder
              (block
                (arg line)
                (arg (call Typed (call make-operand .operand-argument (if-expr (. unit takes-self) (+ position 1) position)) (call (. instances argument-type) (. unit instance) position)))
              )
            )
          )
        )
        (if (and fact (!= (. fact held) no-slot))
          (let type (. (call find-captured (. fact held) line) type))
          (return (call forward-builder line (call read-captured (. fact held) line type)))
        )
        (call refuse .refused-expression line)
        (return (call Typed nothing no-type))
      )
    )
    (let root (call (. facts region-root-of) (. unit reading) line))
    (if root
      (let batch (if-expr (!= (. content-roots length) 0) ([] content-roots (- (. content-roots length) 1)) nothing))
      (if (== (call operand-kind batch) .operand-void)
        (call refuse .refused-expression line)
        (return (call Typed nothing no-type))
      )
      (let field (call find-captured (. root slot) line))
      (call keep-captured (. root slot) batch (. field type) line)
    )
    (return (call convert line .reason-markup-slot (call emit-closure line)))
  )
  (fn-do _ emit-declare _ (?! Refused)
    (param id SyntaxId)
    (param pattern SyntaxId)
    (param value SyntaxId)
    ; A declaration of one local, with or without a type, of several that take no value, or of
    ; those a pattern names. A tuple taken apart from an optional panics where it holds nothing.
    (match ([] (. tree nodes) pattern)
      (case (call .node-type-capture row)
        (if (and (!= (. row type) 0) (call reads-name (. row type)))
          (call declare-shaped id pattern value)
          (else
            (call declare-local id (. row id) (. row type) value)
          )
        )
      )
      (case .node-type-property
        (call declare-shaped id pattern value)
      )
      (case .node-type-and
        (call declare-shaped id pattern value)
      )
      (case .node-type-list
        (call declare-shaped id pattern value)
      )
      (case .node-identifier
        (call declare-local id pattern 0 value)
      )
      (case (call .node-type-tuple row)
        (if (!= value 0)
          (let source (call emit-expression value))
          (if (call (. types is-optional) (. source type))
            (= source (call unwrap pattern source))
          )
          (call destructure id (. row field-types) (. source operand) (. source type) true)
          (else
            (for (in field ([] (. tree children) (. row field-types)))
              (call emit-declare id field 0)
            )
          )
        )
      )
      (case (call .node-tuple-syntax row)
        (call emit-destructure id (. row items) value true)
      )
      (default
        (call refuse .refused-statement id)
      )
    )
  )
  (fn-do _ declare-shaped _
    (param id SyntaxId)
    (param pattern SyntaxId)
    (param value SyntaxId)
    ; A declaration written with a pattern where a name or a type goes: the value is matched
    ; against the pattern, the names the pattern declares are locals that hold what it captured,
    ; and where it does not match the declaration panics. A pattern that the reference lets
    ; fail and go on from, its names unset, has no shape here.
    (if (== value 0)
      (call refuse .refused-statement id)
      (return)
    )
    (let subject (call emit-expression value))
    (call shape-declared id pattern subject)
  )
  (fn-do _ shape-declared _
    (param id SyntaxId)
    (param pattern SyntaxId)
    (param subject Typed)
    ; Matches a value a declaration, or the header of a loop, is given against the pattern
    ; written there, and panics where it does not fit.
    (if (not (call fails-aloud pattern))
      (call refuse .refused-statement id)
      (return)
    )
    (let failed (call (. ir reserve-block)))
    (let done (call (. ir reserve-block)))
    (let own-matching matching)
    (let jumps fail-jumps)
    (= matching (= (. matching declaring) true))
    (call emit-pattern pattern subject failed)
    (= matching own-matching)
    (call jump done)
    (call (. ir start-block) failed)
    (let plan (call (. facts plan-of) (. unit reading) (call tested pattern)))
    (if (== fail-jumps jumps)
      (call jump done)
      (else-if (or (not (. function may-panic)) other-plan)
        (call refuse .refused-statement id)
      )
      (else
        (call raise-text pattern "Pattern match failed")
      )
    )
    (lazy other-plan (and (!= plan .plan-unmatched) (!= plan .plan-list-pattern) (!= plan .plan-text-pattern)))
    (call (. ir start-block) done)
  )
  (fn-expr _ tested SyntaxId
    (param pattern SyntaxId)
    ; The pattern that tests what a declaration is given: the one written, or the one a name
    ; captures.
    (match ([] (. tree nodes) pattern)
      (case (call .node-type-capture row)
        (. row type)
      )
      (default
        pattern
      )
    )
  )
  (fn-expr _ fails-aloud Bool
    (param pattern SyntaxId)
    ; Whether a pattern panics wherever it does not match as a declaration: one that reads a
    ; name or takes anything always matches, and whatever is joined after a pattern fails aloud,
    ; as a pattern of items or of texts does.
    (match ([] (. tree nodes) pattern)
      (case .node-type-property
        true
      )
      (case .node-type-wildcard
        true
      )
      (case .node-type-list
        true
      )
      (case (call .node-type-capture row)
        (or (== (. row type) 0) (call fails-aloud (. row type)))
      )
      (case (call .node-type-and row)
        (or (== (call (. facts plan-of) (. unit reading) pattern) .plan-text-pattern) (call fails-aloud (. row left)))
      )
      (default
        false
      )
    )
  )
  (fn-expr _ reads-name Bool
    (param pattern SyntaxId)
    ; Whether a pattern passes on what a name read from its subject gives: one that reads a
    ; name, one joined after it, or a name that captures either.
    (match ([] (. tree nodes) pattern)
      (case .node-type-property
        true
      )
      (case (call .node-type-and row)
        (call reads-name (. row left))
      )
      (case (call .node-type-capture row)
        (and (!= (. row type) 0) (call reads-name (. row type)))
      )
      (default
        false
      )
    )
  )
  (fn-do _ emit-destructure _
    (param id SyntaxId)
    (param names (of RowRange SyntaxId))
    (param value SyntaxId)
    (param declares Bool)
    ; Takes a tuple written as a value apart, into the names written for its fields.
    (let source (call emit-expression value))
    (call destructure id names (. source operand) (. source type) declares)
  )
  (fn-do _ destructure _ (?! Refused)
    (param id SyntaxId)
    (param names (of RowRange SyntaxId))
    (param source Operand)
    (param owner TypeId)
    (param declares Bool)
    (param item Bool (= false))
    ; Takes a tuple apart: each of its first fields into a local, a new one or one that exists,
    ; or into a global that exists. The local has the field's own type, or the type written for
    ; it where the type pass recorded the field's conversion there, or the type of a local that
    ; exists, which the type pass recorded the field's conversion to at its name; the global has
    ; the field's own type. A field written as `_` goes nowhere, and one written as a tuple of names is taken
    ; apart in turn. A lazy local,
    ; whose value is evaluated wherever a read comes first, keeps the cell it was first given.
    ; A local an environment holds is stored there. `item` says the tuple is the item of a
    ; loop, and the names those its pattern writes. A table or a span of one is taken apart, as
    ; TypeScript takes it, into a view of each field's column of the type of its local, one name
    ; after another; one written as `_` still has the table checked.
    (let layout (call layout-of owner id))
    (let tabled (call is-row-source (call intrinsic owner)))
    (if (and (not tabled) (or (not (call (. tables layouts is-struct) layout)) too-few-fields))
      (call refuse .refused-statement id)
      (return)
    )
    (lazy too-few-fields (< (. ([] (. tables layouts rows) layout) fields count) (. names count)))
    (for (in position (..< 0 (. names count)))
      (let name ([] (. tree children) (+ (. names start) position)))
      (let annotation SyntaxId 0)
      (let skipped false)
      (match? ([] (. tree nodes) name)
        (case (call .node-type-capture row)
          (= name (. row id))
          (= annotation (. row type))
        )
        (case .node-type-wildcard
          (= skipped true)
        )
      )
      (if skipped
        (if tabled
          (call table-source id source owner layout)
        )
        (continue)
      )
      (let inner (call (. tree field-names) name))
      (if (and tabled (!= (. inner count) 0))
        (call refuse .refused-statement name)
        (return)
      )
      (if (!= (. inner count) 0)
        (let nested (call take source (call (. tables layouts field) layout position) id))
        (call destructure id inner nested (call field-type owner position) declares item)
        (continue)
      )
      (if (not declares)
        (let kept (call assigned-global name id))
        (if (!= kept no-storage)
          (if tabled
            (call refuse .refused-statement name)
            (return)
          )
          (call store-part-global
            (block
              (arg name)
              (arg kept)
              (arg (call take source (call (. tables layouts field) layout position) id))
              (arg (call field-type owner position))
            )
          )
          (continue)
        )
      )
      (let slot (call local-slot name id true item))
      (let offset (call slot-offset slot id))
      (let held (call (. facts slot-type) (. unit instance) offset))
      (if tabled
        (let view (call table-view id source owner layout position held))
        (call store-part id name slot offset (. view operand) held (call layout-of held name) declares)
        (continue)
      )
      (let field (call (. tables layouts field) layout position))
      (let kept (. field layout))
      (let part (call take source field id))
      (if (!= held (call field-type owner position))
        (if (and (== annotation 0) declares)
          (call refuse .refused-conversion name)
          (return)
        )
        (let given (call Typed part (call field-type owner position)))
        (let converted
          (block
            (case? declares
              (call convert annotation .reason-declaration given name)
            )
            (default
              (call convert name .reason-assignment given)
            )
          )
        )
        (= part (. converted operand))
        (if (!= (. converted type) held)
          (call refuse .refused-conversion name)
        )
        (= kept (call layout-of held name))
      )
      (call store-part id name slot offset part held kept declares)
    )
  )
  (fn-do _ declare-local _
    (param id SyntaxId)
    (param name SyntaxId)
    (param annotation SyntaxId)
    (param value SyntaxId)
    ; Gives a local its cell and stores its first value there: the value written, converted to
    ; the type written for the local, or the value its type has when none is written. A local
    ; that holds nothing has no cell, and its value is evaluated for what it does. A local that
    ; holds a struct holds a copy of the one it is given. A tuple written in parentheses where
    ; the type goes is a pattern to TypeScript, which converts nothing and names what the pattern
    ; names, so a value of any other type has no rule here. A local that nested functions
    ; capture is stored in the environment that holds it. One some read tracks tells no read of
    ; its first value.
    (let slot (call local-slot name id true false true))
    (let offset (call slot-offset slot id))
    (let type (call (. facts slot-type) (. unit instance) offset))
    (if (or (== type no-type) (== type invalid-type))
      (call refuse .refused-statement id)
      (return)
    )
    (let layout (call layout-of type id))
    (let initial (call make-operand .operand-void 0))
    (if (!= value 0)
      (= initial (. (call declared-value name annotation value type) operand))
      (else-if (!= layout void-layout)
        (let defaulted (call default-value annotation type layout id))
        (= initial (. defaulted operand))
        (if (!= (. defaulted type) type)
          (call refuse .refused-conversion id)
        )
      )
    )
    (if (== layout void-layout)
      (return)
    )
    (if (call is-captured slot)
      (call keep-captured slot initial type id)
      (return)
    )
    (let local (call (. ir add-local) layout (!= (/and/ (. ([] (. bindings slots) slot) flags) (. SlotFlag slot-address-taken)) 0)))
    (= ([] (. unit cells) offset) local)
    (call store-local local initial id)
  )
  (fn-do _ declared-value Typed
    (param name SyntaxId)
    (param annotation SyntaxId)
    (param value SyntaxId)
    (param type TypeId)
    ; The value a declaration writes for a local, converted to the type written for the local,
    ; which is the type the local holds.
    (let initial (call emit-expression value))
    (if (!= annotation 0)
      (= initial (call convert annotation .reason-declaration initial name))
    )
    (if (!= (. initial type) type)
      (call refuse .refused-conversion value)
    )
    (return initial)
  )
  (fn-do _ default-value Typed
    (param annotation SyntaxId)
    (param type TypeId)
    (param layout LayoutId)
    (param id SyntaxId)
    ; The value a local has when its declaration writes none: the zero of a number, the empty
    ; text, the null pointer, an optional that holds nothing, a tuple with no name as it is with
    ; nothing written, or what the constructor the type pass chose at the local's type makes, and
    ; for a union none was chosen for, its first case (`first-case`).
    (let nothing (call make-operand .operand-void 0))
    (if (and (call (. types is-optional) type) (or (call (. tables layouts is-struct) layout) (call is-null-form type)))
      (return (call empty-optional type layout))
    )
    (if (and (call (. types is-plain-tuple) type) (call (. tables layouts is-struct) layout))
      (return (call null-value type layout id))
    )
    (if (and (== (call intrinsic type) .cpointer) (or (== layout pointer-layout) (== layout managed-layout)))
      (return (call Typed (call integer (as layout MachineKind) 0) type))
    )
    (if (== type (. types null-type))
      (if (or (== layout pointer-layout) (== layout managed-layout))
        (return (call Typed (call integer (as layout MachineKind) 0) type))
      )
      (return (call Typed nothing type))
    )
    (if (or (call is-numeric-type type) (== type (. types bool-type)))
      (if (call is-float layout)
        (return (call Typed (call float-number layout 0.0) type))
      )
      (return (call Typed (call integer (call (. tables layouts kind-of) layout) 0) type))
    )
    (if (== type (. types string-type))
      (return (call Typed (call make-operand .operand-constant (call (. ir add-string) "")) type))
    )
    (let fact (if-expr (== annotation 0) no-fact (call (. facts first-call) (. unit reading) annotation)))
    (if (and (== fact no-fact) (call (. tables layouts is-union) layout))
      (return (call first-case type layout id))
    )
    (if (or (== fact no-fact) (!= (. ([] (. facts calls) fact) next) no-fact) other-form)
      (call refuse .refused-statement id)
      (return (call Typed nothing no-type))
    )
    (lazy other-form (!= (. ([] (. facts calls) fact) form) .call-this-constructor))
    (return (call emit-fact-call annotation ([] (. facts calls) fact) 0 (call (of RowRange SyntaxId)) 0 0 type))
  )
  (fn-do _ first-case Typed (?! Refused)
    (param type TypeId)
    (param layout LayoutId)
    (param id SyntaxId)
    ; The first case of a union, holding the value a local of the case's type has with nothing
    ; written, as the reference's `defaultValue` of a union gives it; a case that holds nothing
    ; has nothing set.
    (if (== (. ([] (. tables layouts rows) layout) cases count) 0)
      (call refuse .refused-statement id)
      (return (call Typed (call make-operand .operand-void 0) no-type))
    )
    (let field (call (. tables layouts case-field) layout 0))
    (if (== (. field layout) void-layout)
      (let made (call frame layout))
      (call zero made layout)
      (return (call Typed made type))
    )
    (let held (call default-value 0 (. field type) (. field layout) id))
    (return (call make-union id type 0 held))
  )
  (fn-do _ local-slot SlotId
    (param name SyntaxId)
    (param site SyntaxId)
    (param shared Bool (= false))
    (param item Bool (= false))
    (param tracked Bool (= false))
    ; The slot of a local a name declares or is assigned through, or of an argument it is assigned
    ; through, when it is one a cell holds: nothing captures it or tracks it. `shared` takes
    ; one that nested functions capture too, which an environment holds, and so a lazy local
    ; an environment holds. Any other lazy local is declared where its value is being evaluated.
    ; `item` takes instead a name the pattern of a loop writes for a field of its item, and
    ; `tracked` one some read tracks, for a declaration or an assignment, which tells the reads.
    (let binding (. ([] (. instances rows) (. unit reading)) binding))
    (let unkept
      (scope (if-expr shared (. SlotFlag slot-tracked) captured-tracked)
        (lazy captured-tracked (/or/ (. SlotFlag slot-captured) (. SlotFlag slot-tracked)))
      )
    )
    (if tracked
      (= unkept (/and/ unkept (. SlotFlag slot-captured)))
    )
    (if (and (!= binding no-binding) (== (. unit reading) (. unit instance)))
      (match? ([] (. tree nodes) name)
        (case .node-identifier
          (let resolution (call (. bindings resolution-of) binding name))
          (if (== (. resolution kind) .resolve-slot)
            (let row ([] (. bindings slots) (. resolution slot)))
            (let is-held (or (== (. row kind) .slot-local) (== (. row kind) .slot-argument)))
            (if item
              (= is-held (== (. row kind) .slot-loop-item))
            )
            (if (== (. row kind) .slot-lazy)
              (= is-held (and shared (== (call (. bindings lazy-policy) (. resolution slot)) .lazy-shared)))
              (for (in open lazy-open)
                (if (== open (. resolution slot))
                  (= is-held true)
                )
              )
            )
            (if (and is-held (== (/and/ (. row flags) unkept) 0))
              (return (. resolution slot))
            )
          )
        )
      )
    )
    (call refuse .refused-statement site)
    (return (. unit slot-start))
  )
  (fn-do _ argument-memory Operand
    (param slot SlotId)
    (param type TypeId)
    (param id SyntaxId)
    ; The memory of an argument that is a struct, which the function owns and which has no cell:
    ; an assignment to the argument copies the value there.
    (let nothing (call make-operand .operand-void 0))
    (if (or (not (call is-own-slot slot)) (!= (. ([] (. bindings slots) slot) kind) .slot-argument))
      (call refuse .refused-statement id)
      (return nothing)
    )
    (let position (call argument-position slot))
    (let index (if-expr (. unit takes-self) (+ position 1) position))
    (let layout (call layout-of type id))
    (let passed (and (== (call (. instances argument-type) (. unit instance) position) type) (< index (. ir arguments length))))
    (if (or (not passed) (not (call (. tables layouts is-struct) layout)) (!= (as ([] (. ir arguments) index) LayoutId) layout))
      (call refuse .refused-statement id)
      (return nothing)
    )
    (return (call make-operand .operand-argument index))
  )
  (fn-do _ emit-setter _
    (param lhs SyntaxId)
    (param object SyntaxId)
    (param rhs SyntaxId)
    (param fact CallFact)
    ; An assignment a setter answers: the setter is called on the object with the value, which
    ; takes the conversion recorded for an argument. The value is evaluated before the object.
    (let callee (. fact callee))
    (if (or (== callee no-instance) (. fact is-partial) (not (call is-callable callee)))
      (call refuse .refused-statement lhs)
      (return)
    )
    (if (!= (. ([] (. instances signatures) callee) args count) 1)
      (call refuse .refused-statement lhs)
      (return)
    )
    (let made (call emit-expression rhs))
    (let converted
      (call convert
        (block
          (arg rhs)
          (arg .reason-argument)
          (arg (call Typed (call apart made rhs (and (!= object 0) (not (call is-inert object)))) (. made type)))
        )
      )
    )
    (let value (. converted operand))
    (if (!= (. converted type) (call (. instances argument-type) callee 0))
      (call refuse .refused-conversion rhs)
      (return)
    )
    (let receiver (call emit-receiver lhs object))
    (if (!= (. receiver type) (. ([] (. instances rows) callee) self-type))
      (call refuse .refused-conversion lhs)
    )
    (let mark (. pending length))
    (+= pending (. receiver operand))
    (+= pending value)
    (call call-method callee lhs mark)
  )
  (fn-expr _ is-own-field Bool
    (param name SyntaxId)
    ; Whether a name is a field of the receiver, in a member of a struct or of a class, or in
    ; the constructor of a tuple, or in a rule of a class run on the object being made.
    (case? (or (== binding no-binding) (and (!= (. unit reading) (. unit instance)) (not (. unit running-rule))) (not (. unit has-self)))
      false
    )
    (case? (and (not (call is-stored owner 0)) (not (call (. tables is-class) owner)))
      false
    )
    (default
      (== (. (call (. bindings resolution-of) binding name) kind) .resolve-member)
    )
    (where
      (lazy binding (. ([] (. instances rows) (. unit reading)) binding))
      (lazy owner (. unit owner-type))
    )
  )
  (fn-expr _ is-mutable-value Bool
    (param type TypeId)
    ; Whether a value's fields are changed in place: a struct's.
    (== (call intrinsic type) .struct)
  )
  (fn-do _ is-framed Bool
    (param id SyntaxId)
    ; Whether an expression names memory of the frame: a local or an argument that holds a tuple
    ; or struct, the receiver that is one, or a field of any of them. No syntax is the receiver.
    (if (== id 0)
      (return true)
    )
    (let type (call (. facts node-type) (. unit reading) id))
    (if (or (== type no-type) (== type invalid-type) (not (call is-aggregate type)))
      (return false)
    )
    (let binding (. ([] (. instances rows) (. unit reading)) binding))
    (match? ([] (. tree nodes) id)
      (case .node-identifier
        (if (or (== binding no-binding) (!= (. unit reading) (. unit instance)))
          (return false)
        )
        (let resolution (call (. bindings resolution-of) binding id))
        (if (== (. resolution kind) .resolve-slot)
          (let kind (. ([] (. bindings slots) (. resolution slot)) kind))
          (return (or (== kind .slot-local) (== kind .slot-argument) (== kind .slot-this)))
        )
        (return (and (== (. resolution kind) .resolve-member) (call is-stored (. unit owner-type) 0) (call is-own-field id)))
      )
      (case (call .node-get-expression row)
        (return (call is-framed (. row object)))
      )
      (case (call .node-index-expression row)
        (return (and (call names-field id) (call is-framed (. row object))))
      )
    )
    (return false)
  )
  (fn-expr _ names-field Bool
    (param id SyntaxId)
    ; Whether an index names a stored field of its object, by the constant the type pass
    ; recorded. One a function answers gives a value of its own, which names no storage.
    (and (!= (call indexed-field id) no-fact) (== (call own-call id) no-fact) (!= (call (. facts plan-of) (. unit reading) id) .plan-item))
  )
  (fn-do _ places-item Bool
    (param id SyntaxId)
    ; Whether a struct a store goes into is one that lies in storage, as TypeScript finds it once
    ; it has inlined what reads it: an item past a pointer, what an index answers by a function
    ; written `@inline` as an expression, or a struct stored in either.
    (match? ([] (. tree nodes) id)
      (case (call .node-get-expression row)
        (let owner (call (. facts node-type) (. unit reading) (. row object)))
        (if (or (== owner no-type) (== owner invalid-type) (not (call is-mutable-value owner)) (call is-link id))
          (return false)
        )
        (if (or (!= (call (. facts plan-of) (. unit reading) id) .plan-none) (!= (call own-call id) no-fact))
          (return false)
        )
        (return (call places-item (. row object)))
      )
      (case (call .node-index-expression row)
        (if (call is-link id)
          (return false)
        )
        (if (== (call (. facts plan-of) (. unit reading) id) .plan-item)
          (return true)
        )
        (let fact (call own-call id))
        (if (or (== fact no-fact) (!= (call (. facts plan-of) (. unit reading) id) .plan-none))
          (return false)
        )
        (let callee (. ([] (. facts calls) fact) callee))
        (return (and (!= callee no-instance) (!= (call inlined-answer callee) 0)))
      )
    )
    (return false)
  )
  (fn-do _ place-of Typed (?! Refused)
    (param id SyntaxId)
    ; Where a struct that `places-item` finds in storage lies, for a store into a field of it.
    (match? ([] (. tree nodes) id)
      (case (call .node-get-expression row)
        (let base (call place-of (. row object)))
        (let owner (. base type))
        (return (call load-property id (. base operand) owner (. row name)))
      )
      (case (call .node-index-expression row)
        (if (== (call (. facts plan-of) (. unit reading) id) .plan-item)
          (return (call item-place id (. row object) (. row index)))
        )
        (return (call place-index-call id ([] (. facts calls) (call own-call id)) (. row object) (. row index)))
      )
    )
    (call refuse .refused-statement id)
    (return (call Typed (call make-operand .operand-void 0) no-type))
  )
  (fn-do _ item-place Typed
    (param id SyntaxId)
    (param object SyntaxId)
    (param index SyntaxId)
    ; The struct an index names past a pointer, where it lies: the pointer is evaluated before the
    ; index, as for a read, and nothing is copied.
    (let place (call item-address id object index))
    (let type (call (. tables layouts pointee-type) (. place type)))
    (let layout (call layout-of type id))
    (if (not (call (. tables layouts is-struct) layout))
      (call refuse .refused-expression id)
      (return place)
    )
    (return (call Typed (call address (. place operand) 0 layout id) type))
  )
  (fn-do _ inlined-answer SyntaxId
    (param callee InstanceId)
    ; The body of a member written `@inline` as an expression, which a store into what it answers
    ; runs where the store is, as TypeScript inlines it: 0 for any other function.
    (let row ([] (. instances rows) callee))
    (match? ([] (. ([] (. program modules) (. row module)) decls) (. row decl))
      (case (call .decl-function fn)
        (let is-member (or (== (. fn kind) .function-decl) (== (. fn kind) .getter-decl)))
        (if (or (. fn is-generated) (. fn is-static) (== (. fn owner) 0) (not is-member))
          (return 0)
        )
        (match? ([] (. ([] (. program modules) (. row module)) tree nodes) (. fn syntax))
          (case (call .node-function-syntax syntax)
            (if (and (. syntax is-inline) (not (. syntax imperative)))
              (return (. syntax body))
            )
          )
        )
      )
    )
    (return 0)
  )
  (fn-do _ inlined-static-answer SyntaxId
    (param callee InstanceId)
    ; The body of a function with no receiver, a static one or one declared alone, written `@inline`
    ; as an expression, which a store into what it answers runs where the store is, as TypeScript
    ; inlines it: 0 for any other function.
    (if (== callee no-instance)
      (return 0)
    )
    (let row ([] (. instances rows) callee))
    (match? ([] (. ([] (. program modules) (. row module)) decls) (. row decl))
      (case (call .decl-function fn)
        (if (or (. fn is-generated) (!= (. fn kind) .function-decl) (and (not (. fn is-static)) (!= (. fn owner) 0)))
          (return 0)
        )
        (match? ([] (. ([] (. program modules) (. row module)) tree nodes) (. fn syntax))
          (case (call .node-function-syntax syntax)
            (if (and (. syntax is-inline) (not (. syntax imperative)))
              (return (. syntax body))
            )
          )
        )
      )
    )
    (return 0)
  )
  (fn-do _ is-inline Bool
    (param callee InstanceId)
    ; Whether a function is written `@inline`, which TypeScript runs where it is called.
    (let row ([] (. instances rows) callee))
    (match? ([] (. ([] (. program modules) (. row module)) decls) (. row decl))
      (case (call .decl-function fn)
        (match? ([] (. ([] (. program modules) (. row module)) tree nodes) (. fn syntax))
          (case (call .node-function-syntax syntax)
            (return (. syntax is-inline))
          )
        )
      )
    )
    (return false)
  )
  (fn-expr _ answers-copy Bool
    (param id SyntaxId)
    ; Whether a call gives what a function answers in memory of the call's own, which nothing else
    ; names, as TypeScript's does where it calls the function: one it calls by itself, not through a
    ; witness table, that is not written `@inline`.
    (case? (== fact no-fact)
      false
    )
    (case? (or (not direct) (. row is-partial) (== (. row callee) no-instance) (not (call is-callable (. row callee))))
      false
    )
    (default
      (and (not (call is-inline (. row callee))) (not (call (. tables is-prototype) (. row callee))))
    )
    (where
      (lazy fact (call own-call id))
      (lazy row ([] (. facts calls) fact))
      (lazy direct (or (== (. row form) .call-function) (== (. row form) .call-method) (== (. row form) .call-static)))
    )
  )
  (fn-do _ place-index-call Typed
    (param id SyntaxId)
    (param fact CallFact)
    (param object SyntaxId)
    (param index SyntaxId)
    ; Where the struct an index answers lies, for a store into a field of it, where the function
    ; that answers it is a member written `@inline` as an expression. The receiver and
    ; the key are evaluated as for the call, each with its conversion, and then the function's body
    ; runs here as TypeScript inlines it, with its own locals for the run and the key in its
    ; argument's: its answer is where the storage it names lies. A function that raises, keeps an
    ; environment, takes a struct, or runs in another zone has no shape here, and nor has one run
    ; where a value is pinned, since its syntax is of its own module.
    (let nothing (call make-operand .operand-void 0))
    (let callee (. fact callee))
    (if (or (== callee no-instance) (. fact is-partial) (not (call is-callable callee)) out-of-order)
      (call refuse .refused-statement id)
      (return (call Typed nothing no-type))
    )
    (lazy out-of-order (not (call fills-in-order fact callee 1)))
    (let body (call inlined-answer callee))
    (let owner (. ([] (. instances rows) callee) self-type))
    (let answer (call (. facts node-type) (. unit reading) id))
    (let closed
      (scope (or (!= ([] (. tables environments) callee) no-layout) (!= (call is-free callee) in-zone) has-pins)
        (lazy has-pins (!= (. pins length) 0))
      )
    )
    (if (or (== body 0) closed (!= (. ([] (. instances signatures) callee) errors count) 0) (== owner no-type))
      (call refuse .refused-statement id)
      (return (call Typed nothing no-type))
    )
    (if (or (!= (. ([] (. instances signatures) callee) returns) answer) (call names-slot object .slot-super))
      (call refuse .refused-statement id)
      (return (call Typed nothing no-type))
    )
    (let receiver (call convert object .reason-receiver (call emit-expression object)))
    (let receiver-type (. receiver type))
    (let key (call convert index .reason-argument (call emit-expression index)))
    (if (!= receiver-type owner)
      (call refuse .refused-conversion object)
      (return (call Typed nothing no-type))
    )
    (if (!= (. key type) (call (. instances argument-type) callee 0))
      (call refuse .refused-conversion index)
      (return (call Typed nothing no-type))
    )
    (let key-layout (call layout-of (. key type) index))
    (if (call (. tables layouts is-struct) key-layout)
      (call refuse .refused-statement id)
      (return (call Typed nothing no-type))
    )
    (return (call run-inlined-place callee body answer (. receiver operand) true (list (. key operand)) (list key-layout) id))
  )
  (fn-do _ place-static-call Typed
    (param id SyntaxId)
    (param fact CallFact)
    (param written (of RowRange SyntaxId))
    ; Where the struct a call answers lies, in an inlined body, where the function is one with no
    ; receiver written `@inline` as an expression, as `GCBacking.load` is. The arguments are
    ; evaluated in the order written, each with its conversion, and then the function's body runs
    ; here as TypeScript inlines it. A function that raises, keeps an environment, takes a struct or
    ; runs in another zone has no shape here, and nor has one run where a value is pinned.
    (let nothing (call make-operand .operand-void 0))
    (let callee (. fact callee))
    (let count (as (. written count) U32))
    (if (or (== callee no-instance) (. fact is-partial) (not (call is-callable callee)) out-of-order)
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (lazy out-of-order (not (call fills-in-order fact callee count)))
    (let body (call inlined-static-answer callee))
    (let answer (call (. facts node-type) (. unit reading) id))
    (let closed
      (scope (or (!= ([] (. tables environments) callee) no-layout) (!= (call is-free callee) in-zone) has-pins)
        (lazy has-pins (!= (. pins length) 0))
      )
    )
    (if (or (== body 0) closed (!= (. ([] (. instances signatures) callee) errors count) 0) other-answer)
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (lazy other-answer (!= (. ([] (. instances signatures) callee) returns) answer))
    (let given (list Operand))
    (let layouts (list LayoutId))
    (let evaluated U32)
    (for (in argument ([] (. tree children) written))
      (let expression argument)
      (match? ([] (. tree nodes) argument)
        (case (call .node-argument named)
          (= expression (. named expr))
        )
      )
      (+= evaluated 1)
      (let made (call emit-expression expression))
      (let value
        (call convert
          (block
            (arg argument)
            (arg .reason-argument)
            (arg (call Typed (call settled made expression written evaluated) (. made type)))
          )
        )
      )
      (if (!= (. value type) (call (. instances argument-type) callee (- evaluated 1)))
        (call refuse .refused-conversion argument)
        (return (call Typed nothing no-type))
      )
      (let layout (call layout-of (. value type) argument))
      (if (call (. tables layouts is-struct) layout)
        (call refuse .refused-expression id)
        (return (call Typed nothing no-type))
      )
      (+= given (. value operand))
      (+= layouts layout)
    )
    (return (call run-inlined-place callee body answer nothing false given layouts id))
  )
  (fn-do _ run-inlined-place Typed
    (param callee InstanceId)
    (param body SyntaxId)
    (param answer TypeId)
    (param receiver Operand)
    (param receives Bool)
    (param given (list Operand))
    (param layouts (list LayoutId))
    (param site SyntaxId)
    ; Runs the body of a function written `@inline` as an expression where a store into what it
    ; answers is, as TypeScript inlines it, with its own locals for the run, the receiver where it
    ; `receives` one, and each argument in its parameter's cell, and answers where the storage its
    ; answer names lies. Its syntax is of its own module.
    (let own-unit unit)
    (let run (call enter-unit callee))
    (= unit (= (. unit source-module) (. ([] (. instances rows) callee) module)))
    (if receives
      (= unit (= (. unit self) receiver))
    )
    (= unit (= (. unit has-self) receives))
    (= unit (= (. unit takes-self) receives))
    (call bind-inlined-arguments given layouts site)
    (let place (call make-operand .operand-void 0))
    (let last (call ending body))
    (if (== last 0)
      (call refuse .refused-expression body)
    )
    (let answered (call place-answer last))
    (= place (. answered operand))
    (if (!= (. answered type) answer)
      (call refuse .refused-conversion last)
    )
    (call leave-unit run)
    (= unit own-unit)
    (return (call Typed place answer))
  )
  (fn-do _ bind-inlined-arguments _
    (param given (list Operand))
    (param layouts (list LayoutId))
    (param site SyntaxId)
    ; Gives each argument of a function run where it is called the cell that holds the value it was
    ; given. One that nested functions capture, or some read tracks, has no shape here.
    (for (in offset (..< 0 (. unit slot-count)))
      (let slot ([] (. bindings slots) (+ (. unit slot-start) offset)))
      (if (or (!= (. slot kind) .slot-argument) (not (call owns (+ (. unit slot-start) offset))))
        (continue)
      )
      (if (or (call is-captured (+ (. unit slot-start) offset)) (!= (/and/ (. slot flags) (. SlotFlag slot-tracked)) 0))
        (call refuse .refused-statement site)
        (return)
      )
      (let position (as (call argument-position (+ (. unit slot-start) offset)) Size))
      (if (>= position (. given length))
        (call refuse .refused-statement site)
        (return)
      )
      (let layout ([] layouts position))
      (if (== layout void-layout)
        (continue)
      )
      (let local (call (. ir add-local) layout (!= (/and/ (. slot flags) (. SlotFlag slot-address-taken)) 0)))
      (= ([] (. unit cells) offset) local)
      (call store-local local ([] given position) site)
    )
  )
  (fn-do _ place-answer Typed (?! Refused)
    (param id SyntaxId)
    ; Where the struct the body of a function run where it is called answers lies: an item past a
    ; pointer, a stored field of the receiver, what an index answers by a function this runs where
    ; it is called in turn, what a function with no receiver this runs where it is called answers,
    ; or for a match with no subject, the place each arm's answer gives. What `answers-copy` says a
    ; call gives lies where the call left it, which nothing else names, as TypeScript's store
    ; through it goes nowhere else.
    (let nothing (call make-operand .operand-void 0))
    (match? ([] (. tree nodes) id)
      (case (call .node-index-expression row)
        (if (and (not (call is-link id)) (== (call (. facts plan-of) (. unit reading) id) .plan-item))
          (return (call item-place id (. row object) (. row index)))
        )
        (if (and (not (call is-link id)) (call places-item id))
          (return (call place-of id))
        )
      )
      (case (call .node-identifier row)
        (let found (only-if (call property-of (. unit owner-type) (. row name)) (if (call is-own-field id))))
        (let eager (and found (== (. ([] (. types properties) found) storage-kind) .storage-eager)))
        (if (and eager (== (call own-call id) no-fact) (== (call (. facts plan-of) (. unit reading) id) .plan-none))
          (return (call load-property id (. unit self) (. unit owner-type) (. row name)))
        )
      )
      (case (call .node-call-expression row)
        (if (call answers-copy id)
          (return (call emit-expression id))
        )
        (let fact (call own-call id))
        (if (and (!= fact no-fact) (== (call (. facts plan-of) (. unit reading) id) .plan-none) static-inline)
          (return (call place-static-call id ([] (. facts calls) fact) (. row args)))
        )
        (lazy static-inline (!= (call inlined-static-answer (. ([] (. facts calls) fact) callee)) 0))
      )
      (case (call .node-structure-match row)
        (return (call place-match id (. row pattern)))
      )
      (case (call .node-match-expression row)
        (if (and (== (. row subject) 0) (not (. row is-optional)) (== (. row helper) 0))
          (match? ([] (. tree nodes) (. row body))
            (case (call .node-structure-match arms)
              (return (call place-match id (. arms pattern)))
            )
          )
        )
      )
    )
    (call refuse .refused-expression id)
    (return (call Typed nothing no-type))
  )
  (fn-do _ is-place Bool
    (param id SyntaxId)
    ; Whether an expression only names storage: a local, or a field of one, at a place a key that
    ; calls nothing gives, or one of those forced or cast where that calls nothing. Reading it twice
    ; does nothing twice, so a name a getter answers is not one.
    (match? ([] (. tree nodes) id)
      (case .node-identifier
        (return (not (call reads-getter id)))
      )
      (case (call .node-get-expression row)
        (return (and (not (call reads-getter id)) (call is-place (. row object))))
      )
      (case (call .node-index-expression row)
        (return (and (call names-field id) (call is-place (. row object)) (call is-inert (. row index))))
      )
      (case (call .node-unary-expression row)
        (let calls (!= (call (. facts first-call) (. unit reading) id) no-fact))
        (return (and (== (. row op) .optional-force-op) (not calls) (call is-place (. row operand))))
      )
      (case (call .node-cast-expression row)
        (return (and (== (call (. facts first-call) (. unit reading) id) no-fact) (call is-place (. row lhs))))
      )
    )
    (return false)
  )
  (fn-do _ reads-getter Bool
    (param id SyntaxId)
    ; Whether the type pass recorded the call of a getter at a node, for the node's value.
    (let fact (call (. facts first-call) (. unit reading) id))
    (while (!= fact no-fact)
      (if (== (. ([] (. facts calls) fact) form) .call-getter)
        (return true)
      )
      (= fact (. ([] (. facts calls) fact) next))
    )
    (return false)
  )
  (fn-do _ emit-if _
    (param id SyntaxId)
    (param condition SyntaxId)
    (param body SyntaxId)
    (param next SyntaxId)
    ; A branch runs its body where its condition tests as true, and otherwise what follows it:
    ; another branch, or the body of an `else`, which is a branch with no condition. A branch the
    ; type pass found never taken evaluates its condition and goes on to what follows it.
    (if (== condition 0)
      (if (!= next 0)
        (call refuse .refused-statement next)
        (return)
      )
      (call emit-block body)
      (return)
    )
    (if (== (call (. facts plan-of) (. unit reading) id) .plan-never)
      (call test condition (call emit-expression condition))
      (if (!= next 0)
        (call emit-statement next)
      )
      (return)
    )
    (let taken (call (. ir reserve-block)))
    (let done (call (. ir reserve-block)))
    (let other (if-expr (== next 0) done (call (. ir reserve-block))))
    (call branch-on condition taken other)
    (call (. ir start-block) taken)
    (call emit-block body)
    (call jump done)
    (if (!= next 0)
      (call (. ir start-block) other)
      (call emit-statement next)
      (call jump done)
    )
    (call (. ir start-block) done)
  )
  (fn-do _ tested SyntaxId
    (param loop SyntaxId)
    (param clause SyntaxId)
    ; The clauses the subscriber of a loop on a stream tests: those after the first where it says
    ; which publications a loop on an event hears. A `whenever` among them says whether the loop
    ; is subscribed and is not tested.
    (if (call (. facts event-clause-of) (. unit source-module) loop)
      (match? ([] (. tree nodes) clause)
        (case (call .node-clause row)
          (return (. row next))
        )
      )
    )
    (return clause)
  )
  (fn-do _ emit-publish Typed
    (param id SyntaxId)
    (param used EventUse)
    (param operands (of RowRange SyntaxId))
    ; A write to an event, as the reference publishes one: the object is evaluated, and where the
    ; event is live, the event runtime says whether anything listens to it on the object; only
    ; then is the payload made and published. A keyed event is asked at its address, the key the
    ; index gives, for the generation of the receiver there, which none is where nothing listens,
    ; and published at the address with it. One that bubbles is published with the object made
    ; the `EventNode` its parents are walked from.
    (let nothing (call make-operand .operand-void 0))
    (let owner (call event-owner (. used reference) (. used owner)))
    (let number (call (. tables event-number) (. used owner) (. used name)))
    (if (== number (. U32 max))
      (return (call Typed nothing (. types void-type)))
    )
    (let pointer (call num-cast id (. owner operand) managed-layout pointer-layout))
    (let keyed (!= (. used address) 0))
    (let key (if-expr keyed (call emit-key (. used address)) (call Typed nothing no-type)))
    (call count-event .publish-attempts id)
    (let asking (. pending length))
    (+= pending pointer)
    (+= pending (call integer .machine-u64 number))
    (if keyed
      (call push-key (. key operand) (. key type) id)
    )
    (let answer (call call-instance (. used first) id asking))
    (let interested
      (block
        (case? keyed
          (call compare id .compare-not-equal (. answer operand) (call integer .machine-u64 0))
        )
        (default
          (. answer operand)
        )
      )
    )
    (let publishing (call (. ir reserve-block)))
    (let done (call (. ir reserve-block)))
    (let missing done)
    (if (!= ([] (. tables event-counts) (as (. EventCount publish-interest-misses) Size)) 0)
      (= missing (call (. ir reserve-block)))
    )
    (call branch interested publishing missing)
    (call (. ir start-block) publishing)
    (call count-event .payload-builds id)
    (let given ([] (. tree children) (. operands start)))
    (let payload (call convert given .reason-argument (call emit-expression (call (. tree argument-value) given))))
    (let node
      (block
        (case? (. used bubbles)
          (. (call convert-from (. used reference) .reason-event-node (. owner operand)) operand)
        )
        (default
          nothing
        )
      )
    )
    (let mark (. pending length))
    (+= pending pointer)
    (+= pending (call integer .machine-u64 number))
    (if keyed
      (call push-key (. key operand) (. key type) id)
      (+= pending (. answer operand))
    )
    (if (. used bubbles)
      (+= pending node)
    )
    (+= pending (. payload operand))
    (do
      (inline (call call-instance (. used second) id mark))
    )
    (call jump done)
    (if (!= missing done)
      (call (. ir start-block) missing)
      (call count-event .publish-interest-misses id)
      (call jump done)
    )
    (call (. ir start-block) done)
    (return (call Typed nothing (. types void-type)))
  )
  (fn-do _ emit-readdress Typed
    (param id SyntaxId)
    (param used EventUse)
    (param operands (of RowRange SyntaxId))
    ; `rekey` or `release` of the address of a keyed event, as the reference makes them: the
    ; object and the key are evaluated, then for `rekey` the new key, converted to the event's
    ; key type, and the event runtime gives the address the receiver claimed there the new key,
    ; whose errors leave the function with the call, or under `catch` are what the call gives, or
    ; gives it up.
    (let nothing (call make-operand .operand-void 0))
    (let owner (call event-owner (. used reference) (. used owner)))
    (let number (call (. tables event-number) (. used owner) (. used name)))
    (if (== number (. U32 max))
      (return (call Typed nothing (. types void-type)))
    )
    (let key (call emit-key (. used address)))
    (let key-type (. key type))
    (let rekeys (== (. used kind) .event-rekey))
    (let next nothing)
    (if rekeys
      (let given ([] (. tree children) (. operands start)))
      (let converted (call convert given .reason-argument (call emit-expression (call (. tree argument-value) given))))
      (= next (. converted operand))
      (if (!= (. converted type) key-type)
        (call refuse .refused-conversion given)
      )
    )
    (let identity (call receiver-identity id))
    (let mark (. pending length))
    (+= pending (call num-cast id (. owner operand) managed-layout pointer-layout))
    (+= pending (call integer .machine-u64 number))
    (call push-key (. key operand) key-type id)
    (if rekeys
      (call push-key next key-type id)
    )
    (+= pending identity)
    (if (call carries-error (call (. facts node-type) (. unit reading) id))
      (= takes-result true)
      (let answer (call call-instance (. used first) id mark))
      (= takes-result false)
      (return answer)
    )
    (do
      (inline (call raising-call id (. used first) mark))
    )
    (return (call Typed nothing (. types void-type)))
  )
  (fn-do _ emit-route Typed
    (param id SyntaxId)
    (param used EventUse)
    (param operands (of RowRange SyntaxId))
    ; A write of a `RoutedEvent`, as the reference publishes one: the object is evaluated, and
    ; where the event is live the payload is made and the event runtime publishes it along its
    ; route of owners, from the object on, whatever listens; one that bubbles is given the object
    ; made the `EventNode` its parents are walked from, where the payload has no route of its own.
    (let nothing (call make-operand .operand-void 0))
    (let owner (call event-owner (. used reference) (. used owner)))
    (let number (call (. tables event-number) (. used owner) (. used name)))
    (if (== number (. U32 max))
      (return (call Typed nothing (. types void-type)))
    )
    (let pointer (call num-cast id (. owner operand) managed-layout pointer-layout))
    (let given ([] (. tree children) (. operands start)))
    (let payload (call convert given .reason-argument (call emit-expression (call (. tree argument-value) given))))
    (call count-event .payload-builds id)
    (let node
      (scope (if-expr (. used bubbles) (. (call convert-from (. used reference) .reason-event-node (. owner operand)) operand) no-node)
        (lazy no-node (call make-operand .operand-void 0))
      )
    )
    (let mark (. pending length))
    (+= pending (call integer .machine-u64 number))
    (+= pending pointer)
    (if (. used bubbles)
      (+= pending node)
    )
    (+= pending (. payload operand))
    (do
      (inline (call call-instance (. used first) id mark))
    )
    (return (call Typed nothing (. types void-type)))
  )
  (fn-expr _ arrives Bool
    (param loop SyntaxId)
    ; Whether a loop on an event hears only the publications its object is the target of.
    (if-expr clause (. clause arrival) false)
    (where
      (lazy clause (call (. facts event-clause-of) (. unit source-module) loop))
    )
  )
  (fn-do _ emit-escape Typed
    (param id SyntaxId)
    (param used EventUse)
    ; An event made a `Broadcastable`: the endpoint the event runtime keeps for the object's event,
    ; or the one at the address of a keyed event, which the receiver claims.
    (let owner (call event-owner (. used reference) (. used owner)))
    (let number (call (. tables event-number) (. used owner) (. used name)))
    (if (== number (. U32 max))
      (call refuse .refused-expression id)
    )
    (if (!= (. used address) 0)
      (let endpoint (call keyed-endpoint id used (. owner operand) number))
      (return (call convert id .reason-argument endpoint))
    )
    (return (call event-endpoint id (. used first) (. owner operand) number))
  )
  (fn-do _ keyed-endpoint Typed
    (param site SyntaxId)
    (param used EventUse)
    (param owner Operand)
    (param number U32)
    ; The endpoint at the address of a keyed event, as the reference claims it for the receiver:
    ; the event runtime's `first` gives it for the object, the event's number, the key and the
    ; receiver's identity, and its errors leave the function at `site`; then a live action of the
    ; receiver holds a `ClosableTracker` of it, made as `claim` says, which closes it with the
    ; receiver.
    (let nothing (call make-operand .operand-void 0))
    (let key (call emit-key (. used address)))
    (let key-type (. key type))
    (let identity (call receiver-identity site))
    (let mark (. pending length))
    (+= pending (call num-cast site owner managed-layout pointer-layout))
    (+= pending (call integer .machine-u64 number))
    (call push-key (. key operand) key-type site)
    (+= pending identity)
    (let endpoint (call raising-call site (. used first) mark))
    (let endpoint-type (. endpoint type))
    (call claim (. used address) (. endpoint operand) endpoint-type)
    (return (call Typed (. endpoint operand) endpoint-type))
  )
  (fn-do _ claim _
    (param address SyntaxId)
    (param endpoint Operand)
    (param endpoint-type TypeId)
    ; The endpoint at the address of a keyed event claimed for the receiver: made a `Closable` at
    ; the node that names the event, and given to the `ClosableTracker` the type pass recorded
    ; there, which is made a `Tracker` there and added to the trackers of a live action of the
    ; receiver, whose callback does nothing.
    (let named SyntaxId 0)
    (match? ([] (. tree nodes) address)
      (case (call .node-index-expression row)
        (= named (. row object))
      )
    )
    (let claimed (call (. facts address-claim-of) (. unit reading) named))
    (if (not claimed)
      (call refuse .refused-statement address)
      (return)
    )
    (let closable (call convert named .reason-argument (call Typed endpoint endpoint-type)))
    (let mark (. pending length))
    (+= pending (. closable operand))
    (let tracker (call call-instance (. claimed closer) named mark))
    (let given (call convert named .reason-argument tracker))
    (let trackers (call open-trackers named))
    (call add-tracker (call load-local trackers named) (. given operand) named)
    (do
      (inline
        (call own-callback (call load-local trackers named) idle (call integer .machine-managed-pointer 0) named
          (block
            (lazy idle (. tables idle-action))
          )
        )
      )
    )
  )
  (fn-do _ emit-key Typed
    (param address SyntaxId)
    ; The key an index addresses a keyed event with, converted to the event's key type as the type
    ; pass recorded at the key.
    (let nothing (call make-operand .operand-void 0))
    (let key SyntaxId 0)
    (match? ([] (. tree nodes) address)
      (case (call .node-index-expression row)
        (= key (. row index))
      )
    )
    (if (== key 0)
      (call refuse .refused-expression address)
      (return (call Typed nothing no-type))
    )
    (return (call convert key .reason-argument (call emit-expression key)))
  )
  (fn-do _ push-key _
    (param key Operand)
    (param type TypeId)
    (param site SyntaxId)
    ; Gives the event runtime a key of a keyed event as the address it names, two `U64`s: an
    ; integer and none, or the index and the generation of a handle.
    (let layout (call layout-of type site))
    (if (call is-integer layout)
      (+= pending (call num-cast site key layout u64-layout))
      (+= pending (call integer .machine-u64 0))
      (return)
    )
    (if (or (not (call (. tables layouts is-struct) layout)) (!= (. ([] (. tables layouts rows) layout) fields count) 2))
      (call refuse .refused-conversion site)
      (return)
    )
    (for (in position (..< 0 2))
      (let field (call (. tables layouts field) layout (as position U32)))
      (if (not (call is-integer (. field layout)))
        (call refuse .refused-conversion site)
        (return)
      )
      (+= pending (call num-cast site (call take key field site) (. field layout) u64-layout))
    )
  )
  (fn-do _ receiver-identity Operand
    (param site SyntaxId)
    ; The identity of the receiver that claims the address of a keyed event: the `uid` its header
    ; holds, as a `U64`. The receiver is the innermost markup element being built, or else the
    ; object `self` names.
    (let inside (!= (. content-hosts length) 0))
    (let receiver (if-expr inside (. ([] content-hosts (- (. content-hosts length) 1)) operand) (. unit self)))
    (let type (if-expr inside (. ([] content-hosts (- (. content-hosts length) 1)) type) (. unit owner-type)))
    (if (or (and (not inside) (not (. unit has-self))) (not (call (. tables is-class) type)) (== ([] (. tables layouts objects) type) no-layout))
      (call refuse .refused-expression site)
      (return (call make-operand .operand-void 0))
    )
    (let uid
      (call load
        (block
          (arg receiver)
          (arg (. (call (. tables layouts field) ([] (. tables layouts objects) type) 1) offset))
          (arg u32-layout)
          (arg site)
        )
      )
    )
    (return (call num-cast site uid u32-layout u64-layout))
  )
  (fn-do _ raising-call Typed
    (param site SyntaxId)
    (param callee InstanceId)
    (param mark Size)
    ; A call of a function of the event or markup runtime, given what is pending since `mark`,
    ; whose errors leave the function with the call, as the type pass noted.
    (let raising (!= (. ([] (. instances signatures) callee) errors count) 0))
    (= takes-result raising)
    (let answer (call call-instance callee site mark))
    (= takes-result false)
    (if raising
      (return (call propagate site callee (. answer operand)))
    )
    (return answer)
  )
  (fn-expr _ escaped-event (? EventUse)
    (param id SyntaxId)
    ; The event a node names that is made a `Broadcastable` there, or none.
    (only-if used (if (and (!= (. facts event-uses length) 0) used (== (. used kind) .event-escape))))
    (where
      (lazy used (call (. tables event-use-of) (. unit reading) id))
    )
  )
  (fn-do _ event-owner Typed (?! Refused)
    (param reference SyntaxId)
    (param owner TypeId)
    ; The object whose event of the class `owner` a node names: the value its name is read from,
    ; or where the name is written alone, the innermost markup element being built whose class has
    ; the event, where the name is read in the element's body, and else the receiver; or that of
    ; the event an index addresses. One read from the class that declares it is a loop's, which
    ; hears it as it bubbles to the loop's object (`bubbling-owner`).
    (match? ([] (. tree nodes) reference)
      (case (call .node-index-expression row)
        (return (call event-owner (. row object) owner))
      )
      (case (call .node-get-expression get)
        (if (== (call (. types intrinsic-of) (call (. facts node-type) (. unit reading) (. get object))) .type-info)
          (return (call bubbling-owner reference))
        )
        (return (call emit-expression (. get object)))
      )
      (case .node-identifier
        (let binding (. ([] (. instances rows) (. unit reading)) binding))
        (if (and (!= binding no-binding) (!= (/and/ resolution-flags (. ResolutionFlag resolution-received)) 0))
          (let position (call received-event owner))
          (if position
            (return ([] content-hosts position))
          )
          (else-if (. unit has-self)
            (return (call Typed (. unit self) (. unit owner-type)))
          )
        )
        (lazy resolution-flags (. (call (. bindings resolution-of) binding reference) flags))
      )
    )
    (call refuse .refused-expression reference)
    (return (call Typed (call make-operand .operand-void 0) no-type))
  )
  (fn-do _ bubbling-owner Typed
    (param reference SyntaxId)
    ; The object a loop that names an event by the class that declares it subscribes on: the
    ; innermost markup element being built, or else the receiver.
    (if (!= (. content-hosts length) 0)
      (return ([] content-hosts (- (. content-hosts length) 1)))
    )
    (if (. unit has-self)
      (return (call Typed (. unit self) (. unit owner-type)))
    )
    (call refuse .refused-expression reference)
    (return (call Typed (call make-operand .operand-void 0) no-type))
  )
  (fn-do _ received-event (? Size)
    (param owner TypeId)
    ; Where the innermost markup element being built whose class declares or inherits an event of
    ; the class or interface `owner` is kept.
    (let position (. content-hosts length))
    (while (!= position 0)
      (-= position 1)
      (let parent (. ([] content-hosts position) type))
      (if (and (== (call intrinsic parent) .class) (call (. types implements-type) parent owner))
        (return position)
      )
    )
    (return null)
  )
  (fn-do _ event-endpoint Typed
    (param site SyntaxId)
    (param callee InstanceId)
    (param owner Operand)
    (param number U32)
    ; The endpoint the event runtime keeps for an object's event, which `callee` gives for the
    ; object and the event's number, made the event's `Broadcastable` as the type pass recorded at
    ; the site.
    (let mark (. pending length))
    (+= pending (call num-cast site owner managed-layout pointer-layout))
    (+= pending (call integer .machine-u64 number))
    (let made (call call-instance callee site mark))
    (return (call convert site .reason-argument made))
  )
  (fn-do _ emit-broadcastable Typed
    (param loop SyntaxId)
    (param container SyntaxId)
    ; The container of a loop or a comprehension on a stream made a `Broadcastable` as the type
    ; pass recorded at the header: given to `publisher`, or cast. It has the header's type.
    (let nothing (call make-operand .operand-void 0))
    (let held (call emit-expression container))
    (let publisher (call own-call loop))
    (let stream (call Typed nothing no-type))
    (if (!= publisher no-fact)
      (let mark (. pending length))
      (+= pending (. (call convert loop .reason-argument held) operand))
      (= stream (call call-instance (. ([] (. facts calls) publisher) callee) loop mark))
      (else
        (= stream (call convert loop .reason-argument held))
      )
    )
    (if (!= (. stream type) (call (. facts node-type) (. unit reading) loop))
      (call refuse .refused-statement loop)
    )
    (return stream)
  )
  (fn-do _ lone-environment LocalId
    (param id SyntaxId)
    (param slot SlotId)
    (param count U32 (= 1))
    ; The environment of a subscriber that the function emitted here does not type, where no
    ; environment of the function that types it is in force: in the value of a global, or in a
    ; section of a class, which a constructor runs. It is one of the layout of the function that
    ; types it, made for this subscriber alone, which holds the channel `slot` names, if any, and
    ; the object being made, where the layout holds it, since every function written there reads
    ; it then, and nothing else; one that holds nothing is given none. The function that tests a
    ; `whenever` clause again is given one so too, which holds the `count` locals from `slot` on
    ; that the clause keeps. A function that captures anything else, or holds the state of a
    ; global `do with` binds, has no shape there.
    (let layout ([] (. tables environments) (. unit reading)))
    (if (or (== layout unbuilt-environment) (call (. tables holds-stacks) (. unit reading)))
      (call refuse .refused-expression id)
      (return no-local)
    )
    (let binding (. ([] (. instances rows) (. unit reading)) binding))
    (let row ([] (. bindings bindings) binding))
    (let home ([] (. tables instance-scopes) (. unit reading)))
    (let alone false)
    (let captures 0u32)
    (for (in offset (..< 0 (. row nested count)))
      (let nested ([] (. bindings nested) (+ (. row nested start) offset)))
      (if (!= (. nested syntax) id)
        (continue)
      )
      (= alone true)
      (= captures (. nested captures count))
      (for (in index (..< 0 (. nested captures count)))
        (let captured (. ([] (. bindings captures) (+ (. nested captures start) index)) slot))
        (if (!= ([] (. tables slot-homes) captured) home)
          (= alone false)
          (else-if (and (== (. ([] (. bindings slots) captured) kind) .slot-this) (. unit has-self))
            (continue)
          )
          (else-if (or (== slot no-slot) (< captured slot) (>= captured (+ slot count)))
            (= alone false)
          )
        )
      )
    )
    (let selves (list SlotId))
    (if (. unit has-self)
      (for (in offset (..< 0 (. row slots count)))
        (let held (+ (. row slots start) offset))
        (let captured (!= (/and/ (. ([] (. bindings slots) held) flags) (. SlotFlag slot-captured)) 0))
        (if (and (== (. ([] (. bindings slots) held) kind) .slot-this) captured (== ([] (. tables slot-homes) held) home))
          (+= selves held)
        )
      )
    )
    (let bare (and (== captures 0) (== (. selves length) 0)))
    (if (or (not alone) (and (== layout no-layout) (not bare)))
      (call refuse .refused-expression id)
      (return no-local)
    )
    (let local (call (. ir add-local) managed-layout))
    (if bare
      (call store-local local (call integer .machine-managed-pointer 0) id)
      (return local)
    )
    (let mark (. pending length))
    (+= pending (call integer .machine-u64 (. ([] (. tables layouts rows) layout) size)))
    (+= pending (call make-operand .operand-descriptor layout))
    (let made (call call-runtime .runtime-allocate-object id mark managed-layout))
    (call store-local local made id)
    (for (in held selves)
      (let field (call lone-field held))
      (if (not (call (. tables is-class) (. field type)))
        (call refuse .refused-expression id)
        (return no-local)
      )
      (call store (call load-local local id) (. field offset) (. unit self) true id)
    )
    (return local)
  )
  (fn-expr _ lone-field LayoutField
    (param slot SlotId)
    ; The field of a local a subscriber captures in its own environment.
    (call (. tables layouts field) ([] (. tables environments) (. unit reading)) (+ 1 ([] (. tables slot-fields) slot)))
  )
  (fn-do _ keep-lone _
    (param lone LocalId)
    (param slot SlotId)
    (param value Operand)
    (param type TypeId)
    (param site SyntaxId)
    ; Stores a local a nested function captures in the environment made for it alone: the
    ; channel of a comprehension on a stream, or what a `whenever` clause keeps.
    (let field (call lone-field slot))
    (if (!= (. field type) type)
      (call refuse .refused-statement site)
      (return)
    )
    (if (call (. tables layouts is-struct) (. field layout))
      (call store-struct (call load-local lone site) field value site)
      (else-if (!= (. field layout) void-layout)
        (call store (call load-local lone site) (. field offset) value (call is-managed-pointer (. field layout)) site)
      )
    )
  )
  (fn-expr _ channel-slot SlotId
    (param id SyntaxId)
    ; The local a node declares that no name reaches: the one a comprehension on a stream keeps
    ; its channel in, which its subscriber captures, or the first of those a `whenever` clause
    ; keeps what it gave, its subscription and its broadcaster in.
    (case? (== binding no-binding)
      no-slot
    )
    (case? (!= (. resolution kind) .resolve-slot)
      no-slot
    )
    (default
      (. resolution slot)
    )
    (where
      (lazy binding (. ([] (. instances rows) (. unit reading)) binding))
      (lazy resolution (call (. bindings resolution-of) binding id))
    )
  )
  (fn-do _ line-keeper SlotId
    (param line SyntaxId)
    ; The local no name reaches that keeps the object of the element a line given again is given
    ; to, declared at the line: an attribute or a line of content. It is found by its name, since a
    ; line of content may be a name its node resolves; the one after it keeps what the element took.
    (let binding (. ([] (. instances rows) (. unit reading)) binding))
    (if (== binding no-binding)
      (return no-slot)
    )
    (return (call (. bindings declared-at) (. ([] (. bindings bindings) binding) slots) line (call (. program store-atom) "(element)")))
  )
  (fn-do _ given-value Operand
    (param at Operand)
    (param type TypeId)
    (param site SyntaxId)
    ; A value of a type that lies at an address another function gave: the address itself where the
    ; value is a struct.
    (let layout (call layout-of type site))
    (return (if-expr (call (. tables layouts is-struct) layout) at (call load at 0 layout site)))
  )
  (fn-do _ read-kept Typed
    (param node SyntaxId)
    (param name String)
    (param site SyntaxId)
    ; What the machine keeps under a name, read from its environment.
    (let slot (call kept-slot node name site))
    (let held (. (call find-captured slot site) type))
    (return (call read-captured slot site held))
  )
  (fn-do _ turn-link Operand
    (param scope ScopeId)
    (param site SyntaxId)
    ; The environment in force around a scope that has turns: that of the turn being emitted of the
    ; nearest scope around it in its function that has turns with an environment, or else the
    ; function's own. One whose turn is not being emitted there has no shape here.
    (let around (. ([] (. bindings scopes) scope) parent))
    (while (not (call (. bindings opens-function) around))
      (if (and (call (. tables is-turn-scope) around) (!= ([] (. tables scope-captures) around) 0))
        (let position (. open-turns length))
        (while (and (!= position 0) (!= (. ([] open-turns (- position 1)) scope) around))
          (-= position 1)
        )
        (if (== position 0)
          (call refuse .refused-statement site)
          (return (call make-operand .operand-void 0))
        )
        (return (call turn-held (. ([] open-turns (- position 1)) local) (. ([] open-turns (- position 1)) place) site))
      )
      (= around (. ([] (. bindings scopes) around) parent))
    )
    (return (call function-environment site))
  )
  (fn-do _ start-case _
    ; Begins the case a root's task main runs in a batch: the runtime is told the case starts, so
    ; that what it prints goes to the batch's files, from the case's own directory.
    (let mark (. pending length))
    (+= pending (call text-constant (. tables batch-control)))
    (+= pending (call text-constant ([] (. tables batch-ids) (. function place))))
    (+= pending (call text-constant ([] (. tables batch-directories) (. function place))))
    (+= pending (call text-constant (. tables batch-output)))
    (+= pending (call text-constant (. tables batch-errors)))
    (call call-runtime .runtime-batch-test-start 0 mark)
  )
  (fn-do _ emit-batch-main _
    ; The task main of a batch: it forks the task main of the root the batch is run from, the one
    ; `BRIXTEST_BATCH_START_INDEX` names, and ends its own task.
    (let first (call call-runtime .runtime-batch-start-index 0 (. pending length) i32-layout))
    (for (in position (..< (. function calls start) (. function calls end)))
      (let forking (call (. ir reserve-block)))
      (let passed (call (. ir reserve-block)))
      (let case (as (- position (. function calls start)) U64))
      (call branch (call compare 0 .compare-equal first (call integer .machine-i32 case)) forking passed)
      (call (. ir start-block) forking)
      (call fork-batch ([] (. tables calls) position) true)
      (call jump passed)
      (call (. ir start-block) passed)
    )
    (call call-runtime .runtime-terminate-active-task 0 (. pending length))
    (call return-nothing)
  )
  (fn-do _ emit-batch-finish _
    ; Ends the case of a batch once every task it started has ended: while another task is active it
    ; forks itself again and ends. Then the runtime is told the case finished, what its probes wrote
    ; is flushed, and what the case left is cleared, so the next case starts as a program of its own
    ; does: each global of the modules its root started has no value, and each constant is zero until
    ; the next case lays its value down again, and what it made is collected and cleaned up. Then the task main of the next root is forked where the batch runs it, and where
    ; it runs no other, the record of probes is closed.
    (let waiting (call (. ir reserve-block)))
    (let finishing (call (. ir reserve-block)))
    (let done (call (. ir reserve-block)))
    (let activity (call call-runtime .runtime-task-queue-activity 0 (. pending length) i32-layout))
    (call branch (call compare 0 .compare-greater activity (call integer .machine-i32 1)) waiting finishing)
    (call (. ir start-block) waiting)
    (call fork-batch ([] (. tables batch-finishes) (. function place)))
    (call jump done)
    (call (. ir start-block) finishing)
    (let mark (. pending length))
    (+= pending (call text-constant (. tables batch-control)))
    (+= pending (call text-constant ([] (. tables batch-ids) (. function place))))
    (call call-runtime .runtime-batch-test-finish 0 mark)
    (if (!= (. tables probe-flush) no-function)
      (call call-function (. tables probe-flush) 0)
    )
    (let first ([] (. program batch-order-starts) (. function place)))
    (let last ([] (. program batch-order-starts) (+ (. function place) 1)))
    (for (in position (..< first last))
      (let module (as ([] (. program batch-order-modules) position) ModuleId))
      (for (in decl (..< 0 (. ([] (. program modules) module) decls length)))
        (let row (call (. tables storage-of) module (as decl DeclId)))
        (if (== row no-storage)
          (continue)
        )
        (let kept ([] (. tables storage) row))
        (if (!= (. kept state) no-string)
          (call zero (call make-operand .operand-symbol (. kept symbol)) (. kept layout))
          (call store (call make-operand .operand-symbol (. kept state)) 0 (call integer .machine-u8 0) false 0)
          (else-if (== (call (. tables global-kind) module (as decl DeclId)) .global-constant)
            (call zero (call make-operand .operand-symbol (. kept symbol)) (. kept layout))
          )
        )
      )
    )
    (call call-runtime .runtime-collect 0 (. pending length) u64-layout true)
    (call call-runtime .runtime-drain-cleanups 0 (. pending length) u64-layout true)
    (let closing (call (. ir reserve-block)))
    (if (!= (. function calls count) 0)
      (let end (call call-runtime .runtime-batch-end-index 0 (. pending length) i32-layout))
      (let forking (call (. ir reserve-block)))
      (let next (call integer .machine-i32 (+ (. function place) 1)))
      (call branch (call compare 0 .compare-less next end) forking closing)
      (call (. ir start-block) forking)
      (call fork-batch ([] (. tables calls) (. function calls start)) true)
      (call jump done)
      (else
        (call jump closing)
      )
    )
    (call (. ir start-block) closing)
    (if (!= (. tables probe-teardown) no-function)
      (call call-function (. tables probe-teardown) 0)
    )
    (call jump done)
    (call (. ir start-block) done)
    (call call-runtime .runtime-terminate-active-task 0 (. pending length))
    (call return-nothing)
  )
  (fn-do _ set-up-batch-probes _
    ; Declares the probes of a batch where the case the batch is run from starts, the one
    ; `BRIXTEST_BATCH_START_INDEX` names, as the reference does: every case after it writes to the
    ; record of probes that case opened.
    (let first (call call-runtime .runtime-batch-start-index 0 (. pending length) i32-layout))
    (let setting (call (. ir reserve-block)))
    (let passed (call (. ir reserve-block)))
    (call branch (call compare 0 .compare-equal first (call integer .machine-i32 (. function place))) setting passed)
    (call (. ir start-block) setting)
    (call call-function (. tables probe-setup) 0)
    (call jump passed)
    (call (. ir start-block) passed)
  )
  (fn-do _ fork-batch _
    (param task FunctionId)
    (param main Bool (= false))
    ; Forks a task that runs a function of a batch, which is given nothing. The task is forked as
    ; native code forks one, so that a panic it reports names no task that spawned it; the `main` task
    ; of a case has the stack the first task of a program has.
    (call (. ir depend) .callee-function task 0)
    (let mark (. pending length))
    (+= pending (call make-operand .operand-symbol (. ([] (. tables functions) task) symbol)))
    (+= pending (call integer .machine-u64 0))
    (+= pending (call integer .machine-u64 (as (. tables task-local-size) U64)))
    (call call-runtime
      (block
        (arg (if-expr main .runtime-fork-main-task .runtime-fork-plain-task))
        (arg 0)
        (arg mark)
        (arg void-layout)
      )
    )
  )
  (fn-do _ text-constant Operand
    (param text String)
    ; A literal of text, whose address is that of its bytes, which a zero byte follows.
    (return (call make-operand .operand-constant (call (. ir add-string) text)))
  )
  (fn-do _ keep-state _
    (param slot SlotId)
    (param value Operand)
    (param type TypeId)
    (param site SyntaxId)
    ; Stores what a loop keeps from one pass to the next in a slot the binder declared for its
    ; header, which the type pass typed: in a cell made where the loop first stores it, or in
    ; the environment of a function that yields.
    (let offset (call slot-offset slot site))
    (if (or (== slot no-slot) (!= (call (. facts slot-type) (. unit instance) offset) type) (== type no-type))
      (call refuse .refused-statement site)
      (return)
    )
    (let layout (call layout-of type site))
    (if (== layout void-layout)
      (return)
    )
    (if (call is-captured slot)
      (call keep-captured slot value type site)
      (return)
    )
    (if (== ([] (. unit cells) offset) no-local)
      (= ([] (. unit cells) offset) (call (. ir add-local) layout))
    )
    (call store-local ([] (. unit cells) offset) value site)
  )
  (fn-do _ state Typed
    (param slot SlotId)
    (param site SyntaxId)
    ; What a loop keeps in one of its slots, of the type the type pass gave the slot. One that
    ; holds nothing has no cell.
    (let nothing (call make-operand .operand-void 0))
    (let offset (call slot-offset slot site))
    (let type (call (. facts slot-type) (. unit instance) offset))
    (if (call is-captured slot)
      (let held (call read-captured slot site type))
      (return (call Typed (. held operand) type))
    )
    (if (== ([] (. unit cells) offset) no-local)
      (if (!= (call layout-of type site) void-layout)
        (call refuse .refused-expression site)
      )
      (return (call Typed nothing type))
    )
    (return (call Typed (call load-local ([] (. unit cells) offset) site) type))
  )
  (fn-do _ keep-given _
    (param declared SyntaxId)
    ; What the function generated for a comprehension does with the container it is given,
    ; its one argument after the environment it was written in: it keeps it in the first slot
    ; of the loop, converted as the type pass recorded for the loop's container, where the
    ; body of the generator finds it, or, for a loop over the rows of a table, in the slot after
    ; its item, where the loop finds its rows when it begins. That of a stream piped through a
    ; pattern keeps the value piped so, but for a feed the pipe reads alone, which it is given
    ; nothing for.
    (if (!= given-pipe 0)
      (if (!= (call (. tree piped-feed) given-pipe) 0)
        (if (!= (. ([] (. instances signatures) (. unit instance)) args count) 0)
          (call refuse .refused-function declared)
        )
        (return)
      )
      (let slot (call loop-slots given-pipe))
      (if (or (!= (. ([] (. instances signatures) (. unit instance)) args count) 1) (!= (. ir arguments length) 2))
        (call refuse .refused-function declared)
        (return)
      )
      (call keep-state
        (block
          (arg slot)
          (arg (call make-operand .operand-argument 1))
          (arg (call (. instances argument-type) (. unit instance) 0))
          (arg given-pipe)
        )
      )
      (return)
    )
    (match? ([] (. tree nodes) given-loop)
      (case (call .node-loop-syntax row)
        (let slot (call loop-slots given-loop))
        (if (or (!= (. ([] (. instances signatures) (. unit instance)) args count) 1) (!= (. ir arguments length) 2))
          (call refuse .refused-function declared)
          (return)
        )
        (let held
          (call convert
            (block
              (arg (. row container))
              (arg .reason-operand)
              (arg (call Typed (call make-operand .operand-argument 1) (call (. instances argument-type) (. unit instance) 0)))
            )
          )
        )
        (let kept
          (block
            (case? (== (call (. facts plan-of) (. unit reading) given-loop) .plan-table-loop)
              (+ slot loop-state-count)
            )
            (default
              slot
            )
          )
        )
        (call keep-state kept (. held operand) (. held type) given-loop)
        (return)
      )
    )
    (call refuse .refused-function declared)
  )
  (fn-do _ built-value Typed
    (param site SyntaxId)
    (param value Typed)
    (let converted value)
    (if (== built-reason .reason-element)
      (= converted (call convert-matched site .reason-explicit converted built-item))
    )
    (return (call convert-matched site built-reason converted built-item))
  )
  (fn-do _ append-built _
    (param site SyntaxId)
    (param given-value Typed)
    (param optional Bool)
    (let staying no-block)
    (let value given-value)
    (if (and optional (call (. types is-optional) (. value type)))
      (let held (. value type))
      (let tested (call present site value))
      (let given-block (call (. ir reserve-block)))
      (= staying (call (. ir reserve-block)))
      (call branch (. tested operand) given-block staying)
      (call (. ir start-block) given-block)
      (= value (call payload site (call Typed (. value operand) held)))
    )
    (= value (call built-value site value))
    (if (!= (. value type) built-item)
      (call refuse .refused-conversion site)
      (return)
    )
    (let mark (. pending length))
    (+= pending built-list)
    (+= pending (. value operand))
    (call call-method built-append site mark)
    (if (!= staying no-block)
      (call jump staying)
      (call (. ir start-block) staying)
    )
  )
  (fn-do _ turn-held Operand
    (param local LocalId)
    (param place U32)
    (param site SyntaxId)
    ; The environment of a turn of a loop being emitted: what the local for it holds, or in a
    ; function that yields what the field for it of the function's own environment holds.
    (if (!= local no-local)
      (return (call load-local local site))
    )
    (let field (call (. tables layouts field) ([] (. tables environments) (. unit instance)) place))
    (return (call load (call load-local (. unit environment) site) (. field offset) managed-layout site))
  )
  (fn-expr _ is-turned Bool
    (param slot SlotId)
    ; Whether a slot is kept in the environment of a turn of a loop or of an activation.
    (and (!= ([] (. tables slot-homes) slot) no-scope) (call (. tables is-turn-scope) ([] (. tables slot-homes) slot)))
  )
  (fn-do _ written-environment Operand
    (param id SyntaxId)
    ; The environment in force where a nested function is written, which its body reads the
    ; locals it captures from: that of the innermost turn being emitted, where an activation with
    ; none of its own has the one around it (`turn-link`), or else the function's own, or else the
    ; one the function was given, or nothing where it has none. A nested function written at the
    ; node is made here, so the lazy locals it reads that are held as eager locals are given their
    ; values first (`force-captured`).
    (call force-captured id)
    (let top (. open-turns length))
    (if (and (!= top 0) (== (. ([] open-turns (- top 1)) local) no-local) (== (. ([] open-turns (- top 1)) place) no-place))
      (return (call turn-link (. ([] open-turns (- top 1)) scope) id))
    )
    (if (!= top 0)
      (return (call turn-held (. ([] open-turns (- top 1)) local) (. ([] open-turns (- top 1)) place) id))
    )
    (return (call function-environment id))
  )
  (fn-do _ function-environment Operand
    (param id SyntaxId)
    ; The environment of the function being emitted where a nested function is written outside any
    ; turn: its own, or else the one it was given, or nothing where it has none.
    (if (!= (. unit environment) no-local)
      (return (call load-local (. unit environment) id))
    )
    (if (and (!= (. unit own-scope) no-scope) (!= ([] (. tables environments) (. unit instance)) no-layout))
      (call refuse .refused-expression id)
    )
    (if (. unit received)
      (return (call given-environment id))
    )
    (return (call integer .machine-managed-pointer 0))
  )
  (fn-do _ call-protocol Typed
    (param site SyntaxId)
    (param fact FactId)
    (param receiver Operand)
    (param type TypeId)
    (param argument Operand)
    (param given TypeId (= no-type))
    (param watched Bool (= true))
    (param second (? Operand) (= null))
    (param second-given TypeId (= no-type))
    (param third (? Operand) (= null))
    (param third-given TypeId (= no-type))
    ; A call the type pass recorded at a loop for its container, at a pattern for its subject, or for a
    ; helper a pattern is given, which no call in the source writes: of a function declared for the
    ; container's type or for a class it is derived from, with the container as it is and up to three
    ; arguments, each of the type the function takes or of another that is held the same. A call that
    ; would convert any has no shape here. A function some class declares again is chosen by the class
    ; of the object, as a call written in source is. An error the function raises is a panic at the
    ; loop, with the error's text as its message, but where the type pass says the call's errors leave
    ; the function with it, as a loop's read of a generator that raises does. A loop's call is
    ; `watched`, checked for a panic even where no other call of the function is: the reference notices
    ; a panic raised under a loop's read as the loop ends. A function a property the container
    ; delegates to answers is called with what the property holds.
    (let nothing (call make-operand .operand-void 0))
    (if (or (== fact no-fact) (== (. ([] (. facts calls) fact) callee) no-instance) uncallable)
      (call refuse .refused-statement site)
      (return (call Typed nothing no-type))
    )
    (lazy uncallable (not (call is-callable (. ([] (. facts calls) fact) callee))))
    (let callee (. ([] (. facts calls) fact) callee))
    (let declared (. ([] (. instances rows) callee) self-type))
    (let signature ([] (. instances signatures) callee))
    (let object receiver)
    (let holder type)
    (if (!= (. ([] (. facts calls) fact) through count) 0)
      (let reached (call read-through site (call Typed receiver type) (. ([] (. facts calls) fact) through)))
      (= object (. reached operand))
      (= holder (. reached type))
    )
    (let derived (and (call (. tables is-class) holder) (call (. tables is-class) declared) (call (. tables derives) holder declared)))
    (let count U32
      (block
        (case? (== given no-type)
          0
        )
        (case? (== second-given no-type)
          1
        )
        (case? (== third-given no-type)
          2
        )
        (default
          3
        )
      )
    )
    (if (or (and (!= declared holder) (not derived)) (!= (. signature args count) count))
      (call refuse .refused-statement site)
      (return (call Typed nothing no-type))
    )
    (if (and (!= given no-type) (!= (call layout-of (call (. instances argument-type) callee 0) site) (call layout-of given site)))
      (call refuse .refused-statement site)
    )
    (if (and (!= second-given no-type) (!= (call layout-of second-type site) (call layout-of second-given site)))
      (call refuse .refused-statement site)
    )
    (lazy second-type (call (. instances argument-type) callee 1))
    (if (and (!= third-given no-type) (!= (call layout-of third-type site) (call layout-of third-given site)))
      (call refuse .refused-statement site)
    )
    (lazy third-type (call (. instances argument-type) callee 2))
    (let raising (!= (. signature errors count) 0))
    (let mark (. pending length))
    (+= pending object)
    (if (!= given no-type)
      (+= pending argument)
    )
    (if (!= second-given no-type)
      (+= pending (!! second))
    )
    (if (!= third-given no-type)
      (+= pending (!! third))
    )
    (= takes-result raising)
    (let answer (call Typed nothing no-type))
    (let start ValueId (as (. ir instructions length) ValueId))
    (let called ValueId (. U32 max))
    (if (and (call (. tables is-class) holder) (call (. tables is-overridden) callee))
      (= answer (call call-method callee site mark))
      (else
        (= answer (call call-instance callee site mark false watched))
        (= called (call last-call start))
      )
    )
    (if (and raising (. ([] (. facts calls) fact) propagates))
      (= answer (call propagate site callee (. answer operand)))
      (else-if raising
        (= answer (call panic-on-error site callee (. answer operand)))
      )
    )
    (= protocol-row called)
    (return answer)
  )
  (fn-do _ last-call ValueId
    (param start ValueId)
    (let count (. ir instructions length))
    (for (in back (..< 0 (- count start)))
      (let op (. ([] (. ir instructions) (- count 1 back)) op))
      (if (or (== op .op-call) (== op .op-call-void))
        (return (as (- count 1 back) ValueId))
      )
    )
    (return (. U32 max))
  )
  (fn-do _ proven-item U32
    (param syntax SyntaxId)
    (if (== (. proven-items length) 0)
      (return (. U32 max))
    )
    (let binding (. ([] (. instances rows) (. unit reading)) binding))
    (if (or (== binding no-binding) (!= (. unit reading) (. unit instance)))
      (return (. U32 max))
    )
    (match? ([] (. tree nodes) syntax)
      (case .node-identifier
        (let resolution (call (. bindings resolution-of) binding syntax))
        (if (!= (. resolution kind) .resolve-slot)
          (return (. U32 max))
        )
        (let position (. proven-items length))
        (while (!= position 0)
          (-= position 1)
          (if (== (. ([] proven-items position) slot) (. resolution slot))
            (return (as position U32))
          )
        )
      )
    )
    (return (. U32 max))
  )
  (fn-do _ proven-loop U32
    (param loop SyntaxId)
    (let position (. proven-tables length))
    (while (!= position 0)
      (-= position 1)
      (if (== (. ([] proven-tables position) loop) loop)
        (return (as position U32))
      )
    )
    (return (. U32 max))
  )
  (fn-do _ proven-read U32
    (param loop SyntaxId)
    (param column U32)
    (for (in position (..< 0 (. proven-reads length)))
      (let held ([] proven-reads position))
      (if (and (== (. held loop) loop) (== (. held column) column) (== (. held block) (. ir current)))
        (return (as position U32))
      )
    )
    (return (. U32 max))
  )
  (fn-do _ emit-leave _
    (param site SyntaxId)
    (param is-break Bool)
    ; Leaves the innermost loop, or goes on to its next pass, after the cleanups opened in the
    ; loop run. What follows is never run. In a cleanup being run, only the holds on cancellation
    ; taken in the loop are let go (`leave-held`), and leaving anything else opened there has no
    ; shape.
    (if (== (. loops length) 0)
      (call refuse .refused-statement site)
      (return)
    )
    (let loop ([] loops (- (. loops length) 1)))
    (if (and (. scoping cleaning) (!= (. loop cleanups) (. open-cleanups length)))
      (if (not (call leave-held (. loop cleanups) site))
        (call refuse .refused-statement site)
        (return)
      )
      (else
        (call run-cleanups (. loop cleanups) (. open-cleanups length))
      )
    )
    (call jump (if-expr is-break (. loop done) (. loop step)))
    (call (. ir start-block) (call (. ir reserve-block)))
  )
  (fn-do _ open-polls _
    ; The cells a function's loops poll with: the budget, which runs out on the first pass, and where
    ; the loops look in on the probes, the count down to the next look.
    (= budget (call (. ir add-local) u64-layout))
    (call store-local budget (call integer .machine-u64 1) 0)
    (if (and (. tables probe-loops) (not (call is-unprobed)))
      (= probe-countdown (call (. ir add-local) u64-layout))
      (call store-local probe-countdown (call integer .machine-u64 0) 0)
    )
  )
  (fn-do _ look-in-on-probes _
    (param syntax SyntaxId)
    ; The look a loop's poll takes in on the probes, where the count down has run out: it is given its
    ; period again, and the probes flush what is due and answer the controller. A loop in a `do` block
    ; kept from looking in on them never does.
    (if (or (== probe-countdown no-local) (call is-unprobed))
      (return)
    )
    (let left (call load-local probe-countdown syntax))
    (let looking (call (. ir reserve-block)))
    (let looked (call (. ir reserve-block)))
    (call branch left looked looking)
    (call (. ir start-block) looking)
    (call store-local probe-countdown (call integer .machine-u64 probe-look-period) syntax)
    (call call-probe-thunk (. tables probe-safepoint) syntax)
    (call jump looked)
    (call (. ir start-block) looked)
    (let one (call integer .machine-u64 1))
    (call store-local
      (block
        (arg probe-countdown)
        (arg (call arithmetic syntax .arithmetic-subtract (call load-local probe-countdown syntax) one u64-layout))
        (arg syntax)
      )
    )
  )
  (fn-do _ call-probe-thunk _
    (param callee FunctionId)
    (param site SyntaxId)
    ; A call of the function that flushes what a thread's probes wrote or of the one that looks in on
    ; them, where either is made. Neither returns a panic.
    (if (== callee no-function)
      (return)
    )
    (call (. ir depend) .callee-function callee 0)
    (call call
      (block
        (arg (call make-operand .operand-symbol (. ([] (. tables functions) callee) symbol)))
        (arg site)
        (arg (. pending length))
        (arg .callee-function)
        (arg void-layout)
      )
    )
  )
  (fn-expr _ is-unprobed Bool
    ; Whether the loops of the code emitted and the calls it makes that suspend the task never look in
    ; on the probes, by what its function declares or a `do` block around it is kept from.
    (!= (/and/ (call effects-here) (. CompilationEffect no-probe-safepoint)) 0)
  )
  (fn-expr _ effects-here U32
    ; What the code emitted may not do: what its function declares, and what the `do` blocks around
    ; it are kept from.
    (/or/ declared block-effects)
    (where
      (lazy declared
        (match (. unit instance)
          (case= no-instance
            0u32
          )
          (default
            (call restrictions-of (call dispatch-effects (. ([] (. instances rows) (. unit instance)) effects)))
          )
        )
      )
    )
  )
  (fn-do _ emit-poll _
    (param syntax SyntaxId)
    ; The poll a loop makes on each pass. The budget counts the passes down. Where it runs out it is
    ; given a period again, the loop looks in on the probes (`look-in-on-probes`), and the task is
    ; looked at. When the collector or the scheduler has asked something of it, it leaves through the
    ; landing pad with the termination panic when it is being terminated in a function that
    ; `raises-termination`, and otherwise stops at the task's safepoint, or at the collector's in a
    ; function that may not suspend. A loop where no safepoint is allowed polls nothing. A loop in any
    ; other function the type pass did not mark as one that polls has no shape.
    (if (and (call is-unpolled) (== (. unit lender) no-instance))
      (return)
    )
    (if (or (== budget no-local) (!= (. unit lender) no-instance))
      (call refuse .refused-statement syntax)
      (return)
    )
    (let one (call integer .machine-u64 1))
    (let left (call arithmetic syntax .arithmetic-subtract (call load-local budget syntax) one u64-layout))
    (call store-local budget left syntax)
    (let polling (call (. ir reserve-block)))
    (let dispatch (call (. ir reserve-block)))
    (let stop (call (. ir reserve-block)))
    (let resume (call (. ir reserve-block)))
    (call branch left resume polling)
    (blank)
    (call (. ir start-block) polling)
    (call store-local budget (call integer .machine-u64 poll-period) syntax)
    (call look-in-on-probes syntax)
    (let flags-address (call make-operand .operand-symbol (call (. tables runtime-symbol) .runtime-interrupt-flags)))
    (let control-address (call make-operand .operand-symbol (. tables bundle gc-public-control-word-symbol)))
    (let flags (call load flags-address 0 u8-layout syntax))
    (let control (call load control-address 0 u8-layout syntax))
    (let asked (call integer .machine-u8 handshake-requested-control))
    (let collecting (call bitwise syntax .bitwise-and control asked u8-layout))
    (call branch (call bitwise syntax .bitwise-or flags collecting u8-layout) dispatch resume)
    (blank)
    (call (. ir start-block) dispatch)
    (if (call raises-termination)
      (call check-termination (call load flags-address 0 u8-layout syntax) syntax stop)
      (else
        (call jump stop)
      )
    )
    (blank)
    (call (. ir start-block) stop)
    (let suspends (== (/and/ (call effects-here) (. CompilationEffect no-suspend)) 0))
    (call call-runtime
      (block
        (arg (if-expr suspends .runtime-task-safepoint .runtime-safepoint))
        (arg syntax)
        (arg (. pending length))
      )
    )
    (call jump resume)
    (call (. ir start-block) resume)
  )
  (fn-do _ check-termination _
    (param flags Operand)
    (param syntax SyntaxId)
    (param resume IRBlockId)
    ; Leaves through the landing pad with the termination panic when the interrupt flags say the
    ; task is being terminated, and goes on at `resume` when they do not.
    (let requested
      (call bitwise
        (block
          (arg syntax)
          (arg .bitwise-and)
          (arg flags)
          (arg (call integer .machine-u8 terminate-interrupt))
          (arg u8-layout)
        )
      )
    )
    (let check (call (. ir reserve-block)))
    (call branch requested check resume)
    (call (. ir start-block) check)
    (let raised (call call-instance (. instances report termination) syntax (. pending length)))
    (+= poll-landings 1)
    (call branch (. raised operand) (call landing-block syntax) resume)
  )
  (fn-do _ test Typed
    (param site SyntaxId)
    (param value Typed)
    (param is-operand Bool (= false))
    (param is-right Bool (= false))
    ; Whether a value tests as true as a condition. One of a class or a text is asked whether it
    ; is empty, by the call the type pass recorded at the site as the test, and is true when it
    ; is not. Any other is tested by its layout. The value is the site's own, or with
    ; `is-operand` an operand of the site: the left one, or with `is-right` the right one.
    (let nothing (call make-operand .operand-void 0))
    (let fact (call truth-call site is-operand is-right))
    (if (== fact no-fact)
      (return (call truth site value))
    )
    (let row ([] (. facts calls) fact))
    (if (. row is-partial)
      (call refuse .refused-expression site)
      (return (call Typed nothing no-type))
    )
    (return (call ask-empty site value (. row callee)))
  )
  (fn-do _ ask-empty Typed
    (param site SyntaxId)
    (param value Typed)
    (param callee InstanceId)
    ; Whether a value of a class or a text is not empty, by the function that says it is.
    (let nothing (call make-operand .operand-void 0))
    (if (or (== callee no-instance) (not (call is-callable callee)))
      (call refuse .refused-expression site)
      (return (call Typed nothing no-type))
    )
    (if (or (!= (. ([] (. instances signatures) callee) args count) 0) (!= (. value type) (. ([] (. instances rows) callee) self-type)))
      (call refuse .refused-conversion site)
      (return (call Typed nothing no-type))
    )
    (let mark (. pending length))
    (+= pending (. value operand))
    (let empty (call call-method callee site mark))
    (if (!= (. empty type) (. types bool-type))
      (call refuse .refused-expression site)
      (return (call Typed nothing no-type))
    )
    (return (call compare-zero site empty .compare-equal))
  )
  (fn-do _ truth-call FactId
    (param site SyntaxId)
    (param is-operand Bool)
    (param is-right Bool)
    ; The call the type pass recorded at a site as the test of a value as a condition: of the
    ; site's own value, or of its left or right operand. No fact when the value has no such test.
    (let form (if-expr is-operand (. CallForm call-operand-truth) (. CallForm call-truth)))
    (let fact (call (. facts first-call) (. unit reading) site))
    (while (!= fact no-fact)
      (let row ([] (. facts calls) fact))
      (if (and (== (. row form) form) (== (. row is-swapped) is-right))
        (return fact)
      )
      (= fact (. row next))
    )
    (return no-fact)
  )
  (fn-expr _ is-function-call Bool
    (param id SyntaxId)
    ; Whether the call a node makes for its own value is of a function by its name: an operator
    ; that a function of its name answers, with both operands as its arguments.
    (and (!= fact no-fact) (== (. ([] (. facts calls) fact) form) .call-function))
    (where
      (lazy fact (call own-call id))
    )
  )
  (fn-expr _ own-call FactId
    (param id SyntaxId)
    ; The call a node makes for its own value, as the instance being read records it.
    (call call-in (. unit reading) id)
  )
  (fn-do _ call-in FactId
    (param owner InstanceId)
    (param id SyntaxId)
    ; The call a node makes for its own value, as an instance records it: the one recorded at it
    ; that is not the test of a value as a condition. No fact when there is none, or more than one.
    (let found no-fact)
    (let fact (call (. facts first-call) owner id))
    (while (!= fact no-fact)
      (let row ([] (. facts calls) fact))
      (if (call answers-node (. row form))
        (if (!= found no-fact)
          (return no-fact)
        )
        (= found fact)
      )
      (= fact (. row next))
    )
    (return found)
  )
  (fn-do _ emit-print _
    (param id SyntaxId)
    (param body SyntaxId)
    ; Prints a value as text, by the conversion the print records. The items of a tuple written
    ; are all evaluated first, and then made text one by one and joined as a tuple is. `--? value`
    ; prints only where the optional written holds a value.
    (let value (call Typed (call make-operand .operand-void 0) no-type))
    (let skipped (call (. ir reserve-block)))
    (let is-written false)
    (match? ([] (. tree nodes) body)
      (case .node-tuple-syntax
        (= is-written true)
      )
    )
    (if is-written
      (let start (. given length))
      (call gather-printed body)
      (= print-fact (call (. facts first-conversion) (. unit reading) id))
      (= print-next start)
      (= value (call Typed (call printed-text id body) (. types string-type)))
      (call drop-given start)
      (else
        (= held-chain body)
        (let emitted (call emit-expression body))
        (= held-chain 0)
        (if (and (call (. tree is-chained) body) (call (. types is-optional) (. emitted type)))
          (let tested (call present body emitted))
          (let printing (call (. ir reserve-block)))
          (call branch (. tested operand) printing skipped)
          (call (. ir start-block) printing)
        )
        (= value (call convert id .reason-print emitted))
      )
    )
    (if (!= (. value type) (. types string-type))
      (call refuse .refused-print-conversion id)
      (return)
    )
    (let door (call call-at id .call-print))
    (if (== door no-fact)
      (call refuse .refused-expression id)
      (return)
    )
    (let mark (. pending length))
    (+= pending (. value operand))
    (call call-instance (. ([] (. facts calls) door) callee) id mark)
    (call jump skipped)
    (call (. ir start-block) skipped)
  )
  (fn-do _ gather-printed _ (?! Refused)
    (param body SyntaxId)
    ; Evaluates the items of a tuple written to be printed, and those of the tuples written
    ; inside it, in order. A struct that an item names is copied, so no later item changes it.
    (match? ([] (. tree nodes) body)
      (case (call .node-tuple-syntax row)
        (for (in item ([] (. tree children) (. row items)))
          (call gather-printed item)
        )
        (return)
      )
    )
    (let value (call emit-expression body))
    (let layout (call layout-of (. value type) body))
    (if (and (call (. tables layouts is-struct) layout) (not (call is-answer (. value operand))))
      (= value (call Typed (call snapshot (. value operand) layout body) (. value type)))
    )
    (+= given value)
  )
  (fn-do _ printed-text Operand (?! Refused)
    (param id SyntaxId)
    (param body SyntaxId)
    ; The text of what `gather-printed` evaluated. An item that is not text takes the next
    ; conversion the print records.
    (match? ([] (. tree nodes) body)
      (case (call .node-tuple-syntax row)
        (let text (call make-operand .operand-constant (call (. ir add-string) "(")))
        (let position U32)
        (for (in item ([] (. tree children) (. row items)))
          (let piece (call printed-text id item))
          (if (!= position 0)
            (= text (call concat id text (call make-operand .operand-constant (call (. ir add-string) ", "))))
          )
          (= text (call concat id text piece))
          (+= position 1)
        )
        (return (call concat id text (call make-operand .operand-constant (call (. ir add-string) ")"))))
      )
    )
    (let value ([] given print-next))
    (+= print-next 1)
    (if (== (. value type) (. types string-type))
      (return (. value operand))
    )
    (while (and (!= print-fact no-fact) (!= (. ([] (. facts conversions) print-fact) reason) .reason-print))
      (= print-fact (. ([] (. facts conversions) print-fact) next))
    )
    (if (== print-fact no-fact)
      (call refuse .refused-print-conversion id)
      (return (. value operand))
    )
    (let row ([] (. facts conversions) print-fact))
    (= print-fact (. row next))
    (return (. (call convert-one id row value) operand))
  )
  (fn-expr _ compiles-probe Bool
    (param id SyntaxId)
    (call (. program compiles-probe) (. unit source-module) (call probe-decl) id)
  )
  (fn-expr _ probe-decl DeclId
    ; The function whose probes compile as its own (see `Program.compiles-probe`): that of the
    ; instance read, where it is written in the module whose syntax is emitted.
    (if-expr (and (!= (. unit reading) no-instance) (== (. ([] (. instances rows) (. unit reading)) module) (. unit source-module))) (. ([] (. instances rows) (. unit reading)) decl) 0)
  )
  (fn-do _ emit-probe-statement _
    (param id SyntaxId)
    ; A probe that compiles: a log or an event (`emit-probe`), the assignment of a property, a counter,
    ; a group, the lazy locals a probe reads with it, which are evaluated where it reads them, or the
    ; statement a probe runs.
    (match? ([] (. tree nodes) id)
      (case (call .node-probe row)
        (let skip (call open-probe-gate id))
        (call emit-probe id row)
        (call close-probe-gate skip)
        (return)
      )
      (case (call .node-probe-assign row)
        (let skip (call open-probe-gate id))
        (call emit-probe-assign id row)
        (call close-probe-gate skip)
        (return)
      )
      (case (call .node-probe-counter row)
        (let skip (call open-probe-gate id))
        (call emit-probe-counter id row)
        (call close-probe-gate skip)
        (return)
      )
      (case (call .node-probe-group row)
        (call emit-probe-group id row)
        (return)
      )
      (case (call .node-probe-scope row)
        (let mark (. open-cleanups length))
        (for (in statement ([] (. tree children) (. row body)))
          (call emit-statement statement)
        )
        (call close-cleanups mark)
        (return)
      )
      (case (call .node-probe-statement row)
        (call emit-block (. row body))
        (return)
      )
    )
    (call refuse .refused-probe id)
  )
  (fn-do _ open-probe-gate IRBlockId
    (param site SyntaxId)
    (let tracing
      (call load
        (block
          (arg (call make-operand .operand-symbol (call (. tables runtime-symbol) .runtime-probe-tracing)))
          (arg 0)
          (arg u8-layout)
          (arg site)
        )
      )
    )
    (let records (call (. ir reserve-block)))
    (let skip (call (. ir reserve-block)))
    (call branch tracing records skip)
    (call (. ir start-block) records)
    (return skip)
  )
  (fn-do _ close-probe-gate _
    (param skip IRBlockId)
    (call jump skip)
    (call (. ir start-block) skip)
  )
  (fn-do _ emit-probe _
    (param id SyntaxId)
    (param row ASTProbe)
    ; A log or an event whose probe compiles writes its record through the calls of the probes module
    ; the type pass recorded at it (`emit-probe-record`). The object it is written of, where it has one,
    ; and each value written in it are evaluated first, in order, then each value is cast, so that a
    ; probe a value runs writes its own record before this one starts, as the reference compiles them.
    (let number (call (. tables probe-number) (. unit reading) id))
    (if (== number 0)
      (call refuse .refused-probe id)
      (return)
    )
    (let made (call probe-calls id))
    (let logs (== (. row name) null))
    (let start (. given length))
    (let snapshots (list Bool))
    (call gather-probe-object (. row object))
    (let values (. given length))
    (call gather-probe-values (. row content) logs snapshots)
    (call cast-probe-values (. row content) logs values)
    (let head (. pending length))
    (+= pending (call integer .machine-u16 number))
    (call push-probe-object (. row object) start)
    (call emit-probe-record id made 0 head values snapshots)
    (call drop-given start)
  )
  (fn-do _ emit-probe-counter _
    (param id SyntaxId)
    (param row ASTProbeCounter)
    ; A counter adds to the count the probes module keeps under its number, of the object it is written
    ; of where it has one: by one, or by what it is given, converted as the type pass recorded. One
    ; that compiles only as a metric of the profile adds to the metric of its number instead.
    (let number (call (. tables probe-number) (. unit reading) id))
    (let made (call probe-calls id))
    (if (or (== number 0) (!= (. made length) 1))
      (call refuse .refused-probe id)
      (return)
    )
    (let start (. given length))
    (call gather-probe-object (. row object))
    (let delta (call integer .machine-u64 1))
    (if (!= (. row delta) 0)
      (let emitted (call emit-expression (. row delta)))
      (= delta (. emitted operand))
      (= delta (. (call convert (. row delta) .reason-argument (call Typed delta (. emitted type))) operand))
    )
    (let mark (. pending length))
    (+= pending (call integer .machine-u16 number))
    (call push-probe-object (. row object) start)
    (+= pending delta)
    (if (== (. ([] (. facts calls) ([] made 0)) form) .call-probe-metric)
      (call call-runtime .runtime-profile-counter-add id mark)
      (else
        (call call-probe-function (. ([] (. facts calls) ([] made 0)) callee) id mark)
      )
    )
    (call drop-given start)
  )
  (fn-do _ emit-probe-group _
    (param id SyntaxId)
    (param row ASTProbeGroup)
    ; A group writes the record that opens it, with its values, and the one that closes it, each through
    ; the calls the type pass recorded at it, in order. One that begins and ends closes where the block
    ; it is written in is left, by any way out, as a cleanup (`emit-probe-group-end`), which has no shape
    ; where `do finally` has none. One written as a log that only ends writes its values in a log of
    ; their own before it closes. A group of data is of the object it is written of where it has one.
    ; One that compiles only as a timer of the profile begins or ends the timer of its number instead,
    ; and one that begins and ends ends it where the block is left.
    (let number (call (. tables probe-number) (. unit reading) id))
    (if (== number 0)
      (call refuse .refused-probe id)
      (return)
    )
    (let made (call probe-calls id))
    (if (and (!= (. made length) 0) (== (. ([] (. facts calls) ([] made 0)) form) .call-probe-metric))
      (let timing (call open-probe-gate id))
      (call time-profile
        (block
          (arg (if-expr (. row is-begin) .runtime-profile-timer-begin .runtime-profile-timer-end))
          (arg number)
          (arg id)
        )
      )
      (call close-probe-gate timing)
      (if (and (. row is-begin) (. row is-end))
        (if (or (. scoping cleaning) builds initializes)
          (call refuse .refused-probe id)
          (return)
        )
        (call open-cleanup id (call UseCell no-local no-local no-type))
      )
      (return)
    )
    (let logs (not (. row is-data)))
    (let object (if-expr (. row is-data) (. row object) 0))
    (let skip (call open-probe-gate id))
    (let start (. given length))
    (let snapshots (list Bool))
    (call gather-probe-object object)
    (let values (. given length))
    (call gather-probe-values (. row content) logs snapshots)
    (call cast-probe-values (. row content) logs values)
    (let head (. pending length))
    (+= pending (call integer .machine-u16 number))
    (if (or (. row is-begin) (not logs))
      (if (!= object 0)
        (+= pending (call integer .machine-u8 7))
      )
      (call push-probe-object object start)
    )
    (call emit-probe-record id made 0 head values snapshots)
    (call drop-given start)
    (call close-probe-gate skip)
    (if (and (. row is-begin) (. row is-end))
      (if (or (. scoping cleaning) builds initializes)
        (call refuse .refused-probe id)
        (return)
      )
      (call open-cleanup id (call UseCell no-local no-local no-type))
      (else-if (and logs (. row is-end))
        (call emit-probe-group-end id 1)
      )
    )
  )
  (fn-do _ emit-probe-group-end _
    (param id SyntaxId)
    (param part U32)
    ; The record that closes a group, which writes no values: the second a group that begins and ends
    ; writes, where the block it is written in is left, or the one after the log of a group that only
    ; ends. A timer of the profile that begins and ends ends there instead.
    (let made (call probe-calls id))
    (let skip (call open-probe-gate id))
    (if (and (!= (. made length) 0) (== (. ([] (. facts calls) ([] made 0)) form) .call-probe-metric))
      (call time-profile .runtime-profile-timer-end (call (. tables probe-number) (. unit reading) id) id)
      (else
        (let head (. pending length))
        (+= pending (call integer .machine-u16 (+ (call (. tables probe-number) (. unit reading) id) part)))
        (let snapshots (list Bool))
        (call emit-probe-record id made part head (. given length) snapshots)
      )
    )
    (call close-probe-gate skip)
  )
  (fn-do _ emit-probe-record _
    (param id SyntaxId)
    (param made (list FactId))
    (param part U32)
    (param head Size)
    (param values Size)
    (param snapshots (list Bool))
    ; Writes one record of a probe through the calls the type pass recorded for it, the `part`-th
    ; among those recorded at the probe: its head, given what is pending from `head`, then each value
    ; given from `values`, with the class of an object or an array and whether its snapshot is
    ; written, then the flush. Calls that do not fit the values have no shape.
    (let first (call probe-part-start made part))
    (let count (- (. given length) values))
    (let flush (+ first count 1))
    (if (or (>= flush (. made length)) (!= (. ([] (. facts calls) ([] made flush)) form) .call-probe) headless)
      (call refuse .refused-probe id)
      (call drop-pending head)
      (return)
    )
    (lazy headless (and (< (+ flush 1) (. made length)) (!= (. ([] (. facts calls) ([] made (+ flush 1))) form) .call-probe-head)))
    (call call-probe-function (. ([] (. facts calls) ([] made first)) callee) id head)
    (for (in offset (..< 0 count))
      (let callee (. ([] (. facts calls) ([] made (+ first offset 1))) callee))
      (let mark (. pending length))
      (+= pending (. ([] given (+ values offset)) operand))
      (if (== (. ([] (. instances signatures) callee) args count) 3)
        (let snapshot (and (< offset (. snapshots length)) ([] snapshots offset)))
        (+= pending (call integer .machine-u16 (call (. tables probe-class-id) (. ([] given (+ values offset)) type))))
        (+= pending (call integer .machine-u8 (if-expr snapshot 1 0)))
      )
      (call call-probe-function callee id mark)
    )
    (call call-probe-function (. ([] (. facts calls) ([] made flush)) callee) id (. pending length))
  )
  (fn-do _ time-profile _
    (param callee RuntimeFunction)
    (param number U32)
    (param site SyntaxId)
    ; Begins or ends the timer of the profile of a number.
    (let mark (. pending length))
    (+= pending (call integer .machine-u16 number))
    (call call-runtime callee site mark)
  )
  (fn-do _ count-event _
    (param count EventCount)
    (param site SyntaxId)
    (param amount U64 (= 1))
    ; Adds to a count the compiler keeps of what events do, where it compiles.
    (let number ([] (. tables event-counts) (as count Size)))
    (if (== number 0)
      (return)
    )
    (let mark (. pending length))
    (+= pending (call integer .machine-u16 number))
    (+= pending (call integer .machine-u64 amount))
    (call call-probe-function (. instances probe-runtime counter-add) site mark)
  )
  (fn-do _ probe-calls (list FactId)
    (param id SyntaxId)
    ; The calls of the probes module the type pass recorded at a probe, in order, or the mark of one
    ; that compiles only as a metric of the profile.
    (let made (list FactId))
    (let fact (call (. facts first-call) (. unit reading) id))
    (while (!= fact no-fact)
      (let form (. ([] (. facts calls) fact) form))
      (if (or (== form .call-probe) (== form .call-probe-head) (== form .call-probe-metric))
        (+= made fact)
      )
      (= fact (. ([] (. facts calls) fact) next))
    )
    (return made)
  )
  (fn-do _ probe-part-start Size
    (param made (list FactId))
    (param part U32)
    ; Where the calls of a record a probe writes start among those recorded at it: at the head of the
    ; `part`-th record.
    (let seen U32)
    (for (in position (..< 0 (. made length)))
      (if (== (. ([] (. facts calls) ([] made position)) form) .call-probe-head)
        (if (== seen part)
          (return position)
        )
        (+= seen 1)
      )
    )
    (return (. made length))
  )
  (fn-do _ gather-probe-object _
    (param object SyntaxId)
    ; Evaluates the object a probe is written of, where it has one, into what is given.
    (if (== object 0)
      (return)
    )
    (let emitted (call emit-expression object))
    (+= given emitted)
  )
  (fn-do _ push-probe-object _
    (param object SyntaxId)
    (param start Size)
    ; Passes the object a probe is written of, given at `start`, where it has one, with the id of its
    ; class.
    (if (== object 0)
      (return)
    )
    (+= pending (. ([] given start) operand))
    (+= pending (call integer .machine-u16 (call (. tables probe-class-id) (. ([] given start) type))))
  )
  (fn-do _ gather-probe-values _
    (param content (of RowRange SyntaxId))
    (param logs Bool)
    (param snapshots (list Bool))
    ; Evaluates each value written in a probe, in order, into what is given, noting which are
    ; snapshots. The texts written in a log are its template, and no values.
    (for (in item ([] (. tree children) content))
      (if (and logs (is ([] (. tree nodes) item) .node-string-syntax))
        (continue)
      )
      (+= snapshots (is ([] (. tree nodes) item) .node-probe-snapshot))
      (let emitted (call emit-expression (call (. tree probe-value) item)))
      (+= given emitted)
    )
  )
  (fn-do _ cast-probe-values _
    (param content (of RowRange SyntaxId))
    (param logs Bool)
    (param values Size)
    ; Casts each value of a probe given from `values` as the type pass recorded: one written as its
    ; text is converted, and a preview written as the name of its type is that name.
    (let position values)
    (for (in item ([] (. tree children) content))
      (if (and logs (is ([] (. tree nodes) item) .node-string-syntax))
        (continue)
      )
      (let value (call (. tree probe-value) item))
      (let type (call (. facts node-type) (. unit reading) value))
      (if (and (is ([] (. tree nodes) item) .node-probe-preview) (== (call probe-cast types type) .probe-converted))
        (let preview (call make-operand .operand-constant (call (. ir add-string) (call probe-preview-text types type))))
        (= ([] given position) (call Typed preview (. types string-type)))
        (else
          (let converted (call convert value .reason-print ([] given position)))
          (= ([] given position) converted)
        )
      )
      (+= position 1)
    )
  )
  (fn-do _ emit-probe-setup _
    ; The function the task main runs once the probes module has started, as the reference's
    ; `probesetup`: it opens the record of probes, makes room for the counters, numbered up to the last,
    ; and for the metrics of the profile, declares the key of each log and group and each class a value
    ; of a probe has, numbered after the probe data types, then each metric of the profile, then each
    ; probe the program compiles with the probe data type of each value it writes, and says the
    ; declarations are done.
    (let runtime (. instances probe-runtime))
    (call call-probe-function (. runtime begin) 0 (. pending length))
    (let mark (. pending length))
    (+= pending (call integer .machine-u64 (. tables last-counter)))
    (call call-probe-function (. runtime counter-setup) 0 mark)
    (= mark (. pending length))
    (+= pending (call integer .machine-u64 (as (. tables profile-metrics length) U64)))
    (call call-probe-function (. runtime profile-setup) 0 mark)
    (for (in key (. tables probe-keys))
      (= mark (. pending length))
      (+= pending (call make-operand .operand-constant (call (. ir add-string) key)))
      (call call-probe-function (. runtime declare-key) 0 mark)
    )
    (for (in position (..< 0 (. tables probe-classes length)))
      (= mark (. pending length))
      (+= pending (call integer .machine-u16 (as (+ probe-data-type-count position 1) U64)))
      (+= pending (call make-operand .operand-constant (call (. ir add-string) ([] (. tables probe-classes) position))))
      (call call-probe-function (. runtime declare-type) 0 mark)
    )
    (for (in position (..< 0 (. tables profile-metrics length)))
      (call declare-profile-metric position ([] (. tables profile-metrics) position))
    )
    (for (in position (..< 0 (. tables probes length)))
      (call declare-probe position ([] (. tables probes) position))
    )
    (call call-probe-function (. runtime ready) 0 (. pending length))
    (call return-nothing)
  )
  (fn-do _ emit-probe-teardown _
    ; The function that closes the record of probes, as the reference's `probeteardown`: it counts what
    ; the collector did under the counters that compile for it, then closes the record.
    (let runtime (. instances probe-runtime))
    (let counts (. tables collector-counts))
    (if (or (!= ([] counts 0) 0) (!= ([] counts 1) 0) (!= ([] counts 2) 0))
      (let mark (. pending length))
      (for (in count counts)
        (+= pending (call integer .machine-u16 count))
      )
      (call call-probe-function (. runtime collector-counts) 0 mark)
    )
    (call call-probe-function (. runtime end) 0 (. pending length))
    (call return-nothing)
  )
  (fn-do _ declare-probe _
    (param position Size)
    (param probe ProbeRow)
    ; Declares a probe the program compiles by its number: a log with its key, its name, its template,
    ; which holds `%%` for each value, its module, file and line; an event with its key and name; or a
    ; counter with its key, module, file and line. A record of a group is named for whether it opens or
    ; closes it; one that closes it has no template. Then the probe data type of each value it writes,
    ; with its class.
    (let runtime (. instances probe-runtime))
    (let number (call integer .machine-u16 (as (+ position 1) U64)))
    (let count (call integer .machine-u32 (. probe types count)))
    (let found (call (. tables probe-site) probe))
    (if (not found)
      (call refuse .refused-probe (. probe syntax))
      (return)
    )
    (let site found)
    (match (. site kind)
      (case= .log
        (call declare-probe-log
          (block
            (arg number)
            (arg (. site key))
            (arg (. site name))
            (arg (. site template))
            (arg (. site module-name))
            (arg (. site path))
            (arg (. site line))
            (arg count)
          )
        )
      )
      (case= .event
        (call declare-probe-event number (. site key) (. site name) (. site module-name) count)
      )
      (default
        (call declare-probe-counter number (. site key) (. site module-name) (. site path) (. site line))
        (return)
      )
    )
    (for (in offset (..< 0 (. probe types count)))
      (let mark (. pending length))
      (+= pending (call integer .machine-u8 ([] (. tables probe-types) (+ (. probe types start) offset))))
      (+= pending (call integer .machine-u16 ([] (. tables probe-type-classes) (+ (. probe types start) offset))))
      (call call-probe-function (. runtime declare-argument) 0 mark)
    )
  )
  (fn-do _ declare-profile-metric _
    (param position Size)
    (param metric ProbeRow)
    ; Declares a metric of the profile by its number: its key, whether it counts or times, its module,
    ; file and line, and no class.
    (let owner ([] (. program modules) (. ([] (. instances rows) (. metric instance)) module)))
    (let mark (. pending length))
    (+= pending (call integer .machine-u16 (as (+ position 1) U64)))
    (+= pending
      (call make-operand
        (block
          (arg .operand-constant)
          (arg (call (. ir add-string) (call (. tables metric-key) (. metric instance) (. metric syntax))))
        )
      )
    )
    (+= pending (call integer .machine-u8 (. metric part)))
    (+= pending (call make-operand .operand-constant (call (. ir add-string) (. owner name))))
    (+= pending (call make-operand .operand-constant (call (. ir add-string) (. owner path))))
    (+= pending (call integer .machine-u32 (+ (. ([] (. owner tree nodes loc) (. metric syntax)) begin line) 1)))
    (+= pending (call integer .machine-u16 0))
    (call call-probe-function (. instances probe-runtime declare-profile-metric) 0 mark)
  )
  (fn-do _ declare-probe-log _
    (param number Operand)
    (param key String)
    (param name String)
    (param template String)
    (param module-name String)
    (param path String)
    (param line U32)
    (param count Operand)
    (let mark (. pending length))
    (+= pending number)
    (+= pending (call make-operand .operand-constant (call (. ir add-string) key)))
    (+= pending (call make-operand .operand-constant (call (. ir add-string) name)))
    (+= pending (call make-operand .operand-constant (call (. ir add-string) template)))
    (+= pending (call make-operand .operand-constant (call (. ir add-string) module-name)))
    (+= pending (call make-operand .operand-constant (call (. ir add-string) path)))
    (+= pending (call integer .machine-u32 line))
    (+= pending count)
    (call call-probe-function (. instances probe-runtime declare-log) 0 mark)
  )
  (fn-do _ declare-probe-event _
    (param number Operand)
    (param key String)
    (param name String)
    (param module-name String)
    (param count Operand)
    (let mark (. pending length))
    (+= pending number)
    (+= pending (call make-operand .operand-constant (call (. ir add-string) key)))
    (+= pending (call make-operand .operand-constant (call (. ir add-string) name)))
    (+= pending (call make-operand .operand-constant (call (. ir add-string) module-name)))
    (+= pending count)
    (call call-probe-function (. instances probe-runtime declare-event) 0 mark)
  )
  (fn-do _ declare-probe-counter _
    (param number Operand)
    (param key String)
    (param module-name String)
    (param path String)
    (param line U32)
    (let mark (. pending length))
    (+= pending number)
    (+= pending (call make-operand .operand-constant (call (. ir add-string) key)))
    (+= pending (call make-operand .operand-constant (call (. ir add-string) module-name)))
    (+= pending (call make-operand .operand-constant (call (. ir add-string) path)))
    (+= pending (call integer .machine-u32 line))
    (call call-probe-function (. instances probe-runtime declare-counter) 0 mark)
  )
  (fn-do _ call-probe-function _
    (param callee InstanceId)
    (param site SyntaxId)
    (param mark Size)
    ; A call of a function of the probes module that compiled probes make, or the functions that
    ; declare, flush and close them: an error that leaves it is reported as one no caller handles,
    ; and what follows runs, as the reference hands it off.
    (if (== callee no-instance)
      (call refuse .refused-probe site)
      (call drop-pending mark)
      (return)
    )
    (let raising (!= (. ([] (. instances signatures) callee) errors count) 0))
    (= takes-result raising)
    (let answer (call call-instance callee site mark))
    (= takes-result false)
    (if raising
      (do
        (inline (call report-result site (. ([] (. instances signatures) callee) result) (. answer operand) false true))
      )
    )
  )
  (fn-do _ emit-raise _
    (param id SyntaxId)
    (param exception SyntaxId)
    (param condition SyntaxId)
    ; Raises a panic no handler of the function takes. The panic is given the place it is raised
    ; at when it has no source of its own, then its stack trace, and becomes the task's active
    ; panic. The function leaves through its landing pad, and what follows is never run. Under a
    ; condition the panic is raised only where the condition tests as true, and what follows runs
    ; where it does not. A function the collector never sees leaves that zone before it makes
    ; the panic, once, and everything up to the landing pad is outside it.
    (let resumed no-block)
    (if (!= condition 0)
      (let tested (call test condition (call emit-expression condition)))
      (let raising (call (. ir reserve-block)))
      (= resumed (call (. ir reserve-block)))
      (call branch (. tested operand) raising resumed)
      (call (. ir start-block) raising)
    )
    (call raise-given id exception)
    (call (. ir start-block) (if-expr (== resumed no-block) (call (. ir reserve-block)) resumed))
  )
  (fn-do _ raise-given _
    (param id SyntaxId)
    (param exception SyntaxId)
    (param planned SyntaxId (= 0))
    ; Evaluates a panic or an error and raises it at a node, which ends the block. An error is
    ; one the type pass said leaves the function there, at the node or at `planned` for an arm
    ; of a match that raises. Any other value has no shape here.
    (let report (. instances report))
    (let object ([] (. tables layouts objects) (. types panic-type)))
    (let is-ready (and (!= object no-layout) (!= (. report source-slot) (. U32 max)) (!= (. report trace-slot) (. U32 max))))
    (if (or (not is-ready) (== ([] (. tables instance-functions) (. report source)) no-function))
      (call refuse .refused-statement id)
      (return)
    )
    (if in-zone
      (call cross-zone id false)
      (= in-zone false)
    )
    (let raised (call emit-expression exception))
    (if (call extends (. raised type) (. types panic-type))
      (call raise (. raised operand) id)
      (else-if (and (call extends (. raised type) (. types error-type)) planned-raise)
        (call leave-with (. raised operand) (. raised type) id)
      )
      (else
        (call refuse .refused-statement id)
      )
    )
    (lazy planned-raise (== (call (. facts plan-of) (. unit reading) (if-expr (!= planned 0) planned id)) .plan-raise))
    (= in-zone (call is-free (. unit instance)))
  )
  (fn-do _ leave-with _
    (param error Operand)
    (param type TypeId)
    (param id SyntaxId)
    ; Leaves the function with an error in place of its value. The error is given the place of
    ; the node where it has no source of its own, then its stack trace. Where the type pass
    ; planned transformers for it there, each is tried in turn, and the first whose chain of
    ; earlier errors matches raises its exception in the error's place. An error raised in a
    ; cleanup leaves as TypeScript's does: in place of what was leaving, a value, another error or
