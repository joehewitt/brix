      (let fact (call (. facts first-call) (. unit reading) (. property syntax)))
      (if (and (!= fact no-fact) (!= (. ([] (. instances signatures) (. ([] (. facts calls) fact) callee)) args count) 0))
        (call refuse .refused-type (. property syntax))
        (return (call Typed (call make-operand .operand-void 0) no-type))
      )
      (if (and (call is-aggregate (. kept type)) (not (call (. types is-plain-tuple) (. kept type))))
        (let constructs (and (!= fact no-fact) (== (. ([] (. facts calls) fact) next) no-fact)))
        (if (and constructs (== (. ([] (. facts calls) fact) form) .call-this-constructor))
          (return
            (call emit-fact-call
              (block
                (arg (. property syntax))
                (arg ([] (. facts calls) fact))
                (arg 0)
                (arg (call (of RowRange SyntaxId)))
                (arg 0)
                (arg 0)
                (arg (. kept type))
              )
            )
          )
        )
        (if (call (. tables writes-constructor) (. kept type))
          (call refuse .refused-type (. property syntax))
          (return (call Typed (call make-operand .operand-void 0) no-type))
        )
        (let made
          (call make-fields
            (block
              (arg (. kept type))
              (arg (. kept layout))
              (arg (call (of RowRange ArgumentFill)))
              (arg (. given length))
              (arg 0)
              (arg (. property syntax))
            )
          )
        )
        (return (call Typed made (. kept type)))
      )
      (return (call default-value (. property syntax) (. kept type) (. kept layout) (. property syntax)))
    )
