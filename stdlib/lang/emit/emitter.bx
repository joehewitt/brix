    (let returns (call layout-of (if-expr (!= carried-given no-type) carried-given answer-type) id))
    (let ended (call (. ir add-local) (. run index-layout) true true))
    (let reached (call (. ir add-local) (. run index-layout) true true))
    (let erred (call (. ir add-local) (. run index-layout) true true))
