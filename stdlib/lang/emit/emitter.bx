      (call refuse .refused-function declared)
      (return)
    )
    (let layout (call layout-of (. row makes) declared))
    (if (!= layout (. tables layouts function-layout))
      (call refuse .refused-function declared)
      (return)
    )
    (call (. ir depend) .callee-function step 0)
    (let made (call frame layout))
    (call store made 0 (call make-operand .operand-symbol (. ([] (. tables functions) step) symbol)) false declared)
    (call store
      (block
        (arg made)
        (arg (. (call (. tables layouts field) layout 1) offset))
        (arg (call load-local (. unit environment) declared))
        (arg false)
        (arg declared)
      )
    )
    (if (and (!= (. row makes) returns-type) (== (call intrinsic returns-type) .interface))
      (= made (. (call make-interface declared (. row makes) returns-type made) operand))
      (else-if (!= (. row makes) returns-type)
