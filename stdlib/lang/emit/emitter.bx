    (let cased (and (!= held type) (== (call (. facts plan-of) (. unit reading) id) .plan-case-read)))
    (if (and (!= held type) (not (call holds held type)) (not cased))
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (if (== ([] (. unit cells) offset) no-local)
      (if (!= (call layout-of held id) void-layout)
        (call refuse .refused-expression id)
      )
      (return (call Typed nothing type))
    )
    (let value (call load-local ([] (. unit cells) offset) id))
    (if (== held type)
      (return (call Typed value type))
    )
    (if (and (== id stored-read) (not cased))
      (return (call Typed value held))
    )
    (if (and (!= shared-depth 0) (not (call (. facts is-inside-read) (. unit reading) id)))
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (if cased
      (return (call read-case id value held type))
    )
    (return (call payload id (call Typed value held)))
  )
  (fn-do _ read-case Typed
    (param id SyntaxId)
    (param value Operand)
    (param held TypeId)
    (param type TypeId)
    ; A union read as the one case the type pass knows it to hold: what the case holds, where it
    ; lies. An optional that holds the union is known to hold a value, and is read with no test.
    ; An object a case holds is read as a class it derives from, or as one derived from its own
    ; that a test the flow passed found it to be of.
    (let nothing (call make-operand .operand-void 0))
    (let constant (call (. facts constant-of) (. unit reading) id))
    (let whole value)
    (let union held)
    (if (call (. types is-optional) held)
      (let inner (call payload id (call Typed value held)))
      (= whole (. inner operand))
      (= union (. inner type))
    )
    (let layout (call layout-of union id))
    (if (or (== constant no-fact) (not (call (. tables layouts is-union) layout)))
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (let index (as (. ([] (. facts constants) constant) bits) U32))
    (if (>= index (. ([] (. tables layouts rows) layout) cases count))
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (let field (call (. tables layouts case-field) layout index))
    (let lined
      (scope (and (call (. tables is-class) (. field type)) (call (. tables is-class) type) related)
        (lazy related (or (call descends (. field type) type) (call descends type (. field type))))
      )
    )
    (if (and (!= (. field type) type) (not lined))
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (return (call Typed (call take whole field id) type))
  )
  (fn-do _ evaluated-before Bool
    (param flag LocalId)
    ; Whether an evaluation of a lazy local kept behind a flag, emitted in the function, ended in a
    ; block every way here passes, so that the flag is set here and a read evaluates nothing, as the
    ; reference skips a read whose block one of its evaluations dominates.
    (for (in position (..< 0 (. ready-lazies length)))
      (if (and (== (. ([] ready-lazies position) flag) flag) (call (. ir dominates) (. ([] ready-lazies position) block) (. ir current)))
        (return true)
      )
    )
    (return false)
  )
  (fn-expr _ read-wavers Bool
    (param slot SlotId)
    (param site SyntaxId)
    ; Whether the value of a lazy local evaluated by a read is typed where what the flow knows of
    ; what it reads may not hold here: the type pass found a read that knows a local the value
    ; reads otherwise than the first, or found this read of the emitted function's own to evaluate
    ; nothing where it does.
    (or (call (. facts lazy-wavers) (. unit reading) slot) (and (== (. unit reading) (. unit instance)) (call (. facts is-dominated-read) (. unit instance) site)))
  )
  (fn-do _ force-held _
    (param slot SlotId)
    (param site SyntaxId)
    ; Gives a lazy local the emitted function declares and holds as an eager local is its value
    ; where it has none yet: tests the flag the function keeps for it, and evaluates the value
    ; where it is clear, stores it in the environment and sets the flag. What the flow knows in the
    ; value holds here as at a read, unless the type pass found a read where a local the value reads
    ; is known otherwise.
    (let offset (call slot-offset slot site))
    (let flag ([] (. unit lazy-flags) offset))
    (let field (call find-captured slot site))
    (if (or (== flag no-local) (== (. field type) no-type) (== (. field type) invalid-type))
      (call refuse .refused-expression site)
      (return)
    )
    (if (call evaluated-before flag)
      (return)
    )
    (let group (. ([] (. bindings slots) slot) group))
    (let evaluate (call (. ir reserve-block)))
    (let ready (call (. ir reserve-block)))
    (call branch (call load-local flag site) ready evaluate)
    (call (. ir start-block) evaluate)
    (let wavers (call read-wavers slot site))
    (if wavers
      (+= shared-depth 1)
    )
    (+= lazy-open slot)
    (let value (call make-operand .operand-void 0))
    (match ([] (. tree nodes) group)
      (case (call .node-declare declaration)
        (let name (. declaration left))
        (let annotation SyntaxId 0)
        (match? ([] (. tree nodes) (. declaration left))
          (case (call .node-type-capture capture)
            (= name (. capture id))
            (= annotation (. capture type))
          )
        )
        (if (== (. declaration right) 0)
          (call refuse .refused-expression site)
          (else
            (= value (. (call declared-value name annotation (. declaration right) (. field type)) operand))
            (call claim-lazy group value (. field type))
          )
        )
      )
      (default
        (call refuse .refused-expression site)
      )
    )
    (call (. lazy-open pop))
    (if wavers
      (-= shared-depth 1)
    )
    (call keep-captured slot value (. field type) site)
    (call store-local flag (call integer .machine-u8 1) site)
    (call jump ready)
    (call (. ir start-block) ready)
    (+= ready-lazies (call ReadyLazy flag ready))
  )
  (fn-do _ force-captured _
    (param site SyntaxId)
    ; Gives each lazy local held as an eager local is (`holds-lazy`) that the emitted function
    ; declares and the nested function written at a node reads its value before the nested function
    ; is made, as `read-held` requires.
    (if (or (== (. unit instance) no-instance) (!= (. unit reading) (. unit instance)))
      (return)
    )
    (let binding (. ([] (. instances rows) (. unit instance)) binding))
    (if (== binding no-binding)
      (return)
    )
    (let bound ([] (. bindings bindings) binding))
    (for (in offset (..< 0 (. bound nested count)))
      (let nested ([] (. bindings nested) (+ (. bound nested start) offset)))
      (if (!= (. nested syntax) site)
        (continue)
      )
      (for (in index (..< 0 (. nested captures count)))
        (let slot (. ([] (. bindings captures) (+ (. nested captures start) index)) slot))
        (if (or (!= (. ([] (. bindings slots) slot) kind) .slot-lazy) (not (call (. tables holds-lazy) slot)) uncaptured)
          (continue)
        )
        (lazy uncaptured (or (not (call owns slot)) (not (call is-captured slot))))
        (let open false)
        (for (in held lazy-open)
          (= open (or open (== held slot)))
        )
        (if (not open)
          (call force-held slot site)
        )
      )
    )
  )
  (fn-do _ read-item Typed
    (param loop SyntaxId)
    (param id SyntaxId)
    (param type TypeId)
    ; The item of a loop whose body is being emitted, in the type the loop gives it. Where the
    ; type pass narrowed an optional item to what it holds, or a union to a case, the read is of
    ; that, as a local's is.
    (let nothing (call make-operand .operand-void 0))
    (let position (. loops length))
    (while (!= position 0)
      (-= position 1)
      (let row ([] loops position))
      (if (!= (. row syntax) loop)
        (continue)
      )
      (if (== (. row item-type) type)
        (if (!= (. row kept) no-slot)
          (return (call state (. row kept) id))
        )
        (return (call Typed (. row item) type))
      )
      (let cased (== (call (. facts plan-of) (. unit reading) id) .plan-case-read))
      (if (or (== (. row kept) no-slot) (!= shared-depth 0) (and (not cased) (not (call holds (. row item-type) type))))
        (call refuse .refused-expression id)
        (return (call Typed nothing no-type))
      )
      (let value (call state (. row kept) id))
      (if cased
        (return (call read-case id (. value operand) (. row item-type) type))
      )
      (return (call payload id value))
    )
    (call refuse .refused-expression id)
    (return (call Typed nothing no-type))
  )
  (fn-do _ unit-text Operand
    (param type TypeId)
    ; The name a number of a type is written with, as text.
    (let text "")
    (let name (call unit-name types type))
    (if name
      (= text (. name text))
    )
    (return (call make-operand .operand-constant (call (. ir add-string) text)))
  )
  (fn-expr _ argument-position U32
    (param slot SlotId)
    ; Which of the function's arguments a slot of its own binding is.
    ([] (. unit positions) (- slot (. unit slot-start)))
  )
  (fn-expr _ is-own-slot Bool
    (param slot SlotId)
    (and (>= slot (. unit slot-start)) (< (- slot (. unit slot-start)) (. unit slot-count)))
  )
  (fn-do _ load-property Typed
    (param id SyntaxId)
    (param object Operand)
    (param owner TypeId)
    (param name Atom)
    (param own Bool (= false))
    (param read TypeId (= no-type))
    ; Reads a stored property of an object, or a field of a struct: a scalar is loaded, and a
    ; struct is its address inside its owner. A property with no bits is read as nothing. A lazy
    ; property is read through its function, and under `catch` it may have the type of what that
    ; function answers where the value lets out errors. The read has the property's own type, or,
    ; where the type pass knows an optional property to hold a value, the type of what it holds:
    ; the read is then of that, with no test. A link of an optional chain has the property's own
    ; type, which the chain then holds in the optional its node has, and so has, as `own` says,
    ; the property a case of a union stores, read for a member the union forwards. A name a
    ; call calls is typed by no node, and is read as the type given. Where no table holds a
    ; function for a lazy property, as no object of a class that has it is ever made, the read never
    ; runs, and stands for the value its type has with nothing written (`unread-value`).
    (let nothing (call make-operand .operand-void 0))
    (if (call (. types is-optional) owner)
      (return (call optional-member id object owner name))
    )
    (let found (call property-of owner name))
    (if (not found)
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (let property ([] (. types properties) found))
    (let typed (if-expr (!= read no-type) read (call (. facts node-type) (. unit reading) id)))
    (let type (if-expr (or own (call is-link id)) (. property type) typed))
    (let holds (and (!= (. property type) type) (call (. types is-optional) (. property type))))
    (let narrowed (and holds (== (call (. types optional-inner) (. property type)) type)))
    (let is-lazy (and (== (. property storage-kind) .storage-lazy) (call (. tables is-class) owner)))
    (if (and is-lazy (not (call (. tables lazy-runs) (as found U32))))
      (return (call unread-value type (call layout-of type id) id))
    )
    (let caught (and is-lazy (!= type (. property type)) (== type (call (. tables lazy-result) (as found U32)))))
    (let cased
      (scope (and (!= (. property type) type) (not is-lazy) (!= (. unit reading) no-instance) case-read)
        (lazy case-read (== (call (. facts plan-of) (. unit reading) id) .plan-case-read))
      )
    )
    (if (and (or (and (!= (. property type) type) (not narrowed) (not cased)) (and narrowed is-lazy)) (not caught))
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (if is-lazy
      (return (call read-lazy id object (as found U32)))
    )
    (let field (call held-field id owner found))
    (if (== (. field layout) void-layout)
      (return (call Typed nothing type))
    )
    (call settle-memo id object owner property)
    (if (and narrowed (== id stored-read))
      (return (call Typed (call take object field id) (. property type)))
    )
    (if (and narrowed (!= shared-depth 0) (not (call (. facts is-inside-read) (. unit reading) id)))
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (if narrowed
      (return (call payload id (call Typed (call take object field id) (. property type))))
    )
    (if cased
      (return (call read-case id (call take object field id) (. property type) type))
    )
    (if (call (. tables layouts is-struct) (. field layout))
      (return (call Typed (call address object (. field offset) (. field layout) id) type))
    )
    (let loaded (call load object (. field offset) (. field layout) id))
    (if (and (!= (. unit reading) no-instance) (== (call (. facts plan-of) (. unit reading) id) .plan-guarded-read))
      (return (call guard-element id (call Typed loaded type) name))
    )
    (return (call Typed loaded type))
  )
  (fn-do _ held-field LayoutField
    (param site SyntaxId)
    (param owner TypeId)
    (param place Index)
    ; Where an object or a struct holds a property it stores as declared, how, and its type.
    (let none (call LayoutField 0 no-layout))
    (let property ([] (. types properties) place))
    (if (!= (. property storage-kind) .storage-eager)
      (call refuse .refused-expression site)
      (return none)
    )
    (let holder (call layout-of owner site))
    (let field none)
    (if (call (. tables layouts is-struct) holder)
      (= field (call (. tables layouts field) holder (. property slot)))
      (else-if (and (call (. tables is-class) owner) (!= ([] (. tables layouts objects) owner) no-layout))
        (let object-layout ([] (. tables layouts objects) owner))
        (= field (call (. tables layouts field) object-layout (+ object-header-fields (. property slot))))
      )
    )
    (if (== (. field layout) no-layout)
      (call refuse .refused-type site)
      (return none)
    )
    (return (call LayoutField (. field offset) (. field layout) (. property type)))
  )
  (fn-do _ optional-member Typed
    (param id SyntaxId)
    (param object Operand)
    (param owner TypeId)
    (param name Atom)
    ; What an optional answers by itself: `value`, what it holds, read with no test, and
    ; `has-value`, its flag.
    (if (== name (!! (. types value-atom)))
      (return (call payload id (call Typed object owner)))
    )
    (if (and (== name (!! (. types has-value-atom))) (call is-null-form owner))
      (return (call present id (call Typed object owner)))
    )
    (let layout (call layout-of owner id))
    (if (or (!= name (!! (. types has-value-atom))) (not (call (. tables layouts is-struct) layout)))
      (call refuse .refused-expression id)
      (return (call Typed (call make-operand .operand-void 0) no-type))
    )
    (let flag (call (. tables layouts field) layout 1))
    (return (call Typed (call load object (. flag offset) (. flag layout) id) (call (. facts node-type) (. unit reading) id)))
  )
  (fn-expr _ property-of (? Index)
    (param owner TypeId)
    (param name Atom)
    ; The property of a type by its name, among those the type pass completed it with, as the
    ; module whose code is emitted sees it.
    (call (. types property-seen) owner name (. unit source-module))
  )
  (fn-expr _ property-read (? Index)
    (param owner TypeId)
    (param read FactId)
    ; The property a value written for another reads, as the module of the value sees it.
    (call (. types property-seen) owner (. value name) (. ([] (. instances rows) (. value instance)) module))
    (where
      (lazy value ([] (. facts value-reads) read))
    )
  )
  (fn-do _ emit-binary Typed
    (param id SyntaxId)
    (param op Operator)
    (param lhs SyntaxId)
    (param rhs SyntaxId)
    ; A binary operator, in the way the type pass planned it. A pipe written on one line with
    ; what it reads is one.
    (if (== op .coalesce-op)
      (return (call emit-coalesce id lhs rhs))
    )
    (if (== op .else-op)
      (match? ([] (. tree nodes) lhs)
        (case (call .node-binary-expression row)
          (return (call emit-choice id (. row lhs) (. row rhs) rhs))
        )
      )
    )
    (if (or forward-pipe write-pipe (== op .grammar-pipe-op) (call pipes-stream op))
      (return (call emit-pipe id op lhs rhs))
    )
    (lazy forward-pipe (or (== op .pipe-forward-op) (== op .pipe-closure-op)))
    (lazy write-pipe (or (== op .pipe-write-all-op) (== op .pipe-write-each-op)))
    (if (or (== op .concat-op) (== op .concat-string-op))
      (return (call emit-concat id lhs rhs (== op .concat-string-op)))
    )
    (if (or (== op .and-op) (== op .or-op))
      (return (call emit-logic id (== op .and-op) lhs rhs))
    )
    (if (== op .if-op)
      (return (call emit-conditional id lhs rhs))
    )
    (return (call emit-planned id op lhs rhs (call (. facts plan-of) (. unit reading) id)))
  )
  (fn-do _ emit-planned Typed
    (param id SyntaxId)
    (param op Operator)
    (param lhs SyntaxId)
    (param rhs SyntaxId)
    (param plan OperatorPlan)
    ; A binary operator answered by a plan: the one the type pass recorded at the node, or for
    ; operands compared as what they hold the plan of that comparison.
    (if (and (== plan .plan-absent) (or (== op .equals-op) (== op .not-equals-op)))
      (return (call emit-absent id lhs rhs (== op .not-equals-op)))
    )
    (if (and (== plan .plan-held) (or (== op .equals-op) (== op .not-equals-op)))
      (return (call emit-held id lhs rhs (== op .not-equals-op)))
    )
    (if (== plan .plan-list-member)
      (return (call emit-list-member id op lhs rhs))
    )
    (if (== plan .plan-builtin)
      (return (call emit-builtin id op lhs rhs))
    )
    (if (or (== plan .plan-sign-checked-left) (== plan .plan-sign-checked-right))
      (return (call emit-sign-checked id op lhs rhs (== plan .plan-sign-checked-left)))
    )
    (if (and (== plan .plan-call) (call is-function-call id))
      (return (call emit-fact-call id ([] (. facts calls) (call own-call id)) 0 (call (of RowRange SyntaxId)) rhs lhs))
    )
    (if (or (== plan .plan-call) (== plan .plan-negated-call) (== plan .plan-neither-call) not-or-plan)
      (return (call emit-operator-call id lhs rhs plan))
    )
    (lazy not-or-plan (== plan .plan-not-or-call))
    (if (and (== plan .plan-pointer-add) (== op .add-op))
      (return (call emit-pointer-add id lhs rhs))
    )
    (if (and (== plan .plan-table) (== op .add-op) (== (call table-op id) (. TableOp table-zip)))
      (return (call emit-table-zip id lhs rhs))
    )
    (if (or (== plan .plan-fields) (== plan .plan-not-fields))
      (return (call emit-fields-compare id lhs rhs (== plan .plan-not-fields)))
    )
    (if (and (== plan .plan-class-test) (or (== op .is-op) (== op .is-not-op)))
      (return (call emit-class-test id lhs (== op .is-not-op)))
    )
    (if (== plan .plan-is)
      (return
        (call emit-is
          (block
            (arg id)
            (arg lhs)
            (arg rhs)
            (arg (or (== op .is-not-op) (== op .is-not-exactly-op) (== op .is-not-similar-op)))
          )
        )
      )
    )
    (if (and (== plan .plan-identity) (or (== op .equals-op) (== op .not-equals-op)))
      (return (call emit-identity id lhs rhs (== op .not-equals-op)))
    )
    (if (and (== plan .plan-address-compare) (call is-comparison op))
      (return (call emit-address-compare id op lhs rhs))
    )
    (if (and (== plan .plan-interface-equal) (or (== op .equals-op) (== op .not-equals-op)))
      (return (call emit-interface-equal id lhs rhs (== op .not-equals-op)))
    )
    (if (and (== plan .plan-interface-unlike) (or (== op .equals-op) (== op .not-equals-op)))
      (return (call emit-interface-unlike id lhs rhs))
    )
    (if (and (or (== plan .plan-unlike) (== plan .plan-alike)) (or (== op .equals-op) (== op .not-equals-op)))
      (call emit-expression lhs)
      (call emit-expression rhs)
      (return
        (call Typed
          (block
            (arg (call integer .machine-u8 (if-expr (== (== op .not-equals-op) (== plan .plan-unlike)) 1 0)))
            (arg (. types bool-type))
          )
        )
      )
    )
    (call refuse .refused-expression id)
    (return (call Typed (call make-operand .operand-void 0) no-type))
  )
  (fn-do _ emit-list-member Typed
    (param id SyntaxId)
    (param op Operator)
    (param lhs SyntaxId)
    (param rhs SyntaxId)
    ; `has` or `has not` of a list written in place, or `is in` or `not in` of a value in one,
    ; answered as `List.has` answers it without making the list: the operands are evaluated in the
    ; order they are written, the items converted as the list's are and the value as the argument
    ; of `has` is, and each item in turn is compared with the value by the plan of `==` recorded at
    ; the list, up to the first that is equal.
    (let nothing (call make-operand .operand-void 0))
    (let is-right (or (== op .is-in-op) (== op .not-in-op)))
    (let negated (or (== op .has-not-op) (== op .not-in-op)))
    (let written (if-expr is-right rhs lhs))
    (let tested (if-expr is-right lhs rhs))
    (let items (call (of RowRange SyntaxId)))
    (match? ([] (. tree nodes) written)
      (case (call .node-list-syntax row)
        (= items (. row items))
      )
    )
    (let has (call own-call id))
    (let plan (call (. facts plan-of) (. unit reading) written))
    (let equality (call list-equality written))
    (let machine (or (== plan .plan-builtin) (== plan .plan-identity)))
    (if (or (== (. items count) 0) (== has no-fact) (and (not machine) (or (!= plan .plan-call) (== equality no-fact))))
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (let item-type (call (. instances argument-type) (. ([] (. facts calls) has) callee) 0))
    (let value (call Typed nothing no-type))
    (if is-right
      (let emitted (call emit-expression tested))
      (= value (call Typed (call apart emitted tested (not (call is-inert written))) (. emitted type)))
    )
    (let start (. given length))
    (let disturbed (or (> (. items count) 1) (and (not is-right) (not (call is-inert tested)))))
    (for (in item ([] (. tree children) items))
      (let made (call emit-expression item))
      (+= given (call Typed (call apart made item disturbed) (. made type)))
    )
    (for (in position (..< 0 (. items count)))
      (let item ([] (. tree children) (+ (. items start) position)))
      (= ([] given (+ start position)) (call convert item .reason-element ([] given (+ start position))))
      (if (!= (. ([] given (+ start position)) type) item-type)
        (call refuse .refused-conversion item)
      )
    )
    (if (not is-right)
      (= value (call emit-expression tested))
    )
    (= value (call convert tested .reason-argument value))
    (if (!= (. value type) item-type)
      (call refuse .refused-conversion tested)
    )
    (let joined (call (. ir reserve-block)))
    (let slot (call make-operand .operand-void 0))
    (let arrivals (. joins length))
    (let found (call integer .machine-u8 (if-expr negated 0 1)))
    (for (in position (..< 0 (. items count)))
      (let item ([] (. tree children) (+ (. items start) position)))
      (let element (. ([] given (+ start position)) operand))
      (let equal nothing)
      (if machine
        (= equal (call compare item .compare-equal element (. value operand)))
        (else
          (let answer
            (call call-operator
              (block
                (arg written)
                (arg equality)
                (arg written)
                (arg element)
                (arg item-type)
                (arg written)
                (arg (. value operand))
                (arg item-type)
              )
            )
          )
          (if (!= (. answer type) (. types bool-type))
            (call refuse .refused-expression id)
          )
          (= equal (. answer operand))
        )
      )
      (let matched (call (. ir reserve-block)))
      (let next (call (. ir reserve-block)))
      (call branch equal matched next)
      (call (. ir start-block) matched)
      (call arrive id found joined slot)
      (call (. ir start-block) next)
    )
    (call drop-given start)
    (call arrive id (call integer .machine-u8 (if-expr negated 1 0)) joined slot)
    (return (call Typed (call close-joins joined arrivals u8-layout slot) (. types bool-type)))
  )
  (fn-do _ list-equality FactId
    (param written SyntaxId)
    ; The call of `==` recorded at a list written in place, after the calls that would make it, or
    ; no fact where none was.
    (let fact (call (. facts first-call) (. unit reading) written))
    (while (!= fact no-fact)
      (if (== (. ([] (. facts calls) fact) form) .call-operator)
        (return fact)
      )
      (= fact (. ([] (. facts calls) fact) next))
    )
    (return no-fact)
  )
  (fn-do _ emit-held Typed (?! Refused)
    (param id SyntaxId)
    (param lhs SyntaxId)
    (param rhs SyntaxId)
    (param negated Bool)
    ; `==` of operands compared as what they hold, or with `negated` `!=`: optionals, or a union
    ; on the left tested for one case, after what an optional holds is taken from it. Both operands
    ; are evaluated once, the left one first. An
    ; optional that holds nothing equals nothing that holds a value, and two that hold nothing
    ; are equal where the type pass says so. A union that holds another case equals no value.
    ; What both hold is compared by the plan of that `==`, with the operands in the order the
    ; type pass planned it in.
    (let nothing (call make-operand .operand-void 0))
    (let held (call (. facts held-of) (. unit reading) id))
    (let mark (. pins length))
    (let emitted (call emit-expression lhs))
    (let left (call apart emitted lhs (not (call is-inert rhs))))
    (let left-type (. emitted type))
    (let right (call emit-expression rhs))
    (let right-type (. right type))
    (if (or (!= (. held left) (call (. types is-optional) left-type)) right-differs (== (. held plan) .plan-held))
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (lazy right-differs (!= (. held right) (call (. types is-optional) right-type)))
    (let joined (call (. ir reserve-block)))
    (let slot (call make-operand .operand-void 0))
    (let arrivals (. joins length))
    (let differs (call integer .machine-u8 (if-expr negated 1 0)))
    (if (. held left)
      (let filled (call (. ir reserve-block)))
      (let empty (call (. ir reserve-block)))
      (call branch (. (call present id (call Typed left left-type)) operand) filled empty)
      (call (. ir start-block) empty)
      (if (. held alike)
        (let other (call present id (call Typed (. right operand) right-type)))
        (call arrive
          (block
            (arg id)
            (arg (. (if-expr negated other (call compare-zero id other .compare-equal)) operand))
            (arg joined)
            (arg slot)
          )
        )
        (else
          (call arrive id differs joined slot)
        )
      )
      (call (. ir start-block) filled)
      (let inner (call payload id (call Typed left left-type)))
      (= left (. inner operand))
      (= left-type (. inner type))
    )
    (if (!= (. held case-index) (. U32 max))
      (let layout (call layout-of left-type id))
      (if (or (not (call (. tables layouts is-union) layout)) past-cases)
        (call refuse .refused-expression id)
      )
      (lazy past-cases (>= (. held case-index) (. ([] (. tables layouts rows) layout) cases count)))
      (let filled (call (. ir reserve-block)))
      (let empty (call (. ir reserve-block)))
      (call branch (call case-test id left (. held case-index)) filled empty)
      (call (. ir start-block) empty)
      (call arrive id differs joined slot)
      (call (. ir start-block) filled)
      (let field (call (. tables layouts case-field) layout (. held case-index)))
      (= left (call take left field id))
      (= left-type (. field type))
    )
    (if (. held right)
      (let filled (call (. ir reserve-block)))
      (let empty (call (. ir reserve-block)))
      (call branch (. (call present id (call Typed (. right operand) right-type)) operand) filled empty)
      (call (. ir start-block) empty)
      (call arrive id differs joined slot)
      (call (. ir start-block) filled)
      (= right (call payload id (call Typed (. right operand) right-type)))
      (= right-type (. right type))
    )
    (call pin lhs left left-type)
    (call pin rhs (. right operand) right-type)
    (let equal (call Typed nothing no-type))
    (if (. held exchanged)
      (= equal (call emit-planned id .equals-op rhs lhs (. held plan)))
      (else
        (= equal (call emit-planned id .equals-op lhs rhs (. held plan)))
      )
    )
    (call unpin mark)
    (if (!= (. equal type) (. types bool-type))
      (call refuse .refused-expression id)
    )
    (if negated
      (= equal (call compare-zero id equal .compare-equal))
    )
    (call arrive id (. equal operand) joined slot)
    (let answer (call close-joins joined arrivals u8-layout slot))
    (return (call Typed answer (. types bool-type)))
  )
  (fn-do _ emit-absent Typed
    (param id SyntaxId)
    (param lhs SyntaxId)
    (param rhs SyntaxId)
    (param negated Bool)
    ; Compares an optional with `null`, written on either side: they are equal when the optional
    ; holds nothing. An operand that is not an optional is a local known to hold a value.
    (let nothing (call make-operand .operand-void 0))
    (let left (call emit-expression lhs))
    (let left-type (. left type))
    (let right (call emit-expression rhs))
    (let subject right)
    (if (!= left-type (. types null-type))
      (= subject left)
    )
    (if (not (call (. types is-optional) (. subject type)))
      (return (call Typed (call integer .machine-u8 (if-expr negated 1 0)) (. types bool-type)))
    )
    (let filled (call present id subject))
    (if negated
      (return filled)
    )
    (return (call Typed (call compare id .compare-equal (. filled operand) (call integer .machine-u8 0)) (. filled type)))
  )
  (fn-do _ emit-conditional Typed
    (param id SyntaxId)
    (param chosen SyntaxId)
    (param condition SyntaxId)
    ; `value if condition`: an optional that holds the value where the condition tests as true,
    ; and nothing where it does not. The value is evaluated only then, and arrives as the
    ; optional by the conversion recorded for a side.
    (let nothing (call make-operand .operand-void 0))
    (let type (call (. facts node-type) (. unit reading) id))
    (let layout (call layout-of type id))
    (let joinable (or (call (. tables layouts is-struct) layout) (call is-null-form type)))
    (if (or (not (call (. types is-optional) type)) (not joinable))
      (call refuse .refused-type id)
    )
    (let tested (call test id (call emit-expression condition) true true))
    (let taken (call (. ir reserve-block)))
    (let passed (call (. ir reserve-block)))
    (let joined (call (. ir reserve-block)))
    (let slot (call join-slot layout))
    (let mark (. joins length))
    (call branch (. tested operand) taken passed)
    (call (. ir start-block) taken)
    (call emit-arm id chosen type joined slot)
    (call (. ir start-block) passed)
    (call arrive id (. (call empty-optional type layout) operand) joined slot)
    (return (call Typed (call close-joins joined mark layout slot) type))
  )
  (fn-do _ emit-class-test Typed
    (param id SyntaxId)
    (param lhs SyntaxId)
    (param negated Bool)
    ; Whether an object is of a class or of one derived from it, or with `negated` whether it
    ; is not. The class is the constant the type pass recorded at the node.
    (let nothing (call make-operand .operand-void 0))
    (let fact (call (. facts constant-of) (. unit reading) id))
    (let value (call emit-expression lhs))
    (if (or (== fact no-fact) (not (call (. tables is-class) (. value type))))
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (let target (as (. ([] (. facts constants) fact) bits) TypeId))
    (if (not (call (. tables is-class) target))
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (let matched (call (. ir reserve-block)))
    (let missed (call (. ir reserve-block)))
    (let joined (call (. ir reserve-block)))
    (call class-branch id (. value operand) target matched missed)
    (call (. ir start-block) matched)
    (call jump joined)
    (call (. ir start-block) missed)
    (call jump joined)
    (call (. ir start-block) joined)
    (let yes (call integer .machine-u8 1))
    (let no (call integer .machine-u8 0))
    (return
      (call Typed
        (block
          (arg (call phi u8-layout (if-expr negated no yes) matched (if-expr negated yes no) missed))
          (arg (. types bool-type))
        )
      )
    )
  )
  (fn-do _ class-branch _
    (param site SyntaxId)
    (param value Operand)
    (param type TypeId)
    (param matched IRBlockId)
    (param missed IRBlockId)
    (param witnessed Bool (= false))
    ; Leaves to `matched` when an object is of a class or of one derived from it, and to
    ; `missed` when it is not: the object's table, and then the table of each base in turn, is
    ; compared with the class's. A class the program constructs no object of, nor of any class
    ; derived from it, has no table, and no object is of it. With `witnessed` the value is one
    ; of an interface, and the first table is the one its witness table names, which is nothing
    ; where it holds no object.
    (let symbol ([] (. tables table-symbols) type))
    (if (== symbol no-string)
      (call jump missed)
      (return)
    )
    (let cell (call (. ir add-local) pointer-layout))
    (if witnessed
      (let second (. (call (. tables layouts field) (. tables layouts interface-layout) 1) offset))
      (let witness (call load value second pointer-layout site))
      (call store-local cell (call load witness (* 2 table-slot-size) pointer-layout site) site)
      (else
        (call store-local cell (call load value 0 pointer-layout site) site)
      )
    )
    (let head (call (. ir reserve-block)))
    (let held (call (. ir reserve-block)))
    (let climb (call (. ir reserve-block)))
    (call jump head)
    (call (. ir start-block) head)
    (let table (call load-local cell site))
    (call branch table held missed)
    (call (. ir start-block) held)
    (if (. matching exact-class)
      (call branch
        (block
          (arg (call compare site .compare-equal table (call make-operand .operand-symbol symbol)))
          (arg matched)
          (arg missed)
        )
      )
      (call (. ir start-block) climb)
      (call jump missed)
      (return)
    )
    (call branch (call compare site .compare-equal table (call make-operand .operand-symbol symbol)) matched climb)
    (call (. ir start-block) climb)
    (call store-local cell (call load table 0 pointer-layout site) site)
    (call jump head)
  )
  (fn-do _ down-cast Typed
    (param site SyntaxId)
    (param value Operand)
    (param type TypeId)
    (param declared Bool (= false))
    ; An object as a class derived from the one it is known by: the object itself when it is of
    ; that class, and a panic when it is not, or inside a pattern a value that does not match.
    ; The panic of a cast names the class; where a declaration wrote the class for a local, it
    ; is that of a pattern that failed.
    (if (!= (. matching failing) no-block)
      (let passed (call (. ir reserve-block)))
      (call class-branch site value type passed (. matching failing))
      (+= fail-jumps 1)
      (call (. ir start-block) passed)
      (return (call Typed value type))
    )
    (if (not (. function may-panic))
      (call refuse .refused-conversion site)
      (return (call Typed value no-type))
    )
    (let matched (call (. ir reserve-block)))
    (let missed (call (. ir reserve-block)))
    (call class-branch site value type matched missed)
    (call (. ir start-block) missed)
    (call raise-text
      (block
        (arg site)
        (arg (if-expr declared "Pattern match failed" (str "Invalid cast to " (call type-display types type))))
      )
    )
    (call (. ir start-block) matched)
    (return (call Typed value type))
  )
  (fn-do _ held-as Typed
    (param site SyntaxId)
    (param value Operand)
    (param type TypeId)
    (param declared Bool (= false))
    ; What a value of an interface holds, as the class or the tuple a cast or a pattern names.
    ; It holds an object of a class where the table its witness table names is the class's or
    ; that of one derived from it, and a value of any other type where the type its witness
    ; table describes is that one. A type nothing is converted to an interface from has no
    ; description named, and nothing holds it. A value that holds another panics, or inside a
    ; pattern does not match. The panic is that of a cast, or where a declaration wrote the type
    ; for a local, that of a pattern that failed.
    (let missed (. matching failing))
    (if (== (. matching failing) no-block)
      (if (not (. function may-panic))
        (call refuse .refused-conversion site)
        (return (call Typed value no-type))
      )
      (= missed (call (. ir reserve-block)))
      (else
        (+= fail-jumps 1)
      )
    )
    (let passed (call (. ir reserve-block)))
    (let named ([] (. tables rtti-symbols) type))
    (if (call (. tables is-class) type)
      (call class-branch site value type passed missed true)
      (else-if (== named no-string)
        (call jump missed)
      )
      (else
        (let second (. (call (. tables layouts field) (. tables layouts interface-layout) 1) offset))
        (let described (call load (call load value second pointer-layout site) 0 pointer-layout site))
        (call branch
          (block
            (arg (call compare site .compare-equal described (call make-operand .operand-symbol named)))
            (arg passed)
            (arg missed)
          )
        )
      )
    )
    (if (== (. matching failing) no-block)
      (call (. ir start-block) missed)
      (call raise-text site (if-expr declared "Pattern match failed" (str "Invalid cast to " (call type-display types type))))
    )
    (call (. ir start-block) passed)
    (return (call unbox site type value))
  )
  (fn-do _ subclass-interface Typed
    (param site SyntaxId)
    (param value Operand)
    (param from TypeId)
    (param to TypeId)
    (param declared Bool (= false))
    ; An object as an interface that classes derived from the one it is known by declare: the
    ; slot the table of its class keeps for the interface holds the class's witness table, or
    ; nothing where the class declares none (`dynamic-slot`). One that holds nothing panics, or
    ; inside a pattern does not match, as a cast to a class does.
    (let nothing (call make-operand .operand-void 0))
    (let layout (call layout-of to site))
    (let slot (call (. tables dynamic-slot) from to))
    (if (or (!= layout (. tables layouts interface-layout)) (== slot no-slot-index))
      (call refuse .refused-conversion site)
      (return (call Typed nothing no-type))
    )
    (let missed (. matching failing))
    (if (== (. matching failing) no-block)
      (if (not (. function may-panic))
        (call refuse .refused-conversion site)
        (return (call Typed nothing no-type))
      )
      (= missed (call (. ir reserve-block)))
      (else
        (+= fail-jumps 1)
      )
    )
    (let passed (call (. ir reserve-block)))
    (let class-table (call load value 0 pointer-layout site))
    (let table (call load class-table (+ table-header-size (* slot table-slot-size)) pointer-layout site))
    (call branch (call compare site .compare-not-equal table (call integer .machine-pointer 0)) passed missed)
    (if (== (. matching failing) no-block)
      (call (. ir start-block) missed)
      (call raise-text
        (block
          (arg site)
          (arg (if-expr declared "Pattern match failed" (str "Invalid cast to " (call type-display types to))))
        )
      )
    )
    (call (. ir start-block) passed)
    (let made (call frame layout))
    (call store made 0 value false site)
    (call store made (. (call (. tables layouts field) layout 1) offset) table false site)
    (return (call Typed made to))
  )
  (fn-do _ emit-identity Typed
    (param id SyntaxId)
    (param lhs SyntaxId)
    (param rhs SyntaxId)
    (param negated Bool)
    ; Two objects of one class compared, or of two classes one derived from the other, two atoms,
    ; or two values of one closure: equal when they are one object, one atom, or one closure's
    ; data, which is to say one pointer. Two values of one function type are equal when they run
    ; one code with one data.
    (let nothing (call make-operand .operand-void 0))
    (let emitted (call emit-expression lhs))
    (let left (call apart emitted lhs (not (call is-inert rhs))))
    (let type (. emitted type))
    (let right (call emit-expression rhs))
    (if (and (== (. right type) type) (== ([] (. tables layouts values) type) (. tables layouts function-layout)))
      (let code (. (call (. tables layouts field) (. tables layouts function-layout) 0) offset))
      (let data (. (call (. tables layouts field) (. tables layouts function-layout) 1) offset))
      (let same-code
        (call compare
          (block
            (arg id)
            (arg .compare-equal)
            (arg (call load left code pointer-layout id))
            (arg (call load (. right operand) code pointer-layout id))
          )
        )
      )
      (let same-data
        (call compare
          (block
            (arg id)
            (arg .compare-equal)
            (arg (call load left data managed-layout id))
            (arg (call load (. right operand) data managed-layout id))
          )
        )
      )
      (let same (call bitwise id .bitwise-and same-code same-data u8-layout))
      (return
        (block
          (case? negated
            (call compare-zero id (call Typed same (. types bool-type)) .compare-equal)
          )
          (default
            (call Typed same (. types bool-type))
          )
        )
      )
    )
    (let objects (and (call (. tables is-class) type) (call (. tables is-class) (. right type))))
    (if (or (and (!= (. right type) type) (not objects)) no-identity)
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (lazy no-identity (and (not (call (. tables is-class) type)) (!= (call intrinsic type) .atom) (!= (call intrinsic type) .closure)))
    (return
      (call Typed
        (block
          (arg (call compare id (if-expr negated .compare-not-equal .compare-equal) left (. right operand)))
          (arg (. types bool-type))
        )
      )
    )
  )
  (fn-do _ emit-address-compare Typed
    (param id SyntaxId)
    (param op Operator)
    (param lhs SyntaxId)
    (param rhs SyntaxId)
    ; Two C pointers compared by the addresses they hold, as unsigned numbers, the left one
    ; evaluated first.
    (let nothing (call make-operand .operand-void 0))
    (let emitted (call emit-expression lhs))
    (let left (call apart emitted lhs (not (call is-inert rhs))))
    (let left-type (. emitted type))
    (let right (call emit-expression rhs))
    (let right-type (. right type))
    (if (and (== left-type (. types null-type)) (== (call intrinsic right-type) .cpointer))
      (= left (call integer (call (. tables layouts kind-of) (call layout-of right-type id)) 0))
      (= left-type right-type)
    )
    (if (and (== right-type (. types null-type)) (== (call intrinsic left-type) .cpointer))
      (= right (call Typed (call integer (call (. tables layouts kind-of) (call layout-of left-type id)) 0) (. right type)))
      (= right-type left-type)
    )
    (if (or (!= (call intrinsic left-type) .cpointer) (!= (call intrinsic right-type) .cpointer))
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (return (call Typed (call compare id (call predicate-of op) left (. right operand)) (. types bool-type)))
  )
  (fn-do _ emit-fields-compare Typed
    (param id SyntaxId)
    (param lhs SyntaxId)
    (param rhs SyntaxId)
    (param negated Bool)
    ; Two tuples or structs compared field by field, in the order the fields are stored, up to
    ; the first that differs, or two unions of one type by the case they hold. The left one is
    ; copied first when evaluating the right one may change what it names.
    (let nothing (call make-operand .operand-void 0))
    (let left (call emit-expression lhs))
    (let left-type (. left type))
    (if (and (not (call is-inert rhs)) (not (call is-answer (. left operand))))
      (= left (call Typed (call snapshot (. left operand) (call layout-of left-type id) lhs) (. left type)))
    )
    (let right (call emit-expression rhs))
    (let right-type (. right type))
    (let differ (call (. ir reserve-block)))
    (let joined (call (. ir reserve-block)))
    (= field-call (call (. facts first-call) (. unit reading) id))
    (= field-site rhs)
    (call skip-truths)
    (call compare-parts id (. left operand) left-type (. right operand) right-type differ)
    (if (!= field-call no-fact)
      (call refuse .refused-expression id)
    )
    (= field-call no-fact)
    (= field-site 0)
    (let same (. ir current))
    (call jump joined)
    (call (. ir start-block) differ)
    (call jump joined)
    (call (. ir start-block) joined)
    (let yes (call integer .machine-u8 1))
    (let no (call integer .machine-u8 0))
    (return
      (call Typed
        (block
          (arg (call phi u8-layout (if-expr negated no yes) same (if-expr negated yes no) differ))
          (arg (. types bool-type))
        )
      )
    )
  )
  (fn-do _ emit-interface-equal Typed
    (param id SyntaxId)
    (param lhs SyntaxId)
    (param rhs SyntaxId)
    (param negated Bool)
    ; Two values of interfaces compared for equal, or with `negated` for not equal, as
    ; `compare-interfaces` compares them. The left one is copied first when evaluating the right
    ; one may change what it names.
    (let nothing (call make-operand .operand-void 0))
    (let left (call emit-expression lhs))
    (let left-type (. left type))
    (if (and (not (call is-inert rhs)) (not (call is-answer (. left operand))))
      (= left (call Typed (call snapshot (. left operand) (call layout-of left-type id) lhs) (. left type)))
    )
    (let right (call emit-expression rhs))
    (= field-call (call (. facts first-call) (. unit reading) id))
    (call skip-truths)
    (let equal (call compare-interfaces id (. left operand) (. right operand)))
    (if (!= field-call no-fact)
      (call refuse .refused-expression id)
    )
    (= field-call no-fact)
    (return
      (block
        (case? negated
          (call compare-zero id (call Typed (. equal operand) (. types bool-type)) .compare-equal)
        )
        (default
          (call Typed (. equal operand) (. types bool-type))
        )
      )
    )
  )
  (fn-do _ emit-interface-unlike Typed
    (param id SyntaxId)
    (param lhs SyntaxId)
    (param rhs SyntaxId)
    ; A value of an interface compared with one of a type that is none: both are evaluated, and
    ; it panics with the reference's text, which names the right one's type.
    (let nothing (call make-operand .operand-void 0))
    (call emit-expression lhs)
    (let emitted (call emit-expression rhs))
    (let right-type (. emitted type))
    (call raise-text id (str "Unsupported interface equality with " (call type-runtime-name types right-type)))
    (call (. ir start-block) (call (. ir reserve-block)))
    (return (call Typed (call integer .machine-u8 0) (. types bool-type)))
  )
  (fn-do _ compare-interfaces Typed
    (param id SyntaxId)
    (param left Operand)
    (param right Operand)
    ; Compares two values of interfaces as the reference does. Where the types their witness
    ; tables describe differ, the getter recorded next at the node says whether a tracker is
    ; comparing for a change: the answer is then false, and otherwise the panic `Unsupported
    ; interface equality: concrete types differ`. Where they agree, the function the left
    ; value's table holds for equality is given both, and answers; a panic it raises is the
    ; caller's.
    (let nothing (call make-operand .operand-void 0))
    (if (== field-call no-fact)
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (let getter (. ([] (. facts calls) field-call) callee))
    (= field-call (. ([] (. facts calls) field-call) next))
    (call skip-truths)
    (if (or (== getter no-instance) (== ([] (. tables instance-functions) getter) no-function))
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (let second (. (call (. tables layouts field) (. tables layouts interface-layout) 1) offset))
    (let mine (call load left second pointer-layout id))
    (let theirs (call load right second pointer-layout id))
    (let same (call (. ir reserve-block)))
    (let differ (call (. ir reserve-block)))
    (let joined (call (. ir reserve-block)))
    (call branch
      (block
        (arg
          (call compare
            (block
              (arg id)
              (arg .compare-equal)
              (arg (call load mine 0 pointer-layout id))
              (arg (call load theirs 0 pointer-layout id))
            )
          )
        )
        (arg same)
        (arg differ)
      )
    )
    (call (. ir start-block) differ)
    (let comparing (call call-instance getter id (. pending length)))
    (let tolerated (call (. ir reserve-block)))
    (let unsupported (call (. ir reserve-block)))
    (call branch (. comparing operand) tolerated unsupported)
    (call (. ir start-block) unsupported)
    (call raise-text id "Unsupported interface equality: concrete types differ")
    (call (. ir start-block) tolerated)
    (let unequal (call integer .machine-u8 0))
    (let from-differ (. ir current))
    (call jump joined)
    (call (. ir start-block) same)
    (let method (call load mine table-slot-size pointer-layout id))
    (let mark (. pending length))
    (+= pending left)
    (+= pending right)
    (let answer (call call method id mark .callee-value u8-layout (not in-landing)))
    (let from-same (. ir current))
    (call jump joined)
    (call (. ir start-block) joined)
    (return (call Typed (call phi u8-layout unequal from-differ answer from-same) (. types bool-type)))
  )
  (fn-expr _ takes-argument Bool
    (param callee InstanceId)
    (param given TypeId)
    ; Whether a field's `==` takes a value of a type: as it is, or by the conversion the type pass
    ; recorded for it at `field-site`.
    (or (== taken given) (!= (call argument-conversion given taken) no-fact))
    (where
      (lazy taken (call (. instances argument-type) callee 0))
    )
  )
  (fn-do _ argument-conversion FactId
    (param from TypeId)
    (param to TypeId)
    ; The conversion the type pass recorded at `field-site` for a value a field's `==` takes, from
    ; the field's type to the type the `==` takes. No fact where none was recorded.
    (let fact (if-expr (!= field-site 0) (call (. facts first-conversion) (. unit reading) field-site) no-fact))
    (while (!= fact no-fact)
      (let row ([] (. facts conversions) fact))
      (if (and (== (. row reason) .reason-argument) (== (. row from) from) (== (. row to) to))
        (return fact)
      )
      (= fact (. row next))
    )
    (return no-fact)
  )
  (fn-do _ skip-truths _
    ; Moves on to the next call recorded for a field: the calls that test the node's own value
    ; as a condition are not for fields.
    (while (!= field-call no-fact)
      (if (call answers-node (. ([] (. facts calls) field-call) form))
        (return)
      )
      (= field-call (. ([] (. facts calls) field-call) next))
    )
  )
  (fn-do _ compare-parts _
    (param id SyntaxId)
    (param left Operand)
    (param left-type TypeId)
    (param right Operand)
    (param right-type TypeId)
    (param differ IRBlockId)
    ; Compares two values part by part, and leaves to `differ` at the first part that is not
    ; equal: two unions of one type by the case they hold, and two tuples or structs by their
    ; fields.
    (if (and (== left-type right-type) (== (call intrinsic left-type) .union))
      (call compare-cases id left left-type right differ)
      (else
        (call compare-fields id left left-type right right-type differ)
      )
    )
  )
  (fn-do _ compare-cases _
    (param id SyntaxId)
    (param left Operand)
    (param type TypeId)
    (param right Operand)
    (param differ IRBlockId)
    ; Compares two unions of one type, and leaves to `differ` where they hold different cases or
    ; what the case they hold is not equal. A case that holds a value of its own is a pair,
    ; compared as a field of a tuple is; one that holds none is equal to itself.
    (let layout (call layout-of type id))
    (if (not (call (. tables layouts is-union) layout))
      (call refuse .refused-expression id)
      (return)
    )
    (let same (call (. ir reserve-block)))
    (let tag (call load left 0 u8-layout id))
    (call branch (call compare id .compare-equal tag (call load right 0 u8-layout id)) same differ)
    (call (. ir start-block) same)
    (let done (call (. ir reserve-block)))
    (let index U32)
    (for (in fact (call (. types cases-of) type))
      (if (>= index (. ([] (. tables layouts rows) layout) cases count))
        (call refuse .refused-expression id)
        (return)
      )
      (if (and (not (. fact is-default)) (!= (. fact type) no-type))
        (let field (call (. tables layouts case-field) layout index))
        (let taken (call (. ir reserve-block)))
        (let next (call (. ir reserve-block)))
        (call branch (call case-test id left index) taken next)
        (call (. ir start-block) taken)
        (call compare-pair id (call take left field id) field (call take right field id) field differ)
        (call jump done)
        (call (. ir start-block) next)
      )
      (+= index 1)
    )
    (call jump done)
    (call (. ir start-block) done)
  )
  (fn-do _ compare-fields _
    (param id SyntaxId)
    (param left Operand)
    (param left-type TypeId)
    (param right Operand)
    (param right-type TypeId)
    (param differ IRBlockId)
    ; Compares the fields of two tuples or structs in turn, and leaves to `differ` at the first
    ; pair that is not equal.
    (let mine (call layout-of left-type id))
    (let theirs (call layout-of right-type id))
    (if (or (not (call (. tables layouts is-struct) mine)) (not (call (. tables layouts is-struct) theirs)))
      (call refuse .refused-expression id)
      (return)
    )
    (let count (. ([] (. tables layouts rows) mine) fields count))
    (if (!= (. ([] (. tables layouts rows) theirs) fields count) count)
      (call refuse .refused-expression id)
      (return)
    )
    (for (in position (..< 0 count))
      (let held (call (. tables layouts field) mine position))
      (let given (call (. tables layouts field) theirs position))
      (call compare-pair id (call take left held id) held (call take right given id) given differ)
    )
  )
  (fn-do _ compare-pair _ (?! Refused)
    (param id SyntaxId)
    (param a Operand)
    (param held LayoutField)
    (param b Operand)
    (param given LayoutField)
    (param differ IRBlockId)
    ; Compares one pair of parts, and leaves to `differ` where they are not equal. A pair is
    ; answered by the next call the type pass recorded when that call takes the pair, the second
    ; part converted first where the type pass recorded converting it for the call. One that no
    ; call takes is compared by the machine where it is of one type the machine compares, is, of
    ; one class or of atoms, equal when it is one object or one atom, of one function type, equal
    ; when the data they hold is one, is of interfaces compared as `compare-interfaces` does, is
    ; two optionals of one type compared as `compare-optionals` does, and is otherwise two values
    ; compared part by part the same way.
    (let equal (call make-operand .operand-void 0))
    (let takes false)
    (if (!= field-call no-fact)
      (let callee (. ([] (. facts calls) field-call) callee))
      (let self (. ([] (. instances rows) callee) self-type))
      (= takes (and (== self (. held type)) (call takes-argument callee (. given type))))
    )
    (if takes
      (let callee (. ([] (. facts calls) field-call) callee))
      (let taken (call (. instances argument-type) callee 0))
      (let given-value b)
      (if (!= taken (. given type))
        (= given-value (. (call convert-one id ([] (. facts conversions) (call argument-conversion (. given type) taken)) (call Typed b (. given type))) operand))
      )
      (let mark (. pending length))
      (+= pending a)
      (+= pending given-value)
      (let called (call call-method callee id mark))
      (= equal (. called operand))
      (if (!= (. called type) (. types bool-type))
        (call refuse .refused-conversion id)
      )
      (= field-call (. ([] (. facts calls) field-call) next))
      (call skip-truths)
      (else-if (and (== (. held type) (. given type)) (call compares-by-machine types (. held type)))
        (if (== (. held layout) void-layout)
          (return)
        )
        (= equal (call compare id .compare-equal a b))
      )
      (else-if (and (== (. held type) (. given type)) (or (call (. tables is-class) (. held type)) (== (call intrinsic (. held type)) .atom)))
        (= equal (call compare id .compare-equal a b))
      )
      (else-if (and (== (. held type) (. given type)) (== (. held layout) (. tables layouts function-layout)))
        (let data (. (call (. tables layouts field) (. tables layouts function-layout) 1) offset))
        (= equal
          (call compare
            (block
              (arg id)
              (arg .compare-equal)
              (arg (call load a data managed-layout id))
              (arg (call load b data managed-layout id))
            )
          )
        )
      )
      (else-if (and (== (call intrinsic (. held type)) .interface) (== (call intrinsic (. given type)) .interface))
        (= equal (. (call compare-interfaces id a b) operand))
      )
      (else-if (and (== (. held type) (. given type)) (call (. types is-optional) (. held type)))
        (call compare-optionals id a b (. held type) differ)
        (return)
      )
      (else
        (call compare-parts id a (. held type) b (. given type) differ)
        (return)
      )
    )
    (let next (call (. ir reserve-block)))
    (call branch equal next differ)
    (call (. ir start-block) next)
  )
  (fn-do _ compare-optionals _ (?! Refused)
    (param id SyntaxId)
    (param a Operand)
    (param b Operand)
    (param type TypeId)
    (param differ IRBlockId)
    ; Compares two optionals of one type, as the reference does, and leaves to `differ` where one
    ; holds a value and the other none, or both hold values that are not equal, compared as a pair
    ; of parts is with the right one first, as the reference compares what two optionals hold.
    (let holds (call present id (call Typed a type)))
    (let other (call present id (call Typed b type)))
    (let same (call (. ir reserve-block)))
    (call branch (call compare id .compare-equal (. holds operand) (. other operand)) same differ)
    (call (. ir start-block) same)
    (let filled (call (. ir reserve-block)))
    (let done (call (. ir reserve-block)))
    (call branch (. holds operand) filled done)
    (call (. ir start-block) filled)
    (let left (call payload id (call Typed a type)))
    (let inner (. left type))
    (let right (call payload id (call Typed b type)))
    (let layout (call layout-of inner id))
    (let field (call LayoutField 0 layout inner))
    (call compare-pair id (. right operand) field (. left operand) field differ)
    (call jump done)
    (call (. ir start-block) done)
  )
  (fn-do _ item-address Typed
    (param id SyntaxId)
    (param object SyntaxId)
    (param index SyntaxId)
    ; Where the item an index names lies: the pointer moved on by the index times the bytes an
    ; item is held in. The pointer is evaluated before the index, and an index narrower than the
    ; pointer is widened as its own type says. It has the type of the pointer.
    (let nothing (call make-operand .operand-void 0))
    (let base (call emit-expression object))
    (let type (. base type))
    (let layout (call layout-of type id))
    (let count (call emit-expression index))
    (let counted (call layout-of (. count type) index))
    (let held (call layout-of (call (. tables layouts pointee-type) type) id))
    (if (or (not (call is-pointer layout)) (not (call is-integer counted)) (== held void-layout))
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (let step (call integer .machine-u64 (. ([] (. tables layouts rows) held) size)))
    (let widest (if-expr (call is-signed counted) i64-layout u64-layout))
    (let wide (call num-cast id (call num-cast id (. count operand) counted widest) widest u64-layout))
    (let distance (call arithmetic id .arithmetic-multiply wide step u64-layout))
    (let moved
      (call arithmetic
        (block
          (arg id)
          (arg .arithmetic-add)
          (arg (call num-cast id (. base operand) layout u64-layout))
          (arg distance)
          (arg u64-layout)
        )
      )
    )
    (return (call Typed (call num-cast id moved u64-layout layout) type))
  )
  (fn-do _ emit-item Typed
    (param id SyntaxId)
    (param object SyntaxId)
    (param index SyntaxId)
    ; The item an index names past a pointer, read where it lies with no check. A struct is
    ; copied as it is read, so nothing stored there afterwards changes the value, unless a name is
    ; read from it at once (`read-in-place`).
    (let nothing (call make-operand .operand-void 0))
    (let place (call item-address id object index))
    (let type (call (. tables layouts pointee-type) (. place type)))
    (if (not (call gives id type))
      (call refuse .refused-conversion id)
      (return (call Typed nothing no-type))
    )
    (let layout (call layout-of type id))
    (if (== layout void-layout)
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (if (and (call (. tables layouts is-struct) layout) (!= (. matching read-in-place) id))
      (return (call Typed (call snapshot (call address (. place operand) 0 layout id) layout id) type))
    )
    (if (call (. tables layouts is-struct) layout)
      (return (call Typed (call address (. place operand) 0 layout id) type))
    )
    (return (call Typed (call load (. place operand) 0 layout id) type))
  )
  (fn-expr _ view-shape U32
    (param type TypeId)
    ; What a type is among the views of an array: 1 a range of its rows, 2 the items of one field,
    ; 3 its fields, 4 one row, and 0 any other.
    (case? (or (== type no-type) (== type invalid-type))
      0
    )
    (case? (or (call same-decl ref (. types array-rows-decl)) (call same-decl ref (. types array-row-range-decl)))
      1
    )
    (case? (call same-decl ref (. types array-field-decl))
      2
    )
    (case? (call same-decl ref (. types array-fields-decl))
      3
    )
    (case? (call same-decl ref (. types array-row-decl))
      4
    )
    (default
      0
    )
    (where
      (lazy ref (call class-ref types type))
    )
  )
  (fn-expr _ viewed-item TypeId
    (param type TypeId)
    ; The item a view or an array holds.
    (match ([] (. types rows) type)
      (case (call .type-class row)
        (if-expr (!= (. row args count) 0) (call (. types child-type) (. row args) 0) no-type)
      )
      (default
        no-type
      )
    )
  )
  (fn-expr _ view-slot U32
    (param id SyntaxId)
    ; The place in the item's layout of the field the type pass planned a view to read at a node.
    (if-expr (!= constant no-fact) (as (. ([] (. facts constants) constant) bits) U32) (. U32 max))
    (where
      (lazy constant (call (. facts constant-of) (. unit reading) id))
    )
  )
  (fn-do _ item-field LayoutField
    (param id SyntaxId)
    (param view TypeId)
    (param slot U32)
    ; The field of a view's item at a place in its layout.
    (let layout (call layout-of (call viewed-item view) id))
    (if (or (not (call (. tables layouts is-struct) layout)) past-fields)
      (call refuse .refused-expression id)
      (return (call LayoutField 0 void-layout))
    )
    (lazy past-fields (>= slot (. ([] (. tables layouts rows) layout) fields count)))
    (return (call (. tables layouts field) layout slot))
  )
  (fn-do _ emit-view-get Typed
    (param id SyntaxId)
    (param object SyntaxId)
    ; A name the compiler answers for a view: the rows or the fields of an array, a view of its
    ; storage, the items of one field of a view of fields, or a field read through a row.
    (let nothing (call make-operand .operand-void 0))
    (if (== (call (. facts plan-of) (. unit reading) object) .plan-proven-row)
      (let found (call proven-read (call innermost-loop) (call view-slot id)))
      (if (!= found (. U32 max))
        (return (call Typed (. ([] proven-reads found) value) (. ([] proven-reads found) type)))
      )
      (let cell (call proven-row-cell id object))
      (let viewed (. cell type))
      (let field (call item-field id viewed (call view-slot id)))
      (let read (call take (. cell operand) field id))
      (+= proven-reads (call ProvenRead (call innermost-loop) (call view-slot id) (. ir current) read (. field type)))
      (return (call Typed read (. field type)))
    )
    (let base (call emit-expression object))
    (let held (. base type))
    (let shape (call view-shape held))
    (if (== shape 0)
      (return (call make-view id (. base operand) held (call (. facts node-type) (. unit reading) id)))
    )
    (if (== shape 3)
      (return (call project-view id (. base operand) held (call view-slot id) (call (. facts node-type) (. unit reading) id)))
    )
    (if (== shape 4)
      (return (call row-field id (. base operand) held (call view-slot id)))
    )
    (call refuse .refused-expression id)
    (return (call Typed nothing no-type))
  )
  (fn-do _ emit-view-index Typed
    (param id SyntaxId)
    (param object SyntaxId)
    (param index SyntaxId)
    ; An index the compiler answers for a view: a constant one names a field of a row or of the
    ; fields, a range a view of the rows or the items it spans, and any other the row or the item
    ; at that index. The view is evaluated before the key.
    (let nothing (call make-operand .operand-void 0))
    (let emitted (call emit-expression object))
    (let base (call apart emitted object (not (call is-inert index))))
    (let held (. emitted type))
    (let shape (call view-shape held))
    (let type (call (. facts node-type) (. unit reading) id))
    (if (== shape 3)
      (return (call project-view id base held (call view-slot id) type))
    )
    (if (== shape 4)
      (return (call row-field id base held (call view-slot id)))
    )
    (if (and (!= shape 1) (!= shape 2))
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (let layout (call layout-of held id))
    (if (and (== (call view-shape type) shape) (!= (call call-at id .call-view-range) no-fact))
      (let range (call emit-expression index))
      (let range-type (. range type))
      (return (call slice-view id base held (. range operand) range-type object type))
    )
    (let key (call convert index .reason-argument (call emit-expression index)))
    (if (!= (. key type) (. types index-type))
      (call refuse .refused-conversion index)
      (return (call Typed nothing no-type))
    )
    (let cell (call make-operand .operand-void 0))
    (if (== (call (. facts plan-of) (. unit reading) id) .plan-proven-row)
      (= cell (call proven-cell id base layout (. key operand) held))
      (else
        (= cell (call view-cell id base layout (. key operand)))
      )
    )
    (if (== shape 2)
      (let item (call viewed-item held))
      (let item-layout (call layout-of item id))
      (return (call Typed (call take cell (call LayoutField 0 item-layout) id) item))
    )
    (return
      (call view-value
        (block
          (arg id)
          (arg type)
          (arg cell)
          (arg (. (call part base layout 1 id) operand))
          (arg (call integer .machine-u64 1))
          (arg (. (call part base layout 3 id) operand))
        )
      )
    )
  )
  (fn-do _ make-view Typed
    (param id SyntaxId)
    (param array Operand)
    (param held TypeId)
    (param type TypeId)
    ; The rows or the fields of an array: its storage as bytes, the bytes of an item, its size,
    ; and the owner the runtime makes for the storage, which the runtime marks stale when the
    ; storage goes away or is replaced. The runtime's function is called as TypeScript calls it,
    ; with no poll around it and no panic read after it.
    (let nothing (call make-operand .operand-void 0))
    (let layout (call layout-of held id))
    (let item-layout (call layout-of (call viewed-item type) id))
    (let data (call part array layout 0 id))
    (let data-layout (call layout-of (. data type) id))
    (let size (call part array layout 1 id))
    (let size-layout (call layout-of (. size type) id))
    (if (or (not (call is-pointer data-layout)) (not (call is-integer size-layout)))
      (call refuse .refused-type id)
      (return (call Typed nothing no-type))
    )
    (let stride (call integer .machine-u64 (. ([] (. tables layouts rows) item-layout) size)))
    (let bytes (call num-cast id (. data operand) data-layout pointer-layout))
    (let count (call num-cast id (. size operand) size-layout u64-layout))
    (let mark (. pending length))
    (+= pending bytes)
    (+= pending (call arithmetic id .arithmetic-multiply count stride u64-layout))
    (let owner (call call-runtime .runtime-array-view-create id mark pointer-layout))
    (return (call view-value id type bytes stride count owner))
  )
  (fn-do _ view-value Typed
    (param id SyntaxId)
    (param type TypeId)
    (param bytes Operand)
    (param stride Operand)
    (param size Operand)
    (param owner Operand)
    ; A view made of its four words in memory of the frame.
    (let layout (call layout-of type id))
    (if (or (not (call (. tables layouts is-struct) layout)) (!= (. ([] (. tables layouts rows) layout) fields count) 4))
      (call refuse .refused-type id)
      (return (call Typed (call make-operand .operand-void 0) no-type))
    )
    (let memory (call frame layout))
    (call put memory (call (. tables layouts field) layout 0) bytes id)
    (call put memory (call (. tables layouts field) layout 1) stride id)
    (call put memory (call (. tables layouts field) layout 2) size id)
    (call put memory (call (. tables layouts field) layout 3) owner id)
    (return (call Typed memory type))
  )
  (fn-do _ validate-view _
    (param id SyntaxId)
    (param view Operand)
    (param layout LayoutId)
    ; A view whose owner the runtime marked stale raises a panic.
    (let mark (. pending length))
    (+= pending (. (call part view layout 3 id) operand))
    (let valid (call call-runtime .runtime-array-view-valid id mark u8-layout))
    (call fail-view id (call compare id .compare-equal valid (call integer .machine-u8 0)) "Stale array view")
  )
  (fn-do _ fail-view _
    (param id SyntaxId)
    (param failed Operand)
    (param text String)
    ; Raises a panic of a view where a test holds.
    (let raising (call (. ir reserve-block)))
    (let passed (call (. ir reserve-block)))
    (call branch failed raising passed)
    (call (. ir start-block) raising)
    (call raise-text id text)
    (call (. ir start-block) passed)
  )
  (fn-do _ view-cell Operand
    (param id SyntaxId)
    (param view Operand)
    (param layout LayoutId)
    (param index Operand)
    ; Where the item at an index of a view lies, once the view is known not to be stale and the
    ; index to lie within it.
    (call validate-view id view layout)
    (let size (call part view layout 2 id))
    (call fail-view
      (block
        (arg id)
        (arg (call compare id .compare-greater-equal index (. size operand)))
        (arg "Array view index out of bounds")
      )
    )
    (let moved
      (call moved-bytes
        (block
          (arg id)
          (arg (. (call part view layout 0 id) operand))
          (arg (call arithmetic id .arithmetic-multiply index (. (call part view layout 1 id) operand) u64-layout))
        )
      )
    )
    (return moved)
  )
  (fn-do _ proven-cell Operand
    (param id SyntaxId)
    (param view Operand)
    (param layout LayoutId)
    (param index Operand)
    (param held TypeId)
    (let item-layout (call layout-of (call viewed-item held) id))
    (let stride (call integer .machine-u64 (. ([] (. tables layouts rows) item-layout) size)))
    (let moved
      (call moved-bytes
        (block
          (arg id)
          (arg (. (call part view layout 0 id) operand))
          (arg (call arithmetic id .arithmetic-multiply index stride u64-layout))
        )
      )
    )
    (return moved)
  )
  (fn-do _ proven-row-cell Typed
    (param id SyntaxId)
    (param object SyntaxId)
    (let nothing (call make-operand .operand-void 0))
    (match? ([] (. tree nodes) object)
      (case (call .node-index-expression row)
        (let view (call emit-expression (. row object)))
        (let held (. view type))
        (let layout (call layout-of held id))
        (let key (call convert (. row index) .reason-argument (call emit-expression (. row index))))
        (if (!= (. key type) (. types index-type))
          (call refuse .refused-conversion (. row index))
          (return (call Typed nothing no-type))
        )
        (let cell (call proven-cell id (. view operand) layout (. key operand) held))
        (return (call Typed cell held))
      )
    )
    (call refuse .refused-expression id)
    (return (call Typed nothing no-type))
  )
  (fn-do _ moved-bytes Operand
    (param id SyntaxId)
    (param bytes Operand)
    (param distance Operand)
    ; An address moved on by a count of bytes.
    (let moved
      (call arithmetic
        (block
          (arg id)
          (arg .arithmetic-add)
          (arg (call num-cast id bytes pointer-layout u64-layout))
          (arg distance)
          (arg u64-layout)
        )
      )
    )
    (return (call num-cast id moved u64-layout pointer-layout))
  )
  (fn-do _ row-field Typed
    (param id SyntaxId)
    (param row Operand)
    (param held TypeId)
    (param slot U32)
    ; A field read through a row, where the row's one item lies.
    (let layout (call layout-of held id))
    (let field (call item-field id held slot))
    (let cell (call view-cell id row layout (call integer .machine-u64 0)))
    (return (call Typed (call take cell field id) (. field type)))
  )
  (fn-do _ row-item Typed
    (param id SyntaxId)
    (param row Operand)
    (param held TypeId)
    ; The item a row views, read as the item.
    (let layout (call layout-of held id))
    (let item (call viewed-item held))
    (let item-layout (call layout-of item id))
    (let cell (call view-cell id row layout (call integer .machine-u64 0)))
    (return (call Typed (call take cell (call LayoutField 0 item-layout) id) item))
  )
  (fn-do _ project-view Typed
    (param id SyntaxId)
    (param fields Operand)
    (param held TypeId)
    (param slot U32)
    (param type TypeId)
    ; The items of one field of a view of fields: the view's bytes moved on to the field.
    (let layout (call layout-of held id))
    (let field (call item-field id held slot))
    (call validate-view id fields layout)
    (let bytes (call moved-bytes id (. (call part fields layout 0 id) operand) (call integer .machine-u64 (. field offset))))
    (return
      (call view-value
        (block
          (arg id)
          (arg type)
          (arg bytes)
          (arg (. (call part fields layout 1 id) operand))
          (arg (. (call part fields layout 2 id) operand))
          (arg (. (call part fields layout 3 id) operand))
        )
      )
    )
  )
  (fn-do _ slice-view Typed
    (param id SyntaxId)
    (param view Operand)
    (param held TypeId)
    (param range Operand)
    (param range-type TypeId)
    (param object SyntaxId)
    (param type TypeId)
    ; The rows or the items a range spans of a view: its bytes moved on to the range's start, and
    ; its size the range's. The range is made forward first, and must lie within the view and
    ; step by one.
    (let nothing (call make-operand .operand-void 0))
    (let layout (call layout-of held id))
    (call validate-view id view layout)
    (let forward (call forward-range id range range-type view held object))
    (let forward-type (. forward type))
    (let forward-layout (call layout-of forward-type id))
    (let start (call range-index id (. forward operand) forward-type forward-layout "start"))
    (let end (call range-index id (. forward operand) forward-type forward-layout "end"))
    (let length (call arithmetic id .arithmetic-subtract (. end operand) (. start operand) u64-layout))
    (let size (call part view layout 2 id))
    (call fail-view
      (block
        (arg id)
        (arg (call compare id .compare-greater (. start operand) (. size operand)))
        (arg "Array view range out of bounds")
      )
    )
    (let left (call arithmetic id .arithmetic-subtract (. size operand) (. start operand) u64-layout))
    (call fail-view id (call compare id .compare-greater length left) "Array view range out of bounds")
    (let step (call range-part id (. forward operand) forward-type forward-layout "increment"))
    (let step-layout (call layout-of (. step type) id))
    (if (not (call is-integer step-layout))
      (call refuse .refused-type id)
      (return (call Typed nothing no-type))
    )
    (let one (call integer (call (. tables layouts kind-of) step-layout) 1))
    (call fail-view
      (block
        (arg id)
        (arg (call compare id .compare-not-equal (. step operand) one))
        (arg "Array views require a unit range increment")
      )
    )
    (let stride (call part view layout 1 id))
    (let bytes
      (call moved-bytes
        (block
          (arg id)
          (arg (. (call part view layout 0 id) operand))
          (arg (call arithmetic id .arithmetic-multiply (. start operand) (. stride operand) u64-layout))
        )
      )
    )
    (return (call view-value id type bytes (. stride operand) length (. (call part view layout 3 id) operand)))
  )
  (fn-do _ forward-range Typed
    (param id SyntaxId)
    (param range Operand)
    (param range-type TypeId)
    (param view Operand)
    (param held TypeId)
    (param object SyntaxId)
    ; A range made forward by the calls the type pass recorded at an index of a view: a range of
    ; positions is first made one of indexes by its `normalize`, given the view.
    (let nothing (call make-operand .operand-void 0))
    (let fact (call call-at id .call-view-range))
    (let current (call Typed range range-type))
    (while (!= fact no-fact)
      (let row ([] (. facts calls) fact))
      (if (== (. row form) .call-view-range)
        (let callee (. row callee))
        (if (or (== callee no-instance) (not (call is-callable callee)))
          (call refuse .refused-expression id)
          (return (call Typed nothing no-type))
        )
        (let mark (. pending length))
        (+= pending (. current operand))
        (if (== (. ([] (. instances signatures) callee) args count) 1)
          (let given (call convert object .reason-argument (call Typed view held)))
          (if (!= (. given type) (call (. instances argument-type) callee 0))
            (call refuse .refused-conversion object)
          )
          (+= pending (. given operand))
          (else-if (!= (. ([] (. instances signatures) callee) args count) 0)
            (call refuse .refused-expression id)
          )
        )
        (= current (call call-method callee id mark))
      )
      (= fact (. row next))
    )
    (return current)
  )
  (fn-do _ range-part Typed
    (param id SyntaxId)
    (param range Operand)
    (param type TypeId)
    (param layout LayoutId)
    (param name String)
    ; A field of a range, by its name.
    (let found (call range-slot type name))
    (if (== found (. U32 max))
      (call refuse .refused-expression id)
      (return (call Typed (call make-operand .operand-void 0) no-type))
    )
    (return (call part range layout found id))
  )
  (fn-do _ range-slot U32
    (param type TypeId)
    (param name String)
    (let properties (. ([] (. types completions) type) properties))
    (for (in offset (..< 0 (. properties count)))
      (let property ([] (. types properties) (+ (. properties start) offset)))
      (if (== (. property name text) name)
        (return (. property slot))
      )
    )
    (return (. U32 max))
  )
  (fn-do _ range-index Typed
    (param id SyntaxId)
    (param range Operand)
    (param type TypeId)
    (param layout LayoutId)
    (param name String)
    ; A bound of a range, made an index.
    (let value (call range-part id range type layout name))
    (let held (call layout-of (. value type) id))
    (if (not (call is-integer held))
      (call refuse .refused-type id)
      (return value)
    )
    (return (call Typed (call num-cast id (. value operand) held u64-layout) (. value type)))
  )
  (fn-expr _ is-array-type Bool
    (param type TypeId)
    ; Whether a type is an array, whose storage views can see.
    (case? (or (== type no-type) (== type invalid-type) (!= (call intrinsic type) .tuple))
      false
    )
    (default
      (or (!= (call (. types ancestor-of) type (. types array-decl)) no-type) (!= (call (. types ancestor-of) type (. types immutable-array-decl)) no-type))
    )
  )
  (fn-do _ replace-storage _
    (param id SyntaxId)
    (param old Operand)
    (param old-type TypeId)
    (param next Operand)
    (param next-type TypeId)
    ; Tells the runtime that the storage of an array is replaced by another's, before the other
    ; is stored: the views of the old storage are marked stale where it is not the new storage, or
    ; where the new one is smaller. The runtime's function is called as TypeScript calls it, with
    ; no poll around it and no panic read after it.
    (let old-layout (call layout-of old-type id))
    (let next-layout (call layout-of next-type id))
    (let item-layout (call layout-of (call viewed-item next-type) id))
    (let stride (call integer .machine-u64 (. ([] (. tables layouts rows) item-layout) size)))
    (let mark (. pending length))
    (for (in side (..< 0 2))
      (let array (if-expr (== side 0) old next))
      (let layout (if-expr (== side 0) old-layout next-layout))
      (let data (call part array layout 0 id))
      (let data-layout (call layout-of (. data type) id))
      (let size (call part array layout 1 id))
      (let size-layout (call layout-of (. size type) id))
      (+= pending (call num-cast id (. data operand) data-layout pointer-layout))
      (+= pending
        (call arithmetic
          (block
            (arg id)
            (arg .arithmetic-multiply)
            (arg (call num-cast id (. size operand) size-layout u64-layout))
            (arg stride)
            (arg u64-layout)
          )
        )
      )
    )
    (call call-runtime .runtime-array-views-replace id mark void-layout)
  )
  (fn-do _ copy-items _
    (param id SyntaxId)
    (param layout LayoutId)
    (param target Operand)
    (param target-stride Operand)
    (param source Operand)
    (param source-stride Operand)
    (param length Operand)
    ; Copies items one by one from where one view's lie to where another's lie.
    (let counting (call open-pass id length))
    (let place (. counting index))
    (let reading-cell
      (call moved-bytes
        (block
          (arg id)
          (arg source)
          (arg (call arithmetic id .arithmetic-multiply place source-stride u64-layout))
        )
      )
    )
    (let writing-cell
      (call moved-bytes
        (block
          (arg id)
          (arg target)
          (arg (call arithmetic id .arithmetic-multiply place target-stride u64-layout))
        )
      )
    )
    (if (call (. tables layouts is-struct) layout)
      (call copy writing-cell reading-cell layout false id)
      (else
        (call store writing-cell 0 (call load reading-cell 0 layout id) false id)
      )
    )
    (call close-pass id counting)
  )
  (fn-do _ open-pass CountingPass
    (param site SyntaxId)
    (param size Operand)
    ; Begins a loop that counts its passes from 0 while the count, a U64, is below `size`, and
    ; starts its first pass. `close-pass` ends a pass and the loop.
    (let counter (call (. ir add-local) u64-layout))
    (call store-local counter (call integer .machine-u64 0) site)
    (let testing (call (. ir reserve-block)))
    (let passing (call (. ir reserve-block)))
    (let done (call (. ir reserve-block)))
    (call jump testing)
    (call (. ir start-block) testing)
    (call branch (call compare site .compare-less (call load-local counter site) size) passing done)
    (call (. ir start-block) passing)
    (return (call CountingPass counter testing done (call load-local counter site)))
  )
  (fn-do _ close-pass _
    (param site SyntaxId)
    (param counting CountingPass)
    ; Ends a pass of a loop `open-pass` began, counting it, and goes on after the loop.
    (call store-local
      (block
        (arg (. counting counter))
        (arg (call arithmetic site .arithmetic-add (. counting index) (call integer .machine-u64 1) u64-layout))
        (arg site)
      )
    )
    (call jump (. counting testing))
    (call (. ir start-block) (. counting done))
  )
  (fn-do _ emit-pointer-add Typed
    (param id SyntaxId)
    (param lhs SyntaxId)
    (param rhs SyntaxId)
    ; A pointer moved on by a count of the items it points at. The answer has the pointer's type.
    ; A count narrower than the pointer is widened by its own sign.
    (let nothing (call make-operand .operand-void 0))
    (let base (call emit-expression lhs))
    (let type (. base type))
    (let layout (call layout-of type id))
    (let count (call emit-expression rhs))
    (let counted (call layout-of (. count type) rhs))
    (if (or (not (call is-pointer layout)) (not (call is-integer counted)) (!= type (call (. facts node-type) (. unit reading) id)))
      (call refuse .refused-conversion id)
      (return (call Typed nothing no-type))
    )
    (let step (call integer .machine-u64 (call (. tables layouts pointee-size) type)))
    (let widest (if-expr (call is-signed counted) i64-layout u64-layout))
    (let wide (call num-cast id (call num-cast id (. count operand) counted widest) widest u64-layout))
    (let distance (call arithmetic id .arithmetic-multiply wide step u64-layout))
    (let moved
      (call arithmetic
        (block
          (arg id)
          (arg .arithmetic-add)
          (arg (call num-cast id (. base operand) layout u64-layout))
          (arg distance)
          (arg u64-layout)
        )
      )
    )
    (return (call Typed (call num-cast id moved u64-layout layout) type))
  )
  (fn-do _ emit-unary Typed
    (param id SyntaxId)
    (param op Operator)
    (param operand SyntaxId)
    ; A prefix operator, in the way the type pass planned it: the function it recorded, or the
    ; machine operation on a number. `!` of an optional is true when it holds no value.
    ; `type-of` gives the type of its operand as a value: of an object the class it was
    ; constructed as, read from its table, of a value of an interface the type of what it
    ; holds, read from its witness table, and of anything else the type it is held as.
    (let nothing (call make-operand .operand-void 0))
    (let plan (call (. facts plan-of) (. unit reading) id))
    (if (== op .type-of-op)
      (let subject (call emit-expression operand))
      (let held (. subject type))
      (if (or (== held no-type) (== held invalid-type) (not (call (. tables is-class) held)))
        (if (and (!= held no-type) (!= held invalid-type) (== (call intrinsic held) .interface))
          (let second (. (call (. tables layouts field) (. tables layouts interface-layout) 1) offset))
          (let witness (call load (. subject operand) second pointer-layout id))
          (return (call Typed (call load witness 0 pointer-layout id) (call (. facts node-type) (. unit reading) id)))
        )
        (return (call type-value id (call (. facts node-type) (. unit reading) id)))
      )
      (let table (call load (. subject operand) 0 pointer-layout id))
      (return (call Typed (call load table table-slot-size pointer-layout id) (call (. facts node-type) (. unit reading) id)))
    )
    (if (== op .optional-force-op)
      (return (call emit-force id operand))
    )
    (if (== op .delete-op)
      (return (call emit-delete id operand))
    )
    (if (== plan .plan-call)
      (return (call emit-operator-call id operand 0))
    )
    (if (!= plan .plan-builtin)
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (if (== op .not-op)
      (let tested (call emit-expression operand))
      (if (and (!= (. tested type) no-type) (!= (. tested type) invalid-type) (call (. types is-optional) (. tested type)))
        (= tested (call present operand tested))
      )
      (return (call compare-zero operand tested .compare-equal))
    )
    (if (and (!= op .negative-op) (!= op .bitwise-not-op))
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (let type (call (. facts node-type) (. unit reading) id))
    (let given (call convert operand .reason-operand (call emit-expression operand)))
    (let layout (call layout-of type id))
    (let fits (if-expr (== op .bitwise-not-op) (call is-integer layout) (call is-number layout)))
    (if (or (!= (. given type) type) (not fits))
      (call refuse .refused-conversion operand)
      (return (call Typed nothing no-type))
    )
    (let start U32 (. ir operands length))
    (call (. ir add-operand) (. given operand))
    (let row (if-expr (== op .bitwise-not-op) (. IROp op-bitwise-not) (. IROp op-negate)))
    (return (call Typed (call make-operand .operand-value (call append row id (call Span start 1) 0 layout)) (. given type)))
  )
  (fn-do _ emit-builtin Typed
    (param id SyntaxId)
    (param op Operator)
    (param lhs SyntaxId)
    (param rhs SyntaxId)
    (param assigns Bool (= false))
    ; The machine operation on two numbers. Each operand takes the conversions recorded at it,
    ; the right one also the conversion by a unit's ratio that the operator records as its own,
    ; and both arrive in one type. A conversion recorded for the result then gives it the node's
    ; type, but for an assigning operator, whose result the assignment converts as it stores it.
    (let left (call emit-expression lhs))
    (return (call combine-builtin id op lhs (. left operand) (. left type) rhs assigns))
  )
  (fn-do _ combine-builtin Typed
    (param id SyntaxId)
    (param op Operator)
    (param lhs SyntaxId)
    (param given Operand)
    (param given-type TypeId)
    (param rhs SyntaxId)
    (param assigns Bool)
    ; The machine operation on two numbers, the left already evaluated as `lhs` gives it.
    (let nothing (call make-operand .operand-void 0))
    (let left (call convert lhs .reason-operand (call Typed given given-type)))
    (= left (call convert lhs .reason-promotion left))
    (let machine (. left type))
    (let right (call convert rhs .reason-operand (call emit-expression rhs)))
    (= right (call convert id .reason-operator right))
    (= right (call convert rhs .reason-promotion right))
    (if (!= (. right type) machine)
      (call refuse .refused-conversion id)
      (return (call Typed nothing no-type))
    )
    (let layout (call layout-of machine id))
    (let result (call Typed nothing no-type))
    (if (call is-comparison op)
      (if (not (call is-number layout))
        (call refuse .refused-type id)
        (return (call Typed nothing no-type))
      )
      (= result (call Typed (call compare id (call predicate-of op) (. left operand) (. right operand)) (. types bool-type)))
      (else
        (= result
          (call convert
            (block
              (arg id)
              (arg .reason-result)
              (arg (call Typed (call operate id op (. left operand) (. right operand) layout) (. right type)))
            )
          )
        )
      )
    )
    (if (and (not assigns) (!= (. result type) (call (. facts node-type) (. unit reading) id)))
      (call refuse .refused-conversion id)
    )
    (return result)
  )
  (fn-do _ operate Operand
    (param id SyntaxId)
    (param op Operator)
    (param left Operand)
    (param right Operand)
    (param layout LayoutId)
    ; One row of arithmetic or of a bitwise operator on two numbers of a layout, with no check of
    ; any kind. The remainder of two floats is a call the collector never sees.
    (let nothing (call make-operand .operand-void 0))
    (let bitwise (call bitwise-of op))
    (let arithmetic (call arithmetic-of op))
    (if (and (!= bitwise (. U32 max)) (call is-integer layout))
      (let start U32 (. ir operands length))
      (call (. ir add-operand) left)
      (call (. ir add-operand) right)
      (return (call make-operand .operand-value (call append .op-bitwise id (call Span start 2) bitwise layout)))
    )
    (if (or (== arithmetic (. U32 max)) (not (call is-number layout)))
      (call refuse .refused-type id)
      (return nothing)
    )
    (if (and (== op .mod-op) (call is-float layout))
      (let remainder (. RuntimeFunction runtime-float-remainder))
      (if (== layout f32-layout)
        (= remainder .runtime-float32-remainder)
      )
      (let mark (. pending length))
      (+= pending left)
      (+= pending right)
      (return (call call-runtime remainder id mark layout))
    )
    (let start U32 (. ir operands length))
    (call (. ir add-operand) left)
    (call (. ir add-operand) right)
    (return (call make-operand .operand-value (call append .op-arithmetic id (call Span start 2) arithmetic layout)))
  )
  (fn-do _ emit-sign-checked Typed
    (param id SyntaxId)
    (param op Operator)
    (param lhs SyntaxId)
    (param rhs SyntaxId)
    (param is-left Bool)
    ; A comparison of a signed integer with an unsigned one at least as wide. The signed side is
    ; tested first. When it is negative the answer is known, and otherwise both are compared in
    ; the unsigned type the type pass converted them to.
    (let nothing (call make-operand .operand-void 0))
    (let left-given (call emit-expression lhs))
    (let left-type (. left-given type))
    (let left (call convert lhs .reason-operand left-given))
    (let common (. left type))
    (let right-given (call emit-expression rhs))
    (let right-type (. right-given type))
    (let right (call convert rhs .reason-operand right-given))
    (if (or (!= (. right type) common) (not (call is-comparison op)))
      (call refuse .refused-conversion id)
      (return (call Typed nothing no-type))
    )
    (let signed-layout (call layout-of (if-expr is-left left-type right-type) id))
    (let layout (call layout-of common id))
    (if (or (not (call is-integer signed-layout)) (not (call is-integer layout)))
      (call refuse .refused-type id)
      (return (call Typed nothing no-type))
    )
    (let origin (call integer (call (. tables layouts kind-of) signed-layout) 0))
    (let negative
      (call compare
        (block
          (arg id)
          (arg .compare-less)
          (arg (. (if-expr is-left left-given right-given) operand))
          (arg origin)
        )
      )
    )
    (let compared (call (. ir reserve-block)))
    (let joined (call (. ir reserve-block)))
    (let tested (. ir current))
    (call branch negative joined compared)
    (call (. ir start-block) compared)
    (let answer (call compare id (call predicate-of op) (. left operand) (. right operand)))
    (let compared-end (. ir current))
    (call jump joined)
    (call (. ir start-block) joined)
    (let known (call integer .machine-u8 (call known-answer op is-left)))
    (return (call Typed (call phi u8-layout known tested answer compared-end) (. types bool-type)))
  )
  (fn-do _ emit-logic Typed
    (param id SyntaxId)
    (param is-and Bool)
    (param lhs SyntaxId)
    (param rhs SyntaxId)
    ; `&&` and `||` on two values tested as conditions. The right one is evaluated only when the
    ; left one does not decide the answer. A left one that holds the middle of a chain of
    ; orderings opens its slot to the right one. Where the type pass found that the left one
    ; always decides it, the left one is evaluated and the answer is the one it decides.
    (let nothing (call make-operand .operand-void 0))
    (if (== (call (. facts plan-of) (. unit reading) id) .plan-never)
      (call emit-expression lhs)
      (return (call Typed (call integer .machine-u8 (if-expr is-and 0u64 1u64)) (. types bool-type)))
    )
    (let left (call test id (call emit-expression lhs) true))
    (let held (call held-by lhs))
    (let further (call (. ir reserve-block)))
    (let joined (call (. ir reserve-block)))
    (let decided (. ir current))
    (if is-and
      (call branch (. left operand) further joined)
      (else
        (call branch (. left operand) joined further)
      )
    )
    (call (. ir start-block) further)
    (let own-unit unit)
    (if (!= held no-place)
      (= unit (= (. unit open-held) held))
    )
    (let right (call test id (call emit-expression rhs) true true))
    (= unit own-unit)
    (let further-end (. ir current))
    (call jump joined)
    (call (. ir start-block) joined)
    (let short (call integer .machine-u8 (if-expr is-and 0u64 1u64)))
    (return (call Typed (call phi u8-layout short decided (. right operand) further-end) (. types bool-type)))
  )
  (fn-do _ branch-on _ (?! Refused)
    (param condition SyntaxId)
    (param when-true IRBlockId)
    (param when-false IRBlockId)
    (param site SyntaxId (= 0))
    (param is-right Bool (= false))
    ; Goes on to one block where a condition tests as true and to the other where it does not. Each
    ; side of `&&` and `||` branches in turn, as `emit-logic` evaluates them, so the answer is not
    ; made as a value. The condition is tested as itself, or with `site` as that `&&` or `||`
    ; tests its left side, or with `is-right` its right one. The predicate an `if` tests is seen
    ; through where it holds `&&` or `||` and tests it as itself.
    (match? ([] (. tree nodes) condition)
      (case (call .node-type-predicate row)
        (let logic (or (call (. tree is-logic) (. row expr)) (!= (call logic-lazy (. row expr) 0 false) no-slot)))
        (if (and (== site 0) (not (. row is-contextual)) logic (call passes-through condition (. row expr)))
          (call branch-on (. row expr) when-true when-false)
          (return)
        )
      )
      (case .node-identifier
        (let slot (call logic-lazy condition site is-right))
        (if (!= slot no-slot)
          (+= lazy-open slot)
          (call branch-on (call (. tree lazy-value) (. ([] (. bindings slots) slot) group)) when-true when-false)
          (call (. lazy-open pop))
          (return)
        )
      )
      (case (call .node-binary-expression row)
        (if (and (or (== (. row op) .and-op) (== (. row op) .or-op)) (call branches-apart condition site is-right))
          (let further (call (. ir reserve-block)))
          (if (== (. row op) .and-op)
            (call branch-on (. row lhs) further when-false condition)
            (else
              (call branch-on (. row lhs) when-true further condition)
            )
          )
          (let held (call held-by (. row lhs)))
          (call (. ir start-block) further)
          (let own-unit unit)
          (if (!= held no-place)
            (= unit (= (. unit open-held) held))
          )
          (call branch-on (. row rhs) when-true when-false condition true)
          (= unit own-unit)
          (return)
        )
      )
    )
    (let tested
      (match site
        (case= 0
          (call test condition (call emit-expression condition))
        )
        (default
          (call test site (call emit-expression condition) true is-right)
        )
      )
    )
    (call branch (. tested operand) when-true when-false)
  )
  (fn-expr _ passes-through Bool
    (param predicate SyntaxId)
    (param expr SyntaxId)
    ; Whether the predicate of an `if` is its expression as it is: the type pass recorded no test,
    ; conversion or other type for it.
    (case? (or (not (call (. facts node-slot) (. unit reading) predicate)) (not (call is-consumable predicate)) truth-tested)
      false
    )
    (case? (and (!= (. pins length) 0) (call pin-of predicate))
      false
    )
    (default
      (== (call (. facts answer-type) (. unit reading) predicate) (call (. facts answer-type) (. unit reading) expr))
    )
    (where
      (lazy truth-tested (!= (call truth-call predicate false false) no-fact))
    )
  )
  (fn-expr _ branches-apart Bool
    (param id SyntaxId)
    (param site SyntaxId)
    (param is-right Bool)
    ; Whether an `&&` or `||` can branch on each side: the type pass left its answer to be found
    ; as it runs, nothing pinned it, and its answer is tested as the Bool it is.
    (case? (or (== (call (. facts plan-of) (. unit reading) id) .plan-never) (not (call (. facts node-slot) (. unit reading) id)) (not (call is-consumable id)))
      false
    )
    (case? (and (!= (. pins length) 0) (call pin-of id))
      false
    )
    (default
      (== fact no-fact)
    )
    (where
      (lazy fact (if-expr (== site 0) (call truth-call id false false) (call truth-call site true is-right)))
    )
  )
  (fn-do _ emit-delete Typed
    (param id SyntaxId)
    (param operand SyntaxId)
    ; `-=` of an item: the function that answers `-=[]` is called on the object with the key, the
    ; object evaluated first and then the key, as TypeScript does, each with the conversion
    ; recorded for it. The value is what the function answers, or the object where it answers
    ; nothing. Where the type pass planned the answer to be stored, it is stored where the object
    ; was read from, which then only names storage.
    (let nothing (call make-operand .operand-void 0))
    (let object SyntaxId 0)
    (let index SyntaxId 0)
    (match? ([] (. tree nodes) operand)
      (case (call .node-index-expression row)
        (if (not (call chains-at operand (. row is-optional)))
          (= object (. row object))
          (= index (. row index))
        )
      )
    )
    (let fact (if-expr (!= object 0) (call own-call operand) no-fact))
    (if (== fact no-fact)
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (let call ([] (. facts calls) fact))
    (let callee (. call callee))
    (if (or (== callee no-instance) (. call is-partial) (not (call is-callable callee)))
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (if (or (not (call fills-in-order call callee 1)) (call names-slot object .slot-super))
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (let owner (. ([] (. instances rows) callee) self-type))
    (let answers (. ([] (. instances signatures) callee) returns))
    (let stores-back (== (call (. facts plan-of) (. unit reading) operand) .plan-store-answer))
    (let placed (and (== answers owner) (call is-place object) (== (call (. facts node-type) (. unit reading) object) owner)))
    (if (or (== owner no-type) (and stores-back (not placed)))
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (let pin-mark (. pins length))
    (if stores-back
      (call pin-holder object)
    )
    (let receiver (call convert object .reason-receiver (call emit-expression object)))
    (let receiver-type (. receiver type))
    (let key receiver)
    (let key-type no-type)
    (= key (call convert index .reason-argument (call emit-expression index)))
    (= key-type (. key type))
    (if (!= receiver-type owner)
      (call refuse .refused-conversion object)
    )
    (if (!= key-type (call (. instances argument-type) callee 0))
      (call refuse .refused-conversion index)
    )
    (let answer nothing)
    (let mark (. pending length))
    (+= pending (. receiver operand))
    (+= pending (. key operand))
    (= answer (. (call call-method callee operand mark) operand))
    (if (and stores-back (call (. facts is-replacing) (. unit reading) operand))
      (let old (call emit-expression object))
      (call replace-storage operand (. old operand) (. old type) answer answers)
    )
    (if stores-back
      (call store-place object answer owner operand)
    )
    (call unpin pin-mark)
    (let result (if-expr (== answers (. types void-type)) receiver (call Typed answer answers)))
    (if (!= (. result type) (call (. facts node-type) (. unit reading) id))
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (return result)
  )
  (fn-do _ emit-operator-call Typed
    (param id SyntaxId)
    (param lhs SyntaxId)
    (param rhs SyntaxId)
    (param plan OperatorPlan (= (. OperatorPlan plan-call)))
    (param assigns Bool (= false))
    ; An operator that functions answer: the calls the type pass recorded at the node, each made
    ; on the operand it chose as receiver with the other as its argument. A prefix operator has
    ; no other. The operands are evaluated once. One call answers by itself, or negated by its
    ; opposite. Two answer together, both always asked: that neither holds, or that the first
    ; does not or the second does. The answer has the node's type. A struct or a tuple on the left
    ; is a copy of what its place held before the right is evaluated, but where the operator
    ; `assigns` to that place: there the function is given the place itself.
    (let nothing (call make-operand .operand-void 0))
    (let pair (or (== plan .plan-neither-call) (== plan .plan-not-or-call)))
    (let fact (call answering (call (. facts first-call) (. unit reading) id)))
    (let second no-fact)
    (if (!= fact no-fact)
      (= second (call answering (. ([] (. facts calls) fact) next)))
    )
    (if (or (== fact no-fact) (!= (!= second no-fact) pair))
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (let given (call emit-expression lhs))
    (let left (call apart given lhs (and (not assigns) (!= rhs 0) (not (call is-inert rhs)))))
    (let left-type (. given type))
    (let right nothing)
    (let right-type no-type)
    (if (!= rhs 0)
      (let emitted (call emit-expression rhs))
      (= right (. emitted operand))
      (= right-type (. emitted type))
    )
    (let answer (call call-operator id fact lhs left left-type rhs right right-type))
    (if (and (!= plan .plan-call) (!= (. answer type) (. types bool-type)))
      (call refuse .refused-expression id)
    )
    (if (!= plan .plan-call)
      (= answer (call compare-zero id answer .compare-equal))
    )
    (if pair
      (let equal (call call-operator id second lhs left left-type rhs right right-type))
      (if (!= (. equal type) (. types bool-type))
        (call refuse .refused-expression id)
      )
      (if (== plan .plan-neither-call)
        (let combined
          (call bitwise
            (block
              (arg id)
              (arg .bitwise-and)
              (arg (. answer operand))
              (arg (. (call compare-zero id equal .compare-equal) operand))
              (arg u8-layout)
            )
          )
        )
        (= answer (call Typed combined (. types bool-type)))
        (else
          (= answer
            (call Typed
              (block
                (arg (call bitwise id .bitwise-or (. answer operand) (. equal operand) u8-layout))
                (arg (. equal type))
              )
            )
          )
        )
      )
    )
    (if (!= (. answer type) (call (. facts node-type) (. unit reading) id))
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (return answer)
  )
  (fn-do _ answering FactId
    (param fact FactId)
    ; The first call from one on that answers for a node's value: the calls that test a value as
    ; a condition are passed over.
    (let found fact)
    (while (!= found no-fact)
      (if (call answers-node (. ([] (. facts calls) found) form))
        (return found)
      )
      (= found (. ([] (. facts calls) found) next))
    )
    (return no-fact)
  )
  (fn-do _ call-operator Typed
    (param id SyntaxId)
    (param fact FactId)
    (param lhs SyntaxId)
    (param left Operand)
    (param left-type TypeId)
    (param rhs SyntaxId)
    (param right Operand)
    (param right-type TypeId)
    ; One call recorded for an operator, on operands already evaluated: the receiver is the left
    ; one, or the right one when the type pass exchanged them, and the other is the argument, in
    ; the type the function takes by the conversions recorded at it. An object of a class below
    ; the one that declares the function is given as it is. A function that raises answers with
    ; its value or an error, which leaves the function where the type pass says the call's errors
    ; do, as any call's.
    (let nothing (call make-operand .operand-void 0))
    (let row ([] (. facts calls) fact))
    (let callee (. row callee))
    (if (or (== callee no-instance) (. row is-partial) (not (call is-callable callee)))
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (if (or (!= (. ([] (. instances signatures) callee) args count) (if-expr (== rhs 0) 0 1)) swapped-unary)
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (lazy swapped-unary (and (. row is-swapped) (== rhs 0)))
    (let receiver (if-expr (. row is-swapped) right left))
    (let receiver-type (if-expr (. row is-swapped) right-type left-type))
    (if (!= (. row through count) 0)
      (let reached (call read-through id (call Typed receiver receiver-type) (. row through)))
      (= receiver (. reached operand))
      (= receiver-type (. reached type))
    )
    (let self (. ([] (. instances rows) callee) self-type))
    (if (and (!= receiver-type self) (not (and (call (. tables is-class) receiver-type) (call descends receiver-type self))))
      (call refuse .refused-conversion id)
      (return (call Typed nothing no-type))
    )
    (let mark (. pending length))
    (+= pending receiver)
    (if (!= rhs 0)
      (let site (if-expr (. row is-swapped) lhs rhs))
      (let argument
        (call convert
          (block
            (arg site)
            (arg .reason-argument)
            (arg (if-expr (. row is-swapped) (call Typed left left-type) (call Typed right right-type)))
          )
        )
      )
      (if (!= (. argument type) (call (. instances argument-type) callee 0))
        (call refuse .refused-conversion site)
      )
      (+= pending (. argument operand))
    )
    (let raising (!= (. ([] (. instances signatures) callee) errors count) 0))
    (= takes-result raising)
    (let answer (call call-method callee id mark))
    (= takes-result false)
    (if (and raising (. row propagates))
      (= answer (call propagate id callee (. answer operand)))
    )
    (return answer)
  )
  (fn-do _ settled SharedArm
    (param arm SyntaxId)
    (param start U32)
    (param result Operand)
    (param result-type TypeId)
    (let kept start)
    (let carried result)
    (let carried-type result-type)
    (let end (as (. match-steps length) U32))
    (for (in position (..< start end))
      (let step ([] match-steps position))
      (if (is ([] (. tree nodes) (. step pattern)) .node-type-wildcard)
        (if (. step carries)
          (= carried (. step subject))
          (= carried-type (. step type))
        )
        (continue)
      )
      (= ([] match-steps kept) step)
      (+= kept 1)
    )
    (while (> (. match-steps length) kept)
      (call (. match-steps pop))
    )
    (return (call SharedArm arm start (- kept start) carried carried-type))
  )
  (fn-expr _ next-call FactId
    (param fact FactId)
    (if-expr (!= fact no-fact) (. ([] (. facts calls) fact) next) no-fact)
  )
  (fn-expr _ may-grow Bool
    (param stream-type TypeId)
    ; Whether a stream of a type may give more input as a pattern reads it: any but an
    ; `ArrayTokenStream` or an `IndexableTokenStream`, whose buffer holds all of it.
    (and (not (call same-decl ref (. types array-token-stream-decl))) (not (call same-decl ref (. types indexable-token-stream-decl))))
    (where
      (lazy ref (call class-ref types stream-type))
    )
  )
  (fn-do _ parameter-default SyntaxId
    (param callee InstanceId)
    (param position U32)
    ; The default a parameter of a function is written with, or none.
    (let row ([] (. instances rows) callee))
    (match? ([] (. ([] (. program modules) (. row module)) decls) (. row decl))
      (case (call .decl-function fn)
        (if (< position (. fn args count))
          (return (. ([] (. ([] (. program modules) (. row module)) arg-pool) (+ (. fn args start) position)) default-syntax))
        )
      )
    )
    (return 0)
  )
  (fn-do _ emit-arm Bool (?! Refused)
    (param run StreamRun)
    (param id SyntaxId)
    (param result TypeId)
    (param from Operand)
    (param whole Bool)
    (param end LocalId)
    (param joined IRBlockId)
    (param slot Operand)
    (param failed IRBlockId)
    (param entered LocalId (= no-local))
    (param unread Bool (= false))
    ; One arm of a grammar, tried from a cursor. An arm with no pattern reads nothing and
    ; always passes. An arm that runs an expression binds `it` to the text its pattern matched, or
    ; to what a rule its pattern calls gave, where the expression reads it, or to the span of what
    ; it matched where the type pass kept `it` as one, and `location` to where
    ; its pattern began and ended, or with no pattern to where it is tried; one that only matches
    ; gives that text or that value. An action the reference runs in a function of its own, where
    ; a call may panic, has no shape here. One the type pass found asks for a rollback mark asks
    ; for it before its expression runs. Where it passes, the arms hold the rollback mark they held
    ; before it, where `entered` kept one. Where functions the expression makes read `it` or a
    ; name the pattern captures, its value is kept in the environment too, as the arm begins
    ; (`keep-arm-captures`). Where the input must be read whole, an arm whose pattern leaves some
    ; unread fails as its pattern does. Whether the arm reaches the join.
    (match? ([] (. tree nodes) id)
      (case .node-stream-panic
        (call emit-stream-raise run id failed)
        (return false)
      )
      (case (call .node-stream-transform row)
        (if (and (!= (. row pattern) 0) (call (. tree lazies-only) (. row right)))
          (return
            (call emit-bare-arm
              (block
                (arg run)
                (arg id)
                (arg result)
                (arg from)
                (arg whole)
                (arg end)
                (arg joined)
                (arg slot)
                (arg failed)
                (arg entered)
                (arg unread)
              )
            )
          )
        )
        (let finish from)
        (let given (call make-operand .operand-void 0))
        (let given-type no-type)
        (if (!= (. row pattern) 0)
          (let part (call lowered-part (. row pattern)))
          (let missed (call observed-failure part from (call observed-failure id from failed)))
          (let reached (call emit-stream-node run part from missed))
          (= finish (. reached ending))
          (= given (. reached value operand))
          (= given-type (. reached value type))
          (if whole
            (call stream-whole run id finish missed)
          )
        )
        (if (call (. facts is-marking-arm) (. unit reading) id)
          (call ensure-mark id)
        )
        (let named (. bound length))
        (let it-slot (call arm-slot-of id .slot-it))
        (let located (call location-fact id))
        (let first (call (. facts first-call) (. unit reading) id))
        (let spans-it (call (. facts spanning-it) (. unit reading) id))
        (if (!= spans-it no-type)
          (let span (call source-span run id from finish spans-it))
          (if (== it-slot no-slot)
            (call refuse .refused-expression id)
          )
          (call bind-it it-slot (. span operand) spans-it id)
          (else-if (and (!= (. row pattern) 0) (call gives-value (. row pattern)))
            (if (== given-type no-type)
              (call refuse .refused-expression id)
              (return false)
            )
            (if (!= it-slot no-slot)
              (call bind-it it-slot given given-type id)
            )
          )
          (else-if (or (and (!= first no-fact) (!= first located)) (!= (call material-at id .material-text) (. U32 max)))
            (let text (call stream-text run id from finish))
            (let text-type (. text type))
            (if (== it-slot no-slot)
              (call refuse .refused-expression id)
            )
            (call bind-it it-slot (. text operand) text-type id)
          )
        )
        (if (!= located no-fact)
          (call bind-location run id located from finish (!= (. row pattern) 0))
        )
        (call bind-materials run id)
        (if (!= (. row pattern) 0)
          (call keep-arm-captures (. row pattern))
        )
        (let outlined (== (call (. facts plan-of) (. unit reading) id) .plan-outlined-panic))
        (let remade (call material-at id .material-result))
        (if (and outlined (!= remade (. U32 max)))
          (call refuse .refused-expression id)
        )
        (let value
          (block
            (case? outlined
              (call action-call id result)
            )
            (default
              (call arm-value id (. row right) result false no-type remade)
            )
          )
        )
        (call drop-bound named)
        (if (call (. facts is-spanning-arm) (. unit reading) id)
          (= value (call source-span run id from finish result))
        )
        (call pass-marks entered id)
        (call store-local end finish id)
        (call arrive id (. value operand) joined slot)
        (return true)
      )
    )
    (return (call emit-bare-arm run id result from whole end joined slot failed entered unread))
  )
  (fn-do _ stream-call StreamPart (?! Refused)
    (param run StreamRun)
    (param id SyntaxId)
    (param cursor Operand)
    (param failed IRBlockId)
    ; A call of a local rule, run where it is called, as the reference runs one: its arms are
    ; tried in turn from the cursor, as the arms of a match are but with no need to read the
    ; whole input, and the first that passes gives the call what it gave and where it ended.
    ; Where none passes, the call fails. The names the rule captures have their places while its
    ; arms are emitted. It keeps the farthest cursor a part of it failed at from the cursor it is
    ; called at, as the reference's call of it does, and the pattern then counts that as its own.
    ; A rule a module declares is called, but for one `inlined-rule` finds, which runs where it is
    ; called as `inline-rule-call` says; so is a function given the stream that is no rule,
    ; as `boundary-call` says, and a local rule the tables made a function of; one whose body is
    ; code runs it as `coded-call` says; one beside a match that calls itself runs where it is
    ; called, and a call of it from its own arms is as `adapter-call` says;
    ; one that calls itself and has none is refused. A call given collectors gives no value: one
    ; that runs the rule where it is called runs it with the lists the caller keeps for its names
    ; in place of the rule's own, cut back to what they held where the rule fails, and one of a
    ; function calls the function made for those collectors. Nor does one the type pass planned to
    ; give the text it matched. One run where it is called begins holding no rollback mark, as
    ; `enter-marks` says, and gives back the one it holds where it fails. Under a helper that
    ; observes literal words, it tells it of them only where `observes-literals` says its pattern
    ; holds any.
    (let pattern (call rule-pattern id))
    (let result (call (. facts node-type) (. unit reading) id))
    (if (or (== result no-type) (== result invalid-type))
      (call refuse .refused-expression id)
      (return (call bare-part cursor))
    )
    (if (== (call (. facts plan-of) (. unit reading) id) .plan-pattern-call)
      (return (call pattern-call run id id cursor failed))
    )
    (let mappings (call (of RowRange SyntaxId)))
    (match? ([] (. tree nodes) id)
      (case (call .node-stream-call row)
        (= mappings (. row collector-mappings))
      )
    )
    (let mapped (!= (. mappings count) 0))
    (let spanned (== (call (. facts plan-of) (. unit reading) id) .plan-span-call))
    (let coded (call coded-rule id))
    (if (!= coded 0)
      (if (or mapped spanned)
        (call refuse .refused-expression id)
        (return (call bare-part cursor))
      )
      (return (call coded-call run id coded result cursor failed))
    )
    (if (and (== pattern 0) (not mapped) (!= (call next-call (call (. facts first-call) (. unit reading) id)) no-fact))
      (return (call boundary-call run id result cursor failed))
    )
    (if (and (== pattern 0) (not mapped))
      (let inlined (call inlined-rule run id result spanned))
      (if (!= (. inlined pattern) 0)
        (return (call inline-rule-call run id inlined cursor failed spanned))
      )
    )
    (if (== pattern 0)
      (return (call rule-call run id result cursor failed mappings spanned))
    )
    (let declaration (call rule-declaration id))
    (let adapter (call (. tables rule-adapter-of) (. unit reading) declaration))
    (if (and (!= adapter no-function) (!= (call (. inlining find) declaration) null))
      (if (or mapped spanned)
        (call refuse .refused-expression id)
        (return (call bare-part cursor))
      )
      (return (call adapter-call run id adapter declaration result cursor failed))
    )
    (let helper
      (match adapter
        (case= no-function
          (call (. tables lazy-rule-of) (. unit reading) declaration)
        )
        (default
          no-function
        )
      )
    )
    (if (and (!= helper no-function) mapped)
      (let variant
        (call (. tables mapped-rule-of)
          (block
            (arg (. unit reading))
            (arg declaration)
            (arg (call (. tables mapping-names) tree mappings))
          )
        )
      )
      (if (== variant no-function)
        (call refuse .refused-expression id)
        (return (call bare-part cursor))
      )
      (return
        (call lazy-rule-call
          (block
            (arg run)
            (arg id)
            (arg variant)
            (arg (call (. facts node-type) (. unit reading) pattern))
            (arg cursor)
            (arg failed)
            (arg mappings)
          )
        )
      )
    )
    (if (!= helper no-function)
      (return (call lazy-rule-call run id helper result cursor failed mappings spanned))
    )
    (if (and (call (. facts is-recursive-rule) (. unit reading) declaration) (== adapter no-function))
      (call refuse .refused-expression id)
      (return (call bare-part cursor))
    )
    (if (or mapped spanned)
      (= result (call (. facts node-type) (. unit reading) pattern))
    )
    (let layout (call layout-of result id))
    (let end (call (. ir add-local) (. run index-layout)))
    (let joined (call (. ir reserve-block)))
    (let slot (call join-slot layout))
    (let mark (. joins length))
    (let held (. bound length))
    (let captured (. stream-captures length))
    (let outer (call load-local (. run error) id))
    (call store-local (. run error) cursor id)
    (let missed (call (. ir reserve-block)))
    (let marks (call borrow-levels id mappings))
    (let entered (call enter-marks id))
    (let own-streaming streaming)
    (= streaming (= (. streaming capture-floor) (as captured U32)))
    (call hold-captures run pattern)
    (= streaming own-streaming)
    (call (. borrows clear))
    (call plan-choices pattern)
    (+= inlining declaration)
    (if (not (call observes-literals tree facts (. unit reading) pattern))
      (= streaming (= (. streaming observer-row) (. U32 max)))
    )
    (let arrives
      (call emit-stream-arms
        (block
          (arg run)
          (arg pattern)
          (arg result)
          (arg cursor)
          (arg false)
          (arg end)
          (arg joined)
          (arg slot)
          (arg missed)
          (arg (or mapped spanned))
        )
      )
    )
    (= streaming own-streaming)
    (call stop-inlining declaration)
    (call drop-bound held)
    (call drop-captures captured)
    (if (not arrives)
      (call drop-joins mark)
      (call refuse .refused-expression id)
      (return (call bare-part cursor))
    )
    (call (. ir start-block) missed)
    (call rewind-levels marks id)
    (call fail-marks entered id)
    (call record-error run id outer)
    (call jump failed)
    (let value (call close-joins joined mark layout slot))
    (call pass-marks entered id)
    (call record-error run id outer)
    (let ending (call load-local end id))
    (if (or mapped spanned)
      (return (call StreamPart ending (call spanned-value run id spanned cursor ending)))
    )
    (return (call StreamPart ending (call Typed value result)))
  )
  (fn-do _ stop-inlining _
    (param rule SyntaxId)
    ; Ends the running of a local rule where it is called, as the reference ends it: the rule is
    ; no longer one being run, however many runs of it this one is inside.
    (let kept 0)
    (for (in position (..< 0 (. inlining length)))
      (if (!= ([] inlining position) rule)
        (= ([] inlining kept) ([] inlining position))
        (+= kept 1)
      )
    )
    (while (!= (. inlining length) kept)
      (call (. inlining pop))
    )
  )
  (fn-do _ open-marks _
    (param body SyntaxId)
    ; Gives a body of a grammar that the type pass found holds a rollback mark the local
    ; that holds it, which holds none as the body begins. A body that holds none has no such local,
    ; nor has one whose marks no arm of the program asks a helper for: it would never hold one.
    ; What emits a body inside another sets the other's aside.
    (let row (call (. facts rollback-body-of) (. unit reading) body))
    (= streaming (= (. streaming rollback-row) row))
    (= streaming (= (. streaming rollback-mark) no-local))
    (if (or (== row (. U32 max)) (not (call (. facts asks-mark) (. ([] (. facts rollback-bodies) row) held))))
      (return)
    )
    (let layout (call layout-of (. ([] (. facts rollback-bodies) row) kept) body))
    (= streaming (= (. streaming rollback-mark) (call (. ir add-local) layout)))
    (call store-local (. streaming rollback-mark) (. (call no-mark body) operand) body)
  )
  (fn-do _ rewind-mark _
    (param site SyntaxId)
    ; Gives the helper back the rollback mark the part being emitted holds, where it holds one, which
    ; undoes what the actions since it was asked for did.
    (if (== (. streaming rollback-mark) no-local)
      (return)
    )
    (let row ([] (. facts rollback-bodies) (. streaming rollback-row)))
    (let held (call (. ir reserve-block)))
    (let done (call (. ir reserve-block)))
    (let mark (call load-local (. streaming rollback-mark) site))
    (call branch (call holds-mark mark site) held done)
    (call (. ir start-block) held)
    (let given mark)
    (if (!= (. row kept) (. row held))
      (= given (. (call payload site (call Typed mark (. row kept))) operand))
    )
    (call call-protocol
      (block
        (arg site)
        (arg (. row rewind))
        (arg (. streaming pattern-helper))
        (arg (. streaming pattern-helper-type))
        (arg given)
        (arg (. row held))
      )
    )
    (call jump done)
    (call (. ir start-block) done)
  )
  (fn-expr _ helper-marks Bool
    (param helper TypeId)
    ; Whether the functions of patterns given to a rule under a helper give the rollback mark they
    ; hold: where the helper can roll back, and some arm of the program asks a helper for a mark
    ; of its type.
    (and (!= helper no-type) (!= held no-type) (call (. facts asks-mark) held))
    (where
      (lazy held (call helper-mark-type types helper))
    )
  )
  (fn-expr _ carries Bool
    (param rule InstanceId)
    ; Whether a rule's function gives the rollback mark its pattern holds as it passes: where the
    ; type pass found the pattern holds one, and some arm of the program asks a helper for a mark
    ; of that type.
    (case? (not (. ([] (. instances rows) rule) carries-mark))
      false
    )
    (default
      (or (== body (. U32 max)) (call (. facts asks-mark) (. ([] (. facts rollback-bodies) body) held)))
    )
    (where
      (lazy body
        (call (. facts rollback-body-of)
          (block
            (arg rule)
            (arg (call rule-match program (. ([] (. instances rows) rule) module) (. ([] (. instances rows) rule) decl)))
          )
        )
      )
    )
  )
  (fn-do _ give-mark _
    (param site SyntaxId)
    ; Keeps the rollback mark a rule's pattern holds as it passed where its caller said to.
    (let layout (. ([] (. ir locals) (. streaming rollback-mark)) layout))
    (if (call (. tables layouts is-struct) layout)
      (call copy (. streaming marked-argument) (call load-local (. streaming rollback-mark) site) layout false site)
      (else
        (call store (. streaming marked-argument) 0 (call load-local (. streaming rollback-mark) site) false site)
      )
    )
  )
  (fn-do _ read-layout LayoutId
    (param run StreamRun)
    (param id SyntaxId)
    ; The layout of an item a part of a pattern reads as a value: a character where the buffer is
    ; UTF-8, and else the buffer's item.
    (return (if-expr (call encodes run) (call layout-of (call (. types type-row) .char) id) (. run item-layout)))
  )
  (fn-do _ shifted Operand
    (param id SyntaxId)
    (param value Operand)
    (param shift U64)
    (param layout LayoutId)
    (return (call bitwise id .bitwise-shift-left value (call integer (. ([] (. tables layouts rows) layout) kind) shift) layout))
  )
  (fn-do _ arm-slot-of SlotId
    (param arm SyntaxId)
    (param kind SlotKind)
    ; The slot of a kind, `it` or `location`, that an arm of a match or a pattern that is a
    ; condition declares, or none.
    (let binding (. ([] (. instances rows) (. unit reading)) binding))
    (if (or (== binding no-binding) (!= (. unit reading) (. unit instance)))
      (return no-slot)
    )
    (let slots (. ([] (. bindings bindings) binding) slots))
    (for (in offset (..< 0 (. slots count)))
      (let slot (+ (. slots start) offset))
      (let row ([] (. bindings slots) slot))
      (if (and (== (. row kind) kind) (== (. row syntax) arm))
        (return slot)
      )
    )
    (return no-slot)
  )
  (fn-do _ drop-bound _
    (param mark Size)
    (while (> (. bound length) mark)
      (call (. bound pop))
    )
  )
  (fn-do _ is-bound Bool
    (param slot SlotId)
    (for (in row bound)
      (if (== (. row slot) slot)
        (return true)
      )
    )
    (return false)
  )
  (fn-do _ read-bound Typed
    (param slot SlotId)
    (param id SyntaxId)
    (param type TypeId)
    ; What a name a pattern bound holds where it is read: the value captured, or for `it` what
    ; the pattern was given or passed. Where the type pass narrowed the name, the read is of
    ; what it holds, as a local's is.
    (let nothing (call make-operand .operand-void 0))
    (let position (. bound length))
    (while (!= position 0)
      (-= position 1)
      (let row ([] bound position))
      (if (!= (. row slot) slot)
        (continue)
      )
      (if (!= (. row capture) (. U32 max))
        (return (call read-capture id (. row capture) type))
      )
      (if (!= (. row cursor) (. U32 max))
        (return (call gather-cursor id (. row cursor) type))
      )
      (if (== (. row type) type)
        (return (call Typed (. row value) type))
      )
      (if (!= shared-depth 0)
        (call refuse .refused-expression id)
        (return (call Typed nothing no-type))
      )
      (if (== (call (. facts plan-of) (. unit reading) id) .plan-case-read)
        (return (call read-case id (. row value) (. row type) type))
      )
      (if (call holds (. row type) type)
        (return (call payload id (call Typed (. row value) (. row type))))
      )
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (call refuse .refused-expression id)
    (return (call Typed nothing no-type))
  )
  (fn-do _ bind-name _
    (param name SyntaxId)
    (param value Typed)
    ; Gives a name a pattern declares the value it captured. The name holds that value and no
    ; cell, since nothing assigns it, or, where nested functions capture it, the place the
    ; environment that holds it has for it. One the program tracks has no shape here. A pattern
    ; that only tests binds nothing. The name of a pattern a declaration
    ; is written with is a local: it gets its cell here, and the value is stored there, or in
    ; the environment of a function that yields, which keeps its locals from step to step.
    (if (. matching testing)
      (return)
    )
    (let binding (. ([] (. instances rows) (. unit reading)) binding))
    (if (or (== binding no-binding) (!= (. unit reading) (. unit instance)))
      (call refuse .refused-expression name)
      (return)
    )
    (let resolution (call (. bindings resolution-of) binding name))
    (if (!= (. resolution kind) .resolve-slot)
      (call refuse .refused-expression name)
      (return)
    )
    (let row ([] (. bindings slots) (. resolution slot)))
    (let unkept (/or/ (. SlotFlag slot-captured) (. SlotFlag slot-tracked)))
    (if (. matching declaring)
      (let type (. value type))
      (let place (call slot-offset (. resolution slot) name))
      (let layout (call layout-of type name))
      (let item (== (. row kind) .slot-loop-item))
      (if (or (and (!= (. row kind) .slot-local) (not item)) (and (not item) (!= (/and/ (. row flags) unkept) 0)))
        (call refuse .refused-statement name)
        (return)
      )
      (if (!= (call (. facts slot-type) (. unit instance) place) type)
        (call refuse .refused-conversion name)
        (return)
      )
      (if (call is-captured (. resolution slot))
        (call keep-captured (. resolution slot) (. value operand) type name)
        (else-if (!= layout void-layout)
          (= ([] (. unit cells) place) (call (. ir add-local) layout (!= (/and/ (. row flags) (. SlotFlag slot-address-taken)) 0)))
          (call store-local ([] (. unit cells) place) (. value operand) name)
        )
      )
      (return)
    )
    (if (!= (. row kind) .slot-pattern)
      (call refuse .refused-expression name)
      (return)
    )
    (let offset (call slot-offset (. resolution slot) name))
    (if (!= (call (. facts slot-type) (. unit instance) offset) (. value type))
      (call refuse .refused-conversion name)
      (return)
    )
    (if (call is-captured (. resolution slot))
      (call keep-captured (. resolution slot) (. value operand) (. value type) name)
      (return)
    )
    (+= bound (call BoundValue (. resolution slot) (. value type) (. value operand)))
  )
  (fn-do _ member-machine (? MachineFact)
    (param module ModuleId)
    (param value SyntaxId)
    ; The state machine a property of a class holds, by the property's value, or none.
    (for (in machine (. facts machines))
      (if (and (== (. machine store) .store-member) (== (. machine module) module) (== (. machine syntax) value))
        (return machine)
      )
    )
    (return null)
  )
  (fn-do _ call-at FactId
    (param site SyntaxId)
    (param form CallForm)
    ; The first call of a form that the type pass recorded at a node, or none.
    (let fact (call (. facts first-call) (. unit reading) site))
    (while (and (!= fact no-fact) (!= (. ([] (. facts calls) fact) form) form))
      (= fact (. ([] (. facts calls) fact) next))
    )
    (return fact)
  )
  (fn-do _ close-joins Operand
    (param joined IRBlockId)
    (param mark Size)
    (param layout LayoutId)
    (param slot Operand)
    ; Starts the block the sides of a join arrive in, and gives the value they left: one of them
    ; by the block each ended in, or for a struct the memory each copied its own into.
    (call (. ir start-block) joined)
    (if (!= (call operand-kind slot) .operand-void)
      (call drop-joins mark)
      (return slot)
    )
    (let start U32 (. ir operands length))
    (for (in position (..< mark (. joins length)))
      (call (. ir add-operand) ([] joins position))
    )
    (call drop-joins mark)
    (let count U32 (- (. ir operands length) start))
    (return (call make-operand .operand-value (call append .op-phi 0 (call Span start count) 0 layout)))
  )
  (fn-do _ join-slot Operand
    (param layout LayoutId)
    ; Where the sides of a join leave a struct: memory in the frame that each copies its value
    ; into. Any other value needs none, and is joined by the block each side ends in.
    (if (call (. tables layouts is-struct) layout)
      (return (call frame layout))
    )
    (return (call make-operand .operand-void 0))
  )
  (fn-do _ arrive _
    (param site SyntaxId)
    (param value Operand)
    (param joined IRBlockId)
    (param slot Operand)
    ; Leaves the value of one side for its join, and goes there.
    (if (!= (call operand-kind slot) .operand-void)
      (call copy slot value (call (. ir operand-layout) slot) false site)
      (else
        (+= joins value)
        (+= joins (call make-operand .operand-block (. ir current)))
      )
    )
    (call jump joined)
  )
  (fn-do _ emit-choice Typed
    (param id SyntaxId)
    (param chosen SyntaxId)
    (param condition SyntaxId)
    (param other SyntaxId)
    ; `if condition then chosen else other`: the condition is tested, and only the side it picks is
    ; evaluated. Each side arrives in the type of the whole by the conversion recorded for a side
    ; of its type.
    (let nothing (call make-operand .operand-void 0))
    (let type (call (. facts node-type) (. unit reading) id))
    (let layout (call layout-of type id))
    (let tested (call test id (call emit-expression condition) true false))
    (let taken (call (. ir reserve-block)))
    (let passed (call (. ir reserve-block)))
    (let joined (call (. ir reserve-block)))
    (let slot (call join-slot layout))
    (let mark (. joins length))
    (call branch (. tested operand) taken passed)
    (call (. ir start-block) taken)
    (call emit-arm id chosen type joined slot)
    (call (. ir start-block) passed)
    (call emit-arm id other type joined slot)
    (return (call Typed (call close-joins joined mark layout slot) type))
  )
  (fn-do _ emit-choice Typed
    (param control SyntaxId)
    (param name Atom)
    (let nothing (call Typed (call make-operand .operand-void 0) no-type))
    (let fact (call (. facts slot-choice-of) (. unit reading) (call (. tree chosen-line) control name)))
    (if (not fact)
      (call refuse .refused-expression control)
      (return nothing)
    )
    (let arms (call (. tree region-arms) control))
    (let index-kind (as (call layout-of (. types index-type) control) MachineKind))
    (let anchor (call (. tree selector-anchor) control))
    (let selector (call convert anchor .reason-markup-slot (call emit-closure anchor (. fact selector))))
    (let mark (. pending length))
    (+= pending (. selector operand))
    (+= pending (call integer index-kind (as (. arms length) U64)))
    (let choice (call call-instance (. fact create) control mark))
    (let held (call (. ir add-local) managed-layout))
    (call store-local held (. choice operand) control)
    (for (in position (..< 0 (. arms length)))
      (match? ([] (. tree nodes) (call (. tree region-arm-body) ([] arms position)))
        (case (call .node-block block)
          (for (in line ([] (. tree children) (. block body)))
            (match? ([] (. tree nodes) line)
              (case (call .node-markup row)
                (if (== (call (. tree identifier-name) (. row slot-binding)) name)
                  (let built (call builder-value line))
                  (let filling (. pending length))
                  (+= pending (call load-local held control))
                  (+= pending (call integer index-kind (as position U64)))
                  (+= pending (. built operand))
                  (do
                    (inline (call call-instance (. fact fill) line filling))
                  )
                )
              )
            )
          )
        )
      )
    )
    (return (call Typed (call load-local held control) (. fact choice)))
  )
  (fn-do _ emit-arm _ (?! Refused)
    (param site SyntaxId)
    (param body SyntaxId)
    (param type TypeId)
    (param joined IRBlockId)
    (param slot Operand)
    (param guards Bool (= false))
    ; The value of one arm, converted as the match records for a side of its type, left for the
    ; match with the block the arm ends in. With `guards` an error is a value where the type of the
    ; match holds it, and has no shape where that type carries errors. With no type the arm is run
    ; for what it does.
    (if (== type no-type)
      (call emit-block body)
      (call jump joined)
      (return)
    )
    (let value (call arm-value site body type guards type (. U32 max) (!= (call operand-kind slot) .operand-void)))
    (call arrive site (. value operand) joined slot)
  )
  (fn-do _ ending SyntaxId
    (param body SyntaxId)
    ; The expression a body ends in, which gives the body its value, once the statements a block
    ; holds before it have run in order. None where a block holds no statement.
    (call clear-turn-lazies body)
    (call raise-elements body)
    (let last body)
    (match? ([] (. tree nodes) body)
      (case (call .node-block block)
        (= last 0)
        (for (in statement ([] (. tree children) (. block body)))
          (if (or (not (call runs-in-body statement)) (call is-lazy-local statement))
            (continue)
          )
          (if (!= last 0)
            (call emit-statement last)
          )
          (= last statement)
        )
      )
    )
    (return last)
  )
  (fn-do _ emit-block-value Typed
    (param id SyntaxId)
    (param type TypeId)
    ; A block written as a value: the assertions and declarations under it run, then its
    ; expression gives the value. It is a block of its own: the cleanups its declarations open run
    ; where it ends, after a struct is copied out of what they may change. A `use` its expression
    ; opens gives the value, and is handed to the block around, with what was opened before it, to
    ; end where that block ends, as it would without this one.
    (let mark (. open-cleanups length))
    (let own-scoping scoping)
    (= scoping (= (. scoping block-base) mark))
    (= scoping (= (. scoping giving) false))
    (call clear-turn-lazies id)
    (call raise-elements id)
    (let only (call checked-expression id))
    (if (== only 0)
      (call refuse .refused-expression id)
    )
    (= scoping (= (. scoping giving) true))
    (= scoping (= (. scoping giving-lazies) (. lazy-open length)))
    (let emitted (call emit-expression only))
    (if (and (!= type no-type) (!= (. emitted type) type))
      (call refuse .refused-conversion id)
    )
    (let kept (call given-top mark))
    (let value (call close-value emitted kept own-scoping id))
    (call hand-on-cleanups mark kept)
    (return value)
  )
  (fn-do _ close-value Typed
    (param value Typed)
    (param mark Size)
    (param outer Scoping)
    (param id SyntaxId)
    ; Ends a block written as a value, which began with the cleanups up to `mark` open, in a block
    ; whose cleanups begin where `outer` says. The cleanups it opened run here, after a struct is copied
    ; out of what they may change.
    (let kept value)
    (let given (. kept type))
    (if (!= (. open-cleanups length) mark)
      (if (and (!= given no-type) (!= given (. types void-type)))
        (let layout (call layout-of given id))
        (if (call (. tables layouts is-struct) layout)
          (= kept (call Typed (call snapshot (. value operand) layout id) (. kept type)))
        )
      )
      (call close-cleanups mark)
    )
    (= scoping outer)
    (return kept)
  )
  (fn-do _ emit-leading SyntaxId
    (param body SyntaxId)
    ; Runs in order the statements of a block written as a value but its last, and gives the
    ; last, whose value is the block's. A lazy local, which emits nothing where it is declared, is
    ; none of them. None where the block runs no statement.
    (let last SyntaxId 0)
    (match? ([] (. tree nodes) body)
      (case (call .node-block block)
        (for (in statement ([] (. tree children) (. block body)))
          (if (or (not (call runs-in-body statement)) (call is-lazy-local statement))
            (continue)
          )
          (if (!= last 0)
            (call emit-statement last)
          )
          (= last statement)
        )
      )
    )
    (return last)
  )
  (fn-do _ only-expression SyntaxId
    (param body SyntaxId)
    ; The expression a body stands for: itself, or the one statement of a block that holds
    ; nothing else but lazy locals, which emit nothing where they are declared. A block of more
    ; has none.
    (match? ([] (. tree nodes) body)
      (case (call .node-block block)
        (let found SyntaxId 0)
        (for (in statement ([] (. tree children) (. block body)))
          (if (call is-lazy-local statement)
            (continue)
          )
          (if (!= found 0)
            (return 0)
          )
          (= found statement)
        )
        (return found)
      )
    )
    (return body)
  )
  (fn-do _ checked-expression SyntaxId
    (param body SyntaxId)
    ; The expression a block gives its value by, once the assertions and the declarations written
    ; under it have run, which they do here in their order: the last statement of a block that
    ; holds nothing else but those and lazy locals, which emit nothing where they are declared. A
    ; block of anything else has none.
    (let last SyntaxId 0)
    (match? ([] (. tree nodes) body)
      (case (call .node-block block)
        (for (in statement ([] (. tree children) (. block body)))
          (if (call is-lazy-local statement)
            (continue)
          )
          (if (!= last 0)
            (if (and (not (call (. tree is-assertion) last)) (not (is ([] (. tree nodes) last) .node-declare)))
              (return 0)
            )
            (call emit-statement last)
          )
          (= last statement)
        )
      )
    )
    (return (if-expr (or (== last 0) (call (. tree is-assertion) last) (is ([] (. tree nodes) last) .node-declare)) 0 last))
  )
  (fn-do _ declares-getter Bool
    (param left SyntaxId)
    ; Whether a declaration declares a local of a row of a markup loop region that is read as a
    ; getter: its value is made where it is read.
    (let binding (. ([] (. instances rows) (. unit reading)) binding))
    (if (== binding no-binding)
      (return false)
    )
    (match? ([] (. tree nodes) left)
      (case (call .node-type-capture capture)
        (let resolution (call (. bindings resolution-of) binding (. capture id)))
        (return (and (== (. resolution kind) .resolve-slot) (!= (. ([] (. bindings slots) (. resolution slot)) getter) 0)))
      )
    )
    (return false)
  )
  (fn-do _ emit-getter Typed
    (param id SyntaxId)
    ; A read of a local of a row of a markup loop region read as a getter: the value its
    ; declaration writes, made here.
    (let resolution (call (. bindings resolution-of) (. ([] (. instances rows) (. unit reading)) binding) id))
    (match? ([] (. tree nodes) (. ([] (. bindings slots) (. resolution slot)) getter))
      (case (call .node-declare row)
        (return (call emit-expression (. row right)))
      )
    )
    (call refuse .refused-expression id)
    (return (call Typed (call make-operand .operand-void 0) no-type))
  )
  (fn-do _ join Typed
    (param site SyntaxId)
    (param value Typed)
    ; One side of a join in the type of the join: the conversion recorded at the join that
    ; starts at the side's type. Sides of one type convert alike, so the first such is taken. A
    ; lambda becomes its function first, and the conversions after that one take the function on.
    (let fact (call (. facts first-conversion) (. unit reading) site))
    (let result value)
    (let found false)
    (while (!= fact no-fact)
      (let row ([] (. facts conversions) fact))
      (if (and (== (. row reason) .reason-join) (== (. row from) (. result type)))
        (let lambda (== (call intrinsic (. result type)) .closure))
        (= result (call convert-one site row result))
        (= found true)
        (if (not lambda)
          (return result)
        )
      )
      (= fact (. row next))
    )
    (if (not found)
      (call refuse .refused-conversion site)
    )
    (return result)
  )
  (fn-do _ drop-joins _
    (param mark Size)
    (while (> (. joins length) mark)
      (call (. joins pop))
    )
  )
  (fn-do _ emit-concat Typed
    (param id SyntaxId)
    (param lhs SyntaxId)
    (param rhs SyntaxId)
    (param interpolated Bool)
    ; Joins two values as text: the function the type pass chose for the left one's type, called
    ; with the right one. An interpolation makes its left piece text before it evaluates the
    ; right one. `++` evaluates both first.
    (let left (call emit-expression lhs))
    (return (call join-text id lhs (. left operand) (. left type) rhs interpolated))
  )
  (fn-do _ join-text Typed
    (param id SyntaxId)
    (param lhs SyntaxId)
    (param given Operand)
    (param given-type TypeId)
    (param rhs SyntaxId)
    (param interpolated Bool)
    ; Joins text to a left value already evaluated as `lhs` gives it.
    (let nothing (call make-operand .operand-void 0))
    (let fact (call own-call id))
    (if (== fact no-fact)
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (let callee (. ([] (. facts calls) fact) callee))
    (let first
      (scope (if-expr interpolated (call convert id .reason-operator (call Typed given given-type)) (call Typed (call apart (call Typed given given-type) lhs disturbed) given-type))
        (lazy disturbed (not (call is-inert rhs)))
      )
    )
    (let left (. first operand))
    (let left-type (. first type))
    (let right (call emit-expression rhs))
    (let right-type (. right type))
    (if (not interpolated)
      (let converted (call convert id .reason-operator (call Typed left left-type)))
      (= left (. converted operand))
      (= left-type (. converted type))
    )
    (if (or (== callee no-instance) (!= left-type (. ([] (. instances rows) callee) self-type)))
      (call refuse .refused-conversion lhs)
      (return (call Typed nothing no-type))
    )
    (= right (call convert rhs .reason-argument (call Typed (. right operand) right-type)))
    (if (!= (. right type) (call (. instances argument-type) callee 0))
      (call refuse .refused-conversion rhs)
      (return (call Typed nothing no-type))
    )
    (let mark (. pending length))
    (+= pending left)
    (+= pending (. right operand))
    (return (call call-method callee id mark))
  )
  (fn-do _ emit-coalesce Typed
    (param id SyntaxId)
    (param lhs SyntaxId)
    (param rhs SyntaxId)
    ; The left value is kept unless it tests as empty, and then the right one is taken: a number
    ; is empty when it is zero, a C pointer when it points at nothing, and any other value when
    ; the function recorded as its test says so. The sides join as `close-joins` says, a struct in
    ; memory each copies its own into.
    (let nothing (call make-operand .operand-void 0))
    (let type (call (. facts node-type) (. unit reading) id))
    (let test (call truth-call id true false))
    (let left (call emit-expression lhs))
    (if (call (. types is-optional) (. left type))
      (return (call emit-fallback id left rhs type))
    )
    (if (== (. left type) (. types null-type))
      (let right (call emit-expression rhs))
      (if (!= (. right type) type)
        (= right (call join id right))
      )
      (if (!= (. right type) type)
        (call refuse .refused-conversion rhs)
      )
      (return right)
    )
    (let layout (call layout-of type id))
    (let held (. left type))
    (let held-layout (call layout-of held id))
    (let counts (and (== test no-fact) (call is-number layout) (or (== held type) (call is-number held-layout))))
    (let points
      (scope (and (== test no-fact) (!= held type) (call is-pointer held-layout) c-pointer)
        (lazy c-pointer (== (call intrinsic held) .cpointer))
      )
    )
    (if (and (not counts) (not points) (or (== test no-fact) (!= held type)))
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (let take-right (call (. ir reserve-block)))
    (let keep-left (call (. ir reserve-block)))
    (let joined (call (. ir reserve-block)))
    (let slot (call join-slot layout))
    (let sides (. joins length))
    (if (or counts points)
      (call branch (. (call truth lhs (call Typed (. left operand) held)) operand) keep-left take-right)
      (else
        (let callee (. ([] (. facts calls) test) callee))
        (if (or (== callee no-instance) (!= (. ([] (. instances rows) callee) self-type) type))
          (call refuse .refused-expression id)
          (return (call Typed nothing no-type))
        )
        (let mark (. pending length))
        (+= pending (. left operand))
        (let is-empty (call call-method callee id mark))
        (call branch (. is-empty operand) take-right keep-left)
      )
    )
    (call (. ir start-block) keep-left)
    (let kept left)
    (if (!= held type)
      (= kept (call join id (call Typed (. left operand) held)))
      (if (!= (. kept type) type)
        (call refuse .refused-conversion lhs)
      )
    )
    (call arrive id (. kept operand) joined slot)
    (call (. ir start-block) take-right)
    (let right (call emit-expression rhs))
    (if (!= (. right type) type)
      (= right (call join id right))
    )
    (if (!= (. right type) type)
      (call refuse .refused-conversion rhs)
    )
    (call arrive id (. right operand) joined slot)
    (return (call Typed (call close-joins joined sides layout slot) (. right type)))
  )
  (fn-do _ emit-fallback Typed
    (param id SyntaxId)
    (param left Typed)
    (param rhs SyntaxId)
    (param type TypeId)
    ; `a ?? b` where `a` is an optional: what it holds when it holds a value, and otherwise `b`,
    ; which is evaluated only then. Where `b` may hold nothing too, `a` is kept as the optional
    ; it is. Each side arrives in the type of the whole, by the conversion recorded for a side.
    (let nothing (call make-operand .operand-void 0))
    (let held (. left type))
    (let layout (call layout-of type id))
    (let tested (call present id left))
    (let keep (call (. ir reserve-block)))
    (let other (call (. ir reserve-block)))
    (let joined (call (. ir reserve-block)))
    (let slot (call join-slot layout))
    (let mark (. joins length))
    (call branch (. tested operand) keep other)
    (call (. ir start-block) keep)
    (let kept left)
    (if (!= held type)
      (= kept (call payload id (call Typed (. left operand) held)))
      (if (!= (. kept type) type)
        (= kept (call join id kept))
      )
    )
    (if (!= (. kept type) type)
      (call refuse .refused-conversion id)
    )
    (call arrive id (. kept operand) joined slot)
    (call (. ir start-block) other)
    (call emit-arm id rhs type joined slot)
    (return (call Typed (call close-joins joined mark layout slot) type))
  )
  (fn-do _ convert-matched Typed
    (param site SyntaxId)
    (param reason ConversionReason)
    (param value Typed)
    (param wanted TypeId)
    ; Applies the conversions recorded at a site for one reason that take a value of the type
    ; this one has, in order, until it has the type wanted. A site that keeps the conversions
    ; of several values is read so.
    (let result value)
    (let fact (call (. facts first-conversion) (. unit reading) site))
    (while (and (!= fact no-fact) (!= (. result type) wanted))
      (let row ([] (. facts conversions) fact))
      (let fits
        (scope (or (== (. row reason) reason) literal-return)
          (lazy literal-return (and (== reason .reason-return) (== (. row reason) .reason-literal-return)))
        )
      )
      (if (and fits (== (. row from) (. result type)))
        (= result (call convert-one site row result))
      )
      (= fact (. row next))
    )
    (return result)
  )
  (fn-do _ emit-relation Typed
    (param id SyntaxId)
    (param plan OperatorPlan)
    (param object SyntaxId)
    (param operands (of RowRange SyntaxId))
    ; A call the compiler answers itself, of the relation of two types:
    ; - `compare` of a type with another gives the relation. It is held as the text the type
    ;   pass recorded for it, which is all that can be asked of one when the program runs. The
    ;   two types are run first, as a type read for a constant is.
    ; - `cast` and `unify` of a relation give their argument, converted as the type pass
    ;   recorded at it. The relation is run first, for what its types do. A panic the
    ;   conversion raises is raised at the call.
    (let nothing (call make-operand .operand-void 0))
    (let type (call (. facts node-type) (. unit reading) id))
    (if (== plan .plan-relation)
      (let constant (call (. facts constant-of) (. unit reading) id))
      (if (or (== constant no-fact) (not (. ([] (. facts constants) constant) text)))
        (call refuse .refused-expression id)
        (return (call Typed nothing no-type))
      )
      (call run-type-operand object)
      (for (in operand ([] (. tree children) operands))
        (call run-type-operand (call (. tree argument-value) operand))
      )
      (return
        (call Typed
          (block
            (arg (call make-operand .operand-constant (call (. ir add-string) (. (!! (. ([] (. facts constants) constant) text)) text))))
            (arg type)
          )
        )
      )
    )
    (if (or (!= (. operands count) 1) (!= (call (. facts plan-of) (. unit reading) object) .plan-relation))
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (call emit-expression object)
    (let given ([] (. tree children) (. operands start)))
    (let raw (call convert given .reason-argument (call emit-expression (call (. tree argument-value) given))))
    (let value (call convert given .reason-relation raw id))
    (if (!= (. value type) type)
      (call refuse .refused-conversion id)
    )
    (return value)
  )
  (fn-do _ emit-get Typed
    (param id SyntaxId)
    (param object SyntaxId)
    (param name Atom)
    ; A name read from a value: a constant the type pass worked out, the address a pointer
    ; holds, a stored field the type pass named by its place, what the getter it recorded at the
    ; node answers, a field of a tuple or struct, or a stored property of an object. A union
    ; answers some names by itself, and others with the member each of its cases has. A field
    ; of the case of a row a name stands for is read from its cell, and a field of numbers of an
    ; item of an array an index reads as TypeScript reads one, which has no shape in a link of an
    ; optional chain. An event named on a value is made a `Broadcastable`. The flag of a domain a
    ; `MarkupBatchFlush` reports is its bit of the domains the flush left pending. `path` of a
    ; value of a state machine's union lists its active cases (`emit-machine-path`), and `unit` of
    ; a number is the name its type is written with, read after the number is.
    (if (== (call (. facts plan-of) (. unit reading) id) .plan-machine-path)
      (return (call emit-machine-path id object))
    )
    (let escaped (call escaped-event id))
    (if escaped
      (return (call emit-escape id escaped))
    )
    (let flag (call (. facts style-flag-of) (. unit reading) id))
    (if (and flag (== (. flag call) no-instance))
      (return (call flush-flag id object (call (. tables domain-number) (. flag domain))))
    )
    (if (and (!= object 0) (!= (call case-cursor-of object) (. U32 max)))
      (let cursor (call case-cursor-of object))
      (let field (call case-field cursor name))
      (if field
        (return (call emit-case-field id cursor field))
      )
    )
    (if (and plans-array-item (== (call (. types intrinsic-of) (call (. facts node-type) (. unit reading) object)) .struct))
      (if (call is-link id)
        (call refuse .refused-expression id)
        (return (call Typed (call make-operand .operand-void 0) no-type))
      )
      (match? ([] (. tree nodes) object)
        (case (call .node-index-expression row)
          (return (call emit-array-item object (. row object) (. row index) id name))
        )
      )
    )
    (lazy plans-array-item (and (!= object 0) (== (call (. facts plan-of) (. unit reading) object) .plan-array-item)))
    (let planned (call (. facts plan-of) (. unit reading) id))
    (if (== planned .plan-view)
      (return (call emit-view-get id object))
    )
    (if (and (== planned .plan-table) (== (call table-op id) (. TableOp table-field)))
      (return (call emit-table-field id object))
    )
    (if (== planned .plan-table)
      (let held (call emit-expression object))
      (let type (. held type))
      (return (call table-get id (. held operand) type))
    )
    (if (and (== planned .plan-none) (call is-binding (call (. facts node-type) (. unit reading) id)))
      (return (call name-binding id (call (. facts node-type) (. unit reading) id) object))
    )
    (if (== planned .plan-case-number)
      (return (call emit-case-number id object))
    )
    (if (or (== planned .plan-case-name) (== planned .plan-case-type))
      (return (call emit-case-text id object planned))
    )
    (if (== planned .plan-case-value)
      (return (call emit-case-value id object))
    )
    (if (== planned .plan-forward)
      (return (call emit-forward id object (call (of RowRange SyntaxId)) name))
    )
    (if (== planned .plan-unit-name)
      (let held (call emit-expression object))
      (return (call Typed (call unit-text (. held type)) (call (. facts node-type) (. unit reading) id)))
    )
    (if (or (== planned .plan-object-uid) (== planned .plan-property-subscribers))
      (return (call emit-object-member id object planned))
    )
    (if (== (call (. facts plan-of) (. unit reading) id) .plan-constant)
      (call run-type-operand object)
      (return (call Typed (call emit-constant id) (call (. facts node-type) (. unit reading) id)))
    )
    (if (== (call (. facts plan-of) (. unit reading) id) .plan-case)
      (call run-type-operand object)
      (return (call emit-case id (call (of RowRange SyntaxId)) false))
    )
    (if (== (call (. facts plan-of) (. unit reading) id) .plan-enum-value)
      (call run-type-operand object)
      (return (call read-enum id))
    )
    (if (== (call (. facts plan-of) (. unit reading) id) .plan-address)
      (let pointer (call emit-expression object))
      (return (call cast id pointer (call unlinked id)))
    )
    (if (== (call (. facts plan-of) (. unit reading) id) .plan-reinterpret)
      (return (call reinterpret id (call emit-expression object) (call unlinked id)))
    )
    (if (== (call (. facts plan-of) (. unit reading) id) .plan-field)
      (let held (call emit-object object))
      (return (call placed-field id (. held operand) (. held type) (call (. facts constant-of) (. unit reading) id)))
    )
    (if (== planned .plan-through)
      (let whole (call emit-expression object))
      (let held
        (call read-through
          (block
            (arg id)
            (arg (call Typed (. whole operand) (call held-type object)))
            (arg (call (. facts through-of) (. unit reading) id))
          )
        )
      )
      (return (call load-property id (. held operand) (. held type) name))
    )
    (let fact (call own-call id))
    (if (and (!= fact no-fact) (== (. ([] (. facts calls) fact) form) .call-getter))
      (return (call emit-fact-call id ([] (. facts calls) fact) object (call (of RowRange SyntaxId))))
    )
    (let owner (call held-type object))
    (if (and (!= owner no-type) (!= owner invalid-type) (== (call intrinsic owner) .type-info))
      (return (call emit-type-get id object))
    )
    (if (and (!= owner no-type) (!= owner invalid-type) property-owner)
      (let base (call emit-object object))
      (return (call load-property id (. base operand) owner name))
    )
    (lazy property-owner (or (call is-aggregate owner) (call (. tables is-class) owner) (call (. types is-optional) owner)))
    (call refuse .refused-expression id)
    (return (call Typed (call make-operand .operand-void 0) no-type))
  )
  (fn-do _ emit-object Typed
    (param object SyntaxId)
    ; The value a name is read from at once, before anything else is evaluated: a struct an index
    ; names past a pointer is read from where it lies, not copied.
    (let own-matching matching)
    (= matching (= (. matching read-in-place) object))
    (let value (call emit-expression object))
    (= matching own-matching)
    (return value)
  )
  (fn-do _ flush-flag Typed
    (param id SyntaxId)
    (param object SyntaxId)
    (param domain U32)
    (let held (call emit-expression object))
    (let owner (. held type))
    (let mask (call load-property id (. held operand) owner (call (. program store-atom) "pending-domain-mask") true))
    (let layout (call layout-of (. mask type) id))
    (let bit (call bitwise id .bitwise-and (. mask operand) (call integer .machine-u32 (/lshift/ 1u64 domain)) layout))
    (let set (call compare-zero id (call Typed bit (call (. types type-row) .uint32)) .compare-not-equal))
    (return (call Typed (. set operand) (. types bool-type)))
  )
  (fn-do _ emit-object-member Typed
    (param id SyntaxId)
    (param object SyntaxId)
    (param plan OperatorPlan)
    ; A member every object has: the `uid` its header holds, or the list of the subscribers of its
    ; properties, made and published in lane 0 where it has none yet.
    (let held (call emit-expression object))
    (let owner (. held type))
    (if (== plan .plan-property-subscribers)
      (if (== (. instances live subscribers) no-instance)
        (call refuse .refused-expression id)
        (return held)
      )
      (return (call side-list id (. held operand) 0 (. instances live subscribers)))
    )
    (if (or (not (call (. tables is-class) owner)) (== ([] (. tables layouts objects) owner) no-layout))
      (call refuse .refused-expression id)
      (return held)
    )
    (return
      (call Typed
        (block
          (arg
            (call load
              (block
                (arg (. held operand))
                (arg (. (call (. tables layouts field) ([] (. tables layouts objects) owner) 1) offset))
                (arg u32-layout)
                (arg id)
              )
            )
          )
          (arg (call (. facts node-type) (. unit reading) id))
        )
      )
    )
  )
  (fn-do _ emit-type-get Typed
    (param id SyntaxId)
    (param object SyntaxId)
    ; What a type given as a value answers that the type pass worked out no constant for, as it
    ; planned the node: the name or the key of the class an object was constructed as, read from
    ; the value, the base of the type, which is the base of the type the value is held as, the
    ; size of the type, which is the bytes its layout holds a value in, the name or the key of
    ; the type the value is held as, or the name inlining knows of the type of a value of an
    ; interface, which the inliner settles from the type's descriptor and the interface's name.
    (let nothing (call make-operand .operand-void 0))
    (let plan (call (. facts plan-of) (. unit reading) id))
    (if (== plan .plan-type-base)
      (call run-type-operand object)
      (return (call type-value id (call (. facts node-type) (. unit reading) id)))
    )
    (if (or (== plan .plan-type-name) (== plan .plan-type-key))
      (call run-type-operand object)
      (return (call type-text id (call named-type (call (. facts node-type) (. unit reading) object)) plan))
    )
    (if (== plan .plan-type-size)
      (call run-type-operand object)
      (let counted (call (. facts node-type) (. unit reading) id))
      (let held (call layout-of (call named-type (call (. facts node-type) (. unit reading) object)) id))
      (let counts (call layout-of counted id))
      (if (not (call is-integer counts))
        (call refuse .refused-expression id)
        (return (call Typed nothing no-type))
      )
      (return (call Typed (call integer (call (. tables layouts kind-of) counts) (. ([] (. tables layouts rows) held) size)) counted))
    )
    (if (== plan .plan-inlined-name)
      (let descriptor (call emit-expression object))
      (let fallback (call type-text id (call named-type (call (. facts node-type) (. unit reading) object)) .plan-type-name))
      (let start U32 (. ir operands length))
      (call (. ir add-operand) (. descriptor operand))
      (call (. ir add-operand) (. fallback operand))
      (return
        (call Typed
          (block
            (arg
              (call make-operand
                (block
                  (arg .operand-value)
                  (arg (call append .op-inlined-name id (call Span start 2) 0 managed-layout))
                )
              )
            )
            (arg (. fallback type))
          )
        )
      )
    )
    (if (== plan .plan-type-properties)
      (return (call type-properties id object))
    )
    (if (and (!= plan .plan-concrete-name) (!= plan .plan-concrete-key))
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (let subject (call emit-expression object))
    (return
      (call Typed
        (block
          (arg
            (call load
              (block
                (arg (. subject operand))
                (arg (if-expr (== plan .plan-concrete-name) 0 table-slot-size))
                (arg managed-layout)
                (arg id)
              )
            )
          )
          (arg (. types string-type))
        )
      )
    )
  )
  (fn-do _ type-properties Typed
    (param id SyntaxId)
    (param object SyntaxId)
    (let nothing (call make-operand .operand-void 0))
    (let listed (call (. facts node-type) (. unit reading) id))
    (let layout (call layout-of listed id))
    (if (or (not (call (. tables layouts is-struct) layout)) (!= (. ([] (. tables layouts rows) layout) fields count) 1))
      (call refuse .refused-type id)
      (return (call Typed nothing no-type))
    )
    (let subject (call emit-expression object))
    (let field (call (. tables layouts field) layout 0))
    (let table (call load (. subject operand) (* 2 table-slot-size) (. field layout) id))
    (let memory (call frame layout))
    (call put memory field table id)
    (return (call Typed memory listed))
  )
  (fn-do _ type-value Typed
    (param id SyntaxId)
    (param info TypeId)
    ; A type as a value: the address of the constant that holds the type's name and its key.
    ; `info` is the type the type pass gave the node, which says what type the value is.
    (let named (call named-type info))
    (let symbol
      (scope (if-expr (and (!= named no-type) (!= named invalid-type)) rtti-symbol no-string)
        (lazy rtti-symbol ([] (. tables rtti-symbols) named))
      )
    )
    (if (== symbol no-string)
      (call refuse .refused-expression id)
      (return (call Typed (call make-operand .operand-void 0) no-type))
    )
    (+= type-values named)
    (return (call Typed (call make-operand .operand-symbol symbol) info))
  )
  (fn-do _ type-text Typed
    (param id SyntaxId)
    (param named TypeId)
    (param plan OperatorPlan)
    ; The name or the key of a type, as the text the constant of the type holds.
    (if (or (== named no-type) (== named invalid-type))
      (call refuse .refused-expression id)
      (return (call Typed (call make-operand .operand-void 0) no-type))
    )
    (let text
      (scope (if-expr (== plan .plan-type-name) (call type-runtime-name types named) runtime-key)
        (lazy runtime-key (call type-runtime-key types named))
      )
    )
    (return (call Typed (call make-operand .operand-constant (call (. ir add-string) text)) (. types string-type)))
  )
  (fn-do _ named-type TypeId
    (param info TypeId)
    ; The type that a type given as a value is, which the type of the value says.
    (if (and (!= info no-type) (!= info invalid-type) (== (call intrinsic info) .type-info))
      (match? ([] (. types rows) info)
        (case (call .type-class row)
          (if (== (. row args count) 1)
            (return (call (. types child-type) (. row args) 0))
          )
        )
      )
    )
    (return no-type)
  )
  (fn-do _ emit-index Typed
    (param id SyntaxId)
    (param object SyntaxId)
    ; A field read by a constant index, which the type pass recorded.
    (let nothing (call make-operand .operand-void 0))
    (let place (call indexed-field id))
    (if (== place no-fact)
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (let base (call emit-expression object))
    (return (call placed-field id (. base operand) (. base type) place))
  )
  (fn-do _ emit-array-item Typed
    (param id SyntaxId)
    (param object SyntaxId)
    (param index SyntaxId)
    (param reader SyntaxId (= 0))
    (param name (? Atom) (= null))
    ; An item of an array of numbers read by an index, or the field `name` of numbers that the node
    ; `reader` reads of an item of an array of structs, as TypeScript reads one: where the index is
    ; less than the array's size, from where the array's storage holds the item, and anywhere else
    ; from what the function recorded at the index gives, which answers for an index the array
    ; does not hold. The array is evaluated before the index, and each takes the conversion
    ; recorded for it.
    (let nothing (call make-operand .operand-void 0))
    (let fact (call own-call id))
    (if (or (== fact no-fact) (and (!= reader 0) (not name)))
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (let receiver (call convert object .reason-receiver (call emit-expression object)))
    (let receiver-type (. receiver type))
    (let key (call convert index .reason-argument (call emit-expression index)))
    (let key-type (. key type))
    (return
      (call array-item
        (block
          (arg id)
          (arg (. ([] (. facts calls) fact) callee))
          (arg (. receiver operand))
          (arg receiver-type)
          (arg (. key operand))
          (arg key-type)
          (arg reader)
          (arg name)
        )
      )
    )
  )
  (fn-do _ array-item Typed
    (param id SyntaxId)
    (param callee InstanceId)
    (param receiver Operand)
    (param receiver-type TypeId)
    (param key Operand)
    (param key-type TypeId)
    (param reader SyntaxId (= 0))
    (param name (? Atom) (= null))
    ; An item of an array an index reads as TypeScript reads it, once the array and the index are
    ; evaluated: from the array's storage where the index is less than its size, and anywhere else
    ; from what `callee` answers for them.
    (let nothing (call make-operand .operand-void 0))
    (if (or (!= receiver-type (. ([] (. instances rows) callee) self-type)) key-differs)
      (call refuse .refused-conversion id)
      (return (call Typed nothing no-type))
    )
    (lazy key-differs (!= key-type (call (. instances argument-type) callee 0)))
    (let item (. ([] (. instances signatures) callee) returns))
    (let layout (call layout-of receiver-type id))
    (let key-layout (call layout-of key-type id))
    (let item-layout (call layout-of item id))
    (let data (call part receiver layout 0 id))
    (let data-layout (call layout-of (. data type) id))
    (let proven (!= (call (. facts constant-of) (. unit reading) id) no-fact))
    (let size
      (block
        (case? proven
          (call Typed (call integer .machine-u64 0) (. types size-type))
        )
        (default
          (call part receiver layout 1 id)
        )
      )
    )
    (let size-layout (if-expr proven u64-layout (call layout-of (. size type) id)))
    (let structured (call (. tables layouts is-struct) item-layout))
    (if (or (not (call is-pointer data-layout)) (not (call is-integer size-layout)) (not (call is-integer key-layout)) wrong-reader)
      (call refuse .refused-type id)
      (return (call Typed nothing no-type))
    )
    (lazy wrong-reader (!= structured (!= reader 0)))
    (let wide (call num-cast id key key-layout u64-layout))
    (let inside (call (. ir reserve-block)))
    (let outside (call (. ir reserve-block)))
    (let joined (call (. ir reserve-block)))
    (if proven
      (call jump inside)
      (else
        (call branch
          (block
            (arg (call compare id .compare-less wide (call num-cast id (. size operand) size-layout u64-layout)))
            (arg inside)
            (arg outside)
          )
        )
      )
    )
    (call (. ir start-block) inside)
    (let stride (call integer .machine-u64 (. ([] (. tables layouts rows) item-layout) size)))
    (let cell
      (call moved-bytes
        (block
          (arg id)
          (arg (call num-cast id (. data operand) data-layout pointer-layout))
          (arg (call arithmetic id .arithmetic-multiply wide stride u64-layout))
        )
      )
    )
    (let held nothing)
    (let read item)
    (if structured
      (let propertyed (call load-property reader (call address cell 0 item-layout id) item (!! name)))
      (= held (. propertyed operand))
      (= read (. propertyed type))
      (else
        (= held (call load cell 0 item-layout id))
      )
    )
    (if proven
      (if (not (call gives (if-expr structured reader id) read))
        (call refuse .refused-conversion id)
        (return (call Typed nothing no-type))
      )
      (return (call Typed held read))
    )
    (let from-inside (. ir current))
    (call jump joined)
    (call (. ir start-block) outside)
    (let mark (. pending length))
    (+= pending receiver)
    (+= pending key)
    (let answer (call call-method callee id mark))
    (if structured
      (= answer (call load-property reader (. answer operand) item (!! name)))
    )
    (if (!= (. answer type) read)
      (call refuse .refused-conversion id)
      (return (call Typed nothing no-type))
    )
    (let from-outside (. ir current))
    (call jump joined)
    (call (. ir start-block) joined)
    (let read-layout (call layout-of read id))
    (if (not (call gives (if-expr structured reader id) read))
      (call refuse .refused-conversion id)
      (return (call Typed nothing no-type))
    )
    (return (call Typed (call phi read-layout held from-inside (. answer operand) from-outside) read))
  )
  (fn-do _ fills-in-order Bool
    (param fact CallFact)
    (param callee InstanceId)
    (param count U32)
    ; Whether a call gives its callee exactly `count` arguments, each parameter the one written
    ; in its place.
    (if (or (!= (. ([] (. instances signatures) callee) args count) count) (!= (. fact fills count) count))
      (return false)
    )
    (for (in position (..< 0 count))
      (if (!= (as ([] (. facts call-fills) (+ (. fact fills start) position)) U32) position)
        (return false)
      )
    )
    (return true)
  )
  (fn-do _ pin-holder _
    (param place SyntaxId)
    ; Evaluates, once, the object a place is a property or a field of, and keeps its value for
    ; every later reading of that object: what is stored in the place after other code has run
    ; goes where the place was read from, though that code may have changed what the object's
    ; expression names.
    (match? ([] (. tree nodes) place)
      (case (call .node-get-expression row)
        (if (or (== (. row object) 0) (call is-pinned (. row object)))
          (return)
        )
        (let held (call emit-expression (. row object)))
        (call pin (. row object) (. held operand) (. held type))
      )
    )
  )
  (fn-do _ emit-list Typed
    (param id SyntaxId)
    (param written (of RowRange SyntaxId))
    ; A list written, made as TypeScript makes one: the items are evaluated in the order they are
    ; written, a struct among several copied, since what follows may change the storage it was
    ; read from, and the list is made of them.
    (let nothing (call make-operand .operand-void 0))
    (let list-type (call (. facts node-type) (. unit reading) id))
    (let count U32 (. written count))
    (let start (. given length))
    (for (in item ([] (. tree children) written))
      (let made (call emit-expression item))
      (+= given (call Typed (call apart made item (> count 1)) (. made type)))
    )
    (let list nothing)
    (= list (. (call build-list id written list-type start true) operand))
    (call drop-given start)
    (return (call Typed list list-type))
  )
  (fn-do _ build-list Typed
    (param id SyntaxId)
    (param written (of RowRange SyntaxId))
    (param list-type TypeId)
    (param start Size)
    (param converts Bool)
    (param chain SyntaxId (= 0))
    (param room U32 (= 0))
    ; A list of the items written at `written`, which `given` holds from `start` on, made with the
    ; functions the type pass recorded at the node:
    ; 1. The empty list is made, and room for the items is reserved in it.
    ; 2. Each item takes the conversion recorded for it, where it `converts`.
    ; 3. Each is stored where the array the list keeps its items in holds them, and the list's
    ;    size is set.
    (let nothing (call make-operand .operand-void 0))
    (let makes no-fact)
    (let reserves no-instance)
    (let reads no-instance)
    (let fact (call (. facts first-call) (. unit reading) id))
    (while (!= fact no-fact)
      (let row ([] (. facts calls) fact))
      (if (== (. row form) .call-list-make)
        (= makes fact)
        (else-if (== (. row form) .call-list-reserve)
          (= reserves (. row callee))
        )
        (else-if (== (. row form) .call-list-data)
          (= reads (. row callee))
        )
      )
      (= fact (. row next))
    )
    (let count U32 (. written count))
    (let kept (call property-of list-type (!! (. types items-atom))))
    (let sized (call property-of list-type (!! (. types size-atom))))
    (if (or (== makes no-fact) (== reserves no-instance) (== reads no-instance) (not kept) (not sized))
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (if (or (== ([] (. tables instance-functions) reserves) no-function) no-reads-function)
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (lazy no-reads-function (== ([] (. tables instance-functions) reads) no-function))
    (let list (call emit-fact-call id ([] (. facts calls) makes) 0 (call (of RowRange SyntaxId)) 0 0 list-type))
    (if (!= (. list type) list-type)
      (call refuse .refused-conversion id)
    )
    (if (or (!= count 0) (!= room 0))
      (call fill-list
        (block
          (arg id)
          (arg written)
          (arg (. list operand))
          (arg list-type)
          (arg start)
          (arg reserves)
          (arg reads)
          (arg kept)
          (arg converts)
          (arg chain)
          (arg room)
        )
      )
    )
    (if (!= count 0)
      (let field (call held-field id list-type sized))
      (if (call is-integer (. field layout))
        (call store (. list operand) (. field offset) (call integer (as (. field layout) MachineKind) count) false id)
        (else
          (call refuse .refused-expression id)
        )
      )
    )
    (return (call Typed (. list operand) list-type))
  )
  (fn-do _ fill-list _
    (param id SyntaxId)
    (param written (of RowRange SyntaxId))
    (param list Operand)
    (param list-type TypeId)
    (param start Size)
    (param reserves InstanceId)
    (param reads InstanceId)
    (param kept Index)
    (param converts Bool)
    (param chain SyntaxId (= 0))
    (param room U32 (= 0))
    ; Reserves room in a list just made for the items evaluated, which `given` holds from
    ; `start` on, converts each where it `converts`, and stores them where the list's array holds
    ; its items.
    (let count U32 (. written count))
    (let counted (call layout-of (. types size-type) id))
    (let takes-size (and (== (. ([] (. instances signatures) reserves) args count) 1) (call is-integer counted)))
    (if (or (not takes-size) (!= (call (. instances argument-type) reserves 0) (. types size-type)))
      (call refuse .refused-expression id)
      (return)
    )
    (if (!= (. ([] (. instances rows) reserves) self-type) list-type)
      (call refuse .refused-conversion id)
      (return)
    )
    (let mark (. pending length))
    (+= pending list)
    (+= pending (call integer (as counted MachineKind) (+ count room)))
    (call call-method reserves id mark)
    (for (in position (..< 0 count))
      (if (not converts)
        (break)
      )
      (let item (call (. tree item-site) written chain position))
      (let converted (call convert item .reason-element ([] given (+ start position))))
      (= ([] given (+ start position)) converted)
    )
    (let array (call held-field id list-type kept))
    (if (or (not (call (. tables layouts is-struct) (. array layout))) (!= (. array type) (. ([] (. instances rows) reads) self-type)))
      (call refuse .refused-expression id)
      (return)
    )
    (let reading-mark (. pending length))
    (+= pending (call address list (. array offset) (. array layout) id))
    (let data (call call-method reads id reading-mark))
    (let pointer (call layout-of (. data type) id))
    (let item-type (call (. tables layouts pointee-type) (. data type)))
    (if (or (not (call is-pointer pointer)) (== item-type no-type))
      (call refuse .refused-expression id)
      (return)
    )
    (let layout (call layout-of item-type id))
    (let size (. ([] (. tables layouts rows) layout) size))
    (for (in position (..< 0 count))
      (let item (call (. tree item-site) written chain position))
      (if (!= (. ([] given (+ start position)) type) item-type)
        (call refuse .refused-conversion item)
        (return)
      )
      (let value (. ([] given (+ start position)) operand))
      (if (call (. tables layouts is-struct) layout)
        (call store-struct (. data operand) (call LayoutField (* position size) layout) value item)
        (else-if (!= layout void-layout)
          (call store (. data operand) (* position size) value (call is-managed-pointer layout) item)
        )
      )
    )
  )
  (fn-do _ store-held _
    (param base Operand)
    (param object SyntaxId)
    (param owner TypeId)
    (param place Index)
    (param value Operand)
    (param type TypeId)
    (param site SyntaxId)
    ; Stores a value in a property an object stores, or in a field of a struct that lies where
    ; `object` names, which is the receiver when it is no syntax. A managed pointer written
    ; into an object goes through the write barrier. A struct that an object holds has no shape
    ; for a store that writes a managed pointer into it.
    (let field (call held-field site owner place))
    (if (!= (. field type) type)
      (call refuse .refused-statement site)
      (return)
    )
    (let in-object (call (. tables is-class) owner))
    (let managed (and (!= (. field layout) void-layout) (. ([] (. tables layouts rows) (. field layout)) is-managed)))
    (if (and (not in-object) managed (not (call is-framed object)))
      (call refuse .refused-statement site)
      (return)
    )
    (if (call (. tables layouts is-struct) (. field layout))
      (if in-object
        (call store-struct base field value site)
        (else
          (call put base field value site)
        )
      )
      (else-if (!= (. field layout) void-layout)
        (call store base (. field offset) value (and in-object (call is-managed-pointer (. field layout))) site)
      )
    )
  )
  (fn-do _ placed-field Typed
    (param id SyntaxId)
    (param base Operand)
    (param owner TypeId)
    (param place FactId)
    ; The stored field of a tuple or struct that a constant of the type pass names by its place.
    ; The read has the field's own type, which is the node's.
    (let nothing (call make-operand .operand-void 0))
    (let layout (call layout-of owner id))
    (let position (as (. ([] (. facts constants) place) bits) U32))
    (if (or (not (call (. tables layouts is-struct) layout)) (>= position (. ([] (. tables layouts rows) layout) fields count)))
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (let type (call field-type owner position))
    (if (not (call gives id type))
      (call refuse .refused-conversion id)
      (return (call Typed nothing no-type))
    )
    (return (call Typed (call take base (call (. tables layouts field) layout position) id) type))
  )
  (fn-expr _ indexed-field FactId
    (param id SyntaxId)
    ; The constant that says which stored field an index names, or none. The node of an index
    ; assigned with an operator keeps the constant under the operator's own plan.
    (if-expr (and (!= plan .plan-field) (!= plan .plan-builtin)) no-fact (call (. facts constant-of) (. unit reading) id))
    (where
      (lazy plan (call (. facts plan-of) (. unit reading) id))
    )
  )
  (fn-do _ emit-header Operand
    (param id SyntaxId)
    (param expr SyntaxId)
    (param items (of RowRange SyntaxId))
    ; A header gives each item below it to the `with` of what the one before gave. The calls are
    ; those the type pass recorded at the header, in order: the first on the value written, each
    ; after on the answer of the one before, held as the header's own value. Only the last answers
    ; with the header's type. A call that leaves out a parameter or has a variadic tail has no
    ; shape where there are several, since what it records for them is kept at the header.
    (if (== (. items count) 0)
      (return (. (call emit-expression expr) operand))
    )
    (let nothing (call make-operand .operand-void 0))
    (let fact (call (. facts first-call) (. unit reading) id))
    (let value nothing)
    (let object expr)
    (let mark (. pins length))
    (for (in position (..< 0 (. items count)))
      (if (== fact no-fact)
        (call refuse .refused-expression id)
      )
      (let row ([] (. facts calls) fact))
      (if (and (> (. items count) 1) (or (!= (. row fills count) 1) (!= (as ([] (. facts call-fills) (. row fills start)) U32) 0)))
        (call refuse .refused-expression id)
        (break)
      )
      (let answers
        (scope (if-expr (== (+ position 1) (. items count)) no-type callee-returns)
          (lazy callee-returns (. ([] (. instances signatures) (. row callee)) returns))
        )
      )
      (let called
        (call emit-fact-call
          (block
            (arg id)
            (arg row)
            (arg object)
            (arg (call (of RowRange SyntaxId) (+ (. items start) position) 1))
            (arg 0)
            (arg 0)
            (arg answers)
          )
        )
      )
      (= value (. called operand))
      (call unpin mark)
      (call pin id value (. called type))
      (= object id)
      (= fact (call next-call fact))
    )
    (call unpin mark)
    (return value)
  )
  (fn-do _ emit-tuple Typed
    (param id SyntaxId)
    (param items (of RowRange SyntaxId))
    ; A tuple written: memory in the frame, with each item stored to its field in turn. An item
    ; is copied where it is stored, so nothing a later item does changes it.
    (let nothing (call make-operand .operand-void 0))
    (let type (call (. facts node-type) (. unit reading) id))
    (let layout (call layout-of type id))
    (if (or (not (call (. tables layouts is-struct) layout)) (!= (. ([] (. tables layouts rows) layout) fields count) (. items count)))
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (let made (call frame layout))
    (for (in position (..< 0 (. items count)))
      (let item ([] (. tree children) (+ (. items start) position)))
      (match? ([] (. tree nodes) item)
        (case (call .node-argument named)
          (= item (. named expr))
        )
      )
      (let value (call emit-expression item))
      (if (!= (. value type) (call field-type type position))
        (call refuse .refused-conversion item)
        (return (call Typed nothing no-type))
      )
      (call put made (call (. tables layouts field) layout position) (. value operand) item)
    )
    (return (call Typed made type))
  )
  (fn-do _ run-type-operand _
    (param id SyntaxId)
    ; What is run before a constant is read from a type or a value: `type-of` runs its operand, a
    ; name runs nothing, and any other expression is evaluated for what it does.
    (match? ([] (. tree nodes) id)
      (case (all (call .node-unary-expression row) ({} (== (. row op) .type-of-op)))
        (call emit-expression (. row operand))
        (return)
      )
      (case .node-identifier
        (return)
      )
      (case .node-type-identifier
        (return)
      )
      (case .node-core-type-identifier
        (return)
      )
      (case .node-type-arguments
        (return)
      )
      (case .node-type-associated
        (return)
      )
      (case .node-type-optional
        (return)
      )
      (case .node-type-numeric
        (return)
      )
    )
    (call emit-expression id)
  )
  (fn-do _ emit-constant Operand
    (param id SyntaxId)
    ; A constant the type pass worked out: the number or the text its fact holds, as a value of
    ; the node's type.
    (let nothing (call make-operand .operand-void 0))
    (let fact (call (. facts constant-of) (. unit reading) id))
    (let type (call (. facts node-type) (. unit reading) id))
    (if (== fact no-fact)
      (call refuse .refused-expression id)
      (return nothing)
    )
    (let row ([] (. facts constants) fact))
    (if (. row text)
      (if (!= type (. types string-type))
        (call refuse .refused-type id)
        (return nothing)
      )
      (return (call make-operand .operand-constant (call (. ir add-string) (. (!! (. row text)) text))))
    )
    (let layout (call layout-of type id))
    (if (and (. row is-float) (call is-float layout))
      (return (call float-number layout (. row float)))
    )
    (if (and (not (. row is-float)) (call is-integer layout))
      (return (call integer (call (. tables layouts kind-of) layout) (. row bits)))
    )
    (call refuse .refused-type id)
    (return nothing)
  )
  (fn-do _ slot-held-type TypeId
    (param site SyntaxId)
    (param slot SlotId)
    ; The type a local, a lazy local, an argument, the item of a loop or a name a pattern binds
    ; holds where a site names it, as its function gives it or the environment that holds it; none
    ; for any other.
    (let kind (. ([] (. bindings slots) slot) kind))
    (let named
      (scope (or local-or-argument (== kind .slot-loop-item) (== kind .slot-pattern))
        (lazy local-or-argument (or (== kind .slot-local) (== kind .slot-argument)))
      )
    )
    (if (and (not named) (!= kind .slot-lazy))
      (return no-type)
    )
    (if (call is-captured slot)
      (return (. (call find-captured slot site) type))
    )
    (if (not (call owns slot))
      (return no-type)
    )
    (if (== kind .slot-argument)
      (return (call (. instances argument-type) (. unit instance) (call argument-position slot)))
    )
    (return (call (. facts slot-type) (. unit instance) (- slot (. unit slot-start))))
  )
  (fn-do _ emit-closure Typed
    (param id SyntaxId)
    (param given TypeId (= no-type))
    ; A nested function written as a value: the environment in force where it is written,
    ; which its body reads the locals it captures from. That is the function's own
    ; environment, or else the one the function was given, or nothing where it has neither.
    ; One written in the body of a constructor whose properties read a captured lazy local, or
    ; made a nested function, has no shape where the constructor declares such a local: see
    ; `read-shared`. Nor has one made while a constructor gives the properties their values,
    ; where a nested function reads the receiver: TypeScript gives it a copy of what each
    ; property was given, which a later change of the property does not reach. One that is the
    ; value of a lazy local nested functions capture, made by a function written in the one that
    ; declares the local, as `read-shared` evaluates it there, is the environment that holds
    ; the local, which is the one in force where it is written; any other made by a function it
    ; is not written in has no shape, but where the one it is written in keeps no environment, as
    ; the value of a property is: it is given none. One written in a line of a root `<This` is given
    ; the environment made for the line (`hold-unit`). One the type pass made of no written function
    ; is `given` its type.
    (let type (if-expr (!= given no-type) given (call (. facts node-type) (. unit reading) id)))
    (let outside (!= (. unit reading) (. unit instance)))
    (let held (and outside (== (. unit reading) (. filling held-unit))))
    (let bare (and outside (not held) (== ([] (. tables environments) (. unit reading)) no-layout)))
    (let shared (if-expr (and outside (not bare) (not held)) (call shared-written id) no-slot))
    (if (or unsharable (not (call is-closure type)) (and (not (. filling storing)) (call fills-share) (call shares-lazy)))
      (call refuse .refused-expression id)
      (return (call Typed (call make-operand .operand-void 0) no-type))
    )
    (lazy unsharable (and outside (not bare) (not held) (== shared no-slot)))
    (if (and (. filling storing) (not held) (call shares-receiver))
      (call refuse .refused-expression id)
      (return (call Typed (call make-operand .operand-void 0) no-type))
    )
    (if (!= shared no-slot)
      (call find-captured shared id)
      (let held (call captured-base id))
      (return (call Typed held type))
    )
    (let written
      (block
        (case? bare
          (call integer .machine-managed-pointer 0)
        )
        (case? held
          (call load-local (. filling held-environment) id)
        )
        (default
          (call written-environment id)
        )
      )
    )
    (match? ([] (. types rows) type)
      (case (call .type-closure row)
        (call hold-stacks id (. row decl) written)
      )
    )
    (let given (call kept-cells id type written))
    (return (call Typed given type))
  )
  (fn-do _ hold-stacks _
    (param id SyntaxId)
    (param decl DeclId)
    (param written Operand)
    ; Where a lambda or a comprehension is made, the function writes into its own environment the
    ; state of each global `do with` binds that it holds, which one made again in the same run
    ; writes over, as TypeScript keeps it. One made in a loop whose turn has an environment,
    ; where TypeScript keeps the state, has no shape for it.
    (if (not (call (. tables holds-stacks) (. unit instance)))
      (return)
    )
    (for (in position (..< 0 (. tables place-owners length)))
      (if (and (== ([] (. tables place-owners) position) (. unit instance)) (== ([] (. tables place-decls) position) decl))
        (let held ([] (. tables environments) (. unit instance)))
        (if (or (!= (. open-turns length) 0) (== (. unit environment) no-local) unbuilt-held)
          (call refuse .refused-expression id)
          (return)
        )
        (lazy unbuilt-held (or (== held no-layout) (== held unbuilt-environment)))
        (let field (call (. tables layouts field) held ([] (. tables place-children) position)))
        (call capture-stack written field ([] (. tables place-rows) position) id)
      )
    )
  )
  (fn-do _ is-closure-body Bool
    ; Whether the function emitted is the body of a lambda or a comprehension, or the steps of one
    ; that yields.
    (if (or (== (. unit instance) no-instance) (and (!= (. function kind) .instance-body) (!= (. function kind) .generator-body)))
      (return false)
    )
    (let row ([] (. instances rows) (. unit instance)))
    (match? ([] (. ([] (. program modules) (. row module)) decls) (. row decl))
      (case (call .decl-function fn)
        (if (== (. fn kind) .iterator-decl)
          (match? ([] (. ([] (. program modules) (. row module)) tree nodes) (. fn syntax))
            (case .node-iterator-expression
              (return true)
            )
          )
        )
        (return (== (. fn kind) .closure-decl))
      )
    )
    (return false)
  )
  (fn-expr _ fills-share Bool
    ; Whether the function is a constructor whose properties, as it gives them their first values,
    ; read a lazy local nested functions capture or make a nested function, as the type pass
    ; found.
    (and (!= (. unit instance) no-instance) (. ([] (. instances rows) (. unit instance)) fills-share))
  )
  (fn-expr _ is-closure Bool
    (param type TypeId)
    (and (!= type no-type) (!= type invalid-type) (== (call intrinsic type) .closure))
  )
  (fn-do _ shares-receiver Bool
    ; Whether nested functions capture the receiver of the function.
    (for (in offset (..< 0 (. unit slot-count)))
      (let slot (+ (. unit slot-start) offset))
      (if (and (== (. ([] (. bindings slots) slot) kind) .slot-this) (call is-captured slot))
        (return true)
      )
    )
    (return false)
  )
  (fn-do _ runs-as Bool
    (param callee InstanceId)
    (param held U32)
    (param target TypeId)
    ; Whether an instance takes, after the arguments a binding holds, those of a function type,
    ; and returns what the type returns: each as it is, or by a conversion the type pass
    ; recorded for it. A type that returns nothing takes any answer that needs no memory of the
    ; caller. A type that carries errors returns its value or one of them, which the type pass
    ; kept for the type.
    (let fn (call function-row types target))
    (if (or (== fn no-type) (and (call carries fn) (== (call (. facts carried-result) fn) no-type)))
      (return false)
    )
    (match? ([] (. types rows) fn)
      (case (call .type-function row)
        (let signature ([] (. instances signatures) callee))
        (if (!= (. signature args count) (+ held (. row args count)))
          (return false)
        )
        (for (in offset (..< 0 (. row args count)))
          (let given (call (. types child-type) (. row args) offset))
          (let taken (call (. instances argument-type) callee (+ held offset)))
          (if (and (!= taken given) (== given-conversion no-fact))
            (return false)
          )
          (lazy given-conversion (call (. facts passed-conversion) callee .reason-argument given taken))
        )
        (let returns (call value-returned (. row return-type)))
        (if (or (== (. signature returns) returns) (!= converted no-fact))
          (return true)
        )
        (lazy converted (call (. facts passed-conversion) callee .reason-return (. signature returns) returns))
        (let answered ([] (. tables layouts values) (. signature returns)))
        (return (and (== returns (. types void-type)) (!= answered no-layout) (not (call (. tables layouts is-large) answered))))
      )
    )
    (return false)
  )
  (fn-do _ raises-errors Bool
    ; Whether an error can leave the function, or what it runs where it is one made for a
    ; value of a function type: an error raised under it names it in its stack trace, as a
    ; panic does. One can leave the function of a rule made for a pattern that may raise.
    (let runs (. unit instance))
    (if (== (. function kind) .adapter)
      (= runs (. ([] (. tables adapters) (. function place)) runs))
    )
    (if (== (. function kind) .raising-rule)
      (return true)
    )
    (return (and (!= runs no-instance) (!= (. ([] (. instances signatures) runs) errors count) 0)))
