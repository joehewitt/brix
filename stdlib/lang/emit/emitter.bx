    (if (or initializes in-zone (and builds (== result-type no-type)))
      (call refuse .refused-statement id)
      (return)
    )
    (let leave (call (. facts leave-of) (. unit reading) id type))
    (if (and (!= (. unit lender) no-instance) (!= leave no-fact))
      (call refuse .refused-statement id)
      (return)
    )
    (call trace-error error id)
    (if (== leave no-fact)
