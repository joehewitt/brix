    ; A return with the zero of the type the function returns: no bits set, or the empty text.
    ; A panic returns a struct from memory of the function's frame with no bits set, so that an
    ; optional a caller reads after a panic it does not check holds nothing, as in the
    ; reference; a return that only closes a block returns none. A function that yields has
    ; finished where it returns so.
    (if stepping
      (call keep-step finished-step 0)
    )
    (let blank (call make-operand .operand-void 0))
    (let is-struct (and (!= (. ir returns) void-layout) (call (. tables layouts is-struct) (. ir returns))))
    (if (and is-struct (== kind .return-panic))
      (= blank (call frame (. ir returns)))
      (call zero blank (. ir returns))
    )
    (let start U32 (. ir operands length))
    (let count U32)
    (if (and is-struct (== kind .return-panic))
      (call (. ir add-operand) blank)
      (= count 1)
      (else-if (and (!= (. ir returns) void-layout) (not is-struct))
        (if (== returns-type (. types string-type))
          (call (. ir add-operand) (call make-operand .operand-constant (call (. ir add-string) "")))
          (else
            (call (. ir add-operand) (call integer (call (. tables layouts kind-of) (. ir returns)) 0))
          )
        )
        (= count 1)
      )
    )
    (call append .op-return 0 (call Span start count) kind)
  )
  (fn-do _ load-local Operand
    (param local LocalId)
    (param syntax SyntaxId)
    ; What a local holds. A struct is read as the address of the local's own memory: nothing is
    ; copied until it is stored.
    (let layout (. ([] (. ir locals) local) layout))
    (if (call (. tables layouts is-struct) layout)
      (return (call make-operand .operand-value (call append .op-local-address syntax (call Span) local layout)))
    )
    (return (call make-operand .operand-value (call append .op-load-local syntax (call Span) local layout)))
  )
  (fn-do _ store-local _
    (param local LocalId)
    (param value Operand)
    (param syntax SyntaxId)
    ; Stores a value in a local. A struct is copied into the local's memory.
    (let layout (. ([] (. ir locals) local) layout))
    (if (call (. tables layouts is-struct) layout)
      (call copy (call load-local local syntax) value layout false syntax)
      (return)
    )
    (let start U32 (. ir operands length))
    (call (. ir add-operand) value)
    (call append .op-store-local syntax (call Span start 1) local)
  )
  (fn-do _ put _
    (param target Operand)
    (param field LayoutField)
    (param value Operand)
    (param syntax SyntaxId)
    ; Stores a value at a field of memory outside the heap. A struct is copied in.
    (if (call (. tables layouts is-struct) (. field layout))
      (call copy (call address target (. field offset) (. field layout) syntax) value (. field layout) false syntax)
      (else-if (!= (. field layout) void-layout)
        (call store target (. field offset) value false syntax)
      )
    )
  )
  (fn-do _ take Operand
    (param source Operand)
    (param field LayoutField)
    (param syntax SyntaxId)
    ; Reads a field of a struct: a scalar is loaded, and a struct is its address inside.
    (if (call (. tables layouts is-struct) (. field layout))
      (return (call address source (. field offset) (. field layout) syntax))
    )
    (if (== (. field layout) void-layout)
      (return (call make-operand .operand-void 0))
    )
    (return (call load source (. field offset) (. field layout) syntax))
  )
  (fn-expr _ field-type TypeId
    (param owner TypeId)
    (param position U32)
    ; The type of the field a tuple or struct stores at a position.
    (case? (or (== owner no-type) (== owner invalid-type))
      no-type
    )
    (case? (or (== layout no-layout) (not (call (. tables layouts is-struct) layout)))
      no-type
    )
    (case? (>= position (. ([] (. tables layouts rows) layout) fields count))
      no-type
    )
    (default
      (. (call (. tables layouts field) layout position) type)
    )
    (where
      (lazy layout ([] (. tables layouts values) owner))
    )
  )
  (fn-do _ arithmetic Operand
    (param syntax SyntaxId)
    (param op ArithmeticOp)
    (param left Operand)
    (param right Operand)
    (param layout LayoutId)
    (if (and (== op .arithmetic-multiply) (call is-integer layout) by-one)
      (return left)
    )
    (lazy by-one (and (== (call operand-kind right) .operand-number) (== (. ([] (. ir numbers) (call operand-payload right)) bits) 1)))
    (let start U32 (. ir operands length))
    (call (. ir add-operand) left)
    (call (. ir add-operand) right)
    (return (call make-operand .operand-value (call append .op-arithmetic syntax (call Span start 2) op layout)))
  )
  (fn-do _ bitwise Operand
    (param syntax SyntaxId)
    (param op BitwiseOp)
    (param left Operand)
    (param right Operand)
    (param layout LayoutId)
    (let start U32 (. ir operands length))
    (call (. ir add-operand) left)
    (call (. ir add-operand) right)
    (return (call make-operand .operand-value (call append .op-bitwise syntax (call Span start 2) op layout)))
  )
  (fn-do _ load Operand
    (param base Operand)
    (param offset U32)
    (param layout LayoutId)
    (param syntax SyntaxId)
    (let start U32 (. ir operands length))
    (call (. ir add-operand) base)
    (return (call make-operand .operand-value (call append .op-load syntax (call Span start 1) offset layout)))
  )
  (fn-do _ address Operand
    (param base Operand)
    (param offset U32)
    (param layout LayoutId)
    (param syntax SyntaxId)
    ; The address `offset` bytes into a base: of a struct held there, when the layout is one, or
    ; of a place a runtime function is given to write to.
    (let start U32 (. ir operands length))
    (call (. ir add-operand) base)
    (return (call make-operand .operand-value (call append .op-address syntax (call Span start 1) offset layout)))
  )
  (fn-do _ store _
    (param base Operand)
    (param offset U32)
    (param value Operand)
    (param barrier Bool)
    (param syntax SyntaxId)
    (let start U32 (. ir operands length))
    (call (. ir add-operand) base)
    (call (. ir add-operand) value)
    (call append
      (block
        (arg .op-store)
        (arg syntax)
        (arg (call Span start 2))
        (arg (if-expr barrier (/or/ offset managed-store-flag) offset))
      )
    )
  )
  (fn-do _ load-acquire Operand
    (param base Operand)
    (param offset U32)
    (param layout LayoutId)
    (param syntax SyntaxId)
    ; Reads the state of a lazy property or global, after which its value reads as it was stored
    ; before the state that reads as ready (`store-release`).
    (let start U32 (. ir operands length))
    (call (. ir add-operand) base)
    (return (call make-operand .operand-value (call append .op-load-acquire syntax (call Span start 1) offset layout)))
  )
  (fn-do _ store-release _
    (param base Operand)
    (param offset U32)
    (param value Operand)
    (param syntax SyntaxId)
    ; Marks a lazy property or global as having its value once the value is stored, so that a read
    ; of the state as ready on another thread (`load-acquire`) reads the value too.
    (let start U32 (. ir operands length))
    (call (. ir add-operand) base)
    (call (. ir add-operand) value)
    (call append .op-store-release syntax (call Span start 2) offset)
  )
  (fn-do _ copy _
    (param target Operand)
    (param source Operand)
    (param layout LayoutId)
    (param barrier Bool)
    (param syntax SyntaxId)
    ; Copies a struct. A copy into an object goes through the write barrier for the managed
    ; pointers it writes.
    (let start U32 (. ir operands length))
    (call (. ir add-operand) target)
    (call (. ir add-operand) source)
    (call append .op-copy syntax (call Span start 2) (if-expr barrier (/or/ layout managed-store-flag) layout))
  )
  (fn-do _ zero _
    (param target Operand)
    (param layout LayoutId)
    (let start U32 (. ir operands length))
    (call (. ir add-operand) target)
    (call append .op-zero 0 (call Span start 1) layout)
  )
  (fn-do _ frame Operand
    (param layout LayoutId)
    ; Memory in the function's frame for a struct, and its address.
    (return (call make-operand .operand-value (call append .op-frame 0 (call Span) layout layout)))
  )
  (fn-do _ branch _
    (param condition Operand)
    (param then-block IRBlockId)
    (param else-block IRBlockId)
    (let start U32 (. ir operands length))
    (call (. ir add-operand) condition)
    (call (. ir add-operand) (call make-operand .operand-block then-block))
    (call (. ir add-operand) (call make-operand .operand-block else-block))
    (call append .op-branch 0 (call Span start 3) 0)
  )
  (fn-do _ switch _
    (param condition Operand)
    (param fallback IRBlockId)
    (param values (list U64))
    (param blocks (list IRBlockId))
    (let layout (call (. ir operand-layout) condition))
    (let start U32 (. ir operands length))
    (call (. ir add-operand) condition)
    (call (. ir add-operand) (call make-operand .operand-block fallback))
    (for (in position (..< 0 (. values length)))
      (call (. ir add-operand) (call integer (as layout MachineKind) ([] values position)))
      (call (. ir add-operand) (call make-operand .operand-block ([] blocks position)))
    )
    (call append .op-switch 0 (call Span start (- (. ir operands length) start)) 0)
  )
  (fn-do _ jump _
    (param target IRBlockId)
    (let start U32 (. ir operands length))
    (call (. ir add-operand) (call make-operand .operand-block target))
    (call append .op-jump 0 (call Span start 1) 0)
  )
  (fn-do _ phi Operand
    (param layout LayoutId)
    (param first Operand)
    (param first-block IRBlockId)
    (param second Operand)
    (param second-block IRBlockId)
    ; The value two blocks join on: each value with the block it arrives from.
    (let start U32 (. ir operands length))
    (call (. ir add-operand) first)
    (call (. ir add-operand) (call make-operand .operand-block first-block))
    (call (. ir add-operand) second)
    (call (. ir add-operand) (call make-operand .operand-block second-block))
    (return (call make-operand .operand-value (call append .op-phi 0 (call Span start 4) 0 layout)))
  )
  (fn-do _ append ValueId
    (param op IROp)
    (param syntax SyntaxId)
    (param operands Span)
    (param aux U32)
    (param layout LayoutId (= void-layout))
    ; Adds an instruction to the function. A value with no bits may be given to a call, which
    ; passes nothing for it. Any other instruction that reads one, or a load of one, has no shape:
    ; nothing holds such a value, so the function is refused.
    (let is-call (or (== op .op-call) (== op .op-call-void)))
    (for (in position (..< (. operands start) (. operands end)))
      (if (and (not is-call) (== (call (. ir operand-layout) ([] (. ir operands) position)) void-layout))
        (call refuse .refused-type syntax)
      )
    )
    (if (and (== op .op-load) (== layout void-layout))
      (call refuse .refused-type syntax)
    )
    (let line U32)
    (let column U32)
    (let home (if-expr (== (. function site-module) (. U32 max)) (. function module) (. function site-module)))
    (if (and (!= syntax 0) (or (== (. unit source-module) home) placing))
      (let begin (. ([] (. tree nodes) syntax) loc begin))
      (= line (+ (. begin line) 1 line-shift (if-expr (== syntax lowered) 1 0)))
      (= column (+ (. begin column) 1))
    )
    (let placed (if-expr (!= (. unit source-module) home) (. unit source-module) (. U32 max)))
    (return
      (call (. ir append)
        (block
          (arg (call IRInstruction op (. ir current) layout no-type syntax line column operands aux placed))
        )
      )
    )
  )
)

(fn-expr _ is-made Bool
  (param bits (of CPointer U64))
  (param bit U32)
  (!= (/and/ ([] bits (/ bit 64)) (/lshift/ 1u64 (% bit 64))) 0)
)

(fn-do _ mark-made _
  (param bits (of CPointer U64))
  (param bit U32)
  (= ([] bits (/ bit 64)) (/or/ ([] bits (/ bit 64)) (/lshift/ 1u64 (% bit 64))))
)

(fn-do _ join-made Bool
  (param known (of CPointer U64))
  (param start U32)
  (param made (of CPointer U64))
  (param words U32)
  (param fresh Bool)
  ; Narrows what is known to be made where a block starts to what is also made on one more
  ; way in, or takes that whole for the first way found. Says whether anything changed.
  (let changed fresh)
  (for (in word (..< 0 words))
    (let joined (if-expr fresh ([] made word) (/and/ ([] known (+ start word)) ([] made word))))
    (if (!= joined ([] known (+ start word)))
      (= changed true)
    )
    (= ([] known (+ start word)) joined)
  )
  (return changed)
)

(fn-expr _ widened U64
  (param bits U64)
  (param width U32)
  (param signed Bool)
  (case? (>= width 64)
    bits
  )
  (case? (and signed (!= (/and/ low (/lshift/ 1u64 (- width 1))) 0))
    (/or/ low (- 0 (/lshift/ 1u64 width)))
  )
  (default
    low
  )
  (where
    (lazy low (/and/ bits (- (/lshift/ 1u64 width) 1)))
  )
)
