    (let begin (. ([] (. tree nodes) site) loc begin))
    (call attach-source error (+ (. begin line) 1) (+ (. begin column) 1) site)
    (let trace (call (. tables layouts field) object (+ object-header-fields (. instances report trace-slot))))
    (let mark (. pending length))
    (+= pending (call address error (. trace offset) managed-layout site))
    (call call-runtime .runtime-ensure-stack-trace site mark)
