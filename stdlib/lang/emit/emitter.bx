    (let layout ([] (. tables layouts values) (. value type)))
    (if (or (== layout no-layout) (not (call (. tables layouts is-struct) layout)) (call is-answer (. value operand)) already-made)
      (return (. value operand))
    )
    (lazy already-made (!= (call made-row (. value operand)) (. U32 max)))
    (return (call snapshot (. value operand) layout expression))
  )
  (fn-expr _ is-answer Bool
    (param value Operand)
    ; Whether a struct is the answer of a call, in memory that nothing names. Any other struct
    ; is taken to lie in storage that code run later may change.
    (and (== (call operand-kind value) .operand-value) (== (. ([] (. ir instructions) (call operand-payload value)) op) .op-call))
  )
  (fn-do _ snapshot Operand
    (param value Operand)
    (param layout LayoutId)
    (param syntax SyntaxId)
    ; A copy of a struct in memory of the frame, which nothing else names.
    (let held (call frame layout))
    (call copy held value layout false syntax)
    (return held)
  )
  (fn-do _ is-inert Bool
    (param id SyntaxId)
    ; Whether evaluating an operand can change nothing: a literal, a name that calls nothing and
    ; that the type pass said evaluates nothing where it is read, a stored member it said the same
    ; of read from such an operand, or an operation of the machine on two such operands.
    (match? ([] (. tree nodes) id)
      (case (call .node-argument named)
        (return (call is-inert (. named expr)))
      )
      (case (call .node-get-expression row)
        (return
          (scope (and unplanned get-uncalled (call (. facts is-plain) (. unit reading) id) (call is-inert (. row object)))
            (lazy unplanned (== (call (. facts plan-of) (. unit reading) id) .plan-none))
            (lazy get-uncalled (== (call (. facts first-call) (. unit reading) id) no-fact))
          )
        )
      )
      (case (call .node-binary-expression row)
        (return
          (scope (and builtin-plan binary-uncalled (call is-inert (. row lhs)) (call is-inert (. row rhs)))
            (lazy builtin-plan (== (call (. facts plan-of) (. unit reading) id) .plan-builtin))
            (lazy binary-uncalled (== (call (. facts first-call) (. unit reading) id) no-fact))
          )
        )
      )
      (case .node-integer-syntax
        (return true)
      )
      (case .node-float-syntax
        (return true)
      )
      (case .node-string-syntax
        (return true)
      )
      (case .node-identifier
        (return (and (== (call (. facts first-call) (. unit reading) id) no-fact) (call (. facts is-plain) (. unit reading) id)))
      )
    )
    (return false)
  )
  (fn-do _ read-through Typed
    (param site SyntaxId)
    (param value Typed)
    (param through (of RowRange U32))
    ; What a function takes that a property answers for its receiver: each property the type
    ; pass named is read from what the one before it gave, the first from the receiver `value`.
    ; One a getter answers is read by a call of the getter the type pass kept for it, each time.
    ; A property that holds an optional has no shape here.
    (let held value)
    (for (in offset (..< 0 (. through count)))
      (let place ([] (. facts steps) (+ (. through start) offset)))
      (let property ([] (. types properties) place))
      (let owner (. held type))
      (if (== (. property storage-kind) .storage-getter)
        (let getter ([] (. facts step-callees) (+ (. through start) offset)))
        (if (or (== getter no-instance) (not (call is-callable getter)) getter-raises)
          (call refuse .refused-expression site)
          (break)
        )
        (lazy getter-raises (!= (. ([] (. instances signatures) getter) errors count) 0))
        (let mark (. pending length))
        (+= pending (. held operand))
        (= held (call call-method getter site mark))
        (continue)
      )
      (if (or (== (. property type) no-type) (call (. types is-optional) (. property type)))
        (call refuse .refused-expression site)
        (break)
      )
      (= held (call load-property site (. held operand) owner (. property name) true (. property type)))
    )
    (return held)
  )
  (fn-do _ emit-receiver Typed
    (param id SyntaxId)
    (param object SyntaxId)
    (param shared Bool (= false))
    ; The receiver of a call: the value written before the callee's name, or with none written
    ; the receiver of the function the call is in. It takes the conversion recorded for a
    ; receiver where its value is written, or else the one recorded at the call for the receiver
    ; of the function it is in, kept apart since the call may be the receiver written for another.
    ; A name a call calls, which is the receiver of the function its type declares for a call, is
    ; read as `emit-callee` reads it. A receiver `shared` by calls that each recorded its conversion
    ; takes those of its type.
    (let nothing (call make-operand .operand-void 0))
    (if (!= object 0)
      (return (call convert object .reason-receiver (call emit-callee object) 0 shared))
    )
    (if (and (. unit has-self) (!= (. unit reading) (. unit instance)) (call evaluates-value) (== (. filling count) 0))
      (return (call convert id .reason-own-receiver (call Typed (. unit self) (. unit self-type)) 0 shared))
    )
    (if (or (not (. unit has-self)) (and (!= (. unit reading) (. unit instance)) (!= (. unit reading) (. unit lender))))
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (return (call convert id .reason-own-receiver (call Typed (. unit self) (. unit owner-type)) 0 shared))
  )
  (fn-do _ default-argument Typed
    (param id SyntaxId)
    (param callee InstanceId)
    (param syntax SyntaxId)
    (param expected TypeId)
    ; The value of a parameter a call leaves out. With no default written it is an optional with
    ; no value. A default that runs no code is a constant, read through the facts of the
    ; callee, which typed it. A default that runs code and is no constant is answered by its own
    ; function, called here; any other is read from where its module stored it as it started.
    ; Each is then converted as the call records for a default, at its node or, for a call that
    ; no node of the body writes, among those recorded outside its body by the instance, or by
    ; the generated constructor that recorded the construction of a property being made, or as
    ; the callee recorded where the default is written.
    (let nothing (call make-operand .operand-void 0))
    (if (== syntax 0)
      (return (call absent-argument id expected))
    )
    (let callee-module (. ([] (. instances rows) callee) module))
    (let value (call Typed nothing no-type))
    (if (not (call (. tables default-runs-code) callee syntax))
      (let own-unit unit)
      (= unit (= (. unit source-module) callee-module))
      (= unit (= (. unit reading) callee))
      (= value (call emit-expression syntax))
      (= unit own-unit)
      (else
        (let row (call (. tables default-storage) callee syntax))
        (if (== row no-storage)
          (call refuse .refused-expression id)
          (return (call Typed nothing no-type))
        )
        (let kept ([] (. tables storage) row))
        (if (== (. kept function) no-function)
          (= value (call load-global kept id))
          (else
            (= value (call call-default id kept))
          )
        )
      )
    )
    (if (== (. value type) expected)
      (return value)
    )
    (let fact (call (. facts first-conversion) (. unit reading) id))
    (while (!= fact no-fact)
      (let row ([] (. facts conversions) fact))
      (if (and (== (. row reason) .reason-default) (== (. row from) (. value type)) (== (. row to) expected))
        (return (call convert-one id row value))
      )
      (= fact (. row next))
    )
    (= fact (call (. facts first-conversion) callee syntax))
    (while (!= fact no-fact)
      (let row ([] (. facts conversions) fact))
      (if (and (== (. row reason) .reason-default) (== (. row from) (. value type)) (== (. row to) expected))
        (return (call convert-one id row value))
      )
      (= fact (. row next))
    )
    (let holder (if-expr (!= (. making default-holder) no-instance) (. making default-holder) (. unit instance)))
    (if (and (!= holder no-instance) (or (== (. unit reading) (. unit instance)) (== (. unit reading) holder)))
      (let loose (call (. tables loose-conversion) holder id (. value type) .reason-default expected))
      (if (!= loose no-fact)
        (return (call convert-one id ([] (. facts conversions) loose) value))
      )
    )
    (call refuse .refused-conversion id)
    (return (call Typed nothing no-type))
  )
  (fn-do _ absent-argument Typed
    (param id SyntaxId)
    (param expected TypeId)
    ; The value of an argument a call leaves out that has no default: an optional with no value.
    (let nothing (call make-operand .operand-void 0))
    (if (not (call (. types is-optional) expected))
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (let layout (call layout-of expected id))
    (if (and (not (call (. tables layouts is-struct) layout)) (not (call is-null-form expected)))
      (call refuse .refused-type id)
      (return (call Typed nothing no-type))
    )
    (return (call empty-optional expected layout))
  )
  (fn-do _ drop-given _
    (param mark Size)
    (while (> (. given length) mark)
      (call (. given pop))
    )
  )
  (fn-do _ poll _
    (param syntax SyntaxId)
    ; A safepoint the collector can stop the task at, taken when the collector has asked for one,
    ; and the check that the task is not being terminated. The collector's control word says when
    ; either may be needed, so the poll reads that one word on its way through.
    (let control-address (call make-operand .operand-symbol (. tables bundle gc-public-control-word-symbol)))
    (let control (call load control-address 0 u8-layout syntax))
    (let watched (/or/ handshake-requested-control termination-requested-control))
    (let asked (call bitwise syntax .bitwise-and control (call integer .machine-u8 watched) u8-layout))
    (let slow (call (. ir reserve-block)))
    (let stop (call (. ir reserve-block)))
    (let checking (call (. ir reserve-block)))
    (let polled (call (. ir reserve-block)))
    (call branch asked slow polled)
    (call (. ir start-block) slow)
    (let collecting
      (call bitwise
        (block
          (arg syntax)
          (arg .bitwise-and)
          (arg control)
          (arg (call integer .machine-u8 handshake-requested-control))
          (arg u8-layout)
        )
      )
    )
    (call branch collecting stop checking)
    (call (. ir start-block) stop)
    (call call-runtime .runtime-safepoint syntax (. pending length))
    (call jump checking)
    (call (. ir start-block) checking)
    (call check-interrupt syntax)
    (call jump polled)
    (call (. ir start-block) polled)
  )
  (fn-do _ check-interrupt _
    (param syntax SyntaxId)
    ; The check that the task is not being terminated, in a function that `raises-termination`. A
    ; terminating task leaves through the landing pad with the termination panic.
    (if (not (call raises-termination))
      (return)
    )
    (let flags-address (call make-operand .operand-symbol (call (. tables runtime-symbol) .runtime-interrupt-flags)))
    (let resume (call (. ir reserve-block)))
    (call check-termination (call load flags-address 0 u8-layout syntax) syntax resume)
    (call (. ir start-block) resume)
  )
  (fn-expr _ raises-termination Bool
    ; Whether a poll or a C call that finds the task being terminated leaves with the termination
    ; panic: in a function that may panic already, or whose callers check the panic signal, or that
    ; no function calls, a module's main or a task's body. Elsewhere the task runs on until one of
    ; those finds it, so that no function may panic only because it polls.
    (or signals-panic (== (. function kind) .module-main) (== (. function kind) .task-body))
    (where
      (lazy signals-panic (or (. function may-panic) (. function carries)))
    )
  )
  (fn-expr _ is-unpolled Bool
    ; Whether the code emitted runs where no safepoint is allowed, by what its function declares or a
    ; `do` block around it is kept from, or because the collector never sees it: its loops poll
    ; nothing.
    (!= (/and/ (call effects-here) (. CompilationEffect no-safepoint)) 0)
  )
  (fn-do _ read-instance _
    (param read InstanceId)
    ; Makes the function emitted that of an instance, whose facts it reads: what depends on the
    ; instance alone follows it.
    (= unit (= (. unit instance) read))
    (= unit (= (. unit reading) read))
    (= unit (= (. unit owner-type) (if-expr (== read no-instance) no-type (. ([] (. instances rows) read) self-type))))
    (= in-zone (call is-free read))
  )
  (fn-expr _ is-free Bool
    (param function InstanceId)
    ; Whether a function runs where the collector never sees it.
    (and (!= function no-instance) (!= (/and/ (. ([] (. instances rows) function) effects) (. CompilationEffect gc-free)) 0))
  )
  (fn-do _ cross-zone _
    (param syntax SyntaxId)
    (param enters Bool)
    ; Enters or leaves the zone the collector never sees. Either way the collector reads the
    ; caller's stack at the call. A function that runs in the zone steps out of it and back as a
    ; callback does, and the zone stays the one its caller entered: the collector reads the stack
    ; from where that caller entered it, as the function's own frame is gone once it returns.
    (let boundary
      (block
        (case? (call is-free (. unit instance))
          (if-expr enters leave-callback (. RuntimeFunction runtime-enter-callback))
          (lazy leave-callback (. RuntimeFunction runtime-leave-callback))
        )
        (default
          (if-expr enters (. RuntimeFunction runtime-enter-zone) (. RuntimeFunction runtime-leave-zone))
        )
      )
    )
    (call call-runtime boundary syntax (. pending length) void-layout true)
  )
  (fn-expr _ closes-zone Bool
    (param answer U8)
    ; Whether the path of an error of a call ends the zone the caller entered for it: the callee
    ; runs in the zone and the caller does not, and the error came back with the callee stepped
    ; out of it.
    (and (== answer 3) (not (call is-free (. unit instance))))
  )
  (fn-do _ close-zone _
    (param syntax SyntaxId)
    ; Ends the zone entered for a call where an error or a panic came back with the callee stepped
    ; out of it: the step out is ended, then the zone.
    (call call-runtime .runtime-leave-callback syntax (. pending length) void-layout true)
    (call call-runtime .runtime-leave-zone syntax (. pending length) void-layout true)
  )
  (fn-do _ land-closed _
    (param pad IRBlockId)
    (param syntax SyntaxId)
    ; Emits a pad `closing-pad` made: it ends the zone and takes the landing pad.
    (if (== pad no-block)
      (return)
    )
    (let onward (call (. ir reserve-block)))
    (call jump onward)
    (call (. ir start-block) pad)
    (call close-zone syntax)
    (call jump (call landing-block syntax))
    (call (. ir start-block) onward)
  )
  (fn-do _ raised-text Operand
    (param raised Operand)
    (param slot U32)
    (param raises Bool)
    ; The text of a panic or an error, made by the converter its class has in a slot of its
    ; table. The call is checked where a converter some class has there may panic, unless a
    ; panic is being handled already.
    (let table (call load raised 0 pointer-layout 0))
    (let method (call load table (+ table-header-size (* slot table-slot-size)) pointer-layout 0))
    (let mark (. pending length))
    (+= pending raised)
    (return (call call method 0 mark .callee-value managed-layout (and raises (not in-landing))))
  )
  (fn-do _ raised-place Typed
    (param raised Operand)
    ; The text of the source of a panic or an error, or the empty text for one that has none.
    (let report (. instances report))
    (let layouts (. tables layouts))
    (let object ([] (. layouts objects) (. types panic-type)))
    (let field (call (. layouts field) object (+ object-header-fields (. report source-slot))))
    (let inner (call (. layouts field) (. field layout) 0))
    (let flag (call (. layouts field) (. field layout) 1))
    (let source (call address raised (. field offset) (. field layout) 0))
    (let with-source (call (. ir reserve-block)))
    (let unplaced (call (. ir reserve-block)))
    (let joined (call (. ir reserve-block)))
    (call branch (call load source (. flag offset) (. flag layout) 0) with-source unplaced)
    (call (. ir start-block) unplaced)
    (call jump joined)
    (call (. ir start-block) with-source)
    (let mark (. pending length))
    (+= pending (call address source (. inner offset) (. inner layout) 0))
    (let place (call call-instance (. report source-text) 0 mark))
    (let placed (. ir current))
    (call jump joined)
    (call (. ir start-block) joined)
    (let nowhere (call make-operand .operand-constant (call (. ir add-string) "")))
    (return (call Typed (call phi managed-layout (. place operand) placed nowhere unplaced) (. place type)))
  )
  (fn-do _ report-error _
    (param error Operand)
    (param id SyntaxId)
    (param prints Bool (= false))
    ; Reports an error that left the main of a module or the body of a spawned task, which no
    ; caller is left to handle: its text, made through its class table, the text of its source
    ; and its stack trace are given to the runtime, which ends the process, or with `prints` only
    ; prints them. A panic raised while a text is made leaves the function as any other does, which
    ; the type pass said of every one that lets an error out.
    (let report (. instances report))
    (let made (. report error-text))
    (if (or (== made no-instance) (== ([] (. tables instance-functions) made) no-function) (not (. function may-panic)))
      (call refuse .refused-statement id)
      (return)
    )
    (let slot ([] (. tables slots) made))
    (if (or (== slot no-slot-index) (== ([] (. tables instance-functions) (. report source-text)) no-function))
      (call refuse .refused-statement id)
      (return)
    )
    (let object ([] (. tables layouts objects) (. types panic-type)))
    (let trace (call (. tables layouts field) object (+ object-header-fields (. report trace-slot))))
    (let message (call raised-text error slot (call (. tables raises-through) made)))
    (let placed (call raised-place error))
    (let mark (. pending length))
    (if (not prints)
      (+= pending error)
    )
    (+= pending message)
    (+= pending (. placed operand))
    (+= pending (call load error (. trace offset) (. trace layout) 0))
    (call call-runtime
      (block
        (arg (if-expr prints .runtime-print-unhandled-error .runtime-report-unhandled-error))
        (arg 0)
        (arg mark)
      )
    )
  )
  (fn-do _ call-instance Typed
    (param callee InstanceId)
    (param syntax SyntaxId)
    (param mark Size)
    (param restores Bool (= false))
    (param watched Bool (= false))
    (param variant FunctionId (= no-function))
    (param held TypeId (= no-type))
    ; A call of an emitted instance with the pending arguments from `mark` on, or with
    ; `restores` of the initializer of a constructor, which returns nothing. One that may panic
    ; is checked, unless the call is made while a panic is already being handled, or the type
    ; pass says no call of the instance is checked and the call is not `watched`. A call between
    ; code the collector never sees and a function it does, or the other way, crosses the zone
    ; before the call and crosses back after it, unless the callee is one that reaches no safepoint
    ; there, which runs where it is called. A callee that returns a panic has stepped out
    ; of the zone, so the landing pad is always outside it, and a caller outside the zone ends
    ; the zone it entered before it lands. The slots of globals `do with` binds set
    ; for the call are put back on both ways out of it. Only a grammar calls a rule a
    ; module declares, which `calls-rule` says, and its function for a set of collectors is the
    ; `variant` where one is given, as is its function for a pattern that may raise errors, which
    ; answers with `held`.
    (if (and (not restores) (call (. tables is-prototype) callee))
      (return (call call-slot callee syntax mark watched))
    )
    (let rules calls-rule)
    (= calls-rule false)
    (let ruled (call rule-match program (. ([] (. instances rows) callee) module) (. ([] (. instances rows) callee) decl)))
    (if (and (not restores) (!= rules (!= ruled 0)))
      (call refuse .refused-expression syntax)
      (call drop-pending mark)
      (return (call Typed (call make-operand .operand-void 0) no-type))
    )
    (if (and (not restores) (!= (. function kind) .witness) (call answers-itself callee))
      (call refuse .refused-expression syntax)
      (call drop-pending mark)
      (return (call Typed (call make-operand .operand-void 0) no-type))
    )
    (let target-id
      (scope (if-expr restores ([] (. tables initializer-functions) callee) called-target)
        (lazy called-target (if-expr (!= variant no-function) variant ([] (. tables instance-functions) callee)))
      )
    )
    (throw (call Panic "A called instance is not in the emitted set") (if (== target-id no-function)))
    (blank)
    (let target ([] (. tables functions) target-id))
    (let signature ([] (. instances signatures) callee))
    (let raising (!= (. signature errors count) 0))
    (let raw takes-result)
    (= takes-result false)
    (if (and raising (or restores (not raw) (!= zone-answer 0)))
      (call refuse .refused-expression syntax)
    )
    (if (and (!= held no-type) (or raising restores (call is-free callee) in-zone))
      (call refuse .refused-expression syntax)
    )
    (let returned
      (scope (if-expr (!= held no-type) held (if-expr restores (. types void-type) promised))
        (lazy promised (if-expr raising (. signature result) (. signature returns)))
      )
    )
    (let returns (call layout-of returned syntax))
    (let flags U32 (if-expr (. ([] (. instances rows) callee) is-generator) generator-dependency 0))
    (if (. target may-panic)
      (= flags (/or/ flags may-panic-dependency))
    )
    (call (. ir depend) .callee-function target-id flags)
    (let checked (and (. target may-panic) (not in-landing) (or watched (not (. ([] (. instances rows) callee) quiet)))))
    (let symbol (call make-operand .operand-symbol (. target symbol)))
    (let saved (call prepare-stacks callee syntax))
    (let enters (and (call is-free callee) (or in-zone (not (call (. tables is-bounded) callee)))))
    (let crosses (!= enters in-zone))
    (let closing (and checked crosses enters (not (call is-free (. unit instance)))))
    (let restoring no-block)
    (if checked
      (for (in local saved)
        (if (!= local no-local)
          (= restoring (call (. ir reserve-block)))
          (break)
        )
      )
    )
    (if (and closing (== restoring no-block))
      (= restoring (call (. ir reserve-block)))
    )
    (if crosses
      (call cross-zone syntax enters)
    )
    (let result (call call symbol syntax mark .callee-function returns checked false restoring))
    (call cross-back syntax enters raising)
    (call restore-stacks callee saved syntax)
    (if (!= restoring no-block)
      (let onward (call (. ir reserve-block)))
      (call jump onward)
      (call (. ir start-block) restoring)
      (if closing
        (call close-zone syntax)
      )
      (call restore-stacks callee saved syntax)
      (call jump (call landing-block syntax))
      (call (. ir start-block) onward)
    )
    (return (call Typed result returned))
  )
  (fn-do _ prepare-stacks (list LocalId)
    (param callee InstanceId)
    (param site SyntaxId)
    ; Before the body of a spawned task, a lambda or a comprehension calls a function that reads
    ; globals `do with` binds outside its bindings of them, each slot no binding around the call
    ; holds is kept, and set to the state the body holds, as TypeScript does, and so for an effect's
    ; slot in the body of a loop on a stream. The local each is
    ; kept in, or none. A spawned task's slot is its own, so it stays set after the call, for a
    ; generator the call made to read when it runs. As a read of one, a call in a cleanup a landing pad runs is refused where a
    ; `do with` after the cleanup binds it. A nested function called holds what it captured, and is
    ; given nothing, as TypeScript gives a closure nothing.
    (let saved (list LocalId))
    (if (and (!= (. function kind) .task-body) (not (call is-closure-body)) (not (. unit received)))
      (return saved)
    )
    (let closes (or (== (. function kind) .task-body) (call is-closure-body)))
    (let called ([] (. instances rows) callee))
    (match? ([] (. ([] (. program modules) (. called module)) decls) (. called decl))
      (case (call .decl-function fn)
        (if (call is-nested-kind (. fn kind))
          (return saved)
        )
      )
    )
    (for (in row (call (. tables stack-needs) callee))
      (let local no-local)
      (let holds (and (!= row no-storage) (or closes (call reads-made-state row))))
      (if (and holds (!= (. scoping unwinding-from) 0) (call binds-after row (. scoping unwinding-from)))
        (call refuse .refused-expression site)
      )
      (if (and holds (not (call stack-bound row)))
        (let kept ([] (. tables storage) row))
        (= local (call (. ir add-local) (. kept layout)))
        (let slot (call stack-slot kept site))
        (call store-local local slot site)
        (let onward no-block)
        (if (call is-refused-row row)
          (let flag (call (. tables layouts field) (. kept layout) 0))
          (let copying (call (. ir reserve-block)))
          (= onward (call (. ir reserve-block)))
          (let kind (call load slot (. flag offset) (. flag layout) site))
          (call branch (call compare site .compare-equal kind (call integer .machine-u8 (as (call refused-kind) U64))) onward copying)
          (call (. ir start-block) copying)
        )
        (call copy
          (block
            (arg slot)
            (arg (call stack-state row site))
            (arg (. kept layout))
            (arg (. ([] (. tables layouts rows) (. kept layout)) is-managed))
            (arg site)
          )
        )
        (if (!= onward no-block)
          (call jump onward)
          (call (. ir start-block) onward)
