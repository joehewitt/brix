      (call refuse .refused-function declared)
      (return)
    )
    (= unit (= (. unit takes-self) false))
    (= unit (= (. unit has-self) false))
    (call (. ir add-argument) managed-layout)
    (= returns-type (call value-returned (. row yields)))
    (= (. ir returns) (call layout-of returns-type declared))
    (if (!= returns-type (. row yields))
      (call return-results (. row yields) declared)
    )
    (= unit (= (. unit environment) (call (. ir add-local) managed-layout)))
    (call store-local (. unit environment) (call make-operand .operand-argument 0) declared)
    (call share-self declared)
    (let dispatch (call (. ir reserve-block)))
    (let entry (call (. ir reserve-block)))
    (call jump dispatch)
    (call (. ir start-block) entry)
    (let mark (. open-cleanups length))
    (let own-scoping scoping)
    (= scoping (= (. scoping block-base) mark))
    (if (!= given-loop 0)
      (call emit-given body)
      (else-if (!= given-pipe 0)
        (call emit-pattern-pipe given-pipe)
      )
      (else-if (!= feeds 0)
        (call emit-feeds feeds)
      )
      (else
        (call emit-block body)
      )
    )
    (call close-cleanups mark)
    (= scoping own-scoping)
    (call emit-end declared)
    (call (. ir start-block) dispatch)
    (let base (call make-operand .operand-argument 0))
    (let step (call load base (. (call (. tables layouts field) layout 1) offset) i32-layout declared))
    (let next (call (. ir reserve-block)))
    (call branch (call compare declared .compare-equal step (call integer .machine-i32 0)) entry next)
    (call (. ir start-block) next)
    (for (in position (..< 0 (. resumes length)))
      (= next (call (. ir reserve-block)))
      (let number U64 (as (+ position 1) U64))
      (call branch
        (block
          (arg (call compare declared .compare-equal step (call integer .machine-i32 number)))
          (arg ([] resumes position))
          (arg next)
        )
      )
      (call (. ir start-block) next)
    )
    (for (in position (..< 0 (. closings length)))
      (if (== ([] closings position) no-block)
        (continue)
      )
      (= next (call (. ir reserve-block)))
      (let number U64 (- 0u64 position 2))
      (call branch
        (block
          (arg (call compare declared .compare-equal step (call integer .machine-i32 number)))
          (arg ([] closings position))
          (arg next)
        )
      )
      (call (. ir start-block) next)
    )
    (call return-absent declared)
  )
  (fn-do _ emit-fused-body _
    (param declared SyntaxId)
    (param body SyntaxId)
    (param plain Bool)
    (let row ([] (. instances rows) (. unit instance)))
    (if (or (not plain) (== (. row yields) no-type) (. row splits-yields) (!= result-type no-type))
      (call refuse .refused-function declared)
      (return)
    )
    (let step ([] (. tables functions) ([] (. tables step-functions) (. unit instance))))
    (= (. function may-panic) (. step may-panic))
    (= (. function carries) (. step carries))
    (= (. function polls) (. step polls))
    (= returns-type (call value-returned (. row yields)))
    (= (. ir returns) void-layout)
    (= (. ir signals) (or (. step may-panic) (. step carries) (. step polls)))
    (if (and (. step polls) (== budget no-local))
      (call open-polls)
    )
    (let mark (. open-cleanups length))
    (let own-scoping scoping)
    (= scoping (= (. scoping block-base) mark))
    (if (!= given-loop 0)
      (call emit-given body)
      (else-if (!= feeds 0)
        (call emit-feeds feeds)
      )
      (else
        (call emit-block body)
      )
    )
    (call close-cleanups mark)
    (= scoping own-scoping)
    (call emit-end declared)
  )
  (fn-do _ emit-given _
    (param id SyntaxId)
    ; The body of the function generated for a comprehension: its loop, over the container
    ; the function was given.
    (match? ([] (. tree nodes) id)
      (case (call .node-iterator-expression row)
        (call emit-for id (. row loop) (. row body))
        (return)
      )
    )
    (call refuse .refused-function id)
  )
  (fn-do _ takes-item Bool
    (param loop SyntaxId)
    ; Whether the loop of a comprehension is one whose first header is over a container and
    ; subscribes to nothing, and whose body reads the item whole, as `each` or `it` or under
    ; the name written for it, or as a pattern written as a match fitted it or its arms gave
    ; it.
    (let take (call (. facts loop-take) (. unit reading) loop))
    (match? ([] (. tree nodes) loop)
      (case (call .node-loop-syntax row)
        (let matched
          (scope (or (== take .take-arms) fitted-match)
            (lazy fitted-match (and (== take .take-fitted) (!= (call (. tree matched-name) (. row pattern)) (. row pattern))))
          )
        )
        (return (and (not (. row is-subscriber)) (or (== take .take-whole) matched) (!= (. row container) 0)))
      )
    )
    (return false)
  )
  (fn-do _ check-steps _
    ; Refuses a function that yields where a step of its body would read what the same call has
    ; not made: a value made before a yield, or a local stored before one. Only the environment
    ; keeps anything from one call to the next. On every path from where the function starts to
    ; a read, the value read must have been made, and the local stored; a local that holds a
    ; struct is stored where the whole of it is copied into or cleared, and one a call fills
    ; where the call is given its address. The values a join takes
    ; are made on the paths they arrive by, and are not looked at.
    (let values U32 (as (. ir instructions length) U32))
    (let width U32 (as (+ values (. ir locals length)) U32))
    (let words U32 (/ (+ width 63) 64))
    (let count (. ir blocks length))
    (let known (call (of (. storage allocate) U64) (+ (* count words) 1)))
    (let reached (call (of (. storage allocate) U8) (+ count 1)))
    (let made (call (of (. storage allocate) U64) (+ words 1)))
    (for (in block (..< 0 count))
      (= ([] reached block) 0)
    )
    (let first ([] (. ir order) 0))
    (= ([] reached first) 1)
    (for (in word (..< 0 words))
      (= ([] known (+ (* first words) word)) 0)
    )
    (let checking false)
    (while true
      (let changed false)
      (for (in turn (..< 0 (. ir order length)))
        (let block ([] (. ir order) turn))
        (if (== ([] reached block) 0)
          (continue)
        )
        (for (in word (..< 0 words))
          (= ([] made word) ([] known (+ (* block words) word)))
        )
        (let rows (. ([] (. ir blocks) block) instructions))
        (for (in id (..< (. rows start) (. rows end)))
          (let row ([] (. ir instructions) id))
          (if (!= (. row op) .op-phi)
            (for (in position (..< (. row operands start) (. row operands end)))
              (let operand ([] (. ir operands) position))
              (let payload (call operand-payload operand))
              (if (and (== (call operand-kind operand) .operand-block) (not checking))
                (if (call join-made known (* payload words) made words (== ([] reached payload) 0))
                  (= changed true)
                )
                (= ([] reached payload) 1)
              )
              (if (!= (call operand-kind operand) .operand-value)
                (continue)
              )
              (if (and checking (not (call is-made made payload)))
                (call refuse .refused-function (. row syntax))
              )
              (let source ([] (. ir instructions) payload))
              (if (!= (. source op) .op-local-address)
                (continue)
              )
              (if (or (and first-operand copy-op) (and call-op (. ([] (. ir locals) (. source aux)) filled)))
                (call mark-made made (+ values (. source aux)))
                (else-if (and checking (not (call is-made made (+ values (. source aux)))))
                  (call refuse .refused-function (. row syntax))
                )
              )
              (lazy first-operand (== position (. row operands start)))
              (lazy copy-op (or (== (. row op) .op-copy) (== (. row op) .op-zero)))
              (lazy call-op (or (== (. row op) .op-call) (== (. row op) .op-call-void)))
            )
          )
          (if (and (== (. row op) .op-load-local) checking (not (call is-made made (+ values (. row aux)))))
            (call refuse .refused-function (. row syntax))
          )
          (if (== (. row op) .op-store-local)
            (call mark-made made (+ values (. row aux)))
          )
          (call mark-made made id)
        )
      )
      (if checking
        (break)
      )
      (= checking (not changed))
    )
  )
  (fn-do _ keep-step _
    (param number U64)
    (param site SyntaxId)
    ; Keeps the step a function that yields has reached in its environment.
    (let layout ([] (. tables environments) (. unit instance)))
    (call store
      (block
        (arg (call make-operand .operand-argument 0))
        (arg (. (call (. tables layouts field) layout 1) offset))
        (arg (call integer .machine-i32 number))
        (arg false)
        (arg site)
      )
    )
  )
  (fn-do _ emit-yield _
    (param id SyntaxId)
    (param expr SyntaxId)
    (param whole Bool)
    ; A yield: the step that follows it is kept, and the function returns an optional that
    ; holds the item, converted to the type of the generator's items where the type pass
    ; recorded how. The next call goes on after the yield. A generator that is ended while it
    ; waits here runs the cleanups open here, as a return here would, and has finished.
    ; `<=? value` yields only where the optional written holds a value, what it holds, and
    ; goes on where it holds nothing. A yield written in a cleanup or outside a function that
    ; yields has no shape.
    (if (or whole (== expr 0))
      (call refuse .refused-statement id)
      (return)
    )
    (= held-chain expr)
    (let value (call emit-expression expr))
    (= held-chain 0)
    (call yield-item id value (call (. tree is-chained) expr))
  )
  (fn-do _ give-item _
    (param loop SyntaxId)
    (param site SyntaxId)
    (param item Typed)
    ; What a loop with no body does with each item: the loop of a pipe that writes each item gives it to
    ; the write recorded at the pipe, and the loop of a feed yields it, converted as recorded at
    ; `site`.
    (if (or (== (. writes length) 0) (!= (. ([] writes (- (. writes length) 1)) pipe) loop))
      (if (and (!= spreading 0) (== spreading loop))
        (call append-built site item false)
        (return)
      )
      (call yield-item site item false)
      (return)
    )
    (let write ([] writes (- (. writes length) 1)))
    (let given (. item type))
    (let sink (call load-local (. write sink) loop))
    (call call-operator loop (. write fact) (. write right) sink (. write sink-type) (. write left) (. item operand) given)
  )
  (fn-do _ yield-item _
    (param id SyntaxId)
    (param given-value Typed)
    (param optional Bool)
    ; Yields a value, as `emit-yield` tells it: the whole of it, or for an `optional` one what it holds,
    ; where it holds anything. The conversion to the type of the generator's items is the one recorded
    ; at `id` for the type the value has.
    (if (or (and (not stepping) (not fusing)) (. scoping cleaning) (!= (. unit reading) (. unit instance)))
      (call refuse .refused-statement id)
      (return)
    )
    (let item (call (. types optional-inner) returns-type))
    (let staying no-block)
    (let value given-value)
    (if (and optional (call (. types is-optional) (. value type)))
      (let held (. value type))
      (let tested (call present id value))
      (let given-block (call (. ir reserve-block)))
      (= staying (call (. ir reserve-block)))
      (call branch (. tested operand) given-block staying)
      (call (. ir start-block) given-block)
      (= value (call payload id (call Typed (. value operand) held)))
    )
    (= value (call convert-matched id .reason-return value item))
    (if (!= (. value type) item)
      (call refuse .refused-conversion id)
      (return)
    )
    (let given (call wrap id value returns-type))
    (if fusing
      (call yield-fused id (. given operand) staying)
      (return)
    )
    (let resumed (call (. ir reserve-block)))
    (+= resumes resumed)
    (call keep-step (as (. resumes length) U64) id)
    (= yielding true)
    (call return-value (. given operand) id)
    (= yielding false)
    (if (== (. open-cleanups length) 0)
      (+= closings no-block)
      (else
        (let closing (call (. ir reserve-block)))
        (+= closings closing)
        (call (. ir start-block) closing)
        (let around landing)
        (call run-cleanups 0 (. open-cleanups length))
        (= landing around)
        (call return-absent id)
      )
    )
    (call (. ir start-block) resumed)
    (if (!= staying no-block)
      (call jump staying)
      (call (. ir start-block) staying)
    )
  )
  (fn-do _ yield-fused _
    (param id SyntaxId)
    (param given Operand)
    (param staying IRBlockId)
    (let resumed (call (. ir reserve-block)))
    (let closing (if-expr (== (. open-cleanups length) 0) no-block (call (. ir reserve-block))))
    (let yielded (if-expr reads-errors (call read-case 0 given id) given))
    (let start U32 (. ir operands length))
    (call (. ir add-operand) yielded)
    (call (. ir add-operand) (call make-operand .operand-block resumed))
    (call append .op-yield id (call Span start 2) closing)
    (if (!= closing no-block)
      (call (. ir start-block) closing)
      (let around landing)
      (call run-cleanups 0 (. open-cleanups length))
      (= landing around)
      (call return-absent id)
    )
    (call (. ir start-block) resumed)
    (if (!= staying no-block)
      (call jump staying)
      (call (. ir start-block) staying)
    )
  )
  (fn-do _ return-results _
    (param result TypeId)
    (param declared SyntaxId)
    ; Makes the function one that raises errors: it returns a union whose first case is its
    ; value and whose others are the errors raised in its place, which the type pass made. A
    ; value that is itself an error is held in the first case too, as the reference holds it.
    (let held (. ir returns))
    (if (== result no-type)
      (call refuse .refused-function declared)
      (return)
    )
    (let layout (call layout-of result declared))
    (if (or (not (call (. tables layouts is-union) layout)) (!= (. (call (. tables layouts case-field) layout 0) layout) held))
      (call refuse .refused-function declared)
      (return)
    )
    (= result-type result)
    (= value-layout held)
    (= (. ir returns) layout)
  )
  (fn-expr _ returned LayoutId :get
    ; How the value the function returns is held, which is not what a function that raises
    ; errors returns.
    (if-expr (!= result-type no-type) value-layout (. ir returns))
  )
  (fn-do _ add-helper-argument _
    (param helper TypeId)
    (param site SyntaxId)
    ; Adds the argument a function a grammar calls is given the helper of the pattern
    ; calling it in, after where it keeps the farthest cursor, and runs its pattern under it.
    (= streaming (= (. streaming pattern-helper) (call make-operand .operand-argument (. ir arguments length))))
    (= streaming (= (. streaming pattern-helper-type) helper))
    (= streaming (= (. streaming helper-argument) true))
    (call (. ir add-argument) (call layout-of helper site))
  )
  (fn-do _ add-mark-argument _
    ; Adds the argument a rule's function is given where to keep the rollback mark its pattern holds
    ; as it passes, after the helper.
    (= streaming (= (. streaming marked-argument) (call make-operand .operand-argument (. ir arguments length))))
    (= streaming (= (. streaming marks-argument) true))
    (call (. ir add-argument) pointer-layout)
  )
  (fn-do _ ambient-helper _
    ; Keeps the argument of a rule's function that is the helper of the rule's pattern, where the
    ; rule is given one as `ambient-position` finds it.
    (let position (call ambient-position types instances (. unit instance)))
    (if (!= position (. U32 max))
      (= streaming (= (. streaming pattern-helper) (call make-operand .operand-argument position)))
      (= streaming (= (. streaming pattern-helper-type) (call (. instances argument-type) (. unit instance) position)))
    )
  )
  (fn-do _ match-direct _
    (param declared SyntaxId)
    (param matched SyntaxId)
    (param pattern SyntaxId)
    (param result TypeId)
    (param returned TypeId)
    (param stream-type TypeId)
    (param buffer-type TypeId)
    (param first U32)
    (param views FactId (= no-fact))
    (param extends FactId (= no-fact))
    (param marks SyntaxId (= 0))
    (param unread Bool (= false))
    (param observes Bool (= true))
    ; The body of a function a grammar calls, from the arguments at `first` on: the
    ; address the stream's items start at, the cursor to start from, the count of items, and
    ; where to keep where it ended, how far it read and the farthest cursor a part failed at.
    ; Its arms are tried in turn from the cursor, and the first that passes gives what it gave,
    ; an optional of which it returns; one that holds nothing where no arm passed. Where the
    ; stream may give more input, a part that reads past the end of the buffer asks it for more
    ; through the calls `views` and `extends`, and reads the address and count of its items
    ; again. The body the type pass found holds a rollback mark at `marks` gives the mark it holds
    ; where it passed, and gives it back where it failed. Where `unread`, no call reads what it
    ; gives, and its arms give the text they matched as `emit-bare-arm` says. Under a helper that
    ; observes literal words, the body tells it of them only where it `observes` them.
    (let index-layout (call layout-of (. types index-type) declared))
    (let buffer-layout (call layout-of buffer-type declared))
    (let item-layout (call layout-of (call class-arg types buffer-type 0) declared))
    (let layout (call layout-of result declared))
    (let answer-layout (call layout-of returned declared))
    (let nothing (call make-operand .operand-void 0))
    (let start (call make-operand .operand-argument (+ first 1)))
    (let extent (call (. ir add-local) index-layout))
    (call store-local extent start matched)
    (let error (call (. ir add-local) index-layout))
    (call store-local error start matched)
    (let data (call make-operand .operand-argument first))
    (let length (call make-operand .operand-argument (+ first 2)))
    (let stream (call make-operand .operand-argument 0))
    (let run
      (call direct-run
        (block
          (arg matched)
          (arg stream)
          (arg stream-type)
          (arg buffer-type)
          (arg data)
          (arg start)
          (arg length)
          (arg extent)
          (arg error)
          (arg index-layout)
          (arg item-layout)
          (arg buffer-layout)
          (arg views)
          (arg extends)
        )
      )
    )
    (let end (call (. ir add-local) index-layout))
    (let joined (call (. ir reserve-block)))
    (let failed (call (. ir reserve-block)))
    (let slot (call join-slot layout))
    (let mark (. joins length))
    (let held (. bound length))
    (let captured (. stream-captures length))
    (= lent-first (as (+ first (if-expr (. streaming helper-argument) 7 6) (if-expr (. streaming marks-argument) 1 0)) U32))
    (= streaming (= (. streaming storage-row) (if-expr (!= marks 0) (call (. facts storage-body-of) (. unit reading) marks) (. U32 max))))
    (= streaming (= (. streaming observer-row) (if-expr (and (!= marks 0) observes) (call (. facts observer-body-of) (. unit reading) marks) (. U32 max))))
    (call hold-captures run pattern)
    (= lent-first (. U32 max))
    (if (!= (. lent length) (. collector-args length))
      (call refuse .refused-function declared)
    )
    (if (!= marks 0)
      (call open-marks marks)
    )
    (if (and (. streaming marks-argument) (== (. streaming rollback-mark) no-local))
      (call refuse .refused-function declared)
    )
    (call plan-choices pattern)
    (let arrives (call emit-stream-arms run pattern result start false end joined slot failed unread))
    (call drop-bound held)
    (call drop-captures captured)
    (if (not arrives)
      (call drop-joins mark)
      (call refuse .refused-function declared)
      (return)
    )
    (let given (call close-joins joined mark layout slot))
    (let ended (call make-operand .operand-argument (+ first 3)))
    (let reached (call make-operand .operand-argument (+ first 4)))
    (let erred (call make-operand .operand-argument (+ first 5)))
    (call store ended 0 (call load-local end matched) false matched)
    (call store reached 0 (call load-local extent matched) false matched)
    (call store erred 0 (call load-local error matched) false matched)
    (if (. streaming marks-argument)
      (call give-mark matched)
    )
    (call return-lent false matched)
    (let wrapped (call wrap matched (call Typed given result) returned))
    (call return-value (. wrapped operand) matched)
    (call (. ir start-block) failed)
    (call rewind-mark matched)
    (call store reached 0 (call load-local extent matched) false matched)
    (call store erred 0 (call load-local error matched) false matched)
    (call return-lent true matched)
    (call return-value (. (call empty-optional returned answer-layout) operand) matched)
  )
  (fn-do _ direct-run StreamRun
    (param matched SyntaxId)
    (param stream Operand)
    (param stream-type TypeId)
    (param buffer-type TypeId)
    (param data Operand)
    (param start Operand)
    (param length Operand)
    (param extent LocalId)
    (param error LocalId)
    (param index-layout LayoutId)
    (param item-layout LayoutId)
    (param buffer-layout LayoutId)
    (param views FactId)
    (param extends FactId)
    ; What the pattern of a function a grammar calls runs over: the address the stream's
    ; items start at and their count as it is given them, kept in locals of their own where the
    ; stream may give more input and the type pass recorded the calls that ask it for more.
    (let nothing (call make-operand .operand-void 0))
    (if (or (== views no-fact) (== extends no-fact) (not (call may-grow stream-type)))
      (return
        (call StreamRun
          (block
            (arg matched)
            (arg stream)
            (arg stream-type)
            (arg nothing)
            (arg buffer-type)
            (arg data)
            (arg start)
            (arg length)
            (arg extent)
            (arg error)
            (arg index-layout)
            (arg item-layout)
            (arg buffer-layout)
          )
        )
      )
    )
    (let kept-data (call (. ir add-local) pointer-layout))
    (call store-local kept-data data matched)
    (let kept-length (call (. ir add-local) index-layout))
    (call store-local kept-length length matched)
    (return
      (call StreamRun
        (block
          (arg matched)
          (arg stream)
          (arg stream-type)
          (arg nothing)
          (arg buffer-type)
          (arg data)
          (arg start)
          (arg length)
          (arg extent)
          (arg error)
          (arg index-layout)
          (arg item-layout)
          (arg buffer-layout)
          (arg views)
          (arg extends)
          (arg no-local)
          (arg kept-data)
          (arg kept-length)
        )
      )
    )
  )
  (fn-do _ return-lent _
    (param failed Bool)
    (param site SyntaxId)
    ; Gives each collector a caller lent back what its list holds, cut back first to what it held
    ; as the function began where the rule failed, as the reference rewinds a borrowed collector.
    (for (in held lent)
      (if failed
        (call rewind-level (. held level) (. held mark) site)
      )
      (let pointer (call make-operand .operand-argument (. held argument)))
      (let layout (call layout-of (. held level collector) site))
      (call put pointer (call (. tables layouts field) layout 0) (call load-local (. held level items) site) site)
      (call put pointer (call (. tables layouts field) layout 1) (call load-local (. held level size) site) site)
    )
  )
  (fn-do _ bind-arguments _
    (param declared SyntaxId)
    ; Gives each argument of a body written in source its cell, and stores there the value it
    ; arrives with. A struct is the address of memory the function owns, and is read as that: it
    ; has no cell, and has no shape here where some read tracks it. An argument that nested
    ; functions capture is copied into the function's environment, and so is the item or the
    ; value a pipe gives the function generated for its right side. The arguments of a nested
    ; function written in the body are not this function's.
    (let binding (. ([] (. instances rows) (. unit instance)) binding))
    (if (== binding no-binding)
      (return)
    )
    (if (!= piped 0)
      (call keep-piped declared)
    )
    (let first U32 (if-expr (. unit takes-self) 1 0))
    (let position U32)
    (for (in offset (..< 0 (. unit slot-count)))
      (let slot ([] (. bindings slots) (+ (. unit slot-start) offset)))
      (if (or (!= (. slot kind) .slot-argument) (not (call owns (+ (. unit slot-start) offset))))
        (continue)
      )
      (let index (+ first position))
      (+= position 1)
      (if (>= index (. ir arguments length))
        (call refuse .refused-function declared)
        (return)
      )
      (let watched (!= (/and/ (. slot flags) (. SlotFlag slot-tracked)) 0))
      (if (and watched (call (. tables layouts is-struct) ([] (. ir arguments) index)))
        (call refuse .refused-function declared)
        (return)
      )
      (if (call is-captured (+ (. unit slot-start) offset))
        (let given (call (. instances argument-type) (. unit instance) (- position 1)))
        (call keep-captured
          (block
            (arg (+ (. unit slot-start) offset))
            (arg (call make-operand .operand-argument index))
            (arg given)
            (arg declared)
          )
        )
        (continue)
      )
      (let layout (as ([] (. ir arguments) index) LayoutId))
      (if (or (== layout void-layout) (call (. tables layouts is-struct) layout))
        (continue)
      )
      (let local (call (. ir add-local) layout (!= (/and/ (. slot flags) (. SlotFlag slot-address-taken)) 0)))
      (= ([] (. unit cells) offset) local)
      (call store-local local (call make-operand .operand-argument index) 0)
    )
  )
  (fn-do _ emit-value _
    (param body SyntaxId)
    (param site SyntaxId (= 0))
    (param closes Bool (= false))
    (param binds Bool (= false))
    ; The body of a function that is an expression: the named markup elements the type pass made where
    ; it starts are made first, then its statements run in order, and the value of the last is what the
    ; function returns, converted to the type it returns, at the `site` the type pass converted it at
    ; where there is one, before the cleanups open run. A lazy local declared after it is no statement
    ; of these. A last statement that raises under no condition gives no value: the function leaves
    ; there. A markup element that ends it, as what a function builds for a slot or the row of a markup
    ; loop, gives the receiver's property of its name the object, once made, where the type pass kept
    ; that. A `close` that closes what the object owns, as `closes` says, closes it once the value is
    ; made, as it returns. Where the function `binds` the state cells it made for what it builds, they
    ; are bound to the value once made (`U32.max - 1`).
    (call raise-elements body)
    (let last body)
    (match? ([] (. tree nodes) body)
      (case (call .node-block block)
        (= last 0)
        (for (in statement ([] (. tree children) (. block body)))
          (if (or (not (call runs-in-body statement)) (call is-lazy-local statement))
            (continue)
          )
          (if (!= last 0)
            (call emit-statement last)
          )
          (= last statement)
        )
      )
    )
    (if (== last 0)
      (call refuse .refused-function body)
      (return)
    )
    (match? ([] (. tree nodes) last)
      (case (call .node-assertion-syntax row)
        (if (== (. row condition) 0)
          (call emit-statement last)
          (return)
        )
      )
    )
    (let made (call emit-expression last))
    (let named (call (. facts named-store-of) (. unit reading) last))
    (if (!= named (. U32 max))
      (call store-named last named made)
    )
    (if binds
      (call bind-cells (- (. U32 max) 1) (. made operand))
    )
    (let value (call convert (if-expr (!= site 0) site last) .reason-return made))
    (if (!= (. value type) returns-type)
      (call refuse .refused-conversion last)
      (return)
    )
    (= value (call leaving value last true))
    (if closes
      (call close-owned last)
    )
    (call return-value (. value operand) last)
  )
