      (call zero made layout)
    )
    (for (in position (..< 0 (. signature args count)))
      (let field (call (. tables layouts field) layout position))
      (let given (call layout-of (call (. instances argument-type) (. unit instance) position) declared))
      (if (!= given (. field layout))
        (call refuse .refused-type declared)
        (return)
      )
      (call (. ir add-argument) given)
      (call put made field (call make-operand .operand-argument position) declared)
    )
    (if in-place
      (call return-nothing)
      (else
        (call return-value made declared)
      )
    )
  )
  (fn-do _ answers-itself Bool
    (param callee InstanceId)
    ; Whether a member of a table, or of a view of one, is one TypeScript answers itself where it
    ; is called: every one but `copy` and `fill`, and none of a row, whose getters run as any
    ; other. The type pass plans each call of one, so a call left to its body, which only the
    ; slot of an interface's table runs, has no shape.
    (let row ([] (. instances rows) callee))
    (let owner (if-expr (!= (. row self-type) no-type) (call intrinsic (. row self-type)) (. IntrinsicKind none)))
    (if (or (== owner .table-row) (== owner .immutable-table-row))
      (return false)
    )
    (match? ([] (. ([] (. program modules) (. row module)) decls) (. row decl))
      (case (call .decl-function fn)
        (let named (if-expr (. fn name) (. fn name text) ""))
        (return
          (scope (and table-member (!= named "copy") (!= named "fill"))
            (lazy table-member (and (not (. fn is-generated)) (!= (. fn owner) 0) (== (. row module) (. types table-module))))
          )
        )
      )
    )
    (return false)
  )
  (fn-do _ class-site SyntaxId
    (param module ModuleId)
    (param owner DeclId)
    ; Where a class is declared, which is where TypeScript places the code of a function it
    ; generates for the class.
    (match? ([] (. ([] (. program modules) module) decls) owner)
      (case (call .decl-class class)
        (return (. class syntax))
      )
    )
    (return 0)
  )
  (fn-do _ copy-items _
    (param site SyntaxId)
    (param into Operand)
    (param out Operand)
    (param count Operand)
    (param item LayoutId)
    ; Copies items of a column into another, as the runtime copies a slice: with what describes
    ; them where they hold pointers the collector follows.
    (let row ([] (. tables layouts rows) item))
    (let bytes (call arithmetic site .arithmetic-multiply count (call integer .machine-u64 (. row size)) u64-layout))
    (let mark (. pending length))
    (+= pending into)
    (+= pending out)
    (+= pending bytes)
    (if (not (. row is-managed))
      (call call-runtime .runtime-copy-plain-slice site mark pointer-layout)
      (return)
    )
    (if (== (. row buffer) no-string)
      (call drop-pending mark)
      (call refuse .refused-type site)
      (return)
    )
    (+= pending (call make-operand .operand-buffer-descriptor item))
    (call call-runtime .runtime-copy-slice site mark pointer-layout)
  )
  (fn-do _ emit-cast-constructor _
    (param declared SyntaxId)
    ; A value made from another by its type's name: a number, cast to the type, or a value of
    ; the type itself, which a union is called with once its argument is converted to it.
    (let type (. ([] (. instances rows) (. unit instance)) self-type))
    (let signature ([] (. instances signatures) (. unit instance)))
    (if (!= (. signature args count) 1)
      (call refuse .refused-function declared)
      (return)
    )
    (let source (call (. instances argument-type) (. unit instance) 0))
    (call (. ir add-argument) (call layout-of source declared))
    (= returns-type type)
    (= (. ir returns) (call layout-of type declared))
    (let value (call make-operand .operand-argument 0))
    (if (!= source type)
      (= value (. (call cast declared (call Typed value source) type) operand))
    )
    (call return-value value declared)
  )
  (fn-do _ layout-of LayoutId
    (param type TypeId)
    (param syntax SyntaxId)
    ; How a value of a type is held, or a refusal when the type has no layout yet.
    (let layout no-layout)
    (if (and (!= type no-type) (!= type invalid-type))
      (= layout ([] (. tables layouts values) type))
    )
    (if (== layout no-layout)
      (call refuse .refused-type syntax)
      (return void-layout)
    )
    (return layout)
  )
  (fn-expr _ intrinsic IntrinsicKind
    (param type TypeId)
    ; What a type is built on, as the type pass left it. Emission completes nothing: a type the
    ; type pass never completed is built on nothing, and no shape here takes it.
    (. ([] (. types completions) type) intrinsic)
  )
  (fn-expr _ is-aggregate Bool
    (param type TypeId)
    ; Whether a type's values are fields held in place: a tuple, a struct, an `ArrayBuilder`, or a
    ; table or a view of one, which TypeScript holds as the library's tuple.
    (call intrinsic-is-tuple-like (call intrinsic type))
  )
  (fn-expr _ is-text Bool
    (param type TypeId)
    (== (call intrinsic type) .string)
  )
  (fn-expr _ is-zeroed Bool
    (param type TypeId)
    ; Whether the constructor of a type with no arguments makes its zero: a number, or a C
    ; pointer, which TypeScript holds as a number.
    (or (call is-numeric-type type) (== (call intrinsic type) .cpointer))
  )
  (fn-expr _ is-numeric-type Bool
    (param type TypeId)
    ; Whether a type is a number, as the type pass left it: an integer or a float, and no pointer.
    (and (call intrinsic-is-numeric kind) (!= kind .cpointer))
    (where
      (lazy kind (call intrinsic type))
    )
  )
  (fn-do _ emit-expression Typed (?! Refused)
    (param id SyntaxId)
    ; The value of an expression before any conversion a use of it applies, with its type. A node the
    ; body being read did not reserve has no facts to follow. A tracked read has no shape here: nothing
    ; emitted follows what depends on it. `catch` of a value that carries no error is the value, and of
    ; any other has no shape yet. A name alone the type pass planned as a case, as a style declaration
    ; reads one, is that case.
    (let value (call make-operand .operand-void 0))
    (if (!= (. pins length) 0)
      (let held (call pin-of id))
      (if held
        (return (call Typed (. ([] pins held) value) (. ([] pins held) type)))
      )
    )
    (if (not (call (. facts node-slot) (. unit reading) id))
      (call refuse .refused-expression id)
      (return (call Typed value no-type))
    )
    (if (not (call is-consumable id))
      (call refuse .refused-conversion id)
      (return (call Typed value no-type))
    )
    (let type (call (. facts answer-type) (. unit reading) id))
    (match ([] (. tree nodes) id)
      (case (call .node-string-syntax row)
        (= value (call make-operand .operand-constant (call (. ir add-string) (. row text))))
      )
      (case (call .node-integer-syntax row)
        (= value (. (call emit-integer id (. row value)) operand))
      )
      (case (call .node-float-syntax row)
        (= value (. (call emit-float id (. row value)) operand))
      )
      (case (call .node-identifier row)
        (let plan (call (. facts plan-of) (. unit reading) id))
        (if (== plan .plan-case)
          (= value (. (call emit-case id (call (of RowRange SyntaxId)) false) operand))
          (else-if (== plan .plan-enum-value)
            (= value (. (call read-enum id) operand))
          )
          (else
            (let tracking
              (block
                (and (. row is-tracked) (or (!= (. live-actions length) 0) (call (. facts pulls) (. unit reading) id)))
              )
            )
            (if tracking
              (call track-name id (. row name))
            )
            (let named (call emit-identifier id (. row name)))
            (= value (. named operand))
            (if tracking
              (call track-collection id (call Typed value (. named type)))
            )
          )
        )
      )
      (case (call .node-binary-expression row)
        (let binary (call emit-binary id (. row op) (. row lhs) (. row rhs)))
        (= value (. binary operand))
        (if (call pipes-stream (. row op))
          (= type (. binary type))
        )
      )
      (case (call .node-unary-expression row)
        (= value (. (call emit-unary id (. row op) (. row operand)) operand))
      )
      (case (call .node-held-expression row)
        (= value (. (call emit-held id (. row expr)) operand))
      )
      (case (call .node-latest-expression row)
        (= value (. (call emit-latest id (. row expr)) operand))
      )
      (case .node-held-read
        (let slot (call held-slot id))
        (= value (. (call slot-value slot id) operand))
      )
      (case (call .node-match-expression row)
        (let pattern SyntaxId 0)
        (if (and (== (. row subject) 0) (not (. row is-optional)) (== (. row helper) 0))
          (match? ([] (. tree nodes) (. row body))
            (case (call .node-structure-match arms)
              (= pattern (. arms pattern))
            )
          )
        )
        (if (and (!= (. row subject) 0) (call helper-runs (. row helper)))
          (let matched
            (call emit-subject-match
              (block
                (arg id)
                (arg (. row subject))
                (arg (. row body))
                (arg (. row is-optional))
                (arg (. row helper))
                (arg false)
              )
            )
          )
          (= value (. matched operand))
          (else
            (= value (. (call emit-match id pattern) operand))
          )
        )
      )
      (case (call .node-structure-match row)
        (= value (. (call emit-match id (. row pattern)) operand))
      )
      (case (call .node-stream-match row)
        (= value (. (call emit-scoped-match id (. row pattern)) operand))
      )
      (case .node-block
        (let block (call emit-block-value id type))
        (= value (. block operand))
        (if (== type no-type)
          (= type (. block type))
        )
      )
      (case (call .node-cast-expression row)
        (if (== (call (. facts plan-of) (. unit reading) id) .plan-caught-cast)
          (= value (. (call emit-caught-cast id (. row lhs)) operand))
          (else-if (== (call (. facts plan-of) (. unit reading) id) .plan-reinterpret)
            (= value (. (call reinterpret id (call emit-expression (. row lhs)) type) operand))
          )
          (else-if (and (!= (call case-cursor-of (. row lhs)) (. U32 max)) cursor-typed)
            (= value (. ([] case-cursors (call case-cursor-of (. row lhs))) row))
          )
          (else
            (let converted (call convert id .reason-explicit (call emit-expression (. row lhs))))
            (= value (. converted operand))
            (if (!= (. converted type) type)
              (call refuse .refused-conversion id)
            )
          )
        )
        (lazy cursor-typed (== (. ([] case-cursors (call case-cursor-of (. row lhs))) type) type))
      )
      (case (call .node-type-predicate row)
        (if (. row is-contextual)
          (call refuse .refused-expression id)
          (else
            (let emitted (call emit-expression (. row expr)))
            (= value (. emitted operand))
            (if (!= (. emitted type) type)
              (call refuse .refused-conversion id)
            )
          )
        )
      )
      (case .node-function-syntax
        (= value (. (call emit-closure id) operand))
      )
      (case (call .node-do-task-block row)
        (= value (call emit-task-value id row))
      )
      (case (call .node-c-identifier row)
        (let constant (call (. program c-constant-text) (. unit source-module) (. row name)))
        (if constant
          (= value (. (call emit-integer id constant) operand))
          (else-if (call is-binding type)
            (= value (. (call name-binding id type 0) operand))
          )
          (else
            (call refuse .refused-expression id)
          )
        )
      )
      (case (call .node-range-expression row)
        (= value (. (call emit-range id row) operand))
      )
      (case (call .node-call-expression row)
        (if (and (call is-link (. row callable)) (not (call is-pinned (call receiver-of id))))
          (= value (. (call emit-chained id) operand))
          (else
            (= value (. (call emit-call-at id (. row callable) (. row args)) operand))
          )
        )
      )
      (case (call .node-optional-chain row)
        (if (!= id held-chain)
          (call refuse .refused-expression id)
          (else
            (let emitted (call emit-expression (. row expr)))
            (= value (. emitted operand))
            (if (!= (. emitted type) type)
              (call refuse .refused-conversion id)
            )
          )
        )
      )
      (case (call .node-catch-expression row)
        (if (and (!= (. row catchers count) 0) (call is-caught (. row body)))
          (= value (. (call emit-handled id (. row body) (. row catchers)) operand))
          (else-if (or (!= (. row catchers count) 0) retyped-body)
            (call refuse .refused-expression id)
          )
          (else-if (not (call is-caught (. row body)))
            (= value (. (call emit-expression (. row body)) operand))
          )
          (else
            (= value (. (call emit-expression (. row body)) operand))
            (call settle-result id value)
          )
        )
        (lazy retyped-body (!= (call (. facts node-type) (. unit reading) (. row body)) type))
      )
      (case (call .node-use-expression row)
        (= value (. (call emit-use id (. row expr)) operand))
      )
      (case (call .node-catch-optional-expression row)
        (if (call is-caught (. row body))
          (= value (. (call emit-catch-optional id (. row body)) operand))
          (else
            (= value (. (call emit-uncaught-optional id (. row body)) operand))
          )
        )
      )
      (case (call .node-get-expression row)
        (if (and (call is-link id) (not (call is-pinned (. row object))))
          (= value (. (call emit-chained id) operand))
          (else-if (and (. row is-tracked) (or (!= (. live-actions length) 0) (call (. facts pulls) (. unit reading) id)))
            (= value (. (call emit-tracked-get id (. row object) (. row name)) operand))
          )
          (else
            (= value (. (call emit-get id (. row object) (. row name)) operand))
          )
        )
      )
      (case (call .node-index-expression row)
        (let escaped (call escaped-event id))
        (if escaped
          (= value (. (call emit-escape id escaped) operand))
          (else-if (and (call is-link id) (not (call is-pinned (. row object))))
            (= value (. (call emit-chained id) operand))
          )
          (else-if (or (== (call (. facts plan-of) (. unit reading) id) .plan-view) proven-row)
            (= value (. (call emit-view-index id (. row object) (. row index)) operand))
          )
          (else-if (== (call (. facts plan-of) (. unit reading) id) .plan-table)
            (= value (. (call emit-table-index id (. row object) (. row index)) operand))
          )
          (else-if (== (call (. facts plan-of) (. unit reading) id) .plan-item)
            (= value (. (call emit-item id (. row object) (. row index)) operand))
          )
          (else-if (== (call (. facts plan-of) (. unit reading) id) .plan-array-item)
            (= value (. (call emit-array-item id (. row object) (. row index)) operand))
          )
          (else-if (!= (call own-call id) no-fact)
            (= value (. (call emit-index-call id ([] (. facts calls) (call own-call id)) (. row object) (. row index)) operand))
          )
          (else
            (= value (. (call emit-index id (. row object)) operand))
          )
        )
        (lazy proven-row (== (call (. facts plan-of) (. unit reading) id) .plan-proven-row))
      )
      (case (call .node-tuple-syntax row)
        (= value (. (call emit-tuple id (. row items)) operand))
      )
      (case (call .node-header-expression row)
        (= value (call emit-header id (. row expr) (. row items)))
      )
      (case (call .node-list-syntax row)
        (= value (. (call emit-list id (. row items)) operand))
      )
      (case (call .node-assign row)
        (= value (. (call emit-update id (. row op) (. row lhs) (. row rhs)) operand))
      )
      (case (call .node-print row)
        (call emit-print id (. row body))
      )
      (case (call .node-pipeline-expression row)
        (let pipeed (call emit-pipe id (. row op) (. row left) (. row right)))
        (= value (. pipeed operand))
        (if (call pipes-stream (. row op))
          (= type (. pipeed type))
        )
      )
      (case (call .node-iterator-expression row)
        (= value (. (call emit-comprehension id (. row loop)) operand))
      )
      (case (call .node-iterable-expression row)
        (= value (. (call emit-stream id (. row expr)) operand))
      )
      (case (call .node-argument row)
        (= value (call emit-argument-value id row))
      )
      (case .node-feed-expression
        (let listed (call emit-feed-list id))
        (= value (. listed operand))
        (= type (. listed type))
      )
      (case (call .node-anonymous-case row)
        (= value
          (block
            (. (call emit-case id (. row args) (== (call (. facts plan-of) (. unit reading) id) .plan-case-fields)) operand)
          )
        )
      )
      (case .node-state-machine
        (= value (. (call emit-machine-site id) operand))
      )
      (case (call .node-markup row)
        (= value (. (call emit-markup id (. row id) (. row type-id) (. row args) (. row body)) operand))
      )
      (case (call .node-slot-outlet row)
        (= value (call emit-outlet id (. row name) (. row body)))
      )
      (case (call .node-markup-read-expression row)
        (if (and (call is-link id) (not (call is-pinned (. row object))))
          (= value (. (call emit-chained id) operand))
          (else
            (= value (. (call emit-markup-read id (. row object)) operand))
          )
        )
      )
      (case (call .node-style-read-expression row)
        (if (and (call is-link id) (not (call is-pinned (. row object))))
          (= value (. (call emit-chained id) operand))
          (else
            (= value (. (call emit-style-read id (. row object)) operand))
          )
        )
      )
      (case .node-style-property-expression
        (= value (. (call emit-style-property id) operand))
      )
      (case .node-ref-identifier
        (= value (call emit-address-of id))
      )
      (case .node-type-identifier
        (= value (. (call type-value id type) operand))
      )
      (case .node-core-type-identifier
        (= value (. (call type-value id type) operand))
      )
      (case .node-type-arguments
        (= value (. (call type-value id type) operand))
      )
      (case .node-symbol
        (if (== (call (. facts plan-of) (. unit reading) id) .plan-case)
          (= value (. (call emit-case id (call (of RowRange SyntaxId)) false) operand))
          (else-if (== (call (. facts plan-of) (. unit reading) id) .plan-enum-value)
            (= value (. (call read-enum id) operand))
          )
          (else
            (call refuse .refused-expression id)
          )
        )
      )
      (default
        (call refuse .refused-expression id)
      )
    )
    (return (call Typed value type))
  )
  (fn-expr _ is-link Bool
    (param id SyntaxId)
    ; Whether a node is a link of an optional chain: a read, a read of a style or of a markup link
    ; or an index written after `?`, or one of what such a link gives, or a call of one. It is made
    ; only where its receiver holds a value.
    (match ([] (. tree nodes) id)
      (case (call .node-get-expression row)
        (or (call chains-at id (. row is-optional)) (call is-link (. row object)))
      )
      (case (call .node-index-expression row)
        (or (call chains-at id (. row is-optional)) (call is-link (. row object)))
      )
      (case (call .node-style-read-expression row)
        (or (call chains-at id (. row is-optional)) (and (!= (. row object) 0) (call is-link (. row object))))
      )
      (case (call .node-markup-read-expression row)
        (or (call chains-at id (. row is-optional)) (and (!= (. row object) 0) (call is-link (. row object))))
      )
      (case (call .node-call-expression row)
        (call is-link (. row callable))
      )
      (default
        false
      )
    )
  )
  (fn-expr _ chains-at Bool
    (param id SyntaxId)
    (param is-optional Bool)
    (and is-optional (!= (call (. facts chain-form) (. unit reading) id) .chain-plain))
  )
  (fn-expr _ held-type TypeId
    (param id SyntaxId)
    ; The type of what an expression gives where it is read: that of the value pinned for it, or
    ; the node's own.
    (if-expr held (. ([] pins held) type) (call (. facts node-type) (. unit reading) id))
    (where
      (lazy held (call pin-of id))
    )
  )
  (fn-do _ pin _
    (param node SyntaxId)
    (param value Operand)
    (param type TypeId)
    ; Keeps a value for every reading of an expression, until the pins are dropped back to where
    ; they stood before.
    (+= pins (call Pin node value type))
  )
  (fn-do _ unpin _
    (param mark Size)
    (while (> (. pins length) mark)
      (call (. pins pop))
    )
  )
  (fn-do _ pin-of (? Size)
    (param id SyntaxId)
    ; Where the value pinned last for an expression is, or nothing when none is.
    (let position (. pins length))
    (while (!= position 0)
      (-= position 1)
      (if (== (. ([] pins position) node) id)
        (return position)
      )
    )
    (return null)
  )
  (fn-expr _ is-pinned Bool
    (param id SyntaxId)
    (!= (call pin-of id) null)
  )
  (fn-expr _ gives Bool
    (param id SyntaxId)
    (param type TypeId)
    ; Whether a type is that of what a node gives by itself: the node's own, or for a link of an
    ; optional chain what the optional its node has holds.
    (or (== type node) (and (call is-link id) (call (. types is-optional) node) (== (call (. types optional-inner) node) type)))
    (where
      (lazy node (call (. facts node-type) (. unit reading) id))
    )
  )
  (fn-expr _ unlinked TypeId
    (param id SyntaxId)
    ; The type of what a node gives that is never an optional by itself: the node's own, or for
    ; a link of an optional chain what the optional its node has holds.
    (case? (and (call is-link id) (!= node no-type) (!= node invalid-type) (call (. types is-optional) node))
      (call (. types optional-inner) node)
    )
    (default
      node
    )
    (where
      (lazy node (call (. facts node-type) (. unit reading) id))
    )
  )
  (fn-expr _ receiver-of SyntaxId
    (param id SyntaxId)
    ; The receiver of a call of a link of an optional chain: what the name it calls is read from,
    ; or for a write to an event, what the event is read from.
    (match ([] (. tree nodes) id)
      (case (call .node-call-expression row)
        (call receiver-of (call called-link id (. row callable)))
      )
      (case (call .node-get-expression row)
        (. row object)
      )
      (case (call .node-index-expression row)
        (. row object)
      )
      (case (call .node-style-read-expression row)
        (. row object)
      )
      (case (call .node-markup-read-expression row)
        (. row object)
      )
      (default
        0u32
      )
    )
  )
  (fn-do _ emit-chained Typed
    (param id SyntaxId)
    ; A link of an optional chain, with the links before it. Where an optional the chain tests
    ; holds nothing no link after it is made, and the chain gives an optional that holds
    ; nothing. Where each holds a value, what the last link gives is held by the optional the
    ; node has, unless it is an optional already. A link that gives nothing gives an optional
    ; that holds nothing, as TypeScript does, so the chain then says nothing of whether it ran.
    (let nothing (call make-operand .operand-void 0))
    (if (call is-unmade id)
      (return (call emit-unmade id))
    )
    (let type (call (. facts node-type) (. unit reading) id))
    (if (or (== type no-type) (== type invalid-type) (not (call (. types is-optional) type)))
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (let layout (call layout-of type id))
    (if (and (not (call (. tables layouts is-struct) layout)) (not (call is-null-form type)))
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (let skipped (call (. ir reserve-block)))
    (let joined (call (. ir reserve-block)))
    (let slot (call join-slot layout))
    (let mark (. joins length))
    (let linked (call emit-within id skipped))
    (if (== (. linked type) (. types void-type))
      (= linked (call empty-optional type layout))
      (else-if (!= (. linked type) type)
        (= linked (call wrap id linked type))
      )
    )
    (call arrive id (. linked operand) joined slot)
    (call (. ir start-block) skipped)
    (call arrive id (. (call empty-optional type layout) operand) joined slot)
    (return (call Typed (call close-joins joined mark layout slot) type))
  )
  (fn-expr _ is-unmade Bool
    (param id SyntaxId)
    (== (call (. facts node-type) (. unit reading) (call receiver-of id)) (. types null-type))
  )
  (fn-do _ emit-unmade Typed (?! Refused)
    (param id SyntaxId)
    (let object (call receiver-of id))
    (if (== object 0)
      (call refuse .refused-expression id)
      (else-if (call tests-receiver id)
        (call emit-expression object)
      )
      (else
        (call emit-unmade object)
      )
    )
    (return (call default-value 0 (. types null-type) (call layout-of (. types null-type) id) id))
  )
  (fn-do _ emit-within Typed
    (param id SyntaxId)
    (param skipped IRBlockId)
    ; What a link of an optional chain gives by itself, where every optional the chain tests
    ; holds a value. Control leaves to `skipped` where one holds nothing. The link is the read,
    ; the index or the call its node is, made of the value its receiver holds as it is made of a
    ; receiver that is no optional.
    (let nothing (call make-operand .operand-void 0))
    (let object (call receiver-of id))
    (let inside (call held-receiver id object skipped))
    (let pin-mark (. pins length))
    (call pin object (. inside operand) (. inside type))
    (let linked (call emit-link id))
    (call unpin pin-mark)
    (return linked)
  )
  (fn-do _ held-receiver Typed (?! Refused)
    (param id SyntaxId)
    (param object SyntaxId)
    (param skipped IRBlockId)
    ; The value a link of an optional chain is made of. A link written after `?` tests the
    ; optional before it, which is evaluated once, and is made of what that holds. A link
    ; written with no `?` after another link is made of what that link gives by itself, with no
    ; optional between the two, as TypeScript unrolls a chain: one that gives nothing, or an
    ; optional, has no shape here. A tracked read's object that is a member named alone is
    ; tracked before it is tested, as `emit-tracked-get` says.
    (let nothing (call make-operand .operand-void 0))
    (if (== object 0)
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (if (not (call tests-receiver id))
      (let given (call emit-within object skipped))
      (if (or (== (. given type) (. types void-type)) (call (. types is-optional) (. given type)))
        (call refuse .refused-expression id)
      )
      (return given)
    )
    (let root (only-if (call tracked-root object) (if (call tracks-link id))))
    (if root
      (call track object (. unit self) root)
    )
    (let receiver (call emit-expression object))
    (let held (. receiver type))
    (if (not (call (. types is-optional) held))
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (let tested (call present object receiver))
    (let filled (call (. ir reserve-block)))
    (call branch (. tested operand) filled skipped)
    (call (. ir start-block) filled)
    (return (call payload object (call Typed (. receiver operand) held)))
  )
  (fn-expr _ tests-receiver Bool
    (param id SyntaxId)
    ; Whether a link of an optional chain is written after `?`, or is a call of one that is.
    (match ([] (. tree nodes) id)
      (case (call .node-get-expression row)
        (call chains-at id (. row is-optional))
      )
      (case (call .node-index-expression row)
        (call chains-at id (. row is-optional))
      )
      (case (call .node-style-read-expression row)
        (call chains-at id (. row is-optional))
      )
      (case (call .node-markup-read-expression row)
        (call chains-at id (. row is-optional))
      )
      (case (call .node-call-expression row)
        (call tests-receiver (call called-link id (. row callable)))
      )
      (default
        false
      )
    )
  )
  (fn-do _ called-link SyntaxId
    (param id SyntaxId)
    (param callable SyntaxId)
    (if (!= (. facts event-uses length) 0)
      (let used (call (. tables event-use-of) (. unit reading) id))
      (if (and used (or (== (. used kind) .event-publish) (== (. used kind) .event-route)))
        (match? ([] (. tree nodes) (. used reference))
          (case (call .node-index-expression row)
            (return (. row object))
          )
        )
        (return (. used reference))
      )
    )
    (return callable)
  )
  (fn-do _ emit-link Typed
    (param id SyntaxId)
    ; A link of an optional chain, made of the value its receiver holds: the read, the read of a
    ; style, the index or the call the node is, as it is made of a receiver that is no optional.
    (let nothing (call make-operand .operand-void 0))
    (match? ([] (. tree nodes) id)
      (case (call .node-get-expression row)
        (let plan (call (. facts plan-of) (. unit reading) id))
        (if (and (. row is-tracked) (or (!= (. live-actions length) 0) (call (. facts pulls) (. unit reading) id)))
          (return (call emit-tracked-get id (. row object) (. row name)))
        )
        (if (or (== plan .plan-none) (== plan .plan-field) (== plan .plan-guarded-read) address-plan)
          (return (call emit-get id (. row object) (. row name)))
        )
        (lazy address-plan (or (== plan .plan-address) (== plan .plan-reinterpret)))
      )
      (case (call .node-index-expression row)
        (if (== (call (. facts plan-of) (. unit reading) id) .plan-item)
          (return (call emit-item id (. row object) (. row index)))
        )
        (if (== (call (. facts plan-of) (. unit reading) id) .plan-array-item)
          (return (call emit-array-item id (. row object) (. row index)))
        )
        (if (!= (call own-call id) no-fact)
          (return (call emit-index-call id ([] (. facts calls) (call own-call id)) (. row object) (. row index)))
        )
        (return (call emit-index id (. row object)))
      )
      (case (call .node-call-expression row)
        (return (call emit-call-at id (. row callable) (. row args)))
      )
      (case (call .node-style-read-expression row)
        (return (call emit-style-read id (. row object)))
      )
      (case .node-style-property-expression
        (return (call emit-style-property id))
      )
      (case (call .node-markup-read-expression row)
        (return (call emit-markup-read id (. row object)))
      )
    )
    (call refuse .refused-expression id)
    (return (call Typed nothing no-type))
  )
  (fn-do _ emit-caught-cast Typed
    (param id SyntaxId)
    (param lhs SyntaxId)
    ; A cast out of a union written under `catch`: what the union holds as the case asked for,
    ; as the value of what may be an error, and where it holds another case the error that is
    ; elsewhere the message of the panic raised. The error is given no source and no trace.
    (let nothing (call make-operand .operand-void 0))
    (let type (call (. facts node-type) (. unit reading) id))
    (let layout (call layout-of type id))
    (let made-error (. instances report union-error))
    (if (or (not (call carries-error type)) (not (call (. tables layouts is-union) layout)) in-zone)
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (if (or (!= (. ([] (. tables layouts rows) layout) cases count) 2) (== made-error no-instance))
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (if (== ([] (. tables instance-functions) made-error) no-function)
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (let value (call emit-expression lhs))
    (let first (call (. tables layouts case-field) layout 0))
    (let second (call (. tables layouts case-field) layout 1))
    (let made (call frame layout))
    (call zero made layout)
    (let failed (call (. ir reserve-block)))
    (let joined (call (. ir reserve-block)))
    (let own-matching matching)
    (let jumps fail-jumps)
    (= matching (= (. matching failing) failed))
    (let held (call convert id .reason-explicit value))
    (= matching own-matching)
    (if (!= (. held type) (. first type))
      (call refuse .refused-conversion id)
    )
    (call put made first (. held operand) id)
    (call jump joined)
    (if (!= fail-jumps jumps)
      (call (. ir start-block) failed)
      (let mark (. pending length))
      (for (in position (..< 0 (. ([] (. instances signatures) made-error) args count)))
        (+= pending (. (call absent-argument id (call (. instances argument-type) made-error position)) operand))
      )
      (let error nothing)
      (let called (call call-instance made-error id mark))
      (= error (. called operand))
      (if (!= (. called type) (. second type))
        (call refuse .refused-conversion id)
      )
      (call store made 0 (call integer .machine-u8 1) false id)
      (call put made second error id)
      (call jump joined)
    )
    (call (. ir start-block) joined)
    (return (call Typed made type))
  )
  (fn-do _ emit-handled Typed
    (param id SyntaxId)
    (param body SyntaxId)
    (param catchers (of RowRange SyntaxId))
    (param dropped Bool (= false))
    ; An expression with handlers: what it gives where no error was raised in its place, and
    ; else what the first handler that takes the error gives. A handler is a pattern the error
    ; is matched against, with what it captures, and its body. An error the type pass said no
    ; handler takes leaves the function, as one raised there would. A handler whose body is a
    ; block runs its statements, and its last gives the value. A handler that gives an
    ; error raises nothing: the whole is then a value that may be that error. An expression
    ; whose own value is an error has no shape here. One written as a statement, whose value is
    ; `dropped`, gives nothing: each handler runs its body for what it does. An error that came
    ; back outside the zone the collector never sees is handled there, and a handler that goes on
    ; enters the zone again where the caller runs in it. A handler the type pass found can not
    ; match is passed over. An optional chain to a call that raises is tested first: where it
    ; made no call the whole gives `null` as the type pass joined it, and handlers take the errors
    ; of the call it made.
    (let nothing (call make-operand .operand-void 0))
    (let type (call (. facts node-type) (. unit reading) id))
    (let fact (call (. facts constant-of) (. unit reading) id))
    (if (or (!= (call (. facts plan-of) (. unit reading) id) .plan-handled) (== fact no-fact))
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (let leaving (. ([] (. facts constants) fact) bits))
    (let raw (call emit-expression body))
    (let answer (call take-zone-answer))
    (let zoned in-zone)
    (let held (. raw type))
    (let absent no-block)
    (if (and (call (. types is-optional) held) (call carries-error (call (. types optional-inner) held)))
      (let tested (call present id raw))
      (let filled (call (. ir reserve-block)))
      (= absent (call (. ir reserve-block)))
      (call branch (. tested operand) filled absent)
      (call (. ir start-block) filled)
      (= raw (call payload id (call Typed (. raw operand) held)))
      (= held (. raw type))
    )
    (if (not (call carries-error held))
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (let layout (call layout-of held id))
    (let gives (and (not dropped) (!= type no-type) (!= type invalid-type) (!= type (. types void-type))))
    (let made (if-expr gives (call layout-of type id) void-layout))
    (let first (call (. tables layouts case-field) layout 0))
    (if (call extends (. first type) (. types error-type))
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (let joined (call (. ir reserve-block)))
    (let slot (if-expr gives (call join-slot made) nothing))
    (let mark (. joins length))
    (let given (call (. ir reserve-block)))
    (let raised (call (. ir reserve-block)))
    (call branch (call case-test id (. raw operand) 0) given raised)
    (call (. ir start-block) given)
    (call settle-zone-answer id answer)
    (if gives
      (call give-handled id (call Typed (call take (. raw operand) first id) (. first type)) type joined slot)
      (else
        (call jump joined)
      )
    )
    (call (. ir start-block) raised)
    (if (call closes-zone answer)
      (call close-zone id)
    )
    (if (!= answer 0)
      (= in-zone false)
    )
    (for (in catcher ([] (. tree children) catchers))
      (match? ([] (. tree nodes) catcher)
        (case (call .node-catcher row)
          (if (== (call (. facts plan-of) (. unit reading) catcher) .plan-never)
            (continue)
          )
          (let next (call (. ir reserve-block)))
          (let named (. bound length))
          (call emit-pattern (. row type) (call Typed (. raw operand) held) next)
          (if (not gives)
            (call emit-block (. row body))
            (call rejoin-zone id answer zoned)
            (call jump joined)
            (else-if (not (call arm-raises (. row body)))
              (let expression (call only-expression (. row body)))
              (if (call (. tree is-block) (. row body))
                (let opened (. open-cleanups length))
                (let own-scoping scoping)
                (= scoping (= (. scoping block-base) opened))
                (if (== expression 0)
                  (= expression (call emit-leading (. row body)))
                )
                (if (== expression 0)
                  (call refuse .refused-expression (. row body))
                  (else
                    (let value (call emit-expression expression))
                    (let closed (call close-value value opened own-scoping expression))
                    (call rejoin-zone id answer zoned)
                    (call give-handled id closed type joined slot)
                  )
                )
                (else-if (== expression 0)
                  (call refuse .refused-expression (. row body))
                )
                (else
                  (let value (call emit-expression expression))
                  (call rejoin-zone id answer zoned)
                  (call give-handled id value type joined slot)
                )
              )
            )
          )
          (call drop-bound named)
          (call (. ir start-block) next)
        )
      )
    )
    (let bit U64 1)
    (for (in index (..< 1 (. ([] (. tables layouts rows) layout) cases count)))
      (let place bit)
      (= bit (* bit 2))
      (if (== (/and/ leaving place) 0)
        (continue)
      )
      (let field (call (. tables layouts case-field) layout index))
      (let leaves (call (. ir reserve-block)))
      (let next (call (. ir reserve-block)))
      (call branch (call case-test id (. raw operand) index) leaves next)
      (call (. ir start-block) leaves)
      (call leave-with (call take (. raw operand) field id) (. field type) id)
      (call (. ir start-block) next)
    )
    (call return-zero .return-normal)
    (= in-zone zoned)
    (if (!= absent no-block)
      (call (. ir start-block) absent)
      (if gives
        (call give-handled
          (block
            (arg id)
            (arg (call default-value 0 (. types null-type) (call layout-of (. types null-type) id) id))
            (arg type)
            (arg joined)
            (arg slot)
          )
        )
        (else
          (call jump joined)
        )
      )
    )
    (if (not gives)
      (call (. ir start-block) joined)
      (return (call Typed nothing (. types void-type)))
    )
    (let result (call close-joins joined mark made slot))
    (return (call Typed result type))
  )
  (fn-do _ give-handled _
    (param id SyntaxId)
    (param value Typed)
    (param type TypeId)
    (param joined IRBlockId)
    (param slot Operand)
    ; Leaves what one side of an expression with handlers gives for the whole. Where the whole
    ; is a value that may be an error, because some handler gives one, a side that gives an
    ; error is held as the case of its class or of the nearest above it, and any other side as
    ; the value. Else the side is converted as the sides record for its type, and one that
    ; gives an error has no shape.
    (let given value)
    (let is-error (call extends (. given type) (. types error-type)))
    (if (not (call carries-error type))
      (if is-error
        (call refuse .refused-expression id)
        (return)
      )
      (if (!= (. given type) type)
        (= given (call join id (call Typed (. value operand) (. given type))))
      )
      (if (!= (. given type) type)
        (call refuse .refused-conversion id)
      )
      (call arrive id (. given operand) joined slot)
      (return)
    )
    (let layout (call layout-of type id))
    (if is-error
      (let index (call error-case-of layout (. given type)))
      (if (== index (. U32 max))
        (call refuse .refused-expression id)
        (return)
      )
      (= given
        (call make-union
          (block
            (arg id)
            (arg type)
            (arg index)
            (arg (call Typed (. value operand) (. (call (. tables layouts case-field) layout index) type)))
          )
        )
      )
      (else
        (let inner (. (call (. tables layouts case-field) layout 0) type))
        (if (!= (. given type) inner)
          (= given (call join id (call Typed (. value operand) (. given type))))
        )
        (if (!= (. given type) inner)
          (call refuse .refused-conversion id)
        )
        (= given (call make-union id type 0 given))
      )
    )
    (call arrive id (. given operand) joined slot)
  )
  (fn-do _ arm-raises Bool
    (param body SyntaxId)
    ; Whether the body of an arm that is to give a value leaves in place of it, as the type pass
    ; noted: its last statement raises under no condition, returns, or goes on to a loop's next
    ; turn or out of it. The body is emitted here, and what follows it is never run.
    (if (not (call (. facts is-leaving) (. unit reading) body))
      (return false)
    )
    (call emit-block body)
    (return true)
  )
  (fn-expr _ is-caught Bool
    (param body SyntaxId)
    ; Whether what is written under `catch` is a call, whose errors are what the catch holds, an
    ; operator or an index a function answers, or a cast, which the type pass planned to give an
    ; error where it is out of a union and fails. Nothing else has a shape there.
    (match ([] (. tree nodes) body)
      (case .node-call-expression
        true
      )
      (case .node-index-expression
        (!= (call own-call body) no-fact)
      )
      (case .node-identifier
        true
      )
      (case .node-get-expression
        true
      )
      (case .node-cast-expression
        true
      )
      (case .node-unary-expression
        (!= (call own-call body) no-fact)
      )
      (case .node-binary-expression
        (!= (call own-call body) no-fact)
      )
      (default
        false
      )
    )
  )
  (fn-do _ emit-catch-optional Typed
    (param id SyntaxId)
    (param body SyntaxId)
    ; `catch? value`: what the expression gives as an optional, which holds nothing where an
    ; error was raised in its place. An expression that raises nothing gives its value so, and
    ; one that gives nothing or an optional gives it as it is. A value that is itself an optional
    ; and may be an error is that optional, or one that holds nothing where an error was raised.
    (let nothing (call make-operand .operand-void 0))
    (let type (call (. facts node-type) (. unit reading) id))
    (let raw (call emit-expression body))
    (let raw-type (. raw type))
    (call settle-result id (. raw operand))
    (if (and (call (. types is-optional) raw-type) (call carries-error (call (. types optional-inner) raw-type)))
      (return (call catch-held id (call Typed (. raw operand) raw-type) type))
    )
    (if (not (call carries-error raw-type))
      (if (== raw-type type)
        (return (call Typed (. raw operand) raw-type))
      )
      (return (call wrap id (call Typed (. raw operand) raw-type) type))
    )
    (return (call caught id (call Typed (. raw operand) raw-type) type))
  )
  (fn-do _ emit-uncaught-optional Typed
    (param id SyntaxId)
    (param body SyntaxId)
    ; `catch? value` over what is no call and so raises nothing: the value as an optional.
    (let type (call (. facts node-type) (. unit reading) id))
    (let raw (call emit-expression body))
    (if (call carries-error (. raw type))
      (call refuse .refused-expression id)
      (return raw)
    )
    (if (== (. raw type) type)
      (return raw)
    )
    (return (call wrap id raw type))
  )
  (fn-do _ catch-held Typed
    (param id SyntaxId)
    (param raw Typed)
    (param type TypeId)
    ; `catch?` of an optional that holds a value or an error raised in its place, as an optional
    ; chain to a call that raises gives: nothing where it holds nothing, and otherwise what holds
    ; the value, or nothing where an error was raised.
    (let nothing (call make-operand .operand-void 0))
    (let held (. raw type))
    (let made-layout (call layout-of type id))
    (let tested (call present id raw))
    (let given (call (. ir reserve-block)))
    (let other (call (. ir reserve-block)))
    (let joined (call (. ir reserve-block)))
    (let slot (call join-slot made-layout))
    (let mark (. joins length))
    (call branch (. tested operand) given other)
    (call (. ir start-block) given)
    (let inner (call payload id (call Typed (. raw operand) held)))
    (let made (call caught id inner type))
    (call arrive id (. made operand) joined slot)
    (call (. ir start-block) other)
    (call arrive id (. (call empty-optional type made-layout) operand) joined slot)
    (return (call Typed (call close-joins joined mark made-layout slot) type))
  )
  (fn-do _ caught Typed
    (param id SyntaxId)
    (param raw Typed)
    (param type TypeId)
    ; What holds the value of an expression that may be an error raised in its place, or nothing
    ; where one was raised.
    (let nothing (call make-operand .operand-void 0))
    (let layout (call layout-of (. raw type) id))
    (let made-layout (call layout-of type id))
    (let nullable (call is-null-form type))
    (if (or (not (call (. tables layouts is-union) layout)) (not (call (. types is-optional) type)) unstructured)
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (lazy unstructured (and (not (call (. tables layouts is-struct) made-layout)) (not nullable)))
    (let field (call (. tables layouts case-field) layout 0))
    (let held (call (. types optional-inner) type))
    (if (or (== (. field type) type) (and nullable (== (. field type) held)))
      (let slot (call join-slot made-layout))
      (let mark (. joins length))
      (let given (call (. ir reserve-block)))
      (let other (call (. ir reserve-block)))
      (let joined (call (. ir reserve-block)))
      (call branch (call case-test id (. raw operand) 0) given other)
      (call (. ir start-block) given)
      (call arrive id (call take (. raw operand) field id) joined slot)
      (call (. ir start-block) other)
      (call arrive id (. (call empty-optional type made-layout) operand) joined slot)
      (return (call Typed (call close-joins joined mark made-layout slot) type))
    )
    (if nullable
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (let inner (call (. tables layouts field) made-layout 0))
    (let flag (call (. tables layouts field) made-layout 1))
    (let holds (!= (. field layout) void-layout))
    (if (or (call (. types is-optional) (. field type)) (and holds (or (!= (. field type) held) (!= (. field layout) (. inner layout)))))
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (if (and (not holds) (!= (. inner layout) i8-layout))
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (let made (call frame made-layout))
    (call zero made made-layout)
    (call empty-texts made 0 type made-layout id)
    (let given (call (. ir reserve-block)))
    (let joined (call (. ir reserve-block)))
    (call branch (call case-test id (. raw operand) 0) given joined)
    (call (. ir start-block) given)
    (if holds
      (call put made inner (call take (. raw operand) field id) id)
    )
    (call store made (. flag offset) (call integer .machine-i8 1) false id)
    (call jump joined)
    (call (. ir start-block) joined)
    (return (call Typed made type))
  )
  (fn-expr _ carries-error Bool
    (param type TypeId)
    ; Whether a type is a value or one of the errors raised in its place.
    (match ([] (. types rows) type)
      (case .type-result
        true
      )
      (default
        false
      )
    )
  )
  (fn-do _ emit-held Typed (?! Refused)
    (param id SyntaxId)
    (param expr SyntaxId)
    ; The middle of a chain of orderings is evaluated once, and its value is kept under its slot
    ; for the ordering that reads it. The value has the node's type.
    (let nothing (call make-operand .operand-void 0))
    (let slot (call held-slot id))
    (let offset (call slot-offset slot id))
    (let value (call emit-expression expr))
    (if (!= (. value type) (call (. facts node-type) (. unit reading) id))
      (call refuse .refused-conversion id)
      (return (call Typed nothing no-type))
    )
    (= ([] (. unit kept) offset) (. value operand))
    (= ([] (. unit kept-types) offset) (. value type))
    (return value)
  )
  (fn-do _ held-by U32
    (param ordering SyntaxId)
    ; The place of the slot an ordering keeps its right side under, for the ordering after it in
    ; a chain. No place for any other expression.
    (match? ([] (. tree nodes) ordering)
      (case (call .node-binary-expression row)
        (match? ([] (. tree nodes) (. row rhs))
          (case .node-held-expression
            (let slot (call held-slot (. row rhs)))
            (return (call slot-offset slot (. row rhs)))
          )
        )
      )
    )
    (return no-place)
  )
  (fn-do _ held-slot SlotId
    (param id SyntaxId)
    ; The slot the middle of a chain of orderings is kept under, which the node that holds it
    ; and the node that reads it both resolve to.
    (let binding (. ([] (. instances rows) (. unit reading)) binding))
    (if (!= binding no-binding)
      (let resolution (call (. bindings resolution-of) binding id))
      (if (and (== (. resolution kind) .resolve-slot) (== (. ([] (. bindings slots) (. resolution slot)) kind) .slot-held))
        (return (. resolution slot))
      )
    )
    (call refuse .refused-expression id)
    (return (. unit slot-start))
  )
  (fn-do _ slot-value Typed (?! Refused)
    (param slot SlotId)
    (param id SyntaxId)
    ; The value kept under the slot of a chain's middle, for the ordering that reads it. It is
    ; there only in the right side of the `&&` whose left side holds it: every path to that side
    ; has evaluated the middle. The value has the node's type.
    (let nothing (call make-operand .operand-void 0))
    (let offset (call slot-offset slot id))
    (if (or (!= offset (. unit open-held)) (== (call operand-kind ([] (. unit kept) offset)) .operand-void))
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (if (!= ([] (. unit kept-types) offset) (call (. facts node-type) (. unit reading) id))
      (call refuse .refused-conversion id)
      (return (call Typed nothing no-type))
    )
    (return (call Typed ([] (. unit kept) offset) ([] (. unit kept-types) offset)))
  )
  (fn-do _ is-consumable Bool
    (param id SyntaxId)
    ; Whether every conversion recorded at a node is one a shape here applies.
    (let fact (call (. facts first-conversion) (. unit reading) id))
    (while (!= fact no-fact)
      (let row ([] (. facts conversions) fact))
      (if (not (call is-applied (. row reason)))
        (return false)
      )
      (= fact (. row next))
    )
    (return true)
  )
  (fn-do _ emit-integer Typed
    (param id SyntaxId)
    (param text String)
    ; An integer literal as a number of the type it is written as: its bits cut to the width of
    ; the type and extended by the sign of its layout, or the float nearest it. A unit whose
    ; class has a constructor is constructed from the number.
    (let nothing (call make-operand .operand-void 0))
    (let literal (call parse-integer-literal text))
    (if (. literal overflow)
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (let type (call written-type id))
    (let layout (call layout-of type id))
    (if (call is-float layout)
      (let magnitude (as (. literal value) F64))
      (return
        (call construct-unit
          (block
            (arg id)
            (arg (call float-number layout (if-expr (. literal negative) (- magnitude) magnitude)))
            (arg type)
          )
        )
      )
    )
    (if (not (call is-integer layout))
      (call refuse .refused-type id)
      (return (call Typed nothing no-type))
    )
    (let bits (if-expr (. literal negative) (- 0 (. literal value)) (. literal value)))
    (let width (. ([] (. types completions) (call builtin-number types type)) bit-size))
    (if (== width 0)
      (call refuse .refused-type id)
      (return (call Typed nothing no-type))
    )
    (if (< width 64)
      (let mask (- (/lshift/ 1u64 width) 1))
      (let is-negative (== (/and/ (/zrshift/ bits (- width 1)) 1) 1))
      (= bits (/and/ bits mask))
      (if (and is-negative (call is-signed layout) (== width (* (. ([] (. tables layouts rows) layout) size) 8)))
        (= bits (/or/ bits (- (. U64 max) mask)))
      )
    )
    (return (call construct-unit id (call integer (call (. tables layouts kind-of) layout) bits) type))
  )
  (fn-do _ written-type TypeId
    (param id SyntaxId)
    ; The type a number is written as: its node's, or with a unit whose class has a constructor
    ; the type of what the constructor takes, which the type pass recorded as a call at the node.
    (let call (call answering (call (. facts first-call) (. unit reading) id)))
    (if (== call no-fact)
      (return (call (. facts node-type) (. unit reading) id))
    )
    (let row ([] (. facts calls) call))
    (let called (and (!= (. row callee) no-instance) (not (. row is-partial)) (== (. row next) no-fact)))
    (let constructs (or (== (. row form) .call-constructor) (== (. row form) .call-this-constructor)))
    (if (or (not called) (not constructs) (!= (. ([] (. instances signatures) (. row callee)) args count) 1))
      (call refuse .refused-expression id)
      (return no-type)
    )
    (return (call (. instances argument-type) (. row callee) 0))
  )
  (fn-do _ construct-unit Typed
    (param id SyntaxId)
    (param number Operand)
    (param type TypeId)
    ; A number as its literal gives it: the number itself, or with a unit whose class has a
    ; constructor what the constructor returns for the number.
    (let call (call answering (call (. facts first-call) (. unit reading) id)))
    (if (== call no-fact)
      (return (call Typed number type))
    )
    (let mark (. pending length))
    (+= pending number)
    (let made (call call-instance (. ([] (. facts calls) call) callee) id mark))
    (if (!= (. made type) (call (. facts node-type) (. unit reading) id))
      (call refuse .refused-conversion id)
    )
    (return made)
  )
  (fn-do _ emit-float Typed
    (param id SyntaxId)
    (param text String)
    ; A float literal as the float of the type it is written as nearest to what it writes. A
    ; unit whose class has a constructor is constructed from the number.
    (let nothing (call make-operand .operand-void 0))
    (let type (call written-type id))
    (let layout (call layout-of type id))
    (if (not (call is-float layout))
      (call refuse .refused-type id)
      (return (call Typed nothing no-type))
    )
    (for (in index (..< 0 (. text length)))
      (let char ([] text index))
      (let is-digit (and (>= char '0') (<= char '9')))
      (let is-sign (or (== char '+') (== char '-')))
      (if (and (not is-digit) (not is-sign) (!= char '.') (!= char 'e') (!= char 'E'))
        (call refuse .refused-expression id)
        (return (call Typed nothing no-type))
      )
    )
    (return (call construct-unit id (call float-number layout (as text F64)) type))
  )
  (fn-do _ float-number Operand
    (param layout LayoutId)
    (param value F64)
    (return (call make-operand .operand-number (call (. ir add-float) (call (. tables layouts kind-of) layout) value)))
  )
  (fn-do _ integer Operand
    (param kind MachineKind)
    (param bits U64)
    (return (call make-operand .operand-number (call (. ir add-number) kind bits)))
  )
  (fn-do _ convert Typed
    (param site SyntaxId)
    (param reason ConversionReason)
    (param value Typed)
    (param raised SyntaxId (= 0))
    (param shared Bool (= false))
    ; Applies the conversions the type pass recorded at a site for one reason, in order. A panic
    ; one of them raises is raised at the site, or at the node given for it. The name of a lazy
    ; local that its one read evaluates has the conversion of that read recorded at the value it
    ; is declared with, and takes there the ones that convert what was read. A text written in
    ; source that a function returns has its conversion recorded for a reason of its own. A stream
    ; piped through a function keeps the conversion of the function at the pipe beside those of
    ; its own value, and only those that take the value's type apply there, as they do where the
    ; value is `shared` by calls that each recorded its own.
    (let result value)
    (let found false)
    (let several (or shared (call keeps-several site)))
    (let fact (call (. facts first-conversion) (. unit reading) site))
    (while (!= fact no-fact)
      (let row ([] (. facts conversions) fact))
      (let fits
        (scope (or (== (. row reason) reason) literal-return)
          (lazy literal-return (and (== reason .reason-return) (== (. row reason) .reason-literal-return)))
        )
      )
      (if (and fits (or (not several) (== (. row from) (. result type))))
        (= result (call convert-one site row result raised))
        (= found true)
      )
      (= fact (. row next))
    )
    (if (or found (not (. unit inlines)))
      (return result)
    )
    (let declared (call inlined-value site))
    (if (== declared 0)
      (return result)
    )
    (= fact (call (. facts first-conversion) (. unit reading) declared))
    (while (!= fact no-fact)
      (let row ([] (. facts conversions) fact))
      (if (and (== (. row reason) reason) (== (. row from) (. result type)))
        (= result (call convert-one site row result raised))
      )
      (= fact (. row next))
    )
    (return result)
  )
  (fn-do _ keeps-several Bool
    (param site SyntaxId)
    ; Whether a node keeps the conversions of several values: a stream piped through a function,
    ; a subscription an object owns, where the subscriber, the subscription and its tracker are
    ; each converted, or the name of a keyed event whose endpoint the receiver claims, where the
    ; endpoint and its tracker are.
    (if (or (call (. tables owned-subscription-of) (. unit reading) site) claimed-or-read)
      (return true)
    )
    (lazy claimed-or-read
      (block
        (or (call (. facts address-claim-of) (. unit reading) site) (call (. facts latest-read-of) (. unit reading) site))
      )
    )
    (match? ([] (. tree nodes) site)
      (case (call .node-pipeline-expression row)
        (return (call pipes-stream (. row op)))
      )
      (case (call .node-binary-expression row)
        (return (call pipes-stream (. row op)))
      )
    )
    (return false)
  )
  (fn-do _ inlined-value SyntaxId
    (param id SyntaxId)
    ; The value a lazy local is declared with, for a node that is the one read of the local and
    ; evaluates it. No node for any other.
    (if (or (== id 0) (== (. unit instance) no-instance) (!= (. unit reading) (. unit instance)))
      (return 0)
    )
    (let binding (. ([] (. instances rows) (. unit instance)) binding))
    (if (== binding no-binding)
      (return 0)
    )
    (match? ([] (. tree nodes) id)
      (case .node-identifier
        (let resolution (call (. bindings resolution-of) binding id))
        (if (and (== (. resolution kind) .resolve-slot) (call (. bindings lazy-inlines) (. resolution slot)))
          (match? ([] (. tree nodes) (. ([] (. bindings slots) (. resolution slot)) group))
            (case (call .node-declare declaration)
              (return (. declaration right))
            )
          )
        )
      )
    )
    (return 0)
  )
  (fn-do _ convert-fill Typed
    (param site SyntaxId)
    (param value Typed)
    ; Converts what a constructor fills a property from to the property's type. The type pass
    ; records the conversion at the argument, or at the property, which is no node of the
    ; constructor's body.
    (if (!= (call (. facts first-conversion) (. unit reading) site) no-fact)
      (return (call convert site .reason-assignment value))
    )
    (let result value)
    (let fact (call (. tables loose-conversion) (. unit instance) site (. result type)))
    (while (!= fact no-fact)
      (let held (. result type))
      (= result (call convert-one site ([] (. facts conversions) fact) result))
      (= fact
        (scope (if-expr (!= (. result type) held) next-conversion no-fact)
          (lazy next-conversion (call (. tables loose-conversion) (. unit instance) site (. result type)))
        )
      )
    )
    (return result)
  )
  (fn-do _ convert-self Typed
    (param site SyntaxId)
    (param reason ConversionReason)
    ; The object being made converted as the type pass recorded at a site, which may be no node of
    ; the function's body, as `convert-fill` finds it. Refused where none was recorded.
    (if (!= (call (. facts first-conversion) (. unit reading) site) no-fact)
      (return (call convert site reason (call Typed (. unit self) (. ([] (. instances rows) (. unit reading)) self-type))))
    )
    (let fact (call (. tables loose-conversion) (. unit reading) site (. ([] (. instances rows) (. unit reading)) self-type) reason))
    (if (== fact no-fact)
      (call refuse .refused-function site)
      (return (call Typed (. unit self) no-type))
    )
    (return
      (call convert-one
        (block
          (arg site)
          (arg ([] (. facts conversions) fact))
          (arg (call Typed (. unit self) (. ([] (. instances rows) (. unit reading)) self-type)))
        )
      )
    )
  )
  (fn-do _ convert-from Typed
    (param site SyntaxId)
    (param reason ConversionReason)
    (param value Operand)
    ; Applies the conversions the type pass recorded at a site for one reason, as `convert` does,
    ; to a value of the type the first of them converts from.
    (let fact (call (. facts first-conversion) (. unit reading) site))
    (while (!= fact no-fact)
      (let row ([] (. facts conversions) fact))
      (if (== (. row reason) reason)
        (return (call convert site reason (call Typed value (. row from))))
      )
      (= fact (. row next))
    )
    (call refuse .refused-conversion site)
    (return (call Typed value no-type))
  )
  (fn-do _ convert-one Typed (?! Refused)
    (param site SyntaxId)
    (param row ConversionFact)
    (param value Typed)
    (param raised SyntaxId (= 0))
    ; Applies one conversion the type pass recorded to a value of the type it converts from, as the
    ; reference converts it; an unwrap that fails is reported at `raised` where one is given.
    (if (!= (. row from) (. value type))
      (call refuse .refused-conversion site)
      (return value)
    )
    (let kind (. row kind))
    (if (or (!= (. row runs) no-instance) (. row casts))
      (return (call make-function site row (. value operand)))
    )
    (if (and (== (. row from) (. types null-type)) (call (. types is-optional) (. row to)))
      (let empty (call layout-of (. row to) site))
      (if (and (not (call (. tables layouts is-struct) empty)) (not (call is-null-form (. row to))))
        (call refuse .refused-conversion site)
      )
      (return (call empty-optional (. row to) empty))
    )
    (if (and (== kind .relation-wrap-cast) (!= (. row case-index) (. U32 max)))
      (return (call wrap-case site row value))
    )
    (if (== (call intrinsic (. row from)) .union)
      (let to-text (== (. row to) (. types string-type)))
      (if (and to-text (or (== kind .relation-unwrap-cast) (== kind .relation-string-cast)))
        (return (call union-text site row (. value operand)))
      )
      (if (or (== kind .relation-unwrap-cast) (== kind .relation-down-cast))
        (return (call unwrap-case (if-expr (== raised 0) site raised) row (. value operand)))
      )
      (if (and (== kind .relation-final-cast) (== (call intrinsic (. row to)) .union))
        (return (call rewrap site row (. value operand)))
      )
    )
    (if (and (== kind .relation-unwrap-cast) (== (call view-shape (. row from)) 4) (== (. row to) (call viewed-item (. row from))))
      (return (call row-item site (. value operand) (. row from)))
    )
    (if (and (== kind .relation-unwrap-cast) (call holds-row (. row from)) (== (. row to) (call table-row-type (. row from))))
      (return (call table-row-item site (. value operand) (. row from)))
    )
    (if (and (== kind .relation-unwrap-cast) (call holds-row (. row from)) union-row)
      (return (call shared-base site (. value operand) (. row from) (. row to)))
    )
    (lazy union-row (== (call intrinsic (call table-row-type (. row from))) .union))
    (if (and (== kind .relation-side-cast) (!= (call view-shape (. row from)) 0) (!= (call view-shape (. row to)) 0))
      (return (call Typed (. value operand) (. row to)))
    )
    (if (and (== kind .relation-side-cast) (== (call intrinsic (. row to)) .table-span) (== (call intrinsic (. row from)) .tuple))
      (return (call zip-span site (. value operand) (. row from) (. row to)))
    )
    (if (and (== kind .relation-unwrap-cast) optional-from (!= (call (. types null-case) (. row to)) (. U32 max)))
      (return (call unwrap-or-null site row value))
    )
    (lazy optional-from (call (. types is-optional) (. row from)))
    (if (and (== kind .relation-unwrap-cast) (call (. types is-optional) (. row from)) text-to-pointer)
      (return (call text-or-null site row value))
    )
    (lazy text-to-pointer (and (call is-text (call (. types optional-inner) (. row from))) (== (call intrinsic (. row to)) .cpointer)))
    (if (and (== kind .relation-unwrap-cast) (call (. types is-optional) (. row from)))
      (let held (call unwrap (if-expr (== raised 0) site raised) value))
      (if (== (. held type) (. row to))
        (return held)
      )
      (if (and (== (call intrinsic (. held type)) .union) (!= (. row case-index) (. U32 max)))
        (let inner row)
        (= (. inner from) (. held type))
        (return (call unwrap-case (if-expr (== raised 0) site raised) inner (. held operand)))
      )
      (let scalar (or (call is-numeric-type (. held type)) (== (call intrinsic (. held type)) .cpointer)))
      (if (and (== (. row callee) no-instance) scalar scalar-target)
        (return (call cast site held (. row to)))
      )
      (lazy scalar-target (or (call is-numeric-type (. row to)) (== (call intrinsic (. row to)) .cpointer)))
      (if (and (== (. row callee) no-instance) (call (. tables is-class) (. held type)) (== (call intrinsic (. row to)) .cpointer))
        (return (call cast site held (. row to)))
      )
      (if (and (== (. row callee) no-instance) interface-value (== (call intrinsic (. row to)) .cpointer))
        (return (call held-object site (. held operand) (. row to)))
      )
      (lazy interface-value (== (call intrinsic (. held type)) .interface))
      (if (and (== (. row callee) no-instance) union-value (== (call intrinsic (. row to)) .cpointer))
        (return (call union-object site held (. row to)))
      )
      (lazy union-value (== (call intrinsic (. held type)) .union))
      (if (and (== (. row callee) no-instance) (call (. tables is-class) (. held type)) (call descends (. row to) (. held type)))
        (return
          (call down-cast
            (block
              (arg (if-expr (== raised 0) site raised))
              (arg (. held operand))
              (arg (. row to))
              (arg (== (. row reason) .reason-declaration))
            )
          )
        )
      )
      (call refuse .refused-conversion site)
      (return value)
    )
    (if (== kind .relation-same)
      (if (!= (call layout-of (. row from) site) (call layout-of (. row to) site))
        (call refuse .refused-conversion site)
      )
      (return (call Typed (. value operand) (. row to)))
    )
    (if (== kind .relation-interface-cast)
      (return (call make-interface site (. row from) (. row to) (. value operand)))
    )
    (if (and (== kind .relation-string-cast) (== (call intrinsic (. row from)) .type-relation) (call is-text (. row to)))
      (return (call Typed (. value operand) (. row to)))
    )
    (if (== kind .relation-equal)
      (return (call equalize site value (. row to) (. row ratio)))
    )
    (if (and (== kind .relation-up-cast) (call (. tables is-class) (. row from)) (call (. tables is-class) (. row to)))
      (return (call Typed (. value operand) (. row to)))
    )
    (let declared (== (. row reason) .reason-declaration))
    (if (and (== kind .relation-down-cast) (call (. tables is-class) (. row from)) (call (. tables is-class) (. row to)))
      (return (call down-cast (if-expr (== raised 0) site raised) (. value operand) (. row to) declared))
    )
    (if (and (== kind .relation-interface-down-cast) (call (. tables is-class) (. row from)))
      (return
        (call subclass-interface
          (block
            (arg (if-expr (== raised 0) site raised))
            (arg (. value operand))
            (arg (. row from))
            (arg (. row to))
            (arg declared)
          )
        )
      )
    )
    (if (== kind .relation-interface-down-cast)
      (return (call held-as (if-expr (== raised 0) site raised) (. value operand) (. row to) declared))
    )
    (if (or (== kind .relation-up-cast) (== kind .relation-string-cast))
      (if (and (call is-text (. row from)) (call is-text (. row to)))
        (return (call Typed (. value operand) (. row to)))
      )
    )
    (if (and (== kind .relation-up-cast) (call is-aggregate (. row from)) (call is-aggregate (. row to)))
      (let base (call layout-of (. row to) site))
      (let derived (call layout-of (. row from) site))
      (if (not (call is-leading base derived))
        (call refuse .refused-conversion site)
        (return value)
      )
      (let led (call snapshot (. value operand) base site))
      (return (call Typed led (. row to)))
    )
    (if (and (== kind .relation-string-cast) (!= (. row parts) no-fact) (call is-text (. row to)))
      (return (call tuple-text site row (. value operand)))
    )
    (if (and (== kind .relation-final-cast) (!= (. row parts) no-fact))
      (return (call recast site row (. value operand)))
    )
    (if (and final-or-side (== (. row to) (. types bool-type)) (!= (. row callee) no-instance))
      (let asked ([] (. tables instance-functions) (. row callee)))
      (let raises
        (scope (and (!= asked no-function) asked-panics)
          (lazy asked-panics (or (. ([] (. tables functions) asked) may-panic) (call (. tables raises-through) (. row callee))))
        )
      )
      (if (and raises (not (. function may-panic)))
        (call refuse .refused-conversion site)
        (return value)
      )
      (let tested (call ask-empty site value (. row callee)))
      (return (call Typed (. tested operand) (. row to)))
    )
    (lazy final-or-side (or (== kind .relation-final-cast) (== kind .relation-side-cast)))
    (if (and (== kind .relation-final-cast) plain-bool (call is-number (call layout-of (. row from) site)))
      (return (call cast site value (. row to)))
    )
    (lazy plain-bool (and (== (. row to) (. types bool-type)) (== (. row parts) no-fact)))
    (if (and (== kind .relation-final-cast) (== (. row to) (. types bool-type)) (== (. row parts) no-fact) from-pointer)
      (return (call compare-zero site value .compare-not-equal))
    )
    (lazy from-pointer (== (call intrinsic (. row from)) .cpointer))
    (if (and (== kind .relation-string-cast) (call is-text (. row to)) void-return)
      (return (call Typed (call make-operand .operand-constant (call (. ir add-string) "")) (. row to)))
    )
    (lazy void-return (and (== (. row reason) .reason-return) (== (call intrinsic (. row from)) .void)))
    (if (and (== kind .relation-string-cast) (call is-text (. row to)))
      (let text (call string-cast-text types (. row from)))
      (if (and text (or (!= (. row reason) .reason-return) (!= (call intrinsic (. row from)) .void)))
        (return (call Typed (call make-operand .operand-constant (call (. ir add-string) text)) (. row to)))
      )
    )
    (if (== kind .relation-side-cast)
      (if (and (call (. types is-optional) (. row to)) (not (call (. types is-optional) (. row from))))
        (let held
          (scope (if-expr (== (. row parts) no-fact) value (call convert-one site parts-row value))
            (lazy parts-row ([] (. facts conversion-parts) (. row parts)))
          )
        )
        (return (call wrap site held (. row to)))
      )
      (if (and both-optional (!= (. row parts) no-fact) (not (call holds-atom (. row to))))
        (return (call rehouse site row value))
      )
      (lazy both-optional (and (call (. types is-optional) (. row to)) (call (. types is-optional) (. row from))))
      (if (and (call is-text (. row to)) (== (call intrinsic (. row from)) .cpointer))
        (return (call adopt site (. value operand) (. row to)))
      )
      (if (and (== (call intrinsic (. row to)) .cpointer) (== (call intrinsic (. row from)) .interface))
        (return (call held-object site (. value operand) (. row to)))
      )
      (if (and (== (call intrinsic (. row to)) .cpointer) (== (call intrinsic (. row from)) .union))
        (return (call union-object site value (. row to)))
      )
      (return (call cast site value (. row to)))
    )
    (if (and (== kind .relation-converter) (== (. row callee) no-instance) (== (. row to) (. types bool-type)))
      (if (call (. types is-optional) (. row from))
        (return (call present site value))
      )
    )
    (if (and (== kind .relation-fromverter) (== (. row callee) no-instance))
      (return (call number-enum site row (. value operand)))
    )
    (let gives (== kind .relation-converter))
    (if (and (== kind .relation-fromverter) (!= (. row callee) no-instance))
      (= gives (== (call (. instances argument-type) (. row callee) 0) (. row from)))
    )
    (if (and gives (!= (. row callee) no-instance))
      (let raising (!= (. ([] (. instances signatures) (. row callee)) errors count) 0))
      (let mark (. pending length))
      (+= pending (. value operand))
      (= takes-result raising)
      (let converted (call call-method (. row callee) site mark))
      (= takes-result false)
      (if raising
        (= converted (call settle-raise (if-expr (== raised 0) site raised) row (. converted operand)))
      )
      (if (!= (. converted type) (. row to))
        (call refuse .refused-conversion site)
      )
      (return converted)
    )
    (call refuse .refused-conversion site)
    (return value)
  )
  (fn-do _ make-interface Typed
    (param site SyntaxId)
    (param from TypeId)
    (param to TypeId)
    (param value Operand)
    ; A value converted to an interface: memory in the frame that holds the value and its
    ; witness table. An object's table is the one the table of its class holds for the
    ; interface, so an object held as a class it is derived from has its own. A value of an
    ; interface derived from the one asked for keeps what it holds, and its table is that
    ; interface's section of the one it has. A value that is no object is boxed, and its table
    ; is the one of its type, named here; code the collector never sees boxes nothing.
    (let nothing (call make-operand .operand-void 0))
    (let layout (call layout-of to site))
    (if (!= layout (. tables layouts interface-layout))
      (call refuse .refused-conversion site)
      (return (call Typed nothing no-type))
    )
    (let second (. (call (. tables layouts field) layout 1) offset))
    (let held value)
    (let table nothing)
    (let witness (call (. tables witness-of) from to))
    (if (== (call intrinsic from) .interface)
      (let offset (call (. tables section-offset) from to))
      (if (== offset no-slot-index)
        (call refuse .refused-conversion site)
        (return (call Typed nothing no-type))
      )
      (= held (call load value 0 managed-layout site))
      (= table (call load value second pointer-layout site))
      (if (!= offset 0)
        (= table (call address table (* offset table-slot-size) pointer-layout site))
      )
      (else-if (and (call (. tables is-class) from) (!= witness no-slot-index) slotted-witness)
        (let class-table (call load value 0 pointer-layout site))
        (let place (+ table-header-size (* (. ([] (. tables witnesses) witness) slot) table-slot-size)))
        (= table (call load class-table place pointer-layout site))
      )
      (else-if (and (!= witness no-slot-index) (not (call (. tables is-class) from)) (not in-zone))
        (= held (call box site from value))
        (= table (call make-operand .operand-symbol (. ([] (. tables witnesses) witness) symbol)))
      )
      (else
        (call refuse .refused-conversion site)
        (return (call Typed nothing no-type))
      )
    )
    (lazy slotted-witness (!= (. ([] (. tables witnesses) witness) slot) no-slot-index))
    (let made (call frame layout))
    (call store made 0 held false site)
    (call store made second table false site)
    (return (call Typed made to))
  )
  (fn-do _ box Operand
    (param site SyntaxId)
    (param type TypeId)
    (param value Operand)
    ; What an interface value holds of a value that is no object: a whole number widened to
    ; the size of a pointer, and anything else a copy in an object the collector owns.
    (let nothing (call make-operand .operand-void 0))
    (let layout (call layout-of type site))
    (if (== layout void-layout)
      (call refuse .refused-conversion site)
      (return nothing)
    )
    (if (call is-integer layout)
      (return (call num-cast site value layout u64-layout))
    )
    (let shape ([] (. tables layouts rows) layout))
    (let mark (. pending length))
    (+= pending (call integer .machine-u64 (. shape size)))
    (if (. shape is-managed)
      (+= pending (call make-operand .operand-descriptor layout))
      (else
        (+= pending (call integer .machine-pointer 0))
      )
    )
    (let made (call call-runtime .runtime-allocate-object site mark managed-layout))
    (if (call (. tables layouts is-struct) layout)
      (call copy made value layout (. shape is-managed) site)
      (else
        (call store made 0 value (. shape is-managed) site)
      )
    )
    (return made)
  )
  (fn-do _ unbox Typed
    (param site SyntaxId)
    (param type TypeId)
    (param source Operand)
    ; What an interface value holds, as its type holds it: an object as it is, a whole number
    ; narrowed again, and anything else a copy of what the object it was boxed in holds.
    (if (call (. tables is-class) type)
      (return (call Typed (call load source 0 managed-layout site) type))
    )
    (let layout (call layout-of type site))
    (if (== layout void-layout)
      (call refuse .refused-conversion site)
      (return (call Typed source no-type))
    )
    (if (call is-integer layout)
      (return (call Typed (call num-cast site (call load source 0 u64-layout site) u64-layout layout) type))
    )
    (let held (call load source 0 managed-layout site))
    (if (call (. tables layouts is-struct) layout)
      (return (call Typed (call snapshot held layout site) type))
    )
    (return (call Typed (call load held 0 layout site) type))
  )
  (fn-do _ settle-raise Typed
    (param site SyntaxId)
    (param row ConversionFact)
    (param result Operand)
    ; The value of a conversion by a function that raises errors, as the type pass settled it:
    ; an error leaves the function, or is a panic where the value is a text written in source.
    ; Where the type pass settled nothing there is no shape.
    (if (== (. row raise) .raise-leaves)
      (return (call propagate site (. row callee) result))
    )
    (if (== (. row raise) .raise-panics)
      (return (call panic-on-error site (. row callee) result))
    )
    (call refuse .refused-conversion site)
    (return (call Typed result no-type))
  )
  (fn-do _ number-enum Typed
    (param site SyntaxId)
    (param row ConversionFact)
    (param value Operand)
    ; A whole number converted to an enum by its place: the value the enum declares at that
    ; place, counted from zero in the order declared, which the module that declares it made as
    ; it started. For any other number the enum is constructed with nothing given, by the call
    ; the type pass recorded at the node.
    (let nothing (call make-operand .operand-void 0))
    (let made no-fact)
    (let fact (call (. facts first-call) (. unit reading) site))
    (while (!= fact no-fact)
      (if (== (. ([] (. facts calls) fact) form) .call-enum-default)
        (= made fact)
      )
      (= fact (. ([] (. facts calls) fact) next))
    )
    (let counted (call layout-of (. row from) site))
    (let layout (call layout-of (. row to) site))
    (let module ModuleId (. U32 max))
    (let decl DeclId 0)
    (match? ([] (. types rows) (. row to))
      (case (call .type-class class)
        (= module (. class module))
        (= decl (. class decl))
      )
    )
    (if (or (== made no-fact) (not (call is-integer counted)) (>= module (. program modules length)))
      (call refuse .refused-conversion site)
      (return (call Typed nothing no-type))
    )
    (let owner ([] (. program modules) module))
    (let joined (call (. ir reserve-block)))
    (let slot (call join-slot layout))
    (let mark (. joins length))
    (let place U32)
    (for (in index (..< 0 (. owner decls length)))
      (match? ([] (. owner decls) index)
        (case (call .decl-case case)
          (if (== (. case owner) decl)
            (let kept (call (. tables storage-of) module (as index DeclId)))
            (if (or (== kept no-storage) not-enum (> place 127))
              (call refuse .refused-conversion site)
              (else-if (!= (. ([] (. tables storage) kept) type) (. row to))
                (call refuse .refused-conversion site)
              )
              (else
                (let taken (call (. ir reserve-block)))
                (let next (call (. ir reserve-block)))
                (let number (call integer (call (. tables layouts kind-of) counted) place))
                (call branch (call compare site .compare-equal value number) taken next)
                (call (. ir start-block) taken)
                (call arrive site (. (call load-global ([] (. tables storage) kept) site) operand) joined slot)
                (call (. ir start-block) next)
                (+= place 1)
              )
            )
            (lazy not-enum (!= (call (. tables global-kind) module (as index DeclId)) .global-enum))
          )
        )
      )
    )
    (let object (call emit-fact-call site ([] (. facts calls) made) 0 (call (of RowRange SyntaxId)) 0 0 (. row to)))
    (if (!= (. object type) (. row to))
      (call refuse .refused-conversion site)
    )
    (call arrive site (. object operand) joined slot)
    (let answer (call close-joins joined mark layout slot))
    (return (call Typed answer (. row to)))
  )
  (fn-do _ make-union Typed
    (param site SyntaxId)
    (param type TypeId)
    (param index U32)
    (param held Typed)
    ; A union that holds one case: memory in the frame with nothing set, the number of the case
    ; in its first byte, and behind it what the case holds, which is of the case's type.
    (let layout (call layout-of type site))
    (if (or (not (call (. tables layouts is-union) layout)) (>= index (. ([] (. tables layouts rows) layout) cases count)))
      (call refuse .refused-conversion site)
      (return held)
    )
    (let field (call (. tables layouts case-field) layout index))
    (if (!= (. field type) (. held type))
      (call refuse .refused-conversion site)
      (return held)
    )
    (let made (call frame layout))
    (call zero made layout)
    (call store made 0 (call integer .machine-u8 index) false site)
    (call put made field (. held operand) site)
    (return (call Typed made type))
  )
  (fn-do _ wrap-case Typed
    (param site SyntaxId)
    (param row ConversionFact)
    (param value Typed)
    ; A value as the case of a union the type pass picked for it: converted as the conversion's
    ; one part says to what the case holds.
    (if (== (. row parts) no-fact)
      (call refuse .refused-conversion site)
      (return (call Typed (. value operand) no-type))
    )
    (let held (call convert-one site ([] (. facts conversion-parts) (. row parts)) value))
    (return (call make-union site (. row to) (. row case-index) held))
  )
  (fn-do _ text-or-null Typed
    (param site SyntaxId)
    (param row ConversionFact)
    (param value Typed)
    (let layout (call layout-of (. row to) site))
    (let holds (call present site value))
    (let filled (call (. ir reserve-block)))
    (let empty (call (. ir reserve-block)))
    (let joined (call (. ir reserve-block)))
    (call branch (. holds operand) filled empty)
    (call (. ir start-block) filled)
    (let pointer (call cast site (call payload site (call Typed (. value operand) (. row from))) (. row to)))
    (let from-filled (. ir current))
    (call jump joined)
    (call (. ir start-block) empty)
    (let from-empty (. ir current))
    (call jump joined)
    (call (. ir start-block) joined)
    (return (call Typed (call phi layout (. pointer operand) from-filled (call integer .machine-pointer 0) from-empty) (. row to)))
  )
  (fn-do _ unwrap-or-null Typed
    (param site SyntaxId)
    (param row ConversionFact)
    (param value Typed)
    ; An optional made a union that has a case for null: what it holds converted as the
    ; conversion's one part says, or where it holds nothing the union holding null.
    (let layout (call layout-of (. row to) site))
    (if (or (== (. row parts) no-fact) (not (call (. tables layouts is-union) layout)))
      (call refuse .refused-conversion site)
      (return (call Typed (. value operand) no-type))
    )
    (let made (call frame layout))
    (let holds (call present site value))
    (let filled (call (. ir reserve-block)))
    (let empty (call (. ir reserve-block)))
    (let done (call (. ir reserve-block)))
    (call branch (. holds operand) filled empty)
    (call (. ir start-block) filled)
    (let converted
      (call convert-one
        (block
          (arg site)
          (arg ([] (. facts conversion-parts) (. row parts)))
          (arg (call payload site (call Typed (. value operand) (. row from))))
        )
      )
    )
    (if (!= (. converted type) (. row to))
      (call refuse .refused-conversion site)
    )
    (call copy made (. converted operand) layout false site)
    (call jump done)
    (call (. ir start-block) empty)
    (let none ([] (. tables layouts values) (. types null-type)))
    (let nothing
      (block
        (case? (or (== none managed-layout) (== none pointer-layout))
          (call integer (as none MachineKind) 0)
        )
        (default
          (call make-operand .operand-void 0)
        )
      )
    )
    (let union (call make-union site (. row to) (call (. types null-case) (. row to)) (call Typed nothing (. types null-type))))
    (call copy made (. union operand) layout false site)
    (call jump done)
    (call (. ir start-block) done)
    (return (call Typed made (. row to)))
  )
  (fn-do _ case-test Operand
    (param site SyntaxId)
    (param value Operand)
    (param index U32)
    ; Whether a union holds the case of a number.
    (return (call compare site .compare-equal (call load value 0 u8-layout site) (call integer .machine-u8 index)))
  )
  (fn-do _ holding-branch _
    (param site SyntaxId)
    (param value Operand)
    (param layout LayoutId)
    (param row ConversionFact)
    (param matched IRBlockId)
    (param missed IRBlockId)
    ; Leaves to `matched` where a union holds the case the type pass picked for a type, or, where
    ; that case is of the class asked for or of one it derives from, a case of a class below the
    ; class, whose object is one of it too, or a case of a class above it whose object is of it,
    ; and to `missed` where it holds none of them. Each such case holds its object where the picked
    ; case does, so it is read as one.
    (let field (call (. tables layouts case-field) layout (. row case-index)))
    (let lined
      (scope (and (call (. tables is-class) (. row to)) (or (== (. field type) (. row to)) derived-field))
        (lazy derived-field (and (call (. tables is-class) (. field type)) (call descends (. row to) (. field type))))
      )
    )
    (if (not lined)
      (call branch (call case-test site value (. row case-index)) matched missed)
      (return)
    )
    (let cases (call (. types cases-of) (. row from)))
    (for (in index (..< 0 (. cases length)))
      (let held (. ([] cases index) type))
      (if (or (== held no-type) (not (call (. tables is-class) held)))
        (continue)
      )
      (let below (or (== held (. row to)) (call descends held (. row to))))
      (if (and (not below) (not (call descends (. row to) held)))
        (continue)
      )
      (let other (call (. tables layouts case-field) layout (as index U32)))
      (if (or (!= (. other offset) (. field offset)) (!= (. other layout) (. field layout)))
        (call refuse .refused-conversion site)
        (continue)
      )
      (let taken (call (. ir reserve-block)))
      (let passed (call (. ir reserve-block)))
      (call branch (call case-test site value (as index U32)) taken passed)
      (call (. ir start-block) taken)
      (if below
        (call jump matched)
        (else
          (call class-branch site (call take value other site) (. row to) matched passed)
        )
      )
      (call (. ir start-block) passed)
    )
    (call jump missed)
  )
  (fn-do _ descends Bool
    (param type TypeId)
    (param ancestor TypeId)
    ; Whether a class is below another, the classes it is of followed up from it.
    (let current (?? (call (. types base-of) type) no-type))
    (while (!= current no-type)
      (if (== current ancestor)
        (return true)
      )
      (= current (?? (call (. types base-of) current) no-type))
    )
    (return false)
  )
  (fn-do _ unwrap-case Typed
    (param site SyntaxId)
    (param row ConversionFact)
    (param value Operand)
    ; What a union holds as the case the type pass picked, where any other case is a panic: of
    ; a declaration, which is a pattern, that the pattern did not match. Inside a pattern a case
    ; that is an optional of the type asked for matches where it holds a value, and gives that.
    ; A case of a number or pointer type is converted to the one asked for. A case of any other
    ; type than the one asked for, or than a class it derives from, has no shape here.
    (let layout (call layout-of (. row from) site))
    (if (or (not (call (. tables layouts is-union) layout)) (>= (. row case-index) (. ([] (. tables layouts rows) layout) cases count)))
      (call refuse .refused-conversion site)
      (return (call Typed value no-type))
    )
    (let field (call (. tables layouts case-field) layout (. row case-index)))
    (if (and (!= (. matching failing) no-block) (!= (. field type) (. row to)) (call holds (. field type) (. row to)))
      (call pass-or-fail (call case-test site value (. row case-index)) (. matching failing))
      (return (call unwrap site (call Typed (call take value field site) (. field type))))
    )
    (let lined
      (scope (or (== (. field type) (. row to)) (and both-classes (call descends (. row to) (. field type))))
        (lazy both-classes (and (call (. tables is-class) (. row to)) (call (. tables is-class) (. field type))))
      )
    )
    (let converts (and (not lined) (call converts-scalar (. field type) (. row to))))
    (if (or (and (not lined) (not converts)) (and (not (. function may-panic)) (== (. matching failing) no-block)))
      (call refuse .refused-conversion site)
      (return (call Typed value no-type))
    )
    (if (!= (. matching failing) no-block)
      (let passed (call (. ir reserve-block)))
      (call holding-branch site value layout row passed (. matching failing))
      (+= fail-jumps 1)
      (call (. ir start-block) passed)
      (return (call held-case site value field (. row to)))
    )
    (let matched (call (. ir reserve-block)))
    (let missed (call (. ir reserve-block)))
    (call holding-branch site value layout row matched missed)
    (call (. ir start-block) missed)
    (if (== (. row reason) .reason-declaration)
      (call raise-text site "Pattern match failed")
      (else
        (call raise-union-error site)
      )
    )
    (call (. ir start-block) matched)
    (return (call held-case site value field (. row to)))
  )
  (fn-expr _ converts-scalar Bool
    (param from TypeId)
    (param to TypeId)
    (case? (or (not (call intrinsic-is-numeric (call intrinsic from))) (not (call intrinsic-is-numeric (call intrinsic to))))
      false
    )
    (default
      (or (not (. ([] (. types completions) from) has-equalities)) (not (. ([] (. types completions) to) has-equalities)))
    )
  )
  (fn-do _ held-case Typed
    (param site SyntaxId)
    (param value Operand)
    (param field LayoutField)
    (param target TypeId)
    (let held (call take value field site))
    (if (or (== (. field type) target) (call (. tables is-class) target))
      (return (call Typed held target))
    )
    (return (call cast site (call Typed held (. field type)) target))
  )
  (fn-do _ union-text Typed
    (param site SyntaxId)
    (param row ConversionFact)
    (param value Operand)
    ; A union as text: the name of a case that holds no value of its own, and of any other what
    ; it holds made text as the part for the case says. The cases are tested in their order.
    (let nothing (call make-operand .operand-void 0))
    (let layout (call layout-of (. row from) site))
    (if (not (call (. tables layouts is-union) layout))
      (call refuse .refused-conversion site)
      (return (call Typed value no-type))
    )
    (let joined (call (. ir reserve-block)))
    (let mark (. joins length))
    (let part (. row parts))
    (let index U32)
    (for (in fact (call (. types cases-of) (. row from)))
      (if (== part no-fact)
        (break)
      )
      (let taken (call (. ir reserve-block)))
      (let passed (call (. ir reserve-block)))
      (call branch (call case-test site value index) taken passed)
      (call (. ir start-block) taken)
      (let text nothing)
      (if (. fact is-default)
        (let name (. fact name))
        (= text (call make-operand .operand-constant (call (. ir add-string) (if-expr name (. name text) ""))))
        (else
          (let field (call (. tables layouts case-field) layout index))
          (let converted
            (call convert-one
              (block
                (arg site)
                (arg ([] (. facts conversion-parts) part))
                (arg (call Typed (call take value field site) (. field type)))
              )
            )
          )
          (= text (. converted operand))
          (if (!= (. converted type) (. types string-type))
            (call refuse .refused-conversion site)
          )
        )
      )
      (call arrive site text joined nothing)
      (call (. ir start-block) passed)
      (= part (. ([] (. facts conversion-parts) part) next))
      (+= index 1)
    )
    (if (or (!= part no-fact) (!= index (. ([] (. tables layouts rows) layout) cases count)))
      (call refuse .refused-conversion site)
    )
    (call arrive site (call make-operand .operand-constant (call (. ir add-string) "")) joined nothing)
    (return (call Typed (call close-joins joined mark managed-layout nothing) (. row to)))
  )
  (fn-do _ rewrap Typed
    (param site SyntaxId)
    (param row ConversionFact)
    (param value Operand)
    ; A union as another union: what it holds is made the case of the other that the part for
    ; its own case says. The cases are tested in their order, and the last is what is left.
    (let target (call layout-of (. row to) site))
    (let layout (call layout-of (. row from) site))
    (if (or (not (call (. tables layouts is-union) layout)) (not (call (. tables layouts is-union) target)))
      (call refuse .refused-conversion site)
      (return (call Typed value no-type))
    )
    (let count (. ([] (. tables layouts rows) layout) cases count))
    (let joined (call (. ir reserve-block)))
    (let slot (call join-slot target))
    (let mark (. joins length))
    (let part (. row parts))
    (let index U32)
    (while (and (< index count) (!= part no-fact))
      (let tests (!= (+ index 1) count))
      (let passed IRBlockId 0)
      (if tests
        (let taken (call (. ir reserve-block)))
        (= passed (call (. ir reserve-block)))
        (call branch (call case-test site value index) taken passed)
        (call (. ir start-block) taken)
      )
      (let field (call (. tables layouts case-field) layout index))
      (let made
        (call convert-one
          (block
            (arg site)
            (arg ([] (. facts conversion-parts) part))
            (arg (call Typed (call take value field site) (. field type)))
          )
        )
      )
      (if (!= (. made type) (. row to))
        (call refuse .refused-conversion site)
      )
      (call arrive site (. made operand) joined slot)
      (if tests
        (call (. ir start-block) passed)
      )
      (= part (. ([] (. facts conversion-parts) part) next))
      (+= index 1)
    )
    (if (or (!= part no-fact) (!= index count))
      (call refuse .refused-conversion site)
    )
    (return (call Typed (call close-joins joined mark target slot) (. row to)))
  )
  (fn-do _ emit-case-number Typed
    (param id SyntaxId)
    (param object SyntaxId)
    ; `case` of a union: the number of the case it holds, which is the byte it starts with.
    (let held (call emit-whole object))
    (let layout (call layout-of (. held type) id))
    (let type (call (. facts node-type) (. unit reading) id))
    (let counted (call layout-of type id))
    (if (or (not (call (. tables layouts is-union) layout)) (!= counted u8-layout))
      (call refuse .refused-expression id)
      (return held)
    )
    (return (call Typed (call load (. held operand) 0 u8-layout id) type))
  )
  (fn-do _ emit-case-text Typed
    (param id SyntaxId)
    (param object SyntaxId)
    (param plan OperatorPlan)
    ; `name` or `type` of a union: the name of the case it holds, or the key of that case's
    ; type. The number of the case is compared with each case's in turn, and the text is the
    ; empty one where it is none of them, as TypeScript's chain ends. A case with no name has
    ; the empty text for its name, and a case that holds no value has the type of its number.
    (let nothing (call make-operand .operand-void 0))
    (let held (call emit-whole object))
    (let union (. held type))
    (let layout (call layout-of union id))
    (let text-layout (call layout-of (. types string-type) id))
    (if (or (not (call (. tables layouts is-union) layout)) (!= (call (. facts node-type) (. unit reading) id) (. types string-type)))
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (let cases (call (. types cases-of) union))
    (let count (. ([] (. tables layouts rows) layout) cases count))
    (if (!= (. cases length) count)
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (let number (call load (. held operand) 0 u8-layout id))
    (let joined (call (. ir reserve-block)))
    (let mark (. joins length))
    (for (in index (..< 0 count))
      (let matched (call (. ir reserve-block)))
      (let next (call (. ir reserve-block)))
      (call branch (call compare id .compare-equal number (call integer .machine-u8 index)) matched next)
      (call (. ir start-block) matched)
      (let text "")
      (if (== plan .plan-case-type)
        (= text (call type-runtime-key types (. (call (. tables layouts case-field) layout index) type)))
        (else-if (. ([] cases index) name)
          (= text (. (!! (. ([] cases index) name)) text))
        )
      )
      (call arrive id (call make-operand .operand-constant (call (. ir add-string) text)) joined nothing)
      (call (. ir start-block) next)
    )
    (call arrive id (call make-operand .operand-constant (call (. ir add-string) "")) joined nothing)
    (return (call Typed (call close-joins joined mark text-layout nothing) (. types string-type)))
  )
  (fn-do _ emit-case-value Typed
    (param id SyntaxId)
    (param object SyntaxId)
    ; A union read by the name of one of its cases, whose number the type pass recorded: what
    ; the union holds where it holds that case, and where it holds another the value a local of
    ; the case's type has with nothing written for it, as TypeScript gives: for one made by a
    ; constructor, the construction the type pass recorded at the node.
    (let nothing (call make-operand .operand-void 0))
    (let type (call (. facts node-type) (. unit reading) id))
    (let constant (call (. facts constant-of) (. unit reading) id))
    (let held (call emit-whole object))
    (let layout (call layout-of (. held type) id))
    (let given (call layout-of type id))
    (if (or (== constant no-fact) (not (call (. tables layouts is-union) layout)))
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (let index (as (. ([] (. facts constants) constant) bits) U32))
    (if (>= index (. ([] (. tables layouts rows) layout) cases count))
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (let field (call (. tables layouts case-field) layout index))
    (if (or (!= (. field type) type) (== (. field layout) void-layout))
      (call refuse .refused-conversion id)
      (return (call Typed nothing no-type))
    )
    (let matched (call (. ir reserve-block)))
    (let other (call (. ir reserve-block)))
    (let joined (call (. ir reserve-block)))
    (let slot (call join-slot given))
    (let mark (. joins length))
    (call branch (call case-test id (. held operand) index) matched other)
    (call (. ir start-block) matched)
    (call arrive id (call take (. held operand) field id) joined slot)
    (call (. ir start-block) other)
    (let first (call default-value id type given id))
    (call arrive id (. first operand) joined slot)
    (return (call Typed (call close-joins joined mark given slot) type))
  )
  (fn-do _ emit-whole Typed
    (param object SyntaxId)
    ; The receiver of a member a union answers: its value, or for a local read as the one case
    ; the flow knows it to hold, the union the local holds, whose member it is.
    (if (or (!= (call (. facts plan-of) (. unit reading) object) .plan-case-read) (call is-pinned object))
      (return (call emit-expression object))
    )
    (let binding (. ([] (. instances rows) (. unit reading)) binding))
    (if (and (!= binding no-binding) (== (. unit reading) (. unit instance)))
      (match? ([] (. tree nodes) object)
        (case .node-identifier
          (let resolution (call (. bindings resolution-of) binding object))
          (if (and (== (. resolution kind) .resolve-slot) names-local)
            (let offset (call slot-offset (. resolution slot) object))
            (let held (call (. facts slot-type) (. unit instance) offset))
            (let whole (call read-local (. resolution slot) object held))
            (return (call Typed (. whole operand) held))
          )
          (lazy names-local (== (. ([] (. bindings slots) (. resolution slot)) kind) .slot-local))
        )
      )
    )
    (call refuse .refused-expression object)
    (return (call Typed (call make-operand .operand-void 0) no-type))
  )
  (fn-do _ answer-count U32
    (param id SyntaxId)
    ; How many of the calls recorded at a node answer for its value.
    (let count U32)
    (let fact (call (. facts first-call) (. unit reading) id))
    (while (!= fact no-fact)
      (if (call answers-node (. ([] (. facts calls) fact) form))
        (+= count 1)
      )
      (= fact (. ([] (. facts calls) fact) next))
    )
    (return count)
  )
  (fn-do _ nth-answer FactId
    (param id SyntaxId)
    (param position U32)
    ; The call recorded at a node that answers for its value, by its place among those that do.
    (let left position)
    (let fact (call (. facts first-call) (. unit reading) id))
    (while (!= fact no-fact)
      (if (call answers-node (. ([] (. facts calls) fact) form))
        (if (== left 0)
          (return fact)
        )
        (-= left 1)
      )
      (= fact (. ([] (. facts calls) fact) next))
    )
    (return no-fact)
  )
  (fn-do _ emit-forward Typed
    (param id SyntaxId)
    (param object SyntaxId)
    (param operands (of RowRange SyntaxId))
    (param name (? Atom) (= null))
    ; A member of a union that each case answers with its own, as the type pass planned it.
    ; 1. The union is evaluated, and then the arguments written, once each, in their order. A
    ;    row of a table of unions is gathered as the case it holds where the member is made in
    ;    place: TypeScript reads the case's cells where the member is stable, and gathers them
    ;    where it is not.
    ; 2. Where a case may panic or let errors out, the function made for the member, TypeScript's
    ;    `union-dispatch-N`, is called with them. Errors it answers with leave the function the
    ;    call is in. Such a member with no function made for it has no shape. Any other is made
    ;    in place, as `dispatch-cases` makes it.
    (let nothing (call make-operand .operand-void 0))
    (let type (call (. facts node-type) (. unit reading) id))
    (if (call (. tables forward-unbuilt) (. unit reading) id)
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (let held (call emit-whole object))
    (let whole (. held type))
    (let dispatch (call (. tables forward-function) (. unit reading) id))
    (if (and (== dispatch no-function) (call holds-row whole))
      (= held (call table-row-item id (. held operand) whole))
      (= whole (. held type))
    )
    (let union (if-expr (call holds-row whole) (call table-row-type whole) whole))
    (let layout (call layout-of union id))
    (if (or (not (call (. tables layouts is-union) layout)) (== type no-type) (== type invalid-type))
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (let disturbed false)
    (for (in argument ([] (. tree children) operands))
      (if (not (call is-inert argument))
        (= disturbed true)
      )
    )
    (= held (call Typed (call apart (call Typed (. held operand) whole) object disturbed) whole))
    (let pin-mark (. pins length))
    (for (in argument ([] (. tree children) operands))
      (let expression (call (. tree argument-value) argument))
      (let made (call emit-expression expression))
      (let value (call apart made expression true))
      (if (!= (. made type) (call (. facts node-type) (. unit reading) expression))
        (call refuse .refused-conversion expression)
      )
      (call pin expression value (. made type))
    )
    (let answer (call Typed nothing no-type))
    (if (!= dispatch no-function)
      (= answer (call call-forward id dispatch (. held operand) pin-mark type))
      (else
        (= answer (call dispatch-cases id object operands (. held operand) layout type name))
      )
    )
    (call unpin pin-mark)
    (return answer)
  )
  (fn-do _ call-forward Typed
    (param id SyntaxId)
    (param dispatch FunctionId)
    (param held Operand)
    (param pin-mark Size)
    (param type TypeId)
    ; A call of the function made for a member a union forwards, with the union and the
    ; arguments pinned from `pin-mark` on. It answers the member's value, or with the errors the
    ; cases let out, which leave the function the call is in. Where the collector never looks the
    ; call leaves that zone, as a call of each case's member would.
    (let nothing (call make-operand .operand-void 0))
    (let forward (call (. tables forward-of) dispatch))
    (let target ([] (. tables functions) dispatch))
    (let raising (!= (. forward result) no-type))
    (let returned (if-expr raising (. forward result) type))
    (let returns (call layout-of returned id))
    (if (and in-zone raising)
      (call refuse .refused-expression id)
    )
    (let mark (. pending length))
    (+= pending held)
    (for (in position (..< pin-mark (. pins length)))
      (+= pending (. ([] pins position) value))
    )
    (call (. ir depend) .callee-function dispatch (if-expr (. target may-panic) may-panic-dependency 0u32))
    (let checked (and (. target may-panic) (not in-landing)))
    (let crosses in-zone)
    (if crosses
      (call cross-zone id false)
    )
    (let result
      (call call
        (block
          (arg (call make-operand .operand-symbol (. target symbol)))
          (arg id)
          (arg mark)
          (arg .callee-function)
          (arg returns)
          (arg checked)
        )
      )
    )
    (if crosses
      (call cross-zone id true)
    )
    (if raising
      (return (call propagate-held id (. forward result) result))
    )
    (return (call Typed result returned))
  )
  (fn-expr _ holds-row Bool
    (param type TypeId)
    ; Whether a value is a row of a table, as a receiver a union's member is forwarded from.
    (or (== (call intrinsic type) .table-row) (== (call intrinsic type) .immutable-table-row))
  )
  (fn-do _ dispatch-cases Typed
    (param id SyntaxId)
    (param object SyntaxId)
    (param operands (of RowRange SyntaxId))
    (param held Operand)
    (param layout LayoutId)
    (param type TypeId)
    (param name (? Atom) (= null))
    ; A member of a union as each case answers it, with the union held and the arguments
    ; pinned.
    ; 1. The number of the case the union holds is read once and compared with each case's in
    ;    turn. The last case is the one left.
    ; 2. The member is made of what the union holds as that case: the call the type pass
    ;    recorded for the case, which it records in the order of the cases, or with no call
    ;    recorded the property the case stores, read by name.
    ; What a case gives in another type than the node's takes the conversion recorded at the
    ; node for that type, as one side of a join does.
    (let nothing (call make-operand .operand-void 0))
    (let count (. ([] (. tables layouts rows) layout) cases count))
    (let answered (call answer-count id))
    (if (or (== count 0) (and (!= answered 0) (!= answered count)) unnamed-call)
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (lazy unnamed-call (and (== answered 0) (or (not name) (!= (. operands count) 0))))
    (let gives (!= type (. types void-type)))
    (let given (if-expr gives (call layout-of type id) void-layout))
    (let joined (call (. ir reserve-block)))
    (let slot (if-expr gives (call join-slot given) nothing))
    (let mark (. joins length))
    (let tag (if-expr (> count 1) (call load held 0 u8-layout id) nothing))
    (for (in index (..< 0 count))
      (let next no-block)
      (if (< (+ index 1) count)
        (let matched (call (. ir reserve-block)))
        (= next (call (. ir reserve-block)))
        (call branch (call compare id .compare-equal tag (call integer .machine-u8 index)) matched next)
        (call (. ir start-block) matched)
      )
      (let field (call (. tables layouts case-field) layout index))
      (let inside (call take held field id))
      (let case-mark (. pins length))
      (call pin object inside (. field type))
      (let answer (call Typed nothing no-type))
      (if (== answered 0)
        (= answer (call load-property id inside (. field type) (!! name) true))
        (else
          (let fact ([] (. facts calls) (call nth-answer id index)))
          (= answer (call emit-fact-call id fact object operands 0 0 (call case-answer fact)))
        )
      )
      (call unpin case-mark)
      (if (!= (. answer type) type)
        (= answer (call join id answer))
      )
      (if (!= (. answer type) type)
        (call refuse .refused-conversion id)
      )
      (if gives
        (call arrive id (. answer operand) joined slot)
        (else
          (call jump joined)
        )
      )
      (if (< (+ index 1) count)
        (call (. ir start-block) next)
      )
    )
    (if (not gives)
      (call (. ir start-block) joined)
      (return (call Typed nothing type))
    )
    (return (call Typed (call close-joins joined mark given slot) type))
  )
  (fn-expr _ case-answer TypeId
    (param fact CallFact)
    ; What the call of a case answers: the value, or what holds it or an error where the call
    ; raises errors that do not leave with it.
    (case? (== (. fact callee) no-instance)
      no-type
    )
    (case? (and (!= (. signature errors count) 0) (not (. fact propagates)))
      (. signature result)
    )
    (default
      (. signature returns)
    )
    (where
      (lazy signature ([] (. instances signatures) (. fact callee)))
    )
  )
  (fn-expr _ runs-on-row Bool
    (param callee InstanceId)
    (param row TypeId)
    ; Whether a member runs on a row: one of a case on the case's cells, or one of a base every
    ; case shares on the row itself.
    (or (== (. ([] (. instances rows) callee) row-receiver) row) (== (. ([] (. instances rows) callee) self-type) row))
  )
  (fn-do _ set-cases _
    (param id SyntaxId)
    (param lhs SyntaxId)
    (param object SyntaxId)
    (param rhs SyntaxId)
    (param held Operand)
    (param layout LayoutId)
    ; A setter of a union as each case answers it, with the union held and the value pinned: the
    ; setter the type pass recorded for the case the union holds, which it records in the order
    ; of the cases, is called on what the union holds with the value.
    (let count-answered (call answer-count lhs))
    (let joined (call (. ir reserve-block)))
    (for (in index (..< 0 count-answered))
      (let fact ([] (. facts calls) (call nth-answer lhs index)))
      (if (!= (. fact form) .call-setter)
        (call refuse .refused-statement id)
        (break)
      )
      (let next no-block)
      (if (< (+ index 1) count-answered)
        (let matched (call (. ir reserve-block)))
        (= next (call (. ir reserve-block)))
        (call branch (call case-test id held index) matched next)
        (call (. ir start-block) matched)
      )
      (let field (call (. tables layouts case-field) layout index))
      (let inside (call take held field id))
      (let case-mark (. pins length))
      (call pin object inside (. field type))
      (call emit-setter lhs object rhs fact)
      (call unpin case-mark)
      (call jump joined)
      (if (< (+ index 1) count-answered)
        (call (. ir start-block) next)
      )
    )
    (call (. ir start-block) joined)
  )
  (fn-do _ emit-case Typed
    (param id SyntaxId)
    (param operands (of RowRange SyntaxId))
    (param fields Bool)
    ; A case of a union named at a node, as the type pass planned it: with the value it is
    ; called with, with a tuple or struct made of the fields it is called with, or named alone
    ; with the number a case with no value of its own holds. One called with a value or fields is
    ; made in place, where TypeScript calls the constructor it generates for the case, as the IR
    ; notes.
    (let nothing (call make-operand .operand-void 0))
    (let type (call (. facts node-type) (. unit reading) id))
    (let constant (call (. facts constant-of) (. unit reading) id))
    (let layout (call layout-of type id))
    (if (or (== constant no-fact) (not (call (. tables layouts is-union) layout)))
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (let index (as (. ([] (. facts constants) constant) bits) U32))
    (if (>= index (. ([] (. tables layouts rows) layout) cases count))
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (let field (call (. tables layouts case-field) layout index))
    (let held (call Typed nothing no-type))
    (if fields
      (= held (call emit-case-fields id field operands))
      (else-if (== (. operands count) 1)
        (let given ([] (. tree children) (. operands start)))
        (= held (call convert given .reason-argument (call emit-expression (call (. tree argument-value) given))))
      )
      (else-if (and (== (. operands count) 0) (. ([] (call (. types cases-of) type) index) is-default))
        (= held (call Typed (call integer .machine-u8 index) (. field type)))
      )
      (else
        (call refuse .refused-expression id)
      )
    )
    (let made (call make-union id type index held))
    (if (or fields (!= (. operands count) 0))
      (call (. ir note-made-call))
    )
    (return made)
  )
  (fn-do _ emit-case-fields Typed
    (param id SyntaxId)
    (param field LayoutField)
    (param operands (of RowRange SyntaxId))
    ; The tuple or struct a case holds, made of the arguments the case is called with: each is
    ; converted as recorded at it and stored to the next field written with a value.
    (let nothing (call make-operand .operand-void 0))
    (if (or (not (call (. tables layouts is-struct) (. field layout))) (not (call is-aggregate (. field type))))
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (let made (call frame (. field layout)))
    (call zero made (. field layout))
    (let range (. ([] (. types completions) (. field type)) properties))
    (let position U32)
    (for (in offset (..< 0 (. range count)))
      (let property ([] (. types properties) (+ (. range start) offset)))
      (if (!= (. property storage-kind) .storage-eager)
        (continue)
      )
      (if (>= position (. operands count))
        (call refuse .refused-expression id)
        (return (call Typed nothing no-type))
      )
      (let given ([] (. tree children) (+ (. operands start) position)))
      (let value (call convert given .reason-argument (call emit-expression (call (. tree argument-value) given))))
      (let target (call (. tables layouts field) (. field layout) (. property slot)))
      (if (!= (. value type) (. target type))
        (call refuse .refused-conversion given)
        (return (call Typed nothing no-type))
      )
      (call put made target (. value operand) given)
      (+= position 1)
    )
    (if (!= position (. operands count))
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (return (call Typed made (. field type)))
  )
  (fn-do _ adopt Typed
    (param site SyntaxId)
    (param value Operand)
    (param target TypeId)
    ; Text copied from the C chars a pointer leads to. The runtime function that copies polls, so
    ; it is called between two polls, and the panic signal is read again after it. A function
    ; the collector never sees has no shape for it.
    (let returns (call layout-of target site))
    (let mark (. pending length))
    (+= pending value)
    (let text (call call-polling .runtime-string-adopt site mark returns))
    (return (call Typed text target))
  )
  (fn-do _ call-polling Operand
    (param callee RuntimeFunction)
    (param site SyntaxId)
    (param mark Size)
    (param returns LayoutId)
    ; A call of a runtime function that polls, with the pending arguments from `mark` on. It is
    ; called between two polls, and the panic signal is read again after it. A function the
    ; collector never sees has no shape for it.
    (if (or in-zone (not (. ir signals)))
      (call refuse .refused-blocking-call site)
      (call drop-pending mark)
      (return (call make-operand .operand-void 0))
    )
    (call poll site)
    (let result (call call-runtime callee site mark returns))
    (call poll site)
    (call append .op-load-panic-signal site (call Span) 0)
    (let resumed (call (. ir reserve-block)))
    (call branch (call make-operand .operand-panic-signal 0) (call landing-block site) resumed)
    (call (. ir start-block) resumed)
    (return result)
  )
  (fn-do _ tuple-text Typed
    (param site SyntaxId)
    (param row ConversionFact)
    (param value Operand)
    ; A tuple or struct as text: `(`, each field made text as its part says with `, ` between,
    ; and `)`, joined by the runtime.
    (let layout (call layout-of (. row from) site))
    (if (not (call (. tables layouts is-struct) layout))
      (call refuse .refused-conversion site)
      (return (call Typed value no-type))
    )
    (let count (. ([] (. tables layouts rows) layout) fields count))
    (let text (call make-operand .operand-constant (call (. ir add-string) "(")))
    (let position U32)
    (let part (. row parts))
    (while (and (!= part no-fact) (< position count))
      (let fact ([] (. facts conversion-parts) part))
      (let field (call (. tables layouts field) layout position))
      (let piece (call convert-one site fact (call Typed (call take value field site) (. field type))))
      (if (!= position 0)
        (= text (call concat site text (call make-operand .operand-constant (call (. ir add-string) ", "))))
      )
      (= text (call concat site text (. piece operand)))
      (+= position 1)
      (= part (. fact next))
    )
    (if (or (!= part no-fact) (!= position count))
      (call refuse .refused-conversion site)
    )
    (= text (call concat site text (call make-operand .operand-constant (call (. ir add-string) ")"))))
    (return (call Typed text (. row to)))
  )
  (fn-do _ concat Operand
    (param site SyntaxId)
    (param left Operand)
    (param right Operand)
    ; Two texts joined by the runtime.
    (let mark (. pending length))
    (+= pending left)
    (+= pending right)
    (return (call call-polling .runtime-string-concat site mark managed-layout))
  )
  (fn-do _ recast Typed
    (param site SyntaxId)
    (param row ConversionFact)
    (param value Operand)
    ; A tuple or struct cast to another: memory in the frame, with each field converted as its
    ; part says and stored to the field in the same place.
    (let held (call layout-of (. row from) site))
    (let layout (call layout-of (. row to) site))
    (if (or (not (call (. tables layouts is-struct) held)) (not (call (. tables layouts is-struct) layout)))
      (call refuse .refused-conversion site)
      (return (call Typed value no-type))
    )
    (call check-item-size site (. row from) (. row to))
    (let count (. ([] (. tables layouts rows) layout) fields count))
    (if (!= (. ([] (. tables layouts rows) held) fields count) count)
      (call refuse .refused-conversion site)
      (return (call Typed value no-type))
    )
    (let made (call frame layout))
    (let position U32)
    (let part (. row parts))
    (while (and (!= part no-fact) (< position count))
      (let fact ([] (. facts conversion-parts) part))
      (let field (call (. tables layouts field) layout position))
      (let source (call (. tables layouts field) held position))
      (let converted (call convert-one site fact (call Typed (call take value source site) (. source type))))
      (if (!= (. converted type) (. field type))
        (call refuse .refused-conversion site)
      )
      (call put made field (. converted operand) site)
      (+= position 1)
      (= part (. fact next))
    )
    (if (or (!= part no-fact) (!= position count))
      (call refuse .refused-conversion site)
    )
    (return (call Typed made (. row to)))
  )
  (fn-do _ check-item-size _
    (param site SyntaxId)
    (param from TypeId)
    (param to TypeId)
    (return-if (if (or (not (call holds-items from)) (not (call holds-items to)))))
    (blank)
    (let from-item (call viewed-item from))
    (let to-item (call viewed-item to))
    (return-if (if (== from-item to-item)))
    (blank)
    (let from-size (. ([] (. tables layouts rows) (call layout-of from-item site)) size))
    (let to-size (. ([] (. tables layouts rows) (call layout-of to-item site)) size))
    (return-if (if (== from-size to-size)))
    (blank)
    (if (and (not (. function may-panic)) (not in-landing))
      (call refuse .refused-conversion site)
      (return)
    )
    (call raise-text
      (block
        (arg site)
        (arg (str "An array of " from-size "-byte items cannot be cast to one of " to-size "-byte items"))
      )
    )
    (call (. ir start-block) (call (. ir reserve-block)))
  )
  (fn-expr _ holds-items Bool
    (param type TypeId)
    (or (call same-decl ref (. types array-decl)) (call same-decl ref (. types immutable-array-decl)))
    (where
      (lazy ref (call class-ref types type))
    )
  )
  (fn-do _ is-leading Bool
    (param base LayoutId)
    (param whole LayoutId)
    ; Whether a struct starts with the fields of another, each in the same place: the address of
    ; the one is then the address of the other.
    (if (or (not (call (. tables layouts is-struct) base)) (not (call (. tables layouts is-struct) whole)))
      (return false)
    )
    (let count (. ([] (. tables layouts rows) base) fields count))
    (if (> count (. ([] (. tables layouts rows) whole) fields count))
      (return false)
    )
    (for (in position (..< 0 count))
      (let mine (call (. tables layouts field) base position))
      (let theirs (call (. tables layouts field) whole position))
      (if (or (!= (. mine offset) (. theirs offset)) (!= (. mine layout) (. theirs layout)))
        (return false)
      )
    )
    (return true)
  )
  (fn-do _ wrap Typed
    (param site SyntaxId)
    (param value Typed)
    (param target TypeId)
    ; A value as an optional that holds it: the value, and the flag that says there is one. The
    ; value is already what the optional holds: a conversion converts it first as its part says.
    ; A value with no bits leaves only the flag.
    (let layout (call layout-of target site))
    (if (and (call is-null-form target) (== (. value type) (call (. types optional-inner) target)))
      (return (call Typed (. value operand) target))
    )
    (if (or (not (call (. types is-optional) target)) (not (call (. tables layouts is-struct) layout)))
      (call refuse .refused-conversion site)
      (return value)
    )
    (let inner (call (. tables layouts field) layout 0))
    (let flag (call (. tables layouts field) layout 1))
    (let held (call (. types optional-inner) target))
    (let given value)
    (if (or (!= held (. given type)) (!= (. inner layout) (call layout-of (. given type) site)))
      (call refuse .refused-conversion site)
      (return value)
    )
    (let wrapped (call frame layout))
    (call zero wrapped layout)
    (if (call (. tables layouts is-struct) (. inner layout))
      (call copy
        (block
          (arg (call address wrapped (. inner offset) (. inner layout) site))
          (arg (. given operand))
          (arg (. inner layout))
          (arg false)
          (arg site)
        )
      )
      (else-if (!= (. inner layout) void-layout)
        (call store wrapped (. inner offset) (. given operand) false site)
      )
    )
    (call store wrapped (. flag offset) (call integer .machine-i8 1) false site)
    (return (call Typed wrapped target))
  )
  (fn-do _ empty-optional Typed
    (param type TypeId)
    (param layout LayoutId)
    ; An optional that holds nothing: the flag is clear, and what it would hold is the value its
    ; type has with nothing written. One held as a pointer is the pointer that points at nothing.
    (if (call is-null-form type)
      (return (call Typed (call integer (as layout MachineKind) 0) type))
    )
    (return (call null-value type layout 0))
  )
  (fn-do _ null-value Typed
    (param type TypeId)
    (param layout LayoutId)
    (param site SyntaxId)
    ; The value a type has with nothing written, in memory of the frame: no bits set, but for
    ; the empty text wherever a text is held, in a field of a tuple or struct or in an optional,
    ; however deep.
    (let empty (call frame layout))
    (call zero empty layout)
    (call empty-texts empty 0 type layout site)
    (return (call Typed empty type))
  )
  (fn-do _ empty-texts _ (?! Refused)
    (param memory Operand)
    (param offset U32)
    (param type TypeId)
    (param layout LayoutId)
    (param site SyntaxId)
    ; Stores the empty text at each place of zeroed memory that holds a text.
    (if (or (== type no-type) (== type invalid-type))
      (return)
    )
    (if (== type (. types string-type))
      (call store memory offset (call make-operand .operand-constant (call (. ir add-string) "")) false site)
      (return)
    )
    (if (or (not (call (. tables layouts is-struct) layout)) (not (. ([] (. tables layouts rows) layout) is-managed)))
      (return)
    )
    (if (call (. types is-optional) type)
      (let inner (call (. tables layouts field) layout 0))
      (call empty-texts memory (+ offset (. inner offset)) (call (. types optional-inner) type) (. inner layout) site)
      (return)
    )
    (if (not (call is-aggregate type))
      (return)
    )
    (let range (. ([] (. types completions) type) properties))
    (for (in position (..< 0 (. range count)))
      (let property ([] (. types properties) (+ (. range start) position)))
      (if (== (. property slot) (. U32 max))
        (continue)
      )
      (let field (call (. tables layouts field) layout (. property slot)))
      (call empty-texts memory (+ offset (. field offset)) (. property type) (. field layout) site)
    )
  )
  (fn-do _ rehouse Typed
    (param site SyntaxId)
    (param row ConversionFact)
    (param value Typed)
    ; An optional made an optional of another type: where it holds a value, that value converted
    ; as the conversion's one part says and held, and else the optional that holds nothing.
    (let source (. value type))
    (let target (. row to))
    (let layout (call layout-of target site))
    (if (call is-null-form target)
      (return (call rehouse-pointer site row value layout))
    )
    (if (not (call (. tables layouts is-struct) layout))
      (call refuse .refused-conversion site)
      (return value)
    )
    (let made (call frame layout))
    (call zero made layout)
    (let holds (call present site value))
    (let held (call (. ir reserve-block)))
    (let done (call (. ir reserve-block)))
    (call branch (. holds operand) held done)
    (call (. ir start-block) held)
    (let given
      (call convert-one
        (block
          (arg site)
          (arg ([] (. facts conversion-parts) (. row parts)))
          (arg (call payload site (call Typed (. value operand) source)))
        )
      )
    )
    (let housed (call wrap site given target))
    (call copy made (. housed operand) layout false site)
    (call jump done)
    (call (. ir start-block) done)
    (return (call Typed made target))
  )
  (fn-do _ rehouse-pointer Typed
    (param site SyntaxId)
    (param row ConversionFact)
    (param value Typed)
    (param layout LayoutId)
    (let source (. value type))
    (let target (. row to))
    (let holds (call present site value))
    (let slot (call join-slot layout))
    (let mark (. joins length))
    (let held (call (. ir reserve-block)))
    (let other (call (. ir reserve-block)))
    (let joined (call (. ir reserve-block)))
    (call branch (. holds operand) held other)
    (call (. ir start-block) held)
    (let given
      (call convert-one
        (block
          (arg site)
          (arg ([] (. facts conversion-parts) (. row parts)))
          (arg (call payload site (call Typed (. value operand) source)))
        )
      )
    )
    (let housed (call wrap site given target))
    (call arrive site (. housed operand) joined slot)
    (call (. ir start-block) other)
    (call arrive site (. (call empty-optional target layout) operand) joined slot)
    (return (call Typed (call close-joins joined mark layout slot) target))
  )
  (fn-do _ present Typed
    (param site SyntaxId)
    (param value Typed)
    ; Whether an optional holds a value, which its flag says, or for one held as a pointer that
    ; the pointer points at something.
    (let layout (call layout-of (. value type) site))
    (if (call is-null-form (. value type))
      (return
        (call Typed
          (block
            (arg (call compare site .compare-not-equal (. value operand) (call integer (as layout MachineKind) 0)))
            (arg (. types bool-type))
          )
        )
      )
    )
    (if (or (not (call (. types is-optional) (. value type))) (not (call (. tables layouts is-struct) layout)))
      (call refuse .refused-type site)
      (return value)
    )
    (let flag (call (. tables layouts field) layout 1))
    (let compared
      (call compare
        (block
          (arg site)
          (arg .compare-not-equal)
          (arg (call load (. value operand) (. flag offset) (. flag layout) site))
          (arg (call integer .machine-i8 0))
        )
      )
    )
    (return (call Typed compared (. types bool-type)))
  )
  (fn-do _ payload Typed
    (param site SyntaxId)
    (param value Typed)
    ; What an optional holds, read where it lies. Whether it holds anything is tested by what
    ; reads it, or was settled by the type pass. One held as a pointer is what it holds.
    (let layout (call layout-of (. value type) site))
    (if (call is-null-form (. value type))
      (return (call Typed (. value operand) (call (. types optional-inner) (. value type))))
    )
    (if (or (not (call (. types is-optional) (. value type))) (not (call (. tables layouts is-struct) layout)))
      (call refuse .refused-type site)
      (return value)
    )
    (return
      (call Typed
        (block
          (arg (call take (. value operand) (call (. tables layouts field) layout 0) site))
          (arg (call (. types optional-inner) (. value type)))
        )
      )
    )
  )
  (fn-do _ unwrap Typed
    (param site SyntaxId)
    (param value Typed)
    ; What an optional holds, where one that holds nothing is a panic, or inside a pattern a
    ; value that does not match.
    (let held (. value type))
    (if (and (not (. function may-panic)) (== (. matching failing) no-block))
      (call refuse .refused-conversion site)
      (return value)
    )
    (let tested (call present site value))
    (if (!= (. matching failing) no-block)
      (call pass-or-fail (. tested operand) (. matching failing))
      (return (call payload site (call Typed (. value operand) held)))
    )
    (let filled (call (. ir reserve-block)))
    (let missing (call (. ir reserve-block)))
    (call branch (. tested operand) filled missing)
    (call (. ir start-block) missing)
    (call raise-text site (str "Optional'" (call type-display types (call (. types optional-inner) held)) " is null"))
    (call (. ir start-block) filled)
    (return (call payload site (call Typed (. value operand) held)))
  )
  (fn-do _ emit-force Typed
    (param id SyntaxId)
    (param operand SyntaxId)
    ; `a!`: what an optional holds, or a panic where it holds nothing. An operand the type pass
    ; had narrowed already is what it holds, and nothing is tested: the force fact says so where
    ; the operand is read as the optional it is stored as. One the fact does not call narrowed,
    ; though the operand was typed narrowed where a lazy local's value was first typed, is read as
    ; stored (`stored-read`) and tested, as the reference does at a read that types the value again.
    (let fact (call (. facts first-force) (. unit reading) id))
    (let outer stored-read)
    (= stored-read (if-expr (and (!= fact no-fact) (not (. ([] (. facts forces) fact) is-narrowed))) operand 0))
    (let value (call emit-expression operand))
    (= stored-read outer)
    (if (not (call (. types is-optional) (. value type)))
      (return value)
    )
    (if (and (!= fact no-fact) (. ([] (. facts forces) fact) is-narrowed))
      (if (and (!= shared-depth 0) (not (call (. facts is-inside-read) (. unit reading) operand)))
        (call refuse .refused-expression id)
        (return value)
      )
      (return (call payload id value))
    )
    (return (call unwrap id value))
  )
  (fn-expr _ holds Bool
    (param held TypeId)
    (param type TypeId)
    ; Whether a type is an optional of another: what a name narrowed to the other is stored as.
    (and typed-held (call (. types is-optional) held) (== (call (. types optional-inner) held) type))
    (where
      (lazy typed-held (and (!= held no-type) (!= held invalid-type)))
    )
  )
  (fn-do _ cast Typed
    (param site SyntaxId)
    (param value Typed)
    (param target TypeId)
    ; A cast between two numbers or between two pointers, of an integer to a pointer, or of a
    ; pointer that is no object to an integer. A number becomes a Bool by a test
    ; against zero, and a one-bit integer by its lowest bit. Any other number keeps its value as
    ; far as the target can hold it, and a pointer keeps its bits. An integer becomes the address
    ; it counts, with no sign, and a pointer the integer its address is, as far as the target can
    ; hold it. A pointer that becomes text is adopted by the runtime, which has no shape yet.
    (let source (call layout-of (. value type) site))
    (let layout (call layout-of target site))
    (let from-kind (call intrinsic (. value type)))
    (let to-kind (call intrinsic target))
    (let numbers (and (call is-number source) (call is-number layout)))
    (let pointers (and (call is-pointer source) (call is-pointer layout)))
    (let address (and (call is-integer source) (call is-pointer layout) (not (call is-text target))))
    (let points (or (== from-kind .cpointer) (== from-kind .atom)))
    (let counted
      (scope (and pointer-to-integer (!= to-kind .bool) (!= to-kind .int1))
        (lazy pointer-to-integer (and points (call is-pointer source) (call is-integer layout)))
      )
    )
    (if (and (not numbers) (not pointers) (not address) (not counted))
      (call refuse .refused-conversion site)
      (return value)
    )
    (if (and pointers (call is-text target) (not (call is-text (. value type))))
      (call refuse .refused-conversion site)
      (return value)
    )
    (if (and numbers (== to-kind .bool) (!= from-kind .bool))
      (let tested (call compare-zero site value .compare-not-equal))
      (return (call Typed (. tested operand) target))
    )
    (if (and numbers (== to-kind .int1) (!= from-kind .int1))
      (if (not (call is-integer source))
        (call refuse .refused-conversion site)
        (return value)
      )
      (let start U32 (. ir operands length))
      (call (. ir add-operand) (. value operand))
      (call (. ir add-operand) (call integer (call (. tables layouts kind-of) source) 1))
      (let lowest (call append .op-bitwise site (call Span start 2) (. BitwiseOp bitwise-and) source))
      (return (call Typed (call num-cast site (call make-operand .operand-value lowest) source layout) target))
    )
    (return (call Typed (call num-cast site (. value operand) source layout) target))
  )
  (fn-do _ held-object Typed
    (param site SyntaxId)
    (param value Operand)
    (param target TypeId)
    ; The object a value of an interface holds, as a pointer: the first word of the value.
    (let layout (call layout-of target site))
    (let first (call (. tables layouts field) (. tables layouts interface-layout) 0))
    (if (or (not (call is-pointer (. first layout))) (not (call is-pointer layout)))
      (call refuse .refused-conversion site)
      (return (call Typed value no-type))
    )
    (let object (call load value (. first offset) (. first layout) site))
    (return (call Typed (call num-cast site object (. first layout) layout) target))
  )
  (fn-do _ union-object Typed
    (param site SyntaxId)
    (param value Typed)
    (param target TypeId)
    (let union (call layout-of (. value type) site))
    (let layout (call layout-of target site))
    (if (or (not (call (. tables layouts is-union) union)) (not (call is-pointer layout)))
      (call refuse .refused-conversion site)
      (return value)
    )
    (let held (call (. tables layouts case-field) union 0))
    (if (not (call is-pointer (. held layout)))
      (call refuse .refused-conversion site)
      (return value)
    )
    (let object (call load (. value operand) (. held offset) (. held layout) site))
    (return (call Typed (call num-cast site object (. held layout) layout) target))
  )
  (fn-do _ reinterpret Typed
    (param site SyntaxId)
    (param value Typed)
    (param target TypeId)
    ; A value with its bits as they are, as another type: an atom as the text it points at, or a
    ; text as an atom. Both are pointers.
    (let source (call layout-of (. value type) site))
    (let layout (call layout-of target site))
    (let atoms (and (== (call intrinsic (. value type)) .atom) (call is-text target)))
    (let texts (and (call is-text (. value type)) (== (call intrinsic target) .atom)))
    (if (or (and (not atoms) (not texts)) (not (call is-pointer source)) (not (call is-pointer layout)))
      (call refuse .refused-conversion site)
      (return value)
    )
    (return (call Typed (call num-cast site (. value operand) source layout) target))
  )
  (fn-expr _ is-null-form Bool
    (param type TypeId)
    ; Whether an optional is held as the pointer it holds, which points at nothing where there
    ; is none: an optional of an atom, or of a class other than `Null`, whose value is that
    ; pointer.
    (and optional-type (or atom-inner (and class-inner (!= (call (. types optional-inner) type) (. types null-type)))))
    (where
      (lazy optional-type (and (!= type no-type) (!= type invalid-type) (call (. types is-optional) type)))
      (lazy atom-inner (== (call intrinsic (call (. types optional-inner) type)) .atom))
      (lazy class-inner (== (call intrinsic (call (. types optional-inner) type)) .class))
    )
  )
  (fn-expr _ holds-atom Bool
    (param type TypeId)
    (and (call (. types is-optional) type) (== (call intrinsic (call (. types optional-inner) type)) .atom))
  )
  (fn-do _ num-cast Operand
    (param site SyntaxId)
    (param value Operand)
    (param source LayoutId)
    (param layout LayoutId)
    ; A number or a pointer of one layout as one of another.
    (if (== source layout)
      (return value)
    )
    (if (and (== (call operand-kind value) .operand-number) whole-layouts source-number)
      (return
        (call integer
          (block
            (arg (as layout MachineKind))
            (arg (call cast-bits (. ([] (. ir numbers) (call operand-payload value)) bits) source layout))
          )
        )
      )
    )
    (lazy whole-layouts (and (call is-integer source) (call is-integer layout)))
    (lazy source-number (== (. ([] (. ir numbers) (call operand-payload value)) kind) (as source MachineKind)))
    (let start U32 (. ir operands length))
    (call (. ir add-operand) value)
    (return (call make-operand .operand-value (call append .op-num-cast site (call Span start 1) 0 layout)))
  )
  (fn-expr _ cast-bits U64
    (param bits U64)
    (param source LayoutId)
    (param layout LayoutId)
    (call widened held width (call is-signed layout))
    (where
      (lazy source-width (* (. ([] (. tables layouts rows) source) size) 8))
      (lazy width (* (. ([] (. tables layouts rows) layout) size) 8))
      (lazy held (call widened bits source-width (call is-signed source)))
    )
  )
  (fn-do _ equalize Typed
    (param site SyntaxId)
    (param value Typed)
    (param target TypeId)
    (param ratio UnitRatio)
    ; A number as a number of another unit: taken to the widest float, multiplied by the ratio's
    ; multiplier and divided by its divisor, each only when it is not one, and taken to the
    ; target.
    (let source (call layout-of (. value type) site))
    (let layout (call layout-of target site))
    (if (or (not (call is-number source)) (not (call is-number layout)))
      (call refuse .refused-conversion site)
      (return value)
    )
    (let scaled (call num-cast site (. value operand) source f64-layout))
    (if (!= (. ratio multiplier) 1.0)
      (= scaled (call scale site scaled .arithmetic-multiply (. ratio multiplier)))
    )
    (if (!= (. ratio divisor) 1.0)
      (= scaled (call scale site scaled .arithmetic-divide (. ratio divisor)))
    )
    (return (call Typed (call num-cast site scaled f64-layout layout) target))
  )
  (fn-do _ scale Operand
    (param site SyntaxId)
    (param value Operand)
    (param op ArithmeticOp)
    (param amount F64)
    (let start U32 (. ir operands length))
    (call (. ir add-operand) value)
    (call (. ir add-operand) (call float-number f64-layout amount))
    (return (call make-operand .operand-value (call append .op-arithmetic site (call Span start 2) op f64-layout)))
  )
  (fn-do _ compare Operand
    (param site SyntaxId)
    (param predicate ComparePredicate)
    (param left Operand)
    (param right Operand)
    (let start U32 (. ir operands length))
    (call (. ir add-operand) left)
    (call (. ir add-operand) right)
    (return (call make-operand .operand-value (call append .op-compare site (call Span start 2) predicate u8-layout)))
  )
  (fn-do _ compare-zero Typed
    (param site SyntaxId)
    (param value Typed)
    (param predicate ComparePredicate)
    ; Compares a number or a C pointer with the zero of its layout, and leaves a Bool.
    (let layout (call layout-of (. value type) site))
    (if (and (not (call is-number layout)) (or (not (call is-pointer layout)) (!= (call intrinsic (. value type)) .cpointer)))
      (call refuse .refused-type site)
      (return value)
    )
    (let origin (call integer (call (. tables layouts kind-of) layout) 0))
    (if (call is-float layout)
      (= origin (call float-number layout 0.0))
    )
    (return (call Typed (call compare site predicate (. value operand) origin) (. types bool-type)))
  )
  (fn-do _ truth Typed
    (param site SyntaxId)
    (param value Typed)
    ; Whether a value tests as true, by its layout: a Bool is its own answer, an optional is true
    ; when it holds a value, and any other number is true when it is not zero. A value a function
    ; tests has no shape here.
    (if (== (. value type) (. types bool-type))
      (return value)
    )
    (if (and (!= (. value type) no-type) (!= (. value type) invalid-type) (call (. types is-optional) (. value type)))
      (return (call present site value))
    )
    (return (call compare-zero site value .compare-not-equal))
  )
  (fn-do _ emit-identifier Typed (?! Refused)
    (param id SyntaxId)
    (param name Atom)
    (param given TypeId (= no-type))
    ; A name: a constant the type pass worked out, one of the two truths, `null`, which is the
    ; pointer that points at nothing, a global, a type as a value, or in a body written in
    ; source the receiver, an argument, a local, the item of a loop, a property of the receiver
    ; or what a getter of it answers, or the name the receiver is written with as a number. A
    ; field named alone in a member that runs on the case of a row is read from its cell, and a
    ; getter named so runs on the row. A name the binder found a member of a markup element
    ; being built is read from the innermost such element that has it. A read of the name of a
    ; markup element the type pass made there first makes it (`raise-element`). What
    ; is read has the type the type pass gave the name, or the name has no shape here. A name
    ; a call calls is typed by no node, and is `given` its type. In the function of a rule made
    ; for a pattern that may raise errors, the pattern is read only where it is called. In the
    ; function that evaluates a line of a style rule from the slots of a style sheet, a value the
    ; rule takes as a slot is read from where `bind-themed-givens` kept it.
    (let themed (call (. facts theme-read-of) (. unit reading) id))
    (if themed
      (return (call read-theme id themed))
    )
    (let binding (. ([] (. instances rows) (. unit reading)) binding))
    (let type (if-expr (!= given no-type) given (call (. facts node-type) (. unit reading) id)))
    (if (and (== (. function kind) .style-themed-value) (!= (. rule-names length) 0) (!= binding no-binding))
      (let taken (call (. bindings resolution-of) binding id))
      (if (and (== (. taken kind) .resolve-slot) (== (. ([] (. bindings slots) (. taken slot)) kind) .slot-argument))
        (return (call read-rule-value (. taken slot) id type))
      )
    )
    (if (and (!= carried-given no-type) (not calling-pattern) (call (. types is-pattern-func) type))
      (call refuse .refused-expression id)
      (return (call Typed (call make-operand .operand-void 0) no-type))
    )
    (if (== (call (. facts plan-of) (. unit reading) id) .plan-constant)
      (return (call Typed (call emit-constant id) type))
    )
    (if (and (== given no-type) (== (call (. facts plan-of) (. unit reading) id) .plan-row-item))
      (return (call emit-row-item id name))
    )
    (if (and (== given no-type) (== (call (. facts plan-of) (. unit reading) id) .plan-getter))
      (return (call emit-getter id))
    )
    (if (== (call (. facts plan-of) (. unit reading) id) .plan-element-property)
      (return (call read-unmade id name))
    )
    (if (and (!= binding no-binding) (!= (/and/ resolution-flags (. ResolutionFlag resolution-received)) 0))
      (return (call read-received id name))
    )
    (lazy resolution-flags (. (call (. bindings resolution-of) binding id) flags))
    (if (!= binding no-binding)
