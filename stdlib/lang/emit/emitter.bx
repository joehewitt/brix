      (+= pending (. kept operand))
    )
    (for (in position (..< count (. ([] (. instances signatures) callee) args count)))
      (let own
        (call Typed
          (block
            (arg (call make-operand .operand-argument (- (+ first position) count)))
            (arg (call own-type (. row to) (- position count)))
          )
        )
      )
      (let taken (call (. instances argument-type) callee position))
      (if (!= (. own type) taken)
        (= own (call convert-passed callee .reason-argument site own taken))
      )
      (+= pending (. own operand))
    )
    (let answer (call make-operand .operand-void 0))
    (if foreign
      (call (. ir depend) .callee-c symbol 0)
      (= answer (call call (call make-operand .operand-symbol symbol) site mark .callee-c answers))
      (else-if (and receives (not nests))
        (= takes-result raising)
        (= answer (. (call call-method callee site mark) operand))
        (= takes-result false)
      )
      (else
        (= takes-result raising)
        (= answer (. (call call-instance callee site mark) operand))
        (= takes-result false)
      )
    )
    (if raising
      (= answer (. (call propagate site callee answer) operand))
    )
    (if (not closes)
      (call call-runtime (call callback-exit) 0 (. pending length))
    )
    (if (== returns-type (. types void-type))
      (call return-value (call make-operand .operand-void 0) 0)
      (return)
    )
    (if (!= (. ([] (. instances signatures) callee) returns) returns-type)
      (= answer (. (call convert-passed callee .reason-return site (call Typed answer (. ([] (. instances signatures) callee) returns)) returns-type) operand))
    )
    (call return-value answer 0)
  )
  (fn-expr _ callback-entry RuntimeFunction
    (if-expr foreign-callback .runtime-enter-foreign-callback .runtime-enter-callback)
  )
  (fn-expr _ callback-exit RuntimeFunction
    (if-expr foreign-callback .runtime-leave-foreign-callback .runtime-leave-callback)
  )
  (fn-do _ c-type-site SyntaxId
    (param type TypeId)
    ; Where a C function type is declared, which is where the reference places the call of a
    ; function made a value of it: the syntax of the class first declared as the type, with the
    ; module that holds it the one read. None where the type is written where it is used.
    (let declared (call (. types c-function-decl) type))
    (if (not declared)
      (return 0)
    )
    (match? ([] (. ([] (. program modules) (. declared module)) decls) (. declared decl))
      (case (call .decl-class class)
        (= unit (= (. unit source-module) (. declared module)))
        (return (. class syntax))
      )
    )
    (return 0)
  )
  (fn-do _ emit-cast _
    (param row Adapter)
    ; The function a value of one function type runs as a value of another. Its first argument
    ; is the data the value holds, a copy of the first value, and the rest are the second
    ; type's arguments. It calls the code the copy holds with the data that holds and each
    ; argument as the first type takes it, and answers as the second type does, each converted
    ; as the type pass recorded for the two types. What runs is not known here, so the call is
    ; checked for a panic. It is made where the value is first made, the place a stack trace
    ; names, or where the type pass kept a place for the two types. Where the first type
    ; carries errors the second does, and an error the code gives leaves the function made as
    ; the second type's value or error holds it.
    (let taken (call (of RowRange TypeId)))
    (let given (call (of RowRange TypeId)))
    (let answered (. types void-type))
    (let plain false)
    (let source (call function-row types (. row from)))
    (let target (call function-row types (. row to)))
    (match? ([] (. types rows) source)
      (case (call .type-function shape)
        (= taken (. shape args))
        (= plain (not (. shape is-c)))
        (= answered (call value-returned (. shape return-type)))
      )
    )
    (match? ([] (. types rows) target)
      (case (call .type-function shape)
        (= given (. shape args))
        (= plain (and plain (not (. shape is-c))))
        (= returns-type (call value-returned (. shape return-type)))
      )
    )
    (let gives (if-expr (and plain (call carries source)) (call (. facts carried-result) source) no-type))
    (let makes (if-expr (and plain (call carries target)) (call (. facts carried-result) target) no-type))
    (if (and plain (or (and (call carries source) (== gives no-type)) (and (call carries target) (== makes no-type))))
      (= plain false)
    )
    (if (or (not plain) (!= (. taken count) (. given count)) (and (!= gives no-type) (== makes no-type)))
      (call refuse-own)
      (return)
    )
    (call (. ir add-argument) managed-layout)
    (for (in offset (..< 0 (. given count)))
      (call (. ir add-argument) (call layout-of (call (. types child-type) given offset) 0))
    )
    (= (. ir returns) (call layout-of returns-type 0))
    (if (!= makes no-type)
      (call return-results makes 0)
    )
    (let answers
      (call layout-of given-type 0
        (block
          (lazy given-type (if-expr (== gives no-type) answered gives))
        )
      )
    )
    (let held (call make-operand .operand-argument 0))
    (let code (call load held 0 pointer-layout (. row site)))
    (let mark (. pending length))
    (+= pending
      (call load
        (block
          (arg held)
          (arg (. (call (. tables layouts field) (. tables layouts function-layout) 1) offset))
          (arg managed-layout)
          (arg (. row site))
        )
      )
    )
    (for (in offset (..< 0 (. given count)))
      (let own (call make-operand .operand-argument (+ 1 offset)))
      (let wanted (call (. types child-type) taken offset))
      (if (!= (call (. types child-type) given offset) wanted)
        (= own (. (call convert-cast row .reason-argument (call Typed own (call (. types child-type) given offset)) wanted) operand))
      )
      (+= pending own)
    )
    (let answer (call call code (. row site) mark .callee-value answers true))
    (if (!= gives no-type)
      (= answer (. (call propagate-held (. row site) gives answer) operand))
    )
    (if (== returns-type (. types void-type))
      (call return-value (call make-operand .operand-void 0) 0)
      (return)
    )
    (if (!= answered returns-type)
      (= answer (. (call convert-cast row .reason-return (call Typed answer answered) returns-type) operand))
    )
    (call return-value answer 0)
  )
  (fn-do _ convert-cast Typed
    (param row Adapter)
    (param reason ConversionReason)
    (param value Typed)
    (param to TypeId)
    ; A value the function made for two function types gives the code it runs, or what that
    ; code answered, converted by the conversion the type pass recorded for the two types. One
    ; it recorded none for has no shape.
    (let fact (call (. facts cast-conversion) (. row from) (. row to) reason (. value type) to))
    (if (== fact no-fact)
      (call refuse-own)
      (return value)
    )
    (return (call convert-one (. row site) ([] (. facts conversions) fact) value))
  )
  (fn-do _ own-type TypeId
    (param target TypeId)
    (param offset U32)
    ; The type of an argument of a function type.
    (match? ([] (. types rows) (call function-row types target))
      (case (call .type-function shape)
        (return (call (. types child-type) (. shape args) offset))
      )
    )
    (return no-type)
  )
  (fn-expr _ is-binding Bool
    (param type TypeId)
    ; Whether a type is a binding: a function, a method or a constructor named, with the
    ; arguments given it so far.
    (and (!= type no-type) (!= type invalid-type) (== (call intrinsic type) .binding))
  )
  (fn-do _ binds-object Bool
    (param type TypeId)
    ; Whether a binding holds a value it calls on, or calls: the receiver of a method, a
    ; closure, or a value of a function type. A constructor's binding names its class and holds
    ; nothing for it.
    (match? ([] (. types rows) type)
      (case (call .type-binding row)
        (return (and (!= (. row object) no-type) (!= (. row form) .bound-constructor)))
      )
    )
    (return false)
  )
  (fn-do _ bound-count U32
    (param type TypeId)
    ; How many arguments a binding holds.
    (match? ([] (. types rows) type)
      (case (call .type-binding row)
        (return (- (. row items count) (. row param-count)))
      )
    )
    (return 0)
  )
  (fn-do _ part Typed
    (param source Operand)
    (param layout LayoutId)
    (param position U32)
    (param syntax SyntaxId)
    ; What a binding holds at a place: a field of the tuple it is, read with the field's type.
    ; One with no size holds only values of no size.
    (if (== layout void-layout)
      (return (call Typed (call make-operand .operand-void 0) (. types void-type)))
    )
    (let field (call (. tables layouts field) layout position))
    (let value (call take source field syntax))
    (return (call Typed value (. field type)))
  )
  (fn-do _ name-binding Typed
    (param id SyntaxId)
    (param type TypeId)
    (param object SyntaxId)
    ; A function or a method read as a value: a binding that holds no argument yet, but for a
    ; method the defaults the type pass bound, as `put-defaults` gives them. A method's holds the
    ; value it is read from, or with none written the receiver of the function the name is read
    ; in, which for a value written for the receiver's class is the object it is evaluated for. A
    ; function's holds nothing, and has no size.
    (let nothing (call make-operand .operand-void 0))
    (let layout (call layout-of type id))
    (let defaults (call bound-count type))
    (if (and (!= defaults 0) (not (call binds-object type)))
      (call refuse .refused-expression id)
    )
    (if (not (call binds-object type))
      (if (!= object 0)
        (call emit-expression object)
      )
      (return (call Typed nothing type))
    )
    (let value (call Typed (. unit self) (. unit owner-type)))
    (if (!= object 0)
      (= value (call emit-expression object))
      (else-if (and (. unit has-self) (!= (. unit reading) (. unit instance)) (call evaluates-value) (== (. filling count) 0))
        (= value (call Typed (. unit self) (. unit self-type)))
      )
      (else-if (or (not (. unit has-self)) (!= (. unit reading) (. unit instance)))
        (call refuse .refused-expression id)
      )
    )
    (if (== layout void-layout)
      (return (call Typed nothing type))
    )
    (let field (call (. tables layouts field) layout 0))
    (if (or (!= (. ([] (. tables layouts rows) layout) fields count) (+ 1 defaults)) (!= (. value type) (. field type)))
