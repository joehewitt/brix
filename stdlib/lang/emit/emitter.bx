    (let mine ([] (. instances signatures) (. row override)))
    (let written ([] (. instances rows) (. row override)))
    (let forwards (!= (. mine errors count) 0))
    (if (or (!= (. theirs args count) (. mine args count)) (and forwards (!= (. theirs result) (. mine result))))
      (call refuse-instance (. row override))
      (return)
    )
    (call (. ir add-argument) (call layout-of (. ([] (. instances rows) (. row proto)) self-type) 0))
    (for (in position (..< 0 (. theirs args count)))
      (let given (call (. instances argument-type) (. row proto) position))
      (if (!= given (call (. instances argument-type) (. row override) position))
        (call refuse-instance (. row override))
