    (let leaving (call (. ir reserve-block)))
    (let staying (call (. ir reserve-block)))
    (call branch (. tested operand) leaving staying)
    (call (. ir start-block) leaving)
    (call return-from id expr)
    (call (. ir start-block) staying)
