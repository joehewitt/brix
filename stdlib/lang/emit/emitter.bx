      (return (call Typed (call address target (call global-offset kept) (. kept layout) syntax) (. kept type)))
    )
    (return (call Typed (call load target (call global-offset kept) (. kept layout) syntax) (. kept type)))
  )
  (fn-do _ global-base Operand
    (param kept GlobalStorage)
