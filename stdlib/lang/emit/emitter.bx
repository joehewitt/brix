    )
    (let captured (. ([] (. bindings nested) ([] (. tables capture-rows) callee)) captures))
    (for (in index (..< 0 (. captured count)))
      (let slot (. ([] (. bindings captures) (+ (. captured start) index)) slot))
      (if (not (call (. tables copies) callee slot))
        (if (and (== (. ([] (. bindings slots) slot) kind) .slot-lazy) (not (call task-holds slot)))
          (let shared (call find-captured slot id))
          (call read-lazy-local slot id (. shared type))
