    (and (call (. tables layouts is-struct) fused-read) (> (. ([] (. tables layouts rows) fused-read) cases count) 1))
  )
  (fn-do _ read-case Operand
    (param index U32)
    (param held Operand)
    (param syntax SyntaxId)
    (let made (call frame fused-read))
    (call zero made fused-read)
    (call store made 0 (call integer .machine-u8 index) false syntax)
    (call put made (call (. tables layouts case-field) fused-read index) held syntax)
    (return made)
  )
  (fn-do _ narrower-error-case U32
    (param type TypeId)
    (param depth U32)
    (param from U32 (= 1))
    ; The first case of what the function returns, from a number on, that holds an error of a
    ; class below a class, as many classes below it as `depth` says, or with no depth at any, or
    ; none.
    (if (== result-type no-type)
