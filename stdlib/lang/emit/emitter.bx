        (continue)
      )
      (let field (call (. tables layouts field) layout (call (. tables capture-field) callee slot)))
      (if (call (. tables refers) callee slot)
        (let place (call slot-address slot id))
        (call store capture (. field offset) place false id)
        (continue)
      )
