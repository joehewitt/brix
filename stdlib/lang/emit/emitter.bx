    (let helper (call (. tables stream-action-of) (. unit reading) arm))
    (if (or (== helper no-function) (and (not (. function may-panic)) (not in-landing)))
      (call refuse .refused-expression arm)
      (return (call Typed nothing no-type))
    )
    (let target ([] (. tables functions) helper))
    (let row ([] (. facts outlined) (. target place)))
    (let type (call (. facts node-type) (. unit reading) arm))
    (let raising (!= (. ([] (. instances signatures) (. row instance)) errors count) 0))
    (if (and raising (or in-zone (== (. row result) no-type)))
      (call refuse .refused-expression arm)
      (return (call Typed nothing no-type))
    )
    (let returns (call layout-of (if-expr raising (. row result) type) arm))
    (let mark (. pending length))
    (for (in position (..< (. row params start) (+ (. row params start) (. row params count))))
      (+= pending (. (call read-bound ([] (. facts action-slots) position) arm ([] (. facts action-types) position)) operand))
    )
    (call (. ir depend) .callee-function helper may-panic-dependency)
