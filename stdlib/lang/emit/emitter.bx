(blank)
(prop _ terminate-interrupt U64 (= 2))
(prop _ handshake-requested-control U64 (= 8))
(prop _ termination-requested-control U64 (= 16))
(prop _ poll-period U64 (= 64))
(prop _ probe-look-period U64 (= 0x100))
(prop _ finished-step U64 (= (. U64 max)))
(prop _ parse-region-mark-offset U32 (= 16))
(prop _ parse-region-offset U32 (= 24))
(prop _ task-locals-offset U32 (= 32))
(prop _ no-local LocalId (= (. U32 max)))
(prop _ no-place U32 (= (. U32 max)))
(prop _ no-hops U32 (= (. U32 max)))
(prop _ unsourced SyntaxId (= (. U32 max)))
(prop _ no-probe U64 (= (. U64 max)))
(prop _ probe-data-type-count _ (= 16))
(prop _ any-item U64 (= 0x10ffff))

(type _ PartOp (is U32)
  ; What the part of a machine merged with others does for a case where another calls it
  ; (`emit-machine-part`). A piece below calls it for a case it writes: enters it and settles it,
  ; enters it on the way to a case written in it, keeps it as entered, runs what an entered case
  ; runs and settles it or not, exits it where it is active, exits the cases written in it, and, at
  ; the root, exits every active case. The piece above calls it for a case a piece above writes, or
  ; the root, for what it and the pieces below it add there: runs the statements they add to the
  ; case's entry, subscribes the groups they add, tries the immediate transitions they add,
  ; answering whether one passed, unsubscribes those groups, runs the `do finally` blocks they add,
  ; exits the active cases they write below the case, enters the first case they write in it,
  ; answering whether one was, and, from `part-join` on, tries the groups they join the group of
  ; that place among the facts' groups with, answering whether a transition passed.
  (blank)
  (variant part-enter (= 0))
  (variant part-enter-step (= 1))
  (variant part-mark (= 2))
  (variant part-settle (= 3))
  (variant part-step (= 4))
  (variant part-exit (= 5))
  (variant part-exit-below (= 6))
  (variant part-exit-all (= 7))
  (variant part-entries (= 8))
  (variant part-subscribe (= 9))
  (variant part-immediates (= 10))
  (variant part-unsubscribe (= 11))
  (variant part-finally (= 12))
  (variant part-exit-added (= 13))
  (variant part-initial (= 14))
  (variant part-join (= 15))
)

(fn-expr _ relayed-ops (list PartOp)
  ; What the piece above a part calls it for, for what it and the pieces below it add.
  (item (. PartOp part-entries))
  (item .part-subscribe)
  (item .part-immediates)
  (item .part-unsubscribe)
  (item .part-finally)
  (item .part-exit-added)
  (item .part-initial)
)

(type _ EmittedLoop (is Tuple)
  ; A loop whose body is being emitted. `syntax` is its header, or the loop itself when it has
  ; none. `step` is where `continue` goes and `done` where `break` does. `item` is the value
  ; its item has in the body, of type `item-type`, when it has an item; a loop over a
  ; container keeps its item in the slot `kept` instead. `cleanups` is how many cleanups were
  ; open where the loop began: leaving it runs the ones opened since.
  (blank)
  (prop + syntax SyntaxId)
  (prop + step IRBlockId)
  (prop + done IRBlockId)
  (prop + item Operand)
  (prop + item-type TypeId)
  (prop + cleanups Size)
  (prop + kept SlotId)
)

(type _ CountingPass (is Tuple)
  ; A loop `open-pass` began, which counts its passes from 0: the local that holds the count, the
  ; block that tests it, the block after the last pass, and `index`, the count in the pass being
  ; emitted.
  (blank)
  (prop + counter LocalId)
  (prop + testing IRBlockId)
  (prop + done IRBlockId)
  (prop + index Operand)
)

(type _ Unit (is Tuple)
  ; Whose code the walker emits, and where the locals of its binding are. `instance` is the instance
  ; whose code it is, `reading` the instance whose facts are read and `source-module` the module
  ; whose syntax is: the function's own, except for the value of a global, which its module's main
  ; typed, and for the value a class writes for a property, which is typed by an instance of its own
  ; for each type that holds the property. `owner-type` is the receiver's type: the instance's own,
  ; or in a nested function that of the member it is written in, whose receiver it reads from the
  ; environment. `own-scope` is the scope of the instance's function, and the slots of its binding
  ; run from `slot-start`, `slot-count` of them. A local is a cell of the function's frame, and so is
  ; an argument of a body written in source: `cells` finds the cell of each slot, and `positions`
  ; which argument each is. `kept` finds the value of each slot that holds the middle of a chain of
  ; orderings, and `kept-types` its type. `lazy-flags` finds the cell of the flag of each slot that
  ; is a lazy local evaluated once, and `lazy-readers` the read that evaluates one evaluated by the
  ; first of its reads; `inlines` is whether some lazy local is evaluated by its one read. While a
  ; constructor gives the properties their first values, a lazy local read then is evaluated once for
  ; all such reads, with `fill-flags` its flag and `fill-cells` its cell. `self` is the receiver,
  ; when `has-self` says there is one: the first argument of a member, and the object a constructor
  ; has made; `takes-self` says it is the first argument. `self-type` is the receiver's class in the
  ; function of a lazy property, which has no instance. `running-rule` says the code is a rule of a
  ; class, and `deferred-type` is the class whose put-off properties are being given their values
  ; (`emit-deferred`). `environment` is the local that holds the environment of the function's own
  ; scope, where nested functions capture the locals it declares (`open-environment`), and `received`
  ; says the function was given the environment of the one it is written in. `lender` is the instance
  ; whose lazy local a nested function written in it is evaluating: the local's value is typed by that
  ; instance, so the unit reads the lender then, and what the value reads is read from the
  ; environments, as the nested function reads anything of the function it is written in.
  ; `open-held` is the place of the one slot holding the middle of a chain of orderings that the code
  ; being emitted may read. Code read as another's, such as a style rule applied to an element, is
  ; emitted under a unit of its own, and the unit before it is put back whole after.
  (blank)
  (prop + instance InstanceId (= no-instance))
  (prop + reading InstanceId (= no-instance))
  (prop + source-module ModuleId (= 0))
  (prop + owner-type TypeId (= no-type))
  (prop + own-scope ScopeId (= no-scope))
  (prop + slot-start U32)
  (prop + slot-count U32)
  (prop + cells (of CPointer U32) (= (as 0 (of CPointer U32))))
  (prop + kept (of CPointer U32) (= (as 0 (of CPointer U32))))
  (prop + kept-types (of CPointer U32) (= (as 0 (of CPointer U32))))
  (prop + positions (of CPointer U32) (= (as 0 (of CPointer U32))))
  (prop + lazy-flags (of CPointer U32) (= (as 0 (of CPointer U32))))
  (prop + lazy-readers (of CPointer U32) (= (as 0 (of CPointer U32))))
  (prop + fill-flags (of CPointer U32) (= (as 0 (of CPointer U32))))
  (prop + fill-cells (of CPointer U32) (= (as 0 (of CPointer U32))))
  (prop + inlines Bool)
  (prop + self Operand (= 0))
  (prop + self-type TypeId (= no-type))
  (prop + has-self Bool)
  (prop + takes-self Bool)
  (prop + running-rule Bool)
  (prop + deferred-type TypeId (= no-type))
  (prop + environment LocalId (= no-local))
  (prop + received Bool)
  (prop + lender InstanceId (= no-instance))
  (prop + open-held U32 (= no-place))
)

(type _ UnitRun (is Tuple)
  ; What the function emitted keeps while it runs the code of another instance as its own (see
  ; `enter-unit`): its unit, whether its code runs where the collector never sees it, and what the
  ; `do` blocks it is in keep it from.
  (blank)
  (prop + unit Unit)
  (prop + in-zone Bool)
  (prop + block-effects U32)
)

(type _ Match (is Tuple)
  ; The pattern the walker emits. `failing` is the block a test that fails goes to, and
  ; `exact-class` says a class test there passes the class alone, no subclass of it. `testing` says
  ; the pattern only tests its subject, as an `is` does, and binds nothing; `declaring` that the
  ; names it binds are locals of a declaration or of the header of a loop, and `tested` is the
  ; expression a test reads its subject from, or none. `arm-it` is the slot `it`
  ; names in the arm being emitted. `case-subject` is the subject of the match whose arms are
  ; emitted: `checks-row` says the type pass checked it as a row of a table, `checked-row` is its
  ; value, and `checked-made` the one among `made-rows` it is, or `U32.max`. `read-in-place` is the
  ; expression a name is read from at once, or none.
  (blank)
  (prop + failing IRBlockId (= no-block))
  (prop + exact-class Bool)
  (prop + testing Bool)
  (prop + tested SyntaxId (= 0))
  (prop + declaring Bool)
  (prop + arm-it SlotId (= no-slot))
  (prop + read-in-place SyntaxId (= 0))
  (prop + case-subject SyntaxId (= 0))
  (prop + checks-row Bool)
  (prop + checked-row Operand (= 0))
  (prop + checked-made U32 (= (. U32 max)))
)

(type _ Making (is Tuple)
  ; The tuple or struct the walker gives the fields of their first values: `memory` is where it
  ; lies, `type` its type, `layout` its layout and `site` where it is made. `made` says which fields
  ; have theirs, from `mark` on, and `own` that the function is the constructor of what is made,
  ; whose arguments fill fields of their names. `callee` is the constructor generated for it, called
  ; where it is made, and `default-holder` the instance whose facts convert the defaults of the
  ; arguments a property's construction leaves out.
  (blank)
  (prop + memory Operand (= 0))
  (prop + type TypeId (= no-type))
  (prop + layout LayoutId (= no-layout))
  (prop + site SyntaxId (= 0))
  (prop + mark Size (= 0))
  (prop + own Bool)
  (prop + callee InstanceId (= no-instance))
  (prop + default-holder InstanceId (= no-instance))
)

(type _ Styling (is Tuple)
  ; The style rules the walker applies at a site. `element` is the markup element whose
  ; constructor call stores what the element is given, and `valued` the one whose call evaluates
  ; the values given to the style rules written on it. `gate` is the gate in force among the site's
  ; `site-gates`, or `U32.max`. `action` is the action of the application being emitted, which
  ; makes the action of each declaration whose value reads something tracked, `live` the
  ; application whose values are live, or `U32.max`, and `family-gated` says its declarations are
  ; gated by a family of rules.
  (blank)
  (prop + element SyntaxId (= 0))
  (prop + valued SyntaxId (= 0))
  (prop + gate U32 (= (. U32 max)))
  (prop + action InstanceId (= no-instance))
  (prop + live U32 (= (. U32 max)))
  (prop + family-gated Bool)
)

(type _ Scoping (is Tuple)
  ; Where the cleanups the walker runs begin. `block-base` is how many of `open-cleanups` were open
  ; where the block being emitted began. While a cleanup runs on a way out, `cleaning` says so,
  ; `cleaning-open` counts the cleanups open around it, which an error it raises runs on its way
  ; out, and `cleaning-top` those open where they began to run, above which are those opened in it;
  ; `unwinding-from` is the body of the one a panic made the way out through. While a rule of a
  ; class is emitted, `rule-leaving` is where a return in its body goes, with `rule-cleanups` the
  ; cleanups open as the body began. While the expression that gives a block written as a value
  ; its value is emitted, `giving` says so, with `giving-lazies` the lazy locals then open.
  (blank)
  (prop + block-base Size (= 0))
  (prop + giving Bool)
  (prop + giving-lazies Size (= 0))
  (prop + cleaning Bool)
  (prop + cleaning-open Size (= 0))
  (prop + cleaning-top Size (= 0))
  (prop + unwinding-from SyntaxId (= 0))
  (prop + rule-leaving IRBlockId (= no-block))
  (prop + rule-cleanups U32)
)

(type _ Streaming (is Tuple)
  ; The grammar the walker emits. `pattern-helper` is the helper the pattern is run with, of
  ; the type `pattern-helper-type`, or no type where it has none, and `helper-argument` says the
  ; function takes it as an argument. `marks-argument` says the function takes where to give back
  ; the rollback mark it holds, `marked-argument`. `rollback-mark` is the local that holds the
  ; rollback mark of the body being emitted (`open-marks`), and `rollback-row` the body's row;
  ; `storage-row` and `observer-row` are the rows of the storage and observer bodies the type pass
  ; recorded for it, or `U32.max`. `given-stream` is the stream a coded match runs on, of the type
  ; `given-stream-type`. `capture-floor` is the first place a name is kept in that the rule being
  ; run keeps, below which are those of the runs it is inside (`held-here`). `classing` says the
  ; alternatives being tried are a scan's, tried by the item each starts with.
  (blank)
  (prop + pattern-helper Operand (= 0))
  (prop + pattern-helper-type TypeId (= no-type))
  (prop + helper-argument Bool)
  (prop + marks-argument Bool)
  (prop + marked-argument Operand (= 0))
  (prop + rollback-mark LocalId (= no-local))
  (prop + rollback-row U32 (= (. U32 max)))
  (prop + storage-row U32 (= (. U32 max)))
  (prop + observer-row U32 (= (. U32 max)))
  (prop + given-stream Operand (= 0))
  (prop + given-stream-type TypeId (= no-type))
  (prop + capture-floor U32)
  (prop + classing Bool)
)

(type _ Filling (is Tuple)
  ; The properties a constructor gives their first values. `type` is the type that holds them,
  ; `count` how many there are and `start` the place of the first; `filled` says which have theirs:
  ; 0 one with no value yet, 1 one whose value is being evaluated, 2 one that has it, and 3 a lazy one
  ; whose value is stale. `checks` holds the flag of each one a value may first read on some of its
  ; paths alone, and `trackers` the trackers of each whose value runs in a live action of its own
  ; (`clear-checks`). `storing` says the constructor is storing them, and `root` is the value being
  ; evaluated. Where that value is a line of a root `<This` whose closures read the object, `held-unit`
  ; is the instance that types it and `held-environment` the environment its closures are given
  ; (`hold-unit`).
  (blank)
  (prop + type TypeId (= no-type))
  (prop + start U32)
  (prop + count U32)
  (prop + root SyntaxId (= 0))
  (prop + filled (of CPointer Byte) (= (as 0 (of CPointer Byte))))
  (prop + checks (of CPointer U32) (= (as 0 (of CPointer U32))))
  (prop + trackers (of CPointer U32) (= (as 0 (of CPointer U32))))
  (prop + storing Bool)
  (prop + held-unit InstanceId (= no-instance))
  (prop + held-environment LocalId (= no-local))
)

(type _ Machining (is Tuple)
  ; The machine the walker emits (`use-machine`): `fact` is what the type pass found of it and
  ; `slots` what the binder declared it keeps; `items` are its parts, `cases` its cases and `kept`
  ; the names each case keeps. `composite` is the composite it is a piece of, where it is merged with
  ; others, and `piece` which piece it is; `below` are the composites of the machines that refine it
  ; (`below-pieces`).
  (blank)
  (prop + fact (? MachineFact))
  (prop + slots (? MachineSlots))
  (prop + items (list SyntaxId))
  (prop + cases (list SyntaxId))
  (prop + kept (list (list Atom)))
  (prop + composite (? MachineComposite))
  (prop + piece U32)
  (prop + below (list MachineComposite))
)

(type _ Typed (is Tuple)
  ; A value the walker emitted and its type.
  (blank)
  (prop + operand Operand)
  (prop + type TypeId)
)

(type _ Assignment (is Tuple)
  ; What an assignment stored, which is its value, and what it was given before the store
  ; converted it. One that stores no value of its own has neither.
  (blank)
  (prop + stored Typed (= (call Typed (call make-operand .operand-void 0) no-type)))
  (prop + given Typed (= (call Typed (call make-operand .operand-void 0) no-type)))
)

(type _ LiveTrackers (is Tuple)
  ; The locals holding the trackers of a live action open where code is emitted: those it had
  ; when it last ran, and those it gathers now.
  (blank)
  (prop + previous LocalId)
  (prop + next LocalId)
)

(type _ StyleCondition (is Tuple)
  ; A condition made at the site where code is emitted: a `when` of a style rule, and the condition
  ; it was made under, or `U32.max`. A condition stands for itself and those it was made under.
  (blank)
  (prop + when StyleWhen)
  (prop + parent U32)
)

(type _ RuleName (is Tuple)
  ; A name a style rule applied where code is emitted takes its values by: its slot, and the local
  ; that keeps the value, converted, of its type.
  (blank)
  (prop + slot SlotId)
  (prop + cell LocalId)
  (prop + type TypeId)
)

(type _ TurnScope (is Tuple)
  ; A loop whose turn is being emitted and has an environment of its own: its scope, and the local
  ; that holds the environment, or in a function that yields the field of its own environment that
  ; does.
  (blank)
  (prop + scope ScopeId)
  (prop + local LocalId)
  (prop + place U32)
)

(type _ LiveMember (is Tuple)
  ; An attribute or argument of a markup element being made whose value was given in a live action
  ; of its own, and the local of the trackers of that action.
  (blank)
  (prop + member SyntaxId)
  (prop + trackers LocalId)
)

(type _ LivePlace (is Tuple)
  ; A property whose value a constructor gave in a live action of its own, and the local of the
  ; trackers of that action.
  (blank)
  (prop + place U32)
  (prop + trackers LocalId)
)

(type _ ReadyLazy (is Tuple)
  ; The flag of a lazy local kept behind one, and the block where an evaluation of it emitted in the
  ; function has ended.
  (blank)
  (prop + flag LocalId)
  (prop + block IRBlockId)
)

(type _ SharedReady (is Tuple)
  ; A lazy local nested functions capture, and the block where an evaluation of it emitted in the
  ; function has ended.
  (blank)
  (prop + slot SlotId)
  (prop + block IRBlockId)
)

(type _ OpenCleanup (is Tuple)
  ; A cleanup open where code is emitted: its body, how many were open where the block that opened
  ; it began, what the cleanup of a `use` reads, what the `do` blocks around it keep it from, and
  ; whether it was opened by the expression that gives a block written as a value its value.
  (blank)
  (prop + body SyntaxId)
  (prop + base Size)
  (prop + cell UseCell)
  (prop + effects U32)
  (prop + gives Bool)
)

(type _ SiteGate (is Tuple)
  ; A gate of the site where code is emitted: its conditions, the local holding the number of the
  ; block it has open, or none, and the gate in force where it was entered.
  (blank)
  (prop + top U32)
  (prop + block LocalId)
  (prop + outer U32)
)

(type _ RuleValue (is Tuple)
  ; A value given to a style rule written on a markup element, as the element's constructor call
  ; evaluated it, its type and its node.
  (blank)
  (prop + value Operand)
  (prop + type TypeId)
  (prop + written SyntaxId)
)

(type _ LentLazy (is Tuple)
  ; A lazy local declared inside the value of one a function written in the one declaring it
  ; evaluates, and the cells of its flag and its value there.
  (blank)
  (prop + slot SlotId)
  (prop + flag LocalId)
  (prop + cell LocalId)
)

(type _ StateCell (is Tuple)
  ; A state cell of `scope-cells` made where code is emitted, and the local that keeps it.
  (blank)
  (prop + row U32)
  (prop + local LocalId)
)

(type _ AroundValue (is Tuple)
  ; A value a style rule written on a markup element gave, for the rules written in it to read: its
  ; node, and the local that keeps it, converted, of its type.
  (blank)
  (prop + written SyntaxId)
  (prop + local LocalId)
  (prop + type TypeId)
)

(type _ TakenValues (is Tuple)
  ; A row of `scope-values` the function was given (`take-values`), and where the first of its
  ; values is among `around-values`.
  (blank)
  (prop + row U32)
  (prop + first U32)
)

(type _ RecordedLocal (is Tuple)
  ; A number the function records a value under, and the local that keeps the value.
  (blank)
  (prop + number U32)
  (prop + local LocalId)
)

(type _ StackBinding (is Tuple)
  ; A binding of a global `do with` binds that is open around what is being emitted, the local
  ; that keeps the value it replaced, and what its slot's flag holds: 1, or for an effect the number
  ; of the class of the fake bound (`Instances.fake-kind`).
  (blank)
  (prop + bind U32)
  (prop + value LocalId)
  (prop + flag U32)
)

(type _ Rebinding (is Tuple)
  ; A cell a machine's name was bound to anew while the expansion of an exit or an entry that binds
  ; it is emitted, and the local it held before.
  (blank)
  (prop + offset U32)
  (prop + local LocalId)
)

(type _ FoundFirst (is Tuple)
  ; The first items found for a pattern, the key they were found under, and whether they depend on
  ; where the pattern is read.
  (blank)
  (prop + items FirstItems)
  (prop + key U64)
  (prop + contextual Bool)
)

(type _ Pin (is Tuple)
  ; A value evaluated before the code that reads it: the expression it is the value of, the
  ; value and its type. Every reading of the expression while the pin is held gives the value.
  (blank)
  (prop + node SyntaxId)
  (prop + value Operand)
  (prop + type TypeId)
)

(type _ WriteEach (is Tuple)
  ; A pipe that writes each item of what it reads, whose loop is being emitted: the pipe, the
  ; write recorded at it, what it reads and what it writes to, and the local that keeps the
  ; value written to, of type `sink-type`.
  (blank)
  (prop + pipe SyntaxId)
  (prop + fact FactId)
  (prop + left SyntaxId)
  (prop + right SyntaxId)
  (prop + sink LocalId)
  (prop + sink-type TypeId)
)

(type _ BoundValue (is Tuple)
  ; A value a pattern gave a name while the arm it is in is emitted: the slot of the name, the
  ; type of the value and the value, the case of a row the name stands for, or the place a
  ; grammar keeps what the name captured. `it` is bound to what a pattern is given while
  ; the pattern is tested, and to what the pattern passed in the body of its arm; `location` to
  ; where an arm of a grammar was while its expression is emitted.
  (blank)
  (prop + slot SlotId)
  (prop + type TypeId)
  (prop + value Operand)
  (prop + cursor U32 (= (. U32 max)))
  (prop + capture U32 (= (. U32 max)))
)

(type _ MatchStepKind (is U32)
  (variant step-held (= 0))
  (variant step-item (= 1))
  (variant step-from-end (= 2))
  (variant step-length (= 3))
  (variant step-rest (= 4))
)

(type _ MatchHead (is U32)
  (variant head-none (= 0))
  (variant head-case (= 1))
  (variant head-tuple (= 2))
  (variant head-list (= 3))
)

(type _ MatchStep (is Tuple)
  (prop + kind MatchStepKind)
  (prop + pattern SyntaxId)
  (prop + subject Operand)
  (prop + type TypeId)
  (prop + length Operand)
  (prop + carries Bool)
  (prop + position U32)
  (prop + back U32)
  (prop + exact Bool)
)

(type _ SharedArm (is Tuple)
  (prop + arm SyntaxId)
  (prop + first U32)
  (prop + count U32)
  (prop + result Operand)
  (prop + result-type TypeId)
)

(type _ StreamRun (is Tuple)
  ; What the parts of a grammar run over: the node of the pattern; the stream and its
  ; type; the buffer of its view, its type, and the address its items start at; the cursor the
  ; pattern starts at and the count of items, as indexes; the locals that keep how far the
  ; pattern read and the farthest cursor a part of it failed at; the layouts of an index, of an
  ; item and of the buffer; and the calls of the stream's `pattern-view` and `pattern-extend`.
  ; A stream that may give more input as it is read keeps the buffer, the address its items
  ; start at and the count of items of its latest view in locals of their own, which the parts
  ; read as `run-buffer`, `run-data` and `run-length` say.
  (blank)
  (prop + site SyntaxId)
  (prop + stream Operand)
  (prop + stream-type TypeId)
  (prop + buffer Operand)
  (prop + buffer-type TypeId)
  (prop + data Operand)
  (prop + start Operand)
  (prop + length Operand)
  (prop + extent LocalId)
  (prop + error LocalId)
  (prop + index-layout LayoutId)
  (prop + item-layout LayoutId)
  (prop + buffer-layout LayoutId)
  (prop + views FactId (= no-fact))
  (prop + extends FactId (= no-fact))
  (prop + kept-buffer LocalId (= no-local))
  (prop + kept-data LocalId (= no-local))
  (prop + kept-length LocalId (= no-local))
)

(type _ StreamPart (is Tuple)
  ; What a part of a grammar gives where it passes: the cursor where it ended, and its
  ; value, of no type where it gives none (see `emit-stream-part`).
  (blank)
  (prop + ending Operand)
  (prop + value Typed)
)

(fn-expr + bare-part StreamPart
  (param ending Operand)
  ; A part of a grammar that ends at a cursor and gives no value.
  (call StreamPart ending (call Typed (call make-operand .operand-void 0) no-type))
)

(type _ StreamCapture (is Tuple)
  ; Where a grammar keeps what a name it captures matched: the slot of the name, where
  ; the type pass recorded the call that makes its text, the locals of the cursors its text
  ; begins and ends at and, for an optional name, of whether it holds any; for a name that
  ; holds what a rule gave, the local that holds it; its type, and the run of the pattern. A
  ; name captured in repeats nested `listed` deep keeps a list for each, from the innermost
  ; out, the first at `levels` among the lists of captures. A name that `accumulates` keeps one
  ; list, which each place it is captured adds to, or adds to a list a caller keeps where it is
  ; `borrowed`.
  (blank)
  (prop + slot SlotId)
  (prop + site SyntaxId)
  (prop + begin LocalId)
  (prop + end LocalId)
  (prop + present LocalId)
  (prop + value LocalId)
  (prop + type TypeId)
  (prop + run StreamRun)
  (prop + listed U32 (= 0))
  (prop + levels U32 (= 0))
  (prop + accumulates Bool)
  (prop + borrowed Bool)
)

(type _ LentCollector (is Tuple)
  ; A collector a caller lends the function a rule runs in, by a pointer among its arguments:
  ; the argument, the list the function keeps the collector's items and count in while it runs,
  ; and the count the collector held as the function began.
  (blank)
  (prop + argument U32)
  (prop + level CaptureLevel)
  (prop + mark LocalId)
)

(type _ Borrow (is Tuple)
  ; A list a caller keeps that a name a rule accumulates adds to, as a call given a collector
  ; maps it: the rule's name, and the list among the lists of captures.
  (blank)
  (prop + name String)
  (prop + level U32)
)

(type _ CaptureLevel (is Tuple)
  ; The list a repeat keeps of what a name captured on each of its passes: the capture, the
  ; locals of the collector's items and of its size, the call that grows the items, the
  ; collector's type, the type of an item, the type of the list it makes, and the local of the
  ; context its backing keeps the items with, where it is not the collector's.
  (blank)
  (prop + capture U32)
  (prop + items LocalId)
  (prop + size LocalId)
  (prop + grow FactId)
  (prop + collector TypeId)
  (prop + item TypeId)
  (prop + list TypeId)
  (prop + context LocalId)
)

(type _ ItemRange (is Tuple)
  ; The items of a stream from `first` to `last`, both included, as numbers.
  (blank)
  (prop + first U64)
  (prop + last U64)
)

(fn-do _ merged-ranges (list ItemRange)
  (param left (list ItemRange))
  (param right (list ItemRange))
  ; The ranges of two lists, each in order and apart, in order and apart: those that overlap or
  ; touch are joined. Where one list is empty, the other is the result.
  (return-if right (if (== (. left length) 0)))
  (return-if left (if (== (. right length) 0)))
  (blank)
  (let merged (list ItemRange))
  (let at-left Size 0)
  (let at-right Size 0)
  (while (or (< at-left (. left length)) (< at-right (. right length)))
    (let from-left
      (scope (or (>= at-right (. right length)) (and (< at-left (. left length)) left-before))
        (lazy left-before (not (call range-after ([] left at-left) ([] right at-right))))
      )
    )
    (let range (if-expr from-left ([] left at-left) ([] right at-right)))
    (if from-left
      (+= at-left 1)
      (else
        (+= at-right 1)
      )
    )
    (if (and (!= (. merged length) 0) (<= (. range first) (+ (. ([] merged (- (. merged length) 1)) last) 1)))
      (if (> (. range last) (. ([] merged (- (. merged length) 1)) last))
        (= ([] merged (- (. merged length) 1)) (call ItemRange (. ([] merged (- (. merged length) 1)) first) (. range last)))
      )
      (continue)
    )
    (+= merged range)
  )
  (return merged)
)

(fn-expr _ range-after Bool
  (param range ItemRange)
  (param other ItemRange)
  ; Whether a range sorts after another: it starts later, or as early and ends later.
  (or (> (. range first) (. other first)) (and (== (. range first) (. other first)) (> (. range last) (. other last))))
)

(fn-do _ ranges-meet Bool
  (param left (list ItemRange))
  (param right (list ItemRange))
  ; Whether two lists of ranges, each in order and apart, share an item.
  (let at-left Size 0)
  (let at-right Size 0)
  (while (and (< at-left (. left length)) (< at-right (. right length)))
    (if (< (. ([] left at-left) last) (. ([] right at-right) first))
      (+= at-left 1)
      (else-if (< (. ([] right at-right) last) (. ([] left at-left) first))
        (+= at-right 1)
      )
      (else
        (return true)
      )
    )
  )
  (return false)
)

(fn-do _ single-range (list ItemRange)
  (param first U64)
  (param last U64)
  ; A list of one range.
  (let ranges (list ItemRange))
  (+= ranges (call ItemRange first last))
  (return ranges)
)

(type _ FirstItems (is Tuple)
  ; What the reference knows of the items a part of a grammar may start with, as it
  ; judges which alternatives of a choice to skip: whether it knows them, whether the part may
  ; pass where it reads none, and the ranges they lie in, in order and apart; and how far past
  ; where the part is tried it counts the part as read where it is skipped, `no-probe` where it
  ; does not know.
  (blank)
  (prop + known Bool)
  (prop + nullable Bool)
  (prop + ranges (list ItemRange))
  (prop + probe U64)
)

(fn-expr _ guards Bool
  (param first FirstItems)
  ; Whether the reference skips an alternative that starts so where the item at the cursor is
  ; not one it may start with: where it knows them, there are some, and it must read one.
  (and (. first known) (not (. first nullable)) (!= (. first ranges length) 0))
)

(type _ SharedFirst (is Tuple)
  ; What the pattern of a rule may start with for the instance that reads it, judged where no
  ; call met in judging it was cut, which the reference shares among all the patterns it emits;
  ; and the next one kept for another instance of the same pattern.
  (blank)
  (prop + owner InstanceId)
  (prop + found FirstItems)
  (prop + next U32)
)

(type _ CaseCursor (is Tuple)
  ; A name a pattern bound to the case of a row of a table of unions: the row, its type, the
  ; place of the union's table layout and the case. The name reads and writes the row's cells;
  ; used as a value, the case is gathered from them. Once gathered, TypeScript reads the name
  ; from the newest of what it gathered that dominates, though the cells change, and elsewhere
  ; from the cells, gathering it again as a value (`gathered-at`). A row the subject `t[i]` read is `checked`:
  ; TypeScript checked its storage there, and the name reads and writes the columns found then,
  ; with no metadata.
  (blank)
  (prop + row Operand)
  (prop + type TypeId)
  (prop + place U32)
  (prop + case-index U32)
  (prop + checked Bool)
  (prop + columns Operand)
  (prop + index Operand)
)

(type _ CaseGather (is Tuple)
  ; A case a name stands for, gathered from its row's cells: the name's cursor among the case
  ; cursors, the value made and the block it was made in.
  (blank)
  (prop + cursor U32)
  (prop + value Operand)
  (prop + block IRBlockId)
)

(type _ LandingPad (is Tuple)
  ; A landing pad some check of the function branches to, and how many cleanups were open
  ; where the check is: the pad runs those, newest first, before the panic leaves the function.
  ; `site` is the node of the first check that made it, or none: a main reports a panic that
  ; has no source as raised there. A pad is `unsourced` where its first check is at no node
  ; and keeps none: the pad of no cleanups of a spawned task's body, whose first check is where
  ; the body starts, and a pad a panic raised in a cleanup is resumed at where its block ends.
  ; `module` is the module whose tree `site` is in, which is another's where the function writes
  ; that module's code, as a style rule of a theme of another module applied in a main.
  (blank)
  (prop + block IRBlockId)
  (prop + cleanups Size)
  (prop + site SyntaxId)
  (prop + module ModuleId)
)

(type _ TableMeta (is Tuple)
  ; What says whether a table, or a view of one, can still be read: the header an arena's table
  ; keeps, zero for a table that does not grow, the arena that owns it, the arena's incarnation
  ; and generation when the value was made, and the table's shrink generation then.
  (blank)
  (prop + header Operand)
  (prop + owner Operand)
  (prop + incarnation Operand)
  (prop + generation Operand)
  (prop + shrink Operand)
)

(type _ TableCursor (is Tuple)
  ; A row of a table read at `t[i]` and not yet made a value, as TypeScript's cursor is: the
  ; columns, found and checked, the index, checked against the length, and the metadata of the
  ; table.
  (blank)
  (prop + columns Operand)
  (prop + index Operand)
  (prop + meta TableMeta)
)

(type _ MadeRow (is Tuple)
  ; A row of a table made a value, in memory of the frame that nothing writes once it is made, and
  ; the cursor it was made from.
  (blank)
  (prop + value Operand)
  (prop + cursor TableCursor)
)

(type _ TableSource (is Tuple)
  ; The rows of a table or of a span of one, as TypeScript reads them: the columns, found and
  ; checked, the first of the rows, how many there are, and the metadata.
  (blank)
  (prop + columns Operand)
  (prop + offset Operand)
  (prop + length Operand)
  (prop + meta TableMeta)
)

(type _ ProvenTable (is Tuple)
  (prop + loop SyntaxId)
  (prop + kind IntrinsicKind)
  (prop + source TableSource)
)

(type _ ProvenColumn (is Tuple)
  (prop + loop SyntaxId)
  (prop + column U32)
  (prop + local LocalId)
)

(type _ ProvenRead (is Tuple)
  (prop + loop SyntaxId)
  (prop + column U32)
  (prop + block IRBlockId)
  (prop + value Operand)
  (prop + type TypeId)
)

(type _ ProvenItem (is Tuple)
  (prop + loop SyntaxId)
  (prop + slot SlotId)
  (prop + columns Operand)
)

(type _ BuilderItems (is Tuple)
  ; Where the items of an arena's builder are kept, and how many fit there.
  (blank)
  (prop + storage Operand)
  (prop + capacity Operand)
)

(type _ UseCell (is Tuple)
  ; What the cleanup of a `use` reads: the flag that says its cell holds an object, the object
  ; and its type. The cleanup of a `do use` has no flag, since its object is there from the
  ; moment it opens. A `use` in a generator has no cells: its slot keeps the object. Any other
  ; cleanup has none of these.
  (blank)
  (prop + flag LocalId)
  (prop + held LocalId)
  (prop + type TypeId)
  (prop + is-live-call _ (= false))
  (prop + restored-slot U32 (= no-storage))
)

(type _ Refused (is Error)
  ; Raised where a function has no shape, once its refusal is recorded.
)

(type + Emitter
  ; Builds the IR of each function a worker takes into `ir`, each with a `FunctionEmitter` of its
  ; own, and says whether the last was refused (`refusal`) or built as a bridge (`bridged`). It keeps
  ; what lasts from one function to the next: `type-values`, the types whose values the functions name;
  ; the first sets of the patterns they share (`shared-first-heads`); and what the code of the
  ; functions a bridged member calls does to storage, which `probe` builds in `probe-storage`: `scans`
  ; holds what was found for the functions of `scanned`. `lists` are the collections each walker
  ; fills, emptied as each walk begins.
  (blank)
  (prop + ir IRFunction)
  (prop + refusal Refusal)
  (prop + bridged Bool)
  (prop + type-values (list TypeId))
  (prop _ shared-first-heads (of Map U64 U32))
  (prop _ shared-firsts (list SharedFirst))
  (prop _ probe (? Emitter) (= null))
  (prop _ probe-storage (? Arena) (= null))
  (prop _ scanned (list U32))
  (prop _ scans (list CalleeScan))
  (prop _ lists _ (= (call WalkerLists)))
  (prop _ tables ProgramTables)
  (prop _ program Program)
  (prop _ instances Instances)
  (prop _ facts Facts)
  (prop _ types Types)
  (prop _ bindings Bindings)
  (prop _ storage Arena)
  (fn-do + This _
    (param tables ProgramTables)
    (param program Program)
    (param instances Instances)
    (param facts Facts)
    (param types Types)
    (param bindings Bindings)
    (param storage Arena)
    (lazy ir (call IRFunction storage))
  )
  (fn-expr + begin-using _
    this
  )
  (fn-do + end-using _
    (call release)
  )
  (fn-do + release _
    (if probe-storage
      (call (. probe-storage release))
    )
  )
  (fn-expr + is-refused Bool :get
    (!= (. refusal construct) .refused-nothing)
  )
  (fn-do + emit _
    (param id FunctionId)
    ; Builds a function's IR. A member that runs on a row's case, reading its cells with no check,
    ; is built again as a bridge to the member's instance on the case where it may move the row's
    ; storage before it reads the row again, as TypeScript builds its
    ; `table-row-receiver-bridge`. One with no such instance is refused there, and so is one
    ; whose code does not decide it, unless nothing would show which it is built as.
    (= bridged false)
    (let built (call build id))
    (if (or is-refused (== (. built row-columns) (. U32 max)))
      (return)
    )
    (let watched (list U32))
    (+= watched 0)
    (+= watched (. built row-columns))
    (let reads (call receiver-reads ir watched))
    (let judged (call receiver-callees ir tables instances program reads))
    (let verdicts (list Stability))
    (for (in callee judged)
      (+= verdicts (call judge callee))
    )
    (let verdict (call receiver-stability ir tables instances program reads watched judged verdicts))
    (if (== verdict .stable)
      (return)
    )
    (let held ([] (. instances rows) (. built unit instance)))
    (if (or (== (. held materialized) no-instance) (and (== verdict .unsure) (. built function may-panic)))
      (let written (. held subtree))
      (let site (if-expr (!= (. written count) 0) (- (+ (. written start) (. written count)) 1) 0))
      (= refusal (call Refusal .refused-function (. built unit source-module) site))
      (return)
    )
    (= bridged true)
    (call build id)
  )
  (fn-do + emit-fused _
    (param id FunctionId)
    (param read LayoutId)
    (= bridged false)
    (call walk id true true read)
  )
  (fn-do _ judge Stability
    (param callee FunctionId)
    ; What a call of a function judged by its own code may do to storage: it may move storage
    ; where the function's code may, or that of any function it calls in turn.
    (let seen (list U32))
    (let waiting (list U32))
    (+= waiting callee)
    (let verdict (. Stability stable))
    (while (!= (. waiting length) 0)
      (let next ([] waiting (- (. waiting length) 1)))
      (call (. waiting pop))
      (if (!= (call (. seen find) next) null)
        (continue)
      )
      (+= seen next)
      (let scan (call scan-of next))
      (if (== (. scan stability) .unstable)
        (return .unstable)
      )
      (if (== (. scan stability) .unsure)
        (= verdict .unsure)
      )
      (for (in found (. scan callees))
        (+= waiting found)
      )
    )
    (return verdict)
  )
  (fn-do _ scan-of CalleeScan
    (param callee FunctionId)
    ; What a function's own code does to storage, from its code as `probe` builds it, once.
    (for (in position (..< 0 (. scanned length)))
      (if (== ([] scanned position) callee)
        (return ([] scans position))
      )
    )
    (if (not probe)
      (let made (call Arena))
      (= probe-storage made)
      (= probe (call Emitter tables program instances facts types bindings made))
    )
    (call (. (!! probe-storage) reset))
    (call (. (!! probe) build) callee)
    (let none (list U32))
    (let found (call CalleeScan .unsure none))
    (if (not (. (!! probe) is-refused))
      (= found (call own-stability (. (!! probe) ir) tables instances program))
    )
    (+= scanned callee)
    (+= scans found)
    (return found)
  )
  (fn-do _ build FunctionEmitter
    (param id FunctionId)
    ; Builds a function's IR as `emit-function` does. A local rule's function is built first
    ; with no environment, the locals nested functions capture kept as its own: each call of
    ; it would make one that nothing else reads. Where that has no shape, as where it writes a
    ; nested function, which is given the environment, it is built again with one.
    (let shared (or (== (. ([] (. tables functions) id) kind) .lazy-rule) (== (. ([] (. tables functions) id) kind) .rule-adapter)))
    (let built (call walk id shared))
    (return-if built (if (or (not shared) (not is-refused))))
    (return (call walk id false))
  )
  (fn-do _ walk FunctionEmitter
    (param id FunctionId)
    (param unshared Bool)
    (param fusing Bool (= false))
    (param fused-read LayoutId (= no-layout))
    ; Builds a function's IR with a walker of its own, and notes whether it was refused.
    (probe-count emit.walks)
    (call (. lists empty))
    (let walker (call FunctionEmitter this unshared bridged fusing fused-read))
    (= refusal (call Refusal))
    (call (. walker emit-function) id
      (block
        (on-error Refused
          (= refusal (. walker refusal))
        )
      )
    )
    (return walker)
  )
)

(type _ WalkerLists
  ; The collections a walker fills as it builds a function. A worker's `Emitter` keeps one set,
  ; which every walker it builds takes as its own, and empties it as each walk begins, so that a
  ; walk allocates none of them and each keeps the room it grew to. A walker may point one of its
  ; own at another list, as a state machine's are; the set keeps the one it had.
  (blank)
  (prop + pins (list Pin))
  (prop + writes (list WriteEach))
  (prop + bound (list BoundValue))
  (prop + stream-captures (list StreamCapture))
  (prop + capture-levels (list CaptureLevel))
  (prop + borrows (list Borrow))
  (prop + collector-args (list String))
  (prop + lent (list LentCollector))
  (prop + first-calls (of Map U64 U32))
  (prop + found-firsts (list FoundFirst))
  (prop + no-ranges (list ItemRange))
  (prop + choice-arm-stack (list SyntaxId))
  (prop + choice-first-stack (list FirstItems))
  (prop + choice-range-stack (list ItemRange))
  (prop + first-resolving (list U64))
  (prop + choice-plans (of Map U64 U32))
  (prop + plan-firsts (list FirstItems))
  (prop + case-cursors (list CaseCursor))
  (prop + case-gathers (list CaseGather))
  (prop + proven-tables (list ProvenTable))
  (prop + proven-columns (list ProvenColumn))
  (prop + proven-reads (list ProvenRead))
  (prop + proven-items (list ProvenItem))
  (prop + match-steps (list MatchStep))
  (prop + made-rows (list MadeRow))
  (prop + lazy-open (list SlotId))
  (prop + lent-lazies (list LentLazy))
  (prop + ready-lazies (list ReadyLazy))
  (prop + shared-ready (list SharedReady))
  (prop + live-actions (list LiveTrackers))
  (prop + place-trackers (list LivePlace))
  (prop + attribute-trackers (list LiveMember))
  (prop + argument-trackers (list LiveMember))
  (prop + branch-trackers (list LocalId))
  (prop + made (list U32))
  (prop + pending (list Operand))
  (prop + joins (list Operand))
  (prop + given (list Typed))
  (prop + element-given (list Typed))
  (prop + element-filled (list U32))
  (prop + setter-given (list Typed))
  (prop + rule-givens (list RuleValue))
  (prop + rule-names (list RuleName))
  (prop + around-values (list AroundValue))
  (prop + taken-values (list TakenValues))
  (prop + recordings (list RecordedLocal))
  (prop + style-conditions (list StyleCondition))
  (prop + site-gates (list SiteGate))
  (prop + state-cells (list StateCell))
  (prop + content-hosts (list Typed))
  (prop + content-roots (list Operand))
  (prop + built (list SyntaxId))
  (prop + coded (list SyntaxId))
  (prop + inlining (list SyntaxId))
  (prop + adapted (list SyntaxId))
  (prop + open-turns (list TurnScope))
  (prop + rebindings (list Rebinding))
  (prop + loops (list EmittedLoop))
  (prop + open-cleanups (list OpenCleanup))
  (prop + stack-bindings (list StackBinding))
  (prop + use-flags (list LocalId))
  (prop + pads (list LandingPad))
  (prop + machine-items (list SyntaxId))
  (prop + machine-cases (list SyntaxId))
  (prop + machine-kept (list (list Atom)))
  (prop + machine-entering (list SyntaxId))
  (prop + machine-below (list MachineComposite))
  (prop + resumes (list IRBlockId))
  (prop + closings (list IRBlockId))
  (prop + stream-loops (list SyntaxId))
  (fn-do + empty _
    ; Empties each collection. A map is cleared only where it holds something, since clearing one
    ; allocates its buckets again.
    (call (. pins clear))
    (call (. writes clear))
    (call (. bound clear))
    (call (. stream-captures clear))
    (call (. capture-levels clear))
    (call (. borrows clear))
    (call (. collector-args clear))
    (call (. lent clear))
    (if (!= (. first-calls length) 0)
      (call (. first-calls clear))
    )
    (call (. found-firsts clear))
    (call (. no-ranges clear))
    (call (. choice-arm-stack clear))
    (call (. choice-first-stack clear))
    (call (. choice-range-stack clear))
    (call (. first-resolving clear))
    (if (!= (. choice-plans length) 0)
      (call (. choice-plans clear))
    )
    (call (. plan-firsts clear))
    (call (. case-cursors clear))
    (call (. case-gathers clear))
    (call (. proven-tables clear))
    (call (. proven-columns clear))
    (call (. proven-reads clear))
    (call (. proven-items clear))
    (call (. match-steps clear))
    (call (. made-rows clear))
    (call (. lazy-open clear))
    (call (. lent-lazies clear))
    (call (. ready-lazies clear))
    (call (. shared-ready clear))
    (call (. live-actions clear))
    (call (. place-trackers clear))
    (call (. attribute-trackers clear))
    (call (. argument-trackers clear))
    (call (. branch-trackers clear))
    (call (. made clear))
    (call (. pending clear))
    (call (. joins clear))
    (call (. given clear))
    (call (. element-given clear))
    (call (. element-filled clear))
    (call (. setter-given clear))
    (call (. rule-givens clear))
    (call (. rule-names clear))
    (call (. around-values clear))
    (call (. taken-values clear))
    (call (. recordings clear))
    (call (. style-conditions clear))
    (call (. site-gates clear))
    (call (. state-cells clear))
    (call (. content-hosts clear))
    (call (. content-roots clear))
    (call (. built clear))
    (call (. coded clear))
    (call (. inlining clear))
    (call (. adapted clear))
    (call (. open-turns clear))
    (call (. rebindings clear))
    (call (. loops clear))
    (call (. open-cleanups clear))
    (call (. stack-bindings clear))
    (call (. use-flags clear))
    (call (. pads clear))
    (call (. machine-items clear))
    (call (. machine-cases clear))
    (call (. machine-kept clear))
    (call (. machine-entering clear))
    (call (. machine-below clear))
    (call (. resumes clear))
    (call (. closings clear))
    (call (. stream-loops clear))
  )
)

(type _ FunctionEmitter
  ; Builds one function's IR from its syntax and the facts the type pass recorded for its instance, or
  ; from the program tables for a function with a generated body. It decides nothing: a construct it
  ; has no shape for is recorded as a refusal and ends the function. `unit` says whose code is
  ; emitted and where its locals are (`Unit`). A value emitted
  ; comes with its type (`Typed`), which every use checks against the type it needs, so a
  ; conversion nothing applied refuses the function. `held-chain` is the value written after the `?`
  ; of the statement being emitted, which runs only where an optional holds a value: such a value
  ; has no shape under any statement that does not name it here. `pins`
  ; are the expressions whose values were evaluated before the code that reads them: the receiver of a
  ; link of an optional chain, the value of an assignment made only where an optional holds one, the
  ; subject a pattern compares, the object a place is stored back into. `budget` is
  ; the cell that counts the passes of the function's loops down to their next poll, when the function
  ; polls, and `probe-countdown` the one that counts the polls down to their next look in on the
  ; probes, where they look. `loops` are the loops whose bodies are being emitted, innermost last, each with
  ; its item, which is a value. `open-cleanups` are the cleanups open, oldest first, each with how
  ; many were open where the block that opened it began, which `scoping` keeps for the block being
  ; emitted (`Scoping`). `use-head` is the block the entry goes on to in a function that has a `use`, emitted
  ; last, which clears
  ; `use-flags` and goes on to `use-body`. `cleanup-raised` is the cell of the flag that says a
  ; cleanup run on a way out no panic made has raised one, and `landings` counts the checks emitted,
  ; so that a cleanup with none is known. `line-shift` is how many lines below where it is written an
  ; instruction of the function is located, and `lowered` the feed whose own instructions are
  ; located one line further down. `placing` says an instruction whose source is in a module other
  ; than the function's is located in that module's file, as none is otherwise. `lazy-open` are the
  ; lazy locals whose values are being evaluated. `lent-lazies` are the lazy locals declared inside
  ; the value of one a function written in the one declaring them evaluates (`open-lent-lazies`).
  ; `shared-depth` counts the values of lazy locals that more than one read may evaluate
  ; where the type pass found a read that knows a local the value reads otherwise than the first: such
  ; a value is typed where it is first read, under what the flow knows there, so nothing in it that
  ; was settled by the flow has a shape, but what a test the value itself made settled
  ; (`is-inside-read`), which holds wherever the value is evaluated. `sharing` counts those a function written in the one that
  ; declares them is evaluating (`read-shared`). `ready-lazies` are the flags of the lazy locals kept
  ; behind one, and `shared-ready` the lazy locals nested functions capture, each with the block where
  ; an evaluation of it emitted in the function has ended (`evaluated-before`). `home-owner` is the instance `find-captured` found to declare the slot it was asked for, and
  ; `home-layout` the layout of the environment that holds it there. `in-zone` is whether the code
  ; being emitted runs where the collector never sees it: the body of a function marked so, until it
  ; raises. `zone-answer` says, of the value the last call that raises errors answered where that zone
  ; has to do with it, what its path does to the zone: 1 nothing, 2 enters it, 3 leaves it; an error
  ; comes back outside it. It is 0 where the zone has nothing to do with the call, and whoever takes
  ; the value apart clears it. `block-effects` is what the `do` blocks around the code being emitted
  ; keep it from (`effects-here`). `given-loop` is the loop of a comprehension, in the function
  ; generated for it: that function is given the loop's container where it is called, and yields the
  ; body of the loop for each item. `subscribing` is the `for` block of a loop on a stream, or a comprehension on
  ; one, in the function generated for it, which is given an item and the stream. `given-pipe` is a
  ; stream piped through a pattern, in the function generated for it, which is given the stream's
  ; value and yields what each match gives. `poll-landings` counts the checks of `landings` that a
  ; loop's poll made. `feeds` is the first feed of a list, in the function generated for it, which
  ; yields what each feed gives. `piped` is the pipe whose right side the function being emitted was
  ; generated for: it is given the item, or the value piped, after the environment it was written in.
  ; `piped-site` is where the type pass keeps what converts a list of feeds or a pipe that is piped
  ; forward into a call, until that call reads it. `open-turns` are the loops whose turn is being
  ; emitted and has an environment of its own, innermost last. `turn` and `turn-place` are those of
  ; the one `find-captured` found a slot in, when it is one of these. `rebindings` are the cells a
  ; machine's names were bound to anew while the expansion of an exit or an entry that binds them is
  ; emitted, innermost last, each with the local it held before.
  ; `through` is the place of the address of that slot in the capture of the
  ; body of a `do without gc` block, when the capture refers to it. `builds` says the function returns
  ; its receiver, and `initializes` that the function is a constructor run on an object another made.
  ; `filling` is the properties a constructor gives their first values (`Filling`), and `making` the
  ; tuple or struct whose fields are given theirs (`Making`), whose `made` says which fields have
  ; theirs, as `filled` does for properties. `live-actions` holds the
  ; trackers of the live actions open where code is emitted, innermost last, and
  ; `rerunning` says the statement a live action runs again is being emitted in the function that runs
  ; it. `place-trackers` are the properties whose values a constructor gave in a live action of their
  ; own, each with its trackers, made where the constructor begins for a value a read may give on some
  ; paths alone (`filling.trackers`); `attribute-trackers` the attributes of markup elements being made
  ; whose values were given so, and `argument-trackers` the same of their arguments given by position.
  ; `branch-trackers` are the trackers of each markup branch or loop region being made, kept until the
  ; element has taken it.
  ; `task-leaving` is where a return in the body of a spawned task goes, to end the task.
  ; `task-failing` is where each landing pad of a task body goes when the task has handlers, and
  ; `task-handlers` are those handlers; `handling-failure` holds while they are emitted.
  ; `styling` is what the style rules applied at a site keep (`Styling`), and `rule-givens` the values
  ; given to the style rules written on the element `valued` names, as evaluated. `rule-names` are the names a style rule
  ; applied where code is emitted takes its values by. `around-values` are the values the style rules
  ; written on markup elements gave, for the rules written in them to read, and `taken-values` those
  ; this function was given (`take-values`). `style-order` is the order the next declaration of a rule
  ; applied at a site takes. `style-conditions` are the conditions made at the site where code is
  ; emitted. `site-self`, `site-self-type`, `site-has-self` and `site-deferred` are the receiver where
  ; the markup element
  ; whose rules are applied is written, which a condition written on it reads. `site-gates` are the
  ; gates of the site. `state-cells` are the state
  ; cells of `scope-cells` made where code is emitted. `bridged` says the function is built as the
  ; bridge TypeScript makes for a member that runs on a row's case, and `row-columns` is the argument
  ; that member takes the row's columns in. `this-cursor` is the case of a row such a member's
  ; receiver stands for. `dispatch-row` is the row the function made for a member a union forwards
  ; takes, while its cases are called, of the type `dispatch-type`, and `dispatch-columns` the columns
  ; found where its storage was checked; no type where it takes none. `made-rows` are the rows `t[i]`
  ; made values. `matching` is the pattern being emitted (`Match`).
  (blank)
  (prop + ir IRFunction)
  (prop + refusal Refusal)
  (prop + bridged Bool)
  (prop _ unit _ (= (call Unit)))
  (prop _ row-columns U32 (= (. U32 max)))
  (prop _ this-cursor U32 (= (. U32 max)))
  (prop _ tables ProgramTables)
  (prop _ program Program)
  (prop _ instances Instances)
  (prop _ facts Facts)
  (prop _ types Types)
  (prop _ bindings Bindings)
  (prop _ function EmittedFunction)
  (prop _ held-chain SyntaxId (= 0))
  (prop _ pins (list Pin))
  (prop _ writes (list WriteEach))
  (prop _ matching _ (= (call Match)))
  (prop _ fail-jumps U32)
  (prop _ bound (list BoundValue))
  (prop _ stream-captures (list StreamCapture))
  (prop _ capture-levels (list CaptureLevel))
  (prop _ borrows (list Borrow))
  (prop _ collector-args (list String))
  (prop _ lent (list LentCollector))
  (prop _ lent-first U32 (= (. U32 max)))
  (prop _ first-calls (of Map U64 U32))
  (prop _ found-firsts (list FoundFirst))
  (prop _ no-ranges (list ItemRange))
  (prop _ choice-arm-stack (list SyntaxId))
  (prop _ choice-first-stack (list FirstItems))
  (prop _ choice-range-stack (list ItemRange))
  (prop _ first-resolving (list U64))
  (prop _ shared-first-heads (of Map U64 U32))
  (prop _ shared-firsts (list SharedFirst))
  (prop _ choice-plans (of Map U64 U32))
  (prop _ plan-firsts (list FirstItems))
  (prop _ streaming _ (= (call Streaming)))
  (prop _ case-cursors (list CaseCursor))
  (prop _ case-gathers (list CaseGather))
  (prop _ proven-tables (list ProvenTable))
  (prop _ proven-columns (list ProvenColumn))
  (prop _ proven-reads (list ProvenRead))
  (prop _ proven-items (list ProvenItem))
  (prop _ match-steps (list MatchStep))
  (prop _ made-rows (list MadeRow))
  (prop _ dispatch-row Operand)
  (prop _ dispatch-type TypeId (= no-type))
  (prop _ dispatch-columns Operand)
  (prop _ lazy-open (list SlotId))
  (prop _ lent-lazies (list LentLazy))
  (prop _ shared-depth U32)
  (prop _ stored-read SyntaxId (= 0))
  (prop _ sharing U32)
  (prop _ ready-lazies (list ReadyLazy))
  (prop _ shared-ready (list SharedReady))
  (prop _ line-shift U32)
  (prop _ placing Bool)
  (prop _ filling _ (= (call Filling)))
  (prop _ returns-type TypeId (= no-type))
  (prop _ result-type TypeId (= no-type))
  (prop _ value-layout LayoutId (= void-layout))
  (prop _ takes-result Bool)
  (prop _ calls-rule Bool)
  (prop _ rule-arguments Bool)
  (prop _ given-slots Bool)
  (prop _ carried-given TypeId (= no-type))
  (prop _ carried-result TypeId (= no-type))
  (prop _ calling-pattern Bool)
  (prop _ landing IRBlockId (= no-block))
  (prop _ in-landing Bool)
  (prop _ in-zone Bool)
  (prop _ zone-answer U8)
  (prop _ block-effects U32)
  (prop _ builds Bool)
  (prop _ initializes Bool)
  (prop _ live-actions (list LiveTrackers))
  (prop _ rerunning Bool)
  (prop _ place-trackers (list LivePlace))
  (prop _ attribute-trackers (list LiveMember))
  (prop _ argument-trackers (list LiveMember))
  (prop _ branch-trackers (list LocalId))
  (prop _ task-leaving IRBlockId (= no-block))
  (prop _ task-failing IRBlockId (= no-block))
  (prop _ task-handlers _ (= (call (of RowRange SyntaxId))))
  (prop _ checking U32)
  (prop _ making _ (= (call Making)))
  (prop _ made (list U32))
  (prop _ pending (list Operand))
  (prop _ joins (list Operand))
  (prop _ given (list Typed))
  (prop _ styling _ (= (call Styling)))
  (prop _ element-given (list Typed))
  (prop _ element-filled (list U32))
  (prop _ setter-given (list Typed))
  (prop _ rule-givens (list RuleValue))
  (prop _ rule-names (list RuleName))
  (prop _ around-values (list AroundValue))
  (prop _ taken-values (list TakenValues))
  (prop _ recordings (list RecordedLocal))
  (prop _ style-conditions (list StyleCondition))
  (prop _ site-gates (list SiteGate))
  (prop _ state-cells (list StateCell))
  (prop _ content-hosts (list Typed))
  (prop _ content-roots (list Operand))
  (prop _ built (list SyntaxId))
  (prop + type-values (list TypeId))
  (prop _ field-call FactId (= no-fact))
  (prop _ field-site SyntaxId (= 0))
  (prop _ print-fact FactId (= no-fact))
  (prop _ print-next Size (= 0))
  (prop _ storage Arena)
  (prop _ attempt-end LocalId (= no-local))
  (prop _ coded (list SyntaxId))
  (prop _ inlining (list SyntaxId))
  (prop _ adapted (list SyntaxId))
  (prop _ unshared Bool)
  (prop _ cold Bool)
  (prop _ made-environment LocalId (= no-local))
  (prop _ hops U32 (= no-hops))
  (prop _ turn LocalId (= no-local))
  (prop _ turn-place U32 (= no-place))
  (prop _ open-turns (list TurnScope))
  (prop _ rebindings (list Rebinding))
  (prop _ home-owner InstanceId (= no-instance))
  (prop _ home-layout LayoutId (= no-layout))
  (prop _ through U32 (= no-place))
  (prop _ in-callback Bool)
  (prop _ foreign-callback Bool)
  (prop _ budget LocalId (= no-local))
  (prop _ probe-countdown LocalId (= no-local))
  (prop _ loops (list EmittedLoop))
  (prop _ open-cleanups (list OpenCleanup))
  (prop _ stack-bindings (list StackBinding))
  (prop _ scoping _ (= (call Scoping)))
  (prop _ use-head IRBlockId (= no-block))
  (prop _ use-body IRBlockId (= no-block))
  (prop _ use-flags (list LocalId))
  (prop _ landings U32)
  (prop _ poll-landings U32)
  (prop _ pads (list LandingPad))
  (prop _ stepping Bool)
  (prop _ fusing Bool)
  (prop _ fused-read LayoutId (= no-layout))
  (prop _ yielding Bool)
  (prop _ given-loop SyntaxId (= 0))
  (prop _ subscribing SyntaxId (= 0))
  (prop _ machining Machining)
  (prop _ machine-entering (list SyntaxId))
  (prop _ given-pipe SyntaxId (= 0))
  (prop _ lowered SyntaxId (= 0))
  (prop _ feeds SyntaxId (= 0))
  (prop _ spreading SyntaxId (= 0))
  (prop _ built-list Operand)
  (prop _ built-item TypeId (= no-type))
  (prop _ built-append InstanceId (= no-instance))
  (prop _ built-reason ConversionReason (= (. ConversionReason reason-return)))
  (prop _ piped SyntaxId (= 0))
  (prop _ piped-site SyntaxId (= 0))
  (prop _ resumes (list IRBlockId))
  (prop _ closings (list IRBlockId))
  (prop _ stream-loops (list SyntaxId))
  (prop _ holding Operand)
  (prop _ protocol-row ValueId (= (. U32 max)))
  (fn-do + This _
    (param emitter Emitter)
    (param unshared Bool)
    (param bridged Bool)
    (param fusing Bool (= false))
    (param fused-read LayoutId (= no-layout))
    (lazy tables (. emitter tables))
    (lazy program (. emitter program))
    (lazy instances (. emitter instances))
    (lazy facts (. emitter facts))
    (lazy types (. emitter types))
    (lazy bindings (. emitter bindings))
    (lazy storage (. emitter storage))
    (lazy ir (. emitter ir))
    (lazy type-values (. emitter type-values))
    (lazy shared-first-heads (. emitter shared-first-heads))
    (lazy shared-firsts (. emitter shared-firsts))
    (lazy pins (. emitter lists pins))
    (lazy writes (. emitter lists writes))
    (lazy bound (. emitter lists bound))
    (lazy stream-captures (. emitter lists stream-captures))
    (lazy capture-levels (. emitter lists capture-levels))
    (lazy borrows (. emitter lists borrows))
    (lazy collector-args (. emitter lists collector-args))
    (lazy lent (. emitter lists lent))
    (lazy first-calls (. emitter lists first-calls))
    (lazy found-firsts (. emitter lists found-firsts))
    (lazy no-ranges (. emitter lists no-ranges))
    (lazy choice-arm-stack (. emitter lists choice-arm-stack))
    (lazy choice-first-stack (. emitter lists choice-first-stack))
    (lazy choice-range-stack (. emitter lists choice-range-stack))
    (lazy first-resolving (. emitter lists first-resolving))
    (lazy choice-plans (. emitter lists choice-plans))
    (lazy plan-firsts (. emitter lists plan-firsts))
    (lazy case-cursors (. emitter lists case-cursors))
    (lazy case-gathers (. emitter lists case-gathers))
    (lazy proven-tables (. emitter lists proven-tables))
    (lazy proven-columns (. emitter lists proven-columns))
    (lazy proven-reads (. emitter lists proven-reads))
    (lazy proven-items (. emitter lists proven-items))
    (lazy match-steps (. emitter lists match-steps))
    (lazy made-rows (. emitter lists made-rows))
    (lazy lazy-open (. emitter lists lazy-open))
    (lazy lent-lazies (. emitter lists lent-lazies))
    (lazy ready-lazies (. emitter lists ready-lazies))
    (lazy shared-ready (. emitter lists shared-ready))
    (lazy live-actions (. emitter lists live-actions))
    (lazy place-trackers (. emitter lists place-trackers))
    (lazy attribute-trackers (. emitter lists attribute-trackers))
    (lazy argument-trackers (. emitter lists argument-trackers))
    (lazy branch-trackers (. emitter lists branch-trackers))
    (lazy made (. emitter lists made))
    (lazy pending (. emitter lists pending))
    (lazy joins (. emitter lists joins))
    (lazy given (. emitter lists given))
    (lazy element-given (. emitter lists element-given))
    (lazy element-filled (. emitter lists element-filled))
    (lazy setter-given (. emitter lists setter-given))
    (lazy rule-givens (. emitter lists rule-givens))
    (lazy rule-names (. emitter lists rule-names))
    (lazy around-values (. emitter lists around-values))
    (lazy taken-values (. emitter lists taken-values))
    (lazy recordings (. emitter lists recordings))
    (lazy style-conditions (. emitter lists style-conditions))
    (lazy site-gates (. emitter lists site-gates))
    (lazy state-cells (. emitter lists state-cells))
    (lazy content-hosts (. emitter lists content-hosts))
    (lazy content-roots (. emitter lists content-roots))
    (lazy built (. emitter lists built))
    (lazy coded (. emitter lists coded))
    (lazy inlining (. emitter lists inlining))
    (lazy adapted (. emitter lists adapted))
    (lazy open-turns (. emitter lists open-turns))
    (lazy rebindings (. emitter lists rebindings))
    (lazy loops (. emitter lists loops))
    (lazy open-cleanups (. emitter lists open-cleanups))
    (lazy stack-bindings (. emitter lists stack-bindings))
    (lazy use-flags (. emitter lists use-flags))
    (lazy pads (. emitter lists pads))
    (lazy machine-entering (. emitter lists machine-entering))
    (lazy machining
      (call Machining
        (block
          (arg null)
          (arg null)
          (arg (. emitter lists machine-items))
          (arg (. emitter lists machine-cases))
          (arg (. emitter lists machine-kept))
          (arg null)
          (arg 0)
          (arg (. emitter lists machine-below))
        )
      )
    )
    (lazy resumes (. emitter lists resumes))
    (lazy closings (. emitter lists closings))
    (lazy stream-loops (. emitter lists stream-loops))
  )
  (fn-do _ emit-function _
    (param id FunctionId)
    (call (. ir reset) id)
    (= function ([] (. tables functions) id))
    (call read-instance (. function instance))
    (= unit (= (. unit source-module) (. function module)))
    (= returns-type (. types void-type))
    (= stepping (== (. function kind) .generator-body))
    (call bind-slots)
    (= (. ir signals) (or (. function may-panic) (. function carries) (. function polls)))
    (call (. ir start-block) (call (. ir reserve-block)))
    (if (. function polls)
      (call open-polls)
    )
    (call clear-lazies)
    (call open-uses)
    (if (and (. function unplaced) (or (. function may-panic) (call raises-errors)))
      (call refuse-own)
      (else-if (and (!= (. unit instance) no-instance) (call (. tables holds-unmade) (. unit instance)))
        (let written (. ([] (. instances rows) (. unit instance)) subtree))
        (call refuse .refused-function (if-expr (!= (. written count) 0) (- (+ (. written start) (. written count)) 1) 0))
      )
      (else-if (== (. function kind) .module-main)
        (call open-environment 0)
        (call make-subscribers 0)
        (call emit-statements)
        (call end-main)
        (call close-cleanups 0)
        (call return-nothing)
      )
      (else-if (and (== (. function kind) .instance-body) (call (. tables is-region) (. unit instance)))
        (call emit-region-body)
      )
      (else-if (and (== (. function kind) .instance-body) (!= ([] (. tables body-functions) (. unit instance)) no-function))
        (if (== (. ([] (. tables functions) ([] (. tables body-functions) (. unit instance))) kind) .constructor-body)
          (call emit-filling)
          (else
            (call emit-view)
          )
        )
      )
      (else-if (or instance-or-init (== (. function kind) .viewed-body) (== (. function kind) .constructor-body))
        (call emit-body)
      )
      (else-if (== (. function kind) .generator-body)
        (call emit-body)
        (call check-steps)
      )
      (else-if (== (. function kind) .lazy-property)
        (call emit-lazy)
      )
      (else-if (== (. function kind) .property-updater)
        (call emit-updater)
      )
      (else-if (== (. function kind) .class-rule-updater)
        (call emit-class-rule-updater)
      )
      (else-if (== (. function kind) .style-gate)
        (call emit-style-gate)
      )
      (else-if (== (. function kind) .style-scope-state)
        (call emit-scope-cell)
      )
      (else-if (== (. function kind) .slot-forward)
        (call emit-slot-forward)
      )
      (else-if (== (. function kind) .style-author)
        (call emit-style-author)
      )
      (else-if (== (. function kind) .style-given-author)
        (call emit-given-author)
      )
      (else-if (== (. function kind) .style-rule)
        (call emit-style-rule)
      )
      (else-if (== (. function kind) .style-static-value)
        (call emit-static-value)
      )
      (else-if (== (. function kind) .style-themed-value)
        (call emit-themed-value)
      )
      (else-if (== (. function kind) .markup-query)
        (call emit-ancestor-query)
      )
      (else-if (or (== (. function kind) .markup-query-add) (== (. function kind) .markup-query-remove))
        (call emit-descendant-query (== (. function kind) .markup-query-remove))
      )
      (else-if (or (== (. function kind) .markup-trigger-add) (== (. function kind) .markup-trigger-remove))
        (call emit-trigger-change (== (. function kind) .markup-trigger-remove))
      )
      (else-if (== (. function kind) .markup-trigger-ancestor)
        (call emit-trigger-ancestor)
      )
      (else-if (== (. function kind) .live-adapter)
        (call emit-live-adapter)
      )
      (else-if (== (. function kind) .idle-action)
        (call emit-idle-action)
      )
      (else-if (== (. function kind) .module-constants)
        (call emit-globals .global-constant)
      )
      (else-if (== (. function kind) .module-globals)
        (call emit-globals .global-eager)
      )
      (else-if (== (. function kind) .lazy-global)
        (call emit-lazy-global)
      )
      (else-if (or (== (. function kind) .task-local-init) (== (. function kind) .thread-local-init) stack-init)
        (call emit-local-global)
      )
      (else-if (== (. function kind) .task-body)
        (call emit-task-body)
      )
      (else-if (== (. function kind) .module-statics)
        (call emit-statics)
      )
      (else-if (== (. function kind) .argument-default)
        (call emit-argument-default)
      )
      (else-if (== (. function kind) .stream-action)
        (call emit-stream-action)
      )
      (else-if (== (. function kind) .machine-handler)
        (call emit-machine-handler)
      )
      (else-if (== (. function kind) .machine-cast)
        (call emit-machine-cast)
      )
      (else-if (== (. function kind) .machine-activation)
        (call emit-machine-activation)
      )
      (else-if (== (. function kind) .machine-descriptor)
        (call emit-machine-descriptor)
      )
      (else-if (== (. function kind) .machine-deferral)
        (call emit-machine-deferral)
      )
      (else-if (== (. function kind) .machine-part)
        (call emit-machine-part)
      )
      (else-if (== (. function kind) .machine-stop)
        (call emit-machine-stop)
      )
      (else-if (== (. function kind) .pattern-helper)
        (call emit-pattern-helper)
      )
      (else-if (== (. function kind) .pattern-cast)
        (call emit-pattern-cast)
      )
      (else-if (== (. function kind) .lazy-rule)
        (call emit-lazy-rule (. function place))
      )
      (else-if (== (. function kind) .rule-adapter)
        (call emit-rule-adapter (. function place))
      )
      (else-if (== (. function kind) .mapped-rule)
        (call emit-mapped-rule)
      )
      (else-if (== (. function kind) .raising-rule)
        (call emit-raising-rule)
      )
      (else-if (== (. function kind) .adapter)
        (call emit-adapter)
      )
      (else-if (== (. function kind) .witness)
        (call emit-witness)
      )
      (else-if (== (. function kind) .class-adapter)
        (call emit-class-adapter)
      )
      (else-if (== (. function kind) .union-dispatch)
