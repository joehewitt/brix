  (fn-do _ carries Bool
    (param function TypeId)
    ; Whether a function type carries errors: it declares some, or what it returns is already
    ; a value or an error.
    (match? ([] (. types rows) function)
      (case (call .type-function row)
        (if (!= (. row errors count) 0)
          (return true)
        )
        (if (== (. row return-type) no-type)
          (return false)
        )
        (match? ([] (. types rows) (. row return-type))
          (case .type-result
            (return true)
          )
        )
      )
    )
    (return false)
  )
  (fn-do _ value-returned TypeId
    (param returns TypeId)
    ; The value a function type returns: what it returns, the value of that where it is
    ; already a value or an error, or nothing.
    (if (== returns no-type)
      (return (. types void-type))
    )
    (match? ([] (. types rows) returns)
      (case (call .type-result held)
        (return (. held value))
      )
    )
    (return returns)
  )
  (fn-do _ recorded FactId
    (param callee InstanceId)
    (param place SyntaxId)
    (param reason ConversionReason)
    (param from TypeId)
    (param to TypeId)
    ; The conversion the type pass recorded for a function at a place, for a value that a
    ; function made with no syntax of its own takes from it. No fact where it recorded none.
    ; One recorded before the function's own nodes were typed is kept apart from them.
    (let fact (call (. facts first-conversion) callee place))
    (while (!= fact no-fact)
      (let row ([] (. facts conversions) fact))
      (if (and (== (. row reason) reason) (== (. row from) from) (== (. row to) to))
        (return fact)
      )
      (= fact (. row next))
    )
    (let apart (call (. tables loose-conversion) callee place from reason))
    (if (and (!= apart no-fact) (== (. ([] (. facts conversions) apart) to) to))
      (return apart)
    )
    (return no-fact)
  )
  (fn-do _ make-function Typed
    (param site SyntaxId)
    (param row ConversionFact)
    (param value Operand)
    ; A closure, a binding or a value of another function type made a value of a function
    ; type: memory in the frame that holds the code the value runs and the data that code is
    ; given first. The code is the function made for the two types. A closure, which is its
    ; environment, is the data. A binding's is a copy of the binding that the collector owns,
    ; or nothing where the binding holds nothing, and a value's is such a copy of the value.
    (let nothing (call make-operand .operand-void 0))
    (let layout (call layout-of (. row to) site))
    (let bare (and (call is-c-function types (. row to)) (call is-binding (. row from))))
    (if (and (!= layout (. tables layouts function-layout)) (not bare))
      (call refuse .refused-conversion site)
      (return (call Typed nothing no-type))
    )
    (let code (call (. tables adapter-of) (. row from) (. row to)))
    (let data value)
    (if (or (call is-binding (. row from)) (. row casts))
      (let held (call layout-of (. row from) site))
      (= data (call integer .machine-managed-pointer 0))
      (if (and bare (!= held void-layout))
        (= code no-function)
      )
      (if (and (!= held void-layout) (!= code no-function))
        (let shape ([] (. tables layouts rows) held))
        (let mark (. pending length))
        (+= pending (call integer .machine-u64 (. shape size)))
        (if (. shape is-managed)
          (+= pending (call make-operand .operand-descriptor held))
          (else
            (+= pending (call integer .machine-pointer 0))
          )
        )
        (= data (call call-runtime .runtime-allocate-object site mark managed-layout))
        (call copy data value held (. shape is-managed) site)
      )
      (else-if (not (call is-closure (. row from)))
        (= code no-function)
      )
    )
    (if (== code no-function)
      (call refuse .refused-conversion site)
      (return (call Typed nothing no-type))
    )
    (let target ([] (. tables functions) code))
    (call (. ir depend) .callee-function code 0)
    (if bare
      (return (call Typed (call make-operand .operand-symbol (. target symbol)) (. row to)))
    )
    (let made (call frame layout))
    (call store made 0 (call make-operand .operand-symbol (. target symbol)) false site)
    (call store made (. (call (. tables layouts field) layout 1) offset) data false site)
    (return (call Typed made (. row to)))
  )
  (fn-do _ emit-adapter _
    ; The function a closure or a binding runs as a value of a function type. Its first argument is
    ; the data the value holds and the rest are the type's arguments. A closure's data is its
    ; environment, which its body is given first. A binding's is a copy of the binding, and what the
    ; type pass found the binding to call is called on the value the binding calls on, where it
    ; holds one, an object of the class the function is typed for or one derived from it, with the
    ; arguments it holds and then the adapter's own; a binding of a nested function holds the
    ; function, which its body is given first, and a binding of a class's name runs the constructor
    ; written for the class, as the type pass says the binding calls it. An argument a binding holds
    ; is given as it is, and one of the adapter's own and the answer are converted as the type pass
    ; recorded for the function called. The call is made where the value was first made, the place
    ; a stack trace names, or the line below it where the type pass noted that for a closure; for
    ; one made in several places a stack trace names no place.
