(import ./layouts)
(import /core/arena)
(import /core/map)
(import /core/table)
(import /lang/backend/mir)
(import /lang/check/table-rows)
(import /lang/check/type-store)
(import /lang/check/type-text)
(import /lang/check/types)
(blank)
(prop + inline-budget U32 (= 16))

(type + TableRegion (is U8)
  ; Where a table of union rows keeps a field of a case: in the column of a field every case
  ; shares, among the row's inline bytes, or among the bytes outside the row its handle leads to.
  (blank)
  (variant region-common (= 0))
  (variant region-inline (= 1))
  (variant region-external (= 2))
)

(type + UnionField (is Struct)
  ; Where a table of union rows keeps a field of a case: `slot` is its place in the case's own
  ; layout, `offset` where it lies in its region, and `column` the column of a shared field.
  (blank)
  (prop + slot U32)
  (prop + region TableRegion)
  (prop + offset U32)
  (prop + column U32)
  (prop + is-hot Bool)
)

(type + UnionCase (is Struct)
  ; A case of a union a table's rows hold: its fields in the order the case declares them, and
  ; the bytes of its own fields kept inline and outside the row.
  (blank)
  (prop + type TypeId)
  (prop + fields Span)
  (prop + inline-size U32)
  (prop + inline-alignment U32)
  (prop + external-size U32)
  (prop + external-alignment U32)
)

(type + UnionLayout (is Struct)
  ; How a table keeps rows of a union, as TypeScript lays it out: the tag in column 0, then a
  ; column for each field every case shares, the inline bytes of each row, and the handle of
  ; the bytes each row keeps outside it, in a buffer the directory's last slot holds. `columns`
  ; is how many slots the directory has; `commons` are the shared fields of the first case.
  (blank)
  (prop + union TypeId)
  (prop + controlled Bool)
  (prop + commons Span)
  (prop + cases Span)
  (prop + inline-column U32 (= (. U32 max)))
  (prop + inline-stride U32)
  (prop + inline-alignment U32 (= 1))
  (prop + handle-column U32 (= (. U32 max)))
  (prop + external-column U32 (= (. U32 max)))
  (prop + external-stride U32)
  (prop + external-alignment U32 (= 1))
  (prop + columns U32 (= 1))
)

(type + UnionTables
  ; The layout of each union the rows of a table hold, built once before emission and read by
  ; every worker, with the text each gives for `.layout`: `fixed-texts` for a table that does
  ; not grow, and `growing-texts` for one that grows in an arena.
  (blank)
  (prop + layouts (of Table UnionLayout))
  (prop + cases (of Table UnionCase))
  (prop + fields (of Table UnionField))
  (prop + fixed-texts (list String))
  (prop + growing-texts (list String))
  (blank)
  (prop _ rows (of Map Size U32 ArenaBacking))
  (prop _ types Types)
  (prop _ values Layouts)
  (prop _ sizes (list U32))
  (prop _ alignments (list U32))
  (prop _ taken (list Bool))
  (prop _ best (list U32))
  (prop _ found Bool)
  (prop _ best-size U32)
  (prop _ best-count U32)
  (prop _ budget U32)
  (prop _ prefix-sizes (list U32))
  (prop _ prefix-alignments (list U32))
  (fn-do + This _
    (param types Types)
    (param values Layouts)
    (param arena Arena)
    (lazy layouts (call (of Table UnionLayout) arena 4))
    (lazy cases (call (of Table UnionCase) arena 4))
    (lazy fields (call (of Table UnionField) arena 16))
    (lazy rows (call (of Map Size U32) arena))
  )
  (fn-expr + of U32
    (param union TypeId)
    ; The place of a union's layout among `layouts`, or `U32.max` where no table holds it.
    (?? ([] rows union) (. U32 max))
  )
  (fn-do + build _
    ; Lays out each union a table, a row, a span or a selection holds rows of.
    (for (in id (. types ranked))
      (let row (call row-union types (as id TypeId)))
      (if (and (!= row no-type) (== ([] rows row) null))
        (call lay-out row)
      )
    )
  )
  (fn-expr _ is-done Bool
    (param type TypeId)
    ; Whether a type was completed before the store was sealed, which emission may read.
    (call completed types type)
  )
  (fn-do _ lay-out _
    (param union TypeId)
    ; Lays out a union's rows as TypeScript's `createTableUnionLayout` does. A union one of whose
    ; cases has no layout yet is left out, and a table of it has no shape.
    (let held (call (. types cases-of) union))
    (if (== (. held length) 0)
      (return)
    )
    (for (in fact held)
      (if (or (. fact is-default) (not (call is-done (. fact type))))
        (return)
      )
      (let layout ([] (. values values) (. fact type)))
      (if (or (== layout no-layout) (not (call (. values is-struct) layout)))
        (return)
      )
    )
    (let first (. ([] held 0) type))
    (let commons-start (as (. fields length) U32))
    (for (in property (call (. types properties-of) first))
      (if (and (== (. property storage-kind) .storage-eager) (call is-common-field types union property))
        (let column (+ (- (as (. fields length) U32) commons-start) 1))
        (call (. fields append) (call UnionField (. property slot) .region-common 0 column false))
      )
    )
    (let commons (call Span commons-start (- (as (. fields length) U32) commons-start)))
    (let controlled false)
    (for (in fact held)
      (for (in property (call (. types properties-of) (. fact type)))
        (if (and (call own-field union property) (call is-hot-field types property))
          (= controlled true)
        )
      )
    )
    (let stride inline-budget)
    (if controlled
      (let hot-size U32)
      (let hot-alignment U32 1)
      (for (in fact held)
        (call clear-fields)
        (for (in property (call (. types properties-of) (. fact type)))
          (if (and (call own-field union property) (call is-hot-field types property))
            (call add-field (. fact type) property)
          )
        )
        (let hot (call region sizes alignments))
        (= hot-size (call larger hot-size (. hot size)))
        (= hot-alignment (call larger hot-alignment (. hot alignment)))
      )
      (= stride (call align-to (call larger inline-budget hot-size) hot-alignment))
    )
    (let cases-start (as (. cases length) U32))
    (let any-inline false)
    (let inline-alignment U32 1)
    (let external-stride U32)
    (let external-alignment U32 1)
    (let widest U32)
    (for (in fact held)
      (let laid (call lay-out-case union (. fact type) controlled stride commons))
      (= any-inline (or any-inline (> (. laid inline-size) 0)))
      (= widest (call larger widest (. laid inline-size)))
      (= inline-alignment (call larger inline-alignment (. laid inline-alignment)))
      (= external-stride (call larger external-stride (. laid external-size)))
      (= external-alignment (call larger external-alignment (. laid external-alignment)))
      (call (. cases append) laid)
    )
    (= external-stride (call align-to external-stride external-alignment))
    (let made
      (call UnionLayout
        (block
          (arg union)
          (arg controlled)
          (arg commons)
          (arg (call Span cases-start (- (as (. cases length) U32) cases-start)))
        )
      )
    )
    (= (. made inline-alignment) inline-alignment)
    (= (. made external-alignment) external-alignment)
    (let next (+ (. commons count) 1))
    (if any-inline
      (= (. made inline-column) next)
      (= (. made inline-stride) (call smaller stride (call align-to widest inline-alignment)))
      (+= next 1)
    )
    (if (!= external-stride 0)
      (= (. made handle-column) next)
      (= (. made external-stride) external-stride)
      (+= next 1)
      (= (. made external-column) next)
      (+= next 1)
    )
    (= (. made columns) next)
    (= ([] rows union) (as (. layouts length) U32))
    (call (. layouts append) made)
    (+= fixed-texts (call fixed-text made))
    (+= growing-texts (call growing-text made))
  )
  (fn-expr _ own-field Bool
    (param union TypeId)
    (param property TypeProperty)
    ; Whether a case keeps a field of its own, which the table packs: one stored, which not every
    ; case shares.
    (and (== (. property storage-kind) .storage-eager) (not (call is-common-field types union property)))
  )
  (fn-do _ lay-out-case UnionCase
    (param union TypeId)
    (param type TypeId)
    (param controlled Bool)
    (param stride U32)
    (param commons Span)
    ; Lays out a case's own fields: the shared ones in their columns, and the rest packed, the hot
    ; ones first where any field is hot. The others pack in the order the case declares them, or
    ; from the widest alignment down where that leaves fewer bytes or fields outside.
    (let own (list TypeProperty))
    (let sorted (list TypeProperty))
    (let hot (list TypeProperty))
    (for (in property (call (. types properties-of) type))
      (if (call own-field union property)
        (if (and controlled (call is-hot-field types property))
          (+= hot property)
          (else
            (+= own property)
            (call (. sorted insert) property (call placed type sorted property))
          )
        )
      )
    )
    (call (. prefix-sizes clear))
    (call (. prefix-alignments clear))
    (for (in property hot)
      (let field (call (. values field) ([] (. values values) type) (. property slot)))
      (+= prefix-sizes (. ([] (. values rows) (. field layout)) size))
      (+= prefix-alignments (. ([] (. values rows) (. field layout)) alignment))
    )
    (call pack-fields type own stride)
    (let declared-size best-size)
    (let declared-count best-count)
    (call pack-fields type sorted stride)
    (if (or (< best-size declared-size) (and (== best-size declared-size) (< best-count declared-count)))
      (= own sorted)
      (else
        (call pack-fields type own stride)
      )
    )
    (let inline-sizes (list U32))
    (let inline-alignments (list U32))
    (let external-sizes (list U32))
    (let external-alignments (list U32))
    (for (in position (..< 0 (. prefix-sizes length)))
      (+= inline-sizes ([] prefix-sizes position))
      (+= inline-alignments ([] prefix-alignments position))
    )
    (let chosen 0)
    (for (in position (..< 0 (. own length)))
      (if (and (< chosen (. best length)) (== ([] best chosen) (as position U32)))
        (+= inline-sizes ([] sizes position))
        (+= inline-alignments ([] alignments position))
        (+= chosen 1)
        (else
          (+= external-sizes ([] sizes position))
          (+= external-alignments ([] alignments position))
        )
      )
    )
    (let inline (call region inline-sizes inline-alignments))
    (let external (call region external-sizes external-alignments))
    (let start (as (. fields length) U32))
    (for (in property (call (. types properties-of) type))
      (if (!= (. property storage-kind) .storage-eager)
        (continue)
      )
      (if (not (call own-field union property))
        (let column (call common-column union commons property))
        (call (. fields append) (call UnionField (. property slot) .region-common 0 column false))
        (continue)
      )
      (let hot-at (call hot-place hot property))
      (if (!= hot-at (. U32 max))
        (call (. fields append) (call UnionField (. property slot) .region-inline ([] (. inline offsets) hot-at) 0 true))
        (continue)
      )
      (let position (call own-place own property))
      (let is-hot (and controlled (call is-hot-field types property)))
      (if (call best-has position)
        (let offset ([] (. inline offsets) (+ (. prefix-sizes length) (call inline-rank position))))
        (call (. fields append) (call UnionField (. property slot) .region-inline offset 0 is-hot))
        (else
          (call (. fields append)
            (block
              (arg
                (call UnionField
                  (block
                    (arg (. property slot))
                    (arg .region-external)
                    (arg ([] (. external offsets) (- position (call inline-rank position))))
                    (arg 0)
                    (arg is-hot)
                  )
                )
              )
            )
          )
        )
      )
    )
    (return
      (call UnionCase
        (block
          (arg type)
          (arg (call Span start (- (as (. fields length) U32) start)))
          (arg (. inline size))
          (arg (. inline alignment))
          (arg (. external size))
          (arg (. external alignment))
        )
      )
    )
  )
  (fn-do _ common-column U32
    (param union TypeId)
    (param commons Span)
    (param property TypeProperty)
    ; The column of a shared field: that of the first case's field of the same name.
    (let first (. ([] (call (. types cases-of) union) 0) type))
    (for (in position (..< 0 (. commons count)))
      (let common ([] fields (+ (. commons start) position)))
      (for (in candidate (call (. types properties-of) first))
        (if (and (== (. candidate slot) (. common slot)) (== (. candidate name) (. property name)))
          (return (. common column))
        )
      )
    )
    (return 0)
  )
  (fn-do _ pack-fields _
    (param type TypeId)
    (param own (list TypeProperty))
    (param stride U32)
    ; Packs a case's own fields in the order given.
    (call clear-fields)
    (for (in property own)
      (call add-field type property)
    )
    (call pack stride)
  )
  (fn-do _ placed Index
    (param type TypeId)
    (param own (list TypeProperty))
    (param property TypeProperty)
    ; Where a field goes among a case's own fields sorted from the widest alignment down, after
    ; those as wide.
    (let aligned (call alignment-of type property))
    (for (in position (..< 0 (. own length)))
      (if (< (call alignment-of type ([] own position)) aligned)
        (return position)
      )
    )
    (return (. own length))
  )
  (fn-expr _ alignment-of U32
    (param type TypeId)
    (param property TypeProperty)
    (. ([] (. values rows) (. (call (. values field) ([] (. values values) type) (. property slot)) layout)) alignment)
  )
  (fn-expr _ hot-place U32
    (param hot (list TypeProperty))
    (param property TypeProperty)
    ; The place of a hot field among a case's hot fields, or `U32.max`.
    (call place-of hot property)
  )
  (fn-expr _ own-place U32
    (param own (list TypeProperty))
    (param property TypeProperty)
    (call place-of own property)
  )
  (fn-do _ place-of U32
    (param list (list TypeProperty))
    (param property TypeProperty)
    (for (in position (..< 0 (. list length)))
      (if (and (== (. ([] list position) slot) (. property slot)) (== (. ([] list position) name) (. property name)))
        (return (as position U32))
      )
    )
    (return (. U32 max))
  )
  (fn-do _ best-has Bool
    (param position U32)
    (for (in each best)
      (if (== each position)
        (return true)
      )
    )
    (return false)
  )
  (fn-do _ inline-rank U32
    (param position U32)
    ; How many of the fields packed inline come before a field.
    (let rank U32)
    (for (in each best)
      (if (< each position)
        (+= rank 1)
      )
    )
    (return rank)
  )
  (fn-do _ clear-fields _
    (call (. sizes clear))
    (call (. alignments clear))
  )
  (fn-do _ add-field _
    (param type TypeId)
    (param property TypeProperty)
    (let field (call (. values field) ([] (. values values) type) (. property slot)))
    (+= sizes (. ([] (. values rows) (. field layout)) size))
    (+= alignments (. ([] (. values rows) (. field layout)) alignment))
  )
  (fn-do _ pack _
    (param stride U32)
    ; Chooses the fields kept inline within a budget, as TypeScript's `tableUnionPackCase` does:
    ; every set is tried, each field left out before it is taken in; a set is kept where it fits
    ; and the budget is a multiple of its alignment, and the one kept leaves the fewest bytes
    ; outside, then the fewest fields, then has the earliest fields first. A set whose first fields
    ; already leave more outside than the one kept is not tried further, as no set it grows into is
    ; kept.
    (= budget stride)
    (= found false)
    (call (. best clear))
    (call (. taken clear))
    (for (in position (..< 0 (. sizes length)))
      (+= taken false)
    )
    (let offset U32)
    (let alignment U32 1)
    (for (in position (..< 0 (. prefix-sizes length)))
      (= alignment (call larger alignment ([] prefix-alignments position)))
      (= offset (+ (call align-to offset ([] prefix-alignments position)) ([] prefix-sizes position)))
    )
    (call choose 0 offset alignment 0 1 0)
  )
  (fn-do _ choose _
    (param index U32)
    (param offset U32)
    (param alignment U32)
    (param outside U32)
    (param outside-alignment U32)
    (param count U32)
    ; Tries the sets that take in or leave out each field from `index` on, with the fields before
    ; laid out inline to `offset` and outside to `outside`, `count` of them.
    (if (> (call align-to offset alignment) budget)
      (return)
    )
    (if (and found (or (> outside best-size) (and (== outside best-size) (> count best-count))))
      (return)
    )
    (if (< index (as (. sizes length) U32))
      (let size ([] sizes index))
      (let aligned ([] alignments index))
      (call choose
        (block
          (arg (+ index 1))
          (arg offset)
          (arg alignment)
          (arg (+ (call align-to outside aligned) size))
          (arg (call larger outside-alignment aligned))
          (arg (+ count 1))
        )
      )
      (= ([] taken index) true)
      (call choose
        (block
          (arg (+ index 1))
          (arg (+ (call align-to offset aligned) size))
          (arg (call larger alignment aligned))
          (arg outside)
          (arg outside-alignment)
          (arg count)
        )
      )
      (= ([] taken index) false)
      (return)
    )
    (if (!= (% budget alignment) 0)
      (return)
    )
    (let external (call align-to outside outside-alignment))
    (if found
      (if (> external best-size)
        (return)
      )
      (if (== external best-size)
        (if (> count best-count)
          (return)
        )
        (if (and (== count best-count) (not (call comes-first)))
          (return)
        )
      )
    )
    (= found true)
    (= best-size external)
    (= best-count count)
    (call (. best clear))
    (for (in position (..< 0 (. sizes length)))
      (if ([] taken position)
        (+= best (as position U32))
      )
    )
  )
  (fn-do _ comes-first Bool
    ; Whether the fields taken in come before the best set so far, by the first field they differ in.
    (let position 0)
    (for (in index (..< 0 (. sizes length)))
      (if ([] taken index)
        (if (>= position (. best length))
          (return false)
        )
        (if (!= (as index U32) ([] best position))
          (return (< (as index U32) ([] best position)))
        )
        (+= position 1)
      )
    )
    (return false)
  )
  (fn-do _ region Region
    (param sizes (list U32))
    (param alignments (list U32))
    ; Lays out fields in turn, as TypeScript's `tableUnionRegionLayout` does.
    (let offsets (list U32))
    (let offset U32)
    (let alignment U32 1)
    (for (in position (..< 0 (. sizes length)))
      (= alignment (call larger alignment ([] alignments position)))
      (= offset (call align-to offset ([] alignments position)))
      (+= offsets offset)
      (+= offset ([] sizes position))
    )
    (return (call Region offsets (call align-to offset alignment) alignment))
  )
  (fn-do _ fixed-text String
    (param made UnionLayout)
    ; The text `.layout` gives for a table of the union that does not grow.
    (let lines (list (str "Table'" (call type-runtime-name types (. made union))) (call packing-text made) "tag column[0] U8"))
    (for (in position (..< 0 (. made commons count)))
      (let common ([] fields (+ (. made commons start) position)))
      (let field (call (. values field) ([] (. values values) (. ([] (call (. types cases-of) (. made union)) 0) type)) (. common slot)))
      (let name (call slot-name (. ([] (call (. types cases-of) (. made union)) 0) type) (. common slot)))
      (+= lines (str "common column[" (. common column) "] " name " " (call type-runtime-name types (. field type))))
    )
    (if (!= (. made inline-column) (. U32 max))
      (+= lines (str "inline column[" column "] stride=" (. made inline-stride) " align=" (. made inline-alignment)))
      (lazy column (. made inline-column))
    )
    (if (!= (. made handle-column) (. U32 max))
      (+= lines (str "spill-handles column[" (. made handle-column) "] U32 offset+1"))
      (+= lines (str "external arena stride=" (. made external-stride) " align=" (. made external-alignment)))
    )
    (call case-lines made lines)
    (return (call (. "\n" join) lines))
  )
  (fn-do _ growing-text String
    (param made UnionLayout)
    ; The text `.layout` gives for a table of the union that grows in an arena.
    (let lines
      (call List
        (block
          (item (str "Table'" (call type-runtime-name types (. made union))))
          (item "storage arena-growable")
          (item "row-layout union")
          (item (call packing-text made))
          (item "growth shared geometric")
          (item "region column[0] tag width=1 align=1")
        )
      )
    )
    (let first (. ([] (call (. types cases-of) (. made union)) 0) type))
    (for (in position (..< 0 (. made commons count)))
      (let common ([] fields (+ (. made commons start) position)))
      (let field (call (. values field) ([] (. values values) first) (. common slot)))
      (let row ([] (. values rows) (. field layout)))
      (+= lines (str "region column[" (. common column) "] common " name " width=" (. row size) " align=" (. row alignment)))
      (lazy name (call slot-name first (. common slot)))
    )
    (if (!= (. made inline-column) (. U32 max))
      (+= lines (str "region column[" (. made inline-column) "] inline width=" width " align=" inline-align))
      (lazy width (. made inline-stride))
      (lazy inline-align (. made inline-alignment))
    )
    (if (!= (. made handle-column) (. U32 max))
      (+= lines (str "region column[" (. made handle-column) "] spill-handles width=4 align=4"))
      (+= lines (str "compact external column[" column "] offset+1 U32 limit=4294967295 align=" external-align))
      (lazy column (. made external-column))
      (lazy external-align (. made external-alignment))
    )
    (call case-lines made lines)
    (return (call (. "\n" join) lines))
  )
  (fn-expr _ packing-text String
    (param made UnionLayout)
    (if-expr (. made controlled) "packing controlled @hot" (str "packing automatic budget=" inline-budget))
  )
  (fn-do _ case-lines _
    (param made UnionLayout)
    (param lines (list String))
    (for (in position (..< 0 (. made cases count)))
      (let held ([] cases (+ (. made cases start) position)))
      (let fact ([] (call (. types cases-of) (. made union)) position))
      (let name (if-expr (. fact name) (. (!! (. fact name)) text) ""))
      (+= lines (str "case " position " " name " " (call type-runtime-name types (. held type))))
      (for (in offset (..< 0 (. held fields count)))
        (let field ([] fields (+ (. held fields start) offset)))
        (let place (call (. values field) ([] (. values values) (. held type)) (. field slot)))
        (let located (call place-text field))
        (let hot
          (scope (if-expr (and (. made controlled) outside-common (. field is-hot)) " @hot" "")
            (lazy outside-common (!= (. field region) .region-common))
          )
        )
        (+= lines (str "  " field-name " " (call type-runtime-name types (. place type)) " " located hot))
        (lazy field-name (call slot-name (. held type) (. field slot)))
      )
    )
  )
  (fn-expr _ place-text String
    (param field UnionField)
    (case? (== (. field region) .region-common)
      (str "common[" (. field column) "]")
    )
    (case? (== (. field region) .region-inline)
      (str "inline+" (. field offset))
    )
    (default
      (str "external+" (. field offset))
    )
  )
  (fn-do _ slot-name String
    (param type TypeId)
    (param slot U32)
    ; The name of the field at a place of a tuple's layout.
    (for (in property (call (. types properties-of) type))
      (if (and (== (. property storage-kind) .storage-eager) (== (. property slot) slot))
        (return (. property name text))
      )
    )
    (return (str "field " slot))
  )
)

(fn-expr + row-union TypeId
  (param types Types)
  (param type TypeId)
  ; The union a table, a row, a span or a selection holds rows of, or no type where it holds none.
  (case? (not (call completed types type))
    no-type
  )
  (case? (and (!= kind .table) (!= kind .immutable-table) not-row (not spans))
    no-type
  )
  (case? (or (not (call completed types row)) (!= (. ([] (. types completions) row) intrinsic) .union))
    no-type
  )
  (default
    row
  )
  (where
    (lazy kind (. ([] (. types completions) type) intrinsic))
    (lazy not-row (and (!= kind .table-row) (!= kind .immutable-table-row)))
    (lazy spans (or (== kind .table-span) (== kind .immutable-table-span) (== kind .table-selection) (== kind .immutable-table-selection)))
    (lazy row (call class-arg types type 0))
  )
)

(fn-expr + table-row TypeId
  (param types Types)
  (param type TypeId)
  ; The type of the rows a table holds, or no type for any other type.
  (case? (or (not (call completed types type)) (!= (. ([] (. types completions) type) intrinsic) .table))
    no-type
  )
  (case? (not (call completed types row))
    no-type
  )
  (default
    row
  )
  (where
    (lazy row (call class-arg types type 0))
  )
)

(fn-expr + align-to U32
  (param offset U32)
  (param alignment U32)
  ; An offset moved up to the next multiple of an alignment.
  (if-expr (<= alignment 1) offset (* (/ (- (+ offset alignment) 1) alignment) alignment))
)

(type _ Region (is Tuple)
  ; Fields laid out in turn, each at the next offset its alignment allows: where each lies, and
  ; the size and alignment of the whole.
  (blank)
  (prop + offsets (list U32))
  (prop + size U32)
  (prop + alignment U32)
)

(fn-expr _ completed Bool
  (param types Types)
  (param type TypeId)
  ; Whether a type was completed before the store was sealed, which emission may read.
  (and (!= type no-type) (!= type invalid-type) (== (. ([] (. types completions) type) completion) .completion-done))
)

(fn-expr _ larger U32
  (param left U32)
  (param right U32)
  (if-expr (> left right) left right)
)

(fn-expr _ smaller U32
  (param left U32)
  (param right U32)
  (if-expr (< left right) left right)
)
