(import ./inliner)
(import ./ir-to-mir)
(import ./layouts)
(import ./program-tables)
(import /core/arena)
(import /lang/backend/bundle)
(import /lang/backend/mir)
(import /lang/backend/mir-digest)
(import /lang/check/stable-key)
(import /lang/ir/ir)
(import /lang/ir/ir-digest)
(import /string.h)
(blank)
(prop _ kept-rounds U64 (= 4))
(prop + no-place U32 (= (. U32 max)))

(type + Consult (is Struct)
  ; A function a run of the inliner consulted, by its name, with what it read of it
  ; (`IRDigester.context`).
  (blank)
  (prop + name StableKey)
  (prop + context IRDigest)
)

(type + SlotConsult (is Struct)
  ; A witness slot a run of the inliner looked up: the symbol of the table, as an id of the pool
  ; its entry names strings in, the slot's offset, and the name of the function found, or zero.
  (blank)
  (prop + symbol StringId)
  (prop + offset U32)
  (prop + target StableKey)
)

(type + KeptMark (is Struct)
  ; A mark lowering made for the merge: a layout by its key, or a plain site by its slot.
  (blank)
  (prop + kind LoweringMark)
  (prop + value U64)
)

(type + ReuseEntry (is Struct)
  ; What a round kept of a function it inlined and lowered, by the function's name:
  ; - its IR digest and the round's context;
  ; - the functions and the witness slots the inliner consulted;
  ; - the MIR digest, which finds its record in the backend cache;
  ; - the strings that record names, in the order the MIR digest met them, as ids of the pool of
  ;   the round that kept it (`pool`), each with its facts;
  ; - its literals, and the marks its lowering made.
  ; `round` is the last round that kept or reused it.
  (blank)
  (prop + name StableKey)
  (prop + ir IRDigest)
  (prop + context IRDigest)
  (prop + mir MIRDigest)
  (prop + pool U64)
  (prop + consults (of CPointer Consult))
  (prop + consult-count U32)
  (prop + slots (of CPointer SlotConsult))
  (prop + slot-count U32)
  (prop + strings (of CPointer U32))
  (prop + facts (of CPointer U32))
  (prop + string-count U32)
  (prop + literals (of CPointer StringLiteral))
  (prop + literal-count U32)
  (prop + marks (of CPointer KeptMark))
  (prop + mark-count U32)
  (prop + round U64)
)

(type + KeptPool
  ; A round's pool of strings, kept while an entry names strings by its ids. `found` holds, for
  ; the current round, each id's id in the round's bundle plus one, `U32.max` where the bundle does
  ; not hold it, or zero where no worker asked yet; workers that ask at once find the same id.
  (blank)
  (prop + round U64)
  (prop + strings StringPool)
  (prop + found (of CPointer U32))
  (prop _ arena Arena)
  (fn-do + This _
    (param round U64)
    (param bundle Bundle)
    (= (. this round) round)
    (= strings (call (. bundle copied-pool) arena))
  )
  (fn-do + release _
    (call (. arena release))
  )
  (fn-do + mapped StringId
    (param id StringId)
    (param bundle Bundle)
    ; The id in the round's bundle of the string with this id in the pool, or none.
    (let known ([] found id))
    (if (!= known 0)
      (return (if-expr (!= known (. U32 max)) (- known 1) no-string))
    )
    (let text (call (. bundle found) (call (. strings string) id)))
    (= ([] found id) (if-expr (!= text no-string) (+ text 1) (. U32 max)))
    (return text)
  )
)

(type + KeyIndex
  ; Ids by 64-bit keys, by open addressing: built by one worker, then read by many. Key zero is
  ; taken as one; a key put again keeps its first id.
  (blank)
  (prop _ keys (of CPointer U64))
  (prop _ ids (of CPointer U32))
  (prop _ capacity U32)
  (prop _ count U32)
  (fn-do + This _
    (param storage Arena)
    (param expected U32)
    (= capacity 16)
    (while (< capacity (* expected 2))
      (*= capacity 2)
    )
    (= keys (call (of (. storage allocate) U64) capacity))
    (= ids (call (of (. storage allocate) U32) capacity))
    (for (in slot (..< 0 capacity))
      (= ([] keys slot) 0)
    )
  )
  (fn-do + find U32
    (param key U64)
    (let wanted (if-expr (!= key 0) key 1u64))
    (let mask (- capacity 1))
    (let slot (call slot-of wanted mask))
    (while (!= ([] keys slot) 0)
      (if (== ([] keys slot) wanted)
        (return ([] ids slot))
      )
      (= slot (/and/ (+ slot 1) mask))
    )
    (return no-place)
  )
  (fn-do + put _
    (param storage Arena)
    (param key U64)
    (param id U32)
    (let wanted (if-expr (!= key 0) key 1u64))
    (if (> (* (+ count 1) 2) capacity)
      (call grow storage)
    )
    (let mask (- capacity 1))
    (let slot (call slot-of wanted mask))
    (while (!= ([] keys slot) 0)
      (if (== ([] keys slot) wanted)
        (return)
      )
      (= slot (/and/ (+ slot 1) mask))
    )
    (= ([] keys slot) wanted)
    (= ([] ids slot) id)
    (+= count 1)
  )
  (fn-do _ grow _
    (param storage Arena)
    (let old-keys keys)
    (let old-ids ids)
    (let old-capacity capacity)
    (= capacity (* old-capacity 2))
    (= keys (call (of (. storage allocate) U64) capacity))
    (= ids (call (of (. storage allocate) U32) capacity))
    (for (in slot (..< 0 capacity))
      (= ([] keys slot) 0)
    )
    (let mask (- capacity 1))
    (for (in index (..< 0 old-capacity))
      (if (!= ([] old-keys index) 0)
        (let slot (call slot-of ([] old-keys index) mask))
        (while (!= ([] keys slot) 0)
          (= slot (/and/ (+ slot 1) mask))
        )
        (= ([] keys slot) ([] old-keys index))
        (= ([] ids slot) ([] old-ids index))
      )
    )
  )
)

(fn-expr _ slot-of U32
  (param key U64)
  (param mask U32)
  (as (/and/ (/xor/ key (/zrshift/ key 32)) (as mask U64)) U32)
)

(type + EmissionMemory
  (implements (of Usable Void))
  ; What emission keeps from round to round, so that a round reuses a function before inlining it
  ; where its IR, the round's context and every function its inlining consulted are what they
  ; were: an entry per function name, the pools of strings the entries name, and a store for each
  ; worker of the round. An entry no round used for `kept-rounds` rounds is not reused, and goes
  ; when the entries are copied anew.
  (blank)
  (prop + round U64)
  (prop + reused U64)
  (prop + verified U64)
  (prop _ entries (list ReuseEntry))
  (prop _ places KeyIndex)
  (prop _ pools (list KeptPool))
  (prop _ arenas (list Arena))
  (prop _ stores (list ReuseStore))
  (prop _ index-arena Arena)
  (prop _ round-arena Arena)
  (prop _ replaced U32)
  (fn-do + This _
    (lazy places (call KeyIndex index-arena 1024))
  )
  (fn-expr + begin-using _
    this
  )
  (fn-do + end-using _
    (call release)
  )
  (fn-do + release _
    (for (in store stores)
      (call (. store arena release))
    )
    (call (. stores clear))
    (for (in arena arenas)
      (call (. arena release))
    )
    (call (. arenas clear))
    (for (in pool pools)
      (call (. pool release))
    )
    (call (. pools clear))
    (call (. entries clear))
    (call (. index-arena release))
    (call (. round-arena release))
  )
  (fn-do + begin-round _
    (param worker-count Size)
    (+= round 1)
    (= reused 0)
    (= verified 0)
    (for (in store stores)
      (call (. store arena release))
    )
    (call (. stores clear))
    (for (in _ (..< 0 worker-count))
      (+= stores (call ReuseStore this))
    )
    (call (. round-arena reset))
    (for (in pool pools)
      (= (. pool found) (call (of (. round-arena allocate) U32) (. pool strings count)))
      (call C:memset (as (. pool found) (of CPointer Byte)) 0 (* (as (. pool strings count) Size) 4))
    )
  )
  (fn-expr + store-for ReuseStore
    (param worker Size)
    ([] stores worker)
  )
  (fn-expr + place U32
    (param name StableKey)
    ; The entry kept for a function's name, where a later round may reuse it.
    (if-expr (or (== place no-place) (<= (+ (. ([] entries place) round) kept-rounds) round)) no-place place)
    (where
      (lazy place (call (. places find) name))
    )
  )
  (fn-expr + entry ReuseEntry
    (param place U32)
    ([] entries place)
  )
  (fn-do + pool KeptPool
    (param round U64)
    (for (in kept pools)
      (if (== (. kept round) round)
        (return kept)
      )
    )
    (throw (call Panic "An entry names strings of a pool no longer kept"))
  )
  (fn-do + finish-round _
    (param bundle Bundle)
    ; Takes in what the workers kept and reused. The round's pool of strings is kept for the
    ; entries the round kept, and each entry it reused moves onto it, so that an older pool stays only
    ; while an entry no round reused since names its strings.
    (let touched false)
    (for (in store stores)
      (if (or (!= (. store kept length) 0) (!= (. store used length) 0))
        (= touched true)
      )
    )
    (if touched
      (let made (call KeptPool round bundle))
      (+= pools made)
    )
    (for (in store stores)
      (for (in place (. store used))
        (call rebase place bundle)
        (= (. ([] entries place) round) round)
        (+= reused 1)
      )
      (for (in entry (. store kept))
        (if (!= (. entry round) round)
          (continue)
        )
        (let place (call (. places find) (. entry name)))
        (if (!= place no-place)
          (+= replaced 1)
          (= ([] entries place) entry)
          (else
            (call (. places put) index-arena (. entry name) (as (. entries length) U32))
            (+= entries entry)
          )
        )
      )
      (+= arenas (. store arena))
    )
    (call (. stores clear))
    (let live U32)
    (for (in entry entries)
      (if (> (+ (. entry round) kept-rounds) round)
        (+= live 1)
      )
    )
    (if (or (> replaced live) (> (. entries length) (as (* live 2) Size)))
      (call compact)
    )
    (call release-pools)
  )
  (fn-do _ rebase _
    (param place U32)
    (param bundle Bundle)
    ; Names a reused entry's strings by their ids in the round's pool, which the reuse found.
    (let entry ([] entries place))
    (if (== (. entry pool) round)
      (return)
    )
    (let kept (call pool (. entry pool)))
    (for (in index (..< 0 (. entry string-count)))
      (= ([] (. entry strings) index) (call (. kept mapped) ([] (. entry strings) index) bundle))
    )
    (for (in index (..< 0 (. entry slot-count)))
      (let slot ([] (. entry slots) index))
      (= ([] (. entry slots) index) (call SlotConsult (call (. kept mapped) (. slot symbol) bundle) (. slot offset) (. slot target)))
    )
    (= (. ([] entries place) pool) round)
  )
  (fn-do _ compact _
    (let arena (call Arena))
    (let kept (list ReuseEntry))
    (for (in entry entries)
      (if (> (+ (. entry round) kept-rounds) round)
        (+= kept (call copied arena entry))
      )
    )
    (for (in old arenas)
      (call (. old release))
    )
    (call (. arenas clear))
    (+= arenas arena)
    (call (. entries clear))
    (call (. index-arena reset))
    (= places (call KeyIndex index-arena (as (. kept length) U32)))
    (for (in entry kept)
      (call (. places put) index-arena (. entry name) (as (. entries length) U32))
      (+= entries entry)
    )
    (= replaced 0)
  )
  (fn-do _ release-pools _
    (let held (list U64))
    (for (in entry entries)
      (if (and (> (+ (. entry round) kept-rounds) round) (== (call (. held find) (. entry pool)) null))
        (+= held (. entry pool))
      )
    )
    (let kept (list KeptPool))
    (for (in pool pools)
      (if (!= (call (. held find) (. pool round)) null)
        (+= kept pool)
        (else
          (call (. pool release))
        )
      )
    )
    (= pools kept)
  )
  (fn-do _ copied ReuseEntry
    (param arena Arena)
    (param entry ReuseEntry)
    (let consults (call (of (. arena allocate) Consult) (. entry consult-count)))
    (call C:memcpy
      (block
        (arg (as consults (of CPointer Byte)))
        (arg (as (. entry consults) (of CPointer Byte)))
        (arg (* (as (. entry consult-count) Size) (. Consult size)))
      )
    )
    (let slots (call (of (. arena allocate) SlotConsult) (. entry slot-count)))
    (call C:memcpy
      (block
        (arg (as slots (of CPointer Byte)))
        (arg (as (. entry slots) (of CPointer Byte)))
        (arg (* (as (. entry slot-count) Size) (. SlotConsult size)))
      )
    )
    (let strings (call (of (. arena allocate) U32) (. entry string-count)))
    (call C:memcpy (as strings (of CPointer Byte)) (as (. entry strings) (of CPointer Byte)) (* (as (. entry string-count) Size) 4))
    (let facts (call (of (. arena allocate) U32) (. entry string-count)))
    (call C:memcpy (as facts (of CPointer Byte)) (as (. entry facts) (of CPointer Byte)) (* (as (. entry string-count) Size) 4))
    (let literals (call (of (. arena allocate) StringLiteral) (. entry literal-count)))
    (for (in index (..< 0 (. entry literal-count)))
      (let row ([] (. entry literals) index))
      (= ([] literals index)
        (call StringLiteral
          (block
            (arg (. row name))
            (arg (. row character-length))
            (arg (. row flags))
            (arg (call copied-bytes arena (. row bytes)))
          )
        )
      )
    )
    (let marks (call (of (. arena allocate) KeptMark) (. entry mark-count)))
    (call C:memcpy
      (block
        (arg (as marks (of CPointer Byte)))
        (arg (as (. entry marks) (of CPointer Byte)))
        (arg (* (as (. entry mark-count) Size) (. KeptMark size)))
      )
    )
    (return
      (call ReuseEntry
        (block
          (arg (. entry name))
          (arg (. entry ir))
          (arg (. entry context))
          (arg (. entry mir))
          (arg (. entry pool))
          (arg consults)
          (arg (. entry consult-count))
          (arg slots)
          (arg (. entry slot-count))
          (arg strings)
          (arg facts)
          (arg (. entry string-count))
          (arg literals)
          (arg (. entry literal-count))
          (arg marks)
          (arg (. entry mark-count))
          (arg (. entry round))
        )
      )
    )
  )
)

(type + ReuseStore
  ; What one worker keeps and reuses in a round, taken into the memory once the round ends. A
  ; kept entry names the functions its inlining consulted, and the layouts its lowering marked,
  ; by their ids in the round until `settle`, which needs every function's context.
  (blank)
  (prop + memory EmissionMemory)
  (prop + arena Arena)
  (prop + kept (list ReuseEntry))
  (prop + used (list U32))
  (prop _ consulted (list (of CPointer U32)))
  (fn-do + This _
    (param memory EmissionMemory)
    (= (. this memory) memory)
  )
  (fn-do + keep _
    (param name StableKey)
    (param ir IRDigest)
    (param context IRDigest)
    (param mir MIRDigest)
    (param inliner IRInliner)
    (param lowering IRToMIR)
    (param strings IdList)
    (param bundle Bundle)
    (param literals (of CPointer StringLiteral))
    (param literal-count U32)
    ; Keeps what the round made of a function it inlined and lowered. One whose inlining fused a
    ; reader is not kept, so that every round inlines it again.
    (if (. inliner fused)
      (return)
    )
    (let consult-count U32 (as (. inliner consulted length) U32))
    (let consults (call (of (. arena allocate) Consult) consult-count))
    (let positions (call (of (. arena allocate) U32) consult-count))
    (for (in index (..< 0 consult-count))
      (= ([] positions index) ([] (. inliner consulted) index))
    )
    (let slot-count U32 (as (. inliner slot-symbols length) U32))
    (let slots (call (of (. arena allocate) SlotConsult) slot-count))
    (for (in index (..< 0 slot-count))
      (= ([] slots index)
        (call SlotConsult
          (block
            (arg ([] (. inliner slot-symbols) index))
            (arg ([] (. inliner slot-offsets) index))
            (arg (as ([] (. inliner slot-targets) index) U64))
          )
        )
      )
    )
    (let string-count U32 (. strings length))
    (let ids (call (of (. arena allocate) U32) string-count))
    (let facts (call (of (. arena allocate) U32) string-count))
    (for (in index (..< 0 string-count))
      (= ([] ids index) ([] strings index))
      (= ([] facts index) (call (. bundle string-facts) ([] strings index)))
    )
    (let rows (call (of (. arena allocate) StringLiteral) literal-count))
    (for (in index (..< 0 literal-count))
      (let row ([] literals index))
      (= ([] rows index)
        (call StringLiteral
          (block
            (arg (. row name))
            (arg (. row character-length))
            (arg (. row flags))
            (arg (call copied-bytes arena (. row bytes)))
          )
        )
      )
    )
    (let mark-count U32 (as (. lowering marks length) U32))
    (let marks (call (of (. arena allocate) KeptMark) mark-count))
    (for (in index (..< 0 mark-count))
      (let packed ([] (. lowering marks) index))
      (= ([] marks index) (call KeptMark (call mark-kind packed) (call mark-value packed)))
    )
    (+= kept
      (call ReuseEntry
        (block
          (arg name)
          (arg ir)
          (arg context)
          (arg mir)
          (arg (. memory round))
          (arg consults)
          (arg consult-count)
          (arg slots)
          (arg slot-count)
          (arg ids)
          (arg facts)
          (arg string-count)
          (arg rows)
          (arg literal-count)
          (arg marks)
          (arg mark-count)
          (arg (. memory round))
        )
      )
    )
    (+= consulted positions)
  )
  (fn-do + settle _
    (param names (of CPointer U64))
    (param contexts (of CPointer IRDigest))
    (param layout-keys (of CPointer U64))
    ; Names each consulted function, slot target and marked layout of the kept entries by its key.
    ; An entry with a layout no key was found for is dropped.
    (for (in index (..< 0 (. kept length)))
      (let entry ([] kept index))
      (let positions ([] consulted index))
      (for (in item (..< 0 (. entry consult-count)))
        (let position ([] positions item))
        (= ([] (. entry consults) item) (call Consult ([] names position) ([] contexts position)))
      )
      (for (in item (..< 0 (. entry slot-count)))
        (let slot ([] (. entry slots) item))
        (let target (if-expr (!= (. slot target) (as no-function U64)) ([] names (. slot target)) 0u64))
        (= ([] (. entry slots) item) (call SlotConsult (. slot symbol) (. slot offset) target))
      )
      (for (in item (..< 0 (. entry mark-count)))
        (let mark ([] (. entry marks) item))
        (if (!= (. mark kind) .plain-mark)
          (let key ([] layout-keys (. mark value)))
          (if (== key 0)
            (= (. ([] kept index) round) 0)
          )
          (= ([] (. entry marks) item) (call KeptMark (. mark kind) key))
        )
      )
    )
  )
)

(type + ReuseRound
  ; What a round's workers share to reuse functions: the round's context, and for each function
  ; its name, its IR digest and its context, which the first pass writes, each worker its own
  ; functions'; and once that pass is done, the functions by name and the layouts by key.
  (blank)
  (prop + memory EmissionMemory)
  (prop + context IRDigest)
  (prop + names (of CPointer U64))
  (prop + digests (of CPointer IRDigest))
  (prop + contexts (of CPointer IRDigest))
  (prop + layout-keys (of CPointer U64))
  (prop + by-name KeyIndex)
  (prop + by-layout KeyIndex)
  (prop _ storage Arena)
  (fn-do + This _
    (param memory EmissionMemory)
    (param context IRDigest)
    (param function-count U32)
    (param layout-count U32)
    (param storage Arena)
    (= (. this memory) memory)
    (= (. this context) context)
    (= (. this storage) storage)
    (= names (call (of (. storage allocate) U64) function-count))
    (= digests (call (of (. storage allocate) IRDigest) function-count))
    (= contexts (call (of (. storage allocate) IRDigest) function-count))
    (= layout-keys (call (of (. storage allocate) U64) layout-count))
    (= by-name (call KeyIndex storage function-count))
    (= by-layout (call KeyIndex storage layout-count))
  )
  (fn-do + index _
    (param digesters (list IRDigester))
    (param function-count U32)
    (param layout-count U32)
    ; Indexes the functions by name and the layouts by key, once every worker has met each
    ; function's IR.
    (for (in position (..< 0 function-count))
      (call (. by-name put) storage ([] names position) position)
    )
    (for (in id (..< 0 layout-count))
      (let key (if-expr (< id first-struct-layout) (as id U64) 0u64))
      (if (== key 0)
        (for (in digester digesters)
          (let known (call (. digester known) id))
          (if (!= known 0)
            (= key known)
            (break)
          )
        )
      )
      (= ([] layout-keys id) key)
      (if (!= key 0)
        (call (. by-layout put) storage key id)
      )
    )
  )
)

(fn-do _ copied-bytes ByteSpan
  (param arena Arena)
  (param bytes ByteSpan)
  (let copy (call (. arena allocate-raw) (if-expr (!= (. bytes length) 0) (. bytes length) 1)))
  (call C:memcpy copy (. bytes data) (. bytes length))
  (return (call ByteSpan copy (. bytes length)))
)
