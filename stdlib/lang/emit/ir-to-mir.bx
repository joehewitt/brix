(import ./layouts)
(import ./program-tables)
(import ./runtime)
(import /core/arena)
(import /core/table)
(import /lang/backend/aarch64-encoder)
(import /lang/backend/builder)
(import /lang/backend/bundle)
(import /lang/backend/mir)
(import /lang/ir/ir)
(blank)
(prop _ struct-return-register RegisterId (= 8))
(prop _ argument-register-count U32 (= 8))
(prop _ panic-signal-register RegisterId (= 15))
(prop _ task-context-register RegisterId (= 27))
(prop _ aux-payload-mask U32 (= 0x7fffffff))
(prop _ mark-shift U32 (= 28))
(prop _ mark-mask U32 (= 0x0fffffff))

(type + IRToMIR
  ; Builds a function's MIR from its IR through the backend's builder, walking the blocks in
  ; the order they started. A non-value operand is materialized at each use. A struct's value is
  ; its address: of memory in the frame, of the buffer a call returned into, or of a place
  ; inside an object. A local is an object of the frame, which the backend turns into registers
  ; when nothing has its address; one that holds a number and that nothing reads is given none,
  ; and what is written to it is dropped. `used` marks each layout whose GC descriptor the
  ; worker's code names, and `buffers` each whose items a buffer the code allocates holds, so
  ; the merge adds those descriptors to the object. `marks` lists what the current function
  ; marked, each a kind and a layout or a plain site, for a later round that reuses it.
  (blank)
  (prop + marks (list U32))
  (prop + used (of CPointer Byte))
  (prop + buffers (of CPointer Byte))
  (prop + allocated (of CPointer Byte))
  (prop + plain-allocated (of CPointer Byte))
  (blank)
  (prop _ tables ProgramTables)
  (prop _ builder MIRBuilder)
  (prop _ values (of CPointer U32))
  (prop _ heaps (of CPointer Byte))
  (prop _ phi-inputs (of CPointer U32))
  (prop _ block-ids (of CPointer U32))
  (prop _ cells (of CPointer U32))
  (prop _ kept (of CPointer Byte))
  (prop _ arguments IdList)
  (prop _ general U32)
  (prop _ floats U32)
  (prop _ result OperandId (= no-operand))
  (prop _ struct-layouts IdList)
  (prop _ struct-types IdList)
  (prop _ checked-landing IRBlockId (= no-block))
  (prop _ split-roots (of CPointer U32))
  (prop _ split-offsets (of CPointer U32))
  (prop _ root-layouts (of CPointer U32))
  (prop _ root-ok (of CPointer Byte))
  (prop _ root-first (of CPointer U32))
  (prop _ root-count (of CPointer U32))
  (prop _ leaf-offsets (of CPointer U32))
  (prop _ leaf-layouts (of CPointer U32))
  (prop _ leaf-cells (of CPointer U32))
  (prop _ root-loads (of CPointer U32))
  (prop _ root-calls (of CPointer U32))
  (prop _ arg-roots (of CPointer U32))
  (fn-do + This _
    (param tables ProgramTables)
    (param builder MIRBuilder)
    (param storage Arena)
    (let count (. tables layouts count))
    (= used (call (of (. storage allocate) Byte) count))
    (= buffers (call (of (. storage allocate) Byte) count))
    (= allocated (call (of (. storage allocate) Byte) count))
    (for (in id (..< 0 count))
      (= ([] used id) 0)
      (= ([] buffers id) 0)
      (= ([] allocated id) 0)
    )
    (= plain-allocated (call (of (. storage allocate) Byte) plain-site-count))
    (for (in slot (..< 0 plain-site-count))
      (= ([] plain-allocated slot) 0)
    )
  )
  (fn-do + begin _
    (param id FunctionId)
    (call (. marks clear))
    ; Names the MIR function about to be built, after its arena was reset, and where it is declared.
    (let function (. builder function))
    (let row ([] (. tables functions) id))
    (= (. function order) id)
    (= (. function label) (. row name))
    (= (. function name) (. row name))
    (= (. function symbol) (. row symbol))
    (= (. function display-name) (. row display))
    (call (. builder adopt))
    (let declared (call (. tables declared-at) id))
    (if declared
      (= (. function loc) (call (. builder add-loc) declared))
    )
  )
  (fn-do + lower _
    (param ir IRFunction)
    ; Builds the function's blocks in the order they started. A value's register is noted where
    ; its row is lowered, and a phi's inputs where each predecessor ends.
    (let arena (. builder function arena))
    (let function (. builder function))
    (let count (. ir instructions length))
    (= values (call (of (. arena allocate) U32) (+ count 1)))
    (= heaps (call (of (. arena allocate) Byte) (+ count 1)))
    (for (in id (..< 0 count))
      (= ([] heaps id) 0)
    )
    (= phi-inputs (call (of (. arena allocate) U32) (+ (. ir operands length) 1)))
    (= block-ids (call (of (. arena allocate) U32) (+ (. ir blocks length) 1)))
    (= cells (call (of (. arena allocate) U32) (+ (. ir locals length) 1)))
    (= kept (call (of (. arena allocate) Byte) (+ (. ir locals length) 1)))
    (call keep-locals ir)
    (= struct-layouts (call IdList))
    (= struct-types (call IdList))
    (call plan-splits ir)
    (= result no-operand)
    (= checked-landing no-block)
    (for (in position (..< 0 (. ir order length)))
      (let block ([] (. ir order) position))
      (let name (. tables bundle entry-name))
      (if (!= position 0)
        (= name (call (. function add-local-name) .block-name no-string no-string block))
      )
      (= ([] block-ids block) (call (. builder add-block) name))
    )
    (call (. builder set-insert-block) ([] block-ids ([] (. ir order) 0)))
    (call lower-locals ir)
    (call lower-arguments ir)
    (for (in position (..< 0 (. ir order length)))
      (let block ([] (. ir order) position))
      (call (. builder set-insert-block) ([] block-ids block))
      (let rows (. ([] (. ir blocks) block) instructions))
      (for (in id (..< (. rows start) (. rows end)))
        (call lower-instruction ir id)
      )
    )
  )
  (fn-do + mark _
    (param kind LoweringMark)
    (param value U32)
    ; Marks a layout or a plain site for the merge, as lowering the current function does.
    (match kind
      (case= .used-mark
        (= ([] used value) 1)
      )
      (case= .buffer-mark
        (= ([] buffers value) 1)
      )
      (case= .allocated-mark
        (= ([] allocated value) 1)
      )
      (case= .plain-mark
        (= ([] plain-allocated value) 1)
      )
    )
    (+= marks (call packed-mark kind value))
  )
  (fn-do + build-process-main _
    (param id FunctionId)
    ; The C `main` the linker enters, built as machine code that needs no lowering: it saves the
    ; arguments, runs the task main on the event loop, which runs `threadinit` as each thread
    ; starts and `taskinit` as each task that native code starts begins, and exits with the process's
    ; exit code. Where probes compile, the event loop runs the task that closes their record once
    ; the others are done, and flushes what each thread wrote of them as it stops.
    (let function (. builder function))
    (let row ([] (. tables functions) id))
    (let task-main (. ([] (. tables functions) ([] (. tables calls) (. row calls start))) symbol))
    (= (. function is-lowered) true)
    (call (. builder set-insert-block) (call (. builder add-block) (. tables bundle entry-name)))
    (call (. builder bl) (call (. builder symbol) (call (. tables runtime-symbol) .runtime-save-args)))
    (call (. builder bl) (call (. builder symbol) (call (. tables runtime-symbol) .runtime-validate-allocation-abi)))
    (let entry (call (. builder preg) 10))
    (call (. builder adrp) entry (call (. builder label) task-main .page-reloc))
    (call (. builder add) entry entry (call (. builder label) task-main .pageoff-reloc))
    (let closer (call (. builder preg) 11))
    (if (== (. tables probe-closer) no-function)
      (call (. builder mov) closer (call (. builder small-int) 0))
      (else
        (let closer-symbol (. ([] (. tables functions) (. tables probe-closer)) symbol))
        (call (. builder adrp) closer (call (. builder label) closer-symbol .page-reloc))
        (call (. builder add) closer closer (call (. builder label) closer-symbol .pageoff-reloc))
      )
    )
    (let thread-init (call (. builder preg) 12))
    (if (== (. tables thread-init) no-function)
      (call (. builder mov) thread-init (call (. builder small-int) 0))
      (else
        (let init-symbol (. ([] (. tables functions) (. tables thread-init)) symbol))
        (call (. builder adrp) thread-init (call (. builder label) init-symbol .page-reloc))
        (call (. builder add) thread-init thread-init (call (. builder label) init-symbol .pageoff-reloc))
      )
    )
    (let thread-flush (call (. builder preg) 13))
    (if (== (. tables probe-flush) no-function)
      (call (. builder mov) thread-flush (call (. builder small-int) 0))
      (else
        (let flush-symbol (. ([] (. tables functions) (. tables probe-flush)) symbol))
        (call (. builder adrp) thread-flush (call (. builder label) flush-symbol .page-reloc))
        (call (. builder add) thread-flush thread-flush (call (. builder label) flush-symbol .pageoff-reloc))
      )
    )
    (let task-init (call (. builder preg) 14))
    (if (== (. tables task-init) no-function)
      (call (. builder mov) task-init (call (. builder small-int) 0))
      (else
        (let init-symbol (. ([] (. tables functions) (. tables task-init)) symbol))
        (call (. builder adrp) task-init (call (. builder label) init-symbol .page-reloc))
        (call (. builder add) task-init task-init (call (. builder label) init-symbol .pageoff-reloc))
      )
    )
    (call (. builder mov) (call (. builder preg) 0) entry)
    (call (. builder mov) (call (. builder preg) 1) closer)
    (call (. builder mov) (call (. builder preg) 2) (call (. builder small-int) 0))
    (call (. builder mov) (call (. builder preg) 3) (call (. builder small-int) (. tables task-local-size)))
    (call (. builder mov) (call (. builder preg) 4) thread-init)
    (call (. builder mov) (call (. builder preg) 5) thread-flush)
    (call (. builder mov) (call (. builder preg) 6) (call (. builder small-int) (. tables thread-local-size)))
    (call (. builder mov) (call (. builder preg) 7) task-init)
    (call (. builder bl) (call (. builder symbol) (call (. tables runtime-symbol) .runtime-run-event-loop)))
    (call (. builder bl) (call (. builder symbol) (call (. tables runtime-symbol) .runtime-process-exit-code)))
    (call (. builder bl) (call (. builder symbol) (call (. tables runtime-symbol) .runtime-exit)))
  )
  (fn-do _ keep-locals _
    (param ir IRFunction)
    ; Marks the locals the frame holds: each that a row reads or takes the address of, each that
    ; holds a managed pointer, which keeps what it points at alive though nothing reads it, and
    ; each struct. A number nothing reads, as a flag the function clears and never tests, is not
    ; held.
    (for (in id (..< 0 (. ir locals length)))
      (let local ([] (. ir locals) id))
      (= ([] kept id) 0)
      (if (or (. local address-taken) (== (. local layout) managed-layout) holds-struct)
        (= ([] kept id) 1)
      )
      (lazy holds-struct (call (. tables layouts is-struct) (. local layout)))
    )
    (for (in id (..< 0 (. ir instructions length)))
      (let row ([] (. ir instructions) id))
      (if (or (== (. row op) .op-load-local) (== (. row op) .op-local-address))
        (= ([] kept (. row aux)) 1)
      )
    )
  )
  (fn-do _ lower-locals _
    (param ir IRFunction)
    ; Gives each local the frame holds an object of the frame, and lists it as a variable of the
    ; function. One that holds a managed pointer is a GC root, which the prologue clears, and so
    ; is a struct that holds some, which the collector scans in place. One whose address nothing
    ; has may become registers, which the backend decides for the variables listed. A struct
    ; never does.
    (let function (. builder function))
    (for (in id (..< 0 (. ir locals length)))
      (if (== ([] kept id) 0)
        (= ([] cells id) no-operand)
        (continue)
      )
      (if (!= ([] root-ok id) 0)
        (= ([] cells id) no-operand)
        (call add-leaves (as id U32))
        (continue)
      )
      (let local ([] (. ir locals) id))
      (let descriptor (call stack-descriptor (. local layout)))
      (let is-root (or (== (. local layout) managed-layout) (!= descriptor no-string)))
      (let mode (if-expr (== descriptor no-string) (. GCRootMode value-root) (. GCRootMode address-root)))
      (let promoted (and (not (. local address-taken)) (not (call (. tables layouts is-struct) (. local layout)))))
      (let slot (call (. builder frame-slot)))
      (let type (call mir-type (. local layout)))
      (let object (call (. builder add-frame-object) slot type 0 promoted is-root descriptor mode))
      (= (. function vars) (call (. function vars appended) (. function arena) object))
      (= ([] cells id) (call (. builder frame-object-operand) object))
    )
    (for (in id (..< 0 (. ir instructions length)))
      (let op (. ([] (. ir instructions) id) op))
      (if (and (or (== op .op-frame) (== op .op-call)) (!= ([] root-ok (+ (. ir locals length) id)) 0))
        (call add-leaves (as (+ (. ir locals length) id) U32))
      )
    )
  )
  (fn-do _ lower-arguments _
    (param ir IRFunction)
    ; The address a struct too large for registers is returned to arrives in a register of its
    ; own, and each argument in the next register of its class, floats counted apart from the
    ; rest. Each is moved into a register of the function's own. One that no register of its
    ; class is left for arrives on the stack and is loaded from there, a struct too large for
    ; registers as its address. An argument of no size is not passed: one that is a struct is
    ; memory of no size in the frame.
    (let arena (. builder function arena))
    (= arguments (call new-id-list arena (. ir arguments length)))
    (if (call (. tables layouts is-large) (. ir returns))
      (let incoming (call (. builder vreg-operand) (call (. builder new-vreg) .gpr64 struct-return-register)))
      (= result (call (. builder vreg) .gpr64))
      (call (. builder mov) result incoming)
    )
    (= general 0)
    (= floats 0)
    (for (in position (..< 0 (. ir arguments length)))
      (let layout (as ([] (. ir arguments) position) LayoutId))
      (if (== layout void-layout)
        (= arguments (call (. arguments appended) arena no-operand))
        (continue)
      )
      (if (call is-empty-struct layout)
        (= arguments (call (. arguments appended) arena (call empty-place layout)))
        (continue)
      )
      (if (and small-struct (!= ([] arg-roots position) 0) (!= ([] root-ok (- ([] arg-roots position) 1)) 0))
        (call receive-leaves (- ([] arg-roots position) 1))
        (= arguments (call (. arguments appended) arena no-operand))
        (continue)
      )
      (lazy small-struct (and (call (. tables layouts is-struct) layout) (not (call (. tables layouts is-large) layout))))
      (if (and (call (. tables layouts is-struct) layout) (not (call (. tables layouts is-large) layout)))
        (= arguments (call (. arguments appended) arena (call receive-struct layout)))
        (continue)
      )
      (let reg-class (call layout-class layout))
      (let number general)
      (if (call is-float layout)
        (= number floats)
        (+= floats 1)
        (else
          (+= general 1)
        )
      )
      (let value (call new-value layout false))
      (if (< number argument-register-count)
        (let incoming
          (call (. builder vreg-operand)
            (block
              (arg (call (. builder new-vreg) reg-class (call register-of reg-class number)))
            )
          )
        )
        (if (and (not (. builder bundle apple-abi)) (call is-narrow-integer layout))
          (call extend value incoming (. ([] (. tables layouts rows) layout) size) (call is-signed layout))
          (else
            (call move value incoming layout)
          )
        )
        (else
          (let passed (call mir-type layout))
          (if (call (. tables layouts is-struct) layout)
            (= passed (call (. builder reg-class-type) reg-class))
          )
          (call (. builder load) value (call (. builder frame-object-operand) (call (. builder overflow-object) passed)) passed)
        )
      )
      (= arguments (call (. arguments appended) arena value))
    )
  )
  (fn-expr _ is-empty-struct Bool
    (param layout LayoutId)
    ; Whether a layout is a struct of no size, which no register takes to a function or back.
    (and (call (. tables layouts is-struct) layout) (== (. ([] (. tables layouts rows) layout) size) 0))
  )
  (fn-do _ empty-place OperandId
    (param layout LayoutId)
    ; Memory of no size in the frame, which an argument or an answer of no size is from there on.
    (let object (call (. builder add-frame-object) (call (. builder frame-slot)) (call mir-type layout) 0 false))
    (let place (call new-value layout false))
    (call (. builder add-pointer) place (call (. builder frame-object-operand) object))
    (return place)
  )
  (fn-do _ receive-leaves _
    (param root U32)
    ; A split struct argument arrives in the registers it travels in, and each of its fields is
    ; moved from there into a register of its own: each float of a struct of floats from a
    ; register of its own, and each other field from the bits of the word it lies in.
    (let count (call (. builder struct-parts) (call mir-type ([] root-layouts root))))
    (let reg-class (call (. builder type-reg-class) ([] (. builder part-types) 0)))
    (let is-floats (or (== reg-class .fpr32) (== reg-class .fpr64)))
    (let taken (if-expr is-floats floats general))
    (let fits (<= (+ taken count) argument-register-count))
    (let next (if-expr fits (+ taken count) argument-register-count))
    (if is-floats
      (= floats next)
      (else
        (= general next)
      )
    )
    (call add-leaves root)
    (let words (call new-id-list (. builder function arena) count))
    (for (in index (..< 0 count))
      (let part ([] (. builder part-types) index))
      (let word (call (. builder vreg) (call (. builder type-reg-class) part)))
      (if fits
        (let incoming
          (call (. builder vreg-operand)
            (block
              (arg (call (. builder new-vreg) reg-class (call register-of reg-class (+ taken index))))
            )
          )
        )
        (if is-floats
          (call (. builder fmov) word incoming)
          (else
            (call (. builder mov) word incoming)
          )
        )
        (else
          (call (. builder load) word (call (. builder frame-object-operand) (call (. builder overflow-object) part)) part)
        )
      )
      (= words (call (. words appended) (. builder function arena) word))
    )
    (call unpack root words is-floats)
  )
  (fn-do _ unpack _
    (param root U32)
    (param words IdList)
    (param is-floats Bool)
    ; Moves each field of a split struct from the registers it travels in into a register of its
    ; own: each float of a struct of floats from a register of its own, and each other field from
    ; the bits of the word it lies in.
    (let first ([] root-first root))
    (for (in leaf (..< first (+ first ([] root-count root))))
      (let spot ([] leaf-offsets leaf))
      (let layout ([] leaf-layouts leaf))
      (let value (call new-value layout false))
      (if is-floats
        (call move value ([] words (- leaf first)) layout)
        (else
          (let bits (* (% spot 8) 8))
          (let source OperandId ([] words (/ spot 8)))
          (if (!= bits 0)
            (let shifted (call (. builder vreg) .gpr64))
            (call (. builder asm) .lsr shifted source (call (. builder small-int) bits))
            (= source shifted)
          )
          (call (. builder mov)
            (block
              (arg value)
              (arg (if-expr (== (. ([] (. tables layouts rows) layout) size) 8) source (call (. builder narrow-view) source)))
            )
          )
        )
      )
      (call (. builder store) ([] leaf-cells leaf) value (call mir-type layout))
    )
  )
  (fn-do _ receive-struct OperandId
    (param layout LayoutId)
    ; A struct that arrives in registers is stored to memory of the frame, and is the address of
    ; that memory from there on. One the registers left cannot hold arrives whole on the stack,
    ; and no later argument of its class arrives in a register. Words are stored whole, so the
    ; memory of a struct that travels as words is whole words.
    (let function (. builder function))
    (let type (call mir-type layout))
    (let count (call (. builder struct-parts) type))
    (let reg-class (call (. builder type-reg-class) ([] (. builder part-types) 0)))
    (let is-floats (or (== reg-class .fpr32) (== reg-class .fpr64)))
    (let held type)
    (if (not is-floats)
      (= held (as (. function types length) MIRTypeId))
      (call (. function types append) (call ArrayType (* count 8) 8 u8-type-id (* count 8)))
    )
    (let object (call (. builder add-frame-object) (call (. builder frame-slot)) held 0 false))
    (let taken (if-expr is-floats floats general))
    (let fits (<= (+ taken count) argument-register-count))
    (let next (if-expr fits (+ taken count) argument-register-count))
    (if is-floats
      (= floats next)
      (else
        (= general next)
      )
    )
    (let place (call new-value layout false))
    (call (. builder add-pointer) place (call (. builder frame-object-operand) object))
    (for (in index (..< 0 count))
      (let part ([] (. builder part-types) index))
      (let target (call (. builder load-address-offset) place ([] (. builder part-offsets) index)))
      (if fits
        (let register (call register-of reg-class (+ taken index)))
        (call (. builder store) target (call (. builder vreg-operand) (call (. builder new-vreg) reg-class register)) part)
        (else
          (call (. builder store) target (call (. builder frame-object-operand) (call (. builder overflow-object) part)) part)
        )
      )
    )
    (return place)
  )
  (fn-do _ lower-instruction _
    (param ir IRFunction)
    (param id ValueId)
    (let row ([] (. ir instructions) id))
    (match (. row op)
      (case= .op-call-void
        (call lower-call ir id row)
      )
      (case= .op-call
        (call lower-call ir id row)
      )
      (case= .op-return
        (call lower-return ir row)
      )
      (case= .op-jump
        (call lower-jump ir row)
      )
      (case= .op-branch
        (call lower-branch ir row)
      )
      (case= .op-switch
        (call lower-switch ir row)
      )
      (case= .op-yield
        (throw (call Panic "A yield is only fused into the loop that reads it"))
      )
      (case= .op-phi
        (call lower-phi ir id row)
      )
      (case= .op-arithmetic
        (call lower-arithmetic ir id row)
      )
      (case= .op-bitwise
        (call lower-bitwise ir id row)
      )
      (case= .op-num-cast
        (call lower-num-cast ir id row)
      )
      (case= .op-load
        (call lower-load ir id row)
      )
      (case= .op-store
        (call lower-store ir row)
      )
      (case= .op-load-acquire
        (call lower-load-acquire ir id row)
      )
      (case= .op-store-release
        (call lower-store-release ir row)
      )
      (case= .op-address
        (call lower-address ir id row)
      )
      (case= .op-frame
        (call lower-frame id row)
      )
      (case= .op-copy
        (call lower-copy ir row)
      )
      (case= .op-zero
        (call lower-zero ir row)
      )
      (case= .op-load-task-panic
        (call lower-load-task-panic id)
      )
      (case= .op-load-panic-signal
        (call lower-load-panic-signal)
      )
      (case= .op-load-task-word
        (call lower-load-task-word id row)
      )
      (case= .op-negate
        (call lower-negate ir id row)
      )
      (case= .op-bitwise-not
        (call lower-bitwise-not ir id row)
      )
      (case= .op-compare
        (call lower-compare ir id row)
      )
      (case= .op-load-local
        (call lower-load-local id row)
      )
      (case= .op-store-local
        (call lower-store-local ir row)
      )
      (case= .op-count-leading-zeros
        (call lower-count-leading-zeros ir id row)
      )
      (case= .op-local-address
        (call lower-local-address id row)
      )
      (case= .op-float-math
        (call lower-float-math ir id row)
      )
      (case= .op-inlined-name
        (call lower-inlined-name ir id row)
      )
    )
  )
  (fn-do _ lower-call _
    (param ir IRFunction)
    (param id ValueId)
    (param row IRInstruction)
    ; A call of a symbol, or of an address held in a register. A struct too large for registers
    ; is returned into a buffer the backend reserves, and the call's value is its address. A split
    ; struct small enough for registers is returned in the registers it travels in, and each of
    ; its fields is taken from there into a register of its own. A checked call names the landing pad it leaves to when its callee returns a panic. A call that
    ; records its caller's stack is a safepoint on every path. An argument of no size is not
    ; passed, and an answer of no size is not brought back: it is memory of no size in the frame.
    ; Under AAPCS64 a C function leaves the high bits of an integer answer narrower than 32 bits
    ; unspecified, so the call extends it.
