  (fn-do _ pack IdList
    (param operand Operand)
    (param layout LayoutId)
    ; The registers a split struct that `packs` travels in, built from its fields: each float of a
    ; struct of floats as it is, and each word of any other struct from the fields that lie in it.
    (let arena (. builder function arena))
    (let root (- (call root-of operand) 1))
    (let base (call offset-of operand))
    (let size (. ([] (. tables layouts rows) layout) size))
    (let count (call (. builder struct-parts) (call mir-type layout)))
    (let words (call new-id-list arena count))
    (let first ([] root-first root))
    (let reg-class (call (. builder type-reg-class) ([] (. builder part-types) 0)))
    (if (or (== reg-class .fpr32) (== reg-class .fpr64))
      (for (in leaf (..< first (+ first ([] root-count root))))
        (let spot ([] leaf-offsets leaf))
        (if (and (>= spot base) (< spot (+ base size)))
          (let member (call (. builder new-vreg) reg-class))
          (call (. builder load)
            (block
              (arg (call (. builder vreg-operand) member))
              (arg ([] leaf-cells leaf))
              (arg (call mir-type ([] leaf-layouts leaf)))
            )
          )
          (= words (call (. words appended) arena member))
        )
      )
      (return words)
    )
    (for (in index (..< 0 count))
      (let word no-operand)
      (for (in leaf (..< first (+ first ([] root-count root))))
        (let spot ([] leaf-offsets leaf))
        (if (and (>= spot base) (< spot (+ base size)) (== (/ (- spot base) 8) index))
          (let part ([] leaf-layouts leaf))
          (let width (. ([] (. tables layouts rows) part) size))
          (let bits (* (% (- spot base) 8) 8))
          (let piece (call (. builder vreg) .gpr64))
          (if (== width 8)
            (call (. builder load) piece ([] leaf-cells leaf) (call mir-type part))
            (else
              (let held (call new-value part false))
              (call (. builder load) held ([] leaf-cells leaf) (call mir-type part))
              (call extend piece held width false)
            )
          )
          (if (!= bits 0)
            (let shifted (call (. builder vreg) .gpr64))
            (call (. builder asm) .lsl shifted piece (call (. builder small-int) bits))
            (= piece shifted)
          )
          (if (== word no-operand)
            (= word piece)
            (else
              (let joined (call (. builder vreg) .gpr64))
              (call (. builder asm) .orr joined word piece)
              (= word joined)
            )
          )
        )
      )
      (let member (call (. builder new-vreg) .gpr64))
      (call (. builder mov) (call (. builder vreg-operand) member) word)
      (= words (call (. words appended) arena member))
    )
    (return words)
  )
  (fn-do _ split-leaf U32
    (param operand Operand)
    (param offset U32)
    (if (not (call is-split operand))
      (return (. U32 max))
    )
    (let root (- (call root-of operand) 1))
    (let spot (+ (call offset-of operand) offset))
    (let first ([] root-first root))
    (for (in leaf (..< first (+ first ([] root-count root))))
      (if (== ([] leaf-offsets leaf) spot)
        (return leaf)
      )
    )
    (return (. U32 max))
  )
  (fn-do _ copy-split _
    (param ir IRFunction)
    (param target Operand)
    (param source Operand)
    (param layout LayoutId)
    (let size (. ([] (. tables layouts rows) layout) size))
    (let target-split (call is-split target))
    (let source-split (call is-split source))
    (let split (if-expr target-split target source))
    (let root (- (call root-of split) 1))
    (let base (call offset-of split))
    (let target-base no-operand)
    (let source-base no-operand)
    (if (not target-split)
      (= target-base (call materialize ir target))
    )
    (if (not source-split)
      (= source-base (call materialize ir source))
    )
    (let first ([] root-first root))
    (for (in leaf (..< first (+ first ([] root-count root))))
      (let spot ([] leaf-offsets leaf))
      (if (and (>= spot base) (< spot (+ base size)))
        (let inside (- spot base))
        (let part ([] leaf-layouts leaf))
        (let type (call mir-type part))
        (let held (call new-value part false))
        (if source-split
          (call (. builder load) held ([] leaf-cells (call split-leaf source inside)) type)
          (else
            (call (. builder load) held (call (. builder load-address-offset) source-base inside) type)
          )
        )
        (if target-split
          (call (. builder store) ([] leaf-cells (call split-leaf target inside)) held type)
          (else
            (call (. builder store) (call (. builder load-address-offset) target-base inside) held type)
          )
        )
      )
    )
  )
  (fn-do _ zero-split _
    (param operand Operand)
    (param layout LayoutId)
    (let size (. ([] (. tables layouts rows) layout) size))
    (let root (- (call root-of operand) 1))
    (let base (call offset-of operand))
    (let first ([] root-first root))
    (for (in leaf (..< first (+ first ([] root-count root))))
      (let spot ([] leaf-offsets leaf))
      (if (and (>= spot base) (< spot (+ base size)))
        (let part ([] leaf-layouts leaf))
        (let zero no-operand)
        (if (call is-float part)
          (= zero (call materialize-float (as part MachineKind) 0))
          (else
            (= zero (call materialize-integer (as part MachineKind) 0))
          )
        )
        (call (. builder store) ([] leaf-cells leaf) zero (call mir-type part))
      )
    )
  )
  (fn-do _ lower-load-task-panic _
    (param id ValueId)
    (let value (call new-value managed-layout false))
    (= ([] values id) value)
    (= ([] heaps id) 1)
    (call (. builder ldr) value (call task-panic-address))
  )
  (fn-do _ lower-load-task-word _
    (param id ValueId)
    (param row IRInstruction)
    ; Reads a word of the task's context, at the offset the instruction gives.
    (let value (call new-value (. row layout) false))
    (= ([] values id) value)
    (call (. builder ldr) value (call (. builder load-address-offset) (call (. builder preg) task-context-register) (. row aux)))
  )
  (fn-do _ lower-load-panic-signal _
    ; Reads the active panic into the panic signal, where the branch that follows tests it.
    (call (. builder ldr) (call (. builder preg) panic-signal-register) (call task-panic-address))
  )
  (fn-do _ task-panic-address OperandId
    ; Where the task's context holds the active panic.
    (return (call (. builder load-address-offset) (call (. builder preg) task-context-register) 0))
  )
  (fn-do _ materialize OperandId
    (param ir IRFunction)
    (param operand Operand)
    ; The register holding an operand's value. A constant, an integer and an address are built
    ; where they are used.
    (let payload (call operand-payload operand))
    (match (call operand-kind operand)
      (case= .operand-value
        (return ([] values payload))
      )
      (case= .operand-argument
        (return ([] arguments payload))
      )
      (case= .operand-constant
        (return (call (. builder literal-address) payload true))
      )
      (case= .operand-number
        (let number ([] (. ir numbers) payload))
        (if (or (== (. number kind) .machine-f32) (== (. number kind) .machine-f64))
          (return (call materialize-float (. number kind) (. number bits)))
        )
        (return (call materialize-integer (. number kind) (. number bits)))
      )
      (case= .operand-symbol
        (return (call symbol-address payload))
      )
      (case= .operand-descriptor
        (return (call symbol-address (call descriptor-of payload)))
      )
      (case= .operand-buffer-descriptor
        (call mark .buffer-mark payload)
        (return (call symbol-address (. ([] (. tables layouts rows) payload) buffer)))
      )
      (case= .operand-result
        (return result)
      )
      (case= .operand-panic-signal
        (return (call (. builder preg) panic-signal-register))
      )
      (throw (call Panic "An operand of this kind has no value to put in a register"))
    )
    (return no-operand)
  )
  (fn-do _ symbol-address OperandId
    (param name StringId)
    (return (call (. builder symbol-address) (call (. builder symbol) name)))
  )
  (fn-do _ materialize-integer OperandId
    (param kind MachineKind)
    (param bits U64)
    ; An integer in a new register, in the fewest instructions. One whose half-words are all zero
    ; but one is a MOVZ of it. Else one a single move can make, by a MOVN or by a bitmask, is that
    ; move. Else it starts from zeros or from ones, whichever leaves fewer half-words to differ: its
    ; lowest half-word that differs, then a MOVK of each other one that does. The null of a managed
    ; pointer is a GC root like any value of its kind.
    (let is-managed (== kind .machine-managed-pointer))
    (let is-wide (or is-managed (== kind .machine-pointer) (== kind .machine-u64) (== kind .machine-i64)))
    (let reg-class (if-expr is-wide (. RegClass gpr64) (. RegClass gpr32)))
    (let value (call (. builder vreg-operand) (call (. builder new-vreg) reg-class no-register is-managed)))
    (let width U32 (if-expr is-wide 64 32))
    (let whole (if-expr is-wide bits (/and/ bits 0xffffffff)))
    (let zeros U32)
    (let ones U32)
    (let shift U32)
    (while (< shift width)
      (let chunk (/and/ (/zrshift/ whole shift) 0xffff))
      (if (!= chunk 0)
        (+= zeros 1)
      )
      (if (!= chunk 0xffff)
        (+= ones 1)
      )
      (+= shift 16)
    )
    (if (and (> zeros 1) (or (. (call encode-move-wide-immediate whole width) is-encodable) encodes-logical))
      (call (. builder asm) .mov value (call (. builder small-int) (as whole I64)))
      (return value)
    )
    (lazy encodes-logical (. (call encode-logical-immediate whole width) is-encodable))
    (let negated (< ones zeros))
    (let filler U64 (if-expr negated 0xffff 0))
    (let first U32)
    (= shift 0)
    (while (< shift width)
      (if (!= (/and/ (/zrshift/ whole shift) 0xffff) filler)
        (= first shift)
        (break)
      )
      (+= shift 16)
    )
    (let low (/and/ (/zrshift/ whole first) 0xffff))
    (if negated
      (call (. builder asm)
        (block
          (arg .movn)
          (arg value)
          (arg (call (. builder small-int) (as (/xor/ low 0xffff) I64)))
          (arg (call (. builder small-int) first))
        )
      )
      (else
        (call (. builder asm) .movz value (call (. builder small-int) (as low I64)) (call (. builder small-int) first))
      )
    )
    (= shift 0)
    (while (< shift width)
      (let chunk (/and/ (/zrshift/ whole shift) 0xffff))
      (if (and (!= shift first) (!= chunk filler))
        (call (. builder asm) .movk value (call (. builder small-int) (as chunk I64)) (call (. builder small-int) shift))
      )
      (+= shift 16)
    )
    (return value)
  )
  (fn-do _ materialize-float OperandId
    (param kind MachineKind)
    (param bits U64)
    ; A float in a new register: its bits built as an integer and moved across.
    (let is-wide (== kind .machine-f64))
    (let held (if-expr is-wide (. MachineKind machine-u64) (. MachineKind machine-u32)))
    (let whole-bits (call materialize-integer held bits))
    (let value (call (. builder vreg) (if-expr is-wide (. RegClass fpr64) (. RegClass fpr32))))
    (call (. builder fmov) value whole-bits)
    (return value)
  )
  (fn-do _ move _
    (param dest OperandId)
    (param src OperandId)
    (param layout LayoutId)
    ; Moves a value of a layout from one register to another of its class.
    (if (call is-float layout)
      (call (. builder fmov) dest src)
      (else
        (call (. builder mov) dest src)
      )
    )
  )
  (fn-do _ is-heap Bool
    (param ir IRFunction)
    (param operand Operand)
    ; Whether an operand is a managed pointer or an address inside an object.
    (let payload (call operand-payload operand))
    (match (call operand-kind operand)
      (case= .operand-value
        (return (!= ([] heaps payload) 0))
      )
      (case= .operand-argument
        (return (== ([] (. ir arguments) payload) managed-layout))
      )
      (default
        (return false)
      )
    )
    (return false)
  )
  (fn-do _ new-value OperandId
    (param layout LayoutId)
    (param inside Bool)
    ; A new register for a value of a layout. One that holds a managed pointer, or an address
    ; inside an object, is a GC root. One that holds the address of a struct outside the heap is
    ; a root by that address when the struct holds managed pointers.
    (if (or (== layout managed-layout) inside)
      (return (call (. builder vreg-operand) (call (. builder new-vreg) .gpr64 no-register true)))
    )
    (let descriptor (call stack-descriptor layout))
    (if (!= descriptor no-string)
      (return (call (. builder vreg-operand) (call (. builder new-vreg) .gpr64 no-register true descriptor .address-root)))
    )
    (return (call (. builder vreg) (call layout-class layout)))
  )
  (fn-do _ stack-descriptor StringId
    (param layout LayoutId)
    ; The descriptor of a struct that holds managed pointers, marked as one the object needs.
    (let name (call (. tables layouts stack-descriptor) layout))
    (if (!= name no-string)
      (call mark .used-mark layout)
    )
    (return name)
  )
  (fn-do _ descriptor-of StringId
    (param layout LayoutId)
    (call mark .used-mark layout)
    (return (. ([] (. tables layouts rows) layout) descriptor))
  )
  (fn-do _ mir-type MIRTypeId
    (param layout LayoutId)
    ; The MIR type of a layout. A struct's type is built once for the function.
    (if (< layout first-struct-layout)
      (return (call scalar-type layout))
    )
    (for (in index (..< 0 (. struct-layouts length)))
      (if (== ([] struct-layouts index) layout)
        (return ([] struct-types index))
      )
    )
    (let function (. builder function))
    (let arena (. function arena))
    (let row ([] (. tables layouts rows) layout))
    (let children (call new-id-list arena (. row fields count)))
    (for (in position (..< (. row fields start) (. row fields end)))
      (= children (call (. children appended) arena (call mir-type (. ([] (. tables layouts fields) position) layout))))
    )
    (let start U32 (as (. function struct-fields length) U32))
    (for (in index (..< 0 (. children length)))
      (let field ([] (. tables layouts fields) (+ (. row fields start) index)))
      (call (. function struct-fields append) (call StructField ([] children index) (. field offset)))
    )
    (let id MIRTypeId (as (. function types length) MIRTypeId))
    (call (. function types append)
      (block
        (arg (call MIRStructType (. row size) (. row alignment) (. row format) (call Span start (. row fields count))))
      )
    )
    (= struct-layouts (call (. struct-layouts appended) arena layout))
    (= struct-types (call (. struct-types appended) arena id))
    (return id)
  )
  (fn-expr _ scalar-type MIRTypeId
    (param layout LayoutId)
    (match layout
      (case= void-layout
        void-type-id
      )
      (case= u8-layout
        u8-type-id
      )
      (case= i8-layout
        i8-type-id
      )
      (case= u16-layout
        u16-type-id
      )
      (case= i16-layout
        i16-type-id
      )
      (case= u32-layout
        u32-type-id
      )
      (case= i32-layout
        i32-type-id
      )
      (case= u64-layout
        u64-type-id
      )
      (case= i64-layout
        i64-type-id
      )
      (case= f32-layout
        f32-type-id
      )
      (case= f64-layout
        f64-type-id
      )
      (default
        pointer-type-id
      )
    )
  )
  (fn-expr _ layout-class RegClass
    (param layout LayoutId)
    (case? (== layout f32-layout)
      (. RegClass fpr32)
    )
    (case? (== layout f64-layout)
      (. RegClass fpr64)
    )
    (case? (and (>= layout u8-layout) (<= layout i32-layout))
      (. RegClass gpr32)
    )
    (default
      (. RegClass gpr64)
    )
  )
  (fn-expr _ is-narrow-integer Bool
    (param layout LayoutId)
    (and (> size 0) (< size 4) (not (call is-float layout)) (not (call (. tables layouts is-struct) layout)))
    (where
      (lazy size (. ([] (. tables layouts rows) layout) size))
    )
  )
  (fn-do _ location LocId
    (param ir IRFunction)
    (param row IRInstruction)
    (let owner ([] (. tables functions) (. ir function)))
    (if (or (== (. row line) 0) (. owner placeless))
      (return no-loc)
    )
    (let module (if-expr (== (. owner site-module) (. U32 max)) (. owner module) (. owner site-module)))
    (let file ([] (. tables module-paths) (if-expr (== (. row module) (. U32 max)) module (. row module))))
    (return (call (. builder add-loc) (call MIRLoc file true (as (. row line) I32) (as (. row column) I32) 0 0)))
  )
)

(type + LoweringMark (is U32)
  (variant used-mark (= 0))
  (variant buffer-mark (= 1))
  (variant allocated-mark (= 2))
  (variant plain-mark (= 3))
)

(fn-expr + mark-kind LoweringMark
  (param packed U32)
  (as (/zrshift/ packed mark-shift) LoweringMark)
)

(fn-expr + mark-value U32
  (param packed U32)
  (/and/ packed mark-mask)
)

(fn-expr + packed-mark U32
  (param kind LoweringMark)
  (param value U32)
  (/or/ (/lshift/ (as kind U32) mark-shift) value)
)

(type _ ArmCondition (is U32)
  (variant equal)
  (variant not-equal)
  (variant higher-same)
  (variant lower)
  (variant minus)
  (variant higher (= 8))
  (variant lower-same (= 9))
  (variant greater-equal (= 10))
  (variant less (= 11))
  (variant greater (= 12))
  (variant less-equal (= 13))
)

(fn-do _ bit-length U64
  (param value U64)
  (let width U64)
  (let rest value)
  (while (!= rest 0)
    (= rest (/zrshift/ rest 1))
    (+= width 1)
  )
  (return width)
)
