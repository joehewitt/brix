      (return)
    )
    (lazy given-number (== (call operand-kind given) .operand-number))
    (lazy given-bits (. ([] (. ir numbers) (call operand-payload given)) bits))
    (let left (call materialize ir ([] (. ir operands) (. row operands start))))
    (let right (call materialize ir given))
    (if (or (== op .arithmetic-divide) (== op .arithmetic-remainder))
      (= left (call whole left (. row layout)))
      (= right (call whole right (. row layout)))
    )
    (let value (call new-value (. row layout) false))
    (= ([] values id) value)
    (if (call is-float (. row layout))
      (let opcode (. Opcode fadd))
      (if (== op .arithmetic-subtract)
        (= opcode .fsub)
        (else-if (== op .arithmetic-multiply)
          (= opcode .fmul)
        )
        (else-if (== op .arithmetic-divide)
          (= opcode .fdiv)
        )
      )
      (throw (call Panic "The remainder of two floats is not a machine operation") (if (== op .arithmetic-remainder)))
      (call (. builder asm) opcode value left right)
      (return)
    )
    (let divide (if-expr (call is-signed (. row layout)) (. Opcode sdiv) (. Opcode udiv)))
    (if (== op .arithmetic-remainder)
      (let reg-class (call layout-class (. row layout)))
      (let quotient (call (. builder vreg) reg-class))
      (let product (call (. builder vreg) reg-class))
      (call (. builder asm) divide quotient left right)
      (call (. builder asm) .mul product quotient right)
      (call (. builder asm) .sub value left product)
      (return)
    )
    (let opcode (. Opcode add))
    (if (== op .arithmetic-subtract)
      (= opcode .sub)
      (else-if (== op .arithmetic-multiply)
        (= opcode .mul)
      )
      (else-if (== op .arithmetic-divide)
        (= opcode divide)
      )
    )
    (call (. builder asm) opcode value left right)
  )
  (fn-do _ lower-by-power-of-two Bool
    (param ir IRFunction)
    (param id ValueId)
    (param row IRInstruction)
    (param op ArithmeticOp)
    (param divisor U64)
    ; A remainder by a power of two, or a signed division by one, without dividing. An unsigned
    ; remainder keeps the low bits. A signed dividend that is negative first gains one less than the
    ; divisor, so the shift rounds toward zero as the division does, and the remainder is what that
    ; rounded quotient leaves. An integer narrower than a register is left to the division.
    (let size (. ([] (. tables layouts rows) (. row layout)) size))
    (if (and (!= size 4) (!= size 8))
      (return false)
    )
    (let width (* (as size U64) 8))
    (let signed (call is-signed (. row layout)))
    (if (or (< divisor 2) (!= (/and/ divisor (- divisor 1)) 0) (>= divisor (/lshift/ 1u64 (- width 1))))
      (return false)
    )
    (if (and (!= op .arithmetic-remainder) (or (!= op .arithmetic-divide) (not signed)))
      (return false)
    )
    (let shift U64)
    (while (!= (/lshift/ 1u64 shift) divisor)
      (+= shift 1)
    )
    (let left (call materialize ir ([] (. ir operands) (. row operands start))))
    (let value (call new-value (. row layout) false))
    (= ([] values id) value)
    (if (not signed)
      (call (. builder asm) .and value left (call (. builder small-int) (as (- divisor 1) I64)))
      (return true)
    )
    (let reg-class (call layout-class (. row layout)))
    (let bias (call (. builder vreg) reg-class))
    (if (== shift 1)
      (call (. builder asm) .lsr bias left (call (. builder small-int) (as (- width 1) I64)))
      (else
        (let sign (call (. builder vreg) reg-class))
        (call (. builder asm) .asr sign left (call (. builder small-int) (as (- width 1) I64)))
        (call (. builder asm) .lsr bias sign (call (. builder small-int) (as (- width shift) I64)))
      )
    )
    (let biased (call (. builder vreg) reg-class))
    (call (. builder asm) .add biased left bias)
    (if (== op .arithmetic-divide)
      (call (. builder asm) .asr value biased (call (. builder small-int) (as shift I64)))
      (return true)
    )
    (let mask (/and/ (/lshift/ (. U64 max) shift) (/zrshift/ (. U64 max) (- 64 width))))
    (let rounded (call (. builder vreg) reg-class))
    (call (. builder asm) .and rounded biased (call (. builder small-int) (as mask I64)))
    (call (. builder asm) .sub value left rounded)
    (return true)
  )
  (fn-do _ lower-bitwise _
    (param ir IRFunction)
    (param id ValueId)
    (param row IRInstruction)
    ; A bitwise operator or a shift, done in a whole register. A value narrower than its register
    ; is first extended by its own sign, so a shift to the right moves in the bits its sign gives.
    (let left (call materialize ir ([] (. ir operands) (. row operands start))))
    (let right (call materialize ir ([] (. ir operands) (+ (. row operands start) 1))))
    (let value (call new-value (. row layout) false))
    (= ([] values id) value)
    (let op (as (. row aux) BitwiseOp))
    (if (or (== op .bitwise-shift-right) (== op .bitwise-shift-right-zero))
      (= left (call whole left (. row layout)))
    )
    (let opcode (. Opcode and))
    (if (== op .bitwise-or)
      (= opcode .orr)
      (else-if (== op .bitwise-xor)
        (= opcode .eor)
      )
      (else-if (== op .bitwise-shift-left)
        (= opcode .lslv)
      )
      (else-if (== op .bitwise-shift-right)
        (= opcode .asrv)
      )
      (else-if (== op .bitwise-shift-right-zero)
        (= opcode .lsrv)
      )
    )
    (call (. builder asm) opcode value left right)
  )
  (fn-do _ lower-negate _
    (param ir IRFunction)
    (param id ValueId)
    (param row IRInstruction)
    (let operand (call materialize ir ([] (. ir operands) (. row operands start))))
    (let value (call new-value (. row layout) false))
    (= ([] values id) value)
    (call (. builder asm) (if-expr (call is-float (. row layout)) (. Opcode fneg) (. Opcode neg)) value operand)
  )
  (fn-do _ lower-bitwise-not _
    (param ir IRFunction)
    (param id ValueId)
    (param row IRInstruction)
    (let operand (call materialize ir ([] (. ir operands) (. row operands start))))
    (let value (call new-value (. row layout) false))
    (= ([] values id) value)
    (call (. builder asm) .mvn value operand)
  )
  (fn-do _ lower-compare _
    (param ir IRFunction)
    (param id ValueId)
    (param row IRInstruction)
    ; Compares two values of one layout and gives one or zero. Integers narrower than a register
    ; are compared whole, and the layout's sign and kind choose the condition.
    (let first ([] (. ir operands) (. row operands start)))
    (let second ([] (. ir operands) (+ (. row operands start) 1)))
    (let layout (call (. ir operand-layout) first))
    (let is-real (call is-float layout))
    (let predicate (as (. row aux) ComparePredicate))
    (if (and (not is-real) (call is-small-number ir first layout) (not (call is-small-number ir second layout)))
      (= first second)
      (= second ([] (. ir operands) (. row operands start)))
      (= predicate (call mirrored predicate))
    )
    (let left (call materialize ir first))
    (let value (call new-value (. row layout) false))
    (if is-real
      (call (. builder asm)
        (block
          (arg (if-expr (== layout f32-layout) (. Opcode fcmps) (. Opcode fcmpd)))
          (arg left)
          (arg (call materialize ir second))
        )
      )
      (else-if (call is-small-number ir second layout)
        (call (. builder asm)
          (block
            (arg .cmp)
            (arg (call whole left layout))
            (arg (call (. builder small-int) (as (. ([] (. ir numbers) (call operand-payload second)) bits) I64)))
          )
        )
      )
      (else
        (call (. builder asm) .cmp (call whole left layout) (call whole (call materialize ir second) layout))
      )
    )
    (= ([] values id) value)
    (let unsigned (and (not is-real) (not (call is-signed layout))))
    (let code (. ArmCondition equal))
    (if (== predicate .compare-not-equal)
      (= code (. ArmCondition not-equal))
      (else-if (== predicate .compare-greater)
        (= code (if-expr unsigned (. ArmCondition higher) (. ArmCondition greater)))
      )
      (else-if (== predicate .compare-greater-equal)
        (= code (if-expr unsigned (. ArmCondition higher-same) (. ArmCondition greater-equal)))
      )
      (else-if (== predicate .compare-less)
        (= code (. ArmCondition less))
        (if is-real
          (= code (. ArmCondition minus))
          (else-if unsigned
            (= code (. ArmCondition lower))
          )
        )
      )
      (else-if (== predicate .compare-less-equal)
        (= code (if-expr (or is-real unsigned) (. ArmCondition lower-same) (. ArmCondition less-equal)))
      )
    )
    (call (. builder asm) .cset value (call (. builder add-operand) (call CondOperand code)))
  )
  (fn-expr _ is-small-number Bool
    (param ir IRFunction)
    (param operand Operand)
    (param layout LayoutId)
    (and (== (call operand-kind operand) .operand-number) (<= number-bits (if-expr is-byte 127u64 4095u64)))
    (where
      (lazy number-bits (. ([] (. ir numbers) (call operand-payload operand)) bits))
      (lazy is-byte (== (. ([] (. tables layouts rows) layout) size) 1))
    )
  )
  (fn-expr _ mirrored ComparePredicate
    (param predicate ComparePredicate)
    (match predicate
      (case= .compare-greater
        .compare-less
      )
      (case= .compare-greater-equal
        .compare-less-equal
      )
      (case= .compare-less
        .compare-greater
      )
      (case= .compare-less-equal
        .compare-greater-equal
      )
      (default
        predicate
      )
    )
  )
  (fn-do _ lower-float-math _
    (param ir IRFunction)
    (param id ValueId)
    (param row IRInstruction)
    ; A square root, an absolute value, or the lesser or greater of two floats. The lesser or
    ; greater compares the second with the first and takes the second when the comparison gives
    ; it, so the first is taken when either is not a number.
    (let first (call materialize ir ([] (. ir operands) (. row operands start))))
    (let op (as (. row aux) FloatMath))
    (if (or (== op .float-sqrt) (== op .float-abs))
      (let value (call new-value (. row layout) false))
      (= ([] values id) value)
      (call (. builder asm) (if-expr (== op .float-sqrt) (. Opcode fsqrt) (. Opcode fabs)) value first)
      (return)
    )
    (let second (call materialize ir ([] (. ir operands) (+ (. row operands start) 1))))
    (call (. builder asm) .fcmpd second first)
    (let value (call new-value (. row layout) false))
    (= ([] values id) value)
    (let code (if-expr (== op .float-max) (. ArmCondition greater) (. ArmCondition minus)))
    (call (. builder asm) .fcsel value second first (call (. builder add-operand) (call CondOperand code)))
  )
  (fn-do _ whole OperandId
    (param value OperandId)
    (param layout LayoutId)
    ; An integer narrower than a register, extended to the register by its own sign.
    (let size (. ([] (. tables layouts rows) layout) size))
    (if (or (>= size 4) (call is-float layout))
      (return value)
    )
    (let extended (call (. builder vreg) .gpr32))
    (call extend extended value size (call is-signed layout))
    (return extended)
  )
  (fn-do _ lower-num-cast _
    (param ir IRFunction)
    (param id ValueId)
    (param row IRInstruction)
    ; A number as another kind of number.
    ; Between integers, the same bits at another width:
    ; - a wider target extends the source from its width, with its sign when both have one;
    ; - a target narrower than a register is extended from its own width;
    ; - any other target takes the source's low bits.
    ; An integer becomes a float by its own sign, a float becomes an integer by the target's sign
    ; and loses its fraction, and a float changes width.
    (let operand ([] (. ir operands) (. row operands start)))
    (let source (call (. ir operand-layout) operand))
    (let given (call materialize ir operand))
    (let value (call new-value (. row layout) false))
    (= ([] values id) value)
    (if (== (. row layout) managed-layout)
      (= ([] heaps id) 1)
    )
    (let source-size (. ([] (. tables layouts rows) source) size))
    (let target-size (. ([] (. tables layouts rows) (. row layout)) size))
    (if (call is-float (. row layout))
      (if (call is-float source)
        (call (. builder asm) (if-expr (== source (. row layout)) (. Opcode fmov) (. Opcode fcvt)) value given)
        (else
          (call (. builder asm)
            (block
              (arg (if-expr (call is-signed source) (. Opcode scvtf) (. Opcode ucvtf)))
              (arg value)
              (arg (call whole given source))
            )
          )
        )
      )
      (return)
    )
    (if (call is-float source)
      (let convert (if-expr (call is-signed (. row layout)) (. Opcode fcvtzs) (. Opcode fcvtzu)))
      (if (< target-size 4)
        (let cut (call (. builder vreg) .gpr32))
        (call (. builder asm) convert cut given)
        (call extend value cut target-size (call is-signed (. row layout)))
        (else
          (call (. builder asm) convert value given)
        )
      )
      (return)
    )
    (if (< source-size target-size)
      (call extend value given source-size (call is-signed source))
      (else-if (< target-size 4)
        (call extend value (call (. builder narrow-view) given) target-size (call is-signed (. row layout)))
      )
      (else
        (call (. builder mov) value (if-expr (== target-size 8) given (call (. builder narrow-view) given)))
      )
    )
  )
  (fn-do _ extend _
    (param dest OperandId)
    (param src OperandId)
    (param size U32)
    (param is-signed Bool)
    ; Extends the low `size` bytes of a register to the whole of another.
    (let opcode (. Opcode uxtw))
    (if (== size 1)
      (= opcode (if-expr is-signed (. Opcode sxtb) (. Opcode uxtb)))
      (else-if (== size 2)
        (= opcode (if-expr is-signed (. Opcode sxth) (. Opcode uxth)))
      )
      (else-if is-signed
        (= opcode .sxtw)
      )
    )
    (call (. builder asm) opcode dest src)
  )
  (fn-do _ lower-load _
    (param ir IRFunction)
    (param id ValueId)
    (param row IRInstruction)
    (let operand ([] (. ir operands) (. row operands start)))
    (let value (call new-value (. row layout) false))
    (= ([] values id) value)
    (if (== (. row layout) managed-layout)
      (= ([] heaps id) 1)
    )
    (let leaf (call split-leaf operand (. row aux)))
    (if (!= leaf (. U32 max))
      (call (. builder load) value ([] leaf-cells leaf) (call mir-type (. row layout)))
      (return)
    )
    (let base (call materialize ir operand))
    (call (. builder load) value (call (. builder load-address-offset) base (. row aux)) (call mir-type (. row layout)))
  )
  (fn-do _ lower-store _
    (param ir IRFunction)
    (param row IRInstruction)
    ; Writes a value to a place. A managed pointer written into an object goes through the write
    ; barrier first, which is given the place and the pointer.
    (let operand ([] (. ir operands) (+ (. row operands start) 1)))
    (let value (call materialize ir operand))
    (let offset (/and/ (. row aux) aux-payload-mask))
    (let type (call mir-type (call (. ir operand-layout) operand)))
    (let leaf (call split-leaf ([] (. ir operands) (. row operands start)) offset))
    (if (!= leaf (. U32 max))
      (call (. builder store) ([] leaf-cells leaf) value type)
      (return)
    )
    (let base (call materialize ir ([] (. ir operands) (. row operands start))))
    (if (== (/and/ (. row aux) managed-store-flag) 0)
      (call (. builder store) (call (. builder load-address-offset) base offset) value type)
      (return)
    )
    (let place (call (. builder vreg-operand) (call (. builder new-vreg) .gpr64 no-register true)))
    (call (. builder add-pointer) place (call (. builder load-address-offset) base offset))
    (call (. builder gc-barrier) place value (call location ir row))
    (call (. builder store) place value type)
  )
  (fn-do _ lower-load-acquire _
    (param ir IRFunction)
    (param id ValueId)
    (param row IRInstruction)
    ; Reads an integer from a place with acquire ordering: what its writer stored before the
    ; release store that wrote it is seen by every read that follows.
    (let value (call new-value (. row layout) false))
    (= ([] values id) value)
    (let base (call materialize ir ([] (. ir operands) (. row operands start))))
    (call (. builder load-acquire) value (call (. builder load-address-offset) base (. row aux)) (call mir-type (. row layout)))
  )
  (fn-do _ lower-store-release _
    (param ir IRFunction)
    (param row IRInstruction)
    ; Writes an integer to a place with release ordering: after every store before it.
    (let operand ([] (. ir operands) (+ (. row operands start) 1)))
    (let value (call materialize ir operand))
    (let base (call materialize ir ([] (. ir operands) (. row operands start))))
    (call (. builder store-release)
      (block
        (arg (call (. builder load-address-offset) base (. row aux)))
        (arg value)
        (arg (call mir-type (call (. ir operand-layout) operand)))
      )
    )
  )
  (fn-do _ lower-inlined-name _
    (param ir IRFunction)
    (param id ValueId)
    (param row IRInstruction)
    (let fallback (call materialize ir ([] (. ir operands) (+ (. row operands start) 1))))
    (let value (call new-value (. row layout) false))
    (= ([] values id) value)
    (if (== (. row aux) 0)
      (call (. builder mov) value fallback)
      (return)
    )
    (call (. builder asm) .inlined-name value (call materialize ir ([] (. ir operands) (. row operands start))) fallback)
  )
  (fn-do _ lower-load-local _
    (param id ValueId)
    (param row IRInstruction)
    (let value (call new-value (. row layout) false))
    (= ([] values id) value)
    (if (== (. row layout) managed-layout)
      (= ([] heaps id) 1)
    )
    (call (. builder load) value ([] cells (. row aux)) (call mir-type (. row layout)))
  )
  (fn-do _ lower-store-local _
    (param ir IRFunction)
    (param row IRInstruction)
    ; Writes a value to a local the frame holds. The frame is not in the heap, so no store to it
    ; takes a barrier.
    (if (== ([] kept (. row aux)) 0)
      (return)
    )
    (let operand ([] (. ir operands) (. row operands start)))
    (call (. builder store) ([] cells (. row aux)) (call materialize ir operand) (call mir-type (. ([] (. ir locals) (. row aux)) layout)))
  )
  (fn-do _ lower-local-address _
    (param id ValueId)
    (param row IRInstruction)
    ; The address of a local's place in the frame.
    (if (and (!= ([] split-roots id) 0) (!= ([] root-ok (- ([] split-roots id) 1)) 0))
      (= ([] values id) no-operand)
      (return)
    )
    (let value (call new-value (. row layout) false))
    (= ([] values id) value)
    (if (== (. row layout) managed-layout)
      (= ([] heaps id) 1)
    )
    (call (. builder add-pointer) value ([] cells (. row aux)))
  )
  (fn-do _ lower-count-leading-zeros _
    (param ir IRFunction)
    (param id ValueId)
    (param row IRInstruction)
    ; How many of an integer's highest bits are zero, counted within the integer's own width,
    ; which the instruction gives in bits. One narrower than a register is extended with zeros
    ; first, and the bits the register adds are taken off the count.
    (let operand ([] (. ir operands) (. row operands start)))
    (let size (. ([] (. tables layouts rows) (call (. ir operand-layout) operand)) size))
    (let bits (. row aux))
    (let given (call materialize ir operand))
    (let is-wide (== size 8))
    (let source given)
    (if (< size 4)
      (= source (call (. builder vreg) .gpr32))
      (call extend source given size false)
    )
    (let count (call (. builder vreg) (if-expr is-wide (. RegClass gpr64) (. RegClass gpr32))))
    (call (. builder asm) .clz count source)
    (if (< bits 32)
      (call (. builder asm) .sub count count (call (. builder small-int) (- 32 bits)))
    )
    (let value (call new-value (. row layout) false))
    (= ([] values id) value)
    (let returns-wide (== (. ([] (. tables layouts rows) (. row layout)) size) 8))
    (if (== returns-wide is-wide)
      (call (. builder mov) value count)
      (else-if returns-wide
        (call (. builder asm) .uxtw value count)
      )
      (else
        (call (. builder mov) value (call (. builder narrow-view) count))
      )
    )
  )
  (fn-do _ lower-address _
    (param ir IRFunction)
    (param id ValueId)
    (param row IRInstruction)
    ; The address of a place inside a base. One inside an object keeps the object alive.
    (if (and (!= ([] split-roots id) 0) (!= ([] root-ok (- ([] split-roots id) 1)) 0))
      (= ([] values id) no-operand)
      (return)
    )
    (let operand ([] (. ir operands) (. row operands start)))
    (let base (call materialize ir operand))
    (let inside (call is-heap ir operand))
    (let value (call new-value (. row layout) inside))
    (= ([] values id) value)
    (if (or inside (== (. row layout) managed-layout))
      (= ([] heaps id) 1)
    )
    (call (. builder add-pointer) value (call (. builder load-address-offset) base (. row aux)))
  )
  (fn-do _ lower-frame _
    (param id ValueId)
    (param row IRInstruction)
    ; Memory in the frame for a struct. When the struct holds managed pointers the collector
    ; scans it in place, from the moment the function is entered.
    (if (!= ([] root-ok (- ([] split-roots id) 1)) 0)
      (= ([] values id) no-operand)
      (return)
    )
    (let layout (as (. row aux) LayoutId))
    (let descriptor (call stack-descriptor layout))
    (let mode (if-expr (== descriptor no-string) (. GCRootMode value-root) (. GCRootMode address-root)))
    (let slot (call (. builder frame-slot)))
    (let is-root (!= descriptor no-string))
    (let object (call (. builder add-frame-object) slot (call mir-type layout) 0 false is-root descriptor mode))
    (let value (call (. builder vreg) .gpr64))
    (= ([] values id) value)
    (call (. builder add-pointer) value (call (. builder frame-object-operand) object))
  )
  (fn-do _ lower-copy _
    (param ir IRFunction)
    (param row IRInstruction)
    ; Copies a struct from one place to another. A copy into an object tells the collector first
    ; which managed pointers it is about to write, and a split struct copied there is built in
    ; memory first, so that the collector is told of it whole.
    (let layout (as (/and/ (. row aux) aux-payload-mask) LayoutId))
    (let target-operand ([] (. ir operands) (. row operands start)))
    (let source-operand ([] (. ir operands) (+ (. row operands start) 1)))
    (let barriers (!= (/and/ (. row aux) managed-store-flag) 0))
    (if (or (call is-split target-operand) (and (call is-split source-operand) (not barriers)))
      (call copy-split ir target-operand source-operand layout)
      (return)
    )
    (let target (call materialize ir target-operand))
    (let source no-operand)
    (if (call is-split source-operand)
      (= source (call rebuild source-operand layout))
      (else
        (= source (call materialize ir source-operand))
      )
    )
    (let size (. ([] (. tables layouts rows) layout) size))
    (if barriers
      (let descriptor (call (. builder symbol) (call descriptor-of layout)))
      (call (. builder gc-barrier) target source (call location ir row) (call (. builder small-int) size) descriptor)
    )
    (call (. builder copy-memory) target source size)
  )
  (fn-do _ lower-zero _
    (param ir IRFunction)
    (param row IRInstruction)
    (let operand ([] (. ir operands) (. row operands start)))
    (if (call is-split operand)
      (call zero-split operand (. row aux))
      (return)
    )
    (let target (call materialize ir operand))
    (call (. builder zero-memory) target (. ([] (. tables layouts rows) (as (. row aux) LayoutId)) size))
  )
  (fn-do _ plan-splits _
    (param ir IRFunction)
    (let arena (. builder function arena))
    (let count U32 (as (. ir instructions length) U32))
    (let locals U32 (as (. ir locals length) U32))
    (let given U32 (. ir arguments length))
    (let roots (+ locals count given))
    (= arg-roots (call (of (. arena allocate) U32) (+ given 1)))
    (for (in position (..< 0 given))
      (= ([] arg-roots position) 0)
    )
    (= split-roots (call (of (. arena allocate) U32) (+ count 1)))
    (= split-offsets (call (of (. arena allocate) U32) (+ count 1)))
    (= root-layouts (call (of (. arena allocate) U32) (+ roots 1)))
    (= root-ok (call (of (. arena allocate) Byte) (+ roots 1)))
    (= root-first (call (of (. arena allocate) U32) (+ roots 1)))
    (= root-count (call (of (. arena allocate) U32) (+ roots 1)))
    (= root-loads (call (of (. arena allocate) U32) (+ roots 1)))
    (= root-calls (call (of (. arena allocate) U32) (+ roots 1)))
    (for (in id (..< 0 count))
      (= ([] split-roots id) 0)
      (= ([] split-offsets id) 0)
    )
    (for (in root (..< 0 roots))
      (= ([] root-ok root) 0)
      (= ([] root-layouts root) void-layout)
      (= ([] root-first root) 0)
      (= ([] root-count root) 0)
      (= ([] root-loads root) 0)
      (= ([] root-calls root) 0)
    )
    (for (in id (..< 0 locals))
      (let local ([] (. ir locals) id))
      (if (and (!= ([] kept id) 0) (not (. local address-taken)) (not (. local filled)) holds-struct)
        (= ([] root-layouts id) (. local layout))
        (= ([] root-ok id) 1)
      )
      (lazy holds-struct (call (. tables layouts is-struct) (. local layout)))
    )
    (for (in position (..< 0 given))
      (let layout (as ([] (. ir arguments) position) LayoutId))
      (if (and (call (. tables layouts is-struct) layout) (not (call (. tables layouts is-large) layout)) has-size)
        (= ([] root-layouts (+ locals count position)) layout)
        (= ([] root-ok (+ locals count position)) 1)
        (= ([] arg-roots position) (+ locals count position 1))
      )
      (lazy has-size (!= (. ([] (. tables layouts rows) layout) size) 0))
    )
    (for (in id (..< 0 count))
      (let row ([] (. ir instructions) id))
      (if (== (. row op) .op-frame)
        (= ([] root-layouts (+ locals id)) (. row aux))
        (= ([] root-ok (+ locals id)) 1)
        (= ([] split-roots id) (+ locals id 1))
        (else-if (and (== (. row op) .op-call) small-struct (!= (. ([] (. tables layouts rows) (. row layout)) size) 0))
          (= ([] root-layouts (+ locals id)) (. row layout))
          (= ([] root-ok (+ locals id)) 1)
          (= ([] split-roots id) (+ locals id 1))
        )
        (else-if (and (== (. row op) .op-local-address) (!= ([] root-ok (. row aux)) 0))
          (= ([] split-roots id) (+ (. row aux) 1))
        )
        (else-if (== (. row op) .op-address)
          (let base ([] (. ir operands) (. row operands start)))
          (if (!= (call root-of base) 0)
            (= ([] split-roots id) (call root-of base))
            (= ([] split-offsets id) (+ (call offset-of base) (. row aux)))
          )
        )
      )
      (lazy small-struct (and (call (. tables layouts is-struct) (. row layout)) (not (call (. tables layouts is-large) (. row layout)))))
    )
    (let total U32)
    (for (in root (..< 0 roots))
      (if (!= ([] root-ok root) 0)
        (let leaves (call leaf-count ([] root-layouts root)))
        (if (or (== leaves (. U32 max)) (== leaves 0))
          (= ([] root-ok root) 0)
          (else
            (= ([] root-first root) total)
            (= ([] root-count root) leaves)
            (+= total leaves)
          )
        )
      )
    )
    (= leaf-offsets (call (of (. arena allocate) U32) (+ total 1)))
    (= leaf-layouts (call (of (. arena allocate) U32) (+ total 1)))
    (= leaf-cells (call (of (. arena allocate) U32) (+ total 1)))
    (for (in root (..< 0 roots))
      (if (!= ([] root-ok root) 0)
        (call fill-leaves ([] root-layouts root) 0 ([] root-first root))
      )
    )
    (for (in position (..< 0 given))
      (let root ([] arg-roots position))
      (if (and (!= root 0) (not (call packs (- root 1) 0 ([] root-layouts (- root 1)))))
        (= ([] root-ok (- root 1)) 0)
      )
    )
    (for (in id (..< 0 count))
      (if (and is-call (!= ([] split-roots id) 0) (not (call packs (+ locals id) 0 ([] root-layouts (+ locals id)))))
        (= ([] root-ok (+ locals id)) 0)
      )
      (lazy is-call (== (. ([] (. ir instructions) id) op) .op-call))
    )
    (for (in id (..< 0 count))
      (let row ([] (. ir instructions) id))
      (if (and (or (== (. row op) .op-load-local) (== (. row op) .op-store-local)) (< (. row aux) locals))
        (= ([] root-ok (. row aux)) 0)
      )
      (for (in position (..< (. row operands start) (. row operands end)))
        (let operand ([] (. ir operands) position))
        (let root (call root-of operand))
        (if (and (!= root 0) (not (call splits-use ir id row (- position (. row operands start)) operand)))
          (= ([] root-ok (- root 1)) 0)
        )
      )
    )
    (for (in root (..< 0 roots))
      (if (> ([] root-calls root) ([] root-loads root))
        (= ([] root-ok root) 0)
      )
    )
  )
  (fn-do _ leaf-count U32
    (param layout LayoutId)
    (if (not (call (. tables layouts is-struct) layout))
      (return (if-expr (== layout void-layout) 0 1))
    )
    (let row ([] (. tables layouts rows) layout))
    (if (!= (. row cases count) 0)
      (return (. U32 max))
    )
    (let total U32)
    (for (in position (..< (. row fields start) (. row fields end)))
      (let inner (call leaf-count (. ([] (. tables layouts fields) position) layout)))
      (if (== inner (. U32 max))
        (return (. U32 max))
      )
      (+= total inner)
    )
    (return total)
  )
  (fn-do _ fill-leaves U32
    (param layout LayoutId)
    (param offset U32)
    (param next U32)
    (if (not (call (. tables layouts is-struct) layout))
      (if (== layout void-layout)
        (return next)
      )
      (= ([] leaf-offsets next) offset)
      (= ([] leaf-layouts next) layout)
      (= ([] leaf-cells next) no-operand)
      (return (+ next 1))
    )
    (let row ([] (. tables layouts rows) layout))
    (let spot next)
    (for (in position (..< (. row fields start) (. row fields end)))
      (let field ([] (. tables layouts fields) position))
      (= spot (call fill-leaves (. field layout) (+ offset (. field offset)) spot))
    )
    (return spot)
  )
  (fn-do _ find-leaf U32
    (param root U32)
    (param offset U32)
    (param layout LayoutId)
    (let first ([] root-first root))
    (for (in leaf (..< first (+ first ([] root-count root))))
      (if (== ([] leaf-offsets leaf) offset)
        (return (if-expr (== ([] leaf-layouts leaf) layout) leaf (. U32 max)))
      )
    )
    (return (. U32 max))
  )
  (fn-do _ covers Bool
    (param root U32)
    (param offset U32)
    (param layout LayoutId)
    (if (not (call (. tables layouts is-struct) layout))
      (return (or (== layout void-layout) (!= (call find-leaf root offset layout) (. U32 max))))
    )
    (let row ([] (. tables layouts rows) layout))
    (if (!= (. row cases count) 0)
      (return false)
    )
    (for (in position (..< (. row fields start) (. row fields end)))
      (let field ([] (. tables layouts fields) position))
      (if (not (call covers root (+ offset (. field offset)) (. field layout)))
        (return false)
      )
    )
    (return true)
  )
  (fn-do _ splits-use Bool
    (param ir IRFunction)
    (param id ValueId)
    (param row IRInstruction)
    (param index U32)
    (param operand Operand)
    (let root (- (call root-of operand) 1))
    (let offset (call offset-of operand))
    (match? (. row op)
      (case= .op-load
        (+= ([] root-loads root) 1)
        (return
          (scope (and (== index 0) (not (call (. tables layouts is-struct) (. row layout))) has-leaf)
            (lazy has-leaf (!= (call find-leaf root (+ offset (. row aux)) (. row layout)) (. U32 max)))
          )
        )
      )
      (case= .op-call
        (return (and (!= index 0) (call passes root offset (call (. ir operand-layout) operand))))
      )
      (case= .op-call-void
        (return (and (!= index 0) (call passes root offset (call (. ir operand-layout) operand))))
      )
      (case= .op-return
        (return (and (== index 0) (call passes root offset (. ir returns))))
      )
      (case= .op-store
        (if (!= index 0)
          (return false)
        )
        (let stored (call (. ir operand-layout) ([] (. ir operands) (+ (. row operands start) 1))))
        (return
          (scope (and (not (call (. tables layouts is-struct) stored)) (!= (call find-leaf root field-offset stored) (. U32 max)))
            (lazy field-offset (+ offset (/and/ (. row aux) aux-payload-mask)))
          )
        )
      )
      (case= .op-copy
        (if (and (== index 1) (!= (/and/ (. row aux) managed-store-flag) 0))
          (+= ([] root-calls root) 1)
        )
        (return (call covers root offset (/and/ (. row aux) aux-payload-mask)))
      )
      (case= .op-zero
        (return (and (== index 0) (call covers root offset (. row aux))))
      )
      (case= .op-address
        (return (and (== index 0) (!= ([] split-roots id) 0)))
      )
    )
    (return false)
  )
  (fn-do _ passes Bool
    (param root U32)
    (param offset U32)
    (param layout LayoutId)
    ; Whether a split struct can be passed to a call or returned. One that cannot travel in its
    ; registers straight from its fields is built in memory first, which counts against
    ; splitting it.
    (if (or (not (call (. tables layouts is-struct) layout)) is-empty (not (call covers root offset layout)))
      (return false)
    )
    (lazy is-empty (== (. ([] (. tables layouts rows) layout) size) 0))
    (if (not (call packs root offset layout))
      (+= ([] root-calls root) 1)
    )
    (return true)
  )
  (fn-do _ rebuild OperandId
    (param operand Operand)
    (param layout LayoutId)
    (let size (. ([] (. tables layouts rows) layout) size))
    (let descriptor (call stack-descriptor layout))
    (let mode (if-expr (== descriptor no-string) (. GCRootMode value-root) (. GCRootMode address-root)))
    (let object
      (call (. builder add-frame-object)
        (block
          (arg (call (. builder frame-slot)))
          (arg (call mir-type layout))
          (arg 0)
          (arg false)
          (arg (!= descriptor no-string))
          (arg descriptor)
          (arg mode)
        )
      )
    )
    (let place (call (. builder vreg) .gpr64))
    (call (. builder add-pointer) place (call (. builder frame-object-operand) object))
    (let root (- (call root-of operand) 1))
    (let base (call offset-of operand))
    (let first ([] root-first root))
    (for (in leaf (..< first (+ first ([] root-count root))))
      (let spot ([] leaf-offsets leaf))
      (if (and (>= spot base) (< spot (+ base size)))
        (let part ([] leaf-layouts leaf))
        (let type (call mir-type part))
        (let held (call new-value part false))
        (call (. builder load) held ([] leaf-cells leaf) type)
        (call (. builder store) (call (. builder load-address-offset) place (- spot base)) held type)
      )
    )
    (return place)
  )
  (fn-do _ add-leaves _
    (param root U32)
    (let function (. builder function))
    (let first ([] root-first root))
    (for (in leaf (..< first (+ first ([] root-count root))))
      (let layout ([] leaf-layouts leaf))
      (let is-root (== layout managed-layout))
      (let object
        (call (. builder add-frame-object)
          (block
            (arg (call (. builder frame-slot)))
            (arg (call mir-type layout))
            (arg 0)
            (arg true)
            (arg is-root)
            (arg no-string)
            (arg (. GCRootMode value-root))
          )
        )
      )
      (= (. function vars) (call (. function vars appended) (. function arena) object))
      (= ([] leaf-cells leaf) (call (. builder frame-object-operand) object))
    )
  )
  (fn-expr _ is-split Bool
    (param operand Operand)
    (and (!= root 0) (!= ([] root-ok (- root 1)) 0))
    (where
      (lazy root (call root-of operand))
    )
  )
  (fn-expr _ root-of U32
    (param operand Operand)
    (match (call operand-kind operand)
      (case= .operand-value
        ([] split-roots (call operand-payload operand))
      )
      (case= .operand-argument
        ([] arg-roots (call operand-payload operand))
      )
      (default
        0
      )
    )
  )
  (fn-expr _ offset-of U32
    (param operand Operand)
    (if-expr (== (call operand-kind operand) .operand-value) ([] split-offsets (call operand-payload operand)) 0)
  )
  (fn-do _ packs Bool
    (param root U32)
    (param base U32)
    (param layout LayoutId)
    ; Whether the fields of a split struct small enough for registers can travel in its registers
    ; without memory between: each float of a struct of floats in a register of its own, or else
    ; integers and pointers that each lie inside one word.
    (if (or (not (call (. tables layouts is-struct) layout)) (call (. tables layouts is-large) layout) is-empty)
      (return false)
    )
    (lazy is-empty (== (. ([] (. tables layouts rows) layout) size) 0))
    (let size (. ([] (. tables layouts rows) layout) size))
    (let count (call (. builder struct-parts) (call mir-type layout)))
    (let reg-class (call (. builder type-reg-class) ([] (. builder part-types) 0)))
    (let is-floats (or (== reg-class .fpr32) (== reg-class .fpr64)))
    (let found U32)
    (let words U32)
    (let first ([] root-first root))
    (for (in leaf (..< first (+ first ([] root-count root))))
      (let spot ([] leaf-offsets leaf))
      (if (and (>= spot base) (< spot (+ base size)))
        (let inside (- spot base))
        (let width (. ([] (. tables layouts rows) ([] leaf-layouts leaf)) size))
        (if is-floats
          (if (or (>= found count) (!= ([] (. builder part-offsets) found) inside) width-differs)
            (return false)
          )
          (lazy width-differs (!= (. ([] (. builder function types) ([] (. builder part-types) found)) size) width))
          (else-if (or (call is-float ([] leaf-layouts leaf)) odd-width (!= (/ inside 8) (/ (- (+ inside width) 1) 8)))
            (return false)
          )
          (else
            (= words (/or/ words (/lshift/ 1u32 (/ inside 8))))
          )
        )
        (lazy odd-width (and (!= width 1) (!= width 2) (!= width 4) (!= width 8)))
        (+= found 1)
      )
    )
    (if is-floats
      (return (== found count))
    )
    (return (== words (- (/lshift/ 1u32 count) 1)))
