(import ./emitter)
(import ./layouts)
(import ./program-tables)
(import ./receiver-stability)
(import ./runtime)
(import ./table-layouts)
(import /core/arena)
(import /core/table)
(import /lang/ast/ast)
(import /lang/ast/ast-children)
(import /lang/ast/ast-nodes)
(import /lang/ast/decl)
(import /lang/ast/module)
(import /lang/ast/operator)
(import /lang/ast/program)
(import /lang/ast/row-range)
(import /lang/ast/state-machines)
(import /lang/backend/mir)
(import /lang/check/binding)
(import /lang/check/claims)
(import /lang/check/facts)
(import /lang/check/instances)
(import /lang/check/machine-composite)
(import /lang/check/numeric)
(import /lang/check/pattern-helper)
(import /lang/check/probe-casts)
(import /lang/check/table-rows)
(import /lang/check/type-signature)
(import /lang/check/type-store)
(import /lang/check/type-text)
(import /lang/check/types)
(import /lang/ir/ir)
(import /stream/sort)

(type _ Tasks (facet-of FunctionEmitter)
  (fn-do + emit-task-body _
    ; The body of a spawned task: a function the runtime runs with the capture made where the
    ; task was spawned, and that returns to nothing. It runs `taskinit` where the program has
    ; one, then the body, flushes what it wrote of probes where they compile, and ends the task,
    ; where the body ends or returns. A task with handlers tries them where a panic ends it
    ; (`handle-failure`).
    (let row ([] (. instances rows) (. unit instance)))
    (let body SyntaxId 0)
    (let declared SyntaxId 0)
    (let handlers (call (of RowRange SyntaxId)))
    (match? ([] (. ([] (. program modules) (. row module)) decls) (. row decl))
      (case (call .decl-function fn)
        (= declared (. fn syntax))
        (match? ([] (. tree nodes) (. fn syntax))
          (case (call .node-do-task-block task)
            (= body (. task body))
            (= handlers (. task catchers))
          )
        )
      )
    )
    (if (or (== body 0) (== ([] (. tables captures) (. unit instance)) unbuilt-environment))
      (call refuse .refused-function declared)
      (return)
    )
    (= unit (= (. unit received) true))
    (= unit (= (. unit takes-self) true))
    (call (. ir add-argument) managed-layout)
    (= (. ir returns) void-layout)
    (if (!= (. tables task-init) no-function)
      (call call-function (. tables task-init) declared)
    )
    (call open-environment declared)
    (call share-self declared)
    (= task-leaving (call (. ir reserve-block)))
    (if (!= (. handlers count) 0)
      (= task-failing (call (. ir reserve-block)))
      (= task-handlers handlers)
    )
    (call emit-block body)
    (call jump task-leaving)
    (call (. ir start-block) task-leaving)
    (call set-task-end task-end-finished)
    (if (!= (. tables probe-flush) no-function)
      (call call-function (. tables probe-flush) declared)
    )
    (call call-runtime .runtime-terminate-active-task 0 (. pending length))
    (call return-nothing)
  )
  (fn-do + set-task-end _
    (param end U32)
    ; Tells the runtime how the task ends, which the `Task` a `do new` gave reads. The first it is
    ; told stands.
    (let mark (. pending length))
    (+= pending (call integer .machine-u32 end))
    (call call-runtime .runtime-set-task-end 0 mark)
  )
  (fn-do + emit-task-value Operand
    (param id SyntaxId)
    (param row ASTDoTaskBlock)
    ; The `Task` a `do new` used as a value gives: the task is spawned as one written as a statement
    ; is, but the runtime is asked for the record it keeps of how the task ends, which the function
    ; the type pass recorded at the node makes the value of.
    (let worker (if-expr (. row is-parallel) 0 (. row worker)))
    (let priority (== (. row scheduling) .task-scheduling-priority))
    (let ending (call emit-spawn id worker (. row is-parallel) priority (. row large-stack) true))
    (let callee (call task-value-callee id))
    (if (== callee no-instance)
      (call refuse .refused-expression id)
      (return (call make-operand .operand-void 0))
    )
    (let mark (. pending length))
    (+= pending ending)
    (return (. (call call-instance callee id mark) operand))
  )
  (fn-do _ task-value-callee InstanceId
    (param id SyntaxId)
    ; The function that makes the `Task` a `do new` used as a value gives, as the type pass
    ; recorded it at the node.
    (let fact (call (. facts first-call) (. unit reading) id))
    (while (!= fact no-fact)
      (if (== (. ([] (. facts calls) fact) form) .call-function)
        (return (. ([] (. facts calls) fact) callee))
      )
      (= fact (. ([] (. facts calls) fact) next))
    )
    (return no-instance)
  )
  (fn-do + emit-spawn Operand
    (param id SyntaxId)
    (param worker SyntaxId)
    (param parallel Bool)
    (param priority Bool)
    (param large-stack Bool)
    (param valued _ (= false))
    ; Spawns a task, given the capture `make-capture` makes for its body. The runtime is given the
    ; queue the worker named holds, where there is one, the body and its capture, the size of the
    ; memory a task holds its own globals in, the place the task was spawned at and how to run it.
    ; A `valued` spawn also asks for the record the runtime keeps of how the task ends, which it
    ; answers. A task an object owns is started with the object, which keeps it for its `close`
    ; to cancel.
    (let nothing (call make-operand .operand-void 0))
    (let callee (call task-callee id))
    (let body (if-expr (!= callee no-instance) ([] (. tables instance-functions) callee) no-function))
    (if (== body no-function)
      (call refuse .refused-statement id)
      (return nothing)
    )
    (let owned (call is-owned-task id))
    (let owner (if-expr owned (call task-owner id) nothing))
    (if (and owned (== (call operand-kind owner) .operand-void))
      (return nothing)
    )
    (let capture (call make-capture id callee))
    (let mark (. pending length))
    (if owned
      (+= pending (call num-cast id owner managed-layout pointer-layout))
    )
    (if (!= worker 0)
      (let queue (call emit-expression worker))
      (let held (call layout-of (. queue type) worker))
      (if (and (call (. tables layouts is-struct) held) (== (. ([] (. tables layouts rows) held) fields count) 1))
        (= queue (call Typed (call take (. queue operand) (call (. tables layouts field) held 0) worker) (. queue type)))
        (= held (. (call (. tables layouts field) held 0) layout))
      )
      (if (and (!= held pointer-layout) (!= held managed-layout))
        (call refuse .refused-statement worker)
        (return nothing)
      )
      (+= pending (. queue operand))
      (else
        (+= pending (call integer .machine-pointer 0))
      )
    )
    (call (. ir depend) .callee-function body 0)
    (+= pending (call make-operand .operand-symbol (. ([] (. tables functions) body) symbol)))
    (+= pending capture)
    (+= pending (call integer .machine-u64 (as (. tables task-local-size) U64)))
    (let path (. ([] (. program modules) (. unit source-module)) relative-path))
    (+= pending
      (call make-operand
        (block
          (arg .operand-constant)
          (arg (call (. ir add-string) (if-expr (!= (. path length) 0) path "no file")))
        )
      )
    )
    (let begin (. ([] (. tree nodes) id) loc begin))
    (+= pending (call integer .machine-u32 (+ (. begin line) 1)))
    (+= pending (call integer .machine-u32 (+ (. begin column) 1)))
    (let options U32)
    (if priority
      (= options (/or/ options task-start-priority))
    )
    (if parallel
      (= options (/or/ options task-start-spin))
    )
    (if large-stack
      (= options (/or/ options task-start-large-stack))
    )
    (if valued
      (= options (/or/ options task-start-handle))
    )
    (+= pending (call integer .machine-u32 options))
    (let start
      (block
        (case? owned
          (. RuntimeFunction runtime-start-owned-task)
        )
        (default
          (. RuntimeFunction runtime-start-task)
        )
      )
    )
    (return (call call-runtime start id mark pointer-layout))
  )
  (fn-do _ is-owned-task Bool
    (param id SyntaxId)
    ; Whether the type pass found the task spawned at a node owned by an object.
    (let fact (call (. facts first-call) (. unit reading) id))
    (while (!= fact no-fact)
      (if (== (. ([] (. facts calls) fact) form) .call-owned-task)
        (return true)
      )
      (= fact (. ([] (. facts calls) fact) next))
    )
    (return false)
  )
  (fn-do _ task-owner Operand
    (param site SyntaxId)
    ; The object that owns a task the type pass found owned: the innermost markup element being
    ; built, or else the `TaskOwner` of the activation of a case the binder gave it to, or else the
    ; receiver, as `own-callback` finds the owner of a live action. An activation that keeps no
    ; `TaskOwner` leaves the task owned by nothing.
    (let binding (. ([] (. instances rows) (. unit reading)) binding))
    (let tasks (call (. bindings activation-tasks) binding site (call (. program store-atom) "(tasks)")))
    (if (!= (. content-hosts length) 0)
      (let host ([] content-hosts (- (. content-hosts length) 1)))
      (if (call (. tables is-class) (. host type))
        (return (. host operand))
      )
      (else-if (!= tasks no-slot)
        (return (. (call read-captured tasks site (. (call find-captured tasks site) type)) operand))
      )
      (else-if (and (. unit has-self) (call (. tables is-class) (. unit owner-type)))
        (return (. unit self))
      )
    )
    (call refuse .refused-statement site)
    (return (call make-operand .operand-void 0))
  )
  (fn-do + task-holds Bool
    (param slot SlotId)
    ; Whether a local of a function further out is held in the capture of a spawned task's body
    ; that the function is, or is written in, as one the body copies. A lazy one is held there as
    ; the value the spawn evaluated, the body's own to change.
    (let home ([] (. tables slot-functions) slot))
    (let owner (. unit instance))
    (while (and (!= owner no-instance) (!= ([] (. tables instance-scopes) owner) home))
      (if (and (!= ([] (. tables capture-rows) owner) no-place) (call (. tables copies) owner slot))
        (return true)
      )
      (= owner (. ([] (. instances rows) owner) enclosing))
    )
    (return false)
  )
  (fn-do _ task-callee InstanceId
    (param id SyntaxId)
    ; The body of the task spawned at a node, as the type pass recorded it.
    (let fact (call (. facts first-call) (. unit reading) id))
    (while (!= fact no-fact)
      (if (call spawns-task (. ([] (. facts calls) fact) form))
        (return (. ([] (. facts calls) fact) callee))
      )
      (= fact (. ([] (. facts calls) fact) next))
    )
    (return no-instance)
  )
  (fn-do + task-locals Operand
    (param site SyntaxId)
    (return
      (call make-operand
        (block
          (arg .operand-value)
          (arg (call append .op-load-task-word site (call Span) task-locals-offset pointer-layout))
        )
      )
    )
  )
)
