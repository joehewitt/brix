(import ./emitter)
(import ./emitter.calls)
(import ./emitter.lazies)
(import ./emitter.live-actions)
(import ./emitter.loops)
(import ./emitter.state-machines)
(import ./emitter.streams)
(import ./emitter.tables)
(import ./layouts)
(import ./program-tables)
(import ./receiver-stability)
(import ./runtime)
(import ./table-layouts)
(import /core/arena)
(import /core/table)
(import /lang/ast/ast)
(import /lang/ast/ast-children)
(import /lang/ast/ast-nodes)
(import /lang/ast/ast-queries)
(import /lang/ast/decl)
(import /lang/ast/module)
(import /lang/ast/operator)
(import /lang/ast/program)
(import /lang/ast/row-range)
(import /lang/ast/state-machines)
(import /lang/backend/mir)
(import /lang/check/binding)
(import /lang/check/claims)
(import /lang/check/facts)
(import /lang/check/instances)
(import /lang/check/machine-composite)
(import /lang/check/numeric)
(import /lang/check/pattern-helper)
(import /lang/check/probe-casts)
(import /lang/check/table-rows)
(import /lang/check/type-signature)
(import /lang/check/type-store)
(import /lang/check/type-text)
(import /lang/check/types)
(import /lang/ir/ir)
(import /stream/sort)

(type _ MatchArms (facet-of FunctionEmitter)
  (sees Calls)
  (sees Lazies)
  (sees LiveActions)
  (sees Loops)
  (sees StateMachines)
  (sees Streams)
  (sees Tables)
  (prop _ switching _ (= false))
  (prop _ switched-subject Operand (= 0))
  (prop _ switched-value U64 (= 0))
  (prop _ refined-flag LocalId (= no-local))
  (prop _ refined-payload LocalId (= no-local))
  (fn-do + place-match Typed
    (param id SyntaxId)
    (param pattern SyntaxId)
    ; Where the struct a match with no subject answers lies, in an inlined body: its arms are tested
    ; in order, and the place the arm taken answers is the match's. Arms that end in no else have
    ; no shape here.
    (let nothing (call make-operand .operand-void 0))
    (let type (call (. facts node-type) (. unit reading) id))
    (let layout (call layout-of type id))
    (if (or (== pattern 0) (not (call (. tables layouts is-struct) layout)))
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (let joined (call (. ir reserve-block)))
    (let mark (. joins length))
    (let is-closed (call emit-arms id pattern type joined nothing true))
    (if (not is-closed)
      (call refuse .refused-expression id)
    )
    (let result (call close-joins joined mark layout nothing))
    (return (call Typed result type))
  )
  (fn-do _ place-arm _
    (param body SyntaxId)
    (param type TypeId)
    (param joined IRBlockId)
    ; Leaves the place the answer of an arm gives for its match, and goes to the join. A body
    ; written as a block runs its statements first, and one that opens a cleanup has no shape here.
    (let opens (call (. tree is-block) body))
    (let mark (. open-cleanups length))
    (let own-scoping scoping)
    (if opens
      (= scoping (= (. scoping block-base) mark))
    )
    (let last (call ending body))
    (if (== last 0)
      (call refuse .refused-expression body)
    )
    (let place (call make-operand .operand-void 0))
    (let answered (call place-answer last))
    (= place (. answered operand))
    (= scoping own-scoping)
    (if (!= (. open-cleanups length) mark)
      (call refuse .refused-expression body)
    )
    (if (!= (. answered type) type)
      (call refuse .refused-conversion body)
      (return)
    )
    (+= joins place)
    (+= joins (call make-operand .operand-block (. ir current)))
    (call jump joined)
  )
  (fn-do _ arm-leaves Bool
    (param arm SyntaxId)
    (param body SyntaxId)
    ; Whether an arm gives its match no value because what it gives is an error, which the type
    ; pass planned to leave the function at the arm. It is emitted here: the error is evaluated
    ; and raised, and what follows is never run. A panic given so has no shape here.
    (if (!= (call (. facts plan-of) (. unit reading) arm) .plan-raise)
      (return false)
    )
    (let expression (call only-expression body))
    (if (== expression 0)
      (call refuse .refused-expression body)
      (return true)
    )
    (let raised (call emit-expression expression))
    (if (or (not (call extends (. raised type) (. types error-type))) (call extends (. raised type) (. types panic-type)))
      (call refuse .refused-expression expression)
      (return true)
    )
    (call leave-with (. raised operand) (. raised type) arm)
    (call (. ir start-block) (call (. ir reserve-block)))
    (return true)
  )
  (fn-expr + helper-runs Bool
    (param helper SyntaxId)
    ; Whether a match runs as its subject's: one with no helper, or with one the type pass planned.
    (or (== helper 0) (== plan .plan-pattern-helper))
    (where
      (lazy plan (if-expr (!= helper 0) (call (. facts plan-of) (. unit reading) helper) (. OperatorPlan plan-none)))
    )
  )
  (fn-do + emit-subject-match Typed
    (param id SyntaxId)
    (param subject SyntaxId)
    (param body SyntaxId)
    (param is-optional Bool)
    (param helper SyntaxId)
    (param is-statement Bool)
    ; A match with a subject. The subject is evaluated once, and the arms are tried in the order
    ; written: each tests the subject against its pattern, and the first
    ; that matches gives the match its value, converted as the arms record for a side of its type. A
    ; struct is copied first, so nothing an arm runs changes what is matched. The arms may stand in a
    ; block with the lazy locals they read, which emit nothing there. Where no arm matches, `match`
    ; panics, `match?` and a match written on one line give an optional that holds nothing, and a
    ; `match?` run as steps goes on. The match `if` or `while` tests a pattern with gives false
    ; there. The arms after one that always matches are not emitted. With `is-statement` the arms
    ; are run for what they do and give no value. A grammar is run as `emit-stream-match` runs it,
    ; whose optional is that of `match?` too.
    (let nothing (call make-operand .operand-void 0))
    (let pattern SyntaxId 0)
    (let inner body)
    (match? ([] (. tree nodes) body)
      (case (call .node-block block)
        (= inner 0)
        (for (in statement ([] (. tree children) (. block body)))
          (if (not (call is-lazy-local statement))
            (= inner (if-expr (== inner 0) statement body))
          )
        )
      )
    )
    (match? ([] (. tree nodes) inner)
      (case (call .node-structure-match arms)
        (= pattern (. arms pattern))
      )
      (case .node-stream-match
        (return (call emit-stream-match id subject inner helper is-statement))
      )
    )
    (if (== pattern 0)
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (let type (if-expr is-statement no-type (call (. facts node-type) (. unit reading) id)))
    (let given (if-expr is-statement no-type (call (. facts node-type) (. unit reading) inner)))
    (let layout void-layout)
    (if (not is-statement)
      (if (or (== type no-type) (== type invalid-type) (== given no-type) (== given invalid-type))
        (call refuse .refused-expression id)
        (return (call Typed nothing no-type))
      )
      (= layout (call layout-of type id))
    )
    (let value (call emit-expression subject))
    (let held (. value type))
    (= value (call Typed (call apart value subject true) (. value type)))
    (let joined (call (. ir reserve-block)))
    (let slot (if-expr is-statement nothing (call join-slot layout)))
    (let mark (. joins length))
    (let named (. bound length))
    (let own-matching matching)
    (= matching (= (. matching checks-row) (call (. facts is-checked-row) (. unit reading) subject)))
    (= matching (= (. matching checked-row) (. value operand)))
    (= matching (= (. matching checked-made) (if-expr (. matching checks-row) (call made-row (. value operand)) (. U32 max))))
    (let proven (call proven-item subject))
    (if (and (!= proven (. U32 max)) (== (call intrinsic held) .table-row))
      (+= made-rows
        (call MadeRow
          (block
            (arg (. value operand))
            (arg
              (call TableCursor
                (block
                  (arg (. ([] proven-items proven) columns))
                  (arg (. (call part (. value operand) (call layout-of held subject) 1 subject) operand))
                  (arg (call no-meta))
                )
              )
            )
          )
        )
      )
      (= matching (= (. matching checks-row) true))
      (= matching (= (. matching checked-made) (as (- (. made-rows length) 1) U32)))
    )
    (= matching (= (. matching case-subject) subject))
    (let is-closed (call match-arms inner pattern (. value operand) held given type joined slot))
    (= matching own-matching)
    (call drop-bound named)
    (let absent (or is-optional (== (call (. facts plan-of) (. unit reading) inner) .plan-unmatched-absent)))
    (if (not is-closed)
      (if (and absent is-statement)
        (call jump joined)
        (else-if absent
          (call arrive id (. (call empty-optional type layout) operand) joined slot)
        )
        (else-if (and (== (call (. facts plan-of) (. unit reading) inner) .plan-open) (not is-statement) (== type (. types bool-type)))
          (call arrive id (call integer .machine-u8 0) joined slot)
        )
        (else-if (or (not (. function may-panic)) (!= (call (. facts plan-of) (. unit reading) inner) .plan-unmatched))
          (call refuse .refused-expression id)
        )
        (else
          (call raise-text (call first-arm pattern) "Pattern match failed")
        )
      )
    )
    (if is-statement
      (call (. ir start-block) joined)
      (return (call Typed nothing type))
    )
    (if (and (== (. joins length) mark) (== layout void-layout))
      (call (. ir start-block) joined)
      (return (call Typed nothing type))
    )
    (let result (call close-joins joined mark layout slot))
    (return (call Typed result type))
  )
  (fn-do + emit-is Typed
    (param id SyntaxId)
    (param lhs SyntaxId)
    (param rhs SyntaxId)
    (param negated Bool)
    ; `is` or `is not` between a value and a pattern: whether the value matches the pattern, as
    ; an arm of a match tests it. Nothing is converted and no name is bound, and a pattern of
    ; items or of texts reads no rest. A pattern the type
    ; pass found can not match is never matched, and the value is evaluated all the same. A case
    ; of a state machine a property of a class holds is tested by the object's flag of the case,
    ; but where the tag is compared (`tests-tag`); one of a machine a module's property is, written
    ; on the property's name, by the flag alone, which the machine sets before its cases run. A value
    ; of a machine's union read from elsewhere is tested as `within-case` tests it.
    (let nothing (call make-operand .operand-void 0))
    (let member (only-if (call machine-of-union (call (. facts node-type) (. unit reading) lhs)) (if (is ([] (. tree nodes) rhs) .node-symbol))))
    (if (and member (== (. member store) .store-member) (not (call tests-tag)) (call reads-machine lhs member))
      (let flag (call member-flag lhs rhs member))
      (return (call Typed (if-expr negated (call compare id .compare-equal (. flag operand) (call integer .machine-u8 0)) (. flag operand)) (. types bool-type)))
    )
    (let value (call Typed nothing no-type))
    (if (and member (== (. member store) .store-global) (call names-global lhs member))
      (= value (call Typed nothing (call (. facts node-type) (. unit reading) lhs)))
      (else
        (= value (call emit-expression lhs))
      )
    )
    (let yes (call integer .machine-u8 1))
    (let no (call integer .machine-u8 0))
    (let is-case false)
    (match? ([] (. tree nodes) rhs)
      (case .node-symbol
        (= is-case true)
      )
      (case .node-type-case
        (= is-case true)
      )
    )
    (if (and (not is-case) (== (call (. facts plan-of) (. unit reading) rhs) .plan-never))
      (return (if-expr negated (call Typed yes (. types bool-type)) (call Typed no (. types bool-type))))
    )
    (let failed (call (. ir reserve-block)))
    (let joined (call (. ir reserve-block)))
    (let own-matching matching)
    (let named (. bound length))
    (= matching (= (. matching testing) true))
    (= matching (= (. matching tested) lhs))
    (match ([] (. tree nodes) rhs)
      (case .node-symbol
        (call match-case rhs 0 value failed)
      )
      (case (call .node-type-case row)
        (call match-case rhs (. row value) value failed)
      )
      (case .node-type-list
        (call emit-pattern rhs value failed)
      )
      (case .node-type-map
        (call emit-pattern rhs value failed)
      )
      (case (all .node-type-and ({} (== (call (. facts plan-of) (. unit reading) rhs) .plan-text-pattern)))
        (call emit-pattern rhs value failed)
      )
      (default
        (call match-type rhs value failed)
      )
    )
    (= matching own-matching)
    (call drop-bound named)
    (let same (. ir current))
    (call jump joined)
    (call (. ir start-block) failed)
    (call jump joined)
    (call (. ir start-block) joined)
    (return
      (call Typed
        (block
          (arg (call phi u8-layout (if-expr negated no yes) same (if-expr negated yes no) failed))
          (arg (. types bool-type))
        )
      )
    )
  )
  (fn-do + reads-machine Bool
    (param id SyntaxId)
    (param machine MachineFact)
    ; Whether an expression reads a state machine itself, whose flags say which of its cases are
    ; active, rather than a value of its union read from elsewhere, which holds the one case the
    ; machine was in when it was read: the name alone of the module's property it is, the name of
    ; the local it is kept in or that a named machine written in a case of another declares, or
    ; the class's property it is, written after an object or alone.
    (if (== id 0)
      (return false)
    )
    (if (== (. machine store) .store-global)
      (return (call names-global id machine))
    )
    (if (== (. machine store) .store-member)
      (let property (call decl-name (. machine module) (. machine decl)))
      (match? ([] (. tree nodes) id)
        (case (call .node-get-expression row)
          (return (and property (== (. row name) property) (not (call is-link id))))
        )
        (case (call .node-identifier row)
          (return (and property (== (. row name) property) (call resolves-member id)))
        )
      )
      (return false)
    )
    (if (and (!= (. machine store) .store-local) (!= (. machine store) .store-nested))
      (return false)
    )
    (let row (call (. bindings machine-slots) (. machine module) (. machine syntax)))
    (let binding (. ([] (. instances rows) (. unit reading)) binding))
    (if (or (not row) (== (. row bound) no-slot) (== binding no-binding) (not (is ([] (. tree nodes) id) .node-identifier)))
      (return false)
    )
    (let resolution (call (. bindings resolution-of) binding id))
    (return (and (== (. resolution kind) .resolve-slot) (== (. resolution slot) (. row bound))))
  )
  (fn-do _ within-cases (list U32)
    (param machine MachineFact)
    (param index U32)
    ; The numbers of a state machine's case and of each case written in it, at any depth.
    (let machine-tree (. ([] (. program modules) (. machine module)) tree))
    (let items (call (. machine-tree state-items) (call (. machine-tree state-body) (. machine syntax))))
    (let cases (call (. machine-tree machine-cases) items))
    (let found (list U32))
    (if (>= index (as (. cases length) U32))
      (+= found index)
      (return found)
    )
    (for (in position (..< 0 (. cases length)))
      (if (!= (call (. (call (. machine-tree path-to) items ([] cases position)) find) ([] cases index)) null)
        (+= found (as position U32))
      )
    )
    (return found)
  )
  (fn-do _ pass-within _
    (param site SyntaxId)
    (param machine MachineFact)
    (param value Operand)
    (param index U32)
    (param failed IRBlockId)
    ; Goes on where a value of a state machine's union read from elsewhere than the machine holds a
    ; case or a case written in it, as a case test of the machine finds the case active then, and
    ; leaves to `failed` where it holds another: the value holds the innermost case the machine was
    ; in when it was read.
    (let tag (call load value 0 u8-layout site))
    (let passed (call (. ir reserve-block)))
    (for (in position (call within-cases machine index))
      (let next (call (. ir reserve-block)))
      (call branch (call compare site .compare-equal tag (call integer .machine-u8 position)) passed next)
      (call (. ir start-block) next)
    )
    (call jump failed)
    (+= fail-jumps 1)
    (call (. ir start-block) passed)
  )
  (fn-expr _ names-global Bool
    (param id SyntaxId)
    (param machine MachineFact)
    ; Whether a node is the name alone of the module's property a machine is.
    (case? (or (not (is ([] (. tree nodes) id) .node-identifier)) (!= (. machine module) (. unit source-module)))
      false
    )
    (default
      (and (== (. resolution kind) .resolve-global) (== (. resolution decl) (. machine decl)))
    )
    (where
      (lazy binding (. ([] (. instances rows) (. unit reading)) binding))
      (lazy resolution
        (block
          (case? (!= binding no-binding)
            (call (. bindings resolution-of) binding id)
          )
          (default
            (call Resolution .resolve-none 0)
          )
        )
      )
    )
  )
  (fn-do _ first-arm SyntaxId
    (param pattern SyntaxId)
    ; The arm written first of the arms of a match, where a match no arm matches panics.
    (match? ([] (. tree nodes) pattern)
      (case (call .node-type-or row)
        (return (call first-arm (. row left)))
      )
    )
    (return pattern)
  )
  (fn-do + match-arms Bool (?! Refused)
    (param site SyntaxId)
    (param pattern SyntaxId)
    (param subject Operand)
    (param held TypeId)
    (param given TypeId)
    (param type TypeId)
    (param joined IRBlockId)
    (param slot Operand)
    (param raises SyntaxId (= 0))
    (param alternative SyntaxId (= 0))
    ; Emits the arms of a match on a subject of type `held`, and says whether one that always
    ; matches ended them. An arm the type pass found can not match is passed over, as is one whose
    ; pattern names a case a refinement adds that no object reaches (`unreached-refined`), and an arm
    ; that raises a panic for whatever is left ends them. The arms of a loop's header declare
    ; the names their patterns write, as the header does; the body of an arm declares none.
    ; `given` is the
    ; type the arms join as and `type` the type of the match, an optional of it for `match?`;
    ; `given` is no type where the arms are run for what they do. An arm written with
    ; alternatives is an arm for each in turn, with the one body: `alternative` is the one
    ; tested. An arm that raises where its pattern matches is given the node that says so as
    ; `raises`. Whether an arm always matches is settled by its pattern, before its body, which
    ; may hold tests of its own, is emitted.
    (if (and (== alternative 0) (== raises 0) (== (call (. facts plan-of) (. unit reading) pattern) .plan-switch))
      (return (call switch-arms site pattern subject held given type joined slot))
    )
    (match? ([] (. tree nodes) pattern)
      (case (call .node-type-or row)
        (if (call match-arms site (. row left) subject held given type joined slot)
          (return true)
        )
        (if (!= (call (. facts plan-of) (. unit reading) pattern) .plan-present-after)
          (return (call match-arms site (. row right) subject held given type joined slot))
        )
        (let present (call payload site (call Typed subject held)))
        (return
          (call match-arms
            (block
              (arg site)
              (arg (. row right))
              (arg (. present operand))
              (arg (call (. types optional-inner) held))
              (arg given)
              (arg type)
              (arg joined)
              (arg slot)
            )
          )
        )
      )
      (case (call .node-type-transform row)
        (if (== (call (. facts plan-of) (. unit reading) pattern) .plan-never)
          (return false)
        )
        (let tested (if-expr (!= alternative 0) alternative (. row pattern)))
        (if (!= tested 0)
          (match? ([] (. tree nodes) tested)
            (case (call .node-type-or both)
              (if (call match-arms site pattern subject held given type joined slot raises (. both left))
                (return true)
              )
              (return
                (call match-arms
                  (block
                    (arg site)
                    (arg pattern)
                    (arg subject)
                    (arg held)
                    (arg given)
                    (arg type)
                    (arg joined)
                    (arg slot)
                    (arg raises)
                    (arg (. both right))
                  )
                )
              )
            )
          )
        )
        (if (and (!= alternative 0) (== (call (. facts plan-of) (. unit reading) alternative) .plan-never))
          (return false)
        )
        (if (and (!= tested 0) (call unreached-refined (. matching case-subject) tested))
          (return false)
        )
        (let next (call (. ir reserve-block)))
        (let jumps fail-jumps)
        (let named (. bound length))
        (let own-matching matching)
        (= matching (= (. matching arm-it) (call arm-slot-of pattern .slot-it)))
        (let passed (call Typed subject held))
        (if (!= tested 0)
          (= passed (call emit-pattern tested (call Typed subject held) next))
        )
        (= switching false)
        (let closes (== fail-jumps jumps))
        (call arm-body site pattern (. row expr) passed raises given type joined slot)
        (= matching own-matching)
        (call drop-bound named)
        (if closes
          (return true)
        )
        (call (. ir start-block) next)
        (return false)
      )
      (case (call .node-type-panic row)
        (match? ([] (. tree nodes) (. row pattern))
          (case (call .node-type-transform arm)
            (if (!= (. arm expr) 0)
              (return
                (call match-arms
                  (block
                    (arg site)
                    (arg (. row pattern))
                    (arg subject)
                    (arg held)
                    (arg given)
                    (arg type)
                    (arg joined)
                    (arg slot)
                    (arg pattern)
                  )
                )
              )
            )
          )
        )
        (call refuse .refused-expression pattern)
        (return false)
      )
    )
    (if (or (== (call (. facts plan-of) (. unit reading) pattern) .plan-never) (call unreached-refined (. matching case-subject) pattern))
      (return false)
    )
    (let next (call (. ir reserve-block)))
    (let jumps fail-jumps)
    (let named (. bound length))
    (let passed (call emit-pattern pattern (call Typed subject held) next))
    (if (== given no-type)
      (call jump joined)
      (else
        (if (!= (. passed type) given)
          (= passed (call join site passed))
        )
        (if (!= (. passed type) given)
          (call refuse .refused-conversion pattern)
        )
        (call give-arm site passed given type joined slot)
      )
    )
    (call drop-bound named)
    (if (== fail-jumps jumps)
      (return true)
    )
    (call (. ir start-block) next)
    (return false)
  )
  (fn-do _ switch-arms Bool
    (param site SyntaxId)
    (param pattern SyntaxId)
    (param subject Operand)
    (param held TypeId)
    (param given TypeId)
    (param type TypeId)
    (param joined IRBlockId)
    (param slot Operand)
    (let arms (list SyntaxId))
    (call gather-arms pattern arms)
    (let cases (== (call (. facts switch-form-of) (. unit reading) pattern) (. SwitchForm switch-cases)))
    (let values (list U64))
    (let owners (list U32))
    (let fallback-arm SyntaxId 0)
    (for (in arm arms)
      (let tested (call (. tree arm-test) arm))
      (if (== tested 0)
        (= fallback-arm arm)
        (+= owners (. U32 max))
        (continue)
      )
      (let value (if-expr cases (call switch-case tested) (call (. tree switch-number) (call (. tree equality-expr) tested))))
      (let found (. U32 max))
      (for (in position (..< 0 (. values length)))
        (if (== ([] values position) value)
          (= found (as position U32))
        )
      )
      (if (== found (. U32 max))
        (= found (as (. values length) U32))
        (+= values value)
      )
      (+= owners found)
    )
    (let discriminant (call switch-subject (call (. tree arm-test) ([] arms 0)) subject held cases))
    (let fallback (call (. ir reserve-block)))
    (let blocks (list IRBlockId))
    (for (in _ values)
      (+= blocks (call (. ir reserve-block)))
    )
    (call switch discriminant fallback values blocks)
    (for (in bucket (..< 0 (. values length)))
      (call (. ir start-block) ([] blocks bucket))
      (if (and cases (call share-bucket site arms owners (as bucket U32) ([] values bucket) subject held given type joined slot fallback))
        (continue)
      )
      (let closed false)
      (for (in position (..< 0 (. arms length)))
        (if (or closed (!= ([] owners position) (as bucket U32)))
          (continue)
        )
        (= switching true)
        (= switched-subject subject)
        (= switched-value ([] values bucket))
        (= closed (call match-arms site ([] arms position) subject held given type joined slot))
        (= switching false)
      )
      (if (not closed)
        (call jump fallback)
      )
    )
    (call (. ir start-block) fallback)
    (if (!= fallback-arm 0)
      (return (call match-arms site fallback-arm subject held given type joined slot))
    )
    (return false)
  )
  (fn-do _ arm-body _
    (param site SyntaxId)
    (param pattern SyntaxId)
    (param body SyntaxId)
    (param passed Typed)
    (param raises SyntaxId)
    (param given TypeId)
    (param type TypeId)
    (param joined IRBlockId)
    (param slot Operand)
    (let own-matching matching)
    (= matching (= (. matching declaring) false))
    (if (!= (. matching arm-it) no-slot)
      (+= bound (call BoundValue (. matching arm-it) (. passed type) (. passed operand)))
    )
    (if (!= raises 0)
      (call raise-given raises body pattern)
      (else-if (not (call arm-leaves pattern body))
        (if (== given no-type)
          (call emit-block body)
          (call jump joined)
          (else-if (not (call arm-raises body))
            (call give-arm
              (block
                (arg site)
                (arg (call arm-value site body given true type (. U32 max) (!= (call operand-kind slot) .operand-void)))
                (arg given)
                (arg type)
                (arg joined)
                (arg slot)
              )
            )
          )
        )
      )
    )
    (= matching own-matching)
  )
  (fn-do _ share-bucket Bool
    (param site SyntaxId)
    (param arms (list SyntaxId))
    (param owners (list U32))
    (param bucket U32)
    (param index U64)
    (param subject Operand)
    (param held TypeId)
    (param given TypeId)
    (param type TypeId)
    (param joined IRBlockId)
    (param slot Operand)
    (param fallback IRBlockId)
    (if (!= (call intrinsic held) .union)
      (return false)
    )
    (let members (list SyntaxId))
    (let has-inner false)
    (for (in position (..< 0 (. arms length)))
      (if (!= ([] owners position) bucket)
        (continue)
      )
      (let tested (call (. tree arm-test) ([] arms position)))
      (if (or (== tested 0) (!= (call (. facts plan-of) (. unit reading) tested) .plan-case))
        (return false)
      )
      (= has-inner (or has-inner (!= (call (. tree case-inner) tested) 0)))
      (+= members ([] arms position))
    )
    (if (< (. members length) 2)
      (return false)
    )
    (let layout (call layout-of held site))
    (let field (call (. tables layouts case-field) layout (as index U32)))
    (if (and has-inner (or (== (. field type) no-type) (== (. field type) invalid-type)))
      (return false)
    )
    (let nothing (call make-operand .operand-void 0))
    (let payload (if-expr has-inner (call take subject field site) nothing))
    (let mark (. match-steps length))
    (let sharing (list SharedArm))
    (for (in arm members)
      (let start (as (. match-steps length) U32))
      (let inner (call (. tree case-inner) (call (. tree arm-test) arm)))
      (if (!= inner 0)
        (+= match-steps
          (call MatchStep
            (block
              (arg .step-held)
              (arg (call payload-part inner (. field type)))
              (arg payload)
              (arg (. field type))
              (arg nothing)
              (arg true)
            )
          )
        )
      )
      (+= sharing (call settled arm start subject held))
    )
    (call shared-arms site sharing given type joined slot fallback)
    (while (> (. match-steps length) mark)
      (call (. match-steps pop))
    )
    (return true)
  )
  (fn-do _ payload-part SyntaxId
    (param inner SyntaxId)
    (param held TypeId)
    (match? ([] (. tree nodes) inner)
      (case (call .node-type-tuple row)
        (if (and (== (. row field-types count) 1) (!= (call intrinsic held) .tuple))
          (return ([] (. tree children) (. row field-types start)))
        )
      )
    )
    (return inner)
  )
  (fn-do _ carry-steps _
    (param arm SharedArm)
    (param skipped U32)
    (for (in position (..< (+ (. arm first) skipped) (+ (. arm first) (. arm count))))
      (+= match-steps ([] match-steps position))
    )
  )
  (fn-do _ shared-arms _ (?! Refused)
    (param site SyntaxId)
    (param arms (list SharedArm))
    (param given TypeId)
    (param type TypeId)
    (param joined IRBlockId)
    (param slot Operand)
    (param missed IRBlockId)
    (let start Size 0)
    (while (< start (. arms length))
      (let next (call (. ir reserve-block)))
      (let head (call step-head ([] arms start)))
      (let end (+ start 1))
      (if (!= head .head-none)
        (let shared (. ([] match-steps (. ([] arms start) first)) subject))
        (while (and (< end (. arms length)) (== (call step-head ([] arms end)) head) (== (. ([] match-steps (. ([] arms end) first)) subject) shared))
          (+= end 1)
        )
      )
      (if (> (- end start) 1)
        (let run (list SharedArm))
        (for (in position (..< start end))
          (+= run ([] arms position))
        )
        (if (== head .head-case)
          (call case-run site run given type joined slot next)
          (else-if (== head .head-tuple)
            (call tuple-run site run given type joined slot next)
          )
          (else
            (call list-run site run given type joined slot next)
          )
        )
        (else
          (call leaf-arm site ([] arms start) given type joined slot next)
        )
      )
      (call (. ir start-block) next)
      (= start end)
    )
    (call jump missed)
  )
  (fn-do _ step-head MatchHead
    (param arm SharedArm)
    (if (== (. arm count) 0)
      (return .head-none)
    )
    (let step ([] match-steps (. arm first)))
    (if (!= (. step kind) .step-held)
      (return .head-none)
    )
    (let kind (call intrinsic (. step type)))
    (match? ([] (. tree nodes) (. step pattern))
      (case (call .node-type-case row)
        (let index (call (. facts case-of) (. unit reading) (. step pattern)))
        (if (or not-case-plan (!= kind .union) (== index (. U32 max)) machine-case)
          (return .head-none)
        )
        (lazy not-case-plan (!= (call (. facts plan-of) (. unit reading) (. step pattern)) .plan-case))
        (lazy machine-case (!= (call machine-of-union (. step type)) null))
        (let layout (call layout-of (. step type) (. step pattern)))
        (if (not (call (. tables layouts is-union) layout))
          (return .head-none)
        )
        (if (>= (as index U64) (as (. ([] (. tables layouts rows) layout) cases count) U64))
          (return .head-none)
        )
        (if (!= (. row value) 0)
          (let field (call (. tables layouts case-field) layout (as index U32)))
          (if (or (== (. field type) no-type) (== (. field type) invalid-type))
            (return .head-none)
          )
        )
        (return .head-case)
      )
      (case (call .node-type-tuple row)
        (if (or optional-step (== kind .union) (call is-row-source kind) (not (call is-aggregate (. step type))))
          (return .head-none)
        )
        (lazy optional-step (call (. types is-optional) (. step type)))
        (let layout (call layout-of (. step type) (. step pattern)))
        (if (or (not (call (. tables layouts is-struct) layout)) too-few-fields)
          (return .head-none)
        )
        (lazy too-few-fields (< (. ([] (. tables layouts rows) layout) fields count) (. row field-types count)))
        (return .head-tuple)
      )
      (case .node-type-list
        (if (or not-list-plan (call (. types is-optional) (. step type)) (== kind .union) views-held)
          (return .head-none)
        )
        (lazy not-list-plan (!= (call (. facts plan-of) (. unit reading) (. step pattern)) .plan-list-pattern))
        (lazy views-held (call reads-views (. step pattern) (. step type)))
        (return .head-list)
      )
    )
    (return .head-none)
  )
  (fn-do _ case-run _
    (param site SyntaxId)
    (param arms (list SharedArm))
    (param given TypeId)
    (param type TypeId)
    (param joined IRBlockId)
    (param slot Operand)
    (param missed IRBlockId)
    (let head ([] match-steps (. ([] arms 0) first)))
    (let layout (call layout-of (. head type) (. head pattern)))
    (let values (list U64))
    (let owners (list U32))
    (for (in arm arms)
      (let index (as (call (. facts case-of) (. unit reading) (. ([] match-steps (. arm first)) pattern)) U64))
      (let found (. U32 max))
      (for (in position (..< 0 (. values length)))
        (if (== ([] values position) index)
          (= found (as position U32))
        )
      )
      (if (== found (. U32 max))
        (= found (as (. values length) U32))
        (+= values index)
      )
      (+= owners found)
    )
    (let miss (call (. ir reserve-block)))
    (let blocks (list IRBlockId))
    (for (in _ values)
      (+= blocks (call (. ir reserve-block)))
    )
    (call switch (call load (. head subject) 0 u8-layout (. head pattern)) miss values blocks)
    (let nothing (call make-operand .operand-void 0))
    (for (in bucket (..< 0 (. values length)))
      (call (. ir start-block) ([] blocks bucket))
      (let field (call (. tables layouts case-field) layout (as ([] values bucket) U32)))
      (let payload nothing)
      (for (in position (..< 0 (. arms length)))
        (if (and (== ([] owners position) (as bucket U32)) inner-case)
          (= payload (call take (. head subject) field (. head pattern)))
          (break)
        )
        (lazy inner-case (!= (call (. tree case-inner) (. ([] match-steps (. ([] arms position) first)) pattern)) 0))
      )
      (let members (list SharedArm))
      (for (in position (..< 0 (. arms length)))
        (if (!= ([] owners position) (as bucket U32))
          (continue)
        )
        (let arm ([] arms position))
        (let step ([] match-steps (. arm first)))
        (let inner (call (. tree case-inner) (. step pattern)))
        (let start (as (. match-steps length) U32))
        (let result (. arm result))
        (let result-type (. arm result-type))
        (if (!= inner 0)
          (+= match-steps
            (call MatchStep
              (block
                (arg .step-held)
                (arg (call payload-part inner (. field type)))
                (arg payload)
                (arg (. field type))
                (arg nothing)
                (arg (. step carries))
              )
            )
          )
          (else-if (. step carries)
            (= result (. head subject))
            (= result-type (. head type))
          )
        )
        (call carry-steps arm 1)
        (+= members (call settled (. arm arm) start result result-type))
      )
      (call shared-arms site members given type joined slot missed)
    )
    (call (. ir start-block) miss)
    (call jump missed)
  )
  (fn-do _ tuple-run _
    (param site SyntaxId)
    (param arms (list SharedArm))
    (param given TypeId)
    (param type TypeId)
    (param joined IRBlockId)
    (param slot Operand)
    (param missed IRBlockId)
    (let head ([] match-steps (. ([] arms 0) first)))
    (let layout (call layout-of (. head type) (. head pattern)))
    (let nothing (call make-operand .operand-void 0))
    (let fields (list Operand))
    (let field-types (list TypeId))
    (for (in _ (..< 0 (. ([] (. tables layouts rows) layout) fields count)))
      (+= fields nothing)
      (+= field-types no-type)
    )
    (let members (list SharedArm))
    (for (in arm arms)
      (let step ([] match-steps (. arm first)))
      (let start (as (. match-steps length) U32))
      (match? ([] (. tree nodes) (. step pattern))
        (case (call .node-type-tuple row)
          (for (in position (..< 0 (. row field-types count)))
            (let part ([] (. tree children) (+ (. row field-types start) position)))
            (if (is ([] (. tree nodes) part) .node-type-wildcard)
              (continue)
            )
            (if (== ([] field-types position) no-type)
              (= ([] fields position)
                (call take
                  (block
                    (arg (. head subject))
                    (arg (call (. tables layouts field) layout position))
                    (arg (. step pattern))
                  )
                )
              )
              (= ([] field-types position) (call field-type (. head type) position))
            )
            (+= match-steps
              (call MatchStep
                (block
                  (arg .step-held)
                  (arg part)
                  (arg ([] fields position))
                  (arg ([] field-types position))
                  (arg nothing)
                )
              )
            )
          )
        )
      )
      (call carry-steps arm 1)
      (let result (if-expr (. step carries) (. head subject) (. arm result)))
      (let result-type (if-expr (. step carries) (. head type) (. arm result-type)))
      (+= members (call settled (. arm arm) start result result-type))
    )
    (call shared-arms site members given type joined slot missed)
  )
  (fn-do _ list-run _
    (param site SyntaxId)
    (param arms (list SharedArm))
    (param given TypeId)
    (param type TypeId)
    (param joined IRBlockId)
    (param slot Operand)
    (param missed IRBlockId)
    (let head ([] match-steps (. ([] arms 0) first)))
    (let length (call list-length (. head pattern) (. head subject) (. head type) false no-layout))
    (let nothing (call make-operand .operand-void 0))
    (let start Size 0)
    (while (< start (. arms length))
      (let has-first (!= (call (. tree first-item) (. ([] match-steps (. ([] arms start) first)) pattern)) 0))
      (let end (+ start 1))
      (while (< end (. arms length))
        (if (!= (!= (call (. tree first-item) (. ([] match-steps (. ([] arms end) first)) pattern)) 0) has-first)
          (break)
        )
        (+= end 1)
      )
      (let next (call (. ir reserve-block)))
      (let first nothing)
      (let first-type no-type)
      (let sharing (and has-first (> (- end start) 1)))
      (if sharing
        (call pass-or-fail
          (block
            (arg
              (call compare
                (block
                  (arg (. head pattern))
                  (arg .compare-greater-equal)
                  (arg (. length operand))
                  (arg (call integer .machine-u64 1))
                )
              )
            )
            (arg next)
          )
        )
        (let item (call (. tree first-item) (. ([] match-steps (. ([] arms start) first)) pattern)))
        (let read
          (call read-part
            (block
              (arg item)
              (arg (call call-at item .call-item-read))
              (arg (. head subject))
              (arg (. head type))
              (arg (call integer .machine-u64 0))
              (arg (. types index-type))
            )
          )
        )
        (= first (. read operand))
        (= first-type (. read type))
      )
      (let members (list SharedArm))
      (for (in position (..< start end))
        (let arm ([] arms position))
        (let step ([] match-steps (. arm first)))
        (let begin (as (. match-steps length) U32))
        (call list-steps
          (block
            (arg (. step pattern))
            (arg (. head subject))
            (arg (. head type))
            (arg (. length operand))
            (arg first)
            (arg first-type)
            (arg sharing)
          )
        )
        (call carry-steps arm 1)
        (let result (if-expr (. step carries) (. head subject) (. arm result)))
        (let result-type (if-expr (. step carries) (. head type) (. arm result-type)))
        (+= members (call settled (. arm arm) begin result result-type))
      )
      (call shared-arms site members given type joined slot next)
      (call (. ir start-block) next)
      (= start end)
    )
    (call jump missed)
  )
  (fn-do _ list-steps _
    (param pattern SyntaxId)
    (param list Operand)
    (param type TypeId)
    (param length Operand)
    (param first Operand)
    (param first-type TypeId)
    (param sharing Bool)
    (match? ([] (. tree nodes) pattern)
      (case (call .node-type-list row)
        (let count (. row patterns count))
        (let rest count)
        (for (in position (..< 0 count))
          (if (is ([] (. tree nodes) ([] (. tree children) (+ (. row patterns start) position))) .node-type-remainder)
            (= rest position)
          )
        )
        (let fixed (if-expr (== rest count) count (- count 1)))
        (if sharing
          (+= match-steps
            (call MatchStep
              (block
                (arg .step-held)
                (arg ([] (. tree children) (. row patterns start)))
                (arg first)
                (arg first-type)
                (arg length)
              )
            )
          )
        )
        (if (or (not sharing) (== rest count) (> fixed 1))
          (+= match-steps
            (call MatchStep
              (block
                (arg .step-length)
                (arg pattern)
                (arg list)
                (arg type)
                (arg length)
                (arg false)
                (arg fixed)
                (arg 0)
                (arg (== rest count))
              )
            )
          )
        )
        (let opening U32 (if-expr sharing 1 0))
        (if (< opening rest)
          (for (in position (..< opening rest))
            (+= match-steps
              (call MatchStep
                (block
                  (arg .step-item)
                  (arg ([] (. tree children) (+ (. row patterns start) position)))
                  (arg list)
                  (arg type)
                  (arg length)
                  (arg false)
                  (arg position)
                )
              )
            )
          )
        )
        (if (< (+ rest 1) count)
          (for (in position (..< (+ rest 1) count))
            (+= match-steps
              (call MatchStep
                (block
                  (arg .step-from-end)
                  (arg ([] (. tree children) (+ (. row patterns start) position)))
                  (arg list)
                  (arg type)
                  (arg length)
                  (arg false)
                  (arg position)
                  (arg (- count position))
                )
              )
            )
          )
        )
        (if (and (!= rest count) (not (. matching testing)) (call (. tree has-name) remainder))
          (+= match-steps
            (call MatchStep
              (block
                (arg .step-rest)
                (arg remainder)
                (arg list)
                (arg type)
                (arg length)
                (arg false)
                (arg rest)
                (arg (- count rest 1))
              )
            )
          )
        )
        (lazy remainder ([] (. tree children) (+ (. row patterns start) rest)))
      )
    )
  )
  (fn-do _ leaf-arm _
    (param site SyntaxId)
    (param arm SharedArm)
    (param given TypeId)
    (param type TypeId)
    (param joined IRBlockId)
    (param slot Operand)
    (param missed IRBlockId)
    (let named (. bound length))
    (let own-matching matching)
    (= matching (= (. matching arm-it) (call arm-slot-of (. arm arm) .slot-it)))
    (let last (+ (. arm first) (. arm count)))
    (for (in position (..< (. arm first) last))
      (let step ([] match-steps position))
      (if (== (. step kind) .step-length)
        (let wanted (call integer .machine-u64 (. step position)))
        (call pass-or-fail
          (block
            (arg
              (call compare
                (block
                  (arg (. step pattern))
                  (arg (if-expr (. step exact) .compare-equal .compare-greater-equal))
                  (arg (. step length))
                  (arg wanted)
                )
              )
            )
            (arg missed)
          )
        )
      )
    )
    (let result (. arm result))
    (let result-type (. arm result-type))
    (for (in position (..< (. arm first) last))
      (let step ([] match-steps position))
      (if (== (. step kind) .step-length)
        (continue)
      )
      (if (== (. step kind) .step-rest)
        (let end (. step length))
        (if (!= (. step back) 0)
          (= end
            (call arithmetic
              (block
                (arg (. step pattern))
                (arg .arithmetic-subtract)
                (arg (. step length))
                (arg (call integer .machine-u64 (. step back)))
                (arg u64-layout)
              )
            )
          )
        )
        (call match-rest
          (block
            (arg (. step pattern))
            (arg (. step subject))
            (arg (. step type))
            (arg (call integer .machine-u64 (. step position)))
            (arg end)
            (arg false)
            (arg missed)
          )
        )
        (continue)
      )
      (let value (call Typed (. step subject) (. step type)))
      (if (!= (. step kind) .step-held)
        (let index (call integer .machine-u64 (. step position)))
        (if (== (. step kind) .step-from-end)
          (= index
            (call arithmetic
              (block
                (arg (. step pattern))
                (arg .arithmetic-subtract)
                (arg (. step length))
                (arg (call integer .machine-u64 (. step back)))
                (arg u64-layout)
              )
            )
          )
        )
        (let read
          (call read-part
            (block
              (arg (. step pattern))
              (arg (call call-at (. step pattern) .call-item-read))
              (arg (. step subject))
              (arg (. step type))
              (arg index)
              (arg (. types index-type))
            )
          )
        )
        (= value read)
      )
      (let passed (call emit-pattern (. step pattern) value missed))
      (if (. step carries)
        (= result (. passed operand))
        (= result-type (. passed type))
      )
    )
    (call arm-body
      (block
        (arg site)
        (arg (. arm arm))
        (arg (call (. tree transform-body) (. arm arm)))
        (arg (call Typed result result-type))
        (arg 0)
        (arg given)
        (arg type)
        (arg joined)
        (arg slot)
      )
    )
    (= matching own-matching)
    (call drop-bound named)
  )
  (fn-do _ gather-arms _
    (param pattern SyntaxId)
    (param arms (list SyntaxId))
    (match? ([] (. tree nodes) pattern)
      (case (call .node-type-or row)
        (call gather-arms (. row left) arms)
        (call gather-arms (. row right) arms)
        (return)
      )
    )
    (+= arms pattern)
  )
  (fn-expr _ switch-case U64
    (param pattern SyntaxId)
    (as (call (. facts case-of) (. unit reading) pattern) U64)
  )
  (fn-do _ switch-subject Operand
    (param pattern SyntaxId)
    (param subject Operand)
    (param held TypeId)
    (param cases Bool)
    (if (not cases)
      (return subject)
    )
    (let kind (call intrinsic held))
    (if (or (== kind .table-row) (== kind .immutable-table-row))
      (let located (call subject-place pattern subject held))
      (return (call load (call table-cell pattern (. located columns) (. located index) 0 u8-layout) 0 u8-layout pattern))
    )
    (return (call load subject 0 u8-layout pattern))
  )
  (fn-do + arm-value Typed
    (param site SyntaxId)
    (param body SyntaxId)
    (param type TypeId)
    (param guards Bool (= false))
    (param whole TypeId (= no-type))
    (param remade U32 (= (. U32 max)))
    (param in-place Bool (= false))
    ; The value of the body of an arm, converted as the arms record for a side of its type. With
    ; `guards` an error is a value where the type of the match holds it, and has no shape where
    ; that type carries errors. A side the arms record a conversion for straight to the type of the
    ; match, `whole`, arrives as that. A body written as a block is a block of its own: the
    ; cleanups opened in it run where it ends. A value a helper makes again, `remade`, is what
    ; `remake` makes of the body's. With `in-place` the value is copied where the arms join as soon
    ; as it is read, so a struct is read from where it lies.
    (let opens (call (. tree is-block) body))
    (let mark (. open-cleanups length))
    (let own-scoping scoping)
    (if opens
      (= scoping (= (. scoping block-base) mark))
    )
    (let expression (call ending body))
    (if (== expression 0)
      (call refuse .refused-expression body)
      (= scoping own-scoping)
      (return (call Typed (call make-operand .operand-void 0) no-type))
    )
    (let own-matching matching)
    (if in-place
      (= matching (= (. matching read-in-place) expression))
    )
    (let value (call emit-expression expression))
    (= matching own-matching)
    (if (!= remade (. U32 max))
      (= value (call remake site remade (. value operand) (. value type)))
    )
    (if (and guards (call extends (. value type) (. types error-type)) (call carries-error type))
      (call refuse .refused-expression expression)
    )
    (if (!= (. value type) type)
      (= value (call join site value))
    )
    (if (and (!= (. value type) type) (!= (. value type) whole))
      (call refuse .refused-conversion expression)
    )
    (return (if-expr opens (call close-value value mark own-scoping body) value))
  )
  (fn-do _ give-arm _
    (param site SyntaxId)
    (param value Typed)
    (param given TypeId)
    (param type TypeId)
    (param joined IRBlockId)
    (param slot Operand)
    ; Leaves the value of an arm for its match: as it is, held by the optional `match?` gives, or
    ; converted to the type the match was asked for as the arms record for the type they join
    ; as. One that arrived in the type of the match already is left as it is.
    (let left value)
    (if (and (!= type given) (!= (. left type) type))
      (= left
        (block
          (case? (== (call (. types optional-inner) type) given)
            (call wrap site (call Typed (. value operand) given) type)
          )
          (default
            (call join site (call Typed (. value operand) given))
          )
        )
      )
    )
    (call arrive site (. left operand) joined slot)
  )
  (fn-do _ bind-case-cursor _
    (param name SyntaxId)
    (param row Operand)
    (param type TypeId)
    (param place U32)
    (param case-index U32)
    (param located TableCursor)
    ; Gives a name a pattern declares the case of a row of a table of unions it matched: the name
    ; stands for the row's cells. A name that nested functions capture, or a declaration's, has
    ; no shape here.
    (if (. matching testing)
      (return)
    )
    (let binding (. ([] (. instances rows) (. unit reading)) binding))
    (if (or (== binding no-binding) (!= (. unit reading) (. unit instance)) (. matching declaring))
      (call refuse .refused-expression name)
      (return)
    )
    (let resolution (call (. bindings resolution-of) binding name))
    (if (!= (. resolution kind) .resolve-slot)
      (call refuse .refused-expression name)
      (return)
    )
    (let held ([] (. bindings slots) (. resolution slot)))
    (if (or (!= (. held kind) .slot-pattern) (call is-captured (. resolution slot)))
      (call refuse .refused-expression name)
      (return)
    )
    (let case-type (. ([] (. tables unions cases) (+ (. ([] (. tables unions layouts) place) cases start) case-index)) type))
    (let offset (call slot-offset (. resolution slot) name))
    (if (!= (call (. facts slot-type) (. unit instance) offset) case-type)
      (call refuse .refused-conversion name)
      (return)
    )
    (+= bound (call BoundValue (. resolution slot) case-type row (as (. case-cursors length) U32)))
    (let checked (and (. matching checks-row) (== row (. matching checked-row))))
    (+= case-cursors (call CaseCursor row type place case-index checked (. located columns) (. located index)))
  )
  (fn-do + case-cursor-of U32
    (param object SyntaxId)
    ; The case of a row a name read as an object stands for, or `U32.max` where it stands for none.
    (match? ([] (. tree nodes) object)
      (case .node-identifier
        (let binding (. ([] (. instances rows) (. unit reading)) binding))
        (if (or (== binding no-binding) (!= (. unit reading) (. unit instance)))
          (return (. U32 max))
        )
        (let resolution (call (. bindings resolution-of) binding object))
        (if (!= (. resolution kind) .resolve-slot)
          (return (. U32 max))
        )
        (let position (. bound length))
        (while (!= position 0)
          (-= position 1)
          (if (== (. ([] bound position) slot) (. resolution slot))
            (return (. ([] bound position) cursor))
          )
        )
      )
    )
    (return (. U32 max))
  )
  (fn-do + gather-cursor Typed
    (param id SyntaxId)
    (param cursor U32)
    (param type TypeId)
    ; The case a name stands for, gathered from its row's cells where the name is used as a value.
    (let nothing (call make-operand .operand-void 0))
    (let held ([] case-cursors cursor))
    (let case-type
      (scope (. ([] (. tables unions cases) (+ case-base (. held case-index))) type)
        (lazy case-base (. ([] (. tables unions layouts) (. held place)) cases start))
      )
    )
    (if (!= type case-type)
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (let found (call gathered-at cursor))
    (if (!= found (. U32 max))
      (return (call Typed (. ([] case-gathers found) value) case-type))
    )
    (let located (call case-place id held))
    (let made (call gather-union-case id (. held place) (. held case-index) (. located columns) (. located index)))
    (+= case-gathers (call CaseGather cursor (. made operand) (. ir current)))
    (return (call Typed (. made operand) case-type))
  )
  (fn-do _ gathered-at U32
    (param cursor U32)
    ; Where among `case-gathers` the newest gather of the case a name stands for that dominates
    ; the block being emitted is, or `U32.max` where none does. In the body of a loop with a
    ; header only one made in the same block does, as TypeScript, which joins the blocks of such a
    ; loop to the function only once its body is emitted, finds no other to dominate there.
    (let headed (call in-headed-loop))
    (let position (. case-gathers length))
    (while (!= position 0)
      (-= position 1)
      (let kept ([] case-gathers position))
      (if (and (== (. kept cursor) cursor) (or (== (. kept block) (. ir current)) dominated))
        (return (as position U32))
      )
      (lazy dominated (and (not headed) (call (. ir dominates) (. kept block) (. ir current))))
    )
    (return (. U32 max))
  )
  (fn-do _ in-headed-loop Bool
    ; Whether the body of a loop with a header is being emitted: any loop but a `while`.
    (for (in loop loops)
      (match? ([] (. tree nodes) (. loop syntax))
        (case .node-while-block
          (continue)
        )
      )
      (return true)
    )
    (return false)
  )
  (fn-do + case-field (? UnionField)
    (param cursor U32)
    (param name Atom)
    ; The field of the case a name stands for that a name reads, where the case stores one.
    (let held ([] case-cursors cursor))
    (let union ([] (. tables unions layouts) (. held place)))
    (let kept ([] (. tables unions cases) (+ (. union cases start) (. held case-index))))
    (let found (call (. types property-named) (. kept type) name))
    (if (not found)
      (return null)
    )
    (let slot (. ([] (. types properties) found) slot))
    (for (in position (..< 0 (. kept fields count)))
      (let field ([] (. tables unions fields) (+ (. kept fields start) position)))
      (if (== (. field slot) slot)
        (return field)
      )
    )
    (return null)
  )
  (fn-do _ case-row TableCursor
    (param id SyntaxId)
    (param cursor U32)
    ; The row of the case a name stands for, its table checked again where it grows.
    (return (call case-place id ([] case-cursors cursor)))
  )
  (fn-do + case-place TableCursor
    (param id SyntaxId)
    (param held CaseCursor)
    ; Where the row of a case is read: the columns its subject `t[i]` found, with no metadata, or
    ; else those of the row's value, its table checked again where it grows.
    (if (. held checked)
      (return (call TableCursor (. held columns) (. held index) (call no-meta)))
    )
    (return (call value-cursor id (. held row) (. held type)))
  )
  (fn-do _ subject-place TableCursor
    (param id SyntaxId)
    (param row Operand)
    (param type TypeId)
    ; Where the row a pattern tests is read: the columns and the index the subject `t[i]` of the
    ; match found and checked, as TypeScript reads its cursor, and else those of the row's value,
    ; its table checked again where it grows.
    (if (and (. matching checks-row) (== row (. matching checked-row)) (!= (. matching checked-made) (. U32 max)))
      (let cursor (. ([] made-rows (. matching checked-made)) cursor))
      (return (call TableCursor (. cursor columns) (. cursor index) (call no-meta)))
    )
    (return (call value-cursor id row type))
  )
  (fn-do _ case-cell Operand
    (param id SyntaxId)
    (param cursor U32)
    (param located TableCursor)
    (param field UnionField)
    (param stored LayoutField)
    ; Where the row of the case a name stands for keeps a field.
    (let held ([] case-cursors cursor))
    (let handle (call integer .machine-u32 0))
    (if (== (. field region) .region-external)
      (= handle (call union-handle id (. held place) (. located columns) (. located index)))
    )
    (return (call union-cell id (. held place) (. located columns) (. located index) field (. stored layout) handle))
  )
  (fn-do _ case-stored LayoutField
    (param id SyntaxId)
    (param cursor U32)
    (param field UnionField)
    ; How the case a name stands for holds a field it keeps in its row.
    (let held ([] case-cursors cursor))
    (let case-type
      (scope (. ([] (. tables unions cases) (+ case-base (. held case-index))) type)
        (lazy case-base (. ([] (. tables unions layouts) (. held place)) cases start))
      )
    )
    (let case-layout (call layout-of case-type id))
    (return (call (. tables layouts field) case-layout (. field slot)))
  )
  (fn-do + emit-case-field Typed
    (param id SyntaxId)
    (param cursor U32)
    (param field UnionField)
    ; A field of the case of a row a name stands for, read from its cell, or from what was gathered
    ; of the case where that dominates. Where the type pass knows an optional field to hold a
    ; value, the read is of what it holds, with no test, as a property's is.
    (let stored (call case-stored id cursor field))
    (let narrowed (and (not (call is-link id)) (call holds (. stored type) (call (. facts node-type) (. unit reading) id))))
    (let read (call make-operand .operand-void 0))
    (let found (call gathered-at cursor))
    (if (!= found (. U32 max))
      (= read (call take (. ([] case-gathers found) value) stored id))
      (else
        (let located (call case-row id cursor))
        (let cell (call case-cell id cursor located field stored))
        (= read (call take cell (call LayoutField 0 (. stored layout) (. stored type)) id))
      )
    )
    (if narrowed
      (return (call payload id (call Typed read (. stored type))))
    )
    (return (call Typed read (. stored type)))
  )
  (fn-do + emit-case-field-assign Assignment
    (param id SyntaxId)
    (param op Operator)
    (param lhs SyntaxId)
    (param cursor U32)
    (param field UnionField)
    (param rhs SyntaxId)
    ; A field of the case of a row a name stands for written in its cell, as TypeScript writes it:
    ; the value is read, converted to the field's type and stored; where the table grows the
    ; table is checked first and its mutation generation counted on after, unless the row's
    ; storage was checked where the case was read. An assigning operator reads the field through
    ; the row first. A row of a finished table is not written.
    (if (!= (call intrinsic (. ([] case-cursors cursor) type)) .table-row)
      (call refuse .refused-statement id)
      (return (call Assignment))
    )
    (let given (call Typed (call make-operand .operand-void 0) no-type))
    (let increment (call increment-base op))
    (if (== op .eq-op)
      (= given (call emit-expression rhs))
      (else-if (and increment (== (call (. facts plan-of) (. unit reading) id) .plan-builtin))
        (= given (call emit-builtin id increment lhs rhs true))
      )
      (else
        (call refuse .refused-statement id)
      )
    )
    (let stored (call case-stored lhs cursor field))
    (let value (call convert id .reason-assignment given))
    (if (!= (. value type) (. stored type))
      (call refuse .refused-conversion rhs)
    )
    (let located (call case-row lhs cursor))
    (let cell (call case-cell lhs cursor located field stored))
    (call store-row-cell lhs cell (. stored layout) (. value operand) (. located meta))
    (if (not (. ([] case-cursors cursor) checked))
      (call invalidate-marks lhs (. located meta))
    )
    (return (call Assignment (call Typed (. value operand) (. stored type)) given))
  )
  (fn-do + pass-or-fail _
    (param tested Operand)
    (param failed IRBlockId)
    ; Goes on where a test of a pattern holds, and leaves to `failed` where it does not.
    (let passed (call (. ir reserve-block)))
    (call branch tested passed failed)
    (+= fail-jumps 1)
    (call (. ir start-block) passed)
  )
  (fn-do + emit-pattern Typed (?! Refused)
    (param pattern SyntaxId)
    (param value Typed)
    (param failed IRBlockId)
    ; Tests a value against a pattern, and gives what the pattern passes on where it matches, with its
    ; type. Where it does not match nothing panics: `failed` is where it leaves to. A name the pattern
    ; declares is bound to what it captured. A pattern the type pass planned nothing for has no shape
    ; here.
    (let nothing (call make-operand .operand-void 0))
    (if (== pattern 0)
      (return value)
    )
    (match? ([] (. tree nodes) pattern)
      (case .node-type-wildcard
        (return value)
      )
      (case .node-type-identifier
        (return (call match-type pattern value failed))
      )
      (case .node-type-arguments
        (return (call match-type pattern value failed))
      )
      (case .node-type-optional
        (return (call match-type pattern value failed))
      )
      (case (call .node-type-match row)
        (if (call (. tree names-type) (. row type))
          (return (call match-type (. row type) value failed))
        )
        (return (call emit-pattern (. row type) value failed))
      )
      (case (call .node-type-capture row)
        (let passed value)
        (if (and (!= (. row type) 0) (call (. tree names-type) (. row type)))
          (= passed (call match-type (. row type) value failed))
          (else-if (!= (. row type) 0)
            (= passed (call emit-pattern (. row type) value failed))
          )
        )
        (call bind-name (. row id) passed)
        (return passed)
      )
      (case (call .node-type-and row)
        (if (== (call (. facts plan-of) (. unit reading) pattern) .plan-text-pattern)
          (return (call match-text pattern value failed))
        )
        (let left (call emit-pattern (. row left) value failed))
        (return (call emit-pattern (. row right) left failed))
      )
      (case (call .node-type-equality row)
        (return (call match-equal pattern (. row expr) value failed))
      )
      (case (call .node-type-predicate row)
        (return (call match-predicate pattern (. row expr) value failed))
      )
      (case (call .node-type-case row)
        (return (call match-case pattern (. row value) value failed))
      )
      (case (call .node-type-tuple row)
        (return (call match-fields pattern (. row field-types) value failed))
      )
      (case (call .node-type-property row)
        (return (call match-property pattern (. row name) value))
      )
      (case (call .node-type-list row)
        (if (== (call (. facts plan-of) (. unit reading) pattern) .plan-list-pattern)
          (return (call match-items pattern (. row patterns) value failed))
        )
        (return (call match-type pattern value failed))
      )
      (case (call .node-type-map row)
        (if (== (call (. facts plan-of) (. unit reading) pattern) .plan-map-pattern)
          (return (call match-keys pattern (. row patterns) value failed))
        )
        (return (call match-type pattern value failed))
      )
      (case .node-identifier
        (call bind-name pattern value)
        (return value)
      )
    )
    (call refuse .refused-expression pattern)
    (return (call Typed nothing no-type))
  )
  (fn-do _ match-property Typed
    (param pattern SyntaxId)
    (param name Atom)
    (param value Typed)
    ; A pattern that reads a name from what it is given, as the type pass recorded the read at
    ; the pattern: it always matches, passes what the name gives, and binds the name to that
    ; where the pattern declares one.
    (let mark (. pins length))
    (call pin pattern (. value operand) (. value type))
    (let read (call emit-get pattern pattern name))
    (call unpin mark)
    (let binding (. ([] (. instances rows) (. unit reading)) binding))
    (if (and (!= binding no-binding) (== (. (call (. bindings resolution-of) binding pattern) kind) .resolve-slot))
      (call bind-name pattern read)
    )
    (return read)
  )
  (fn-do _ pattern-row FactId
    (param pattern SyntaxId)
    (param source TypeId)
    ; The conversion the type pass recorded at a type named as a pattern for a value of a type
    ; given to it whole, or none.
    (let fact (call (. facts first-conversion) (. unit reading) pattern))
    (while (!= fact no-fact)
      (let row ([] (. facts conversions) fact))
      (if (and (== (. row reason) .reason-pattern) (== (. row guard) (. U32 max)) (== (. row from) source))
        (return fact)
      )
      (= fact (. row next))
    )
    (return no-fact)
  )
  (fn-do + match-type Typed
    (param pattern SyntaxId)
    (param value Typed)
    (param failed IRBlockId)
    ; A type named as a pattern, as the type pass planned it. A value the pattern has a
    ; conversion for is tested where the conversion can fail, and converted. An optional it has
    ; none for is tested for a value, and matched as what it holds. A union it has none for is
    ; matched by its cases.
    (let nothing (call make-operand .operand-void 0))
    (let held value)
    (if (and (== (call pattern-row pattern (. held type)) no-fact) (call (. types is-optional) (. held type)))
      (let type (. held type))
      (let tested (call present pattern held))
      (call pass-or-fail (. tested operand) failed)
      (= held (call payload pattern (call Typed (. held operand) type)))
    )
    (let whole (call pattern-row pattern (. held type)))
    (if (!= whole no-fact)
      (return (call pass-leaf pattern ([] (. facts conversions) whole) held failed))
    )
    (if (!= (call intrinsic (. held type)) .union)
      (call refuse .refused-conversion pattern)
      (return (call Typed nothing no-type))
    )
    (return (call match-cases pattern held failed))
  )
  (fn-do _ match-cases Typed (?! Refused)
    (param pattern SyntaxId)
    (param value Typed)
    (param failed IRBlockId)
    (param within TypeId (= no-type))
    ; A union matched by its cases: each case the type pass recorded a conversion for is tested
    ; in turn, and what it holds is converted. An optional a case holds is tested for a value
    ; first. A case that is a union is matched by its own cases, whose rows are `within` it. A
    ; union that holds any other case does not match. A pattern that only tests passes the union
    ; itself.
    (let nothing (call make-operand .operand-void 0))
    (let union (. value type))
    (let layout (call layout-of (. value type) pattern))
    (let target no-type)
    (let fact (call (. facts first-conversion) (. unit reading) pattern))
    (while (!= fact no-fact)
      (let row ([] (. facts conversions) fact))
      (if (and (== (. row reason) .reason-pattern) (!= (. row guard) (. U32 max)) (== target no-type))
        (= target (. row to))
      )
      (= fact (. row next))
    )
    (if (or (== target no-type) (not (call (. tables layouts is-union) layout)))
      (call refuse .refused-conversion pattern)
      (return (call Typed nothing no-type))
    )
    (let result (call layout-of target pattern))
    (let joined (call (. ir reserve-block)))
    (let slot (call join-slot result))
    (let mark (. joins length))
    (= fact (call (. facts first-conversion) (. unit reading) pattern))
    (while (!= fact no-fact)
      (let row ([] (. facts conversions) fact))
      (= fact (. row next))
      (if (or (!= (. row reason) .reason-pattern) (== (. row guard) (. U32 max)) (!= (. row within) within))
        (continue)
      )
      (if (or (>= (. row guard) (. ([] (. tables layouts rows) layout) cases count)) (!= (. row to) target))
        (call refuse .refused-conversion pattern)
        (continue)
      )
      (let matched (call (. ir reserve-block)))
      (let missed (call (. ir reserve-block)))
      (call branch (call case-test pattern (. value operand) (. row guard)) matched missed)
      (call (. ir start-block) matched)
      (let field (call (. tables layouts case-field) layout (. row guard)))
      (let inner (call Typed (call take (. value operand) field pattern) (. field type)))
      (if (and (call (. types is-optional) (. field type)) (!= (. row from) (. field type)))
        (let tested (call present pattern inner))
        (call pass-or-fail (. tested operand) failed)
        (= inner (call payload pattern inner))
      )
      (let passed
        (scope (if-expr descends (call match-cases pattern inner failed (. row from)) (call pass-leaf pattern row inner failed))
          (lazy descends (and (== (. row kind) .relation-illegal) (== (. row from) (. inner type))))
        )
      )
      (if (. matching testing)
        (call jump joined)
        (else
          (call arrive pattern (. passed operand) joined slot)
        )
      )
      (call (. ir start-block) missed)
    )
    (call jump failed)
    (+= fail-jumps 1)
    (if (. matching testing)
      (call (. ir start-block) joined)
      (return (call Typed (. value operand) union))
    )
    (let passed (call close-joins joined mark result slot))
    (return (call Typed passed target))
  )
  (fn-do _ pass-leaf Typed
    (param pattern SyntaxId)
    (param row ConversionFact)
    (param value Typed)
    (param failed IRBlockId)
    ; Converts a value as a type named as a pattern records, where the value passes the test the
    ; conversion's kind makes: a union holds the case, an object is of the class. A value that
    ; fails it does not match. A union matches text only where it holds the case the type pass
    ; picked for text, though cast to text it gives the text of any case. A case that holds text
    ; gives its text as it is, and any other case is cast to text. A value of an
    ; interface is of the type it holds. TypeScript never matches a value that is no object cast
    ; up. A value already of the type asked for passes as it is, but an object tested for its
    ; class alone, which may be of a class derived from the one it is known by.
    (if (!= (. row from) (. value type))
      (call refuse .refused-conversion pattern)
      (return value)
    )
    (let kind (. row kind))
    (let exact (== (call (. facts plan-of) (. unit reading) pattern) .plan-exact-class))
    (if (and (== kind .relation-same) (== (. row from) (. row to)))
      (if (and exact (call (. tables is-class) (. row to)))
        (return (call exact-class-pass pattern value failed))
      )
      (return value)
    )
    (let objects (and (call (. tables is-class) (. row from)) (call (. tables is-class) (. row to))))
    (if (or (== kind .relation-illegal) (and (== kind .relation-up-cast) (not objects)))
      (call refuse .refused-conversion pattern)
      (return value)
    )
    (if (and (== kind .relation-unwrap-cast) (== (call intrinsic (. row from)) .union) (== (. row to) (. types string-type)))
      (if (== (. row case-index) (. U32 max))
        (call refuse .refused-conversion pattern)
        (return value)
      )
      (call pass-or-fail (call case-test pattern (. value operand) (. row case-index)) failed)
      (if (. matching testing)
        (return (call Typed (. value operand) (. row from)))
      )
      (let layout (call layout-of (. row from) pattern))
      (let field (call (. tables layouts case-field) layout (. row case-index)))
      (if (== (. field type) (. types string-type))
        (return (call Typed (call take (. value operand) field pattern) (. field type)))
      )
    )
    (let tests
      (scope (or (== kind .relation-unwrap-cast) (== kind .relation-down-cast) interface-cast)
        (lazy interface-cast (== kind .relation-interface-down-cast))
      )
    )
    (if (and (. matching testing) (not tests))
      (return value)
    )
    (let own-matching matching)
    (= matching (= (. matching failing) failed))
    (= matching (= (. matching exact-class) exact))
    (let passed (call convert-one pattern row value))
    (= matching own-matching)
    (return passed)
  )
  (fn-do _ exact-class-pass Typed
    (param pattern SyntaxId)
    (param value Typed)
    (param failed IRBlockId)
    ; An object tested for the class it is known by alone: it passes as it is where it is of that
    ; class, and does not match where it is of one derived from it.
    (let own-matching matching)
    (= matching (= (. matching exact-class) true))
    (let passed (call (. ir reserve-block)))
    (call class-branch pattern (. value operand) (. value type) passed failed)
    (+= fail-jumps 1)
    (= matching own-matching)
    (call (. ir start-block) passed)
    (return value)
  )
  (fn-do _ match-equal Typed
    (param pattern SyntaxId)
    (param expr SyntaxId)
    (param value Typed)
    (param failed IRBlockId)
    ; An equality pattern: its subject is compared with a value by the plan of `==` the type pass
    ; recorded at the pattern, whose node stands for the subject. The pattern passes its subject.
    (let nothing (call make-operand .operand-void 0))
    (let type (. value type))
    (if (and switching (== (. value operand) switched-subject) (== (call (. tree switch-number) expr) switched-value))
      (= switching false)
      (return value)
    )
    (let pin-mark (. pins length))
    (call pin pattern (. value operand) type)
    (let tested (call emit-binary pattern .equals-op pattern expr))
    (call unpin pin-mark)
    (call pass-or-fail (. tested operand) failed)
    (return (call Typed (. value operand) type))
  )
  (fn-do _ match-predicate Typed
    (param pattern SyntaxId)
    (param expr SyntaxId)
    (param value Typed)
    (param failed IRBlockId)
    ; A pattern that is a condition: `it` is what the pattern is given while the condition is
    ; evaluated, and the pattern passes that where the condition tests as true.
    (let nothing (call make-operand .operand-void 0))
    (let type (. value type))
    (let slot (call arm-slot-of pattern .slot-it))
    (if (== slot no-slot)
      (= slot (. matching arm-it))
    )
    (if (== slot no-slot)
      (= slot (call it-read expr))
    )
    (let named (. bound length))
    (if (!= slot no-slot)
      (+= bound (call BoundValue slot type (. value operand)))
    )
    (let tested (call test expr (call emit-expression expr)))
    (call drop-bound named)
    (call pass-or-fail (. tested operand) failed)
    (return (call Typed (. value operand) type))
  )
  (fn-do _ it-read SlotId
    (param expr SyntaxId)
    ; The slot a condition reads `it` through where its pattern declares none and no arm has
    ; one: that of an earlier pattern of the same block.
    (let binding (. ([] (. instances rows) (. unit reading)) binding))
    (if (or (== binding no-binding) (!= (. unit reading) (. unit instance)))
      (return no-slot)
    )
    (for (in id (.. (call (. tree subtree-start) expr) expr))
      (match? ([] (. tree nodes) id)
        (case .node-identifier
          (let resolution (call (. bindings resolution-of) binding id))
          (if (and (== (. resolution kind) .resolve-slot) (== (. ([] (. bindings slots) (. resolution slot)) kind) .slot-it))
            (return (. resolution slot))
          )
        )
      )
    )
    (return no-slot)
  )
  (fn-do _ match-case Typed
    (param pattern SyntaxId)
    (param inner SyntaxId)
    (param value Typed)
    (param failed IRBlockId)
    ; A pattern that names a case of a union, by the number the type pass recorded. An optional
    ; is tested for a value first. With a pattern written for what the case holds, that is
    ; matched and what it passes is passed; with none, the union is, but where `is` tests a state
    ; machine it is the case's flag that is tested, as the reference tests it, unless the tag is
    ; (`tests-tag`), and where it tests a value of a machine's union read from elsewhere, the tag of
    ; the case or of one written in it (`pass-within`). One pattern in parentheses for a case that holds no tuple is the pattern
    ; of what the case holds. A case its subject is no union of matches nothing. A case a refinement
    ; of the machine adds is tested as `refined-case` reads it, and matches nothing where no object
    ; reaches the test (`unreached-refined`).
    (let nothing (call make-operand .operand-void 0))
    (if (or (== (call (. facts plan-of) (. unit reading) pattern) .plan-never) (call unreached-refined (. matching case-subject) pattern))
      (call jump failed)
      (+= fail-jumps 1)
      (call (. ir start-block) (call (. ir reserve-block)))
      (return value)
    )
    (if (== (call (. facts plan-of) (. unit reading) pattern) .plan-refined-case)
      (let union (. value type))
      (let held (call refined-case (. matching case-subject) pattern (!= inner 0) false))
      (call pass-or-fail (call load-local refined-flag pattern) failed)
      (if (== inner 0)
        (return (call Typed (. value operand) union))
      )
      (return
        (call emit-pattern
          (block
            (arg (call payload-part inner held))
            (arg (call Typed (call load-local refined-payload pattern) held))
            (arg failed)
          )
        )
      )
    )
    (let held value)
    (if (call (. types is-optional) (. held type))
      (let type (. held type))
      (let tested (call present pattern held))
      (call pass-or-fail (. tested operand) failed)
      (= held (call payload pattern (call Typed (. held operand) type)))
    )
    (let union (. held type))
    (if (or (== (call intrinsic union) .table-row) (== (call intrinsic union) .immutable-table-row))
      (return (call match-row-case pattern inner held failed))
    )
    (let index (call (. facts case-of) (. unit reading) pattern))
    (let layout (call layout-of union pattern))
    (if (or (!= (call (. facts plan-of) (. unit reading) pattern) .plan-case) (== index (. U32 max)) not-union)
      (call refuse .refused-expression pattern)
      (return (call Typed nothing no-type))
    )
    (lazy not-union (not (call (. tables layouts is-union) layout)))
    (if (>= index (. ([] (. tables layouts rows) layout) cases count))
      (call refuse .refused-expression pattern)
      (return (call Typed nothing no-type))
    )
    (let machine (call machine-of-union union))
    (if (and switching (== (. value operand) switched-subject) (== switched-value (as index U64)))
      (= switching false)
      (else-if (and machine (== inner 0) (. matching testing) (not (call reads-machine (. matching tested) machine)))
        (call pass-within pattern machine (. held operand) index failed)
      )
      (else-if (and machine (== inner 0) (. matching testing) (or (!= (. machine store) .store-member) (not (call tests-tag))))
        (call pass-or-fail (. (call machine-flag pattern machine index failed) operand) failed)
      )
      (else
        (call pass-or-fail (call case-test pattern (. held operand) index) failed)
      )
    )
    (if (== inner 0)
      (return (call Typed (. held operand) union))
    )
    (let field (call (. tables layouts case-field) layout index))
    (if (or (== (. field type) no-type) (== (. field type) invalid-type))
      (call refuse .refused-expression pattern)
      (return (call Typed nothing no-type))
    )
    (return
      (call emit-pattern
        (block
          (arg (call payload-part inner (. field type)))
          (arg (call Typed (call take (. held operand) field pattern) (. field type)))
          (arg failed)
        )
      )
    )
  )
  (fn-do _ member-flag Typed
    (param lhs SyntaxId)
    (param pattern SyntaxId)
    (param machine MachineFact)
    ; Whether the case a pattern names of a state machine a property of a class holds is active,
    ; as the reference tests it: the object's flag of the case, read from the object written before
    ; the property's name, which is evaluated once, or from the object a name alone is read from
    ; (`self-owner`), where a name written tracked is tracked as it is read. Any other value of the
    ; machine's union has no shape here. A case a refinement of the machine adds is tested as
    ; `refined-case` reads it, from any object written before the property's name, and is not
    ; active where no object reaches the test (`unreached-refined`), though the object is evaluated
    ; all the same.
    (let nothing (call make-operand .operand-void 0))
    (if (== (call (. facts plan-of) (. unit reading) pattern) .plan-refined-case)
      (if (call unreached-refined lhs pattern true)
        (match? ([] (. tree nodes) lhs)
          (case (call .node-get-expression row)
            (do
              (inline (call emit-expression (. row object)))
            )
          )
        )
        (return (call Typed (call integer .machine-u8 0) (. types bool-type)))
      )
      (do
        (inline (call refined-case lhs pattern false true))
      )
      (return (call Typed (call load-local refined-flag pattern) (. types bool-type)))
    )
    (let index (call (. facts case-of) (. unit reading) pattern))
    (let property (call decl-name (. machine module) (. machine decl)))
    (let machine-tree (. ([] (. program modules) (. machine module)) tree))
    (let cases
      (call (. machine-tree machine-cases)
        (block
          (arg (call (. machine-tree state-items) (call (. machine-tree state-body) (. machine syntax))))
        )
      )
    )
    (if (or (!= (call (. facts plan-of) (. unit reading) pattern) .plan-case) (== index (. U32 max)) (not property) past-cases)
      (call refuse .refused-expression pattern)
      (return (call Typed nothing no-type))
    )
    (lazy past-cases (>= (as index U64) (as (. cases length) U64)))
    (let name
      (call (. program store-atom) (str "(" (. property text) "-" state-text "-active)")
        (block
          (lazy state-text (. (!! (call (. machine-tree state-name) ([] cases index))) text))
        )
      )
    )
    (let base nothing)
    (let owner no-type)
    (match? ([] (. tree nodes) lhs)
      (case (call .node-get-expression row)
        (if (and (== (. row name) property) (not (call is-link lhs)))
          (= owner (call held-type (. row object)))
          (= base (. (call emit-expression (. row object)) operand))
        )
      )
      (case (call .node-identifier row)
        (let binding (. ([] (. instances rows) (. unit reading)) binding))
        (let resolution
          (scope (if-expr (!= binding no-binding) resolved (call Resolution .resolve-none 0))
            (lazy resolved (call (. bindings resolution-of) binding lhs))
          )
        )
        (if (and (== (. row name) property) (== (. resolution kind) .resolve-member))
          (= owner (call self-owner))
          (= base (. unit self))
          (if (and (!= owner no-type) (. row is-tracked) (!= (. live-actions length) 0))
            (call track-name lhs (. row name))
          )
        )
      )
    )
    (if (or (== owner no-type) (== owner invalid-type) (not (call (. tables is-class) owner)))
      (call refuse .refused-expression lhs)
      (return (call Typed nothing no-type))
    )
    (let found (call property-of owner name))
    (if (not found)
      (call refuse .refused-expression lhs)
      (return (call Typed nothing no-type))
    )
    (let field (call held-field lhs owner found))
    (return (call Typed (call load base (. field offset) (. field layout) lhs) (. types bool-type)))
  )
  (fn-do _ refined-case TypeId
    (param subject SyntaxId)
    (param pattern SyntaxId)
    (param reads Bool)
    (param evaluates Bool)
    ; Reads, for a pattern that names a case a refinement of the machine of a property of a class
    ; adds, whether the case is active, into `refined-flag`, and what it holds, into
    ; `refined-payload`, and answers its type, as the reference reads them: from the object the
    ; property is read from, a local or the one a name alone is read from, or any expression written
    ; before the property's name where it is evaluated only here (`evaluates`), by the composite of
    ; the object's class, the object's flag of the case and what the object keeps for the piece that
    ; writes it, where it holds anything and that `reads` it, else `Void`. An object of a class whose
    ; composite has none of it is not in the case. A class the object is written as that no
    ; composite with the case is of, nor any class below it, has no shape here.
    (= refined-flag no-local)
    (= refined-payload no-local)
    (let name (call (. tree pattern-case-name) pattern))
    (let union (if-expr (!= subject 0) (call (. facts node-type) (. unit reading) subject) no-type))
    (let root (call machine-of-union union))
    (let property (only-if (call decl-name (. root module) (. root decl)) (if root)))
    (let owner (call refined-owner subject pattern evaluates))
    (let object (call make-operand .operand-void 0))
    (if (!= owner no-type)
      (match? ([] (. tree nodes) subject)
        (case (call .node-get-expression row)
          (= object (. (call emit-expression (. row object)) operand))
        )
        (case .node-identifier
          (= object (. unit self))
        )
      )
    )
    (if (or (== owner no-type) (== owner invalid-type) (not (call (. tables is-class) owner)))
      (call refuse .refused-expression pattern)
      (return no-type)
    )
    (let held no-type)
    (let found false)
    (= refined-flag (call (. ir add-local) u8-layout))
    (call store-local refined-flag (call integer .machine-u8 0) pattern)
    (let joined (call (. ir reserve-block)))
    (for (in position (. tables machine-order))
      (let fact ([] (. facts machines) position))
      (let classes (call composite-classes fact (!! root) owner))
      (let level (call (. tables machine-receiver) fact))
      (let composite (only-if (call compose-machine program facts fact) (if (!= (. classes length) 0))))
      (let case (if-expr composite (call (. composite case-named) (!! name)) (. U32 max)))
      (if (or (== case (. U32 max)) (== ([] (. (!! composite) owners) case) 0))
        (continue)
      )
      (let fragment ([] (. (!! composite) pieces) ([] (. (!! composite) owners) case)))
      (let node (call (. (!! composite) node) case ([] (. (!! composite) owners) case)))
      (= found true)
      (let missed (call (. ir reserve-block)))
      (let matched (call (. ir reserve-block)))
      (call classes-branch pattern object classes matched missed)
      (call (. ir start-block) matched)
      (let flagged (call property-of level (call flag-name (!! property) (!! name))))
      (if (not flagged)
        (call refuse .refused-expression pattern)
        (return no-type)
      )
      (let flag (call held-field pattern level flagged))
      (call store-local refined-flag (call load object (. flag offset) (. flag layout) pattern) pattern)
      (if (or (not reads) (not (call union-case-holds (. fragment union) (!! name))))
        (if (and (!= held no-type) (!= held (. types void-type)))
          (call refuse .refused-expression pattern)
          (return no-type)
        )
        (= held (. types void-type))
        (call jump joined)
        (call (. ir start-block) missed)
        (continue)
      )
      (let kept (call refinement-payload fragment node level object pattern))
      (if (== held no-type)
        (= held (. kept type))
        (= refined-payload (call (. ir add-local) (call layout-of held pattern)))
      )
      (if (!= held (. kept type))
        (call refuse .refused-expression pattern)
        (return no-type)
      )
      (call store-local refined-payload (. kept operand) pattern)
      (call jump joined)
      (call (. ir start-block) missed)
    )
    (if (not found)
      (call refuse .refused-expression pattern)
      (return no-type)
    )
    (call jump joined)
    (call (. ir start-block) joined)
    (return held)
  )
  (fn-do _ refined-owner TypeId
    (param subject SyntaxId)
    (param pattern SyntaxId)
    (param evaluates Bool)
    ; The class of the object `refined-case` reads a case a refinement adds from: that of the object
    ; written before the property's name, where it is a local or is evaluated only there
    ; (`evaluates`), or of the object a name alone is read from, or no type.
    (let name (call (. tree pattern-case-name) pattern))
    (let union (if-expr (!= subject 0) (call (. facts node-type) (. unit reading) subject) no-type))
    (let root (call machine-of-union union))
    (let property (only-if (call decl-name (. root module) (. root decl)) (if root)))
    (let owner no-type)
    (if (and property name)
      (match? ([] (. tree nodes) subject)
        (case (call .node-get-expression row)
          (let named (is ([] (. tree nodes) (. row object)) .node-identifier))
          (if (and (== (. row name) property) (not (call is-link subject)) (or named evaluates))
            (= owner (call held-type (. row object)))
          )
        )
        (case (call .node-identifier row)
          (if (and (== (. row name) property) (call resolves-member subject))
            (= owner (call self-owner))
          )
        )
      )
    )
    (return owner)
  )
  (fn-expr _ unreached-refined Bool
    (param subject SyntaxId)
    (param pattern SyntaxId)
    (param evaluates Bool (= false))
    ; Whether a pattern names a case a refinement of a machine adds that no object reaches: the
    ; program constructs no class the object `refined-case` reads it from is written as, nor any
    ; class below it.
    (case? (!= (call (. facts plan-of) (. unit reading) pattern) .plan-refined-case)
      false
    )
    (default
      (and (!= owner no-type) (!= owner invalid-type) (call (. tables is-class) owner) (not (call (. tables constructs-from) owner)))
    )
    (where
      (lazy owner (call refined-owner subject pattern evaluates))
    )
  )
  (fn-do _ refinement-payload Typed
    (param fragment MachineFact)
    (param node SyntaxId)
    (param level TypeId)
    (param object Operand)
    (param site SyntaxId)
    ; What a case a refinement adds holds, read from what an object of a class keeps for the
    ; refinement: the environment of the refinement's function, which the property that holds its
    ; part holds (`part-name`). One that holds a tuple or a struct has no shape here.
    (let nothing (call make-operand .operand-void 0))
    (let holder (call part-name fragment))
    (let found (only-if (call property-of level holder) (if holder)))
    (let row (call (. bindings machine-slots) (. fragment module) (. fragment syntax)))
    (let slot (if-expr row (call (. bindings machine-slot) row node (call (. program store-atom) "(payload)")) no-slot))
    (let layout ([] (. tables environments) (. fragment instance)))
    (if (or (not found) (== slot no-slot) (== layout no-layout) (== layout unbuilt-environment))
      (call refuse .refused-expression site)
      (return (call Typed nothing no-type))
    )
    (let field (call held-field site level found))
    (let data (. (call (. tables layouts field) (. tables layouts function-layout) 1) offset))
    (let environment (call load object (+ (. field offset) data) managed-layout site))
    (let kept (call (. tables layouts field) layout (+ 1 ([] (. tables slot-fields) slot))))
    (if (call (. tables layouts is-struct) (. kept layout))
      (call refuse .refused-expression site)
      (return (call Typed nothing no-type))
    )
    (return (call Typed (call load environment (. kept offset) (. kept layout) site) (. kept type)))
  )
  (fn-do _ union-case-holds Bool
    (param union TypeId)
    (param name Atom)
    ; Whether the case of a name of a state machine's union holds a value.
    (let position 0u32)
    (for (in fact ([] (. types cases) (. (call (. types completion-of) union) cases)))
      (if (and (. fact name) (== (!! (. fact name)) name))
        (match? ([] (. types rows) union)
          (case (call .type-named-union row)
            (return (!= (call (. types child-type) (. row cases) position) (. types void-type)))
          )
        )
        (return false)
      )
      (+= position 1)
    )
    (return false)
  )
  (fn-expr _ tests-tag Bool
    ; Whether a case test of a state machine a property of a class holds compares the tag of its
    ; union, as the reference compiles it before it declares the machine's flags: in the first
    ; value of a property, and in the function that evaluates it again.
    (or (== (. function kind) .property-updater) (and (!= (. filling count) 0) (!= (. unit reading) (. unit instance))))
  )
  (fn-do _ match-row-case Typed
    (param pattern SyntaxId)
    (param inner SyntaxId)
    (param value Typed)
    (param failed IRBlockId)
    ; A pattern that names a case of a row of a table of unions: the row's tag is tested, and a
    ; name the pattern declares for what the case holds stands for the row's cells. Any other
    ; pattern for what the case holds is matched against the case gathered from them.
    (let nothing (call make-operand .operand-void 0))
    (let type (. value type))
    (let place (call (. tables unions of) (call table-row-type type)))
    (let index (call (. facts case-of) (. unit reading) pattern))
    (if (or (== place (. U32 max)) (!= (call (. facts plan-of) (. unit reading) pattern) .plan-case) (== index (. U32 max)))
      (call refuse .refused-expression pattern)
      (return (call Typed nothing no-type))
    )
    (let union ([] (. tables unions layouts) place))
    (if (>= index (. union cases count))
      (call refuse .refused-expression pattern)
      (return (call Typed nothing no-type))
    )
    (let located (call subject-place pattern (. value operand) type))
    (if (and switching (== (. value operand) switched-subject) (== switched-value (as index U64)))
      (= switching false)
      (else
        (let tag
          (call load
            (block
              (arg (call table-cell pattern (. located columns) (. located index) 0 u8-layout))
              (arg 0)
              (arg u8-layout)
              (arg pattern)
            )
          )
        )
        (call pass-or-fail (call compare pattern .compare-equal tag (call integer .machine-u8 index)) failed)
      )
    )
    (if (== inner 0)
      (return (call Typed (. value operand) type))
    )
    (let case-type (. ([] (. tables unions cases) (+ (. union cases start) index)) type))
    (let part inner)
    (match? ([] (. tree nodes) inner)
      (case (call .node-type-tuple row)
        (if (and (== (. row field-types count) 1) (!= (call intrinsic case-type) .tuple))
          (= part ([] (. tree children) (. row field-types start)))
        )
      )
    )
    (match? ([] (. tree nodes) part)
      (case .node-identifier
        (call bind-case-cursor part (. value operand) type place index located)
        (return (call Typed (. value operand) type))
      )
      (case (call .node-type-capture row)
        (if (== (. row type) 0)
          (call bind-case-cursor (. row id) (. value operand) type place index located)
          (return (call Typed (. value operand) type))
        )
      )
    )
    (let gathered (call gather-union-case pattern place index (. located columns) (. located index)))
    (return (call emit-pattern part gathered failed))
  )
  (fn-do _ match-fields Typed (?! Refused)
    (param pattern SyntaxId)
    (param fields (of RowRange SyntaxId))
    (param value Typed)
    (param failed IRBlockId)
    ; A pattern of several in parentheses: each is matched against the field of a tuple or a
    ; struct in its place, and the pattern passes the whole. An optional is tested for a value
    ; first, and matched as what it holds; a union of tuples has no shape here. A table or a span
    ; of one is taken apart into its columns.
    (let nothing (call make-operand .operand-void 0))
    (if (call (. types is-optional) (. value type))
      (let type (. value type))
      (let tested (call present pattern value))
      (call pass-or-fail (. tested operand) failed)
      (let held (call payload pattern (call Typed (. value operand) type)))
      (return (call match-fields pattern fields held failed))
    )
    (let owner (. value type))
    (let layout (call layout-of owner pattern))
    (if (call is-row-source (call intrinsic owner))
      (return (call match-columns fields value layout))
    )
    (if (or (not (call is-aggregate owner)) (not (call (. tables layouts is-struct) layout)))
      (call refuse .refused-expression pattern)
      (return (call Typed nothing no-type))
    )
    (if (< (. ([] (. tables layouts rows) layout) fields count) (. fields count))
      (call refuse .refused-expression pattern)
      (return (call Typed nothing no-type))
    )
    (for (in position (..< 0 (. fields count)))
      (let field (call (. tables layouts field) layout position))
      (call emit-pattern
        (block
          (arg ([] (. tree children) (+ (. fields start) position)))
          (arg (call Typed (call take (. value operand) field pattern) (call field-type owner position)))
          (arg failed)
        )
      )
    )
    (return (call Typed (. value operand) owner))
  )
  (fn-do _ match-columns Typed
    (param fields (of RowRange SyntaxId))
    (param value Typed)
    (param layout LayoutId)
    ; A pattern of several in parentheses matched against a table or a span of one, which it
    ; takes apart as TypeScript does: each field is a view of its column, of the type the name
    ; written for it holds, and the name is bound to it. One written as `_` still has the table
    ; checked. Any other pattern of a column has no shape here. The pattern passes the table.
    (let owner (. value type))
    (let binding (. ([] (. instances rows) (. unit reading)) binding))
    (for (in position (..< 0 (. fields count)))
      (let field ([] (. tree children) (+ (. fields start) position)))
      (let name SyntaxId 0)
      (match? ([] (. tree nodes) field)
        (case .node-type-wildcard
          (call table-source field (. value operand) owner layout)
          (continue)
        )
        (case .node-identifier
          (= name field)
        )
        (case (call .node-type-capture row)
          (if (== (. row type) 0)
            (= name (. row id))
          )
        )
      )
      (if (or (== name 0) (== binding no-binding) (!= (. unit reading) (. unit instance)))
        (call refuse .refused-expression field)
        (break)
      )
      (let resolution (call (. bindings resolution-of) binding name))
      (if (!= (. resolution kind) .resolve-slot)
        (call refuse .refused-expression field)
        (break)
      )
      (let held (call (. facts slot-type) (. unit instance) (call slot-offset (. resolution slot) name)))
      (let view (call table-view field (. value operand) owner layout position held))
      (call bind-name name (call Typed (. view operand) held))
    )
    (return (call Typed (. value operand) owner))
  )
  (fn-do _ read-part Typed
    (param site SyntaxId)
    (param fact FactId)
    (param subject Operand)
    (param type TypeId)
    (param argument Operand)
    (param given TypeId (= no-type))
    ; A call a pattern of a list makes on its subject, which the type pass recorded at the
    ; pattern or at the pattern of an item. One whose function raises an error has no shape.
    (if (and (!= fact no-fact) (!= (. ([] (. facts calls) fact) callee) no-instance))
      (if (!= (. ([] (. instances signatures) (. ([] (. facts calls) fact) callee)) errors count) 0)
        (call refuse .refused-expression site)
        (return (call Typed (call make-operand .operand-void 0) no-type))
      )
    )
    (return (call call-protocol site fact subject type argument given false))
  )
  (fn-do _ match-text Typed
    (param pattern SyntaxId)
    (param value Typed)
    (param failed IRBlockId)
    ; A pattern of texts, as the type pass planned it for a `String`. Its length is read and is
    ; to be no less than that of the texts written; then the texts before the rest are to start
    ; it and those after to end it, by the calls recorded at the pattern. Unless the pattern only
    ; tests, a name given a text is bound to that text, and a rest with a name to what lies
    ; between, read by its range from the length read again. The pattern passes the subject.
    (let nothing (call make-operand .operand-void 0))
    (let type (. value type))
    (let parts (list SyntaxId))
    (call (. tree text-parts) pattern parts)
    (let prefix "")
    (let suffix "")
    (let rest SyntaxId 0)
    (for (in part parts)
      (let text (call (. tree text-of) part))
      (if (not text)
        (= rest part)
        (else-if (== rest 0)
          (= prefix (str prefix text))
        )
        (else
          (= suffix (str suffix text))
        )
      )
    )
    (let measured (call (. facts call-in-role) (. unit reading) pattern .role-length))
    (if (or (== rest 0) (== measured no-fact))
      (call refuse .refused-expression pattern)
      (return (call Typed nothing no-type))
    )
    (let length (call read-part pattern measured (. value operand) type nothing))
    (if (!= (. length type) (. types size-type))
      (call refuse .refused-expression pattern)
      (return (call Typed nothing no-type))
    )
    (let least (call integer .machine-u64 (as (+ (. prefix length) (. suffix length)) U64)))
    (call pass-or-fail (call compare pattern .compare-greater-equal (. length operand) least) failed)
    (let role CallRole .role-prefix)
    (for (in text (list prefix suffix))
      (let side role)
      (= role .role-suffix)
      (if (== (. text length) 0)
        (continue)
      )
      (let tested
        (call read-part
          (block
            (arg pattern)
            (arg (call (. facts call-in-role) (. unit reading) pattern side))
            (arg (. value operand))
            (arg type)
            (arg (call make-operand .operand-constant (call (. ir add-string) text)))
            (arg (. types string-type))
          )
        )
      )
      (if (!= (. tested type) (. types bool-type))
        (call refuse .refused-expression pattern)
        (return (call Typed nothing no-type))
      )
      (call pass-or-fail (. tested operand) failed)
    )
    (if (not (. matching testing))
      (for (in part parts)
        (match? ([] (. tree nodes) part)
          (case (call .node-type-capture row)
            (call bind-name
              (block
                (arg (. row id))
                (arg (call Typed (call make-operand .operand-constant (call (. ir add-string) (!! (call (. tree text-of) part)))) (. types string-type)))
              )
            )
          )
        )
      )
    )
    (if (and (not (. matching testing)) (call (. tree has-name) rest))
      (let again (call read-part pattern measured (. value operand) type nothing))
      (let end (. again operand))
      (if (!= (. suffix length) 0)
        (= end
          (call arithmetic
            (block
              (arg pattern)
              (arg .arithmetic-subtract)
              (arg (. again operand))
              (arg (call integer .machine-u64 (as (. suffix length) U64)))
              (arg u64-layout)
            )
          )
        )
      )
      (call match-rest
        (block
          (arg rest)
          (arg (. value operand))
          (arg type)
          (arg (call integer .machine-u64 (as (. prefix length) U64)))
          (arg end)
          (arg false)
          (arg failed)
        )
      )
    )
    (return (call Typed (. value operand) type))
  )
  (fn-do _ match-items Typed
    (param pattern SyntaxId)
    (param items (of RowRange SyntaxId))
    (param value Typed)
    (param failed IRBlockId)
    ; A pattern of a list, as the type pass planned it. The subject is first what an optional
    ; holds, or the case of a union the pattern has conversions for. Its length is read once
    ; and tested: as many items as the pattern writes, or no fewer where it writes a rest. Each
    ; item before the rest is then read at its place and matched, each after the rest at its
    ; place from the end, and last a rest with a name is read by the range of what lies
    ; between, unless the pattern only tests. The rows of a table or a span of one, and the items
    ; of a view of a field's column, are counted and read as TypeScript answers `t.length` and
    ; `t[i]`, and a rest of them with a name is the span or the view `t[a .. < b]` gives. The
    ; pattern passes the subject.
    (let nothing (call make-operand .operand-void 0))
    (let subject value)
    (if (or (call (. types is-optional) (. subject type)) (== (call intrinsic (. subject type)) .union))
      (= subject (call match-type pattern (call Typed (. value operand) (. subject type)) failed))
    )
    (let type (. subject type))
    (let views (call reads-views pattern type))
    (let layout (if-expr views (call layout-of type pattern) no-layout))
    (let count (. items count))
    (let rest count)
    (for (in position (..< 0 count))
      (match? ([] (. tree nodes) ([] (. tree children) (+ (. items start) position)))
        (case .node-type-remainder
          (= rest position)
        )
      )
    )
    (let fixed (if-expr (== rest count) count (- count 1)))
    (let length (call list-length pattern (. subject operand) type views layout))
    (let wanted (call integer .machine-u64 fixed))
    (call pass-or-fail
      (block
        (arg
          (call compare
            (block
              (arg pattern)
              (arg (if-expr (== rest count) .compare-equal .compare-greater-equal))
              (arg (. length operand))
              (arg wanted)
            )
          )
        )
        (arg failed)
      )
    )
    (for (in position (..< 0 count))
      (if (== position rest)
        (continue)
      )
      (let item ([] (. tree children) (+ (. items start) position)))
      (let index (call integer .machine-u64 position))
      (if (> position rest)
        (= index
          (call arithmetic
            (block
              (arg item)
              (arg .arithmetic-subtract)
              (arg (. length operand))
              (arg (call integer .machine-u64 (- count position)))
              (arg u64-layout)
            )
          )
        )
      )
      (let reading-call (call call-at item .call-item-read))
      (let read (call Typed nothing no-type))
      (if views
        (= read (call view-item item reading-call (. subject operand) type layout index))
        (else
          (= read (call read-part item reading-call (. subject operand) type index (. types index-type)))
        )
      )
      (call emit-pattern item read failed)
    )
    (if (and (!= rest count) (not (. matching testing)))
      (let end length)
      (if (!= (+ rest 1) count)
        (let arithmeticd
          (call arithmetic
            (block
              (arg pattern)
              (arg .arithmetic-subtract)
              (arg (. length operand))
              (arg (call integer .machine-u64 (- count rest 1)))
              (arg u64-layout)
            )
          )
        )
        (= end (call Typed arithmeticd (. end type)))
      )
      (call match-rest
        (block
          (arg ([] (. tree children) (+ (. items start) rest)))
          (arg (. subject operand))
          (arg type)
          (arg (call integer .machine-u64 rest))
          (arg (. end operand))
          (arg views)
          (arg failed)
        )
      )
    )
    (return (call Typed (. subject operand) type))
  )
  (fn-do _ list-length Typed
    (param pattern SyntaxId)
    (param subject Operand)
    (param type TypeId)
    (param views Bool)
    (param layout LayoutId)
    (let nothing (call make-operand .operand-void 0))
    (let measured (call (. facts call-in-role) (. unit reading) pattern .role-length))
    (let length (call Typed nothing no-type))
    (if views
      (= length (call view-length pattern subject type layout))
      (else-if (!= measured no-fact)
        (= length (call read-part pattern measured subject type nothing))
      )
      (else
        (= length (call array-length pattern subject type (call (. facts place-of) (. unit reading) pattern)))
      )
    )
    (if (!= (. length type) (. types size-type))
      (call refuse .refused-expression pattern)
      (return (call Typed nothing no-type))
    )
    (return length)
  )
  (fn-expr _ reads-views Bool
    (param pattern SyntaxId)
    (param type TypeId)
    ; Whether the type pass planned a pattern of a list to read the rows of a table or a span of
    ; one, or the items of a view of a field's column, as TypeScript answers them.
    (and (call (. facts reads-rows) (. unit reading) pattern) viewed)
    (where
      (lazy kind (call intrinsic type))
      (lazy viewed (or (call is-row-source kind) (== kind .table-column) (== kind .immutable-table-column)))
    )
  )
  (fn-do _ view-length Typed
    (param id SyntaxId)
    (param held Operand)
    (param type TypeId)
    (param layout LayoutId)
    ; How many rows a table or a span of one holds, or how many items a view of a field's column
    ; does, as TypeScript counts them.
    (if (call is-row-source (call intrinsic type))
      (return (call rows-length id held type layout))
    )
    (let counted (call column-length id held layout))
    (return (call Typed (. counted operand) (. types size-type)))
  )
  (fn-do _ view-item Typed
    (param site SyntaxId)
    (param fact FactId)
    (param subject Operand)
    (param type TypeId)
    (param layout LayoutId)
    (param index Operand)
    ; The row at an index of a table or a span of one, or the item at an index of a view of a
    ; field's column, that a pattern of an item is matched against, as `t[i]` reads it.
    (if (call is-row-source (call intrinsic type))
      (return (call row-at site fact subject type layout index))
    )
    (return (call column-item site subject type index))
  )
  (fn-do _ row-at Typed
    (param site SyntaxId)
    (param fact FactId)
    (param subject Operand)
    (param type TypeId)
    (param layout LayoutId)
    (param index Operand)
    ; The row at an index of a table or a span of one that a pattern of an item is matched
    ; against, as `t[i]` reads it: of the type the read recorded at the item gives.
    (if (or (== fact no-fact) (== (. ([] (. facts calls) fact) callee) no-instance))
      (call refuse .refused-expression site)
      (return (call Typed (call make-operand .operand-void 0) no-type))
    )
    (let cursor (call row-place site subject type layout index))
    (return (call row-value site cursor (. ([] (. instances signatures) (. ([] (. facts calls) fact) callee)) returns)))
  )
  (fn-do _ match-rest _
    (param remainder SyntaxId)
    (param subject Operand)
    (param type TypeId)
    (param start Operand)
    (param end Operand)
    (param views Bool)
    (param failed IRBlockId)
    ; The rest of a pattern of a list, where it has a name: the range from `start` to `end` is
    ; made by the construction the type pass recorded at the rest, with a step of one, and the
    ; subject is read by it with the call in the rest's role, or of the rows of a table, a span of one or
    ; a view of a field's column, made their span or view as `t[a .. < b]` makes it. What it gives is
    ; matched by the name.
    (let name SyntaxId 0)
    (match? ([] (. tree nodes) remainder)
      (case (call .node-type-remainder row)
        (= name (. row name))
      )
    )
    (if (== name 0)
      (return)
    )
    (let made (call call-at remainder .call-constructor))
    (let sliced (call (. facts call-in-role) (. unit reading) remainder .role-rest))
    (if (or (== made no-fact) (== sliced no-fact) (== (. ([] (. facts calls) sliced) callee) no-instance))
      (call refuse .refused-expression remainder)
      (return)
    )
    (let range (call (. instances argument-type) (. ([] (. facts calls) sliced) callee) 0))
    (let layout (call layout-of range remainder))
    (let mark (. given length))
    (+= given (call Typed start (. types index-type)))
    (+= given (call Typed end (. types index-type)))
    (+= given (call Typed (call integer .machine-u64 1) (. types index-type)))
    (let span (call make-fields range layout (. ([] (. facts calls) made) fills) mark 3 remainder))
    (call drop-given mark)
    (let sliced-type (. ([] (. instances signatures) (. ([] (. facts calls) sliced) callee)) returns))
    (let read
      (block
        (case? views
          (call span-of remainder subject type span range 0 sliced-type)
        )
        (default
          (call read-part remainder sliced subject type span range)
        )
      )
    )
    (call emit-pattern name read failed)
  )
  (fn-do _ match-keys Typed
    (param pattern SyntaxId)
    (param items (of RowRange SyntaxId))
    (param value Typed)
    (param failed IRBlockId)
    ; A pattern of a map, as the type pass planned it. The subject is first what an optional
    ; holds, or the case of a union the pattern has conversions for. Each key written is
    ; evaluated, converted as recorded at the key, and read by the call recorded at its item: a
    ; key the map lacks does not match, and what a key holds is matched by the pattern written
    ; for it. Last a rest with a name is the subject without the keys matched, unless the
    ; pattern only tests. The pattern passes the subject.
    (let nothing (call make-operand .operand-void 0))
    (let subject value)
    (if (or (call (. types is-optional) (. subject type)) (== (call intrinsic (. subject type)) .union))
      (= subject (call match-type pattern (call Typed (. value operand) (. subject type)) failed))
    )
    (let type (. subject type))
    (let mark (. given length))
    (let rest SyntaxId 0)
    (for (in item ([] (. tree children) items))
      (match ([] (. tree nodes) item)
        (case (call .node-type-map-item row)
          (let key (call convert (. row key) .reason-argument (call emit-expression (call (. tree key-of) (. row key)))))
          (let keyed (. key type))
          (let read
            (call read-part
              (block
                (arg item)
                (arg (call call-at item .call-item-read))
                (arg (. subject operand))
                (arg type)
                (arg (. key operand))
                (arg keyed)
              )
            )
          )
          (if (call (. types is-optional) (. read type))
            (let maybe (. read type))
            (call pass-or-fail (. (call present item read) operand) failed)
            (= read (call payload item (call Typed (. read operand) maybe)))
          )
          (+= given (call Typed (. key operand) keyed))
          (+= given read)
          (call emit-pattern (. row value) read failed)
        )
        (case (call .node-type-remainder row)
          (if (!= (. row name) 0)
            (= rest item)
          )
        )
        (default
          (call refuse .refused-expression item)
          (return (call Typed nothing no-type))
        )
      )
    )
    (if (and (!= rest 0) (not (. matching testing)))
      (call match-unmatched rest (. subject operand) type mark failed)
    )
    (call drop-given mark)
    (return (call Typed (. subject operand) type))
  )
  (fn-do _ match-unmatched _
    (param remainder SyntaxId)
    (param subject Operand)
    (param type TypeId)
    (param mark Size)
    (param failed IRBlockId)
    ; The rest of a pattern of a map, where it has a name: an empty map of the subject's type is
    ; made by the construction the type pass recorded at the rest, each key matched, held with
    ; what it holds from `mark` on, is stored in it by the call in the store's role, and the rest is
    ; what the call in the rest's role gives of the subject and that map. The name matches it.
    (let name SyntaxId 0)
    (match? ([] (. tree nodes) remainder)
      (case (call .node-type-remainder row)
        (= name (. row name))
      )
    )
    (let made (call call-at remainder .call-constructor))
    (let stored (call (. facts call-in-role) (. unit reading) remainder .role-store))
    (let taken (call (. facts call-in-role) (. unit reading) remainder .role-rest))
    (if (or (== made no-fact) (== stored no-fact) (== taken no-fact))
      (call refuse .refused-expression remainder)
      (return)
    )
    (let matched (call emit-fact-call remainder ([] (. facts calls) made) 0 (call (of RowRange SyntaxId)) 0 0 type))
    (if (!= (. matched type) type)
      (call refuse .refused-expression remainder)
      (return)
    )
    (let end (. given length))
    (let position mark)
    (while (< position end)
      (call call-made remainder stored (. matched operand) type position 2)
      (+= position 2)
    )
    (+= given (call Typed (. matched operand) type))
    (let left (call call-made remainder taken subject type end 1))
    (call drop-given end)
    (call emit-pattern name left failed)
  )
  (fn-do _ call-made Typed
    (param site SyntaxId)
    (param fact FactId)
    (param receiver Operand)
    (param type TypeId)
    (param start Size)
    (param count U32)
    ; A call a pattern makes that no call in the source writes, which the type pass recorded at
    ; the pattern: of a function declared for the receiver's type that raises no error, with the
    ; receiver as it is and the arguments held from `start` on, each of the type the function
    ; takes. A function some class declares again is chosen by the class of the object. Any
    ; other has no shape here.
    (let nothing (call make-operand .operand-void 0))
    (if (or (== fact no-fact) (== (. ([] (. facts calls) fact) callee) no-instance) uncallable)
      (call refuse .refused-expression site)
      (return (call Typed nothing no-type))
    )
    (lazy uncallable (not (call is-callable (. ([] (. facts calls) fact) callee))))
    (let callee (. ([] (. facts calls) fact) callee))
    (let signature ([] (. instances signatures) callee))
    (if (or (!= (. ([] (. instances rows) callee) self-type) type) (!= (. signature args count) count) signature-raises)
      (call refuse .refused-expression site)
      (return (call Typed nothing no-type))
    )
    (lazy signature-raises (!= (. signature errors count) 0))
    (for (in offset (..< 0 count))
      (if (!= (call (. instances argument-type) callee offset) (. ([] given (+ start offset)) type))
        (call refuse .refused-expression site)
        (return (call Typed nothing no-type))
      )
    )
    (let pended (. pending length))
    (+= pending receiver)
    (for (in offset (..< 0 count))
      (+= pending (. ([] given (+ start offset)) operand))
    )
    (if (and (call (. tables is-class) type) (call (. tables is-overridden) callee))
      (return (call call-method callee site pended))
    )
    (return (call call-instance callee site pended))
  )
  (fn-do + emit-match Typed
    (param id SyntaxId)
    (param pattern SyntaxId)
    ; A match with no subject, whose arms are conditions tested in order. The value of the arm
    ; taken is the value of the match. Where the arms end in no else and none is taken, the
    ; match is an optional that holds nothing, as the type pass typed it.
    (let nothing (call make-operand .operand-void 0))
    (if (== pattern 0)
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (let type (call (. facts node-type) (. unit reading) id))
    (let layout (call layout-of type id))
    (let joined (call (. ir reserve-block)))
    (let slot (call join-slot layout))
    (let mark (. joins length))
    (let is-closed (call emit-arms id pattern type joined slot))
    (if (not is-closed)
      (if (call (. types is-optional) type)
        (call arrive id (. (call empty-optional type layout) operand) joined slot)
        (else
          (call refuse .refused-expression id)
        )
      )
    )
    (let result (call close-joins joined mark layout slot))
    (return (call Typed result type))
  )
  (fn-do + run-arms _
    (param id SyntaxId)
    (param pattern SyntaxId)
    ; A match with no subject whose arms give no value: the conditions are tested in order, and
    ; the arm taken is run for what it does. Where none is taken nothing is run.
    (if (== pattern 0)
      (call refuse .refused-statement id)
      (return)
    )
    (let joined (call (. ir reserve-block)))
    (let is-closed (call emit-arms id pattern no-type joined (call make-operand .operand-void 0)))
    (if (not is-closed)
      (call jump joined)
    )
    (call (. ir start-block) joined)
  )
  (fn-do _ emit-arms Bool (?! Refused)
    (param site SyntaxId)
    (param pattern SyntaxId)
    (param type TypeId)
    (param joined IRBlockId)
    (param slot Operand)
    (param places Bool (= false))
    ; Emits the arms of a match in order, and says whether an else ended them. Each arm leaves
    ; its value and the block it ends in for the match to join, or where it `places`, in an inlined
    ; body, the place its answer gives (`place-arm`). An arm that is a test and no more gives what
    ; it tested where that tests as true: of an optional, what it holds. The body of an arm that
    ; tests a condition reads what the condition gave as its `it`. An arm that raises for whatever
    ; is left ends them as an else does. Where the arms place, an arm that is a test and no more and
    ; an arm that raises have no shape.
    (match? ([] (. tree nodes) pattern)
      (case (call .node-type-or row)
        (if (call emit-arms site (. row left) type joined slot places)
          (return true)
        )
        (return (call emit-arms site (. row right) type joined slot places))
      )
      (case (call .node-type-transform row)
        (let condition SyntaxId 0)
        (let is-else (== (. row pattern) 0))
        (if (not is-else)
          (match? ([] (. tree nodes) (. row pattern))
            (case .node-type-wildcard
              (= is-else true)
            )
            (case (call .node-type-predicate predicate)
              (= condition (. predicate expr))
            )
          )
        )
        (if (and places (== (call (. facts plan-of) (. unit reading) pattern) .plan-raise))
          (call refuse .refused-expression pattern)
          (return false)
        )
        (if is-else
          (call leave-arm site pattern (. row expr) type joined slot places)
          (return true)
        )
        (if (== condition 0)
          (call refuse .refused-expression pattern)
          (return false)
        )
        (let given (call emit-expression condition))
        (let given-type (. given type))
        (let tested (call test condition given))
        (let taken (call (. ir reserve-block)))
        (let passed (call (. ir reserve-block)))
        (call branch (. tested operand) taken passed)
        (call (. ir start-block) taken)
        (let named (. bound length))
        (let it-slot (call arm-slot-of pattern .slot-it))
        (if (!= it-slot no-slot)
          (+= bound (call BoundValue it-slot given-type (. given operand)))
        )
        (call leave-arm site pattern (. row expr) type joined slot places)
        (call drop-bound named)
        (call (. ir start-block) passed)
        (return false)
      )
      (case (call .node-type-predicate row)
        (if places
          (call refuse .refused-expression pattern)
          (return false)
        )
        (let subject (call emit-expression (. row expr)))
        (let held (. subject type))
        (let tested (call test (. row expr) (call Typed (. subject operand) held)))
        (let taken (call (. ir reserve-block)))
        (let passed (call (. ir reserve-block)))
        (call branch (. tested operand) taken passed)
        (call (. ir start-block) taken)
        (let value (call Typed (. subject operand) held))
        (if (and (!= held type) (call holds held type))
          (= value (call payload (. row expr) value))
        )
        (if (!= (. value type) type)
          (= value (call join site value))
        )
        (if (!= (. value type) type)
          (call refuse .refused-conversion pattern)
        )
        (call arrive site (. value operand) joined slot)
        (call (. ir start-block) passed)
        (return false)
      )
      (case (call .node-type-panic row)
        (if places
          (call refuse .refused-expression pattern)
          (return false)
        )
        (match? ([] (. tree nodes) (. row pattern))
          (case (call .node-type-transform arm)
            (if (and (== (. arm pattern) 0) (!= (. arm expr) 0))
              (call raise-given pattern (. arm expr) (. row pattern))
              (return true)
            )
            (if (!= (. arm expr) 0)
              (match? ([] (. tree nodes) (. arm pattern))
                (case (call .node-type-predicate predicate)
                  (let given (call emit-expression (. predicate expr)))
                  (let tested (call test (. predicate expr) given))
                  (let taken (call (. ir reserve-block)))
                  (let passed (call (. ir reserve-block)))
                  (call branch (. tested operand) taken passed)
                  (call (. ir start-block) taken)
                  (call raise-given pattern (. arm expr) (. row pattern))
                  (call (. ir start-block) passed)
                  (return false)
                )
              )
            )
          )
        )
      )
    )
    (call refuse .refused-expression pattern)
    (return false)
  )
  (fn-do _ leave-arm _ (?! Refused)
    (param site SyntaxId)
    (param pattern SyntaxId)
    (param body SyntaxId)
    (param type TypeId)
    (param joined IRBlockId)
    (param slot Operand)
    (param places Bool)
    ; Runs the body of an arm `emit-arms` takes: leaves the place its answer gives where the arms
    ; place, and otherwise its value, unless it leaves the match or raises.
    (if places
      (call place-arm body type joined)
      (else-if (and (not (call arm-leaves pattern body)) (not (call arm-raises body)))
        (call emit-arm site body type joined slot true)
      )
    )
  )
)
