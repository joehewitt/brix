(import ./program-tables)
(import ./runtime)
(import /lang/ast/decl)
(import /lang/ast/program)
(import /lang/backend/mir)
(import /lang/check/instances)
(import /lang/check/types)
(import /lang/ir/ir)

(type + Stability (is U32)
  ; What code may do to the storage of a row of a table of unions, judged from the code: `stable`
  ; where nothing in it may move the storage, `unstable` where something may, and `unsure` where
  ; what decides it is not read here.
  (blank)
  (variant stable (= 0))
  (variant unstable (= 1))
  (variant unsure (= 2))
)

(type + CallJudgment (is Tuple)
  ; What a call may do to storage. A call of a function judged by the function's own code names the
  ; function as `callee`, and is `unsure` until that code is read.
  (blank)
  (prop + stability Stability)
  (prop + callee FunctionId (= no-function))
)

(type + CalleeScan (is Tuple)
  ; What a function's own code may do to storage, and the functions it calls that are judged by
  ; their own code in turn.
  (blank)
  (prop + stability Stability)
  (prop + callees (list U32))
)

(type + ReceiverReads (is Tuple)
  ; Where a function reads its receiver. A row's `roots` is the frame or the local whose memory
  ; its value addresses, `made` says the row's value is made from the receiver, and `ahead` that
  ; the receiver is read after the row.
  (blank)
  (prop + roots (list U32))
  (prop + made (list Bool))
  (prop + ahead (list Bool))
)

(fn-do + receiver-reads ReceiverReads
  (param ir IRFunction)
  (param watched (list U32))
  ; Where a function reads its receiver, which is the arguments `watched` and any value made from
  ; them: the value of a row that reads one, and a frame or a local's memory that such a row writes
  ; or that a call reading one is given. A local holds no receiver: a value read from one is its
  ; own.
  (let count (. ir instructions length))
  (let roots (call frame-roots ir))
  (let made (list Bool))
  (let ahead (list Bool))
  (for (in _ (..< 0 count))
    (+= made false)
    (+= ahead false)
  )
  (let changed true)
  (while changed
    (= changed false)
    (for (in id (..< 0 count))
      (let span (. ([] (. ir instructions) id) operands))
      (if (not (call reads-receiver ir span made watched))
        (continue)
      )
      (if (not ([] made id))
        (= ([] made id) true)
        (= changed true)
      )
      (for (in position (..< (. span start) (. span end)))
        (let operand ([] (. ir operands) position))
        (if (== (call operand-kind operand) .operand-value)
          (let root ([] roots (call operand-payload operand)))
          (if (and (!= root (. U32 max)) (not ([] made root)))
            (= ([] made root) true)
            (= changed true)
          )
        )
      )
    )
  )
  (blank)
  (let later (list Bool))
  (for (in _ (..< 0 (. ir blocks length)))
    (+= later false)
  )
  (for (in position (..< 0 (. ir order length)))
    (let block ([] (. ir order) position))
    (let rows (. ([] (. ir blocks) block) instructions))
    (for (in id (..< (. rows start) (. rows end)))
      (if (call reads-receiver ir (. ([] (. ir instructions) id) operands) made watched)
        (= ([] later block) true)
      )
    )
  )
  (= changed true)
  (while changed
    (= changed false)
    (for (in position (..< 0 (. ir order length)))
      (let block ([] (. ir order) position))
      (if (and (not ([] later block)) (call leads-to-read ir block later))
        (= ([] later block) true)
        (= changed true)
      )
    )
  )
  (for (in position (..< 0 (. ir order length)))
    (let block ([] (. ir order) position))
    (let rows (. ([] (. ir blocks) block) instructions))
    (let reread (call leads-to-read ir block later))
    (let id (. rows end))
    (while (> id (. rows start))
      (-= id 1)
      (= ([] ahead id) reread)
      (if (call reads-receiver ir (. ([] (. ir instructions) id) operands) made watched)
        (= reread true)
      )
    )
  )
  (return (call ReceiverReads roots made ahead))
)

(fn-do + receiver-callees (list U32)
  (param ir IRFunction)
  (param tables ProgramTables)
  (param instances Instances)
  (param program Program)
  (param reads ReceiverReads)
  ; The functions judged by their own code that a function calls where it reads its receiver
  ; after the call.
  (let callees (list U32))
  (for (in id (..< 0 (. ir instructions length)))
    (let row ([] (. ir instructions) id))
    (if (or (not ([] (. reads ahead) id)) (and (!= (. row op) .op-call) (!= (. row op) .op-call-void)))
      (continue)
    )
    (let judgment (call call-judgment ir tables instances program row true))
    (if (and (!= (. judgment callee) no-function) (== (call (. callees find) (. judgment callee)) null))
      (+= callees (. judgment callee))
    )
  )
  (return callees)
)

(fn-do + receiver-stability Stability
  (param ir IRFunction)
  (param tables ProgramTables)
  (param instances Instances)
  (param program Program)
  (param reads ReceiverReads)
  (param watched (list U32))
  (param judged (list U32))
  (param verdicts (list Stability))
  ; Whether a function may move its receiver's storage before it reads the receiver again. A write
  ; into the receiver, a frame, a local's memory or the function's result moves nothing. A call
  ; does, unless it is of one of the runtime's functions that allocate, poll or find the running
  ; task, the check for a terminating task, or a function whose code was judged so: `verdicts` holds
  ; what each function of `judged` was judged to do.
  (let verdict (. Stability stable))
  (for (in id (..< 0 (. ir instructions length)))
    (if (not ([] (. reads ahead) id))
      (continue)
    )
    (let row ([] (. ir instructions) id))
    (let moved (. Stability stable))
    (if (or stores (== (. row op) .op-copy) (== (. row op) .op-zero))
      (= moved (if-expr writes .unstable .stable))
      (lazy writes (call writes-outside ir row (. reads roots) (. reads made) watched))
      (else-if (or (== (. row op) .op-call) (== (. row op) .op-call-void))
        (let judgment (call call-judgment ir tables instances program row true))
        (= moved (. judgment stability))
        (if (!= (. judgment callee) no-function)
          (= moved .unsure)
          (for (in position (..< 0 (. judged length)))
            (if (== ([] judged position) (. judgment callee))
              (= moved ([] verdicts position))
            )
          )
        )
      )
    )
    (lazy stores (or (== (. row op) .op-store) (== (. row op) .op-store-release)))
    (if (== moved .unstable)
      (return .unstable)
    )
    (if (== moved .unsure)
      (= verdict .unsure)
    )
  )
  (return verdict)
)

(fn-do + own-stability CalleeScan
  (param ir IRFunction)
  (param tables ProgramTables)
  (param instances Instances)
  (param program Program)
  ; What a function's own code may do to storage: any write outside the function's frame, its
  ; locals' memory and its result moves storage, and so does any call that may.
  (let callees (list U32))
  (let roots (call frame-roots ir))
  (let none (list Bool))
  (for (in _ (..< 0 (. ir instructions length)))
    (+= none false)
  )
  (let unwatched (list U32))
  (let verdict (. Stability stable))
  (for (in id (..< 0 (. ir instructions length)))
    (let row ([] (. ir instructions) id))
    (if (or stores (== (. row op) .op-copy) (== (. row op) .op-zero))
      (if (call writes-outside ir row roots none unwatched)
        (return (call CalleeScan .unstable callees))
      )
      (else-if (or (== (. row op) .op-call) (== (. row op) .op-call-void))
        (let judgment (call call-judgment ir tables instances program row false))
        (if (== (. judgment stability) .unstable)
          (return (call CalleeScan .unstable callees))
        )
        (if (!= (. judgment callee) no-function)
          (if (== (call (. callees find) (. judgment callee)) null)
            (+= callees (. judgment callee))
          )
          (else-if (== (. judgment stability) .unsure)
            (= verdict .unsure)
          )
        )
      )
    )
    (lazy stores (or (== (. row op) .op-store) (== (. row op) .op-store-release)))
  )
  (return (call CalleeScan verdict callees))
)

(fn-do _ frame-roots (list U32)
  (param ir IRFunction)
  ; For each row of a function, the frame or the local whose memory its value addresses, if any.
  (let roots (list U32))
  (for (in id (..< 0 (. ir instructions length)))
    (let row ([] (. ir instructions) id))
    (let root (. U32 max))
    (if (or (== (. row op) .op-frame) (== (. row op) .op-local-address))
      (= root (as id U32))
      (else-if (== (. row op) .op-address)
        (let base ([] (. ir operands) (. row operands start)))
        (if (== (call operand-kind base) .operand-value)
          (= root ([] roots (call operand-payload base)))
        )
      )
    )
    (+= roots root)
  )
  (return roots)
)

(fn-do _ reads-receiver Bool
  (param ir IRFunction)
  (param span Span)
  (param made (list Bool))
  (param watched (list U32))
  (for (in position (..< (. span start) (. span end)))
    (let operand ([] (. ir operands) position))
    (let kind (call operand-kind operand))
    (if (and (== kind .operand-value) ([] made (call operand-payload operand)))
      (return true)
    )
    (if (and (== kind .operand-argument) (!= (call (. watched find) (call operand-payload operand)) null))
      (return true)
    )
  )
  (return false)
)

(fn-do _ leads-to-read Bool
  (param ir IRFunction)
  (param block IRBlockId)
  (param later (list Bool))
  ; Whether a block jumps, branches or lands on a block from which the receiver is read.
  (let rows (. ([] (. ir blocks) block) instructions))
  (for (in id (..< (. rows start) (. rows end)))
    (if (== (. ([] (. ir instructions) id) op) .op-phi)
      (continue)
    )
    (let span (. ([] (. ir instructions) id) operands))
    (for (in position (..< (. span start) (. span end)))
      (let operand ([] (. ir operands) position))
      (if (and (== (call operand-kind operand) .operand-block) ([] later (call operand-payload operand)))
        (return true)
      )
    )
  )
  (return false)
)

(fn-expr _ writes-outside Bool
  (param ir IRFunction)
  (param row IRInstruction)
  (param roots (list U32))
  (param made (list Bool))
  (param watched (list U32))
  ; Whether a store, a copy or a fill writes memory other than the receiver, a frame, a local's
  ; memory or the function's result.
  (match kind
    (case= .operand-value
      (and (== ([] roots payload) (. U32 max)) (not ([] made payload)))
    )
    (case= .operand-result
      false
    )
    (default
      (or (!= kind .operand-argument) (== (call (. watched find) payload) null))
    )
  )
  (where
    (lazy target ([] (. ir operands) (. row operands start)))
    (lazy kind (call operand-kind target))
    (lazy payload (call operand-payload target))
  )
)

(fn-do _ call-judgment CallJudgment
  (param ir IRFunction)
  (param tables ProgramTables)
  (param instances Instances)
  (param program Program)
  (param row IRInstruction)
  (param top Bool)
  ; What a call may do to storage. A call of a function of the runtime that allocates, polls or
  ; finds the running task is let run, and from the function judged itself the check for a
  ; terminating task. A call of any other function of the runtime, of C, of a value or of a function
  ; the compiler generates may move storage, and so may one of a function written with `do`, of a
  ; generator or of a closure. Any other function is judged by its own code.
  (let callee (call operand-payload ([] (. ir operands) (. row operands start))))
  (let kind (as (/and/ (. row aux) callee-kind-mask) CalleeKind))
  (if (== kind .callee-runtime)
    (return (call CallJudgment (if-expr (call is-steady tables callee) .stable .unstable)))
  )
  (if (!= kind .callee-function)
    (return (call CallJudgment .unstable))
  )
  (for (in dependency (..< 0 (. ir dependencies length)))
    (let listed ([] (. ir dependencies) dependency))
    (if (and (== (. listed kind) .callee-function) (== (. ([] (. tables functions) (. listed symbol)) symbol) callee))
      (return (call function-judgment tables instances program (. listed symbol) top))
    )
  )
  (return (call CallJudgment .unsure))
)

(fn-expr _ function-judgment CallJudgment
  (param tables ProgramTables)
  (param instances Instances)
  (param program Program)
  (param callee FunctionId)
  (param top Bool)
  (case? (!= (. target kind) .instance-body)
    (call CallJudgment .unstable)
  )
  (case? (not described)
    (call CallJudgment .unsure)
  )
  (case? (== (. described kind) .termination-panic-decl)
    (call CallJudgment (if-expr top .stable .unstable))
  )
  (case? (or (. row is-generator) (. described is-imperative) (call is-closure-like (. described kind)))
    (call CallJudgment .unstable)
  )
  (case? (!= (. row row-receiver) no-type)
    (call CallJudgment .unsure)
  )
  (default
    (call CallJudgment .unsure callee)
  )
  (where
    (lazy target ([] (. tables functions) callee))
    (lazy row ([] (. instances rows) (. target instance)))
    (lazy described (call describe program (. row module) (. row decl)))
  )
)

(fn-do _ is-steady Bool
  (param tables ProgramTables)
  (param symbol U32)
  ; Whether a function of the runtime is one let run between two reads of a receiver: one that
  ; allocates, a safepoint, or the one that finds the running task.
  (for (in position (..< 0 (. runtime-function-names length)))
    (if (== ([] (. tables runtime-symbols) position) symbol)
      (let name ([] runtime-function-names position))
      (return
        (scope (or allocates (== name "brixGCSafepoint") (== name "brixTaskSafepoint") finds-task)
          (lazy allocates (or (call (. name starts-with) "brixAlloc") (call (. name starts-with) "brixGCAlloc")))
          (lazy finds-task (== name "brixGetActiveTaskHandle"))
        )
      )
    )
  )
  (return false)
)
