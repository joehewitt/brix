━━━━━━━━━━━━━━━━━━━━
_ Cleanups is facet of FunctionEmitter
    sees Lazies
    sees Loops
    sees MatchArms
    sees Tasks

_ handling-failure = false
_ cleanup-raised LocalId = no-local

────────────────────
+ do emit-finally
    - id SyntaxId
    - body SyntaxId

` Opens a cleanup: a body that runs when the block it is written in is left, by any way out.
` A panic raised from here on runs it too, so the checks that follow land on a pad of their
` own. One written in a cleanup has no shape.
if scoping.cleaning
    refuse(.refused-statement, id)
    =
open-cleanup(body, UseCell(no-local, no-local, no-type))

────────────────────
+ do open-cleanup
    - item SyntaxId
    - cell UseCell

` Opens a cleanup in the block being emitted, which runs where the block is left: a body, a
` loop's streams or a `use`, with what a `use` reads. A panic raised from here on runs it
` too, so the checks that follow land on a pad of their own.
open-cleanups += OpenCleanup(item, scoping.block-base, cell, block-effects)
landing = no-block

────────────────────
_ ending-call FactId
    - begins FactId

` The call that ends a `use`: `end-using`, the second the type pass recorded at the node, or
` `close`, the only one, where the use only closes.
if only-closes(begins) then begins else facts.calls[begins].next

────────────────────
_ do unbind-stack
    - id SyntaxId
    - cell UseCell

` Puts the slot of the global a `do with` bound back as it was before, where a way out of its
` body runs it.
. row = stack-row(id)
if row == no-storage
    refuse(.refused-statement, id)
    =
. kept = tables.storage[row]
copy
    - stack-slot(kept, id)
    - load-local(cell.held, id)
    - kept.layout
    - tables.layouts.rows[kept.layout].is-managed
    - id

────────────────────
+ do run-cleanups ?! Refused
    - mark Size
    - open Size
    - unwinding Bool = false

` Runs the cleanups from one of those open down to a mark, newest first, where the function
` is on a way out. Each is emitted again here. A panic raised in one ends that one and the
` rest still run: its checks land on what follows it. With `unwinding` a panic made the way
` out, and one raised here takes its place. On any other way out a panic raised here goes
` on once the cleanups of the block that opened them have run: it leaves through the landing
` pad of the cleanups still open, as a panic raised after the block would.
` A cleanup that may run while a panic is the task's, on a way out a panic made or after one
` of the block raised one, runs with that panic set aside. While one runs, `cleaning-open`
` counts the cleanups open around it, which an error it raises runs on its way out, and
` `cleaning-top` those open where they began to run, above which are those opened in it.
` A panic leaves the zone the collector never sees before it lands, so one that may be raised
` in a cleanup run in the zone has no shape. Each runs kept from what the `do` blocks around it
` were where it was opened, not where it runs.
. saved = landing
. inside = block-effects
. own-scoping = scoping
scoping = scoping.cleaning = true
scoping = scoping.cleaning-top = open-cleanups.length
. position = open
while position > mark
    . base = open-cleanups[position - 1].base
    if base < mark
        base = mark
    . entered = landings
    if !unwinding
        if cleanup-raised == no-local
            cleanup-raised = ir.add-local(u8-layout)
        store-local(cleanup-raised, integer(.machine-u8, 0), 0)
    while position > base
        position -= 1
        . following = ir.reserve-block()
        . raised = if unwinding then following else ir.reserve-block()
        . checks = landings
        landing = raised
        if unwinding
            scoping = scoping.unwinding-from = open-cleanups[position].body
        . aside = if unwinding || landings != entered then set-panic-aside() else no-local
        scoping = scoping.cleaning-open = position
        block-effects = open-cleanups[position].effects
        run-cleanup(open-cleanups[position].body, open-cleanups[position].cell)
        block-effects = inside
        if landings != checks && !unwinding && in-zone
            refuse(.refused-statement, open-cleanups[position].body)
        jump(following)
        if landings != checks && !unwinding
            ir.start-block(raised)
            store-local(cleanup-raised, integer(.machine-u8, 1), 0)
            jump(following)
        ir.start-block(following)
        if aside != no-local
            take-panic-back(aside)
    if landings != entered && !unwinding
        landing = saved
        scoping = scoping.cleaning = own-scoping.cleaning
        resume-panic(base)
        scoping = scoping.cleaning = true
scoping = own-scoping
landing = saved

────────────────────
_ do set-panic-aside LocalId

` Where a cleanup may run while a panic is the task's: the panic, where there is one, is set
` aside while the cleanup runs, so that nothing the cleanup calls sees it, though
` `Task().failure` reads it. The local says whether one was.
. active = make-operand(.operand-value, append(.op-load-task-panic, 0, Span(), 0, managed-layout))
. flag = ir.add-local(u8-layout)
store-local
    - flag
    - compare(0, .compare-not-equal, active, integer(managed-layout as MachineKind, 0))
    - 0
. aside = ir.reserve-block()
. body = ir.reserve-block()
branch(active, aside, body)
ir.start-block(aside)
call-runtime(.runtime-panic-begin-cleanup, 0, pending.length)
jump(body)
ir.start-block(body)
= flag

────────────────────
_ do take-panic-back
    - flag LocalId

` Where a cleanup that set a panic aside ends: the panic is the task's again, unless the
` cleanup raised another, which takes its place.
. back = ir.reserve-block()
. done = ir.reserve-block()
branch(load-local(flag, 0), back, done)
ir.start-block(back)
call-runtime(.runtime-panic-end-cleanup, 0, pending.length)
jump(done)
ir.start-block(done)

────────────────────
_ do resume-panic
    - open Size

` Where the cleanups of a block have run on a way out no panic made: a panic one of them
` raised leaves through the landing pad of the cleanups still `open`.
. flagged = ir.reserve-block()
. resumed = ir.reserve-block()
branch(load-local(cleanup-raised, 0), flagged, resumed)
ir.start-block(flagged)
jump(pad-at(open, unsourced))
ir.start-block(resumed)

────────────────────
+ do pad-at IRBlockId
    - open Size
    - site SyntaxId = 0

` The landing pad of the checks made with a number of cleanups open, which may be fewer
` than are open where the function is, made with `site` as its first check where there is
` none. The pads are in the order of those numbers.
. position = pads.length
while position != 0 && pads[position - 1].cleanups > open
    position -= 1
if position != 0 && pads[position - 1].cleanups == open
    = pads[position - 1].block
. block = ir.reserve-block()
pads += LandingPad(block, open, site, unit.source-module)
. moved = pads.length - 1
while moved > position
    pads[moved] = pads[moved - 1]
    moved -= 1
pads[position] = LandingPad(block, open, site, unit.source-module)
= block

────────────────────
+ do close-cleanups
    - mark Size

` Ends a block that opened cleanups. Where the block ends they run, newest first. Each
` landing pad made while they were open runs the ones open at its checks and goes on to the
` pad of the block around, which runs its own. In a module's main or a spawned task's body a
` pad that knows its first check runs every cleanup open and reports the panic there itself.
` A panic reaches a pad outside the zone the collector never sees, so its cleanups run there.
` They are open no longer.
if open-cleanups.length == mark
    =
. zoned = in-zone
run-cleanups(mark, open-cleanups.length)
. resumed = ir.reserve-block()
jump(resumed)
. first = pads.length
while first != 0 && pads[first - 1].cleanups > mark
    first -= 1
. outer = no-block
. made = false
if first != 0 && pads[first - 1].cleanups == mark
    outer = pads[first - 1].block
for position in first .. < pads.length
    . pad = pads[position]
    ir.start-block(pad.block)
    in-zone = false
    if (function.kind == .module-main || function.kind == .task-body) && pad.site != 0
        run-cleanups(0, pad.cleanups, true)
        leave-pad(pad)
        in-zone = zoned
        continue
    run-cleanups(mark, pad.cleanups, true)
    in-zone = zoned
    if outer == no-block
        outer = ir.reserve-block()
        made = true
    jump(outer)
while pads.length > first
    pads.pop()
while open-cleanups.length > mark
    open-cleanups.pop()
if made
    pads += LandingPad(outer, mark, opening-site(0), unit.source-module)
landing = no-block
if pads.length != 0 && pads[pads.length - 1].cleanups == mark
    landing = pads[pads.length - 1].block
ir.start-block(resumed)

────────────────────
+ do run-cleanup
    - body SyntaxId
    - cell UseCell

` One cleanup, emitted where a way out runs it: the body of a `do finally`, for the first
` header of a loop that reads a stream, a spread of one, or a pipe
` whose loop writes each item of one, the calls that end the iteration of its streams, for a
` `use` or `do use` the call that ends the use of its object, and for a `do without cancel`
` block the call that lets go of its hold on cancellation.
if cell.is-live-call
    do call-instance(instances.live.leave, body, pending.length)
    =
if writes-each(body)
    end-streams(body)
    =
match? tree.nodes[body]
    | .node-loop-syntax
        end-streams(body)
        =
    | .node-feed-expression
        end-streams(body)
        =
    | .node-use-expression
        end-use(body, cell)
        =
    | .node-use-block
        end-use(body, cell)
        =
    | .node-stack-local-binding-block
        unbind-stack(body, cell)
        =
    | .node-probe-group
        emit-probe-group-end(body, 1)
        =
    | .node-do-block
        call-runtime(.runtime-leave-cancel-shield, body, pending.length)
        =
emit-block(body)

────────────────────
_ do end-use
    - id SyntaxId
    - cell UseCell

` Ends a use where a way out of its block runs it: `ending-call` is called on the object kept.
` The object of a `use` is kept only where its flag says so, or its slot holds it, and is taken
` out first: a copy is made and the flag or the slot cleared, so a way out that runs it again
` ends nothing.
. begins = facts.first-call(unit.reading, id)
. ends = if begins == no-fact then no-fact else ending-call(begins)
if cell.held == no-local
    end-kept-use(id, ends, cell.type)
    =
. layout = ir.locals[cell.held].layout
. ended = no-block
if cell.flag != no-local
    . filled = ir.reserve-block()
    ended = ir.reserve-block()
    branch(load-local(cell.flag, id), filled, ended)
    ir.start-block(filled)
. object = load-local(cell.held, id)
if tables.layouts.is-struct(layout)
    object = snapshot(object, layout, id)
if cell.flag != no-local
    store-local(cell.flag, integer(.machine-u8, 0), id)
call-protocol(id, ends, object, cell.type, make-operand(.operand-void, 0))
if ended != no-block
    jump(ended)
    ir.start-block(ended)

────────────────────
_ do end-kept-use
    - id SyntaxId
    - ends FactId
    - type TypeId

` Ends a `use` whose slot keeps its object, where the slot holds one.
. slot = using-slot(id)
. kept = state(slot, id)
. kept-type = kept.type
. filled = ir.reserve-block()
. ended = ir.reserve-block()
branch(present(id, kept).operand, filled, ended)
ir.start-block(filled)
. object = payload(id, Typed(kept.operand, kept-type))
. layout = layout-of(type, id)
if object.type != type
    refuse(.refused-statement, id)
    =
if tables.layouts.is-struct(layout)
    object = Typed(snapshot(object.operand, layout, id), object.type)
keep-state(slot, empty-optional(kept-type, layout-of(kept-type, id)).operand, kept-type, id)
call-protocol(id, ends, object.operand, type, make-operand(.operand-void, 0))
jump(ended)
ir.start-block(ended)

────────────────────
+ do panic-on-error Typed
    - id SyntaxId
    - callee InstanceId
    - result Operand

` The value of a call that converts a text written in source. What the callee returned
` holds its value or one of its errors. An error is a panic there, with the error's text as
` its message, and what follows runs with the value.
. nothing = make-operand(.operand-void, 0)
. text = instances.report.error-text
. layout = layout-of(instances.signatures[callee].result, id)
. is-ready = text != no-instance && tables.instance-functions[text] != no-function
if !tables.layouts.is-union(layout) || !is-ready || !function.may-panic
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. count = tables.layouts.rows[layout].cases.count
. given = ir.reserve-block()
. raised = ir.reserve-block()
branch(case-test(id, result, 0), given, raised)
ir.start-block(raised)
for index in 1 .. < count
    . field = tables.layouts.case-field(layout, index)
    . next = no-block
    if index + 1 != count
        . held = ir.reserve-block()
        next = ir.reserve-block()
        branch(case-test(id, result, index), held, next)
        ir.start-block(held)
    . mark = pending.length
    pending += take(result, field, id)
    . message = call-method(text, id, mark)
    raise-message(id, message.operand)
    if next != no-block
        ir.start-block(next)
ir.start-block(given)
. field = tables.layouts.case-field(layout, 0)
= Typed(take(result, field, id), field.type)

────────────────────
+ do compiler-panic Operand
    - id SyntaxId
    - message Operand

` A panic the compiler makes with a message, at a node, or none where the program has no
` panic to make. Its constructor is given the message, and nothing for what else it takes.
` A function the collector never sees leaves that zone to make it.
. nothing = make-operand(.operand-void, 0)
. report = instances.report
. object = tables.layouts.objects[types.panic-type]
. is-ready = object != no-layout && report.source-slot != U32.max && report.trace-slot != U32.max
. made = report.panic
if !is-ready || made == no-instance || tables.instance-functions[report.source] == no-function
    refuse(.refused-expression, id)
    = nothing
if tables.instance-functions[made] == no-function
    refuse(.refused-expression, id)
    = nothing
if in-zone
    cross-zone(id, false)
    in-zone = false
. signature = instances.signatures[made]
if signature.args.count == 0 || instances.argument-type(made, 0) != types.string-type
    refuse(.refused-expression, id)
    = nothing
. mark = pending.length
pending += message
for position in 1 .. < signature.args.count
    pending += absent-argument(id, instances.argument-type(made, position)).operand
= call-instance(made, id, mark).operand

────────────────────
+ do emit-raise-panic

` The function each place that raises a panic calls, given the panic, the path of the module, a
` line and a column (`raise-at`).
add-raiser-arguments()
raise-at(make-operand(.operand-argument, 0))

────────────────────
_ do writes-each Bool
    - pipe SyntaxId

` Whether a pipe's loop, which writes each item it reads, is being emitted.
for write in writes
    if write.pipe == pipe
        = true
= false

────────────────────
+ do closing-pad IRBlockId
    - entering Bool

` The pad a checked call that `entering` the zone for it lands on, where the caller runs outside
` the zone, to end that zone before the landing pad; none for any other call.
=? no-block if !entering || is-free(unit.instance)
= ir.reserve-block()

────────────────────
+ do landing-block IRBlockId
    - site SyntaxId

` The landing pad of the checks made where the function is: one for each set of cleanups
` open. It keeps the node of the first check that lands there, a panic raised being none.
landings += 1
if landing == no-block
    landing = ir.reserve-block()
    pads += LandingPad(landing, open-cleanups.length, opening-site(site), unit.source-module)
else if site != 0
    . position = pads.length
    while position != 0
        position -= 1
        if pads[position].block == landing
            if pads[position].site == 0
                pads[position] = LandingPad(landing, pads[position].cleanups, site, unit.source-module)
            break
= landing

────────────────────
_ opening-site SyntaxId
    - site SyntaxId

` The first check of a landing pad made for the cleanups open now. In a spawned task's body
` that of the pad of none is where the body starts, at no node.
if function.kind == .task-body && open-cleanups.length == 0 then unsourced else site

────────────────────
+ do finish-landing

` The landing pads the checks of the function branch to once every cleanup has run, each
` left as `leave-pad` says, and then the handlers of a task body, with the pads their checks make.
. position Size = 0
while true
    while position < pads.length
        ir.start-block(pads[position].block)
        leave-pad(pads[position])
        position += 1
    if task-failing == no-block || handling-failure
        =
    handle-failure()

────────────────────
_ do leave-pad
    - pad LandingPad

` Where a panic leaves the function once every cleanup has run. A module's main reports the
` panic nobody handled at the first check of the pad, in the module of its node, unless the pad
` is unsourced (`report-at`); a task's main reports it and ends the task, after forking the end
` of its case in a batch. A spawned task's body reports it as a module's main does, and ends the
` task, unless the task has handlers: it then gives the panic the source of the pad and goes to
` them (`task-failing`). `threadinit` reports it and ends the process. The task that closes the record of probes
` reports it and ends, and the functions that flush and look in on probes report it and return,
` as no caller handles it. Any other panic is then returned to the caller.
abandon-lazy(0)
if function.kind == .probe-flush || function.kind == .probe-safepoint
    emit-report(false, 0)
    return-nothing()
    =
if function.kind == .module-main
    report-at(pad)
else if function.kind == .thread-init
    emit-report(false, 0, true)
else if function.kind == .probe-closer
    emit-report(false, 0)
    call-runtime(.runtime-terminate-active-task, 0, pending.length)
else if function.kind == .task-body
    if task-failing != no-block && !handling-failure
        attach-pad-source(pad)
        jump(task-failing)
        =
    report-at(pad)
    call-runtime(.runtime-terminate-active-task, 0, pending.length)
else if function.kind == .task-main
    emit-report(false, 0)
    if program.is-batch
        fork-batch(tables.batch-finishes[function.place])
    call-runtime(.runtime-terminate-active-task, 0, pending.length)
if in-callback
    call-runtime(callback-exit(), 0, pending.length)
return-panic()

────────────────────
_ do attach-pad-source
    - pad LandingPad

` Gives the active panic, where it has no source, that of the first check of a pad, as
` `report-at` would, where the pad is not unsourced.
=? if pad.site == unsourced || pad.site == 0
. own-unit = unit
unit = unit.source-module = pad.module
. attaching = ir.reserve-block()
. done = ir.reserve-block()
. active = make-operand(.operand-value, append(.op-load-task-panic, 0, Span(), 0, managed-layout))
branch(active, attaching, done)
ir.start-block(attaching)
. begin = tree.nodes[pad.site].loc.begin
attach-source(active, begin.line + 1, begin.column + 1, pad.site)
jump(done)
ir.start-block(done)
unit = own-unit

────────────────────
_ do handle-failure

` Where a panic ends a task whose spawn site has handlers, once every cleanup has run: the
` handlers are tried in order. A terminating task and one canceled try none. The panic is
` taken from the task, and the first handler whose pattern it matches binds it and
` runs; the task then ends as where its body ends. Where none matches, the panic is set again
` and reported as where there are no handlers. A panic raised in a handler lands on a pad of
` its own, which reports it.
handling-failure = true
ir.start-block(task-failing)
landing = no-block
. reporting = ir.reserve-block()
. live = ir.reserve-block()
. open = ir.reserve-block()
. taking = ir.reserve-block()
. active = make-operand(.operand-value, append(.op-load-task-panic, 0, Span(), 0, managed-layout))
branch(active, live, reporting)
ir.start-block(live)
. terminating = call-runtime(.runtime-task-is-terminating, 0, pending.length, u8-layout)
branch(terminating, reporting, open)
ir.start-block(open)
. cancelation = types.cancelation-type
if cancelation != invalid-type && tables.is-class(cancelation)
    . raised = make-operand(.operand-value, append(.op-load-task-panic, 0, Span(), 0, managed-layout))
    class-branch(0, raised, cancelation, reporting, taking)
else
    jump(taking)
ir.start-block(taking)
. taken = call-runtime(.runtime-take-panic, 0, pending.length, managed-layout)
set-task-end(task-end-panicked)
for handler in tree.children[task-handlers]
    match? tree.nodes[handler]
        | .node-catcher(row)
            . next = ir.reserve-block()
            . named = bound.length
            emit-pattern(row.type, Typed(taken, types.panic-type), next)
            emit-block(row.body)
            drop-bound(named)
            jump(task-leaving)
            ir.start-block(next)
. mark = pending.length
pending += taken
call-runtime(.runtime-panic-set, 0, mark)
jump(reporting)
ir.start-block(reporting)
emit-report(false, 0)
call-runtime(.runtime-terminate-active-task, 0, pending.length)
return-nothing()

────────────────────
_ do report-at
    - pad LandingPad

` Reports the active panic at the first check of a pad, as a module's main does, where the pad
` is not unsourced, read in the module of its node.
. own-unit = unit
unit = unit.source-module = pad.module
emit-report(pad.site != unsourced, pad.site)
unit = own-unit

────────────────────
_ do emit-report
    - attaches Bool
    - site SyntaxId
    - fatal = false

` Reports the active panic when no caller is left to handle it:
` 1. Nothing is reported when no panic is active, and the panic of a terminating task, or one
`    that cancels a task, is cleared. A `fatal` report runs where no task is, and the runtime
`    ends the process once it is made.
` 2. A module's main gives a panic that has no source its own path, at the first check that
`    reached this landing pad. A pad no check with a node reached, as a cleanup's that
`    panicked where its block ended, gives it none.
` 3. The panic is set aside while its text is made, through its class table, with the text
`    of its source, and then given to the runtime with its stack trace.
. report = instances.report
. object = tables.layouts.objects[types.panic-type]
. slot = tables.slots[report.message]
?! Panic("The report of an unhandled panic is missing from the program tables")
    if object == no-layout || slot == no-slot-index
?! Panic("The panic class has no source or no stack trace")
    if report.source-slot == U32.max || report.trace-slot == U32.max
in-landing = true
. layouts = tables.layouts
. managed = managed-layout
. source-field = layouts.field(object, object-header-fields + report.source-slot)
. trace-field = layouts.field(object, object-header-fields + report.trace-slot)
?! Panic("The source of a panic is not an optional struct")
    if !layouts.is-struct(source-field.layout)
. done = ir.reserve-block()
. reporting = ir.reserve-block()
. active = make-operand(.operand-value, append(.op-load-task-panic, 0, Span(), 0, managed))
branch(active, reporting, done)

ir.start-block(reporting)
. unhandled = ir.reserve-block()
if fatal
    jump(unhandled)
else
    . suppress = ir.reserve-block()
    . canceling = ir.reserve-block()
    . terminating = call-runtime(.runtime-task-is-terminating, 0, pending.length, u8-layout)
    branch(terminating, suppress, canceling)

    ir.start-block(canceling)
    . cancelation = types.cancelation-type
    if cancelation != invalid-type && tables.is-class(cancelation)
        . raised = make-operand(.operand-value, append(.op-load-task-panic, 0, Span(), 0, managed))
        class-branch(0, raised, cancelation, suppress, unhandled)
    else
        jump(unhandled)

    ir.start-block(suppress)
    call-runtime(.runtime-panic-clear, 0, pending.length)
    jump(done)

ir.start-block(unhandled)
. panic = make-operand(.operand-value, append(.op-load-task-panic, 0, Span(), 0, managed))
if attaches && site != 0
    . begin = tree.nodes[site].loc.begin
    attach-source(panic, begin.line + 1, begin.column + 1, site)
. mark = pending.length
pending += address(panic, trace-field.offset, managed, 0)
call-runtime(.runtime-ensure-stack-trace, 0, mark)
. suspended = call-runtime(.runtime-panic-suspend, 0, pending.length, managed)
. message = raised-text(panic, slot, false)
. placed-text = raised-place(panic)
. trace = load(panic, trace-field.offset, trace-field.layout, 0)
pending += suspended
call-runtime(.runtime-panic-resume, 0, mark)
pending += panic
pending += message
pending += placed-text.operand
pending += trace
call-runtime
    - if fatal then .runtime-report-fatal-panic else .runtime-report-unhandled-panic
    - 0
    - mark
jump(done)
ir.start-block(done)
in-landing = false

────────────────────
+ do return-panic

` Returns the active panic to the caller, with the zero of the type the function returns.
return-zero(.return-panic)
