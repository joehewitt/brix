| refused-expression = 2
| refused-print-conversion = 3
| refused-global-initializer = 4
| refused-probe = 5
| refused-type = 6
| refused-function = 7
| refused-conversion = 8
| refused-blocking-call = 9
| refused-suspending-call = 10
| refused-batch-local = 11

