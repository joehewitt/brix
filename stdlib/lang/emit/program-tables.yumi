| visit-markup-read = 1
| visit-style-read = 2
| visit-style-flag = 3
| visit-style-site = 4
| visit-style-content = 5
| visit-style-application = 6
| visit-content-link = 7
| visit-element-root = 8
| visit-branch-region = 9
| visit-loop-region = 10
| visit-region-root = 11
| visit-self-action = 12
| visit-query-registration = 13
| visit-event-use = 14
| visit-address-claim = 15
