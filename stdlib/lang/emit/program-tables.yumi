────────────────────
+ begin-using

this

────────────────────
+ do end-using

release()

────────────────────
+ do release

if !released
    bundle.release()
    arena.release()
    released = true

────────────────────
+ do build

bundle.begin-building()
bundle.gc-enabled = true
bundle.stack-trace-metadata = true
bundle.apple-abi = program.target.uses-apple-abi
bundle.output-mode = 0
bundle.gc-allocation-buffer-version = gc-allocation-buffer-version
bundle.gc-control-phase-mask = gc-control-phase-mask
name-runtime()
mark-memo-places()
layouts.build()
unions.build()
index-fills()
index-overrides()
index-recursion()
index-applications()
index-sites()
bounded = arena.allocate'Byte(instances.length + 1)
for position in 0 .. < instances.length + 1
    bounded[position] = 0
default-count = types.properties.length as U32
default-rows = arena.allocate'U32(default-count)
value-units = arena.allocate'U32(default-count + 1)
lazy-slots = arena.allocate'U32(default-count + 1)
lazy-functions = arena.allocate'U32(default-count + 1)
updater-functions = arena.allocate'U32(default-count + 1)
. query-count = facts.markup-queries.length
query-used = arena.allocate'Byte(query-count + 1)
query-functions = arena.allocate'U32(query-count * 2 + 1)
for position in 0 .. < query-count
    query-used[position] = 0
    query-functions[position * 2] = no-function
    query-functions[position * 2 + 1] = no-function
lazy-roots = arena.allocate'U32(default-count + 1)
lazy-raising = arena.allocate'Byte(default-count + 1)
lazy-written = arena.allocate'Byte(default-count + 1)
lazy-results = arena.allocate'U32(default-count + 1)
for position in 0 .. < default-count
    default-rows[position] = U32.max
    value-units[position] = no-instance
    lazy-slots[position] = no-slot-index
    lazy-functions[position] = no-function
    updater-functions[position] = no-function
    lazy-roots[position] = U32.max
    lazy-raising[position] = 0
    lazy-written[position] = 0
    lazy-results[position] = U32.max
choose-functions()
order-prototypes()
build-class-tables()

────────────────────
_ do mark-memo-places

=? if instances.live.memo-action == no-instance
. count = types.properties.length
. roots = arena.allocate'Byte(count + 1)
. places = arena.allocate'Byte(count + 1)
for position in 0 .. < count + 1
    roots[position] = 0
    places[position] = 0
for type in types.ranked
    if !is-memo-holder(type)
        continue
    . range = types.completions[type].properties
    for position in 0 .. < range.count
        . place = range.start + position
        if types.properties[place].storage-kind != .storage-eager
            continue
        . unit = find-unit(type, place, default-of(type, place))
        if unit != no-instance && instances.rows[unit].is-live
            roots[root-place(type, position)] = 1
for type in types.ranked
    if !is-memo-holder(type)
        continue
    . range = types.completions[type].properties
    for position in 0 .. < range.count
        . place = range.start + position
        if eager && roots[root-place(type, position)] != 0
            places[place] = 1
        .. eager = types.properties[place].storage-kind == .storage-eager
layouts.memo-places = places

────────────────────
_ is-memo-holder Bool
    - type TypeId

completion.completion == .completion-done && !completion.has-variables && is-class(type)

.. completion = types.completions[type]

────────────────────
_ do root-place U32
    - type TypeId
    - position U32

. current = type
while true
    . base = types.completions[current].base
    if base == no-type || !is-memo-holder(base) || beyond-base
        = types.completions[current].properties.start + position
    .. beyond-base = types.completions[base].properties.count <= position
    current = base
= 0

────────────────────
_ do index-overrides

` Marks each instance some subclass declares again, so a worker asks without reading every
` override, and with a higher mark one that a function that may panic declares again.
. count = instances.length
overridden = arena.allocate'Byte(count)
for position in 0 .. < count
    overridden[position] = 0
for fact in facts.overrides
    if instances.rows[fact.override].may-panic
        overridden[fact.base] = 2
    else if overridden[fact.base] == 0
        overridden[fact.base] = 1

────────────────────
_ do index-applications

` Links each application of a style rule to the next its instance makes, in the order of
` `Facts.style-applications`, so a worker reads only those of the instance it emits
` (`first-application`).
. count U32 = facts.style-applications.length as U32
application-links = arena.allocate'U32(count + 1)
for offset in 0 .. < count
    . position = count - 1 - offset
    . instance = facts.style-applications[position].instance
    application-links[position] = application-heads[instance] ?? U32.max
    application-heads[instance] = position

────────────────────
_ do index-recursion

. count U32 = instances.length as U32
. starts = arena.allocate'U32(count + 1)
for position in 0 .. < count + 1
    starts[position] = 0
for fact in facts.calls
    if fact.instance < count && fact.callee < count
        starts[fact.instance + 1] += 1
for position in 0 .. < count
    starts[position + 1] += starts[position]
. filled = arena.allocate'U32(count + 1)
for position in 0 .. < count + 1
    filled[position] = starts[position]
. targets = arena.allocate'U32(starts[count] + 1)
for fact in facts.calls
    if fact.instance < count && fact.callee < count
        targets[filled[fact.instance]] = fact.callee
        filled[fact.instance] += 1
recursive = arena.allocate'Byte(count)
finishes = arena.allocate'U32(count)
. order = arena.allocate'U32(count)
. low = arena.allocate'U32(count)
. open = arena.allocate'Byte(count)
for position in 0 .. < count
    recursive[position] = 0
    finishes[position] = U32.max
    order[position] = U32.max
    open[position] = 0
. visited U32
. finished U32
. stack [U32]
. path [U32]
. cursors [U32]
for root in 0 .. < count
    if order[root] != U32.max
        continue
    order[root] = visited
    low[root] = visited
    visited += 1
    stack += root
    open[root] = 1
    path += root
    cursors += starts[root]
    while path.length != 0
        . node = path[path.length - 1]
        . edge = cursors[cursors.length - 1]
        if edge < starts[node + 1]
            cursors[cursors.length - 1] = edge + 1
            . next = targets[edge]
            if next == node
                recursive[node] = 1
            if order[next] == U32.max
                order[next] = visited
                low[next] = visited
                visited += 1
                stack += next
                open[next] = 1
                path += next
                cursors += starts[next]
            else if open[next] != 0 && order[next] < low[node]
                low[node] = order[next]
            continue
        path.pop()
        cursors.pop()
        finishes[node] = finished
        finished += 1
        if path.length != 0 && low[node] < low[path[path.length - 1]]
            low[path[path.length - 1]] = low[node]
        if low[node] != order[node]
            continue
        . first = stack.length - 1
        while stack[first] != node
            first -= 1
        . many = stack.length - first > 1
        while stack.length > first
            . member = stack.pop()
            open[member] = 0
            if many
                recursive[member] = 1

────────────────────
_ do index-fills

` Chains each constructor's fill facts, so a worker finds a property's fill without reading
` every fact.
. instance-count = instances.length
. fill-count U32 = facts.fills.length as U32
fill-heads = arena.allocate'U32(instance-count)
fill-links = arena.allocate'U32(fill-count)
for position in 0 .. < instance-count
    fill-heads[position] = no-fact
for offset in 0 .. < fill-count
    . id = fill-count - 1 - offset
    . owner = facts.fills[id].instance
    fill-links[id] = fill-heads[owner]
    fill-heads[owner] = id

────────────────────
+ do fill-of FactId
    - instance InstanceId
    - name Atom

` The fact that says a constructor fills the property of this name itself, or none.
. fact = fill-heads[instance]
while fact != no-fact
    if facts.fills[fact].name == name
        = fact
    fact = fill-links[fact]
= no-fact

────────────────────
+ do loose-conversion FactId
    - instance InstanceId
    - site SyntaxId
    - from TypeId
    - reason ConversionReason = .reason-assignment
    - to TypeId = no-type

` The conversion of a value of one type that an instance recorded for one reason at a node
` outside its body, or none. A constructor's are at the properties its arguments fill, and
` at those it constructs with no value written, for the defaults that construction takes,
` which may convert values of one type to several: `to` names the one wanted, where given.
. loose = loose-conversion-heads[instance]
while loose != no-fact
    . id = facts.loose-conversions[loose].fact
    . fact = facts.conversions[id]
    if fact.syntax == site && fact.reason == reason && fact.from == from && wanted
        = id
    .. wanted = to == no-type || fact.to == to
    loose = loose-conversion-links[loose]
= no-fact

────────────────────
_ do lay-environments

` Settles where a local that nested functions capture is kept: in the environment of the
` nearest scope around its declaration that runs anew, which is a function, a nested
` function or a loop. A captured slot gets that scope and its place among the slots the
` scope holds, in their order. Then the environment of each emitted instance whose own
` scope holds any is laid out, with the types its locals have in that instance, and so is
` that of the value of a lazy property, which its getter makes, and of the value of a property
` that holds a state machine, which a constructor makes as the machine starts. A binding with
` no nested function has none of this.
. slot-count = bindings.slots.length
. scope-count = bindings.scopes.length
. instance-count = instances.length
slot-functions = arena.allocate'U32(slot-count + 1)
slot-homes = arena.allocate'U32(slot-count + 1)
slot-fields = arena.allocate'U32(slot-count + 1)
slot-copied = arena.allocate'U8(slot-count + 1)
lazy-held = arena.allocate'U8(slot-count + 1)
unneeded = arena.allocate'U8(slot-count + 1)
. shared = arena.allocate'U8(slot-count + 1)
scope-captures = arena.allocate'U32(scope-count + 1)
scope-links = arena.allocate'U32(scope-count + 1)
scope-steps = arena.allocate'U8(scope-count + 1)
instance-scopes = arena.allocate'U32(instance-count + 1)
environments = arena.allocate'U32(instance-count + 1)
. steps = arena.allocate'U8(bindings.bindings.length + 1)
for slot in 0 .. < slot-count
    slot-functions[slot] = no-scope
    slot-homes[slot] = no-scope
    slot-fields[slot] = 0
    slot-copied[slot] = 0
    lazy-held[slot] = 0
    unneeded[slot] = 0
    shared[slot] = 0
for scope in 0 .. < scope-count
    scope-captures[scope] = 0
    scope-links[scope] = 0
    scope-steps[scope] = 0
. nested-scopes = Map'Size'U32(arena)
for index in 0 .. < bindings.bindings.length
    . bound = bindings.bindings[index]
    steps[index] = 0
    for offset in 0 .. < bound.nested.count
        . nested = bindings.nested[bound.nested.start + offset]
        nested-scopes[DeclRef(bound.module, nested.decl).key] = nested.scope
for instance in instances.ordered
    . row = instances.rows[instance]
    if step-functions[instance] == no-function || row.binding == no-binding
        continue
    . bound = bindings.bindings[row.binding]
    if bound.scopes.count == 0
        continue
    . scope = nested-scopes[DeclRef(row.module, row.decl).key] ?? bound.scopes.start
    if scope-steps[scope] == 0
        scope-steps[scope] = 1
        scope-captures[scope] = 1
        steps[row.binding] = 1
. bound-instances = arena.allocate'IdList(bindings.bindings.length + 1)
for index in 0 .. < bindings.bindings.length
    bound-instances[index] = IdList()
for instance in instances.ordered
    . binding = instances.rows[instance].binding
    if binding != no-binding
        bound-instances[binding] = bound-instances[binding].appended(arena, instance)
for index in 0 .. < bindings.bindings.length
    . bound = bindings.bindings[index]
    if bound.nested.count != 0 && steps[index] == 0
        settle-held(index as BindingId, bound-instances[index], nested-scopes)
. turns = arena.allocate'U8(bindings.bindings.length + 1)
for index in 0 .. < bindings.bindings.length
    . bound = bindings.bindings[index]
    turns[index] = 0
    if bound.nested.count != 0 || steps[index] != 0
        mark-copies(bound, shared)
        for offset in 0 .. < bound.slots.count
            place-slot(bound.slots.start + offset, shared)
    for offset in 0 .. < bound.nested.count
        link-scopes(bindings.nested[bound.nested.start + offset])
    if bound.nested.count == 0
        continue
    for offset in 0 .. < bound.scopes.count
        . scope = bound.scopes.start + offset
        if is-turn-scope(scope) && scope-captures[scope] != 0
            turn-scopes[pair-key(bound.module, bindings.scopes[scope].syntax)] = scope
            turns[index] = 1
. lazy-units = arena.allocate'U8(instance-count + 1)
for instance in 0 .. < instance-count
    lazy-units[instance] = 0
for place in 0 .. < default-count
    if lazy-functions[place] != no-function && value-units[place] != no-instance
        lazy-units[value-units[place]] = 1
for machine in facts.machines
    if machine.store == .store-member && instances.rows[machine.instance].enclosing != no-instance
        lazy-units[instances.rows[machine.instance].enclosing] = 1
for instance in 0 .. < instance-count
    instance-scopes[instance] = no-scope
    environments[instance] = no-layout
for instance in instances.ordered
    . row = instances.rows[instance]
    . root = is-root-unit(instance)
    . apart = lazy-units[instance] != 0 || is-rule-unit(instance) || root
    if row.binding == no-binding || (row.initializer != 0 && !apart)
        continue
    . bound = bindings.bindings[row.binding]
    if (bound.nested.count == 0 && steps[row.binding] == 0) || bound.scopes.count == 0
        continue
    . scope = nested-scopes[DeclRef(row.module, row.decl).key] ?? bound.scopes.start
    if apart
        scope = value-scope(row, bound)
    if scope == no-scope || (root && !holds-environment(scope))
        continue
    instance-scopes[instance] = scope
    if (has-function || apart) && (holds-environment(scope) || makes-holders(instance))
        environments[instance] = lay-environment(instance, bound, scope)
    .. has-function = instance-functions[instance] != no-function
    if instance-functions[instance] != no-function && turns[row.binding] != 0
        lay-turns(instance, bound, scope)

────────────────────
_ do value-scope ScopeId
    - row Instance
    - bound Binding

` The scope a property's value or a rule of a class is bound in, among those of its module's
` main: the one written at the property or the rule.
. syntax SyntaxId = 0
do match? program.modules[row.module].decls[row.initializer]
    | .decl-property(property)
        syntax = property.syntax
    | .decl-rule(rule)
        syntax = rule.syntax
    | .decl-style-rule(rule)
        syntax = rule.syntax
for offset in 0 .. < bound.scopes.count
    . scope = bound.scopes.start + offset
    if bindings.scopes[scope].syntax == syntax && bindings.scopes[scope].kind == .scope-function
        = scope
= no-scope

────────────────────
_ do is-root-unit Bool
    - instance InstanceId

` Whether an instance types a line of a root `<This` for a receiver, whose closures read the
` object from the environment the value is given where the constructor evaluates it.
. row = instances.rows[instance]
if row.initializer == 0 || row.self-type == no-type
    = false
do match? program.modules[row.module].decls[row.initializer]
    | .decl-property(property)
        = property.defaults-root
= false

────────────────────
_ do is-rule-unit Bool
    - instance InstanceId

` Whether an instance types a rule of a class, or a style rule of one with a line that sets a
` property again as what its value read changes, whose function is written in the rule.
. row = instances.rows[instance]
if row.initializer == 0
    = false
do match? program.modules[row.module].decls[row.initializer]
    | .decl-rule
        = true
    | .decl-style-rule
        = facts.updates-live(instance)
= false

────────────────────
+ holds-environment Bool
    - scope ScopeId

` Whether a run of the function of a scope makes an environment: for the locals it declares
` that nested functions capture, or for the link alone where a nested function written in
` it captures a local from further out. Each run of such a function is then told apart by
` the functions it writes, as the reference tells them apart.
scope-captures[scope] != 0 || scope-links[scope] != 0

────────────────────
+ is-turn-scope Bool
    - scope ScopeId

` Whether a scope runs anew each time and has a turn where nested functions capture its names:
` a loop's body, or the activation of a case or continuation of a state machine.
bindings.scopes[scope].kind == .scope-loop || bindings.scopes[scope].kind == .scope-activation

────────────────────
_ do function-scope ScopeId
    - scope ScopeId

` The scope of the function a scope lies in.
. found = scope
while bindings.scopes[found].kind != .scope-function && bindings.scopes[found].kind != .scope-nested
    found = bindings.scopes[found].parent
= found

────────────────────
_ do link-scopes
    - nested NestedFunction

` Marks each nested function's scope that lies between where a nested function is written
` and where a local it captures is declared. A slot only tasks capture is reached through the
` captures of the tasks around, which need no environment for the link.
. written = function-scope(bindings.scopes[nested.scope].parent)
for index in 0 .. < nested.captures.count
    . slot = bindings.captures[nested.captures.start + index].slot
    if slot-copied[slot] != 0
        continue
    . home = slot-functions[slot]
    . scope = written
    while home != no-scope && scope != home && bindings.scopes[scope].kind == .scope-nested
        scope-links[scope] = 1
        scope = function-scope(bindings.scopes[scope].parent)

────────────────────
_ do mark-copies
    - bound Binding
    - shared CPointer'U8

` Marks the slots of a binding that only the bodies of spawned tasks and of `do @no-gc` blocks
` capture, as a local, an argument, the item of a loop or the receiver. Every nested function
` between a reference and the declaration records what it captures, so the outermost task copies the
` slot where it is spawned and the tasks inside it share that copy through their links, as the
` reference does; any other capture shares the slot. A binding where a lazy local is captured shares
` all it captures, since what the value reads is reached from wherever it is first read.
for offset in 0 .. < bound.slots.count
    . row = bindings.slots[bound.slots.start + offset]
    if row.kind == .slot-lazy && (row.flags /and/ SlotFlag.slot-captured) != 0
        =
for offset in 0 .. < bound.nested.count
    . nested = bindings.nested[bound.nested.start + offset]
    . spawned = copies-captures(bound.module, nested.decl)
    for index in 0 .. < nested.captures.count
        . slot = bindings.captures[nested.captures.start + index].slot
        . kind = bindings.slots[slot].kind
        . plain = kind == .slot-this || kind == .slot-local || kind == .slot-argument || loop-item
            .. loop-item = kind == .slot-loop-item
        if spawned && plain
            slot-copied[slot] = 1
        else
            shared[slot] = 1

────────────────────
_ copies-captures Bool
    - module ModuleId
    - decl DeclId

` Whether a nested function copies what it captures where it is made: the body of a spawned task
` or of a `do @no-gc` block.
match program.modules[module].decls[decl]
    | .decl-function(fn)
        fn.kind == .task-decl || fn.kind == .region-decl
    ??
        false

────────────────────
_ do place-slot
    - slot SlotId
    - shared CPointer'U8

. row = bindings.slots[slot]
. scope = row.scope
. home = no-scope
. home-kind = bindings.scopes[scope].kind
. given = home-kind == .scope-activation && bindings.scopes[scope].syntax == row.syntax
while bindings.scopes[scope].kind != .scope-function && bindings.scopes[scope].kind != .scope-nested
    if home == no-scope && (bindings.scopes[scope].kind == .scope-loop || given)
        home = scope
    scope = bindings.scopes[scope].parent
slot-functions[slot] = scope
. copied = slot-copied[slot] != 0 && shared[slot] == 0
. captured = (row.flags /and/ SlotFlag.slot-captured) != 0 && !copied && unneeded[slot] == 0
slot-copied[slot] = 0
if !captured && scope-steps[scope] == 0
    if copied
        slot-copied[slot] = 1
    =
if home == no-scope || !captured
    home = scope
slot-homes[slot] = home
slot-fields[slot] = scope-captures[home]
scope-captures[home] += if row.kind == .slot-lazy && lazy-held[slot] == 0 then 2 else 1

────────────────────
_ do settle-held
    - binding BindingId
    - typed IdList
    - nested-scopes Map'Size'U32'ArenaBacking

` Settles which lazy locals of a binding that nested functions capture are held as an eager
` local is: the function that declares one gives it its value before it makes each nested
` function that reads it (`holds-lazy`), so the environment holds the value alone, nested
` functions read it as they read any local, and only the function that declares it keeps a flag.
` One is held where it is assigned nowhere and referred to nowhere, is not read tracked, is not
` declared in a loop or with others, is not read in a subscription or a state machine, and its
` value tracks nothing; and where every instance that declares it reads it before it makes each
` nested function that reads it (`lazy-dominated`), or its value is cheap and pure there, so
` that evaluating it early changes nothing (`cheap-value`). One that the value of a captured
` lazy local not held reads is not held, since a nested function may evaluate that one before
` the held one has its value. Then an argument or a local captured only for the values of lazy
` locals (`slot-shared-read`) that no nested function and no captured lazy local not held reads
` is not kept in the environment.
. bound = bindings.bindings[binding]
. tree = program.modules[bound.module].tree
. any = false
for offset in 0 .. < bound.slots.count
    . slot = bound.slots.start + offset
    if may-hold(binding, tree, slot, typed, nested-scopes)
        lazy-held[slot] = 1
        any = true
=? if !any
. changed = true
while changed
    changed = false
    for offset in 0 .. < bound.slots.count
        . slot = bound.slots.start + offset
        . row = bindings.slots[slot]
        if row.kind != .slot-lazy || (row.flags /and/ SlotFlag.slot-captured) == 0 || marked-held
            continue
        .. marked-held = lazy-held[slot] != 0
        . value = lazy-value(tree, row.group)
        if value == 0
            continue
        for node in tree.subtree-start(value) .. value
            . read = read-slot(binding, node)
            if read != no-slot && lazy-held[read] != 0
                lazy-held[read] = 0
                changed = true
. needed = arena.allocate'U8(bound.slots.count + 1)
for offset in 0 .. < bound.slots.count
    needed[offset] = 0
for offset in 0 .. < bound.nested.count
    . nested = bindings.nested[bound.nested.start + offset]
    for index in 0 .. < nested.captures.count
        . slot = bindings.captures[nested.captures.start + index].slot
        if slot >= bound.slots.start && slot < bound.slots.start + bound.slots.count
            needed[slot - bound.slots.start] = 1
for offset in 0 .. < bound.slots.count
    . slot = bound.slots.start + offset
    . row = bindings.slots[slot]
    if row.kind != .slot-lazy || uncaptured || lazy-held[slot] != 0
        continue
    .. uncaptured = (row.flags /and/ SlotFlag.slot-captured) == 0
    . value = lazy-value(tree, row.group)
    if value == 0
        continue
    for node in tree.subtree-start(value) .. value
        . read = read-slot(binding, node)
        if read != no-slot && read >= bound.slots.start && read < slots-end
            needed[read - bound.slots.start] = 1
        .. slots-end = bound.slots.start + bound.slots.count
for offset in 0 .. < bound.slots.count
    . slot = bound.slots.start + offset
    . row = bindings.slots[slot]
    . plain = row.kind == .slot-argument || row.kind == .slot-local
    if plain && needed[offset] == 0 && (row.flags /and/ SlotFlag.slot-shared-read) != 0
        unneeded[slot] = 1

────────────────────
+ holds-lazy Bool
    - slot SlotId

` Whether a lazy local nested functions capture is held as an eager local is (`settle-held`).
lazy-held[slot] != 0

────────────────────
_ do may-hold Bool
    - binding BindingId
    - tree AST
    - slot SlotId
    - typed IdList
    - nested-scopes Map'Size'U32'ArenaBacking

` Whether a lazy local is held as `settle-held` says, before the values of others are looked at.
. bound = bindings.bindings[binding]
. row = bindings.slots[slot]
if row.kind != .slot-lazy || (row.flags /and/ SlotFlag.slot-captured) == 0 || row.use == U32.max
    = false
if unshared || bindings.lazy-together(slot) || bindings.value-tracks(tree, row.group)
    = false
.. unshared = bindings.lazy-policy(slot) != .lazy-shared
. use = bindings.lazy-use-of(slot)
. apart U32 = LazyUseFlag.declared-in-loop
apart = apart /or/ (LazyUseFlag.read-in-subscription)
apart = apart /or/ (LazyUseFlag.read-in-state-machine)
if use.writes != 0 || use.refs != 0 || use.tracked != 0 || (use.flags /and/ apart) != 0
    = false
. value = lazy-value(tree, row.group)
if value == 0
    = false
. dominated = bindings.lazy-dominated(slot)
. home = function-scope(row.scope)
. declared = false
for position in 0 .. < typed.length
    . instance = typed[position]
    . owner = instances.rows[instance]
    if (nested-scopes[DeclRef(owner.module, owner.decl).key] ?? bound.scopes.start) != home
        continue
    if owner.initializer != 0 || has-fills || live-statement-of(instance, row.group)
        = false
    .. has-fills = owner.fills.count != 0 || owner.fills-share
    if !dominated && !cheap-value(binding, tree, instance, value, 0)
        = false
    declared = true
= declared

────────────────────
_ do cheap-value Bool
    - binding BindingId
    - tree AST
    - instance InstanceId
    - value SyntaxId
    - depth U32

` Whether evaluating the value of a lazy local where a nested function that reads it is made,
` rather than where it is first read, changes nothing: it reads only numbers written in it, the
` arguments of its function, which nothing assigns, and other lazy locals whose values are as
` cheap, and works on them only with operators that are built in and cannot fail. A conversion
` there calls nothing.
if depth > 4
    = false
for node in tree.subtree-start(value) .. value
    if calls || forces || !plain-conversions(instance, node)
        = false
    .. calls = facts.first-call(instance, node) != no-fact
    .. forces = facts.first-force(instance, node) != no-fact
    . cheap = false
    do match? tree.nodes[node]
        | .node-integer-syntax
            cheap = true
        | .node-float-syntax
            cheap = true
        | .node-identifier(row)
            . read = read-slot(binding, node)
            if !row.is-tracked && read != no-slot && not-case-read
                cheap = cheap-read(binding, tree, instance, read, depth)
            .. not-case-read = facts.plan-of(instance, node) != .plan-case-read
        | .node-unary-expression(row)
            cheap = row.op == .negative-op || row.op == .not-op
        | .node-binary-expression(row)
            if row.op == .and-op || row.op == .or-op
                cheap = true
            else if cheap-operator(row.op)
                cheap = facts.plan-of(instance, node) == .plan-builtin
    if !cheap
        = false
= true

────────────────────
_ cheap-read Bool
    - binding BindingId
    - tree AST
    - instance InstanceId
    - slot SlotId
    - depth U32

` Whether a read in a cheap value is of an argument nothing assigns, or of a lazy local with a
` cheap value of its own that is evaluated where it is read once.
|? (row.flags /and/ changing) != 0
    false
|? row.kind == .slot-argument
    true
|? row.kind != .slot-lazy || row.use == U32.max || bindings.lazy-together(slot)
    false
|? use.writes != 0 || use.refs != 0 || use.tracked != 0
    false
??
    value != 0 && cheap-value(binding, tree, instance, value, depth + 1)

.. row = bindings.slots[slot]
.. changing = SlotFlag.slot-assigned /or/ SlotFlag.slot-tracked /or/ SlotFlag.slot-address-taken
.. use = bindings.lazy-use-of(slot)
.. value = lazy-value(tree, row.group)

────────────────────
_ cheap-operator Bool
    - op Operator

match op
    | .add-op
        true
    | .subtract-op
        true
    | .multiply-op
        true
    | .bitwise-and-op
        true
    | .bitwise-or-op
        true
    | .bitwise-xor-op
        true
    | .bitwise-lshift-op
        true
    | .bitwise-rshift-op
        true
    | .bitwise-zrshift-op
        true
    | .less-than-op
        true
    | .greater-than-op
        true
    | .less-than-equals-op
        true
    | .greater-than-equals-op
        true
    | .equals-op
        true
    | .not-equals-op
        true
    ??
        false

────────────────────
_ do plain-conversions Bool
    - instance InstanceId
    - node SyntaxId

` Whether each conversion the type pass recorded at a node keeps the value it converts, calling
` nothing.
. fact = facts.first-conversion(instance, node)
while fact != no-fact
    . row = facts.conversions[fact]
    if row.callee != no-instance || row.runs != no-instance || row.casts
        = false
    . kept = row.kind == .relation-same || row.kind == .relation-equal || side-cast
        .. side-cast = row.kind == .relation-side-cast
    if !kept && row.kind != .relation-up-cast && row.kind != .relation-wrap-cast
        = false
    fact = row.next
= true

────────────────────
_ read-slot SlotId
    - binding BindingId
    - node SyntaxId

` The slot a node of a binding's function names, or none.
if resolution.kind == .resolve-slot then resolution.slot else no-slot

.. resolution = bindings.resolution-of(binding, node)

────────────────────
_ lazy-value SyntaxId
    - tree AST
    - group SyntaxId

` The value a lazy local is declared with, or none.
match tree.nodes[group]
    | .node-declare(row)
        if row.is-pattern then 0 else row.right
    ??
        0

────────────────────
_ do lay-environment LayoutId
    - instance InstanceId
    - bound Binding
    - scope ScopeId

` The environment of an instance's own scope: the link, then each local the scope holds, and
` each item that `each` or `it` names there, as the instance types it, the `location` of an
` arm of a stream pattern and the list of subscribers of locals read tracked among them, and
` the receiver of a member where nested functions read it, as the member sees it: a function
` of an interface run for a value of a type that is none sees the interface.
` A lazy local is followed by the byte that says whether it has its value, unless it is held
` as an eager local is (`settle-held`), and one nothing typed reads holds nothing. So does a list of subscribers no tracked read typed, as where the
` only reads are in content an outlet mounts where it is given none, which the function given
` a builder leaves unbuilt. One that holds anything else, or a value with no layout, is
` not built yet. A captured local a loop declares is kept in the environment of the loop's
` turn, not here.
` The environment of a function that yields holds the step it has reached after the link,
` and every local of the function, where one the instance types nothing for holds nothing.
` After them it holds, for each loop of the function whose turns have an environment, the
` environment of the turn being run, which no local could keep from one step to the next.
` Last it holds, for each lambda written in the function and each global `do with` binds
` whose state the lambda holds, that state as it was where the lambda was last made, which
` a function that yields has no shape for.
. children [LayoutId]
. held [TypeId]
children += managed-layout
held += no-type
. stepped = scope-steps[scope] != 0
if stepped
    children += i32-layout
    held += no-type
. position U32
for offset in 0 .. < bound.slots.count
    . slot = bound.slots.start + offset
    . row = bindings.slots[slot]
    . own = slot-functions[slot] == scope
    . type = no-type
    if own && row.kind == .slot-argument
        type = instances.argument-type(instance, position)
        position += 1
    else if own && row.kind == .slot-this
        . view = receiver-view(instance)
        type = if view != no-type then view else instances.rows[instance].self-type
    else if own && (stepped || row.kind == .slot-local || row.kind == .slot-lazy || row.kind == .slot-pattern || row.kind == .slot-location || row.kind == .slot-subscribers || row.kind == .slot-builder || row.kind == .slot-machine)
        type = facts.slot-type(instance, offset)
    else if own && (row.kind == .slot-each || row.kind == .slot-it)
        type = facts.slot-type(instance, offset)
    if slot-homes[slot] != scope || !own
        continue
    . unread = row.kind == .slot-lazy && type == no-type
    . empty = (stepped || row.kind == .slot-subscribers) && type == no-type && !unread
    if (type == no-type && !unread && !empty) || type == invalid-type
        = unbuilt-environment
    . layout = if unread then u8-layout else if empty then void-layout else layouts.values[type]
    if layout == no-layout
        = unbuilt-environment
    children += layout
    held += type
    if row.kind == .slot-lazy && lazy-held[slot] == 0
        children += u8-layout
        held += no-type
if stepped
    for offset in 0 .. < bound.scopes.count
        . loop = bound.scopes.start + offset
        if not-loop || scope-captures[loop] == 0 || function-scope(loop) != scope
            continue
        .. not-loop = bindings.scopes[loop].kind != .scope-loop
        turn-places[pair-key(instance, loop)] = children.length as U32
        children += managed-layout
        held += no-type
for hold in facts.stack-holds
    . inner = hold.instance
    if instances.rows[inner].enclosing != instance || copies-in(inner)
        continue
    . decl = instances.rows[inner].decl
    . row = if on-stack then storage-of(hold.module, hold.decl) else no-storage
        .. on-stack = global-kind(hold.module, hold.decl) == .global-stack
    if stepped || row == no-storage
        = unbuilt-environment
    if stack-place(instance, decl, row) == U32.max
        place-owners += instance
        place-decls += decl
        place-rows += row
        place-children += children.length as U32
        children += storage[row].layout
        held += no-type
= layouts.environment(children, held, "env.${hex-text(instances.stable-keys[instance])}")

────────────────────
_ do makes-holders Bool
    - instance InstanceId

` Whether a function writes a nested function, other than a spawned task's body or that of a
` `do @no-gc` block, that holds the state of a global `do with` binds.
for hold in facts.stack-holds
    if instances.rows[hold.instance].enclosing == instance && !copies-in(hold.instance)
        = true
= false

────────────────────
+ do stack-place U32
    - owner InstanceId
    - decl DeclId
    - row U32

` The place in a function's environment of the state of a global `do with` binds that a
` lambda written there holds, or none.
for position in 0 .. < place-owners.length
    if place-owners[position] == owner && place-decls[position] == decl && same-row
        = place-children[position]
    .. same-row = place-rows[position] == row
= U32.max

────────────────────
+ do holds-stacks Bool
    - instance InstanceId

` Whether a function's environment holds the state of a global `do with` binds for a lambda
` written there.
for owner in place-owners
    if owner == instance
        = true
= false

────────────────────
_ do lay-captures

` Lays out the capture of the body of each spawned task emitted, and of each `do @no-gc`
` block: an object the collector owns, made where the task is spawned or the block runs, that
` holds each local, item of a loop, argument and receiver the body captures, in the order the
` binder recorded them, as the instance that declares it types it. A body that captures nothing
` has none. One that captures anything else is not built, nor is a block's that holds the state
` of a global `do with` binds.
. count = instances.length
captures = arena.allocate'U32(count + 1)
capture-rows = arena.allocate'U32(count + 1)
. rows = Map'Size'U32(arena)
for index in 0 .. < bindings.bindings.length
    . bound = bindings.bindings[index]
    for offset in 0 .. < bound.nested.count
        . nested = bound.nested.start + offset
        rows[DeclRef(bound.module, bindings.nested[nested].decl).key] = nested
for instance in 0 .. < count
    captures[instance] = no-layout
    capture-rows[instance] = U32.max
for instance in instances.ordered
    if instance-functions[instance] == no-function || !copies-in(instance)
        continue
    . row = instances.rows[instance]
    . found = rows[DeclRef(row.module, row.decl).key]
    if !found || row.binding == no-binding
        captures[instance] = unbuilt-environment
        continue
    capture-rows[instance] = found
    captures[instance] = lay-capture
        - instance
        - bindings.bindings[row.binding]
        - bindings.nested[found]

────────────────────
_ do lay-capture LayoutId
    - instance InstanceId
    - bound Binding
    - nested NestedFunction

` A body that shares a name holds first the link to the environment in force where it was
` spawned, as a lambda written there is given. Then it holds what it copies, and the state of
` each global `do with` binds that the body holds, as it was where the task was spawned. The
` body of a `do @no-gc` block holds the address of each local and argument it refers to
` (`refers`), with the type of the value kept there.
. stacks = stack-holds(instance)
if is-region(instance) && stacks.length != 0
    = unbuilt-environment
if nested.captures.count == 0 && stacks.length == 0
    = no-layout
. children [LayoutId]
. held [TypeId]
if links-capture(instance)
    children += managed-layout
    held += no-type
for index in 0 .. < nested.captures.count
    . slot = bindings.captures[nested.captures.start + index].slot
    if !copies(instance, slot)
        continue
    . type = captured-type(instance, bound, slot)
    . layout = if type == no-type || type == invalid-type then no-layout else layouts.values[type]
    if layout == no-layout
        = unbuilt-environment
    children += if refers(instance, slot) then pointer-layout else layout
    held += type
for row in stacks
    if row == no-storage
        = unbuilt-environment
    children += storage[row].layout
    held += no-type
= layouts.environment(children, held, "capture.${hex-text(instances.stable-keys[instance])}")

────────────────────
+ copies Bool
    - instance InstanceId
    - slot SlotId

` Whether the body of a spawned task copies a name it captures where it is spawned. As
` TypeScript's, it copies what the function that spawns it declares, where the value of a
` lazy local is evaluated, and its receiver, and shares any other name with the functions
` around it through the link its capture holds, a lazy local too, and a state machine's
` projection, which it reads as the machine is when the body reads it. It copies the flags of a
` machine the function keeps in a local, as it copies the local.
|? bindings.slots[slot].kind == .slot-machine && bindings.slots[slot].name.text != "(active)"
    false
|? enclosing != no-instance && instance-scopes[enclosing] == slot-functions[slot]
    true
??
    bindings.slots[slot].kind == .slot-this

.. enclosing = instances.rows[instance].enclosing

────────────────────
+ refers Bool
    - instance InstanceId
    - slot SlotId

` Whether the body of a `do @no-gc` block reaches a local or an argument its capture holds
` (`copies`) through its address, where the function that runs the block keeps it: the block
` runs there, before anything after it, so what it assigns is that function's own.
is-region(instance) && copies(instance, slot) && (kind == .slot-local || kind == .slot-argument)

.. kind = bindings.slots[slot].kind

────────────────────
+ do links-capture Bool
    - instance InstanceId

` Whether the capture of a spawned task's body holds a link to the environment in force where
` it was spawned: where the body shares a name it captures.
if capture-rows[instance] == U32.max
    = false
. captured = bindings.nested[capture-rows[instance]].captures
for index in 0 .. < captured.count
    if !copies(instance, bindings.captures[captured.start + index].slot)
        = true
= false

────────────────────
+ do capture-field U32
    - instance InstanceId
    - slot SlotId

` The field of the capture of a spawned task's body that holds a name it copies, or none.
if capture-rows[instance] == U32.max
    = U32.max
. captured = bindings.nested[capture-rows[instance]].captures
. field U32 = if links-capture(instance) then 1 else 0
for index in 0 .. < captured.count
    . other = bindings.captures[captured.start + index].slot
    if copies(instance, other)
        if other == slot
            = field
        field += 1
= U32.max

────────────────────
+ do capture-stacks U32
    - instance InstanceId

` The first field of the capture of a spawned task's body that holds the state of a global
` `do with` binds, after the link and what the body copies.
if capture-rows[instance] == U32.max
    = 0
. captured = bindings.nested[capture-rows[instance]].captures
. field U32 = if links-capture(instance) then 1 else 0
for index in 0 .. < captured.count
    if copies(instance, bindings.captures[captured.start + index].slot)
        field += 1
= field

────────────────────
+ do holds-unmade Bool
    - instance InstanceId

` Whether a nested function holds the state of a global `do with` binds where nothing writes
` it: one that is neither a lambda, a comprehension nor a spawned task's body, a list of
` bullets or the right side of a pipe, which has no shape for it. The body of a `do @no-gc`
` block holding one is not built (`lay-capture`).
if facts.stack-holds.length == 0 || copies-in(instance)
    = false
. row = instances.rows[instance]
do match? program.modules[row.module].decls[row.decl]
    | .decl-function(fn)
        if !is-nested-kind(fn.kind) || fn.kind == .closure-decl
            = false
        if fn.kind == .iterator-decl
            do match? program.modules[row.module].tree.nodes[fn.syntax]
                | .node-iterator-expression
                    = false
        = stack-holds(instance).length != 0
= false

────────────────────
+ do stack-holds [U32]
    - instance InstanceId

` The storage of each global `do with` binds whose state a nested function holds, in the
` order the type pass recorded them; none where one is not kept.
. rows [U32]
for hold in facts.stack-holds
    if hold.instance == instance
        . row = storage-of(hold.module, hold.decl)
        rows += if global-kind(hold.module, hold.decl) == .global-stack then row else no-storage
= rows

────────────────────
+ do stack-needs [U32]
    - instance InstanceId

` The storage of each global `do with` binds that an instance reads outside its own bindings
` of it, itself or through what it calls, in the order the type pass recorded them; none
` where one is not kept.
. rows [U32]
for need in facts.stack-needs
    if need.instance == instance
        . row = storage-of(need.module, need.decl)
        rows += if global-kind(need.module, need.decl) == .global-stack then row else no-storage
= rows

────────────────────
_ do captured-type TypeId
    - instance InstanceId
    - bound Binding
    - slot SlotId

` The type of a local, the item of a loop, a name a pattern binds, an argument or a receiver
` the body of a spawned task captures, in the nearest instance around the body whose own scope
` declares it, or a flag of a state machine it keeps in a local. A lazy local is held as its
` value.
. home = slot-functions[slot]
. owner = instances.rows[instance].enclosing
while owner != no-instance && instance-scopes[owner] != home
    owner = instances.rows[owner].enclosing
if owner == no-instance
    = no-type
. row = bindings.slots[slot]
. local = local-or-lazy || row.kind == .slot-pattern || row.kind == .slot-machine
    .. local-or-lazy = row.kind == .slot-local || row.kind == .slot-lazy
if local || row.kind == .slot-loop-item || row.kind == .slot-each || row.kind == .slot-it
    = facts.slot-type(owner, slot - bound.slots.start)
if row.kind == .slot-this
    . view = receiver-view(owner)
    = if view != no-type then view else instances.rows[owner].self-type
if row.kind != .slot-argument
    = no-type
. position U32
for earlier in bound.slots.start .. < slot
    if bindings.slots[earlier].kind == .slot-argument && slot-functions[earlier] == home
        position += 1
= instances.argument-type(owner, position)

────────────────────
_ do lay-turns
    - instance InstanceId
    - bound Binding
    - scope ScopeId

` The environment of a turn of each loop of an instance's own function whose body declares
` a local that nested functions capture: the link to the environment in force around the
` loop, then each such local, as the instance types it. A lazy local is followed by the
` byte that says whether it has its value, and one nothing typed reads holds nothing but
` that. A local a read tracks is held so only where nothing writes it after it is declared,
` so that no store runs the actions that read it; the name of a placed element is written only
` where the element is made. The flags of a state machine a local of the turn keeps are held
` beside it. One that holds a local the instance types nothing for is not built yet.
for offset in 0 .. < bound.scopes.count
    . loop = bound.scopes.start + offset
    if !is-turn-scope(loop) || scope-captures[loop] == 0 || function-scope(loop) != scope
        continue
    . children [LayoutId]
    . held [TypeId]
    children += managed-layout
    held += no-type
    . built = true
    for position in 0 .. < bound.slots.count
        . slot = bound.slots.start + position
        if slot-homes[slot] != loop
            continue
        . row = bindings.slots[slot]
        . type = facts.slot-type(instance, position)
        . lazy = row.kind == .slot-lazy
        . layout = if type == no-type || type == invalid-type then no-layout else type-layout
            .. type-layout = layouts.values[type]
        if lazy && type == no-type
            layout = u8-layout
        . named = row.kind == .slot-local || row.kind == .slot-loop-item || row.kind == .slot-each || row.kind == .slot-it || row.kind == .slot-pattern || row.kind == .slot-machine
        . written = assigned && (row.flags /and/ SlotFlag.slot-placed) == 0
            .. assigned = (row.flags /and/ SlotFlag.slot-assigned) != 0
        . watched = (row.flags /and/ SlotFlag.slot-tracked) != 0 && written
        if (!named && !lazy) || watched || layout == no-layout
            built = false
            break
        children += layout
        held += type
        if lazy
            children += u8-layout
            held += no-type
    . name = "turn.${hex-text(instances.stable-keys[instance])}.$offset"
    turn-layouts[pair-key(instance, loop)] = if built then layouts.environment(children, held, name) else unbuilt-environment

────────────────────
+ turn-scope ScopeId
    - module ModuleId
    - loop SyntaxId

` The scope of a loop written at a node whose turns each have an environment, or none.
turn-scopes[pair-key(module, loop)] ?? no-scope

────────────────────
+ turn-environment LayoutId
    - instance InstanceId
    - scope ScopeId

` The layout an instance has for the environment of a turn of a loop of its own.
turn-layouts[pair-key(instance, scope)] ?? no-layout

────────────────────
+ turn-place U32
    - instance InstanceId
    - scope ScopeId

` The field of the environment of an instance that yields which keeps the environment of
` the turn being run of a loop of its own, or `U32.max` where it keeps none.
turn-places[pair-key(instance, scope)] ?? U32.max

────────────────────
_ describing U32
    - name Atom

` The runtime's function that does to storage what a C function named does, and takes what
` describes the storage too, or none.
|? name == types.allocate-buffer-atom!
    RuntimeFunction.runtime-allocate-buffer
|? name == types.resize-buffer-atom!
    RuntimeFunction.runtime-resize-buffer
|? name == types.copy-slice-atom!
    RuntimeFunction.runtime-copy-slice
|? name == types.arena-reserve-atom!
    RuntimeFunction.runtime-arena-reserve-described
??
    no-runtime-function

────────────────────
_ do suspends-task Bool
    - name String

` Whether a C function is one of the runtime's that suspend the task that calls it.
if name.starts-with(task-suspending-runtime-prefix)
    = true
for each in task-suspending-runtime-names
    if each == name
        = true
= false

────────────────────
_ do name-runtime

. target = program.target
for name in runtime-function-names
    runtime-symbols = runtime-symbols.appended(arena, bundle.intern(target.symbol(name)))
bundle.gc-public-control-word-symbol = bundle.intern(target.symbol(backend-runtime-names[0]))
bundle.write-barrier-record-symbol = bundle.intern(target.symbol(backend-runtime-names[1]))
bundle.zero-stack-frame-symbol = bundle.intern(target.symbol(backend-runtime-names[2]))
bundle.bulk-write-barrier-symbol = bundle.intern(target.symbol(backend-runtime-names[3]))
bundle.memory-copy-symbol = bundle.intern(target.symbol(memory-copy-runtime-names[0]))
bundle.memory-zero-symbol = bundle.intern(target.symbol(memory-copy-runtime-names[1]))
bundle.thread-cache-symbol = bundle.intern(target.symbol(allocation-runtime-names[0]))
bundle.allocation-refill-symbol = bundle.intern(target.symbol(allocation-runtime-names[1]))
bundle.allocate-object-symbol = runtime-symbol(.runtime-allocate-object)
bundle.mark-safepoint-free(bundle.thread-cache-symbol)
for name in safepoint-free-runtime-names
    bundle.mark-safepoint-free(bundle.intern(target.symbol(name)))
for name in memory-copy-runtime-names
    bundle.mark-memory-copy-callee(bundle.intern(name))
    bundle.mark-memory-copy-callee(bundle.intern(target.symbol(name)))
for name in safe-struct-runtime-names
    bundle.mark-safe-struct-callee(bundle.intern(name))
    bundle.mark-safe-struct-callee(bundle.intern(target.symbol(name)))

────────────────────
+ runtime-symbol StringId
    - function RuntimeFunction

runtime-symbols[function]

────────────────────
+ do declared-at MIRLoc?
    - function FunctionId

` Where the declaration whose body a function holds is written, which a stack trace names for
` a place in the function's code no line stands behind, as its prologue. None for a function
` that holds no declaration's body.
. row = functions[function]
if row.instance == no-instance
    = null
if row.kind != .instance-body && row.kind != .viewed-body && not-generator && not-constructor
    = null
.. not-generator = row.kind != .generator-body
.. not-constructor = row.kind != .constructor-body
. declared = instances.rows[row.instance]
. syntax SyntaxId = 0
do match? program.modules[declared.module].decls[declared.decl]
    | .decl-function(fn)
        syntax = fn.syntax
    | .decl-converter(converter)
        syntax = converter.syntax
    | .decl-fromverter(fromverter)
        syntax = fromverter.syntax
if syntax == 0
    = null
. begin = program.modules[declared.module].tree.nodes.loc[syntax].begin
= MIRLoc
    - module-paths[declared.module]
    - true
    - (begin.line + 1) as I32
    - (begin.column + 1) as I32
    - 0
    - 0

────────────────────
_ do choose-functions

` The emitted set, in rank order. The task main is the root: it runs each module's init in
` initialization order, and an init runs its module's main. A main with no statement to run is
` not emitted, nor is the init that would only call it. Every instance an emitted function
` calls or converts through is emitted with it. When a main may panic, so is what the report
` of an unhandled panic calls. A constructor some `super(…)` names has an initializer, and
` no function of its own unless the program also constructs with it.
find-tasks()
. module-count U32 = program.modules.length as U32
. instance-count U32 = instances.length as U32
. kinds = arena.allocate'U32(instance-count)
instance-functions = arena.allocate'U32(instance-count)
c-symbols = arena.allocate'U32(instance-count)
c-suspends = arena.allocate'U8(instance-count)
c-described = arena.allocate'U32(instance-count)
slots = arena.allocate'U32(instance-count)
initializer-functions = arena.allocate'U32(instance-count)
body-functions = arena.allocate'U32(instance-count)
step-functions = arena.allocate'U32(instance-count)
initialized = arena.allocate'Byte(instance-count + 1)
reach-queue = arena.allocate'U32(instance-count + 1)
reach-length = 0
for position in 0 .. < instance-count
    kinds[position] = Reach.none
    initialized[position] = 0
    instance-functions[position] = no-function
    initializer-functions[position] = no-function
    body-functions[position] = no-function
    step-functions[position] = no-function
    c-symbols[position] = no-string
    c-suspends[position] = 0
    c-described[position] = no-runtime-function
    slots[position] = no-slot-index
index-witnesses(instance-count)
. main-functions = arena.allocate'U32(module-count)
. init-functions = arena.allocate'U32(module-count)
main-instances = arena.allocate'U32(module-count)
module-paths = new-id-list(arena, module-count)
for position in 0 .. < module-count
    main-functions[position] = no-function
    init-functions[position] = no-function
    . main-decl = program.modules[position].main-decl
    main-instances[position] = instances.intern(position, main-decl, no-type, 0, no-instance)
    module-paths = module-paths.appended(arena, no-string)

. order = program.init-order
. reports = false
. raises = false
. quiet [ModuleId]
declare-globals()
for position in 0 .. < order.length
    . module = order[position] as ModuleId
    . owner = program.modules[module]
    . main = instances.intern(module, owner.main-decl, no-type, 0, no-instance)
    refuse-global-initializers(module, main)
    if (module-flags[module] /and/ (globals-raise /or/ locals-raise /or/ statics-panic)) != 0
        raises = true
        reports = true
    if !runs-statements(module)
        quiet += module
        continue
    if instances.rows[main].may-panic
        raises = true
    if instances.rows[main].may-panic || instances.rows[main].polls
        reports = true
    if instances.signatures[main].errors.count != 0
        reach-error-report(kinds)
    . init = instances.intern(module, owner.init-decl, no-type, 0, no-instance)
    kinds[main] = Reach.main
    kinds[init] = Reach.init
    module-paths.data[module] = bundle.intern(owner.relative-path)
. entry = program.entry-module
. entry-module = program.modules[entry]
. task = instances.intern(entry, entry-module.task-main-decl, no-type, 0, no-instance)
kinds[task] = Reach.task
. root-count = program.batch-roots.length
batch-starts = arena.allocate'U32(root-count + 1)
batch-finishes = arena.allocate'U32(root-count + 1)
. root-cases = arena.allocate'U32(module-count)
for position in 0 .. < module-count
    root-cases[position] = U32.max
for position in 0 .. < root-count
    . root = program.batch-roots[position] as ModuleId
    root-cases[root] = position as U32
    batch-starts[position] = no-function
    batch-finishes[position] = no-function
    kinds[instances.intern(root, program.modules[root].task-main-decl, no-type, 0, no-instance)] = Reach.task
if thread-locals-panic
    reports = true
if reports
    reach-report(kinds)
reach-live(kinds)
reach(kinds)
if defaults-raise(kinds)
    raises = true
    if !reports
        reach-report(kinds)
        drain(kinds)
if reach-lowered(kinds) && instances.rows[facts.event-register].may-panic
    raises = true
    if !reports
        reports = true
        reach-report(kinds)
        drain(kinds)
keep-reached-styles(kinds)
number-domains()
for module in quiet
    if registers-styles(module)
        . owner = program.modules[module]
        . init = instances.intern(module, owner.init-decl, no-type, 0, no-instance)
        kinds[init] = Reach.init
        reach-queue[reach-length] = init
        reach-length += 1
        module-paths.data[module] = bundle.intern(owner.relative-path)
drain(kinds)
if reach-styles(kinds)
    raises = true
    if !reports
        reports = true
        reach-report(kinds)
        drain(kinds)
. probing = program.module-by-name(probes-module-name)
probe-module = if probing then probing as U32 else U32.max
if compiles-probes()
    raises = true
    reach-probes(kinds)
    if !reports
        reports = true
        reach-report(kinds)
    drain(kinds)
settle-events(kinds)

for instance in instances.ranked
    if kinds[instance] == Reach.none || kinds[instance] == Reach.in-frame
        continue
    . row = instances.rows[instance]
    if kinds[instance] != Reach.initializer
        . kind = (kinds[instance] - 1) as FunctionKind
        if kind == .instance-body && is-task(instance)
            kind = .task-body
        . id FunctionId = functions.length as FunctionId
        . weight U32 = 1
        if kind == .module-main
            main-functions[row.module] = id
            weight = program.modules[row.module].tree.nodes.length as U32
        else if kind == .module-init
            init-functions[row.module] = id
        else if kind == .instance-body
            weight = row.subtree.count + 1
        instance-functions[instance] = id
        functions.append(unnamed-function(kind, instance, row.module, weight))
        if kind == .task-main && root-cases[row.module] != U32.max
            functions[id].place = root-cases[row.module]
            batch-starts[root-cases[row.module]] = id
        if kind == .instance-body && is-rerun(instance)
            declare-live-adapter(id)
        if kind == .instance-body && receiver-view(instance) != no-type
            body-functions[instance] = functions.length as U32
            functions.append(unnamed-function(.viewed-body, instance, row.module, weight))
        if kind == .instance-body && fills-apart(instance)
            body-functions[instance] = functions.length as U32
            functions.append(unnamed-function(.constructor-body, instance, row.module, weight))
        if kind == .instance-body && row.is-generator
            step-functions[instance] = functions.length as U32
            functions.append(unnamed-function(.generator-body, instance, row.module, weight))
    if initialized[instance] != 0
        initializer-functions[instance] = functions.length as U32
        functions.append
            - unnamed-function(.instance-initializer, instance, row.module, row.subtree.count + 1)
declare-lazies()
declare-updaters()
declare-queries()
declare-class-rules()
declare-event-handlers()
declare-style-registrations()
number-keys()
declare-style-gates()
declare-scope-cells()
declare-kept-cells()
declare-slot-forwards()
declare-style-authors()
declare-given-authors()
declare-static-values()
declare-themed-values()
declare-shared-rules()
declare-idle-action()
declare-defaults(kinds)
declare-stream-actions()
declare-machine-handlers()
declare-machine-descriptors()
declare-pattern-arguments()
declare-lazy-rules()
declare-mapped-rules()
declare-raising-rules()
declare-growths()
declare-source-attacher()
declare-probes(kinds)
declare-adapters()
declare-witnesses()
declare-class-adapters()
declare-forwards()
declare-const-arrays()
declare-projection-remaps()
declare-equalities()
number-closures()
number-made()
number-converters()
lay-environments()
lay-captures()
. constants-functions = arena.allocate'U32(module-count)
. globals-functions = arena.allocate'U32(module-count)
. statics-functions = arena.allocate'U32(module-count)
for position in 0 .. < module-count
    constants-functions[position] = no-function
    globals-functions[position] = no-function
    statics-functions[position] = no-function
    . flags = module-flags[position]
    if (flags /and/ has-constants) != 0
        constants-functions[position] = functions.length as U32
        functions.append(unnamed-function(.module-constants, no-instance, position, 1))
    if (flags /and/ has-globals) != 0
        . id FunctionId = functions.length as FunctionId
        globals-functions[position] = id
        functions.append(unnamed-function(.module-globals, no-instance, position, 8))
        functions[id].may-panic = (flags /and/ globals-raise) != 0
    if (flags /and/ has-statics) != 0
        . id FunctionId = functions.length as FunctionId
        statics-functions[position] = id
        functions.append(unnamed-function(.module-statics, no-instance, position, 8))
        functions[id].may-panic = (flags /and/ statics-panic) != 0
for position in 0 .. < storage.length
    if storage[position].function != no-function
        . id FunctionId = functions.length as FunctionId
        . kind = if no-offset then FunctionKind.lazy-global else FunctionKind.task-local-init
            .. no-offset = storage[position].offset == U32.max
        if storage[position].syntax != 0
            kind = .argument-default
        else if storage[position].per-thread
            kind = .thread-local-init
        else if kind == .task-local-init && declared-kind == .global-stack
            kind = .stack-local-init
        .. declared-kind = global-kind(storage[position].module, storage[position].decl)
        functions.append(unnamed-function(kind, no-instance, storage[position].module, 8))
        functions[id].place = position as U32
        . owned = task-or-thread || kind == .stack-local-init || kind == .argument-default
            .. task-or-thread = kind == .task-local-init || kind == .thread-local-init
        functions[id].may-panic = kind == .lazy-global || (owned && owner-panics)
        .. owner-panics = instances.rows[storage[position].owner].may-panic
        storage[position].function = id
if task-local-order.length != 0
    task-init = functions.length as FunctionId
    functions.append(unnamed-function(.task-init, no-instance, entry, 1))
    for row in task-local-order
        if functions[storage[row].function].may-panic
            functions[task-init].may-panic = true
if thread-local-order.length != 0
    thread-init = functions.length as FunctionId
    functions.append(unnamed-function(.thread-init, no-instance, entry, 1))
    for row in thread-local-order
        if functions[storage[row].function].may-panic
            functions[thread-init].may-panic = true
if compiles-probes()
    . probes = probe-module as ModuleId
    probe-setup = functions.length as FunctionId
    functions.append(unnamed-function(.probe-setup, no-instance, probes, 1))
    functions[probe-setup].may-panic = true
    probe-teardown = functions.length as FunctionId
    functions.append(unnamed-function(.probe-teardown, no-instance, probes, 1))
    functions[probe-teardown].may-panic = true
    probe-closer = functions.length as FunctionId
    functions.append(unnamed-function(.probe-closer, no-instance, probes, 1))
    functions[probe-closer].may-panic = true
    probe-flush = functions.length as FunctionId
    functions.append(unnamed-function(.probe-flush, no-instance, probes, 1))
    functions[probe-flush].may-panic = true
    probe-safepoint = functions.length as FunctionId
    functions.append(unnamed-function(.probe-safepoint, no-instance, probes, 1))
    functions[probe-safepoint].may-panic = true
    probe-loops = program.probes.compiles-safepoints()
if root-count != 0
    batch-main = functions.length as FunctionId
    functions.append(unnamed-function(.batch-main, no-instance, entry, 1))
    for position in 0 .. < root-count
        batch-finishes[position] = functions.length as U32
        functions.append
            - unnamed-function(.batch-finish, no-instance, program.batch-roots[position], 1)
        functions[batch-finishes[position]].place = position as U32
functions.append(unnamed-function(.process-main, no-instance, entry, 1))

for id in 0 .. < functions.length
    . function = functions[id]
    if module-paths.data[function.module] == no-string
        module-paths.data[function.module] = bundle.intern
            - program.modules[function.module].relative-path
    . start U32 = calls.length
    if function.kind == .module-init && main-functions[function.module] != no-function
        calls = calls.appended(arena, main-functions[function.module])
    else if function.kind == .task-main
        . starts = program.batch-order-starts
        . modules = program.batch-order-modules
        . first Size = if root-count == 0 then 0 else starts[function.place] as Size
        . last Size = if root-count == 0 then order.length else starts[function.place + 1] as Size
        for position in first .. < last
            . module = if root-count == 0 then order[position] else modules[position]
            if constants-functions[module] != no-function
                calls = calls.appended(arena, constants-functions[module])
        for position in first .. < last
            . module = if root-count == 0 then order[position] else modules[position]
            if statics-functions[module] != no-function
                calls = calls.appended(arena, statics-functions[module])
            . local = task-local-heads[module]
            while local != no-storage
                calls = calls.appended(arena, storage[local].function)
                local = storage[local].next
            for registering in registration-functions
                if functions[registering].module == module
                    calls = calls.appended(arena, registering)
            if globals-functions[module] != no-function
                calls = calls.appended(arena, globals-functions[module])
            . init = init-functions[module]
            if init != no-function
                calls = calls.appended(arena, init)
            if module == probe-module && probe-setup != no-function
                calls = calls.appended(arena, probe-setup)
        if probe-flush != no-function
            calls = calls.appended(arena, probe-flush)
    else if function.kind == .probe-closer
        if task-init != no-function
            calls = calls.appended(arena, task-init)
        calls = calls.appended(arena, probe-teardown)
    else if function.kind == .process-main
        calls = calls.appended
            - arena
            - if root-count == 0 then instance-functions[task] else batch-main
    else if function.kind == .batch-main
        for position in 0 .. < root-count
            calls = calls.appended(arena, batch-starts[position])
    else if function.kind == .batch-finish && function.place + 1 < root-count
        calls = calls.appended(arena, batch-starts[function.place + 1])
    else if function.kind == .task-init
        for row in task-local-order
            calls = calls.appended(arena, storage[row].function)
    else if function.kind == .thread-init
        for row in thread-local-order
            calls = calls.appended(arena, storage[row].function)
    functions[id].calls = Span(start, calls.length - start)
    name-function(id as FunctionId)
. instance-total = instances.length
. suspending = arena.allocate'U8(if suspends then instance-total + 1 else 1)
if suspends
    for position in 0 .. < instance-total + 1
        suspending[position] = 0
    for fact in facts.calls
        if fact.callee != no-instance && c-suspends[fact.callee] != 0
            suspending[fact.instance] = 1
for id in 0 .. < functions.length
    . function = functions[id]
    . is-body = of-instance || function.kind == .viewed-body || function.kind == .constructor-body
        .. of-instance = function.kind == .instance-body || function.kind == .instance-initializer
    if suspends && function.instance != no-instance && suspending[function.instance] != 0
        functions[id].carries = true
    if function.kind == .generator-body
        functions[id].may-panic = true
        functions[id].polls = instances.rows[function.instance].polls
    else if is-body && step-functions[function.instance] != no-function
        functions[id].may-panic = false
    else if function.kind == .module-main || is-body
        functions[id].may-panic = instances.rows[function.instance].may-panic
        functions[id].polls = body-polls || runs-polling-rule(function.instance)
        .. body-polls = instances.rows[function.instance].polls
    else if function.kind == .module-init
        . main = main-functions[function.module]
        . runs = main != no-function && instances.rows[functions[main].instance].may-panic
        functions[id].may-panic = runs || registers-styles(function.module)
    else if function.kind == .task-main
        functions[id].may-panic = raises
    else if function.kind == .event-handler || function.kind == .machine-handler
        functions[id].polls = function.instance != no-instance && handler-polls
        .. handler-polls = instances.rows[function.instance].polls
    else if function.kind == .class-rule-updater
        . unit = class-rules[function.place].unit
        functions[id].polls = unit != no-instance && instances.rows[unit].polls
    else if function.kind == .task-body
        functions[id].may-panic = instances.rows[function.instance].may-panic || init-panics
        .. init-panics = task-init != no-function && functions[task-init].may-panic
        functions[id].polls = instances.rows[function.instance].polls
    else if function.kind == .adapter && adapters[function.place].runs == no-instance
        functions[id].may-panic = true
    else if function.kind == .adapter
        . runs = adapters[function.place].runs
        functions[id].may-panic = instances.rows[runs].may-panic || called-through[runs] != 0
        . passed = facts.first-passed(runs)
        while passed != no-fact
            . converter = facts.conversions[passed].callee
            if converter != no-instance && instances.rows[converter].may-panic
                functions[id].may-panic = true
            if facts.conversions[passed].kind == .relation-unwrap-cast
                functions[id].may-panic = true
            passed = facts.conversions[passed].next
    else if function.kind == .union-dispatch
        functions[id].may-panic = forward-panics(facts.forwards[function.place])
    else if function.kind == .interface-equality
        functions[id].may-panic = instances.rows[function.instance].may-panic
    else if function.kind == .class-adapter
        . adapter = class-adapters[function.place]
        functions[id].may-panic = instances.rows[adapter.override].may-panic
        . written = instances.rows[adapter.override].subtree
        if written.count != 0
            . passed = facts.first-conversion(adapter.override, written.start + written.count - 1)
            while passed != no-fact
                . converter = facts.conversions[passed].callee
                if converter != no-instance && instances.rows[converter].may-panic
                    functions[id].may-panic = true
                passed = facts.conversions[passed].next
    else if function.kind == .witness
        . filled = witness-functions[function.place]
        . callee = filled.callee
        functions[id].may-panic = callee != no-instance && (callee-panics || stepped-override)
        .. callee-panics = instances.rows[callee].may-panic
        .. stepped-override = filled.through.count != 0 && overridden[callee] == 2
        if callee != no-instance && instances.signatures[callee].errors.count > proto-errors
            functions[id].may-panic = true
        .. proto-errors = instances.signatures[filled.proto].errors.count
        for offset in 0 .. < filled.through.count
            . getter = facts.step-callees[filled.through.start + offset]
            if getter != no-instance && (getter-panics || overridden[getter] == 2)
                functions[id].may-panic = true
            .. getter-panics = instances.rows[getter].may-panic
        if callee == no-instance && filled.property < default-count
            . lazy = lazy-functions[filled.property]
            if lazy != no-function && functions[lazy].may-panic
                functions[id].may-panic = true
        . memos = layouts.memo-places
        if callee == no-instance && memos && in-defaults && memos[filled.property] != 0
            functions[id].may-panic = true
        .. in-defaults = filled.property < default-count
        if callee != no-instance && instances.rows[callee].subtree.count != 0
            . written = instances.rows[callee].subtree
            . passed = facts.first-conversion(callee, written.start + written.count - 1)
            while passed != no-fact
                . converter = facts.conversions[passed].callee
                if converter != no-instance && instances.rows[converter].may-panic
                    functions[id].may-panic = true
                passed = facts.conversions[passed].next

────────────────────
_ do declare-adapters

` A function for each closure or binding some emitted instance makes a value of a function
` type, for each such type, in the module that first makes one. It is called through the
` value, so it writes the panic signal, as a function a class table holds does.
for index in 0 .. < adapters.length
    . row = adapters[index]
    . id FunctionId = functions.length as FunctionId
    functions.append
        - unnamed-function(.adapter, no-instance, instances.rows[row.instance].module, 8)
    functions[id].type = row.from
    functions[id].place = index as U32
    functions[id].carries = true
    adapters[index].function = id

────────────────────
_ do index-witnesses
    - instance-count U32

` Reads what the type pass said of interfaces: the instances of their functions called
` through a value, the function that answers each for each type, and the tables it found
` for each interface and for each type, linked in the order it found them.
. type-count = types.rows.length
prototypes = new-id-list(arena, 4)
slot-counts = arena.allocate'U32(type-count + 1)
called-through = arena.allocate'Byte(instance-count + 1)
for position in 0 .. < type-count
    slot-counts[position] = 0
for position in 0 .. < instance-count
    called-through[position] = 0
for proto in facts.witness-protos
    called-through[proto] = 1
for position in 0 .. < facts.witness-slots.length
    . slot = facts.witness-slots[position]
    if slot.based
        based-fills[pair-key(slot.value, slot.proto)] = position as U32
    else
        witness-fills[pair-key(slot.value, slot.proto)] = position as U32
. table-count U32 = facts.witness-tables.length as U32
table-links = arena.allocate'U32(table-count + 1)
value-table-links = arena.allocate'U32(table-count + 1)
for offset in 0 .. < table-count
    . position = table-count - 1 - offset
    . table = facts.witness-tables[position]
    table-links[position] = table-heads[table.interface] ?? no-slot-index
    table-heads[table.interface] = position
    value-table-links[position] = value-table-heads[table.value] ?? no-slot-index
    value-table-heads[table.value] = position

────────────────────
_ do reach-witness
    - value TypeId
    - interface TypeId

` Notes the witness table of a type converted to an interface. A value of an interface
` converted to one it is derived from has its table already. The tables of classes are linked
` for each interface in the order they are noted.
if value == no-type || value == invalid-type || types.completions[value].intrinsic == .interface
    =
. key = pair-key(value, interface)
if witness-rows[key] != null
    =
. index U32 = witnesses.length as U32
witness-rows[key] = index
. named = "wtable.${hex-text(types.stable-keys[value])}.${hex-text(types.stable-keys[interface])}"
witnesses.append(Witness(value, interface, bundle.intern(named)))
class-witness-links += no-slot-index
if !is-class(value)
    =
. tail = class-witness-tails[interface]
if tail
    class-witness-links[tail] = index
else
    class-witness-heads[interface] = index
class-witness-tails[interface] = index

────────────────────
_ do fill-witnesses Bool
    - kinds CPointer'U32

` Brings what the witness tables hold into the emitted set, and says whether there was
` anything new to bring: the table of each class the program constructs that is derived
` from one converted, and for each table and each prototype of its interface or of one
` that is derived from, the function the type pass found for the type. A prototype the
` type pass found none for has no shape. The interface's own function fills the slot as it
` is, but in the section of an interface the table's own is derived from, where a function
` runs it as the type does: the frames the reference's stack traces have. A pair of a table
` and a prototype is settled the first time it is met, so each pass meets only the pairs
` that a table or a prototype added since the last one makes, in the order a pass over all
` of them would, and of those only the pairs where the prototype is of a section of the
` table.
if tables-filled && filled-prototypes == prototypes.length && filled-classes == class-count
    = false
.. tables-filled = filled-tables == witnesses.length
. compared-classes = filled-classes
filled-classes = class-count
. compared U32 = filled-tables
. compared-prototypes U32 = filled-prototypes
derive-tables(compared-classes)
filled-tables = witnesses.length as U32
filled-prototypes = prototypes.length
for index in compared .. < filled-tables
    . equality = facts.equality-of(witnesses[index].value, witnesses[index].interface)
    if equality != no-instance && kinds[equality] == Reach.none
        kinds[equality] = Reach.in-frame
        reach-queue[reach-length] = equality
        reach-length += 1
while proto-sections.length < filled-prototypes
    proto-sections += instances.rows[prototypes[proto-sections.length]].self-type
for index in 0 .. < filled-tables
    . first = if index < compared then compared-prototypes else 0
    . row = witnesses[index]
    . sections = section-ranges[sections-of(row.interface)]
    for position in first .. < filled-prototypes
        . section = proto-sections[position]
        for offset in 0 .. < sections.count
            if section-items[sections.start + offset] == section
                fill-witness(kinds, row, prototypes[position], section)
= true

────────────────────
_ do derive-tables
    - compared-classes U32

` Notes the table of each class the program constructs that is derived from a class a table
` was noted for, for the same interface (`fill-witnesses`), in the order a pass over each
` table and each table the type pass found for its interface would note them. The tables this
` met before meet only the classes constructed since its last pass, `compared-classes` on; the
` others meet every class.
. known U32 = witnesses.length as U32
. found [U64]
for place in compared-classes .. < class-count
    . value = constructed-order[place]
    . position = value-table-heads[value] ?? no-slot-index
    while position != no-slot-index
        . index = class-witness-heads[facts.witness-tables[position].interface] ?? no-slot-index
        while index != no-slot-index && index < derived-tables
            if derives(value, witnesses[index].value)
                found += ((index as U64) /lshift/ 32) /or/ (position as U64)
            index = class-witness-links[index]
        position = value-table-links[position]
for pair in sorted-pairs(found)
    . fact = facts.witness-tables[(pair /and/ 0xffffffff) as Size]
    reach-witness(fact.value, fact.interface)
for place in compared-classes .. < class-count
    . value = constructed-order[place]
    for pair in facts.dynamic-witnesses
        if value != pair.value && !derives(value, pair.value)
            continue
        . position = value-table-heads[value] ?? no-slot-index
        while position != no-slot-index
            if facts.witness-tables[position].interface == pair.interface
                reach-witness(value, pair.interface)
            position = value-table-links[position]
for index in derived-tables .. < known
    . row = witnesses[index]
    if !is-class(row.value)
        continue
    . position = table-heads[row.interface] ?? no-slot-index
    while position != no-slot-index
        . fact = facts.witness-tables[position]
        if constructed[fact.value] != 0 && derives(fact.value, row.value)
            reach-witness(fact.value, fact.interface)
        position = table-links[position]
derived-tables = known

────────────────────
_ do fill-witness
    - kinds CPointer'U32
    - row Witness
    - proto InstanceId
    - section TypeId

` Settles the slot of one prototype in one witness table, in the section of the table that
` holds it, as `fill-witnesses` describes.
. key = pair-key(row.value, proto)
. view = based-fills[key]
if view != null && section != row.interface && witness-based[key] == null
    . based = facts.witness-slots[view]
    mark(kinds, based.callee)
    witness-based[key] = made-witness
        - row.value
        - proto
        - based.callee
        - U32.max
        - based.through
        - based.converts
if witness-made[key] != null
    =
. fill = witness-fills[key]
if fill == null
    . written = instances.rows[proto]
    refusals.append
        - Refusal
            - .refused-function
            - written.module
            - written.subtree.start + written.subtree.count - 1
    witness-made[key] = own-function
    =
. slot = facts.witness-slots[fill]
mark(kinds, slot.callee)
for offset in 0 .. < slot.through.count
    mark(kinds, facts.step-callees[slot.through.start + offset])
if slot.callee == proto
    witness-made[key] = own-function
else
    witness-made[key] = made-witness
        - row.value
        - proto
        - slot.callee
        - slot.property
        - slot.through
        - slot.converts

────────────────────
_ do made-witness U32
    - value TypeId
    - proto InstanceId
    - callee InstanceId
    - property U32
    - through RowRange'U32
    - converts Bool

` The witness function that fills a prototype's slot in a type's table with a function of the
` type's. A class that answers with a function called on the object as it is shares the one
` made for the first class that answers with that function, as the two would be the same;
` any other type has one of its own.
. shared = is-class(value) && callee != no-instance && through.count == 0 && !own-errors
    .. own-errors = carries-own-errors(types, value)
. key = pair-key(callee, proto)
if shared
    . known = witness-shared[key]
    =? known if known != null
. index U32 = witness-functions.length as U32
witness-functions.append
    - WitnessFunction(value, proto, callee, property, through, no-function, converts, shared)
if shared
    witness-shared[key] = index
= index

────────────────────
_ do sections-of U32
    - interface TypeId

` The row of `section-ranges` that holds the sections of a witness table for an interface,
` gathered the first time they are asked for. Only the tables' build asks, before emission
` reads the tables from several threads.
. known = section-rows[interface]
if known
    = known
. order [TypeId]
gather-sections(interface, order)
. row U32 = section-ranges.length as U32
section-ranges += RowRange'TypeId(section-items.length as U32, order.length as U32)
for gathered in order
    section-items += gathered
section-rows[interface] = row
= row

────────────────────
+ do delegates Bool
    - type TypeId

` Whether a type, or one it is derived from, answers some interface through a property.
. current = type
while current != no-type && current != invalid-type
    if types.delegates-of(current).length != 0
        = true
    current = types.completions[current].base
= false

────────────────────
+ do derives Bool
    - type TypeId
    - base TypeId

` Whether a class is derived from another, and is not that class.
. current = types.completions[type].base
while current != no-type && current != invalid-type
    if current == base
        = true
    current = types.completions[current].base
= false

────────────────────
_ do gather-sections
    - interface TypeId
    - order [TypeId]

` The sections of a witness table for an interface, in order: the interface, then those it
` is derived from, each once.
for known in order
    if known == interface
        =
order += interface
for parent in types.interfaces-of(interface)
    gather-sections(parent, order)

────────────────────
_ do reaches-twice Bool
    - interface TypeId
    - seen [TypeId]

` Whether an interface is derived from another by more than one way: gathering its
` sections, as `gather-sections` does, meets one already gathered.
for known in seen
    if known == interface
        = true
seen += interface
. again = false
for parent in types.interfaces-of(interface)
    if reaches-twice(parent, seen)
        again = true
= again

────────────────────
_ do refuse-table
    - interface TypeId

` Refuses the program for a witness table of an interface with no shape, at the interface.
do match? types.rows[interface]
    | .type-class(row)
        do match? program.modules[row.module].decls[row.decl]
            | .decl-class(class)
                refusals.append(Refusal(.refused-type, row.module, class.syntax))

────────────────────
+ do section-offset U32
    - interface TypeId
    - owner TypeId

` Where the section of an interface starts in a witness table for one derived from it,
` counted in slots, or no slot where the one is not derived from the other.
. order [TypeId]
gather-sections(interface, order)
. offset U32
for section in order
    if section == owner
        = offset
    offset += witness-header-slots + slot-counts[section]
= no-slot-index

────────────────────
+ do witness-slot-function FunctionId
    - symbol StringId
    - offset U32

if offset % table-slot-size != 0 || offset / table-slot-size < witness-header-slots
    = no-function
. slot = offset / table-slot-size - witness-header-slots
for row in witnesses
    if row.symbol != symbol
        continue
    for position in 0 .. < prototypes.length
        . proto = prototypes[position]
        if instances.rows[proto].self-type == row.interface && slots[proto] == slot
            . made = witness-made[pair-key(row.value, proto)] ?? own-function
            = if made == own-function then instance-functions[proto] else witness-function
                .. witness-function = witness-functions[made].function
    = no-function
= no-function

────────────────────
+ receiver-view TypeId
    - instance InstanceId

` The interface an instance's receiver is seen as, where the instance is a function of an
` interface run for a value of a type that is none: the type pass gave its receiver the
` interface's type. No type for any other instance.
interface-default-owner(types, program, row.module, row.decl, row.self-type)

.. row = instances.rows[instance]

────────────────────
+ witness-of U32
    - value TypeId
    - interface TypeId

` The witness table of a type for an interface, or none.
witness-rows[pair-key(value, interface)] ?? no-slot-index

────────────────────
+ is-prototype Bool
    - callee InstanceId

` Whether a call of an instance is made through the slot it has in a witness table.
callee != no-instance && slots[callee] != no-slot-index && called-through[callee] != 0

────────────────────
_ do declare-witnesses

` A function for each slot of a witness table that a type fills with a function of its
` own. It is called through the table, so it writes the panic signal.
for index in 0 .. < witness-functions.length
    . row = witness-functions[index]
    . id FunctionId = functions.length as FunctionId
    . module = if row.callee == no-instance then class-module(row.value) else callee-module
        .. callee-module = instances.rows[row.callee].module
    functions.append(unnamed-function(.witness, no-instance, module, 8))
    functions[id].type = row.value
    functions[id].place = index as U32
    functions[id].carries = true
    witness-functions[index].function = id

────────────────────
_ do declare-class-adapters

` A function for each method a class's table holds in the place of one of a base class it
` overrides, where the two answer different types or one raises errors and the other does
` not. It is called through the table, so it writes the panic signal. Each override fact
` keeps its function, which the table takes where the fact is placed. A chain of classes
` has an override fact for each method of every base, so a fact reads no signature. They are
` declared in the order of the ranks of the overrides, then of the bases.
. instance-count = instances.length
. answers = arena.allocate'U32(instance-count + 1)
. results = arena.allocate'U32(instance-count + 1)
for instance in 0 .. < instance-count
    answers[instance] = no-type
    results[instance] = no-type
    if instance-functions[instance] != no-function
        . signature = instances.signatures[instance]
        answers[instance] = signature.returns
        results[instance] = signature.result
. fact-count = facts.overrides.length
override-adapters = arena.allocate'U32(fact-count + 1)
. keys [U64]
for position in 0 .. < fact-count
    override-adapters[position] = no-function
    . row = facts.overrides[position]
    keys += rank-key(row.override, instances.rank-of(row.base))
for position in ranked-order(keys)
    . base = facts.overrides[position].base
    . override = facts.overrides[position].override
    if instance-functions[base] == no-function || instance-functions[override] == no-function
        continue
    if answers[base] == answers[override] && results[base] == results[override]
        continue
    . key = pair-key(base, override)
    . found = class-adapter-rows[key]
    if found
        override-adapters[position] = class-adapters[found].function
        continue
    . id FunctionId = functions.length as FunctionId
    functions.append
        - unnamed-function(.class-adapter, no-instance, instances.rows[override].module, 8)
    functions[id].place = class-adapters.length as U32
    functions[id].carries = true
    class-adapter-rows[key] = class-adapters.length as U32
    class-adapters.append(ClassAdapter(base, override, id))
    override-adapters[position] = id

────────────────────
_ do declare-forwards

` The function made for each member a union forwards, `union-dispatch-N`, where a stack trace
` names it: a case may panic or let errors out. The members that are one are found among
` those of the same value and union alone, and their function is placed at the first of
` them written in an emitted function. `N` counts the members the whole program forwards, in
` the order they are written. A member of a union that is no class has no function, and no
` shape where it needs one.
. count = facts.forwards.length
forward-functions = arena.allocate'U32(count + 1)
forward-needs = arena.allocate'Byte(count + 1)
forward-numbers = arena.allocate'U32(count + 1)
. members [U32]
. member-heads [U32]
. heads [U32]
. head-links [U32]
. buckets = Map'U64'U32(arena)
. keys [U64]
for position in 0 .. < count
    . forward = facts.forwards[position]
    forward-functions[position] = no-function
    forward-needs[position] = 0
    forward-numbers[position] = 0
    keys += rank-key(forward.instance, forward.syntax)
for position in ranked-order(keys)
    . forward = facts.forwards[position]
    if facts.plan-of(forward.instance, forward.syntax) != .plan-forward
        continue
    forward-rows[pair-key(forward.instance, forward.syntax)] = position
    forward-needs[position] = if forward-panics(forward) || forward.result != no-type then 1 else 0
    if instance-functions[forward.instance] == no-function
        continue
    members += position
    . key U64 = ((forward.value as U64) /lshift/ 32) /or/ (union-of(forward) as U64)
    . first = buckets[key]
    . found = U32.max
    . link = first ?? U32.max
    while link != U32.max && found == U32.max
        if same-plan(facts.forwards[heads[link]], forward)
            found = link
        link = head-links[link]
    if found == U32.max
        found = heads.length as U32
        heads += position
        head-links += first ?? U32.max
        buckets[key] = found
    else
        . head = facts.forwards[heads[found]]
        if written-first(forward.instance, forward.syntax, head.instance, head.syntax)
            heads[found] = position
    member-heads += found
. made [FunctionId]
. head-count = heads.length as U32
for index in 0 .. < head-count
    . head = heads[index]
    . placed = facts.forwards[head]
    . union = cases-union(placed)
    made += no-function
    if forward-needs[head] == 0 || union == no-type || class-ref(types, union).decl == 0
        continue
    . number U32 = 1
    for other in 0 .. < head-count
        . earlier = facts.forwards[heads[other]]
        if other != index && before
            number += 1
        .. before = written-first(earlier.instance, earlier.syntax, placed.instance, placed.syntax)
    . id FunctionId = functions.length as FunctionId
    functions.append
        - unnamed-function(.union-dispatch, no-instance, instances.rows[placed.instance].module, 8)
    functions[id].place = head
    forward-numbers[head] = number
    made[index] = id
for offset in 0 .. < members.length
    forward-functions[members[offset]] = made[member-heads[offset]]

────────────────────
_ do declare-const-arrays

` A constant table for each ConstArray the type pass folded: its items packed at their
` size, and a string as the address of a literal. They are made in the order of their instances'
` ranks, then of where they are written.
. made U32
. keys [U64]
for array in facts.const-arrays
    const-array-symbols += no-string
    keys += rank-key(array.instance, array.syntax)
for position in ranked-order(keys)
    . array = facts.const-arrays[position]
    if is-retired(array.instance)
        continue
    . item = layouts.pointee-type(array.type)
    . layout = if item != no-type then layouts.values[item] else no-layout
    if layout == no-layout
        continue
    . size = layouts.rows[layout].size
    . is-text = item == types.string-type
    . kind = constant-kind(size)
    if !is-text && !kind
        continue
    . name = "constarray.$made"
    . first U32 = bundle.constant-items.length as U32
    . tree = program.modules[instances.rows[array.instance].module].tree
    for offset in 0 .. < array.count
        . row = facts.const-items[array.first + offset]
        if is-text
            . text = tree-text(tree, row.text)
            . literal = add-literal("$name.$offset", text)
            bundle.constant-items.append(ConstantItem(.label-constant, 0, literal))
        else
            bundle.constant-items.append(ConstantItem(kind!, row.bits, no-string))
    . symbol = bundle.intern(name)
    bundle.constant-tables.append
        - ConstantTable(symbol, if is-text then 8 else size, Span(first, array.count))
    const-array-rows[pair-key(array.instance, array.syntax)] = position
    const-array-symbols[position] = symbol
    made += 1

────────────────────
_ constant-kind ConstantKind?
    - size U32

match? size
    |= 1
        ConstantKind.byte-constant
    |= 2
        ConstantKind.short-constant
    |= 4
        ConstantKind.long-constant
    |= 8
        ConstantKind.quad-constant

────────────────────
_ tree-text String
    - tree AST
    - syntax SyntaxId

match tree.nodes[syntax]
    | .node-string-syntax(row)
        row.text
    ??
        ""

────────────────────
+ const-array-row U32
    - instance InstanceId
    - syntax SyntaxId

` The ConstArray made at a node with a constant table, as its row of the type pass's facts,
` or none where it has none.
if found then found else U32.max

.. found = const-array-rows[pair-key(instance, syntax)]

────────────────────
+ const-array-symbol StringId
    - row U32

const-array-symbols[row]

────────────────────
_ do declare-projection-remaps

` A constant table of bytes for each style-sheet projection that gives a union's cases new
` numbers, as the reference's `styleProjectionRemapValue` lays one down: the number of the
` property's case for each of the slot's. The tables are numbered, and the runtime registers each
` by its number, in the order of what first names them: the declarations of markup elements by
` the stable keys of their instances and their sites, then the lines of style rules by the
` applications that bind their slots (`application-order`) and their sites, so that the numbers
` are the same in any typing order.
for _ in 0 .. < facts.style-projections.length
    remap-symbols += no-string
    remap-numbers += U32.max
. declarations = facts.style-declarations
. declared [U32]
for index in 0 .. < declarations.length
    if declarations[index].projection != U32.max
        declared += index as U32
. slots = facts.rule-slots
. slotted [U32]
for index in 0 .. < slots.length
    if slots[index].projection != U32.max
        slotted += index as U32
. by-site = sort(declared) • using :: a, b => line-order(declarations[a].instance, declarations[a].site, declarations[b].instance, declarations[b].site)
. by-rule = sort(slotted) • using :: a, b => rule-slot-order(slots[a], slots[b])
. number = 0u32
for index in by-site
    number = declare-remap(declarations[index].projection, number)
for index in by-rule
    number = declare-remap(slots[index].projection, number)

────────────────────
_ rule-slot-order Comparison
    - slot RuleSlot
    - other RuleSlot

|? slot.application != other.application && placed != Comparison.equal
    placed
??
    ordered(slot.site, other.site)

.. placed = application-order(slot.application, other.application)

────────────────────
_ do declare-remap U32
    - index U32
    - number U32

. projection = facts.style-projections[index]
=? number if projection.kind != 2 || remap-numbers[index] != U32.max
. first U32 = bundle.constant-items.length as U32
for offset in 0 .. < projection.count
    . tag = facts.projection-tags[projection.first + offset]
    bundle.constant-items.append(ConstantItem(.byte-constant, tag, no-string))
. symbol = bundle.intern("styleprojectionremap.$number")
bundle.constant-tables.append(ConstantTable(symbol, 1, Span(first, projection.count)))
remap-symbols[index] = symbol
remap-numbers[index] = number
= number + 1

────────────────────
+ remap-symbol StringId
    - projection U32

` The constant table of the case numbers a style-sheet projection gives a union's cases.
remap-symbols[projection]

────────────────────
+ remap-number U32
    - projection U32

remap-numbers[projection]

────────────────────
_ do declare-equalities

` A function for each witness table whose interface, or one it is derived from, has its
` values compared: it runs the comparison of two values of the table's type the type pass
` made. It is called through the table, so it writes the panic signal.
equality-functions = arena.allocate'U32(witnesses.length + 1)
for index in 0 .. < witnesses.length
    equality-functions[index] = no-function
    . row = witnesses[index]
    . compared = facts.equality-of(row.value, row.interface)
    if compared == no-instance
        continue
    . id FunctionId = functions.length as FunctionId
    functions.append
        - unnamed-function(.interface-equality, compared, instances.rows[compared].module, 8)
    functions[id].place = index as U32
    functions[id].carries = true
    equality-functions[index] = id

────────────────────
+ forward-function FunctionId
    - instance InstanceId
    - syntax SyntaxId

` The function made for a member a union forwards at a node, or none where it is made in
` place.
if found then forward-functions[found] else no-function

.. found = forward-rows[pair-key(instance, syntax)]

────────────────────
+ forward-unbuilt Bool
    - instance InstanceId
    - syntax SyntaxId

` Whether a member a union forwards at a node needs a function of its own and has none.
|? !found
    false
??
    forward-needs[found] != 0 && forward-functions[found] == no-function

.. found = forward-rows[pair-key(instance, syntax)]

────────────────────
+ forward-of ForwardFact
    - function FunctionId

` The member a union forwards that a function was made for, placed where it is forwarded first.
facts.forwards[functions[function].place]

────────────────────
_ do forward-panics Bool
    - forward ForwardFact

` Whether a case of a member a union forwards may panic: its call, through any function a
` table holds for it, or the read of a lazy property, whose value may. A row of a table that
` grows is checked before its case is read, which may panic too.
if types.intrinsic-of(union-of(forward)) == .table-row
    = true
. call = facts.first-call(forward.instance, forward.syntax)
if call == no-fact
    . union = cases-union(forward)
    . name = forward-name(forward)
    if union == no-type || !name
        = true
    for fact in types.cases-of(union)
        . found = types.property-named(fact.type, name)
        if found && types.properties[found].storage-kind == .storage-lazy
            = true
    = false
while call != no-fact
    . callee = facts.calls[call].callee
    if callee == no-instance || is-prototype(callee) || panics || overridden[callee] == 2
        = true
    .. panics = instances.rows[callee].may-panic
    call = facts.calls[call].next
= false

────────────────────
_ do same-plan Bool
    - left ForwardFact
    - right ForwardFact

` Whether two members a union forwards are one to TypeScript: the same member of the same
` union, given arguments, or a setter a value, of the same types, by the same calls of its
` cases, giving the same type.
if left.value != right.value || union-of(left) != union-of(right) || names-differ
    = false
.. names-differ = forward-name(left) != forward-name(right)
if (left.given == 0) != (right.given == 0)
    = false
if left.given != 0 && facts.node-type(left.instance, left.given) != right-type
    = false
.. right-type = facts.node-type(right.instance, right.given)
. given = forward-arguments(left)
. taken = forward-arguments(right)
if given.count != taken.count
    = false
. tree = program.modules[instances.rows[left.instance].module].tree
. other-tree = program.modules[instances.rows[right.instance].module].tree
for offset in 0 .. < given.count
    . mine = argument-expression(tree, tree.children[given.start + offset])
    . theirs = argument-expression(other-tree, other-tree.children[taken.start + offset])
    if facts.node-type(left.instance, mine) != facts.node-type(right.instance, theirs)
        = false
. one = facts.first-call(left.instance, left.syntax)
. other = facts.first-call(right.instance, right.syntax)
while one != no-fact && other != no-fact
    if facts.calls[one].callee != facts.calls[other].callee
        = false
    one = facts.calls[one].next
    other = facts.calls[other].next
= one == no-fact && other == no-fact

────────────────────
+ do forward-get SyntaxId
    - forward ForwardFact

` The member a union forwards as written: the name read from the union.
. tree = program.modules[instances.rows[forward.instance].module].tree
do match? tree.nodes[forward.syntax]
    | .node-call-expression(call)
        = call.callable
    | .node-get-expression
        = forward.syntax
= 0

────────────────────
+ do forward-arguments RowRange'SyntaxId
    - forward ForwardFact

` The arguments written for a member a union forwards, none for one read.
. tree = program.modules[instances.rows[forward.instance].module].tree
do match? tree.nodes[forward.syntax]
    | .node-call-expression(call)
        = call.operands
= RowRange'SyntaxId()

────────────────────
+ argument-expression SyntaxId
    - tree AST
    - argument SyntaxId

` The expression of an argument written: what follows its name, when it has one.
match tree.nodes[argument]
    | .node-argument(named)
        named.expr
    ??
        argument

────────────────────
_ do forward-name Atom?
    - forward ForwardFact

. tree = program.modules[instances.rows[forward.instance].module].tree
do match? tree.nodes[forward-get(forward)]
    | .node-get-expression(get)
        = get.name
= null

────────────────────
_ do union-of TypeId
    - forward ForwardFact

. tree = program.modules[instances.rows[forward.instance].module].tree
do match? tree.nodes[forward-get(forward)]
    | .node-get-expression(get)
        = facts.node-type(forward.instance, get.object)
= no-type

────────────────────
_ cases-union TypeId
    - forward ForwardFact

` The union whose cases answer a member forwarded: the receiver, or the union a row of a table
` it is holds rows of.
if held != no-type then held else receiver

.. receiver = union-of(forward)
.. held = if receiver != no-type then row-union(types, receiver) else no-type

────────────────────
_ do number-made

` Numbers the functions made of rules and of what their patterns hold in the order they are
` written. Each takes a name others may take too. The function of a rule a module declares
` and the function a local rule runs in take the rule's name followed by `-direct`, and one
` made of either again, for the collectors or the errors calls give it, takes it once more.
` The function an action runs in is `stream-action`, the function made of a pattern given to
` a rule is `static-inline-match`, and the one that runs a rule given alone is the rule's
` with `Casting`. The function that fills an object with the markup of a class is `content`.
` Of the functions of one name in a module the first written has the name, and a stack trace
` prints the second with 2 after it, as `written-numbers` counts them.
. groups [Size]
. places [U64]
. owners [U32]
for id in 0 .. < functions.length
    . group = made-group(functions[id])
    groups += group
    owners += instances.rank-of(functions[id].instance)
    if group == 0
        places += 0
    else
        places += made-place(functions[id])
. numbers = written-numbers(groups, places, owners)
for id in 0 .. < functions.length
    if groups[id] == 0
        continue
    made-numbers[id] = numbers[id]
    if functions[id].kind == .instance-body
        made-ranks[functions[id].instance] = numbers[id]

────────────────────
_ do made-group Size
    - function EmittedFunction

` The name a function shares with the others `number-made` counts with it, as a key: the
` kind of name, the module that shows it and the name. None for a function it does not
` number.
if function.kind == .stream-action
    = made-key(1, function.module, 0)
if function.kind == .pattern-helper
    = made-key(2, function.module, 0)
if function.kind == .pattern-cast
    . rule = facts.pattern-arguments[function.place].rule
    = made-key(3, instances.rows[rule].module, rule)
if function.kind == .machine-handler
    = made-key(7, function.module, 0)
if function.kind != .instance-body && function.kind != .lazy-rule && not-mapped && not-raising
    = 0
.. not-mapped = function.kind != .mapped-rule
.. not-raising = function.kind != .raising-rule
. row = instances.rows[function.instance]
. local = lazy-rule-decl(function)
if local != 0
    . tree = program.modules[row.module].tree
    do match? tree.nodes[local]
        | .node-declare(declaration)
            . name = lazy-rule-name(tree, declaration.left)
            if name
                = made-key(4, row.module, bundle.intern(name.text))
    = 0
if function.kind == .instance-body && is-filler(row.module, row.decl)
    = made-key(6, row.module, 0)
if rule-match(program, row.module, row.decl) == 0
    = 0
do match? program.modules[row.module].decls[row.decl]
    | .decl-function(fn)
        if fn.name
            = made-key(4, row.module, bundle.intern(fn.name.text))
= 0

────────────────────
_ do is-filler Bool
    - module ModuleId
    - decl DeclId

` Whether a declaration is the function that fills an object with the markup of its class.
do match? program.modules[module].decls[decl]
    | .decl-function(fn)
        = fn.is-content
= false

────────────────────
_ made-key Size
    - kind Size
    - module ModuleId
    - name Size

(name /lshift/ 28) /or/ ((module as Size) /lshift/ 4) /or/ kind

────────────────────
_ do made-place U64
    - function EmittedFunction

` Where what a numbered function is made of is written: the module that writes it, and the
` first node of the action, of the pattern, of the local rule, of the rule, or of the class
` whose markup fills an object.
. row = instances.rows[function.instance]
. tree = program.modules[row.module].tree
. node SyntaxId = row.subtree.start
do match? program.modules[row.module].decls[row.decl]
    | .decl-function(fn)
        if fn.is-content
            do match? program.modules[row.module].decls[fn.owner]
                | .decl-class(class)
                    node = tree.subtree-start(class.syntax)
if function.kind == .stream-action
    node = tree.subtree-start(facts.outlined[function.place].arm)
else if function.kind == .machine-handler
    node = tree.subtree-start(facts.machine-groups[function.place].head)
else if function.kind == .pattern-helper || function.kind == .pattern-cast
    node = tree.subtree-start(facts.pattern-arguments[function.place].syntax)
else if lazy-rule-decl(function) != 0
    node = tree.subtree-start(lazy-rule-decl(function))
= ((row.module as U64) /lshift/ 32) /or/ (node as U64)

────────────────────
_ lazy-rule-name Atom?
    - tree AST
    - left SyntaxId

match tree.nodes[left]
    | .node-type-capture(row)
        identifier-name(tree, row.id)
    ??
        identifier-name(tree, left)

────────────────────
_ do closure-property Atom?
    - module ModuleId
    - decl DeclId
    - enclosing InstanceId

` The property the function that gives again an argument of a markup element stores in, as
` the instance that writes the element chose it, or none.
do match? program.modules[module].decls[decl]
    | .decl-function(fn)
        if fn.kind == .live-decl
            . row = live-statement-of(enclosing, fn.syntax)
            if row && row.property != U32.max
                = types.properties[row.property].name
= null

────────────────────
_ do number-closures

` Numbers the closures that share a name in the order they are written: of those of one name
` in a module the first written has the name, and a stack trace prints the second as `name2`.
` One written in a function made more than once is counted for each, by instance. The
` functions generated for comprehensions, lists of bullets and the right sides of pipes are
` closures the type pass typed, and are numbered among them. The body of a spawned task is
` named `Fork`, or `Spin` where it runs in parallel, and that of a `do @no-gc` block
` `GCFreeRegion`, and numbered so among the closures of that name.
. groups [Size]
. places [U64]
. owners [U32]
. keys [Size]
for type in types.ranked
    do match? types.rows[type]
        | .type-closure(row)
            . property = closure-property(row.module, row.decl, row.enclosing)
            groups += made-key
                - 5
                - row.module
                - bundle.intern(closure-name(program, row.module, row.decl, property))
            places += written-place(row.module, row.decl, row.enclosing)
            owners += instances.rank-of(row.enclosing)
            keys += closure-key(row.module, row.decl, row.enclosing)
for instance in ranked-instances(facts.task-bodies)
    . row = instances.rows[instance]
    groups += made-key(5, row.module, bundle.intern(task-name(instance)))
    places += decl-place(row.module, row.decl)
    owners += instances.rank-of(row.enclosing)
    keys += closure-key(row.module, row.decl, row.enclosing)
for instance in ranked-instances(facts.region-bodies)
    . row = instances.rows[instance]
    groups += made-key(5, row.module, bundle.intern("GCFreeRegion"))
    places += decl-place(row.module, row.decl)
    owners += instances.rank-of(row.enclosing)
    keys += closure-key(row.module, row.decl, row.enclosing)
. numbers = written-numbers(groups, places, owners)
for index in 0 .. < keys.length
    closure-ranks[keys[index]] = numbers[index]

────────────────────
_ do decl-place U64
    - module ModuleId
    - decl DeclId

` Where a declaration is written: its module, and the first node of it.
. owner = program.modules[module]
do match? owner.decls[decl]
    | .decl-function(fn)
        = ((module as U64) /lshift/ 32) /or/ (owner.tree.subtree-start(fn.syntax) as U64)
= (module as U64) /lshift/ 32

────────────────────
_ do written-place U64
    - module ModuleId
    - decl DeclId
    - enclosing InstanceId

` Where a closure is written, as `decl-place` says, but for the function that runs a live
` declaration again, which the reference writes where the declaration's value is first read.
do match? program.modules[module].decls[decl]
    | .decl-function(fn)
        if fn.kind == .live-decl
            . row = live-statement-of(enclosing, fn.syntax)
            if row && row.read != 0
                = ((module as U64) /lshift/ 32) /or/ (row.read as U64)
= decl-place(module, decl)

────────────────────
_ do written-numbers [U32]
    - groups [Size]
    - places [U64]
    - owners [U32]

` The number of each function of a list among those that share its name, which `groups`
` gives as a key, none being 0: one more than how many of them are written before it, by
` `places`, then by the ranks of their instances in `owners`, then by their order in the list.
. numbers [U32]
. links [U32]
. heads = Map'Size'U32(arena)
. count = groups.length as U32
for index in 0 .. < count
    numbers += 0
    links += U32.max
    if groups[index] != 0
        links[index] = heads[groups[index]] ?? U32.max
        heads[groups[index]] = index
for index in 0 .. < count
    if groups[index] == 0
        continue
    . number U32 = 1
    . other = heads[groups[index]] ?? U32.max
    while other != U32.max
        . nearer = lower-owner || (owners[other] == owners[index] && other < index)
            .. lower-owner = owners[other] < owners[index]
        if places[other] < places[index] || (places[other] == places[index] && nearer)
            number += 1
        other = links[other]
    numbers[index] = number
= numbers

────────────────────
_ is-task Bool
    - instance InstanceId

` Whether an instance is the body of a spawned task.
instance < task-count && task-bodies[instance] == 1

────────────────────
+ is-region Bool
    - instance InstanceId

` Whether an instance is the body of a `do @no-gc` block.
instance < task-count && task-bodies[instance] == 2

────────────────────
_ copies-in Bool
    - instance InstanceId

` Whether an instance is the body of a spawned task or of a `do @no-gc` block, given a capture
` of what it copies.
instance < task-count && task-bodies[instance] != 0

────────────────────
_ do find-tasks

` Marks the instances that are the bodies of spawned tasks, and those of `do @no-gc` blocks,
` which the type pass lists in the order it met them.
if facts.task-bodies.length == 0 && facts.region-bodies.length == 0
    =
task-count = instances.length as U32
task-bodies = arena.allocate'U8(task-count + 1)
for instance in 0 .. < task-count
    task-bodies[instance] = 0
for body in facts.task-bodies
    task-bodies[body] = 1
for body in facts.region-bodies
    task-bodies[body] = 2

────────────────────
_ do task-name String
    - instance InstanceId

` The name of the function of a spawned task's body: `Spin` where it runs in parallel, and
` `Fork` otherwise.
. row = instances.rows[instance]
. owner-module = program.modules[row.module]
do match? owner-module.decls[row.decl]
    | .decl-function(fn)
        do match? owner-module.tree.nodes[fn.syntax]
            | .node-do-task-block(task)
                if task.is-parallel
                    = "Spin"
= "Fork"

────────────────────
_ closure-key Size
    - module ModuleId
    - decl DeclId
    - enclosing U32

pair-key(decl, enclosing) /xor/ ((module as Size) /lshift/ 56)

────────────────────
_ do declare-stream-actions

` Declares the function the reference runs an action of a stream pattern in, for each such
` action of an emitted instance that may panic, which the function shows. It is named
` `stream-action`, and `number-made` numbers it. One the type pass is not sure the reference
` runs so is refused. They are declared in the order of their instances' ranks.
. keys [U64]
for row in facts.outlined
    keys += rank-key(row.instance, row.arm)
for position in ranked-order(keys)
    . row = facts.outlined[position]
    if functionless || facts.plan-of(row.instance, row.arm) != .plan-outlined-panic
        continue
    .. functionless = instance-functions[row.instance] == no-function
    . id FunctionId = functions.length as FunctionId
    functions.append
        - unnamed-function(.stream-action, row.instance, instances.rows[row.instance].module, 1)
    functions[id].place = position
    functions[id].may-panic = true
    functions[id].unplaced = row.unsure
    stream-action-rows[pair-key(row.instance, row.arm)] = id

────────────────────
_ do declare-machine-handlers

` Declares, for each group of event transitions of an emitted state machine, the functions its
` subscriber runs, as the reference makes them: the handler, `state-transition`, which
` `number-made` numbers; the cast of it to the subscriber, named after it with `Casting`; and
` the function the subscriber's value calls, `StateTransitionActivation`, which runs the cast
` while the activation that subscribed is current. A group on a stream that is no event has the
` function its broadcaster is given instead, `StateTransitionDeferral`, which gives the
` activation to the event runtime's queue. Each is given the machine's environment through the
` record of its activation, laid out once: the environment, whether the activation is current,
` and whether it subscribed. A group on a stream that is only iterable, whose items the handler
` is given directly, has the handler alone. A machine merged with others, one that refines
` another or that another refines, has its part, the function the others call
` (`emit-machine-part`). One a class's property holds has the function that stops it, which
` the object's `close` runs (`stops-at-close`). The machines are taken in the order of their
` instances' ranks.
. keys [U64]
for machine in facts.machines
    keys += rank-key(machine.instance, machine.syntax)
machine-order = ranked-order(keys)
for position in machine-order
    . machine = facts.machines[position]
    if instance-functions[machine.instance] == no-function
        continue
    . module = instances.rows[machine.instance].module
    if machine.outer == 0 && (machine.refined != no-instance || is-refined(machine.instance))
        . part FunctionId = functions.length as FunctionId
        functions.append(unnamed-function(.machine-part, machine.instance, module, 1))
        functions[part].place = position as U32
        functions[part].may-panic = true
        machine-part-rows[machine.instance] = part
    if stops-at-close(machine)
        . stop FunctionId = functions.length as FunctionId
        functions.append(unnamed-function(.machine-stop, machine.instance, module, 1))
        functions[stop].place = position as U32
        functions[stop].may-panic = true
        machine-stop-rows[machine.instance] = stop
    for group in machine.groups.start .. < machine.groups.start + machine.groups.count
        . id FunctionId = functions.length as FunctionId
        . row = facts.machine-groups[group]
        functions.append(unnamed-function(.machine-handler, machine.instance, module, 1))
        if !row.iterated
            functions.append(unnamed-function(.machine-cast, machine.instance, module, 1))
            functions.append(unnamed-function(.machine-activation, machine.instance, module, 1))
        if !row.iterated && row.event == U32.max
            functions.append(unnamed-function(.machine-deferral, machine.instance, module, 1))
        for offset in id .. < (functions.length as FunctionId)
            functions[offset].place = group
            functions[offset].may-panic = true
        machine-handler-rows[group] = id
    if machine-record == no-layout && machine.groups.count != 0
        . children [LayoutId]
        . held [TypeId]
        children += managed-layout
        children += u8-layout
        children += u8-layout
        held += no-type
        held += no-type
        held += no-type
        machine-record = layouts.environment(children, held, "machine.activation")

────────────────────
_ do declare-pattern-arguments

` Declares the function a pattern given to a rule is passed as, for each such pattern an
` emitted instance writes: one made of the pattern where it is written, which the reference
` names `static-inline-match-direct`; and, for a call of a rule written alone, one that runs
` the rule's function, which the reference names after it with `Casting`. `number-made`
` numbers both. Each writes the panic signal, as the rule it is passed to calls it through the value
` it holds and checks every such call. One made of a pattern that is given what names hold
` reads them from memory laid out here, which the function it is written in fills where it
` passes the pattern; one that runs a local rule of a rule may panic where the rule may. They
` are declared in the order of their instances' ranks, then of where the patterns are written.
. keys [U64]
for row in facts.pattern-arguments
    keys += rank-key(row.instance, row.syntax)
for position in ranked-order(keys)
    . row = facts.pattern-arguments[position]
    if instance-functions[row.instance] == no-function
        continue
    . helper = row.rule == no-instance
    if !helper && instance-functions[row.rule] == no-function
        continue
    . kind = if helper then FunctionKind.pattern-helper else FunctionKind.pattern-cast
    . id FunctionId = functions.length as FunctionId
    functions.append(unnamed-function(kind, row.instance, instances.rows[row.instance].module, 1))
    functions[id].place = position
    functions[id].may-panic = if helper then helper-may-panic(row) else rule-panics
    .. rule-panics = instances.rows[row.rule].may-panic
    functions[id].carries = true
    pattern-argument-rows[pair-key(row.instance, row.syntax)] = id
    if helper && row.params.count != 0
        lay-pattern-environment(position, row)

────────────────────
_ do declare-growths

` Declares the functions that grow the storage of a table in its arena, as the reference
` keeps growth out of the functions that append, in `cold-storage-rows` and
` `cold-storage-spill`: for each type of row a table holds, one that grows its rows, and for
` a union that keeps bytes outside its rows, one that grows those. Neither panics: each
` answers the message of what failed, or nothing.
for id in types.ranked
    . row = table-row(types, id)
    if row == no-type || growth-rows[(row as Size) * 2] != null || layouts.values[row] == no-layout
        continue
    . kind = types.completions[row].intrinsic
    . place = if kind == .union then unions.of(row) else U32.max
    if kind != .struct && place == U32.max
        continue
    declare-growth(row, 0)
    if place != U32.max && unions.layouts[place].handle-column != U32.max
        declare-growth(row, 1)

────────────────────
_ do declare-growth
    - row TypeId
    - part U32

. id FunctionId = functions.length as FunctionId
functions.append(unnamed-function(.storage-growth, no-instance, class-ref(types, row).module, 8))
functions[id].type = row
functions[id].place = part
growth-rows[(row as Size) * 2 + (part as Size)] = id

────────────────────
_ do declare-source-attacher

` Declares the function that gives a panic with no source of its own the place it is raised at,
` which each place that raises one calls, where the program can raise any.
. source = instances.report.source
if source == no-instance || instance-functions[source] == no-function
    =
source-attacher = functions.length as FunctionId
functions.append(unnamed-function(.source-attach, no-instance, instances.rows[source].module, 1))

────────────────────
+ growth-of FunctionId
    - row TypeId
    - part U32

` The function that grows the storage of tables of a type of row: their rows where `part` is
` 0, and the outside bytes of a union's where it is 1. None where the tables declared none.
growth-rows[(row as Size) * 2 + (part as Size)] ?? no-function

────────────────────
_ do declare-lazy-rules

` Declares the function a local rule of a rule a module declares runs in: one for each local
` rule that calls itself, and, where the rule raises errors, one for each local rule it calls.
` Any other runs where it is called, as one does where the rule may panic, whose stack trace
` then shows the rule. A local rule beside a match that calls itself
` runs where a pattern calls it too, as the reference's does, and has two functions for the
` calls its own arms make: one given the stream, which a call from its arms calls, and the
` one its arms run in, which that one calls on the stream's view. It has them only where it
` reads nothing they could not hold, as `reads-own` says, and is refused where it is called
` otherwise. Those beside a match are declared in the order of their instances' ranks.
for owner in instances.ordered
    if instance-functions[owner] == no-function
        continue
    . row = instances.rows[owner]
    if rule-match(program, row.module, row.decl) == 0
        continue
    . tree = program.modules[row.module].tree
    for statement in lazy-rules-of(owner)
        do match? tree.nodes[statement]
            | .node-declare(declaration)
                . raising = instances.signatures[owner].errors.count != 0
                if typed && (raising || facts.is-recursive-rule(owner, statement))
                    . id FunctionId = functions.length as FunctionId
                    functions.append(unnamed-function(.lazy-rule, owner, row.module, 1))
                    functions[id].place = statement
                    functions[id].may-panic = row.may-panic
                    lazy-rule-rows[pair-key(owner, statement)] = id
                .. typed = facts.node-type(owner, declaration.right) != no-type
. keys [U64]
for local in facts.local-rules
    keys += rank-key(local.instance, local.syntax)
for position in ranked-order(keys)
    . local = facts.local-rules[position]
    if !local.recursive || no-stream || instance-functions[local.instance] == no-function
        continue
    .. no-stream = local.stream == no-type
    . row = instances.rows[local.instance]
    . seen [SyntaxId]
    if has-helper || ruled || !reads-own(local.instance, local.syntax, local.syntax, seen)
        continue
    .. has-helper = row.helper != no-type
    .. ruled = rule-match(program, row.module, row.decl) != 0
    . pair = pair-key(local.instance, local.syntax)
    . direct FunctionId = functions.length as FunctionId
    functions.append(unnamed-function(.lazy-rule, local.instance, row.module, 1))
    functions[direct].place = local.syntax
    functions[direct].may-panic = row.may-panic
    lazy-rule-rows[pair] = direct
    . adapter FunctionId = functions.length as FunctionId
    functions.append(unnamed-function(.rule-adapter, local.instance, row.module, 1))
    functions[adapter].place = local.syntax
    functions[adapter].may-panic = row.may-panic
    rule-adapter-rows[pair] = adapter

────────────────────
_ do reads-own Bool
    - instance InstanceId
    - rule SyntaxId
    - home SyntaxId
    - seen [SyntaxId]

` Whether a local rule beside a match reads nothing its function could not hold: every name
` it reads is one its own arms declare, a local rule that reads so too, which runs where it
` is called, or the rule the function is made of, which it calls. A rule that reads a local,
` an argument or a name the match captures, the receiver or a member of it, or that writes a
` nested function, would need what the function it is written in holds.
if seen.find(rule) != null
    = true
seen += rule
. row = instances.rows[instance]
. tree = program.modules[row.module].tree
. first = tree.subtree-start(rule)
for node in first .. < rule + 1
    if tree.nodes[node] is .node-function-syntax
        = false
    . resolution = bindings.resolution-of(row.binding, node)
    if resolution.kind == .resolve-member
        = false
    if resolution.kind != .resolve-slot
        continue
    . slot = bindings.slots[resolution.slot]
    if slot.kind == .slot-this
        = false
    if slot.syntax >= first && slot.syntax <= rule
        continue
    if slot.kind != .slot-lazy || slot.group == 0
        = false
    if slot.group == home
        continue
    do match? tree.nodes[slot.group]
        | .node-declare(declaration)
            if !stream-match || calls-itself || !reads-own(instance, slot.group, home, seen)
                = false
            .. stream-match = tree.nodes[declaration.right] is .node-stream-match
            .. calls-itself = facts.is-recursive-rule(instance, slot.group)
        ??
            = false
= true

────────────────────
_ do lazy-rules-of [SyntaxId]
    - instance InstanceId

` The local rules declared beside the pattern of a rule a module declares.
. rules [SyntaxId]
. row = instances.rows[instance]
. tree = program.modules[row.module].tree
do match? program.modules[row.module].decls[row.decl]
    | .decl-function(fn)
        do match? tree.nodes[fn.body]
            | .node-block(block)
                for statement in tree.children[block.body]
                    do match? tree.nodes[statement]
                        | .node-declare(declaration)
                            if declaration.is-lazy && stream-match
                                rules += statement
                            .. stream-match = tree.nodes[declaration.right] is .node-stream-match
= rules

────────────────────
_ do declare-mapped-rules

` Declares a function of a rule for each set of collectors calls of it give it, as the
` reference compiles one for each: of a rule a module declares, and of a local rule of one
` that runs as a function of its own. Notes each such local rule a call given no collectors
` reads the value of: any but one the type pass planned to give the text it matched. A rule a
` module declares that a call the type pass planned so runs has a function with no collectors,
` which makes no text of what its arms matched.
for caller in instances.ordered
    if instance-functions[caller] == no-function
        continue
    . row = instances.rows[caller]
    . tree = program.modules[row.module].tree
    for node in row.subtree.start .. < row.subtree.start + row.subtree.count
        do match? tree.nodes[node]
            | .node-stream-call(call)
                . names = mapping-names(tree, call.collector-mappings)
                . rule = local-rule-called(caller, node)
                if rule != 0
                    . pair = pair-key(caller, rule)
                    if lazy-rule-rows[pair] == null
                        continue
                    if names != no-string
                        map-rule(caller, rule, names, functions[lazy-rule-rows[pair]!].may-panic)
                    else if facts.plan-of(caller, node) != .plan-span-call
                        read-rule-rows[pair] = 1
                else if names != no-string || facts.plan-of(caller, node) == .plan-span-call
                    . fact = facts.first-call(caller, node)
                    . callee = if fact != no-fact then facts.calls[fact].callee else no-instance
                    . ruled = callee != no-instance && (names != no-string || rule-match(program, instances.rows[callee].module, instances.rows[callee].decl) != 0)
                    if ruled && instance-functions[callee] != no-function
                        map-rule(callee, 0, names, instances.rows[callee].may-panic)

────────────────────
_ do declare-raising-rules

` Declares the function of a rule that calls of it which give it a pattern whose function
` may raise errors run, for each such rule emitted. Each local rule of the rule that runs as a
` function has one too. They are declared in the order of their instances' ranks, then of the
` local rules they are of.
. keys [U64]
for row in facts.raising-rules
    raising-functions += no-function
    keys += rank-key(row.instance, row.rule)
for position in ranked-order(keys)
    . row = facts.raising-rules[position]
    if instance-functions[row.instance] == no-function
        continue
    if row.rule != 0 && lazy-rule-rows[pair-key(row.instance, row.rule)] == null
        continue
    . id FunctionId = functions.length as FunctionId
    functions.append
        - unnamed-function(.raising-rule, row.instance, instances.rows[row.instance].module, 1)
    functions[id].place = position
    functions[id].may-panic = instances.rows[row.instance].may-panic
    raising-functions[position] = id

────────────────────
+ do raising-rule-of FunctionId
    - instance InstanceId
    - rule SyntaxId
    - given TypeId

` The function of a rule, or of a local rule of one, for calls that give the rule a pattern
` whose function returns `given`, its answer or one of several errors, or none.
for position in 0 .. < facts.raising-rules.length
    . row = facts.raising-rules[position]
    if row.instance == instance && row.rule == rule && row.given == given
        = raising-functions[position]
= no-function

────────────────────
+ pattern-raises TypeId
    - instance InstanceId
    - syntax SyntaxId

` What the function made of a pattern an instance gives a rule returns where it may raise
` errors, its answer or one of them: one that runs a local rule of a rule that raises errors
` as a function of its own. None for any other pattern.
|? id == no-function || functions[id].kind != .pattern-helper
    no-type
|? raises-nothing || row.local == 0 || lazy-rule-rows[pair-key(row.instance, row.local)] == null
    no-type
??
    row.raised

.. id = pattern-argument-rows[pair-key(instance, syntax)] ?? no-function
.. row = facts.pattern-arguments[functions[id].place]
.. raises-nothing = row.raised == no-type

────────────────────
_ do map-rule
    - instance InstanceId
    - rule SyntaxId
    - names StringId
    - may-panic Bool

` The function of a rule for a set of collectors, declared where none was.
for mapping in rule-mappings
    if mapping.instance == instance && mapping.rule == rule && mapping.names == names
        =
. id FunctionId = functions.length as FunctionId
functions.append(unnamed-function(.mapped-rule, instance, instances.rows[instance].module, 1))
functions[id].place = rule-mappings.length as U32
functions[id].may-panic = may-panic
rule-mappings.append(RuleMapping(instance, rule, names, id))

────────────────────
+ do mapping-names StringId
    - tree AST
    - mappings RowRange'SyntaxId

` The names of a rule's that a call gives collectors for, in the order written, joined by
` commas, or none where it gives none.
if mappings.count == 0
    = no-string
. joined = ""
for mapping in tree.children[mappings]
    do match? tree.nodes[mapping]
        | .node-stream-collector-mapping(row)
            . name = if row.callee then row.callee.text else row.caller.text
            joined = if joined.length == 0 then name else "$joined,$name"
= bundle.intern(joined)

────────────────────
_ local-rule-called SyntaxId
    - caller InstanceId
    - call SyntaxId

` The declaration of the local rule a call in an instance names, as the binder resolved it,
` or none.
|? binding == no-binding
    0
|? resolution.kind != .resolve-slot
    0
|? slot.kind != .slot-lazy
    0
??
    slot.group

.. binding = instances.rows[caller].binding
.. resolution = bindings.resolution-of(binding, call)
.. slot = bindings.slots[resolution.slot]

────────────────────
_ mapping-key String
    - names StringId

` What tells the key of a function of a rule for a set of collectors from the rule's own.
if names == no-string then ".unread" else ".into.${bundle.text(names)}"

────────────────────
+ do mapped-rule-of FunctionId
    - instance InstanceId
    - rule SyntaxId
    - names StringId

` The function of a rule, or of a local rule of one, for a set of collectors calls give it.
for mapping in rule-mappings
    if mapping.instance == instance && mapping.rule == rule && mapping.names == names
        = mapping.function
= no-function

────────────────────
+ lazy-rule-of FunctionId
    - instance InstanceId
    - rule SyntaxId

` The function a local rule of a rule runs in, or none where it runs where it is called.
lazy-rule-rows[pair-key(instance, rule)] ?? no-function

────────────────────
+ rule-adapter-of FunctionId
    - instance InstanceId
    - rule SyntaxId

` The function a call of a local rule beside a match from the rule's own arms calls, given
` the stream, which runs the rule's own function on the stream's view; or none.
rule-adapter-rows[pair-key(instance, rule)] ?? no-function

────────────────────
+ reads-rule Bool
    - instance InstanceId
    - rule SyntaxId

` Whether a call of a local rule that runs as a function of its own reads what the function
` gives. Where none does, each call takes only whether it passed and where it ended.
read-rule-rows[pair-key(instance, rule)] != null

────────────────────
_ do lazy-rule-text String
    - function EmittedFunction

` The name of the local rule a function runs.
. tree = program.modules[instances.rows[function.instance].module].tree
do match? tree.nodes[lazy-rule-decl(function)]
    | .node-declare(declaration)
        . name = lazy-rule-name(tree, declaration.left)
        if name
            = name.text
= ""

────────────────────
+ lazy-rule-decl SyntaxId
    - function EmittedFunction

` The declaration of the local rule a function runs, or none where it runs none.
|? function.kind == .lazy-rule || function.kind == .rule-adapter
    function.place
|? function.kind == .mapped-rule
    rule-mappings[function.place].rule
|? function.kind == .raising-rule
    facts.raising-rules[function.place].rule
??
    0

────────────────────
_ do lay-pattern-environment
    - place U32
    - row PatternArgument

` Lays out the memory the function made of a pattern reads what it is given from: what each
` name holds, in order. One that holds a value with no layout has none.
. children [LayoutId]
. held [TypeId]
for offset in 0 .. < row.params.count
    . type = facts.action-types[row.params.start + offset]
    . layout = if type == no-type || type == invalid-type then no-layout else layouts.values[type]
    if layout == no-layout
        =
    children += layout
    held += type
pattern-environments[place] = layouts.environment
    - children
    - held
    - "pattern.${hex-text(instances.stable-keys[row.instance])}.${row.syntax}"

────────────────────
+ pattern-environment LayoutId
    - place U32

` The layout of the memory the function made of a pattern reads what it is given from, or
` none.
pattern-environments[place] ?? no-layout

────────────────────
_ do helper-may-panic Bool
    - row PatternArgument

` Whether a pattern given to a rule calls what may panic: a rule a module declares that may, a
` local rule of a rule that may, or a function of the stream's interface, as it does to ask the
` stream for more input.
. tree = program.modules[instances.rows[row.instance].module].tree
for node in tree.subtree-start(row.syntax) .. < row.syntax + 1
    . fact = facts.first-call(row.instance, node)
    while fact != no-fact
        . callee = facts.calls[fact].callee
        if callee != no-instance && (instances.rows[callee].may-panic || is-prototype(callee))
            = true
        fact = facts.calls[fact].next
    if tree.nodes[node] is .node-stream-call && called && instances.rows[row.instance].may-panic
        = true
    .. called = local-rule-called(row.instance, node) != 0
= false

────────────────────
+ pattern-argument-of FunctionId
    - instance InstanceId
    - syntax SyntaxId

` The function a pattern given to a rule is passed as, or none.
pattern-argument-rows[pair-key(instance, syntax)] ?? no-function

────────────────────
+ machine-handler-of FunctionId
    - group U32

` The handler a state machine's subscriber runs for a group of its event transitions, which the
` cast of it and the activation that runs the cast follow, or none.
machine-handler-rows[group] ?? no-function

────────────────────
_ is-machine-group-kind Bool
    - kind FunctionKind

` Whether a function is one of those a group of a machine's event transitions has.
handled || kind == .machine-activation || kind == .machine-deferral
    .. handled = kind == .machine-handler || kind == .machine-cast

────────────────────
+ machine-part-of FunctionId
    - instance InstanceId

` The part of a machine merged with others, the function they call (`emit-machine-part`), by the
` instance of its own function, or none.
machine-part-rows[instance] ?? no-function

────────────────────
+ machine-stop-of FunctionId
    - instance InstanceId

` The function that stops a machine a class's property holds (`stops-at-close`), by the
` instance of its own function, or none.
machine-stop-rows[instance] ?? no-function

────────────────────
+ stops-at-close Bool
    - machine MachineFact

` Whether a machine is one a class's property holds, and none it refines, which gives the event
` runtime what stops it as it starts, for the object's `close` to run (`event-stop-machines`).
has-stop && machine.store == .store-member && machine.outer == 0 && machine.refined == no-instance

.. has-stop = facts.machine-stop != no-instance

────────────────────
_ do is-refined Bool
    - instance InstanceId

` Whether a machine of a property of a class is refined by another typed for a class.
for machine in facts.machines
    if machine.refined == instance && machine.outer == 0
        = true
= false


────────────────────
+ stream-action-of FunctionId
    - instance InstanceId
    - arm SyntaxId

` The function an action of a stream pattern runs in, or none.
stream-action-rows[pair-key(instance, arm)] ?? no-function

────────────────────
+ adapter-of FunctionId
    - from TypeId
    - to TypeId

` The function a binding of a type runs as a value of a function type, or none.
if found then adapters[found].function else no-function

.. found = adapter-rows[pair-key(from, to)]

────────────────────
_ do name-function
    - id FunctionId

` Names a function: its symbol, made from a key no other function has, which names the instance
` it runs by its stable key, and the name a stack trace shows, as the reference names it.
. function = functions[id]
. module-name = program.modules[function.module].name
. key = "main"
. display = "main"
if function.kind == .module-main
    key = "$module-name:main"
    display = key
else if function.kind == .module-init
    key = "init.$module-name"
    display = "$module-name:init.$module-name"
else if function.kind == .task-main && program.is-batch
    key = "yumi.batch.${function.place}.start"
    display = "$module-name:yumi.main"
else if function.kind == .task-main
    key = "yumi.main"
    display = "$module-name:yumi.main"
else if function.kind == .batch-main
    key = "yumi.batch.main"
    display = "$module-name:yumi.batch.main"
else if function.kind == .batch-finish
    key = "yumi.batch.${function.place}.finish"
    display = "$module-name:yumi.batch.finish"
else if function.kind == .task-init
    key = "taskinit"
    display = "$module-name:taskinit"
else if function.kind == .thread-init
    key = "threadinit"
    display = "$module-name:threadinit"
else if function.kind == .probe-setup
    key = "probesetup"
    display = "$module-name:probesetup"
else if function.kind == .probe-teardown
    key = "probeteardown"
    display = "$module-name:probeteardown"
else if function.kind == .probe-closer
    key = "probetaskteardown"
    display = "$module-name:probetaskteardown"
else if function.kind == .probe-flush
    key = "probeTaskFlushThunk"
    display = "$module-name:probeTaskFlushThunk"
else if function.kind == .probe-safepoint
    key = "probeSafepoint"
    display = "$module-name:probeSafepoint"
else if function.kind == .instance-body
    display = instance-display(function.instance)
    key = "${display}.${hex-text(instances.stable-keys[function.instance])}"
    if body-functions[function.instance] != no-function && viewed
        display = "$module-name:${callee-name(function.instance)}"
        key = "${key}.view"
    .. viewed = functions[body-functions[function.instance]].kind == .viewed-body
else if function.kind == .viewed-body || function.kind == .task-body
    display = instance-display(function.instance)
    key = "${display}.${hex-text(instances.stable-keys[function.instance])}"
else if function.kind == .constructor-body
    display = instance-display(function.instance)
    key = "${display}.body.${hex-text(instances.stable-keys[function.instance])}"
else if function.kind == .generator-body
    display = instance-display(function.instance)
    key = "${display}.step.${hex-text(instances.stable-keys[function.instance])}"
else if function.kind == .instance-initializer
    display = instance-display(function.instance)
    key = "${display}.init.${hex-text(instances.stable-keys[function.instance])}"
else if function.kind == .lazy-property
    . written = types.properties[function.place].name.text
    display = "$module-name:${type-short-name(types, function.type)}:$written"
    key = "${display}.lazy.${hex-text(types.stable-keys[function.type])}"
else if function.kind == .property-updater
    . written = types.properties[function.place].name.text
    display = "$module-name:prop-$written"
    key = "${module-name}:${type-short-name(types, function.type)}:${written}.updater.${holder}"
    .. holder = hex-text(types.stable-keys[function.type])
else if function.kind == .class-rule-updater
    . rule = class-rules[function.place]
    . written = if program.modules[rule.module].tree.nodes[rule.syntax] is .node-whenever-rule-syntax then "whenever" else "when"
    . shown = if facts.markup-trigger-of(rule.unit) then "${written}-markup" else written
    display = "$module-name:$shown"
    key = "${module-name}:${type-short-name(types, function.type)}:${shown}.${rule.syntax}.${hex-text(instances.stable-keys[rule.unit])}"
else if function.kind == .markup-trigger-add || trigger-remove || trigger-ancestor
    . rule = class-rules[function.place]
    . ending = if adds then "add" else if removes then "remove" else "ancestor"
        .. adds = function.kind == .markup-trigger-add
        .. removes = function.kind == .markup-trigger-remove
    display = "$module-name:markup-trigger-$ending"
    key = "${module-name}:${type-short-name(types, function.type)}:markup-trigger-${ending}.${rule.syntax}.${hex-text(instances.stable-keys[rule.unit])}"
else if function.kind == .idle-action
    display = "$module-name:subscription"
    key = "live.subscription"
else if function.kind == .event-handler
    . handler = event-handlers[function.place]
    . shown = if handler.number < 2 then "" else "${handler.number}"
    display = "$module-name:event descriptor ${level-name}.${handler.name.text}$shown"
    .. level-name = type-short-name(types, handler.level)
    key = "${module-name}:event.handler.${type-key(types, handler.level)}.${handler.syntax}"
else if function.kind == .event-matcher
    display = "$module-name:event descriptor matcher ${type-short-name(types, function.type)}"
    key = "${module-name}:event.matcher.${type-key(types, function.type)}"
else if function.kind == .machine-descriptor
    . head = facts.machine-groups[function.place].head
    key = "${instance-display(function.instance)}.${hex-text(instances.stable-keys[function.instance])}.event.machine.${type-key(types, function.type)}.$head"
    display = "$module-name:event machine descriptor ${type-short-name(types, function.type)}"
else if function.kind == .event-registrations
    key = "init.${module-name}.events"
    display = "$module-name:$key"
else if function.kind == .style-registration
    . shown = if function.place == 0 then "" else "${function.place + 1}"
    key = "${module-name}:style-register-impl$shown"
    display = key
else if function.kind == .style-gate
    display = if gate-content then "$module-name:style-content" else "$module-name:style-gate"
    .. gate-content = facts.style-gates[function.place].content
    key = "${module-name}:style-gate.${function.number}"
else if function.kind == .style-scope-state
    display = "$module-name:style-scope-state"
    key = "${module-name}:style-scope-state.${function.number}"
else if function.kind == .slot-forward
    display = "$module-name:markup-slot-forward"
    key = "${module-name}:slot-forward.${function.number}"
else if function.kind == .style-sheet-registration
    . shown = if function.place == 0 then "" else "${function.place + 1}"
    key = "${module-name}:style-sheet-register-impl$shown"
    display = key
else if function.kind == .style-static-value
    . shown = if function.number == 0 then "" else "${function.number + 1}"
    key = "${module-name}:style-static-value$shown"
    display = key
else if function.kind == .style-themed-value
    . shown = if function.number == 0 then "" else "${function.number + 1}"
    key = "${module-name}:style-themed-value$shown"
    display = key
else if function.kind == .style-rule
    display = "$module-name:style-rule"
    key = "${module-name}:style-rule.${function.number}"
else if function.kind == .style-author
    . author = facts.style-authors[function.place]
    . row = facts.style-declaration-of(author.instance, author.site)
    . written = if row then facts.style-properties[row.property].name.text else ""
    display = "$module-name:style-$written"
    key = "${module-name}:style-author.${function.number}"
else if function.kind == .style-given-author
    . unit = facts.style-applications[given-applications[function.place]].unit
    . row = facts.style-declaration-of(unit, given-sites[function.place])
    . update = facts.rule-update-of(unit, given-sites[function.place])
    . written = if row then facts.style-properties[row.property].name.text else if update then types.properties[update.property].name.text else ""
    display = "$module-name:style-$written"
    key = "${module-name}:style-given.${function.number}"
else if function.kind == .markup-query || function.kind == .markup-query-add || query-remove
    . query = facts.markup-queries[function.place]
    . written = types.properties[query.place].name.text
    . ending = if function.kind == .markup-query then "" else if adding then "-add" else "-remove"
        .. adding = function.kind == .markup-query-add
    display = "$module-name:markup-query-$written$ending"
    key = "${module-name}:${type-short-name(types, function.type)}:markup-query-$written$ending.${hex-text(types.stable-keys[function.type])}"
else if function.kind == .live-adapter
    display = "${bundle.text(functions[function.place].display)}Casting"
    key = "${bundle.text(functions[function.place].name)}.adapter"
else if function.kind == .module-constants
    key = "init.${module-name}.constants"
    display = "$module-name:$key"
else if function.kind == .module-globals
    key = "init.${module-name}.globals"
    display = "$module-name:$key"
else if function.kind == .lazy-global
    key = "init.${module-name}.global.${global-name(storage[function.place])}"
    display = "$module-name:$key"
else if function.kind == .task-local-init
    key = "init.${module-name}.task-local.${global-name(storage[function.place])}"
    display = "$module-name:$key"
else if function.kind == .thread-local-init
    key = "init.${module-name}.thread-local.${global-name(storage[function.place])}"
    display = "$module-name:$key"
else if function.kind == .stack-local-init
    key = "init.${module-name}.stack-local.${global-name(storage[function.place])}"
    display = "$module-name:$key"
else if function.kind == .module-statics
    key = "init.${module-name}.statics"
    display = "$module-name:$key"
else if is-machine-group-kind(function.kind)
    . handler = machine-handler-of(function.place)
    . number = made-numbers[handler] ?? 1
    . shown = if number < 2 then "" else "$number"
    . head = facts.machine-groups[function.place].head
    key = "${instance-display(function.instance)}.${hex-text(instances.stable-keys[function.instance])}.state-transition.$head"
    display = "$module-name:state-transition$shown"
    if function.kind == .machine-cast
        key = "${key}.cast"
        display = "${display}Casting"
    if function.kind == .machine-activation
        key = "${key}.activation"
        display = "$module-name:StateTransitionActivation"
    if function.kind == .machine-deferral
        key = "${key}.deferral"
        display = "$module-name:StateTransitionDeferral"
else if function.kind == .machine-part
    . stable = hex-text(instances.stable-keys[function.instance])
    key = "${instance-display(function.instance)}.${stable}.state-part"
    display = "$module-name:state-part"
else if function.kind == .machine-stop
    . stable = hex-text(instances.stable-keys[function.instance])
    key = "${instance-display(function.instance)}.${stable}.state-stop"
    display = "$module-name:state-stop"
else if function.kind == .stream-action
    . arm = facts.outlined[function.place].arm
    . number = made-numbers[id] ?? 1
    . shown = if number < 2 then "" else "$number"
    display = "$module-name:stream-action$shown"
    key = "${instance-display(function.instance)}.${hex-text(instances.stable-keys[function.instance])}.stream-action.$arm"
else if function.kind == .pattern-helper
    . row = facts.pattern-arguments[function.place]
    . number = made-numbers[id] ?? 1
    . shown = if number < 2 then "" else "$number"
    display = "$module-name:static-inline-match${shown}-direct"
    key = "${instance-display(function.instance)}.${hex-text(instances.stable-keys[function.instance])}.pattern.${row.syntax}"
else if function.kind == .pattern-cast
    . row = facts.pattern-arguments[function.place]
    . number = made-numbers[id] ?? 1
    . shown = if number < 2 then "" else "$number"
    display = "${instance-display(row.rule)}Casting$shown"
    key = "${display}.${hex-text(instances.stable-keys[function.instance])}.pattern.${row.syntax}"
else if lazy-rule-decl(function) != 0
    . number = made-numbers[id] ?? 1
    . shown = if number < 2 then "" else "$number"
    display = "$module-name:${lazy-rule-text(function)}-direct${shown}-direct"
    key = "${instance-display(function.instance)}.${hex-text(instances.stable-keys[function.instance])}.lazy.${lazy-rule-decl(function)}"
    if function.kind == .rule-adapter
        display = "$module-name:${lazy-rule-text(function)}"
        key = "${key}.adapter"
    else if rule-adapter-of(function.instance, lazy-rule-decl(function)) != no-function
        display = "$module-name:${lazy-rule-text(function)}${shown}-direct"
    if function.kind == .mapped-rule
        key = "${key}${mapping-key(rule-mappings[function.place].names)}"
    if function.kind == .raising-rule
        key = "${key}.raising.${function.place}"
else if function.kind == .mapped-rule
    . number = made-numbers[id] ?? 1
    . shown = if number < 2 then "" else "$number"
    display = "$module-name:${callee-name(function.instance)}-direct${shown}-direct"
    key = "${instance-display(function.instance)}.${hex-text(instances.stable-keys[function.instance])}${mapping-key(rule-mappings[function.place].names)}"
else if function.kind == .raising-rule
    . number = made-numbers[id] ?? 1
    . shown = if number < 2 then "" else "$number"
    display = "$module-name:${callee-name(function.instance)}-direct${shown}-direct"
    key = "${instance-display(function.instance)}.${hex-text(instances.stable-keys[function.instance])}.raising.${function.place}"
else if function.kind == .argument-default
    . kept = storage[function.place]
    display = "$module-name:${default-name(kept)}-default"
    key = "${instance-display(kept.owner)}.${owner-key}.default.${kept.syntax}"
    .. owner-key = hex-text(instances.stable-keys[kept.owner])
else if function.kind == .adapter && adapters[function.place].runs == no-instance
    . row = adapters[function.place]
    display = "$module-name:Casting"
    functions[id].placeless = row.shared
    . source = hex-text(types.stable-keys[row.from])
    key = "${module-name}.cast.adapter.${source}.${hex-text(types.stable-keys[row.to])}"
else if function.kind == .adapter
    . row = adapters[function.place]
    display = "$module-name:${callee-name(row.runs)}Casting"
    . declared = types.c-function-decl(row.to) if is-c-function(types, row.to)
    functions[id].unplaced = is-c-function(types, row.to) && !declared
    functions[id].placeless = row.shared
    if declared
        functions[id].site-module = declared.module
        if module-paths.data[declared.module] == no-string
            module-paths.data[declared.module] = bundle.intern
                - program.modules[declared.module].relative-path
    . source = hex-text(types.stable-keys[row.from])
    key = "${instance-display(row.runs)}.adapter.${source}.${hex-text(types.stable-keys[row.to])}"
else if function.kind == .union-dispatch
    . forward = facts.forwards[function.place]
    . union = class-ref(types, cases-union(forward))
    display = "${program.modules[union.module].name}:union-dispatch-${forward-number}"
    .. forward-number = forward-numbers[function.place]
    key = "${instance-display(forward.instance)}.union-dispatch.${forward.syntax}"
else if function.kind == .class-adapter
    . row = class-adapters[function.place]
    display = "$module-name:${callee-name(row.override)}(class-adapter)"
    . written = hex-text(instances.stable-keys[row.override])
    key = "${instance-display(row.override)}.${written}.class-adapter.${proto-key}"
    .. proto-key = hex-text(instances.stable-keys[row.proto])
else if function.kind == .interface-equality
    . row = witnesses[function.place]
    key = "InterfaceEquality:${type-key(types, row.value)}:${type-key(types, row.interface)}"
    display = "$module-name:$key"
else if function.kind == .source-attach
    key = "SourceAttach"
    display = "$module-name:attach-source"
else if function.kind == .storage-growth
    . grown = if function.place == 0 then "rows" else "spill"
    key = "ColdStorageGrowth:$grown:${type-key(types, function.type)}"
    display = "$module-name:cold-storage-$grown"
else if function.kind == .witness
    . row = witness-functions[function.place]
    . answers = if row.callee == no-instance then property-text else instance-display(row.callee)
        .. property-text = "$module-name:${types.properties[row.property].name.text}"
    display = "$module-name:${callee-name(row.callee)}(wrapped)"
    . answered = hex-text(instances.stable-keys[row.proto])
    if row.shared
        key = "${answers}.${hex-text(instances.stable-keys[row.callee])}.witness.$answered"
    else
        key = "${answers}.witness.${hex-text(types.stable-keys[row.value])}.$answered"
.. trigger-remove = function.kind == .markup-trigger-remove
.. trigger-ancestor = function.kind == .markup-trigger-ancestor
.. query-remove = function.kind == .markup-query-remove
functions[id].name = bundle.intern(key)
functions[id].symbol = bundle.intern(symbol-name(program.target, key))
functions[id].display = bundle.intern(display)
if function.kind == .instance-body && instances.rows[function.instance].materialized != no-instance
    . owner = program.modules[instances.rows[function.instance].module].name
    functions[id].bridge-display = bundle.intern
        - "$owner:${callee-name(function.instance)}-table-row-receiver-bridge"

────────────────────
_ do declare-lazies

` A function for each lazy property of each class the program constructs: that of the
` nearest class, from the constructed one up, that writes the property's value. Classes that
` take the value from one class share its function, and the type pass typed the value once
` for that class. It may panic when the value may, and it always writes the panic signal,
` because class tables hold it.
for type in types.ranked
    if constructed[type] == 0 || !is-class(type)
        continue
    . range = types.completions[type].properties
    for offset in 0 .. < range.count
        . place = range.start + offset
        . property = types.properties[place]
        if property.storage-kind != .storage-lazy
            continue
        . owner = declaring
            - if property.owner != no-type then property.owner else type
            - property.name
        . declared = if owner != no-type then place-of(owner, property.name) else U32.max
        if declared == U32.max
            continue
        if lazy-functions[declared] == no-function
            . id FunctionId = functions.length as FunctionId
            functions.append(unnamed-function(.lazy-property, no-instance, class-module(owner), 8))
            functions[id].type = owner
            functions[id].place = declared
            functions[id].carries = true
            lazy-functions[declared] = id
        lazy-functions[place] = lazy-functions[declared]
        . unit = find-unit(type, place, default-of(type, place))
        value-units[declared] = unit
        if unit != no-instance && instances.rows[unit].may-panic
            functions[lazy-functions[declared]].may-panic = true

────────────────────
_ do declare-updaters

` A function for each stored property of each class the program constructs whose value reads
` something tracked: it evaluates the value again in the live action it runs in and stores it
` in the object, which is its data as a callback. It may panic, as what it calls may.
if instances.live.track == no-instance
    =
for type in types.ranked
    if constructed[type] == 0 || !is-class(type)
        continue
    . range = types.completions[type].properties
    for offset in 0 .. < range.count
        . place = range.start + offset
        . unit = value-units[place]
        if not-eager || unit == no-instance || !instances.rows[unit].is-live
            continue
        .. not-eager = types.properties[place].storage-kind != .storage-eager
        . id FunctionId = functions.length as FunctionId
        functions.append(unnamed-function(.property-updater, no-instance, class-module(type), 8))
        functions[id].type = type
        functions[id].place = place
        functions[id].may-panic = true
        updater-functions[place] = id
        declare-live-adapter(id)

────────────────────
_ do declare-queries

` The functions made for each markup query a registration an emitted constructor makes
` reaches: one that finds the ancestor an ancestor query looks for, and for a descendant
` query one that adds an object to the list the property holds and one that takes it from it.
` Each is given the object as its data, and may panic, as what it calls may.
for index in 0 .. < facts.markup-queries.length
    if query-used[index] == 0
        continue
    . query = facts.markup-queries[index]
    . module = class-module(query.level)
    . kinds [FunctionKind]
    if query.target-id == 0
        kinds += .markup-query
    else
        kinds += .markup-query-add
        kinds += .markup-query-remove
    for position in 0 .. < kinds.length
        . id FunctionId = functions.length as FunctionId
        functions.append(unnamed-function(kinds[position], no-instance, module, 8))
        functions[id].type = query.level
        functions[id].place = index as U32
        functions[id].may-panic = true
        query-functions[index * 2 + position] = id

────────────────────
+ query-function-of FunctionId
    - query U32
    - removes Bool = false

` A function made for a markup query, by its row of `markup-queries`: the one that finds an
` ancestor or adds a descendant, or with `removes` the one that takes a descendant away.
query-functions[query * 2 + (if removes then 1 else 0)]

────────────────────
_ do declare-live-adapter
    - target FunctionId

` The function a live action calls to run a function again, through the callback the
` action holds, as the reference casts the function to the callback's type: it follows the
` function it calls, and is given the data the callback holds.
. id FunctionId = functions.length as FunctionId
functions.append(unnamed-function(.live-adapter, no-instance, functions[target].module, 4))
functions[id].place = target
functions[id].may-panic = true

────────────────────
+ do is-rerun Bool
    - instance InstanceId

` Whether an instance is the function a live action runs a live statement again with, tests
` a `whenever` clause again with, selects the arm of a markup branch region again with, or
` reads the container of a markup loop region again with.
. row = instances.rows[instance]
do match? program.modules[row.module].decls[row.decl]
    | .decl-function(fn)
        = live || fn.kind == .whenever-decl || fn.kind == .branch-decl || fn.kind == .source-decl
            .. live = fn.kind == .live-decl
= false

────────────────────
+ live-adapter-of FunctionId
    - target FunctionId

` The adapter a live action calls a function through, which follows it.
target + 1

────────────────────
_ do declare-class-rules

` The rules each class the program constructs runs once its constructor's body has run: its
` own and those of each class above it, base first, each class's dependencies, then the
` sections that subscribe to a stream, then the starts of the state machines its properties
` hold, then its other rules, in the order they are written. They are kept in
` `class-rule-order`, from where `class-rule-heads` says up to `U32.max`. The
` rules a class runs once its markup has are kept there too, apart, from where
` `markup-rule-heads` says for the class that writes them: its sections, then its other such
` rules. A `when` or `whenever` rule typed for the class that writes it has one function a
` live action runs it again with, which may panic, and the adapter the action calls it
` through.
for type in types.ranked
    if constructed[type] == 0 || !is-class(type)
        continue
    . chain [TypeId]
    . level TypeId? = type
    while level
        chain += level
        level = types.base-of(level)
    . start = class-rule-order.length
    for offset in 0 .. < chain.length
        . holder = chain[chain.length - 1 - offset]
        . ref = class-ref(types, holder)
        . owner = program.modules[ref.module]
        do match? owner.decls[ref.decl]
            | .decl-class(class)
                for pass in 0 .. < 3
                    if pass == 2
                        for member in owner.member-pool[class.members]
                            . machine = member-machine(ref.module, member)
                            if machine != 0
                                class-rule-order += class-machine
                                    - holder
                                    - ref.module
                                    - member
                                    - machine
                    for member in owner.member-pool[class.members]
                        do match? owner.decls[member]
                            | .decl-rule(rule)
                                if in-pass && !waits(holder, ref.module, member)
                                    class-rule-order += class-rule
                                        - holder
                                        - ref.module
                                        - member
                                        - rule.syntax
                                .. in-pass = rule-pass(ref.module, rule.syntax) == pass
    if class-rule-order.length != start
        class-rule-order += U32.max
        class-rule-heads[type] = start as U32
    for holder in chain
        declare-markup-rules(holder)

────────────────────
_ member-machine SyntaxId
    - module ModuleId
    - decl DeclId

` The state machine a property of a class holds, or none (`index-sites`).
member-machines[((module as Size) /lshift/ 32) /or/ (decl as Size)] ?? 0

────────────────────
_ do class-machine U32
    - level TypeId
    - module ModuleId
    - decl DeclId
    - syntax SyntaxId

` The row of the start of a state machine a property of a class holds, which types nothing of
` its own and keeps nothing.
. index U32 = class-rules.length as U32
class-rules.append
    - ClassRule
        - level
        - module
        - decl
        - syntax
        - no-instance
        - no-layout
        - no-function
        - no-function
        - no-function
= index

────────────────────
_ waits Bool
    - level TypeId
    - module ModuleId
    - decl DeclId

` Whether a rule typed for the class that writes it runs once the markup of the class has.
unit != no-instance && facts.waits-for-markup(unit)

.. unit = instances.find-initializer(module, decl, level)

────────────────────
_ do declare-markup-rules
    - level TypeId

` The rules a class runs once its markup has, as rows of `class-rules`, listed once for the
` class.
if markup-rule-heads[level]
    =
. ref = class-ref(types, level)
. owner = program.modules[ref.module]
. start = class-rule-order.length
do match? owner.decls[ref.decl]
    | .decl-class(class)
        for pass in 1 .. < 3
            for member in owner.member-pool[class.members]
                do match? owner.decls[member]
                    | .decl-rule(rule)
                        if in-pass && waits(level, ref.module, member)
                            class-rule-order += class-rule(level, ref.module, member, rule.syntax)
                        .. in-pass = rule-pass(ref.module, rule.syntax) == pass
class-rule-order += U32.max
markup-rule-heads[level] = start as U32

────────────────────
_ do rule-pass U32
    - module ModuleId
    - syntax SyntaxId

` Where a rule of a class runs among the others: dependencies first, then sections that
` subscribe to a stream, then the rest.
do match? program.modules[module].tree.nodes[syntax]
    | .node-dependency-declaration
        = 0
    | .node-subscriber-syntax
        = 1
= 2

────────────────────
_ do reach-lowered Bool
    - kinds CPointer'U32

` Marks the event runtime's `event-register-lowered`, with its `event-register-lowered-arrival`,
` where a class the program constructs runs
` a section, or a group of the event transitions of a machine the program reaches, from its
` table, and says whether one does.
for row in facts.lowered-handlers
    if constructed[row.type] != 0
        mark(kinds, facts.event-register)
        if facts.event-register-arrival != no-instance
            mark(kinds, facts.event-register-arrival)
        drain(kinds)
        = true
for machine in facts.machines
    if kinds[machine.instance] == Reach.none
        continue
    for group in machine.groups.start .. < machine.groups.start + machine.groups.count
        if facts.machine-groups[group].lowered && machine-classes(machine).length != 0
            mark(kinds, facts.event-register)
            drain(kinds)
            = true
= false

────────────────────
_ do keep-reached-styles
    - kinds CPointer'U32

` Keeps the styles a function the program reaches uses, as the reference registers only those
` of the code it compiles: each is placed at the first place such a function uses it, a
` constructor's declaration before any other, and they are numbered again in the source order
` of those places (`style-before`), before those no such function uses, which are not
` registered. So are the style sheets, those no such function uses after the others, by the keys
` of their types (`sheet-order`), so that a sheet's number is the same in any typing order
` (`sheet-number`). An instance compiled into the frame of one the program reaches, as a
` property's first value is, counts as reached. A style rule's declarations are written where the rule is applied, so the
` instance that types a rule counts as reached where one that applies it is.
carried = arena.allocate'Byte(instances.length + 1)
for position in 0 .. < instances.length
    carried[position] = if kinds[position] != Reach.none then 1 else 0
. grew = true
while grew
    grew = false
    for application in facts.style-applications
        if carried[application.instance] != 0 && carried[application.unit] == 0
            carried[application.unit] = 1
            grew = true
. kept [PlacedStyle]
. dropped [PlacedStyle]
for use in facts.style-uses
    . found = reached-user(carried, use.type)
    if found == U32.max
        dropped += PlacedStyle(use.type, 0, 0, use.singleton, use.first, use.count, false)
    else
        . user = facts.style-users[found]
        kept += PlacedStyle
            - use.type
            - user.module
            - user.site
            - use.singleton
            - use.first
            - use.count
            - true
for use in kept
    . place = style-uses.length
    style-uses += use
    while place > 0 && style-before(use, style-uses[place - 1])
        style-uses[place] = style-uses[place - 1]
        place -= 1
    style-uses[place] = use
for use in dropped
    style-uses += use
. sheets [PlacedStyle]
. order [U32]
for use in facts.style-sheet-uses
    . found = reached-user(carried, use.type)
    order += sheets.length as U32
    sheet-numbers += 0
    if found == U32.max
        sheets += PlacedStyle(use.type, 0, 0, use.singleton, use.first, use.count, false)
    else
        . user = facts.style-users[found]
        sheets += PlacedStyle
            - use.type
            - user.module
            - user.site
            - use.singleton
            - use.first
            - use.count
            - true
. numbered = sort(order) • using :: a, b => sheet-order(sheets[a], sheets[b])
for number in 0 .. < numbered.length
    style-sheet-uses += sheets[numbered[number]]
    sheet-numbers[numbered[number]] = number as U32

────────────────────
_ sheet-order Comparison
    - sheet PlacedStyle
    - other PlacedStyle

|? sheet.registered != other.registered
    if sheet.registered then Comparison.lesser else Comparison.greater
|? style-before(sheet, other)
    Comparison.lesser
|? style-before(other, sheet)
    Comparison.greater
??
    Comparison.equal

────────────────────
+ sheet-number U32
    - sheet U32

sheet-numbers[sheet]

────────────────────
_ style-before Bool
    - style PlacedStyle
    - other PlacedStyle

` Whether a style the program registers is numbered before another: placed earlier in source
` order (`comes-before`), or placed together and with the lesser key of its type.
|? comes-before(style.module, style.site, other.module, other.site)
    true
|? comes-before(other.module, other.site, style.module, style.site)
    false
??
    types.key-of(style.type) < types.key-of(other.type)

────────────────────
_ do reached-user U32
    - carried CPointer'Byte
    - type TypeId

` The place among `style-users` of the first use of a style or style sheet by an instance the
` program reaches, a constructor's before any other; none where no such instance uses it.
. found = U32.max
for position in 0 .. < facts.style-users.length
    . user = facts.style-users[position]
    if user.type != type || carried[user.instance] == 0
        continue
    if found == U32.max
        found = position as U32
        continue
    . best = facts.style-users[found]
    if (user.constructed == best.constructed && earlier) || (user.constructed && !best.constructed)
        found = position as U32
    .. earlier = comes-before(user.module, user.site, best.module, best.site)
= found

────────────────────
_ comes-before Bool
    - module ModuleId
    - site SyntaxId
    - other-module ModuleId
    - other SyntaxId

` Whether a place in the program comes before another in source order: in a module loaded
` first, or earlier in the same module.
|? module != other-module
    module < other-module
??
    begin.line < other-begin.line || column-before

.. tree = program.modules[module].tree
.. begin = tree.nodes.loc[site].begin
.. other-begin = tree.nodes.loc[other].begin
.. column-before = begin.line == other-begin.line && begin.column < other-begin.column

────────────────────
_ place-order Comparison
    - module ModuleId
    - site SyntaxId
    - other-module ModuleId
    - other SyntaxId

` Orders two places in the program in source order, as `comes-before` does, and two that begin
` together, or that are no node, by their syntax.
|? module != other-module
    ordered(module, other-module)
|? site >= tree.nodes.length || other >= tree.nodes.length
    ordered(site, other)
|? begin.line != other-begin.line
    ordered(begin.line, other-begin.line)
|? begin.column != other-begin.column
    ordered(begin.column, other-begin.column)
??
    ordered(site, other)

.. tree = program.modules[module].tree
.. begin = tree.nodes.loc[site].begin
.. other-begin = tree.nodes.loc[other].begin

────────────────────
_ line-order Comparison
    - instance InstanceId
    - site SyntaxId
    - other-instance InstanceId
    - other SyntaxId

` Orders two places of instances by the stable keys of the instances, and two of one instance by
` their syntax.
|? instance != other-instance
    ordered(instance-key(instance), instance-key(other-instance))
??
    ordered(site, other)

────────────────────
_ instance-key U64
    - instance InstanceId

if instance != no-instance then (instances.stable-keys[instance] as U64) else 0

────────────────────
_ ordered Comparison
    - value U64
    - other U64

|? value < other
    Comparison.lesser
|? value > other
    Comparison.greater
??
    Comparison.equal

────────────────────
_ do reach-styles Bool
    - kinds CPointer'U32

` Marks what registering the styles the program uses calls: the style runtime's functions,
` the constructor of each style's object, and what turns values into bits where some instance
` uses it (`used-codings`). Says whether any of it may panic, which every registration then may.
if style-uses.length == 0
    = false
. runtime = facts.style-runtime
. used = used-codings(false)
. held = used-codings(true)
. boxed = false
for position in 0 .. < facts.style-codings.length
    boxed = boxed || (used[position] && facts.style-codings[position].holder != no-instance)
. calls = [runtime.info-for, runtime.info, runtime.register-property, runtime.register, runtime.register-domain]
if runtime.intern-holder != no-instance && boxed
    calls += runtime.intern-holder
for use in style-uses
    if use.registered
        calls += use.singleton
if style-sheet-uses.length != 0
    calls += runtime.sheet-info-for
    calls += runtime.sheet-info
    calls += runtime.sheet-register-slot
    calls += runtime.sheet-register
for use in style-sheet-uses
    if use.registered
        calls += use.singleton
        for member in facts.sheet-members
            if member.root == use.type
                calls += runtime.sheet-register-member
                calls += runtime.sheet-member-slot
                calls += runtime.sheet-member-tag
                calls += member.singleton
. position = 0
for coding in facts.style-codings
    if used[position]
        calls += if coding.intern != no-instance then coding.intern else coding.holder
    if held[position] && coding.value-holder != no-instance
        calls += coding.value-holder
    position += 1
for callee in [runtime.info-required, runtime.site-inherit, runtime.template-object, runtime.site-cached, runtime.author-object, runtime.object-pointer, runtime.imperative, runtime.imperative-object]
    if callee != no-instance
        calls += callee
. panics = false
for callee in calls
    mark(kinds, callee)
    drain(kinds)
    if instances.rows[callee].may-panic
        panics = true
= panics

────────────────────
_ is-retired Bool
    - instance InstanceId

` Whether a row names the instance that holds what instances an edit typed again in place had
` recorded (`Facts.retire`): program tables make nothing of such a row.
instance != no-instance && instance == instances.dead

────────────────────
_ do used-codings [Bool]
    - holds Bool

` Which rows of `style-codings` some instance uses (`Facts.coding-users`), or, where `holds`,
` holds an object by the row's `value-holder`. A row only instances an edit retired used is
` unused, as no row is in a cold build.
. used [Bool]
for _ in 0 .. < facts.style-codings.length
    used += false
for user in facts.coding-users
    if user.holds || !holds
        for position in 0 .. < facts.style-codings.length
            if facts.style-codings[position].type == user.type
                used[position] = true
= used

────────────────────
_ do used-gates [Bool]

` Which rows of `style-gates` some instance uses (`Facts.gate-users`). A row only instances an
` edit retired used is unused, as no row is in a cold build.
. used [Bool]
for _ in 0 .. < facts.style-gates.length
    used += false
for user in facts.gate-users
    used[user.gate] = true
= used

────────────────────
_ do declare-style-gates

` A function for each row of `style-gates` some instance uses (`used-gates`), which evaluates the
` conditions of the row again in the live action it runs in and enables or disables the block it
` is given, or the record of generated content, in the module of the innermost `when`, with what
` the action that runs it keeps laid out: the object, the block or the record, then the state cell
` of each `when` that is one and the environment of each condition a rule is applied under. It may
` panic, as noting a read may. The rows are declared in the order `gate-order` gives them.
. cell = cell-type()
. record = if facts.style-runtime.template-content != no-instance then content-record else no-type
    .. content-record = instances.signatures[facts.style-runtime.template-content].returns
. used = used-gates()
. rows [U32]
for index in 0 .. < facts.style-gates.length
    if used[index]
        rows += index as U32
    gate-functions += no-function
    gate-layouts += no-layout
. ordered-rows = sort(rows) • using :: a, b => gate-order(a, b)
for number in 0 .. < ordered-rows.length
    . index = ordered-rows[number]
    . gate = facts.style-gates[index]
    . written = facts.style-gate-whens[gate.first + gate.count - 1]
    . id FunctionId = functions.length as FunctionId
    functions.append(unnamed-function(.style-gate, no-instance, written.module, 8))
    functions[id].type = gate.type
    functions[id].place = index
    functions[id].number = number as U32
    functions[id].may-panic = true
    gate-functions[index] = id
    declare-live-adapter(id)
    . children [LayoutId]
    . held [TypeId]
    children += managed-layout
    held += gate.type
    if gate.content
        children += managed-layout
        held += record
    else
        children += i64-layout
        held += types.type-row(.int64)
    for position in 0 .. < gate.count
        . place = facts.style-gate-whens[gate.first + position]
        if place.cell != U32.max
            children += managed-layout
            held += cell
        else if place.test != no-instance
            children += managed-layout
            held += no-type
    gate-layouts[index] = layouts.environment(children, held, "style-gate.$number")

────────────────────
_ do gate-order Comparison
    - row U32
    - other U32

` Orders two rows of `style-gates` by their `when`s from the innermost out, each by its place in
` source order, by whether it is a state cell and by the stable key of its test; then by how many
` they are, by whether the row gates content, and by the stable key of the type it gates.
. gate = facts.style-gates[row]
. against = facts.style-gates[other]
. depth = if gate.count < against.count then gate.count else against.count
for position in 0 .. < depth
    . held = facts.style-gate-whens[gate.first + gate.count - 1 - position]
    . given = facts.style-gate-whens[against.first + against.count - 1 - position]
    . placed = place-order(held.module, held.syntax, given.module, given.syntax)
    if placed != Comparison.equal
        = placed
    if (held.cell == U32.max) != (given.cell == U32.max)
        = if held.cell == U32.max then Comparison.lesser else Comparison.greater
    if held.test != given.test
        = ordered(instance-key(held.test), instance-key(given.test))
if gate.count != against.count
    = ordered(gate.count, against.count)
if gate.content != against.content
    = if gate.content then Comparison.greater else Comparison.lesser
= ordered(types.key-of(gate.type), types.key-of(against.type))

────────────────────
+ cell-type TypeId

` The class of the state cells of `scope-cells`, `StyleScopeState`, as its constructor makes it,
` or none where no cell is made.
if made != no-instance then instances.rows[made].self-type else no-type

.. made = facts.style-runtime.scope-state

────────────────────
_ do declare-scope-cells

` A function for each row of `scope-cells` made where it is bound, which evaluates the state of
` its `when` again in the live action it runs in and gives the cell it is given whether it holds,
` in the module of the `when`, with what the action that runs it keeps laid out. It may panic, as
` noting a read may. A cell an instance is given, keeps or reads has none, nor has one found on
` the way to a slot outlet, which no instance makes, nor one an edit retired (`is-retired`). The
` rows are declared in the order `cell-order` gives them.
. cell = cell-type()
. rows [U32]
for index in 0 .. < facts.scope-cells.length
    . row = facts.scope-cells[index]
    cell-functions += no-function
    cell-layouts += no-layout
    if row.site != U32.max && row.instance != no-instance && !is-retired(row.instance)
        rows += index as U32
. ordered-rows = sort(rows) • using :: a, b => cell-order(a, b)
for number in 0 .. < ordered-rows.length
    . index = ordered-rows[number]
    . row = facts.scope-cells[index]
    . id FunctionId = functions.length as FunctionId
    functions.append(unnamed-function(.style-scope-state, no-instance, row.module, 8))
    functions[id].type = row.owner
    functions[id].place = index
    functions[id].number = number as U32
    functions[id].may-panic = true
    cell-functions[index] = id
    declare-live-adapter(id)
    . children [LayoutId]
    . held [TypeId]
    children += managed-layout
    held += row.owner
    children += managed-layout
    held += cell
    cell-layouts[index] = layouts.environment(children, held, "style-scope-state.$number")

────────────────────
_ cell-order Comparison
    - row U32
    - other U32

` Orders two rows of `scope-cells` made at a site of an instance: by the place of their `when` in
` source order, then by the stable key of the instance, by the site, and by where each is made.
|? placed != Comparison.equal
    placed
|? cell.instance != against.instance
    ordered(instance-key(cell.instance), instance-key(against.instance))
|? cell.site != against.site
    ordered(cell.site, against.site)
|? made.module != given.module
    ordered(made.module, given.module)
??
    ordered(made.site, given.site)

.. cell = facts.scope-cells[row]
.. against = facts.scope-cells[other]
.. placed = place-order(cell.module, cell.when, against.module, against.when)
.. made = instances.state-keys[cell.key]
.. given = instances.state-keys[against.key]

────────────────────
_ do declare-kept-cells

` The environment each function that builds markup and keeps state cells or values of rules of
` the function it is written in is given, as `kept-layouts` lays it out, but for rows an edit
` retired (`is-retired`).
. keeping [InstanceId]
for row in facts.scope-cells
    if row.kept != U32.max && !is-retired(row.instance) && keeping.find(row.instance) == null
        keeping += row.instance
for row in facts.scope-values
    if row.kept != U32.max && !is-retired(row.instance) && keeping.find(row.instance) == null
        keeping += row.instance
. keepers = sort(keeping) • using :: a, b => ordered(instance-key(a), instance-key(b))
for keeper in keepers
    . children [LayoutId]
    . held [TypeId]
    children += managed-layout
    held += no-type
    for row in facts.scope-cells
        if row.instance == keeper && row.kept != U32.max
            children += managed-layout
            held += cell-type()
    for row in facts.scope-values
        if row.instance == keeper && row.kept != U32.max
            for position in row.type-first .. < row.type-first + row.count
                . type = facts.scope-value-types[position]
                children += layouts.values[type]
                held += type
    kept-instances += keeper
    kept-layouts += layouts.environment
        - children
        - held
        - "kept.${hex-text(instances.stable-keys[keeper])}"

────────────────────
_ do declare-slot-forwards

` A function for each row of `slot-forwards` but those an edit retired (`is-retired`), which
` holds the state cells the line holds (`OutletCell`) while the builder it forwards runs, in the
` module of the line, with what it keeps laid out. It may panic, as the builder may. The rows are
` declared in the order of the stable keys of their instances, and of their lines.
. cell = cell-type()
. rows [U32]
for index in 0 .. < facts.slot-forwards.length
    if !is-retired(facts.slot-forwards[index].instance)
        rows += index as U32
    slot-forward-functions += no-function
    slot-forward-layouts += no-layout
. forwards = facts.slot-forwards
. ordered-rows = sort(rows) • using :: a, b => line-order(forwards[a].instance, forwards[a].line, forwards[b].instance, forwards[b].line)
for number in 0 .. < ordered-rows.length
    . index = ordered-rows[number]
    . row = forwards[index]
    . id FunctionId = functions.length as FunctionId
    functions.append
        - unnamed-function(.slot-forward, no-instance, instances.rows[row.instance].module, 8)
    functions[id].type = row.builder
    functions[id].place = index
    functions[id].number = number as U32
    functions[id].may-panic = true
    slot-forward-functions[index] = id
    . children [LayoutId]
    . held [TypeId]
    children += pointer-layout
    held += no-type
    children += managed-layout
    held += no-type
    for kept in facts.outlet-cells
        if kept.instance == row.instance && kept.outlet == row.line
            children += managed-layout
            held += cell
    slot-forward-layouts[index] = layouts.environment(children, held, "slot-forward.$number")

────────────────────
+ kept-layout-of LayoutId
    - instance InstanceId

` The environment a function that builds markup is given where it keeps state cells, or none.
if position then kept-layouts[position] else no-layout

.. position = kept-instances.find(instance)

────────────────────
_ do declare-style-authors

` A function for each row of `style-authors` but those an edit retired (`is-retired`), which
` evaluates the value of the declaration again in the live action it runs in and declares it for
` the object it is given, in the module of the style rule, named for the property it declares,
` with what the action that runs it keeps laid out. It may panic, as noting a read may. The rows
` are declared in the order of the stable keys of their instances, and of their lines.
. rows [U32]
for index in 0 .. < facts.style-authors.length
    if !is-retired(facts.style-authors[index].instance)
        rows += index as U32
    author-functions += no-function
    author-layouts += no-layout
. authors = facts.style-authors
. ordered-rows = sort(rows) • using :: a, b => line-order(authors[a].instance, authors[a].site, authors[b].instance, authors[b].site)
for number in 0 .. < ordered-rows.length
    . index = ordered-rows[number]
    . author = authors[index]
    . unit = instances.rows[author.instance]
    . id FunctionId = functions.length as FunctionId
    functions.append(unnamed-function(.style-author, no-instance, unit.module, 8))
    functions[id].type = unit.self-type
    functions[id].place = index
    functions[id].number = number as U32
    functions[id].may-panic = true
    author-functions[index] = id
    declare-live-adapter(id)
    . children [LayoutId]
    . held [TypeId]
    children += managed-layout
    held += unit.self-type
    children += i64-layout
    held += types.type-row(.int64)
    children += u32-layout
    held += types.type-row(.uint32)
    children += u32-layout
    held += types.type-row(.uint32)
    author-layouts[index] = layouts.environment(children, held, "style-author.$number")

────────────────────
_ do declare-given-authors

` A function for each line of a style rule that declares a style, or sets a property of the class,
` with a value reading a value the rule takes, where an application with `live-values` applies it,
` but one an edit retired (`is-retired`): it evaluates the values again where they are written,
` and the line's value, in the live action it runs in, and declares it for the object it is
` given, as an author's does (`declare-style-authors`), or stores it in the property. What the action keeps is laid out as an author's, then the receiver
` where the values the site applies are written. None where that has no receiver. The
` applications are taken in the order `application-order` gives them.
. rows [U32]
for index in 0 .. < facts.style-applications.length
    . application = facts.style-applications[index]
    if application.live-values && !is-retired(application.instance) && !is-retired(application.unit)
        rows += index as U32
. ordered-rows = sort(rows) • using :: a, b => application-order(a, b)
for index in ordered-rows
    . application = facts.style-applications[index]
    . receiver = given-receiver(index)
    if receiver == no-type
        continue
    . unit = instances.rows[application.unit]
    . sites [SyntaxId]
    for row in facts.style-declarations
        if row.instance == application.unit && row.reads-given
            sites += row.site
    for row in facts.rule-updates
        if row.instance == application.unit && row.reads-given
            sites += row.site
    for site in sites
        . place = given-functions.length as U32
        . id FunctionId = functions.length as FunctionId
        functions.append(unnamed-function(.style-given-author, no-instance, unit.module, 8))
        functions[id].type = unit.self-type
        functions[id].place = place
        functions[id].number = place
        functions[id].may-panic = true
        given-applications += index
        given-sites += site
        given-functions += id
        declare-live-adapter(id)
        . children [LayoutId]
        . held [TypeId]
        children += managed-layout
        held += unit.self-type
        children += i64-layout
        held += types.type-row(.int64)
        children += u32-layout
        held += types.type-row(.uint32)
        children += u32-layout
        held += types.type-row(.uint32)
        children += managed-layout
        held += receiver
        for item in given-row-items(index)
            children += managed-layout
            held += item.held
        given-layouts += layouts.environment(children, held, "style-given.$place")

────────────────────
+ do given-row-items [RowItemRead]
    - index U32

. top = facts.style-applications[index]
while top.outer != U32.max
    top = facts.style-applications[top.outer]
. result [RowItemRead]
. slots [SlotId]
. written = program.modules[top.module].tree
. binding = instances.rows[top.instance].binding
do match? written.nodes[top.written]
    | .node-style-rule-application(applied)
        for value in written.children[applied.args]
            for node in written.subtree-start(value) .. value
                . held = facts.row-item-of(top.instance, node)
                if held == no-type
                    continue
                . resolution = bindings.resolution-of(binding, node)
                if resolution.kind == .resolve-slot && slots.find(resolution.slot) == null
                    slots += resolution.slot
                    result += RowItemRead(top.instance, node, held)
= result

────────────────────
+ do given-receiver TypeId
    - index U32

` The receiver where the values of the application a site applies, around an application of
` `style-applications`, are written: that of the instance that types them, or, where that one is
` written in another and reads its receiver, such as an arm of a markup region, that of the one
` it is written in.
. top = facts.style-applications[index]
while top.outer != U32.max
    top = facts.style-applications[top.outer]
. typing = if top.values != no-instance then top.values else top.instance
while instances.rows[typing].self-type == no-type && instances.rows[typing].enclosing != no-instance
    typing = instances.rows[typing].enclosing
= instances.rows[typing].self-type

────────────────────
+ do given-author U32
    - application U32
    - site SyntaxId

` The place among `given-functions` of the function that declares again the line `site` of the
` rule an application applies, or `U32.max`.
for place in 0 .. < given-applications.length
    if given-applications[place] == application && given-sites[place] == site
        = place as U32
= U32.max

────────────────────
_ do declare-shared-rules

` A function for each rule an element applies `shared`, once for each class of object and rule
` and the rules it comes to apply there, which the style sheets the element sees may choose,
` which declares what the rule declares for the object it is given, in the module of the rule,
` named as the reference's `style-rule` functions are. Each such application by an instance the
` program carries (`keep-reached-styles`) calls it (`rule-function-of`). The applications are
` taken in the order `application-order` gives them.
. shared [U32]
for index in 0 .. < facts.style-applications.length
    . application = facts.style-applications[index]
    if application.shared && application.outer == U32.max && carried[application.instance] != 0
        shared += index as U32
. ordered-rows = sort(shared) • using :: a, b => application-order(a, b)
. number = 0u32
for index in ordered-rows
    . application = facts.style-applications[index]
    . id = no-function
    . position = rule-unit-heads[application.unit] ?? U32.max
    while position != U32.max
        . earlier = facts.style-applications[rule-applications[position]]
        if earlier.made == application.made && alike && rules-match
            id = rule-functions[position]
            break
        .. alike = earlier.layer == application.layer && earlier.action == application.action
        .. rules-match = same-rules(rule-applications[position], index)
        position = rule-unit-links[position]
    if id == no-function
        id = functions.length as FunctionId
        functions.append
            - unnamed-function(.style-rule, no-instance, instances.rows[application.unit].module, 8)
        functions[id].type = application.made
        functions[id].place = index
        functions[id].number = number
        functions[id].may-panic = true
        number += 1
    rule-unit-links += rule-unit-heads[application.unit] ?? U32.max
    rule-unit-heads[application.unit] = rule-applications.length as U32
    rule-function-rows[index] = id
    rule-applications += index
    rule-functions += id

────────────────────
_ application-order Comparison
    - row U32
    - other U32

` Orders two applications of style rules by the stable key of the instance that applies each and
` the site, then by layer and order, and by the stable keys of the instance that types the rule
` and of the class it is applied to.
|? placed != Comparison.equal
    placed
|? application.layer != against.layer
    ordered(application.layer, against.layer)
|? application.order != against.order
    ordered(application.order, against.order)
|? application.unit != against.unit
    ordered(instance-key(application.unit), instance-key(against.unit))
??
    ordered(types.key-of(application.made), types.key-of(against.made))

.. application = facts.style-applications[row]
.. against = facts.style-applications[other]
.. placed = line-order(application.instance, application.site, against.instance, against.site)

────────────────────
_ do same-rules Bool
    - first U32
    - second U32

` Whether two applications of a style rule come to apply the same rules, in the same places,
` taking the same slots of style sheets.
. count = facts.style-applications.length as U32
. offset = 1u32
. same = same-slots(first, second) && same-family(first, second)
while same
    . left = first + offset
    . right = second + offset
    . ends = left >= count || facts.style-applications[left].outer == U32.max
    . other = right >= count || facts.style-applications[right].outer == U32.max
    if ends || other
        = ends && other
    . one = facts.style-applications[left]
    . two = facts.style-applications[right]
    same = one.unit == two.unit && one.outer - first == two.outer - second && one.within == two.within && one.written == two.written && one.layer == two.layer && one.action == two.action && same-slots(left, right) && same-family(left, right)
    offset += 1
= false

────────────────────
_ same-family Bool
    - first U32
    - second U32

one.family == two.family && one.members == two.members

.. one = facts.style-applications[first]
.. two = facts.style-applications[second]

────────────────────
_ do same-slots Bool
    - first U32
    - second U32

` Whether two applications of a style rule take the same slots of style sheets, alone or in the
` values their lines compute with them.
. left [U32]
. right [U32]
for place in 0 .. < facts.rule-slots.length
    . slot = facts.rule-slots[place]
    if slot.application == first
        left += place as U32
    else if slot.application == second
        right += place as U32
if left.length != right.length
    = false
for position in 0 .. < left.length
    . one = facts.rule-slots[left[position]]
    . two = facts.rule-slots[right[position]]
    if one.site != two.site || one.sheet != two.sheet || one.slot != two.slot || other-projection
        = false
    .. other-projection = one.projection != two.projection
. themed-left [U32]
. themed-right [U32]
for place in 0 .. < facts.rule-themes.length
    . theme = facts.rule-themes[place]
    if theme.application == first
        themed-left += place as U32
    else if theme.application == second
        themed-right += place as U32
if themed-left.length != themed-right.length
    = false
for position in 0 .. < themed-left.length
    . one = facts.rule-themes[themed-left[position]]
    . two = facts.rule-themes[themed-right[position]]
    if one.site != two.site || one.themed != two.themed
        = false
= true

────────────────────
+ rule-function-of FunctionId
    - index U32

` The function a `shared` application of a style rule calls, or none.
if found then found as FunctionId else no-function

.. found = rule-function-rows[index]

────────────────────
_ do declare-static-values

` A function for each row of `style-static-values`, which evaluates the value once for the
` style runtime and gives its bits, in the module that writes it, named as the reference's
` `style-static-value` functions are numbered and declared in source order.
. rows [U32]
for index in 0 .. < facts.style-static-values.length
    rows += index as U32
    static-value-functions += no-function
. values = facts.style-static-values
. ordered-rows = sort(rows) • using :: a, b => place-order(values[a].module, values[a].site, values[b].module, values[b].site)
for number in 0 .. < ordered-rows.length
    . index = ordered-rows[number]
    . row = values[index]
    . id FunctionId = functions.length as FunctionId
    functions.append(unnamed-function(.style-static-value, no-instance, row.module, 8))
    functions[id].type = row.type
    functions[id].place = index
    functions[id].number = number as U32
    functions[id].may-panic = instances.rows[row.instance].may-panic
    static-value-functions[index] = id

────────────────────
_ do declare-themed-values

` A function for each row of `style-themed-values` some instance the program carries uses
` (`used-themed-values`), which evaluates the value from the slots of the style sheet it reads.
. used = used-themed-values()
. rows [U32]
for index in 0 .. < facts.style-themed-values.length
    if used[index]
        rows += index as U32
    themed-value-functions += no-function
. values = facts.style-themed-values
. ordered-rows = sort(rows) • using :: a, b => themed-order(values[a], values[b])
for number in 0 .. < ordered-rows.length
    . index = ordered-rows[number]
    . row = values[index]
    . id FunctionId = functions.length as FunctionId
    functions.append(unnamed-function(.style-themed-value, no-instance, row.module, 8))
    functions[id].type = row.type
    functions[id].place = index
    functions[id].number = number as U32
    functions[id].may-panic = instances.rows[row.instance].may-panic
    themed-value-functions[index] = id

────────────────────
_ do used-themed-values [Bool]

` Which rows of `style-themed-values` a declaration of an instance the program carries
` (`keep-reached-styles`) evaluates, or a line of a rule such an instance applies.
. used [Bool]
for _ in 0 .. < facts.style-themed-values.length
    used += false
for row in facts.style-declarations
    if row.themed != U32.max && carried[row.instance] != 0
        used[row.themed] = true
for theme in facts.rule-themes
    if carried[facts.style-applications[theme.application].instance] != 0
        used[theme.themed] = true
= used

────────────────────
_ do themed-order Comparison
    - value StyleThemedValue
    - other StyleThemedValue

. placed = place-order(value.module, value.site, other.module, other.site)
=? placed if placed != Comparison.equal
if value.sheet != other.sheet
    = ordered
        - types.key-of(facts.style-sheet-uses[value.sheet].type)
        - types.key-of(facts.style-sheet-uses[other.sheet].type)
if value.given-count != other.given-count
    = ordered(value.given-count, other.given-count)
for offset in 0 .. < value.given-count
    . given = facts.themed-givens[value.given + offset]
    . against = facts.themed-givens[other.given + offset]
    if given.slot != against.slot
        = ordered(given.slot, against.slot)
    if given.param != against.param
        = ordered(given.param, against.param)
= Comparison.equal

────────────────────
_ do declare-style-registrations

` The functions that register the styles the program uses, as the reference makes them: one
` for each style, in the order the styles are numbered, made in the style's module and named
` `style-register-impl`, numbered from the second. Its code is placed at the declaration of the
` constructor that first used the style, which a stack trace names the file of. The init of
` the style's module calls it. So for each style sheet registered, named
` `style-sheet-register-impl` and placed at the declaration that first took the value of one of
` its slots.
for index in 0 .. < style-uses.length
    . use = style-uses[index]
    if !use.registered
        continue
    . module = class-ref(types, use.type).module
    . id FunctionId = functions.length as FunctionId
    functions.append(unnamed-function(.style-registration, no-instance, module, 4))
    functions[id].place = index as U32
    functions[id].may-panic = true
    if use.module != module
        functions[id].site-module = use.module
    place-file(use.module)
    style-functions += id
for index in 0 .. < style-sheet-uses.length
    . use = style-sheet-uses[index]
    if !use.registered
        continue
    . module = class-ref(types, use.type).module
    . id FunctionId = functions.length as FunctionId
    functions.append(unnamed-function(.style-sheet-registration, no-instance, module, 4))
    functions[id].place = index as U32
    functions[id].may-panic = true
    if use.module != module
        functions[id].site-module = use.module
    place-file(use.module)
    sheet-functions += id
for index in facts.domain-order
    place-file(facts.domain-places[index].module)

────────────────────
_ do number-domains

` Numbers each domain of invalidation by its place in the order the style module's init registers
` those some instance names in (`Facts.domain-order`).
for _ in 0 .. < facts.style-domains.length
    domain-numbers += U32.max
for position in 0 .. < facts.domain-order.length
    domain-numbers[facts.domain-order[position]] = position as U32

────────────────────
_ do number-keys

` Numbers the places state cells are made at and the targets of descendant queries, which the
` runtimes know them by, in orders that do not depend on the order typing found them in
` (`state-key-number`, `target-number`). Only the places of the cells of instances no edit
` retired are numbered: an edit that changes a body leaves behind the places it made cells at
` there.
. live [Bool]
for _ in 0 .. < instances.state-keys.length
    live += false
for row in facts.scope-cells
    if !is-retired(row.instance) && (row.key as Size) < live.length
        live[row.key] = true
. keys [U32]
for index in 0 .. < instances.state-keys.length
    state-key-numbers += 0
    if live[index]
        keys += index as U32
. ordered-keys = sort(keys) • using :: a, b => state-key-order(a, b)
for position in 0 .. < ordered-keys.length
    state-key-numbers[ordered-keys[position]] = position as U32
. targets [U32]
for index in 0 .. < facts.query-targets.length
    targets += index as U32
    target-numbers += 0
. query-targets = facts.query-targets
. ordered-targets = sort(targets) • using :: a, b => ordered(types.key-of(query-targets[a]), types.key-of(query-targets[b]))
for position in 0 .. < ordered-targets.length
    target-numbers[ordered-targets[position]] = (position + 1) as U32

────────────────────
+ domain-number U32
    - domain U32

` The number the style runtime knows a domain of invalidation by: its place in the order the
` style module's init registers the domains in (`Facts.domain-order`), which does not depend on
` the order typing first named them in, as their places among `style-domains` do.
domain-numbers[domain]

────────────────────
+ do property-mask U32
    - property U32
    - parent Bool

` The mask of the domains of invalidation a change to a property of `style-properties` raises on
` the node, or on its parent, a bit for each domain's number (`domain-number`), from the
` property's rows of `property-domains`. A domain no instance names any longer has no number and
` no bit.
. mask = 0u32
for row in facts.property-domains
    if row.property == property && row.parent == parent && domain-numbers[row.domain] != U32.max
        mask = mask /or/ (1u32 /lshift/ domain-numbers[row.domain])
= mask

────────────────────
+ target-number U32
    - target-id U32

` The number the markup runtime knows the target of descendant queries by, as the type pass
` numbers them from 1 (`Facts.query-targets`), or 0 for none: its place among them in the order
` of the stable keys of their classes, which does not depend on the order typing found them in.
if target-id != 0 then target-numbers[target-id - 1] else 0

────────────────────
+ do target-ids-of [U32]
    - level TypeId

` The targets of descendant queries a constructor registers an object of the class `level` for
` (`QueryRegistration`): each the class is or is below, as the type pass numbers them from 1
` (`Facts.query-targets`), from all it numbered.
. found [U32]
for index in 0 .. < facts.query-targets.length
    . target = facts.query-targets[index]
    . held TypeId? = level
    while held && types.intrinsic-of(held) == .class
        if held == target
            found += (index + 1) as U32
            break
        held = types.base-of(held)
= found

────────────────────
+ state-key-number U32
    - key U32

` The number the style runtime knows where a state cell is made by: the place of the key among
` the `Instances.state-keys` of the cells `number-keys` numbers, in the order `state-key-order`
` gives them, which does not depend on the order typing interned them in.
state-key-numbers[key]

────────────────────
_ state-key-order Comparison
    - key U32
    - other U32

` Orders two places state cells are made by the site and then by the `when`, each in source
` order.
|? placed != Comparison.equal
    placed
??
    place-order(made.when-module, made.when, given.when-module, given.when)

.. made = instances.state-keys[key]
.. given = instances.state-keys[other]
.. placed = place-order(made.module, made.site, given.module, given.site)

────────────────────
_ do place-file
    - placed ModuleId

` Says an init registers at a place in a module, whose file a stack trace names for the call.
if module-paths.data[placed] == no-string
    module-paths.data[placed] = bundle.intern(program.modules[placed].relative-path)

────────────────────
_ do registers-styles Bool
    - module ModuleId

` Whether the init of a module registers styles or domains of invalidation.
if module == style-module() && facts.domain-order.length != 0
    = true
for use in style-uses
    if use.registered && class-ref(types, use.type).module == module
        = true
for use in style-sheet-uses
    if use.registered && class-ref(types, use.type).module == module
        = true
= false

────────────────────
+ style-module ModuleId

` The module of the style runtime.
class-ref(types, types.type-row(.style)).module

────────────────────
+ do style-registrations [FunctionId]
    - module ModuleId

` The functions that register the styles a module declares, in the order of the places they
` are registered at and then of the styles' declarations, so the order is the same however the
` styles were numbered.
. found [FunctionId]
. keys [U64]
for id in style-functions
    if functions[id].module == module
        . use = style-uses[functions[id].place]
        add-registration(found, keys, id, use.module, use.site, use.type)
= found

────────────────────
+ do sheet-registrations [FunctionId]
    - module ModuleId

` The functions that register the style sheets a module declares, in the order of the places
` they are registered at and then of the sheets' declarations.
. found [FunctionId]
. keys [U64]
for id in sheet-functions
    if functions[id].module == module
        . use = style-sheet-uses[functions[id].place]
        add-registration(found, keys, id, use.module, use.site, use.type)
= found

────────────────────
_ do add-registration
    - found [FunctionId]
    - keys [U64]
    - id FunctionId
    - module ModuleId
    - site SyntaxId
    - type TypeId

` Adds a function that registers a style or a sheet to those `found`, kept in the order of the
` places they are registered at, and then of the declarations of what they register, each
` given by two of `keys`.
. ref = class-ref(types, type)
. place = ((module as U64) /lshift/ 32) /or/ (site as U64)
. declared = ((ref.module as U64) /lshift/ 32) /or/ (ref.decl as U64)
. index = found.length
found += id
keys += place
keys += declared
while index > 0 && (keys[index * 2 - 2] > place || (keys[index * 2 - 2] == place && keys[index * 2 - 1] > declared))
    found[index] = found[index - 1]
    keys[index * 2] = keys[index * 2 - 2]
    keys[index * 2 + 1] = keys[index * 2 - 1]
    index -= 1
found[index] = id
keys[index * 2] = place
keys[index * 2 + 1] = declared

────────────────────
_ do declare-event-handlers

` The functions for the sections that classes the program constructs run from their tables, as
` the reference makes them: one for each section, whichever classes run it, named for the class
` that writes it and the event and numbered from the second so named; one for each class, which
` says whether an object is of it; and one for each module of such a class, which puts them in
` the event runtime's tables as the module starts. A section on an event that is not live has
` none. They are taken by the rank of the first constructor of each class, and a class's in the
` order they were planned, base first, so the order is the same however the classes were typed
` (`lowered-order`).
. keys [U64]
for index in 0 .. < facts.lowered-handlers.length
    lowered-functions += no-function
    lowered-matchers += no-function
    . rank = constructor-rank(facts.lowered-handlers[index].type) as U64
    keys += (rank /lshift/ 32) /or/ (index as U64)
for key in sorted-pairs(keys)
    . index = (key /and/ 0xffffffff) as Size
    lowered-order += index as U32
    . row = facts.lowered-handlers[index]
    if constructed[row.type] == 0 || event-number(row.owner, row.name) == U32.max
        continue
    . unit = instances.find-initializer(row.module, row.decl, row.level)
    . handler = no-function
    for place in 0 .. < event-handlers.length
        if event-handlers[place].unit == unit && event-handlers[place].syntax == row.syntax
            handler = handler-functions[place]
    if handler == no-function
        . used = event-use-of(unit, row.syntax) if unit != no-instance
        . callback = if used then used.callback else no-instance
        . shown = type-short-name(types, row.level)
        . number U32 = 1
        for other in event-handlers
            if other.name == row.name && type-short-name(types, other.level) == shown
                number += 1
        handler = functions.length as FunctionId
        . weight = if callback != no-instance then instances.rows[callback].subtree.count + 1 else 1
        functions.append(unnamed-function(.event-handler, callback, row.module, weight))
        functions[handler].place = event-handlers.length as U32
        functions[handler].may-panic = true
        event-handlers.append(EventHandler(unit, row.syntax, callback, row.level, row.name, number))
        handler-functions += handler
    lowered-functions[index] = handler
    lowered-matchers[index] = class-matcher(row.type)
    register-module(row.type)

────────────────────
_ constructor-rank U32
    - type TypeId

` Where the first constructor of a class the program emits stands among the instances by rank,
` or after them all where it emits none.
if making != no-instance then instances.rank-of(making) else instances.ordered.length as U32

.. making = first-constructor(type)

────────────────────
_ do class-matcher FunctionId
    - type TypeId

` The function that says whether an object is of a class whose table the event runtime runs
` functions from, made once for the class.
for place in 0 .. < matcher-types.length
    if matcher-types[place] == type
        = matcher-functions[place]
. matcher = functions.length
functions.append(unnamed-function(.event-matcher, no-instance, class-ref(types, type).module, 4))
functions[matcher].type = type
functions[matcher].may-panic = true
matcher-types += type
matcher-functions += matcher as FunctionId
= matcher as FunctionId

────────────────────
_ do register-module
    - type TypeId

` Notes that the init of the module of a class puts functions of the class's table in the event
` runtime's tables, and makes the function that does it once for the module. The class's first
` constructor is the last so noted for the module.
. module = class-ref(types, type).module
. making = first-constructor(type)
. known = false
for place in 0 .. < registered-modules.length
    if registered-modules[place] == module
        registered-constructors[place] = making
        known = true
if !known
    registered-modules += module
    registered-constructors += making
for registering in registration-functions
    if functions[registering].module == module
        =
. id FunctionId = functions.length as FunctionId
registration-functions += id
functions.append(unnamed-function(.event-registrations, no-instance, module, 4))
functions[id].may-panic = instances.rows[facts.event-register].may-panic

────────────────────
_ do declare-machine-descriptors

` Declares, for each group of a state machine's event transitions that the event runtime runs
` from the table of a class the program constructs, as the reference makes them: the function
` the table runs, given the object and what was published, which gives the group's activation
` to the event runtime's queue where the object holds one; and the functions that say whether
` an object is of the class and that put them in the event runtime's tables as the module of the
` class starts. A group on an event that is not live has none.
` Machines are taken by the rank of the instance each is written in, so the order is the same
` however they were typed.
. keys [U64]
for index in 0 .. < facts.machines.length
    . rank = instances.rank-of(facts.machines[index].instance)
    . placed = if rank != U32.max then rank else instances.ordered.length as U32
    keys += ((placed as U64) /lshift/ 32) /or/ (index as U64)
for key in sorted-pairs(keys)
    . machine = facts.machines[(key /and/ 0xffffffff) as Size]
    . stored = machine.store == .store-member || machine.store == .store-content
    if instance-functions[machine.instance] == no-function || !stored
        continue
    . classes = machine-classes(machine)
    . module = instances.rows[machine.instance].module
    for group in machine.groups.start .. < machine.groups.start + machine.groups.count
        . row = facts.machine-groups[group]
        if !row.lowered || row.event == U32.max
            continue
        . used = facts.event-uses[row.event]
        if event-number(used.owner, used.name) == U32.max
            continue
        for type in classes
            . descriptor FunctionId = functions.length as FunctionId
            functions.append(unnamed-function(.machine-descriptor, machine.instance, module, 1))
            functions[descriptor].place = group
            functions[descriptor].type = type
            functions[descriptor].may-panic = true
            machine-descriptors += MachineDescriptor(group, type, descriptor, class-matcher(type))
            register-module(type)

────────────────────
+ machine-receiver TypeId
    - machine MachineFact

` The class whose object a machine a property holds, or the class's content writes, is
` written for: that of the receiver of the instance it is written in.
if unit != no-instance then instances.rows[unit].self-type else no-type

.. unit = instances.rows[machine.instance].enclosing

────────────────────
+ do machine-classes [TypeId]
    - machine MachineFact

` The classes the program constructs whose objects run a machine, by rank: the class it is
` written for, and where a property of that class holds it, each class below, which starts the
` same machine (`find-unit`) or one that refines it, as each does where the class's markup
` writes it, whose filler the filler of each class below runs.
. type = machine-receiver(machine)
. found [TypeId]
if type == no-type
    = found
if machine.store != .store-member && machine.store != .store-content
    if constructed[type] != 0
        found += type
    = found
for class in types.ranked
    if constructed[class] != 0 && is-class(class) && (class == type || derives(class, type))
        found += class
= found

────────────────────
+ do constructs-from Bool
    - type TypeId

` Whether the program constructs a class that is a type or derives from it.
for class in types.ranked
    if constructed[class] != 0 && is-class(class) && (class == type || derives(class, type))
        = true
= false

────────────────────
+ do refining-classes [TypeId]
    - machine MachineFact

` The classes the program constructs whose objects run a machine that refines a machine written
` as a line of a class's markup, directly or through others, by rank: the class each refining
` machine is written for and each class below it. Their objects start the machine with the one
` that refines it, and not where the markup of the machine's class runs.
. found [TypeId]
if machine.store != .store-content || machine.outer != 0
    = found
. receivers [TypeId]
for fact in facts.machines
    if fact.store != .store-content || fact.outer != 0 || fact.refined == no-instance
        continue
    . current MachineFact? = facts.machine-of(fact.refined)
    while current && current.instance != machine.instance
        current = facts.machine-of(current.refined) if current.refined != no-instance
    . type = machine-receiver(fact)
    if current && type != no-type && receivers.find(type) == null
        receivers += type
if receivers.length == 0
    = found
for class in types.ranked
    if constructed[class] == 0 || !is-class(class)
        continue
    for type in receivers
        if class == type || derives(class, type)
            found += class
            break
= found

────────────────────
+ do leaf-classes [TypeId]
    - machine MachineFact

` The classes the program constructs whose objects start a machine a property of a class holds,
` by rank: the class it is written for and each class below that declares the property no value
` of its own (`find-unit`).
. type = machine-receiver(machine)
. found [TypeId]
. name Atom? = null
do match? program.modules[machine.module].decls[machine.decl]
    | .decl-property(row)
        name = row.name
if type == no-type || machine.store != .store-member || !name
    = found
for class in types.ranked
    if constructed[class] != 0 && is-class(class) && declaring(class, name) == type
        found += class
= found

────────────────────
_ do first-constructor InstanceId
    - type TypeId

` The first constructor of a class that the program emits, by rank. Those of every class are
` found together the first time one is asked for.
if !constructors-found
    constructors-found = true
    for instance in instances.ordered
        if instance-functions[instance] == no-function
            continue
        . row = instances.rows[instance]
        do match? program.modules[row.module].decls[row.decl]
            | .decl-function(fn)
                if constructs(fn.kind) && first-constructors[row.self-type] == null
                    first-constructors[row.self-type] = instance
. found = first-constructors[type]
= if found then found as InstanceId else no-instance

────────────────────
+ do init-constructor InstanceId
    - module ModuleId

` The constructor of the class whose sections the init of a module puts last in the event
` runtime's tables, or none.
for place in 0 .. < registered-modules.length
    if registered-modules[place] == module
        = registered-constructors[place]
= no-instance

────────────────────
_ do declare-idle-action

` The function the live action that owns a subscription or the endpoint at the address of a
` keyed event calls, which does nothing, made once for a program where an object owns one. It
` is placed at the subscription, or where there is none the claim, of the instance first by
` rank, and the first of its places, so the place is the same however the instances were typed.
. owned = facts.owned-subscriptions.length != 0
if !owned && facts.address-claims.length == 0
    =
. best = U64.max
if owned
    for row in facts.owned-subscriptions
        . key = ((instances.rank-of(row.instance) as U64) /lshift/ 32) /or/ (row.site as U64)
        if key < best
            best = key
            idle-instance = row.instance
            idle-site = row.site
else
    for row in facts.address-claims
        . key = ((instances.rank-of(row.instance) as U64) /lshift/ 32) /or/ (row.site as U64)
        if key < best
            best = key
            idle-instance = row.instance
            idle-site = row.site
idle-action = functions.length as FunctionId
functions.append
    - unnamed-function(.idle-action, no-instance, instances.rows[idle-instance].module, 4)

────────────────────
_ do class-rule U32
    - level TypeId
    - module ModuleId
    - decl DeclId
    - syntax SyntaxId

` The row of a rule typed for a class, made once.
. unit = instances.find-initializer(module, decl, level)
if unit != no-instance
    . found = class-rule-rows[unit]
    if found
        = found
. index U32 = class-rules.length as U32
. updater = no-function
. reruns = rule-pass(module, syntax) == 2
. iterator SyntaxId = 0
do match? program.modules[module].tree.nodes[syntax]
    | .node-subscriber-syntax(section)
        iterator = section.iterator
. rebinds = unit != no-instance && iterator != 0 && facts.rebinds-section(level, module, iterator)
if unit != no-instance && (reruns || rebinds)
    updater = functions.length as FunctionId
    functions.append(unnamed-function(.class-rule-updater, no-instance, module, 8))
    functions[updater].type = level
    functions[updater].place = index
    functions[updater].may-panic = true
    declare-live-adapter(updater)
. trigger = facts.markup-trigger-of(unit) if unit != no-instance
. add = no-function
. remove = no-function
if trigger
    add = trigger-function(if trigger.target-id == 0 then .markup-trigger-ancestor else FunctionKind.markup-trigger-add, level, module, index)
    if trigger.target-id != 0
        remove = trigger-function(.markup-trigger-remove, level, module, index)
if unit != no-instance
    class-rule-rows[unit] = index
. kept = if rebinds then section-kept(level, unit, iterator) else class-rule-kept(level, module, syntax, unit)
class-rules.append(ClassRule(level, module, decl, syntax, unit, kept, updater, add, remove))
= index

────────────────────
_ do section-kept LayoutId
    - level TypeId
    - unit InstanceId
    - iterator SyntaxId

` What a section subscribed again as a branch of the markup makes an element again keeps for
` each object it runs on: the object, then the closure its loop subscribes, made once, as the
` conversion recorded where it is made a `Subscriber` gives it.
. closure = no-type
. scan = facts.first-conversion(unit, iterator)
while scan != no-fact && closure == no-type
    . row = facts.conversions[scan]
    if row.reason == .reason-argument && typed && types.intrinsic-of(row.from) == .closure
        closure = row.from
    .. typed = row.from != no-type && row.from != invalid-type
    scan = row.next
if closure == no-type
    = no-layout
. children [LayoutId]
. held [TypeId]
children += managed-layout
held += level
children += managed-layout
held += closure
= layouts.environment(children, held, "section.${hex-text(instances.stable-keys[unit])}")

────────────────────
_ do trigger-function FunctionId
    - kind FunctionKind
    - level TypeId
    - module ModuleId
    - index U32

` A function the markup runtime calls for a `whenever` rule on the markup an object is in,
` given what the rule keeps for the object, which may panic, as running the rule's action may.
. id FunctionId = functions.length as FunctionId
functions.append(unnamed-function(kind, no-instance, module, 8))
functions[id].type = level
functions[id].place = index
functions[id].may-panic = true
= id

────────────────────
_ do class-rule-kept LayoutId
    - level TypeId
    - module ModuleId
    - syntax SyntaxId
    - unit InstanceId

` What a rule keeps for each object it runs on: the object, then for a `whenever` rule the
` value it had when it last ran. A `whenever` rule on the
` markup an object is in keeps whether it has changed since its action last ran, the action,
` the object as its markup host, then the changes it names, if any, and for an ancestor the
` one it last found. A value with no layout yet keeps nothing, and neither does a dependency
` or a section.
if unit == no-instance || rule-pass(module, syntax) != 2
    = no-layout
. children [LayoutId]
. held [TypeId]
children += managed-layout
held += level
. trigger = facts.markup-trigger-of(unit)
if trigger
    . found = trigger
    . previous = found.found
    children += u8-layout
    held += no-type
    children += managed-layout
    held += types.live-action-type
    children += layouts.values[found.host]
    held += found.host
    if found.changes != no-type
        children += managed-layout
        held += found.changes
    if previous != no-type
        children += layouts.values[previous]
        held += previous
    if children.find(no-layout) != null
        = no-layout
    = layouts.environment(children, held, "rule.${hex-text(instances.stable-keys[unit])}")
do match? program.modules[module].tree.nodes[syntax]
    | .node-whenever-rule-syntax(rule)
        . value = facts.node-type(unit, rule.expr)
        if value == no-type || value == invalid-type || layouts.values[value] == no-layout
            = no-layout
        children += layouts.values[value]
        held += value
= layouts.environment(children, held, "rule.${hex-text(instances.stable-keys[unit])}")

────────────────────
+ class-rules-of [U32]
    - type TypeId

` The rules a constructor of a class runs once its body has run, in order, as rows of
` `class-rules`.
rules-from(class-rule-heads[type])

────────────────────
+ first-application U32
    - instance InstanceId

` The place in `Facts.style-applications` of the first application of a style rule an instance
` makes, or `U32.max`.
application-heads[instance] ?? U32.max

────────────────────
+ next-application U32
    - place U32

` The place of the application of a style rule the instance of one makes after it, or `U32.max`.
application-links[place]

────────────────────
+ markup-rules-of [U32]
    - type TypeId

` The rules the function that fills an object with the markup of a class runs once that markup
` has, in order, as rows of `class-rules`.
rules-from(markup-rule-heads[type])

────────────────────
_ do rules-from [U32]
    - head U32?

` The rows of `class-rules` listed in `class-rule-order` from a place up to `U32.max`.
. order [U32]
if !head
    = order
. cursor = head
while class-rule-order[cursor] != U32.max
    order += class-rule-order[cursor]
    cursor += 1
= order

────────────────────
+ updater-of FunctionId
    - place U32

` The function that evaluates again the value of a property that reads something tracked, by
` the property's place among all of them, or none.
if place < default-count then updater-functions[place] else no-function

────────────────────
_ do declare-globals

` Gives every global of every module its kind, and storage to each the type pass typed: a symbol for
` its value, a byte of state beside one that is not a constant, and a root record when it holds
` managed pointers. Which are constants is a fact of the type pass, which checks no read of one; a
` value no instance typed is a constant when it is a literal. Notes for each module whether it
` stores constants, whether values of its globals run as it starts, and whether those may panic. A
` value no instance typed is one nothing reads: it is evaluated for what it does when its module
` starts, and is taken to panic when it calls anything.
. module-count = program.modules.length
storage-starts = arena.allocate'U32(module-count + 1)
module-flags = arena.allocate'Byte(module-count + 1)
module-defaults = arena.allocate'U32(module-count + 1)
default-tails = arena.allocate'U32(module-count + 1)
task-local-heads = arena.allocate'U32(module-count + 1)
task-local-tails = arena.allocate'U32(module-count + 1)
. total U32
for module in 0 .. < module-count
    storage-starts[module] = total
    module-flags[module] = 0
    module-defaults[module] = no-storage
    default-tails[module] = no-storage
    task-local-heads[module] = no-storage
    task-local-tails[module] = no-storage
    total += program.modules[module].decls.length as U32
storage-rows = arena.allocate'U32(total + 1)
global-kinds = arena.allocate'Byte(total + 1)
local-firsts = arena.allocate'U32(total + 1)
for position in 0 .. < total
    storage-rows[position] = no-storage
    global-kinds[position] = 0
    local-firsts[position] = U32.max
for position in 0 .. < facts.local-global-uses.length
    . use = facts.local-global-uses[position]
    . place = storage-starts[use.module] + use.decl
    if local-firsts[place] == U32.max
        local-firsts[place] = position as U32
for constant in facts.constant-globals
    global-kinds[storage-starts[constant.module] + constant.decl] = GlobalKind.global-constant
for module in 0 .. < module-count
    . owner = program.modules[module]
    for index in 0 .. < owner.decls.length
        do match? owner.decls[index]
            | .decl-property(property)
                if property.owner == 0 && !literal
                    declare-global(module as ModuleId, index as DeclId, property)
                .. literal = types.is-literal-global(module as ModuleId, index as DeclId)
for unit in instances.ordered
    . row = instances.rows[unit]
    if row.initializer != 0 && row.state == .instance-done
        do match? program.modules[row.module].decls[row.initializer]
            | .decl-case(case)
                declare-enum-value(row.module, row.initializer, unit, case)
for machine in facts.machines
    if machine.store == .store-global
        declare-machine-global(machine)
task-local-order = order-locals(false)
thread-local-order = order-locals(true)
for row in task-local-order
    . module = storage[row].module
    if task-local-tails[module] == no-storage
        task-local-heads[module] = row
    else
        storage[task-local-tails[module]].next = row
    task-local-tails[module] = row
task-local-size = lay-locals(task-local-rows, "tasklocal", .task-local-root, task-local-size)
thread-local-size = lay-locals
    - thread-local-rows
    - "threadlocal"
    - .thread-local-root
    - thread-local-size

────────────────────
_ do declare-enum-value
    - module ModuleId
    - decl DeclId
    - unit InstanceId
    - case CaseDecl

` Gives storage to a value of an enum the type pass typed, which is not made until an
` emitted function reads it. A value typed for more than one enum, as one of a class with
` type parameters is, is kept in no way here.
. place = storage-starts[module] + decl
if global-kinds[place] != 0
    global-kinds[place] = GlobalKind.global-other
    =
global-kinds[place] = GlobalKind.global-other
. type = instances.signatures[unit].returns
. layout = no-layout
if type != no-type && type != invalid-type
    layout = layouts.values[type]
. kept = layout != no-layout && layout != void-layout
if kept && layouts.rows[layout].is-managed && layouts.rows[layout].descriptor == no-string
    kept = false
if !kept || !case.name
    =
. case-name = case.name
global-kinds[place] = GlobalKind.global-enum-unread
. flags = module-flags[module] /or/ has-statics
if instances.rows[unit].may-panic
    flags = flags /or/ statics-panic
module-flags[module] = flags
. key = "${program.modules[module].name}:enum:$decl:${case-name.text}"
storage-rows[place] = storage.length as U32
keep
    - GlobalStorage
        - module
        - decl
        - 0
        - no-instance
        - bundle.intern(symbol-name(program.target, key))
        - no-string
        - type
        - layout
        - no-function
        - no-storage

────────────────────
_ do declare-machine-global
    - machine MachineFact

` A machine a module's property is gives the module a global that holds its environment,
` where a case test anywhere in the module reads a case's flag; none until it starts. It is
` the storage of the machine's own declaration.
. decl = instances.rows[machine.instance].decl
. place = storage-starts[machine.module] + decl
global-kinds[place] = GlobalKind.global-other
storage-rows[place] = storage.length as U32
. key = "${program.modules[machine.module].name}:state-machine.${machine.syntax}"
keep
    - GlobalStorage
        - machine.module
        - decl
        - machine.syntax
        - no-instance
        - bundle.intern(symbol-name(program.target, key))
        - no-string
        - no-type
        - managed-layout
        - no-function
        - no-storage

────────────────────
_ do declare-global
    - module ModuleId
    - decl DeclId
    - property PropertyDecl

. owner = program.modules[module]
. place = storage-starts[module] + decl
if property.decoration != null || !property.name
    global-kinds[place] = GlobalKind.global-other
    if property.name && property.decoration != null
        . decoration = property.decoration.text
        if decoration == "task"
            declare-local(module, decl, property, .global-task)
        else if decoration == "thread"
            declare-local(module, decl, property, .global-thread)
        else if decoration == "stack"
            declare-local(module, decl, property, .global-stack)
    =
. property-name = property.name
. main = main-instances[module]
. unit = instances.find-initializer(module, decl, no-type)
. type = no-type
if unit != no-instance && instances.rows[unit].state == .instance-done
    type = instances.signatures[unit].returns
. kind = GlobalKind.global-eager
if property.is-lazy
    kind = .global-lazy
else if global-kinds[place] == GlobalKind.global-constant
    kind = .global-constant
global-kinds[place] = kind
. layout = no-layout
if type != no-type && type != invalid-type
    layout = layouts.values[type]
. kept = layout != no-layout && layout != void-layout
if kept && layouts.rows[layout].is-managed && layouts.rows[layout].descriptor == no-string
    kept = false
. flags = module-flags[module]
if kind == .global-constant && kept && property.value != 0
    flags = flags /or/ has-constants
if kind == .global-eager && (property.value != 0 || kept)
    flags = flags /or/ has-globals
    . raises = if unit != no-instance then (instances.rows[unit].may-panic || failing) else calls
        .. failing = instances.signatures[unit].errors.count != 0
        .. calls = calls-within(main, owner.tree, property.syntax)
    if raises
        flags = flags /or/ globals-raise
module-flags[module] = flags
if !kept
    =
. key = "${owner.name}:${property-name.text}"
. state = no-string
if kind != .global-constant
    state = bundle.intern(symbol-name(program.target, "${key}.state"))
storage-rows[place] = storage.length as U32
keep
    - GlobalStorage
        - module
        - decl
        - 0
        - no-instance
        - bundle.intern(symbol-name(program.target, key))
        - state
        - type
        - layout
        - no-function
        - no-storage

────────────────────
_ do declare-local
    - module ModuleId
    - decl DeclId
    - property PropertyDecl
    - kind GlobalKind

` Gives a global each task, or each thread, holds its own of a place in the memory of every
` task or thread, and a function that stores its first value there: the value written, or
` with none the first value of its type, which for a named tuple or struct is made from its
` fields. One `do with` binds has a slot in the memory of every task, `{bound, value}`, and a
` function only where a value is written, which binds it. Only one a function uses is kept,
` as TypeScript makes the value of one where it first compiles a use; one the type pass
` typed, whose value lets no error out, and that the collector can describe where it holds
` managed pointers. A panic while the first value of one each thread holds is made is
` reported by `threadinit`, which ends the process. Its unit is kept as its `owner`.
. place = storage-starts[module] + decl
if local-firsts[place] == U32.max
    =
. per-thread = kind == .global-thread
. unit = instances.find-initializer(module, decl, no-type)
if unit == no-instance || instances.rows[unit].state != .instance-done || raises
    =
.. raises = instances.signatures[unit].errors.count != 0
. type = instances.signatures[unit].returns
if type == no-type || type == invalid-type
    =
. layout = layouts.values[type]
if layout == no-layout || layout == void-layout
    =
if layouts.rows[layout].is-managed && layouts.rows[layout].descriptor == no-string
    =
. function = pending-function
if kind == .global-stack
    . children [LayoutId]
    . held [TypeId]
    children += layouts.values[types.bool-type]
    children += layout
    held += types.bool-type
    held += type
    layout = layouts.environment(children, held, "stack-local.${module}.${decl}")
    if property.value == 0
        function = no-function
. alignment = layouts.rows[layout].alignment
. size = if per-thread then thread-local-size else task-local-size
. offset U32 = (((size as U32) + alignment - 1) / alignment) * alignment
size = offset + layouts.rows[layout].size
storage-rows[place] = storage.length as U32
storage.append
    - GlobalStorage
        - module
        - decl
        - 0
        - unit
        - no-string
        - no-string
        - type
        - layout
        - function
        - no-storage
        - offset
        - per-thread
module-flags[module] = module-flags[module] /or/ has-locals
global-kinds[place] = kind
if per-thread
    thread-local-size = size
    thread-local-rows += (storage.length - 1) as U32
    if instances.rows[unit].may-panic
        thread-locals-panic = true
    =
task-local-size = size
task-local-rows += (storage.length - 1) as U32
if function != no-function && instances.rows[unit].may-panic
    module-flags[module] = module-flags[module] /or/ locals-raise

────────────────────
_ do order-locals [U32]
    - per-thread Bool

` Orders the functions that give the globals each task, or each thread, holds its own of
` their first values: by the order their modules initialize in, and within a module in the
` order they are declared. Those that bind a global `do with` binds are among those of tasks.
. module-count = program.modules.length
. visited = arena.allocate'Byte(module-count + 1)
for module in 0 .. < module-count
    visited[module] = 0
. order [U32]
. init-order = program.init-order
for position in 0 .. < init-order.length
    . module = init-order[position] as ModuleId
    if visited[module] == 0
        visited[module] = 1
        order ++= module-locals(module, per-thread)
for module in 0 .. < module-count
    if visited[module] == 0
        order ++= module-locals(module as ModuleId, per-thread)
= order

────────────────────
_ do module-locals [U32]
    - module ModuleId
    - per-thread Bool

` The globals of a module each task, or each thread, holds its own of whose first values a
` function stores, in the order they are declared. Every task of a batch makes the values of
` every case, so one whose value runs code refuses it unless every case reaches its module.
. rows [U32]
. start = storage-starts[module]
. decls = program.modules[module].decls
for decl in 0 .. < decls.length
    . place = start + (decl as U32)
    . row = storage-rows[place]
    if row == no-storage || storage[row].function == no-function
        continue
    . kind = global-kinds[place] as GlobalKind
    if (kind == .global-thread) != per-thread || not-local
        continue
    .. not-local = kind != .global-thread && kind != .global-task && kind != .global-stack
    rows += row
    if makes-value(row) && !in-every-case(module)
        do match? decls[decl]
            | .decl-property(property)
                refusals.append(Refusal(.refused-batch-local, module, property.syntax))
= rows

────────────────────
_ do in-every-case Bool
    - module ModuleId

` Whether every case of a batch reaches a module, which is so of each module of a program that is
` not one: every task of a batch makes the first values of the globals each holds its own of.
. starts = program.batch-order-starts
for root in 0 .. < program.batch-roots.length
    . found = false
    for position in starts[root] .. < starts[root + 1]
        if program.batch-order-modules[position] == module
            found = true
            break
    if !found
        = false
= true

────────────────────
_ do makes-value Bool
    - row U32

` Whether making the first value of a global each task or thread holds can be seen: its
` value calls something, or reads such a global, which must have its own value first.
. kept = storage[row]
for use in facts.local-global-uses
    if use.instance == kept.owner
        = true
do match? program.modules[kept.module].decls[kept.decl]
    | .decl-property(property)
        = runs-code(program.modules[kept.module].tree, main-instances[kept.module], property)
= false

────────────────────
_ do lay-locals I64
    - rows [U32]
    - name String
    - kind GCRootKind
    - size I64

` Lays out the memory of a task's or a thread's locals, at the offsets given them, and gives
` its size. Where they hold managed pointers, it is described to the collector, which reads
` it in every task or thread.
. children [LayoutId]
. held [TypeId]
for row in rows
    children += storage[row].layout
    held += if on-stack then no-type else storage[row].type
    .. on-stack = global-kind(storage[row].module, storage[row].decl) == .global-stack
if children.length == 0
    = size
. layout = layouts.environment(children, held, name)
if layouts.rows[layout].is-managed
    layouts.add-descriptor(layout)
    bundle.gc-roots.append(GCRootRecord(kind, no-string, layouts.rows[layout].descriptor))
= layouts.rows[layout].size

────────────────────
_ do keep
    - row GlobalStorage

` Adds storage to the object: its symbols, and a root record when it holds managed pointers.
. layout = layouts.rows[row.layout]
bundle.globals.append(GlobalData(row.symbol, layout.size, layout.alignment))
if row.state != no-string
    bundle.globals.append(GlobalData(row.state, 1, 1))
if layout.is-managed
    layouts.add-descriptor(row.layout)
    bundle.gc-roots.append(GCRootRecord(.global-root, row.symbol, layout.descriptor))
storage.append(row)

────────────────────
_ do calls-within Bool
    - main InstanceId
    - tree AST
    - site SyntaxId

for node in tree.subtree-start(site) .. < site + 1
    if facts.first-call(main, node) != no-fact
        = true
= false

────────────────────
_ do defaults-raise Bool
    - kinds CPointer'U32

` Whether a default that runs code may panic: one of an emitted instance the type pass says
` may panic, which says so of a function for what its defaults call too.
for instance in 0 .. < instances.length
    if (kinds[instance] == Reach.body || kinds[instance] == Reach.initializer) && panics
        if first-code-default(instance as InstanceId, 0) != no-storage
            = true
    .. panics = instances.rows[instance].may-panic
= false

────────────────────
_ do first-code-default U32
    - instance InstanceId
    - start U32

` The position of the first parameter from `start` on whose default runs code, of an
` instance of a function written in source, or none. A default no call takes, which the type
` pass did not type, is none.
. row = instances.rows[instance]
. owner = program.modules[row.module]
do match? owner.decls[row.decl]
    | .decl-function(fn)
        if fn.is-generated
            = no-storage
        for position in start .. < fn.args.count
            . syntax = owner.arg-pool[fn.args.start + position].default-syntax
            . typed = instances.default-typed(instance, position)
            if syntax != 0 && typed && default-runs-code(instance, syntax)
                = position
= no-storage

────────────────────
+ default-runs-code Bool
    - instance InstanceId
    - syntax SyntaxId

` Whether the default of a parameter of an instance runs code: any but a constant, and a
` constant too where the type pass recorded a call for it, as it does for a number written
` with a unit whose class declares a constructor.
!is-literal-value(types, owner.tree, syntax) || facts.first-call(instance, syntax) != no-fact

.. owner = program.modules[instances.rows[instance].module]

────────────────────
+ is-called-default Bool
    - instance InstanceId
    - syntax SyntaxId

` Whether a call that leaves a parameter out evaluates its default there, by a function of
` the default's own, as TypeScript does for a default that runs code and is no constant.
default-runs-code(instance, syntax) && !is-constant-default(instance, owner.tree, syntax)

.. owner = program.modules[instances.rows[instance].module]

────────────────────
_ do is-constant-default Bool
    - instance InstanceId
    - source AST
    - syntax SyntaxId

` Whether a default is a constant as TypeScript tells one: a number, a text, a symbol, a truth,
` null, an operator on one of those, or a value of an enum or a case of a union named on its
` type.
do match? source.nodes[syntax]
    | .node-integer-syntax
        = true
    | .node-float-syntax
        = true
    | .node-string-syntax
        = true
    | .node-symbol
        = true
    | .node-identifier(row)
        = row.name == types.true-atom || row.name == types.false-atom || row.name == types.null-atom
    | .node-unary-expression(row)
        = is-constant-default(instance, source, row.operand)
    | .node-get-expression(row)
        if row.is-tracked || row.is-optional || !is-type-syntax(source, row.object)
            = false
        . plan = facts.plan-of(instance, syntax)
        = plan == .plan-case || plan == .plan-enum-value
= false

────────────────────
_ do declare-defaults
    - kinds CPointer'U32

` Gives storage to each default that runs code, of each emitted instance. A constant one is
` evaluated once by its module as it starts, after the values of its globals, and a call that
` leaves the argument out reads it; the defaults of a module are evaluated in the order of
` rank, which is the order their functions are declared in. Any other is evaluated by a
` function of its own, which each call that leaves the argument out calls, and has no memory.
` A default whose value is nothing is evaluated too, and kept nowhere. A default whose value
` has no layout refuses the program.
. count = instances.length
default-starts = arena.allocate'U32(count + 1)
for instance in 0 .. < count
    default-starts[instance] = no-storage
for instance in instances.ranked
    if kinds[instance] != Reach.body && kinds[instance] != Reach.initializer
        continue
    . position = first-code-default(instance, 0)
    while position != no-storage
        declare-default(instance, position)
        position = first-code-default(instance, position + 1)

────────────────────
_ do declare-default
    - instance InstanceId
    - position U32

. row = instances.rows[instance]
. owner = program.modules[row.module]
. syntax SyntaxId = 0
do match? owner.decls[row.decl]
    | .decl-function(fn)
        syntax = owner.arg-pool[fn.args.start + position].default-syntax
. type = facts.node-type(instance, syntax)
. layout = no-layout
if type != no-type && type != invalid-type
    layout = layouts.values[type]
. kept = layout != no-layout
if kept && layouts.rows[layout].is-managed && layouts.rows[layout].descriptor == no-string
    kept = false
if !kept
    refusals.append(Refusal(.refused-expression, row.module, syntax))
    =
. key = "${instance-display(instance)}.${stable-text}.default.${position}"
    .. stable-text = hex-text(instances.stable-keys[instance])
. index U32 = storage.length as U32
if default-starts[instance] == no-storage
    default-starts[instance] = index
if is-called-default(instance, syntax)
    storage.append
        - GlobalStorage
            - row.module
            - 0
            - syntax
            - instance
            - bundle.intern(symbol-name(program.target, key))
            - no-string
            - type
            - layout
            - pending-function
            - no-storage
    =
. held = GlobalStorage
    - row.module
    - 0
    - syntax
    - instance
    - bundle.intern(symbol-name(program.target, key))
    - no-string
    - type
    - layout
    - no-function
    - no-storage
if layout == void-layout
    storage.append(held)
else
    keep(held)
if default-tails[row.module] == no-storage
    module-defaults[row.module] = index
else
    storage[default-tails[row.module]].next = index
default-tails[row.module] = index
module-flags[row.module] = module-flags[row.module] /or/ has-statics
if row.may-panic
    module-flags[row.module] = module-flags[row.module] /or/ statics-panic

────────────────────
+ storage-of U32
    - module ModuleId
    - decl DeclId

` The storage of a global, or none for one the type pass typed no value of.
storage-rows[storage-starts[module] + decl]

────────────────────
+ global-kind GlobalKind
    - module ModuleId
    - decl DeclId

global-kinds[storage-starts[module] + decl] as GlobalKind

────────────────────
+ do default-storage U32
    - callee InstanceId
    - syntax SyntaxId

` The storage of a default that runs code, by the instance whose parameter it is and the
` default written, or none.
. row = default-starts[callee]
while row != no-storage && row < storage.length && storage[row].owner == callee
    if storage[row].syntax == syntax
        = row
    row += 1
= no-storage

────────────────────
+ first-default U32
    - module ModuleId

` The first default a module evaluates as it starts, or none.
module-defaults[module]

────────────────────
_ do default-name String
    - row GlobalStorage

` The name of the parameter whose default a row keeps.
. owner = instances.rows[row.owner]
. module = program.modules[owner.module]
do match? module.decls[owner.decl]
    | .decl-function(fn)
        for position in 0 .. < fn.args.count
            . shape = module.arg-pool[fn.args.start + position]
            if shape.default-syntax == row.syntax
                . name = shape.name
                = if name then name.text else ""
= ""

────────────────────
+ do global-name String
    - row GlobalStorage

` The name a global is written with.
do match? program.modules[row.module].decls[row.decl]
    | .decl-property(property)
        if property.name
            = property.name.text
= ""

────────────────────
_ do class-module ModuleId
    - type TypeId

do match? types.rows[type]
    | .type-class(row)
        = row.module
= 0

────────────────────
_ do member-of DeclId
    - type TypeId
    - name Atom

` The declaration of a property a class itself writes, by its name, or none.
do match? types.rows[type]
    | .type-class(row)
        . owner = program.modules[row.module]
        do match? owner.decls[row.decl]
            | .decl-class(class)
                . place = owner.first-member(class.members, name)
                while place != no-member
                    . member = owner.member-pool[place]
                    place = owner.member-links[place]
                    do match? owner.decls[member]
                        | .decl-property(property)
                            if property.name && property.name == name
                                = member
= 0

────────────────────
_ do declaring TypeId
    - type TypeId
    - name Atom

` The nearest class, from a class up through its bases, that itself writes a property.
. current = type
while current != no-type
    if member-of(current, name) != 0
        = current
    current = types.completions[current].base
= no-type

────────────────────
_ place-of U32
    - type TypeId
    - name Atom

` The place among all properties of a type's property of a name, or none.
if found then found as U32 else U32.max

.. found = types.property-named(type, name)

────────────────────
_ do note-lazy-result
    - root U32
    - entry FunctionId

` Keeps that the slot of a lazy property holds a function, and what the functions in it
` answer: where its value lets out errors, the value or one of them, alike for each function,
` and else `invalid-type`.
if entry == no-function
    =
lazy-written[root] = 1
. given = lazy-function-result(functions[entry].place)
if lazy-results[root] == U32.max
    lazy-results[root] = given
else if lazy-results[root] != given
    lazy-results[root] = invalid-type

────────────────────
+ lazy-function-result TypeId
    - place U32

` What the function of a lazy property, by the place it has, answers where the value it
` evaluates lets out errors: the value or one of them. No type where the value lets out none.
|? unit == no-instance || instances.signatures[unit].errors.count == 0
    no-type
??
    instances.signatures[unit].result

.. unit = value-units[place]

────────────────────
+ lazy-result TypeId
    - place U32

` What a read of a lazy property through its slot answers where the value some class writes
` for it lets out errors (see `note-lazy-result`), or no type where none does.
|? lazy-roots[place] == U32.max || lazy-results[lazy-roots[place]] == U32.max
    no-type
??
    lazy-results[lazy-roots[place]]

────────────────────
+ lazy-raises Bool
    - place U32

` Whether a read of a lazy property through its slot may panic: the value some class writes
` for it may.
lazy-roots[place] != U32.max && lazy-raising[lazy-roots[place]] != 0

────────────────────
+ lazy-runs Bool
    - place U32

` Whether a read of a lazy property through its slot may run: the slot holds a function in
` some table, as some class the program constructs an object of has the property.
lazy-roots[place] != U32.max && lazy-written[lazy-roots[place]] != 0

────────────────────
_ do reach
    - kinds CPointer'U32

` Marks every instance the emitted functions call or convert through. Each emitted instance is
` visited once, when it joins the set, and only its own facts are read. The values a module
` gives its globals as it starts are read with them. An override joins when
` the function it replaces is emitted and a constructor of its class is: it is looked at when
` the first is visited and when the second is first seen, and at no other time. The values
` the first case of a union writes are read with any table of it, whose rows start as that case
` and read as it where their tag names none.
. count U32 = instances.length as U32
constructed = arena.allocate'Byte(types.rows.length + 1)
for type in 0 .. < types.rows.length
    constructed[type] = 0
index-loose(count)
index-overrides(count)
index-visits(count)
for instance in instances.ordered
    if kinds[instance] != Reach.none && kinds[instance] != Reach.body
        reach-queue[reach-length] = instance
        reach-length += 1
for module in 0 .. < program.modules.length
    if (module-flags[module] /and/ (has-globals /or/ has-locals)) != 0
        reach-globals(kinds, module as ModuleId)
for type in types.ranked
    . union = row-union(types, type as TypeId)
    if union != no-type && types.cases-of(union).length != 0
        reach-values(kinds, types.cases-of(union)[0].type)
drain(kinds)

────────────────────
_ do settle-events
    - kinds CPointer'U32

` Settles which events are live, as the reference does, and numbers them in the order they are
` first used, the uses taken in the order `use-order` gives them rather than the one typing
` reached them in. An event is live where an emitted function makes it a `Broadcastable`, or
` where one publishes to it and one subscribes to it. The subscriber of a loop on an event counts
` for neither until that event is live. An event that is not live is never touched: a write
` to it, and a loop on it, evaluate only the object. The first publish an emitted function writes
` is where the counts of events are declared, and those it writes to an event that is not live, or
` that a function not active writes, are counted as erased, as the reference counts the sites it
` erases.
. count = instances.length
. active = arena.allocate'Byte(count + 1)
for position in 0 .. < count
    active[position] = if kinds[position] != Reach.none then 1 else 0
. uses [U32]
for index in 0 .. < facts.event-uses.length
    uses += index as U32
. ordered-uses = sort(uses) • using :: a, b => use-order(a, b)
for index in ordered-uses
    . used = facts.event-uses[index]
    if used.callback != no-instance
        active[used.callback] = 0
    if kinds[used.instance] != Reach.none && event-index(used.owner, used.name) == U32.max
        event-owners += used.owner
        event-names += used.name
        event-numbers += U32.max
. live [Bool]
for _ in 0 .. < event-owners.length
    live += false
. changed = true
while changed
    changed = false
    for index in 0 .. < event-owners.length
        . escapes = false
        . publishes = false
        . hears = false
        for used in facts.event-uses
            if active[used.instance] != 0 && of-event
                escapes = escapes || used.kind == .event-escape
                publishes = publishes || used.kind == .event-publish || used.kind == .event-route
                hears = hears || used.kind == .event-subscribe
            .. of-event = used.owner == event-owners[index] && used.name == event-names[index]
        if !live[index] && (escapes || (publishes && hears))
            live[index] = true
            changed = true
        if !live[index]
            continue
        for used in facts.event-uses
            if used.kind == .event-subscribe && active[used.instance] != 0 && same-event
                if used.callback != no-instance && callback-reached && active[used.callback] == 0
                    active[used.callback] = 1
                    changed = true
                .. callback-reached = kinds[used.callback] != Reach.none
            .. same-event = used.owner == event-owners[index] && used.name == event-names[index]
. number U32
for index in 0 .. < event-owners.length
    if live[index]
        event-numbers[index] = number
        number += 1
for index in ordered-uses
    . used = facts.event-uses[index]
    if (used.kind == .event-publish || used.kind == .event-route) && reached
        if event-site-instance == no-instance
            event-site-instance = used.instance
            event-site = used.site
        . event = event-index(used.owner, used.name)
        if event == U32.max || !live[event] || active[used.instance] == 0
            erased-publishes += 1
    .. reached = kinds[used.instance] != Reach.none

────────────────────
_ use-order Comparison
    - row U32
    - other U32

` Orders two uses of events by the stable keys of their instances, then by site and by the node
` that names the event.
|? placed != Comparison.equal
    placed
??
    ordered(used.reference, against.reference)

.. used = facts.event-uses[row]
.. against = facts.event-uses[other]
.. placed = line-order(used.instance, used.site, against.instance, against.site)

────────────────────
_ do event-index U32
    - owner TypeId
    - name Atom

for index in 0 .. < event-owners.length
    if event-owners[index] == owner && event-names[index] == name
        = index as U32
= U32.max

────────────────────
+ event-number U32
    - owner TypeId
    - name Atom

` The number the event runtime knows a live event by, or `U32.max` for one that is not live.
if index != U32.max then event-numbers[index] else U32.max

.. index = event-index(owner, name)

────────────────────
_ do reach-globals
    - kinds CPointer'U32
    - module ModuleId

` Marks what the values of a module's globals call as the module starts, and the first
` values of those each task holds its own of.
. owner = program.modules[module]
for index in 0 .. < owner.decls.length
    . kind = global-kind(module, index as DeclId)
    if eager || kind == .global-task || kind == .global-thread || kind == .global-stack
        do match? owner.decls[index]
            | .decl-property(property)
                reach-site(kinds, module, property.syntax)
    .. eager = kind == .global-eager

────────────────────
_ do drain
    - kinds CPointer'U32

` Visits the instances that joined the emitted set since the last visit, and those the
` witness tables they reach bring, until there are no more.
while true
    while reach-next < reach-length
        visit(kinds, reach-queue[reach-next])
        reach-next += 1
    if observes && deferred-next < deferred-instances.length
        visit-gates(kinds)
        continue
    if !fill-witnesses(kinds)
        =

────────────────────
_ do reach-report
    - kinds CPointer'U32

` Adds what the report of an unhandled panic calls to the emitted set.
. report = instances.report
mark(kinds, report.message)
mark(kinds, report.source-text)
mark(kinds, report.source)

────────────────────
_ do reach-live
    - kinds CPointer'U32

` Adds what tracked values run through to the emitted set, where some value does, what the
` subscriptions objects own are made with, the trackers of the latest items of streams, and
` what gated blocks of style declarations call and are gated by, for the gates some instance
` uses (`used-gates`).
. live = instances.live
if live.track == no-instance
    =
mark(kinds, live.trackers)
mark(kinds, live.subscribers)
mark(kinds, live.actions)
mark(kinds, live.action)
mark(kinds, live.add-action)
mark(kinds, live.add-tracker)
for owned in facts.owned-subscriptions
    mark(kinds, owned.subscription)
    mark(kinds, owned.tracker)
for read in facts.latest-reads
    mark(kinds, read.tracker)
mark(kinds, live.track)
mark(kinds, live.track-collection)
mark(kinds, live.dispatch)
mark(kinds, live.memo-action)
mark(kinds, live.memo-settle)
mark(kinds, live.previous)
mark(kinds, live.next)
mark(kinds, live.enter)
mark(kinds, live.leave)
mark(kinds, live.pop)
mark(kinds, live.close)
mark(kinds, live.has-actions)
. gated = used-gates()
. gating = false
for used in gated
    gating = gating || used
if gating
    . runtime = facts.style-runtime
    mark(kinds, runtime.open-block)
    mark(kinds, runtime.close-block)
    mark(kinds, runtime.dynamic)
    mark(kinds, runtime.block-enabled)
    for index in 0 .. < facts.style-gates.length
        if gated[index]
            mark(kinds, facts.style-gates[index].action)
if facts.scope-cells.length != 0
    mark(kinds, facts.style-runtime.scope-state)
if facts.style-runtime.outlet-state != no-instance
    mark(kinds, facts.style-runtime.outlet-mark)
    mark(kinds, facts.style-runtime.outlet-push)
    mark(kinds, facts.style-runtime.outlet-release)
    mark(kinds, facts.style-runtime.outlet-state)

────────────────────
_ compiles-probes Bool

` Whether the program declares, flushes and closes its probes: where probes compile and the
` probes module is part of the program, with what it calls typed.
program.probes.is-enabled && probe-module != U32.max && instances.probe-runtime.begin != no-instance

────────────────────
_ do reach-probes
    - kinds CPointer'U32

` Adds what the functions that declare, flush and close probes call to the emitted set, with what
` the report of an error that leaves a function of the probes module calls.
. runtime = instances.probe-runtime
mark(kinds, runtime.begin)
mark(kinds, runtime.counter-setup)
mark(kinds, runtime.profile-setup)
mark(kinds, runtime.declare-key)
mark(kinds, runtime.declare-type)
mark(kinds, runtime.declare-log)
mark(kinds, runtime.declare-event)
mark(kinds, runtime.declare-counter)
mark(kinds, runtime.declare-argument)
mark(kinds, runtime.declare-profile-metric)
mark(kinds, runtime.counter-add)
mark(kinds, runtime.ready)
mark(kinds, runtime.collector-counts)
mark(kinds, runtime.end)
mark(kinds, runtime.task-flush)
mark(kinds, runtime.safepoint)
reach-error-report(kinds)

────────────────────
_ do declare-probes
    - kinds CPointer'U32

` Numbers each probe an emitted instance compiles from one, in the order of the instances' ranks
` and then of where the probes are written, a probe for each record one writes (see `ProbeRow`),
` with the probe data type of each value it writes: those its calls of the probes module write,
` after the head of its record and before the flush, after the group a record of a group opens
` or closes. A counter is numbered where its key is first written, then the counts the compiler
` keeps of what events do, and of what the collector did, where they compile, after every other.
` A metric of the profile is numbered apart, among `profile-metrics`. The class of each
` value of a class or an array is kept as it is first found, as the reference declares one for
` every value it casts for a probe, and so are the keys of the logs and the groups the emitted
` instances write, whether or not their probes compile.
if !compiles-probes()
    =
. keys [U64]
. sites [U32]
for position in 0 .. < facts.calls.length
    . fact = facts.calls[position]
    if (fact.form == .call-probe || fact.form == .call-probe-head || is-metric) && reached
        . key = pair-key(fact.instance, fact.syntax)
        if probe-rows[key] == null
            probe-rows[key] = 0
            keys += rank-key(fact.instance, fact.syntax)
            sites += position as U32
    .. is-metric = fact.form == .call-probe-metric
    .. reached = kinds[fact.instance] != Reach.none
. counters = Map'String'U32()
. metrics = Map'String'U32()
for position in ranked-order(keys)
    . fact = facts.calls[sites[position]]
    if fact.form == .call-probe-metric
        declare-profile-metric(fact.instance, fact.syntax, metrics)
        continue
    . tree = program.modules[instances.rows[fact.instance].module].tree
    keep-probe-classes(fact.instance, fact.syntax)
    if tree.nodes[fact.syntax] is .node-probe-counter
        declare-probe-counter(fact.instance, fact.syntax, counters)
        continue
    . groups = tree.nodes[fact.syntax] is .node-probe-group
    . callees [InstanceId]
    . part U32
    . call = facts.first-call(fact.instance, fact.syntax)
    while call != no-fact
        . row = facts.calls[call]
        if row.form == .call-probe-head && callees.length != 0
            declare-probe-part(fact.instance, fact.syntax, part, callees, groups)
            part += 1
            while callees.length != 0
                callees.pop()
        if row.form == .call-probe || row.form == .call-probe-head
            callees += row.callee
        call = row.next
    declare-probe-part(fact.instance, fact.syntax, part, callees, groups)
    probe-rows[pair-key(fact.instance, fact.syntax)] = (probes.length as U32) - part
declare-event-counts(counters)
for count in 0 .. < collector-counts.length
    if program.probes.compiles-metrics(compiler-count-key(count as U32))
        probes += ProbeRow(no-instance, 0, count as U32, Span(probe-types.length as U32, 0))
        collector-counts[count] = probes.length as U32
        last-counter = probes.length as U32
for instance in instances.ranked
    if kinds[instance] != Reach.none
        keep-probe-keys(instances.rows[instance].module, instances.rows[instance].subtree)

────────────────────
_ do declare-probe-counter
    - instance InstanceId
    - syntax SyntaxId
    - counters Map'String'U32

` Numbers a counter where its key is first written, and gives the same number wherever else it is.
do match? program.modules[instances.rows[instance].module].tree.nodes[syntax]
    | .node-probe-counter(row)
        . number = counters[row.key.text]
        if !number
            probes += ProbeRow(instance, syntax, 0, Span(probe-types.length as U32, 0))
            number = probes.length as U32
            counters[row.key.text] = number
            last-counter = number
        probe-rows[pair-key(instance, syntax)] = number

────────────────────
_ do declare-profile-metric
    - instance InstanceId
    - syntax SyntaxId
    - metrics Map'String'U32

` Numbers a metric of the profile where its key is first written as one of its kind, and gives the
` same number wherever else it is: a timer, whose `part` is two, or a counter, whose `part` is one,
` as the probes module declares them.
. kind U32 = 1
if program.modules[instances.rows[instance].module].tree.nodes[syntax] is .node-probe-group
    kind = 2
. named = "$kind:${metric-key(instance, syntax)}"
. number = metrics[named]
if !number
    profile-metrics += ProbeRow(instance, syntax, kind, Span(0, 0))
    number = profile-metrics.length as U32
    metrics[named] = number
probe-rows[pair-key(instance, syntax)] = number

────────────────────
+ do metric-key String
    - instance InstanceId
    - syntax SyntaxId

` The key a metric of the profile is declared under: the one its probe is written with, or for a
` stream pattern the counter the reference names for its results.
do match? program.modules[instances.rows[instance].module].tree.nodes[syntax]
    | .node-probe-counter(row)
        = row.key.text
    | .node-probe-group(row)
        = if row.key then row.key.text else ""
= "stream-pattern.capture-results"

────────────────────
+ do probe-site ProbeSite?
    - probe ProbeRow

. site = ProbeSite()
if probe.instance == no-instance
    site.key = compiler-count-key(probe.part)
    if (probe.part as Size) >= collector-counts.length && event-site-instance != no-instance
        . counted = program.modules[instances.rows[event-site-instance].module]
        site.module-name = counted.name
        site.path = counted.path
        site.line = (counted.tree.nodes.loc[event-site].begin.line + 1) as U32
    = site
. owner = program.modules[instances.rows[probe.instance].module]
. tree = owner.tree
site.module-name = owner.name
site.path = owner.path
site.line = (tree.nodes.loc[probe.syntax].begin.line + 1) as U32
. slots = probe.types.count as Size
do match? tree.nodes[probe.syntax]
    | .node-probe(row)
        site.key = if row.key then row.key.text else ""
        if row.name
            . named = row.name.text
            site.kind = .event
            site.name = named
            site.fields = slot-names(probe-field-names(tree, row.content, false), slots, false)
        else
            site.kind = .log
            site.template = probe-template(tree, row.content)
            site.fields = slot-names(probe-field-names(tree, row.content, true), slots, false)
        = site
    | .node-probe-assign(row)
        site.kind = .event
        site.key = row.key.text
        site.name = "set-property"
        site.fields = slot-names(["property", "value"], slots, false)
        = site
    | .node-probe-counter(row)
        site.key = row.key.text
        = site
    | .node-probe-group(row)
        site.key = if row.key then row.key.text else ""
        . opens = row.is-begin && probe.part == 0
        . named = probe-field-names(tree, row.content, true)
        . held = !ends-in-log(probe.instance, probe.syntax, probe.part)
        site.kind = .log
        if row.is-data
            site.kind = .event
            site.name = if opens then "groupBegin" else "groupEnd"
        else if !held
            site.template = probe-template(tree, row.content)
        else
            site.name = if opens then "groupBegin" else "groupEnd"
            site.template = if opens then probe-template(tree, row.content) else ""
        site.fields = slot-names(named, slots, held)
        = site
= null

────────────────────
+ do selects-any Bool
    - selection ProbeSelection

for probe in probes
    if probe.instance == no-instance
        =? true if selection.compiles-metrics(compiler-count-key(probe.part))
        continue
    . owner = program.modules[instances.rows[probe.instance].module]
    =? true if selection.compiles-node(owner.name, owner.tree, probe.syntax)
for metric in profile-metrics
    . owner = program.modules[instances.rows[metric.instance].module]
    =? true if selection.compiles-node(owner.name, owner.tree, metric.syntax)
    =? true if selection.compiles-metrics(metric-key(metric.instance, metric.syntax))
= false

────────────────────
+ do metric-site ProbeSite
    - metric ProbeRow

. owner = program.modules[instances.rows[metric.instance].module]
. site = ProbeSite()
site.kind = if metric.part == 2 then .timer else ProbeSiteKind.counter
site.key = metric-key(metric.instance, metric.syntax)
site.module-name = owner.name
site.path = owner.path
site.line = (owner.tree.nodes.loc[metric.syntax].begin.line + 1) as U32
= site

────────────────────
_ do declare-event-counts
    - counters Map'String'U32

` Numbers the counts the compiler keeps of what events do, where their metrics compile and the
` program publishes an event or queues a machine's handler, as the reference declares them all where
` it first does one. A key a counter written in the source has keeps the number it has.
if !program.probes.compiles-metrics("event") || !counts-events()
    =
for count in 0 .. < event-counts.length
    . part = (collector-counts.length + count) as U32
    . key = compiler-count-key(part)
    . number = counters[key]
    if !number
        probes += ProbeRow(no-instance, 0, part, Span(probe-types.length as U32, 0))
        number = probes.length as U32
        counters[key] = number
        last-counter = number
    event-counts[count] = number

────────────────────
_ do counts-events Bool

` Whether an emitted function publishes an event, reached or not, or queues a machine's handler.
=? true if event-site-instance != no-instance
= some(functions) • where each.kind == .machine-descriptor

────────────────────
_ do declare-probe-part
    - instance InstanceId
    - syntax SyntaxId
    - part U32
    - callees [InstanceId]
    - groups Bool

` Adds the probe of a record a probe writes, from the calls it makes of the probes module: the
` head, the writes, the flush. A record of a group writes the group it opens or closes first,
` but for the log a group that only ends writes before it does.
. start U32 = probe-types.length as U32
if groups && !ends-in-log(instance, syntax, part)
    probe-types += 15
    probe-type-classes += 16
if callees.length > 2
    for offset in 1 .. < callees.length - 1
        . signature = instances.signatures[callees[offset]]
        . written = instances.signature-types[signature.args.start]
        . data = probe-data-type(types, written)
        probe-types += data
        probe-type-classes += if data == 14 || data == 15 then probe-class-id(written) else 0
probes += ProbeRow(instance, syntax, part, Span(start, (probe-types.length - start) as U32))

────────────────────
_ do ends-in-log Bool
    - instance InstanceId
    - syntax SyntaxId
    - part U32

` Whether a record of a group is the log a group written as a log that only ends writes before the
` record that ends it.
do match? program.modules[instances.rows[instance].module].tree.nodes[syntax]
    | .node-probe-group(row)
        = part == 0 && !row.is-data && row.is-end && !row.is-begin
= false

────────────────────
_ probe-template String
    - tree AST
    - content RowRange'SyntaxId

"".join(probe-template-piece(tree, each) in tree.children[content])

────────────────────
_ probe-template-piece String
    - tree AST
    - item SyntaxId

match tree.nodes[item]
    | .node-string-syntax(text)
        text.text
    ??
        "%%"

────────────────────
_ do probe-field-names [String]
    - tree AST
    - content RowRange'SyntaxId
    - logs Bool

. names [String]
for item in tree.children[content]
    if tree.nodes[item] is .node-string-syntax
        if !logs
            names += "text"
        continue
    . written = value-name(tree, item)
    names += if written != "" then written else "value${names.length + 1}"
= names

────────────────────
_ do value-name String
    - tree AST
    - id SyntaxId

do match? tree.nodes[id]
    | .node-identifier(row)
        = row.name.text
    | .node-get-expression(row)
        . object = value-name(tree, row.object)
        = if object != "" then "${object}.${row.name.text}" else ""
    | .node-call-expression(row)
        = value-name(tree, row.callable)
    | .node-probe-snapshot(row)
        = value-name(tree, row.content)
    | .node-probe-preview(row)
        = value-name(tree, row.content)
= ""

────────────────────
_ do slot-names [String]
    - names [String]
    - slots Size
    - held Bool

. fields [String]
if held && slots > 0
    fields += "group"
for name in names
    if fields.length >= slots
        break
    fields += name
while fields.length < slots
    fields += "value${fields.length + 1}"
= fields

────────────────────
+ compiler-count-key String
    - count U32

` The key of a count the compiler keeps of its own accord: of what the collector did, the cycles it
` collected, the pauses it made and the time it spent assisting, and then of what events do, in the
` order of `EventCount`.
match count
    |= 0
        "gc.cycles"
    |= 1
        "gc.pauses"
    |= 2
        "gc.assist.nanos"
    ??
        "event.${event-count-names[count - 3]}"

────────────────────
_ do keep-probe-classes
    - instance InstanceId
    - syntax SyntaxId

` Keeps the class of each value a probe writes, and of the object it is written of, that the
` probes module knows by an id: an object of a class, an array or one that is `Inspectable`, where
` the probe writes it as such or as its text, but not a preview written as the name of its type.
. tree = program.modules[instances.rows[instance].module].tree
do match? tree.nodes[syntax]
    | .node-probe(row)
        keep-probe-class(instance, tree, row.object)
        for item in tree.children[row.content]
            keep-probe-class(instance, tree, item)
    | .node-probe-assign(row)
        keep-probe-class(instance, tree, row.object)
        keep-probe-class(instance, tree, row.content)
    | .node-probe-counter(row)
        keep-probe-class(instance, tree, row.object)
    | .node-probe-group(row)
        if row.is-data
            keep-probe-class(instance, tree, row.object)
        for item in tree.children[row.content]
            keep-probe-class(instance, tree, item)

────────────────────
_ do keep-probe-class
    - instance InstanceId
    - tree AST
    - item SyntaxId

. value = item
do match? tree.nodes[item]
    | .node-probe-snapshot(row)
        value = row.content
    | .node-probe-preview(row)
        value = row.content
if value == 0
    =
. type = facts.node-type(instance, value)
if type == no-type || type == invalid-type
    =
. cast = probe-cast(types, type)
if cast == .probe-object || cast == .probe-array
    . name = probe-class-name(types, type)
    if probe-classes.find(name) == null
        probe-classes += name

────────────────────
+ probe-class-id U16
    - type TypeId

` The id the probes module knows the class of an object or an array by, numbered after the probe
` data types in the order the classes are kept, or none.
if found then (17 + found) as U16 else 0

.. found = probe-classes.find(probe-class-name(types, type))

────────────────────
_ do keep-probe-keys
    - module ModuleId
    - subtree SyntaxRange

` Keeps the key of each log written in the nodes of an instance, and of each group, once.
. tree = program.modules[module].tree
for offset in 0 .. < subtree.count
    . key String? = null
    do match? tree.nodes[subtree.start + offset]
        | .node-probe(row)
            if row.key && !row.name
                key = row.key.text
        | .node-probe-group(row)
            if row.key
                key = row.key.text
    if key && probe-keys.find(key) == null
        probe-keys += key

────────────────────
+ probe-number U32
    - instance InstanceId
    - syntax SyntaxId

` The place of a probe an instance compiles among those the record of probes declares, counted
` from one, or none.
probe-rows[pair-key(instance, syntax)] ?? 0

────────────────────
_ do reach-error-report
    - kinds CPointer'U32

` Adds what the report of an error that leaves the main of a module, the value of a lazy
` global or the body of a spawned task calls to the emitted set.
. report = instances.report
mark(kinds, report.error-text)
mark(kinds, report.source-text)
mark(kinds, report.source)

────────────────────
_ do index-overrides
    - count U32

` Chains the overrides by the function each replaces and by the class each answers for.
. type-count = types.rows.length
. fact-count U32 = facts.overrides.length as U32
base-override-heads = arena.allocate'U32(count + 1)
class-override-heads = arena.allocate'U32(type-count + 1)
base-override-links = arena.allocate'U32(fact-count + 1)
class-override-links = arena.allocate'U32(fact-count + 1)
for instance in 0 .. < count
    base-override-heads[instance] = no-fact
for type in 0 .. < type-count
    class-override-heads[type] = no-fact
for position in 0 .. < fact-count
    . fact = facts.overrides[position]
    base-override-links[position] = base-override-heads[fact.base]
    base-override-heads[fact.base] = position
    class-override-links[position] = class-override-heads[fact.receiver]
    class-override-heads[fact.receiver] = position

────────────────────
_ do index-loose
    - count U32

` Chains the facts recorded at nodes no body reserved, the checked reads of globals, and the
` properties a property's value reads, by the instance they belong to, so that a visit reads
` only its own.
loose-call-heads = arena.allocate'U32(count + 1)
loose-conversion-heads = arena.allocate'U32(count + 1)
for instance in 0 .. < count
    loose-call-heads[instance] = no-fact
    loose-conversion-heads[instance] = no-fact
loose-call-links = arena.allocate'U32(facts.loose-calls.length + 1)
loose-conversion-links = arena.allocate'U32(facts.loose-conversions.length + 1)
for position in 0 .. < facts.loose-calls.length
    . owner = facts.loose-calls[position].instance
    loose-call-links[position] = loose-call-heads[owner]
    loose-call-heads[owner] = position as U32
for position in 0 .. < facts.loose-conversions.length
    . owner = facts.loose-conversions[position].instance
    loose-conversion-links[position] = loose-conversion-heads[owner]
    loose-conversion-heads[owner] = position as U32
use-heads = arena.allocate'U32(count + 1)
use-links = arena.allocate'U32(facts.global-uses.length + 1)
loose-forcing = arena.allocate'U8(count + 1)
for instance in 0 .. < count
    use-heads[instance] = no-fact
    loose-forcing[instance] = 0
for loose in facts.loose-forces
    loose-forcing[loose.instance] = 1
for position in 0 .. < facts.global-uses.length
    . owner = facts.global-uses[position].instance
    use-links[position] = use-heads[owner]
    use-heads[owner] = position as U32
read-heads = arena.allocate'U32(count + 1)
read-links = arena.allocate'U32(facts.value-reads.length + 1)
for instance in 0 .. < count
    read-heads[instance] = no-fact
for position in 0 .. < facts.value-reads.length
    . owner = facts.value-reads[position].instance
    read-links[position] = read-heads[owner]
    read-heads[owner] = position as U32

────────────────────
_ do visit
    - kinds CPointer'U32
    - instance InstanceId

` Marks what one emitted instance calls and converts through: the facts at the nodes of its body,
` and those recorded for it at no node of it. A call the compiler answers itself brings no callee. A
` forced optional brings the panic one that holds nothing raises, and a match no arm of which may
` match the panic it raises then, and an access of a view or of a table the panics the compiler
` writes for it, with their source. A value of an enum named brings what making it calls. A loop
` over a container whose protocol raises an error brings the panic the loop makes of one. A function
` with a loop that polls brings the check a poll makes. The constructor of a table that grows in an
` arena, or of an index span of a range, brings the panics it writes, with their source. A
` constructor brings what the values its class gives its properties call, and makes its class one
` the program constructs. A checked read of a global brings the panic it raises and, of a lazy
` global, what the global's value calls. The overrides of the instance join for the classes
` constructed so far, and those of a class newly constructed for the functions emitted so far. A
` comparison of values of interfaces brings the panic it may raise. A function of an interface run
` for a value of a type that is none brings the type's witness table, and a function that yields and
` returns an interface that of the generator it makes. A member that runs on a row's case brings its
` instance on the case, which the member may be a bridge to. A function that makes a live statement
` brings the function its action runs it again with, and the function of the markup runtime that
` makes the action an element of a markup host owns, one that uses an event the functions of the
` event runtime it calls, one that claims the endpoint at the address of a keyed event the
` constructor of the tracker that closes it, one that reads a markup link the function of the markup
` runtime that answers it, and one that writes markup under a markup host the functions of the
` markup runtime that link and batch it, and of each branch region it makes, those that make and
` select the region and the function that selects its arm again. One that reads a style or the flag
` of a domain brings the style runtime's reader or writer, and one that declares styles the
` functions of the style runtime that declare them, with the instance that types each style rule it
` applies, emitted in its frame.
. row = instances.rows[instance]
if row.materialized != no-instance
    mark(kinds, row.materialized)
for entry in visit-starts[instance] .. < visit-starts[instance + 1]
    visit-fact(kinds, instance, visit-kinds[entry], visit-rows[entry])
. replaced = base-override-heads[instance]
while replaced != no-fact
    . override = facts.overrides[replaced]
    if constructed[override.receiver] != 0
        mark(kinds, override.override)
    replaced = base-override-links[replaced]
if row.node-start != U32.max
    . first = row.subtree.start
    . tree = program.modules[row.module].tree
    . gate = program.feature-gate-starts[row.module]
    . gates-end = program.feature-gate-starts[row.module + 1]
    . offset U32
    while offset < row.subtree.count
        . id = first + offset
        while gate < gates-end && program.feature-gates[gate] < id
            gate += 1
        if gate < gates-end && defers-gate(tree, program.feature-gates[gate], id)
            deferred-instances += instance
            deferred-gates += program.feature-gates[gate]
            offset = program.feature-gates[gate] + 1 - first
            gate += 1
            continue
        visit-node(kinds, instance, row, offset)
        offset += 1
if loose-forcing[instance] != 0
    mark(kinds, instances.report.panic)
. loose = loose-call-heads[instance]
while loose != no-fact
    reach-call(kinds, facts.calls[facts.loose-calls[loose].fact])
    loose = loose-call-links[loose]
loose = loose-conversion-heads[instance]
while loose != no-fact
    . fact = facts.conversions[facts.loose-conversions[loose].fact]
    if is-reference(kinds, instance, fact.syntax)
        reach-conversion(kinds, fact)
    loose = loose-conversion-links[loose]
if row.polls
    mark-termination(kinds)
if writes-panics(instance) || row.casts-errors
    mark(kinds, instances.report.panic)
    mark(kinds, instances.report.source)
. view = receiver-view(instance)
if view != no-type
    reach-witness(row.self-type, view)
. given = instances.signatures[instance].returns
if row.makes != no-type && given != no-type && types.completions[given].intrinsic == .interface
    reach-witness(row.makes, given)
. use = use-heads[instance]
while use != no-fact
    reach-global(kinds, facts.global-uses[use])
    use = use-links[use]
if not-body && kinds[instance] != Reach.in-frame && kinds[instance] != Reach.initializer
    =
.. not-body = kinds[instance] != Reach.body
reach-defaults(kinds, instance)
if kinds[instance] != Reach.initializer
    construct(kinds, instance)

────────────────────
_ do visit-fact
    - kinds CPointer'U32
    - instance InstanceId
    - kind VisitFact
    - row U32

` Marks what one row of the facts a visit reads for an instance brings, as `visit` says.
do match kind
    |= .visit-live-statement
        . statement = facts.live-statements[row]
        mark(kinds, statement.rerun)
        if statement.owned != no-instance
            mark(kinds, statement.owned)
        if facts.style-declaration-of(instance, statement.site)
            mark(kinds, facts.style-runtime.dynamic)
            mark(kinds, facts.style-runtime.author-dynamic)
    |= .visit-markup-read
        mark(kinds, facts.markup-reads[row].reader)
    |= .visit-style-read
        mark(kinds, facts.style-reads[row].reader)
    |= .visit-style-flag
        mark(kinds, facts.style-flags[row].call)
    |= .visit-style-site
        . runtime = facts.style-runtime
        mark(kinds, runtime.info-required)
        mark(kinds, runtime.site-static)
        mark(kinds, runtime.site-recording)
        mark(kinds, runtime.site-recorded)
        mark(kinds, runtime.template-static)
        mark(kinds, runtime.associate)
        mark(kinds, runtime.site-ready)
        mark(kinds, runtime.site-inherit)
        mark(kinds, runtime.sheet-info-required)
        mark(kinds, runtime.site-sheet)
        mark(kinds, runtime.site-projected)
        mark(kinds, runtime.site-themed)
        mark(kinds, runtime.themed-slot)
        mark(kinds, runtime.themed-none)
        mark(kinds, runtime.site-family)
        mark(kinds, runtime.site-family-end)
    |= .visit-style-content
        mark(kinds, facts.style-contents[row].builder)
        mark(kinds, facts.style-runtime.template-content)
        mark(kinds, facts.style-runtime.content-enabled)
    |= .visit-style-application
        . application = facts.style-applications[row]
        if application.action != no-instance
            mark(kinds, application.action)
            mark(kinds, facts.style-runtime.dynamic)
            mark(kinds, facts.style-runtime.author-dynamic)
        if application.updater != no-instance
            mark(kinds, application.updater)
        if kinds[application.unit] == Reach.none
            kinds[application.unit] = Reach.in-frame
            reach-queue[reach-length] = application.unit
            reach-length += 1
        if application.values != no-instance && kinds[application.values] == Reach.none
            kinds[application.values] = Reach.in-frame
            reach-queue[reach-length] = application.values
            reach-length += 1
    |= .visit-content-link
        . link = facts.content-links[row]
        if link.append != no-instance
            mark(kinds, link.append)
    |= .visit-element-root
        . root = facts.element-roots[row]
        if root.ensure != no-instance
            mark(kinds, root.ensure)
        if root.mount != no-instance
            mark(kinds, root.mount)
    |= .visit-branch-region
        . region = facts.branch-regions[row]
        mark(kinds, region.create)
        mark(kinds, region.updater)
        mark(kinds, region.action)
        mark(kinds, region.structural)
        mark(kinds, region.keeps)
        mark(kinds, region.select)
        if region.ensure != no-instance
            mark(kinds, region.ensure)
    |= .visit-loop-region
        . region = facts.loop-regions[row]
        mark(kinds, region.create)
        mark(kinds, region.updater)
        mark(kinds, region.action)
        mark(kinds, region.structural)
        if region.ensure != no-instance
            mark(kinds, region.ensure)
        if region.replace != no-instance
            mark(kinds, region.replace)
    |= .visit-region-root
        . root = facts.region-roots[row]
        if root.ensure != no-instance
            mark(kinds, root.ensure)
    |= .visit-self-action
        . action = facts.self-actions[row]
        if action.maker != no-instance
            mark(kinds, action.maker)
    |= .visit-query-registration
        . registration = facts.query-registrations[row]
        if registration.query != U32.max || target-ids-of(registration.level).length != 0
            mark(kinds, registration.register)
        if registration.query != U32.max
            . query = facts.markup-queries[registration.query]
            query-used[registration.query] = 1
            mark(kinds, query.parent)
            mark(kinds, query.add)
            mark(kinds, query.remove)
            reach-conversion(kinds, facts.conversions[query.hosted])
    |= .visit-event-use
        . used = facts.event-uses[row]
        mark(kinds, used.first)
        mark(kinds, used.second)
    |= .visit-address-claim
        mark(kinds, facts.address-claims[row].closer)
    |= .visit-event-closer
        mark(kinds, facts.event-close)
    |= .visit-machine-group
        . group = facts.machine-groups[row]
        mark(kinds, group.enqueue)
        mark(kinds, group.port)
        mark(kinds, group.post)
        mark(kinds, group.attach)
        mark(kinds, group.detach)
    |= .visit-machine-stop
        mark(kinds, facts.machine-own)
        mark(kinds, facts.machine-stop)
    |= .visit-machine-refinement
        . refined = facts.machines[row].refined
        . unit = if refined != no-instance then instances.rows[refined].enclosing else no-instance
        if unit != no-instance && kinds[unit] == Reach.none
            kinds[unit] = Reach.in-frame
            reach-queue[reach-length] = unit
            reach-length += 1

────────────────────
_ do index-visits
    - count U32

` Gathers the rows of the facts a visit reads by the instance each names, so that a visit
` reads only its own: for each instance, the tables in the order of `VisitFact`, and the
` rows of each in the table's order.
. owners [InstanceId]
. ends [U32]
for statement in facts.live-statements
    owners += statement.instance
ends += owners.length as U32
for read in facts.markup-reads
    owners += read.instance
ends += owners.length as U32
for read in facts.style-reads
    owners += read.instance
ends += owners.length as U32
for flag in facts.style-flags
    owners += flag.instance
ends += owners.length as U32
for site in facts.style-sites
    owners += site.instance
ends += owners.length as U32
for content in facts.style-contents
    owners += content.instance
ends += owners.length as U32
for application in facts.style-applications
    owners += application.instance
ends += owners.length as U32
for link in facts.content-links
    owners += link.instance
ends += owners.length as U32
for root in facts.element-roots
    owners += root.instance
ends += owners.length as U32
for region in facts.branch-regions
    owners += region.instance
ends += owners.length as U32
for region in facts.loop-regions
    owners += region.instance
ends += owners.length as U32
for root in facts.region-roots
    owners += root.instance
ends += owners.length as U32
for action in facts.self-actions
    owners += action.instance
ends += owners.length as U32
for registration in facts.query-registrations
    owners += registration.instance
ends += owners.length as U32
for used in facts.event-uses
    owners += used.instance
ends += owners.length as U32
for claim in facts.address-claims
    owners += claim.instance
ends += owners.length as U32
for closer in facts.event-closers
    owners += closer
ends += owners.length as U32
for group in 0 .. < facts.machine-groups.length
    owners += machine-instance(group as U32)
ends += owners.length as U32
for machine in facts.machines
    owners += if machine.refined != no-instance then machine.instance else no-instance
ends += owners.length as U32
for machine in facts.machines
    owners += if stops-at-close(machine) then machine.instance else no-instance
ends += owners.length as U32
visit-starts = arena.allocate'U32(count + 1)
for instance in 0 .. < count + 1
    visit-starts[instance] = 0
for owner in owners
    if owner < count
        visit-starts[owner + 1] += 1
for instance in 1 .. < count + 1
    visit-starts[instance] += visit-starts[instance - 1]
. filled = arena.allocate'U32(count + 1)
for instance in 0 .. < count + 1
    filled[instance] = visit-starts[instance]
visit-kinds = arena.allocate'VisitFact(owners.length + 1)
visit-rows = arena.allocate'U32(owners.length + 1)
. table U32
. begins U32
for flat in 0 .. < owners.length
    while flat >= ends[table]
        begins = ends[table]
        table += 1
    . owner = owners[flat]
    if owner < count
        visit-kinds[filled[owner]] = table as VisitFact
        visit-rows[filled[owner]] = (flat - begins) as U32
        filled[owner] += 1

────────────────────
_ do machine-instance InstanceId
    - group U32

` The instance whose function writes the machine a group of event transitions is of.
for machine in facts.machines
    if group >= machine.groups.start && group < machine.groups.start + machine.groups.count
        = machine.instance
= no-instance

────────────────────
_ do visit-node
    - kinds CPointer'U32
    - instance InstanceId
    - row Instance
    - offset U32

. slot = row.node-start + offset
. call = facts.node-calls[slot]
while call != no-fact
    reach-call(kinds, facts.calls[call])
    call = facts.calls[call].next
. conversion = facts.node-conversions[slot]
while conversion != no-fact
    . fact = facts.conversions[conversion]
    if is-reference(kinds, instance, fact.syntax)
        reach-conversion(kinds, fact)
    conversion = fact.next
. plan = (facts.node-plans[slot] /and/ plan-bits) as OperatorPlan
reach-node(kinds, instance, row.subtree.start + offset, plan, facts.node-forces[slot] != no-fact)

────────────────────
_ do defers-gate Bool
    - tree AST
    - gate SyntaxId
    - id SyntaxId

if observes || tree.subtree-start(gate) != id
    = false
do match? tree.nodes[gate]
    | .node-do-block(row)
        = (row.feature-gate-features /and/ CompilerFeature.collection-observers) != 0
= false

────────────────────
_ do visit-gates
    - kinds CPointer'U32

while deferred-next < deferred-instances.length
    . instance = deferred-instances[deferred-next]
    . gate = deferred-gates[deferred-next]
    deferred-next += 1
    . row = instances.rows[instance]
    . start = program.modules[row.module].tree.subtree-start(gate)
    for id in start .. < gate + 1
        visit-node(kinds, instance, row, id - row.subtree.start)

────────────────────
+ compiles-features Bool
    - features CompilerFeature

observes || (features /and/ CompilerFeature.collection-observers) == 0

────────────────────
_ do reach-node
    - kinds CPointer'U32
    - instance InstanceId
    - syntax SyntaxId
    - plan OperatorPlan
    - forced Bool

` Marks what a node an emitted instance answers brings besides its calls and conversions: the
` panics the compiler writes for it, with their source, where it is `forced` and otherwise, and the
` values of enums it reads.
if forced
    mark(kinds, instances.report.panic)
if plan == .plan-unmatched
    mark(kinds, instances.report.panic)
. builds = plan == .plan-builder-append || plan == .plan-builder-reserve
if plan == .plan-view || plan == .plan-table || plan == .plan-table-loop || builds
    mark(kinds, instances.report.panic)
    mark(kinds, instances.report.source)
if plan == .plan-enum-value
    reach-enum(kinds, facts.constant-of(instance, syntax))
if plan == .plan-raise
    mark(kinds, instances.report.source)
if plan == .plan-literal-conversion
    mark(kinds, instances.report.panic)
    mark(kinds, instances.report.error-text)
if compares-interfaces(instance, syntax, plan)
    mark(kinds, instances.report.panic)
    mark(kinds, instances.report.source)
if plan == .plan-stream-loop || plan == .plan-cursor-loop
    reach-loop-panic(kinds, instance, facts.bullet-site(instance, syntax))
if plan == .plan-index-loop || is-place-loop-plan(plan)
    reach-loop-panic(kinds, instance, facts.bullet-site(instance, syntax))

────────────────────
_ do construct
    - kinds CPointer'U32
    - instance InstanceId

` Makes the class of a constructor the program calls one it constructs, and brings the
` overrides that class declares of the functions emitted so far.
. row = instances.rows[instance]
. type = row.self-type
if type == no-type || type == invalid-type
    =
do match? program.modules[row.module].decls[row.decl]
    | .decl-function(fn)
        if constructs(fn.kind) && constructed[type] == 0
            constructed[type] = 1
            constructed-order += type
            class-count += 1
            . made = class-override-heads[type]
            while made != no-fact
                . override = facts.overrides[made]
                if kinds[override.base] != Reach.none
                    mark(kinds, override.override)
                made = class-override-links[made]

────────────────────
_ do compares-interfaces Bool
    - instance InstanceId
    - syntax SyntaxId
    - plan OperatorPlan

` Whether a node compares values of interfaces, which may panic with a message: as its own
` plan says, or where it compares what optionals hold or the parts of two values and a getter
` is read there, which says whether a tracker compares for a change.
if plan == .plan-interface-equal || plan == .plan-interface-unlike
    = true
. inner = if plan == .plan-held then facts.held-of(instance, syntax).plan else plan
if inner == .plan-interface-unlike
    = true
if inner != .plan-interface-equal && inner != .plan-fields && inner != .plan-not-fields
    = false
. call = facts.first-call(instance, syntax)
while call != no-fact
    if facts.calls[call].form == .call-getter
        = true
    call = facts.calls[call].next
= false

────────────────────
_ do reach-conversion
    - kinds CPointer'U32
    - fact ConversionFact

` Marks what a conversion an emitted instance makes calls: the function that converts, every
` value of an enum a number is converted to by its place, those
` that convert the fields of a tuple or struct or what an optional holds, the witness table of
` a value made one of an interface, and the constructor of the panic that a cast of an
` object to a class derived from its own, or of a value of an interface to what it holds,
` raises when it fails, or an optional that holds nothing when it is unwrapped, and the panic
` the views of fields' columns cast to a span raise when their lengths differ. A conversion by
` a function that raises brings what its errors need: the source they are given where they
` leave, or the panic they become.
mark(kinds, fact.callee)
reach-made-interface(fact)
reach-made(kinds, fact)
reach-parts(kinds, fact.parts)
if fact.kind == .relation-fromverter && fact.callee == no-instance
    reach-enum-values(kinds, fact.to)
. down = fact.kind == .relation-down-cast || fact.kind == .relation-interface-down-cast
if down || fact.kind == .relation-unwrap-cast
    mark(kinds, instances.report.panic)
if fact.kind == .relation-side-cast && types.completions[fact.to].intrinsic == .table-span
    mark(kinds, instances.report.panic)
    mark(kinds, instances.report.source)
if fact.raise == .raise-leaves
    mark(kinds, instances.report.source)
if fact.raise == .raise-panics
    mark(kinds, instances.report.panic)
    mark(kinds, instances.report.error-text)
reach-union-error(kinds, fact)

────────────────────
_ do reach-made
    - kinds CPointer'U32
    - fact ConversionFact

` Marks what a conversion to a value of a function type brings: the function the value
` runs, the function made for the two types, and what the conversions that function makes
` call.
if fact.runs != no-instance
    reach-callee(kinds, fact.runs)
    reach-value(fact)
    if instances.signatures[fact.runs].errors.count != 0
        mark(kinds, instances.report.source)
    . passed = facts.first-passed(fact.runs)
    while passed != no-fact
        reach-conversion(kinds, facts.conversions[passed])
        passed = facts.conversions[passed].next
if fact.casts
    reach-value(fact)
    if carries-errors(fact.from)
        mark(kinds, instances.report.source)
    . passed = facts.first-cast(fact.from, fact.to)
    while passed != no-fact
        reach-conversion(kinds, facts.conversions[passed])
        passed = facts.conversions[passed].next

────────────────────
_ carries-errors Bool
    - type TypeId

` Whether the type pass kept, for a function type, what a call of its value answers with:
` the type carries errors.
fn != no-type && facts.carried-result(fn) != no-type

.. fn = function-row(types, type)

────────────────────
_ rank-key U64
    - instance InstanceId
    - site U32

` A key that orders rows of facts by the rank of their instance, then by `site`.
((instances.rank-of(instance) as U64) /lshift/ 32) /or/ (site as U64)

────────────────────
_ do ranked-instances [InstanceId]
    - listed [InstanceId]

` The instances of a list in the order of their ranks.
. keys [U64]
for instance in listed
    keys += rank-key(instance, 0)
. ordered [InstanceId]
for position in ranked-order(keys)
    ordered += listed[position]
= ordered

────────────────────
_ do ranked-order [U32]
    - keys [U64]

` The positions of `keys` in the order of their keys, those of equal keys in their order in the
` list.
. count = keys.length
. order [U32]
. spare [U32]
for position in 0 .. < count
    order += position as U32
    spare += 0
. width Size = 1
while width < count
    . start Size = 0
    while start < count
        . middle = if start + width < count then start + width else count
        . end = if middle + width < count then middle + width else count
        . left = start
        . right = middle
        for position in start .. < end
            if left < middle && (right >= end || keys[order[right]] >= keys[order[left]])
                spare[position] = order[left]
                left += 1
            else
                spare[position] = order[right]
                right += 1
        start = end
    . merged = order
    order = spare
    spare = merged
    width *= 2
= order

────────────────────
_ do index-sites

for position in 0 .. < facts.event-uses.length
    . key = site-key(facts.event-uses[position].instance, facts.event-uses[position].site)
    if event-use-places[key] == null
        event-use-places[key] = position as U32
for position in 0 .. < facts.owned-subscriptions.length
    . key = site-key
        - facts.owned-subscriptions[position].instance
        - facts.owned-subscriptions[position].site
    if subscription-places[key] == null
        subscription-places[key] = position as U32
for position in 0 .. < facts.live-statements.length
    . key = site-key(facts.live-statements[position].instance, facts.live-statements[position].site)
    if live-statement-places[key] == null
        live-statement-places[key] = position as U32
for machine in facts.machines
    . key = ((machine.module as Size) /lshift/ 32) /or/ (machine.decl as Size)
    if machine.store == .store-member && member-machines[key] == null
        member-machines[key] = machine.syntax

────────────────────
+ event-use-of EventUse?
    - instance InstanceId
    - site SyntaxId

facts.event-uses[place] if place

.. place = event-use-places[site-key(instance, site)]

────────────────────
+ owned-subscription-of OwnedSubscription?
    - instance InstanceId
    - site SyntaxId

facts.owned-subscriptions[place] if place

.. place = subscription-places[site-key(instance, site)]

────────────────────
+ live-statement-of LiveStatement?
    - instance InstanceId
    - site SyntaxId

facts.live-statements[place] if place

.. place = live-statement-places[site-key(instance, site)]

────────────────────
_ site-key Size
    - instance InstanceId
    - site SyntaxId

((instance as Size) /lshift/ 32) /or/ (site as Size)

────────────────────
_ pair-key Size
    - from TypeId
    - to TypeId

((from as Size) /lshift/ 32) /or/ (to as Size)

────────────────────
_ do reach-value
    - fact ConversionFact

` Notes the function a value of a function type made by a conversion runs: one for the
` type converted and the function type. A closure the type pass noted a place for is made
` there, and a value of a function type made a value of another where the type pass kept
` one place for the two types. Any other is made where its conversion is written, and one
` that conversions in two instances make, or a binding's that two places make, where the
` first of them is written.
. key = pair-key(fact.from, fact.to)
. found = adapter-rows[key]
. binds = types.completions[fact.from].intrinsic == .binding || fact.casts
if found != null
    . row = adapters[found]
    if !row.fixed && (row.made-instance != fact.instance || (binds && row.made-site != fact.syntax))
        adapters[found].shared = true
    . elsewhere = row.instance != fact.instance || (binds && row.site != fact.syntax)
    if elsewhere && !row.fixed && written-first(fact.instance, fact.syntax, row.instance, row.site)
        adapters[found].instance = fact.instance
        adapters[found].site = fact.syntax
    =
. made = adapters.length
adapter-rows[key] = made as U32
. placed = facts.cast-place(fact.from, fact.to) if fact.casts
. instance = if placed then (placed /rshift/ 32) as InstanceId else no-instance
if instance != no-instance
    adapters.append
        - Adapter(fact.from, fact.to, fact.runs, instance, (placed! % 4294967296) as SyntaxId)
    adapters[made].fixed = true
    adapters[made].shared = facts.cast-shared(fact.from, fact.to)
    =
adapters.append(Adapter(fact.from, fact.to, fact.runs, fact.instance, fact.syntax))
adapters[made].made-instance = fact.instance
adapters[made].made-site = fact.syntax
if !binds
    . noted = types.closure-place(fact.from)
    if noted != 0
        adapters[made].site = (noted % 4294967296) as SyntaxId
        adapters[made].below = noted >= 4294967296
        adapters[made].fixed = true

────────────────────
_ written-first Bool
    - instance InstanceId
    - syntax SyntaxId
    - other InstanceId
    - site SyntaxId

` Whether a place in one instance is written before a place in another: by module, then by
` where in it, then by the ranks of the instances.
|? module != apart
    module < apart
|? syntax != site
    syntax < site
??
    instances.rank-of(instance) < instances.rank-of(other)

.. module = instances.rows[instance].module
.. apart = instances.rows[other].module

────────────────────
_ do reach-union-error
    - kinds CPointer'U32
    - fact ConversionFact

` Marks what an unwrapped union raises where it holds another case.
. unwraps = fact.kind == .relation-unwrap-cast || fact.kind == .relation-down-cast
if unwraps && fact.case-index != U32.max && fact.to != types.string-type
    mark(kinds, instances.report.panic)
    mark(kinds, instances.report.union-error)
    mark(kinds, instances.report.union-text)

────────────────────
_ do reach-parts
    - kinds CPointer'U32
    - first FactId

` Marks what the conversions of the fields of a tuple or struct call and the witness tables
` they make, and those of the fields of any tuple or struct inside it, and the constructor of
` the panic a part that casts to a derived class or out of an interface raises.
. part = first
while part != no-fact
    . fact = facts.conversion-parts[part]
    mark(kinds, fact.callee)
    if fact.kind == .relation-down-cast || fact.kind == .relation-interface-down-cast
        mark(kinds, instances.report.panic)
    reach-made-interface(fact)
    reach-made(kinds, fact)
    reach-union-error(kinds, fact)
    reach-parts(kinds, fact.parts)
    part = fact.next

────────────────────
_ do reach-made-interface
    - fact ConversionFact

` Reaches the witness table of a value a conversion makes one of an interface.
if fact.kind == .relation-interface-cast
    reach-witness(fact.from, fact.to)

────────────────────
_ do writes-panics Bool
    - instance InstanceId

` Whether an instance is a constructor the compiler generates that raises panics it writes:
` of a table that grows in an arena, or of an index span of a range.
. row = instances.rows[instance]
do match? program.modules[row.module].decls[row.decl]
    | .decl-function(fn)
        . grows = in-arena || fn.kind == .table-capacity-constructor-decl
            .. in-arena = fn.kind == .table-arena-constructor-decl
        = fn.is-generated && (grows || fn.kind == .index-span-range-constructor-decl)
= false

────────────────────
_ do reach-call
    - kinds CPointer'U32
    - fact CallFact

` Marks the callee of a call an emitted instance makes where its code makes it.
if is-reference(kinds, fact.instance, fact.syntax)
    reach-made-call(kinds, fact)

────────────────────
_ do reach-made-call
    - kinds CPointer'U32
    - fact CallFact

` Marks the callee of a call, made by the code of an instance or by the value of a global. A
` node the compiler answers itself makes none of the calls recorded at it but those it makes
` of a range that indexes a view. `super(…)` calls its callee's initializer, which the
` compiler writes nothing for when it generated the constructor. The body of a spawned task
` reports a panic that leaves it itself.
if is-intrinsic-plan(facts.plan-of(fact.instance, fact.syntax)) && fact.form != .call-view-range
    =
if is-super-call(fact)
    if has-initializer(fact.callee)
        initialized[fact.callee] = 1
        if kinds[fact.callee] == Reach.none
            kinds[fact.callee] = Reach.initializer
            reach-queue[reach-length] = fact.callee
            reach-length += 1
    =
if fact.propagates
    mark(kinds, instances.report.source)
if fact.form == .call-task
    reach-report(kinds)
    if fact.callee != no-instance && instances.signatures[fact.callee].errors.count != 0
        reach-error-report(kinds)
for offset in 0 .. < fact.through.count
    mark(kinds, facts.step-callees[fact.through.start + offset])
reach-callee(kinds, fact.callee)

────────────────────
_ do is-super-call Bool
    - fact CallFact

` Whether a call is `super(…)`: of a constructor, by the name of the receiver's base part.
if fact.form != .call-this-constructor || fact.syntax == 0
    = false
. row = instances.rows[fact.instance]
. tree = program.modules[row.module].tree
if row.binding == no-binding || fact.syntax >= tree.nodes.length
    = false
do match? tree.nodes[fact.syntax]
    | .node-call-expression(call)
        do match? tree.nodes[call.callable]
            | .node-identifier
                . resolution = bindings.resolution-of(row.binding, call.callable)
                if resolution.kind == .resolve-slot
                    = bindings.slots[resolution.slot].kind == .slot-super
= false

────────────────────
+ do has-initializer Bool
    - callee InstanceId

` Whether a constructor is one written in source for a class, which `super(…)` runs on the
` object being made. One the compiler generates stores nothing then and runs nothing, and
` one that returns a value of its own has no object to run on.
if callee == no-instance
    = false
. row = instances.rows[callee]
if !is-class(row.self-type) || returns-own(callee)
    = false
do match? program.modules[row.module].decls[row.decl]
    | .decl-function(fn)
        = !fn.is-generated && fn.kind == .constructor-decl
= false

────────────────────
+ do fills-apart Bool
    - instance InstanceId

` Whether a constructor runs its body in a function of its own, as the reference shares the body
` among the styles the constructor is made for: one that fills its object with its class's
` markup and raises no error. Its own function calls that one, then fills the object, so a
` panic in the body shows both.
if facts.filler-of(instance) == no-fact || instances.signatures[instance].errors.count != 0
    = false
. row = instances.rows[instance]
do match? program.modules[row.module].decls[row.decl]
    | .decl-function(fn)
        = fn.kind == .default-constructor-decl || fn.kind == .constructor-decl
= false

────────────────────
+ returns-own Bool
    - callee InstanceId

` Whether a constructor written in source returns a value of its own, as the type pass said
` of it where it typed its body. It constructs what it returns, and makes nothing of its
` class.
callee != no-instance && instances.rows[callee].returns-own

────────────────────
_ do reach-callee
    - kinds CPointer'U32
    - callee InstanceId

` Marks the callee of a call. A constructor that builds its value where the call is joins
` the set to be visited, and is given no function. A function of an interface called
` through a value is given a slot in the interface's section of the witness tables; what
` fills the slot joins with each table.
if callee != no-instance && builds-in-frame(callee)
    if kinds[callee] == Reach.none
        kinds[callee] = Reach.in-frame
        reach-queue[reach-length] = callee
        reach-length += 1
    =
if callee != no-instance && called-through[callee] != 0
    if slots[callee] == no-slot-index
        . owner = instances.rows[callee].self-type
        slots[callee] = slot-counts[owner]
        slot-counts[owner] += 1
        prototypes = prototypes.appended(arena, callee)
    =
mark(kinds, callee)

────────────────────
+ do writes-constructor Bool
    - type TypeId

` Whether a type, or one it is derived from, declares a constructor written in source. With
` no value written for it, a tuple or struct of such a type is what the constructor the type
` pass chose makes, which the first values of its fields do not say.
. current = type
while current != no-type && current != invalid-type
    . module ModuleId = 0
    . decl DeclId = 0
    . declared = false
    do match? types.rows[current]
        | .type-class(row)
            module = row.module
            decl = row.decl
            declared = true
        | .type-tuple(row)
            module = row.module
            decl = row.decl
            declared = true
        | .type-struct(row)
            module = row.module
            decl = row.decl
            declared = true
    if declared && writes-own-constructor(module, decl)
        = true
    current = types.completions[current].base
= false

────────────────────
_ do writes-own-constructor Bool
    - module ModuleId
    - decl DeclId

. owner = program.modules[module]
do match? owner.decls[decl]
    | .decl-class(class)
        if class.members.count == 0
            = false
        for member in owner.member-pool[class.members]
            do match? owner.decls[member]
                | .decl-function(fn)
                    if !fn.is-generated && fn.kind == .constructor-decl
                        = true
= false

────────────────────
+ do builds-in-frame Bool
    - callee InstanceId

` Whether a callee is a constructor the compiler generates for a tuple or struct: one that
` gives each field an argument or its first value. A call of it builds the value where the
` call is, so it is visited for what the first values call, and is no function.
. row = instances.rows[callee]
if row.self-type == no-type || row.self-type == invalid-type
    = false
. kind = types.completions[row.self-type].intrinsic
if kind != .tuple && kind != .struct && kind != .array-builder
    = false
do match? program.modules[row.module].decls[row.decl]
    | .decl-function(fn)
        . fills = fn.kind == .tuple-constructor-decl || fn.kind == .default-constructor-decl
        = fn.is-generated && fills
= false

────────────────────
_ do is-reference Bool
    - kinds CPointer'U32
    - instance InstanceId
    - syntax SyntaxId

` Whether a fact of an emitted instance is one its code acts on. A main's facts inside
` declaration statements belong to what they declare, not to the main. The statements of a
` module start in the order they are written, and a statement's nodes run from where it
` starts to where the next one does: a branch links what follows it after it is made, so its
` own id is not its last. The last statement to start at or before a node is found by halving.
` The node is in it, or where a statement was made of those written before the ones after it
` were, as the cases of a state machine are, in an earlier one whose nodes reach it. A fact at
` the main's own node, as its call of `end-main` is, is the main's.
if kinds[instance] != Reach.main
    = true
if syntax == 0
    = false
. tree = program.modules[instances.rows[instance].module].tree
if syntax == tree.root
    = true
do match? tree.nodes[tree.root]
    | .node-top-level-syntax(row)
        . first = row.statements.start
        . low U32
        . high U32 = row.statements.count
        while low < high
            . middle = (low + high) / 2
            if syntax >= tree.subtree-start(tree.children[first + middle])
                low = middle + 1
            else
                high = middle
        if low == 0
            = false
        . statement = tree.children[first + low - 1]
        if syntax > statement
            . position = low - 1
            while position != 0
                position -= 1
                . earlier = tree.children[first + position]
                if syntax <= earlier && syntax >= tree.subtree-start(earlier)
                    = runs-statement
                        - instances.rows[instance].module
                        - instances.rows[instance].decl
                        - tree
                        - earlier
        = runs-statement
            - instances.rows[instance].module
            - instances.rows[instance].decl
            - tree
            - statement
= false

────────────────────
_ do mark Bool
    - kinds CPointer'U32
    - callee InstanceId

` Adds a callee to the emitted set, to be visited in its turn, and says whether anything was
` new. A C function is not emitted; its symbol is named for the calls to it. One that can
` reach the collector is called between checks for a terminating task, and brings the check
` that raises the termination panic.
if callee == no-instance
    = false
. row = instances.rows[callee]
. owner = program.modules[row.module]
if owner.name.ends-with(".h")
    . added = false
    do match? owner.decls[row.decl]
        | .decl-function(fn)
            . name = fn.name
            if name && c-symbols[callee] == no-string
                c-symbols[callee] = bundle.intern(program.target.symbol(name.text))
                if name.text == observer-activation-name
                    observes = true
                if suspends-task(name.text)
                    c-suspends[callee] = 1
                    suspends = true
                c-described[callee] = describing(name)
            if (fn.effects /and/ CompilationEffect.gc-leaf) == 0 || c-suspends[callee] != 0
                added = mark-termination(kinds)
    = added
if kinds[callee] == Reach.in-frame
    kinds[callee] = Reach.body
    = true
if kinds[callee] == Reach.initializer
    kinds[callee] = Reach.body
    construct(kinds, callee)
    = true
if kinds[callee] != Reach.none
    = false
kinds[callee] = Reach.body
reach-queue[reach-length] = callee
reach-length += 1
= true

────────────────────
_ do mark-termination Bool
    - kinds CPointer'U32

` Adds the check a poll makes for a terminating task, and the panic it raises, to the emitted
` set. Says whether either was new.
. report = instances.report
. added = mark(kinds, report.termination)
if mark(kinds, report.termination-error)
    added = true
= added

────────────────────
_ do reach-defaults
    - kinds CPointer'U32
    - instance InstanceId

` Marks what the property values of a constructed class call, and its rules.
if !writes-defaults(instance)
    =
. type = instances.rows[instance].self-type
if type == no-type || type == invalid-type
    =
reach-values(kinds, type)
reach-rules(kinds, type)

────────────────────
_ do reach-rules
    - kinds CPointer'U32
    - type TypeId

` Marks what the rules a constructed class runs call: each rule is typed as an instance of
` its own, for the class that writes it, which is visited as one emitted in the frames of the
` constructor and of the function that runs it again, with the function that tells whether
` the value of a `whenever` rule has changed.
. level TypeId? = type
while level
    . ref = class-ref(types, level)
    . owner = program.modules[ref.module]
    do match? owner.decls[ref.decl]
        | .decl-class(class)
            for member in owner.member-pool[class.members]
                if !(owner.decls[member] is .decl-rule)
                    continue
                . unit = instances.find-initializer(ref.module, member, level)
                if unit != no-instance && kinds[unit] == Reach.none
                    kinds[unit] = Reach.in-frame
                    reach-queue[reach-length] = unit
                    reach-length += 1
                if unit != no-instance
                    mark(kinds, facts.change-test-of(unit))
                    reach-trigger(kinds, unit)
    level = types.base-of(level)

────────────────────
_ do reach-trigger
    - kinds CPointer'U32
    - unit InstanceId

` Marks what a `whenever` rule on the markup an object is in calls besides its body: what makes
` and empties its changes and records one there, and the markup runtime's functions that
` register it and find a parent host, and the call that runs its action.
. trigger = facts.markup-trigger-of(unit)
if !trigger
    =
. found = trigger
for callee in [found.made, found.clear, found.record, found.parent, found.register, found.schedule]
    if callee != no-instance
        reach-callee(kinds, callee)

────────────────────
_ do reach-values
    - kinds CPointer'U32
    - type TypeId

` Marks what the values written for the properties of a type call, once for the type. Each
` value is an instance of its own, typed for the type: it joins the set to be visited, and
` is given no function. A property with no value written that holds a named tuple or struct
` has the first values of that type's fields, so those are marked with it, and one of another
` module's class has its construction typed by an instance of its own, visited alike.
. range = types.completions[type].properties
for position in 0 .. < range.count
    . place = range.start + position
    . property = types.properties[place]
    if property.storage-kind == .storage-getter || default-rows[place] != U32.max
        continue
    . given = default-of(type, place)
    default-rows[place] = defaults.length as U32
    defaults.append(given)
    if given.value == 0
        if property.type != no-type && property.type != invalid-type && holds-fields(property.type)
            reach-values(kinds, property.type)
        . made = if given.decl != 0 then initializer else no-instance
            .. initializer = instances.find-initializer(given.module, given.decl, type)
        if made != no-instance && kinds[made] == Reach.none
            kinds[made] = Reach.in-frame
            reach-queue[reach-length] = made
            reach-length += 1
        continue
    . unit = find-unit(type, place, given)
    value-units[place] = unit
    if unit != no-instance && kinds[unit] == Reach.none
        kinds[unit] = Reach.in-frame
        reach-queue[reach-length] = unit
        reach-length += 1

────────────────────
_ do holds-fields Bool
    - type TypeId

` Whether a type is a named tuple or struct, whose fields have first values of their own.
. kind = types.completions[type].intrinsic
if kind != .tuple && kind != .struct && kind != .array-builder
    = false
do match? types.rows[type]
    | .type-class
        = true
= false

────────────────────
_ do reach-site
    - kinds CPointer'U32
    - module ModuleId
    - site SyntaxId

` Marks what the value written for a global calls and converts through, what its nodes
` bring, and what its checked reads of globals bring, whether or not its module's main is
` emitted. The value's facts are those of the main.
. main = main-instances[module]
. first = program.modules[module].tree.subtree-start(site)
for node in first .. < site + 1
    . call = facts.first-call(main, node)
    while call != no-fact
        reach-made-call(kinds, facts.calls[call])
        call = facts.calls[call].next
    . conversion = facts.first-conversion(main, node)
    while conversion != no-fact
        reach-conversion(kinds, facts.conversions[conversion])
        conversion = facts.conversions[conversion].next
    reach-node
        - kinds
        - main
        - node
        - facts.plan-of(main, node)
        - facts.first-force(main, node) != no-fact
. use = use-heads[main]
while use != no-fact
    . read = facts.global-uses[use]
    if read.syntax >= first && read.syntax <= site
        reach-global(kinds, read)
    use = use-links[use]

────────────────────
_ do reach-loop-panic
    - kinds CPointer'U32
    - instance InstanceId
    - loop SyntaxId

` Adds what a loop over a container calls where a function of the container's protocol
` raises an error: the panic the loop makes of it, and the text of the error. The calls
` are read where the type pass kept them, which for a bullet is beside others.
. call = facts.first-call(instance, loop)
while call != no-fact
    . callee = facts.calls[call].callee
    if callee != no-instance && instances.signatures[callee].errors.count != 0
        mark(kinds, instances.report.panic)
        mark(kinds, instances.report.error-text)
    call = facts.calls[call].next

────────────────────
_ do reach-enum
    - kinds CPointer'U32
    - constant FactId

` Marks a value of an enum that an emitted instance reads as one its module makes as it
` starts, and what making it calls and converts through.
if constant == no-fact
    =
. bits = facts.constants[constant].bits
. module ModuleId = (bits / 4294967296) as U32
. decl DeclId = (bits % 4294967296) as U32
if module >= program.modules.length || decl >= program.modules[module].decls.length
    =
reach-enum-value(kinds, module, decl)

────────────────────
_ do reach-enum-value
    - kinds CPointer'U32
    - module ModuleId
    - decl DeclId

` Marks one value of an enum as made when its module starts, with what making it reaches.
. place = storage-starts[module] + decl
if global-kinds[place] != GlobalKind.global-enum-unread
    =
global-kinds[place] = GlobalKind.global-enum
do match? program.modules[module].decls[decl]
    | .decl-case(case)
        reach-site(kinds, module, case.syntax)

────────────────────
_ do reach-enum-values
    - kinds CPointer'U32
    - type TypeId

` Marks every value an enum declares as made when its module starts: a number converted to
` the enum by its place may be any of them.
do match? types.rows[type]
    | .type-class(class)
        if class.module >= program.modules.length
            =
        . owner = program.modules[class.module]
        for decl in 0 .. < owner.decls.length
            do match? owner.decls[decl]
                | .decl-case(case)
                    if case.owner == class.decl
                        reach-enum-value(kinds, class.module, decl as DeclId)

────────────────────
_ do reach-global
    - kinds CPointer'U32
    - use GlobalUse

` Marks what a checked read of a global brings: the constructor of the panic it raises, and
` for the first read of a lazy global the function that evaluates it, with what its value
` calls and the report of an error it lets out.
mark(kinds, instances.report.panic)
. row = storage-of(use.module, use.decl)
if row == no-storage || global-kind(use.module, use.decl) != .global-lazy
    =
if storage[row].function != no-function
    =
storage[row].function = pending-function
do match? program.modules[use.module].decls[use.decl]
    | .decl-property(property)
        reach-site(kinds, use.module, property.syntax)
. unit = instances.find-initializer(use.module, use.decl, no-type)
if unit != no-instance && instances.signatures[unit].errors.count != 0
    reach-error-report(kinds)

────────────────────
_ do writes-defaults Bool
    - instance InstanceId

` Whether an instance is a constructor that gives properties the values their class writes:
` one the compiler generates, or one written in source.
. row = instances.rows[instance]
do match? program.modules[row.module].decls[row.decl]
    | .decl-function(fn)
        . generated = fn.kind == .default-constructor-decl || fn.kind == .tuple-constructor-decl
        = generated || fn.kind == .constructor-decl
= false

────────────────────
+ do loose-call FactId
    - instance InstanceId
    - syntax SyntaxId

` The call recorded for an instance at a node outside its body, or no fact when none is
` recorded there, or more than one.
. found = no-fact
. loose = loose-call-heads[instance]
while loose != no-fact
    . fact = facts.loose-calls[loose].fact
    if facts.calls[fact].syntax == syntax
        if found != no-fact
            = no-fact
        found = fact
    loose = loose-call-links[loose]
= found

────────────────────
+ default-of PropertyDefault
    - type TypeId
    - property U32

` The value written for a property of a type, by the property's place among all of them.
` It is kept for each property of a class the program constructs, so a worker that builds
` one reads no class.
|? property < default-count && default-rows[property] != U32.max
    defaults[default-rows[property]]
|? found.site != 0 || row.owner == no-type
    found
??
    tuple-default(type, row.owner, row.name)

.. row = types.properties[property]
.. found = property-default(if row.owner != no-type then row.owner else type, row.name)

────────────────────
+ value-unit InstanceId
    - place U32

` The instance whose facts the value written for a property has, by the property's place
` among all of them, or no instance: the type pass typed none, or the program makes no value
` of the property's type. It is kept for each property, so a worker reads no table of
` instances.
if place < default-count then value-units[place] else no-instance

────────────────────
+ first-read FactId
    - unit InstanceId

` The first of the properties the value an instance types reads of its receiver, or no fact.
read-heads[unit]

────────────────────
+ next-read FactId
    - read FactId

read-links[read]

────────────────────
_ do find-unit InstanceId
    - type TypeId
    - place U32
    - given PropertyDefault

` The instance that types the value written for a property of a type. A stored property's
` value is typed for each type that holds it. A lazy property of a class has one function,
` which the classes below share, and its value is typed for the class that writes it, as
` the type holds that class. So is a state machine a property of a class holds, whose
` functions the classes below share.
if given.value == 0
    = no-instance
. property = types.properties[place]
. receiver = type
. machine = program.modules[given.module].tree.declared-machine(given.value) != 0
if (property.storage-kind == .storage-lazy || machine) && is-class(type)
    . writer = declaring(type, property.name)
    if writer != no-type
        receiver = writer
= instances.find-initializer(given.module, given.decl, receiver)

────────────────────
_ do property-default PropertyDefault
    - type TypeId
    - name Atom

` The value written for a property in the nearest class that declares it, from a class up
` through its bases: by the declaration of it that writes one, where the class has two. A
` property's row names the nearest class that declares it, so the search from there ends
` where it starts.
. current = type
while current != no-type
    do match? types.rows[current]
        | .type-class(row)
            . member = valued-property(program, row.module, row.decl, name)
            do match? program.modules[row.module].decls[member]
                | .decl-property(property)
                    if member != 0
                        = PropertyDefault(row.module, property.value, property.syntax, member)
    current = types.completions[current].base
= PropertyDefault(0, 0, 0, 0)

────────────────────
_ tuple-default PropertyDefault
    - type TypeId
    - fields TypeId
    - name Atom

PropertyDefault(tuple.module, 0, written-field(program, tuple, name), 0)

.. tuple = written-tuple(types, type, fields)

────────────────────
_ do build-class-tables

` A table for each class the program constructs and for each of its bases. A class's own
` part of its table holds the functions emitted with that class as receiver that are chosen
` by the class of the object: every converter, and each method, getter and setter that some
` class declares again, in the order `member-order` gives them. A subclass's table repeats its base's part, so a slot means the same
` in both, and puts in a slot the function the subclass declares again, when that is emitted.
` Each lazy property has a slot too, in the part of the class that first declares it: it
` holds the function of the property for the table's class, or nothing for a class the
` program constructs no object of and that takes the value from no class it does. So has
` each interface an object of the class is converted to, in the part of the class first
` converted: it holds the witness table of the table's class for the interface.
. type-count U32 = types.rows.length as U32
. function-count U32 = functions.length as U32
. instance-count U32 = instances.length as U32
table-symbols = arena.allocate'U32(type-count)
name-type-constants(type-count)
build-property-tables(type-count)
table-indexes = arena.allocate'U32(type-count)
first-members = arena.allocate'U32(type-count)
next-members = arena.allocate'U32(function-count)
raising = arena.allocate'Byte(instance-count + 1)
replacing = arena.allocate'U32(instance-count + 1)
adapting = arena.allocate'U32(instance-count + 1)
for position in 0 .. < type-count
    table-symbols[position] = no-string
    table-indexes[position] = U32.max
    first-members[position] = no-function
for position in 0 .. < function-count
    next-members[position] = no-function
for position in 0 .. < instance-count
    raising[position] = 0
    replacing[position] = no-function
    adapting[position] = no-function
. members [U32]
for id in 0 .. < function-count
    . instance = functions[id].instance
    if instance == no-instance || functions[id].kind != .instance-body
        continue
    . row = instances.rows[instance]
    if is-class(row.self-type) && holds-slot(instance)
        members += id
. ordered-members = sort(members) • using :: a, b => member-order(a, b)
for offset in 0 .. < ordered-members.length
    . id = ordered-members[ordered-members.length - 1 - offset]
    . self-type = instances.rows[functions[id].instance].self-type
    next-members[id] = first-members[self-type]
    first-members[self-type] = id
for id in 0 .. < function-count
    . instance = functions[id].instance
    if instance == no-instance || functions[id].kind != .instance-body
        continue
    . row = instances.rows[instance]
    do match? program.modules[row.module].decls[row.decl]
        | .decl-function(fn)
            if constructs(fn.kind) && is-class(row.self-type)
                table-for(row.self-type)
for index in 0 .. < witnesses.length
    if is-class(witnesses[index].value)
        table-for(witnesses[index].value)
for pair in facts.dynamic-witnesses
    if is-class(pair.value)
        table-for(pair.value)
build-witness-tables()

────────────────────
_ member-order Comparison
    - function U32
    - other U32

` Orders two functions of members of classes as their instances go (`declaration-order`).
declaration-order(functions[function].instance, functions[other].instance)

────────────────────
_ interface-order Comparison
    - interface TypeId
    - other TypeId

ordered(types.stable-keys[interface], types.stable-keys[other])

────────────────────
_ declaration-order Comparison
    - instance InstanceId
    - other InstanceId

` Orders two instances by the module and the declaration of each, and then by their stable
` keys, an order that does not depend on the order typing made them in.
|? row.module != against.module
    ordered(row.module, against.module)
|? row.decl != against.decl
    ordered(row.decl, against.decl)
??
    ordered(instance-key(instance), instance-key(other))

.. row = instances.rows[instance]
.. against = instances.rows[other]

────────────────────
_ do order-prototypes

` Numbers the slots that the section of each interface gives its functions called through a
` value, which reaching them numbered in the order it met them, in the order of their
` declarations instead (`declaration-order`), and lists them so.
. listed [InstanceId]
for position in 0 .. < prototypes.length
    listed += prototypes[position]
. ordered-protos = sort(listed) • using :: a, b => declaration-order(a, b)
for proto in ordered-protos
    slot-counts[instances.rows[proto].self-type] = 0
prototypes = new-id-list(arena, 4)
for proto in ordered-protos
    . owner = instances.rows[proto].self-type
    slots[proto] = slot-counts[owner]
    slot-counts[owner] += 1
    prototypes = prototypes.appended(arena, proto)

────────────────────
_ do proto-place U32
    - start U32
    - proto U32

` Where among the entries of a table being built, from `start`, one stands for a prototype.
for position in start .. < table-entries.length
    if table-protos[position] == proto
        = position - start
= no-slot-index

────────────────────
+ do dynamic-slot U32
    - type TypeId
    - interface TypeId

` Where the table of a class keeps the table of an interface that classes below it declare
` (`record-dynamic-witness`): the slot holds the table of the object's class, or nothing where
` its class declares none. None where the class has no table.
. index = table-indexes[type]
if index == U32.max
    = no-slot-index
. entries = class-tables[index].entries
for position in entries.start .. < entries.start + entries.count
    if table-protos[position] == witness-proto + interface
        = position - entries.start
= no-slot-index

────────────────────
_ do holds-slot Bool
    - instance InstanceId

` Whether an emitted instance with a class as receiver has a slot of its own in that
` class's table: a converter, or a method, getter or setter that some class declares again.
. row = instances.rows[instance]
do match? program.modules[row.module].decls[row.decl]
    | .decl-converter
        = true
    | .decl-function(fn)
        . member = fn.kind == .function-decl || fn.kind == .getter-decl || fn.kind == .setter-decl
        = member && !fn.is-static && fn.owner != 0 && overridden[instance] != 0
= false

────────────────────
_ do replace-for
    - type TypeId
    - placed Bool

` Places beside each function the one a class declares in its place, and the function that
` converts what that answers where one is made, so that the slots a class inherits are
` filled without reading the class's overrides for each, or takes them away again.
. made = class-override-heads[type]
while made != no-fact
    . fact = facts.overrides[made]
    replacing[fact.base] = if placed then instance-functions[fact.override] else no-function
    adapting[fact.base] = if placed then override-adapters[made] else no-function
    made = class-override-links[made]

────────────────────
_ do agrees Bool
    - proto InstanceId
    - entry FunctionId

` Whether a function can answer in a slot made for another: it takes as many arguments, and
` each of them and what it returns is held as the other's is.
. other = functions[entry].instance
. mine = instances.signatures[proto]
. theirs = instances.signatures[other]
if mine.args.count != theirs.args.count
    = false
if layouts.values[mine.returns] != layouts.values[theirs.returns]
    = false
for position in 0 .. < mine.args.count
    . held = layouts.values[instances.argument-type(proto, position)]
    if held != layouts.values[instances.argument-type(other, position)]
        = false
= true

────────────────────
+ is-recursive Bool
    - instance InstanceId

instance < instances.length && recursive[instance] != 0

────────────────────
+ is-bounded Bool
    - instance InstanceId

` Whether a function that runs where the collector never sees it reaches no safepoint and
` cannot panic, so that a call of it from outside that zone need not enter the zone.
instance < instances.length && bounded[instance] != 0

────────────────────
+ do mark-bounded
    - instance InstanceId

bounded[instance] = 1

────────────────────
+ finish-of U32
    - function FunctionId

if instance < instances.length then finishes[instance] else U32.max

.. instance = functions[function].instance

────────────────────
+ do asks-inline Bool
    - instance InstanceId

. row = instances.rows[instance]
do match? program.modules[row.module].decls[row.decl]
    | .decl-function(fn)
        do match? program.modules[row.module].tree.nodes[fn.syntax]
            | .node-function-syntax(syntax)
                = syntax.is-inline
    | .decl-converter(converter)
        do match? program.modules[row.module].tree.nodes[converter.syntax]
            | .node-converter-syntax(syntax)
                = syntax.is-inline
= false

────────────────────
+ is-overridden Bool
    - callee InstanceId

` Whether some subclass declares a method or a converter again, so that a call of it must
` choose by the object's class.
overridden[callee] != 0

────────────────────
+ raises-through Bool
    - callee InstanceId

` Whether a call through the slot of an instance may panic: some function a table holds in
` that slot may.
raising[callee] != 0

────────────────────
_ do runs-polling-rule Bool
    - instance InstanceId

` Whether a constructor of a class, or the function that fills an object with its class's
` markup, first runs a rule of the class whose body has a loop that polls: the rule's body
` runs in that function then.
. row = instances.rows[instance]
if !is-class(row.self-type)
    = false
. rules [U32]
do match? program.modules[row.module].decls[row.decl]
    | .decl-function(fn)
        if constructs(fn.kind)
            rules = class-rules-of(row.self-type)
        else if fn.is-content
            rules = markup-rules-of(row.self-type)
for index in rules
    . unit = class-rules[index].unit
    if unit != no-instance && instances.rows[unit].polls
        = true
= false

────────────────────
_ constructs Bool
    - kind DeclKind

kind == .constructor-decl || kind == .default-constructor-decl || kind == .cast-constructor-decl

────────────────────
+ is-class Bool
    - type TypeId

types.is-class-type(type)

────────────────────
_ do table-for U32
    - type TypeId

` The table of a class, built after its base's.
if table-indexes[type] != U32.max
    = table-indexes[type]
. base = types.completions[type].base
. base-index = U32.max
if base != no-type && is-class(base)
    base-index = table-for(base)
. start U32 = table-entries.length
if base-index != U32.max
    . inherited = class-tables[base-index].entries
    replace-for(type, true)
    for position in inherited.start .. < inherited.end
        . proto = table-protos[position]
        . entry = no-function
        if proto >= lazy-proto
            . root = proto - lazy-proto
            . mine = place-of(type, types.properties[root].name)
            if mine != U32.max && types.properties[mine].storage-kind == .storage-lazy
                lazy-slots[mine] = position - inherited.start
                lazy-roots[mine] = root
                entry = lazy-functions[mine]
            if entry == no-function
                entry = table-entries[position]
            if entry != no-function && functions[entry].may-panic
                lazy-raising[root] = 1
            note-lazy-result(root, entry)
        else if proto >= witness-proto
            entry = witness-of(type, proto - witness-proto)
            if entry != no-slot-index
                witnesses[entry].slot = position - inherited.start
        else
            entry = replacing[proto]
            if entry == no-function
                entry = table-entries[position]
            else
                functions[entry].carries = true
                . adapted = adapting[proto]
                if adapted != no-function
                    entry = adapted
                else if !agrees(proto, entry)
                    . row = instances.rows[functions[entry].instance]
                    refusals.append
                        - Refusal
                            - .refused-function
                            - row.module
                            - row.subtree.start + row.subtree.count - 1
            if functions[entry].may-panic
                raising[proto] = 1
        table-entries = table-entries.appended(arena, entry)
        table-protos = table-protos.appended(arena, proto)
    replace-for(type, false)
. member = first-members[type]
while member != no-function
    slots[functions[member].instance] = table-entries.length - start
    functions[member].carries = true
    if functions[member].may-panic
        raising[functions[member].instance] = 1
    table-entries = table-entries.appended(arena, member)
    table-protos = table-protos.appended(arena, functions[member].instance)
    member = next-members[member]
. range = types.completions[type].properties
for offset in 0 .. < range.count
    . place = range.start + offset
    if types.properties[place].storage-kind != .storage-lazy || lazy-slots[place] != no-slot-index
        continue
    lazy-slots[place] = table-entries.length - start
    lazy-roots[place] = place
    . written = lazy-functions[place]
    if written != no-function && functions[written].may-panic
        lazy-raising[place] = 1
    note-lazy-result(place, written)
    table-entries = table-entries.appended(arena, written)
    table-protos = table-protos.appended(arena, lazy-proto + place)
. interfaces [TypeId]
for index in 0 .. < witnesses.length
    if witnesses[index].value == type && witnesses[index].slot == no-slot-index
        interfaces += witnesses[index].interface
for pair in facts.dynamic-witnesses
    if pair.value == type && unslotted && interfaces.find(pair.interface) == null
        interfaces += pair.interface
    .. unslotted = proto-place(start, witness-proto + pair.interface) == no-slot-index
. ordered-interfaces = sort(interfaces) • using :: a, b => interface-order(a, b)
for interface in ordered-interfaces
    . entry = witness-of(type, interface)
    if entry != no-slot-index && witnesses[entry].slot == no-slot-index
        witnesses[entry].slot = table-entries.length - start
        table-entries = table-entries.appended(arena, entry)
    else
        table-entries = table-entries.appended(arena, no-function)
    table-protos = table-protos.appended(arena, witness-proto + interface)
. key = hex-text(types.stable-keys[type])
. symbol = bundle.intern("ctable.$key")
. index U32 = class-tables.length as U32
class-tables.append(ClassTable(type, symbol, base-index, Span(start, table-entries.length - start)))
table-indexes[type] = index
table-symbols[type] = symbol

. rtti = name-type-constant(type)
add-type-constant(type)
. first U32 = bundle.constant-items.length as U32
if base-index != U32.max
    bundle.constant-items.append(ConstantItem(.label-constant, 0, class-tables[base-index].symbol))
else
    bundle.constant-items.append(ConstantItem(.quad-constant, 0, no-string))
bundle.constant-items.append(ConstantItem(.label-constant, 0, rtti))
for position in start .. < table-entries.length
    . proto = table-protos[position]
    if table-entries[position] == no-function
        bundle.constant-items.append(ConstantItem(.quad-constant, 0, no-string))
    else if proto >= witness-proto && proto < lazy-proto
        bundle.constant-items.append
            - ConstantItem(.label-constant, 0, witnesses[table-entries[position]].symbol)
    else
        . entry = functions[table-entries[position]].symbol
        bundle.constant-items.append(ConstantItem(.label-constant, 0, entry))
. count U32 = (bundle.constant-items.length - first) as U32
bundle.constant-tables.append(ConstantTable(symbol, 8, Span(first, count)))
= index

────────────────────
_ do build-witness-tables

` The constant of each witness table: a section for the interface and for each it is
` derived from, each the type's name and key, the function that compares two values of the
` type or nothing, the table of the type's class or nothing, and a slot for each prototype
` of the section's interface, which holds what answers it for the type. A slot the
` interface's own function fills is called through the table, so that function writes the
` panic signal. In the section of an interface the table's own is derived from, the slot
` holds the function that runs it as the type does, where the type pass noted one, and has
` no shape without one where the function may panic. Nor has a table of an interface that
` reaches another by two ways, whose sections a value seen as one of them does not find
` where its own table has them.
for index in 0 .. < witnesses.length
    . row = witnesses[index]
    . rtti = name-type-constant(row.value)
    add-type-constant(row.value)
    . order [TypeId]
    gather-sections(row.interface, order)
    . seen [TypeId]
    . shared = reaches-twice(row.interface, seen)
    if shared
        refuse-table(row.interface)
    . first U32 = bundle.constant-items.length as U32
    for section in order
        bundle.constant-items.append(ConstantItem(.label-constant, 0, rtti))
        if equality-functions[index] != no-function
            bundle.constant-items.append
                - ConstantItem(.label-constant, 0, functions[equality-functions[index]].symbol)
        else
            bundle.constant-items.append(ConstantItem(.quad-constant, 0, no-string))
        if is-class(row.value) && table-symbols[row.value] != no-string
            bundle.constant-items.append(ConstantItem(.label-constant, 0, table-symbols[row.value]))
        else
            bundle.constant-items.append(ConstantItem(.quad-constant, 0, no-string))
        for position in 0 .. < prototypes.length
            . proto = prototypes[position]
            if instances.rows[proto].self-type != section
                continue
            . made = witness-made[pair-key(row.value, proto)] ?? own-function
            if made == own-function && section != row.interface
                made = witness-based[pair-key(row.value, proto)] ?? own-function
            . target = if made == own-function then instance-functions[proto] else witness-function
                .. witness-function = witness-functions[made].function
            if made == own-function && target != no-function
                functions[target].carries = true
                . written = instances.rows[proto]
                if shared || !is-class(row.value) || (section != row.interface && written.may-panic)
                    refusals.append
                        - Refusal
                            - .refused-function
                            - written.module
                            - written.subtree.start + written.subtree.count - 1
            if target == no-function
                bundle.constant-items.append(ConstantItem(.quad-constant, 0, no-string))
            else
                bundle.constant-items.append
                    - ConstantItem(.label-constant, 0, functions[target].symbol)
    . count U32 = (bundle.constant-items.length - first) as U32
    bundle.constant-tables.append(ConstantTable(row.symbol, 8, Span(first, count)))

────────────────────
_ do name-type-constants
    - type-count U32

` Names the constant of each type some value is the type of: a worker reads the name, and
` the constant is added after the workers for the types their code named.
rtti-symbols = arena.allocate'U32(type-count + 1)
rtti-states = arena.allocate'Byte(type-count + 1)
for position in 0 .. < type-count
    rtti-symbols[position] = no-string
    rtti-states[position] = 0
for position in types.ranked
    . completion = types.completions[position]
    if completion.completion == .completion-done && completion.intrinsic == .type-info
        do match? types.rows[position]
            | .type-class(row)
                if row.args.count == 1
                    name-type-constant(types.child-type(row.args, 0))

────────────────────
_ do build-property-tables
    - type-count U32

property-tables = arena.allocate'U32(type-count + 1)
for position in 0 .. < type-count + 1
    property-tables[position] = no-string
. reflected = arena.allocate'Byte(type-count + 1)
for position in 0 .. < type-count + 1
    reflected[position] = 0
. marked [TypeId]
for read in facts.property-reads
    if read == no-type || read == invalid-type
        continue
    if types.completions[read].intrinsic == .interface
        for type in types.ranked
            if is-class(type) && answers-interface(type, read)
                mark-properties(type, reflected, marked)
    else if is-class(read)
        for type in types.ranked
            if type == read || (is-class(type) && derives(type, read))
                mark-properties(type, reflected, marked)
    else
        mark-properties(read, reflected, marked)
. position = 0
while position < marked.length
    . type = marked[position]
    position += 1
    . range = types.completions[type].properties
    for offset in 0 .. < range.count
        . place = range.start + offset
        if reflected-field(type, place).layout != no-layout
            . held = types.properties[place].type
            if intrinsic-is-tuple-like(types.completions[held].intrinsic)
                mark-properties(held, reflected, marked)
for type in types.ranked
    if reflected[type] != 0
        property-tables[type] = bundle.intern("props.${hex-text(types.stable-keys[type])}")
for type in types.ranked
    if property-tables[type] != no-string
        add-property-table(type)

────────────────────
_ do mark-properties
    - type TypeId
    - reflected CPointer'Byte
    - marked [TypeId]

if reflected[type] != 0
    =
if is-class(type)
    if layouts.objects[type] == no-layout
        =
else if !intrinsic-is-tuple-like(types.completions[type].intrinsic)
    =
else if layouts.values[type] == no-layout || !layouts.is-struct(layouts.values[type])
    =
reflected[type] = 1
marked += type

────────────────────
_ do answers-interface Bool
    - type TypeId
    - interface TypeId

. current = type
while current != no-type && current != invalid-type
    if current == interface
        = true
    for implemented in types.interfaces-of(current)
        if answers-interface(implemented, interface)
            = true
    current = types.completions[current].base
= false

────────────────────
_ reflected-field LayoutField
    - type TypeId
    - place Index

|? property.storage-kind != .storage-eager || property.slot == U32.max
    none
|? property.type == no-type || property.type == invalid-type
    none
|? is-class(type)
    layouts.field(layouts.objects[type], object-header-fields + property.slot)
??
    layouts.field(layouts.values[type], property.slot)

.. property = types.properties[place]
.. none = LayoutField(0, no-layout)

────────────────────
_ do add-property-table
    - type TypeId

. key = hex-text(types.stable-keys[type])
. range = types.completions[type].properties
. names [StringId]
for offset in 0 .. < range.count
    . place = range.start + offset
    if reflected-field(type, place).layout != no-layout
        . property = types.properties[place]
        names += add-literal("props.name.$key.${names.length}", property.name.text)
        name-type-constant(property.type)
        add-type-constant(property.type)
. first U32 = bundle.constant-items.length as U32
bundle.constant-items.append(ConstantItem(.quad-constant, names.length as U64, no-string))
. listed = 0
for offset in 0 .. < range.count
    . place = range.start + offset
    . field = reflected-field(type, place)
    if field.layout == no-layout
        continue
    . held = types.properties[place].type
    bundle.constant-items.append(ConstantItem(.label-constant, 0, names[listed]))
    bundle.constant-items.append(ConstantItem(.label-constant, 0, rtti-symbols[held]))
    bundle.constant-items.append(ConstantItem(.quad-constant, field.offset, no-string))
    bundle.constant-items.append
        - ConstantItem(.quad-constant, layouts.rows[field.layout].size, no-string)
    bundle.constant-items.append(ConstantItem(.quad-constant, property-kind(held), no-string))
    listed += 1
. count U32 = (bundle.constant-items.length - first) as U32
bundle.constant-tables.append(ConstantTable(property-tables[type], 8, Span(first, count)))

────────────────────
_ property-kind U64
    - type TypeId

|? intrinsic-is-tuple-like(kind)
    0
|? kind == .bool
    4
|? intrinsic-is-float(kind)
    1
|? is-integer-kind(kind)
    if types.completions[type].is-signed then 2 else 3
|? intrinsic-is-class(kind) || kind == .string
    5
??
    6

.. kind = types.completions[type].intrinsic

────────────────────
_ do name-type-constant StringId
    - type TypeId

if type == no-type || type == invalid-type
    = no-string
if rtti-symbols[type] == no-string
    rtti-symbols[type] = bundle.intern("rtti.${hex-text(types.stable-keys[type])}")
= rtti-symbols[type]

────────────────────
+ do want-type-constant
    - type TypeId

` Notes that emitted code names a type's constant.
if rtti-states[type] == 0
    rtti-states[type] = 1

────────────────────
+ do add-type-constants

` Adds the constant of each type emitted code named, in the order of the types: the type's
` name, its key, and its property table or zero.
for type in types.ranked
    if rtti-states[type] == 1
        add-type-constant(type)

────────────────────
_ do add-type-constant
    - type TypeId

if rtti-states[type] == 2
    =
rtti-states[type] = 2
. key = hex-text(types.stable-keys[type])
. short-name = add-literal("rtti.name.$key", type-runtime-name(types, type))
. key-name = add-literal("rtti.key.$key", type-runtime-key(types, type))
. first U32 = bundle.constant-items.length as U32
bundle.constant-items.append(ConstantItem(.label-constant, 0, short-name))
bundle.constant-items.append(ConstantItem(.label-constant, 0, key-name))
if property-tables[type] != no-string
    bundle.constant-items.append(ConstantItem(.label-constant, 0, property-tables[type]))
else
    bundle.constant-items.append(ConstantItem(.quad-constant, 0, no-string))
bundle.constant-tables.append(ConstantTable(rtti-symbols[type], 8, Span(first, 3)))

────────────────────
_ do add-literal StringId
    - name String
    - text String

` A string the object's tables point at, with the header a string of the program has.
. symbol = bundle.intern(name)
. bytes = bundle.copy-bytes(ByteSpan(text, text.size))
. header = measure-string(bytes)
bundle.literals.append(StringLiteral(symbol, header.character-length, header.flags, bytes))
= symbol

────────────────────
_ do instance-display String
    - instance InstanceId

` The name a stack trace prints for an instance's function, as the TypeScript compiler
` spells it: the module, the owner when there is one, and the function's own name; the
` function that fills an object with the markup of a class is `content`, numbered.
. row = instances.rows[instance]
. owner-module = program.modules[row.module]
. prefix = owner-module.name
do match? owner-module.decls[row.decl]
    | .decl-function(fn)
        if fn.kind == .termination-panic-decl
            = "$prefix:task-termination-panic"
        if fn.kind == .machine-decl
            = "$prefix:state-machine"
        if is-closure-like(fn.kind) || fn.kind == .task-decl || fn.kind == .region-decl
            = "$prefix:${callee-name(instance)}"
        if rule-match(program, row.module, row.decl) != 0 && fn.name
            . fn-name = fn.name
            . rank = made-ranks[instance] ?? 1
            . number = if rank < 2 then "" else "$rank"
            = "$prefix:${fn-name.text}-direct${number}-direct"
        if fn.is-content
            . rank = made-ranks[instance] ?? 1
            . number = if rank < 2 then "" else "$rank"
            = "$prefix:content$number"
        . owner = owner-name(owner-module, fn.owner)
        . qualified = if owner != "" then "$prefix:$owner" else prefix
        if fn.is-generated
            . generated = "$qualified:$owner"
            if fn.kind == .tuple-constructor-decl
                generated = "$generated:tuple"
                for position in 0 .. < instances.signatures[instance].args.count
                    generated = "$generated:$position"
            = generated
        . name = fn.name
        if name
            = "$qualified:${name.text}"
    | .decl-converter(converter)
        . owner = owner-name(owner-module, converter.owner)
        . qualified = if owner != "" then "$prefix:$owner" else prefix
        = "$qualified:${converter-name(row.module, row.decl)}"
    | .decl-fromverter(fromverter)
        . owner = owner-name(owner-module, fromverter.owner)
        . qualified = if owner != "" then "$prefix:$owner" else prefix
        = "$qualified:${converter-name(row.module, row.decl)}"
= "$prefix:?"

────────────────────
_ do callee-name String
    - instance InstanceId

` The name of an instance's function alone. A closure's is the variable it is written for,
` numbered where it is not the first closure of that name; the functions generated for
` comprehensions, lists of bullets and the right sides of pipes are named and numbered so.
if instance == no-instance
    = "?"
. row = instances.rows[instance]
do match? program.modules[row.module].decls[row.decl]
    | .decl-function(fn)
        if fn.kind == .task-decl || fn.kind == .region-decl
            . task = if fn.kind == .task-decl then task-name(instance) else "GCFreeRegion"
            . numbered = closure-ranks[closure-key(row.module, row.decl, row.enclosing)] ?? 1
            = if numbered > 1 then "$task$numbered" else task
        if is-closure-like(fn.kind)
            . name = closure-name
                - program
                - row.module
                - row.decl
                - closure-property(row.module, row.decl, row.enclosing)
            . rank = closure-ranks[closure-key(row.module, row.decl, row.enclosing)] ?? 1
            if rank > 1 && fn.kind == .pipeline-decl
                = "(pipeline$rank)"
            = if rank > 1 then "$name$rank" else name
        if fn.name
            = fn.name.text
= "?"

────────────────────
_ do owner-name String
    - owner-module Module
    - owner DeclId

if owner != 0
    do match? owner-module.decls[owner]
        | .decl-class(class)
            = class.name.text
= ""

────────────────────
_ converter-name String
    - module ModuleId
    - decl DeclId

` The name of a converter: `to` or `from` and the type, numbered where it is not the first
` of that name.
if suffix > 1 then "$base$suffix" else base

.. base = converter-base(program.modules[module], decl) ?? "?"
.. suffix = converter-suffixes[closure-key(module, decl, 0)] ?? 1

────────────────────
_ do converter-base String?
    - owner-module Module
    - decl DeclId

do match? owner-module.decls[decl]
    | .decl-converter(converter)
        = "to ${type-name(owner-module.tree, converter.target-type)}"
    | .decl-fromverter(fromverter)
        = "from ${type-name(owner-module.tree, fromverter.source-type)}"
= null

────────────────────
_ do number-converters

` Numbers the converters that share a name as TypeScript claims their names when it declares
` them: module by module in the order it declares them, and in each in the order they are
` written. A name claimed already takes the next number after the last that name took that no
` name has.
. next [String = U32]
. claimed [String = Bool]
for module in program.declare-order
    . owner-module = program.modules[module]
    for decl in 0 .. < owner-module.decls.length
        . found = converter-base(owner-module, decl as DeclId)
        if !found
            continue
        . base = found
        . suffix = next[base] ?? 1
        . name = if suffix > 1 then "$base$suffix" else base
        while claimed[name] ?? false
            suffix += 1
            name = "$base$suffix"
        next[base] = suffix + 1
        claimed[name] = true
        converter-suffixes[closure-key(module, decl as DeclId, 0)] = suffix

────────────────────
_ do type-name String
    - tree AST
    - syntax SyntaxId

` A type as TypeScript's `getTypeName` writes it in the name of a converter.
if syntax == 0
    = ""
do match? tree.nodes[syntax]
    | .node-type-identifier(row)
        = row.name.text
    | .node-core-type-identifier(row)
        = row.name.text
    | .node-type-arguments(row)
        . written = type-name(tree, row.base)
        for arg in tree.children[row.args]
            written = "$written'${type-name(tree, arg)}"
        = written
    | .node-type-associated(row)
        . written = "${type-name(tree, row.owner)}.${row.name.text}"
        for arg in tree.children[row.args]
            written = "$written'${type-name(tree, arg)}"
        = written
    | .node-type-match(row)
        = type-name(tree, row.type)
    | .node-type-capture(row)
        = type-name(tree, row.type)
    | .node-type-tuple(row)
        . kind = if row.is-struct then "struct" else "tuple"
        = "$kind(${type-names(tree, row.field-types)})"
    | .node-type-list(row)
        = "list(${type-names(tree, row.patterns)})"
= ""

────────────────────
_ do type-names String
    - tree AST
    - syntaxes RowRange'SyntaxId

. written = ""
. first = true
for syntax in tree.children[syntaxes]
    if !first
        written = "$written,"
    written = "$written${type-name(tree, syntax)}"
    first = false
= written

────────────────────
_ do runs-statements Bool
    - module ModuleId

. tree = program.modules[module].tree
do match? tree.nodes[tree.root]
    | .node-top-level-syntax(row)
        for statement in tree.children[row.statements]
            if runs-statement(module, 0, tree, statement)
                = true
= false

────────────────────
+ runs-statement Bool
    - module ModuleId
    - decl DeclId
    - tree AST
    - statement SyntaxId

` Whether a statement of a function of a module runs where it is written: one that neither
` declares something nor is a comment, or a line written as a comment that is a log whose probe
` compiles.
is-executable-statement(tree, statement) || (is-comment-syntax(tree, statement) && probe-compiles)

.. probe-compiles = program.compiles-probe(module, decl, statement)

────────────────────
_ do refuse-global-initializers
    - module ModuleId
    - main InstanceId

` A global with a decoration of no meaning has no storage. One whose value runs no code is
` left unset, since nothing can read it, and one whose value runs code refuses the program.
` One each task or each thread holds its own of, or that `do with` binds, is made where it is
` first used.
. owner = program.modules[module]
. tree = owner.tree
for index in 0 .. < owner.decls.length
    do match? owner.decls[index]
        | .decl-property(property)
            if property.owner != 0 || property.value == 0 || property.is-lazy
                continue
            . decoration = if property.decoration != null then property.decoration.text else ""
            if decoration == "" || per-context || is-inert-value(tree, main, property)
                continue
            .. per-context = decoration == "task" || decoration == "thread" || decoration == "stack"
            refusals.append(Refusal(.refused-global-initializer, module, property.value))

────────────────────
_ is-inert-value Bool
    - tree AST
    - main InstanceId
    - property PropertyDecl

is-constant-form(tree, main, property.value) && !runs-code(tree, main, property)

────────────────────
_ do runs-code Bool
    - tree AST
    - main InstanceId
    - property PropertyDecl

` Whether the value written for a global, or what makes its first value, calls anything.
. first = tree.subtree-start(property.syntax)
for node in first .. < property.syntax + 1
    if facts.first-call(main, node) != no-fact
        = true
    . conversion = facts.first-conversion(main, node)
    while conversion != no-fact
        if facts.conversions[conversion].callee != no-instance
            = true
        conversion = facts.conversions[conversion].next
= false

────────────────────
_ do is-constant-form Bool
    - tree AST
    - main InstanceId
    - value SyntaxId

do match? tree.nodes[value]
    | .node-string-syntax
        = true
    | .node-integer-syntax
        = true
    | .node-float-syntax
        = true
    | .node-unary-expression(row)
        = row.op == .negative-op && is-number(tree, row.operand)
    | .node-identifier(row)
        = row.name == types.true-atom || row.name == types.false-atom
    | .node-cast-expression(row)
        = is-constant-form(tree, main, row.lhs) && is-numeric-node(main, value)
    | .node-get-expression(row)
        . bound = row.name == types.min-atom || row.name == types.max-atom
        = bound && is-type-name(tree, row.object) && is-numeric-node(main, value)
= false

────────────────────
_ is-number Bool
    - tree AST
    - value SyntaxId

match tree.nodes[value]
    | .node-integer-syntax
        true
    | .node-float-syntax
        true
    ??
        false

────────────────────
_ is-type-name Bool
    - tree AST
    - value SyntaxId

match tree.nodes[value]
    | .node-type-identifier
        true
    ??
        false

────────────────────
_ is-numeric-node Bool
    - main InstanceId
    - node SyntaxId

|? type == no-type || type == invalid-type
    false
??
    intrinsic-is-numeric(kind) && kind != .cpointer

.. type = facts.node-type(main, node)
.. kind = types.completions[type].intrinsic

━━━━━━━━━━━━━━━━━━━━
+ is-executable-statement Bool
    - tree AST
    - statement SyntaxId

` Whether a module's statement runs when the module starts: one that neither declares
` something nor is a comment.
!is-declaration-syntax(tree, statement) && !is-comment-syntax(tree, statement)

━━━━━━━━━━━━━━━━━━━━
_ do is-literal-value Bool
    - types Types
    - source AST
    - syntax SyntaxId

` Whether an expression is a constant that running no code gives: a number, a text, or one of
` the two truths.
do match? source.nodes[syntax]
    | .node-integer-syntax
        = true
    | .node-float-syntax
        = true
    | .node-string-syntax
        = true
    | .node-identifier(row)
        = row.name == types.true-atom || row.name == types.false-atom
= false

━━━━━━━━━━━━━━━━━━━━
_ unnamed-function EmittedFunction
    - kind FunctionKind
    - instance InstanceId
    - module ModuleId
    - weight U32

` A function's row before the tables name it and list its calls.
EmittedFunction
    - kind
    - instance
    - module
    - no-string
    - no-string
    - no-string
    - Span()
    - weight
    - false
    - false

━━━━━━━━━━━━━━━━━━━━
+ do symbol-name String
    - target Target
    - key String

` The linker's name on a target for a function: its key, or a hash of the key when the key is too
` long for a symbol.
if key.size <= max-symbol-bytes
    = target.symbol(key)
. hash = fnv-hash(key, key.size)
. text = Byte[17]
text[0] = 121
for position in 0 .. < 16
    . digit = ((hash /zrshift/ (60 - position * 4)) /and/ 15) as U32
    text[1 + position] = (if digit < 10 then digit + 48 else digit + 87) as Byte
= target.symbol(text.slice-string(0 .. < 17))
