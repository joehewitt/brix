  (fn-expr + stops-at-close Bool
    (param machine MachineFact)
    ; Whether a machine is one a class's property holds or its markup writes, and none it refines,
    ; which gives the event runtime what stops it as it starts, for the object's `close` to run
    ; (`event-stop-machines`).
    (and has-stop is-owned (== (. machine outer) 0) (== (. machine refined) no-instance))
    (where
      (lazy has-stop (!= (. facts machine-stop) no-instance))
      (lazy is-owned (or (== (. machine store) .store-member) (== (. machine store) .store-content)))
    )
  )
  (fn-expr + stream-action-of FunctionId
    (param instance InstanceId)
    (param arm SyntaxId)
