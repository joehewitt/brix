    (where
      (lazy found ([] rule-function-rows index))
    )
  )
  (fn-expr + domain-number U32
    (param domain U32)
    ; The number the style runtime knows a domain of invalidation by: its place in the order the
    ; style module's init registers the domains in (`Facts.domain-order`), which does not depend on
    ; the order typing first named them in, as their places among `style-domains` do.
    ([] domain-numbers domain)
  )
  (fn-do + property-mask U32
    (param property U32)
    (param parent Bool)
    ; The mask of the domains of invalidation a change to a property of `style-properties` raises on
    ; the node, or on its parent, a bit for each domain's number (`domain-number`), from the
    ; property's rows of `property-domains`. A domain no instance names any longer has no number and
    ; no bit.
    (let mask 0u32)
    (for (in row (. facts property-domains))
      (if (and (== (. row property) property) (== (. row parent) parent) (!= ([] domain-numbers (. row domain)) (. U32 max)))
        (= mask (/or/ mask (/lshift/ 1u32 ([] domain-numbers (. row domain)))))
      )
