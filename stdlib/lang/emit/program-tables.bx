  (fn-do + metric-key String
    (param instance InstanceId)
    (param syntax SyntaxId)
    ; The key a metric of the profile is declared under: the one its probe is written with, or for a
    ; grammar the counter the reference names for its results.
    (match? ([] (. ([] (. program modules) (. ([] (. instances rows) instance) module)) tree nodes) syntax)
      (case (call .node-probe-counter row)
        (return (. row key text))
      )
      (case (call .node-probe-group row)
        (return (if-expr (. row key) (. row key text) ""))
      )
    )
    (return "grammar.capture-results")
