          (let callee (. filled callee))
          (= (. ([] functions id) may-panic) (and (!= callee no-instance) (or callee-panics stepped-override)))
          (lazy callee-panics (. ([] (. instances rows) callee) may-panic))
          (lazy stepped-override (and (!= (. filled through count) 0) (== ([] overridden callee) 2)))
          (if (and (!= callee no-instance) (> (. ([] (. instances signatures) callee) errors count) proto-errors))
            (= (. ([] functions id) may-panic) true)
          )
          (lazy proto-errors (. ([] (. instances signatures) (. filled proto)) errors count))
          (for (in offset (..< 0 (. filled through count)))
            (let getter ([] (. facts step-callees) (+ (. filled through start) offset)))
            (if (and (!= getter no-instance) (or getter-panics (== ([] overridden getter) 2)))
              (= (. ([] functions id) may-panic) true)
            )
            (lazy getter-panics (. ([] (. instances rows) getter) may-panic))
          )
          (if (and (== callee no-instance) (< (. filled property) default-count))
            (let lazy ([] lazy-functions (. filled property)))
            (if (and (!= lazy no-function) (. ([] functions lazy) may-panic))
              (= (. ([] functions id) may-panic) true)
            )
          )
          (let memos (. layouts memo-places))
          (if (and (== callee no-instance) memos in-defaults (!= ([] memos (. filled property)) 0))
            (= (. ([] functions id) may-panic) true)
          )
          (lazy in-defaults (< (. filled property) default-count))
          (if (and (!= callee no-instance) (!= (. ([] (. instances rows) callee) subtree count) 0))
            (let written (. ([] (. instances rows) callee) subtree))
            (let passed (call (. facts first-conversion) callee (- (+ (. written start) (. written count)) 1)))
            (while (!= passed no-fact)
              (let converter (. ([] (. facts conversions) passed) callee))
              (if (and (!= converter no-instance) (. ([] (. instances rows) converter) may-panic))
                (= (. ([] functions id) may-panic) true)
              )
              (= passed (. ([] (. facts conversions) passed) next))
            )
          )
        )
      )
    )
  )
  (fn-do _ declare-adapters _
    ; A function for each closure or binding some emitted instance makes a value of a function
    ; type, for each such type, in the module that first makes one. It is called through the
    ; value, so it writes the panic signal, as a function a class table holds does.
    (for (in index (..< 0 (. adapters length)))
      (let row ([] adapters index))
      (let id FunctionId (as (. functions length) FunctionId))
      (call (. functions append)
        (block
          (arg (call unnamed-function .adapter no-instance (. ([] (. instances rows) (. row instance)) module) 8))
        )
      )
      (= (. ([] functions id) type) (. row from))
      (= (. ([] functions id) place) (as index U32))
      (= (. ([] functions id) carries) true)
      (= (. ([] adapters index) function) id)
    )
  )
  (fn-do _ index-witnesses _
    (param instance-count U32)
    ; Reads what the type pass said of interfaces: the instances of their functions called
    ; through a value, the function that answers each for each type, and the tables it found
    ; for each interface and for each type, linked in the order it found them.
    (let type-count (. types rows length))
    (= prototypes (call new-id-list arena 4))
    (= slot-counts (call (of (. arena allocate) U32) (+ type-count 1)))
    (= called-through (call (of (. arena allocate) Byte) (+ instance-count 1)))
    (for (in position (..< 0 type-count))
      (= ([] slot-counts position) 0)
    )
    (for (in position (..< 0 instance-count))
      (= ([] called-through position) 0)
    )
    (for (in proto (. facts witness-protos))
      (= ([] called-through proto) 1)
    )
    (for (in position (..< 0 (. facts witness-slots length)))
      (let slot ([] (. facts witness-slots) position))
      (if (. slot based)
        (= ([] based-fills (call pair-key (. slot value) (. slot proto))) (as position U32))
        (else
          (= ([] witness-fills (call pair-key (. slot value) (. slot proto))) (as position U32))
        )
      )
    )
    (let table-count U32 (as (. facts witness-tables length) U32))
    (= table-links (call (of (. arena allocate) U32) (+ table-count 1)))
    (= value-table-links (call (of (. arena allocate) U32) (+ table-count 1)))
    (for (in offset (..< 0 table-count))
      (let position (- table-count 1 offset))
      (let table ([] (. facts witness-tables) position))
      (= ([] table-links position) (?? ([] table-heads (. table interface)) no-slot-index))
      (= ([] table-heads (. table interface)) position)
      (= ([] value-table-links position) (?? ([] value-table-heads (. table value)) no-slot-index))
      (= ([] value-table-heads (. table value)) position)
    )
  )
  (fn-do _ reach-witness _
    (param value TypeId)
    (param interface TypeId)
    ; Notes the witness table of a type converted to an interface. A value of an interface
    ; converted to one it is derived from has its table already. The tables of classes are linked
    ; for each interface in the order they are noted.
    (if (or (== value no-type) (== value invalid-type) (== (. ([] (. types completions) value) intrinsic) .interface))
      (return)
    )
    (let key (call pair-key value interface))
    (if (!= ([] witness-rows key) null)
      (return)
    )
    (let index U32 (as (. witnesses length) U32))
    (= ([] witness-rows key) index)
    (let named (str "wtable." (call hex-text ([] (. types stable-keys) value)) "." (call hex-text ([] (. types stable-keys) interface))))
    (call (. witnesses append) (call Witness value interface (call (. bundle intern) named)))
    (+= class-witness-links no-slot-index)
    (if (not (call is-class value))
      (return)
    )
    (let tail ([] class-witness-tails interface))
    (if tail
      (= ([] class-witness-links tail) index)
      (else
        (= ([] class-witness-heads interface) index)
      )
    )
    (= ([] class-witness-tails interface) index)
  )
  (fn-do _ fill-witnesses Bool
    (param kinds (of CPointer U32))
    ; Brings what the witness tables hold into the emitted set, and says whether there was
    ; anything new to bring: the table of each class the program constructs that is derived
    ; from one converted, and for each table and each prototype of its interface or of one
    ; that is derived from, the function the type pass found for the type. A prototype the
    ; type pass found none for has no shape. The interface's own function fills the slot as it
    ; is, but in the section of an interface the table's own is derived from, where a function
    ; runs it as the type does: the frames the reference's stack traces have. A pair of a table
    ; and a prototype is settled the first time it is met, so each pass meets only the pairs
    ; that a table or a prototype added since the last one makes, in the order a pass over all
    ; of them would, and of those only the pairs where the prototype is of a section of the
    ; table.
    (if (and tables-filled (== filled-prototypes (. prototypes length)) (== filled-classes class-count))
      (return false)
    )
    (lazy tables-filled (== filled-tables (. witnesses length)))
    (let compared-classes filled-classes)
    (= filled-classes class-count)
    (let compared U32 filled-tables)
    (let compared-prototypes U32 filled-prototypes)
    (call derive-tables compared-classes)
    (= filled-tables (as (. witnesses length) U32))
    (= filled-prototypes (. prototypes length))
    (for (in index (..< compared filled-tables))
      (let equality (call (. facts equality-of) (. ([] witnesses index) value) (. ([] witnesses index) interface)))
      (if (and (!= equality no-instance) (== ([] kinds equality) (. Reach none)))
        (= ([] kinds equality) (. Reach in-frame))
        (= ([] reach-queue reach-length) equality)
        (+= reach-length 1)
      )
    )
    (while (< (. proto-sections length) filled-prototypes)
      (+= proto-sections (. ([] (. instances rows) ([] prototypes (. proto-sections length))) self-type))
    )
    (for (in index (..< 0 filled-tables))
      (let first (if-expr (< index compared) compared-prototypes 0))
      (let row ([] witnesses index))
      (let sections ([] section-ranges (call sections-of (. row interface))))
      (for (in position (..< first filled-prototypes))
        (let section ([] proto-sections position))
        (for (in offset (..< 0 (. sections count)))
          (if (== ([] section-items (+ (. sections start) offset)) section)
            (call fill-witness kinds row ([] prototypes position) section)
          )
        )
      )
    )
    (return true)
  )
  (fn-do _ derive-tables _
    (param compared-classes U32)
    ; Notes the table of each class the program constructs that is derived from a class a table
    ; was noted for, for the same interface (`fill-witnesses`), in the order a pass over each
    ; table and each table the type pass found for its interface would note them. The tables this
    ; met before meet only the classes constructed since its last pass, `compared-classes` on; the
    ; others meet every class.
    (let known U32 (as (. witnesses length) U32))
    (let found (list U64))
    (for (in place (..< compared-classes class-count))
      (let value ([] constructed-order place))
      (let position (?? ([] value-table-heads value) no-slot-index))
      (while (!= position no-slot-index)
        (let index (?? ([] class-witness-heads (. ([] (. facts witness-tables) position) interface)) no-slot-index))
        (while (and (!= index no-slot-index) (< index derived-tables))
          (if (call derives value (. ([] witnesses index) value))
            (+= found (/or/ (/lshift/ (as index U64) 32) (as position U64)))
          )
          (= index ([] class-witness-links index))
        )
        (= position ([] value-table-links position))
      )
    )
    (for (in pair (call sorted-pairs found))
      (let fact ([] (. facts witness-tables) (as (/and/ pair 0xffffffff) Size)))
      (call reach-witness (. fact value) (. fact interface))
    )
    (for (in place (..< compared-classes class-count))
      (let value ([] constructed-order place))
      (for (in pair (. facts dynamic-witnesses))
        (if (and (!= value (. pair value)) (not (call derives value (. pair value))))
          (continue)
        )
        (let position (?? ([] value-table-heads value) no-slot-index))
        (while (!= position no-slot-index)
          (if (== (. ([] (. facts witness-tables) position) interface) (. pair interface))
            (call reach-witness value (. pair interface))
          )
          (= position ([] value-table-links position))
        )
      )
    )
    (for (in index (..< derived-tables known))
      (let row ([] witnesses index))
      (if (not (call is-class (. row value)))
        (continue)
      )
      (let position (?? ([] table-heads (. row interface)) no-slot-index))
      (while (!= position no-slot-index)
        (let fact ([] (. facts witness-tables) position))
        (if (and (!= ([] constructed (. fact value)) 0) (call derives (. fact value) (. row value)))
          (call reach-witness (. fact value) (. fact interface))
        )
        (= position ([] table-links position))
      )
    )
    (= derived-tables known)
  )
  (fn-do _ fill-witness _
    (param kinds (of CPointer U32))
    (param row Witness)
    (param proto InstanceId)
    (param section TypeId)
    ; Settles the slot of one prototype in one witness table, in the section of the table that
    ; holds it, as `fill-witnesses` describes.
    (let key (call pair-key (. row value) proto))
    (let view ([] based-fills key))
    (if (and (!= view null) (!= section (. row interface)) (== ([] witness-based key) null))
      (let based ([] (. facts witness-slots) view))
      (call mark kinds (. based callee))
      (= ([] witness-based key)
        (call made-witness
          (block
            (arg (. row value))
            (arg proto)
            (arg (. based callee))
            (arg (. U32 max))
            (arg (. based through))
            (arg (. based converts))
          )
        )
      )
    )
    (if (!= ([] witness-made key) null)
      (return)
    )
    (let fill ([] witness-fills key))
    (if (== fill null)
      (let written ([] (. instances rows) proto))
      (call (. refusals append)
        (block
          (arg
            (call Refusal
              (block
                (arg .refused-function)
                (arg (. written module))
                (arg (- (+ (. written subtree start) (. written subtree count)) 1))
              )
            )
          )
        )
      )
      (= ([] witness-made key) own-function)
      (return)
    )
    (let slot ([] (. facts witness-slots) fill))
    (call mark kinds (. slot callee))
    (for (in offset (..< 0 (. slot through count)))
      (call mark kinds ([] (. facts step-callees) (+ (. slot through start) offset)))
    )
    (if (== (. slot callee) proto)
      (= ([] witness-made key) own-function)
      (else
        (= ([] witness-made key)
          (call made-witness
            (block
              (arg (. row value))
              (arg proto)
              (arg (. slot callee))
              (arg (. slot property))
              (arg (. slot through))
              (arg (. slot converts))
            )
          )
        )
      )
    )
  )
  (fn-do _ made-witness U32
    (param value TypeId)
    (param proto InstanceId)
    (param callee InstanceId)
    (param property U32)
    (param through (of RowRange U32))
    (param converts Bool)
    ; The witness function that fills a prototype's slot in a type's table with a function of the
    ; type's. A class that answers with a function called on the object as it is shares the one
    ; made for the first class that answers with that function, as the two would be the same;
    ; any other type has one of its own.
    (let shared
      (scope (and (call is-class value) (!= callee no-instance) (== (. through count) 0) (not own-errors))
        (lazy own-errors (call carries-own-errors types value))
      )
    )
    (let key (call pair-key callee proto))
    (if shared
      (let known ([] witness-shared key))
      (return-if known (if (!= known null)))
    )
    (let index U32 (as (. witness-functions length) U32))
    (call (. witness-functions append)
      (block
        (arg (call WitnessFunction value proto callee property through no-function converts shared))
      )
    )
    (if shared
      (= ([] witness-shared key) index)
    )
    (return index)
  )
  (fn-do _ sections-of U32
    (param interface TypeId)
    ; The row of `section-ranges` that holds the sections of a witness table for an interface,
    ; gathered the first time they are asked for. Only the tables' build asks, before emission
    ; reads the tables from several threads.
    (let known ([] section-rows interface))
    (if known
      (return known)
    )
    (let order (list TypeId))
    (call gather-sections interface order)
    (let row U32 (as (. section-ranges length) U32))
    (+= section-ranges (call (of RowRange TypeId) (as (. section-items length) U32) (as (. order length) U32)))
    (for (in gathered order)
      (+= section-items gathered)
    )
    (= ([] section-rows interface) row)
    (return row)
  )
  (fn-do _ gather-sections _
    (param interface TypeId)
    (param order (list TypeId))
    ; The sections of a witness table for an interface, in order: the interface, then those it
    ; is derived from, each once.
    (for (in known order)
      (if (== known interface)
        (return)
      )
    )
    (+= order interface)
    (for (in parent (call (. types interfaces-of) interface))
      (call gather-sections parent order)
    )
  )
  (fn-do _ reaches-twice Bool
    (param interface TypeId)
    (param seen (list TypeId))
    ; Whether an interface is derived from another by more than one way: gathering its
    ; sections, as `gather-sections` does, meets one already gathered.
    (for (in known seen)
      (if (== known interface)
        (return true)
      )
    )
    (+= seen interface)
    (let again false)
    (for (in parent (call (. types interfaces-of) interface))
      (if (call reaches-twice parent seen)
        (= again true)
      )
    )
    (return again)
  )
  (fn-do _ refuse-table _
    (param interface TypeId)
    ; Refuses the program for a witness table of an interface with no shape, at the interface.
    (match? ([] (. types rows) interface)
      (case (call .type-class row)
        (match? ([] (. ([] (. program modules) (. row module)) decls) (. row decl))
          (case (call .decl-class class)
            (call (. refusals append) (call Refusal .refused-type (. row module) (. class syntax)))
          )
        )
      )
    )
  )
  (fn-do _ declare-witnesses _
    ; A function for each slot of a witness table that a type fills with a function of its
    ; own. It is called through the table, so it writes the panic signal.
    (for (in index (..< 0 (. witness-functions length)))
      (let row ([] witness-functions index))
      (let id FunctionId (as (. functions length) FunctionId))
      (let module
        (scope (if-expr (== (. row callee) no-instance) (call class-module (. row value)) callee-module)
          (lazy callee-module (. ([] (. instances rows) (. row callee)) module))
        )
      )
      (call (. functions append) (call unnamed-function .witness no-instance module 8))
      (= (. ([] functions id) type) (. row value))
      (= (. ([] functions id) place) (as index U32))
      (= (. ([] functions id) carries) true)
      (= (. ([] witness-functions index) function) id)
    )
  )
  (fn-do _ declare-class-adapters _
    ; A function for each method a class's table holds in the place of one of a base class it
    ; overrides, where the two answer different types or one raises errors and the other does
    ; not. It is called through the table, so it writes the panic signal. Each override fact
    ; keeps its function, which the table takes where the fact is placed. A chain of classes
    ; has an override fact for each method of every base, so a fact reads no signature. They are
    ; declared in the order of the ranks of the overrides, then of the bases.
    (let instance-count (. instances length))
    (let answers (call (of (. arena allocate) U32) (+ instance-count 1)))
    (let results (call (of (. arena allocate) U32) (+ instance-count 1)))
    (for (in instance (..< 0 instance-count))
      (= ([] answers instance) no-type)
      (= ([] results instance) no-type)
      (if (!= ([] instance-functions instance) no-function)
        (let signature ([] (. instances signatures) instance))
        (= ([] answers instance) (. signature returns))
        (= ([] results instance) (. signature result))
      )
    )
    (let fact-count (. facts overrides length))
    (= override-adapters (call (of (. arena allocate) U32) (+ fact-count 1)))
    (let keys (list U64))
    (for (in position (..< 0 fact-count))
      (= ([] override-adapters position) no-function)
      (let row ([] (. facts overrides) position))
      (if (== (. row override) no-instance)
        (+= keys (call rank-key (. row base) (. U32 max)))
        (else
          (+= keys (call rank-key (. row override) (call (. instances rank-of) (. row base))))
        )
      )
    )
    (for (in position (call ranked-order keys))
      (let base (. ([] (. facts overrides) position) base))
      (let override (. ([] (. facts overrides) position) override))
      (if (and (== override no-instance) (!= ([] instance-functions base) no-function))
        (= ([] override-adapters position) (call declare-class-accessor ([] (. facts overrides) position)))
        (continue)
      )
      (if (or (== override no-instance) (== ([] instance-functions base) no-function) (== ([] instance-functions override) no-function))
        (continue)
      )
      (if (and (== ([] answers base) ([] answers override)) (== ([] results base) ([] results override)))
        (continue)
      )
      (let key (call pair-key base override))
      (let found ([] class-adapter-rows key))
      (if found
        (= ([] override-adapters position) (. ([] class-adapters found) function))
        (continue)
      )
      (let id FunctionId (as (. functions length) FunctionId))
      (call (. functions append)
        (block
          (arg (call unnamed-function .class-adapter no-instance (. ([] (. instances rows) override) module) 8))
        )
      )
      (= (. ([] functions id) place) (as (. class-adapters length) U32))
      (= (. ([] functions id) carries) true)
      (= ([] class-adapter-rows key) (as (. class-adapters length) U32))
      (call (. class-adapters append) (call ClassAdapter base override id))
      (= ([] override-adapters position) id)
    )
  )
  (fn-do _ declare-class-accessor FunctionId
    (param fact OverrideFact)
    ; The function a class's table holds in the slot of a getter or a setter of an interface for
    ; objects of a class that store the property in its place (`OverrideFact.property`).
    (let id FunctionId (as (. functions length) FunctionId))
    (call (. functions append) (call unnamed-function .class-adapter no-instance (. ([] (. instances rows) (. fact base)) module) 8))
    (= (. ([] functions id) place) (as (. class-adapters length) U32))
    (= (. ([] functions id) carries) true)
    (call (. class-adapters append) (call ClassAdapter (. fact base) no-instance id (. fact receiver) (. fact property)))
    (return id)
  )
  (fn-do _ declare-forwards _
    ; The function made for each member a union forwards, `union-dispatch-N`, where a stack trace
    ; names it: a case may panic or let errors out. The members that are one are found among
    ; those of the same value and union alone, and their function is placed at the first of
    ; them written in an emitted function. `N` counts the members the whole program forwards, in
    ; the order they are written. A member of a union that is no class has no function, and no
    ; shape where it needs one.
    (let count (. facts forwards length))
    (= forward-functions (call (of (. arena allocate) U32) (+ count 1)))
    (= forward-needs (call (of (. arena allocate) Byte) (+ count 1)))
    (= forward-numbers (call (of (. arena allocate) U32) (+ count 1)))
    (let members (list U32))
    (let member-heads (list U32))
    (let heads (list U32))
    (let head-links (list U32))
    (let buckets (call (of Map U64 U32) arena))
    (let keys (list U64))
    (for (in position (..< 0 count))
      (let forward ([] (. facts forwards) position))
      (= ([] forward-functions position) no-function)
      (= ([] forward-needs position) 0)
      (= ([] forward-numbers position) 0)
      (+= keys (call rank-key (. forward instance) (. forward syntax)))
    )
    (for (in position (call ranked-order keys))
      (let forward ([] (. facts forwards) position))
      (if (!= (call (. facts plan-of) (. forward instance) (. forward syntax)) .plan-forward)
        (continue)
      )
      (= ([] forward-rows (call pair-key (. forward instance) (. forward syntax))) position)
      (= ([] forward-needs position) (if-expr (or (call forward-panics forward) (!= (. forward result) no-type)) 1 0))
      (if (== ([] instance-functions (. forward instance)) no-function)
        (continue)
      )
      (+= members position)
      (let key U64 (/or/ (/lshift/ (as (. forward value) U64) 32) (as (call union-of forward) U64)))
      (let first ([] buckets key))
      (let found (. U32 max))
      (let link (?? first (. U32 max)))
      (while (and (!= link (. U32 max)) (== found (. U32 max)))
        (if (call same-plan ([] (. facts forwards) ([] heads link)) forward)
          (= found link)
        )
        (= link ([] head-links link))
      )
      (if (== found (. U32 max))
        (= found (as (. heads length) U32))
        (+= heads position)
        (+= head-links (?? first (. U32 max)))
        (= ([] buckets key) found)
        (else
          (let head ([] (. facts forwards) ([] heads found)))
          (if (call written-first (. forward instance) (. forward syntax) (. head instance) (. head syntax))
            (= ([] heads found) position)
          )
        )
      )
      (+= member-heads found)
    )
    (let made (list FunctionId))
    (let head-count (as (. heads length) U32))
    (for (in index (..< 0 head-count))
      (let head ([] heads index))
      (let placed ([] (. facts forwards) head))
      (let union (call cases-union placed))
      (+= made no-function)
      (if (or (== ([] forward-needs head) 0) (== union no-type) (== (. (call class-ref types union) decl) 0))
        (continue)
      )
      (let number U32 1)
      (for (in other (..< 0 head-count))
        (let earlier ([] (. facts forwards) ([] heads other)))
        (if (and (!= other index) before)
          (+= number 1)
        )
        (lazy before (call written-first (. earlier instance) (. earlier syntax) (. placed instance) (. placed syntax)))
      )
      (let id FunctionId (as (. functions length) FunctionId))
      (call (. functions append)
        (block
          (arg (call unnamed-function .union-dispatch no-instance (. ([] (. instances rows) (. placed instance)) module) 8))
        )
      )
      (= (. ([] functions id) place) head)
      (= ([] forward-numbers head) number)
      (= ([] made index) id)
    )
    (for (in offset (..< 0 (. members length)))
      (= ([] forward-functions ([] members offset)) ([] made ([] member-heads offset)))
    )
  )
  (fn-do _ declare-const-arrays _
    ; A constant table for each ConstArray the type pass folded: its items packed at their
    ; size, and a string as the address of a literal. They are made in the order of their instances'
    ; ranks, then of where they are written.
    (let made U32)
    (let keys (list U64))
    (for (in array (. facts const-arrays))
      (+= const-array-symbols no-string)
      (+= keys (call rank-key (. array instance) (. array syntax)))
    )
    (for (in position (call ranked-order keys))
      (let array ([] (. facts const-arrays) position))
      (if (call is-retired (. array instance))
        (continue)
      )
      (let item (call (. layouts pointee-type) (. array type)))
      (let layout (if-expr (!= item no-type) ([] (. layouts values) item) no-layout))
      (if (== layout no-layout)
        (continue)
      )
      (let size (. ([] (. layouts rows) layout) size))
      (let is-text (== item (. types string-type)))
      (let kind (call constant-kind size))
      (if (and (not is-text) (not kind))
        (continue)
      )
      (let name (str "constarray." made))
      (let first U32 (as (. bundle constant-items length) U32))
      (let tree (. ([] (. program modules) (. ([] (. instances rows) (. array instance)) module)) tree))
      (for (in offset (..< 0 (. array count)))
        (let row ([] (. facts const-items) (+ (. array first) offset)))
        (if is-text
          (let text (call tree-text tree (. row text)))
          (let literal (call add-literal (str name "." offset) text))
          (call (. bundle constant-items append) (call ConstantItem .label-constant 0 literal))
          (else
            (call (. bundle constant-items append) (call ConstantItem (!! kind) (. row bits) no-string))
          )
        )
      )
      (let symbol (call (. bundle intern) name))
      (call (. bundle constant-tables append)
        (block
          (arg (call ConstantTable symbol (if-expr is-text 8 size) (call Span first (. array count))))
        )
      )
      (= ([] const-array-rows (call pair-key (. array instance) (. array syntax))) position)
      (= ([] const-array-symbols position) symbol)
      (+= made 1)
    )
  )
  (fn-expr _ constant-kind (? ConstantKind)
    (param size U32)
    (match? size
      (case= 1
        (. ConstantKind byte-constant)
      )
      (case= 2
        (. ConstantKind short-constant)
      )
      (case= 4
        (. ConstantKind long-constant)
      )
      (case= 8
        (. ConstantKind quad-constant)
      )
    )
  )
  (fn-expr _ tree-text String
    (param tree AST)
    (param syntax SyntaxId)
    (match ([] (. tree nodes) syntax)
      (case (call .node-string-syntax row)
        (. row text)
      )
      (default
        ""
      )
    )
  )
  (fn-do _ declare-projection-remaps _
    ; A constant table of bytes for each style-sheet projection that gives a union's cases new
    ; numbers, as the reference's `styleProjectionRemapValue` lays one down: the number of the
    ; property's case for each of the slot's. The tables are numbered, and the runtime registers each
    ; by its number, in the order of what first names them: the declarations of markup elements by
    ; the stable keys of their instances and their sites, then the lines of style rules by the
    ; applications that bind their slots (`application-order`) and their sites, so that the numbers
    ; are the same in any typing order.
    (for (in _ (..< 0 (. facts style-projections length)))
      (+= remap-symbols no-string)
      (+= remap-numbers (. U32 max))
    )
    (let declarations (. facts style-declarations))
    (let declared (list U32))
    (for (in index (..< 0 (. declarations length)))
      (if (!= (. ([] declarations index) projection) (. U32 max))
        (+= declared (as index U32))
      )
    )
    (let slots (. facts rule-slots))
    (let slotted (list U32))
    (for (in index (..< 0 (. slots length)))
      (if (!= (. ([] slots index) projection) (. U32 max))
        (+= slotted (as index U32))
      )
    )
    (let by-site (call sort declared (:using (=> (a b) (call line-order (. ([] declarations a) instance) (. ([] declarations a) site) (. ([] declarations b) instance) (. ([] declarations b) site))))))
    (let by-rule (call sort slotted (:using (=> (a b) (call rule-slot-order ([] slots a) ([] slots b))))))
    (let number 0u32)
    (for (in index by-site)
      (= number (call declare-remap (. ([] declarations index) projection) number))
    )
    (for (in index by-rule)
      (= number (call declare-remap (. ([] slots index) projection) number))
    )
  )
  (fn-expr _ rule-slot-order Comparison
    (param slot RuleSlot)
    (param other RuleSlot)
    (case? (and (!= (. slot application) (. other application)) (!= placed (. Comparison equal)))
      placed
    )
    (default
      (call ordered (. slot site) (. other site))
    )
    (where
      (lazy placed (call application-order (. slot application) (. other application)))
    )
  )
  (fn-do _ declare-remap U32
    (param index U32)
    (param number U32)
    (let projection ([] (. facts style-projections) index))
    (return-if number (if (or (!= (. projection kind) 2) (!= ([] remap-numbers index) (. U32 max)))))
    (blank)
    (let first U32 (as (. bundle constant-items length) U32))
    (for (in offset (..< 0 (. projection count)))
      (let tag ([] (. facts projection-tags) (+ (. projection first) offset)))
      (call (. bundle constant-items append) (call ConstantItem .byte-constant tag no-string))
    )
    (let symbol (call (. bundle intern) (str "styleprojectionremap." number)))
    (call (. bundle constant-tables append) (call ConstantTable symbol 1 (call Span first (. projection count))))
    (= ([] remap-symbols index) symbol)
    (= ([] remap-numbers index) number)
    (return (+ number 1))
  )
  (fn-do _ declare-equalities _
    ; A function for each witness table whose interface, or one it is derived from, has its
    ; values compared: it runs the comparison of two values of the table's type the type pass
    ; made. It is called through the table, so it writes the panic signal.
    (= equality-functions (call (of (. arena allocate) U32) (+ (. witnesses length) 1)))
    (for (in index (..< 0 (. witnesses length)))
      (= ([] equality-functions index) no-function)
      (let row ([] witnesses index))
      (let compared (call (. facts equality-of) (. row value) (. row interface)))
      (if (== compared no-instance)
        (continue)
      )
      (let id FunctionId (as (. functions length) FunctionId))
      (call (. functions append)
        (block
          (arg (call unnamed-function .interface-equality compared (. ([] (. instances rows) compared) module) 8))
        )
      )
      (= (. ([] functions id) place) (as index U32))
      (= (. ([] functions id) carries) true)
      (= ([] equality-functions index) id)
    )
  )
  (fn-do _ forward-panics Bool
    (param forward ForwardFact)
    ; Whether a case of a member a union forwards may panic: its call, through any function a
    ; table holds for it, or the read of a lazy property, whose value may. A row of a table that
    ; grows is checked before its case is read, which may panic too.
    (if (== (call (. types intrinsic-of) (call union-of forward)) .table-row)
      (return true)
    )
    (let call (call (. facts first-call) (. forward instance) (. forward syntax)))
    (if (== call no-fact)
      (let union (call cases-union forward))
      (let name (call forward-name forward))
      (if (or (== union no-type) (not name))
        (return true)
      )
      (for (in fact (call (. types cases-of) union))
        (let found (call (. types property-named) (. fact type) name))
        (if (and found (== (. ([] (. types properties) found) storage-kind) .storage-lazy))
          (return true)
        )
      )
      (return false)
    )
    (while (!= call no-fact)
      (let callee (. ([] (. facts calls) call) callee))
      (if (or (== callee no-instance) (call is-prototype callee) panics (== ([] overridden callee) 2))
        (return true)
      )
      (lazy panics (. ([] (. instances rows) callee) may-panic))
      (= call (. ([] (. facts calls) call) next))
    )
    (return false)
  )
  (fn-do _ same-plan Bool
    (param left ForwardFact)
    (param right ForwardFact)
    ; Whether two members a union forwards are one to TypeScript: the same member of the same
    ; union, given arguments, or a setter a value, of the same types, by the same calls of its
    ; cases, giving the same type.
    (if (or (!= (. left value) (. right value)) (!= (call union-of left) (call union-of right)) names-differ)
      (return false)
    )
    (lazy names-differ (!= (call forward-name left) (call forward-name right)))
    (if (!= (== (. left given) 0) (== (. right given) 0))
      (return false)
    )
    (if (and (!= (. left given) 0) (!= (call (. facts node-type) (. left instance) (. left given)) right-type))
      (return false)
    )
    (lazy right-type (call (. facts node-type) (. right instance) (. right given)))
    (let given (call forward-arguments left))
    (let taken (call forward-arguments right))
    (if (!= (. given count) (. taken count))
      (return false)
    )
    (let tree (. ([] (. program modules) (. ([] (. instances rows) (. left instance)) module)) tree))
    (let other-tree (. ([] (. program modules) (. ([] (. instances rows) (. right instance)) module)) tree))
    (for (in offset (..< 0 (. given count)))
      (let mine (call argument-expression tree ([] (. tree children) (+ (. given start) offset))))
      (let theirs (call argument-expression other-tree ([] (. other-tree children) (+ (. taken start) offset))))
      (if (!= (call (. facts node-type) (. left instance) mine) (call (. facts node-type) (. right instance) theirs))
        (return false)
      )
    )
    (let one (call (. facts first-call) (. left instance) (. left syntax)))
    (let other (call (. facts first-call) (. right instance) (. right syntax)))
    (while (and (!= one no-fact) (!= other no-fact))
      (if (!= (. ([] (. facts calls) one) callee) (. ([] (. facts calls) other) callee))
        (return false)
      )
      (= one (. ([] (. facts calls) one) next))
      (= other (. ([] (. facts calls) other) next))
    )
    (return (and (== one no-fact) (== other no-fact)))
  )
  (fn-do _ forward-name (? Atom)
    (param forward ForwardFact)
    (let tree (. ([] (. program modules) (. ([] (. instances rows) (. forward instance)) module)) tree))
    (match? ([] (. tree nodes) (call forward-get forward))
      (case (call .node-get-expression get)
        (return (. get name))
      )
    )
    (return null)
  )
  (fn-do _ union-of TypeId
    (param forward ForwardFact)
    (let tree (. ([] (. program modules) (. ([] (. instances rows) (. forward instance)) module)) tree))
    (match? ([] (. tree nodes) (call forward-get forward))
      (case (call .node-get-expression get)
        (return (call (. facts node-type) (. forward instance) (. get object)))
      )
    )
    (return no-type)
  )
  (fn-expr _ cases-union TypeId
    (param forward ForwardFact)
    ; The union whose cases answer a member forwarded: the receiver, or the union a row of a table
    ; it is holds rows of.
    (if-expr (!= held no-type) held receiver)
    (where
      (lazy receiver (call union-of forward))
      (lazy held (if-expr (!= receiver no-type) (call row-union types receiver) no-type))
    )
  )
  (fn-do _ number-made _
    ; Numbers the functions made of rules and of what their patterns hold in the order they are
    ; written. Each takes a name others may take too. The function of a rule a module declares
    ; and the function a local rule runs in take the rule's name followed by `-direct`, and one
    ; made of either again, for the collectors or the errors calls give it, takes it once more.
    ; The function an action runs in is `stream-action`, the function made of a pattern given to
    ; a rule is `static-inline-match`, and the one that runs a rule given alone is the rule's
    ; with `Casting`. The function that fills an object with the markup of a class is `content`.
    ; Of the functions of one name in a module the first written has the name, and a stack trace
    ; prints the second with 2 after it, as `written-numbers` counts them.
    (let groups (list Size))
    (let places (list U64))
    (let owners (list U32))
    (for (in id (..< 0 (. functions length)))
      (let group (call made-group ([] functions id)))
      (+= groups group)
      (+= owners (call (. instances rank-of) (. ([] functions id) instance)))
      (if (== group 0)
        (+= places 0)
        (else
          (+= places (call made-place ([] functions id)))
        )
      )
    )
    (let numbers (call written-numbers groups places owners))
    (for (in id (..< 0 (. functions length)))
      (if (== ([] groups id) 0)
        (continue)
      )
      (= ([] made-numbers id) ([] numbers id))
      (if (== (. ([] functions id) kind) .instance-body)
        (= ([] made-ranks (. ([] functions id) instance)) ([] numbers id))
      )
    )
  )
  (fn-do _ made-group Size
    (param function EmittedFunction)
    ; The name a function shares with the others `number-made` counts with it, as a key: the
    ; kind of name, the module that shows it and the name. None for a function it does not
    ; number.
    (if (== (. function kind) .stream-action)
      (return (call made-key 1 (. function module) 0))
    )
    (if (== (. function kind) .pattern-helper)
      (return (call made-key 2 (. function module) 0))
    )
    (if (== (. function kind) .pattern-cast)
      (let rule (. ([] (. facts pattern-arguments) (. function place)) rule))
      (return (call made-key 3 (. ([] (. instances rows) rule) module) rule))
    )
    (if (== (. function kind) .machine-handler)
      (return (call made-key 7 (. function module) 0))
    )
    (if (and (!= (. function kind) .instance-body) (!= (. function kind) .lazy-rule) not-mapped not-raising)
      (return 0)
    )
    (lazy not-mapped (!= (. function kind) .mapped-rule))
    (lazy not-raising (!= (. function kind) .raising-rule))
    (let row ([] (. instances rows) (. function instance)))
    (let local (call lazy-rule-decl function))
    (if (!= local 0)
      (let tree (. ([] (. program modules) (. row module)) tree))
      (match? ([] (. tree nodes) local)
        (case (call .node-declare declaration)
          (let name (call lazy-rule-name tree (. declaration left)))
          (if name
            (return (call made-key 4 (. row module) (call (. bundle intern) (. name text))))
          )
        )
      )
      (return 0)
    )
    (if (and (== (. function kind) .instance-body) (call is-filler (. row module) (. row decl)))
      (return (call made-key 6 (. row module) 0))
    )
    (if (== (call rule-match program (. row module) (. row decl)) 0)
      (return 0)
    )
    (match? ([] (. ([] (. program modules) (. row module)) decls) (. row decl))
      (case (call .decl-function fn)
        (if (. fn name)
          (return (call made-key 4 (. row module) (call (. bundle intern) (. fn name text))))
        )
      )
    )
    (return 0)
  )
  (fn-do _ is-filler Bool
    (param module ModuleId)
    (param decl DeclId)
    ; Whether a declaration is the function that fills an object with the markup of its class.
    (match? ([] (. ([] (. program modules) module) decls) decl)
      (case (call .decl-function fn)
        (return (. fn is-content))
      )
    )
    (return false)
  )
  (fn-expr _ made-key Size
    (param kind Size)
    (param module ModuleId)
    (param name Size)
    (/or/ (/lshift/ name 28) (/lshift/ (as module Size) 4) kind)
  )
  (fn-do _ made-place U64
    (param function EmittedFunction)
    ; Where what a numbered function is made of is written: the module that writes it, and the
    ; first node of the action, of the pattern, of the local rule, of the rule, or of the class
    ; whose markup fills an object.
    (let row ([] (. instances rows) (. function instance)))
    (let tree (. ([] (. program modules) (. row module)) tree))
    (let node SyntaxId (. row subtree start))
    (match? ([] (. ([] (. program modules) (. row module)) decls) (. row decl))
      (case (call .decl-function fn)
        (if (. fn is-content)
          (match? ([] (. ([] (. program modules) (. row module)) decls) (. fn owner))
            (case (call .decl-class class)
              (= node (call (. tree subtree-start) (. class syntax)))
            )
          )
        )
      )
    )
    (if (== (. function kind) .stream-action)
      (= node (call (. tree subtree-start) (. ([] (. facts outlined) (. function place)) arm)))
      (else-if (== (. function kind) .machine-handler)
        (= node (call (. tree subtree-start) (. ([] (. facts machine-groups) (. function place)) head)))
      )
      (else-if (or (== (. function kind) .pattern-helper) (== (. function kind) .pattern-cast))
        (= node (call (. tree subtree-start) (. ([] (. facts pattern-arguments) (. function place)) syntax)))
      )
      (else-if (!= (call lazy-rule-decl function) 0)
        (= node (call (. tree subtree-start) (call lazy-rule-decl function)))
      )
    )
    (return (/or/ (/lshift/ (as (. row module) U64) 32) (as node U64)))
  )
  (fn-expr _ lazy-rule-name (? Atom)
    (param tree AST)
    (param left SyntaxId)
    (match ([] (. tree nodes) left)
      (case (call .node-type-capture row)
        (call (. tree identifier-name) (. row id))
      )
      (default
        (call (. tree identifier-name) left)
      )
    )
  )
  (fn-do _ closure-property (? Atom)
    (param module ModuleId)
    (param decl DeclId)
    (param enclosing InstanceId)
    ; The property the function that gives again an argument of a markup element stores in, as
    ; the instance that writes the element chose it, or none.
    (match? ([] (. ([] (. program modules) module) decls) decl)
      (case (call .decl-function fn)
        (if (== (. fn kind) .live-decl)
          (let row (call live-statement-of enclosing (. fn syntax)))
          (if (and row (!= (. row property) (. U32 max)))
            (return (. ([] (. types properties) (. row property)) name))
          )
        )
      )
    )
    (return null)
  )
  (fn-do _ number-closures _
    ; Numbers the closures that share a name in the order they are written: of those of one name
    ; in a module the first written has the name, and a stack trace prints the second as `name2`.
    ; One written in a function made more than once is counted for each, by instance. The
    ; functions generated for comprehensions, lists of feeds and the right sides of pipes are
    ; closures the type pass typed, and are numbered among them. The body of a spawned task is
    ; named `Fork`, or `Spin` where it runs in parallel, and that of a `do without gc` block
    ; `GCFreeRegion`, and numbered so among the closures of that name.
    (let groups (list Size))
    (let places (list U64))
    (let owners (list U32))
    (let keys (list Size))
    (for (in type (. types ranked))
      (match? ([] (. types rows) type)
        (case (call .type-closure row)
          (let property (call closure-property (. row module) (. row decl) (. row enclosing)))
          (+= groups
            (call made-key
              (block
                (arg 5)
                (arg (. row module))
                (arg (call (. bundle intern) (call closure-name program (. row module) (. row decl) property)))
              )
            )
          )
          (+= places (call written-place (. row module) (. row decl) (. row enclosing)))
          (+= owners (call (. instances rank-of) (. row enclosing)))
          (+= keys (call closure-key (. row module) (. row decl) (. row enclosing)))
        )
      )
    )
    (for (in instance (call ranked-instances (. facts task-bodies)))
      (let row ([] (. instances rows) instance))
      (+= groups (call made-key 5 (. row module) (call (. bundle intern) (call task-name instance))))
      (+= places (call decl-place (. row module) (. row decl)))
      (+= owners (call (. instances rank-of) (. row enclosing)))
      (+= keys (call closure-key (. row module) (. row decl) (. row enclosing)))
    )
    (for (in instance (call ranked-instances (. facts region-bodies)))
      (let row ([] (. instances rows) instance))
      (+= groups (call made-key 5 (. row module) (call (. bundle intern) "GCFreeRegion")))
      (+= places (call decl-place (. row module) (. row decl)))
      (+= owners (call (. instances rank-of) (. row enclosing)))
      (+= keys (call closure-key (. row module) (. row decl) (. row enclosing)))
    )
    (let numbers (call written-numbers groups places owners))
    (for (in index (..< 0 (. keys length)))
      (= ([] closure-ranks ([] keys index)) ([] numbers index))
    )
  )
  (fn-do _ decl-place U64
    (param module ModuleId)
    (param decl DeclId)
    ; Where a declaration is written: its module, and the first node of it.
    (let owner ([] (. program modules) module))
    (match? ([] (. owner decls) decl)
      (case (call .decl-function fn)
        (return (/or/ (/lshift/ (as module U64) 32) (as (call (. owner tree subtree-start) (. fn syntax)) U64)))
      )
    )
    (return (/lshift/ (as module U64) 32))
  )
  (fn-do _ written-place U64
    (param module ModuleId)
    (param decl DeclId)
    (param enclosing InstanceId)
    ; Where a closure is written, as `decl-place` says, but for the function that runs a live
    ; declaration again, which the reference writes where the declaration's value is first read.
    (match? ([] (. ([] (. program modules) module) decls) decl)
      (case (call .decl-function fn)
        (if (== (. fn kind) .live-decl)
          (let row (call live-statement-of enclosing (. fn syntax)))
          (if (and row (!= (. row read) 0))
            (return (/or/ (/lshift/ (as module U64) 32) (as (. row read) U64)))
          )
        )
      )
    )
    (return (call decl-place module decl))
  )
  (fn-do _ written-numbers (list U32)
    (param groups (list Size))
    (param places (list U64))
    (param owners (list U32))
    ; The number of each function of a list among those that share its name, which `groups`
    ; gives as a key, none being 0: one more than how many of them are written before it, by
    ; `places`, then by the ranks of their instances in `owners`, then by their order in the list.
    (let numbers (list U32))
    (let links (list U32))
    (let heads (call (of Map Size U32) arena))
    (let count (as (. groups length) U32))
    (for (in index (..< 0 count))
      (+= numbers 0)
      (+= links (. U32 max))
      (if (!= ([] groups index) 0)
        (= ([] links index) (?? ([] heads ([] groups index)) (. U32 max)))
        (= ([] heads ([] groups index)) index)
      )
    )
    (for (in index (..< 0 count))
      (if (== ([] groups index) 0)
        (continue)
      )
      (let number U32 1)
      (let other (?? ([] heads ([] groups index)) (. U32 max)))
      (while (!= other (. U32 max))
        (let nearer
          (scope (or lower-owner (and (== ([] owners other) ([] owners index)) (< other index)))
            (lazy lower-owner (< ([] owners other) ([] owners index)))
          )
        )
        (if (or (< ([] places other) ([] places index)) (and (== ([] places other) ([] places index)) nearer))
          (+= number 1)
        )
        (= other ([] links other))
      )
      (= ([] numbers index) number)
    )
    (return numbers)
  )
  (fn-expr _ is-task Bool
    (param instance InstanceId)
    ; Whether an instance is the body of a spawned task.
    (and (< instance task-count) (== ([] task-bodies instance) 1))
  )
  (fn-expr _ copies-in Bool
    (param instance InstanceId)
    ; Whether an instance is the body of a spawned task or of a `do without gc` block, given a capture
    ; of what it copies.
    (and (< instance task-count) (!= ([] task-bodies instance) 0))
  )
  (fn-do _ find-tasks _
    ; Marks the instances that are the bodies of spawned tasks, and those of `do without gc` blocks,
    ; which the type pass lists in the order it met them.
    (if (and (== (. facts task-bodies length) 0) (== (. facts region-bodies length) 0))
      (return)
    )
    (= task-count (as (. instances length) U32))
    (= task-bodies (call (of (. arena allocate) U8) (+ task-count 1)))
    (for (in instance (..< 0 task-count))
      (= ([] task-bodies instance) 0)
    )
    (for (in body (. facts task-bodies))
      (= ([] task-bodies body) 1)
    )
    (for (in body (. facts region-bodies))
      (= ([] task-bodies body) 2)
    )
  )
  (fn-do _ task-name String
    (param instance InstanceId)
    ; The name of the function of a spawned task's body: `Thread` where it runs on a thread of its
    ; own, and `Fork` otherwise.
    (let row ([] (. instances rows) instance))
    (let owner-module ([] (. program modules) (. row module)))
    (match? ([] (. owner-module decls) (. row decl))
      (case (call .decl-function fn)
        (match? ([] (. owner-module tree nodes) (. fn syntax))
          (case (call .node-do-task-block task)
            (if (. task is-parallel)
              (return "Thread")
            )
          )
        )
      )
    )
    (return "Fork")
  )
  (fn-expr _ closure-key Size
    (param module ModuleId)
    (param decl DeclId)
    (param enclosing U32)
    (/xor/ (call pair-key decl enclosing) (/lshift/ (as module Size) 56))
  )
  (fn-do _ declare-stream-actions _
    ; Declares the function the reference runs an action of a grammar in, for each such
    ; action of an emitted instance that may panic, which the function shows. It is named
    ; `stream-action`, and `number-made` numbers it. One the type pass is not sure the reference
    ; runs so is refused. They are declared in the order of their instances' ranks.
    (let keys (list U64))
    (for (in row (. facts outlined))
      (+= keys (call rank-key (. row instance) (. row arm)))
    )
    (for (in position (call ranked-order keys))
      (let row ([] (. facts outlined) position))
      (if (or functionless (!= (call (. facts plan-of) (. row instance) (. row arm)) .plan-outlined-panic))
        (continue)
      )
      (lazy functionless (== ([] instance-functions (. row instance)) no-function))
      (let id FunctionId (as (. functions length) FunctionId))
      (call (. functions append)
        (block
          (arg (call unnamed-function .stream-action (. row instance) (. ([] (. instances rows) (. row instance)) module) 1))
        )
      )
      (= (. ([] functions id) place) position)
      (= (. ([] functions id) may-panic) true)
      (= (. ([] functions id) unplaced) (. row unsure))
      (= ([] stream-action-rows (call pair-key (. row instance) (. row arm))) id)
    )
  )
  (fn-do _ declare-machine-handlers _
    ; Declares, for each group of event transitions of an emitted state machine, the functions its
    ; subscriber runs, as the reference makes them: the handler, `state-transition`, which
    ; `number-made` numbers; the cast of it to the subscriber, named after it with `Casting`; and
    ; the function the subscriber's value calls, `StateTransitionActivation`, which runs the cast
    ; while the activation that subscribed is current. A group on a stream that is no event has the
    ; function its broadcaster is given instead, `StateTransitionDeferral`, which gives the
    ; activation to the event runtime's queue. Each is given the machine's environment through the
    ; record of its activation, laid out once: the environment, whether the activation is current,
    ; and whether it subscribed. A group on a stream that is only iterable, whose items the handler
    ; is given directly, has the handler alone. A machine merged with others, one that refines
    ; another or that another refines, has its part, the function the others call
    ; (`emit-machine-part`). One a class's property holds has the function that stops it, which
    ; the object's `close` runs (`stops-at-close`). The machines are taken in the order of their
    ; instances' ranks.
    (let keys (list U64))
    (for (in machine (. facts machines))
      (+= keys (call rank-key (. machine instance) (. machine syntax)))
    )
    (= machine-order (call ranked-order keys))
    (for (in position machine-order)
      (let machine ([] (. facts machines) position))
      (if (== ([] instance-functions (. machine instance)) no-function)
        (continue)
      )
      (let module (. ([] (. instances rows) (. machine instance)) module))
      (if (and (== (. machine outer) 0) (or (!= (. machine refined) no-instance) (call is-refined (. machine instance))))
        (let part FunctionId (as (. functions length) FunctionId))
        (call (. functions append) (call unnamed-function .machine-part (. machine instance) module 1))
        (= (. ([] functions part) place) (as position U32))
        (= (. ([] functions part) may-panic) true)
        (= ([] machine-part-rows (. machine instance)) part)
      )
      (if (call stops-at-close machine)
        (let stop FunctionId (as (. functions length) FunctionId))
        (call (. functions append) (call unnamed-function .machine-stop (. machine instance) module 1))
        (= (. ([] functions stop) place) (as position U32))
        (= (. ([] functions stop) may-panic) true)
        (= ([] machine-stop-rows (. machine instance)) stop)
      )
      (for (in group (..< (. machine groups start) (+ (. machine groups start) (. machine groups count))))
        (let id FunctionId (as (. functions length) FunctionId))
        (let row ([] (. facts machine-groups) group))
        (call (. functions append) (call unnamed-function .machine-handler (. machine instance) module 1))
        (if (not (. row iterated))
          (call (. functions append) (call unnamed-function .machine-cast (. machine instance) module 1))
          (call (. functions append) (call unnamed-function .machine-activation (. machine instance) module 1))
        )
        (if (and (not (. row iterated)) (== (. row event) (. U32 max)))
          (call (. functions append) (call unnamed-function .machine-deferral (. machine instance) module 1))
        )
        (for (in offset (..< id (as (. functions length) FunctionId)))
          (= (. ([] functions offset) place) group)
          (= (. ([] functions offset) may-panic) true)
        )
        (= ([] machine-handler-rows group) id)
      )
      (if (and (== machine-record no-layout) (!= (. machine groups count) 0))
        (let children (list LayoutId))
        (let held (list TypeId))
        (+= children managed-layout)
        (+= children u8-layout)
        (+= children u8-layout)
        (+= held no-type)
        (+= held no-type)
        (+= held no-type)
        (= machine-record (call (. layouts environment) children held "machine.activation"))
      )
    )
  )
  (fn-do _ declare-pattern-arguments _
    ; Declares the function a pattern given to a rule is passed as, for each such pattern an
    ; emitted instance writes: one made of the pattern where it is written, which the reference
    ; names `static-inline-match-direct`; and, for a call of a rule written alone, one that runs
    ; the rule's function, which the reference names after it with `Casting`. `number-made`
    ; numbers both. Each writes the panic signal, as the rule it is passed to calls it through the value
    ; it holds and checks every such call. One made of a pattern that is given what names hold
    ; reads them from memory laid out here, which the function it is written in fills where it
    ; passes the pattern; one that runs a local rule of a rule may panic where the rule may. They
    ; are declared in the order of their instances' ranks, then of where the patterns are written.
    (let keys (list U64))
    (for (in row (. facts pattern-arguments))
      (+= keys (call rank-key (. row instance) (. row syntax)))
    )
    (for (in position (call ranked-order keys))
      (let row ([] (. facts pattern-arguments) position))
      (if (== ([] instance-functions (. row instance)) no-function)
        (continue)
      )
      (let helper (== (. row rule) no-instance))
      (if (and (not helper) (== ([] instance-functions (. row rule)) no-function))
        (continue)
      )
      (let kind (if-expr helper (. FunctionKind pattern-helper) (. FunctionKind pattern-cast)))
      (let id FunctionId (as (. functions length) FunctionId))
      (call (. functions append) (call unnamed-function kind (. row instance) (. ([] (. instances rows) (. row instance)) module) 1))
      (= (. ([] functions id) place) position)
      (= (. ([] functions id) may-panic) (if-expr helper (call helper-may-panic row) rule-panics))
      (lazy rule-panics (. ([] (. instances rows) (. row rule)) may-panic))
      (= (. ([] functions id) carries) true)
      (= ([] pattern-argument-rows (call pair-key (. row instance) (. row syntax))) id)
      (if (and helper (!= (. row params count) 0))
        (call lay-pattern-environment position row)
      )
    )
  )
  (fn-do _ declare-growths _
    ; Declares the functions that grow the storage of a table in its arena, as the reference
    ; keeps growth out of the functions that append, in `cold-storage-rows` and
    ; `cold-storage-spill`: for each type of row a table holds, one that grows its rows, and for
    ; a union that keeps bytes outside its rows, one that grows those. Neither panics: each
    ; answers the message of what failed, or nothing.
    (for (in id (. types ranked))
      (let row (call table-row types id))
      (if (or (== row no-type) (!= ([] growth-rows (* (as row Size) 2)) null) (== ([] (. layouts values) row) no-layout))
        (continue)
      )
      (let kind (. ([] (. types completions) row) intrinsic))
      (let place (if-expr (== kind .union) (call (. unions of) row) (. U32 max)))
      (if (and (!= kind .struct) (== place (. U32 max)))
        (continue)
      )
      (call declare-growth row 0)
      (if (and (!= place (. U32 max)) (!= (. ([] (. unions layouts) place) handle-column) (. U32 max)))
        (call declare-growth row 1)
      )
    )
  )
  (fn-do _ declare-growth _
    (param row TypeId)
    (param part U32)
    (let id FunctionId (as (. functions length) FunctionId))
    (call (. functions append) (call unnamed-function .storage-growth no-instance (. (call class-ref types row) module) 8))
    (= (. ([] functions id) type) row)
    (= (. ([] functions id) place) part)
    (= ([] growth-rows (+ (* (as row Size) 2) (as part Size))) id)
  )
  (fn-do _ declare-source-attacher _
    ; Declares the function that gives a panic with no source of its own the place it is raised at,
    ; which each place that raises one calls, where the program can raise any, and the functions
    ; those places call to raise one: one given the panic, and one given the message of a panic the
    ; compiler writes, where the program has one to make.
    (let source (. instances report source))
    (if (or (== source no-instance) (== ([] instance-functions source) no-function))
      (return)
    )
    (= source-attacher (as (. functions length) FunctionId))
    (call (. functions append) (call unnamed-function .source-attach no-instance (. ([] (. instances rows) source) module) 1))
    (= panic-raiser (as (. functions length) FunctionId))
    (call (. functions append) (call unnamed-function .raise-panic no-instance (. ([] (. instances rows) source) module) 1))
    (let made (. instances report panic))
    (return-if (if (or (== made no-instance) (== ([] instance-functions made) no-function))))
    (blank)
    (= message-raiser (as (. functions length) FunctionId))
    (call (. functions append) (call unnamed-function .raise-message no-instance (. ([] (. instances rows) source) module) 1))
  )
  (fn-do _ declare-lazy-rules _
    ; Declares the function a local rule of a rule a module declares runs in: one for each local
    ; rule that calls itself, one for each that `shared-lazy-rules` finds too large to copy where
    ; it is called, and, where the rule raises errors, one for each local rule it calls. Any other
    ; runs where it is called, as one does where the rule may panic, whose stack trace then shows
    ; the rule. A local rule beside a match that calls itself
    ; runs where a pattern calls it too, as the reference's does, and has two functions for the
    ; calls its own arms make: one given the stream, which a call from its arms calls, and the
    ; one its arms run in, which that one calls on the stream's view. It has them only where it
    ; reads nothing they could not hold, as `reads-own` says, and is refused where it is called
    ; otherwise. Those beside a match are declared in the order of their instances' ranks.
    (for (in owner (. instances ordered))
      (if (== ([] instance-functions owner) no-function)
        (continue)
      )
      (let row ([] (. instances rows) owner))
      (if (== (call rule-match program (. row module) (. row decl)) 0)
        (continue)
      )
      (let tree (. ([] (. program modules) (. row module)) tree))
      (let shared (call shared-lazy-rules owner))
      (for (in statement (call lazy-rules-of owner))
        (match? ([] (. tree nodes) statement)
          (case (call .node-declare declaration)
            (let raising (!= (. ([] (. instances signatures) owner) errors count) 0))
            (if (and typed (or raising (call (. facts is-recursive-rule) owner statement) (has shared statement)))
              (let id FunctionId (as (. functions length) FunctionId))
              (call (. functions append) (call unnamed-function .lazy-rule owner (. row module) 1))
              (= (. ([] functions id) place) statement)
              (= (. ([] functions id) may-panic) (. row may-panic))
              (= ([] lazy-rule-rows (call pair-key owner statement)) id)
            )
            (lazy typed (!= (call (. facts node-type) owner (. declaration right)) no-type))
          )
        )
      )
    )
    (let keys (list U64))
    (for (in local (. facts local-rules))
      (+= keys (call rank-key (. local instance) (. local syntax)))
    )
    (for (in position (call ranked-order keys))
      (let local ([] (. facts local-rules) position))
      (if (or (not (. local recursive)) no-stream (== ([] instance-functions (. local instance)) no-function))
        (continue)
      )
      (lazy no-stream (== (. local stream) no-type))
      (let row ([] (. instances rows) (. local instance)))
      (let seen (list SyntaxId))
      (if (or has-helper ruled (not (call reads-own (. local instance) (. local syntax) (. local syntax) seen)))
        (continue)
      )
      (lazy has-helper (!= (. row helper) no-type))
      (lazy ruled (!= (call rule-match program (. row module) (. row decl)) 0))
      (let pair (call pair-key (. local instance) (. local syntax)))
      (let direct FunctionId (as (. functions length) FunctionId))
      (call (. functions append) (call unnamed-function .lazy-rule (. local instance) (. row module) 1))
      (= (. ([] functions direct) place) (. local syntax))
      (= (. ([] functions direct) may-panic) (. row may-panic))
      (= ([] lazy-rule-rows pair) direct)
      (let adapter FunctionId (as (. functions length) FunctionId))
      (call (. functions append) (call unnamed-function .rule-adapter (. local instance) (. row module) 1))
      (= (. ([] functions adapter) place) (. local syntax))
      (= (. ([] functions adapter) may-panic) (. row may-panic))
      (= ([] rule-adapter-rows pair) adapter)
    )
  )
  (fn-do _ shared-lazy-rules (list SyntaxId)
    (param owner InstanceId)
    ; The local rules of a rule that run as functions of their own because copying them where
    ; they are called would copy too much: each called from more than one place, whose
    ; declaration, with the local rules it copies, holds more than `inline-rule-limit` nodes.
    (let row ([] (. instances rows) owner))
    (let tree (. ([] (. program modules) (. row module)) tree))
    (let uses (map SyntaxId Size))
    (for (in node (..< (. row subtree start) (+ (. row subtree start) (. row subtree count))))
      (if (is ([] (. tree nodes) node) .node-stream-call)
        (let rule (call local-rule-called owner node))
        (if (!= rule 0)
          (= ([] uses rule) (+ (?? ([] uses rule) 0) 1))
        )
      )
    )
    (let sizes (map SyntaxId Size))
    (let shared (list SyntaxId))
    (for (in rule (call lazy-rules-of owner))
      (call copied-size owner rule uses sizes shared)
    )
    (return shared)
  )
  (fn-do _ copied-size Size
    (param owner InstanceId)
    (param rule SyntaxId)
    (param uses (map SyntaxId Size))
    (param sizes (map SyntaxId Size))
    (param shared (list SyntaxId))
    ; The nodes a call of a local rule copies where it runs: those of the rule's declaration and
    ; of each local rule it calls that runs where it is called. A rule that runs as a function of
    ; its own copies none, and is added to `shared` where it is one `shared-lazy-rules` finds.
    (let known ([] sizes rule))
    (return-if known (if (!= known null)))
    (blank)
    (= ([] sizes rule) 0)
    (let tree (. ([] (. program modules) (. ([] (. instances rows) owner) module)) tree))
    (let first (call (. tree subtree-start) rule))
    (let size (as (+ (- rule first) 1) Size))
    (for (in node (..< first (+ rule 1)))
      (if (is ([] (. tree nodes) node) .node-stream-call)
        (let called (call local-rule-called owner node))
        (if (and (!= called 0) (!= called rule))
          (+= size (call copied-size owner called uses sizes shared))
        )
      )
    )
    (let count (?? ([] uses rule) 0))
    (let recursive (call (. facts is-recursive-rule) owner rule))
    (if recursive
      (= size 0)
      (else-if (and (> count 1) (> size inline-rule-limit))
        (+= shared rule)
        (= size 0)
      )
    )
    (= ([] sizes rule) size)
    (return size)
  )
  (fn-do _ reads-own Bool
    (param instance InstanceId)
    (param rule SyntaxId)
    (param home SyntaxId)
    (param seen (list SyntaxId))
    ; Whether a local rule beside a match reads nothing its function could not hold: every name
    ; it reads is one its own arms declare, a local rule that reads so too, which runs where it
    ; is called, or the rule the function is made of, which it calls. A rule that reads a local,
    ; an argument or a name the match captures, the receiver or a member of it, or that writes a
    ; nested function, would need what the function it is written in holds.
    (if (!= (call (. seen find) rule) null)
      (return true)
    )
    (+= seen rule)
    (let row ([] (. instances rows) instance))
    (let tree (. ([] (. program modules) (. row module)) tree))
    (let first (call (. tree subtree-start) rule))
    (for (in node (..< first (+ rule 1)))
      (if (is ([] (. tree nodes) node) .node-function-syntax)
        (return false)
      )
      (let resolution (call (. bindings resolution-of) (. row binding) node))
      (if (== (. resolution kind) .resolve-member)
        (return false)
      )
      (if (!= (. resolution kind) .resolve-slot)
        (continue)
      )
      (let slot ([] (. bindings slots) (. resolution slot)))
      (if (== (. slot kind) .slot-this)
        (return false)
      )
      (if (and (>= (. slot syntax) first) (<= (. slot syntax) rule))
        (continue)
      )
      (if (or (!= (. slot kind) .slot-lazy) (== (. slot group) 0))
        (return false)
      )
      (if (== (. slot group) home)
        (continue)
      )
      (match ([] (. tree nodes) (. slot group))
        (case (call .node-declare declaration)
          (if (or (not stream-match) calls-itself (not (call reads-own instance (. slot group) home seen)))
            (return false)
          )
          (lazy stream-match (is ([] (. tree nodes) (. declaration right)) .node-stream-match))
          (lazy calls-itself (call (. facts is-recursive-rule) instance (. slot group)))
        )
        (default
          (return false)
        )
      )
    )
    (return true)
  )
  (fn-do _ lazy-rules-of (list SyntaxId)
    (param instance InstanceId)
    ; The local rules declared beside the pattern of a rule a module declares.
    (let rules (list SyntaxId))
    (let row ([] (. instances rows) instance))
    (let tree (. ([] (. program modules) (. row module)) tree))
    (match? ([] (. ([] (. program modules) (. row module)) decls) (. row decl))
      (case (call .decl-function fn)
        (match? ([] (. tree nodes) (. fn body))
          (case (call .node-block block)
            (for (in statement ([] (. tree children) (. block body)))
              (match? ([] (. tree nodes) statement)
                (case (call .node-declare declaration)
                  (if (and (. declaration is-lazy) stream-match)
                    (+= rules statement)
                  )
                  (lazy stream-match (is ([] (. tree nodes) (. declaration right)) .node-stream-match))
                )
              )
            )
          )
        )
      )
    )
    (return rules)
  )
  (fn-do _ declare-mapped-rules _
    ; Declares a function of a rule for each set of collectors calls of it give it, as the
    ; reference compiles one for each: of a rule a module declares, and of a local rule of one
    ; that runs as a function of its own. Notes each such local rule a call given no collectors
    ; reads the value of: any but one the type pass planned to give the text it matched. A rule a
    ; module declares that a call the type pass planned so runs has a function with no collectors,
    ; which makes no text of what its arms matched.
    (for (in caller (. instances ordered))
      (if (== ([] instance-functions caller) no-function)
        (continue)
      )
      (let row ([] (. instances rows) caller))
      (let tree (. ([] (. program modules) (. row module)) tree))
      (for (in node (..< (. row subtree start) (+ (. row subtree start) (. row subtree count))))
        (match? ([] (. tree nodes) node)
          (case (call .node-stream-call call)
            (let names (call mapping-names tree (. call collector-mappings)))
            (let rule (call local-rule-called caller node))
            (if (!= rule 0)
              (let pair (call pair-key caller rule))
              (if (== ([] lazy-rule-rows pair) null)
                (continue)
              )
              (if (!= names no-string)
                (call map-rule caller rule names (. ([] functions (!! ([] lazy-rule-rows pair))) may-panic))
                (else-if (!= (call (. facts plan-of) caller node) .plan-span-call)
                  (= ([] read-rule-rows pair) 1)
                )
              )
              (else-if (or (!= names no-string) (== (call (. facts plan-of) caller node) .plan-span-call))
                (let fact (call (. facts first-call) caller node))
                (let callee (if-expr (!= fact no-fact) (. ([] (. facts calls) fact) callee) no-instance))
                (let ruled (and (!= callee no-instance) (or (!= names no-string) (!= (call rule-match program (. ([] (. instances rows) callee) module) (. ([] (. instances rows) callee) decl)) 0))))
                (if (and ruled (!= ([] instance-functions callee) no-function))
                  (call map-rule callee 0 names (. ([] (. instances rows) callee) may-panic))
                )
              )
            )
          )
        )
      )
    )
  )
  (fn-do _ declare-raising-rules _
    ; Declares the function of a rule that calls of it which give it a pattern whose function
    ; may raise errors run, for each such rule emitted. Each local rule of the rule that runs as a
    ; function has one too. They are declared in the order of their instances' ranks, then of the
    ; local rules they are of.
    (let keys (list U64))
    (for (in row (. facts raising-rules))
      (+= raising-functions no-function)
      (+= keys (call rank-key (. row instance) (. row rule)))
    )
    (for (in position (call ranked-order keys))
      (let row ([] (. facts raising-rules) position))
      (if (== ([] instance-functions (. row instance)) no-function)
        (continue)
      )
      (if (and (!= (. row rule) 0) (== ([] lazy-rule-rows (call pair-key (. row instance) (. row rule))) null))
        (continue)
      )
      (let id FunctionId (as (. functions length) FunctionId))
      (call (. functions append)
        (block
          (arg (call unnamed-function .raising-rule (. row instance) (. ([] (. instances rows) (. row instance)) module) 1))
        )
      )
      (= (. ([] functions id) place) position)
      (= (. ([] functions id) may-panic) (. ([] (. instances rows) (. row instance)) may-panic))
      (= ([] raising-functions position) id)
    )
  )
  (fn-do _ map-rule _
    (param instance InstanceId)
    (param rule SyntaxId)
    (param names StringId)
    (param may-panic Bool)
    ; The function of a rule for a set of collectors, declared where none was.
    (for (in mapping rule-mappings)
      (if (and (== (. mapping instance) instance) (== (. mapping rule) rule) (== (. mapping names) names))
        (return)
      )
    )
    (let id FunctionId (as (. functions length) FunctionId))
    (call (. functions append) (call unnamed-function .mapped-rule instance (. ([] (. instances rows) instance) module) 1))
    (= (. ([] functions id) place) (as (. rule-mappings length) U32))
    (= (. ([] functions id) may-panic) may-panic)
    (call (. rule-mappings append) (call RuleMapping instance rule names id))
  )
  (fn-expr _ local-rule-called SyntaxId
    (param caller InstanceId)
    (param call SyntaxId)
    ; The declaration of the local rule a call in an instance names, as the binder resolved it,
    ; or none.
    (case? (== binding no-binding)
      0
    )
    (case? (!= (. resolution kind) .resolve-slot)
      0
    )
    (case? (!= (. slot kind) .slot-lazy)
      0
    )
    (default
      (. slot group)
    )
    (where
      (lazy binding (. ([] (. instances rows) caller) binding))
      (lazy resolution (call (. bindings resolution-of) binding call))
      (lazy slot ([] (. bindings slots) (. resolution slot)))
    )
  )
  (fn-expr _ mapping-key String
    (param names StringId)
    ; What tells the key of a function of a rule for a set of collectors from the rule's own.
    (if-expr (== names no-string) ".unread" (str ".into." (call (. bundle text) names)))
  )
  (fn-do _ lazy-rule-text String
    (param function EmittedFunction)
    ; The name of the local rule a function runs.
    (let tree (. ([] (. program modules) (. ([] (. instances rows) (. function instance)) module)) tree))
    (match? ([] (. tree nodes) (call lazy-rule-decl function))
      (case (call .node-declare declaration)
        (let name (call lazy-rule-name tree (. declaration left)))
        (if name
          (return (. name text))
        )
      )
    )
    (return "")
  )
  (fn-do _ lay-pattern-environment _
    (param place U32)
    (param row PatternArgument)
    ; Lays out the memory the function made of a pattern reads what it is given from: what each
    ; name holds, in order. One that holds a value with no layout has none.
    (let children (list LayoutId))
    (let held (list TypeId))
    (for (in offset (..< 0 (. row params count)))
      (let type ([] (. facts action-types) (+ (. row params start) offset)))
      (let layout (if-expr (or (== type no-type) (== type invalid-type)) no-layout ([] (. layouts values) type)))
      (if (== layout no-layout)
        (return)
      )
      (+= children layout)
      (+= held type)
    )
    (= ([] pattern-environments place)
      (call (. layouts environment)
        (block
          (arg children)
          (arg held)
          (arg (str "pattern." (call hex-text ([] (. instances stable-keys) (. row instance))) "." (. row syntax)))
        )
      )
    )
  )
  (fn-do _ helper-may-panic Bool
    (param row PatternArgument)
    ; Whether a pattern given to a rule calls what may panic: a rule a module declares that may, a
    ; local rule of a rule that may, or a function of the stream's interface, as it does to ask the
    ; stream for more input.
    (let tree (. ([] (. program modules) (. ([] (. instances rows) (. row instance)) module)) tree))
    (for (in node (..< (call (. tree subtree-start) (. row syntax)) (+ (. row syntax) 1)))
      (let fact (call (. facts first-call) (. row instance) node))
      (while (!= fact no-fact)
        (let callee (. ([] (. facts calls) fact) callee))
        (if (and (!= callee no-instance) (or (. ([] (. instances rows) callee) may-panic) (call is-prototype callee)))
          (return true)
        )
        (= fact (. ([] (. facts calls) fact) next))
      )
      (if (and (is ([] (. tree nodes) node) .node-stream-call) called (. ([] (. instances rows) (. row instance)) may-panic))
        (return true)
      )
      (lazy called (!= (call local-rule-called (. row instance) node) 0))
    )
    (return false)
  )
  (fn-expr _ is-machine-group-kind Bool
    (param kind FunctionKind)
    ; Whether a function is one of those a group of a machine's event transitions has.
    (scope (or handled (== kind .machine-activation) (== kind .machine-deferral))
      (lazy handled (or (== kind .machine-handler) (== kind .machine-cast)))
    )
  )
  (fn-do _ is-refined Bool
    (param instance InstanceId)
    ; Whether a machine of a property of a class is refined by another typed for a class.
    (for (in machine (. facts machines))
      (if (and (== (. machine refined) instance) (== (. machine outer) 0))
        (return true)
      )
    )
    (return false)
  )
  (fn-do _ name-function _
    (param id FunctionId)
    ; Names a function: its symbol, made from a key no other function has, which names the instance
    ; it runs by its stable key, and the name a stack trace shows, as the reference names it.
    (let function ([] functions id))
    (let module-name (. ([] (. program modules) (. function module)) name))
    (let key "main")
    (let display "main")
    (if (== (. function kind) .module-main)
      (= key (str module-name ":main"))
      (= display key)
      (else-if (== (. function kind) .module-init)
        (= key (str "init." module-name))
        (= display (str module-name ":init." module-name))
      )
      (else-if (and (== (. function kind) .task-main) (. program is-batch))
        (= key (str "brix.batch." (. function place) ".start"))
        (= display (str module-name ":brix.main"))
      )
      (else-if (== (. function kind) .task-main)
        (= key "brix.main")
        (= display (str module-name ":brix.main"))
      )
      (else-if (== (. function kind) .batch-main)
        (= key "brix.batch.main")
        (= display (str module-name ":brix.batch.main"))
      )
      (else-if (== (. function kind) .batch-finish)
        (= key (str "brix.batch." (. function place) ".finish"))
        (= display (str module-name ":brix.batch.finish"))
      )
      (else-if (== (. function kind) .task-init)
        (= key "taskinit")
        (= display (str module-name ":taskinit"))
      )
      (else-if (== (. function kind) .thread-init)
        (= key "threadinit")
        (= display (str module-name ":threadinit"))
      )
      (else-if (== (. function kind) .probe-setup)
        (= key "probesetup")
        (= display (str module-name ":probesetup"))
      )
      (else-if (== (. function kind) .probe-teardown)
        (= key "probeteardown")
        (= display (str module-name ":probeteardown"))
      )
      (else-if (== (. function kind) .probe-closer)
        (= key "probetaskteardown")
        (= display (str module-name ":probetaskteardown"))
      )
      (else-if (== (. function kind) .probe-flush)
        (= key "probeTaskFlushThunk")
        (= display (str module-name ":probeTaskFlushThunk"))
      )
      (else-if (== (. function kind) .probe-safepoint)
        (= key "probeSafepoint")
        (= display (str module-name ":probeSafepoint"))
      )
      (else-if (== (. function kind) .instance-body)
        (= display (call instance-display (. function instance)))
        (= key (str display "." (call hex-text ([] (. instances stable-keys) (. function instance)))))
        (if (and (!= ([] body-functions (. function instance)) no-function) viewed)
          (= display (str module-name ":" (call callee-name (. function instance))))
          (= key (str key ".view"))
        )
        (lazy viewed (== (. ([] functions ([] body-functions (. function instance))) kind) .viewed-body))
      )
      (else-if (or (== (. function kind) .viewed-body) (== (. function kind) .task-body))
        (= display (call instance-display (. function instance)))
        (= key (str display "." (call hex-text ([] (. instances stable-keys) (. function instance)))))
      )
      (else-if (== (. function kind) .constructor-body)
        (= display (call instance-display (. function instance)))
        (= key (str display ".body." (call hex-text ([] (. instances stable-keys) (. function instance)))))
      )
      (else-if (== (. function kind) .generator-body)
        (= display (call instance-display (. function instance)))
        (= key (str display ".step." (call hex-text ([] (. instances stable-keys) (. function instance)))))
      )
      (else-if (== (. function kind) .instance-initializer)
        (= display (call instance-display (. function instance)))
        (= key (str display ".init." (call hex-text ([] (. instances stable-keys) (. function instance)))))
      )
      (else-if (== (. function kind) .lazy-property)
        (let written (. ([] (. types properties) (. function place)) name text))
        (= display (str module-name ":" (call type-short-name types (. function type)) ":" written))
        (= key (str display ".lazy." (call hex-text ([] (. types stable-keys) (. function type)))))
      )
      (else-if (== (. function kind) .property-updater)
        (let written (. ([] (. types properties) (. function place)) name text))
        (= display (str module-name ":prop-" written))
        (= key (str module-name ":" (call type-short-name types (. function type)) ":" written ".updater." holder))
        (lazy holder (call hex-text ([] (. types stable-keys) (. function type))))
      )
      (else-if (== (. function kind) .class-rule-updater)
        (let rule ([] class-rules (. function place)))
        (let written
          (block
            (case? (is ([] (. ([] (. program modules) (. rule module)) tree nodes) (. rule syntax)) .node-whenever-rule-syntax)
              "whenever"
            )
            (default
              "when"
            )
          )
        )
        (let shown (if-expr (call (. facts markup-trigger-of) (. rule unit)) (str written "-markup") written))
        (= display (str module-name ":" shown))
        (= key
          (paragraph
            (str module-name ":" (call type-short-name types (. function type)) ":" shown "." (. rule syntax) "." (call hex-text ([] (. instances stable-keys) (. rule unit))))
          )
        )
      )
      (else-if (or (== (. function kind) .markup-trigger-add) trigger-remove trigger-ancestor)
        (let rule ([] class-rules (. function place)))
        (let ending
          (scope (if-expr adds "add" (if-expr removes "remove" "ancestor"))
            (lazy adds (== (. function kind) .markup-trigger-add))
            (lazy removes (== (. function kind) .markup-trigger-remove))
          )
        )
        (= display (str module-name ":markup-trigger-" ending))
        (= key
          (paragraph
            (str module-name ":" (call type-short-name types (. function type)) ":markup-trigger-" ending "." (. rule syntax) "." (call hex-text ([] (. instances stable-keys) (. rule unit))))
          )
        )
      )
      (else-if (== (. function kind) .idle-action)
        (= display (str module-name ":subscription"))
        (= key "live.subscription")
      )
      (else-if (== (. function kind) .event-handler)
        (let handler ([] event-handlers (. function place)))
        (let shown (if-expr (< (. handler number) 2) "" (str (. handler number))))
        (= display (str module-name ":event descriptor " level-name "." (. handler name text) shown))
        (lazy level-name (call type-short-name types (. handler level)))
        (= key (str module-name ":event.handler." (call type-key types (. handler level)) "." (. handler syntax)))
      )
      (else-if (== (. function kind) .event-matcher)
        (= display (str module-name ":event descriptor matcher " (call type-short-name types (. function type))))
        (= key (str module-name ":event.matcher." (call type-key types (. function type))))
      )
      (else-if (== (. function kind) .machine-descriptor)
        (let head (. ([] (. facts machine-groups) (. function place)) head))
        (= key
          (paragraph
            (str (call instance-display (. function instance)) "." (call hex-text ([] (. instances stable-keys) (. function instance))) ".event.machine." (call type-key types (. function type)) "." head)
          )
        )
        (= display (str module-name ":event machine descriptor " (call type-short-name types (. function type))))
      )
      (else-if (== (. function kind) .event-registrations)
        (= key (str "init." module-name ".events"))
        (= display (str module-name ":" key))
      )
      (else-if (== (. function kind) .style-registration)
        (let shown (if-expr (== (. function place) 0) "" (str (+ (. function place) 1))))
        (= key (str module-name ":style-register-impl" shown))
        (= display key)
      )
      (else-if (== (. function kind) .style-gate)
        (= display (if-expr gate-content (str module-name ":style-content") (str module-name ":style-gate")))
        (lazy gate-content (. ([] (. facts style-gates) (. function place)) content))
        (= key (str module-name ":style-gate." (. function number)))
      )
      (else-if (== (. function kind) .style-scope-state)
        (= display (str module-name ":style-scope-state"))
        (= key (str module-name ":style-scope-state." (. function number)))
      )
      (else-if (== (. function kind) .slot-forward)
        (= display (str module-name ":markup-slot-forward"))
        (= key (str module-name ":slot-forward." (. function number)))
      )
      (else-if (== (. function kind) .style-sheet-registration)
        (let shown (if-expr (== (. function place) 0) "" (str (+ (. function place) 1))))
        (= key (str module-name ":style-sheet-register-impl" shown))
        (= display key)
      )
      (else-if (== (. function kind) .style-static-value)
        (let shown (if-expr (== (. function number) 0) "" (str (+ (. function number) 1))))
        (= key (str module-name ":style-static-value" shown))
        (= display key)
      )
      (else-if (== (. function kind) .style-themed-value)
        (let shown (if-expr (== (. function number) 0) "" (str (+ (. function number) 1))))
        (= key (str module-name ":style-themed-value" shown))
        (= display key)
      )
      (else-if (== (. function kind) .style-rule)
        (= display (str module-name ":style-rule"))
        (= key (str module-name ":style-rule." (. function number)))
      )
      (else-if (== (. function kind) .style-author)
        (let author ([] (. facts style-authors) (. function place)))
        (let row (call (. facts style-declaration-of) (. author instance) (. author site)))
        (let written (if-expr row (. ([] (. facts style-properties) (. row property)) name text) ""))
        (= display (str module-name ":style-" written))
        (= key (str module-name ":style-author." (. function number)))
      )
      (else-if (== (. function kind) .style-given-author)
        (let unit (. ([] (. facts style-applications) ([] given-applications (. function place))) unit))
        (let row (call (. facts style-declaration-of) unit ([] given-sites (. function place))))
        (let update (call (. facts rule-update-of) unit ([] given-sites (. function place))))
        (let written
          (block
            (case? row
              (. ([] (. facts style-properties) (. row property)) name text)
            )
            (case? update
              (. ([] (. types properties) (. update property)) name text)
            )
            (default
              ""
            )
          )
        )
        (= display (str module-name ":style-" written))
        (= key (str module-name ":style-given." (. function number)))
      )
      (else-if (or (== (. function kind) .markup-query) (== (. function kind) .markup-query-add) query-remove)
        (let query ([] (. facts markup-queries) (. function place)))
        (let written (. ([] (. types properties) (. query place)) name text))
        (let ending
          (scope (if-expr (== (. function kind) .markup-query) "" (if-expr adding "-add" "-remove"))
            (lazy adding (== (. function kind) .markup-query-add))
          )
        )
        (= display (str module-name ":markup-query-" written ending))
        (= key
          (paragraph
            (str module-name ":" (call type-short-name types (. function type)) ":markup-query-" written ending "." (call hex-text ([] (. types stable-keys) (. function type))))
          )
        )
      )
      (else-if (== (. function kind) .live-adapter)
        (= display (str (call (. bundle text) (. ([] functions (. function place)) display)) "Casting"))
        (= key (str (call (. bundle text) (. ([] functions (. function place)) name)) ".adapter"))
      )
      (else-if (== (. function kind) .module-constants)
        (= key (str "init." module-name ".constants"))
        (= display (str module-name ":" key))
      )
      (else-if (== (. function kind) .module-globals)
        (= key (str "init." module-name ".globals"))
        (= display (str module-name ":" key))
      )
      (else-if (== (. function kind) .lazy-global)
        (= key (str "init." module-name ".global." (call global-name ([] storage (. function place)))))
        (= display (str module-name ":" key))
      )
      (else-if (== (. function kind) .task-local-init)
        (= key (str "init." module-name ".task-local." (call global-name ([] storage (. function place)))))
        (= display (str module-name ":" key))
      )
      (else-if (== (. function kind) .thread-local-init)
        (= key (str "init." module-name ".thread-local." (call global-name ([] storage (. function place)))))
        (= display (str module-name ":" key))
      )
      (else-if (== (. function kind) .stack-local-init)
        (= key (str "init." module-name ".stack-local." (call global-name ([] storage (. function place)))))
        (= display (str module-name ":" key))
      )
      (else-if (== (. function kind) .module-statics)
        (= key (str "init." module-name ".statics"))
        (= display (str module-name ":" key))
      )
      (else-if (call is-machine-group-kind (. function kind))
        (let handler (call machine-handler-of (. function place)))
        (let number (?? ([] made-numbers handler) 1))
        (let shown (if-expr (< number 2) "" (str number)))
        (let head (. ([] (. facts machine-groups) (. function place)) head))
        (= key
          (paragraph
            (str (call instance-display (. function instance)) "." (call hex-text ([] (. instances stable-keys) (. function instance))) ".state-transition." head)
          )
        )
        (= display (str module-name ":state-transition" shown))
        (if (== (. function kind) .machine-cast)
          (= key (str key ".cast"))
          (= display (str display "Casting"))
        )
        (if (== (. function kind) .machine-activation)
          (= key (str key ".activation"))
          (= display (str module-name ":StateTransitionActivation"))
        )
        (if (== (. function kind) .machine-deferral)
          (= key (str key ".deferral"))
          (= display (str module-name ":StateTransitionDeferral"))
        )
      )
      (else-if (== (. function kind) .machine-part)
        (let stable (call hex-text ([] (. instances stable-keys) (. function instance))))
        (= key (str (call instance-display (. function instance)) "." stable ".state-part"))
        (= display (str module-name ":state-part"))
      )
      (else-if (== (. function kind) .machine-stop)
        (let stable (call hex-text ([] (. instances stable-keys) (. function instance))))
        (= key (str (call instance-display (. function instance)) "." stable ".state-stop"))
        (= display (str module-name ":state-stop"))
      )
      (else-if (== (. function kind) .stream-action)
        (let arm (. ([] (. facts outlined) (. function place)) arm))
        (let number (?? ([] made-numbers id) 1))
        (let shown (if-expr (< number 2) "" (str number)))
        (= display (str module-name ":stream-action" shown))
        (= key
          (paragraph
            (str (call instance-display (. function instance)) "." (call hex-text ([] (. instances stable-keys) (. function instance))) ".stream-action." arm)
          )
        )
      )
      (else-if (== (. function kind) .pattern-helper)
        (let row ([] (. facts pattern-arguments) (. function place)))
        (let number (?? ([] made-numbers id) 1))
        (let shown (if-expr (< number 2) "" (str number)))
        (= display (str module-name ":static-inline-match" shown "-direct"))
        (= key
          (paragraph
            (str (call instance-display (. function instance)) "." (call hex-text ([] (. instances stable-keys) (. function instance))) ".pattern." (. row syntax))
          )
        )
      )
      (else-if (== (. function kind) .pattern-cast)
        (let row ([] (. facts pattern-arguments) (. function place)))
        (let number (?? ([] made-numbers id) 1))
        (let shown (if-expr (< number 2) "" (str number)))
        (= display (str (call instance-display (. row rule)) "Casting" shown))
        (= key (str display "." (call hex-text ([] (. instances stable-keys) (. function instance))) ".pattern." (. row syntax)))
      )
      (else-if (!= (call lazy-rule-decl function) 0)
        (let number (?? ([] made-numbers id) 1))
        (let shown (if-expr (< number 2) "" (str number)))
        (= display (str module-name ":" (call lazy-rule-text function) "-direct" shown "-direct"))
        (= key
          (paragraph
            (str (call instance-display (. function instance)) "." (call hex-text ([] (. instances stable-keys) (. function instance))) ".lazy." (call lazy-rule-decl function))
          )
        )
        (if (== (. function kind) .rule-adapter)
          (= display (str module-name ":" (call lazy-rule-text function)))
          (= key (str key ".adapter"))
          (else-if (!= (call rule-adapter-of (. function instance) (call lazy-rule-decl function)) no-function)
            (= display (str module-name ":" (call lazy-rule-text function) shown "-direct"))
          )
        )
        (if (== (. function kind) .mapped-rule)
          (= key (str key (call mapping-key (. ([] rule-mappings (. function place)) names))))
        )
        (if (== (. function kind) .raising-rule)
          (= key (str key ".raising." (. function place)))
        )
      )
      (else-if (== (. function kind) .mapped-rule)
        (let number (?? ([] made-numbers id) 1))
        (let shown (if-expr (< number 2) "" (str number)))
        (= display (str module-name ":" (call callee-name (. function instance)) "-direct" shown "-direct"))
        (= key
          (paragraph
            (str (call instance-display (. function instance)) "." (call hex-text ([] (. instances stable-keys) (. function instance))) (call mapping-key (. ([] rule-mappings (. function place)) names)))
          )
        )
      )
      (else-if (== (. function kind) .raising-rule)
        (let number (?? ([] made-numbers id) 1))
        (let shown (if-expr (< number 2) "" (str number)))
        (= display (str module-name ":" (call callee-name (. function instance)) "-direct" shown "-direct"))
        (= key
          (paragraph
            (str (call instance-display (. function instance)) "." (call hex-text ([] (. instances stable-keys) (. function instance))) ".raising." (. function place))
          )
        )
      )
      (else-if (== (. function kind) .argument-default)
        (let kept ([] storage (. function place)))
        (= display (str module-name ":" (call default-name kept) "-default"))
        (= key (str (call instance-display (. kept owner)) "." owner-key ".default." (. kept syntax)))
        (lazy owner-key (call hex-text ([] (. instances stable-keys) (. kept owner))))
      )
      (else-if (and (== (. function kind) .adapter) (== (. ([] adapters (. function place)) runs) no-instance))
        (let row ([] adapters (. function place)))
        (= display (str module-name ":Casting"))
        (= (. ([] functions id) placeless) (. row shared))
        (let source (call hex-text ([] (. types stable-keys) (. row from))))
        (= key (str module-name ".cast.adapter." source "." (call hex-text ([] (. types stable-keys) (. row to)))))
      )
      (else-if (== (. function kind) .adapter)
        (let row ([] adapters (. function place)))
        (= display (str module-name ":" (call callee-name (. row runs)) "Casting"))
        (let declared (only-if (call (. types c-function-decl) (. row to)) (if (call is-c-function types (. row to)))))
        (= (. ([] functions id) unplaced) (and (call is-c-function types (. row to)) (not declared)))
        (= (. ([] functions id) placeless) (. row shared))
        (if declared
          (= (. ([] functions id) site-module) (. declared module))
          (if (== ([] (. module-paths data) (. declared module)) no-string)
            (= ([] (. module-paths data) (. declared module))
              (call (. bundle intern)
                (block
                  (arg (. ([] (. program modules) (. declared module)) relative-path))
                )
              )
            )
          )
        )
        (let source (call hex-text ([] (. types stable-keys) (. row from))))
        (= key (str (call instance-display (. row runs)) ".adapter." source "." (call hex-text ([] (. types stable-keys) (. row to)))))
      )
      (else-if (== (. function kind) .union-dispatch)
        (let forward ([] (. facts forwards) (. function place)))
        (let union (call class-ref types (call cases-union forward)))
        (= display (str (. ([] (. program modules) (. union module)) name) ":union-dispatch-" forward-number))
        (lazy forward-number ([] forward-numbers (. function place)))
        (= key (str (call instance-display (. forward instance)) ".union-dispatch." (. forward syntax)))
      )
      (else-if (and (== (. function kind) .class-adapter) (== (. ([] class-adapters (. function place)) override) no-instance))
        (let row ([] class-adapters (. function place)))
        (= display (str module-name ":" (call callee-name (. row proto)) "(class-accessor)"))
        (let written (call hex-text ([] (. instances stable-keys) (. row proto))))
        (= key
          (paragraph
            (str (call instance-display (. row proto)) "." written ".class-accessor." (call type-key types (. row receiver)))
          )
        )
      )
      (else-if (== (. function kind) .class-adapter)
        (let row ([] class-adapters (. function place)))
        (= display (str module-name ":" (call callee-name (. row override)) "(class-adapter)"))
        (let written (call hex-text ([] (. instances stable-keys) (. row override))))
        (= key (str (call instance-display (. row override)) "." written ".class-adapter." proto-key))
        (lazy proto-key (call hex-text ([] (. instances stable-keys) (. row proto))))
      )
      (else-if (== (. function kind) .interface-equality)
        (let row ([] witnesses (. function place)))
        (= key (str "InterfaceEquality:" (call type-key types (. row value)) ":" (call type-key types (. row interface))))
        (= display (str module-name ":" key))
      )
      (else-if (== (. function kind) .source-attach)
        (= key "SourceAttach")
        (= display (str module-name ":attach-source"))
      )
      (else-if (== (. function kind) .raise-panic)
        (= key "RaisePanic")
        (= display (str module-name ":raise-panic"))
      )
      (else-if (== (. function kind) .raise-message)
        (= key "RaiseMessage")
        (= display (str module-name ":raise-message"))
      )
      (else-if (== (. function kind) .storage-growth)
        (let grown (if-expr (== (. function place) 0) "rows" "spill"))
        (= key (str "ColdStorageGrowth:" grown ":" (call type-key types (. function type))))
        (= display (str module-name ":cold-storage-" grown))
      )
      (else-if (== (. function kind) .witness)
        (let row ([] witness-functions (. function place)))
        (let answers
          (scope (if-expr (== (. row callee) no-instance) property-text (call instance-display (. row callee)))
            (lazy property-text (str module-name ":" (. ([] (. types properties) (. row property)) name text)))
          )
        )
        (= display (str module-name ":" (call callee-name (. row callee)) "(wrapped)"))
        (let answered (call hex-text ([] (. instances stable-keys) (. row proto))))
        (if (. row shared)
          (= key (str answers "." (call hex-text ([] (. instances stable-keys) (. row callee))) ".witness." answered))
          (else
            (= key (str answers ".witness." (call hex-text ([] (. types stable-keys) (. row value))) "." answered))
          )
        )
      )
    )
    (lazy trigger-remove (== (. function kind) .markup-trigger-remove))
    (lazy trigger-ancestor (== (. function kind) .markup-trigger-ancestor))
    (lazy query-remove (== (. function kind) .markup-query-remove))
    (= (. ([] functions id) name) (call (. bundle intern) key))
    (= (. ([] functions id) symbol) (call (. bundle intern) (call symbol-name (. program target) key)))
    (= (. ([] functions id) display) (call (. bundle intern) display))
    (if (and (== (. function kind) .instance-body) (!= (. ([] (. instances rows) (. function instance)) materialized) no-instance))
      (let owner (. ([] (. program modules) (. ([] (. instances rows) (. function instance)) module)) name))
      (= (. ([] functions id) bridge-display)
        (call (. bundle intern)
          (block
            (arg (str owner ":" (call callee-name (. function instance)) "-table-row-receiver-bridge"))
          )
        )
      )
    )
  )
  (fn-do _ declare-lazies _
    ; A function for each lazy property of each class the program constructs: that of the
    ; nearest class, from the constructed one up, that writes the property's value. Classes that
    ; take the value from one class share its function, and the type pass typed the value once
    ; for that class. It may panic when the value may, and it always writes the panic signal,
    ; because class tables hold it.
    (for (in type (. types ranked))
      (if (or (== ([] constructed type) 0) (not (call is-class type)))
        (continue)
      )
      (let range (. ([] (. types completions) type) properties))
      (for (in offset (..< 0 (. range count)))
        (let place (+ (. range start) offset))
        (let property ([] (. types properties) place))
        (if (!= (. property storage-kind) .storage-lazy)
          (continue)
        )
        (let owner
          (call writer-of
            (block
              (arg (if-expr (!= (. property owner) no-type) (. property owner) type))
              (arg property)
            )
          )
        )
        (let declared (if-expr (!= owner no-type) (call place-of-fact owner property) (. U32 max)))
        (if (== declared (. U32 max))
          (continue)
        )
        (if (== ([] lazy-functions declared) no-function)
          (let id FunctionId (as (. functions length) FunctionId))
          (call (. functions append) (call unnamed-function .lazy-property no-instance (call class-module owner) 8))
          (= (. ([] functions id) type) owner)
          (= (. ([] functions id) place) declared)
          (= (. ([] functions id) carries) true)
          (= ([] lazy-functions declared) id)
        )
        (= ([] lazy-functions place) ([] lazy-functions declared))
        (let unit (call find-unit type place (call default-of type place)))
        (= ([] value-units declared) unit)
        (if (and (!= unit no-instance) (. ([] (. instances rows) unit) may-panic))
          (= (. ([] functions ([] lazy-functions declared)) may-panic) true)
        )
        (if (and (!= unit no-instance) (. ([] (. instances rows) unit) polls))
          (= (. ([] functions ([] lazy-functions declared)) polls) true)
        )
      )
    )
  )
  (fn-do _ declare-updaters _
    ; A function for each stored property of each class the program constructs whose value reads
    ; something tracked: it evaluates the value again in the live action it runs in and stores it
    ; in the object, which is its data as a callback. It may panic, as what it calls may.
    (if (== (. instances live track) no-instance)
      (return)
    )
    (for (in type (. types ranked))
      (if (or (== ([] constructed type) 0) (not (call is-class type)))
        (continue)
      )
      (let range (. ([] (. types completions) type) properties))
      (for (in offset (..< 0 (. range count)))
        (let place (+ (. range start) offset))
        (let unit ([] value-units place))
        (if (or not-eager (== unit no-instance) (not (. ([] (. instances rows) unit) is-live)))
          (continue)
        )
        (lazy not-eager (!= (. ([] (. types properties) place) storage-kind) .storage-eager))
        (let id FunctionId (as (. functions length) FunctionId))
        (call (. functions append) (call unnamed-function .property-updater no-instance (call class-module type) 8))
        (= (. ([] functions id) type) type)
        (= (. ([] functions id) place) place)
        (= (. ([] functions id) may-panic) true)
        (= (. ([] functions id) polls) (. ([] (. instances rows) unit) polls))
        (= ([] updater-functions place) id)
        (call declare-live-adapter id)
      )
    )
  )
  (fn-do _ declare-queries _
    ; The functions made for each markup query a registration an emitted constructor makes
    ; reaches: one that finds the ancestor an ancestor query looks for, and for a descendant
    ; query one that adds an object to the list the property holds and one that takes it from it.
    ; Each is given the object as its data, and may panic, as what it calls may.
    (for (in index (..< 0 (. facts markup-queries length)))
      (if (== ([] query-used index) 0)
        (continue)
      )
      (let query ([] (. facts markup-queries) index))
      (let module (call class-module (. query level)))
      (let kinds (list FunctionKind))
      (if (== (. query target-id) 0)
        (+= kinds .markup-query)
        (else
          (+= kinds .markup-query-add)
          (+= kinds .markup-query-remove)
        )
      )
      (for (in position (..< 0 (. kinds length)))
        (let id FunctionId (as (. functions length) FunctionId))
        (call (. functions append) (call unnamed-function ([] kinds position) no-instance module 8))
        (= (. ([] functions id) type) (. query level))
        (= (. ([] functions id) place) (as index U32))
        (= (. ([] functions id) may-panic) true)
        (= ([] query-functions (+ (* index 2) position)) id)
      )
    )
  )
  (fn-do _ declare-live-adapter _
    (param target FunctionId)
    ; The function a live action calls to run a function again, through the callback the
    ; action holds, as the reference casts the function to the callback's type: it follows the
    ; function it calls, and is given the data the callback holds.
    (let id FunctionId (as (. functions length) FunctionId))
    (call (. functions append) (call unnamed-function .live-adapter no-instance (. ([] functions target) module) 4))
    (= (. ([] functions id) place) target)
    (= (. ([] functions id) may-panic) true)
  )
  (fn-do _ declare-class-rules _
    ; The rules each class the program constructs runs once its constructor's body has run: its
    ; own and those of each class above it, base first, each class's dependencies, then the
    ; sections that subscribe to a stream, then the starts of the state machines its properties
    ; hold, then its other rules, in the order they are written. They are kept in
    ; `class-rule-order`, from where `class-rule-heads` says up to `U32.max`. The
    ; rules a class runs once its markup has are kept there too, apart, from where
    ; `markup-rule-heads` says for the class that writes them: its sections, then its other such
    ; rules. A `when` or `whenever` rule typed for the class that writes it has one function a
    ; live action runs it again with, which may panic, and the adapter the action calls it
    ; through.
    (for (in type (. types ranked))
      (if (or (== ([] constructed type) 0) (not (call is-class type)))
        (continue)
      )
      (let chain (list TypeId))
      (let level (? TypeId) type)
      (while level
        (+= chain level)
        (= level (call (. types base-of) level))
      )
      (let start (. class-rule-order length))
      (for (in offset (..< 0 (. chain length)))
        (let holder ([] chain (- (. chain length) 1 offset)))
        (let parts (call class-parts (call class-ref types holder)))
        (for (in pass (..< 0 3))
          (if (== pass 2)
            (for (in part parts)
              (let owner ([] (. program modules) (. part module)))
              (for (in member ([] (. owner member-pool) (call class-part-members part)))
                (let machine (call member-machine (. part module) member))
                (if (!= machine 0)
                  (+= class-rule-order
                    (call class-machine
                      (block
                        (arg holder)
                        (arg (. part module))
                        (arg member)
                        (arg machine)
                      )
                    )
                  )
                )
              )
            )
          )
          (for (in part parts)
            (let owner ([] (. program modules) (. part module)))
            (for (in member ([] (. owner member-pool) (call class-part-members part)))
              (match? ([] (. owner decls) member)
                (case (call .decl-rule rule)
                  (if (and in-pass (not (call waits holder (. part module) member)))
                    (+= class-rule-order
                      (call class-rule
                        (block
                          (arg holder)
                          (arg (. part module))
                          (arg member)
                          (arg (. rule syntax))
                        )
                      )
                    )
                  )
                  (lazy in-pass (== (call rule-pass (. part module) (. rule syntax)) pass))
                )
              )
            )
          )
        )
      )
      (if (!= (. class-rule-order length) start)
        (+= class-rule-order (. U32 max))
        (= ([] class-rule-heads type) (as start U32))
      )
      (for (in holder chain)
        (call declare-markup-rules holder)
      )
    )
  )
  (fn-do _ class-parts (list DeclRef)
    (param ref DeclRef)
    ; The declarations a class writes its rules in: its own, then each facet bound to it, in the order
    ; of its facets.
    (let parts (list DeclRef))
    (+= parts ref)
    (let facets (. program facets))
    (return-if parts (if (== (. facets count) 0)))
    (blank)
    (let (tuple start end) (call (. facets class-range) (. ref module) (. ref decl)))
    (for (in position (..< start end))
      (let facet ([] (. facets class-facets) position))
      (if (== ([] (. facets states) facet) .facet-bound)
        (+= parts (call DeclRef ([] (. facets modules) facet) ([] (. facets decls) facet)))
      )
    )
    (return parts)
  )
  (fn-expr _ class-part-members (of RowRange DeclId)
    (param ref DeclRef)
    ; The members a class or a facet of one declares.
    (match ([] (. ([] (. program modules) (. ref module)) decls) (. ref decl))
      (case (call .decl-class row)
        (. row members)
      )
      (case (call .decl-extension row)
        (. row members)
      )
      (default
        (call (of RowRange DeclId))
      )
    )
  )
  (fn-expr _ member-machine SyntaxId
    (param module ModuleId)
    (param decl DeclId)
    ; The state machine a property of a class holds, or none (`index-sites`).
    (?? ([] member-machines (/or/ (/lshift/ (as module Size) 32) (as decl Size))) 0)
  )
  (fn-do _ class-machine U32
    (param level TypeId)
    (param module ModuleId)
    (param decl DeclId)
    (param syntax SyntaxId)
    ; The row of the start of a state machine a property of a class holds, which types nothing of
    ; its own and keeps nothing.
    (let index U32 (as (. class-rules length) U32))
    (call (. class-rules append)
      (block
        (arg
          (call ClassRule
            (block
              (arg level)
              (arg module)
              (arg decl)
              (arg syntax)
              (arg no-instance)
              (arg no-layout)
              (arg no-function)
              (arg no-function)
              (arg no-function)
            )
          )
        )
      )
    )
    (return index)
  )
  (fn-expr _ waits Bool
    (param level TypeId)
    (param module ModuleId)
    (param decl DeclId)
    ; Whether a rule typed for the class that writes it runs once the markup of the class has.
    (and (!= unit no-instance) (call (. facts waits-for-markup) unit))
    (where
      (lazy unit (call (. instances find-initializer) module decl level))
    )
  )
  (fn-do _ declare-markup-rules _
    (param level TypeId)
    ; The rules a class runs once its markup has, as rows of `class-rules`, listed once for the
    ; class: its own, then its facets'.
    (if ([] markup-rule-heads level)
      (return)
    )
    (let parts (call class-parts (call class-ref types level)))
    (let start (. class-rule-order length))
    (for (in pass (..< 1 3))
      (for (in part parts)
        (let owner ([] (. program modules) (. part module)))
        (for (in member ([] (. owner member-pool) (call class-part-members part)))
          (match? ([] (. owner decls) member)
            (case (call .decl-rule rule)
              (if (and in-pass (call waits level (. part module) member))
                (+= class-rule-order (call class-rule level (. part module) member (. rule syntax)))
              )
              (lazy in-pass (== (call rule-pass (. part module) (. rule syntax)) pass))
            )
          )
        )
      )
    )
    (+= class-rule-order (. U32 max))
    (= ([] markup-rule-heads level) (as start U32))
  )
  (fn-do _ rule-pass U32
    (param module ModuleId)
    (param syntax SyntaxId)
    ; Where a rule of a class runs among the others: dependencies first, then sections that
    ; subscribe to a stream, then the rest.
    (match? ([] (. ([] (. program modules) module) tree nodes) syntax)
      (case .node-dependency-declaration
        (return 0)
      )
      (case .node-subscriber-syntax
        (return 1)
      )
    )
    (return 2)
  )
  (fn-do _ reach-lowered Bool
    (param kinds (of CPointer U32))
    ; Marks the event runtime's `event-register-lowered`, with its `event-register-lowered-arrival`,
    ; where a class the program constructs runs
    ; a section, or a group of the event transitions of a machine the program reaches, from its
    ; table, and says whether one does.
    (for (in row (. facts lowered-handlers))
      (if (!= ([] constructed (. row type)) 0)
        (call mark kinds (. facts event-register))
        (if (!= (. facts event-register-arrival) no-instance)
          (call mark kinds (. facts event-register-arrival))
        )
        (call drain kinds)
        (return true)
      )
    )
    (for (in machine (. facts machines))
      (if (== ([] kinds (. machine instance)) (. Reach none))
        (continue)
      )
      (for (in group (..< (. machine groups start) (+ (. machine groups start) (. machine groups count))))
        (if (and (. ([] (. facts machine-groups) group) lowered) (!= (. (call machine-classes machine) length) 0))
          (call mark kinds (. facts event-register))
          (call drain kinds)
          (return true)
        )
      )
    )
    (return false)
  )
  (fn-do _ keep-reached-styles _
    (param kinds (of CPointer U32))
    ; Keeps the styles a function the program reaches uses, as the reference registers only those
    ; of the code it compiles: each is placed at the first place such a function uses it, a
    ; constructor's declaration before any other, and they are numbered again in the source order
    ; of those places (`style-before`), before those no such function uses, which are not
    ; registered. So are the style sheets, those no such function uses after the others, by the keys
    ; of their types (`sheet-order`), so that a sheet's number is the same in any typing order
    ; (`sheet-number`). An instance compiled into the frame of one the program reaches, as a
    ; property's first value is, counts as reached. A style rule's declarations are written where the rule is applied, so the
    ; instance that types a rule counts as reached where one that applies it is.
    (= carried (call (of (. arena allocate) Byte) (+ (. instances length) 1)))
    (for (in position (..< 0 (. instances length)))
      (= ([] carried position) (if-expr (!= ([] kinds position) (. Reach none)) 1 0))
    )
    (let grew true)
    (while grew
      (= grew false)
      (for (in application (. facts style-applications))
        (if (and (!= ([] carried (. application instance)) 0) (== ([] carried (. application unit)) 0))
          (= ([] carried (. application unit)) 1)
          (= grew true)
        )
      )
    )
    (let kept (list PlacedStyle))
    (let dropped (list PlacedStyle))
    (for (in use (. facts style-uses))
      (let found (call reached-user carried (. use type)))
      (if (== found (. U32 max))
        (+= dropped (call PlacedStyle (. use type) 0 0 (. use singleton) (. use first) (. use count) false))
        (else
          (let user ([] (. facts style-users) found))
          (+= kept
            (call PlacedStyle
              (block
                (arg (. use type))
                (arg (. user module))
                (arg (. user site))
                (arg (. use singleton))
                (arg (. use first))
                (arg (. use count))
                (arg true)
              )
            )
          )
        )
      )
    )
    (for (in use kept)
      (let place (. style-uses length))
      (+= style-uses use)
      (while (and (> place 0) (call style-before use ([] style-uses (- place 1))))
        (= ([] style-uses place) ([] style-uses (- place 1)))
        (-= place 1)
      )
      (= ([] style-uses place) use)
    )
    (for (in use dropped)
      (+= style-uses use)
    )
    (let sheets (list PlacedStyle))
    (let order (list U32))
    (for (in use (. facts style-sheet-uses))
      (let found (call reached-user carried (. use type)))
      (+= order (as (. sheets length) U32))
      (+= sheet-numbers 0)
      (if (== found (. U32 max))
        (+= sheets (call PlacedStyle (. use type) 0 0 (. use singleton) (. use first) (. use count) false))
        (else
          (let user ([] (. facts style-users) found))
          (+= sheets
            (call PlacedStyle
              (block
                (arg (. use type))
                (arg (. user module))
                (arg (. user site))
                (arg (. use singleton))
                (arg (. use first))
                (arg (. use count))
                (arg true)
              )
            )
          )
        )
      )
    )
    (let numbered (call sort order (:using (=> (a b) (call sheet-order ([] sheets a) ([] sheets b))))))
    (for (in number (..< 0 (. numbered length)))
      (+= style-sheet-uses ([] sheets ([] numbered number)))
      (= ([] sheet-numbers ([] numbered number)) (as number U32))
    )
  )
  (fn-expr _ sheet-order Comparison
    (param sheet PlacedStyle)
    (param other PlacedStyle)
    (case? (!= (. sheet registered) (. other registered))
      (if-expr (. sheet registered) (. Comparison lesser) (. Comparison greater))
    )
    (case? (call style-before sheet other)
      (. Comparison lesser)
    )
    (case? (call style-before other sheet)
      (. Comparison greater)
    )
    (default
      (. Comparison equal)
    )
  )
  (fn-expr _ style-before Bool
    (param style PlacedStyle)
    (param other PlacedStyle)
    ; Whether a style the program registers is numbered before another: placed earlier in source
    ; order (`comes-before`), or placed together and with the lesser key of its type.
    (case? (call comes-before (. style module) (. style site) (. other module) (. other site))
      true
    )
    (case? (call comes-before (. other module) (. other site) (. style module) (. style site))
      false
    )
    (default
      (< (call (. types key-of) (. style type)) (call (. types key-of) (. other type)))
    )
  )
  (fn-do _ reached-user U32
    (param carried (of CPointer Byte))
    (param type TypeId)
    ; The place among `style-users` of the first use of a style or style sheet by an instance the
    ; program reaches, a constructor's before any other; none where no such instance uses it.
    (let found (. U32 max))
    (for (in position (..< 0 (. facts style-users length)))
      (let user ([] (. facts style-users) position))
      (if (or (!= (. user type) type) (== ([] carried (. user instance)) 0))
        (continue)
      )
      (if (== found (. U32 max))
        (= found (as position U32))
        (continue)
      )
      (let best ([] (. facts style-users) found))
      (if (or (and (== (. user constructed) (. best constructed)) earlier) (and (. user constructed) (not (. best constructed))))
        (= found (as position U32))
      )
      (lazy earlier (call comes-before (. user module) (. user site) (. best module) (. best site)))
    )
    (return found)
  )
  (fn-expr _ comes-before Bool
    (param module ModuleId)
    (param site SyntaxId)
    (param other-module ModuleId)
    (param other SyntaxId)
    ; Whether a place in the program comes before another in source order: in a module loaded
    ; first, or earlier in the same module.
    (case? (!= module other-module)
      (< module other-module)
    )
    (default
      (or (< (. begin line) (. other-begin line)) column-before)
    )
    (where
      (lazy tree (. ([] (. program modules) module) tree))
      (lazy begin (. ([] (. tree nodes loc) site) begin))
      (lazy other-begin (. ([] (. tree nodes loc) other) begin))
      (lazy column-before (and (== (. begin line) (. other-begin line)) (< (. begin column) (. other-begin column))))
    )
  )
  (fn-expr _ place-order Comparison
    (param module ModuleId)
    (param site SyntaxId)
    (param other-module ModuleId)
    (param other SyntaxId)
    ; Orders two places in the program in source order, as `comes-before` does, and two that begin
    ; together, or that are no node, by their syntax.
    (case? (!= module other-module)
      (call ordered module other-module)
    )
    (case? (or (>= site (. tree nodes length)) (>= other (. tree nodes length)))
      (call ordered site other)
    )
    (case? (!= (. begin line) (. other-begin line))
      (call ordered (. begin line) (. other-begin line))
    )
    (case? (!= (. begin column) (. other-begin column))
      (call ordered (. begin column) (. other-begin column))
    )
    (default
      (call ordered site other)
    )
    (where
      (lazy tree (. ([] (. program modules) module) tree))
      (lazy begin (. ([] (. tree nodes loc) site) begin))
      (lazy other-begin (. ([] (. tree nodes loc) other) begin))
    )
  )
  (fn-expr _ line-order Comparison
    (param instance InstanceId)
    (param site SyntaxId)
    (param other-instance InstanceId)
    (param other SyntaxId)
    ; Orders two places of instances by the stable keys of the instances, and two of one instance by
    ; their syntax.
    (case? (!= instance other-instance)
      (call ordered (call instance-key instance) (call instance-key other-instance))
    )
    (default
      (call ordered site other)
    )
  )
  (fn-expr _ instance-key U64
    (param instance InstanceId)
    (if-expr (!= instance no-instance) (as ([] (. instances stable-keys) instance) U64) 0)
  )
  (fn-expr _ ordered Comparison
    (param value U64)
    (param other U64)
    (case? (< value other)
      (. Comparison lesser)
    )
    (case? (> value other)
      (. Comparison greater)
    )
    (default
      (. Comparison equal)
    )
  )
  (fn-do _ reach-styles Bool
    (param kinds (of CPointer U32))
    ; Marks what registering the styles the program uses calls: the style runtime's functions,
    ; the constructor of each style's object, and what turns values into bits where some instance
    ; uses it (`used-codings`). Says whether any of it may panic, which every registration then may.
    (if (== (. style-uses length) 0)
      (return false)
    )
    (let runtime (. facts style-runtime))
    (let used (call used-codings false))
    (let held (call used-codings true))
    (let boxed false)
    (for (in position (..< 0 (. facts style-codings length)))
      (= boxed (or boxed (and ([] used position) (!= (. ([] (. facts style-codings) position) holder) no-instance))))
    )
    (let calls
      (call List
        (block
          (item (. runtime info-for))
          (item (. runtime info))
          (item (. runtime register-property))
          (item (. runtime register))
          (item (. runtime register-domain))
        )
      )
    )
    (if (and (!= (. runtime intern-holder) no-instance) boxed)
      (+= calls (. runtime intern-holder))
    )
    (for (in use style-uses)
      (if (. use registered)
        (+= calls (. use singleton))
      )
    )
    (if (!= (. style-sheet-uses length) 0)
      (+= calls (. runtime sheet-info-for))
      (+= calls (. runtime sheet-info))
      (+= calls (. runtime sheet-register-slot))
      (+= calls (. runtime sheet-register))
    )
    (for (in use style-sheet-uses)
      (if (. use registered)
        (+= calls (. use singleton))
        (for (in member (. facts sheet-members))
          (if (== (. member root) (. use type))
            (+= calls (. runtime sheet-register-member))
            (+= calls (. runtime sheet-member-slot))
            (+= calls (. runtime sheet-member-tag))
            (+= calls (. member singleton))
          )
        )
      )
    )
    (let position 0)
    (for (in coding (. facts style-codings))
      (if ([] used position)
        (+= calls (if-expr (!= (. coding intern) no-instance) (. coding intern) (. coding holder)))
      )
      (if (and ([] held position) (!= (. coding value-holder) no-instance))
        (+= calls (. coding value-holder))
      )
      (+= position 1)
    )
    (for (in callee (list (. runtime info-required) (. runtime site-inherit) (. runtime template-object) (. runtime site-cached) (. runtime author-object) (. runtime object-pointer) (. runtime imperative) (. runtime imperative-object)))
      (if (!= callee no-instance)
        (+= calls callee)
      )
    )
    (let panics false)
    (for (in callee calls)
      (call mark kinds callee)
      (call drain kinds)
      (if (. ([] (. instances rows) callee) may-panic)
        (= panics true)
      )
    )
    (return panics)
  )
  (fn-expr _ is-retired Bool
    (param instance InstanceId)
    ; Whether a row names the instance that holds what instances an edit typed again in place had
    ; recorded (`Facts.retire`): program tables make nothing of such a row.
    (and (!= instance no-instance) (== instance (. instances dead)))
  )
  (fn-do _ used-codings (list Bool)
    (param holds Bool)
    ; Which rows of `style-codings` some instance uses (`Facts.coding-users`), or, where `holds`,
    ; holds an object by the row's `value-holder`. A row only instances an edit retired used is
    ; unused, as no row is in a cold build.
    (let used (list Bool))
    (for (in _ (..< 0 (. facts style-codings length)))
      (+= used false)
    )
    (for (in user (. facts coding-users))
      (if (or (. user holds) (not holds))
        (for (in position (..< 0 (. facts style-codings length)))
          (if (== (. ([] (. facts style-codings) position) type) (. user type))
            (= ([] used position) true)
          )
        )
      )
    )
    (return used)
  )
  (fn-do _ used-gates (list Bool)
    ; Which rows of `style-gates` some instance uses (`Facts.gate-users`). A row only instances an
    ; edit retired used is unused, as no row is in a cold build.
    (let used (list Bool))
    (for (in _ (..< 0 (. facts style-gates length)))
      (+= used false)
    )
    (for (in user (. facts gate-users))
      (= ([] used (. user gate)) true)
    )
    (return used)
  )
  (fn-do _ declare-style-gates _
    ; A function for each row of `style-gates` some instance uses (`used-gates`), which evaluates the
    ; conditions of the row again in the live action it runs in and enables or disables the block it
    ; is given, or the record of generated content, in the module of the innermost `when`, with what
    ; the action that runs it keeps laid out: the object, the block or the record, then the state cell
    ; of each `when` that is one and the environment of each condition a rule is applied under. It may
    ; panic, as noting a read may. The rows are declared in the order `gate-order` gives them.
    (let cell (call cell-type))
    (let record
      (scope (if-expr (!= (. facts style-runtime template-content) no-instance) content-record no-type)
        (lazy content-record (. ([] (. instances signatures) (. facts style-runtime template-content)) returns))
      )
    )
    (let used (call used-gates))
    (let rows (list U32))
    (for (in index (..< 0 (. facts style-gates length)))
      (if ([] used index)
        (+= rows (as index U32))
      )
      (+= gate-functions no-function)
      (+= gate-layouts no-layout)
    )
    (let ordered-rows (call sort rows (:using (=> (a b) (call gate-order a b)))))
    (for (in number (..< 0 (. ordered-rows length)))
      (let index ([] ordered-rows number))
      (let gate ([] (. facts style-gates) index))
      (let written ([] (. facts style-gate-whens) (- (+ (. gate first) (. gate count)) 1)))
      (let id FunctionId (as (. functions length) FunctionId))
      (call (. functions append) (call unnamed-function .style-gate no-instance (. written module) 8))
      (= (. ([] functions id) type) (. gate type))
      (= (. ([] functions id) place) index)
      (= (. ([] functions id) number) (as number U32))
      (= (. ([] functions id) may-panic) true)
      (= ([] gate-functions index) id)
      (call declare-live-adapter id)
      (let children (list LayoutId))
      (let held (list TypeId))
      (+= children managed-layout)
      (+= held (. gate type))
      (if (. gate content)
        (+= children managed-layout)
        (+= held record)
        (else
          (+= children i64-layout)
          (+= held (call (. types type-row) .int64))
        )
      )
      (for (in position (..< 0 (. gate count)))
        (let place ([] (. facts style-gate-whens) (+ (. gate first) position)))
        (if (!= (. place cell) (. U32 max))
          (+= children managed-layout)
          (+= held cell)
          (else-if (!= (. place test) no-instance)
            (+= children managed-layout)
            (+= held no-type)
          )
        )
      )
      (= ([] gate-layouts index) (call (. layouts environment) children held (str "style-gate." number)))
    )
  )
  (fn-do _ gate-order Comparison
    (param row U32)
    (param other U32)
    ; Orders two rows of `style-gates` by their `when`s from the innermost out, each by its place in
    ; source order, by whether it is a state cell and by the stable key of its test; then by how many
    ; they are, by whether the row gates content, and by the stable key of the type it gates.
    (let gate ([] (. facts style-gates) row))
    (let against ([] (. facts style-gates) other))
    (let depth (if-expr (< (. gate count) (. against count)) (. gate count) (. against count)))
    (for (in position (..< 0 depth))
      (let held ([] (. facts style-gate-whens) (- (+ (. gate first) (. gate count)) 1 position)))
      (let given ([] (. facts style-gate-whens) (- (+ (. against first) (. against count)) 1 position)))
      (let placed (call place-order (. held module) (. held syntax) (. given module) (. given syntax)))
      (if (!= placed (. Comparison equal))
        (return placed)
      )
      (if (!= (== (. held cell) (. U32 max)) (== (. given cell) (. U32 max)))
        (return (if-expr (== (. held cell) (. U32 max)) (. Comparison lesser) (. Comparison greater)))
      )
      (if (!= (. held test) (. given test))
        (return (call ordered (call instance-key (. held test)) (call instance-key (. given test))))
      )
    )
    (if (!= (. gate count) (. against count))
      (return (call ordered (. gate count) (. against count)))
    )
    (if (!= (. gate content) (. against content))
      (return (if-expr (. gate content) (. Comparison greater) (. Comparison lesser)))
    )
    (return (call ordered (call (. types key-of) (. gate type)) (call (. types key-of) (. against type))))
  )
  (fn-do _ declare-scope-cells _
    ; A function for each row of `scope-cells` made where it is bound, which evaluates the state of
    ; its `when` again in the live action it runs in and gives the cell it is given whether it holds,
    ; in the module of the `when`, with what the action that runs it keeps laid out. It may panic, as
    ; noting a read may. A cell an instance is given, keeps or reads has none, nor has one found on
    ; the way to a slot outlet, which no instance makes, nor one an edit retired (`is-retired`). The
    ; rows are declared in the order `cell-order` gives them.
    (let cell (call cell-type))
    (let rows (list U32))
    (for (in index (..< 0 (. facts scope-cells length)))
      (let row ([] (. facts scope-cells) index))
      (+= cell-functions no-function)
      (+= cell-layouts no-layout)
      (if (and (!= (. row site) (. U32 max)) (!= (. row instance) no-instance) (not (call is-retired (. row instance))))
        (+= rows (as index U32))
      )
    )
    (let ordered-rows (call sort rows (:using (=> (a b) (call cell-order a b)))))
    (for (in number (..< 0 (. ordered-rows length)))
      (let index ([] ordered-rows number))
      (let row ([] (. facts scope-cells) index))
      (let id FunctionId (as (. functions length) FunctionId))
      (call (. functions append) (call unnamed-function .style-scope-state no-instance (. row module) 8))
      (= (. ([] functions id) type) (. row owner))
      (= (. ([] functions id) place) index)
      (= (. ([] functions id) number) (as number U32))
      (= (. ([] functions id) may-panic) true)
      (= ([] cell-functions index) id)
      (call declare-live-adapter id)
      (let children (list LayoutId))
      (let held (list TypeId))
      (+= children managed-layout)
      (+= held (. row owner))
      (+= children managed-layout)
      (+= held cell)
      (= ([] cell-layouts index) (call (. layouts environment) children held (str "style-scope-state." number)))
    )
  )
  (fn-expr _ cell-order Comparison
    (param row U32)
    (param other U32)
    ; Orders two rows of `scope-cells` made at a site of an instance: by the place of their `when` in
    ; source order, then by the stable key of the instance, by the site, and by where each is made.
    (case? (!= placed (. Comparison equal))
      placed
    )
    (case? (!= (. cell instance) (. against instance))
      (call ordered (call instance-key (. cell instance)) (call instance-key (. against instance)))
    )
    (case? (!= (. cell site) (. against site))
      (call ordered (. cell site) (. against site))
    )
    (case? (!= (. made module) (. given module))
      (call ordered (. made module) (. given module))
    )
    (default
      (call ordered (. made site) (. given site))
    )
    (where
      (lazy cell ([] (. facts scope-cells) row))
      (lazy against ([] (. facts scope-cells) other))
      (lazy placed (call place-order (. cell module) (. cell when) (. against module) (. against when)))
      (lazy made ([] (. instances state-keys) (. cell key)))
      (lazy given ([] (. instances state-keys) (. against key)))
    )
  )
  (fn-do _ declare-kept-cells _
    ; The environment each function that builds markup and keeps state cells or values of rules of
    ; the function it is written in is given, as `kept-layouts` lays it out, but for rows an edit
    ; retired (`is-retired`).
    (let keeping (list InstanceId))
    (for (in row (. facts scope-cells))
      (if (and (!= (. row kept) (. U32 max)) (not (call is-retired (. row instance))) (== (call (. keeping find) (. row instance)) null))
        (+= keeping (. row instance))
      )
    )
    (for (in row (. facts scope-values))
      (if (and (!= (. row kept) (. U32 max)) (not (call is-retired (. row instance))) (== (call (. keeping find) (. row instance)) null))
        (+= keeping (. row instance))
      )
    )
    (let keepers (call sort keeping (:using (=> (a b) (call ordered (call instance-key a) (call instance-key b))))))
    (for (in keeper keepers)
      (let children (list LayoutId))
      (let held (list TypeId))
      (+= children managed-layout)
      (+= held no-type)
      (for (in row (. facts scope-cells))
        (if (and (== (. row instance) keeper) (!= (. row kept) (. U32 max)))
          (+= children managed-layout)
          (+= held (call cell-type))
        )
      )
      (for (in row (. facts scope-values))
        (if (and (== (. row instance) keeper) (!= (. row kept) (. U32 max)))
          (for (in position (..< (. row type-first) (+ (. row type-first) (. row count))))
            (let type ([] (. facts scope-value-types) position))
            (+= children ([] (. layouts values) type))
            (+= held type)
          )
        )
      )
      (+= kept-instances keeper)
      (+= kept-layouts
        (call (. layouts environment)
          (block
            (arg children)
            (arg held)
            (arg (str "kept." (call hex-text ([] (. instances stable-keys) keeper))))
          )
        )
      )
    )
  )
  (fn-do _ declare-slot-forwards _
    ; A function for each row of `slot-forwards` but those an edit retired (`is-retired`), which
    ; holds the state cells the line holds (`OutletCell`) while the builder it forwards runs, in the
    ; module of the line, with what it keeps laid out. It may panic, as the builder may. The rows are
    ; declared in the order of the stable keys of their instances, and of their lines.
    (let cell (call cell-type))
    (let rows (list U32))
    (for (in index (..< 0 (. facts slot-forwards length)))
      (if (not (call is-retired (. ([] (. facts slot-forwards) index) instance)))
        (+= rows (as index U32))
      )
      (+= slot-forward-functions no-function)
      (+= slot-forward-layouts no-layout)
    )
    (let forwards (. facts slot-forwards))
    (let ordered-rows (call sort rows (:using (=> (a b) (call line-order (. ([] forwards a) instance) (. ([] forwards a) line) (. ([] forwards b) instance) (. ([] forwards b) line))))))
    (for (in number (..< 0 (. ordered-rows length)))
      (let index ([] ordered-rows number))
      (let row ([] forwards index))
      (let id FunctionId (as (. functions length) FunctionId))
      (call (. functions append)
        (block
          (arg (call unnamed-function .slot-forward no-instance (. ([] (. instances rows) (. row instance)) module) 8))
        )
      )
      (= (. ([] functions id) type) (. row builder))
      (= (. ([] functions id) place) index)
      (= (. ([] functions id) number) (as number U32))
      (= (. ([] functions id) may-panic) true)
      (= ([] slot-forward-functions index) id)
      (let children (list LayoutId))
      (let held (list TypeId))
      (+= children pointer-layout)
      (+= held no-type)
      (+= children managed-layout)
      (+= held no-type)
      (for (in kept (. facts outlet-cells))
        (if (and (== (. kept instance) (. row instance)) (== (. kept outlet) (. row line)))
          (+= children managed-layout)
          (+= held cell)
        )
      )
      (= ([] slot-forward-layouts index) (call (. layouts environment) children held (str "slot-forward." number)))
    )
  )
  (fn-do _ declare-style-authors _
    ; A function for each row of `style-authors` but those an edit retired (`is-retired`), which
    ; evaluates the value of the declaration again in the live action it runs in and declares it for
    ; the object it is given, in the module of the style rule, named for the property it declares,
    ; with what the action that runs it keeps laid out. It may panic, as noting a read may. The rows
    ; are declared in the order of the stable keys of their instances, and of their lines.
    (let rows (list U32))
    (for (in index (..< 0 (. facts style-authors length)))
      (if (not (call is-retired (. ([] (. facts style-authors) index) instance)))
        (+= rows (as index U32))
      )
      (+= author-functions no-function)
      (+= author-layouts no-layout)
    )
    (let authors (. facts style-authors))
    (let ordered-rows (call sort rows (:using (=> (a b) (call line-order (. ([] authors a) instance) (. ([] authors a) site) (. ([] authors b) instance) (. ([] authors b) site))))))
    (for (in number (..< 0 (. ordered-rows length)))
      (let index ([] ordered-rows number))
      (let author ([] authors index))
      (let unit ([] (. instances rows) (. author instance)))
      (let id FunctionId (as (. functions length) FunctionId))
      (call (. functions append) (call unnamed-function .style-author no-instance (. unit module) 8))
      (= (. ([] functions id) type) (. unit self-type))
      (= (. ([] functions id) place) index)
      (= (. ([] functions id) number) (as number U32))
      (= (. ([] functions id) may-panic) true)
      (= ([] author-functions index) id)
      (call declare-live-adapter id)
      (let children (list LayoutId))
      (let held (list TypeId))
      (+= children managed-layout)
      (+= held (. unit self-type))
      (+= children i64-layout)
      (+= held (call (. types type-row) .int64))
      (+= children u32-layout)
      (+= held (call (. types type-row) .uint32))
      (+= children u32-layout)
      (+= held (call (. types type-row) .uint32))
      (= ([] author-layouts index) (call (. layouts environment) children held (str "style-author." number)))
    )
  )
  (fn-do _ declare-given-authors _
    ; A function for each line of a style rule that declares a style, or sets a property of the class,
    ; with a value reading a value the rule takes, where an application with `live-values` applies it,
    ; but one an edit retired (`is-retired`): it evaluates the values again where they are written,
    ; and the line's value, in the live action it runs in, and declares it for the object it is
    ; given, as an author's does (`declare-style-authors`), or stores it in the property. What the action keeps is laid out as an author's, then the receiver
    ; where the values the site applies are written. None where that has no receiver. The
    ; applications are taken in the order `application-order` gives them.
    (let rows (list U32))
    (for (in index (..< 0 (. facts style-applications length)))
      (let application ([] (. facts style-applications) index))
      (if (and (. application live-values) (not (call is-retired (. application instance))) (not (call is-retired (. application unit))))
        (+= rows (as index U32))
      )
    )
    (let ordered-rows (call sort rows (:using (=> (a b) (call application-order a b)))))
    (for (in index ordered-rows)
      (let application ([] (. facts style-applications) index))
      (let receiver (call given-receiver index))
      (if (== receiver no-type)
        (continue)
      )
      (let unit ([] (. instances rows) (. application unit)))
      (let sites (list SyntaxId))
      (for (in row (. facts style-declarations))
        (if (and (== (. row instance) (. application unit)) (. row reads-given))
          (+= sites (. row site))
        )
      )
      (for (in row (. facts rule-updates))
        (if (and (== (. row instance) (. application unit)) (. row reads-given))
          (+= sites (. row site))
        )
      )
      (for (in site sites)
        (let place (as (. given-functions length) U32))
        (let id FunctionId (as (. functions length) FunctionId))
        (call (. functions append) (call unnamed-function .style-given-author no-instance (. unit module) 8))
        (= (. ([] functions id) type) (. unit self-type))
        (= (. ([] functions id) place) place)
        (= (. ([] functions id) number) place)
        (= (. ([] functions id) may-panic) true)
        (+= given-applications index)
        (+= given-sites site)
        (+= given-functions id)
        (call declare-live-adapter id)
        (let children (list LayoutId))
        (let held (list TypeId))
        (+= children managed-layout)
        (+= held (. unit self-type))
        (+= children i64-layout)
        (+= held (call (. types type-row) .int64))
        (+= children u32-layout)
        (+= held (call (. types type-row) .uint32))
        (+= children u32-layout)
        (+= held (call (. types type-row) .uint32))
        (+= children managed-layout)
        (+= held receiver)
        (for (in item (call given-row-items index))
          (+= children managed-layout)
          (+= held (. item held))
        )
        (+= given-layouts (call (. layouts environment) children held (str "style-given." place)))
      )
    )
  )
  (fn-do _ declare-shared-rules _
    ; A function for each rule an element applies `shared`, once for each class of object and rule
    ; and the rules it comes to apply there, which the style sheets the element sees may choose,
    ; which declares what the rule declares for the object it is given, in the module of the rule,
    ; named as the reference's `style-rule` functions are. Each such application by an instance the
    ; program carries (`keep-reached-styles`) calls it (`rule-function-of`). The applications are
    ; taken in the order `application-order` gives them.
    (let shared (list U32))
    (for (in index (..< 0 (. facts style-applications length)))
      (let application ([] (. facts style-applications) index))
      (if (and (. application shared) (== (. application outer) (. U32 max)) (!= ([] carried (. application instance)) 0))
        (+= shared (as index U32))
      )
    )
    (let ordered-rows (call sort shared (:using (=> (a b) (call application-order a b)))))
    (let number 0u32)
    (for (in index ordered-rows)
      (let application ([] (. facts style-applications) index))
      (let id no-function)
      (let position (?? ([] rule-unit-heads (. application unit)) (. U32 max)))
      (while (!= position (. U32 max))
        (let earlier ([] (. facts style-applications) ([] rule-applications position)))
        (if (and (== (. earlier made) (. application made)) alike rules-match)
          (= id ([] rule-functions position))
          (break)
        )
        (lazy alike (and (== (. earlier layer) (. application layer)) (== (. earlier action) (. application action))))
        (lazy rules-match (call same-rules ([] rule-applications position) index))
        (= position ([] rule-unit-links position))
      )
      (if (== id no-function)
        (= id (as (. functions length) FunctionId))
        (call (. functions append)
          (block
            (arg (call unnamed-function .style-rule no-instance (. ([] (. instances rows) (. application unit)) module) 8))
          )
        )
        (= (. ([] functions id) type) (. application made))
        (= (. ([] functions id) place) index)
        (= (. ([] functions id) number) number)
        (= (. ([] functions id) may-panic) true)
        (+= number 1)
      )
      (+= rule-unit-links (?? ([] rule-unit-heads (. application unit)) (. U32 max)))
      (= ([] rule-unit-heads (. application unit)) (as (. rule-applications length) U32))
      (= ([] rule-function-rows index) id)
      (+= rule-applications index)
      (+= rule-functions id)
    )
  )
  (fn-expr _ application-order Comparison
    (param row U32)
    (param other U32)
    ; Orders two applications of style rules by the stable key of the instance that applies each and
    ; the site, then by layer and order, and by the stable keys of the instance that types the rule
    ; and of the class it is applied to.
    (case? (!= placed (. Comparison equal))
      placed
    )
    (case? (!= (. application layer) (. against layer))
      (call ordered (. application layer) (. against layer))
    )
    (case? (!= (. application order) (. against order))
      (call ordered (. application order) (. against order))
    )
    (case? (!= (. application unit) (. against unit))
      (call ordered (call instance-key (. application unit)) (call instance-key (. against unit)))
    )
    (default
      (call ordered (call (. types key-of) (. application made)) (call (. types key-of) (. against made)))
    )
    (where
      (lazy application ([] (. facts style-applications) row))
      (lazy against ([] (. facts style-applications) other))
      (lazy placed (call line-order (. application instance) (. application site) (. against instance) (. against site)))
    )
  )
  (fn-do _ same-rules Bool
    (param first U32)
    (param second U32)
    ; Whether two applications of a style rule come to apply the same rules, in the same places,
    ; taking the same slots of style sheets.
    (let count (as (. facts style-applications length) U32))
    (let offset 1u32)
    (let same (and (call same-slots first second) (call same-family first second)))
    (while same
      (let left (+ first offset))
      (let right (+ second offset))
      (let ends (or (>= left count) (== (. ([] (. facts style-applications) left) outer) (. U32 max))))
      (let other (or (>= right count) (== (. ([] (. facts style-applications) right) outer) (. U32 max))))
      (if (or ends other)
        (return (and ends other))
      )
      (let one ([] (. facts style-applications) left))
      (let two ([] (. facts style-applications) right))
      (= same (and (== (. one unit) (. two unit)) (== (- (. one outer) first) (- (. two outer) second)) (== (. one within) (. two within)) (== (. one written) (. two written)) (== (. one layer) (. two layer)) (== (. one action) (. two action)) (call same-slots left right) (call same-family left right)))
      (+= offset 1)
    )
    (return false)
  )
  (fn-expr _ same-family Bool
    (param first U32)
    (param second U32)
    (and (== (. one family) (. two family)) (== (. one members) (. two members)))
    (where
      (lazy one ([] (. facts style-applications) first))
      (lazy two ([] (. facts style-applications) second))
    )
  )
  (fn-do _ same-slots Bool
    (param first U32)
    (param second U32)
    ; Whether two applications of a style rule take the same slots of style sheets, alone or in the
    ; values their lines compute with them.
    (let left (list U32))
    (let right (list U32))
    (for (in place (..< 0 (. facts rule-slots length)))
      (let slot ([] (. facts rule-slots) place))
      (if (== (. slot application) first)
        (+= left (as place U32))
        (else-if (== (. slot application) second)
          (+= right (as place U32))
        )
      )
    )
    (if (!= (. left length) (. right length))
      (return false)
    )
    (for (in position (..< 0 (. left length)))
      (let one ([] (. facts rule-slots) ([] left position)))
      (let two ([] (. facts rule-slots) ([] right position)))
      (if (or (!= (. one site) (. two site)) (!= (. one sheet) (. two sheet)) (!= (. one slot) (. two slot)) other-projection)
        (return false)
      )
      (lazy other-projection (!= (. one projection) (. two projection)))
    )
    (let themed-left (list U32))
    (let themed-right (list U32))
    (for (in place (..< 0 (. facts rule-themes length)))
      (let theme ([] (. facts rule-themes) place))
      (if (== (. theme application) first)
        (+= themed-left (as place U32))
        (else-if (== (. theme application) second)
          (+= themed-right (as place U32))
        )
      )
    )
    (if (!= (. themed-left length) (. themed-right length))
      (return false)
    )
    (for (in position (..< 0 (. themed-left length)))
      (let one ([] (. facts rule-themes) ([] themed-left position)))
      (let two ([] (. facts rule-themes) ([] themed-right position)))
      (if (or (!= (. one site) (. two site)) (!= (. one themed) (. two themed)))
        (return false)
      )
    )
    (return true)
  )
  (fn-do _ declare-static-values _
    ; A function for each row of `style-static-values`, which evaluates the value once for the
    ; style runtime and gives its bits, in the module that writes it, named as the reference's
    ; `style-static-value` functions are numbered and declared in source order.
    (let rows (list U32))
    (for (in index (..< 0 (. facts style-static-values length)))
      (+= rows (as index U32))
      (+= static-value-functions no-function)
    )
    (let values (. facts style-static-values))
    (let ordered-rows (call sort rows (:using (=> (a b) (call place-order (. ([] values a) module) (. ([] values a) site) (. ([] values b) module) (. ([] values b) site))))))
    (for (in number (..< 0 (. ordered-rows length)))
      (let index ([] ordered-rows number))
      (let row ([] values index))
      (let id FunctionId (as (. functions length) FunctionId))
      (call (. functions append) (call unnamed-function .style-static-value no-instance (. row module) 8))
      (= (. ([] functions id) type) (. row type))
      (= (. ([] functions id) place) index)
      (= (. ([] functions id) number) (as number U32))
      (= (. ([] functions id) may-panic) (. ([] (. instances rows) (. row instance)) may-panic))
      (= ([] static-value-functions index) id)
    )
  )
  (fn-do _ declare-themed-values _
    ; A function for each row of `style-themed-values` some instance the program carries uses
    ; (`used-themed-values`), which evaluates the value from the slots of the style sheet it reads.
    (let used (call used-themed-values))
    (let rows (list U32))
    (for (in index (..< 0 (. facts style-themed-values length)))
      (if ([] used index)
        (+= rows (as index U32))
      )
      (+= themed-value-functions no-function)
    )
    (let values (. facts style-themed-values))
    (let ordered-rows (call sort rows (:using (=> (a b) (call themed-order ([] values a) ([] values b))))))
    (for (in number (..< 0 (. ordered-rows length)))
      (let index ([] ordered-rows number))
      (let row ([] values index))
      (let id FunctionId (as (. functions length) FunctionId))
      (call (. functions append) (call unnamed-function .style-themed-value no-instance (. row module) 8))
      (= (. ([] functions id) type) (. row type))
      (= (. ([] functions id) place) index)
      (= (. ([] functions id) number) (as number U32))
      (= (. ([] functions id) may-panic) (. ([] (. instances rows) (. row instance)) may-panic))
      (= ([] themed-value-functions index) id)
    )
  )
  (fn-do _ used-themed-values (list Bool)
    ; Which rows of `style-themed-values` a declaration of an instance the program carries
    ; (`keep-reached-styles`) evaluates, or a line of a rule such an instance applies.
    (let used (list Bool))
    (for (in _ (..< 0 (. facts style-themed-values length)))
      (+= used false)
    )
    (for (in row (. facts style-declarations))
      (if (and (!= (. row themed) (. U32 max)) (!= ([] carried (. row instance)) 0))
        (= ([] used (. row themed)) true)
      )
    )
    (for (in theme (. facts rule-themes))
      (if (!= ([] carried (. ([] (. facts style-applications) (. theme application)) instance)) 0)
        (= ([] used (. theme themed)) true)
      )
    )
    (return used)
  )
  (fn-do _ themed-order Comparison
    (param value StyleThemedValue)
    (param other StyleThemedValue)
    (let placed (call place-order (. value module) (. value site) (. other module) (. other site)))
    (return-if placed (if (!= placed (. Comparison equal))))
    (blank)
    (if (!= (. value sheet) (. other sheet))
      (return
        (call ordered
          (block
            (arg (call (. types key-of) (. ([] (. facts style-sheet-uses) (. value sheet)) type)))
            (arg (call (. types key-of) (. ([] (. facts style-sheet-uses) (. other sheet)) type)))
          )
        )
      )
    )
    (if (!= (. value given-count) (. other given-count))
      (return (call ordered (. value given-count) (. other given-count)))
    )
    (for (in offset (..< 0 (. value given-count)))
      (let given ([] (. facts themed-givens) (+ (. value given) offset)))
      (let against ([] (. facts themed-givens) (+ (. other given) offset)))
      (if (!= (. given slot) (. against slot))
        (return (call ordered (. given slot) (. against slot)))
      )
      (if (!= (. given param) (. against param))
        (return (call ordered (. given param) (. against param)))
      )
    )
    (return (. Comparison equal))
  )
  (fn-do _ declare-style-registrations _
    ; The functions that register the styles the program uses, as the reference makes them: one
    ; for each style, in the order the styles are numbered, made in the style's module and named
    ; `style-register-impl`, numbered from the second. Its code is placed at the declaration of the
    ; constructor that first used the style, which a stack trace names the file of. The init of
    ; the style's module calls it. So for each style sheet registered, named
    ; `style-sheet-register-impl` and placed at the declaration that first took the value of one of
    ; its slots.
    (for (in index (..< 0 (. style-uses length)))
      (let use ([] style-uses index))
      (if (not (. use registered))
        (continue)
      )
      (let module (. (call class-ref types (. use type)) module))
      (let id FunctionId (as (. functions length) FunctionId))
      (call (. functions append) (call unnamed-function .style-registration no-instance module 4))
      (= (. ([] functions id) place) (as index U32))
      (= (. ([] functions id) may-panic) true)
      (if (!= (. use module) module)
        (= (. ([] functions id) site-module) (. use module))
      )
      (call place-file (. use module))
      (+= style-functions id)
    )
    (for (in index (..< 0 (. style-sheet-uses length)))
      (let use ([] style-sheet-uses index))
      (if (not (. use registered))
        (continue)
      )
      (let module (. (call class-ref types (. use type)) module))
      (let id FunctionId (as (. functions length) FunctionId))
      (call (. functions append) (call unnamed-function .style-sheet-registration no-instance module 4))
      (= (. ([] functions id) place) (as index U32))
      (= (. ([] functions id) may-panic) true)
      (if (!= (. use module) module)
        (= (. ([] functions id) site-module) (. use module))
      )
      (call place-file (. use module))
      (+= sheet-functions id)
    )
    (for (in index (. facts domain-order))
      (call place-file (. ([] (. facts domain-places) index) module))
    )
  )
  (fn-do _ number-domains _
    ; Numbers each domain of invalidation by its place in the order the style module's init registers
    ; those some instance names in (`Facts.domain-order`).
    (for (in _ (..< 0 (. facts style-domains length)))
      (+= domain-numbers (. U32 max))
    )
    (for (in position (..< 0 (. facts domain-order length)))
      (= ([] domain-numbers ([] (. facts domain-order) position)) (as position U32))
    )
  )
  (fn-do _ number-keys _
    ; Numbers the places state cells are made at and the targets of descendant queries, which the
    ; runtimes know them by, in orders that do not depend on the order typing found them in
    ; (`state-key-number`, `target-number`). Only the places of the cells of instances no edit
    ; retired are numbered: an edit that changes a body leaves behind the places it made cells at
    ; there.
    (let live (list Bool))
    (for (in _ (..< 0 (. instances state-keys length)))
      (+= live false)
    )
    (for (in row (. facts scope-cells))
      (if (and (not (call is-retired (. row instance))) (< (as (. row key) Size) (. live length)))
        (= ([] live (. row key)) true)
      )
    )
    (let keys (list U32))
    (for (in index (..< 0 (. instances state-keys length)))
      (+= state-key-numbers 0)
      (if ([] live index)
        (+= keys (as index U32))
      )
    )
    (let ordered-keys (call sort keys (:using (=> (a b) (call state-key-order a b)))))
    (for (in position (..< 0 (. ordered-keys length)))
      (= ([] state-key-numbers ([] ordered-keys position)) (as position U32))
    )
    (let targets (list U32))
    (for (in index (..< 0 (. facts query-targets length)))
      (+= targets (as index U32))
      (+= target-numbers 0)
    )
    (let query-targets (. facts query-targets))
    (let ordered-targets
      (call sort
        (block
          (arg targets)
          (:using (=> (a b) (call ordered (call (. types key-of) ([] query-targets a)) (call (. types key-of) ([] query-targets b)))))
        )
      )
    )
    (for (in position (..< 0 (. ordered-targets length)))
      (= ([] target-numbers ([] ordered-targets position)) (as (+ position 1) U32))
    )
  )
  (fn-expr _ state-key-order Comparison
    (param key U32)
    (param other U32)
    ; Orders two places state cells are made by the site and then by the `when`, each in source
    ; order.
    (case? (!= placed (. Comparison equal))
      placed
    )
    (default
      (call place-order (. made when-module) (. made when) (. given when-module) (. given when))
    )
    (where
      (lazy made ([] (. instances state-keys) key))
      (lazy given ([] (. instances state-keys) other))
      (lazy placed (call place-order (. made module) (. made site) (. given module) (. given site)))
    )
  )
  (fn-do _ place-file _
    (param placed ModuleId)
    ; Says an init registers at a place in a module, whose file a stack trace names for the call.
    (if (== ([] (. module-paths data) placed) no-string)
      (= ([] (. module-paths data) placed) (call (. bundle intern) (. ([] (. program modules) placed) relative-path)))
    )
  )
  (fn-do _ registers-styles Bool
    (param module ModuleId)
    ; Whether the init of a module registers styles or domains of invalidation.
    (if (and (== module (call style-module)) (!= (. facts domain-order length) 0))
      (return true)
    )
    (for (in use style-uses)
      (if (and (. use registered) (== (. (call class-ref types (. use type)) module) module))
        (return true)
      )
    )
    (for (in use style-sheet-uses)
      (if (and (. use registered) (== (. (call class-ref types (. use type)) module) module))
        (return true)
      )
    )
    (return false)
  )
  (fn-do _ add-registration _
    (param found (list FunctionId))
    (param keys (list U64))
    (param id FunctionId)
    (param module ModuleId)
    (param site SyntaxId)
    (param type TypeId)
    ; Adds a function that registers a style or a sheet to those `found`, kept in the order of the
    ; places they are registered at, and then of the declarations of what they register, each
    ; given by two of `keys`.
    (let ref (call class-ref types type))
    (let place (/or/ (/lshift/ (as module U64) 32) (as site U64)))
    (let declared (/or/ (/lshift/ (as (. ref module) U64) 32) (as (. ref decl) U64)))
    (let index (. found length))
    (+= found id)
    (+= keys place)
    (+= keys declared)
    (while (and (> index 0) (or (> ([] keys (- (* index 2) 2)) place) (and (== ([] keys (- (* index 2) 2)) place) (> ([] keys (- (* index 2) 1)) declared))))
      (= ([] found index) ([] found (- index 1)))
      (= ([] keys (* index 2)) ([] keys (- (* index 2) 2)))
      (= ([] keys (+ (* index 2) 1)) ([] keys (- (* index 2) 1)))
      (-= index 1)
    )
    (= ([] found index) id)
    (= ([] keys (* index 2)) place)
    (= ([] keys (+ (* index 2) 1)) declared)
  )
  (fn-do _ declare-event-handlers _
    ; The functions for the sections that classes the program constructs run from their tables, as
    ; the reference makes them: one for each section, whichever classes run it, named for the class
    ; that writes it and the event and numbered from the second so named; one for each class, which
    ; says whether an object is of it; and one for each module of such a class, which puts them in
    ; the event runtime's tables as the module starts. A section on an event that is not live has
    ; none. They are taken by the rank of the first constructor of each class, and a class's in the
    ; order they were planned, base first, so the order is the same however the classes were typed
    ; (`lowered-order`).
    (let keys (list U64))
    (for (in index (..< 0 (. facts lowered-handlers length)))
      (+= lowered-functions no-function)
      (+= lowered-matchers no-function)
      (let rank (as (call constructor-rank (. ([] (. facts lowered-handlers) index) type)) U64))
      (+= keys (/or/ (/lshift/ rank 32) (as index U64)))
    )
    (for (in key (call sorted-pairs keys))
      (let index (as (/and/ key 0xffffffff) Size))
      (+= lowered-order (as index U32))
      (let row ([] (. facts lowered-handlers) index))
      (if (or (== ([] constructed (. row type)) 0) (== (call event-number (. row owner) (. row name)) (. U32 max)))
        (continue)
      )
      (let unit (call (. instances find-initializer) (. row module) (. row decl) (. row level)))
      (let handler no-function)
      (for (in place (..< 0 (. event-handlers length)))
        (if (and (== (. ([] event-handlers place) unit) unit) (== (. ([] event-handlers place) syntax) (. row syntax)))
          (= handler ([] handler-functions place))
        )
      )
      (if (== handler no-function)
        (let used (only-if (call event-use-of unit (. row syntax)) (if (!= unit no-instance))))
        (let callback (if-expr used (. used callback) no-instance))
        (let shown (call type-short-name types (. row level)))
        (let number U32 1)
        (for (in other event-handlers)
          (if (and (== (. other name) (. row name)) (== (call type-short-name types (. other level)) shown))
            (+= number 1)
          )
        )
        (= handler (as (. functions length) FunctionId))
        (let weight (if-expr (!= callback no-instance) (+ (. ([] (. instances rows) callback) subtree count) 1) 1))
        (call (. functions append) (call unnamed-function .event-handler callback (. row module) weight))
        (= (. ([] functions handler) place) (as (. event-handlers length) U32))
        (= (. ([] functions handler) may-panic) true)
        (call (. event-handlers append) (call EventHandler unit (. row syntax) callback (. row level) (. row name) number))
        (+= handler-functions handler)
      )
      (= ([] lowered-functions index) handler)
      (= ([] lowered-matchers index) (call class-matcher (. row type)))
      (call register-module (. row type))
    )
  )
  (fn-expr _ constructor-rank U32
    (param type TypeId)
    ; Where the first constructor of a class the program emits stands among the instances by rank,
    ; or after them all where it emits none.
    (if-expr (!= making no-instance) (call (. instances rank-of) making) (as (. instances ordered length) U32))
    (where
      (lazy making (call first-constructor type))
    )
  )
  (fn-do _ class-matcher FunctionId
    (param type TypeId)
    ; The function that says whether an object is of a class whose table the event runtime runs
    ; functions from, made once for the class.
    (for (in place (..< 0 (. matcher-types length)))
      (if (== ([] matcher-types place) type)
        (return ([] matcher-functions place))
      )
    )
    (let matcher (. functions length))
    (call (. functions append) (call unnamed-function .event-matcher no-instance (. (call class-ref types type) module) 4))
    (= (. ([] functions matcher) type) type)
    (= (. ([] functions matcher) may-panic) true)
    (+= matcher-types type)
    (+= matcher-functions (as matcher FunctionId))
    (return (as matcher FunctionId))
  )
  (fn-do _ register-module _
    (param type TypeId)
    ; Notes that the init of the module of a class puts functions of the class's table in the event
    ; runtime's tables, and makes the function that does it once for the module. The class's first
    ; constructor is the last so noted for the module.
    (let module (. (call class-ref types type) module))
    (let making (call first-constructor type))
    (let known false)
    (for (in place (..< 0 (. registered-modules length)))
      (if (== ([] registered-modules place) module)
        (= ([] registered-constructors place) making)
        (= known true)
      )
    )
    (if (not known)
      (+= registered-modules module)
      (+= registered-constructors making)
    )
    (for (in registering registration-functions)
      (if (== (. ([] functions registering) module) module)
        (return)
      )
    )
    (let id FunctionId (as (. functions length) FunctionId))
    (+= registration-functions id)
    (call (. functions append) (call unnamed-function .event-registrations no-instance module 4))
    (= (. ([] functions id) may-panic) (. ([] (. instances rows) (. facts event-register)) may-panic))
  )
  (fn-do _ declare-machine-descriptors _
    ; Declares, for each group of a state machine's event transitions that the event runtime runs
    ; from the table of a class the program constructs, as the reference makes them: the function
    ; the table runs, given the object and what was published, which gives the group's activation
    ; to the event runtime's queue where the object holds one; and the functions that say whether
    ; an object is of the class and that put them in the event runtime's tables as the module of the
    ; class starts. A group on an event that is not live has none.
    ; Machines are taken by the rank of the instance each is written in, so the order is the same
    ; however they were typed.
    (let keys (list U64))
    (for (in index (..< 0 (. facts machines length)))
      (let rank (call (. instances rank-of) (. ([] (. facts machines) index) instance)))
      (let placed (if-expr (!= rank (. U32 max)) rank (as (. instances ordered length) U32)))
      (+= keys (/or/ (/lshift/ (as placed U64) 32) (as index U64)))
    )
    (for (in key (call sorted-pairs keys))
      (let machine ([] (. facts machines) (as (/and/ key 0xffffffff) Size)))
      (let stored (or (== (. machine store) .store-member) (== (. machine store) .store-content)))
      (if (or (== ([] instance-functions (. machine instance)) no-function) (not stored))
        (continue)
      )
      (let classes (call machine-classes machine))
      (let module (. ([] (. instances rows) (. machine instance)) module))
      (for (in group (..< (. machine groups start) (+ (. machine groups start) (. machine groups count))))
        (let row ([] (. facts machine-groups) group))
        (if (or (not (. row lowered)) (== (. row event) (. U32 max)))
          (continue)
        )
        (let used ([] (. facts event-uses) (. row event)))
        (if (== (call event-number (. used owner) (. used name)) (. U32 max))
          (continue)
        )
        (for (in type classes)
          (let descriptor FunctionId (as (. functions length) FunctionId))
          (call (. functions append) (call unnamed-function .machine-descriptor (. machine instance) module 1))
          (= (. ([] functions descriptor) place) group)
          (= (. ([] functions descriptor) type) type)
          (= (. ([] functions descriptor) may-panic) true)
          (+= machine-descriptors (call MachineDescriptor group type descriptor (call class-matcher type)))
          (call register-module type)
        )
      )
    )
  )
  (fn-do _ first-constructor InstanceId
    (param type TypeId)
    ; The first constructor of a class that the program emits, by rank. Those of every class are
    ; found together the first time one is asked for.
    (if (not constructors-found)
      (= constructors-found true)
      (for (in instance (. instances ordered))
        (if (== ([] instance-functions instance) no-function)
          (continue)
        )
        (let row ([] (. instances rows) instance))
        (match? ([] (. ([] (. program modules) (. row module)) decls) (. row decl))
          (case (call .decl-function fn)
            (if (and (call constructs (. fn kind)) (== ([] first-constructors (. row self-type)) null))
              (= ([] first-constructors (. row self-type)) instance)
            )
          )
        )
      )
    )
    (let found ([] first-constructors type))
    (return (if-expr found (as found InstanceId) no-instance))
  )
  (fn-do _ declare-idle-action _
    ; The function the live action that owns a subscription or the endpoint at the address of a
    ; keyed event calls, which does nothing, made once for a program where an object owns one. It
    ; is placed at the subscription, or where there is none the claim, of the instance first by
    ; rank, and the first of its places, so the place is the same however the instances were typed.
    (let owned (!= (. facts owned-subscriptions length) 0))
    (if (and (not owned) (== (. facts address-claims length) 0))
      (return)
    )
    (let best (. U64 max))
    (if owned
      (for (in row (. facts owned-subscriptions))
        (let key (/or/ (/lshift/ (as (call (. instances rank-of) (. row instance)) U64) 32) (as (. row site) U64)))
        (if (< key best)
          (= best key)
          (= idle-instance (. row instance))
          (= idle-site (. row site))
        )
      )
      (else
        (for (in row (. facts address-claims))
          (let key (/or/ (/lshift/ (as (call (. instances rank-of) (. row instance)) U64) 32) (as (. row site) U64)))
          (if (< key best)
            (= best key)
            (= idle-instance (. row instance))
            (= idle-site (. row site))
          )
        )
      )
    )
    (= idle-action (as (. functions length) FunctionId))
    (call (. functions append)
      (block
        (arg (call unnamed-function .idle-action no-instance (. ([] (. instances rows) idle-instance) module) 4))
      )
    )
  )
  (fn-do _ class-rule U32
    (param level TypeId)
    (param module ModuleId)
    (param decl DeclId)
    (param syntax SyntaxId)
    ; The row of a rule typed for a class, made once.
    (let unit (call (. instances find-initializer) module decl level))
    (if (!= unit no-instance)
      (let found ([] class-rule-rows unit))
      (if found
        (return found)
      )
    )
    (let index U32 (as (. class-rules length) U32))
    (let updater no-function)
    (let reruns (== (call rule-pass module syntax) 2))
    (let iterator SyntaxId 0)
    (match? ([] (. ([] (. program modules) module) tree nodes) syntax)
      (case (call .node-subscriber-syntax section)
        (= iterator (. section iterator))
      )
    )
    (let rebinds (and (!= unit no-instance) (!= iterator 0) (call (. facts rebinds-section) level module iterator)))
    (if (and (!= unit no-instance) (or reruns rebinds))
      (= updater (as (. functions length) FunctionId))
      (call (. functions append) (call unnamed-function .class-rule-updater no-instance module 8))
      (= (. ([] functions updater) type) level)
      (= (. ([] functions updater) place) index)
      (= (. ([] functions updater) may-panic) true)
      (call declare-live-adapter updater)
    )
    (let trigger (only-if (call (. facts markup-trigger-of) unit) (if (!= unit no-instance))))
    (let add no-function)
    (let remove no-function)
    (if trigger
      (= add (call trigger-function (if-expr (== (. trigger target-id) 0) .markup-trigger-ancestor (. FunctionKind markup-trigger-add)) level module index))
      (if (!= (. trigger target-id) 0)
        (= remove (call trigger-function .markup-trigger-remove level module index))
      )
    )
    (if (!= unit no-instance)
      (= ([] class-rule-rows unit) index)
    )
    (let kept
      (block
        (case? rebinds
          (call section-kept level unit iterator)
        )
        (default
          (call class-rule-kept level module syntax unit)
        )
      )
    )
    (call (. class-rules append) (call ClassRule level module decl syntax unit kept updater add remove))
    (return index)
  )
  (fn-do _ section-kept LayoutId
    (param level TypeId)
    (param unit InstanceId)
    (param iterator SyntaxId)
    ; What a section subscribed again as a branch of the markup makes an element again keeps for
    ; each object it runs on: the object, then the closure its loop subscribes, made once, as the
    ; conversion recorded where it is made a `Subscriber` gives it.
    (let closure no-type)
    (let scan (call (. facts first-conversion) unit iterator))
    (while (and (!= scan no-fact) (== closure no-type))
      (let row ([] (. facts conversions) scan))
      (if (and (== (. row reason) .reason-argument) typed (== (call (. types intrinsic-of) (. row from)) .closure))
        (= closure (. row from))
      )
      (lazy typed (and (!= (. row from) no-type) (!= (. row from) invalid-type)))
      (= scan (. row next))
    )
    (if (== closure no-type)
      (return no-layout)
    )
    (let children (list LayoutId))
    (let held (list TypeId))
    (+= children managed-layout)
    (+= held level)
    (+= children managed-layout)
    (+= held closure)
    (return (call (. layouts environment) children held (str "section." (call hex-text ([] (. instances stable-keys) unit)))))
  )
  (fn-do _ trigger-function FunctionId
    (param kind FunctionKind)
    (param level TypeId)
    (param module ModuleId)
    (param index U32)
    ; A function the markup runtime calls for a `whenever` rule on the markup an object is in,
    ; given what the rule keeps for the object, which may panic, as running the rule's action may.
    (let id FunctionId (as (. functions length) FunctionId))
    (call (. functions append) (call unnamed-function kind no-instance module 8))
    (= (. ([] functions id) type) level)
    (= (. ([] functions id) place) index)
    (= (. ([] functions id) may-panic) true)
    (return id)
  )
  (fn-do _ class-rule-kept LayoutId
    (param level TypeId)
    (param module ModuleId)
    (param syntax SyntaxId)
    (param unit InstanceId)
    ; What a rule keeps for each object it runs on: the object, then for a `whenever` rule the
    ; value it had when it last ran. A `whenever` rule on the
    ; markup an object is in keeps whether it has changed since its action last ran, the action,
    ; the object as its markup host, then the changes it names, if any, and for an ancestor the
    ; one it last found. A value with no layout yet keeps nothing, and neither does a dependency
    ; or a section.
    (if (or (== unit no-instance) (!= (call rule-pass module syntax) 2))
      (return no-layout)
    )
    (let children (list LayoutId))
    (let held (list TypeId))
    (+= children managed-layout)
    (+= held level)
    (let trigger (call (. facts markup-trigger-of) unit))
    (if trigger
      (let found trigger)
      (let previous (. found found))
      (+= children u8-layout)
      (+= held no-type)
      (+= children managed-layout)
      (+= held (. types live-action-type))
      (+= children ([] (. layouts values) (. found host)))
      (+= held (. found host))
      (if (!= (. found changes) no-type)
        (+= children managed-layout)
        (+= held (. found changes))
      )
      (if (!= previous no-type)
        (+= children ([] (. layouts values) previous))
        (+= held previous)
      )
      (if (!= (call (. children find) no-layout) null)
        (return no-layout)
      )
      (return (call (. layouts environment) children held (str "rule." (call hex-text ([] (. instances stable-keys) unit)))))
    )
    (match? ([] (. ([] (. program modules) module) tree nodes) syntax)
      (case (call .node-whenever-rule-syntax rule)
        (let value (call (. facts node-type) unit (. rule expr)))
        (if (or (== value no-type) (== value invalid-type) (== ([] (. layouts values) value) no-layout))
          (return no-layout)
        )
        (+= children ([] (. layouts values) value))
        (+= held value)
      )
    )
    (return (call (. layouts environment) children held (str "rule." (call hex-text ([] (. instances stable-keys) unit)))))
  )
  (fn-do _ rules-from (list U32)
    (param head (? U32))
    ; The rows of `class-rules` listed in `class-rule-order` from a place up to `U32.max`.
    (let order (list U32))
    (if (not head)
      (return order)
    )
    (let cursor head)
    (while (!= ([] class-rule-order cursor) (. U32 max))
      (+= order ([] class-rule-order cursor))
      (+= cursor 1)
    )
    (return order)
  )
  (fn-do _ declare-globals _
    ; Gives every global of every module its kind, and storage to each the type pass typed: a symbol for
    ; its value, a byte of state beside one that is not a constant, and a root record when it holds
    ; managed pointers. Which are constants is a fact of the type pass, which checks no read of one; a
    ; value no instance typed is a constant when it is a literal. Notes for each module whether it
    ; stores constants, whether values of its globals run as it starts, and whether those may panic. A
    ; value no instance typed is one nothing reads: it is evaluated for what it does when its module
    ; starts, and is taken to panic when it calls anything.
    (let module-count (. program modules length))
    (= storage-starts (call (of (. arena allocate) U32) (+ module-count 1)))
    (= module-flags (call (of (. arena allocate) Byte) (+ module-count 1)))
    (= module-defaults (call (of (. arena allocate) U32) (+ module-count 1)))
    (= default-tails (call (of (. arena allocate) U32) (+ module-count 1)))
    (= task-local-heads (call (of (. arena allocate) U32) (+ module-count 1)))
    (= task-local-tails (call (of (. arena allocate) U32) (+ module-count 1)))
    (let total U32)
    (for (in module (..< 0 module-count))
      (= ([] storage-starts module) total)
      (= ([] module-flags module) 0)
      (= ([] module-defaults module) no-storage)
      (= ([] default-tails module) no-storage)
      (= ([] task-local-heads module) no-storage)
      (= ([] task-local-tails module) no-storage)
      (+= total (as (. ([] (. program modules) module) decls length) U32))
    )
    (= storage-rows (call (of (. arena allocate) U32) (+ total 1)))
    (= global-kinds (call (of (. arena allocate) Byte) (+ total 1)))
    (= local-firsts (call (of (. arena allocate) U32) (+ total 1)))
    (for (in position (..< 0 total))
      (= ([] storage-rows position) no-storage)
      (= ([] global-kinds position) 0)
      (= ([] local-firsts position) (. U32 max))
    )
    (for (in position (..< 0 (. facts local-global-uses length)))
      (let use ([] (. facts local-global-uses) position))
      (let place (+ ([] storage-starts (. use module)) (. use decl)))
      (if (== ([] local-firsts place) (. U32 max))
        (= ([] local-firsts place) (as position U32))
      )
    )
    (let bound (call (of (. arena allocate) Byte) (+ total 1)))
    (for (in position (..< 0 total))
      (= ([] bound position) 0)
    )
    (for (in scope (. facts stack-scopes))
      (= ([] bound (+ ([] storage-starts (. scope module)) (. scope decl))) 1)
    )
    (= refused-effects (call banned-anywhere program instances))
    (for (in constant (. facts constant-globals))
      (let place (+ ([] storage-starts (. constant module)) (. constant decl)))
      (if (== ([] bound place) 0)
        (= ([] global-kinds place) (. GlobalKind global-constant))
      )
    )
    (for (in module (..< 0 module-count))
      (let owner ([] (. program modules) module))
      (for (in index (..< 0 (. owner decls length)))
        (match? ([] (. owner decls) index)
          (case (call .decl-property property)
            (if (and (== (. property owner) 0) (not literal))
              (call declare-global (as module ModuleId) (as index DeclId) property)
            )
            (lazy literal (call (. types is-literal-global) (as module ModuleId) (as index DeclId)))
          )
          (case .decl-effect
            (if (or (!= ([] bound (+ ([] storage-starts module) index)) 0) (call is-refused (as module ModuleId) (as index DeclId)))
              (call declare-effect-slot (as module ModuleId) (as index DeclId))
            )
          )
        )
      )
    )
    (for (in unit (. instances ordered))
      (let row ([] (. instances rows) unit))
      (if (and (!= (. row initializer) 0) (== (. row state) .instance-done))
        (match? ([] (. ([] (. program modules) (. row module)) decls) (. row initializer))
          (case (call .decl-case case)
            (call declare-enum-value (. row module) (. row initializer) unit case)
          )
        )
      )
    )
    (for (in machine (. facts machines))
      (if (== (. machine store) .store-global)
        (call declare-machine-global machine)
      )
    )
    (= task-local-order (call order-locals false))
    (= thread-local-order (call order-locals true))
    (for (in row task-local-order)
      (let module (. ([] storage row) module))
      (if (== ([] task-local-tails module) no-storage)
        (= ([] task-local-heads module) row)
        (else
          (= (. ([] storage ([] task-local-tails module)) next) row)
        )
      )
      (= ([] task-local-tails module) row)
    )
    (= task-local-size (call lay-locals task-local-rows "tasklocal" .task-local-root task-local-size))
    (= thread-local-size
      (call lay-locals
        (block
          (arg thread-local-rows)
          (arg "threadlocal")
          (arg .thread-local-root)
          (arg thread-local-size)
        )
      )
    )
  )
  (fn-do _ declare-enum-value _
    (param module ModuleId)
    (param decl DeclId)
    (param unit InstanceId)
    (param case CaseDecl)
    ; Gives storage to a value of an enum the type pass typed, which is not made until an
    ; emitted function reads it. A value typed for more than one enum, as one of a class with
    ; type parameters is, is kept in no way here.
    (let place (+ ([] storage-starts module) decl))
    (if (!= ([] global-kinds place) 0)
      (= ([] global-kinds place) (. GlobalKind global-other))
      (return)
    )
    (= ([] global-kinds place) (. GlobalKind global-other))
    (let type (. ([] (. instances signatures) unit) returns))
    (let layout no-layout)
    (if (and (!= type no-type) (!= type invalid-type))
      (= layout ([] (. layouts values) type))
    )
    (let kept (and (!= layout no-layout) (!= layout void-layout)))
    (if (and kept (. ([] (. layouts rows) layout) is-managed) (== (. ([] (. layouts rows) layout) descriptor) no-string))
      (= kept false)
    )
    (if (or (not kept) (not (. case name)))
      (return)
    )
    (let case-name (. case name))
    (= ([] global-kinds place) (. GlobalKind global-enum-unread))
    (let flags (/or/ ([] module-flags module) has-statics))
    (if (. ([] (. instances rows) unit) may-panic)
      (= flags (/or/ flags statics-panic))
    )
    (= ([] module-flags module) flags)
    (let key (str (. ([] (. program modules) module) name) ":enum:" decl ":" (. case-name text)))
    (= ([] storage-rows place) (as (. storage length) U32))
    (call keep
      (block
        (arg
          (call GlobalStorage
            (block
              (arg module)
              (arg decl)
              (arg 0)
              (arg no-instance)
              (arg (call (. bundle intern) (call symbol-name (. program target) key)))
              (arg no-string)
              (arg type)
              (arg layout)
              (arg no-function)
              (arg no-storage)
            )
          )
        )
      )
    )
  )
  (fn-do _ declare-machine-global _
    (param machine MachineFact)
    ; A machine a module's property is gives the module a global that holds its environment,
    ; where a case test anywhere in the module reads a case's flag; none until it starts. It is
    ; the storage of the machine's own declaration.
    (let decl (. ([] (. instances rows) (. machine instance)) decl))
    (let place (+ ([] storage-starts (. machine module)) decl))
    (= ([] global-kinds place) (. GlobalKind global-other))
    (= ([] storage-rows place) (as (. storage length) U32))
    (let key (str (. ([] (. program modules) (. machine module)) name) ":state-machine." (. machine syntax)))
    (call keep
      (block
        (arg
          (call GlobalStorage
            (block
              (arg (. machine module))
              (arg decl)
              (arg (. machine syntax))
              (arg no-instance)
              (arg (call (. bundle intern) (call symbol-name (. program target) key)))
              (arg no-string)
              (arg no-type)
              (arg managed-layout)
              (arg no-function)
              (arg no-storage)
            )
          )
        )
      )
    )
  )
  (fn-do _ declare-global _
    (param module ModuleId)
    (param decl DeclId)
    (param property PropertyDecl)
    (let owner ([] (. program modules) module))
    (let place (+ ([] storage-starts module) decl))
    (let fixed (== ([] global-kinds place) (. GlobalKind global-constant)))
    (if (or (and (!= (. property decoration) null) (not fixed)) (not (. property name)))
      (= ([] global-kinds place) (. GlobalKind global-other))
      (if (and (. property name) (!= (. property decoration) null))
        (let decoration (. property decoration text))
        (if (== decoration "task")
          (call declare-local module decl property .global-task)
          (else-if (== decoration "thread")
            (call declare-local module decl property .global-thread)
          )
          (else-if (== decoration "stack")
            (call declare-local module decl property .global-stack)
          )
        )
      )
      (return)
    )
    (let property-name (. property name))
    (let main ([] main-instances module))
    (let unit (call (. instances find-initializer) module decl no-type))
    (let type no-type)
    (if (and (!= unit no-instance) (== (. ([] (. instances rows) unit) state) .instance-done))
      (= type (. ([] (. instances signatures) unit) returns))
    )
    (let kind (. GlobalKind global-eager))
    (if (. property is-lazy)
      (= kind .global-lazy)
      (else-if (== ([] global-kinds place) (. GlobalKind global-constant))
        (= kind .global-constant)
      )
    )
    (= ([] global-kinds place) kind)
    (let layout no-layout)
    (if (and (!= type no-type) (!= type invalid-type))
      (= layout ([] (. layouts values) type))
    )
    (let kept (and (!= layout no-layout) (!= layout void-layout)))
    (if (and kept (. ([] (. layouts rows) layout) is-managed) (== (. ([] (. layouts rows) layout) descriptor) no-string))
      (= kept false)
    )
    (let flags ([] module-flags module))
    (if (and (== kind .global-constant) kept (!= (. property value) 0))
      (= flags (/or/ flags has-constants))
    )
    (if (and (== kind .global-eager) (or (!= (. property value) 0) kept))
      (= flags (/or/ flags has-globals))
      (let raises
        (scope (if-expr (!= unit no-instance) (or (. ([] (. instances rows) unit) may-panic) failing) calls)
          (lazy failing (!= (. ([] (. instances signatures) unit) errors count) 0))
          (lazy calls (call calls-within main (. owner tree) (. property syntax)))
        )
      )
      (if raises
        (= flags (/or/ flags globals-raise))
      )
    )
    (= ([] module-flags module) flags)
    (if (not kept)
      (return)
    )
    (let key (str (. owner name) ":" (. property-name text)))
    (let state no-string)
    (if (!= kind .global-constant)
      (= state (call (. bundle intern) (call symbol-name (. program target) (str key ".state"))))
    )
    (= ([] storage-rows place) (as (. storage length) U32))
    (call keep
      (block
        (arg
          (call GlobalStorage
            (block
              (arg module)
              (arg decl)
              (arg 0)
              (arg no-instance)
              (arg (call (. bundle intern) (call symbol-name (. program target) key)))
              (arg state)
              (arg type)
              (arg layout)
              (arg no-function)
              (arg no-storage)
            )
          )
        )
      )
    )
  )
  (fn-do _ is-refused Bool
    (param module ModuleId)
    (param decl DeclId)
    (let effect (call (. program effects index-of) module decl))
    (return (and effect (< effect (call most-effects)) (!= (/and/ refused-effects (call ban-bit effect)) 0)))
  )
  (fn-do _ declare-effect-slot _
    (param module ModuleId)
    (param decl DeclId)
    ; Gives an effect a `do with` binds a fake to a slot in the memory of every task, `{bound, fake}`,
    ; as it gives a global `do with` binds: a door the fake answers reads the fake there. It holds the
    ; fake as an object of any class, and is bound only by a `do with`.
    (let place (+ ([] storage-starts module) decl))
    (let effect (call (. program effects index-of) module decl))
    (let fake no-type)
    (for (in entry (. instances swap-entries))
      (if (and (== fake no-type) effect (== (. entry effect) effect))
        (= fake (. entry fake))
      )
    )
    (if (and (== fake no-type) (call is-refused module decl))
      (= fake (. types string-type))
    )
    (if (== fake no-type)
      (return)
    )
    (let children (list LayoutId))
    (let held (list TypeId))
    (+= children ([] (. layouts values) (. types bool-type)))
    (+= children managed-layout)
    (+= held (. types bool-type))
    (+= held fake)
    (let layout (call (. layouts environment) children held (str "effect-slot." module "." decl)))
    (let alignment (. ([] (. layouts rows) layout) alignment))
    (let offset U32 (* (/ (- (+ (as task-local-size U32) alignment) 1) alignment) alignment))
    (= task-local-size (+ offset (. ([] (. layouts rows) layout) size)))
    (= ([] storage-rows place) (as (. storage length) U32))
    (call (. storage append)
      (block
        (arg
          (call GlobalStorage
            (block
              (arg module)
              (arg decl)
              (arg 0)
              (arg no-instance)
              (arg no-string)
              (arg no-string)
              (arg fake)
              (arg layout)
              (arg no-function)
              (arg no-storage)
              (arg offset)
              (arg false)
            )
          )
        )
      )
    )
    (= ([] module-flags module) (/or/ ([] module-flags module) has-locals))
    (= ([] global-kinds place) (. GlobalKind global-stack))
    (+= task-local-rows (as (- (. storage length) 1) U32))
  )
  (fn-do _ declare-local _
    (param module ModuleId)
    (param decl DeclId)
    (param property PropertyDecl)
    (param kind GlobalKind)
    ; Gives a global each task, or each thread, holds its own of a place in the memory of every
    ; task or thread, and a function that stores its first value there: the value written, or
    ; with none the first value of its type, which for a named tuple or struct is made from its
    ; fields. One `do with` binds has a slot in the memory of every task, `{bound, value}`, and a
    ; function only where a value is written, which binds it. Only one a function uses is kept,
    ; as TypeScript makes the value of one where it first compiles a use; one the type pass
    ; typed, whose value lets no error out, and that the collector can describe where it holds
    ; managed pointers. A panic while the first value of one each thread holds is made is
    ; reported by `threadinit`, which ends the process. Its unit is kept as its `owner`.
    (let place (+ ([] storage-starts module) decl))
    (if (== ([] local-firsts place) (. U32 max))
      (return)
    )
    (let per-thread (== kind .global-thread))
    (let unit (call (. instances find-initializer) module decl no-type))
    (if (or (== unit no-instance) (!= (. ([] (. instances rows) unit) state) .instance-done) raises)
      (return)
    )
    (lazy raises (!= (. ([] (. instances signatures) unit) errors count) 0))
    (let type (. ([] (. instances signatures) unit) returns))
    (if (or (== type no-type) (== type invalid-type))
      (return)
    )
    (let layout ([] (. layouts values) type))
    (if (or (== layout no-layout) (== layout void-layout))
      (return)
    )
    (if (and (. ([] (. layouts rows) layout) is-managed) (== (. ([] (. layouts rows) layout) descriptor) no-string))
      (return)
    )
    (let function pending-function)
    (if (== kind .global-stack)
      (let children (list LayoutId))
      (let held (list TypeId))
      (+= children ([] (. layouts values) (. types bool-type)))
      (+= children layout)
      (+= held (. types bool-type))
      (+= held type)
      (= layout (call (. layouts environment) children held (str "stack-local." module "." decl)))
      (if (== (. property value) 0)
        (= function no-function)
      )
    )
    (let alignment (. ([] (. layouts rows) layout) alignment))
    (let size (if-expr per-thread thread-local-size task-local-size))
    (let offset U32 (* (/ (- (+ (as size U32) alignment) 1) alignment) alignment))
    (= size (+ offset (. ([] (. layouts rows) layout) size)))
    (= ([] storage-rows place) (as (. storage length) U32))
    (call (. storage append)
      (block
        (arg
          (call GlobalStorage
            (block
              (arg module)
              (arg decl)
              (arg 0)
              (arg unit)
              (arg no-string)
              (arg no-string)
              (arg type)
              (arg layout)
              (arg function)
              (arg no-storage)
              (arg offset)
              (arg per-thread)
            )
          )
        )
      )
    )
    (= ([] module-flags module) (/or/ ([] module-flags module) has-locals))
    (= ([] global-kinds place) kind)
    (if per-thread
      (= thread-local-size size)
      (+= thread-local-rows (as (- (. storage length) 1) U32))
      (if (. ([] (. instances rows) unit) may-panic)
        (= thread-locals-panic true)
      )
      (return)
    )
    (= task-local-size size)
    (+= task-local-rows (as (- (. storage length) 1) U32))
    (if (and (!= function no-function) (. ([] (. instances rows) unit) may-panic))
      (= ([] module-flags module) (/or/ ([] module-flags module) locals-raise))
    )
  )
  (fn-do _ order-locals (list U32)
    (param per-thread Bool)
    ; Orders the functions that give the globals each task, or each thread, holds its own of
    ; their first values: by the order their modules initialize in, and within a module in the
    ; order they are declared. Those that bind a global `do with` binds are among those of tasks.
    (let module-count (. program modules length))
    (let visited (call (of (. arena allocate) Byte) (+ module-count 1)))
    (for (in module (..< 0 module-count))
      (= ([] visited module) 0)
    )
    (let order (list U32))
    (let init-order (. program init-order))
    (for (in position (..< 0 (. init-order length)))
      (let module (as ([] init-order position) ModuleId))
      (if (== ([] visited module) 0)
        (= ([] visited module) 1)
        (++= order (call module-locals module per-thread))
      )
    )
    (for (in module (..< 0 module-count))
      (if (== ([] visited module) 0)
        (++= order (call module-locals (as module ModuleId) per-thread))
      )
    )
    (return order)
  )
  (fn-do _ module-locals (list U32)
    (param module ModuleId)
    (param per-thread Bool)
    ; The globals of a module each task, or each thread, holds its own of whose first values a
    ; function stores, in the order they are declared. Every task of a batch makes the values of
    ; every case, so one whose value runs code refuses it unless every case reaches its module.
    (let rows (list U32))
    (let start ([] storage-starts module))
    (let decls (. ([] (. program modules) module) decls))
    (for (in decl (..< 0 (. decls length)))
      (let place (+ start (as decl U32)))
      (let row ([] storage-rows place))
      (if (or (== row no-storage) (== (. ([] storage row) function) no-function))
        (continue)
      )
      (let kind (as ([] global-kinds place) GlobalKind))
      (if (or (!= (== kind .global-thread) per-thread) not-local)
        (continue)
      )
      (lazy not-local (and (!= kind .global-thread) (!= kind .global-task) (!= kind .global-stack)))
      (+= rows row)
      (if (and (call makes-value row) (not (call in-every-case module)))
        (match? ([] decls decl)
          (case (call .decl-property property)
            (call (. refusals append) (call Refusal .refused-batch-local module (. property syntax)))
          )
        )
      )
    )
    (return rows)
  )
  (fn-do _ in-every-case Bool
    (param module ModuleId)
    ; Whether every case of a batch reaches a module, which is so of each module of a program that is
    ; not one: every task of a batch makes the first values of the globals each holds its own of.
    (let starts (. program batch-order-starts))
    (for (in root (..< 0 (. program batch-roots length)))
      (let found false)
      (for (in position (..< ([] starts root) ([] starts (+ root 1))))
        (if (== ([] (. program batch-order-modules) position) module)
          (= found true)
          (break)
        )
      )
      (if (not found)
        (return false)
      )
    )
    (return true)
  )
  (fn-do _ makes-value Bool
    (param row U32)
    ; Whether making the first value of a global each task or thread holds can be seen: its
    ; value calls something, or reads such a global, which must have its own value first.
    (let kept ([] storage row))
    (for (in use (. facts local-global-uses))
      (if (== (. use instance) (. kept owner))
        (return true)
      )
    )
    (match? ([] (. ([] (. program modules) (. kept module)) decls) (. kept decl))
      (case (call .decl-property property)
        (return (call runs-code (. ([] (. program modules) (. kept module)) tree) ([] main-instances (. kept module)) property))
      )
    )
    (return false)
  )
  (fn-do _ lay-locals I64
    (param rows (list U32))
    (param name String)
    (param kind GCRootKind)
    (param size I64)
    ; Lays out the memory of a task's or a thread's locals, at the offsets given them, and gives
    ; its size. Where they hold managed pointers, it is described to the collector, which reads
    ; it in every task or thread.
    (let children (list LayoutId))
    (let held (list TypeId))
    (for (in row rows)
      (+= children (. ([] storage row) layout))
      (+= held (if-expr on-stack no-type (. ([] storage row) type)))
      (lazy on-stack (== (call global-kind (. ([] storage row) module) (. ([] storage row) decl)) .global-stack))
    )
    (if (== (. children length) 0)
      (return size)
    )
    (let layout (call (. layouts environment) children held name))
    (if (. ([] (. layouts rows) layout) is-managed)
      (call (. layouts add-descriptor) layout)
      (call (. bundle gc-roots append) (call GCRootRecord kind no-string (. ([] (. layouts rows) layout) descriptor)))
    )
    (return (. ([] (. layouts rows) layout) size))
  )
  (fn-do _ keep _
    (param row GlobalStorage)
    ; Adds storage to the object: its symbols, and a root record when it holds managed pointers.
    (let layout ([] (. layouts rows) (. row layout)))
    (call (. bundle globals append) (call GlobalData (. row symbol) (. layout size) (. layout alignment)))
    (if (!= (. row state) no-string)
      (call (. bundle globals append) (call GlobalData (. row state) 1 1))
    )
    (if (. layout is-managed)
      (call (. layouts add-descriptor) (. row layout))
      (call (. bundle gc-roots append) (call GCRootRecord .global-root (. row symbol) (. layout descriptor)))
    )
    (call (. storage append) row)
  )
  (fn-do _ calls-within Bool
    (param main InstanceId)
    (param tree AST)
    (param site SyntaxId)
    (for (in node (..< (call (. tree subtree-start) site) (+ site 1)))
      (if (!= (call (. facts first-call) main node) no-fact)
        (return true)
      )
    )
    (return false)
  )
  (fn-do _ defaults-raise Bool
    (param kinds (of CPointer U32))
    ; Whether a default that runs code may panic: one of an emitted instance the type pass says
    ; may panic, which says so of a function for what its defaults call too.
    (for (in instance (..< 0 (. instances length)))
      (if (and (or (== ([] kinds instance) (. Reach body)) (== ([] kinds instance) (. Reach initializer))) panics)
        (if (!= (call first-code-default (as instance InstanceId) 0) no-storage)
          (return true)
        )
      )
      (lazy panics (. ([] (. instances rows) instance) may-panic))
    )
    (return false)
  )
  (fn-do _ first-code-default U32
    (param instance InstanceId)
    (param start U32)
    ; The position of the first parameter from `start` on whose default runs code, of an
    ; instance of a function written in source, or none. A default no call takes, which the type
    ; pass did not type, is none.
    (let row ([] (. instances rows) instance))
    (let owner ([] (. program modules) (. row module)))
    (match? ([] (. owner decls) (. row decl))
      (case (call .decl-function fn)
        (if (. fn is-generated)
          (return no-storage)
        )
        (for (in position (..< start (. fn args count)))
          (let syntax (. ([] (. owner arg-pool) (+ (. fn args start) position)) default-syntax))
          (let typed (call (. instances default-typed) instance position))
          (if (and (!= syntax 0) typed (call default-runs-code instance syntax))
            (return position)
          )
        )
      )
    )
    (return no-storage)
  )
  (fn-do _ is-constant-default Bool
    (param instance InstanceId)
    (param source AST)
    (param syntax SyntaxId)
    ; Whether a default is a constant as TypeScript tells one: a number, a text, a symbol, a truth,
    ; null, an operator on one of those, or a value of an enum or a case of a union named on its
    ; type.
    (match? ([] (. source nodes) syntax)
      (case .node-integer-syntax
        (return true)
      )
      (case .node-float-syntax
        (return true)
      )
      (case .node-string-syntax
        (return true)
      )
      (case .node-symbol
        (return true)
      )
      (case (call .node-identifier row)
        (return (or (== (. row name) (. types true-atom)) (== (. row name) (. types false-atom)) (== (. row name) (. types null-atom))))
      )
      (case (call .node-unary-expression row)
        (return (call is-constant-default instance source (. row operand)))
      )
      (case (call .node-get-expression row)
        (if (or (. row is-tracked) (. row is-optional) (not (call is-type-syntax source (. row object))))
          (return false)
        )
        (let plan (call (. facts plan-of) instance syntax))
        (return (or (== plan .plan-case) (== plan .plan-enum-value)))
      )
    )
    (return false)
  )
  (fn-do _ declare-defaults _
    (param kinds (of CPointer U32))
    ; Gives storage to each default that runs code, of each emitted instance. A constant one is
    ; evaluated once by its module as it starts, after the values of its globals, and a call that
    ; leaves the argument out reads it; the defaults of a module are evaluated in the order of
    ; rank, which is the order their functions are declared in. Any other is evaluated by a
    ; function of its own, which each call that leaves the argument out calls, and has no memory.
    ; A default whose value is nothing is evaluated too, and kept nowhere. A default whose value
    ; has no layout refuses the program.
    (let count (. instances length))
    (= default-starts (call (of (. arena allocate) U32) (+ count 1)))
    (for (in instance (..< 0 count))
      (= ([] default-starts instance) no-storage)
    )
    (for (in instance (. instances ranked))
      (if (and (!= ([] kinds instance) (. Reach body)) (!= ([] kinds instance) (. Reach initializer)))
        (continue)
      )
      (let position (call first-code-default instance 0))
      (while (!= position no-storage)
        (call declare-default instance position)
        (= position (call first-code-default instance (+ position 1)))
      )
    )
  )
  (fn-do _ declare-default _
    (param instance InstanceId)
    (param position U32)
    (let row ([] (. instances rows) instance))
    (let owner ([] (. program modules) (. row module)))
    (let syntax SyntaxId 0)
    (match? ([] (. owner decls) (. row decl))
      (case (call .decl-function fn)
        (= syntax (. ([] (. owner arg-pool) (+ (. fn args start) position)) default-syntax))
      )
    )
    (let type (call (. facts node-type) instance syntax))
    (let layout no-layout)
    (if (and (!= type no-type) (!= type invalid-type))
      (= layout ([] (. layouts values) type))
    )
    (let kept (!= layout no-layout))
    (if (and kept (. ([] (. layouts rows) layout) is-managed) (== (. ([] (. layouts rows) layout) descriptor) no-string))
      (= kept false)
    )
    (if (not kept)
      (call (. refusals append) (call Refusal .refused-expression (. row module) syntax))
      (return)
    )
    (let key
      (scope (str (call instance-display instance) "." stable-text ".default." position)
        (lazy stable-text (call hex-text ([] (. instances stable-keys) instance)))
      )
    )
    (let index U32 (as (. storage length) U32))
    (if (== ([] default-starts instance) no-storage)
      (= ([] default-starts instance) index)
    )
    (if (call is-called-default instance syntax)
      (call (. storage append)
        (block
          (arg
            (call GlobalStorage
              (block
                (arg (. row module))
                (arg 0)
                (arg syntax)
                (arg instance)
                (arg (call (. bundle intern) (call symbol-name (. program target) key)))
                (arg no-string)
                (arg type)
                (arg layout)
                (arg pending-function)
                (arg no-storage)
              )
            )
          )
        )
      )
      (return)
    )
    (let held
      (call GlobalStorage
        (block
          (arg (. row module))
          (arg 0)
          (arg syntax)
          (arg instance)
          (arg (call (. bundle intern) (call symbol-name (. program target) key)))
          (arg no-string)
          (arg type)
          (arg layout)
          (arg no-function)
          (arg no-storage)
        )
      )
    )
    (if (== layout void-layout)
      (call (. storage append) held)
      (else
        (call keep held)
      )
    )
    (if (== ([] default-tails (. row module)) no-storage)
      (= ([] module-defaults (. row module)) index)
      (else
        (= (. ([] storage ([] default-tails (. row module))) next) index)
      )
    )
    (= ([] default-tails (. row module)) index)
    (= ([] module-flags (. row module)) (/or/ ([] module-flags (. row module)) has-statics))
    (if (. row may-panic)
      (= ([] module-flags (. row module)) (/or/ ([] module-flags (. row module)) statics-panic))
    )
  )
  (fn-do _ default-name String
    (param row GlobalStorage)
    ; The name of the parameter whose default a row keeps.
    (let owner ([] (. instances rows) (. row owner)))
    (let module ([] (. program modules) (. owner module)))
    (match? ([] (. module decls) (. owner decl))
      (case (call .decl-function fn)
        (for (in position (..< 0 (. fn args count)))
          (let shape ([] (. module arg-pool) (+ (. fn args start) position)))
          (if (== (. shape default-syntax) (. row syntax))
            (let name (. shape name))
            (return (if-expr name (. name text) ""))
          )
        )
      )
    )
    (return "")
  )
  (fn-do _ class-module ModuleId
    (param type TypeId)
    (match? ([] (. types rows) type)
      (case (call .type-class row)
        (return (. row module))
      )
    )
    (return 0)
  )
  (fn-do _ member-of DeclId
    (param type TypeId)
    (param name Atom)
    ; The declaration of a property a class itself writes, by its name, or none.
    (match? ([] (. types rows) type)
      (case (call .type-class row)
        (let owner ([] (. program modules) (. row module)))
        (match? ([] (. owner decls) (. row decl))
          (case (call .decl-class class)
            (let place (call (. owner first-member) (. class members) name))
            (while (!= place no-member)
              (let member ([] (. owner member-pool) place))
              (= place ([] (. owner member-links) place))
              (match? ([] (. owner decls) member)
                (case (call .decl-property property)
                  (if (and (. property name) (== (. property name) name))
                    (return member)
                  )
                )
              )
            )
          )
        )
      )
    )
    (return 0)
  )
  (fn-do _ declaring TypeId
    (param type TypeId)
    (param name Atom)
    ; The nearest class, from a class up through its bases, that itself writes a property.
    (let current type)
    (while (!= current no-type)
      (if (!= (call member-of current name) 0)
        (return current)
      )
      (= current (. ([] (. types completions) current) base))
    )
    (return no-type)
  )
  (fn-do _ writer-of TypeId
    (param type TypeId)
    (param property TypeProperty)
    ; The class that writes a property's value for the objects of a class: the nearest, from the class
    ; up through its bases, that itself writes it, or the class whose facet declares it.
    (return-if (. property owner) (if (!= (. property facet) (. U32 max))))
    (return (call declaring type (. property name)))
  )
  (fn-expr _ place-of-fact U32
    (param type TypeId)
    (param fact TypeProperty)
    ; The place among all properties of a type's property that is another's, by its name and the
    ; facet that declares it, or none.
    (if-expr found (as found U32) (. U32 max))
    (where
      (lazy found (call (. types property-declared) type (. fact name) (. fact facet)))
    )
  )
  (fn-do _ note-lazy-result _
    (param root U32)
    (param entry FunctionId)
    ; Keeps that the slot of a lazy property holds a function, and what the functions in it
    ; answer: where its value lets out errors, the value or one of them, alike for each function,
    ; and else `invalid-type`.
    (if (== entry no-function)
      (return)
    )
    (= ([] lazy-written root) 1)
    (let given (call lazy-function-result (. ([] functions entry) place)))
    (if (== ([] lazy-results root) (. U32 max))
      (= ([] lazy-results root) given)
      (else-if (!= ([] lazy-results root) given)
        (= ([] lazy-results root) invalid-type)
      )
    )
  )
  (fn-do _ reach _
    (param kinds (of CPointer U32))
    ; Marks every instance the emitted functions call or convert through. Each emitted instance is
    ; visited once, when it joins the set, and only its own facts are read. The values a module
    ; gives its globals as it starts are read with them. An override joins when
    ; the function it replaces is emitted and a constructor of its class is: it is looked at when
    ; the first is visited and when the second is first seen, and at no other time. The values
    ; the first case of a union writes are read with any table of it, whose rows start as that case
    ; and read as it where their tag names none.
    (let count U32 (as (. instances length) U32))
    (= constructed (call (of (. arena allocate) Byte) (+ (. types rows length) 1)))
    (for (in type (..< 0 (. types rows length)))
      (= ([] constructed type) 0)
    )
    (call index-loose count)
    (call index-overrides count)
    (call index-visits count)
    (for (in instance (. instances ordered))
      (if (and (!= ([] kinds instance) (. Reach none)) (!= ([] kinds instance) (. Reach body)))
        (= ([] reach-queue reach-length) instance)
        (+= reach-length 1)
      )
    )
    (for (in module (..< 0 (. program modules length)))
      (if (!= (/and/ ([] module-flags module) (/or/ has-globals has-locals)) 0)
        (call reach-globals kinds (as module ModuleId))
      )
    )
    (for (in type (. types ranked))
      (let union (call row-union types (as type TypeId)))
      (if (and (!= union no-type) (!= (. (call (. types cases-of) union) length) 0))
        (call reach-values kinds (. ([] (call (. types cases-of) union) 0) type))
      )
    )
    (call drain kinds)
  )
  (fn-do _ settle-events _
    (param kinds (of CPointer U32))
    ; Settles which events are live, as the reference does, and numbers them in the order they are
    ; first used, the uses taken in the order `use-order` gives them rather than the one typing
    ; reached them in. An event is live where an emitted function makes it a `Broadcastable`, or
    ; where one publishes to it and one subscribes to it. The subscriber of a loop on an event counts
    ; for neither until that event is live. An event that is not live is never touched: a write
    ; to it, and a loop on it, evaluate only the object. The first publish an emitted function writes
    ; is where the counts of events are declared, and those it writes to an event that is not live, or
    ; that a function not active writes, are counted as erased, as the reference counts the sites it
    ; erases.
    (let count (. instances length))
    (let active (call (of (. arena allocate) Byte) (+ count 1)))
    (for (in position (..< 0 count))
      (= ([] active position) (if-expr (!= ([] kinds position) (. Reach none)) 1 0))
    )
    (let uses (list U32))
    (for (in index (..< 0 (. facts event-uses length)))
      (+= uses (as index U32))
    )
    (let ordered-uses (call sort uses (:using (=> (a b) (call use-order a b)))))
    (for (in index ordered-uses)
      (let used ([] (. facts event-uses) index))
      (if (!= (. used callback) no-instance)
        (= ([] active (. used callback)) 0)
      )
      (if (and (!= ([] kinds (. used instance)) (. Reach none)) (== (call event-index (. used owner) (. used name)) (. U32 max)))
        (+= event-owners (. used owner))
        (+= event-names (. used name))
        (+= event-numbers (. U32 max))
      )
    )
    (let live (list Bool))
    (for (in _ (..< 0 (. event-owners length)))
      (+= live false)
    )
    (let changed true)
    (while changed
      (= changed false)
      (for (in index (..< 0 (. event-owners length)))
        (let escapes false)
        (let publishes false)
        (let hears false)
        (for (in used (. facts event-uses))
          (if (and (!= ([] active (. used instance)) 0) of-event)
            (= escapes (or escapes (== (. used kind) .event-escape)))
            (= publishes (or publishes (== (. used kind) .event-publish) (== (. used kind) .event-route)))
            (= hears (or hears (== (. used kind) .event-subscribe)))
          )
          (lazy of-event (and (== (. used owner) ([] event-owners index)) (== (. used name) ([] event-names index))))
        )
        (if (and (not ([] live index)) (or escapes (and publishes hears)))
          (= ([] live index) true)
          (= changed true)
        )
        (if (not ([] live index))
          (continue)
        )
        (for (in used (. facts event-uses))
          (if (and (== (. used kind) .event-subscribe) (!= ([] active (. used instance)) 0) same-event)
            (if (and (!= (. used callback) no-instance) callback-reached (== ([] active (. used callback)) 0))
              (= ([] active (. used callback)) 1)
              (= changed true)
            )
            (lazy callback-reached (!= ([] kinds (. used callback)) (. Reach none)))
          )
          (lazy same-event (and (== (. used owner) ([] event-owners index)) (== (. used name) ([] event-names index))))
        )
      )
    )
    (let number U32)
    (for (in index (..< 0 (. event-owners length)))
      (if ([] live index)
        (= ([] event-numbers index) number)
        (+= number 1)
      )
    )
    (for (in index ordered-uses)
      (let used ([] (. facts event-uses) index))
      (if (and (or (== (. used kind) .event-publish) (== (. used kind) .event-route)) reached)
        (if (== event-site-instance no-instance)
          (= event-site-instance (. used instance))
          (= event-site (. used site))
        )
        (let event (call event-index (. used owner) (. used name)))
        (if (or (== event (. U32 max)) (not ([] live event)) (== ([] active (. used instance)) 0))
          (+= erased-publishes 1)
        )
      )
      (lazy reached (!= ([] kinds (. used instance)) (. Reach none)))
    )
  )
  (fn-expr _ use-order Comparison
    (param row U32)
    (param other U32)
    ; Orders two uses of events by the stable keys of their instances, then by site and by the node
    ; that names the event.
    (case? (!= placed (. Comparison equal))
      placed
    )
    (default
      (call ordered (. used reference) (. against reference))
    )
    (where
      (lazy used ([] (. facts event-uses) row))
      (lazy against ([] (. facts event-uses) other))
      (lazy placed (call line-order (. used instance) (. used site) (. against instance) (. against site)))
    )
  )
  (fn-do _ event-index U32
    (param owner TypeId)
    (param name Atom)
    (for (in index (..< 0 (. event-owners length)))
      (if (and (== ([] event-owners index) owner) (== ([] event-names index) name))
        (return (as index U32))
      )
    )
    (return (. U32 max))
  )
  (fn-do _ reach-globals _
    (param kinds (of CPointer U32))
    (param module ModuleId)
    ; Marks what the values of a module's globals call as the module starts, and the first
    ; values of those each task holds its own of.
    (let owner ([] (. program modules) module))
    (for (in index (..< 0 (. owner decls length)))
      (let kind (call global-kind module (as index DeclId)))
      (if (or eager (== kind .global-task) (== kind .global-thread) (== kind .global-stack))
        (match? ([] (. owner decls) index)
          (case (call .decl-property property)
            (call reach-site kinds module (. property syntax))
          )
        )
      )
      (lazy eager (== kind .global-eager))
    )
  )
  (fn-do _ drain _
    (param kinds (of CPointer U32))
    ; Visits the instances that joined the emitted set since the last visit, and those the
    ; witness tables they reach bring, until there are no more.
    (while true
      (while (< reach-next reach-length)
        (call visit kinds ([] reach-queue reach-next))
        (+= reach-next 1)
      )
      (if (and observes (< deferred-next (. deferred-instances length)))
        (call visit-gates kinds)
        (continue)
      )
      (if (not (call fill-witnesses kinds))
        (return)
      )
    )
  )
  (fn-do _ reach-report _
    (param kinds (of CPointer U32))
    ; Adds what the report of an unhandled panic calls to the emitted set.
    (let report (. instances report))
    (call mark kinds (. report message))
    (call mark kinds (. report source-text))
    (call mark kinds (. report source))
  )
  (fn-do _ reach-live _
    (param kinds (of CPointer U32))
    ; Adds what tracked values run through to the emitted set, where some value does, what the
    ; subscriptions objects own are made with, the trackers of the latest items of streams, and
    ; what gated blocks of style declarations call and are gated by, for the gates some instance
    ; uses (`used-gates`).
    (let live (. instances live))
    (if (== (. live track) no-instance)
      (return)
    )
    (call mark kinds (. live trackers))
    (call mark kinds (. live subscribers))
    (call mark kinds (. live actions))
    (call mark kinds (. live action))
    (call mark kinds (. live add-action))
    (call mark kinds (. live add-tracker))
    (for (in owned (. facts owned-subscriptions))
      (call mark kinds (. owned subscription))
      (call mark kinds (. owned tracker))
    )
    (if (and (!= (. facts owned-subscriptions length) 0) (!= (. facts task-owner-make) no-instance))
      (call mark kinds (. facts task-owner-make))
    )
    (for (in read (. facts latest-reads))
      (call mark kinds (. read tracker))
    )
    (call mark kinds (. live track))
    (call mark kinds (. live track-collection))
    (call mark kinds (. live track-active))
    (call mark kinds (. live track-active-collection))
    (call mark kinds (. live dispatch))
    (call mark kinds (. live memo-action))
    (call mark kinds (. live memo-settle))
    (call mark kinds (. live previous))
    (call mark kinds (. live next))
    (call mark kinds (. live enter))
    (call mark kinds (. live leave))
    (call mark kinds (. live pop))
    (call mark kinds (. live close))
    (call mark kinds (. live has-actions))
    (let gated (call used-gates))
    (let gating false)
    (for (in used gated)
      (= gating (or gating used))
    )
    (if gating
      (let runtime (. facts style-runtime))
      (call mark kinds (. runtime open-block))
      (call mark kinds (. runtime close-block))
      (call mark kinds (. runtime dynamic))
      (call mark kinds (. runtime block-enabled))
      (for (in index (..< 0 (. facts style-gates length)))
        (if ([] gated index)
          (call mark kinds (. ([] (. facts style-gates) index) action))
        )
      )
    )
    (if (!= (. facts scope-cells length) 0)
      (call mark kinds (. facts style-runtime scope-state))
    )
    (if (!= (. facts style-runtime outlet-state) no-instance)
      (call mark kinds (. facts style-runtime outlet-mark))
      (call mark kinds (. facts style-runtime outlet-push))
      (call mark kinds (. facts style-runtime outlet-release))
      (call mark kinds (. facts style-runtime outlet-state))
    )
  )
  (fn-expr _ compiles-probes Bool
    ; Whether the program declares, flushes and closes its probes: where probes compile and the
    ; probes module is part of the program, with what it calls typed.
    (and (. program probes is-enabled) (!= probe-module (. U32 max)) (!= (. instances probe-runtime begin) no-instance))
  )
  (fn-do _ reach-probes _
    (param kinds (of CPointer U32))
    ; Adds what the functions that declare, flush and close probes call to the emitted set, with what
    ; the report of an error that leaves a function of the probes module calls.
    (let runtime (. instances probe-runtime))
    (call mark kinds (. runtime begin))
    (call mark kinds (. runtime counter-setup))
    (call mark kinds (. runtime profile-setup))
    (call mark kinds (. runtime declare-key))
    (call mark kinds (. runtime declare-type))
    (call mark kinds (. runtime declare-log))
    (call mark kinds (. runtime declare-event))
    (call mark kinds (. runtime declare-counter))
    (call mark kinds (. runtime declare-argument))
    (call mark kinds (. runtime declare-profile-metric))
    (call mark kinds (. runtime counter-add))
    (call mark kinds (. runtime ready))
    (call mark kinds (. runtime collector-counts))
    (call mark kinds (. runtime end))
    (call mark kinds (. runtime task-flush))
    (call mark kinds (. runtime safepoint))
    (call reach-error-report kinds)
  )
  (fn-do _ declare-probes _
    (param kinds (of CPointer U32))
    ; Numbers each probe an emitted instance compiles from one, in the order of the instances' ranks
    ; and then of where the probes are written, a probe for each record one writes (see `ProbeRow`),
    ; with the probe data type of each value it writes: those its calls of the probes module write,
    ; after the head of its record and before the flush, after the group a record of a group opens
    ; or closes. A counter is numbered where its key is first written, then the counts the compiler
    ; keeps of what events do, and of what the collector did, where they compile, after every other.
    ; A metric of the profile is numbered apart, among `profile-metrics`. The class of each
    ; value of a class or an array is kept as it is first found, as the reference declares one for
    ; every value it casts for a probe, and so are the keys of the logs and the groups the emitted
    ; instances write, whether or not their probes compile.
    (if (not (call compiles-probes))
      (return)
    )
    (let keys (list U64))
    (let sites (list U32))
    (for (in position (..< 0 (. facts calls length)))
      (let fact ([] (. facts calls) position))
      (if (and (or (== (. fact form) .call-probe) (== (. fact form) .call-probe-head) is-metric) reached)
        (let key (call pair-key (. fact instance) (. fact syntax)))
        (if (== ([] probe-rows key) null)
          (= ([] probe-rows key) 0)
          (+= keys (call rank-key (. fact instance) (. fact syntax)))
          (+= sites (as position U32))
        )
      )
      (lazy is-metric (== (. fact form) .call-probe-metric))
      (lazy reached (!= ([] kinds (. fact instance)) (. Reach none)))
    )
    (let counters (call (of Map String U32)))
    (let metrics (call (of Map String U32)))
    (for (in position (call ranked-order keys))
      (let fact ([] (. facts calls) ([] sites position)))
      (if (== (. fact form) .call-probe-metric)
        (call declare-profile-metric (. fact instance) (. fact syntax) metrics)
        (continue)
      )
      (let tree (. ([] (. program modules) (. ([] (. instances rows) (. fact instance)) module)) tree))
      (call keep-probe-classes (. fact instance) (. fact syntax))
      (if (is ([] (. tree nodes) (. fact syntax)) .node-probe-counter)
        (call declare-probe-counter (. fact instance) (. fact syntax) counters)
        (continue)
      )
      (let groups (is ([] (. tree nodes) (. fact syntax)) .node-probe-group))
      (let callees (list InstanceId))
      (let part U32)
      (let call (call (. facts first-call) (. fact instance) (. fact syntax)))
      (while (!= call no-fact)
        (let row ([] (. facts calls) call))
        (if (and (== (. row form) .call-probe-head) (!= (. callees length) 0))
          (call declare-probe-part (. fact instance) (. fact syntax) part callees groups)
          (+= part 1)
          (while (!= (. callees length) 0)
            (call (. callees pop))
          )
        )
        (if (or (== (. row form) .call-probe) (== (. row form) .call-probe-head))
          (+= callees (. row callee))
        )
        (= call (. row next))
      )
      (call declare-probe-part (. fact instance) (. fact syntax) part callees groups)
      (= ([] probe-rows (call pair-key (. fact instance) (. fact syntax))) (- (as (. probes length) U32) part))
    )
    (call declare-event-counts counters)
    (for (in count (..< 0 (. collector-counts length)))
      (if (call (. program probes compiles-metrics) (call compiler-count-key (as count U32)))
        (+= probes (call ProbeRow no-instance 0 (as count U32) (call Span (as (. probe-types length) U32) 0)))
        (= ([] collector-counts count) (as (. probes length) U32))
        (= last-counter (as (. probes length) U32))
      )
    )
    (for (in instance (. instances ranked))
      (if (!= ([] kinds instance) (. Reach none))
        (call keep-probe-keys (. ([] (. instances rows) instance) module) (. ([] (. instances rows) instance) subtree))
      )
    )
  )
  (fn-do _ declare-probe-counter _
    (param instance InstanceId)
    (param syntax SyntaxId)
    (param counters (of Map String U32))
    ; Numbers a counter where its key is first written, and gives the same number wherever else it is.
    (match? ([] (. ([] (. program modules) (. ([] (. instances rows) instance) module)) tree nodes) syntax)
      (case (call .node-probe-counter row)
        (let number ([] counters (. row key text)))
        (if (not number)
          (+= probes (call ProbeRow instance syntax 0 (call Span (as (. probe-types length) U32) 0)))
          (= number (as (. probes length) U32))
          (= ([] counters (. row key text)) number)
          (= last-counter number)
        )
        (= ([] probe-rows (call pair-key instance syntax)) number)
      )
    )
  )
  (fn-do _ declare-profile-metric _
    (param instance InstanceId)
    (param syntax SyntaxId)
    (param metrics (of Map String U32))
    ; Numbers a metric of the profile where its key is first written as one of its kind, and gives the
    ; same number wherever else it is: a timer, whose `part` is two, or a counter, whose `part` is one,
    ; as the probes module declares them.
    (let kind U32 1)
    (if (is ([] (. ([] (. program modules) (. ([] (. instances rows) instance) module)) tree nodes) syntax) .node-probe-group)
      (= kind 2)
    )
    (let named (str kind ":" (call metric-key instance syntax)))
    (let number ([] metrics named))
    (if (not number)
      (+= profile-metrics (call ProbeRow instance syntax kind (call Span 0 0)))
      (= number (as (. profile-metrics length) U32))
      (= ([] metrics named) number)
    )
    (= ([] probe-rows (call pair-key instance syntax)) number)
  )
  (fn-do _ declare-event-counts _
    (param counters (of Map String U32))
    ; Numbers the counts the compiler keeps of what events do, where their metrics compile and the
    ; program publishes an event or queues a machine's handler, as the reference declares them all where
    ; it first does one. A key a counter written in the source has keeps the number it has.
    (if (or (not (call (. program probes compiles-metrics) "event")) (not (call counts-events)))
      (return)
    )
    (for (in count (..< 0 (. event-counts length)))
      (let part (as (+ (. collector-counts length) count) U32))
      (let key (call compiler-count-key part))
      (let number ([] counters key))
      (if (not number)
        (+= probes (call ProbeRow no-instance 0 part (call Span (as (. probe-types length) U32) 0)))
        (= number (as (. probes length) U32))
        (= ([] counters key) number)
        (= last-counter number)
      )
      (= ([] event-counts count) number)
    )
  )
  (fn-do _ counts-events Bool
    ; Whether an emitted function publishes an event, reached or not, or queues a machine's handler.
    (return-if true (if (!= event-site-instance no-instance)))
    (return (call some functions (:where (== (. each kind) .machine-descriptor))))
  )
  (fn-do _ declare-probe-part _
    (param instance InstanceId)
    (param syntax SyntaxId)
    (param part U32)
    (param callees (list InstanceId))
    (param groups Bool)
    ; Adds the probe of a record a probe writes, from the calls it makes of the probes module: the
    ; head, the writes, the flush. A record of a group writes the group it opens or closes first,
    ; but for the log a group that only ends writes before it does.
    (let start U32 (as (. probe-types length) U32))
    (if (and groups (not (call ends-in-log instance syntax part)))
      (+= probe-types 15)
      (+= probe-type-classes 16)
    )
    (if (> (. callees length) 2)
      (for (in offset (..< 1 (- (. callees length) 1)))
        (let signature ([] (. instances signatures) ([] callees offset)))
        (let written ([] (. instances signature-types) (. signature args start)))
        (let data (call probe-data-type types written))
        (+= probe-types data)
        (+= probe-type-classes (if-expr (or (== data 14) (== data 15)) (call probe-class-id written) 0))
      )
    )
    (+= probes (call ProbeRow instance syntax part (call Span start (as (- (. probe-types length) start) U32))))
  )
  (fn-do _ ends-in-log Bool
    (param instance InstanceId)
    (param syntax SyntaxId)
    (param part U32)
    ; Whether a record of a group is the log a group written as a log that only ends writes before the
    ; record that ends it.
    (match? ([] (. ([] (. program modules) (. ([] (. instances rows) instance) module)) tree nodes) syntax)
      (case (call .node-probe-group row)
        (return (and (== part 0) (not (. row is-data)) (. row is-end) (not (. row is-begin))))
      )
    )
    (return false)
  )
  (fn-expr _ probe-template String
    (param tree AST)
    (param content (of RowRange SyntaxId))
    (call (. "" join) (in (call probe-template-piece tree each) ([] (. tree children) content)))
  )
  (fn-expr _ probe-template-piece String
    (param tree AST)
    (param item SyntaxId)
    (match ([] (. tree nodes) item)
      (case (call .node-string-syntax text)
        (. text text)
      )
      (default
        "%%"
      )
    )
  )
  (fn-do _ probe-field-names (list String)
    (param tree AST)
    (param content (of RowRange SyntaxId))
    (param logs Bool)
    (let names (list String))
    (for (in item ([] (. tree children) content))
      (if (is ([] (. tree nodes) item) .node-string-syntax)
        (if (not logs)
          (+= names "text")
        )
        (continue)
      )
      (let written (call value-name tree item))
      (+= names (if-expr (!= written "") written (str "value" (+ (. names length) 1))))
    )
    (return names)
  )
  (fn-do _ value-name String
    (param tree AST)
    (param id SyntaxId)
    (match? ([] (. tree nodes) id)
      (case (call .node-identifier row)
        (return (. row name text))
      )
      (case (call .node-get-expression row)
        (let object (call value-name tree (. row object)))
        (return (if-expr (!= object "") (str object "." (. row name text)) ""))
      )
      (case (call .node-call-expression row)
        (return (call value-name tree (. row callable)))
      )
      (case (call .node-probe-snapshot row)
        (return (call value-name tree (. row content)))
      )
      (case (call .node-probe-preview row)
        (return (call value-name tree (. row content)))
      )
    )
    (return "")
  )
  (fn-do _ slot-names (list String)
    (param names (list String))
    (param slots Size)
    (param held Bool)
    (let fields (list String))
    (if (and held (> slots 0))
      (+= fields "group")
    )
    (for (in name names)
      (if (>= (. fields length) slots)
        (break)
      )
      (+= fields name)
    )
    (while (< (. fields length) slots)
      (+= fields (str "value" (+ (. fields length) 1)))
    )
    (return fields)
  )
  (fn-do _ keep-probe-classes _
    (param instance InstanceId)
    (param syntax SyntaxId)
    ; Keeps the class of each value a probe writes, and of the object it is written of, that the
    ; probes module knows by an id: an object of a class, an array or one that is `Inspectable`, where
    ; the probe writes it as such or as its text, but not a preview written as the name of its type.
    (let tree (. ([] (. program modules) (. ([] (. instances rows) instance) module)) tree))
    (match? ([] (. tree nodes) syntax)
      (case (call .node-probe row)
        (call keep-probe-class instance tree (. row object))
        (for (in item ([] (. tree children) (. row content)))
          (call keep-probe-class instance tree item)
        )
      )
      (case (call .node-probe-assign row)
        (call keep-probe-class instance tree (. row object))
        (call keep-probe-class instance tree (. row content))
      )
      (case (call .node-probe-counter row)
        (call keep-probe-class instance tree (. row object))
      )
      (case (call .node-probe-group row)
        (if (. row is-data)
          (call keep-probe-class instance tree (. row object))
        )
        (for (in item ([] (. tree children) (. row content)))
          (call keep-probe-class instance tree item)
        )
      )
    )
  )
  (fn-do _ keep-probe-class _
    (param instance InstanceId)
    (param tree AST)
    (param item SyntaxId)
    (let value item)
    (match? ([] (. tree nodes) item)
      (case (call .node-probe-snapshot row)
        (= value (. row content))
      )
      (case (call .node-probe-preview row)
        (= value (. row content))
      )
    )
    (if (== value 0)
      (return)
    )
    (let type (call (. facts node-type) instance value))
    (if (or (== type no-type) (== type invalid-type))
      (return)
    )
    (let cast (call probe-cast types type))
    (if (or (== cast .probe-object) (== cast .probe-array))
      (let name (call probe-class-name types type))
      (if (== (call (. probe-classes find) name) null)
        (+= probe-classes name)
      )
    )
  )
  (fn-do _ keep-probe-keys _
    (param module ModuleId)
    (param subtree SyntaxRange)
    ; Keeps the key of each log written in the nodes of an instance, and of each group, once.
    (let tree (. ([] (. program modules) module) tree))
    (for (in offset (..< 0 (. subtree count)))
      (let key (? String) null)
      (match? ([] (. tree nodes) (+ (. subtree start) offset))
        (case (call .node-probe row)
          (if (and (. row key) (not (. row name)))
            (= key (. row key text))
          )
        )
        (case (call .node-probe-group row)
          (if (. row key)
            (= key (. row key text))
          )
        )
      )
      (if (and key (== (call (. probe-keys find) key) null))
        (+= probe-keys key)
      )
    )
  )
  (fn-do _ reach-error-report _
    (param kinds (of CPointer U32))
    ; Adds what the report of an error that leaves the main of a module, the value of a lazy
    ; global or the body of a spawned task calls to the emitted set.
    (let report (. instances report))
    (call mark kinds (. report error-text))
    (call mark kinds (. report source-text))
    (call mark kinds (. report source))
  )
  (fn-do _ index-overrides _
    (param count U32)
    ; Chains the overrides by the function each replaces and by the class each answers for.
    (let type-count (. types rows length))
    (let fact-count U32 (as (. facts overrides length) U32))
    (= base-override-heads (call (of (. arena allocate) U32) (+ count 1)))
    (= class-override-heads (call (of (. arena allocate) U32) (+ type-count 1)))
    (= base-override-links (call (of (. arena allocate) U32) (+ fact-count 1)))
    (= class-override-links (call (of (. arena allocate) U32) (+ fact-count 1)))
    (for (in instance (..< 0 count))
      (= ([] base-override-heads instance) no-fact)
    )
    (for (in type (..< 0 type-count))
      (= ([] class-override-heads type) no-fact)
    )
    (for (in position (..< 0 fact-count))
      (let fact ([] (. facts overrides) position))
      (= ([] base-override-links position) ([] base-override-heads (. fact base)))
      (= ([] base-override-heads (. fact base)) position)
      (= ([] class-override-links position) ([] class-override-heads (. fact receiver)))
      (= ([] class-override-heads (. fact receiver)) position)
    )
  )
  (fn-do _ index-loose _
    (param count U32)
    ; Chains the facts recorded at nodes no body reserved, the checked reads of globals, and the
    ; properties a property's value reads, by the instance they belong to, so that a visit reads
    ; only its own.
    (= loose-call-heads (call (of (. arena allocate) U32) (+ count 1)))
    (= loose-conversion-heads (call (of (. arena allocate) U32) (+ count 1)))
    (for (in instance (..< 0 count))
      (= ([] loose-call-heads instance) no-fact)
      (= ([] loose-conversion-heads instance) no-fact)
    )
    (= loose-call-links (call (of (. arena allocate) U32) (+ (. facts loose-calls length) 1)))
    (= loose-conversion-links (call (of (. arena allocate) U32) (+ (. facts loose-conversions length) 1)))
    (for (in position (..< 0 (. facts loose-calls length)))
      (let owner (. ([] (. facts loose-calls) position) instance))
      (= ([] loose-call-links position) ([] loose-call-heads owner))
      (= ([] loose-call-heads owner) (as position U32))
    )
    (for (in position (..< 0 (. facts loose-conversions length)))
      (let owner (. ([] (. facts loose-conversions) position) instance))
      (= ([] loose-conversion-links position) ([] loose-conversion-heads owner))
      (= ([] loose-conversion-heads owner) (as position U32))
    )
    (= use-heads (call (of (. arena allocate) U32) (+ count 1)))
    (= use-links (call (of (. arena allocate) U32) (+ (. facts global-uses length) 1)))
    (= loose-forcing (call (of (. arena allocate) U8) (+ count 1)))
    (for (in instance (..< 0 count))
      (= ([] use-heads instance) no-fact)
      (= ([] loose-forcing instance) 0)
    )
    (for (in loose (. facts loose-forces))
      (= ([] loose-forcing (. loose instance)) 1)
    )
    (for (in position (..< 0 (. facts global-uses length)))
      (let owner (. ([] (. facts global-uses) position) instance))
      (= ([] use-links position) ([] use-heads owner))
      (= ([] use-heads owner) (as position U32))
    )
    (= read-heads (call (of (. arena allocate) U32) (+ count 1)))
    (= read-links (call (of (. arena allocate) U32) (+ (. facts value-reads length) 1)))
    (for (in instance (..< 0 count))
      (= ([] read-heads instance) no-fact)
    )
    (for (in position (..< 0 (. facts value-reads length)))
      (let owner (. ([] (. facts value-reads) position) instance))
      (= ([] read-links position) ([] read-heads owner))
      (= ([] read-heads owner) (as position U32))
    )
  )
  (fn-do _ visit _
    (param kinds (of CPointer U32))
    (param instance InstanceId)
    ; Marks what one emitted instance calls and converts through: the facts at the nodes of its body,
    ; and those recorded for it at no node of it. A call the compiler answers itself brings no callee. A
    ; forced optional brings the panic one that holds nothing raises, and a match no arm of which may
    ; match the panic it raises then, and an access of a view or of a table the panics the compiler
    ; writes for it, with their source. A value of an enum named brings what making it calls. A loop
    ; over a container whose protocol raises an error brings the panic the loop makes of one. A function
    ; with a loop that polls brings the check a poll makes. The constructor of a table that grows in an
    ; arena, or of an index span of a range, brings the panics it writes, with their source. A
    ; constructor brings what the values its class gives its properties call, and makes its class one
    ; the program constructs. A checked read of a global brings the panic it raises and, of a lazy
    ; global, what the global's value calls. The overrides of the instance join for the classes
    ; constructed so far, and those of a class newly constructed for the functions emitted so far. A
    ; comparison of values of interfaces brings the panic it may raise. A function of an interface run
    ; for a value of a type that is none brings the type's witness table, and a function that yields and
    ; returns an interface that of the generator it makes. A member that runs on a row's case brings its
    ; instance on the case, which the member may be a bridge to. A function that makes a live statement
    ; brings the function its action runs it again with, and the function of the markup runtime that
    ; makes the action an element of a markup host owns, one that uses an event the functions of the
    ; event runtime it calls, one that claims the endpoint at the address of a keyed event the
    ; constructor of the tracker that closes it, one that reads a markup link the function of the markup
    ; runtime that answers it, and one that writes markup under a markup host the functions of the
    ; markup runtime that link and batch it, and of each branch region it makes, those that make and
    ; select the region and the function that selects its arm again. One that reads a style or the flag
    ; of a domain brings the style runtime's reader or writer, and one that declares styles the
    ; functions of the style runtime that declare them, with the instance that types each style rule it
    ; applies, emitted in its frame.
    (let row ([] (. instances rows) instance))
    (if (!= (. row materialized) no-instance)
      (call mark kinds (. row materialized))
    )
    (for (in entry (..< ([] visit-starts instance) ([] visit-starts (+ instance 1))))
      (call visit-fact kinds instance ([] visit-kinds entry) ([] visit-rows entry))
    )
    (let replaced ([] base-override-heads instance))
    (while (!= replaced no-fact)
      (let override ([] (. facts overrides) replaced))
      (if (and (!= ([] constructed (. override receiver)) 0) (!= (. override override) no-instance))
        (call mark kinds (. override override))
      )
      (= replaced ([] base-override-links replaced))
    )
    (if (!= (. row node-start) (. U32 max))
      (let first (. row subtree start))
      (let tree (. ([] (. program modules) (. row module)) tree))
      (let gate ([] (. program feature-gate-starts) (. row module)))
      (let gates-end ([] (. program feature-gate-starts) (+ (. row module) 1)))
      (let offset U32)
      (while (< offset (. row subtree count))
        (let id (+ first offset))
        (while (and (< gate gates-end) (< ([] (. program feature-gates) gate) id))
          (+= gate 1)
        )
        (if (and (< gate gates-end) (call defers-gate tree ([] (. program feature-gates) gate) id))
          (+= deferred-instances instance)
          (+= deferred-gates ([] (. program feature-gates) gate))
          (= offset (- (+ ([] (. program feature-gates) gate) 1) first))
          (+= gate 1)
          (continue)
        )
        (call visit-node kinds instance row offset)
        (+= offset 1)
      )
    )
    (if (!= ([] loose-forcing instance) 0)
      (call mark kinds (. instances report panic))
    )
    (let loose ([] loose-call-heads instance))
    (while (!= loose no-fact)
      (call reach-call kinds ([] (. facts calls) (. ([] (. facts loose-calls) loose) fact)))
      (= loose ([] loose-call-links loose))
    )
    (= loose ([] loose-conversion-heads instance))
    (while (!= loose no-fact)
      (let fact ([] (. facts conversions) (. ([] (. facts loose-conversions) loose) fact)))
      (if (call is-reference kinds instance (. fact syntax))
        (call reach-conversion kinds fact)
      )
      (= loose ([] loose-conversion-links loose))
    )
    (if (. row polls)
      (call mark-termination kinds)
    )
    (if (or (call writes-panics instance) (. row casts-errors))
      (call mark kinds (. instances report panic))
      (call mark kinds (. instances report source))
    )
    (let view (call receiver-view instance))
    (if (!= view no-type)
      (call reach-witness (. row self-type) view)
    )
    (let given (. ([] (. instances signatures) instance) returns))
    (if (and (!= (. row makes) no-type) (!= given no-type) (== (. ([] (. types completions) given) intrinsic) .interface))
      (call reach-witness (. row makes) given)
    )
    (let use ([] use-heads instance))
    (while (!= use no-fact)
      (call reach-global kinds ([] (. facts global-uses) use))
      (= use ([] use-links use))
    )
    (if (and not-body (!= ([] kinds instance) (. Reach in-frame)) (!= ([] kinds instance) (. Reach initializer)))
      (return)
    )
    (lazy not-body (!= ([] kinds instance) (. Reach body)))
    (call reach-defaults kinds instance)
    (if (!= ([] kinds instance) (. Reach initializer))
      (call construct kinds instance)
    )
  )
  (fn-do _ visit-fact _
    (param kinds (of CPointer U32))
    (param instance InstanceId)
    (param kind VisitFact)
    (param row U32)
    ; Marks what one row of the facts a visit reads for an instance brings, as `visit` says.
    (match kind
      (case= .visit-live-statement
        (let statement ([] (. facts live-statements) row))
        (call mark kinds (. statement rerun))
        (if (!= (. statement owned) no-instance)
          (call mark kinds (. statement owned))
        )
        (if (call (. facts style-declaration-of) instance (. statement site))
          (call mark kinds (. facts style-runtime dynamic))
          (call mark kinds (. facts style-runtime author-dynamic))
        )
      )
      (case= .visit-markup-read
        (call mark kinds (. ([] (. facts markup-reads) row) reader))
      )
      (case= .visit-style-read
        (call mark kinds (. ([] (. facts style-reads) row) reader))
      )
      (case= .visit-style-flag
        (call mark kinds (. ([] (. facts style-flags) row) call))
      )
      (case= .visit-style-site
        (let runtime (. facts style-runtime))
        (call mark kinds (. runtime info-required))
        (call mark kinds (. runtime site-static))
        (call mark kinds (. runtime site-recording))
        (call mark kinds (. runtime site-recorded))
        (call mark kinds (. runtime template-static))
        (call mark kinds (. runtime associate))
        (call mark kinds (. runtime site-ready))
        (call mark kinds (. runtime site-inherit))
        (call mark kinds (. runtime sheet-info-required))
        (call mark kinds (. runtime site-sheet))
        (call mark kinds (. runtime site-projected))
        (call mark kinds (. runtime site-themed))
        (call mark kinds (. runtime themed-slot))
        (call mark kinds (. runtime themed-none))
        (call mark kinds (. runtime site-family))
        (call mark kinds (. runtime site-family-end))
      )
      (case= .visit-style-content
        (call mark kinds (. ([] (. facts style-contents) row) builder))
        (call mark kinds (. facts style-runtime template-content))
        (call mark kinds (. facts style-runtime content-enabled))
      )
      (case= .visit-style-application
        (let application ([] (. facts style-applications) row))
        (if (!= (. application action) no-instance)
          (call mark kinds (. application action))
          (call mark kinds (. facts style-runtime dynamic))
          (call mark kinds (. facts style-runtime author-dynamic))
        )
        (if (!= (. application updater) no-instance)
          (call mark kinds (. application updater))
        )
        (if (== ([] kinds (. application unit)) (. Reach none))
          (= ([] kinds (. application unit)) (. Reach in-frame))
          (= ([] reach-queue reach-length) (. application unit))
          (+= reach-length 1)
        )
        (if (and (!= (. application values) no-instance) (== ([] kinds (. application values)) (. Reach none)))
          (= ([] kinds (. application values)) (. Reach in-frame))
          (= ([] reach-queue reach-length) (. application values))
          (+= reach-length 1)
        )
      )
      (case= .visit-content-link
        (let link ([] (. facts content-links) row))
        (if (!= (. link append) no-instance)
          (call mark kinds (. link append))
        )
      )
      (case= .visit-element-root
        (let root ([] (. facts element-roots) row))
        (if (!= (. root ensure) no-instance)
          (call mark kinds (. root ensure))
        )
        (if (!= (. root mount) no-instance)
          (call mark kinds (. root mount))
        )
      )
      (case= .visit-branch-region
        (let region ([] (. facts branch-regions) row))
        (call mark kinds (. region create))
        (call mark kinds (. region updater))
        (call mark kinds (. region action))
        (call mark kinds (. region structural))
        (call mark kinds (. region keeps))
        (call mark kinds (. region select))
        (if (!= (. region ensure) no-instance)
          (call mark kinds (. region ensure))
        )
      )
      (case= .visit-loop-region
        (let region ([] (. facts loop-regions) row))
        (call mark kinds (. region create))
        (call mark kinds (. region updater))
        (call mark kinds (. region action))
        (call mark kinds (. region structural))
        (if (!= (. region ensure) no-instance)
          (call mark kinds (. region ensure))
        )
        (if (!= (. region replace) no-instance)
          (call mark kinds (. region replace))
        )
        (if (!= (. region adapts) no-instance)
          (call mark kinds (. region adapts))
        )
      )
      (case= .visit-region-root
        (let root ([] (. facts region-roots) row))
        (if (!= (. root ensure) no-instance)
          (call mark kinds (. root ensure))
        )
      )
      (case= .visit-self-action
        (let action ([] (. facts self-actions) row))
        (if (!= (. action maker) no-instance)
          (call mark kinds (. action maker))
        )
      )
      (case= .visit-query-registration
        (let registration ([] (. facts query-registrations) row))
        (if (or (!= (. registration query) (. U32 max)) (!= (. (call target-ids-of (. registration level)) length) 0))
          (call mark kinds (. registration register))
        )
        (if (!= (. registration query) (. U32 max))
          (let query ([] (. facts markup-queries) (. registration query)))
          (= ([] query-used (. registration query)) 1)
          (call mark kinds (. query parent))
          (call mark kinds (. query add))
          (call mark kinds (. query remove))
          (call reach-conversion kinds ([] (. facts conversions) (. query hosted)))
        )
      )
      (case= .visit-event-use
        (let used ([] (. facts event-uses) row))
        (call mark kinds (. used first))
        (call mark kinds (. used second))
      )
      (case= .visit-address-claim
        (call mark kinds (. ([] (. facts address-claims) row) closer))
      )
      (case= .visit-event-closer
        (call mark kinds (. facts event-close))
      )
      (case= .visit-machine-group
        (let group ([] (. facts machine-groups) row))
        (call mark kinds (. group enqueue))
        (call mark kinds (. group port))
        (call mark kinds (. group post))
        (call mark kinds (. group attach))
        (call mark kinds (. group detach))
      )
      (case= .visit-machine-stop
        (call mark kinds (. facts machine-own))
        (call mark kinds (. facts machine-stop))
        (call mark kinds (. facts machine-close))
      )
      (case= .visit-slot-outlet
        (call mark kinds (. ([] (. facts slot-outlets) row) chosen))
      )
      (case= .visit-slot-choice
        (call mark kinds (. ([] (. facts slot-choices) row) create))
        (call mark kinds (. ([] (. facts slot-choices) row) fill))
      )
      (case= .visit-machine-refinement
        (let refined (. ([] (. facts machines) row) refined))
        (let unit (if-expr (!= refined no-instance) (. ([] (. instances rows) refined) enclosing) no-instance))
        (if (and (!= unit no-instance) (== ([] kinds unit) (. Reach none)))
          (= ([] kinds unit) (. Reach in-frame))
          (= ([] reach-queue reach-length) unit)
          (+= reach-length 1)
        )
      )
    )
  )
  (fn-do _ index-visits _
    (param count U32)
    ; Gathers the rows of the facts a visit reads by the instance each names, so that a visit
    ; reads only its own: for each instance, the tables in the order of `VisitFact`, and the
    ; rows of each in the table's order.
    (let owners (list InstanceId))
    (let ends (list U32))
    (for (in statement (. facts live-statements))
      (+= owners (. statement instance))
    )
    (+= ends (as (. owners length) U32))
    (for (in read (. facts markup-reads))
      (+= owners (. read instance))
    )
    (+= ends (as (. owners length) U32))
    (for (in read (. facts style-reads))
      (+= owners (. read instance))
    )
    (+= ends (as (. owners length) U32))
    (for (in flag (. facts style-flags))
      (+= owners (. flag instance))
    )
    (+= ends (as (. owners length) U32))
    (for (in site (. facts style-sites))
      (+= owners (. site instance))
    )
    (+= ends (as (. owners length) U32))
    (for (in content (. facts style-contents))
      (+= owners (. content instance))
    )
    (+= ends (as (. owners length) U32))
    (for (in application (. facts style-applications))
      (+= owners (. application instance))
    )
    (+= ends (as (. owners length) U32))
    (for (in link (. facts content-links))
      (+= owners (. link instance))
    )
    (+= ends (as (. owners length) U32))
    (for (in root (. facts element-roots))
      (+= owners (. root instance))
    )
    (+= ends (as (. owners length) U32))
    (for (in region (. facts branch-regions))
      (+= owners (. region instance))
    )
    (+= ends (as (. owners length) U32))
    (for (in region (. facts loop-regions))
      (+= owners (. region instance))
    )
    (+= ends (as (. owners length) U32))
    (for (in root (. facts region-roots))
      (+= owners (. root instance))
    )
    (+= ends (as (. owners length) U32))
    (for (in action (. facts self-actions))
      (+= owners (. action instance))
    )
    (+= ends (as (. owners length) U32))
    (for (in registration (. facts query-registrations))
      (+= owners (. registration instance))
    )
    (+= ends (as (. owners length) U32))
    (for (in used (. facts event-uses))
      (+= owners (. used instance))
    )
    (+= ends (as (. owners length) U32))
    (for (in claim (. facts address-claims))
      (+= owners (. claim instance))
    )
    (+= ends (as (. owners length) U32))
    (for (in closer (. facts event-closers))
      (+= owners closer)
    )
    (+= ends (as (. owners length) U32))
    (for (in group (..< 0 (. facts machine-groups length)))
      (+= owners (call machine-instance (as group U32)))
    )
    (+= ends (as (. owners length) U32))
    (for (in machine (. facts machines))
      (+= owners (if-expr (!= (. machine refined) no-instance) (. machine instance) no-instance))
    )
    (+= ends (as (. owners length) U32))
    (for (in machine (. facts machines))
      (+= owners (if-expr (call stops-at-close machine) (. machine instance) no-instance))
    )
    (+= ends (as (. owners length) U32))
    (for (in outlet (. facts slot-outlets))
      (+= owners (if-expr (!= (. outlet chosen) no-instance) (. outlet instance) no-instance))
    )
    (+= ends (as (. owners length) U32))
    (for (in choice (. facts slot-choices))
      (+= owners (. choice instance))
    )
    (+= ends (as (. owners length) U32))
    (= visit-starts (call (of (. arena allocate) U32) (+ count 1)))
    (for (in instance (..< 0 (+ count 1)))
      (= ([] visit-starts instance) 0)
    )
    (for (in owner owners)
      (if (< owner count)
        (+= ([] visit-starts (+ owner 1)) 1)
      )
    )
    (for (in instance (..< 1 (+ count 1)))
      (+= ([] visit-starts instance) ([] visit-starts (- instance 1)))
    )
    (let filled (call (of (. arena allocate) U32) (+ count 1)))
    (for (in instance (..< 0 (+ count 1)))
      (= ([] filled instance) ([] visit-starts instance))
    )
    (= visit-kinds (call (of (. arena allocate) VisitFact) (+ (. owners length) 1)))
    (= visit-rows (call (of (. arena allocate) U32) (+ (. owners length) 1)))
    (let table U32)
    (let begins U32)
    (for (in flat (..< 0 (. owners length)))
      (while (>= flat ([] ends table))
        (= begins ([] ends table))
        (+= table 1)
      )
      (let owner ([] owners flat))
      (if (< owner count)
        (= ([] visit-kinds ([] filled owner)) (as table VisitFact))
        (= ([] visit-rows ([] filled owner)) (as (- flat begins) U32))
        (+= ([] filled owner) 1)
      )
    )
  )
  (fn-do _ machine-instance InstanceId
    (param group U32)
    ; The instance whose function writes the machine a group of event transitions is of.
    (for (in machine (. facts machines))
      (if (and (>= group (. machine groups start)) (< group (+ (. machine groups start) (. machine groups count))))
        (return (. machine instance))
      )
    )
    (return no-instance)
  )
  (fn-do _ visit-node _
    (param kinds (of CPointer U32))
    (param instance InstanceId)
    (param row Instance)
    (param offset U32)
    (let slot (+ (. row node-start) offset))
    (let call ([] (. facts node-calls) slot))
    (while (!= call no-fact)
      (call reach-call kinds ([] (. facts calls) call))
      (= call (. ([] (. facts calls) call) next))
    )
    (let conversion ([] (. facts node-conversions) slot))
    (while (!= conversion no-fact)
      (let fact ([] (. facts conversions) conversion))
      (if (call is-reference kinds instance (. fact syntax))
        (call reach-conversion kinds fact)
      )
      (= conversion (. fact next))
    )
    (let plan (as (/and/ ([] (. facts node-plans) slot) plan-bits) OperatorPlan))
    (call reach-node kinds instance (+ (. row subtree start) offset) plan (!= ([] (. facts node-forces) slot) no-fact))
  )
  (fn-do _ defers-gate Bool
    (param tree AST)
    (param gate SyntaxId)
    (param id SyntaxId)
    (if (or observes (!= (call (. tree subtree-start) gate) id))
      (return false)
    )
    (match? ([] (. tree nodes) gate)
      (case (call .node-do-block row)
        (return (!= (/and/ (. row feature-gate-features) (. CompilerFeature collection-observers)) 0))
      )
    )
    (return false)
  )
  (fn-do _ visit-gates _
    (param kinds (of CPointer U32))
    (while (< deferred-next (. deferred-instances length))
      (let instance ([] deferred-instances deferred-next))
      (let gate ([] deferred-gates deferred-next))
      (+= deferred-next 1)
      (let row ([] (. instances rows) instance))
      (let start (call (. ([] (. program modules) (. row module)) tree subtree-start) gate))
      (for (in id (..< start (+ gate 1)))
        (call visit-node kinds instance row (- id (. row subtree start)))
      )
    )
  )
  (fn-do _ reach-node _
    (param kinds (of CPointer U32))
    (param instance InstanceId)
    (param syntax SyntaxId)
    (param plan OperatorPlan)
    (param forced Bool)
    ; Marks what a node an emitted instance answers brings besides its calls and conversions: the
    ; panics the compiler writes for it, with their source, where it is `forced` and otherwise, and the
    ; values of enums it reads.
    (if forced
      (call mark kinds (. instances report panic))
    )
    (if (== plan .plan-unmatched)
      (call mark kinds (. instances report panic))
    )
    (let builds (or (== plan .plan-builder-append) (== plan .plan-builder-reserve)))
    (if (or (== plan .plan-view) (== plan .plan-table) (== plan .plan-table-loop) builds)
      (call mark kinds (. instances report panic))
      (call mark kinds (. instances report source))
    )
    (if (== plan .plan-enum-value)
      (call reach-enum kinds (call (. facts constant-of) instance syntax))
    )
    (if (== plan .plan-raise)
      (call mark kinds (. instances report source))
    )
    (if (== plan .plan-literal-conversion)
      (call mark kinds (. instances report panic))
      (call mark kinds (. instances report error-text))
    )
    (if (call compares-interfaces instance syntax plan)
      (call mark kinds (. instances report panic))
      (call mark kinds (. instances report source))
    )
    (if (or (== plan .plan-stream-loop) (== plan .plan-cursor-loop))
      (call reach-loop-panic kinds instance (call (. facts feed-site) instance syntax))
    )
    (if (or (== plan .plan-index-loop) (call is-place-loop-plan plan))
      (call reach-loop-panic kinds instance (call (. facts feed-site) instance syntax))
    )
  )
  (fn-do _ construct _
    (param kinds (of CPointer U32))
    (param instance InstanceId)
    ; Makes the class of a constructor the program calls one it constructs, and brings the
    ; overrides that class declares of the functions emitted so far.
    (let row ([] (. instances rows) instance))
    (let type (. row self-type))
    (if (or (== type no-type) (== type invalid-type))
      (return)
    )
    (match? ([] (. ([] (. program modules) (. row module)) decls) (. row decl))
      (case (call .decl-function fn)
        (if (and (call constructs (. fn kind)) (== ([] constructed type) 0))
          (= ([] constructed type) 1)
          (+= constructed-order type)
          (+= class-count 1)
          (let made ([] class-override-heads type))
          (while (!= made no-fact)
            (let override ([] (. facts overrides) made))
            (if (and (!= ([] kinds (. override base)) (. Reach none)) (!= (. override override) no-instance))
              (call mark kinds (. override override))
            )
            (= made ([] class-override-links made))
          )
        )
      )
    )
  )
  (fn-do _ compares-interfaces Bool
    (param instance InstanceId)
    (param syntax SyntaxId)
    (param plan OperatorPlan)
    ; Whether a node compares values of interfaces, which may panic with a message: as its own
    ; plan says, or where it compares what optionals hold or the parts of two values and a getter
    ; is read there, which says whether a tracker compares for a change.
    (if (or (== plan .plan-interface-equal) (== plan .plan-interface-unlike))
      (return true)
    )
    (let inner (if-expr (== plan .plan-held) (. (call (. facts held-of) instance syntax) plan) plan))
    (if (== inner .plan-interface-unlike)
      (return true)
    )
    (if (and (!= inner .plan-interface-equal) (!= inner .plan-fields) (!= inner .plan-not-fields))
      (return false)
    )
    (let call (call (. facts first-call) instance syntax))
    (while (!= call no-fact)
      (if (== (. ([] (. facts calls) call) form) .call-getter)
        (return true)
      )
      (= call (. ([] (. facts calls) call) next))
    )
    (return false)
  )
  (fn-do _ reach-conversion _
    (param kinds (of CPointer U32))
    (param fact ConversionFact)
    ; Marks what a conversion an emitted instance makes calls: the function that converts, every
    ; value of an enum a number is converted to by its place, those
    ; that convert the fields of a tuple or struct or what an optional holds, the witness table of
    ; a value made one of an interface, and the constructor of the panic that a cast of an
    ; object to a class derived from its own, or of a value of an interface to what it holds,
    ; raises when it fails, or an optional that holds nothing when it is unwrapped, and the panic
    ; the views of fields' columns cast to a span raise when their lengths differ. A conversion by
    ; a function that raises brings what its errors need: the source they are given where they
    ; leave, or the panic they become.
    (call mark kinds (. fact callee))
    (call reach-made-interface fact)
    (call reach-made kinds fact)
    (call reach-parts kinds (. fact parts))
    (if (and (== (. fact kind) .relation-fromverter) (== (. fact callee) no-instance))
      (call reach-enum-values kinds (. fact to))
    )
    (let down (or (== (. fact kind) .relation-down-cast) (== (. fact kind) .relation-interface-down-cast)))
    (if (or down (== (. fact kind) .relation-unwrap-cast))
      (call mark kinds (. instances report panic))
    )
    (if (and (== (. fact kind) .relation-side-cast) (== (. ([] (. types completions) (. fact to)) intrinsic) .table-span))
      (call mark kinds (. instances report panic))
      (call mark kinds (. instances report source))
    )
    (if (== (. fact raise) .raise-leaves)
      (call mark kinds (. instances report source))
    )
    (if (== (. fact raise) .raise-panics)
      (call mark kinds (. instances report panic))
      (call mark kinds (. instances report error-text))
    )
    (call reach-union-error kinds fact)
  )
  (fn-do _ reach-made _
    (param kinds (of CPointer U32))
    (param fact ConversionFact)
    ; Marks what a conversion to a value of a function type brings: the function the value
    ; runs, the function made for the two types, and what the conversions that function makes
    ; call.
    (if (!= (. fact runs) no-instance)
      (call reach-callee kinds (. fact runs))
      (call reach-value fact)
      (if (!= (. ([] (. instances signatures) (. fact runs)) errors count) 0)
        (call mark kinds (. instances report source))
      )
      (let passed (call (. facts first-passed) (. fact runs)))
      (while (!= passed no-fact)
        (call reach-conversion kinds ([] (. facts conversions) passed))
        (= passed (. ([] (. facts conversions) passed) next))
      )
    )
    (if (. fact casts)
      (call reach-value fact)
      (if (call carries-errors (. fact from))
        (call mark kinds (. instances report source))
      )
      (let passed (call (. facts first-cast) (. fact from) (. fact to)))
      (while (!= passed no-fact)
        (call reach-conversion kinds ([] (. facts conversions) passed))
        (= passed (. ([] (. facts conversions) passed) next))
      )
    )
  )
  (fn-expr _ carries-errors Bool
    (param type TypeId)
    ; Whether the type pass kept, for a function type, what a call of its value answers with:
    ; the type carries errors.
    (and (!= fn no-type) (!= (call (. facts carried-result) fn) no-type))
    (where
      (lazy fn (call function-row types type))
    )
  )
  (fn-expr _ rank-key U64
    (param instance InstanceId)
    (param site U32)
    ; A key that orders rows of facts by the rank of their instance, then by `site`.
    (/or/ (/lshift/ (as (call (. instances rank-of) instance) U64) 32) (as site U64))
  )
  (fn-do _ ranked-instances (list InstanceId)
    (param listed (list InstanceId))
    ; The instances of a list in the order of their ranks.
    (let keys (list U64))
    (for (in instance listed)
      (+= keys (call rank-key instance 0))
    )
    (let ordered (list InstanceId))
    (for (in position (call ranked-order keys))
      (+= ordered ([] listed position))
    )
    (return ordered)
  )
  (fn-do _ ranked-order (list U32)
    (param keys (list U64))
    ; The positions of `keys` in the order of their keys, those of equal keys in their order in the
    ; list.
    (let count (. keys length))
    (let order (list U32))
    (let spare (list U32))
    (for (in position (..< 0 count))
      (+= order (as position U32))
      (+= spare 0)
    )
    (let width Size 1)
    (while (< width count)
      (let start Size 0)
      (while (< start count)
        (let middle (if-expr (< (+ start width) count) (+ start width) count))
        (let end (if-expr (< (+ middle width) count) (+ middle width) count))
        (let left start)
        (let right middle)
        (for (in position (..< start end))
          (if (and (< left middle) (or (>= right end) (>= ([] keys ([] order right)) ([] keys ([] order left)))))
            (= ([] spare position) ([] order left))
            (+= left 1)
            (else
              (= ([] spare position) ([] order right))
              (+= right 1)
            )
          )
        )
        (= start end)
      )
      (let merged order)
      (= order spare)
      (= spare merged)
      (*= width 2)
    )
    (return order)
  )
  (fn-do _ index-sites _
    (for (in position (..< 0 (. facts event-uses length)))
      (let key (call site-key (. ([] (. facts event-uses) position) instance) (. ([] (. facts event-uses) position) site)))
      (if (== ([] event-use-places key) null)
        (= ([] event-use-places key) (as position U32))
      )
    )
    (for (in position (..< 0 (. facts owned-subscriptions length)))
      (let key
        (call site-key
          (block
            (arg (. ([] (. facts owned-subscriptions) position) instance))
            (arg (. ([] (. facts owned-subscriptions) position) site))
          )
        )
      )
      (if (== ([] subscription-places key) null)
        (= ([] subscription-places key) (as position U32))
      )
    )
    (for (in position (..< 0 (. facts live-statements length)))
      (let key (call site-key (. ([] (. facts live-statements) position) instance) (. ([] (. facts live-statements) position) site)))
      (if (== ([] live-statement-places key) null)
        (= ([] live-statement-places key) (as position U32))
      )
    )
    (for (in machine (. facts machines))
      (let key (/or/ (/lshift/ (as (. machine module) Size) 32) (as (. machine decl) Size)))
      (if (and (== (. machine store) .store-member) (== ([] member-machines key) null))
        (= ([] member-machines key) (. machine syntax))
      )
    )
  )
  (fn-expr _ site-key Size
    (param instance InstanceId)
    (param site SyntaxId)
    (/or/ (/lshift/ (as instance Size) 32) (as site Size))
  )
  (fn-expr _ pair-key Size
    (param from TypeId)
    (param to TypeId)
    (/or/ (/lshift/ (as from Size) 32) (as to Size))
  )
  (fn-do _ reach-value _
    (param fact ConversionFact)
    ; Notes the function a value of a function type made by a conversion runs: one for the
    ; type converted and the function type. A closure the type pass noted a place for is made
    ; there, and a value of a function type made a value of another where the type pass kept
    ; one place for the two types. Any other is made where its conversion is written, and one
    ; that conversions in two instances make, or a binding's that two places make, where the
    ; first of them is written.
    (let key (call pair-key (. fact from) (. fact to)))
    (let found ([] adapter-rows key))
    (let binds (or (== (. ([] (. types completions) (. fact from)) intrinsic) .binding) (. fact casts)))
    (if (!= found null)
      (let row ([] adapters found))
      (if (and (not (. row fixed)) (or (!= (. row made-instance) (. fact instance)) (and binds (!= (. row made-site) (. fact syntax)))))
        (= (. ([] adapters found) shared) true)
      )
      (let elsewhere (or (!= (. row instance) (. fact instance)) (and binds (!= (. row site) (. fact syntax)))))
      (if (and elsewhere (not (. row fixed)) (call written-first (. fact instance) (. fact syntax) (. row instance) (. row site)))
        (= (. ([] adapters found) instance) (. fact instance))
        (= (. ([] adapters found) site) (. fact syntax))
      )
      (return)
    )
    (let made (. adapters length))
    (= ([] adapter-rows key) (as made U32))
    (let placed (only-if (call (. facts cast-place) (. fact from) (. fact to)) (if (. fact casts))))
    (let instance (if-expr placed (as (/rshift/ placed 32) InstanceId) no-instance))
    (if (!= instance no-instance)
      (call (. adapters append)
        (block
          (arg (call Adapter (. fact from) (. fact to) (. fact runs) instance (as (% (!! placed) 4294967296) SyntaxId)))
        )
      )
      (= (. ([] adapters made) fixed) true)
      (= (. ([] adapters made) shared) (call (. facts cast-shared) (. fact from) (. fact to)))
      (return)
    )
    (call (. adapters append) (call Adapter (. fact from) (. fact to) (. fact runs) (. fact instance) (. fact syntax)))
    (= (. ([] adapters made) made-instance) (. fact instance))
    (= (. ([] adapters made) made-site) (. fact syntax))
    (if (not binds)
      (let noted (call (. types closure-place) (. fact from)))
      (if (!= noted 0)
        (= (. ([] adapters made) site) (as (% noted 4294967296) SyntaxId))
        (= (. ([] adapters made) below) (>= noted 4294967296))
        (= (. ([] adapters made) fixed) true)
      )
    )
  )
  (fn-expr _ written-first Bool
    (param instance InstanceId)
    (param syntax SyntaxId)
    (param other InstanceId)
    (param site SyntaxId)
    ; Whether a place in one instance is written before a place in another: by module, then by
    ; where in it, then by the ranks of the instances.
    (case? (!= module apart)
      (< module apart)
    )
    (case? (!= syntax site)
      (< syntax site)
    )
    (default
      (< (call (. instances rank-of) instance) (call (. instances rank-of) other))
    )
    (where
      (lazy module (. ([] (. instances rows) instance) module))
      (lazy apart (. ([] (. instances rows) other) module))
    )
  )
  (fn-do _ reach-union-error _
    (param kinds (of CPointer U32))
    (param fact ConversionFact)
    ; Marks what an unwrapped union raises where it holds another case.
    (let unwraps (or (== (. fact kind) .relation-unwrap-cast) (== (. fact kind) .relation-down-cast)))
    (if (and unwraps (!= (. fact case-index) (. U32 max)) (!= (. fact to) (. types string-type)))
      (call mark kinds (. instances report panic))
      (call mark kinds (. instances report union-error))
      (call mark kinds (. instances report union-text))
    )
  )
  (fn-do _ reach-parts _
    (param kinds (of CPointer U32))
    (param first FactId)
    ; Marks what the conversions of the fields of a tuple or struct call and the witness tables
    ; they make, and those of the fields of any tuple or struct inside it, and the constructor of
    ; the panic a part that casts to a derived class or out of an interface raises.
    (let part first)
    (while (!= part no-fact)
      (let fact ([] (. facts conversion-parts) part))
      (call mark kinds (. fact callee))
      (if (or (== (. fact kind) .relation-down-cast) (== (. fact kind) .relation-interface-down-cast))
        (call mark kinds (. instances report panic))
      )
      (call reach-made-interface fact)
      (call reach-made kinds fact)
      (call reach-union-error kinds fact)
      (call reach-parts kinds (. fact parts))
      (= part (. fact next))
    )
  )
  (fn-do _ reach-made-interface _
    (param fact ConversionFact)
    ; Reaches the witness table of a value a conversion makes one of an interface.
    (if (== (. fact kind) .relation-interface-cast)
      (call reach-witness (. fact from) (. fact to))
    )
  )
  (fn-do _ writes-panics Bool
    (param instance InstanceId)
    ; Whether an instance is a constructor the compiler generates that raises panics it writes:
    ; of a table that grows in an arena, or of an index span of a range.
    (let row ([] (. instances rows) instance))
    (match? ([] (. ([] (. program modules) (. row module)) decls) (. row decl))
      (case (call .decl-function fn)
        (let grows
          (scope (or in-arena (== (. fn kind) .table-capacity-constructor-decl))
            (lazy in-arena (== (. fn kind) .table-arena-constructor-decl))
          )
        )
        (return (and (. fn is-generated) (or grows (== (. fn kind) .index-span-range-constructor-decl))))
      )
    )
    (return false)
  )
  (fn-do _ reach-call _
    (param kinds (of CPointer U32))
    (param fact CallFact)
    ; Marks the callee of a call an emitted instance makes where its code makes it.
    (if (call is-reference kinds (. fact instance) (. fact syntax))
      (call reach-made-call kinds fact)
    )
  )
  (fn-do _ reach-made-call _
    (param kinds (of CPointer U32))
    (param fact CallFact)
    ; Marks the callee of a call, made by the code of an instance or by the value of a global. A
    ; node the compiler answers itself makes none of the calls recorded at it but those it makes
    ; of a range that indexes a view. `super(…)` calls its callee's initializer, which the
    ; compiler writes nothing for when it generated the constructor. The body of a spawned task
    ; reports a panic that leaves it itself. One owned can be for a case's activation, whose case makes
    ; a `TaskOwner` the first time it is entered.
    (if (and (call is-intrinsic-plan (call (. facts plan-of) (. fact instance) (. fact syntax))) (!= (. fact form) .call-view-range))
      (return)
    )
    (if (call is-super-call fact)
      (if (call has-initializer (. fact callee))
        (= ([] initialized (. fact callee)) 1)
        (if (== ([] kinds (. fact callee)) (. Reach none))
          (= ([] kinds (. fact callee)) (. Reach initializer))
          (= ([] reach-queue reach-length) (. fact callee))
          (+= reach-length 1)
        )
      )
      (return)
    )
    (if (. fact propagates)
      (call mark kinds (. instances report source))
    )
    (if (call spawns-task (. fact form))
      (= owns-tasks (or owns-tasks (== (. fact form) .call-owned-task)))
      (if (== (. fact form) .call-owned-task)
        (call mark kinds (. facts task-owner-make))
      )
      (call reach-report kinds)
      (if (and (!= (. fact callee) no-instance) (!= (. ([] (. instances signatures) (. fact callee)) errors count) 0))
        (call reach-error-report kinds)
      )
    )
    (for (in offset (..< 0 (. fact through count)))
      (call mark kinds ([] (. facts step-callees) (+ (. fact through start) offset)))
    )
    (call reach-callee kinds (. fact callee))
  )
  (fn-do _ is-super-call Bool
    (param fact CallFact)
    ; Whether a call is `super(…)`: of a constructor, by the name of the receiver's base part.
    (if (or (!= (. fact form) .call-this-constructor) (== (. fact syntax) 0))
      (return false)
    )
    (let row ([] (. instances rows) (. fact instance)))
    (let tree (. ([] (. program modules) (. row module)) tree))
    (if (or (== (. row binding) no-binding) (>= (. fact syntax) (. tree nodes length)))
      (return false)
    )
    (match? ([] (. tree nodes) (. fact syntax))
      (case (call .node-call-expression call)
        (match? ([] (. tree nodes) (. call callable))
          (case .node-identifier
            (let resolution (call (. bindings resolution-of) (. row binding) (. call callable)))
            (if (== (. resolution kind) .resolve-slot)
              (return (== (. ([] (. bindings slots) (. resolution slot)) kind) .slot-super))
            )
          )
        )
      )
    )
    (return false)
  )
  (fn-do _ reach-callee _
    (param kinds (of CPointer U32))
    (param callee InstanceId)
    ; Marks the callee of a call. A constructor that builds its value where the call is joins
    ; the set to be visited, and is given no function. A function of an interface called
    ; through a value is given a slot in the interface's section of the witness tables; what
    ; fills the slot joins with each table.
    (if (and (!= callee no-instance) (call builds-in-frame callee))
      (if (== ([] kinds callee) (. Reach none))
        (= ([] kinds callee) (. Reach in-frame))
        (= ([] reach-queue reach-length) callee)
        (+= reach-length 1)
      )
      (return)
    )
    (if (and (!= callee no-instance) (!= ([] called-through callee) 0))
      (if (== ([] slots callee) no-slot-index)
        (let owner (. ([] (. instances rows) callee) self-type))
        (= ([] slots callee) ([] slot-counts owner))
        (+= ([] slot-counts owner) 1)
        (= prototypes (call (. prototypes appended) arena callee))
      )
      (return)
    )
    (call mark kinds callee)
  )
  (fn-do _ writes-own-constructor Bool
    (param module ModuleId)
    (param decl DeclId)
    (let owner ([] (. program modules) module))
    (match? ([] (. owner decls) decl)
      (case (call .decl-class class)
        (if (== (. class members count) 0)
          (return false)
        )
        (for (in member ([] (. owner member-pool) (. class members)))
          (match? ([] (. owner decls) member)
            (case (call .decl-function fn)
              (if (and (not (. fn is-generated)) (== (. fn kind) .constructor-decl))
                (return true)
              )
            )
          )
        )
      )
    )
    (return false)
  )
  (fn-do _ is-reference Bool
    (param kinds (of CPointer U32))
    (param instance InstanceId)
    (param syntax SyntaxId)
    ; Whether a fact of an emitted instance is one its code acts on. A main's facts inside
    ; declaration statements belong to what they declare, not to the main. The statements of a
    ; module start in the order they are written, and a statement's nodes run from where it
    ; starts to where the next one does: a branch links what follows it after it is made, so its
    ; own id is not its last. The last statement to start at or before a node is found by halving.
    ; The node is in it, or where a statement was made of those written before the ones after it
    ; were, as the cases of a state machine are, in an earlier one whose nodes reach it. A fact at
    ; the main's own node, as its call of `end-main` is, is the main's.
    (if (!= ([] kinds instance) (. Reach main))
      (return true)
    )
    (if (== syntax 0)
      (return false)
    )
    (let tree (. ([] (. program modules) (. ([] (. instances rows) instance) module)) tree))
    (if (== syntax (. tree root))
      (return true)
    )
    (match? ([] (. tree nodes) (. tree root))
      (case (call .node-top-level-syntax row)
        (let first (. row statements start))
        (let low U32)
        (let high U32 (. row statements count))
        (while (< low high)
          (let middle (/ (+ low high) 2))
          (if (>= syntax (call (. tree subtree-start) ([] (. tree children) (+ first middle))))
            (= low (+ middle 1))
            (else
              (= high middle)
            )
          )
        )
        (if (== low 0)
          (return false)
        )
        (let statement ([] (. tree children) (- (+ first low) 1)))
        (if (> syntax statement)
          (let position (- low 1))
          (while (!= position 0)
            (-= position 1)
            (let earlier ([] (. tree children) (+ first position)))
            (if (and (<= syntax earlier) (>= syntax (call (. tree subtree-start) earlier)))
              (return
                (call runs-statement
                  (block
                    (arg (. ([] (. instances rows) instance) module))
                    (arg (. ([] (. instances rows) instance) decl))
                    (arg tree)
                    (arg earlier)
                  )
                )
              )
            )
          )
        )
        (return
          (call runs-statement
            (block
              (arg (. ([] (. instances rows) instance) module))
              (arg (. ([] (. instances rows) instance) decl))
              (arg tree)
              (arg statement)
            )
          )
        )
      )
    )
    (return false)
  )
  (fn-do _ mark Bool
    (param kinds (of CPointer U32))
    (param callee InstanceId)
    ; Adds a callee to the emitted set, to be visited in its turn, and says whether anything was
    ; new. A C function is not emitted; its symbol is named for the calls to it. One that can
    ; reach the collector is called between checks for a terminating task, and brings the check
    ; that raises the termination panic.
    (if (== callee no-instance)
      (return false)
    )
    (let row ([] (. instances rows) callee))
    (let owner ([] (. program modules) (. row module)))
    (if (call (. owner name ends-with) ".h")
      (let added false)
      (match? ([] (. owner decls) (. row decl))
        (case (call .decl-function fn)
          (let name (. fn name))
          (if (and name (== ([] c-symbols callee) no-string))
            (= ([] c-symbols callee) (call (. bundle intern) (call (. program target symbol) (. name text))))
            (if (== (. name text) observer-activation-name)
              (= observes true)
            )
            (if (call suspends-task (. name text))
              (= ([] c-suspends callee) (if-expr (call leaves-termination (. name text)) 2 1))
              (= suspends true)
            )
            (= ([] c-described callee) (call describing name))
          )
          (if (or (== (/and/ (. fn effects) (. CompilationEffect gc-leaf)) 0) (!= ([] c-suspends callee) 0))
            (= added (call mark-termination kinds))
          )
        )
      )
      (return added)
    )
    (if (== ([] kinds callee) (. Reach in-frame))
      (= ([] kinds callee) (. Reach body))
      (return true)
    )
    (if (== ([] kinds callee) (. Reach initializer))
      (= ([] kinds callee) (. Reach body))
      (call construct kinds callee)
      (return true)
    )
    (if (!= ([] kinds callee) (. Reach none))
      (return false)
    )
    (= ([] kinds callee) (. Reach body))
    (= ([] reach-queue reach-length) callee)
    (+= reach-length 1)
    (return true)
  )
  (fn-do _ mark-termination Bool
    (param kinds (of CPointer U32))
    ; Adds the check a poll makes for a terminating task, and the panic it raises, to the emitted
    ; set. Says whether either was new.
    (let report (. instances report))
    (let added (call mark kinds (. report termination)))
    (if (call mark kinds (. report termination-error))
      (= added true)
    )
    (return added)
  )
  (fn-do _ reach-defaults _
    (param kinds (of CPointer U32))
    (param instance InstanceId)
    ; Marks what the property values of a constructed class call, and its rules.
    (if (not (call writes-defaults instance))
      (return)
    )
    (let type (. ([] (. instances rows) instance) self-type))
    (if (or (== type no-type) (== type invalid-type))
      (return)
    )
    (call reach-values kinds type)
    (call reach-rules kinds type)
  )
  (fn-do _ reach-rules _
    (param kinds (of CPointer U32))
    (param type TypeId)
    ; Marks what the rules a constructed class runs call: each rule is typed as an instance of
    ; its own, for the class that writes it, which is visited as one emitted in the frames of the
    ; constructor and of the function that runs it again, with the function that tells whether
    ; the value of a `whenever` rule has changed.
    (let level (? TypeId) type)
    (while level
      (for (in part (call class-parts (call class-ref types level)))
        (let owner ([] (. program modules) (. part module)))
        (for (in member ([] (. owner member-pool) (call class-part-members part)))
          (if (not (is ([] (. owner decls) member) .decl-rule))
            (continue)
          )
          (let unit (call (. instances find-initializer) (. part module) member level))
          (if (and (!= unit no-instance) (== ([] kinds unit) (. Reach none)))
            (= ([] kinds unit) (. Reach in-frame))
            (= ([] reach-queue reach-length) unit)
            (+= reach-length 1)
          )
          (if (!= unit no-instance)
            (call mark kinds (call (. facts change-test-of) unit))
            (call reach-trigger kinds unit)
          )
        )
      )
      (= level (call (. types base-of) level))
    )
  )
  (fn-do _ reach-trigger _
    (param kinds (of CPointer U32))
    (param unit InstanceId)
    ; Marks what a `whenever` rule on the markup an object is in calls besides its body: what makes
    ; and empties its changes and records one there, and the markup runtime's functions that
    ; register it and find a parent host, and the call that runs its action.
    (let trigger (call (. facts markup-trigger-of) unit))
    (if (not trigger)
      (return)
    )
    (let found trigger)
    (for (in callee (list (. found made) (. found clear) (. found record) (. found parent) (. found register) (. found schedule)))
      (if (!= callee no-instance)
        (call reach-callee kinds callee)
      )
    )
  )
  (fn-do _ reach-values _
    (param kinds (of CPointer U32))
    (param type TypeId)
    ; Marks what the values written for the properties of a type call, once for the type. Each
    ; value is an instance of its own, typed for the type: it joins the set to be visited, and
    ; is given no function. A property with no value written that holds a named tuple or struct
    ; has the first values of that type's fields, so those are marked with it, and one of another
    ; module's class has its construction typed by an instance of its own, visited alike.
    (let range (. ([] (. types completions) type) properties))
    (for (in position (..< 0 (. range count)))
      (let place (+ (. range start) position))
      (let property ([] (. types properties) place))
      (if (or (== (. property storage-kind) .storage-getter) (!= ([] default-rows place) (. U32 max)))
        (continue)
      )
      (let given (call default-of type place))
      (= ([] default-rows place) (as (. defaults length) U32))
      (call (. defaults append) given)
      (if (== (. given value) 0)
        (if (and (!= (. property type) no-type) (!= (. property type) invalid-type) (call holds-fields (. property type)))
          (call reach-values kinds (. property type))
        )
        (let made
          (scope (if-expr (!= (. given decl) 0) initializer no-instance)
            (lazy initializer (call (. instances find-initializer) (. given module) (. given decl) type))
          )
        )
        (if (and (!= made no-instance) (== ([] kinds made) (. Reach none)))
          (= ([] kinds made) (. Reach in-frame))
          (= ([] reach-queue reach-length) made)
          (+= reach-length 1)
        )
        (continue)
      )
      (let unit (call find-unit type place given))
      (= ([] value-units place) unit)
      (if (and (!= unit no-instance) (== ([] kinds unit) (. Reach none)))
        (= ([] kinds unit) (. Reach in-frame))
        (= ([] reach-queue reach-length) unit)
        (+= reach-length 1)
      )
    )
  )
  (fn-do _ holds-fields Bool
    (param type TypeId)
    ; Whether a type is a named tuple or struct, whose fields have first values of their own.
    (let kind (. ([] (. types completions) type) intrinsic))
    (if (and (!= kind .tuple) (!= kind .struct) (!= kind .array-builder))
      (return false)
    )
    (match? ([] (. types rows) type)
      (case .type-class
        (return true)
      )
    )
    (return false)
  )
  (fn-do _ reach-site _
    (param kinds (of CPointer U32))
    (param module ModuleId)
    (param site SyntaxId)
    ; Marks what the value written for a global calls and converts through, what its nodes
    ; bring, and what its checked reads of globals bring, whether or not its module's main is
    ; emitted. The value's facts are those of the main.
    (let main ([] main-instances module))
    (let first (call (. ([] (. program modules) module) tree subtree-start) site))
    (for (in node (..< first (+ site 1)))
      (let call (call (. facts first-call) main node))
      (while (!= call no-fact)
        (call reach-made-call kinds ([] (. facts calls) call))
        (= call (. ([] (. facts calls) call) next))
      )
      (let conversion (call (. facts first-conversion) main node))
      (while (!= conversion no-fact)
        (call reach-conversion kinds ([] (. facts conversions) conversion))
        (= conversion (. ([] (. facts conversions) conversion) next))
      )
      (call reach-node
        (block
          (arg kinds)
          (arg main)
          (arg node)
          (arg (call (. facts plan-of) main node))
          (arg (!= (call (. facts first-force) main node) no-fact))
        )
      )
    )
    (let use ([] use-heads main))
    (while (!= use no-fact)
      (let read ([] (. facts global-uses) use))
      (if (and (>= (. read syntax) first) (<= (. read syntax) site))
        (call reach-global kinds read)
      )
      (= use ([] use-links use))
    )
  )
  (fn-do _ reach-loop-panic _
    (param kinds (of CPointer U32))
    (param instance InstanceId)
    (param loop SyntaxId)
    ; Adds what a loop over a container calls where a function of the container's protocol
    ; raises an error: the panic the loop makes of it, and the text of the error. The calls
    ; are read where the type pass kept them, which for a feed is beside others.
    (let call (call (. facts first-call) instance loop))
    (while (!= call no-fact)
      (let callee (. ([] (. facts calls) call) callee))
      (if (and (!= callee no-instance) (!= (. ([] (. instances signatures) callee) errors count) 0))
        (call mark kinds (. instances report panic))
        (call mark kinds (. instances report error-text))
      )
      (= call (. ([] (. facts calls) call) next))
    )
  )
  (fn-do _ reach-enum _
    (param kinds (of CPointer U32))
    (param constant FactId)
    ; Marks a value of an enum that an emitted instance reads as one its module makes as it
    ; starts, and what making it calls and converts through.
    (if (== constant no-fact)
      (return)
    )
    (let bits (. ([] (. facts constants) constant) bits))
    (let module ModuleId (as (/ bits 4294967296) U32))
    (let decl DeclId (as (% bits 4294967296) U32))
    (if (or (>= module (. program modules length)) (>= decl (. ([] (. program modules) module) decls length)))
      (return)
    )
    (call reach-enum-value kinds module decl)
  )
  (fn-do _ reach-enum-value _
    (param kinds (of CPointer U32))
    (param module ModuleId)
    (param decl DeclId)
    ; Marks one value of an enum as made when its module starts, with what making it reaches.
    (let place (+ ([] storage-starts module) decl))
    (if (!= ([] global-kinds place) (. GlobalKind global-enum-unread))
      (return)
    )
    (= ([] global-kinds place) (. GlobalKind global-enum))
    (match? ([] (. ([] (. program modules) module) decls) decl)
      (case (call .decl-case case)
        (call reach-site kinds module (. case syntax))
      )
    )
  )
  (fn-do _ reach-enum-values _
    (param kinds (of CPointer U32))
    (param type TypeId)
    ; Marks every value an enum declares as made when its module starts: a number converted to
    ; the enum by its place may be any of them.
    (match? ([] (. types rows) type)
      (case (call .type-class class)
        (if (>= (. class module) (. program modules length))
          (return)
        )
        (let owner ([] (. program modules) (. class module)))
        (for (in decl (..< 0 (. owner decls length)))
          (match? ([] (. owner decls) decl)
            (case (call .decl-case case)
              (if (== (. case owner) (. class decl))
                (call reach-enum-value kinds (. class module) (as decl DeclId))
              )
            )
          )
        )
      )
    )
  )
  (fn-do _ reach-global _
    (param kinds (of CPointer U32))
    (param use GlobalUse)
    ; Marks what a checked read of a global brings: the constructor of the panic it raises, and
    ; for the first read of a lazy global the function that evaluates it, with what its value
    ; calls and the report of an error it lets out.
    (call mark kinds (. instances report panic))
    (let row (call storage-of (. use module) (. use decl)))
    (if (or (== row no-storage) (!= (call global-kind (. use module) (. use decl)) .global-lazy))
      (return)
    )
    (if (!= (. ([] storage row) function) no-function)
      (return)
    )
    (= (. ([] storage row) function) pending-function)
    (match? ([] (. ([] (. program modules) (. use module)) decls) (. use decl))
      (case (call .decl-property property)
        (call reach-site kinds (. use module) (. property syntax))
      )
    )
    (let unit (call (. instances find-initializer) (. use module) (. use decl) no-type))
    (if (and (!= unit no-instance) (!= (. ([] (. instances signatures) unit) errors count) 0))
      (call reach-error-report kinds)
    )
  )
  (fn-do _ writes-defaults Bool
    (param instance InstanceId)
    ; Whether an instance is a constructor that gives properties the values their class writes:
    ; one the compiler generates, or one written in source.
    (let row ([] (. instances rows) instance))
    (match? ([] (. ([] (. program modules) (. row module)) decls) (. row decl))
      (case (call .decl-function fn)
        (let generated (or (== (. fn kind) .default-constructor-decl) (== (. fn kind) .tuple-constructor-decl)))
        (return (or generated (== (. fn kind) .constructor-decl)))
      )
    )
    (return false)
  )
  (fn-do _ find-unit InstanceId
    (param type TypeId)
    (param place U32)
    (param given PropertyDefault)
    ; The instance that types the value written for a property of a type. A stored property's
    ; value is typed for each type that holds it. A lazy property of a class has one function,
    ; which the classes below share, and its value is typed for the class that writes it, as
    ; the type holds that class. So is a state machine a property of a class holds, whose
    ; functions the classes below share.
    (if (== (. given value) 0)
      (return no-instance)
    )
    (let property ([] (. types properties) place))
    (let receiver type)
    (let machine (!= (call (. ([] (. program modules) (. given module)) tree declared-machine) (. given value)) 0))
    (if (and (or (== (. property storage-kind) .storage-lazy) machine) (call is-class type))
      (let writer (call writer-of type property))
      (if (!= writer no-type)
        (= receiver writer)
      )
    )
    (return (call (. instances find-initializer) (. given module) (. given decl) receiver))
  )
  (fn-do _ property-default PropertyDefault
    (param type TypeId)
    (param name Atom)
    ; The value written for a property in the nearest class that declares it, from a class up
    ; through its bases: by the declaration of it that writes one, where the class has two. A
    ; property's row names the nearest class that declares it, so the search from there ends
    ; where it starts.
    (let current type)
    (while (!= current no-type)
      (match? ([] (. types rows) current)
        (case (call .type-class row)
          (let member (call valued-property program (. row module) (. row decl) name))
          (match? ([] (. ([] (. program modules) (. row module)) decls) member)
            (case (call .decl-property property)
              (if (!= member 0)
                (return (call PropertyDefault (. row module) (. property value) (. property syntax) member))
              )
            )
          )
        )
      )
      (= current (. ([] (. types completions) current) base))
    )
    (return (call PropertyDefault 0 0 0 0))
  )
  (fn-do _ facet-default PropertyDefault
    (param row TypeProperty)
    ; The value a facet writes for one of its properties.
    (let facets (. program facets))
    (let module ([] (. facets modules) (. row facet)))
    (let member (call valued-property program module ([] (. facets decls) (. row facet)) (. row name)))
    (match? ([] (. ([] (. program modules) module) decls) member)
      (case (call .decl-property property)
        (if (!= member 0)
          (return (call PropertyDefault module (. property value) (. property syntax) member))
        )
      )
    )
    (return (call PropertyDefault 0 0 0 0))
  )
  (fn-expr _ tuple-default PropertyDefault
    (param type TypeId)
    (param fields TypeId)
    (param name Atom)
    (call PropertyDefault (. tuple module) 0 (call written-field program tuple name) 0)
    (where
      (lazy tuple (call written-tuple types type fields))
    )
  )
  (fn-do _ build-class-tables _
    ; A table for each class the program constructs and for each of its bases. A class's own
    ; part of its table holds the functions emitted with that class as receiver that are chosen
    ; by the class of the object: every converter, and each method, getter and setter that some
    ; class declares again, in the order `member-order` gives them. A subclass's table repeats its base's part, so a slot means the same
    ; in both, and puts in a slot the function the subclass declares again, when that is emitted.
    ; Each lazy property has a slot too, in the part of the class that first declares it: it
    ; holds the function of the property for the table's class, or nothing for a class the
    ; program constructs no object of and that takes the value from no class it does. So has
    ; each interface an object of the class is converted to, in the part of the class first
    ; converted: it holds the witness table of the table's class for the interface.
    (let type-count U32 (as (. types rows length) U32))
    (let function-count U32 (as (. functions length) U32))
    (let instance-count U32 (as (. instances length) U32))
    (= table-symbols (call (of (. arena allocate) U32) type-count))
    (call name-type-constants type-count)
    (call build-property-tables type-count)
    (= table-indexes (call (of (. arena allocate) U32) type-count))
    (= first-members (call (of (. arena allocate) U32) type-count))
    (= next-members (call (of (. arena allocate) U32) function-count))
    (= raising (call (of (. arena allocate) Byte) (+ instance-count 1)))
    (= replacing (call (of (. arena allocate) U32) (+ instance-count 1)))
    (= adapting (call (of (. arena allocate) U32) (+ instance-count 1)))
    (for (in position (..< 0 type-count))
      (= ([] table-symbols position) no-string)
      (= ([] table-indexes position) (. U32 max))
      (= ([] first-members position) no-function)
    )
    (for (in position (..< 0 function-count))
      (= ([] next-members position) no-function)
    )
    (for (in position (..< 0 instance-count))
      (= ([] raising position) 0)
      (= ([] replacing position) no-function)
      (= ([] adapting position) no-function)
    )
    (let members (list U32))
    (for (in id (..< 0 function-count))
      (let instance (. ([] functions id) instance))
      (if (or (== instance no-instance) (!= (. ([] functions id) kind) .instance-body))
        (continue)
      )
      (let row ([] (. instances rows) instance))
      (if (and (call is-class (. row self-type)) (call holds-slot instance))
        (+= members id)
      )
    )
    (let ordered-members (call sort members (:using (=> (a b) (call member-order a b)))))
    (for (in offset (..< 0 (. ordered-members length)))
      (let id ([] ordered-members (- (. ordered-members length) 1 offset)))
      (let self-type (. ([] (. instances rows) (. ([] functions id) instance)) self-type))
      (= ([] next-members id) ([] first-members self-type))
      (= ([] first-members self-type) id)
    )
    (for (in id (..< 0 function-count))
      (let instance (. ([] functions id) instance))
      (if (or (== instance no-instance) (!= (. ([] functions id) kind) .instance-body))
        (continue)
      )
      (let row ([] (. instances rows) instance))
      (match? ([] (. ([] (. program modules) (. row module)) decls) (. row decl))
        (case (call .decl-function fn)
          (if (and (call constructs (. fn kind)) (call is-class (. row self-type)))
            (call table-for (. row self-type))
          )
        )
      )
    )
    (for (in index (..< 0 (. witnesses length)))
      (if (call is-class (. ([] witnesses index) value))
        (call table-for (. ([] witnesses index) value))
      )
    )
    (for (in pair (. facts dynamic-witnesses))
      (if (call is-class (. pair value))
        (call table-for (. pair value))
      )
    )
    (call build-witness-tables)
  )
  (fn-expr _ member-order Comparison
    (param function U32)
    (param other U32)
    ; Orders two functions of members of classes as their instances go (`declaration-order`).
    (call declaration-order (. ([] functions function) instance) (. ([] functions other) instance))
  )
  (fn-expr _ interface-order Comparison
    (param interface TypeId)
    (param other TypeId)
    (call ordered ([] (. types stable-keys) interface) ([] (. types stable-keys) other))
  )
  (fn-expr _ declaration-order Comparison
    (param instance InstanceId)
    (param other InstanceId)
    ; Orders two instances by the module and the declaration of each, and then by their stable
    ; keys, an order that does not depend on the order typing made them in.
    (case? (!= (. row module) (. against module))
      (call ordered (. row module) (. against module))
    )
    (case? (!= (. row decl) (. against decl))
      (call ordered (. row decl) (. against decl))
    )
    (default
      (call ordered (call instance-key instance) (call instance-key other))
    )
    (where
      (lazy row ([] (. instances rows) instance))
      (lazy against ([] (. instances rows) other))
    )
  )
  (fn-do _ order-prototypes _
    ; Numbers the slots that the section of each interface gives its functions called through a
    ; value, which reaching them numbered in the order it met them, in the order of their
    ; declarations instead (`declaration-order`), and lists them so.
    (let listed (list InstanceId))
    (for (in position (..< 0 (. prototypes length)))
      (+= listed ([] prototypes position))
    )
    (let ordered-protos (call sort listed (:using (=> (a b) (call declaration-order a b)))))
    (for (in proto ordered-protos)
      (= ([] slot-counts (. ([] (. instances rows) proto) self-type)) 0)
    )
    (= prototypes (call new-id-list arena 4))
    (for (in proto ordered-protos)
      (let owner (. ([] (. instances rows) proto) self-type))
      (= ([] slots proto) ([] slot-counts owner))
      (+= ([] slot-counts owner) 1)
      (= prototypes (call (. prototypes appended) arena proto))
    )
  )
  (fn-do _ proto-place U32
    (param start U32)
    (param proto U32)
    ; Where among the entries of a table being built, from `start`, one stands for a prototype.
    (for (in position (..< start (. table-entries length)))
      (if (== ([] table-protos position) proto)
        (return (- position start))
      )
    )
    (return no-slot-index)
  )
  (fn-do _ holds-slot Bool
    (param instance InstanceId)
    ; Whether an emitted instance with a class as receiver has a slot of its own in that
    ; class's table: a converter, or a method, getter or setter that some class declares again.
    (let row ([] (. instances rows) instance))
    (match? ([] (. ([] (. program modules) (. row module)) decls) (. row decl))
      (case .decl-converter
        (return true)
      )
      (case (call .decl-function fn)
        (let member (or (== (. fn kind) .function-decl) (== (. fn kind) .getter-decl) (== (. fn kind) .setter-decl)))
        (return (and member (not (. fn is-static)) (!= (. fn owner) 0) (!= ([] overridden instance) 0)))
      )
    )
    (return false)
  )
  (fn-do _ replace-for _
    (param type TypeId)
    (param placed Bool)
    ; Places beside each function the one a class declares in its place, and the function that
    ; converts what that answers where one is made, so that the slots a class inherits are
    ; filled without reading the class's overrides for each, or takes them away again.
    (let made ([] class-override-heads type))
    (while (!= made no-fact)
      (let fact ([] (. facts overrides) made))
      (let own
        (block
          (case? (!= (. fact override) no-instance)
            ([] instance-functions (. fact override))
          )
          (default
            ([] override-adapters made)
          )
        )
      )
      (= ([] replacing (. fact base)) (if-expr placed own no-function))
      (= ([] adapting (. fact base)) (if-expr placed ([] override-adapters made) no-function))
      (= made ([] class-override-links made))
    )
  )
  (fn-do _ agrees Bool
    (param proto InstanceId)
    (param entry FunctionId)
    ; Whether a function can answer in a slot made for another: it takes as many arguments, and
    ; each of them and what it returns is held as the other's is.
    (let other (. ([] functions entry) instance))
    (let mine ([] (. instances signatures) proto))
    (let theirs ([] (. instances signatures) other))
    (if (!= (. mine args count) (. theirs args count))
      (return false)
    )
    (if (!= ([] (. layouts values) (. mine returns)) ([] (. layouts values) (. theirs returns)))
      (return false)
    )
    (for (in position (..< 0 (. mine args count)))
      (let held ([] (. layouts values) (call (. instances argument-type) proto position)))
      (if (!= held ([] (. layouts values) (call (. instances argument-type) other position)))
        (return false)
      )
    )
    (return true)
  )
  (fn-do _ runs-polling-rule Bool
    (param instance InstanceId)
    ; Whether a constructor of a class, or the function that fills an object with its class's
    ; markup, first runs a rule of the class whose body has a loop that polls: the rule's body
    ; runs in that function then.
    (let row ([] (. instances rows) instance))
    (if (not (call is-class (. row self-type)))
      (return false)
    )
    (let rules (list U32))
    (match? ([] (. ([] (. program modules) (. row module)) decls) (. row decl))
      (case (call .decl-function fn)
        (if (call constructs (. fn kind))
          (= rules (call class-rules-of (. row self-type)))
          (else-if (. fn is-content)
            (= rules (call markup-rules-of (. row self-type)))
          )
        )
      )
    )
    (for (in index rules)
      (let unit (. ([] class-rules index) unit))
      (if (and (!= unit no-instance) (. ([] (. instances rows) unit) polls))
        (return true)
      )
    )
    (return false)
  )
  (fn-expr _ constructs Bool
    (param kind DeclKind)
    (or (== kind .constructor-decl) (== kind .default-constructor-decl) (== kind .cast-constructor-decl))
  )
  (fn-do _ table-for U32
    (param type TypeId)
    ; The table of a class, built after its base's.
    (if (!= ([] table-indexes type) (. U32 max))
      (return ([] table-indexes type))
    )
    (let base (. ([] (. types completions) type) base))
    (let base-index (. U32 max))
    (if (and (!= base no-type) (call is-class base))
      (= base-index (call table-for base))
    )
    (let start U32 (. table-entries length))
    (if (!= base-index (. U32 max))
      (let inherited (. ([] class-tables base-index) entries))
      (call replace-for type true)
      (for (in position (..< (. inherited start) (. inherited end)))
        (let proto ([] table-protos position))
        (let entry no-function)
        (if (>= proto lazy-proto)
          (let root (- proto lazy-proto))
          (let mine (call place-of-fact type ([] (. types properties) root)))
          (if (and (!= mine (. U32 max)) (== (. ([] (. types properties) mine) storage-kind) .storage-lazy))
            (= ([] lazy-slots mine) (- position (. inherited start)))
            (= ([] lazy-roots mine) root)
            (= entry ([] lazy-functions mine))
          )
          (if (== entry no-function)
            (= entry ([] table-entries position))
          )
          (if (and (!= entry no-function) (. ([] functions entry) may-panic))
            (= ([] lazy-raising root) 1)
          )
          (call note-lazy-result root entry)
          (else-if (>= proto witness-proto)
            (= entry (call witness-of type (- proto witness-proto)))
            (if (!= entry no-slot-index)
              (= (. ([] witnesses entry) slot) (- position (. inherited start)))
            )
          )
          (else
            (= entry ([] replacing proto))
            (if (== entry no-function)
              (= entry ([] table-entries position))
              (else
                (= (. ([] functions entry) carries) true)
                (let adapted ([] adapting proto))
                (if (!= adapted no-function)
                  (= entry adapted)
                  (else-if (not (call agrees proto entry))
                    (let row ([] (. instances rows) (. ([] functions entry) instance)))
                    (call (. refusals append)
                      (block
                        (arg
                          (call Refusal
                            (block
                              (arg .refused-function)
                              (arg (. row module))
                              (arg (- (+ (. row subtree start) (. row subtree count)) 1))
                            )
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
            (if (. ([] functions entry) may-panic)
              (= ([] raising proto) 1)
            )
          )
        )
        (= table-entries (call (. table-entries appended) arena entry))
        (= table-protos (call (. table-protos appended) arena proto))
      )
      (call replace-for type false)
    )
    (let member ([] first-members type))
    (while (!= member no-function)
      (= ([] slots (. ([] functions member) instance)) (- (. table-entries length) start))
      (= (. ([] functions member) carries) true)
      (if (. ([] functions member) may-panic)
        (= ([] raising (. ([] functions member) instance)) 1)
      )
      (= table-entries (call (. table-entries appended) arena member))
      (= table-protos (call (. table-protos appended) arena (. ([] functions member) instance)))
      (= member ([] next-members member))
    )
    (let range (. ([] (. types completions) type) properties))
    (for (in offset (..< 0 (. range count)))
      (let place (+ (. range start) offset))
      (if (or (!= (. ([] (. types properties) place) storage-kind) .storage-lazy) (!= ([] lazy-slots place) no-slot-index))
        (continue)
      )
      (= ([] lazy-slots place) (- (. table-entries length) start))
      (= ([] lazy-roots place) place)
      (let written ([] lazy-functions place))
      (if (and (!= written no-function) (. ([] functions written) may-panic))
        (= ([] lazy-raising place) 1)
      )
      (call note-lazy-result place written)
      (= table-entries (call (. table-entries appended) arena written))
      (= table-protos (call (. table-protos appended) arena (+ lazy-proto place)))
    )
    (let interfaces (list TypeId))
    (for (in index (..< 0 (. witnesses length)))
      (if (and (== (. ([] witnesses index) value) type) (== (. ([] witnesses index) slot) no-slot-index))
        (+= interfaces (. ([] witnesses index) interface))
      )
    )
    (for (in pair (. facts dynamic-witnesses))
      (if (and (== (. pair value) type) unslotted (== (call (. interfaces find) (. pair interface)) null))
        (+= interfaces (. pair interface))
      )
      (lazy unslotted (== (call proto-place start (+ witness-proto (. pair interface))) no-slot-index))
    )
    (let ordered-interfaces (call sort interfaces (:using (=> (a b) (call interface-order a b)))))
    (for (in interface ordered-interfaces)
      (let entry (call witness-of type interface))
      (if (and (!= entry no-slot-index) (== (. ([] witnesses entry) slot) no-slot-index))
        (= (. ([] witnesses entry) slot) (- (. table-entries length) start))
        (= table-entries (call (. table-entries appended) arena entry))
        (else
          (= table-entries (call (. table-entries appended) arena no-function))
        )
      )
      (= table-protos (call (. table-protos appended) arena (+ witness-proto interface)))
    )
    (let key (call hex-text ([] (. types stable-keys) type)))
    (let symbol (call (. bundle intern) (str "ctable." key)))
    (let index U32 (as (. class-tables length) U32))
    (call (. class-tables append) (call ClassTable type symbol base-index (call Span start (- (. table-entries length) start))))
    (= ([] table-indexes type) index)
    (= ([] table-symbols type) symbol)
    (blank)
    (let rtti (call name-type-constant type))
    (call add-type-constant type)
    (let first U32 (as (. bundle constant-items length) U32))
    (if (!= base-index (. U32 max))
      (call (. bundle constant-items append) (call ConstantItem .label-constant 0 (. ([] class-tables base-index) symbol)))
      (else
        (call (. bundle constant-items append) (call ConstantItem .quad-constant 0 no-string))
      )
    )
    (call (. bundle constant-items append) (call ConstantItem .label-constant 0 rtti))
    (for (in position (..< start (. table-entries length)))
      (let proto ([] table-protos position))
      (if (== ([] table-entries position) no-function)
        (call (. bundle constant-items append) (call ConstantItem .quad-constant 0 no-string))
        (else-if (and (>= proto witness-proto) (< proto lazy-proto))
          (call (. bundle constant-items append)
            (block
              (arg (call ConstantItem .label-constant 0 (. ([] witnesses ([] table-entries position)) symbol)))
            )
          )
        )
        (else
          (let entry (. ([] functions ([] table-entries position)) symbol))
          (call (. bundle constant-items append) (call ConstantItem .label-constant 0 entry))
        )
      )
    )
    (let count U32 (as (- (. bundle constant-items length) first) U32))
    (call (. bundle constant-tables append) (call ConstantTable symbol 8 (call Span first count)))
    (return index)
  )
  (fn-do _ build-witness-tables _
    ; The constant of each witness table: a section for the interface and for each it is
    ; derived from, each the type's name and key, the function that compares two values of the
    ; type or nothing, the table of the type's class or nothing, and a slot for each prototype
    ; of the section's interface, which holds what answers it for the type. A slot the
    ; interface's own function fills is called through the table, so that function writes the
    ; panic signal. In the section of an interface the table's own is derived from, the slot
    ; holds the function that runs it as the type does, where the type pass noted one, and has
    ; no shape without one where the function may panic. Nor has a table of an interface that
    ; reaches another by two ways, whose sections a value seen as one of them does not find
    ; where its own table has them.
    (for (in index (..< 0 (. witnesses length)))
      (let row ([] witnesses index))
      (let rtti (call name-type-constant (. row value)))
      (call add-type-constant (. row value))
      (let order (list TypeId))
      (call gather-sections (. row interface) order)
      (let seen (list TypeId))
      (let shared (call reaches-twice (. row interface) seen))
      (if shared
        (call refuse-table (. row interface))
      )
      (let first U32 (as (. bundle constant-items length) U32))
      (for (in section order)
        (call (. bundle constant-items append) (call ConstantItem .label-constant 0 rtti))
        (if (!= ([] equality-functions index) no-function)
          (call (. bundle constant-items append)
            (block
              (arg (call ConstantItem .label-constant 0 (. ([] functions ([] equality-functions index)) symbol)))
            )
          )
          (else
            (call (. bundle constant-items append) (call ConstantItem .quad-constant 0 no-string))
          )
        )
        (if (and (call is-class (. row value)) (!= ([] table-symbols (. row value)) no-string))
          (call (. bundle constant-items append) (call ConstantItem .label-constant 0 ([] table-symbols (. row value))))
          (else
            (call (. bundle constant-items append) (call ConstantItem .quad-constant 0 no-string))
          )
        )
        (for (in position (..< 0 (. prototypes length)))
          (let proto ([] prototypes position))
          (if (!= (. ([] (. instances rows) proto) self-type) section)
            (continue)
          )
          (let made (?? ([] witness-made (call pair-key (. row value) proto)) own-function))
          (if (and (== made own-function) (!= section (. row interface)))
            (= made (?? ([] witness-based (call pair-key (. row value) proto)) own-function))
          )
          (let target
            (scope (if-expr (== made own-function) ([] instance-functions proto) witness-function)
              (lazy witness-function (. ([] witness-functions made) function))
            )
          )
          (if (and (== made own-function) (!= target no-function))
            (= (. ([] functions target) carries) true)
            (let written ([] (. instances rows) proto))
            (if (or shared (not (call is-class (. row value))) (and (!= section (. row interface)) (. written may-panic)))
              (call (. refusals append)
                (block
                  (arg
                    (call Refusal
                      (block
                        (arg .refused-function)
                        (arg (. written module))
                        (arg (- (+ (. written subtree start) (. written subtree count)) 1))
                      )
                    )
                  )
                )
              )
            )
          )
          (if (== target no-function)
            (call (. bundle constant-items append) (call ConstantItem .quad-constant 0 no-string))
            (else
              (call (. bundle constant-items append)
                (block
                  (arg (call ConstantItem .label-constant 0 (. ([] functions target) symbol)))
                )
              )
            )
          )
        )
      )
      (let count U32 (as (- (. bundle constant-items length) first) U32))
      (call (. bundle constant-tables append) (call ConstantTable (. row symbol) 8 (call Span first count)))
    )
  )
  (fn-do _ name-type-constants _
    (param type-count U32)
    ; Names the constant of each type some value is the type of: a worker reads the name, and
    ; the constant is added after the workers for the types their code named.
    (= rtti-symbols (call (of (. arena allocate) U32) (+ type-count 1)))
    (= rtti-states (call (of (. arena allocate) Byte) (+ type-count 1)))
    (for (in position (..< 0 type-count))
      (= ([] rtti-symbols position) no-string)
      (= ([] rtti-states position) 0)
    )
    (for (in position (. types ranked))
      (let completion ([] (. types completions) position))
      (if (and (== (. completion completion) .completion-done) (== (. completion intrinsic) .type-info))
        (match? ([] (. types rows) position)
          (case (call .type-class row)
            (if (== (. row args count) 1)
              (call name-type-constant (call (. types child-type) (. row args) 0))
            )
          )
        )
      )
    )
  )
  (fn-do _ build-property-tables _
    (param type-count U32)
    (= property-tables (call (of (. arena allocate) U32) (+ type-count 1)))
    (for (in position (..< 0 (+ type-count 1)))
      (= ([] property-tables position) no-string)
    )
    (let reflected (call (of (. arena allocate) Byte) (+ type-count 1)))
    (for (in position (..< 0 (+ type-count 1)))
      (= ([] reflected position) 0)
    )
    (let marked (list TypeId))
    (for (in read (. facts property-reads))
      (if (or (== read no-type) (== read invalid-type))
        (continue)
      )
      (if (== (. ([] (. types completions) read) intrinsic) .interface)
        (for (in type (. types ranked))
          (if (and (call is-class type) (call answers-interface type read))
            (call mark-properties type reflected marked)
          )
        )
        (else-if (call is-class read)
          (for (in type (. types ranked))
            (if (or (== type read) (and (call is-class type) (call derives type read)))
              (call mark-properties type reflected marked)
            )
          )
        )
        (else
          (call mark-properties read reflected marked)
        )
      )
    )
    (let position 0)
    (while (< position (. marked length))
      (let type ([] marked position))
      (+= position 1)
      (let range (. ([] (. types completions) type) properties))
      (for (in offset (..< 0 (. range count)))
        (let place (+ (. range start) offset))
        (if (!= (. (call reflected-field type place) layout) no-layout)
          (let held (. ([] (. types properties) place) type))
          (if (call intrinsic-is-tuple-like (. ([] (. types completions) held) intrinsic))
            (call mark-properties held reflected marked)
          )
        )
      )
    )
    (for (in type (. types ranked))
      (if (!= ([] reflected type) 0)
        (= ([] property-tables type) (call (. bundle intern) (str "props." (call hex-text ([] (. types stable-keys) type)))))
      )
    )
    (for (in type (. types ranked))
      (if (!= ([] property-tables type) no-string)
        (call add-property-table type)
      )
    )
  )
  (fn-do _ mark-properties _
    (param type TypeId)
    (param reflected (of CPointer Byte))
    (param marked (list TypeId))
    (if (!= ([] reflected type) 0)
      (return)
    )
    (if (call is-class type)
      (if (== ([] (. layouts objects) type) no-layout)
        (return)
      )
      (else-if (not (call intrinsic-is-tuple-like (. ([] (. types completions) type) intrinsic)))
        (return)
      )
      (else-if (or (== ([] (. layouts values) type) no-layout) (not (call (. layouts is-struct) ([] (. layouts values) type))))
        (return)
      )
    )
    (= ([] reflected type) 1)
    (+= marked type)
  )
  (fn-do _ answers-interface Bool
    (param type TypeId)
    (param interface TypeId)
    (let current type)
    (while (and (!= current no-type) (!= current invalid-type))
      (if (== current interface)
        (return true)
      )
      (for (in implemented (call (. types interfaces-of) current))
        (if (call answers-interface implemented interface)
          (return true)
        )
      )
      (= current (. ([] (. types completions) current) base))
    )
    (return false)
  )
  (fn-expr _ reflected-field LayoutField
    (param type TypeId)
    (param place Index)
    (case? (or (!= (. property storage-kind) .storage-eager) (== (. property slot) (. U32 max)))
      none
    )
    (case? (or (== (. property type) no-type) (== (. property type) invalid-type))
      none
    )
    (case? (call is-class type)
      (call (. layouts field) ([] (. layouts objects) type) (+ object-header-fields (. property slot)))
    )
    (default
      (call (. layouts field) ([] (. layouts values) type) (. property slot))
    )
    (where
      (lazy property ([] (. types properties) place))
      (lazy none (call LayoutField 0 no-layout))
    )
  )
  (fn-do _ add-property-table _
    (param type TypeId)
    (let key (call hex-text ([] (. types stable-keys) type)))
    (let range (. ([] (. types completions) type) properties))
    (let names (list StringId))
    (for (in offset (..< 0 (. range count)))
      (let place (+ (. range start) offset))
      (if (!= (. (call reflected-field type place) layout) no-layout)
        (let property ([] (. types properties) place))
        (+= names (call add-literal (str "props.name." key "." (. names length)) (. property name text)))
        (call name-type-constant (. property type))
        (call add-type-constant (. property type))
      )
    )
    (let first U32 (as (. bundle constant-items length) U32))
    (call (. bundle constant-items append) (call ConstantItem .quad-constant (as (. names length) U64) no-string))
    (let listed 0)
    (for (in offset (..< 0 (. range count)))
      (let place (+ (. range start) offset))
      (let field (call reflected-field type place))
      (if (== (. field layout) no-layout)
        (continue)
      )
      (let held (. ([] (. types properties) place) type))
      (call (. bundle constant-items append) (call ConstantItem .label-constant 0 ([] names listed)))
      (call (. bundle constant-items append) (call ConstantItem .label-constant 0 ([] rtti-symbols held)))
      (call (. bundle constant-items append) (call ConstantItem .quad-constant (. field offset) no-string))
      (call (. bundle constant-items append)
        (block
          (arg (call ConstantItem .quad-constant (. ([] (. layouts rows) (. field layout)) size) no-string))
        )
      )
      (call (. bundle constant-items append) (call ConstantItem .quad-constant (call property-kind held) no-string))
      (+= listed 1)
    )
    (let count U32 (as (- (. bundle constant-items length) first) U32))
    (call (. bundle constant-tables append) (call ConstantTable ([] property-tables type) 8 (call Span first count)))
  )
  (fn-expr _ property-kind U64
    (param type TypeId)
    (case? (call intrinsic-is-tuple-like kind)
      0
    )
    (case? (== kind .bool)
      4
    )
    (case? (call intrinsic-is-float kind)
      1
    )
    (case? (call is-integer-kind kind)
      (if-expr (. ([] (. types completions) type) is-signed) 2 3)
    )
    (case? (or (call intrinsic-is-class kind) (== kind .string))
      5
    )
    (default
      6
    )
    (where
      (lazy kind (. ([] (. types completions) type) intrinsic))
    )
  )
  (fn-do _ name-type-constant StringId
    (param type TypeId)
    (if (or (== type no-type) (== type invalid-type))
      (return no-string)
    )
    (if (== ([] rtti-symbols type) no-string)
      (= ([] rtti-symbols type) (call (. bundle intern) (str "rtti." (call hex-text ([] (. types stable-keys) type)))))
    )
    (return ([] rtti-symbols type))
  )
  (fn-do _ add-type-constant _
    (param type TypeId)
    (if (== ([] rtti-states type) 2)
      (return)
    )
    (= ([] rtti-states type) 2)
    (let key (call hex-text ([] (. types stable-keys) type)))
    (let short-name (call add-literal (str "rtti.name." key) (call type-runtime-name types type)))
    (let key-name (call add-literal (str "rtti.key." key) (call type-runtime-key types type)))
    (let first U32 (as (. bundle constant-items length) U32))
    (call (. bundle constant-items append) (call ConstantItem .label-constant 0 short-name))
    (call (. bundle constant-items append) (call ConstantItem .label-constant 0 key-name))
    (if (!= ([] property-tables type) no-string)
      (call (. bundle constant-items append) (call ConstantItem .label-constant 0 ([] property-tables type)))
      (else
        (call (. bundle constant-items append) (call ConstantItem .quad-constant 0 no-string))
      )
    )
    (call (. bundle constant-tables append) (call ConstantTable ([] rtti-symbols type) 8 (call Span first 3)))
  )
  (fn-do _ add-literal StringId
    (param name String)
    (param text String)
    ; A string the object's tables point at, with the header a string of the program has.
    (let symbol (call (. bundle intern) name))
    (let bytes (call (. bundle copy-bytes) (call ByteSpan text (. text size))))
    (let header (call measure-string bytes))
    (call (. bundle literals append) (call StringLiteral symbol (. header character-length) (. header flags) bytes))
    (return symbol)
  )
  (fn-do _ instance-display String
    (param instance InstanceId)
    ; The name a stack trace prints for an instance's function, as the TypeScript compiler
    ; spells it: the module, the owner when there is one, and the function's own name; the
    ; function that fills an object with the markup of a class is `content`, numbered.
    (let row ([] (. instances rows) instance))
    (let owner-module ([] (. program modules) (. row module)))
    (let prefix (. owner-module name))
    (match? ([] (. owner-module decls) (. row decl))
      (case (call .decl-function fn)
        (if (== (. fn kind) .termination-panic-decl)
          (return (str prefix ":task-termination-panic"))
        )
        (if (== (. fn kind) .machine-decl)
          (return (str prefix ":state-machine"))
        )
        (if (or (call is-closure-like (. fn kind)) (== (. fn kind) .task-decl) (== (. fn kind) .region-decl))
          (return (str prefix ":" (call callee-name instance)))
        )
        (if (and (!= (call rule-match program (. row module) (. row decl)) 0) (. fn name))
          (let fn-name (. fn name))
          (let rank (?? ([] made-ranks instance) 1))
          (let number (if-expr (< rank 2) "" (str rank)))
          (return (str prefix ":" (. fn-name text) "-direct" number "-direct"))
        )
        (if (. fn is-content)
          (let rank (?? ([] made-ranks instance) 1))
          (let number (if-expr (< rank 2) "" (str rank)))
          (return (str prefix ":content" number))
        )
        (let owner (call owner-name owner-module (. fn owner)))
        (let qualified (if-expr (!= owner "") (str prefix ":" owner) prefix))
        (if (. fn is-generated)
          (let generated (str qualified ":" owner))
          (if (== (. fn kind) .tuple-constructor-decl)
            (= generated (str generated ":tuple"))
            (for (in position (..< 0 (. ([] (. instances signatures) instance) args count)))
              (= generated (str generated ":" position))
            )
          )
          (return generated)
        )
        (let name (. fn name))
        (if name
          (return (str qualified ":" (. name text)))
        )
      )
      (case (call .decl-converter converter)
        (let owner (call owner-name owner-module (. converter owner)))
        (let qualified (if-expr (!= owner "") (str prefix ":" owner) prefix))
        (return (str qualified ":" (call converter-name (. row module) (. row decl))))
      )
      (case (call .decl-fromverter fromverter)
        (let owner (call owner-name owner-module (. fromverter owner)))
        (let qualified (if-expr (!= owner "") (str prefix ":" owner) prefix))
        (return (str qualified ":" (call converter-name (. row module) (. row decl))))
      )
    )
    (return (str prefix ":?"))
  )
  (fn-do _ callee-name String
    (param instance InstanceId)
    ; The name of an instance's function alone. A closure's is the variable it is written for,
    ; numbered where it is not the first closure of that name; the functions generated for
    ; comprehensions, lists of feeds and the right sides of pipes are named and numbered so.
    (if (== instance no-instance)
      (return "?")
    )
    (let row ([] (. instances rows) instance))
    (match? ([] (. ([] (. program modules) (. row module)) decls) (. row decl))
      (case (call .decl-function fn)
        (if (or (== (. fn kind) .task-decl) (== (. fn kind) .region-decl))
          (let task (if-expr (== (. fn kind) .task-decl) (call task-name instance) "GCFreeRegion"))
          (let numbered (?? ([] closure-ranks (call closure-key (. row module) (. row decl) (. row enclosing))) 1))
          (return (if-expr (> numbered 1) (str task numbered) task))
        )
        (if (call is-closure-like (. fn kind))
          (let name
            (call closure-name
              (block
                (arg program)
                (arg (. row module))
                (arg (. row decl))
                (arg (call closure-property (. row module) (. row decl) (. row enclosing)))
              )
            )
          )
          (let rank (?? ([] closure-ranks (call closure-key (. row module) (. row decl) (. row enclosing))) 1))
          (if (and (> rank 1) (== (. fn kind) .pipeline-decl))
            (return (str "(pipeline" rank ")"))
          )
          (return (if-expr (> rank 1) (str name rank) name))
        )
        (if (. fn name)
          (return (. fn name text))
        )
      )
    )
    (return "?")
  )
  (fn-do _ owner-name String
    (param owner-module Module)
    (param owner DeclId)
    (if (!= owner 0)
      (match? ([] (. owner-module decls) owner)
        (case (call .decl-class class)
          (return (. class name text))
        )
      )
    )
    (return "")
  )
  (fn-expr _ converter-name String
    (param module ModuleId)
    (param decl DeclId)
    ; The name of a converter: `to` or `from` and the type, numbered where it is not the first
    ; of that name.
    (if-expr (> suffix 1) (str base suffix) base)
    (where
      (lazy base (?? (call converter-base ([] (. program modules) module) decl) "?"))
      (lazy suffix (?? ([] converter-suffixes (call closure-key module decl 0)) 1))
    )
  )
  (fn-do _ converter-base (? String)
    (param owner-module Module)
    (param decl DeclId)
    (match? ([] (. owner-module decls) decl)
      (case (call .decl-converter converter)
        (return (str "to " (call type-name (. owner-module tree) (. converter target-type))))
      )
      (case (call .decl-fromverter fromverter)
        (return (str "from " (call type-name (. owner-module tree) (. fromverter source-type))))
      )
    )
    (return null)
  )
  (fn-do _ number-converters _
    ; Numbers the converters that share a name as TypeScript claims their names when it declares
    ; them: module by module in the order it declares them, and in each in the order they are
    ; written. A name claimed already takes the next number after the last that name took that no
    ; name has.
    (let next (map String U32))
    (let claimed (map String Bool))
    (for (in module (. program declare-order))
      (let owner-module ([] (. program modules) module))
      (for (in decl (..< 0 (. owner-module decls length)))
        (let found (call converter-base owner-module (as decl DeclId)))
        (if (not found)
          (continue)
        )
        (let base found)
        (let suffix (?? ([] next base) 1))
        (let name (if-expr (> suffix 1) (str base suffix) base))
        (while (?? ([] claimed name) false)
          (+= suffix 1)
          (= name (str base suffix))
        )
        (= ([] next base) (+ suffix 1))
        (= ([] claimed name) true)
        (= ([] converter-suffixes (call closure-key module (as decl DeclId) 0)) suffix)
      )
    )
  )
  (fn-do _ type-name String
    (param tree AST)
    (param syntax SyntaxId)
    ; A type as TypeScript's `getTypeName` writes it in the name of a converter.
    (if (== syntax 0)
      (return "")
    )
    (match? ([] (. tree nodes) syntax)
      (case (call .node-type-identifier row)
        (return (. row name text))
      )
      (case (call .node-core-type-identifier row)
        (return (. row name text))
      )
      (case (call .node-type-arguments row)
        (let written (call type-name tree (. row base)))
        (for (in arg ([] (. tree children) (. row args)))
          (= written (str written "'" (call type-name tree arg)))
        )
        (return written)
      )
      (case (call .node-type-associated row)
        (let written (str (call type-name tree (. row owner)) "." (. row name text)))
        (for (in arg ([] (. tree children) (. row args)))
          (= written (str written "'" (call type-name tree arg)))
        )
        (return written)
      )
      (case (call .node-type-match row)
        (return (call type-name tree (. row type)))
      )
      (case (call .node-type-capture row)
        (return (call type-name tree (. row type)))
      )
      (case (call .node-type-tuple row)
        (let kind (if-expr (. row is-struct) "struct" "tuple"))
        (return (str kind "(" (call type-names tree (. row field-types)) ")"))
      )
      (case (call .node-type-list row)
        (return (str "list(" (call type-names tree (. row patterns)) ")"))
      )
    )
    (return "")
  )
  (fn-do _ type-names String
    (param tree AST)
    (param syntaxes (of RowRange SyntaxId))
    (let written "")
    (let first true)
    (for (in syntax ([] (. tree children) syntaxes))
      (if (not first)
        (= written (str written ","))
      )
      (= written (str written (call type-name tree syntax)))
      (= first false)
    )
    (return written)
  )
  (fn-do _ runs-statements Bool
    (param module ModuleId)
    (let tree (. ([] (. program modules) module) tree))
    (match? ([] (. tree nodes) (. tree root))
      (case (call .node-top-level-syntax row)
        (for (in statement ([] (. tree children) (. row statements)))
          (if (call runs-statement module 0 tree statement)
            (return true)
          )
        )
      )
    )
    (return false)
  )
  (fn-do _ refuse-global-initializers _
    (param module ModuleId)
    (param main InstanceId)
    ; A global with a decoration of no meaning has no storage. One whose value runs no code is
    ; left unset, since nothing can read it, and one whose value runs code refuses the program.
    ; One each task or each thread holds its own of, or that `do with` binds, is made where it is
    ; first used.
    (let owner ([] (. program modules) module))
    (let tree (. owner tree))
    (for (in index (..< 0 (. owner decls length)))
      (match? ([] (. owner decls) index)
        (case (call .decl-property property)
          (if (or (!= (. property owner) 0) (== (. property value) 0) (. property is-lazy))
            (continue)
          )
          (let decoration (if-expr (!= (. property decoration) null) (. property decoration text) ""))
          (if (or (== decoration "") per-context (call is-inert-value tree main property))
            (continue)
          )
          (lazy per-context (or (== decoration "task") (== decoration "thread") (== decoration "stack")))
          (call (. refusals append) (call Refusal .refused-global-initializer module (. property value)))
        )
      )
    )
  )
  (fn-expr _ is-inert-value Bool
    (param tree AST)
    (param main InstanceId)
    (param property PropertyDecl)
    (and (call is-constant-form tree main (. property value)) (not (call runs-code tree main property)))
  )
  (fn-do _ runs-code Bool
    (param tree AST)
    (param main InstanceId)
    (param property PropertyDecl)
    ; Whether the value written for a global, or what makes its first value, calls anything.
    (let first (call (. tree subtree-start) (. property syntax)))
    (for (in node (..< first (+ (. property syntax) 1)))
      (if (!= (call (. facts first-call) main node) no-fact)
        (return true)
      )
      (let conversion (call (. facts first-conversion) main node))
      (while (!= conversion no-fact)
        (if (!= (. ([] (. facts conversions) conversion) callee) no-instance)
          (return true)
        )
        (= conversion (. ([] (. facts conversions) conversion) next))
      )
    )
    (return false)
  )
  (fn-do _ is-constant-form Bool
    (param tree AST)
    (param main InstanceId)
    (param value SyntaxId)
    (match? ([] (. tree nodes) value)
      (case .node-string-syntax
        (return true)
      )
      (case .node-integer-syntax
        (return true)
      )
      (case .node-float-syntax
        (return true)
      )
      (case (call .node-unary-expression row)
        (return (and (== (. row op) .negative-op) (call is-number tree (. row operand))))
      )
      (case (call .node-identifier row)
        (return (or (== (. row name) (. types true-atom)) (== (. row name) (. types false-atom))))
      )
      (case (call .node-cast-expression row)
        (return (and (call is-constant-form tree main (. row lhs)) (call is-numeric-node main value)))
      )
      (case (call .node-get-expression row)
        (let bound (or (== (. row name) (. types min-atom)) (== (. row name) (. types max-atom))))
        (return (and bound (call is-type-name tree (. row object)) (call is-numeric-node main value)))
      )
    )
    (return false)
  )
  (fn-expr _ is-number Bool
    (param tree AST)
    (param value SyntaxId)
    (match ([] (. tree nodes) value)
      (case .node-integer-syntax
        true
      )
      (case .node-float-syntax
        true
      )
      (default
        false
      )
    )
  )
  (fn-expr _ is-type-name Bool
    (param tree AST)
    (param value SyntaxId)
    (match ([] (. tree nodes) value)
      (case .node-type-identifier
        true
      )
      (default
        false
      )
    )
  )
  (fn-expr _ is-numeric-node Bool
    (param main InstanceId)
    (param node SyntaxId)
    (case? (or (== type no-type) (== type invalid-type))
      false
    )
    (default
      (and (call intrinsic-is-numeric kind) (!= kind .cpointer))
    )
    (where
      (lazy type (call (. facts node-type) main node))
      (lazy kind (. ([] (. types completions) type) intrinsic))
    )
  )
)

(type + FunctionKind (is U32)
  (variant module-main (= 0))
  (variant module-init (= 1))
  (variant task-main (= 2))
  (variant process-main (= 3))
  (variant instance-body (= 4))
  (variant instance-initializer (= 5))
  (variant lazy-property (= 6))
  (variant module-constants (= 7))
  (variant module-globals (= 8))
  (variant lazy-global (= 9))
  (variant module-statics (= 10))
  (variant adapter (= 11))
  (variant witness (= 12))
  (variant viewed-body (= 13))
  (variant generator-body (= 14))
  (variant class-adapter (= 15))
  (variant union-dispatch (= 16))
  (variant interface-equality (= 17))
  (variant task-local-init (= 18))
  (variant task-body (= 19))
  (variant task-init (= 20))
  (variant thread-local-init (= 21))
  (variant thread-init (= 22))
  (variant stack-local-init (= 23))
  (variant argument-default (= 24))
  (variant stream-action (= 25))
  (variant pattern-helper (= 26))
  (variant pattern-cast (= 27))
  (variant lazy-rule (= 28))
  (variant mapped-rule (= 29))
  (variant raising-rule (= 30))
  (variant storage-growth (= 31))
  (variant rule-adapter (= 32))
  (variant property-updater (= 33))
  (variant live-adapter (= 34))
  (variant class-rule-updater (= 35))
  (variant idle-action (= 36))
  (variant event-handler (= 37))
  (variant event-matcher (= 38))
  (variant event-registrations (= 39))
  (variant style-registration (= 40))
  (variant style-gate (= 41))
  (variant markup-query (= 42))
  (variant markup-query-add (= 43))
  (variant markup-query-remove (= 44))
  (variant style-author (= 45))
  (variant style-static-value (= 46))
  (variant style-rule (= 47))
  (variant style-sheet-registration (= 48))
  (variant style-scope-state (= 49))
  (variant slot-forward (= 50))
  (variant constructor-body (= 51))
  (variant markup-trigger-add (= 52))
  (variant markup-trigger-remove (= 53))
  (variant markup-trigger-ancestor (= 54))
  (variant machine-handler (= 55))
  (variant machine-cast (= 56))
  (variant machine-activation (= 57))
  (variant machine-descriptor (= 58))
  (variant machine-deferral (= 59))
  (variant batch-main (= 60))
  (variant batch-finish (= 61))
  (variant source-attach (= 62))
  (variant machine-part (= 63))
  (variant probe-setup (= 64))
  (variant probe-teardown (= 65))
  (variant probe-closer (= 66))
  (variant probe-flush (= 67))
  (variant probe-safepoint (= 68))
