      (= ([] initialized position) 0)
      (= ([] instance-functions position) no-function)
      (= ([] initializer-functions position) no-function)
      (= ([] body-functions position) no-function)
      (= ([] step-functions position) no-function)
      (= ([] c-symbols position) no-string)
