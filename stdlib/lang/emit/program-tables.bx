    (match? ([] (. ([] (. program modules) (. row module)) decls) (. row decl))
      (case (call .decl-function fn)
        (return
          (scope (or live (== (. fn kind) .whenever-decl) (== (. fn kind) .branch-decl) (== (. fn kind) .source-decl))
            (lazy live (== (. fn kind) .live-decl))
          )
        )
      )
    )
    (return false)
