    (= ([] kinds task) (. Reach task))
    (let root-count (. program batch-roots length))
    (= batch-starts (call (of (. arena allocate) U32) (+ root-count 1)))
    (= batch-finishes (call (of (. arena allocate) U32) (+ root-count 1)))
    (let root-cases (call (of (. arena allocate) U32) module-count))
    (for (in position (..< 0 module-count))
      (= ([] root-cases position) (. U32 max))
    )
    (for (in position (..< 0 root-count))
      (let root (as ([] (. program batch-roots) position) ModuleId))
      (= ([] root-cases root) (as position U32))
      (= ([] batch-starts position) no-function)
      (= ([] batch-finishes position) no-function)
