  (fn-do + probe-site (? ProbeSite)
    (param probe ProbeRow)
    (let site (call ProbeSite))
    (if (== (. probe instance) no-instance)
      (= (. site key) (call compiler-count-key (. probe part)))
      (if (and (>= (as (. probe part) Size) (. collector-counts length)) (!= event-site-instance no-instance))
        (let counted ([] (. program modules) (. ([] (. instances rows) event-site-instance) module)))
        (= (. site module-name) (. counted name))
        (= (. site path) (. counted path))
        (= (. site line) (as (+ (. ([] (. counted tree nodes loc) event-site) begin line) 1) U32))
      )
      (return site)
    )
    (let owner ([] (. program modules) (. ([] (. instances rows) (. probe instance)) module)))
    (let tree (. owner tree))
    (= (. site module-name) (. owner name))
    (= (. site path) (. owner path))
    (= (. site line) (as (+ (. ([] (. tree nodes loc) (. probe syntax)) begin line) 1) U32))
    (let slots (as (. probe types count) Size))
    (match? ([] (. tree nodes) (. probe syntax))
      (case (call .node-probe row)
        (= (. site key) (if-expr (. row key) (. row key text) ""))
        (if (. row name)
          (let named (. row name text))
          (= (. site kind) .event)
          (= (. site name) named)
          (= (. site fields) (call slot-names (call probe-field-names tree (. row content) false) slots false))
          (else
            (= (. site kind) .log)
            (= (. site template) (call probe-template tree (. row content)))
            (= (. site fields) (call slot-names (call probe-field-names tree (. row content) true) slots false))
          )
        )
        (return site)
      )
      (case (call .node-probe-assign row)
        (= (. site kind) .event)
        (= (. site key) (. row key text))
        (= (. site name) "set-property")
        (= (. site fields) (call slot-names (list "property" "value") slots false))
        (return site)
      )
      (case (call .node-probe-counter row)
        (= (. site key) (. row key text))
        (return site)
      )
      (case (call .node-probe-group row)
        (= (. site key) (if-expr (. row key) (. row key text) ""))
        (let opens (and (. row is-begin) (== (. probe part) 0)))
        (let named (call probe-field-names tree (. row content) true))
        (let held (not (call ends-in-log (. probe instance) (. probe syntax) (. probe part))))
        (= (. site kind) .log)
        (if (. row is-data)
          (= (. site kind) .event)
          (= (. site name) (if-expr opens "groupBegin" "groupEnd"))
          (else-if (not held)
            (= (. site template) (call probe-template tree (. row content)))
          )
          (else
            (= (. site name) (if-expr opens "groupBegin" "groupEnd"))
            (= (. site template) (if-expr opens (call probe-template tree (. row content)) ""))
          )
        )
        (= (. site fields) (call slot-names named slots held))
        (return site)
      )
    )
    (return null)
  )
  (fn-do + selects-any Bool
    (param selection ProbeSelection)
    (for (in probe probes)
      (if (== (. probe instance) no-instance)
        (return-if true (if (call (. selection compiles-metrics) (call compiler-count-key (. probe part)))))
        (blank)
        (continue)
      )
      (let owner ([] (. program modules) (. ([] (. instances rows) (. probe instance)) module)))
      (return-if true (if (call (. selection compiles-node) (. owner name) (. owner tree) (. probe syntax))))
    )
    (for (in metric profile-metrics)
      (let owner ([] (. program modules) (. ([] (. instances rows) (. metric instance)) module)))
      (return-if true (if (call (. selection compiles-node) (. owner name) (. owner tree) (. metric syntax))))
      (return-if true (if (call (. selection compiles-metrics) (call metric-key (. metric instance) (. metric syntax)))))
    )
    (return false)
  )
  (fn-do + metric-site ProbeSite
    (param metric ProbeRow)
    (let owner ([] (. program modules) (. ([] (. instances rows) (. metric instance)) module)))
    (let site (call ProbeSite))
    (= (. site kind) (if-expr (== (. metric part) 2) .timer (. ProbeSiteKind counter)))
    (= (. site key) (call metric-key (. metric instance) (. metric syntax)))
    (= (. site module-name) (. owner name))
    (= (. site path) (. owner path))
    (= (. site line) (as (+ (. ([] (. owner tree nodes loc) (. metric syntax)) begin line) 1) U32))
    (return site)
  )
  (fn-expr + compiler-count-key String
    (param count U32)
    ; The key of a count the compiler keeps of its own accord: of what the collector did, the cycles it
    ; collected, the pauses it made and the time it spent assisting, and then of what events do, in the
    ; order of `EventCount`.
    (match count
      (case= 0
        "gc.cycles"
      )
      (case= 1
        "gc.pauses"
      )
      (case= 2
        "gc.assist.nanos"
      )
      (default
        (str "event." ([] event-count-names (- count 3)))
      )
    )
  )
  (fn-expr + probe-class-id U16
    (param type TypeId)
    ; The id the probes module knows the class of an object or an array by, numbered after the probe
    ; data types in the order the classes are kept, or none.
    (if-expr found (as (+ 17 found) U16) 0)
    (where
      (lazy found (call (. probe-classes find) (call probe-class-name types type)))
    )
  )
  (fn-expr + probe-number U32
    (param instance InstanceId)
    (param syntax SyntaxId)
    ; The place of a probe an instance compiles among those the record of probes declares, counted
    ; from one, or none.
    (?? ([] probe-rows (call pair-key instance syntax)) 0)
  )
  (fn-expr + compiles-features Bool
    (param features CompilerFeature)
    (or observes (== (/and/ features (. CompilerFeature collection-observers)) 0))
  )
  (fn-expr + event-use-of (? EventUse)
    (param instance InstanceId)
    (param site SyntaxId)
    (only-if ([] (. facts event-uses) place) (if place))
    (where
      (lazy place ([] event-use-places (call site-key instance site)))
    )
  )
  (fn-expr + owned-subscription-of (? OwnedSubscription)
    (param instance InstanceId)
    (param site SyntaxId)
    (only-if ([] (. facts owned-subscriptions) place) (if place))
    (where
      (lazy place ([] subscription-places (call site-key instance site)))
    )
  )
  (fn-expr + live-statement-of (? LiveStatement)
    (param instance InstanceId)
    (param site SyntaxId)
    (only-if ([] (. facts live-statements) place) (if place))
    (where
      (lazy place ([] live-statement-places (call site-key instance site)))
    )
  )
  (fn-do + has-initializer Bool
    (param callee InstanceId)
    ; Whether a constructor is one written in source for a class, which `super(…)` runs on the
    ; object being made. One the compiler generates stores nothing then and runs nothing, and
    ; one that returns a value of its own has no object to run on.
    (if (== callee no-instance)
      (return false)
    )
    (let row ([] (. instances rows) callee))
    (if (or (not (call is-class (. row self-type))) (call returns-own callee))
      (return false)
    )
    (match? ([] (. ([] (. program modules) (. row module)) decls) (. row decl))
      (case (call .decl-function fn)
        (return (and (not (. fn is-generated)) (== (. fn kind) .constructor-decl)))
      )
    )
    (return false)
  )
  (fn-do + fills-apart Bool
    (param instance InstanceId)
    ; Whether a constructor runs its body in a function of its own, as the reference shares the body
    ; among the styles the constructor is made for: one that fills its object with its class's
    ; markup and raises no error. Its own function calls that one, then fills the object, so a
    ; panic in the body shows both.
    (if (or (== (call (. facts filler-of) instance) no-fact) (!= (. ([] (. instances signatures) instance) errors count) 0))
      (return false)
    )
    (let row ([] (. instances rows) instance))
    (match? ([] (. ([] (. program modules) (. row module)) decls) (. row decl))
      (case (call .decl-function fn)
        (return (or (== (. fn kind) .default-constructor-decl) (== (. fn kind) .constructor-decl)))
      )
    )
    (return false)
  )
  (fn-expr + returns-own Bool
    (param callee InstanceId)
    ; Whether a constructor written in source returns a value of its own, as the type pass said
    ; of it where it typed its body. It constructs what it returns, and makes nothing of its
    ; class.
    (and (!= callee no-instance) (. ([] (. instances rows) callee) returns-own))
  )
  (fn-do + writes-constructor Bool
    (param type TypeId)
    ; Whether a type, or one it is derived from, declares a constructor written in source. With
    ; no value written for it, a tuple or struct of such a type is what the constructor the type
    ; pass chose makes, which the first values of its fields do not say.
    (let current type)
    (while (and (!= current no-type) (!= current invalid-type))
      (let module ModuleId 0)
      (let decl DeclId 0)
      (let declared false)
      (match? ([] (. types rows) current)
        (case (call .type-class row)
          (= module (. row module))
          (= decl (. row decl))
          (= declared true)
        )
        (case (call .type-tuple row)
          (= module (. row module))
          (= decl (. row decl))
          (= declared true)
        )
        (case (call .type-struct row)
          (= module (. row module))
          (= decl (. row decl))
          (= declared true)
        )
      )
      (if (and declared (call writes-own-constructor module decl))
        (return true)
      )
      (= current (. ([] (. types completions) current) base))
    )
    (return false)
  )
  (fn-do + builds-in-frame Bool
    (param callee InstanceId)
    ; Whether a callee is a constructor the compiler generates for a tuple or struct: one that
    ; gives each field an argument or its first value. A call of it builds the value where the
    ; call is, so it is visited for what the first values call, and is no function.
    (let row ([] (. instances rows) callee))
    (if (or (== (. row self-type) no-type) (== (. row self-type) invalid-type))
      (return false)
    )
    (let kind (. ([] (. types completions) (. row self-type)) intrinsic))
    (if (and (!= kind .tuple) (!= kind .struct) (!= kind .array-builder))
      (return false)
    )
    (match? ([] (. ([] (. program modules) (. row module)) decls) (. row decl))
      (case (call .decl-function fn)
        (let fills (or (== (. fn kind) .tuple-constructor-decl) (== (. fn kind) .default-constructor-decl)))
        (return (and (. fn is-generated) fills))
      )
    )
    (return false)
  )
  (fn-do + loose-call FactId
    (param instance InstanceId)
    (param syntax SyntaxId)
    ; The call recorded for an instance at a node outside its body, or no fact when none is
    ; recorded there, or more than one.
    (let found no-fact)
    (let loose ([] loose-call-heads instance))
    (while (!= loose no-fact)
      (let fact (. ([] (. facts loose-calls) loose) fact))
      (if (== (. ([] (. facts calls) fact) syntax) syntax)
        (if (!= found no-fact)
          (return no-fact)
        )
        (= found fact)
      )
      (= loose ([] loose-call-links loose))
    )
    (return found)
  )
  (fn-expr + default-of PropertyDefault
    (param type TypeId)
    (param property U32)
    ; The value written for a property of a type, by the property's place among all of them.
    ; It is kept for each property of a class the program constructs, so a worker that builds
    ; one reads no class.
    (case? (and (< property default-count) (!= ([] default-rows property) (. U32 max)))
      ([] defaults ([] default-rows property))
    )
    (case? (and (!= (. row facet) (. U32 max)) (not (call is-given-below types row)))
      (call facet-default row)
    )
    (case? (or (!= (. found site) 0) (== (. row owner) no-type))
      found
    )
    (default
      (call tuple-default type (. row owner) (. row name))
    )
    (where
      (lazy row ([] (. types properties) property))
      (lazy found (call property-default (if-expr (!= (. row owner) no-type) (. row owner) type) (. row name)))
    )
  )
  (fn-expr + value-unit InstanceId
    (param place U32)
    ; The instance whose facts the value written for a property has, by the property's place
    ; among all of them, or no instance: the type pass typed none, or the program makes no value
    ; of the property's type. It is kept for each property, so a worker reads no table of
    ; instances.
    (if-expr (< place default-count) ([] value-units place) no-instance)
  )
  (fn-expr + first-read FactId
    (param unit InstanceId)
    ; The first of the properties the value an instance types reads of its receiver, or no fact.
    ([] read-heads unit)
  )
  (fn-expr + next-read FactId
    (param read FactId)
    ([] read-links read)
  )
  (fn-do + dynamic-slot U32
    (param type TypeId)
    (param interface TypeId)
    ; Where the table of a class keeps the table of an interface that classes below it declare
    ; (`record-dynamic-witness`): the slot holds the table of the object's class, or nothing where
    ; its class declares none. None where the class has no table.
    (let index ([] table-indexes type))
    (if (== index (. U32 max))
      (return no-slot-index)
    )
    (let entries (. ([] class-tables index) entries))
    (for (in position (..< (. entries start) (+ (. entries start) (. entries count))))
      (if (== ([] table-protos position) (+ witness-proto interface))
        (return (- position (. entries start)))
      )
    )
    (return no-slot-index)
  )
  (fn-expr + is-recursive Bool
    (param instance InstanceId)
    (and (< instance (. instances length)) (!= ([] recursive instance) 0))
  )
  (fn-expr + is-bounded Bool
    (param instance InstanceId)
    ; Whether a function that runs where the collector never sees it reaches no safepoint and
    ; cannot panic, so that a call of it from outside that zone need not enter the zone.
    (and (< instance (. instances length)) (!= ([] bounded instance) 0))
  )
  (fn-do + mark-bounded _
    (param instance InstanceId)
    (= ([] bounded instance) 1)
  )
  (fn-expr + finish-of U32
    (param function FunctionId)
    (if-expr (< instance (. instances length)) ([] finishes instance) (. U32 max))
    (where
      (lazy instance (. ([] functions function) instance))
    )
  )
  (fn-do + asks-inline Bool
    (param instance InstanceId)
    (let row ([] (. instances rows) instance))
    (match? ([] (. ([] (. program modules) (. row module)) decls) (. row decl))
      (case (call .decl-function fn)
        (match? ([] (. ([] (. program modules) (. row module)) tree nodes) (. fn syntax))
          (case (call .node-function-syntax syntax)
            (return (. syntax is-inline))
          )
        )
      )
      (case (call .decl-converter converter)
        (match? ([] (. ([] (. program modules) (. row module)) tree nodes) (. converter syntax))
          (case (call .node-converter-syntax syntax)
            (return (. syntax is-inline))
          )
        )
      )
    )
    (return false)
  )
  (fn-expr + is-overridden Bool
    (param callee InstanceId)
    ; Whether some subclass declares a method or a converter again, so that a call of it must
    ; choose by the object's class.
    (!= ([] overridden callee) 0)
  )
  (fn-expr + raises-through Bool
    (param callee InstanceId)
    ; Whether a call through the slot of an instance may panic: some function a table holds in
    ; that slot may.
    (!= ([] raising callee) 0)
  )
  (fn-expr + is-class Bool
    (param type TypeId)
    (call (. types is-class-type) type)
  )
  (fn-expr + checks-termination Bool
    (param callee InstanceId)
    ; Whether the task is checked for being terminated after a call of a C function: one that
    ; suspends it is, but for one that leaves a termination to what follows (`leaves-termination`).
    (== ([] c-suspends callee) 1)
  )
  (fn-do + want-type-constant _
    (param type TypeId)
    ; Notes that emitted code names a type's constant.
    (if (== ([] rtti-states type) 0)
      (= ([] rtti-states type) 1)
    )
  )
  (fn-do + add-type-constants _
    ; Adds the constant of each type emitted code named, in the order of the types: the type's
    ; name, its key, and its property table or zero.
    (for (in type (. types ranked))
      (if (== ([] rtti-states type) 1)
        (call add-type-constant type)
      )
    )
  )
  (fn-expr + runs-statement Bool
    (param module ModuleId)
    (param decl DeclId)
    (param tree AST)
    (param statement SyntaxId)
    ; Whether a statement of a function of a module runs where it is written: one that neither
    ; declares something nor is a comment, or a line written as a comment that is a log whose probe
    ; compiles.
    (or (call is-executable-statement tree statement) (and (call is-comment-syntax tree statement) probe-compiles))
    (where
      (lazy probe-compiles (call (. program compiles-probe) module decl statement))
    )
  )
  (fn-do _ mark-memo-places _
    (return-if (if (== (. instances live memo-action) no-instance)))
    (blank)
    (let count (. types properties length))
    (let roots (call (of (. arena allocate) Byte) (+ count 1)))
    (let places (call (of (. arena allocate) Byte) (+ count 1)))
    (for (in position (..< 0 (+ count 1)))
      (= ([] roots position) 0)
      (= ([] places position) 0)
    )
    (for (in type (. types ranked))
      (if (not (call is-memo-holder type))
        (continue)
      )
      (let range (. ([] (. types completions) type) properties))
      (for (in position (..< 0 (. range count)))
        (let place (+ (. range start) position))
        (if (!= (. ([] (. types properties) place) storage-kind) .storage-eager)
          (continue)
        )
        (let unit (call find-unit type place (call default-of type place)))
        (if (and (!= unit no-instance) (. ([] (. instances rows) unit) is-live))
          (= ([] roots (call root-place type position)) 1)
        )
      )
    )
    (for (in type (. types ranked))
      (if (not (call is-memo-holder type))
        (continue)
      )
      (let range (. ([] (. types completions) type) properties))
      (for (in position (..< 0 (. range count)))
        (let place (+ (. range start) position))
        (if (and eager (!= ([] roots (call root-place type position)) 0))
          (= ([] places place) 1)
        )
        (lazy eager (== (. ([] (. types properties) place) storage-kind) .storage-eager))
      )
    )
    (= (. layouts memo-places) places)
  )
  (fn-expr _ is-memo-holder Bool
    (param type TypeId)
    (and (== (. completion completion) .completion-done) (not (. completion has-variables)) (call is-class type))
    (where
      (lazy completion ([] (. types completions) type))
    )
  )
  (fn-do _ root-place U32
    (param type TypeId)
    (param position U32)
    (let current type)
    (while true
      (let base (. ([] (. types completions) current) base))
      (if (or (== base no-type) (not (call is-memo-holder base)) beyond-base)
        (return (+ (. ([] (. types completions) current) properties start) position))
      )
      (lazy beyond-base (<= (. ([] (. types completions) base) properties count) position))
      (= current base)
    )
    (return 0)
  )
  (fn-do _ index-overrides _
    ; Marks each instance some subclass declares again, so a worker asks without reading every
    ; override, and with a higher mark one that a function that may panic declares again.
    (let count (. instances length))
    (= overridden (call (of (. arena allocate) Byte) count))
    (for (in position (..< 0 count))
      (= ([] overridden position) 0)
    )
    (for (in fact (. facts overrides))
      (if (and (!= (. fact override) no-instance) (. ([] (. instances rows) (. fact override)) may-panic))
        (= ([] overridden (. fact base)) 2)
        (else-if (== ([] overridden (. fact base)) 0)
          (= ([] overridden (. fact base)) 1)
        )
      )
    )
  )
  (fn-do _ index-applications _
    ; Links each application of a style rule to the next its instance makes, in the order of
    ; `Facts.style-applications`, so a worker reads only those of the instance it emits
    ; (`first-application`).
    (let count U32 (as (. facts style-applications length) U32))
    (= application-links (call (of (. arena allocate) U32) (+ count 1)))
    (for (in offset (..< 0 count))
      (let position (- count 1 offset))
      (let instance (. ([] (. facts style-applications) position) instance))
      (= ([] application-links position) (?? ([] application-heads instance) (. U32 max)))
      (= ([] application-heads instance) position)
    )
  )
  (fn-do _ index-recursion _
    (let count U32 (as (. instances length) U32))
    (let starts (call (of (. arena allocate) U32) (+ count 1)))
    (for (in position (..< 0 (+ count 1)))
      (= ([] starts position) 0)
    )
    (for (in fact (. facts calls))
      (if (and (< (. fact instance) count) (< (. fact callee) count))
        (+= ([] starts (+ (. fact instance) 1)) 1)
      )
    )
    (for (in position (..< 0 count))
      (+= ([] starts (+ position 1)) ([] starts position))
    )
    (let filled (call (of (. arena allocate) U32) (+ count 1)))
    (for (in position (..< 0 (+ count 1)))
      (= ([] filled position) ([] starts position))
    )
    (let targets (call (of (. arena allocate) U32) (+ ([] starts count) 1)))
    (for (in fact (. facts calls))
      (if (and (< (. fact instance) count) (< (. fact callee) count))
        (= ([] targets ([] filled (. fact instance))) (. fact callee))
        (+= ([] filled (. fact instance)) 1)
      )
    )
    (= recursive (call (of (. arena allocate) Byte) count))
    (= finishes (call (of (. arena allocate) U32) count))
    (let order (call (of (. arena allocate) U32) count))
    (let low (call (of (. arena allocate) U32) count))
    (let open (call (of (. arena allocate) Byte) count))
    (for (in position (..< 0 count))
      (= ([] recursive position) 0)
      (= ([] finishes position) (. U32 max))
      (= ([] order position) (. U32 max))
      (= ([] open position) 0)
    )
    (let visited U32)
    (let finished U32)
    (let stack (list U32))
    (let path (list U32))
    (let cursors (list U32))
    (for (in root (..< 0 count))
      (if (!= ([] order root) (. U32 max))
        (continue)
      )
      (= ([] order root) visited)
      (= ([] low root) visited)
      (+= visited 1)
      (+= stack root)
      (= ([] open root) 1)
      (+= path root)
      (+= cursors ([] starts root))
      (while (!= (. path length) 0)
        (let node ([] path (- (. path length) 1)))
        (let edge ([] cursors (- (. cursors length) 1)))
        (if (< edge ([] starts (+ node 1)))
          (= ([] cursors (- (. cursors length) 1)) (+ edge 1))
          (let next ([] targets edge))
          (if (== next node)
            (= ([] recursive node) 1)
          )
          (if (== ([] order next) (. U32 max))
            (= ([] order next) visited)
            (= ([] low next) visited)
            (+= visited 1)
            (+= stack next)
            (= ([] open next) 1)
            (+= path next)
            (+= cursors ([] starts next))
            (else-if (and (!= ([] open next) 0) (< ([] order next) ([] low node)))
              (= ([] low node) ([] order next))
            )
          )
          (continue)
        )
        (call (. path pop))
        (call (. cursors pop))
        (= ([] finishes node) finished)
        (+= finished 1)
        (if (and (!= (. path length) 0) (< ([] low node) ([] low ([] path (- (. path length) 1)))))
          (= ([] low ([] path (- (. path length) 1))) ([] low node))
        )
        (if (!= ([] low node) ([] order node))
          (continue)
        )
        (let first (- (. stack length) 1))
        (while (!= ([] stack first) node)
          (-= first 1)
        )
        (let many (> (- (. stack length) first) 1))
        (while (> (. stack length) first)
          (let member (call (. stack pop)))
          (= ([] open member) 0)
          (if many
            (= ([] recursive member) 1)
          )
        )
      )
    )
  )
  (fn-do _ index-fills _
    ; Chains each constructor's fill facts, so a worker finds a property's fill without reading
    ; every fact.
    (let instance-count (. instances length))
    (let fill-count U32 (as (. facts fills length) U32))
    (= fill-heads (call (of (. arena allocate) U32) instance-count))
    (= fill-links (call (of (. arena allocate) U32) fill-count))
    (for (in position (..< 0 instance-count))
      (= ([] fill-heads position) no-fact)
    )
    (for (in offset (..< 0 fill-count))
      (let id (- fill-count 1 offset))
      (let owner (. ([] (. facts fills) id) instance))
      (= ([] fill-links id) ([] fill-heads owner))
      (= ([] fill-heads owner) id)
    )
  )
  (fn-do _ lay-environments _
    ; Settles where a local that nested functions capture is kept: in the environment of the
    ; nearest scope around its declaration that runs anew, which is a function, a nested
    ; function or a loop. A captured slot gets that scope and its place among the slots the
    ; scope holds, in their order. Then the environment of each emitted instance whose own
    ; scope holds any is laid out, with the types its locals have in that instance, and so is
    ; that of the value of a lazy property, which its getter makes, and of the value of a property
    ; that holds a state machine, which a constructor makes as the machine starts. A binding with
    ; no nested function has none of this.
    (let slot-count (. bindings slots length))
    (let scope-count (. bindings scopes length))
    (let instance-count (. instances length))
    (= slot-functions (call (of (. arena allocate) U32) (+ slot-count 1)))
    (= slot-homes (call (of (. arena allocate) U32) (+ slot-count 1)))
    (= slot-fields (call (of (. arena allocate) U32) (+ slot-count 1)))
    (= slot-copied (call (of (. arena allocate) U8) (+ slot-count 1)))
    (= lazy-held (call (of (. arena allocate) U8) (+ slot-count 1)))
    (= unneeded (call (of (. arena allocate) U8) (+ slot-count 1)))
    (let shared (call (of (. arena allocate) U8) (+ slot-count 1)))
    (= scope-captures (call (of (. arena allocate) U32) (+ scope-count 1)))
    (= scope-links (call (of (. arena allocate) U32) (+ scope-count 1)))
    (= scope-steps (call (of (. arena allocate) U8) (+ scope-count 1)))
    (= instance-scopes (call (of (. arena allocate) U32) (+ instance-count 1)))
    (= environments (call (of (. arena allocate) U32) (+ instance-count 1)))
    (let steps (call (of (. arena allocate) U8) (+ (. bindings bindings length) 1)))
    (for (in slot (..< 0 slot-count))
      (= ([] slot-functions slot) no-scope)
      (= ([] slot-homes slot) no-scope)
      (= ([] slot-fields slot) 0)
      (= ([] slot-copied slot) 0)
      (= ([] lazy-held slot) 0)
      (= ([] unneeded slot) 0)
      (= ([] shared slot) 0)
    )
    (for (in scope (..< 0 scope-count))
      (= ([] scope-captures scope) 0)
      (= ([] scope-links scope) 0)
      (= ([] scope-steps scope) 0)
    )
    (let nested-scopes (call (of Map Size U32) arena))
    (for (in index (..< 0 (. bindings bindings length)))
      (let bound ([] (. bindings bindings) index))
      (= ([] steps index) 0)
      (for (in offset (..< 0 (. bound nested count)))
        (let nested ([] (. bindings nested) (+ (. bound nested start) offset)))
        (= ([] nested-scopes (. (call DeclRef (. bound module) (. nested decl)) key)) (. nested scope))
      )
    )
    (for (in instance (. instances ordered))
      (let row ([] (. instances rows) instance))
      (if (or (== ([] step-functions instance) no-function) (== (. row binding) no-binding))
        (continue)
      )
      (let bound ([] (. bindings bindings) (. row binding)))
      (if (== (. bound scopes count) 0)
        (continue)
      )
      (let scope (?? ([] nested-scopes (. (call DeclRef (. row module) (. row decl)) key)) (. bound scopes start)))
      (if (== ([] scope-steps scope) 0)
        (= ([] scope-steps scope) 1)
        (= ([] scope-captures scope) 1)
        (= ([] steps (. row binding)) 1)
      )
    )
    (let bound-instances (call (of (. arena allocate) IdList) (+ (. bindings bindings length) 1)))
    (for (in index (..< 0 (. bindings bindings length)))
      (= ([] bound-instances index) (call IdList))
    )
    (for (in instance (. instances ordered))
      (let binding (. ([] (. instances rows) instance) binding))
      (if (!= binding no-binding)
        (= ([] bound-instances binding) (call (. ([] bound-instances binding) appended) arena instance))
      )
    )
    (for (in index (..< 0 (. bindings bindings length)))
      (let bound ([] (. bindings bindings) index))
      (if (and (!= (. bound nested count) 0) (== ([] steps index) 0))
        (call settle-held (as index BindingId) ([] bound-instances index) nested-scopes)
      )
    )
    (let turns (call (of (. arena allocate) U8) (+ (. bindings bindings length) 1)))
    (for (in index (..< 0 (. bindings bindings length)))
      (let bound ([] (. bindings bindings) index))
      (= ([] turns index) 0)
      (if (or (!= (. bound nested count) 0) (!= ([] steps index) 0))
        (call mark-copies bound shared)
        (for (in offset (..< 0 (. bound slots count)))
          (call place-slot (+ (. bound slots start) offset) shared)
        )
      )
      (for (in offset (..< 0 (. bound nested count)))
        (call link-scopes ([] (. bindings nested) (+ (. bound nested start) offset)))
      )
      (if (== (. bound nested count) 0)
        (continue)
      )
      (for (in offset (..< 0 (. bound scopes count)))
        (let scope (+ (. bound scopes start) offset))
        (if (and (call is-turn-scope scope) (!= ([] scope-captures scope) 0))
          (= ([] turn-scopes (call pair-key (. bound module) (. ([] (. bindings scopes) scope) syntax))) scope)
          (= ([] turns index) 1)
        )
      )
    )
    (let lazy-units (call (of (. arena allocate) U8) (+ instance-count 1)))
    (for (in instance (..< 0 instance-count))
      (= ([] lazy-units instance) 0)
    )
    (for (in place (..< 0 default-count))
      (if (and (!= ([] lazy-functions place) no-function) (!= ([] value-units place) no-instance))
        (= ([] lazy-units ([] value-units place)) 1)
      )
    )
    (for (in machine (. facts machines))
      (if (and (== (. machine store) .store-member) (!= (. ([] (. instances rows) (. machine instance)) enclosing) no-instance))
        (= ([] lazy-units (. ([] (. instances rows) (. machine instance)) enclosing)) 1)
      )
    )
    (for (in instance (..< 0 instance-count))
      (= ([] instance-scopes instance) no-scope)
      (= ([] environments instance) no-layout)
    )
    (for (in instance (. instances ordered))
      (let row ([] (. instances rows) instance))
      (let root (call is-root-unit instance))
      (let apart (or (!= ([] lazy-units instance) 0) (call is-rule-unit instance) root))
      (if (or (== (. row binding) no-binding) (and (!= (. row initializer) 0) (not apart)))
        (continue)
      )
      (let bound ([] (. bindings bindings) (. row binding)))
      (if (or (and (== (. bound nested count) 0) (== ([] steps (. row binding)) 0)) (== (. bound scopes count) 0))
        (continue)
      )
      (let scope (?? ([] nested-scopes (. (call DeclRef (. row module) (. row decl)) key)) (. bound scopes start)))
      (if apart
        (= scope (call value-scope row bound))
      )
      (if (or (== scope no-scope) (and root (not (call holds-environment scope))))
        (continue)
      )
      (= ([] instance-scopes instance) scope)
      (if (and (or has-function apart) (or (call holds-environment scope) (call makes-holders instance)))
        (= ([] environments instance) (call lay-environment instance bound scope))
      )
      (lazy has-function (!= ([] instance-functions instance) no-function))
      (if (and (!= ([] instance-functions instance) no-function) (!= ([] turns (. row binding)) 0))
        (call lay-turns instance bound scope)
      )
    )
  )
  (fn-do _ value-scope ScopeId
    (param row Instance)
    (param bound Binding)
    ; The scope a property's value or a rule of a class is bound in, among those of its module's
    ; main: the one written at the property or the rule.
    (let syntax SyntaxId 0)
    (match? ([] (. ([] (. program modules) (. row module)) decls) (. row initializer))
      (case (call .decl-property property)
        (= syntax (. property syntax))
      )
      (case (call .decl-rule rule)
        (= syntax (. rule syntax))
      )
      (case (call .decl-style-rule rule)
        (= syntax (. rule syntax))
      )
    )
    (for (in offset (..< 0 (. bound scopes count)))
      (let scope (+ (. bound scopes start) offset))
      (if (and (== (. ([] (. bindings scopes) scope) syntax) syntax) (== (. ([] (. bindings scopes) scope) kind) .scope-function))
        (return scope)
      )
    )
    (return no-scope)
  )
  (fn-do _ is-root-unit Bool
    (param instance InstanceId)
    ; Whether an instance types a line of a root `<This` for a receiver, whose closures read the
    ; object from the environment the value is given where the constructor evaluates it.
    (let row ([] (. instances rows) instance))
    (if (or (== (. row initializer) 0) (== (. row self-type) no-type))
      (return false)
    )
    (match? ([] (. ([] (. program modules) (. row module)) decls) (. row initializer))
      (case (call .decl-property property)
        (return (. property defaults-root))
      )
    )
    (return false)
  )
  (fn-do _ is-rule-unit Bool
    (param instance InstanceId)
    ; Whether an instance types a rule of a class, or a style rule of one with a line that sets a
    ; property again as what its value read changes, whose function is written in the rule.
    (let row ([] (. instances rows) instance))
    (if (== (. row initializer) 0)
      (return false)
    )
    (match? ([] (. ([] (. program modules) (. row module)) decls) (. row initializer))
      (case .decl-rule
        (return true)
      )
      (case .decl-style-rule
        (return (call (. facts updates-live) instance))
      )
    )
    (return false)
  )
  (fn-do _ link-scopes _
    (param nested NestedFunction)
    ; Marks each nested function's scope that lies between where a nested function is written
    ; and where a local it captures is declared. A slot only tasks capture is reached through the
    ; captures of the tasks around, which need no environment for the link.
    (let written (call (. bindings function-scope) (. ([] (. bindings scopes) (. nested scope)) parent)))
    (for (in index (..< 0 (. nested captures count)))
      (let slot (. ([] (. bindings captures) (+ (. nested captures start) index)) slot))
      (if (!= ([] slot-copied slot) 0)
        (continue)
      )
      (let home ([] slot-functions slot))
      (let scope written)
      (while (and (!= home no-scope) (!= scope home) (== (. ([] (. bindings scopes) scope) kind) .scope-nested))
        (= ([] scope-links scope) 1)
        (= scope (call (. bindings function-scope) (. ([] (. bindings scopes) scope) parent)))
      )
    )
  )
  (fn-do _ mark-copies _
    (param bound Binding)
    (param shared (of CPointer U8))
    ; Marks the slots of a binding that only the bodies of spawned tasks and of `do without gc` blocks
    ; capture, as a local, an argument, the item of a loop or the receiver. Every nested function
    ; between a reference and the declaration records what it captures, so the outermost task copies the
    ; slot where it is spawned and the tasks inside it share that copy through their links, as the
    ; reference does; any other capture shares the slot. A binding where a lazy local is captured shares
    ; all it captures, since what the value reads is reached from wherever it is first read.
    (for (in offset (..< 0 (. bound slots count)))
      (let row ([] (. bindings slots) (+ (. bound slots start) offset)))
      (if (and (== (. row kind) .slot-lazy) (!= (/and/ (. row flags) (. SlotFlag slot-captured)) 0))
        (return)
      )
    )
    (for (in offset (..< 0 (. bound nested count)))
      (let nested ([] (. bindings nested) (+ (. bound nested start) offset)))
      (let spawned (call copies-captures (. bound module) (. nested decl)))
      (for (in index (..< 0 (. nested captures count)))
        (let slot (. ([] (. bindings captures) (+ (. nested captures start) index)) slot))
        (let kind (. ([] (. bindings slots) slot) kind))
        (let plain
          (scope (or (== kind .slot-this) (== kind .slot-local) (== kind .slot-argument) loop-item)
            (lazy loop-item (== kind .slot-loop-item))
          )
        )
        (if (and spawned plain)
          (= ([] slot-copied slot) 1)
          (else
            (= ([] shared slot) 1)
          )
        )
      )
    )
  )
  (fn-expr _ copies-captures Bool
    (param module ModuleId)
    (param decl DeclId)
    ; Whether a nested function copies what it captures where it is made: the body of a spawned task
    ; or of a `do without gc` block.
    (match ([] (. ([] (. program modules) module) decls) decl)
      (case (call .decl-function fn)
        (or (== (. fn kind) .task-decl) (== (. fn kind) .region-decl))
      )
      (default
        false
      )
    )
  )
  (fn-do _ place-slot _
    (param slot SlotId)
    (param shared (of CPointer U8))
    (let row ([] (. bindings slots) slot))
    (let scope (. row scope))
    (let home no-scope)
    (let home-kind (. ([] (. bindings scopes) scope) kind))
    (let given (and (== home-kind .scope-activation) (== (. ([] (. bindings scopes) scope) syntax) (. row syntax))))
    (while (and (!= (. ([] (. bindings scopes) scope) kind) .scope-function) (!= (. ([] (. bindings scopes) scope) kind) .scope-nested))
      (if (and (== home no-scope) (or (== (. ([] (. bindings scopes) scope) kind) .scope-loop) given))
        (= home scope)
      )
      (= scope (. ([] (. bindings scopes) scope) parent))
    )
    (= ([] slot-functions slot) scope)
    (let copied (and (!= ([] slot-copied slot) 0) (== ([] shared slot) 0)))
    (let captured (and (!= (/and/ (. row flags) (. SlotFlag slot-captured)) 0) (not copied) (== ([] unneeded slot) 0)))
    (= ([] slot-copied slot) 0)
    (if (and (not captured) (== ([] scope-steps scope) 0))
      (if copied
        (= ([] slot-copied slot) 1)
      )
      (return)
    )
    (if (or (== home no-scope) (not captured))
      (= home scope)
    )
    (= ([] slot-homes slot) home)
    (= ([] slot-fields slot) ([] scope-captures home))
    (+= ([] scope-captures home) (if-expr (and (== (. row kind) .slot-lazy) (== ([] lazy-held slot) 0)) 2 1))
  )
  (fn-do _ settle-held _
    (param binding BindingId)
    (param typed IdList)
    (param nested-scopes (of Map Size U32 ArenaBacking))
    ; Settles which lazy locals of a binding that nested functions capture are held as an eager
    ; local is: the function that declares one gives it its value before it makes each nested
    ; function that reads it (`holds-lazy`), so the environment holds the value alone, nested
    ; functions read it as they read any local, and only the function that declares it keeps a flag.
    ; One is held where it is assigned nowhere and referred to nowhere, is not read tracked, is not
    ; declared in a loop or with others, is not read in a subscription or a state machine, and its
    ; value tracks nothing; is no live statement and is not part of the value of one, which each run
    ; of the statement evaluates again (`in-live-statement`); and where every instance that declares
    ; it reads it before it makes each nested function that reads it (`lazy-dominated`), or its value
    ; is cheap and pure there, so that evaluating it early changes nothing (`cheap-value`). One that
    ; the value of a captured lazy local not held reads is not held, since a nested function may
    ; evaluate that one before the held one has its value. Then an argument or a local captured only
    ; for the values of lazy locals (`slot-shared-read`) that no nested function and no captured lazy
    ; local not held reads is not kept in the environment.
    (let bound ([] (. bindings bindings) binding))
    (let tree (. ([] (. program modules) (. bound module)) tree))
    (let any false)
    (for (in offset (..< 0 (. bound slots count)))
      (let slot (+ (. bound slots start) offset))
      (if (call may-hold binding tree slot typed nested-scopes)
        (= ([] lazy-held slot) 1)
        (= any true)
      )
    )
    (return-if (if (not any)))
    (blank)
    (let changed true)
    (while changed
      (= changed false)
      (for (in offset (..< 0 (. bound slots count)))
        (let slot (+ (. bound slots start) offset))
        (let row ([] (. bindings slots) slot))
        (if (or (!= (. row kind) .slot-lazy) (== (/and/ (. row flags) (. SlotFlag slot-captured)) 0) marked-held)
          (continue)
        )
        (lazy marked-held (!= ([] lazy-held slot) 0))
        (let value (call lazy-value tree (. row group)))
        (if (== value 0)
          (continue)
        )
        (for (in node (.. (call (. tree subtree-start) value) value))
          (let read (call read-slot binding node))
          (if (and (!= read no-slot) (!= ([] lazy-held read) 0))
            (= ([] lazy-held read) 0)
            (= changed true)
          )
        )
      )
    )
    (let needed (call (of (. arena allocate) U8) (+ (. bound slots count) 1)))
    (for (in offset (..< 0 (. bound slots count)))
      (= ([] needed offset) 0)
    )
    (for (in offset (..< 0 (. bound nested count)))
      (let nested ([] (. bindings nested) (+ (. bound nested start) offset)))
      (for (in index (..< 0 (. nested captures count)))
        (let slot (. ([] (. bindings captures) (+ (. nested captures start) index)) slot))
        (if (and (>= slot (. bound slots start)) (< slot (+ (. bound slots start) (. bound slots count))))
          (= ([] needed (- slot (. bound slots start))) 1)
        )
      )
    )
    (for (in offset (..< 0 (. bound slots count)))
      (let slot (+ (. bound slots start) offset))
      (let row ([] (. bindings slots) slot))
      (if (or (!= (. row kind) .slot-lazy) uncaptured (!= ([] lazy-held slot) 0))
        (continue)
      )
      (lazy uncaptured (== (/and/ (. row flags) (. SlotFlag slot-captured)) 0))
      (let value (call lazy-value tree (. row group)))
      (if (== value 0)
        (continue)
      )
      (for (in node (.. (call (. tree subtree-start) value) value))
        (let read (call read-slot binding node))
        (if (and (!= read no-slot) (>= read (. bound slots start)) (< read slots-end))
          (= ([] needed (- read (. bound slots start))) 1)
        )
        (lazy slots-end (+ (. bound slots start) (. bound slots count)))
      )
    )
    (for (in offset (..< 0 (. bound slots count)))
      (let slot (+ (. bound slots start) offset))
      (let row ([] (. bindings slots) slot))
      (let plain (or (== (. row kind) .slot-argument) (== (. row kind) .slot-local)))
      (if (and plain (== ([] needed offset) 0) (!= (/and/ (. row flags) (. SlotFlag slot-shared-read)) 0))
        (= ([] unneeded slot) 1)
      )
    )
  )
  (fn-do _ may-hold Bool
    (param binding BindingId)
    (param tree AST)
    (param slot SlotId)
    (param typed IdList)
    (param nested-scopes (of Map Size U32 ArenaBacking))
    ; Whether a lazy local is held as `settle-held` says, before the values of others are looked at.
    (let bound ([] (. bindings bindings) binding))
    (let row ([] (. bindings slots) slot))
    (if (or (!= (. row kind) .slot-lazy) (== (/and/ (. row flags) (. SlotFlag slot-captured)) 0) (== (. row use) (. U32 max)))
      (return false)
    )
    (if (or unshared (call (. bindings lazy-together) slot) (call (. bindings value-tracks) tree (. row group)))
      (return false)
    )
    (lazy unshared (!= (call (. bindings lazy-policy) slot) .lazy-shared))
    (let use (call (. bindings lazy-use-of) slot))
    (let apart U32 (. LazyUseFlag declared-in-loop))
    (= apart (/or/ apart (. LazyUseFlag read-in-subscription)))
    (= apart (/or/ apart (. LazyUseFlag read-in-state-machine)))
    (if (or (!= (. use writes) 0) (!= (. use refs) 0) (!= (. use tracked) 0) (!= (/and/ (. use flags) apart) 0))
      (return false)
    )
    (let value (call lazy-value tree (. row group)))
    (if (== value 0)
      (return false)
    )
    (let dominated (call (. bindings lazy-dominated) slot))
    (let home (call (. bindings function-scope) (. row scope)))
    (let declared false)
    (for (in position (..< 0 (. typed length)))
      (let instance ([] typed position))
      (let owner ([] (. instances rows) instance))
      (if (!= (?? ([] nested-scopes (. (call DeclRef (. owner module) (. owner decl)) key)) (. bound scopes start)) home)
        (continue)
      )
      (if (or (!= (. owner initializer) 0) has-fills (call in-live-statement instance tree (. row group)))
        (return false)
      )
      (lazy has-fills (or (!= (. owner fills count) 0) (. owner fills-share)))
      (if (and (not dominated) (not (call cheap-value binding tree instance value 0)))
        (return false)
      )
      (= declared true)
    )
    (return declared)
  )
  (fn-do _ in-live-statement Bool
    (param instance InstanceId)
    (param tree AST)
    (param id SyntaxId)
    ; Whether a node is a live statement of an instance or is written in the value of one, outside
    ; the functions written in it, as a lazy local attached to a live value is, which each run of
    ; the statement evaluates again.
    (for (in node (..< id (as (. tree nodes length) SyntaxId)))
      (if (> (call (. tree subtree-start) node) id)
        (continue)
      )
      (if (call live-statement-of instance node)
        (return true)
      )
      (if (is ([] (. tree nodes) node) .node-function-syntax)
        (return false)
      )
    )
    (return false)
  )
  (fn-do _ cheap-value Bool
    (param binding BindingId)
    (param tree AST)
    (param instance InstanceId)
    (param value SyntaxId)
    (param depth U32)
    ; Whether evaluating the value of a lazy local where a nested function that reads it is made,
    ; rather than where it is first read, changes nothing: it reads only numbers written in it, the
    ; arguments of its function, which nothing assigns, and other lazy locals whose values are as
    ; cheap, and works on them only with operators that are built in and cannot fail. A conversion
    ; there calls nothing.
    (if (> depth 4)
      (return false)
    )
    (for (in node (.. (call (. tree subtree-start) value) value))
      (if (or calls forces (not (call plain-conversions instance node)))
        (return false)
      )
      (lazy calls (!= (call (. facts first-call) instance node) no-fact))
      (lazy forces (!= (call (. facts first-force) instance node) no-fact))
      (let cheap false)
      (match? ([] (. tree nodes) node)
        (case .node-integer-syntax
          (= cheap true)
        )
        (case .node-float-syntax
          (= cheap true)
        )
        (case (call .node-identifier row)
          (let read (call read-slot binding node))
          (if (and (not (. row is-tracked)) (!= read no-slot) not-case-read)
            (= cheap (call cheap-read binding tree instance read depth))
          )
          (lazy not-case-read (!= (call (. facts plan-of) instance node) .plan-case-read))
        )
        (case (call .node-unary-expression row)
          (= cheap (or (== (. row op) .negative-op) (== (. row op) .not-op)))
        )
        (case (call .node-binary-expression row)
          (if (or (== (. row op) .and-op) (== (. row op) .or-op))
            (= cheap true)
            (else-if (call cheap-operator (. row op))
              (= cheap (== (call (. facts plan-of) instance node) .plan-builtin))
            )
          )
        )
      )
      (if (not cheap)
        (return false)
      )
    )
    (return true)
  )
  (fn-expr _ cheap-read Bool
    (param binding BindingId)
    (param tree AST)
    (param instance InstanceId)
    (param slot SlotId)
    (param depth U32)
    ; Whether a read in a cheap value is of an argument nothing assigns, or of a lazy local with a
    ; cheap value of its own that is evaluated where it is read once.
    (case? (!= (/and/ (. row flags) changing) 0)
      false
    )
    (case? (== (. row kind) .slot-argument)
      true
    )
    (case? (or (!= (. row kind) .slot-lazy) (== (. row use) (. U32 max)) (call (. bindings lazy-together) slot))
      false
    )
    (case? (or (!= (. use writes) 0) (!= (. use refs) 0) (!= (. use tracked) 0))
      false
    )
    (default
      (and (!= value 0) (call cheap-value binding tree instance value (+ depth 1)))
    )
    (where
      (lazy row ([] (. bindings slots) slot))
      (lazy changing (/or/ (. SlotFlag slot-assigned) (. SlotFlag slot-tracked) (. SlotFlag slot-address-taken)))
      (lazy use (call (. bindings lazy-use-of) slot))
      (lazy value (call lazy-value tree (. row group)))
    )
  )
  (fn-expr _ cheap-operator Bool
    (param op Operator)
    (match op
      (case .add-op
        true
      )
      (case .subtract-op
        true
      )
      (case .multiply-op
        true
      )
      (case .bitwise-and-op
        true
      )
      (case .bitwise-or-op
        true
      )
      (case .bitwise-xor-op
        true
      )
      (case .bitwise-lshift-op
        true
      )
      (case .bitwise-rshift-op
        true
      )
      (case .bitwise-zrshift-op
        true
      )
      (case .less-than-op
        true
      )
      (case .greater-than-op
        true
      )
      (case .less-than-equals-op
        true
      )
      (case .greater-than-equals-op
        true
      )
      (case .equals-op
        true
      )
      (case .not-equals-op
        true
      )
      (default
        false
      )
    )
  )
  (fn-do _ plain-conversions Bool
    (param instance InstanceId)
    (param node SyntaxId)
    ; Whether each conversion the type pass recorded at a node keeps the value it converts, calling
    ; nothing.
    (let fact (call (. facts first-conversion) instance node))
    (while (!= fact no-fact)
      (let row ([] (. facts conversions) fact))
      (if (or (!= (. row callee) no-instance) (!= (. row runs) no-instance) (. row casts))
        (return false)
      )
      (let kept
        (scope (or (== (. row kind) .relation-same) (== (. row kind) .relation-equal) side-cast)
          (lazy side-cast (== (. row kind) .relation-side-cast))
        )
      )
      (if (and (not kept) (!= (. row kind) .relation-up-cast) (!= (. row kind) .relation-wrap-cast))
        (return false)
      )
      (= fact (. row next))
    )
