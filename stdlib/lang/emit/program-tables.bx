  (fn-do + mapping-names StringId
    (param tree AST)
    (param mappings (of RowRange SyntaxId))
    ; The names of a rule's that a call gives collectors for, in the order written, joined by
    ; commas, or none where it gives none.
    (if (== (. mappings count) 0)
      (return no-string)
    )
    (let joined "")
    (for (in mapping ([] (. tree children) mappings))
      (match? ([] (. tree nodes) mapping)
        (case (call .node-stream-collector-mapping row)
          (let name (if-expr (. row callee) (. row callee text) (. row caller text)))
          (= joined (if-expr (== (. joined length) 0) name (str joined "," name)))
        )
      )
    )
    (return (call (. bundle intern) joined))
