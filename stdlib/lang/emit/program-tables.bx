  (fn-do + given-receiver TypeId
    (param index U32)
    ; The receiver where the values of the application a site applies, around an application of
    ; `style-applications`, are written: that of the instance that types them, or, where that one is
    ; written in another and reads its receiver, such as an arm of a markup region, that of the one
    ; it is written in.
    (let top ([] (. facts style-applications) index))
    (while (!= (. top outer) (. U32 max))
      (= top ([] (. facts style-applications) (. top outer)))
    )
    (let typing (if-expr (!= (. top values) no-instance) (. top values) (. top instance)))
    (while (and (== (. ([] (. instances rows) typing) self-type) no-type) (!= (. ([] (. instances rows) typing) enclosing) no-instance))
      (= typing (. ([] (. instances rows) typing) enclosing))
    )
    (return (. ([] (. instances rows) typing) self-type))
  )
  (fn-do + given-author U32
    (param application U32)
    (param site SyntaxId)
    ; The place among `given-functions` of the function that declares again the line `site` of the
    ; rule an application applies, or `U32.max`.
