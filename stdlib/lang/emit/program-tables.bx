    (let instance-count U32 (as (. instances length) U32))
    (let kinds (call (of (. arena allocate) U32) instance-count))
    (= instance-functions (call (of (. arena allocate) U32) instance-count))
    (= c-symbols (call (of (. arena allocate) U32) instance-count))
    (= c-suspends (call (of (. arena allocate) U8) instance-count))
    (= c-described (call (of (. arena allocate) U32) instance-count))
    (= slots (call (of (. arena allocate) U32) instance-count))
    (= initializer-functions (call (of (. arena allocate) U32) instance-count))
    (= body-functions (call (of (. arena allocate) U32) instance-count))
    (= step-functions (call (of (. arena allocate) U32) instance-count))
