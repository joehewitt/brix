    )
    (for (in name memory-copy-runtime-names)
      (call (. bundle mark-memory-copy-callee) (call (. bundle intern) name))
      (call (. bundle mark-memory-copy-callee) (call (. bundle intern) (call (. target symbol) name)))
    )
    (for (in name safe-struct-runtime-names)
