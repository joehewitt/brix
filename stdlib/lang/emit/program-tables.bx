      (let latest (and (== (. row kind) .slot-local) (call holds-latest instance (. row syntax))))
      (let empty (and (or stepped (== (. row kind) .slot-subscribers) latest) (== type no-type) (not unread)))
      (if (or (and (== type no-type) (not unread) (not empty)) (== type invalid-type))
