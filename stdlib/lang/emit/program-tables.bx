  (fn-do + given-row-items (list RowItemRead)
    (param index U32)
    (let top ([] (. facts style-applications) index))
    (while (!= (. top outer) (. U32 max))
      (= top ([] (. facts style-applications) (. top outer)))
    )
    (let result (list RowItemRead))
    (let slots (list SlotId))
    (let written (. ([] (. program modules) (. top module)) tree))
    (let binding (. ([] (. instances rows) (. top instance)) binding))
    (match? ([] (. written nodes) (. top written))
      (case (call .node-style-rule-application applied)
        (for (in value ([] (. written children) (. applied args)))
          (for (in node (.. (call (. written subtree-start) value) value))
            (let held (call (. facts row-item-of) (. top instance) node))
            (if (== held no-type)
              (continue)
            )
            (let resolution (call (. bindings resolution-of) binding node))
            (if (and (== (. resolution kind) .resolve-slot) (== (call (. slots find) (. resolution slot)) null))
              (+= slots (. resolution slot))
              (+= result (call RowItemRead (. top instance) node held))
