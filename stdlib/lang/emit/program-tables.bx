    )
    (= (. bundle gc-public-control-word-symbol) (call (. bundle intern) (call (. target symbol) ([] backend-runtime-names 0))))
    (= (. bundle write-barrier-record-symbol) (call (. bundle intern) (call (. target symbol) ([] backend-runtime-names 1))))
    (= (. bundle zero-stack-frame-symbol) (call (. bundle intern) (call (. target symbol) ([] backend-runtime-names 2))))
    (= (. bundle bulk-write-barrier-symbol) (call (. bundle intern) (call (. target symbol) ([] backend-runtime-names 3))))
    (= (. bundle memory-copy-symbol) (call (. bundle intern) (call (. target symbol) ([] memory-copy-runtime-names 0))))
    (= (. bundle memory-zero-symbol) (call (. bundle intern) (call (. target symbol) ([] memory-copy-runtime-names 1))))
    (= (. bundle thread-cache-symbol) (call (. bundle intern) (call (. target symbol) ([] allocation-runtime-names 0))))
    (= (. bundle allocation-refill-symbol) (call (. bundle intern) (call (. target symbol) ([] allocation-runtime-names 1))))
    (= (. bundle allocate-object-symbol) (call runtime-symbol .runtime-allocate-object))
    (call (. bundle mark-safepoint-free) (. bundle thread-cache-symbol))
    (for (in name safepoint-free-runtime-names)
