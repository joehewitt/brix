  (fn-do + style-registrations (list FunctionId)
    (param module ModuleId)
    ; The functions that register the styles a module declares, in the order of the places they
    ; are registered at and then of the styles' declarations, so the order is the same however the
    ; styles were numbered.
    (let found (list FunctionId))
    (let keys (list U64))
    (for (in id style-functions)
      (if (== (. ([] functions id) module) module)
        (let use ([] style-uses (. ([] functions id) place)))
        (call add-registration found keys id (. use module) (. use site) (. use type))
      )
    )
    (return found)
  )
  (fn-do + sheet-registrations (list FunctionId)
    (param module ModuleId)
    ; The functions that register the style sheets a module declares, in the order of the places
    ; they are registered at and then of the sheets' declarations.
    (let found (list FunctionId))
    (let keys (list U64))
    (for (in id sheet-functions)
      (if (== (. ([] functions id) module) module)
        (let use ([] style-sheet-uses (. ([] functions id) place)))
        (call add-registration found keys id (. use module) (. use site) (. use type))
      )
    )
    (return found)
  )
  (fn-expr + machine-receiver TypeId
    (param machine MachineFact)
    ; The class whose object a machine a property holds, or the class's content writes, is
    ; written for: that of the receiver of the instance it is written in.
    (if-expr (!= unit no-instance) (. ([] (. instances rows) unit) self-type) no-type)
    (where
      (lazy unit (. ([] (. instances rows) (. machine instance)) enclosing))
    )
  )
  (fn-do + machine-classes (list TypeId)
    (param machine MachineFact)
    ; The classes the program constructs whose objects run a machine, by rank: the class it is
    ; written for, and where a property of that class holds it, each class below, which starts the
    ; same machine (`find-unit`) or one that refines it, as each does where the class's markup
    ; writes it, whose filler the filler of each class below runs.
