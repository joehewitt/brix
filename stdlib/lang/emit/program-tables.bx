        (= ([] (. module-paths data) (. function module))
          (call (. bundle intern)
            (block
              (arg (. ([] (. program modules) (. function module)) relative-path))
            )
          )
        )
      )
      (let start U32 (. calls length))
      (if (and (== (. function kind) .module-init) (!= ([] main-functions (. function module)) no-function))
        (= calls (call (. calls appended) arena ([] main-functions (. function module))))
        (else-if (== (. function kind) .task-main)
          (let starts (. program batch-order-starts))
          (let modules (. program batch-order-modules))
          (let first Size (if-expr (== root-count 0) 0 (as ([] starts (. function place)) Size)))
          (let last Size (if-expr (== root-count 0) (. order length) (as ([] starts (+ (. function place) 1)) Size)))
          (for (in position (..< first last))
            (let module (if-expr (== root-count 0) ([] order position) ([] modules position)))
            (if (!= ([] constants-functions module) no-function)
              (= calls (call (. calls appended) arena ([] constants-functions module)))
            )
          )
          (for (in position (..< first last))
            (let module (if-expr (== root-count 0) ([] order position) ([] modules position)))
            (if (!= ([] statics-functions module) no-function)
              (= calls (call (. calls appended) arena ([] statics-functions module)))
            )
            (let local ([] task-local-heads module))
            (while (!= local no-storage)
              (= calls (call (. calls appended) arena (. ([] storage local) function)))
              (= local (. ([] storage local) next))
