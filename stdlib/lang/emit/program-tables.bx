        (+= held no-type)
      )
    )
    (if stepped
      (for (in offset (..< 0 (. bound scopes count)))
        (let loop (+ (. bound scopes start) offset))
        (if (or not-loop (== ([] scope-captures loop) 0) (!= (call (. bindings function-scope) loop) scope))
          (continue)
        )
