      (let layout (if-expr (or (== type no-type) (== type invalid-type)) no-layout ([] (. layouts values) type)))
      (if (== layout no-layout)
        (return unbuilt-environment)
      )
      (+= children (if-expr (call refers instance slot) pointer-layout layout))
      (+= held type)
    )
    (for (in row stacks)
      (if (== row no-storage)
        (return unbuilt-environment)
      )
      (+= children (. ([] storage row) layout))
      (+= held no-type)
    )
    (return (call (. layouts environment) children held (str "capture." (call hex-text ([] (. instances stable-keys) instance)))))
