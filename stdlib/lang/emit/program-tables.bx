  (fn-do + This _
    (param program Program)
    (param instances Instances)
    (param facts Facts)
    (param types Types)
    (param bindings Bindings)
    (lazy bundle (call Bundle))
    (lazy layouts (call Layouts types bundle arena))
    (lazy unions (call UnionTables types layouts arena))
    (lazy functions (call (of Table EmittedFunction) arena 16))
    (lazy style-uses (call (of List PlacedStyle) arena))
    (lazy style-sheet-uses (call (of List PlacedStyle) arena))
    (lazy class-tables (call (of Table ClassTable) arena 4))
    (lazy storage (call (of Table GlobalStorage) arena 16))
    (lazy refusals (call (of Table Refusal) arena 4))
    (lazy class-rules (call (of Table ClassRule) arena 4))
    (lazy event-handlers (call (of Table EventHandler) arena 4))
    (lazy defaults (call (of Table PropertyDefault) arena 16))
    (lazy adapters (call (of Table Adapter) arena 4))
    (lazy rule-mappings (call (of Table RuleMapping) arena 4))
    (lazy adapter-rows (call (of Map Size U32) arena))
    (lazy closure-ranks (call (of Map Size U32) arena))
    (lazy stream-action-rows (call (of Map Size U32) arena))
    (lazy machine-handler-rows (call (of Map Size U32) arena))
    (lazy machine-part-rows (call (of Map Size U32) arena))
    (lazy machine-stop-rows (call (of Map Size U32) arena))
    (lazy made-numbers (call (of Map Size U32) arena))
    (lazy pattern-argument-rows (call (of Map Size U32) arena))
    (lazy pattern-environments (call (of Map Size U32) arena))
    (lazy lazy-rule-rows (call (of Map Size U32) arena))
    (lazy rule-adapter-rows (call (of Map Size U32) arena))
    (lazy class-rule-rows (call (of Map Size U32) arena))
    (lazy class-rule-heads (call (of Map Size U32) arena))
    (lazy markup-rule-heads (call (of Map Size U32) arena))
    (lazy growth-rows (call (of Map Size U32) arena))
    (lazy read-rule-rows (call (of Map Size U32) arena))
    (lazy made-ranks (call (of Map Size U32) arena))
    (lazy converter-suffixes (call (of Map Size U32) arena))
    (lazy witnesses (call (of Table Witness) arena 4))
    (lazy witness-functions (call (of Table WitnessFunction) arena 4))
    (lazy witness-rows (call (of Map Size U32) arena))
    (lazy class-adapters (call (of Table ClassAdapter) arena 4))
    (lazy class-adapter-rows (call (of Map Size U32) arena))
    (lazy forward-rows (call (of Map Size U32) arena))
