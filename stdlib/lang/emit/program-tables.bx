  (variant style-themed-value (= 70))
  (variant style-given-author (= 71))
  (variant raise-message (= 72))
  (variant raise-panic (= 73))
)

(type + GlobalKind (is U8)
  ; How a module keeps a global. A constant's value is a literal, stored before any module
  ; starts. An eager one takes its value when its module starts, and a lazy one when it is
  ; first read. One each task holds its own of is `global-task`, kept in the memory of each
  ; task, and one each thread holds its own of `global-thread`, in the memory of each thread.
  ; One `do with` binds is `global-stack`, a slot in the memory of each task that says whether
  ; it is bound and holds its value, unless nothing binds it and its value is a literal, which
  ; makes it a constant. A value of an enum is made
  ; when its module starts, before the module's eager globals, where an emitted function reads
  ; it; one nothing emitted reads is `global-enum-unread`, and is not made.
  (blank)
  (variant global-none (= 0))
  (variant global-constant (= 1))
  (variant global-eager (= 2))
  (variant global-lazy (= 3))
  (variant global-other (= 4))
  (variant global-enum (= 5))
  (variant global-enum-unread (= 6))
  (variant global-task (= 7))
  (variant global-thread (= 8))
  (variant global-stack (= 9))
)

(type + RefusedConstruct (is U32)
  (variant refused-nothing (= 0))
  (variant refused-statement (= 1))
  (variant refused-expression (= 2))
  (variant refused-print-conversion (= 3))
  (variant refused-global-initializer (= 4))
  (variant refused-probe (= 5))
  (variant refused-type (= 6))
  (variant refused-function (= 7))
  (variant refused-conversion (= 8))
  (variant refused-blocking-call (= 9))
  (variant refused-suspending-call (= 10))
  (variant refused-batch-local (= 11))
  (variant refused-allocation (= 12))
)

(type + Refusal (is Struct)
  ; A construct emission does not compile yet, and where it is written. A program with one is
  ; not compiled at all.
  (blank)
  (prop + construct RefusedConstruct)
  (prop + module ModuleId)
  (prop + syntax SyntaxId)
)

(type + ProbeRow (is Struct)
  ; A probe an emitted instance compiles, which the record of probes knows by its place among them,
  ; counted from one. One written as a group that begins and ends, or as a log that ends a group,
  ; is a probe for each record it writes, its `part`s in order. A counter is one probe wherever its
  ; key is written, and a count the compiler keeps of its own accord, of what the collector did or
  ; what events do, has no instance, its `part` saying which (see `compiler-count-key`). `types` are
  ; the probe data types of the values a probe writes, among `probe-types`, with the class of each
  ; among `probe-type-classes`. A metric of the profile is a row of its own among `profile-metrics`,
  ; with its `part` saying whether it counts or times.
  (blank)
  (prop + instance InstanceId)
  (prop + syntax SyntaxId)
  (prop + part U32)
  (prop + types Span)
)

(type + ProbeSiteKind (is U8)
  (variant log (= 1))
  (variant event (= 2))
  (variant counter (= 3))
  (variant timer (= 4))
)

(type + ProbeSite
  (prop + kind _ (= (. ProbeSiteKind counter)))
  (prop + key _ (= ""))
  (prop + name _ (= ""))
  (prop + template _ (= ""))
  (prop + module-name _ (= ""))
  (prop + path _ (= ""))
  (prop + line U32)
  (prop + fields (list String))
)

(type + EventCount (is U32)
  ; A count the compiler keeps of what events do, under the counter `event-counts` numbers at its
  ; place, as the reference keeps one wherever an event is published, made a stream or handled by a
  ; machine: the compiler adds to the publishes, the publish sites never reached, the publishes
  ; nothing listens to and the payloads made, and the event runtime's own counters to the rest.
  (blank)
  (variant publish-attempts (= 0))
  (variant publish-sites-erased (= 1))
  (variant publish-interest-misses (= 2))
  (variant payload-builds (= 3))
  (variant sidecars-created (= 4))
  (variant endpoint-entries (= 5))
  (variant subscriptions-sidecar (= 6))
  (variant subscriptions-lowered (= 7))
  (variant adapters-created (= 8))
  (variant handlers-sync (= 9))
  (variant handlers-machine-enqueued (= 10))
  (variant descriptor-visits (= 11))
  (variant route-frames (= 12))
  (variant key-index-updates (= 13))
)

(type + EmittedFunction (is Struct)
  ; A function the object holds. `name` is its key text, `symbol` the linker's name for it, and
  ; `display` the name a stack trace prints. `calls` are the functions a generated body calls,
  ; in order. `may-panic` says a call of it has a landing pad, and `carries` that it is made as
  ; one that may return a panic although it raises none, because a class table holds it or it
  ; suspends. `polls` says its body has a loop that polls, or a rule it runs first does: it
  ; returns the panic a poll can raise, and no call of it has a landing pad for that.
  ; `unplaced` says a stack trace through it may not be the reference's, by more than a number
  ; in a name: one that may panic is refused. `placeless` says a stack trace names no place for
  ; its code. `site-module` is the module whose file a stack trace names for its code, where that
  ; is not the module it is made in.
  ; The function of a lazy property has no instance: `type` is the class that writes the
  ; property's value and `place` the property's place among all properties. The functions
  ; that give a module's globals their values have none either, and `place` is the storage of
  ; the global a lazy one's function evaluates. The function of a default a call evaluates has
  ; the default's storage as its `place`. The function that grows a table's storage has none:
  ; `type` is the type of the table's rows, and `place` is 0 for the rows and 1 for the outside
  ; bytes of a union's. `bridge-display` is the name a stack trace prints for
  ; the function of a member that runs on a row's case where it is built as a bridge to the
  ; member's instance on the case. One made for a row of style facts that typing fills in the
  ; order it reaches instances, a value written once, a gate, a state cell, a slot forward, an
  ; author or a shared rule, is named by its `number`, its place among those of its kind in an
  ; order that does not depend on that one.
  (blank)
  (prop + kind FunctionKind)
  (prop + instance InstanceId)
  (prop + module ModuleId)
  (prop + name StringId)
  (prop + symbol StringId)
  (prop + display StringId)
  (prop + calls Span)
  (prop + weight U32)
  (prop + may-panic Bool)
  (prop + carries Bool)
  (prop + polls Bool)
  (prop + type TypeId (= no-type))
  (prop + place U32)
  (prop + number U32)
  (prop + unplaced Bool)
  (prop + placeless Bool)
  (prop + bridge-display StringId (= no-string))
  (prop + site-module ModuleId (= (. U32 max)))
)

(type + ClassTable (is Struct)
  ; The table of a class the program constructs: its header, then the functions of each class
  ; of its chain, base first. `entries` lists those functions.
  (blank)
  (prop + type TypeId)
  (prop + symbol StringId)
  (prop + base U32)
  (prop + entries Span)
)

(type + RuleMapping (is Struct)
  ; A set of collectors calls of a rule give it, for which the reference compiles a function of
  ; the rule of its own: the instance whose rule or local rule it is, the local rule's
  ; declaration or none for the rule a module declares, the rule's names the collectors are
  ; given for in the order written, joined by commas, and the function made for them. No call
  ; that runs such a function reads what the rule gives, so it makes no text of what its arms
  ; matched. Calls of a rule a module declares that give no collectors and read nothing it gives
  ; have one too, whose names are none.
  (blank)
  (prop + instance InstanceId)
  (prop + rule SyntaxId)
  (prop + names StringId)
  (prop + function FunctionId)
)

(type + ClassRule (is Struct)
  ; A rule of a class, typed for the class that writes it as `level`: the instance that types it,
  ; the layout of what it keeps for each object it runs on, which is the object and then whether
  ; a `when` rule's test held when it last ran or the value a `whenever` rule had then, and the
  ; function a live action runs it again with. A `whenever` rule on the markup an object is in
  ; keeps what `class-rule-kept` says, and the markup runtime calls `add` and `remove` as its
  ; children or descendants change, or `add` as its ancestors might have.
  (blank)
  (prop + level TypeId)
  (prop + module ModuleId)
  (prop + decl DeclId)
  (prop + syntax SyntaxId)
  (prop + unit InstanceId)
  (prop + kept LayoutId)
  (prop + updater FunctionId)
  (prop + add FunctionId)
  (prop + remove FunctionId)
)

(type + EventHandler (is Struct)
  ; A section of a class that the event runtime runs from the table of a class the program
  ; constructs: the instance that types the section, the section, the subscriber of its loop,
  ; whose body the function for it runs, the class that writes it, the event's name, and the
  ; number that tells the function apart from others of the class and the event.
  (blank)
  (prop + unit InstanceId)
  (prop + syntax SyntaxId)
  (prop + callback InstanceId)
  (prop + level TypeId)
  (prop + name Atom)
  (prop + number U32)
)

(type + MachineDescriptor (is Struct)
  ; A group of a state machine's event transitions that the event runtime runs from the table of
  ; a class the program constructs: the group's place among the facts' groups, the class, the
  ; function the table runs, which gives the group's activation to the event runtime's queue, and
  ; the function that says whether an object is of the class.
  (blank)
  (prop + group U32)
  (prop + type TypeId)
  (prop + descriptor FunctionId)
  (prop + matcher FunctionId)
)

(type + Adapter (is Struct)
  ; The function a closure or a binding runs as a value of a function type. It is given the
  ; data the value holds and the type's arguments, and calls `runs`, the instance the type
  ; pass found for them. `instance` and `site` are where the first conversion that makes such
  ; a value is written, which a stack trace names for the call, or the place the type pass
  ; noted for a closure, with `below` where that is the line under it. `fixed` says the type
  ; pass noted the place. Any other, made at several places, is placed at the first written. One
  ; made at several places is `shared`, and a stack trace names no place for it: one the type
  ; pass placed where it says so, and any other where `made-instance` and `made-site`, where
  ; the first conversion is written, differ from a later one's.
  (blank)
  (prop + from TypeId)
  (prop + to TypeId)
  (prop + runs InstanceId)
  (prop + instance InstanceId)
  (prop + site SyntaxId)
  (prop + function FunctionId (= no-function))
  (prop + fixed Bool)
  (prop + below Bool)
  (prop + shared Bool)
  (prop + made-instance InstanceId (= no-instance))
  (prop + made-site SyntaxId (= 0))
)

(type + Witness (is Struct)
  ; The witness table of a type for an interface. `symbol` names the constant, and `slot` is
  ; the place the table of a class holds its address in, for a type that is a class.
  (blank)
  (prop + value TypeId)
  (prop + interface TypeId)
  (prop + symbol StringId)
  (prop + slot U32 (= no-slot-index))
)

(type + WitnessFunction (is Struct)
  ; The function a slot of a witness table holds for a type that declares its own answer to
  ; a function of the interface: it is given the interface value and calls `callee` with
  ; what the value holds, or with no callee reads the property at `property` of it. Where
  ; the type answers through a property it delegates to, `through` names the properties
  ; read from what the value holds to what `callee` takes. `converts` says `callee` takes an
  ; argument as another type than the interface's gives, as the type pass recorded. A `shared`
  ; one fills the slot in the table of each class that answers with `callee` itself, and
  ; `value` is the first of them.
  (blank)
  (prop + value TypeId)
  (prop + proto InstanceId)
  (prop + callee InstanceId)
  (prop + property U32)
  (prop + through (of RowRange U32))
  (prop + function FunctionId (= no-function))
  (prop + converts Bool (= false))
  (prop + shared _ (= false))
)

(type + ClassAdapter (is Struct)
  ; The function a slot of a class's table holds for an override that answers another type
  ; than `proto`, the function the slot was made for: it calls `override` and converts what
  ; that answers to what `proto` answers. For a getter or a setter that objects of `receiver`
  ; answer with a `property` they store, there is no override: it reads the property or stores
  ; its argument there.
  (blank)
  (prop + proto InstanceId)
  (prop + override InstanceId)
  (prop + function FunctionId (= no-function))
  (prop + receiver TypeId (= no-type))
  (prop + property U32 (= (. U32 max)))
)

(type + GlobalStorage (is Struct)
  ; Where the program keeps a global, or the value of a parameter's default that runs code.
  ; `symbol` names its memory, which `layout` holds a value of `type` in. `state` names a byte
  ; beside a global that is not a constant: 0 while it has no value, 1 once it has, and 2 while
  ; a lazy one is being evaluated. `function` evaluates a lazy global that some emitted
  ; function reads. A default is kept for `owner`, the instance whose parameter it is: `syntax`
  ; is the default written, and `next` the default its module evaluates after it. A default a
  ; call evaluates has no memory: `function` evaluates it, and no module's list holds it. A
  ; global each task holds its own of is kept at `offset` in the memory of the task running,
  ; which has no symbol: `function` stores its value there, and `next` is the one of its module
  ; stored after it. One each thread holds its own of is `per-thread`, kept in the memory of
  ; the thread.
  (blank)
  (prop + module ModuleId)
  (prop + decl DeclId)
  (prop + syntax SyntaxId)
  (prop + owner InstanceId)
  (prop + symbol StringId)
  (prop + state StringId)
  (prop + type TypeId)
  (prop + layout LayoutId)
  (prop + function FunctionId)
  (prop + next U32)
  (prop + offset U32 (= (. U32 max)))
  (prop + per-thread Bool)
)

(type + PropertyDefault (is Struct)
  ; The value a class gives a property its constructor is given none for: the module it is
  ; written in, the value, the declaration its conversion is recorded at, and that declaration
  ; among its module's. A property no class gives a value has value 0.
  (blank)
  (prop + module ModuleId)
  (prop + value SyntaxId)
  (prop + site SyntaxId)
  (prop + decl DeclId)
)

(type + PlacedStyle (is Struct)
  ; A style or a style sheet some instance uses, numbered by its place among them, as the program
  ; registers it: `type`, `singleton` and the `count` rows from `first` are its `StyleUse`'s or its
  ; `StyleSheetUse`'s. `registered` says a function the program reaches uses it, and `module` and
  ; `site` are then where its registration is placed (`keep-reached-styles`).
  (blank)
  (prop + type TypeId)
  (prop + module ModuleId)
  (prop + site SyntaxId)
  (prop + singleton InstanceId)
  (prop + first U32)
  (prop + count U32)
  (prop + registered Bool)
)

(fn-expr + is-executable-statement Bool
  (param tree AST)
  (param statement SyntaxId)
  ; Whether a module's statement runs when the module starts: one that neither declares
  ; something nor is a comment.
  (and (not (call is-declaration-syntax tree statement)) (not (call is-comment-syntax tree statement)))
)

(fn-do + symbol-name String
  (param target Target)
  (param key String)
  ; The linker's name on a target for a function: its key, or a hash of the key when the key is too
  ; long for a symbol.
  (if (<= (. key size) max-symbol-bytes)
    (return (call (. target symbol) key))
  )
  (let hash (call fnv-hash key (. key size)))
  (let text ([] Byte 17))
  (= ([] text 0) 121)
  (for (in position (..< 0 16))
    (let digit (as (/and/ (/zrshift/ hash (- 60 (* position 4))) 15) U32))
    (= ([] text (+ 1 position)) (as (if-expr (< digit 10) (+ digit 48) (+ digit 87)) Byte))
  )
  (return (call (. target symbol) (call (. text slice-string) (..< 0 17))))
)

(type _ Reach (is U32)
  (variant none)
  (variant main)
  (variant init)
  (variant task)
  (variant body (= 5))
  (variant in-frame (= 6))
  (variant initializer (= 7))
)

(type _ VisitFact (is U32)
  ; The tables of facts a visit of an instance reads its own rows of, in the order it reads them.
  (blank)
  (variant visit-live-statement (= 0))
  (variant visit-markup-read (= 1))
  (variant visit-style-read (= 2))
  (variant visit-style-flag (= 3))
  (variant visit-style-site (= 4))
  (variant visit-style-content (= 5))
  (variant visit-style-application (= 6))
  (variant visit-content-link (= 7))
  (variant visit-element-root (= 8))
  (variant visit-branch-region (= 9))
  (variant visit-loop-region (= 10))
  (variant visit-region-root (= 11))
  (variant visit-self-action (= 12))
  (variant visit-query-registration (= 13))
  (variant visit-event-use (= 14))
  (variant visit-address-claim (= 15))
  (variant visit-event-closer (= 16))
  (variant visit-machine-group (= 17))
  (variant visit-machine-refinement (= 18))
  (variant visit-machine-stop (= 19))
  (variant visit-slot-outlet (= 20))
  (variant visit-slot-choice (= 21))
)

(fn-do _ is-literal-value Bool
  (param types Types)
  (param source AST)
  (param syntax SyntaxId)
  ; Whether an expression is a constant that running no code gives: a number, a text, or one of
  ; the two truths.
  (match? ([] (. source nodes) syntax)
    (case .node-integer-syntax
      (return true)
    )
    (case .node-float-syntax
      (return true)
    )
    (case .node-string-syntax
      (return true)
    )
    (case (call .node-identifier row)
      (return (or (== (. row name) (. types true-atom)) (== (. row name) (. types false-atom))))
    )
  )
  (return false)
)

(fn-expr _ unnamed-function EmittedFunction
  (param kind FunctionKind)
  (param instance InstanceId)
  (param module ModuleId)
  (param weight U32)
  ; A function's row before the tables name it and list its calls.
  (call EmittedFunction
    (block
      (arg kind)
      (arg instance)
      (arg module)
      (arg no-string)
      (arg no-string)
      (arg no-string)
      (arg (call Span))
      (arg weight)
      (arg false)
      (arg false)
    )
  )
)

(fn-expr + global-offset U32
  (param kept GlobalStorage)
  (if-expr (== (. kept offset) (. U32 max)) 0 (. kept offset))
)
