          (break)
        )
      )
    )
    (return found)
  )
  (fn-do + leaf-classes (list TypeId)
    (param machine MachineFact)
    ; The classes the program constructs whose objects start a machine a property of a class holds,
    ; by rank: the class it is written for and each class below that declares the property no value
    ; of its own (`find-unit`).
    (let type (call machine-receiver machine))
    (let found (list TypeId))
    (let name (? Atom) null)
    (match? ([] (. ([] (. program modules) (. machine module)) decls) (. machine decl))
      (case (call .decl-property row)
        (= name (. row name))
      )
