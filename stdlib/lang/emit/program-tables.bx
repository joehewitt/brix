  (fn-do + build _
    (call (. bundle begin-building))
    (= (. bundle gc-enabled) true)
    (= (. bundle stack-trace-metadata) true)
    (= (. bundle apple-abi) (. program target uses-apple-abi))
    (= (. bundle output-mode) 0)
    (= (. bundle gc-allocation-buffer-version) gc-allocation-buffer-version)
    (= (. bundle gc-control-phase-mask) gc-control-phase-mask)
    (call name-runtime)
    (call mark-memo-places)
    (call (. layouts build))
    (call (. unions build))
    (call index-fills)
    (call index-overrides)
    (call index-recursion)
    (call index-applications)
    (call index-sites)
    (= bounded (call (of (. arena allocate) Byte) (+ (. instances length) 1)))
    (for (in position (..< 0 (+ (. instances length) 1)))
      (= ([] bounded position) 0)
    )
    (= default-count (as (. types properties length) U32))
    (= default-rows (call (of (. arena allocate) U32) default-count))
    (= value-units (call (of (. arena allocate) U32) (+ default-count 1)))
    (= lazy-slots (call (of (. arena allocate) U32) (+ default-count 1)))
    (= lazy-functions (call (of (. arena allocate) U32) (+ default-count 1)))
    (= updater-functions (call (of (. arena allocate) U32) (+ default-count 1)))
    (let query-count (. facts markup-queries length))
    (= query-used (call (of (. arena allocate) Byte) (+ query-count 1)))
    (= query-functions (call (of (. arena allocate) U32) (+ (* query-count 2) 1)))
    (for (in position (..< 0 query-count))
      (= ([] query-used position) 0)
      (= ([] query-functions (* position 2)) no-function)
      (= ([] query-functions (+ (* position 2) 1)) no-function)
    )
    (= lazy-roots (call (of (. arena allocate) U32) (+ default-count 1)))
    (= lazy-raising (call (of (. arena allocate) Byte) (+ default-count 1)))
    (= lazy-written (call (of (. arena allocate) Byte) (+ default-count 1)))
    (= lazy-results (call (of (. arena allocate) U32) (+ default-count 1)))
    (for (in position (..< 0 default-count))
      (= ([] default-rows position) (. U32 max))
      (= ([] value-units position) no-instance)
      (= ([] lazy-slots position) no-slot-index)
      (= ([] lazy-functions position) no-function)
      (= ([] updater-functions position) no-function)
      (= ([] lazy-roots position) (. U32 max))
      (= ([] lazy-raising position) 0)
      (= ([] lazy-written position) 0)
      (= ([] lazy-results position) (. U32 max))
    )
