      (= fact ([] fill-links fact))
    )
    (return no-fact)
  )
  (fn-do + loose-conversion FactId
    (param instance InstanceId)
    (param site SyntaxId)
    (param from TypeId)
    (param reason ConversionReason (= .reason-assignment))
    (param to TypeId (= no-type))
    ; The conversion of a value of one type that an instance recorded for one reason at a node
    ; outside its body, or none. A constructor's are at the properties its arguments fill, and
    ; at those it constructs with no value written, for the defaults that construction takes,
    ; which may convert values of one type to several: `to` names the one wanted, where given.
