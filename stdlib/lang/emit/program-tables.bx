    (let found (list TypeId))
    (if (== type no-type)
      (return found)
    )
    (if (and (!= (. machine store) .store-member) (!= (. machine store) .store-content))
      (if (!= ([] constructed type) 0)
        (+= found type)
      )
      (return found)
    )
    (for (in class (. types ranked))
      (if (and (!= ([] constructed class) 0) (call is-class class) (or (== class type) (call derives class type)))
        (+= found class)
      )
    )
    (return found)
  )
  (fn-do + constructs-from Bool
    (param type TypeId)
    ; Whether the program constructs a class that is a type or derives from it.
    (for (in class (. types ranked))
      (if (and (!= ([] constructed class) 0) (call is-class class) (or (== class type) (call derives class type)))
        (return true)
      )
    )
    (return false)
  )
  (fn-do + refining-classes (list TypeId)
    (param machine MachineFact)
    ; The classes the program constructs whose objects run a machine that refines a machine written
    ; as a line of a class's markup, directly or through others, by rank: the class each refining
    ; machine is written for and each class below it. Their objects start the machine with the one
    ; that refines it, and not where the markup of the machine's class runs.
    (let found (list TypeId))
    (if (or (!= (. machine store) .store-content) (!= (. machine outer) 0))
      (return found)
    )
    (let receivers (list TypeId))
    (for (in fact (. facts machines))
      (if (or (!= (. fact store) .store-content) (!= (. fact outer) 0) (== (. fact refined) no-instance))
        (continue)
      )
      (let current (? MachineFact) (call (. facts machine-of) (. fact refined)))
      (while (and current (!= (. current instance) (. machine instance)))
        (= current (only-if (call (. facts machine-of) (. current refined)) (if (!= (. current refined) no-instance))))
      )
      (let type (call machine-receiver fact))
      (if (and current (!= type no-type) (== (call (. receivers find) type) null))
        (+= receivers type)
      )
    )
    (if (== (. receivers length) 0)
      (return found)
    )
    (for (in class (. types ranked))
      (if (or (== ([] constructed class) 0) (not (call is-class class)))
        (continue)
      )
      (for (in type receivers)
        (if (or (== class type) (call derives class type))
