    (return mask)
  )
  (fn-expr + target-number U32
    (param target-id U32)
    ; The number the markup runtime knows the target of descendant queries by, as the type pass
    ; numbers them from 1 (`Facts.query-targets`), or 0 for none: its place among them in the order
    ; of the stable keys of their classes, which does not depend on the order typing found them in.
    (if-expr (!= target-id 0) ([] target-numbers (- target-id 1)) 0)
