      (let target ([] (. facts query-targets) index))
      (let held (? TypeId) level)
      (while (and held (== (call (. types intrinsic-of) held) .class))
        (if (== held target)
          (+= found (as (+ index 1) U32))
          (break)
        )
        (= held (call (. types base-of) held))
      )
    )
    (return found)
