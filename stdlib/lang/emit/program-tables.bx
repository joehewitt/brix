    (param decl DeclId)
    (as ([] global-kinds (+ ([] storage-starts module) decl)) GlobalKind)
  )
  (fn-do + default-storage U32
    (param callee InstanceId)
    (param syntax SyntaxId)
    ; The storage of a default that runs code, by the instance whose parameter it is and the
    ; default written, or none.
    (let row ([] default-starts callee))
