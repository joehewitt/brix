    )
    (return no-instance)
  )
  (fn-expr + class-rules-of (list U32)
    (param type TypeId)
    ; The rules a constructor of a class runs once its body has run, in order, as rows of
    ; `class-rules`.
    (call rules-from ([] class-rule-heads type))
