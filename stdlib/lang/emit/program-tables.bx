        (+= place-decls decl)
        (+= place-rows row)
        (+= place-children (as (. children length) U32))
        (+= children (. ([] storage row) layout))
        (+= held no-type)
      )
    )
    (return (call (. layouts environment) children held (str "env." (call hex-text ([] (. instances stable-keys) instance)))))
  )
  (fn-do _ makes-holders Bool
    (param instance InstanceId)
    ; Whether a function writes a nested function, other than a spawned task's body or that of a
    ; `do without gc` block, that holds the state of a global `do with` binds.
    (for (in hold (. facts stack-holds))
      (if (and (== (. ([] (. instances rows) (. hold instance)) enclosing) instance) (not (call copies-in (. hold instance))) (not fixed))
        (return true)
      )
      (lazy fixed (== (call global-kind (. hold module) (. hold decl)) .global-constant))
    )
    (return false)
  )
  (fn-do _ lay-captures _
    ; Lays out the capture of the body of each spawned task emitted, and of each `do without gc`
    ; block: an object the collector owns, made where the task is spawned or the block runs, that
    ; holds each local, item of a loop, argument and receiver the body captures, in the order the
    ; binder recorded them, as the instance that declares it types it. A body that captures nothing
    ; has none. One that captures anything else is not built, nor is a block's that holds the state
    ; of a global `do with` binds.
    (let count (. instances length))
    (= captures (call (of (. arena allocate) U32) (+ count 1)))
    (= capture-rows (call (of (. arena allocate) U32) (+ count 1)))
    (let rows (call (of Map Size U32) arena))
    (for (in index (..< 0 (. bindings bindings length)))
      (let bound ([] (. bindings bindings) index))
      (for (in offset (..< 0 (. bound nested count)))
        (let nested (+ (. bound nested start) offset))
        (= ([] rows (. (call DeclRef (. bound module) (. ([] (. bindings nested) nested) decl)) key)) nested)
      )
    )
    (for (in instance (..< 0 count))
      (= ([] captures instance) no-layout)
      (= ([] capture-rows instance) (. U32 max))
    )
    (for (in instance (. instances ordered))
      (if (or (== ([] instance-functions instance) no-function) (not (call copies-in instance)))
        (continue)
      )
      (let row ([] (. instances rows) instance))
      (let found ([] rows (. (call DeclRef (. row module) (. row decl)) key)))
      (if (or (not found) (== (. row binding) no-binding))
        (= ([] captures instance) unbuilt-environment)
        (continue)
      )
      (= ([] capture-rows instance) found)
      (= ([] captures instance)
