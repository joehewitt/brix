    (if stepped
      (+= children i32-layout)
      (+= held no-type)
    )
    (let position U32)
    (for (in offset (..< 0 (. bound slots count)))
      (let slot (+ (. bound slots start) offset))
      (let row ([] (. bindings slots) slot))
      (let own (== ([] slot-functions slot) scope))
      (let type no-type)
      (if (and own (== (. row kind) .slot-argument))
        (= type (call (. instances argument-type) instance position))
        (+= position 1)
        (else-if (and own (== (. row kind) .slot-this))
          (let view (call receiver-view instance))
          (= type (if-expr (!= view no-type) view (. ([] (. instances rows) instance) self-type)))
        )
        (else-if (and own (or stepped (== (. row kind) .slot-local) (== (. row kind) .slot-lazy) (== (. row kind) .slot-pattern) (== (. row kind) .slot-location) (== (. row kind) .slot-subscribers) (== (. row kind) .slot-builder) (== (. row kind) .slot-machine)))
          (= type (call (. facts slot-type) instance offset))
        )
        (else-if (and own (or (== (. row kind) .slot-each) (== (. row kind) .slot-it)))
          (= type (call (. facts slot-type) instance offset))
        )
      )
