        )
        (if (and lazy (== type no-type))
          (= layout u8-layout)
        )
        (let named (or (== (. row kind) .slot-local) (== (. row kind) .slot-loop-item) (== (. row kind) .slot-each) (== (. row kind) .slot-it) (== (. row kind) .slot-pattern) (== (. row kind) .slot-machine)))
        (let written
          (scope (and assigned (== (/and/ (. row flags) (. SlotFlag slot-placed)) 0))
            (lazy assigned (!= (/and/ (. row flags) (. SlotFlag slot-assigned)) 0))
          )
        )
        (let watched (and (!= (/and/ (. row flags) (. SlotFlag slot-tracked)) 0) written))
