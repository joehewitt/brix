      )
      (let layout (if-expr unread u8-layout (if-expr empty void-layout ([] (. layouts values) type))))
      (if (== layout no-layout)
        (return unbuilt-environment)
      )
      (+= children layout)
      (+= held type)
      (if (and (== (. row kind) .slot-lazy) (== ([] lazy-held slot) 0))
