                (= calls (call (. calls appended) arena registering))
              )
            )
            (if (!= ([] globals-functions module) no-function)
              (= calls (call (. calls appended) arena ([] globals-functions module)))
            )
            (let init ([] init-functions module))
            (if (!= init no-function)
              (= calls (call (. calls appended) arena init))
            )
            (if (and (== module probe-module) (!= probe-setup no-function))
              (= calls (call (. calls appended) arena probe-setup))
            )
          )
          (if (!= probe-flush no-function)
            (= calls (call (. calls appended) arena probe-flush))
          )
        )
        (else-if (== (. function kind) .probe-closer)
          (if (!= task-init no-function)
            (= calls (call (. calls appended) arena task-init))
          )
          (= calls (call (. calls appended) arena probe-teardown))
        )
        (else-if (== (. function kind) .process-main)
          (= calls
            (call (. calls appended)
              (block
                (arg arena)
                (arg (if-expr (== root-count 0) ([] instance-functions task) batch-main))
              )
            )
          )
        )
        (else-if (== (. function kind) .batch-main)
          (for (in position (..< 0 root-count))
            (= calls (call (. calls appended) arena ([] batch-starts position)))
          )
        )
        (else-if (and (== (. function kind) .batch-finish) (< (+ (. function place) 1) root-count))
          (= calls (call (. calls appended) arena ([] batch-starts (+ (. function place) 1))))
        )
        (else-if (== (. function kind) .task-init)
          (for (in row task-local-order)
            (= calls (call (. calls appended) arena (. ([] storage row) function)))
          )
        )
        (else-if (== (. function kind) .thread-init)
          (for (in row thread-local-order)
            (= calls (call (. calls appended) arena (. ([] storage row) function)))
          )
        )
      )
      (= (. ([] functions id) calls) (call Span start (- (. calls length) start)))
      (call name-function (as id FunctionId))
    )
    (for (in raiser (list message-raiser panic-raiser))
      (if (!= raiser no-function)
        (call (. bundle mark-cold-callee) (. ([] functions raiser) symbol))
      )
    )
    (let instance-total (. instances length))
    (let suspending (call (of (. arena allocate) U8) (if-expr suspends (+ instance-total 1) 1)))
    (if suspends
      (for (in position (..< 0 (+ instance-total 1)))
        (= ([] suspending position) 0)
      )
      (for (in fact (. facts calls))
        (if (and (!= (. fact callee) no-instance) (call checks-termination (. fact callee)))
          (= ([] suspending (. fact instance)) 1)
        )
      )
    )
    (for (in id (..< 0 (. functions length)))
      (let function ([] functions id))
      (let is-body
        (scope (or of-instance (== (. function kind) .viewed-body) (== (. function kind) .constructor-body))
          (lazy of-instance (or (== (. function kind) .instance-body) (== (. function kind) .instance-initializer)))
        )
      )
      (if (and suspends (!= (. function instance) no-instance) (!= ([] suspending (. function instance)) 0))
        (= (. ([] functions id) carries) true)
      )
      (if (== (. function kind) .generator-body)
        (= (. ([] functions id) may-panic) true)
        (= (. ([] functions id) polls) (. ([] (. instances rows) (. function instance)) polls))
        (else-if (and is-body (!= ([] step-functions (. function instance)) no-function))
          (= (. ([] functions id) may-panic) false)
        )
        (else-if (or (== (. function kind) .module-main) is-body)
          (= (. ([] functions id) may-panic) (. ([] (. instances rows) (. function instance)) may-panic))
          (= (. ([] functions id) polls) (or body-polls (call runs-polling-rule (. function instance))))
          (lazy body-polls (. ([] (. instances rows) (. function instance)) polls))
        )
        (else-if (== (. function kind) .module-init)
          (let main ([] main-functions (. function module)))
          (let runs (and (!= main no-function) (. ([] (. instances rows) (. ([] functions main) instance)) may-panic)))
          (= (. ([] functions id) may-panic) (or runs (call registers-styles (. function module))))
        )
        (else-if (== (. function kind) .task-main)
          (= (. ([] functions id) may-panic) raises)
        )
        (else-if (or (== (. function kind) .event-handler) (== (. function kind) .machine-handler))
          (= (. ([] functions id) polls) (and (!= (. function instance) no-instance) handler-polls))
          (lazy handler-polls (. ([] (. instances rows) (. function instance)) polls))
        )
        (else-if (== (. function kind) .class-rule-updater)
          (let unit (. ([] class-rules (. function place)) unit))
          (= (. ([] functions id) polls) (and (!= unit no-instance) (. ([] (. instances rows) unit) polls)))
        )
        (else-if (== (. function kind) .task-body)
          (= (. ([] functions id) may-panic) (or (. ([] (. instances rows) (. function instance)) may-panic) init-panics))
          (lazy init-panics (and (!= task-init no-function) (. ([] functions task-init) may-panic)))
          (= (. ([] functions id) polls) (. ([] (. instances rows) (. function instance)) polls))
        )
        (else-if (and (== (. function kind) .adapter) (== (. ([] adapters (. function place)) runs) no-instance))
          (= (. ([] functions id) may-panic) true)
        )
        (else-if (== (. function kind) .adapter)
          (let runs (. ([] adapters (. function place)) runs))
          (= (. ([] functions id) may-panic) (or (. ([] (. instances rows) runs) may-panic) (!= ([] called-through runs) 0)))
          (let passed (call (. facts first-passed) runs))
          (while (!= passed no-fact)
            (let converter (. ([] (. facts conversions) passed) callee))
            (if (and (!= converter no-instance) (. ([] (. instances rows) converter) may-panic))
              (= (. ([] functions id) may-panic) true)
            )
            (if (== (. ([] (. facts conversions) passed) kind) .relation-unwrap-cast)
              (= (. ([] functions id) may-panic) true)
            )
            (= passed (. ([] (. facts conversions) passed) next))
          )
        )
        (else-if (== (. function kind) .union-dispatch)
          (= (. ([] functions id) may-panic) (call forward-panics ([] (. facts forwards) (. function place))))
        )
        (else-if (== (. function kind) .interface-equality)
          (= (. ([] functions id) may-panic) (. ([] (. instances rows) (. function instance)) may-panic))
        )
        (else-if (and (== (. function kind) .class-adapter) (== (. ([] class-adapters (. function place)) override) no-instance))
          (= (. ([] functions id) may-panic) false)
        )
        (else-if (== (. function kind) .class-adapter)
          (let adapter ([] class-adapters (. function place)))
          (= (. ([] functions id) may-panic) (. ([] (. instances rows) (. adapter override)) may-panic))
          (let written (. ([] (. instances rows) (. adapter override)) subtree))
          (if (!= (. written count) 0)
            (let passed (call (. facts first-conversion) (. adapter override) (- (+ (. written start) (. written count)) 1)))
            (while (!= passed no-fact)
              (let converter (. ([] (. facts conversions) passed) callee))
              (if (and (!= converter no-instance) (. ([] (. instances rows) converter) may-panic))
                (= (. ([] functions id) may-panic) true)
              )
              (= passed (. ([] (. facts conversions) passed) next))
            )
          )
        )
        (else-if (== (. function kind) .witness)
