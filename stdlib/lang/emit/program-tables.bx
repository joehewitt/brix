        (let slot (+ (. bound slots start) position))
        (if (!= ([] slot-homes slot) loop)
          (continue)
        )
        (let row ([] (. bindings slots) slot))
        (let type (call (. facts slot-type) instance position))
        (let lazy (== (. row kind) .slot-lazy))
