    (lazy live-statement-places (call (of Map Size U32) arena))
    (lazy member-machines (call (of Map Size U32) arena))
    (lazy turn-layouts (call (of Map Size U32) arena))
    (lazy turn-places (call (of Map Size U32) arena))
    (lazy witness-fills (call (of Map Size U32) arena))
    (lazy witness-made (call (of Map Size U32) arena))
    (lazy witness-based (call (of Map Size U32) arena))
    (lazy witness-shared (call (of Map Size U32) arena))
    (lazy based-fills (call (of Map Size U32) arena))
    (lazy section-rows (call (of Map Size U32) arena))
    (lazy table-heads (call (of Map Size U32) arena))
    (lazy value-table-heads (call (of Map Size U32) arena))
    (lazy application-heads (call (of Map Size U32) arena))
    (lazy rule-unit-heads (call (of Map Size U32) arena))
    (lazy rule-function-rows (call (of Map Size U32) arena))
    (lazy class-witness-heads (call (of Map Size U32) arena))
    (lazy class-witness-tails (call (of Map Size U32) arena))
