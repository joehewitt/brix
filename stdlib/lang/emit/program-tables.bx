      (. RuntimeFunction runtime-allocate-buffer)
    )
    (case? (== name (!! (. types resize-buffer-atom)))
      (. RuntimeFunction runtime-resize-buffer)
    )
    (case? (== name (!! (. types copy-slice-atom)))
      (. RuntimeFunction runtime-copy-slice)
    )
    (case? (== name (!! (. types arena-reserve-atom)))
      (. RuntimeFunction runtime-arena-reserve-described)
    )
