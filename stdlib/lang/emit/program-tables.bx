        (let kind (as (- ([] kinds instance) 1) FunctionKind))
        (if (and (== kind .instance-body) (call is-task instance))
          (= kind .task-body)
        )
        (let id FunctionId (as (. functions length) FunctionId))
        (let weight U32 1)
        (if (== kind .module-main)
          (= ([] main-functions (. row module)) id)
          (= weight (as (. ([] (. program modules) (. row module)) tree nodes length) U32))
          (else-if (== kind .module-init)
            (= ([] init-functions (. row module)) id)
          )
          (else-if (== kind .instance-body)
            (= weight (+ (. row subtree count) 1))
          )
        )
        (= ([] instance-functions instance) id)
        (call (. functions append) (call unnamed-function kind instance (. row module) weight))
        (if (and (== kind .task-main) (!= ([] root-cases (. row module)) (. U32 max)))
          (= (. ([] functions id) place) ([] root-cases (. row module)))
          (= ([] batch-starts ([] root-cases (. row module))) id)
        )
        (if (and (== kind .instance-body) (call is-rerun instance))
          (call declare-live-adapter id)
        )
        (if (and (== kind .instance-body) (!= (call receiver-view instance) no-type))
          (= ([] body-functions instance) (as (. functions length) U32))
          (call (. functions append) (call unnamed-function .viewed-body instance (. row module) weight))
        )
        (if (and (== kind .instance-body) (call fills-apart instance))
          (= ([] body-functions instance) (as (. functions length) U32))
          (call (. functions append) (call unnamed-function .constructor-body instance (. row module) weight))
        )
        (if (and (== kind .instance-body) (. row is-generator))
          (= ([] step-functions instance) (as (. functions length) U32))
          (call (. functions append) (call unnamed-function .generator-body instance (. row module) weight))
        )
      )
      (if (!= ([] initialized instance) 0)
        (= ([] initializer-functions instance) (as (. functions length) U32))
        (call (. functions append)
          (block
            (arg (call unnamed-function .instance-initializer instance (. row module) (+ (. row subtree count) 1)))
          )
        )
      )
    )
    (call declare-lazies)
    (call declare-updaters)
    (call declare-queries)
    (call declare-class-rules)
    (call declare-event-handlers)
    (call declare-style-registrations)
    (call number-keys)
    (call declare-style-gates)
    (call declare-scope-cells)
    (call declare-kept-cells)
    (call declare-slot-forwards)
    (call declare-style-authors)
    (call declare-given-authors)
    (call declare-static-values)
    (call declare-themed-values)
    (call declare-shared-rules)
    (call declare-idle-action)
    (call declare-defaults kinds)
    (call declare-stream-actions)
    (call declare-machine-handlers)
    (call declare-machine-descriptors)
    (call declare-pattern-arguments)
    (call declare-lazy-rules)
    (call declare-mapped-rules)
    (call declare-raising-rules)
    (call declare-growths)
    (call declare-source-attacher)
    (call declare-probes kinds)
    (call declare-adapters)
    (call declare-witnesses)
    (call declare-class-adapters)
    (call declare-forwards)
    (call declare-const-arrays)
    (call declare-projection-remaps)
    (call declare-equalities)
    (call number-closures)
    (call number-made)
    (call number-converters)
    (call lay-environments)
    (call lay-captures)
    (let constants-functions (call (of (. arena allocate) U32) module-count))
    (let globals-functions (call (of (. arena allocate) U32) module-count))
    (let statics-functions (call (of (. arena allocate) U32) module-count))
    (for (in position (..< 0 module-count))
      (= ([] constants-functions position) no-function)
      (= ([] globals-functions position) no-function)
      (= ([] statics-functions position) no-function)
      (let flags ([] module-flags position))
      (if (!= (/and/ flags has-constants) 0)
        (= ([] constants-functions position) (as (. functions length) U32))
        (call (. functions append) (call unnamed-function .module-constants no-instance position 1))
      )
      (if (!= (/and/ flags has-globals) 0)
        (let id FunctionId (as (. functions length) FunctionId))
        (= ([] globals-functions position) id)
        (call (. functions append) (call unnamed-function .module-globals no-instance position 8))
        (= (. ([] functions id) may-panic) (!= (/and/ flags globals-raise) 0))
      )
      (if (!= (/and/ flags has-statics) 0)
        (let id FunctionId (as (. functions length) FunctionId))
        (= ([] statics-functions position) id)
        (call (. functions append) (call unnamed-function .module-statics no-instance position 8))
        (= (. ([] functions id) may-panic) (!= (/and/ flags statics-panic) 0))
      )
    )
    (for (in position (..< 0 (. storage length)))
      (if (!= (. ([] storage position) function) no-function)
        (let id FunctionId (as (. functions length) FunctionId))
        (let kind
          (scope (if-expr no-offset (. FunctionKind lazy-global) (. FunctionKind task-local-init))
            (lazy no-offset (== (. ([] storage position) offset) (. U32 max)))
          )
        )
        (if (!= (. ([] storage position) syntax) 0)
          (= kind .argument-default)
          (else-if (. ([] storage position) per-thread)
            (= kind .thread-local-init)
          )
          (else-if (and (== kind .task-local-init) (== declared-kind .global-stack))
            (= kind .stack-local-init)
          )
        )
        (lazy declared-kind (call global-kind (. ([] storage position) module) (. ([] storage position) decl)))
        (call (. functions append) (call unnamed-function kind no-instance (. ([] storage position) module) 8))
        (= (. ([] functions id) place) (as position U32))
        (let owned
          (scope (or task-or-thread (== kind .stack-local-init) (== kind .argument-default))
            (lazy task-or-thread (or (== kind .task-local-init) (== kind .thread-local-init)))
          )
        )
        (= (. ([] functions id) may-panic) (or (== kind .lazy-global) (and owned owner-panics)))
        (lazy owner-panics (. ([] (. instances rows) (. ([] storage position) owner)) may-panic))
        (= (. ([] storage position) function) id)
      )
    )
    (if (!= (. task-local-order length) 0)
      (= task-init (as (. functions length) FunctionId))
      (call (. functions append) (call unnamed-function .task-init no-instance entry 1))
      (for (in row task-local-order)
        (if (. ([] functions (. ([] storage row) function)) may-panic)
          (= (. ([] functions task-init) may-panic) true)
        )
      )
    )
    (if (!= (. thread-local-order length) 0)
      (= thread-init (as (. functions length) FunctionId))
      (call (. functions append) (call unnamed-function .thread-init no-instance entry 1))
      (for (in row thread-local-order)
        (if (. ([] functions (. ([] storage row) function)) may-panic)
          (= (. ([] functions thread-init) may-panic) true)
        )
      )
    )
    (if (call compiles-probes)
      (let probes (as probe-module ModuleId))
      (= probe-setup (as (. functions length) FunctionId))
      (call (. functions append) (call unnamed-function .probe-setup no-instance probes 1))
      (= (. ([] functions probe-setup) may-panic) true)
      (= probe-teardown (as (. functions length) FunctionId))
      (call (. functions append) (call unnamed-function .probe-teardown no-instance probes 1))
      (= (. ([] functions probe-teardown) may-panic) true)
      (= probe-closer (as (. functions length) FunctionId))
      (call (. functions append) (call unnamed-function .probe-closer no-instance probes 1))
      (= (. ([] functions probe-closer) may-panic) true)
      (= probe-flush (as (. functions length) FunctionId))
      (call (. functions append) (call unnamed-function .probe-flush no-instance probes 1))
      (= (. ([] functions probe-flush) may-panic) true)
      (= probe-safepoint (as (. functions length) FunctionId))
      (call (. functions append) (call unnamed-function .probe-safepoint no-instance probes 1))
      (= (. ([] functions probe-safepoint) may-panic) true)
      (= probe-loops (call (. program probes compiles-safepoints)))
    )
    (if (!= root-count 0)
