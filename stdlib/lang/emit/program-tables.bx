      (let inner (. hold instance))
      (if (or (!= (. ([] (. instances rows) inner) enclosing) instance) (call copies-in inner) fixed)
        (continue)
      )
      (lazy fixed (== (call global-kind (. hold module) (. hold decl)) .global-constant))
      (let decl (. ([] (. instances rows) inner) decl))
      (let row
        (scope (if-expr on-stack (call storage-of (. hold module) (. hold decl)) no-storage)
