(import ./emitter)
(import ./layouts)
(import ./program-tables)
(import ./receiver-stability)
(import ./runtime)
(import ./table-layouts)
(import /core/arena)
(import /core/table)
(import /lang/ast/ast)
(import /lang/ast/ast-children)
(import /lang/ast/ast-nodes)
(import /lang/ast/ast-queries)
(import /lang/ast/decl)
(import /lang/ast/module)
(import /lang/ast/operator)
(import /lang/ast/program)
(import /lang/ast/row-range)
(import /lang/ast/state-machines)
(import /lang/backend/mir)
(import /lang/check/binding)
(import /lang/check/claims)
(import /lang/check/facts)
(import /lang/check/instances)
(import /lang/check/machine-composite)
(import /lang/check/numeric)
(import /lang/check/pattern-helper)
(import /lang/check/probe-casts)
(import /lang/check/table-rows)
(import /lang/check/type-signature)
(import /lang/check/type-store)
(import /lang/check/type-text)
(import /lang/check/types)
(import /lang/ir/ir)
(import /stream/sort)

(type _ GrowRegion (is Tuple)
  ; A region of a growing table's storage: the slot of the directory it fills, the bytes a row takes
  ; in it and their alignment, and the name panics give it.
  (blank)
  (prop + column U32)
  (prop + stride U32)
  (prop + alignment U32)
  (prop + name String)
)

(type _ ResolvedSpan (is Tuple)
  ; Where the indices an index span reads lie, once checked, and the first of them.
  (blank)
  (prop + data Operand)
  (prop + offset Operand)
)

(type _ BuilderState (is Tuple)
  ; What an index span reads of an arena's builder: the identity of its storage, how many items
  ; it holds, its mutation generation, and its arena's owner and incarnation.
  (blank)
  (prop + identity Operand)
  (prop + size Operand)
  (prop + mutation Operand)
  (prop + owner Operand)
  (prop + incarnation Operand)
)

(type _ TableBounds (is Tuple)
  ; Where a range of a table, or of a view of one, starts and how many rows or items it spans,
  ; from the range made forward.
  (blank)
  (prop + start Operand)
  (prop + length Operand)
)

(type _ TableRange (is Tuple)
  ; A range indexing a table or a view of one, as its key was evaluated: the range and its type,
  ; or, where `sides` holds, only its start and end, of a range of indexes written without a step,
  ; which runs `through` its end or stops before it; `unit` holds where its step is one.
  (blank)
  (prop + range Operand)
  (prop + type TypeId)
  (prop + start Operand)
  (prop + end Operand)
  (prop + through Bool)
  (prop + sides Bool)
  (prop + unit Bool)
)

(type _ Tables (facet-of FunctionEmitter)
  (fn-do _ proven-table U32
    (param id SyntaxId)
    (if (!= (call (. facts plan-of) (. unit reading) id) .plan-table)
      (return (. U32 max))
    )
    (let found (call (. facts table-of) (. unit reading) id))
    (if (not found)
      (return (. U32 max))
    )
    (if (!= (. found op) (. TableOp proven-row))
      (return (. U32 max))
    )
    (return (call proven-loop (. found loop)))
  )
  (fn-do _ proven-field Operand
    (param id SyntaxId)
    (param loop SyntaxId)
    (param column U32)
    (param index Operand)
    (param field LayoutField)
    (let found (call proven-read loop column))
    (if (!= found (. U32 max))
      (return (. ([] proven-reads found) value))
    )
    (let read
      (call take
        (block
          (arg (call item-cell id (call hoisted-column loop column) index (. field layout)))
          (arg (call LayoutField 0 (. field layout) (. field type)))
          (arg id)
        )
      )
    )
    (+= proven-reads (call ProvenRead loop column (. ir current) read (. field type)))
    (return read)
  )
  (fn-do _ hoisted-column Operand
    (param loop SyntaxId)
    (param column U32)
    (for (in held proven-columns)
      (if (and (== (. held loop) loop) (== (. held column) column))
        (return (call load-local (. held local) loop))
      )
    )
    (let local (call (. ir add-local) pointer-layout))
    (+= proven-columns (call ProvenColumn loop column local))
    (return (call load-local local loop))
  )
  (fn-do + emit-table-constructor _
    (param declared SyntaxId)
    (param kind DeclKind)
    ; A table's constructor the compiler generates: one of a size makes storage for that many rows,
    ; each zero, and one of a size and a filler then fills each row in turn with what the filler
    ; answers for its index, scattering it into the columns. One of an arena, and of a capacity,
    ; makes a table that grows in the arena.
    (if (call is-index-span-constructor-kind kind)
      (call emit-span-constructor declared kind)
      (return)
    )
    (let type (. ([] (. instances rows) (. unit instance)) self-type))
    (let row (call table-row-type type))
    (let row-kind (if-expr (!= row no-type) (call (. types intrinsic-of) row) (. IntrinsicKind none)))
    (if (and (!= row-kind .struct) (!= row-kind .union))
      (call refuse .refused-function declared)
      (return)
    )
    (let grows (or (== kind .table-arena-constructor-decl) (== kind .table-capacity-constructor-decl)))
    (if (and (!= kind .table-size-constructor-decl) (!= kind .table-filler-constructor-decl) (not grows))
      (call refuse .refused-function declared)
      (return)
    )
    (let layout (call layout-of type declared))
    (let row-layout (call layout-of row declared))
    (let signature ([] (. instances signatures) (. unit instance)))
    (for (in position (..< 0 (. signature args count)))
      (call (. ir add-argument) (call layout-of (call (. instances argument-type) (. unit instance) position) declared))
    )
    (if (or (not (call (. tables layouts is-struct) layout)) (not (call (. tables layouts is-struct) row-layout)))
      (call refuse .refused-function declared)
      (return)
    )
    (= returns-type type)
    (= (. ir returns) layout)
    (if (== row-kind .union)
      (call emit-union-constructor declared kind layout row row-layout)
      (return)
    )
    (if grows
      (let needed
        (scope (if-expr (== kind .table-capacity-constructor-decl) second (call integer .machine-u64 0))
          (lazy second (call make-operand .operand-argument 1))
        )
      )
      (call grown-table declared layout row row-layout needed)
      (return)
    )
    (let size (call make-operand .operand-argument 0))
    (let columns (call fixed-columns declared row-layout size))
    (if (== kind .table-filler-constructor-decl)
      (call fill-table declared row row-layout columns size (call make-operand .operand-argument 1))
    )
    (let zero (call integer .machine-u64 0))
    (call return-table declared layout columns size (call TableMeta zero zero zero zero zero))
  )
  (fn-do _ emit-union-constructor _
    (param declared SyntaxId)
    (param kind DeclKind)
    (param layout LayoutId)
    (param row TypeId)
    (param row-layout LayoutId)
    ; A table of union rows: one that does not grow has its columns, then each row set to the first
    ; case's first value, or filled in turn with what the filler answers; one that grows is made as
    ; a table of structs is, with a column for each region.
    (let place (call (. tables unions of) row))
    (if (== place (. U32 max))
      (call refuse .refused-function declared)
      (return)
    )
    (if (or (== kind .table-arena-constructor-decl) (== kind .table-capacity-constructor-decl))
      (let needed
        (scope (if-expr (== kind .table-capacity-constructor-decl) second (call integer .machine-u64 0))
          (lazy second (call make-operand .operand-argument 1))
        )
      )
      (call grown-table declared layout row row-layout needed)
      (return)
    )
    (if (and (!= kind .table-size-constructor-decl) (!= kind .table-filler-constructor-decl))
      (call refuse .refused-function declared)
      (return)
    )
    (let size (call make-operand .operand-argument 0))
    (let columns (call union-columns declared place size))
    (if (== kind .table-filler-constructor-decl)
      (call fill-table declared row row-layout columns size (call make-operand .operand-argument 1))
      (else
        (call clear-union-rows declared place columns size)
      )
    )
    (let zero (call integer .machine-u64 0))
    (call return-table declared layout columns size (call TableMeta zero zero zero zero zero))
  )
  (fn-do _ union-columns Operand
    (param site SyntaxId)
    (param place U32)
    (param size Operand)
    ; The storage of a table of union rows that does not grow: the rows are checked to keep their
    ; outside bytes within what a handle reaches, then a directory, the tags, a column for each
    ; shared field, the inline bytes, the handles and the outside bytes.
    (let union ([] (. tables unions layouts) place))
    (if (!= (. union external-stride) 0)
      (let most (call integer .machine-u64 (/ 4294967295 (as (. union external-stride) U64))))
      (call fail-if
        (block
          (arg site)
          (arg (call compare site .compare-greater size most))
          (arg "Table union external storage exceeds the U32 handle limit")
        )
      )
    )
    (let directory (call table-buffer site managed-layout (call integer .machine-u64 (. union columns))))
    (call store directory 0 (call table-buffer site u8-layout size) false site)
    (let first (. ([] (call (. types cases-of) (. union union)) 0) type))
    (let first-layout (call layout-of first site))
    (for (in position (..< 0 (. union commons count)))
      (let common ([] (. tables unions fields) (+ (. union commons start) position)))
      (let field (call (. tables layouts field) first-layout (. common slot)))
      (call store directory (* (. common column) 8) (call table-buffer site (. field layout) size) false site)
    )
    (if (!= (. union inline-column) (. U32 max))
      (let bytes
        (call arithmetic
          (block
            (arg site)
            (arg .arithmetic-multiply)
            (arg size)
            (arg (call integer .machine-u64 (. union inline-stride)))
            (arg u64-layout)
          )
        )
      )
      (call store directory (* (. union inline-column) 8) (call table-buffer site u8-layout bytes) false site)
    )
    (if (!= (. union handle-column) (. U32 max))
      (call store directory (* (. union handle-column) 8) (call table-buffer site u32-layout size) false site)
    )
    (if (!= (. union external-column) (. U32 max))
      (let bytes
        (call arithmetic
          (block
            (arg site)
            (arg .arithmetic-multiply)
            (arg size)
            (arg (call integer .machine-u64 (. union external-stride)))
            (arg u64-layout)
          )
        )
      )
      (call store directory (* (. union external-column) 8) (call table-buffer site u8-layout bytes) false site)
    )
    (return directory)
  )
  (fn-do _ clear-union-rows _
    (param site SyntaxId)
    (param place U32)
    (param columns Operand)
    (param size Operand)
    ; Sets each row of a new table of unions, from the first, to the first case's first value.
    (let first (. ([] (call (. types cases-of) (. ([] (. tables unions layouts) place) union)) 0) type))
    (let first-layout (call layout-of first site))
    (if (call (. tables writes-constructor) first)
      (call refuse .refused-type site)
      (return)
    )
    (let counting (call open-pass site size))
    (let index (. counting index))
    (let empty (call make-fields first first-layout (call (of RowRange ArgumentFill)) (. given length) 0 site))
    (call scatter-union-case site place 0 columns index empty (call no-meta) false false)
    (call close-pass site counting)
  )
  (fn-do + union-cell Operand
    (param site SyntaxId)
    (param place U32)
    (param columns Operand)
    (param index Operand)
    (param field UnionField)
    (param item LayoutId)
    (param handle Operand)
    ; Where a row of a table of unions keeps a field of a case: in its shared field's column, among
    ; the row's inline bytes, or among the outside bytes its handle leads to.
    (let union ([] (. tables unions layouts) place))
    (if (== (. field region) .region-common)
      (return (call table-cell site columns index (. field column) item))
    )
    (if (== (. field region) .region-inline)
      (let inline (call load columns (* (. union inline-column) 8) pointer-layout site))
      (let row
        (call arithmetic
          (block
            (arg site)
            (arg .arithmetic-multiply)
            (arg index)
            (arg (call integer .machine-u64 (. union inline-stride)))
            (arg u64-layout)
          )
        )
      )
      (return
        (call moved-bytes
          (block
            (arg site)
            (arg inline)
            (arg (call arithmetic site .arithmetic-add row (call integer .machine-u64 (. field offset)) u64-layout))
          )
        )
      )
    )
    (let outside (call load columns (* (. union external-column) 8) pointer-layout site))
    (let start
      (call arithmetic
        (block
          (arg site)
          (arg .arithmetic-subtract)
          (arg (call num-cast site handle u32-layout u64-layout))
          (arg (call integer .machine-u64 1))
          (arg u64-layout)
        )
      )
    )
    (return
      (call moved-bytes
        (block
          (arg site)
          (arg outside)
          (arg (call arithmetic site .arithmetic-add start (call integer .machine-u64 (. field offset)) u64-layout))
        )
      )
    )
  )
  (fn-do + union-handle Operand
    (param site SyntaxId)
    (param place U32)
    (param columns Operand)
    (param index Operand)
    ; The handle a row of a table of unions keeps for its outside bytes.
    (let union ([] (. tables unions layouts) place))
    (return (call load (call table-cell site columns index (. union handle-column) u32-layout) 0 u32-layout site))
  )
  (fn-do _ scatter-union-case _
    (param site SyntaxId)
    (param place U32)
    (param case-index U32)
    (param columns Operand)
    (param index Operand)
    (param payload Operand)
    (param meta TableMeta)
    (param checked Bool)
    (param replacing Bool)
    ; Stores a row of one case in a table of unions: the row's handle first, where the table keeps
    ; one, then each field of the case in the order it declares them, and the tag last. `checked`
    ; says the table's metadata is given: where the table grows, the handle is to the row's outside
    ; bytes in its spill, the columns are read again from its header, and the fields are stored
    ; plainly. `replacing` says the row is one the table holds already, which keeps its handle when
    ; the case has no outside bytes, and keeps the bytes its handle leads to when it has.
    (let union ([] (. tables unions layouts) place))
    (let held ([] (. tables unions cases) (+ (. union cases start) case-index)))
    (let case-layout (call layout-of (. held type) site))
    (let handle (call integer .machine-u32 0))
    (if (!= (. union handle-column) (. U32 max))
      (let cell (call table-cell site columns index (. union handle-column) u32-layout))
      (if (!= (. held external-size) 0)
        (= handle (call case-handle site place index cell meta checked replacing))
      )
      (if (or (!= (. held external-size) 0) (not replacing))
        (call store cell 0 handle false site)
      )
    )
    (let into (if-expr checked (call growing-columns site columns meta) columns))
    (for (in position (..< 0 (. held fields count)))
      (let field ([] (. tables unions fields) (+ (. held fields start) position)))
      (let stored (call (. tables layouts field) case-layout (. field slot)))
      (let cell (call union-cell site place into index field (. stored layout) handle))
      (if checked
        (call store-row-cell site cell (. stored layout) (call take payload stored site) meta)
        (else
          (call store-cell site cell (. stored layout) (call take payload stored site))
        )
      )
    )
    (call store (call table-cell site into index 0 u8-layout) 0 (call integer .machine-u8 case-index) false site)
  )
  (fn-do _ case-handle Operand
    (param site SyntaxId)
    (param place U32)
    (param index Operand)
    (param cell Operand)
    (param meta TableMeta)
    (param checked Bool)
    (param replacing Bool)
    ; The handle of the outside bytes of a row of a case: one past the row's place among them where
    ; the table does not grow, and its handle in the spill where it grows.
    (let union ([] (. tables unions layouts) place))
    (if (not checked)
      (return (call fixed-handle site union index))
    )
    (let spilling (call (. ir reserve-block)))
    (let fixed (call (. ir reserve-block)))
    (let joined (call (. ir reserve-block)))
    (call branch (call view-grows site meta) spilling fixed)
    (call (. ir start-block) spilling)
    (let spilled (call spill-handle site place cell meta replacing))
    (let from-spilling (. ir current))
    (call jump joined)
    (call (. ir start-block) fixed)
    (let placed (call fixed-handle site union index))
    (let from-fixed (. ir current))
    (call jump joined)
    (call (. ir start-block) joined)
    (return (call phi u32-layout spilled from-spilling placed from-fixed))
  )
  (fn-do _ spill-handle Operand
    (param site SyntaxId)
    (param place U32)
    (param cell Operand)
    (param meta TableMeta)
    (param replacing Bool)
    ; The handle of a row's outside bytes in the spill of a table that grows. Every block of the
    ; spill suits every case, so a row the table holds already keeps the block its handle leads to,
    ; where it has one; any other row is given a block reserved in the spill.
    (if (not replacing)
      (return (call reserved-handle site place meta))
    )
    (let kept (call load cell 0 u32-layout site))
    (let from-kept (. ir current))
    (let reserving (call (. ir reserve-block)))
    (let joined (call (. ir reserve-block)))
    (call branch (call compare site .compare-not-equal kept (call integer .machine-u32 0)) joined reserving)
    (call (. ir start-block) reserving)
    (let reserved (call reserved-handle site place meta))
    (let from-reserving (. ir current))
    (call jump joined)
    (call (. ir start-block) joined)
    (return (call phi u32-layout kept from-kept reserved from-reserving))
  )
  (fn-do _ reserved-handle Operand
    (param site SyntaxId)
    (param place U32)
    (param meta TableMeta)
    ; The handle of a block newly reserved in the spill of a table of unions that grows: one past it.
    (return
      (call arithmetic
        (block
          (arg site)
          (arg .arithmetic-add)
          (arg (call num-cast site (call reserve-spill site place meta) u64-layout u32-layout))
          (arg (call integer .machine-u32 1))
          (arg u32-layout)
        )
      )
    )
  )
  (fn-do _ fixed-handle Operand
    (param site SyntaxId)
    (param union UnionLayout)
    (param index Operand)
    ; The handle of a row's outside bytes in a table that does not grow: one past its place.
    (let offset
      (call arithmetic
        (block
          (arg site)
          (arg .arithmetic-multiply)
          (arg index)
          (arg (call integer .machine-u64 (. union external-stride)))
          (arg u64-layout)
        )
      )
    )
    (return
      (call arithmetic
        (block
          (arg site)
          (arg .arithmetic-add)
          (arg (call num-cast site offset u64-layout u32-layout))
          (arg (call integer .machine-u32 1))
          (arg u32-layout)
        )
      )
    )
  )
  (fn-do _ reserve-spill Operand
    (param site SyntaxId)
    (param place U32)
    (param meta TableMeta)
    ; Reserves a block of outside bytes in the spill of a table of unions that grows: the table is
    ; checked as a view, and the spill's use checked to stay within what a U32 handle reaches, the
    ; spill grown where it is full, and its use counted on. Each block is as wide and as aligned as
    ; the union's widest outside bytes need, as the rows of a table that does not grow keep them,
    ; so a block suits whichever case its row holds next. The spill is grown by the function the
    ; tables declared to, as `grow-outside` says, and where they declared none, here. The answer is
    ; where the bytes start.
    (let union ([] (. tables unions layouts) place))
    (let limit 4294967295u64)
    (let text "Table union spill exceeds the U32 handle limit")
    (call validate-table site meta "Table union spill" false)
    (let used (call header-word site (. meta header) 6))
    (let stride (as (. union external-stride) U64))
    (call fail-if site (call compare site .compare-greater used (call integer .machine-u64 (- limit stride))) text)
    (let needed (call arithmetic site .arithmetic-add used (call integer .machine-u64 stride) u64-layout))
    (let capacity (call header-word site (. meta header) 7))
    (let growing (call (. ir reserve-block)))
    (let joined (call (. ir reserve-block)))
    (call branch (call compare site .compare-greater needed capacity) growing joined)
    (call (. ir start-block) growing)
    (let helper (call (. tables growth-of) (. union union) 1))
    (if (or cold (== helper no-function))
      (call grow-spill site union meta used capacity needed)
      (else
        (call grow-outside site helper meta used capacity needed)
      )
    )
    (call jump joined)
    (call (. ir start-block) joined)
    (call put-header site (. meta header) 6 needed)
    (return used)
  )
  (fn-do + grow-spill _
    (param site SyntaxId)
    (param union UnionLayout)
    (param meta TableMeta)
    (param used Operand)
    (param capacity Operand)
    (param needed Operand)
    ; Grows the spill of a table of unions: the capacity doubles as a table's of one-byte rows does,
    ; to at least 64 bytes and within what a U32 handle reaches; the bytes are reserved in the arena
    ; and those used copied over, and the directory's slot of the outside bytes and the header are
    ; given the new spill.
    (let text "Table union spill exceeds the U32 handle limit")
    (let chosen (call next-capacity site capacity needed 8 "Table capacity overflow"))
    (let least (call integer .machine-u64 64))
    (let next (call at-least site chosen least))
    (call fail-if site (call compare site .compare-greater next (call integer .machine-u64 4294967295)) text)
    (let owner (call num-cast site (. meta owner) u64-layout pointer-layout))
    (let replacement (call arena-reserve site owner (. meta incarnation) next (. union external-alignment) false))
    (call fail-if
      (block
        (arg site)
        (arg (call compare site .compare-equal replacement (call integer .machine-pointer 0)))
        (arg "Arena allocation failed while growing Table union spill")
      )
    )
    (let copying (call (. ir reserve-block)))
    (let copied (call (. ir reserve-block)))
    (call branch (call compare site .compare-greater used (call integer .machine-u64 0)) copying copied)
    (call (. ir start-block) copying)
    (let prior (call num-cast site (call header-word site (. meta header) 5) u64-layout pointer-layout))
    (call copy-bytes site replacement prior used)
    (call jump copied)
    (call (. ir start-block) copied)
    (let columns (call num-cast site (call header-word site (. meta header) 0) u64-layout pointer-layout))
    (call store columns (* (. union external-column) 8) replacement false site)
    (call put-header site (. meta header) 5 (call num-cast site replacement pointer-layout u64-layout))
    (call put-header site (. meta header) 7 next)
  )
  (fn-do _ at-least Operand
    (param site SyntaxId)
    (param value Operand)
    (param least Operand)
    ; A count raised to a least one where it is less.
    (let raising (call (. ir reserve-block)))
    (let keeping (call (. ir reserve-block)))
    (let joined (call (. ir reserve-block)))
    (call branch (call compare site .compare-less value least) raising keeping)
    (call (. ir start-block) raising)
    (call jump joined)
    (call (. ir start-block) keeping)
    (call jump joined)
    (call (. ir start-block) joined)
    (return (call phi u64-layout least raising value keeping))
  )
  (fn-do + no-meta TableMeta
    ; The metadata of a table that does not grow.
    (let zero (call integer .machine-u64 0))
    (return (call TableMeta zero zero zero zero zero))
  )
  (fn-do _ growing-columns Operand
    (param site SyntaxId)
    (param columns Operand)
    (param meta TableMeta)
    ; A table's columns read again from its header where it grows, after a store that may grow it.
    (let growing (call (. ir reserve-block)))
    (let fixed (call (. ir reserve-block)))
    (let joined (call (. ir reserve-block)))
    (call branch (call view-grows site meta) growing fixed)
    (call (. ir start-block) growing)
    (let held (call num-cast site (call header-word site (. meta header) 0) u64-layout pointer-layout))
    (let from-growing (. ir current))
    (call jump joined)
    (call (. ir start-block) fixed)
    (let from-fixed (. ir current))
    (call jump joined)
    (call (. ir start-block) joined)
    (return (call phi pointer-layout held from-growing columns from-fixed))
  )
  (fn-do _ scatter-union _
    (param site SyntaxId)
    (param place U32)
    (param columns Operand)
    (param index Operand)
    (param value Operand)
    (param meta TableMeta)
    (param checked Bool)
    (param replacing Bool)
    ; Stores a union in a row of a table of unions: the case it holds, each case tested in turn.
    (let union ([] (. tables unions layouts) place))
    (let union-layout (call layout-of (. union union) site))
    (let tag (call load value 0 u8-layout site))
    (let done (call (. ir reserve-block)))
    (for (in position (..< 0 (. union cases count)))
      (let storing (call (. ir reserve-block)))
      (let next (call (. ir reserve-block)))
      (call branch (call compare site .compare-equal tag (call integer .machine-u8 position)) storing next)
      (call (. ir start-block) storing)
      (call scatter-union-case
        (block
          (arg site)
          (arg place)
          (arg position)
          (arg columns)
          (arg index)
          (arg (call take value (call (. tables layouts case-field) union-layout position) site))
          (arg meta)
          (arg checked)
          (arg replacing)
        )
      )
      (call jump done)
      (call (. ir start-block) next)
    )
    (call jump done)
    (call (. ir start-block) done)
  )
  (fn-do _ gather-union Typed
    (param site SyntaxId)
    (param place U32)
    (param columns Operand)
    (param index Operand)
    ; A row of a table of unions read as the union: the case the tag names, built from its fields; a
    ; tag that names no case gives the first case's first value.
    (let union ([] (. tables unions layouts) place))
    (let union-layout (call layout-of (. union union) site))
    (let made (call frame union-layout))
    (let tag (call load (call table-cell site columns index 0 u8-layout) 0 u8-layout site))
    (let done (call (. ir reserve-block)))
    (for (in position (..< 0 (. union cases count)))
      (let reading (call (. ir reserve-block)))
      (let next (call (. ir reserve-block)))
      (call branch (call compare site .compare-equal tag (call integer .machine-u8 position)) reading next)
      (call (. ir start-block) reading)
      (let read (call gather-union-case site place position columns index))
      (call copy made (. (call make-union site (. union union) position read) operand) union-layout false site)
      (call jump done)
      (call (. ir start-block) next)
    )
    (let first (. ([] (call (. types cases-of) (. union union)) 0) type))
    (let first-layout (call layout-of first site))
    (if (call (. tables writes-constructor) first)
      (call refuse .refused-type site)
      (return (call Typed columns no-type))
    )
    (let empty (call make-fields first first-layout (call (of RowRange ArgumentFill)) (. given length) 0 site))
    (call copy made (. (call make-union site (. union union) 0 (call Typed empty first)) operand) union-layout false site)
    (call jump done)
    (call (. ir start-block) done)
    (return (call Typed made (. union union)))
  )
  (fn-do + gather-union-case Typed
    (param site SyntaxId)
    (param place U32)
    (param case-index U32)
    (param columns Operand)
    (param index Operand)
    ; A row of one case of a table of unions read as the case: each field from where it is kept.
    (let union ([] (. tables unions layouts) place))
    (let held ([] (. tables unions cases) (+ (. union cases start) case-index)))
    (let case-layout (call layout-of (. held type) site))
    (let handle
      (block
        (case? (!= (. union handle-column) (. U32 max))
          (call union-handle site place columns index)
        )
        (default
          (call integer .machine-u32 0)
        )
      )
    )
    (let made (call frame case-layout))
    (for (in position (..< 0 (. held fields count)))
      (let field ([] (. tables unions fields) (+ (. held fields start) position)))
      (let stored (call (. tables layouts field) case-layout (. field slot)))
      (let cell (call union-cell site place columns index field (. stored layout) handle))
      (call put made stored (call take cell (call LayoutField 0 (. stored layout) (. stored type)) site) site)
    )
    (return (call Typed made (. held type)))
  )
  (fn-do _ emit-span-constructor _
    (param declared SyntaxId)
    (param kind DeclKind)
    ; The constructor the compiler generates of an index span: the span of the whole of its source,
    ; or of the range it is given, made forward.
    (let type (. ([] (. instances rows) (. unit instance)) self-type))
    (let layout (call layout-of type declared))
    (let signature ([] (. instances signatures) (. unit instance)))
    (for (in position (..< 0 (. signature args count)))
      (call (. ir add-argument) (call layout-of (call (. instances argument-type) (. unit instance) position) declared))
    )
    (if (not (call (. tables layouts is-struct) layout))
      (call refuse .refused-function declared)
      (return)
    )
    (= returns-type type)
    (= (. ir returns) layout)
    (let ranged (== kind .index-span-range-constructor-decl))
    (let range (if-expr ranged (call make-operand .operand-argument 1) (call make-operand .operand-void 0)))
    (let range-type (if-expr ranged (call (. instances argument-type) (. unit instance) 1) no-type))
    (let in-place (call (. tables layouts is-large) layout))
    (let made (if-expr in-place (call make-operand .operand-result 0) (call frame layout)))
    (call span-into
      (block
        (arg declared)
        (arg made)
        (arg type)
        (arg layout)
        (arg (call make-operand .operand-argument 0))
        (arg (call (. instances argument-type) (. unit instance) 0))
        (arg range)
        (arg range-type)
      )
    )
    (if in-place
      (call return-nothing)
      (else
        (call return-value made declared)
      )
    )
  )
  (fn-do _ span-into _
    (param site SyntaxId)
    (param made Operand)
    (param type TypeId)
    (param layout LayoutId)
    (param source Operand)
    (param source-type TypeId)
    (param range Operand)
    (param range-type TypeId)
    ; An index span made of its source: of an array, where its items lie, from the first the range
    ; spans, or the first, for as many as the range spans, or the array holds; of an arena's
    ; builder, the identity of the builder's storage in place of where the items lie, with its
    ; mutation generation and its arena's owner, incarnation and generation, which say whether the
    ; span can still be read. A range is made forward where the constructor runs.
    (let item (call viewed-item type))
    (let item-layout (call layout-of item site))
    (let source-layout (call layout-of source-type site))
    (if (!= (call viewed-item source-type) item)
      (call refuse .refused-expression site)
      (return)
    )
    (let width (call integer .machine-u64 (. ([] (. tables layouts rows) item-layout) size)))
    (let zero (call integer .machine-u64 0))
    (let words (list Operand))
    (if (call is-array-type source-type)
      (let data (call word-at site source source-layout 0))
      (let length (call word-at site source source-layout 1))
      (let bounds (call given-bounds site range range-type length))
      (= words (list data zero (. bounds start) (. bounds length) width zero zero zero zero))
      (else-if (== (call intrinsic source-type) .array-builder)
        (let state (call builder-state site source source-layout))
        (let bounds (call given-bounds site range range-type (. state size)))
        (let mark (. pending length))
        (+= pending (call num-cast site (. state owner) u64-layout pointer-layout))
        (+= pending (. state incarnation))
        (let generation (call call-runtime .runtime-arena-generation site mark u64-layout))
        (= words
          (call List
            (block
              (item zero)
              (item (. state identity))
              (item (. bounds start))
              (item (. bounds length))
              (item width)
              (item (. state mutation))
              (item (. state owner))
              (item (. state incarnation))
              (item generation)
            )
          )
        )
      )
      (else
        (call refuse .refused-expression site)
        (return)
      )
    )
    (for (in position (..< 0 (. words length)))
      (call put-word site made layout (as position U32) ([] words position) u64-layout)
    )
  )
  (fn-do _ builder-state BuilderState
    (param site SyntaxId)
    (param builder Operand)
    (param layout LayoutId)
    ; What an index span reads of an arena's builder: the builder holds the header its copies share,
    ; which is the identity of its storage and holds the storage, its capacity, the size and the
    ; mutation generation; the builder's context is its arena.
    (let identity (call word-at site builder layout 0))
    (let held (call num-cast site identity u64-layout pointer-layout))
    (let size (call load held 16 u64-layout site))
    (let mutation (call load held 24 u64-layout site))
    (let arena-layout (. (call (. tables layouts field) layout 1) layout))
    (let arena (call part builder layout 1 site))
    (return
      (call BuilderState
        (block
          (arg identity)
          (arg size)
          (arg mutation)
          (arg (call word-at site (. arena operand) arena-layout 0))
          (arg (call word-at site (. arena operand) arena-layout 1))
        )
      )
    )
  )
  (fn-do _ given-bounds TableBounds
    (param site SyntaxId)
    (param range Operand)
    (param range-type TypeId)
    (param length Operand)
    ; The indices an index span's constructor spans: those its range spans, made forward by the
    ; call recorded for the constructor, or else every one of the source's.
    (if (== range-type no-type)
      (return (call TableBounds (call integer .machine-u64 0) length))
    )
    (let none (call make-operand .operand-void 0))
    (let fact (call (. tables loose-call) (. unit instance) 0))
    (if (or (== fact no-fact) (== (. ([] (. facts calls) fact) callee) no-instance) uncallable)
      (call refuse .refused-function site)
      (return (call TableBounds none none))
    )
    (lazy uncallable (not (call is-callable (. ([] (. facts calls) fact) callee))))
    (let mark (. pending length))
    (+= pending range)
    (let forward (call call-method (. ([] (. facts calls) fact) callee) site mark))
    (return (call checked-bounds site (. forward operand) (. forward type) length "IndexSpan" false))
  )
  (fn-do _ checked-bounds TableBounds
    (param site SyntaxId)
    (param forward Operand)
    (param forward-type TypeId)
    (param length Operand)
    (param name String)
    (param unit Bool)
    ; The indices a range made forward spans of a view `name` names, of `length` items: the range
    ; steps by one, which a range whose step is `unit` does, and starts and ends inside the length,
    ; its end not before its start.
    (let layout (call layout-of forward-type site))
    (let start (call range-index site forward forward-type layout "start"))
    (let end (call range-index site forward forward-type layout "end"))
    (if (not unit)
      (let increment (call range-index site forward forward-type layout "increment"))
      (call fail-if
        (block
          (arg site)
          (arg (call compare site .compare-not-equal (. increment operand) (call integer .machine-u64 1)))
          (arg (str name " requires a contiguous range"))
        )
      )
    )
    (return (call edge-bounds site (. start operand) (. end operand) length name))
  )
  (fn-do _ edge-bounds TableBounds
    (param site SyntaxId)
    (param start Operand)
    (param end Operand)
    (param length Operand)
    (param name String)
    ; The indices from `start` up to `end` of a view `name` names, of `length` items, which must
    ; end inside the length, and not before they start.
    (let outside (str name " range is out of bounds"))
    (call fail-if site (call compare site .compare-greater end length) outside)
    (call fail-if site (call compare site .compare-less end start) outside)
    (return (call TableBounds start (call arithmetic site .arithmetic-subtract end start u64-layout)))
  )
  (fn-do + resolve-span ResolvedSpan
    (param site SyntaxId)
    (param span Operand)
    (param layout LayoutId)
    ; Where the indices an index span reads lie: an array's, where the span holds them; a builder's,
    ; once the span is checked to read it still, as its storage holds them now. The arena must not
    ; be reset, nor rewound past the storage, and the builder neither changed nor shrunk past the
    ; span since the span was made.
    (let source (call word-at site span layout 0))
    (let identity (call word-at site span layout 1))
    (let offset (call word-at site span layout 2))
    (let length (call word-at site span layout 3))
    (let built (call (. ir reserve-block)))
    (let plain (call (. ir reserve-block)))
    (let joined (call (. ir reserve-block)))
    (call branch (call compare site .compare-not-equal identity (call integer .machine-u64 0)) built plain)
    (call (. ir start-block) built)
    (let owner (call num-cast site (call word-at site span layout 6) u64-layout pointer-layout))
    (let incarnation (call word-at site span layout 7))
    (let mark (. pending length))
    (+= pending owner)
    (+= pending incarnation)
    (let current (call call-runtime .runtime-arena-generation site mark u64-layout))
    (call fail-if
      (block
        (arg site)
        (arg (call compare site .compare-not-equal current (call word-at site span layout 8)))
        (arg "IndexSpan is stale after Arena reset")
      )
    )
    (let rewound "IndexSpan was invalidated by Arena rewind")
    (let held (call num-cast site identity u64-layout pointer-layout))
    (call fail-if
      (block
        (arg site)
        (arg
          (call compare
            (block
              (arg site)
              (arg .compare-equal)
              (arg (call arena-owns site owner incarnation held))
              (arg (call integer .machine-u8 0))
            )
          )
        )
        (arg rewound)
      )
    )
    (call fail-if
      (block
        (arg site)
        (arg
          (call compare
            (block
              (arg site)
              (arg .compare-not-equal)
              (arg (call load held 24 u64-layout site))
              (arg (call word-at site span layout 5))
            )
          )
        )
        (arg "IndexSpan was invalidated by ArrayBuilder mutation")
      )
    )
    (let size (call load held 16 u64-layout site))
    (let shrunk "IndexSpan was invalidated by ArrayBuilder shrink")
    (call fail-if site (call compare site .compare-greater offset size) shrunk)
    (call fail-if
      (block
        (arg site)
        (arg
          (call compare
            (block
              (arg site)
              (arg .compare-greater)
              (arg length)
              (arg (call arithmetic site .arithmetic-subtract size offset u64-layout))
            )
          )
        )
        (arg shrunk)
      )
    )
    (let data (call load held 0 u64-layout site))
    (let owning (call (. ir reserve-block)))
    (let owned (call (. ir reserve-block)))
    (call branch (call compare site .compare-not-equal size (call integer .machine-u64 0)) owning owned)
    (call (. ir start-block) owning)
    (let pointer (call num-cast site data u64-layout pointer-layout))
    (call fail-if
      (block
        (arg site)
        (arg
          (call compare
            (block
              (arg site)
              (arg .compare-equal)
              (arg (call arena-owns site owner incarnation pointer))
              (arg (call integer .machine-u8 0))
            )
          )
        )
        (arg rewound)
      )
    )
    (call jump owned)
    (call (. ir start-block) owned)
    (let from-built (. ir current))
    (call jump joined)
    (call (. ir start-block) plain)
    (call jump joined)
    (call (. ir start-block) joined)
    (return (call ResolvedSpan (call phi u64-layout data from-built source plain) offset))
  )
  (fn-do _ arena-owns Operand
    (param site SyntaxId)
    (param owner Operand)
    (param incarnation Operand)
    (param address Operand)
    ; Whether an arena holds an address in what it has reserved.
    (let mark (. pending length))
    (+= pending owner)
    (+= pending incarnation)
    (+= pending address)
    (return (call call-runtime .runtime-arena-owns site mark u8-layout))
  )
  (fn-do + span-item Operand
    (param site SyntaxId)
    (param resolved ResolvedSpan)
    (param position Operand)
    (param item LayoutId)
    ; The index an index span reads at a position, where its indices lie.
    (let data (call num-cast site (. resolved data) u64-layout pointer-layout))
    (let moved (call arithmetic site .arithmetic-add (. resolved offset) position u64-layout))
    (return (call load (call item-cell site data moved item) 0 item site))
  )
  (fn-do + selected-index Operand
    (param site SyntaxId)
    (param resolved ResolvedSpan)
    (param position Operand)
    (param item TypeId)
    (param item-layout LayoutId)
    ; The index of a table's row a selection reads at a position: one of a signed type below zero is
    ; out of bounds.
    (let value (call span-item site resolved position item-layout))
    (if (call is-signed-item item)
      (call fail-if
        (block
          (arg site)
          (arg (call compare site .compare-less value (call integer (. ([] (. tables layouts rows) item-layout) kind) 0)))
          (arg "TableSelection index is out of bounds")
        )
      )
    )
    (return (call num-cast site value item-layout u64-layout))
  )
  (fn-expr _ is-signed-item Bool
    (param item TypeId)
    ; Whether the indices of a span are of a signed type.
    (or (== kind .int8) (== kind .int16) (== kind .int32) (== kind .int64))
    (where
      (lazy kind (call (. types intrinsic-of) item))
    )
  )
  (fn-do _ return-table _
    (param site SyntaxId)
    (param layout LayoutId)
    (param columns Operand)
    (param size Operand)
    (param meta TableMeta)
    ; Answers a table made by its constructor: its columns, its size, and its header, owner,
    ; incarnation and generation, each zero for a table that does not grow.
    (let in-place (call (. tables layouts is-large) layout))
    (let made (if-expr in-place (call make-operand .operand-result 0) (call frame layout)))
    (call put made (call (. tables layouts field) layout 0) columns site)
    (call put made (call (. tables layouts field) layout 1) size site)
    (call put made (call (. tables layouts field) layout 2) (. meta header) site)
    (call put made (call (. tables layouts field) layout 3) (. meta owner) site)
    (call put made (call (. tables layouts field) layout 4) (. meta incarnation) site)
    (call put made (call (. tables layouts field) layout 5) (. meta generation) site)
    (if in-place
      (call return-nothing)
      (else
        (call return-value made site)
      )
    )
  )
  (fn-do _ grown-table _
    (param site SyntaxId)
    (param layout LayoutId)
    (param row TypeId)
    (param row-layout LayoutId)
    (param needed Operand)
    ; The body of the constructor of a table that grows in an arena: the header is reserved in the
    ; arena, zeroed, then the directory of its columns, one slot for each column; the arena's
    ; generation is read, the header given the directory, and room reserved for the rows the
    ; capacity asks for. The table holds the directory, a size of zero, the header, and the arena's
    ; owner, incarnation and generation.
    (let arena-type (call (. instances argument-type) (. unit instance) 0))
    (let arena (call make-operand .operand-argument 0))
    (let arena-layout (call layout-of arena-type site))
    (let owner (call part arena arena-layout 0 site))
    (let incarnation (call part arena arena-layout 1 site))
    (let header
      (call arena-reserve
        (block
          (arg site)
          (arg (. owner operand))
          (arg (. incarnation operand))
          (arg (call integer .machine-u64 64))
          (arg 8)
          (arg true)
        )
      )
    )
    (call fail-if
      (block
        (arg site)
        (arg (call compare site .compare-equal header (call integer .machine-pointer 0)))
        (arg "Arena allocation failed while creating Table header")
      )
    )
    (let count (call directory-slots row row-layout))
    (let slots U64 (if-expr (!= count 0) (as count U64) 1))
    (let directory
      (call arena-reserve
        (block
          (arg site)
          (arg (. owner operand))
          (arg (. incarnation operand))
          (arg (call integer .machine-u64 (* slots 8)))
          (arg 8)
          (arg true)
        )
      )
    )
    (call fail-if
      (block
        (arg site)
        (arg (call compare site .compare-equal directory (call integer .machine-pointer 0)))
        (arg "Arena allocation failed while creating Table directory")
      )
    )
    (let mark (. pending length))
    (+= pending (. owner operand))
    (+= pending (. incarnation operand))
    (let generation (call call-runtime .runtime-arena-generation site mark u64-layout))
    (call store header 0 directory false site)
    (for (in position (..< 1 8u32))
      (call store header (* position 8) (call integer .machine-u64 0) false site)
    )
    (let held (call num-cast site header pointer-layout u64-layout))
    (let handle (call word-at site arena arena-layout 0))
    (call reserve-rows
      (block
        (arg site)
        (arg row)
        (arg row-layout)
        (arg (call TableMeta held handle (. incarnation operand) generation (call integer .machine-u64 0)))
        (arg needed)
      )
    )
    (let columns (call num-cast site directory pointer-layout managed-layout))
    (call return-table
      (block
        (arg site)
        (arg layout)
        (arg columns)
        (arg (call integer .machine-u64 0))
        (arg (call TableMeta held handle (. incarnation operand) generation (call integer .machine-u64 0)))
      )
    )
  )
  (fn-do _ arena-reserve Operand
    (param site SyntaxId)
    (param owner Operand)
    (param incarnation Operand)
    (param bytes Operand)
    (param alignment U64)
    (param zeroed Bool)
    ; Reserves bytes in an arena, zeroed or not, for a table's storage: the address reserved, or
    ; null where the arena is gone or out of room.
    (let mark (. pending length))
    (+= pending owner)
    (+= pending incarnation)
    (+= pending bytes)
    (+= pending (call integer .machine-u64 alignment))
    (+= pending (call integer .machine-u8 (if-expr zeroed 1 0)))
    (return (call call-runtime .runtime-arena-reserve site mark pointer-layout))
  )
  (fn-do _ reserve-rows _
    (param site SyntaxId)
    (param row TypeId)
    (param row-layout LayoutId)
    (param meta TableMeta)
    (param needed Operand)
    ; Makes room in a table that grows for as many rows as are needed, where its capacity is less:
    ; by the function the tables declared to grow such rows, as `grow-outside` says, and where
    ; they declared none, here.
    (let header (call num-cast site (. meta header) u64-layout pointer-layout))
    (let current (call load header 16 u64-layout site))
    (let growing (call (. ir reserve-block)))
    (let joined (call (. ir reserve-block)))
    (call branch (call compare site .compare-greater needed current) growing joined)
    (call (. ir start-block) growing)
    (let helper (call (. tables growth-of) row 0))
    (if (or cold (== helper no-function))
      (call grow-rows site row row-layout meta current needed)
      (else
        (call grow-outside site helper meta current needed (call make-operand .operand-void 0))
      )
    )
    (call jump joined)
    (call (. ir start-block) joined)
  )
  (fn-do + grow-rows _
    (param site SyntaxId)
    (param row TypeId)
    (param row-layout LayoutId)
    (param meta TableMeta)
    (param current Operand)
    (param needed Operand)
    ; Grows a table's storage in its arena: the capacity is chosen, each region reserved again in
    ; turn with its rows copied over, then a new directory reserved and given each region, and the
    ; slot of a union's outside bytes as it was; the header is given the directory and the capacity.
    ; What was reserved before stays in the arena.
    (let regions (call grow-regions site row row-layout))
    (let width U64)
    (for (in region regions)
      (+= width (as (. region stride) U64))
    )
    (if (== width 0)
      (= width 1)
    )
    (let first U64 (if-expr (== width 1) 8 (if-expr (<= width 1024) 4 1)))
    (let next (call next-capacity site current needed first "Table capacity overflow"))
    (let header (call num-cast site (. meta header) u64-layout pointer-layout))
    (let owner (call num-cast site (. meta owner) u64-layout pointer-layout))
    (let columns (call num-cast site (call load header 0 u64-layout site) u64-layout pointer-layout))
    (let live (call load header 8 u64-layout site))
    (let replacements (list Operand))
    (for (in region regions)
      (let context (str "Table " (. region name)))
      (let bytes (call checked-bytes site next (. region stride) context))
      (let replacement (call arena-reserve site owner (. meta incarnation) bytes (. region alignment) false))
      (call fail-if
        (block
          (arg site)
          (arg (call compare site .compare-equal replacement (call integer .machine-pointer 0)))
          (arg "Arena allocation failed while growing Table")
        )
      )
      (let prior (call load columns (* (. region column) 8) pointer-layout site))
      (let copied (call checked-bytes site live (. region stride) context))
      (let copying (call (. ir reserve-block)))
      (let joined (call (. ir reserve-block)))
      (call branch (call compare site .compare-greater copied (call integer .machine-u64 0)) copying joined)
      (call (. ir start-block) copying)
      (call copy-bytes site replacement prior copied)
      (call jump joined)
      (call (. ir start-block) joined)
      (+= replacements replacement)
    )
    (let count (call directory-slots row row-layout))
    (let slots U64 (if-expr (!= count 0) (as count U64) 1))
    (let directory
      (call arena-reserve
        (block
          (arg site)
          (arg owner)
          (arg (. meta incarnation))
          (arg (call integer .machine-u64 (* slots 8)))
          (arg 8)
          (arg true)
        )
      )
    )
    (call fail-if
      (block
        (arg site)
        (arg (call compare site .compare-equal directory (call integer .machine-pointer 0)))
        (arg "Arena allocation failed while growing Table directory")
      )
    )
    (for (in slot (..< 0 count))
      (let kept (call make-operand .operand-void 0))
      (let found false)
      (for (in position (..< 0 (. regions length)))
        (if (== (. ([] regions position) column) slot)
          (= kept ([] replacements position))
          (= found true)
        )
      )
      (if (not found)
        (= kept (call load columns (* slot 8) pointer-layout site))
      )
      (call store directory (* slot 8) kept false site)
    )
    (call store header 0 directory false site)
    (call store header 16 next false site)
  )
  (fn-do _ grow-regions (list GrowRegion)
    (param site SyntaxId)
    (param row TypeId)
    (param row-layout LayoutId)
    ; The regions of a growing table's storage: a column for each field of a struct row; for a union
    ; row the tag, each shared field, the inline bytes and the handles of the outside bytes.
    (let regions (list GrowRegion))
    (let place (if-expr (== (call (. types intrinsic-of) row) .union) (call (. tables unions of) row) (. U32 max)))
    (if (== place (. U32 max))
      (for (in position (..< 0 (. ([] (. tables layouts rows) row-layout) fields count)))
        (let item ([] (. tables layouts rows) (. (call (. tables layouts field) row-layout position) layout)))
        (+= regions (call GrowRegion position (. item size) (. item alignment) (call region-name row position)))
      )
      (return regions)
    )
    (let union ([] (. tables unions layouts) place))
    (+= regions (call GrowRegion 0 1 1 "tag"))
    (let first (. ([] (call (. types cases-of) row) 0) type))
    (let first-layout (call layout-of first site))
    (for (in position (..< 0 (. union commons count)))
      (let common ([] (. tables unions fields) (+ (. union commons start) position)))
      (let item ([] (. tables layouts rows) (. (call (. tables layouts field) first-layout (. common slot)) layout)))
      (+= regions
        (call GrowRegion
          (block
            (arg (. common column))
            (arg (. item size))
            (arg (. item alignment))
            (arg (str "common " (call region-name first (. common slot))))
          )
        )
      )
    )
    (if (!= (. union inline-column) (. U32 max))
      (+= regions
        (call GrowRegion
          (block
            (arg (. union inline-column))
            (arg (. union inline-stride))
            (arg (. union inline-alignment))
            (arg "inline")
          )
        )
      )
    )
    (if (!= (. union handle-column) (. U32 max))
      (+= regions (call GrowRegion (. union handle-column) 4 4 "spill-handles"))
    )
    (return regions)
  )
  (fn-expr _ directory-slots U32
    (param row TypeId)
    (param row-layout LayoutId)
    ; How many slots the directory of a table's columns has: one for each field of a struct row,
    ; and for a union row one for each column and one for its outside bytes.
    (case? (and (== (call (. types intrinsic-of) row) .union) (!= (call (. tables unions of) row) (. U32 max)))
      (. ([] (. tables unions layouts) (call (. tables unions of) row)) columns)
    )
    (default
      (. ([] (. tables layouts rows) row-layout) fields count)
    )
  )
  (fn-do _ region-name String
    (param row TypeId)
    (param position U32)
    ; The name of a field of a row at its place in the row's layout, which names the region of a
    ; table's storage that holds its column.
    (for (in property (call (. types properties-of) row))
      (if (== (. property slot) position)
        (return (. property name text))
      )
    )
    (return (str "field " position))
  )
  (fn-do _ checked-bytes Operand
    (param site SyntaxId)
    (param count Operand)
    (param stride U64)
    (param context String)
    ; How many bytes a count of items of a size takes, checked first not to overflow.
    (let most (call integer .machine-u64 (/ (. U64 max) stride)))
    (call fail-if site (call compare site .compare-greater count most) (str context " capacity overflow"))
    (return (call arithmetic site .arithmetic-multiply count (call integer .machine-u64 stride) u64-layout))
  )
  (fn-do _ next-capacity Operand
    (param site SyntaxId)
    (param current Operand)
    (param needed Operand)
    (param first U64)
    (param overflow String)
    ; The capacity a table or an arena's builder grows to: from none, the first capacity; under
    ; 1024, twice as many; and else half as many again, with the panic of an overflow. It is never
    ; less than is needed.
    (let most (call integer .machine-u64 (. U64 max)))
    (let empty (call (. ir reserve-block)))
    (let held (call (. ir reserve-block)))
    (let small (call (. ir reserve-block)))
    (let large (call (. ir reserve-block)))
    (let grew (call (. ir reserve-block)))
    (let chosen (call (. ir reserve-block)))
    (call branch (call compare site .compare-equal current (call integer .machine-u64 0)) empty held)
    (call (. ir start-block) empty)
    (call jump chosen)
    (call (. ir start-block) held)
    (call branch (call compare site .compare-less current (call integer .machine-u64 1024)) small large)
    (call (. ir start-block) small)
    (call fail-if
      (block
        (arg site)
        (arg (call compare site .compare-greater current (call integer .machine-u64 (/ (. U64 max) 2))))
        (arg overflow)
      )
    )
    (let doubled (call arithmetic site .arithmetic-multiply current (call integer .machine-u64 2) u64-layout))
    (let from-small (. ir current))
    (call jump grew)
    (call (. ir start-block) large)
    (let half (call arithmetic site .arithmetic-divide current (call integer .machine-u64 2) u64-layout))
    (call fail-if
      (block
        (arg site)
        (arg
          (call compare
            (block
              (arg site)
              (arg .compare-greater)
              (arg current)
              (arg (call arithmetic site .arithmetic-subtract most half u64-layout))
            )
          )
        )
        (arg overflow)
      )
    )
    (let grown (call arithmetic site .arithmetic-add current half u64-layout))
    (let from-large (. ir current))
    (call jump grew)
    (call (. ir start-block) grew)
    (let later (call phi u64-layout doubled from-small grown from-large))
    (let from-grew (. ir current))
    (call jump chosen)
    (call (. ir start-block) chosen)
    (let candidate (call phi u64-layout (call integer .machine-u64 first) empty later from-grew))
    (let short (call (. ir reserve-block)))
    (let enough (call (. ir reserve-block)))
    (let settled (call (. ir reserve-block)))
    (call branch (call compare site .compare-less candidate needed) short enough)
    (call (. ir start-block) short)
    (call jump settled)
    (call (. ir start-block) enough)
    (call jump settled)
    (call (. ir start-block) settled)
    (return (call phi u64-layout needed short candidate enough))
  )
  (fn-do _ copy-bytes _
    (param site SyntaxId)
    (param target Operand)
    (param source Operand)
    (param count Operand)
    ; Copies bytes from one place to another: a word at a time while a whole word is left, then a
    ; byte at a time.
    (let cursor (call (. ir add-local) u64-layout))
    (call store-local cursor (call integer .machine-u64 0) site)
    (call copy-by site target source count cursor 8 u64-layout)
    (call copy-by site target source count cursor 1 u8-layout)
  )
  (fn-do _ copy-by _
    (param site SyntaxId)
    (param target Operand)
    (param source Operand)
    (param count Operand)
    (param cursor LocalId)
    (param width U64)
    (param layout LayoutId)
    ; Copies bytes a width at a time from the cursor on, while a whole width is left.
    (let testing (call (. ir reserve-block)))
    (let copying (call (. ir reserve-block)))
    (let copied (call (. ir reserve-block)))
    (call jump testing)
    (call (. ir start-block) testing)
    (let end
      (call arithmetic
        (block
          (arg site)
          (arg .arithmetic-add)
          (arg (call load-local cursor site))
          (arg (call integer .machine-u64 width))
          (arg u64-layout)
        )
      )
    )
    (call branch (call compare site .compare-greater end count) copied copying)
    (call (. ir start-block) copying)
    (let done (call load-local cursor site))
    (let value (call load (call moved-bytes site source done) 0 layout site))
    (call store (call moved-bytes site target done) 0 value false site)
    (call store-local
      (block
        (arg cursor)
        (arg (call arithmetic site .arithmetic-add done (call integer .machine-u64 width) u64-layout))
        (arg site)
      )
    )
    (call jump testing)
    (call (. ir start-block) copied)
  )
  (fn-expr + table-row-type TypeId
    (param table TypeId)
    ; The type of a table's rows, or of the rows a view of one reads.
    (call viewed-item table)
  )
  (fn-do _ fixed-columns Operand
    (param site SyntaxId)
    (param row-layout LayoutId)
    (param size Operand)
    ; The storage of a table that does not grow: a directory with a pointer to each field's column,
    ; and a buffer for each column. Where every field has the same type, which holds nothing the
    ; collector follows, the columns are parts of one buffer.
    (let fields (. ([] (. tables layouts rows) row-layout) fields))
    (let count (. fields count))
    (let directory (call table-buffer site managed-layout (call integer .machine-u64 count)))
    (if (== count 0)
      (return directory)
    )
    (let first (call (. tables layouts field) row-layout 0))
    (let uniform (not (. ([] (. tables layouts rows) (. first layout)) is-managed)))
    (for (in position (..< 1 count))
      (if (!= (. (call (. tables layouts field) row-layout position) type) (. first type))
        (= uniform false)
      )
    )
    (if uniform
      (let total (call arithmetic site .arithmetic-multiply size (call integer .machine-u64 count) u64-layout))
      (let slab (call table-buffer site (. first layout) total))
      (let width (as (. ([] (. tables layouts rows) (. first layout)) size) U64))
      (for (in position (..< 0 count))
        (let start (call integer .machine-u64 0))
        (if (!= position 0)
          (= start
            (call arithmetic
              (block
                (arg site)
                (arg .arithmetic-multiply)
                (arg size)
                (arg (call integer .machine-u64 position))
                (arg u64-layout)
              )
            )
          )
        )
        (let bytes
          (call arithmetic
            (block
              (arg site)
              (arg .arithmetic-multiply)
              (arg start)
              (arg (call integer .machine-u64 width))
              (arg u64-layout)
            )
          )
        )
        (call store directory (* position 8) (call moved-bytes site slab bytes) false site)
      )
      (return directory)
    )
    (for (in position (..< 0 count))
      (let column (call table-buffer site (. (call (. tables layouts field) row-layout position) layout) size))
      (call store directory (* position 8) column false site)
    )
    (return directory)
  )
  (fn-do _ table-buffer Operand
    (param site SyntaxId)
    (param item LayoutId)
    (param count Operand)
    ; A buffer of a table's storage: from the task's parse region where one is active, and else from
    ; the collector, with what describes its items where they hold pointers it follows.
    (let row ([] (. tables layouts rows) item))
    (if (and (. row is-managed) (== (. row buffer) no-string))
      (call refuse .refused-type site)
      (return (call make-operand .operand-void 0))
    )
    (let descriptor
      (scope (if-expr (. row is-managed) buffer-descriptor (call integer .machine-pointer 0))
        (lazy buffer-descriptor (call make-operand .operand-buffer-descriptor item))
      )
    )
    (let width (call integer .machine-u64 (. row size)))
    (let region
      (call make-operand
        (block
          (arg .operand-value)
          (arg (call append .op-load-task-word site (call Span) parse-region-offset u64-layout))
        )
      )
    )
    (let regional (call (. ir reserve-block)))
    (let collected (call (. ir reserve-block)))
    (let joined (call (. ir reserve-block)))
    (call branch (call compare site .compare-not-equal region (call integer .machine-u64 0)) regional collected)
    (call (. ir start-block) collected)
    (let mark (. pending length))
    (+= pending width)
    (+= pending count)
    (+= pending descriptor)
    (let made (call call-runtime .runtime-allocate-buffer site mark managed-layout))
    (let from-heap (. ir current))
    (call jump joined)
    (call (. ir start-block) regional)
    (+= pending width)
    (+= pending count)
    (+= pending descriptor)
    (let carved (call call-runtime .runtime-parse-region-allocate-buffer site mark managed-layout))
    (let from-region (. ir current))
    (call jump joined)
    (call (. ir start-block) joined)
    (return (call phi managed-layout carved from-region made from-heap))
  )
  (fn-do _ fill-table _
    (param site SyntaxId)
    (param row TypeId)
    (param row-layout LayoutId)
    (param columns Operand)
    (param size Operand)
    (param filler Operand)
    ; Fills each row of a new table, from the first, with what a filler of a function type
    ; answers for the row's index, a call that may panic.
    (let counting (call open-pass site size))
    (let index (. counting index))
    (let code (call load filler 0 pointer-layout site))
    (let data
      (call load
        (block
          (arg filler)
          (arg (. (call (. tables layouts field) (. tables layouts function-layout) 1) offset))
          (arg managed-layout)
          (arg site)
        )
      )
    )
    (let mark (. pending length))
    (+= pending data)
    (+= pending index)
    (let made (call call code site mark .callee-value (call layout-of row site) (not in-landing)))
    (if (== (call (. types intrinsic-of) row) .union)
      (call scatter-union site (call (. tables unions of) row) columns index made (call no-meta) false false)
      (else
        (call scatter-row site row-layout columns index made)
      )
    )
    (call close-pass site counting)
  )
  (fn-do + table-cell Operand
    (param site SyntaxId)
    (param columns Operand)
    (param index Operand)
    (param slot U32)
    (param item LayoutId)
    ; Where a row's field lies in its column: the column the directory holds for the field,
    ; moved on by the row's index times the size of the field.
    (return (call item-cell site (call load columns (* slot 8) pointer-layout site) index item))
  )
  (fn-do _ item-cell Operand
    (param site SyntaxId)
    (param data Operand)
    (param index Operand)
    (param item LayoutId)
    ; Where an item of a column lies: where the column's items start, moved on by the index times
    ; the size of an item.
    (let width (call integer .machine-u64 (. ([] (. tables layouts rows) item) size)))
    (return (call moved-bytes site data (call arithmetic site .arithmetic-multiply index width u64-layout)))
  )
  (fn-do _ scatter-row _
    (param site SyntaxId)
    (param row-layout LayoutId)
    (param columns Operand)
    (param index Operand)
    (param value Operand)
    ; Stores each field of a row in its column, in the order the row declares them, through the
    ; collector's barrier where the field holds pointers it follows.
    (for (in position (..< 0 (. ([] (. tables layouts rows) row-layout) fields count)))
      (let field (call (. tables layouts field) row-layout position))
      (let cell (call table-cell site columns index position (. field layout)))
      (call store-cell site cell (. field layout) (call take value field site))
    )
  )
  (fn-do _ store-cell _
    (param site SyntaxId)
    (param cell Operand)
    (param layout LayoutId)
    (param value Operand)
    ; Stores a value of a table's field in its cell of a table that does not grow.
    (let managed (. ([] (. tables layouts rows) layout) is-managed))
    (if (call (. tables layouts is-struct) layout)
      (call copy cell value layout managed site)
      (else-if (!= layout void-layout)
        (call store cell 0 value managed site)
      )
    )
  )
  (fn-do _ gather-row Operand
    (param site SyntaxId)
    (param row-layout LayoutId)
    (param columns Operand)
    (param index Operand)
    ; A row of a table read from its columns into the frame, field by field.
    (let made (call frame row-layout))
    (for (in position (..< 0 (. ([] (. tables layouts rows) row-layout) fields count)))
      (let field (call (. tables layouts field) row-layout position))
      (let cell (call table-cell site columns index position (. field layout)))
      (call put made field (call take cell (call LayoutField 0 (. field layout) (. field type)) site) site)
    )
    (return made)
  )
  (fn-do + table-op TableOp
    (param id SyntaxId)
    ; The operation the type pass planned at a node of a table.
    (let found (call (. facts table-op-of) (. unit reading) id))
    (if (not found)
      (call refuse .refused-expression id)
      (return (. TableOp table-row))
    )
    (return found)
  )
  (fn-expr _ table-slot U32
    (param id SyntaxId)
    ; The place in the row's layout of the field a table's node reads or writes.
    (call (. facts table-slot-of) (. unit reading) id)
  )
  (fn-do _ header-word Operand
    (param site SyntaxId)
    (param header Operand)
    (param position U32)
    ; A word of the header an arena's table keeps: its columns, length, capacity, shrink and
    ; mutation generations, and its spill's base, use and capacity.
    (return (call load (call num-cast site header u64-layout pointer-layout) (* position 8) u64-layout site))
  )
  (fn-do _ grows Operand
    (param site SyntaxId)
    (param header Operand)
    ; Whether a table grows in an arena: it has a header.
    (return (call compare site .compare-not-equal header (call integer .machine-u64 0)))
  )
  (fn-do _ view-grows Operand
    (param site SyntaxId)
    (param meta TableMeta)
    ; Whether a view of a table reads one that grows: it has a header and an owner.
    (let owned (call compare site .compare-not-equal (. meta owner) (call integer .machine-u64 0)))
    (return (call bitwise site .bitwise-and (call grows site (. meta header)) owned u8-layout))
  )
  (fn-do _ header-or-zero Operand
    (param site SyntaxId)
    (param header Operand)
    (param position U32)
    ; A word of a table's header where it grows, and zero where it does not.
    (let growing (call (. ir reserve-block)))
    (let fixed (call (. ir reserve-block)))
    (let joined (call (. ir reserve-block)))
    (call branch (call grows site header) growing fixed)
    (call (. ir start-block) growing)
    (let word (call header-word site header position))
    (let from-growing (. ir current))
    (call jump joined)
    (call (. ir start-block) fixed)
    (call jump joined)
    (call (. ir start-block) joined)
    (return (call phi u64-layout word from-growing (call integer .machine-u64 0) fixed))
  )
  (fn-do _ table-meta TableMeta
    (param site SyntaxId)
    (param table Operand)
    (param layout LayoutId)
    ; The metadata of a table value, its shrink generation read from its header where it grows.
    (let header (call part table layout 2 site))
    (let owner (call part table layout 3 site))
    (let incarnation (call part table layout 4 site))
    (let generation (call part table layout 5 site))
    (return
      (call TableMeta
        (block
          (arg (. header operand))
          (arg (. owner operand))
          (arg (. incarnation operand))
          (arg (. generation operand))
          (arg (call header-or-zero site (. header operand) 3))
        )
      )
    )
  )
  (fn-do _ row-meta TableMeta
    (param site SyntaxId)
    (param row Operand)
    (param layout LayoutId)
    ; The metadata a row of a table holds.
    (return
      (call TableMeta
        (block
          (arg (. (call part row layout 2 site) operand))
          (arg (. (call part row layout 3 site) operand))
          (arg (. (call part row layout 4 site) operand))
          (arg (. (call part row layout 5 site) operand))
          (arg (. (call part row layout 6 site) operand))
        )
      )
    )
  )
  (fn-do + fail-if _
    (param site SyntaxId)
    (param failed Operand)
    (param text String)
    ; Raises a panic the compiler writes where a test holds. In a function that grows a table's
    ; storage, which raises none, the function answers the panic's message there.
    (let raising (call (. ir reserve-block)))
    (let passed (call (. ir reserve-block)))
    (call branch failed raising passed)
    (call (. ir start-block) raising)
    (if cold
      (call return-value (call make-operand .operand-constant (call (. ir add-string) text)) site)
      (else
        (call raise-text site text)
      )
    )
    (call (. ir start-block) passed)
  )
  (fn-do _ grow-outside _
    (param site SyntaxId)
    (param helper FunctionId)
    (param meta TableMeta)
    (param first Operand)
    (param second Operand)
    (param third Operand)
    ; Grows a table's storage by the function the tables declared for it, given what
    ; `emit-storage-growth` says, and raises a panic with the message it answers where it
    ; answers one. A function the collector never sees leaves that zone for the call.
    (let target ([] (. tables functions) helper))
    (let mark (. pending length))
    (+= pending (. meta header))
    (+= pending (. meta owner))
    (+= pending (. meta incarnation))
    (+= pending first)
    (+= pending second)
    (if (!= (call operand-kind third) .operand-void)
      (+= pending third)
    )
    (call (. ir depend) .callee-function helper 0)
    (let crosses in-zone)
    (if crosses
      (call cross-zone site false)
    )
    (let message
      (call call
        (block
          (arg (call make-operand .operand-symbol (. target symbol)))
          (arg site)
          (arg mark)
          (arg .callee-function)
          (arg managed-layout)
        )
      )
    )
    (if crosses
      (call cross-zone site true)
    )
    (let raising (call (. ir reserve-block)))
    (let grown (call (. ir reserve-block)))
    (call branch
      (block
        (arg
          (call compare
            (block
              (arg site)
              (arg .compare-not-equal)
              (arg (call num-cast site message managed-layout u64-layout))
              (arg (call integer .machine-u64 0))
            )
          )
        )
        (arg raising)
        (arg grown)
      )
    )
    (call (. ir start-block) raising)
    (call raise-message site message)
    (call (. ir start-block) grown)
  )
  (fn-do _ validate-table _
    (param site SyntaxId)
    (param meta TableMeta)
    (param context String)
    (param checks-shrink Bool)
    ; Checks that a table that grows can still be read: the arena has not been reset since, the
    ; table is not sealed, and it has not shrunk since the view was made. The runtime moves the
    ; generation of an arena's slot on at each reset and release and each time the slot is taken
    ; again, so the slot holds the generation a table was made under only while that arena lives
    ; unreset.
    (let current
      (call load
        (block
          (arg (call num-cast site (. meta owner) u64-layout pointer-layout))
          (arg arena-generation-offset)
          (arg u64-layout)
          (arg site)
        )
      )
    )
    (call fail-if
      (block
        (arg site)
        (arg (call compare site .compare-not-equal current (. meta generation)))
        (arg (str context " is stale after Arena reset"))
      )
    )
    (call fail-if
      (block
        (arg site)
        (arg (call compare site .compare-equal (call header-word site (. meta header) 0) (call integer .machine-u64 0)))
        (arg "Table is sealed")
      )
    )
    (if checks-shrink
      (let shrunk (call compare site .compare-not-equal (call header-word site (. meta header) 3) (. meta shrink)))
      (call fail-if site shrunk (str context " was invalidated by table shrink"))
    )
  )
  (fn-do _ table-columns Operand
    (param site SyntaxId)
    (param table Operand)
    (param layout LayoutId)
    (param meta TableMeta)
    ; Where a table's columns are: the directory its header holds, once checked, where it grows,
    ; and the one it holds itself where it does not.
    (let growing (call (. ir reserve-block)))
    (let fixed (call (. ir reserve-block)))
    (let joined (call (. ir reserve-block)))
    (call branch (call grows site (. meta header)) growing fixed)
    (call (. ir start-block) growing)
    (call validate-table site meta "Table" false)
    (let held (call num-cast site (call header-word site (. meta header) 0) u64-layout pointer-layout))
    (let from-growing (. ir current))
    (call jump joined)
    (call (. ir start-block) fixed)
    (let own (call num-cast site (. (call part table layout 0 site) operand) managed-layout pointer-layout))
    (let from-fixed (. ir current))
    (call jump joined)
    (call (. ir start-block) joined)
    (return (call phi pointer-layout held from-growing own from-fixed))
  )
  (fn-do _ table-length Typed
    (param site SyntaxId)
    (param table Operand)
    (param layout LayoutId)
    (param meta TableMeta)
    ; How many rows a table has: its header's length, once checked, where it grows, and the size
    ; it holds itself where it does not.
    (let growing (call (. ir reserve-block)))
    (let fixed (call (. ir reserve-block)))
    (let joined (call (. ir reserve-block)))
    (call branch (call grows site (. meta header)) growing fixed)
    (call (. ir start-block) growing)
    (call validate-table site meta "Table" false)
    (let held (call header-word site (. meta header) 1))
    (let from-growing (. ir current))
    (call jump joined)
    (call (. ir start-block) fixed)
    (let own (call part table layout 1 site))
    (let from-fixed (. ir current))
    (call jump joined)
    (call (. ir start-block) joined)
    (return (call Typed (call phi u64-layout held from-growing (. own operand) from-fixed) (. own type)))
  )
  (fn-do _ table-cursor TableCursor
    (param id SyntaxId)
    (param object SyntaxId)
    (param key SyntaxId)
    ; `t[i]` of a table or of a span of one: the table, then the index, converted to one; the
    ; columns are found, and the index is checked against the length and moved on by the span's
    ; offset.
    (let none (call make-operand .operand-void 0))
    (let empty (call TableCursor none none (call TableMeta none none none none none)))
    (let proven (call proven-table id))
    (if (!= proven (. U32 max))
      (let held ([] proven-tables proven))
      (let counted (call convert key .reason-argument (call emit-expression key)))
      (if (or (== (. held kind) .table) (== (. held kind) .immutable-table))
        (return (call TableCursor (. held source columns) (. counted operand) (. held source meta)))
      )
      (return
        (call TableCursor
          (block
            (arg (. held source columns))
            (arg (call arithmetic id .arithmetic-add (. held source offset) (. counted operand) u64-layout))
            (arg (. held source meta))
          )
        )
      )
    )
    (let table (call emit-expression object))
    (let type (. table type))
    (let index (call convert key .reason-argument (call emit-expression key)))
    (if (or (!= (. index type) (. types index-type)) (not (call is-row-source (call intrinsic type))))
      (call refuse .refused-expression id)
      (return empty)
    )
    (let layout (call layout-of type id))
    (return (call row-place id (. table operand) type layout (. index operand)))
  )
  (fn-do + rows-length Typed
    (param id SyntaxId)
    (param held Operand)
    (param type TypeId)
    (param layout LayoutId)
    ; How many rows a table or a span of one holds: checked where the table grows, and held by a
    ; finished table and its spans.
    (let kind (call intrinsic type))
    (let length (call make-operand .operand-void 0))
    (if (== kind .table)
      (= length (. (call table-length id held layout (call table-meta id held layout)) operand))
      (else-if (== kind .table-span)
        (= length (. (call span-length id held layout (call span-meta id held layout)) operand))
      )
      (else
        (= length (. (call table-source id held type layout) length))
      )
    )
    (return (call Typed length (. types size-type)))
  )
  (fn-do + row-place TableCursor
    (param id SyntaxId)
    (param table Operand)
    (param type TypeId)
    (param layout LayoutId)
    (param index Operand)
    ; The row at an index of a table or of a span of one: the index checked against the length
    ; and moved on by the span's offset.
    (let kind (call intrinsic type))
    (let source (call table-source id table type layout))
    (call fail-if
      (block
        (arg id)
        (arg (call compare id .compare-greater-equal index (. source length)))
        (arg (str (call source-name kind) " index is out of bounds"))
      )
    )
    (if (or (== kind .table) (== kind .immutable-table))
      (return (call TableCursor (. source columns) index (. source meta)))
    )
    (return
      (call TableCursor
        (block
          (arg (. source columns))
          (arg (call arithmetic id .arithmetic-add (. source offset) index u64-layout))
          (arg (. source meta))
        )
      )
    )
  )
  (fn-do + table-source TableSource
    (param id SyntaxId)
    (param table Operand)
    (param type TypeId)
    (param layout LayoutId)
    ; The rows of a table, from the first, or of a span of one, from its offset: the columns are
    ; found, then the length, each checked where the table grows. A finished table and its spans
    ; hold their columns and length themselves, and no metadata.
    (let kind (call intrinsic type))
    (let zero (call integer .machine-u64 0))
    (if (== kind .immutable-table)
      (return
        (call TableSource
          (block
            (arg (. (call part-address id table layout 0) operand))
            (arg zero)
            (arg (. (call part table layout 1 id) operand))
            (arg (call TableMeta zero zero zero zero zero))
          )
        )
      )
    )
    (if (== kind .immutable-table-span)
      (return
        (call TableSource
          (block
            (arg (. (call part-address id table layout 0) operand))
            (arg (. (call part table layout 1 id) operand))
            (arg (. (call part table layout 2 id) operand))
            (arg (call TableMeta zero zero zero zero zero))
          )
        )
      )
    )
    (if (== kind .table)
      (return (call table-rows id table layout (call table-meta id table layout)))
    )
    (return (call span-rows id table layout (call span-meta id table layout)))
