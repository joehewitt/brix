            )
          )
          (arg "IndexSpan index is out of bounds")
        )
      )
      (let value (call span-item id (call resolve-span id (. held operand) layout) (. position operand) item-layout))
      (return (call Typed value item))
    )
    (return
      (call row-value
        (block
          (arg id)
          (arg (call selected-row id (. held operand) type layout (. position operand)))
          (arg (call (. facts node-type) (. unit reading) id))
        )
      )
    )
  )
  (fn-do _ selection-cursor TableCursor
    (param id SyntaxId)
    (param object SyntaxId)
    (param key SyntaxId)
    ; The row a selection reads at `s[i]`, where a field of it is read or written: the selection,
    ; then the position, converted to one.
    (let none (call make-operand .operand-void 0))
    (let empty (call TableCursor none none (call TableMeta none none none none none)))
    (let held (call emit-expression object))
    (let type (. held type))
    (let position (call convert key .reason-argument (call emit-expression key)))
    (let kind (call intrinsic type))
    (if (or (!= (. position type) (. types index-type)) not-selection)
      (call refuse .refused-expression id)
      (return empty)
    )
    (lazy not-selection (and (!= kind .table-selection) (!= kind .immutable-table-selection)))
    (let layout (call layout-of type id))
    (return (call selected-row id (. held operand) type layout (. position operand)))
  )
  (fn-do _ selected-row TableCursor
    (param id SyntaxId)
    (param selection Operand)
    (param type TypeId)
    (param layout LayoutId)
    (param position Operand)
    ; The row of a table a selection reads at a position: the position is checked against the
    ; selection's length, the indices resolved and the index read there, and the table's row at that
    ; index found as `t[i]` finds it.
