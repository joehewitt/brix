  (fn-do _ table-rows TableSource
    (param site SyntaxId)
    (param table Operand)
    (param layout LayoutId)
    (param meta TableMeta)
    ; The columns and length of a table, from the first row: both from its header, checked once,
    ; where it grows, and both held by the table itself where it does not.
    (let growing (call (. ir reserve-block)))
    (let fixed (call (. ir reserve-block)))
    (let joined (call (. ir reserve-block)))
    (call branch (call grows site (. meta header)) growing fixed)
    (call (. ir start-block) growing)
    (call validate-table site meta "Table" false)
    (let held (call num-cast site (call header-word site (. meta header) 0) u64-layout pointer-layout))
    (let held-length (call header-word site (. meta header) 1))
    (let from-growing (. ir current))
    (call jump joined)
    (call (. ir start-block) fixed)
    (let own (call num-cast site (. (call part table layout 0 site) operand) managed-layout pointer-layout))
    (let own-length (call part table layout 1 site))
    (let from-fixed (. ir current))
    (call jump joined)
    (call (. ir start-block) joined)
    (let columns (call phi pointer-layout held from-growing own from-fixed))
    (let length (call phi u64-layout held-length from-growing (. own-length operand) from-fixed))
    (return (call TableSource columns (call integer .machine-u64 0) length meta))
  )
  (fn-do _ span-rows TableSource
    (param site SyntaxId)
    (param span Operand)
    (param layout LayoutId)
    (param meta TableMeta)
    ; The columns, offset and length of a span of a table, the span checked once where its table
    ; grows: the columns are the directory its table's header holds there, and the ones the span
    ; holds where it does not.
    (let columns (call span-columns site span layout meta))
    (return
      (call TableSource
        (block
          (arg columns)
          (arg (. (call part span layout 1 site) operand))
          (arg (. (call part span layout 2 site) operand))
          (arg meta)
        )
      )
    )
  )
  (fn-do _ span-meta TableMeta
    (param site SyntaxId)
    (param span Operand)
    (param layout LayoutId)
    ; The metadata a span of a table holds.
    (return
      (call TableMeta
        (block
          (arg (. (call part span layout 3 site) operand))
          (arg (. (call part span layout 4 site) operand))
          (arg (. (call part span layout 5 site) operand))
          (arg (. (call part span layout 6 site) operand))
          (arg (. (call part span layout 7 site) operand))
        )
      )
    )
  )
  (fn-do _ span-columns Operand
    (param site SyntaxId)
    (param span Operand)
    (param layout LayoutId)
    (param meta TableMeta)
    ; Where a span's columns are: the directory its table's header holds, once the span is
    ; checked, where the table grows, and the one the span holds where it does not.
    (let growing (call (. ir reserve-block)))
    (let fixed (call (. ir reserve-block)))
    (let joined (call (. ir reserve-block)))
    (call branch (call view-grows site meta) growing fixed)
    (call (. ir start-block) growing)
    (call validate-table site meta "TableSpan" true)
    (let held (call num-cast site (call header-word site (. meta header) 0) u64-layout pointer-layout))
    (let from-growing (. ir current))
    (call jump joined)
    (call (. ir start-block) fixed)
    (let own (call part-address site span layout 0))
    (let from-fixed (. ir current))
    (call jump joined)
    (call (. ir start-block) joined)
    (return (call phi pointer-layout held from-growing (. own operand) from-fixed))
  )
  (fn-do _ span-length Typed
    (param site SyntaxId)
    (param span Operand)
    (param layout LayoutId)
    (param meta TableMeta)
    ; How many rows a span of a table has, once the span is checked where its table grows.
    (let growing (call (. ir reserve-block)))
    (let joined (call (. ir reserve-block)))
    (call branch (call view-grows site meta) growing joined)
    (call (. ir start-block) growing)
    (call validate-table site meta "TableSpan" true)
    (call jump joined)
    (call (. ir start-block) joined)
    (return (call part span layout 2 site))
  )
  (fn-do + emit-table-index Typed
    (param id SyntaxId)
    (param object SyntaxId)
    (param key SyntaxId)
    ; A row of a table made a value at `t[i]`: the columns, left out where the table grows, the
    ; index, and the table's metadata.
    (let none (call make-operand .operand-void 0))
    (if (== (call table-op id) (. TableOp table-span))
      (return (call emit-table-span id object key))
    )
    (if (== (call table-op id) (. TableOp table-item))
      (return (call emit-table-item id object key))
    )
    (if (== (call table-op id) (. TableOp table-select))
      (return (call emit-table-select id object key))
    )
    (if (or (== (call table-op id) (. TableOp span-item)) (== (call table-op id) (. TableOp selection-row)))
      (return (call emit-span-index id object key))
    )
    (if (or (== (call table-op id) (. TableOp span-range)) (== (call table-op id) (. TableOp selection-range)))
      (return (call emit-span-range id object key))
    )
    (if (and (!= (call table-op id) (. TableOp table-row)) (!= (call table-op id) (. TableOp proven-row)))
      (call refuse .refused-expression id)
      (return (call Typed none no-type))
    )
    (let cursor (call table-cursor id object key))
    (return (call row-value id cursor (call (. facts node-type) (. unit reading) id)))
  )
  (fn-do _ emit-table-select Typed
    (param id SyntaxId)
    (param object SyntaxId)
    (param key SyntaxId)
    ; The rows of a table indices select at `t[ids]`: the table, then the indices; a table that
    ; grows is checked, and the selection holds the table and an index span: the one given, or one
    ; made of the array or of the arena's builder given.
    (let none (call make-operand .operand-void 0))
    (let table (call emit-expression object))
    (let type (. table type))
    (let given (call emit-expression key))
    (let given-type (. given type))
    (let kind (call intrinsic type))
    (if (and (!= kind .table) (!= kind .immutable-table))
      (call refuse .refused-expression id)
      (return (call Typed none no-type))
    )
    (let selection (call (. facts node-type) (. unit reading) id))
    (let layout (call layout-of type id))
    (let selection-layout (call layout-of selection id))
    (let span-type (call field-type selection 1))
    (let span-layout (call layout-of span-type id))
    (if (== kind .table)
      (call table-columns id (. table operand) layout (call table-meta id (. table operand) layout))
    )
    (let made (call frame selection-layout))
    (call put made (call (. tables layouts field) selection-layout 0) (. table operand) id)
    (let span-field (call (. tables layouts field) selection-layout 1))
    (if (== given-type span-type)
      (call put made span-field (. given operand) id)
      (else
        (call span-into
          (block
            (arg id)
            (arg (call address made (. span-field offset) span-layout id))
            (arg span-type)
            (arg span-layout)
            (arg (. given operand))
            (arg given-type)
            (arg none)
            (arg no-type)
          )
        )
      )
    )
    (return (call Typed made selection))
  )
  (fn-do _ emit-span-index Typed
    (param id SyntaxId)
    (param object SyntaxId)
    (param key SyntaxId)
    ; An index of an index span read at `s[i]`, or a row of a selection: the value, then the
    ; position, converted to one, which is checked against the length. The span is resolved and the
    ; index read there; a selection then reads its table's row at that index as `t[i]` reads it.
    (let none (call make-operand .operand-void 0))
    (let held (call emit-expression object))
    (let type (. held type))
    (let position (call convert key .reason-argument (call emit-expression key)))
    (if (!= (. position type) (. types index-type))
      (call refuse .refused-conversion key)
      (return (call Typed none no-type))
    )
    (let layout (call layout-of type id))
    (if (== (call intrinsic type) .index-span)
      (let item (call viewed-item type))
      (let item-layout (call layout-of item id))
      (call fail-if
        (block
          (arg id)
          (arg
            (call compare
              (block
                (arg id)
                (arg .compare-greater-equal)
                (arg (. position operand))
                (arg (call word-at id (. held operand) layout 3))
