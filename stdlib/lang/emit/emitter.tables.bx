      (call put
        (block
          (arg made)
          (arg (call (. tables layouts field) layout 0))
          (arg (call num-cast id (. cursor columns) pointer-layout managed-layout))
          (arg id)
        )
      )
      (call put made (call (. tables layouts field) layout 1) (. cursor index) id)
      (return (call Typed made row))
    )
    (call put made (call (. tables layouts field) layout 0) (call view-columns id (. cursor meta) (. cursor columns)) id)
    (call put made (call (. tables layouts field) layout 1) (. cursor index) id)
    (call put-meta id made layout 2 (. cursor meta))
    (return (call Typed made row))
  )
  (fn-do + made-row U32
    (param value Operand)
    ; Where among `made-rows` a value is, or `U32.max` where it is none of them.
    (let position (. made-rows length))
    (while (!= position 0)
      (-= position 1)
      (if (== (. ([] made-rows position) value) value)
        (return (as position U32))
      )
    )
    (return (. U32 max))
  )
  (fn-do _ emit-table-span Typed
    (param id SyntaxId)
    (param object SyntaxId)
    (param key SyntaxId)
    ; The rows a range spans of a table made a span at `t[a .. < b]`: the columns, left out where
    ; the table grows, the start of the range made forward, its length, and the table's metadata;
    ; and the items a range spans of a view of a field's column, a view of them. The range must step
    ; by one and lie within the table or view it indexes. A finished table's span holds no metadata.
    (let none (call make-operand .operand-void 0))
    (let held (call emit-expression object))
    (let type (. held type))
    (let range (call table-range id key))
    (return (call range-span id (. held operand) type range object (call (. facts node-type) (. unit reading) id)))
  )
  (fn-do + span-of Typed
    (param id SyntaxId)
    (param held Operand)
    (param type TypeId)
    (param range Operand)
    (param range-type TypeId)
    (param object SyntaxId)
    (param span TypeId)
    ; The span or the view of type `span` a range that steps by one indexes a table or a view of
    ; one by at `id`, as `emit-table-span` says.
    (let none (call make-operand .operand-void 0))
    (return
      (call range-span
        (block
          (arg id)
          (arg held)
          (arg type)
          (arg (call TableRange range range-type none none false false true))
          (arg object)
          (arg span)
        )
      )
    )
  )
  (fn-do _ range-span Typed
    (param id SyntaxId)
    (param held Operand)
    (param type TypeId)
    (param range TableRange)
    (param object SyntaxId)
    (param span TypeId)
    ; The span or the view of type `span` a range indexes a table or a view of one by at `id`, as
    ; `emit-table-span` says.
    (let none (call make-operand .operand-void 0))
    (let kind (call intrinsic type))
    (if (and (not (call is-row-source kind)) (!= kind .table-column) (!= kind .immutable-table-column))
      (call refuse .refused-expression id)
      (return (call Typed none no-type))
    )
    (let layout (call layout-of type id))
    (let span-layout (call layout-of span id))
    (if (or (== kind .table-column) (== kind .immutable-table-column))
      (return (call column-span id held type layout range object span-layout))
    )
    (if (call is-immutable-view kind)
      (return (call immutable-span id held type layout range object span span-layout))
    )
    (let source (call table-source id held type layout))
    (let bounds (call range-bounds id range held type object (. source length) (call source-name kind)))
    (let start
      (match kind
        (case= .table
          (. bounds start)
        )
        (default
          (call arithmetic id .arithmetic-add (. source offset) (. bounds start) u64-layout)
        )
      )
    )
    (let made (call frame span-layout))
    (call put made (call (. tables layouts field) span-layout 0) (call view-columns id (. source meta) (. source columns)) id)
    (call put made (call (. tables layouts field) span-layout 1) start id)
    (call put made (call (. tables layouts field) span-layout 2) (. bounds length) id)
    (call put-meta id made span-layout 3 (. source meta))
    (return (call Typed made span))
  )
  (fn-do _ immutable-span Typed
    (param id SyntaxId)
    (param held Operand)
    (param type TypeId)
    (param layout LayoutId)
    (param range TableRange)
    (param object SyntaxId)
    (param span TypeId)
    (param span-layout LayoutId)
    ; The rows a range spans of a finished table or of a span of one: the columns, the range's start
    ; moved on by the span's offset, and its length.
    (let source (call table-source id held type layout))
    (let bounds (call range-bounds id range held type object (. source length) (call source-name (call intrinsic type))))
    (let made (call frame span-layout))
    (call put
      (block
        (arg made)
        (arg (call (. tables layouts field) span-layout 0))
        (arg (call num-cast id (. source columns) pointer-layout managed-layout))
        (arg id)
      )
    )
    (call put
      (block
        (arg made)
        (arg (call (. tables layouts field) span-layout 1))
        (arg (call arithmetic id .arithmetic-add (. source offset) (. bounds start) u64-layout))
        (arg id)
      )
    )
    (call put made (call (. tables layouts field) span-layout 2) (. bounds length) id)
    (return (call Typed made span))
  )
  (fn-do _ column-span Typed
    (param id SyntaxId)
    (param column Operand)
    (param type TypeId)
    (param layout LayoutId)
    (param range TableRange)
    (param object SyntaxId)
    (param span-layout LayoutId)
    ; The items a range spans of a view of a field's column: its data moved on to the range's start,
    ; left out where the table grows, the range's length, and the view's table, column and offset,
    ; moved on to the start, with its metadata. That of a finished table's view is its data moved on
    ; and the range's length.
