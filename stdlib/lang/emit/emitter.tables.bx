    (let item-layout (call layout-of (call viewed-item type) id))
    (if (== (call intrinsic type) .immutable-table-column)
      (let held (call part-address id column layout 0))
      (let spanned
        (call range-bounds
          (block
            (arg id)
            (arg range)
            (arg column)
            (arg type)
            (arg object)
            (arg (. (call part column layout 1 id) operand))
            (arg "ImmutableTableField")
          )
        )
      )
      (let viewed (call frame span-layout))
      (call put
        (block
          (arg viewed)
          (arg (call (. tables layouts field) span-layout 0))
