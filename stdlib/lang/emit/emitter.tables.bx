      (block
        (arg id)
        (arg (call compare id .compare-less (. (call part source source-layout 1 id) operand) (. bounds length)))
        (arg "TableField range source is too short")
      )
    )
    (call copy-items id into (. out operand) (. bounds length) item-layout)
    (call invalidate-marks id meta)
  )
  (fn-do _ column-meta TableMeta
    (param site SyntaxId)
    (param column Operand)
    (param layout LayoutId)
    ; The metadata a view of a field's column holds.
    (return
      (call TableMeta
        (block
          (arg (. (call part column layout 2 site) operand))
          (arg (. (call part column layout 6 site) operand))
          (arg (. (call part column layout 7 site) operand))
          (arg (. (call part column layout 8 site) operand))
          (arg (. (call part column layout 9 site) operand))
        )
      )
    )
  )
  (fn-do _ column-data Typed
    (param site SyntaxId)
    (param column Operand)
    (param layout LayoutId)
    (param meta TableMeta)
    (param item LayoutId)
    ; Where the items of a view of a field's column start: where the table grows, once the view is
    ; checked, the column its table's directory holds moved on by the view's offset, and where it
    ; does not, the data the view holds.
    (let growing (call (. ir reserve-block)))
    (let fixed (call (. ir reserve-block)))
    (let joined (call (. ir reserve-block)))
    (call branch (call view-grows site meta) growing fixed)
    (call (. ir start-block) growing)
    (call validate-table site meta "TableField" true)
    (let directory
      (call moved-bytes
        (block
          (arg site)
          (arg (. (call part-address site column layout 3) operand))
          (arg
            (call arithmetic
              (block
                (arg site)
                (arg .arithmetic-multiply)
                (arg (. (call part column layout 4 site) operand))
                (arg (call integer .machine-u64 8))
                (arg u64-layout)
              )
            )
          )
        )
      )
    )
    (let held
      (call item-cell
        (block
          (arg site)
          (arg (call load directory 0 pointer-layout site))
          (arg (. (call part column layout 5 site) operand))
          (arg item)
        )
      )
    )
    (let from-growing (. ir current))
    (call jump joined)
    (call (. ir start-block) fixed)
    (let own (call part-address site column layout 0))
    (let from-fixed (. ir current))
    (call jump joined)
    (call (. ir start-block) joined)
    (return (call Typed (call phi pointer-layout held from-growing (. own operand) from-fixed) (. own type)))
  )
  (fn-do + column-length Typed
    (param site SyntaxId)
    (param column Operand)
    (param layout LayoutId)
    ; How many items a view of a field's column has, once the view is checked where its table
    ; grows. A view of a finished table is never checked.
    (if (== (. ([] (. tables layouts rows) layout) fields count) 2)
      (return (call part column layout 1 site))
    )
    (let meta (call column-meta site column layout))
    (let growing (call (. ir reserve-block)))
    (let joined (call (. ir reserve-block)))
    (call branch (call view-grows site meta) growing joined)
    (call (. ir start-block) growing)
    (call validate-table site meta "TableField" true)
    (call jump joined)
    (call (. ir start-block) joined)
    (return (call part column layout 1 site))
  )
  (fn-do _ part-address Typed
    (param site SyntaxId)
    (param value Operand)
    (param layout LayoutId)
    (param position U32)
    ; A field of a table or of a view of one that holds an address, as a plain pointer.
    (let held (. (call (. tables layouts field) layout position) layout))
    (let read (call part value layout position site))
    (return
      (match held
        (case= pointer-layout
          read
        )
        (default
          (call Typed (call num-cast site (. read operand) held pointer-layout) (. read type))
        )
      )
    )
  )
  (fn-do + view-columns Operand
    (param site SyntaxId)
    (param meta TableMeta)
    (param columns Operand)
    ; The columns a view of a table keeps: none where the table grows, whose view finds them in
    ; its header, and the table's own where it does not.
    (let growing (call (. ir reserve-block)))
    (let fixed (call (. ir reserve-block)))
    (let joined (call (. ir reserve-block)))
    (call branch (call view-grows site meta) growing fixed)
    (call (. ir start-block) growing)
    (call jump joined)
    (call (. ir start-block) fixed)
    (call jump joined)
    (call (. ir start-block) joined)
    (let kept (call phi pointer-layout (call integer .machine-pointer 0) growing columns fixed))
    (return (call num-cast site kept pointer-layout managed-layout))
  )
  (fn-do + put-meta _
    (param site SyntaxId)
    (param made Operand)
    (param layout LayoutId)
    (param first U32)
    (param meta TableMeta)
    ; Stores a table's metadata in a view of it, from the field at `first`.
    (call put made (call (. tables layouts field) layout first) (. meta header) site)
    (call put made (call (. tables layouts field) layout (+ first 1)) (. meta owner) site)
    (call put made (call (. tables layouts field) layout (+ first 2)) (. meta incarnation) site)
    (call put made (call (. tables layouts field) layout (+ first 3)) (. meta generation) site)
    (call put made (call (. tables layouts field) layout (+ first 4)) (. meta shrink) site)
  )
  (fn-do + table-get Typed
    (param id SyntaxId)
    (param held Operand)
    (param type TypeId)
    ; A name of a table, or of a view of one, that the compiler answers itself: the view of a
    ; field's column, how many rows or items there are, or where the items of a field's column
    ; start.
    (let none (call make-operand .operand-void 0))
    (let op (call table-op id))
    (let kind (call intrinsic type))
    (let layout (call layout-of type id))
    (if (and (== op (. TableOp table-column)) (call is-row-source kind))
      (return (call table-column id held type layout))
    )
    (if (and (== op (. TableOp table-length)) (call is-row-source kind))
      (return (call rows-length id held type layout))
    )
    (if (and (== op (. TableOp table-length)) (or (== kind .table-column) (== kind .immutable-table-column)))
      (let counted (call column-length id held layout))
      (return (call Typed (. counted operand) (. types size-type)))
    )
    (if (and (== op (. TableOp table-layout)) (== kind .table))
      (return (call layout-text id held type layout))
    )
    (if (and (== op (. TableOp table-capacity)) (== kind .table))
      (let room (call table-capacity id held layout))
      (return (call Typed (. room operand) (. types size-type)))
    )
    (if (and (== op (. TableOp table-mark)) (== kind .table))
      (return (call table-mark id held layout))
    )
    (if (and (== op (. TableOp table-length)) (== kind .index-span))
      (let indices (call word-at id held layout 3))
      (return (call Typed indices (. types size-type)))
    )
    (if (and (== op (. TableOp table-length)) (or (== kind .table-selection) (== kind .immutable-table-selection)))
      (let span-type (call field-type type 1))
      (let span-layout (call layout-of span-type id))
      (let selected (call word-at id (. (call part held layout 1 id) operand) span-layout 3))
      (return (call Typed selected (. types size-type)))
    )
    (if (or (!= op (. TableOp table-data)) (!= kind .table-column))
      (call refuse .refused-expression id)
      (return (call Typed none no-type))
    )
    (let pointer (call (. facts node-type) (. unit reading) id))
    (let held-layout (call layout-of pointer id))
    (let item-layout (call layout-of (call viewed-item type) id))
    (let data (call column-data id held layout (call column-meta id held layout) item-layout))
    (return
      (match held-layout
        (case= pointer-layout
          (call Typed (. data operand) pointer)
        )
        (default
          (call Typed (call num-cast id (. data operand) pointer-layout held-layout) pointer)
        )
      )
    )
  )
  (fn-do _ layout-text Typed
    (param id SyntaxId)
    (param held Operand)
    (param type TypeId)
    (param layout LayoutId)
    ; `t.layout`: the text of how a table keeps its rows, that of a table that grows where it grows
    ; in an arena, and else that of one that does not.
    (let none (call make-operand .operand-void 0))
    (let row (call table-row-type type))
    (let row-layout (call layout-of row id))
    (let text-layout (call layout-of (. types string-type) id))
    (let fixed-text (str "Table'" (call type-runtime-name types row) "\nstorage fixed"))
    (let growing-text (call growing-struct-text row row-layout))
    (if (== (call (. types intrinsic-of) row) .union)
      (let place (call (. tables unions of) row))
      (if (== place (. U32 max))
        (call refuse .refused-type id)
        (return (call Typed none no-type))
      )
      (= fixed-text ([] (. tables unions fixed-texts) place))
      (= growing-text ([] (. tables unions growing-texts) place))
    )
    (let fixed (call make-operand .operand-constant (call (. ir add-string) fixed-text)))
    (let growing (call (. ir reserve-block)))
    (let kept (call (. ir reserve-block)))
    (let joined (call (. ir reserve-block)))
    (call branch (call view-grows id (call table-meta id held layout)) growing kept)
    (call (. ir start-block) growing)
    (let grown (call make-operand .operand-constant (call (. ir add-string) growing-text)))
    (call jump joined)
    (call (. ir start-block) kept)
    (call jump joined)
    (call (. ir start-block) joined)
    (return (call Typed (call phi text-layout grown growing fixed kept) (. types string-type)))
  )
  (fn-do _ growing-struct-text String
    (param row TypeId)
    (param row-layout LayoutId)
    ; The text `.layout` gives for a table of struct rows that grows in an arena: a region for each
    ; field's column.
    (let lines
      (call List
        (block
          (item (str "Table'" (call type-runtime-name types row)))
          (item "storage arena-growable")
          (item "row-layout struct")
          (item "growth shared geometric")
        )
      )
    )
    (if (!= (call (. types intrinsic-of) row) .struct)
      (return (call (. "\n" join) lines))
    )
    (for (in position (..< 0 (. ([] (. tables layouts rows) row-layout) fields count)))
      (let item ([] (. tables layouts rows) (. (call (. tables layouts field) row-layout position) layout)))
      (+= lines
        (paragraph
          (str "region column[" position "] " (call region-name row position) " width=" (. item size) " align=" (. item alignment))
        )
      )
    )
    (return (call (. "\n" join) lines))
  )
  (fn-do _ table-capacity Typed
    (param site SyntaxId)
    (param table Operand)
    (param layout LayoutId)
    ; How many rows a table has room for: its header's capacity, once checked, where it grows, and
    ; the size it holds itself where it does not.
    (let meta (call table-meta site table layout))
    (let growing (call (. ir reserve-block)))
    (let fixed (call (. ir reserve-block)))
    (let joined (call (. ir reserve-block)))
    (call branch (call grows site (. meta header)) growing fixed)
    (call (. ir start-block) growing)
    (call validate-table site meta "Table" false)
    (let held (call header-word site (. meta header) 2))
    (let from-growing (. ir current))
    (call jump joined)
    (call (. ir start-block) fixed)
    (let own (call part table layout 1 site))
    (let from-fixed (. ir current))
    (call jump joined)
    (call (. ir start-block) joined)
    (return (call Typed (call phi u64-layout held from-growing (. own operand) from-fixed) (. own type)))
  )
  (fn-do _ table-mark Typed
    (param site SyntaxId)
    (param table Operand)
    (param layout LayoutId)
    ; `t.mark`: the table is checked to grow, and the mark holds its header, its arena's owner,
    ; incarnation and generation, and the header's length, mutation generation and use of its spill.
    (let type (call (. facts node-type) (. unit reading) site))
    (let mark-layout (call layout-of type site))
    (let meta (call require-growable site table layout "mark"))
    (let made (call frame mark-layout))
    (call put-word site made mark-layout 0 (. meta header) u64-layout)
    (call put-word site made mark-layout 1 (. meta owner) u64-layout)
    (call put-word site made mark-layout 2 (. meta incarnation) u64-layout)
    (call put-word site made mark-layout 3 (. meta generation) u64-layout)
    (call put-word site made mark-layout 4 (call header-word site (. meta header) 1) u64-layout)
    (call put-word site made mark-layout 5 (call header-word site (. meta header) 4) u64-layout)
    (call put-word site made mark-layout 6 (call header-word site (. meta header) 6) u64-layout)
    (return (call Typed made type))
  )
  (fn-do + put-word _
    (param site SyntaxId)
    (param made Operand)
    (param layout LayoutId)
    (param position U32)
    (param value Operand)
    (param source LayoutId)
    ; Stores a word in a field of a tuple made in the frame, as the field holds it.
    (let field (call (. tables layouts field) layout position))
    (call put made field (call num-cast site value source (. field layout)) site)
  )
  (fn-do + word-at Operand
    (param site SyntaxId)
    (param value Operand)
    (param layout LayoutId)
    (param position U32)
    ; A word a tuple holds at a place, as a number.
    (let field (call (. tables layouts field) layout position))
    (return (call num-cast site (. (call part value layout position site) operand) (. field layout) u64-layout))
  )
  (fn-do _ require-growable TableMeta
    (param site SyntaxId)
    (param table Operand)
    (param layout LayoutId)
    (param operation String)
    ; Checks that a table grows before an operation only such a table has: it has a header, its
    ; arena has not been reset since it was made, and it is not sealed. Answers the table's
    ; metadata, with no shrink generation.
    (let header (call part table layout 2 site))
    (call fail-if
      (block
        (arg site)
        (arg (call compare site .compare-equal (. header operand) (call integer .machine-u64 0)))
        (arg (str "Table." operation " requires an Arena-backed growable table"))
      )
    )
    (let meta
      (call TableMeta
        (block
          (arg (. header operand))
          (arg (. (call part table layout 3 site) operand))
          (arg (. (call part table layout 4 site) operand))
          (arg (. (call part table layout 5 site) operand))
          (arg (call integer .machine-u64 0))
        )
      )
    )
    (call validate-table site meta "Table" false)
    (return meta)
  )
  (fn-do _ count-on _
    (param site SyntaxId)
    (param header Operand)
    (param position U32)
    ; Counts on a generation a table's header keeps, which may not overflow.
    (let place (call num-cast site header u64-layout pointer-layout))
    (let current (call load place (* position 8) u64-layout site))
    (call fail-if
      (block
        (arg site)
        (arg (call compare site .compare-equal current (call integer .machine-u64 (. U64 max))))
        (arg "Table generation overflow")
      )
    )
    (call store
      (block
        (arg place)
        (arg (* position 8))
        (arg (call arithmetic site .arithmetic-add current (call integer .machine-u64 1) u64-layout))
        (arg false)
        (arg site)
      )
    )
  )
  (fn-do _ put-header _
    (param site SyntaxId)
    (param header Operand)
    (param position U32)
    (param value Operand)
    ; Stores a word of a table's header.
    (call store (call num-cast site header u64-layout pointer-layout) (* position 8) value false site)
  )
  (fn-do + emit-table-method Typed
    (param id SyntaxId)
    (param object SyntaxId)
    (param written (of RowRange SyntaxId))
    ; A member of a table that the compiler answers where it is called: the table is evaluated, then
    ; the arguments in the order they are written, each converted to its parameter's type, and then
    ; the operation runs. A table finished from a local or an argument is the empty table there
    ; after, and so is one finished from a stored field of an object, which the object holds where
    ; it was read.
    (let nothing (call make-operand .operand-void 0))
    (let fact (call own-call id))
    (if (== fact no-fact)
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (let call ([] (. facts calls) fact))
    (let callee (. call callee))
    (if (or (== callee no-instance) (. call is-partial) (!= (. call form) .call-method) other-count)
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (lazy other-count (!= (. call fills count) (. written count)))
    (for (in position (..< 0 (. call fills count)))
      (if (!= (as ([] (. facts call-fills) (+ (. call fills start) position)) U32) position)
        (call refuse .refused-expression id)
        (return (call Typed nothing no-type))
      )
    )
    (let op (call table-op id))
    (let clears (and (== op (. TableOp table-finish)) (call finished-field object)))
    (let emptied (if-expr (and (== op (. TableOp table-finish)) (not clears)) (call finished-slot object) no-slot))
    (let table (call emit-receiver id object))
    (let type (. table type))
    (let row (call table-row-type type))
    (let unions (and (== (call (. types intrinsic-of) row) .union) (!= (call (. tables unions of) row) (. U32 max))))
    (if (or (!= (call intrinsic type) .table) (and (!= (call (. types intrinsic-of) row) .struct) (not unions)))
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (let passed (list Operand))
    (let passed-types (list TypeId))
    (let evaluated U32)
    (for (in argument ([] (. tree children) written))
      (let expression argument)
      (match? ([] (. tree nodes) argument)
        (case (call .node-argument named)
          (= expression (. named expr))
        )
      )
      (+= evaluated 1)
      (let made (call emit-expression expression))
      (+= passed (call settled made expression written evaluated))
      (+= passed-types (. made type))
    )
    (let known (. U32 max))
    (for (in position (..< 0 (. written count)))
      (if (and unions (== op (. TableOp table-append)))
        (= known
          (call wraps-case
            (block
              (arg ([] (. tree children) (+ (. written start) position)))
              (arg .reason-argument)
              (arg ([] passed-types position))
            )
          )
        )
      )
      (let converted
        (call convert
          (block
            (arg ([] (. tree children) (+ (. written start) position)))
            (arg .reason-argument)
            (arg (call Typed ([] passed position) ([] passed-types position)))
          )
        )
      )
      (= ([] passed position) (. converted operand))
      (if (!= (. converted type) (call (. instances argument-type) callee position))
        (call refuse .refused-conversion id)
      )
    )
    (let layout (call layout-of type id))
    (let row-layout (call layout-of row id))
    (if (== op (. TableOp table-append))
      (return (call table-append id (. table operand) layout row row-layout ([] passed 0) known))
    )
    (if (== op (. TableOp table-reserve))
      (let reserved (call require-growable id (. table operand) layout "reserve"))
      (call reserve-rows id row row-layout reserved ([] passed 0))
      (else-if (== op (. TableOp table-extend))
        (call table-extend
          (block
            (arg id)
            (arg (. table operand))
            (arg layout)
            (arg row)
            (arg row-layout)
            (arg ([] passed 0))
            (arg (call (. instances argument-type) callee 0))
          )
        )
      )
      (else-if (== op (. TableOp table-truncate))
        (call table-truncate id (. table operand) layout ([] passed 0))
      )
      (else-if (== op (. TableOp table-clear))
        (let cleared (call require-growable id (. table operand) layout "clear"))
        (call count-on id (. cleared header) 3)
        (call count-on id (. cleared header) 4)
        (call put-header id (. cleared header) 1 (call integer .machine-u64 0))
        (call put-header id (. cleared header) 6 (call integer .machine-u64 0))
      )
      (else-if (== op (. TableOp table-copy-from))
        (call table-copy-from id (. table operand) layout row row-layout ([] passed 0))
      )
      (else-if (== op (. TableOp table-finish))
        (let finished (call table-finish id (. table operand) layout))
        (let answer (. finished type))
        (if (!= emptied no-slot)
          (call empty-slot emptied type layout id)
        )
        (if clears
          (if (not (call (. tables layouts is-struct) layout))
            (call refuse .refused-expression id)
            (return (call Typed nothing no-type))
          )
          (let empty (call frame layout))
          (call zero empty layout)
          (call copy (. table operand) empty layout (. ([] (. tables layouts rows) layout) is-managed) id)
        )
        (return (call Typed (. finished operand) answer))
      )
      (else-if (== op (. TableOp table-view))
        (return (call viewed-table id (. table operand) layout))
      )
      (else-if (== op (. TableOp table-rewind))
        (call table-rewind id (. table operand) layout ([] passed 0) (call (. instances argument-type) callee 0))
      )
      (else-if (== op (. TableOp table-storage-checkpoint))
        (return
          (call table-checkpoint
            (block
              (arg id)
              (arg (. table operand))
              (arg layout)
              (arg ([] passed 0))
              (arg (call (. instances argument-type) callee 0))
              (arg ([] passed 1))
              (arg (call (. instances argument-type) callee 1))
            )
          )
        )
      )
      (else-if (or (== op (. TableOp table-validate-restore)) (== op (. TableOp table-restore-storage)))
        (let checkpoint-type (call (. instances argument-type) callee 0))
        (let arena-type (call (. instances argument-type) callee 1))
        (let mark-type (call (. instances argument-type) callee 2))
        (call table-restore
          (block
            (arg id)
            (arg (. table operand))
            (arg layout)
            (arg passed)
            (arg checkpoint-type)
            (arg arena-type)
            (arg mark-type)
            (arg (== op (. TableOp table-restore-storage)))
          )
        )
      )
      (else
        (call refuse .refused-expression id)
      )
    )
    (return (call Typed nothing (. types void-type)))
  )
  (fn-do + emit-builder-method Typed
    (param id SyntaxId)
    (param object SyntaxId)
    (param written (of RowRange SyntaxId))
    (param appends Bool)
    ; A member of an arena's builder that the compiler answers where it is called, on a builder
    ; written or on the receiver of the member that calls it: the builder is evaluated, then its
    ; argument, converted to its parameter's type. `append` checks the size can grow, makes room for
    ; one more item and stores it after the last; `reserve` makes room for as many items as it is
    ; given. Each then writes the storage, its capacity and the size in the builder's header, where
    ; every copy of the builder reads them.
    (let nothing (call make-operand .operand-void 0))
    (let fact (call own-call id))
    (let traces (call (. facts traces-of) (. unit reading) id))
    (if (or (== fact no-fact) (== traces null))
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (let call ([] (. facts calls) fact))
    (let callee (. call callee))
    (let form (or (== (. call form) .call-method) (and (== object 0) (== (. call form) .call-function))))
    (if (or (== callee no-instance) (. call is-partial) (not form) (!= (. call fills count) 1) (!= (. written count) 1))
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (if (!= (as ([] (. facts call-fills) (. call fills start)) U32) 0)
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (let builder (call emit-receiver id object))
    (let type (. builder type))
    (let argument ([] (. tree children) (. written start)))
    (let given (call emit-expression (call (. tree argument-value) argument)))
    (= given (call convert argument .reason-argument given))
    (if (!= (. given type) (call (. instances argument-type) callee 0))
      (call refuse .refused-conversion id)
    )
    (let layout (call layout-of type id))
    (let item-type (call (. types builder-item) type))
    (let item-layout (if-expr (!= item-type no-type) (call layout-of item-type id) void-layout))
    (let width (as (. ([] (. tables layouts rows) item-layout) size) U64))
    (if (or (== item-type no-type) (== item-layout void-layout) (== width 0))
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (let traced (?? traces false))
    (let state (call builder-state id (. builder operand) layout))
    (let held (call num-cast id (. state identity) u64-layout pointer-layout))
    (let current (call BuilderItems (call load held 0 u64-layout id) (call load held 8 u64-layout id)))
    (if (not appends)
      (let reserved
        (call reserve-items
          (block
            (arg id)
            (arg item-layout)
            (arg traced)
            (arg (. state owner))
            (arg (. state incarnation))
            (arg current)
            (arg (. given operand))
          )
        )
      )
      (call put-builder-state id held reserved (. state size))
      (return (call Typed nothing (. types void-type)))
    )
    (call fail-if
      (block
        (arg id)
        (arg (call compare id .compare-equal (. state size) (call integer .machine-u64 (. U64 max))))
        (arg "ArrayBuilder size overflow")
      )
    )
    (let needed (call arithmetic id .arithmetic-add (. state size) (call integer .machine-u64 1) u64-layout))
    (let items (call reserve-items id item-layout traced (. state owner) (. state incarnation) current needed))
    (let distance
      (call arithmetic
        (block
          (arg id)
          (arg .arithmetic-multiply)
          (arg (. state size))
          (arg (call integer .machine-u64 width))
          (arg u64-layout)
        )
      )
    )
    (let place
      (call num-cast
        (block
          (arg id)
          (arg (call arithmetic id .arithmetic-add (. items storage) distance u64-layout))
          (arg u64-layout)
          (arg pointer-layout)
        )
      )
    )
    (if (call (. tables layouts is-struct) item-layout)
      (call copy
        (block
          (arg (call address place 0 item-layout id))
          (arg (. given operand))
          (arg item-layout)
          (arg (and traced (. ([] (. tables layouts rows) item-layout) is-managed)))
          (arg id)
        )
      )
      (else
        (call store place 0 (. given operand) (and traced (call is-managed-pointer item-layout)) id)
      )
    )
    (call put-builder-state id held items needed)
    (return (call Typed nothing (. types void-type)))
  )
  (fn-do + reserve-items BuilderItems
    (param site SyntaxId)
    (param item LayoutId)
    (param traced Bool)
    (param owner Operand)
    (param incarnation Operand)
    (param current BuilderItems)
    (param needed Operand)
    ; The storage of items kept in an arena, of its owner and incarnation, and its capacity, grown
    ; where fewer items fit than are needed: the capacity is chosen, the bytes it takes reserved in
    ; the arena, zeroed and aligned to 16, and the items held copied over, with what describes them
    ; where the arena traces them. What was reserved before stays in the arena.
    (let width (as (. ([] (. tables layouts rows) item) size) U64))
    (if (and traced (== (. ([] (. tables layouts rows) item) buffer) no-string))
      (call refuse .refused-type site)
      (return current)
    )
    (let kept (. ir current))
    (let growing (call (. ir reserve-block)))
    (let joined (call (. ir reserve-block)))
    (call branch (call compare site .compare-greater needed (. current capacity)) growing joined)
    (call (. ir start-block) growing)
    (let first U64 (if-expr (<= width 16) 8 (if-expr (<= width 1024) 4 1)))
    (let next (call next-capacity site (. current capacity) needed first "ArrayBuilder size overflow"))
    (let bytes (call checked-bytes site next width "ArrayBuilder"))
    (let reserving
      (scope (if-expr traced traced-reserve (. RuntimeFunction runtime-arena-reserve))
        (lazy traced-reserve (. RuntimeFunction runtime-arena-reserve-described))
      )
    )
    (let copying
      (scope (if-expr traced traced-copy (. RuntimeFunction runtime-copy-plain-slice))
        (lazy traced-copy (. RuntimeFunction runtime-copy-slice))
      )
    )
    (let mark (. pending length))
    (+= pending (call num-cast site owner u64-layout pointer-layout))
    (+= pending incarnation)
    (+= pending bytes)
    (+= pending (call integer .machine-u64 16))
    (+= pending (call integer .machine-u8 1))
    (if traced
      (+= pending (call make-operand .operand-buffer-descriptor item))
    )
    (let replacement (call call-runtime reserving site mark pointer-layout))
    (call fail-if
      (block
        (arg site)
        (arg (call compare site .compare-equal replacement (call integer .machine-pointer 0)))
        (arg "Arena allocation failed while growing ArrayBuilder")
      )
    )
    (let copied (call checked-bytes site (. current capacity) width "ArrayBuilder"))
    (let copies (. pending length))
    (+= pending replacement)
    (+= pending (call num-cast site (. current storage) u64-layout pointer-layout))
    (+= pending copied)
    (if traced
      (+= pending (call make-operand .operand-buffer-descriptor item))
    )
    (call call-runtime copying site copies pointer-layout)
    (let grown (call num-cast site replacement pointer-layout u64-layout))
    (let grew (. ir current))
    (call jump joined)
    (call (. ir start-block) joined)
    (return
      (call BuilderItems
        (block
          (arg (call phi u64-layout (. current storage) kept grown grew))
          (arg (call phi u64-layout (. current capacity) kept next grew))
        )
      )
    )
  )
  (fn-do _ put-builder-state _
    (param site SyntaxId)
    (param held Operand)
    (param items BuilderItems)
    (param size Operand)
    ; Writes the storage of an arena's builder, its capacity and its size in its header.
    (call store held 0 (. items storage) false site)
    (call store held 8 (. items capacity) false site)
    (call store held 16 size false site)
  )
  (fn-do _ finished-slot SlotId
    (param object SyntaxId)
    ; The local or the argument a table is finished from, which is set to the empty table after: one
    ; a name reads. None for a table a call makes, which is set nowhere; any other place is refused.
    (match? ([] (. tree nodes) object)
      (case .node-call-expression
        (return no-slot)
      )
    )
    (let slot (call local-slot object object true))
    (if (== (. ([] (. bindings slots) slot) kind) .slot-lazy)
      (call refuse .refused-expression object)
      (return no-slot)
    )
    (return slot)
  )
  (fn-do _ finished-field Bool
    (param object SyntaxId)
    ; Whether a table finished is a field an object stores, read where the object holds it: one of
    ; the receiver named alone, or one read from an object, by no getter.
    (match? ([] (. tree nodes) object)
      (case (call .node-identifier row)
        (if (or (not (call is-own-field object)) (not (call (. tables is-class) (. unit owner-type))) (!= (call own-call object) no-fact))
          (return false)
        )
        (return (call stores-eagerly (. unit owner-type) (. row name)))
      )
      (case (call .node-get-expression row)
        (let owner (call (. facts node-type) (. unit reading) (. row object)))
        (if (or (== owner no-type) (== owner invalid-type) (not (call (. tables is-class) owner)) (call is-link object))
          (return false)
        )
        (if (or (!= (call own-call object) no-fact) (!= (call (. facts plan-of) (. unit reading) object) .plan-none))
          (return false)
        )
        (return (call stores-eagerly owner (. row name)))
      )
    )
    (return false)
  )
  (fn-expr _ stores-eagerly Bool
    (param owner TypeId)
    (param name Atom)
    ; Whether a type stores a property of a name as it is declared, with no getter or lazy value.
    (and found (== (. ([] (. types properties) found) storage-kind) .storage-eager))
    (where
      (lazy found (call property-of owner name))
    )
  )
  (fn-do _ empty-slot _
    (param slot SlotId)
    (param type TypeId)
    (param layout LayoutId)
    (param site SyntaxId)
    ; Sets the local or the argument a table was finished from to the empty table: in the
    ; environment that keeps it, in its cell, or in the memory of the argument.
    (let empty (call frame layout))
    (call zero empty layout)
    (if (call is-captured slot)
      (call keep-captured slot empty type site)
      (return)
    )
    (let offset (call slot-offset slot site))
    (if (!= ([] (. unit cells) offset) no-local)
      (call store-local ([] (. unit cells) offset) empty site)
      (return)
    )
    (let memory (call argument-memory slot type site))
    (call copy memory empty layout false site)
  )
  (fn-do _ table-append Typed
    (param site SyntaxId)
    (param table Operand)
    (param layout LayoutId)
    (param row TypeId)
    (param row-layout LayoutId)
    (param value Operand)
    (param known U32 (= (. U32 max)))
    ; `t.append(row)`: the table is checked to grow, room is made for one more row, and the row is
    ; scattered into the columns at the end, plainly; the length is counted on, and the answer is
    ; the row's index. A union known to hold one case, as `wraps-case` finds it, is scattered as
    ; that case with no other tested.
    (let meta (call require-growable site table layout "append"))
    (let length (call header-word site (. meta header) 1))
    (call fail-if
      (block
        (arg site)
        (arg (call compare site .compare-equal length (call integer .machine-u64 (. U64 max))))
        (arg "Table length overflow")
      )
    )
    (let next (call arithmetic site .arithmetic-add length (call integer .machine-u64 1) u64-layout))
    (call reserve-rows site row row-layout meta next)
    (let columns (call num-cast site (call header-word site (. meta header) 0) u64-layout pointer-layout))
    (if (and (== (call (. types intrinsic-of) row) .union) (!= known (. U32 max)) known-case)
      (call scatter-union-case
        (block
          (arg site)
          (arg (call (. tables unions of) row))
          (arg known)
          (arg columns)
          (arg length)
          (arg (call take value (call (. tables layouts case-field) row-layout known) site))
          (arg meta)
          (arg true)
          (arg false)
        )
      )
      (else-if (== (call (. types intrinsic-of) row) .union)
        (call scatter-union site (call (. tables unions of) row) columns length value meta true false)
      )
      (else
        (for (in position (..< 0 (. ([] (. tables layouts rows) row-layout) fields count)))
          (let field (call (. tables layouts field) row-layout position))
          (let cell (call table-cell site columns length position (. field layout)))
          (call store-row-cell site cell (. field layout) (call take value field site) meta)
        )
      )
    )
    (lazy known-case (< known (. ([] (. tables layouts rows) row-layout) cases count)))
    (call put-header site (. meta header) 1 next)
    (return (call Typed length (. types index-type)))
  )
  (fn-do _ wraps-case U32
    (param site SyntaxId)
    (param reason ConversionReason)
    (param from TypeId)
    ; The case of a union a value of a type is held as once converted at a site for a reason,
    ; where the one conversion recorded there wraps it as that case, as `wrap-case` says; or
    ; `U32.max` where the conversions there are any other.
    (let found (. U32 max))
    (let fact (call (. facts first-conversion) (. unit reading) site))
    (while (!= fact no-fact)
      (let row ([] (. facts conversions) fact))
      (if (== (. row reason) reason)
        (if (or (!= found (. U32 max)) (!= (. row from) from) runs-or-casts not-case-wrap)
          (return (. U32 max))
        )
        (lazy runs-or-casts (or (!= (. row runs) no-instance) (. row casts)))
        (lazy not-case-wrap (or (!= (. row kind) .relation-wrap-cast) (== (. row case-index) (. U32 max))))
        (= found (. row case-index))
      )
      (= fact (. row next))
    )
    (return found)
  )
  (fn-do _ table-extend _
    (param site SyntaxId)
    (param table Operand)
    (param layout LayoutId)
    (param row TypeId)
    (param row-layout LayoutId)
    (param rows Operand)
    (param rows-type TypeId)
    ; `t.extend(rows)`: each row of the array is appended in turn, each with every check of
    ; `append`.
    (let array-layout (call layout-of rows-type site))
    (let data (call word-at site rows array-layout 0))
    (let size (call word-at site rows array-layout 1))
    (let stride (call integer .machine-u64 (. ([] (. tables layouts rows) row-layout) size)))
    (let counting (call open-pass site size))
    (let index (. counting index))
    (let item
      (call num-cast
        (block
          (arg site)
          (arg
            (call arithmetic
              (block
                (arg site)
                (arg .arithmetic-add)
                (arg data)
                (arg (call arithmetic site .arithmetic-multiply index stride u64-layout))
                (arg u64-layout)
              )
            )
          )
          (arg u64-layout)
          (arg pointer-layout)
        )
      )
    )
    (call table-append site table layout row row-layout item)
    (call close-pass site counting)
  )
  (fn-do _ table-truncate _
    (param site SyntaxId)
    (param table Operand)
    (param layout LayoutId)
    (param requested Operand)
    ; `t.truncate(n)`: the table is checked to grow and to hold at least as many rows; where it
    ; holds more, its views and marks are made stale and the length set.
    (let meta (call require-growable site table layout "truncate"))
    (let length (call header-word site (. meta header) 1))
    (call fail-if
      (block
        (arg site)
        (arg (call compare site .compare-greater requested length))
        (arg "Table truncate length exceeds current length")
      )
    )
    (let shrinking (call (. ir reserve-block)))
    (let joined (call (. ir reserve-block)))
    (call branch (call compare site .compare-less requested length) shrinking joined)
    (call (. ir start-block) shrinking)
    (call count-on site (. meta header) 3)
    (call count-on site (. meta header) 4)
    (call put-header site (. meta header) 1 requested)
    (call jump joined)
    (call (. ir start-block) joined)
  )
  (fn-do _ table-copy-from _
    (param site SyntaxId)
    (param table Operand)
    (param layout LayoutId)
    (param row TypeId)
    (param row-layout LayoutId)
    (param source Operand)
    ; `t.copy-from(s)`: the table is checked to grow, and unless it is the source itself, its views
    ; and marks are made stale and it is emptied; the source's columns and length are read, checked
    ; where it grows, room made for its rows, and each field's column copied over; the length is
    ; then the source's.
    (let meta (call require-growable site table layout "copy-from"))
    (let other (call part source layout 2 site))
    (let copying (call (. ir reserve-block)))
    (let joined (call (. ir reserve-block)))
    (call branch (call compare site .compare-not-equal (. meta header) (. other operand)) copying joined)
    (call (. ir start-block) copying)
    (call count-on site (. meta header) 3)
    (call count-on site (. meta header) 4)
    (call put-header site (. meta header) 1 (call integer .machine-u64 0))
    (call put-header site (. meta header) 6 (call integer .machine-u64 0))
    (let given
      (call TableMeta
        (block
          (arg (. other operand))
          (arg (. (call part source layout 3 site) operand))
          (arg (. (call part source layout 4 site) operand))
          (arg (. (call part source layout 5 site) operand))
          (arg (call integer .machine-u64 0))
        )
      )
    )
    (let rows (call table-rows site source layout given))
    (let columns (. rows columns))
    (let length (. rows length))
    (call reserve-rows site row row-layout meta length)
    (let into (call num-cast site (call header-word site (. meta header) 0) u64-layout pointer-layout))
    (if (== (call (. types intrinsic-of) row) .union)
      (let zero (call integer .machine-u64 0))
      (call copy-union-rows site (call (. tables unions of) row) into zero columns zero length meta false)
      (else
        (for (in position (..< 0 (. ([] (. tables layouts rows) row-layout) fields count)))
          (let field (call (. tables layouts field) row-layout position))
          (let target (call load into (* position 8) pointer-layout site))
          (let out (call load columns (* position 8) pointer-layout site))
          (call copy-items site target out length (. field layout))
        )
      )
    )
    (call put-header site (. meta header) 1 length)
    (call jump joined)
    (call (. ir start-block) joined)
  )
  (fn-do _ table-finish Typed
    (param site SyntaxId)
    (param table Operand)
    (param layout LayoutId)
    ; `t.finish()`: the table is checked to grow, its columns and length read, and its header
    ; sealed; the answer is the finished table of those columns and that length.
    (let type (call (. facts node-type) (. unit reading) site))
    (let finished-layout (call layout-of type site))
    (if (!= (call intrinsic type) .immutable-table)
      (call refuse .refused-expression site)
      (return (call Typed (call make-operand .operand-void 0) no-type))
    )
    (let meta (call require-growable site table layout "finish"))
    (let columns (call header-word site (. meta header) 0))
    (let length (call header-word site (. meta header) 1))
    (call put-header site (. meta header) 0 (call integer .machine-u64 0))
    (let made (call frame finished-layout))
    (call put-word site made finished-layout 0 columns u64-layout)
    (call put-word site made finished-layout 1 length u64-layout)
    (return (call Typed made type))
  )
  (fn-do _ viewed-table Typed
    (param site SyntaxId)
    (param table Operand)
    (param layout LayoutId)
    ; `t.view()`: the table is checked to grow, and the answer is the finished table of its columns
    ; and its length now, which the table goes on growing apart from.
    (let type (call (. facts node-type) (. unit reading) site))
    (let viewed-layout (call layout-of type site))
    (if (!= (call intrinsic type) .immutable-table)
      (call refuse .refused-expression site)
      (return (call Typed (call make-operand .operand-void 0) no-type))
    )
    (let meta (call require-growable site table layout "view"))
    (let made (call frame viewed-layout))
    (call put-word site made viewed-layout 0 (call header-word site (. meta header) 0) u64-layout)
    (call put-word site made viewed-layout 1 (call header-word site (. meta header) 1) u64-layout)
    (return (call Typed made type))
  )
  (fn-do _ table-rewind _
    (param site SyntaxId)
    (param table Operand)
    (param layout LayoutId)
    (param mark Operand)
    (param mark-type TypeId)
    ; `t.rewind(m)`: the table is checked to grow, and the mark to be of this table, its arena and
    ; generation, with no row written since and no more rows than it has now; the length and the use
    ; of the spill are then the mark's, and the shrink generation is counted on.
    (let mark-layout (call layout-of mark-type site))
    (let meta (call require-growable site table layout "rewind"))
    (let stale "Table mark is stale or belongs to another table")
    (call fail-if
      (block
        (arg site)
        (arg (call compare site .compare-not-equal (. meta header) (call word-at site mark mark-layout 0)))
        (arg stale)
      )
    )
    (call fail-if
      (block
        (arg site)
        (arg (call compare site .compare-not-equal (. meta owner) (call word-at site mark mark-layout 1)))
        (arg stale)
      )
    )
    (call fail-if
      (block
        (arg site)
        (arg (call compare site .compare-not-equal (. meta incarnation) (call word-at site mark mark-layout 2)))
        (arg stale)
      )
    )
    (call fail-if
      (block
        (arg site)
        (arg (call compare site .compare-not-equal (. meta generation) (call word-at site mark mark-layout 3)))
        (arg stale)
      )
    )
    (call fail-if
      (block
        (arg site)
        (arg
          (call compare
            (block
              (arg site)
              (arg .compare-not-equal)
              (arg (call header-word site (. meta header) 4))
              (arg (call word-at site mark mark-layout 5))
            )
          )
        )
        (arg stale)
      )
    )
    (let length (call word-at site mark mark-layout 4))
    (call fail-if site (call compare site .compare-greater length (call header-word site (. meta header) 1)) stale)
    (call put-header site (. meta header) 1 length)
    (call put-header site (. meta header) 6 (call word-at site mark mark-layout 6))
    (call count-on site (. meta header) 3)
  )
  (fn-do _ table-checkpoint Typed
    (param site SyntaxId)
    (param table Operand)
    (param layout LayoutId)
    (param arena Operand)
    (param arena-type TypeId)
    (param mark Operand)
    (param mark-type TypeId)
    ; `t.storage-checkpoint(arena, mark)`: the table is checked to grow, to be held by the arena,
    ; and the mark to be the arena's mark now; the checkpoint holds the table's identity, the mark,
    ; the arena's active bytes, and each word of the header.
    (let type (call (. facts node-type) (. unit reading) site))
    (let made-layout (call layout-of type site))
    (let arena-layout (call layout-of arena-type site))
    (let mark-layout (call layout-of mark-type site))
    (let meta (call require-growable site table layout "storage-checkpoint"))
    (let owner (call part arena arena-layout 0 site))
    (let incarnation (call part arena arena-layout 1 site))
    (let value (call word-at site mark mark-layout 0))
    (let stale "Table storage checkpoint mark is stale or belongs to another Arena")
    (call fail-if
      (block
        (arg site)
        (arg (call compare site .compare-not-equal (. meta owner) (call word-at site arena arena-layout 0)))
        (arg stale)
      )
    )
    (call fail-if site (call compare site .compare-not-equal (. meta incarnation) (. incarnation operand)) stale)
    (let mark-at (. pending length))
    (+= pending (. owner operand))
    (+= pending (. incarnation operand))
    (let current (call call-runtime .runtime-arena-mark site mark-at u64-layout))
    (call fail-if site (call compare site .compare-not-equal value current) stale)
    (+= pending (. owner operand))
    (+= pending (. incarnation operand))
    (let active (call call-runtime .runtime-arena-active-bytes site mark-at u64-layout))
    (let made (call frame made-layout))
    (call put-word site made made-layout 0 (. meta header) u64-layout)
    (call put-word site made made-layout 1 (. meta owner) u64-layout)
    (call put-word site made made-layout 2 (. meta incarnation) u64-layout)
    (call put-word site made made-layout 3 (. meta generation) u64-layout)
    (call put-word site made made-layout 4 value u64-layout)
    (call put-word site made made-layout 5 active u64-layout)
    (for (in position (..< 0 8u32))
      (call put-word
        (block
          (arg site)
          (arg made)
          (arg made-layout)
          (arg (+ position 6))
          (arg (call header-word site (. meta header) position))
          (arg u64-layout)
        )
      )
    )
    (return (call Typed made type))
  )
  (fn-do _ table-restore _
    (param site SyntaxId)
    (param table Operand)
    (param layout LayoutId)
    (param passed (list Operand))
    (param checkpoint-type TypeId)
    (param arena-type TypeId)
    (param mark-type TypeId)
    (param restores Bool)
    ; `t.validate-storage-restore(c, arena, mark)` and `t.restore-storage(…)`: the table is checked
    ; to grow, and the checkpoint to be of this table, its arena and generation, at the arena's
    ; mark, with no row written since, the arena's active bytes not fewer (or, to restore, the
    ; same), and no more rows than the table has now. Restoring then gives the header each word the
    ; checkpoint holds, with its generations counted on.
    (let checkpoint-layout (call layout-of checkpoint-type site))
    (let arena-layout (call layout-of arena-type site))
    (let mark-layout (call layout-of mark-type site))
    (let checkpoint ([] passed 0))
    (let meta (call require-growable site table layout "storage checkpoint restore"))
    (let owner (call part ([] passed 1) arena-layout 0 site))
    (let incarnation (call part ([] passed 1) arena-layout 1 site))
    (let value (call word-at site ([] passed 2) mark-layout 0))
    (let mark-at (. pending length))
    (+= pending (. owner operand))
    (+= pending (. incarnation operand))
    (let generation (call call-runtime .runtime-arena-generation site mark-at u64-layout))
    (+= pending (. owner operand))
    (+= pending (. incarnation operand))
    (let active (call call-runtime .runtime-arena-active-bytes site mark-at u64-layout))
    (let stale
      (block
        (case? restores
          "Table storage checkpoint cannot be restored from the current Arena state"
        )
        (default
          "Table storage checkpoint is stale or belongs to another table"
        )
      )
    )
    (call fail-if
      (block
        (arg site)
        (arg
          (call compare
            (block
              (arg site)
              (arg .compare-not-equal)
              (arg (. meta header))
              (arg (call word-at site checkpoint checkpoint-layout 0))
            )
          )
        )
        (arg stale)
      )
    )
    (call fail-if
      (block
        (arg site)
        (arg (call compare site .compare-not-equal (. meta owner) (call word-at site checkpoint checkpoint-layout 1)))
        (arg stale)
      )
    )
    (call fail-if
      (block
        (arg site)
        (arg
          (call compare
            (block
              (arg site)
              (arg .compare-not-equal)
              (arg (. meta incarnation))
              (arg (call word-at site checkpoint checkpoint-layout 2))
            )
          )
        )
        (arg stale)
      )
    )
    (call fail-if
      (block
        (arg site)
        (arg
          (call compare
            (block
              (arg site)
              (arg .compare-not-equal)
              (arg (. meta generation))
              (arg (call word-at site checkpoint checkpoint-layout 3))
            )
          )
        )
        (arg stale)
      )
    )
    (call fail-if
      (block
        (arg site)
        (arg (call compare site .compare-not-equal (. meta owner) (call word-at site ([] passed 1) arena-layout 0)))
        (arg stale)
      )
