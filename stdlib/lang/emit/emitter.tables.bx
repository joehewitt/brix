    (let empty (call TableCursor none none (call TableMeta none none none none none)))
    (let table-type (call field-type type 0))
    (let span-type (call field-type type 1))
    (let item (call viewed-item span-type))
    (let table-layout (call layout-of table-type id))
    (let span-layout (call layout-of span-type id))
    (let item-layout (call layout-of item id))
    (let span (call part selection layout 1 id))
    (call fail-if
      (block
        (arg id)
        (arg (call compare id .compare-greater-equal position (call word-at id (. span operand) span-layout 3)))
        (arg "TableSelection position is out of bounds")
      )
    )
    (let table (call part selection layout 0 id))
    (let index
      (call selected-index
        (block
          (arg id)
          (arg (call resolve-span id (. span operand) span-layout))
          (arg position)
          (arg item)
          (arg item-layout)
        )
      )
    )
    (return (call row-place id (. table operand) table-type table-layout index))
  )
  (fn-do _ emit-span-range Typed
    (param id SyntaxId)
    (param object SyntaxId)
    (param key SyntaxId)
    ; The indices a range spans of an index span at `s[a .. < b]`, or of a selection: the range is
    ; made forward and checked against the span's length, and the span made again from the range's
    ; start, of its length.
    (let none (call make-operand .operand-void 0))
    (let held (call emit-expression object))
    (let type (. held type))
    (let range (call table-range id key))
    (let layout (call layout-of type id))
    (let spans (== (call intrinsic type) .index-span))
    (let span-type (if-expr spans type (call field-type type 1)))
    (let span-layout (call layout-of span-type id))
    (let span (if-expr spans held (call part (. held operand) layout 1 id)))
    (let bounds
      (call range-bounds
        (block
          (arg id)
          (arg range)
          (arg (. held operand))
          (arg type)
          (arg object)
          (arg (call word-at id (. span operand) span-layout 3))
          (arg (if-expr spans "IndexSpan" "TableSelection"))
        )
      )
    )
    (let made (call frame layout))
    (call copy made (. held operand) layout false id)
    (let made-span
      (scope (if-expr spans made (call address made span-offset span-layout id))
        (lazy span-offset (. (call (. tables layouts field) layout 1) offset))
      )
    )
    (let start
      (call arithmetic
        (block
          (arg id)
          (arg .arithmetic-add)
          (arg (call word-at id (. span operand) span-layout 2))
          (arg (. bounds start))
          (arg u64-layout)
        )
      )
    )
    (call put-word id made-span span-layout 2 start u64-layout)
    (call put-word id made-span span-layout 3 (. bounds length) u64-layout)
    (return (call Typed made type))
  )
  (fn-do + row-value Typed
    (param id SyntaxId)
    (param cursor TableCursor)
    (param row TypeId)
    ; A row of a table made a value from where it lies: the columns, left out where the table
    ; grows, the index, and the table's metadata; a finished table's row holds its columns and
    ; its index alone.
    (let none (call make-operand .operand-void 0))
    (let layout (call layout-of row id))
    (let made (call frame layout))
