━━━━━━━━━━━━━━━━━━━━
+ LinkPlan is Tuple

` A link's linker command line, and the files besides the object that it reads.

+ arguments [String]
+ inputs [String]

━━━━━━━━━━━━━━━━━━━━
+ do link-plan LinkPlan ?! Error
    - program Program
    - object-path String
    - executable-path String
    - target Target

` Plans how to link an object into an executable for a target, with the linker of its object format
` and the arguments the project's runtime build config names. It links the components the config
` always links, those whose headers the program imports, and every component they require. The
` target's entry in the config names its family, triple and libraries, and for Apple targets its
` SDK, the default SDK when it names none, or for Linux its sysroot and linker. The host's runtime
` is built with the toolchain and has every component; another target's entry names its build
` directory and the components built for it, and its runtime is built here when it is stale. On
` the host, the runtime is the variant the environment chooses, and a sanitizer's runtime library
` is linked with it.
. config = runtime-config()
. platform = target-config(config, target)
. variant = runtime-variant(config)
?! Error("BRIX_GC_MODE, BRIX_SANITIZER and BRIX_BENCH_RUNTIME choose a runtime only for ${host-target().name}")
    if target.name != host-target().name && variant.is-chosen
?! Error("BRIX_SANITIZER is supported only for Apple targets")
    if variant.sanitizer && target.object-format != .macho
. build-path = variant.build-path(target-build-path(target, platform))
if target.name != host-target().name
    build-runtime(target, build-path)
. components = link-components(config, program, target, platform)
. family = config-string(platform, "family")
. linked = LinkInputs(config, platform, build-path, components, family, variant.omitted-archives(config, build-path))
. arguments = match target.object-format
    |= .macho
        apple-link-arguments(linked, target, object-path, executable-path, sanitizer-library(config, variant))
    |= .elf
        linux-link-arguments(linked, object-path, executable-path)
. inputs [String]
inputs += runtime-config-path() as String
inputs ++= linked.library-files
inputs ++= linked.archives
= LinkPlan(arguments, inputs)

━━━━━━━━━━━━━━━━━━━━
+ do link-executable ?! Error
    - plan LinkPlan
    - record-path String?

` Runs a link plan's linker, and writes its command line to the record path when one is given.
. process = Process(plan.arguments[0], plan.arguments[1 ...])
. output = process as String
. status = process.wait(null) ?? 1
process.close()
?! Error("Linking failed with status $status\n$output")
    if status != 0
if record-path
    write-file-atomically(Path(record-path), to-json(link-record(plan.arguments)))

━━━━━━━━━━━━━━━━━━━━
+ do run-executable Int
    - path String
    - arguments [String]

` Replaces this process with the program, so its output, input and exit status are the
` program's own. Returns only when the program could not be started.
. argv = String[arguments.length + 2]
argv[0] = path
for index in 0 .. < arguments.length
    argv[index + 1] = arguments[index]
C:execv(path, argv)
stderr <- "Unable to run $path\n"
= 1

━━━━━━━━━━━━━━━━━━━━
_ LinkInputs is Tuple

` What a link reads from the runtime build config: the config, the target's entry in it, where the
` target's runtime is built, the components the program links, the target's family, and the
` archives the runtime's GC mode does not build.

+ config JSON
+ platform JSON
+ build-path Path
+ components [JSON]
+ family String
+ omitted [String]

────────────────────
+ do get library-files [String]

` The prebuilt libraries the components name.
. files [String]
for component in components
    for path in component-strings(component, family, "libraryPaths")
        files += runtime-file(path, build-path) as String
= files

────────────────────
+ do get archives [String]

` The archives the runtime build makes for the components.
. paths [String]
for component in components
    . archive = (component as [String = JSON])["archive"]
    if archive && archive is String
        . path = (build-path / (archive as String)) as String
        if !(omitted has path)
            paths += path
= paths

━━━━━━━━━━━━━━━━━━━━
_ RuntimeVariant is Tuple

` The host runtime a link uses: the GC mode `BRIX_GC_MODE` names, `normal` when it names none, the
` sanitizer `BRIX_SANITIZER` names, if any, and whether `BRIX_BENCH_RUNTIME` asks for the runtime
` built with benchmark metrics.

+ gc-mode-name String
+ gc-mode JSON
+ sanitizer JSON?
+ bench Bool

────────────────────
+ get is-chosen Bool

gc-mode-name != "normal" || sanitizer != null || bench

────────────────────
+ do build-path Path ?! Error
    - root Path

` Where the variant's runtime is built under a build root: in the GC mode's build directory and
` then the sanitizer's, when they name one and the root is not already there, and in `bench` for
` the benchmark runtime.
. path = root
. mode-directory = config-optional-string(gc-mode, "buildDirectory")
if mode-directory && path.name != mode-directory
    path = path / mode-directory
if sanitizer
    . sanitizer-directory = config-string(sanitizer, "buildDirectory")
    if path.name != sanitizer-directory
        path = path / sanitizer-directory
if bench
    path = path / "bench"
= path

────────────────────
+ do omitted-archives [String] ?! Error
    - config JSON
    - build-path Path

` The archives of the runtime projects the GC mode leaves out of its runtime.
. projects = config-member(config, "runtimeProjects")
. archives [String]
for name in config-strings(gc-mode, "omitProjects")
    archives += (build-path / config-string(config-member(projects, name), "archive")) as String
= archives

━━━━━━━━━━━━━━━━━━━━
_ do runtime-variant RuntimeVariant ?! Error
    - config JSON

` The host runtime the environment chooses. A benchmark-only GC mode needs the benchmark runtime.
. mode-name = (env("BRIX_GC_MODE") ?? "").trim().lowercased
. name = if mode-name != "" then mode-name else "normal"
. modes = config-member(config, "gcModes")
. mode = (modes as [String = JSON])[name] if modes is [String = JSON]
. names [String]
for key, _ in modes as [String = JSON]
    names += key
?! Error("BRIX_GC_MODE must be one of ${", ".join(names)}")
    if !mode
. bench = environment-flag("BRIX_BENCH_RUNTIME")
. benchmark-only = (mode as [String = JSON])["benchmarkOnly"] if mode is [String = JSON]
?! Error("BRIX_GC_MODE=$name is benchmark-only; set BRIX_BENCH_RUNTIME=1")
    if benchmark-only && benchmark-only is Bool && benchmark-only as Bool && !bench
= RuntimeVariant(name, mode, runtime-sanitizer(config), bench)

━━━━━━━━━━━━━━━━━━━━
_ do runtime-sanitizer JSON? ?! Error
    - config JSON

` The sanitizer `BRIX_SANITIZER` names by its name in the runtime build config or by its build
` directory, or none when it is empty, `off` or `none`.
. value = (env("BRIX_SANITIZER") ?? "").trim().lowercased
=? null if value == "" || value == "off" || value == "none"
. sanitizers = config-member(config, "sanitizers")
. names [String]
for name, sanitizer in sanitizers as [String = JSON]
    =? sanitizer if name == value || config-optional-string(sanitizer, "buildDirectory") == value
    names += name
?! Error("BRIX_SANITIZER must be off, none or one of ${", ".join(names)}")

━━━━━━━━━━━━━━━━━━━━
_ environment-flag Bool ?! Error
    - name String

` Whether an environment variable is set to true: 1, true, yes or on, against empty, 0, false, no or
` off.
?! Error("$name must be 0 or 1")
    if !truth && !(["", "0", "false", "no", "off"] has value)
truth

.. value = (env(name) ?? "").trim().lowercased
.. truth = ["1", "true", "yes", "on"] has value

━━━━━━━━━━━━━━━━━━━━
_ do sanitizer-library Path? ?! Error
    - config JSON
    - variant RuntimeVariant

` The runtime library of the variant's sanitizer, where the toolchain's C compiler keeps it.
=? null if !variant.sanitizer
. name = config-string(variant.sanitizer, "library")
. compiler = config-string(config-member(config, "toolchain"), "cCompiler")
. process = Process("/usr/bin/xcrun", compiler, "-print-file-name=$name")
. output = process as String
. status = process.wait(null) ?? 1
process.close()
. library = Path(output.trim())
?! Error("The toolchain's $compiler has no $name for BRIX_SANITIZER")
    if status != 0 || !library.is-file
= library

━━━━━━━━━━━━━━━━━━━━
_ do apple-link-arguments [String] ?! Error
    - linked LinkInputs
    - target Target
    - object-path String
    - executable-path String
    - sanitizer-library Path?

` The link ld makes for an Apple target. A sanitizer's runtime library is linked with a search path
` that finds it where the toolchain keeps it.
. platform = linked.platform
. triple-parts [String] = config-string(platform, "triple").split("-")
. sdk-name = config-optional-string(platform, "sdk")
. sdk = if sdk-name then apple-sdk-path(sdk-name) else sdk-root
. arguments [String]
arguments += apple-linker-path()
arguments += "-dynamic"
arguments += "-arch"
arguments += triple-parts[0]
arguments += "-platform_version"
arguments += target.name
arguments += os-version-text(target.minimum-os-version)
arguments += sdk-version(sdk)
arguments += "-syslibroot"
arguments += sdk as String
. frameworks [String]
for component in linked.components
    for framework in component-strings(component, linked.family, "frameworks")
        if !(frameworks has framework)
            frameworks += framework
for framework in frameworks
    arguments += "-framework"
    arguments += framework
arguments ++= linked.library-files
if sanitizer-library
    arguments += sanitizer-library as String
    arguments += "-rpath"
    arguments += sanitizer-library.dir as String
for library in config-strings(platform, "libraries")
    arguments += "-l$library"
arguments ++= linked.archives
for flag in config-strings(config-member(linked.config, "runtimeLink"), "warningFlags")
    arguments += flag
arguments += "-o"
arguments += executable-path
arguments += object-path
arguments += "-lSystem"
= arguments

━━━━━━━━━━━━━━━━━━━━
_ do linux-link-arguments [String] ?! Error
    - linked LinkInputs
    - object-path String
    - executable-path String

` The link clang's driver makes for a position-independent executable against the sysroot's
` shared glibc, with libstdc++ and libgcc linked statically.
. platform = linked.platform
. sysroot = runtime-file(config-string(platform, "sysroot"), linked.build-path)
. gcc = sysroot / config-string(platform, "gccInstallDirectory")
. libraries = sysroot / "usr/lib64"
. arguments [String]
arguments += runtime-file(config-string(platform, "linker"), linked.build-path) as String
arguments += "--sysroot=$sysroot"
arguments ++= ["-EL", "--hash-style=gnu", "--eh-frame-hdr", "-m", "aarch64linux", "-pie", "-z", "relro", "-z", "now"]
arguments ++= ["-dynamic-linker", "/lib/ld-linux-aarch64.so.1"]
arguments += "-o"
arguments += executable-path
arguments += (libraries / "Scrt1.o") as String
arguments += (libraries / "crti.o") as String
arguments += (gcc / "crtbeginS.o") as String
arguments += "-L$gcc"
arguments += "-L$libraries"
arguments += object-path
arguments ++= linked.archives
arguments ++= linked.library-files
for library in config-strings(platform, "libraries")
    arguments += "-l$library"
arguments ++= ["-Bstatic", "-lstdc++", "-Bdynamic", "-lm", "-lgcc", "-lgcc_eh", "-lc", "-lgcc", "-lgcc_eh"]
arguments += (gcc / "crtendS.o") as String
arguments += (libraries / "crtn.o") as String
= arguments

━━━━━━━━━━━━━━━━━━━━
_ link-record [String = JSON]
    - arguments [String]

Map'String'JSON
    • "arguments" json-strings(arguments) as JSON

━━━━━━━━━━━━━━━━━━━━
_ json-strings [JSON]
    - values [String]

<* value in values
    value as JSON

━━━━━━━━━━━━━━━━━━━━
_ do link-components [JSON] ?! Error
    - config JSON
    - program Program
    - target Target
    - platform JSON

. components [String = JSON]
for group in ["runtimeProjects", "externalLibraries"]
    . found = (config as [String = JSON])[group] if config is [String = JSON]
    if found && found is [String = JSON]
        for name, component in found as [String = JSON]
            if component is [String = JSON]
                components[name] = component
. providers [String = String]
for name, component in components
    . exports = (component as [String = JSON])["exports"]
    if exports && exports is [String = JSON]
        for _, root in exports as [String = JSON]
            if root is String
                providers[root] = name

. pending [(String, String)]
for name in config-strings(config-member(config, "runtimeLink"), "always")
    pending += (name, "runtimeLink.always")
for module in program.modules
    . slash = module.name.find("/") ?? 0
    if slash > 0 && module.name.ends-with(".h")
        . provider = providers[module.name[0 .. < slash]]
        if provider
            pending += (provider, module.name)
. required [String = Bool]
. index Size
while index < pending.length
    . name = pending[index][0]
    . required-by = pending[index][1]
    index += 1
    if !required[name]
        . component = components[name]
        ?! Error("The runtime build config's $required-by requires unknown $name")
            if !component
        ?! Error("$required-by requires $name, which the runtime build config does not build for $target.name")
            if target.name != host-target().name && !builds-component
        .. builds-component = config-strings(platform, "components") has name
        required[name] = true
        for dependency in config-strings(component, "requires")
            pending += (dependency, name)

. linked [JSON]
for name, component in components
    if required[name]
        linked += component
= linked

━━━━━━━━━━━━━━━━━━━━
_ component-strings [String]
    - component JSON
    - family String
    - name String

` A component's list for a family of targets: the family's own list when the component names one,
` and the component's list otherwise.
|? override && override is [String = JSON] && (override as [String = JSON])[name]
    config-strings(override, name)
??
    config-strings(component, name)

.. overrides = (component as [String = JSON])["targets"] if component is [String = JSON]
.. override = (overrides as [String = JSON])[family] if overrides && overrides is [String = JSON]

━━━━━━━━━━━━━━━━━━━━
_ do sdk-version String ?! Error
    - sdk Path

= config-string(JSON(read-file-text(sdk / "SDKSettings.json")), "Version")

━━━━━━━━━━━━━━━━━━━━
_ os-version-text String
    - version U32

"${version /zrshift/ 16}.${(version /zrshift/ 8) /and/ 0xff}.${version /and/ 0xff}"
