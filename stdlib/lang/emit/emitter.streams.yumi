. viewed = facts.first-call(unit.reading, matched)
. commits = next-call(viewed)
. extends = next-call(commits)
if commits == no-fact || next-call(extends) != no-fact
    refuse(.refused-function, rule)
    =
if !tables.layouts.is-struct(captured-layout) || unpaired-capture
    refuse(.refused-type, rule)
    =
.. unpaired-capture = tables.layouts.rows[captured-layout].fields.count != 2
. run = view-stream
    - matched
    - make-operand(.operand-argument, 0)
    - local.stream
    - true
    - viewed
    - extends
. failed = ir.reserve-block()
adapting = direct
. given = attempt-arms(named, pattern, result, run, false, commits, failed, false)
adapting = no-function
