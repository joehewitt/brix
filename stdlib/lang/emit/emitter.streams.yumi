. layout = layout-of(result, id)
. end = ir.add-local(run.index-layout)
. joined = ir.reserve-block()
. slot = join-slot(layout)
. mark = joins.length
. outer = load-local(run.error, id)
store-local(run.error, cursor, id)
. missed = ir.reserve-block()
. own-unit = unit
. own-streaming = streaming
unit = unit.source-module = target.module
unit = unit.reading = target.owner
streaming = streaming.observer-row = U32.max
streaming = streaming.rollback-mark = no-local
streaming = streaming.rollback-row = U32.max
plan-choices(target.pattern)
