    - append(.op-local-address, id, Span(), cells.erred, pointer-layout)

────────────────────
_ do take-rule-answer StreamPart
    - run StreamRun
    - id SyntaxId
    - result TypeId
    - cursor Operand
    - failed IRBlockId
    - cells RuleCells
    - answer Typed
    - given-mark LocalId
    - lendings [Lending]
    - mapped Bool
    - spanned Bool

` What a part that called a rule gives once the rule answered: the collectors it lent are taken
` back and how far it read and where it failed are recorded; where its answer holds nothing the
` part fails, and otherwise it ends where the rule stopped, giving what it read where the rule
` is `mapped` or the part `spanned`, and otherwise what the answer holds, of type `result`.
reclaim-collectors(lendings, id)
record-call-extent(run, id, load-local(cells.reached, id))
record-error(run, id, load-local(cells.erred, id))
. flag = present(id, answer)
. passed = ir.reserve-block()
branch(flag.operand, passed, failed)
ir.start-block(passed)
take-mark(given-mark, id)
if mapped || spanned
    . ending = load-local(cells.ended, id)
    = StreamPart(ending, spanned-value(run, id, spanned, cursor, ending))
. value = payload(id, answer)
if value.type != result
    refuse(.refused-type, id)
    = bare-part(cursor)
= StreamPart(load-local(cells.ended, id), Typed(value.operand, result))

────────────────────
+ do lazy-rule-call StreamPart
    - run StreamRun
    - id SyntaxId
    - helper FunctionId
    - result TypeId
    - cursor Operand
    - failed IRBlockId
    - mappings RowRange'SyntaxId = RowRange'SyntaxId()
    - spanned Bool = false

` A call of a local rule of a rule that runs as a function of its own: it is given the rule's
` stream and the arguments the rule was given, from the rule's function or another such, then
` the address the stream's items start at, the cursor and the count of items, and where to keep
` where it ended, how far it read and the farthest cursor a part of it failed at, which the
` pattern counts as its own. Where it passed, the call gives what it gave and goes on where it
` ended; where not, the call fails. An error it raises leaves the function with the call. A
` call given collectors lends the function the caller's lists, and gives no value, as does one
` `spanned`, which gives the text it matched, but as `spanned-value` says. One of a rule whose
` pattern holds a rollback mark gives it as a call of the rule does. In the function of a rule
` made for a pattern that may raise errors, the call is of the local rule's function made for
` it, whose errors leave the function with the call. The function of a local rule beside a
` match, which the function `emit-rule-adapter` makes calls, is given the stream alone before
` the address.
. called = helper
. target = tables.functions[called]
. place = facts.local-rule-of(unit.instance, tables.lazy-rule-decl(target))
. answer-type = if place != U32.max then facts.local-rules[place].answer else no-type
. signature = instances.signatures[unit.instance]
. raising = signature.errors.count != 0
. returned = if raising && place != U32.max then facts.local-rules[place].result else answer-type
if carried-given != no-type
    called = tables.raising-rule-of(unit.instance, tables.lazy-rule-decl(target), carried-given)
    if called == no-function || raising || mappings.count != 0 || target.kind != .lazy-rule
        refuse(.refused-expression, id)
        = bare-part(cursor)
    target = tables.functions[called]
    returned = facts.raising-rules[target.place].result
    raising = true
. helped = instances.rows[unit.instance].helper
. bare = tables.rule-adapter-of(unit.instance, tables.lazy-rule-decl(target)) != no-function
if bare
    if unanswerable || helped != no-type || mappings.count != 0 || spanned || other-rule-stream
        refuse(.refused-expression, id)
        = bare-part(cursor)
    .. unanswerable = answer-type == no-type || returned == no-type || (raising && in-zone)
    .. other-rule-stream = run.stream-type != facts.local-rules[place].stream
else if !rule-arguments || answerless || other-stream || (raising && in-zone) || other-helper
    refuse(.refused-expression, id)
    = bare-part(cursor)
.. answerless = answer-type == no-type || returned == no-type || signature.args.count == 0
.. other-stream = run.stream-type != instances.argument-type(unit.instance, 0)
.. other-helper = helped != no-type && streaming.pattern-helper-type != helped
. returns = layout-of(returned, id)
. cells = rule-cells(run)
. mark = pending.length
pending += run.stream
if !bare
    for position in 1 .. < signature.args.count
        pending += rule-argument(position, id)
pass-run(run, id, cursor, cells)
if helped != no-type
    pending += streaming.pattern-helper
. given-mark = lend-mark(unit.instance, id)
. lendings = lend-collectors(id, mappings)
ir.depend(.callee-function, called, if target.may-panic then may-panic-dependency else 0u32)
. enters = is-free(unit.instance)
. crosses = enters != in-zone
. checked = target.may-panic && !in-landing
. closing = closing-pad(checked && crosses && enters)
if crosses
    cross-zone(id, enters)
. answer = call
    - make-operand(.operand-symbol, target.symbol)
    - id
    - mark
    - .callee-function
    - returns
    - checked
    - false
    - closing
cross-back(id, enters, raising)
land-closed(closing, id)
if raising
    answer = propagate-held(id, returned, answer).operand
. answered = Typed(answer, answer-type)
= take-rule-answer(run, id, result, cursor, failed, cells, answered, given-mark, lendings, mappings.count != 0, spanned)

────────────────────
_ do lend-collectors [Lending]
    - id SyntaxId
    - mappings RowRange'SyntaxId

` Lends a function a call runs the lists of the caller's names its collectors map, in the
` order written: each as a collector in memory of the frame, whose pointer is the next
` argument, holding the list's items and count, and the context its backing keeps them with.
. lendings [Lending]
for mapping in tree.children[mappings]
    do match? tree.nodes[mapping]
        | .node-stream-collector-mapping(row)
            . level = accumulator-level(row.caller.text)
            if level == U32.max
                refuse(.refused-expression, mapping)
                = lendings
            . held = capture-levels[level]
            . layout = layout-of(held.collector, id)
            . memory = frame(layout)
            zero(memory, layout)
            put(memory, tables.layouts.field(layout, 0), load-local(held.items, id), id)
            put(memory, tables.layouts.field(layout, 1), load-local(held.size, id), id)
            if held.context != no-local
                put(memory, tables.layouts.field(layout, 2), load-local(held.context, id), id)
            pending += address(memory, 0, pointer-layout, id)
            lendings += Lending(memory, level)
= lendings

────────────────────
_ do reclaim-collectors
    - lendings [Lending]
    - id SyntaxId

` Takes back into each list the caller keeps what the function a call ran left in the
` collector it was lent.
for lending in lendings
    . held = capture-levels[lending.level]
    . layout = layout-of(held.collector, id)
    store-local(held.items, take(lending.memory, tables.layouts.field(layout, 0), id), id)
    store-local(held.size, take(lending.memory, tables.layouts.field(layout, 1), id), id)

────────────────────
_ do lends-alike Bool
    - callee InstanceId
    - mappings RowRange'SyntaxId

` Whether each list of the caller's a call of a rule a module declares lends it is a list of
` what the rule's name it is given for accumulates, kept in a collector of the same type, as
` the type pass typed the rule.
. row = instances.rows[callee]
. source = program.modules[row.module].tree
. pattern SyntaxId = 0
do match? source.nodes[rule-match(program, row.module, row.decl)]
    | .node-stream-match(matched)
        pattern = matched.pattern
for mapping in tree.children[mappings]
    do match? tree.nodes[mapping]
        | .node-stream-collector-mapping(written)
            . name = if written.callee then written.callee.text else written.caller.text
            . level = accumulator-level(written.caller.text)
            . site = if pattern != 0 then accumulated-site(source, pattern, name) else 0
            if site == 0 || level == U32.max || list-differs || mismatched
                = false
            .. list-differs = facts.node-type(callee, site) != capture-levels[level].list
            .. mismatched = accumulated-collector(callee, site) != capture-levels[level].collector
= true

────────────────────
_ do accumulated-site SyntaxId
    - source AST
    - id SyntaxId
    - name String

` Where a pattern captures a name it accumulates in a part of its own, or none.
do match? source.nodes[id]
    | .node-stream-capture(row)
        . named = source.identifier-name(row.name)
        if row.accumulating && named && named.text == name
            = row.name
        = accumulated-site(source, row.pattern, name)
    | .node-stream-and(row)
        . left = accumulated-site(source, row.left, name)
        = if left != 0 then left else accumulated-site(source, row.right, name)
    | .node-stream-or(row)
        . left = accumulated-site(source, row.left, name)
        = if left != 0 then left else accumulated-site(source, row.right, name)
    | .node-stream-transform(row)
        if row.pattern != 0
            = accumulated-site(source, row.pattern, name)
    | .node-stream-panic(row)
        = accumulated-site(source, row.pattern, name)
    | .node-stream-unary(row)
        = accumulated-site(source, row.operand, name)
    | .node-stream-length(row)
        = accumulated-site(source, row.operand, name)
= 0

────────────────────
_ do accumulated-collector TypeId
    - owner InstanceId
    - site SyntaxId

` The collector an instance keeps the list of a name it accumulates in, by the call the type
` pass recorded at the name that grows it, after the one that makes its text where it has one.
. fact = facts.first-call(owner, site)
if fact != no-fact && facts.plan-of(owner, site) != .plan-stream-value
    fact = facts.calls[fact].next
if fact == no-fact || facts.calls[fact].callee == no-instance
    = no-type
= instances.rows[facts.calls[fact].callee].self-type

────────────────────
+ do hold-captures ?! Refused
    - run StreamRun
    - id SyntaxId
    - repeats U32 = 0

` Keeps a place for each name a grammar captures: the cursors its text begins and ends
` at, and for an optional name whether it holds any, which starts as none; or for a name that
` holds what a rule gave or an item a test passed, a local of its type, which for an optional
` name starts as nothing, or in repeats of what one pass captured; and for a name captured in
` repeats, the list each keeps. Each name is bound to its place
` while the arms are emitted. A name a rule's arms capture with different types has a place
` for each type, and one captured as text in one arm and as what a rule gave in another has a
` place for each. A rule run where it is called keeps places of its own, apart from those a
` run of it that this one is inside keeps.
do match? tree.nodes[id]
    | .node-stream-capture(row)
        . slot = captured-slot(row.name)
        if slot == no-slot
            refuse(.refused-expression, id)
            =
        if row.accumulating
            if !held-here(captured-at(slot))
                hold-accumulator(run, id, slot, row.name)
            hold-captures(run, row.pattern, repeats)
            =
        . valued = facts.plan-of(unit.reading, row.name) == .plan-stream-value
        if !held-here(captured-as(slot, facts.node-type(unit.reading, row.name), valued))
            . type = facts.node-type(unit.reading, row.name)
            . begin = ir.add-local(run.index-layout)
            . end = ir.add-local(run.index-layout)
            store-local(begin, run.start, id)
            store-local(end, run.start, id)
            . present = no-local
            . value = no-local
            if valued && repeats == 0
                . layout = layout-of(type, id)
                value = ir.add-local(layout)
                if types.is-optional(type)
                    store-local(value, empty-optional(type, layout).operand, id)
            else if !valued && types.is-optional(type) && repeats == 0
                present = ir.add-local(u8-layout)
                store-local(present, integer(.machine-u8, 0), id)
            . levels = capture-levels.length as U32
            bound += BoundValue
                - slot
                - type
                - make-operand(.operand-void, 0)
                - U32.max
                - stream-captures.length as U32
            stream-captures += StreamCapture
                - slot
                - row.name
                - begin
                - end
                - present
                - value
                - type
                - run
                - repeats
                - levels
            . held = (stream-captures.length - 1) as U32
            hold-levels(held, id)
            if valued && repeats != 0
                stream-captures[held] = stream-captures[held].value = ir.add-local(layout-of(capture-levels[levels].item, id))
        hold-captures(run, row.pattern, repeats)
    | .node-stream-and(row)
        hold-captures(run, row.left, repeats)
        hold-captures(run, row.right, repeats)
    | .node-stream-or(row)
        hold-captures(run, row.left, repeats)
        hold-captures(run, row.right, repeats)
    | .node-stream-transform(row)
        hold-captures(run, row.pattern, repeats)
    | .node-stream-panic(row)
        hold-captures(run, row.pattern, repeats)
    | .node-stream-unary(row)
        . repeat = row.op == .zero-or-more-op || row.op == .one-or-more-op
        hold-captures(run, row.operand, if repeat then repeats + 1 else repeats)
    | .node-stream-length(row)
        hold-captures(run, row.operand, repeats + 1)

────────────────────
_ held-here Bool
    - position U32

` Whether a place a name is kept in is one of the rule being run where it is called, and not
` one of a run this one is inside.
position != U32.max && position >= streaming.capture-floor

────────────────────
_ do hold-accumulator
    - run StreamRun
    - id SyntaxId
    - slot SlotId
    - name SyntaxId

` Keeps the list a name that accumulates adds to, empty as the pattern starts, as the
` reference's collector starts, or the list of the caller's a call given a collector for the
` name `borrows`.
. type = facts.node-type(unit.reading, name)
. text = tree.identifier-name(name)!.text
for borrow in borrows
    if borrow.name == text
        if capture-levels[borrow.level].list != type
            refuse(.refused-expression, id)
            =
        bound += BoundValue
            - slot
            - type
            - make-operand(.operand-void, 0)
            - U32.max
            - stream-captures.length as U32
        stream-captures += StreamCapture
            - slot
            - name
            - no-local
            - no-local
            - no-local
            - no-local
            - type
            - run
            - 1
            - borrow.level
            - true
            - true
        =
. levels = capture-levels.length as U32
bound += BoundValue
    - slot
    - type
    - make-operand(.operand-void, 0)
    - U32.max
    - stream-captures.length as U32
stream-captures += StreamCapture
    - slot
    - name
    - no-local
    - no-local
    - no-local
    - no-local
    - type
    - run
    - 1
    - levels
    - true
hold-levels((stream-captures.length - 1) as U32, id)
. level = capture-levels[levels]
if lent-first != U32.max
    for position in 0 .. < collector-args.length
        if collector-args[position] == text
            . pointer = make-operand(.operand-argument, lent-first + (position as U32))
            . layout = layout-of(level.collector, id)
            store-local(level.items, take(pointer, tables.layouts.field(layout, 0), id), id)
            store-local(level.size, take(pointer, tables.layouts.field(layout, 1), id), id)
            if level.context != no-local
                store-local(level.context, take(pointer, tables.layouts.field(layout, 2), id), id)
            . mark = ir.add-local(u64-layout)
            store-local(mark, load-local(level.size, id), id)
            lent += LentCollector(lent-first + (position as U32), level, mark)
            =
start-level(level, id)

────────────────────
_ do hold-levels
    - held U32
    - site SyntaxId

` Keeps the list each repeat around a name keeps, from the innermost out, as the calls the type pass
` recorded at the name after the one that makes its text, if it has one, say: a collector of the
` text or of the item, then of the lists the repeat inside it made. Each list is the type of an item
` of the next, and the outermost is the name's type.
. capture = stream-captures[held]
if capture.listed == 0
    =
. growers [FactId]
. fact = facts.first-call(unit.reading, capture.site)
. valued = facts.plan-of(unit.reading, capture.site) == .plan-stream-value
for level in 0 .. < capture.listed
    if level != 0 || !valued
        fact = if fact != no-fact then facts.calls[fact].next else no-fact
    if fact == no-fact || facts.calls[fact].callee == no-instance
        refuse(.refused-expression, site)
        =
    growers += fact
for level in 0 .. < growers.length
    . callee = facts.calls[growers[level]].callee
    . collector = instances.rows[callee].self-type
    . outer = if level + 1 < growers.length then outer-collector else no-type
        .. outer-collector = instances.rows[facts.calls[growers[level + 1]].callee].self-type
    . ranged = material-at(capture.site, .material-ranges)
    . last = if ranged != U32.max then facts.materials[ranged].type else capture.type
    . list = if outer != no-type then class-arg(types, outer, 0) else last
    . items = ir.add-local(layout-of(instances.signatures[callee].returns, site))
    . size = ir.add-local(u64-layout)
    . context = context-local(collector, site)
    capture-levels += CaptureLevel
        - held
        - items
        - size
        - growers[level]
        - collector
        - class-arg(types, collector, 0)
        - list
        - context

────────────────────
+ do drop-captures
    - captured Size

` Drops the places of the names captured since a count of them, with their lists, but for
` the lists of callers they borrowed.
for position in captured .. < stream-captures.length
    if !stream-captures[position].borrowed
        . kept = stream-captures[position].levels as Size
        -= capture-levels[kept .. < capture-levels.length]
        break
-= stream-captures[captured .. < stream-captures.length]

────────────────────
_ captured-slot SlotId
    - name SyntaxId

if resolution.kind == .resolve-slot then resolution.slot else no-slot

.. resolution = bindings.resolution-of(instances.rows[unit.reading].binding, name)

────────────────────
_ do captured-as U32
    - slot SlotId
    - type TypeId
    - valued Bool

` The place the pattern keeps a name captured with a type in, as what a rule gave where
` `valued` and else as the text it matched, or `U32.max`.
. position = stream-captures.length
while position != 0
    position -= 1
    . place = stream-captures[position]
    if place.slot == slot && place.type == type && (place.value != no-local) == valued
        = position as U32
= U32.max

────────────────────
_ do activate-captures
    - arm SyntaxId

` Makes the places an arm keeps its names in the ones their slots read while the arm is
` emitted: where another arm of the rule captures a name with another type, or as what a
` rule gave where this one captures its text, or the other way, whose place the slot would
` read, the arm's own is put after it for as long as the arm is emitted. An arm whose
` alternatives capture one name both ways reads the place that keeps what a rule gave, as
` `stream-capture` says.
activate-kind(arm, false)
activate-kind(arm, true)

────────────────────
_ do activate-kind
    - arm SyntaxId
    - valued Bool

` Puts the places of the names an arm captures as what a rule gave, where `valued`, or as the
` text they matched, after the ones their slots would read.
for node in tree.subtree-start(arm) .. < arm + 1
    do match? tree.nodes[node]
        | .node-stream-capture(row)
            . slot = captured-slot(row.name)
            . type = facts.node-type(unit.reading, row.name)
            . held = if slot != no-slot then captured-at(slot) else U32.max
            if plan-matches && open-capture && (stream-captures[held].type != type || value-differs)
                . place = captured-as(slot, type, valued)
                if place == U32.max
                    refuse(.refused-expression, node)
                    =
                . kept = stream-captures[place]
                bound += BoundValue
                    - slot
                    - type
                    - make-operand(.operand-void, 0)
                    - U32.max
                    - stream-captures.length as U32
                stream-captures += StreamCapture
                    - kept.slot
                    - kept.site
                    - kept.begin
                    - kept.end
                    - kept.present
                    - kept.value
                    - kept.type
                    - kept.run
                    - kept.listed
                    - kept.levels
                    - kept.accumulates
                    - true
            .. plan-matches = (facts.plan-of(unit.reading, row.name) == .plan-stream-value) == valued
            .. open-capture = held != U32.max && !stream-captures[held].accumulates
            .. value-differs = (stream-captures[held].value != no-local) != valued

────────────────────
_ do captured-at U32
    - slot SlotId

. position = stream-captures.length
while position != 0
    position -= 1
    if stream-captures[position].slot == slot
        = position as U32
= U32.max

────────────────────
_ do stream-capture StreamPart
    - run StreamRun
    - id SyntaxId
    - name SyntaxId
    - pattern SyntaxId
    - cursor Operand
    - failed IRBlockId

` A part a name captures: where it passes, the name holds the text from the cursor to where
` it ended, or what a rule the part calls gave, held as an optional where the name is one. A
` name that captures an optional part holds nothing where the part's operand fails. A part
` the type pass recorded to make its text through the helper makes it where it passes, as
` `make-eager` says. A name another alternative of the arm captures as what a rule gave keeps
` its text in the same place, made where the part passes, as the reference makes it where the
` alternatives join; under a helper, or where the two are not one type, it is refused.
. held = captured-at(captured-slot(name))
if held == U32.max
    refuse(.refused-expression, id)
    = bare-part(cursor)
. capture = stream-captures[held]
if capture.accumulates
    = accumulate(run, id, name, pattern, capture, cursor, failed)
if capture.value != no-local && facts.plan-of(unit.reading, name) != .plan-stream-value
    if listed-or-helped || types.is-optional(capture.type) || retyped-or-partial
        refuse(.refused-expression, id)
        = bare-part(cursor)
    .. listed-or-helped = capture.listed != 0 || streaming.pattern-helper-type != no-type
    .. retyped-or-partial = facts.node-type(unit.reading, name) != capture.type || tree.optional-part(pattern)
    . part = emit-stream-part(run, pattern, cursor, failed)
    . text = stream-text(run, name, cursor, part.ending)
    store-local(capture.value, text.operand, id)
    = part
if capture.value != no-local
    . part = emit-stream-part(run, pattern, cursor, failed)
    . given = part.value.operand
    . given-type = part.value.type
    if given-type == no-type
        refuse(.refused-expression, id)
        = bare-part(cursor)
    . kept = given
    . kept-type = if capture.listed != 0 then capture-levels[capture.levels].item else capture.type
    if given-type != kept-type
        if !types.is-optional(kept-type) || types.optional-inner(kept-type) != given-type
            refuse(.refused-expression, id)
            = bare-part(cursor)
        kept = wrap(id, Typed(given, given-type), kept-type).operand
    store-local(capture.value, kept, id)
    = part
do match? tree.nodes[pattern]
    | .node-stream-unary(row)
        if row.op == .zero-or-one-op && capture.present != no-local
            . joined = ir.reserve-block()
            . missed = ir.reserve-block()
            . mark = joins.length
            . marks = mark-levels(row.operand)
            . tried = emit-stream-part(run, row.operand, cursor, missed)
            . passed = tried.ending
            hold-text(capture, cursor, passed, id)
            make-eager(run, pattern, cursor, passed)
            arrive(id, passed, joined, make-operand(.operand-void, 0))
            ir.start-block(missed)
            rewind-levels(marks, id)
            clear-captures(row.operand, id)
            store-local(capture.present, integer(.machine-u8, 0), id)
            arrive(id, cursor, joined, make-operand(.operand-void, 0))
            = StreamPart(close-joins(joined, mark, run.index-layout, make-operand(.operand-void, 0)), tried.value)
. part = emit-stream-part(run, pattern, cursor, failed)
if tree.optional-part(pattern) && material-at(pattern, .material-eager) != U32.max
    refuse(.refused-expression, id)
    = bare-part(cursor)
hold-text(capture, cursor, part.ending, id)
make-eager(run, pattern, cursor, part.ending)
= part

────────────────────
_ do make-eager
    - run StreamRun
    - part SyntaxId
    - begun Operand
    - ending Operand

` Makes what the type pass recorded a part a name captures makes of the text it matched
` where it passes, by a capture materializer of the helper, as the reference makes it there.
` Nothing reads what it makes.
. eager = material-at(part, .material-eager)
if eager != U32.max
    material-capture(run, part, eager, begun, ending)

────────────────────
_ do accumulate StreamPart
    - run StreamRun
    - id SyntaxId
    - name SyntaxId
    - pattern SyntaxId
    - capture StreamCapture
    - cursor Operand
    - failed IRBlockId

` A part whose name accumulates: where it passes, its list gains the text it matched, made
` then, or what a rule it calls gave. The part gives what its own part gives. One the type
` pass recorded to make its text through the helper makes it too, as `make-eager` says.
. part = emit-stream-part(run, pattern, cursor, failed)
make-eager(run, pattern, cursor, part.ending)
. element = part.value
if facts.plan-of(unit.reading, name) != .plan-stream-value
    element = stream-text(run, name, cursor, part.ending)
else if part.value.type == no-type
    refuse(.refused-expression, id)
append-level(capture-levels[capture.levels], element, name)
= part

────────────────────
_ do mark-levels [LevelMark]
    - id SyntaxId

` Keeps how many items each list of a name that accumulates in a part of a pattern holds
` where the part begins, and each list of the caller's a call in it is given a collector for.
. marks [LevelMark]
mark-levels-in(id, marks)
for position in 0 .. < marks.length
    . level = capture-levels[marks[position].level]
    . mark = ir.add-local(u64-layout)
    store-local(mark, load-local(level.size, id), id)
    marks[position] = marks[position].mark = mark
= marks

────────────────────
_ do mark-levels-in
    - id SyntaxId
    - marks [LevelMark]

do match? tree.nodes[id]
    | .node-stream-capture(row)
        . held = captured-at(captured-slot(row.name))
        if held != U32.max && stream-captures[held].accumulates
            . level = stream-captures[held].levels
            . found = false
            for mark in marks
                found = found || mark.level == level
            if !found
                marks += LevelMark(level, no-local)
        mark-levels-in(row.pattern, marks)
    | .node-stream-call(row)
        for mapping in tree.children[row.collector-mappings]
            do match? tree.nodes[mapping]
                | .node-stream-collector-mapping(written)
                    . level = accumulator-level(written.caller.text)
                    . found = false
                    for mark in marks
                        found = found || mark.level == level
                    if level != U32.max && !found
                        marks += LevelMark(level, no-local)
    | .node-stream-and(row)
        mark-levels-in(row.left, marks)
        mark-levels-in(row.right, marks)
    | .node-stream-or(row)
        mark-levels-in(row.left, marks)
        mark-levels-in(row.right, marks)
    | .node-stream-transform(row)
        if row.pattern != 0
            mark-levels-in(row.pattern, marks)
    | .node-stream-panic(row)
        mark-levels-in(row.pattern, marks)
    | .node-stream-unary(row)
        mark-levels-in(row.operand, marks)
    | .node-stream-length(row)
        mark-levels-in(row.operand, marks)

────────────────────
+ do rewind-levels
    - marks [LevelMark]
    - site SyntaxId

` Cuts each list back to the count it held where a part began, as the reference's collector
` is rewound: an item past it that holds what the collector traces is first set to what its
` type holds with nothing written.
for held in marks
    rewind-level(capture-levels[held.level], held.mark, site)

────────────────────
+ do rewind-level
    - level CaptureLevel
    - mark LocalId
    - site SyntaxId

` Cuts a list back to the count a local holds, setting each item past it that holds what the
` collector traces to what its type holds with nothing written first.
. item-layout = layout-of(level.item, site)
if tables.layouts.rows[item-layout].is-managed
    . index = ir.add-local(u64-layout)
    store-local(index, load-local(mark, site), site)
    . test = ir.reserve-block()
    . body = ir.reserve-block()
    . done = ir.reserve-block()
    jump(test)
    ir.start-block(test)
    branch
        - compare(site, .compare-less, load-local(index, site), load-local(level.size, site))
        - body
        - done
    ir.start-block(body)
    . blank = blank-item(level, item-layout, site)
    put-item(level, load-local(index, site), blank.operand, item-layout, site)
    store-local
        - index
        - arithmetic
            - site
            - .arithmetic-add
            - load-local(index, site)
            - integer(.machine-u64, 1)
            - u64-layout
        - site
    jump(test)
    ir.start-block(done)
store-local(level.size, load-local(mark, site), site)

────────────────────
_ do blank-item Typed
    - level CaptureLevel
    - layout LayoutId
    - site SyntaxId

` What an item of a list holds with nothing written, as the reference's default value of its
` type: the empty text for a text, and no bits set but for the texts in a struct.
if tables.layouts.is-struct(layout)
    = null-value(level.item, layout, site)
if level.item == types.string-type
    = Typed(make-operand(.operand-constant, ir.add-string("")), level.item)
= Typed(integer(.machine-pointer, 0), level.item)

────────────────────
+ do no-mark Typed
    - site SyntaxId

` A rollback mark that holds none: zero for one held as an integer, as the reference keeps one,
` and else the optional that holds nothing.
. row = facts.rollback-bodies[streaming.rollback-row]
. layout = layout-of(row.kept, site)
if row.kept == row.held
    = Typed(integer(tables.layouts.kind-of(layout), 0), row.held)
= empty-optional(row.kept, layout)

────────────────────
+ do holds-mark Operand
    - mark Operand
    - site SyntaxId

` Whether a rollback mark holds one.
. row = facts.rollback-bodies[streaming.rollback-row]
if row.kept == row.held
    . compared = compare
        - site
        - .compare-not-equal
        - mark
        - integer(tables.layouts.kind-of(layout-of(row.held, site)), 0)
    = compared
= present(site, Typed(mark, row.kept)).operand

────────────────────
+ do ensure-mark
    - site SyntaxId

` Asks the helper for a rollback mark before an action runs, where the part being emitted holds
` none yet, as the reference asks for one: the earliest it holds is kept.
if streaming.rollback-mark == no-local
    refuse(.refused-expression, site)
    =
. row = facts.rollback-bodies[streaming.rollback-row]
. asked = ir.reserve-block()
. done = ir.reserve-block()
branch(holds-mark(load-local(streaming.rollback-mark, site), site), done, asked)
ir.start-block(asked)
. made = call-protocol
    - site
    - row.mark
    - streaming.pattern-helper
    - streaming.pattern-helper-type
    - make-operand(.operand-void, 0)
if row.kept != row.held
    made = wrap(site, Typed(made.operand, row.held), row.kept)
store-local(streaming.rollback-mark, made.operand, site)
jump(done)
ir.start-block(done)

────────────────────
_ do clear-mark
    - site SyntaxId

` Leaves the part being emitted holding no rollback mark.
if streaming.rollback-mark != no-local
    store-local(streaming.rollback-mark, no-mark(site).operand, site)

────────────────────
+ do enter-marks LocalId
    - site SyntaxId

` Sets aside the rollback mark a part holds as a part of it begins, which begins with none, as the
` reference begins each arm of a choice, an optional's operand, each pass of a repeat, a
` lookahead's operand and a local rule run where it is called. None where the pattern holds no
` mark.
if streaming.rollback-mark == no-local
    = no-local
. saved = ir.add-local(ir.locals[streaming.rollback-mark].layout)
store-local(saved, load-local(streaming.rollback-mark, site), site)
clear-mark(site)
= saved

────────────────────
+ do pass-marks
    - saved LocalId
    - site SyntaxId

` Where a part of a part passed, the part holds the rollback mark it held before, where it held
` one, and else what the part of it holds.
if saved == no-local
    =
. kept = ir.reserve-block()
. done = ir.reserve-block()
branch(holds-mark(load-local(saved, site), site), kept, done)
ir.start-block(kept)
store-local(streaming.rollback-mark, load-local(saved, site), site)
jump(done)
ir.start-block(done)

────────────────────
+ do fail-marks
    - saved LocalId
    - site SyntaxId

` Where a part of a part failed, the rollback mark that part holds is given back, and the part
` holds what it held before.
if saved == no-local
    =
rewind-mark(site)
store-local(streaming.rollback-mark, load-local(saved, site), site)

────────────────────
_ do next-arm
    - saved LocalId
    - site SyntaxId

` Where an arm of a choice failed, the rollback mark it holds is given back, and the next begins
` with none.
if saved == no-local
    =
rewind-mark(site)
clear-mark(site)

────────────────────
_ do gather-mark
    - gathered LocalId
    - site SyntaxId

` Where a pass of a repeat passed, the repeat keeps the rollback mark it holds, where it kept none
` yet.
if gathered == no-local
    =
. taken = ir.reserve-block()
. done = ir.reserve-block()
branch(holds-mark(load-local(gathered, site), site), done, taken)
ir.start-block(taken)
store-local(gathered, load-local(streaming.rollback-mark, site), site)
jump(done)
ir.start-block(done)

────────────────────
_ do settle-repeat
    - saved LocalId
    - gathered LocalId
    - site SyntaxId

` Where a repeat passed, the part holds the rollback mark it held before it, where it held one,
` and else the earliest its passes held.
if saved == no-local
    =
store-local(streaming.rollback-mark, load-local(gathered, site), site)
pass-marks(saved, site)

────────────────────
_ do lend-mark LocalId
    - callee InstanceId
    - site SyntaxId

` Where a rule a pattern calls gives the rollback mark its pattern holds as it passes, a local of
` the caller's frame the rule keeps it in, whose address is the next argument. The caller must
` hold marks of the same type.
if !carries(callee)
    = no-local
. body = facts.rollback-body-of
    - callee
    - rule-match(program, instances.rows[callee].module, instances.rows[callee].decl)
if streaming.rollback-mark == no-local || body == U32.max || kept-differs
    refuse(.refused-expression, site)
    = no-local
.. kept-differs = facts.rollback-bodies[body].kept != facts.rollback-bodies[streaming.rollback-row].kept
. given = ir.add-local(ir.locals[streaming.rollback-mark].layout, true, true)
pending += make-operand
    - .operand-value
    - append(.op-local-address, site, Span(), given, pointer-layout)
= given

────────────────────
+ do take-mark
    - given LocalId
    - site SyntaxId

` Where a rule a part called passed, the part holds the rollback mark the rule gave, where it held
` none.
if given == no-local
    =
. taken = ir.reserve-block()
. done = ir.reserve-block()
branch(holds-mark(load-local(streaming.rollback-mark, site), site), done, taken)
ir.start-block(taken)
store-local(streaming.rollback-mark, load-local(given, site), site)
jump(done)
ir.start-block(done)

────────────────────
_ do hold-text
    - capture StreamCapture
    - begun Operand
    - ending Operand
    - site SyntaxId

store-local(capture.begin, begun, site)
store-local(capture.end, ending, site)
if capture.present != no-local
    store-local(capture.present, integer(.machine-u8, 1), site)

────────────────────
_ do clear-captures ?! Refused
    - id SyntaxId
    - site SyntaxId

` Leaves each optional name a part of a pattern captures holding nothing.
do match? tree.nodes[id]
    | .node-stream-capture(row)
        . held = captured-at(captured-slot(row.name))
        if held != U32.max && stream-captures[held].present != no-local
            store-local(stream-captures[held].present, integer(.machine-u8, 0), site)
        if held != U32.max && stream-captures[held].value != no-local && optional-held
            . type = stream-captures[held].type
            store-local
                - stream-captures[held].value
                - empty-optional(type, layout-of(type, site)).operand
                - site
        .. optional-held = types.is-optional(stream-captures[held].type)
        clear-captures(row.pattern, site)
    | .node-stream-and(row)
        clear-captures(row.left, site)
        clear-captures(row.right, site)
    | .node-stream-or(row)
        clear-captures(row.left, site)
        clear-captures(row.right, site)
    | .node-stream-unary(row)
        clear-captures(row.operand, site)

────────────────────
_ do stream-optional StreamPart
    - run StreamRun
    - id SyntaxId
    - operand SyntaxId
    - cursor Operand

` An optional part: its operand where it passes, and else nothing, from the cursor. Where the
` operand fails, the names captured in it hold nothing, and the lists names accumulate in it
` are cut back. Where the operand gives what a rule
` gave, the part gives it as an optional, which holds nothing where the operand failed; so
` does one the type pass planned to give the text it matched, made where the operand passes.
` The operand begins holding no rollback mark, as `enter-marks` says, and gives back the one
` it holds where it fails.
. joined = ir.reserve-block()
. missed = ir.reserve-block()
. mark = joins.length
. marks = mark-levels(operand)
. entered = enter-marks(id)
. tried = emit-stream-part(run, operand, cursor, missed)
. passed = tried.ending
. given = tried.value.operand
. given-type = tried.value.type
if given-type == no-type && gives-value(id)
    . texted = stream-text(run, id, cursor, passed)
    given = texted.operand
    given-type = texted.type
. type = if given-type != no-type then facts.node-type(unit.reading, id) else no-type
if given-type != no-type && (!types.is-optional(type) || types.optional-inner(type) != given-type)
    refuse(.refused-expression, id)
    = bare-part(cursor)
. kept = no-local
if type != no-type
    . layout = layout-of(type, id)
    kept = ir.add-local(layout)
    store-local(kept, wrap(id, Typed(given, given-type), type).operand, id)
pass-marks(entered, id)
arrive(id, passed, joined, make-operand(.operand-void, 0))
ir.start-block(missed)
rewind-levels(marks, id)
fail-marks(entered, id)
clear-captures(operand, id)
if kept != no-local
    store-local(kept, empty-optional(type, layout-of(type, id)).operand, id)
arrive(id, cursor, joined, make-operand(.operand-void, 0))
. ending = close-joins(joined, mark, run.index-layout, make-operand(.operand-void, 0))
if kept != no-local
    = StreamPart(ending, Typed(load-local(kept, id), type))
= bare-part(ending)

────────────────────
+ do read-capture Typed
    - id SyntaxId
    - held U32
    - type TypeId

` What a name a grammar captured holds where an action reads it: the text between the
` cursors its part began and ended at, made where it is read, or for an optional name nothing
` where its part did not pass; or in a stream that holds no characters, the part of the
` buffer between them; or what a rule gave, or the item a test passed, as it was kept; or for
` a name captured in repeats, the list the outermost made. Where the type pass narrowed an
` optional name kept as a value to what it holds, the read is of that, as a local's is. A name
` captured over text that the type pass kept as a span is read as the span between its cursors,
` and for an optional name, as such a span where its part passed.
. nothing = make-operand(.operand-void, 0)
. capture = stream-captures[held]
if type != capture.type && capture.type == types.string-type && bare-capture
    = text-span(capture, id, type)
.. bare-capture = capture.value == no-local && capture.listed == 0 && capture.present == no-local
. spans = flag-only && capture.listed == 0 && types.is-optional(type) && optional-string
    .. flag-only = type != capture.type && capture.present != no-local && capture.value == no-local
    .. optional-string = types.optional-inner(capture.type) == types.string-type
if type != capture.type && !spans
    if capture.listed != 0 || capture.value == no-local || shared-depth != 0 || unheld-type
        refuse(.refused-expression, id)
        = Typed(nothing, no-type)
    .. unheld-type = !holds(capture.type, type)
    = payload(id, Typed(load-local(capture.value, id), capture.type))
if capture.listed != 0
    = level-list(capture-levels[capture.levels + capture.listed - 1], id)
if capture.value != no-local
    = Typed(load-local(capture.value, id), type)
if capture.present == no-local && facts.plan-of(unit.reading, capture.site) == .plan-stream-slice
    = stream-slice
        - capture.run
        - capture.site
        - load-local(capture.begin, id)
        - load-local(capture.end, id)
if capture.present == no-local
    = stream-text
        - capture.run
        - capture.site
        - load-local(capture.begin, id)
        - load-local(capture.end, id)
. layout = layout-of(type, id)
. slot = join-slot(layout)
. joined = ir.reserve-block()
. holds = ir.reserve-block()
. empty = ir.reserve-block()
. mark = joins.length
branch
    - compare(id, .compare-not-equal, load-local(capture.present, id), integer(.machine-u8, 0))
    - holds
    - empty
ir.start-block(holds)
. text = if spans then text-span(capture, id, types.optional-inner(type)) else stream-text(capture.run, capture.site, load-local(capture.begin, id), load-local(capture.end, id))
arrive(id, wrap(id, text, type).operand, joined, slot)
ir.start-block(empty)
arrive(id, empty-optional(type, layout).operand, joined, slot)
. result = close-joins(joined, mark, layout, slot)
= Typed(result, type)

────────────────────
_ do stream-literal Operand
    - run StreamRun
    - id SyntaxId
    - text String
    - cursor Operand
    - failed IRBlockId

` Text a pattern matches item by item, or byte by byte of its UTF-8 where the buffer holds a
` String's (`encodes`). Where the input ends first, the pattern read as far as the whole text,
` which in UTF-8 lies as many characters past the end as the text has left; where an item
` differs, as far as that item; either way the text failed where it began. Where it passes it
` read as far as the end of the text.
. encoded = encodes(run)
. points = text.codepoints
. units = if encoded then List'U64((each as U64) in Array'Byte(text)) else point-units
    .. point-units = List'U64((each as U64) in points)
if units.length == 0
    = cursor
. missed = failure-of(run, id, cursor, failed)
. end = stream-advance(run, id, cursor, units.length as U64)
. kind = tables.layouts.rows[run.item-layout].kind
. reached Size = 0
for offset in 0 .. < units.length
    . spot = stream-advance(run, id, cursor, offset as U64)
    . present = ir.reserve-block()
    . short = ir.reserve-block()
    branch-present(run, id, spot, present, short)
    ir.start-block(short)
    record-extent
        - run
        - id
        - if encoded then stream-advance(run, id, spot, (points.size - reached) as U64) else end
    jump(missed)
    ir.start-block(present)
    . same = ir.reserve-block()
    . differs = ir.reserve-block()
    branch
        - compare(id, .compare-equal, stream-item(run, id, spot), integer(kind, units[offset]))
        - same
        - differs
    ir.start-block(differs)
    record-extent(run, id, stream-advance(run, id, spot, 1))
    jump(missed)
    ir.start-block(same)
    if (units[offset] /and/ 0xC0) != 0x80
        reached += 1
record-extent(run, id, end)
record-literals(run, id, text, cursor)
= end

────────────────────
_ do stream-class Operand
    - run StreamRun
    - id SyntaxId
    - first U64
    - last U64
    - any Bool
    - cursor Operand
    - failed IRBlockId

` One item a pattern matches where it lies in a range, or any item with `any`. The pattern
` reads as far as the item, there or not; a `deferred-part` keeps that only where it fails.
` Where the buffer is UTF-8, a range of ASCII is tested on the byte at the cursor, and any other
` on the character there, decoded; the part passes past the character's bytes.
. missed = failure-of(run, id, cursor, failed)
. next = stream-advance(run, id, cursor, 1)
. defers = deferred-part == plan-key(unit.source-module, id)
. lost = if defers then extent-failure(run, id, next, missed) else missed
. present = ir.reserve-block()
. ended = ir.reserve-block()
branch-present(run, id, cursor, present, ended)
ir.start-block(ended)
record-extent(run, id, next)
jump(missed)
ir.start-block(present)
if !defers
    record-extent(run, id, next)
if any
    = char-next(run, id, cursor)
. wide = encodes(run) && last >= 0x80
. kind = tables.layouts.rows[if wide then read-layout(run, id) else run.item-layout].kind
. item = if wide then char-at(run, id, cursor) else stream-item(run, id, cursor)
. above = ir.reserve-block()
. inside = ir.reserve-block()
branch(compare(id, .compare-greater-equal, item, integer(kind, first)), above, lost)
ir.start-block(above)
branch(compare(id, .compare-less-equal, item, integer(kind, last)), inside, lost)
ir.start-block(inside)
= if wide then char-next(run, id, cursor) else next

────────────────────
_ do extent-failure IRBlockId
    - run StreamRun
    - id SyntaxId
    - probe Operand
    - missed IRBlockId

` A block that keeps a cursor a part read up to as how far the pattern read, then goes on to
` where the part fails. What is emitted next goes on past it.
. lost = ir.reserve-block()
. onward = ir.reserve-block()
jump(onward)
ir.start-block(lost)
record-extent(run, id, probe)
jump(missed)
ir.start-block(onward)
= lost

────────────────────
_ do stream-sequence StreamPart
    - run StreamRun
    - id SyntaxId
    - cursor Operand
    - failed IRBlockId

` A sequence tried from a cursor, its parts in turn, each from where the one before it ended,
` where a sequence in it is one with it. Lookaheads that each test one item, with the part after
` them that reads one, are tried as one test, as `stream-fused` says, which defers what it keeps
` where it is the whole of a `deferred-part`.
. parts [SyntaxId]
sequence-parts(id, parts)
. whole = deferred-part == plan-key(unit.source-module, id)
. at = bare-part(cursor)
. position Size = 0
while position < parts.length
    . fused = fused-length(run, parts, position)
    if fused != 0
        at = stream-fused(run, parts, position, fused, at.ending, failed, whole && fused == parts.length)
        position += fused
    else
        at = emit-stream-part(run, parts[position], at.ending, failed)
        position += 1
= at

────────────────────
_ do sequence-parts
    - id SyntaxId
    - parts [SyntaxId]

` The parts of a sequence in order, where a sequence in it is one with it.
do match? tree.nodes[id]
    | .node-stream-and(row)
        sequence-parts(row.left, parts)
        sequence-parts(row.right, parts)
        =
parts += id

────────────────────
_ do item-ranges [ItemRange]?
    - id SyntaxId

` The items a part that tests one item passes on: a text of one character, or a range. None
` for any other part.
do match? tree.nodes[id]
    | .node-stream-string(row)
        . points = row.text.codepoints
        if points.size == 1
            = single-range(points[0] as U64, points[0] as U64)
    | .node-stream-char-range(row)
        = single-range(tree.stream-bound(row.first), tree.stream-bound(row.last))
= null

────────────────────
_ do looked-ranges [ItemRange]?
    - id SyntaxId

` The items a lookahead of a part that tests one item looks for, as `item-ranges` gives them.
` None for any other part.
do match? tree.nodes[id]
    | .node-stream-unary(row)
        if row.op == .positive-lookahead-op || row.op == .negative-lookahead-op
            = item-ranges(row.operand)
= null

────────────────────
_ do fused-length Size
    - run StreamRun
    - parts [SyntaxId]
    - start Size

` How many parts of a sequence from `start` `stream-fused` tries as one test: lookaheads of a
` part that tests one item, then a part that reads one, `.` or one `item-ranges` gives. None
` where the helper observes literal words, or the items are no numbers, or where the buffer
` is UTF-8 and a range is one the byte a character starts with does not test (`wide-ranges`).
if streaming.observer-row != U32.max || !is-integer(run.item-layout)
    = 0
. count Size = 0
while start + count < parts.length && looked-ranges(parts[start + count]) != null && !wide-ranges(run, looked-ranges(parts[start + count])!)
    count += 1
if count == 0 || start + count >= parts.length
    = 0
. last = parts[start + count]
if !(tree.nodes[last] is .node-stream-any) && unbounded-ranges
    = 0
.. unbounded-ranges = item-ranges(last) == null || wide-ranges(run, item-ranges(last)!)
= count + 1

────────────────────
_ do stream-fused StreamPart
    - run StreamRun
    - parts [SyntaxId]
    - start Size
    - count Size
    - cursor Operand
    - failed IRBlockId
    - defers Bool = false

` Lookaheads that each test one item and the part after them that reads one, tried from a
` cursor as one test of the item there. Each reads as far as the item, there or not, as the
` reference's do, and keeps the cursor as one a part failed at where it fails. A negative
` lookahead keeps it where it passes too, since its part failed. The test passes where an item
` lies at the cursor that each positive lookahead's part passes on, no negative one's does, and
` the last part passes on, and gives the item where the last is a `.` the type pass typed as it.
` One that `defers`, as a `deferred-part` does, keeps how far it read only where it fails, and
` the cursor a negative lookahead's part failed at not where it passes. Where the buffer is
` UTF-8 the tests are of the byte a character starts with, the item a `.` gives is the
` character, decoded, and the test passes past its bytes.
. last = parts[start + count - 1]
. next = stream-advance(run, last, cursor, 1)
if !defers
    record-extent(run, last, next)
. failure = failure-of(run, last, cursor, failed)
. missed = if defers then extent-failure(run, last, next, failure) else failure
. present = ir.reserve-block()
branch-present(run, last, cursor, present, missed)
ir.start-block(present)
. item = stream-item(run, last, cursor)
. negated = false
for position in start .. < start + count - 1
    . part = parts[position]
    do match? tree.nodes[part]
        | .node-stream-unary(row)
            . onward = ir.reserve-block()
            if row.op == .negative-lookahead-op
                negated = true
                branch-ranges(run, part, item, item-ranges(row.operand)!, missed, onward)
            else
                branch-ranges(run, part, item, item-ranges(row.operand)!, onward, missed)
            ir.start-block(onward)
. ranges = item-ranges(last)
if ranges
    . passed = ir.reserve-block()
    branch-ranges(run, last, item, ranges, passed, missed)
    ir.start-block(passed)
if negated && !defers
    record-error(run, last, cursor)
if tree.nodes[last] is .node-stream-any
    . typed = facts.node-type(unit.reading, last)
    if typed != no-type
        . item-at = char-at(run, last, cursor)
        = StreamPart(char-next(run, last, cursor), Typed(item-at, typed))
    = bare-part(char-next(run, last, cursor))
= bare-part(next)

────────────────────
_ do stream-dynamic-text Operand
    - run StreamRun
    - id SyntaxId
    - value SyntaxId
    - cursor Operand
    - failed IRBlockId

` Text a pattern matches item by item that a value gives as the pattern runs. Its length is
` read, checked, by the first call the type pass recorded at the part, and where the input
` ends first the pattern read as far as the whole text. Its characters are then read in turn by
` the second, from where the last ended, and compared with the items from the cursor: where
` one differs the pattern read as far as that item. Either way the text failed where it began.
` Where it passes it read as far as the end of the text. Where the buffer is UTF-8 the text is
` matched by its bytes, as `stream-dynamic-bytes` says.
if encodes(run)
    = stream-dynamic-bytes(run, id, value, cursor, failed)
. nothing = make-operand(.operand-void, 0)
. measures = facts.first-call(unit.reading, id)
. reads = next-call(measures)
if reads == no-fact
    refuse(.refused-expression, id)
    = cursor
. missed = failure-of(run, id, cursor, failed)
. text = emit-expression(value)
if text.type != types.string-type
    refuse(.refused-type, id)
    = cursor
. size-layout = layout-of(types.size-type, id)
. measured = call-protocol(id, measures, text.operand, types.string-type, nothing)
. count = num-cast(id, measured.operand, size-layout, run.index-layout)
. end = arithmetic(id, .arithmetic-add, cursor, count, run.index-layout)
. compare-block = ir.reserve-block()
. short = ir.reserve-block()
if run.kept-length == no-local
    branch(compare(id, .compare-less-equal, end, run.length), compare-block, short)
else
    jump(compare-block)
ir.start-block(short)
record-extent(run, id, end)
jump(missed)
ir.start-block(compare-block)
. offset = ir.add-local(run.index-layout)
store-local(offset, integer(tables.layouts.rows[run.index-layout].kind, 0), id)
. byte = ir.add-local(size-layout)
store-local(byte, integer(tables.layouts.rows[size-layout].kind, 0), id)
. test = ir.reserve-block()
. read = ir.reserve-block()
. matched = ir.reserve-block()
. mismatch = ir.reserve-block()
. next = ir.reserve-block()
jump(test)
ir.start-block(test)
branch(compare(id, .compare-less, load-local(offset, id), count), read, matched)
ir.start-block(read)
. decoded = call-protocol(id, reads, text.operand, types.string-type, load-local(byte, id), types.size-type)
. decoded-type = decoded.type
. decoded-layout = layout-of(decoded-type, id)
. onward = part(decoded.operand, decoded-layout, 0, id)
. held = part(decoded.operand, decoded-layout, 1, id)
if !types.is-optional(held.type)
    refuse(.refused-type, id)
    = cursor
. expected = payload(id, held)
. spot = arithmetic(id, .arithmetic-add, cursor, load-local(offset, id), run.index-layout)
if run.kept-length != no-local
    . lies = ir.reserve-block()
    branch-present(run, id, spot, lies, short)
    ir.start-block(lies)
. item = stream-item(run, id, spot)
if layout-of(expected.type, id) != run.item-layout
    refuse(.refused-type, id)
    = cursor
branch(compare(id, .compare-equal, item, expected.operand), next, mismatch)
ir.start-block(next)
store-local(offset, stream-advance(run, id, load-local(offset, id), 1), id)
store-local(byte, onward.operand, id)
jump(test)
ir.start-block(mismatch)
. reached = arithmetic(id, .arithmetic-add, cursor, load-local(offset, id), run.index-layout)
record-extent(run, id, stream-advance(run, id, reached, 1))
jump(missed)
ir.start-block(matched)
record-extent(run, id, end)
= end

────────────────────
_ do stream-dynamic-bytes Operand
    - run StreamRun
    - id SyntaxId
    - value SyntaxId
    - cursor Operand
    - failed IRBlockId

` Text a value gives as the pattern runs, matched byte by byte of its UTF-8 where the buffer
` holds a String's: it is read checked by the first call the type pass recorded at the part,
` and its count of bytes by the second. Where the input ends first, the pattern read as far as
` the whole text; where a byte differs, as far as that byte. Either way the text failed where
` it began. Where it passes it read as far as the end of the text.
. nothing = make-operand(.operand-void, 0)
. checks = facts.first-call(unit.reading, id)
. measures = next-call(checks)
if measures == no-fact
    refuse(.refused-expression, id)
    = cursor
. missed = failure-of(run, id, cursor, failed)
. text = emit-expression(value)
if text.type != types.string-type
    refuse(.refused-type, id)
    = cursor
. text-layout = layout-of(types.string-type, id)
call-protocol(id, checks, text.operand, types.string-type, nothing)
. measured = call-protocol(id, measures, text.operand, types.string-type, nothing)
. measured-layout = layout-of(measured.type, id)
if !is-integer(measured-layout)
    refuse(.refused-type, id)
    = cursor
. kind = tables.layouts.rows[run.index-layout].kind
. count = num-cast(id, measured.operand, measured-layout, run.index-layout)
. end = arithmetic(id, .arithmetic-add, cursor, count, run.index-layout)
. compare-block = ir.reserve-block()
. short = ir.reserve-block()
if run.kept-length == no-local
    branch(compare(id, .compare-less-equal, end, run.length), compare-block, short)
else
    jump(compare-block)
ir.start-block(short)
record-extent(run, id, end)
jump(missed)
ir.start-block(compare-block)
. bytes = num-cast(id, text.operand, text-layout, pointer-layout)
. offset = ir.add-local(run.index-layout)
store-local(offset, integer(kind, 0), id)
. test = ir.reserve-block()
. read = ir.reserve-block()
. matched = ir.reserve-block()
. mismatch = ir.reserve-block()
. next = ir.reserve-block()
jump(test)
ir.start-block(test)
branch(compare(id, .compare-less, load-local(offset, id), count), read, matched)
ir.start-block(read)
. spot = arithmetic(id, .arithmetic-add, cursor, load-local(offset, id), run.index-layout)
if run.kept-length != no-local
    . lies = ir.reserve-block()
    branch-present(run, id, spot, lies, short)
    ir.start-block(lies)
. expected = load
    - moved-bytes(id, bytes, num-cast(id, load-local(offset, id), run.index-layout, u64-layout))
    - 0
    - run.item-layout
    - id
branch(compare(id, .compare-equal, stream-item(run, id, spot), expected), next, mismatch)
ir.start-block(next)
store-local(offset, stream-advance(run, id, load-local(offset, id), 1), id)
jump(test)
ir.start-block(mismatch)
record-extent
    - run
    - id
    - stream-advance
        - run
        - id
        - arithmetic(id, .arithmetic-add, cursor, load-local(offset, id), run.index-layout)
        - 1
jump(missed)
ir.start-block(matched)
record-extent(run, id, end)
= end

────────────────────
_ do stream-dynamic-item StreamPart
    - run StreamRun
    - id SyntaxId
    - value SyntaxId
    - cursor Operand
    - failed IRBlockId

` One item a pattern compares with a value of a type like the items' that it evaluates as it
` runs, first, as the reference does: the part gives the value where they are equal, and reads
` as far as the item, there or not. Where the buffer is UTF-8 the item is the character there,
` decoded, and the part passes past its bytes.
. missed = failure-of(run, id, cursor, failed)
. expected = emit-expression(value)
. type = expected.type
if type != facts.node-type(unit.reading, id) || layout-of(type, id) != read-layout(run, id)
    refuse(.refused-type, id)
    = bare-part(cursor)
. next = stream-advance(run, id, cursor, 1)
. present = ir.reserve-block()
. ended = ir.reserve-block()
branch-present(run, id, cursor, present, ended)
ir.start-block(ended)
record-extent(run, id, next)
jump(missed)
ir.start-block(present)
. item = char-at(run, id, cursor)
record-extent(run, id, next)
. passed = ir.reserve-block()
branch(compare(id, .compare-equal, item, expected.operand), passed, missed)
ir.start-block(passed)
= StreamPart(char-next(run, id, cursor), Typed(expected.operand, type))

────────────────────
_ do stream-case-item StreamPart
    - run StreamRun
    - id SyntaxId
    - cursor Operand
    - failed IRBlockId

` One item of a union a pattern tests for a case named by its symbol, by the number the type
` pass recorded: where the item holds the case, the part gives what the case holds, or the item
` where the type pass typed the part as the items. It reads as far as the item, there or not.
. type = facts.node-type(unit.reading, id)
. constant = facts.constant-of(unit.reading, id)
. layout = read-layout(run, id)
if constant == no-fact || encodes(run) || !tables.layouts.is-union(layout)
    refuse(.refused-type, id)
    = bare-part(cursor)
. index = facts.constants[constant].bits as U32
if index >= tables.layouts.rows[layout].cases.count
    refuse(.refused-type, id)
    = bare-part(cursor)
. field = tables.layouts.case-field(layout, index)
. whole = type == class-arg(types, run.buffer-type, 0)
if !whole && field.type != type
    refuse(.refused-type, id)
    = bare-part(cursor)
. missed = failure-of(run, id, cursor, failed)
. next = stream-advance(run, id, cursor, 1)
. present = ir.reserve-block()
. ended = ir.reserve-block()
branch-present(run, id, cursor, present, ended)
ir.start-block(ended)
record-extent(run, id, next)
jump(missed)
ir.start-block(present)
. item = char-at(run, id, cursor)
record-extent(run, id, next)
. passed = ir.reserve-block()
branch(case-test(id, item, index), passed, missed)
ir.start-block(passed)
. given = if whole then item else take(item, field, id)
= StreamPart(char-next(run, id, cursor), Typed(given, type))

────────────────────
_ do stream-type-part StreamPart
    - run StreamRun
    - id SyntaxId
    - written SyntaxId
    - cursor Operand
    - failed IRBlockId

` A type named as a part of a pattern: a call of the rule the type pass recorded at it, which is
` the type's constructor that takes the stream or the rule that reads a number of the type, or
` of a function that reads the number and is no rule, as `boundary-call` says; or else a test
` of one item for the type, which gives the item: an item of a class the type derives from, or
` of a union that has the type as a case, is read as the items are, tested as the type named as
` a pattern tests a value, and given as the type. An item that is
` a number of another type is never of it, and fails once it is there. Before the test the
` stream is told the pattern stands at the item, as the reference tells it before it looks for
` such a function. The test reads as far as the item, there or not. Where the buffer is UTF-8
` the item is the character there, decoded, and the test passes past its bytes.
. type = facts.node-type(unit.reading, id)
if type == no-type || type == invalid-type
    refuse(.refused-type, id)
    = bare-part(cursor)
. first = facts.first-call(unit.reading, id)
. commits = first != no-fact && facts.calls[first].form == .call-method
if first != no-fact && !commits
    if next-call(first) != no-fact
        = boundary-call(run, id, type, cursor, failed)
    = rule-call(run, id, type, cursor, failed)
. item-type = if encodes(run) then types.type-row(.char) else class-arg(types, run.buffer-type, 0)
. never = item-type != type && intrinsic-is-numeric(types.intrinsic-of(item-type))
if !commits || calls-next || (!never && layout-of(item-type, id) != read-layout(run, id))
    refuse(.refused-type, id)
    = bare-part(cursor)
.. calls-next = next-call(first) != no-fact
call-protocol
    - id
    - first
    - run.stream
    - run.stream-type
    - cursor
    - types.index-type
    - true
    - cursor
    - types.index-type
. missed = failure-of(run, id, cursor, failed)
. next = stream-advance(run, id, cursor, 1)
. present = ir.reserve-block()
. ended = ir.reserve-block()
branch-present(run, id, cursor, present, ended)
ir.start-block(ended)
record-extent(run, id, next)
jump(missed)
ir.start-block(present)
if never
    record-extent(run, id, next)
    jump(missed)
    ir.start-block(ir.reserve-block())
    . layout = layout-of(type, id)
    . held = ir.add-local(layout)
    clear-local(held, layout, id)
    = StreamPart(next, Typed(load-local(held, id), type))
. item = char-at(run, id, cursor)
record-extent(run, id, next)
if item-type != type
    . typeed = match-type(written, Typed(item, item-type), missed)
    item = typeed.operand
    if typeed.type != type
        refuse(.refused-type, id)
        = bare-part(cursor)
= StreamPart(char-next(run, id, cursor), Typed(item, type))

────────────────────
_ do stream-predicate StreamPart
    - run StreamRun
    - id SyntaxId
    - predicate SyntaxId
    - cursor Operand
    - failed IRBlockId

` One item a pattern tests, which gives the item where the test passes: the test's expression
` sees the item as `it`, and is tested as a condition. The pattern reads as far as the item,
` there or not. Where the buffer is UTF-8 the item is the character there, decoded, and the
` test passes past its bytes.
. missed = failure-of(run, id, cursor, failed)
. next = stream-advance(run, id, cursor, 1)
. present = ir.reserve-block()
. ended = ir.reserve-block()
branch-present(run, id, cursor, present, ended)
ir.start-block(ended)
record-extent(run, id, next)
jump(missed)
ir.start-block(present)
. item = char-at(run, id, cursor)
record-extent(run, id, next)
. type = facts.node-type(unit.reading, id)
if type == no-type || layout-of(type, id) != read-layout(run, id)
    refuse(.refused-type, id)
    = bare-part(cursor)
. named = bound.length
. slot = arm-slot-of(id, .slot-it)
if slot != no-slot
    bound += BoundValue(slot, type, item)
. tested = emit-expression(predicate)
. holds = test(predicate, tested).operand
drop-bound(named)
. passed = ir.reserve-block()
branch(holds, passed, missed)
ir.start-block(passed)
= StreamPart(char-next(run, id, cursor), Typed(item, type))

────────────────────
_ do stream-choice StreamPart
    - run StreamRun
    - id SyntaxId
    - cursor Operand
    - failed IRBlockId

` Alternatives tried from a cursor as the reference tries them: the first that passes is
` kept, and where all fail the choice does. A choice gives no value, but one the type pass
` planned to give what its alternatives give, which gives what the one that passed gave.
. nothing = make-operand(.operand-void, 0)
. arms [SyntaxId]
choice-arms(tree, id, arms)
. type = if gives-value(id) then facts.node-type(unit.reading, id) else no-type
if type == invalid-type
    refuse(.refused-expression, id)
    = bare-part(cursor)
. kept = if type != no-type then ir.add-local(layout-of(type, id)) else no-local
. joined = ir.reserve-block()
. mark = joins.length
try-alternatives
    - run
    - id
    - arms
    - cursor
    - failed
    - ArmWay(id, type, false, kept, joined, nothing, true, false)
. ending = close-joins(joined, mark, run.index-layout, nothing)
if kept != no-local
    = StreamPart(ending, Typed(load-local(kept, id), type))
= bare-part(ending)

────────────────────
_ do try-alternatives Bool
    - run StreamRun
    - id SyntaxId
    - arms [SyntaxId]
    - cursor Operand
    - failed IRBlockId
    - way ArmWay

` The alternatives of a choice, tried from a cursor as the reference tries them. Alternatives
` that are each one item it tests as one, each in turn. Otherwise, where every one must read
` an item and it knows which each may start with, it sorts them into groups by those items
` and, where there is more than one, tries only the group the item at the cursor starts;
` where no group does, or no item lies there, the choice fails. Else each is tried in turn,
` but one that must read an item and starts with items it knows is skipped where none of those
` lies at the cursor. Whether any reaches the join. The lists names accumulate in the
` alternatives are cut back before each alternative tried after the first, and where all fail.
` Each alternative begins holding no rollback mark, and gives back the one it holds where it
` fails; the choice holds the one it held before where it held one, and else the one the
` alternative that passed holds.
. marks = mark-levels(id)
. entered = enter-marks(id)
. lost = if entered == no-local then failed else ir.reserve-block()
. arrives = false
if is-scanned(tree, id)
    . own-streaming = streaming
    streaming = streaming.classing = true
    arrives = try-guarded(run, id, arms, U32.max, cursor, lost, way, marks, entered)
    streaming = own-streaming
else
    . start = plan-start(id)
    if start == U32.max
        refuse(.refused-expression, id)
        = false
    . groups = dispatch-groups(start, arms.length as U32)
    if groups.length > 1
        arrives = try-dispatched(run, id, arms, start, groups, cursor, lost, way, marks, entered)
    else
        arrives = try-guarded(run, id, arms, start, cursor, lost, way, marks, entered)
if entered != no-local
    ir.start-block(lost)
    store-local(streaming.rollback-mark, load-local(entered, id), id)
    jump(failed)
= arrives

────────────────────
_ do try-alternative Bool
    - run StreamRun
    - way ArmWay
    - arm SyntaxId
    - cursor Operand
    - failed IRBlockId
    - entered LocalId

` One alternative of a choice, tried from a cursor, which goes on to `failed` where it fails.
` Where it passes, the choice holds the rollback mark it held before the alternative where it
` held one, and where the choice gives a value the alternative leaves its own. Whether it
` reaches the join.
if !way.parts
    = emit-stream-arm
        - run
        - arm
        - way.result
        - cursor
        - way.whole
        - way.end
        - way.joined
        - way.slot
        - failed
        - entered
        - way.unread
. passed = emit-stream-part(run, arm, cursor, failed)
if way.end != no-local
    if passed.value.type != way.result
        refuse(.refused-expression, arm)
        = false
    store-local(way.end, passed.value.operand, arm)
pass-marks(entered, arm)
arrive(way.site, passed.ending, way.joined, make-operand(.operand-void, 0))
= true

────────────────────
_ do try-guarded Bool
    - run StreamRun
    - id SyntaxId
    - arms [SyntaxId]
    - start U32
    - cursor Operand
    - failed IRBlockId
    - way ArmWay
    - marks [LevelMark]
    - entered LocalId

` Alternatives tried in turn from a cursor, those the reference guards skipped where no item
` lies at the cursor or the one there is not one they may start with. What the alternatives
` may start with is kept from `start`, or not at all with `U32.max`. Whether any reaches the
` join.
. guarded = false
if start != U32.max
    for position in 0 .. < arms.length
        guarded = guarded || guards(plan-firsts[start + (position as U32)])
. present = make-operand(.operand-void, 0)
if guarded && run.kept-length == no-local
    present = compare(id, .compare-less, cursor, run.length)
. arrives = false
for position in 0 .. < arms.length
    . last = position + 1 == arms.length
    . next = if last && marks.length == 0 && entered == no-local then failed else ir.reserve-block()
    if guarded && guards(plan-firsts[start + (position as U32)])
        . looked = ir.reserve-block()
        . skipped = ir.reserve-block()
        . tried = ir.reserve-block()
        if run.kept-length == no-local
            branch(present, looked, skipped)
        else
            branch-present(run, id, cursor, looked, skipped)
        ir.start-block(looked)
        . ranges = plan-firsts[start + (position as U32)].ranges
        . decodes = wide-ranges(run, ranges)
        branch-ranges(run, id, item-at(run, id, cursor, decodes), ranges, tried, skipped, decodes)
        ir.start-block(skipped)
        skip-extent(run, id, start, position as U32, (position as U32) + 1, cursor)
        jump(next)
        ir.start-block(tried)
    arrives = try-alternative(run, way, arms[position], cursor, next, entered) || arrives
    if !last || marks.length != 0 || entered != no-local
        ir.start-block(next)
        rewind-levels(marks, id)
        next-arm(entered, id)
    if last && (marks.length != 0 || entered != no-local)
        jump(failed)
= arrives

────────────────────
_ do try-dispatched Bool
    - run StreamRun
    - id SyntaxId
    - arms [SyntaxId]
    - start U32
    - groups [ArmGroup]
    - cursor Operand
    - failed IRBlockId
    - way ArmWay
    - marks [LevelMark]
    - entered LocalId

` Alternatives sorted into groups by the items they may start with, of which only the group
` the item at the cursor starts is tried, its alternatives in turn: those before each one tried
` and after the last count as skipped. Where no group is started, or no item lies at the
` cursor, all count as skipped and the choice fails. Whether any reaches the join. Where the
` buffer is UTF-8, the item is the byte a character starts with, or the character, decoded,
` where a group's ranges need it (`wide-ranges`).
. count = arms.length as U32
. present = ir.reserve-block()
. ended = ir.reserve-block()
branch-present(run, id, cursor, present, ended)
ir.start-block(ended)
skip-extent(run, id, start, 0, count, cursor)
jump(failed)
ir.start-block(present)
. decodes = false
for group in groups
    decodes = decodes || wide-ranges(run, group.ranges)
. item = item-at(run, id, cursor, decodes)
. arrives = false
for group in groups
    . chosen = ir.reserve-block()
    . other = ir.reserve-block()
    branch-ranges(run, id, item, group.ranges, chosen, other, decodes)
    ir.start-block(chosen)
    . unskipped U32
    for index in group.arms
        skip-extent(run, id, start, unskipped, index, cursor)
        . next = ir.reserve-block()
        arrives = try-alternative(run, way, arms[index], cursor, next, entered) || arrives
        ir.start-block(next)
        rewind-levels(marks, id)
        next-arm(entered, id)
        unskipped = index + 1
    skip-extent(run, id, start, unskipped, count, cursor)
    jump(failed)
    ir.start-block(other)
skip-extent(run, id, start, 0, count, cursor)
jump(failed)
= arrives

────────────────────
_ do item-at Operand
    - run StreamRun
    - id SyntaxId
    - cursor Operand
    - decodes Bool = false

` The item at a cursor the pattern knows is inside the input, to test against ranges; nothing
` for items that are no numbers, which are not read. Where the buffer is UTF-8 it is the byte
` the character there starts with, or where it `decodes`, the character, decoded.
if !is-integer(run.item-layout)
    = make-operand(.operand-void, 0)
= if decodes then char-at(run, id, cursor) else stream-item(run, id, cursor)

────────────────────
_ do branch-ranges
    - run StreamRun
    - id SyntaxId
    - item Operand
    - ranges [ItemRange]
    - inside IRBlockId
    - outside IRBlockId
    - decodes Bool = false

` Goes on to `inside` where an item lies in one of some ranges, tested in turn, and else to
` `outside`. An item that is no number lies in a range only where the range holds every item,
` as the reference tests it; any other range has no shape for it. Where the buffer is UTF-8 and
` the item is the byte a character starts with, not the character it `decodes`, a range that
` holds every character past ASCII holds every such byte past it.
if !is-integer(run.item-layout)
    if ranges.length == 1 && ranges[0].first == 0 && ranges[0].last == any-item
        jump(inside)
        =
    refuse(.refused-type, id)
    =
if ranges.length == 0
    jump(outside)
    =
. kind = tables.layouts.rows[if decodes then read-layout(run, id) else run.item-layout].kind
. bytes = encodes(run) && !decodes
for position in 0 .. < ranges.length
    . range = ranges[position]
    . upper = if bytes && range.last >= 0x80 then 0xFF as U64 else range.last
    . last = position + 1 == ranges.length
    . next = if last then outside else ir.reserve-block()
    if range.first == upper
        branch(compare(id, .compare-equal, item, integer(kind, range.first)), inside, next)
    else
        . above = ir.reserve-block()
        branch(compare(id, .compare-greater-equal, item, integer(kind, range.first)), above, next)
        ir.start-block(above)
        branch(compare(id, .compare-less-equal, item, integer(kind, upper)), inside, next)
    if !last
        ir.start-block(next)

────────────────────
_ do skip-extent
    - run StreamRun
    - id SyntaxId
    - start U32
    - from U32
    - to U32
    - cursor Operand

` Counts the alternatives of a choice from `from` up to `to` as skipped, as the reference
` does: as read from the cursor at least one item on, and as far as the farthest of them
` probes where that lies inside the input, or else to its end. Where the buffer is UTF-8 the
` probe counts characters, as `advance-chars` reads them.
if from >= to
    =
. probe U64 = 1
for position in from .. < to
    . own = plan-firsts[start + position].probe
    if own != no-probe && own > probe
        probe = own
record-extent(run, id, stream-advance(run, id, cursor, 1))
if probe == 1
    =
if encodes(run)
    record-extent(run, id, advance-chars(run, id, cursor, probe))
    =
. end = stream-advance(run, id, cursor, probe)
. short = ir.reserve-block()
. beyond = ir.reserve-block()
. done = ir.reserve-block()
. length = run-length(run, id)
branch(compare(id, .compare-less-equal, end, length), short, beyond)
ir.start-block(short)
record-extent(run, id, end)
jump(done)
ir.start-block(beyond)
record-extent(run, id, length)
jump(done)
ir.start-block(done)

────────────────────
_ do dispatch-groups [ArmGroup]
    - start U32
    - count U32

` The groups the reference sorts the alternatives of a choice into by the items they may start
` with, where every one must read an item and it knows which: two that may start with the same
` item share a group, and the groups are in the order of their first alternatives. None where
` it sorts them into fewer than two.
. groups [ArmGroup]
for position in 0 .. < count
    . first = plan-firsts[start + position]
    if !first.known || first.nullable
        = groups
. parents [U32]
for position in 0 .. < count
    parents += position
for left in 0 .. < count
    for right in left + 1 .. < count
        if ranges-meet(plan-firsts[start + left].ranges, plan-firsts[start + right].ranges)
            . root = group-root(parents, left)
            . other = group-root(parents, right)
            if root != other
                parents[other] = root
. placed [U32]
for position in 0 .. < count
    placed += U32.max
for position in 0 .. < count
    . root = group-root(parents, position)
    if placed[root] == U32.max
        placed[root] = groups.length as U32
        . members [U32]
        . none [ItemRange]
        groups += ArmGroup(members, none)
    . place = placed[root]
    . members = groups[place].arms
    members += position
    groups[place] = ArmGroup
        - members
        - merged-ranges(groups[place].ranges, plan-firsts[start + position].ranges)
if groups.length < 2
    . none [ArmGroup]
    = none
= groups

────────────────────
+ do plan-choices
    - root SyntaxId

` Judges, as the reference does before it emits a pattern, which items each part of the
` pattern rooted at `root` may start with, reading the patterns of the rules it calls as far as
` they reach, and keeps for each choice of the pattern what each of its alternatives may start
` with.
if found-firsts.length != 0
    found-firsts.clear()
first-items(unit.source-module, unit.reading, root, true)

────────────────────
_ plan-start U32
    - id SyntaxId

` Where what the alternatives of a choice may start with is kept, or `U32.max` where it is not.
choice-plans[plan-key(unit.source-module, id)] ?? U32.max

────────────────────
_ do first-items FirstItems
    - module ModuleId
    - owner InstanceId
    - id SyntaxId
    - planning Bool

` What the reference knows of the items a part of a grammar may start with, as it
` lowers the part and judges it. Text starts with its first character and probes its length;
` a range, any item, or a repeat that scans for one, starts with what it matches and probes
` one item. A sequence starts as its parts do up to the first that must read an item, and
` probes as that one does. Alternatives start as any of theirs does and probe the farthest,
` where each probe is known. A repeat or an optional part starts and probes as its part does,
` and may read none where it may pass none; a lookahead may read none, starts with what is not
` known, and probes as its part does. A call starts and probes as the pattern of the rule it
` calls does. A test of an item, of its type, or of a value matched, starts with what is not
` known and probes what is not known. With `planning`, keeps what the alternatives of each
` choice met may start with.
. syntax = program.modules[module].tree
. none = no-ranges
do match? syntax.nodes[id]
    | .node-stream-string(row)
        . count = row.text.length
        if count == 0
            = FirstItems(true, true, none, 0)
        . point = row.text[0] as U64
        = FirstItems(true, false, single-range(point, point), count as U64)
    | .node-stream-any
        = FirstItems(true, false, single-range(0, any-item), 1)
    | .node-stream-char-range(row)
        = FirstItems
            - true
            - false
            - single-range(syntax.stream-bound(row.first), syntax.stream-bound(row.last))
            - 1
    | .node-stream-transform(row)
        if row.pattern == 0
            = FirstItems(true, true, none, 0)
        = first-items(module, owner, row.pattern, planning)
    | .node-stream-panic(row)
        = first-items(module, owner, row.pattern, planning)
    | .node-stream-capture(row)
        = first-items(module, owner, row.pattern, planning)
    | .node-stream-and(row)
        . left = first-items(module, owner, row.left, planning)
        . right = first-items(module, owner, row.right, planning)
        if !left.nullable
            = left
        = FirstItems
            - left.known && right.known
            - right.nullable
            - merged-ranges(left.ranges, right.ranges)
            - right.probe
    | .node-stream-or
        = first-choice(module, owner, id, planning)
    | .node-stream-unary(row)
        . optional = row.op != .one-or-more-op
        if repeats && is-scanned(syntax, row.operand)
            = FirstItems(true, optional, scanned-ranges(syntax, row.operand), 1)
        .. repeats = row.op == .zero-or-more-op || row.op == .one-or-more-op
        . inner = first-items(module, owner, row.operand, planning)
        if row.op == .positive-lookahead-op || row.op == .negative-lookahead-op
            = FirstItems(false, true, none, inner.probe)
        = FirstItems(inner.known, optional, inner.ranges, inner.probe)
    | .node-stream-length(row)
        . inner = first-items(module, owner, row.operand, planning)
        . least = if syntax.literal-bound(row.min) then syntax.stream-bound(row.min) else 0
        = FirstItems(inner.known, least == 0, inner.ranges, inner.probe)
    | .node-stream-call
        = call-first-items(module, owner, id)
= FirstItems(false, false, none, no-probe)

────────────────────
_ do first-choice FirstItems
    - module ModuleId
    - owner InstanceId
    - id SyntaxId
    - planning Bool

` What the reference knows of the items a choice may start with, from what each of its
` alternatives may; with `planning`, keeps that of each. The alternatives, what each starts
` with, and the ranges they start with joined so far are kept on stacks that the choices among
` them grow and give back as they are judged.
. arms = choice-arm-stack.length
choice-arms(program.modules[module].tree, id, choice-arm-stack)
. end = choice-arm-stack.length
. firsts = choice-first-stack.length
. joined = choice-range-stack.length
. known = true
. nullable = false
. probe U64
for position in arms .. < end
    . found = first-items(module, owner, choice-arm-stack[position], planning)
    if planning
        choice-first-stack += found
    known = known && found.known
    nullable = nullable || found.nullable
    join-ranges(joined, found.ranges)
    if probe == no-probe || found.probe == no-probe
        probe = no-probe
    else if found.probe > probe
        probe = found.probe
if planning
    choice-plans[plan-key(module, id)] = plan-firsts.length as U32
    for position in firsts .. < choice-first-stack.length
        plan-firsts += choice-first-stack[position]
    choice-first-stack.remove(firsts, choice-first-stack.length - firsts)
choice-arm-stack.remove(arms, end - arms)
. ranges = no-ranges
if choice-range-stack.length > joined
    . taken [ItemRange]
    for position in joined .. < choice-range-stack.length
        taken += choice-range-stack[position]
    choice-range-stack.remove(joined, choice-range-stack.length - joined)
    ranges = taken
= FirstItems(known, nullable, ranges, probe)

────────────────────
_ do join-ranges
    - base Size
    - ranges [ItemRange]

` Joins ranges, in order and apart, into those a choice has joined so far on the range stack
` from `base`, as `merged-ranges` does: they stay in order and apart.
=? if ranges.length == 0
. top = choice-range-stack.length
. at-left = base
. at-right Size = 0
while at-left < top || at-right < ranges.length
    . from-left = at-right >= ranges.length || (at-left < top && left-before)
        .. left-before = !range-after(choice-range-stack[at-left], ranges[at-right])
    . range = if from-left then choice-range-stack[at-left] else ranges[at-right]
    if from-left
        at-left += 1
    else
        at-right += 1
    if choice-range-stack.length != top
        . last = choice-range-stack.length - 1
        if range.first <= choice-range-stack[last].last + 1
            if range.last > choice-range-stack[last].last
                choice-range-stack[last] = ItemRange(choice-range-stack[last].first, range.last)
            continue
    choice-range-stack += range
. count = choice-range-stack.length - top
for offset in 0 .. < count
    choice-range-stack[base + offset] = choice-range-stack[top + offset]
choice-range-stack.remove(base + count, top - base)

────────────────────
_ do scanned-ranges [ItemRange]
    - syntax AST
    - id SyntaxId

` The ranges of the items a part the reference scans for may match, in order and apart.
. none = no-ranges
do match? syntax.nodes[id]
    | .node-stream-string(row)
        . point = row.text[0] as U64
        = single-range(point, point)
    | .node-stream-any
        = single-range(0, any-item)
    | .node-stream-char-range(row)
        = single-range(syntax.stream-bound(row.first), syntax.stream-bound(row.last))
    | .node-stream-or(row)
        = merged-ranges(scanned-ranges(syntax, row.left), scanned-ranges(syntax, row.right))
    | .node-stream-transform(row)
        = scanned-ranges(syntax, row.pattern)
= none

────────────────────
_ do choice-arms
    - syntax AST
    - id SyntaxId
    - arms [SyntaxId]

` The alternatives of a choice, in the order written, those of a choice among them included.
do match? syntax.nodes[id]
    | .node-stream-or(row)
        choice-arms(syntax, row.left, arms)
        choice-arms(syntax, row.right, arms)
        =
arms += id

────────────────────
_ do call-first-items FirstItems
    - module ModuleId
    - owner InstanceId
    - id SyntaxId

` What the reference knows of the items a call of a rule may start with: what the pattern of
` the rule does, judged once for each call met from where the pattern is emitted. A call met
` again while its rule is being judged starts with what is not known, as one whose rule is not
` found does, and cuts the judging of the calls around it. A rule judged with no cut is judged
` once for all patterns, as the reference shares it.
. key = plan-key(module, id)
. kept = first-calls[key] ?? U32.max
if (kept as Size) < found-firsts.length && found-firsts[kept].key == key
    if found-firsts[kept].contextual
        first-cuts += 1
    = found-firsts[kept].items
. none = no-ranges
if first-resolving.find(key) != null
    first-cuts += 1
    = FirstItems(false, false, none, no-probe)
. found = FirstItems(false, false, none, no-probe)
. contextual = false
. target = rule-target(module, owner, id)
if target.pattern != 0
    . shared = shared-first(target)
    if shared
        found = shared
    else
        . prior-cuts = first-cuts
        first-resolving += key
        found = first-items(target.module, target.owner, target.pattern, false)
        first-resolving.pop()
        contextual = first-cuts != prior-cuts
        if !contextual
            share-first(target, found)
first-calls[key] = found-firsts.length as U32
found-firsts += FoundFirst(found, key, contextual)
= found

────────────────────
_ do shared-first FirstItems?
    - target RuleTarget

` What the pattern of a rule was judged to start with for the instance that reads it, where it
` was judged with no cut.
. place = shared-first-heads[plan-key(target.module, target.pattern)] ?? U32.max
while place != U32.max
    . shared = shared-firsts[place]
    if shared.owner == target.owner
        = shared.found
    place = shared.next
= null

────────────────────
_ do share-first
    - target RuleTarget
    - found FirstItems

` Keeps what the pattern of a rule starts with for the instance that reads it, for every
` pattern emitted after.
. key = plan-key(target.module, target.pattern)
shared-firsts += SharedFirst(target.owner, found, shared-first-heads[key] ?? U32.max)
shared-first-heads[key] = (shared-firsts.length - 1) as U32

────────────────────
_ do rule-target RuleTarget
    - module ModuleId
    - owner InstanceId
    - id SyntaxId

` The pattern of the rule a call names, as the reference finds it, with the module that
` declares it and the instance that reads it: a local rule's, as the binder resolved the call,
` or that of a rule a module declares, as the type pass resolved it. No pattern where neither
` is found.
. syntax = program.modules[module].tree
if owner == no-instance
    = RuleTarget(module, owner, 0)
. binding = instances.rows[owner].binding
if binding != no-binding
    . resolution = bindings.resolution-of(binding, id)
    if resolution.kind == .resolve-slot
        . row = bindings.slots[resolution.slot]
        if row.kind == .slot-lazy
            do match? syntax.nodes[row.group]
                | .node-declare(declaration)
                    do match? syntax.nodes[declaration.right]
                        | .node-stream-match(rule)
                            = RuleTarget(module, owner, rule.pattern)
. fact = call-in(owner, id)
if fact != no-fact
    . callee = facts.calls[fact].callee
    if callee != no-instance
        . home = instances.rows[callee].module
        . matched = rule-match(program, home, instances.rows[callee].decl)
        if matched != 0
            do match? program.modules[home].tree.nodes[matched]
                | .node-stream-match(rule)
                    = RuleTarget(home, callee, rule.pattern)
= RuleTarget(module, owner, 0)

────────────────────
_ do stream-repeat StreamPart
    - run StreamRun
    - id SyntaxId
    - operand SyntaxId
    - least U64
    - most U64
    - cursor Operand
    - failed IRBlockId
    - scans Bool
    - least-at SyntaxId = 0
    - most-at SyntaxId = 0

` A part taken as often as it passes from a cursor, at most `most` times, which has no bound
` at `U64.max`. Unbounded, it stops where the part passed without moving on, which one that
` `advances` never does: it stops only where a try of it fails, which reads farther and fails
` farther than any try before it, so that the part is its `deferred-part`. It passes where
` it took the part at least `least` times, with the cursor where the last one ended. A bound
` computed as the match runs is read as a Size: `most-at` before the part is first taken,
` and `least-at` after it is taken for the last time, as the reference reads them. Each name
` the part captures has a list, empty as the repeat starts, which each pass that passes adds
` what it captured to. A repeat the type pass planned to give the values of its part keeps
` them in a list the same way, which it gives where it passes. One the reference `scans` tests
` each item, and keeps no cursor its part failed at. The lists names accumulate in the part
` are cut back where a pass fails to what they held as it began, and where the repeat fails
` to what they held as it began. Each pass begins holding no rollback mark, and gives back the
` one it holds where it fails; the repeat keeps the earliest its passes that passed held, which
` it gives back where it fails, and holds where it passes where it held none before.
. entered = mark-levels(operand)
. saved = enter-marks(id)
. gathered = no-local
if saved != no-local
    gathered = ir.add-local(ir.locals[streaming.rollback-mark].layout)
    store-local(gathered, no-mark(id).operand, id)
. spot = ir.add-local(run.index-layout)
. counts = most != U64.max || most-at != 0 || least != 0 || least-at != 0
. taken = if counts then ir.add-local(u64-layout) else no-local
store-local(spot, cursor, id)
if counts
    store-local(taken, integer(.machine-u64, 0), id)
. values = value-level(id)
if values
    start-level(values, id)
. listing [U32]
. depths [U32]
repeat-levels(operand, 1, listing, depths)
for position in listing
    start-level(capture-levels[position], id)
. limit = no-local
if most-at != 0
    . most-value = count-of(most-at)
    limit = ir.add-local(u64-layout)
    store-local(limit, most-value.operand, id)
. test = ir.reserve-block()
. body = ir.reserve-block()
. done = ir.reserve-block()
jump(test)
ir.start-block(test)
if limit != no-local
    branch(compare(id, .compare-less, load-local(taken, id), load-local(limit, id)), body, done)
else if most == U64.max
    jump(body)
else
    branch
        - compare(id, .compare-less, load-local(taken, id), integer(.machine-u64, most))
        - body
        - done
ir.start-block(body)
clear-mark(id)
. begun = load-local(spot, id)
. passing = mark-levels(operand)
. missed = if passing.length == 0 && saved == no-local then done else ir.reserve-block()
. onward = most == U64.max && most-at == 0 && advances(operand)
scanning = scans
deferred-part = if onward then plan-key(unit.source-module, lowered-part(operand)) else U64.max
. took = emit-stream-part(run, operand, begun, missed)
. next = took.ending
deferred-part = U64.max
scanning = false
gather-mark(gathered, id)
if values
    if took.value.type == no-type
        refuse(.refused-expression, id)
        = bare-part(cursor)
    append-level(values, took.value, id)
for index in 0 .. < listing.length
    . position = listing[index]
    . capture = stream-captures[capture-levels[position].capture]
    . element = if depths[index] > 1 then level-list(capture-levels[position - 1], id) else captured-element(capture, position, id)
    append-level(capture-levels[position], element, capture.site)
store-local(spot, next, id)
if counts
    store-local
        - taken
        - arithmetic
            - id
            - .arithmetic-add
            - load-local(taken, id)
            - integer(.machine-u64, 1)
            - u64-layout
        - id
if most == U64.max && !onward
    branch(compare(id, .compare-greater, next, begun), test, done)
else
    jump(test)
if passing.length != 0 || saved != no-local
    ir.start-block(missed)
    rewind-levels(passing, id)
    rewind-mark(id)
    jump(done)
ir.start-block(done)
. finish = load-local(spot, id)
. short = failed
if entered.length != 0 || saved != no-local
    short = ir.reserve-block()
. given = Typed(make-operand(.operand-void, 0), no-type)
if values
    given = Typed(level-list(values, id).operand, values.list)
if least-at != 0
    . least-value = count-of(least-at)
    . counted = ir.reserve-block()
    branch(compare(id, .compare-greater-equal, load-local(taken, id), least-value.operand), counted, short)
    cut-repeat(entered, saved, gathered, short, failed, id)
    ir.start-block(counted)
    settle-repeat(saved, gathered, id)
    = StreamPart(finish, given)
if least == 0
    settle-repeat(saved, gathered, id)
    = StreamPart(finish, given)
. enough = ir.reserve-block()
branch
    - compare(id, .compare-greater-equal, load-local(taken, id), integer(.machine-u64, least))
    - enough
    - short
cut-repeat(entered, saved, gathered, short, failed, id)
ir.start-block(enough)
settle-repeat(saved, gathered, id)
= StreamPart(finish, given)

────────────────────
_ do advances Bool
    - id SyntaxId

` Whether a part of a pattern moves on by at least one item wherever it passes: text that
` holds some, a range or any item, a sequence with such a part, a choice whose alternatives
` all are, and one or more of such a part, or a count of one at least.
do match? tree.nodes[id]
    | .node-stream-string(row)
        = row.text.length != 0
    | .node-stream-any
        = true
    | .node-stream-char-range
        = true
    | .node-stream-and(row)
        = advances(row.left) || advances(row.right)
    | .node-stream-or(row)
        = advances(row.left) && advances(row.right)
    | .node-stream-capture(row)
        = advances(row.pattern)
    | .node-stream-transform(row)
        = row.pattern != 0 && tree.lazies-only(row.right) && advances(row.pattern)
    | .node-stream-unary(row)
        = row.op == .one-or-more-op && advances(row.operand)
    | .node-stream-length(row)
        = tree.literal-bound(row.min) && tree.stream-bound(row.min) != 0 && advances(row.operand)
= false

────────────────────
_ do cut-repeat
    - marks [LevelMark]
    - saved LocalId
    - gathered LocalId
    - block IRBlockId
    - failed IRBlockId
    - site SyntaxId

` Emits the block a repeat that passed too few times goes to, where any lists were marked or
` the pattern holds rollback marks: it cuts the lists back to what they held where the repeat
` began, gives back the rollback mark its passes held, and holds the one it held before; then
` it goes on to `failed`.
if marks.length == 0 && saved == no-local
    =
ir.start-block(block)
rewind-levels(marks, site)
if saved != no-local
    store-local(streaming.rollback-mark, load-local(gathered, site), site)
    fail-marks(saved, site)
jump(failed)

────────────────────
_ do captured-element Typed
    - capture StreamCapture
    - position U32
    - id SyntaxId

` What a name a pass of a repeat captured, which the repeat adds to its list: the item a test
` passed, as it was kept, the text between the cursors its part began and ended at, or, for a
` name a helper makes, the range of those cursors.
if capture.value != no-local
    = Typed(load-local(capture.value, id), capture-levels[position].item)
if material-at(capture.site, .material-ranges) != U32.max
    . item = capture-levels[position].item
    . layout = layout-of(item, id)
    . range = frame(layout)
    put(range, tables.layouts.field(layout, 0), load-local(capture.begin, id), id)
    put(range, tables.layouts.field(layout, 1), load-local(capture.end, id), id)
    = Typed(range, item)
= stream-text(capture.run, capture.site, load-local(capture.begin, id), load-local(capture.end, id))

────────────────────
_ do value-level CaptureLevel?
    - id SyntaxId

` The list a repeat keeps of what its part gives on each pass, where the type pass planned
` the repeat to give them: its collector, by the call recorded at the repeat that grows it.
if facts.plan-of(unit.reading, id) != .plan-stream-value
    = null
. list = facts.node-type(unit.reading, id)
. fact = facts.first-call(unit.reading, id)
. callee = if fact != no-fact then facts.calls[fact].callee else no-instance
if callee == no-instance
    refuse(.refused-expression, id)
    = null
. collector = instances.rows[callee].self-type
. items = ir.add-local(layout-of(instances.signatures[callee].returns, id))
. size = ir.add-local(u64-layout)
. context = context-local(collector, id)
= CaptureLevel(U32.max, items, size, fact, collector, class-arg(types, collector, 0), list, context)

────────────────────
_ do repeat-levels
    - id SyntaxId
    - depth U32
    - listing [U32]
    - depths [U32]

` The lists a repeat keeps for the names its part captures, with how many repeats deep in
` it each name lies, counting the repeat itself.
do match? tree.nodes[id]
    | .node-stream-capture(row)
        . held = captured-at(captured-slot(row.name))
        if held != U32.max && !stream-captures[held].accumulates && deep-enough
            . position = stream-captures[held].levels + depth - 1
            if listing.find(position) == null
                listing += position
                depths += depth
        .. deep-enough = stream-captures[held].listed >= depth
        repeat-levels(row.pattern, depth, listing, depths)
    | .node-stream-and(row)
        repeat-levels(row.left, depth, listing, depths)
        repeat-levels(row.right, depth, listing, depths)
    | .node-stream-or(row)
        repeat-levels(row.left, depth, listing, depths)
        repeat-levels(row.right, depth, listing, depths)
    | .node-stream-transform(row)
        repeat-levels(row.pattern, depth, listing, depths)
    | .node-stream-panic(row)
        repeat-levels(row.pattern, depth, listing, depths)
    | .node-stream-unary(row)
        . repeat = row.op == .zero-or-more-op || row.op == .one-or-more-op
        repeat-levels(row.operand, if repeat then depth + 1 else depth, listing, depths)
    | .node-stream-length(row)
        repeat-levels(row.operand, depth + 1, listing, depths)

────────────────────
_ do level-list Typed
    - level CaptureLevel
    - site SyntaxId

` The list a repeat made of what a name captured, or of what its part gave, on each of its
` passes: an `ImmutableArray` over the collector's items, as many as it holds.
. layout = layout-of(level.list, site)
. items-layout = ir.locals[level.items].layout
. list = frame(layout)
put
    - list
    - tables.layouts.field(layout, 0)
    - take(load-local(level.items, site), tables.layouts.field(items-layout, 0), site)
    - site
put(list, tables.layouts.field(layout, 1), load-local(level.size, site), site)
= Typed(list, level.list)

────────────────────
_ do append-level
    - level CaptureLevel
    - element Typed
    - site SyntaxId

` Adds an item to a list, as the reference's collector adds one: where its items
` are full, they grow, in the arena of the context of a collector backed by one as the
` reference grows an arena's builder, and else by the call the type pass recorded; the item is
` stored after the last, through the write barrier where it is managed, and the size counts it.
if element.type != level.item
    refuse(.refused-expression, site)
    =
. item-layout = layout-of(level.item, site)
. collector-layout = layout-of(level.collector, site)
. items-layout = ir.locals[level.items].layout
. count-field = tables.layouts.field(items-layout, 1)
. size = load-local(level.size, site)
if class-arg(types, level.collector, 1) == types.arena-backing-type
    grow-in-arena(level, item-layout, size, site)
    put-item(level, size, element.operand, item-layout, site)
    store-local
        - level.size
        - arithmetic(site, .arithmetic-add, size, integer(.machine-u64, 1), u64-layout)
        - site
    =
. capacity = num-cast
    - site
    - take(load-local(level.items, site), count-field, site)
    - count-field.layout
    - u64-layout
. growing = ir.reserve-block()
. joined = ir.reserve-block()
branch(compare(site, .compare-equal, size, capacity), growing, joined)
ir.start-block(growing)
. collector = frame(collector-layout)
put(collector, tables.layouts.field(collector-layout, 0), load-local(level.items, site), site)
put(collector, tables.layouts.field(collector-layout, 1), size, site)
if level.context != no-local
    put(collector, tables.layouts.field(collector-layout, 2), load-local(level.context, site), site)
. grown = call-protocol
    - site
    - level.grow
    - collector
    - level.collector
    - make-operand(.operand-void, 0)
store-local(level.items, grown.operand, site)
jump(joined)
ir.start-block(joined)
put-item(level, size, element.operand, item-layout, site)
store-local
    - level.size
    - arithmetic(site, .arithmetic-add, size, integer(.machine-u64, 1), u64-layout)
    - site

────────────────────
_ do grow-in-arena
    - level CaptureLevel
    - item-layout LayoutId
    - size Operand
    - site SyntaxId

` Makes room for one more item after the `size` a list holds in the arena its context names,
` as the reference grows an arena's builder: the items are described to the arena where they
` hold pointers the collector follows.
. items-layout = ir.locals[level.items].layout
. context-layout = if level.context != no-local then local-layout else void-layout
    .. local-layout = ir.locals[level.context].layout
if level.context == no-local || !tables.layouts.is-struct(context-layout) || unpaired-context
    refuse(.refused-expression, site)
    =
.. unpaired-context = tables.layouts.rows[context-layout].fields.count != 2
. data-field = tables.layouts.field(items-layout, 0)
. count-field = tables.layouts.field(items-layout, 1)
. held = load-local(level.items, site)
. current = BuilderItems
    - num-cast(site, take(held, data-field, site), data-field.layout, u64-layout)
    - num-cast(site, take(held, count-field, site), count-field.layout, u64-layout)
. context = load-local(level.context, site)
. needed = arithmetic(site, .arithmetic-add, size, integer(.machine-u64, 1), u64-layout)
. traced = tables.layouts.rows[item-layout].is-managed
. grown = reserve-items
    - site
    - item-layout
    - traced
    - word-at(site, context, context-layout, 0)
    - word-at(site, context, context-layout, 1)
    - current
    - needed
. items = frame(items-layout)
put(items, data-field, num-cast(site, grown.storage, u64-layout, data-field.layout), site)
put(items, count-field, num-cast(site, grown.capacity, u64-layout, count-field.layout), site)
store-local(level.items, items, site)

────────────────────
_ do context-local LocalId
    - collector TypeId
    - site SyntaxId

` The local a list kept in a collector of a type holds the context of its backing in, where
` the backing is not the collector's, or none.
if class-arg(types, collector, 1) == types.gc-backing-type
    = no-local
. layout = layout-of(collector, site)
= ir.add-local(tables.layouts.field(layout, 2).layout)

────────────────────
_ do start-level
    - level CaptureLevel
    - site SyntaxId

` Empties a list as the reference makes a collector: no items, none counted, and, where its
` backing is not the collector's, the context the helper gives for it, read each time.
zero(load-local(level.items, site), ir.locals[level.items].layout)
store-local(level.size, integer(.machine-u64, 0), site)
if level.context == no-local
    =
if streaming.storage-row == U32.max || streaming.pattern-helper-type == no-type
    refuse(.refused-expression, site)
    =
. row = facts.storage-bodies[streaming.storage-row]
. context = read-through(site, Typed(streaming.pattern-helper, streaming.pattern-helper-type), row.through)
if layout-of(context.type, site) != ir.locals[level.context].layout
    refuse(.refused-expression, site)
    =
store-local(level.context, context.operand, site)

────────────────────
_ do put-item
    - level CaptureLevel
    - index Operand
    - element Operand
    - item-layout LayoutId
    - site SyntaxId

` Stores an item of a list at an index its items hold, through the write barrier where it is
` managed.
. items-layout = ir.locals[level.items].layout
. width = tables.layouts.rows[item-layout].size as U64
. storage-field = tables.layouts.field(items-layout, 0)
. storage = take(load-local(level.items, site), storage-field, site)
. distance = arithmetic(site, .arithmetic-multiply, index, integer(.machine-u64, width), u64-layout)
. place = num-cast
    - site
    - arithmetic
        - site
        - .arithmetic-add
        - num-cast(site, storage, storage-field.layout, u64-layout)
        - distance
        - u64-layout
    - u64-layout
    - pointer-layout
. managed = tables.layouts.rows[item-layout].is-managed
if tables.layouts.is-struct(item-layout)
    copy(address(place, 0, item-layout, site), element, item-layout, managed, site)
else
    store(place, 0, element, managed && is-managed-pointer(item-layout), site)

────────────────────
_ do count-of Typed
    - bound SyntaxId

` A bound of a count computed as the match runs, as a Size.
. value = emit-expression(bound)
. layout = layout-of(value.type, bound)
if !is-integer(layout)
    refuse(.refused-type, bound)
    = value
= Typed(num-cast(bound, value.operand, layout, u64-layout), value.type)

────────────────────
_ do stream-lookahead Operand
    - run StreamRun
    - id SyntaxId
    - operand SyntaxId
    - positive Bool
    - cursor Operand
    - failed IRBlockId

` A part tried from a cursor for whether it passes, which leaves the cursor where it was: a
` positive lookahead passes where the part does, and a negative one where it fails. Either way
` the lists names accumulate in the part are cut back to what they held before it, and the
` rollback mark the part holds is given back.
. passed = ir.reserve-block()
. missed = ir.reserve-block()
. marks = mark-levels(operand)
. entered = enter-marks(id)
emit-stream-part(run, operand, cursor, missed)
if streaming.observer-row != U32.max && !scanning && !streaming.classing
    rewind-literals(id, cursor)
rewind-levels(marks, id)
fail-marks(entered, id)
jump(if positive then passed else failed)
ir.start-block(missed)
rewind-levels(marks, id)
fail-marks(entered, id)
jump(if positive then failed else passed)
ir.start-block(passed)
= cursor

────────────────────
_ do stream-guard Operand
    - id SyntaxId
    - operand SyntaxId
    - positive Bool
    - cursor Operand
    - failed IRBlockId

` A lookahead of a test that does not read the item, which the type pass planned as a guard: its
` condition is tested alone, reading no item, and a positive one passes where it holds and a
` negative one where it does not. Either way the cursor stays where it was.
. predicate SyntaxId = match tree.nodes[operand]
    | .node-stream-predicate(row)
        row.predicate
    ??
        0
if predicate == 0
    refuse(.refused-expression, id)
    = cursor
. holds = test(predicate, emit-expression(predicate)).operand
. passed = ir.reserve-block()
branch(holds, if positive then passed else failed, if positive then failed else passed)
ir.start-block(passed)
= cursor

────────────────────
_ do stream-advance Operand
    - run StreamRun
    - id SyntaxId
    - cursor Operand
    - count U64

` A cursor moved on by a count of items.
if count == 0
    = cursor
= arithmetic
    - id
    - .arithmetic-add
    - cursor
    - integer(tables.layouts.rows[run.index-layout].kind, count)
    - run.index-layout

────────────────────
_ do stream-item Operand
    - run StreamRun
    - id SyntaxId
    - spot Operand

` The item of the stream's buffer at a cursor the pattern knows is inside it: a struct as its
` address there, and anything else loaded.
. stride = integer(.machine-u64, tables.layouts.rows[run.item-layout].size)
. offset = arithmetic
    - id
    - .arithmetic-multiply
    - num-cast(id, spot, run.index-layout, u64-layout)
    - stride
    - u64-layout
. cell = moved-bytes(id, run-data(run, id), offset)
if tables.layouts.is-struct(run.item-layout)
    = address(cell, 0, run.item-layout, id)
= load(cell, 0, run.item-layout, id)

────────────────────
+ encodes Bool
    - run StreamRun

` Whether the buffer of the stream a pattern runs on holds the UTF-8 bytes of the characters the
` stream gives, as a `TextTokenStream`'s text view does, rather than the characters: its cursors
` count bytes, and a character is read from the byte it starts at.
item == char && class-arg(types, run.buffer-type, 0) == types.type-row(.uint8)

.. char = types.type-row(.char)
.. item = if same-decl(class-ref(types, run.stream-type), types.text-token-stream-decl) then char else class-arg(types, run.stream-type, 0)

────────────────────
_ do wide-ranges Bool
    - run StreamRun
    - ranges [ItemRange]

` Whether ranges of characters are not tested on the byte a character starts with where the
` buffer is UTF-8: where one holds characters past ASCII, but not every one.
if !encodes(run)
    = false
for range in ranges
    if range.last >= 0x80 && (range.first > 0x80 || range.last < any-item)
        = true
= false

────────────────────
_ do char-width Operand
    - run StreamRun
    - id SyntaxId
    - lead Operand

` The count of bytes of the character whose UTF-8 starts with a byte, as an index: one, and one
` more for each of 0xC0, 0xE0 and 0xF0 the byte reaches.
. width = arithmetic
    - id
    - .arithmetic-add
    - integer(tables.layouts.rows[run.index-layout].kind, 1)
    - reaches(run, id, lead, 0xC0)
    - run.index-layout
width = arithmetic(id, .arithmetic-add, width, reaches(run, id, lead, 0xE0), run.index-layout)
= arithmetic(id, .arithmetic-add, width, reaches(run, id, lead, 0xF0), run.index-layout)

────────────────────
_ do reaches Operand
    - run StreamRun
    - id SyntaxId
    - lead Operand
    - bound U64

` One, as an index, where a byte is at least a bound, and else none.
= num-cast
    - id
    - compare
        - id
        - .compare-greater-equal
        - lead
        - integer(tables.layouts.rows[run.item-layout].kind, bound)
    - u8-layout
    - run.index-layout

────────────────────
_ do char-next Operand
    - run StreamRun
    - id SyntaxId
    - cursor Operand

` The cursor past the item at a cursor the pattern knows is inside the buffer: past the bytes of
` the character there where the buffer is UTF-8, and else the next.
if !encodes(run)
    = stream-advance(run, id, cursor, 1)
= arithmetic
    - id
    - .arithmetic-add
    - cursor
    - char-width(run, id, stream-item(run, id, cursor))
    - run.index-layout

────────────────────
_ do advance-chars Operand
    - run StreamRun
    - id SyntaxId
    - cursor Operand
    - count U64

` The cursor a count of characters past a cursor in a UTF-8 buffer, or the end of the input
` where it ends first.
. kind = tables.layouts.rows[run.index-layout].kind
. at = ir.add-local(run.index-layout)
store-local(at, cursor, id)
. left = ir.add-local(run.index-layout)
store-local(left, integer(kind, count), id)
. test = ir.reserve-block()
. inside = ir.reserve-block()
. step = ir.reserve-block()
. done = ir.reserve-block()
jump(test)
ir.start-block(test)
branch(compare(id, .compare-greater, load-local(left, id), integer(kind, 0)), inside, done)
ir.start-block(inside)
branch(compare(id, .compare-less, load-local(at, id), run-length(run, id)), step, done)
ir.start-block(step)
store-local(at, char-next(run, id, load-local(at, id)), id)
store-local
    - left
    - arithmetic(id, .arithmetic-subtract, load-local(left, id), integer(kind, 1), run.index-layout)
    - id
jump(test)
ir.start-block(done)
= load-local(at, id)

────────────────────
_ do char-at Operand
    - run StreamRun
    - id SyntaxId
    - spot Operand

` The item at a cursor the pattern knows is inside the buffer, as `stream-item` reads it, but
` where the buffer is UTF-8, the character whose bytes start there, decoded: a byte below 0x80
` is the character, and else the bits a lead byte keeps for it are followed by six of each
` byte after it.
if !encodes(run)
    = stream-item(run, id, spot)
. layout = layout-of(types.type-row(.char), id)
. value = ir.add-local(layout)
. lead = stream-item(run, id, spot)
. wide = num-cast(id, lead, run.item-layout, layout)
. single = ir.reserve-block()
. multiple = ir.reserve-block()
. two = ir.reserve-block()
. longer = ir.reserve-block()
. three = ir.reserve-block()
. four = ir.reserve-block()
. done = ir.reserve-block()
. byte-kind = tables.layouts.rows[run.item-layout].kind
branch(compare(id, .compare-less, lead, integer(byte-kind, 0x80)), single, multiple)
ir.start-block(single)
store-local(value, wide, id)
jump(done)
ir.start-block(multiple)
. second = continuation(run, id, spot, 1, layout)
branch(compare(id, .compare-less, lead, integer(byte-kind, 0xE0)), two, longer)
ir.start-block(two)
store-local
    - value
    - merged(id, shifted(id, masked(id, wide, 0x1F, layout), 6, layout), second, layout)
    - id
jump(done)
ir.start-block(longer)
. third = continuation(run, id, spot, 2, layout)
branch(compare(id, .compare-less, lead, integer(byte-kind, 0xF0)), three, four)
ir.start-block(three)
. upper = merged
    - id
    - shifted(id, masked(id, wide, 0x0F, layout), 12, layout)
    - shifted(id, second, 6, layout)
    - layout
store-local(value, merged(id, upper, third, layout), id)
jump(done)
ir.start-block(four)
. fourth = continuation(run, id, spot, 3, layout)
. high = merged
    - id
    - shifted(id, masked(id, wide, 0x07, layout), 18, layout)
    - shifted(id, second, 12, layout)
    - layout
store-local
    - value
    - merged(id, merged(id, high, shifted(id, third, 6, layout), layout), fourth, layout)
    - id
jump(done)
ir.start-block(done)
= load-local(value, id)

────────────────────
_ do continuation Operand
    - run StreamRun
    - id SyntaxId
    - spot Operand
    - offset U64
    - layout LayoutId

` The six bits a continuation byte of a character in a UTF-8 buffer keeps, some bytes past the
` cursor its character starts at, as a number of a layout.
. byte = stream-item(run, id, stream-advance(run, id, spot, offset))
= masked(id, num-cast(id, byte, run.item-layout, layout), 0x3F, layout)

────────────────────
_ do masked Operand
    - id SyntaxId
    - value Operand
    - mask U64
    - layout LayoutId

= bitwise(id, .bitwise-and, value, integer(tables.layouts.rows[layout].kind, mask), layout)

────────────────────
_ do merged Operand
    - id SyntaxId
    - left Operand
    - right Operand
    - layout LayoutId

= bitwise(id, .bitwise-or, left, right, layout)

────────────────────
_ do text-span Typed
    - capture StreamCapture
    - id SyntaxId
    - type TypeId

. nothing = make-operand(.operand-void, 0)
. run = capture.run
. layout = layout-of(type, id)
if !tables.layouts.is-struct(layout) || tables.layouts.rows[layout].fields.count != 3
    refuse(.refused-type, id)
    = Typed(nothing, no-type)
. source-field = tables.layouts.field(layout, 0)
. start-field = tables.layouts.field(layout, 1)
. end-field = tables.layouts.field(layout, 2)
if source-field.layout != run.buffer-layout || unindexed-bounds
    refuse(.refused-type, id)
    = Typed(nothing, no-type)
.. unindexed-bounds = start-field.layout != run.index-layout || end-field.layout != run.index-layout
. buffer = run-buffer(run, id)
. span = frame(layout)
put(span, source-field, buffer, id)
put(span, start-field, load-local(capture.begin, id), id)
put(span, end-field, load-local(capture.end, id), id)
= Typed(span, type)

────────────────────
+ do stream-text Typed
    - run StreamRun
    - site SyntaxId
    - begun Operand
    - ending Operand

` The text a part of a pattern matched: the part of the stream's buffer between two cursors,
` as an array that shares the buffer's items, made text by the call the type pass recorded
` where the text is given, after the two that read text a value gives where the part is one;
` or where a helper makes it, what its materializer makes of the buffer and the cursors.
. nothing = make-operand(.operand-void, 0)
. made = material-at(site, .material-text)
if made != U32.max
    = material-capture(run, site, made, begun, ending)
. fact = facts.first-call(unit.reading, site)
if tree.nodes[site] is .node-stream-equality
    fact = next-call(next-call(fact))
if fact == no-fact
    refuse(.refused-expression, site)
    = Typed(nothing, no-type)
= call-protocol(site, fact, stream-slice(run, site, begun, ending).operand, run.buffer-type, nothing)

────────────────────
+ do material-at U32
    - site SyntaxId
    - kind MaterialKind

` The first value of a kind the helper makes at a place, as the type pass recorded it, or
` `U32.max`.
. row = facts.first-material(unit.reading, site)
while row != U32.max
    if facts.materials[row].kind == kind
        = row
    row = facts.materials[row].next
= U32.max

────────────────────
_ do material-receiver Typed
    - site SyntaxId

` The helper the match keeps, which a materializer is called for: by the properties the type
` pass kept at the materializer's call, read from it in turn, as `call-protocol` reads them.
if streaming.pattern-helper-type == no-type
    refuse(.refused-expression, site)
= Typed(streaming.pattern-helper, streaming.pattern-helper-type)

────────────────────
_ do material-capture Typed
    - run StreamRun
    - site SyntaxId
    - row U32
    - begun Operand
    - ending Operand

` What a capture materializer makes of the stream's buffer and two cursors, by the call the
` type pass recorded. A rule's function, given where the items start and their count, gives it
` an array that shares them.
. fact = facts.materials[row]
. receiver = material-receiver(site)
. receiver-type = receiver.type
. buffer = run-buffer(run, site)
. answer = call-protocol
    - site
    - fact.call
    - receiver.operand
    - receiver-type
    - buffer
    - run.buffer-type
    - true
    - begun
    - types.index-type
    - ending
    - types.index-type
= answer

────────────────────
_ do span-text Typed
    - site SyntaxId
    - span Operand
    - type TypeId
    - call FactId

` The text of the items a `CaptureSpan` spans, as an action reads a name that holds one: the
` part of its source between its cursors, as an array that shares the source's items, made
` text by the call the type pass recorded.
. nothing = make-operand(.operand-void, 0)
. layout = layout-of(type, site)
if !tables.layouts.is-struct(layout) || tables.layouts.rows[layout].fields.count != 3
    refuse(.refused-type, site)
    = Typed(nothing, no-type)
. source-field = tables.layouts.field(layout, 0)
. start-field = tables.layouts.field(layout, 1)
. end-field = tables.layouts.field(layout, 2)
. item-layout = layout-of(class-arg(types, type, 0), site)
if !tables.layouts.is-struct(source-field.layout) || unpaired-source || uneven-bounds
    refuse(.refused-type, site)
    = Typed(nothing, no-type)
.. unpaired-source = tables.layouts.rows[source-field.layout].fields.count != 2
.. uneven-bounds = start-field.layout != end-field.layout || !is-integer(start-field.layout)
. data-field = tables.layouts.field(source-field.layout, 0)
. size-field = tables.layouts.field(source-field.layout, 1)
. source = take(span, source-field, site)
. begun = take(span, start-field, site)
. ending = take(span, end-field, site)
. stride = integer(.machine-u64, tables.layouts.rows[item-layout].size)
. offset = arithmetic
    - site
    - .arithmetic-multiply
    - num-cast(site, begun, start-field.layout, u64-layout)
    - stride
    - u64-layout
. data = num-cast(site, take(source, data-field, site), data-field.layout, pointer-layout)
. slice = frame(source-field.layout)
put
    - slice
    - data-field
    - num-cast(site, moved-bytes(site, data, offset), pointer-layout, data-field.layout)
    - site
. count = arithmetic(site, .arithmetic-subtract, ending, begun, start-field.layout)
put(slice, size-field, num-cast(site, count, start-field.layout, size-field.layout), site)
= call-protocol(site, call, slice, source-field.type, nothing)

────────────────────
_ do material-value Typed
    - site SyntaxId
    - row U32
    - value Operand
    - given TypeId

` What a value materializer makes of a value, by the call the type pass recorded.
. fact = facts.materials[row]
. receiver = material-receiver(site)
. receiver-type = receiver.type
. answer = call-protocol(site, fact.call, receiver.operand, receiver-type, value, given)
= answer

────────────────────
+ do remake Typed
    - site SyntaxId
    - row U32
    - value Operand
    - given TypeId

` What a helper makes again of what an action gave, by the value materializer the type pass
` recorded: of the value; of what an optional one holds; or, where the call that grows a list
` is recorded after the materializer's, of each item of a list.
. fact = facts.materials[row]
if fact.next != U32.max && facts.materials[fact.next].kind == .material-grow
    = material-items(site, row, fact.next, value, given, class-arg(types, given, 0))
if types.is-optional(given)
    = material-optional(site, row, value, given)
= material-value(site, row, value, given)

────────────────────
_ do material-optional Typed
    - site SyntaxId
    - row U32
    - held Operand
    - given TypeId

` What a value materializer makes of an optional value: of what it holds, only where it holds
` a value, as the optional the type pass recorded; null where it holds none.
. fact = facts.materials[row]
. layout = layout-of(fact.type, site)
. slot = join-slot(layout)
. joined = ir.reserve-block()
. holds = ir.reserve-block()
. empty = ir.reserve-block()
. mark = joins.length
branch(present(site, Typed(held, given)).operand, holds, empty)
ir.start-block(holds)
. inner = payload(site, Typed(held, given))
. made = material-value(site, row, inner.operand, types.optional-inner(given))
arrive(site, wrap(site, made, fact.type).operand, joined, slot)
ir.start-block(empty)
arrive(site, empty-optional(fact.type, layout).operand, joined, slot)
. kept = close-joins(joined, mark, layout, slot)
= Typed(kept, fact.type)

────────────────────
+ do bind-materials
    - run StreamRun
    - action SyntaxId

` Binds each name an action reads that the helper makes to what it makes, in the order the
` type pass recorded them: from the cursors of a name captured over text, only where an
` optional one holds text, or from what a name holds, item by item where it holds a list a
` rule gave.
. row = facts.first-material(unit.reading, action)
while row != U32.max
    . fact = facts.materials[row]
    . current = row
    row = fact.next
    if fact.kind != .material-capture && fact.kind != .material-value && not-span-text
        continue
    .. not-span-text = fact.kind != .material-span-text
    . held = captured-at(fact.slot)
    if held == U32.max
        refuse(.refused-expression, action)
        =
    . capture = stream-captures[held]
    if fact.kind == .material-span-text
        if capture.listed != 0 || capture.value == no-local
            refuse(.refused-expression, action)
            =
        . text = span-text(action, load-local(capture.value, action), capture.type, fact.call)
        bound += BoundValue(fact.slot, fact.type, text.operand)
        continue
    if capture.listed != 0
        if fact.next == U32.max || facts.materials[fact.next].kind != .material-grow
            refuse(.refused-expression, action)
            =
        . made = material-list(run, action, current, capture, fact.next)
        bound += BoundValue(fact.slot, fact.type, made.operand)
        continue
    if fact.kind == .material-value
        if capture.value == no-local
            refuse(.refused-expression, action)
            =
        . held-value = load-local(capture.value, action)
        if fact.next != U32.max && facts.materials[fact.next].kind == .material-grow
            . items = material-items
                - action
                - current
                - fact.next
                - held-value
                - capture.type
                - class-arg(types, capture.type, 0)
            bound += BoundValue(fact.slot, fact.type, items.operand)
            continue
        if !types.is-optional(capture.type)
            . made = material-value(action, current, held-value, capture.type)
            bound += BoundValue(fact.slot, fact.type, made.operand)
            continue
        . kept = material-optional(action, current, held-value, capture.type)
        bound += BoundValue(fact.slot, fact.type, kept.operand)
        continue
    if capture.present == no-local
        . made = material-capture
            - run
            - action
            - current
            - load-local(capture.begin, action)
            - load-local(capture.end, action)
        bound += BoundValue(fact.slot, fact.type, made.operand)
        continue
    . layout = layout-of(fact.type, action)
    . slot = join-slot(layout)
    . joined = ir.reserve-block()
    . holds = ir.reserve-block()
    . empty = ir.reserve-block()
    . mark = joins.length
    branch
        - compare
            - action
            - .compare-not-equal
            - load-local(capture.present, action)
            - integer(.machine-u8, 0)
        - holds
        - empty
    ir.start-block(holds)
    . made = material-capture
        - run
        - action
        - current
        - load-local(capture.begin, action)
        - load-local(capture.end, action)
    arrive(action, wrap(action, made, fact.type).operand, joined, slot)
    ir.start-block(empty)
    arrive(action, empty-optional(fact.type, layout).operand, joined, slot)
    . result = close-joins(joined, mark, layout, slot)
    bound += BoundValue(fact.slot, fact.type, result)

────────────────────
_ do material-list Typed
    - run StreamRun
    - action SyntaxId
    - row U32
    - capture StreamCapture
    - grower U32

` The list a helper makes of a name captured in a repeat, as `material-items` makes it of the
` list its passes kept.
. source = capture-levels[capture.levels + capture.listed - 1]
= material-items(action, row, grower, level-list(source, action).operand, source.list, source.item, run)

────────────────────
_ do material-items Typed
    - action SyntaxId
    - row U32
    - grower U32
    - ranges Operand
    - list TypeId
    - item TypeId
    - run StreamRun? = null

` The list a helper makes of a list, in order: what the capture materializer makes of each
` range kept over the text of `run`, or the value materializer of each value, added to a
` collector of its own, grown by the call the type pass recorded, which the list then reads.
. nothing = make-operand(.operand-void, 0)
. ranges-layout = layout-of(list, action)
. item-layout = layout-of(item, action)
. grow = facts.materials[grower]
. callee = facts.calls[grow.call].callee
if callee == no-instance
    refuse(.refused-expression, action)
    = Typed(nothing, no-type)
. level = CaptureLevel
    - U32.max
    - ir.add-local(layout-of(instances.signatures[callee].returns, action))
    - ir.add-local(u64-layout)
    - grow.call
    - grow.type
    - class-arg(types, grow.type, 0)
    - facts.materials[row].type
    - context-local(grow.type, action)
start-level(level, action)
. data-field = tables.layouts.field(ranges-layout, 0)
. count-field = tables.layouts.field(ranges-layout, 1)
. data = num-cast(action, take(ranges, data-field, action), data-field.layout, u64-layout)
. count = num-cast(action, take(ranges, count-field, action), count-field.layout, u64-layout)
. index = ir.add-local(u64-layout)
store-local(index, integer(.machine-u64, 0), action)
. test = ir.reserve-block()
. body = ir.reserve-block()
. done = ir.reserve-block()
jump(test)
ir.start-block(test)
. current = load-local(index, action)
branch(compare(action, .compare-less, current, count), body, done)
ir.start-block(body)
. stride = integer(.machine-u64, tables.layouts.rows[item-layout].size)
. offset = arithmetic(action, .arithmetic-multiply, current, stride, u64-layout)
. place = num-cast
    - action
    - arithmetic(action, .arithmetic-add, data, offset, u64-layout)
    - u64-layout
    - pointer-layout
. element = Typed(make-operand(.operand-void, 0), no-type)
if facts.materials[row].kind == .material-capture
    if run == null
        refuse(.refused-expression, action)
        = Typed(nothing, no-type)
    . range = address(place, 0, item-layout, action)
    . begun = take(range, tables.layouts.field(item-layout, 0), action)
    . ending = take(range, tables.layouts.field(item-layout, 1), action)
    element = material-capture(run, action, row, begun, ending)
else
    . given = if tables.layouts.is-struct(item-layout) then address(place, 0, item-layout, action) else load(place, 0, item-layout, action)
    element = material-value(action, row, given, item)
append-level(level, element, action)
store-local
    - index
    - arithmetic(action, .arithmetic-add, current, integer(.machine-u64, 1), u64-layout)
    - action
jump(test)
ir.start-block(done)
= level-list(level, action)

────────────────────
_ do stream-slice Typed
    - run StreamRun
    - site SyntaxId
    - begun Operand
    - ending Operand

` The part of the stream's buffer between two cursors, as an array that shares the buffer's
` items.
. slice = frame(run.buffer-layout)
. data-field = tables.layouts.field(run.buffer-layout, 0)
. size-field = tables.layouts.field(run.buffer-layout, 1)
. stride = integer(.machine-u64, tables.layouts.rows[run.item-layout].size)
. offset = arithmetic
    - site
    - .arithmetic-multiply
    - num-cast(site, begun, run.index-layout, u64-layout)
    - stride
    - u64-layout
put
    - slice
    - data-field
    - num-cast
        - site
        - moved-bytes(site, run-data(run, site), offset)
        - pointer-layout
        - data-field.layout
    - site
. count = arithmetic(site, .arithmetic-subtract, ending, begun, run.index-layout)
put(slice, size-field, num-cast(site, count, run.index-layout, size-field.layout), site)
= Typed(slice, run.buffer-type)

────────────────────
_ do record-extent
    - run StreamRun
    - id SyntaxId
    - probe Operand

` Keeps how far the pattern read: the farthest of what it had read and a cursor it read up to.
. farther = ir.reserve-block()
. kept = ir.reserve-block()
branch(compare(id, .compare-greater, probe, load-local(run.extent, id)), farther, kept)
ir.start-block(farther)
store-local(run.extent, probe, id)
jump(kept)
ir.start-block(kept)

────────────────────
+ do record-error
    - run StreamRun
    - id SyntaxId
    - cursor Operand

` Keeps the farthest cursor a part of the pattern failed at: the cursor where a part that
` failed began, or where an arm that had to read the whole input ended. The test of an item a
` repeat scans keeps none.
if scanning
    =
. farther = ir.reserve-block()
. kept = ir.reserve-block()
branch(compare(id, .compare-greater, cursor, load-local(run.error, id)), farther, kept)
ir.start-block(farther)
store-local(run.error, cursor, id)
jump(kept)
ir.start-block(kept)

────────────────────
_ do failure-of IRBlockId
    - run StreamRun
    - id SyntaxId
    - cursor Operand
    - failed IRBlockId

` Where a part tried from a cursor goes where it fails: a block that keeps the cursor as one a
` part failed at, then goes to `failed`. What is emitted next goes on past it.
if scanning
    = failed
. missed = ir.reserve-block()
. onward = ir.reserve-block()
jump(onward)
ir.start-block(missed)
record-error(run, id, cursor)
jump(failed)
ir.start-block(onward)
= missed

────────────────────
_ do last-item Operand
    - run StreamRun
    - id SyntaxId
    - cursor Operand

` The cursor of the item before a cursor, or the cursor itself where no item lies before it.
. kind = tables.layouts.rows[run.index-layout].kind
. kept = ir.add-local(run.index-layout)
store-local(kept, cursor, id)
. back = ir.reserve-block()
. done = ir.reserve-block()
branch(compare(id, .compare-greater, cursor, integer(kind, 0)), back, done)
ir.start-block(back)
store-local
    - kept
    - arithmetic(id, .arithmetic-subtract, cursor, integer(kind, 1), run.index-layout)
    - id
jump(done)
ir.start-block(done)
= load-local(kept, id)

────────────────────
+ do location-fact FactId
    - arm SyntaxId

` The call the type pass recorded at an arm of a grammar whose expression reads
` `location`, after any other there: the one that answers where in the input a cursor lies.
. fact = facts.first-call(unit.reading, arm)
while fact != no-fact
    . callee = facts.calls[fact].callee
    if facts.calls[fact].next == no-fact && callee != no-instance && gives-location
        = fact
    .. gives-location = instances.signatures[callee].returns == types.token-location-type
    fact = facts.calls[fact].next
= no-fact

────────────────────
+ do bind-location
    - run StreamRun
    - arm SyntaxId
    - fact FactId
    - begin Operand
    - end Operand
    - spans Bool

` Binds the `location` an arm of a grammar declares, made where the arm runs of the
` stream's locations of cursors, by a call the type pass recorded at the arm: where it
` `spans` a pattern, a `MatchLocation` of where the pattern began and of the last item it
` matched, or of where it began where it matched none; else the `TokenLocation` of its one
` cursor. Where functions the expression makes read it, it is kept in the environment too.
. slot = arm-slot-of(arm, .slot-location)
if slot == no-slot
    refuse(.refused-expression, arm)
    =
. begun = call-protocol(arm, fact, run.stream, run.stream-type, begin, types.index-type)
if begun.type != types.token-location-type
    refuse(.refused-type, arm)
    =
if !spans
    if is-captured(slot)
        keep-captured(slot, begun.operand, begun.type, arm)
    bound += BoundValue(slot, begun.type, begun.operand)
    =
. layout = layout-of(types.match-location-type, arm)
. made = frame(layout)
put(made, tables.layouts.field(layout, 0), begun.operand, arm)
. ended = call-protocol
    - arm
    - fact
    - run.stream
    - run.stream-type
    - last-item(run, arm, end)
    - types.index-type
put(made, tables.layouts.field(layout, 1), ended.operand, arm)
if is-captured(slot)
    keep-captured(slot, made, types.match-location-type, arm)
bound += BoundValue(slot, types.match-location-type, made)

────────────────────
_ stream-always-passes Bool
    - id SyntaxId

` Whether the last arm of a grammar always passes or raises: one with no pattern, or one
` that raises.
match tree.nodes[id]
    | .node-stream-or(row)
        stream-always-passes(row.right)
    | .node-stream-transform(row)
        row.pattern == 0 || stream-always-passes(row.pattern)
    | .node-stream-panic
        true
    ??
        false

────────────────────
+ do holds-capture Bool
    - slot SlotId

` Whether a name is bound to what a grammar captured, which it reads from the places
` the pattern keeps, never from an environment.
for row in bound
    if row.slot == slot && (row.capture != U32.max || row.cursor != U32.max)
        = true
= false

────────────────────
_ do clear-local
    - local LocalId
    - layout LayoutId
    - site SyntaxId

` Stores the zero of its layout in a local: a struct cleared whole, a float's zero, or the
` zero of any other layout's kind, which for a pointer is the one that points at nothing.
if tables.layouts.is-struct(layout)
    zero
        - make-operand
            - .operand-value
            - append(.op-local-address, site, Span(), local, pointer-layout)
        - layout
else if is-float(layout)
    store-local(local, float-number(layout, 0.0), site)
else
    store-local(local, integer(tables.layouts.kind-of(layout), 0), site)

────────────────────
+ do emit-raising-rule

` A rule as the function calls that give it a pattern whose function may raise errors run:
` as the rule's function, but a call of the pattern it is given takes the pattern's answer or
` one of the errors, which leaves the function with the call, and the function returns its
` own answer or one of them. The rule takes one pattern, and reads it only to call it, as
` `emit-identifier` checks. A local rule of the rule that runs as a function has such a
` function too, which the rule's calls.
. row = facts.raising-rules[function.place]
. signature = instances.signatures[unit.instance]
. patterns U32
for position in 0 .. < signature.args.count
    if types.is-pattern-func(instances.argument-type(unit.instance, position))
        patterns += 1
if patterns != 1 || signature.errors.count != 0
    refuse-own()
    =
carried-given = row.given
carried-result = row.result
if row.rule == 0
    emit-body()
else
    emit-lazy-rule(row.rule)

────────────────────
+ do emit-mapped-rule

` A rule, or a local rule of one, as the function calls of it that give it a set of
` collectors run: as the rule's function, given after its other arguments a pointer to each
` collector, whose list the rule's name it is given for adds to while it runs. No such call
` reads what the rule gives, so its arms make no text of what they matched. A set of no
` collectors adds no arguments.
. mapping = tables.rule-mappings[function.place]
if mapping.names != no-string
    for name in tables.bundle.text(mapping.names).split(",")
        collector-args += name
if mapping.rule == 0
    emit-body()
else
    emit-lazy-rule(mapping.rule)

────────────────────
+ do emit-lazy-rule
    - rule SyntaxId

` A local rule of a rule a module declares, as a function of its own that a pattern calls as
` it calls the rule: given the rule's stream and arguments, then the address the stream's
` items start at, the cursor to start from and the count of items, and where to keep where it
` ended, how far it read and the farthest cursor a part of it failed at. It reads the rule's
` arguments as the rule does. One of a rule that raises errors raises them too. One of a rule
` given its own helper as an argument runs under it, and one of a rule typed for a helper is
` given the helper as the rule is, and runs under it. One of a rule whose pattern holds a
` rollback mark holds one too, kept as the rule's, and gives it as the rule does. One no call
` reads the value of makes no text of what its arms matched. The function of a local rule
` beside a match that calls itself is given the stream alone before the address, and reads
` nothing of the function the rule is written in, as the tables made sure. Under a helper that
` observes literal words, one tells it of them only where `observes-literals` says its pattern
` holds any.
. signature = instances.signatures[unit.instance]
. declared SyntaxId = 0
do match? program.modules[unit.source-module].decls[instances.rows[unit.instance].decl]
    | .decl-function(fn)
        declared = fn.syntax
. matched SyntaxId = 0
do match? tree.nodes[rule]
    | .node-declare(declaration)
        matched = declaration.right
. pattern SyntaxId = 0
do match? tree.nodes[matched]
    | .node-stream-match(row)
        pattern = row.pattern
. result = facts.node-type(unit.reading, matched)
. place = facts.local-rule-of(unit.instance, rule)
. returned = if place != U32.max then facts.local-rules[place].answer else no-type
if tables.rule-adapter-of(unit.instance, rule) != no-function
    . local = facts.local-rules[place]
    if pattern == 0 || untyped-result || local.buffer == no-type || carrying
        refuse(.refused-function, rule)
        =
    .. untyped-result = result == no-type || returned == no-type
    .. carrying = carried-result != no-type || carries(unit.instance)
    ir.add-argument(layout-of(local.stream, rule))
    returns-type = returned
    ir.returns = layout-of(returned, rule)
    if signature.errors.count != 0
        return-results(local.result, rule)
    if !direct-arguments(local.buffer, rule)
        =
    inlining += rule
    . viewed = facts.first-call(unit.reading, matched)
    match-direct
        - rule
        - matched
        - pattern
        - result
        - returned
        - local.stream
        - local.buffer
        - 1
        - viewed
        - next-call(next-call(viewed))
    stop-inlining(rule)
    =
. buffer-type = facts.node-type(unit.reading, declared)
if declared == 0 || pattern == 0 || result == no-type || returned == no-type || unbuffered
    refuse(.refused-function, rule)
    =
.. unbuffered = buffer-type == no-type || signature.args.count == 0
. stream-type = instances.argument-type(unit.instance, 0)
ir.add-argument(layout-of(stream-type, rule))
for position in 1 .. < signature.args.count
    ir.add-argument(layout-of(instances.argument-type(unit.instance, position), rule))
returns-type = returned
ir.returns = layout-of(returned, rule)
if signature.errors.count != 0
    return-results(facts.local-rules[place].result, rule)
if carried-result != no-type
    return-results(carried-result, rule)
. first U32 = ir.arguments.length
if !direct-arguments(buffer-type, rule, instances.rows[unit.instance].helper, carries(unit.instance))
    =
if instances.rows[unit.instance].helper == no-type
    ambient-helper()
open-environment(declared)
bind-arguments(declared)
rule-arguments = true
. ruled = rule-match(program, instances.rows[unit.instance].module, instances.rows[unit.instance].decl)
. views = facts.first-call(unit.reading, ruled)
match-direct
    - rule
    - matched
    - pattern
    - result
    - returned
    - stream-type
    - buffer-type
    - first
    - views
    - next-call(views)
    - ruled
    - function.kind == .mapped-rule || !tables.reads-rule(unit.instance, rule)
    - observes-literals(tree, facts, unit.reading, pattern)

━━━━━━━━━━━━━━━━━━━━
_ do group-root U32
    - parents [U32]
    - position U32

` The alternative that stands for the group of another, as groups are joined.
. found = position
while parents[found] != found
    found = parents[found]
= found

━━━━━━━━━━━━━━━━━━━━
_ is-lowercase-letter Bool
    - point Char

point >= 'a' && point <= 'z'

━━━━━━━━━━━━━━━━━━━━
_ is-word-letter Bool
    - point Char

(point >= 'A' && point <= 'Z') || is-lowercase-letter(point)

━━━━━━━━━━━━━━━━━━━━
_ utf8-width U64
    - point Char

` The count of bytes UTF-8 writes a character in.
|? (point as U32) < 0x80: 1
|? (point as U32) < 0x800: 2
|? (point as U32) < 0x10000: 3
??: 4
