────────────────────
+ do run-data Operand
    - run StreamRun
    - site SyntaxId

` The address the items of the stream's buffer start at, as the pattern last read it.
= if run.kept-data != no-local then load-local(run.kept-data, site) else run.data

────────────────────
+ do run-length Operand
    - run StreamRun
    - site SyntaxId

` The count of items in the stream's buffer, as an index, as the pattern last read it.
= if run.kept-length != no-local then load-local(run.kept-length, site) else run.length

────────────────────
_ do branch-present
    - run StreamRun
    - site SyntaxId
    - cursor Operand
    - present IRBlockId
    - ended IRBlockId

` Goes on to `present` where an item lies at a cursor in the stream's buffer, and else to
` `ended`. A stream that may give more input is asked for more first, as often as it gives
` some, so that `ended` follows only once the input ends.
if run.kept-length == no-local
    branch(compare(site, .compare-less, cursor, run.length), present, ended)
    =
. test = ir.reserve-block()
. asks = ir.reserve-block()
jump(test)
ir.start-block(test)
branch(compare(site, .compare-less, cursor, run-length(run, site)), present, asks)
ir.start-block(asks)
. grew = call-protocol
    - site
    - run.extends
    - run.stream
    - run.stream-type
    - make-operand(.operand-void, 0)
if grew.type != types.bool-type
    refuse(.refused-type, site)
    =
reread-stream(run, site)
branch(compare(site, .compare-not-equal, grew.operand, integer(.machine-u8, 0)), test, ended)

────────────────────
_ do reread-stream
    - run StreamRun
    - site SyntaxId

` Reads the view of a stream that may give more input again, for the buffer it now holds,
` where its items start and how many it holds.
. view = call-protocol(site, run.views, run.stream, run.stream-type, make-operand(.operand-void, 0))
if !types.is-optional(view.type)
    refuse(.refused-type, site)
    =
. held = payload(site, view)
keep-view(run, site, held.operand, layout-of(held.type, site))

────────────────────
_ do keep-view
    - run StreamRun
    - site SyntaxId
    - held Operand
    - tuple-layout LayoutId

` Keeps of a view of the stream a pattern runs on, as `pattern-view` gives it, the buffer, where
` its items start and how many it holds, for the parts after to read.
. buffer = part(held, tuple-layout, 0, site)
. length = part(held, tuple-layout, 2, site)
. length-layout = layout-of(length.type, site)
. data = part(buffer.operand, run.buffer-layout, 0, site)
. data-layout = layout-of(data.type, site)
if run.kept-buffer != no-local
    store-local(run.kept-buffer, buffer.operand, site)
store-local(run.kept-data, num-cast(site, data.operand, data-layout, pointer-layout), site)
store-local(run.kept-length, num-cast(site, length.operand, length-layout, run.index-layout), site)

────────────────────
+ do record-call-extent
    - run StreamRun
    - id SyntaxId
    - reached Operand

` Keeps how far a function a pattern called read as how far the pattern read. Where it read past
` the end of the buffer of a stream that may give more input, the stream may have given it more,
` and its view is read again.
record-extent(run, id, reached)
if run.kept-length == no-local
    =
. again = ir.reserve-block()
. onward = ir.reserve-block()
branch(compare(id, .compare-greater, reached, run-length(run, id)), again, onward)
ir.start-block(again)
reread-stream(run, id)
jump(onward)
ir.start-block(onward)

────────────────────
_ do settle-extent
    - run StreamRun
    - site SyntaxId

` Keeps how far a pattern on a stream that may give more input read no farther than the end of
` the input, where it read past it, as the reference does once the stream gives no more.
if run.kept-length == no-local
    =
. length = run-length(run, site)
. beyond = ir.reserve-block()
. settled = ir.reserve-block()
branch(compare(site, .compare-greater, load-local(run.extent, site), length), beyond, settled)
ir.start-block(beyond)
store-local(run.extent, length, site)
jump(settled)
ir.start-block(settled)

────────────────────
_ do commit-stream
    - run StreamRun
    - fact FactId
    - cursor Operand

` Tells the stream where the pattern left it and how far it read.
. reached = load-local(run.extent, run.site)
call-protocol
    - run.site
    - fact
    - run.stream
    - run.stream-type
    - cursor
    - types.index-type
    - true
    - reached
    - types.index-type

────────────────────
+ do emit-stream-arms Bool
    - run StreamRun
    - id SyntaxId
    - result TypeId
    - from Operand
    - whole Bool
    - end LocalId
    - joined IRBlockId
    - slot Operand
    - failed IRBlockId
    - unread Bool = false

` The arms of a grammar, tried from a cursor as the alternatives of a choice are. An arm
` whose pattern passes, at the end of the input where the arms must read the whole of it,
` keeps where it ended and leaves its value, converted to the type the arms join as, for the
` join; one that fails, or leaves input unread that it must read, goes on to the next, and the
` last to `failed`. Whether any arm reaches the join. Where `unread`, nothing reads the value
` the arms join as.
. arms [SyntaxId]
choice-arms(tree, id, arms)
if arms.length == 1
    = emit-stream-arm(run, id, result, from, whole, end, joined, slot, failed, no-local, unread)
= try-alternatives
    - run
    - id
    - arms
    - from
    - observed-failure(id, from, failed)
    - ArmWay(id, result, whole, end, joined, slot, false, unread)

────────────────────
_ do emit-stream-arm Bool
    - run StreamRun
    - id SyntaxId
    - result TypeId
    - from Operand
    - whole Bool
    - end LocalId
    - joined IRBlockId
    - slot Operand
    - failed IRBlockId
    - entered LocalId = no-local
    - unread Bool = false

` One arm of a grammar, emitted as `emit-arm` says with the places of its own names
` in force, as `activate-captures` says. Whether the arm reaches the join.
. held = stream-captures.length
. named = bound.length
activate-captures(id)
. arrives = emit-arm(run, id, result, from, whole, end, joined, slot, failed, entered, unread)
-= stream-captures[held .. < stream-captures.length]
drop-bound(named)
= arrives

────────────────────
+ do bind-it
    - slot SlotId
    - value Operand
    - type TypeId
    - site SyntaxId

` Binds `it` in an arm of a grammar to what the arm gives its expression, which is kept
` in the environment too where functions the expression makes read it.
if is-captured(slot)
    keep-captured(slot, value, type, site)
bound += BoundValue(slot, type, value)

────────────────────
+ do keep-arm-captures
    - pattern SyntaxId

` Keeps in the environment, as an arm begins, what each name its pattern captures holds,
` where functions the arm's expression makes read the name.
. kept [SlotId]
for node in tree.subtree-start(pattern) .. < pattern + 1
    do match? tree.nodes[node]
        | .node-stream-capture(row)
            . slot = captured-slot(row.name)
            if slot == no-slot || !is-captured(slot) || kept has slot
                continue
            kept += slot
            . held = captured-at(slot)
            if held == U32.max
                refuse(.refused-expression, node)
                =
            . field = find-captured(slot, row.name)
            . value = read-capture(row.name, held, field.type)
            keep-captured(slot, value.operand, value.type, row.name)

────────────────────
+ do emit-bare-arm Bool
    - run StreamRun
    - id SyntaxId
    - result TypeId
    - from Operand
    - whole Bool
    - end LocalId
    - joined IRBlockId
    - slot Operand
    - failed IRBlockId
    - entered LocalId = no-local
    - unread Bool = false

` An arm that runs no expression: it gives the text its pattern matched, or what a rule its
` pattern calls gave, converted to the type the arms join as. Where it passes, the arms hold
` the rollback mark they held before it, where `entered` kept one. Where `unread`, nothing
` reads what the arm gives, and text `slices-text` says is only cut from the buffer is not
` made: the arm gives the empty text. Where the input must be read whole, an arm that leaves
` some unread fails as its pattern does.
. part = lowered-part(id)
. missed = observed-failure(part, from, failed)
. reached = emit-stream-node(run, part, from, missed)
. finish = reached.ending
. given = reached.value.operand
. given-type = reached.value.type
if whole
    stream-whole(run, id, finish, missed)
if facts.is-spanning-arm(unit.reading, id)
    . span = source-span(run, id, from, finish, result)
    pass-marks(entered, id)
    store-local(end, finish, id)
    arrive(id, span.operand, joined, slot)
    = true
. text = Typed(given, given-type)
if gives-value(id)
    if given-type == no-type
        refuse(.refused-expression, id)
        = false
else if unread && slices-text(id)
    text = Typed(make-operand(.operand-constant, ir.add-string("")), types.string-type)
else
    text = stream-text(run, id, from, finish)
if text.type != result
    text = join(id, text)
pass-marks(entered, id)
store-local(end, finish, id)
arrive(id, text.operand, joined, slot)
= true

────────────────────
_ do slices-text Bool
    - site SyntaxId

` Whether the text a part of a pattern matched is a `String` cut from the stream's buffer, by
` the call `stream-text` makes, rather than what a helper makes of it.
if material-at(site, .material-text) != U32.max
    = false
. fact = facts.first-call(unit.reading, site)
if tree.nodes[site] is .node-stream-equality
    fact = next-call(next-call(fact))
if fact == no-fact || facts.calls[fact].callee == no-instance
    = false
= instances.signatures[facts.calls[fact].callee].returns == types.string-type

────────────────────
+ do source-span Typed
    - run StreamRun
    - site SyntaxId
    - begun Operand
    - ending Operand
    - type TypeId

` The `CaptureSpan` an arm of a rule that states one gives: the stream's buffer and the two
` cursors its pattern matched between. A rule's function, given where the items start and
` their count, gives it an array that shares them.
. nothing = make-operand(.operand-void, 0)
. layout = layout-of(type, site)
if !tables.layouts.is-struct(layout) || tables.layouts.rows[layout].fields.count != 3
    refuse(.refused-type, site)
    = Typed(nothing, no-type)
. source-field = tables.layouts.field(layout, 0)
. start-field = tables.layouts.field(layout, 1)
. end-field = tables.layouts.field(layout, 2)
if source-field.layout != run.buffer-layout || unindexed-bounds
    refuse(.refused-type, site)
    = Typed(nothing, no-type)
.. unindexed-bounds = start-field.layout != run.index-layout || end-field.layout != run.index-layout
. buffer = run-buffer(run, site)
. span = frame(layout)
put(span, source-field, buffer, site)
put(span, start-field, begun, site)
put(span, end-field, ending, site)
= Typed(span, type)

────────────────────
+ gives-value Bool
    - id SyntaxId

` Whether a part of a grammar gives what a rule or a pattern it calls gives rather than
` the text it matched: so do a test of an item for a case of a union, which gives the item, and
` a call planned to give its text that the type pass recorded the helper to make another type of.
plan == .plan-stream-value || plan == .plan-pattern-call || plan == .plan-case || (plan == .plan-span-call && stated != types.string-type && stated != no-type && material-at(id, .material-text) != U32.max)

.. plan = facts.plan-of(unit.reading, id)
.. stated = facts.node-type(unit.reading, id)

────────────────────
+ do stream-whole
    - run StreamRun
    - id SyntaxId
    - finish Operand
    - failed IRBlockId

` Goes on where an arm's pattern ended at the end of the input, and else keeps where it ended
` as a cursor a part failed at and goes to `failed`.
. whole = ir.reserve-block()
. short = ir.reserve-block()
branch-present(run, id, finish, short, whole)
ir.start-block(short)
record-error(run, id, finish)
jump(failed)
ir.start-block(whole)

────────────────────
+ do emit-stream-raise
    - run StreamRun
    - id SyntaxId
    - failed IRBlockId

` An arm that raises what it gives where no arm before it passed, as an assertion raises its
` exception, which reads as `location` the farthest cursor a part of the pattern failed at.
. exception SyntaxId = 0
. located SyntaxId = 0
do match? tree.nodes[id]
    | .node-stream-panic(row)
        do match? tree.nodes[row.pattern]
            | .node-stream-transform(arm)
                if arm.pattern == 0
                    exception = arm.right
                    located = row.pattern
if exception == 0
    refuse(.refused-expression, id)
    =
. named = bound.length
. fact = location-fact(located)
if fact != no-fact
    . farthest = load-local(run.error, id)
    bind-location(run, located, fact, farthest, farthest, false)
raise-given(id, exception)
drop-bound(named)

────────────────────
_ do emit-stream-part StreamPart ?! Refused
    - run StreamRun
    - id SyntaxId
    - cursor Operand
    - failed IRBlockId

` A part of a grammar that runs nothing, tried from a cursor: where it passes, what is
` emitted next goes on from the cursor where it ended; where it fails it goes to `failed`.
` Alternatives are tried in turn from the cursor, and the first that passes is kept. A
` repeat takes its part as often as it passes, up to its most, and passes where it took it at
` least its least; one with no most stops where its part passed without moving on. An
` optional part passes either way. A lookahead passes or fails as its part does, or the other
` way, and leaves the cursor where it was. A name captured holds what its part matched. A
` call of a rule gives what the rule gave, which a sequence it ends, a name captured over it
` and an optional part around it give too, and a test of one item gives the item, as does a
` `.` the type pass typed as the item; no other part gives a value. A part that fails
` keeps where it began as a cursor a part failed at, as the reference's do, a choice too,
` since it may skip every alternative; sequences keep none of their own, as what fails in
` them began past where they did. Under a helper that observes literal words, a part that fails
` tells it so, as `observed-failure` says.
= emit-stream-node(run, id, cursor, observed-failure(id, cursor, failed))

────────────────────
+ do emit-stream-node StreamPart
    - run StreamRun
    - id SyntaxId
    - cursor Operand
    - failed IRBlockId

` A part of a grammar tried from a cursor, as `emit-stream-part` says, which goes to
` `failed` where it fails with nothing more told to the helper. A sequence in a sequence is
` one with it, as the reference takes it.
do match? tree.nodes[id]
    | .node-stream-string(row)
        = bare-part(stream-literal(run, id, row.text, cursor, failed))
    | .node-stream-call
        = stream-call(run, id, cursor, failed)
    | .node-stream-any
        . passed = stream-class(run, id, 0, 0, true, cursor, failed)
        . item = facts.node-type(unit.reading, id)
        if item != no-type
            = StreamPart(passed, Typed(char-at(run, id, cursor), item))
        = bare-part(passed)
    | .node-stream-char-range(row)
        . ranged = stream-class
            - run
            - id
            - tree.stream-bound(row.first)
            - tree.stream-bound(row.last)
            - false
            - cursor
            - failed
        . item = facts.node-type(unit.reading, id)
        if item != no-type && item != types.string-type
            = StreamPart(ranged, Typed(stream-item(run, id, cursor), item))
        = bare-part(ranged)
    | .node-stream-predicate(row)
        = stream-predicate(run, id, row.predicate, cursor, failed)
    | .node-stream-equality(row)
        if facts.plan-of(unit.reading, id) == .plan-pattern-call
            = pattern-call(run, id, row.value, cursor, failed)
        if facts.plan-of(unit.reading, id) == .plan-case
            = stream-case-item(run, id, cursor, failed)
        if facts.node-type(unit.reading, id) != types.string-type
            = stream-dynamic-item(run, id, row.value, cursor, failed)
        = bare-part(stream-dynamic-text(run, id, row.value, cursor, failed))
    | .node-stream-type(row)
        = stream-type-part(run, id, row.type, cursor, failed)
    | .node-stream-and
        = stream-sequence(run, id, cursor, failed)
    | .node-stream-or
        = stream-choice(run, id, cursor, failure-of(run, id, cursor, failed))
    | .node-stream-capture(row)
        = stream-capture(run, id, row.name, row.pattern, cursor, failed)
    | .node-stream-transform(row)
        if row.pattern != 0 && tree.lazies-only(row.right)
            = emit-stream-part(run, row.pattern, cursor, failed)
    | .node-stream-unary(row)
        if row.op == .zero-or-one-op
            = stream-optional(run, id, row.operand, cursor)
        if row.op == .zero-or-more-op
            = stream-repeat
                - run
                - id
                - row.operand
                - 0
                - U64.max
                - cursor
                - failed
                - is-scanned(tree, row.operand)
        if row.op == .one-or-more-op
            = stream-repeat
                - run
                - id
                - row.operand
                - 1
                - U64.max
                - cursor
                - failure-of(run, id, cursor, failed)
                - is-scanned(tree, row.operand)
        if facts.plan-of(unit.reading, id) == .plan-stream-guard
            . missed = failure-of(run, id, cursor, failed)
            = bare-part(stream-guard(id, row.operand, row.op == .positive-lookahead-op, cursor, missed))
        if row.op == .positive-lookahead-op || row.op == .negative-lookahead-op
            . looked = stream-lookahead
                - run
                - id
                - row.operand
                - row.op == .positive-lookahead-op
                - cursor
                - failure-of(run, id, cursor, failed)
            = bare-part(looked)
    | .node-stream-length(row)
        . most-at = if row.max != 0 then row.max else row.min
        . least-at = if tree.literal-bound(row.min) then 0 else row.min
        . limit-at = if tree.literal-bound(most-at) then 0 else most-at
        . short = if least-at != 0 || tree.stream-bound(row.min) != 0 then failure-of(run, id, cursor, failed) else failed
        = stream-repeat
            - run
            - id
            - row.operand
            - tree.stream-bound(row.min)
            - tree.stream-bound(most-at)
            - cursor
            - short
            - false
            - least-at
            - limit-at
refuse(.refused-expression, id)
= bare-part(cursor)

────────────────────
+ do observed-failure IRBlockId
    - id SyntaxId
    - cursor Operand
    - failed IRBlockId

` Where a part tried from a cursor goes where it fails, under a helper that observes the literal
` words a pattern matches: a block that tells the helper to forget the words it was told of
` that end past the cursor, then goes to `failed`, as the reference does where any part of its
` own fails but an arm that raises. The items a repeat scans, and alternatives the reference
` tests as one item, are no parts of their own there. What is emitted next goes on past it.
if streaming.observer-row == U32.max || scanning || streaming.classing || !tree.observes(id)
    = failed
. missed = ir.reserve-block()
. onward = ir.reserve-block()
jump(onward)
ir.start-block(missed)
rewind-literals(id, cursor)
jump(failed)
ir.start-block(onward)
= missed

────────────────────
+ do lowered-part SyntaxId
    - id SyntaxId

` The part the reference takes for a part of a pattern: the one that a part that only declares
` lazy locals is around.
do match? tree.nodes[id]
    | .node-stream-transform(row)
        if row.pattern != 0 && tree.lazies-only(row.right)
            = lowered-part(row.pattern)
= id

────────────────────
_ do rewind-literals
    - site SyntaxId
    - cursor Operand

` Tells the helper that observes literal words to forget those it was told of that end past a
` cursor.
. row = facts.observer-bodies[streaming.observer-row]
call-protocol(site, row.rewind, streaming.pattern-helper, streaming.pattern-helper-type, cursor, types.index-type)

────────────────────
_ do record-literals
    - run StreamRun
    - site SyntaxId
    - text String
    - cursor Operand

` Tells the helper that observes literal words of each word of lowercase letters in a text the
` pattern matched from a cursor, by where it starts and ends in the input, as the reference finds
` them: a letter, then letters and hyphens, where no letter is uppercase. The items a repeat
` scans, and alternatives the reference tests as one item, are no literals there. Where the
` buffer is UTF-8, where a word lies counts the bytes of the characters before it.
if streaming.observer-row == U32.max || scanning || streaming.classing
    =
. row = facts.observer-bodies[streaming.observer-row]
. points = text.codepoints
. offsets [U64]
. offset U64
for point in points
    offsets += offset
    offset += if encodes(run) then utf8-width(point) else 1
offsets += offset
. index Size = 0
while index < points.size
    if !is-word-letter(points[index])
        index += 1
        continue
    . lowercase = is-lowercase-letter(points[index])
    . end = index + 1
    while end < points.size && (is-word-letter(points[end]) || points[end] == '-')
        if is-word-letter(points[end]) && !is-lowercase-letter(points[end])
            lowercase = false
        end += 1
    if lowercase
        . start-at = stream-advance(run, site, cursor, offsets[index])
        . end-at = stream-advance(run, site, cursor, offsets[end])
        call-protocol
            - site
            - row.record
            - streaming.pattern-helper
            - streaming.pattern-helper-type
            - start-at
            - types.index-type
            - true
            - end-at
            - types.index-type
    index = end

────────────────────
+ inlined-rule RuleTarget
    - run StreamRun
    - id SyntaxId
    - result TypeId
    - spanned Bool

` The rule a module declares that a call runs where it is called, with the module that declares
` it and the instance that reads it: one given only the stream, read through a view of items of
` the type the pattern reads, that raises no errors, takes no helper and holds no rollback mark,
` whose pattern is plain as `plain-part` says, and whose arms join as the type the call gives
` where the call gives what they give. No pattern for any other call.
|? fact == no-fact || callee == no-instance || row.is-partial || row.fills.count != 1
    none
|? signature.args.count != 1 || signature.errors.count != 0 || instances.rows[callee].helper != no-type || instances.rows[callee].carries-mark || !types.is-optional(signature.returns)
    none
|? !spanned && types.optional-inner(signature.returns) != result
    none
|? target.pattern == 0 || target.owner != callee || !plain-part(program.modules[target.module].tree, target.pattern)
    none
|? buffer == no-type || class-arg(types, buffer, 0) != class-arg(types, run.buffer-type, 0)
    none
??
    target

.. none = RuleTarget(unit.source-module, unit.reading, 0)
.. fact = own-call(id)
.. row = facts.calls[fact]
.. callee = row.callee
.. signature = instances.signatures[callee]
.. target = rule-target(unit.source-module, unit.reading, id)
.. buffer = rule-buffer(callee)

────────────────────
_ do rule-buffer TypeId
    - rule InstanceId

` The buffer of the view a rule a module declares reads its stream through, as the type pass
` recorded it at the rule's declaration.
do match? program.modules[instances.rows[rule].module].decls[instances.rows[rule].decl]
    | .decl-function(fn)
        = facts.node-type(rule, fn.syntax)
= no-type

────────────────────
_ do plain-part Bool
    - syntax AST
    - id SyntaxId

` Whether a part of a pattern reads only the items it matches and gives only the text it
` matched: text, ranges and any item, and sequences, choices, optionals, repeats with written
` bounds and lookaheads of those.
do match? syntax.nodes[id]
    | .node-stream-string
        = true
    | .node-stream-any
        = true
    | .node-stream-char-range
        = true
    | .node-stream-and(row)
        = plain-part(syntax, row.left) && plain-part(syntax, row.right)
    | .node-stream-or(row)
        = plain-part(syntax, row.left) && plain-part(syntax, row.right)
    | .node-stream-unary(row)
        . plain-op = may-skip || row.op == .one-or-more-op || positive-look || negative-look
            .. may-skip = row.op == .zero-or-one-op || row.op == .zero-or-more-op
