      (call refuse .refused-expression site)
      (return (call Typed nothing no-type))
    )
    (lazy uncarried (and (!= fn no-type) (call carries fn) (== carried no-type)))
    (lazy uncaught-panic (and (not (. function may-panic)) (not in-landing)))
