  (fn-do _ writes-attributes Bool
    (param id SyntaxId)
    ; Whether the body of a markup element gives its constructor an attribute: a line that assigns
    ; and declares no style.
    (match? ([] (. tree nodes) id)
      (case (call .node-markup element)
        (match? ([] (. tree nodes) (. element body))
          (case (call .node-block block)
            (for (in statement ([] (. tree children) (. block body)))
              (if (and (is ([] (. tree nodes) statement) .node-assign) unstyled)
                (return true)
              )
              (lazy unstyled (not (call (. facts style-declaration-of) (. unit reading) statement)))
            )
          )
        )
      )
    )
    (return false)
  )
  (fn-do + fills-content Bool :get
    ; Whether the function being emitted fills an object with the markup written in its class.
    (if (or (!= (. function kind) .instance-body) (== (. unit instance) no-instance))
      (return false)
    )
    (let row ([] (. instances rows) (. unit instance)))
    (match? ([] (. ([] (. program modules) (. row module)) decls) (. row decl))
      (case (call .decl-function fn)
        (return (. fn is-content))
      )
    )
    (return false)
  )
  (fn-do _ builds-outlet Bool
    (param id SyntaxId)
