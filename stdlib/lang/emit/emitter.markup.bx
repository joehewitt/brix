    (if (!= layout (. tables layouts function-layout))
      (call refuse .refused-expression site)
      (return (call Typed nothing no-type))
    )
    (let code (call load source 0 pointer-layout site))
    (let data (call load source (. (call (. tables layouts field) layout 1) offset) managed-layout site))
    (let mark (. pending length))
    (+= pending data)
    (if item
