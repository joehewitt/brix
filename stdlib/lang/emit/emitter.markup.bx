(import ./emitter)
(import ./emitter.assignments)
(import ./emitter.calls)
(import ./emitter.live-actions)
(import ./emitter.styles)
(import ./layouts)
(import ./program-tables)
(import ./receiver-stability)
(import ./runtime)
(import ./table-layouts)
(import /core/arena)
(import /core/table)
(import /lang/ast/ast)
(import /lang/ast/ast-children)
(import /lang/ast/ast-nodes)
(import /lang/ast/ast-queries)
(import /lang/ast/decl)
(import /lang/ast/module)
(import /lang/ast/operator)
(import /lang/ast/program)
(import /lang/ast/row-range)
(import /lang/ast/state-machines)
(import /lang/backend/mir)
(import /lang/check/binding)
(import /lang/check/claims)
(import /lang/check/facts)
(import /lang/check/instances)
(import /lang/check/machine-composite)
(import /lang/check/numeric)
(import /lang/check/pattern-helper)
(import /lang/check/probe-casts)
(import /lang/check/table-rows)
(import /lang/check/type-signature)
(import /lang/check/type-store)
(import /lang/check/type-text)
(import /lang/check/types)
(import /lang/ir/ir)
(import /stream/sort)

(type _ Markup (facet-of FunctionEmitter)
  (sees Assignments)
  (sees Calls)
  (sees LiveActions)
  (sees Styles)
  (fn-do + emit-content _
    (param id SyntaxId)
    (param link ContentLink)
    ; A line of a markup element's body that the element takes: its value is evaluated, takes
    ; the conversion recorded for it as an argument, and is given to the method the type pass
    ; found for it, called on the element whose body is being run. What the method answers is
    ; dropped, but where the line is an element a name is declared for: the name then holds the
    ; answer, converted as a value assigned to it. A line that is a markup branch region or a
    ; markup loop region is the region, whose action is made once the element has taken it. A line
    ; whose value read something tracked is evaluated while a live action of its own is open, whose
    ; trackers note what it reads, and the action is made once the element has taken the value, as
    ; that of an attribute is (`give-again`), and what the element took of it is kept for the action
    ; to replace (`keep-taken`). An element named for the property its class's markup declares for
    ; it, which no local is declared for, gives the property what the element took it as, or the
    ; object where that is nothing; one a local is declared for gives it what the local holds, which
    ; the environment of a function the element is written in may keep. A slot outlet that is a
    ; branch region is written at its parameter (`region-site`).
    (let site (call (. tree region-site) id))
    (let region (call (. facts branch-region-of) (. unit reading) site))
    (let looped (call (. facts loop-region-of) (. unit reading) id))
    (let live (only-if (call (. tables live-statement-of) (. unit reading) id) (if (and (not region) (not looped) (not rerunning) (== (. unit reading) (. unit instance))))))
    (let trackers no-local)
    (let made (call Typed (call make-operand .operand-void 0) no-type))
    (if region
      (= made (call emit-branch site region))
      (else-if looped
        (= made (call emit-loop id looped))
      )
      (else-if live
        (= trackers (call open-trackers id))
        (+= live-actions (call LiveTrackers trackers trackers))
        (= made (call emit-expression id))
        (call (. live-actions pop))
      )
      (else
        (= made (call emit-expression id))
      )
    )
    (let converted (call convert id .reason-argument made))
    (let top (. content-hosts length))
    (if (or (== top 0) (!= (. ([] content-hosts (- top 1)) type) (. link parent)))
      (call refuse .refused-statement id)
      (return)
    )
    (if (!= (. converted type) (. link taken))
      (call refuse .refused-conversion id)
      (return)
    )
    (let answer
      (call call-protocol
        (block
          (arg id)
          (arg (. link call))
          (arg (. ([] content-hosts (- top 1)) operand))
          (arg (. link parent))
          (arg (. converted operand))
          (arg (. link taken))
        )
      )
    )
    (if (!= (. link append) no-instance)
      (let mark (. pending length))
      (+= pending (. ([] content-hosts (- top 1)) operand))
      (+= pending (. answer operand))
      (call call-instance (. link append) id mark)
    )
    (let answered (. answer type))
    (if live
      (let whole (or (!= (. link append) no-instance) (!= answered (. types void-type))))
      (call keep-taken id (. (if-expr whole answer made) operand) (if-expr whole answered (. made type)))
    )
    (if live
      (call give-again id trackers (. ([] content-hosts (- top 1)) operand) (. link parent))
      (return)
    )
    (if region
      (call own-branch site region (. made operand))
      (return)
    )
    (if looped
      (call own-loop id looped (. made operand))
      (return)
    )
    (if (== (. link answers) no-type)
      (let named (call (. facts named-store-of) (. unit reading) id))
      (if (!= named (. U32 max))
        (match? ([] (. tree nodes) id)
          (case (call .node-markup row)
            (if (not (call declares-element id (. row id)))
              (let gives (and (!= answered no-type) (!= answered (. types void-type))))
              (call store-named id named (if-expr gives answer made))
              (return)
            )
            (let slot (call local-slot (. row id) id true false true))
            (let outer (and (call is-captured slot) (!= ([] (. tables slot-functions) slot) (. unit own-scope))))
            (let held (if-expr outer (. (call find-captured slot id) type) (call (. facts slot-type) (. unit instance) (call slot-offset slot id))))
            (let kept (if-expr outer (call read-captured slot id held) (call slot-value slot id held)))
            (call store-named id named (call Typed (. kept operand) held))
          )
        )
      )
    )
    (if (== (. link answers) no-type)
      (return)
    )
    (if (!= answered (. link answers))
      (call refuse .refused-conversion id)
      (return)
    )
    (let raw answer)
    (= answer (call convert id .reason-assignment answer))
    (match? ([] (. tree nodes) id)
      (case (call .node-markup row)
        (let slot (call local-slot (. row id) id true false true))
        (if (and (call is-captured slot) (!= ([] (. tables slot-functions) slot) (. unit own-scope)))
          (call keep-captured slot (. answer operand) (. answer type) id)
          (else
            (call keep-state slot (. answer operand) (. answer type) id)
          )
        )
      )
    )
    (let named (call (. facts named-store-of) (. unit reading) id))
    (if (!= named (. U32 max))
      (call store-named id named raw)
    )
  )
  (fn-do _ emit-branch Typed
    (param id SyntaxId)
    (param region BranchRegion)
    ; A markup branch region: the function of each arm, made the `MarkupBranchBuilder` recorded at
    ; the arm, in a list made at the `if`; the index of the arm whose condition holds, read while a
    ; live action of the region's own is open, whose trackers are kept to make the action with once
    ; the element has taken the region; and the region the markup runtime makes of them for the
    ; element being built. The batch in force is kept first for the arms, which the region builds as
    ; it is made, and the region is put under the batch found for the host. The arms of a match
    ; region read its subject again where the host is kept, which is first done here.
    (let nothing (call make-operand .operand-void 0))
    (let top (. content-hosts length))
    (if (or (== top 0) (!= (. ([] content-hosts (- top 1)) type) (. region host)))
      (call refuse .refused-statement id)
      (return (call Typed nothing no-type))
    )
    (if (. region rooted)
      (call keep-batch id)
    )
    (if (is ([] (. tree nodes) id) .node-match-expression)
      (call keep-captured (call channel-slot id) (. ([] content-hosts (- top 1)) operand) (. region host) id)
    )
    (let start (. given length))
    (let count U32)
    (for (in arm (call (. tree region-arms) id))
      (let built (call convert arm .reason-markup-arm (call emit-closure (call (. tree region-arm-body) arm))))
      (+= given (call Typed (call apart built arm true) (. built type)))
      (+= count 1)
    )
    (let list nothing)
    (= list (. (call build-list id (call (of RowRange SyntaxId) 0 count) (. region list) start false) operand))
    (call drop-given start)
    (let trackers (call open-trackers id))
    (+= live-actions (call LiveTrackers trackers trackers))
    (let selected (call emit-arm-index id (. region selected)))
    (call (. live-actions pop))
    (let mark (. pending length))
    (+= pending (. ([] content-hosts (- top 1)) operand))
    (+= pending list)
    (+= pending (. selected operand))
    (let made (call raising-call id (. region create) mark))
    (call put-under-batch
      (block
        (arg id)
        (arg (. region ensure))
        (arg (. region hosted))
        (arg (. made operand))
        (arg (. ([] (. instances signatures) (. region create)) returns))
      )
    )
    (+= branch-trackers trackers)
    (return (call Typed (. made operand) (. ([] (. instances signatures) (. region create)) returns)))
  )
  (fn-do _ own-branch _
    (param id SyntaxId)
    (param region BranchRegion)
    (param made Operand)
    ; The action of a markup branch region, once the element has taken the region: the element and
    ; the region are kept in the locals no name reaches declared at the `if`, for the function that
    ; selects the arm again, and the action, made by the markup runtime with the trackers the
    ; conditions noted and a callback that runs that function with the environment in force here,
    ; given the element as the host, or the batch found for it where the type pass found one, is
    ; owned by the element and marked structural.
    (let trackers ([] branch-trackers (- (. branch-trackers length) 1)))
    (call (. branch-trackers pop))
    (let slot (call channel-slot id))
    (let code ([] (. tables instance-functions) (. region updater)))
    (let top (. content-hosts length))
    (if (or (== slot no-slot) (== code no-function) (== top 0))
      (call refuse .refused-statement id)
      (return)
    )
    (let host (. ([] content-hosts (- top 1)) operand))
    (call keep-captured slot host (. region host) id)
    (call keep-captured (+ slot 1) made (. ([] (. instances signatures) (. region create)) returns) id)
    (let callback (call make-callback (call (. tables live-adapter-of) code) (call written-environment id) id))
    (let owner
      (block
        (case? (or (. region rooted) (. region hosted))
          (call region-batch id (. region hosted))
        )
        (default
          (. (call convert id .reason-markup-host (call Typed host (. region host))) operand)
        )
      )
    )
    (let mark (. pending length))
    (+= pending (call load-local trackers id))
    (+= pending callback)
    (+= pending owner)
    (let action (call raising-call id (. region action) mark))
    (call attach-action host (. action operand) id)
    (let marking (. pending length))
    (+= pending (. action operand))
    (+= pending (. (call structural-owner id host (. region host) (. region structural)) operand))
    (do
      (inline (call raising-call id (. region structural) marking))
    )
  )
  (fn-do _ emit-loop Typed
    (param id SyntaxId)
    (param region LoopRegion)
    ; A markup loop region: the container, read while a live action of the region's own is open,
    ; whose trackers are kept to make the action with once the element has taken the region, and
    ; converted to the source the type pass recorded at the container where it is no collection; the
    ; function that builds each row, made the builder recorded at the `for`, and that keys it, where
    ; the loop is keyed, made the `MarkupKeyBuilder` recorded at its clause; and the region the
    ; markup runtime makes of them for the element being built. The batch in force is kept first for
    ; the rows, which the region builds as it is made, and the region is put under the batch found
    ; for the host.
    (let nothing (call make-operand .operand-void 0))
    (let top (. content-hosts length))
    (let container (call (. tree region-container) id))
    (if (or (== top 0) (!= (. ([] content-hosts (- top 1)) type) (. region host)) (== container 0))
      (call refuse .refused-statement id)
      (return (call Typed nothing no-type))
    )
    (if (. region rooted)
      (call keep-batch id)
    )
    (let trackers (call open-trackers id))
    (+= live-actions (call LiveTrackers trackers trackers))
    (let source (call emit-expression container))
    (call (. live-actions pop))
    (if (!= (. source type) (. region source))
      (= source (call convert container .reason-argument source))
    )
    (if (!= (. source type) (. region source))
      (call refuse .refused-conversion container)
      (return (call Typed nothing no-type))
    )
    (match? ([] (. tree nodes) id)
      (case (call .node-for-block row)
        (let built (call convert id .reason-markup-row (call emit-closure (. row body))))
        (if (!= (. region adapts) no-instance)
          (let filter (call (. tree when-clause) (. row loop)))
          (let tester
            (block
              (case? (!= filter 0)
                (. (call convert filter .reason-markup-key (call emit-closure filter)) operand)
              )
              (default
                nothing
              )
            )
          )
          (let adapting (. pending length))
          (+= pending (. ([] content-hosts (- top 1)) operand))
          (+= pending (. built operand))
          (if (!= filter 0)
            (+= pending tester)
          )
          (= built (call raising-call id (. region adapts) adapting))
        )
        (let keyed (call (. tree keyed-clause) (. row loop)))
        (let keyer
          (block
            (case? (!= keyed 0)
              (. (call convert keyed .reason-markup-key (call emit-closure keyed)) operand)
            )
            (default
              nothing
            )
          )
        )
        (let mark (. pending length))
        (+= pending (. ([] content-hosts (- top 1)) operand))
        (+= pending (. built operand))
        (if (!= keyed 0)
          (+= pending keyer)
        )
        (+= pending (. source operand))
        (let made (call raising-call id (. region create) mark))
        (call put-under-batch
          (block
            (arg id)
            (arg (. region ensure))
            (arg (. region hosted))
            (arg (. made operand))
            (arg (. ([] (. instances signatures) (. region create)) returns))
          )
        )
        (+= branch-trackers trackers)
        (return (call Typed (. made operand) (. ([] (. instances signatures) (. region create)) returns)))
      )
    )
    (call refuse .refused-statement id)
    (return (call Typed nothing no-type))
  )
  (fn-do + emit-selector _
    (param declared SyntaxId)
    (param id SyntaxId)
    (let live (. instances live))
    (if (or (== (. live previous) no-instance) (== (. live next) no-instance))
      (call refuse .refused-function declared)
      (return)
    )
    (let previous (call (. ir add-local) managed-layout))
    (call store-local previous (. (call call-instance (. live previous) id (. pending length)) operand) id)
    (let next (call (. ir add-local) managed-layout))
    (call store-local next (. (call call-instance (. live next) id (. pending length)) operand) id)
    (+= live-actions (call LiveTrackers previous next))
    (let selected (call emit-arm-index id returns-type))
    (call (. live-actions pop))
    (call return-value (. selected operand) declared)
  )
  (fn-do + emit-row-region _ (?! Refused)
    (param declared SyntaxId)
    (param body SyntaxId)
    (let parent (call make-operand .operand-argument 2))
    (let type (call (. instances argument-type) (. unit instance) 1))
    (let batch (call make-operand .operand-void 0))
    (let root (call (. facts region-root-of) (. unit reading) body))
    (if root
      (= batch (. (call read-captured (. root slot) body (. root batch)) operand))
      (if (!= (. root ensure) no-instance)
        (let host (call convert body .reason-markup-host (call Typed parent type)))
        (let given (call convert-from body .reason-markup-root batch))
        (let mark (. pending length))
        (+= pending (. host operand))
        (+= pending (. given operand))
        (call call-instance (. root ensure) body mark)
      )
    )
    (+= content-hosts (call Typed parent type))
    (+= content-roots batch)
    (call emit-block body)
    (call (. content-hosts pop))
    (call (. content-roots pop))
    (call emit-end declared)
  )
  (fn-do _ own-loop _
    (param id SyntaxId)
    (param region LoopRegion)
    (param made Operand)
    ; The action of a markup loop region, once the element has taken the region: the element and the
    ; region are kept in the locals no name reaches declared at the `for`, for the function that reads
    ; the container again, and the action, made by the markup runtime with the trackers the container
    ; noted and a callback that runs that function with the environment in force here, given the region
    ; as the host, or the batch in force where there is one, is owned by the region and marked
    ; structural.
    (let trackers ([] branch-trackers (- (. branch-trackers length) 1)))
    (call (. branch-trackers pop))
    (let slot (call channel-slot id))
    (let code ([] (. tables instance-functions) (. region updater)))
    (let top (. content-hosts length))
    (if (or (== slot no-slot) (== code no-function) (== top 0))
      (call refuse .refused-statement id)
      (return)
    )
    (let made-type (. ([] (. instances signatures) (. region create)) returns))
    (call keep-captured slot (. ([] content-hosts (- top 1)) operand) (. region host) id)
    (call keep-captured (+ slot 1) made made-type id)
    (let callback (call make-callback (call (. tables live-adapter-of) code) (call written-environment id) id))
    (let owner
      (block
        (case? (. region rooted)
          (call region-batch id false)
        )
        (default
          (. (call convert id .reason-markup-host (call Typed made made-type)) operand)
        )
      )
    )
    (let mark (. pending length))
    (+= pending (call load-local trackers id))
    (+= pending callback)
    (+= pending owner)
    (let action (call raising-call id (. region action) mark))
    (call attach-action made (. action operand) id)
    (let marking (. pending length))
    (+= pending (. action operand))
    (+= pending (. (call structural-owner id made made-type (. region structural)) operand))
    (do
      (inline (call raising-call id (. region structural) marking))
    )
  )
  (fn-do _ structural-owner Typed
    (param id SyntaxId)
    (param owner Operand)
    (param type TypeId)
    (param call InstanceId)
    ; The host that owns the action of a markup region, as the optional the call that marks the
    ; action structural takes: the parent of a branch or the region of a loop, converted where the
    ; type pass recorded it as a markup host, and nothing where it is none.
    (let fact (call (. facts first-conversion) (. unit reading) id))
    (while (!= fact no-fact)
      (if (== (. ([] (. facts conversions) fact) reason) .reason-markup-structural)
        (let host (call convert id .reason-markup-host (call Typed owner type)))
        (return (call convert id .reason-markup-structural host))
      )
      (= fact (. ([] (. facts conversions) fact) next))
    )
    (let optional (call (. types child-type) (. ([] (. instances signatures) call) args) 1))
    (return (call empty-optional optional (call layout-of optional id)))
  )
  (fn-do _ keep-batch _
    (param id SyntaxId)
    ; Keeps the batch in force where a markup region is written in the third local no name
    ; reaches declared at the `if` or `for`, which the functions that build its arms or rows read.
    (let slot (call channel-slot id))
    (let batch
      (scope (if-expr (!= (. content-roots length) 0) outer-root (call make-operand .operand-void 0))
        (lazy outer-root ([] content-roots (- (. content-roots length) 1)))
      )
    )
    (if (or (== slot no-slot) (== (call operand-kind batch) .operand-void))
      (call refuse .refused-statement id)
      (return)
    )
    (let field (call find-captured (+ slot 2) id))
    (call keep-captured (+ slot 2) batch (. field type) id)
  )
  (fn-do _ region-batch Operand
    (param id SyntaxId)
    (param hosted Bool)
    ; The batch found for the host of a markup region: the host itself where it is one, converted at
    ; the `if` or `for`, else the one in force.
    (let nothing (call make-operand .operand-void 0))
    (let top (. content-hosts length))
    (if (and hosted (!= top 0))
      (return (. (call convert id .reason-markup-batch ([] content-hosts (- top 1))) operand))
    )
    (if (or hosted (== (. content-roots length) 0) void-root)
      (call refuse .refused-statement id)
      (return nothing)
    )
    (lazy void-root (== (call operand-kind ([] content-roots (- (. content-roots length) 1))) .operand-void))
    (return ([] content-roots (- (. content-roots length) 1)))
  )
  (fn-do _ put-under-batch _
    (param id SyntaxId)
    (param ensure InstanceId)
    (param hosted Bool)
    (param made Operand)
    (param type TypeId)
    ; Puts the region a markup region made under the batch found for its host, where the type pass
    ; found one, as the markup runtime's `ensure-markup-root` does, given the region as a host and
    ; the batch as the optional it takes.
    (if (== ensure no-instance)
      (return)
    )
    (let batch (call region-batch id hosted))
    (let region (call convert id .reason-markup-region (call Typed made type)))
    (let given (call convert-from id .reason-markup-root batch))
    (let mark (. pending length))
    (+= pending (. region operand))
    (+= pending (. given operand))
    (call call-instance ensure id mark)
  )
  (fn-do + emit-markup Typed
    (param id SyntaxId)
    (param name SyntaxId)
    (param type-id SyntaxId)
    (param args (of RowRange SyntaxId))
    (param body SyntaxId)
    ; A markup element: its object, with the lines of its body run as its content, the object being the
    ; element they are given to. Where it is a statement, the objects of the elements it declares names
    ; for are made first (`raise-elements`). The object of an element a block declares a name for is read
    ; from the name: one this function has not made has no shape. One whose name is placed is made here
    ; and given to the name. A body a function of its own builds into the default slot's node is no
    ; content here.
    (let nothing (call make-operand .operand-void 0))
    (let made nothing)
    (let type no-type)
    (call raise-elements id)
    (if (call (. facts is-raised) (. unit reading) id)
      (let slot (call local-slot name id true false true))
      (if (== (call (. built find) id) null)
        (call refuse .refused-expression id)
        (return (call Typed nothing no-type))
      )
      (= type (call (. facts slot-type) (. unit instance) (call slot-offset slot id)))
      (= made (. (call slot-value slot id type) operand))
      (else
        (let element (call make-element id type-id args))
        (= made (. element operand))
        (= type (. element type))
        (if (call names-placed name)
          (call name-element id name element)
        )
      )
    )
    (let root (call batch-root id type-id (call Typed made type)))
    (if (and (!= body 0) (not (call is-closure (call (. facts node-type) (. unit reading) body))))
      (+= content-hosts (call Typed made type))
      (+= content-roots root)
      (call emit-block body)
      (call (. content-hosts pop))
      (call (. content-roots pop))
    )
    (call mount-root id type-id made type root)
    (return (call Typed made type))
  )
  (fn-expr _ declares-element Bool
    (param element SyntaxId)
    (param name SyntaxId)
    ; Whether a block declares a local for a markup element's name, in the function whose facts
    ; are being read.
    (case? (== binding no-binding)
      false
    )
    (default
      (and (== (. resolution kind) .resolve-slot) (== (. ([] (. bindings slots) (. resolution slot)) group) element))
    )
    (where
      (lazy binding (. ([] (. instances rows) (. unit reading)) binding))
      (lazy resolution (call (. bindings resolution-of) binding name))
    )
  )
  (fn-expr _ names-placed Bool
    (param name SyntaxId)
    ; Whether a markup element's name is placed: given the element's object where the element is
    ; written, as no block made it where it starts.
    (case? (or (== name 0) (== binding no-binding))
      false
    )
    (default
      (and (== (. resolution kind) .resolve-slot) (!= (/and/ (. ([] (. bindings slots) (. resolution slot)) flags) (. SlotFlag slot-placed)) 0))
    )
    (where
      (lazy binding (. ([] (. instances rows) (. unit reading)) binding))
      (lazy resolution (call (. bindings resolution-of) binding name))
    )
  )
  (fn-do _ batch-root Operand
    (param id SyntaxId)
    (param type-id SyntaxId)
    (param made Typed)
    ; The batch of markup in force in the body of a markup element, a `MarkupRootElement`: the element
    ; itself where its class is a batch, else the one in force where the element is written, if
    ; any. An element of a markup host is put under it first, given as the `MarkupRootElement?` the
    ; markup runtime takes.
    (let nothing (call make-operand .operand-void 0))
    (let inherited (if-expr (!= (. content-roots length) 0) ([] content-roots (- (. content-roots length) 1)) nothing))
    (let root (call (. facts element-root-of) (. unit reading) id))
    (if (not root)
      (return inherited)
    )
    (let batch inherited)
    (if (. root owns)
      (= batch (. (call convert type-id .reason-markup-batch made) operand))
    )
    (if (!= (. root ensure) no-instance)
      (if (== (call operand-kind batch) .operand-void)
        (call refuse .refused-expression id)
        (return nothing)
      )
      (let host (call convert type-id .reason-markup-host made))
      (let given (call convert-from type-id .reason-markup-root batch))
      (let mark (. pending length))
      (+= pending (. host operand))
      (+= pending (. given operand))
      (call call-instance (. root ensure) id mark)
    )
    (return batch)
  )
  (fn-do _ mount-root _
    (param id SyntaxId)
    (param type-id SyntaxId)
    (param made Operand)
    (param type TypeId)
    (param batch Operand)
    ; Mounts a markup element that is no line of another as a root of the batch in force, once
    ; its body has run.
    (let root (call (. facts element-root-of) (. unit reading) id))
    (if (or (not root) (== (. root mount) no-instance))
      (return)
    )
    (if (== (call operand-kind batch) .operand-void)
      (call refuse .refused-expression id)
      (return)
    )
    (let host (call convert type-id .reason-markup-host (call Typed made type)))
    (let given (call convert-from type-id .reason-markup-root batch))
    (let mark (. pending length))
    (+= pending (. host operand))
    (+= pending (. given operand))
    (call call-instance (. root mount) id mark)
  )
  (fn-do + raise-elements _
    (param block SyntaxId)
    ; Makes the object of each named markup element the type pass kept for a block of markup content,
    ; where it starts, or for a statement, where it runs, in order, and declares the element's name as
    ; a local that holds it.
    (let raised (call (. facts first-raised) (. unit reading) block))
    (while (!= raised (. U32 max))
      (let fact ([] (. facts raised-elements) raised))
      (call raise-element (. fact element))
      (= raised (. fact next))
    )
  )
  (fn-do + raise-element _
    (param element SyntaxId)
    ; Makes the object of a named markup element and declares its name as a local that holds it.
    (match? ([] (. tree nodes) element)
      (case (call .node-markup row)
        (let made (call make-element element (. row type-id) (. row args)))
        (call name-element element (. row id) made)
      )
    )
  )
  (fn-do _ name-element _
    (param element SyntaxId)
    (param name SyntaxId)
    (param made Typed)
    ; Gives the name of a markup element its cell and stores the element's object there, as a
    ; declaration of a local with that value does: one some read tracks tells no read of it. A
    ; name a function this one is written in declares is kept in its environment.
    (let slot (call local-slot name element true false true))
    (let offset (call slot-offset slot element))
    (let type
      (block
        (case? (and (call is-captured slot) (!= ([] (. tables slot-functions) slot) (. unit own-scope)))
          (. (call find-captured slot element) type)
        )
        (default
          (call (. facts slot-type) (. unit instance) offset)
        )
      )
    )
    (if (or (== type no-type) (== type invalid-type) (!= type (. made type)))
      (call refuse .refused-statement element)
      (return)
    )
    (let layout (call layout-of type element))
    (+= built element)
    (if (call is-captured slot)
      (call keep-captured slot (. made operand) type element)
      (return)
    )
    (let local (call (. ir add-local) layout (!= (/and/ (. ([] (. bindings slots) slot) flags) (. SlotFlag slot-address-taken)) 0)))
    (= ([] (. unit cells) offset) local)
    (call store-local local (. made operand) element)
  )
  (fn-do _ make-element Typed
    (param id SyntaxId)
    (param type-id SyntaxId)
    (param args (of RowRange SyntaxId))
    ; The object of a markup element, as its constructor makes it for its arguments and its
    ; attributes.
    ; 1. The constructor is called as a call written with the arguments is: an attribute that
    ;    names a parameter fills it, and the value of each other attribute is given after the
    ;    arguments. Each argument is kept as it was evaluated, before the call converted it, and
    ;    each attribute as given: converted to the property's type, and then, where it fills a
    ;    parameter, to the parameter's, as the call converted it.
    ;    The values given to the style rules written on the element are evaluated after the
    ;    attributes, before the call (`emit-rule-values`).
    ; 2. The object is kept for the functions that read its members by name alone, the gates of
    ;    the style rules written on it among them (`keep-element`). The state cells of the `when`s
    ;    around the rules written in rules the element sees, made before the call (`make-cells`),
    ;    are bound (`bind-cells`). The style rules the element applies run, then each attribute
    ;    that declares a style property declares it, in the order written.
    ; 3. Each value the type pass bound to a property is stored in the property: the
    ;    attributes, then the arguments, each in the order written. An argument takes the
    ;    conversion recorded for it as a value assigned. An attribute a setter answers is given
    ;    to the setter instead, in its place among them. Then the element's style site, if it has
    ;    one, is made ready.
    ; 4. Each attribute whose value read something tracked is given a live action, in the order
    ;    written, owned by the object, which gives it again: the object is kept where that
    ;    function reaches it. Then each argument given by position whose value did, so.
    (let nothing (call make-operand .operand-void 0))
    (let own-styling styling)
    (let start (. element-given length))
    (let filling (. element-filled length))
    (let setting (. setter-given length))
    (let valued (. rule-givens length))
    (let lively (. attribute-trackers length))
    (let arguing (. argument-trackers length))
    (= styling (= (. styling element) (if-expr (or (!= (call (. facts first-element-store) (. unit reading) id) (. U32 max)) (call writes-attributes id)) id 0)))
    (= styling (= (. styling valued) (if-expr (call gives-rule-values id) id 0)))
    (call make-cells id)
    (let made (call emit-call id type-id args))
    (let type (. made type))
    (= styling own-styling)
    (call keep-element id (. made operand) type)
    (call bind-cells id (. made operand))
    (let association (call declare-styles id (. made operand) type))
    (while (> (. rule-givens length) valued)
      (call (. rule-givens pop))
    )
    (let store (call (. facts first-element-store) (. unit reading) id))
    (while (!= store (. U32 max))
      (let fact ([] (. facts element-stores) store))
      (let place (+ start (. fact argument)))
      (if (!= (. fact setter) 0)
        (call set-attribute (. fact setter) (. made operand) type (+ setting (. fact argument)))
        (else-if (>= place (. element-given length))
          (call refuse .refused-expression id)
        )
        (else
          (let stored ([] element-given place))
          (if (!= (. fact converted) 0)
            (= stored (call convert (. fact converted) .reason-assignment stored))
          )
          (call store-argument (. made operand) type (. fact property) (. stored operand) (. stored type) id)
        )
      )
      (= store (. fact next))
    )
    (while (> (. element-given length) start)
      (call (. element-given pop))
    )
    (while (> (. element-filled length) filling)
      (call (. element-filled pop))
    )
    (while (> (. setter-given length) setting)
      (call (. setter-given pop))
    )
    (call finish-styles id (. made operand) type association)
    (for (in position (..< lively (. attribute-trackers length)))
      (call give-again
        (block
          (arg (. ([] attribute-trackers position) member))
          (arg (. ([] attribute-trackers position) trackers))
          (arg (. made operand))
          (arg type)
        )
      )
    )
    (for (in position (..< arguing (. argument-trackers length)))
      (call give-again
        (block
          (arg (. ([] argument-trackers position) member))
          (arg (. ([] argument-trackers position) trackers))
          (arg (. made operand))
          (arg type)
        )
      )
    )
    (call follow-bound id (. made operand) type)
    (while (> (. attribute-trackers length) lively)
      (call (. attribute-trackers pop))
    )
    (while (> (. argument-trackers length) arguing)
      (call (. argument-trackers pop))
    )
    (return (call Typed (. made operand) type))
  )
  (fn-do _ follow-bound _
    (param id SyntaxId)
    (param made Operand)
    (param type TypeId)
    ; Gives each binding of a markup element the action that stores back what the element holds as
    ; it changes: its first run only notes the read of the element's property, so that the place
    ; keeps the value it gave the element.
    (match? ([] (. tree nodes) id)
      (case (call .node-markup element)
        (match? ([] (. tree nodes) (. element body))
          (case (call .node-block block)
            (for (in statement ([] (. tree children) (. block body)))
              (match? ([] (. tree nodes) statement)
                (case (call .node-assign attribute)
                  (if (== (. attribute op) .bind-op)
                    (let name (call (. tree identifier-name) (. attribute lhs)))
                    (if (not name)
                      (call refuse .refused-statement statement)
                      (return)
                    )
                    (let trackers (call open-trackers (. attribute lhs)))
                    (+= live-actions (call LiveTrackers trackers trackers))
                    (call track (. attribute lhs) made name)
                    (call (. live-actions pop))
                    (call give-again statement trackers made type (. attribute lhs))
                  )
                )
              )
            )
          )
        )
      )
    )
  )
  (fn-do _ set-attribute _
    (param target SyntaxId)
    (param made Operand)
    (param type TypeId)
    (param place Size)
    ; Gives the object of a markup element, once made, the value of an attribute a setter
    ; answers, kept where it was evaluated, by calling the setter the type pass chose at the
    ; attribute's name.
    (let call (call own-call target))
    (if (or (== call no-fact) (!= (. ([] (. facts calls) call) form) .call-setter) (>= place (. setter-given length)))
      (call refuse .refused-expression target)
      (return)
    )
    (let callee (. ([] (. facts calls) call) callee))
    (if (or (== callee no-instance) (. ([] (. facts calls) call) is-partial) (not (call is-callable callee)) other-arity)
      (call refuse .refused-expression target)
      (return)
    )
    (lazy other-arity (!= (. ([] (. instances signatures) callee) args count) 1))
    (if (!= (. ([] setter-given place) type) (call (. instances argument-type) callee 0))
      (call refuse .refused-conversion target)
      (return)
    )
    (let receiver (call convert target .reason-receiver (call Typed made type)))
    (if (!= (. receiver type) (. ([] (. instances rows) callee) self-type))
      (call refuse .refused-conversion target)
    )
    (let mark (. pending length))
    (+= pending (. receiver operand))
    (+= pending (. ([] setter-given place) operand))
    (call call-method callee target mark)
  )
  (fn-do _ hold-outlet-cells LocalId
    (param id SyntaxId)
    ; Holds, while the function that builds what a slot outlet mounts runs, the state cells the
    ; outlet holds (`OutletCell`), each by where it was made, after a mark of those held already,
    ; which it answers in a local of its own; none where it holds none.
    (let mark no-local)
    (for (in held (. facts outlet-cells))
      (if (or (!= (. held instance) (. unit reading)) (!= (. held outlet) id))
        (continue)
      )
      (let local (call cell-local (. held cell)))
      (if (== local no-local)
        (call refuse .refused-expression id)
        (return no-local)
      )
      (if (== mark no-local)
        (let runtime (. facts style-runtime))
        (= mark (call (. ir add-local) (call layout-of (. ([] (. instances signatures) (. runtime outlet-mark)) returns) id)))
        (call store-local mark (. (call call-instance (. runtime outlet-mark) id (. pending length)) operand) id)
      )
      (let first (. pending length))
      (+= pending (call integer .machine-u32 (call (. tables state-key-number) (. ([] (. facts scope-cells) (. held cell)) key))))
      (+= pending (call load-local local id))
      (do
        (inline (call call-instance (. facts style-runtime outlet-push) id first))
      )
    )
    (return mark)
  )
  (fn-do _ give-again _
    (param statement SyntaxId)
    (param trackers LocalId)
    (param made Operand)
    (param type TypeId)
    (param site SyntaxId (= 0))
    ; The live action of an attribute whose value read something tracked: the element's object
    ; is kept in the local no name reaches declared at the attribute, and the action, with the
    ; trackers the value noted and a callback that runs the attribute's function with the
    ; environment in force here, is owned by the object. That of an argument given by position
    ; keeps the object in the one declared at the element. The action of an element of a markup
    ; host is made by the markup runtime, given the element as its host, or where the type pass
    ; made it with a batch, given the element where it is the batch and else the one in force. That
    ; of a line of the element's body that gives content is made as an attribute's is, and that of a
    ; line of an arm's body is given what the arm's function is given, converted at the line. The
    ; action that stores back what a binding's element holds is made at the `site` it is written at.
    (let at (if-expr (!= site 0) site statement))
    (let row (call (. tables live-statement-of) (. unit reading) at))
    (let element (call (. tree argument-element) statement))
    (let slot (if-expr (!= element 0) (call channel-slot element) (call line-keeper statement)))
    (let code
      (block
        (case? (and row (!= (. row rerun) no-instance))
          ([] (. tables instance-functions) (. row rerun))
        )
        (default
          no-function
        )
      )
    )
    (if (or (== code no-function) (== slot no-slot))
      (call refuse .refused-statement at)
      (return)
    )
    (if (== site 0)
      (call keep-captured slot made type statement)
    )
    (if (== (. (!! row) owned) no-instance)
      (let action
        (call make-action
          (block
            (arg (call load-local trackers at))
            (arg (call (. tables live-adapter-of) code))
            (arg (call written-environment at))
            (arg at)
          )
        )
      )
      (call attach-action made (. action operand) at)
      (return)
    )
    (let callback (call make-callback (call (. tables live-adapter-of) code) (call written-environment at) at))
    (let written (if-expr (!= element 0) element (call (. tree attribute-element) statement)))
    (if (== written 0)
      (= written (call (. tree content-element) statement))
    )
    (let type-id SyntaxId (if-expr (== written 0) statement 0u32))
    (match? ([] (. tree nodes) written)
      (case (call .node-markup row)
        (= type-id (. row type-id))
      )
      (case (call .node-slot-outlet row)
        (= type-id (. row type-id))
      )
    )
    (let owner (call make-operand .operand-void 0))
    (if (. (!! row) rooted)
      (let root (call (. facts element-root-of) (. unit reading) written))
      (if (and root (. root owns))
        (= owner (. (call convert type-id .reason-markup-batch (call Typed made type)) operand))
        (else-if (!= (. content-roots length) 0)
          (= owner ([] content-roots (- (. content-roots length) 1)))
        )
      )
      (if (== (call operand-kind owner) .operand-void)
        (call refuse .refused-statement statement)
      )
      (else
        (= owner (. (call convert type-id .reason-markup-host (call Typed made type)) operand))
      )
    )
    (let mark (. pending length))
    (+= pending (call load-local trackers at))
    (+= pending callback)
    (+= pending owner)
    (let action (call raising-call at (. (!! row) owned) mark))
    (call attach-action made (. action operand) at)
  )
  (fn-do + emit-attributes _
    (param id SyntaxId)
    (param callee InstanceId)
    (param fact CallFact)
    (param count U32)
    ; Evaluates the attributes of a markup element that its constructor is given after its
    ; `count` arguments, in the order written: each takes the conversion recorded at its line as a
    ; value assigned, and is kept. One that names a parameter fills it; the place among the values
    ; kept of each other one is kept too, as the constructor is given those after its parameters.
    ; One whose value reads something tracked is evaluated in a live action of its own, whose
    ; trackers are kept to make the action with. One that declares a style is evaluated once the
    ; object is made, and one a setter answers is kept apart, for the setter (`set-attribute`). One
    ; the constructor is not given at the place it is written at has no shape here.
    (let given U32)
    (let written U32)
    (let declared
      (scope (- unfilled (. ([] (. instances rows) callee) carried) (. ([] (. instances rows) callee) slots count))
        (lazy unfilled (- (. ([] (. instances signatures) callee) args count) (. ([] (. instances rows) callee) fills count)))
      )
    )
    (match? ([] (. tree nodes) id)
      (case (call .node-markup element)
        (match? ([] (. tree nodes) (. element body))
          (case (call .node-block block)
            (for (in statement ([] (. tree children) (. block body)))
              (match? ([] (. tree nodes) statement)
                (case (call .node-assign attribute)
                  (if (call (. facts style-declaration-of) (. unit reading) statement)
                    (continue)
                  )
                  (let setter (call own-call (. attribute lhs)))
                  (if (and (!= setter no-fact) (== (. ([] (. facts calls) setter) form) .call-setter))
                    (let tracked (call (. tables live-statement-of) (. unit reading) statement))
                    (let watching (if-expr tracked (call open-trackers statement) no-local))
                    (if tracked
                      (+= live-actions (call LiveTrackers watching watching))
                    )
                    (let given
                      (call convert
                        (block
                          (arg (. attribute rhs))
                          (arg .reason-argument)
                          (arg (call emit-expression (. attribute rhs)))
                        )
                      )
                    )
                    (if tracked
                      (call (. live-actions pop))
                      (+= attribute-trackers (call LiveMember statement watching))
                    )
                    (+= setter-given (call Typed (call apart given (. attribute rhs) true) (. given type)))
                    (continue)
                  )
                  (let name (call (. tree identifier-name) (. attribute lhs)))
                  (let place
                    (block
                      (case? name
                        (call (. instances fill-argument) callee name)
                      )
                      (default
                        (. U32 max)
                      )
                    )
                  )
                  (let fills (!= (call filled-parameter fact (+ count written)) (. U32 max)))
                  (if (and (not fills) (!= place (+ declared given)))
                    (call refuse .refused-expression statement)
                    (else
                      (let live (call (. tables live-statement-of) (. unit reading) statement))
                      (let trackers (if-expr live (call open-trackers statement) no-local))
                      (if live
                        (+= live-actions (call LiveTrackers trackers trackers))
                      )
                      (let value
                        (call convert
                          (block
                            (arg statement)
                            (arg .reason-assignment)
                            (arg (call emit-expression (. attribute rhs)))
                          )
                        )
                      )
                      (if fills
                        (= value (call convert statement .reason-argument value))
                      )
                      (if live
                        (call (. live-actions pop))
                        (+= attribute-trackers (call LiveMember statement trackers))
                      )
                      (if (not fills)
                        (+= element-filled (as (. element-given length) U32))
                        (+= given 1)
                      )
                      (+= element-given
                        (call Typed
                          (block
                            (arg (call apart value (. attribute rhs) true))
                            (arg (. value type))
                          )
                        )
                      )
                      (+= written 1)
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )
  (fn-do + give-slots _
    (param element SyntaxId)
    (param callee InstanceId)
    ; Gives the constructor of a markup element the function that builds each slot the lines of
    ; its body give content, in the order the constructor takes them (`builder-value`). Making these
    ; runs nothing.
    (let slots (. ([] (. instances rows) callee) slots count))
    (let first (- (. ([] (. instances signatures) callee) args count) slots))
    (for (in offset (..< 0 slots))
      (let name (call (. instances slot-name) callee offset))
      (let line (call slot-line element name))
      (if (== line 0)
        (call refuse .refused-expression element)
        (break)
      )
      (let built (if-expr (call (. tree holds-fills) line) (call emit-choice line name) (call builder-value line)))
      (if (!= (. built type) (call (. instances argument-type) callee (+ first offset)))
        (call refuse .refused-conversion line)
      )
      (+= pending (. built operand))
    )
  )
  (fn-do _ slot-line SyntaxId
    (param element SyntaxId)
    (param name Atom)
    ; The line of a markup element's body that gives the slot of a name content
    ; (`body-slot-line`), or the name of the element for the name of the function that gives the
    ; name its object; or none.
    (match? ([] (. tree nodes) element)
      (case (call .node-markup row)
        (if (== (. name text) binder-slot)
          (return (. row id))
        )
        (return (call body-slot-line (. row body) name))
      )
    )
    (return 0)
  )
  (fn-do + body-slot-line SyntaxId
    (param body SyntaxId)
    (param name Atom)
    ; The line of a body that binds the slot of a name, or that gives the default slot, for the
    ; empty name, element or value, or the body where all of it does, that the type pass made a
    ; function of, or that forwards the slot of the name; or none.
    (let default (== (. name text length) 0))
    (if (== body 0)
      (return 0)
    )
    (if (and default (call is-closure (call (. facts node-type) (. unit instance) body)))
      (return body)
    )
    (match? ([] (. tree nodes) body)
      (case (call .node-block block)
        (for (in statement ([] (. tree children) (. block body)))
          (if (and (not default) (call (. tree fills-name) statement name))
            (return statement)
          )
          (match ([] (. tree nodes) statement)
            (case (call .node-markup line)
              (if (call is-closure (call (. facts node-type) (. unit instance) statement))
                (if (and default (== (. line slot-binding) 0))
                  (return statement)
                )
                (if (and (not default) (!= (. line slot-binding) 0) same-name)
                  (return statement)
                )
                (lazy same-name (== (call (. tree identifier-name) (. line slot-binding)) name))
              )
            )
            (case (call .node-markup-slot-forward line)
              (if (and (not default) (== (call (. tree identifier-name) (. line slot-binding)) name))
                (return statement)
              )
            )
            (default
              (let attribute (is ([] (. tree nodes) statement) .node-assign))
              (if (and default (not attribute) (not (call (. tree holds-fills) statement)) (call is-closure (call (. facts node-type) (. unit instance) statement)))
                (return statement)
              )
            )
          )
        )
      )
    )
    (return 0)
  )
  (fn-do + emit-outlet Operand
    (param id SyntaxId)
    (param name SyntaxId)
    (param body SyntaxId)
    ; A slot outlet, as the function that fills an object with its class's markup mounts it
    ; (`SlotOutlet`): the node the function that builds the slot gives, the argument this function was
    ; given for it, or the local a function written in it reads it from, called, given the item the
    ; outlet names where the slot repeats; or else the one the element its body writes makes, or the
    ; node its lines are built into (`emit-wrapper`), cast to the type of the slot, which the local the
    ; outlet's name declares is given. Then each line of its body that assigns is evaluated, in the
    ; order written, converted as a value assigned to the property it names, and stored there, and the
    ; one whose value read something tracked is given its live action, owned by the node. The rules the
    ; outlet applies and the lines that declare styles declare them for the node first, at the outlet's
    ; own site (`declare-styles`), which is made ready last (`finish-styles`). An outlet that mounts
    ; nothing gives nothing. One built by the function of the arm it is (`builds-outlet`) gives its name
    ; nothing, unless that function builds it alone (`builds-outlet-alone`).
    (let nothing (call make-operand .operand-void 0))
    (let fact (call (. facts slot-outlet-of) (. unit reading) id))
    (if (and fact (!= (. fact chosen) no-instance))
      (return (call emit-chosen-outlet id fact))
    )
    (if (and (call (. tree builds-outlet-alone) id) (not (call builds-outlet id)))
      (call emit-outlet-arm id)
      (return nothing)
    )
    (if (not fact)
      (call refuse .refused-expression id)
      (return nothing)
    )
    (if (and (== (. fact argument) (. U32 max)) (== (. fact held) no-slot) (== (. fact fallback) 0))
      (return nothing)
    )
    (let type (. fact content))
    (let built (call Typed nothing no-type))
    (if (!= (. fact picks) no-type)
      (= built (call emit-picked-outlet id fact type))
      (else-if (or (!= (. fact argument) (. U32 max)) (!= (. fact held) no-slot))
        (let source nothing)
        (let builder no-type)
        (if (!= (. fact argument) (. U32 max))
          (let position (. fact argument))
          (= source (call make-operand .operand-argument (if-expr (. unit takes-self) (+ position 1) position)))
          (= builder (call (. instances argument-type) (. unit instance) position))
          (else
            (= builder (. (call find-captured (. fact held) id) type))
            (= source (. (call read-captured (. fact held) id builder) operand))
          )
        )
