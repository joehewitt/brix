    (if (or (== body 0) (== ([] (. tables captures) (. unit instance)) unbuilt-environment))
      (call refuse .refused-function declared)
      (return)
    )
    (= unit (= (. unit received) true))
    (= unit (= (. unit takes-self) true))
    (call (. ir add-argument) managed-layout)
    (= (. ir returns) void-layout)
    (call open-environment declared)
    (call share-self declared)
    (call emit-block body)
    (call return-nothing)
