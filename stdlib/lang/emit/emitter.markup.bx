  (fn-do _ call-outlet-builder Typed
    (param id SyntaxId)
    (param source Operand)
    (param builder TypeId)
    (param item (? Operand) (= null))
    (let holding (call hold-outlet-cells id))
    (let built (call call-builder id source builder item))
    (if (!= holding no-local)
      (let mark (. pending length))
      (+= pending (call load-local holding id))
