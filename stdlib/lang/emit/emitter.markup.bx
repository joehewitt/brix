    (let kept (call make-operand .operand-argument 0))
    (let hosted (call (. tables layouts field) (. rule kept) 3))
    (let last (call (. tables layouts field) (. rule kept) (if-expr (!= (. found changes) no-type) 5 4)))
    (let optional (. found found))
    (let cursor-type (. ([] (. instances signatures) (. found parent)) returns))
    (let cursor-layout (call layout-of cursor-type site))
    (let prior
      (block
        (case? (call (. tables layouts is-struct) (. last layout))
          (call snapshot (call field-value kept last site) (. last layout) site)
        )
        (default
          (call load kept (. last offset) (. last layout) site)
        )
      )
    )
    (let result (call (. ir add-local) (. last layout)))
    (call store-local result (. (call empty-optional optional (. last layout)) operand) site)
    (let cursor (call (. ir add-local) cursor-layout))
    (let first (. pending length))
    (+= pending (call field-value kept hosted site))
    (call store-local cursor (. (call call-instance (. found parent) site first) operand) site)
    (let test (call (. ir reserve-block)))
    (let body (call (. ir reserve-block)))
    (let next (call (. ir reserve-block)))
    (let ended (call (. ir reserve-block)))
    (call jump test)
    (call (. ir start-block) test)
    (let holds (call present site (call Typed (call load-local cursor site) cursor-type)))
    (call branch (. holds operand) body ended)
    (call (. ir start-block) body)
    (let host (call payload site (call Typed (call load-local cursor site) cursor-type)))
    (let target (call host-object site (. host operand) (. found target) next))
    (call store-local result (. (call wrap site target optional) operand) site)
    (call jump ended)
    (call (. ir start-block) next)
    (let above (call payload site (call Typed (call load-local cursor site) cursor-type)))
    (let again (. pending length))
    (+= pending (. above operand))
    (call store-local cursor (. (call call-instance (. found parent) site again) operand) site)
    (call jump test)
    (call (. ir start-block) ended)
    (let changed (call bits-differ prior (call load-local result site) (. last layout) site))
    (let fires (call (. ir reserve-block)))
    (let done (call (. ir reserve-block)))
    (call branch changed fires done)
    (call (. ir start-block) fires)
    (if (!= (. found changes) no-type)
      (call note-ancestor rule found kept prior true site)
      (call note-ancestor rule found kept (call load-local result site) false site)
    )
    (call keep-rule-value kept last (call load-local result site) site)
    (call mark-trigger rule found kept site)
    (call jump done)
    (call (. ir start-block) done)
    (call return-value changed site)
  )
  (fn-do _ note-ancestor _
    (param rule ClassRule)
    (param trigger MarkupTrigger)
    (param kept Operand)
    (param value Operand)
    (param removes Bool)
    (param site SyntaxId)
    ; Where an ancestor a `whenever ancestor` rule found holds an object, adds it to the changes
    ; the rule names, or to those removed.
    (let optional (. trigger found))
    (let holds (call present site (call Typed value optional)))
    (let noting (call (. ir reserve-block)))
    (let skipped (call (. ir reserve-block)))
    (call branch (. holds operand) noting skipped)
    (call (. ir start-block) noting)
    (let held (call payload site (call Typed value optional)))
    (call note-change rule trigger kept (. held operand) removes site)
    (call jump skipped)
    (call (. ir start-block) skipped)
  )
  (fn-do _ note-change _
    (param rule ClassRule)
    (param trigger MarkupTrigger)
    (param kept Operand)
    (param target Operand)
    (param removes Bool)
    (param site SyntaxId)
    ; Adds an object to the changes a `whenever` rule on the markup an object is in names, as one
    ; added or, with `removes`, one removed: to the list the property of that name holds.
    (if (== (. trigger changes) no-type)
      (return)
    )
    (let object
      (scope (if-expr (call (. tables is-class) (. trigger changes)) object-layout no-layout)
        (lazy object-layout ([] (. tables layouts objects) (. trigger changes)))
      )
    )
    (let place
      (call (. types property-named)
        (block
          (arg (. trigger changes))
          (arg (call (. program store-atom) (if-expr removes "removed" "added")))
        )
      )
    )
    (if (or (== object no-layout) (not place))
      (call refuse .refused-function site)
      (return)
    )
    (let changes (call load kept (. (call (. tables layouts field) (. rule kept) 4) offset) managed-layout site))
    (let field (call (. tables layouts field) object (+ object-header-fields (. ([] (. types properties) place) slot))))
    (let mark (. pending length))
    (+= pending (call load changes (. field offset) (. field layout) site))
    (+= pending target)
    (do
      (inline (call call-method (. trigger record) site mark))
    )
  )
  (fn-do _ mark-trigger _
    (param rule ClassRule)
    (param trigger MarkupTrigger)
    (param kept Operand)
    (param site SyntaxId)
    ; Notes that the markup a `whenever` rule on the markup an object is in looks at changed, and
    ; runs the rule's live action, which runs it where it is due.
    (call store kept (. (call (. tables layouts field) (. rule kept) 1) offset) (call integer .machine-u8 1) false site)
    (let mark (. pending length))
    (+= pending (call load kept (. (call (. tables layouts field) (. rule kept) 2) offset) managed-layout site))
    (do
      (inline (call call-method (. trigger schedule) site mark))
    )
  )
  (fn-do + emit-slot-forward _
    ; The function a line that forwards a slot gives in place of the builder it forwards where it
    ; holds state cells (`SlotForward`), `markup-slot-forward`: given what it keeps, the builder and
    ; the cells, and the item where the slot repeats, it holds the cells (`OutletCell`) while the
    ; builder runs, and answers what the builder answers.
    (let row ([] (. facts slot-forwards) (. function place)))
    (let layout ([] (. tables slot-forward-layouts) (. function place)))
    (let runtime (. facts style-runtime))
    (= unit (= (. unit source-module) (. ([] (. instances rows) (. row instance)) module)))
    (let site (. row line))
    (let fn (call function-row types (. row builder)))
    (let returns no-type)
    (if (!= fn no-type)
      (match? ([] (. types rows) fn)
        (case (call .type-function shape)
          (= returns (call value-returned (. shape return-type)))
        )
      )
    )
    (let carried (if-expr (and (!= fn no-type) (call carries fn)) (call (. facts carried-result) fn) no-type))
    (if (or (== returns no-type) (and (!= fn no-type) (call carries fn) (== carried no-type)))
      (call refuse .refused-function site)
      (return)
    )
    (let answers (if-expr (== carried no-type) returns carried))
    (call (. ir add-argument) managed-layout)
    (if (!= (. row item) no-type)
      (call (. ir add-argument) (call layout-of (. row item) site))
    )
    (= returns-type answers)
    (= (. ir returns) (call layout-of answers site))
    (let kept (call make-operand .operand-argument 0))
    (let mark (call (. ir add-local) (call layout-of (. ([] (. instances signatures) (. runtime outlet-mark)) returns) site)))
    (call store-local mark (. (call call-instance (. runtime outlet-mark) site (. pending length)) operand) site)
    (let index U32)
    (for (in held (. facts outlet-cells))
      (if (or (!= (. held instance) (. row instance)) (!= (. held outlet) (. row line)))
        (continue)
      )
      (let first (. pending length))
      (+= pending (call integer .machine-u32 (call (. tables state-key-number) (. ([] (. facts scope-cells) (. held cell)) key))))
      (+= pending (call load kept (. (call (. tables layouts field) layout (+ 2 index)) offset) managed-layout site))
      (do
        (inline (call call-instance (. runtime outlet-push) site first))
      )
      (+= index 1)
    )
    (let code (call load kept (. (call (. tables layouts field) layout 0) offset) pointer-layout site))
    (let data (call load kept (. (call (. tables layouts field) layout 1) offset) managed-layout site))
    (let first (. pending length))
    (+= pending data)
    (if (!= (. row item) no-type)
      (+= pending (call make-operand .operand-argument 1))
    )
    (let result (call call code site first .callee-value (call layout-of answers site) true))
    (let held (call (. ir add-local) (call layout-of answers site)))
    (call store-local held result site)
    (let last (. pending length))
    (+= pending (call load-local mark site))
    (do
      (inline (call call-instance (. runtime outlet-release) site last))
    )
    (if (!= carried no-type)
      (call return-held (call load-local held site))
      (else
        (call return-value (call load-local held site) site)
      )
    )
  )
  (fn-do + guard-element Typed
    (param id SyntaxId)
    (param element Typed)
    (param name Atom)
    (let held (. element type))
    (if (and (not (. function may-panic)) (not in-landing))
      (call refuse .refused-expression id)
      (return element)
    )
    (let made (call (. ir reserve-block)))
    (let missing (call (. ir reserve-block)))
    (call branch
      (block
        (arg (call compare id .compare-not-equal (. element operand) (call integer .machine-pointer 0)))
        (arg made)
        (arg missing)
      )
    )
    (call (. ir start-block) missing)
    (call raise-text id (str "Named markup element \"" (. name text) "\" is read before its markup constructs it"))
    (call (. ir start-block) made)
    (return (call Typed (. element operand) held))
  )
  (fn-do + emit-markup-read Typed
    (param id SyntaxId)
    (param object SyntaxId)
    ; A read of a markup link: the subject, given to the markup runtime's function as a
    ; `MarkupElement`, and the host it answers, taken where it is one as the class the read gives,
    ; unchecked.
    (let nothing (call make-operand .operand-void 0))
    (let read (call (. facts markup-read-of) (. unit reading) id))
    (if (or (not read) (and (== object 0) (not (. unit has-self))))
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (let subject (call own-subject))
    (if (!= object 0)
      (= subject (call emit-expression object))
    )
    (let host (call convert id .reason-argument subject))
    (let mark (. pending length))
    (+= pending (. host operand))
    (let linked (call call-instance (. read reader) id mark))
    (if (== (. read target) no-type)
      (return linked)
    )
    (let type (call (. facts node-type) (. unit reading) id))
    (let layout (call layout-of type id))
    (let host-type (call (. types optional-inner) (. ([] (. instances signatures) (. read reader)) returns)))
    (let host-layout (call layout-of host-type id))
    (let holding (call (. ir reserve-block)))
    (let empty (call (. ir reserve-block)))
    (let joined (call (. ir reserve-block)))
    (let slot (call join-slot layout))
    (let sides (. joins length))
    (call branch
      (block
        (arg (. (call present id (call Typed (. linked operand) (. ([] (. instances signatures) (. read reader)) returns))) operand))
        (arg holding)
        (arg empty)
      )
    )
    (call (. ir start-block) holding)
    (let given (call payload id (call Typed (. linked operand) (. ([] (. instances signatures) (. read reader)) returns))))
    (let made (call take (. given operand) (call (. tables layouts field) host-layout 0) id))
    (call arrive id (. (call wrap id (call Typed made (. read target)) type) operand) joined slot)
    (call (. ir start-block) empty)
    (call arrive id (. (call empty-optional type layout) operand) joined slot)
    (return (call Typed (call close-joins joined sides layout slot) type))
  )
  (fn-do + filled-parameter U32
    (param fact CallFact)
    (param given U32)
    ; The parameter an argument a call gives fills, or none.
    (for (in position (..< 0 (. fact fills count)))
      (if (== (as ([] (. facts call-fills) (+ (. fact fills start) position)) U32) given)
        (return position)
      )
    )
    (return (. U32 max))
  )
)
