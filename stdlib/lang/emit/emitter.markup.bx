    )
    (let answers (call layout-of (if-expr (== carried no-type) returns carried) site))
    (let result (call Typed (call call code site mark .callee-value answers (not in-landing)) returns))
    (if (!= carried no-type)
      (= result (call Typed (. result operand) carried))
      (if (. ([] (. facts calls) fact) propagates)
        (= result (call propagate-held site carried (. result operand)))
      )
    )
    (return result)
