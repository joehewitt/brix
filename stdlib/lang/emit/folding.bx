(import ./program-tables)
(import /core/arena)
(import /core/table)
(import /lang/backend/bundle)
(import /lang/backend/mir)
(import /lang/ir/ir)
(import /lang/ir/ir-digest)
(import /string.h)

(type + Folding
  ; The functions of a round that lower to the code another of them lowers to, which the object
  ; holds once. A function is a candidate where another of the round shows its name in a stack
  ; trace. The round's first pass emits each, notes the functions whose symbols its code holds as
  ; values, which escape, and defers a candidate, keeping the shape of its IR
  ; (`IRDigester.shape`) and the functions that names. `settle` then puts each candidate that does
  ; not escape in a class of its own, and joins classes whose functions' shapes match with the
  ; functions they name in one class each, until none joins. The function of a class whose symbol
  ; comes first is lowered, and each other is folded into it: it has no record, and the merge
  ; points every reference to it at that one through `forwards`. A function that escapes keeps its
  ; own code, so that two function values made from two functions stay unequal.
  (blank)
  (prop + owners (list U32))
  (prop + refs (list (list U32)))
  (prop + places (of CPointer U32))
  (prop + into (of CPointer U32))
  (prop + kept (list U32))
  (prop + folded U32)
  (prop + forwards (of CPointer U32))
  (prop + forward-limit U32)
  (blank)
  (prop _ tables ProgramTables)
  (prop _ storage Arena)
  (prop _ count U32)
  (prop _ candidates (of CPointer Byte))
  (prop _ shapes (of CPointer IRDigest))
  (prop _ spans (of CPointer Span))
  (prop _ makers (of CPointer U32))
  (prop _ escapes (list (of CPointer Byte)))
  (fn-do + This _
    (param tables ProgramTables)
    (param workers Int)
    (param storage Arena)
    (= (. this tables) tables)
    (= (. this storage) storage)
    (let bundle (. tables bundle))
    (= count (as (. tables functions length) U32))
    (let limit (. bundle string-count))
    (for (in _ (..< 0 limit))
      (+= owners 0)
    )
    (let shown (call (of (. storage allocate) Byte) limit))
    (for (in position (..< 0 count))
      (let row ([] (. tables functions) position))
      (if (< (. row symbol) limit)
        (= ([] owners (. row symbol)) (+ position 1))
      )
      (if (and (< (. row display) limit) (< ([] shown (. row display)) 2))
        (+= ([] shown (. row display)) 1)
      )
    )
    (= candidates (call (of (. storage allocate) Byte) count))
    (for (in position (..< 0 count))
      (let row ([] (. tables functions) position))
      (let shared (and (< (. row display) limit) (== ([] shown (. row display)) 2)))
      (if (and shared (!= (. row kind) .process-main) (!= (. row symbol) (. bundle main-name)))
        (= ([] candidates position) 1)
      )
    )
    (= shapes (call (of (. storage allocate) IRDigest) count))
    (= spans (call (of (. storage allocate) Span) count))
    (= makers (call (of (. storage allocate) U32) count))
    (= places (call (of (. storage allocate) U32) count))
    (= into (call (of (. storage allocate) U32) count))
    (for (in position (..< 0 count))
      (= ([] into position) no-function)
    )
    (for (in _ (..< 0 workers))
      (+= refs (call (of List U32)))
      (+= escapes (call (of (. storage allocate) Byte) count))
    )
  )
  (fn-expr + is-candidate Bool
    (param position U32)
    (!= ([] candidates position) 0)
  )
  (fn-expr + is-folded Bool
    (param position U32)
    (!= ([] into position) no-function)
  )
  (fn-do + note-escapes _
    (param ir IRFunction)
    (param worker U32)
    ; Notes each function whose symbol the code holds other than as what a call calls.
    (let marks ([] escapes worker))
    (for (in row (. ir instructions))
      (let calls (or (== (. row op) .op-call) (== (. row op) .op-call-void)))
      (for (in position (..< (. row operands start) (. row operands end)))
        (if (and calls (== position (. row operands start)))
          (continue)
        )
        (call note-escape marks ([] (. ir operands) position))
      )
    )
    (for (in stream (. ir streams))
      (call note-escape marks (. stream made))
    )
  )
  (fn-do + defer _
    (param position U32)
    (param worker U32)
    (param shape IRDigest)
    (param start U32)
    (param place U32)
    ; Keeps a candidate's shape, the functions it names, which its worker listed from `start`, and
    ; the place of its entry where the round may reuse it.
    (= ([] shapes position) shape)
    (= ([] spans position) (call Span start (- (as (. ([] refs worker) length) U32) start)))
    (= ([] makers position) (+ worker 1))
    (= ([] places position) place)
  )
  (fn-do + settle _
    (param digester IRDigester)
    ; Folds each candidate into the function of its class, lists in `kept` the candidates the
    ; second pass lowers, and gives each folded function's symbol in `forwards` the symbol of the
    ; function it was folded into, plus one. Each turn finds the candidates of one digest through
    ; a table of digests, and keeps for each digest the candidate whose symbol comes first.
    (let escaped (call (of (. storage allocate) Byte) count))
    (for (in marks escapes)
      (for (in position (..< 0 count))
        (if (!= ([] marks position) 0)
          (= ([] escaped position) 1)
        )
      )
    )
    (let members (list U32))
    (for (in position (..< 0 count))
      (if (and (!= ([] makers position) 0) (== ([] escaped position) 0))
        (+= members position)
      )
    )
    (let classes (call (of (. storage allocate) U32) count))
    (for (in position (..< 0 count))
      (= ([] classes position) position)
    )
    (let capacity 16u32)
    (while (< capacity (* (as (. members length) U32) 2))
      (*= capacity 2)
    )
    (let mask (- capacity 1))
    (let highs (call (of (. storage allocate) U64) capacity))
    (let lows (call (of (. storage allocate) U64) capacity))
    (let heads (call (of (. storage allocate) U32) capacity))
    (let slots (call (of (. storage allocate) U32) (+ (. members length) 1)))
    (let changed true)
    (while changed
      (= changed false)
      (for (in slot (..< 0 capacity))
        (= ([] heads slot) 0)
      )
      (for (in index (..< 0 (. members length)))
        (let member ([] members index))
        (let key (call (. digester classed) ([] shapes member) ([] refs (- ([] makers member) 1)) ([] spans member) classes member))
        (let slot (as (/and/ (. key high) mask) U32))
        (while (and (!= ([] heads slot) 0) (or (!= ([] highs slot) (. key high)) (!= ([] lows slot) (. key low))))
          (= slot (/and/ (+ slot 1) mask))
        )
        (= ([] slots index) slot)
        (let head ([] heads slot))
        (if (== head 0)
          (= ([] highs slot) (. key high))
          (= ([] lows slot) (. key low))
          (= ([] heads slot) (+ (as index U32) 1))
          (else-if (call precedes member ([] members (- head 1)))
            (= ([] heads slot) (+ (as index U32) 1))
          )
        )
      )
      (for (in index (..< 0 (. members length)))
        (let member ([] members index))
        (let chosen ([] members (- ([] heads ([] slots index)) 1)))
        (if (!= ([] classes member) chosen)
          (= ([] classes member) chosen)
          (= changed true)
        )
      )
    )
    (for (in member members)
      (if (!= ([] classes member) member)
        (= ([] into member) ([] classes member))
        (+= folded 1)
      )
    )
    (for (in position (..< 0 count))
      (if (and (!= ([] makers position) 0) (== ([] into position) no-function))
        (+= kept position)
      )
    )
    (if (== folded 0)
      (return)
    )
    (= forward-limit (as (. owners length) U32))
    (= forwards (call (of (. storage allocate) U32) forward-limit))
    (for (in position (..< 0 count))
      (let chosen ([] into position))
      (if (!= chosen no-function)
        (= ([] forwards (. ([] (. tables functions) position) symbol)) (+ (. ([] (. tables functions) chosen) symbol) 1))
      )
    )
  )
  (fn-do _ precedes Bool
    (param position U32)
    (param other U32)
    ; Whether a function's symbol comes before another's, byte by byte.
    (let first (call (. tables bundle string) (. ([] (. tables functions) position) symbol)))
    (let second (call (. tables bundle string) (. ([] (. tables functions) other) symbol)))
    (let shorter (if-expr (< (. first length) (. second length)) (. first length) (. second length)))
    (let order (call C:memcmp (. first data) (. second data) shorter))
    (return-if (< order 0) (if (!= order 0)))
    (return (< (. first length) (. second length)))
  )
  (fn-do _ note-escape _
    (param marks (of CPointer Byte))
    (param operand Operand)
    (if (!= (call operand-kind operand) .operand-symbol)
      (return)
    )
    (let symbol (call operand-payload operand))
    (if (and (< symbol (. owners length)) (!= ([] owners symbol) 0))
      (= ([] marks (- ([] owners symbol) 1)) 1)
    )
  )
)
