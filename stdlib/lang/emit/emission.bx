(import ./emission-memory)
(import ./emitter)
(import ./folding)
(import ./inliner)
(import ./ir-to-mir)
(import ./layouts)
(import ./probe-catalog)
(import ./program-tables)
(import /BxGC/BxGC.h)
(import /core/arena)
(import /core/table)
(import /lang/ast/ast-nodes)
(import /lang/ast/module)
(import /lang/ast/program)
(import /lang/backend/backend-cache)
(import /lang/backend/bundle)
(import /lang/backend/compact)
(import /lang/backend/mir)
(import /lang/backend/mir-digest)
(import /lang/backend/mir-text)
(import /lang/backend/object-builder)
(import /lang/backend/object-file)
(import /lang/backend/pipeline)
(import /lang/backend/relocations)
(import /lang/check/binding)
(import /lang/check/facts)
(import /lang/check/instances)
(import /lang/check/pair-order)
(import /lang/check/type-store)
(import /lang/constants)
(import /lang/ir/ir)
(import /lang/ir/ir-digest)
(import /lang/ir/ir-text)
(import /os/file)
(import /stream/sort)
(import /string.h)
(import /time/clock)
(import /time/duration)
(blank)
(prop _ no-job U32 (= (. U32 max)))
(prop _ object-file-perms _ (= (+ user-read-perm user-write-perm group-read-perm other-read-perm)))

(type + EmissionOptions
  ; How a program is emitted. Unless it `optimizes`, no call is inlined and
  ; every GC-free zone keeps its brackets. A batch names the files its runtime writes: the marks of its cases, and
  ; what they print; and for each root the id of its case and the directory it runs in.
  (blank)
  (prop + object-path String)
  (prop + writes-object _ (= true))
  (prop + worker-count Int)
  (prop + optimizes _ (= true))
  (prop + warns Bool)
  (prop + dumps-ir Bool)
  (prop + dumps-stages Bool)
  (prop + batch-control _ (= ""))
  (prop + batch-output _ (= ""))
  (prop + batch-errors _ (= ""))
  (prop + batch-ids (list String))
  (prop + batch-directories (list String))
  (prop + catalog-path _ (= ""))
  (prop + unmatched-probes (list String))
  (prop + backend-cache (? BackendCache))
  (prop + memory (? EmissionMemory))
  (prop + verifies-reuse Bool)
  (prop + tables-time Microseconds)
  (prop + round-time Microseconds)
  (prop + merge-time Microseconds)
  (prop + object-time Microseconds)
)

(fn-do + emit-program _ (?! Error)
  (param program Program)
  (param instances Instances)
  (param facts Facts)
  (param types Types)
  (param bindings Bindings)
  (param options EmissionOptions)
  ; Compiles a sealed program to an object file: program tables, one round of emission over
  ; the worker pool, the merge of the round's literals and of the GC descriptors its code
  ; names, and the object. A program holding a construct emission has no shape for is refused
  ; whole, before anything is written; a batch is refused with each such construct of its cases.
  (let started (call clock))
  (probe-group + compiler.phase.tables)
  (let tables (use (call ProgramTables program instances facts types bindings)))
  (throw (call Error "A batch names a case for each of its roots") (if (or (!= (. options batch-ids length) (. program batch-roots length)) unmatched-directories)))
  (blank)
  (lazy unmatched-directories (!= (. options batch-directories length) (. program batch-roots length)))
  (= (. tables batch-control) (. options batch-control))
  (= (. tables batch-output) (. options batch-output))
  (= (. tables batch-errors) (. options batch-errors))
  (= (. tables batch-ids) (. options batch-ids))
  (= (. tables batch-directories) (. options batch-directories))
  (call (. tables build))
  (probe-group - compiler.phase.tables)
  (= (. options tables-time) (call (of (. started elapsed) Microseconds)))
  (if (!= (. tables refusals length) 0)
    (let lines (list String))
    (for (in position (..< 0 (. tables refusals length)))
      (if (or (== (. lines length) 0) (. program is-batch))
        (+= lines (call refusal-line program ([] (. tables refusals) position)))
      )
    )
    (throw (call Error (call (. "\n" join) lines)))
  )
  (if (. program probes is-enabled)
    (= (. options unmatched-probes) (call unmatched-probe-selectors program tables))
    (if (!= (. options catalog-path) "")
      (call write-probe-catalog (. options catalog-path) program tables (. options unmatched-probes))
    )
  )
  (if (. options optimizes)
    (call bound-free tables program instances facts types bindings)
  )
  (call (. tables bundle note-alignments))
  (blank)
  (let function-count U32 (as (. tables functions length) U32))
  (let count (if-expr (> (. options worker-count) 0) (. options worker-count) default-worker-count))
  (if (> count function-count)
    (= count function-count)
  )
  (let arena (use (call Arena)))
  (probe-group + emit.round.plan)
  (let folding (call Folding tables count arena))
  (probe-group - emit.round.plan)
  (let records (call (of (. arena allocate) CompactFunction) function-count))
  (let literals (call (of (. arena allocate) KeptLiterals) function-count))
  (let refusals (call (of (. arena allocate) Refusal) function-count))
  (let ir-texts (call (of (. arena allocate) ByteSpan) function-count))
  (let warnings (call (of (. arena allocate) ByteSpan) function-count))
  (let counts (call (of (. arena allocate) FunctionCounts) function-count))
  (let round-started (call clock))
  (probe-group + compiler.phase.emission)
  (probe emit.gc-objects (let gc-objects-before (call C:brixGCAllocatedObjectCount)))
  (let positions (list U32))
  (for (in position (..< 0 function-count))
    (+= positions position)
  )
  (let queue (call WorkQueue tables positions))
  (let verdicts
    (call InlineVerdicts
      (block
        (arg (call (of (. arena allocate) Byte) function-count))
        (arg (call (of (. arena allocate) Byte) function-count))
        (arg (call (of (. arena allocate) Byte) function-count))
      )
    )
  )
  (let cache (. options backend-cache))
  (let seed (call bundle-seed (. tables bundle)))
  (if cache
    (call (. cache begin-round) count)
  )
  (let memory (only-if (. options memory) (if (and cache (not (. options dumps-ir)) (not (. options warns))))))
  (let reusing (? ReuseRound))
  (if memory
    (call (. memory begin-round) count)
    (let context
      (call (. (call IRDigester tables program instances facts types arena) round-context)
        (block
          (arg seed)
          (arg (. options optimizes))
        )
      )
    )
    (= reusing (call ReuseRound memory context function-count (. tables layouts count) arena))
  )
  (let workers (list EmissionWorker))
  (for (in index (..< 0 count))
    (+= workers
      (call EmissionWorker
        (block
          (arg tables)
          (arg program)
          (arg instances)
          (arg facts)
          (arg types)
          (arg bindings)
          (arg queue)
          (arg verdicts)
          (arg records)
          (arg literals)
          (arg refusals)
          (arg ir-texts)
          (arg warnings)
          (arg counts)
          (arg seed)
          (arg (. options optimizes))
          (arg (. options dumps-ir))
          (arg (. options dumps-stages))
          (arg (. options warns))
          (arg (. options verifies-reuse))
          (arg (only-if (call (. cache store-for) index) (if (and cache (not (. options dumps-ir))))))
          (arg reusing)
          (arg (only-if (call (. memory store-for) index) (if memory)))
          (arg folding)
          (arg (as index U32))
        )
      )
    )
  )
  (finally
    (for (in worker workers)
      (call (. worker release))
    )
  )
  (blank)
  (let pool (call Worker count))
  (finally
    (call (. pool stop))
  )
  (let group (call TaskGroup))
  (for (in worker workers)
    (let task
      (do-new (worker: pool)
        (call (. worker emit-all))
        (on-failure failed
          (call (. group keep) failed)
        )
      )
    )
    (call (. group add) task)
  )
  (call (. group wait))
  (probe-group + emit.round.fold)
  (if (!= (. workers length) 0)
    (call (. folding settle) (. ([] workers 0) ir-digester))
  )
  (probe-count emit.round.folded (. folding folded))
  (probe-group - emit.round.fold)
  (let rest (call WorkQueue tables (. folding kept)))
  (if reusing
    (let digesters (list IRDigester))
    (for (in worker workers)
      (+= digesters (. worker ir-digester))
    )
    (probe-group + emit.round.index)
    (call (. reusing index) digesters function-count (. tables layouts count))
    (probe-group - emit.round.index)
  )
  (probe-group + emit.round.second)
  (for (in worker workers)
    (let task
      (do-new (worker: pool)
        (call (. worker decide-all) rest)
        (on-failure failed
          (call (. group keep) failed)
        )
      )
    )
    (call (. group add) task)
  )
  (call (. group wait))
  (probe-group - emit.round.second)
  (if reusing
    (let mismatches (list String))
    (for (in worker workers)
      (+= (. (!! memory) verified) (as (. worker verified) U64))
      (++= mismatches (. worker mismatches))
    )
    (if mismatches
      (throw (call Error (str "Reuse differs from emitting again:\n" (call (. "\n" join) mismatches))))
    )
  )
  (probe-count emit.gc-objects (- (call C:brixGCAllocatedObjectCount) gc-objects-before))
  (probe-group - compiler.phase.emission)
  (= (. options round-time) (call (of (. round-started elapsed) Microseconds)))
  (blank)
  (if (. options dumps-ir)
    (for (in position (..< 0 function-count))
      (let text ([] ir-texts position))
      (if (!= (. text length) 0)
        (<- stderr (call (. (call (of Array Byte) (. text data) (. text length)) slice-string) (..< 0 (. text length))))
      )
    )
  )
  (let warned (list U32))
  (for (in position (..< 0 function-count))
    (if (!= (. ([] warnings position) length) 0)
      (let finish (call (. tables finish-of) (as position U32)))
      (let place (. warned length))
      (while (and (> place 0) (> (call (. tables finish-of) ([] warned (- place 1))) finish))
        (-= place 1)
      )
      (call (. warned insert) position place)
    )
  )
  (for (in position warned)
    (let text ([] warnings position))
    (<- stderr (str (call (. (call (of Array Byte) (. text data) (. text length)) slice-string) (..< 0 (. text length))) "\n"))
  )
  (let lines (list String))
  (for (in position (..< 0 function-count))
    (if (and (!= (. ([] refusals position) construct) .refused-nothing) (or (== (. lines length) 0) (. program is-batch)))
      (+= lines (call refusal-line program ([] refusals position)))
    )
  )
  (if lines
    (throw (call Error (call (. "\n" join) lines)))
  )
  (if (not (. options writes-object))
    (return)
  )
  (blank)
  (let merge-started (call clock))
  (probe-group + compiler.phase.merge)
  (let held (list U32))
  (for (in position (..< 0 function-count))
    (if (not (call (. folding is-folded) position))
      (+= held position)
    )
  )
  (let forwarding (call Forwarding (. folding forwards) (. folding forward-limit)))
  (let ordered (call reached (. tables bundle) records function-count forwarding (call symbol-order (. tables bundle) records held)))
  (for (in position ordered)
    (probe-count compiler.mir.functions (. ([] counts position) functions))
    (probe-count compiler.mir.blocks (. ([] counts position) blocks))
    (probe-count compiler.mir.instructions (. ([] counts position) instructions))
    (probe-count compiler.mir.frame-bytes (. ([] counts position) frame-bytes))
  )
  (let bases (call (of (. arena allocate) U32) function-count))
  (let total U32)
  (for (in position (..< 0 function-count))
    (= ([] bases position) total)
    (+= total (. ([] literals position) count))
  )
  (let names (call (of (. arena allocate) U32) total))
  (call name-literals (. tables bundle) arena literals ordered bases names)
  (let layouts (. tables layouts))
  (let described (list LayoutId))
  (let buffered (list LayoutId))
  (for (in layout (..< 0 (. layouts count)))
    (for (in worker workers)
      (if (!= ([] (. worker lowering used) layout) 0)
        (+= described (call (. layouts shared) layout))
        (break)
      )
    )
    (for (in worker workers)
      (if (!= ([] (. worker lowering buffers) layout) 0)
        (+= buffered (call (. layouts shared) layout))
        (break)
      )
    )
  )
  (let descriptors (call sort described (:using (=> (a b) (call (. layouts descriptor-order) a b)))))
  (for (in layout descriptors)
    (call (. layouts add-descriptor) layout)
  )
  (let buffers (call sort buffered (:using (=> (a b) (call (. layouts descriptor-order) a b)))))
  (for (in layout buffers)
    (call (. layouts add-buffer-descriptor) layout)
  )
  (let allocated (list LayoutId))
  (for (in layout (..< 0 (. layouts count)))
    (for (in worker workers)
      (if (!= ([] (. worker lowering allocated) layout) 0)
        (+= allocated (call (. layouts shared) layout))
        (break)
      )
    )
  )
  (let sites (call sort allocated (:using (=> (a b) (call (. layouts descriptor-order) a b)))))
  (let next U32 1)
  (let previous no-layout)
  (for (in layout sites)
    (if (== layout previous)
      (continue)
    )
    (= previous layout)
    (call (. layouts add-site-key) layout (if-expr (<= next compiler-buffer-count) next 0u32))
    (+= next 1)
  )
  (for (in slot (..< 0 plain-site-count))
    (for (in worker workers)
      (if (!= ([] (. worker lowering plain-allocated) slot) 0)
        (call (. layouts add-plain-site-key)
          (block
            (arg (* (as slot U64) 8))
            (arg (if-expr (<= next compiler-buffer-count) next 0u32))
          )
        )
        (+= next 1)
        (break)
      )
    )
  )
  (for (in worker workers)
    (call (. worker want-type-constants))
  )
  (call (. tables add-type-constants))
  (blank)
  (call (. queue rewind))
  (for (in worker workers)
    (let task
      (do-new (worker: pool)
        (call (. worker patch-all) names bases)
        (on-failure failed
          (call (. group keep) failed)
        )
      )
    )
    (call (. group add) task)
  )
  (call (. group wait))
  (probe-group - compiler.phase.merge)
  (= (. options merge-time) (call (of (. merge-started elapsed) Microseconds)))
  (blank)
  (let object-started (call clock))
  (probe-group + compiler.phase.object)
  (call order-data (. tables bundle))
  (let builder (use (call ObjectBuilder (. tables bundle))))
  (call (. builder build) records ordered)
  (call write-object (. options object-path) (call object-file builder (. program target)))
  (call (?. cache finish-round))
  (probe-group + emit.round.remember)
  (call (?. memory finish-round) (. tables bundle))
  (probe-group - emit.round.remember)
  (probe-group - compiler.phase.object)
  (= (. options object-time) (call (of (. object-started elapsed) Microseconds)))
)

(type _ KeptLiterals (is Tuple)
  ; The string literals one function's code addresses, kept beside its record until the merge
  ; names them.
  (blank)
  (prop + rows (of CPointer StringLiteral))
  (prop + count U32)
)

(type _ WorkQueue
  ; Functions of a round, handed to workers heaviest first.
  (blank)
  (prop _ lock Mutex)
  (prop _ positions (list U32))
  (prop _ cursor Size)
  (fn-do + This _
    (param tables ProgramTables)
    (param chosen (list U32))
    (let keys (list U64))
    (for (in position chosen)
      (let weight U64 (. ([] (. tables functions) position) weight))
      (+= keys (/or/ (/lshift/ weight 32) (as position U64)))
    )
    (let sorted (call sorted-pairs keys))
    (for (in index (..< 0 (. sorted length)))
      (+= positions (as (/and/ ([] sorted (- (. sorted length) 1 index)) 0xffffffff) U32))
    )
  )
  (fn-do + rewind _
    (= cursor 0)
  )
  (fn-do + take U32
    (use lock)
    (if (== cursor (. positions length))
      (return no-job)
    )
    (let position ([] positions cursor))
    (+= cursor 1)
    (return position)
  )
)

(type _ EmissionWorker
  ; One worker of the round: it emits a function's IR, builds its MIR, runs the backend's
  ; pipeline over it and keeps the record, all in its own arenas. The round takes two passes. The
  ; first emits every function and notes what its code holds of other functions (`Folding`). A
  ; candidate to fold waits for the second pass, which lowers it unless it was folded, once every
  ; function's IR is met. With an emission memory the first pass digests every function too, and
  ; one whose entry may be reused waits for the second, which reuses it or emits it again.
  (blank)
  (prop + pipeline FunctionPipeline)
  (prop + lowering IRToMIR)
  (prop + inliner IRInliner)
  (prop + ir-digester IRDigester)
  (prop + mismatches (list String))
  (prop + verified U32)
  (blank)
  (prop _ tables ProgramTables)
  (prop _ queue WorkQueue)
  (prop _ records (of CPointer CompactFunction))
  (prop _ literals (of CPointer KeptLiterals))
  (prop _ refusals (of CPointer Refusal))
  (prop _ ir-texts (of CPointer ByteSpan))
  (prop _ warnings (of CPointer ByteSpan))
  (prop _ counts (of CPointer FunctionCounts))
  (prop _ emitter Emitter)
  (prop _ text IRText)
  (prop _ seed MIRDigest)
  (prop _ digester MIRDigester)
  (prop _ digest MIRDigest)
  (prop _ optimizes Bool)
  (prop _ dumps-ir Bool)
  (prop _ dumps-stages Bool)
  (prop _ warns Bool)
  (prop _ store (? RecordStore))
  (prop _ round (? ReuseRound))
  (prop _ reuses (? ReuseStore))
  (prop _ verifies Bool)
  (prop _ folding Folding)
  (prop _ lane U32)
  (prop _ deferred (list U32))
  (prop _ deferred-places (list U32))
  (prop _ mapped-strings IdList)
  (prop _ mapped-marks (list U32))
  (fn-do + This _
    (param tables ProgramTables)
    (param program Program)
    (param instances Instances)
    (param facts Facts)
    (param types Types)
    (param bindings Bindings)
    (param queue WorkQueue)
    (param verdicts InlineVerdicts)
    (param records (of CPointer CompactFunction))
    (param literals (of CPointer KeptLiterals))
    (param refusals (of CPointer Refusal))
    (param ir-texts (of CPointer ByteSpan))
    (param warnings (of CPointer ByteSpan))
    (param counts (of CPointer FunctionCounts))
    (param seed MIRDigest)
    (param optimizes Bool)
    (param dumps-ir Bool)
    (param dumps-stages Bool)
    (param warns Bool)
    (param verifies Bool)
    (param store (? RecordStore))
    (param round (? ReuseRound))
    (param reuses (? ReuseStore))
    (param folding Folding)
    (param lane U32)
    (lazy pipeline (call FunctionPipeline (. tables bundle)))
    (lazy emitter (call Emitter tables program instances facts types bindings (. pipeline function arena)))
    (lazy lowering (call IRToMIR tables (. pipeline builder) (. pipeline results)))
    (lazy inliner
      (call IRInliner
        (block
          (arg tables)
          (arg program)
          (arg instances)
          (arg facts)
          (arg types)
          (arg bindings)
          (arg verdicts)
          (arg (. pipeline function arena))
        )
      )
    )
    (lazy text (call IRText tables))
    (lazy digester (call MIRDigester (. tables bundle) (. pipeline function)))
    (lazy ir-digester (call IRDigester tables program instances facts types (. pipeline results)))
  )
  (fn-do + release _
    (call (. emitter release))
    (call (. inliner release))
    (call (. pipeline release))
  )
  (fn-do + want-type-constants _
    ; Notes the types whose constants the worker's code named.
    (for (in type (. emitter type-values))
      (call (. tables want-type-constant) type)
    )
    (call (. inliner want-type-constants))
  )
  (fn-do + emit-all _
    (while true
      (let position (call (. queue take)))
      (if (== position no-job)
        (break)
      )
      (call compile position)
    )
  )
  (fn-do + decide-all _
    (param rest WorkQueue)
    ; The second pass: each function that waited to be reused is reused, or emitted again where
    ; something it was made from changed, and each candidate to fold that was not folded is lowered.
    ; Then the entries the worker kept name what they consulted by key.
    (for (in index (..< 0 (. deferred length)))
      (call decide ([] deferred index) ([] deferred-places index))
    )
    (while true
      (let position (call (. rest take)))
      (if (== position no-job)
        (break)
      )
      (call lower-kept position)
    )
    (if reuses
      (let shared (!! round))
      (probe-group + emit.round.settle)
      (call (. (!! reuses) settle) (. shared names) (. shared contexts) (. shared layout-keys))
      (probe-group - emit.round.settle)
    )
  )
  (fn-do + patch-all _
    (param names (of CPointer U32))
    (param bases (of CPointer U32))
    ; Points each literal relocation of the round's records at the name the merge gave the
    ; literal.
    (let pool (. pipeline function pool-size))
    (while true
      (let position (call (. queue take)))
      (if (== position no-job)
        (break)
      )
      (let compact ([] records position))
      (for (in index (..< 0 (. compact relocation-count)))
        (let relocation ([] (. compact relocations) index))
        (if (>= (. relocation symbol) pool)
          (let name ([] names (- (+ ([] bases position) (. relocation symbol)) pool)))
          (= ([] (. compact relocations) index) (call Relocation (. relocation offset) name (. relocation kind)))
        )
      )
    )
  )
  (fn-do _ compile _
    (param position U32)
    (call begin position)
    (if (== (. ([] (. tables functions) position) kind) .process-main)
      (call (. lowering build-process-main) position)
      (call finish position)
      (return)
    )
    (let reusing round)
    (if reusing
      (let shared reusing)
      (= ([] (. shared names) position) (call (. ir-digester name-key) position))
      (= ([] (. shared digests) position) (call IRDigest 0 0))
      (= ([] (. shared contexts) position) (call IRDigest 0 0))
    )
    (if (not (call emitted position))
      (return)
    )
    (call (. folding note-escapes) (. emitter ir) lane)
    (let reusable no-place)
    (if reusing
      (let shared reusing)
      (probe-group + emit.round.ir-digest)
      (let made (call (. ir-digester digest) (. emitter ir) (. emitter bridged)))
      (= ([] (. shared contexts) position) (call (. ir-digester context) position made (. emitter bridged)))
      (probe-group - emit.round.ir-digest)
      (= ([] (. shared digests) position) made)
      (let place (call (. shared memory place) ([] (. shared names) position)))
      (if (!= place no-place)
        (let entry (call (. shared memory entry) place))
        (if (and (call same-digest (. entry ir) made) (call same-digest (. entry context) (. shared context)))
          (= reusable place)
        )
      )
    )
    (if (call (. folding is-candidate) position)
      (let refs ([] (. folding refs) lane))
      (let start (as (. refs length) U32))
      (probe-group + emit.round.shape)
      (let shape (call (. ir-digester shape) (. emitter ir) (. emitter bridged) (. folding owners) refs))
      (probe-group - emit.round.shape)
      (call (. folding defer) position lane shape start reusable)
      (return)
    )
    (if (!= reusable no-place)
      (+= deferred position)
      (+= deferred-places reusable)
      (return)
    )
    (call lower-emitted position)
  )
  (fn-do _ lower-kept _
    (param position U32)
    ; Lowers a candidate to fold that the round kept, or reuses it where its entry allows.
    (let place ([] (. folding places) position))
    (if (!= place no-place)
      (call decide position place)
      (return)
    )
    (call begin position)
    (if (call emitted position)
      (call lower-emitted position)
    )
  )
  (fn-do _ decide _
    (param position U32)
    (param place U32)
    (call begin position)
    (let entry (call (. (!! round) memory entry) place))
    (probe-group + emit.round.reuse)
    (let reusable (call reusable entry))
    (let done (and reusable (not verifies) (call reuse position entry place)))
    (probe-group - emit.round.reuse)
    (if done
      (return)
    )
    (call emitted position)
    (call lower-emitted position)
    (if (and reusable verifies)
      (call check position entry)
    )
  )
  (fn-do _ begin _
    (param position U32)
    (call (. pipeline function reset))
    (call (. pipeline begin) dumps-stages)
    (= (. pipeline dumps-stages) dumps-stages)
    (call (. lowering begin) position)
  )
  (fn-do _ emitted Bool
    (param position U32)
    (probe-group + emit.round.emit)
    (call (. emitter emit) position)
    (probe-group - emit.round.emit)
    (if (. emitter is-refused)
      (= ([] refusals position) (. emitter refusal))
      (return false)
    )
    (return true)
  )
  (fn-do _ lower-emitted _
    (param position U32)
    ; Inlines and lowers the function the emitter holds, and builds its record or finds it.
    (let function (. pipeline function))
    (if (. emitter bridged)
      (= (. function display-name) (. ([] (. tables functions) position) bridge-display))
    )
    (let built (if-expr optimizes (call (. inliner run) (. emitter ir)) (. emitter ir)))
    (let warned (if-expr (and optimizes warns) (call (. inliner warnings) built) ""))
    (if (!= (. warned size) 0)
      (let copy (call (. pipeline results allocate-raw) (. warned size)))
      (call C:memcpy copy (as warned (of CPointer Byte)) (. warned size))
      (= ([] warnings position) (call ByteSpan copy (. warned size)))
    )
    (if dumps-ir
      (call (. text out clear))
      (call (. text function-text) built)
      (let copy (call (. pipeline results allocate-raw) (. text out length)))
      (call C:memcpy copy (. text out bytes data) (. text out length))
      (= ([] ir-texts position) (call ByteSpan copy (. text out length)))
    )
    (call (. lowering lower) built)
    (call keep-literals position built)
    (if (and (call finish position) reuses)
      (let shared (!! round))
      (let kept ([] literals position))
      (probe-group + emit.round.keep)
      (call (. (!! reuses) keep)
        (block
          (arg ([] (. shared names) position))
          (arg ([] (. shared digests) position))
          (arg (. shared context))
          (arg digest)
          (arg inliner)
          (arg lowering)
          (arg (. digester strings))
          (arg (. tables bundle))
          (arg (. kept rows))
          (arg (. kept count))
        )
      )
      (probe-group - emit.round.keep)
    )
  )
  (fn-do _ finish Bool
    (param position U32)
    ; Finds the function's record in the backend cache, or runs the backend's pipeline to build it.
    ; Whether the function has a record.
    (return-if true (if (call reused position)))
    (blank)
    (let function (. pipeline function))
    (let built false)
    (if (call (. pipeline lower))
      (= (. pipeline dumps-stages) false)
      (let compact (call (. pipeline encode)))
      (call name-literal-relocations compact)
      (= ([] records position) compact)
      (= built true)
      (if store
        (call (. store keep) digest compact (. pipeline counted) (. function pool-size) (. digester strings))
      )
    )
    (= ([] counts position) (. pipeline counted))
    (if (and dumps-stages (!= (. ([] ir-texts position) length) 0))
      (let staged (. (call (. pipeline finished-dump)) text))
      (let joined (call (. pipeline results allocate-raw) (+ (. ([] ir-texts position) length) (. staged length))))
      (call C:memcpy joined (. ([] ir-texts position) data) (. ([] ir-texts position) length))
      (call C:memcpy (+ joined (. ([] ir-texts position) length)) (. staged data) (. staged length))
      (= ([] ir-texts position) (call ByteSpan joined (+ (. ([] ir-texts position) length) (. staged length))))
    )
    (return built)
  )
  (fn-do _ reused Bool
    (param position U32)
    (let kept store)
    (return-if false (if (not kept)))
    (blank)
    (probe-group + emit.round.mir-digest)
    (= digest (call (. digester digest) seed))
    (probe-group - emit.round.mir-digest)
    (let place (call (. kept cache find) digest))
    (return-if false (if (not place)))
    (blank)
    (let function (. pipeline function))
    (let record
      (call (. kept reuse)
        (block
          (arg place)
          (arg (. pipeline results))
          (arg (. function arena))
          (arg (. function order))
          (arg (. function pool-size))
          (arg (. digester strings))
        )
      )
    )
    (return-if false (if (not record)))
    (blank)
    (= ([] records position) record)
    (= ([] counts position) (. (call (. kept cache entry) place) counts))
    (return true)
  )
  (fn-do _ reusable Bool
    (param entry ReuseEntry)
    ; Whether a function an earlier round kept may be reused as it was: each function its inlining
    ; consulted reads as it did, each witness slot it looked up holds what it held, each string its
    ; record names is in the round's pool with the same facts, and each layout it marked is one the
    ; round has. It leaves the strings' ids and the marks for `reuse`.
    (let shared (!! round))
    (for (in index (..< 0 (. entry consult-count)))
      (let consult ([] (. entry consults) index))
      (let found (call (. shared by-name find) (. consult name)))
      (if (or (== found no-place) (not (call same-digest ([] (. shared contexts) found) (. consult context))))
        (return false)
      )
    )
    (let bundle (. tables bundle))
    (let pool (call (. shared memory pool) (. entry pool)))
    (for (in index (..< 0 (. entry slot-count)))
      (let slot ([] (. entry slots) index))
      (let symbol (call (. pool mapped) (. slot symbol) bundle))
      (if (== symbol no-string)
        (return false)
      )
      (let target (call (. tables witness-slot-function) symbol (. slot offset)))
      (let key (if-expr (!= target no-function) ([] (. shared names) target) 0u64))
      (if (!= key (. slot target))
        (return false)
      )
    )
    (let arena (. pipeline function arena))
    (= mapped-strings (call new-id-list arena (. entry string-count)))
    (for (in index (..< 0 (. entry string-count)))
      (let id (call (. pool mapped) ([] (. entry strings) index) bundle))
      (if (or (== id no-string) (!= (call (. bundle string-facts) id) ([] (. entry facts) index)))
        (return false)
      )
      (= mapped-strings (call (. mapped-strings appended) arena id))
    )
    (call (. mapped-marks clear))
    (for (in index (..< 0 (. entry mark-count)))
      (let mark ([] (. entry marks) index))
      (let value
        (scope (if-expr (== (. mark kind) .plain-mark) (as (. mark value) U32) layout-place)
          (lazy layout-place (call (. shared by-layout find) (. mark value)))
        )
      )
      (if (== value no-place)
        (return false)
      )
      (+= mapped-marks (call packed-mark (. mark kind) value))
    )
    (return true)
  )
  (fn-do _ reuse Bool
    (param position U32)
    (param entry ReuseEntry)
    (param place U32)
    ; Takes a reusable function's record from the backend cache, with its literals and marks.
    (let kept (!! store))
    (let found (call (. kept cache find) (. entry mir)))
    (return-if false (if (not found)))
    (blank)
    (let function (. pipeline function))
    (let record
      (call (. kept reuse)
        (block
          (arg found)
          (arg (. pipeline results))
          (arg (. function arena))
          (arg position)
          (arg (. function pool-size))
          (arg mapped-strings)
        )
      )
    )
    (return-if false (if (not record)))
    (blank)
    (= ([] records position) record)
    (= ([] counts position) (. (call (. kept cache entry) found) counts))
    (let rows (call (of (. pipeline results allocate) StringLiteral) (. entry literal-count)))
    (for (in index (..< 0 (. entry literal-count)))
      (= ([] rows index) ([] (. entry literals) index))
    )
    (= ([] literals position) (call KeptLiterals rows (. entry literal-count)))
    (for (in packed mapped-marks)
      (call (. lowering mark) (call mark-kind packed) (call mark-value packed))
    )
    (+= (. (!! reuses) used) place)
    (return true)
  )
  (fn-do _ check _
    (param position U32)
    (param entry ReuseEntry)
    ; Compares what a function deemed reusable gave when emitted, inlined and lowered again with
    ; what its entry kept, noting each part that differs.
    (+= verified 1)
    (let differs (list String))
    (if (or (!= (. digest high) (. entry mir high)) (!= (. digest low) (. entry mir low)))
      (+= differs "MIR")
    )
    (let strings (. digester strings))
    (let same-strings (== (. strings length) (. mapped-strings length)))
    (if same-strings
      (for (in index (..< 0 (. strings length)))
        (if (!= ([] strings index) ([] mapped-strings index))
          (= same-strings false)
        )
      )
    )
    (if (not same-strings)
      (+= differs "strings")
    )
    (let marks (. lowering marks))
    (let same-marks (== (. marks length) (. mapped-marks length)))
    (if same-marks
      (for (in index (..< 0 (. marks length)))
        (if (!= (call merged ([] marks index)) (call merged ([] mapped-marks index)))
          (= same-marks false)
        )
      )
    )
    (if (not same-marks)
      (+= differs "marks")
    )
    (let kept ([] literals position))
    (let same-literals (== (. kept count) (. entry literal-count)))
    (if same-literals
      (for (in index (..< 0 (. kept count)))
        (let made ([] (. kept rows) index))
        (let held ([] (. entry literals) index))
        (if (or facts-differ (!= (. made bytes length) (. held bytes length)) bytes-differ)
          (= same-literals false)
        )
        (lazy facts-differ (or (!= (. made character-length) (. held character-length)) (!= (. made flags) (. held flags))))
        (lazy bytes-differ (!= (call C:memcmp (. made bytes data) (. held bytes data) (. made bytes length)) 0))
      )
    )
    (if (not same-literals)
      (+= differs "literals")
    )
    (if (!= (. differs length) 0)
      (+= mismatches (str (call (. tables bundle text) (. ([] (. tables functions) position) name)) ": " (call (. ", " join) differs)))
    )
  )
  (fn-expr _ merged U32
    (param packed U32)
    ; A mark as the merge takes it, which reads a layout as the one it shares its shape with.
    (if-expr (== (call mark-kind packed) .plain-mark) packed shared-mark)
    (where
      (lazy shared-mark (call packed-mark (call mark-kind packed) (call (. tables layouts shared) (call mark-value packed))))
    )
  )
  (fn-do _ keep-literals _
    (param position U32)
    (param built IRFunction)
    (let constants (. built constants))
    (let count U32 (as (. constants length) U32))
    (let rows (call (of (. pipeline results allocate) StringLiteral) count))
    (for (in index (..< 0 count))
      (let constant ([] constants index))
      (let length (. constant bytes length))
      (let bytes (call (. pipeline results allocate-raw) (if-expr (!= length 0) length 1)))
      (call C:memcpy bytes (. constant bytes data) length)
      (let kept (call ByteSpan bytes length))
      (= ([] rows index) (call StringLiteral no-string (. constant character-length) (. constant flags) kept))
    )
    (= ([] literals position) (call KeptLiterals rows count))
  )
  (fn-do _ name-literal-relocations _
    (param compact CompactFunction)
    ; A relocation against a literal names a label local to the function. It is renamed to the
    ; literal's index past the end of the string pool, which outlives the function's arena.
    (let function (. pipeline function))
    (let pool (. function pool-size))
    (for (in index (..< 0 (. compact relocation-count)))
      (let relocation ([] (. compact relocations) index))
      (if (>= (. relocation symbol) pool)
        (let name ([] (. function local-names) (- (. relocation symbol) pool)))
        (throw (call Panic "A relocation names a label that is not a literal") (if (!= (. name kind) .literal-name)))
        (blank)
        (let literal (+ pool (. name index)))
        (= ([] (. compact relocations) index) (call Relocation (. relocation offset) literal (. relocation kind)))
      )
    )
  )
)

(type _ LiteralIndex
  ; The distinct literals of the object so far, found by their bytes.
  (blank)
  (prop _ bundle Bundle)
  (prop _ arena Arena)
  (prop _ slots (of CPointer U32))
  (prop _ capacity U32)
  (prop _ count U32)
  (fn-do + This _
    (param bundle Bundle)
    (param arena Arena)
    (= capacity 256)
    (= slots (call (of (. arena allocate) U32) capacity))
  )
  (fn-do + find U32
    (param bytes ByteSpan)
    ; The name of the literal with these bytes, or nothing.
    (let mask (- capacity 1))
    (let slot (/and/ (call hash bytes) mask))
    (while (!= ([] slots slot) 0)
      (let literal ([] (. bundle literals) (- ([] slots slot) 1)))
      (if (== (. literal bytes length) (. bytes length))
        (if (== (call C:memcmp (. literal bytes data) (. bytes data) (. bytes length)) 0)
          (return (. literal name))
        )
      )
      (= slot (/and/ (+ slot 1) mask))
    )
    (return no-string)
  )
  (fn-do + add _
    (param row U32)
    (if (> (* (+ count 1) 2) capacity)
      (let old-slots slots)
      (let old-capacity capacity)
      (= capacity (* old-capacity 2))
      (= slots (call (of (. arena allocate) U32) capacity))
      (for (in index (..< 0 old-capacity))
        (if (!= ([] old-slots index) 0)
          (call place (- ([] old-slots index) 1))
        )
      )
    )
    (call place row)
    (+= count 1)
  )
  (fn-do _ place _
    (param row U32)
    (let mask (- capacity 1))
    (let slot (/and/ (call hash (. ([] (. bundle literals) row) bytes)) mask))
    (while (!= ([] slots slot) 0)
      (= slot (/and/ (+ slot 1) mask))
    )
    (= ([] slots slot) (+ row 1))
  )
  (fn-expr _ hash U32
    (param bytes ByteSpan)
    (as (/and/ (/xor/ wide (/zrshift/ wide 32)) 0xffffffff) U32)
    (where
      (lazy wide (call fnv-hash (. bytes data) (. bytes length)))
    )
  )
)

(fn-do _ bound-free _
  (param tables ProgramTables)
  (param program Program)
  (param instances Instances)
  (param facts Facts)
  (param types Types)
  (param bindings Bindings)
  ; Finds the functions that run where the collector never sees it and reach no safepoint in a
  ; bounded time, as the reference elides the zone around calls of them. Each that cannot panic
  ; is emitted once, and is one where it has no loop, does not yield, and calls only C functions
  ; with no step out of the zone around them and functions so found, settled from the leaves up.
  (let storage (use (call Arena)))
  (let emitter (use (call Emitter tables program instances facts types bindings storage)))
  (let count (. tables functions length))
  (let symbols ([] U32 (. tables bundle string-count)))
  (for (in position (..< 0 count))
    (let named (. ([] (. tables functions) position) symbol))
    (if (< named (. tables bundle string-count))
      (= ([] symbols named) (+ (as position U32) 1))
    )
  )
  (let wanted ([] Bool count))
  (for (in position (..< 0 count))
    (= ([] wanted position) (call free-candidate tables instances (as position FunctionId)))
  )
  (let candidates (list U32))
  (let starts (list U32))
  (let ends (list U32))
  (let targets (list U32))
  (for (in position (..< 0 count))
    (if (not ([] wanted position))
      (continue)
    )
    (call (. storage reset))
    (call (. emitter emit) (as position FunctionId))
    (if (or (. emitter is-refused) (. emitter bridged))
      (continue)
    )
    (let ir (. emitter ir))
    (let first (. targets length))
    (let fits (call is-acyclic ir))
    (for (in row (. ir instructions))
      (if (== (. row op) .op-yield)
        (= fits false)
        (else-if (or (== (. row op) .op-call) (== (. row op) .op-call-void))
          (let kind (/and/ (. row aux) callee-kind-mask))
          (if (== kind (. CalleeKind callee-function))
            (let target ([] (. ir operands) (. row operands start)))
            (let symbol (call operand-payload target))
            (let called
              (scope (if-expr (and is-symbol in-range) ([] symbols symbol) 0u32)
                (lazy is-symbol (== (call operand-kind target) .operand-symbol))
                (lazy in-range (< symbol (. tables bundle string-count)))
              )
            )
            (if (or (== called 0) (not ([] wanted (- called 1))))
              (= fits false)
              (else
                (+= targets (- called 1))
              )
            )
            (else-if (!= kind (. CalleeKind callee-c))
              (= fits false)
            )
          )
        )
      )
      (if (not fits)
        (break)
      )
    )
    (if fits
      (+= candidates (as position U32))
      (+= starts (as first U32))
      (+= ends (as (. targets length) U32))
      (else
        (while (> (. targets length) first)
          (call (. targets pop))
        )
      )
    )
  )
  (let settled ([] Bool count))
  (let changed true)
  (while changed
    (= changed false)
    (for (in index (..< 0 (. candidates length)))
      (let position ([] candidates index))
      (if ([] settled position)
        (continue)
      )
      (let ready true)
      (for (in edge (..< ([] starts index) ([] ends index)))
        (if (not ([] settled ([] targets edge)))
          (= ready false)
          (break)
        )
      )
      (if ready
        (= ([] settled position) true)
        (= changed true)
      )
    )
  )
  (for (in position candidates)
    (if ([] settled position)
      (call (. tables mark-bounded) (. ([] (. tables functions) position) instance))
    )
  )
)

(fn-do _ is-acyclic Bool
  (param ir IRFunction)
  ; Whether no path through a body comes back to a block it is still on.
  (let count (. ir blocks length))
  (if (or (== count 0) (== (. ir order length) 0))
    (return true)
  )
  (let starts (list U32))
  (let targets (list U32))
  (for (in block (..< 0 count))
    (+= starts (as (. targets length) U32))
    (let rows (. ([] (. ir blocks) block) instructions))
    (for (in id (..< (. rows start) (. rows end)))
      (let row ([] (. ir instructions) id))
      (if (!= (. row op) .op-phi)
        (for (in position (..< (. row operands start) (. row operands end)))
          (let operand ([] (. ir operands) position))
          (if (== (call operand-kind operand) .operand-block)
            (+= targets (call operand-payload operand))
          )
        )
      )
    )
  )
  (+= starts (as (. targets length) U32))
  (let states ([] Byte count))
  (let path (list U32))
  (let edges (list U32))
  (let entry ([] (. ir order) 0))
  (= ([] states entry) 1)
  (+= path entry)
  (+= edges ([] starts entry))
  (while (!= (. path length) 0)
    (let block ([] path (- (. path length) 1)))
    (let edge ([] edges (- (. edges length) 1)))
    (if (< edge ([] starts (+ block 1)))
      (= ([] edges (- (. edges length) 1)) (+ edge 1))
      (let next ([] targets edge))
      (if (== ([] states next) 1)
        (return false)
      )
      (if (== ([] states next) 0)
        (= ([] states next) 1)
        (+= path next)
        (+= edges ([] starts next))
      )
      (continue)
    )
    (= ([] states block) 2)
    (call (. path pop))
    (call (. edges pop))
  )
  (return true)
)

(fn-expr _ free-candidate Bool
  (param tables ProgramTables)
  (param instances Instances)
  (param position FunctionId)
  (case? (or (!= (. function kind) .instance-body) (== (. function instance) no-instance))
    false
  )
  (case? (or may-collect (. row is-generator) (. row may-panic) (. row polls))
    false
  )
  (default
    (and infallible (== ([] (. tables instance-functions) instance) position))
  )
  (where
    (lazy function ([] (. tables functions) position))
    (lazy instance (. function instance))
    (lazy row ([] (. instances rows) instance))
    (lazy may-collect (== (/and/ (. row effects) (. CompilationEffect gc-free)) 0))
    (lazy infallible (== (. ([] (. instances signatures) instance) errors count) 0))
  )
)

(fn-do _ name-literals _
  (param bundle Bundle)
  (param arena Arena)
  (param literals (of CPointer KeptLiterals))
  (param ordered (list U32))
  (param bases (of CPointer U32))
  (param names (of CPointer U32))
  ; Names the object's string literals in the order the object holds the functions, each text
  ; once. The count of names is a running one, so this is serial; it touches each literal once.
  (let index (call LiteralIndex bundle arena))
  (let named U32)
  (for (in position ordered)
    (let kept ([] literals position))
    (for (in offset (..< 0 (. kept count)))
      (let row ([] (. kept rows) offset))
      (let name (call (. index find) (. row bytes)))
      (if (== name no-string)
        (+= named 1)
        (= name (call (. bundle intern) (if-expr (== named 1) "str" (str "str" named))))
        (let added U32 (as (. bundle literals length) U32))
        (call (. bundle literals append) (call StringLiteral name (. row character-length) (. row flags) (. row bytes)))
        (call (. index add) added)
      )
      (= ([] names (+ ([] bases position) offset)) name)
    )
  )
)

(fn-do _ symbol-order (list U32)
  (param bundle Bundle)
  (param records (of CPointer CompactFunction))
  (param held (list U32))
  ; The functions held, in the order of their symbols, which the object holds them in: an order
  ; that does not depend on the order the program tables declared them in, nor typing reached
  ; them.
  (let names (list String))
  (for (in position held)
    (+= names (call (. bundle text) (. ([] records position) symbol)))
  )
  (let order (list U32))
  (for (in index (call name-order names))
    (+= order ([] held index))
  )
  (return order)
)

(fn-do _ order-data _
  (param bundle Bundle)
  ; Puts the literals and the constant tables in the order of their names, which the object holds
  ; them in, as it holds the functions in the order of their symbols: an order that does not
  ; depend on the order the program tables, the workers and the merge added them in.
  (let literals (list StringLiteral))
  (let literal-names (list String))
  (for (in literal (. bundle literals))
    (+= literals (call StringLiteral (. literal name) (. literal character-length) (. literal flags) (. literal bytes)))
    (+= literal-names (call (. bundle text) (. literal name)))
  )
  (call (. bundle literals clear))
  (for (in position (call name-order literal-names))
    (call (. bundle literals append) ([] literals position))
  )
  (let tables (list ConstantTable))
  (let table-names (list String))
  (for (in table (. bundle constant-tables))
    (+= tables (call ConstantTable (. table name) (. table alignment) (. table items)))
    (+= table-names (call (. bundle text) (. table name)))
  )
  (call (. bundle constant-tables clear))
  (for (in position (call name-order table-names))
    (call (. bundle constant-tables append) ([] tables position))
  )
)

(fn-do _ name-order (list U32)
  (param names (list String))
  ; The places of the names given, in the order of the names: a merge sort, so names that are the
  ; same keep their order.
  (let count U32 (as (. names length) U32))
  (let order (list U32))
  (let spare (list U32))
  (for (in position (..< 0 count))
    (+= order position)
    (+= spare 0)
  )
  (let width 1u32)
  (while (< width count)
    (let start 0u32)
    (while (< start count)
      (let middle (if-expr (< (+ start width) count) (+ start width) count))
      (let end (if-expr (< (+ middle width) count) (+ middle width) count))
      (let left start)
      (let right middle)
      (for (in position (..< start end))
        (if (and (< left middle) (or (>= right end) (>= ([] names ([] order right)) ([] names ([] order left)))))
          (= ([] spare position) ([] order left))
          (+= left 1)
          (else
            (= ([] spare position) ([] order right))
            (+= right 1)
          )
        )
      )
      (= start end)
    )
    (let merged order)
    (= order spare)
    (= spare merged)
    (*= width 2)
  )
  (return order)
)

(fn-do _ reached (list U32)
  (param bundle Bundle)
  (param records (of CPointer CompactFunction))
  (param count U32)
  (param forwarding Forwarding)
  (param ordered (list U32))
  ; The functions the object holds, in their order: those named outside it, those a constant
  ; table names, and those the code of one held names in turn. A function whose every call was
  ; inlined is not held, as the reference's optimizer drops it. Each label of a constant table and
  ; each relocation of a held function's code that names a folded function is pointed at the
  ; function it was folded into as it is met.
  (let owners ([] U32 (. bundle string-count)))
  (for (in position ordered)
    (let symbol (. ([] records position) symbol))
    (if (< symbol (. bundle string-count))
      (= ([] owners symbol) (+ position 1))
    )
  )
  (let kept ([] Bool count))
  (let pending (list U32))
  (for (in position ordered)
    (let record ([] records position))
    (if (or (. record is-external) (not (. record is-encoded)))
      (= ([] kept position) true)
      (+= pending position)
    )
  )
  (for (in index (..< 0 (. bundle constant-items length)))
    (let item ([] (. bundle constant-items) index))
    (if (!= (. item kind) .label-constant)
      (continue)
    )
    (let name (. item name))
    (if (call (. forwarding is-folded) name)
      (= name (call (. forwarding target) name))
      (= ([] (. bundle constant-items) index) (call ConstantItem .label-constant 0 name))
    )
    (if (< name (. bundle string-count))
      (let owner ([] owners name))
      (if (and (!= owner 0) (not ([] kept (- owner 1))))
        (= ([] kept (- owner 1)) true)
        (+= pending (- owner 1))
      )
    )
  )
  (let next 0)
  (while (< next (. pending length))
    (let record ([] records ([] pending next)))
    (+= next 1)
    (for (in index (..< 0 (. record relocation-count)))
      (let relocation ([] (. record relocations) index))
      (let symbol (. relocation symbol))
      (if (call (. forwarding is-folded) symbol)
        (= symbol (call (. forwarding target) symbol))
        (= ([] (. record relocations) index) (call Relocation (. relocation offset) symbol (. relocation kind)))
      )
      (if (< symbol (. bundle string-count))
        (let owner ([] owners symbol))
        (if (and (!= owner 0) (not ([] kept (- owner 1))))
          (= ([] kept (- owner 1)) true)
          (+= pending (- owner 1))
        )
      )
    )
  )
  (if (== (. pending length) (. ordered length))
    (return ordered)
  )
  (let held (list U32))
  (for (in position ordered)
    (if ([] kept position)
      (+= held position)
    )
  )
  (return held)
)

(type _ Forwarding (is Tuple)
  ; The symbols of folded functions, each with the symbol of the function it was folded into, plus
  ; one (`Folding.forwards`); none below `limit` where nothing was folded.
  (blank)
  (prop + targets (of CPointer U32))
  (prop + limit U32)
  (fn-expr + is-folded Bool
    (param symbol StringId)
    (and (< symbol limit) (!= ([] targets symbol) 0))
  )
  (fn-expr + target StringId
    (param symbol StringId)
    (- ([] targets symbol) 1)
  )
)

(fn-expr _ refusal-line String
  (param program Program)
  (param refusal Refusal)
  (str (. module path) ":" line ":" (+ (. begin column) 1) ": Not supported by emission: " construct)
  (where
    (lazy module ([] (. program modules) (. refusal module)))
    (lazy begin (. ([] (. module tree nodes) (. refusal syntax)) loc begin))
    (lazy construct ([] refusal-texts (. refusal construct)))
    (lazy line (+ (. begin line) 1))
  )
)

(fn-do _ write-object _ (?! Error)
  (param path String)
  (param contents ByteSpan)
  (let mode (+ (. FileFlags write-mode) (. FileFlags create-mode) (. FileFlags truncate-mode)))
  (let file (use (call File path mode object-file-perms)))
  (if (!= (. contents length) 0)
    (call (. file write) (call (of Array Byte) (. contents data) (. contents length)) (. contents length))
  )
)
