(import ./emitter)
(import ./emitter.calls)
(import ./emitter.live-actions)
(import ./emitter.loops)
(import ./emitter.match-arms)
(import ./layouts)
(import ./program-tables)
(import ./receiver-stability)
(import ./runtime)
(import ./table-layouts)
(import /core/arena)
(import /core/table)
(import /lang/ast/ast)
(import /lang/ast/ast-children)
(import /lang/ast/ast-nodes)
(import /lang/ast/ast-queries)
(import /lang/ast/decl)
(import /lang/ast/module)
(import /lang/ast/operator)
(import /lang/ast/program)
(import /lang/ast/row-range)
(import /lang/ast/state-machines)
(import /lang/backend/mir)
(import /lang/check/binding)
(import /lang/check/claims)
(import /lang/check/facts)
(import /lang/check/instances)
(import /lang/check/machine-composite)
(import /lang/check/numeric)
(import /lang/check/pattern-helper)
(import /lang/check/probe-casts)
(import /lang/check/table-rows)
(import /lang/check/type-signature)
(import /lang/check/type-store)
(import /lang/check/type-text)
(import /lang/check/types)
(import /lang/ir/ir)
(import /stream/sort)

(type _ StateMachines (facet-of FunctionEmitter)
  (sees Calls)
  (sees LiveActions)
  (sees Loops)
  (sees MatchArms)
  (prop _ starting-refined _ (= false))
  (prop _ stopping-object _ (= false))
  (prop _ immediate-passed LocalId (= no-local))
  (fn-do + emit-machine-site Typed
    (param id SyntaxId)
    ; A state machine where it is written: the call of its function, given the environment in
    ; force here, which starts it and answers the value it starts in; one a property of a class
    ; holds, which a constructor starts, is given one of its own that holds the object (see
    ; `lone-environment`). The errors that leave its start leave the function with the call. One a
    ; line of a class's markup writes starts with those it refines (`start-content-machine`).
    (let nothing (call make-operand .operand-void 0))
    (let fact (call call-at id .call-function))
    (let callee (if-expr (!= fact no-fact) (. ([] (. facts calls) fact) callee) no-instance))
    (if (or (== callee no-instance) (== ([] (. tables instance-functions) callee) no-function))
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (let written (call (. facts machine-of) callee))
    (if (and (not starting-refined) written (== (. written store) .store-content) (== (. written outer) 0))
      (return (call start-content-machine id written))
    )
    (return (call call-machine id callee))
  )
  (fn-do _ start-content-machine Typed
    (param id SyntaxId)
    (param machine MachineFact)
    ; Starts a machine written as a line of a class's markup, where the markup runs on the object:
    ; not for an object of a class whose markup writes a machine that refines it, which starts it
    ; instead (`refining-classes`); and where it refines another, the machines it refines start after
    ; it, as the reference starts the merged machine (`start-refined`).
    (let nothing (call make-operand .operand-void 0))
    (let skipped (call (. tables refining-classes) machine))
    (let done (call (. ir reserve-block)))
    (if (!= (. skipped length) 0)
      (let running (call (. ir reserve-block)))
      (call classes-branch id (. unit self) skipped done running)
      (call (. ir start-block) running)
    )
    (do
      (inline (call call-machine id (. machine instance)))
    )
    (if (!= (. machine refined) no-instance)
      (= starting-refined true)
      (call start-refined (!! (call (. facts machine-of) (. machine refined))))
      (= starting-refined false)
    )
    (call jump done)
    (call (. ir start-block) done)
    (return (call Typed nothing (. types void-type)))
  )
  (fn-do _ call-machine Typed
    (param id SyntaxId)
    (param callee InstanceId)
    ; Calls a machine's function where it is written, given the environment in force here.
    (let nothing (call make-operand .operand-void 0))
    (let lone (if-expr (!= (. unit reading) (. unit instance)) (call lone-environment id no-slot) no-local))
    (let mark (. pending length))
    (+= pending (if-expr (!= lone no-local) (call load-local lone id) (call written-environment id)))
    (let raising (!= (. ([] (. instances signatures) callee) errors count) 0))
    (= takes-result raising)
    (let answer (call call-instance callee id mark))
    (= takes-result false)
    (if raising
      (= answer (call propagate id callee (. answer operand)))
    )
    (return (call Typed (. answer operand) (. ([] (. instances signatures) callee) returns)))
  )
  (fn-do _ open-machine Bool
    (param site SyntaxId)
    (param group U32 (= (. U32 max)))
    ; Finds the machine the function being emitted is part of, or the one a group of event
    ; transitions is of, with what the binder declared for it. Says whether there is one.
    (let found
      (scope (if-expr (== group (. U32 max)) instance-machine (call (. facts machine-of-group) group))
        (lazy instance-machine (?? (call (. facts machine-of) (. unit instance)) (call (. facts machine-of-group) group)))
      )
    )
    (if (not found)
      (call refuse .refused-function site)
      (return false)
    )
    (call (. machine-entering clear))
    (return (call use-machine found site))
  )
  (fn-do _ use-machine Bool
    (param found MachineFact)
    (param site SyntaxId)
    ; Makes a machine the one emitted: what is kept of it, its parts and its cases, and the
    ; composite it is a piece of, where it is merged with others, with those of the machines that
    ; refine it (`below-pieces`). Says whether the binder declared what it keeps.
    (let row (call (. bindings machine-slots) (. found module) (. found syntax)))
    (if (not row)
      (call refuse .refused-function site)
      (return false)
    )
    (let items (call (. tree state-items) (call (. tree state-body) (. found syntax))))
    (let cases (call (. tree machine-cases) items))
    (let composite (call compose-machine program facts found))
    (= machining
      (call Machining
        (block
          (arg found)
          (arg row)
          (arg items)
          (arg cases)
          (arg (call (. tree machine-captures) items cases))
          (arg composite)
          (arg (if-expr composite (call (. composite piece-of) (. found instance)) 0))
          (arg (if-expr composite (call below-pieces found) (call (of List MachineComposite))))
        )
      )
    )
    (return true)
  )
  (fn-do _ below-pieces (list MachineComposite)
    (param found MachineFact)
    ; The composites of the machines that refine a machine, directly or through others.
    (let below (list MachineComposite))
    (for (in fact (. facts machines))
      (if (or (!= (. fact outer) 0) (== (. fact refined) no-instance))
        (continue)
      )
      (let current (call (. facts machine-of) (. fact refined)))
      (while (and current (!= (. current instance) (. found instance)))
        (= current (only-if (call (. facts machine-of) (. current refined)) (if (!= (. current refined) no-instance))))
      )
      (let composite (only-if (call compose-machine program facts fact) (if current)))
      (if composite
        (+= below composite)
      )
    )
    (return below)
  )
  (fn-do _ outer-machine (? MachineFact)
    (param site SyntaxId)
    ; The machine a named machine written in one of its cases is part of, or a refusal.
    (let found (call (. facts machine-at) (. (!! (. machining fact)) instance) (. (!! (. machining fact)) outer)))
    (if (not found)
      (call refuse .refused-statement site)
    )
    (return found)
  )
  (fn-do _ start-nested _
    (param item SyntaxId)
    ; A named machine written in a case's body, started where the case's entry runs it, as the
    ; reference starts it: its first case is entered, its immediate transitions run, and the groups
    ; of its root are subscribed. The machine around it is emitted again after.
    (let found (call (. facts machine-at) (. (!! (. machining fact)) instance) (call (. tree nested-machine) item)))
    (if (not found)
      (call refuse .refused-statement item)
      (return)
    )
    (let around machining)
    (if (not (call use-machine found item))
      (return)
    )
    (let initial (call (. tree initial-case) (. machining items)))
    (if (!= initial 0)
      (call enter-case initial 0)
    )
    (call emit-immediates (. machining items) initial)
    (call subscribe-groups (. machining items))
    (= machining around)
  )
  (fn-do _ stop-nested _
    (param item SyntaxId)
    ; A named machine written in a case's body, stopped where the case exits, as the reference
    ; stops it: the groups of its root are unsubscribed, then each of its active cases exits, and
    ; the tasks its cases' `TaskOwner`s still hold are cancelled. The machine around it is emitted
    ; again after.
    (let found (call (. facts machine-at) (. (!! (. machining fact)) instance) (call (. tree nested-machine) item)))
    (if (not found)
      (call refuse .refused-statement item)
      (return)
    )
    (let around machining)
    (if (not (call use-machine found item))
      (return)
    )
    (call unsubscribe-groups (. machining items))
    (call exit-all)
    (call sweep-tasks)
    (= machining around)
  )
  (fn-do + emit-machine-start _
    (param declared SyntaxId)
    ; A state machine's start, the body of its function, as the reference starts it where it is
    ; written: one a module's property is keeps its environment in the module's global for it,
    ; each case it projects is not active, it enters its first case and runs its
    ; immediate transitions, subscribes the groups of its root, and answers its value. One merged
    ; with others keeps its part for the object first (`keep-part`); one that refines another does
    ; only that, and the machine none refines starts after it, and subscribes the groups the pieces
    ; below it write at their roots after its own (`subscribe-roots`). Immediate transitions a
    ; machine that refines another writes at its root have no shape here.
    (if (not (call open-machine declared))
      (return)
    )
    (if (. machining composite)
      (call keep-part declared)
    )
    (if (call (. tables stops-at-close) (!! (. machining fact)))
      (call own-machine declared)
    )
    (if (!= (. (!! (. machining fact)) refined) no-instance)
      (if (!= (. (call (. tree immediate-transitions) (. machining items)) length) 0)
        (call refuse .refused-statement declared)
      )
      (call return-nothing)
      (return)
    )
    (if (== (. (!! (. machining fact)) store) .store-global)
      (let row (call (. tables storage-of) (. (!! (. machining fact)) module) (. ([] (. instances rows) (. unit instance)) decl)))
      (if (or (== row no-storage) (== (. unit environment) no-local))
        (call refuse .refused-statement declared)
        (return)
      )
      (call store-global ([] (. tables storage) row) (call load-local (. unit environment) declared) declared)
    )
    (for (in node (. machining cases))
      (call project node false (call make-operand .operand-void 0) declared)
    )
    (let initial (call (. tree initial-case) (. machining items)))
    (if (!= initial 0)
      (call enter-case initial 0)
    )
    (call emit-immediates (. machining items) initial)
    (call subscribe-groups (. machining items))
    (call subscribe-roots declared)
    (let value (call read-kept (. (!! (. machining fact)) syntax) "(value)" declared))
    (call return-value (. value operand) declared)
  )
  (fn-do _ subscribe-roots _
    (param site SyntaxId)
    ; Subscribes the groups the pieces below the machine none refines write at their roots, in
    ; order, by the part of the one below it (`relay-part`).
    (if (and (. machining composite) (call below-adds (. U32 max) .part-subscribe))
      (do
        (inline (call call-below (. U32 max) .part-subscribe (call nowhere) (call nowhere) site))
      )
    )
  )
  (fn-do _ keep-part _
    (param site SyntaxId)
    ; What a machine merged with others keeps for the object, where it starts: its environment, with
    ; its part (`emit-machine-part`), as a function value the object holds in the property named
    ; after its class, and, where it refines another, in the one that machine's part calls below it.
    (let name (call part-name (!! (. machining fact))))
    (let found (only-if (call property-of (. unit owner-type) name) (if (and name (. unit has-self)))))
    (let held (if-expr found ([] (. tables layouts objects) (. unit owner-type)) no-layout))
    (let code (call (. tables machine-part-of) (. unit instance)))
    (if (or (not found) (== held no-layout) (== code no-function) (== (. unit environment) no-local))
      (call refuse .refused-statement site)
      (return)
    )
    (let callback (call make-callback code (call load-local (. unit environment) site) site))
    (let field (call (. tables layouts field) held (+ object-header-fields (. ([] (. types properties) found) slot))))
    (call store-struct (. unit self) field callback site)
    (let above (? MachineFact)
      (block
        (only-if (call (. facts machine-of) (. (!! (. machining fact)) refined)) (if (!= (. (!! (. machining fact)) refined) no-instance)))
      )
    )
    (if (not above)
      (return)
    )
    (let below (call below-name above))
    (let slot (only-if (call property-of (. unit owner-type) below) (if below)))
    (if (not slot)
      (call refuse .refused-statement site)
      (return)
    )
    (call store-struct
      (block
        (arg (. unit self))
        (arg (call (. tables layouts field) held (+ object-header-fields (. ([] (. types properties) slot) slot))))
        (arg callback)
        (arg site)
      )
    )
  )
  (fn-do _ own-machine _
    (param site SyntaxId)
    ; Gives the event runtime, where a machine a class's property holds starts, what stops it, the
    ; function that does (`emit-machine-stop`) with the machine's environment, for the object's
    ; `close` to run (`event-stop-machines`).
    (let code (call (. tables machine-stop-of) (. unit instance)))
    (if (or (== code no-function) (== (. unit environment) no-local) (not (. unit has-self)))
      (call refuse .refused-statement site)
      (return)
    )
    (let stop (call make-callback code (call load-local (. unit environment) site) site))
    (let mark (. pending length))
    (+= pending (call num-cast site (. unit self) managed-layout pointer-layout))
    (+= pending stop)
    (do
      (inline (call call-instance (. facts machine-own) site mark))
    )
  )
  (fn-do + emit-machine-stop _
    ; The function that stops a machine a class's property holds, which the event runtime runs as
    ; the object closes, given the machine's environment, as a named machine written in a case stops
    ; where the case exits (`stop-nested`): the groups of its root are unsubscribed, with those the
    ; pieces below it write at their roots, then each of its active cases exits, and the tasks its
    ; cases' `TaskOwner`s still hold are cancelled (`sweep-tasks`), but for the task that runs the
    ; `close`, which the object keeps for its next `close` to cancel. A group of its root the class's
    ; table runs is left to it: the runtime closes the object's events next.
    (let machine ([] (. facts machines) (. function place)))
    (call (. ir add-argument) managed-layout)
    (= returns-type (. types void-type))
    (= (. ir returns) void-layout)
    (if (not (call open-machine (. machine syntax)))
      (return)
    )
    (= unit (= (. unit received) true))
    (let given (call make-operand .operand-argument 0))
    (= unit (= (. unit environment) (call (. ir add-local) managed-layout)))
    (call store-local (. unit environment) given (. machine syntax))
    (= made-environment (call (. ir add-local) managed-layout))
    (call store-local made-environment (call load given 0 managed-layout (. machine syntax)) (. machine syntax))
    (call share-self (. machine syntax))
    (call unsubscribe-groups (. machining items) true)
    (if (and (. machining composite) (call below-adds (. U32 max) .part-unsubscribe))
      (do
        (inline (call call-below (. U32 max) .part-unsubscribe (call nowhere) (call nowhere) (. machine syntax)))
      )
    )
    (= stopping-object true)
    (call exit-all)
    (call sweep-tasks)
    (= stopping-object false)
    (call return-value (call make-operand .operand-void 0) (. machine syntax))
  )
  (fn-do + part-name (? Atom)
    (param machine MachineFact)
    ; The name of the property that holds what a machine merged with others keeps for the object:
    ; named after the class and the property whose machine it is.
    (return (call holder-name machine "part"))
  )
  (fn-do _ below-name (? Atom)
    (param machine MachineFact)
    ; The name of the property that holds what the machine that refines a machine merged with others
    ; keeps for the object, which that machine's part calls (`call-below`).
    (return (call holder-name machine "below"))
  )
  (fn-do _ holder-name (? Atom)
    (param machine MachineFact)
    (param kind String)
    ; The name of a property that holds a part for the object of a class whose property holds a
    ; machine merged with others, named after the class and the property, or whose markup writes
    ; one, named after the class and the machine's place among those of its markup.
    (let decls (. ([] (. program modules) (. machine module)) decls))
    (if (== (. machine store) .store-content)
      (let unit-id (. ([] (. instances rows) (. machine instance)) enclosing))
      (let type (if-expr (!= unit-id no-instance) (. ([] (. instances rows) unit-id) self-type) no-type))
      (if (or (== type no-type) (not (call (. tables is-class) type)))
        (return null)
      )
      (let ref (call class-ref types type))
      (if (!= (. ref module) (. machine module))
        (return null)
      )
      (match? ([] decls (. ref decl))
        (case (call .decl-class class)
          (let position
            (call (. (call (. ([] (. program modules) (. machine module)) tree content-machines) (. class content)) find)
              (block
                (arg (. machine syntax))
              )
            )
          )
          (if (!= position null)
            (return (call (. program store-atom) (str "(" (. class name text) "-state-" position "-" kind ")")))
          )
        )
      )
      (return null)
    )
    (match? ([] decls (. machine decl))
      (case (call .decl-property row)
        (match? ([] decls (. row owner))
          (case (call .decl-class class)
            (if (. row name)
              (let property-name (. row name))
              (return (call (. program store-atom) (str "(" (. class name text) "-" (. property-name text) "-" kind ")")))
            )
          )
        )
      )
    )
    (return null)
  )
  (fn-do + emit-machine-part _
    ; The part of a machine merged with others, the function the others call, as the reference runs
    ; the merged machine: given its environment, a case of the composite by its place, or its root
    ; for none, what to do (`PartOp`), and, where a joined group is tried, where the item and the
    ; broadcaster lie. A piece below calls it for a case it writes, or for the root of the machine
    ; none refines, to exit every active case; the piece above calls it for a case a piece above
    ; writes, or for the root, for what it and the pieces below it add there (`relay-part`). It
    ; answers whether an immediate transition or a joined group's transition passed, or a first case
    ; was entered.
    (let machine ([] (. facts machines) (. function place)))
    (call (. ir add-argument) managed-layout)
    (call (. ir add-argument) u32-layout)
    (call (. ir add-argument) u32-layout)
    (call (. ir add-argument) pointer-layout)
    (call (. ir add-argument) pointer-layout)
    (= returns-type (. types bool-type))
    (= (. ir returns) u8-layout)
    (if (not (call open-machine (. machine syntax)))
      (return)
    )
    (let composite (. machining composite))
    (if (not composite)
      (call refuse .refused-function (. machine syntax))
      (return)
    )
    (= unit (= (. unit received) true))
    (let given (call make-operand .operand-argument 0))
    (= unit (= (. unit environment) (call (. ir add-local) managed-layout)))
    (call store-local (. unit environment) given (. machine syntax))
    (= made-environment (call (. ir add-local) managed-layout))
    (call store-local made-environment (call load given 0 managed-layout (. machine syntax)) (. machine syntax))
    (call share-self (. machine syntax))
    (let answer (call (. ir add-local) u8-layout))
    (call store-local answer (call integer .machine-u8 0) (. machine syntax))
    (let which (call make-operand .operand-argument 1))
    (let op (call make-operand .operand-argument 2))
    (let done (call (. ir reserve-block)))
    (for (in case (..< 0 (. composite names length)))
      (let node (call (. composite node) (as case U32) (. machining piece)))
      (let owned (== ([] (. composite owners) case) (. machining piece)))
      (if (or (and owned (== node 0)) (and (not owned) (not (call relays-any (as case U32)))))
        (continue)
      )
      (let here (call (. ir reserve-block)))
      (let next (call (. ir reserve-block)))
      (call branch
        (block
          (arg (call compare (. machine syntax) .compare-equal which (call integer .machine-u32 (as case U64))))
          (arg here)
          (arg next)
        )
      )
      (call (. ir start-block) here)
      (if owned
        (call emit-owned-part node op done)
        (else
          (call relay-part (as case U32) op answer done)
        )
      )
      (call jump done)
      (call (. ir start-block) next)
    )
    (if (== (. machining piece) 0)
      (let exiting (call (. ir reserve-block)))
      (call branch (call is-part-op (. machine syntax) op .part-exit-all) exiting done)
      (call (. ir start-block) exiting)
      (call exit-all)
      (else
        (call relay-part (. U32 max) op answer done)
      )
    )
    (call jump done)
    (call (. ir start-block) done)
    (call return-value (call load-local answer (. machine syntax)) (. machine syntax))
  )
  (fn-do _ is-part-op Operand
    (param site SyntaxId)
    (param op Operand)
    (param wanted PartOp)
    ; Whether what a part is asked to do is one thing.
    (return (call compare site .compare-equal op (call integer .machine-u32 wanted)))
  )
  (fn-do _ part-branch _
    (param site SyntaxId)
    (param op Operand)
    (param wanted (list PartOp))
    (param matched IRBlockId)
    (param missed IRBlockId)
    ; Leaves to `matched` where what a part is asked to do is one of those `wanted`, else to `missed`.
    (for (in position (..< 0 (. wanted length)))
      (let next (if-expr (== (+ position 1) (. wanted length)) missed (call (. ir reserve-block))))
      (call branch (call is-part-op site op ([] wanted position)) matched next)
      (if (< (+ position 1) (. wanted length))
        (call (. ir start-block) next)
      )
    )
  )
  (fn-do _ emit-owned-part _
    (param node SyntaxId)
    (param op Operand)
    (param done IRBlockId)
    ; What a part does for a case it writes, where another piece calls it: keeps the case as entered,
    ; runs what it runs once entered and settles it or goes on to a case written in it, which the
    ; caller enters, or exits it where it is active, or exits the cases written in it. Only a case
    ; another piece can enter (`markable`) is entered so.
    (let leaving (call (. ir reserve-block)))
    (if (call markable (. machining piece) node)
      (call enter-owned-part node op done leaving)
      (else
        (call jump leaving)
      )
    )
    (call (. ir start-block) leaving)
    (let exiting (call (. ir reserve-block)))
    (let below (call (. ir reserve-block)))
    (call branch (call is-part-op node op .part-exit) exiting below)
    (call (. ir start-block) exiting)
    (call exit-case-if-active node)
    (call jump done)
    (call (. ir start-block) below)
    (let clearing (call (. ir reserve-block)))
    (call branch (call is-part-op node op .part-exit-below) clearing done)
    (call (. ir start-block) clearing)
    (call exit-descendants node)
  )
  (fn-do _ enter-owned-part _
    (param node SyntaxId)
    (param op Operand)
    (param done IRBlockId)
    (param leaving IRBlockId)
    ; What a part does to enter a case it writes, as `emit-owned-part` says, else leaving to `leaving`.
    ; One whose first case is given what its name is written with only where a path enters it
    ; (`enters-initial`) is never settled here.
    (let marking (call (. ir reserve-block)))
    (let after-mark (call (. ir reserve-block)))
    (let marks (list PartOp))
    (+= marks .part-enter)
    (+= marks .part-enter-step)
    (+= marks .part-mark)
    (call part-branch node op marks marking after-mark)
    (call (. ir start-block) marking)
    (let turns (. open-turns length))
    (+= machine-entering node)
    (call enter-mark node 0)
    (call (. machine-entering pop))
    (call close-turns turns)
    (let marked (call (. ir reserve-block)))
    (call branch (call is-part-op node op .part-mark) done marked)
    (call (. ir start-block) marked)
    (call jump after-mark)
    (call (. ir start-block) after-mark)
    (let entering (call (. ir reserve-block)))
    (let entries (list PartOp))
    (+= entries .part-enter)
    (+= entries .part-enter-step)
    (+= entries .part-settle)
    (+= entries .part-step)
    (call part-branch node op entries entering leaving)
    (call (. ir start-block) entering)
    (+= machine-entering node)
    (let entered (. open-turns length))
    (call enter-entry node)
    (call close-turns entered)
    (let stepping (call (. ir reserve-block)))
    (if (call (. tree enters-initial) (. machining items) node)
      (let settling (call (. ir reserve-block)))
      (let settles (list PartOp))
      (+= settles .part-enter)
      (+= settles .part-settle)
      (call part-branch node op settles settling stepping)
      (call (. ir start-block) settling)
      (call settle-case node)
    )
    (call jump stepping)
    (call (. ir start-block) stepping)
    (call (. machine-entering pop))
    (call jump done)
  )
  (fn-do _ relay-part _
    (param case U32)
    (param op Operand)
    (param answer LocalId)
    (param done IRBlockId)
    ; What a part does, for a case a piece above writes or for the root for none, where the piece
    ; above calls it for what it and the pieces below it add there: what it adds (`relay-own`), then
    ; what the pieces below add, by the part of the one below it (`call-below`), except that the
    ; `do finally` blocks below run first and the cases below exit first. An immediate transition
    ; or a first case is tried below only where none here passes. A group joined with the group of
    ; a piece above is tried by this piece's handler, which tries those below; where this piece
    ; writes none, by the piece below.
    (let node (if-expr (!= case (. U32 max)) (call (. (!! (. machining composite)) node) case (. machining piece)) 0))
    (let site (if-expr (!= node 0) node (. (!! (. machining fact)) syntax)))
    (for (in wanted (call relayed-ops))
      (let own (call relays (!! (. machining composite)) (. machining piece) case wanted))
      (let below (call below-adds case wanted))
      (if (and (not own) (not below))
        (continue)
      )
      (let here (call (. ir reserve-block)))
      (let next (call (. ir reserve-block)))
      (call branch (call is-part-op site op wanted) here next)
      (call (. ir start-block) here)
      (let first (or (== wanted .part-finally) (== wanted .part-exit-added)))
      (let tried (or (== wanted .part-immediates) (== wanted .part-initial)))
      (if (and below first)
        (do
          (inline (call call-below case wanted (call nowhere) (call nowhere) site))
        )
      )
      (if own
        (call relay-own case node wanted answer)
      )
      (if (and below (not first) (not (and own (== wanted .part-initial))))
        (if (and own tried)
          (let forwarding (call (. ir reserve-block)))
          (call branch
            (block
              (arg (call compare site .compare-equal (call load-local answer site) (call integer .machine-u8 0)))
              (arg forwarding)
              (arg done)
            )
          )
          (call (. ir start-block) forwarding)
        )
        (let passed (call call-below case wanted (call nowhere) (call nowhere) site))
        (if tried
          (call store-local answer (. passed operand) site)
        )
      )
      (call jump done)
      (call (. ir start-block) next)
    )
    (if (== case (. U32 max))
      (return)
    )
    (for (in piece (..< 0 (. machining piece)))
      (let named (call (. (!! (. machining composite)) node) case piece))
      (let source (. ([] (. program modules) (. ([] (. (!! (. machining composite)) pieces) piece) module)) tree))
      (if (== named 0)
        (continue)
      )
      (for (in head (call (. source group-heads) (call (. source state-items) (call (. source state-body) named))))
        (if (or (call (. source is-state-handler) head) other-first)
          (continue)
        )
        (lazy other-first (!= (call first-alike (!! (. machining composite)) case source head) piece))
        (let own (call alike-in (!! (. machining composite)) (. machining piece) case source head))
        (if (and (== own 0) (not (call below-joins case source head)))
          (continue)
        )
        (let key
          (scope (+ (as (. PartOp part-join) U64) place-bits)
            (lazy place-bits (as (call group-place ([] (. (!! (. machining composite)) pieces) piece) head) U64))
          )
        )
        (let here (call (. ir reserve-block)))
        (let next (call (. ir reserve-block)))
        (call branch (call compare site .compare-equal op (call integer .machine-u32 key)) here next)
        (call (. ir start-block) here)
        (if (!= own 0)
          (call relay-join own (call group-place ([] (. (!! (. machining composite)) pieces) piece) head) answer)
          (else
            (let below
              (call call-below
                (block
                  (arg case)
                  (arg (as key U32))
                  (arg (call make-operand .operand-argument 3))
                  (arg (call make-operand .operand-argument 4))
                  (arg site)
                )
              )
            )
            (call store-local answer (. below operand) site)
          )
        )
        (call jump done)
        (call (. ir start-block) next)
      )
    )
  )
  (fn-do _ relays-any Bool
    (param case U32)
    ; Whether a part does anything, for a case a piece above writes, where the piece above calls it
    ; for what it and the pieces below it add (`relay-part`).
    (for (in wanted (call relayed-ops))
      (if (or (call relays (!! (. machining composite)) (. machining piece) case wanted) (call below-adds case wanted))
        (return true)
      )
    )
    (for (in piece (..< 0 (. machining piece)))
      (let named (call (. (!! (. machining composite)) node) case piece))
      (let source (. ([] (. program modules) (. ([] (. (!! (. machining composite)) pieces) piece) module)) tree))
      (if (== named 0)
        (continue)
      )
      (for (in head (call (. source group-heads) (call (. source state-items) (call (. source state-body) named))))
        (if (call (. source is-state-handler) head)
          (continue)
        )
        (if (or alike-head (call below-joins case source head))
          (return true)
        )
        (lazy alike-head (!= (call alike-in (!! (. machining composite)) (. machining piece) case source head) 0))
      )
    )
    (return false)
  )
  (fn-do _ relay-own _
    (param case U32)
    (param node SyntaxId)
    (param wanted PartOp)
    (param answer LocalId)
    ; What a part adds, for a case a piece above writes that it names again, or for the root for
    ; none, where the piece above calls it: runs the statements it adds to the case's entry, with the
    ; activations of the case and those above it it sees bound, once the `TaskOwner` it keeps for the
    ; tasks it spawns for the case is made, where it keeps one; keeps the case active here in a new
    ; generation and subscribes the groups it adds, or those it writes at the root; tries the
    ; immediate transitions it adds, answering whether one passed; unsubscribes those groups, the
    ; case no longer active here; runs the `do finally` blocks and stops the named machines it adds,
    ; last first, then cancels those tasks; exits the active cases it writes below the case, or
    ; anywhere, last first; or enters the first case it writes in the case, answering that one was.
    ; Immediate transitions it adds to a case where it adds a fallback have no shape here.
    (if (== wanted .part-exit-added)
      (let cases (call (. (!! (. machining composite)) descendants) case))
      (let position (. cases length))
      (while (!= position 0)
        (-= position 1)
        (if (== ([] (. (!! (. machining composite)) owners) ([] cases position)) (. machining piece))
          (call exit-case-if-active (call (. (!! (. machining composite)) node) ([] cases position) (. machining piece)))
        )
      )
      (return)
    )
    (if (== case (. U32 max))
      (call subscribe-groups (. machining items))
      (return)
    )
    (if (== wanted .part-initial)
      (call enter-case
        (block
          (arg
            (call (. (!! (. machining composite)) node)
              (block
                (arg (call first-written (!! (. machining composite)) (. machining piece) case))
                (arg (. machining piece))
              )
            )
          )
          (arg 0)
        )
      )
      (call store-local answer (call integer .machine-u8 1) node)
      (return)
    )
    (let items (call (. tree state-items) (call (. tree state-body) node)))
    (if (and (== wanted .part-immediates) (!= (call (. tree immediate-fallback) items) 0))
      (call refuse .refused-statement node)
      (return)
    )
    (let turns (. open-turns length))
    (if (== wanted .part-subscribe)
      (call keep node "(active)" (call integer .machine-u8 1) node)
      (let generation (call read-kept node "(generation)" node))
      (call keep node "(generation)" (call add-one (. generation operand) node) node)
    )
    (call bind-path node)
    (if (== wanted .part-entries)
      (call open-tasks (call case-node node) node)
      (call emit-entries node)
      (else-if (== wanted .part-subscribe)
        (call subscribe-groups items)
      )
      (else-if (== wanted .part-immediates)
        (= immediate-passed answer)
        (call emit-immediates items node)
        (= immediate-passed no-local)
      )
      (else-if (== wanted .part-unsubscribe)
        (call unsubscribe-groups items)
        (call keep node "(active)" (call integer .machine-u8 0) node)
      )
      (else
        (call finish-items items)
        (call close-tasks (call case-node node) node)
      )
    )
    (call close-turns turns)
  )
  (fn-do _ relay-join _
    (param head SyntaxId)
    (param joined U32)
    (param answer LocalId)
    ; Tries a group a part writes that joins the group of a place among the facts' groups a piece
    ; above writes, by its handler, given the item and the broadcaster where the caller put them,
    ; and answers whether a transition passed. One whose item or stream is not that group's has no
    ; shape here.
    (let place (call machine-group-of head))
    (let handler (if-expr (!= place (. U32 max)) (call (. tables machine-handler-of) place) no-function))
    (let given ([] (. facts machine-groups) joined))
    (if (or (== handler no-function) (!= (. ([] (. facts machine-groups) place) item) (. given item)) other-stream)
      (call refuse .refused-statement head)
      (return)
    )
    (lazy other-stream (!= (. ([] (. facts machine-groups) place) stream) (. given stream)))
    (let mark (. pending length))
    (+= pending (call load-local (. unit environment) head))
    (+= pending (call given-value (call make-operand .operand-argument 3) (. given item) head))
    (+= pending (call given-value (call make-operand .operand-argument 4) (. given stream) head))
    (call (. ir depend) .callee-function handler may-panic-dependency)
    (call store-local
      (block
        (arg answer)
        (arg
          (call call
            (block
              (arg (call make-operand .operand-symbol (. ([] (. tables functions) handler) symbol)))
              (arg head)
              (arg mark)
              (arg .callee-function)
              (arg u8-layout)
              (arg (not in-landing))
            )
          )
        )
        (arg head)
      )
    )
  )
  (fn-do + emit-machine-handler _
    ; The function a group of a state machine's event transitions runs for an item, as the
    ; reference compiles it: given the machine's environment, the item and the broadcaster. Where
    ; the case that owns the group is not active it does nothing. Else `each` and `it` are the
    ; item, the activations of the owner and the cases above it are bound, and each transition is
    ; tried in turn, its pattern and
    ; its guard, and the first that passes fires; where none does, the group's fallback does. The
    ; machine's environment is the function's own, and the one it was given is that environment's
    ; link, from where the object the machine is written for is read, where it captures one. An
    ; error that leaves it is given to the global `unhandled-error`. A group of the root of a named
    ; machine written in a case of another does nothing where that case is not active. It answers
    ; whether a transition passed. Where the machine is a piece of a composite, the groups the
    ; pieces below join it with are tried after its own transitions (`try-joined`); one that joins a
    ; group a piece above writes has no fallback here.
    (let group ([] (. facts machine-groups) (. function place)))
    (if (not (call open-machine (. group head) (. function place)))
      (return)
    )
    (let head (. group head))
    (call (. ir add-argument) managed-layout)
    (call (. ir add-argument) (call layout-of (. group item) head))
    (call (. ir add-argument) (call layout-of (. group stream) head))
    (= returns-type (. types bool-type))
    (= (. ir returns) u8-layout)
    (= unit (= (. unit received) true))
    (= unit (= (. unit environment) (call (. ir add-local) managed-layout)))
    (call store-local (. unit environment) (call make-operand .operand-argument 0) head)
    (= made-environment (call (. ir add-local) managed-layout))
    (call store-local
      (block
        (arg made-environment)
        (arg (call load (call make-operand .operand-argument 0) 0 managed-layout head))
        (arg head)
      )
    )
    (call share-self head)
    (let item (call make-operand .operand-argument 1))
    (let answer (call (. ir add-local) u8-layout))
    (call store-local answer (call integer .machine-u8 0) head)
    (let done (call (. ir reserve-block)))
    (if (!= (. group owner) 0)
      (let running (call (. ir reserve-block)))
      (call branch (. (call read-flag (. group owner) head) operand) running done)
      (call (. ir start-block) running)
      (else-if (!= (. (!! (. machining fact)) outer) 0)
        (let running (call (. ir reserve-block)))
        (call branch (call parent-flag head) running done)
        (call (. ir start-block) running)
      )
    )
    (let each (call (. bindings declared-kind-at) (call binding-slots) head .slot-each))
    (let it (call (. bindings declared-kind-at) (call binding-slots) head .slot-it))
    (if (!= each no-slot)
      (call bind-machine-local each item (. group item) head)
    )
    (if (!= it no-slot)
      (call bind-machine-local it item (. group item) head)
    )
    (if (!= (. group owner) 0)
      (call bind-path (. group owner))
    )
    (if (call (. tree is-state-handler) head)
      (call run-state-handler head group item done)
      (call (. ir start-block) done)
      (call return-value (call load-local answer head) head)
      (return)
    )
    (let items
      (block
        (case? (!= (. group owner) 0)
          (call (. tree state-items) (call (. tree state-body) (. group owner)))
        )
        (default
          (. machining items)
        )
      )
    )
    (for (in transition (call (. tree group-transitions) items head))
      (let next (call (. ir reserve-block)))
      (let trigger (call (. tree state-trigger) transition))
      (let pattern (call (. tree trigger-match) trigger))
      (if (!= pattern 0)
        (do
          (inline (call emit-pattern pattern (call Typed item (. group item)) next))
        )
      )
      (let guard (call (. tree trigger-guard) trigger))
      (if (!= guard 0)
        (let passed (call (. ir reserve-block)))
        (call branch-on guard passed next)
        (call (. ir start-block) passed)
      )
      (call fire-event transition (. group owner))
      (call store-local answer (call integer .machine-u8 1) transition)
      (call jump done)
      (call (. ir start-block) next)
    )
    (call try-joined head group item answer done)
    (let fallback (call (. tree group-fallback) items head))
    (if (and (!= fallback 0) (call joins-earlier head))
      (call refuse .refused-statement fallback)
    )
    (if (!= fallback 0)
      (call fire-fallback fallback)
    )
    (call jump done)
    (call (. ir start-block) done)
    (call return-value (call load-local answer head) head)
  )
  (fn-do _ run-state-handler _
    (param head SyntaxId)
    (param group MachineGroup)
    (param item Operand)
    (param done U32)
    ; A handler's loop for an item of its stream, as the reference runs it: its pattern binds the
    ; item, or the item passes by where it fails; its `when` is tested; and its body runs.
    (match? ([] (. tree nodes) head)
      (case (call .node-for-block row)
        (match? ([] (. tree nodes) (. row loop))
          (case (call .node-loop-syntax loop)
            (if (!= (. loop pattern) 0)
              (do
                (inline (call emit-pattern (. loop pattern) (call Typed item (. group item)) done))
              )
            )
            (match? ([] (. tree nodes) (. loop clause))
              (case (call .node-clause clause)
                (let passed (call (. ir reserve-block)))
                (call branch-on (. clause expr) passed done)
                (call (. ir start-block) passed)
              )
            )
            (call emit-statement (. row body))
          )
        )
      )
    )
    (call jump done)
  )
  (fn-do _ parent-flag Operand
    (param site SyntaxId)
    ; Whether the case of the machine around it that a named machine is written in is active.
    (let around machining)
    (let outer (call outer-machine site))
    (if (or (not outer) (not (call use-machine outer site)))
      (return (call make-operand .operand-void 0))
    )
    (let flag (call read-flag (. (!! (. around fact)) parent) site))
    (= machining around)
    (return (. flag operand))
  )
  (fn-do + emit-machine-cast _
    ; The cast of a group's handler to the subscriber of its item, as the reference makes it: given
    ; the machine's environment, the item and the broadcaster, it runs the handler with them.
    (let group ([] (. facts machine-groups) (. function place)))
    (let handler (call (. tables machine-handler-of) (. function place)))
    (call (. ir add-argument) managed-layout)
    (call (. ir add-argument) (call layout-of (. group item) (. group head)))
    (call (. ir add-argument) (call layout-of (. group stream) (. group head)))
    (= returns-type (. types void-type))
    (= (. ir returns) void-layout)
    (if (== handler no-function)
      (call refuse .refused-function (. group head))
      (return)
    )
    (let mark (. pending length))
    (for (in position (..< 0u32 3))
      (+= pending (call make-operand .operand-argument position))
    )
    (call (. ir depend) .callee-function handler may-panic-dependency)
    (do
      (inline
        (call call handler-symbol (. group head) mark .callee-function u8-layout (not in-landing)
          (block
            (lazy handler-symbol (call make-operand .operand-symbol (. ([] (. tables functions) handler) symbol)))
          )
        )
      )
    )
    (call return-nothing)
  )
  (fn-do + emit-machine-activation _
    ; The function the subscriber a machine gives a broadcaster calls, as the reference makes it:
    ; given the record of the activation that subscribed, the item and the broadcaster, it runs the
    ; group's cast with the machine's environment the record holds, where the activation is still
    ; current, and answers that nothing went wrong. That of a group on an event of an object is
    ; what the port of the group runs, given the machine's environment itself, as the port runs it
    ; only while it is attached.
    (let group ([] (. facts machine-groups) (. function place)))
    (let handler (call (. tables machine-handler-of) (. function place)))
    (let record (. tables machine-record))
    (call (. ir add-argument) managed-layout)
    (call (. ir add-argument) (call layout-of (. group item) (. group head)))
    (call (. ir add-argument) (call layout-of (. group stream) (. group head)))
    (= returns-type (. types void-type))
    (= (. ir returns) void-layout)
    (let target (call function-row types (. group subscriber)))
    (let carried (if-expr (call carries target) (call (. facts carried-result) target) no-type))
    (if (!= carried no-type)
      (call return-results carried (. group head))
    )
    (if (or (== handler no-function) (== record no-layout))
      (call refuse .refused-function (. group head))
      (return)
    )
    (let given (call make-operand .operand-argument 0))
    (let running (call (. ir reserve-block)))
    (let done (call (. ir reserve-block)))
    (let ported (!= (. group event) (. U32 max)))
    (if ported
      (call jump running)
      (else
        (let active (call load given (. (call (. tables layouts field) record 1) offset) u8-layout (. group head)))
        (call branch (call compare (. group head) .compare-not-equal active (call integer .machine-u8 0)) running done)
      )
    )
    (call (. ir start-block) running)
    (let mark (. pending length))
    (+= pending
      (scope (if-expr ported given (call load given record-offset managed-layout (. group head)))
        (lazy record-offset (. (call (. tables layouts field) record 0) offset))
      )
    )
    (+= pending (call make-operand .operand-argument 1))
    (+= pending (call make-operand .operand-argument 2))
    (let cast (+ handler 1))
    (call (. ir depend) .callee-function cast may-panic-dependency)
    (do
      (inline
        (call call cast-symbol (. group head) mark .callee-function void-layout (not in-landing)
          (block
            (lazy cast-symbol (call make-operand .operand-symbol (. ([] (. tables functions) cast) symbol)))
          )
        )
      )
    )
    (call jump done)
    (call (. ir start-block) done)
    (call return-value (call make-operand .operand-void 0) (. group head))
  )
  (fn-do + emit-machine-deferral _
    ; The function the subscriber a machine gives a broadcaster that is no event calls, as the
    ; reference's `StateTransitionDeferral`: given the record of the activation that subscribed, the
    ; item and the broadcaster, it gives the event runtime's `event-machine-enqueue` the subscriber of
    ; the activation with them, which runs it once no event is being published and no other
    ; transition runs, and answers that nothing went wrong.
    (let group ([] (. facts machine-groups) (. function place)))
    (let handler (call (. tables machine-handler-of) (. function place)))
    (call (. ir add-argument) managed-layout)
    (call (. ir add-argument) (call layout-of (. group item) (. group head)))
    (call (. ir add-argument) (call layout-of (. group stream) (. group head)))
    (= returns-type (. types void-type))
    (= (. ir returns) void-layout)
    (let target (call function-row types (. group subscriber)))
    (let carried (if-expr (call carries target) (call (. facts carried-result) target) no-type))
    (if (!= carried no-type)
      (call return-results carried (. group head))
    )
    (if (or (== handler no-function) (== (. group enqueue) no-instance))
      (call refuse .refused-function (. group head))
      (return)
    )
    (let activation (call make-callback (+ handler 2) (call make-operand .operand-argument 0) (. group head)))
    (call enqueue group activation (call make-operand .operand-argument 1) (call make-operand .operand-argument 2))
    (call return-value (call make-operand .operand-void 0) (. group head))
  )
  (fn-do _ enqueue _
    (param group MachineGroup)
    (param activation Operand)
    (param item Operand)
    (param broadcaster Operand)
    ; Gives the event runtime's queue a group's activation, with an item and its broadcaster.
    (let mark (. pending length))
    (+= pending activation)
    (+= pending item)
    (+= pending broadcaster)
    (do
      (inline (call call-instance (. group enqueue) (. group head) mark))
    )
  )
  (fn-expr _ binding-slots (of RowRange Slot)
    ; The slots of the binding of the function being emitted.
    (call (of RowRange Slot) (. unit slot-start) (. unit slot-count))
  )
  (fn-expr _ case-node SyntaxId
    (param node SyntaxId)
    ; The node a machine keeps what it keeps for a case at: the case written, or what first names a
    ; case none writes.
    (if-expr (!= position null) ([] (. machining cases) position) node)
    (where
      (lazy position (call (. tree case-position) (. machining cases) (!! (call (. tree state-name) node))))
    )
  )
  (fn-do + case-type TypeId
    (param node SyntaxId)
    ; What the case a node names holds in the machine's union.
    (let position (call (. tree case-position) (. machining cases) (!! (call (. tree state-name) node))))
    (if (== position null)
      (return no-type)
    )
    (match? ([] (. types rows) (. (!! (. machining fact)) union))
      (case (call .type-named-union row)
        (return (call (. types child-type) (. row cases) position))
      )
    )
    (return no-type)
  )
  (fn-do + kept-slot SlotId
    (param node SyntaxId)
    (param name String)
    (param site SyntaxId)
    ; A slot the machine keeps under a name for a case, a group or itself, or a refusal.
    (let slot (call (. bindings machine-slot) (!! (. machining slots)) node (call (. program store-atom) name)))
    (if (== slot no-slot)
      (call refuse .refused-statement site)
    )
    (return slot)
  )
  (fn-do + keep _
    (param node SyntaxId)
    (param name String)
    (param value Operand)
    (param site SyntaxId)
    ; Stores what the machine keeps under a name in its environment.
    (let slot (call kept-slot node name site))
    (let held (. (call find-captured slot site) type))
    (call keep-captured slot value held site)
  )
  (fn-do + kept-type TypeId
    (param node SyntaxId)
    (param name String)
    (param site SyntaxId)
    ; The type of what the machine keeps under a name, as the type pass gave it.
    (let slot (call kept-slot node name site))
    (return (. (call find-captured slot site) type))
  )
  (fn-do _ read-flag Typed
    (param node SyntaxId)
    (param site SyntaxId)
    ; Whether the case a node names is active.
    (let flag (call read-kept (call case-node node) "(active)" site))
    (return (call Typed (. flag operand) (. types bool-type)))
  )
  (fn-do _ bind-machine-local _
    (param slot SlotId)
    (param value Operand)
    (param type TypeId)
    (param site SyntaxId)
    ; Gives a name a part of a machine binds its cell, holding a value. One a nested function
    ; captures is kept in the environment of the turn of its activation, which the reference binds
    ; anew in each function that runs it; any other captured one has no shape here.
    (let offset (call slot-offset slot site))
    (if (and (call is-captured slot) (call is-turned slot))
      (call keep-captured slot value type site)
      (return)
    )
    (if (call is-captured slot)
      (call refuse .refused-statement site)
      (return)
    )
    (let layout (call layout-of type site))
    (if (== layout void-layout)
      (return)
    )
    (let local (call (. ir add-local) layout))
    (+= rebindings (call Rebinding offset ([] (. unit cells) offset)))
    (= ([] (. unit cells) offset) local)
    (call store-local local value site)
  )
  (fn-do _ restore-cells _
    (param mark Size)
    ; Gives each cell a machine's name was bound to anew since `mark` the local it held before, last
    ; first, as the reference's scope of the activations an exit or an entry binds ends with it.
    (while (> (. rebindings length) mark)
      (let restored (call (. rebindings pop)))
      (= ([] (. unit cells) (. restored offset)) (. restored local))
    )
  )
  (fn-do _ bind-activation _
    (param node SyntaxId)
    ; The names a case's or a continuation's activation sees, bound as the reference binds them,
    ; in a turn of the activation (`open-activation`): each name among what it gives to the part of
    ; what the case holds in its place, read from where the machine keeps it, and each name the case
    ; keeps to what it keeps.
    (let position (call (. tree case-position) (. machining cases) (!! (call (. tree state-name) node))))
    (if (== position null)
      (return)
    )
    (call open-activation node)
    (let held (call case-node node))
    (let targets (call (. tree state-targets) node))
    (let names (list Atom))
    (if (!= (. targets count) 0)
      (let payload (call read-kept held "(payload)" node))
      (let whole (. payload type))
      (let layout (call layout-of whole node))
      (let offset 0u32)
      (for (in target ([] (. tree children) targets))
        (match? ([] (. tree nodes) target)
          (case (call .node-identifier named)
            (+= names (. named name))
            (let slot (call (. bindings declared-at) (call binding-slots) node (. named name)))
            (if (!= slot no-slot)
              (let piece (if-expr (== (. targets count) 1) payload (call part (. payload operand) layout offset target)))
              (call bind-machine-local slot (. piece operand) (. piece type) target)
            )
          )
        )
        (+= offset 1)
      )
    )
    (for (in name ([] (. machining kept) position))
      (if (!= (call (. names find) name) null)
        (continue)
      )
      (let slot (call (. bindings declared-at) (call binding-slots) node name))
      (if (!= slot no-slot)
        (let kept (call read-kept held (str "(kept " (. name text) ")") node))
        (call bind-machine-local slot (. kept operand) (. kept type) node)
      )
    )
  )
  (fn-do _ open-activation _
    (param node SyntaxId)
    ; Starts a turn of the activation of a case or a continuation where its names are bound. One
    ; whose names nested functions capture has an environment of its own, as a loop's turn does: an
    ; object the collector owns, which arrives zeroed, linked to the environment in force around the
    ; activation (`turn-link`). Any other is noted as a turn with none, where a nested function
    ; written in it is given the one in force around it.
    (if (== (. unit instance) no-instance)
      (return)
    )
    (let scope (call (. tables turn-scope) (. ([] (. instances rows) (. unit instance)) module) node))
    (if (== scope no-scope)
      (let plain (call activation-scope node))
      (if (!= plain no-scope)
        (+= open-turns (call TurnScope plain no-local no-place))
      )
      (return)
    )
    (let layout (call (. tables turn-environment) (. unit instance) scope))
    (if (or (!= (. unit reading) (. unit instance)) stepping (== layout no-layout) (== layout unbuilt-environment))
      (call refuse .refused-statement node)
      (return)
    )
    (let link (call turn-link scope node))
    (let mark (. pending length))
    (+= pending (call integer .machine-u64 (. ([] (. tables layouts rows) layout) size)))
    (+= pending (call make-operand .operand-descriptor layout))
    (let made (call call-runtime .runtime-allocate-object node mark managed-layout))
    (let local (call (. ir add-local) managed-layout))
    (call store-local local made node)
    (call store made 0 link true node)
    (+= open-turns (call TurnScope scope local no-place))
  )
  (fn-do _ activation-scope ScopeId
    (param node SyntaxId)
    ; The scope of the activation of a case or a continuation in the binding of the function being
    ; emitted, or none.
    (let binding (. ([] (. instances rows) (. unit instance)) binding))
    (if (== binding no-binding)
      (return no-scope)
    )
    (let range (. ([] (. bindings bindings) binding) scopes))
    (for (in scope (..< (. range start) (+ (. range start) (. range count))))
      (if (and (== (. ([] (. bindings scopes) scope) syntax) node) (== (. ([] (. bindings scopes) scope) kind) .scope-activation))
        (return scope)
      )
    )
    (return no-scope)
  )
  (fn-do _ enter-case _ (?! Refused)
    (param node SyntaxId)
    (param via SyntaxId)
    ; Enters a case, by the continuation `via` that led there where one did, and settles it.
    (let none (list SyntaxId))
    (call enter-below node via none 0 0)
  )
  (fn-do _ enter-below _
    (param node SyntaxId)
    (param via SyntaxId)
    (param path (list SyntaxId))
    (param start Size)
    (param path-via SyntaxId)
    ; Enters a case, as the reference expands its entry where a transition fires: it is kept as
    ; entered (`enter-mark`), by the continuation that led there where one did, whose entry
    ; statements then run and whose groups are subscribed, then what the case runs once entered
    ; (`enter-entry`). Then the cases of a path below it are entered from `start` on, the last by
    ; `path-via`, or where the path ends there, the case settles (`settle-case`). The turns of the
    ; activations it binds end there. A case entered again while its own entry is expanded has no
    ; shape here. One another piece of the machine's composite writes is entered by that piece
    ; (`enter-foreign`).
    (if (!= (call (. machine-entering find) node) null)
      (call refuse .refused-statement node)
      (return)
    )
    (if (call foreign-case node)
      (call enter-foreign (call composite-case node) via (>= start (. path length)) node)
      (if (< start (. path length))
        (call enter-path path start path-via)
      )
      (return)
    )
    (+= machine-entering node)
    (let turns (. open-turns length))
    (let rebound (. rebindings length))
    (call enter-mark node via)
    (if (!= via 0)
      (call bind-activation via)
      (call emit-entries via)
      (call subscribe-groups (call (. tree state-items) (call (. tree state-body) via)))
    )
    (call enter-entry node)
    (if (< start (. path length))
      (call enter-path path start path-via)
      (else
        (call settle-case node)
      )
    )
    (call close-turns turns)
    (call restore-cells rebound)
    (call (. machine-entering pop))
  )
  (fn-do _ enter-mark _
    (param node SyntaxId)
    (param via SyntaxId)
    ; Keeps a case as entered, as the reference expands it where a transition fires: the case is
    ; active first, so that what a store of the machine's value runs finds it so, then the machine's
    ; value is made of what the case is given, by the continuation `via` that led there or else the
    ; case itself, and kept, with what the case holds and the names it keeps; the case is active in
    ; a new generation, with a `TaskOwner` where it keeps one (`open-tasks`), and projected so.
    (let activation (if-expr (!= via 0) via node))
    (let held (call case-node node))
    (let position (call (. tree case-position) (. machining cases) (!! (call (. tree state-name) node))))
    (if (== position null)
      (call refuse .refused-statement node)
      (return)
    )
    (let holds (!= (call case-type node) (. types void-type)))
    (let payload (call make-payload activation (call case-type node) position))
    (let value (call make-union activation (. (!! (. machining fact)) union) position payload))
    (call keep-active held true activation)
    (call store-machine (. value operand) activation)
    (if holds
      (call keep held "(payload)" (. payload operand) activation)
    )
    (call keep-names held activation position)
    (let generation (call read-kept held "(generation)" activation))
    (call keep held "(generation)" (call add-one (. generation operand) activation) activation)
    (call open-tasks held activation)
    (call project node true (. payload operand) activation)
  )
  (fn-do _ open-tasks _
    (param node SyntaxId)
    (param site SyntaxId)
    ; Makes the `TaskOwner` a case keeps for the tasks its activations spawn, the first time it is
    ; entered: each exit cancels what it holds then, so the next activation's tasks start alone.
    ; None is made where the program spawns none so.
    (if (or (not (call keeps-tasks node)) (not (call makes-task-owners)))
      (return)
    )
    (let making (call (. ir reserve-block)))
    (let done (call (. ir reserve-block)))
    (call branch (. (call present site (call read-kept node "(tasks)" site)) operand) done making)
    (call (. ir start-block) making)
    (let made (call call-instance (. facts task-owner-make) site (. pending length)))
    (call keep node "(tasks)" (. (call wrap site made (call kept-type node "(tasks)" site)) operand) site)
    (call jump done)
    (call (. ir start-block) done)
  )
  (fn-do _ close-tasks _
    (param node SyntaxId)
    (param site SyntaxId)
    ; Cancels the tasks the activation of a case owns as it exits, without waiting for them or
    ; yielding to them. A task that exits its own case, by sending what moves the machine, is not
    ; cancelled: the case's `TaskOwner` keeps it, for the case's next exit or the machine's stop to
    ; cancel (`sweep-tasks`). Where the object's `close` stops the machine, the task that runs the
    ; `close` is not cancelled either, and the object keeps it instead, as it keeps its own.
    (if (or (not (call keeps-tasks node)) (not (call makes-task-owners)))
      (return)
    )
    (let mark (. pending length))
    (+= pending (call num-cast site (. (call read-kept node "(tasks)" site) operand) managed-layout pointer-layout))
    (if (and stopping-object (. unit has-self) (call (. tables is-class) (. unit owner-type)))
      (+= pending (call num-cast site (. unit self) managed-layout pointer-layout))
      (call call-runtime .runtime-cancel-owned-tasks-to site mark)
      (else
        (call call-runtime .runtime-cancel-owned-tasks site mark)
      )
    )
  )
  (fn-do _ sweep-tasks _
    ; Cancels what each case's `TaskOwner` still holds as the machine stops: the tasks that exited
    ; their own case. A piece of a composite below the one that stops it keeps those of the cases it
    ; names again until their next exit.
    (for (in node (. machining cases))
      (call close-tasks node (. (!! (. machining fact)) syntax))
    )
  )
  (fn-expr _ keeps-tasks Bool
    (param node SyntaxId)
    ; Whether the machine keeps a `TaskOwner` for the activations of a case.
    (!= (call (. bindings machine-slot) (!! (. machining slots)) node (call (. program store-atom) "(tasks)")) no-slot)
  )
  (fn-expr _ makes-task-owners Bool
    ; Whether the program spawns a task a case's activation owns, for which it makes `TaskOwner`s.
    (and (!= (. facts task-owner-make) no-instance) (!= ([] (. tables instance-functions) (. facts task-owner-make)) no-function))
  )
  (fn-do _ enter-entry _
    (param node SyntaxId)
    ; Runs what an entered case runs, as the reference expands it over the case's body merged with
    ; what the pieces below this one in the composite of the object's class add to it: the entry
    ; statements, with the activations of the case and those above it bound, then those the pieces
    ; add, then the case's groups are subscribed, then those the pieces add.
    (call bind-path node)
    (call emit-entries node)
    (call contribute node .part-entries)
    (call subscribe-groups (call (. tree state-items) (call (. tree state-body) node)))
    (call contribute node .part-subscribe)
  )
  (fn-do _ settle-case _
    (param node SyntaxId)
    ; Settles an entered case where no case below it is entered, as `emit-immediates` says.
    (call emit-immediates (call (. tree state-items) (call (. tree state-body) node)) node true)
  )
  (fn-do _ enter-foreign _
    (param case U32)
    (param via SyntaxId)
    (param settles Bool)
    (param site SyntaxId)
    ; Enters a case of the machine's composite another piece writes, by that piece's part: kept as
    ; entered there, with the entry statements of the continuation `via` that led there, where one
    ; did, run here, then what the case runs once entered run there, and settled there where it
    ; `settles`. A case that holds what it is given, or keeps names, has no shape here, as its piece
    ; reads them where it enters it, nor has a continuation that subscribes groups, which its piece
    ; does not unsubscribe, nor one that spawns a task the case's activation owns, which its piece
    ; does not cancel, nor has one settled whose first case is given what its name is written with
    ; only where a path enters it.
    (let owner ([] (. (!! (. machining composite)) owners) case))
    (let items (if-expr (!= via 0) (call (. tree state-items) (call (. tree state-body) via)) (call (of List SyntaxId))))
    (let written (call (. (!! (. machining composite)) node) case owner))
    (let fact ([] (. (!! (. machining composite)) pieces) owner))
    (let owner-tree (. ([] (. program modules) (. fact module)) tree))
    (let whole (call (. owner-tree state-items) (call (. owner-tree state-body) (. fact syntax))))
    (let unsettled (and settles (not (call (. owner-tree enters-initial) whole written))))
    (let spawns (and (!= via 0) (call (. tree spawns-in-body) via)))
    (if (or (not (call markable owner written)) (!= (. (call (. tree group-heads) items) length) 0) unsettled spawns)
      (call refuse .refused-statement site)
      (return)
    )
    (if (== via 0)
      (do
        (inline (call call-part owner case (if-expr settles .part-enter (. PartOp part-enter-step)) site))
      )
      (return)
    )
    (do
      (inline (call call-part owner case .part-mark site))
    )
    (let turns (. open-turns length))
    (let rebound (. rebindings length))
    (call bind-activation via)
    (call emit-entries via)
    (call close-turns turns)
    (call restore-cells rebound)
    (do
      (inline (call call-part owner case (if-expr settles .part-settle (. PartOp part-step)) site))
    )
  )
  (fn-expr _ markable Bool
    (param piece U32)
    (param node SyntaxId)
    ; Whether a piece of the machine's composite can keep a case it writes as entered for another
    ; piece, which gives it nothing: the case holds nothing it is given and keeps no names.
    (case? (or (== position null) (!= (. (call (. owner state-targets) node) count) 0))
      false
    )
    (default
      (== (. ([] (call (. owner machine-captures) items cases) position) length) 0)
    )
    (where
      (lazy owner (. ([] (. program modules) (. ([] (. (!! (. machining composite)) pieces) piece) module)) tree))
      (lazy items (call (. owner state-items) (call (. owner state-body) (. ([] (. (!! (. machining composite)) pieces) piece) syntax))))
      (lazy cases (call (. owner machine-cases) items))
      (lazy position (call (. owner case-position) cases (!! (call (. owner state-name) node))))
    )
  )
  (fn-expr _ composite-case U32
    (param node SyntaxId)
    ; The case of the composite the machine emitted is a piece of that a node names, or none where it
    ; is no piece of one or no case of the composite has the name.
    (case? (or (not composite) (not name))
      (. U32 max)
    )
    (default
      (call (. composite case-named) name)
    )
    (where
      (lazy composite (. machining composite))
      (lazy name (call (. tree state-name) node))
    )
  )
  (fn-expr _ foreign-case Bool
    (param node SyntaxId)
    ; Whether a node names a case of the machine's composite another piece writes, which only that
    ; piece keeps as entered or exits.
    (and (!= case (. U32 max)) (!= ([] (. (!! (. machining composite)) owners) case) (. machining piece)))
    (where
      (lazy case (call composite-case node))
    )
  )
  (fn-do _ contribute _
    (param node SyntaxId)
    (param op PartOp)
    ; Runs what the pieces below this one in the composite of the object's class add to what `op`
    ; runs for a case this piece writes, where one adds anything (`relay-part`).
    (let case (call composite-case node))
    (if (and (!= case (. U32 max)) (call below-adds case op))
      (do
        (inline (call call-below case op (call nowhere) (call nowhere) node))
      )
    )
  )
  (fn-do _ piece-adds Bool
    (param fact MachineFact)
    (param node SyntaxId)
    (param op PartOp)
    ; Whether what a piece of a composite writes in the body of a case it names again adds anything
    ; to what `op` runs: entry statements, groups, immediate transitions or `do finally` blocks and
    ; named machines. A named machine also adds to subscribing and unsubscribing, where the piece
    ; keeps the case active for the groups of its root to read (`parent-flag`), and a `TaskOwner`
    ; the piece keeps for the case adds to entering and exiting it (`piece-keeps-tasks`).
    (let owner (. ([] (. program modules) (. fact module)) tree))
    (let items (call (. owner state-items) (call (. owner state-body) node)))
    (if (== op .part-immediates)
      (return (!= (. (call (. owner immediate-transitions) items) length) 0))
    )
    (if (and (or (== op .part-entries) (== op .part-finally)) (call piece-keeps-tasks fact node))
      (return true)
    )
    (if (and (or (== op .part-subscribe) (== op .part-unsubscribe)) (!= (. (call (. owner group-heads) items) length) 0))
      (return true)
    )
    (for (in item items)
      (let nested (!= (call (. owner nested-machine) item) 0))
      (if (and (or (== op .part-subscribe) (== op .part-unsubscribe)) nested)
        (return true)
      )
      (if (and (== op .part-entries) (or nested (call (. owner is-entry-item) item)))
        (return true)
      )
      (if (and (== op .part-finally) (or nested (is ([] (. owner nodes) item) .node-do-finally-block)))
        (return true)
      )
    )
    (return false)
  )
  (fn-do _ piece-keeps-tasks Bool
    (param fact MachineFact)
    (param node SyntaxId)
    ; Whether a piece of a composite keeps a `TaskOwner` for the activations of a case it names.
    (let owner (. ([] (. program modules) (. fact module)) tree))
    (let cases (call (. owner machine-cases) (call (. owner state-items) (call (. owner state-body) (. fact syntax)))))
    (let position (call (. owner case-position) cases (!! (call (. owner state-name) node))))
    (let row (call (. bindings machine-slots) (. fact module) (. fact syntax)))
    (return-if false (if (or (== position null) (not row))))
    (return (!= (call (. bindings machine-slot) row ([] cases position) (call (. program store-atom) "(tasks)")) no-slot))
  )
  (fn-do _ call-part Typed
    (param piece U32)
    (param case U32)
    (param op PartOp)
    (param site SyntaxId)
    ; Calls the part of a piece above this one in the machine's composite for a case, given what the
    ; object holds for that piece (`keep-part`).
    (let nothing (call make-operand .operand-void 0))
    (let code (call (. tables machine-part-of) (. ([] (. (!! (. machining composite)) pieces) piece) instance)))
    (let given (call part-environment piece site))
    (if (== code no-function)
      (call refuse .refused-statement site)
      (return (call Typed nothing no-type))
    )
    (let mark (. pending length))
    (+= pending given)
    (+= pending (call integer .machine-u32 case))
    (+= pending (call integer .machine-u32 op))
    (+= pending (call nowhere))
    (+= pending (call nowhere))
    (let target ([] (. tables functions) code))
    (call (. ir depend) .callee-function code (if-expr (. target may-panic) may-panic-dependency 0))
    (let called
      (call call
        (block
          (arg (call make-operand .operand-symbol (. target symbol)))
          (arg site)
          (arg mark)
          (arg .callee-function)
          (arg u8-layout)
          (arg (. target may-panic))
        )
      )
    )
    (return (call Typed called (. types bool-type)))
  )
  (fn-do _ call-below Typed
    (param case U32)
    (param op U32)
    (param item Operand)
    (param stream Operand)
    (param site SyntaxId)
    ; Calls the part of the piece below this one in the composite of the object's class, which the
    ; object holds in the property named after this piece's class (`keep-part`) where its class
    ; refines the machine, for a case or the root for none, given where a joined group's item and
    ; broadcaster lie, and answers what it answers, or false where there is none.
    (let nothing (call make-operand .operand-void 0))
    (let name (call below-name (!! (. machining fact))))
    (let found (only-if (call property-of (. unit owner-type) name) (if (and name (. unit has-self)))))
    (let held (if-expr found ([] (. tables layouts objects) (. unit owner-type)) no-layout))
    (if (or (not found) (== held no-layout))
      (call refuse .refused-statement site)
      (return (call Typed nothing no-type))
    )
    (let field (call (. tables layouts field) held (+ object-header-fields (. ([] (. types properties) found) slot))))
    (let answer (call (. ir add-local) u8-layout))
    (call store-local answer (call integer .machine-u8 0) site)
    (let code (call load (. unit self) (. field offset) pointer-layout site))
    (let calling (call (. ir reserve-block)))
    (let done (call (. ir reserve-block)))
    (call branch (call compare site .compare-not-equal code (call integer .machine-pointer 0)) calling done)
    (call (. ir start-block) calling)
    (let data (. (call (. tables layouts field) (. tables layouts function-layout) 1) offset))
    (let mark (. pending length))
    (+= pending (call load (. unit self) (+ (. field offset) data) managed-layout site))
    (+= pending (call integer .machine-u32 case))
    (+= pending (call integer .machine-u32 op))
    (+= pending item)
    (+= pending stream)
    (call store-local answer (call call code site mark .callee-value u8-layout (not in-landing)) site)
    (call jump done)
    (call (. ir start-block) done)
    (return (call Typed (call load-local answer site) (. types bool-type)))
  )
  (fn-expr + nowhere Operand
    ; The address a part is given where it is given no item or broadcaster.
    (call integer .machine-pointer 0)
  )
  (fn-do _ below-adds Bool
    (param case U32)
    (param op PartOp)
    ; Whether a piece below this one, in the composite of a machine that refines it, adds to what
    ; `op` runs for a case of this one's composite, or for its root for none (`relays`).
    (for (in composite (. machining below))
      (if (call relays composite (as (- (. composite pieces length) 1) U32) case op)
        (return true)
      )
    )
    (return false)
  )
  (fn-do _ below-joins Bool
    (param case U32)
    (param source AST)
    (param head SyntaxId)
    ; Whether a piece below this one, in the composite of a machine that refines it, writes a group
    ; in a case of this one's composite on the stream the group a transition of a piece above heads
    ; is on.
    (for (in composite (. machining below))
      (if (!= (call alike-in composite (as (- (. composite pieces length) 1) U32) case source head) 0)
        (return true)
      )
    )
    (return false)
  )
  (fn-do _ relays Bool
    (param composite MachineComposite)
    (param piece U32)
    (param case U32)
    (param op PartOp)
    ; Whether a piece of a composite adds to what `op` runs where the piece above it calls it for a
    ; case a piece above writes, or for the root for none: cases it writes below the case, or
    ; anywhere; the groups it writes at the root; the first case written in the case, where it
    ; writes it (`first-written`); or what it writes in the body of the case where it names it again
    ; (`piece-adds`).
    (let fact ([] (. composite pieces) piece))
    (let owner (. ([] (. program modules) (. fact module)) tree))
    (if (== op .part-exit-added)
      (for (in child (call (. composite descendants) case))
        (if (== ([] (. composite owners) child) piece)
          (return true)
        )
      )
      (return false)
    )
    (if (== case (. U32 max))
      (return
        (scope (and (== op .part-subscribe) (!= (. (call (. owner group-heads) root-items) length) 0))
          (lazy root-items (call (. owner state-items) (call (. owner state-body) (. fact syntax))))
        )
      )
    )
    (if (== op .part-initial)
      (return (!= (call first-written composite piece case) (. U32 max)))
    )
    (let named (call (. composite node) case piece))
    (return (and (!= named 0) (call piece-adds fact named op)))
  )
  (fn-do _ first-written U32
    (param composite MachineComposite)
    (param piece U32)
    (param case U32)
    ; The first case of a composite written in a case, of those not entered by a trigger, where a
    ; piece of the composite writes it, or none.
    (for (in child (call (. composite children) case))
      (let owner ([] (. composite owners) child))
      (if (== (call (. owner-tree state-trigger) (call (. composite node) child owner)) 0)
        (return (if-expr (== owner piece) child (. U32 max)))
      )
      (lazy owner-tree (. ([] (. program modules) (. ([] (. composite pieces) owner) module)) tree))
    )
    (return (. U32 max))
  )
  (fn-do _ alike-in SyntaxId
    (param composite MachineComposite)
    (param piece U32)
    (param case U32)
    (param source AST)
    (param head SyntaxId)
    ; The head of the group of event transitions a piece of a composite writes in a case, on the
    ; stream the group a transition of another tree heads is on, or none.
    (let named (call (. composite node) case piece))
    (if (== named 0)
      (return 0)
    )
    (let owner (. ([] (. program modules) (. ([] (. composite pieces) piece) module)) tree))
    (for (in given (call (. owner group-heads) (call (. owner state-items) (call (. owner state-body) named))))
      (if (and (not (call (. owner is-state-handler) given)) keyed-alike)
        (return given)
      )
      (lazy keyed-alike (call (. source alike-key) owner (call (. source state-trigger) head) (call (. owner state-trigger) given)))
    )
    (return 0)
  )
  (fn-do _ first-alike U32
    (param composite MachineComposite)
    (param case U32)
    (param source AST)
    (param head SyntaxId)
    ; The first piece of a composite that writes a group in a case on the stream the group a
    ; transition of a tree heads is on, or none.
    (for (in piece (..< 0 (. composite pieces length)))
      (if (!= (call alike-in composite (as piece U32) case source head) 0)
        (return (as piece U32))
      )
    )
    (return (. U32 max))
  )
  (fn-do _ part-environment Operand
    (param piece U32)
    (param site SyntaxId)
    ; The environment of a piece of the machine's composite, which the object holds with its part.
    (let name (call part-name ([] (. (!! (. machining composite)) pieces) piece)))
    (let found (only-if (call property-of (. unit owner-type) name) (if (and name (. unit has-self)))))
    (let held (if-expr found ([] (. tables layouts objects) (. unit owner-type)) no-layout))
    (if (or (not found) (== held no-layout))
      (call refuse .refused-statement site)
      (return (call make-operand .operand-void 0))
    )
    (let field (call (. tables layouts field) held (+ object-header-fields (. ([] (. types properties) found) slot))))
    (let data (. (call (. tables layouts field) (. tables layouts function-layout) 1) offset))
    (return (call load (. unit self) (+ (. field offset) data) managed-layout site))
  )
  (fn-do _ joins-earlier Bool
    (param head SyntaxId)
    ; Whether a group of event transitions joins the group a piece of the machine's composite before
    ; this one writes on the same stream in the case that owns it, as the reference joins the groups
    ; of a case's merged body: that piece's handler tries it (`try-joined`), and it is not subscribed.
    (let place (call machine-group-of head))
    (let owner (if-expr (!= place (. U32 max)) (. ([] (. facts machine-groups) place) owner) 0))
    (if (or (not (. machining composite)) (== owner 0) (call (. tree is-state-handler) head))
      (return false)
    )
    (let case (call composite-case owner))
    (if (== case (. U32 max))
      (return false)
    )
    (for (in piece (..< 0 (. machining piece)))
      (let named (call (. (!! (. machining composite)) node) case piece))
      (let other (. ([] (. program modules) (. ([] (. (!! (. machining composite)) pieces) piece) module)) tree))
      (if (!= named 0)
        (for (in given (call (. other group-heads) (call (. other state-items) (call (. other state-body) named))))
          (if (not (call (. other is-state-handler) given))
            (if (call (. tree alike-key) other (call (. tree state-trigger) head) (call (. other state-trigger) given))
              (return true)
            )
          )
        )
      )
    )
    (return false)
  )
  (fn-do _ try-joined _
    (param head SyntaxId)
    (param group MachineGroup)
    (param item Operand)
    (param answer LocalId)
    (param done IRBlockId)
    ; Where no transition of a group passed, tries the groups the pieces below this one in the
    ; composite of the object's class write on the same stream in the case that owns it, by the part
    ; of the one below it (`relay-part`), which is given where the item and the broadcaster lie and
    ; the place among the facts' groups of the group of the first piece that writes one there; one
    ; whose transition passes leaves to `done`.
    (if (or (not (. machining composite)) (== (. group owner) 0) (call (. tree is-state-handler) head))
      (return)
    )
    (let case (call composite-case (. group owner)))
    (if (== case (. U32 max))
      (return)
    )
    (let first (call first-alike (!! (. machining composite)) case tree head))
    (if (or (== first (. U32 max)) (not (call below-joins case tree head)))
      (return)
    )
    (let joined (call alike-in (!! (. machining composite)) first case tree head))
    (let place (call group-place ([] (. (!! (. machining composite)) pieces) first) joined))
    (if (== place (. U32 max))
      (call refuse .refused-statement head)
      (return)
    )
    (let held (call (. ir add-local) (call layout-of (. group item) head) true))
    (let stream (call (. ir add-local) (call layout-of (. group stream) head) true))
    (call store-local held item head)
    (call store-local stream (call make-operand .operand-argument 2) head)
    (let key (+ (as (. PartOp part-join) U64) (as place U64)))
    (let at (call make-operand .operand-value (call append .op-local-address head (call Span) held pointer-layout)))
    (let from
      (call make-operand
        (block
          (arg .operand-value)
          (arg (call append .op-local-address head (call Span) stream pointer-layout))
        )
      )
    )
    (let passed (call call-below case (as key U32) at from head))
    (let passing (call (. ir reserve-block)))
    (let next (call (. ir reserve-block)))
    (call branch (call compare head .compare-not-equal (. passed operand) (call integer .machine-u8 0)) passing next)
    (call (. ir start-block) passing)
    (call store-local answer (call integer .machine-u8 1) head)
    (call jump done)
    (call (. ir start-block) next)
  )
  (fn-do _ group-place U32
    (param machine MachineFact)
    (param head SyntaxId)
    ; The place among the facts' groups of the group a transition of a machine heads, or none.
    (for (in position (..< (. machine groups start) (+ (. machine groups start) (. machine groups count))))
      (if (== (. ([] (. facts machine-groups) position) head) head)
        (return position)
      )
    )
    (return (. U32 max))
  )
  (fn-do _ enter-path _ (?! Refused)
    (param path (list SyntaxId))
    (param start Size)
    (param via SyntaxId)
    ; Enters the cases of a path from a place on, each below the one before it, which does not
    ; settle; the last is entered by the continuation `via` where one leads there. Where the machine
    ; is a piece of a composite, the path is entered as the composite's (`enter-steps`).
    (let steps (call composite-steps path))
    (if (!= (. steps length) 0)
      (call enter-steps steps start via)
      (return)
    )
    (if (< (+ start 1) (. path length))
      (call enter-below ([] path start) 0 path (+ start 1) via)
      (else
        (call enter-case ([] path start) via)
      )
    )
  )
  (fn-do _ enter-steps _ (?! Refused)
    (param steps (list U32))
    (param start Size)
    (param via SyntaxId)
    ; Enters the cases of a path of the machine's composite from a place on, as `enter-path` does,
    ; where each case this piece does not write is entered by the piece that does (`enter-foreign`).
    (let case ([] steps start))
    (let last (== (+ start 1) (. steps length)))
    (let node (call (. (!! (. machining composite)) node) case (. machining piece)))
    (let site (if-expr (!= node 0) node (. (!! (. machining fact)) syntax)))
    (if (!= ([] (. (!! (. machining composite)) owners) case) (. machining piece))
      (call enter-foreign case (if-expr last via 0) last (if-expr (!= via 0) via site))
      (if (not last)
        (call enter-steps steps (+ start 1) via)
      )
      (return)
    )
    (if last
      (call enter-case node via)
      (return)
    )
    (if (!= (call (. machine-entering find) node) null)
      (call refuse .refused-statement node)
      (return)
    )
    (+= machine-entering node)
    (let turns (. open-turns length))
    (call enter-mark node 0)
    (call enter-entry node)
    (call enter-steps steps (+ start 1) via)
    (call close-turns turns)
    (call (. machine-entering pop))
  )
  (fn-do _ composite-steps (list U32)
    (param path (list SyntaxId))
    ; The cases of the machine's composite a path of this piece's cases names, or none where the
    ; machine is no piece of one or the path names a case none writes.
    (let steps (list U32))
    (if (not (. machining composite))
      (return steps)
    )
    (for (in node path)
      (let case (call composite-case node))
      (if (== case (. U32 max))
        (return (call (of List U32)))
      )
      (+= steps case)
    )
    (return steps)
  )
  (fn-expr _ composite-path (list U32)
    (param name Atom)
    ; The cases from the root of the machine's composite down to the case of a name this piece does
    ; not write, the case last, or none.
    (case? (or (not composite) (!= (call (. tree find-case) (. machining items) name) 0) (== case (. U32 max)))
      (call (of List U32))
    )
    (default
      (call (. composite path-to) case)
    )
    (where
      (lazy composite (. machining composite))
      (lazy case (call (. composite case-named) name))
    )
  )
  (fn-expr _ path-to (list SyntaxId)
    (param node SyntaxId)
    ; The cases from the machine's root down to a case, the case last; a continuation that enters a
    ; case none writes is alone.
    (call (. tree path-to) (. machining items) node)
  )
  (fn-do _ bind-path _
    (param node SyntaxId)
    ; The names the activations of a case and of the cases above it see, bound from the root down,
    ; as the reference binds the path of the case.
    (for (in item (call path-to node))
      (call bind-activation item)
    )
  )
  (fn-do _ emit-entries _
    (param node SyntaxId)
    ; The statements a case's or a continuation's body runs as it is entered, in order; a named
    ; machine among them starts there (`start-nested`).
    (for (in item (call (. tree state-items) (call (. tree state-body) node)))
      (if (!= (call (. tree nested-machine) item) 0)
        (call start-nested item)
        (else-if (call (. tree is-entry-item) item)
          (call emit-statement item)
        )
      )
    )
  )
  (fn-do _ make-payload Typed
    (param activation SyntaxId)
    (param type TypeId)
    (param position U32)
    ; What a case holds, made of what a transition gives it: each value converted as the type
    ; pass recorded, alone or as the fields of a tuple. A case given nothing holds its number, as
    ; a union's case with no value of its own does.
    (let nothing (call make-operand .operand-void 0))
    (if (== type (. types void-type))
      (let union (call layout-of (. (!! (. machining fact)) union) activation))
      (if (not (call (. tables layouts is-union) union))
        (call refuse .refused-expression activation)
        (return (call Typed nothing no-type))
      )
      (return (call Typed (call integer .machine-u8 position) (. (call (. tables layouts case-field) union position) type)))
    )
    (let targets (call (. tree state-targets) activation))
    (if (== (. targets count) 1)
      (let target ([] (. tree children) (. targets start)))
      (let value (call convert target .reason-argument (call emit-expression target)))
      (if (!= (. value type) type)
        (call refuse .refused-conversion target)
      )
      (return value)
    )
    (let layout (call layout-of type activation))
    (if (not (call (. tables layouts is-struct) layout))
      (call refuse .refused-expression activation)
      (return (call Typed nothing no-type))
    )
    (let made (call frame layout))
    (call zero made layout)
    (let offset 0u32)
    (for (in target ([] (. tree children) targets))
      (let value (call convert target .reason-argument (call emit-expression target)))
      (let field (call (. tables layouts field) layout offset))
      (if (!= (. value type) (. field type))
        (call refuse .refused-conversion target)
        (return (call Typed nothing no-type))
      )
      (call put made field (. value operand) target)
      (+= offset 1)
    )
    (return (call Typed made type))
  )
  (fn-do _ store-machine _
    (param value Operand)
    (param site SyntaxId)
    ; Keeps the machine's value: in its environment, and in the local, the global or the property
    ; that names it, or the name a named machine written in a case of another declares. A global
    ; holds a value from then on, so its state says so, and its cases read it as the reference's
    ; do while the machine starts. A machine that refines another keeps none: the cases it adds are
    ; none of the union the property holds.
    (if (!= (. (!! (. machining fact)) refined) no-instance)
      (return)
    )
    (call keep (. (!! (. machining fact)) syntax) "(value)" value site)
    (let named (and (== (. (!! (. machining fact)) store) .store-nested) (!= (. (!! (. machining slots)) bound) no-slot)))
    (if (or (== (. (!! (. machining fact)) store) .store-local) named)
      (call keep-captured (. (!! (. machining slots)) bound) value (. (!! (. machining fact)) union) site)
      (else-if (== (. (!! (. machining fact)) store) .store-member)
        (let name (call decl-name (. (!! (. machining fact)) module) (. (!! (. machining fact)) decl)))
        (if name
          (call put-member name value site)
          (else
            (call refuse .refused-statement site)
          )
        )
      )
      (else-if (== (. (!! (. machining fact)) store) .store-global)
        (let row (call (. tables storage-of) (. (!! (. machining fact)) module) (. (!! (. machining fact)) decl)))
        (if (== row no-storage)
          (call refuse .refused-statement site)
          (return)
        )
        (let kept ([] (. tables storage) row))
        (call store-global kept value site)
        (if (!= (. kept state) no-string)
          (call store-release (call make-operand .operand-symbol (. kept state)) 0 (call integer .machine-u8 1) site)
        )
      )
    )
  )
  (fn-do _ keep-active _
    (param held SyntaxId)
    (param active Bool)
    (param site SyntaxId)
    ; Keeps whether the case kept at a node is active: in the machine's environment, and where a
    ; property of a class holds the machine or its markup writes it, in the object's flag of the
    ; case too, as the reference keeps it. A case of a machine of a class's markup that holds a
    ; value has no flag but its projection (`project`).
    (call keep held "(active)" (call integer .machine-u8 (if-expr active 1 0)) site)
    (if (and (== (. (!! (. machining fact)) store) .store-content) (== (call case-type held) (. types void-type)))
      (call put-member (!! (call (. tree state-name) held)) (call integer .machine-u8 (if-expr active 1 0)) site)
    )
    (if (!= (. (!! (. machining fact)) store) .store-member)
      (return)
    )
    (let name (call decl-name (. (!! (. machining fact)) module) (. (!! (. machining fact)) decl)))
    (if (not name)
      (call refuse .refused-statement site)
      (return)
    )
    (call put-member
      (block
        (arg (call (. program store-atom) (str "(" (. name text) "-" (. (!! (call (. tree state-name) held)) text) "-active)")))
        (arg (call integer .machine-u8 (if-expr active 1 0)))
        (arg site)
      )
    )
  )
  (fn-do _ put-member _
    (param name Atom)
    (param value Operand)
    (param site SyntaxId)
    ; Stores a value in a stored property of the object a machine is written for, as an assignment
    ; does.
    (let found (only-if (call property-of (. unit owner-type) name) (if (. unit has-self))))
    (let held (if-expr found ([] (. tables layouts objects) (. unit owner-type)) no-layout))
    (if (or (not found) (== held no-layout) (!= (. ([] (. types properties) found) storage-kind) .storage-eager))
      (call refuse .refused-statement site)
      (return)
    )
    (let property ([] (. types properties) found))
    (call put-property
      (block
        (arg (. unit self))
        (arg (call (. tables layouts field) held (+ object-header-fields (. property slot))))
        (arg property)
        (arg value)
        (arg site)
        (arg (. U32 max))
        (arg false)
        (arg (call memo-flag-of (. unit owner-type) property))
      )
    )
  )
  (fn-do _ keep-names _
    (param held SyntaxId)
    (param activation SyntaxId)
    (param position U32)
    ; Keeps each name a case keeps from what entered it: what the name reads where the transition
    ; that enters it fires, or where none is in reach there, no object for a class or an interface,
    ; a named tuple or struct with its fields' first values, as the reference constructs one with
    ; no argument, and else the value a local of its type has with none written, as the reference
    ; keeps it. A named tuple or struct that declares a constructor has no shape here.
    (for (in name ([] (. machining kept) position))
      (let text (str "(kept " (. name text) ")"))
      (let read (call kept-read activation name))
      (if (!= read no-slot)
        (let value (call read-machine-name read activation))
        (call keep held text (. value operand) activation)
        (continue)
      )
      (let type (call kept-type held text activation))
      (let layout (call layout-of type activation))
      (let value (call make-operand .operand-void 0))
      (if (and (call (. tables is-class) type) (or (== layout pointer-layout) (== layout managed-layout)))
        (= value (call integer (as layout MachineKind) 0))
        (else-if (and (== (call intrinsic type) .interface) (call (. tables layouts is-struct) layout))
          (= value (. (call null-value type layout activation) operand))
        )
        (else-if (and (call is-aggregate type) (not (call (. types is-plain-tuple) type)))
          (if (call (. tables writes-constructor) type)
            (call refuse .refused-type activation)
            (return)
          )
          (= value (call make-fields type layout (call (of RowRange ArgumentFill)) (. given length) 0 activation))
        )
        (else
          (= value (. (call default-value 0 type layout activation) operand))
        )
      )
      (call keep held text value activation)
    )
  )
  (fn-do _ kept-read SlotId
    (param activation SyntaxId)
    (param name Atom)
    ; The local a name a case keeps reads where a transition enters the case, or none.
    (for (in read (. bindings machine-reads))
      (if (and (== (. read module) (. (!! (. machining fact)) module)) (== (. read site) activation) (== (. read name) name))
        (return (. read slot))
      )
    )
    (return no-slot)
  )
  (fn-do _ read-machine-name Typed
    (param slot SlotId)
    (param site SyntaxId)
    ; What a name in reach where a transition fires holds: a name its pattern bound too.
    (let offset (call slot-offset slot site))
    (if (call is-bound slot)
      (return (call read-bound slot site (call (. facts slot-type) (. unit instance) offset)))
    )
    (if (call is-captured slot)
      (let held (. (call find-captured slot site) type))
      (return (call read-captured slot site held))
    )
    (return (call read-local slot site (call (. facts slot-type) (. unit instance) offset)))
  )
  (fn-do _ add-one Operand
    (param value Operand)
    (param site SyntaxId)
    ; A generation after another.
    (return (call arithmetic site .arithmetic-add value (call integer .machine-u32 1) u32-layout))
  )
  (fn-do _ project _
    (param node SyntaxId)
    (param active Bool)
    (param payload Operand)
    (param site SyntaxId)
    ; A case's projection, where the machine projects its cases: whether it is active, or what it
    ; holds while it is, and nothing while it is not. A machine of a class's markup projects what a
    ; case holds in the object's property of its name (`project-member`).
    (if (== (. (!! (. machining fact)) store) .store-content)
      (call project-member node active payload site)
      (return)
    )
    (if (!= (. (!! (. machining fact)) store) .store-none)
      (return)
    )
    (let slot (call (. bindings declared-at) (call binding-slots) (. (!! (. machining fact)) syntax) (!! (call (. tree state-name) node))))
    (if (== slot no-slot)
      (return)
    )
    (let held (. (call find-captured slot site) type))
    (if (== held (. types bool-type))
      (call keep-captured slot (call integer .machine-u8 (if-expr active 1 0)) held site)
      (return)
    )
    (let layout (call layout-of held site))
    (let value (call empty-optional held layout))
    (if active
      (= value (call wrap site (call Typed payload (call (. types optional-inner) held)) held))
    )
    (call keep-captured slot (. value operand) held site)
  )
  (fn-do _ project-member _
    (param node SyntaxId)
    (param active Bool)
    (param payload Operand)
    (param site SyntaxId)
    ; What a case of a machine of a class's markup that holds a value holds while it is active, and
    ; nothing while it is not, in the object's property of its name, as the reference projects it.
    (if (== (call case-type node) (. types void-type))
      (return)
    )
    (let name (!! (call (. tree state-name) node)))
    (let found (only-if (call property-of (. unit owner-type) name) (if (. unit has-self))))
    (if (not found)
      (call refuse .refused-statement site)
      (return)
    )
    (let held (. ([] (. types properties) found) type))
    (let layout (call layout-of held site))
    (let value (call empty-optional held layout))
    (if active
      (= value (call wrap site (call Typed payload (call (. types optional-inner) held)) held))
    )
    (call put-member name (. value operand) site)
  )
  (fn-do _ exit-case _
    (param node SyntaxId)
    ; Exits a case, as the reference expands its exit: its active cases exit, last first; the
    ; activations of it and the cases above it are bound, its groups are unsubscribed, and those of
    ; each other continuation that enters it, it is no longer active nor projected so, and its
    ; `do finally` blocks run and the named machines written in it stop, last first, and then the
    ; tasks its activation owns are cancelled (`close-tasks`). The turns of the activations it binds
    ; end there. Where the machine is a piece of a composite, the cases below it are the composite's
    ; (`exit-below`), the pieces below this one that name the case again unsubscribe the groups they
    ; add after these, and run what they add to its exit before these, last first; one a piece above
    ; writes is exited by that piece.
    (if (call foreign-case node)
      (let case (call composite-case node))
      (do
        (inline (call call-part ([] (. (!! (. machining composite)) owners) case) case .part-exit node))
      )
      (return)
    )
    (let items (call (. tree state-items) (call (. tree state-body) node)))
    (call exit-below node)
    (let turns (. open-turns length))
    (let rebound (. rebindings length))
    (call bind-path node)
    (call unsubscribe-groups items)
    (for (in continuation (call (. tree continuations-named) (. machining items) (!! (call (. tree state-name) node))))
      (if (!= continuation node)
        (call unsubscribe-groups (call (. tree state-items) (call (. tree state-body) continuation)))
      )
    )
    (call contribute node .part-unsubscribe)
    (call keep-active (call case-node node) false node)
    (call project node false (call make-operand .operand-void 0) node)
    (call contribute node .part-finally)
    (call finish-items items)
    (call close-tasks (call case-node node) node)
    (call close-turns turns)
    (call restore-cells rebound)
  )
  (fn-do _ finish-items _
    (param items (list SyntaxId))
    ; The `do finally` blocks of a body run and the named machines written in it stop, last first.
    (let place (. items length))
    (while (!= place 0)
      (-= place 1)
      (if (!= (call (. tree nested-machine) ([] items place)) 0)
        (call stop-nested ([] items place))
        (continue)
      )
      (match? ([] (. tree nodes) ([] items place))
        (case (call .node-do-finally-block row)
          (call emit-block (. row body))
        )
      )
    )
  )
  (fn-do _ exit-below _
    (param node SyntaxId)
    ; Exits each active case written below a case, last first: those of the machine's composite,
    ; where it is a piece of one, each exited by the piece that writes it, those the pieces below
    ; this one write first (`relay-part`).
    (if (not (. machining composite))
      (let cases (call (. tree explicit-cases) (call (. tree state-items) (call (. tree state-body) node))))
      (let position (. cases length))
      (while (!= position 0)
        (-= position 1)
        (call exit-case-if-active ([] cases position))
      )
      (return)
    )
    (let case (call composite-case node))
    (if (call below-adds case .part-exit-added)
      (do
        (inline (call call-below case .part-exit-added (call nowhere) (call nowhere) node))
      )
    )
    (call exit-composite (call (. (!! (. machining composite)) descendants) case))
  )
  (fn-do _ exit-composite _
    (param cases (list U32))
    ; Exits each active case of the machine's composite of those given, last first, by the piece
    ; that writes it.
    (let position (. cases length))
    (while (!= position 0)
      (-= position 1)
      (let case ([] cases position))
      (let owner ([] (. (!! (. machining composite)) owners) case))
      (if (== owner (. machining piece))
        (call exit-case-if-active (call (. (!! (. machining composite)) node) case owner))
        (else
          (do
            (inline (call call-part owner case .part-exit (. (!! (. machining fact)) syntax)))
          )
        )
      )
    )
  )
  (fn-do _ exit-case-if-active _ (?! Refused)
    (param node SyntaxId)
    ; Exits a case where it is active; one another piece of the machine's composite writes is exited
    ; by that piece.
    (if (call foreign-case node)
      (call exit-case node)
      (return)
    )
    (let running (call (. ir reserve-block)))
    (let done (call (. ir reserve-block)))
    (call branch (. (call read-flag node node) operand) running done)
    (call (. ir start-block) running)
    (call exit-case node)
    (call jump done)
    (call (. ir start-block) done)
  )
  (fn-do _ exit-all _
    ; Exits each active case of the machine, last first. Where the machine is a piece of a
    ; composite, the machine none refines exits each of the composite's, those the pieces below it
    ; write first (`relay-part`), and then those only a continuation enters.
    (if (and (. machining composite) (!= (. machining piece) 0))
      (do
        (inline (call call-part 0 (. U32 max) .part-exit-all (. (!! (. machining fact)) syntax)))
      )
      (return)
    )
    (let position (. machining cases length))
    (if (. machining composite)
      (if (call below-adds (. U32 max) .part-exit-added)
        (do
          (inline (call call-below (. U32 max) .part-exit-added (call nowhere) (call nowhere) (. (!! (. machining fact)) syntax)))
        )
      )
      (call exit-composite (call (. (!! (. machining composite)) descendants) (. U32 max)))
    )
    (while (!= position 0)
      (-= position 1)
      (if (== (call composite-case ([] (. machining cases) position)) (. U32 max))
        (call exit-case-if-active ([] (. machining cases) position))
      )
    )
  )
  (fn-do _ exit-descendants _
    (param node SyntaxId)
    ; Exits each active case written in a case's body, last first; those of a case another piece of
    ; the machine's composite writes are exited by that piece.
    (if (call foreign-case node)
      (let case (call composite-case node))
      (do
        (inline (call call-part ([] (. (!! (. machining composite)) owners) case) case .part-exit-below node))
      )
      (return)
    )
    (call exit-below node)
  )
  (fn-do _ fire-event _
    (param transition SyntaxId)
    (param owner SyntaxId)
    ; A transition a group's item passed, as the reference fires it from the case the group's owner
    ; names: a case exits the cases active below that case, or every active case at the root, and
    ; is entered; a continuation into a case written in the machine leaves the branch the two do not
    ; share (`move-between`), and any other exits that case, or every active case, and enters the
    ; case it names. One into a case another piece of the machine's composite writes, which this
    ; piece does not name, moves there by the composite's paths (`move-into`).
    (let found (if-expr (!= owner 0) (call (. tree find-case) (. machining items) (!! (call (. tree state-name) owner))) 0))
    (let leaving (if-expr (!= found 0) found owner))
    (if (is ([] (. tree nodes) transition) .node-state-case)
      (if (!= leaving 0)
        (call exit-descendants leaving)
        (else
          (call exit-all)
        )
      )
      (call enter-case transition 0)
      (return)
    )
    (let target (call (. tree find-case) (. machining items) (!! (call (. tree state-name) transition))))
    (let steps (call composite-path (!! (call (. tree state-name) transition))))
    (if (!= (. steps length) 0)
      (call move-into leaving steps transition)
      (return)
    )
    (if (and (!= leaving 0) (!= target 0))
      (call move-between leaving target transition)
      (return)
    )
    (if (!= leaving 0)
      (call exit-case-if-active leaving)
      (else
        (call exit-all)
      )
    )
    (call enter-continuation transition)
  )
  (fn-do _ move-between _
    (param source SyntaxId)
    (param target SyntaxId)
    (param via SyntaxId)
    ; A continuation from a case into another case written in the machine, as the reference moves
    ; between them: the case on the source's path where the two paths part exits, and the cases of
    ; the target's path from there on are entered, the target by the continuation.
    (let depth (call (. tree transition-depth) (. machining items) source target))
    (call exit-case-if-active ([] (call path-to source) depth))
    (call enter-path (call path-to target) depth via)
  )
  (fn-do _ move-into _
    (param source SyntaxId)
    (param steps (list U32))
    (param via SyntaxId)
    ; A continuation from a case, or from the root for none, into a case of the machine's composite
    ; that this piece does not name, whose path `steps` is, as `move-between` moves: below the case
    ; where the case is on that path, its active cases exited, and else from where the two paths
    ; part, the case on the source's path there exited.
    (if (== source 0)
      (call exit-all)
      (call enter-steps steps 0 via)
      (return)
    )
    (let leaving (call path-to source))
    (let origin (call composite-steps leaving))
    (if (== (. origin length) 0)
      (call refuse .refused-statement via)
      (return)
    )
    (let place (call (. steps find) ([] origin (- (. origin length) 1))))
    (if (and (!= place null) (< (+ place 1) (. steps length)))
      (call exit-descendants source)
      (call enter-steps steps (+ place 1) via)
      (return)
    )
    (let depth 0)
    (while (and (< depth (. origin length)) (< depth (. steps length)) (== ([] origin depth) ([] steps depth)))
      (+= depth 1)
    )
    (if (>= depth (. origin length))
      (= depth (- (. origin length) 1))
    )
    (if (>= depth (. steps length))
      (= depth (- (. steps length) 1))
    )
    (call exit-case-if-active ([] leaving depth))
    (call enter-steps steps depth via)
  )
  (fn-do _ enter-continuation _
    (param continuation SyntaxId)
    ; Enters the case a continuation names, its own entry statements first; one no case is written
    ; for is entered as that case, and one only another piece of the machine's composite writes is
    ; entered by that piece.
    (let target (call (. tree find-case) (. machining items) (!! (call (. tree state-name) continuation))))
    (let steps (call composite-path (!! (call (. tree state-name) continuation))))
    (if (!= (. steps length) 0)
      (call enter-steps steps (- (. steps length) 1) continuation)
      (else-if (== target 0)
        (call enter-case continuation 0)
      )
      (else
        (call enter-case target continuation)
      )
    )
  )
  (fn-do _ fire-fallback _
    (param fallback SyntaxId)
    ; A fallback where no transition of its group passed: the case it names exits where it is
    ; active, or one no case is written for is no longer active; one only another piece of the
    ; machine's composite writes is exited by that piece.
    (let target (call (. tree find-case) (. machining items) (!! (call (. tree state-name) fallback))))
    (let steps (call composite-path (!! (call (. tree state-name) fallback))))
    (if (!= (. steps length) 0)
      (let case ([] steps (- (. steps length) 1)))
      (do
        (inline (call call-part ([] (. (!! (. machining composite)) owners) case) case .part-exit fallback))
      )
      (else-if (!= target 0)
        (call exit-case-if-active target)
      )
      (else
        (call keep-active (call case-node fallback) false fallback)
      )
    )
  )
  (fn-do _ emit-immediates _
    (param items (list SyntaxId))
    (param active SyntaxId)
    (param settles Bool (= false))
    ; A body's immediate transitions, as the reference runs them once it is entered: each tests its
    ; condition, or matches its subject with its pattern, in turn, and a continuation with no trigger
    ; always passes; the first that passes leaves the case entered, `active`, or every active case
    ; where none was, as `pass-immediate` says, and enters its case, and where a part tries them,
    ; it answers so (`immediate-passed`). Where none passes, a case that `settles` enters its first
    ; case, and then their fallback fires. Where the machine is a piece of a composite, those the
    ; pieces below this one add to the case are tried after these, and the first case is the
    ; composite's (`settle-steps`). A first case given what its name is written with
    ; that the binder did not bind there (`enters-initial`) has no shape here.
    (let transitions (call (. tree immediate-transitions) items))
    (let initial (if-expr settles (call (. tree initial-case) items) 0))
    (if (and (!= initial 0) (not (call (. tree enters-initial) (. machining items) active)))
      (call refuse .refused-statement initial)
      (return)
    )
    (let merged (and settles (!= active 0) (!= (call composite-case active) (. U32 max))))
    (let done (call (. ir reserve-block)))
    (for (in transition transitions)
      (let trigger (call (. tree state-trigger) transition))
      (if (== trigger 0)
        (call pass-immediate active transition)
        (call note-passed transition)
        (call jump done)
        (call (. ir start-block) done)
        (return)
      )
      (let next (call (. ir reserve-block)))
      (let subject (call (. tree trigger-subject) trigger))
      (if (!= subject 0)
        (let value (call emit-expression subject))
        (do
          (inline (call emit-pattern (call (. tree trigger-match) trigger) value next))
        )
        (else
          (let condition (call (. tree trigger-condition) trigger))
          (let passed (call (. ir reserve-block)))
          (call branch-on condition passed next)
          (call (. ir start-block) passed)
        )
      )
      (call pass-immediate active transition)
      (call note-passed transition)
      (call jump done)
      (call (. ir start-block) next)
    )
    (if merged
      (call settle-steps active done)
      (else-if (!= initial 0)
        (call enter-case initial 0)
      )
    )
    (let fallback (call (. tree immediate-fallback) items))
    (if (!= fallback 0)
      (call fire-fallback fallback)
    )
    (call jump done)
    (call (. ir start-block) done)
  )
  (fn-do _ note-passed _
    (param site SyntaxId)
    ; Keeps that an immediate transition a part tried passed, where one does.
    (if (!= immediate-passed no-local)
      (call store-local immediate-passed (call integer .machine-u8 1) site)
    )
  )
  (fn-do _ settle-steps _
    (param active SyntaxId)
    (param done IRBlockId)
    ; What settles a case this piece of the machine's composite writes where none of its own
    ; immediate transitions passed: those the pieces below it in the composite of the object's class
    ; add to it, tried by the part of the one below it (`relay-part`), one that passes leaving to
    ; `done`; then its first case of those every piece writes in it, this piece's where it writes
    ; one, else the first a piece below writes, entered by that piece.
    (let case (call composite-case active))
    (if (call below-adds case .part-immediates)
      (let passed (call call-below case .part-immediates (call nowhere) (call nowhere) active))
      (let next (call (. ir reserve-block)))
      (call branch (call compare active .compare-not-equal (. passed operand) (call integer .machine-u8 0)) done next)
      (call (. ir start-block) next)
    )
    (let first (call first-written (!! (. machining composite)) (. machining piece) case))
    (if (!= first (. U32 max))
      (call enter-case (call (. (!! (. machining composite)) node) first (. machining piece)) 0)
      (else-if (call below-adds case .part-initial)
        (do
          (inline (call call-below case .part-initial (call nowhere) (call nowhere) active))
        )
      )
    )
  )
  (fn-do _ pass-immediate _
    (param active SyntaxId)
    (param transition SyntaxId)
    ; An immediate transition that passed where a case was entered, as the reference passes it: a
    ; continuation into a case written below that case enters the path down to it from there, its
    ; active cases exited; one into another case written in the machine leaves the branch the two do
    ; not share (`move-between`); a case written in the body of the case entered exits only that
    ; case's active cases. Anything else exits the case entered, or every active case where none
    ; was, and enters its case. A continuation into a case another piece of the machine's composite
    ; writes, which this piece does not name, moves there by the composite's paths (`move-into`).
    (let continuation (is ([] (. tree nodes) transition) .node-state-continuation))
    (let target (if-expr continuation (call (. tree find-case) (. machining items) (!! (call (. tree state-name) transition))) 0))
    (let steps (if-expr continuation (call composite-path (!! (call (. tree state-name) transition))) (call (of List U32))))
    (if (and (!= active 0) (!= (. steps length) 0))
      (call move-into active steps transition)
      (return)
    )
    (if (and (!= active 0) (!= target 0))
      (let path (call path-to target))
      (let place (call (. path find) active))
      (if (and (!= place null) (< (+ place 1) (. path length)))
        (call exit-descendants active)
        (call enter-path path (+ place 1) transition)
        (return)
      )
      (call move-between active target transition)
      (return)
    )
    (let children (list SyntaxId))
    (if (!= active 0)
      (= children (call (. tree child-cases) (call (. tree state-items) (call (. tree state-body) active))))
    )
    (if (and (not continuation) (!= active 0) (!= (call (. children find) transition) null))
      (call exit-descendants active)
      (call enter-case transition 0)
      (return)
    )
    (if (!= active 0)
      (call exit-case-if-active active)
      (else
        (call exit-all)
      )
    )
    (if continuation
      (call enter-continuation transition)
      (else
        (call enter-case transition 0)
      )
    )
  )
  (fn-do _ machine-group-of U32
    (param head SyntaxId)
    ; The place among the facts' groups of the group a transition heads, or none.
    (for (in position (..< (. (!! (. machining fact)) groups start) (+ (. (!! (. machining fact)) groups start) (. (!! (. machining fact)) groups count))))
      (if (== (. ([] (. facts machine-groups) position) head) head)
        (return position)
      )
    )
    (return (. U32 max))
  )
  (fn-do _ subscribe-groups _
    (param items (list SyntaxId))
    ; Subscribes each group of a body's event transitions, as the reference does: its stream is
    ; made a broadcaster, a record of the activation is made, which holds the machine's
    ; environment, says it is current and not yet subscribed, and the subscriber the activation's
    ; function runs with the record is kept with the broadcaster. The record is then subscribed,
    ; and the subscriber given to the broadcaster's `subscribe`, whose error is given to the global
    ; `unhandled-error`, with the group's deferral, which runs the activation through the event
    ; runtime's queue. A group on an event of an object attaches the port the machine keeps for it
    ; to the endpoint the event runtime keeps for the event (`attach-group`). One the event runtime
    ; runs from the table of the class is not subscribed: the object holds its port for the table.
    ; A group on a stream that is only iterable is read at once (`iterate-group`). One on an event
    ; that is not live (`settle-events`) evaluates only the object, as a loop on it does, and
    ; subscribes nothing.
    (for (in head (call (. tree group-heads) items))
      (if (call joins-earlier head)
        (continue)
      )
      (let place (call machine-group-of head))
      (let record (. tables machine-record))
      (let handler (if-expr (!= place (. U32 max)) (call (. tables machine-handler-of) place) no-function))
      (if (or (== handler no-function) (== record no-layout) (== (. unit environment) no-local))
        (call refuse .refused-statement head)
        (return)
      )
      (let group ([] (. facts machine-groups) place))
      (let trigger (call (. tree group-trigger) head))
      (if (. group iterated)
        (call iterate-group head group handler)
        (continue)
      )
      (if (. group lowered)
        (call lower-group head place handler)
        (continue)
      )
      (if (!= (. group event) (. U32 max))
        (let used ([] (. facts event-uses) (. group event)))
        (if (== (call (. tables event-number) (. used owner) (. used name)) (. U32 max))
          (call event-owner (. used reference) (. used owner))
          (else
            (call attach-group head group handler)
          )
        )
        (continue)
      )
      (let stream (call emit-broadcastable trigger (call (. tree group-stream) head)))
      (let mark (. pending length))
      (+= pending (call integer .machine-u64 (. ([] (. tables layouts rows) record) size)))
      (+= pending (call make-operand .operand-descriptor record))
      (let made (call call-runtime .runtime-allocate-object head mark managed-layout))
      (call store
        (block
          (arg made)
          (arg (. (call (. tables layouts field) record 0) offset))
          (arg (call load-local (. unit environment) head))
          (arg true)
          (arg head)
        )
      )
      (call store made (. (call (. tables layouts field) record 1) offset) (call integer .machine-u8 1) false head)
      (let subscriber (call make-callback (+ handler 3) made head))
      (let subscribers (call kept-type head "(subscriber)" head))
      (let sources (call kept-type head "(source)" head))
      (call keep
        (block
          (arg head)
          (arg "(subscriber)")
          (arg (. (call wrap head (call Typed subscriber (. group subscriber)) subscribers) operand))
          (arg head)
        )
      )
      (call keep head "(source)" (. (call wrap head (call Typed (. stream operand) (. group stream)) sources) operand) head)
      (call store made (. (call (. tables layouts field) record 2) offset) (call integer .machine-u8 1) false head)
      (call call-subscription
        (block
          (arg head)
          (arg (. group subscribe))
          (arg (. stream operand))
          (arg (. group stream))
          (arg subscriber)
          (arg (. group subscriber))
        )
      )
    )
  )
  (fn-do _ attach-group _
    (param head SyntaxId)
    (param group MachineGroup)
    (param handler FunctionId)
    ; Attaches the port the machine keeps for a group on an event of an object to the endpoint the
    ; event runtime keeps for the event, as the reference does where the group's owner enters: the
    ; port is made the first time, with the subscriber the group's activation runs with the
    ; machine's environment, and kept for the next time.
    (let stream (call event-stream (call (. tree group-trigger) head) ([] (. facts event-uses) (. group event))))
    (let ports (call kept-type head "(subscriber)" head))
    (let mark (. pending length))
    (+= pending (. (call read-kept head "(subscriber)" head) operand))
    (+= pending (call make-callback (+ handler 2) (call load-local (. unit environment) head) head))
    (+= pending (. stream operand))
    (let port (call call-instance (. group attach) head mark))
    (call keep head "(subscriber)" (. (call wrap head port ports) operand) head)
  )
  (fn-do _ iterate-group _
    (param head SyntaxId)
    (param group MachineGroup)
    (param handler FunctionId)
    ; A group on a stream that is only iterable, where its owner subscribes it, as the reference
    ; loops over it: the container is evaluated once and begun, and each item it gives is given to
    ; the group's handler with the machine's environment and the container, in a loop that does
    ; not poll; a stream is told after that the loop has ended.
    (let trigger (call (. tree group-trigger) head))
    (let written (call (. tree group-stream) head))
    (let slot (call loop-slots trigger))
    (let kind (call hold-container trigger written slot))
    (if (!= kind (. group stream))
      (call refuse .refused-statement head)
      (return)
    )
    (call begin-items trigger written slot kind)
    (let root (call (. ir reserve-block)))
    (let done (call (. ir reserve-block)))
    (call jump root)
    (call (. ir start-block) root)
    (let item (call read-items trigger trigger written slot kind done))
    (if (!= (. item type) (. group item))
      (call refuse .refused-statement head)
      (return)
    )
    (let mark (. pending length))
    (+= pending (call load-local (. unit environment) head))
    (+= pending (. item operand))
    (+= pending (. (call state slot trigger) operand))
    (call (. ir depend) .callee-function handler may-panic-dependency)
    (do
      (inline
        (call call handler-symbol head mark .callee-function u8-layout (not in-landing)
          (block
            (lazy handler-symbol (call make-operand .operand-symbol (. ([] (. tables functions) handler) symbol)))
          )
        )
      )
    )
    (call jump root)
    (call (. ir start-block) done)
    (if (== (call (. facts plan-of) (. unit reading) trigger) .plan-stream-loop)
      (call end-stream trigger)
    )
  )
  (fn-do _ event-stream Typed
    (param trigger SyntaxId)
    (param used EventUse)
    ; The endpoint the event runtime keeps for the event of an object a group of a machine's event
    ; transitions is on, or the one at the address of a keyed event, which the receiver claims,
    ; made the group's `Broadcastable` as the type pass recorded at its trigger.
    (let owner (call event-owner (. used reference) (. used owner)))
    (let number (call (. tables event-number) (. used owner) (. used name)))
    (if (== number (. U32 max))
      (call refuse .refused-statement trigger)
    )
    (if (!= (. used address) 0)
      (let endpoint (call keyed-endpoint (. used site) used (. owner operand) number))
      (return (call convert trigger .reason-argument endpoint))
    )
    (return (call event-endpoint trigger (. used first) (. owner operand) number))
  )
  (fn-do _ lower-group _
    (param head SyntaxId)
    (param place U32)
    (param handler FunctionId)
    ; A group the event runtime runs from the table of the class the machine is written for, as the
    ; reference makes it where the group would be subscribed: the port of the group is made, with
    ; the subscriber the group's activation runs with the machine's environment and no
    ; broadcaster, kept, and held by the object where the table's function finds it (see
    ; `emit-machine-descriptor`).
    (let group ([] (. facts machine-groups) place))
    (let name (call context-name head))
    (let found (only-if (call property-of (. unit owner-type) name) (if (and name (. unit has-self)))))
    (let object (if-expr found ([] (. tables layouts objects) (. unit owner-type)) no-layout))
    (if (or (not found) (== object no-layout))
      (call refuse .refused-statement head)
      (return)
    )
    (let ports (call kept-type head "(subscriber)" head))
    (let broadcaster (call null-value (. group stream) (call layout-of (. group stream) head) head))
    (let mark (. pending length))
    (+= pending (call make-callback (+ handler 2) (call load-local (. unit environment) head) head))
    (+= pending (. broadcaster operand))
    (let port (call call-instance (. group port) head mark))
    (call keep head "(subscriber)" (. (call wrap head port ports) operand) head)
    (let property ([] (. types properties) found))
    (let field (call (. tables layouts field) object (+ object-header-fields (. property slot))))
    (call store
      (block
        (arg (. unit self))
        (arg (. field offset))
        (arg (call num-cast head (. port operand) managed-layout pointer-layout))
        (arg false)
        (arg head)
      )
    )
  )
  (fn-do _ context-name (? Atom)
    (param head SyntaxId)
    ; The name of the property of an object that holds the record of the activation of a group of
    ; the machine's event transitions for the table of its class.
    (for (in decl (. ([] (. program modules) (. (!! (. machining fact)) module)) decls))
      (match? decl
        (case (call .decl-property row)
          (if (== (. row context) head)
            (return (. row name))
          )
        )
      )
    )
    (return null)
  )
  (fn-do + emit-machine-descriptor _
    ; The function the event runtime calls for a group of a machine's event transitions that it runs
    ; from the table of the class, given the object and what was published, as the reference
    ; compiles it: where the object holds the port of the group, what was published is posted to it.
    (let group ([] (. facts machine-groups) (. function place)))
    (let head (. group head))
    (let row (call machine-descriptor-of (. function place) (. function type)))
    (= unit (= (. unit source-module) (call machine-module-of (. function place))))
    (call (. ir add-argument) managed-layout)
    (call (. ir add-argument) (call layout-of (. group item) head))
    (= returns-type (. types void-type))
    (= (. ir returns) void-layout)
    (if (or (not row) (== (. group post) no-instance))
      (call refuse .refused-function head)
      (return)
    )
    (let name (call context-name-in (. unit source-module) head))
    (let found (only-if (call property-of (. function type) name) (if name)))
    (let object (if-expr found ([] (. tables layouts objects) (. function type)) no-layout))
    (if (or (not found) (== object no-layout))
      (call refuse .refused-function head)
      (return)
    )
    (let property ([] (. types properties) found))
    (let field (call (. tables layouts field) object (+ object-header-fields (. property slot))))
    (let context (call load (call make-operand .operand-argument 0) (. field offset) pointer-layout head))
    (let posting (call (. ir reserve-block)))
    (let done (call (. ir reserve-block)))
    (call branch (call compare head .compare-not-equal context (call integer .machine-pointer 0)) posting done)
    (call (. ir start-block) posting)
    (let mark (. pending length))
    (+= pending (call num-cast head context pointer-layout managed-layout))
    (+= pending (call make-operand .operand-argument 1))
    (do
      (inline (call call-instance (. group post) head mark))
    )
    (call jump done)
    (call (. ir start-block) done)
    (call return-nothing)
  )
  (fn-do _ machine-descriptor-of (? MachineDescriptor)
    (param group U32)
    (param type TypeId)
    ; The row of the functions the event runtime's table runs for a group of a machine's event
    ; transitions on an object of a class, or none.
    (for (in row (. tables machine-descriptors))
      (if (and (== (. row group) group) (== (. row type) type))
        (return row)
      )
    )
    (return null)
  )
  (fn-do _ machine-module-of ModuleId
    (param group U32)
    ; The module of the machine a group of event transitions is of.
    (for (in machine (. facts machines))
      (if (and (>= group (. machine groups start)) (< group (+ (. machine groups start) (. machine groups count))))
        (return (. machine module))
      )
    )
    (return 0)
  )
  (fn-do _ context-name-in (? Atom)
    (param module ModuleId)
    (param head SyntaxId)
    ; The name of the property that holds the record of the activation of a group of a machine's
    ; event transitions, among the declarations of the machine's module.
    (for (in decl (. ([] (. program modules) module) decls))
      (match? decl
        (case (call .decl-property row)
          (if (== (. row context) head)
            (return (. row name))
          )
        )
      )
    )
    (return null)
  )
  (fn-do _ unsubscribe-groups _
    (param items (list SyntaxId))
    (param leaves-tabled Bool (= false))
    ; Unsubscribes each group of a body's event transitions that is subscribed, as the reference
    ; does: the activation's record says it is no longer current, the subscriber is given to the
    ; broadcaster's `unsubscribe` where the record was subscribed, whose error is given to the
    ; global `unhandled-error`, and the machine keeps no subscriber for the group. The port of a
    ; group on an event of an object is detached from its endpoint, which drops what it queued, and
    ; kept for the next time; one the table runs has no shape here, unless `leaves-tabled`, where it
    ; is left to the table. One on a stream that is only iterable was never subscribed.
    (for (in head (call (. tree group-heads) items))
      (if (call joins-earlier head)
        (continue)
      )
      (let place (call machine-group-of head))
      (let record (. tables machine-record))
      (if (or (== place (. U32 max)) (== record no-layout))
        (call refuse .refused-statement head)
        (return)
      )
      (let group ([] (. facts machine-groups) place))
      (if (. group iterated)
        (continue)
      )
      (if (!= (. group event) (. U32 max))
        (if (and (== (. group detach) no-instance) leaves-tabled)
          (continue)
        )
        (if (== (. group detach) no-instance)
          (call refuse .refused-statement head)
          (return)
        )
        (let mark (. pending length))
        (+= pending (. (call read-kept head "(subscriber)" head) operand))
        (do
          (inline (call call-instance (. group detach) head mark))
        )
        (continue)
      )
      (let held (call read-kept head "(subscriber)" head))
      (let optional (. held type))
      (let holding (call present head held))
      (let running (call (. ir reserve-block)))
      (let done (call (. ir reserve-block)))
      (call branch (. holding operand) running done)
      (call (. ir start-block) running)
      (let subscriber (call payload head (call Typed (. held operand) optional)))
      (let data
        (call load
          (block
            (arg (. subscriber operand))
            (arg (. (call (. tables layouts field) (. tables layouts function-layout) 1) offset))
            (arg managed-layout)
            (arg head)
          )
        )
      )
      (call store data (. (call (. tables layouts field) record 1) offset) (call integer .machine-u8 0) false head)
      (let subscribed (call load data (. (call (. tables layouts field) record 2) offset) u8-layout head))
      (let calling (call (. ir reserve-block)))
      (let called (call (. ir reserve-block)))
      (call branch (call compare head .compare-not-equal subscribed (call integer .machine-u8 0)) calling called)
      (call (. ir start-block) calling)
      (let source (call read-kept head "(source)" head))
      (let stream (call payload head source))
      (call call-subscription
        (block
          (arg head)
          (arg (. group unsubscribe))
          (arg (. stream operand))
          (arg (. group stream))
          (arg (. subscriber operand))
          (arg (. group subscriber))
        )
      )
      (call jump called)
      (call (. ir start-block) called)
      (let layout (call layout-of optional head))
      (call keep head "(subscriber)" (. (call empty-optional optional layout) operand) head)
      (call jump done)
      (call (. ir start-block) done)
    )
  )
  (fn-do + machine-of-union (? MachineFact)
    (param union TypeId)
    ; The state machine whose union a type is, or none.
    (for (in machine (. facts machines))
      (if (== (. machine union) union)
        (return machine)
      )
    )
    (return null)
  )
  (fn-do + start-refined _
    (param machine MachineFact)
    ; Starts a machine that refines another, as the reference starts the two merged: each machine
    ; that refines another, from the one of the object's class up, keeps what it keeps for the
    ; object, and then the machine none refines starts, through the facts of the instance that types
    ; its value for the class that declares it.
    (let current (? MachineFact) machine)
    (while current
      (let own-unit unit)
      (let own-filling filling)
      (= unit (= (. unit source-module) (. current module)))
      (= unit (= (. unit reading) (. ([] (. instances rows) (. current instance)) enclosing)))
      (= filling (= (. filling root) (. current syntax)))
      (do
        (inline (call emit-expression (. current syntax)))
      )
      (= unit own-unit)
      (= filling own-filling)
      (= current (only-if (call (. facts machine-of) (. current refined)) (if (!= (. current refined) no-instance))))
    )
  )
  (fn-expr + resolves-member Bool
    (param id SyntaxId)
    ; Whether a name alone resolves to a member of the object the function is emitted for.
    (case? (== binding no-binding)
      false
    )
    (default
      (== (. (call (. bindings resolution-of) binding id) kind) .resolve-member)
    )
    (where
      (lazy binding (. ([] (. instances rows) (. unit reading)) binding))
    )
  )
  (fn-do + flag-name Atom
    (param property Atom)
    (param name Atom)
    ; The name of the object's flag of a case of the machine a property of its class holds.
    (return (call (. program store-atom) (str "(" (. property text) "-" (. name text) "-active)")))
  )
  (fn-do + composite-classes (list TypeId)
    (param fact MachineFact)
    (param root MachineFact)
    (param owner TypeId)
    ; The classes whose objects start a machine a property of a class holds (`leaf-classes`), where
    ; it is, or refines, the machine of a union, that are or derive from a class, or none.
    (let found (list TypeId))
    (if (!= (. fact outer) 0)
      (return found)
    )
    (let top (? MachineFact) fact)
    (while (and top (!= (. top refined) no-instance))
      (= top (call (. facts machine-of) (. top refined)))
    )
    (if (or (not top) (!= (. top module) (. root module)) (!= (. top syntax) (. root syntax)))
      (return found)
    )
    (for (in type (call (. tables leaf-classes) fact))
      (if (call derives type owner)
        (+= found type)
      )
    )
    (return found)
  )
  (fn-do + classes-branch _
    (param site SyntaxId)
    (param value Operand)
    (param classes (list TypeId))
    (param matched IRBlockId)
    (param missed IRBlockId)
    ; Leaves to `matched` when an object is of one of some classes itself, and to `missed` when it is
    ; of another.
    (let table (call load value 0 pointer-layout site))
    (for (in position (..< 0 (. classes length)))
      (let next (if-expr (== (+ position 1) (. classes length)) missed (call (. ir reserve-block))))
      (let symbol ([] (. tables table-symbols) ([] classes position)))
      (if (== symbol no-string)
        (call jump next)
        (else
          (call branch
            (block
              (arg (call compare site .compare-equal table (call make-operand .operand-symbol symbol)))
              (arg matched)
              (arg next)
            )
          )
        )
      )
      (if (< (+ position 1) (. classes length))
        (call (. ir start-block) next)
      )
    )
    (if (== (. classes length) 0)
      (call jump missed)
    )
  )
  (fn-do + derives Bool
    (param type TypeId)
    (param base TypeId)
    ; Whether a class is another or derives from it.
    (let level (? TypeId) type)
    (while level
      (if (== level base)
        (return true)
      )
      (= level (call (. types base-of) level))
    )
    (return false)
  )
  (fn-do + emit-machine-path Typed
    (param id SyntaxId)
    (param object SyntaxId)
    ; `path` read from a value of a state machine's union, as the reference makes it: an empty list,
    ; given the name of each active case of the machine in turn, its cases written outermost first,
    ; each before those written in it, then those only a continuation enters. The flags are read
    ; where a case test reads them: those of a machine a property of a class holds from the object
    ; written before the property's name, evaluated once, or the one a name alone is read from; any
    ; other's as `machine-flag` reads them. Where the object is of a class whose composite merges the
    ; machine with refinements, the composite's cases are listed (`append-composite`). A value of the
    ; union read from elsewhere than the machine lists the case it holds after those it is written in,
    ; outermost first (`append-held`).
    (let nothing (call make-operand .operand-void 0))
    (let list-type (call (. facts node-type) (. unit reading) id))
    (let union (call (. facts node-type) (. unit reading) object))
    (let machine (call machine-of-union union))
    (let makes no-fact)
    (let append no-instance)
    (let fact (call (. facts first-call) (. unit reading) id))
    (while (!= fact no-fact)
      (let row ([] (. facts calls) fact))
      (if (== (. row form) .call-list-make)
        (= makes fact)
        (else-if (== (. row form) .call-method)
          (= append (. row callee))
        )
      )
      (= fact (. row next))
    )
    (if (or (not machine) (== makes no-fact) (== append no-instance))
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (let member (== (. machine store) .store-member))
    (let live (call reads-machine object machine))
    (let base nothing)
    (let owner no-type)
    (let property (call decl-name (. machine module) (. machine decl)))
    (if (not live)
      (= base (. (call emit-expression object) operand))
      (else-if (and member property)
        (match? ([] (. tree nodes) object)
          (case (call .node-get-expression row)
            (if (and (== (. row name) property) (not (call is-link object)))
              (= owner (call held-type (. row object)))
              (= base (. (call emit-expression (. row object)) operand))
            )
          )
          (case (call .node-identifier row)
            (if (and (== (. row name) property) (call resolves-member object))
              (= owner (call self-owner))
              (= base (. unit self))
            )
          )
        )
        (if (or (== owner no-type) (== owner invalid-type) (not (call (. tables is-class) owner)))
          (call refuse .refused-expression object)
        )
      )
      (else-if (or member (not (is ([] (. tree nodes) object) .node-identifier)))
        (call refuse .refused-expression object)
      )
    )
    (let list (call emit-fact-call id ([] (. facts calls) makes) 0 (call (of RowRange SyntaxId)) 0 0 list-type))
    (if (!= (. list type) list-type)
      (call refuse .refused-conversion id)
    )
    (let machine-tree (. ([] (. program modules) (. machine module)) tree))
    (let items (call (. machine-tree state-items) (call (. machine-tree state-body) (. machine syntax))))
    (let cases (call (. machine-tree machine-cases) items))
    (let order (list SyntaxId))
    (for (in node (call (. machine-tree explicit-cases) items))
      (+= order node)
    )
    (for (in node cases)
      (if (== (call (. order find) node) null)
        (+= order node)
      )
    )
    (let done (call (. ir reserve-block)))
    (if (not live)
      (call append-held id (. list operand) append base machine done)
      (call (. ir start-block) done)
      (return (call Typed (. list operand) list-type))
    )
    (if member
      (for (in position (. tables machine-order))
        (let fact ([] (. facts machines) position))
        (let classes (call composite-classes fact machine owner))
        (let composite (only-if (call compose-machine program facts fact) (if (!= (. classes length) 0))))
        (if composite
          (call append-composite
            (block
              (arg id)
              (arg (. list operand))
              (arg append)
              (arg base)
              (arg composite)
              (arg (!! property))
              (arg classes)
              (arg (call (. tables machine-receiver) fact))
              (arg done)
            )
          )
        )
      )
    )
    (for (in node order)
      (let name (!! (call (. machine-tree state-name) node)))
      (let index (!! (call (. machine-tree case-position) cases name)))
      (let flag nothing)
      (if member
        (let flagged (only-if (call property-of owner (call flag-name property name)) (if property)))
        (if (not flagged)
          (call refuse .refused-expression id)
          (return (call Typed nothing no-type))
        )
        (let field (call held-field id owner flagged))
        (= flag (call load base (. field offset) (. field layout) id))
        (else
          (= flag (. (call machine-flag id machine index done) operand))
        )
      )
      (call append-active id (. list operand) append flag name)
    )
    (call jump done)
    (call (. ir start-block) done)
    (return (call Typed (. list operand) list-type))
  )
  (fn-do _ append-active _
    (param id SyntaxId)
    (param list Operand)
    (param append InstanceId)
    (param flag Operand)
    (param name Atom)
    ; Appends the name of a case to a machine's path where its flag says it is active.
    (let adding (call (. ir reserve-block)))
    (let next (call (. ir reserve-block)))
    (call branch (call compare id .compare-not-equal flag (call integer .machine-u8 0)) adding next)
    (call (. ir start-block) adding)
    (call append-name id list append name)
    (call jump next)
    (call (. ir start-block) next)
  )
  (fn-do _ append-name _
    (param id SyntaxId)
    (param list Operand)
    (param append InstanceId)
    (param name Atom)
    ; Appends the name of a case to a machine's path.
    (let mark (. pending length))
    (+= pending list)
    (+= pending (call make-operand .operand-constant (call (. ir add-string) (. name text))))
    (do
      (inline (call call-instance append id mark))
    )
  )
  (fn-do _ append-held _
    (param id SyntaxId)
    (param list Operand)
    (param append InstanceId)
    (param value Operand)
    (param machine MachineFact)
    (param done IRBlockId)
    ; Appends to a path read from a value of a state machine's union, read from elsewhere than the
    ; machine, the names of the case it holds, the innermost the machine was in when it was read, and
    ; of the cases that case is written in, outermost first, and leaves to `done`.
    (let machine-tree (. ([] (. program modules) (. machine module)) tree))
    (let items (call (. machine-tree state-items) (call (. machine-tree state-body) (. machine syntax))))
    (let cases (call (. machine-tree machine-cases) items))
    (let tag (call load value 0 u8-layout id))
    (for (in position (..< 0 (. cases length)))
      (let adding (call (. ir reserve-block)))
      (let next (call (. ir reserve-block)))
      (call branch (call compare id .compare-equal tag (call integer .machine-u8 (as position U64))) adding next)
      (call (. ir start-block) adding)
      (for (in node (call (. machine-tree path-to) items ([] cases position)))
        (call append-name id list append (!! (call (. machine-tree state-name) node)))
      )
      (call jump done)
      (call (. ir start-block) next)
    )
    (call jump done)
  )
  (fn-do _ append-composite _
    (param id SyntaxId)
    (param list Operand)
    (param append InstanceId)
    (param object Operand)
    (param composite MachineComposite)
    (param property Atom)
    (param classes (list TypeId))
    (param level TypeId)
    (param done IRBlockId)
    ; Appends to a path, where an object is of one of the classes that run a composite typed for a
    ; class itself, the name of each active case of the composite, each before those written in it,
    ; then those only a continuation enters, and leaves to `done`.
    (let missed (call (. ir reserve-block)))
    (let matched (call (. ir reserve-block)))
    (call classes-branch id object classes matched missed)
    (call (. ir start-block) matched)
    (let names (list Atom))
    (for (in name (. composite names))
      (+= names name)
    )
    (for (in fact (. composite pieces))
      (let owner (. ([] (. program modules) (. fact module)) tree))
      (for (in node (call (. owner machine-cases) (call (. owner state-items) (call (. owner state-body) (. fact syntax)))))
        (if (== (call (. names find) (!! (call (. owner state-name) node))) null)
          (+= names (!! (call (. owner state-name) node)))
        )
      )
    )
    (for (in name names)
      (let flagged (call property-of level (call flag-name property name)))
      (if (not flagged)
        (call refuse .refused-expression id)
        (return)
      )
      (let field (call held-field id level flagged))
      (call append-active id list append (call load object (. field offset) (. field layout) id) name)
    )
    (call jump done)
    (call (. ir start-block) missed)
  )
  (fn-expr + self-owner TypeId
    ; The class of the object a member's name alone is read from in the function being emitted, as
    ; `emit-identifier` reads it, or no type where it is read otherwise.
    (case? (not (. unit has-self))
      no-type
    )
    (case? (or (== (. unit reading) (. unit instance)) (== (. unit reading) (. unit lender)))
      (. unit owner-type)
    )
    (case? (!= (. filling count) 0)
      no-type
    )
    (case? (!= (. unit deferred-type) no-type)
      (. unit deferred-type)
    )
    (case? (call evaluates-value)
      (. unit self-type)
    )
    (default
      no-type
    )
  )
  (fn-do + machine-default Typed
    (param machine MachineFact)
    (param site SyntaxId)
    ; What a property that holds a state machine holds until the machine starts: the first case of
    ; its union, as the reference gives a union no value is written for, holding what a local of its
    ; type holds with nothing written (`first-case`).
    (let layout (call layout-of (. machine union) site))
    (if (call (. tables layouts is-union) layout)
      (return (call first-case (. machine union) layout site))
    )
    (call refuse .refused-expression site)
    (return (call Typed (call make-operand .operand-void 0) no-type))
  )
  (fn-do + machine-flag Typed
    (param site SyntaxId)
    (param machine MachineFact)
    (param index U32)
    (param failed IRBlockId)
    ; Whether a machine's case is active, where a case test is in reach of its flag: in the module
    ; of a machine a module's property is, from the global that holds its environment, which fails
    ; the test before the machine starts, in reach of the local a machine is kept in, beside it,
    ; and in the machine around a named machine written in a case of another. Elsewhere the case
    ; test is refused, as the reference tests the tag there.
    (let nothing (call make-operand .operand-void 0))
    (let row (call (. bindings machine-slots) (. machine module) (. machine syntax)))
    (let cases
      (call (. ([] (. program modules) (. machine module)) tree machine-cases)
        (block
          (arg
            (call (. ([] (. program modules) (. machine module)) tree state-items)
              (block
                (arg (call (. ([] (. program modules) (. machine module)) tree state-body) (. machine syntax)))
              )
            )
          )
        )
      )
    )
    (if (or (not row) (>= index (as (. cases length) U32)))
      (call refuse .refused-expression site)
      (return (call Typed nothing no-type))
    )
    (let slot (call (. bindings machine-slot) row ([] cases index) (call (. program store-atom) "(active)")))
    (if (== slot no-slot)
      (call refuse .refused-expression site)
      (return (call Typed nothing no-type))
    )
    (if (or (== (. machine store) .store-local) (and (== (. machine store) .store-nested) (== (. machine instance) (. unit reading))))
      (return (call read-captured slot site (. types bool-type)))
    )
    (let storage (call (. tables storage-of) (. machine module) (. ([] (. instances rows) (. machine instance)) decl)))
    (let layout ([] (. tables environments) (. machine instance)))
    (if (or (!= (. machine store) .store-global) (== storage no-storage) foreign-machine unbuilt-layout)
      (call refuse .refused-expression site)
      (return (call Typed nothing no-type))
    )
    (lazy foreign-machine (!= (. machine module) (. ([] (. instances rows) (. unit reading)) module)))
    (lazy unbuilt-layout (or (== layout no-layout) (== layout unbuilt-environment)))
    (let field (call (. tables layouts field) layout (+ 1 ([] (. tables slot-fields) slot))))
    (let base (call load-global ([] (. tables storage) storage) site))
    (call pass-or-fail
      (block
        (arg (call compare site .compare-not-equal (. base operand) (call integer (as managed-layout MachineKind) 0)))
        (arg failed)
      )
    )
    (return (call Typed (call load (. base operand) (. field offset) (. field layout) site) (. types bool-type)))
  )
)
