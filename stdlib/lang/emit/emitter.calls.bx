        )
      )
      (let converted-2 (call convert item .reason-element ([] given held)))
      (= ([] given held) converted-2)
    )
    (return (call build-list id tail list-type (+ start first) false))
  )
  (fn-do _ append-tail Typed
    (param id SyntaxId)
    (param tail (of RowRange SyntaxId))
    (param start Size)
