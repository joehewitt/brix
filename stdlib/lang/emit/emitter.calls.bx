      (return (call emit-fact-call id fact 0 (call (of RowRange SyntaxId)) 0 index))
    )
    (let callee (. fact callee))
    (if (or (== callee no-instance) (. fact is-partial) (not (call is-callable callee)))
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (if (or (not (call fills-in-order fact callee 1)) (call names-slot object .slot-super))
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
