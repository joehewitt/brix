(import ./emitter)
(import ./emitter.assignments)
(import ./emitter.cleanups)
(import ./emitter.comprehensions)
(import ./emitter.live-actions)
(import ./emitter.markup)
(import ./emitter.match-arms)
(import ./emitter.styles)
(import ./emitter.tables)
(import ./layouts)
(import ./program-tables)
(import ./receiver-stability)
(import ./runtime)
(import ./table-layouts)
(import /core/arena)
(import /core/table)
(import /lang/ast/ast)
(import /lang/ast/ast-children)
(import /lang/ast/ast-nodes)
(import /lang/ast/ast-queries)
(import /lang/ast/decl)
(import /lang/ast/module)
(import /lang/ast/operator)
(import /lang/ast/program)
(import /lang/ast/row-range)
(import /lang/ast/state-machines)
(import /lang/backend/mir)
(import /lang/check/binding)
(import /lang/check/claims)
(import /lang/check/facts)
(import /lang/check/instances)
(import /lang/check/machine-composite)
(import /lang/check/numeric)
(import /lang/check/pattern-helper)
(import /lang/check/probe-casts)
(import /lang/check/table-rows)
(import /lang/check/type-signature)
(import /lang/check/type-store)
(import /lang/check/type-text)
(import /lang/check/types)
(import /lang/ir/ir)
(import /stream/sort)

(type _ Calls (facet-of FunctionEmitter)
  (sees Assignments)
  (sees Cleanups)
  (sees Comprehensions)
  (sees LiveActions)
  (sees Markup)
  (sees MatchArms)
  (sees Styles)
  (sees Tables)
  (fn-expr _ links-into Bool
    (param id SyntaxId)
    (param given TypeId)
    (param expected TypeId)
    ; Whether a value of type `given` is what a link of an optional chain gives by itself, where
    ; its node has the optional that holds it.
    (and (call is-link id) (call (. types is-optional) expected) (== (call (. types optional-inner) expected) given))
  )
  (fn-do _ run-case-owner _
    (param callable SyntaxId)
    ; What is run before a case called after its type is made: the type, when it is more than a
    ; name. A case called by its symbol alone runs nothing.
    (match? ([] (. tree nodes) callable)
      (case (call .node-get-expression get)
        (call run-type-operand (. get object))
      )
    )
  )
  (fn-do + emit-call-at Typed
    (param id SyntaxId)
    (param callable SyntaxId)
    (param operands (of RowRange SyntaxId))
    (param piped SyntaxId (= 0))
    (let pulled (call (. facts pulls) (. unit reading) id))
    (if (and (!= (call (. facts plan-of) (. unit reading) id) .plan-live-call) (not pulled))
      (return (call emit-call id callable operands piped))
    )
    (let live (. instances live))
    (if (or (== (. live enter) no-instance) (== (. live leave) no-instance) (== (. live-actions length) 0))
      (call refuse .refused-expression id)
      (return (call Typed (call make-operand .operand-void 0) no-type))
    )
    (let mark (. pending length))
    (+= pending (call load-local (. ([] live-actions (- (. live-actions length) 1)) previous) id))
    (+= pending (call load-local (. ([] live-actions (- (. live-actions length) 1)) next) id))
    (do
      (inline (call call-instance (. live enter) id mark))
    )
    (let opened (. open-cleanups length))
    (let own-scoping scoping)
    (= scoping (= (. scoping block-base) opened))
    (call open-cleanup id (call UseCell no-local no-local no-type true))
    (return (call close-value (call emit-call id callable operands piped) opened own-scoping id))
  )
  (fn-do + emit-call Typed
    (param id SyntaxId)
    (param callable SyntaxId)
    (param operands (of RowRange SyntaxId))
    (param piped SyntaxId (= 0))
    ; A call written with its arguments: of a C function, or the one call the type pass recorded
    ; at the node, of a function, a static, a constructor, or a method of the value written
    ; before its name. A value piped into the call is its last argument. A write to an event
    ; publishes to it.
    (if (== (call (. facts plan-of) (. unit reading) id) .plan-built-feeds)
      (return (call emit-listed-feeds id (call (. tree listed-feeds) id)))
    )
    (match? ([] (. tree nodes) callable)
      (case .node-c-identifier
        (if (and (== piped 0) (== (call own-call id) no-fact) (call is-binding (call (. facts node-type) (. unit reading) id)))
          (return (call emit-bind id callable operands))
        )
        (if (== piped 0)
          (return (call emit-c-call id operands))
        )
      )
    )
    (if (and (!= (. facts event-uses length) 0) (== piped 0))
      (let used (call (. tables event-use-of) (. unit reading) id))
      (if (and used (== (. used kind) .event-publish))
        (return (call emit-publish id used operands))
      )
      (if (and used (== (. used kind) .event-route))
        (return (call emit-route id used operands))
      )
      (if (and used (or (== (. used kind) .event-rekey) (== (. used kind) .event-release)))
        (return (call emit-readdress id used operands))
      )
    )
    (let plan (call (. facts plan-of) (. unit reading) id))
    (if (or (== plan .plan-relation) (== plan .plan-relation-cast))
      (match? ([] (. tree nodes) callable)
        (case (call .node-get-expression get)
          (if (== piped 0)
            (return (call emit-relation id plan (. get object) operands))
          )
        )
      )
      (call refuse .refused-expression id)
      (return (call Typed (call make-operand .operand-void 0) no-type))
    )
    (if (and (or (== plan .plan-case) (== plan .plan-case-fields)) (== piped 0))
      (call run-case-owner callable)
      (return (call emit-case id operands (== plan .plan-case-fields)))
    )
    (if (== plan .plan-forward)
      (match? ([] (. tree nodes) callable)
        (case (call .node-get-expression get)
          (if (== piped 0)
            (return (call emit-forward id (. get object) operands))
          )
        )
      )
      (call refuse .refused-expression id)
      (return (call Typed (call make-operand .operand-void 0) no-type))
    )
    (if (== plan .plan-table)
      (match? ([] (. tree nodes) callable)
        (case (call .node-get-expression get)
          (if (== piped 0)
            (return (call emit-table-method id (. get object) operands))
          )
        )
      )
      (call refuse .refused-expression id)
      (return (call Typed (call make-operand .operand-void 0) no-type))
    )
    (if (or (== plan .plan-builder-append) (== plan .plan-builder-reserve))
      (match? ([] (. tree nodes) callable)
        (case (call .node-get-expression get)
          (if (== piped 0)
            (return (call emit-builder-method id (. get object) operands (== plan .plan-builder-append)))
          )
        )
        (case .node-identifier
          (if (== piped 0)
            (return (call emit-builder-method id 0 operands (== plan .plan-builder-append)))
          )
        )
      )
      (call refuse .refused-expression id)
      (return (call Typed (call make-operand .operand-void 0) no-type))
    )
    (let fact (call own-call id))
    (if (and (!= fact no-fact) (== (call (. facts plan-of) (. unit reading) id) .plan-count-leading-zeros))
      (if (and (== piped 0) (== (. operands count) 1))
        (return (call emit-leading-zeros id (. ([] (. facts calls) fact) callee) ([] (. tree children) (. operands start))))
      )
    )
    (let side (call (. facts plan-of) (. unit reading) id))
    (if (and (!= fact no-fact) (== piped 0) (call is-float-math side))
      (return (call emit-float-math id ([] (. facts calls) fact) operands side))
    )
    (if (and (!= fact no-fact) (== piped 0) side-payload)
      (return (call emit-side-payload id (. ([] (. facts calls) fact) callee) operands side))
    )
    (lazy side-payload (or (== side .plan-side-payload) (== side .plan-publish-side-payload)))
    (if (and (!= fact no-fact) (== piped 0) (== side .plan-object-from-pointer))
      (return (call emit-object-from-pointer id (. ([] (. facts calls) fact) callee) operands))
    )
    (if (and (!= fact no-fact) (== piped 0) (== side .plan-invoke-lowered))
      (return (call emit-invoke-lowered id (. ([] (. facts calls) fact) callee) operands))
    )
    (if (and (!= fact no-fact) (== piped 0) (== side .plan-witness-pointer))
      (return (call emit-witness-pointer id (. ([] (. facts calls) fact) callee) operands))
    )
    (if (and (!= fact no-fact) (== piped 0) (== side .plan-interface-from-pointer))
      (return (call emit-interface-from-pointer id (. ([] (. facts calls) fact) callee) operands))
    )
    (if (and (!= fact no-fact) (== (call (. facts plan-of) (. unit reading) id) .plan-store-untraced))
      (match? ([] (. tree nodes) callable)
        (case (call .node-get-expression get)
          (if (== piped 0)
            (return (call emit-store-untraced id ([] (. facts calls) fact) (. get object) operands))
          )
        )
      )
      (call refuse .refused-expression id)
      (return (call Typed (call make-operand .operand-void 0) no-type))
    )
    (if (and (== fact no-fact) (== piped 0) (== (call (. facts plan-of) (. unit reading) id) .plan-tuple))
      (return (call emit-tuple id operands))
    )
    (if (and (== fact no-fact) (== piped 0) (call is-binding (call (. facts node-type) (. unit reading) id)))
      (return (call emit-bind id callable operands))
    )
    (if (and (!= fact no-fact) (== piped 0) partial-closure)
      (return (call emit-bind id callable operands))
    )
    (lazy partial-closure (and (. ([] (. facts calls) fact) is-partial) (== (. ([] (. facts calls) fact) form) .call-closure)))
    (if (and (!= fact no-fact) (== piped 0) (call is-binding (call callee-type callable)))
      (let row ([] (. facts calls) fact))
      (if (and (== (. row form) .call-function) (!= (. row callee) no-instance) has-symbol)
        (return (call emit-c-call id operands callable))
      )
      (lazy has-symbol (!= ([] (. tables c-symbols) (. row callee)) no-string))
      (if (or (== (. row form) .call-function) (== (. row form) .call-constructor) (== (. row form) .call-method))
        (return (call emit-fact-call id row 0 operands 0 0 no-type callable))
      )
      (if (and (== (. row form) .call-closure) (== (. row callee) no-instance))
        (return (call emit-value-call id callable operands))
      )
      (if (== (. row form) .call-closure)
        (return (call emit-closure-call id row callable operands))
      )
      (call refuse .refused-expression id)
      (return (call Typed (call make-operand .operand-void 0) no-type))
    )
    (if (!= fact no-fact)
      (let row ([] (. facts calls) fact))
      (if (and (== (. row form) .call-closure) (== piped 0) (== (. row callee) no-instance))
        (return (call emit-value-call id callable operands))
      )
      (if (and (== (. row form) .call-closure) (== piped 0))
        (return (call emit-closure-call id row callable operands))
      )
      (if (or (== (. row form) .call-function) (== (. row form) .call-static) (== (. row form) .call-constructor))
        (return (call emit-fact-call id row 0 operands piped))
      )
      (if (== (. row form) .call-this-constructor)
        (return
          (call emit-fact-call
            (block
              (arg id)
              (arg row)
              (arg (if-expr (call names-slot callable .slot-super) callable 0))
              (arg operands)
              (arg piped)
            )
          )
        )
      )
      (if (and (== (. row form) .call-method) (call calls-value (. row callee)))
        (return (call emit-fact-call id row callable operands piped))
      )
      (if (== (. row form) .call-method)
        (match? ([] (. tree nodes) callable)
          (case (call .node-get-expression get)
            (return (call emit-fact-call id row (. get object) operands piped))
          )
        )
      )
    )
    (let array
      (block
        (case? (and (== fact no-fact) (== piped 0))
          (call (. tables const-array-row) (. unit reading) id)
        )
        (default
          (. U32 max)
        )
      )
    )
    (if (!= array (. U32 max))
      (return
        (call Typed
          (block
            (arg (call make-operand .operand-symbol (call (. tables const-array-symbol) array)))
            (arg (. ([] (. facts const-arrays) array) type))
          )
        )
      )
    )
    (call refuse .refused-expression id)
    (return (call Typed (call make-operand .operand-void 0) no-type))
  )
  (fn-do _ calls-value Bool
    (param callee InstanceId)
    ; Whether an instance is of the function a type declares for a call of a value of it, whose
    ; receiver is what the call names.
    (if (== callee no-instance)
      (return false)
    )
    (let row ([] (. instances rows) callee))
    (match? ([] (. ([] (. program modules) (. row module)) decls) (. row decl))
      (case (call .decl-function fn)
        (return (and (!= (. fn name) null) (== (. fn name) (. types call-atom))))
      )
    )
    (return false)
  )
  (fn-do _ emit-side-payload Typed
    (param id SyntaxId)
    (param callee InstanceId)
    (param operands (of RowRange SyntaxId))
    (param plan OperatorPlan)
    ; A call the compiler answers itself through the collector: the payload an object holds in a
    ; lane, an object of the payload's class or nothing where the lane holds none, or a payload
    ; published in the lane, which answers the payload the lane then holds. The allocation buffer
    ; is published first. Each argument takes the conversion recorded for it. An optional that
    ; holds its flag apart holds a value where the address the collector gives is not null. The
    ; collector's function is called as TypeScript calls it, with no poll around it and no panic
    ; read after it.
    (let nothing (call make-operand .operand-void 0))
    (let count U32 (if-expr (== plan .plan-side-payload) 2 3))
    (if (or (== callee no-instance) (!= (. operands count) count) other-arity)
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (lazy other-arity (!= (. ([] (. instances signatures) callee) args count) count))
    (let mark (. pending length))
    (for (in position (..< 0 count))
      (let argument ([] (. tree children) (+ (. operands start) position)))
      (let expression argument)
      (match? ([] (. tree nodes) argument)
        (case (call .node-argument named)
          (= expression (. named expr))
        )
      )
      (let value (call convert argument .reason-argument (call emit-expression expression)))
      (if (!= (. value type) (call (. instances argument-type) callee position))
        (call refuse .refused-conversion argument)
      )
      (+= pending (. value operand))
    )
    (let type (call (. facts node-type) (. unit reading) id))
    (let layout (call layout-of type id))
    (if (== plan .plan-publish-side-payload)
      (let published (call call-runtime .runtime-publish-side-payload id mark layout))
      (return (call Typed published type))
    )
    (let raw (call call-runtime .runtime-object-side-payload id mark managed-layout))
    (if (not (call (. tables layouts is-struct) layout))
      (return (call Typed raw type))
    )
    (let held (call frame layout))
    (call put held (call (. tables layouts field) layout 0) raw id)
    (let address (call num-cast id raw managed-layout u64-layout))
    (call put
      (block
        (arg held)
        (arg (call (. tables layouts field) layout 1))
        (arg (call compare id .compare-not-equal address (call integer .machine-u64 0)))
        (arg id)
      )
    )
    (return (call Typed held type))
  )
  (fn-do _ emit-invoke-lowered Typed
    (param id SyntaxId)
    (param callee InstanceId)
    (param operands (of RowRange SyntaxId))
    ; A call the compiler answers itself: the function at the address the first argument holds,
    ; called with the other two, the address of an object and a payload, and checked for a panic
    ; as a call of a function's value is.
    (let nothing (call make-operand .operand-void 0))
    (if (or (== callee no-instance) (!= (. operands count) 3) (!= (. ([] (. instances signatures) callee) args count) 3))
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (let given (list Operand))
    (for (in position (..< 0 3))
      (let argument ([] (. tree children) (+ (. operands start) position)))
      (let converted
        (call convert argument .reason-argument (call emit-expression expression)
          (block
            (lazy expression (call (. tree argument-value) argument))
          )
        )
      )
      (+= given (. converted operand))
      (if (!= (. converted type) (call (. instances argument-type) callee (as position U32)))
        (call refuse .refused-conversion argument)
      )
    )
    (let mark (. pending length))
    (+= pending ([] given 1))
    (+= pending ([] given 2))
    (do
      (inline (call call ([] given 0) id mark .callee-value void-layout (not in-landing)))
    )
    (return (call Typed nothing (. types void-type)))
  )
  (fn-do _ intrinsic-arguments Bool
    (param id SyntaxId)
    (param callee InstanceId)
    (param operands (of RowRange SyntaxId))
    ; Evaluates the arguments of a call the compiler answers itself onto the pending arguments,
    ; each with the conversion recorded for it and of the type its parameter takes. False where
    ; one is refused.
    (if (or (== callee no-instance) (!= (. operands count) (. ([] (. instances signatures) callee) args count)))
      (call refuse .refused-expression id)
      (return false)
    )
    (for (in position (..< 0 (. operands count)))
      (let argument ([] (. tree children) (+ (. operands start) position)))
      (let expression argument)
      (match? ([] (. tree nodes) argument)
        (case (call .node-argument named)
          (= expression (. named expr))
        )
      )
      (let value (call convert argument .reason-argument (call emit-expression expression)))
      (if (!= (. value type) (call (. instances argument-type) callee position))
        (call refuse .refused-conversion argument)
      )
      (+= pending (. value operand))
    )
    (return true)
  )
  (fn-do _ emit-witness-pointer Typed
    (param id SyntaxId)
    (param callee InstanceId)
    (param operands (of RowRange SyntaxId))
    ; A call the compiler answers itself: the address of the witness table a value of an
    ; interface holds.
    (let mark (. pending length))
    (if (not (call intrinsic-arguments id callee operands))
      (call drop-pending mark)
      (return (call Typed (call make-operand .operand-void 0) (call (. facts node-type) (. unit reading) id)))
    )
    (let value ([] pending mark))
    (call drop-pending mark)
    (let second (. (call (. tables layouts field) (. tables layouts interface-layout) 1) offset))
    (return (call Typed (call load value second pointer-layout id) (call (. facts node-type) (. unit reading) id)))
  )
  (fn-do _ emit-interface-from-pointer Typed
    (param id SyntaxId)
    (param callee InstanceId)
    (param operands (of RowRange SyntaxId))
    ; A call the compiler answers itself: a value of an interface that holds the object at one
    ; address and the witness table at the other, the two as the caller vouches they belong.
    (let mark (. pending length))
    (if (not (call intrinsic-arguments id callee operands))
      (call drop-pending mark)
      (return (call Typed (call make-operand .operand-void 0) (call (. facts node-type) (. unit reading) id)))
    )
    (let object ([] pending mark))
    (let table ([] pending (+ mark 1)))
    (call drop-pending mark)
    (let type (call (. facts node-type) (. unit reading) id))
    (let layout (call layout-of type id))
    (if (!= layout (. tables layouts interface-layout))
      (call refuse .refused-conversion id)
      (return (call Typed (call make-operand .operand-void 0) no-type))
    )
    (let made (call frame layout))
    (call store made 0 object false id)
    (call store made (. (call (. tables layouts field) layout 1) offset) table false id)
    (return (call Typed made type))
  )
  (fn-do _ emit-object-from-pointer Typed
    (param id SyntaxId)
    (param callee InstanceId)
    (param operands (of RowRange SyntaxId))
    ; A call the compiler answers itself: the object of a class at the address a pointer holds,
    ; its bits as they are. The argument takes the conversion recorded for it.
    (let nothing (call make-operand .operand-void 0))
    (if (or (== callee no-instance) (!= (. operands count) 1) (!= (. ([] (. instances signatures) callee) args count) 1))
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (let argument ([] (. tree children) (. operands start)))
    (let expression argument)
    (match? ([] (. tree nodes) argument)
      (case (call .node-argument named)
        (= expression (. named expr))
      )
    )
    (let value (call convert argument .reason-argument (call emit-expression expression)))
    (if (!= (. value type) (call (. instances argument-type) callee 0))
      (call refuse .refused-conversion argument)
    )
    (let type (call (. facts node-type) (. unit reading) id))
    (let source (call layout-of (. value type) id))
    (let layout (call layout-of type id))
    (if (or (not (call is-pointer source)) (not (call is-pointer layout)))
      (call refuse .refused-conversion id)
      (return (call Typed nothing no-type))
    )
    (return (call Typed (call num-cast id (. value operand) source layout) type))
  )
  (fn-do _ emit-leading-zeros Typed
    (param id SyntaxId)
    (param callee InstanceId)
    (param argument SyntaxId)
    ; A call the compiler answers itself: how many of an integer's highest bits are zero. The
    ; argument takes the conversion recorded for it, and the count has the node's type.
    (let nothing (call make-operand .operand-void 0))
    (let expression argument)
    (match? ([] (. tree nodes) argument)
      (case (call .node-argument named)
        (= expression (. named expr))
      )
    )
    (let value (call convert argument .reason-argument (call emit-expression expression)))
    (if (or (== callee no-instance) (!= (. value type) (call (. instances argument-type) callee 0)))
      (call refuse .refused-conversion argument)
      (return (call Typed nothing no-type))
    )
    (let given (call layout-of (. value type) argument))
    (let type (call (. facts node-type) (. unit reading) id))
    (let layout (call layout-of type id))
    (if (or (not (call is-integer given)) (not (call is-integer layout)) (< (. ([] (. tables layouts rows) layout) size) 4))
      (call refuse .refused-type id)
      (return (call Typed nothing no-type))
    )
    (let bits (. ([] (. types completions) (. value type)) bit-size))
    (let start U32 (. ir operands length))
    (call (. ir add-operand) (. value operand))
    (return
      (call Typed
        (block
          (arg
            (call make-operand
              (block
                (arg .operand-value)
                (arg (call append .op-count-leading-zeros id (call Span start 1) bits layout))
              )
            )
          )
          (arg type)
        )
      )
    )
  )
  (fn-do _ emit-float-math Typed
    (param id SyntaxId)
    (param call CallFact)
    (param operands (of RowRange SyntaxId))
    (param plan OperatorPlan)
    ; A call the compiler answers itself: the square root or absolute value of a float, or the
    ; lesser or greater of two. Each argument is written in its parameter's place and takes the
    ; conversion recorded for it.
    (let nothing (call make-operand .operand-void 0))
    (let callee (. call callee))
    (if (or (== callee no-instance) (. call is-partial) (!= (. call fills count) (. operands count)))
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (if (!= (. ([] (. instances signatures) callee) args count) (. operands count))
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (for (in position (..< 0 (. call fills count)))
      (if (!= (as ([] (. facts call-fills) (+ (. call fills start) position)) U32) position)
        (call refuse .refused-expression id)
        (return (call Typed nothing no-type))
      )
    )
    (let mark (. pending length))
    (for (in position (..< 0 (. operands count)))
      (let argument ([] (. tree children) (+ (. operands start) position)))
      (let expression argument)
      (match? ([] (. tree nodes) argument)
        (case (call .node-argument named)
          (= expression (. named expr))
        )
      )
      (let value (call convert argument .reason-argument (call emit-expression expression)))
      (if (!= (. value type) (call (. instances argument-type) callee position))
        (call refuse .refused-conversion argument)
