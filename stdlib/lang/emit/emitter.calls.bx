        (= written-receiver (. received-2 operand))
        (= written-type (. received-2 type))
        (let reached (call read-through id (call Typed written-receiver (. received-2 type)) (. fact through)))
        (= receiver (. reached operand))
        (if (and (!= (. reached type) (. row self-type)) (not derived-through))
          (call refuse .refused-conversion id)
        )
        (lazy derived-through (and (!= (. fact through count) 0) (call is-derived (. reached type) (. row self-type))))
      )
    )
    (let count U32 (+ (. written count) lead))
    (let last nothing)
    (let last-type no-type)
    (if (!= leading 0)
      (let follows (and (!= piped 0) (not (call is-inert piped))))
      (let lead-value (call emit-expression leading))
      (+= given
        (call Typed
          (block
            (arg (call apart (call Typed (call settled lead-value leading written 0) (. lead-value type)) leading follows))
            (arg (. lead-value type))
          )
        )
      )
    )
    (if (!= piped 0)
      (+= count 1)
      (let pipe-value (call emit-expression piped))
      (= last (call settled pipe-value piped written 0))
      (= last-type (. pipe-value type))
    )
    (let evaluated U32)
    (for (in argument ([] (. tree children) written))
      (let expression argument)
      (match? ([] (. tree nodes) argument)
        (case (call .node-argument named)
          (= expression (. named expr))
        )
      )
      (+= evaluated 1)
      (let live (only-if (call (. tables live-statement-of) (. unit reading) expression) (if (and (!= (. styling element) 0) (== id (. styling element)) (== expression argument)))))
      (let trackers (if-expr live (call open-trackers expression) no-local))
      (if live
        (+= live-actions (call LiveTrackers trackers trackers))
      )
      (let emitted (call emit-expression expression))
      (let value (call settled emitted expression written evaluated))
      (if live
        (call (. live-actions pop))
        (+= argument-trackers (call LiveMember expression trackers))
      )
      (+= given (call Typed value (. emitted type)))
      (if (and (!= (. styling element) 0) (== id (. styling element)))
        (+= element-given (call Typed (call apart (call Typed value (. emitted type)) expression true) (. emitted type)))
      )
    )
    (let attributes (. element-given length))
    (let filled-mark (. element-filled length))
    (if (and (!= (. styling element) 0) (== id (. styling element)))
      (call emit-attributes id callee fact count)
    )
    (if (and (!= (. styling valued) 0) (== id (. styling valued)))
      (call emit-rule-values id)
    )
    (if (!= piped 0)
      (+= given (call Typed last last-type))
    )
    (if (and receives (!= piped 0) (not restores))
      (let reached (call read-through id (call emit-receiver id object) (. fact through)))
      (= receiver (. reached operand))
      (if (!= (. reached type) (. row self-type))
        (call refuse .refused-conversion id)
      )
    )
    (if receives
      (+= pending receiver)
    )
    (let tail-first count)
    (let tail-type no-type)
    (for (in position (..< 0 (. fact fills count)))
      (if (== (as ([] (. facts call-fills) (+ (. fact fills start) position)) U32) (. ArgumentFill fill-variadic))
        (= tail-first lead)
        (= tail-type (call (. instances argument-type) callee position))
      )
    )
    (for (in position (..< 0 (. fact fills count)))
      (let fill (as ([] (. facts call-fills) (+ (. fact fills start) position)) U32))
      (let fixed (and (!= fill (. ArgumentFill fill-empty)) (!= fill (. ArgumentFill fill-variadic))))
      (if (and (!= tail-type no-type) fixed (< fill count) (>= fill tail-first))
        (= tail-first (+ fill 1))
      )
    )
    (for (in position (..< 0 count))
      (if (>= position tail-first)
        (break)
      )
      (let site lead-site)
      (if (>= position lead)
        (let index (- position lead))
        (= site (if-expr (== index (. written count)) piped ([] (. tree children) (+ (. written start) index))))
      )
      (let passed ([] given (+ start position)))
      (if (not (call takes-default fact owner first position (. passed type)))
        (if (and (< position lead) (!= bound 0))
          (let wanted (call filled-type fact callee position))
          (if (and (!= wanted no-type) (!= (. passed type) wanted))
            (= passed (call convert-held id passed wanted))
          )
          (else-if (and (!= piped 0) (== site piped) (!= shifted 0))
            (let reason ConversionReason (if-expr (== shifted id) .reason-piped .reason-argument))
            (= passed
              (call convert-matched
                (block
                  (arg shifted)
                  (arg reason)
                  (arg passed)
                  (arg no-type)
                )
              )
            )
          )
          (else-if (and (== (call (. facts plan-of) (. unit reading) id) .plan-forward) (!= (call filled-parameter fact position) (. U32 max)))
            (let wanted (call (. instances argument-type) callee (call filled-parameter fact position)))
            (= passed (call convert-to site .reason-argument passed wanted))
          )
          (else
            (= passed (call convert site .reason-argument passed))
          )
        )
        (else
          (let parameter (call filled-parameter fact position))
          (let expected (call (. instances argument-type) callee parameter))
          (= passed
            (call optional-argument
              (block
                (arg id)
                (arg site)
                (arg passed)
                (arg callee)
                (arg (. ([] (. owner arg-pool) (+ first parameter)) default-syntax))
                (arg expected)
              )
            )
          )
        )
      )
      (= ([] given (+ start position)) passed)
    )
    (let tail nothing)
    (if (!= tail-type no-type)
      (let tailed (call emit-tail id written lead start tail-first count tail-type piped))
      (= tail (. tailed operand))
      (if (!= (. tailed type) tail-type)
        (call refuse .refused-conversion id)
      )
    )
    (let placed U32)
    (for (in position (..< 0 (. fact fills count)))
      (let fill (as ([] (. facts call-fills) (+ (. fact fills start) position)) U32))
      (let expected (call (. instances argument-type) callee position))
      (let default (. ([] (. owner arg-pool) (+ first position)) default-syntax))
      (if (== fill (. ArgumentFill fill-empty))
        (+= pending (. (call default-argument id callee default expected) operand))
        (else-if (== fill (. ArgumentFill fill-variadic))
          (+= pending tail)
          (+= placed (- count tail-first))
        )
        (else-if (>= fill count)
          (let held (+ attributes (as (- fill count) Size)))
          (if (or (== (. styling element) 0) (!= id (. styling element)) (>= held (. element-given length)))
            (call refuse .refused-expression id)
            (else-if (!= (. ([] element-given held) type) expected)
              (call refuse .refused-conversion id)
            )
            (else
              (+= pending (. ([] element-given held) operand))
            )
          )
        )
        (else-if (!= (. ([] given (+ start fill)) type) expected)
          (call refuse .refused-conversion id)
        )
        (else
          (+= pending (. ([] given (+ start fill)) operand))
          (+= placed 1)
        )
      )
    )
    (call drop-given start)
    (if (!= placed count)
      (call refuse .refused-expression id)
    )
    (let filled (. row fills count))
    (if (!= filled 0)
      (if (or (== (. styling element) 0) (!= id (. styling element)) (!= (. element-filled length) (+ filled-mark filled)))
        (call refuse .refused-expression id)
        (else
          (for (in offset (..< 0 filled))
            (let held (as ([] element-filled (+ filled-mark offset)) Size))
            (if (!= (. ([] element-given held) type) (call (. instances argument-type) callee (+ (. fact fills count) offset)))
              (call refuse .refused-conversion id)
              (else
                (+= pending (. ([] element-given held) operand))
              )
            )
          )
        )
      )
    )
    (if (!= (. row carried) 0)
      (call give-cells id (. row carried))
    )
    (if (!= (. row slots count) 0)
      (call give-slots id callee)
    )
    (if (and (!= row-taken nothing) (. row row-validated))
      (+= pending
        (scope (if-expr (!= dispatch-type no-type) dispatch-columns (call case-columns id at-cursor))
          (lazy at-cursor (call cursor-at object))
        )
      )
    )
    (if restores
      (let called-2 (call call-instance callee id mark true))
      (return (call Typed nothing (. called-2 type)))
    )
    (let exact (call names-slot object .slot-super))
    (if (and (or builds initializes) (!= (. fact form) .call-getter) on-this)
      (= exact true)
    )
    (if (and receives (== bound 0) (== (. fact through count) 0))
      (let known (if-expr (== object 0) (. unit owner-type) (call (. facts answer-type) (. unit reading) object)))
      (if (and (call (. tables is-class) known) (call is-derived known (. row self-type)) (not (call (. types has-subclasses) known)))
        (= exact true)
      )
    )
    (lazy on-this (or (== object 0) (call names-slot object .slot-this)))
    (let raising (!= (. ([] (. instances signatures) callee) errors count) 0))
    (= takes-result raising)
    (let answer
      (block
        (case? receives
          (call call-method callee id mark exact)
        )
        (default
          (call call-instance callee id mark)
        )
      )
    )
    (= takes-result false)
    (if (and raising (. fact propagates))
      (= answer (call propagate id callee (. answer operand)))
    )
    (let expected (if-expr (!= answers no-type) answers (call (. facts answer-type) (. unit reading) id)))
    (if (and receives (== (. answer type) (. types void-type)) answers-self)
      (return (call Typed receiver expected))
    )
    (lazy answers-self (and (== expected (. row self-type)) (== row-taken nothing)))
    (if (and (== (. answer type) (. types void-type)) reads-through)
      (return (call Typed written-receiver expected))
    )
    (lazy reads-through (and (!= (. fact through count) 0) (== expected written-type)))
    (if (and (!= (. answer type) expected) (not (call links-into id (. answer type) expected)))
      (call refuse .refused-conversion id)
    )
    (return answer)
  )
  (fn-expr _ takes-row Bool
    (param callee InstanceId)
    (param object SyntaxId)
    ; Whether a call written on a name that stands for the case of a row, or on the receiver
    ; named by no name in a member that runs on the case, passes the row: to a member of the case
    ; that runs on the row, or to one of a base every case shares.
    (case? (== (call cursor-at object) (. U32 max))
      false
    )
    (default
      (or (!= (. row row-receiver) no-type) (call holds-row (. row self-type)))
    )
    (where
      (lazy row ([] (. instances rows) callee))
    )
  )
  (fn-do _ case-receiver Typed
    (param id SyntaxId)
    (param object SyntaxId)
    (param callee InstanceId)
    ; The row a call passes where it is written on a name that stands for the case of a row, as
    ; TypeScript passes the cursor's row: a member of the case takes the row of its own type, and
    ; one of a shared base the row it runs on.
    (let held ([] case-cursors (call cursor-at object)))
    (let row ([] (. instances rows) callee))
    (let wanted (if-expr (!= (. row row-receiver) no-type) (. row row-receiver) (. row self-type)))
    (if (or (!= (. held type) wanted) (and (!= (. row row-receiver) no-type) (!= (. held case-index) (. row row-case))))
      (call refuse .refused-expression id)
      (return (call Typed (call make-operand .operand-void 0) no-type))
    )
    (return (call Typed (. held row) (. held type)))
  )
  (fn-expr _ cursor-at U32
    (param object SyntaxId)
    ; The case of a row a call's object stands for: that of a name, or with no object written
    ; that of the receiver in a member that runs on the case.
    (if-expr (!= object 0) (call case-cursor-of object) this-cursor)
  )
  (fn-do _ case-columns Operand
    (param id SyntaxId)
    (param cursor U32)
    ; The columns a call passes after its arguments to a member of a case that runs on a row whose
    ; storage TypeScript checked where the case was read.
    (return (. (call case-place id ([] case-cursors cursor)) columns))
  )
  (fn-do _ callee-type TypeId
    (param callable SyntaxId)
    ; The type of the value a call calls. The type pass types a name there only where it is
    ; read for its value, so a local, a lazy local, an argument, the item of a loop or a name a
    ; pattern binds has the type its function gives it, the receiver its own, and a
    ; property of the receiver the type it is declared with, and a global the type it is kept
    ; with. One that is an optional the type pass planned to be called as what it holds is read
    ; as that.
    (let type (call (. facts node-type) (. unit reading) callable))
    (let binding (. ([] (. instances rows) (. unit reading)) binding))
    (if (or (!= type no-type) (== binding no-binding))
      (return type)
    )
    (let global (call (. bindings resolution-of) binding callable))
    (if (== (. global kind) .resolve-global)
      (let row (call (. tables storage-of) (. global module) (. global decl)))
      (return (if-expr (!= row no-storage) (. ([] (. tables storage) row) type) no-type))
    )
    (if (!= (. unit reading) (. unit instance))
      (return type)
    )
    (match? ([] (. tree nodes) callable)
      (case (call .node-identifier named)
        (let resolution (call (. bindings resolution-of) binding callable))
        (if (and (== (. resolution kind) .resolve-member) (. unit has-self))
          (let found (call property-of (. unit owner-type) (. named name)))
          (let declared (if-expr found (. ([] (. types properties) found) type) no-type))
          (if (or (== declared no-type) (!= (call (. facts plan-of) (. unit reading) callable) .plan-callee))
            (return declared)
          )
          (return (if-expr (call (. types is-optional) declared) (call (. types optional-inner) declared) no-type))
        )
        (if (!= (. resolution kind) .resolve-slot)
          (return no-type)
        )
        (if (and (== (. ([] (. bindings slots) (. resolution slot)) kind) .slot-this) (. unit has-self))
          (return (. unit owner-type))
        )
        (let held (call slot-held-type callable (. resolution slot)))
        (if (and (!= held no-type) (== (call (. facts plan-of) (. unit reading) callable) .plan-callee))
          (return (call (. types optional-inner) held))
        )
        (return held)
      )
    )
    (return no-type)
  )
  (fn-do + emit-callee Typed
    (param callable SyntaxId)
    ; The value a call calls, in the type `callee-type` gives it.
    (let type (call callee-type callable))
    (if (or (== type no-type) (!= (call (. facts node-type) (. unit reading) callable) no-type))
      (return (call emit-expression callable))
    )
    (let value (call make-operand .operand-void 0))
    (match? ([] (. tree nodes) callable)
      (case (call .node-identifier row)
        (= value (. (call emit-identifier callable (. row name) type) operand))
      )
    )
    (return (call Typed value type))
  )
  (fn-do _ emit-generated-call Typed
    (param id SyntaxId)
    (param fact CallFact)
    (param written (of RowRange SyntaxId))
    ; A call of a function the compiler generates with no arguments declared, whose instance
    ; takes them as its kind says: a table's constructors, whose filler is named `with`. The
    ; arguments are evaluated in the order written, each converted as recorded for it, and each
    ; fills the place the type pass matched it to, which is its own.
    (let nothing (call make-operand .operand-void 0))
    (let callee (. fact callee))
    (let wanted (. ([] (. instances signatures) callee) args count))
    (if (or (!= (. written count) wanted) (!= (. fact fills count) wanted))
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (for (in position (..< 0 (. fact fills count)))
      (if (!= (as ([] (. facts call-fills) (+ (. fact fills start) position)) U32) position)
        (call refuse .refused-expression id)
        (return (call Typed nothing no-type))
      )
    )
    (let mark (. pending length))
    (let start (. given length))
    (call give-arguments written)
    (call pass-arguments written start callee 0 (. written count))
    (call drop-given start)
    (return (call call-checked id fact mark))
  )
  (fn-do _ give-arguments _
    (param written (of RowRange SyntaxId))
    (param refuses-named Bool (= false))
    ; Emits the arguments written for a call in order onto `given`, each settled where one written
    ; after it may change what it read. Where it `refuses-named`, an argument written with a name
    ; has no shape.
    (let evaluated U32)
    (for (in argument ([] (. tree children) written))
      (let expression (call (. tree argument-value) argument))
      (if (and refuses-named (call (. tree is-named) argument))
        (call refuse .refused-expression argument)
        (break)
      )
      (+= evaluated 1)
      (let emitted (call emit-expression expression))
      (+= given (call Typed (call settled emitted expression written evaluated) (. emitted type)))
    )
  )
  (fn-do _ pass-arguments _
    (param written (of RowRange SyntaxId))
    (param start Size)
    (param callee InstanceId)
    (param first U32)
    (param count U32)
    ; Passes the first `count` arguments written for a call, which `given` holds from `start`, each
    ; converted to the type of its parameter of `callee`, counting the parameters from `first`.
    (for (in position (..< 0 count))
      (let site ([] (. tree children) (+ (. written start) position)))
      (let value (call convert site .reason-argument ([] given (+ start position))))
      (if (!= (. value type) (call (. instances argument-type) callee (+ first position)))
        (call refuse .refused-conversion site)
      )
      (+= pending (. value operand))
    )
  )
  (fn-do _ call-checked Typed
    (param id SyntaxId)
    (param fact CallFact)
    (param mark Size)
    ; Calls the callee of a call fact with the arguments passed from `mark`, propagating what it
    ; raises where the call does, and answers what the call answers, as the type pass typed it.
    (let callee (. fact callee))
    (let raising (!= (. ([] (. instances signatures) callee) errors count) 0))
    (= takes-result raising)
    (let answer (call call-instance callee id mark))
    (= takes-result false)
    (if (and raising (. fact propagates))
      (= answer (call propagate id callee (. answer operand)))
    )
    (let expected (call (. facts node-type) (. unit reading) id))
    (if (and (!= (. answer type) expected) (not (call links-into id (. answer type) expected)))
      (call refuse .refused-conversion id)
    )
    (return answer)
  )
  (fn-do _ emit-closure-call Typed
    (param id SyntaxId)
    (param fact CallFact)
    (param callable SyntaxId)
    (param written (of RowRange SyntaxId))
    ; A call of a nested function: of the instance the type pass typed for the arguments
    ; written. The value called is evaluated first, and is the environment the body is given.
    ; The arguments follow in the order written, each converted as recorded for it. A binding
    ; of a nested function is called so too: it holds the function and then the arguments it
    ; was given, which come before those written. A variadic tail the type pass packed is made
    ; a list as a function's tail is, once the arguments before it are converted.
    (let nothing (call make-operand .operand-void 0))
    (let callee (. fact callee))
    (if (or (== callee no-instance) (. fact is-partial) (== ([] (. tables instance-functions) callee) no-function))
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (let tail-first (. written count))
    (let packed
      (scope (and (!= (. fact fills count) 0) (== tail-fill (. ArgumentFill fill-variadic)))
        (lazy tail-fill (as ([] (. facts call-fills) (- (+ (. fact fills start) (. fact fills count)) 1)) U32))
      )
    )
    (if packed
      (= tail-first (- (. fact fills count) 1))
    )
    (let closure (call emit-callee callable))
    (let tuple closure)
    (let held void-layout)
    (let bound U32)
    (if (call is-binding (. tuple type))
      (= bound (call bound-count (. tuple type)))
      (= held (call layout-of (. tuple type) callable))
      (= closure (call part (. tuple operand) held 0 callable))
    )
    (let wanted (. ([] (. instances signatures) callee) args count))
    (let passed (if-expr packed (+ tail-first 1) (. written count)))
    (if (or (not (call is-closure (. closure type))) (!= (+ bound passed) wanted) misfilled)
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (lazy misfilled (and packed (or (!= bound 0) (> tail-first (. written count)))))
    (let mark (. pending length))
    (let start (. given length))
    (call give-arguments written true)
    (+= pending (. closure operand))
    (for (in offset (..< 0 bound))
      (let piece (call part (. tuple operand) held (+ 1 offset) callable))
      (+= pending (. piece operand))
      (if (!= (. piece type) (call (. instances argument-type) callee offset))
        (call refuse .refused-conversion id)
      )
    )
    (call pass-arguments written start callee bound tail-first)
    (if packed
      (let listed (call (. instances argument-type) callee tail-first))
      (let tail (call emit-tail id written 0 start tail-first (. written count) listed 0))
      (if (!= (. tail type) listed)
        (call refuse .refused-conversion id)
      )
      (+= pending (. tail operand))
    )
    (call drop-given start)
    (return (call call-checked id fact mark))
  )
  (fn-do _ emit-value-call Typed
    (param id SyntaxId)
    (param callable SyntaxId)
    (param written (of RowRange SyntaxId))
    ; A call of a value of a function type: of the code it holds, given the data it holds and
    ; then an argument for each place the type declares, each converted to what the type
    ; declares for the place. The value is read first, and the arguments are evaluated in the
    ; order written; the type pass recorded which of them fills each place. A binding of such a
    ; value holds the value and then the arguments it was given, each in its place, and those
    ; fill the places nothing written does. What runs is not known here, so the call is checked
    ; for a panic, which the type pass has said of the caller. A type that carries errors
    ; answers with its value or one of them, as the type pass kept for the type: under `catch`
    ; that is the call's value, and elsewhere an error leaves the function at the call. A C
    ; function's has no shape yet. A generator called for its next item answers the type the
    ; type pass gave the call, an optional of an item, or that or an error, as the type pass
    ; kept for the generator's type where it carries errors.
    (let nothing (call make-operand .operand-void 0))
    (let shape (call callee-type callable))
    (let binding (if-expr (call is-binding shape) shape no-type))
    (if (!= binding no-type)
      (= shape (call bound-object binding))
    )
    (let args (call (of RowRange TypeId)))
    (let returns (. types void-type))
    (let plain false)
    (let c false)
    (let fn (if-expr (or (== shape no-type) (== shape invalid-type)) no-type (call function-row types shape)))
    (if (!= fn no-type)
      (match? ([] (. types rows) fn)
        (case (call .type-function row)
          (= args (. row args))
          (= plain (not (. row is-c)))
          (= c (. row is-c))
          (= returns (call value-returned (. row return-type)))
        )
      )
    )
    (if (and c (== binding no-type))
      (return (call emit-c-value-call id callable written args returns))
    )
    (let steps (== (call (. facts plan-of) (. unit reading) id) .plan-step))
    (let carried no-type)
    (if (and plain (call carries fn))
      (= carried (if-expr steps (call (. facts carried-result) shape) (call (. facts carried-result) fn)))
      (= plain (!= carried no-type))
    )
    (if steps
      (= returns (call (. facts node-type) (. unit reading) id))
    )
    (let fact (call own-call id))
    (let fills (call (of RowRange ArgumentFill)))
    (if (!= fact no-fact)
      (= fills (. ([] (. facts calls) fact) fills))
    )
    (if (or (not plain) (!= (. fills count) (. args count)) in-zone (and (not (. function may-panic)) (not in-landing)))
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (let source (call emit-callee callable))
    (let tuple source)
    (let held void-layout)
    (if (!= binding no-type)
      (= held (call layout-of binding callable))
      (= source (call part (. tuple operand) held 0 callable))
    )
    (let layout (call layout-of (. source type) callable))
    (if (!= layout (. tables layouts function-layout))
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (let code (call load (. source operand) 0 pointer-layout id))
    (let data (call load (. source operand) (. (call (. tables layouts field) layout 1) offset) managed-layout id))
    (let mark (. pending length))
    (let start (. given length))
    (call give-arguments written)
    (+= pending data)
    (call pass-filled id written start fills args (. tuple operand) held)
    (call drop-given start)
    (let answered (if-expr (== carried no-type) returns carried))
    (let result
      (call Typed
        (block
          (arg (call call code id mark .callee-value (call layout-of answered id) (not in-landing)))
          (arg answered)
        )
      )
    )
    (if (and (!= carried no-type) (!= fact no-fact) (. ([] (. facts calls) fact) propagates))
      (= result (call propagate-held id carried (. result operand)))
    )
    (if (and (!= (. result type) (call (. facts node-type) (. unit reading) id)) (not (call links-into id (. result type) (call (. facts node-type) (. unit reading) id))))
      (call refuse .refused-conversion id)
    )
    (return result)
  )
  (fn-do _ pass-filled _
    (param id SyntaxId)
    (param written (of RowRange SyntaxId))
    (param start Size)
    (param fills (of RowRange ArgumentFill))
    (param args (of RowRange TypeId))
    (param bound Operand)
    (param held LayoutId)
    ; Passes an argument for each place a value's function type declares, converted to what the
    ; type declares for it: the argument written that the type pass recorded as filling the place,
    ; which `given` holds from `start`, or else what a binding of the value, `bound` laid out as
    ; `held`, holds there.
    (let empty U32 (. ArgumentFill fill-empty))
    (for (in place (..< 0 (. args count)))
      (let fill (as ([] (. facts call-fills) (+ (. fills start) place)) U32))
      (let declared (call (. types child-type) args place))
      (let value (call Typed (call make-operand .operand-void 0) no-type))
      (let site id)
      (if (and (!= fill empty) (< fill (. written count)))
        (= site ([] (. tree children) (+ (. written start) fill)))
        (= value (call convert site .reason-argument ([] given (+ start fill))))
        (else-if (and (== fill empty) (!= held void-layout))
          (= value (call part bound held (+ 1 place) id))
          (if (!= (. value type) declared)
            (= value (call convert-held id value declared))
          )
        )
        (else
          (call refuse .refused-expression id)
        )
      )
      (if (!= (. value type) declared)
        (call refuse .refused-conversion site)
      )
      (+= pending (. value operand))
    )
  )
  (fn-do _ emit-c-value-call Typed
    (param id SyntaxId)
    (param callable SyntaxId)
    (param written (of RowRange SyntaxId))
    (param args (of RowRange TypeId))
    (param returns TypeId)
    ; A call of a value of a C function's type: of the address it holds, given an argument for
    ; each place the type declares, converted to what the type declares for it, evaluated in the
    ; order written. What runs is not known here, so the call is checked for a panic as the
    ; reference checks a call of any value, and the function there gives the signal.
    (let nothing (call make-operand .operand-void 0))
    (let fact (call own-call id))
    (let fills (if-expr (!= fact no-fact) (. ([] (. facts calls) fact) fills) (call (of RowRange ArgumentFill))))
    (if (or (!= (. fills count) (. args count)) in-zone (and (not (. function may-panic)) (not in-landing)))
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (let source (call emit-callee callable))
    (if (not (call is-pointer (call layout-of (. source type) callable)))
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (let start (. given length))
    (call give-arguments written)
    (let mark (. pending length))
    (call pass-filled id written start fills args nothing void-layout)
    (call drop-given start)
    (let result (call call (. source operand) id mark .callee-value (call layout-of returns id) (not in-landing)))
    (if (!= returns (call (. facts node-type) (. unit reading) id))
      (call refuse .refused-conversion id)
    )
    (return (call Typed result returns))
  )
  (fn-do _ filled-type TypeId
    (param fact CallFact)
    (param callee InstanceId)
    (param given U32)
    ; The type the callee takes for the place one of the arguments given fills, or no type
    ; where it fills none.
    (for (in position (..< 0 (. fact fills count)))
      (if (== (as ([] (. facts call-fills) (+ (. fact fills start) position)) U32) given)
        (return (call (. instances argument-type) callee position))
      )
    )
    (return no-type)
  )
  (fn-do _ convert-held Typed
    (param site SyntaxId)
    (param value Typed)
    (param declared TypeId)
    ; An argument a binding of a value held, converted to what the value's type declares for its
    ; place: by the conversion the type pass recorded at the call for the two types.
    (let fact (call (. facts first-conversion) (. unit reading) site))
    (while (!= fact no-fact)
      (let row ([] (. facts conversions) fact))
      (if (and (== (. row reason) .reason-argument) (== (. row from) (. value type)) (== (. row to) declared))
        (return (call convert-one site row value))
      )
      (= fact (. row next))
    )
    (call refuse .refused-conversion site)
    (return value)
  )
  (fn-do _ bound-object TypeId
    (param type TypeId)
    ; The type of the value a binding of a value of a function type holds and calls, or no type
    ; for any other binding.
    (match? ([] (. types rows) type)
      (case (call .type-binding row)
        (if (== (. row form) .bound-value)
          (return (. row object))
        )
      )
    )
    (return no-type)
  )
  (fn-do _ holds-callee Bool
    (param type TypeId)
    ; Whether a binding holds what it calls: a nested function, or a value of a function type.
    (match? ([] (. types rows) type)
      (case (call .type-binding row)
        (return (or (== (. row form) .bound-closure) (== (. row form) .bound-value)))
      )
    )
    (return false)
  )
  (fn-do _ emit-bind Typed
    (param id SyntaxId)
    (param callable SyntaxId)
    (param written (of RowRange SyntaxId))
    ; A call given too few arguments, which gives a binding: a tuple in the frame of what it
    ; holds. A binding called so is copied first, field by field. Else the value the new one
    ; calls on is evaluated: the object a method is read from, or the receiver of the function
    ; the call is in where none is written, or the nested function or the value of a function
    ; type that is called. Then the arguments written are evaluated in order and stored as they
    ; are: one after another, or for a value of a function type each in the place the type pass
    ; recorded for it, where a place nothing fills holds nothing.
    (let nothing (call make-operand .operand-void 0))
    (let type (call (. facts node-type) (. unit reading) id))
    (let layout (call layout-of type id))
    (let sized (!= layout void-layout))
    (let count U32 (if-expr sized (. ([] (. tables layouts rows) layout) fields count) 0))
    (let made (if-expr sized (call frame layout) nothing))
    (let place U32)
    (let extended (call callee-type callable))
    (if (call is-binding extended)
      (let source (call emit-callee callable))
      (let held (call layout-of extended callable))
      (let copied U32 (+ (call bound-count extended) (if-expr (call binds-object extended) 1 0)))
      (for (in offset (..< 0 copied))
        (let value (call part (. source operand) held offset callable))
        (if (and sized (!= (. value type) (. types void-type)))
          (if (or (>= place count) (!= (. value type) (. (call (. tables layouts field) layout place) type)))
            (call refuse .refused-conversion id)
            (return (call Typed nothing no-type))
          )
          (call put made (call (. tables layouts field) layout place) (. value operand) id)
        )
        (+= place 1)
      )
      (else-if (call binds-object type)
        (let value (call Typed nothing no-type))
        (if (call holds-callee type)
          (= value (call emit-callee callable))
          (else
            (match ([] (. tree nodes) callable)
              (case (call .node-get-expression get)
                (= value (call emit-expression (. get object)))
              )
              (case .node-identifier
                (if (and (. unit has-self) (== (. unit reading) (. unit instance)))
                  (= value (call Typed (. unit self) (. unit owner-type)))
                  (else
                    (call refuse .refused-expression id)
                  )
                )
              )
              (default
                (call refuse .refused-expression id)
              )
            )
          )
        )
        (if (or (not sized) (!= (. value type) (. (call (. tables layouts field) layout 0) type)))
          (call refuse .refused-conversion id)
          (return (call Typed nothing no-type))
        )
        (call put made (call (. tables layouts field) layout 0) (. value operand) id)
        (= place 1)
      )
    )
    (let fills (call (of RowRange ArgumentFill)))
    (let placed (!= (call bound-object type) no-type))
    (if placed
      (let binds (call own-call id))
      (if (or (== binds no-fact) (not (. ([] (. facts calls) binds) is-partial)) (not sized))
        (call refuse .refused-expression id)
        (return (call Typed nothing no-type))
      )
      (= fills (. ([] (. facts calls) binds) fills))
    )
    (let position U32)
    (for (in argument ([] (. tree children) written))
      (let expression argument)
      (match? ([] (. tree nodes) argument)
        (case (call .node-argument named)
          (if (and (. named name) (not placed))
            (call refuse .refused-expression argument)
          )
          (= expression (. named expr))
        )
      )
      (if placed
        (= place count)
        (for (in index (..< 0 (. fills count)))
          (if (== (as ([] (. facts call-fills) (+ (. fills start) index)) U32) position)
            (= place (+ 1 index))
          )
        )
      )
      (+= position 1)
      (let value (call emit-expression expression))
      (if sized
        (if (or (>= place count) (!= (. value type) (. (call (. tables layouts field) layout place) type)))
          (call refuse .refused-conversion expression)
          (return (call Typed nothing no-type))
        )
        (call put made (call (. tables layouts field) layout place) (. value operand) expression)
        (else-if (!= (. value type) (. types void-type))
          (call refuse .refused-conversion expression)
          (return (call Typed nothing no-type))
        )
      )
      (+= place 1)
    )
    (if (and sized (!= place count) (not placed))
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (return (call Typed made type))
  )
  (fn-do _ emit-converting Typed
    (param id SyntaxId)
    (param callee InstanceId)
    (param argument SyntaxId)
    (param propagates Bool)
    ; A call of a type with one value that a function the type declares converts from. The value
    ; takes the conversion recorded for it, and the function answers. Where the function raises
    ; errors, they leave the function with the call where the type pass said so, and are panics
    ; where the value is a text written in source. Under `catch` the call gives what the function
    ; returned, its value or its error.
    (let nothing (call make-operand .operand-void 0))
    (let expression argument)
    (match? ([] (. tree nodes) argument)
      (case (call .node-argument named)
        (= expression (. named expr))
      )
    )
    (let value (call convert argument .reason-argument (call emit-expression expression)))
    (if (!= (. value type) (call (. instances argument-type) callee 0))
      (call refuse .refused-conversion argument)
      (return (call Typed nothing no-type))
    )
    (let raising (!= (. ([] (. instances signatures) callee) errors count) 0))
    (let mark (. pending length))
    (+= pending (. value operand))
    (= takes-result raising)
    (let made (call call-method callee id mark))
    (= takes-result false)
    (if (and raising propagates)
      (= made (call propagate id callee (. made operand)))
      (else-if (and raising (== (call (. facts plan-of) (. unit reading) id) .plan-literal-conversion))
        (= made (call panic-on-error id callee (. made operand)))
      )
    )
    (if (!= (. made type) (call (. facts node-type) (. unit reading) id))
      (call refuse .refused-conversion id)
    )
    (return made)
  )
  (fn-do _ emit-construct Typed
    (param id SyntaxId)
    (param fact CallFact)
    (param written (of RowRange SyntaxId))
    (param answers TypeId)
    (param bound SyntaxId (= 0))
    (param leading SyntaxId (= 0))
    ; A tuple or struct made by its fields. A call of a binding evaluates the binding first, and
    ; its arguments come before those written, as does the `leading` value a call is given before
    ; them. The arguments are evaluated in the order they are written, and then each takes the
    ; conversion recorded for it: one the binding holds, that recorded at the call for its type and
    ; that of the field it fills. Each field is given the argument the type pass matched to it, or
    ; its first value when the call leaves it out.
    ; What is made has the node's type, or `answers` for a call that no node writes. It is made in
    ; place, where TypeScript calls the constructor it generates, as the IR notes.
    (let nothing (call make-operand .operand-void 0))
    (let type (. ([] (. instances rows) (. fact callee)) self-type))
    (let layout (call layout-of type id))
    (let start (. given length))
    (let lead U32)
    (if (!= bound 0)
      (let source (call emit-callee bound))
      (let shape (. source type))
      (let held (call layout-of shape bound))
      (if (call binds-object shape)
        (call refuse .refused-expression id)
      )
      (= lead (call bound-count shape))
      (for (in offset (..< 0 lead))
        (let piece (call part (. source operand) held offset bound))
        (+= given piece)
      )
    )
    (if (!= leading 0)
      (= lead 1)
      (let emitted (call emit-expression leading))
      (+= given (call Typed (call settled emitted leading written 0) (. emitted type)))
    )
    (call give-arguments written)
    (for (in position (..< 0 lead))
      (if (!= leading 0)
        (let converted (call convert leading .reason-argument ([] given (+ start position))))
        (= ([] given (+ start position)) converted)
        (continue)
      )
      (let wanted (call filled-field-type type (. fact fills) position))
      (if (and (!= wanted no-type) (!= (. ([] given (+ start position)) type) wanted))
        (let converted (call convert-held id ([] given (+ start position)) wanted))
        (= ([] given (+ start position)) converted)
      )
    )
    (for (in position (..< 0 (. written count)))
      (let site ([] (. tree children) (+ (. written start) position)))
      (let converted (call convert site .reason-argument ([] given (+ start lead position))))
      (= ([] given (+ start lead position)) converted)
    )
    (let own-making making)
    (= making (= (. making callee) (. fact callee)))
    (let made (call make-fields type layout (. fact fills) start (+ lead (. written count)) id))
    (= making own-making)
    (call (. ir note-made-call))
    (call drop-given start)
    (let expected (if-expr (!= answers no-type) answers (call (. facts node-type) (. unit reading) id)))
    (if (!= type expected)
      (call refuse .refused-conversion id)
    )
    (return (call Typed made type))
  )
  (fn-do _ filled-field-type TypeId
    (param type TypeId)
    (param fills (of RowRange ArgumentFill))
    (param given U32)
    ; The type of the field of a tuple or struct one of the arguments given fills, or no type
    ; where it fills none.
    (let range (. ([] (. types completions) type) properties))
    (let position U32)
    (for (in offset (..< 0 (. range count)))
      (let property ([] (. types properties) (+ (. range start) offset)))
      (if (== (. property slot) (. U32 max))
        (continue)
      )
      (if (and (< position (. fills count)) (== (as ([] (. facts call-fills) (+ (. fills start) position)) U32) given))
        (return (. property type))
      )
      (+= position 1)
    )
    (return no-type)
  )
  (fn-do + call-default Typed
    (param id SyntaxId)
    (param kept GlobalStorage)
    ; A call of the function that evaluates a default, made where the call that leaves its
    ; argument out is. It is checked where the default may panic, which the type pass must have
    ; said of the caller too.
    (let target ([] (. tables functions) (. kept function)))
    (if (and (. target may-panic) (not (. function may-panic)) (not in-landing))
      (call refuse .refused-expression id)
      (return (call Typed (call make-operand .operand-void 0) no-type))
    )
    (let returns (call layout-of (. kept type) id))
    (call (. ir depend) .callee-function (. kept function) (if-expr (. target may-panic) may-panic-dependency 0u32))
    (if in-zone
      (call cross-zone id false)
    )
    (let result
      (call call
        (block
          (arg (call make-operand .operand-symbol (. target symbol)))
          (arg id)
          (arg (. pending length))
          (arg .callee-function)
          (arg returns)
          (arg (and (. target may-panic) (not in-landing)))
        )
      )
    )
    (if in-zone
      (call cross-zone id true)
    )
    (return (call Typed result (. kept type)))
  )
  (fn-expr _ takes-default Bool
    (param fact CallFact)
    (param owner Module)
    (param first Index)
    (param given U32)
    (param type TypeId)
    ; Whether an argument a call gives is an optional that fills a parameter with a default. Such
    ; a parameter takes its default where the argument holds nothing.
    (case? (or (== type no-type) (== type invalid-type) (not (call (. types is-optional) type)))
      false
    )
    (default
      (and (!= parameter (. U32 max)) (!= (. ([] (. owner arg-pool) (+ first parameter)) default-syntax) 0))
    )
    (where
      (lazy parameter (call filled-parameter fact given))
    )
  )
  (fn-do _ optional-argument Typed
    (param id SyntaxId)
    (param site SyntaxId)
    (param value Typed)
    (param callee InstanceId)
    (param default SyntaxId)
    (param expected TypeId)
    ; An optional given to a parameter with a default: what it holds, converted as the call
    ; records for the argument, or the default where it holds nothing, converted as the argument
    ; records for a default.
    (let nothing (call make-operand .operand-void 0))
    (let held (. value type))
    (let layout (call layout-of expected id))
    (let tested (call present site value))
    (let given-block (call (. ir reserve-block)))
    (let absent (call (. ir reserve-block)))
    (let joined (call (. ir reserve-block)))
    (let slot (call join-slot layout))
    (let mark (. joins length))
    (call branch (. tested operand) given-block absent)
    (call (. ir start-block) given-block)
    (let passed (call convert site .reason-argument (call Typed (. value operand) held)))
    (if (!= (. passed type) expected)
      (call refuse .refused-conversion site)
    )
    (call arrive id (. passed operand) joined slot)
    (call (. ir start-block) absent)
    (let other (call default-argument site callee default expected))
    (if (!= (. other type) expected)
      (call refuse .refused-conversion id)
    )
    (call arrive id (. other operand) joined slot)
    (return (call Typed (call close-joins joined mark layout slot) expected))
  )
  (fn-do _ emit-c-call Typed
    (param id SyntaxId)
    (param operands (of RowRange SyntaxId))
    (param bound SyntaxId (= 0))
    ; A call of a C function, by the policy its declaration has:
    ; - one that cannot reach the collector is called as it is;
    ; - one that polls is called between two polls;
    ; - any other may block, and is called between two checks that the task is not being
    ;   terminated, where the function `raises-termination`, as foreign code the collector does
    ;   not wait for.
    ; After a call of the last two kinds the panic signal is read again. In a function the
    ; collector never sees, a call of those two kinds leaves that zone before its first check
    ; and enters it again after its last. One that suspends the task is called as it is, and
    ; then, where the function `raises-termination`, the task is checked for being terminated,
    ; which raises the termination panic; elsewhere the task runs on until a check finds it, as
    ; after a poll, for no caller checks the panic signal of a function that may not panic. One that
    ; leaves a termination to what follows, a lock taken or an answer the caller checks, is not
    ; followed by the check (`checks-termination`). It has no shape where the collector never looks.
    ; A call the type pass planned to describe the storage it makes is called by the policy of the
    ; runtime's function that describes it, which polls.
    ; A call of a binding gives `bound`, the binding: it is evaluated first, and the arguments it
    ; holds come before those written, each converted as the type pass recorded at the call.
    (let nothing (call make-operand .operand-void 0))
    (if (== (call (. facts plan-of) (. unit reading) id) .plan-elided)
      (return (call Typed nothing (call (. facts node-type) (. unit reading) id)))
    )
    (let fact (call (. facts answer-call) (. unit reading) id .role-answer))
    (if (== fact no-fact)
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (let callee (. ([] (. facts calls) fact) callee))
    (let symbol ([] (. tables c-symbols) callee))
    (throw (call Panic "A called C function has no symbol") (if (== symbol no-string)))
    (blank)
    (let polls false)
    (let leaf false)
    (let row ([] (. instances rows) callee))
    (match? ([] (. ([] (. program modules) (. row module)) decls) (. row decl))
      (case (call .decl-function fn)
        (= polls (!= (/and/ (. fn effects) (. CompilationEffect gc-polling)) 0))
        (= leaf (!= (/and/ (. fn effects) (. CompilationEffect gc-leaf)) 0))
      )
    )
    (if (== (call (. facts plan-of) (. unit reading) id) .plan-described)
      (= polls true)
      (= leaf false)
    )
    (let suspends (!= ([] (. tables c-suspends) callee) 0))
    (if (and suspends in-zone)
      (call refuse .refused-suspending-call id)
      (return (call Typed nothing no-type))
    )
    (let leaves (and (not leaf) (not suspends) in-zone))
    (let mark (. pending length))
    (let position U32)
    (if (!= bound 0)
      (let source (call emit-callee bound))
      (let shape (. source type))
      (let held (call layout-of shape bound))
      (let count (call bound-count shape))
      (for (in offset (..< 0 count))
        (let expected (call (. instances argument-type) callee position))
        (let value (call part (. source operand) held offset bound))
        (if (!= (. value type) expected)
          (= value (call convert-held id value expected))
        )
        (if (!= (. value type) expected)
          (call refuse .refused-conversion id)
        )
        (+= pending (. value operand))
        (+= position 1)
      )
    )
    (for (in argument ([] (. tree children) operands))
      (let expression argument)
      (match? ([] (. tree nodes) argument)
        (case (call .node-argument given)
          (= expression (. given expr))
        )
      )
      (let value (call convert argument .reason-argument (call emit-expression expression)))
      (if (!= (. value type) (call (. instances argument-type) callee position))
        (call refuse .refused-conversion argument)
      )
      (+= pending (. value operand))
      (+= position 1)
    )
    (let returns (call layout-of (call (. facts node-type) (. unit reading) id) id))
    (let described no-layout)
    (if (== (call (. facts plan-of) (. unit reading) id) .plan-described)
      (= described (call described-items id callee))
    )
    (if (!= described no-layout)
      (+= pending (call make-operand .operand-buffer-descriptor described))
      (else
        (call (. ir depend) .callee-c symbol 0)
      )
    )
    (if leaves
      (call cross-zone id false)
      (= in-zone false)
    )
    (if suspends
      (= leaf true)
      (call call-probe-thunk (. tables probe-flush) id)
      (else-if polls
        (call poll id)
      )
      (else-if (not leaf)
        (call check-interrupt id)
        (call call-runtime .runtime-enter-ffi id (. pending length) void-layout true)
      )
    )
    (let result nothing)
    (if (!= described no-layout)
      (= result (call call-runtime (as ([] (. tables c-described) callee) RuntimeFunction) id mark returns))
      (else
        (= result (call call (call make-operand .operand-symbol symbol) id mark .callee-c returns))
      )
    )
    (if suspends
      (if (not (call is-unprobed))
        (call call-probe-thunk (. tables probe-safepoint) id)
      )
      (if (and (call raises-termination) (call (. tables checks-termination) callee))
        (let resumed (call (. ir reserve-block)))
        (let raised (call call-instance (. instances report termination) id (. pending length)))
        (call branch (. raised operand) (call landing-block id) resumed)
        (call (. ir start-block) resumed)
      )
    )
    (if leaf
      (return (call Typed result (call (. facts node-type) (. unit reading) id)))
    )
    (if polls
      (call poll id)
      (else
        (call call-runtime .runtime-leave-ffi id (. pending length))
        (call check-interrupt id)
      )
    )
    (call append .op-load-panic-signal id (call Span) 0)
    (let resumed (call (. ir reserve-block)))
    (call branch (call make-operand .operand-panic-signal 0) (call landing-block id) resumed)
    (call (. ir start-block) resumed)
    (if leaves
      (call cross-zone id true)
      (= in-zone true)
    )
    (return (call Typed result (call (. facts node-type) (. unit reading) id)))
  )
  (fn-do _ described-items LayoutId
    (param id SyntaxId)
    (param callee InstanceId)
    ; The layout of the items of the storage a C call allocates, resizes or copies for an array
    ; the collector owns, where an item holds pointers the collector follows: the call is then
    ; of the function that also takes what describes the storage. No layout for any other item.
    (let described (call (. facts type-detail-of) (. unit reading) id))
    (if (or (== described no-type) (== ([] (. tables c-described) callee) no-runtime-function))
      (call refuse .refused-expression id)
      (return no-layout)
    )
    (let layout (call layout-of described id))
    (if (or (== layout void-layout) (not (. ([] (. tables layouts rows) layout) is-managed)))
      (return no-layout)
    )
    (if (== (. ([] (. tables layouts rows) layout) buffer) no-string)
      (call refuse .refused-type id)
      (return no-layout)
    )
    (return layout)
  )
)
