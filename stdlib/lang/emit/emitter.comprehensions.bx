(import ./emitter)
(import ./emitter.calls)
(import ./emitter.lazies)
(import ./emitter.live-actions)
(import ./emitter.loops)
(import ./emitter.streams)
(import ./layouts)
(import ./program-tables)
(import ./receiver-stability)
(import ./runtime)
(import ./table-layouts)
(import /core/arena)
(import /core/table)
(import /lang/ast/ast)
(import /lang/ast/ast-children)
(import /lang/ast/ast-nodes)
(import /lang/ast/ast-queries)
(import /lang/ast/decl)
(import /lang/ast/module)
(import /lang/ast/operator)
(import /lang/ast/program)
(import /lang/ast/row-range)
(import /lang/ast/state-machines)
(import /lang/backend/mir)
(import /lang/check/binding)
(import /lang/check/claims)
(import /lang/check/facts)
(import /lang/check/instances)
(import /lang/check/machine-composite)
(import /lang/check/numeric)
(import /lang/check/pattern-helper)
(import /lang/check/probe-casts)
(import /lang/check/table-rows)
(import /lang/check/type-signature)
(import /lang/check/type-store)
(import /lang/check/type-text)
(import /lang/check/types)
(import /lang/ir/ir)
(import /stream/sort)

(type _ Comprehensions (facet-of FunctionEmitter)
  (sees Calls)
  (sees Lazies)
  (sees LiveActions)
  (sees Loops)
  (sees Streams)
  (fn-do _ emit-broadcaster Typed
    (param id SyntaxId)
    (param loop SyntaxId)
    (param container SyntaxId)
    ; A comprehension on a stream where it is written: the container is made a `Broadcastable`,
    ; the channel is made and kept in the local the subscriber captures, and the subscriber, the
    ; environment in force here, is made a `Subscriber` and given to the broadcaster's
    ; `subscribe`, whose errors leave the function as the type pass said, or subscribed as
    ; `subscribe-whenever` says where the comprehension has a `whenever` clause. The channel, read again
    ; from where it is kept, is the comprehension's value. One written in the value of a global,
    ; where the function that types the value is not the one emitted, keeps the channel in an
    ; environment of its own: see `lone-environment`. One that is the value of a lazy local nested
    ; functions capture, evaluated by a function written in the one that declares the local, keeps
    ; it in the environment that holds the local, as `emit-closure` gives that environment.
    (let nothing (call make-operand .operand-void 0))
    (let stream (call emit-broadcastable loop container))
    (let broadcaster (. stream type))
    (let made (call call-at id .call-constructor))
    (let slot (call channel-slot id))
    (let channel (call (. facts node-type) (. unit reading) id))
    (let closure (call subscriber-closure id))
    (if (or (== made no-fact) (== slot no-slot) (== closure no-type) other-channel)
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (lazy other-channel (!= (. ([] (. instances signatures) (. ([] (. facts calls) made) callee)) returns) channel))
    (let lone (if-expr (and (!= (. unit reading) (. unit instance)) (== (call shared-written id) no-slot)) (call lone-environment id slot) no-local))
    (let object (call call-instance (. ([] (. facts calls) made) callee) id (. pending length)))
    (let written (call Typed nothing no-type))
    (if (== lone no-local)
      (call keep-captured slot (. object operand) channel id)
      (= written (call emit-closure id closure))
      (else
        (call keep-lone lone slot (. object operand) channel id)
        (= written (call Typed (call load-local lone id) closure))
      )
    )
    (let subscriber (call convert id .reason-argument written))
    (let given (. subscriber type))
    (let owned (call (. tables owned-subscription-of) (. unit reading) id))
    (let retested (call (. tree whenever-clause) loop))
    (let retest (only-if (call (. tables live-statement-of) (. unit reading) retested) (if (!= retested 0))))
    (if retest
      (call subscribe-whenever id retested retest (. stream operand) broadcaster (. subscriber operand))
      (else-if (!= retested 0)
        (call refuse .refused-expression retested)
      )
      (else-if owned
        (call own-subscription id owned (. stream operand) (. subscriber operand))
      )
      (else
        (do
          (inline (call call-protocol id (call call-at id .call-method) (. stream operand) broadcaster (. subscriber operand) given))
        )
      )
    )
    (if (!= lone no-local)
      (return (call Typed (call take (call load-local lone id) (call lone-field slot) id) channel))
    )
    (return (call read-captured slot id channel))
  )
  (fn-do + emit-comprehension Typed
    (param id SyntaxId)
    (param loop SyntaxId)
    ; A comprehension written as a value: a call of the function generated for it. The
    ; container of its loop is evaluated here, where the comprehension is written, and given
    ; to the function. The call gives the generator. One on a stream subscribes here instead:
    ; see `emit-broadcaster`.
    (let container SyntaxId 0)
    (match? ([] (. tree nodes) loop)
      (case (call .node-loop-syntax row)
        (if (. row is-subscriber)
          (return (call emit-broadcaster id loop (. row container)))
        )
        (= container (. row container))
      )
    )
    (if (== container 0)
      (call refuse .refused-expression id)
      (return (call Typed (call make-operand .operand-void 0) no-type))
    )
    (return (call emit-comprehension-call id container))
  )
  (fn-do _ emit-comprehension-call Typed
    (param id SyntaxId)
    (param container SyntaxId)
    (param converts Bool (= false))
    ; The call of the function generated for a comprehension, or for a stream piped through a
    ; pattern, given the container, which gives the generator. A container that `converts` is
    ; converted as the type pass recorded for it as an argument.
    (let answer (call call-generated id container converts))
    (if (!= (. answer type) (call (. facts node-type) (. unit reading) id))
      (call refuse .refused-conversion id)
    )
    (return answer)
  )
  (fn-do _ call-generated Typed
    (param id SyntaxId)
    (param given-site SyntaxId)
    (param converts Bool (= false))
    ; A call of the function generated for what is written at a node, a comprehension, a list
    ; of feeds or the right side of a pipe, which the type pass recorded there. It is given
    ; the environment in force, which the function reads the locals it captures from, and
    ; then the value written at `given-site`, where it takes one, evaluated here, and where it
    ; `converts`, converted as the type pass recorded for it as an argument. One written in
    ; the value a class writes for a property is typed by the instance that types that value,
    ; and given no environment, where that instance makes none: it captures nothing. Where it
    ; makes one it has no shape. One written in the value of a lazy local nested functions
    ; capture, evaluated by a function written in the one that declares it (`read-shared`), is
    ; given the environment that holds the local, which is the one in force where it is written.
    ; One a constructor makes has no shape where `emit-closure` gives a nested function none: while
    ; the properties are given their values, where nested functions read the receiver, and after,
    ; where the properties read a lazy local nested functions capture.
    (let nothing (call make-operand .operand-void 0))
    (let callee no-instance)
    (let propagates false)
    (let fact (call (. facts first-call) (. unit reading) id))
    (while (!= fact no-fact)
      (if (== (. ([] (. facts calls) fact) form) .call-closure)
        (= callee (. ([] (. facts calls) fact) callee))
        (= propagates (. ([] (. facts calls) fact) propagates))
      )
      (= fact (. ([] (. facts calls) fact) next))
    )
    (let count U32 (if-expr (!= given-site 0) 1 0))
    (let outside (!= (. unit reading) (. unit instance)))
    (let held (and outside (!= ([] (. tables environments) (. unit reading)) no-layout)))
    (let shared (call shared-slot))
    (let receiving (and (. filling storing) (not outside) (call shares-receiver)))
    (let doubled (and (not (. filling storing)) (not outside) (call fills-share) (call shares-lazy)))
    (if (or (== callee no-instance) (and held (== shared no-slot)) receiving doubled)
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (if (and outside (!= (. ([] (. instances rows) callee) enclosing) (. unit reading)))
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (if (or (== ([] (. tables instance-functions) callee) no-function) other-arity)
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (lazy other-arity (!= (. ([] (. instances signatures) callee) args count) count))
    (let given-value (call Typed nothing no-type))
    (if (!= given-site 0)
      (= given-value (call emit-expression given-site))
      (if converts
        (= given-value (call convert given-site .reason-argument given-value))
      )
      (if (!= (. given-value type) (call (. instances argument-type) callee 0))
        (call refuse .refused-conversion given-site)
      )
    )
    (let written (call nested-environment id))
    (if (and outside (!= (. (call (. tables stack-holds) callee) length) 0))
      (call refuse .refused-expression id)
    )
    (call hold-stacks id (. ([] (. instances rows) callee) decl) written)
    (let mark (. pending length))
    (+= pending written)
    (if (!= given-site 0)
      (+= pending (. given-value operand))
    )
    (let raising (!= (. ([] (. instances signatures) callee) errors count) 0))
    (= takes-result raising)
    (let answer (call call-instance callee id mark))
    (= takes-result false)
    (return-if (call propagate id callee (. answer operand)) (if (and raising propagates)))
    (return answer)
  )
  (fn-do + emit-feed-list Typed
    (param id SyntaxId)
    ; A list of feeds written as a value: a call of the function generated for it, which the
    ; type pass recorded at the first feed, and which gives the generator.
    (return (call call-generated id 0))
  )
  (fn-do + emit-feeds _
    (param first SyntaxId)
    ; The body of the function generated for a list of feeds: each feed in turn yields
    ; its item, converted as the type pass recorded for the list at the item; one written
    ; `*?` yields what an optional holds, where it holds anything; and one written `**`
    ; yields every item of what it writes, by the loop the type pass planned at the feed.
    ; An item written as a cast keeps the cast's conversion where the list's is kept, so only
    ; the conversions of what the item gave are made. One written `*?` whose item is no
    ; optional has no shape yet.
    (let feed first)
    (while (!= feed 0)
      (let next SyntaxId 0)
      (match? ([] (. tree nodes) feed)
        (case (call .node-feed-expression row)
          (= next (. row next))
          (if (. row is-spread)
            (call emit-spread feed (. row item) (. row is-optional))
            (else
              (let value
                (call convert-matched
                  (block
                    (arg (. row item))
                    (arg .reason-explicit)
                    (arg (call emit-expression (. row item)))
                    (arg no-type)
                  )
                )
              )
              (if (and (. row is-optional) (not (call (. types is-optional) (. value type))))
                (call refuse .refused-expression feed)
              )
              (call yield-item (call (. facts feed-site) (. unit reading) feed) value (. row is-optional))
            )
          )
        )
      )
      (= feed next)
    )
  )
  (fn-do + emit-built-feeds _
    (param declared SyntaxId)
    (param first SyntaxId)
    (let list (call build-feeds first first returns-type .reason-return))
    (call return-value (. list operand) declared)
  )
  (fn-do + emit-listed-feeds Typed
    (param id SyntaxId)
    (param first SyntaxId)
    (return (call build-feeds id first (call (. facts node-type) (. unit reading) id) .reason-element))
  )
  (fn-do _ build-feeds Typed (?! Refused)
    (param home SyntaxId)
    (param first SyntaxId)
    (param listed TypeId)
    (param reason ConversionReason)
    (let appends (call call-at home .call-list-append))
    (if (or (== appends no-fact) (== first 0))
      (call refuse .refused-expression home)
      (return (call Typed (call make-operand .operand-void 0) no-type))
    )
    (let outer-list built-list)
    (let outer-item built-item)
    (let outer-append built-append)
    (let outer-reason built-reason)
    (let outer-spreading spreading)
    (= built-append (. ([] (. facts calls) appends) callee))
    (= built-item (call (. instances argument-type) built-append 0))
    (= built-reason reason)
    (= spreading 0)
    (let count U32 0)
    (let room U32 0)
    (let leading true)
    (let feed first)
    (while (!= feed 0)
      (match? ([] (. tree nodes) feed)
        (case (call .node-feed-expression row)
          (= leading (and leading (not (. row is-spread)) (not (. row is-optional))))
          (if leading
            (+= count 1)
            (else-if (not (. row is-spread))
              (+= room 1)
            )
          )
        )
      )
      (= feed (call (. tree next-feed) feed))
    )
    (let mark (. open-cleanups length))
    (let own-scoping scoping)
    (= scoping (= (. scoping block-base) mark))
    (let start (. given length))
    (= feed first)
    (for (in _ (..< 0 count))
      (match? ([] (. tree nodes) feed)
        (case (call .node-feed-expression row)
          (let value (call convert-matched (. row item) .reason-explicit (call emit-expression (. row item)) no-type))
          (let site (call (. facts feed-site) (. unit reading) feed))
          (let converted (call built-value site value))
          (if (!= (. converted type) built-item)
            (call refuse .refused-conversion site)
          )
          (+= given (call Typed (call apart converted (. row item) (> count 1)) (. converted type)))
        )
      )
      (= feed (call (. tree next-feed) feed))
    )
    (let list (call build-list home (call (of RowRange SyntaxId) 0 count) listed start false first room))
    (call drop-given start)
    (= built-list (. list operand))
    (while (!= feed 0)
      (match? ([] (. tree nodes) feed)
        (case (call .node-feed-expression row)
          (if (. row is-spread)
            (= spreading feed)
            (call emit-spread feed (. row item) (. row is-optional))
            (= spreading 0)
            (else
              (let value (call convert-matched (. row item) .reason-explicit (call emit-expression (. row item)) no-type))
              (if (and (. row is-optional) (not (call (. types is-optional) (. value type))) (== reason .reason-return))
                (call refuse .refused-expression feed)
              )
              (call append-built (call (. facts feed-site) (. unit reading) feed) value (. row is-optional))
            )
          )
        )
      )
      (= feed (call (. tree next-feed) feed))
    )
    (let built (call close-value list mark own-scoping home))
    (= built-list outer-list)
    (= built-item outer-item)
    (= built-append outer-append)
    (= built-reason outer-reason)
    (= spreading outer-spreading)
    (return built)
  )
  (fn-do _ emit-spread _
    (param feed SyntaxId)
    (param item SyntaxId)
    (param optional Bool)
    ; A spread of what it writes. Of a range of integers written there,
    ; the loop that counts through it. Of a container, a loop over it by the protocol the type
    ; pass planned at the feed, whose slots keep the container, converted first to the iterable
    ; it is read as where it is not one: `**?` reads what an optional holds and gives nothing
    ; where it holds none. Each item is yielded as it is read. What the
    ; loop does at the feed is located on the line under it where the type pass noted that.
    (let plan (call (. facts plan-of) (. unit reading) feed))
    (if (and (== plan .plan-range-loop) (not optional))
      (match? ([] (. tree nodes) item)
        (case (call .node-range-expression range)
          (call emit-range-loop feed (. range op) (. range left) (. range right) 0 0)
          (return)
        )
      )
    )
    (if (and (!= plan .plan-index-loop) (!= plan .plan-cursor-loop) (!= plan .plan-stream-loop))
      (call refuse .refused-expression feed)
      (return)
    )
    (let slot (call loop-slots feed))
    (let held (call convert item .reason-explicit (call emit-expression item)))
    (let beyond no-block)
    (if (and optional (call (. types is-optional) (. held type)))
      (let wrapped (. held type))
      (let given (call (. ir reserve-block)))
      (= beyond (call (. ir reserve-block)))
      (call branch (. (call present feed held) operand) given beyond)
      (call (. ir start-block) given)
      (= held (call payload feed (call Typed (. held operand) wrapped)))
    )
    (let site (call (. facts feed-site) (. unit reading) feed))
    (if (!= site 0)
      (= held (call convert site .reason-operand held))
    )
    (call keep-state slot (. held operand) (. held type) feed)
    (let shifted lowered)
    (= lowered (if-expr (call (. facts is-feed-below) (. unit reading) feed) feed 0))
    (call emit-headed feed item 0 0 true)
    (= lowered shifted)
    (if (!= beyond no-block)
      (call jump beyond)
      (call (. ir start-block) beyond)
    )
  )
  (fn-do + emit-pattern-pipe _
    (param pipe SyntaxId)
    ; The body of the function generated for a stream piped through a pattern, as the reference makes
    ; it: the stream the pattern reads the value piped through is made, once, of what a feed the pipe
    ; reads alone writes where it reads one, evaluated then and converted as the type pass recorded.
    ; Then on each pass the stream releases what it delivered, as the type pass chose for a stream the
    ; function makes or one it is given; it is asked whether it has more, and the function ends where
    ; it has not; its position is taken, and the pattern matched from where it is, as a rule's arms
    ; are, without reading the rest, asking the stream for more input where a part reads past the end
    ; of its buffer; the function ends where it fails. Where the match did not move the stream on, it
    ; panics; else what it gave is yielded. A helper the pipe is given is evaluated once, after the
    ; stream is made, and kept for every match to run under. One that marks the records a pipe matches
    ; is asked to begin each record, where the stream has more, before the stream's position is taken.
    (let right SyntaxId 0)
    (match? ([] (. tree nodes) pipe)
      (case (call .node-pipeline-expression row)
        (= right (. row right))
      )
      (case (call .node-binary-expression row)
        (= right (. row rhs))
      )
    )
    (let pattern right)
    (let helper SyntaxId 0)
    (match? ([] (. tree nodes) right)
      (case (call .node-stream-match row)
        (= pattern (. row pattern))
        (= helper (. row helper))
      )
    )
    (let result (call (. facts node-type) (. unit reading) pattern))
    (let first (call (. facts first-call) (. unit reading) pipe))
    (let releases (if-expr (and (!= first no-fact) (== (. ([] (. facts calls) first) form) .call-method)) first no-fact))
    (let asks (if-expr (!= releases no-fact) (call next-call first) first))
    (let marks (call next-call asks))
    (let begins (call next-call marks))
    (if (or (== right 0) (== result no-type) (== result invalid-type) (== marks no-fact))
      (call refuse .refused-statement pipe)
      (return)
    )
    (let slot (call loop-slots pipe))
    (match? ([] (. tree nodes) (call (. tree piped-feed) pipe))
      (case (call .node-feed-expression row)
        (let written (call convert (. row item) .reason-argument (call emit-expression (. row item))))
        (call keep-state slot (. written operand) (. written type) pipe)
      )
    )
    (let container (call state slot pipe))
    (let container-type (. container type))
    (let made (call stream-maker right))
    (let viewed (if-expr (!= made no-fact) (call next-call made) (call (. facts first-call) (. unit reading) right)))
    (let commits (call next-call viewed))
    (if (== commits no-fact)
      (call refuse .refused-statement pipe)
      (return)
    )
    (let opened (call stream-of right (. container operand) container-type made))
    (call keep-state (+ slot 1) (. opened operand) (. opened type) pipe)
    (if (!= helper 0)
      (let helping (call emit-expression helper))
      (call keep-state (+ slot 2) (. helping operand) (. helping type) pipe)
      (if (!= (call (. facts plan-of) (. unit reading) helper) .plan-pattern-helper)
        (call refuse .refused-statement pipe)
        (return)
      )
    )
    (let root (call (. ir reserve-block)))
    (let done (call (. ir reserve-block)))
    (call jump root)
    (call (. ir start-block) root)
    (call emit-poll pipe)
    (let stream (call state (+ slot 1) pipe))
    (let stream-type (. stream type))
    (if (!= releases no-fact)
      (call call-protocol pipe releases (. stream operand) stream-type (call make-operand .operand-void 0))
    )
    (let more (call call-protocol pipe asks (. stream operand) stream-type (call make-operand .operand-void 0)))
    (if (!= (. more type) (. types bool-type))
      (call refuse .refused-statement pipe)
      (return)
    )
    (let moving (call (. ir reserve-block)))
    (call branch (call compare pipe .compare-not-equal (. more operand) (call integer .machine-u8 0)) moving done)
    (call (. ir start-block) moving)
    (if (!= begins no-fact)
      (let kept (call state (+ slot 2) pipe))
      (call call-protocol pipe begins (. kept operand) (. kept type) (call make-operand .operand-void 0))
    )
    (let began (call marked-cursor pipe marks (. stream operand) stream-type))
    (let refills
      (scope (or (== made no-fact) chunked)
        (lazy chunked (call same-decl (call class-ref types stream-type) (. types chunked-token-stream-decl)))
      )
    )
    (let run (call view-stream right (. stream operand) stream-type refills viewed (call next-call commits)))
    (if (!= helper 0)
      (let kept-state (call state (+ slot 2) pipe))
      (= streaming (= (. streaming pattern-helper) (. kept-state operand)))
      (= streaming (= (. streaming pattern-helper-type) (. kept-state type)))
    )
    (let value (call attempt-arms right pattern result run false commits done false))
    (let ended (call marked-cursor pipe marks (. stream operand) stream-type))
    (let moved (call (. ir reserve-block)))
    (let stuck (call (. ir reserve-block)))
    (call branch (call compare pipe .compare-greater (. ended operand) (. began operand)) moved stuck)
    (call (. ir start-block) stuck)
    (call raise-text right "Grammar pipeline made no input progress")
    (call (. ir start-block) moved)
    (call yield-item right (call Typed (. value operand) result) false)
    (call jump root)
    (call (. ir start-block) done)
  )
  (fn-do _ marked-cursor Typed
    (param site SyntaxId)
    (param fact FactId)
    (param stream Operand)
    (param stream-type TypeId)
    ; Where a stream is, as the mark the call the type pass recorded makes of it holds it.
    (let mark (call call-protocol site fact stream stream-type (call make-operand .operand-void 0)))
    (let layout (call layout-of (. mark type) site))
    (if (or (not (call (. tables layouts is-struct) layout)) (!= (. ([] (. tables layouts rows) layout) fields count) 2))
      (call refuse .refused-type site)
      (return mark)
    )
    (return (call part (. mark operand) layout 1 site))
  )
  (fn-do + keep-piped _
    (param declared SyntaxId)
    ; Copies the item, or the value, a pipe gives the function generated for its right side into
    ; the function's environment, where nested functions capture its `each` or its `it`.
    (for (in offset (..< 0 (. unit slot-count)))
      (let slot (+ (. unit slot-start) offset))
      (let row ([] (. bindings slots) slot))
      (if (or (and (!= (. row kind) .slot-each) (!= (. row kind) .slot-it)) (!= (. row syntax) piped) uncaptured)
        (continue)
      )
      (lazy uncaptured (or (not (call owns slot)) (not (call is-captured slot))))
      (if (!= (. ir arguments length) 2)
        (call refuse .refused-function declared)
        (return)
      )
      (call keep-captured
        (block
          (arg slot)
          (arg (call make-operand .operand-argument 1))
          (arg (call (. instances argument-type) (. unit instance) 0))
          (arg declared)
        )
      )
    )
  )
  (fn-do _ emit-stream-pipe Typed
    (param id SyntaxId)
    (param left SyntaxId)
    ; A stream piped through a function over each of its items: the call the type pass
    ; recorded at the pipe, of the function of `core/stream` that maps, filters or taps a
    ; stream, given the stream on the left and the function generated for the right side as a
    ; value of the function type it takes.
    ; 1. The stream is evaluated, and converted as the type pass recorded where its facts are
    ;    kept: at the left side, or for a list of feeds at the feed after the first, or at
    ;    the pipe where there is none, for a reason of its own apart from the pipe's value.
    ; 2. The function is the environment its body is given (`nested-environment`), converted as
    ;    recorded at the pipe.
    ; A stack trace through the function on the right is the one TypeScript prints with no
    ; inlining. The answer has the type the function called returns: the type pass keeps the
    ; type of a list of one feed at the pipe that reads it.
    (let nothing (call make-operand .operand-void 0))
    (let fact (call own-call id))
    (let site left)
    (match? ([] (. tree nodes) left)
      (case (call .node-feed-expression row)
        (= site (if-expr (!= (. row next) 0) (. row next) id))
      )
    )
    (let outside (!= (. unit reading) (. unit instance)))
    (if (or (== fact no-fact) (and holds-environment (== (call shared-slot) no-slot)) receiving)
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (lazy holds-environment (and outside (!= ([] (. tables environments) (. unit reading)) no-layout)))
    (lazy receiving (and (. filling storing) (not outside) (call shares-receiver)))
    (let call ([] (. facts calls) fact))
    (let callee (. call callee))
    (if (or (!= (. call form) .call-function) (== callee no-instance) (. call is-partial) (!= (. call fills count) 2))
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (let first (as ([] (. facts call-fills) (. call fills start)) U32))
    (let second (as ([] (. facts call-fills) (+ (. call fills start) 1)) U32))
    (if (or (!= first 0) (!= second 1) (== ([] (. tables instance-functions) callee) no-function))
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (let reason ConversionReason (if-expr (== site id) .reason-piped .reason-argument))
    (let source (call convert-matched site reason (call emit-expression left) (call (. instances argument-type) callee 0)))
    (if (!= (. source type) (call (. instances argument-type) callee 0))
      (call refuse .refused-conversion left)
      (return (call Typed nothing no-type))
    )
    (let function (call Typed nothing no-type))
    (let wanted (call (. instances argument-type) callee 1))
    (let shape (call (. facts first-conversion) (. unit reading) id))
    (while (and (!= shape no-fact) (!= (. function type) wanted))
      (let row ([] (. facts conversions) shape))
      (if (and (== (. row reason) .reason-argument) (call is-closure (. row from)) (!= (. row runs) no-instance))
        (if (and outside (!= (. ([] (. instances rows) (. row runs)) enclosing) (. unit reading)))
          (call refuse .refused-expression id)
          (return (call Typed nothing no-type))
        )
        (= function (call convert-one id row (call Typed (call nested-environment id) (. row from))))
      )
      (= shape (. row next))
    )
    (if (!= (. function type) wanted)
      (call refuse .refused-conversion id)
      (return (call Typed nothing no-type))
    )
    (let mark (. pending length))
    (+= pending (. source operand))
    (+= pending (. function operand))
    (return (call call-instance callee id mark))
  )
  (fn-do _ emit-write-all Typed
    (param id SyntaxId)
    (param left SyntaxId)
    (param right SyntaxId)
    ; A value written whole to what is on the right of the pipe: the one call the type pass
    ; recorded at the pipe, of the function the type on the right declares for a write, given
    ; the value. The value is evaluated first, as it is written first, and the pipe gives what
    ; it wrote to.
    (let nothing (call make-operand .operand-void 0))
    (let fact (call (. facts first-call) (. unit reading) id))
    (if (or (== fact no-fact) (!= (. ([] (. facts calls) fact) next) no-fact) (. ([] (. facts calls) fact) is-swapped))
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (let made (call emit-expression left))
    (let value (call apart made left (not (call is-inert right))))
    (let given (. made type))
    (let sink (call emit-expression right))
    (let sink-type (. sink type))
    (call call-operator id fact right (. sink operand) sink-type left value given)
    (return (call Typed (. sink operand) sink-type))
  )
  (fn-do _ emit-write-each Typed
    (param id SyntaxId)
    (param left SyntaxId)
    (param right SyntaxId)
    ; Each item of what the pipe reads written to what is on the right, as the reference lowers
    ; it: what is on the right is evaluated first and kept, and the loop the type pass planned
    ; at the pipe reads the left, each turn giving the item to the write recorded at the pipe
    ; after the calls of the loop's protocol. A range of integers written there is counted
    ; through. The pipe gives what it wrote to.
    (let nothing (call make-operand .operand-void 0))
    (let fact (call (. facts first-call) (. unit reading) id))
    (while (and (!= fact no-fact) (!= (. ([] (. facts calls) fact) next) no-fact))
      (= fact (. ([] (. facts calls) fact) next))
    )
    (if (or (== fact no-fact) (. ([] (. facts calls) fact) is-swapped))
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (let sink (call emit-expression right))
    (let sink-type (. sink type))
    (let layout (call layout-of sink-type id))
    (let kept (call (. ir add-local) layout))
    (call store-local kept (. sink operand) id)
    (+= writes (call WriteEach id fact left right kept sink-type))
    (let plan (call (. facts plan-of) (. unit reading) id))
    (let counted false)
    (match? ([] (. tree nodes) left)
      (case (call .node-range-expression range)
        (if (and (== plan .plan-range-loop) (!= (. range left) 0) (!= (. range right) 0))
          (call emit-range-loop id (. range op) (. range left) (. range right) 0 0)
          (= counted true)
        )
      )
    )
    (if (and (not counted) (or (== plan .plan-index-loop) (== plan .plan-cursor-loop) (== plan .plan-stream-loop)))
      (call emit-headed id left 0 0)
      (else-if (not counted)
        (call refuse .refused-expression id)
      )
    )
    (call (. writes pop))
    (let written (call load-local kept id))
    (return (call Typed written sink-type))
  )
  (fn-do _ emit-piped Typed
    (param id SyntaxId)
    (param left SyntaxId)
    ; A value given whole to the function generated for the right side of the pipe, which reads
    ; it as `it`: a call of that function, given the value.
    (let answer (call call-generated id left))
    (if (!= (. answer type) (call (. facts node-type) (. unit reading) id))
      (call refuse .refused-conversion id)
    )
    (return answer)
  )
  (fn-do + emit-pipe Typed
    (param id SyntaxId)
    (param op Operator)
    (param left SyntaxId)
    (param right SyntaxId)
    ; A value piped forward into the function written on the right, as the last argument of the
    ; call the type pass recorded at the pipe; a stream piped through the function written on
    ; the right, which maps, filters or taps its items, or through a pattern, as a comprehension
    ; is called, given what is piped as the type pass cast it, but for a feed that function
    ; evaluates; a value given whole to the function
    ; generated for the right side; or a value written whole, or each of its items, to what is
    ; on the right. Any other pipe has no shape yet. A list of feeds piped
    ; forward has what converts it kept at the feed after the first, beside what converts
    ; the yields of feeds, and a list of one feed at the pipe, apart from what converts the
    ; pipe's value.
    (if (call pipes-stream op)
      (return (call emit-stream-pipe id left))
    )
    (if (== op .grammar-pipe-op)
      (return (call emit-comprehension-call id (if-expr (== (call (. tree piped-feed) id) 0) left 0) true))
    )
    (if (== op .pipe-closure-op)
      (return (call emit-piped id left))
    )
    (if (== op .pipe-write-all-op)
      (return (call emit-write-all id left right))
    )
    (if (== op .pipe-write-each-op)
      (return (call emit-write-each id left right))
    )
    (if (!= op .pipe-forward-op)
      (call refuse .refused-expression id)
      (return (call Typed (call make-operand .operand-void 0) no-type))
    )
    (return-if (call emit-listed-feeds id (call (. tree listed-feeds) id)) (if (== (call (. facts plan-of) (. unit reading) id) .plan-built-feeds)))
    (match? ([] (. tree nodes) left)
      (case (call .node-feed-expression row)
        (= piped-site (if-expr (!= (. row next) 0) (. row next) id))
      )
      (case (call .node-pipeline-expression row)
        (if (call pipes-stream (. row op))
          (= piped-site left)
        )
      )
      (case (call .node-binary-expression row)
        (if (call pipes-stream (. row op))
          (= piped-site left)
        )
      )
    )
    (let answer (call Typed (call make-operand .operand-void 0) no-type))
    (match ([] (. tree nodes) right)
      (case (call .node-call-expression call)
        (= answer (call emit-call-at id (. call callable) (. call args) left))
      )
      (default
        (= answer (call emit-call-at id right (call (of RowRange SyntaxId)) left))
      )
    )
    (= piped-site 0)
    (return answer)
  )
  (fn-do _ nested-environment Operand
    (param id SyntaxId)
    ; The environment a nested function of the instance whose facts are read is given where it is
    ; written: the one in force, or where a function written in that instance evaluates the value
    ; of a lazy local it declares, the one that holds the local, which is in force where the value
    ; is written (`shared-slot`). One made there by an instance with no environment is given none.
    (if (== (. unit reading) (. unit instance))
      (return (call written-environment id))
    )
    (let shared (call shared-slot))
    (if (== shared no-slot)
      (return (call integer .machine-managed-pointer 0))
    )
    (call find-captured shared id)
    (return (call captured-base id))
  )
)
