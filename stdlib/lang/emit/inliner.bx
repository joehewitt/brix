  (fn-do _ local-source Operand
    (param level U32)
    (param local LocalId)
    (param stream U32)
    (let found ([] levels level))
    (let ir (. found ir))
    (let absorbed (list Bool))
    (for (in _ (..< 0 (. ir instructions length)))
      (+= absorbed false)
    )
    (if (!= stream (. U32 max))
      (call absorb-protocol found ([] (. ir streams) stream) absorbed)
    )
    (let source Operand 0)
    (let writes U32)
    (let reads U32)
    (for (in id (..< 0 (. ir instructions length)))
      (let row ([] (. ir instructions) id))
      (if (and (== (. row op) .op-store-local) (== (. row aux) local))
        (+= writes 1)
        (= source ([] (. ir operands) (. row operands start)))
        (else-if (and (== (. row op) .op-load-local) (== (. row aux) local))
          (+= reads 1)
        )
        (else-if (and (== (. row op) .op-local-address) (== (. row aux) local) (not ([] absorbed id)))
          (if (> ([] (. found uses) id) 1)
            (return 0)
          )
          (if (== ([] (. found uses) id) 1)
            (+= reads 1)
          )
        )
        (else-if (and (or (== (. row op) .op-copy) (== (. row op) .op-zero)) (!= (. row operands count) 0))
          (let target ([] (. ir operands) (. row operands start)))
          (if (== (call operand-kind target) .operand-value)
            (let held ([] (. ir instructions) (call operand-payload target)))
            (if (and (== (. held op) .op-local-address) (== (. held aux) local))
              (+= writes 1)
              (-= reads 1)
              (= source (if-expr (== (. row op) .op-zero) 0 ([] (. ir operands) (+ (. row operands start) 1))))
            )
          )
        )
      )
    )
    (return (if-expr (and (== writes 1) (<= reads 1)) source 0))
  )
  (fn-do _ absorb-protocol _
    (param found Level)
    (param traced IRStream)
    (param absorbed (list Bool))
