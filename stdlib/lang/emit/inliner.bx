(import ./emitter)
(import ./layouts)
(import ./program-tables)
(import ./runtime)
(import /core/arena)
(import /core/table)
(import /lang/ast/ast)
(import /lang/ast/ast-nodes)
(import /lang/ast/decl)
(import /lang/ast/module)
(import /lang/ast/program)
(import /lang/backend/mir)
(import /lang/check/binding)
(import /lang/check/facts)
(import /lang/check/instances)
(import /lang/check/type-store)
(import /lang/check/types)
(import /lang/ir/ir)
(import /lang/report/excerpt)
(blank)
(prop _ inline-depth U32 (= 4))
(prop _ inline-rounds U32 (= 4))
(prop _ small-depth U32 (= 2))
(prop _ small-size U32 (= 24))
(prop _ small-lines U32 (= 6))
(prop _ reader-fields U32 (= 9))
(prop _ reader-size U32 (= 32))
(prop _ no-local LocalId (= (. U32 max)))
(prop _ mark-shift U32 (= 28))
(prop _ mark-absorb U32 (= 1))
(prop _ mark-begin U32 (= 2))
(prop _ mark-read U32 (= 3))
(prop _ mark-end U32 (= 4))
(prop _ mark-expand U32 (= 5))
(prop _ mark-keep U32 (= 6))

(type _ SpliceLists
  ; The lists a splice fills as it copies a function's blocks. The inliner keeps one set for each
  ; splice open at once, which open and close in turn, and empties a set as a splice takes it, so
  ; that a splice allocates none of them and each keeps the room it grew to. A splice may point one
  ; of its own at another list, as `only`, `forwards` and `warm` are; the set keeps the one it had.
  (blank)
  (prop + heads (list IRBlockId))
  (prop + tails (list IRBlockId))
  (prop + values (list Operand))
  (prop + arguments (list Operand))
  (prop + phi-values (list U32))
  (prop + phi-blocks (list U32))
  (prop + returned (list Operand))
  (prop + arrived (list IRBlockId))
  (prop + only (list Bool))
  (prop + forwards (list Operand))
  (prop + warm (list Byte))
  (fn-do + empty _
    (call (. heads clear))
    (call (. tails clear))
    (call (. values clear))
    (call (. arguments clear))
    (call (. phi-values clear))
    (call (. phi-blocks clear))
    (call (. returned clear))
    (call (. arrived clear))
    (call (. only clear))
    (call (. forwards clear))
    (call (. warm clear))
  )
)

(type _ Splice
  (prop + source IRFunction)
  (prop + heads (list IRBlockId))
  (prop + tails (list IRBlockId))
  (prop + values (list Operand))
  (prop + arguments (list Operand))
  (prop + phi-values (list U32))
  (prop + phi-blocks (list U32))
  (prop + returned (list Operand))
  (prop + arrived (list IRBlockId))
  (prop + numbers U32)
  (prop + constants U32)
  (prop + locals U32)
  (prop + module ModuleId (= (. U32 max)))
  (prop + landing IRBlockId (= no-block))
  (prop + continuation IRBlockId (= no-block))
  (prop + result Operand (= 0))
  (prop + depth U32)
  (prop + inlined Bool)
  (prop + small Bool)
  (prop + site-line U32)
  (prop + site-column U32)
  (prop + site-module ModuleId (= (. U32 max)))
  (prop + site-syntax SyntaxId (= 0))
  (prop + level U32 (= (. U32 max)))
  (prop + fused U32 (= (. U32 max)))
  (prop + block IRBlockId (= no-block))
  (prop + closing Bool)
  (prop + exit IRBlockId (= no-block))
  (prop + failed IRBlockId (= no-block))
  (prop + only (list Bool))
  (prop + forwards (list Operand))
  (prop + warm (list Byte))
  (fn-do + This _
    (param source IRFunction)
    (param lists SpliceLists)
    (lazy heads (. lists heads))
    (lazy tails (. lists tails))
    (lazy values (. lists values))
    (lazy arguments (. lists arguments))
    (lazy phi-values (. lists phi-values))
    (lazy phi-blocks (. lists phi-blocks))
    (lazy returned (. lists returned))
    (lazy arrived (. lists arrived))
    (lazy only (. lists only))
    (lazy forwards (. lists forwards))
    (lazy warm (. lists warm))
    (for (in _ (..< 0 (. source instructions length)))
      (+= values 0)
    )
  )
)

(type _ Level
  (prop + ir IRFunction)
  (prop + fused U32)
  (prop + uses (list U32))
  (prop + marks (list U32))
  (prop + dead (list Bool))
  (prop + skips (list IRBlockId))
  (fn-do + This _
    (param ir IRFunction)
    (param fused U32)
    (for (in _ (..< 0 (. ir instructions length)))
      (+= uses 0)
      (+= marks 0)
      (+= dead false)
    )
    (for (in _ (..< 0 (. ir blocks length)))
      (+= skips no-block)
    )
    (for (in id (..< 0 (. ir instructions length)))
      (let row ([] (. ir instructions) id))
      (for (in position (..< (. row operands start) (. row operands end)))
        (let operand ([] (. ir operands) position))
        (if (== (call operand-kind operand) .operand-value)
          (+= ([] uses (call operand-payload operand)) 1)
        )
      )
    )
  )
)

(type _ Fused
  (prop + ir IRFunction)
  (prop + maker FunctionId)
  (prop + owner U32)
  (prop + row ValueId)
  (prop + consumer U32)
  (prop + stream U32)
  (prop + level U32)
  (prop + arguments (list Operand))
  (prop + field-arguments (list U32))
  (prop + field-offsets (list U32))
  (prop + field-layouts (list LayoutId))
  (prop + field-values (list Operand))
  (prop + yields (list ValueId))
  (prop + closing (list Bool))
  (prop + body (list Bool))
  (prop + closes Bool)
  (prop + result Operand (= 0))
  (prop + held LocalId (= no-local))
  (prop + state LocalId (= no-local))
  (prop + after-read IRBlockId (= no-block))
  (prop + exhausted IRBlockId (= no-block))
  (prop + read-landing IRBlockId (= no-block))
  (prop + resumes (list IRBlockId))
  (prop + closings (list IRBlockId))
  (prop + depth U32)
  (prop + numbers U32)
  (prop + constants U32)
  (prop + locals U32)
  (prop + module ModuleId (= (. U32 max)))
  (prop + crossing (list Bool))
  (prop + spills (list LocalId))
  (fn-do + This _
    (param ir IRFunction)
    (param maker FunctionId)
    (param owner U32)
    (param row ValueId)
    (param consumer U32)
    (param stream U32)
  )
)

(type + InlineVerdicts (is Tuple)
  ; What the workers of a round settle about inlining each function, kept once for all of them:
  ; 0 where it is not settled yet, 1 where it is inlined and 2 where it is not. A verdict hangs on
  ; the function alone, so workers that settle one at once settle it alike.
  (blank)
  (prop + requests (of CPointer Byte))
  (prop + readers (of CPointer Byte))
  (prop + smalls (of CPointer Byte))
)

(type + IRInliner
  ; Inlines a function's callees into its IR. A run logs what it asks of the program beyond the
  ; IR: each function a symbol named (`consulted`), each witness slot it looked up with what it
  ; found, and whether it fused a reader, which a later round compares to reuse the function.
  ; `splice-lists` are the lists of the splices it copies with, the first `open-splices` taken.
  (blank)
  (prop + consulted (list FunctionId))
  (prop + slot-symbols (list StringId))
  (prop + slot-offsets (list U32))
  (prop + slot-targets (list FunctionId))
  (prop + fused Bool)
  (prop _ consult-marks (list U32))
  (prop _ consult-stamp U32)
  (prop _ tables ProgramTables)
  (prop _ program Program)
  (prop _ instances Instances)
  (prop _ facts Facts)
  (prop _ types Types)
  (prop _ bindings Bindings)
  (prop _ output IRFunction)
  (prop _ stock-storage Arena)
  (prop _ stocker-storage Arena)
  (prop _ stocker Emitter)
  (prop _ stock (list IRFunction))
  (prop _ slots (list U32))
  (prop _ fuser-storages (list Arena))
  (prop _ fusers (list Emitter))
  (prop _ symbol-functions (list U32))
  (prop _ active (list FunctionId))
  (prop _ expanded-loads (list ValueId))
  (prop _ verdicts InlineVerdicts)
  (prop _ levels (list Level))
  (prop _ fusions (list Fused))
  (prop _ splice-lists (list SpliceLists))
  (prop _ open-splices U32)
  (prop _ traced-level U32)
  (prop _ traced-row ValueId (= 0))
  (prop _ grew Bool)
  (prop _ first-round Bool)
  (prop _ expanding Bool)
  (prop _ wrapped Bool)
  (prop _ expanded Bool)
  (prop _ spare IRFunction)
  (fn-do + This _
    (param tables ProgramTables)
    (param program Program)
    (param instances Instances)
    (param facts Facts)
    (param types Types)
    (param bindings Bindings)
    (param verdicts InlineVerdicts)
    (param storage Arena)
    (lazy output (call IRFunction storage))
    (lazy spare (call IRFunction storage))
    (lazy stock-storage (call Arena))
    (lazy stocker-storage (call Arena))
    (lazy stocker (call Emitter tables program instances facts types bindings stocker-storage))
  )
  (fn-do + release _
    (call (. stocker release))
    (call (. stocker-storage release))
    (call (. stock-storage release))
    (for (in fuser fusers)
      (call (. fuser release))
    )
    (for (in storage fuser-storages)
      (call (. storage release))
    )
  )
  (fn-do + want-type-constants _
    (for (in type (. stocker type-values))
      (call (. tables want-type-constant) type)
    )
    (for (in fuser fusers)
      (for (in type (. fuser type-values))
        (call (. tables want-type-constant) type)
      )
    )
  )
  (fn-do + run IRFunction
    (param source IRFunction)
    (call (. consulted clear))
    (= open-splices 0)
    (call (. slot-symbols clear))
    (call (. slot-offsets clear))
    (call (. slot-targets clear))
    (= fused false)
    (+= consult-stamp 1)
    (let built source)
    (= expanded false)
    (for (in round (..< 0 inline-rounds))
      (= first-round (== round 0))
      (call (. levels clear))
      (call (. fusions clear))
      (= expanding false)
      (if (!= (. built streams length) 0)
        (+= levels (call Level built (. U32 max)))
        (call plan 0)
      )
      (for (in found levels)
        (call prune found)
      )
      (= grew false)
      (if (or (!= (. fusions length) 0) expanding (call wants built) (call forwards-any built))
        (= built (call rebuild built))
      )
      (if (and (not (call devirtualize built)) (not grew))
        (return built)
      )
    )
    (return built)
  )
  (fn-do _ rebuild IRFunction
    (param source IRFunction)
    (let next spare)
    (= spare output)
    (= output next)
    (call (. output reset) (. source function))
    (= (. output arguments) (. source arguments))
    (= (. output returns) (. source returns))
    (= (. output signals) (. source signals))
    (for (in local (. source locals))
      (call (. output locals append) local)
    )
    (for (in number (. source numbers))
      (call (. output numbers append) number)
    )
    (for (in constant (. source constants))
      (call (. output adopt-constant) constant)
    )
    (for (in dependency (. source dependencies))
      (call (. output depend) (. dependency kind) (. dependency symbol) (. dependency flags))
    )
    (let mark open-splices)
    (let top (call open-splice source))
    (if (!= (. levels length) 0)
      (= (. top level) 0)
    )
    (for (in _ (..< 0 (. source blocks length)))
      (let block (call (. output reserve-block)))
      (+= (. top heads) block)
      (+= (. top tails) block)
    )
    (call (. active clear))
    (+= active (. source function))
    (call (. expanded-loads clear))
    (call copy-blocks top)
    (= open-splices mark)
    (return output)
  )
  (fn-do _ open-splice Splice
    (param source IRFunction)
    ; A splice of `source`, with the next set of `splice-lists`, emptied. Whoever takes one puts
    ; `open-splices` back once it is done with it.
    (if (== open-splices (. splice-lists length))
      (+= splice-lists (call SpliceLists))
    )
    (let lists ([] splice-lists open-splices))
    (+= open-splices 1)
    (call (. lists empty))
    (return (call Splice source lists))
  )
  (fn-do _ devirtualize Bool
    (param ir IRFunction)
    (let resolved false)
    (for (in id (..< 0 (. ir instructions length)))
      (let row ([] (. ir instructions) id))
      (if (or not-call (!= (/and/ (. row aux) callee-kind-mask) (. CalleeKind callee-value)))
        (continue)
      )
      (lazy not-call (and (!= (. row op) .op-call) (!= (. row op) .op-call-void)))
      (let target (call slot-target ir ([] (. ir operands) (. row operands start))))
      (if (== target no-function)
        (continue)
      )
      (= ([] (. ir operands data) (. row operands start))
        (call make-operand
          (block
            (arg .operand-symbol)
            (arg (. ([] (. tables functions) target) symbol))
          )
        )
      )
      (= (. ([] (. ir instructions) id) aux) (- (. row aux) (. CalleeKind callee-value)))
      (call (. ir depend)
        (block
          (arg .callee-function)
          (arg target)
          (arg (if-expr (. ([] (. tables functions) target) may-panic) may-panic-dependency 0))
        )
      )
      (= resolved true)
    )
    (return resolved)
  )
  (fn-do _ slot-target FunctionId
    (param ir IRFunction)
    (param operand Operand)
    (if (!= (call operand-kind operand) .operand-value)
      (return no-function)
    )
    (let method ([] (. ir instructions) (call operand-payload operand)))
    (if (or (!= (. method op) .op-load) (!= (. method layout) pointer-layout))
      (return no-function)
    )
    (let table ([] (. ir operands) (. method operands start)))
    (let symbol (call operand-payload table))
    (if (== (call operand-kind table) .operand-value)
      (let load ([] (. ir instructions) (call operand-payload table)))
      (if (== (. load op) .op-frame)
        (return (call closure-target ir table (/and/ (. method aux) 0x7fffffff)))
      )
      (let field (. (call (. tables layouts field) (. tables layouts interface-layout) 1) offset))
      (if (or (!= (. load op) .op-load) (!= (/and/ (. load aux) 0x7fffffff) field))
        (return no-function)
      )
      (= symbol (call field-symbol ir ([] (. ir operands) (. load operands start)) field 0))
      (else-if (!= (call operand-kind table) .operand-symbol)
        (return no-function)
      )
    )
    (if (== symbol (. U32 max))
      (return no-function)
    )
    (let offset (/and/ (. method aux) 0x7fffffff))
    (let target (call (. tables witness-slot-function) symbol offset))
    (+= slot-symbols symbol)
    (+= slot-offsets offset)
    (+= slot-targets target)
    (if (!= target no-function)
      (call consult target)
    )
    (return target)
  )
  (fn-expr _ closure-target FunctionId
    (param ir IRFunction)
    (param frame Operand)
    (param offset U32)
    (case? (or (!= (. ([] (. ir instructions) (call operand-payload frame)) layout) (. tables layouts function-layout)) (!= offset 0))
      no-function
    )
    (case? (== symbol (. U32 max))
      no-function
    )
    (default
      (call function-of symbol)
    )
    (where
      (lazy symbol (call field-symbol ir frame offset 0))
    )
  )
  (fn-do _ field-symbol U32
    (param ir IRFunction)
    (param operand Operand)
    (param offset U32)
    (param depth U32)
    (if (or (> depth 8) (!= (call operand-kind operand) .operand-value))
      (return (. U32 max))
    )
    (let place ([] (. ir instructions) (call operand-payload operand)))
    (if (and (!= (. place op) .op-frame) (!= (. place op) .op-local-address))
      (return (. U32 max))
    )
    (let found (. U32 max))
    (let writes U32)
    (for (in id (..< 0 (. ir instructions length)))
      (let row ([] (. ir instructions) id))
      (if (== (. row operands count) 0)
        (continue)
      )
      (let target ([] (. ir operands) (. row operands start)))
      (if (not (call same-place ir target operand place))
        (continue)
      )
      (if (== (. row op) .op-copy)
        (+= writes 1)
        (= found (call field-symbol ir ([] (. ir operands) (+ (. row operands start) 1)) offset (+ depth 1)))
        (else-if (== (. row op) .op-store)
          (let stored ([] (. ir operands) (+ (. row operands start) 1)))
          (if (== (/and/ (. row aux) 0x7fffffff) offset)
            (+= writes 1)
            (= found (if-expr is-symbol (call operand-payload stored) (. U32 max)))
            (lazy is-symbol (== (call operand-kind stored) .operand-symbol))
          )
        )
        (else-if (or (== (. row op) .op-zero) (== (. row op) .op-address))
          (return (. U32 max))
        )
      )
    )
    (return (if-expr (== writes 1) found (. U32 max)))
  )
  (fn-expr _ same-place Bool
    (param ir IRFunction)
    (param target Operand)
    (param operand Operand)
    (param place IRInstruction)
    (or (== target operand) (and (== (. place op) .op-local-address) (== (call operand-kind target) .operand-value) (== (. ([] (. ir instructions) (call operand-payload target)) op) .op-local-address) (== (. ([] (. ir instructions) (call operand-payload target)) aux) (. place aux))))
  )
  (fn-do _ wants Bool
    (param source IRFunction)
    (let block no-block)
    (let warm true)
    (let small false)
    (for (in id (..< 0 (. source instructions length)))
      (let row ([] (. source instructions) id))
      (if (!= (. row block) block)
        (if (and small warm)
          (return true)
        )
        (= block (. row block))
        (= warm true)
        (= small false)
      )
      (if (and first-round (call sets-panic source row))
        (= warm false)
      )
      (if (and is-call (== (/and/ (. row aux) callee-kind-mask) (. CalleeKind callee-function)))
        (let target ([] (. source operands) (. row operands start)))
        (if (== (call operand-kind target) .operand-symbol)
          (let position (call function-of (call operand-payload target)))
          (if (== position no-function)
            (continue)
          )
          (if (or (call requested position) (call reads-tuple position))
            (return true)
          )
          (if (and first-round (not small) (call is-small position))
            (= small true)
          )
        )
      )
      (lazy is-call (or (== (. row op) .op-call) (== (. row op) .op-call-void)))
    )
    (return (and small warm))
  )
  (fn-do _ forwards-any Bool
    (param source IRFunction)
    (if (!= (. source streams length) 0)
      (return false)
    )
    (for (in found (call forwarded source))
      (if (!= found 0)
        (return true)
      )
    )
    (return false)
  )
  (fn-do _ forwarded (list Operand)
    (param ir IRFunction)
    ; The argument each frame stands for that the function fills once, whole, from a struct
    ; argument it never writes, and afterwards only reads: the frame is read as the argument, which
    ; the caller gave as a copy of its own. A frame or argument whose address reaches anything but a
    ; read is written. A function that yields keeps its frames, and one given no struct has none.
    (let found (list Operand))
    (let takes-struct false)
    (for (in position (..< 0 (. ir arguments length)))
      (if (call (. tables layouts is-struct) ([] (. ir arguments) position))
        (= takes-struct true)
      )
    )
    (if (not takes-struct)
      (return found)
    )
    (let count (. ir instructions length))
    (= found ([] Operand count))
    (let states ([] Byte count))
    (let written ([] Bool (. ir arguments length)))
    (for (in id (..< 0 count))
      (let row ([] (. ir instructions) id))
      (if (== (. row op) .op-yield)
        (for (in position (..< 0 count))
          (= ([] found position) 0)
        )
        (return found)
      )
      (if (== (. row op) .op-address)
        (continue)
      )
      (for (in position (..< (. row operands start) (. row operands end)))
        (let operand ([] (. ir operands) position))
        (let root (call root-of ir operand))
        (let index (- position (. row operands start)))
        (let is-argument (== (call operand-kind root) .operand-argument))
        (let is-frame
          (scope (and is-value (== (. ([] (. ir instructions) (call operand-payload root)) op) .op-frame))
            (lazy is-value (== (call operand-kind root) .operand-value))
          )
        )
        (if (and (not is-argument) (not is-frame))
          (continue)
        )
        (if (call reads ir row index operand)
          (continue)
        )
        (if is-argument
          (= ([] written (call operand-payload root)) true)
          (continue)
        )
        (let frame (call operand-payload root))
        (if (and (== operand root) (== (. row op) .op-copy) (== index 0) (== ([] states frame) 0) fills-frame)
          (= ([] states frame) 1)
          (= ([] found frame) ([] (. ir operands) (+ (. row operands start) 1)))
          (else
            (= ([] states frame) 2)
          )
        )
        (lazy fills-frame (call fills ir row frame))
      )
    )
    (for (in id (..< 0 count))
      (if (or (!= ([] states id) 1) ([] written (call operand-payload ([] found id))))
        (= ([] found id) 0)
      )
    )
    (return found)
  )
  (fn-do _ root-of Operand
    (param ir IRFunction)
    (param operand Operand)
    (let current operand)
    (while (and (== (call operand-kind current) .operand-value) (== (. ([] (. ir instructions) (call operand-payload current)) op) .op-address))
      (= current ([] (. ir operands) (. ([] (. ir instructions) (call operand-payload current)) operands start)))
    )
    (return current)
  )
  (fn-expr _ reads Bool
    (param ir IRFunction)
    (param row IRInstruction)
    (param index U32)
    (param operand Operand)
    (case? (== (. row op) .op-copy)
      (== index 1)
    )
    (case? (== (. row op) .op-load)
      (== index 0)
    )
    (case? (or (== (. row op) .op-return) (== (. row op) .op-call) (== (. row op) .op-call-void))
      (and (or (!= index 0) (== (. row op) .op-return)) (call (. tables layouts is-struct) (call (. ir operand-layout) operand)))
    )
    (default
      false
    )
  )
  (fn-expr _ fills Bool
    (param ir IRFunction)
    (param row IRInstruction)
    (param frame ValueId)
    (case? (or (!= (/and/ (. row aux) managed-store-flag) 0) (!= (call operand-kind source) .operand-argument))
      false
    )
    (default
      (and (== layout frame-layout) (== layout (as ([] (. ir arguments) (call operand-payload source)) LayoutId)))
    )
    (where
      (lazy source ([] (. ir operands) (+ (. row operands start) 1)))
      (lazy layout (as (/and/ (. row aux) 0x7fffffff) LayoutId))
      (lazy frame-layout (. ([] (. ir instructions) frame) layout))
    )
  )
  (fn-expr _ is-forwarded Bool
    (param splice Splice)
    (param row IRInstruction)
    (param id ValueId)
    ; Whether a row is a frame read as an argument, or the copy that filled it, which are not
    ; made again.
    (case? (== (. row op) .op-frame)
      (!= ([] (. splice forwards) id) 0)
    )
    (case? (!= (. row op) .op-copy)
      false
    )
    (default
      (and (== (call operand-kind target) .operand-value) (!= ([] (. splice forwards) (call operand-payload target)) 0))
    )
    (where
      (lazy target ([] (. splice source operands) (. row operands start)))
    )
  )
  (fn-do _ inline-callee FunctionId
    (param splice Splice)
    (param row IRInstruction)
    (if (and (!= (. row op) .op-call) (!= (. row op) .op-call-void))
      (return no-function)
    )
    (let kind (/and/ (. row aux) callee-kind-mask))
    (if (and (!= kind (. CalleeKind callee-function)) (!= kind (. CalleeKind callee-value)))
      (return no-function)
    )
    (let target (call remap splice ([] (. splice source operands) (. row operands start))))
    (if (!= (call operand-kind target) .operand-symbol)
      (return no-function)
    )
