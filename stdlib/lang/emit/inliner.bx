    (let index (/and/ marked (- (/lshift/ 1u32 mark-shift) 1)))
    (let kind (/zrshift/ marked mark-shift))
    (if (== kind mark-expand)
      (let callee (call function-of (call operand-payload ([] (. splice source operands) (. row operands start)))))
      (if (not (call expand splice id row callee))
        (call copy-row splice id row)
      )
      (else-if (== kind mark-keep)
        (call copy-row splice id row)
      )
      (else-if (== kind mark-absorb)
        (call absorb splice id row index)
      )
      (else-if (== kind mark-begin)
        (call fuse-begin splice id row index)
      )
      (else-if (== kind mark-read)
        (call fuse-read splice id row index)
      )
      (else
        (call fuse-end splice id row index)
      )
    )
    (return true)
  )
  (fn-do _ forward-field Bool
    (param splice Splice)
    (param id ValueId)
    (param row IRInstruction)
    (let base ([] (. splice source operands) (. row operands start)))
    (if (!= (call operand-kind base) .operand-argument)
      (return false)
    )
    (let fused ([] fusions (. splice fused)))
    (let argument (call operand-payload base))
    (for (in position (..< 0 (. fused field-arguments length)))
      (if (and (== ([] (. fused field-arguments) position) argument) same-offset same-layout)
        (= ([] (. splice values) id) ([] (. fused field-values) position))
        (return true)
      )
      (lazy same-offset (== ([] (. fused field-offsets) position) (. row aux)))
      (lazy same-layout (== ([] (. fused field-layouts) position) (. row layout)))
    )
    (return false)
  )
  (fn-do _ absorb _
    (param splice Splice)
    (param id ValueId)
    (param row IRInstruction)
    (param index U32)
    (let fused ([] fusions index))
    (let checked (!= (/and/ (. row aux) checked-call-flag) 0))
    (let last (- (. row operands end) (if-expr checked 1u32 0u32)))
    (for (in position (..< (+ (. row operands start) 1) last))
      (let argument (- position (. row operands start) 1))
      (let operand (call remap splice ([] (. splice source operands) position)))
      (let layout ([] (. fused ir arguments) argument))
      (if (and (call (. tables layouts is-struct) layout) (!= (. ([] (. tables layouts rows) layout) size) 0))
        (let held (call frame layout))
        (call copy held operand layout)
        (+= (. fused arguments) held)
        (call note-fields splice argument ([] (. splice source operands) position) fused)
        (else
          (+= (. fused arguments) operand)
        )
      )
    )
    (if (== (. row op) .op-call)
      (= ([] (. splice values) id) (call blank (. row layout)))
    )
  )
  (fn-do _ note-fields _
    (param splice Splice)
    (param argument U32)
    (param operand Operand)
    (param fused Fused)
    (let ir (. splice source))
    (let current operand)
    (while (and (== (call operand-kind current) .operand-value) (== (. ([] (. ir instructions) (call operand-payload current)) op) .op-frame))
      (let copied Operand 0)
      (let copies U32)
      (let stores U32)
      (for (in id (..< 0 (. ir instructions length)))
        (let row ([] (. ir instructions) id))
        (if (or (== (. row operands count) 0) (!= ([] (. ir operands) (. row operands start)) current))
          (continue)
        )
        (if (== (. row op) .op-copy)
          (+= copies 1)
          (= copied ([] (. ir operands) (+ (. row operands start) 1)))
          (else-if (== (. row op) .op-store)
            (+= stores 1)
          )
          (else-if (or (== (. row op) .op-zero) (== (. row op) .op-address))
            (return)
          )
        )
      )
      (if (and (== copies 1) (== stores 0))
        (= current copied)
        (continue)
      )
      (if (!= copies 0)
        (return)
      )
      (let first (. fused field-arguments length))
      (for (in id (..< 0 (. ir instructions length)))
        (let row ([] (. ir instructions) id))
        (if (or (!= (. row op) .op-store) (!= ([] (. ir operands) (. row operands start)) current))
          (continue)
        )
        (let stored ([] (. ir operands) (+ (. row operands start) 1)))
        (let offset (/and/ (. row aux) 0x7fffffff))
        (let repeated false)
        (for (in position (..< first (. fused field-arguments length)))
          (if (== ([] (. fused field-offsets) position) offset)
            (= repeated true)
          )
        )
        (if (or repeated (and (== (call operand-kind stored) .operand-value) uncopied))
          (continue)
        )
        (lazy uncopied (== ([] (. splice values) (call operand-payload stored)) 0))
        (+= (. fused field-arguments) argument)
        (+= (. fused field-offsets) offset)
        (+= (. fused field-layouts) (call (. ir operand-layout) stored))
        (+= (. fused field-values) (call remap splice stored))
      )
      (return)
    )
  )
  (fn-do _ fuse-begin _
    (param splice Splice)
    (param id ValueId)
    (param row IRInstruction)
    (param index U32)
    (let fused ([] fusions index))
    (let consumer (. splice source))
    (let found ([] (. consumer streams) (. fused stream)))
    (let read ([] (. consumer instructions) (. found read)))
    (= grew true)
    (if (== (. row op) .op-call)
      (= ([] (. splice values) id) (call blank (. row layout)))
    )
    (if (call (. tables layouts is-struct) (. read layout))
      (= (. fused result) (call frame (. read layout)))
      (else
        (= (. fused held) (call (. output add-local) (. read layout)))
      )
    )
    (if (or (. fused closes) (> (. fused yields length) 1))
      (= (. fused state) (call (. output add-local) u32-layout))
      (call store-local (. fused state) (call number .machine-u32 0))
    )
    (= (. fused after-read) (call (. output reserve-block)))
    (= (. fused exhausted) ([] (. splice heads) (. found done)))
    (if (!= (/and/ (. read aux) checked-call-flag) 0)
      (= (. fused read-landing) ([] (. splice heads) (call operand-payload ([] (. consumer operands) (- (. read operands end) 1)))))
    )
    (let produced (. fused ir))
    (let mark open-splices)
    (let made (call open-splice produced))
    (= (. made depth) (. splice depth))
    (= (. made level) (. fused level))
    (= (. made fused) index)
    (= (. made inlined) true)
    (for (in argument (. fused arguments))
      (+= (. made arguments) argument)
    )
    (= (. made numbers) (as (. output numbers length) U32))
    (for (in number (. produced numbers))
      (call (. output numbers append) number)
    )
    (= (. made constants) (as (. output constants length) U32))
    (for (in constant (. produced constants))
      (call (. output adopt-constant) constant)
    )
    (= (. made locals) (as (. output locals length) U32))
    (for (in local (. produced locals))
      (call (. output locals append) local)
    )
    (for (in dependency (. produced dependencies))
      (call (. output depend) (. dependency kind) (. dependency symbol) (. dependency flags))
    )
    (for (in _ (..< 0 (. produced blocks length)))
      (let reserved (call (. output reserve-block)))
      (+= (. made heads) reserved)
      (+= (. made tails) reserved)
    )
    (let maker-home (call home (. fused maker)))
    (= (. made module) (if-expr (!= maker-home (call home (. output function))) maker-home (. U32 max)))
    (for (in id (..< 0 (. produced instructions length)))
      (+= (. fused spills) (if-expr ([] (. fused crossing) id) (call (. output add-local) (. ([] (. produced instructions) id) layout)) no-local))
    )
    (for (in block (..< 0 (. produced blocks length)))
      (+= (. made only) ([] (. fused body) block))
    )
    (= (. fused depth) (. made depth))
    (= (. fused numbers) (. made numbers))
    (= (. fused constants) (. made constants))
    (= (. fused locals) (. made locals))
    (= (. fused module) (. made module))
    (for (in yielded (. fused yields))
      (let yielding ([] (. produced instructions) yielded))
      (+= (. fused resumes) ([] (. made heads) (call operand-payload ([] (. produced operands) (+ (. yielding operands start) 1)))))
      (+= (. fused closings) (. yielding aux))
    )
    (call jump ([] (. made heads) ([] (. produced order) 0)))
    (+= active (. fused maker))
    (call copy-blocks made)
    (call (. active pop))
    (= open-splices mark)
    (call (. output start-block) (call (. output reserve-block)))
  )
  (fn-do _ fuse-read _
    (param splice Splice)
    (param id ValueId)
    (param row IRInstruction)
    (param index U32)
    (let fused ([] fusions index))
    (if (== (. fused resumes length) 0)
      (call jump (. fused after-read))
      (else-if (== (. fused resumes length) 1)
        (call jump ([] (. fused resumes) 0))
      )
      (else
        (let step (call load-local (. fused state)))
        (for (in position (..< 0 (- (. fused resumes length) 1)))
          (let next (call (. output reserve-block)))
          (call branch
            (block
              (arg (call equal step (call number .machine-u32 (as (+ position 1) U64))))
              (arg ([] (. fused resumes) position))
              (arg next)
            )
          )
          (call (. output start-block) next)
        )
        (call jump ([] (. fused resumes) (- (. fused resumes length) 1)))
      )
    )
    (call (. output start-block) (. fused after-read))
    (if (== (. row op) .op-call)
      (= ([] (. splice values) id) (if-expr (== (. fused held) no-local) (. fused result) (call load-local (. fused held))))
    )
  )
  (fn-do _ fuse-end _
    (param splice Splice)
    (param id ValueId)
    (param row IRInstruction)
    (param index U32)
    (let fused ([] fusions index))
    (if (== (. row op) .op-call)
      (= ([] (. splice values) id) (call blank (. row layout)))
    )
    (if (not (. fused closes))
      (return)
    )
    (let exit (call (. output reserve-block)))
    (let failed
      (scope (if-expr (!= (/and/ (. row aux) checked-call-flag) 0) landing-pad no-block)
        (lazy landing-pad ([] (. splice heads) (call operand-payload ([] (. splice source operands) (- (. row operands end) 1)))))
      )
    )
    (let step (call load-local (. fused state)))
    (call store-local (. fused state) (call number .machine-u32 0))
    (let mark open-splices)
    (let closers (list Splice))
    (for (in position (..< 0 (. fused closings length)))
      (let head ([] (. fused closings) position))
      (if (== head no-block)
        (continue)
      )
      (let closer (call closing-copy fused index head exit failed))
      (let next (call (. output reserve-block)))
      (call branch (call equal step (call number .machine-u32 (as (+ position 1) U64))) ([] (. closer heads) head) next)
      (call (. output start-block) next)
      (+= closers closer)
    )
    (call jump exit)
    (+= active (. fused maker))
    (for (in closer closers)
      (call copy-blocks closer)
    )
    (call (. active pop))
    (= open-splices mark)
    (call (. output start-block) exit)
  )
  (fn-do _ closing-copy Splice
    (param fused Fused)
    (param index U32)
    (param head IRBlockId)
    (param exit IRBlockId)
    (param failed IRBlockId)
    (let produced (. fused ir))
    (let closer (call open-splice produced))
    (= (. closer depth) (. fused depth))
    (= (. closer level) (. fused level))
    (= (. closer fused) index)
    (= (. closer inlined) true)
    (= (. closer closing) true)
    (= (. closer exit) exit)
    (= (. closer failed) failed)
    (= (. closer numbers) (. fused numbers))
    (= (. closer constants) (. fused constants))
    (= (. closer locals) (. fused locals))
    (= (. closer module) (. fused module))
    (for (in argument (. fused arguments))
      (+= (. closer arguments) argument)
    )
    (= (. closer only) (call region produced head))
    (for (in _ (..< 0 (. produced blocks length)))
      (let reserved (call (. output reserve-block)))
      (+= (. closer heads) reserved)
      (+= (. closer tails) reserved)
    )
    (return closer)
  )
  (fn-do _ fused-yield _
    (param splice Splice)
    (param id ValueId)
    (param row IRInstruction)
    (let fused ([] fusions (. splice fused)))
    (let value (call remap splice ([] (. splice source operands) (. row operands start))))
    (if (== (. fused held) no-local)
      (call copy (. fused result) value (call (. output operand-layout) (. fused result)))
      (else
        (call store-local (. fused held) value)
      )
    )
    (if (!= (. fused state) no-local)
      (for (in position (..< 0 (. fused yields length)))
        (if (== ([] (. fused yields) position) id)
          (call store-local (. fused state) (call number .machine-u32 (as (+ position 1) U64)))
        )
      )
    )
    (call jump (. fused after-read))
  )
  (fn-do _ fused-return _
    (param splice Splice)
    (param row IRInstruction)
    (let fused ([] fusions (. splice fused)))
    (let panicked (== (. row aux) (. ReturnKind return-panic)))
    (if (== (. row aux) (. ReturnKind return-error))
      (call copy
        (block
          (arg (. fused result))
          (arg (call remap splice ([] (. splice source operands) (. row operands start))))
          (arg (call (. output operand-layout) (. fused result)))
        )
      )
      (if (!= (. fused state) no-local)
        (call store-local (. fused state) (call number .machine-u32 0))
      )
      (call jump (. fused after-read))
      (return)
    )
    (if (. splice closing)
      (call jump (if-expr panicked (. splice failed) (. splice exit)))
      (return)
    )
    (if (!= (. fused state) no-local)
      (call store-local (. fused state) (call number .machine-u32 0))
    )
    (call jump (if-expr panicked (. fused read-landing) (. fused exhausted)))
  )
  (fn-do _ copy-row _
    (param splice Splice)
    (param id ValueId)
    (param row IRInstruction)
    (if (and (== (. row op) .op-return) (!= (. splice continuation) no-block))
      (call leave splice row)
      (return)
    )
    (let start U32 (. output operands length))
    (for (in position (..< (. row operands start) (. row operands end)))
      (let operand ([] (. splice source operands) position))
      (if (!= (. row op) .op-phi)
        (call (. output add-operand) (call remap splice operand))
        (continue)
      )
      (if (== (% (- position (. row operands start)) 2) 0)
        (+= (. splice phi-values) (. output operands length))
        (else
          (+= (. splice phi-blocks) (. output operands length))
        )
      )
      (call (. output add-operand) operand)
    )
    (let aux (. row aux))
    (if (or (== (. row op) .op-load-local) (== (. row op) .op-store-local) (== (. row op) .op-local-address))
      (+= aux (. splice locals))
    )
    (if (and (== (. row op) .op-inlined-name) (or (. splice inlined) (call is-expanded ([] (. output operands) start))))
      (= aux 1)
    )
    (if (and is-call (== (/and/ (. row aux) callee-kind-mask) (. CalleeKind callee-value)))
      (let callee ([] (. output operands) start))
      (if (== (call operand-kind callee) .operand-symbol)
        (let position (call function-of (call operand-payload callee)))
        (if (!= position no-function)
          (= aux (- (. row aux) (/and/ (. row aux) callee-kind-mask)))
          (call (. output depend)
            (block
              (arg .callee-function)
              (arg position)
              (arg (if-expr (. ([] (. tables functions) position) may-panic) may-panic-dependency 0))
            )
          )
        )
      )
    )
    (lazy is-call (or (== (. row op) .op-call) (== (. row op) .op-call-void)))
    (let module (if-expr (== (. row module) (. U32 max)) (. splice module) (. row module)))
    (let line (. row line))
    (let column (. row column))
    (if (and (. splice inlined) (!= (. splice site-line) 0) (or (== (. row op) .op-call) (== (. row op) .op-call-void)))
      (= line (. splice site-line))
      (= column (. splice site-column))
      (= module (. splice site-module))
    )
    (let operands (call Span start (- (. output operands length) start)))
    (let made
      (call (. output append)
        (block
          (arg
            (call IRInstruction
              (block
                (arg (. row op))
                (arg (. output current))
                (arg (. row layout))
                (arg (. row type))
                (arg (. row syntax))
                (arg line)
                (arg column)
                (arg operands)
                (arg aux)
                (arg module)
              )
            )
          )
        )
      )
    )
    (= ([] (. splice values) id) (call make-operand .operand-value made))
    (if (and (. splice inlined) (== (. row op) .op-load))
      (+= expanded-loads made)
    )
    (if (and (or (== (. row op) .op-call) (== (. row op) .op-call-void)) carries-notes)
      (call carry-notes splice id made (. row syntax) module)
    )
    (lazy carries-notes (or (. splice inlined) (!= (. splice source notes length) 0)))
  )
  (fn-do _ carry-notes _
    (param splice Splice)
    (param id ValueId)
    (param made ValueId)
    (param syntax SyntaxId)
    (param module ModuleId)
    (let copy ([] (. output instructions) made))
    (let kind (/and/ (. copy aux) callee-kind-mask))
    (let target no-function)
    (if (and (== kind (. CalleeKind callee-function)) (== (call operand-kind callee) .operand-symbol))
      (= target (call function-of (call operand-payload ([] (. output operands) (. copy operands start)))))
    )
    (lazy callee ([] (. output operands) (. copy operands start)))
    (let site-module (call placed (if-expr (. splice inlined) (. splice site-module) module) (. output function)))
    (let site-syntax (if-expr (. splice inlined) (. splice site-syntax) syntax))
    (let noted false)
    (for (in note (. splice source notes))
      (if (and (== (. note row) id) (or (== kind (. CalleeKind callee-value)) (== (. note target) target)))
        (= noted true)
        (if (. splice inlined)
          (call (. output note) made (. note target) site-module site-syntax (call chained (. note chain)))
          (else
            (call (. output note) made (. note target) (. note site-module) (. note site-syntax) (. note chain))
          )
        )
      )
    )
    (if (and (. splice inlined) (not noted) (!= target no-function) (call falls-back target))
      (call (. output note) made target site-module site-syntax (call chained (call IdList)))
    )
  )
  (fn-expr _ placed ModuleId
    (param module ModuleId)
    (param function FunctionId)
    (if-expr (!= module (. U32 max)) module (call home function))
  )
  (fn-do _ chained IdList
    (param chain IdList)
    (let made (call IdList))
    (for (in position (..< 1 (. active length)))
      (= made (call (. output extended) made ([] active position)))
    )
    (for (in position (..< 0 (. chain length)))
      (= made (call (. output extended) made ([] chain position)))
    )
    (return made)
  )
  (fn-do + warnings String
    (param ir IRFunction)
    (if (. program is-batch)
      (return "")
    )
    (let targets (list FunctionId))
    (let reasons (list Bool))
    (let modules (list ModuleId))
    (let syntaxes (list SyntaxId))
    (let chains (list IdList))
    (for (in position (..< 0 (. ir order length)))
      (let rows (. ([] (. ir blocks) ([] (. ir order) position)) instructions))
      (for (in id (..< (. rows start) (. rows end)))
        (let row ([] (. ir instructions) id))
        (if (and (!= (. row op) .op-call) (!= (. row op) .op-call-void))
          (continue)
        )
        (let kind (/and/ (. row aux) callee-kind-mask))
        (let target no-function)
        (if (and (== kind (. CalleeKind callee-function)) (== (call operand-kind callee) .operand-symbol))
          (= target (call function-of (call operand-payload ([] (. ir operands) (. row operands start)))))
          (if (and (!= target no-function) (not (call falls-back target)))
            (= target no-function)
          )
        )
        (lazy callee ([] (. ir operands) (. row operands start)))
        (let module (call placed (. row module) (. ir function)))
        (let syntax (. row syntax))
        (let chain (call IdList))
        (for (in note (. ir notes))
          (if (and (== (. note row) id) (or (== kind (. CalleeKind callee-value)) (== (. note target) target)))
            (= target (. note target))
            (= module (. note site-module))
            (= syntax (. note site-syntax))
            (= chain (. note chain))
          )
        )
        (if (or (== target no-function) (!= module (. program entry-module)))
          (continue)
        )
        (let recursive (== kind (. CalleeKind callee-function)))
        (let found (. U32 max))
        (for (in index (..< 0 (. targets length)))
          (if (and (== ([] targets index) target) (== ([] reasons index) recursive) same-site)
            (= found (as index U32))
          )
          (lazy same-site (and (== ([] modules index) module) (== ([] syntaxes index) syntax)))
        )
        (if (== found (. U32 max))
          (+= targets target)
          (+= reasons recursive)
          (+= modules module)
          (+= syntaxes syntax)
          (+= chains chain)
          (else-if (== (. ([] chains found) length) 0)
            (= ([] chains found) chain)
          )
        )
      )
    )
    (let sources (use (call ExcerptSources program)))
    (return (call (. "\n" join) (in (call warning-text ([] targets each) ([] reasons each) ([] modules each) ([] syntaxes each) ([] chains each) sources) (..< 0 (. targets length)))))
  )
  (fn-do _ warning-text String
    (param target FunctionId)
    (param recursive Bool)
    (param module ModuleId)
    (param syntax SyntaxId)
    (param chain IdList)
    (param sources ExcerptSources)
    (let loc (. ([] (. ([] (. program modules) module) tree nodes) syntax) loc))
    (let site (str (call module-path module) ":" (+ (. loc begin line) 1)))
    (let reason (if-expr recursive "recursive function" "unresolved target: virtual dispatch"))
    (let row ([] (. instances rows) (. ([] (. tables functions) target) instance)))
    (let message
      (scope (str "Cannot inline " (call display target) ": " reason "; @inline declaration at " path ":" line)
        (lazy path (call module-path (. row module)))
        (lazy line (call declared-line target))
      )
    )
    (if (!= (. chain length) 0)
      (let steps (list String))
      (for (in position (..< 0 (. chain length)))
        (+= steps (str (call display ([] chain position)) " at " site))
      )
      (= message (str message "; expanded through " (call (. " -> " join) steps)))
    )
    (return (str "Warning: " message "\n<" site ">\n" (call (. sources excerpt) module loc)))
  )
  (fn-expr _ display String
    (param position FunctionId)
    (call (. tables bundle text) (. ([] (. tables functions) position) display))
  )
  (fn-expr _ module-path String
    (param module ModuleId)
    (if-expr (!= (. path size) 0) path "no file")
    (where
      (lazy path (. ([] (. program modules) module) path))
    )
  )
  (fn-do _ declared-line U32
    (param position FunctionId)
    (let row ([] (. instances rows) (. ([] (. tables functions) position) instance)))
    (let tree (. ([] (. program modules) (. row module)) tree))
    (match? ([] (. ([] (. program modules) (. row module)) decls) (. row decl))
      (case (call .decl-function fn)
        (return (+ (. ([] (. tree nodes) (. fn syntax)) loc begin line) 1))
      )
      (case (call .decl-converter converter)
        (return (+ (. ([] (. tree nodes) (. converter syntax)) loc begin line) 1))
      )
    )
    (return 0)
  )
  (fn-expr _ is-expanded Bool
    (param operand Operand)
    (and (== (call operand-kind operand) .operand-value) (!= (call (. expanded-loads find) (call operand-payload operand)) null))
  )
  (fn-do _ remap Operand
    (param splice Splice)
    (param operand Operand)
    (let payload (call operand-payload operand))
    (if (and (== (call operand-kind operand) .operand-value) spilled crosses-block)
      (return (call load-local ([] (. ([] fusions (. splice fused)) spills) payload)))
    )
    (lazy spilled (and (!= (. splice fused) (. U32 max)) (!= ([] (. ([] fusions (. splice fused)) spills) payload) no-local)))
    (lazy crosses-block (!= (. ([] (. splice source instructions) payload) block) (. splice block)))
    (return
      (match (call operand-kind operand)
        (case= .operand-value
          ([] (. splice values) payload)
        )
        (case= .operand-argument
          (if-expr (. splice inlined) ([] (. splice arguments) payload) operand)
        )
        (case= .operand-number
          (call make-operand .operand-number (+ payload (. splice numbers)))
        )
        (case= .operand-constant
          (call make-operand .operand-constant (+ payload (. splice constants)))
        )
        (case= .operand-block
          (call make-operand .operand-block ([] (. splice heads) payload))
        )
        (case= .operand-result
          (if-expr (!= (. splice continuation) no-block) (. splice result) operand)
        )
        (default
          operand
        )
      )
    )
  )
  (fn-do _ leave _
    (param splice Splice)
    (param row IRInstruction)
    (if (== (. row aux) (. ReturnKind return-panic))
      (call jump (. splice landing))
      (return)
    )
    (if (!= (. row operands count) 0)
      (let value (call remap splice ([] (. splice source operands) (. row operands start))))
      (if (call (. tables layouts is-struct) (. splice source returns))
        (if (and (!= (. splice result) 0) (!= value (. splice result)))
          (call copy (. splice result) value (. splice source returns))
        )
        (else
          (+= (. splice returned) value)
          (+= (. splice arrived) (. output current))
        )
      )
    )
    (call jump (. splice continuation))
  )
  (fn-do _ expand Bool
    (param splice Splice)
    (param id ValueId)
    (param row IRInstruction)
    (param callee FunctionId)
    (if (or (>= (. splice depth) inline-depth) (!= (call (. active find) callee) null))
      (return false)
    )
    (let asked (call requested callee))
    (let reading (and (not asked) (call reads-tuple callee)))
    (let small (and (not asked) (not reading)))
    (let found (call emitted callee))
    (if (not found)
      (return false)
    )
    (let inlined found)
    (let checked (!= (/and/ (. row aux) checked-call-flag) 0))
    (let last (- (. row operands end) (if-expr checked 1u32 0u32)))
    (let given (- last (. row operands start) 1))
    (if (or (!= (. inlined arguments length) given) (not (call fits inlined checked row)))
      (return false)
    )
    (let mark open-splices)
    (let made (call open-splice inlined))
    (= (. made depth) (+ (. splice depth) 1))
    (= (. made inlined) true)
    (= (. made small) small)
    (= (. made site-line) (if-expr (. splice inlined) (. splice site-line) (. row line)))
    (= (. made site-column) (if-expr (. splice inlined) (. splice site-column) (. row column)))
    (= (. made site-module) (if-expr (. splice inlined) (. splice site-module) (. row module)))
    (= (. made site-syntax) (if-expr (. splice inlined) (. splice site-syntax) (. row syntax)))
    (= (. made numbers) (as (. output numbers length) U32))
    (for (in number (. inlined numbers))
      (call (. output numbers append) number)
    )
    (= (. made constants) (as (. output constants length) U32))
    (for (in constant (. inlined constants))
      (call (. output adopt-constant) constant)
    )
    (= (. made locals) (as (. output locals length) U32))
    (for (in local (. inlined locals))
      (call (. output locals append) local)
    )
    (for (in dependency (. inlined dependencies))
      (call (. output depend) (. dependency kind) (. dependency symbol) (. dependency flags))
    )
    (for (in _ (..< 0 (. inlined blocks length)))
      (let reserved (call (. output reserve-block)))
      (+= (. made heads) reserved)
      (+= (. made tails) reserved)
    )
    (let callee-home (call home callee))
    (= (. made module) (if-expr (!= callee-home (call home (. output function))) callee-home (. U32 max)))
    (if checked
      (= (. made landing) ([] (. splice heads) (call operand-payload ([] (. splice source operands) (- (. row operands end) 1)))))
    )
    (= (. made continuation) (call (. output reserve-block)))
    (for (in position (..< 0 given))
      (let operand (call remap splice ([] (. splice source operands) (+ (. row operands start) 1 position))))
      (let layout ([] (. inlined arguments) position))
      (if (and (call (. tables layouts is-struct) layout) (!= (. ([] (. tables layouts rows) layout) size) 0) (not reading))
        (let held (call frame layout))
        (call copy held operand layout)
        (+= (. made arguments) held)
        (else
          (+= (. made arguments) operand)
        )
      )
    )
    (let structured (and (== (. row op) .op-call) (call (. tables layouts is-struct) (. row layout))))
    (let returned (if-expr structured (call returned-frame inlined) (. U32 max)))
    (if (and structured (== returned (. U32 max)))
      (= (. made result) (call frame (. row layout)))
    )
    (call jump ([] (. made heads) ([] (. inlined order) 0)))
    (+= active callee)
    (call copy-blocks made)
    (call (. active pop))
    (= grew true)
    (= expanded true)
    (call (. output start-block) (. made continuation))
    (if (== (. row op) .op-call)
      (if structured
        (= ([] (. splice values) id) (if-expr (== returned (. U32 max)) (. made result) ([] (. made values) returned)))
        (else-if (== (. made returned length) 0)
          (= ([] (. splice values) id) (call blank (. row layout)))
        )
        (else-if (== (. made returned length) 1)
          (= ([] (. splice values) id) ([] (. made returned) 0))
        )
        (else
          (= ([] (. splice values) id) (call phi-of row (. made returned) (. made arrived)))
        )
      )
    )
    (= open-splices mark)
    (return true)
  )
  (fn-do _ expands-any Bool
    (param inlined IRFunction)
    ; Whether a body calls a function that is inlined wherever it is called, or names the
    ; environment of a closure, either of which a body inlined as a small one would have to expand
    ; in turn, or asks for a name that is another where it is inlined.
    (for (in made (. inlined instructions))
      (if (== (. made op) .op-inlined-name)
        (return true)
      )
      (if (or (== (. made op) .op-call) (== (. made op) .op-call-void))
        (let target ([] (. inlined operands) (. made operands start)))
        (let position
          (scope (if-expr is-symbol (call function-of (call operand-payload target)) no-function)
            (lazy is-symbol (== (call operand-kind target) .operand-symbol))
          )
        )
        (if (and (!= position no-function) (or (call requested position) (call signs-reader position)))
          (return true)
        )
      )
      (for (in index (..< (. made operands start) (. made operands end)))
        (if (== (call operand-kind ([] (. inlined operands) index)) .operand-environment)
          (return true)
        )
      )
    )
    (return false)
  )
  (fn-do _ returned-frame U32
    (param ir IRFunction)
    ; The frame a function returns where it returns from one place, which the call it is inlined
    ; for gives as its value in place of a copy. None where it returns from more, or leaves its
    ; value where its caller asked.
    (let found (. U32 max))
    (for (in row (. ir instructions))
      (if (and (== (. row op) .op-return) (!= (. row aux) (. ReturnKind return-panic)))
        (if (or (!= found (. U32 max)) (== (. row operands count) 0))
          (return (. U32 max))
        )
        (let value ([] (. ir operands) (. row operands start)))
        (if (or not-value (!= (. ([] (. ir instructions) (call operand-payload value)) op) .op-frame))
          (return (. U32 max))
        )
        (lazy not-value (!= (call operand-kind value) .operand-value))
        (= found (call operand-payload value))
      )
    )
    (for (in position (..< 0 (. ir operands length)))
      (if (== (call operand-kind ([] (. ir operands) position)) .operand-result)
        (return (. U32 max))
      )
    )
    (return found)
  )
  (fn-do _ fits Bool
    (param inlined IRFunction)
    (param checked Bool)
    (param row IRInstruction)
    (if (or (== (. inlined order length) 0) (and (. inlined signals) (not checked)))
      (return false)
    )
    (if (== (. row op) .op-call)
      (if (!= (. inlined returns) (. row layout))
        (return false)
      )
      (if (and (call (. tables layouts is-struct) (. row layout)) (== (. ([] (. tables layouts rows) (. row layout)) size) 0))
        (return false)
      )
    )
    (let returns false)
    (for (in made (. inlined instructions))
      (if (== (. made op) .op-return)
        (if (== (. made aux) (. ReturnKind return-panic))
          (if (not checked)
            (return false)
          )
          (else
            (= returns true)
          )
        )
      )
      (for (in position (..< (. made operands start) (. made operands end)))
        (if (== (call operand-kind ([] (. inlined operands) position)) .operand-environment)
          (return false)
        )
      )
    )
    (return returns)
  )
  (fn-do _ blank Operand
    (param layout LayoutId)
    (if (== layout void-layout)
      (return (call make-operand .operand-void 0))
    )
    (if (call (. tables layouts is-struct) layout)
      (let made (call frame layout))
      (call zero made layout)
      (return made)
    )
    (return (call number (as layout MachineKind) 0))
  )
  (fn-do _ number Operand
    (param kind MachineKind)
    (param bits U64)
    (return (call make-operand .operand-number (call (. output add-number) kind bits)))
  )
  (fn-do _ frame Operand
    (param layout LayoutId)
    (return
      (call make-operand
        (block
          (arg .operand-value)
          (arg
            (call (. output append)
              (block
                (arg (call IRInstruction .op-frame (. output current) layout no-type 0 0 0 (call Span) layout))
              )
            )
          )
        )
      )
    )
  )
  (fn-do _ zero _
    (param target Operand)
    (param layout LayoutId)
    (let start U32 (. output operands length))
    (call (. output add-operand) target)
    (call (. output append)
      (block
        (arg (call IRInstruction .op-zero (. output current) void-layout no-type 0 0 0 (call Span start 1) layout))
      )
    )
  )
  (fn-do _ load-local Operand
    (param local LocalId)
    (return
      (call make-operand
        (block
          (arg .operand-value)
          (arg
            (call (. output append)
              (block
                (arg
                  (call IRInstruction
                    (block
                      (arg .op-load-local)
                      (arg (. output current))
                      (arg (. ([] (. output locals) local) layout))
                      (arg no-type)
                      (arg 0)
                      (arg 0)
                      (arg 0)
                      (arg (call Span))
                      (arg local)
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )
  (fn-do _ store-local _
    (param local LocalId)
    (param value Operand)
    (let start U32 (. output operands length))
    (call (. output add-operand) value)
    (call (. output append)
      (block
        (arg
          (call IRInstruction
            (block
              (arg .op-store-local)
              (arg (. output current))
              (arg void-layout)
              (arg no-type)
              (arg 0)
              (arg 0)
              (arg 0)
              (arg (call Span start 1))
              (arg local)
            )
          )
        )
      )
    )
  )
  (fn-do _ equal Operand
    (param left Operand)
    (param right Operand)
    (let start U32 (. output operands length))
    (call (. output add-operand) left)
    (call (. output add-operand) right)
    (return
      (call make-operand
        (block
          (arg .operand-value)
          (arg
            (call (. output append)
              (block
                (arg
                  (call IRInstruction
                    (block
                      (arg .op-compare)
                      (arg (. output current))
                      (arg u8-layout)
                      (arg no-type)
                      (arg 0)
                      (arg 0)
                      (arg 0)
                      (arg (call Span start 2))
                      (arg (. ComparePredicate compare-equal))
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )
  (fn-do _ copy _
    (param target Operand)
    (param source Operand)
    (param layout LayoutId)
    (let start U32 (. output operands length))
    (call (. output add-operand) target)
    (call (. output add-operand) source)
    (call (. output append)
      (block
        (arg (call IRInstruction .op-copy (. output current) void-layout no-type 0 0 0 (call Span start 2) layout))
      )
    )
  )
  (fn-do _ jump _
    (param target IRBlockId)
    (let start U32 (. output operands length))
    (call (. output add-operand) (call make-operand .operand-block target))
    (call (. output append)
      (block
        (arg (call IRInstruction .op-jump (. output current) void-layout no-type 0 0 0 (call Span start 1) 0))
      )
    )
  )
  (fn-do _ branch _
    (param condition Operand)
    (param taken IRBlockId)
    (param other IRBlockId)
    (let start U32 (. output operands length))
    (call (. output add-operand) condition)
    (call (. output add-operand) (call make-operand .operand-block taken))
    (call (. output add-operand) (call make-operand .operand-block other))
    (call (. output append)
      (block
        (arg (call IRInstruction .op-branch (. output current) void-layout no-type 0 0 0 (call Span start 3) 0))
      )
    )
  )
  (fn-do _ phi-of Operand
    (param row IRInstruction)
    (param values (list Operand))
    (param blocks (list IRBlockId))
    (let start U32 (. output operands length))
    (for (in position (..< 0 (. values length)))
      (call (. output add-operand) ([] values position))
      (call (. output add-operand) (call make-operand .operand-block ([] blocks position)))
    )
    (let operands (call Span start (- (. output operands length) start)))
    (return
      (call make-operand
        (block
          (arg .operand-value)
          (arg
            (call (. output append)
              (block
                (arg (call IRInstruction .op-phi (. output current) (. row layout) (. row type) 0 0 0 operands 0))
              )
            )
          )
        )
      )
    )
  )
)
