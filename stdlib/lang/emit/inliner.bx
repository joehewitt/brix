  (fn-do _ trace-frame Bool
    (param level U32)
    (param frame ValueId)
    (let found ([] levels level))
    (let ir (. found ir))
    (let copied Operand 0)
    (let copies U32)
    (let boxed Operand 0)
    (let tagged false)
    (let stores U32)
    (for (in id (..< 0 (. ir instructions length)))
      (let row ([] (. ir instructions) id))
      (if (or (== (. row operands count) 0) (!= ([] (. ir operands) (. row operands start)) frame-operand))
        (continue)
      )
      (lazy frame-operand (call make-operand .operand-value frame))
      (if (== (. row op) .op-copy)
        (+= copies 1)
        (= copied ([] (. ir operands) (+ (. row operands start) 1)))
        (else-if (== (. row op) .op-store)
          (+= stores 1)
          (let stored ([] (. ir operands) (+ (. row operands start) 1)))
          (let offset (/and/ (. row aux) 0x7fffffff))
          (if (== offset 0)
            (= boxed stored)
            (else-if (and (== offset managed-size) (== (call operand-kind stored) .operand-symbol))
              (= tagged true)
            )
          )
          (lazy managed-size (. ([] (. tables layouts rows) managed-layout) size))
        )
        (else-if (or (== (. row op) .op-zero) (== (. row op) .op-address))
          (return false)
        )
      )
    )
    (if (and (== copies 1) (== stores 0) (== ([] (. found uses) frame) 2))
      (return (call trace level copied))
    )
    (if (or (!= copies 0) (!= stores 2) (not tagged) other-uses (!= (call operand-kind boxed) .operand-value))
      (return false)
    )
    (lazy other-uses (!= ([] (. found uses) frame) 3))
    (let box (call operand-payload boxed))
    (let allocation ([] (. ir instructions) box))
    (if (or (!= (. allocation op) .op-call) not-runtime (!= ([] (. found uses) box) 2))
      (return false)
    )
    (lazy not-runtime (!= (/and/ (. allocation aux) callee-kind-mask) (. CalleeKind callee-runtime)))
    (if (!= ([] (. ir operands) (. allocation operands start)) allocator)
      (return false)
    )
    (lazy allocator (call make-operand .operand-symbol (call (. tables runtime-symbol) .runtime-allocate-object)))
