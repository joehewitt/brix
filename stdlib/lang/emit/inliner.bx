      (lazy returns-error (and (== (. row op) .op-return) (== (. row aux) (. ReturnKind return-error))))
      (if (and (== (. row op) .op-return) (== (. row aux) (. ReturnKind return-panic)))
        (if ([] (. fused closing) (. row block))
          (for (in position (..< 0 (. found ends length)))
            (if (== (/and/ (. ([] (. consumer instructions) ([] (. found ends) position)) aux) checked-call-flag) 0)
              (return false)
            )
          )
        )
        (if (and ([] (. fused body) (. row block)) (== (/and/ (. read aux) checked-call-flag) 0))
          (return false)
        )
      )
      (if (and ([] (. fused closing) (. row block)) ([] (. fused body) (. row block)) is-call calls-function)
        (return false)
      )
      (lazy is-call (or (== (. row op) .op-call) (== (. row op) .op-call-void)))
      (lazy calls-function (== (/and/ (. row aux) callee-kind-mask) (. CalleeKind callee-function)))
    )
    (for (in stream (..< 0 (. produced streams length)))
      (let inner ([] (. produced streams) stream))
      (for (in position (..< 0 (. inner ends length)))
        (let ended (. ([] (. produced instructions) ([] (. inner ends) position)) block))
        (if (and ([] (. fused closing) ended) ([] (. fused body) ended))
