          (continue)
        )
        (let made (call operand-payload operand))
        (let home (. ([] (. produced instructions) made) block))
        (let user (. row block))
        (if (== (. row op) .op-phi)
          (= user (call operand-payload ([] (. produced operands) (+ position 1))))
        )
        (if (or (== home user) (call dominates home user idoms (as count U32)))
