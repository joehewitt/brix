  (fn-do _ carried Operand
    (param splice Splice)
    (param operand Operand)
    (let payload (call operand-payload operand))
    (match (call operand-kind operand)
      (case= .operand-value
        (if (and (!= (. splice fused) (. U32 max)) (!= ([] (. ([] fusions (. splice fused)) spills) payload) no-local))
          (return 0)
        )
        (let value ([] (. splice values) payload))
        (return
          (scope (if-expr (or is-value (== (call operand-kind value) .operand-argument)) value 0)
            (lazy is-value (== (call operand-kind value) .operand-value))
          )
        )
      )
      (case= .operand-argument
        (if (not (. splice inlined))
          (return operand)
        )
        (let value ([] (. splice arguments) payload))
        (return
          (scope (if-expr (or (== (call operand-kind value) .operand-value) is-argument) value 0)
            (lazy is-argument (== (call operand-kind value) .operand-argument))
          )
        )
      )
      (default
        (return 0)
      )
    )
    (return 0)
