  (fn-expr _ copied ValueId
    (param splice Splice)
    (param id ValueId)
    (case? (!= (call operand-kind value) .operand-value)
      (. U32 max)
    )
    (case? (or (!= (. copy op) (. row op)) not-call (!= (. copy operands count) (. row operands count)))
      (. U32 max)
    )
    (default
      made
    )
    (where
      (lazy value ([] (. splice values) id))
      (lazy made (call operand-payload value))
      (lazy row ([] (. splice source instructions) id))
      (lazy copy ([] (. output instructions) made))
      (lazy not-call (and (!= (. copy op) .op-call) (!= (. copy op) .op-call-void)))
    )
  )
  (fn-expr _ kept Bool
    (param splice Splice)
    (param block IRBlockId)
    (or (== (. splice only length) 0) ([] (. splice only) block))
  )
  (fn-do _ fuse-row Bool
    (param splice Splice)
    (param id ValueId)
    (param row IRInstruction)
    (if (and (!= (. splice level) (. U32 max)) ([] (. ([] levels (. splice level)) dead) id))
      (return true)
    )
    (if (!= (. splice fused) (. U32 max))
      (if (== (. row op) .op-yield)
        (call fused-yield splice id row)
