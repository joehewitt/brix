  (fn-do _ find-crossings Bool
    (param fused Fused)
    (let produced (. fused ir))
    (let count (. produced blocks length))
    (for (in _ (..< 0 (. produced instructions length)))
      (+= (. fused crossing) false)
    )
    (let roots (list IRBlockId))
    (+= roots ([] (. produced order) 0))
    (for (in yielded (. fused yields))
      (let row ([] (. produced instructions) yielded))
      (+= roots (call operand-payload ([] (. produced operands) (+ (. row operands start) 1))))
      (if (!= (. row aux) no-block)
        (+= roots (. row aux))
      )
    )
    (let numbers (list U32))
    (let idoms (list U32))
    (for (in _ (..< 0 (+ count 1)))
      (+= numbers (. U32 max))
      (+= idoms (. U32 max))
    )
    (let sequence (list IRBlockId))
    (let visiting (list IRBlockId))
    (let cursors (list U32))
    (let successors (list IRBlockId))
    (for (in root roots)
      (if (and (!= ([] numbers root) (- (. U32 max) 1)) (== ([] numbers root) (. U32 max)))
        (+= visiting root)
        (+= cursors 0)
        (= ([] numbers root) (- (. U32 max) 1))
        (while (!= (. visiting length) 0)
          (let top (- (. visiting length) 1))
          (let block ([] visiting top))
          (call (. successors clear))
          (call block-successors produced block successors)
          (if (< ([] cursors top) (. successors length))
            (let next ([] successors ([] cursors top)))
            (+= ([] cursors top) 1)
            (if (== ([] numbers next) (. U32 max))
              (= ([] numbers next) (- (. U32 max) 1))
              (+= visiting next)
              (+= cursors 0)
            )
            (continue)
