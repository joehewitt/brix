          (+= sequence block)
          (call (. visiting pop))
          (call (. cursors pop))
        )
      )
    )
    (for (in position (..< 0 (. sequence length)))
      (= ([] numbers ([] sequence position)) (as position U32))
    )
    (= ([] numbers count) (as (. sequence length) U32))
    (= ([] idoms count) (as count U32))
    (let preds (list (list IRBlockId)))
    (for (in _ (..< 0 (+ count 1)))
      (let none (list IRBlockId))
      (+= preds none)
    )
    (for (in root roots)
      (+= ([] preds root) (as count IRBlockId))
    )
    (for (in block sequence)
      (call (. successors clear))
      (call block-successors produced block successors)
      (for (in next successors)
        (+= ([] preds next) block)
