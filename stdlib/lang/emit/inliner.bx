    (let fills U32)
    (for (in id (..< 0 (. ir instructions length)))
      (let row ([] (. ir instructions) id))
      (if (and (== (. row op) .op-copy) (== ([] (. ir operands) (. row operands start)) boxed))
        (+= fills 1)
        (= inner ([] (. ir operands) (+ (. row operands start) 1)))
      )
    )
    (return (and (== fills 1) (call trace level inner)))
