    (let outer (. ([] levels (. fused consumer)) fused))
    (if (!= outer (. U32 max))
      (let around ([] fusions outer))
      (let begun (. ([] (. consumer instructions) (. found begin)) block))
      (if (or ([] (. around closing) begun) (not ([] (. around body) begun)))
        (return false)
      )
      (for (in position (..< 0 (. found ends length)))
        (let ended (. ([] (. consumer instructions) ([] (. found ends) position)) block))
        (if (and (not ([] (. around closing) ended)) (not ([] (. around body) ended)))
          (return false)
        )
      )
