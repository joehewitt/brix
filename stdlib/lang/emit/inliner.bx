        )
        (if (or (== (. row op) .op-phi) (call (. tables layouts is-struct) (. ([] (. produced instructions) made) layout)))
          (return false)
        )
        (= ([] (. fused crossing) made) true)
      )
    )
    (return true)
  )
  (fn-do _ block-successors _
    (param produced IRFunction)
    (param block IRBlockId)
    (param found (list IRBlockId))
    (param yields Bool (= false))
    (let rows (. ([] (. produced blocks) block) instructions))
    (for (in id (..< (. rows start) (. rows end)))
      (let row ([] (. produced instructions) id))
      (if (or (== (. row op) .op-phi) (and (== (. row op) .op-yield) (not yields)))
        (continue)
      )
      (for (in position (..< (. row operands start) (. row operands end)))
        (let operand ([] (. produced operands) position))
        (if (== (call operand-kind operand) .operand-block)
          (+= found (call operand-payload operand))
        )
      )
    )
  )
  (fn-do _ meet U32
    (param left U32)
    (param right U32)
    (param idoms (list U32))
    (param numbers (list U32))
    (let first left)
    (let second right)
    (while (!= first second)
      (while (< ([] numbers first) ([] numbers second))
        (= first ([] idoms first))
      )
      (while (< ([] numbers second) ([] numbers first))
        (= second ([] idoms second))
      )
    )
    (return first)
  )
  (fn-do _ dominates Bool
