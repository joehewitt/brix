./layouts
./program-tables
./runtime
/core/arena
/core/table
/lang/backend/aarch64-encoder
/lang/backend/builder
/lang/backend/bundle
/lang/backend/mir
/lang/ir/ir

_ struct-return-register RegisterId = 8
_ argument-register-count U32 = 8
_ panic-signal-register RegisterId = 15
_ task-context-register RegisterId = 27
_ aux-payload-mask U32 = 0x7fffffff
_ mark-shift U32 = 28
_ mark-mask U32 = 0x0fffffff

━━━━━━━━━━━━━━━━━━━━
_ ArmCondition is U32

| equal
| not-equal
| higher-same
| lower
| minus
| higher = 8
| lower-same = 9
| greater-equal = 10
| less = 11
| greater = 12
| less-equal = 13

━━━━━━━━━━━━━━━━━━━━
+ LoweringMark is U32

| used-mark = 0
| buffer-mark = 1
| allocated-mark = 2
| plain-mark = 3

━━━━━━━━━━━━━━━━━━━━
+ IRToMIR

` Builds a function's MIR from its IR through the backend's builder, walking the blocks in
` the order they started. A non-value operand is materialized at each use. A struct's value is
` its address: of memory in the frame, of the buffer a call returned into, or of a place
` inside an object. A local is an object of the frame, which the backend turns into registers
` when nothing has its address; one that holds a number and that nothing reads is given none,
` and what is written to it is dropped. `used` marks each layout whose GC descriptor the
` worker's code names, and `buffers` each whose items a buffer the code allocates holds, so
` the merge adds those descriptors to the object. `marks` lists what the current function
` marked, each a kind and a layout or a plain site, for a later round that reuses it.

+ marks [U32]
+ used CPointer'Byte
+ buffers CPointer'Byte
+ allocated CPointer'Byte
+ plain-allocated CPointer'Byte
_ tables ProgramTables
_ builder MIRBuilder
_ values CPointer'U32
_ heaps CPointer'Byte
_ phi-inputs CPointer'U32
_ block-ids CPointer'U32
_ cells CPointer'U32
_ kept CPointer'Byte
_ arguments IdList
_ general U32
_ floats U32
_ result OperandId = no-operand
_ struct-layouts IdList
_ struct-types IdList
_ checked-landing IRBlockId = no-block
_ split-roots CPointer'U32
_ split-offsets CPointer'U32
_ root-layouts CPointer'U32
_ root-ok CPointer'Byte
_ root-first CPointer'U32
_ root-count CPointer'U32
_ leaf-offsets CPointer'U32
_ leaf-layouts CPointer'U32
_ leaf-cells CPointer'U32
_ root-loads CPointer'U32
_ root-calls CPointer'U32
_ arg-roots CPointer'U32

────────────────────
+ This
    - tables ProgramTables
    - builder MIRBuilder
    - storage Arena

. count = tables.layouts.count
used = storage.allocate'Byte(count)
buffers = storage.allocate'Byte(count)
allocated = storage.allocate'Byte(count)
for id in 0 .. < count
    used[id] = 0
    buffers[id] = 0
    allocated[id] = 0
plain-allocated = storage.allocate'Byte(plain-site-count)
for slot in 0 .. < plain-site-count
    plain-allocated[slot] = 0

────────────────────
+ do begin
    - id FunctionId

marks.clear()
` Names the MIR function about to be built, after its arena was reset, and where it is declared.
. function = builder.function
. row = tables.functions[id]
function.order = id
function.label = row.name
function.name = row.name
function.symbol = row.symbol
function.display-name = row.display
builder.adopt()
. declared = tables.declared-at(id)
if declared
    function.loc = builder.add-loc(declared)

────────────────────
+ do lower
    - ir IRFunction

` Builds the function's blocks in the order they started. A value's register is noted where
` its row is lowered, and a phi's inputs where each predecessor ends.
. arena = builder.function.arena
. function = builder.function
. count = ir.instructions.length
values = arena.allocate'U32(count + 1)
heaps = arena.allocate'Byte(count + 1)
for id in 0 .. < count
    heaps[id] = 0
phi-inputs = arena.allocate'U32(ir.operands.length + 1)
block-ids = arena.allocate'U32(ir.blocks.length + 1)
cells = arena.allocate'U32(ir.locals.length + 1)
kept = arena.allocate'Byte(ir.locals.length + 1)
keep-locals(ir)
struct-layouts = IdList()
struct-types = IdList()
plan-splits(ir)
result = no-operand
checked-landing = no-block
for position in 0 .. < ir.order.length
    . block = ir.order[position]
    . name = tables.bundle.entry-name
    if position != 0
        name = function.add-local-name(.block-name, no-string, no-string, block)
    block-ids[block] = builder.add-block(name)
builder.set-insert-block(block-ids[ir.order[0]])
lower-locals(ir)
lower-arguments(ir)
for position in 0 .. < ir.order.length
    . block = ir.order[position]
    builder.set-insert-block(block-ids[block])
    . rows = ir.blocks[block].instructions
    for id in rows.start .. < rows.end
        lower-instruction(ir, id)

────────────────────
_ do keep-locals
    - ir IRFunction

` Marks the locals the frame holds: each that a row reads or takes the address of, each that
` holds a managed pointer, which keeps what it points at alive though nothing reads it, and
` each struct. A number nothing reads, as a flag the function clears and never tests, is not
` held.
for id in 0 .. < ir.locals.length
    . local = ir.locals[id]
    kept[id] = 0
    if local.address-taken || local.layout == managed-layout || holds-struct
        kept[id] = 1
    .. holds-struct = tables.layouts.is-struct(local.layout)
for id in 0 .. < ir.instructions.length
    . row = ir.instructions[id]
    if row.op == .op-load-local || row.op == .op-local-address
        kept[row.aux] = 1

────────────────────
_ do lower-locals
    - ir IRFunction

` Gives each local the frame holds an object of the frame, and lists it as a variable of the
` function. One that holds a managed pointer is a GC root, which the prologue clears, and so
` is a struct that holds some, which the collector scans in place. One whose address nothing
` has may become registers, which the backend decides for the variables listed. A struct
` never does.
. function = builder.function
for id in 0 .. < ir.locals.length
    if kept[id] == 0
        cells[id] = no-operand
        continue
    if root-ok[id] != 0
        cells[id] = no-operand
        add-leaves(id as U32)
        continue
    . local = ir.locals[id]
    . descriptor = stack-descriptor(local.layout)
    . is-root = local.layout == managed-layout || descriptor != no-string
    . mode = if descriptor == no-string then GCRootMode.value-root else GCRootMode.address-root
    . promoted = !local.address-taken && !tables.layouts.is-struct(local.layout)
    . slot = builder.frame-slot()
    . type = mir-type(local.layout)
    . object = builder.add-frame-object(slot, type, 0, promoted, is-root, descriptor, mode)
    function.vars = function.vars.appended(function.arena, object)
    cells[id] = builder.frame-object-operand(object)
for id in 0 .. < ir.instructions.length
    . op = ir.instructions[id].op
    if (op == .op-frame || op == .op-call) && root-ok[ir.locals.length + id] != 0
        add-leaves((ir.locals.length + id) as U32)

────────────────────
_ do lower-arguments
    - ir IRFunction

` The address a struct too large for registers is returned to arrives in a register of its
` own, and each argument in the next register of its class, floats counted apart from the
` rest. Each is moved into a register of the function's own. One that no register of its
` class is left for arrives on the stack and is loaded from there, a struct too large for
` registers as its address. An argument of no size is not passed: one that is a struct is
` memory of no size in the frame.
. arena = builder.function.arena
arguments = new-id-list(arena, ir.arguments.length)
if tables.layouts.is-large(ir.returns)
    . incoming = builder.vreg-operand(builder.new-vreg(.gpr64, struct-return-register))
    result = builder.vreg(.gpr64)
    builder.mov(result, incoming)
general = 0
floats = 0
for position in 0 .. < ir.arguments.length
    . layout = ir.arguments[position] as LayoutId
    if layout == void-layout
        arguments = arguments.appended(arena, no-operand)
        continue
    if is-empty-struct(layout)
        arguments = arguments.appended(arena, empty-place(layout))
        continue
    if small-struct && arg-roots[position] != 0 && root-ok[arg-roots[position] - 1] != 0
        receive-leaves(arg-roots[position] - 1)
        arguments = arguments.appended(arena, no-operand)
        continue
    .. small-struct = tables.layouts.is-struct(layout) && !tables.layouts.is-large(layout)
    if tables.layouts.is-struct(layout) && !tables.layouts.is-large(layout)
        arguments = arguments.appended(arena, receive-struct(layout))
        continue
    . reg-class = layout-class(layout)
    . number = general
    if is-float(layout)
        number = floats
        floats += 1
    else
        general += 1
    . value = new-value(layout, false)
    if number < argument-register-count
        . incoming = builder.vreg-operand
            - builder.new-vreg(reg-class, register-of(reg-class, number))
        if !builder.bundle.apple-abi && is-narrow-integer(layout)
            extend(value, incoming, tables.layouts.rows[layout].size, is-signed(layout))
        else
            move(value, incoming, layout)
    else
        . passed = mir-type(layout)
        if tables.layouts.is-struct(layout)
            passed = builder.reg-class-type(reg-class)
        builder.load(value, builder.frame-object-operand(builder.overflow-object(passed)), passed)
    arguments = arguments.appended(arena, value)

────────────────────
_ is-empty-struct Bool
    - layout LayoutId

` Whether a layout is a struct of no size, which no register takes to a function or back.
tables.layouts.is-struct(layout) && tables.layouts.rows[layout].size == 0

────────────────────
_ do empty-place OperandId
    - layout LayoutId

` Memory of no size in the frame, which an argument or an answer of no size is from there on.
. object = builder.add-frame-object(builder.frame-slot(), mir-type(layout), 0, false)
. place = new-value(layout, false)
builder.add-pointer(place, builder.frame-object-operand(object))
= place

────────────────────
_ do receive-leaves
    - root U32

` A split struct argument arrives in the registers it travels in, and each of its fields is
` moved from there into a register of its own: each float of a struct of floats from a
` register of its own, and each other field from the bits of the word it lies in.
. count = builder.struct-parts(mir-type(root-layouts[root]))
. reg-class = builder.type-reg-class(builder.part-types[0])
. is-floats = reg-class == .fpr32 || reg-class == .fpr64
. taken = if is-floats then floats else general
. fits = taken + count <= argument-register-count
. next = if fits then taken + count else argument-register-count
if is-floats
    floats = next
else
    general = next
add-leaves(root)
. words = new-id-list(builder.function.arena, count)
for index in 0 .. < count
    . part = builder.part-types[index]
    . word = builder.vreg(builder.type-reg-class(part))
    if fits
        . incoming = builder.vreg-operand
            - builder.new-vreg(reg-class, register-of(reg-class, taken + index))
        if is-floats
            builder.fmov(word, incoming)
        else
            builder.mov(word, incoming)
    else
        builder.load(word, builder.frame-object-operand(builder.overflow-object(part)), part)
    words = words.appended(builder.function.arena, word)
unpack(root, words, is-floats)

────────────────────
_ do unpack
    - root U32
    - words IdList
    - is-floats Bool

` Moves each field of a split struct from the registers it travels in into a register of its
` own: each float of a struct of floats from a register of its own, and each other field from
` the bits of the word it lies in.
. first = root-first[root]
for leaf in first .. < first + root-count[root]
    . spot = leaf-offsets[leaf]
    . layout = leaf-layouts[leaf]
    . value = new-value(layout, false)
    if is-floats
        move(value, words[leaf - first], layout)
    else
        . bits = (spot % 8) * 8
        . source OperandId = words[spot / 8]
        if bits != 0
            . shifted = builder.vreg(.gpr64)
            builder.asm(.lsr, shifted, source, builder.small-int(bits))
            source = shifted
        builder.mov
            - value
            - if tables.layouts.rows[layout].size == 8 then source else builder.narrow-view(source)
    builder.store(leaf-cells[leaf], value, mir-type(layout))

────────────────────
_ do receive-struct OperandId
    - layout LayoutId

` A struct that arrives in registers is stored to memory of the frame, and is the address of
` that memory from there on. One the registers left cannot hold arrives whole on the stack,
` and no later argument of its class arrives in a register. Words are stored whole, so the
` memory of a struct that travels as words is whole words.
. function = builder.function
. type = mir-type(layout)
. count = builder.struct-parts(type)
. reg-class = builder.type-reg-class(builder.part-types[0])
. is-floats = reg-class == .fpr32 || reg-class == .fpr64
. held = type
if !is-floats
    held = function.types.length as MIRTypeId
    function.types.append(ArrayType(count * 8, 8, u8-type-id, count * 8))
. object = builder.add-frame-object(builder.frame-slot(), held, 0, false)
. taken = if is-floats then floats else general
. fits = taken + count <= argument-register-count
. next = if fits then taken + count else argument-register-count
if is-floats
    floats = next
else
    general = next
. place = new-value(layout, false)
builder.add-pointer(place, builder.frame-object-operand(object))
for index in 0 .. < count
    . part = builder.part-types[index]
    . target = builder.load-address-offset(place, builder.part-offsets[index])
    if fits
        . register = register-of(reg-class, taken + index)
        builder.store(target, builder.vreg-operand(builder.new-vreg(reg-class, register)), part)
    else
        builder.store(target, builder.frame-object-operand(builder.overflow-object(part)), part)
= place

────────────────────
_ do lower-instruction
    - ir IRFunction
    - id ValueId

. row = ir.instructions[id]
do match row.op
    |= .op-call-void
        lower-call(ir, id, row)
    |= .op-call
        lower-call(ir, id, row)
    |= .op-return
        lower-return(ir, row)
    |= .op-jump
        lower-jump(ir, row)
    |= .op-branch
        lower-branch(ir, row)
    |= .op-switch
        lower-switch(ir, row)
    |= .op-yield
        ?! Panic("A yield is only fused into the loop that reads it")
    |= .op-phi
        lower-phi(ir, id, row)
    |= .op-arithmetic
        lower-arithmetic(ir, id, row)
    |= .op-bitwise
        lower-bitwise(ir, id, row)
    |= .op-num-cast
        lower-num-cast(ir, id, row)
    |= .op-load
        lower-load(ir, id, row)
    |= .op-store
        lower-store(ir, row)
    |= .op-load-acquire
        lower-load-acquire(ir, id, row)
    |= .op-store-release
        lower-store-release(ir, row)
    |= .op-address
        lower-address(ir, id, row)
    |= .op-frame
        lower-frame(id, row)
    |= .op-copy
        lower-copy(ir, row)
    |= .op-zero
        lower-zero(ir, row)
    |= .op-load-task-panic
        lower-load-task-panic(id)
    |= .op-load-panic-signal
        lower-load-panic-signal()
    |= .op-load-task-word
        lower-load-task-word(id, row)
    |= .op-negate
        lower-negate(ir, id, row)
    |= .op-bitwise-not
        lower-bitwise-not(ir, id, row)
    |= .op-compare
        lower-compare(ir, id, row)
    |= .op-load-local
        lower-load-local(id, row)
    |= .op-store-local
        lower-store-local(ir, row)
    |= .op-count-leading-zeros
        lower-count-leading-zeros(ir, id, row)
    |= .op-local-address
        lower-local-address(id, row)
    |= .op-float-math
        lower-float-math(ir, id, row)
    |= .op-inlined-name
        lower-inlined-name(ir, id, row)

────────────────────
_ do lower-call
    - ir IRFunction
    - id ValueId
    - row IRInstruction

` A call of a symbol, or of an address held in a register. A struct too large for registers
` is returned into a buffer the backend reserves, and the call's value is its address. A split
` struct small enough for registers is returned in the registers it travels in, and each of
` its fields is taken from there into a register of its own. A checked call names the landing pad it leaves to when its callee returns a panic. A call that
` records its caller's stack is a safepoint on every path. An argument of no size is not
` passed, and an answer of no size is not brought back: it is memory of no size in the frame.
` Under AAPCS64 a C function leaves the high bits of an integer answer narrower than 32 bits
` unspecified, so the call extends it.
if lower-allocation(ir, id, row)
    =
. arena = builder.function.arena
. operands = row.operands
. kind = row.aux /and/ callee-kind-mask
. extends-answer = !builder.bundle.apple-abi && calls-c && is-narrow-integer(row.layout)
    .. calls-c = kind == CalleeKind.callee-c || kind == CalleeKind.callee-runtime
. is-checked = (row.aux /and/ checked-call-flag) != 0
. last = operands.end
if is-checked
    last -= 1
. target = ir.operands[operands.start]
. callee = no-operand
if kind == CalleeKind.callee-value
    callee = materialize(ir, target)
else
    callee = builder.symbol(operand-payload(target))
. given = new-id-list(arena, operands.count)
. types = new-id-list(arena, operands.count)
. packed = new-id-list(arena, operands.count)
for position in operands.start + 1 .. < last
    . operand = ir.operands[position]
    . layout = ir.operand-layout(operand)
    if layout == void-layout
        continue
    . parts = no-operand
    if is-split(operand) && packs(root-of(operand) - 1, offset-of(operand), layout)
        . words = pack(operand, layout)
        parts = builder.travel(words, builder.function.vregs[words[0]].reg-class)
        given = given.appended(arena, no-operand)
    else if is-split(operand)
        given = given.appended(arena, rebuild(operand, layout))
    else
        given = given.appended(arena, materialize(ir, operand))
    packed = packed.appended(arena, parts)
    types = types.appended(arena, mir-type(layout))
. returned = no-operand
. answers = row.layout
. parts = IdList()
if is-empty-struct(row.layout)
    values[id] = empty-place(row.layout)
    answers = void-layout
else if split-roots[id] != 0 && root-ok[split-roots[id] - 1] != 0
    . count = builder.struct-parts(mir-type(row.layout))
    parts = new-id-list(arena, count)
    for index in 0 .. < count
        parts = parts.appended
            - arena
            - builder.new-vreg(builder.type-reg-class(builder.part-types[index]))
    returned = builder.group(parts, builder.type-reg-class(builder.part-types[0]))
    values[id] = no-operand
else if row.layout != void-layout
    returned = new-value(row.layout, false)
    values[id] = returned
    if row.layout == managed-layout
        heaps[id] = 1
. panic-target = no-operand
if is-checked
    checked-landing = operand-payload(ir.operands[last])
    panic-target = builder.block-label(block-ids[checked-landing])
. arrived = if extends-answer then builder.vreg(layout-class(row.layout)) else returned
. made = builder.call
    - mir-type(answers)
    - callee
    - arrived
    - location(ir, row)
    - given
    - types
    - panic-target
    - packed
if extends-answer
    extend(returned, arrived, tables.layouts.rows[row.layout].size, is-signed(row.layout))
if (row.aux /and/ stack-map-call-flag) != 0
    builder.function.instructions[made].gc-safepoint = true
    builder.function.instructions[made].gc-exceptional-safepoint = true
if parts.length != 0
    . words = new-id-list(arena, parts.length)
    for index in 0 .. < parts.length
        words = words.appended(arena, builder.vreg-operand(parts[index]))
    . reg-class = builder.function.vregs[parts[0]].reg-class
    unpack(split-roots[id] - 1, words, reg-class == .fpr32 || reg-class == .fpr64)

────────────────────
_ do lower-allocation Bool
    - ir IRFunction
    - id ValueId
    - row IRInstruction

. operands = row.operands
if not-runtime || operands.count != 3 || ir.operands[operands.start] != allocator
    = false
.. not-runtime = (row.aux /and/ callee-kind-mask) != CalleeKind.callee-runtime
.. allocator = make-operand(.operand-symbol, tables.runtime-symbol(.runtime-allocate-object))
. size = ir.operands[operands.start + 1]
. described = ir.operands[operands.start + 2]
if operand-kind(size) != .operand-number
    = false
. bytes = ir.numbers[operand-payload(size)].bits
if !inlines-allocation(bytes)
    = false
. site = no-string
if operand-kind(described) == .operand-descriptor
    . layout = operand-payload(described) as LayoutId
    site = tables.layouts.rows[layout].site
    if site == no-string || bytes != (tables.layouts.rows[layout].size as U64)
        = false
    descriptor-of(layout)
    mark(.allocated-mark, layout)
else if operand-kind(described) == .operand-number && undescribed
    site = tables.layouts.plain-site(bytes)
    mark(.plain-mark, (allocated-size(bytes) / 8) as U32)
else
    = false
.. undescribed = ir.numbers[operand-payload(described)].bits == 0
. returned = new-value(managed-layout, false)
values[id] = returned
heaps[id] = 1
builder.gc-alloc(returned, symbol-address(site), location(ir, row))
= true

────────────────────
_ do lower-return
    - ir IRFunction
    - row IRInstruction

` Returns to the caller, with the value in the first register of its class. A struct is
` returned from its address: copied to the memory the caller gave when it is too large for
` registers, unless it was built there, and loaded into the registers it travels in
` otherwise; one of no size is not returned. A function that signals writes the panic signal
` on the way out: nothing, or the active panic.
. is-struct = tables.layouts.is-struct(ir.returns)
if row.operands.count != 0 && is-struct && !is-empty-struct(ir.returns)
    return-struct(ir, ir.operands[row.operands.start])
else if row.operands.count != 0 && !is-struct
    . reg-class = layout-class(ir.returns)
    . returned = builder.vreg-operand(builder.new-vreg(reg-class, register-of(reg-class, 0)))
    move(returned, materialize(ir, ir.operands[row.operands.start]), ir.returns)
. signal = builder.preg(panic-signal-register)
if ir.signals && row.aux == ReturnKind.return-panic
    builder.ldr(signal, task-panic-address())
else if ir.signals
    builder.mov(signal, builder.preg(zero-register))
builder.asm(.ret)

────────────────────
_ do return-struct
    - ir IRFunction
    - operand Operand

if is-split(operand) && packs(root-of(operand) - 1, offset-of(operand), ir.returns)
    . words = pack(operand, ir.returns)
    for index in 0 .. < words.length
        . part = builder.function.vregs[words[index]].reg-class
        . returned = builder.vreg-operand(builder.new-vreg(part, register-of(part, index)))
        if part == .gpr64
            builder.mov(returned, builder.vreg-operand(words[index]))
        else
            builder.fmov(returned, builder.vreg-operand(words[index]))
    =
. value = no-operand
if is-split(operand)
    value = rebuild(operand, ir.returns)
else
    value = materialize(ir, operand)
if tables.layouts.is-large(ir.returns)
    if operand-kind(operand) != .operand-result
        builder.copy-memory(result, value, tables.layouts.rows[ir.returns].size)
    =
. type = mir-type(ir.returns)
. count = builder.struct-parts(type)
. reg-class = builder.type-reg-class(builder.part-types[0])
if reg-class != .gpr64 || tables.layouts.rows[ir.returns].size % 8 == 0
    for index in 0 .. < count
        . returned = builder.vreg-operand
            - builder.new-vreg(reg-class, register-of(reg-class, index))
        builder.load-part(returned, value, type, index)
    =
. words = new-id-list(builder.function.arena, count)
for index in 0 .. < count
    . word = builder.new-vreg(reg-class)
    builder.load-part(builder.vreg-operand(word), value, type, index)
    words = words.appended(builder.function.arena, word)
for index in 0 .. < count
    . returned = builder.vreg-operand(builder.new-vreg(reg-class, register-of(reg-class, index)))
    builder.mov(returned, builder.vreg-operand(words[index]))

────────────────────
_ do lower-jump
    - ir IRFunction
    - row IRInstruction

. target = operand-payload(ir.operands[row.operands.start])
feed-phis(ir, row.block, target)
builder.b(builder.block-label(block-ids[target]))
builder.link(block-ids[row.block], block-ids[target])
if checked-landing != no-block
    builder.link(block-ids[row.block], block-ids[checked-landing])
    checked-landing = no-block

────────────────────
_ do lower-branch
    - ir IRFunction
    - row IRInstruction

` Branches to the first block when the condition is not zero, and to the second otherwise. A
` condition narrower than its register is read at its own width.
. operand = ir.operands[row.operands.start]
. taken = operand-payload(ir.operands[row.operands.start + 1])
. other = operand-payload(ir.operands[row.operands.start + 2])
. condition = no-operand
if operand-kind(operand) == .operand-panic-signal
    condition = builder.preg(panic-signal-register)
else
    condition = materialize(ir, operand)
    . size = tables.layouts.rows[ir.operand-layout(operand)].size
    if size < 4
        . whole = builder.vreg(.gpr32)
        extend(whole, condition, size, false)
        condition = whole
feed-phis(ir, row.block, taken)
feed-phis(ir, row.block, other)
builder.cbnz(condition, builder.block-label(block-ids[taken]))
builder.b(builder.block-label(block-ids[other]))
builder.link(block-ids[row.block], block-ids[other])
builder.link(block-ids[row.block], block-ids[taken])

────────────────────
_ do lower-switch
    - ir IRFunction
    - row IRInstruction

. start = row.operands.start
. operand = ir.operands[start]
. layout = ir.operand-layout(operand)
. condition = whole(materialize(ir, operand), layout)
. fallback = operand-payload(ir.operands[start + 1])
. count = (row.operands.count - 2) / 2
. values [U64]
. targets [IRBlockId]
for position in 0 .. < count
    . number = ir.numbers[operand-payload(ir.operands[start + 2 + position * 2])]
    values += number.bits
    targets += operand-payload(ir.operands[start + 3 + position * 2])
. linked [IRBlockId]
linked += fallback
for target in targets
    . seen = false
    for other in linked
        if other == target
            seen = true
    if !seen
        linked += target
for target in linked
    feed-phis(ir, row.block, target)
. fail = builder.block-label(block-ids[fallback])
if lower-comparison-tree(ir, layout, condition, values, targets, fallback, linked)
    =
if !lower-jump-table(layout, condition, values, targets, fallback)
    for position in 0 .. < count
        builder.asm(.cmp, condition, case-operand(values[position], layout))
        builder.asm
            - .b-cond
            - builder.block-label(block-ids[targets[position]])
            - builder.add-operand(CondOperand(ArmCondition.equal))
    builder.b(fail)
for target in linked
    builder.link(block-ids[row.block], block-ids[target])

────────────────────
_ do lower-comparison-tree Bool
    - ir IRFunction
    - layout LayoutId
    - condition OperandId
    - values [U64]
    - targets [IRBlockId]
    - fallback IRBlockId
    - linked [IRBlockId]

if is-signed(layout) || values.length < 5
    = false
for target in linked
    . rows = ir.blocks[target].instructions
    if rows.count != 0 && ir.instructions[rows.start].op == .op-phi
        = false
. order [U32]
for position in 0 .. < values.length
    . slot = order.length
    order += position as U32
    while slot > 0 && values[order[slot - 1]] > values[order[slot]]
        . swapped = order[slot - 1]
        order[slot - 1] = order[slot]
        order[slot] = swapped
        slot -= 1
for position in 1 .. < order.length
    if values[order[position - 1]] == values[order[position]]
        = false
. count = values.length as U64
. size U64 = if tables.layouts.rows[layout].size > 1 then tables.layouts.rows[layout].size else 1
. span = values[order[order.length - 1]] - values[order[0]] + 1
. span-bytes = (bit-length(span) + 7) / 8
. comparison-cost = count * (20 + size)
. tree-cost = count * 12 + depth-cost + 24 + (if span-bytes > 1 then span-bytes else 1)
    .. depth-cost = bit-length(count) * (8 + size)
if tree-cost >= comparison-cost
    = false
emit-tree
    - order
    - 0
    - order.length as U32
    - builder.insertion-block
    - layout
    - condition
    - values
    - targets
    - fallback
= true

────────────────────
_ do emit-tree
    - order [U32]
    - low U32
    - high U32
    - block BlockId
    - layout LayoutId
    - condition OperandId
    - values [U64]
    - targets [IRBlockId]
    - fallback IRBlockId

builder.set-insert-block(block)
. middle = low + (high - low) / 2
. entry = order[middle]
. matched = block-ids[targets[entry]]
. fail = block-ids[fallback]
builder.asm(.cmp, condition, case-operand(values[entry], layout))
builder.asm
    - .b-cond
    - builder.block-label(matched)
    - builder.add-operand(CondOperand(ArmCondition.equal))
connect(block, matched)
. left = if middle == low then fail else builder.add-block(builder.function.add-local-name(.switch-tree-name, no-string, no-string, builder.function.blocks.length as U32))
. right = if middle + 1 == high then fail else builder.add-block(builder.function.add-local-name(.switch-tree-name, no-string, no-string, builder.function.blocks.length as U32))
if left != fail || right != fail
    builder.asm
        - .b-cond
        - builder.block-label(left)
        - builder.add-operand(CondOperand(ArmCondition.lower))
    connect(block, left)
builder.b(builder.block-label(right))
connect(block, right)
if left != fail
    emit-tree(order, low, middle, left, layout, condition, values, targets, fallback)
if right != fail
    emit-tree(order, middle + 1, high, right, layout, condition, values, targets, fallback)

────────────────────
_ do connect
    - source BlockId
    - target BlockId

. successors = builder.function.blocks[source].successors
for index in 0 .. < successors.length
    if successors[index] == target
        =
builder.link(source, target)

────────────────────
_ do case-operand OperandId
    - value U64
    - layout LayoutId

if value <= 4095
    = builder.small-int(value as I64)
= whole(materialize-integer(layout as MachineKind, value), layout)

────────────────────
_ do lower-jump-table Bool
    - layout LayoutId
    - condition OperandId
    - values [U64]
    - targets [IRBlockId]
    - fallback IRBlockId

if is-signed(layout) || values.length < 4
    = false
. low = values[0]
. high = values[0]
for value in values
    if value < low
        low = value
    if value > high
        high = value
. span = high - low + 1
. bits = tables.layouts.rows[layout].size * 8
. limit U64 = 1 /lshift/ (if bits < 20 then bits else 20)
if span > limit || (values.length as U64) * 2 < span
    = false
. index = builder.vreg(.gpr64)
if builder.operand-reg-class(condition) == .gpr32
    builder.asm(.uxtw, index, condition)
else
    builder.mov(index, condition)
if low > 0
    builder.sub-immediate(index, index, low as I64)
builder.asm(.cmp, index, case-operand(span - 1, u64-layout))
builder.asm
    - .b-cond
    - builder.block-label(block-ids[fallback])
    - builder.add-operand(CondOperand(ArmCondition.higher))
. function = builder.function
. names = function.names
. first = names.length
for offset in 0 .. < span
    . target = fallback
    for position in 0 .. < values.length
        if values[position] == low + offset
            target = targets[position]
    names = names.appended(function.arena, function.blocks[block-ids[target]].name)
function.names = names
. name = function.add-local-name
    - .jump-table-name
    - no-string
    - no-string
    - function.jump-tables.length as U32
function.jump-tables.append(MIRJumpTable(name, Span(first, span as U32)))
. base = builder.vreg(.gpr64)
builder.asm(.adr, base, builder.label(name))
. offset = builder.vreg(.gpr64)
builder.asm(.lsl, offset, index, builder.small-int(2))
. entry = builder.vreg(.gpr64)
builder.add(entry, base, offset)
. relative = builder.vreg(.gpr64)
builder.asm(.ldrsw, relative, builder.load-address(entry))
. target = builder.vreg(.gpr64)
builder.add(target, base, relative)
builder.asm(.br, target)
= true

────────────────────
_ do feed-phis
    - ir IRFunction
    - source IRBlockId
    - target IRBlockId

` Before a block ends, puts in a register each value a phi of the block it jumps to takes
` from it.
. rows = ir.blocks[target].instructions
for id in rows.start .. < rows.end
    . row = ir.instructions[id]
    if row.op != .op-phi
        break
    . position = row.operands.start
    while position < row.operands.end
        if operand-payload(ir.operands[position + 1]) == source
            phi-inputs[position] = materialize(ir, ir.operands[position])
        position += 2

────────────────────
_ do lower-phi
    - ir IRFunction
    - id ValueId
    - row IRInstruction

. arena = builder.function.arena
. count = row.operands.count / 2
. exprs = new-id-list(arena, count)
. blocks = new-id-list(arena, count)
. position = row.operands.start
while position < row.operands.end
    . source = operand-payload(ir.operands[position + 1])
    exprs = exprs.appended(arena, phi-inputs[position])
    blocks = blocks.appended(arena, builder.function.blocks[block-ids[source]].name)
    position += 2
. joined = new-value(row.layout, false)
values[id] = joined
if row.layout == managed-layout
    heaps[id] = 1
builder.phi-of(joined, exprs, blocks)

────────────────────
_ do lower-arithmetic
    - ir IRFunction
    - id ValueId
    - row IRInstruction

` Arithmetic on two numbers of the row's layout. Nothing is checked: integers wrap, and a
` division by zero gives what the machine gives. An integer remainder is what the division
` leaves, and an integer narrower than a register is extended by its own sign before it is
` divided. A float remainder is a call, which the emitter makes.
. op = row.aux as ArithmeticOp
. given = ir.operands[row.operands.start + 1]
if integer-add && operand-kind(given) == .operand-number && small-number
    . base = materialize(ir, ir.operands[row.operands.start])
    . moved = new-value(row.layout, false)
    values[id] = moved
    . bits = ir.numbers[operand-payload(given)].bits as I64
    if op == .arithmetic-add
        builder.add-immediate(moved, base, bits)
    else
        builder.sub-immediate(moved, base, bits)
    =
.. integer-add = !is-float(row.layout) && (op == .arithmetic-add || op == .arithmetic-subtract)
.. small-number = ir.numbers[operand-payload(given)].bits <= 4095
if !is-float(row.layout) && given-number && lower-by-power-of-two(ir, id, row, op, given-bits)
    =
.. given-number = operand-kind(given) == .operand-number
.. given-bits = ir.numbers[operand-payload(given)].bits
. left = materialize(ir, ir.operands[row.operands.start])
. right = materialize(ir, given)
if op == .arithmetic-divide || op == .arithmetic-remainder
    left = whole(left, row.layout)
    right = whole(right, row.layout)
. value = new-value(row.layout, false)
values[id] = value
if is-float(row.layout)
    . opcode = Opcode.fadd
    if op == .arithmetic-subtract
        opcode = .fsub
    else if op == .arithmetic-multiply
        opcode = .fmul
    else if op == .arithmetic-divide
        opcode = .fdiv
    ?! Panic("The remainder of two floats is not a machine operation")
        if op == .arithmetic-remainder
    builder.asm(opcode, value, left, right)
    =
. divide = if is-signed(row.layout) then Opcode.sdiv else Opcode.udiv
if op == .arithmetic-remainder
    . reg-class = layout-class(row.layout)
    . quotient = builder.vreg(reg-class)
    . product = builder.vreg(reg-class)
    builder.asm(divide, quotient, left, right)
    builder.asm(.mul, product, quotient, right)
    builder.asm(.sub, value, left, product)
    =
. opcode = Opcode.add
if op == .arithmetic-subtract
    opcode = .sub
else if op == .arithmetic-multiply
    opcode = .mul
else if op == .arithmetic-divide
    opcode = divide
builder.asm(opcode, value, left, right)

────────────────────
_ do lower-by-power-of-two Bool
    - ir IRFunction
    - id ValueId
    - row IRInstruction
    - op ArithmeticOp
    - divisor U64

` A remainder by a power of two, or a signed division by one, without dividing. An unsigned
` remainder keeps the low bits. A signed dividend that is negative first gains one less than the
` divisor, so the shift rounds toward zero as the division does, and the remainder is what that
` rounded quotient leaves. An integer narrower than a register is left to the division.
. size = tables.layouts.rows[row.layout].size
if size != 4 && size != 8
    = false
. width = (size as U64) * 8
. signed = is-signed(row.layout)
if divisor < 2 || (divisor /and/ (divisor - 1)) != 0 || divisor >= (1u64 /lshift/ (width - 1))
    = false
if op != .arithmetic-remainder && (op != .arithmetic-divide || !signed)
    = false
. shift U64
while (1u64 /lshift/ shift) != divisor
    shift += 1
. left = materialize(ir, ir.operands[row.operands.start])
. value = new-value(row.layout, false)
values[id] = value
if !signed
    builder.asm(.and, value, left, builder.small-int((divisor - 1) as I64))
    = true
. reg-class = layout-class(row.layout)
. bias = builder.vreg(reg-class)
if shift == 1
    builder.asm(.lsr, bias, left, builder.small-int((width - 1) as I64))
else
    . sign = builder.vreg(reg-class)
    builder.asm(.asr, sign, left, builder.small-int((width - 1) as I64))
    builder.asm(.lsr, bias, sign, builder.small-int((width - shift) as I64))
. biased = builder.vreg(reg-class)
builder.asm(.add, biased, left, bias)
if op == .arithmetic-divide
    builder.asm(.asr, value, biased, builder.small-int(shift as I64))
    = true
. mask = (U64.max /lshift/ shift) /and/ (U64.max /zrshift/ (64 - width))
. rounded = builder.vreg(reg-class)
builder.asm(.and, rounded, biased, builder.small-int(mask as I64))
builder.asm(.sub, value, left, rounded)
= true

────────────────────
_ do lower-bitwise
    - ir IRFunction
    - id ValueId
    - row IRInstruction

` A bitwise operator or a shift, done in a whole register. A value narrower than its register
` is first extended by its own sign, so a shift to the right moves in the bits its sign gives.
. left = materialize(ir, ir.operands[row.operands.start])
. right = materialize(ir, ir.operands[row.operands.start + 1])
. value = new-value(row.layout, false)
values[id] = value
. op = row.aux as BitwiseOp
if op == .bitwise-shift-right || op == .bitwise-shift-right-zero
    left = whole(left, row.layout)
. opcode = Opcode.and
if op == .bitwise-or
    opcode = .orr
else if op == .bitwise-xor
    opcode = .eor
else if op == .bitwise-shift-left
    opcode = .lslv
else if op == .bitwise-shift-right
    opcode = .asrv
else if op == .bitwise-shift-right-zero
    opcode = .lsrv
builder.asm(opcode, value, left, right)

────────────────────
_ do lower-negate
    - ir IRFunction
    - id ValueId
    - row IRInstruction

. operand = materialize(ir, ir.operands[row.operands.start])
. value = new-value(row.layout, false)
values[id] = value
builder.asm(if is-float(row.layout) then Opcode.fneg else Opcode.neg, value, operand)

────────────────────
_ do lower-bitwise-not
    - ir IRFunction
    - id ValueId
    - row IRInstruction

. operand = materialize(ir, ir.operands[row.operands.start])
. value = new-value(row.layout, false)
values[id] = value
builder.asm(.mvn, value, operand)

────────────────────
_ do lower-compare
    - ir IRFunction
    - id ValueId
    - row IRInstruction

` Compares two values of one layout and gives one or zero. Integers narrower than a register
` are compared whole, and the layout's sign and kind choose the condition.
. first = ir.operands[row.operands.start]
. second = ir.operands[row.operands.start + 1]
. layout = ir.operand-layout(first)
. is-real = is-float(layout)
. predicate = row.aux as ComparePredicate
if !is-real && is-small-number(ir, first, layout) && !is-small-number(ir, second, layout)
    first = second
    second = ir.operands[row.operands.start]
    predicate = mirrored(predicate)
. left = materialize(ir, first)
. value = new-value(row.layout, false)
if is-real
    builder.asm
        - if layout == f32-layout then Opcode.fcmps else Opcode.fcmpd
        - left
        - materialize(ir, second)
else if is-small-number(ir, second, layout)
    builder.asm
        - .cmp
        - whole(left, layout)
        - builder.small-int(ir.numbers[operand-payload(second)].bits as I64)
else
    builder.asm(.cmp, whole(left, layout), whole(materialize(ir, second), layout))
values[id] = value
. unsigned = !is-real && !is-signed(layout)
. code = ArmCondition.equal
if predicate == .compare-not-equal
    code = ArmCondition.not-equal
else if predicate == .compare-greater
    code = if unsigned then ArmCondition.higher else ArmCondition.greater
else if predicate == .compare-greater-equal
    code = if unsigned then ArmCondition.higher-same else ArmCondition.greater-equal
else if predicate == .compare-less
    code = ArmCondition.less
    if is-real
        code = ArmCondition.minus
    else if unsigned
        code = ArmCondition.lower
else if predicate == .compare-less-equal
    code = if is-real || unsigned then ArmCondition.lower-same else ArmCondition.less-equal
builder.asm(.cset, value, builder.add-operand(CondOperand(code)))

────────────────────
_ is-small-number Bool
    - ir IRFunction
    - operand Operand
    - layout LayoutId

operand-kind(operand) == .operand-number && number-bits <= (if is-byte then 127u64 else 4095u64)

.. number-bits = ir.numbers[operand-payload(operand)].bits
.. is-byte = tables.layouts.rows[layout].size == 1

────────────────────
_ mirrored ComparePredicate
    - predicate ComparePredicate

match predicate
    |= .compare-greater
        .compare-less
    |= .compare-greater-equal
        .compare-less-equal
    |= .compare-less
        .compare-greater
    |= .compare-less-equal
        .compare-greater-equal
    ??
        predicate

────────────────────
_ do lower-float-math
    - ir IRFunction
    - id ValueId
    - row IRInstruction

` A square root, an absolute value, or the lesser or greater of two floats. The lesser or
` greater compares the second with the first and takes the second when the comparison gives
` it, so the first is taken when either is not a number.
. first = materialize(ir, ir.operands[row.operands.start])
. op = row.aux as FloatMath
if op == .float-sqrt || op == .float-abs
    . value = new-value(row.layout, false)
    values[id] = value
    builder.asm(if op == .float-sqrt then Opcode.fsqrt else Opcode.fabs, value, first)
    =
. second = materialize(ir, ir.operands[row.operands.start + 1])
builder.asm(.fcmpd, second, first)
. value = new-value(row.layout, false)
values[id] = value
. code = if op == .float-max then ArmCondition.greater else ArmCondition.minus
builder.asm(.fcsel, value, second, first, builder.add-operand(CondOperand(code)))

────────────────────
_ do whole OperandId
    - value OperandId
    - layout LayoutId

` An integer narrower than a register, extended to the register by its own sign.
. size = tables.layouts.rows[layout].size
if size >= 4 || is-float(layout)
    = value
. extended = builder.vreg(.gpr32)
extend(extended, value, size, is-signed(layout))
= extended

────────────────────
_ do lower-num-cast
    - ir IRFunction
    - id ValueId
    - row IRInstruction

` A number as another kind of number.
` Between integers, the same bits at another width:
` - a wider target extends the source from its width, with its sign when both have one;
` - a target narrower than a register is extended from its own width;
` - any other target takes the source's low bits.
` An integer becomes a float by its own sign, a float becomes an integer by the target's sign
` and loses its fraction, and a float changes width.
. operand = ir.operands[row.operands.start]
. source = ir.operand-layout(operand)
. given = materialize(ir, operand)
. value = new-value(row.layout, false)
values[id] = value
if row.layout == managed-layout
    heaps[id] = 1
. source-size = tables.layouts.rows[source].size
. target-size = tables.layouts.rows[row.layout].size
if is-float(row.layout)
    if is-float(source)
        builder.asm(if source == row.layout then Opcode.fmov else Opcode.fcvt, value, given)
    else
        builder.asm
            - if is-signed(source) then Opcode.scvtf else Opcode.ucvtf
            - value
            - whole(given, source)
    =
if is-float(source)
    . convert = if is-signed(row.layout) then Opcode.fcvtzs else Opcode.fcvtzu
    if target-size < 4
        . cut = builder.vreg(.gpr32)
        builder.asm(convert, cut, given)
        extend(value, cut, target-size, is-signed(row.layout))
    else
        builder.asm(convert, value, given)
    =
if source-size < target-size
    extend(value, given, source-size, is-signed(source))
else if target-size < 4
    extend(value, builder.narrow-view(given), target-size, is-signed(row.layout))
else
    builder.mov(value, if target-size == 8 then given else builder.narrow-view(given))

────────────────────
_ do extend
    - dest OperandId
    - src OperandId
    - size U32
    - is-signed Bool

` Extends the low `size` bytes of a register to the whole of another.
. opcode = Opcode.uxtw
if size == 1
    opcode = if is-signed then Opcode.sxtb else Opcode.uxtb
else if size == 2
    opcode = if is-signed then Opcode.sxth else Opcode.uxth
else if is-signed
    opcode = .sxtw
builder.asm(opcode, dest, src)

────────────────────
_ do lower-load
    - ir IRFunction
    - id ValueId
    - row IRInstruction

. operand = ir.operands[row.operands.start]
. value = new-value(row.layout, false)
values[id] = value
if row.layout == managed-layout
    heaps[id] = 1
. leaf = split-leaf(operand, row.aux)
if leaf != U32.max
    builder.load(value, leaf-cells[leaf], mir-type(row.layout))
    =
. base = materialize(ir, operand)
builder.load(value, builder.load-address-offset(base, row.aux), mir-type(row.layout))

────────────────────
_ do lower-store
    - ir IRFunction
    - row IRInstruction

` Writes a value to a place. A managed pointer written into an object goes through the write
` barrier first, which is given the place and the pointer.
. operand = ir.operands[row.operands.start + 1]
. value = materialize(ir, operand)
. offset = row.aux /and/ aux-payload-mask
. type = mir-type(ir.operand-layout(operand))
. leaf = split-leaf(ir.operands[row.operands.start], offset)
if leaf != U32.max
    builder.store(leaf-cells[leaf], value, type)
    =
. base = materialize(ir, ir.operands[row.operands.start])
if (row.aux /and/ managed-store-flag) == 0
    builder.store(builder.load-address-offset(base, offset), value, type)
    =
. place = builder.vreg-operand(builder.new-vreg(.gpr64, no-register, true))
builder.add-pointer(place, builder.load-address-offset(base, offset))
builder.gc-barrier(place, value, location(ir, row))
builder.store(place, value, type)

────────────────────
_ do lower-load-acquire
    - ir IRFunction
    - id ValueId
    - row IRInstruction

` Reads an integer from a place with acquire ordering: what its writer stored before the
` release store that wrote it is seen by every read that follows.
. value = new-value(row.layout, false)
values[id] = value
. base = materialize(ir, ir.operands[row.operands.start])
builder.load-acquire(value, builder.load-address-offset(base, row.aux), mir-type(row.layout))

────────────────────
_ do lower-store-release
    - ir IRFunction
    - row IRInstruction

` Writes an integer to a place with release ordering: after every store before it.
. operand = ir.operands[row.operands.start + 1]
. value = materialize(ir, operand)
. base = materialize(ir, ir.operands[row.operands.start])
builder.store-release
    - builder.load-address-offset(base, row.aux)
    - value
    - mir-type(ir.operand-layout(operand))

────────────────────
_ do lower-inlined-name
    - ir IRFunction
    - id ValueId
    - row IRInstruction

. fallback = materialize(ir, ir.operands[row.operands.start + 1])
. value = new-value(row.layout, false)
values[id] = value
if row.aux == 0
    builder.mov(value, fallback)
    =
builder.asm(.inlined-name, value, materialize(ir, ir.operands[row.operands.start]), fallback)

────────────────────
_ do lower-load-local
    - id ValueId
    - row IRInstruction

. value = new-value(row.layout, false)
values[id] = value
if row.layout == managed-layout
    heaps[id] = 1
builder.load(value, cells[row.aux], mir-type(row.layout))

────────────────────
_ do lower-store-local
    - ir IRFunction
    - row IRInstruction

` Writes a value to a local the frame holds. The frame is not in the heap, so no store to it
` takes a barrier.
if kept[row.aux] == 0
    =
. operand = ir.operands[row.operands.start]
builder.store(cells[row.aux], materialize(ir, operand), mir-type(ir.locals[row.aux].layout))

────────────────────
_ do lower-local-address
    - id ValueId
    - row IRInstruction

` The address of a local's place in the frame.
if split-roots[id] != 0 && root-ok[split-roots[id] - 1] != 0
    values[id] = no-operand
    =
. value = new-value(row.layout, false)
values[id] = value
if row.layout == managed-layout
    heaps[id] = 1
builder.add-pointer(value, cells[row.aux])

────────────────────
_ do lower-count-leading-zeros
    - ir IRFunction
    - id ValueId
    - row IRInstruction

` How many of an integer's highest bits are zero, counted within the integer's own width,
` which the instruction gives in bits. One narrower than a register is extended with zeros
` first, and the bits the register adds are taken off the count.
. operand = ir.operands[row.operands.start]
. size = tables.layouts.rows[ir.operand-layout(operand)].size
. bits = row.aux
. given = materialize(ir, operand)
. is-wide = size == 8
. source = given
if size < 4
    source = builder.vreg(.gpr32)
    extend(source, given, size, false)
. count = builder.vreg(if is-wide then RegClass.gpr64 else RegClass.gpr32)
builder.asm(.clz, count, source)
if bits < 32
    builder.asm(.sub, count, count, builder.small-int(32 - bits))
. value = new-value(row.layout, false)
values[id] = value
. returns-wide = tables.layouts.rows[row.layout].size == 8
if returns-wide == is-wide
    builder.mov(value, count)
else if returns-wide
    builder.asm(.uxtw, value, count)
else
    builder.mov(value, builder.narrow-view(count))

────────────────────
_ do lower-address
    - ir IRFunction
    - id ValueId
    - row IRInstruction

` The address of a place inside a base. One inside an object keeps the object alive.
if split-roots[id] != 0 && root-ok[split-roots[id] - 1] != 0
    values[id] = no-operand
    =
. operand = ir.operands[row.operands.start]
. base = materialize(ir, operand)
. inside = is-heap(ir, operand)
. value = new-value(row.layout, inside)
values[id] = value
if inside || row.layout == managed-layout
    heaps[id] = 1
builder.add-pointer(value, builder.load-address-offset(base, row.aux))

────────────────────
_ do lower-frame
    - id ValueId
    - row IRInstruction

` Memory in the frame for a struct. When the struct holds managed pointers the collector
` scans it in place, from the moment the function is entered.
if root-ok[split-roots[id] - 1] != 0
    values[id] = no-operand
    =
. layout = row.aux as LayoutId
. descriptor = stack-descriptor(layout)
. mode = if descriptor == no-string then GCRootMode.value-root else GCRootMode.address-root
. slot = builder.frame-slot()
. is-root = descriptor != no-string
. object = builder.add-frame-object(slot, mir-type(layout), 0, false, is-root, descriptor, mode)
. value = builder.vreg(.gpr64)
values[id] = value
builder.add-pointer(value, builder.frame-object-operand(object))

────────────────────
_ do lower-copy
    - ir IRFunction
    - row IRInstruction

` Copies a struct from one place to another. A copy into an object tells the collector first
` which managed pointers it is about to write, and a split struct copied there is built in
` memory first, so that the collector is told of it whole.
. layout = (row.aux /and/ aux-payload-mask) as LayoutId
. target-operand = ir.operands[row.operands.start]
. source-operand = ir.operands[row.operands.start + 1]
. barriers = (row.aux /and/ managed-store-flag) != 0
if is-split(target-operand) || (is-split(source-operand) && !barriers)
    copy-split(ir, target-operand, source-operand, layout)
    =
. target = materialize(ir, target-operand)
. source = no-operand
if is-split(source-operand)
    source = rebuild(source-operand, layout)
else
    source = materialize(ir, source-operand)
. size = tables.layouts.rows[layout].size
if barriers
    . descriptor = builder.symbol(descriptor-of(layout))
    builder.gc-barrier(target, source, location(ir, row), builder.small-int(size), descriptor)
builder.copy-memory(target, source, size)

────────────────────
_ do lower-zero
    - ir IRFunction
    - row IRInstruction

. operand = ir.operands[row.operands.start]
if is-split(operand)
    zero-split(operand, row.aux)
    =
. target = materialize(ir, operand)
builder.zero-memory(target, tables.layouts.rows[row.aux as LayoutId].size)

────────────────────
_ do plan-splits
    - ir IRFunction

. arena = builder.function.arena
. count U32 = ir.instructions.length as U32
. locals U32 = ir.locals.length as U32
. given U32 = ir.arguments.length
. roots = locals + count + given
arg-roots = arena.allocate'U32(given + 1)
for position in 0 .. < given
    arg-roots[position] = 0
split-roots = arena.allocate'U32(count + 1)
split-offsets = arena.allocate'U32(count + 1)
root-layouts = arena.allocate'U32(roots + 1)
root-ok = arena.allocate'Byte(roots + 1)
root-first = arena.allocate'U32(roots + 1)
root-count = arena.allocate'U32(roots + 1)
root-loads = arena.allocate'U32(roots + 1)
root-calls = arena.allocate'U32(roots + 1)
for id in 0 .. < count
    split-roots[id] = 0
    split-offsets[id] = 0
for root in 0 .. < roots
    root-ok[root] = 0
    root-layouts[root] = void-layout
    root-first[root] = 0
    root-count[root] = 0
    root-loads[root] = 0
    root-calls[root] = 0
for id in 0 .. < locals
    . local = ir.locals[id]
    if kept[id] != 0 && !local.address-taken && !local.filled && holds-struct
        root-layouts[id] = local.layout
        root-ok[id] = 1
    .. holds-struct = tables.layouts.is-struct(local.layout)
for position in 0 .. < given
    . layout = ir.arguments[position] as LayoutId
    if tables.layouts.is-struct(layout) && !tables.layouts.is-large(layout) && has-size
        root-layouts[locals + count + position] = layout
        root-ok[locals + count + position] = 1
        arg-roots[position] = locals + count + position + 1
    .. has-size = tables.layouts.rows[layout].size != 0
for id in 0 .. < count
    . row = ir.instructions[id]
    if row.op == .op-frame
        root-layouts[locals + id] = row.aux
        root-ok[locals + id] = 1
        split-roots[id] = locals + id + 1
    else if row.op == .op-call && small-struct && tables.layouts.rows[row.layout].size != 0
        root-layouts[locals + id] = row.layout
        root-ok[locals + id] = 1
        split-roots[id] = locals + id + 1
    else if row.op == .op-local-address && root-ok[row.aux] != 0
        split-roots[id] = row.aux + 1
    else if row.op == .op-address
        . base = ir.operands[row.operands.start]
        if root-of(base) != 0
            split-roots[id] = root-of(base)
            split-offsets[id] = offset-of(base) + row.aux
    .. small-struct = tables.layouts.is-struct(row.layout) && !tables.layouts.is-large(row.layout)
. total U32
for root in 0 .. < roots
    if root-ok[root] != 0
        . leaves = leaf-count(root-layouts[root])
        if leaves == U32.max || leaves == 0
            root-ok[root] = 0
        else
            root-first[root] = total
            root-count[root] = leaves
            total += leaves
leaf-offsets = arena.allocate'U32(total + 1)
leaf-layouts = arena.allocate'U32(total + 1)
leaf-cells = arena.allocate'U32(total + 1)
for root in 0 .. < roots
    if root-ok[root] != 0
        fill-leaves(root-layouts[root], 0, root-first[root])
for position in 0 .. < given
    . root = arg-roots[position]
    if root != 0 && !packs(root - 1, 0, root-layouts[root - 1])
        root-ok[root - 1] = 0
for id in 0 .. < count
    if is-call && split-roots[id] != 0 && !packs(locals + id, 0, root-layouts[locals + id])
        root-ok[locals + id] = 0
    .. is-call = ir.instructions[id].op == .op-call
for id in 0 .. < count
    . row = ir.instructions[id]
    if (row.op == .op-load-local || row.op == .op-store-local) && row.aux < locals
        root-ok[row.aux] = 0
    for position in row.operands.start .. < row.operands.end
        . operand = ir.operands[position]
        . root = root-of(operand)
        if root != 0 && !splits-use(ir, id, row, position - row.operands.start, operand)
            root-ok[root - 1] = 0
for root in 0 .. < roots
    if root-calls[root] > root-loads[root]
        root-ok[root] = 0

────────────────────
_ do leaf-count U32
    - layout LayoutId

if !tables.layouts.is-struct(layout)
    = if layout == void-layout then 0 else 1
. row = tables.layouts.rows[layout]
if row.cases.count != 0
    = U32.max
. total U32
for position in row.fields.start .. < row.fields.end
    . inner = leaf-count(tables.layouts.fields[position].layout)
    if inner == U32.max
        = U32.max
    total += inner
= total

────────────────────
_ do fill-leaves U32
    - layout LayoutId
    - offset U32
    - next U32

if !tables.layouts.is-struct(layout)
    if layout == void-layout
        = next
    leaf-offsets[next] = offset
    leaf-layouts[next] = layout
    leaf-cells[next] = no-operand
    = next + 1
. row = tables.layouts.rows[layout]
. spot = next
for position in row.fields.start .. < row.fields.end
    . field = tables.layouts.fields[position]
    spot = fill-leaves(field.layout, offset + field.offset, spot)
= spot

────────────────────
_ do find-leaf U32
    - root U32
    - offset U32
    - layout LayoutId

. first = root-first[root]
for leaf in first .. < first + root-count[root]
    if leaf-offsets[leaf] == offset
        = if leaf-layouts[leaf] == layout then leaf else U32.max
= U32.max

────────────────────
_ do covers Bool
    - root U32
    - offset U32
    - layout LayoutId

if !tables.layouts.is-struct(layout)
    = layout == void-layout || find-leaf(root, offset, layout) != U32.max
. row = tables.layouts.rows[layout]
if row.cases.count != 0
    = false
for position in row.fields.start .. < row.fields.end
    . field = tables.layouts.fields[position]
    if !covers(root, offset + field.offset, field.layout)
        = false
= true

────────────────────
_ do splits-use Bool
    - ir IRFunction
    - id ValueId
    - row IRInstruction
    - index U32
    - operand Operand

. root = root-of(operand) - 1
. offset = offset-of(operand)
do match? row.op
    |= .op-load
        root-loads[root] += 1
        = index == 0 && !tables.layouts.is-struct(row.layout) && has-leaf
            .. has-leaf = find-leaf(root, offset + row.aux, row.layout) != U32.max
    |= .op-call
        = index != 0 && passes(root, offset, ir.operand-layout(operand))
    |= .op-call-void
        = index != 0 && passes(root, offset, ir.operand-layout(operand))
    |= .op-return
        = index == 0 && passes(root, offset, ir.returns)
    |= .op-store
        if index != 0
            = false
        . stored = ir.operand-layout(ir.operands[row.operands.start + 1])
        = !tables.layouts.is-struct(stored) && find-leaf(root, field-offset, stored) != U32.max
            .. field-offset = offset + (row.aux /and/ aux-payload-mask)
    |= .op-copy
        if index == 1 && (row.aux /and/ managed-store-flag) != 0
            root-calls[root] += 1
        = covers(root, offset, row.aux /and/ aux-payload-mask)
    |= .op-zero
        = index == 0 && covers(root, offset, row.aux)
    |= .op-address
        = index == 0 && split-roots[id] != 0
= false

────────────────────
_ do passes Bool
    - root U32
    - offset U32
    - layout LayoutId

` Whether a split struct can be passed to a call or returned. One that cannot travel in its
` registers straight from its fields is built in memory first, which counts against
` splitting it.
if !tables.layouts.is-struct(layout) || is-empty || !covers(root, offset, layout)
    = false
.. is-empty = tables.layouts.rows[layout].size == 0
if !packs(root, offset, layout)
    root-calls[root] += 1
= true

────────────────────
_ do rebuild OperandId
    - operand Operand
    - layout LayoutId

. size = tables.layouts.rows[layout].size
. descriptor = stack-descriptor(layout)
. mode = if descriptor == no-string then GCRootMode.value-root else GCRootMode.address-root
. object = builder.add-frame-object
    - builder.frame-slot()
    - mir-type(layout)
    - 0
    - false
    - descriptor != no-string
    - descriptor
    - mode
. place = builder.vreg(.gpr64)
builder.add-pointer(place, builder.frame-object-operand(object))
. root = root-of(operand) - 1
. base = offset-of(operand)
. first = root-first[root]
for leaf in first .. < first + root-count[root]
    . spot = leaf-offsets[leaf]
    if spot >= base && spot < base + size
        . part = leaf-layouts[leaf]
        . type = mir-type(part)
        . held = new-value(part, false)
        builder.load(held, leaf-cells[leaf], type)
        builder.store(builder.load-address-offset(place, spot - base), held, type)
= place

────────────────────
_ do add-leaves
    - root U32

. function = builder.function
. first = root-first[root]
for leaf in first .. < first + root-count[root]
    . layout = leaf-layouts[leaf]
    . is-root = layout == managed-layout
    . object = builder.add-frame-object
        - builder.frame-slot()
        - mir-type(layout)
        - 0
        - true
        - is-root
        - no-string
        - GCRootMode.value-root
    function.vars = function.vars.appended(function.arena, object)
    leaf-cells[leaf] = builder.frame-object-operand(object)

────────────────────
_ is-split Bool
    - operand Operand

root != 0 && root-ok[root - 1] != 0

.. root = root-of(operand)

────────────────────
_ root-of U32
    - operand Operand

match operand-kind(operand)
    |= .operand-value
        split-roots[operand-payload(operand)]
    |= .operand-argument
        arg-roots[operand-payload(operand)]
    ??
        0

────────────────────
_ offset-of U32
    - operand Operand

if operand-kind(operand) == .operand-value then split-offsets[operand-payload(operand)] else 0

────────────────────
_ do packs Bool
    - root U32
    - base U32
    - layout LayoutId

` Whether the fields of a split struct small enough for registers can travel in its registers
` without memory between: each float of a struct of floats in a register of its own, or else
` integers and pointers that each lie inside one word.
if !tables.layouts.is-struct(layout) || tables.layouts.is-large(layout) || is-empty
    = false
.. is-empty = tables.layouts.rows[layout].size == 0
. size = tables.layouts.rows[layout].size
. count = builder.struct-parts(mir-type(layout))
. reg-class = builder.type-reg-class(builder.part-types[0])
. is-floats = reg-class == .fpr32 || reg-class == .fpr64
. found U32
. words U32
. first = root-first[root]
for leaf in first .. < first + root-count[root]
    . spot = leaf-offsets[leaf]
    if spot >= base && spot < base + size
        . inside = spot - base
        . width = tables.layouts.rows[leaf-layouts[leaf]].size
        if is-floats
            if found >= count || builder.part-offsets[found] != inside || width-differs
                = false
            .. width-differs = builder.function.types[builder.part-types[found]].size != width
        else if is-float(leaf-layouts[leaf]) || odd-width || inside / 8 != (inside + width - 1) / 8
            = false
        else
            words = words /or/ (1u32 /lshift/ (inside / 8))
        .. odd-width = width != 1 && width != 2 && width != 4 && width != 8
        found += 1
if is-floats
    = found == count
= words == (1u32 /lshift/ count) - 1

────────────────────
_ do pack IdList
    - operand Operand
    - layout LayoutId

` The registers a split struct that `packs` travels in, built from its fields: each float of a
` struct of floats as it is, and each word of any other struct from the fields that lie in it.
. arena = builder.function.arena
. root = root-of(operand) - 1
. base = offset-of(operand)
. size = tables.layouts.rows[layout].size
. count = builder.struct-parts(mir-type(layout))
. words = new-id-list(arena, count)
. first = root-first[root]
. reg-class = builder.type-reg-class(builder.part-types[0])
if reg-class == .fpr32 || reg-class == .fpr64
    for leaf in first .. < first + root-count[root]
        . spot = leaf-offsets[leaf]
        if spot >= base && spot < base + size
            . member = builder.new-vreg(reg-class)
            builder.load
                - builder.vreg-operand(member)
                - leaf-cells[leaf]
                - mir-type(leaf-layouts[leaf])
            words = words.appended(arena, member)
    = words
for index in 0 .. < count
    . word = no-operand
    for leaf in first .. < first + root-count[root]
        . spot = leaf-offsets[leaf]
        if spot >= base && spot < base + size && (spot - base) / 8 == index
            . part = leaf-layouts[leaf]
            . width = tables.layouts.rows[part].size
            . bits = ((spot - base) % 8) * 8
            . piece = builder.vreg(.gpr64)
            if width == 8
                builder.load(piece, leaf-cells[leaf], mir-type(part))
            else
                . held = new-value(part, false)
                builder.load(held, leaf-cells[leaf], mir-type(part))
                extend(piece, held, width, false)
            if bits != 0
                . shifted = builder.vreg(.gpr64)
                builder.asm(.lsl, shifted, piece, builder.small-int(bits))
                piece = shifted
            if word == no-operand
                word = piece
            else
                . joined = builder.vreg(.gpr64)
                builder.asm(.orr, joined, word, piece)
                word = joined
    . member = builder.new-vreg(.gpr64)
    builder.mov(builder.vreg-operand(member), word)
    words = words.appended(arena, member)
= words

────────────────────
_ do split-leaf U32
    - operand Operand
    - offset U32

if !is-split(operand)
    = U32.max
. root = root-of(operand) - 1
. spot = offset-of(operand) + offset
. first = root-first[root]
for leaf in first .. < first + root-count[root]
    if leaf-offsets[leaf] == spot
        = leaf
= U32.max

────────────────────
_ do copy-split
    - ir IRFunction
    - target Operand
    - source Operand
    - layout LayoutId

. size = tables.layouts.rows[layout].size
. target-split = is-split(target)
. source-split = is-split(source)
. split = if target-split then target else source
. root = root-of(split) - 1
. base = offset-of(split)
. target-base = no-operand
. source-base = no-operand
if !target-split
    target-base = materialize(ir, target)
if !source-split
    source-base = materialize(ir, source)
. first = root-first[root]
for leaf in first .. < first + root-count[root]
    . spot = leaf-offsets[leaf]
    if spot >= base && spot < base + size
        . inside = spot - base
        . part = leaf-layouts[leaf]
        . type = mir-type(part)
        . held = new-value(part, false)
        if source-split
            builder.load(held, leaf-cells[split-leaf(source, inside)], type)
        else
            builder.load(held, builder.load-address-offset(source-base, inside), type)
        if target-split
            builder.store(leaf-cells[split-leaf(target, inside)], held, type)
        else
            builder.store(builder.load-address-offset(target-base, inside), held, type)

────────────────────
_ do zero-split
    - operand Operand
    - layout LayoutId

. size = tables.layouts.rows[layout].size
. root = root-of(operand) - 1
. base = offset-of(operand)
. first = root-first[root]
for leaf in first .. < first + root-count[root]
    . spot = leaf-offsets[leaf]
    if spot >= base && spot < base + size
        . part = leaf-layouts[leaf]
        . zero = no-operand
        if is-float(part)
            zero = materialize-float(part as MachineKind, 0)
        else
            zero = materialize-integer(part as MachineKind, 0)
        builder.store(leaf-cells[leaf], zero, mir-type(part))

────────────────────
_ do lower-load-task-panic
    - id ValueId

. value = new-value(managed-layout, false)
values[id] = value
heaps[id] = 1
builder.ldr(value, task-panic-address())

────────────────────
_ do lower-load-task-word
    - id ValueId
    - row IRInstruction

` Reads a word of the task's context, at the offset the instruction gives.
. value = new-value(row.layout, false)
values[id] = value
builder.ldr(value, builder.load-address-offset(builder.preg(task-context-register), row.aux))

────────────────────
_ do lower-load-panic-signal

` Reads the active panic into the panic signal, where the branch that follows tests it.
builder.ldr(builder.preg(panic-signal-register), task-panic-address())

────────────────────
_ do task-panic-address OperandId

` Where the task's context holds the active panic.
= builder.load-address-offset(builder.preg(task-context-register), 0)

────────────────────
_ do materialize OperandId
    - ir IRFunction
    - operand Operand

` The register holding an operand's value. A constant, an integer and an address are built
` where they are used.
. payload = operand-payload(operand)
do match operand-kind(operand)
    |= .operand-value
        = values[payload]
    |= .operand-argument
        = arguments[payload]
    |= .operand-constant
        = builder.literal-address(payload, true)
    |= .operand-number
        . number = ir.numbers[payload]
        if number.kind == .machine-f32 || number.kind == .machine-f64
            = materialize-float(number.kind, number.bits)
        = materialize-integer(number.kind, number.bits)
    |= .operand-symbol
        = symbol-address(payload)
    |= .operand-descriptor
        = symbol-address(descriptor-of(payload))
    |= .operand-buffer-descriptor
        mark(.buffer-mark, payload)
        = symbol-address(tables.layouts.rows[payload].buffer)
    |= .operand-result
        = result
    |= .operand-panic-signal
        = builder.preg(panic-signal-register)
    ?! Panic("An operand of this kind has no value to put in a register")
= no-operand

────────────────────
_ do symbol-address OperandId
    - name StringId

= builder.symbol-address(builder.symbol(name))

────────────────────
_ do materialize-integer OperandId
    - kind MachineKind
    - bits U64

` An integer in a new register, in the fewest instructions. One whose half-words are all zero
` but one is a MOVZ of it. Else one a single move can make, by a MOVN or by a bitmask, is that
` move. Else it starts from zeros or from ones, whichever leaves fewer half-words to differ: its
` lowest half-word that differs, then a MOVK of each other one that does. The null of a managed
` pointer is a GC root like any value of its kind.
. is-managed = kind == .machine-managed-pointer
. is-wide = is-managed || kind == .machine-pointer || kind == .machine-u64 || kind == .machine-i64
. reg-class = if is-wide then RegClass.gpr64 else RegClass.gpr32
. value = builder.vreg-operand(builder.new-vreg(reg-class, no-register, is-managed))
. width U32 = if is-wide then 64 else 32
. whole = if is-wide then bits else bits /and/ 0xffffffff
. zeros U32
. ones U32
. shift U32
while shift < width
    . chunk = (whole /zrshift/ shift) /and/ 0xffff
    if chunk != 0
        zeros += 1
    if chunk != 0xffff
        ones += 1
    shift += 16
if zeros > 1 && (encode-move-wide-immediate(whole, width).is-encodable || encodes-logical)
    builder.asm(.mov, value, builder.small-int(whole as I64))
    = value
.. encodes-logical = encode-logical-immediate(whole, width).is-encodable
. negated = ones < zeros
. filler U64 = if negated then 0xffff else 0
. first U32
shift = 0
while shift < width
    if ((whole /zrshift/ shift) /and/ 0xffff) != filler
        first = shift
        break
    shift += 16
. low = (whole /zrshift/ first) /and/ 0xffff
if negated
    builder.asm
        - .movn
        - value
        - builder.small-int((low /xor/ 0xffff) as I64)
        - builder.small-int(first)
else
    builder.asm(.movz, value, builder.small-int(low as I64), builder.small-int(first))
shift = 0
while shift < width
    . chunk = (whole /zrshift/ shift) /and/ 0xffff
    if shift != first && chunk != filler
        builder.asm(.movk, value, builder.small-int(chunk as I64), builder.small-int(shift))
    shift += 16
= value

────────────────────
_ do materialize-float OperandId
    - kind MachineKind
    - bits U64

` A float in a new register: its bits built as an integer and moved across.
. is-wide = kind == .machine-f64
. held = if is-wide then MachineKind.machine-u64 else MachineKind.machine-u32
. whole-bits = materialize-integer(held, bits)
. value = builder.vreg(if is-wide then RegClass.fpr64 else RegClass.fpr32)
builder.fmov(value, whole-bits)
= value

────────────────────
_ do move
    - dest OperandId
    - src OperandId
    - layout LayoutId

` Moves a value of a layout from one register to another of its class.
if is-float(layout)
    builder.fmov(dest, src)
else
    builder.mov(dest, src)

────────────────────
_ do is-heap Bool
    - ir IRFunction
    - operand Operand

` Whether an operand is a managed pointer or an address inside an object.
. payload = operand-payload(operand)
do match operand-kind(operand)
    |= .operand-value
        = heaps[payload] != 0
    |= .operand-argument
        = ir.arguments[payload] == managed-layout
    ??
        = false
= false

────────────────────
_ do new-value OperandId
    - layout LayoutId
    - inside Bool

` A new register for a value of a layout. One that holds a managed pointer, or an address
` inside an object, is a GC root. One that holds the address of a struct outside the heap is
` a root by that address when the struct holds managed pointers.
if layout == managed-layout || inside
    = builder.vreg-operand(builder.new-vreg(.gpr64, no-register, true))
. descriptor = stack-descriptor(layout)
if descriptor != no-string
    = builder.vreg-operand(builder.new-vreg(.gpr64, no-register, true, descriptor, .address-root))
= builder.vreg(layout-class(layout))

────────────────────
_ do stack-descriptor StringId
    - layout LayoutId

` The descriptor of a struct that holds managed pointers, marked as one the object needs.
. name = tables.layouts.stack-descriptor(layout)
if name != no-string
    mark(.used-mark, layout)
= name

────────────────────
_ do descriptor-of StringId
    - layout LayoutId

mark(.used-mark, layout)
= tables.layouts.rows[layout].descriptor

────────────────────
+ do mark
    - kind LoweringMark
    - value U32

` Marks a layout or a plain site for the merge, as lowering the current function does.
do match kind
    |= .used-mark
        used[value] = 1
    |= .buffer-mark
        buffers[value] = 1
    |= .allocated-mark
        allocated[value] = 1
    |= .plain-mark
        plain-allocated[value] = 1
marks += packed-mark(kind, value)

────────────────────
_ do mir-type MIRTypeId
    - layout LayoutId

` The MIR type of a layout. A struct's type is built once for the function.
if layout < first-struct-layout
    = scalar-type(layout)
for index in 0 .. < struct-layouts.length
    if struct-layouts[index] == layout
        = struct-types[index]
. function = builder.function
. arena = function.arena
. row = tables.layouts.rows[layout]
. children = new-id-list(arena, row.fields.count)
for position in row.fields.start .. < row.fields.end
    children = children.appended(arena, mir-type(tables.layouts.fields[position].layout))
. start U32 = function.struct-fields.length as U32
for index in 0 .. < children.length
    . field = tables.layouts.fields[row.fields.start + index]
    function.struct-fields.append(StructField(children[index], field.offset))
. id MIRTypeId = function.types.length as MIRTypeId
function.types.append
    - MIRStructType(row.size, row.alignment, row.format, Span(start, row.fields.count))
struct-layouts = struct-layouts.appended(arena, layout)
struct-types = struct-types.appended(arena, id)
= id

────────────────────
_ scalar-type MIRTypeId
    - layout LayoutId

match layout
    |= void-layout
        void-type-id
    |= u8-layout
        u8-type-id
    |= i8-layout
        i8-type-id
    |= u16-layout
        u16-type-id
    |= i16-layout
        i16-type-id
    |= u32-layout
        u32-type-id
    |= i32-layout
        i32-type-id
    |= u64-layout
        u64-type-id
    |= i64-layout
        i64-type-id
    |= f32-layout
        f32-type-id
    |= f64-layout
        f64-type-id
    ??
        pointer-type-id

────────────────────
_ layout-class RegClass
    - layout LayoutId

|? layout == f32-layout
    RegClass.fpr32
|? layout == f64-layout
    RegClass.fpr64
|? layout >= u8-layout && layout <= i32-layout
    RegClass.gpr32
??
    RegClass.gpr64

────────────────────
_ is-float Bool
    - layout LayoutId

layout == f32-layout || layout == f64-layout

────────────────────
_ is-narrow-integer Bool
    - layout LayoutId

size > 0 && size < 4 && !is-float(layout) && !tables.layouts.is-struct(layout)

.. size = tables.layouts.rows[layout].size

────────────────────
_ is-signed Bool
    - layout LayoutId

layout == i8-layout || layout == i16-layout || layout == i32-layout || layout == i64-layout

────────────────────
_ do location LocId
    - ir IRFunction
    - row IRInstruction

. owner = tables.functions[ir.function]
if row.line == 0 || owner.placeless
    = no-loc
. module = if owner.site-module == U32.max then owner.module else owner.site-module
. file = tables.module-paths[if row.module == U32.max then module else row.module]
= builder.add-loc(MIRLoc(file, true, row.line as I32, row.column as I32, 0, 0))

────────────────────
+ do build-process-main
    - id FunctionId

` The C `main` the linker enters, built as machine code that needs no lowering: it saves the
` arguments, runs the task main on the event loop, which runs `threadinit` as each thread
` starts and `taskinit` as each task that native code starts begins, and exits with the process's
` exit code. Where probes compile, the event loop runs the task that closes their record once
` the others are done, and flushes what each thread wrote of them as it stops.
. function = builder.function
. row = tables.functions[id]
. task-main = tables.functions[tables.calls[row.calls.start]].symbol
function.is-lowered = true
builder.set-insert-block(builder.add-block(tables.bundle.entry-name))
builder.bl(builder.symbol(tables.runtime-symbol(.runtime-save-args)))
builder.bl(builder.symbol(tables.runtime-symbol(.runtime-validate-allocation-abi)))
. entry = builder.preg(10)
builder.adrp(entry, builder.label(task-main, .page-reloc))
builder.add(entry, entry, builder.label(task-main, .pageoff-reloc))
. closer = builder.preg(11)
if tables.probe-closer == no-function
    builder.mov(closer, builder.small-int(0))
else
    . closer-symbol = tables.functions[tables.probe-closer].symbol
    builder.adrp(closer, builder.label(closer-symbol, .page-reloc))
    builder.add(closer, closer, builder.label(closer-symbol, .pageoff-reloc))
. thread-init = builder.preg(12)
if tables.thread-init == no-function
    builder.mov(thread-init, builder.small-int(0))
else
    . init-symbol = tables.functions[tables.thread-init].symbol
    builder.adrp(thread-init, builder.label(init-symbol, .page-reloc))
    builder.add(thread-init, thread-init, builder.label(init-symbol, .pageoff-reloc))
. thread-flush = builder.preg(13)
if tables.probe-flush == no-function
    builder.mov(thread-flush, builder.small-int(0))
else
    . flush-symbol = tables.functions[tables.probe-flush].symbol
    builder.adrp(thread-flush, builder.label(flush-symbol, .page-reloc))
    builder.add(thread-flush, thread-flush, builder.label(flush-symbol, .pageoff-reloc))
. task-init = builder.preg(14)
if tables.task-init == no-function
    builder.mov(task-init, builder.small-int(0))
else
    . init-symbol = tables.functions[tables.task-init].symbol
    builder.adrp(task-init, builder.label(init-symbol, .page-reloc))
    builder.add(task-init, task-init, builder.label(init-symbol, .pageoff-reloc))
builder.mov(builder.preg(0), entry)
builder.mov(builder.preg(1), closer)
builder.mov(builder.preg(2), builder.small-int(0))
builder.mov(builder.preg(3), builder.small-int(tables.task-local-size))
builder.mov(builder.preg(4), thread-init)
builder.mov(builder.preg(5), thread-flush)
builder.mov(builder.preg(6), builder.small-int(tables.thread-local-size))
builder.mov(builder.preg(7), task-init)
builder.bl(builder.symbol(tables.runtime-symbol(.runtime-run-event-loop)))
builder.bl(builder.symbol(tables.runtime-symbol(.runtime-process-exit-code)))
builder.bl(builder.symbol(tables.runtime-symbol(.runtime-exit)))

━━━━━━━━━━━━━━━━━━━━
_ do bit-length U64
    - value U64

. width U64
. rest = value
while rest != 0
    rest = rest /zrshift/ 1
    width += 1
= width

━━━━━━━━━━━━━━━━━━━━
+ mark-kind LoweringMark
    - packed U32

(packed /zrshift/ mark-shift) as LoweringMark

━━━━━━━━━━━━━━━━━━━━
+ mark-value U32
    - packed U32

packed /and/ mark-mask

━━━━━━━━━━━━━━━━━━━━
+ packed-mark U32
    - kind LoweringMark
    - value U32

((kind as U32) /lshift/ mark-shift) /or/ value
