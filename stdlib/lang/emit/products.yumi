/core/_bytes
/lang/ast/ast
/lang/ast/ast-children
/lang/ast/ast-nodes
/lang/ast/module
/lang/ast/operator
/lang/ast/program
/lang/ast/row-range
/lang/check/type-store
/lang/check/types
/lang/report/facts-text
/lang/target
/os/env
/os/file
/os/path

_ document-type-name = "DocumentType"
_ document-ranks [String] = ["owner", "default", "alternate", "none"]

━━━━━━━━━━━━━━━━━━━━
+ AppProduct is Tuple

+ id String
+ name String
+ version String?
+ icon Path?
+ shows-in-dock Bool
+ document-types [AppDocumentType]

━━━━━━━━━━━━━━━━━━━━
+ AppDocumentType is Tuple

+ name String
+ extensions [String]
+ content-types [String]
+ rank String?

━━━━━━━━━━━━━━━━━━━━
+ ProductError is Error

────────────────────
+ This
    - message String

━━━━━━━━━━━━━━━━━━━━
+ do read-product AppProduct? ?! ProductError
    - program Program
    - types Types
    - target Target

` Reads the app the program declares for a target, as an element of the target's product class.
` Products declared for other targets are left for those targets, and a target without a product
` class has none.
. module-name = target.product-module-name
. class-name = target.product-class-name
if !module-name || !class-name
    = null
. module = program.module-by-name(module-name)
if !module
    = null
. reader = ProductReader(program, types, module as ModuleId, class-name)
= reader.read()

━━━━━━━━━━━━━━━━━━━━
_ ProductReader

_ program Program
_ types Types
_ product-module ModuleId
_ class-name String

────────────────────
+ This
    - program
    - types
    - product-module
    - class-name

────────────────────
+ do read AppProduct? ?! ProductError

. product-class = types.nearest-class(product-module, program.store-atom(class-name), 0, false)
if !product-class
    = null
. product AppProduct? = null
for position in 0 .. < program.modules.length
    . module = position as ModuleId
    if names-class(module, product-class)
        . found = read-module(module)
        if found && module == program.entry-module && !program.is-batch
            product = found
= product

────────────────────
_ do names-class Bool
    - module ModuleId
    - target DeclRef

. found = types.nearest-class(module, program.store-atom(class-name), 0, false)
= found && found.module == target.module && found.decl == target.decl

────────────────────
_ do read-module AppProduct? ?! ProductError
    - module ModuleId

. tree = program.modules[module].tree
. first SyntaxId = 0
. first-type SyntaxId = 0
for position in 1 .. < tree.nodes.length
    . element = position as SyntaxId
    . type-id = product-type(tree, element)
    if type-id == 0
        continue
    ?! ProductError(problem(module, type-id, "A $class-name is declared at the top level of the program's main module, where the compiler reads it to build the app bundle"))
        if !is-root(module) || !is-statement(tree, element)
    if first != 0
        . second = problem(module, type-id, "A program has one $class-name, and this is its second")
        ?! ProductError("$second\n$first-place")
        .. first-place = related-text(program, module, first-type, "Its first product")
    first = element
    first-type = type-id
if first == 0
    = null
= app-product(module, tree, first, first-type)

────────────────────
_ do product-type SyntaxId
    - tree AST
    - element SyntaxId

do match? tree.nodes[element]
    | .node-markup(row)
        do match? tree.nodes[row.type-id]
            | .node-type-identifier(type)
                if type.name.text == class-name
                    = row.type-id
= 0

────────────────────
_ do is-root Bool
    - module ModuleId

if !program.is-batch
    = module == program.entry-module
for root in program.batch-roots
    if root == module
        = true
= false

────────────────────
_ do is-statement Bool
    - tree AST
    - element SyntaxId

do match? tree.nodes[tree.root]
    | .node-top-level-syntax(top)
        for statement in tree.children[top.statements]
            if statement == element
                = true
= false

────────────────────
_ do app-product AppProduct ?! ProductError
    - module ModuleId
    - tree AST
    - element SyntaxId
    - type-id SyntaxId

. id String? = null
. name String? = null
. version String? = null
. icon Path? = null
. shows-in-dock Bool? = null
. document-types [AppDocumentType]
do match? tree.nodes[element]
    | .node-markup(row)
        ?! ProductError(problem(module, type-id, "A $class-name takes no arguments or style rules"))
            if row.args.count != 0 || row.style-rule-applications.count != 0
        for statement in tree.children[body-statements(tree, row.body)]
            do match? tree.nodes[statement]
                | .node-assign(assignment)
                    . property = property-name(module, tree, assignment, class-name)
                    . is-set = match property
                        |= "id"
                            id != null
                        |= "name"
                            name != null
                        |= "version"
                            version != null
                        |= "icon"
                            icon != null
                        |= "shows-in-dock"
                            shows-in-dock != null
                        ??
                            false
                    ?! ProductError(problem(module, assignment.lhs, "$class-name's $property is set twice"))
                        if is-set
                    if property == "id"
                        id = string-value(module, tree, assignment.rhs, class-name, property)
                        ?! ProductError(problem(module, assignment.rhs, "$class-name's id uses only letters, digits, hyphens and periods"))
                            if !is-bundle-id(id)
                    else if property == "name"
                        name = string-value(module, tree, assignment.rhs, class-name, property)
                        ?! ProductError(problem(module, assignment.rhs, "$class-name's name names the app bundle, so it is not empty and has no /"))
                            if name.length == 0 || name.find("/") != null
                    else if property == "version"
                        version = string-value(module, tree, assignment.rhs, class-name, property)
                    else if property == "icon"
                        icon = icon-path(module, tree, assignment.rhs)
                    else if property == "shows-in-dock"
                        shows-in-dock = bool-value
                            - module
                            - tree
                            - assignment.rhs
                            - class-name
                            - property
                    else
                        ?! ProductError(problem(module, assignment.lhs, "$class-name has no property $property"))
                    continue
                | .node-markup(child)
                    document-types += document-type(module, tree, child)
                    continue
            ?! ProductError(problem(module, statement, "A $class-name holds only property assignments and DocumentType elements"))
?! ProductError(problem(module, type-id, "A $class-name needs an id"))
    if !id
?! ProductError(problem(module, type-id, "A $class-name needs a name"))
    if !name
= AppProduct(id, name, version, icon, shows-in-dock ?? true, document-types)

────────────────────
_ do document-type AppDocumentType ?! ProductError
    - module ModuleId
    - tree AST
    - row ASTMarkup

. name String? = null
. extensions [String]? = null
. content-types [String]? = null
. rank String? = null
?! ProductError(problem(module, row.type-id, "A DocumentType takes no arguments or style rules"))
    if row.args.count != 0 || row.style-rule-applications.count != 0
for statement in tree.children[body-statements(tree, row.body)]
    do match? tree.nodes[statement]
        | .node-assign(assignment)
            . property = property-name(module, tree, assignment, document-type-name)
            ?! ProductError(problem(module, assignment.lhs, "DocumentType's $property is set twice"))
                if (property == "name" && name) || (property == "extensions" && extensions) || (property == "content-types" && content-types) || (property == "rank" && rank)
            if property == "name"
                name = string-value(module, tree, assignment.rhs, document-type-name, property)
            else if property == "extensions"
                extensions = string-list(module, tree, assignment.rhs, document-type-name, property)
            else if property == "content-types"
                content-types = string-list
                    - module
                    - tree
                    - assignment.rhs
                    - document-type-name
                    - property
            else if property == "rank"
                rank = string-value(module, tree, assignment.rhs, document-type-name, property)
                ?! ProductError(problem(module, assignment.rhs, "DocumentType's rank is one of ${", ".join(document-ranks)}"))
                    if !(rank is in document-ranks)
            else
                ?! ProductError(problem(module, assignment.lhs, "DocumentType has no property $property"))
            continue
    ?! ProductError(problem(module, statement, "A DocumentType holds only property assignments"))
?! ProductError(problem(module, row.type-id, "A DocumentType needs a name"))
    if !name
. listed = extensions ?? List'String()
. typed = content-types ?? List'String()
?! ProductError(problem(module, row.type-id, "A DocumentType needs at least one extension or content type"))
    if listed.length == 0 && typed.length == 0
= AppDocumentType(name, listed, typed, rank)

────────────────────
_ do body-statements RowRange'SyntaxId
    - tree AST
    - body SyntaxId

do match? tree.nodes[body]
    | .node-block(block)
        = block.body
= RowRange'SyntaxId()

────────────────────
_ do property-name String ?! ProductError
    - module ModuleId
    - tree AST
    - assignment ASTAssign
    - owner String

?! ProductError(problem(module, assignment.lhs, "$owner's properties are set with ="))
    if assignment.op != .eq-op
do match? tree.nodes[assignment.lhs]
    | .node-identifier(target)
        = target.name.text
?! ProductError(problem(module, assignment.lhs, "A $owner sets only its own properties"))

────────────────────
_ do string-value String ?! ProductError
    - module ModuleId
    - tree AST
    - value SyntaxId
    - owner String
    - property String

do match? tree.nodes[value]
    | .node-string-syntax(literal)
        = owned(literal.text)
?! ProductError(problem(module, value, "$owner's $property must be a literal: the compiler reads it to build the app bundle, and a computed value exists only when the program runs"))

────────────────────
_ bool-value Bool ?! ProductError
    - module ModuleId
    - tree AST
    - value SyntaxId
    - owner String
    - property String

match identifier
    |= "true"
        true
    |= "false"
        false
    ?! ProductError(problem(module, value, "$owner's $property must be true or false: the compiler reads it to build the app bundle, and a computed value exists only when the program runs"))

.. identifier = match? tree.nodes[value]
    | .node-identifier(literal)
        literal.name.text

────────────────────
_ do string-list [String] ?! ProductError
    - module ModuleId
    - tree AST
    - value SyntaxId
    - owner String
    - property String

do match? tree.nodes[value]
    | .node-list-syntax(list)
        . items [String]
        for item in tree.children[list.items]
            items += string-value(module, tree, item, owner, property)
        = items
?! ProductError(problem(module, value, "$owner's $property must be a list of literals: the compiler reads it to build the app bundle, and a computed value exists only when the program runs"))

────────────────────
_ do icon-path Path ?! ProductError
    - module ModuleId
    - tree AST
    - value SyntaxId

. text = string-value(module, tree, value, class-name, "icon")
. path = if text.starts-with("/") then Path(text) else module-directory(module) / text
?! ProductError(problem(module, value, "$class-name's icon is a .png or .icns file"))
    if path.ext != "png" && path.ext != "icns"
?! ProductError(problem(module, value, "$class-name's icon ${path as String} does not exist"))
    if !path.is-file
. bytes = read-file-bytes(path)
    catch error Error
        ?! ProductError(problem(module, value, "$class-name's icon ${path as String} cannot be read: $error.message"))
if path.ext == "icns"
    ?! ProductError(problem(module, value, "$class-name's icon $path-text is not an icns file"))
        if !is-icns(bytes)
    .. path-text = path as String
    = path
?! ProductError(problem(module, value, "$class-name's icon ${path as String} is not a PNG image"))
    if !is-png(bytes)
. width = big-endian(bytes, 16)
. height = big-endian(bytes, 20)
?! ProductError(problem(module, value, "$class-name's icon is square, and ${path as String} is ${width}x${height}"))
    if width != height
= path

────────────────────
_ do is-bundle-id Bool
    - text String

if text.length == 0
    = false
for char in text
    if !(is-letter || (char >= '0' && char <= '9') || char == '-' || char == '.')
        = false
    .. is-letter = (char >= 'a' && char <= 'z') || (char >= 'A' && char <= 'Z')
= true

────────────────────
_ module-directory Path
    - module ModuleId

|? path.length == 0
    Path(cwd())
??
    Path(path).dir

.. path = program.modules[module].path

────────────────────
_ problem String
    - module ModuleId
    - syntax SyntaxId
    - message String

diagnostic-text(program, module, syntax, message)

━━━━━━━━━━━━━━━━━━━━
_ is-png Bool
    - bytes Byte[]

bytes.length >= 24 && bytes[0] == 137 && bytes[1] == 80 && bytes[2] == 78 && bytes[3] == 71 && bytes[12] == 73 && bytes[13] == 72 && bytes[14] == 68 && bytes[15] == 82

━━━━━━━━━━━━━━━━━━━━
_ is-icns Bool
    - bytes Byte[]

bytes.length >= 8 && bytes[0] == 105 && bytes[1] == 99 && bytes[2] == 110 && bytes[3] == 115

━━━━━━━━━━━━━━━━━━━━
_ big-endian U32
    - bytes Byte[]
    - offset Size

high-half /or/ ((bytes[offset + 2] as U32) /lshift/ 8) /or/ (bytes[offset + 3] as U32)

.. high-half = ((bytes[offset] as U32) /lshift/ 24) /or/ ((bytes[offset + 1] as U32) /lshift/ 16)

━━━━━━━━━━━━━━━━━━━━
_ owned String
    - text String

byte-view(text).slice-string()
