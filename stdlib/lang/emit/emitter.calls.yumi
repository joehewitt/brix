━━━━━━━━━━━━━━━━━━━━
_ Calls is facet of FunctionEmitter
    sees Assignments
    sees Cleanups
    sees Comprehensions
    sees LiveActions
    sees Markup
    sees MatchArms
    sees Styles
    sees Tables

────────────────────
_ links-into Bool
    - id SyntaxId
    - given TypeId
    - expected TypeId

` Whether a value of type `given` is what a link of an optional chain gives by itself, where
` its node has the optional that holds it.
is-link(id) && types.is-optional(expected) && types.optional-inner(expected) == given

────────────────────
_ do run-case-owner
    - callable SyntaxId

` What is run before a case called after its type is made: the type, when it is more than a
` name. A case called by its symbol alone runs nothing.
do match? tree.nodes[callable]
    | .node-get-expression(get)
        run-type-operand(get.object)

────────────────────
+ do emit-call-at Typed
    - id SyntaxId
    - callable SyntaxId
    - operands RowRange'SyntaxId
    - piped SyntaxId = 0

. pulled = facts.pulls(unit.reading, id)
=? emit-call(id, callable, operands, piped) if facts.plan-of(unit.reading, id) != .plan-live-call && !pulled
. live = instances.live
if live.enter == no-instance || live.leave == no-instance || live-actions.length == 0
    refuse(.refused-expression, id)
    = Typed(make-operand(.operand-void, 0), no-type)
. mark = pending.length
pending += load-local(live-actions[live-actions.length - 1].previous, id)
pending += load-local(live-actions[live-actions.length - 1].next, id)
do call-instance(live.enter, id, mark)
. opened = open-cleanups.length
. own-scoping = scoping
scoping = scoping.block-base = opened
open-cleanup(id, UseCell(no-local, no-local, no-type, true))
= close-value(emit-call(id, callable, operands, piped), opened, own-scoping, id)

────────────────────
+ do emit-call Typed
    - id SyntaxId
    - callable SyntaxId
    - operands RowRange'SyntaxId
    - piped SyntaxId = 0

` A call written with its arguments: of a C function, or the one call the type pass recorded
` at the node, of a function, a static, a constructor, or a method of the value written
` before its name. A value piped into the call is its last argument. A write to an event
` publishes to it.
if facts.plan-of(unit.reading, id) == .plan-built-feeds
    = emit-listed-feeds(id, tree.listed-feeds(id))
do match? tree.nodes[callable]
    | .node-c-identifier
        if piped == 0 && own-call(id) == no-fact && is-binding(facts.node-type(unit.reading, id))
            = emit-bind(id, callable, operands)
        if piped == 0
            = emit-c-call(id, operands)
if facts.event-uses.length != 0 && piped == 0
    . used = tables.event-use-of(unit.reading, id)
    if used && used.kind == .event-publish
        = emit-publish(id, used, operands)
    if used && used.kind == .event-route
        = emit-route(id, used, operands)
    if used && (used.kind == .event-rekey || used.kind == .event-release)
        = emit-readdress(id, used, operands)
. plan = facts.plan-of(unit.reading, id)
if plan == .plan-relation || plan == .plan-relation-cast
    do match? tree.nodes[callable]
        | .node-get-expression(get)
            if piped == 0
                = emit-relation(id, plan, get.object, operands)
    refuse(.refused-expression, id)
    = Typed(make-operand(.operand-void, 0), no-type)
if (plan == .plan-case || plan == .plan-case-fields) && piped == 0
    run-case-owner(callable)
    = emit-case(id, operands, plan == .plan-case-fields)
if plan == .plan-forward
    do match? tree.nodes[callable]
        | .node-get-expression(get)
            if piped == 0
                = emit-forward(id, get.object, operands)
    refuse(.refused-expression, id)
    = Typed(make-operand(.operand-void, 0), no-type)
if plan == .plan-table
    do match? tree.nodes[callable]
        | .node-get-expression(get)
            if piped == 0
                = emit-table-method(id, get.object, operands)
    refuse(.refused-expression, id)
    = Typed(make-operand(.operand-void, 0), no-type)
if plan == .plan-builder-append || plan == .plan-builder-reserve
    do match? tree.nodes[callable]
        | .node-get-expression(get)
            if piped == 0
                = emit-builder-method(id, get.object, operands, plan == .plan-builder-append)
        | .node-identifier
            if piped == 0
                = emit-builder-method(id, 0, operands, plan == .plan-builder-append)
    refuse(.refused-expression, id)
    = Typed(make-operand(.operand-void, 0), no-type)
. fact = own-call(id)
if fact != no-fact && facts.plan-of(unit.reading, id) == .plan-count-leading-zeros
    if piped == 0 && operands.count == 1
        = emit-leading-zeros(id, facts.calls[fact].callee, tree.children[operands.start])
. side = facts.plan-of(unit.reading, id)
if fact != no-fact && piped == 0 && is-float-math(side)
    = emit-float-math(id, facts.calls[fact], operands, side)
if fact != no-fact && piped == 0 && side-payload
    = emit-side-payload(id, facts.calls[fact].callee, operands, side)
.. side-payload = side == .plan-side-payload || side == .plan-publish-side-payload
if fact != no-fact && piped == 0 && side == .plan-object-from-pointer
    = emit-object-from-pointer(id, facts.calls[fact].callee, operands)
if fact != no-fact && piped == 0 && side == .plan-invoke-lowered
    = emit-invoke-lowered(id, facts.calls[fact].callee, operands)
if fact != no-fact && piped == 0 && side == .plan-witness-pointer
    = emit-witness-pointer(id, facts.calls[fact].callee, operands)
if fact != no-fact && piped == 0 && side == .plan-interface-from-pointer
    = emit-interface-from-pointer(id, facts.calls[fact].callee, operands)
if fact != no-fact && facts.plan-of(unit.reading, id) == .plan-store-untraced
    do match? tree.nodes[callable]
        | .node-get-expression(get)
            if piped == 0
                = emit-store-untraced(id, facts.calls[fact], get.object, operands)
    refuse(.refused-expression, id)
    = Typed(make-operand(.operand-void, 0), no-type)
if fact == no-fact && piped == 0 && facts.plan-of(unit.reading, id) == .plan-tuple
    = emit-tuple(id, operands)
if fact == no-fact && piped == 0 && is-binding(facts.node-type(unit.reading, id))
    = emit-bind(id, callable, operands)
if fact != no-fact && piped == 0 && partial-closure
    = emit-bind(id, callable, operands)
.. partial-closure = facts.calls[fact].is-partial && facts.calls[fact].form == .call-closure
if fact != no-fact && piped == 0 && is-binding(callee-type(callable))
    . row = facts.calls[fact]
    if row.form == .call-function && row.callee != no-instance && has-symbol
        = emit-c-call(id, operands, callable)
    .. has-symbol = tables.c-symbols[row.callee] != no-string
    if row.form == .call-function || row.form == .call-constructor || row.form == .call-method
        = emit-fact-call(id, row, 0, operands, 0, 0, no-type, callable)
    if row.form == .call-closure && row.callee == no-instance
        = emit-value-call(id, callable, operands)
    if row.form == .call-closure
        = emit-closure-call(id, row, callable, operands)
    refuse(.refused-expression, id)
    = Typed(make-operand(.operand-void, 0), no-type)
if fact != no-fact
    . row = facts.calls[fact]
    if row.form == .call-closure && piped == 0 && row.callee == no-instance
        = emit-value-call(id, callable, operands)
    if row.form == .call-closure && piped == 0
        = emit-closure-call(id, row, callable, operands)
    if row.form == .call-function || row.form == .call-static || row.form == .call-constructor
        = emit-fact-call(id, row, 0, operands, piped)
    if row.form == .call-this-constructor
        = emit-fact-call
            - id
            - row
            - if names-slot(callable, .slot-super) then callable else 0
            - operands
            - piped
    if row.form == .call-method && calls-value(row.callee)
        = emit-fact-call(id, row, callable, operands, piped)
    if row.form == .call-method
        do match? tree.nodes[callable]
            | .node-get-expression(get)
                = emit-fact-call(id, row, get.object, operands, piped)
. array = if fact == no-fact && piped == 0 then tables.const-array-row(unit.reading, id) else U32.max
if array != U32.max
    = Typed(make-operand(.operand-symbol, tables.const-array-symbol(array)), facts.const-arrays[array].type)
refuse(.refused-expression, id)
= Typed(make-operand(.operand-void, 0), no-type)

────────────────────
_ do calls-value Bool
    - callee InstanceId

` Whether an instance is of the function a type declares for a call of a value of it, whose
` receiver is what the call names.
if callee == no-instance
    = false
. row = instances.rows[callee]
do match? program.modules[row.module].decls[row.decl]
    | .decl-function(fn)
        = fn.name != null && fn.name == types.call-atom
= false

────────────────────
_ do emit-side-payload Typed
    - id SyntaxId
    - callee InstanceId
    - operands RowRange'SyntaxId
    - plan OperatorPlan

` A call the compiler answers itself through the collector: the payload an object holds in a
` lane, an object of the payload's class or nothing where the lane holds none, or a payload
` published in the lane, which answers the payload the lane then holds. The allocation buffer
` is published first. Each argument takes the conversion recorded for it. An optional that
` holds its flag apart holds a value where the address the collector gives is not null. The
` collector's function is called as TypeScript calls it, with no poll around it and no panic
` read after it.
. nothing = make-operand(.operand-void, 0)
. count U32 = if plan == .plan-side-payload then 2 else 3
if callee == no-instance || operands.count != count || other-arity
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
.. other-arity = instances.signatures[callee].args.count != count
. mark = pending.length
for position in 0 .. < count
    . argument = tree.children[operands.start + position]
    . expression = argument
    do match? tree.nodes[argument]
        | .node-argument(named)
            expression = named.expr
    . value = convert(argument, .reason-argument, emit-expression(expression))
    if value.type != instances.argument-type(callee, position)
        refuse(.refused-conversion, argument)
    pending += value.operand
. type = facts.node-type(unit.reading, id)
. layout = layout-of(type, id)
if plan == .plan-publish-side-payload
    . published = call-runtime(.runtime-publish-side-payload, id, mark, layout)
    = Typed(published, type)
. raw = call-runtime(.runtime-object-side-payload, id, mark, managed-layout)
if !tables.layouts.is-struct(layout)
    = Typed(raw, type)
. held = frame(layout)
put(held, tables.layouts.field(layout, 0), raw, id)
. address = num-cast(id, raw, managed-layout, u64-layout)
put
    - held
    - tables.layouts.field(layout, 1)
    - compare(id, .compare-not-equal, address, integer(.machine-u64, 0))
    - id
= Typed(held, type)

────────────────────
_ do emit-invoke-lowered Typed
    - id SyntaxId
    - callee InstanceId
    - operands RowRange'SyntaxId

` A call the compiler answers itself: the function at the address the first argument holds,
` called with the other two, the address of an object and a payload, and checked for a panic
` as a call of a function's value is.
. nothing = make-operand(.operand-void, 0)
if callee == no-instance || operands.count != 3 || instances.signatures[callee].args.count != 3
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. given [Operand]
for position in 0 .. < 3
    . argument = tree.children[operands.start + position]
    . converted = convert(argument, .reason-argument, emit-expression(expression))
        .. expression = tree.argument-value(argument)
    given += converted.operand
    if converted.type != instances.argument-type(callee, position as U32)
        refuse(.refused-conversion, argument)
. mark = pending.length
pending += given[1]
pending += given[2]
do call(given[0], id, mark, .callee-value, void-layout, !in-landing)
= Typed(nothing, types.void-type)

────────────────────
_ do intrinsic-arguments Bool
    - id SyntaxId
    - callee InstanceId
    - operands RowRange'SyntaxId

` Evaluates the arguments of a call the compiler answers itself onto the pending arguments,
` each with the conversion recorded for it and of the type its parameter takes. False where
` one is refused.
if callee == no-instance || operands.count != instances.signatures[callee].args.count
    refuse(.refused-expression, id)
    = false
for position in 0 .. < operands.count
    . argument = tree.children[operands.start + position]
    . expression = argument
    do match? tree.nodes[argument]
        | .node-argument(named)
            expression = named.expr
    . value = convert(argument, .reason-argument, emit-expression(expression))
    if value.type != instances.argument-type(callee, position)
        refuse(.refused-conversion, argument)
    pending += value.operand
= true

────────────────────
_ do emit-witness-pointer Typed
    - id SyntaxId
    - callee InstanceId
    - operands RowRange'SyntaxId

` A call the compiler answers itself: the address of the witness table a value of an
` interface holds.
. mark = pending.length
if !intrinsic-arguments(id, callee, operands)
    drop-pending(mark)
    = Typed(make-operand(.operand-void, 0), facts.node-type(unit.reading, id))
. value = pending[mark]
drop-pending(mark)
. second = tables.layouts.field(tables.layouts.interface-layout, 1).offset
= Typed(load(value, second, pointer-layout, id), facts.node-type(unit.reading, id))

────────────────────
_ do emit-interface-from-pointer Typed
    - id SyntaxId
    - callee InstanceId
    - operands RowRange'SyntaxId

` A call the compiler answers itself: a value of an interface that holds the object at one
` address and the witness table at the other, the two as the caller vouches they belong.
. mark = pending.length
if !intrinsic-arguments(id, callee, operands)
    drop-pending(mark)
    = Typed(make-operand(.operand-void, 0), facts.node-type(unit.reading, id))
. object = pending[mark]
. table = pending[mark + 1]
drop-pending(mark)
. type = facts.node-type(unit.reading, id)
. layout = layout-of(type, id)
if layout != tables.layouts.interface-layout
    refuse(.refused-conversion, id)
    = Typed(make-operand(.operand-void, 0), no-type)
. made = frame(layout)
store(made, 0, object, false, id)
store(made, tables.layouts.field(layout, 1).offset, table, false, id)
= Typed(made, type)

────────────────────
_ do emit-object-from-pointer Typed
    - id SyntaxId
    - callee InstanceId
    - operands RowRange'SyntaxId

` A call the compiler answers itself: the object of a class at the address a pointer holds,
` its bits as they are. The argument takes the conversion recorded for it.
. nothing = make-operand(.operand-void, 0)
if callee == no-instance || operands.count != 1 || instances.signatures[callee].args.count != 1
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. argument = tree.children[operands.start]
. expression = argument
do match? tree.nodes[argument]
    | .node-argument(named)
        expression = named.expr
. value = convert(argument, .reason-argument, emit-expression(expression))
if value.type != instances.argument-type(callee, 0)
    refuse(.refused-conversion, argument)
. type = facts.node-type(unit.reading, id)
. source = layout-of(value.type, id)
. layout = layout-of(type, id)
if !is-pointer(source) || !is-pointer(layout)
    refuse(.refused-conversion, id)
    = Typed(nothing, no-type)
= Typed(num-cast(id, value.operand, source, layout), type)

────────────────────
_ do emit-leading-zeros Typed
    - id SyntaxId
    - callee InstanceId
    - argument SyntaxId

` A call the compiler answers itself: how many of an integer's highest bits are zero. The
` argument takes the conversion recorded for it, and the count has the node's type.
. nothing = make-operand(.operand-void, 0)
. expression = argument
do match? tree.nodes[argument]
    | .node-argument(named)
        expression = named.expr
. value = convert(argument, .reason-argument, emit-expression(expression))
if callee == no-instance || value.type != instances.argument-type(callee, 0)
    refuse(.refused-conversion, argument)
    = Typed(nothing, no-type)
. given = layout-of(value.type, argument)
. type = facts.node-type(unit.reading, id)
. layout = layout-of(type, id)
if !is-integer(given) || !is-integer(layout) || tables.layouts.rows[layout].size < 4
    refuse(.refused-type, id)
    = Typed(nothing, no-type)
. bits = types.completions[value.type].bit-size
. start U32 = ir.operands.length
ir.add-operand(value.operand)
= Typed(make-operand(.operand-value, append(.op-count-leading-zeros, id, Span(start, 1), bits, layout)), type)

────────────────────
_ do emit-float-math Typed
    - id SyntaxId
    - call CallFact
    - operands RowRange'SyntaxId
    - plan OperatorPlan

` A call the compiler answers itself: the square root or absolute value of a float, or the
` lesser or greater of two. Each argument is written in its parameter's place and takes the
` conversion recorded for it.
. nothing = make-operand(.operand-void, 0)
. callee = call.callee
if callee == no-instance || call.is-partial || call.fills.count != operands.count
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
if instances.signatures[callee].args.count != operands.count
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
for position in 0 .. < call.fills.count
    if facts.call-fills[call.fills.start + position] as U32 != position
        refuse(.refused-expression, id)
        = Typed(nothing, no-type)
. mark = pending.length
for position in 0 .. < operands.count
    . argument = tree.children[operands.start + position]
    . expression = argument
    do match? tree.nodes[argument]
        | .node-argument(named)
            expression = named.expr
    . value = convert(argument, .reason-argument, emit-expression(expression))
    if value.type != instances.argument-type(callee, position)
        refuse(.refused-conversion, argument)
    pending += value.operand
. type = facts.node-type(unit.reading, id)
. layout = layout-of(type, id)
if layout != f64-layout
    refuse(.refused-type, id)
. start U32 = ir.operands.length
for position in mark .. < pending.length
    ir.add-operand(pending[position])
drop-pending(mark)
. count U32 = ir.operands.length - start
. op = FloatMath.float-sqrt
if plan == .plan-f64-abs
    op = .float-abs
else if plan == .plan-f64-min
    op = .float-min
else if plan == .plan-f64-max
    op = .float-max
= Typed(make-operand(.operand-value, append(.op-float-math, id, Span(start, count), op, layout)), type)

────────────────────
+ do emit-index-call Typed
    - id SyntaxId
    - fact CallFact
    - object SyntaxId
    - index SyntaxId

` An index that a function answers. A type indexed makes what its constructor makes of the
` key. Any other object is the receiver of the function: it is evaluated before the key, and
` a struct that lies in storage is read where the function is called, as the receiver of any
` call is, so it is what evaluating the key left there. Each takes the conversion recorded
` for it. A function that raises answers its value or an error, which leaves the function
` with the call where the type pass says so, as any call's does.
. nothing = make-operand(.operand-void, 0)
if fact.form == .call-constructor || fact.form == .call-this-constructor
    = emit-fact-call(id, fact, 0, RowRange'SyntaxId(), 0, index)
. callee = fact.callee
if callee == no-instance || fact.is-partial || !is-callable(callee)
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
if !fills-in-order(fact, callee, 1) || names-slot(object, .slot-super)
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. receiver = convert(object, .reason-receiver, emit-expression(object))
. receiver-type = receiver.type
. key = convert(index, .reason-argument, emit-expression(index))
if receiver-type != instances.rows[callee].self-type
    refuse(.refused-conversion, object)
    = Typed(nothing, no-type)
if key.type != instances.argument-type(callee, 0)
    refuse(.refused-conversion, index)
    = Typed(nothing, no-type)
. raising = instances.signatures[callee].errors.count != 0
. key-layout = layout-of(key.type, index)
if receiver-type == types.string-type && is-integer(key-layout) && handles-errors
    = emit-string-index(id, fact, callee, receiver.operand, key.operand, key-layout)
.. handles-errors = !raising || fact.propagates
= index-call(id, fact, callee, receiver.operand, key.operand)

────────────────────
_ do index-call Typed
    - id SyntaxId
    - fact CallFact
    - callee InstanceId
    - receiver Operand
    - key Operand

. mark = pending.length
pending += receiver
pending += key
. raising = instances.signatures[callee].errors.count != 0
takes-result = raising
. answer = call-method(callee, id, mark)
takes-result = false
if raising && fact.propagates
    answer = propagate(id, callee, answer.operand)
if !gives(id, answer.type)
    refuse(.refused-conversion, id)
= answer

────────────────────
_ do emit-string-index Typed
    - id SyntaxId
    - fact CallFact
    - callee InstanceId
    - receiver Operand
    - key Operand
    - key-layout LayoutId

` A character of a string read by an integer index, as TypeScript reads one: an ASCII string's
` byte where the index is inside it, and what the function gives anywhere else.
. returned = instances.signatures[callee].returns
. layout = layout-of(returned, id)
if !is-integer(layout)
    = index-call(id, fact, callee, receiver, key)
. held = ir.add-local(layout)
. address = num-cast(id, receiver, managed-layout, u64-layout)
. packed = load
    - arithmetic(id, .arithmetic-subtract, address, integer(.machine-u64, 8), u64-layout)
    - 0
    - u64-layout
    - id
. ascii = bitwise(id, .bitwise-and, packed, integer(.machine-u64, 0x100000000), u64-layout)
. count = bitwise(id, .bitwise-and, packed, integer(.machine-u64, 0xffffffff), u64-layout)
. extended = if tables.layouts.rows[key-layout].size == 8 then key else num-cast(id, key, key-layout, if is-signed(key-layout) then i64-layout else u64-layout)
. wide = if is-signed(key-layout) then num-cast(id, extended, i64-layout, u64-layout) else extended
. checking = ir.reserve-block()
. fast = ir.reserve-block()
. slow = ir.reserve-block()
. joined = ir.reserve-block()
branch(ascii, checking, slow)
ir.start-block(checking)
branch(compare(id, .compare-less, wide, count), fast, slow)
ir.start-block(fast)
. byte = load(arithmetic(id, .arithmetic-add, address, wide, u64-layout), 0, u8-layout, id)
store-local(held, num-cast(id, byte, u8-layout, layout), id)
jump(joined)
ir.start-block(slow)
store-local(held, index-call(id, fact, callee, receiver, key).operand, id)
jump(joined)
ir.start-block(joined)
= Typed(load-local(held, id), returned)

────────────────────
_ do emit-tail Typed
    - id SyntaxId
    - written RowRange'SyntaxId
    - lead U32
    - start Size
    - first U32
    - count U32
    - list-type TypeId
    - piped SyntaxId

` The variadic tail of a call: the arguments written from `first` on, which `given` holds from
` `start + first` on, each converted to the item of the list the call is given, as TypeScript
` converts them once every other argument is, and then a list made of them as a list written
` is made. An argument with a name is first made the tuple of its name and its value. A
` tail with a bullet `•?` is made by appending. A tail that takes a value piped into the call
` has no shape yet.
. nothing = make-operand(.operand-void, 0)
if first < lead || (piped != 0 && first < count)
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. tail = RowRange'SyntaxId(written.start + first - lead, count - first)
for item in tree.children[tail]
    do match? tree.nodes[item]
        | .node-argument(named)
            if named.is-optional
                = append-tail(id, tail, start + first, list-type)
for position in 0 .. < tail.count
    . item = tree.children[tail.start + position]
    . held = start + first + position
    do match? tree.nodes[item]
        | .node-argument(named)
            if named.name
                . paired = name-pair(item, named.name, given[held].operand, given[held].type)
                given[held] = paired
    . converted-2 = convert(item, .reason-element, given[held])
    given[held] = converted-2
= build-list(id, tail, list-type, start + first, false)

────────────────────
_ do append-tail Typed
    - id SyntaxId
    - tail RowRange'SyntaxId
    - start Size
    - list-type TypeId

` A variadic tail with a bullet `•?`, made as TypeScript makes it: the empty list is made, and
` each argument of the tail, which `given` holds from `start` on, is converted to the list's
` item and appended to it by the call recorded at the argument. One with the bullet is
` appended only where it is present, as what it holds: an optional where it holds a value,
` and the tuple of a key and an optional value where the value holds one. Any other with
` the bullet has no shape yet.
. nothing = make-operand(.operand-void, 0)
. makes = no-fact
. fact = facts.first-call(unit.reading, id)
while fact != no-fact
    if facts.calls[fact].form == .call-list-make
        makes = fact
    fact = facts.calls[fact].next
if makes == no-fact
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. list = emit-fact-call(id, facts.calls[makes], 0, RowRange'SyntaxId(), 0, 0, list-type)
if list.type != list-type
    refuse(.refused-conversion, id)
for position in 0 .. < tail.count
    . item = tree.children[tail.start + position]
    . value = given[start + position].operand
    . given-type = given[start + position].type
    . named Atom? = null
    . optional = false
    do match? tree.nodes[item]
        | .node-argument(row)
            named = row.name
            optional = row.is-optional
    if !optional
        . appended = Typed(value, given-type)
        if named
            appended = name-pair(item, named, value, given-type)
        append-item(item, list.operand, list-type, appended)
        continue
    . whole = facts.node-type(unit.reading, item)
    . optional-type = given-type
    . tested = value
    . key = nothing
    . key-type = no-type
    if !named
        . layout = layout-of(given-type, item)
        if !tables.layouts.is-struct(layout) || tables.layouts.rows[layout].fields.count != 2
            refuse(.refused-expression, item)
            = Typed(nothing, no-type)
        . piece = part(value, layout, 0, item)
        key = piece.operand
        key-type = piece.type
        piece = part(value, layout, 1, item)
        tested = piece.operand
        optional-type = piece.type
    if !types.is-optional(optional-type)
        refuse(.refused-expression, item)
        = Typed(nothing, no-type)
    . holds = present(item, Typed(tested, optional-type))
    . taken = ir.reserve-block()
    . passed = ir.reserve-block()
    branch(holds.operand, taken, passed)
    ir.start-block(taken)
    . held = payload(item, Typed(tested, optional-type))
    . inner = held.type
    if named
        held = name-pair(item, named, held.operand, inner)
    else
        held = key-pair(item, whole, key, key-type, held.operand, inner)
    append-item(item, list.operand, list-type, held)
    jump(passed)
    ir.start-block(passed)
= Typed(list.operand, list-type)

────────────────────
_ do append-item
    - item SyntaxId
    - list Operand
    - list-type TypeId
    - value Typed

` Converts an argument of a variadic tail to the list's item, and appends it by the call
` recorded at the argument.
. appended = own-call(item)
if appended == no-fact
    refuse(.refused-expression, item)
    =
. callee = facts.calls[appended].callee
if callee == no-instance || instances.rows[callee].self-type != list-type
    refuse(.refused-expression, item)
    =
. converted = convert(item, .reason-element, value)
if converted.type != instances.argument-type(callee, 0)
    refuse(.refused-conversion, item)
    =
. mark = pending.length
pending += list
pending += converted.operand
call-method(callee, item, mark)

────────────────────
_ do key-pair Typed
    - item SyntaxId
    - pair TypeId
    - key Operand
    - key-type TypeId
    - value Operand
    - given TypeId

` The tuple of a key and what the value written after it holds, of the type the type pass
` kept at the argument.
. layout = layout-of(pair, item)
if !tables.layouts.is-struct(layout) || tables.layouts.rows[layout].fields.count != 2
    refuse(.refused-expression, item)
    = Typed(value, no-type)
if field-type(pair, 0) != key-type || field-type(pair, 1) != given
    refuse(.refused-conversion, item)
    = Typed(value, no-type)
. made = frame(layout)
put(made, tables.layouts.field(layout, 0), key, item)
put(made, tables.layouts.field(layout, 1), value, item)
= Typed(made, pair)

────────────────────
_ do name-pair Typed
    - item SyntaxId
    - name Atom
    - value Operand
    - given TypeId
    - made TypeId = no-type

` The tuple of a name and a value, which an argument of a variadic tail with a name stands
` for, of the type the type pass kept at the argument, or of the type `made`.
. pair = if made != no-type then made else facts.node-type(unit.reading, item)
. layout = layout-of(pair, item)
. row = tables.layouts.rows[layout]
if !tables.layouts.is-struct(layout) || row.fields.count != 2
    refuse(.refused-expression, item)
    = Typed(value, no-type)
if field-type(pair, 0) != types.string-type || field-type(pair, 1) != given
    refuse(.refused-conversion, item)
    = Typed(value, no-type)
. made = frame(layout)
put
    - made
    - tables.layouts.field(layout, 0)
    - make-operand(.operand-constant, ir.add-string(name.text))
    - item
put(made, tables.layouts.field(layout, 1), value, item)
= Typed(made, pair)

────────────────────
+ do emit-argument-value Operand
    - id SyntaxId
    - row ASTArgument

` An argument written where a value is wanted, as the reference compiles one: the tuple of its
` name and its value where it has a name, and with a bullet `•?` that tuple as an optional where
` the value tests as true and nothing where it does not; its value where it has no name.
. nothing = make-operand(.operand-void, 0)
. value = emit-expression(row.expr)
if !row.name
    = value.operand
. argument-name = row.name
. held = value.type
. type = facts.node-type(unit.reading, id)
if !row.is-optional
    = name-pair(id, argument-name, value.operand, held).operand
. layout = layout-of(type, id)
if !types.is-optional(type) || !tables.layouts.is-struct(layout)
    refuse(.refused-type, id)
. tested = test(id, value, true, false)
. taken = ir.reserve-block()
. passed = ir.reserve-block()
. joined = ir.reserve-block()
. slot = join-slot(layout)
. mark = joins.length
branch(tested.operand, taken, passed)
ir.start-block(taken)
. pair = name-pair(id, argument-name, value.operand, held, types.optional-inner(type))
arrive(id, wrap(id, pair, type).operand, joined, slot)
ir.start-block(passed)
arrive(id, empty-optional(type, layout).operand, joined, slot)
= close-joins(joined, mark, layout, slot)

────────────────────
+ do emit-fact-call Typed ?! Refused
    - id SyntaxId
    - fact CallFact
    - object SyntaxId
    - written RowRange'SyntaxId
    - piped SyntaxId = 0
    - leading SyntaxId = 0
    - answers TypeId = no-type
    - bound SyntaxId = 0

` A call the type pass recorded, of a function declared with arguments.
` 1. The receiver is evaluated, when the callee has one: the value written before its name, or
`    else the receiver of the function the call is in. It takes the conversion recorded for it.
` 2. The arguments are evaluated in the order they are written, and then each takes the
`    conversion recorded for it. A value piped into the call is evaluated before them, and is
`    the last of them; `piped-site` says where its conversion is kept, where that is not
`    where it is written. The left operand of an operator that makes the call is evaluated
`    before either, and is the first of them.
` A call a value is piped into evaluates its receiver after its arguments.
` 3. Each parameter takes the argument the type pass matched to it, or its default when the
`    call leaves it out. The arguments of a variadic tail are made into the list its
`    parameter takes, once every other argument is converted.
` The answer has the node's type, or `answers` for a call that no node writes.
` `super(…)` gives its object as `object`: it runs the base's constructor on the receiver,
` as an initializer, and answers nothing. A constructor the compiler generated runs nothing
` then. A method called on the receiver by a constructor, or on the base's part of the
` receiver, is the one named, whatever the object's class declares in its place.
` A call that answers nothing and has the type of its receiver gives the receiver: the one
` written, where a property it delegates to answered the call.
` A call of a binding gives `bound`, the binding: it is evaluated first, the value it calls
` on is the receiver, or what a property that value delegates to holds where that answers
` the call, and the arguments it holds come before those written, each converted
` as the type pass recorded at the call for its type and that of the place it fills.
. nothing = make-operand(.operand-void, 0)
. callee = fact.callee
. shifted = piped-site
piped-site = 0
. restores = fact.form == .call-this-constructor && names-slot(object, .slot-super)
if restores
    if callee == no-instance || !(builds || initializes) || piped != 0 || leading != 0
        refuse(.refused-expression, id)
        = Typed(nothing, no-type)
    if !tables.has-initializer(callee)
        if written.count != 0 || !tables.is-class(instances.rows[callee].self-type)
            refuse(.refused-expression, id)
        = Typed(nothing, types.void-type)
if callee != no-instance && !fact.is-partial && piped == 0 && unled-or-unbound && !restores
    if tables.builds-in-frame(callee)
        = emit-construct(id, fact, written, answers, bound, leading)
.. unled-or-unbound = leading == 0 || bound == 0
if callee == no-instance || fact.is-partial
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. target = if restores then tables.initializer-functions[callee] else instance-function
    .. instance-function = tables.instance-functions[callee]
if target == no-function && !tables.is-prototype(callee)
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. row = instances.rows[callee]
. owner = program.modules[row.module]
. first Index = 0
. receives = false
. is-declared = false
do match? owner.decls[row.decl]
    | .decl-fromverter
        if written.count != 1 || piped != 0 || leading != 0 || restores
            refuse(.refused-expression, id)
            = Typed(nothing, no-type)
        = emit-converting(id, callee, tree.children[written.start], fact.propagates)
    | .decl-function(fn)
        if is-table-constructor-kind(fn.kind)
            if piped != 0 || leading != 0 || bound != 0 || restores
                refuse(.refused-expression, id)
                = Typed(nothing, no-type)
            = emit-generated-call(id, fact, written)
        first = fn.args.start
        . is-member = function-or-getter || fn.kind == .setter-decl
            .. function-or-getter = fn.kind == .function-decl || fn.kind == .getter-decl
        receives = fn.owner != 0 && !fn.is-static && is-member
        is-declared = fn.args.count == fact.fills.count
        . makes-nothing = row.self-type != no-type && void-self
            .. void-self = tables.layouts.values[row.self-type] == void-layout
        . makes-zero = fn.kind == .default-constructor-decl && is-zeroed(row.self-type)
        . makes-object = fn.kind == .default-constructor-decl && tables.is-class(row.self-type)
        . makes-absent = fn.kind == .default-constructor-decl && types.is-optional(row.self-type)
        . is-made = makes-nothing || makes-zero || makes-object || makes-absent
        . is-called = fn.kind == .cast-constructor-decl || fn.kind == .function-decl
        if fn.is-generated && !is-called && !is-made
            is-declared = false
if !is-declared
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. mark = pending.length
. receiver = nothing
. written-receiver = nothing
. written-type = no-type
. row-taken = nothing
. start = given.length
. lead U32 = if leading != 0 then 1 else 0
. lead-site = leading
if bound != 0
    if restores || leading != 0 || piped != 0
        refuse(.refused-expression, id)
        = Typed(nothing, no-type)
    . source = emit-callee(bound)
    . shape = source.type
    . held = layout-of(shape, bound)
    . place U32
    if binds-object(shape)
        . reached = read-through(id, part(source.operand, held, 0, bound), fact.through)
        receiver = reached.operand
        place = 1
        . lent = fact.through.count != 0 && is-derived(reached.type, row.self-type)
        if !receives || (reached.type != row.self-type && !lent)
            refuse(.refused-conversion, id)
            = Typed(nothing, no-type)
    else if receives
        refuse(.refused-expression, id)
        = Typed(nothing, no-type)
    lead = bound-count(shape)
    lead-site = id
    for offset in 0 .. < lead
        . piece = part(source.operand, held, place + offset, bound)
        given += piece
else if restores
    receives = true
    receiver = unit.self
else if receives && piped == 0 && dispatch-type != no-type && runs-on-row(callee, dispatch-type)
    receiver = dispatch-row
    row-taken = dispatch-row
else if receives && piped == 0 && takes-row(callee, object)
    receiver = case-receiver(id, object, callee).operand
    row-taken = case-cursors[cursor-at(object)].row
else if receives && piped == 0
    . received-2 = emit-receiver(id, object)
    written-receiver = received-2.operand
    written-type = received-2.type
    . reached = read-through(id, Typed(written-receiver, received-2.type), fact.through)
    receiver = reached.operand
    if reached.type != row.self-type && !derived-through
        refuse(.refused-conversion, id)
    .. derived-through = fact.through.count != 0 && is-derived(reached.type, row.self-type)
. count U32 = written.count + lead
. last = nothing
. last-type = no-type
if leading != 0
    . follows = piped != 0 && !is-inert(piped)
    . lead-value = emit-expression(leading)
    given += Typed(apart(Typed(settled(lead-value, leading, written, 0), lead-value.type), leading, follows), lead-value.type)
if piped != 0
    count += 1
    . pipe-value = emit-expression(piped)
    last = settled(pipe-value, piped, written, 0)
    last-type = pipe-value.type
. evaluated U32
for argument in tree.children[written]
    . expression = argument
    do match? tree.nodes[argument]
        | .node-argument(named)
            expression = named.expr
    evaluated += 1
    . live = tables.live-statement-of(unit.reading, expression) if styling.element != 0 && id == styling.element && expression == argument
    . trackers = if live then open-trackers(expression) else no-local
    if live
        live-actions += LiveTrackers(trackers, trackers)
    . emitted = emit-expression(expression)
    . value = settled(emitted, expression, written, evaluated)
    if live
        live-actions.pop()
        argument-trackers += LiveMember(expression, trackers)
    given += Typed(value, emitted.type)
    if styling.element != 0 && id == styling.element
        element-given += Typed(apart(Typed(value, emitted.type), expression, true), emitted.type)
. attributes = element-given.length
. filled-mark = element-filled.length
if styling.element != 0 && id == styling.element
    emit-attributes(id, callee, fact, count)
if styling.valued != 0 && id == styling.valued
    emit-rule-values(id)
if piped != 0
    given += Typed(last, last-type)
if receives && piped != 0 && !restores
    . reached = read-through(id, emit-receiver(id, object), fact.through)
    receiver = reached.operand
    if reached.type != row.self-type
        refuse(.refused-conversion, id)
if receives
    pending += receiver
. tail-first = count
. tail-type = no-type
for position in 0 .. < fact.fills.count
    if facts.call-fills[fact.fills.start + position] as U32 == ArgumentFill.fill-variadic
        tail-first = lead
        tail-type = instances.argument-type(callee, position)
for position in 0 .. < fact.fills.count
    . fill = facts.call-fills[fact.fills.start + position] as U32
    . fixed = fill != ArgumentFill.fill-empty && fill != ArgumentFill.fill-variadic
    if tail-type != no-type && fixed && fill < count && fill >= tail-first
        tail-first = fill + 1
for position in 0 .. < count
    if position >= tail-first
        break
    . site = lead-site
    if position >= lead
        . index = position - lead
        site = if index == written.count then piped else tree.children[written.start + index]
    . passed = given[start + position]
    if !takes-default(fact, owner, first, position, passed.type)
        if position < lead && bound != 0
            . wanted = filled-type(fact, callee, position)
            if wanted != no-type && passed.type != wanted
                passed = convert-held(id, passed, wanted)
        else if piped != 0 && site == piped && shifted != 0
            . reason ConversionReason = if shifted == id then .reason-piped else .reason-argument
            passed = convert-matched
                - shifted
                - reason
                - passed
                - no-type
        else
            passed = convert(site, .reason-argument, passed)
    else
        . parameter = filled-parameter(fact, position)
        . expected = instances.argument-type(callee, parameter)
        passed = optional-argument
            - id
            - site
            - passed
            - callee
            - owner.arg-pool[first + parameter].default-syntax
            - expected
    given[start + position] = passed
. tail = nothing
if tail-type != no-type
    . tailed = emit-tail(id, written, lead, start, tail-first, count, tail-type, piped)
    tail = tailed.operand
    if tailed.type != tail-type
        refuse(.refused-conversion, id)
. placed U32
for position in 0 .. < fact.fills.count
    . fill = facts.call-fills[fact.fills.start + position] as U32
    . expected = instances.argument-type(callee, position)
    . default = owner.arg-pool[first + position].default-syntax
    if fill == ArgumentFill.fill-empty
        pending += default-argument(id, callee, default, expected).operand
    else if fill == ArgumentFill.fill-variadic
        pending += tail
        placed += count - tail-first
    else if fill >= count
        . held = attributes + ((fill - count) as Size)
        if styling.element == 0 || id != styling.element || held >= element-given.length
            refuse(.refused-expression, id)
        else if element-given[held].type != expected
            refuse(.refused-conversion, id)
        else
            pending += element-given[held].operand
    else if given[start + fill].type != expected
        refuse(.refused-conversion, id)
    else
        pending += given[start + fill].operand
        placed += 1
drop-given(start)
if placed != count
    refuse(.refused-expression, id)
. filled = row.fills.count
if filled != 0
    if styling.element == 0 || id != styling.element || element-filled.length != filled-mark + filled
        refuse(.refused-expression, id)
    else
        for offset in 0 .. < filled
            . held = element-filled[filled-mark + offset] as Size
            if element-given[held].type != instances.argument-type(callee, fact.fills.count + offset)
                refuse(.refused-conversion, id)
            else
                pending += element-given[held].operand
if row.carried != 0
    give-cells(id, row.carried)
if row.slots.count != 0
    give-slots(id, callee)
if row-taken != nothing && row.row-validated
    pending += if dispatch-type != no-type then dispatch-columns else case-columns(id, at-cursor)
        .. at-cursor = cursor-at(object)
if restores
    . called-2 = call-instance(callee, id, mark, true)
    = Typed(nothing, called-2.type)
. exact = names-slot(object, .slot-super)
if (builds || initializes) && fact.form != .call-getter && on-this
    exact = true
if receives && bound == 0 && fact.through.count == 0
    . known = if object == 0 then unit.owner-type else facts.answer-type(unit.reading, object)
    if tables.is-class(known) && is-derived(known, row.self-type) && !types.has-subclasses(known)
        exact = true
.. on-this = object == 0 || names-slot(object, .slot-this)
. raising = instances.signatures[callee].errors.count != 0
takes-result = raising
. answer = if receives then call-method(callee, id, mark, exact) else call-instance(callee, id, mark)
takes-result = false
if raising && fact.propagates
    answer = propagate(id, callee, answer.operand)
. expected = if answers != no-type then answers else facts.answer-type(unit.reading, id)
if receives && answer.type == types.void-type && answers-self
    = Typed(receiver, expected)
.. answers-self = expected == row.self-type && row-taken == nothing
if answer.type == types.void-type && reads-through
    = Typed(written-receiver, expected)
.. reads-through = fact.through.count != 0 && expected == written-type
if answer.type != expected && !links-into(id, answer.type, expected)
    refuse(.refused-conversion, id)
= answer

────────────────────
_ takes-row Bool
    - callee InstanceId
    - object SyntaxId

` Whether a call written on a name that stands for the case of a row, or on the receiver
` named by no name in a member that runs on the case, passes the row: to a member of the case
` that runs on the row, or to one of a base every case shares.
|? cursor-at(object) == U32.max
    false
??
    row.row-receiver != no-type || holds-row(row.self-type)

.. row = instances.rows[callee]

────────────────────
_ do case-receiver Typed
    - id SyntaxId
    - object SyntaxId
    - callee InstanceId

` The row a call passes where it is written on a name that stands for the case of a row, as
` TypeScript passes the cursor's row: a member of the case takes the row of its own type, and
` one of a shared base the row it runs on.
. held = case-cursors[cursor-at(object)]
. row = instances.rows[callee]
. wanted = if row.row-receiver != no-type then row.row-receiver else row.self-type
if held.type != wanted || (row.row-receiver != no-type && held.case-index != row.row-case)
    refuse(.refused-expression, id)
    = Typed(make-operand(.operand-void, 0), no-type)
= Typed(held.row, held.type)

────────────────────
_ cursor-at U32
    - object SyntaxId

` The case of a row a call's object stands for: that of a name, or with no object written
` that of the receiver in a member that runs on the case.
if object != 0 then case-cursor-of(object) else this-cursor

────────────────────
_ do case-columns Operand
    - id SyntaxId
    - cursor U32

` The columns a call passes after its arguments to a member of a case that runs on a row whose
` storage TypeScript checked where the case was read.
= case-place(id, case-cursors[cursor]).columns

────────────────────
_ do callee-type TypeId
    - callable SyntaxId

` The type of the value a call calls. The type pass types a name there only where it is
` read for its value, so a local, a lazy local, an argument, the item of a loop or a name a
` pattern binds has the type its function gives it, the receiver its own, and a
` property of the receiver the type it is declared with, and a global the type it is kept
` with. One that is an optional the type pass planned to be called as what it holds is read
` as that.
. type = facts.node-type(unit.reading, callable)
. binding = instances.rows[unit.reading].binding
if type != no-type || binding == no-binding
    = type
. global = bindings.resolution-of(binding, callable)
if global.kind == .resolve-global
    . row = tables.storage-of(global.module, global.decl)
    = if row != no-storage then tables.storage[row].type else no-type
if unit.reading != unit.instance
    = type
do match? tree.nodes[callable]
    | .node-identifier(named)
        . resolution = bindings.resolution-of(binding, callable)
        if resolution.kind == .resolve-member && unit.has-self
            . found = property-of(unit.owner-type, named.name)
            . declared = if found then types.properties[found].type else no-type
            if declared == no-type || facts.plan-of(unit.reading, callable) != .plan-callee
                = declared
            = if types.is-optional(declared) then types.optional-inner(declared) else no-type
        if resolution.kind != .resolve-slot
            = no-type
        if bindings.slots[resolution.slot].kind == .slot-this && unit.has-self
            = unit.owner-type
        . held = slot-held-type(callable, resolution.slot)
        if held != no-type && facts.plan-of(unit.reading, callable) == .plan-callee
            = types.optional-inner(held)
        = held
= no-type

────────────────────
+ do emit-callee Typed
    - callable SyntaxId

` The value a call calls, in the type `callee-type` gives it.
. type = callee-type(callable)
if type == no-type || facts.node-type(unit.reading, callable) != no-type
    = emit-expression(callable)
. value = make-operand(.operand-void, 0)
do match? tree.nodes[callable]
    | .node-identifier(row)
        value = emit-identifier(callable, row.name, type).operand
= Typed(value, type)

────────────────────
_ do emit-generated-call Typed
    - id SyntaxId
    - fact CallFact
    - written RowRange'SyntaxId

` A call of a function the compiler generates with no arguments declared, whose instance
` takes them as its kind says: a table's constructors, whose filler is named `with`. The
` arguments are evaluated in the order written, each converted as recorded for it, and each
` fills the place the type pass matched it to, which is its own.
. nothing = make-operand(.operand-void, 0)
. callee = fact.callee
. wanted = instances.signatures[callee].args.count
if written.count != wanted || fact.fills.count != wanted
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
for position in 0 .. < fact.fills.count
    if facts.call-fills[fact.fills.start + position] as U32 != position
        refuse(.refused-expression, id)
        = Typed(nothing, no-type)
. mark = pending.length
. start = given.length
give-arguments(written)
pass-arguments(written, start, callee, 0, written.count)
drop-given(start)
= call-checked(id, fact, mark)

────────────────────
_ do give-arguments
    - written RowRange'SyntaxId
    - refuses-named Bool = false

` Emits the arguments written for a call in order onto `given`, each settled where one written
` after it may change what it read. Where it `refuses-named`, an argument written with a name
` has no shape.
. evaluated U32
for argument in tree.children[written]
    . expression = tree.argument-value(argument)
    if refuses-named && tree.is-named(argument)
        refuse(.refused-expression, argument)
        break
    evaluated += 1
    . emitted = emit-expression(expression)
    given += Typed(settled(emitted, expression, written, evaluated), emitted.type)

────────────────────
_ do pass-arguments
    - written RowRange'SyntaxId
    - start Size
    - callee InstanceId
    - first U32
    - count U32

` Passes the first `count` arguments written for a call, which `given` holds from `start`, each
` converted to the type of its parameter of `callee`, counting the parameters from `first`.
for position in 0 .. < count
    . site = tree.children[written.start + position]
    . value = convert(site, .reason-argument, given[start + position])
    if value.type != instances.argument-type(callee, first + position)
        refuse(.refused-conversion, site)
    pending += value.operand

────────────────────
_ do call-checked Typed
    - id SyntaxId
    - fact CallFact
    - mark Size

` Calls the callee of a call fact with the arguments passed from `mark`, propagating what it
` raises where the call does, and answers what the call answers, as the type pass typed it.
. callee = fact.callee
. raising = instances.signatures[callee].errors.count != 0
takes-result = raising
. answer = call-instance(callee, id, mark)
takes-result = false
if raising && fact.propagates
    answer = propagate(id, callee, answer.operand)
. expected = facts.node-type(unit.reading, id)
if answer.type != expected && !links-into(id, answer.type, expected)
    refuse(.refused-conversion, id)
= answer

────────────────────
_ do emit-closure-call Typed
    - id SyntaxId
    - fact CallFact
    - callable SyntaxId
    - written RowRange'SyntaxId

` A call of a nested function: of the instance the type pass typed for the arguments
` written. The value called is evaluated first, and is the environment the body is given.
` The arguments follow in the order written, each converted as recorded for it. A binding
` of a nested function is called so too: it holds the function and then the arguments it
` was given, which come before those written. A variadic tail the type pass packed is made
` a list as a function's tail is, once the arguments before it are converted.
. nothing = make-operand(.operand-void, 0)
. callee = fact.callee
if callee == no-instance || fact.is-partial || tables.instance-functions[callee] == no-function
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. tail-first = written.count
. packed = fact.fills.count != 0 && tail-fill == ArgumentFill.fill-variadic
    .. tail-fill = facts.call-fills[fact.fills.start + fact.fills.count - 1] as U32
if packed
    tail-first = fact.fills.count - 1
. closure = emit-callee(callable)
. tuple = closure
. held = void-layout
. bound U32
if is-binding(tuple.type)
    bound = bound-count(tuple.type)
    held = layout-of(tuple.type, callable)
    closure = part(tuple.operand, held, 0, callable)
. wanted = instances.signatures[callee].args.count
. passed = if packed then tail-first + 1 else written.count
if !is-closure(closure.type) || bound + passed != wanted || misfilled
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
.. misfilled = packed && (bound != 0 || tail-first > written.count)
. mark = pending.length
. start = given.length
give-arguments(written, true)
pending += closure.operand
for offset in 0 .. < bound
    . piece = part(tuple.operand, held, 1 + offset, callable)
    pending += piece.operand
    if piece.type != instances.argument-type(callee, offset)
        refuse(.refused-conversion, id)
pass-arguments(written, start, callee, bound, tail-first)
if packed
    . listed = instances.argument-type(callee, tail-first)
    . tail = emit-tail(id, written, 0, start, tail-first, written.count, listed, 0)
    if tail.type != listed
        refuse(.refused-conversion, id)
    pending += tail.operand
drop-given(start)
= call-checked(id, fact, mark)

────────────────────
_ do emit-value-call Typed
    - id SyntaxId
    - callable SyntaxId
    - written RowRange'SyntaxId

` A call of a value of a function type: of the code it holds, given the data it holds and
` then an argument for each place the type declares, each converted to what the type
` declares for the place. The value is read first, and the arguments are evaluated in the
` order written; the type pass recorded which of them fills each place. A binding of such a
` value holds the value and then the arguments it was given, each in its place, and those
` fill the places nothing written does. What runs is not known here, so the call is checked
` for a panic, which the type pass has said of the caller. A type that carries errors
` answers with its value or one of them, as the type pass kept for the type: under `catch`
` that is the call's value, and elsewhere an error leaves the function at the call. A C
` function's has no shape yet. A generator called for its next item answers the type the
` type pass gave the call, an optional of an item, or that or an error, as the type pass
` kept for the generator's type where it carries errors.
. nothing = make-operand(.operand-void, 0)
. shape = callee-type(callable)
. binding = if is-binding(shape) then shape else no-type
if binding != no-type
    shape = bound-object(binding)
. args = RowRange'TypeId()
. returns = types.void-type
. plain = false
. c = false
. fn = if shape == no-type || shape == invalid-type then no-type else function-row(types, shape)
if fn != no-type
    do match? types.rows[fn]
        | .type-function(row)
            args = row.args
            plain = !row.is-c
            c = row.is-c
            returns = value-returned(row.return-type)
if c && binding == no-type
    = emit-c-value-call(id, callable, written, args, returns)
. steps = facts.plan-of(unit.reading, id) == .plan-step
. carried = no-type
if plain && carries(fn)
    carried = if steps then facts.carried-result(shape) else facts.carried-result(fn)
    plain = carried != no-type
if steps
    returns = facts.node-type(unit.reading, id)
. fact = own-call(id)
. fills = RowRange'ArgumentFill()
if fact != no-fact
    fills = facts.calls[fact].fills
if !plain || fills.count != args.count || in-zone || (!function.may-panic && !in-landing)
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. source = emit-callee(callable)
. tuple = source
. held = void-layout
if binding != no-type
    held = layout-of(binding, callable)
    source = part(tuple.operand, held, 0, callable)
. layout = layout-of(source.type, callable)
if layout != tables.layouts.function-layout
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. code = load(source.operand, 0, pointer-layout, id)
. data = load(source.operand, tables.layouts.field(layout, 1).offset, managed-layout, id)
. mark = pending.length
. start = given.length
give-arguments(written)
pending += data
pass-filled(id, written, start, fills, args, tuple.operand, held)
drop-given(start)
. answered = if carried == no-type then returns else carried
. result = Typed(call(code, id, mark, .callee-value, layout-of(answered, id), !in-landing), answered)
if carried != no-type && fact != no-fact && facts.calls[fact].propagates
    result = propagate-held(id, carried, result.operand)
if result.type != facts.node-type(unit.reading, id) && !links-into(id, result.type, facts.node-type(unit.reading, id))
    refuse(.refused-conversion, id)
= result

────────────────────
_ do pass-filled
    - id SyntaxId
    - written RowRange'SyntaxId
    - start Size
    - fills RowRange'ArgumentFill
    - args RowRange'TypeId
    - bound Operand
    - held LayoutId

` Passes an argument for each place a value's function type declares, converted to what the
` type declares for it: the argument written that the type pass recorded as filling the place,
` which `given` holds from `start`, or else what a binding of the value, `bound` laid out as
` `held`, holds there.
. empty U32 = ArgumentFill.fill-empty
for place in 0 .. < args.count
    . fill = facts.call-fills[fills.start + place] as U32
    . declared = types.child-type(args, place)
    . value = Typed(make-operand(.operand-void, 0), no-type)
    . site = id
    if fill != empty && fill < written.count
        site = tree.children[written.start + fill]
        value = convert(site, .reason-argument, given[start + fill])
    else if fill == empty && held != void-layout
        value = part(bound, held, 1 + place, id)
        if value.type != declared
            value = convert-held(id, value, declared)
    else
        refuse(.refused-expression, id)
    if value.type != declared
        refuse(.refused-conversion, site)
    pending += value.operand

────────────────────
_ do emit-c-value-call Typed
    - id SyntaxId
    - callable SyntaxId
    - written RowRange'SyntaxId
    - args RowRange'TypeId
    - returns TypeId

` A call of a value of a C function's type: of the address it holds, given an argument for
` each place the type declares, converted to what the type declares for it, evaluated in the
` order written. What runs is not known here, so the call is checked for a panic as the
` reference checks a call of any value, and the function there gives the signal.
. nothing = make-operand(.operand-void, 0)
. fact = own-call(id)
. fills = if fact != no-fact then facts.calls[fact].fills else RowRange'ArgumentFill()
if fills.count != args.count || in-zone || (!function.may-panic && !in-landing)
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. source = emit-callee(callable)
if !is-pointer(layout-of(source.type, callable))
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. start = given.length
give-arguments(written)
. mark = pending.length
pass-filled(id, written, start, fills, args, nothing, void-layout)
drop-given(start)
. result = call(source.operand, id, mark, .callee-value, layout-of(returns, id), !in-landing)
if returns != facts.node-type(unit.reading, id)
    refuse(.refused-conversion, id)
= Typed(result, returns)

────────────────────
_ do filled-type TypeId
    - fact CallFact
    - callee InstanceId
    - given U32

` The type the callee takes for the place one of the arguments given fills, or no type
` where it fills none.
for position in 0 .. < fact.fills.count
    if (facts.call-fills[fact.fills.start + position] as U32) == given
        = instances.argument-type(callee, position)
= no-type

────────────────────
_ do convert-held Typed
    - site SyntaxId
    - value Typed
    - declared TypeId

` An argument a binding of a value held, converted to what the value's type declares for its
` place: by the conversion the type pass recorded at the call for the two types.
. fact = facts.first-conversion(unit.reading, site)
while fact != no-fact
    . row = facts.conversions[fact]
    if row.reason == .reason-argument && row.from == value.type && row.to == declared
        = convert-one(site, row, value)
    fact = row.next
refuse(.refused-conversion, site)
= value

────────────────────
_ do bound-object TypeId
    - type TypeId

` The type of the value a binding of a value of a function type holds and calls, or no type
` for any other binding.
do match? types.rows[type]
    | .type-binding(row)
        if row.form == .bound-value
            = row.object
= no-type

────────────────────
_ do holds-callee Bool
    - type TypeId

` Whether a binding holds what it calls: a nested function, or a value of a function type.
do match? types.rows[type]
    | .type-binding(row)
        = row.form == .bound-closure || row.form == .bound-value
= false

────────────────────
_ do emit-bind Typed
    - id SyntaxId
    - callable SyntaxId
    - written RowRange'SyntaxId

` A call given too few arguments, which gives a binding: a tuple in the frame of what it
` holds. A binding called so is copied first, field by field. Else the value the new one
` calls on is evaluated: the object a method is read from, or the receiver of the function
` the call is in where none is written, or the nested function or the value of a function
` type that is called. Then the arguments written are evaluated in order and stored as they
` are: one after another, or for a value of a function type each in the place the type pass
` recorded for it, where a place nothing fills holds nothing.
. nothing = make-operand(.operand-void, 0)
. type = facts.node-type(unit.reading, id)
. layout = layout-of(type, id)
. sized = layout != void-layout
. count U32 = if sized then tables.layouts.rows[layout].fields.count else 0
. made = if sized then frame(layout) else nothing
. place U32
. extended = callee-type(callable)
if is-binding(extended)
    . source = emit-callee(callable)
    . held = layout-of(extended, callable)
    . copied U32 = bound-count(extended) + (if binds-object(extended) then 1 else 0)
    for offset in 0 .. < copied
        . value = part(source.operand, held, offset, callable)
        if sized && value.type != types.void-type
            if place >= count || value.type != tables.layouts.field(layout, place).type
                refuse(.refused-conversion, id)
                = Typed(nothing, no-type)
            put(made, tables.layouts.field(layout, place), value.operand, id)
        place += 1
else if binds-object(type)
    . value = Typed(nothing, no-type)
    if holds-callee(type)
        value = emit-callee(callable)
    else
        do match tree.nodes[callable]
            | .node-get-expression(get)
                value = emit-expression(get.object)
            | .node-identifier
                if unit.has-self && unit.reading == unit.instance
                    value = Typed(unit.self, unit.owner-type)
                else
                    refuse(.refused-expression, id)
            ??
                refuse(.refused-expression, id)
    if !sized || value.type != tables.layouts.field(layout, 0).type
        refuse(.refused-conversion, id)
        = Typed(nothing, no-type)
    put(made, tables.layouts.field(layout, 0), value.operand, id)
    place = 1
. fills = RowRange'ArgumentFill()
. placed = bound-object(type) != no-type
if placed
    . binds = own-call(id)
    if binds == no-fact || !facts.calls[binds].is-partial || !sized
        refuse(.refused-expression, id)
        = Typed(nothing, no-type)
    fills = facts.calls[binds].fills
. position U32
for argument in tree.children[written]
    . expression = argument
    do match? tree.nodes[argument]
        | .node-argument(named)
            if named.name && !placed
                refuse(.refused-expression, argument)
            expression = named.expr
    if placed
        place = count
        for index in 0 .. < fills.count
            if (facts.call-fills[fills.start + index] as U32) == position
                place = 1 + index
    position += 1
    . value = emit-expression(expression)
    if sized
        if place >= count || value.type != tables.layouts.field(layout, place).type
            refuse(.refused-conversion, expression)
            = Typed(nothing, no-type)
        put(made, tables.layouts.field(layout, place), value.operand, expression)
    else if value.type != types.void-type
        refuse(.refused-conversion, expression)
        = Typed(nothing, no-type)
    place += 1
if sized && place != count && !placed
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
= Typed(made, type)

────────────────────
_ do emit-converting Typed
    - id SyntaxId
    - callee InstanceId
    - argument SyntaxId
    - propagates Bool

` A call of a type with one value that a function the type declares converts from. The value
` takes the conversion recorded for it, and the function answers. Where the function raises
` errors, they leave the function with the call where the type pass said so, and are panics
` where the value is a text written in source. Under `catch` the call gives what the function
` returned, its value or its error.
. nothing = make-operand(.operand-void, 0)
. expression = argument
do match? tree.nodes[argument]
    | .node-argument(named)
        expression = named.expr
. value = convert(argument, .reason-argument, emit-expression(expression))
if value.type != instances.argument-type(callee, 0)
    refuse(.refused-conversion, argument)
    = Typed(nothing, no-type)
. raising = instances.signatures[callee].errors.count != 0
. mark = pending.length
pending += value.operand
takes-result = raising
. made = call-method(callee, id, mark)
takes-result = false
if raising && propagates
    made = propagate(id, callee, made.operand)
else if raising && facts.plan-of(unit.reading, id) == .plan-literal-conversion
    made = panic-on-error(id, callee, made.operand)
if made.type != facts.node-type(unit.reading, id)
    refuse(.refused-conversion, id)
= made

────────────────────
_ do emit-construct Typed
    - id SyntaxId
    - fact CallFact
    - written RowRange'SyntaxId
    - answers TypeId
    - bound SyntaxId = 0
    - leading SyntaxId = 0

` A tuple or struct made by its fields. A call of a binding evaluates the binding first, and
` its arguments come before those written, as does the `leading` value a call is given before
` them. The arguments are evaluated in the order they are written, and then each takes the
` conversion recorded for it: one the binding holds, that recorded at the call for its type and
` that of the field it fills. Each field is given the argument the type pass matched to it, or
` its first value when the call leaves it out.
` What is made has the node's type, or `answers` for a call that no node writes. It is made in
` place, where TypeScript calls the constructor it generates, as the IR notes.
. nothing = make-operand(.operand-void, 0)
. type = instances.rows[fact.callee].self-type
. layout = layout-of(type, id)
. start = given.length
. lead U32
if bound != 0
    . source = emit-callee(bound)
    . shape = source.type
    . held = layout-of(shape, bound)
    if binds-object(shape)
        refuse(.refused-expression, id)
    lead = bound-count(shape)
    for offset in 0 .. < lead
        . piece = part(source.operand, held, offset, bound)
        given += piece
if leading != 0
    lead = 1
    . emitted = emit-expression(leading)
    given += Typed(settled(emitted, leading, written, 0), emitted.type)
give-arguments(written)
for position in 0 .. < lead
    if leading != 0
        . converted = convert(leading, .reason-argument, given[start + position])
        given[start + position] = converted
        continue
    . wanted = filled-field-type(type, fact.fills, position)
    if wanted != no-type && given[start + position].type != wanted
        . converted = convert-held(id, given[start + position], wanted)
        given[start + position] = converted
for position in 0 .. < written.count
    . site = tree.children[written.start + position]
    . converted = convert(site, .reason-argument, given[start + lead + position])
    given[start + lead + position] = converted
. own-making = making
making = making.callee = fact.callee
. made = make-fields(type, layout, fact.fills, start, lead + written.count, id)
making = own-making
ir.note-made-call()
drop-given(start)
. expected = if answers != no-type then answers else facts.node-type(unit.reading, id)
if type != expected
    refuse(.refused-conversion, id)
= Typed(made, type)

────────────────────
_ do filled-field-type TypeId
    - type TypeId
    - fills RowRange'ArgumentFill
    - given U32

` The type of the field of a tuple or struct one of the arguments given fills, or no type
` where it fills none.
. range = types.completions[type].properties
. position U32
for offset in 0 .. < range.count
    . property = types.properties[range.start + offset]
    if property.slot == U32.max
        continue
    if position < fills.count && (facts.call-fills[fills.start + position] as U32) == given
        = property.type
    position += 1
= no-type

────────────────────
+ do call-default Typed
    - id SyntaxId
    - kept GlobalStorage

` A call of the function that evaluates a default, made where the call that leaves its
` argument out is. It is checked where the default may panic, which the type pass must have
` said of the caller too.
. target = tables.functions[kept.function]
if target.may-panic && !function.may-panic && !in-landing
    refuse(.refused-expression, id)
    = Typed(make-operand(.operand-void, 0), no-type)
. returns = layout-of(kept.type, id)
ir.depend(.callee-function, kept.function, if target.may-panic then may-panic-dependency else 0u32)
if in-zone
    cross-zone(id, false)
. result = call
    - make-operand(.operand-symbol, target.symbol)
    - id
    - pending.length
    - .callee-function
    - returns
    - target.may-panic && !in-landing
if in-zone
    cross-zone(id, true)
= Typed(result, kept.type)

────────────────────
_ takes-default Bool
    - fact CallFact
    - owner Module
    - first Index
    - given U32
    - type TypeId

` Whether an argument a call gives is an optional that fills a parameter with a default. Such
` a parameter takes its default where the argument holds nothing.
|? type == no-type || type == invalid-type || !types.is-optional(type)
    false
??
    parameter != U32.max && owner.arg-pool[first + parameter].default-syntax != 0

.. parameter = filled-parameter(fact, given)

────────────────────
_ do optional-argument Typed
    - id SyntaxId
    - site SyntaxId
    - value Typed
    - callee InstanceId
    - default SyntaxId
    - expected TypeId

` An optional given to a parameter with a default: what it holds, converted as the call
` records for the argument, or the default where it holds nothing, converted as the argument
` records for a default.
. nothing = make-operand(.operand-void, 0)
. held = value.type
. layout = layout-of(expected, id)
. tested = present(site, value)
. given-block = ir.reserve-block()
. absent = ir.reserve-block()
. joined = ir.reserve-block()
. slot = join-slot(layout)
. mark = joins.length
branch(tested.operand, given-block, absent)
ir.start-block(given-block)
. passed = convert(site, .reason-argument, Typed(value.operand, held))
if passed.type != expected
    refuse(.refused-conversion, site)
arrive(id, passed.operand, joined, slot)
ir.start-block(absent)
. other = default-argument(site, callee, default, expected)
if other.type != expected
    refuse(.refused-conversion, id)
arrive(id, other.operand, joined, slot)
= Typed(close-joins(joined, mark, layout, slot), expected)

────────────────────
_ do emit-c-call Typed
    - id SyntaxId
    - operands RowRange'SyntaxId
    - bound SyntaxId = 0

` A call of a C function, by the policy its declaration has:
` - one that cannot reach the collector is called as it is;
` - one that polls is called between two polls;
` - any other may block, and is called between two checks that the task is not being
`   terminated, where the function `raises-termination`, as foreign code the collector does
`   not wait for.
` After a call of the last two kinds the panic signal is read again. In a function the
` collector never sees, a call of those two kinds leaves that zone before its first check
` and enters it again after its last. One that suspends the task is called as it is, and
` then, where the function `raises-termination`, the task is checked for being terminated,
` which raises the termination panic; elsewhere the task runs on until a check finds it, as
` after a poll, for no caller checks the panic signal of a function that may not panic. One that
` leaves a termination to what follows, a lock taken or an answer the caller checks, is not
` followed by the check (`checks-termination`). It has no shape where the collector never looks.
` A call the type pass planned to describe the storage it makes is called by the policy of the
` runtime's function that describes it, which polls.
` A call of a binding gives `bound`, the binding: it is evaluated first, and the arguments it
` holds come before those written, each converted as the type pass recorded at the call.
. nothing = make-operand(.operand-void, 0)
if facts.plan-of(unit.reading, id) == .plan-elided
    = Typed(nothing, facts.node-type(unit.reading, id))
. fact = answering(facts.first-call(unit.reading, id))
if fact == no-fact
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. callee = facts.calls[fact].callee
. symbol = tables.c-symbols[callee]
?! Panic("A called C function has no symbol")
    if symbol == no-string
. polls = false
. leaf = false
. row = instances.rows[callee]
do match? program.modules[row.module].decls[row.decl]
    | .decl-function(fn)
        polls = (fn.effects /and/ CompilationEffect.gc-polling) != 0
        leaf = (fn.effects /and/ CompilationEffect.gc-leaf) != 0
if facts.plan-of(unit.reading, id) == .plan-described
    polls = true
    leaf = false
. suspends = tables.c-suspends[callee] != 0
if suspends && in-zone
    refuse(.refused-suspending-call, id)
    = Typed(nothing, no-type)
. leaves = !leaf && !suspends && in-zone
. mark = pending.length
. position U32
if bound != 0
    . source = emit-callee(bound)
    . shape = source.type
    . held = layout-of(shape, bound)
    . count = bound-count(shape)
    for offset in 0 .. < count
        . expected = instances.argument-type(callee, position)
        . value = part(source.operand, held, offset, bound)
        if value.type != expected
            value = convert-held(id, value, expected)
        if value.type != expected
            refuse(.refused-conversion, id)
        pending += value.operand
        position += 1
for argument in tree.children[operands]
    . expression = argument
    do match? tree.nodes[argument]
        | .node-argument(given)
            expression = given.expr
    . value = convert(argument, .reason-argument, emit-expression(expression))
    if value.type != instances.argument-type(callee, position)
        refuse(.refused-conversion, argument)
    pending += value.operand
    position += 1
. returns = layout-of(facts.node-type(unit.reading, id), id)
. described = no-layout
if facts.plan-of(unit.reading, id) == .plan-described
    described = described-items(id, callee)
if described != no-layout
    pending += make-operand(.operand-buffer-descriptor, described)
else
    ir.depend(.callee-c, symbol, 0)
if leaves
    cross-zone(id, false)
    in-zone = false
if suspends
    leaf = true
    call-probe-thunk(tables.probe-flush, id)
else if polls
    poll(id)
else if !leaf
    check-interrupt(id)
    call-runtime(.runtime-enter-ffi, id, pending.length, void-layout, true)
. result = nothing
if described != no-layout
    result = call-runtime(tables.c-described[callee] as RuntimeFunction, id, mark, returns)
else
    result = call(make-operand(.operand-symbol, symbol), id, mark, .callee-c, returns)
if suspends
    if !is-unprobed()
        call-probe-thunk(tables.probe-safepoint, id)
    if raises-termination() && tables.checks-termination(callee)
        . resumed = ir.reserve-block()
        . raised = call-instance(instances.report.termination, id, pending.length)
        branch(raised.operand, landing-block(id), resumed)
        ir.start-block(resumed)
if leaf
    = Typed(result, facts.node-type(unit.reading, id))
if polls
    poll(id)
else
    call-runtime(.runtime-leave-ffi, id, pending.length)
    check-interrupt(id)
append(.op-load-panic-signal, id, Span(), 0)
. resumed = ir.reserve-block()
branch(make-operand(.operand-panic-signal, 0), landing-block(id), resumed)
ir.start-block(resumed)
if leaves
    cross-zone(id, true)
    in-zone = true
= Typed(result, facts.node-type(unit.reading, id))

────────────────────
_ do described-items LayoutId
    - id SyntaxId
    - callee InstanceId

` The layout of the items of the storage a C call allocates, resizes or copies for an array
` the collector owns, where an item holds pointers the collector follows: the call is then
` of the function that also takes what describes the storage. No layout for any other item.
. constant = facts.constant-of(unit.reading, id)
if constant == no-fact || tables.c-described[callee] == no-runtime-function
    refuse(.refused-expression, id)
    = no-layout
. layout = layout-of(facts.constants[constant].bits as TypeId, id)
if layout == void-layout || !tables.layouts.rows[layout].is-managed
    = no-layout
if tables.layouts.rows[layout].buffer == no-string
    refuse(.refused-type, id)
    = no-layout
= layout
