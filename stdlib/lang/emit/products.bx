(import /lang/ast/ast)
(import /lang/ast/ast-children)
(import /lang/ast/ast-nodes)
(import /lang/ast/module)
(import /lang/ast/operator)
(import /lang/ast/program)
(import /lang/ast/row-range)
(import /lang/check/type-store)
(import /lang/check/types)
(import /lang/report/facts-text)
(import /lang/target)
(import /os/env)
(import /os/file)
(import /os/path)
(blank)
(prop _ document-type-name _ (= "DocumentType"))
(prop _ document-ranks (list String) (= (list "owner" "default" "alternate" "none")))

(type + AppProduct (is Tuple)
  (prop + id String)
  (prop + name String)
  (prop + version (? String))
  (prop + icon (? Path))
  (prop + shows-in-dock Bool)
  (prop + document-types (list AppDocumentType))
)

(type + AppDocumentType (is Tuple)
  (prop + name String)
  (prop + extensions (list String))
  (prop + content-types (list String))
  (prop + rank (? String))
)

(type + ProductError (is Error)
  (fn-do + This _
    (param message String)
  )
)

(fn-do + read-product (? AppProduct) (?! ProductError)
  (param program Program)
  (param types Types)
  (param target Target)
  ; Reads the app the program declares for a target, as an element of the target's product class.
  ; Products declared for other targets are left for those targets, and a target without a product
  ; class has none.
  (let module-name (. target product-module-name))
  (let class-name (. target product-class-name))
  (if (or (not module-name) (not class-name))
    (return null)
  )
  (let module (call (. program module-by-name) module-name))
  (if (not module)
    (return null)
  )
  (let reader (call ProductReader program types (as module ModuleId) class-name))
  (return (call (. reader read)))
)

(type _ ProductReader
  (prop _ program Program)
  (prop _ types Types)
  (prop _ product-module ModuleId)
  (prop _ class-name String)
  (fn-do + This _
    (param program _)
    (param types _)
    (param product-module _)
    (param class-name _)
  )
  (fn-do + read (? AppProduct) (?! ProductError)
    (let product-class (call (. types nearest-class) product-module (call (. program store-atom) class-name) 0 false))
    (if (not product-class)
      (return null)
    )
    (let product (? AppProduct) null)
    (for (in position (..< 0 (. program modules length)))
      (let module (as position ModuleId))
      (if (call names-class module product-class)
        (let found (call read-module module))
        (if (and found (== module (. program entry-module)) (not (. program is-batch)))
          (= product found)
        )
      )
    )
    (return product)
  )
  (fn-do _ names-class Bool
    (param module ModuleId)
    (param target DeclRef)
    (let found (call (. types nearest-class) module (call (. program store-atom) class-name) 0 false))
    (return (and found (== (. found module) (. target module)) (== (. found decl) (. target decl))))
  )
  (fn-do _ read-module (? AppProduct) (?! ProductError)
    (param module ModuleId)
    (let tree (. ([] (. program modules) module) tree))
    (let first SyntaxId 0)
    (let first-type SyntaxId 0)
    (for (in position (..< 1 (. tree nodes length)))
      (let element (as position SyntaxId))
      (let type-id (call product-type tree element))
      (if (== type-id 0)
        (continue)
      )
      (throw (call ProductError (call problem module type-id (str "A " class-name " is declared at the top level of the program's main module, where the compiler reads it to build the app bundle"))) (if (or (not (call is-root module)) (not (call is-statement tree element)))))
      (if (!= first 0)
        (let second (call problem module type-id (str "A program has one " class-name ", and this is its second")))
        (throw (call ProductError (str second "\n" first-place)))
        (lazy first-place (call related-text program module first-type "Its first product"))
      )
      (= first element)
      (= first-type type-id)
    )
    (if (== first 0)
      (return null)
    )
    (return (call app-product module tree first first-type))
  )
  (fn-do _ product-type SyntaxId
    (param tree AST)
    (param element SyntaxId)
    (match? ([] (. tree nodes) element)
      (case (call .node-markup row)
        (match? ([] (. tree nodes) (. row type-id))
          (case (call .node-type-identifier type)
            (if (== (. type name text) class-name)
              (return (. row type-id))
            )
          )
        )
      )
    )
    (return 0)
  )
  (fn-do _ is-root Bool
    (param module ModuleId)
    (if (not (. program is-batch))
      (return (== module (. program entry-module)))
    )
    (for (in root (. program batch-roots))
      (if (== root module)
        (return true)
      )
    )
    (return false)
  )
  (fn-do _ is-statement Bool
    (param tree AST)
    (param element SyntaxId)
    (match? ([] (. tree nodes) (. tree root))
      (case (call .node-top-level-syntax top)
        (for (in statement ([] (. tree children) (. top statements)))
          (if (== statement element)
            (return true)
          )
        )
      )
    )
    (return false)
  )
  (fn-do _ app-product AppProduct (?! ProductError)
    (param module ModuleId)
    (param tree AST)
    (param element SyntaxId)
    (param type-id SyntaxId)
    (let id (? String) null)
    (let name (? String) null)
    (let version (? String) null)
    (let icon (? Path) null)
    (let shows-in-dock (? Bool) null)
    (let document-types (list AppDocumentType))
    (match? ([] (. tree nodes) element)
      (case (call .node-markup row)
        (throw (call ProductError (call problem module type-id (str "A " class-name " takes no arguments or style rules"))) (if (or (!= (. row args count) 0) (!= (. row style-rule-applications count) 0))))
        (for (in statement ([] (. tree children) (call body-statements tree (. row body))))
          (match? ([] (. tree nodes) statement)
            (case (call .node-assign assignment)
              (let property (call property-name module tree assignment class-name))
              (let is-set
                (match property
                  (case= "id"
                    (!= id null)
                  )
                  (case= "name"
                    (!= name null)
                  )
                  (case= "version"
                    (!= version null)
                  )
                  (case= "icon"
                    (!= icon null)
                  )
                  (case= "shows-in-dock"
                    (!= shows-in-dock null)
                  )
                  (default
                    false
                  )
                )
              )
              (throw (call ProductError (call problem module (. assignment lhs) (str class-name "'s " property " is set twice"))) (if is-set))
              (if (== property "id")
                (= id (call string-value module tree (. assignment rhs) class-name property))
                (throw (call ProductError (call problem module (. assignment rhs) (str class-name "'s id uses only letters, digits, hyphens and periods"))) (if (not (call is-bundle-id id))))
                (else-if (== property "name")
                  (= name (call string-value module tree (. assignment rhs) class-name property))
                  (throw (call ProductError (call problem module (. assignment rhs) (str class-name "'s name names the app bundle, so it is not empty and has no /"))) (if (or (== (. name length) 0) (!= (call (. name find) "/") null))))
                )
                (else-if (== property "version")
                  (= version (call string-value module tree (. assignment rhs) class-name property))
                )
                (else-if (== property "icon")
                  (= icon (call icon-path module tree (. assignment rhs)))
                )
                (else-if (== property "shows-in-dock")
                  (= shows-in-dock
                    (call bool-value
                      (block
                        (arg module)
                        (arg tree)
                        (arg (. assignment rhs))
                        (arg class-name)
                        (arg property)
                      )
                    )
                  )
                )
                (else
                  (throw (call ProductError (call problem module (. assignment lhs) (str class-name " has no property " property))))
                )
              )
              (continue)
            )
            (case (call .node-markup child)
              (+= document-types (call document-type module tree child))
              (continue)
            )
          )
          (throw (call ProductError (call problem module statement (str "A " class-name " holds only property assignments and DocumentType elements"))))
        )
      )
    )
    (throw (call ProductError (call problem module type-id (str "A " class-name " needs an id"))) (if (not id)))
    (throw (call ProductError (call problem module type-id (str "A " class-name " needs a name"))) (if (not name)))
    (return (call AppProduct id name version icon (?? shows-in-dock true) document-types))
  )
  (fn-do _ document-type AppDocumentType (?! ProductError)
    (param module ModuleId)
    (param tree AST)
    (param row ASTMarkup)
    (let name (? String) null)
    (let extensions (? (list String)) null)
    (let content-types (? (list String)) null)
    (let rank (? String) null)
    (throw (call ProductError (call problem module (. row type-id) "A DocumentType takes no arguments or style rules")) (if (or (!= (. row args count) 0) (!= (. row style-rule-applications count) 0))))
    (for (in statement ([] (. tree children) (call body-statements tree (. row body))))
      (match? ([] (. tree nodes) statement)
        (case (call .node-assign assignment)
          (let property (call property-name module tree assignment document-type-name))
          (throw (call ProductError (call problem module (. assignment lhs) (str "DocumentType's " property " is set twice"))) (if (or (and (== property "name") name) (and (== property "extensions") extensions) (and (== property "content-types") content-types) (and (== property "rank") rank))))
          (if (== property "name")
            (= name (call string-value module tree (. assignment rhs) document-type-name property))
            (else-if (== property "extensions")
              (= extensions (call string-list module tree (. assignment rhs) document-type-name property))
            )
            (else-if (== property "content-types")
              (= content-types
                (call string-list
                  (block
                    (arg module)
                    (arg tree)
                    (arg (. assignment rhs))
                    (arg document-type-name)
                    (arg property)
                  )
                )
              )
            )
            (else-if (== property "rank")
              (= rank (call string-value module tree (. assignment rhs) document-type-name property))
              (throw (call ProductError (call problem module (. assignment rhs) (str "DocumentType's rank is one of " (call (. ", " join) document-ranks)))) (if (not (is-in rank document-ranks))))
            )
            (else
              (throw (call ProductError (call problem module (. assignment lhs) (str "DocumentType has no property " property))))
            )
          )
          (continue)
        )
      )
      (throw (call ProductError (call problem module statement "A DocumentType holds only property assignments")))
    )
    (throw (call ProductError (call problem module (. row type-id) "A DocumentType needs a name")) (if (not name)))
    (let listed (?? extensions (call (of List String))))
    (let typed (?? content-types (call (of List String))))
    (throw (call ProductError (call problem module (. row type-id) "A DocumentType needs at least one extension or content type")) (if (and (== (. listed length) 0) (== (. typed length) 0))))
    (return (call AppDocumentType name listed typed rank))
  )
  (fn-do _ body-statements (of RowRange SyntaxId)
    (param tree AST)
    (param body SyntaxId)
    (match? ([] (. tree nodes) body)
      (case (call .node-block block)
        (return (. block body))
      )
    )
    (return (call (of RowRange SyntaxId)))
  )
  (fn-do _ property-name String (?! ProductError)
    (param module ModuleId)
    (param tree AST)
    (param assignment ASTAssign)
    (param owner String)
    (throw (call ProductError (call problem module (. assignment lhs) (str owner "'s properties are set with ="))) (if (!= (. assignment op) .eq-op)))
    (match? ([] (. tree nodes) (. assignment lhs))
      (case (call .node-identifier target)
        (return (. target name text))
      )
    )
    (throw (call ProductError (call problem module (. assignment lhs) (str "A " owner " sets only its own properties"))))
  )
  (fn-do _ string-value String (?! ProductError)
    (param module ModuleId)
    (param tree AST)
    (param value SyntaxId)
    (param owner String)
    (param property String)
    (match? ([] (. tree nodes) value)
      (case (call .node-string-syntax literal)
        (return (call owned (. literal text)))
      )
    )
    (throw (call ProductError (call problem module value (str owner "'s " property " must be a literal: the compiler reads it to build the app bundle, and a computed value exists only when the program runs"))))
  )
  (fn-expr _ bool-value Bool (?! ProductError)
    (param module ModuleId)
    (param tree AST)
    (param value SyntaxId)
    (param owner String)
    (param property String)
    (match identifier
      (case= "true"
        true
      )
      (case= "false"
        false
      )
      (throw (call ProductError (call problem module value (str owner "'s " property " must be true or false: the compiler reads it to build the app bundle, and a computed value exists only when the program runs"))))
    )
    (where
      (lazy identifier
        (match? ([] (. tree nodes) value)
          (case (call .node-identifier literal)
            (. literal name text)
          )
        )
      )
    )
  )
  (fn-do _ string-list (list String) (?! ProductError)
    (param module ModuleId)
    (param tree AST)
    (param value SyntaxId)
    (param owner String)
    (param property String)
    (match? ([] (. tree nodes) value)
      (case (call .node-list-syntax list)
        (let items (list String))
        (for (in item ([] (. tree children) (. list items)))
          (+= items (call string-value module tree item owner property))
        )
        (return items)
      )
    )
    (throw (call ProductError (call problem module value (str owner "'s " property " must be a list of literals: the compiler reads it to build the app bundle, and a computed value exists only when the program runs"))))
  )
  (fn-do _ icon-path Path (?! ProductError)
    (param module ModuleId)
    (param tree AST)
    (param value SyntaxId)
    (let text (call string-value module tree value class-name "icon"))
    (let path (if-expr (call (. text starts-with) "/") (call Path text) (/ (call module-directory module) text)))
    (throw (call ProductError (call problem module value (str class-name "'s icon is a .png or .icns file"))) (if (and (!= (. path ext) "png") (!= (. path ext) "icns"))))
    (throw (call ProductError (call problem module value (str class-name "'s icon " (as path String) " does not exist"))) (if (not (. path is-file))))
    (let bytes
      (call read-file-bytes path
        (block
          (on-error (: error Error)
            (throw (call ProductError (call problem module value (str class-name "'s icon " (as path String) " cannot be read: " (. error message)))))
          )
        )
      )
    )
    (if (== (. path ext) "icns")
      (throw (call ProductError (call problem module value (str class-name "'s icon " path-text " is not an icns file"))) (if (not (call is-icns bytes))))
      (lazy path-text (as path String))
      (return path)
    )
    (throw (call ProductError (call problem module value (str class-name "'s icon " (as path String) " is not a PNG image"))) (if (not (call is-png bytes))))
    (let width (call big-endian bytes 16))
    (let height (call big-endian bytes 20))
    (throw (call ProductError (call problem module value (str class-name "'s icon is square, and " (as path String) " is " width "x" height))) (if (!= width height)))
    (return path)
  )
  (fn-do _ is-bundle-id Bool
    (param text String)
    (if (== (. text length) 0)
      (return false)
    )
    (for (in char text)
      (if (not (or is-letter (and (>= char '0') (<= char '9')) (== char '-') (== char '.')))
        (return false)
      )
      (lazy is-letter (or (and (>= char 'a') (<= char 'z')) (and (>= char 'A') (<= char 'Z'))))
    )
    (return true)
  )
  (fn-expr _ module-directory Path
    (param module ModuleId)
    (case? (== (. path length) 0)
      (call Path (call cwd))
    )
    (default
      (. (call Path path) dir)
    )
    (where
      (lazy path (. ([] (. program modules) module) path))
    )
  )
  (fn-expr _ problem String
    (param module ModuleId)
    (param syntax SyntaxId)
    (param message String)
    (call diagnostic-text program module syntax message)
  )
)

(fn-expr _ is-png Bool
  (param bytes ([] Byte))
  (and (>= (. bytes length) 24) (== ([] bytes 0) 137) (== ([] bytes 1) 80) (== ([] bytes 2) 78) (== ([] bytes 3) 71) (== ([] bytes 12) 73) (== ([] bytes 13) 72) (== ([] bytes 14) 68) (== ([] bytes 15) 82))
)

(fn-expr _ is-icns Bool
  (param bytes ([] Byte))
  (and (>= (. bytes length) 8) (== ([] bytes 0) 105) (== ([] bytes 1) 99) (== ([] bytes 2) 110) (== ([] bytes 3) 115))
)

(fn-expr _ big-endian U32
  (param bytes ([] Byte))
  (param offset Size)
  (/or/ high-half (/lshift/ (as ([] bytes (+ offset 2)) U32) 8) (as ([] bytes (+ offset 3)) U32))
  (where
    (lazy high-half (/or/ (/lshift/ (as ([] bytes offset) U32) 24) (/lshift/ (as ([] bytes (+ offset 1)) U32) 16)))
  )
)

(fn-expr _ owned String
  (param text String)
  (call (. (call byte-view text) slice-string))
)
