_ do copy-column-range
    - id SyntaxId
    - column Operand
    - type TypeId
    - layout LayoutId
    - range Operand
    - range-type TypeId
    - object SyntaxId
    - source Operand
    - source-layout LayoutId

` The items of a view of a field's column copied into those a range spans of another, as
` TypeScript copies them: the target's data is found, the range made forward, and the
` source's data found; as many items as the range spans are copied, with no check of either's
` length.
. item-layout = layout-of(viewed-item(type), id)
. meta = column-meta(id, column, layout)
. data = column-data(id, column, layout, meta, item-layout)
. bounds = range-bounds(id, range, range-type, column, type, object)
. into = item-cell(id, data.operand, bounds.start, item-layout)
. out = column-data(id, source, source-layout, column-meta(id, source, source-layout), item-layout)
copy-items(id, into, out.operand, bounds.length, item-layout)
invalidate-marks(id, meta)

────────────────────
_ do column-meta TableMeta
    - site SyntaxId
    - column Operand
    - layout LayoutId

` The metadata a view of a field's column holds.
= TableMeta
    - part(column, layout, 2, site).operand
    - part(column, layout, 6, site).operand
    - part(column, layout, 7, site).operand
    - part(column, layout, 8, site).operand
    - part(column, layout, 9, site).operand

────────────────────
_ do column-data Typed
    - site SyntaxId
    - column Operand
    - layout LayoutId
    - meta TableMeta
    - item LayoutId

` Where the items of a view of a field's column start: where the table grows, once the view is
` checked, the column its table's directory holds moved on by the view's offset, and where it
` does not, the data the view holds.
. growing = ir.reserve-block()
. fixed = ir.reserve-block()
. joined = ir.reserve-block()
branch(view-grows(site, meta), growing, fixed)
ir.start-block(growing)
validate-table(site, meta, "TableField", true)
. directory = moved-bytes
    - site
    - part-address(site, column, layout, 3).operand
    - arithmetic
        - site
        - .arithmetic-multiply
        - part(column, layout, 4, site).operand
        - integer(.machine-u64, 8)
        - u64-layout
. held = item-cell
    - site
    - load(directory, 0, pointer-layout, site)
    - part(column, layout, 5, site).operand
    - item
. from-growing = ir.current
jump(joined)
ir.start-block(fixed)
. own = part-address(site, column, layout, 0)
. from-fixed = ir.current
jump(joined)
ir.start-block(joined)
= Typed(phi(pointer-layout, held, from-growing, own.operand, from-fixed), own.type)

────────────────────
+ do column-length Typed
    - site SyntaxId
    - column Operand
    - layout LayoutId

` How many items a view of a field's column has, once the view is checked where its table
` grows. A view of a finished table is never checked.
if tables.layouts.rows[layout].fields.count == 2
    = part(column, layout, 1, site)
. meta = column-meta(site, column, layout)
. growing = ir.reserve-block()
. joined = ir.reserve-block()
branch(view-grows(site, meta), growing, joined)
ir.start-block(growing)
validate-table(site, meta, "TableField", true)
jump(joined)
ir.start-block(joined)
= part(column, layout, 1, site)

────────────────────
_ do part-address Typed
    - site SyntaxId
    - value Operand
    - layout LayoutId
    - position U32

` A field of a table or of a view of one that holds an address, as a plain pointer.
. held = tables.layouts.field(layout, position).layout
. read = part(value, layout, position, site)
= if held == pointer-layout then read else Typed(num-cast(site, read.operand, held, pointer-layout), read.type)

────────────────────
+ do view-columns Operand
    - site SyntaxId
    - meta TableMeta
    - columns Operand

` The columns a view of a table keeps: none where the table grows, whose view finds them in
` its header, and the table's own where it does not.
. growing = ir.reserve-block()
. fixed = ir.reserve-block()
. joined = ir.reserve-block()
branch(view-grows(site, meta), growing, fixed)
ir.start-block(growing)
jump(joined)
ir.start-block(fixed)
jump(joined)
ir.start-block(joined)
. kept = phi(pointer-layout, integer(.machine-pointer, 0), growing, columns, fixed)
= num-cast(site, kept, pointer-layout, managed-layout)

────────────────────
+ do put-meta
    - site SyntaxId
    - made Operand
    - layout LayoutId
    - first U32
    - meta TableMeta

` Stores a table's metadata in a view of it, from the field at `first`.
put(made, tables.layouts.field(layout, first), meta.header, site)
put(made, tables.layouts.field(layout, first + 1), meta.owner, site)
put(made, tables.layouts.field(layout, first + 2), meta.incarnation, site)
put(made, tables.layouts.field(layout, first + 3), meta.generation, site)
put(made, tables.layouts.field(layout, first + 4), meta.shrink, site)

────────────────────
+ do table-get Typed
    - id SyntaxId
    - held Operand
    - type TypeId

` A name of a table, or of a view of one, that TypeScript answers itself: the view of a field's
` column, how many rows or items there are, or where the items of a field's column start.
. none = make-operand(.operand-void, 0)
. op = table-op(id)
. kind = intrinsic(type)
. layout = layout-of(type, id)
if op == TableOp.table-column && is-row-source(kind)
    = table-column(id, held, type, layout)
if op == TableOp.table-length && is-row-source(kind)
    = rows-length(id, held, type, layout)
if op == TableOp.table-length && (kind == .table-column || kind == .immutable-table-column)
    . counted = column-length(id, held, layout)
    = Typed(counted.operand, types.size-type)
if op == TableOp.table-layout && kind == .table
    = layout-text(id, held, type, layout)
if op == TableOp.table-capacity && kind == .table
    . room = table-capacity(id, held, layout)
    = Typed(room.operand, types.size-type)
if op == TableOp.table-mark && kind == .table
    = table-mark(id, held, layout)
if op == TableOp.table-length && kind == .index-span
    . indices = word-at(id, held, layout, 3)
    = Typed(indices, types.size-type)
if op == TableOp.table-length && (kind == .table-selection || kind == .immutable-table-selection)
    . span-type = field-type(type, 1)
    . span-layout = layout-of(span-type, id)
    . selected = word-at(id, part(held, layout, 1, id).operand, span-layout, 3)
    = Typed(selected, types.size-type)
if op != TableOp.table-data || kind != .table-column
    refuse(.refused-expression, id)
    = Typed(none, no-type)
. pointer = facts.node-type(unit.reading, id)
. held-layout = layout-of(pointer, id)
. item-layout = layout-of(viewed-item(type), id)
. data = column-data(id, held, layout, column-meta(id, held, layout), item-layout)
= if held-layout == pointer-layout then Typed(data.operand, pointer) else Typed(num-cast(id, data.operand, pointer-layout, held-layout), pointer)

────────────────────
_ do layout-text Typed
    - id SyntaxId
    - held Operand
    - type TypeId
    - layout LayoutId

` `t.layout`, as TypeScript answers it: the text of how a table keeps its rows, that of a table
` that grows where it grows in an arena, and else that of one that does not.
. none = make-operand(.operand-void, 0)
. row = table-row-type(type)
. row-layout = layout-of(row, id)
. text-layout = layout-of(types.string-type, id)
. fixed-text = "Table'${type-runtime-name(types, row)}\nstorage fixed"
. growing-text = growing-struct-text(row, row-layout)
if types.intrinsic-of(row) == .union
    . place = tables.unions.of(row)
    if place == U32.max
        refuse(.refused-type, id)
        = Typed(none, no-type)
    fixed-text = tables.unions.fixed-texts[place]
    growing-text = tables.unions.growing-texts[place]
. fixed = make-operand(.operand-constant, ir.add-string(fixed-text))
. growing = ir.reserve-block()
. kept = ir.reserve-block()
. joined = ir.reserve-block()
branch(view-grows(id, table-meta(id, held, layout)), growing, kept)
ir.start-block(growing)
. grown = make-operand(.operand-constant, ir.add-string(growing-text))
jump(joined)
ir.start-block(kept)
jump(joined)
ir.start-block(joined)
= Typed(phi(text-layout, grown, growing, fixed, kept), types.string-type)

────────────────────
_ do growing-struct-text String
    - row TypeId
    - row-layout LayoutId

` The text `.layout` gives for a table of struct rows that grows in an arena: a region for each
` field's column.
. lines = ["Table'${type-runtime-name(types, row)}", "storage arena-growable", "row-layout struct", "growth shared geometric"]
if types.intrinsic-of(row) != .struct
    = "\n".join(lines)
for position in 0 .. < tables.layouts.rows[row-layout].fields.count
    . item = tables.layouts.rows[tables.layouts.field(row-layout, position).layout]
    lines += "region column[$position] ${region-name(row, position)} width=${item.size} align=${item.alignment}"
= "\n".join(lines)

────────────────────
_ do table-capacity Typed
    - site SyntaxId
    - table Operand
    - layout LayoutId

` How many rows a table has room for: its header's capacity, once checked, where it grows, and
` the size it holds itself where it does not.
. meta = table-meta(site, table, layout)
. growing = ir.reserve-block()
. fixed = ir.reserve-block()
. joined = ir.reserve-block()
branch(grows(site, meta.header), growing, fixed)
ir.start-block(growing)
validate-table(site, meta, "Table", false)
. held = header-word(site, meta.header, 2)
. from-growing = ir.current
jump(joined)
ir.start-block(fixed)
. own = part(table, layout, 1, site)
. from-fixed = ir.current
jump(joined)
ir.start-block(joined)
= Typed(phi(u64-layout, held, from-growing, own.operand, from-fixed), own.type)

────────────────────
_ do table-mark Typed
    - site SyntaxId
    - table Operand
    - layout LayoutId

` `t.mark`, as TypeScript answers it: the table is checked to grow, and the mark holds its
` header, its arena's owner, incarnation and generation, and the header's length, mutation
` generation and use of its spill.
. type = facts.node-type(unit.reading, site)
. mark-layout = layout-of(type, site)
. meta = require-growable(site, table, layout, "mark")
. made = frame(mark-layout)
put-word(site, made, mark-layout, 0, meta.header, u64-layout)
put-word(site, made, mark-layout, 1, meta.owner, u64-layout)
put-word(site, made, mark-layout, 2, meta.incarnation, u64-layout)
put-word(site, made, mark-layout, 3, meta.generation, u64-layout)
put-word(site, made, mark-layout, 4, header-word(site, meta.header, 1), u64-layout)
put-word(site, made, mark-layout, 5, header-word(site, meta.header, 4), u64-layout)
put-word(site, made, mark-layout, 6, header-word(site, meta.header, 6), u64-layout)
= Typed(made, type)

────────────────────
+ do put-word
    - site SyntaxId
    - made Operand
    - layout LayoutId
    - position U32
    - value Operand
    - source LayoutId

` Stores a word in a field of a tuple made in the frame, as the field holds it.
. field = tables.layouts.field(layout, position)
put(made, field, num-cast(site, value, source, field.layout), site)

────────────────────
+ do word-at Operand
    - site SyntaxId
    - value Operand
    - layout LayoutId
    - position U32

` A word a tuple holds at a place, as a number.
. field = tables.layouts.field(layout, position)
= num-cast(site, part(value, layout, position, site).operand, field.layout, u64-layout)

────────────────────
_ do require-growable TableMeta
    - site SyntaxId
    - table Operand
    - layout LayoutId
    - operation String

` Checks that a table grows before an operation only such a table has, as TypeScript checks
` it: it has a header, its arena has not been reset since it was made, and it is not sealed.
` Answers the table's metadata, with no shrink generation.
. header = part(table, layout, 2, site)
fail-if
    - site
    - compare(site, .compare-equal, header.operand, integer(.machine-u64, 0))
    - "Table.$operation requires an Arena-backed growable table"
. meta = TableMeta
    - header.operand
    - part(table, layout, 3, site).operand
    - part(table, layout, 4, site).operand
    - part(table, layout, 5, site).operand
    - integer(.machine-u64, 0)
validate-table(site, meta, "Table", false)
= meta

────────────────────
_ do count-on
    - site SyntaxId
    - header Operand
    - position U32

` Counts on a generation a table's header keeps, which may not overflow.
. place = num-cast(site, header, u64-layout, pointer-layout)
. current = load(place, position * 8, u64-layout, site)
fail-if
    - site
    - compare(site, .compare-equal, current, integer(.machine-u64, U64.max))
    - "Table generation overflow"
store
    - place
    - position * 8
    - arithmetic(site, .arithmetic-add, current, integer(.machine-u64, 1), u64-layout)
    - false
    - site

────────────────────
_ do put-header
    - site SyntaxId
    - header Operand
    - position U32
    - value Operand

` Stores a word of a table's header.
store(num-cast(site, header, u64-layout, pointer-layout), position * 8, value, false, site)

────────────────────
+ do emit-table-method Typed
    - id SyntaxId
    - object SyntaxId
    - written RowRange'SyntaxId

` A member of a table that TypeScript answers where it is called: the table is evaluated, then
` the arguments in the order they are written, each converted to its parameter's type, and
` then the operation runs. A table finished from a local or an argument is the empty table
` there after, and so is one finished from a stored field of an object, which the object holds
` where it was read, as TypeScript stores the empty table through the address it read.
. nothing = make-operand(.operand-void, 0)
. fact = own-call(id)
if fact == no-fact
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. call = facts.calls[fact]
. callee = call.callee
if callee == no-instance || call.is-partial || call.form != .call-method || other-count
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
.. other-count = call.fills.count != written.count
for position in 0 .. < call.fills.count
    if facts.call-fills[call.fills.start + position] as U32 != position
        refuse(.refused-expression, id)
        = Typed(nothing, no-type)
. op = table-op(id)
. clears = op == TableOp.table-finish && finished-field(object)
. emptied = if op == TableOp.table-finish && !clears then finished-slot(object) else no-slot
. table = emit-receiver(id, object)
. type = table.type
. row = table-row-type(type)
. unions = types.intrinsic-of(row) == .union && tables.unions.of(row) != U32.max
if intrinsic(type) != .table || (types.intrinsic-of(row) != .struct && !unions)
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. passed [Operand]
. passed-types [TypeId]
. evaluated U32
for argument in tree.children[written]
    . expression = argument
    do match? tree.nodes[argument]
        | .node-argument(named)
            expression = named.expr
    evaluated += 1
    . made = emit-expression(expression)
    passed += settled(made, expression, written, evaluated)
    passed-types += made.type
. known = U32.max
for position in 0 .. < written.count
    if unions && op == TableOp.table-append
        known = wraps-case(tree.children[written.start + position], .reason-argument, passed-types[position])
    . converted = convert
        - tree.children[written.start + position]
        - .reason-argument
        - Typed(passed[position], passed-types[position])
    passed[position] = converted.operand
    if converted.type != instances.argument-type(callee, position)
        refuse(.refused-conversion, id)
. layout = layout-of(type, id)
. row-layout = layout-of(row, id)
if op == TableOp.table-append
    = table-append(id, table.operand, layout, row, row-layout, passed[0], known)
if op == TableOp.table-reserve
    . reserved = require-growable(id, table.operand, layout, "reserve")
    reserve-rows(id, row, row-layout, reserved, passed[0])
else if op == TableOp.table-extend
    table-extend(id, table.operand, layout, row, row-layout, passed[0], instances.argument-type(callee, 0))
else if op == TableOp.table-truncate
    table-truncate(id, table.operand, layout, passed[0])
else if op == TableOp.table-clear
    . cleared = require-growable(id, table.operand, layout, "clear")
    count-on(id, cleared.header, 3)
    count-on(id, cleared.header, 4)
    put-header(id, cleared.header, 1, integer(.machine-u64, 0))
    put-header(id, cleared.header, 6, integer(.machine-u64, 0))
else if op == TableOp.table-copy-from
    table-copy-from(id, table.operand, layout, row, row-layout, passed[0])
else if op == TableOp.table-finish
    . finished = table-finish(id, table.operand, layout)
    . answer = finished.type
    if emptied != no-slot
        empty-slot(emptied, type, layout, id)
    if clears
        if !tables.layouts.is-struct(layout)
            refuse(.refused-expression, id)
            = Typed(nothing, no-type)
        . empty = frame(layout)
        zero(empty, layout)
        copy(table.operand, empty, layout, tables.layouts.rows[layout].is-managed, id)
    = Typed(finished.operand, answer)
else if op == TableOp.table-view
    = viewed-table(id, table.operand, layout)
else if op == TableOp.table-rewind
    table-rewind(id, table.operand, layout, passed[0], instances.argument-type(callee, 0))
else if op == TableOp.table-storage-checkpoint
    = table-checkpoint
        - id
        - table.operand
        - layout
        - passed[0]
        - instances.argument-type(callee, 0)
        - passed[1]
        - instances.argument-type(callee, 1)
else if op == TableOp.table-validate-restore || op == TableOp.table-restore-storage
    . checkpoint-type = instances.argument-type(callee, 0)
    . arena-type = instances.argument-type(callee, 1)
    . mark-type = instances.argument-type(callee, 2)
    table-restore
        - id
        - table.operand
        - layout
        - passed
        - checkpoint-type
        - arena-type
        - mark-type
        - op == TableOp.table-restore-storage
else
    refuse(.refused-expression, id)
= Typed(nothing, types.void-type)

────────────────────
+ do emit-builder-method Typed
    - id SyntaxId
    - object SyntaxId
    - written RowRange'SyntaxId
    - appends Bool

` A member of an arena's builder that TypeScript answers where it is called, on a builder
` written or on the receiver of the member that calls it: the builder is evaluated, then its
` argument, converted to its parameter's type. `append` checks the size can
` grow, makes room for one more item and stores it after the last; `reserve` makes room for as
` many items as it is given. Each then writes the storage, its capacity and the size in the
` builder's header, where every copy of the builder reads them.
. nothing = make-operand(.operand-void, 0)
. fact = own-call(id)
. constant = facts.constant-of(unit.reading, id)
if fact == no-fact || constant == no-fact
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. call = facts.calls[fact]
. callee = call.callee
. form = call.form == .call-method || (object == 0 && call.form == .call-function)
if callee == no-instance || call.is-partial || !form || call.fills.count != 1 || written.count != 1
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
if facts.call-fills[call.fills.start] as U32 != 0
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. builder = emit-receiver(id, object)
. type = builder.type
. argument = tree.children[written.start]
. given = emit-expression(tree.argument-value(argument))
given = convert(argument, .reason-argument, given)
if given.type != instances.argument-type(callee, 0)
    refuse(.refused-conversion, id)
. layout = layout-of(type, id)
. item-type = types.builder-item(type)
. item-layout = if item-type != no-type then layout-of(item-type, id) else void-layout
. width = tables.layouts.rows[item-layout].size as U64
if item-type == no-type || item-layout == void-layout || width == 0
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. traced = facts.constants[constant].bits != 0
. state = builder-state(id, builder.operand, layout)
. held = num-cast(id, state.identity, u64-layout, pointer-layout)
. current = BuilderItems(load(held, 0, u64-layout, id), load(held, 8, u64-layout, id))
if !appends
    . reserved = reserve-items
        - id
        - item-layout
        - traced
        - state.owner
        - state.incarnation
        - current
        - given.operand
    put-builder-state(id, held, reserved, state.size)
    = Typed(nothing, types.void-type)
fail-if
    - id
    - compare(id, .compare-equal, state.size, integer(.machine-u64, U64.max))
    - "ArrayBuilder size overflow"
. needed = arithmetic(id, .arithmetic-add, state.size, integer(.machine-u64, 1), u64-layout)
. items = reserve-items(id, item-layout, traced, state.owner, state.incarnation, current, needed)
. distance = arithmetic
    - id
    - .arithmetic-multiply
    - state.size
    - integer(.machine-u64, width)
    - u64-layout
. place = num-cast
    - id
    - arithmetic(id, .arithmetic-add, items.storage, distance, u64-layout)
    - u64-layout
    - pointer-layout
if tables.layouts.is-struct(item-layout)
    copy
        - address(place, 0, item-layout, id)
        - given.operand
        - item-layout
        - traced && tables.layouts.rows[item-layout].is-managed
        - id
else
    store(place, 0, given.operand, traced && is-managed-pointer(item-layout), id)
put-builder-state(id, held, items, needed)
= Typed(nothing, types.void-type)

────────────────────
+ do reserve-items BuilderItems
    - site SyntaxId
    - item LayoutId
    - traced Bool
    - owner Operand
    - incarnation Operand
    - current BuilderItems
    - needed Operand

` The storage of items kept in an arena, of its owner and incarnation, and its capacity, grown
` where fewer items fit than are needed, as TypeScript grows a builder's: the capacity is
` chosen, the bytes it takes reserved in the arena, zeroed and aligned to 16, and the items
` held copied over, with what describes them where the arena traces them. What was reserved
` before stays in the arena.
. width = tables.layouts.rows[item].size as U64
if traced && tables.layouts.rows[item].buffer == no-string
    refuse(.refused-type, site)
    = current
. kept = ir.current
. growing = ir.reserve-block()
. joined = ir.reserve-block()
branch(compare(site, .compare-greater, needed, current.capacity), growing, joined)
ir.start-block(growing)
. first U64 = if width <= 16 then 8 else if width <= 1024 then 4 else 1
. next = next-capacity(site, current.capacity, needed, first, "ArrayBuilder size overflow")
. bytes = checked-bytes(site, next, width, "ArrayBuilder")
. reserving = if traced then traced-reserve else RuntimeFunction.runtime-arena-reserve
    .. traced-reserve = RuntimeFunction.runtime-arena-reserve-described
. copying = if traced then traced-copy else RuntimeFunction.runtime-copy-plain-slice
    .. traced-copy = RuntimeFunction.runtime-copy-slice
. mark = pending.length
pending += num-cast(site, owner, u64-layout, pointer-layout)
pending += incarnation
pending += bytes
pending += integer(.machine-u64, 16)
pending += integer(.machine-u8, 1)
if traced
    pending += make-operand(.operand-buffer-descriptor, item)
. replacement = call-runtime(reserving, site, mark, pointer-layout)
fail-if
    - site
    - compare(site, .compare-equal, replacement, integer(.machine-pointer, 0))
    - "Arena allocation failed while growing ArrayBuilder"
. copied = checked-bytes(site, current.capacity, width, "ArrayBuilder")
. copies = pending.length
pending += replacement
pending += num-cast(site, current.storage, u64-layout, pointer-layout)
pending += copied
if traced
    pending += make-operand(.operand-buffer-descriptor, item)
call-runtime(copying, site, copies, pointer-layout)
. grown = num-cast(site, replacement, pointer-layout, u64-layout)
. grew = ir.current
jump(joined)
ir.start-block(joined)
= BuilderItems
    - phi(u64-layout, current.storage, kept, grown, grew)
    - phi(u64-layout, current.capacity, kept, next, grew)

────────────────────
_ do put-builder-state
    - site SyntaxId
    - held Operand
    - items BuilderItems
    - size Operand

` Writes the storage of an arena's builder, its capacity and its size in its header, as
` TypeScript writes them.
store(held, 0, items.storage, false, site)
store(held, 8, items.capacity, false, site)
store(held, 16, size, false, site)

────────────────────
_ do finished-slot SlotId
    - object SyntaxId

` The local or the argument a table is finished from, which TypeScript sets to the empty table
` after: one a name reads. None for a table a call makes, which TypeScript sets nowhere; any
` other place is refused.
do match? tree.nodes[object]
    | .node-call-expression
        = no-slot
. slot = local-slot(object, object, true)
if bindings.slots[slot].kind == .slot-lazy
    refuse(.refused-expression, object)
    = no-slot
= slot

────────────────────
_ do finished-field Bool
    - object SyntaxId

` Whether a table finished is a field an object stores, read where the object holds it: one of
` the receiver named alone, or one read from an object, by no getter.
do match? tree.nodes[object]
    | .node-identifier(row)
        if !is-own-field(object) || !tables.is-class(unit.owner-type) || own-call(object) != no-fact
            = false
        = stores-eagerly(unit.owner-type, row.name)
    | .node-get-expression(row)
        . owner = facts.node-type(unit.reading, row.object)
        if owner == no-type || owner == invalid-type || !tables.is-class(owner) || is-link(object)
            = false
        if own-call(object) != no-fact || facts.plan-of(unit.reading, object) != .plan-none
            = false
        = stores-eagerly(owner, row.name)
= false

────────────────────
_ stores-eagerly Bool
    - owner TypeId
    - name Atom

` Whether a type stores a property of a name as it is declared, with no getter or lazy value.
found && types.properties[found].storage-kind == .storage-eager

.. found = property-of(owner, name)

────────────────────
_ do empty-slot
    - slot SlotId
    - type TypeId
    - layout LayoutId
    - site SyntaxId

` Sets the local or the argument a table was finished from to the empty table: in the
` environment that keeps it, in its cell, or in the memory of the argument.
. empty = frame(layout)
zero(empty, layout)
if is-captured(slot)
    keep-captured(slot, empty, type, site)
    =
. offset = slot-offset(slot, site)
if unit.cells[offset] != no-local
    store-local(unit.cells[offset], empty, site)
    =
. memory = argument-memory(slot, type, site)
copy(memory, empty, layout, false, site)

────────────────────
_ do table-append Typed
    - site SyntaxId
    - table Operand
    - layout LayoutId
    - row TypeId
    - row-layout LayoutId
    - value Operand
    - known U32 = U32.max

` `t.append(row)`, as TypeScript answers it: the table is checked to grow, room is made for one
` more row, and the row is scattered into the columns at the end, plainly; the length is
` counted on, and the answer is the row's index. A union known to hold one case, as
` `wraps-case` finds it, is scattered as that case with no other tested.
. meta = require-growable(site, table, layout, "append")
. length = header-word(site, meta.header, 1)
fail-if
    - site
    - compare(site, .compare-equal, length, integer(.machine-u64, U64.max))
    - "Table length overflow"
. next = arithmetic(site, .arithmetic-add, length, integer(.machine-u64, 1), u64-layout)
reserve-rows(site, row, row-layout, meta, next)
. columns = num-cast(site, header-word(site, meta.header, 0), u64-layout, pointer-layout)
if types.intrinsic-of(row) == .union && known != U32.max && known-case
    scatter-union-case
        - site
        - tables.unions.of(row)
        - known
        - columns
        - length
        - take(value, tables.layouts.case-field(row-layout, known), site)
        - meta
        - true
        - false
else if types.intrinsic-of(row) == .union
    scatter-union(site, tables.unions.of(row), columns, length, value, meta, true, false)
else
    for position in 0 .. < tables.layouts.rows[row-layout].fields.count
        . field = tables.layouts.field(row-layout, position)
        . cell = table-cell(site, columns, length, position, field.layout)
        store-row-cell(site, cell, field.layout, take(value, field, site), meta)
.. known-case = known < tables.layouts.rows[row-layout].cases.count
put-header(site, meta.header, 1, next)
= Typed(length, types.index-type)

────────────────────
_ do wraps-case U32
    - site SyntaxId
    - reason ConversionReason
    - from TypeId

` The case of a union a value of a type is held as once converted at a site for a reason,
` where the one conversion recorded there wraps it as that case, as `wrap-case` says; or
` `U32.max` where the conversions there are any other.
. found = U32.max
. fact = facts.first-conversion(unit.reading, site)
while fact != no-fact
    . row = facts.conversions[fact]
    if row.reason == reason
        if found != U32.max || row.from != from || runs-or-casts || not-case-wrap
            = U32.max
        .. runs-or-casts = row.runs != no-instance || row.casts
        .. not-case-wrap = row.kind != .relation-wrap-cast || row.case-index == U32.max
        found = row.case-index
    fact = row.next
= found

────────────────────
_ do table-extend
    - site SyntaxId
    - table Operand
    - layout LayoutId
    - row TypeId
    - row-layout LayoutId
    - rows Operand
    - rows-type TypeId

` `t.extend(rows)`, as TypeScript answers it: each row of the array is appended in turn, each
` with every check of `append`.
. array-layout = layout-of(rows-type, site)
. data = word-at(site, rows, array-layout, 0)
. size = word-at(site, rows, array-layout, 1)
. stride = integer(.machine-u64, tables.layouts.rows[row-layout].size)
. counting = open-pass(site, size)
. index = counting.index
. item = num-cast
    - site
    - arithmetic
        - site
        - .arithmetic-add
        - data
        - arithmetic(site, .arithmetic-multiply, index, stride, u64-layout)
        - u64-layout
    - u64-layout
    - pointer-layout
table-append(site, table, layout, row, row-layout, item)
close-pass(site, counting)

────────────────────
_ do table-truncate
    - site SyntaxId
    - table Operand
    - layout LayoutId
    - requested Operand

` `t.truncate(n)`, as TypeScript answers it: the table is checked to grow and to hold at least
` as many rows; where it holds more, its views and marks are made stale and the length set.
. meta = require-growable(site, table, layout, "truncate")
. length = header-word(site, meta.header, 1)
fail-if
    - site
    - compare(site, .compare-greater, requested, length)
    - "Table truncate length exceeds current length"
. shrinking = ir.reserve-block()
. joined = ir.reserve-block()
branch(compare(site, .compare-less, requested, length), shrinking, joined)
ir.start-block(shrinking)
count-on(site, meta.header, 3)
count-on(site, meta.header, 4)
put-header(site, meta.header, 1, requested)
jump(joined)
ir.start-block(joined)

────────────────────
_ do table-copy-from
    - site SyntaxId
    - table Operand
    - layout LayoutId
    - row TypeId
    - row-layout LayoutId
    - source Operand

` `t.copy-from(s)`, as TypeScript answers it: the table is checked to grow, and unless it is
` the source itself, its views and marks are made stale and it is emptied; the source's
` columns and length are read, checked where it grows, room made for its rows, and each
` field's column copied over; the length is then the source's.
. meta = require-growable(site, table, layout, "copy-from")
. other = part(source, layout, 2, site)
. copying = ir.reserve-block()
. joined = ir.reserve-block()
branch(compare(site, .compare-not-equal, meta.header, other.operand), copying, joined)
ir.start-block(copying)
count-on(site, meta.header, 3)
count-on(site, meta.header, 4)
put-header(site, meta.header, 1, integer(.machine-u64, 0))
put-header(site, meta.header, 6, integer(.machine-u64, 0))
. given = TableMeta
    - other.operand
    - part(source, layout, 3, site).operand
    - part(source, layout, 4, site).operand
    - part(source, layout, 5, site).operand
    - integer(.machine-u64, 0)
. rows = table-rows(site, source, layout, given)
. columns = rows.columns
. length = rows.length
reserve-rows(site, row, row-layout, meta, length)
. into = num-cast(site, header-word(site, meta.header, 0), u64-layout, pointer-layout)
if types.intrinsic-of(row) == .union
    . zero = integer(.machine-u64, 0)
    copy-union-rows(site, tables.unions.of(row), into, zero, columns, zero, length, meta, false)
else
    for position in 0 .. < tables.layouts.rows[row-layout].fields.count
        . field = tables.layouts.field(row-layout, position)
        . target = load(into, position * 8, pointer-layout, site)
        . out = load(columns, position * 8, pointer-layout, site)
        copy-items(site, target, out, length, field.layout)
put-header(site, meta.header, 1, length)
jump(joined)
ir.start-block(joined)

────────────────────
_ do table-finish Typed
    - site SyntaxId
    - table Operand
    - layout LayoutId

` `t.finish()`, as TypeScript answers it: the table is checked to grow, its columns and length
` read, and its header sealed; the answer is the finished table of those columns and that
` length.
. type = facts.node-type(unit.reading, site)
. finished-layout = layout-of(type, site)
if intrinsic(type) != .immutable-table
    refuse(.refused-expression, site)
    = Typed(make-operand(.operand-void, 0), no-type)
. meta = require-growable(site, table, layout, "finish")
. columns = header-word(site, meta.header, 0)
. length = header-word(site, meta.header, 1)
put-header(site, meta.header, 0, integer(.machine-u64, 0))
. made = frame(finished-layout)
put-word(site, made, finished-layout, 0, columns, u64-layout)
put-word(site, made, finished-layout, 1, length, u64-layout)
= Typed(made, type)

────────────────────
_ do viewed-table Typed
    - site SyntaxId
    - table Operand
    - layout LayoutId

` `t.view()`, as TypeScript answers it: the table is checked to grow, and the answer is the
` finished table of its columns and its length now, which the table goes on growing apart from.
. type = facts.node-type(unit.reading, site)
. viewed-layout = layout-of(type, site)
if intrinsic(type) != .immutable-table
    refuse(.refused-expression, site)
    = Typed(make-operand(.operand-void, 0), no-type)
. meta = require-growable(site, table, layout, "view")
. made = frame(viewed-layout)
put-word(site, made, viewed-layout, 0, header-word(site, meta.header, 0), u64-layout)
put-word(site, made, viewed-layout, 1, header-word(site, meta.header, 1), u64-layout)
= Typed(made, type)

────────────────────
_ do table-rewind
    - site SyntaxId
    - table Operand
    - layout LayoutId
    - mark Operand
    - mark-type TypeId

` `t.rewind(m)`, as TypeScript answers it: the table is checked to grow, and the mark to be of
` this table, its arena and generation, with no row written since and no more rows than it
` has now; the length and the use of the spill are then the mark's, and the shrink generation
` is counted on.
. mark-layout = layout-of(mark-type, site)
. meta = require-growable(site, table, layout, "rewind")
. stale = "Table mark is stale or belongs to another table"
fail-if
    - site
    - compare(site, .compare-not-equal, meta.header, word-at(site, mark, mark-layout, 0))
    - stale
fail-if
    - site
    - compare(site, .compare-not-equal, meta.owner, word-at(site, mark, mark-layout, 1))
    - stale
fail-if
    - site
    - compare(site, .compare-not-equal, meta.incarnation, word-at(site, mark, mark-layout, 2))
    - stale
fail-if
    - site
    - compare(site, .compare-not-equal, meta.generation, word-at(site, mark, mark-layout, 3))
    - stale
fail-if
    - site
    - compare
        - site
        - .compare-not-equal
        - header-word(site, meta.header, 4)
        - word-at(site, mark, mark-layout, 5)
    - stale
. length = word-at(site, mark, mark-layout, 4)
fail-if(site, compare(site, .compare-greater, length, header-word(site, meta.header, 1)), stale)
put-header(site, meta.header, 1, length)
put-header(site, meta.header, 6, word-at(site, mark, mark-layout, 6))
count-on(site, meta.header, 3)

────────────────────
_ do table-checkpoint Typed
    - site SyntaxId
    - table Operand
    - layout LayoutId
    - arena Operand
    - arena-type TypeId
    - mark Operand
    - mark-type TypeId

` `t.storage-checkpoint(arena, mark)`, as TypeScript answers it: the table is checked to grow,
` to be held by the arena, and the mark to be the arena's mark now; the checkpoint holds the
` table's identity, the mark, the arena's active bytes, and each word of the header.
. type = facts.node-type(unit.reading, site)
. made-layout = layout-of(type, site)
. arena-layout = layout-of(arena-type, site)
. mark-layout = layout-of(mark-type, site)
. meta = require-growable(site, table, layout, "storage-checkpoint")
. owner = part(arena, arena-layout, 0, site)
. incarnation = part(arena, arena-layout, 1, site)
. value = word-at(site, mark, mark-layout, 0)
. stale = "Table storage checkpoint mark is stale or belongs to another Arena"
fail-if
    - site
    - compare(site, .compare-not-equal, meta.owner, word-at(site, arena, arena-layout, 0))
    - stale
fail-if(site, compare(site, .compare-not-equal, meta.incarnation, incarnation.operand), stale)
. mark-at = pending.length
pending += owner.operand
pending += incarnation.operand
. current = call-runtime(.runtime-arena-mark, site, mark-at, u64-layout)
fail-if(site, compare(site, .compare-not-equal, value, current), stale)
pending += owner.operand
pending += incarnation.operand
. active = call-runtime(.runtime-arena-active-bytes, site, mark-at, u64-layout)
. made = frame(made-layout)
put-word(site, made, made-layout, 0, meta.header, u64-layout)
put-word(site, made, made-layout, 1, meta.owner, u64-layout)
put-word(site, made, made-layout, 2, meta.incarnation, u64-layout)
put-word(site, made, made-layout, 3, meta.generation, u64-layout)
put-word(site, made, made-layout, 4, value, u64-layout)
put-word(site, made, made-layout, 5, active, u64-layout)
for position in 0 .. < 8u32
    put-word
        - site
        - made
        - made-layout
        - position + 6
        - header-word(site, meta.header, position)
        - u64-layout
= Typed(made, type)

────────────────────
_ do table-restore
    - site SyntaxId
    - table Operand
    - layout LayoutId
    - passed [Operand]
    - checkpoint-type TypeId
    - arena-type TypeId
    - mark-type TypeId
    - restores Bool

` `t.validate-storage-restore(c, arena, mark)` and `t.restore-storage(…)`, as TypeScript answers
` them: the table is checked to grow, and the checkpoint to be of this table, its arena and
` generation, at the arena's mark, with no row written since, the arena's active bytes not
` fewer (or, to restore, the same), and no more rows than the table has now. Restoring then
` gives the header each word the checkpoint holds, with its generations counted on.
. checkpoint-layout = layout-of(checkpoint-type, site)
. arena-layout = layout-of(arena-type, site)
. mark-layout = layout-of(mark-type, site)
. checkpoint = passed[0]
. meta = require-growable(site, table, layout, "storage checkpoint restore")
. owner = part(passed[1], arena-layout, 0, site)
. incarnation = part(passed[1], arena-layout, 1, site)
. value = word-at(site, passed[2], mark-layout, 0)
. mark-at = pending.length
pending += owner.operand
pending += incarnation.operand
. generation = call-runtime(.runtime-arena-generation, site, mark-at, u64-layout)
pending += owner.operand
pending += incarnation.operand
. active = call-runtime(.runtime-arena-active-bytes, site, mark-at, u64-layout)
. stale = if restores then "Table storage checkpoint cannot be restored from the current Arena state" else "Table storage checkpoint is stale or belongs to another table"
fail-if
    - site
    - compare
        - site
        - .compare-not-equal
        - meta.header
        - word-at(site, checkpoint, checkpoint-layout, 0)
    - stale
fail-if
    - site
    - compare(site, .compare-not-equal, meta.owner, word-at(site, checkpoint, checkpoint-layout, 1))
    - stale
fail-if
    - site
    - compare
        - site
        - .compare-not-equal
        - meta.incarnation
        - word-at(site, checkpoint, checkpoint-layout, 2)
    - stale
fail-if
    - site
    - compare
        - site
        - .compare-not-equal
        - meta.generation
        - word-at(site, checkpoint, checkpoint-layout, 3)
    - stale
fail-if
    - site
    - compare(site, .compare-not-equal, meta.owner, word-at(site, passed[1], arena-layout, 0))
    - stale
fail-if(site, compare(site, .compare-not-equal, meta.incarnation, incarnation.operand), stale)
fail-if(site, compare(site, .compare-not-equal, meta.generation, generation), stale)
fail-if
    - site
    - compare(site, .compare-not-equal, word-at(site, checkpoint, checkpoint-layout, 4), value)
    - stale
fail-if
    - site
    - compare
        - site
        - .compare-not-equal
        - header-word(site, meta.header, 4)
        - word-at(site, checkpoint, checkpoint-layout, 10)
    - stale
. saved = word-at(site, checkpoint, checkpoint-layout, 5)
. fewer = compare(site, if restores then .compare-not-equal else .compare-less, active, saved)
fail-if(site, fewer, stale)
fail-if
    - site
    - compare
        - site
        - .compare-greater
        - word-at(site, checkpoint, checkpoint-layout, 7)
        - header-word(site, meta.header, 1)
    - stale
. most = integer(.machine-u64, U64.max)
. shrink = word-at(site, checkpoint, checkpoint-layout, 9)
. mutation = word-at(site, checkpoint, checkpoint-layout, 10)
. checking = ir.reserve-block()
. overflowed = ir.reserve-block()
. passed = ir.reserve-block()
branch(compare(site, .compare-equal, shrink, most), overflowed, checking)
ir.start-block(checking)
branch(compare(site, .compare-equal, mutation, most), overflowed, passed)
ir.start-block(overflowed)
raise-text(site, "Table generation overflow")
ir.start-block(passed)
if !restores
    =
for position in 0 .. < 8u32
    . word = word-at(site, checkpoint, checkpoint-layout, position + 6)
    if position == 3 || position == 4
        word = arithmetic(site, .arithmetic-add, word, integer(.machine-u64, 1), u64-layout)
    put-header(site, meta.header, position, word)

────────────────────
+ do table-column Typed
    - id SyntaxId
    - table Operand
    - type TypeId
    - layout LayoutId

` A view of a field's column of a table or of a span of one at `t.f`.
= table-view(id, table, type, layout, table-slot(id), facts.node-type(unit.reading, id))

────────────────────
+ do table-view Typed
    - id SyntaxId
    - table Operand
    - type TypeId
    - layout LayoutId
    - slot U32
    - view TypeId

` A view of a field's column of a table or of a span of one, as TypeScript makes one: where
` the column's data is from the first row, left out where the table grows, how many rows there
` are, and what says whether the table can still be read, with the table's columns, the
` field's place among them and the first row. That of a finished table is where its data is
` and how many rows there are. A shared field of a table of unions is viewed in its own column.
. none = make-operand(.operand-void, 0)
. row = table-row-type(type)
. view-layout = layout-of(view, id)
. column = shared-column(id, row, slot)
. row-layout = if column == U32.max then layout-of(row, id) else layout-of(types.cases-of(row)[0].type, id)
if column == U32.max
    column = slot
. immutable = is-immutable-view(intrinsic(type))
. viewing = if immutable then IntrinsicKind.immutable-table-column else IntrinsicKind.table-column
if intrinsic(view) != viewing || slot >= tables.layouts.rows[row-layout].fields.count
    refuse(.refused-expression, id)
    = Typed(none, no-type)
. field = tables.layouts.field(row-layout, slot)
if viewed-item(view) != field.type
    refuse(.refused-expression, id)
    = Typed(none, no-type)
. source = table-source(id, table, type, layout)
if immutable
    . made = frame(view-layout)
    put
        - made
        - tables.layouts.field(view-layout, 0)
        - num-cast
            - id
            - table-cell(id, source.columns, source.offset, column, field.layout)
            - pointer-layout
            - managed-layout
        - id
    put(made, tables.layouts.field(view-layout, 1), source.length, id)
    = Typed(made, view)
. meta = source.meta
. data = table-cell(id, source.columns, source.offset, column, field.layout)
. made = frame(view-layout)
put(made, tables.layouts.field(view-layout, 0), view-columns(id, meta, data), id)
put(made, tables.layouts.field(view-layout, 1), source.length, id)
put(made, tables.layouts.field(view-layout, 2), meta.header, id)
put(made, tables.layouts.field(view-layout, 3), source.columns, id)
put(made, tables.layouts.field(view-layout, 4), integer(.machine-u64, column), id)
put(made, tables.layouts.field(view-layout, 5), source.offset, id)
put(made, tables.layouts.field(view-layout, 6), meta.owner, id)
put(made, tables.layouts.field(view-layout, 7), meta.incarnation, id)
put(made, tables.layouts.field(view-layout, 8), meta.generation, id)
put(made, tables.layouts.field(view-layout, 9), meta.shrink, id)
= Typed(made, view)

────────────────────
_ do shared-column U32
    - id SyntaxId
    - row TypeId
    - slot U32

` The column of a table of unions that holds the shared field at a place in the first case, or
` `U32.max` where the rows are structs. A table of unions with no such field has no shape.
if types.intrinsic-of(row) == .struct
    = U32.max
. place = tables.unions.of(row)
if place == U32.max
    refuse(.refused-expression, id)
    = U32.max
. union = tables.unions.layouts[place]
for position in 0 .. < union.commons.count
    . common = tables.unions.fields[union.commons.start + position]
    if common.slot == slot
        = common.column
refuse(.refused-expression, id)
= U32.max

────────────────────
_ do row-cursor TableCursor
    - id SyntaxId
    - object SyntaxId

` The row a field of a row is read or written through: the cursor `t[i]` makes where the row
` is written there, and else the row's value, whose columns are checked again where its table
` grows. A row of a finished table holds its columns itself.
. none = make-operand(.operand-void, 0)
. empty = TableCursor(none, none, TableMeta(none, none, none, none, none))
do match? tree.nodes[object]
    | .node-index-expression(row)
        if facts.plan-of(unit.reading, object) == .plan-table && !is-link(object)
            . cursor = if table-op(object) == TableOp.selection-row then selection-cursor(object, row.object, row.index) else table-cursor(object, row.object, row.index)
            = TableCursor
                - cursor.columns
                - cursor.index
                - TableMeta
                    - cursor.meta.header
                    - cursor.meta.owner
                    - cursor.meta.incarnation
                    - cursor.meta.generation
                    - cursor.meta.shrink
. value = emit-expression(object)
. type = value.type
. proven = proven-item(object)
if proven != U32.max && intrinsic(type) == .table-row
    . layout = layout-of(type, id)
    = TableCursor(proven-items[proven].columns, part(value.operand, layout, 1, id).operand, no-meta())
= value-cursor(id, value.operand, type)

────────────────────
+ do value-cursor TableCursor
    - id SyntaxId
    - value Operand
    - type TypeId

` The columns and the index of a row held as a value. Where its table grows the table is
` checked and its columns read from the header.
. none = make-operand(.operand-void, 0)
. empty = TableCursor(none, none, TableMeta(none, none, none, none, none))
. kind = intrinsic(type)
if kind != .table-row && kind != .immutable-table-row
    refuse(.refused-expression, id)
    = empty
. layout = layout-of(type, id)
if kind == .immutable-table-row
    . zero = integer(.machine-u64, 0)
    = TableCursor
        - part-address(id, value, layout, 0).operand
        - part(value, layout, 1, id).operand
        - TableMeta(zero, zero, zero, zero, zero)
. meta = row-meta(id, value, layout)
. growing = ir.reserve-block()
. fixed = ir.reserve-block()
. joined = ir.reserve-block()
branch(view-grows(id, meta), growing, fixed)
ir.start-block(growing)
validate-table(id, meta, "TableRow", true)
. held = num-cast(id, header-word(id, meta.header, 0), u64-layout, pointer-layout)
. from-growing = ir.current
jump(joined)
ir.start-block(fixed)
. own = num-cast(id, part(value, layout, 0, id).operand, managed-layout, pointer-layout)
. from-fixed = ir.current
jump(joined)
ir.start-block(joined)
. columns = phi(pointer-layout, held, from-growing, own, from-fixed)
= TableCursor(columns, part(value, layout, 1, id).operand, meta)

────────────────────
+ do emit-table-field Typed
    - id SyntaxId
    - object SyntaxId

` A field of a row read from its column, or a shared field of a row of unions from its own.
` An optional field a test narrowed is read as what it holds, with no test.
. none = make-operand(.operand-void, 0)
if table-op(id) != TableOp.table-field
    refuse(.refused-expression, id)
    = Typed(none, no-type)
. cursor = row-cursor(id, object)
. row = table-row-type(facts.node-type(unit.reading, object))
. column = shared-column(id, row, table-slot(id))
. row-layout = if column == U32.max then layout-of(row, id) else layout-of(types.cases-of(row)[0].type, id)
. field = tables.layouts.field(row-layout, table-slot(id))
. place = if column == U32.max then table-slot(id) else column
. proven = proven-table(object)
. read = make-operand(.operand-void, 0)
if proven == U32.max
    read = take
        - table-cell(id, cursor.columns, cursor.index, place, field.layout)
        - LayoutField(0, field.layout, field.type)
        - id
else
    read = proven-field(id, proven-tables[proven].loop, place, cursor.index, field)
. typed = facts.node-type(unit.reading, id)
if typed != field.type && types.is-optional(field.type) && types.optional-inner(field.type) == typed
    = payload(id, Typed(read, field.type))
= Typed(read, field.type)

────────────────────
+ do emit-table-field-assign Assignment
    - id SyntaxId
    - op Operator
    - lhs SyntaxId
    - object SyntaxId
    - rhs SyntaxId

` A field of a row written in its column, as TypeScript writes it: the value is read, then the
` row, and the value, converted to the field's type, is stored; where the table grows the
` table is then checked and its mutation generation counted on. An assigning operator reads
` the field through the row first, and the row is read again for the store.
if table-op(lhs) != TableOp.table-field
    refuse(.refused-statement, id)
    = Assignment()
. given = Typed(make-operand(.operand-void, 0), no-type)
. increment = increment-base(op)
if op == .eq-op
    . made = emit-expression(rhs)
    given = Typed(apart(made, rhs, !is-inert(object)), made.type)
else if increment && facts.plan-of(unit.reading, id) == .plan-builtin
    given = emit-builtin(id, increment, lhs, rhs, true)
else
    refuse(.refused-statement, id)
. cursor = row-cursor(lhs, object)
. row = table-row-type(facts.node-type(unit.reading, object))
. column = shared-column(lhs, row, table-slot(lhs))
. row-layout = if column == U32.max then layout-of(row, lhs) else layout-of(types.cases-of(row)[0].type, lhs)
. field = tables.layouts.field(row-layout, table-slot(lhs))
. value = convert(id, .reason-assignment, given)
if value.type != field.type
    refuse(.refused-conversion, rhs)
. cell = table-cell
    - lhs
    - cursor.columns
    - cursor.index
    - if column == U32.max then table-slot(lhs) else column
    - field.layout
store-row-cell(lhs, cell, field.layout, value.operand, cursor.meta)
invalidate-marks(lhs, cursor.meta)
= Assignment(Typed(value.operand, field.type), given)

────────────────────
+ do store-row-cell
    - site SyntaxId
    - cell Operand
    - layout LayoutId
    - value Operand
    - meta TableMeta

` Stores a field in its cell: plainly where the table grows in an arena, and through the
` collector's barrier, where the field holds pointers it follows, where it does not.
if !tables.layouts.rows[layout].is-managed
    store-cell(site, cell, layout, value)
    =
. growing = ir.reserve-block()
. fixed = ir.reserve-block()
. joined = ir.reserve-block()
branch(view-grows(site, meta), growing, fixed)
ir.start-block(growing)
if tables.layouts.is-struct(layout)
    copy(cell, value, layout, false, site)
else
    store(cell, 0, value, false, site)
jump(joined)
ir.start-block(fixed)
store-cell(site, cell, layout, value)
jump(joined)
ir.start-block(joined)

────────────────────
+ do invalidate-marks
    - site SyntaxId
    - meta TableMeta

` After a row of a table that grows is written: the table is checked, and its mutation
` generation counted on, which makes its marks stale.
. growing = ir.reserve-block()
. joined = ir.reserve-block()
branch(view-grows(site, meta), growing, joined)
ir.start-block(growing)
validate-table(site, meta, "Table view", true)
. current = header-word(site, meta.header, 4)
fail-if
    - site
    - compare(site, .compare-equal, current, integer(.machine-u64, U64.max))
    - "Table generation overflow"
. next = arithmetic(site, .arithmetic-add, current, integer(.machine-u64, 1), u64-layout)
store(num-cast(site, meta.header, u64-layout, pointer-layout), 32, next, false, site)
jump(joined)
ir.start-block(joined)

────────────────────
+ do emit-table-store
    - id SyntaxId
    - object SyntaxId
    - key SyntaxId
    - rhs SyntaxId

` `t[i] = v` of a table or of a span of one, as TypeScript stores it: the row is read, then the
` table and the index, converted to one; the columns are found, the index checked against the
` length, and the row, converted to the table's, has each field stored in its column; where the
` table grows its mutation generation is then counted on.
if table-op(id) != TableOp.table-store
    refuse(.refused-statement, id)
    =
. made = emit-expression(rhs)
. given = apart(made, rhs, !is-inert(object) || !is-inert(key))
. given-type = made.type
. table = emit-expression(object)
. type = table.type
. index = convert(key, .reason-argument, emit-expression(key))
if index.type != types.index-type
    refuse(.refused-conversion, key)
. row = table-row-type(type)
. kind = intrinsic(type)
. row-kind = types.intrinsic-of(row)
if (kind != .table && kind != .table-span) || (row-kind != .struct && row-kind != .union)
    refuse(.refused-statement, id)
    =
. layout = layout-of(type, id)
. row-layout = layout-of(row, id)
. place = row-place(id, table.operand, type, layout, index.operand)
. given-kind = intrinsic(given-type)
if row-kind == .union && given-row && table-row-type(given-type) == row
    copy-row-into(id, row, place, rhs, given, given-type)
    =
.. given-row = given-kind == .table-row || given-kind == .immutable-table-row
. known = if row-kind == .union then wraps-case(rhs, .reason-argument, given-type) else U32.max
. value = convert(rhs, .reason-argument, Typed(given, given-type))
if value.type != row
    refuse(.refused-conversion, rhs)
if row-kind == .union
    store-union-row(id, row, place, value.operand, known)
    invalidate-marks(id, place.meta)
    =
for position in 0 .. < tables.layouts.rows[row-layout].fields.count
    . field = tables.layouts.field(row-layout, position)
    . cell = table-cell(id, place.columns, place.index, position, field.layout)
    store-row-cell(id, cell, field.layout, take(value.operand, field, id), place.meta)
invalidate-marks(id, place.meta)

────────────────────
_ do store-union-row
    - id SyntaxId
    - row TypeId
    - place TableCursor
    - value Operand
    - known U32 = U32.max

` `t[i] = v` of a table of unions: the union scattered into its row, with the table's
` metadata. One known to hold one case, as `wraps-case` finds it, is scattered as that case
` with no other tested.
. union = tables.unions.of(row)
if union == U32.max
    refuse(.refused-statement, id)
    =
. layout = layout-of(row, id)
if known != U32.max && known < tables.layouts.rows[layout].cases.count
    scatter-union-case
        - id
        - union
        - known
        - place.columns
        - place.index
        - take(value, tables.layouts.case-field(layout, known), id)
        - place.meta
        - true
        - true
    =
scatter-union(id, union, place.columns, place.index, value, place.meta, true, true)

────────────────────
_ do copy-row-into
    - id SyntaxId
    - row TypeId
    - place TableCursor
    - rhs SyntaxId
    - given Operand
    - given-type TypeId

` `t[i] = r` of a table of unions where `r` is a row of one: TypeScript copies the row's cells
` rather than gathering it, then counts on the target's mutation generation.
. union = tables.unions.of(row)
if union == U32.max
    refuse(.refused-statement, id)
    =
. source = value-cursor(rhs, given, given-type)
copy-union-row(id, union, place.columns, place.index, source.columns, source.index, place.meta, true)
invalidate-marks(id, place.meta)

────────────────────
+ do table-row-item Typed
    - site SyntaxId
    - value Operand
    - from TypeId

` A row of a table as the item it reads: gathered from the columns, field by field, or for a
` table of unions by the case its tag names.
. layout = layout-of(from, site)
. row = table-row-type(from)
. row-layout = layout-of(row, site)
. union = if types.intrinsic-of(row) == .union then tables.unions.of(row) else U32.max
if types.intrinsic-of(row) != .struct && union == U32.max
    refuse(.refused-conversion, site)
    = Typed(value, no-type)
if intrinsic(from) == .immutable-table-row
    . columns = part-address(site, value, layout, 0)
    . index = part(value, layout, 1, site)
    . held = if union != U32.max then gather-union(site, union, columns.operand, index.operand).operand else gather-row(site, row-layout, columns.operand, index.operand)
    = Typed(held, row)
. meta = row-meta(site, value, layout)
. growing = ir.reserve-block()
. fixed = ir.reserve-block()
. joined = ir.reserve-block()
branch(view-grows(site, meta), growing, fixed)
ir.start-block(growing)
validate-table(site, meta, "TableRow", true)
. held = num-cast(site, header-word(site, meta.header, 0), u64-layout, pointer-layout)
. from-growing = ir.current
jump(joined)
ir.start-block(fixed)
. own = num-cast(site, part(value, layout, 0, site).operand, managed-layout, pointer-layout)
. from-fixed = ir.current
jump(joined)
ir.start-block(joined)
. columns = phi(pointer-layout, held, from-growing, own, from-fixed)
. index = part(value, layout, 1, site)
. gathered = if union != U32.max then gather-union(site, union, columns, index.operand).operand else gather-row(site, row-layout, columns, index.operand)
= Typed(gathered, row)

────────────────────
+ do shared-base Typed
    - site SyntaxId
    - value Operand
    - from TypeId
    - to TypeId

` A row of a table of unions made the base its cases share, as TypeScript builds it: each of
` the base's fields read from the column the cases share for it.
. row = table-row-type(from)
. first = types.cases-of(row)[0].type
. layout = layout-of(to, site)
. first-layout = layout-of(first, site)
if !tables.layouts.is-struct(layout)
    refuse(.refused-conversion, site)
    = Typed(value, no-type)
. cursor = value-cursor(site, value, from)
. made = frame(layout)
for property in types.properties-of(to)
    if property.slot == U32.max
        continue
    . found = types.property-named(first, property.name)
    if !found
        refuse(.refused-conversion, site)
        break
    . slot = types.properties[found].slot
    . column = shared-column(site, row, slot)
    . held = tables.layouts.field(first-layout, slot)
    . cell = table-cell(site, cursor.columns, cursor.index, column, held.layout)
    put
        - made
        - tables.layouts.field(layout, property.slot)
        - take(cell, LayoutField(0, held.layout, held.type), site)
        - site
= Typed(made, to)
