ir.start-block(testing)
. current = load-local(counter, site)
. going = if backward then compare(site, .compare-greater, current, integer(.machine-u64, 0)) else compare(site, .compare-less, current, count)
branch(going, copying, copied)
ir.start-block(copying)
. row = load-local(counter, site)
if backward
