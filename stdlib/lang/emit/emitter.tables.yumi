    - site
    - .compare-equal
    - num-cast(site, into, pointer-layout, u64-layout)
    - num-cast(site, out, pointer-layout, u64-layout)
. checking = ir.reserve-block()
. moving = ir.reserve-block()
. done = ir.reserve-block()
branch(same, checking, moving)
ir.start-block(checking)
branch(compare(site, .compare-equal, target, source), done, moving)
ir.start-block(moving)
. union = tables.unions.layouts[place]
. tag = load(table-cell(site, out, source, 0, u8-layout), 0, u8-layout, site)
for position in 0 .. < union.cases.count
    . reading = ir.reserve-block()
    . next = ir.reserve-block()
