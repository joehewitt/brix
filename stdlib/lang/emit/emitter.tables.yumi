. target = arithmetic(site, .arithmetic-add, start, row, u64-layout)
. source = arithmetic(site, .arithmetic-add, from, row, u64-layout)
copy-union-row(site, place, into, target, out, source, meta, replacing)
store-local(counter, if backward then row else arithmetic(site, .arithmetic-add, row, integer(.machine-u64, 1), u64-layout), site)
