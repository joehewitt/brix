      (call make-operand
        (block
          (arg .operand-value)
          (arg (call append .op-local-address id (call Span) (. cells ended) pointer-layout))
        )
      )
    )
    (+= pending
      (call make-operand
        (block
          (arg .operand-value)
          (arg (call append .op-local-address id (call Span) (. cells reached) pointer-layout))
        )
      )
    )
    (+= pending
      (call make-operand
        (block
          (arg .operand-value)
          (arg (call append .op-local-address id (call Span) (. cells erred) pointer-layout))
        )
      )
    )
  )
  (fn-do _ take-rule-answer StreamPart
    (param run StreamRun)
    (param id SyntaxId)
    (param result TypeId)
    (param cursor Operand)
    (param failed IRBlockId)
    (param cells RuleCells)
    (param answer Typed)
    (param given-mark LocalId)
    (param lendings (list Lending))
    (param mapped Bool)
    (param spanned Bool)
    ; What a part that called a rule gives once the rule answered: the collectors it lent are taken
    ; back and how far it read and where it failed are recorded; where its answer holds nothing the
    ; part fails, and otherwise it ends where the rule stopped, giving what it read where the rule
    ; is `mapped` or the part `spanned`, and otherwise what the answer holds, of type `result`.
