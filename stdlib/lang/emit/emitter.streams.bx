(import ./emitter)
(import ./emitter.cleanups)
(import ./emitter.loops)
(import ./emitter.match-arms)
(import ./emitter.tables)
(import ./first-items)
(import ./layouts)
(import ./program-tables)
(import ./receiver-stability)
(import ./runtime)
(import ./table-layouts)
(import /core/arena)
(import /core/table)
(import /lang/ast/ast)
(import /lang/ast/ast-children)
(import /lang/ast/ast-nodes)
(import /lang/ast/ast-queries)
(import /lang/ast/decl)
(import /lang/ast/module)
(import /lang/ast/operator)
(import /lang/ast/program)
(import /lang/ast/row-range)
(import /lang/ast/state-machines)
(import /lang/backend/mir)
(import /lang/check/binding)
(import /lang/check/claims)
(import /lang/check/facts)
(import /lang/check/instances)
(import /lang/check/machine-composite)
(import /lang/check/numeric)
(import /lang/check/pattern-helper)
(import /lang/check/probe-casts)
(import /lang/check/table-rows)
(import /lang/check/type-signature)
(import /lang/check/type-store)
(import /lang/check/type-text)
(import /lang/check/types)
(import /lang/ir/ir)
(import /stream/sort)

(type _ RuleCells (is Tuple)
  ; The locals a rule a part calls writes: where it stopped, how far it read and where it failed.
  (blank)
  (prop + ended LocalId)
  (prop + reached LocalId)
  (prop + erred LocalId)
)

(type _ Lending (is Tuple)
  ; A list of the caller's a call lends a function, as a collector in memory of the frame:
  ; that memory, and the list among the lists of captures.
  (blank)
  (prop + memory Operand)
  (prop + level U32)
)

(type _ LevelMark (is Tuple)
  ; How many items a list held where a part of a pattern began, which it is cut back to where
  ; the part fails: the list among the lists of captures, and the local that holds the count.
  (blank)
  (prop + level U32)
  (prop + mark LocalId)
)

(type _ ArmGroup (is Tuple)
  ; Alternatives of a choice that may start with the same items, as the reference groups them:
  ; their places, in order, and the ranges of the items any of them may start with.
  (blank)
  (prop + arms (list U32))
  (prop + ranges (list ItemRange))
)

(type _ ArmWay (is Tuple)
  ; How the alternatives of a choice are emitted: as the arms of a match or a rule, which join
  ; with the value each gives, of the type `result`, after reading the whole input where
  ; `whole`, and keep where each ended in `end`; or as `parts` of a pattern, which join with
  ; where each ended, and where the choice gives a value leave theirs, of the type `result`, in
  ; `end`. `site` is the choice. `unread` says nothing reads the value arms join with.
  (blank)
  (prop + site SyntaxId)
  (prop + result TypeId)
  (prop + whole Bool)
  (prop + end LocalId)
  (prop + joined IRBlockId)
  (prop + slot Operand)
  (prop + parts Bool)
  (prop + unread Bool)
)


(type _ Streams (facet-of FunctionEmitter)
  (sees Cleanups)
  (sees Loops)
  (sees MatchArms)
  (sees Tables)
  (prop _ scanning _ (= false))
  (prop _ deferred-part U64 (= (. U64 max)))
  (prop _ adapting FunctionId (= no-function))
  (fn-do _ pattern-value Typed
    (param arg SyntaxId)
    ; A pattern given to a rule, as the value of the function type the rule's parameter takes:
    ; the function made of it, or the one that runs the rule it calls alone, with no data. One
    ; made of a pattern that is given what names hold has as its data the address of memory of
    ; the frame that holds them, each read here as it is where the pattern is passed.
    (let nothing (call make-operand .operand-void 0))
    (let helper (call (. tables pattern-argument-of) (. unit reading) arg))
    (let type (call (. facts node-type) (. unit reading) arg))
    (let layout (call layout-of type arg))
    (if (or (== helper no-function) (!= layout (. tables layouts function-layout)))
      (call refuse .refused-expression arg)
      (return (call Typed nothing no-type))
    )
    (let target ([] (. tables functions) helper))
    (let row ([] (. facts pattern-arguments) (. target place)))
    (let data (call integer .machine-pointer 0))
    (if (and (== (. target kind) .pattern-helper) (!= (. row params count) 0))
      (let held (call (. tables pattern-environment) (. target place)))
      (if (== held no-layout)
        (call refuse .refused-expression arg)
        (return (call Typed nothing no-type))
      )
      (let memory (call frame held))
      (call zero memory held)
      (for (in offset (..< 0 (. row params count)))
        (let position (+ (. row params start) offset))
        (let value (call slot-value ([] (. facts action-slots) position) arg ([] (. facts action-types) position)))
        (call put memory (call (. tables layouts field) held offset) (. value operand) arg)
      )
      (= data (call address memory 0 pointer-layout arg))
    )
    (call (. ir depend) .callee-function helper (if-expr (. target may-panic) may-panic-dependency 0u32))
    (let made (call frame layout))
    (call store made 0 (call make-operand .operand-symbol (. target symbol)) false arg)
    (call store made (. (call (. tables layouts field) layout 1) offset) data false arg)
    (return (call Typed made type))
  )
  (fn-do _ rule-argument Operand
    (param position U32)
    (param id SyntaxId)
    ; An argument the rule being emitted was given, for the function of one of its local rules:
    ; the argument, or in the function made of a pattern, what the function was given for it.
    (if (not given-slots)
      (return (call make-operand .operand-argument position))
    )
    (for (in offset (..< 0 (. unit slot-count)))
      (let slot (+ (. unit slot-start) offset))
      (if (and (== (. ([] (. bindings slots) slot) kind) .slot-argument) (call owns slot) bound-here)
        (return (. (call read-bound slot id (call (. instances argument-type) (. unit instance) position)) operand))
      )
      (lazy bound-here (and (== ([] (. unit positions) offset) position) (call is-bound slot)))
    )
    (call refuse .refused-expression id)
    (return (call make-operand .operand-void 0))
  )
  (fn-do + emit-stream-match Typed
    (param id SyntaxId)
    (param subject SyntaxId)
    (param matched SyntaxId)
    (param helper SyntaxId)
    (param is-statement Bool)
    ; A grammar run on the value a match is on, as `run-stream-match` runs it, with the
    ; helper of an enclosing match set aside while it runs.
    (let own-streaming streaming)
    (= streaming (= (. streaming pattern-helper-type) no-type))
    (let answer (call run-stream-match id subject matched helper is-statement))
    (= streaming own-streaming)
    (return answer)
  )
  (fn-do _ run-stream-match Typed
    (param id SyntaxId)
    (param subject SyntaxId)
    (param matched SyntaxId)
    (param helper SyntaxId)
    (param is-statement Bool)
    ; A grammar run on the value a match is on, as the reference runs one. The value is read into
    ; the stream the type pass chose for it, whose `pattern-view` gives the buffer, where the pattern
    ; starts and how many items the buffer holds, through the calls the type pass recorded at the
    ; pattern, in order. The arms are tried in turn from the start, and the first that passes gives the
    ; match its value: no arm after it is tried. An arm passes only where its pattern read the whole
    ; input, but on a stream the match is given, which it reads only as far as an arm matches. Such a
    ; stream, and one made of the value that pulls its items as they are needed, may give more input as
    ; it is read: each part that reads past the end of its buffer asks it for more and goes on with what
    ; it gives. The stream then commits where the pattern ended, or where it started, and how far it
    ; read. A match whose last arm can fail is optional, and holds nothing where no arm passed. One
    ; whose last arm raises panics. The match `if` or `while` tests a pattern with gives what its arm
    ; gives, and false where no arm passed. Each name the pattern captures has its place while the arms
    ; are emitted. A helper the type pass planned is kept for the values it makes. A match on a String
    ; or an array makes its stream inside an allocation scope of the task's parse region, as
    ; TypeScript routes that stream, and gives the region back to where it stood once the match
    ; ends.
    (let nothing (call make-operand .operand-void 0))
    (let type (call (. facts node-type) (. unit reading) matched))
    (let pattern SyntaxId 0)
    (match? ([] (. tree nodes) matched)
      (case (call .node-stream-match row)
        (= pattern (. row pattern))
      )
    )
    (if (or (== pattern 0) (== type no-type) (== type invalid-type) mistyped)
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (lazy mistyped (and (not is-statement) (!= (call (. facts node-type) (. unit reading) id) type)))
    (let always (call stream-always-passes pattern))
    (let opens (== (call (. facts plan-of) (. unit reading) matched) .plan-open))
    (let result (call (. facts node-type) (. unit reading) pattern))
    (if (== result no-type)
      (call refuse .refused-expression matched)
      (return (call Typed nothing no-type))
    )
    (let layout (if-expr is-statement void-layout (call layout-of type id)))
    (let value (call emit-expression subject))
    (let subject-type (. value type))
    (if (!= helper 0)
      (let kept (call emit-expression helper))
      (if (== (call (. facts plan-of) (. unit reading) helper) .plan-pattern-helper)
        (= streaming (= (. streaming pattern-helper) (. kept operand)))
        (= streaming (= (. streaming pattern-helper-type) (. kept type)))
      )
    )
    (let made (call stream-maker matched))
    (let viewed (call (. facts call-in-role) (. unit reading) matched .role-view))
    (let commits (call (. facts call-in-role) (. unit reading) matched .role-commit))
    (let extends (call (. facts call-in-role) (. unit reading) matched .role-extend))
    (if (== commits no-fact)
      (call refuse .refused-expression matched)
      (return (call Typed nothing no-type))
    )
    (let named (. bound length))
    (let subject-slot (call arm-slot-of id .slot-it))
    (if (!= subject-slot no-slot)
      (+= bound (call BoundValue subject-slot subject-type (. value operand)))
    )
    (let regional
      (scope (or (== subject-type (. types string-type)) array-subject)
        (lazy array-subject (call same-decl (call class-ref types subject-type) (. types array-decl)))
      )
    )
    (let region-mark
      (block
        (case? regional
          (call make-operand
            (block
              (arg .operand-value)
              (arg (call append .op-load-task-word matched (call Span) parse-region-mark-offset u64-layout))
            )
          )
        )
        (default
          nothing
        )
      )
    )
    (let run (call open-stream matched (. value operand) subject-type made viewed extends regional))
    (let done (call (. ir reserve-block)))
    (let slot (if-expr is-statement nothing (call join-slot layout)))
    (let mark (. joins length))
    (let failed (call (. ir reserve-block)))
    (let given (call attempt-arms matched pattern result run (!= made no-fact) commits failed false))
    (if is-statement
      (call jump done)
      (else-if (or always opens)
        (call arrive matched (. given operand) done slot)
      )
      (else
        (call arrive matched (. (call wrap matched (call Typed (. given operand) result) type) operand) done slot)
      )
    )
    (call (. ir start-block) failed)
    (if (and opens (not is-statement))
      (call arrive matched (call integer .machine-u8 0) done slot)
      (else-if always
        (call raise-text matched "Grammar match failed")
      )
      (else-if is-statement
        (call jump done)
      )
      (else
        (call arrive matched (. (call empty-optional type layout) operand) done slot)
      )
    )
    (call drop-bound named)
    (if is-statement
      (call (. ir start-block) done)
      (call reset-region regional region-mark matched)
      (return (call Typed nothing (. types void-type)))
    )
    (let answer (call close-joins done mark layout slot))
    (call reset-region regional region-mark matched)
    (return (call Typed answer type))
  )
  (fn-do _ reset-region _
    (param regional Bool)
    (param mark Operand)
    (param site SyntaxId)
    ; Gives the task's parse region back to where it stood at a mark, where a match made its stream
    ; there.
    (if (not regional)
      (return)
    )
    (let start (. pending length))
    (+= pending mark)
    (call call-runtime .runtime-parse-region-reset site start)
  )
  (fn-do + emit-scoped-match Typed
    (param id SyntaxId)
    (param pattern SyntaxId)
    ; A grammar written in the code of a function declared over the items of a stream, run
    ; on the stream the function is given as `attempt-arms` runs one on a stream a match is
    ; given: from where the stream stands, only as far as an arm matches, asking the stream for
    ; more where a part reads past the end of its buffer. Where an arm passed it gives a
    ; `CaptureResult` of the items the pattern read, as an array that shares the buffer's, and of
    ; what the arm gave; where none did, nothing. In the code of a local rule, as `coded-call`
    ; runs it, the stream is the one the rule was called on. The helper of an enclosing match is
    ; set aside while it runs. A result it gives is counted where the type pass marked the pattern
    ; for the profile.
    (let nothing (call make-operand .operand-void 0))
    (let type (call (. facts node-type) (. unit reading) id))
    (let result (call (. facts node-type) (. unit reading) pattern))
    (let given-slot no-slot)
    (for (in offset (..< 0 (. unit slot-count)))
      (if (and (== (. ([] (. bindings slots) (+ (. unit slot-start) offset)) kind) .slot-argument) (== ([] (. unit positions) offset) 0))
        (= given-slot (+ (. unit slot-start) offset))
      )
    )
    (let coded-in (!= (. streaming given-stream-type) no-type))
    (if (or subjectless (== result no-type) not-optional)
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (lazy subjectless (and (not coded-in) (or (!= (. unit reading) (. unit instance)) (== given-slot no-slot))))
    (lazy not-optional (or (== type no-type) (== type invalid-type) (not (call (. types is-optional) type))))
    (let captured (call (. types optional-inner) type))
    (let layout (call layout-of type id))
    (let captured-layout (call layout-of captured id))
    (let viewed (call (. facts call-in-role) (. unit reading) id .role-view))
    (let commits (call (. facts call-in-role) (. unit reading) id .role-commit))
    (let extends (call (. facts call-in-role) (. unit reading) id .role-extend))
    (let counted (call call-at id .call-probe-metric))
    (if (or (== commits no-fact) (not (call holds-only id (list viewed commits extends counted))) not-capture-result)
      (call refuse .refused-expression id)
      (return (call Typed nothing no-type))
    )
    (lazy not-capture-result (not (call same-decl (call class-ref types captured) (. types capture-result-decl))))
    (if (or (not (call (. tables layouts is-struct) captured-layout)) unpaired-capture)
      (call refuse .refused-type id)
      (return (call Typed nothing no-type))
    )
    (lazy unpaired-capture (!= (. ([] (. tables layouts rows) captured-layout) fields count) 2))
    (let subject-type
      (block
        (case? coded-in
          (. streaming given-stream-type)
        )
        (default
          (call (. instances argument-type) (. unit instance) 0)
        )
      )
    )
    (let subject
      (block
        (case? coded-in
          (. streaming given-stream)
        )
        (default
          (. (call slot-value given-slot id subject-type) operand)
        )
      )
    )
    (let own-streaming streaming)
    (= streaming (= (. streaming pattern-helper-type) no-type))
    (= streaming (= (. streaming given-stream-type) no-type))
    (let run (call open-stream id subject subject-type no-fact viewed extends))
    (let done (call (. ir reserve-block)))
    (let slot (call join-slot layout))
    (let mark (. joins length))
    (let failed (call (. ir reserve-block)))
    (let given (call attempt-arms id pattern result run false commits failed false))
    (= streaming own-streaming)
    (let items-field (call (. tables layouts field) captured-layout 0))
    (let result-field (call (. tables layouts field) captured-layout 1))
    (if (or other-buffer (!= (. result-field layout) (call layout-of result id)))
      (call refuse .refused-type id)
    )
    (lazy other-buffer (!= (. items-field layout) (. run buffer-layout)))
    (let number (if-expr (!= counted no-fact) (call (. tables probe-number) (. unit reading) id) 0))
    (if (!= number 0)
      (let start (. pending length))
      (+= pending (call integer .machine-u16 number))
      (+= pending (call integer .machine-u64 1))
      (call call-runtime .runtime-profile-counter-add id start)
    )
    (let items (call stream-slice run id (. run start) (call load-local attempt-end id)))
    (let made (call frame captured-layout))
    (call put made items-field (. items operand) id)
    (call put made result-field (. given operand) id)
    (call arrive id (. (call wrap id (call Typed made captured) type) operand) done slot)
    (call (. ir start-block) failed)
    (call arrive id (. (call empty-optional type layout) operand) done slot)
    (let answer (call close-joins done mark layout slot))
    (return (call Typed answer type))
  )
  (fn-do + attempt-arms Typed
    (param site SyntaxId)
    (param pattern SyntaxId)
    (param result TypeId)
    (param run StreamRun)
    (param whole Bool)
    (param commits FactId)
    (param failure IRBlockId)
    (param keeps Bool)
    ; The arms of a grammar tried on the view of a stream, from where it starts, as the
    ; reference tries them: where the input must be read `whole`, an arm passes only where it
    ; read the whole of it. A stream that may give more input is asked for it where a part reads
    ; past the end of its buffer, and the part goes on from there. Where an arm passes, the stream
    ; commits where it ended and how far the pattern read, and what the arm gives is given, with
    ; `attempt-end` left the local that keeps where it ended; where none does, the stream commits
    ; where the pattern started, and goes on to `failure`. How far the pattern read is kept no
    ; farther than the end of the input, as `settle-extent` says. The names the pattern captures
    ; are bound while the arms are emitted, and after them where the pattern `keeps` them. A
    ; pattern the type pass found holds a rollback mark gives back the one it holds where it
    ; fails, as the reference does; the marks of a pattern it runs in are set aside while it is
    ; emitted.
    (let nothing (call make-operand .operand-void 0))
    (let arm-layout (call layout-of result site))
    (let own-streaming streaming)
    (call open-marks site)
    (= streaming (= (. streaming storage-row) (call (. facts storage-body-of) (. unit reading) site)))
    (= streaming (= (. streaming observer-row) (call (. facts observer-body-of) (. unit reading) site)))
    (let end (call (. ir add-local) (. run index-layout)))
    (let arms-joined (call (. ir reserve-block)))
    (let failed (call (. ir reserve-block)))
    (let arm-slot (call join-slot arm-layout))
    (let arms-mark (. joins length))
    (let held (. bound length))
    (let captured (. stream-captures length))
    (let arrives false)
    (if (!= adapting no-function)
      (= arrives (call adapt-arms run site result end arms-joined arm-slot failed))
      (else
        (call hold-captures run pattern)
        (call plan-choices pattern)
        (= arrives
          (call emit-stream-arms
            (block
              (arg run)
              (arg pattern)
              (arg result)
              (arg (. run start))
              (arg whole)
              (arg end)
              (arg arms-joined)
              (arg arm-slot)
              (arg failed)
            )
          )
        )
      )
    )
    (if (or (not keeps) (not arrives))
      (call drop-bound held)
      (call drop-captures captured)
    )
    (if (not arrives)
      (call refuse .refused-expression site)
      (call drop-joins arms-mark)
      (return (call Typed nothing no-type))
    )
    (let given (call close-joins arms-joined arms-mark arm-layout arm-slot))
    (call settle-extent run site)
    (call commit-stream run commits (call load-local end site))
    (let passing (call (. ir reserve-block)))
    (call jump passing)
    (call (. ir start-block) failed)
    (call rewind-mark site)
    (call settle-extent run site)
    (call commit-stream run commits (. run start))
    (call jump failure)
    (call (. ir start-block) passing)
    (= streaming own-streaming)
    (= attempt-end end)
    (return (call Typed given result))
  )
  (fn-do _ open-stream StreamRun
    (param site SyntaxId)
    (param subject Operand)
    (param subject-type TypeId)
    (param made FactId)
    (param viewed FactId)
    (param extends FactId)
    (param regional Bool (= false))
    ; The stream a pattern reads the value a match is on through, and the view of it the pattern
    ; runs over. A value that is a stream, and a `ChunkedTokenStream` made of the value, may give
    ; more input as it is read. A `regional` stream is made inside an allocation scope of the task's
    ; parse region.
    (let nothing (call make-operand .operand-void 0))
    (let closed
      (call StreamRun
        (block
          (arg site)
          (arg nothing)
          (arg no-type)
          (arg nothing)
          (arg no-type)
          (arg nothing)
          (arg nothing)
          (arg nothing)
          (arg no-local)
          (arg no-local)
          (arg void-layout)
          (arg void-layout)
          (arg void-layout)
        )
      )
    )
    (if regional
      (let begin (. ([] (. tree nodes) site) loc begin))
      (let start (. pending length))
      (+= pending (call integer .machine-u64 (+ (. begin line) 1)))
      (+= pending (call integer .machine-u64 (+ (. begin column) 1)))
      (call call-runtime .runtime-parse-region-enter-scope site start)
    )
    (let stream (call stream-of site subject subject-type made))
    (let stream-type (. stream type))
    (if regional
      (call call-runtime .runtime-parse-region-leave-scope site (. pending length))
    )
    (let refills
      (scope (or (== made no-fact) chunked)
        (lazy chunked (call same-decl (call class-ref types stream-type) (. types chunked-token-stream-decl)))
      )
    )
    (return (call view-stream site (. stream operand) stream-type refills viewed extends))
  )
  (fn-do + stream-of Typed
    (param site SyntaxId)
    (param subject Operand)
    (param subject-type TypeId)
    (param made FactId)
    ; The stream a pattern reads a value through, by the calls the type pass recorded for it: a
    ; value that is a stream converted to the `TokenStream` it is, and any other value, a String
    ; among them, given to the stream the type pass chose.
    (let nothing (call make-operand .operand-void 0))
    (if (== made no-fact)
      (let stream (call convert site .reason-argument (call Typed subject subject-type)))
      (if (!= (call (. types intrinsic-of) (. stream type)) .interface)
        (call refuse .refused-conversion site)
        (return (call Typed nothing no-type))
      )
      (return stream)
    )
    (return (call make-stream site made subject subject-type))
  )
  (fn-do + view-stream StreamRun
    (param site SyntaxId)
    (param stream Operand)
    (param stream-type TypeId)
    (param refills Bool)
    (param viewed FactId)
    (param extends FactId)
    ; The view of a stream a pattern runs over, as its `pattern-view` gives it: the buffer, where
    ; the pattern starts and how many items the buffer holds, read as it lies, or as its
    ; `pattern-text-view` gives the UTF-8 bytes of a String's characters. How far the pattern
    ; reads, and the farthest cursor a part of it fails at, are kept from the start. A stream that
    ; `refills` may give more input as it is read: the buffer, where its items start and how many
    ; it holds are kept, to be read again where its `pattern-extend` gives more.
    (let nothing (call make-operand .operand-void 0))
    (let closed
      (call StreamRun
        (block
          (arg site)
          (arg nothing)
          (arg no-type)
          (arg nothing)
          (arg no-type)
          (arg nothing)
          (arg nothing)
          (arg nothing)
          (arg no-local)
          (arg no-local)
          (arg void-layout)
          (arg void-layout)
          (arg void-layout)
        )
      )
    )
    (let view (call call-protocol site viewed stream stream-type nothing))
    (if (not (call (. types is-optional) (. view type)))
      (call refuse .refused-type site)
      (return closed)
    )
    (let held (call payload site view))
    (let tuple-layout (call layout-of (. held type) site))
    (let buffer (call part (. held operand) tuple-layout 0 site))
    (let buffer-type (. buffer type))
    (let start (call part (. held operand) tuple-layout 1 site))
    (let start-type (. start type))
    (let length (call part (. held operand) tuple-layout 2 site))
    (let length-type (. length type))
    (let buffer-layout (call layout-of buffer-type site))
    (let index-layout (call layout-of (. types index-type) site))
    (let size-layout (call layout-of (. types size-type) site))
    (let item-layout (call layout-of (call class-arg types buffer-type 0) site))
    (if (or (!= start-type (. types index-type)) (!= length-type (. types size-type)))
      (call refuse .refused-type site)
      (return closed)
    )
    (if (or (not (call (. tables layouts is-struct) buffer-layout)) unpaired-buffer (not (call is-integer index-layout)))
      (call refuse .refused-type site)
      (return closed)
    )
    (lazy unpaired-buffer (!= (. ([] (. tables layouts rows) buffer-layout) fields count) 2))
    (let data (call part (. buffer operand) buffer-layout 0 site))
    (let data-layout (call layout-of (. data type) site))
    (if (not (call is-pointer data-layout))
      (call refuse .refused-type site)
      (return closed)
    )
    (let extent (call (. ir add-local) index-layout))
    (call store-local extent (. start operand) site)
    (let error (call (. ir add-local) index-layout))
    (call store-local error (. start operand) site)
    (let length-index (call num-cast site (. length operand) size-layout index-layout))
    (let run
      (call StreamRun
        (block
          (arg site)
          (arg stream)
          (arg stream-type)
          (arg (. buffer operand))
          (arg buffer-type)
          (arg (call num-cast site (. data operand) data-layout pointer-layout))
          (arg (. start operand))
          (arg length-index)
          (arg extent)
          (arg error)
          (arg index-layout)
          (arg item-layout)
          (arg buffer-layout)
          (arg viewed)
          (arg extends)
        )
      )
    )
    (if (not refills)
      (return run)
    )
    (if (== extends no-fact)
      (call refuse .refused-type site)
      (return closed)
    )
    (let kept-buffer (call (. ir add-local) buffer-layout))
    (call store-local kept-buffer (. buffer operand) site)
    (let kept-data (call (. ir add-local) pointer-layout))
    (call store-local kept-data (. run data) site)
    (let kept-length (call (. ir add-local) index-layout))
    (call store-local kept-length length-index site)
    (return
      (call StreamRun
        (block
          (arg site)
          (arg stream)
          (arg stream-type)
          (arg (. buffer operand))
          (arg buffer-type)
          (arg (. run data))
          (arg (. start operand))
          (arg length-index)
          (arg extent)
          (arg error)
          (arg index-layout)
          (arg item-layout)
          (arg buffer-layout)
          (arg viewed)
          (arg extends)
          (arg kept-buffer)
          (arg kept-data)
          (arg kept-length)
        )
      )
    )
  )
  (fn-do _ make-stream Typed
    (param site SyntaxId)
    (param made FactId)
    (param given Operand)
    (param given-type TypeId)
    ; The stream the type pass chose to read a value through, made of it: given the value,
    ; converted as the type pass recorded, then the defaults its other parameters take.
    (let nothing (call make-operand .operand-void 0))
    (if (or (!= (. ([] (. facts calls) made) form) .call-constructor) (not (call is-callable (. ([] (. facts calls) made) callee))))
      (call refuse .refused-expression site)
      (return (call Typed nothing no-type))
    )
    (let maker (. ([] (. facts calls) made) callee))
    (let signature ([] (. instances signatures) maker))
    (let count (. signature args count))
    (if (or (== count 0) (> count 2) (!= (. signature errors count) 0))
      (call refuse .refused-expression site)
      (return (call Typed nothing no-type))
    )
    (let parameter (call (. instances argument-type) maker 0))
    (let value given)
    (if (!= given-type parameter)
      (let converted (call convert site .reason-argument (call Typed given given-type)))
      (= value (. converted operand))
      (if (!= (. converted type) parameter)
        (call refuse .refused-conversion site)
        (return (call Typed nothing no-type))
      )
    )
    (let mark (. pending length))
    (+= pending value)
    (if (== count 2)
      (let default (call parameter-default maker 1))
      (if (== default 0)
        (call refuse .refused-expression site)
        (call drop-pending mark)
        (return (call Typed nothing no-type))
      )
      (+= pending (. (call default-argument site maker default (call (. instances argument-type) maker 1)) operand))
    )
    (return (call call-instance maker site mark))
  )
  (fn-do _ run-buffer Operand
    (param run StreamRun)
    (param site SyntaxId)
    ; The buffer of the stream's view as the pattern last read it, or in a rule's function, which
    ; is given where the items start and their count, an array that shares them.
    (if (!= (. run kept-buffer) no-local)
      (return (call load-local (. run kept-buffer) site))
    )
    (if (== (call operand-kind (. run buffer)) .operand-void)
      (let slice
        (call stream-slice
          (block
            (arg run)
            (arg site)
            (arg (call integer (. ([] (. tables layouts rows) (. run index-layout)) kind) 0))
            (arg (call run-length run site))
          )
        )
      )
      (return (. slice operand))
    )
    (return (. run buffer))
  )
  (fn-do + run-data Operand
    (param run StreamRun)
    (param site SyntaxId)
    ; The address the items of the stream's buffer start at, as the pattern last read it.
    (return (if-expr (!= (. run kept-data) no-local) (call load-local (. run kept-data) site) (. run data)))
  )
  (fn-do + run-length Operand
    (param run StreamRun)
    (param site SyntaxId)
    ; The count of items in the stream's buffer, as an index, as the pattern last read it.
    (return (if-expr (!= (. run kept-length) no-local) (call load-local (. run kept-length) site) (. run length)))
  )
  (fn-do _ branch-present _
    (param run StreamRun)
    (param site SyntaxId)
    (param cursor Operand)
    (param present IRBlockId)
    (param ended IRBlockId)
    ; Goes on to `present` where an item lies at a cursor in the stream's buffer, and else to
    ; `ended`. A stream that may give more input is asked for more first, as often as it gives
    ; some, so that `ended` follows only once the input ends.
    (if (== (. run kept-length) no-local)
      (call branch (call compare site .compare-less cursor (. run length)) present ended)
      (return)
    )
    (let test (call (. ir reserve-block)))
    (let asks (call (. ir reserve-block)))
    (call jump test)
    (call (. ir start-block) test)
    (call branch (call compare site .compare-less cursor (call run-length run site)) present asks)
    (call (. ir start-block) asks)
    (let grew
      (call call-protocol
        (block
          (arg site)
          (arg (. run extends))
          (arg (. run stream))
          (arg (. run stream-type))
          (arg (call make-operand .operand-void 0))
        )
      )
    )
    (if (!= (. grew type) (. types bool-type))
      (call refuse .refused-type site)
      (return)
    )
    (call reread-stream run site)
    (call branch (call compare site .compare-not-equal (. grew operand) (call integer .machine-u8 0)) test ended)
  )
  (fn-do _ reread-stream _
    (param run StreamRun)
    (param site SyntaxId)
    ; Reads the view of a stream that may give more input again, for the buffer it now holds,
    ; where its items start and how many it holds.
    (let view (call call-protocol site (. run views) (. run stream) (. run stream-type) (call make-operand .operand-void 0)))
    (if (not (call (. types is-optional) (. view type)))
      (call refuse .refused-type site)
      (return)
    )
    (let held (call payload site view))
    (call keep-view run site (. held operand) (call layout-of (. held type) site))
  )
  (fn-do _ keep-view _
    (param run StreamRun)
    (param site SyntaxId)
    (param held Operand)
    (param tuple-layout LayoutId)
    ; Keeps of a view of the stream a pattern runs on, as `pattern-view` gives it, the buffer, where
    ; its items start and how many it holds, for the parts after to read.
    (let buffer (call part held tuple-layout 0 site))
    (let length (call part held tuple-layout 2 site))
    (let length-layout (call layout-of (. length type) site))
    (let data (call part (. buffer operand) (. run buffer-layout) 0 site))
    (let data-layout (call layout-of (. data type) site))
    (if (!= (. run kept-buffer) no-local)
      (call store-local (. run kept-buffer) (. buffer operand) site)
    )
    (call store-local (. run kept-data) (call num-cast site (. data operand) data-layout pointer-layout) site)
    (call store-local (. run kept-length) (call num-cast site (. length operand) length-layout (. run index-layout)) site)
  )
  (fn-do + record-call-extent _
    (param run StreamRun)
    (param id SyntaxId)
    (param reached Operand)
    ; Keeps how far a function a pattern called read as how far the pattern read. Where it read past
    ; the end of the buffer of a stream that may give more input, the stream may have given it more,
    ; and its view is read again.
    (call record-extent run id reached)
    (if (== (. run kept-length) no-local)
      (return)
    )
    (let again (call (. ir reserve-block)))
    (let onward (call (. ir reserve-block)))
    (call branch (call compare id .compare-greater reached (call run-length run id)) again onward)
    (call (. ir start-block) again)
    (call reread-stream run id)
    (call jump onward)
    (call (. ir start-block) onward)
  )
  (fn-do _ settle-extent _
    (param run StreamRun)
    (param site SyntaxId)
    ; Keeps how far a pattern on a stream that may give more input read no farther than the end of
    ; the input, where it read past it, as the reference does once the stream gives no more.
    (if (== (. run kept-length) no-local)
      (return)
    )
    (let length (call run-length run site))
    (let beyond (call (. ir reserve-block)))
    (let settled (call (. ir reserve-block)))
    (call branch (call compare site .compare-greater (call load-local (. run extent) site) length) beyond settled)
    (call (. ir start-block) beyond)
    (call store-local (. run extent) length site)
    (call jump settled)
    (call (. ir start-block) settled)
  )
  (fn-do _ commit-stream _
    (param run StreamRun)
    (param fact FactId)
    (param cursor Operand)
    ; Tells the stream where the pattern left it and how far it read.
    (let reached (call load-local (. run extent) (. run site)))
    (call call-protocol
      (block
        (arg (. run site))
        (arg fact)
        (arg (. run stream))
        (arg (. run stream-type))
        (arg cursor)
        (arg (. types index-type))
        (arg true)
        (arg reached)
        (arg (. types index-type))
      )
    )
  )
  (fn-do + emit-stream-arms Bool
    (param run StreamRun)
    (param id SyntaxId)
    (param result TypeId)
    (param from Operand)
    (param whole Bool)
    (param end LocalId)
    (param joined IRBlockId)
    (param slot Operand)
    (param failed IRBlockId)
    (param unread Bool (= false))
    ; The arms of a grammar, tried from a cursor as the alternatives of a choice are. An arm
    ; whose pattern passes, at the end of the input where the arms must read the whole of it,
    ; keeps where it ended and leaves its value, converted to the type the arms join as, for the
    ; join; one that fails, or leaves input unread that it must read, goes on to the next, and the
    ; last to `failed`. Whether any arm reaches the join. Where `unread`, nothing reads the value
    ; the arms join as.
    (let arms (list SyntaxId))
    (call choice-arms tree id arms)
    (if (== (. arms length) 1)
      (return (call emit-stream-arm run id result from whole end joined slot failed no-local unread))
    )
    (return
      (call try-alternatives
        (block
          (arg run)
          (arg id)
          (arg arms)
          (arg from)
          (arg (call observed-failure id from failed))
          (arg (call ArmWay id result whole end joined slot false unread))
        )
      )
    )
  )
  (fn-do _ emit-stream-arm Bool
    (param run StreamRun)
    (param id SyntaxId)
    (param result TypeId)
    (param from Operand)
    (param whole Bool)
    (param end LocalId)
    (param joined IRBlockId)
    (param slot Operand)
    (param failed IRBlockId)
    (param entered LocalId (= no-local))
    (param unread Bool (= false))
    ; One arm of a grammar, emitted as `emit-arm` says with the places of its own names
    ; in force, as `activate-captures` says. Whether the arm reaches the join.
    (let held (. stream-captures length))
    (let named (. bound length))
    (call activate-captures id)
    (let arrives (call emit-arm run id result from whole end joined slot failed entered unread))
    (-= ([] stream-captures (..< held (. stream-captures length))))
    (call drop-bound named)
    (return arrives)
  )
  (fn-do + bind-it _
    (param slot SlotId)
    (param value Operand)
    (param type TypeId)
    (param site SyntaxId)
    ; Binds `it` in an arm of a grammar to what the arm gives its expression, which is kept
    ; in the environment too where functions the expression makes read it.
    (if (call is-captured slot)
      (call keep-captured slot value type site)
    )
    (+= bound (call BoundValue slot type value))
  )
  (fn-do + keep-arm-captures _
    (param pattern SyntaxId)
    ; Keeps in the environment, as an arm begins, what each name its pattern captures holds,
    ; where functions the arm's expression makes read the name.
    (let kept (list SlotId))
    (for (in node (..< (call (. tree subtree-start) pattern) (+ pattern 1)))
      (match? ([] (. tree nodes) node)
        (case (call .node-stream-capture row)
          (let slot (call captured-slot (. row name)))
          (if (or (== slot no-slot) (not (call is-captured slot)) (has kept slot))
            (continue)
          )
          (+= kept slot)
          (let held (call captured-at slot))
          (if (== held (. U32 max))
            (call refuse .refused-expression node)
            (return)
          )
          (let field (call find-captured slot (. row name)))
          (let value (call read-capture (. row name) held (. field type)))
          (call keep-captured slot (. value operand) (. value type) (. row name))
        )
      )
    )
  )
  (fn-do + emit-bare-arm Bool
    (param run StreamRun)
    (param id SyntaxId)
    (param result TypeId)
    (param from Operand)
    (param whole Bool)
    (param end LocalId)
    (param joined IRBlockId)
    (param slot Operand)
    (param failed IRBlockId)
    (param entered LocalId (= no-local))
    (param unread Bool (= false))
    ; An arm that runs no expression: it gives the text its pattern matched, or what a rule its
    ; pattern calls gave, converted to the type the arms join as. Where it passes, the arms hold
    ; the rollback mark they held before it, where `entered` kept one. Where `unread`, nothing
    ; reads what the arm gives, and text `slices-text` says is only cut from the buffer is not
    ; made: the arm gives the empty text. Where the input must be read whole, an arm that leaves
    ; some unread fails as its pattern does.
    (let part (call lowered-part id))
    (let missed (call observed-failure part from failed))
    (let reached (call emit-stream-node run part from missed))
    (let finish (. reached ending))
    (let given (. reached value operand))
    (let given-type (. reached value type))
    (if whole
      (call stream-whole run id finish missed)
    )
    (if (call (. facts is-spanning-arm) (. unit reading) id)
      (let span (call source-span run id from finish result))
      (call pass-marks entered id)
      (call store-local end finish id)
      (call arrive id (. span operand) joined slot)
      (return true)
    )
    (let text (call Typed given given-type))
    (if (call gives-value id)
      (if (== given-type no-type)
        (call refuse .refused-expression id)
        (return false)
      )
      (else-if (and unread (call slices-text id))
        (= text (call Typed (call make-operand .operand-constant (call (. ir add-string) "")) (. types string-type)))
      )
      (else
        (= text (call stream-text run id from finish))
      )
    )
    (if (!= (. text type) result)
      (= text (call join id text))
    )
    (call pass-marks entered id)
    (call store-local end finish id)
    (call arrive id (. text operand) joined slot)
    (return true)
  )
  (fn-do _ slices-text Bool
    (param site SyntaxId)
    ; Whether the text a part of a pattern matched is a `String` cut from the stream's buffer, by
    ; the call `stream-text` makes, rather than what a helper makes of it.
    (if (!= (call material-at site .material-text) (. U32 max))
      (return false)
    )
    (let fact (call (. facts call-in-role) (. unit reading) site .role-text))
    (if (or (== fact no-fact) (== (. ([] (. facts calls) fact) callee) no-instance))
      (return false)
    )
    (return (== (. ([] (. instances signatures) (. ([] (. facts calls) fact) callee)) returns) (. types string-type)))
  )
  (fn-do + source-span Typed
    (param run StreamRun)
    (param site SyntaxId)
    (param begun Operand)
    (param ending Operand)
    (param type TypeId)
    ; The `CaptureSpan` an arm of a rule that states one gives: the stream's buffer and the two
    ; cursors its pattern matched between. A rule's function, given where the items start and
    ; their count, gives it an array that shares them.
    (let nothing (call make-operand .operand-void 0))
    (let layout (call layout-of type site))
    (if (or (not (call (. tables layouts is-struct) layout)) (!= (. ([] (. tables layouts rows) layout) fields count) 3))
      (call refuse .refused-type site)
      (return (call Typed nothing no-type))
    )
    (let source-field (call (. tables layouts field) layout 0))
    (let start-field (call (. tables layouts field) layout 1))
    (let end-field (call (. tables layouts field) layout 2))
    (if (or (!= (. source-field layout) (. run buffer-layout)) unindexed-bounds)
      (call refuse .refused-type site)
      (return (call Typed nothing no-type))
    )
    (lazy unindexed-bounds (or (!= (. start-field layout) (. run index-layout)) (!= (. end-field layout) (. run index-layout))))
    (let buffer (call run-buffer run site))
    (let span (call frame layout))
    (call put span source-field buffer site)
    (call put span start-field begun site)
    (call put span end-field ending site)
    (return (call Typed span type))
  )
  (fn-expr + gives-value Bool
    (param id SyntaxId)
    ; Whether a part of a grammar gives what a rule or a pattern it calls gives rather than
    ; the text it matched: so do a test of an item for a case of a union, which gives the item, and
    ; a call planned to give its text that the type pass recorded the helper to make another type of.
    (or (== plan .plan-stream-value) (== plan .plan-pattern-call) (== plan .plan-case) (and (== plan .plan-span-call) (!= stated (. types string-type)) (!= stated no-type) (!= (call material-at id .material-text) (. U32 max))))
    (where
      (lazy plan (call (. facts plan-of) (. unit reading) id))
      (lazy stated (call (. facts node-type) (. unit reading) id))
    )
  )
  (fn-do + stream-whole _
    (param run StreamRun)
    (param id SyntaxId)
    (param finish Operand)
    (param failed IRBlockId)
    ; Goes on where an arm's pattern ended at the end of the input, and else keeps where it ended
    ; as a cursor a part failed at and goes to `failed`.
    (let whole (call (. ir reserve-block)))
    (let short (call (. ir reserve-block)))
    (call branch-present run id finish short whole)
    (call (. ir start-block) short)
    (call record-error run id finish)
    (call jump failed)
    (call (. ir start-block) whole)
  )
  (fn-do + emit-stream-raise _
    (param run StreamRun)
    (param id SyntaxId)
    (param failed IRBlockId)
    ; An arm that raises what it gives where no arm before it passed, as an assertion raises its
    ; exception, which reads as `location` the farthest cursor a part of the pattern failed at.
    (let exception SyntaxId 0)
    (let located SyntaxId 0)
    (match? ([] (. tree nodes) id)
      (case (call .node-stream-panic row)
        (match? ([] (. tree nodes) (. row pattern))
          (case (call .node-stream-transform arm)
            (if (== (. arm pattern) 0)
              (= exception (. arm right))
              (= located (. row pattern))
            )
          )
        )
      )
    )
    (if (== exception 0)
      (call refuse .refused-expression id)
      (return)
    )
    (let named (. bound length))
    (let fact (call location-fact located))
    (if (!= fact no-fact)
      (let farthest (call load-local (. run error) id))
      (call bind-location run located fact farthest farthest false)
    )
    (call raise-given id exception)
    (call drop-bound named)
  )
  (fn-do _ emit-stream-part StreamPart (?! Refused)
    (param run StreamRun)
    (param id SyntaxId)
    (param cursor Operand)
    (param failed IRBlockId)
    ; A part of a grammar that runs nothing, tried from a cursor: where it passes, what is
    ; emitted next goes on from the cursor where it ended; where it fails it goes to `failed`.
    ; Alternatives are tried in turn from the cursor, and the first that passes is kept. A
    ; repeat takes its part as often as it passes, up to its most, and passes where it took it at
    ; least its least; one with no most stops where its part passed without moving on. An
    ; optional part passes either way. A lookahead passes or fails as its part does, or the other
    ; way, and leaves the cursor where it was. A name captured holds what its part matched. A
    ; call of a rule gives what the rule gave, which a sequence it ends, a name captured over it
    ; and an optional part around it give too, and a test of one item gives the item, as does a
    ; `.` the type pass typed as the item; no other part gives a value. A part that fails
    ; keeps where it began as a cursor a part failed at, as the reference's do, a choice too,
    ; since it may skip every alternative; sequences keep none of their own, as what fails in
    ; them began past where they did. Under a helper that observes literal words, a part that fails
    ; tells it so, as `observed-failure` says.
    (return (call emit-stream-node run id cursor (call observed-failure id cursor failed)))
  )
  (fn-do + emit-stream-node StreamPart
    (param run StreamRun)
    (param id SyntaxId)
    (param cursor Operand)
    (param failed IRBlockId)
    ; A part of a grammar tried from a cursor, as `emit-stream-part` says, which goes to
    ; `failed` where it fails with nothing more told to the helper. A sequence in a sequence is
    ; one with it, as the reference takes it.
    (match? ([] (. tree nodes) id)
      (case (call .node-stream-string row)
        (return (call bare-part (call stream-literal run id (. row text) cursor failed)))
      )
      (case .node-stream-call
        (return (call stream-call run id cursor failed))
      )
      (case .node-stream-any
        (let passed (call stream-class run id 0 0 true cursor failed))
        (let item (call (. facts node-type) (. unit reading) id))
        (if (!= item no-type)
          (return (call StreamPart passed (call Typed (call char-at run id cursor) item)))
        )
        (return (call bare-part passed))
      )
      (case (call .node-stream-char-range row)
        (let ranged
          (call stream-class
            (block
              (arg run)
              (arg id)
              (arg (call (. tree stream-bound) (. row first)))
              (arg (call (. tree stream-bound) (. row last)))
              (arg false)
              (arg cursor)
              (arg failed)
            )
          )
        )
        (let item (call (. facts node-type) (. unit reading) id))
        (if (and (!= item no-type) (!= item (. types string-type)))
          (return (call StreamPart ranged (call Typed (call stream-item run id cursor) item)))
        )
        (return (call bare-part ranged))
      )
      (case (call .node-stream-predicate row)
        (return (call stream-predicate run id (. row predicate) cursor failed))
      )
      (case (call .node-stream-equality row)
        (if (== (call (. facts plan-of) (. unit reading) id) .plan-pattern-call)
          (return (call pattern-call run id (. row value) cursor failed))
        )
        (if (== (call (. facts plan-of) (. unit reading) id) .plan-case)
          (return (call stream-case-item run id cursor failed))
        )
        (if (!= (call (. facts node-type) (. unit reading) id) (. types string-type))
          (return (call stream-dynamic-item run id (. row value) cursor failed))
        )
        (return (call bare-part (call stream-dynamic-text run id (. row value) cursor failed)))
      )
      (case (call .node-stream-type row)
        (return (call stream-type-part run id (. row type) cursor failed))
      )
      (case .node-stream-and
        (return (call stream-sequence run id cursor failed))
      )
      (case .node-stream-or
        (return (call stream-choice run id cursor (call failure-of run id cursor failed)))
      )
      (case (call .node-stream-capture row)
        (return (call stream-capture run id (. row name) (. row pattern) cursor failed))
      )
      (case (call .node-stream-transform row)
        (if (and (!= (. row pattern) 0) (call (. tree lazies-only) (. row right)))
          (return (call emit-stream-part run (. row pattern) cursor failed))
        )
      )
      (case (call .node-stream-unary row)
        (if (== (. row op) .zero-or-one-op)
          (return (call stream-optional run id (. row operand) cursor))
        )
        (if (== (. row op) .zero-or-more-op)
          (return
            (call stream-repeat
              (block
                (arg run)
                (arg id)
                (arg (. row operand))
                (arg 0)
                (arg (. U64 max))
                (arg cursor)
                (arg failed)
                (arg (call is-scanned tree (. row operand)))
              )
            )
          )
        )
        (if (== (. row op) .one-or-more-op)
          (return
            (call stream-repeat
              (block
                (arg run)
                (arg id)
                (arg (. row operand))
                (arg 1)
                (arg (. U64 max))
                (arg cursor)
                (arg (call failure-of run id cursor failed))
                (arg (call is-scanned tree (. row operand)))
              )
            )
          )
        )
        (if (== (call (. facts plan-of) (. unit reading) id) .plan-stream-guard)
          (let missed (call failure-of run id cursor failed))
          (return
            (call bare-part
              (block
                (arg (call stream-guard id (. row operand) (== (. row op) .positive-lookahead-op) cursor missed))
              )
            )
          )
        )
        (if (or (== (. row op) .positive-lookahead-op) (== (. row op) .negative-lookahead-op))
          (let looked
            (call stream-lookahead
              (block
                (arg run)
                (arg id)
                (arg (. row operand))
                (arg (== (. row op) .positive-lookahead-op))
                (arg cursor)
                (arg (call failure-of run id cursor failed))
              )
            )
          )
          (return (call bare-part looked))
        )
      )
      (case (call .node-stream-length row)
        (let most-at (if-expr (!= (. row max) 0) (. row max) (. row min)))
        (let least-at (if-expr (call (. tree literal-bound) (. row min)) 0 (. row min)))
        (let limit-at (if-expr (call (. tree literal-bound) most-at) 0 most-at))
        (let short
          (block
            (case? (or (!= least-at 0) (!= (call (. tree stream-bound) (. row min)) 0))
              (call failure-of run id cursor failed)
            )
            (default
              failed
            )
          )
        )
        (return
          (call stream-repeat
            (block
              (arg run)
              (arg id)
              (arg (. row operand))
              (arg (call (. tree stream-bound) (. row min)))
              (arg (call (. tree stream-bound) most-at))
              (arg cursor)
              (arg short)
              (arg false)
              (arg least-at)
              (arg limit-at)
            )
          )
        )
      )
    )
    (call refuse .refused-expression id)
    (return (call bare-part cursor))
  )
  (fn-do + observed-failure IRBlockId
    (param id SyntaxId)
    (param cursor Operand)
    (param failed IRBlockId)
    ; Where a part tried from a cursor goes where it fails, under a helper that observes the literal
    ; words a pattern matches: a block that tells the helper to forget the words it was told of
    ; that end past the cursor, then goes to `failed`, as the reference does where any part of its
    ; own fails but an arm that raises. The items a repeat scans, and alternatives the reference
    ; tests as one item, are no parts of their own there. What is emitted next goes on past it.
    (if (or (== (. streaming observer-row) (. U32 max)) scanning (. streaming classing) (not (call (. tree observes) id)))
      (return failed)
    )
    (let missed (call (. ir reserve-block)))
    (let onward (call (. ir reserve-block)))
    (call jump onward)
    (call (. ir start-block) missed)
    (call rewind-literals id cursor)
    (call jump failed)
    (call (. ir start-block) onward)
    (return missed)
  )
  (fn-do + lowered-part SyntaxId
    (param id SyntaxId)
    ; The part the reference takes for a part of a pattern: the one that a part that only declares
    ; lazy locals is around.
    (match? ([] (. tree nodes) id)
      (case (call .node-stream-transform row)
        (if (and (!= (. row pattern) 0) (call (. tree lazies-only) (. row right)))
          (return (call lowered-part (. row pattern)))
        )
      )
    )
    (return id)
  )
  (fn-do _ rewind-literals _
    (param site SyntaxId)
    (param cursor Operand)
    ; Tells the helper that observes literal words to forget those it was told of that end past a
    ; cursor.
    (let row ([] (. facts observer-bodies) (. streaming observer-row)))
    (call call-protocol
      (block
        (arg site)
        (arg (. row rewind))
        (arg (. streaming pattern-helper))
        (arg (. streaming pattern-helper-type))
        (arg cursor)
        (arg (. types index-type))
      )
    )
  )
  (fn-do _ record-literals _
    (param run StreamRun)
    (param site SyntaxId)
    (param text String)
    (param cursor Operand)
    ; Tells the helper that observes literal words of each word of lowercase letters in a text the
    ; pattern matched from a cursor, by where it starts and ends in the input, as the reference finds
    ; them: a letter, then letters and hyphens, where no letter is uppercase. The items a repeat
    ; scans, and alternatives the reference tests as one item, are no literals there. Where the
    ; buffer is UTF-8, where a word lies counts the bytes of the characters before it.
    (if (or (== (. streaming observer-row) (. U32 max)) scanning (. streaming classing))
      (return)
    )
    (let row ([] (. facts observer-bodies) (. streaming observer-row)))
    (let points (. text codepoints))
    (let offsets (list U64))
    (let offset U64)
    (for (in point points)
      (+= offsets offset)
      (+= offset (if-expr (call encodes run) (call utf8-width point) 1))
    )
    (+= offsets offset)
    (let index Size 0)
    (while (< index (. points size))
      (if (not (call is-word-letter ([] points index)))
        (+= index 1)
        (continue)
      )
      (let lowercase (call is-lowercase-letter ([] points index)))
      (let end (+ index 1))
      (while (and (< end (. points size)) (or (call is-word-letter ([] points end)) (== ([] points end) '-')))
        (if (and (call is-word-letter ([] points end)) (not (call is-lowercase-letter ([] points end))))
          (= lowercase false)
        )
        (+= end 1)
      )
      (if lowercase
        (let start-at (call stream-advance run site cursor ([] offsets index)))
        (let end-at (call stream-advance run site cursor ([] offsets end)))
        (call call-protocol
          (block
            (arg site)
            (arg (. row record))
            (arg (. streaming pattern-helper))
            (arg (. streaming pattern-helper-type))
            (arg start-at)
            (arg (. types index-type))
            (arg true)
            (arg end-at)
            (arg (. types index-type))
          )
        )
      )
      (= index end)
    )
  )
  (fn-expr + inlined-rule RuleTarget
    (param run StreamRun)
    (param id SyntaxId)
    (param result TypeId)
    (param spanned Bool)
    ; The rule a module declares that a call runs where it is called, with the module that declares
    ; it and the instance that reads it: one given only the stream, read through a view of items of
    ; the type the pattern reads, that raises no errors, takes no helper and holds no rollback mark,
    ; whose pattern is plain as `plain-part` says, and whose arms join as the type the call gives
    ; where the call gives what they give. No pattern for any other call.
    (case? (or (== fact no-fact) (== callee no-instance) (. row is-partial) (!= (. row fills count) 1))
      none
    )
    (case? (or (!= (. signature args count) 1) (!= (. signature errors count) 0) (!= (. ([] (. instances rows) callee) helper) no-type) (. ([] (. instances rows) callee) carries-mark) (not (call (. types is-optional) (. signature returns))))
      none
    )
    (case? (and (not spanned) (!= (call (. types optional-inner) (. signature returns)) result))
      none
    )
    (case? (or (== (. target pattern) 0) (!= (. target owner) callee) (not (call plain-part (. ([] (. program modules) (. target module)) tree) (. target pattern))))
      none
    )
    (case? (or (== buffer no-type) (!= (call class-arg types buffer 0) (call class-arg types (. run buffer-type) 0)))
      none
    )
    (default
      target
    )
    (where
      (lazy none (call RuleTarget (. unit source-module) (. unit reading) 0))
      (lazy fact (call own-call id))
      (lazy row ([] (. facts calls) fact))
      (lazy callee (. row callee))
      (lazy signature ([] (. instances signatures) callee))
      (lazy target (call (. firsts rule-target) (. unit source-module) (. unit reading) id))
      (lazy buffer (call rule-buffer callee))
    )
  )
  (fn-do _ rule-buffer TypeId
    (param rule InstanceId)
    ; The buffer of the view a rule a module declares reads its stream through, as the type pass
    ; recorded it at the rule's declaration.
    (match? ([] (. ([] (. program modules) (. ([] (. instances rows) rule) module)) decls) (. ([] (. instances rows) rule) decl))
      (case (call .decl-function fn)
        (return (call (. facts node-type) rule (. fn syntax)))
      )
    )
    (return no-type)
  )
  (fn-do _ plain-part Bool
    (param syntax AST)
    (param id SyntaxId)
    ; Whether a part of a pattern reads only the items it matches and gives only the text it
    ; matched: text, ranges and any item, and sequences, choices, optionals, repeats with written
    ; bounds and lookaheads of those.
    (match? ([] (. syntax nodes) id)
      (case .node-stream-string
        (return true)
      )
      (case .node-stream-any
        (return true)
      )
      (case .node-stream-char-range
        (return true)
      )
      (case (call .node-stream-and row)
        (return (and (call plain-part syntax (. row left)) (call plain-part syntax (. row right))))
      )
      (case (call .node-stream-or row)
        (return (and (call plain-part syntax (. row left)) (call plain-part syntax (. row right))))
      )
      (case (call .node-stream-unary row)
        (let plain-op
          (scope (or may-skip (== (. row op) .one-or-more-op) positive-look negative-look)
            (lazy may-skip (or (== (. row op) .zero-or-one-op) (== (. row op) .zero-or-more-op)))
            (lazy positive-look (== (. row op) .positive-lookahead-op))
            (lazy negative-look (== (. row op) .negative-lookahead-op))
          )
        )
        (return (and plain-op (call plain-part syntax (. row operand))))
      )
      (case (call .node-stream-length row)
        (return
          (scope (and (call (. syntax literal-bound) (. row min)) literal-max (call plain-part syntax (. row operand)))
            (lazy literal-max (or (== (. row max) 0) (call (. syntax literal-bound) (. row max))))
          )
        )
      )
    )
    (return false)
  )
  (fn-do + inline-rule-call StreamPart
    (param run StreamRun)
    (param id SyntaxId)
    (param target RuleTarget)
    (param cursor Operand)
    (param failed IRBlockId)
    (param spanned Bool)
    ; A call of a rule a module declares that `inlined-rule` found, run where it is called as a
    ; local rule is: its arms are tried in turn from the cursor, read with the syntax of the module
    ; that declares it and the facts of the instance that reads it, under no helper and holding no
    ; rollback mark, as its function tries them. The first that passes gives the call what it gave
    ; and where it ended; where none passes, the call fails. It keeps the farthest cursor a part of
    ; it failed at from the cursor it is called at, as its function does, and the pattern counts
    ; that and how far it read as its own. A call `spanned` gives the text it matched, as
    ; `spanned-value` says.
    (let result (call (. types optional-inner) (. ([] (. instances signatures) (. target owner)) returns)))
    (let layout (call layout-of result id))
    (let end (call (. ir add-local) (. run index-layout)))
    (let joined (call (. ir reserve-block)))
    (let slot (call join-slot layout))
    (let mark (. joins length))
    (let outer (call load-local (. run error) id))
    (call store-local (. run error) cursor id)
    (let missed (call (. ir reserve-block)))
    (let own-unit unit)
    (let own-streaming streaming)
    (= unit (= (. unit source-module) (. target module)))
    (= unit (= (. unit reading) (. target owner)))
    (= streaming (= (. streaming observer-row) (. U32 max)))
    (= streaming (= (. streaming rollback-mark) no-local))
    (= streaming (= (. streaming rollback-row) (. U32 max)))
    (call plan-choices (. target pattern))
    (let arrives
      (call emit-stream-arms
        (block
          (arg run)
          (arg (. target pattern))
          (arg result)
          (arg cursor)
          (arg false)
          (arg end)
          (arg joined)
          (arg slot)
          (arg missed)
          (arg spanned)
        )
      )
    )
    (= unit own-unit)
    (= streaming own-streaming)
    (if (not arrives)
      (call drop-joins mark)
      (call refuse .refused-expression id)
      (return (call bare-part cursor))
    )
    (call (. ir start-block) missed)
    (call record-error run id outer)
    (call jump failed)
    (let value (call close-joins joined mark layout slot))
    (call record-error run id outer)
    (let ending (call load-local end id))
    (if spanned
      (return (call StreamPart ending (call spanned-value run id true cursor ending)))
    )
    (return (call StreamPart ending (call Typed value result)))
  )
  (fn-do + spanned-value Typed
    (param run StreamRun)
    (param id SyntaxId)
    (param spanned Bool)
    (param begun Operand)
    (param ending Operand)
    ; The value of a call that gives no value of its own: none, or for one the type pass planned to
    ; give its text that its arm gives as another type, what the helper makes of that text, held
    ; in an optional where the call is typed as one. A call that gives text leaves its text to
    ; what holds it, which may be its arm, at the same node.
    (let stated (call (. facts node-type) (. unit reading) id))
    (let made (if-expr (and spanned (!= stated (. types string-type))) (call material-at id .material-text) (. U32 max)))
    (if (== made (. U32 max))
      (return (call Typed (call make-operand .operand-void 0) no-type))
    )
    (let captured (call material-capture run id made begun ending))
    (if (!= stated (. captured type))
      (return (call wrap id captured stated))
    )
    (return captured)
  )
  (fn-do _ accumulator-level U32
    (param name String)
    ; The list the pattern being emitted keeps for a name it accumulates, or none.
    (let level (. U32 max))
    (for (in capture stream-captures)
      (if (and (. capture accumulates) (== (. (!! (call (. tree identifier-name) (. capture site))) text) name))
        (= level (. capture levels))
      )
    )
    (return level)
  )
  (fn-do + borrow-levels (list LevelMark)
    (param id SyntaxId)
    (param mappings (of RowRange SyntaxId))
    ; Lends a rule a call runs the lists of the caller's names its collectors map, each to the
    ; rule's name it is given for, and keeps how many items each holds as the rule begins.
    (let marks (list LevelMark))
    (for (in mapping ([] (. tree children) mappings))
      (match? ([] (. tree nodes) mapping)
        (case (call .node-stream-collector-mapping row)
          (let callee (if-expr (. row callee) (. row callee text) (. row caller text)))
          (let level (call accumulator-level (. row caller text)))
          (if (== level (. U32 max))
            (call refuse .refused-expression mapping)
            (return marks)
          )
          (+= borrows (call Borrow callee level))
          (let mark (call (. ir add-local) u64-layout))
          (call store-local mark (call load-local (. ([] capture-levels level) size) id) id)
          (+= marks (call LevelMark level mark))
        )
      )
    )
    (return marks)
  )
  (fn-do + rule-call StreamPart
    (param run StreamRun)
    (param id SyntaxId)
    (param result TypeId)
    (param cursor Operand)
    (param failed IRBlockId)
    (param mappings (of RowRange SyntaxId) (= (call (of RowRange SyntaxId))))
    (param spanned Bool (= false))
    ; A call of a rule a module declares: its function is given the stream, converted to a
    ; `TokenStream` of its items, the arguments written, each converted as the type pass recorded,
    ; the address the stream's items start at, the cursor and the count of items, and where to
    ; keep where it ended, how far it read and the farthest cursor a part of it failed at, which
    ; the pattern then counts as its own. Where the rule passed, the call gives what it gave and
    ; goes on where it ended; where not, the call fails. An error the rule raises leaves the
    ; function with the call. A rule made into several functions, whose names a panic or an error
    ; would show, is called only where it can do neither. A call that gives the rule a pattern
    ; whose function may raise errors calls the function made for such a pattern, as
    ; `emit-raising-rule` says, and an error it answers with leaves the function with the call.
    ; A call given collectors calls the
    ; function made for them, lending it the caller's lists, and gives no value, as does one
    ; `spanned`, which gives the text it matched, but as `spanned-value` says, and calls the function
    ; made for calls that give no collectors where the tables made one. A rule typed for
    ; the helper the pattern runs under is given it, and one whose pattern holds a rollback mark
    ; gives it, which the pattern holds where it held none. The names its arguments read that the
    ; helper makes are made first, as the type pass recorded them at the call.
    (let nothing (call make-operand .operand-void 0))
    (let fact (call own-call id))
    (let written (call (of RowRange SyntaxId)))
    (match? ([] (. tree nodes) id)
      (case (call .node-stream-call row)
        (= written (. row args))
      )
    )
    (if (== fact no-fact)
      (call refuse .refused-expression id)
      (return (call bare-part cursor))
    )
    (let row ([] (. facts calls) fact))
    (let callee (. row callee))
    (if (or (== callee no-instance) (. row is-partial) (!= (. row fills count) (+ (. written count) 1)) other-arity)
      (call refuse .refused-expression id)
      (return (call bare-part cursor))
    )
    (lazy other-arity (!= (. ([] (. instances signatures) callee) args count) (. row fills count)))
    (let mapped (!= (. mappings count) 0))
    (let target ([] (. tables instance-functions) callee))
    (let varied mapped)
    (if mapped
      (= target (call (. tables mapped-rule-of) callee 0 (call (. tables mapping-names) tree mappings)))
      (if (not (call lends-alike callee mappings))
        (call refuse .refused-expression id)
        (return (call bare-part cursor))
      )
      (else-if (and spanned (!= (call (. tables mapped-rule-of) callee 0 no-string) no-function))
        (= target (call (. tables mapped-rule-of) callee 0 no-string))
        (= varied true)
      )
    )
    (let carried no-type)
    (for (in position (..< 0 (. written count)))
      (let argument ([] (. tree children) (+ (. written start) position)))
      (let expression argument)
      (match? ([] (. tree nodes) argument)
        (case (call .node-argument named)
          (= expression (. named expr))
        )
      )
      (if (is ([] (. tree nodes) expression) .node-stream-match)
        (let raised (call (. tables pattern-raises) (. unit reading) expression))
        (if (and (!= raised no-type) (!= carried no-type))
          (call refuse .refused-expression id)
          (return (call bare-part cursor))
        )
        (if (!= raised no-type)
          (= carried raised)
        )
      )
    )
    (if (!= carried no-type)
      (= target (call (. tables raising-rule-of) callee 0 carried))
      (if (or mapped (!= (. ([] (. instances signatures) callee) errors count) 0))
        (call refuse .refused-expression id)
        (return (call bare-part cursor))
      )
    )
    (if (== target no-function)
      (call refuse .refused-expression id)
      (return (call bare-part cursor))
    )
    (for (in position (..< 0 (. row fills count)))
      (if (!= (as ([] (. facts call-fills) (+ (. row fills start) position)) U32) position)
        (call refuse .refused-expression id)
        (return (call bare-part cursor))
      )
    )
    (let named (. bound length))
    (call bind-materials run id)
    (let stream (call convert id .reason-argument (call Typed (. run stream) (. run stream-type))))
    (if (!= (. stream type) (call (. instances argument-type) callee 0))
      (call refuse .refused-conversion id)
    )
    (let mark (. pending length))
    (+= pending (. stream operand))
    (for (in position (..< 0 (. written count)))
      (let argument ([] (. tree children) (+ (. written start) position)))
      (let expression argument)
      (match? ([] (. tree nodes) argument)
        (case (call .node-argument named)
          (= expression (. named expr))
        )
      )
      (let given
        (block
          (case? (is ([] (. tree nodes) expression) .node-stream-match)
            (call pattern-value expression)
          )
          (default
            (call emit-expression expression)
          )
        )
      )
      (let value (call convert argument .reason-argument given))
      (if (!= (. value type) (call (. instances argument-type) callee (+ position 1)))
        (call refuse .refused-conversion argument)
      )
      (+= pending (. value operand))
    )
    (call drop-bound named)
    (let cells (call rule-cells run))
    (call pass-run run id cursor cells)
    (let helped (. ([] (. instances rows) callee) helper))
    (if (!= helped no-type)
      (if (!= helped (. streaming pattern-helper-type))
        (call refuse .refused-expression id)
        (call drop-pending mark)
        (return (call bare-part cursor))
      )
      (+= pending (. streaming pattern-helper))
    )
    (let given-mark (call lend-mark callee id))
    (let lendings (call lend-collectors id mappings))
    (let raising (!= (. ([] (. instances signatures) callee) errors count) 0))
    (if (and raising (not (. row propagates)))
      (call refuse .refused-expression id)
      (call drop-pending mark)
      (return (call bare-part cursor))
    )
    (= calls-rule true)
    (= takes-result raising)
    (let carries
      (scope (if-expr (!= carried no-type) rule-result no-type)
        (lazy rule-result (. ([] (. facts raising-rules) (. ([] (. tables functions) target) place)) result))
      )
    )
    (let answer
      (call call-instance
        (block
          (arg callee)
          (arg id)
          (arg mark)
          (arg false)
          (arg false)
          (arg (if-expr (or varied (!= carried no-type)) target no-function))
          (arg carries)
        )
      )
    )
    (= takes-result false)
    (if raising
      (= answer (call propagate id callee (. answer operand)))
    )
    (if (!= carried no-type)
      (= answer (call propagate-held id carries (. answer operand)))
    )
    (return
      (call take-rule-answer
        (block
          (arg run)
          (arg id)
          (arg result)
          (arg cursor)
          (arg failed)
          (arg cells)
          (arg answer)
          (arg given-mark)
          (arg lendings)
          (arg mapped)
          (arg spanned)
        )
      )
    )
  )
  (fn-do + adapter-call StreamPart
    (param run StreamRun)
    (param id SyntaxId)
    (param adapter FunctionId)
    (param rule SyntaxId)
    (param result TypeId)
    (param cursor Operand)
    (param failed IRBlockId)
    ; A call of a local rule beside a match from the rule's own arms, as the reference makes it:
    ; of the function it makes of the rule, as it calls a function given the stream. The stream
    ; is told the pattern stands at the cursor, the function is given the stream, and the pattern
    ; takes what it answered as `boundary-answer` says; an error it raises leaves the function
    ; with the call. The reference makes the function at the
    ; first such call, inside the run of the rule the call is in, and with it forgets that the
    ; rule is being run: a later call from the arms of that run runs the rule where it is called
    ; once more. So the first call here, outside the rule's own function, ends that run's hold on
    ; the rule; one made while another rule is being run, or in a function made of a rule or an
    ; action, is refused, since what the reference forgets there is not followed.
    (let commit (call (. facts call-in-role) (. unit reading) id .role-commit))
    (let viewed (call (. facts call-in-role) (. unit reading) id .role-view))
    (let place (call (. facts local-rule-of) (. unit reading) rule))
    (let answered (if-expr (!= place (. U32 max)) (. ([] (. facts local-rules) place) adapted) no-type))
    (let target ([] (. tables functions) adapter))
    (if (or unviewed (== answered no-type) (!= (. unit reading) (. unit instance)) other-rule-stream)
      (call refuse .refused-expression id)
      (return (call bare-part cursor))
    )
    (lazy unviewed (or (== commit no-fact) (== viewed no-fact) (not (call holds-only id (list commit viewed)))))
    (lazy other-rule-stream (!= (. run stream-type) (. ([] (. facts local-rules) place) stream)))
    (let own (and (== (. function kind) .lazy-rule) (== (. function place) rule)))
    (if (and (not own) (== (call (. adapted find) rule) null))
      (for (in position (..< 0 (. inlining length)))
        (if (!= ([] inlining position) rule)
          (call refuse .refused-expression id)
          (return (call bare-part cursor))
        )
      )
      (if (or lazy-or-mapped raising-or-helper cast-or-action)
        (call refuse .refused-expression id)
        (return (call bare-part cursor))
      )
      (lazy lazy-or-mapped (or (== (. function kind) .lazy-rule) (== (. function kind) .mapped-rule)))
      (lazy raising-or-helper (or (== (. function kind) .raising-rule) (== (. function kind) .pattern-helper)))
      (lazy cast-or-action (or (== (. function kind) .pattern-cast) (== (. function kind) .stream-action)))
      (+= adapted rule)
      (call stop-inlining rule)
    )
    (call call-protocol
      (block
        (arg id)
        (arg commit)
        (arg (. run stream))
        (arg (. run stream-type))
        (arg cursor)
        (arg (. types index-type))
        (arg true)
        (arg cursor)
        (arg (. types index-type))
      )
    )
    (let raising (!= (. ([] (. instances signatures) (. unit instance)) errors count) 0))
    (let returned (if-expr raising (. ([] (. facts local-rules) place) relayed) answered))
    (if (or (== returned no-type) (and raising in-zone))
      (call refuse .refused-expression id)
    )
    (let returns (call layout-of returned id))
    (let mark (. pending length))
    (+= pending (. run stream))
    (call (. ir depend) .callee-function adapter (if-expr (. target may-panic) may-panic-dependency 0u32))
    (let enters (call is-free (. unit instance)))
    (let crosses (!= enters in-zone))
    (let checked (and (. target may-panic) (not in-landing)))
    (let closing (call closing-pad (and checked crosses enters)))
    (if crosses
      (call cross-zone id enters)
    )
    (let answer
      (call call
        (block
          (arg (call make-operand .operand-symbol (. target symbol)))
          (arg id)
          (arg mark)
          (arg .callee-function)
          (arg returns)
          (arg checked)
          (arg false)
          (arg closing)
        )
      )
    )
    (call cross-back id enters raising)
    (call land-closed closing id)
    (if raising
      (= answer (. (call propagate-held id returned answer) operand))
    )
    (return (call boundary-answer run id viewed (call Typed answer answered) result cursor failed))
