    (let answer-type (if-expr (!= place (. U32 max)) (. ([] (. facts local-rules) place) answer) no-type))
    (let signature ([] (. instances signatures) (. unit instance)))
    (let raising (!= (. signature errors count) 0))
    (let returned (if-expr (and raising (!= place (. U32 max))) (. ([] (. facts local-rules) place) result) answer-type))
    (if (!= carried-given no-type)
      (= called (call (. tables raising-rule-of) (. unit instance) (call (. tables lazy-rule-decl) target) carried-given))
      (if (or (== called no-function) raising (!= (. mappings count) 0) (!= (. target kind) .lazy-rule))
        (call refuse .refused-expression id)
        (return (call bare-part cursor))
      )
      (= target ([] (. tables functions) called))
      (= returned (. ([] (. facts raising-rules) (. target place)) result))
      (= raising true)
    )
    (let helped (. ([] (. instances rows) (. unit instance)) helper))
    (let bare (!= (call (. tables rule-adapter-of) (. unit instance) (call (. tables lazy-rule-decl) target)) no-function))
    (if bare
      (if (or unanswerable (!= helped no-type) (!= (. mappings count) 0) spanned other-rule-stream)
        (call refuse .refused-expression id)
        (return (call bare-part cursor))
      )
      (lazy unanswerable (or (== answer-type no-type) (== returned no-type) (and raising in-zone)))
      (lazy other-rule-stream (!= (. run stream-type) (. ([] (. facts local-rules) place) stream)))
      (else-if (or (not rule-arguments) answerless other-stream (and raising in-zone) other-helper)
        (call refuse .refused-expression id)
        (return (call bare-part cursor))
      )
    )
    (lazy answerless (or (== answer-type no-type) (== returned no-type) (== (. signature args count) 0)))
    (lazy other-stream (!= (. run stream-type) (call (. instances argument-type) (. unit instance) 0)))
    (lazy other-helper (and (!= helped no-type) (!= (. streaming pattern-helper-type) helped)))
    (let returns (call layout-of returned id))
    (let cells (call rule-cells run))
    (let mark (. pending length))
    (+= pending (. run stream))
    (if (not bare)
      (for (in position (..< 1 (. signature args count)))
        (+= pending (call rule-argument position id))
      )
    )
    (call pass-run run id cursor cells)
    (if (!= helped no-type)
      (+= pending (. streaming pattern-helper))
    )
    (let given-mark (call lend-mark (. unit instance) id))
    (let lendings (call lend-collectors id mappings))
    (call (. ir depend) .callee-function called (if-expr (. target may-panic) may-panic-dependency 0u32))
    (let enters (call is-free (. unit instance)))
    (let crosses (!= enters in-zone))
    (let checked (and (. target may-panic) (not in-landing)))
    (let closing (call closing-pad (and checked crosses enters)))
    (if crosses
      (call cross-zone id enters)
    )
    (let answer
      (call call
        (block
          (arg (call make-operand .operand-symbol (. target symbol)))
          (arg id)
          (arg mark)
          (arg .callee-function)
          (arg returns)
          (arg checked)
          (arg false)
          (arg closing)
        )
      )
    )
    (call cross-back id enters raising)
    (call land-closed closing id)
    (if raising
      (= answer (. (call propagate-held id returned answer) operand))
    )
    (let answered (call Typed answer answer-type))
    (return
      (call take-rule-answer
        (block
          (arg run)
          (arg id)
          (arg result)
          (arg cursor)
          (arg failed)
          (arg cells)
          (arg answered)
          (arg given-mark)
          (arg lendings)
          (arg (!= (. mappings count) 0))
          (arg spanned)
        )
      )
    )
  )
  (fn-do _ lend-collectors (list Lending)
    (param id SyntaxId)
    (param mappings (of RowRange SyntaxId))
    ; Lends a function a call runs the lists of the caller's names its collectors map, in the
    ; order written: each as a collector in memory of the frame, whose pointer is the next
    ; argument, holding the list's items and count, and the context its backing keeps them with.
    (let lendings (list Lending))
    (for (in mapping ([] (. tree children) mappings))
      (match? ([] (. tree nodes) mapping)
        (case (call .node-stream-collector-mapping row)
          (let level (call accumulator-level (. row caller text)))
          (if (== level (. U32 max))
            (call refuse .refused-expression mapping)
            (return lendings)
          )
          (let held ([] capture-levels level))
          (let layout (call layout-of (. held collector) id))
          (let memory (call frame layout))
          (call zero memory layout)
          (call put memory (call (. tables layouts field) layout 0) (call load-local (. held items) id) id)
          (call put memory (call (. tables layouts field) layout 1) (call load-local (. held size) id) id)
          (if (!= (. held context) no-local)
            (call put memory (call (. tables layouts field) layout 2) (call load-local (. held context) id) id)
          )
          (+= pending (call address memory 0 pointer-layout id))
          (+= lendings (call Lending memory level))
        )
      )
    )
    (return lendings)
  )
  (fn-do _ reclaim-collectors _
    (param lendings (list Lending))
    (param id SyntaxId)
    ; Takes back into each list the caller keeps what the function a call ran left in the
    ; collector it was lent.
    (for (in lending lendings)
      (let held ([] capture-levels (. lending level)))
      (let layout (call layout-of (. held collector) id))
      (call store-local (. held items) (call take (. lending memory) (call (. tables layouts field) layout 0) id) id)
      (call store-local (. held size) (call take (. lending memory) (call (. tables layouts field) layout 1) id) id)
    )
  )
  (fn-do _ lends-alike Bool
    (param callee InstanceId)
    (param mappings (of RowRange SyntaxId))
    ; Whether each list of the caller's a call of a rule a module declares lends it is a list of
    ; what the rule's name it is given for accumulates, kept in a collector of the same type, as
    ; the type pass typed the rule.
    (let row ([] (. instances rows) callee))
    (let source (. ([] (. program modules) (. row module)) tree))
    (let pattern SyntaxId 0)
    (match? ([] (. source nodes) (call rule-match program (. row module) (. row decl)))
      (case (call .node-stream-match matched)
        (= pattern (. matched pattern))
      )
    )
    (for (in mapping ([] (. tree children) mappings))
      (match? ([] (. tree nodes) mapping)
        (case (call .node-stream-collector-mapping written)
          (let name (if-expr (. written callee) (. written callee text) (. written caller text)))
          (let level (call accumulator-level (. written caller text)))
          (let site (if-expr (!= pattern 0) (call accumulated-site source pattern name) 0))
          (if (or (== site 0) (== level (. U32 max)) list-differs mismatched)
            (return false)
          )
          (lazy list-differs (!= (call (. facts node-type) callee site) (. ([] capture-levels level) list)))
          (lazy mismatched (!= (call accumulated-collector callee site) (. ([] capture-levels level) collector)))
        )
      )
    )
    (return true)
  )
  (fn-do _ accumulated-site SyntaxId
    (param source AST)
    (param id SyntaxId)
    (param name String)
    ; Where a pattern captures a name it accumulates in a part of its own, or none.
    (match? ([] (. source nodes) id)
      (case (call .node-stream-capture row)
        (let named (call (. source identifier-name) (. row name)))
        (if (and (. row accumulating) named (== (. named text) name))
          (return (. row name))
        )
        (return (call accumulated-site source (. row pattern) name))
      )
      (case (call .node-stream-and row)
        (let left (call accumulated-site source (. row left) name))
        (return (if-expr (!= left 0) left (call accumulated-site source (. row right) name)))
      )
      (case (call .node-stream-or row)
        (let left (call accumulated-site source (. row left) name))
        (return (if-expr (!= left 0) left (call accumulated-site source (. row right) name)))
      )
      (case (call .node-stream-transform row)
        (if (!= (. row pattern) 0)
          (return (call accumulated-site source (. row pattern) name))
        )
      )
      (case (call .node-stream-panic row)
        (return (call accumulated-site source (. row pattern) name))
      )
      (case (call .node-stream-unary row)
        (return (call accumulated-site source (. row operand) name))
      )
      (case (call .node-stream-length row)
        (return (call accumulated-site source (. row operand) name))
      )
    )
    (return 0)
  )
  (fn-do _ accumulated-collector TypeId
    (param owner InstanceId)
    (param site SyntaxId)
    ; The collector an instance keeps the list of a name it accumulates in, by the call the type
    ; pass recorded at the name that grows it.
    (let fact (call (. facts call-in-role) owner site .role-grow))
    (if (or (== fact no-fact) (== (. ([] (. facts calls) fact) callee) no-instance))
      (return no-type)
    )
    (return (. ([] (. instances rows) (. ([] (. facts calls) fact) callee)) self-type))
  )
  (fn-do + hold-captures _ (?! Refused)
    (param run StreamRun)
    (param id SyntaxId)
    (param repeats U32 (= 0))
    ; Keeps a place for each name a grammar captures: the cursors its text begins and ends
    ; at, and for an optional name whether it holds any, which starts as none; or for a name that
    ; holds what a rule gave or an item a test passed, a local of its type, which for an optional
    ; name starts as nothing, or in repeats of what one pass captured; and for a name captured in
    ; repeats, the list each keeps. Each name is bound to its place
    ; while the arms are emitted. A name a rule's arms capture with different types has a place
    ; for each type, and one captured as text in one arm and as what a rule gave in another has a
    ; place for each. A rule run where it is called keeps places of its own, apart from those a
    ; run of it that this one is inside keeps.
    (match? ([] (. tree nodes) id)
      (case (call .node-stream-capture row)
        (let slot (call captured-slot (. row name)))
        (if (== slot no-slot)
          (call refuse .refused-expression id)
          (return)
        )
        (if (. row accumulating)
          (if (not (call held-here (call captured-at slot)))
            (call hold-accumulator run id slot (. row name))
          )
          (call hold-captures run (. row pattern) repeats)
          (return)
        )
        (let valued (== (call (. facts plan-of) (. unit reading) (. row name)) .plan-stream-value))
        (if (not (call held-here (call captured-as slot (call (. facts node-type) (. unit reading) (. row name)) valued)))
          (let type (call (. facts node-type) (. unit reading) (. row name)))
          (let begin (call (. ir add-local) (. run index-layout)))
          (let end (call (. ir add-local) (. run index-layout)))
          (call store-local begin (. run start) id)
          (call store-local end (. run start) id)
          (let present no-local)
          (let value no-local)
          (if (and valued (== repeats 0))
            (let layout (call layout-of type id))
            (= value (call (. ir add-local) layout))
            (if (call (. types is-optional) type)
              (call store-local value (. (call empty-optional type layout) operand) id)
            )
            (else-if (and (not valued) (call (. types is-optional) type) (== repeats 0))
              (= present (call (. ir add-local) u8-layout))
              (call store-local present (call integer .machine-u8 0) id)
            )
          )
          (let levels (as (. capture-levels length) U32))
          (+= bound
            (call BoundValue
              (block
                (arg slot)
                (arg type)
                (arg (call make-operand .operand-void 0))
                (arg (. U32 max))
                (arg (as (. stream-captures length) U32))
              )
            )
          )
          (+= stream-captures
            (call StreamCapture
              (block
                (arg slot)
                (arg (. row name))
                (arg begin)
                (arg end)
                (arg present)
                (arg value)
                (arg type)
                (arg run)
                (arg repeats)
                (arg levels)
              )
            )
          )
          (let held (as (- (. stream-captures length) 1) U32))
          (call hold-levels held id)
          (if (and valued (!= repeats 0))
            (= ([] stream-captures held) (= (. ([] stream-captures held) value) (call (. ir add-local) (call layout-of (. ([] capture-levels levels) item) id))))
          )
        )
        (call hold-captures run (. row pattern) repeats)
      )
      (case (call .node-stream-and row)
        (call hold-captures run (. row left) repeats)
        (call hold-captures run (. row right) repeats)
      )
      (case (call .node-stream-or row)
        (call hold-captures run (. row left) repeats)
        (call hold-captures run (. row right) repeats)
      )
      (case (call .node-stream-transform row)
        (call hold-captures run (. row pattern) repeats)
      )
      (case (call .node-stream-panic row)
        (call hold-captures run (. row pattern) repeats)
      )
      (case (call .node-stream-unary row)
        (let repeat (or (== (. row op) .zero-or-more-op) (== (. row op) .one-or-more-op)))
        (call hold-captures run (. row operand) (if-expr repeat (+ repeats 1) repeats))
      )
      (case (call .node-stream-length row)
        (call hold-captures run (. row operand) (+ repeats 1))
      )
    )
  )
  (fn-expr _ held-here Bool
    (param position U32)
    ; Whether a place a name is kept in is one of the rule being run where it is called, and not
    ; one of a run this one is inside.
    (and (!= position (. U32 max)) (>= position (. streaming capture-floor)))
  )
  (fn-do _ hold-accumulator _
    (param run StreamRun)
    (param id SyntaxId)
    (param slot SlotId)
    (param name SyntaxId)
    ; Keeps the list a name that accumulates adds to, empty as the pattern starts, as the
    ; reference's collector starts, or the list of the caller's a call given a collector for the
    ; name `borrows`.
    (let type (call (. facts node-type) (. unit reading) name))
    (let text (. (!! (call (. tree identifier-name) name)) text))
    (for (in borrow borrows)
      (if (== (. borrow name) text)
        (if (!= (. ([] capture-levels (. borrow level)) list) type)
          (call refuse .refused-expression id)
          (return)
        )
        (+= bound
          (call BoundValue
            (block
              (arg slot)
              (arg type)
              (arg (call make-operand .operand-void 0))
              (arg (. U32 max))
              (arg (as (. stream-captures length) U32))
            )
          )
        )
        (+= stream-captures
          (call StreamCapture
            (block
              (arg slot)
              (arg name)
              (arg no-local)
              (arg no-local)
              (arg no-local)
              (arg no-local)
              (arg type)
              (arg run)
              (arg 1)
              (arg (. borrow level))
              (arg true)
              (arg true)
            )
          )
        )
        (return)
      )
    )
    (let levels (as (. capture-levels length) U32))
    (+= bound
      (call BoundValue
        (block
          (arg slot)
          (arg type)
          (arg (call make-operand .operand-void 0))
          (arg (. U32 max))
          (arg (as (. stream-captures length) U32))
        )
      )
    )
    (+= stream-captures
      (call StreamCapture
        (block
          (arg slot)
          (arg name)
          (arg no-local)
          (arg no-local)
          (arg no-local)
          (arg no-local)
          (arg type)
          (arg run)
          (arg 1)
          (arg levels)
          (arg true)
        )
      )
    )
    (call hold-levels (as (- (. stream-captures length) 1) U32) id)
    (let level ([] capture-levels levels))
    (if (!= lent-first (. U32 max))
      (for (in position (..< 0 (. collector-args length)))
        (if (== ([] collector-args position) text)
          (let pointer (call make-operand .operand-argument (+ lent-first (as position U32))))
          (let layout (call layout-of (. level collector) id))
          (call store-local (. level items) (call take pointer (call (. tables layouts field) layout 0) id) id)
          (call store-local (. level size) (call take pointer (call (. tables layouts field) layout 1) id) id)
          (if (!= (. level context) no-local)
            (call store-local (. level context) (call take pointer (call (. tables layouts field) layout 2) id) id)
          )
          (let mark (call (. ir add-local) u64-layout))
          (call store-local mark (call load-local (. level size) id) id)
          (+= lent (call LentCollector (+ lent-first (as position U32)) level mark))
          (return)
        )
      )
    )
    (call start-level level id)
  )
  (fn-do _ hold-levels _
    (param held U32)
    (param site SyntaxId)
    ; Keeps the list each repeat around a name keeps, from the innermost out, as the calls the type pass
    ; recorded at the name that grow them say: a collector of the text or of the item, then of the lists
    ; the repeat inside it made. Each list is the type of an item of the next, and the outermost is the
    ; name's type.
    (let capture ([] stream-captures held))
    (if (== (. capture listed) 0)
      (return)
    )
    (let growers (list FactId))
    (for (in level (..< 0 (. capture listed)))
      (let fact (call (. facts nth-in-role) (. unit reading) (. capture site) .role-grow level))
      (if (or (== fact no-fact) (== (. ([] (. facts calls) fact) callee) no-instance))
        (call refuse .refused-expression site)
        (return)
      )
      (+= growers fact)
    )
    (for (in level (..< 0 (. growers length)))
      (let callee (. ([] (. facts calls) ([] growers level)) callee))
      (let collector (. ([] (. instances rows) callee) self-type))
      (let outer
        (scope (if-expr (< (+ level 1) (. growers length)) outer-collector no-type)
          (lazy outer-collector (. ([] (. instances rows) (. ([] (. facts calls) ([] growers (+ level 1))) callee)) self-type))
        )
      )
      (let ranged (call material-at (. capture site) .material-ranges))
      (let last (if-expr (!= ranged (. U32 max)) (. ([] (. facts materials) ranged) type) (. capture type)))
      (let list (if-expr (!= outer no-type) (call class-arg types outer 0) last))
      (let items (call (. ir add-local) (call layout-of (. ([] (. instances signatures) callee) returns) site)))
      (let size (call (. ir add-local) u64-layout))
      (let context (call context-local collector site))
      (+= capture-levels
        (call CaptureLevel
          (block
            (arg held)
            (arg items)
            (arg size)
            (arg ([] growers level))
            (arg collector)
            (arg (call class-arg types collector 0))
            (arg list)
            (arg context)
          )
        )
      )
    )
  )
  (fn-do + drop-captures _
    (param captured Size)
    ; Drops the places of the names captured since a count of them, with their lists, but for
    ; the lists of callers they borrowed.
    (for (in position (..< captured (. stream-captures length)))
      (if (not (. ([] stream-captures position) borrowed))
        (let kept (as (. ([] stream-captures position) levels) Size))
        (-= ([] capture-levels (..< kept (. capture-levels length))))
        (break)
      )
    )
    (-= ([] stream-captures (..< captured (. stream-captures length))))
  )
  (fn-expr _ captured-slot SlotId
    (param name SyntaxId)
    (if-expr (== (. resolution kind) .resolve-slot) (. resolution slot) no-slot)
    (where
      (lazy resolution (call (. bindings resolution-of) (. ([] (. instances rows) (. unit reading)) binding) name))
    )
  )
  (fn-do _ captured-as U32
    (param slot SlotId)
    (param type TypeId)
    (param valued Bool)
    ; The place the pattern keeps a name captured with a type in, as what a rule gave where
    ; `valued` and else as the text it matched, or `U32.max`.
    (let position (. stream-captures length))
    (while (!= position 0)
      (-= position 1)
      (let place ([] stream-captures position))
      (if (and (== (. place slot) slot) (== (. place type) type) (== (!= (. place value) no-local) valued))
        (return (as position U32))
      )
    )
    (return (. U32 max))
  )
  (fn-do _ activate-captures _
    (param arm SyntaxId)
    ; Makes the places an arm keeps its names in the ones their slots read while the arm is
    ; emitted: where another arm of the rule captures a name with another type, or as what a
    ; rule gave where this one captures its text, or the other way, whose place the slot would
    ; read, the arm's own is put after it for as long as the arm is emitted. An arm whose
    ; alternatives capture one name both ways reads the place that keeps what a rule gave, as
    ; `stream-capture` says.
    (call activate-kind arm false)
    (call activate-kind arm true)
  )
  (fn-do _ activate-kind _
    (param arm SyntaxId)
    (param valued Bool)
    ; Puts the places of the names an arm captures as what a rule gave, where `valued`, or as the
    ; text they matched, after the ones their slots would read.
    (for (in node (..< (call (. tree subtree-start) arm) (+ arm 1)))
      (match? ([] (. tree nodes) node)
        (case (call .node-stream-capture row)
          (let slot (call captured-slot (. row name)))
          (let type (call (. facts node-type) (. unit reading) (. row name)))
          (let held (if-expr (!= slot no-slot) (call captured-at slot) (. U32 max)))
          (if (and plan-matches open-capture (or (!= (. ([] stream-captures held) type) type) value-differs))
            (let place (call captured-as slot type valued))
            (if (== place (. U32 max))
              (call refuse .refused-expression node)
              (return)
            )
            (let kept ([] stream-captures place))
            (+= bound
              (call BoundValue
                (block
                  (arg slot)
                  (arg type)
                  (arg (call make-operand .operand-void 0))
                  (arg (. U32 max))
                  (arg (as (. stream-captures length) U32))
                )
              )
            )
            (+= stream-captures
              (call StreamCapture
                (block
                  (arg (. kept slot))
                  (arg (. kept site))
                  (arg (. kept begin))
                  (arg (. kept end))
                  (arg (. kept present))
                  (arg (. kept value))
                  (arg (. kept type))
                  (arg (. kept run))
                  (arg (. kept listed))
                  (arg (. kept levels))
                  (arg (. kept accumulates))
                  (arg true)
                )
              )
            )
          )
          (lazy plan-matches
            (block
              (== (== (call (. facts plan-of) (. unit reading) (. row name)) .plan-stream-value) valued)
            )
          )
          (lazy open-capture (and (!= held (. U32 max)) (not (. ([] stream-captures held) accumulates))))
          (lazy value-differs (!= (!= (. ([] stream-captures held) value) no-local) valued))
        )
      )
    )
  )
  (fn-do _ captured-at U32
    (param slot SlotId)
    (let position (. stream-captures length))
    (while (!= position 0)
      (-= position 1)
      (if (== (. ([] stream-captures position) slot) slot)
        (return (as position U32))
      )
    )
    (return (. U32 max))
  )
  (fn-do _ stream-capture StreamPart
    (param run StreamRun)
    (param id SyntaxId)
    (param name SyntaxId)
    (param pattern SyntaxId)
    (param cursor Operand)
    (param failed IRBlockId)
    ; A part a name captures: where it passes, the name holds the text from the cursor to where
    ; it ended, or what a rule the part calls gave, held as an optional where the name is one. A
    ; name that captures an optional part holds nothing where the part's operand fails. A part
    ; the type pass recorded to make its text through the helper makes it where it passes, as
    ; `make-eager` says. A name another alternative of the arm captures as what a rule gave keeps
    ; its text in the same place, made where the part passes, as the reference makes it where the
    ; alternatives join; under a helper, or where the two are not one type, it is refused.
    (let held (call captured-at (call captured-slot name)))
    (if (== held (. U32 max))
      (call refuse .refused-expression id)
      (return (call bare-part cursor))
    )
    (let capture ([] stream-captures held))
    (if (. capture accumulates)
      (return (call accumulate run id name pattern capture cursor failed))
    )
    (if (and (!= (. capture value) no-local) (!= (call (. facts plan-of) (. unit reading) name) .plan-stream-value))
      (if (or listed-or-helped (call (. types is-optional) (. capture type)) retyped-or-partial)
        (call refuse .refused-expression id)
        (return (call bare-part cursor))
      )
      (lazy listed-or-helped (or (!= (. capture listed) 0) (!= (. streaming pattern-helper-type) no-type)))
      (lazy retyped-or-partial
        (block
          (or (!= (call (. facts node-type) (. unit reading) name) (. capture type)) (call (. tree optional-part) pattern))
        )
      )
      (let part (call emit-stream-part run pattern cursor failed))
      (let text (call stream-text run name cursor (. part ending)))
      (call store-local (. capture value) (. text operand) id)
      (return part)
    )
    (if (!= (. capture value) no-local)
      (let part (call emit-stream-part run pattern cursor failed))
      (let given (. part value operand))
      (let given-type (. part value type))
      (if (== given-type no-type)
        (call refuse .refused-expression id)
        (return (call bare-part cursor))
      )
      (let kept given)
      (let kept-type (if-expr (!= (. capture listed) 0) (. ([] capture-levels (. capture levels)) item) (. capture type)))
      (if (!= given-type kept-type)
        (if (or (not (call (. types is-optional) kept-type)) (!= (call (. types optional-inner) kept-type) given-type))
          (call refuse .refused-expression id)
          (return (call bare-part cursor))
        )
        (= kept (. (call wrap id (call Typed given given-type) kept-type) operand))
      )
      (call store-local (. capture value) kept id)
      (return part)
    )
    (match? ([] (. tree nodes) pattern)
      (case (call .node-stream-unary row)
        (if (and (== (. row op) .zero-or-one-op) (!= (. capture present) no-local))
          (let joined (call (. ir reserve-block)))
          (let missed (call (. ir reserve-block)))
          (let mark (. joins length))
          (let marks (call mark-levels (. row operand)))
          (let tried (call emit-stream-part run (. row operand) cursor missed))
          (let passed (. tried ending))
          (call hold-text capture cursor passed id)
          (call make-eager run pattern cursor passed)
          (call arrive id passed joined (call make-operand .operand-void 0))
          (call (. ir start-block) missed)
          (call rewind-levels marks id)
          (call clear-captures (. row operand) id)
          (call store-local (. capture present) (call integer .machine-u8 0) id)
          (call arrive id cursor joined (call make-operand .operand-void 0))
          (return
            (call StreamPart
              (block
                (arg (call close-joins joined mark (. run index-layout) (call make-operand .operand-void 0)))
                (arg (. tried value))
              )
            )
          )
        )
      )
    )
    (let part (call emit-stream-part run pattern cursor failed))
    (if (and (call (. tree optional-part) pattern) (!= (call material-at pattern .material-eager) (. U32 max)))
      (call refuse .refused-expression id)
      (return (call bare-part cursor))
    )
    (call hold-text capture cursor (. part ending) id)
    (call make-eager run pattern cursor (. part ending))
    (return part)
  )
  (fn-do _ make-eager _
    (param run StreamRun)
    (param part SyntaxId)
    (param begun Operand)
    (param ending Operand)
    ; Makes what the type pass recorded a part a name captures makes of the text it matched
    ; where it passes, by a capture materializer of the helper, as the reference makes it there.
    ; Nothing reads what it makes.
    (let eager (call material-at part .material-eager))
    (if (!= eager (. U32 max))
      (call material-capture run part eager begun ending)
    )
  )
  (fn-do _ accumulate StreamPart
    (param run StreamRun)
    (param id SyntaxId)
    (param name SyntaxId)
    (param pattern SyntaxId)
    (param capture StreamCapture)
    (param cursor Operand)
    (param failed IRBlockId)
    ; A part whose name accumulates: where it passes, its list gains the text it matched, made
    ; then, or what a rule it calls gave. The part gives what its own part gives. One the type
    ; pass recorded to make its text through the helper makes it too, as `make-eager` says.
    (let part (call emit-stream-part run pattern cursor failed))
    (call make-eager run pattern cursor (. part ending))
    (let element (. part value))
    (if (!= (call (. facts plan-of) (. unit reading) name) .plan-stream-value)
      (= element (call stream-text run name cursor (. part ending)))
      (else-if (== (. part value type) no-type)
        (call refuse .refused-expression id)
      )
    )
    (call append-level ([] capture-levels (. capture levels)) element name)
    (return part)
  )
  (fn-do _ mark-levels (list LevelMark)
    (param id SyntaxId)
    ; Keeps how many items each list of a name that accumulates in a part of a pattern holds
    ; where the part begins, and each list of the caller's a call in it is given a collector for.
    (let marks (list LevelMark))
    (call mark-levels-in id marks)
    (for (in position (..< 0 (. marks length)))
      (let level ([] capture-levels (. ([] marks position) level)))
      (let mark (call (. ir add-local) u64-layout))
      (call store-local mark (call load-local (. level size) id) id)
      (= ([] marks position) (= (. ([] marks position) mark) mark))
    )
    (return marks)
  )
  (fn-do _ mark-levels-in _
    (param id SyntaxId)
    (param marks (list LevelMark))
    (match? ([] (. tree nodes) id)
      (case (call .node-stream-capture row)
        (let held (call captured-at (call captured-slot (. row name))))
        (if (and (!= held (. U32 max)) (. ([] stream-captures held) accumulates))
          (let level (. ([] stream-captures held) levels))
          (let found false)
          (for (in mark marks)
            (= found (or found (== (. mark level) level)))
          )
          (if (not found)
            (+= marks (call LevelMark level no-local))
          )
        )
        (call mark-levels-in (. row pattern) marks)
      )
      (case (call .node-stream-call row)
        (for (in mapping ([] (. tree children) (. row collector-mappings)))
          (match? ([] (. tree nodes) mapping)
            (case (call .node-stream-collector-mapping written)
              (let level (call accumulator-level (. written caller text)))
              (let found false)
              (for (in mark marks)
                (= found (or found (== (. mark level) level)))
              )
              (if (and (!= level (. U32 max)) (not found))
                (+= marks (call LevelMark level no-local))
              )
            )
          )
        )
      )
      (case (call .node-stream-and row)
        (call mark-levels-in (. row left) marks)
        (call mark-levels-in (. row right) marks)
      )
      (case (call .node-stream-or row)
        (call mark-levels-in (. row left) marks)
        (call mark-levels-in (. row right) marks)
      )
      (case (call .node-stream-transform row)
        (if (!= (. row pattern) 0)
          (call mark-levels-in (. row pattern) marks)
        )
      )
      (case (call .node-stream-panic row)
        (call mark-levels-in (. row pattern) marks)
      )
      (case (call .node-stream-unary row)
        (call mark-levels-in (. row operand) marks)
      )
      (case (call .node-stream-length row)
        (call mark-levels-in (. row operand) marks)
      )
    )
  )
  (fn-do + rewind-levels _
    (param marks (list LevelMark))
    (param site SyntaxId)
    ; Cuts each list back to the count it held where a part began, as the reference's collector
    ; is rewound: an item past it that holds what the collector traces is first set to what its
    ; type holds with nothing written.
    (for (in held marks)
      (call rewind-level ([] capture-levels (. held level)) (. held mark) site)
    )
  )
  (fn-do + rewind-level _
    (param level CaptureLevel)
    (param mark LocalId)
    (param site SyntaxId)
    ; Cuts a list back to the count a local holds, setting each item past it that holds what the
    ; collector traces to what its type holds with nothing written first.
    (let item-layout (call layout-of (. level item) site))
    (if (. ([] (. tables layouts rows) item-layout) is-managed)
      (let index (call (. ir add-local) u64-layout))
      (call store-local index (call load-local mark site) site)
      (let test (call (. ir reserve-block)))
      (let body (call (. ir reserve-block)))
      (let done (call (. ir reserve-block)))
      (call jump test)
      (call (. ir start-block) test)
      (call branch
        (block
          (arg (call compare site .compare-less (call load-local index site) (call load-local (. level size) site)))
          (arg body)
          (arg done)
        )
      )
      (call (. ir start-block) body)
      (let blank (call blank-item level item-layout site))
      (call put-item level (call load-local index site) (. blank operand) item-layout site)
      (call store-local
        (block
          (arg index)
          (arg
            (call arithmetic
              (block
                (arg site)
                (arg .arithmetic-add)
                (arg (call load-local index site))
                (arg (call integer .machine-u64 1))
                (arg u64-layout)
              )
            )
          )
          (arg site)
        )
      )
      (call jump test)
      (call (. ir start-block) done)
    )
    (call store-local (. level size) (call load-local mark site) site)
  )
  (fn-do _ blank-item Typed
    (param level CaptureLevel)
    (param layout LayoutId)
    (param site SyntaxId)
    ; What an item of a list holds with nothing written, as the reference's default value of its
    ; type: the empty text for a text, and no bits set but for the texts in a struct.
    (if (call (. tables layouts is-struct) layout)
      (return (call null-value (. level item) layout site))
    )
    (if (== (. level item) (. types string-type))
      (return (call Typed (call make-operand .operand-constant (call (. ir add-string) "")) (. level item)))
    )
    (return (call Typed (call integer .machine-pointer 0) (. level item)))
  )
  (fn-do + no-mark Typed
    (param site SyntaxId)
    ; A rollback mark that holds none: zero for one held as an integer, as the reference keeps one,
    ; and else the optional that holds nothing.
    (let row ([] (. facts rollback-bodies) (. streaming rollback-row)))
    (let layout (call layout-of (. row kept) site))
    (if (== (. row kept) (. row held))
      (return (call Typed (call integer (call (. tables layouts kind-of) layout) 0) (. row held)))
    )
    (return (call empty-optional (. row kept) layout))
  )
  (fn-do + holds-mark Operand
    (param mark Operand)
    (param site SyntaxId)
    ; Whether a rollback mark holds one.
    (let row ([] (. facts rollback-bodies) (. streaming rollback-row)))
    (if (== (. row kept) (. row held))
      (let compared
        (call compare
          (block
            (arg site)
            (arg .compare-not-equal)
            (arg mark)
            (arg (call integer (call (. tables layouts kind-of) (call layout-of (. row held) site)) 0))
          )
        )
      )
      (return compared)
    )
    (return (. (call present site (call Typed mark (. row kept))) operand))
  )
  (fn-do + ensure-mark _
    (param site SyntaxId)
    ; Asks the helper for a rollback mark before an action runs, where the part being emitted holds
    ; none yet, as the reference asks for one: the earliest it holds is kept.
    (if (== (. streaming rollback-mark) no-local)
      (call refuse .refused-expression site)
      (return)
    )
    (let row ([] (. facts rollback-bodies) (. streaming rollback-row)))
    (let asked (call (. ir reserve-block)))
    (let done (call (. ir reserve-block)))
    (call branch (call holds-mark (call load-local (. streaming rollback-mark) site) site) done asked)
    (call (. ir start-block) asked)
    (let made
      (call call-protocol
        (block
          (arg site)
          (arg (. row mark))
          (arg (. streaming pattern-helper))
          (arg (. streaming pattern-helper-type))
          (arg (call make-operand .operand-void 0))
        )
      )
    )
    (if (!= (. row kept) (. row held))
      (= made (call wrap site (call Typed (. made operand) (. row held)) (. row kept)))
    )
    (call store-local (. streaming rollback-mark) (. made operand) site)
    (call jump done)
    (call (. ir start-block) done)
  )
  (fn-do _ clear-mark _
    (param site SyntaxId)
    ; Leaves the part being emitted holding no rollback mark.
    (if (!= (. streaming rollback-mark) no-local)
      (call store-local (. streaming rollback-mark) (. (call no-mark site) operand) site)
    )
  )
  (fn-do + enter-marks LocalId
    (param site SyntaxId)
    ; Sets aside the rollback mark a part holds as a part of it begins, which begins with none, as the
    ; reference begins each arm of a choice, an optional's operand, each pass of a repeat, a
    ; lookahead's operand and a local rule run where it is called. None where the pattern holds no
    ; mark.
    (if (== (. streaming rollback-mark) no-local)
      (return no-local)
    )
    (let saved (call (. ir add-local) (. ([] (. ir locals) (. streaming rollback-mark)) layout)))
    (call store-local saved (call load-local (. streaming rollback-mark) site) site)
    (call clear-mark site)
    (return saved)
  )
  (fn-do + pass-marks _
    (param saved LocalId)
    (param site SyntaxId)
    ; Where a part of a part passed, the part holds the rollback mark it held before, where it held
    ; one, and else what the part of it holds.
    (if (== saved no-local)
      (return)
    )
    (let kept (call (. ir reserve-block)))
    (let done (call (. ir reserve-block)))
    (call branch (call holds-mark (call load-local saved site) site) kept done)
    (call (. ir start-block) kept)
    (call store-local (. streaming rollback-mark) (call load-local saved site) site)
    (call jump done)
    (call (. ir start-block) done)
  )
  (fn-do + fail-marks _
    (param saved LocalId)
    (param site SyntaxId)
    ; Where a part of a part failed, the rollback mark that part holds is given back, and the part
    ; holds what it held before.
    (if (== saved no-local)
      (return)
    )
    (call rewind-mark site)
    (call store-local (. streaming rollback-mark) (call load-local saved site) site)
  )
  (fn-do _ next-arm _
    (param saved LocalId)
    (param site SyntaxId)
    ; Where an arm of a choice failed, the rollback mark it holds is given back, and the next begins
    ; with none.
    (if (== saved no-local)
      (return)
    )
    (call rewind-mark site)
    (call clear-mark site)
  )
  (fn-do _ gather-mark _
    (param gathered LocalId)
    (param site SyntaxId)
    ; Where a pass of a repeat passed, the repeat keeps the rollback mark it holds, where it kept none
    ; yet.
    (if (== gathered no-local)
      (return)
    )
    (let taken (call (. ir reserve-block)))
    (let done (call (. ir reserve-block)))
    (call branch (call holds-mark (call load-local gathered site) site) done taken)
    (call (. ir start-block) taken)
    (call store-local gathered (call load-local (. streaming rollback-mark) site) site)
    (call jump done)
    (call (. ir start-block) done)
  )
  (fn-do _ settle-repeat _
    (param saved LocalId)
    (param gathered LocalId)
    (param site SyntaxId)
    ; Where a repeat passed, the part holds the rollback mark it held before it, where it held one,
    ; and else the earliest its passes held.
    (if (== saved no-local)
      (return)
    )
    (call store-local (. streaming rollback-mark) (call load-local gathered site) site)
    (call pass-marks saved site)
  )
  (fn-do _ lend-mark LocalId
    (param callee InstanceId)
    (param site SyntaxId)
    ; Where a rule a pattern calls gives the rollback mark its pattern holds as it passes, a local of
    ; the caller's frame the rule keeps it in, whose address is the next argument. The caller must
    ; hold marks of the same type.
    (if (not (call carries callee))
      (return no-local)
    )
    (let body
      (call (. facts rollback-body-of)
        (block
          (arg callee)
          (arg (call rule-match program (. ([] (. instances rows) callee) module) (. ([] (. instances rows) callee) decl)))
        )
      )
    )
    (if (or (== (. streaming rollback-mark) no-local) (== body (. U32 max)) kept-differs)
      (call refuse .refused-expression site)
      (return no-local)
    )
    (lazy kept-differs
      (block
        (!= (. ([] (. facts rollback-bodies) body) kept) (. ([] (. facts rollback-bodies) (. streaming rollback-row)) kept))
      )
    )
    (let given (call (. ir add-local) (. ([] (. ir locals) (. streaming rollback-mark)) layout) true true))
    (+= pending
      (call make-operand
        (block
          (arg .operand-value)
          (arg (call append .op-local-address site (call Span) given pointer-layout))
        )
      )
    )
    (return given)
  )
  (fn-do + take-mark _
    (param given LocalId)
    (param site SyntaxId)
    ; Where a rule a part called passed, the part holds the rollback mark the rule gave, where it held
    ; none.
    (if (== given no-local)
      (return)
    )
    (let taken (call (. ir reserve-block)))
    (let done (call (. ir reserve-block)))
    (call branch (call holds-mark (call load-local (. streaming rollback-mark) site) site) done taken)
    (call (. ir start-block) taken)
    (call store-local (. streaming rollback-mark) (call load-local given site) site)
    (call jump done)
    (call (. ir start-block) done)
  )
  (fn-do _ hold-text _
    (param capture StreamCapture)
    (param begun Operand)
    (param ending Operand)
    (param site SyntaxId)
    (call store-local (. capture begin) begun site)
    (call store-local (. capture end) ending site)
    (if (!= (. capture present) no-local)
      (call store-local (. capture present) (call integer .machine-u8 1) site)
    )
  )
  (fn-do _ clear-captures _ (?! Refused)
    (param id SyntaxId)
    (param site SyntaxId)
    ; Leaves each optional name a part of a pattern captures holding nothing.
    (match? ([] (. tree nodes) id)
      (case (call .node-stream-capture row)
        (let held (call captured-at (call captured-slot (. row name))))
        (if (and (!= held (. U32 max)) (!= (. ([] stream-captures held) present) no-local))
          (call store-local (. ([] stream-captures held) present) (call integer .machine-u8 0) site)
        )
        (if (and (!= held (. U32 max)) (!= (. ([] stream-captures held) value) no-local) optional-held)
          (let type (. ([] stream-captures held) type))
          (call store-local
            (block
              (arg (. ([] stream-captures held) value))
              (arg (. (call empty-optional type (call layout-of type site)) operand))
              (arg site)
            )
          )
        )
        (lazy optional-held (call (. types is-optional) (. ([] stream-captures held) type)))
        (call clear-captures (. row pattern) site)
      )
      (case (call .node-stream-and row)
        (call clear-captures (. row left) site)
        (call clear-captures (. row right) site)
      )
      (case (call .node-stream-or row)
        (call clear-captures (. row left) site)
        (call clear-captures (. row right) site)
      )
      (case (call .node-stream-unary row)
        (call clear-captures (. row operand) site)
      )
    )
  )
  (fn-do _ stream-optional StreamPart
    (param run StreamRun)
    (param id SyntaxId)
    (param operand SyntaxId)
    (param cursor Operand)
    ; An optional part: its operand where it passes, and else nothing, from the cursor. Where the
    ; operand fails, the names captured in it hold nothing, and the lists names accumulate in it
    ; are cut back. Where the operand gives what a rule
    ; gave, the part gives it as an optional, which holds nothing where the operand failed; so
    ; does one the type pass planned to give the text it matched, made where the operand passes.
    ; The operand begins holding no rollback mark, as `enter-marks` says, and gives back the one
    ; it holds where it fails.
    (let joined (call (. ir reserve-block)))
    (let missed (call (. ir reserve-block)))
    (let mark (. joins length))
    (let marks (call mark-levels operand))
    (let entered (call enter-marks id))
    (let tried (call emit-stream-part run operand cursor missed))
    (let passed (. tried ending))
    (let given (. tried value operand))
    (let given-type (. tried value type))
    (if (and (== given-type no-type) (call gives-value id))
      (let texted (call stream-text run id cursor passed))
      (= given (. texted operand))
      (= given-type (. texted type))
    )
    (let type (if-expr (!= given-type no-type) (call (. facts node-type) (. unit reading) id) no-type))
    (if (and (!= given-type no-type) (or (not (call (. types is-optional) type)) (!= (call (. types optional-inner) type) given-type)))
      (call refuse .refused-expression id)
      (return (call bare-part cursor))
    )
    (let kept no-local)
    (if (!= type no-type)
      (let layout (call layout-of type id))
      (= kept (call (. ir add-local) layout))
      (call store-local kept (. (call wrap id (call Typed given given-type) type) operand) id)
    )
    (call pass-marks entered id)
    (call arrive id passed joined (call make-operand .operand-void 0))
    (call (. ir start-block) missed)
    (call rewind-levels marks id)
    (call fail-marks entered id)
    (call clear-captures operand id)
    (if (!= kept no-local)
      (call store-local kept (. (call empty-optional type (call layout-of type id)) operand) id)
    )
    (call arrive id cursor joined (call make-operand .operand-void 0))
    (let ending (call close-joins joined mark (. run index-layout) (call make-operand .operand-void 0)))
    (if (!= kept no-local)
      (return (call StreamPart ending (call Typed (call load-local kept id) type)))
    )
    (return (call bare-part ending))
  )
  (fn-do + read-capture Typed
    (param id SyntaxId)
    (param held U32)
    (param type TypeId)
    ; What a name a grammar captured holds where an action reads it: the text between the
    ; cursors its part began and ended at, made where it is read, or for an optional name nothing
    ; where its part did not pass; or in a stream that holds no characters, the part of the
    ; buffer between them; or what a rule gave, or the item a test passed, as it was kept; or for
    ; a name captured in repeats, the list the outermost made. Where the type pass narrowed an
    ; optional name kept as a value to what it holds, the read is of that, as a local's is. A name
    ; captured over text that the type pass kept as a span is read as the span between its cursors,
    ; and for an optional name, as such a span where its part passed.
    (let nothing (call make-operand .operand-void 0))
    (let capture ([] stream-captures held))
    (if (and (!= type (. capture type)) (== (. capture type) (. types string-type)) bare-capture)
      (return (call text-span capture id type))
    )
    (lazy bare-capture (and (== (. capture value) no-local) (== (. capture listed) 0) (== (. capture present) no-local)))
    (let spans
      (scope (and flag-only (== (. capture listed) 0) (call (. types is-optional) type) optional-string)
        (lazy flag-only (and (!= type (. capture type)) (!= (. capture present) no-local) (== (. capture value) no-local)))
        (lazy optional-string (== (call (. types optional-inner) (. capture type)) (. types string-type)))
      )
    )
    (if (and (!= type (. capture type)) (not spans))
      (if (or (!= (. capture listed) 0) (== (. capture value) no-local) (!= shared-depth 0) unheld-type)
        (call refuse .refused-expression id)
        (return (call Typed nothing no-type))
      )
      (lazy unheld-type (not (call holds (. capture type) type)))
      (return (call payload id (call Typed (call load-local (. capture value) id) (. capture type))))
    )
    (if (!= (. capture listed) 0)
      (return (call level-list ([] capture-levels (- (+ (. capture levels) (. capture listed)) 1)) id))
    )
    (if (!= (. capture value) no-local)
      (return (call Typed (call load-local (. capture value) id) type))
    )
    (if (and (== (. capture present) no-local) (== (call (. facts plan-of) (. unit reading) (. capture site)) .plan-stream-slice))
      (return
        (call stream-slice
          (block
            (arg (. capture run))
            (arg (. capture site))
            (arg (call load-local (. capture begin) id))
            (arg (call load-local (. capture end) id))
          )
        )
      )
    )
    (if (== (. capture present) no-local)
      (return
        (call stream-text
          (block
            (arg (. capture run))
            (arg (. capture site))
            (arg (call load-local (. capture begin) id))
            (arg (call load-local (. capture end) id))
          )
        )
      )
    )
    (let layout (call layout-of type id))
    (let slot (call join-slot layout))
    (let joined (call (. ir reserve-block)))
    (let holds (call (. ir reserve-block)))
    (let empty (call (. ir reserve-block)))
    (let mark (. joins length))
    (call branch
      (block
        (arg (call compare id .compare-not-equal (call load-local (. capture present) id) (call integer .machine-u8 0)))
        (arg holds)
        (arg empty)
      )
    )
    (call (. ir start-block) holds)
    (let text
      (block
        (case? spans
          (call text-span capture id (call (. types optional-inner) type))
        )
        (default
          (call stream-text
            (block
              (arg (. capture run))
              (arg (. capture site))
              (arg (call load-local (. capture begin) id))
              (arg (call load-local (. capture end) id))
            )
          )
        )
      )
    )
    (call arrive id (. (call wrap id text type) operand) joined slot)
    (call (. ir start-block) empty)
    (call arrive id (. (call empty-optional type layout) operand) joined slot)
    (let result (call close-joins joined mark layout slot))
    (return (call Typed result type))
  )
  (fn-do _ stream-literal Operand
    (param run StreamRun)
    (param id SyntaxId)
    (param text String)
    (param cursor Operand)
    (param failed IRBlockId)
    ; Text a pattern matches item by item, or byte by byte of its UTF-8 where the buffer holds a
    ; String's (`encodes`). Where the input ends first, the pattern read as far as the whole text,
    ; which in UTF-8 lies as many characters past the end as the text has left; where an item
    ; differs, as far as that item; either way the text failed where it began. Where it passes it
    ; read as far as the end of the text.
    (let encoded (call encodes run))
    (let points (. text codepoints))
    (let units
      (scope (if-expr encoded (call (of List U64) (in (as each U64) (call (of Array Byte) text))) point-units)
        (lazy point-units (call (of List U64) (in (as each U64) points)))
      )
    )
    (if (== (. units length) 0)
      (return cursor)
    )
    (let missed (call failure-of run id cursor failed))
    (let end (call stream-advance run id cursor (as (. units length) U64)))
    (let kind (. ([] (. tables layouts rows) (. run item-layout)) kind))
    (let reached Size 0)
    (for (in offset (..< 0 (. units length)))
      (let spot (call stream-advance run id cursor (as offset U64)))
      (let present (call (. ir reserve-block)))
      (let short (call (. ir reserve-block)))
      (call branch-present run id spot present short)
      (call (. ir start-block) short)
      (call record-extent
        (block
          (arg run)
          (arg id)
          (arg (if-expr encoded (call stream-advance run id spot (as (- (. points size) reached) U64)) end))
        )
      )
      (call jump missed)
      (call (. ir start-block) present)
      (let same (call (. ir reserve-block)))
      (let differs (call (. ir reserve-block)))
      (call branch
        (block
          (arg (call compare id .compare-equal (call stream-item run id spot) (call integer kind ([] units offset))))
          (arg same)
          (arg differs)
        )
      )
      (call (. ir start-block) differs)
      (call record-extent run id (call stream-advance run id spot 1))
      (call jump missed)
      (call (. ir start-block) same)
      (if (!= (/and/ ([] units offset) 0xC0) 0x80)
        (+= reached 1)
      )
    )
    (call record-extent run id end)
    (call record-literals run id text cursor)
    (return end)
  )
  (fn-do _ stream-class Operand
    (param run StreamRun)
    (param id SyntaxId)
    (param first U64)
    (param last U64)
    (param any Bool)
    (param cursor Operand)
    (param failed IRBlockId)
    ; One item a pattern matches where it lies in a range, or any item with `any`. The pattern
    ; reads as far as the item, there or not; a `deferred-part` keeps that only where it fails.
    ; Where the buffer is UTF-8, a range of ASCII is tested on the byte at the cursor, and any other
    ; on the character there, decoded; the part passes past the character's bytes.
    (let missed (call failure-of run id cursor failed))
    (let next (call stream-advance run id cursor 1))
    (let defers (== deferred-part (call plan-key (. unit source-module) id)))
    (let lost (if-expr defers (call extent-failure run id next missed) missed))
    (let present (call (. ir reserve-block)))
    (let ended (call (. ir reserve-block)))
    (call branch-present run id cursor present ended)
    (call (. ir start-block) ended)
    (call record-extent run id next)
    (call jump missed)
    (call (. ir start-block) present)
    (if (not defers)
      (call record-extent run id next)
    )
    (if any
      (return (call char-next run id cursor))
    )
    (let wide (and (call encodes run) (>= last 0x80)))
    (let kind (. ([] (. tables layouts rows) (if-expr wide (call read-layout run id) (. run item-layout))) kind))
    (let item (if-expr wide (call char-at run id cursor) (call stream-item run id cursor)))
    (let above (call (. ir reserve-block)))
    (let inside (call (. ir reserve-block)))
    (call branch (call compare id .compare-greater-equal item (call integer kind first)) above lost)
    (call (. ir start-block) above)
    (call branch (call compare id .compare-less-equal item (call integer kind last)) inside lost)
    (call (. ir start-block) inside)
    (return (if-expr wide (call char-next run id cursor) next))
  )
  (fn-do _ extent-failure IRBlockId
    (param run StreamRun)
    (param id SyntaxId)
    (param probe Operand)
    (param missed IRBlockId)
    ; A block that keeps a cursor a part read up to as how far the pattern read, then goes on to
    ; where the part fails. What is emitted next goes on past it.
    (let lost (call (. ir reserve-block)))
    (let onward (call (. ir reserve-block)))
    (call jump onward)
    (call (. ir start-block) lost)
    (call record-extent run id probe)
    (call jump missed)
    (call (. ir start-block) onward)
    (return lost)
  )
  (fn-do _ stream-sequence StreamPart
    (param run StreamRun)
    (param id SyntaxId)
    (param cursor Operand)
    (param failed IRBlockId)
    ; A sequence tried from a cursor, its parts in turn, each from where the one before it ended,
    ; where a sequence in it is one with it. Lookaheads that each test one item, with the part after
    ; them that reads one, are tried as one test, as `stream-fused` says, which defers what it keeps
    ; where it is the whole of a `deferred-part`.
    (let parts (list SyntaxId))
    (call sequence-parts id parts)
    (let whole (== deferred-part (call plan-key (. unit source-module) id)))
    (let at (call bare-part cursor))
    (let position Size 0)
    (while (< position (. parts length))
      (let fused (call fused-length run parts position))
      (if (!= fused 0)
        (= at
          (call stream-fused
            (block
              (arg run)
              (arg parts)
              (arg position)
              (arg fused)
              (arg (. at ending))
              (arg failed)
              (arg (and whole (== fused (. parts length))))
            )
          )
        )
        (+= position fused)
        (else
          (= at (call emit-stream-part run ([] parts position) (. at ending) failed))
          (+= position 1)
        )
      )
    )
    (return at)
  )
  (fn-do _ sequence-parts _
    (param id SyntaxId)
    (param parts (list SyntaxId))
    ; The parts of a sequence in order, where a sequence in it is one with it.
    (match? ([] (. tree nodes) id)
      (case (call .node-stream-and row)
        (call sequence-parts (. row left) parts)
        (call sequence-parts (. row right) parts)
        (return)
      )
    )
    (+= parts id)
  )
  (fn-do _ item-ranges (? (list ItemRange))
    (param id SyntaxId)
    ; The items a part that tests one item passes on: a text of one character, or a range. None
    ; for any other part.
    (match? ([] (. tree nodes) id)
      (case (call .node-stream-string row)
        (let points (. row text codepoints))
        (if (== (. points size) 1)
          (return (call single-range (as ([] points 0) U64) (as ([] points 0) U64)))
        )
      )
      (case (call .node-stream-char-range row)
        (return (call single-range (call (. tree stream-bound) (. row first)) (call (. tree stream-bound) (. row last))))
      )
    )
    (return null)
  )
  (fn-do _ looked-ranges (? (list ItemRange))
    (param id SyntaxId)
    ; The items a lookahead of a part that tests one item looks for, as `item-ranges` gives them.
    ; None for any other part.
    (match? ([] (. tree nodes) id)
      (case (call .node-stream-unary row)
        (if (or (== (. row op) .positive-lookahead-op) (== (. row op) .negative-lookahead-op))
          (return (call item-ranges (. row operand)))
        )
      )
    )
    (return null)
  )
  (fn-do _ fused-length Size
    (param run StreamRun)
    (param parts (list SyntaxId))
    (param start Size)
    ; How many parts of a sequence from `start` `stream-fused` tries as one test: lookaheads of a
    ; part that tests one item, then a part that reads one, `.` or one `item-ranges` gives. None
    ; where the helper observes literal words, or the items are no numbers, or where the buffer
    ; is UTF-8 and a range is one the byte a character starts with does not test (`wide-ranges`).
    (if (or (!= (. streaming observer-row) (. U32 max)) (not (call is-integer (. run item-layout))))
      (return 0)
    )
    (let count Size 0)
    (while (and (< (+ start count) (. parts length)) (!= (call looked-ranges ([] parts (+ start count))) null) (not (call wide-ranges run (!! (call looked-ranges ([] parts (+ start count)))))))
      (+= count 1)
    )
    (if (or (== count 0) (>= (+ start count) (. parts length)))
      (return 0)
    )
    (let last ([] parts (+ start count)))
    (if (and (not (is ([] (. tree nodes) last) .node-stream-any)) unbounded-ranges)
      (return 0)
    )
    (lazy unbounded-ranges (or (== (call item-ranges last) null) (call wide-ranges run (!! (call item-ranges last)))))
    (return (+ count 1))
  )
  (fn-do _ stream-fused StreamPart
    (param run StreamRun)
    (param parts (list SyntaxId))
    (param start Size)
    (param count Size)
    (param cursor Operand)
    (param failed IRBlockId)
    (param defers Bool (= false))
    ; Lookaheads that each test one item and the part after them that reads one, tried from a
    ; cursor as one test of the item there. Each reads as far as the item, there or not, as the
    ; reference's do, and keeps the cursor as one a part failed at where it fails. A negative
    ; lookahead keeps it where it passes too, since its part failed. The test passes where an item
    ; lies at the cursor that each positive lookahead's part passes on, no negative one's does, and
    ; the last part passes on, and gives the item where the last is a `.` the type pass typed as it.
    ; One that `defers`, as a `deferred-part` does, keeps how far it read only where it fails, and
    ; the cursor a negative lookahead's part failed at not where it passes. Where the buffer is
    ; UTF-8 the tests are of the byte a character starts with, the item a `.` gives is the
    ; character, decoded, and the test passes past its bytes.
    (let last ([] parts (- (+ start count) 1)))
    (let next (call stream-advance run last cursor 1))
    (if (not defers)
      (call record-extent run last next)
    )
    (let failure (call failure-of run last cursor failed))
    (let missed (if-expr defers (call extent-failure run last next failure) failure))
    (let present (call (. ir reserve-block)))
    (call branch-present run last cursor present missed)
    (call (. ir start-block) present)
    (let item (call stream-item run last cursor))
    (let negated false)
    (for (in position (..< start (- (+ start count) 1)))
      (let part ([] parts position))
      (match? ([] (. tree nodes) part)
        (case (call .node-stream-unary row)
          (let onward (call (. ir reserve-block)))
          (if (== (. row op) .negative-lookahead-op)
            (= negated true)
            (call branch-ranges run part item (!! (call item-ranges (. row operand))) missed onward)
            (else
              (call branch-ranges run part item (!! (call item-ranges (. row operand))) onward missed)
            )
          )
          (call (. ir start-block) onward)
        )
      )
    )
    (let ranges (call item-ranges last))
    (if ranges
      (let passed (call (. ir reserve-block)))
      (call branch-ranges run last item ranges passed missed)
      (call (. ir start-block) passed)
    )
    (if (and negated (not defers))
      (call record-error run last cursor)
    )
    (if (is ([] (. tree nodes) last) .node-stream-any)
      (let typed (call (. facts node-type) (. unit reading) last))
      (if (!= typed no-type)
        (let item-at (call char-at run last cursor))
        (return (call StreamPart (call char-next run last cursor) (call Typed item-at typed)))
      )
      (return (call bare-part (call char-next run last cursor)))
    )
    (return (call bare-part next))
  )
  (fn-do _ stream-dynamic-text Operand
    (param run StreamRun)
    (param id SyntaxId)
    (param value SyntaxId)
    (param cursor Operand)
    (param failed IRBlockId)
    ; Text a pattern matches item by item that a value gives as the pattern runs. Its length is
    ; read, checked, by the call the type pass recorded at the part for it, and where the input
    ; ends first the pattern read as far as the whole text. Its characters are then read in turn by
    ; its step, from where the last ended, and compared with the items from the cursor: where
    ; one differs the pattern read as far as that item. Either way the text failed where it began.
    ; Where it passes it read as far as the end of the text. Where the buffer is UTF-8 the text is
    ; matched by its bytes, as `stream-dynamic-bytes` says.
    (if (call encodes run)
      (return (call stream-dynamic-bytes run id value cursor failed))
    )
    (let nothing (call make-operand .operand-void 0))
    (let measures (call (. facts call-in-role) (. unit reading) id .role-length))
    (let reads (call (. facts call-in-role) (. unit reading) id .role-step))
    (if (== reads no-fact)
      (call refuse .refused-expression id)
      (return cursor)
    )
    (let missed (call failure-of run id cursor failed))
    (let text (call emit-expression value))
    (if (!= (. text type) (. types string-type))
      (call refuse .refused-type id)
      (return cursor)
    )
    (let size-layout (call layout-of (. types size-type) id))
    (let measured (call call-protocol id measures (. text operand) (. types string-type) nothing))
    (let count (call num-cast id (. measured operand) size-layout (. run index-layout)))
    (let end (call arithmetic id .arithmetic-add cursor count (. run index-layout)))
    (let compare-block (call (. ir reserve-block)))
    (let short (call (. ir reserve-block)))
    (if (== (. run kept-length) no-local)
      (call branch (call compare id .compare-less-equal end (. run length)) compare-block short)
      (else
        (call jump compare-block)
      )
    )
    (call (. ir start-block) short)
    (call record-extent run id end)
    (call jump missed)
    (call (. ir start-block) compare-block)
    (let offset (call (. ir add-local) (. run index-layout)))
    (call store-local offset (call integer (. ([] (. tables layouts rows) (. run index-layout)) kind) 0) id)
    (let byte (call (. ir add-local) size-layout))
    (call store-local byte (call integer (. ([] (. tables layouts rows) size-layout) kind) 0) id)
    (let test (call (. ir reserve-block)))
    (let read (call (. ir reserve-block)))
    (let matched (call (. ir reserve-block)))
    (let mismatch (call (. ir reserve-block)))
    (let next (call (. ir reserve-block)))
    (call jump test)
    (call (. ir start-block) test)
    (call branch (call compare id .compare-less (call load-local offset id) count) read matched)
    (call (. ir start-block) read)
    (let decoded
      (call call-protocol
        (block
          (arg id)
          (arg reads)
          (arg (. text operand))
          (arg (. types string-type))
          (arg (call load-local byte id))
          (arg (. types size-type))
        )
      )
    )
    (let decoded-type (. decoded type))
    (let decoded-layout (call layout-of decoded-type id))
    (let onward (call part (. decoded operand) decoded-layout 0 id))
    (let held (call part (. decoded operand) decoded-layout 1 id))
    (if (not (call (. types is-optional) (. held type)))
      (call refuse .refused-type id)
      (return cursor)
    )
    (let expected (call payload id held))
    (let spot (call arithmetic id .arithmetic-add cursor (call load-local offset id) (. run index-layout)))
    (if (!= (. run kept-length) no-local)
      (let lies (call (. ir reserve-block)))
      (call branch-present run id spot lies short)
      (call (. ir start-block) lies)
    )
    (let item (call stream-item run id spot))
    (if (!= (call layout-of (. expected type) id) (. run item-layout))
      (call refuse .refused-type id)
      (return cursor)
    )
    (call branch (call compare id .compare-equal item (. expected operand)) next mismatch)
    (call (. ir start-block) next)
    (call store-local offset (call stream-advance run id (call load-local offset id) 1) id)
    (call store-local byte (. onward operand) id)
    (call jump test)
    (call (. ir start-block) mismatch)
    (let reached (call arithmetic id .arithmetic-add cursor (call load-local offset id) (. run index-layout)))
    (call record-extent run id (call stream-advance run id reached 1))
    (call jump missed)
    (call (. ir start-block) matched)
    (call record-extent run id end)
    (return end)
  )
  (fn-do _ stream-dynamic-bytes Operand
    (param run StreamRun)
    (param id SyntaxId)
    (param value SyntaxId)
    (param cursor Operand)
    (param failed IRBlockId)
    ; Text a value gives as the pattern runs, matched byte by byte of its UTF-8 where the buffer
    ; holds a String's: it is read checked by the call the type pass recorded at the part for its
    ; length, and its count of bytes by its size. Where the input ends first, the pattern read as far as
    ; the whole text; where a byte differs, as far as that byte. Either way the text failed where
    ; it began. Where it passes it read as far as the end of the text.
    (let nothing (call make-operand .operand-void 0))
    (let checks (call (. facts call-in-role) (. unit reading) id .role-length))
    (let measures (call (. facts call-in-role) (. unit reading) id .role-size))
    (if (== measures no-fact)
      (call refuse .refused-expression id)
      (return cursor)
    )
    (let missed (call failure-of run id cursor failed))
    (let text (call emit-expression value))
    (if (!= (. text type) (. types string-type))
      (call refuse .refused-type id)
      (return cursor)
    )
    (let text-layout (call layout-of (. types string-type) id))
    (call call-protocol id checks (. text operand) (. types string-type) nothing)
    (let measured (call call-protocol id measures (. text operand) (. types string-type) nothing))
    (let measured-layout (call layout-of (. measured type) id))
    (if (not (call is-integer measured-layout))
      (call refuse .refused-type id)
      (return cursor)
    )
    (let kind (. ([] (. tables layouts rows) (. run index-layout)) kind))
    (let count (call num-cast id (. measured operand) measured-layout (. run index-layout)))
    (let end (call arithmetic id .arithmetic-add cursor count (. run index-layout)))
    (let compare-block (call (. ir reserve-block)))
    (let short (call (. ir reserve-block)))
    (if (== (. run kept-length) no-local)
      (call branch (call compare id .compare-less-equal end (. run length)) compare-block short)
      (else
        (call jump compare-block)
      )
    )
    (call (. ir start-block) short)
    (call record-extent run id end)
    (call jump missed)
    (call (. ir start-block) compare-block)
    (let bytes (call num-cast id (. text operand) text-layout pointer-layout))
    (let offset (call (. ir add-local) (. run index-layout)))
    (call store-local offset (call integer kind 0) id)
    (let test (call (. ir reserve-block)))
    (let read (call (. ir reserve-block)))
    (let matched (call (. ir reserve-block)))
    (let mismatch (call (. ir reserve-block)))
    (let next (call (. ir reserve-block)))
    (call jump test)
    (call (. ir start-block) test)
    (call branch (call compare id .compare-less (call load-local offset id) count) read matched)
    (call (. ir start-block) read)
    (let spot (call arithmetic id .arithmetic-add cursor (call load-local offset id) (. run index-layout)))
    (if (!= (. run kept-length) no-local)
      (let lies (call (. ir reserve-block)))
      (call branch-present run id spot lies short)
      (call (. ir start-block) lies)
    )
    (let expected
      (call load
        (block
          (arg (call moved-bytes id bytes (call num-cast id (call load-local offset id) (. run index-layout) u64-layout)))
          (arg 0)
          (arg (. run item-layout))
          (arg id)
        )
      )
    )
    (call branch (call compare id .compare-equal (call stream-item run id spot) expected) next mismatch)
    (call (. ir start-block) next)
    (call store-local offset (call stream-advance run id (call load-local offset id) 1) id)
    (call jump test)
    (call (. ir start-block) mismatch)
    (call record-extent
      (block
        (arg run)
        (arg id)
        (arg
          (call stream-advance
            (block
              (arg run)
              (arg id)
              (arg (call arithmetic id .arithmetic-add cursor (call load-local offset id) (. run index-layout)))
              (arg 1)
            )
          )
        )
      )
    )
    (call jump missed)
    (call (. ir start-block) matched)
    (call record-extent run id end)
    (return end)
  )
  (fn-do _ stream-dynamic-item StreamPart
    (param run StreamRun)
    (param id SyntaxId)
    (param value SyntaxId)
    (param cursor Operand)
    (param failed IRBlockId)
    ; One item a pattern compares with a value of a type like the items' that it evaluates as it
    ; runs, first, as the reference does: the part gives the value where they are equal, and reads
    ; as far as the item, there or not. Where the buffer is UTF-8 the item is the character there,
    ; decoded, and the part passes past its bytes.
    (let missed (call failure-of run id cursor failed))
    (let expected (call emit-expression value))
    (let type (. expected type))
    (if (or (!= type (call (. facts node-type) (. unit reading) id)) (!= (call layout-of type id) (call read-layout run id)))
      (call refuse .refused-type id)
      (return (call bare-part cursor))
    )
    (let next (call stream-advance run id cursor 1))
    (let present (call (. ir reserve-block)))
    (let ended (call (. ir reserve-block)))
    (call branch-present run id cursor present ended)
    (call (. ir start-block) ended)
    (call record-extent run id next)
    (call jump missed)
    (call (. ir start-block) present)
    (let item (call char-at run id cursor))
    (call record-extent run id next)
    (let passed (call (. ir reserve-block)))
    (call branch (call compare id .compare-equal item (. expected operand)) passed missed)
    (call (. ir start-block) passed)
    (return (call StreamPart (call char-next run id cursor) (call Typed (. expected operand) type)))
  )
  (fn-do _ stream-case-item StreamPart
    (param run StreamRun)
    (param id SyntaxId)
    (param cursor Operand)
    (param failed IRBlockId)
    ; One item of a union a pattern tests for a case named by its symbol, by the number the type
    ; pass recorded: where the item holds the case, the part gives what the case holds, or the item
    ; where the type pass typed the part as the items. It reads as far as the item, there or not.
    (let type (call (. facts node-type) (. unit reading) id))
    (let index (call (. facts case-of) (. unit reading) id))
    (let layout (call read-layout run id))
    (if (or (== index (. U32 max)) (call encodes run) (not (call (. tables layouts is-union) layout)))
      (call refuse .refused-type id)
      (return (call bare-part cursor))
    )
    (if (>= index (. ([] (. tables layouts rows) layout) cases count))
      (call refuse .refused-type id)
      (return (call bare-part cursor))
    )
    (let field (call (. tables layouts case-field) layout index))
    (let whole (== type (call class-arg types (. run buffer-type) 0)))
    (if (and (not whole) (!= (. field type) type))
      (call refuse .refused-type id)
      (return (call bare-part cursor))
    )
    (let missed (call failure-of run id cursor failed))
    (let next (call stream-advance run id cursor 1))
    (let present (call (. ir reserve-block)))
    (let ended (call (. ir reserve-block)))
    (call branch-present run id cursor present ended)
    (call (. ir start-block) ended)
    (call record-extent run id next)
    (call jump missed)
    (call (. ir start-block) present)
    (let item (call char-at run id cursor))
    (call record-extent run id next)
    (let passed (call (. ir reserve-block)))
    (call branch (call case-test id item index) passed missed)
    (call (. ir start-block) passed)
    (let given (if-expr whole item (call take item field id)))
    (return (call StreamPart (call char-next run id cursor) (call Typed given type)))
  )
  (fn-do _ stream-type-part StreamPart
    (param run StreamRun)
    (param id SyntaxId)
    (param written SyntaxId)
    (param cursor Operand)
    (param failed IRBlockId)
    ; A type named as a part of a pattern: a call of the rule the type pass recorded at it, which is
    ; the type's constructor that takes the stream or the rule that reads a number of the type, or
    ; of a function that reads the number and is no rule, as `boundary-call` says; or else a test
    ; of one item for the type, which gives the item: an item of a class the type derives from, or
    ; of a union that has the type as a case, is read as the items are, tested as the type named as
    ; a pattern tests a value, and given as the type. An item that is
    ; a number of another type is never of it, and fails once it is there. Before the test the
    ; stream is told the pattern stands at the item, as the reference tells it before it looks for
    ; such a function. The test reads as far as the item, there or not. Where the buffer is UTF-8
    ; the item is the character there, decoded, and the test passes past its bytes.
    (let type (call (. facts node-type) (. unit reading) id))
    (if (or (== type no-type) (== type invalid-type))
      (call refuse .refused-type id)
      (return (call bare-part cursor))
    )
    (let commit (call (. facts call-in-role) (. unit reading) id .role-commit))
    (if (!= (call (. facts answer-call) (. unit reading) id .role-answer) no-fact)
      (if (!= commit no-fact)
        (return (call boundary-call run id type cursor failed))
      )
      (return (call rule-call run id type cursor failed))
    )
    (let item-type (if-expr (call encodes run) (call (. types type-row) .char) (call class-arg types (. run buffer-type) 0)))
    (let never (and (!= item-type type) (call intrinsic-is-numeric (call (. types intrinsic-of) item-type))))
    (if (or (== commit no-fact) calls-next (and (not never) (!= (call layout-of item-type id) (call read-layout run id))))
      (call refuse .refused-type id)
      (return (call bare-part cursor))
    )
    (lazy calls-next (not (call holds-only id (list commit))))
    (call call-protocol
      (block
        (arg id)
        (arg commit)
        (arg (. run stream))
        (arg (. run stream-type))
        (arg cursor)
        (arg (. types index-type))
        (arg true)
        (arg cursor)
        (arg (. types index-type))
      )
    )
    (let missed (call failure-of run id cursor failed))
    (let next (call stream-advance run id cursor 1))
    (let present (call (. ir reserve-block)))
    (let ended (call (. ir reserve-block)))
    (call branch-present run id cursor present ended)
    (call (. ir start-block) ended)
    (call record-extent run id next)
    (call jump missed)
    (call (. ir start-block) present)
    (if never
      (call record-extent run id next)
      (call jump missed)
      (call (. ir start-block) (call (. ir reserve-block)))
      (let layout (call layout-of type id))
      (let held (call (. ir add-local) layout))
      (call clear-local held layout id)
      (return (call StreamPart next (call Typed (call load-local held id) type)))
    )
    (let item (call char-at run id cursor))
    (call record-extent run id next)
    (if (!= item-type type)
      (let typeed (call match-type written (call Typed item item-type) missed))
      (= item (. typeed operand))
      (if (!= (. typeed type) type)
        (call refuse .refused-type id)
        (return (call bare-part cursor))
      )
    )
    (return (call StreamPart (call char-next run id cursor) (call Typed item type)))
  )
  (fn-do _ stream-predicate StreamPart
    (param run StreamRun)
    (param id SyntaxId)
    (param predicate SyntaxId)
    (param cursor Operand)
    (param failed IRBlockId)
    ; One item a pattern tests, which gives the item where the test passes: the test's expression
    ; sees the item as `it`, and is tested as a condition. The pattern reads as far as the item,
    ; there or not. Where the buffer is UTF-8 the item is the character there, decoded, and the
    ; test passes past its bytes.
    (let missed (call failure-of run id cursor failed))
    (let next (call stream-advance run id cursor 1))
    (let present (call (. ir reserve-block)))
    (let ended (call (. ir reserve-block)))
    (call branch-present run id cursor present ended)
    (call (. ir start-block) ended)
    (call record-extent run id next)
    (call jump missed)
    (call (. ir start-block) present)
    (let item (call char-at run id cursor))
    (call record-extent run id next)
    (let type (call (. facts node-type) (. unit reading) id))
    (if (or (== type no-type) (!= (call layout-of type id) (call read-layout run id)))
      (call refuse .refused-type id)
      (return (call bare-part cursor))
    )
    (let named (. bound length))
    (let slot (call arm-slot-of id .slot-it))
    (if (!= slot no-slot)
      (+= bound (call BoundValue slot type item))
    )
    (let tested (call emit-expression predicate))
    (let holds (. (call test predicate tested) operand))
    (call drop-bound named)
    (let passed (call (. ir reserve-block)))
    (call branch holds passed missed)
    (call (. ir start-block) passed)
    (return (call StreamPart (call char-next run id cursor) (call Typed item type)))
  )
  (fn-do _ stream-choice StreamPart
    (param run StreamRun)
    (param id SyntaxId)
    (param cursor Operand)
    (param failed IRBlockId)
    ; Alternatives tried from a cursor as the reference tries them: the first that passes is
    ; kept, and where all fail the choice does. A choice gives no value, but one the type pass
    ; planned to give what its alternatives give, which gives what the one that passed gave.
    (let nothing (call make-operand .operand-void 0))
    (let arms (list SyntaxId))
    (call choice-arms tree id arms)
    (let type (if-expr (call gives-value id) (call (. facts node-type) (. unit reading) id) no-type))
    (if (== type invalid-type)
      (call refuse .refused-expression id)
      (return (call bare-part cursor))
    )
    (let kept (if-expr (!= type no-type) (call (. ir add-local) (call layout-of type id)) no-local))
    (let joined (call (. ir reserve-block)))
    (let mark (. joins length))
    (call try-alternatives
      (block
        (arg run)
        (arg id)
        (arg arms)
        (arg cursor)
        (arg failed)
        (arg (call ArmWay id type false kept joined nothing true false))
      )
    )
    (let ending (call close-joins joined mark (. run index-layout) nothing))
    (if (!= kept no-local)
      (return (call StreamPart ending (call Typed (call load-local kept id) type)))
    )
    (return (call bare-part ending))
  )
  (fn-do _ try-alternatives Bool
    (param run StreamRun)
    (param id SyntaxId)
    (param arms (list SyntaxId))
    (param cursor Operand)
    (param failed IRBlockId)
    (param way ArmWay)
    ; The alternatives of a choice, tried from a cursor as the reference tries them. Alternatives
    ; that are each one item it tests as one, each in turn. Otherwise, where every one must read
    ; an item and it knows which each may start with, it sorts them into groups by those items
    ; and, where there is more than one, tries only the group the item at the cursor starts;
    ; where no group does, or no item lies there, the choice fails. Else each is tried in turn,
    ; but one that must read an item and starts with items it knows is skipped where none of those
    ; lies at the cursor. Whether any reaches the join. The lists names accumulate in the
    ; alternatives are cut back before each alternative tried after the first, and where all fail.
    ; Each alternative begins holding no rollback mark, and gives back the one it holds where it
    ; fails; the choice holds the one it held before where it held one, and else the one the
    ; alternative that passed holds.
    (let marks (call mark-levels id))
    (let entered (call enter-marks id))
    (let lost (if-expr (== entered no-local) failed (call (. ir reserve-block))))
    (let arrives false)
    (if (call is-scanned tree id)
      (let own-streaming streaming)
      (= streaming (= (. streaming classing) true))
      (= arrives (call try-guarded run id arms (. U32 max) cursor lost way marks entered))
      (= streaming own-streaming)
      (else
        (let start (call plan-start id))
        (if (== start (. U32 max))
          (call refuse .refused-expression id)
          (return false)
        )
        (let groups (call dispatch-groups start (as (. arms length) U32)))
        (if (> (. groups length) 1)
          (= arrives (call try-dispatched run id arms start groups cursor lost way marks entered))
          (else
            (= arrives (call try-guarded run id arms start cursor lost way marks entered))
          )
        )
      )
    )
    (if (!= entered no-local)
      (call (. ir start-block) lost)
      (call store-local (. streaming rollback-mark) (call load-local entered id) id)
      (call jump failed)
    )
    (return arrives)
  )
  (fn-do _ try-alternative Bool
    (param run StreamRun)
    (param way ArmWay)
    (param arm SyntaxId)
    (param cursor Operand)
    (param failed IRBlockId)
    (param entered LocalId)
    ; One alternative of a choice, tried from a cursor, which goes on to `failed` where it fails.
    ; Where it passes, the choice holds the rollback mark it held before the alternative where it
    ; held one, and where the choice gives a value the alternative leaves its own. Whether it
    ; reaches the join.
    (if (not (. way parts))
      (return
        (call emit-stream-arm
          (block
            (arg run)
            (arg arm)
            (arg (. way result))
            (arg cursor)
            (arg (. way whole))
            (arg (. way end))
            (arg (. way joined))
            (arg (. way slot))
            (arg failed)
            (arg entered)
            (arg (. way unread))
          )
        )
      )
    )
    (let passed (call emit-stream-part run arm cursor failed))
    (if (!= (. way end) no-local)
      (if (!= (. passed value type) (. way result))
        (call refuse .refused-expression arm)
        (return false)
      )
      (call store-local (. way end) (. passed value operand) arm)
    )
    (call pass-marks entered arm)
    (call arrive (. way site) (. passed ending) (. way joined) (call make-operand .operand-void 0))
    (return true)
  )
  (fn-do _ try-guarded Bool
    (param run StreamRun)
    (param id SyntaxId)
    (param arms (list SyntaxId))
    (param start U32)
    (param cursor Operand)
    (param failed IRBlockId)
    (param way ArmWay)
    (param marks (list LevelMark))
    (param entered LocalId)
    ; Alternatives tried in turn from a cursor, those the reference guards skipped where no item
    ; lies at the cursor or the one there is not one they may start with. What the alternatives
    ; may start with is kept from `start`, or not at all with `U32.max`. Whether any reaches the
    ; join.
    (let guarded false)
    (if (!= start (. U32 max))
      (for (in position (..< 0 (. arms length)))
        (= guarded (or guarded (call guards ([] plan-firsts (+ start (as position U32))))))
      )
    )
    (let present (call make-operand .operand-void 0))
    (if (and guarded (== (. run kept-length) no-local))
      (= present (call compare id .compare-less cursor (. run length)))
    )
    (let arrives false)
    (for (in position (..< 0 (. arms length)))
      (let last (== (+ position 1) (. arms length)))
      (let next (if-expr (and last (== (. marks length) 0) (== entered no-local)) failed (call (. ir reserve-block))))
      (if (and guarded (call guards ([] plan-firsts (+ start (as position U32)))))
        (let looked (call (. ir reserve-block)))
        (let skipped (call (. ir reserve-block)))
        (let tried (call (. ir reserve-block)))
        (if (== (. run kept-length) no-local)
          (call branch present looked skipped)
          (else
            (call branch-present run id cursor looked skipped)
          )
        )
        (call (. ir start-block) looked)
        (let ranges (. ([] plan-firsts (+ start (as position U32))) ranges))
        (let decodes (call wide-ranges run ranges))
        (call branch-ranges run id (call item-at run id cursor decodes) ranges tried skipped decodes)
        (call (. ir start-block) skipped)
        (call skip-extent run id start (as position U32) (+ (as position U32) 1) cursor)
        (call jump next)
        (call (. ir start-block) tried)
      )
      (= arrives (or (call try-alternative run way ([] arms position) cursor next entered) arrives))
      (if (or (not last) (!= (. marks length) 0) (!= entered no-local))
        (call (. ir start-block) next)
        (call rewind-levels marks id)
        (call next-arm entered id)
      )
      (if (and last (or (!= (. marks length) 0) (!= entered no-local)))
        (call jump failed)
      )
    )
    (return arrives)
  )
  (fn-do _ try-dispatched Bool
    (param run StreamRun)
    (param id SyntaxId)
    (param arms (list SyntaxId))
    (param start U32)
    (param groups (list ArmGroup))
    (param cursor Operand)
    (param failed IRBlockId)
    (param way ArmWay)
    (param marks (list LevelMark))
    (param entered LocalId)
    ; Alternatives sorted into groups by the items they may start with, of which only the group
    ; the item at the cursor starts is tried, its alternatives in turn: those before each one tried
    ; and after the last count as skipped. Where no group is started, or no item lies at the
    ; cursor, all count as skipped and the choice fails. Whether any reaches the join. Where the
    ; buffer is UTF-8, the item is the byte a character starts with, or the character, decoded,
    ; where a group's ranges need it (`wide-ranges`).
    (let count (as (. arms length) U32))
    (let present (call (. ir reserve-block)))
    (let ended (call (. ir reserve-block)))
    (call branch-present run id cursor present ended)
    (call (. ir start-block) ended)
    (call skip-extent run id start 0 count cursor)
    (call jump failed)
    (call (. ir start-block) present)
    (let decodes false)
    (for (in group groups)
      (= decodes (or decodes (call wide-ranges run (. group ranges))))
    )
    (let item (call item-at run id cursor decodes))
    (let arrives false)
    (for (in group groups)
      (let chosen (call (. ir reserve-block)))
      (let other (call (. ir reserve-block)))
      (call branch-ranges run id item (. group ranges) chosen other decodes)
      (call (. ir start-block) chosen)
      (let unskipped U32)
      (for (in index (. group arms))
        (call skip-extent run id start unskipped index cursor)
        (let next (call (. ir reserve-block)))
        (= arrives (or (call try-alternative run way ([] arms index) cursor next entered) arrives))
        (call (. ir start-block) next)
        (call rewind-levels marks id)
        (call next-arm entered id)
        (= unskipped (+ index 1))
      )
      (call skip-extent run id start unskipped count cursor)
      (call jump failed)
      (call (. ir start-block) other)
    )
    (call skip-extent run id start 0 count cursor)
    (call jump failed)
    (return arrives)
  )
  (fn-do _ item-at Operand
    (param run StreamRun)
    (param id SyntaxId)
    (param cursor Operand)
    (param decodes Bool (= false))
    ; The item at a cursor the pattern knows is inside the input, to test against ranges; nothing
    ; for items that are no numbers, which are not read. Where the buffer is UTF-8 it is the byte
    ; the character there starts with, or where it `decodes`, the character, decoded.
    (if (not (call is-integer (. run item-layout)))
      (return (call make-operand .operand-void 0))
    )
    (return (if-expr decodes (call char-at run id cursor) (call stream-item run id cursor)))
  )
  (fn-do _ branch-ranges _
    (param run StreamRun)
    (param id SyntaxId)
    (param item Operand)
    (param ranges (list ItemRange))
    (param inside IRBlockId)
    (param outside IRBlockId)
    (param decodes Bool (= false))
    ; Goes on to `inside` where an item lies in one of some ranges, tested in turn, and else to
    ; `outside`. An item that is no number lies in a range only where the range holds every item,
    ; as the reference tests it; any other range has no shape for it. Where the buffer is UTF-8 and
    ; the item is the byte a character starts with, not the character it `decodes`, a range that
    ; holds every character past ASCII holds every such byte past it.
    (if (not (call is-integer (. run item-layout)))
      (if (and (== (. ranges length) 1) (== (. ([] ranges 0) first) 0) (== (. ([] ranges 0) last) any-item))
        (call jump inside)
        (return)
      )
      (call refuse .refused-type id)
      (return)
    )
    (if (== (. ranges length) 0)
      (call jump outside)
      (return)
    )
    (let kind (. ([] (. tables layouts rows) (if-expr decodes (call read-layout run id) (. run item-layout))) kind))
    (let bytes (and (call encodes run) (not decodes)))
    (for (in position (..< 0 (. ranges length)))
      (let range ([] ranges position))
      (let upper (if-expr (and bytes (>= (. range last) 0x80)) (as 0xFF U64) (. range last)))
      (let last (== (+ position 1) (. ranges length)))
      (let next (if-expr last outside (call (. ir reserve-block))))
      (if (== (. range first) upper)
        (call branch (call compare id .compare-equal item (call integer kind (. range first))) inside next)
        (else
          (let above (call (. ir reserve-block)))
          (call branch (call compare id .compare-greater-equal item (call integer kind (. range first))) above next)
          (call (. ir start-block) above)
          (call branch (call compare id .compare-less-equal item (call integer kind upper)) inside next)
        )
      )
      (if (not last)
        (call (. ir start-block) next)
      )
    )
  )
  (fn-do _ skip-extent _
    (param run StreamRun)
    (param id SyntaxId)
    (param start U32)
    (param from U32)
    (param to U32)
    (param cursor Operand)
    ; Counts the alternatives of a choice from `from` up to `to` as skipped, as the reference
    ; does: as read from the cursor at least one item on, and as far as the farthest of them
    ; probes where that lies inside the input, or else to its end. Where the buffer is UTF-8 the
    ; probe counts characters, as `advance-chars` reads them.
    (if (>= from to)
      (return)
    )
    (let probe U64 1)
    (for (in position (..< from to))
      (let own (. ([] plan-firsts (+ start position)) probe))
      (if (and (!= own no-probe) (> own probe))
        (= probe own)
      )
    )
    (call record-extent run id (call stream-advance run id cursor 1))
    (if (== probe 1)
      (return)
    )
    (if (call encodes run)
      (call record-extent run id (call advance-chars run id cursor probe))
      (return)
    )
    (let end (call stream-advance run id cursor probe))
    (let short (call (. ir reserve-block)))
    (let beyond (call (. ir reserve-block)))
    (let done (call (. ir reserve-block)))
    (let length (call run-length run id))
    (call branch (call compare id .compare-less-equal end length) short beyond)
    (call (. ir start-block) short)
    (call record-extent run id end)
    (call jump done)
    (call (. ir start-block) beyond)
    (call record-extent run id length)
    (call jump done)
    (call (. ir start-block) done)
  )
  (fn-do _ dispatch-groups (list ArmGroup)
    (param start U32)
    (param count U32)
    ; The groups the reference sorts the alternatives of a choice into by the items they may start
    ; with, where every one must read an item and it knows which: two that may start with the same
    ; item share a group, and the groups are in the order of their first alternatives. None where
    ; it sorts them into fewer than two.
    (let groups (list ArmGroup))
    (for (in position (..< 0 count))
      (let first ([] plan-firsts (+ start position)))
      (if (or (not (. first known)) (. first nullable))
        (return groups)
      )
    )
    (let parents (list U32))
    (for (in position (..< 0 count))
      (+= parents position)
    )
    (for (in left (..< 0 count))
      (for (in right (..< (+ left 1) count))
        (if (call ranges-meet (. ([] plan-firsts (+ start left)) ranges) (. ([] plan-firsts (+ start right)) ranges))
          (let root (call group-root parents left))
          (let other (call group-root parents right))
          (if (!= root other)
            (= ([] parents other) root)
          )
        )
      )
    )
    (let placed (list U32))
    (for (in position (..< 0 count))
      (+= placed (. U32 max))
    )
    (for (in position (..< 0 count))
      (let root (call group-root parents position))
      (if (== ([] placed root) (. U32 max))
        (= ([] placed root) (as (. groups length) U32))
        (let members (list U32))
        (let none (list ItemRange))
        (+= groups (call ArmGroup members none))
      )
      (let place ([] placed root))
      (let members (. ([] groups place) arms))
      (+= members position)
      (= ([] groups place)
        (call ArmGroup
          (block
            (arg members)
            (arg (call merged-ranges (. ([] groups place) ranges) (. ([] plan-firsts (+ start position)) ranges)))
          )
        )
      )
    )
    (if (< (. groups length) 2)
      (let none (list ArmGroup))
      (return none)
    )
    (return groups)
  )
  (fn-do + plan-choices _
    (param root SyntaxId)
    ; Judges, as the reference does before it emits a pattern, which items each part of the
    ; pattern rooted at `root` may start with, and keeps for each choice of the pattern what each
    ; of its alternatives may start with.
    (call (. firsts plan-choices) (. unit source-module) (. unit reading) root)
  )
  (fn-expr _ plan-start U32
    (param id SyntaxId)
    ; Where what the alternatives of a choice may start with is kept, or `U32.max` where it is not.
    (call (. firsts plan-start) (. unit source-module) id)
  )

  (fn-do _ stream-repeat StreamPart
    (param run StreamRun)
    (param id SyntaxId)
    (param operand SyntaxId)
    (param least U64)
    (param most U64)
    (param cursor Operand)
    (param failed IRBlockId)
    (param scans Bool)
    (param least-at SyntaxId (= 0))
    (param most-at SyntaxId (= 0))
    ; A part taken as often as it passes from a cursor, at most `most` times, which has no bound
    ; at `U64.max`. Unbounded, it stops where the part passed without moving on, which one that
    ; `advances` never does: it stops only where a try of it fails, which reads farther and fails
    ; farther than any try before it, so that the part is its `deferred-part`. It passes where
    ; it took the part at least `least` times, with the cursor where the last one ended. A bound
    ; computed as the match runs is read as a Size: `most-at` before the part is first taken,
    ; and `least-at` after it is taken for the last time, as the reference reads them. Each name
    ; the part captures has a list, empty as the repeat starts, which each pass that passes adds
    ; what it captured to. A repeat the type pass planned to give the values of its part keeps
    ; them in a list the same way, which it gives where it passes. One the reference `scans` tests
    ; each item, and keeps no cursor its part failed at. The lists names accumulate in the part
    ; are cut back where a pass fails to what they held as it began, and where the repeat fails
    ; to what they held as it began. Each pass begins holding no rollback mark, and gives back the
    ; one it holds where it fails; the repeat keeps the earliest its passes that passed held, which
    ; it gives back where it fails, and holds where it passes where it held none before.
    (let entered (call mark-levels operand))
    (let saved (call enter-marks id))
    (let gathered no-local)
    (if (!= saved no-local)
      (= gathered (call (. ir add-local) (. ([] (. ir locals) (. streaming rollback-mark)) layout)))
      (call store-local gathered (. (call no-mark id) operand) id)
    )
    (let spot (call (. ir add-local) (. run index-layout)))
    (let counts (or (!= most (. U64 max)) (!= most-at 0) (!= least 0) (!= least-at 0)))
    (let taken (if-expr counts (call (. ir add-local) u64-layout) no-local))
    (call store-local spot cursor id)
    (if counts
      (call store-local taken (call integer .machine-u64 0) id)
    )
    (let values (call value-level id))
    (if values
      (call start-level values id)
    )
    (let listing (list U32))
    (let depths (list U32))
    (call repeat-levels operand 1 listing depths)
    (for (in position listing)
      (call start-level ([] capture-levels position) id)
    )
    (let limit no-local)
    (if (!= most-at 0)
      (let most-value (call count-of most-at))
      (= limit (call (. ir add-local) u64-layout))
      (call store-local limit (. most-value operand) id)
    )
    (let test (call (. ir reserve-block)))
    (let body (call (. ir reserve-block)))
    (let done (call (. ir reserve-block)))
    (call jump test)
    (call (. ir start-block) test)
    (if (!= limit no-local)
      (call branch (call compare id .compare-less (call load-local taken id) (call load-local limit id)) body done)
      (else-if (== most (. U64 max))
        (call jump body)
      )
      (else
        (call branch
          (block
            (arg (call compare id .compare-less (call load-local taken id) (call integer .machine-u64 most)))
            (arg body)
            (arg done)
          )
        )
      )
    )
    (call (. ir start-block) body)
    (call clear-mark id)
    (let begun (call load-local spot id))
    (let passing (call mark-levels operand))
    (let missed (if-expr (and (== (. passing length) 0) (== saved no-local)) done (call (. ir reserve-block))))
    (let onward (and (== most (. U64 max)) (== most-at 0) (call advances operand)))
    (= scanning scans)
    (= deferred-part (if-expr onward (call plan-key (. unit source-module) (call lowered-part operand)) (. U64 max)))
    (let took (call emit-stream-part run operand begun missed))
    (let next (. took ending))
    (= deferred-part (. U64 max))
    (= scanning false)
    (call gather-mark gathered id)
    (if values
      (if (== (. took value type) no-type)
        (call refuse .refused-expression id)
        (return (call bare-part cursor))
      )
      (call append-level values (. took value) id)
    )
    (for (in index (..< 0 (. listing length)))
      (let position ([] listing index))
      (let capture ([] stream-captures (. ([] capture-levels position) capture)))
      (let element
        (block
          (case? (> ([] depths index) 1)
            (call level-list ([] capture-levels (- position 1)) id)
          )
          (default
            (call captured-element capture position id)
          )
        )
      )
      (call append-level ([] capture-levels position) element (. capture site))
    )
    (call store-local spot next id)
    (if counts
      (call store-local
        (block
          (arg taken)
          (arg
            (call arithmetic
              (block
                (arg id)
                (arg .arithmetic-add)
                (arg (call load-local taken id))
                (arg (call integer .machine-u64 1))
                (arg u64-layout)
              )
            )
          )
          (arg id)
        )
      )
    )
    (if (and (== most (. U64 max)) (not onward))
      (call branch (call compare id .compare-greater next begun) test done)
      (else
        (call jump test)
      )
    )
    (if (or (!= (. passing length) 0) (!= saved no-local))
      (call (. ir start-block) missed)
      (call rewind-levels passing id)
      (call rewind-mark id)
      (call jump done)
    )
    (call (. ir start-block) done)
    (let finish (call load-local spot id))
    (let short failed)
    (if (or (!= (. entered length) 0) (!= saved no-local))
      (= short (call (. ir reserve-block)))
    )
    (let given (call Typed (call make-operand .operand-void 0) no-type))
    (if values
      (= given (call Typed (. (call level-list values id) operand) (. values list)))
    )
    (if (!= least-at 0)
      (let least-value (call count-of least-at))
      (let counted (call (. ir reserve-block)))
      (call branch
        (block
          (arg (call compare id .compare-greater-equal (call load-local taken id) (. least-value operand)))
          (arg counted)
          (arg short)
        )
      )
      (call cut-repeat entered saved gathered short failed id)
      (call (. ir start-block) counted)
      (call settle-repeat saved gathered id)
      (return (call StreamPart finish given))
    )
    (if (== least 0)
      (call settle-repeat saved gathered id)
      (return (call StreamPart finish given))
    )
    (let enough (call (. ir reserve-block)))
    (call branch
      (block
        (arg (call compare id .compare-greater-equal (call load-local taken id) (call integer .machine-u64 least)))
        (arg enough)
        (arg short)
      )
    )
    (call cut-repeat entered saved gathered short failed id)
    (call (. ir start-block) enough)
    (call settle-repeat saved gathered id)
    (return (call StreamPart finish given))
  )
  (fn-do _ advances Bool
    (param id SyntaxId)
    ; Whether a part of a pattern moves on by at least one item wherever it passes: text that
    ; holds some, a range or any item, a sequence with such a part, a choice whose alternatives
    ; all are, and one or more of such a part, or a count of one at least.
    (match? ([] (. tree nodes) id)
      (case (call .node-stream-string row)
        (return (!= (. row text length) 0))
      )
      (case .node-stream-any
        (return true)
      )
      (case .node-stream-char-range
        (return true)
      )
      (case (call .node-stream-and row)
        (return (or (call advances (. row left)) (call advances (. row right))))
      )
      (case (call .node-stream-or row)
        (return (and (call advances (. row left)) (call advances (. row right))))
      )
      (case (call .node-stream-capture row)
        (return (call advances (. row pattern)))
      )
      (case (call .node-stream-transform row)
        (return (and (!= (. row pattern) 0) (call (. tree lazies-only) (. row right)) (call advances (. row pattern))))
      )
      (case (call .node-stream-unary row)
        (return (and (== (. row op) .one-or-more-op) (call advances (. row operand))))
      )
      (case (call .node-stream-length row)
        (return (and (call (. tree literal-bound) (. row min)) (!= (call (. tree stream-bound) (. row min)) 0) (call advances (. row operand))))
      )
    )
    (return false)
  )
  (fn-do _ cut-repeat _
    (param marks (list LevelMark))
    (param saved LocalId)
    (param gathered LocalId)
    (param block IRBlockId)
    (param failed IRBlockId)
    (param site SyntaxId)
    ; Emits the block a repeat that passed too few times goes to, where any lists were marked or
    ; the pattern holds rollback marks: it cuts the lists back to what they held where the repeat
    ; began, gives back the rollback mark its passes held, and holds the one it held before; then
    ; it goes on to `failed`.
    (if (and (== (. marks length) 0) (== saved no-local))
      (return)
    )
    (call (. ir start-block) block)
    (call rewind-levels marks site)
    (if (!= saved no-local)
      (call store-local (. streaming rollback-mark) (call load-local gathered site) site)
      (call fail-marks saved site)
    )
    (call jump failed)
  )
  (fn-do _ captured-element Typed
    (param capture StreamCapture)
    (param position U32)
    (param id SyntaxId)
    ; What a name a pass of a repeat captured, which the repeat adds to its list: the item a test
    ; passed, as it was kept, the text between the cursors its part began and ended at, or, for a
    ; name a helper makes, the range of those cursors.
    (if (!= (. capture value) no-local)
      (return (call Typed (call load-local (. capture value) id) (. ([] capture-levels position) item)))
    )
    (if (!= (call material-at (. capture site) .material-ranges) (. U32 max))
      (let item (. ([] capture-levels position) item))
      (let layout (call layout-of item id))
      (let range (call frame layout))
      (call put range (call (. tables layouts field) layout 0) (call load-local (. capture begin) id) id)
      (call put range (call (. tables layouts field) layout 1) (call load-local (. capture end) id) id)
      (return (call Typed range item))
    )
    (return (call stream-text (. capture run) (. capture site) (call load-local (. capture begin) id) (call load-local (. capture end) id)))
  )
  (fn-do _ value-level (? CaptureLevel)
    (param id SyntaxId)
    ; The list a repeat keeps of what its part gives on each pass, where the type pass planned
    ; the repeat to give them: its collector, by the call recorded at the repeat that grows it.
    (if (!= (call (. facts plan-of) (. unit reading) id) .plan-stream-value)
      (return null)
    )
    (let list (call (. facts node-type) (. unit reading) id))
    (let fact (call (. facts call-in-role) (. unit reading) id .role-grow))
    (let callee (if-expr (!= fact no-fact) (. ([] (. facts calls) fact) callee) no-instance))
    (if (== callee no-instance)
      (call refuse .refused-expression id)
      (return null)
    )
    (let collector (. ([] (. instances rows) callee) self-type))
    (let items (call (. ir add-local) (call layout-of (. ([] (. instances signatures) callee) returns) id)))
    (let size (call (. ir add-local) u64-layout))
    (let context (call context-local collector id))
    (return (call CaptureLevel (. U32 max) items size fact collector (call class-arg types collector 0) list context))
  )
  (fn-do _ repeat-levels _
    (param id SyntaxId)
    (param depth U32)
    (param listing (list U32))
    (param depths (list U32))
    ; The lists a repeat keeps for the names its part captures, with how many repeats deep in
    ; it each name lies, counting the repeat itself.
    (match? ([] (. tree nodes) id)
      (case (call .node-stream-capture row)
        (let held (call captured-at (call captured-slot (. row name))))
        (if (and (!= held (. U32 max)) (not (. ([] stream-captures held) accumulates)) deep-enough)
          (let position (- (+ (. ([] stream-captures held) levels) depth) 1))
          (if (== (call (. listing find) position) null)
            (+= listing position)
            (+= depths depth)
          )
        )
        (lazy deep-enough (>= (. ([] stream-captures held) listed) depth))
        (call repeat-levels (. row pattern) depth listing depths)
      )
      (case (call .node-stream-and row)
        (call repeat-levels (. row left) depth listing depths)
        (call repeat-levels (. row right) depth listing depths)
      )
      (case (call .node-stream-or row)
        (call repeat-levels (. row left) depth listing depths)
        (call repeat-levels (. row right) depth listing depths)
      )
      (case (call .node-stream-transform row)
        (call repeat-levels (. row pattern) depth listing depths)
      )
      (case (call .node-stream-panic row)
        (call repeat-levels (. row pattern) depth listing depths)
      )
      (case (call .node-stream-unary row)
        (let repeat (or (== (. row op) .zero-or-more-op) (== (. row op) .one-or-more-op)))
        (call repeat-levels (. row operand) (if-expr repeat (+ depth 1) depth) listing depths)
      )
      (case (call .node-stream-length row)
        (call repeat-levels (. row operand) (+ depth 1) listing depths)
      )
    )
  )
  (fn-do _ level-list Typed
    (param level CaptureLevel)
    (param site SyntaxId)
    ; The list a repeat made of what a name captured, or of what its part gave, on each of its
    ; passes: an `ImmutableArray` over the collector's items, as many as it holds.
    (let layout (call layout-of (. level list) site))
    (let items-layout (. ([] (. ir locals) (. level items)) layout))
    (let list (call frame layout))
    (call put
      (block
        (arg list)
        (arg (call (. tables layouts field) layout 0))
        (arg (call take (call load-local (. level items) site) (call (. tables layouts field) items-layout 0) site))
        (arg site)
      )
    )
    (call put list (call (. tables layouts field) layout 1) (call load-local (. level size) site) site)
    (return (call Typed list (. level list)))
  )
  (fn-do _ append-level _
    (param level CaptureLevel)
    (param element Typed)
    (param site SyntaxId)
    ; Adds an item to a list, as the reference's collector adds one: where its items
    ; are full, they grow, in the arena of the context of a collector backed by one as the
    ; reference grows an arena's builder, and else by the call the type pass recorded; the item is
    ; stored after the last, through the write barrier where it is managed, and the size counts it.
    (if (!= (. element type) (. level item))
      (call refuse .refused-expression site)
      (return)
    )
    (let item-layout (call layout-of (. level item) site))
    (let collector-layout (call layout-of (. level collector) site))
    (let items-layout (. ([] (. ir locals) (. level items)) layout))
    (let count-field (call (. tables layouts field) items-layout 1))
    (let size (call load-local (. level size) site))
    (if (== (call class-arg types (. level collector) 1) (. types arena-backing-type))
      (call grow-in-arena level item-layout size site)
      (call put-item level size (. element operand) item-layout site)
      (call store-local
        (block
          (arg (. level size))
          (arg (call arithmetic site .arithmetic-add size (call integer .machine-u64 1) u64-layout))
          (arg site)
        )
      )
      (return)
    )
    (let capacity
      (call num-cast
        (block
          (arg site)
          (arg (call take (call load-local (. level items) site) count-field site))
          (arg (. count-field layout))
          (arg u64-layout)
        )
      )
    )
    (let growing (call (. ir reserve-block)))
    (let joined (call (. ir reserve-block)))
    (call branch (call compare site .compare-equal size capacity) growing joined)
    (call (. ir start-block) growing)
    (let collector (call frame collector-layout))
    (call put collector (call (. tables layouts field) collector-layout 0) (call load-local (. level items) site) site)
    (call put collector (call (. tables layouts field) collector-layout 1) size site)
    (if (!= (. level context) no-local)
      (call put collector (call (. tables layouts field) collector-layout 2) (call load-local (. level context) site) site)
    )
    (let grown
      (call call-protocol
        (block
          (arg site)
          (arg (. level grow))
          (arg collector)
          (arg (. level collector))
          (arg (call make-operand .operand-void 0))
        )
      )
    )
    (call store-local (. level items) (. grown operand) site)
    (call jump joined)
    (call (. ir start-block) joined)
    (call put-item level size (. element operand) item-layout site)
    (call store-local
      (block
        (arg (. level size))
        (arg (call arithmetic site .arithmetic-add size (call integer .machine-u64 1) u64-layout))
        (arg site)
      )
    )
  )
  (fn-do _ grow-in-arena _
    (param level CaptureLevel)
    (param item-layout LayoutId)
    (param size Operand)
    (param site SyntaxId)
    ; Makes room for one more item after the `size` a list holds in the arena its context names,
    ; as the reference grows an arena's builder: the items are described to the arena where they
    ; hold pointers the collector follows.
    (let items-layout (. ([] (. ir locals) (. level items)) layout))
    (let context-layout
      (scope (if-expr (!= (. level context) no-local) local-layout void-layout)
        (lazy local-layout (. ([] (. ir locals) (. level context)) layout))
      )
    )
    (if (or (== (. level context) no-local) (not (call (. tables layouts is-struct) context-layout)) unpaired-context)
      (call refuse .refused-expression site)
      (return)
    )
    (lazy unpaired-context (!= (. ([] (. tables layouts rows) context-layout) fields count) 2))
    (let data-field (call (. tables layouts field) items-layout 0))
    (let count-field (call (. tables layouts field) items-layout 1))
    (let held (call load-local (. level items) site))
    (let current
      (call BuilderItems
        (block
          (arg (call num-cast site (call take held data-field site) (. data-field layout) u64-layout))
          (arg (call num-cast site (call take held count-field site) (. count-field layout) u64-layout))
        )
      )
    )
    (let context (call load-local (. level context) site))
    (let needed (call arithmetic site .arithmetic-add size (call integer .machine-u64 1) u64-layout))
    (let traced (. ([] (. tables layouts rows) item-layout) is-managed))
    (let grown
      (call reserve-items
        (block
          (arg site)
          (arg item-layout)
          (arg traced)
          (arg (call word-at site context context-layout 0))
          (arg (call word-at site context context-layout 1))
          (arg current)
          (arg needed)
        )
      )
    )
    (let items (call frame items-layout))
    (call put items data-field (call num-cast site (. grown storage) u64-layout (. data-field layout)) site)
    (call put items count-field (call num-cast site (. grown capacity) u64-layout (. count-field layout)) site)
    (call store-local (. level items) items site)
  )
  (fn-do _ context-local LocalId
    (param collector TypeId)
    (param site SyntaxId)
    ; The local a list kept in a collector of a type holds the context of its backing in, where
    ; the backing is not the collector's, or none.
    (if (== (call class-arg types collector 1) (. types gc-backing-type))
      (return no-local)
    )
    (let layout (call layout-of collector site))
    (return (call (. ir add-local) (. (call (. tables layouts field) layout 2) layout)))
  )
  (fn-do _ start-level _
    (param level CaptureLevel)
    (param site SyntaxId)
    ; Empties a list as the reference makes a collector: no items, none counted, and, where its
    ; backing is not the collector's, the context the helper gives for it, read each time.
    (call zero (call load-local (. level items) site) (. ([] (. ir locals) (. level items)) layout))
    (call store-local (. level size) (call integer .machine-u64 0) site)
    (if (== (. level context) no-local)
      (return)
    )
    (if (or (== (. streaming storage-row) (. U32 max)) (== (. streaming pattern-helper-type) no-type))
      (call refuse .refused-expression site)
      (return)
    )
    (let row ([] (. facts storage-bodies) (. streaming storage-row)))
    (let context
      (call read-through
        (block
          (arg site)
          (arg (call Typed (. streaming pattern-helper) (. streaming pattern-helper-type)))
          (arg (. row through))
        )
      )
    )
    (if (!= (call layout-of (. context type) site) (. ([] (. ir locals) (. level context)) layout))
      (call refuse .refused-expression site)
      (return)
    )
    (call store-local (. level context) (. context operand) site)
  )
  (fn-do _ put-item _
    (param level CaptureLevel)
    (param index Operand)
    (param element Operand)
    (param item-layout LayoutId)
    (param site SyntaxId)
    ; Stores an item of a list at an index its items hold, through the write barrier where it is
    ; managed.
    (let items-layout (. ([] (. ir locals) (. level items)) layout))
    (let width (as (. ([] (. tables layouts rows) item-layout) size) U64))
    (let storage-field (call (. tables layouts field) items-layout 0))
    (let storage (call take (call load-local (. level items) site) storage-field site))
    (let distance (call arithmetic site .arithmetic-multiply index (call integer .machine-u64 width) u64-layout))
    (let place
      (call num-cast
        (block
          (arg site)
          (arg
            (call arithmetic
              (block
                (arg site)
                (arg .arithmetic-add)
                (arg (call num-cast site storage (. storage-field layout) u64-layout))
                (arg distance)
                (arg u64-layout)
              )
            )
          )
          (arg u64-layout)
          (arg pointer-layout)
        )
      )
    )
    (let managed (. ([] (. tables layouts rows) item-layout) is-managed))
    (if (call (. tables layouts is-struct) item-layout)
      (call copy (call address place 0 item-layout site) element item-layout managed site)
      (else
        (call store place 0 element (and managed (call is-managed-pointer item-layout)) site)
      )
    )
  )
  (fn-do _ count-of Typed
    (param bound SyntaxId)
    ; A bound of a count computed as the match runs, as a Size.
    (let value (call emit-expression bound))
    (let layout (call layout-of (. value type) bound))
    (if (not (call is-integer layout))
      (call refuse .refused-type bound)
      (return value)
    )
    (return (call Typed (call num-cast bound (. value operand) layout u64-layout) (. value type)))
  )
  (fn-do _ stream-lookahead Operand
    (param run StreamRun)
    (param id SyntaxId)
    (param operand SyntaxId)
    (param positive Bool)
    (param cursor Operand)
    (param failed IRBlockId)
    ; A part tried from a cursor for whether it passes, which leaves the cursor where it was: a
    ; positive lookahead passes where the part does, and a negative one where it fails. Either way
    ; the lists names accumulate in the part are cut back to what they held before it, and the
    ; rollback mark the part holds is given back.
    (let passed (call (. ir reserve-block)))
    (let missed (call (. ir reserve-block)))
    (let marks (call mark-levels operand))
    (let entered (call enter-marks id))
    (call emit-stream-part run operand cursor missed)
    (if (and (!= (. streaming observer-row) (. U32 max)) (not scanning) (not (. streaming classing)))
      (call rewind-literals id cursor)
    )
    (call rewind-levels marks id)
    (call fail-marks entered id)
    (call jump (if-expr positive passed failed))
    (call (. ir start-block) missed)
    (call rewind-levels marks id)
    (call fail-marks entered id)
    (call jump (if-expr positive failed passed))
    (call (. ir start-block) passed)
    (return cursor)
  )
  (fn-do _ stream-guard Operand
    (param id SyntaxId)
    (param operand SyntaxId)
    (param positive Bool)
    (param cursor Operand)
    (param failed IRBlockId)
    ; A lookahead of a test that does not read the item, which the type pass planned as a guard: its
    ; condition is tested alone, reading no item, and a positive one passes where it holds and a
    ; negative one where it does not. Either way the cursor stays where it was.
    (let predicate SyntaxId
      (match ([] (. tree nodes) operand)
        (case (call .node-stream-predicate row)
          (. row predicate)
        )
        (default
          0
        )
      )
    )
    (if (== predicate 0)
      (call refuse .refused-expression id)
      (return cursor)
    )
    (let holds (. (call test predicate (call emit-expression predicate)) operand))
    (let passed (call (. ir reserve-block)))
    (call branch holds (if-expr positive passed failed) (if-expr positive failed passed))
    (call (. ir start-block) passed)
    (return cursor)
  )
  (fn-do _ stream-advance Operand
    (param run StreamRun)
    (param id SyntaxId)
    (param cursor Operand)
    (param count U64)
    ; A cursor moved on by a count of items.
    (if (== count 0)
      (return cursor)
    )
    (return
      (call arithmetic
        (block
          (arg id)
          (arg .arithmetic-add)
          (arg cursor)
          (arg (call integer (. ([] (. tables layouts rows) (. run index-layout)) kind) count))
          (arg (. run index-layout))
        )
      )
    )
  )
  (fn-do _ stream-item Operand
    (param run StreamRun)
    (param id SyntaxId)
    (param spot Operand)
    ; The item of the stream's buffer at a cursor the pattern knows is inside it: a struct as its
    ; address there, and anything else loaded.
    (let stride (call integer .machine-u64 (. ([] (. tables layouts rows) (. run item-layout)) size)))
    (let offset
      (call arithmetic
        (block
          (arg id)
          (arg .arithmetic-multiply)
          (arg (call num-cast id spot (. run index-layout) u64-layout))
          (arg stride)
          (arg u64-layout)
        )
      )
    )
    (let cell (call moved-bytes id (call run-data run id) offset))
    (if (call (. tables layouts is-struct) (. run item-layout))
      (return (call address cell 0 (. run item-layout) id))
    )
    (return (call load cell 0 (. run item-layout) id))
  )
  (fn-expr + encodes Bool
    (param run StreamRun)
    ; Whether the buffer of the stream a pattern runs on holds the UTF-8 bytes of the characters the
    ; stream gives, as a `TextTokenStream`'s text view does, rather than the characters: its cursors
    ; count bytes, and a character is read from the byte it starts at.
    (and (== item char) (== (call class-arg types (. run buffer-type) 0) (call (. types type-row) .uint8)))
    (where
      (lazy char (call (. types type-row) .char))
      (lazy item
        (block
          (case? (call same-decl (call class-ref types (. run stream-type)) (. types text-token-stream-decl))
            char
          )
          (default
            (call class-arg types (. run stream-type) 0)
          )
        )
      )
    )
  )
  (fn-do _ wide-ranges Bool
    (param run StreamRun)
    (param ranges (list ItemRange))
    ; Whether ranges of characters are not tested on the byte a character starts with where the
    ; buffer is UTF-8: where one holds characters past ASCII, but not every one.
    (if (not (call encodes run))
      (return false)
    )
    (for (in range ranges)
      (if (and (>= (. range last) 0x80) (or (> (. range first) 0x80) (< (. range last) any-item)))
        (return true)
      )
    )
    (return false)
  )
  (fn-do _ char-width Operand
    (param run StreamRun)
    (param id SyntaxId)
    (param lead Operand)
    ; The count of bytes of the character whose UTF-8 starts with a byte, as an index: one, and one
    ; more for each of 0xC0, 0xE0 and 0xF0 the byte reaches.
    (let width
      (call arithmetic
        (block
          (arg id)
          (arg .arithmetic-add)
          (arg (call integer (. ([] (. tables layouts rows) (. run index-layout)) kind) 1))
          (arg (call reaches run id lead 0xC0))
          (arg (. run index-layout))
        )
      )
    )
    (= width (call arithmetic id .arithmetic-add width (call reaches run id lead 0xE0) (. run index-layout)))
    (return (call arithmetic id .arithmetic-add width (call reaches run id lead 0xF0) (. run index-layout)))
  )
  (fn-do _ reaches Operand
    (param run StreamRun)
    (param id SyntaxId)
    (param lead Operand)
    (param bound U64)
    ; One, as an index, where a byte is at least a bound, and else none.
    (return
      (call num-cast
        (block
          (arg id)
          (arg
            (call compare
              (block
                (arg id)
                (arg .compare-greater-equal)
                (arg lead)
                (arg (call integer (. ([] (. tables layouts rows) (. run item-layout)) kind) bound))
              )
            )
          )
          (arg u8-layout)
          (arg (. run index-layout))
        )
      )
    )
  )
  (fn-do _ char-next Operand
    (param run StreamRun)
    (param id SyntaxId)
    (param cursor Operand)
    ; The cursor past the item at a cursor the pattern knows is inside the buffer: past the bytes of
    ; the character there where the buffer is UTF-8, and else the next.
    (if (not (call encodes run))
      (return (call stream-advance run id cursor 1))
    )
    (return
      (call arithmetic
        (block
          (arg id)
          (arg .arithmetic-add)
          (arg cursor)
          (arg (call char-width run id (call stream-item run id cursor)))
          (arg (. run index-layout))
        )
      )
    )
  )
  (fn-do _ advance-chars Operand
    (param run StreamRun)
    (param id SyntaxId)
    (param cursor Operand)
    (param count U64)
    ; The cursor a count of characters past a cursor in a UTF-8 buffer, or the end of the input
    ; where it ends first.
    (let kind (. ([] (. tables layouts rows) (. run index-layout)) kind))
    (let at (call (. ir add-local) (. run index-layout)))
    (call store-local at cursor id)
    (let left (call (. ir add-local) (. run index-layout)))
    (call store-local left (call integer kind count) id)
    (let test (call (. ir reserve-block)))
    (let inside (call (. ir reserve-block)))
    (let step (call (. ir reserve-block)))
    (let done (call (. ir reserve-block)))
    (call jump test)
    (call (. ir start-block) test)
    (call branch (call compare id .compare-greater (call load-local left id) (call integer kind 0)) inside done)
    (call (. ir start-block) inside)
    (call branch (call compare id .compare-less (call load-local at id) (call run-length run id)) step done)
    (call (. ir start-block) step)
    (call store-local at (call char-next run id (call load-local at id)) id)
    (call store-local
      (block
        (arg left)
        (arg (call arithmetic id .arithmetic-subtract (call load-local left id) (call integer kind 1) (. run index-layout)))
        (arg id)
      )
    )
    (call jump test)
    (call (. ir start-block) done)
    (return (call load-local at id))
  )
  (fn-do _ char-at Operand
    (param run StreamRun)
    (param id SyntaxId)
    (param spot Operand)
    ; The item at a cursor the pattern knows is inside the buffer, as `stream-item` reads it, but
    ; where the buffer is UTF-8, the character whose bytes start there, decoded: a byte below 0x80
    ; is the character, and else the bits a lead byte keeps for it are followed by six of each
    ; byte after it.
    (if (not (call encodes run))
      (return (call stream-item run id spot))
    )
    (let layout (call layout-of (call (. types type-row) .char) id))
    (let value (call (. ir add-local) layout))
    (let lead (call stream-item run id spot))
    (let wide (call num-cast id lead (. run item-layout) layout))
    (let single (call (. ir reserve-block)))
    (let multiple (call (. ir reserve-block)))
    (let two (call (. ir reserve-block)))
    (let longer (call (. ir reserve-block)))
    (let three (call (. ir reserve-block)))
    (let four (call (. ir reserve-block)))
    (let done (call (. ir reserve-block)))
    (let byte-kind (. ([] (. tables layouts rows) (. run item-layout)) kind))
    (call branch (call compare id .compare-less lead (call integer byte-kind 0x80)) single multiple)
    (call (. ir start-block) single)
    (call store-local value wide id)
    (call jump done)
    (call (. ir start-block) multiple)
    (let second (call continuation run id spot 1 layout))
    (call branch (call compare id .compare-less lead (call integer byte-kind 0xE0)) two longer)
    (call (. ir start-block) two)
    (call store-local
      (block
        (arg value)
        (arg (call merged id (call shifted id (call masked id wide 0x1F layout) 6 layout) second layout))
        (arg id)
      )
    )
    (call jump done)
    (call (. ir start-block) longer)
    (let third (call continuation run id spot 2 layout))
    (call branch (call compare id .compare-less lead (call integer byte-kind 0xF0)) three four)
    (call (. ir start-block) three)
    (let upper
      (call merged
        (block
          (arg id)
          (arg (call shifted id (call masked id wide 0x0F layout) 12 layout))
          (arg (call shifted id second 6 layout))
          (arg layout)
        )
      )
    )
    (call store-local value (call merged id upper third layout) id)
    (call jump done)
    (call (. ir start-block) four)
    (let fourth (call continuation run id spot 3 layout))
    (let high
      (call merged
        (block
          (arg id)
          (arg (call shifted id (call masked id wide 0x07 layout) 18 layout))
          (arg (call shifted id second 12 layout))
          (arg layout)
        )
      )
    )
    (call store-local
      (block
        (arg value)
        (arg (call merged id (call merged id high (call shifted id third 6 layout) layout) fourth layout))
        (arg id)
      )
    )
    (call jump done)
    (call (. ir start-block) done)
    (return (call load-local value id))
  )
  (fn-do _ continuation Operand
    (param run StreamRun)
    (param id SyntaxId)
    (param spot Operand)
    (param offset U64)
    (param layout LayoutId)
    ; The six bits a continuation byte of a character in a UTF-8 buffer keeps, some bytes past the
    ; cursor its character starts at, as a number of a layout.
    (let byte (call stream-item run id (call stream-advance run id spot offset)))
    (return (call masked id (call num-cast id byte (. run item-layout) layout) 0x3F layout))
  )
  (fn-do _ masked Operand
    (param id SyntaxId)
    (param value Operand)
    (param mask U64)
    (param layout LayoutId)
    (return (call bitwise id .bitwise-and value (call integer (. ([] (. tables layouts rows) layout) kind) mask) layout))
  )
  (fn-do _ merged Operand
    (param id SyntaxId)
    (param left Operand)
    (param right Operand)
    (param layout LayoutId)
    (return (call bitwise id .bitwise-or left right layout))
  )
  (fn-do _ text-span Typed
    (param capture StreamCapture)
    (param id SyntaxId)
    (param type TypeId)
    (let nothing (call make-operand .operand-void 0))
    (let run (. capture run))
    (let layout (call layout-of type id))
    (if (or (not (call (. tables layouts is-struct) layout)) (!= (. ([] (. tables layouts rows) layout) fields count) 3))
      (call refuse .refused-type id)
      (return (call Typed nothing no-type))
    )
    (let source-field (call (. tables layouts field) layout 0))
    (let start-field (call (. tables layouts field) layout 1))
    (let end-field (call (. tables layouts field) layout 2))
    (if (or (!= (. source-field layout) (. run buffer-layout)) unindexed-bounds)
      (call refuse .refused-type id)
      (return (call Typed nothing no-type))
    )
    (lazy unindexed-bounds (or (!= (. start-field layout) (. run index-layout)) (!= (. end-field layout) (. run index-layout))))
    (let buffer (call run-buffer run id))
    (let span (call frame layout))
    (call put span source-field buffer id)
    (call put span start-field (call load-local (. capture begin) id) id)
    (call put span end-field (call load-local (. capture end) id) id)
    (return (call Typed span type))
  )
  (fn-do + stream-text Typed
    (param run StreamRun)
    (param site SyntaxId)
    (param begun Operand)
    (param ending Operand)
    ; The text a part of a pattern matched: the part of the stream's buffer between two cursors,
    ; as an array that shares the buffer's items, made text by the call the type pass recorded
    ; where the text is given; or where a helper makes it, what its materializer makes of the
    ; buffer and the cursors.
    (let nothing (call make-operand .operand-void 0))
    (let made (call material-at site .material-text))
    (if (!= made (. U32 max))
      (return (call material-capture run site made begun ending))
    )
    (let fact (call (. facts call-in-role) (. unit reading) site .role-text))
    (if (== fact no-fact)
      (call refuse .refused-expression site)
      (return (call Typed nothing no-type))
    )
    (return
      (call call-protocol
        (block
          (arg site)
          (arg fact)
          (arg (. (call stream-slice run site begun ending) operand))
          (arg (. run buffer-type))
          (arg nothing)
        )
      )
    )
  )
  (fn-do + material-at U32
    (param site SyntaxId)
    (param kind MaterialKind)
    ; The first value of a kind the helper makes at a place, as the type pass recorded it, or
    ; `U32.max`.
    (let row (call (. facts first-material) (. unit reading) site))
    (while (!= row (. U32 max))
      (if (== (. ([] (. facts materials) row) kind) kind)
        (return row)
      )
      (= row (. ([] (. facts materials) row) next))
    )
    (return (. U32 max))
  )
  (fn-do _ material-receiver Typed
    (param site SyntaxId)
    ; The helper the match keeps, which a materializer is called for: by the properties the type
    ; pass kept at the materializer's call, read from it in turn, as `call-protocol` reads them.
    (if (== (. streaming pattern-helper-type) no-type)
      (call refuse .refused-expression site)
    )
    (return (call Typed (. streaming pattern-helper) (. streaming pattern-helper-type)))
  )
  (fn-do _ material-capture Typed
    (param run StreamRun)
    (param site SyntaxId)
    (param row U32)
    (param begun Operand)
    (param ending Operand)
    ; What a capture materializer makes of the stream's buffer and two cursors, by the call the
    ; type pass recorded. A rule's function, given where the items start and their count, gives it
    ; an array that shares them.
    (let fact ([] (. facts materials) row))
    (let receiver (call material-receiver site))
    (let receiver-type (. receiver type))
    (let buffer (call run-buffer run site))
    (let answer
      (call call-protocol
        (block
          (arg site)
          (arg (. fact call))
          (arg (. receiver operand))
          (arg receiver-type)
          (arg buffer)
          (arg (. run buffer-type))
          (arg true)
          (arg begun)
          (arg (. types index-type))
          (arg ending)
          (arg (. types index-type))
        )
      )
    )
    (return answer)
  )
  (fn-do _ span-text Typed
    (param site SyntaxId)
    (param span Operand)
    (param type TypeId)
    (param call FactId)
    ; The text of the items a `CaptureSpan` spans, as an action reads a name that holds one: the
    ; part of its source between its cursors, as an array that shares the source's items, made
    ; text by the call the type pass recorded.
    (let nothing (call make-operand .operand-void 0))
    (let layout (call layout-of type site))
    (if (or (not (call (. tables layouts is-struct) layout)) (!= (. ([] (. tables layouts rows) layout) fields count) 3))
      (call refuse .refused-type site)
      (return (call Typed nothing no-type))
    )
    (let source-field (call (. tables layouts field) layout 0))
    (let start-field (call (. tables layouts field) layout 1))
    (let end-field (call (. tables layouts field) layout 2))
    (let item-layout (call layout-of (call class-arg types type 0) site))
    (if (or (not (call (. tables layouts is-struct) (. source-field layout))) unpaired-source uneven-bounds)
      (call refuse .refused-type site)
      (return (call Typed nothing no-type))
    )
    (lazy unpaired-source (!= (. ([] (. tables layouts rows) (. source-field layout)) fields count) 2))
    (lazy uneven-bounds (or (!= (. start-field layout) (. end-field layout)) (not (call is-integer (. start-field layout)))))
    (let data-field (call (. tables layouts field) (. source-field layout) 0))
    (let size-field (call (. tables layouts field) (. source-field layout) 1))
    (let source (call take span source-field site))
    (let begun (call take span start-field site))
    (let ending (call take span end-field site))
    (let stride (call integer .machine-u64 (. ([] (. tables layouts rows) item-layout) size)))
    (let offset
      (call arithmetic
        (block
          (arg site)
          (arg .arithmetic-multiply)
          (arg (call num-cast site begun (. start-field layout) u64-layout))
          (arg stride)
          (arg u64-layout)
        )
      )
    )
    (let data (call num-cast site (call take source data-field site) (. data-field layout) pointer-layout))
    (let slice (call frame (. source-field layout)))
    (call put
      (block
        (arg slice)
        (arg data-field)
        (arg (call num-cast site (call moved-bytes site data offset) pointer-layout (. data-field layout)))
        (arg site)
      )
    )
    (let count (call arithmetic site .arithmetic-subtract ending begun (. start-field layout)))
    (call put slice size-field (call num-cast site count (. start-field layout) (. size-field layout)) site)
    (return (call call-protocol site call slice (. source-field type) nothing))
  )
  (fn-do _ material-value Typed
    (param site SyntaxId)
    (param row U32)
    (param value Operand)
    (param given TypeId)
    ; What a value materializer makes of a value, by the call the type pass recorded.
    (let fact ([] (. facts materials) row))
    (let receiver (call material-receiver site))
    (let receiver-type (. receiver type))
    (let answer (call call-protocol site (. fact call) (. receiver operand) receiver-type value given))
    (return answer)
  )
  (fn-do + remake Typed
    (param site SyntaxId)
    (param row U32)
    (param value Operand)
    (param given TypeId)
    ; What a helper makes again of what an action gave, by the value materializer the type pass
    ; recorded: of the value; of what an optional one holds; or, where the call that grows a list
    ; is recorded after the materializer's, of each item of a list.
    (let fact ([] (. facts materials) row))
    (if (and (!= (. fact next) (. U32 max)) (== (. ([] (. facts materials) (. fact next)) kind) .material-grow))
      (return (call material-items site row (. fact next) value given (call class-arg types given 0)))
    )
    (if (call (. types is-optional) given)
      (return (call material-optional site row value given))
    )
    (return (call material-value site row value given))
  )
  (fn-do _ material-optional Typed
    (param site SyntaxId)
    (param row U32)
    (param held Operand)
    (param given TypeId)
    ; What a value materializer makes of an optional value: of what it holds, only where it holds
    ; a value, as the optional the type pass recorded; null where it holds none.
    (let fact ([] (. facts materials) row))
    (let layout (call layout-of (. fact type) site))
    (let slot (call join-slot layout))
    (let joined (call (. ir reserve-block)))
    (let holds (call (. ir reserve-block)))
    (let empty (call (. ir reserve-block)))
    (let mark (. joins length))
    (call branch (. (call present site (call Typed held given)) operand) holds empty)
    (call (. ir start-block) holds)
    (let inner (call payload site (call Typed held given)))
    (let made (call material-value site row (. inner operand) (call (. types optional-inner) given)))
    (call arrive site (. (call wrap site made (. fact type)) operand) joined slot)
    (call (. ir start-block) empty)
    (call arrive site (. (call empty-optional (. fact type) layout) operand) joined slot)
    (let kept (call close-joins joined mark layout slot))
    (return (call Typed kept (. fact type)))
  )
  (fn-do + bind-materials _
    (param run StreamRun)
    (param action SyntaxId)
    ; Binds each name an action reads that the helper makes to what it makes, in the order the
    ; type pass recorded them: from the cursors of a name captured over text, only where an
    ; optional one holds text, or from what a name holds, item by item where it holds a list a
    ; rule gave.
    (let row (call (. facts first-material) (. unit reading) action))
    (while (!= row (. U32 max))
      (let fact ([] (. facts materials) row))
      (let current row)
      (= row (. fact next))
      (if (and (!= (. fact kind) .material-capture) (!= (. fact kind) .material-value) not-span-text)
        (continue)
      )
      (lazy not-span-text (!= (. fact kind) .material-span-text))
      (let held (call captured-at (. fact slot)))
      (if (== held (. U32 max))
        (call refuse .refused-expression action)
        (return)
      )
      (let capture ([] stream-captures held))
      (if (== (. fact kind) .material-span-text)
        (if (or (!= (. capture listed) 0) (== (. capture value) no-local))
          (call refuse .refused-expression action)
          (return)
        )
        (let text (call span-text action (call load-local (. capture value) action) (. capture type) (. fact call)))
        (+= bound (call BoundValue (. fact slot) (. fact type) (. text operand)))
        (continue)
      )
      (if (!= (. capture listed) 0)
        (if (or (== (. fact next) (. U32 max)) (!= (. ([] (. facts materials) (. fact next)) kind) .material-grow))
          (call refuse .refused-expression action)
          (return)
        )
        (let made (call material-list run action current capture (. fact next)))
        (+= bound (call BoundValue (. fact slot) (. fact type) (. made operand)))
        (continue)
      )
      (if (== (. fact kind) .material-value)
        (if (== (. capture value) no-local)
          (call refuse .refused-expression action)
          (return)
        )
        (let held-value (call load-local (. capture value) action))
        (if (and (!= (. fact next) (. U32 max)) (== (. ([] (. facts materials) (. fact next)) kind) .material-grow))
          (let items
            (call material-items
              (block
                (arg action)
                (arg current)
                (arg (. fact next))
                (arg held-value)
                (arg (. capture type))
                (arg (call class-arg types (. capture type) 0))
              )
            )
          )
          (+= bound (call BoundValue (. fact slot) (. fact type) (. items operand)))
          (continue)
        )
        (if (not (call (. types is-optional) (. capture type)))
          (let made (call material-value action current held-value (. capture type)))
          (+= bound (call BoundValue (. fact slot) (. fact type) (. made operand)))
          (continue)
        )
        (let kept (call material-optional action current held-value (. capture type)))
        (+= bound (call BoundValue (. fact slot) (. fact type) (. kept operand)))
        (continue)
      )
      (if (== (. capture present) no-local)
        (let made
          (call material-capture
            (block
              (arg run)
              (arg action)
              (arg current)
              (arg (call load-local (. capture begin) action))
              (arg (call load-local (. capture end) action))
            )
          )
        )
        (+= bound (call BoundValue (. fact slot) (. fact type) (. made operand)))
        (continue)
      )
      (let layout (call layout-of (. fact type) action))
      (let slot (call join-slot layout))
      (let joined (call (. ir reserve-block)))
      (let holds (call (. ir reserve-block)))
      (let empty (call (. ir reserve-block)))
      (let mark (. joins length))
      (call branch
        (block
          (arg
            (call compare
              (block
                (arg action)
                (arg .compare-not-equal)
                (arg (call load-local (. capture present) action))
                (arg (call integer .machine-u8 0))
              )
            )
          )
          (arg holds)
          (arg empty)
        )
      )
      (call (. ir start-block) holds)
      (let made
        (call material-capture
          (block
            (arg run)
            (arg action)
            (arg current)
            (arg (call load-local (. capture begin) action))
            (arg (call load-local (. capture end) action))
          )
        )
      )
      (call arrive action (. (call wrap action made (. fact type)) operand) joined slot)
      (call (. ir start-block) empty)
      (call arrive action (. (call empty-optional (. fact type) layout) operand) joined slot)
      (let result (call close-joins joined mark layout slot))
      (+= bound (call BoundValue (. fact slot) (. fact type) result))
    )
  )
  (fn-do _ material-list Typed
    (param run StreamRun)
    (param action SyntaxId)
    (param row U32)
    (param capture StreamCapture)
    (param grower U32)
    ; The list a helper makes of a name captured in a repeat, as `material-items` makes it of the
    ; list its passes kept.
    (let source ([] capture-levels (- (+ (. capture levels) (. capture listed)) 1)))
    (return
      (call material-items
        (block
          (arg action)
          (arg row)
          (arg grower)
          (arg (. (call level-list source action) operand))
          (arg (. source list))
          (arg (. source item))
          (arg run)
        )
      )
    )
  )
  (fn-do _ material-items Typed
    (param action SyntaxId)
    (param row U32)
    (param grower U32)
    (param ranges Operand)
    (param list TypeId)
    (param item TypeId)
    (param run (? StreamRun) (= null))
    ; The list a helper makes of a list, in order: what the capture materializer makes of each
    ; range kept over the text of `run`, or the value materializer of each value, added to a
    ; collector of its own, grown by the call the type pass recorded, which the list then reads.
    (let nothing (call make-operand .operand-void 0))
    (let ranges-layout (call layout-of list action))
    (let item-layout (call layout-of item action))
    (let grow ([] (. facts materials) grower))
    (let callee (. ([] (. facts calls) (. grow call)) callee))
    (if (== callee no-instance)
      (call refuse .refused-expression action)
      (return (call Typed nothing no-type))
    )
    (let level
      (call CaptureLevel
        (block
          (arg (. U32 max))
          (arg (call (. ir add-local) (call layout-of (. ([] (. instances signatures) callee) returns) action)))
          (arg (call (. ir add-local) u64-layout))
          (arg (. grow call))
          (arg (. grow type))
          (arg (call class-arg types (. grow type) 0))
          (arg (. ([] (. facts materials) row) type))
          (arg (call context-local (. grow type) action))
        )
      )
    )
    (call start-level level action)
    (let data-field (call (. tables layouts field) ranges-layout 0))
    (let count-field (call (. tables layouts field) ranges-layout 1))
    (let data (call num-cast action (call take ranges data-field action) (. data-field layout) u64-layout))
    (let count (call num-cast action (call take ranges count-field action) (. count-field layout) u64-layout))
    (let index (call (. ir add-local) u64-layout))
    (call store-local index (call integer .machine-u64 0) action)
    (let test (call (. ir reserve-block)))
    (let body (call (. ir reserve-block)))
    (let done (call (. ir reserve-block)))
    (call jump test)
    (call (. ir start-block) test)
    (let current (call load-local index action))
    (call branch (call compare action .compare-less current count) body done)
    (call (. ir start-block) body)
    (let stride (call integer .machine-u64 (. ([] (. tables layouts rows) item-layout) size)))
    (let offset (call arithmetic action .arithmetic-multiply current stride u64-layout))
    (let place
      (call num-cast
        (block
          (arg action)
          (arg (call arithmetic action .arithmetic-add data offset u64-layout))
          (arg u64-layout)
          (arg pointer-layout)
        )
      )
    )
    (let element (call Typed (call make-operand .operand-void 0) no-type))
    (if (== (. ([] (. facts materials) row) kind) .material-capture)
      (if (== run null)
        (call refuse .refused-expression action)
        (return (call Typed nothing no-type))
      )
      (let range (call address place 0 item-layout action))
      (let begun (call take range (call (. tables layouts field) item-layout 0) action))
      (let ending (call take range (call (. tables layouts field) item-layout 1) action))
      (= element (call material-capture run action row begun ending))
      (else
        (let given
          (block
            (case? (call (. tables layouts is-struct) item-layout)
              (call address place 0 item-layout action)
            )
            (default
              (call load place 0 item-layout action)
            )
          )
        )
        (= element (call material-value action row given item))
      )
    )
    (call append-level level element action)
    (call store-local
      (block
        (arg index)
        (arg (call arithmetic action .arithmetic-add current (call integer .machine-u64 1) u64-layout))
        (arg action)
      )
    )
    (call jump test)
    (call (. ir start-block) done)
    (return (call level-list level action))
  )
  (fn-do _ stream-slice Typed
    (param run StreamRun)
    (param site SyntaxId)
    (param begun Operand)
    (param ending Operand)
    ; The part of the stream's buffer between two cursors, as an array that shares the buffer's
    ; items.
    (let slice (call frame (. run buffer-layout)))
    (let data-field (call (. tables layouts field) (. run buffer-layout) 0))
    (let size-field (call (. tables layouts field) (. run buffer-layout) 1))
    (let stride (call integer .machine-u64 (. ([] (. tables layouts rows) (. run item-layout)) size)))
    (let offset
      (call arithmetic
        (block
          (arg site)
          (arg .arithmetic-multiply)
          (arg (call num-cast site begun (. run index-layout) u64-layout))
          (arg stride)
          (arg u64-layout)
        )
      )
    )
    (call put
      (block
        (arg slice)
        (arg data-field)
        (arg
          (call num-cast
            (block
              (arg site)
              (arg (call moved-bytes site (call run-data run site) offset))
              (arg pointer-layout)
              (arg (. data-field layout))
            )
          )
        )
        (arg site)
      )
    )
    (let count (call arithmetic site .arithmetic-subtract ending begun (. run index-layout)))
    (call put slice size-field (call num-cast site count (. run index-layout) (. size-field layout)) site)
    (return (call Typed slice (. run buffer-type)))
  )
  (fn-do _ record-extent _
    (param run StreamRun)
    (param id SyntaxId)
    (param probe Operand)
    ; Keeps how far the pattern read: the farthest of what it had read and a cursor it read up to.
    (let farther (call (. ir reserve-block)))
    (let kept (call (. ir reserve-block)))
    (call branch (call compare id .compare-greater probe (call load-local (. run extent) id)) farther kept)
    (call (. ir start-block) farther)
    (call store-local (. run extent) probe id)
    (call jump kept)
    (call (. ir start-block) kept)
  )
  (fn-do + record-error _
    (param run StreamRun)
    (param id SyntaxId)
    (param cursor Operand)
    ; Keeps the farthest cursor a part of the pattern failed at: the cursor where a part that
    ; failed began, or where an arm that had to read the whole input ended. The test of an item a
    ; repeat scans keeps none.
    (if scanning
      (return)
    )
    (let farther (call (. ir reserve-block)))
    (let kept (call (. ir reserve-block)))
    (call branch (call compare id .compare-greater cursor (call load-local (. run error) id)) farther kept)
    (call (. ir start-block) farther)
    (call store-local (. run error) cursor id)
    (call jump kept)
    (call (. ir start-block) kept)
  )
  (fn-do _ failure-of IRBlockId
    (param run StreamRun)
    (param id SyntaxId)
    (param cursor Operand)
    (param failed IRBlockId)
    ; Where a part tried from a cursor goes where it fails: a block that keeps the cursor as one a
    ; part failed at, then goes to `failed`. What is emitted next goes on past it.
    (if scanning
      (return failed)
    )
    (let missed (call (. ir reserve-block)))
    (let onward (call (. ir reserve-block)))
    (call jump onward)
    (call (. ir start-block) missed)
    (call record-error run id cursor)
    (call jump failed)
    (call (. ir start-block) onward)
    (return missed)
  )
  (fn-do _ last-item Operand
    (param run StreamRun)
    (param id SyntaxId)
    (param cursor Operand)
    ; The cursor of the item before a cursor, or the cursor itself where no item lies before it.
    (let kind (. ([] (. tables layouts rows) (. run index-layout)) kind))
    (let kept (call (. ir add-local) (. run index-layout)))
    (call store-local kept cursor id)
    (let back (call (. ir reserve-block)))
    (let done (call (. ir reserve-block)))
    (call branch (call compare id .compare-greater cursor (call integer kind 0)) back done)
    (call (. ir start-block) back)
    (call store-local
      (block
        (arg kept)
        (arg (call arithmetic id .arithmetic-subtract cursor (call integer kind 1) (. run index-layout)))
        (arg id)
      )
    )
    (call jump done)
    (call (. ir start-block) done)
    (return (call load-local kept id))
  )
  (fn-do + location-fact FactId
    (param arm SyntaxId)
    ; The call the type pass recorded at an arm of a grammar whose expression reads
    ; `location`: the one that answers where in the input a cursor lies.
    (let fact (call (. facts call-in-role) (. unit reading) arm .role-location))
    (let callee (if-expr (!= fact no-fact) (. ([] (. facts calls) fact) callee) no-instance))
    (if (and (!= callee no-instance) gives-location)
      (return fact)
    )
    (lazy gives-location (== (. ([] (. instances signatures) callee) returns) (. types token-location-type)))
    (return no-fact)
  )
  (fn-do + bind-location _
    (param run StreamRun)
    (param arm SyntaxId)
    (param fact FactId)
    (param begin Operand)
    (param end Operand)
    (param spans Bool)
    ; Binds the `location` an arm of a grammar declares, made where the arm runs of the
    ; stream's locations of cursors, by a call the type pass recorded at the arm: where it
    ; `spans` a pattern, a `MatchLocation` of where the pattern began and of the last item it
    ; matched, or of where it began where it matched none; else the `TokenLocation` of its one
    ; cursor. Where functions the expression makes read it, it is kept in the environment too.
    (let slot (call arm-slot-of arm .slot-location))
    (if (== slot no-slot)
      (call refuse .refused-expression arm)
      (return)
    )
    (let begun (call call-protocol arm fact (. run stream) (. run stream-type) begin (. types index-type)))
    (if (!= (. begun type) (. types token-location-type))
      (call refuse .refused-type arm)
      (return)
    )
    (if (not spans)
      (if (call is-captured slot)
        (call keep-captured slot (. begun operand) (. begun type) arm)
      )
      (+= bound (call BoundValue slot (. begun type) (. begun operand)))
      (return)
    )
    (let layout (call layout-of (. types match-location-type) arm))
    (let made (call frame layout))
    (call put made (call (. tables layouts field) layout 0) (. begun operand) arm)
    (let ended
      (call call-protocol
        (block
          (arg arm)
          (arg fact)
          (arg (. run stream))
          (arg (. run stream-type))
          (arg (call last-item run arm end))
          (arg (. types index-type))
        )
      )
    )
    (call put made (call (. tables layouts field) layout 1) (. ended operand) arm)
    (if (call is-captured slot)
      (call keep-captured slot made (. types match-location-type) arm)
    )
    (+= bound (call BoundValue slot (. types match-location-type) made))
  )
  (fn-expr _ stream-always-passes Bool
    (param id SyntaxId)
    ; Whether the last arm of a grammar always passes or raises: one with no pattern, or one
    ; that raises.
    (match ([] (. tree nodes) id)
      (case (call .node-stream-or row)
        (call stream-always-passes (. row right))
      )
      (case (call .node-stream-transform row)
        (or (== (. row pattern) 0) (call stream-always-passes (. row pattern)))
      )
      (case .node-stream-panic
        true
      )
      (default
        false
      )
    )
  )
  (fn-do + holds-capture Bool
    (param slot SlotId)
    ; Whether a name is bound to what a grammar captured, which it reads from the places
    ; the pattern keeps, never from an environment.
    (for (in row bound)
      (if (and (== (. row slot) slot) (or (!= (. row capture) (. U32 max)) (!= (. row cursor) (. U32 max))))
        (return true)
      )
    )
    (return false)
  )
  (fn-do _ clear-local _
    (param local LocalId)
    (param layout LayoutId)
    (param site SyntaxId)
    ; Stores the zero of its layout in a local: a struct cleared whole, a float's zero, or the
    ; zero of any other layout's kind, which for a pointer is the one that points at nothing.
    (if (call (. tables layouts is-struct) layout)
      (call zero
        (block
          (arg
            (call make-operand
              (block
                (arg .operand-value)
                (arg (call append .op-local-address site (call Span) local pointer-layout))
              )
            )
          )
          (arg layout)
        )
      )
      (else-if (call is-float layout)
        (call store-local local (call float-number layout 0.0) site)
      )
      (else
        (call store-local local (call integer (call (. tables layouts kind-of) layout) 0) site)
      )
    )
  )
  (fn-do + emit-raising-rule _
    ; A rule as the function calls that give it a pattern whose function may raise errors run:
    ; as the rule's function, but a call of the pattern it is given takes the pattern's answer or
    ; one of the errors, which leaves the function with the call, and the function returns its
    ; own answer or one of them. The rule takes one pattern, and reads it only to call it, as
    ; `emit-identifier` checks. A local rule of the rule that runs as a function has such a
    ; function too, which the rule's calls.
    (let row ([] (. facts raising-rules) (. function place)))
    (let signature ([] (. instances signatures) (. unit instance)))
    (let patterns U32)
    (for (in position (..< 0 (. signature args count)))
      (if (call (. types is-pattern-func) (call (. instances argument-type) (. unit instance) position))
        (+= patterns 1)
      )
    )
    (if (or (!= patterns 1) (!= (. signature errors count) 0))
      (call refuse-own)
      (return)
    )
    (= carried-given (. row given))
    (= carried-result (. row result))
    (if (== (. row rule) 0)
      (call emit-body)
      (else
        (call emit-lazy-rule (. row rule))
      )
    )
  )
  (fn-do + emit-mapped-rule _
    ; A rule, or a local rule of one, as the function calls of it that give it a set of
    ; collectors run: as the rule's function, given after its other arguments a pointer to each
    ; collector, whose list the rule's name it is given for adds to while it runs. No such call
    ; reads what the rule gives, so its arms make no text of what they matched. A set of no
    ; collectors adds no arguments.
    (let mapping ([] (. tables rule-mappings) (. function place)))
    (if (!= (. mapping names) no-string)
      (for (in name (call (. (call (. tables bundle text) (. mapping names)) split) ","))
        (+= collector-args name)
      )
    )
    (if (== (. mapping rule) 0)
      (call emit-body)
      (else
        (call emit-lazy-rule (. mapping rule))
      )
    )
  )
  (fn-do + emit-lazy-rule _
    (param rule SyntaxId)
    ; A local rule of a rule a module declares, as a function of its own that a pattern calls as
    ; it calls the rule: given the rule's stream and arguments, then the address the stream's
    ; items start at, the cursor to start from and the count of items, and where to keep where it
    ; ended, how far it read and the farthest cursor a part of it failed at. It reads the rule's
    ; arguments as the rule does. One of a rule that raises errors raises them too. One of a rule
    ; given its own helper as an argument runs under it, and one of a rule typed for a helper is
    ; given the helper as the rule is, and runs under it. One of a rule whose pattern holds a
    ; rollback mark holds one too, kept as the rule's, and gives it as the rule does. One no call
    ; reads the value of makes no text of what its arms matched. The function of a local rule
    ; beside a match that calls itself is given the stream alone before the address, and reads
    ; nothing of the function the rule is written in, as the tables made sure. Under a helper that
    ; observes literal words, one tells it of them only where `observes-literals` says its pattern
    ; holds any.
    (let signature ([] (. instances signatures) (. unit instance)))
    (let declared SyntaxId 0)
    (match? ([] (. ([] (. program modules) (. unit source-module)) decls) (. ([] (. instances rows) (. unit instance)) decl))
      (case (call .decl-function fn)
        (= declared (. fn syntax))
      )
    )
    (let matched SyntaxId 0)
    (match? ([] (. tree nodes) rule)
      (case (call .node-declare declaration)
        (= matched (. declaration right))
      )
    )
    (let pattern SyntaxId 0)
    (match? ([] (. tree nodes) matched)
      (case (call .node-stream-match row)
        (= pattern (. row pattern))
      )
    )
    (let result (call (. facts node-type) (. unit reading) matched))
    (let place (call (. facts local-rule-of) (. unit instance) rule))
    (let returned (if-expr (!= place (. U32 max)) (. ([] (. facts local-rules) place) answer) no-type))
    (if (!= (call (. tables rule-adapter-of) (. unit instance) rule) no-function)
      (let local ([] (. facts local-rules) place))
      (if (or (== pattern 0) untyped-result (== (. local buffer) no-type) carrying)
        (call refuse .refused-function rule)
        (return)
      )
      (lazy untyped-result (or (== result no-type) (== returned no-type)))
      (lazy carrying (or (!= carried-result no-type) (call carries (. unit instance))))
      (call (. ir add-argument) (call layout-of (. local stream) rule))
      (= returns-type returned)
      (= (. ir returns) (call layout-of returned rule))
      (if (!= (. signature errors count) 0)
        (call return-results (. local result) rule)
      )
      (if (not (call direct-arguments (. local buffer) rule))
        (return)
      )
      (+= inlining rule)
      (let viewed (call (. facts call-in-role) (. unit reading) matched .role-view))
      (call match-direct
        (block
          (arg rule)
          (arg matched)
          (arg pattern)
          (arg result)
          (arg returned)
          (arg (. local stream))
          (arg (. local buffer))
          (arg 1)
          (arg viewed)
          (arg (call (. facts call-in-role) (. unit reading) matched .role-extend))
        )
      )
      (call stop-inlining rule)
      (return)
    )
    (let buffer-type (call (. facts node-type) (. unit reading) declared))
    (if (or (== declared 0) (== pattern 0) (== result no-type) (== returned no-type) unbuffered)
      (call refuse .refused-function rule)
      (return)
    )
    (lazy unbuffered (or (== buffer-type no-type) (== (. signature args count) 0)))
    (let stream-type (call (. instances argument-type) (. unit instance) 0))
    (call (. ir add-argument) (call layout-of stream-type rule))
    (for (in position (..< 1 (. signature args count)))
      (call (. ir add-argument) (call layout-of (call (. instances argument-type) (. unit instance) position) rule))
    )
    (= returns-type returned)
    (= (. ir returns) (call layout-of returned rule))
    (if (!= (. signature errors count) 0)
      (call return-results (. ([] (. facts local-rules) place) result) rule)
    )
    (if (!= carried-result no-type)
      (call return-results carried-result rule)
    )
    (let first U32 (. ir arguments length))
    (if (not (call direct-arguments buffer-type rule (. ([] (. instances rows) (. unit instance)) helper) (call carries (. unit instance))))
      (return)
    )
    (if (== (. ([] (. instances rows) (. unit instance)) helper) no-type)
      (call ambient-helper)
    )
    (call open-environment declared)
    (call bind-arguments declared)
    (= rule-arguments true)
    (let ruled
      (call rule-match
        (block
          (arg program)
          (arg (. ([] (. instances rows) (. unit instance)) module))
          (arg (. ([] (. instances rows) (. unit instance)) decl))
        )
      )
    )
    (let views (call (. facts call-in-role) (. unit reading) ruled .role-view))
    (call match-direct
      (block
        (arg rule)
        (arg matched)
        (arg pattern)
        (arg result)
        (arg returned)
        (arg stream-type)
        (arg buffer-type)
        (arg first)
        (arg views)
        (arg (call (. facts call-in-role) (. unit reading) ruled .role-extend))
        (arg ruled)
        (arg (or (== (. function kind) .mapped-rule) (not (call (. tables reads-rule) (. unit instance) rule))))
        (arg (call observes-literals tree facts (. unit reading) pattern))
      )
    )
  )
)

(fn-do _ group-root U32
  (param parents (list U32))
  (param position U32)
  ; The alternative that stands for the group of another, as groups are joined.
  (let found position)
  (while (!= ([] parents found) found)
    (= found ([] parents found))
  )
  (return found)
)

(fn-expr _ is-lowercase-letter Bool
  (param point Char)
  (and (>= point 'a') (<= point 'z'))
)

(fn-expr _ is-word-letter Bool
  (param point Char)
  (or (and (>= point 'A') (<= point 'Z')) (call is-lowercase-letter point))
)

(fn-expr _ utf8-width U64
  (param point Char)
  ; The count of bytes UTF-8 writes a character in.
  (case? (< (as point U32) 0x80)
    (inline 1)
  )
  (case? (< (as point U32) 0x800)
    (inline 2)
  )
  (case? (< (as point U32) 0x10000)
    (inline 3)
  )
  (default
    (inline 4)
  )
)
