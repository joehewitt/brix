    (let view (call call-protocol id viewed (. run stream) (. run stream-type) nothing))
    (if (not (call (. types is-optional) (. view type)))
      (call refuse .refused-type id)
      (return (call bare-part cursor))
    )
    (let held (call payload id view))
    (let tuple-layout (call layout-of (. held type) id))
    (let reached (call part (. held operand) tuple-layout 1 id))
    (let probed (call part (. held operand) tuple-layout 3 id))
    (if (!= (. run kept-length) no-local)
      (call keep-view run id (. held operand) tuple-layout)
    )
    (call record-extent run id (. probed operand))
    (call record-error run id (. reached operand))
    (let value answer)
    (if (call (. types is-optional) (. answer type))
      (let flag (call present id value))
      (let passed (call (. ir reserve-block)))
      (call branch (. flag operand) passed failed)
      (call (. ir start-block) passed)
      (= value (call payload id value))
    )
    (if (call same-decl (call class-ref types (. value type)) (. types capture-result-decl))
      (= value (call part (. value operand) (call layout-of (. value type) id) 1 id))
    )
    (if (!= (. value type) result)
      (call refuse .refused-type id)
      (return (call bare-part cursor))
    )
    (return (call StreamPart (. reached operand) (call Typed (. value operand) result)))
  )
  (fn-do + rule-pattern SyntaxId
    (param call SyntaxId)
    ; The pattern of the local rule a call names, as the binder resolved the call.
    (match? ([] (. tree nodes) (call rule-declaration call))
      (case (call .node-declare declaration)
        (match? ([] (. tree nodes) (. declaration right))
          (case (call .node-stream-match rule)
            (return (. rule pattern))
          )
        )
      )
    )
    (return 0)
  )
  (fn-expr + rule-declaration SyntaxId
    (param call SyntaxId)
    ; The declaration of the local rule a call names, as the binder resolved the call, or none.
    (case? (!= (. resolution kind) .resolve-slot)
      0
    )
    (case? (!= (. row kind) .slot-lazy)
      0
    )
    (default
      (. row group)
    )
    (where
      (lazy resolution (call (. bindings resolution-of) (. ([] (. instances rows) (. unit reading)) binding) call))
      (lazy row ([] (. bindings slots) (. resolution slot)))
    )
  )
  (fn-do _ rule-cells RuleCells
    (param run StreamRun)
    ; The cells a rule a part calls writes where it stopped, how far it read and where it failed.
    (return
      (call RuleCells
        (block
          (arg (call (. ir add-local) (. run index-layout) true true))
          (arg (call (. ir add-local) (. run index-layout) true true))
          (arg (call (. ir add-local) (. run index-layout) true true))
        )
      )
    )
  )
  (fn-do _ pass-run _
    (param run StreamRun)
    (param id SyntaxId)
    (param cursor Operand)
    (param cells RuleCells)
    ; Passes a rule a part calls what it reads, from `cursor`, and where to write what `cells` hold.
    (+= pending (call run-data run id))
    (+= pending cursor)
    (+= pending (call run-length run id))
