  (fn-do + emit-rule-adapter _
    (param rule SyntaxId)
    ; The function a call of a local rule beside a match from the rule's own arms calls, as the
    ; reference makes one of the rule: given the stream, it runs the rule's own function on the
    ; stream's view as `attempt-arms` runs a pattern on a stream a match is given, and answers an
    ; optional `CaptureResult` of the items the rule read and what it gave, which holds nothing
    ; where the rule failed. Its call of the rule's function is written where the rule is named.
    ; In an instance that raises errors it answers that or one of them, as the rule's function
    ; does.
    (let nothing (call make-operand .operand-void 0))
    (let matched SyntaxId 0)
    (let named SyntaxId 0)
    (match? ([] (. tree nodes) rule)
      (case (call .node-declare declaration)
        (= matched (. declaration right))
        (= named (. declaration left))
      )
    )
    (let pattern SyntaxId 0)
    (match? ([] (. tree nodes) matched)
      (case (call .node-stream-match row)
        (= pattern (. row pattern))
      )
    )
    (let place (call (. facts local-rule-of) (. unit instance) rule))
    (let direct (call (. tables lazy-rule-of) (. unit instance) rule))
    (if (or (== pattern 0) (== place (. U32 max)) (== direct no-function))
      (call refuse .refused-function rule)
      (return)
    )
    (let local ([] (. facts local-rules) place))
    (let result (call (. facts node-type) (. unit reading) matched))
    (let type (. local adapted))
    (if (or (== result no-type) (== type no-type) (== (. local stream) no-type) (not (call (. types is-optional) type)))
      (call refuse .refused-function rule)
      (return)
    )
    (let captured (call (. types optional-inner) type))
    (let layout (call layout-of type rule))
    (let captured-layout (call layout-of captured rule))
    (call (. ir add-argument) (call layout-of (. local stream) rule))
    (= returns-type type)
    (= (. ir returns) (call layout-of type rule))
    (if (!= (. ([] (. instances signatures) (. unit instance)) errors count) 0)
      (call return-results (. local relayed) rule)
    )
    (let viewed (call (. facts call-in-role) (. unit reading) matched .role-view))
    (let commits (call (. facts call-in-role) (. unit reading) matched .role-commit))
    (let extends (call (. facts call-in-role) (. unit reading) matched .role-extend))
    (if (or (== commits no-fact) (not (call holds-only matched (list viewed commits extends))))
      (call refuse .refused-function rule)
      (return)
    )
    (if (or (not (call (. tables layouts is-struct) captured-layout)) unpaired-capture)
      (call refuse .refused-type rule)
      (return)
    )
    (lazy unpaired-capture (!= (. ([] (. tables layouts rows) captured-layout) fields count) 2))
    (let run
      (call view-stream
        (block
          (arg matched)
          (arg (call make-operand .operand-argument 0))
          (arg (. local stream))
          (arg true)
          (arg viewed)
          (arg extends)
        )
      )
    )
    (let failed (call (. ir reserve-block)))
    (= adapting direct)
    (let given (call attempt-arms named pattern result run false commits failed false))
    (= adapting no-function)
    (let items-field (call (. tables layouts field) captured-layout 0))
    (let result-field (call (. tables layouts field) captured-layout 1))
    (if (or other-buffer (!= (. result-field layout) (call layout-of result rule)))
      (call refuse .refused-type rule)
    )
    (lazy other-buffer (!= (. items-field layout) (. run buffer-layout)))
    (let items (call stream-slice run rule (. run start) (call load-local attempt-end rule)))
    (let made (call frame captured-layout))
    (call put made items-field (. items operand) rule)
    (call put made result-field (. given operand) rule)
    (let wrapped (call wrap rule (call Typed made captured) type))
    (call return-value (. wrapped operand) rule)
    (call (. ir start-block) failed)
    (call return-value (. (call empty-optional type layout) operand) rule)
  )
  (fn-do _ adapt-arms Bool
    (param run StreamRun)
    (param site SyntaxId)
    (param result TypeId)
    (param end LocalId)
    (param joined IRBlockId)
    (param slot Operand)
    (param failed IRBlockId)
    ; In place of the arms of a pattern, one call of the function a local rule's arms run in, from
    ; where the pattern starts: where it passed it gives what it gave and ends where it ended,
    ; and where not the pattern fails.
    (let called (call lazy-rule-call run site adapting result (. run start) failed))
    (call store-local end (. called ending) site)
    (call arrive site (. called value operand) joined slot)
    (return true)
  )
  (fn-do + coded-rule SyntaxId
    (param call SyntaxId)
    ; The code of the local rule a call names whose body is code that runs patterns rather than a
    ; pattern, as the binder resolved the call, or none.
    (match? ([] (. tree nodes) (call rule-declaration call))
      (case (call .node-declare declaration)
        (if (and (. declaration is-pattern) (!= (. declaration right) 0) (not right-matches))
          (return (. declaration right))
        )
        (lazy right-matches (is ([] (. tree nodes) (. declaration right)) .node-stream-match))
      )
    )
    (return 0)
  )
  (fn-do + coded-call StreamPart
    (param run StreamRun)
    (param id SyntaxId)
    (param code SyntaxId)
    (param result TypeId)
    (param cursor Operand)
    (param failed IRBlockId)
    ; A call of a local rule whose body is code, as the reference calls the function it makes of
    ; it between the parts of a pattern: the stream is told the pattern stands at the cursor, then
    ; the code runs, each pattern in it on the stream from where the stream stands, and the
    ; pattern takes what it gave as `boundary-answer` says. The reference's function holds the
    ; names the code reads; here the code runs where it is called, where they are. A rule whose
    ; code calls it is refused.
    (let commit (call (. facts call-in-role) (. unit reading) id .role-commit))
    (let viewed (call (. facts call-in-role) (. unit reading) id .role-view))
    (if (or (== commit no-fact) (== viewed no-fact) (not (call holds-only id (list commit viewed))) coded-already)
      (call refuse .refused-expression id)
      (return (call bare-part cursor))
    )
    (lazy coded-already (!= (call (. coded find) code) null))
    (call call-protocol
      (block
        (arg id)
        (arg commit)
        (arg (. run stream))
        (arg (. run stream-type))
        (arg cursor)
        (arg (. types index-type))
        (arg true)
        (arg cursor)
        (arg (. types index-type))
      )
    )
    (let own-streaming streaming)
    (= streaming (= (. streaming given-stream) (. run stream)))
    (= streaming (= (. streaming given-stream-type) (. run stream-type)))
    (+= coded code)
    (let answer (call emit-expression code))
    (call (. coded pop))
    (= streaming own-streaming)
    (return (call boundary-answer run id viewed answer result cursor failed))
  )
  (fn-do + boundary-call StreamPart
    (param run StreamRun)
    (param id SyntaxId)
    (param result TypeId)
    (param cursor Operand)
    (param failed IRBlockId)
    ; A call of a function given the stream that is no rule, as the reference makes one between
    ; the parts of a pattern: the stream is told the pattern stands at the cursor, then the
    ; function is given the stream, converted as the type pass recorded, and the arguments
    ; written, and reads from the stream itself. The stream's view, asked for after, says where
    ; the function left it and how far it read, which the pattern counts as its own. Where the
    ; function gave a value the call gives it, as `boundary-answer` says, and goes on where the
    ; stream stands; where it gave none, the call fails. The rest of the attempt reads the buffer
    ; it read before, as the reference's does.
    (let nothing (call make-operand .operand-void 0))
    (let fact (call (. facts answer-call) (. unit reading) id .role-answer))
    (let commit (call (. facts call-in-role) (. unit reading) id .role-commit))
    (let viewed (call (. facts call-in-role) (. unit reading) id .role-view))
    (let written (call (of RowRange SyntaxId)))
    (match? ([] (. tree nodes) id)
      (case (call .node-stream-call row)
        (= written (. row args))
      )
    )
    (if (or (== fact no-fact) (== commit no-fact) (== viewed no-fact) (not (call holds-only id (list fact commit viewed))))
      (call refuse .refused-expression id)
      (return (call bare-part cursor))
    )
