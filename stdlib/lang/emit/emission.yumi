_ no-job U32 = U32.max
_ object-file-perms = user-read-perm + user-write-perm + group-read-perm + other-read-perm

━━━━━━━━━━━━━━━━━━━━
_ KeptLiterals is Tuple

` The string literals one function's code addresses, kept beside its record until the merge
` names them.

+ rows CPointer'StringLiteral
+ count U32

━━━━━━━━━━━━━━━━━━━━
_ WorkQueue

` The functions of a round, handed to workers heaviest first.

_ lock Mutex
_ positions [U32]
_ cursor Size

────────────────────
+ This
    - tables ProgramTables

. keys [U64]
for position in 0 .. < tables.functions.length
    . weight U64 = tables.functions[position].weight
    keys += (weight /lshift/ 32) /or/ (position as U64)
. sorted = sorted-pairs(keys)
for index in 0 .. < sorted.length
    positions += (sorted[sorted.length - 1 - index] /and/ 0xffffffff) as U32

────────────────────
+ do rewind

cursor = 0

────────────────────
+ do take U32

use lock
if cursor == positions.length
    = no-job
. position = positions[cursor]
cursor += 1
= position

━━━━━━━━━━━━━━━━━━━━
_ EmissionWorker

` One worker of the round: it emits a function's IR, builds its MIR, runs the backend's
` pipeline over it and keeps the record, all in its own arenas. With an emission memory the
` round takes two passes. The first emits and digests every function; one whose entry may be
` reused waits for the second, which reuses it or emits it again, once every function's IR is
` digested.

+ pipeline FunctionPipeline
+ lowering IRToMIR
+ inliner IRInliner
+ ir-digester IRDigester
+ mismatches [String]
+ verified U32
_ tables ProgramTables
_ queue WorkQueue
_ records CPointer'CompactFunction
_ literals CPointer'KeptLiterals
_ refusals CPointer'Refusal
_ ir-texts CPointer'ByteSpan
_ warnings CPointer'ByteSpan
_ counts CPointer'FunctionCounts
_ emitter Emitter
_ text IRText
_ seed MIRDigest
_ digester MIRDigester
_ digest MIRDigest
_ optimizes Bool
_ dumps-ir Bool
_ dumps-stages Bool
_ warns Bool
_ store RecordStore?
_ round ReuseRound?
_ reuses ReuseStore?
_ verifies Bool
_ deferred [U32]
_ deferred-places [U32]
_ mapped-strings IdList
_ mapped-marks [U32]

────────────────────
+ This
    - tables ProgramTables
    - program Program
    - instances Instances
    - facts Facts
    - types Types
    - bindings Bindings
    - queue WorkQueue
    - verdicts InlineVerdicts
    - records CPointer'CompactFunction
    - literals CPointer'KeptLiterals
    - refusals CPointer'Refusal
    - ir-texts CPointer'ByteSpan
    - warnings CPointer'ByteSpan
    - counts CPointer'FunctionCounts
    - seed MIRDigest
    - optimizes Bool
    - dumps-ir Bool
    - dumps-stages Bool
    - warns Bool
    - verifies Bool
    - store RecordStore?
    - round ReuseRound?
    - reuses ReuseStore?

.. pipeline = FunctionPipeline(tables.bundle)
.. emitter = Emitter(tables, program, instances, facts, types, bindings, pipeline.function.arena)
.. lowering = IRToMIR(tables, pipeline.builder, pipeline.results)
.. inliner = IRInliner
    - tables
    - program
    - instances
    - facts
    - types
    - bindings
    - verdicts
    - pipeline.function.arena
.. text = IRText(tables)
.. digester = MIRDigester(tables.bundle, pipeline.function)
.. ir-digester = IRDigester(tables, program, instances, facts, types, pipeline.results)

────────────────────
+ do release

emitter.release()
inliner.release()
pipeline.release()

────────────────────
+ do want-type-constants

` Notes the types whose constants the worker's code named.
for type in emitter.type-values
    tables.want-type-constant(type)
inliner.want-type-constants()

────────────────────
+ do emit-all

while true
    . position = queue.take()
    if position == no-job
        break
    compile(position)

────────────────────
+ do decide-all

` The second pass: each function that waited is reused, or emitted again where something it was
` made from changed. Then the entries the worker kept name what they consulted by key.
for index in 0 .. < deferred.length
    decide(deferred[index], deferred-places[index])
if reuses
    . shared = round!
    //+emit.round.settle
    reuses!.settle(shared.names, shared.contexts, shared.layout-keys)
    //-emit.round.settle

────────────────────
_ do compile
    - position U32

begin(position)
if tables.functions[position].kind == .process-main
    lowering.build-process-main(position)
    finish(position)
    =
. reusing = round
if reusing
    . shared = reusing
    shared.names[position] = ir-digester.name-key(position)
    shared.digests[position] = IRDigest(0, 0)
    shared.contexts[position] = IRDigest(0, 0)
if !emitted(position)
    =
if reusing
    . shared = reusing
    //+emit.round.ir-digest
    . made = ir-digester.digest(emitter.ir, emitter.bridged)
    shared.contexts[position] = ir-digester.context(position, made, emitter.bridged)
    //-emit.round.ir-digest
    shared.digests[position] = made
    . place = shared.memory.place(shared.names[position])
    if place != no-place
        . entry = shared.memory.entry(place)
        if same-digest(entry.ir, made) && same-digest(entry.context, shared.context)
            deferred += position
            deferred-places += place
            =
lower-emitted(position)

────────────────────
_ do decide
    - position U32
    - place U32

begin(position)
. entry = round!.memory.entry(place)
//+emit.round.reuse
. reusable = reusable(entry)
. done = reusable && !verifies && reuse(position, entry, place)
//-emit.round.reuse
if done
    =
emitted(position)
lower-emitted(position)
if reusable && verifies
    check(position, entry)

────────────────────
_ do begin
    - position U32

pipeline.function.reset()
pipeline.begin(dumps-stages)
pipeline.dumps-stages = dumps-stages
lowering.begin(position)

────────────────────
_ do emitted Bool
    - position U32

//+emit.round.emit
emitter.emit(position)
//-emit.round.emit
if emitter.is-refused
    refusals[position] = emitter.refusal
    = false
= true

────────────────────
_ do lower-emitted
    - position U32

` Inlines and lowers the function the emitter holds, and builds its record or finds it.
. function = pipeline.function
if emitter.bridged
    function.display-name = tables.functions[position].bridge-display
. built = if optimizes then inliner.run(emitter.ir) else emitter.ir
. warned = if optimizes && warns then inliner.warnings(built) else ""
if warned.size != 0
    . copy = pipeline.results.allocate-raw(warned.size)
    C:memcpy(copy, warned as CPointer'Byte, warned.size)
    warnings[position] = ByteSpan(copy, warned.size)
if dumps-ir
    text.out.clear()
    text.function-text(built)
    . copy = pipeline.results.allocate-raw(text.out.length)
    C:memcpy(copy, text.out.bytes.data, text.out.length)
    ir-texts[position] = ByteSpan(copy, text.out.length)
lowering.lower(built)
keep-literals(position, built)
if finish(position) && reuses
    . shared = round!
    . kept = literals[position]
    //+emit.round.keep
    reuses!.keep
        - shared.names[position]
        - shared.digests[position]
        - shared.context
        - digest
        - inliner
        - lowering
        - digester.strings
        - tables.bundle
        - kept.rows
        - kept.count
    //-emit.round.keep

────────────────────
_ do finish Bool
    - position U32

` Finds the function's record in the backend cache, or runs the backend's pipeline to build it.
` Whether the function has a record.
=? true if reused(position)
. function = pipeline.function
. built = false
if pipeline.lower()
    pipeline.dumps-stages = false
    . compact = pipeline.encode()
    name-literal-relocations(compact)
    records[position] = compact
    built = true
    if store
        store.keep(digest, compact, pipeline.counted, function.pool-size, digester.strings)
counts[position] = pipeline.counted
if dumps-stages && ir-texts[position].length != 0
    . staged = pipeline.finished-dump().text
    . joined = pipeline.results.allocate-raw(ir-texts[position].length + staged.length)
    C:memcpy(joined, ir-texts[position].data, ir-texts[position].length)
    C:memcpy(joined + ir-texts[position].length, staged.data, staged.length)
    ir-texts[position] = ByteSpan(joined, ir-texts[position].length + staged.length)
= built

────────────────────
_ do reused Bool
    - position U32

. kept = store
=? false if !kept
//+emit.round.mir-digest
digest = digester.digest(seed)
//-emit.round.mir-digest
. place = kept.cache.find(digest)
=? false if !place
. function = pipeline.function
. record = kept.reuse
    - place
    - pipeline.results
    - function.arena
    - function.order
    - function.pool-size
    - digester.strings
=? false if !record
records[position] = record
counts[position] = kept.cache.entry(place).counts
= true

────────────────────
_ do reusable Bool
    - entry ReuseEntry

` Whether a function an earlier round kept may be reused as it was: each function its inlining
` consulted reads as it did, each witness slot it looked up holds what it held, each string its
` record names is in the round's pool with the same facts, and each layout it marked is one the
` round has. It leaves the strings' ids and the marks for `reuse`.
. shared = round!
for index in 0 .. < entry.consult-count
    . consult = entry.consults[index]
    . found = shared.by-name.find(consult.name)
    if found == no-place || !same-digest(shared.contexts[found], consult.context)
        = false
. bundle = tables.bundle
. pool = shared.memory.pool(entry.pool)
for index in 0 .. < entry.slot-count
    . slot = entry.slots[index]
    . symbol = pool.mapped(slot.symbol, bundle)
    if symbol == no-string
        = false
    . target = tables.witness-slot-function(symbol, slot.offset)
    . key = if target != no-function then shared.names[target] else 0u64
    if key != slot.target
        = false
. arena = pipeline.function.arena
mapped-strings = new-id-list(arena, entry.string-count)
for index in 0 .. < entry.string-count
    . id = pool.mapped(entry.strings[index], bundle)
    if id == no-string || bundle.string-facts(id) != entry.facts[index]
        = false
    mapped-strings = mapped-strings.appended(arena, id)
mapped-marks.clear()
for index in 0 .. < entry.mark-count
    . mark = entry.marks[index]
    . value = if mark.kind == .plain-mark then mark.value as U32 else layout-place
        .. layout-place = shared.by-layout.find(mark.value)
    if value == no-place
        = false
    mapped-marks += packed-mark(mark.kind, value)
= true

────────────────────
_ do reuse Bool
    - position U32
    - entry ReuseEntry
    - place U32

` Takes a reusable function's record from the backend cache, with its literals and marks.
. kept = store!
. found = kept.cache.find(entry.mir)
=? false if !found
. function = pipeline.function
. record = kept.reuse
    - found
    - pipeline.results
    - function.arena
    - position
    - function.pool-size
    - mapped-strings
=? false if !record
records[position] = record
counts[position] = kept.cache.entry(found).counts
. rows = pipeline.results.allocate'StringLiteral(entry.literal-count)
for index in 0 .. < entry.literal-count
    rows[index] = entry.literals[index]
literals[position] = KeptLiterals(rows, entry.literal-count)
for packed in mapped-marks
    lowering.mark(mark-kind(packed), mark-value(packed))
reuses!.used += place
= true

────────────────────
_ do check
    - position U32
    - entry ReuseEntry

` Compares what a function deemed reusable gave when emitted, inlined and lowered again with
` what its entry kept, noting each part that differs.
verified += 1
. differs [String]
if digest.high != entry.mir.high || digest.low != entry.mir.low
    differs += "MIR"
. strings = digester.strings
. same-strings = strings.length == mapped-strings.length
if same-strings
    for index in 0 .. < strings.length
        if strings[index] != mapped-strings[index]
            same-strings = false
if !same-strings
    differs += "strings"
. marks = lowering.marks
. same-marks = marks.length == mapped-marks.length
if same-marks
    for index in 0 .. < marks.length
        if merged(marks[index]) != merged(mapped-marks[index])
            same-marks = false
if !same-marks
    differs += "marks"
. kept = literals[position]
. same-literals = kept.count == entry.literal-count
if same-literals
    for index in 0 .. < kept.count
        . made = kept.rows[index]
        . held = entry.literals[index]
        if facts-differ || made.bytes.length != held.bytes.length || bytes-differ
            same-literals = false
        .. facts-differ = made.character-length != held.character-length || made.flags != held.flags
        .. bytes-differ = C:memcmp(made.bytes.data, held.bytes.data, made.bytes.length) != 0
if !same-literals
    differs += "literals"
if differs.length != 0
    mismatches += "${tables.bundle.text(tables.functions[position].name)}: ${", ".join(differs)}"

────────────────────
_ merged U32
    - packed U32

` A mark as the merge takes it, which reads a layout as the one it shares its shape with.
if mark-kind(packed) == .plain-mark then packed else shared-mark

.. shared-mark = packed-mark(mark-kind(packed), tables.layouts.shared(mark-value(packed)))

────────────────────
_ do keep-literals
    - position U32
    - built IRFunction

. constants = built.constants
. count U32 = constants.length as U32
. rows = pipeline.results.allocate'StringLiteral(count)
for index in 0 .. < count
    . constant = constants[index]
    . length = constant.bytes.length
    . bytes = pipeline.results.allocate-raw(if length != 0 then length else 1)
    C:memcpy(bytes, constant.bytes.data, length)
    . kept = ByteSpan(bytes, length)
    rows[index] = StringLiteral(no-string, constant.character-length, constant.flags, kept)
literals[position] = KeptLiterals(rows, count)

────────────────────
_ do name-literal-relocations
    - compact CompactFunction

` A relocation against a literal names a label local to the function. It is renamed to the
` literal's index past the end of the string pool, which outlives the function's arena.
. function = pipeline.function
. pool = function.pool-size
for index in 0 .. < compact.relocation-count
    . relocation = compact.relocations[index]
    if relocation.symbol >= pool
        . name = function.local-names[relocation.symbol - pool]
        ?! Panic("A relocation names a label that is not a literal")
            if name.kind != .literal-name
        . literal = pool + name.index
        compact.relocations[index] = Relocation(relocation.offset, literal, relocation.kind)

────────────────────
+ do patch-all
    - names CPointer'U32
    - bases CPointer'U32

` Points each literal relocation of the round's records at the name the merge gave the
` literal.
. pool = pipeline.function.pool-size
while true
    . position = queue.take()
    if position == no-job
        break
    . compact = records[position]
    for index in 0 .. < compact.relocation-count
        . relocation = compact.relocations[index]
        if relocation.symbol >= pool
            . name = names[bases[position] + relocation.symbol - pool]
            compact.relocations[index] = Relocation(relocation.offset, name, relocation.kind)

━━━━━━━━━━━━━━━━━━━━
_ LiteralIndex

` The distinct literals of the object so far, found by their bytes.

_ bundle Bundle
_ arena Arena
_ slots CPointer'U32
_ capacity U32
_ count U32

────────────────────
+ This
    - bundle Bundle
    - arena Arena

capacity = 256
slots = arena.allocate'U32(capacity)

────────────────────
+ do find U32
    - bytes ByteSpan

` The name of the literal with these bytes, or nothing.
. mask = capacity - 1
. slot = hash(bytes) /and/ mask
while slots[slot] != 0
    . literal = bundle.literals[slots[slot] - 1]
    if literal.bytes.length == bytes.length
        if C:memcmp(literal.bytes.data, bytes.data, bytes.length) == 0
            = literal.name
    slot = (slot + 1) /and/ mask
= no-string

────────────────────
+ do add
    - row U32

if (count + 1) * 2 > capacity
    . old-slots = slots
    . old-capacity = capacity
    capacity = old-capacity * 2
    slots = arena.allocate'U32(capacity)
    for index in 0 .. < old-capacity
        if old-slots[index] != 0
            place(old-slots[index] - 1)
place(row)
count += 1

────────────────────
_ do place
    - row U32

. mask = capacity - 1
. slot = hash(bundle.literals[row].bytes) /and/ mask
while slots[slot] != 0
    slot = (slot + 1) /and/ mask
slots[slot] = row + 1

────────────────────
_ hash U32
    - bytes ByteSpan

((wide /xor/ (wide /zrshift/ 32)) /and/ 0xffffffff) as U32

.. wide = fnv-hash(bytes.data, bytes.length)

━━━━━━━━━━━━━━━━━━━━
+ EmissionOptions

` How a program is emitted. Unless it `optimizes`, no call is inlined and
` every GC-free zone keeps its brackets. A batch names the files its runtime writes: the marks of its cases, and
` what they print; and for each root the id of its case and the directory it runs in.

+ object-path String
+ writes-object = true
+ worker-count Int
+ optimizes = true
+ warns Bool
+ dumps-ir Bool
+ dumps-stages Bool
+ batch-control = ""
+ batch-output = ""
+ batch-errors = ""
+ batch-ids [String]
+ batch-directories [String]
+ catalog-path = ""
+ unmatched-probes [String]
+ backend-cache BackendCache?
+ memory EmissionMemory?
+ verifies-reuse Bool
+ tables-time Microseconds
+ round-time Microseconds
+ merge-time Microseconds
+ object-time Microseconds

━━━━━━━━━━━━━━━━━━━━
+ do emit-program ?! Error
    - program Program
    - instances Instances
    - facts Facts
    - types Types
    - bindings Bindings
    - options EmissionOptions

` Compiles a sealed program to an object file: program tables, one round of emission over
` the worker pool, the merge of the round's literals and of the GC descriptors its code
` names, and the object. A program holding a construct emission has no shape for is refused
` whole, before anything is written; a batch is refused with each such construct of its cases.
. started = clock()
//+compiler.phase.tables
. tables = use ProgramTables(program, instances, facts, types, bindings)
?! Error("A batch names a case for each of its roots")
    if options.batch-ids.length != program.batch-roots.length || unmatched-directories
.. unmatched-directories = options.batch-directories.length != program.batch-roots.length
tables.batch-control = options.batch-control
tables.batch-output = options.batch-output
tables.batch-errors = options.batch-errors
tables.batch-ids = options.batch-ids
tables.batch-directories = options.batch-directories
tables.build()
//-compiler.phase.tables
options.tables-time = started.elapsed'Microseconds()
if tables.refusals.length != 0
    . lines [String]
    for position in 0 .. < tables.refusals.length
        if lines.length == 0 || program.is-batch
            lines += refusal-line(program, tables.refusals[position])
    ?! Error("\n".join(lines))
if program.probes.is-enabled
    options.unmatched-probes = unmatched-probe-selectors(program, tables)
    if options.catalog-path != ""
        write-probe-catalog(options.catalog-path, program, tables, options.unmatched-probes)
if options.optimizes
    bound-free(tables, program, instances, facts, types, bindings)
tables.bundle.note-alignments()

. function-count U32 = tables.functions.length as U32
. count = if options.worker-count > 0 then options.worker-count else default-worker-count
if count > function-count
    count = function-count
. arena = use Arena()
. records = arena.allocate'CompactFunction(function-count)
. literals = arena.allocate'KeptLiterals(function-count)
. refusals = arena.allocate'Refusal(function-count)
. ir-texts = arena.allocate'ByteSpan(function-count)
. warnings = arena.allocate'ByteSpan(function-count)
. counts = arena.allocate'FunctionCounts(function-count)
. round-started = clock()
//+compiler.phase.emission
//!emit.gc-objects . gc-objects-before = C:yumiGCAllocatedObjectCount()
. queue = WorkQueue(tables)
. verdicts = InlineVerdicts
    - arena.allocate'Byte(function-count)
    - arena.allocate'Byte(function-count)
    - arena.allocate'Byte(function-count)
. cache = options.backend-cache
. seed = bundle-seed(tables.bundle)
if cache
    cache.begin-round(count)
. memory = options.memory if cache && !options.dumps-ir && !options.warns
. reusing ReuseRound?
if memory
    memory.begin-round(count)
    . context = IRDigester(tables, program, instances, facts, types, arena).round-context
        - seed
        - options.optimizes
    reusing = ReuseRound(memory, context, function-count, tables.layouts.count, arena)
. workers [EmissionWorker]
for index in 0 .. < count
    workers += EmissionWorker
        - tables
        - program
        - instances
        - facts
        - types
        - bindings
        - queue
        - verdicts
        - records
        - literals
        - refusals
        - ir-texts
        - warnings
        - counts
        - seed
        - options.optimizes
        - options.dumps-ir
        - options.dumps-stages
        - options.warns
        - options.verifies-reuse
        - cache.store-for(index) if cache && !options.dumps-ir
        - reusing
        - memory.store-for(index) if memory
do finally
    for worker in workers
        worker.release()

. pool = Worker(count)
. finished SyncBufferedChannel'Bool
for worker in workers
    do (pool) new
        worker.emit-all()
        finished <- true
for _ in 0 .. < count
    <- finished
if reusing
    . digesters [IRDigester]
    for worker in workers
        digesters += worker.ir-digester
    //+emit.round.index
    reusing.index(digesters, function-count, tables.layouts.count)
    //-emit.round.index
    //+emit.round.second
    for worker in workers
        do (pool) new
            worker.decide-all()
            finished <- true
    for _ in 0 .. < count
        <- finished
    //-emit.round.second
    . mismatches [String]
    for worker in workers
        memory!.verified += worker.verified as U64
        mismatches ++= worker.mismatches
    if mismatches
        pool.stop()
        ?! Error("Reuse differs from emitting again:\n${"\n".join(mismatches)}")
//emit.gc-objects += C:yumiGCAllocatedObjectCount() - gc-objects-before
//-compiler.phase.emission
options.round-time = round-started.elapsed'Microseconds()

if options.dumps-ir
    for position in 0 .. < function-count
        . text = ir-texts[position]
        if text.length != 0
            stderr <- Array'Byte(text.data, text.length).slice-string(0 .. < text.length)
. warned [U32]
for position in 0 .. < function-count
    if warnings[position].length != 0
        . finish = tables.finish-of(position as U32)
        . place = warned.length
        while place > 0 && tables.finish-of(warned[place - 1]) > finish
            place -= 1
        warned.insert(position, place)
for position in warned
    . text = warnings[position]
    stderr <- "${Array'Byte(text.data, text.length).slice-string(0 .. < text.length)}\n"
. lines [String]
for position in 0 .. < function-count
    if refusals[position].construct != .refused-nothing && (lines.length == 0 || program.is-batch)
        lines += refusal-line(program, refusals[position])
if lines
    pool.stop()
    ?! Error("\n".join(lines))
if !options.writes-object
    pool.stop()
    =

. merge-started = clock()
//+compiler.phase.merge
. ordered = reached(tables.bundle, records, symbol-order(tables.bundle, records, function-count))
for position in ordered
    //compiler.mir.functions += counts[position].functions
    //compiler.mir.blocks += counts[position].blocks
    //compiler.mir.instructions += counts[position].instructions
    //compiler.mir.frame-bytes += counts[position].frame-bytes
. bases = arena.allocate'U32(function-count)
. total U32
for position in 0 .. < function-count
    bases[position] = total
    total += literals[position].count
. names = arena.allocate'U32(total)
name-literals(tables.bundle, arena, literals, ordered, bases, names)
. layouts = tables.layouts
. described [LayoutId]
. buffered [LayoutId]
for layout in 0 .. < layouts.count
    for worker in workers
        if worker.lowering.used[layout] != 0
            described += layouts.shared(layout)
            break
    for worker in workers
        if worker.lowering.buffers[layout] != 0
            buffered += layouts.shared(layout)
            break
. descriptors = sort(described) • using :: a, b => layouts.descriptor-order(a, b)
for layout in descriptors
    layouts.add-descriptor(layout)
. buffers = sort(buffered) • using :: a, b => layouts.descriptor-order(a, b)
for layout in buffers
    layouts.add-buffer-descriptor(layout)
. allocated [LayoutId]
for layout in 0 .. < layouts.count
    for worker in workers
        if worker.lowering.allocated[layout] != 0
            allocated += layouts.shared(layout)
            break
. sites = sort(allocated) • using :: a, b => layouts.descriptor-order(a, b)
. next U32 = 1
. previous = no-layout
for layout in sites
    if layout == previous
        continue
    previous = layout
    layouts.add-site-key(layout, if next <= compiler-buffer-count then next else 0u32)
    next += 1
for slot in 0 .. < plain-site-count
    for worker in workers
        if worker.lowering.plain-allocated[slot] != 0
            layouts.add-plain-site-key
                - (slot as U64) * 8
                - if next <= compiler-buffer-count then next else 0u32
            next += 1
            break
for worker in workers
    worker.want-type-constants()
tables.add-type-constants()

queue.rewind()
for worker in workers
    do (pool) new
        worker.patch-all(names, bases)
        finished <- true
for _ in 0 .. < count
    <- finished
pool.stop()
//-compiler.phase.merge
options.merge-time = merge-started.elapsed'Microseconds()

. object-started = clock()
//+compiler.phase.object
order-data(tables.bundle)
. builder = use ObjectBuilder(tables.bundle)
builder.build(records, ordered)
write-object(options.object-path, object-file(builder, program.target))
cache?.finish-round()
//+emit.round.remember
memory?.finish-round(tables.bundle)
//-emit.round.remember
//-compiler.phase.object
options.object-time = object-started.elapsed'Microseconds()

━━━━━━━━━━━━━━━━━━━━
_ do bound-free
    - tables ProgramTables
    - program Program
    - instances Instances
    - facts Facts
    - types Types
    - bindings Bindings

` Finds the functions that run where the collector never sees it and reach no safepoint in a
` bounded time, as the reference elides the zone around calls of them. Each that cannot panic
` is emitted once, and is one where it has no loop, does not yield, and calls only C functions
` with no step out of the zone around them and functions so found, settled from the leaves up.
. storage = use Arena()
. emitter = use Emitter(tables, program, instances, facts, types, bindings, storage)
. count = tables.functions.length
. symbols = U32[tables.bundle.string-count]
for position in 0 .. < count
    . named = tables.functions[position].symbol
    if named < tables.bundle.string-count
        symbols[named] = (position as U32) + 1
. wanted = Bool[count]
for position in 0 .. < count
    wanted[position] = free-candidate(tables, instances, position as FunctionId)
. candidates [U32]
. starts [U32]
. ends [U32]
. targets [U32]
for position in 0 .. < count
    if !wanted[position]
        continue
    storage.reset()
    emitter.emit(position as FunctionId)
    if emitter.is-refused || emitter.bridged
        continue
    . ir = emitter.ir
    . first = targets.length
    . fits = is-acyclic(ir)
    for row in ir.instructions
        if row.op == .op-yield
            fits = false
        else if row.op == .op-call || row.op == .op-call-void
            . kind = row.aux /and/ callee-kind-mask
            if kind == CalleeKind.callee-function
                . target = ir.operands[row.operands.start]
                . symbol = operand-payload(target)
                . called = if is-symbol && in-range then symbols[symbol] else 0u32
                    .. is-symbol = operand-kind(target) == .operand-symbol
                    .. in-range = symbol < tables.bundle.string-count
                if called == 0 || !wanted[called - 1]
                    fits = false
                else
                    targets += called - 1
            else if kind != CalleeKind.callee-c
                fits = false
        if !fits
            break
    if fits
        candidates += position as U32
        starts += first as U32
        ends += targets.length as U32
    else
        while targets.length > first
            targets.pop()
. settled = Bool[count]
. changed = true
while changed
    changed = false
    for index in 0 .. < candidates.length
        . position = candidates[index]
        if settled[position]
            continue
        . ready = true
        for edge in starts[index] .. < ends[index]
            if !settled[targets[edge]]
                ready = false
                break
        if ready
            settled[position] = true
            changed = true
for position in candidates
    if settled[position]
        tables.mark-bounded(tables.functions[position].instance)

━━━━━━━━━━━━━━━━━━━━
_ do is-acyclic Bool
    - ir IRFunction

` Whether no path through a body comes back to a block it is still on.
. count = ir.blocks.length
if count == 0 || ir.order.length == 0
    = true
. starts [U32]
. targets [U32]
for block in 0 .. < count
    starts += targets.length as U32
    . rows = ir.blocks[block].instructions
    for id in rows.start .. < rows.end
        . row = ir.instructions[id]
        if row.op != .op-phi
            for position in row.operands.start .. < row.operands.end
                . operand = ir.operands[position]
                if operand-kind(operand) == .operand-block
                    targets += operand-payload(operand)
starts += targets.length as U32
. states = Byte[count]
. path [U32]
. edges [U32]
. entry = ir.order[0]
states[entry] = 1
path += entry
edges += starts[entry]
while path.length != 0
    . block = path[path.length - 1]
    . edge = edges[edges.length - 1]
    if edge < starts[block + 1]
        edges[edges.length - 1] = edge + 1
        . next = targets[edge]
        if states[next] == 1
            = false
        if states[next] == 0
            states[next] = 1
            path += next
            edges += starts[next]
        continue
    states[block] = 2
    path.pop()
    edges.pop()
= true

━━━━━━━━━━━━━━━━━━━━
_ free-candidate Bool
    - tables ProgramTables
    - instances Instances
    - position FunctionId

|? function.kind != .instance-body || function.instance == no-instance
    false
|? may-collect || row.is-generator || row.may-panic || row.polls
    false
??
    infallible && tables.instance-functions[instance] == position

.. function = tables.functions[position]
.. instance = function.instance
.. row = instances.rows[instance]
.. may-collect = (row.effects /and/ CompilationEffect.gc-free) == 0
.. infallible = instances.signatures[instance].errors.count == 0

━━━━━━━━━━━━━━━━━━━━
_ do name-literals
    - bundle Bundle
    - arena Arena
    - literals CPointer'KeptLiterals
    - ordered [U32]
    - bases CPointer'U32
    - names CPointer'U32

` Names the object's string literals in the order the object holds the functions, each text
` once. The count of names is a running one, so this is serial; it touches each literal once.
. index = LiteralIndex(bundle, arena)
. named U32
for position in ordered
    . kept = literals[position]
    for offset in 0 .. < kept.count
        . row = kept.rows[offset]
        . name = index.find(row.bytes)
        if name == no-string
            named += 1
            name = bundle.intern(if named == 1 then "str" else "str$named")
            . added U32 = bundle.literals.length as U32
            bundle.literals.append(StringLiteral(name, row.character-length, row.flags, row.bytes))
            index.add(added)
        names[bases[position] + offset] = name

━━━━━━━━━━━━━━━━━━━━
_ do symbol-order [U32]
    - bundle Bundle
    - records CPointer'CompactFunction
    - count U32

` The functions in the order of their symbols, which the object holds them in: an order that
` does not depend on the order the program tables declared them in, nor typing reached them.
. names [String]
for position in 0 .. < count
    names += bundle.text(records[position].symbol)
= name-order(names)

━━━━━━━━━━━━━━━━━━━━
_ do order-data
    - bundle Bundle

` Puts the literals and the constant tables in the order of their names, which the object holds
` them in, as it holds the functions in the order of their symbols: an order that does not
` depend on the order the program tables, the workers and the merge added them in.
. literals [StringLiteral]
. literal-names [String]
for literal in bundle.literals
    literals += StringLiteral(literal.name, literal.character-length, literal.flags, literal.bytes)
    literal-names += bundle.text(literal.name)
bundle.literals.clear()
for position in name-order(literal-names)
    bundle.literals.append(literals[position])
. tables [ConstantTable]
. table-names [String]
for table in bundle.constant-tables
    tables += ConstantTable(table.name, table.alignment, table.items)
    table-names += bundle.text(table.name)
bundle.constant-tables.clear()
for position in name-order(table-names)
    bundle.constant-tables.append(tables[position])

━━━━━━━━━━━━━━━━━━━━
_ do name-order [U32]
    - names [String]

` The places of the names given, in the order of the names: a merge sort, so names that are the
` same keep their order.
. count U32 = names.length as U32
. order [U32]
. spare [U32]
for position in 0 .. < count
    order += position
    spare += 0
. width = 1u32
while width < count
    . start = 0u32
    while start < count
        . middle = if start + width < count then start + width else count
        . end = if middle + width < count then middle + width else count
        . left = start
        . right = middle
        for position in start .. < end
            if left < middle && (right >= end || names[order[right]] >= names[order[left]])
                spare[position] = order[left]
                left += 1
            else
                spare[position] = order[right]
                right += 1
        start = end
    . merged = order
    order = spare
    spare = merged
    width *= 2
= order

━━━━━━━━━━━━━━━━━━━━
_ do reached [U32]
    - bundle Bundle
    - records CPointer'CompactFunction
    - ordered [U32]

` The functions the object holds, in their order: those named outside it, those a constant
` table names, and those the code of one held names in turn. A function whose every call was
` inlined is not held, as the reference's optimizer drops it.
. owners = U32[bundle.string-count]
for position in ordered
    . symbol = records[position].symbol
    if symbol < bundle.string-count
        owners[symbol] = position + 1
. kept = Bool[ordered.length]
. pending [U32]
for position in ordered
    . record = records[position]
    if record.is-external || !record.is-encoded
        kept[position] = true
        pending += position
for item in bundle.constant-items
    if item.kind == .label-constant && item.name < bundle.string-count
        . owner = owners[item.name]
        if owner != 0 && !kept[owner - 1]
            kept[owner - 1] = true
            pending += owner - 1
. next = 0
while next < pending.length
    . record = records[pending[next]]
    next += 1
    for index in 0 .. < record.relocation-count
        . symbol = record.relocations[index].symbol
        if symbol < bundle.string-count
            . owner = owners[symbol]
            if owner != 0 && !kept[owner - 1]
                kept[owner - 1] = true
                pending += owner - 1
if pending.length == ordered.length
    = ordered
. held [U32]
for position in ordered
    if kept[position]
        held += position
= held

━━━━━━━━━━━━━━━━━━━━
_ refusal-line String
    - program Program
    - refusal Refusal

"${module.path}:$line:${begin.column + 1}: Not supported by emission: $construct"

.. module = program.modules[refusal.module]
.. begin = module.tree.nodes[refusal.syntax].loc.begin
.. construct = refusal-texts[refusal.construct]
.. line = begin.line + 1

━━━━━━━━━━━━━━━━━━━━
_ do write-object ?! Error
    - path String
    - contents ByteSpan

. mode = FileFlags.write-mode + FileFlags.create-mode + FileFlags.truncate-mode
. file = use File(path, mode, object-file-perms)
if contents.length != 0
    file.write(Array'Byte(contents.data, contents.length), contents.length)
