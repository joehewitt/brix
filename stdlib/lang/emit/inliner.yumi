+ This
    - source IRFunction
    - lists SpliceLists

.. heads = lists.heads
.. tails = lists.tails
.. values = lists.values
.. arguments = lists.arguments
.. phi-values = lists.phi-values
.. phi-blocks = lists.phi-blocks
.. returned = lists.returned
.. arrived = lists.arrived
.. only = lists.only
.. forwards = lists.forwards
.. warm = lists.warm
for _ in 0 .. < source.instructions.length
    values += 0

━━━━━━━━━━━━━━━━━━━━
_ Level

+ ir IRFunction
+ fused U32
+ uses [U32]
+ marks [U32]
+ dead [Bool]
+ skips [IRBlockId]

────────────────────
+ This
    - ir IRFunction
    - fused U32

for _ in 0 .. < ir.instructions.length
    uses += 0
    marks += 0
    dead += false
for _ in 0 .. < ir.blocks.length
    skips += no-block
for id in 0 .. < ir.instructions.length
    . row = ir.instructions[id]
    for position in row.operands.start .. < row.operands.end
        . operand = ir.operands[position]
        if operand-kind(operand) == .operand-value
            uses[operand-payload(operand)] += 1

