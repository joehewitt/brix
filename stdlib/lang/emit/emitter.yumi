────────────────────
_ do row-value Typed
    - id SyntaxId
    - cursor TableCursor
    - row TypeId

` A row of a table made a value from where it lies: the columns, left out where the table
` grows, the index, and the table's metadata; a finished table's row holds its columns and
` its index alone.
. none = make-operand(.operand-void, 0)
. layout = layout-of(row, id)
. made = frame(layout)
made-rows += MadeRow(made, cursor)
if is-immutable-view(intrinsic(row))
    put
        - made
        - tables.layouts.field(layout, 0)
        - num-cast(id, cursor.columns, pointer-layout, managed-layout)
        - id
    put(made, tables.layouts.field(layout, 1), cursor.index, id)
    = Typed(made, row)
put(made, tables.layouts.field(layout, 0), view-columns(id, cursor.meta, cursor.columns), id)
put(made, tables.layouts.field(layout, 1), cursor.index, id)
put-meta(id, made, layout, 2, cursor.meta)
= Typed(made, row)

────────────────────
_ do made-row U32
    - value Operand

` Where among `made-rows` a value is, or `U32.max` where it is none of them.
. position = made-rows.length
while position != 0
    position -= 1
    if made-rows[position].value == value
        = position as U32
= U32.max

────────────────────
_ do emit-table-span Typed
    - id SyntaxId
    - object SyntaxId
    - key SyntaxId

` The rows a range spans of a table made a span at `t[a .. < b]`, as TypeScript makes it: the
` columns, left out where the table grows, the start of the range made forward, its length,
` and the table's metadata; and the items a range spans of a view of a field's column, a view
` of them. The range is not checked against the table's length. A finished table's span holds
` no metadata.
. none = make-operand(.operand-void, 0)
. held = emit-expression(object)
. type = held.type
. range = emit-expression(key)
. range-type = range.type
= span-of(id, held.operand, type, range.operand, range-type, object, facts.node-type(unit.reading, id))

────────────────────
_ do span-of Typed
    - id SyntaxId
    - held Operand
    - type TypeId
    - range Operand
    - range-type TypeId
    - object SyntaxId
    - span TypeId

` The span or the view of type `span` a range indexes a table or a view of one by at `id`, as
` `emit-table-span` says.
. none = make-operand(.operand-void, 0)
. kind = intrinsic(type)
if !is-row-source(kind) && kind != .table-column && kind != .immutable-table-column
    refuse(.refused-expression, id)
    = Typed(none, no-type)
. layout = layout-of(type, id)
. span-layout = layout-of(span, id)
if kind == .table-column || kind == .immutable-table-column
    = column-span(id, held, type, layout, range, range-type, object, span-layout)
if is-immutable-view(kind)
    = immutable-span(id, held, type, layout, range, range-type, object, span, span-layout)
. meta = if kind == .table then table-meta(id, held, layout) else span-meta(id, held, layout)
. columns = if kind == .table then table-columns(id, held, layout, meta) else span-columns(id, held, layout, meta)
. bounds = range-bounds(id, range, range-type, held, type, object)
. start = if kind == .table then bounds.start else arithmetic(id, .arithmetic-add, part(held, layout, 1, id).operand, bounds.start, u64-layout)
. made = frame(span-layout)
put(made, tables.layouts.field(span-layout, 0), view-columns(id, meta, columns), id)
put(made, tables.layouts.field(span-layout, 1), start, id)
put(made, tables.layouts.field(span-layout, 2), bounds.length, id)
put-meta(id, made, span-layout, 3, meta)
= Typed(made, span)

────────────────────
_ do immutable-span Typed
    - id SyntaxId
    - held Operand
    - type TypeId
    - layout LayoutId
    - range Operand
    - range-type TypeId
    - object SyntaxId
    - span TypeId
    - span-layout LayoutId

` The rows a range spans of a finished table or of a span of one, as TypeScript makes their
` span: the columns, the range's start moved on by the span's offset, and its length.
. source = table-source(id, held, type, layout)
. bounds = range-bounds(id, range, range-type, held, type, object)
. made = frame(span-layout)
put
    - made
    - tables.layouts.field(span-layout, 0)
    - num-cast(id, source.columns, pointer-layout, managed-layout)
    - id
put
    - made
    - tables.layouts.field(span-layout, 1)
    - arithmetic(id, .arithmetic-add, source.offset, bounds.start, u64-layout)
    - id
put(made, tables.layouts.field(span-layout, 2), bounds.length, id)
= Typed(made, span)

────────────────────
_ do column-span Typed
    - id SyntaxId
    - column Operand
    - type TypeId
    - layout LayoutId
    - range Operand
    - range-type TypeId
    - object SyntaxId
    - span-layout LayoutId

` The items a range spans of a view of a field's column, as TypeScript makes their view: its
` data moved on to the range's start, left out where the table grows, the range's length, and
` the view's table, column and offset, moved on to the start, with its metadata. That of a
` finished table's view is its data moved on and the range's length.
. none = make-operand(.operand-void, 0)
. item-layout = layout-of(viewed-item(type), id)
if intrinsic(type) == .immutable-table-column
    . held = part-address(id, column, layout, 0)
    . spanned = range-bounds(id, range, range-type, column, type, object)
    . viewed = frame(span-layout)
    put
        - viewed
        - tables.layouts.field(span-layout, 0)
        - num-cast
            - id
            - item-cell(id, held.operand, spanned.start, item-layout)
            - pointer-layout
            - managed-layout
        - id
    put(viewed, tables.layouts.field(span-layout, 1), spanned.length, id)
    = Typed(viewed, type)
. meta = column-meta(id, column, layout)
. data = column-data(id, column, layout, meta, item-layout)
. bounds = range-bounds(id, range, range-type, column, type, object)
. offset = arithmetic(id, .arithmetic-add, part(column, layout, 5, id).operand, bounds.start, u64-layout)
. made = frame(span-layout)
put
    - made
    - tables.layouts.field(span-layout, 0)
    - view-columns(id, meta, item-cell(id, data.operand, bounds.start, item-layout))
    - id
put(made, tables.layouts.field(span-layout, 1), bounds.length, id)
put(made, tables.layouts.field(span-layout, 2), meta.header, id)
put(made, tables.layouts.field(span-layout, 3), part(column, layout, 3, id).operand, id)
put(made, tables.layouts.field(span-layout, 4), part(column, layout, 4, id).operand, id)
put(made, tables.layouts.field(span-layout, 5), offset, id)
put(made, tables.layouts.field(span-layout, 6), meta.owner, id)
put(made, tables.layouts.field(span-layout, 7), meta.incarnation, id)
put(made, tables.layouts.field(span-layout, 8), meta.generation, id)
put(made, tables.layouts.field(span-layout, 9), meta.shrink, id)
= Typed(made, type)

────────────────────
_ do range-bounds TableBounds
    - id SyntaxId
    - range Operand
    - range-type TypeId
    - view Operand
    - held TypeId
    - object SyntaxId

` Where a range indexing a table or a view of one starts and how many rows or items it spans,
` from the range made forward.
. none = make-operand(.operand-void, 0)
. forward = forward-range(id, range, range-type, view, held, object)
. forward-type = forward.type
. forward-layout = layout-of(forward-type, id)
. start = range-index(id, forward.operand, forward-type, forward-layout, "start")
. end = range-index(id, forward.operand, forward-type, forward-layout, "end")
= TableBounds(start.operand, arithmetic(id, .arithmetic-subtract, end.operand, start.operand, u64-layout))

────────────────────
_ do emit-table-item Typed
    - id SyntaxId
    - object SyntaxId
    - key SyntaxId

` An item of a view of a field's column read at `f[i]`, as TypeScript reads it: the view, then
` the index, converted to one; the data is found, and the index checked against the view's
` length. A view of a finished table holds its data itself.
. none = make-operand(.operand-void, 0)
. column = emit-expression(object)
. type = column.type
. index = convert(key, .reason-argument, emit-expression(key))
if index.type != types.index-type
    refuse(.refused-expression, id)
    = Typed(none, no-type)
= column-item(id, column.operand, type, index.operand)

────────────────────
_ do column-item Typed
    - id SyntaxId
    - column Operand
    - type TypeId
    - index Operand

` The item at an index of a view of a field's column, as `emit-table-item` reads it.
. none = make-operand(.operand-void, 0)
. immutable = intrinsic(type) == .immutable-table-column
if intrinsic(type) != .table-column && !immutable
    refuse(.refused-expression, id)
    = Typed(none, no-type)
. layout = layout-of(type, id)
. item = viewed-item(type)
. item-layout = layout-of(item, id)
. data = if immutable then part-address(id, column, layout, 0) else column-data(id, column, layout, column-meta(id, column, layout), item-layout)
. named = if immutable then "ImmutableTableField" else "TableField"
fail-if
    - id
    - compare(id, .compare-greater-equal, index, part(column, layout, 1, id).operand)
    - "$named index is out of bounds"
= Typed(take(item-cell(id, data.operand, index, item-layout), LayoutField(0, item-layout, item), id), item)

────────────────────
_ do emit-table-item-store
    - id SyntaxId
    - object SyntaxId
    - key SyntaxId
    - rhs SyntaxId

` `f[i] = v` of a view of a field's column, as TypeScript stores it: the value is read, then the
` view and the index, converted to one; the data is found, the index checked against the view's
` length, and the value, converted to the item's type, stored; where the table grows its
` mutation generation is then counted on.
if table-op(id) != TableOp.table-item-store
    refuse(.refused-statement, id)
    =
. emitted = emit-expression(rhs)
. given = apart(emitted, rhs, !is-inert(object) || !is-inert(key))
. given-type = emitted.type
. column = emit-expression(object)
. type = column.type
. index = convert(key, .reason-argument, emit-expression(key))
if index.type != types.index-type
    refuse(.refused-conversion, key)
if intrinsic(type) != .table-column
    refuse(.refused-statement, id)
. layout = layout-of(type, id)
. item = viewed-item(type)
. item-layout = layout-of(item, id)
. meta = column-meta(id, column.operand, layout)
. data = column-data(id, column.operand, layout, meta, item-layout)
fail-if
    - id
    - compare(id, .compare-greater-equal, index.operand, part(column.operand, layout, 1, id).operand)
    - "TableField index is out of bounds"
. value = convert(rhs, .reason-argument, Typed(given, given-type))
if value.type != item
    refuse(.refused-conversion, rhs)
store-cell(id, item-cell(id, data.operand, index.operand, item-layout), item-layout, value.operand)
invalidate-marks(id, meta)

────────────────────
_ do emit-table-zip Typed
    - id SyntaxId
    - lhs SyntaxId
    - rhs SyntaxId

` Views of fields' columns added, as TypeScript adds them: the tuple of the views each side is
` or holds, the left side's first.
. none = make-operand(.operand-void, 0)
. emitted = emit-expression(lhs)
. left = apart(emitted, lhs, !is-inert(rhs))
. left-type = emitted.type
. right = emit-expression(rhs)
. right-type = right.type
. type = facts.node-type(unit.reading, id)
. layout = layout-of(type, id)
. made = frame(layout)
. next = zip-parts(id, made, layout, 0, left, left-type)
zip-parts(id, made, layout, next, right.operand, right-type)
= Typed(made, type)

────────────────────
_ do zip-parts U32
    - site SyntaxId
    - made Operand
    - layout LayoutId
    - at U32
    - value Operand
    - type TypeId

` Puts in the tuple of views, from the field at `at`, a view or the views a tuple holds, and
` answers the field after them.
if intrinsic(type) == .table-column
    put(made, tables.layouts.field(layout, at), value, site)
    = at + 1
. held = layout-of(type, site)
. count = tables.layouts.rows[held].fields.count
for position in 0 .. < count
    . field = tables.layouts.field(held, position)
    put(made, tables.layouts.field(layout, at + position), take(value, field, site), site)
= at + count

────────────────────
_ do zip-span Typed
    - site SyntaxId
    - value Operand
    - from TypeId
    - to TypeId

` The tuple of views of fields' columns cast to a span of the rows they make, as TypeScript
` casts it: the views' lengths must agree, and a directory is made of where each view's items
` start; the span starts at its first row, is as long as the first view, and is of a table
` that does not grow.
. layout = layout-of(from, site)
. span-layout = layout-of(to, site)
. count = tables.layouts.rows[layout].fields.count
. first = tables.layouts.field(layout, 0)
. length = column-length(site, take(value, first, site), first.layout)
for position in 1 .. < count
    . field = tables.layouts.field(layout, position)
    . other = column-length(site, take(value, field, site), field.layout)
    fail-if
        - site
        - compare(site, .compare-not-equal, length.operand, other.operand)
        - "Table column zip lengths must match"
. starts [Operand]
for position in 0 .. < count
    . field = tables.layouts.field(layout, position)
    . column = take(value, field, site)
    . item-layout = layout-of(viewed-item(field.type), site)
    . data = column-data
        - site
        - column
        - field.layout
        - column-meta(site, column, field.layout)
        - item-layout
    starts += data.operand
. directory = table-buffer(site, managed-layout, integer(.machine-u64, count))
for position in 0 .. < count
    store(directory, position * 8, starts[position], false, site)
. zero = integer(.machine-u64, 0)
. made = frame(span-layout)
put(made, tables.layouts.field(span-layout, 0), directory, site)
put(made, tables.layouts.field(span-layout, 1), zero, site)
put(made, tables.layouts.field(span-layout, 2), length.operand, site)
put-meta(site, made, span-layout, 3, TableMeta(zero, zero, zero, zero, zero))
= Typed(made, to)

────────────────────
_ do emit-table-range-store
    - id SyntaxId
    - object SyntaxId
    - key SyntaxId
    - rhs SyntaxId

` `t[a .. < b] = s` of a table, of a span of one or of a view of a field's column, as
` TypeScript copies it: the source is read, then the target and the range; the rows of the
` target are found, then those of the source, and the range is made forward; each column of
` the source is copied from its first row into the target's from the range's start, as many
` rows as the range spans, with no check of either's length; where the target's table grows
` its mutation generation is then counted on. Rows of unions are copied one at a time, from
` the last where the source shares the target's columns and starts below it.
. emitted = emit-expression(rhs)
. given = apart(emitted, rhs, !is-inert(object) || !is-inert(key))
. given-type = emitted.type
. held = emit-expression(object)
. type = held.type
. range = emit-expression(key)
. range-type = range.type
. source = convert(rhs, .reason-argument, Typed(given, given-type))
. source-type = source.type
. layout = layout-of(type, id)
. source-layout = layout-of(source-type, id)
if intrinsic(type) == .table-column
    copy-column-range(id, held.operand, type, layout, range.operand, range-type, object, source.operand, source-layout)
    =
. row = table-row-type(type)
. row-layout = layout-of(row, id)
. kind = intrinsic(type)
. given-kind = intrinsic(source-type)
. unions = if types.intrinsic-of(row) == .union then tables.unions.of(row) else U32.max
if not-table || not-given || (types.intrinsic-of(row) != .struct && unions == U32.max) || other-row
    refuse(.refused-statement, id)
    =
.. not-table = kind != .table && kind != .table-span
.. not-given = given-kind != .table && given-kind != .table-span
.. other-row = table-row-type(source-type) != row
. target = table-source(id, held.operand, type, layout)
. copied = table-source(id, source.operand, source-type, source-layout)
. bounds = range-bounds(id, range.operand, range-type, held.operand, type, object)
. start = arithmetic(id, .arithmetic-add, target.offset, bounds.start, u64-layout)
if unions != U32.max
    copy-union-rows
        - id
        - unions
        - target.columns
        - start
        - copied.columns
        - copied.offset
        - bounds.length
        - target.meta
    invalidate-marks(id, target.meta)
    =
for position in 0 .. < tables.layouts.rows[row-layout].fields.count
    . field = tables.layouts.field(row-layout, position)
    . into = table-cell(id, target.columns, start, position, field.layout)
    . out = table-cell(id, copied.columns, copied.offset, position, field.layout)
    copy-items(id, into, out, bounds.length, field.layout)
invalidate-marks(id, target.meta)

────────────────────
_ do copy-union-rows
    - site SyntaxId
    - place U32
    - into Operand
    - start Operand
    - out Operand
    - from Operand
    - count Operand
    - meta TableMeta

` Copies rows of a table of unions into another, one at a time, as TypeScript copies them:
` from the last where both are kept in the same columns and the target starts after the
` source, and from the first otherwise. `meta` is the target's.
. same = compare
    - site
    - .compare-equal
    - num-cast(site, into, pointer-layout, u64-layout)
    - num-cast(site, out, pointer-layout, u64-layout)
. backward = ir.reserve-block()
. forward = ir.reserve-block()
. testing = ir.reserve-block()
. done = ir.reserve-block()
branch(same, testing, forward)
ir.start-block(testing)
branch(compare(site, .compare-greater, start, from), backward, forward)
ir.start-block(backward)
copy-union-pass(site, place, into, start, out, from, count, meta, true)
jump(done)
ir.start-block(forward)
copy-union-pass(site, place, into, start, out, from, count, meta, false)
jump(done)
ir.start-block(done)

────────────────────
_ do copy-union-pass
    - site SyntaxId
    - place U32
    - into Operand
    - start Operand
    - out Operand
    - from Operand
    - count Operand
    - meta TableMeta
    - backward Bool

` One pass of a copy of rows of a table of unions, from the first row or from the last.
. counter = ir.add-local(u64-layout)
store-local(counter, if backward then count else integer(.machine-u64, 0), site)
. testing = ir.reserve-block()
. copying = ir.reserve-block()
. copied = ir.reserve-block()
jump(testing)
ir.start-block(testing)
. current = load-local(counter, site)
. going = if backward then compare(site, .compare-greater, current, integer(.machine-u64, 0)) else compare(site, .compare-less, current, count)
branch(going, copying, copied)
ir.start-block(copying)
. row = load-local(counter, site)
if backward
    row = arithmetic(site, .arithmetic-subtract, row, integer(.machine-u64, 1), u64-layout)
. target = arithmetic(site, .arithmetic-add, start, row, u64-layout)
. source = arithmetic(site, .arithmetic-add, from, row, u64-layout)
copy-union-row(site, place, into, target, out, source, meta)
store-local(counter, if backward then row else arithmetic(site, .arithmetic-add, row, integer(.machine-u64, 1), u64-layout), site)
jump(testing)
ir.start-block(copied)

────────────────────
_ do copy-union-row
    - site SyntaxId
    - place U32
    - into Operand
    - target Operand
    - out Operand
    - source Operand
    - meta TableMeta

` Copies a row of a table of unions into another, as TypeScript copies it: a row copied onto
` itself is left; otherwise the case the source's tag names is read field by field and
` stored as `scatter-union-case` stores it with the target's metadata, and a tag that names no
` case copies nothing.
. same = compare
    - site
    - .compare-equal
    - num-cast(site, into, pointer-layout, u64-layout)
    - num-cast(site, out, pointer-layout, u64-layout)
. checking = ir.reserve-block()
. moving = ir.reserve-block()
. done = ir.reserve-block()
branch(same, checking, moving)
ir.start-block(checking)
branch(compare(site, .compare-equal, target, source), done, moving)
ir.start-block(moving)
. union = tables.unions.layouts[place]
. tag = load(table-cell(site, out, source, 0, u8-layout), 0, u8-layout, site)
for position in 0 .. < union.cases.count
    . reading = ir.reserve-block()
    . next = ir.reserve-block()
    branch(compare(site, .compare-equal, tag, integer(.machine-u8, position)), reading, next)
    ir.start-block(reading)
    . read = gather-union-case(site, place, position, out, source)
    scatter-union-case(site, place, position, into, target, read.operand, meta, true)
    jump(done)
    ir.start-block(next)
jump(done)
ir.start-block(done)

────────────────────
_ do copy-column-range
    - id SyntaxId
    - column Operand
    - type TypeId
    - layout LayoutId
    - range Operand
    - range-type TypeId
    - object SyntaxId
    - source Operand
    - source-layout LayoutId

` The items of a view of a field's column copied into those a range spans of another, as
` TypeScript copies them: the target's data is found, the range made forward, and the
` source's data found; as many items as the range spans are copied, with no check of either's
` length.
. item-layout = layout-of(viewed-item(type), id)
. meta = column-meta(id, column, layout)
. data = column-data(id, column, layout, meta, item-layout)
. bounds = range-bounds(id, range, range-type, column, type, object)
. into = item-cell(id, data.operand, bounds.start, item-layout)
. out = column-data(id, source, source-layout, column-meta(id, source, source-layout), item-layout)
copy-items(id, into, out.operand, bounds.length, item-layout)
invalidate-marks(id, meta)

────────────────────
_ do copy-items
    - site SyntaxId
    - into Operand
    - out Operand
    - count Operand
    - item LayoutId

` Copies items of a column into another, as the runtime copies a slice: with what describes
` them where they hold pointers the collector follows.
. row = tables.layouts.rows[item]
. bytes = arithmetic(site, .arithmetic-multiply, count, integer(.machine-u64, row.size), u64-layout)
. mark = pending.length
pending += into
pending += out
pending += bytes
if !row.is-managed
    call-runtime(.runtime-copy-plain-slice, site, mark, pointer-layout)
    =
if row.buffer == no-string
    drop-pending(mark)
    refuse(.refused-type, site)
    =
pending += make-operand(.operand-buffer-descriptor, item)
call-runtime(.runtime-copy-slice, site, mark, pointer-layout)

────────────────────
_ do column-meta TableMeta
    - site SyntaxId
    - column Operand
    - layout LayoutId

` The metadata a view of a field's column holds.
= TableMeta
    - part(column, layout, 2, site).operand
    - part(column, layout, 6, site).operand
    - part(column, layout, 7, site).operand
    - part(column, layout, 8, site).operand
    - part(column, layout, 9, site).operand

────────────────────
_ do column-data Typed
    - site SyntaxId
    - column Operand
    - layout LayoutId
    - meta TableMeta
    - item LayoutId

` Where the items of a view of a field's column start: where the table grows, once the view is
` checked, the column its table's directory holds moved on by the view's offset, and where it
` does not, the data the view holds.
. growing = ir.reserve-block()
. fixed = ir.reserve-block()
. joined = ir.reserve-block()
branch(view-grows(site, meta), growing, fixed)
ir.start-block(growing)
validate-table(site, meta, "TableField", true)
. directory = moved-bytes
    - site
    - part-address(site, column, layout, 3).operand
    - arithmetic
        - site
        - .arithmetic-multiply
        - part(column, layout, 4, site).operand
        - integer(.machine-u64, 8)
        - u64-layout
. held = item-cell
    - site
    - load(directory, 0, pointer-layout, site)
    - part(column, layout, 5, site).operand
    - item
. from-growing = ir.current
jump(joined)
ir.start-block(fixed)
. own = part-address(site, column, layout, 0)
. from-fixed = ir.current
jump(joined)
ir.start-block(joined)
= Typed(phi(pointer-layout, held, from-growing, own.operand, from-fixed), own.type)

────────────────────
_ do column-length Typed
    - site SyntaxId
    - column Operand
    - layout LayoutId

` How many items a view of a field's column has, once the view is checked where its table
` grows. A view of a finished table is never checked.
if tables.layouts.rows[layout].fields.count == 2
    = part(column, layout, 1, site)
. meta = column-meta(site, column, layout)
. growing = ir.reserve-block()
. joined = ir.reserve-block()
branch(view-grows(site, meta), growing, joined)
ir.start-block(growing)
validate-table(site, meta, "TableField", true)
jump(joined)
ir.start-block(joined)
= part(column, layout, 1, site)

────────────────────
_ do part-address Typed
    - site SyntaxId
    - value Operand
    - layout LayoutId
    - position U32

` A field of a table or of a view of one that holds an address, as a plain pointer.
. held = tables.layouts.field(layout, position).layout
. read = part(value, layout, position, site)
= if held == pointer-layout then read else Typed(num-cast(site, read.operand, held, pointer-layout), read.type)

────────────────────
_ do view-columns Operand
    - site SyntaxId
    - meta TableMeta
    - columns Operand

` The columns a view of a table keeps: none where the table grows, whose view finds them in
` its header, and the table's own where it does not.
. growing = ir.reserve-block()
. fixed = ir.reserve-block()
. joined = ir.reserve-block()
branch(view-grows(site, meta), growing, fixed)
ir.start-block(growing)
jump(joined)
ir.start-block(fixed)
jump(joined)
ir.start-block(joined)
. kept = phi(pointer-layout, integer(.machine-pointer, 0), growing, columns, fixed)
= num-cast(site, kept, pointer-layout, managed-layout)

────────────────────
_ do put-meta
    - site SyntaxId
    - made Operand
    - layout LayoutId
    - first U32
    - meta TableMeta

` Stores a table's metadata in a view of it, from the field at `first`.
put(made, tables.layouts.field(layout, first), meta.header, site)
put(made, tables.layouts.field(layout, first + 1), meta.owner, site)
put(made, tables.layouts.field(layout, first + 2), meta.incarnation, site)
put(made, tables.layouts.field(layout, first + 3), meta.generation, site)
put(made, tables.layouts.field(layout, first + 4), meta.shrink, site)

────────────────────
_ do table-get Typed
    - id SyntaxId
    - held Operand
    - type TypeId

` A name of a table, or of a view of one, that TypeScript answers itself: the view of a field's
` column, how many rows or items there are, or where the items of a field's column start.
. none = make-operand(.operand-void, 0)
. op = table-op(id)
. kind = intrinsic(type)
. layout = layout-of(type, id)
if op == TableOp.table-column && is-row-source(kind)
    = table-column(id, held, type, layout)
if op == TableOp.table-length && is-row-source(kind)
    = rows-length(id, held, type, layout)
if op == TableOp.table-length && (kind == .table-column || kind == .immutable-table-column)
    . counted = column-length(id, held, layout)
    = Typed(counted.operand, types.size-type)
if op == TableOp.table-layout && kind == .table
    = layout-text(id, held, type, layout)
if op == TableOp.table-capacity && kind == .table
    . room = table-capacity(id, held, layout)
    = Typed(room.operand, types.size-type)
if op == TableOp.table-mark && kind == .table
    = table-mark(id, held, layout)
if op == TableOp.table-length && kind == .index-span
    . indices = word-at(id, held, layout, 3)
    = Typed(indices, types.size-type)
if op == TableOp.table-length && (kind == .table-selection || kind == .immutable-table-selection)
    . span-type = field-type(type, 1)
    . span-layout = layout-of(span-type, id)
    . selected = word-at(id, part(held, layout, 1, id).operand, span-layout, 3)
    = Typed(selected, types.size-type)
if op != TableOp.table-data || kind != .table-column
    refuse(.refused-expression, id)
    = Typed(none, no-type)
. pointer = facts.node-type(unit.reading, id)
. held-layout = layout-of(pointer, id)
. item-layout = layout-of(viewed-item(type), id)
. data = column-data(id, held, layout, column-meta(id, held, layout), item-layout)
= if held-layout == pointer-layout then Typed(data.operand, pointer) else Typed(num-cast(id, data.operand, pointer-layout, held-layout), pointer)

────────────────────
_ do layout-text Typed
    - id SyntaxId
    - held Operand
    - type TypeId
    - layout LayoutId

` `t.layout`, as TypeScript answers it: the text of how a table keeps its rows, that of a table
` that grows where it grows in an arena, and else that of one that does not.
. none = make-operand(.operand-void, 0)
. row = table-row-type(type)
. row-layout = layout-of(row, id)
. text-layout = layout-of(types.string-type, id)
. fixed-text = "Table'${type-runtime-name(types, row)}\nstorage fixed"
. growing-text = growing-struct-text(row, row-layout)
if types.intrinsic-of(row) == .union
    . place = tables.unions.of(row)
    if place == U32.max
        refuse(.refused-type, id)
        = Typed(none, no-type)
    fixed-text = tables.unions.fixed-texts[place]
    growing-text = tables.unions.growing-texts[place]
. fixed = make-operand(.operand-constant, ir.add-string(fixed-text))
. growing = ir.reserve-block()
. kept = ir.reserve-block()
. joined = ir.reserve-block()
branch(view-grows(id, table-meta(id, held, layout)), growing, kept)
ir.start-block(growing)
. grown = make-operand(.operand-constant, ir.add-string(growing-text))
jump(joined)
ir.start-block(kept)
jump(joined)
ir.start-block(joined)
= Typed(phi(text-layout, grown, growing, fixed, kept), types.string-type)

────────────────────
_ do growing-struct-text String
    - row TypeId
    - row-layout LayoutId

` The text `.layout` gives for a table of struct rows that grows in an arena: a region for each
` field's column.
. lines = ["Table'${type-runtime-name(types, row)}", "storage arena-growable", "row-layout struct", "growth shared geometric"]
if types.intrinsic-of(row) != .struct
    = "\n".join(lines)
for position in 0 .. < tables.layouts.rows[row-layout].fields.count
    . item = tables.layouts.rows[tables.layouts.field(row-layout, position).layout]
    lines += "region column[$position] ${region-name(row, position)} width=${item.size} align=${item.alignment}"
= "\n".join(lines)

────────────────────
_ do table-capacity Typed
    - site SyntaxId
    - table Operand
    - layout LayoutId

` How many rows a table has room for: its header's capacity, once checked, where it grows, and
` the size it holds itself where it does not.
. meta = table-meta(site, table, layout)
. growing = ir.reserve-block()
. fixed = ir.reserve-block()
. joined = ir.reserve-block()
branch(grows(site, meta.header), growing, fixed)
ir.start-block(growing)
validate-table(site, meta, "Table", false)
. held = header-word(site, meta.header, 2)
. from-growing = ir.current
jump(joined)
ir.start-block(fixed)
. own = part(table, layout, 1, site)
. from-fixed = ir.current
jump(joined)
ir.start-block(joined)
= Typed(phi(u64-layout, held, from-growing, own.operand, from-fixed), own.type)

────────────────────
_ do table-mark Typed
    - site SyntaxId
    - table Operand
    - layout LayoutId

` `t.mark`, as TypeScript answers it: the table is checked to grow, and the mark holds its
` header, its arena's owner, incarnation and generation, and the header's length, mutation
` generation and use of its spill.
. type = facts.node-type(unit.reading, site)
. mark-layout = layout-of(type, site)
. meta = require-growable(site, table, layout, "mark")
. made = frame(mark-layout)
put-word(site, made, mark-layout, 0, meta.header, u64-layout)
put-word(site, made, mark-layout, 1, meta.owner, u64-layout)
put-word(site, made, mark-layout, 2, meta.incarnation, u64-layout)
put-word(site, made, mark-layout, 3, meta.generation, u64-layout)
put-word(site, made, mark-layout, 4, header-word(site, meta.header, 1), u64-layout)
put-word(site, made, mark-layout, 5, header-word(site, meta.header, 4), u64-layout)
put-word(site, made, mark-layout, 6, header-word(site, meta.header, 6), u64-layout)
= Typed(made, type)

────────────────────
_ do put-word
    - site SyntaxId
    - made Operand
    - layout LayoutId
    - position U32
    - value Operand
    - source LayoutId

` Stores a word in a field of a tuple made in the frame, as the field holds it.
. field = tables.layouts.field(layout, position)
put(made, field, num-cast(site, value, source, field.layout), site)

────────────────────
_ do word-at Operand
    - site SyntaxId
    - value Operand
    - layout LayoutId
    - position U32

` A word a tuple holds at a place, as a number.
. field = tables.layouts.field(layout, position)
= num-cast(site, part(value, layout, position, site).operand, field.layout, u64-layout)

────────────────────
_ do require-growable TableMeta
    - site SyntaxId
    - table Operand
    - layout LayoutId
    - operation String

` Checks that a table grows before an operation only such a table has, as TypeScript checks
` it: it has a header, its arena has not been reset since it was made, and it is not sealed.
` Answers the table's metadata, with no shrink generation.
. header = part(table, layout, 2, site)
fail-if
    - site
    - compare(site, .compare-equal, header.operand, integer(.machine-u64, 0))
    - "Table.$operation requires an Arena-backed growable table"
. meta = TableMeta
    - header.operand
    - part(table, layout, 3, site).operand
    - part(table, layout, 4, site).operand
    - part(table, layout, 5, site).operand
    - integer(.machine-u64, 0)
validate-table(site, meta, "Table", false)
= meta

────────────────────
_ do count-on
    - site SyntaxId
    - header Operand
    - position U32

` Counts on a generation a table's header keeps, which may not overflow.
. place = num-cast(site, header, u64-layout, pointer-layout)
. current = load(place, position * 8, u64-layout, site)
fail-if
    - site
    - compare(site, .compare-equal, current, integer(.machine-u64, U64.max))
    - "Table generation overflow"
store
    - place
    - position * 8
    - arithmetic(site, .arithmetic-add, current, integer(.machine-u64, 1), u64-layout)
    - false
    - site

────────────────────
_ do put-header
    - site SyntaxId
    - header Operand
    - position U32
    - value Operand

` Stores a word of a table's header.
store(num-cast(site, header, u64-layout, pointer-layout), position * 8, value, false, site)

────────────────────
_ do emit-table-method Typed
    - id SyntaxId
    - object SyntaxId
    - written RowRange'SyntaxId

` A member of a table that TypeScript answers where it is called: the table is evaluated, then
` the arguments in the order they are written, each converted to its parameter's type, and
` then the operation runs. A table finished from a local or an argument is the empty table
` there after, and so is one finished from a stored field of an object, which the object holds
` where it was read, as TypeScript stores the empty table through the address it read.
. nothing = make-operand(.operand-void, 0)
. fact = own-call(id)
if fact == no-fact
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. call = facts.calls[fact]
. callee = call.callee
if callee == no-instance || call.is-partial || call.form != .call-method || other-count
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
.. other-count = call.fills.count != written.count
for position in 0 .. < call.fills.count
    if facts.call-fills[call.fills.start + position] as U32 != position
        refuse(.refused-expression, id)
        = Typed(nothing, no-type)
. op = table-op(id)
. clears = op == TableOp.table-finish && finished-field(object)
. emptied = if op == TableOp.table-finish && !clears then finished-slot(object) else no-slot
. table = emit-receiver(id, object)
. type = table.type
. row = table-row-type(type)
. unions = types.intrinsic-of(row) == .union && tables.unions.of(row) != U32.max
if intrinsic(type) != .table || (types.intrinsic-of(row) != .struct && !unions)
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. passed [Operand]
. passed-types [TypeId]
. evaluated U32
for argument in tree.children[written]
    . expression = argument
    do match? tree.nodes[argument]
        | .node-argument(named)
            expression = named.expr
    evaluated += 1
    . made = emit-expression(expression)
    passed += settled(made, expression, written, evaluated)
    passed-types += made.type
. known = U32.max
for position in 0 .. < written.count
    if unions && op == TableOp.table-append
        known = wraps-case(tree.children[written.start + position], .reason-argument, passed-types[position])
    . converted = convert
        - tree.children[written.start + position]
        - .reason-argument
        - Typed(passed[position], passed-types[position])
    passed[position] = converted.operand
    if converted.type != instances.argument-type(callee, position)
        refuse(.refused-conversion, id)
. layout = layout-of(type, id)
. row-layout = layout-of(row, id)
if op == TableOp.table-append
    = table-append(id, table.operand, layout, row, row-layout, passed[0], known)
if op == TableOp.table-reserve
    . reserved = require-growable(id, table.operand, layout, "reserve")
    reserve-rows(id, row, row-layout, reserved, passed[0])
else if op == TableOp.table-extend
    table-extend(id, table.operand, layout, row, row-layout, passed[0], instances.argument-type(callee, 0))
else if op == TableOp.table-truncate
    table-truncate(id, table.operand, layout, passed[0])
else if op == TableOp.table-clear
    . cleared = require-growable(id, table.operand, layout, "clear")
    count-on(id, cleared.header, 3)
    count-on(id, cleared.header, 4)
    put-header(id, cleared.header, 1, integer(.machine-u64, 0))
    put-header(id, cleared.header, 6, integer(.machine-u64, 0))
else if op == TableOp.table-copy-from
    table-copy-from(id, table.operand, layout, row, row-layout, passed[0])
else if op == TableOp.table-finish
    . finished = table-finish(id, table.operand, layout)
    . answer = finished.type
    if emptied != no-slot
        empty-slot(emptied, type, layout, id)
    if clears
        if !tables.layouts.is-struct(layout)
            refuse(.refused-expression, id)
            = Typed(nothing, no-type)
        . empty = frame(layout)
        zero(empty, layout)
        copy(table.operand, empty, layout, tables.layouts.rows[layout].is-managed, id)
    = Typed(finished.operand, answer)
else if op == TableOp.table-view
    = viewed-table(id, table.operand, layout)
else if op == TableOp.table-rewind
    table-rewind(id, table.operand, layout, passed[0], instances.argument-type(callee, 0))
else if op == TableOp.table-storage-checkpoint
    = table-checkpoint
        - id
        - table.operand
        - layout
        - passed[0]
        - instances.argument-type(callee, 0)
        - passed[1]
        - instances.argument-type(callee, 1)
else if op == TableOp.table-validate-restore || op == TableOp.table-restore-storage
    . checkpoint-type = instances.argument-type(callee, 0)
    . arena-type = instances.argument-type(callee, 1)
    . mark-type = instances.argument-type(callee, 2)
    table-restore
        - id
        - table.operand
        - layout
        - passed
        - checkpoint-type
        - arena-type
        - mark-type
        - op == TableOp.table-restore-storage
else
    refuse(.refused-expression, id)
= Typed(nothing, types.void-type)

────────────────────
_ do emit-builder-method Typed
    - id SyntaxId
    - object SyntaxId
    - written RowRange'SyntaxId
    - appends Bool

` A member of an arena's builder that TypeScript answers where it is called, on a builder
` written or on the receiver of the member that calls it: the builder is evaluated, then its
` argument, converted to its parameter's type. `append` checks the size can
` grow, makes room for one more item and stores it after the last; `reserve` makes room for as
` many items as it is given. Each then writes the storage, its capacity and the size in the
` builder's header, where every copy of the builder reads them.
. nothing = make-operand(.operand-void, 0)
. fact = own-call(id)
. constant = facts.constant-of(unit.reading, id)
if fact == no-fact || constant == no-fact
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. call = facts.calls[fact]
. callee = call.callee
. form = call.form == .call-method || (object == 0 && call.form == .call-function)
if callee == no-instance || call.is-partial || !form || call.fills.count != 1 || written.count != 1
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
if facts.call-fills[call.fills.start] as U32 != 0
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. builder = emit-receiver(id, object)
. type = builder.type
. argument = tree.children[written.start]
. given = emit-expression(argument-value(argument))
given = convert(argument, .reason-argument, given)
if given.type != instances.argument-type(callee, 0)
    refuse(.refused-conversion, id)
. layout = layout-of(type, id)
. item-type = types.builder-item(type)
. item-layout = if item-type != no-type then layout-of(item-type, id) else void-layout
. width = tables.layouts.rows[item-layout].size as U64
if item-type == no-type || item-layout == void-layout || width == 0
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. traced = facts.constants[constant].bits != 0
. state = builder-state(id, builder.operand, layout)
. held = num-cast(id, state.identity, u64-layout, pointer-layout)
. current = BuilderItems(load(held, 0, u64-layout, id), load(held, 8, u64-layout, id))
if !appends
    . reserved = reserve-items
        - id
        - item-layout
        - traced
        - state.owner
        - state.incarnation
        - current
        - given.operand
    put-builder-state(id, held, reserved, state.size)
    = Typed(nothing, types.void-type)
fail-if
    - id
    - compare(id, .compare-equal, state.size, integer(.machine-u64, U64.max))
    - "ArrayBuilder size overflow"
. needed = arithmetic(id, .arithmetic-add, state.size, integer(.machine-u64, 1), u64-layout)
. items = reserve-items(id, item-layout, traced, state.owner, state.incarnation, current, needed)
. distance = arithmetic
    - id
    - .arithmetic-multiply
    - state.size
    - integer(.machine-u64, width)
    - u64-layout
. place = num-cast
    - id
    - arithmetic(id, .arithmetic-add, items.storage, distance, u64-layout)
    - u64-layout
    - pointer-layout
if tables.layouts.is-struct(item-layout)
    copy
        - address(place, 0, item-layout, id)
        - given.operand
        - item-layout
        - traced && tables.layouts.rows[item-layout].is-managed
        - id
else
    store(place, 0, given.operand, traced && is-managed-pointer(item-layout), id)
put-builder-state(id, held, items, needed)
= Typed(nothing, types.void-type)

────────────────────
_ do reserve-items BuilderItems
    - site SyntaxId
    - item LayoutId
    - traced Bool
    - owner Operand
    - incarnation Operand
    - current BuilderItems
    - needed Operand

` The storage of items kept in an arena, of its owner and incarnation, and its capacity, grown
` where fewer items fit than are needed, as TypeScript grows a builder's: the capacity is
` chosen, the bytes it takes reserved in the arena, zeroed and aligned to 16, and the items
` held copied over, with what describes them where the arena traces them. What was reserved
` before stays in the arena.
. width = tables.layouts.rows[item].size as U64
if traced && tables.layouts.rows[item].buffer == no-string
    refuse(.refused-type, site)
    = current
. kept = ir.current
. growing = ir.reserve-block()
. joined = ir.reserve-block()
branch(compare(site, .compare-greater, needed, current.capacity), growing, joined)
ir.start-block(growing)
. first U64 = if width <= 16 then 8 else if width <= 1024 then 4 else 1
. next = next-capacity(site, current.capacity, needed, first, "ArrayBuilder size overflow")
. bytes = checked-bytes(site, next, width, "ArrayBuilder")
. reserving = if traced then traced-reserve else RuntimeFunction.runtime-arena-reserve
    .. traced-reserve = RuntimeFunction.runtime-arena-reserve-described
. copying = if traced then traced-copy else RuntimeFunction.runtime-copy-plain-slice
    .. traced-copy = RuntimeFunction.runtime-copy-slice
. mark = pending.length
pending += num-cast(site, owner, u64-layout, pointer-layout)
pending += incarnation
pending += bytes
pending += integer(.machine-u64, 16)
pending += integer(.machine-u8, 1)
if traced
    pending += make-operand(.operand-buffer-descriptor, item)
. replacement = call-runtime(reserving, site, mark, pointer-layout)
fail-if
    - site
    - compare(site, .compare-equal, replacement, integer(.machine-pointer, 0))
    - "Arena allocation failed while growing ArrayBuilder"
. copied = checked-bytes(site, current.capacity, width, "ArrayBuilder")
. copies = pending.length
pending += replacement
pending += num-cast(site, current.storage, u64-layout, pointer-layout)
pending += copied
if traced
    pending += make-operand(.operand-buffer-descriptor, item)
call-runtime(copying, site, copies, pointer-layout)
. grown = num-cast(site, replacement, pointer-layout, u64-layout)
. grew = ir.current
jump(joined)
ir.start-block(joined)
= BuilderItems
    - phi(u64-layout, current.storage, kept, grown, grew)
    - phi(u64-layout, current.capacity, kept, next, grew)

────────────────────
_ do put-builder-state
    - site SyntaxId
    - held Operand
    - items BuilderItems
    - size Operand

` Writes the storage of an arena's builder, its capacity and its size in its header, as
` TypeScript writes them.
store(held, 0, items.storage, false, site)
store(held, 8, items.capacity, false, site)
store(held, 16, size, false, site)

────────────────────
_ do finished-slot SlotId
    - object SyntaxId

` The local or the argument a table is finished from, which TypeScript sets to the empty table
` after: one a name reads. None for a table a call makes, which TypeScript sets nowhere; any
` other place is refused.
do match? tree.nodes[object]
    | .node-call-expression
        = no-slot
. slot = local-slot(object, object, true)
if bindings.slots[slot].kind == .slot-lazy
    refuse(.refused-expression, object)
    = no-slot
= slot

────────────────────
_ do finished-field Bool
    - object SyntaxId

` Whether a table finished is a field an object stores, read where the object holds it: one of
` the receiver named alone, or one read from an object, by no getter.
do match? tree.nodes[object]
    | .node-identifier(row)
        if !is-own-field(object) || !tables.is-class(unit.owner-type) || own-call(object) != no-fact
            = false
        = stores-eagerly(unit.owner-type, row.name)
    | .node-get-expression(row)
        . owner = facts.node-type(unit.reading, row.object)
        if owner == no-type || owner == invalid-type || !tables.is-class(owner) || is-link(object)
            = false
        if own-call(object) != no-fact || facts.plan-of(unit.reading, object) != .plan-none
            = false
        = stores-eagerly(owner, row.name)
= false

────────────────────
_ stores-eagerly Bool
    - owner TypeId
    - name Atom

` Whether a type stores a property of a name as it is declared, with no getter or lazy value.
found && types.properties[found].storage-kind == .storage-eager

.. found = property-of(owner, name)

────────────────────
_ do empty-slot
    - slot SlotId
    - type TypeId
    - layout LayoutId
    - site SyntaxId

` Sets the local or the argument a table was finished from to the empty table: in the
` environment that keeps it, in its cell, or in the memory of the argument.
. empty = frame(layout)
zero(empty, layout)
if is-captured(slot)
    keep-captured(slot, empty, type, site)
    =
. offset = slot-offset(slot, site)
if unit.cells[offset] != no-local
    store-local(unit.cells[offset], empty, site)
    =
. memory = argument-memory(slot, type, site)
copy(memory, empty, layout, false, site)

────────────────────
_ do table-append Typed
    - site SyntaxId
    - table Operand
    - layout LayoutId
    - row TypeId
    - row-layout LayoutId
    - value Operand
    - known U32 = U32.max

` `t.append(row)`, as TypeScript answers it: the table is checked to grow, room is made for one
` more row, and the row is scattered into the columns at the end, plainly; the length is
` counted on, and the answer is the row's index. A union known to hold one case, as
` `wraps-case` finds it, is scattered as that case with no other tested.
. meta = require-growable(site, table, layout, "append")
. length = header-word(site, meta.header, 1)
fail-if
    - site
    - compare(site, .compare-equal, length, integer(.machine-u64, U64.max))
    - "Table length overflow"
. next = arithmetic(site, .arithmetic-add, length, integer(.machine-u64, 1), u64-layout)
reserve-rows(site, row, row-layout, meta, next)
. columns = num-cast(site, header-word(site, meta.header, 0), u64-layout, pointer-layout)
if types.intrinsic-of(row) == .union && known != U32.max && known-case
    scatter-union-case
        - site
        - tables.unions.of(row)
        - known
        - columns
        - length
        - take(value, tables.layouts.case-field(row-layout, known), site)
        - meta
        - true
else if types.intrinsic-of(row) == .union
    scatter-union(site, tables.unions.of(row), columns, length, value, meta, true)
else
    for position in 0 .. < tables.layouts.rows[row-layout].fields.count
        . field = tables.layouts.field(row-layout, position)
        . cell = table-cell(site, columns, length, position, field.layout)
        store-row-cell(site, cell, field.layout, take(value, field, site), meta)
.. known-case = known < tables.layouts.rows[row-layout].cases.count
put-header(site, meta.header, 1, next)
= Typed(length, types.index-type)

────────────────────
_ do wraps-case U32
    - site SyntaxId
    - reason ConversionReason
    - from TypeId

` The case of a union a value of a type is held as once converted at a site for a reason,
` where the one conversion recorded there wraps it as that case, as `wrap-case` says; or
` `U32.max` where the conversions there are any other.
. found = U32.max
. fact = facts.first-conversion(unit.reading, site)
while fact != no-fact
    . row = facts.conversions[fact]
    if row.reason == reason
        if found != U32.max || row.from != from || runs-or-casts || not-case-wrap
            = U32.max
        .. runs-or-casts = row.runs != no-instance || row.casts
        .. not-case-wrap = row.kind != .relation-wrap-cast || row.case-index == U32.max
        found = row.case-index
    fact = row.next
= found

────────────────────
_ do table-extend
    - site SyntaxId
    - table Operand
    - layout LayoutId
    - row TypeId
    - row-layout LayoutId
    - rows Operand
    - rows-type TypeId

` `t.extend(rows)`, as TypeScript answers it: each row of the array is appended in turn, each
` with every check of `append`.
. array-layout = layout-of(rows-type, site)
. data = word-at(site, rows, array-layout, 0)
. size = word-at(site, rows, array-layout, 1)
. stride = integer(.machine-u64, tables.layouts.rows[row-layout].size)
. counter = ir.add-local(u64-layout)
store-local(counter, integer(.machine-u64, 0), site)
. testing = ir.reserve-block()
. appending = ir.reserve-block()
. appended = ir.reserve-block()
jump(testing)
ir.start-block(testing)
branch(compare(site, .compare-less, load-local(counter, site), size), appending, appended)
ir.start-block(appending)
. index = load-local(counter, site)
. item = num-cast
    - site
    - arithmetic
        - site
        - .arithmetic-add
        - data
        - arithmetic(site, .arithmetic-multiply, index, stride, u64-layout)
        - u64-layout
    - u64-layout
    - pointer-layout
table-append(site, table, layout, row, row-layout, item)
store-local
    - counter
    - arithmetic(site, .arithmetic-add, index, integer(.machine-u64, 1), u64-layout)
    - site
jump(testing)
ir.start-block(appended)

────────────────────
_ do table-truncate
    - site SyntaxId
    - table Operand
    - layout LayoutId
    - requested Operand

` `t.truncate(n)`, as TypeScript answers it: the table is checked to grow and to hold at least
` as many rows; where it holds more, its views and marks are made stale and the length set.
. meta = require-growable(site, table, layout, "truncate")
. length = header-word(site, meta.header, 1)
fail-if
    - site
    - compare(site, .compare-greater, requested, length)
    - "Table truncate length exceeds current length"
. shrinking = ir.reserve-block()
. joined = ir.reserve-block()
branch(compare(site, .compare-less, requested, length), shrinking, joined)
ir.start-block(shrinking)
count-on(site, meta.header, 3)
count-on(site, meta.header, 4)
put-header(site, meta.header, 1, requested)
jump(joined)
ir.start-block(joined)

────────────────────
_ do table-copy-from
    - site SyntaxId
    - table Operand
    - layout LayoutId
    - row TypeId
    - row-layout LayoutId
    - source Operand

` `t.copy-from(s)`, as TypeScript answers it: the table is checked to grow, and unless it is
` the source itself, its views and marks are made stale and it is emptied; the source's
` columns and length are read, checked where it grows, room made for its rows, and each
` field's column copied over; the length is then the source's.
. meta = require-growable(site, table, layout, "copy-from")
. other = part(source, layout, 2, site)
. copying = ir.reserve-block()
. joined = ir.reserve-block()
branch(compare(site, .compare-not-equal, meta.header, other.operand), copying, joined)
ir.start-block(copying)
count-on(site, meta.header, 3)
count-on(site, meta.header, 4)
put-header(site, meta.header, 1, integer(.machine-u64, 0))
put-header(site, meta.header, 6, integer(.machine-u64, 0))
. given = TableMeta
    - other.operand
    - part(source, layout, 3, site).operand
    - part(source, layout, 4, site).operand
    - part(source, layout, 5, site).operand
    - integer(.machine-u64, 0)
. rows = table-rows(site, source, layout, given)
. columns = rows.columns
. length = rows.length
reserve-rows(site, row, row-layout, meta, length)
. into = num-cast(site, header-word(site, meta.header, 0), u64-layout, pointer-layout)
if types.intrinsic-of(row) == .union
    . zero = integer(.machine-u64, 0)
    copy-union-rows(site, tables.unions.of(row), into, zero, columns, zero, length, meta)
else
    for position in 0 .. < tables.layouts.rows[row-layout].fields.count
        . field = tables.layouts.field(row-layout, position)
        . target = load(into, position * 8, pointer-layout, site)
        . out = load(columns, position * 8, pointer-layout, site)
        copy-items(site, target, out, length, field.layout)
put-header(site, meta.header, 1, length)
jump(joined)
ir.start-block(joined)

────────────────────
_ do table-finish Typed
    - site SyntaxId
    - table Operand
    - layout LayoutId

` `t.finish()`, as TypeScript answers it: the table is checked to grow, its columns and length
` read, and its header sealed; the answer is the finished table of those columns and that
` length.
. type = facts.node-type(unit.reading, site)
. finished-layout = layout-of(type, site)
if intrinsic(type) != .immutable-table
    refuse(.refused-expression, site)
    = Typed(make-operand(.operand-void, 0), no-type)
. meta = require-growable(site, table, layout, "finish")
. columns = header-word(site, meta.header, 0)
. length = header-word(site, meta.header, 1)
put-header(site, meta.header, 0, integer(.machine-u64, 0))
. made = frame(finished-layout)
put-word(site, made, finished-layout, 0, columns, u64-layout)
put-word(site, made, finished-layout, 1, length, u64-layout)
= Typed(made, type)

────────────────────
_ do viewed-table Typed
    - site SyntaxId
    - table Operand
    - layout LayoutId

` `t.view()`, as TypeScript answers it: the table is checked to grow, and the answer is the
` finished table of its columns and its length now, which the table goes on growing apart from.
. type = facts.node-type(unit.reading, site)
. viewed-layout = layout-of(type, site)
if intrinsic(type) != .immutable-table
    refuse(.refused-expression, site)
    = Typed(make-operand(.operand-void, 0), no-type)
. meta = require-growable(site, table, layout, "view")
. made = frame(viewed-layout)
put-word(site, made, viewed-layout, 0, header-word(site, meta.header, 0), u64-layout)
put-word(site, made, viewed-layout, 1, header-word(site, meta.header, 1), u64-layout)
= Typed(made, type)

────────────────────
_ do table-rewind
    - site SyntaxId
    - table Operand
    - layout LayoutId
    - mark Operand
    - mark-type TypeId

` `t.rewind(m)`, as TypeScript answers it: the table is checked to grow, and the mark to be of
` this table, its arena and generation, with no row written since and no more rows than it
` has now; the length and the use of the spill are then the mark's, and the shrink generation
` is counted on.
. mark-layout = layout-of(mark-type, site)
. meta = require-growable(site, table, layout, "rewind")
. stale = "Table mark is stale or belongs to another table"
fail-if
    - site
    - compare(site, .compare-not-equal, meta.header, word-at(site, mark, mark-layout, 0))
    - stale
fail-if
    - site
    - compare(site, .compare-not-equal, meta.owner, word-at(site, mark, mark-layout, 1))
    - stale
fail-if
    - site
    - compare(site, .compare-not-equal, meta.incarnation, word-at(site, mark, mark-layout, 2))
    - stale
fail-if
    - site
    - compare(site, .compare-not-equal, meta.generation, word-at(site, mark, mark-layout, 3))
    - stale
fail-if
    - site
    - compare
        - site
        - .compare-not-equal
        - header-word(site, meta.header, 4)
        - word-at(site, mark, mark-layout, 5)
    - stale
. length = word-at(site, mark, mark-layout, 4)
fail-if(site, compare(site, .compare-greater, length, header-word(site, meta.header, 1)), stale)
put-header(site, meta.header, 1, length)
put-header(site, meta.header, 6, word-at(site, mark, mark-layout, 6))
count-on(site, meta.header, 3)

────────────────────
_ do table-checkpoint Typed
    - site SyntaxId
    - table Operand
    - layout LayoutId
    - arena Operand
    - arena-type TypeId
    - mark Operand
    - mark-type TypeId

` `t.storage-checkpoint(arena, mark)`, as TypeScript answers it: the table is checked to grow,
` to be held by the arena, and the mark to be the arena's mark now; the checkpoint holds the
` table's identity, the mark, the arena's active bytes, and each word of the header.
. type = facts.node-type(unit.reading, site)
. made-layout = layout-of(type, site)
. arena-layout = layout-of(arena-type, site)
. mark-layout = layout-of(mark-type, site)
. meta = require-growable(site, table, layout, "storage-checkpoint")
. owner = part(arena, arena-layout, 0, site)
. incarnation = part(arena, arena-layout, 1, site)
. value = word-at(site, mark, mark-layout, 0)
. stale = "Table storage checkpoint mark is stale or belongs to another Arena"
fail-if
    - site
    - compare(site, .compare-not-equal, meta.owner, word-at(site, arena, arena-layout, 0))
    - stale
fail-if(site, compare(site, .compare-not-equal, meta.incarnation, incarnation.operand), stale)
. mark-at = pending.length
pending += owner.operand
pending += incarnation.operand
. current = call-runtime(.runtime-arena-mark, site, mark-at, u64-layout)
fail-if(site, compare(site, .compare-not-equal, value, current), stale)
pending += owner.operand
pending += incarnation.operand
. active = call-runtime(.runtime-arena-active-bytes, site, mark-at, u64-layout)
. made = frame(made-layout)
put-word(site, made, made-layout, 0, meta.header, u64-layout)
put-word(site, made, made-layout, 1, meta.owner, u64-layout)
put-word(site, made, made-layout, 2, meta.incarnation, u64-layout)
put-word(site, made, made-layout, 3, meta.generation, u64-layout)
put-word(site, made, made-layout, 4, value, u64-layout)
put-word(site, made, made-layout, 5, active, u64-layout)
for position in 0 .. < 8u32
    put-word
        - site
        - made
        - made-layout
        - position + 6
        - header-word(site, meta.header, position)
        - u64-layout
= Typed(made, type)

────────────────────
_ do table-restore
    - site SyntaxId
    - table Operand
    - layout LayoutId
    - passed [Operand]
    - checkpoint-type TypeId
    - arena-type TypeId
    - mark-type TypeId
    - restores Bool

` `t.validate-storage-restore(c, arena, mark)` and `t.restore-storage(…)`, as TypeScript answers
` them: the table is checked to grow, and the checkpoint to be of this table, its arena and
` generation, at the arena's mark, with no row written since, the arena's active bytes not
` fewer (or, to restore, the same), and no more rows than the table has now. Restoring then
` gives the header each word the checkpoint holds, with its generations counted on.
. checkpoint-layout = layout-of(checkpoint-type, site)
. arena-layout = layout-of(arena-type, site)
. mark-layout = layout-of(mark-type, site)
. checkpoint = passed[0]
. meta = require-growable(site, table, layout, "storage checkpoint restore")
. owner = part(passed[1], arena-layout, 0, site)
. incarnation = part(passed[1], arena-layout, 1, site)
. value = word-at(site, passed[2], mark-layout, 0)
. mark-at = pending.length
pending += owner.operand
pending += incarnation.operand
. generation = call-runtime(.runtime-arena-generation, site, mark-at, u64-layout)
pending += owner.operand
pending += incarnation.operand
. active = call-runtime(.runtime-arena-active-bytes, site, mark-at, u64-layout)
. stale = if restores then "Table storage checkpoint cannot be restored from the current Arena state" else "Table storage checkpoint is stale or belongs to another table"
fail-if
    - site
    - compare
        - site
        - .compare-not-equal
        - meta.header
        - word-at(site, checkpoint, checkpoint-layout, 0)
    - stale
fail-if
    - site
    - compare(site, .compare-not-equal, meta.owner, word-at(site, checkpoint, checkpoint-layout, 1))
    - stale
fail-if
    - site
    - compare
        - site
        - .compare-not-equal
        - meta.incarnation
        - word-at(site, checkpoint, checkpoint-layout, 2)
    - stale
fail-if
    - site
    - compare
        - site
        - .compare-not-equal
        - meta.generation
        - word-at(site, checkpoint, checkpoint-layout, 3)
    - stale
fail-if
    - site
    - compare(site, .compare-not-equal, meta.owner, word-at(site, passed[1], arena-layout, 0))
    - stale
fail-if(site, compare(site, .compare-not-equal, meta.incarnation, incarnation.operand), stale)
fail-if(site, compare(site, .compare-not-equal, meta.generation, generation), stale)
fail-if
    - site
    - compare(site, .compare-not-equal, word-at(site, checkpoint, checkpoint-layout, 4), value)
    - stale
fail-if
    - site
    - compare
        - site
        - .compare-not-equal
        - header-word(site, meta.header, 4)
        - word-at(site, checkpoint, checkpoint-layout, 10)
    - stale
. saved = word-at(site, checkpoint, checkpoint-layout, 5)
. fewer = compare(site, if restores then .compare-not-equal else .compare-less, active, saved)
fail-if(site, fewer, stale)
fail-if
    - site
    - compare
        - site
        - .compare-greater
        - word-at(site, checkpoint, checkpoint-layout, 7)
        - header-word(site, meta.header, 1)
    - stale
. most = integer(.machine-u64, U64.max)
. shrink = word-at(site, checkpoint, checkpoint-layout, 9)
. mutation = word-at(site, checkpoint, checkpoint-layout, 10)
. checking = ir.reserve-block()
. overflowed = ir.reserve-block()
. passed = ir.reserve-block()
branch(compare(site, .compare-equal, shrink, most), overflowed, checking)
ir.start-block(checking)
branch(compare(site, .compare-equal, mutation, most), overflowed, passed)
ir.start-block(overflowed)
raise-text(site, "Table generation overflow")
ir.start-block(passed)
if !restores
    =
for position in 0 .. < 8u32
    . word = word-at(site, checkpoint, checkpoint-layout, position + 6)
    if position == 3 || position == 4
        word = arithmetic(site, .arithmetic-add, word, integer(.machine-u64, 1), u64-layout)
    put-header(site, meta.header, position, word)

────────────────────
_ do table-column Typed
    - id SyntaxId
    - table Operand
    - type TypeId
    - layout LayoutId

` A view of a field's column of a table or of a span of one at `t.f`.
= table-view(id, table, type, layout, table-slot(id), facts.node-type(unit.reading, id))

────────────────────
_ do table-view Typed
    - id SyntaxId
    - table Operand
    - type TypeId
    - layout LayoutId
    - slot U32
    - view TypeId

` A view of a field's column of a table or of a span of one, as TypeScript makes one: where
` the column's data is from the first row, left out where the table grows, how many rows there
` are, and what says whether the table can still be read, with the table's columns, the
` field's place among them and the first row. That of a finished table is where its data is
` and how many rows there are. A shared field of a table of unions is viewed in its own column.
. none = make-operand(.operand-void, 0)
. row = table-row-type(type)
. view-layout = layout-of(view, id)
. column = shared-column(id, row, slot)
. row-layout = if column == U32.max then layout-of(row, id) else layout-of(types.cases-of(row)[0].type, id)
if column == U32.max
    column = slot
. immutable = is-immutable-view(intrinsic(type))
. viewing = if immutable then IntrinsicKind.immutable-table-column else IntrinsicKind.table-column
if intrinsic(view) != viewing || slot >= tables.layouts.rows[row-layout].fields.count
    refuse(.refused-expression, id)
    = Typed(none, no-type)
. field = tables.layouts.field(row-layout, slot)
if viewed-item(view) != field.type
    refuse(.refused-expression, id)
    = Typed(none, no-type)
. source = table-source(id, table, type, layout)
if immutable
    . made = frame(view-layout)
    put
        - made
        - tables.layouts.field(view-layout, 0)
        - num-cast
            - id
            - table-cell(id, source.columns, source.offset, column, field.layout)
            - pointer-layout
            - managed-layout
        - id
    put(made, tables.layouts.field(view-layout, 1), source.length, id)
    = Typed(made, view)
. meta = source.meta
. data = table-cell(id, source.columns, source.offset, column, field.layout)
. made = frame(view-layout)
put(made, tables.layouts.field(view-layout, 0), view-columns(id, meta, data), id)
put(made, tables.layouts.field(view-layout, 1), source.length, id)
put(made, tables.layouts.field(view-layout, 2), meta.header, id)
put(made, tables.layouts.field(view-layout, 3), source.columns, id)
put(made, tables.layouts.field(view-layout, 4), integer(.machine-u64, column), id)
put(made, tables.layouts.field(view-layout, 5), source.offset, id)
put(made, tables.layouts.field(view-layout, 6), meta.owner, id)
put(made, tables.layouts.field(view-layout, 7), meta.incarnation, id)
put(made, tables.layouts.field(view-layout, 8), meta.generation, id)
put(made, tables.layouts.field(view-layout, 9), meta.shrink, id)
= Typed(made, view)

────────────────────
_ do shared-column U32
    - id SyntaxId
    - row TypeId
    - slot U32

` The column of a table of unions that holds the shared field at a place in the first case, or
` `U32.max` where the rows are structs. A table of unions with no such field has no shape.
if types.intrinsic-of(row) == .struct
    = U32.max
. place = tables.unions.of(row)
if place == U32.max
    refuse(.refused-expression, id)
    = U32.max
. union = tables.unions.layouts[place]
for position in 0 .. < union.commons.count
    . common = tables.unions.fields[union.commons.start + position]
    if common.slot == slot
        = common.column
refuse(.refused-expression, id)
= U32.max

────────────────────
_ do row-cursor TableCursor
    - id SyntaxId
    - object SyntaxId

` The row a field of a row is read or written through: the cursor `t[i]` makes where the row
` is written there, and else the row's value, whose columns are checked again where its table
` grows. A row of a finished table holds its columns itself.
. none = make-operand(.operand-void, 0)
. empty = TableCursor(none, none, TableMeta(none, none, none, none, none))
do match? tree.nodes[object]
    | .node-index-expression(row)
        if facts.plan-of(unit.reading, object) == .plan-table && !is-link(object)
            . cursor = if table-op(object) == TableOp.selection-row then selection-cursor(object, row.object, row.index) else table-cursor(object, row.object, row.index)
            = TableCursor
                - cursor.columns
                - cursor.index
                - TableMeta
                    - cursor.meta.header
                    - cursor.meta.owner
                    - cursor.meta.incarnation
                    - cursor.meta.generation
                    - cursor.meta.shrink
. value = emit-expression(object)
. type = value.type
. proven = proven-item(object)
if proven != U32.max && intrinsic(type) == .table-row
    . layout = layout-of(type, id)
    = TableCursor(proven-items[proven].columns, part(value.operand, layout, 1, id).operand, no-meta())
= value-cursor(id, value.operand, type)

────────────────────
_ do value-cursor TableCursor
    - id SyntaxId
    - value Operand
    - type TypeId

` The columns and the index of a row held as a value. Where its table grows the table is
` checked and its columns read from the header.
. none = make-operand(.operand-void, 0)
. empty = TableCursor(none, none, TableMeta(none, none, none, none, none))
. kind = intrinsic(type)
if kind != .table-row && kind != .immutable-table-row
    refuse(.refused-expression, id)
    = empty
. layout = layout-of(type, id)
if kind == .immutable-table-row
    . zero = integer(.machine-u64, 0)
    = TableCursor
        - part-address(id, value, layout, 0).operand
        - part(value, layout, 1, id).operand
        - TableMeta(zero, zero, zero, zero, zero)
. meta = row-meta(id, value, layout)
. growing = ir.reserve-block()
. fixed = ir.reserve-block()
. joined = ir.reserve-block()
branch(view-grows(id, meta), growing, fixed)
ir.start-block(growing)
validate-table(id, meta, "TableRow", true)
. held = num-cast(id, header-word(id, meta.header, 0), u64-layout, pointer-layout)
. from-growing = ir.current
jump(joined)
ir.start-block(fixed)
. own = num-cast(id, part(value, layout, 0, id).operand, managed-layout, pointer-layout)
. from-fixed = ir.current
jump(joined)
ir.start-block(joined)
. columns = phi(pointer-layout, held, from-growing, own, from-fixed)
= TableCursor(columns, part(value, layout, 1, id).operand, meta)

────────────────────
_ do emit-table-field Typed
    - id SyntaxId
    - object SyntaxId

` A field of a row read from its column, or a shared field of a row of unions from its own.
` An optional field a test narrowed is read as what it holds, with no test.
. none = make-operand(.operand-void, 0)
if table-op(id) != TableOp.table-field
    refuse(.refused-expression, id)
    = Typed(none, no-type)
. cursor = row-cursor(id, object)
. row = table-row-type(facts.node-type(unit.reading, object))
. column = shared-column(id, row, table-slot(id))
. row-layout = if column == U32.max then layout-of(row, id) else layout-of(types.cases-of(row)[0].type, id)
. field = tables.layouts.field(row-layout, table-slot(id))
. place = if column == U32.max then table-slot(id) else column
. proven = proven-table(object)
. read = make-operand(.operand-void, 0)
if proven == U32.max
    read = take
        - table-cell(id, cursor.columns, cursor.index, place, field.layout)
        - LayoutField(0, field.layout, field.type)
        - id
else
    read = proven-field(id, proven-tables[proven].loop, place, cursor.index, field)
. typed = facts.node-type(unit.reading, id)
if typed != field.type && types.is-optional(field.type) && types.optional-inner(field.type) == typed
    = payload(id, Typed(read, field.type))
= Typed(read, field.type)

────────────────────
_ do emit-table-field-assign Assignment
    - id SyntaxId
    - op Operator
    - lhs SyntaxId
    - object SyntaxId
    - rhs SyntaxId

` A field of a row written in its column, as TypeScript writes it: the value is read, then the
` row, and the value, converted to the field's type, is stored; where the table grows the
` table is then checked and its mutation generation counted on. An assigning operator reads
` the field through the row first, and the row is read again for the store.
if table-op(lhs) != TableOp.table-field
    refuse(.refused-statement, id)
    = Assignment()
. given = Typed(make-operand(.operand-void, 0), no-type)
. increment = increment-base(op)
if op == .eq-op
    . made = emit-expression(rhs)
    given = Typed(apart(made, rhs, !is-inert(object)), made.type)
else if increment && facts.plan-of(unit.reading, id) == .plan-builtin
    given = emit-builtin(id, increment, lhs, rhs, true)
else
    refuse(.refused-statement, id)
. cursor = row-cursor(lhs, object)
. row = table-row-type(facts.node-type(unit.reading, object))
. column = shared-column(lhs, row, table-slot(lhs))
. row-layout = if column == U32.max then layout-of(row, lhs) else layout-of(types.cases-of(row)[0].type, lhs)
. field = tables.layouts.field(row-layout, table-slot(lhs))
. value = convert(id, .reason-assignment, given)
if value.type != field.type
    refuse(.refused-conversion, rhs)
. cell = table-cell
    - lhs
    - cursor.columns
    - cursor.index
    - if column == U32.max then table-slot(lhs) else column
    - field.layout
store-row-cell(lhs, cell, field.layout, value.operand, cursor.meta)
invalidate-marks(lhs, cursor.meta)
= Assignment(Typed(value.operand, field.type), given)

────────────────────
_ do store-row-cell
    - site SyntaxId
    - cell Operand
    - layout LayoutId
    - value Operand
    - meta TableMeta

` Stores a field in its cell: plainly where the table grows in an arena, and through the
` collector's barrier, where the field holds pointers it follows, where it does not.
if !tables.layouts.rows[layout].is-managed
    store-cell(site, cell, layout, value)
    =
. growing = ir.reserve-block()
. fixed = ir.reserve-block()
. joined = ir.reserve-block()
branch(view-grows(site, meta), growing, fixed)
ir.start-block(growing)
if tables.layouts.is-struct(layout)
    copy(cell, value, layout, false, site)
else
    store(cell, 0, value, false, site)
jump(joined)
ir.start-block(fixed)
store-cell(site, cell, layout, value)
jump(joined)
ir.start-block(joined)

────────────────────
_ do invalidate-marks
    - site SyntaxId
    - meta TableMeta

` After a row of a table that grows is written: the table is checked, and its mutation
` generation counted on, which makes its marks stale.
. growing = ir.reserve-block()
. joined = ir.reserve-block()
branch(view-grows(site, meta), growing, joined)
ir.start-block(growing)
validate-table(site, meta, "Table view", true)
. current = header-word(site, meta.header, 4)
fail-if
    - site
    - compare(site, .compare-equal, current, integer(.machine-u64, U64.max))
    - "Table generation overflow"
. next = arithmetic(site, .arithmetic-add, current, integer(.machine-u64, 1), u64-layout)
store(num-cast(site, meta.header, u64-layout, pointer-layout), 32, next, false, site)
jump(joined)
ir.start-block(joined)

────────────────────
_ do emit-table-store
    - id SyntaxId
    - object SyntaxId
    - key SyntaxId
    - rhs SyntaxId

` `t[i] = v` of a table or of a span of one, as TypeScript stores it: the row is read, then the
` table and the index, converted to one; the columns are found, the index checked against the
` length, and the row, converted to the table's, has each field stored in its column; where the
` table grows its mutation generation is then counted on.
if table-op(id) != TableOp.table-store
    refuse(.refused-statement, id)
    =
. made = emit-expression(rhs)
. given = apart(made, rhs, !is-inert(object) || !is-inert(key))
. given-type = made.type
. table = emit-expression(object)
. type = table.type
. index = convert(key, .reason-argument, emit-expression(key))
if index.type != types.index-type
    refuse(.refused-conversion, key)
. row = table-row-type(type)
. kind = intrinsic(type)
. row-kind = types.intrinsic-of(row)
if (kind != .table && kind != .table-span) || (row-kind != .struct && row-kind != .union)
    refuse(.refused-statement, id)
    =
. layout = layout-of(type, id)
. row-layout = layout-of(row, id)
. place = row-place(id, table.operand, type, layout, index.operand)
. given-kind = intrinsic(given-type)
if row-kind == .union && given-row && table-row-type(given-type) == row
    copy-row-into(id, row, place, rhs, given, given-type)
    =
.. given-row = given-kind == .table-row || given-kind == .immutable-table-row
. known = if row-kind == .union then wraps-case(rhs, .reason-argument, given-type) else U32.max
. value = convert(rhs, .reason-argument, Typed(given, given-type))
if value.type != row
    refuse(.refused-conversion, rhs)
if row-kind == .union
    store-union-row(id, row, place, value.operand, known)
    invalidate-marks(id, place.meta)
    =
for position in 0 .. < tables.layouts.rows[row-layout].fields.count
    . field = tables.layouts.field(row-layout, position)
    . cell = table-cell(id, place.columns, place.index, position, field.layout)
    store-row-cell(id, cell, field.layout, take(value.operand, field, id), place.meta)
invalidate-marks(id, place.meta)

────────────────────
_ do store-union-row
    - id SyntaxId
    - row TypeId
    - place TableCursor
    - value Operand
    - known U32 = U32.max

` `t[i] = v` of a table of unions: the union scattered into its row, with the table's
` metadata. One known to hold one case, as `wraps-case` finds it, is scattered as that case
` with no other tested.
. union = tables.unions.of(row)
if union == U32.max
    refuse(.refused-statement, id)
    =
. layout = layout-of(row, id)
if known != U32.max && known < tables.layouts.rows[layout].cases.count
    scatter-union-case
        - id
        - union
        - known
        - place.columns
        - place.index
        - take(value, tables.layouts.case-field(layout, known), id)
        - place.meta
        - true
    =
scatter-union(id, union, place.columns, place.index, value, place.meta, true)

────────────────────
_ do copy-row-into
    - id SyntaxId
    - row TypeId
    - place TableCursor
    - rhs SyntaxId
    - given Operand
    - given-type TypeId

` `t[i] = r` of a table of unions where `r` is a row of one: TypeScript copies the row's cells
` rather than gathering it, then counts on the target's mutation generation.
. union = tables.unions.of(row)
if union == U32.max
    refuse(.refused-statement, id)
    =
. source = value-cursor(rhs, given, given-type)
copy-union-row(id, union, place.columns, place.index, source.columns, source.index, place.meta)
invalidate-marks(id, place.meta)

────────────────────
_ do table-row-item Typed
    - site SyntaxId
    - value Operand
    - from TypeId

` A row of a table as the item it reads: gathered from the columns, field by field, or for a
` table of unions by the case its tag names.
. layout = layout-of(from, site)
. row = table-row-type(from)
. row-layout = layout-of(row, site)
. union = if types.intrinsic-of(row) == .union then tables.unions.of(row) else U32.max
if types.intrinsic-of(row) != .struct && union == U32.max
    refuse(.refused-conversion, site)
    = Typed(value, no-type)
if intrinsic(from) == .immutable-table-row
    . columns = part-address(site, value, layout, 0)
    . index = part(value, layout, 1, site)
    . held = if union != U32.max then gather-union(site, union, columns.operand, index.operand).operand else gather-row(site, row-layout, columns.operand, index.operand)
    = Typed(held, row)
. meta = row-meta(site, value, layout)
. growing = ir.reserve-block()
. fixed = ir.reserve-block()
. joined = ir.reserve-block()
branch(view-grows(site, meta), growing, fixed)
ir.start-block(growing)
validate-table(site, meta, "TableRow", true)
. held = num-cast(site, header-word(site, meta.header, 0), u64-layout, pointer-layout)
. from-growing = ir.current
jump(joined)
ir.start-block(fixed)
. own = num-cast(site, part(value, layout, 0, site).operand, managed-layout, pointer-layout)
. from-fixed = ir.current
jump(joined)
ir.start-block(joined)
. columns = phi(pointer-layout, held, from-growing, own, from-fixed)
. index = part(value, layout, 1, site)
. gathered = if union != U32.max then gather-union(site, union, columns, index.operand).operand else gather-row(site, row-layout, columns, index.operand)
= Typed(gathered, row)

────────────────────
_ do shared-base Typed
    - site SyntaxId
    - value Operand
    - from TypeId
    - to TypeId

` A row of a table of unions made the base its cases share, as TypeScript builds it: each of
` the base's fields read from the column the cases share for it.
. row = table-row-type(from)
. first = types.cases-of(row)[0].type
. layout = layout-of(to, site)
. first-layout = layout-of(first, site)
if !tables.layouts.is-struct(layout)
    refuse(.refused-conversion, site)
    = Typed(value, no-type)
. cursor = value-cursor(site, value, from)
. made = frame(layout)
for property in types.properties-of(to)
    if property.slot == U32.max
        continue
    . found = types.property-named(first, property.name)
    if !found
        refuse(.refused-conversion, site)
        break
    . slot = types.properties[found].slot
    . column = shared-column(site, row, slot)
    . held = tables.layouts.field(first-layout, slot)
    . cell = table-cell(site, cursor.columns, cursor.index, column, held.layout)
    put
        - made
        - tables.layouts.field(layout, property.slot)
        - take(cell, LayoutField(0, held.layout, held.type), site)
        - site
= Typed(made, to)

────────────────────
_ do emit-cast-constructor
    - declared SyntaxId

` A value made from another by its type's name: a number, cast to the type, or a value of
` the type itself, which a union is called with once its argument is converted to it.
. type = instances.rows[unit.instance].self-type
. signature = instances.signatures[unit.instance]
if signature.args.count != 1
    refuse(.refused-function, declared)
    =
. source = instances.argument-type(unit.instance, 0)
ir.add-argument(layout-of(source, declared))
returns-type = type
ir.returns = layout-of(type, declared)
. value = make-operand(.operand-argument, 0)
if source != type
    value = cast(declared, Typed(value, source), type).operand
return-value(value, declared)

────────────────────
_ do layout-of LayoutId
    - type TypeId
    - syntax SyntaxId

` How a value of a type is held, or a refusal when the type has no layout yet.
. layout = no-layout
if type != no-type && type != invalid-type
    layout = tables.layouts.values[type]
if layout == no-layout
    refuse(.refused-type, syntax)
    = void-layout
= layout

────────────────────
_ is-managed-pointer Bool
    - layout LayoutId

layout == managed-layout

────────────────────
_ is-pointer Bool
    - layout LayoutId

layout == pointer-layout || layout == managed-layout

────────────────────
_ is-integer Bool
    - layout LayoutId

layout >= u8-layout && layout <= i64-layout

────────────────────
_ is-signed Bool
    - layout LayoutId

layout == i8-layout || layout == i16-layout || layout == i32-layout || layout == i64-layout

────────────────────
_ is-float Bool
    - layout LayoutId

layout == f32-layout || layout == f64-layout

────────────────────
_ is-number Bool
    - layout LayoutId

is-integer(layout) || is-float(layout)

────────────────────
_ intrinsic IntrinsicKind
    - type TypeId

` What a type is built on, as the type pass left it. Emission completes nothing: a type the
` type pass never completed is built on nothing, and no shape here takes it.
types.completions[type].intrinsic

────────────────────
_ is-aggregate Bool
    - type TypeId

` Whether a type's values are fields held in place: a tuple, a struct, an `ArrayBuilder`, or a
` table or a view of one, which TypeScript holds as the library's tuple.
intrinsic-is-tuple-like(intrinsic(type))

────────────────────
_ is-plain-tuple Bool
    - type TypeId

` Whether a type is a tuple written with no name.
match types.rows[type]
    | .type-tuple
        true
    ??
        false

────────────────────
_ is-text Bool
    - type TypeId

intrinsic(type) == .string

────────────────────
_ is-zeroed Bool
    - type TypeId

` Whether the constructor of a type with no arguments makes its zero: a number, or a C
` pointer, which TypeScript holds as a number.
is-numeric-type(type) || intrinsic(type) == .cpointer

────────────────────
_ is-numeric-type Bool
    - type TypeId

` Whether a type is a number, as the type pass left it: an integer or a float, and no pointer.
intrinsic-is-numeric(kind) && kind != .cpointer

.. kind = intrinsic(type)

────────────────────
_ do emit-expression Typed ?! Refused
    - id SyntaxId

` The value of an expression before any conversion a use of it applies, with its type. A node the
` body being read did not reserve has no facts to follow. A tracked read has no shape here: nothing
` emitted follows what depends on it. `catch` of a value that carries no error is the value, and of
` any other has no shape yet. A name alone the type pass planned as a case, as a style declaration
` reads one, is that case.
. value = make-operand(.operand-void, 0)
if pins.length != 0
    . held = pin-of(id)
    if held
        = Typed(pins[held].value, pins[held].type)
if !facts.node-slot(unit.reading, id)
    refuse(.refused-expression, id)
    = Typed(value, no-type)
if !is-consumable(id)
    refuse(.refused-conversion, id)
    = Typed(value, no-type)
. type = facts.answer-type(unit.reading, id)
do match tree.nodes[id]
    | .node-string-syntax(row)
        value = make-operand(.operand-constant, ir.add-string(row.text))
    | .node-integer-syntax(row)
        value = emit-integer(id, row.value).operand
    | .node-float-syntax(row)
        value = emit-float(id, row.value).operand
    | .node-identifier(row)
        . plan = facts.plan-of(unit.reading, id)
        if plan == .plan-case
            value = emit-case(id, RowRange'SyntaxId(), false).operand
        else if plan == .plan-enum-value
            value = read-enum(id).operand
        else
            . tracking = row.is-tracked && (live-actions.length != 0 || facts.pulls(unit.reading, id))
            if tracking
                track-name(id, row.name)
            . named = emit-identifier(id, row.name)
            value = named.operand
            if tracking
                track-collection(id, Typed(value, named.type))
    | .node-binary-expression(row)
        . binary = emit-binary(id, row.op, row.lhs, row.rhs)
        value = binary.operand
        if pipes-stream(row.op)
            type = binary.type
    | .node-unary-expression(row)
        value = emit-unary(id, row.op, row.operand).operand
    | .node-held-expression(row)
        value = emit-held(id, row.expr).operand
    | .node-latest-expression(row)
        value = emit-latest(id, row.expr).operand
    | .node-held-read
        . slot = held-slot(id)
        value = slot-value(slot, id).operand
    | .node-match-expression(row)
        . pattern SyntaxId = 0
        if row.subject == 0 && !row.is-optional && row.helper == 0
            do match? tree.nodes[row.body]
                | .node-structure-match(arms)
                    pattern = arms.pattern
        if row.subject != 0 && helper-runs(row.helper)
            . matched = emit-subject-match
                - id
                - row.subject
                - row.body
                - row.is-optional
                - row.helper
                - false
            value = matched.operand
        else
            value = emit-match(id, pattern).operand
    | .node-structure-match(row)
        value = emit-match(id, row.pattern).operand
    | .node-stream-match(row)
        value = emit-scoped-match(id, row.pattern).operand
    | .node-block
        . block = emit-block-value(id, type)
        value = block.operand
        if type == no-type
            type = block.type
    | .node-cast-expression(row)
        if facts.plan-of(unit.reading, id) == .plan-caught-cast
            value = emit-caught-cast(id, row.lhs).operand
        else if facts.plan-of(unit.reading, id) == .plan-reinterpret
            value = reinterpret(id, emit-expression(row.lhs), type).operand
        else if case-cursor-of(row.lhs) != U32.max && cursor-typed
            value = case-cursors[case-cursor-of(row.lhs)].row
        else
            . converted = convert(id, .reason-explicit, emit-expression(row.lhs))
            value = converted.operand
            if converted.type != type
                refuse(.refused-conversion, id)
        .. cursor-typed = case-cursors[case-cursor-of(row.lhs)].type == type
    | .node-type-predicate(row)
        if row.is-contextual
            refuse(.refused-expression, id)
        else
            . emitted = emit-expression(row.expr)
            value = emitted.operand
            if emitted.type != type
                refuse(.refused-conversion, id)
    | .node-function-syntax
        value = emit-closure(id).operand
    | .node-do-task-block(row)
        value = emit-task-value(id, row)
    | .node-c-identifier(row)
        . constant = program.c-constant-text(unit.source-module, row.name)
        if constant
            value = emit-integer(id, constant).operand
        else if is-binding(type)
            value = name-binding(id, type, 0).operand
        else
            refuse(.refused-expression, id)
    | .node-range-expression(row)
        value = emit-range(id, row).operand
    | .node-call-expression(row)
        if is-link(row.callable) && !is-pinned(receiver-of(id))
            value = emit-chained(id).operand
        else
            value = emit-call-at(id, row.callable, row.args).operand
    | .node-optional-chain(row)
        if id != held-chain
            refuse(.refused-expression, id)
        else
            . emitted = emit-expression(row.expr)
            value = emitted.operand
            if emitted.type != type
                refuse(.refused-conversion, id)
    | .node-catch-expression(row)
        if row.catchers.count != 0 && is-caught(row.body)
            value = emit-handled(id, row.body, row.catchers).operand
        else if row.catchers.count != 0 || retyped-body
            refuse(.refused-expression, id)
        else if !is-caught(row.body)
            value = emit-expression(row.body).operand
        else
            value = emit-expression(row.body).operand
            settle-result(id, value)
        .. retyped-body = facts.node-type(unit.reading, row.body) != type
    | .node-use-expression(row)
        value = emit-use(id, row.expr).operand
    | .node-catch-optional-expression(row)
        if is-caught(row.body)
            value = emit-catch-optional(id, row.body).operand
        else
            value = emit-uncaught-optional(id, row.body).operand
    | .node-get-expression(row)
        if is-link(id) && !is-pinned(row.object)
            value = emit-chained(id).operand
        else if row.is-tracked && (live-actions.length != 0 || facts.pulls(unit.reading, id))
            value = emit-tracked-get(id, row.object, row.name).operand
        else
            value = emit-get(id, row.object, row.name).operand
    | .node-index-expression(row)
        . escaped = escaped-event(id)
        if escaped
            value = emit-escape(id, escaped).operand
        else if is-link(id) && !is-pinned(row.object)
            value = emit-chained(id).operand
        else if facts.plan-of(unit.reading, id) == .plan-view || proven-row
            value = emit-view-index(id, row.object, row.index).operand
        else if facts.plan-of(unit.reading, id) == .plan-table
            value = emit-table-index(id, row.object, row.index).operand
        else if facts.plan-of(unit.reading, id) == .plan-item
            value = emit-item(id, row.object, row.index).operand
        else if facts.plan-of(unit.reading, id) == .plan-array-item
            value = emit-array-item(id, row.object, row.index).operand
        else if own-call(id) != no-fact
            value = emit-index-call(id, facts.calls[own-call(id)], row.object, row.index).operand
        else
            value = emit-index(id, row.object).operand
        .. proven-row = facts.plan-of(unit.reading, id) == .plan-proven-row
    | .node-tuple-syntax(row)
        value = emit-tuple(id, row.items).operand
    | .node-header-expression(row)
        value = emit-header(id, row.expr, row.items)
    | .node-list-syntax(row)
        value = emit-list(id, row.items).operand
    | .node-assign(row)
        value = emit-update(id, row.op, row.lhs, row.rhs).operand
    | .node-print(row)
        emit-print(id, row.body)
    | .node-pipeline-expression(row)
        . pipeed = emit-pipe(id, row.op, row.left, row.right)
        value = pipeed.operand
        if pipes-stream(row.op)
            type = pipeed.type
    | .node-iterator-expression(row)
        value = emit-comprehension(id, row.loop).operand
    | .node-iterable-expression(row)
        value = emit-stream(id, row.expr).operand
    | .node-argument(row)
        value = emit-argument-value(id, row)
    | .node-bullet-expression
        . listed = emit-bullet-list(id)
        value = listed.operand
        type = listed.type
    | .node-anonymous-case(row)
        value = emit-case(id, row.args, facts.plan-of(unit.reading, id) == .plan-case-fields).operand
    | .node-state-machine
        value = emit-machine-site(id).operand
    | .node-markup(row)
        value = emit-markup(id, row.id, row.type-id, row.args, row.body).operand
    | .node-slot-outlet(row)
        value = emit-outlet(id, row.name, row.body)
    | .node-markup-read-expression(row)
        if is-link(id) && !is-pinned(row.object)
            value = emit-chained(id).operand
        else
            value = emit-markup-read(id, row.object).operand
    | .node-style-read-expression(row)
        if is-link(id) && !is-pinned(row.object)
            value = emit-chained(id).operand
        else
            value = emit-style-read(id, row.object).operand
    | .node-style-property-expression
        value = emit-style-property(id).operand
    | .node-ref-identifier
        value = emit-address-of(id)
    | .node-type-identifier
        value = type-value(id, type).operand
    | .node-core-type-identifier
        value = type-value(id, type).operand
    | .node-type-arguments
        value = type-value(id, type).operand
    | .node-symbol
        if facts.plan-of(unit.reading, id) == .plan-case
            value = emit-case(id, RowRange'SyntaxId(), false).operand
        else if facts.plan-of(unit.reading, id) == .plan-enum-value
            value = read-enum(id).operand
        else
            refuse(.refused-expression, id)
    ??
        refuse(.refused-expression, id)
= Typed(value, type)

────────────────────
_ is-link Bool
    - id SyntaxId

` Whether a node is a link of an optional chain: a read, a read of a style or of a markup link
` or an index written after `?`, or one of what such a link gives, or a call of one. It is made
` only where its receiver holds a value.
match tree.nodes[id]
    | .node-get-expression(row)
        chains-at(id, row.is-optional) || is-link(row.object)
    | .node-index-expression(row)
        chains-at(id, row.is-optional) || is-link(row.object)
    | .node-style-read-expression(row)
        chains-at(id, row.is-optional) || (row.object != 0 && is-link(row.object))
    | .node-markup-read-expression(row)
        chains-at(id, row.is-optional) || (row.object != 0 && is-link(row.object))
    | .node-call-expression(row)
        is-link(row.callable)
    ??
        false

────────────────────
_ chains-at Bool
    - id SyntaxId
    - is-optional Bool

is-optional && facts.chain-form(unit.reading, id) != .chain-plain

────────────────────
_ links-into Bool
    - id SyntaxId
    - given TypeId
    - expected TypeId

` Whether a value of type `given` is what a link of an optional chain gives by itself, where
` its node has the optional that holds it.
is-link(id) && types.is-optional(expected) && types.optional-inner(expected) == given

────────────────────
_ held-type TypeId
    - id SyntaxId

` The type of what an expression gives where it is read: that of the value pinned for it, or
` the node's own.
if held then pins[held].type else facts.node-type(unit.reading, id)

.. held = pin-of(id)

────────────────────
_ do pin
    - node SyntaxId
    - value Operand
    - type TypeId

` Keeps a value for every reading of an expression, until the pins are dropped back to where
` they stood before.
pins += Pin(node, value, type)

────────────────────
_ do unpin
    - mark Size

while pins.length > mark
    pins.pop()

────────────────────
_ do pin-of Size?
    - id SyntaxId

` Where the value pinned last for an expression is, or nothing when none is.
. position = pins.length
while position != 0
    position -= 1
    if pins[position].node == id
        = position
= null

────────────────────
_ is-pinned Bool
    - id SyntaxId

pin-of(id) != null

────────────────────
_ gives Bool
    - id SyntaxId
    - type TypeId

` Whether a type is that of what a node gives by itself: the node's own, or for a link of an
` optional chain what the optional its node has holds.
type == node || (is-link(id) && types.is-optional(node) && types.optional-inner(node) == type)

.. node = facts.node-type(unit.reading, id)

────────────────────
_ unlinked TypeId
    - id SyntaxId

` The type of what a node gives that is never an optional by itself: the node's own, or for
` a link of an optional chain what the optional its node has holds.
|? is-link(id) && node != no-type && node != invalid-type && types.is-optional(node)
    types.optional-inner(node)
??
    node

.. node = facts.node-type(unit.reading, id)

────────────────────
_ receiver-of SyntaxId
    - id SyntaxId

` The receiver of a call of a link of an optional chain: what the name it calls is read from,
` or for a write to an event, what the event is read from.
match tree.nodes[id]
    | .node-call-expression(row)
        receiver-of(called-link(id, row.callable))
    | .node-get-expression(row)
        row.object
    | .node-index-expression(row)
        row.object
    | .node-style-read-expression(row)
        row.object
    | .node-markup-read-expression(row)
        row.object
    ??
        0u32

────────────────────
_ do emit-chained Typed
    - id SyntaxId

` A link of an optional chain, with the links before it. Where an optional the chain tests
` holds nothing no link after it is made, and the chain gives an optional that holds
` nothing. Where each holds a value, what the last link gives is held by the optional the
` node has, unless it is an optional already. A link that gives nothing gives an optional
` that holds nothing, as TypeScript does, so the chain then says nothing of whether it ran.
. nothing = make-operand(.operand-void, 0)
if is-unmade(id)
    = emit-unmade(id)
. type = facts.node-type(unit.reading, id)
if type == no-type || type == invalid-type || !types.is-optional(type)
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. layout = layout-of(type, id)
if !tables.layouts.is-struct(layout) && !is-null-form(type)
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. skipped = ir.reserve-block()
. joined = ir.reserve-block()
. slot = join-slot(layout)
. mark = joins.length
. linked = emit-within(id, skipped)
if linked.type == types.void-type
    linked = empty-optional(type, layout)
else if linked.type != type
    linked = wrap(id, linked, type)
arrive(id, linked.operand, joined, slot)
ir.start-block(skipped)
arrive(id, empty-optional(type, layout).operand, joined, slot)
= Typed(close-joins(joined, mark, layout, slot), type)

────────────────────
_ is-unmade Bool
    - id SyntaxId

facts.node-type(unit.reading, receiver-of(id)) == types.null-type

────────────────────
_ do emit-unmade Typed ?! Refused
    - id SyntaxId

. object = receiver-of(id)
if object == 0
    refuse(.refused-expression, id)
else if tests-receiver(id)
    emit-expression(object)
else
    emit-unmade(object)
= default-value(0, types.null-type, layout-of(types.null-type, id), id)

────────────────────
_ do emit-within Typed
    - id SyntaxId
    - skipped IRBlockId

` What a link of an optional chain gives by itself, where every optional the chain tests
` holds a value. Control leaves to `skipped` where one holds nothing. The link is the read,
` the index or the call its node is, made of the value its receiver holds as it is made of a
` receiver that is no optional.
. nothing = make-operand(.operand-void, 0)
. object = receiver-of(id)
. inside = held-receiver(id, object, skipped)
. pin-mark = pins.length
pin(object, inside.operand, inside.type)
. linked = emit-link(id)
unpin(pin-mark)
= linked

────────────────────
_ do held-receiver Typed ?! Refused
    - id SyntaxId
    - object SyntaxId
    - skipped IRBlockId

` The value a link of an optional chain is made of. A link written after `?` tests the
` optional before it, which is evaluated once, and is made of what that holds. A link
` written with no `?` after another link is made of what that link gives by itself, with no
` optional between the two, as TypeScript unrolls a chain: one that gives nothing, or an
` optional, has no shape here. A tracked read's object that is a member named alone is
` tracked before it is tested, as `emit-tracked-get` says.
. nothing = make-operand(.operand-void, 0)
if object == 0
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
if !tests-receiver(id)
    . given = emit-within(object, skipped)
    if given.type == types.void-type || types.is-optional(given.type)
        refuse(.refused-expression, id)
    = given
. root = tracked-root(object) if tracks-link(id)
if root
    track(object, unit.self, root)
. receiver = emit-expression(object)
. held = receiver.type
if !types.is-optional(held)
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. tested = present(object, receiver)
. filled = ir.reserve-block()
branch(tested.operand, filled, skipped)
ir.start-block(filled)
= payload(object, Typed(receiver.operand, held))

────────────────────
_ do tracks-link Bool
    - id SyntaxId

` Whether a link of an optional chain is a tracked read made in a live action.
if live-actions.length == 0
    = false
do match? tree.nodes[id]
    | .node-get-expression(row)
        = row.is-tracked
= false

────────────────────
_ tests-receiver Bool
    - id SyntaxId

` Whether a link of an optional chain is written after `?`, or is a call of one that is.
match tree.nodes[id]
    | .node-get-expression(row)
        chains-at(id, row.is-optional)
    | .node-index-expression(row)
        chains-at(id, row.is-optional)
    | .node-style-read-expression(row)
        chains-at(id, row.is-optional)
    | .node-markup-read-expression(row)
        chains-at(id, row.is-optional)
    | .node-call-expression(row)
        tests-receiver(called-link(id, row.callable))
    ??
        false

────────────────────
_ do called-link SyntaxId
    - id SyntaxId
    - callable SyntaxId

if facts.event-uses.length != 0
    . used = tables.event-use-of(unit.reading, id)
    if used && (used.kind == .event-publish || used.kind == .event-route)
        do match? tree.nodes[used.reference]
            | .node-index-expression(row)
                = row.object
        = used.reference
= callable

────────────────────
_ do emit-link Typed
    - id SyntaxId

` A link of an optional chain, made of the value its receiver holds: the read, the read of a
` style, the index or the call the node is, as it is made of a receiver that is no optional.
. nothing = make-operand(.operand-void, 0)
do match? tree.nodes[id]
    | .node-get-expression(row)
        . plan = facts.plan-of(unit.reading, id)
        if row.is-tracked && (live-actions.length != 0 || facts.pulls(unit.reading, id))
            = emit-tracked-get(id, row.object, row.name)
        if plan == .plan-none || plan == .plan-field || plan == .plan-guarded-read || address-plan
            = emit-get(id, row.object, row.name)
        .. address-plan = plan == .plan-address || plan == .plan-reinterpret
    | .node-index-expression(row)
        if facts.plan-of(unit.reading, id) == .plan-item
            = emit-item(id, row.object, row.index)
        if facts.plan-of(unit.reading, id) == .plan-array-item
            = emit-array-item(id, row.object, row.index)
        if own-call(id) != no-fact
            = emit-index-call(id, facts.calls[own-call(id)], row.object, row.index)
        = emit-index(id, row.object)
    | .node-call-expression(row)
        = emit-call-at(id, row.callable, row.args)
    | .node-style-read-expression(row)
        = emit-style-read(id, row.object)
    | .node-style-property-expression
        = emit-style-property(id)
    | .node-markup-read-expression(row)
        = emit-markup-read(id, row.object)
refuse(.refused-expression, id)
= Typed(nothing, no-type)

────────────────────
_ do emit-withheld Typed
    - id SyntaxId
    - op Operator
    - lhs SyntaxId
    - rhs SyntaxId
    - wanted Bool

` An assignment whose value is written after `?`. The value is evaluated first. Where the
` flow knows it to hold a value, it is assigned as any value is. Otherwise it is an optional,
` tested once: where it holds a value, what it holds is assigned, and where it holds nothing
` the place is read and nothing is stored, as TypeScript does. The assignment then gives
` what the place holds: `wanted` says its value is used. Only a place that names storage has
` a shape here, and none that is a link of an optional chain. Nor has a name alone that holds
` an optional, tested so: TypeScript takes it to hold a value afterwards, whatever was stored.
. nothing = make-operand(.operand-void, 0)
. written = 0u32
do match? tree.nodes[rhs]
    | .node-optional-chain(row)
        written = row.expr
if written == 0 || is-link(lhs) || !is-place(lhs)
    refuse(.refused-statement, id)
    = Typed(nothing, no-type)
. given = emit-expression(written)
. held = given.type
. type = facts.node-type(unit.reading, id)
if !types.is-optional(held)
    . known = pins.length
    pin(rhs, given.operand, held)
    . plain = Typed(nothing, no-type)
    if wanted
        plain = emit-update(id, op, lhs, rhs)
    else
        emit-assign(id, op, lhs, rhs)
    unpin(known)
    = plain
. named = match tree.nodes[lhs]
    | .node-identifier
        true
    ??
        false
. kept-type = facts.node-type(unit.reading, lhs)
if op == .eq-op && named && optional-kept
    refuse(.refused-statement, id)
    = Typed(nothing, no-type)
.. optional-kept = kept-type == no-type || kept-type == invalid-type || types.is-optional(kept-type)
. layout = if wanted then layout-of(type, id) else void-layout
. tested = present(written, given)
. filled = ir.reserve-block()
. empty = ir.reserve-block()
. joined = ir.reserve-block()
. slot = if wanted then join-slot(layout) else nothing
. mark = joins.length
branch(tested.operand, filled, empty)
ir.start-block(filled)
. inside = payload(written, Typed(given.operand, held))
. pin-mark = pins.length
pin(rhs, inside.operand, inside.type)
. assignment = emit-assign(id, op, lhs, rhs)
unpin(pin-mark)
if wanted && assignment.stored.type != type
    refuse(.refused-conversion, id)
if wanted
    arrive(id, assignment.stored.operand, joined, slot)
else
    jump(joined)
ir.start-block(empty)
. kept = emit-expression(lhs)
if wanted && kept.type != type
    refuse(.refused-conversion, id)
if wanted
    arrive(id, kept.operand, joined, slot)
    = Typed(close-joins(joined, mark, layout, slot), type)
jump(joined)
ir.start-block(joined)
= Typed(nothing, kept.type)

────────────────────
_ do emit-chained-assign
    - id SyntaxId
    - op Operator
    - lhs SyntaxId
    - rhs SyntaxId

` An assignment to a place that is a link of an optional chain. The value is evaluated,
` whatever the chain holds, and then the chain up to the place, in TypeScript's order for `=`,
` which an assigning operator, whose place TypeScript reads first, follows here too. Where each
` optional it tests holds a value, the value is converted and stored as it is in a place
` written with no chain, by an assigning operator what it gives for the place and the value,
` and where one holds nothing, nothing is stored.
. object = receiver-of(lhs)
if object == 0
    refuse(.refused-statement, id)
    =
. made = emit-expression(rhs)
. value = apart(made, rhs, true)
. given = made.type
if is-unmade(lhs)
    emit-unmade(lhs)
    =
. skipped = ir.reserve-block()
. held = held-receiver(lhs, object, skipped)
. pin-mark = pins.length
pin(object, held.operand, held.type)
pin(rhs, value, given)
emit-assign(id, op, lhs, rhs)
unpin(pin-mark)
jump(skipped)
ir.start-block(skipped)

────────────────────
_ do emit-caught-cast Typed
    - id SyntaxId
    - lhs SyntaxId

` A cast out of a union written under `catch`: what the union holds as the case asked for,
` as the value of what may be an error, and where it holds another case the error that is
` elsewhere the message of the panic raised. The error is given no source and no trace.
. nothing = make-operand(.operand-void, 0)
. type = facts.node-type(unit.reading, id)
. layout = layout-of(type, id)
. made-error = instances.report.union-error
if !carries-error(type) || !tables.layouts.is-union(layout) || in-zone
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
if tables.layouts.rows[layout].cases.count != 2 || made-error == no-instance
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
if tables.instance-functions[made-error] == no-function
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. value = emit-expression(lhs)
. first = tables.layouts.case-field(layout, 0)
. second = tables.layouts.case-field(layout, 1)
. made = frame(layout)
zero(made, layout)
. failed = ir.reserve-block()
. joined = ir.reserve-block()
. own-matching = matching
. jumps = fail-jumps
matching = matching.failing = failed
. held = convert(id, .reason-explicit, value)
matching = own-matching
if held.type != first.type
    refuse(.refused-conversion, id)
put(made, first, held.operand, id)
jump(joined)
if fail-jumps != jumps
    ir.start-block(failed)
    . mark = pending.length
    for position in 0 .. < instances.signatures[made-error].args.count
        pending += absent-argument(id, instances.argument-type(made-error, position)).operand
    . error = nothing
    . called = call-instance(made-error, id, mark)
    error = called.operand
    if called.type != second.type
        refuse(.refused-conversion, id)
    store(made, 0, integer(.machine-u8, 1), false, id)
    put(made, second, error, id)
    jump(joined)
ir.start-block(joined)
= Typed(made, type)

────────────────────
_ do emit-handled Typed
    - id SyntaxId
    - body SyntaxId
    - catchers RowRange'SyntaxId
    - dropped Bool = false

` An expression with handlers: what it gives where no error was raised in its place, and
` else what the first handler that takes the error gives. A handler is a pattern the error
` is matched against, with what it captures, and its body. An error the type pass said no
` handler takes leaves the function, as one raised there would. A handler whose body is a
` block runs its statements, and its last gives the value. A handler that gives an
` error raises nothing: the whole is then a value that may be that error. An expression
` whose own value is an error has no shape here. One written as a statement, whose value is
` `dropped`, gives nothing: each handler runs its body for what it does. An error that came
` back outside the zone the collector never sees is handled there, and a handler that goes on
` enters the zone again where the caller runs in it. A handler the type pass found can not
` match is passed over. An optional chain to a call that raises is tested first: where it
` made no call the whole gives `null` as the type pass joined it, and handlers take the errors
` of the call it made.
. nothing = make-operand(.operand-void, 0)
. type = facts.node-type(unit.reading, id)
. fact = facts.constant-of(unit.reading, id)
if facts.plan-of(unit.reading, id) != .plan-handled || fact == no-fact
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. leaving = facts.constants[fact].bits
. raw = emit-expression(body)
. answer = take-zone-answer()
. zoned = in-zone
. held = raw.type
. absent = no-block
if types.is-optional(held) && carries-error(types.optional-inner(held))
    . tested = present(id, raw)
    . filled = ir.reserve-block()
    absent = ir.reserve-block()
    branch(tested.operand, filled, absent)
    ir.start-block(filled)
    raw = payload(id, Typed(raw.operand, held))
    held = raw.type
if !carries-error(held)
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. layout = layout-of(held, id)
. gives = !dropped && type != no-type && type != invalid-type && type != types.void-type
. made = if gives then layout-of(type, id) else void-layout
. first = tables.layouts.case-field(layout, 0)
if extends(first.type, types.error-type)
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. joined = ir.reserve-block()
. slot = if gives then join-slot(made) else nothing
. mark = joins.length
. given = ir.reserve-block()
. raised = ir.reserve-block()
branch(case-test(id, raw.operand, 0), given, raised)
ir.start-block(given)
settle-zone-answer(id, answer)
if gives
    give-handled(id, Typed(take(raw.operand, first, id), first.type), type, joined, slot)
else
    jump(joined)
ir.start-block(raised)
if closes-zone(answer)
    close-zone(id)
if answer != 0
    in-zone = false
for catcher in tree.children[catchers]
    do match? tree.nodes[catcher]
        | .node-catcher(row)
            if facts.plan-of(unit.reading, catcher) == .plan-never
                continue
            . next = ir.reserve-block()
            . named = bound.length
            emit-pattern(row.type, Typed(raw.operand, held), next)
            if !gives
                emit-block(row.body)
                rejoin-zone(id, answer, zoned)
                jump(joined)
            else if !arm-raises(row.body)
                . expression = only-expression(row.body)
                if is-block(row.body)
                    . opened = open-cleanups.length
                    . own-scoping = scoping
                    scoping = scoping.block-base = opened
                    if expression == 0
                        expression = emit-leading(row.body)
                    if expression == 0
                        refuse(.refused-expression, row.body)
                    else
                        . value = emit-expression(expression)
                        . closed = close-value(value, opened, own-scoping, expression)
                        rejoin-zone(id, answer, zoned)
                        give-handled(id, closed, type, joined, slot)
                else if expression == 0
                    refuse(.refused-expression, row.body)
                else
                    . value = emit-expression(expression)
                    rejoin-zone(id, answer, zoned)
                    give-handled(id, value, type, joined, slot)
            drop-bound(named)
            ir.start-block(next)
. bit U64 = 1
for index in 1 .. < tables.layouts.rows[layout].cases.count
    . place = bit
    bit = bit * 2
    if (leaving /and/ place) == 0
        continue
    . field = tables.layouts.case-field(layout, index)
    . leaves = ir.reserve-block()
    . next = ir.reserve-block()
    branch(case-test(id, raw.operand, index), leaves, next)
    ir.start-block(leaves)
    leave-with(take(raw.operand, field, id), field.type, id)
    ir.start-block(next)
return-zero(.return-normal)
in-zone = zoned
if absent != no-block
    ir.start-block(absent)
    if gives
        give-handled
            - id
            - default-value(0, types.null-type, layout-of(types.null-type, id), id)
            - type
            - joined
            - slot
    else
        jump(joined)
if !gives
    ir.start-block(joined)
    = Typed(nothing, types.void-type)
. result = close-joins(joined, mark, made, slot)
= Typed(result, type)

────────────────────
_ do give-handled
    - id SyntaxId
    - value Typed
    - type TypeId
    - joined IRBlockId
    - slot Operand

` Leaves what one side of an expression with handlers gives for the whole. Where the whole
` is a value that may be an error, because some handler gives one, a side that gives an
` error is held as the case of its class or of the nearest above it, and any other side as
` the value. Else the side is converted as the sides record for its type, and one that
` gives an error has no shape.
. given = value
. is-error = extends(given.type, types.error-type)
if !carries-error(type)
    if is-error
        refuse(.refused-expression, id)
        =
    if given.type != type
        given = join(id, Typed(value.operand, given.type))
    if given.type != type
        refuse(.refused-conversion, id)
    arrive(id, given.operand, joined, slot)
    =
. layout = layout-of(type, id)
if is-error
    . index = error-case-of(layout, given.type)
    if index == U32.max
        refuse(.refused-expression, id)
        =
    given = make-union(id, type, index, Typed(value.operand, tables.layouts.case-field(layout, index).type))
else
    . inner = tables.layouts.case-field(layout, 0).type
    if given.type != inner
        given = join(id, Typed(value.operand, given.type))
    if given.type != inner
        refuse(.refused-conversion, id)
    given = make-union(id, type, 0, given)
arrive(id, given.operand, joined, slot)

────────────────────
_ do arm-leaves Bool
    - arm SyntaxId
    - body SyntaxId

` Whether an arm gives its match no value because what it gives is an error, which the type
` pass planned to leave the function at the arm. It is emitted here: the error is evaluated
` and raised, and what follows is never run. A panic given so has no shape here.
if facts.plan-of(unit.reading, arm) != .plan-raise
    = false
. expression = only-expression(body)
if expression == 0
    refuse(.refused-expression, body)
    = true
. raised = emit-expression(expression)
if !extends(raised.type, types.error-type) || extends(raised.type, types.panic-type)
    refuse(.refused-expression, expression)
    = true
leave-with(raised.operand, raised.type, arm)
ir.start-block(ir.reserve-block())
= true

────────────────────
_ do arm-raises Bool
    - body SyntaxId

` Whether the body of an arm that is to give a value leaves in place of it, as the type pass
` noted: its last statement raises under no condition, returns, or goes on to a loop's next
` turn or out of it. The body is emitted here, and what follows it is never run.
if !facts.is-leaving(unit.reading, body)
    = false
emit-block(body)
= true

────────────────────
_ is-caught Bool
    - body SyntaxId

` Whether what is written under `catch` is a call, whose errors are what the catch holds, an
` operator or an index a function answers, or a cast, which the type pass planned to give an
` error where it is out of a union and fails. Nothing else has a shape there.
match tree.nodes[body]
    | .node-call-expression
        true
    | .node-index-expression
        own-call(body) != no-fact
    | .node-identifier
        true
    | .node-get-expression
        true
    | .node-cast-expression
        true
    | .node-unary-expression
        own-call(body) != no-fact
    | .node-binary-expression
        own-call(body) != no-fact
    ??
        false

────────────────────
_ do emit-catch-optional Typed
    - id SyntaxId
    - body SyntaxId

` `catch? value`: what the expression gives as an optional, which holds nothing where an
` error was raised in its place. An expression that raises nothing gives its value so, and
` one that gives nothing or an optional gives it as it is. A value that is itself an optional
` and may be an error is that optional, or one that holds nothing where an error was raised.
. nothing = make-operand(.operand-void, 0)
. type = facts.node-type(unit.reading, id)
. raw = emit-expression(body)
. raw-type = raw.type
settle-result(id, raw.operand)
if types.is-optional(raw-type) && carries-error(types.optional-inner(raw-type))
    = catch-held(id, Typed(raw.operand, raw-type), type)
if !carries-error(raw-type)
    if raw-type == type
        = Typed(raw.operand, raw-type)
    = wrap(id, Typed(raw.operand, raw-type), type)
= caught(id, Typed(raw.operand, raw-type), type)

────────────────────
_ do emit-uncaught-optional Typed
    - id SyntaxId
    - body SyntaxId

` `catch? value` over what is no call and so raises nothing: the value as an optional.
. type = facts.node-type(unit.reading, id)
. raw = emit-expression(body)
if carries-error(raw.type)
    refuse(.refused-expression, id)
    = raw
if raw.type == type
    = raw
= wrap(id, raw, type)

────────────────────
_ do catch-held Typed
    - id SyntaxId
    - raw Typed
    - type TypeId

` `catch?` of an optional that holds a value or an error raised in its place, as an optional
` chain to a call that raises gives: nothing where it holds nothing, and otherwise what holds
` the value, or nothing where an error was raised.
. nothing = make-operand(.operand-void, 0)
. held = raw.type
. made-layout = layout-of(type, id)
. tested = present(id, raw)
. given = ir.reserve-block()
. other = ir.reserve-block()
. joined = ir.reserve-block()
. slot = join-slot(made-layout)
. mark = joins.length
branch(tested.operand, given, other)
ir.start-block(given)
. inner = payload(id, Typed(raw.operand, held))
. made = caught(id, inner, type)
arrive(id, made.operand, joined, slot)
ir.start-block(other)
arrive(id, empty-optional(type, made-layout).operand, joined, slot)
= Typed(close-joins(joined, mark, made-layout, slot), type)

────────────────────
_ do caught Typed
    - id SyntaxId
    - raw Typed
    - type TypeId

` What holds the value of an expression that may be an error raised in its place, or nothing
` where one was raised.
. nothing = make-operand(.operand-void, 0)
. layout = layout-of(raw.type, id)
. made-layout = layout-of(type, id)
. nullable = is-null-form(type)
if !tables.layouts.is-union(layout) || !types.is-optional(type) || unstructured
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
.. unstructured = !tables.layouts.is-struct(made-layout) && !nullable
. field = tables.layouts.case-field(layout, 0)
. held = types.optional-inner(type)
if field.type == type || (nullable && field.type == held)
    . slot = join-slot(made-layout)
    . mark = joins.length
    . given = ir.reserve-block()
    . other = ir.reserve-block()
    . joined = ir.reserve-block()
    branch(case-test(id, raw.operand, 0), given, other)
    ir.start-block(given)
    arrive(id, take(raw.operand, field, id), joined, slot)
    ir.start-block(other)
    arrive(id, empty-optional(type, made-layout).operand, joined, slot)
    = Typed(close-joins(joined, mark, made-layout, slot), type)
if nullable
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. inner = tables.layouts.field(made-layout, 0)
. flag = tables.layouts.field(made-layout, 1)
. holds = field.layout != void-layout
if types.is-optional(field.type) || (holds && (field.type != held || field.layout != inner.layout))
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
if !holds && inner.layout != i8-layout
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. made = frame(made-layout)
zero(made, made-layout)
empty-texts(made, 0, type, made-layout, id)
. given = ir.reserve-block()
. joined = ir.reserve-block()
branch(case-test(id, raw.operand, 0), given, joined)
ir.start-block(given)
if holds
    put(made, inner, take(raw.operand, field, id), id)
store(made, flag.offset, integer(.machine-i8, 1), false, id)
jump(joined)
ir.start-block(joined)
= Typed(made, type)

────────────────────
_ carries-error Bool
    - type TypeId

` Whether a type is a value or one of the errors raised in its place.
match types.rows[type]
    | .type-result
        true
    ??
        false

────────────────────
_ do emit-held Typed ?! Refused
    - id SyntaxId
    - expr SyntaxId

` The middle of a chain of orderings is evaluated once, and its value is kept under its slot
` for the ordering that reads it. The value has the node's type.
. nothing = make-operand(.operand-void, 0)
. slot = held-slot(id)
. offset = slot-offset(slot, id)
. value = emit-expression(expr)
if value.type != facts.node-type(unit.reading, id)
    refuse(.refused-conversion, id)
    = Typed(nothing, no-type)
unit.kept[offset] = value.operand
unit.kept-types[offset] = value.type
= value

────────────────────
_ do emit-latest Typed
    - id SyntaxId
    - value SyntaxId

` The latest item of a stream, `##` of it, as the reference reads it in a live action. Where
` the action is made, the stream is made a `Broadcastable` and given, with the empty value of
` its item, to a `BroadcasterTracker`, which is kept in the local the node declares and added
` to the action's trackers, and the read is that empty value. The function that runs the
` action again adds the tracker it captures to its trackers and reads its `latest`. A read
` where no action is open, or in a function written in the action, has no shape here.
. nothing = make-operand(.operand-void, 0)
. row = facts.latest-read-of(unit.reading, id)
. binding = instances.rows[unit.reading].binding
if !row || binding == no-binding || live-actions.length == 0
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. resolution = bindings.resolution-of(binding, id)
if resolution.kind != .resolve-slot
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. slot = resolution.slot
. item = facts.node-type(unit.reading, id)
. tracking = instances.signatures[row.tracker].returns
. trackers = live-actions[live-actions.length - 1].next
. own = is-own-slot(slot) && owns(slot)
if rerunning && !own
    . kept = read-captured(slot, id, tracking)
    add-tracker(load-local(trackers, id), convert(id, .reason-argument, Typed(kept.operand, tracking)).operand, id)
    = load-property(id, kept.operand, tracking, program.store-atom("latest"), false, item)
if rerunning || !own
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. held = emit-expression(value)
. stream = Typed(nothing, no-type)
if row.publisher != no-instance
    . mark = pending.length
    pending += convert(value, .reason-argument, held).operand
    stream = call-instance(row.publisher, id, mark)
else
    stream = convert(value, .reason-argument, held)
if stream.type != row.stream
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. latest = default-value(0, item, layout-of(item, id), id)
. making = pending.length
pending += stream.operand
pending += latest.operand
. made = call-instance(row.tracker, id, making)
keep-captured(slot, made.operand, tracking, id)
add-tracker(load-local(trackers, id), convert(id, .reason-argument, Typed(made.operand, tracking)).operand, id)
= Typed(latest.operand, item)

────────────────────
_ do held-by U32
    - ordering SyntaxId

` The place of the slot an ordering keeps its right side under, for the ordering after it in
` a chain. No place for any other expression.
do match? tree.nodes[ordering]
    | .node-binary-expression(row)
        do match? tree.nodes[row.rhs]
            | .node-held-expression
                . slot = held-slot(row.rhs)
                = slot-offset(slot, row.rhs)
= no-place

────────────────────
_ do held-slot SlotId
    - id SyntaxId

` The slot the middle of a chain of orderings is kept under, which the node that holds it
` and the node that reads it both resolve to.
. binding = instances.rows[unit.reading].binding
if binding != no-binding
    . resolution = bindings.resolution-of(binding, id)
    if resolution.kind == .resolve-slot && bindings.slots[resolution.slot].kind == .slot-held
        = resolution.slot
refuse(.refused-expression, id)
= unit.slot-start

────────────────────
_ do slot-value Typed ?! Refused
    - slot SlotId
    - id SyntaxId

` The value kept under the slot of a chain's middle, for the ordering that reads it. It is
` there only in the right side of the `&&` whose left side holds it: every path to that side
` has evaluated the middle. The value has the node's type.
. nothing = make-operand(.operand-void, 0)
. offset = slot-offset(slot, id)
if offset != unit.open-held || operand-kind(unit.kept[offset]) == .operand-void
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
if unit.kept-types[offset] != facts.node-type(unit.reading, id)
    refuse(.refused-conversion, id)
    = Typed(nothing, no-type)
= Typed(unit.kept[offset], unit.kept-types[offset])

────────────────────
_ do is-consumable Bool
    - id SyntaxId

` Whether every conversion recorded at a node is one a shape here applies.
. fact = facts.first-conversion(unit.reading, id)
while fact != no-fact
    . row = facts.conversions[fact]
    if !is-applied(row.reason)
        = false
    fact = row.next
= true

────────────────────
_ is-applied Bool
    - reason ConversionReason

` Whether some shape here applies the conversions recorded for a reason. Generated content
` applies the object of its markup element made a `MarkupElement`, and the function that builds
` it made a `MarkupSlotBuilder`, at the line that builds it (`generate-content`). A write to an
` event that bubbles applies its object made an `EventNode` (`emit-publish`, `emit-route`).
|? reason == .reason-argument || reason == .reason-print || reason == .reason-operand
    true
|? reason == .reason-markup-host || reason == .reason-markup-slot || reason == .reason-markup-arm
    true
|? reason == .reason-explicit || reason == .reason-return || reason == .reason-join
    true
|? reason == .reason-literal-return
    true
|? reason == .reason-promotion || reason == .reason-result
    true
|? reason == .reason-assignment || reason == .reason-declaration || reason == .reason-element
    true
|? reason == .reason-receiver || reason == .reason-default || reason == .reason-relation
    true
|? reason == .reason-own-receiver || reason == .reason-event-node
    true
??
    reason == .reason-operator || reason == .reason-step || reason == .reason-piped

────────────────────
_ do emit-integer Typed
    - id SyntaxId
    - text String

` An integer literal as a number of the type it is written as: its bits cut to the width of
` the type and extended by the sign of its layout, or the float nearest it. A unit whose
` class has a constructor is constructed from the number.
. nothing = make-operand(.operand-void, 0)
. literal = parse-integer-literal(text)
if literal.overflow
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. type = written-type(id)
. layout = layout-of(type, id)
if is-float(layout)
    . magnitude = literal.value as F64
    = construct-unit
        - id
        - float-number(layout, if literal.negative then -magnitude else magnitude)
        - type
if !is-integer(layout)
    refuse(.refused-type, id)
    = Typed(nothing, no-type)
. bits = if literal.negative then 0 - literal.value else literal.value
. width = types.completions[builtin-number(types, type)].bit-size
if width == 0
    refuse(.refused-type, id)
    = Typed(nothing, no-type)
if width < 64
    . mask = (1u64 /lshift/ width) - 1
    . is-negative = (bits /zrshift/ (width - 1)) /and/ 1 == 1
    bits = bits /and/ mask
    if is-negative && is-signed(layout) && width == tables.layouts.rows[layout].size * 8
        bits = bits /or/ (U64.max - mask)
= construct-unit(id, integer(tables.layouts.kind-of(layout), bits), type)

────────────────────
_ do written-type TypeId
    - id SyntaxId

` The type a number is written as: its node's, or with a unit whose class has a constructor
` the type of what the constructor takes, which the type pass recorded as a call at the node.
. call = answering(facts.first-call(unit.reading, id))
if call == no-fact
    = facts.node-type(unit.reading, id)
. row = facts.calls[call]
. called = row.callee != no-instance && !row.is-partial && row.next == no-fact
. constructs = row.form == .call-constructor || row.form == .call-this-constructor
if !called || !constructs || instances.signatures[row.callee].args.count != 1
    refuse(.refused-expression, id)
    = no-type
= instances.argument-type(row.callee, 0)

────────────────────
_ do construct-unit Typed
    - id SyntaxId
    - number Operand
    - type TypeId

` A number as its literal gives it: the number itself, or with a unit whose class has a
` constructor what the constructor returns for the number.
. call = answering(facts.first-call(unit.reading, id))
if call == no-fact
    = Typed(number, type)
. mark = pending.length
pending += number
. made = call-instance(facts.calls[call].callee, id, mark)
if made.type != facts.node-type(unit.reading, id)
    refuse(.refused-conversion, id)
= made

────────────────────
_ do emit-float Typed
    - id SyntaxId
    - text String

` A float literal as the float of the type it is written as nearest to what it writes. A
` unit whose class has a constructor is constructed from the number.
. nothing = make-operand(.operand-void, 0)
. type = written-type(id)
. layout = layout-of(type, id)
if !is-float(layout)
    refuse(.refused-type, id)
    = Typed(nothing, no-type)
for index in 0 .. < text.length
    . char = text[index]
    . is-digit = char >= '0' && char <= '9'
    . is-sign = char == '+' || char == '-'
    if !is-digit && !is-sign && char != '.' && char != 'e' && char != 'E'
        refuse(.refused-expression, id)
        = Typed(nothing, no-type)
= construct-unit(id, float-number(layout, text as F64), type)

────────────────────
_ do float-number Operand
    - layout LayoutId
    - value F64

= make-operand(.operand-number, ir.add-float(tables.layouts.kind-of(layout), value))

────────────────────
_ do integer Operand
    - kind MachineKind
    - bits U64

= make-operand(.operand-number, ir.add-number(kind, bits))

────────────────────
_ do convert Typed
    - site SyntaxId
    - reason ConversionReason
    - value Typed
    - raised SyntaxId = 0
    - shared Bool = false

` Applies the conversions the type pass recorded at a site for one reason, in order. A panic
` one of them raises is raised at the site, or at the node given for it. The name of a lazy
` local that its one read evaluates has the conversion of that read recorded at the value it
` is declared with, and takes there the ones that convert what was read. A text written in
` source that a function returns has its conversion recorded for a reason of its own. A stream
` piped through a function keeps the conversion of the function at the pipe beside those of
` its own value, and only those that take the value's type apply there, as they do where the
` value is `shared` by calls that each recorded its own.
. result = value
. found = false
. several = shared || keeps-several(site)
. fact = facts.first-conversion(unit.reading, site)
while fact != no-fact
    . row = facts.conversions[fact]
    . fits = row.reason == reason || literal-return
        .. literal-return = reason == .reason-return && row.reason == .reason-literal-return
    if fits && (!several || row.from == result.type)
        result = convert-one(site, row, result, raised)
        found = true
    fact = row.next
if found || !unit.inlines
    = result
. declared = inlined-value(site)
if declared == 0
    = result
fact = facts.first-conversion(unit.reading, declared)
while fact != no-fact
    . row = facts.conversions[fact]
    if row.reason == reason && row.from == result.type
        result = convert-one(site, row, result, raised)
    fact = row.next
= result

────────────────────
_ do keeps-several Bool
    - site SyntaxId

` Whether a node keeps the conversions of several values: a stream piped through a function,
` a subscription an object owns, where the subscriber, the subscription and its tracker are
` each converted, or the name of a keyed event whose endpoint the receiver claims, where the
` endpoint and its tracker are.
if tables.owned-subscription-of(unit.reading, site) || claimed-or-read
    = true
.. claimed-or-read = facts.address-claim-of(unit.reading, site) || facts.latest-read-of(unit.reading, site)
do match? tree.nodes[site]
    | .node-pipeline-expression(row)
        = pipes-stream(row.op)
    | .node-binary-expression(row)
        = pipes-stream(row.op)
= false

────────────────────
_ do inlined-value SyntaxId
    - id SyntaxId

` The value a lazy local is declared with, for a node that is the one read of the local and
` evaluates it. No node for any other.
if id == 0 || unit.instance == no-instance || unit.reading != unit.instance
    = 0
. binding = instances.rows[unit.instance].binding
if binding == no-binding
    = 0
do match? tree.nodes[id]
    | .node-identifier
        . resolution = bindings.resolution-of(binding, id)
        if resolution.kind == .resolve-slot && bindings.lazy-inlines(resolution.slot)
            do match? tree.nodes[bindings.slots[resolution.slot].group]
                | .node-declare(declaration)
                    = declaration.right
= 0

────────────────────
_ do convert-fill Typed
    - site SyntaxId
    - value Typed

` Converts what a constructor fills a property from to the property's type. The type pass
` records the conversion at the argument, or at the property, which is no node of the
` constructor's body.
if facts.first-conversion(unit.reading, site) != no-fact
    = convert(site, .reason-assignment, value)
. result = value
. fact = tables.loose-conversion(unit.instance, site, result.type)
while fact != no-fact
    . held = result.type
    result = convert-one(site, facts.conversions[fact], result)
    fact = if result.type != held then next-conversion else no-fact
        .. next-conversion = tables.loose-conversion(unit.instance, site, result.type)
= result

────────────────────
_ do convert-self Typed
    - site SyntaxId
    - reason ConversionReason

` The object being made converted as the type pass recorded at a site, which may be no node of
` the function's body, as `convert-fill` finds it. Refused where none was recorded.
if facts.first-conversion(unit.reading, site) != no-fact
    = convert(site, reason, Typed(unit.self, instances.rows[unit.reading].self-type))
. fact = tables.loose-conversion(unit.reading, site, instances.rows[unit.reading].self-type, reason)
if fact == no-fact
    refuse(.refused-function, site)
    = Typed(unit.self, no-type)
= convert-one(site, facts.conversions[fact], Typed(unit.self, instances.rows[unit.reading].self-type))

────────────────────
_ do convert-from Typed
    - site SyntaxId
    - reason ConversionReason
    - value Operand

` Applies the conversions the type pass recorded at a site for one reason, as `convert` does,
` to a value of the type the first of them converts from.
. fact = facts.first-conversion(unit.reading, site)
while fact != no-fact
    . row = facts.conversions[fact]
    if row.reason == reason
        = convert(site, reason, Typed(value, row.from))
    fact = row.next
refuse(.refused-conversion, site)
= Typed(value, no-type)

────────────────────
_ do convert-one Typed ?! Refused
    - site SyntaxId
    - row ConversionFact
    - value Typed
    - raised SyntaxId = 0

` Applies one conversion the type pass recorded to a value of the type it converts from, as the
` reference converts it; an unwrap that fails is reported at `raised` where one is given.
if row.from != value.type
    refuse(.refused-conversion, site)
    = value
. kind = row.kind
if row.runs != no-instance || row.casts
    = make-function(site, row, value.operand)
if row.from == types.null-type && types.is-optional(row.to)
    . empty = layout-of(row.to, site)
    if !tables.layouts.is-struct(empty) && !is-null-form(row.to)
        refuse(.refused-conversion, site)
    = empty-optional(row.to, empty)
if kind == .relation-wrap-cast && row.case-index != U32.max
    = wrap-case(site, row, value)
if intrinsic(row.from) == .union
    . to-text = row.to == types.string-type
    if to-text && (kind == .relation-unwrap-cast || kind == .relation-string-cast)
        = union-text(site, row, value.operand)
    if kind == .relation-unwrap-cast || kind == .relation-down-cast
        = unwrap-case(if raised == 0 then site else raised, row, value.operand)
    if kind == .relation-final-cast && intrinsic(row.to) == .union
        = rewrap(site, row, value.operand)
if kind == .relation-unwrap-cast && view-shape(row.from) == 4 && row.to == viewed-item(row.from)
    = row-item(site, value.operand, row.from)
if kind == .relation-unwrap-cast && holds-row(row.from) && row.to == table-row-type(row.from)
    = table-row-item(site, value.operand, row.from)
if kind == .relation-unwrap-cast && holds-row(row.from) && union-row
    = shared-base(site, value.operand, row.from, row.to)
.. union-row = intrinsic(table-row-type(row.from)) == .union
if kind == .relation-side-cast && view-shape(row.from) != 0 && view-shape(row.to) != 0
    = Typed(value.operand, row.to)
if kind == .relation-side-cast && intrinsic(row.to) == .table-span && intrinsic(row.from) == .tuple
    = zip-span(site, value.operand, row.from, row.to)
if kind == .relation-unwrap-cast && optional-from && types.null-case(row.to) != U32.max
    = unwrap-or-null(site, row, value)
.. optional-from = types.is-optional(row.from)
if kind == .relation-unwrap-cast && types.is-optional(row.from) && text-to-pointer
    = text-or-null(site, row, value)
.. text-to-pointer = is-text(types.optional-inner(row.from)) && intrinsic(row.to) == .cpointer
if kind == .relation-unwrap-cast && types.is-optional(row.from)
    . held = unwrap(if raised == 0 then site else raised, value)
    if held.type == row.to
        = held
    if intrinsic(held.type) == .union && row.case-index != U32.max
        . inner = row
        inner.from = held.type
        = unwrap-case(if raised == 0 then site else raised, inner, held.operand)
    . scalar = is-numeric-type(held.type) || intrinsic(held.type) == .cpointer
    if row.callee == no-instance && scalar && scalar-target
        = cast(site, held, row.to)
    .. scalar-target = is-numeric-type(row.to) || intrinsic(row.to) == .cpointer
    if row.callee == no-instance && tables.is-class(held.type) && intrinsic(row.to) == .cpointer
        = cast(site, held, row.to)
    if row.callee == no-instance && interface-value && intrinsic(row.to) == .cpointer
        = held-object(site, held.operand, row.to)
    .. interface-value = intrinsic(held.type) == .interface
    if row.callee == no-instance && union-value && intrinsic(row.to) == .cpointer
        = union-object(site, held, row.to)
    .. union-value = intrinsic(held.type) == .union
    if row.callee == no-instance && tables.is-class(held.type) && descends(row.to, held.type)
        = down-cast
            - if raised == 0 then site else raised
            - held.operand
            - row.to
            - row.reason == .reason-declaration
    refuse(.refused-conversion, site)
    = value
if kind == .relation-same
    if layout-of(row.from, site) != layout-of(row.to, site)
        refuse(.refused-conversion, site)
    = Typed(value.operand, row.to)
if kind == .relation-interface-cast
    = make-interface(site, row.from, row.to, value.operand)
if kind == .relation-string-cast && intrinsic(row.from) == .type-relation && is-text(row.to)
    = Typed(value.operand, row.to)
if kind == .relation-equal
    = equalize(site, value, row.to, row.ratio)
if kind == .relation-up-cast && tables.is-class(row.from) && tables.is-class(row.to)
    = Typed(value.operand, row.to)
. declared = row.reason == .reason-declaration
if kind == .relation-down-cast && tables.is-class(row.from) && tables.is-class(row.to)
    = down-cast(if raised == 0 then site else raised, value.operand, row.to, declared)
if kind == .relation-interface-down-cast && tables.is-class(row.from)
    = subclass-interface(if raised == 0 then site else raised, value.operand, row.from, row.to, declared)
if kind == .relation-interface-down-cast
    = held-as(if raised == 0 then site else raised, value.operand, row.to, declared)
if kind == .relation-up-cast || kind == .relation-string-cast
    if is-text(row.from) && is-text(row.to)
        = Typed(value.operand, row.to)
if kind == .relation-up-cast && is-aggregate(row.from) && is-aggregate(row.to)
    . base = layout-of(row.to, site)
    . derived = layout-of(row.from, site)
    if !is-leading(base, derived)
        refuse(.refused-conversion, site)
        = value
    . led = snapshot(value.operand, base, site)
    = Typed(led, row.to)
if kind == .relation-string-cast && row.parts != no-fact && is-text(row.to)
    = tuple-text(site, row, value.operand)
if kind == .relation-final-cast && row.parts != no-fact
    = recast(site, row, value.operand)
if final-or-side && row.to == types.bool-type && row.callee != no-instance
    . asked = tables.instance-functions[row.callee]
    . raises = asked != no-function && asked-panics
        .. asked-panics = tables.functions[asked].may-panic || tables.raises-through(row.callee)
    if raises && !function.may-panic
        refuse(.refused-conversion, site)
        = value
    . tested = ask-empty(site, value, row.callee)
    = Typed(tested.operand, row.to)
.. final-or-side = kind == .relation-final-cast || kind == .relation-side-cast
if kind == .relation-final-cast && plain-bool && is-number(layout-of(row.from, site))
    = cast(site, value, row.to)
.. plain-bool = row.to == types.bool-type && row.parts == no-fact
if kind == .relation-final-cast && row.to == types.bool-type && row.parts == no-fact && from-pointer
    = compare-zero(site, value, .compare-not-equal)
.. from-pointer = intrinsic(row.from) == .cpointer
if kind == .relation-string-cast && is-text(row.to) && void-return
    = Typed(make-operand(.operand-constant, ir.add-string("")), row.to)
.. void-return = row.reason == .reason-return && intrinsic(row.from) == .void
if kind == .relation-string-cast && is-text(row.to)
    . text = string-cast-text(types, row.from)
    if text && (row.reason != .reason-return || intrinsic(row.from) != .void)
        = Typed(make-operand(.operand-constant, ir.add-string(text)), row.to)
if kind == .relation-side-cast
    if types.is-optional(row.to) && !types.is-optional(row.from)
        . held = if row.parts == no-fact then value else convert-one(site, parts-row, value)
            .. parts-row = facts.conversion-parts[row.parts]
        = wrap(site, held, row.to)
    if both-optional && row.parts != no-fact && !holds-atom(row.to)
        = rehouse(site, row, value)
    .. both-optional = types.is-optional(row.to) && types.is-optional(row.from)
    if is-text(row.to) && intrinsic(row.from) == .cpointer
        = adopt(site, value.operand, row.to)
    if intrinsic(row.to) == .cpointer && intrinsic(row.from) == .interface
        = held-object(site, value.operand, row.to)
    if intrinsic(row.to) == .cpointer && intrinsic(row.from) == .union
        = union-object(site, value, row.to)
    = cast(site, value, row.to)
if kind == .relation-converter && row.callee == no-instance && row.to == types.bool-type
    if types.is-optional(row.from)
        = present(site, value)
if kind == .relation-fromverter && row.callee == no-instance
    = number-enum(site, row, value.operand)
. gives = kind == .relation-converter
if kind == .relation-fromverter && row.callee != no-instance
    gives = instances.argument-type(row.callee, 0) == row.from
if gives && row.callee != no-instance
    . raising = instances.signatures[row.callee].errors.count != 0
    . mark = pending.length
    pending += value.operand
    takes-result = raising
    . converted = call-method(row.callee, site, mark)
    takes-result = false
    if raising
        converted = settle-raise(if raised == 0 then site else raised, row, converted.operand)
    if converted.type != row.to
        refuse(.refused-conversion, site)
    = converted
refuse(.refused-conversion, site)
= value

────────────────────
_ do make-interface Typed
    - site SyntaxId
    - from TypeId
    - to TypeId
    - value Operand

` A value converted to an interface: memory in the frame that holds the value and its
` witness table. An object's table is the one the table of its class holds for the
` interface, so an object held as a class it is derived from has its own. A value of an
` interface derived from the one asked for keeps what it holds, and its table is that
` interface's section of the one it has. A value that is no object is boxed, and its table
` is the one of its type, named here; code the collector never sees boxes nothing.
. nothing = make-operand(.operand-void, 0)
. layout = layout-of(to, site)
if layout != tables.layouts.interface-layout
    refuse(.refused-conversion, site)
    = Typed(nothing, no-type)
. second = tables.layouts.field(layout, 1).offset
. held = value
. table = nothing
. witness = tables.witness-of(from, to)
if intrinsic(from) == .interface
    . offset = tables.section-offset(from, to)
    if offset == no-slot-index
        refuse(.refused-conversion, site)
        = Typed(nothing, no-type)
    held = load(value, 0, managed-layout, site)
    table = load(value, second, pointer-layout, site)
    if offset != 0
        table = address(table, offset * table-slot-size, pointer-layout, site)
else if tables.is-class(from) && witness != no-slot-index && slotted-witness
    . class-table = load(value, 0, pointer-layout, site)
    . place = table-header-size + tables.witnesses[witness].slot * table-slot-size
    table = load(class-table, place, pointer-layout, site)
else if witness != no-slot-index && !tables.is-class(from) && !in-zone
    held = box(site, from, value)
    table = make-operand(.operand-symbol, tables.witnesses[witness].symbol)
else
    refuse(.refused-conversion, site)
    = Typed(nothing, no-type)
.. slotted-witness = tables.witnesses[witness].slot != no-slot-index
. made = frame(layout)
store(made, 0, held, false, site)
store(made, second, table, false, site)
= Typed(made, to)

────────────────────
_ do box Operand
    - site SyntaxId
    - type TypeId
    - value Operand

` What an interface value holds of a value that is no object: a whole number widened to
` the size of a pointer, and anything else a copy in an object the collector owns.
. nothing = make-operand(.operand-void, 0)
. layout = layout-of(type, site)
if layout == void-layout
    refuse(.refused-conversion, site)
    = nothing
if is-integer(layout)
    = num-cast(site, value, layout, u64-layout)
. shape = tables.layouts.rows[layout]
. mark = pending.length
pending += integer(.machine-u64, shape.size)
if shape.is-managed
    pending += make-operand(.operand-descriptor, layout)
else
    pending += integer(.machine-pointer, 0)
. made = call-runtime(.runtime-allocate-object, site, mark, managed-layout)
if tables.layouts.is-struct(layout)
    copy(made, value, layout, shape.is-managed, site)
else
    store(made, 0, value, shape.is-managed, site)
= made

────────────────────
_ do unbox Typed
    - site SyntaxId
    - type TypeId
    - source Operand

` What an interface value holds, as its type holds it: an object as it is, a whole number
` narrowed again, and anything else a copy of what the object it was boxed in holds.
if tables.is-class(type)
    = Typed(load(source, 0, managed-layout, site), type)
. layout = layout-of(type, site)
if layout == void-layout
    refuse(.refused-conversion, site)
    = Typed(source, no-type)
if is-integer(layout)
    = Typed(num-cast(site, load(source, 0, u64-layout, site), u64-layout, layout), type)
. held = load(source, 0, managed-layout, site)
if tables.layouts.is-struct(layout)
    = Typed(snapshot(held, layout, site), type)
= Typed(load(held, 0, layout, site), type)

────────────────────
_ do settle-raise Typed
    - site SyntaxId
    - row ConversionFact
    - result Operand

` The value of a conversion by a function that raises errors, as the type pass settled it:
` an error leaves the function, or is a panic where the value is a text written in source.
` Where the type pass settled nothing there is no shape.
if row.raise == .raise-leaves
    = propagate(site, row.callee, result)
if row.raise == .raise-panics
    = panic-on-error(site, row.callee, result)
refuse(.refused-conversion, site)
= Typed(result, no-type)

────────────────────
_ do number-enum Typed
    - site SyntaxId
    - row ConversionFact
    - value Operand

` A whole number converted to an enum by its place: the value the enum declares at that
` place, counted from zero in the order declared, which the module that declares it made as
` it started. For any other number the enum is constructed with nothing given, by the call
` the type pass recorded at the node.
. nothing = make-operand(.operand-void, 0)
. made = no-fact
. fact = facts.first-call(unit.reading, site)
while fact != no-fact
    if facts.calls[fact].form == .call-enum-default
        made = fact
    fact = facts.calls[fact].next
. counted = layout-of(row.from, site)
. layout = layout-of(row.to, site)
. module ModuleId = U32.max
. decl DeclId = 0
do match? types.rows[row.to]
    | .type-class(class)
        module = class.module
        decl = class.decl
if made == no-fact || !is-integer(counted) || module >= program.modules.length
    refuse(.refused-conversion, site)
    = Typed(nothing, no-type)
. owner = program.modules[module]
. joined = ir.reserve-block()
. slot = join-slot(layout)
. mark = joins.length
. place U32
for index in 0 .. < owner.decls.length
    do match? owner.decls[index]
        | .decl-case(case)
            if case.owner == decl
                . kept = tables.storage-of(module, index as DeclId)
                if kept == no-storage || not-enum || place > 127
                    refuse(.refused-conversion, site)
                else if tables.storage[kept].type != row.to
                    refuse(.refused-conversion, site)
                else
                    . taken = ir.reserve-block()
                    . next = ir.reserve-block()
                    . number = integer(tables.layouts.kind-of(counted), place)
                    branch(compare(site, .compare-equal, value, number), taken, next)
                    ir.start-block(taken)
                    arrive(site, load-global(tables.storage[kept], site).operand, joined, slot)
                    ir.start-block(next)
                    place += 1
                .. not-enum = tables.global-kind(module, index as DeclId) != .global-enum
. object = emit-fact-call(site, facts.calls[made], 0, RowRange'SyntaxId(), 0, 0, row.to)
if object.type != row.to
    refuse(.refused-conversion, site)
arrive(site, object.operand, joined, slot)
. answer = close-joins(joined, mark, layout, slot)
= Typed(answer, row.to)

────────────────────
_ do make-union Typed
    - site SyntaxId
    - type TypeId
    - index U32
    - held Typed

` A union that holds one case: memory in the frame with nothing set, the number of the case
` in its first byte, and behind it what the case holds, which is of the case's type.
. layout = layout-of(type, site)
if !tables.layouts.is-union(layout) || index >= tables.layouts.rows[layout].cases.count
    refuse(.refused-conversion, site)
    = held
. field = tables.layouts.case-field(layout, index)
if field.type != held.type
    refuse(.refused-conversion, site)
    = held
. made = frame(layout)
zero(made, layout)
store(made, 0, integer(.machine-u8, index), false, site)
put(made, field, held.operand, site)
= Typed(made, type)

────────────────────
_ do wrap-case Typed
    - site SyntaxId
    - row ConversionFact
    - value Typed

` A value as the case of a union the type pass picked for it: converted as the conversion's
` one part says to what the case holds.
if row.parts == no-fact
    refuse(.refused-conversion, site)
    = Typed(value.operand, no-type)
. held = convert-one(site, facts.conversion-parts[row.parts], value)
= make-union(site, row.to, row.case-index, held)

────────────────────
_ do text-or-null Typed
    - site SyntaxId
    - row ConversionFact
    - value Typed

. layout = layout-of(row.to, site)
. holds = present(site, value)
. filled = ir.reserve-block()
. empty = ir.reserve-block()
. joined = ir.reserve-block()
branch(holds.operand, filled, empty)
ir.start-block(filled)
. pointer = cast(site, payload(site, Typed(value.operand, row.from)), row.to)
. from-filled = ir.current
jump(joined)
ir.start-block(empty)
. from-empty = ir.current
jump(joined)
ir.start-block(joined)
= Typed(phi(layout, pointer.operand, from-filled, integer(.machine-pointer, 0), from-empty), row.to)

────────────────────
_ do unwrap-or-null Typed
    - site SyntaxId
    - row ConversionFact
    - value Typed

` An optional made a union that has a case for null: what it holds converted as the
` conversion's one part says, or where it holds nothing the union holding null.
. layout = layout-of(row.to, site)
if row.parts == no-fact || !tables.layouts.is-union(layout)
    refuse(.refused-conversion, site)
    = Typed(value.operand, no-type)
. made = frame(layout)
. holds = present(site, value)
. filled = ir.reserve-block()
. empty = ir.reserve-block()
. done = ir.reserve-block()
branch(holds.operand, filled, empty)
ir.start-block(filled)
. converted = convert-one(site, facts.conversion-parts[row.parts], payload(site, Typed(value.operand, row.from)))
if converted.type != row.to
    refuse(.refused-conversion, site)
copy(made, converted.operand, layout, false, site)
jump(done)
ir.start-block(empty)
. none = tables.layouts.values[types.null-type]
. nothing = if none == managed-layout || none == pointer-layout then integer(none as MachineKind, 0) else make-operand(.operand-void, 0)
. union = make-union(site, row.to, types.null-case(row.to), Typed(nothing, types.null-type))
copy(made, union.operand, layout, false, site)
jump(done)
ir.start-block(done)
= Typed(made, row.to)

────────────────────
_ do case-test Operand
    - site SyntaxId
    - value Operand
    - index U32

` Whether a union holds the case of a number.
= compare(site, .compare-equal, load(value, 0, u8-layout, site), integer(.machine-u8, index))

────────────────────
_ do holding-branch
    - site SyntaxId
    - value Operand
    - layout LayoutId
    - row ConversionFact
    - matched IRBlockId
    - missed IRBlockId

` Leaves to `matched` where a union holds the case the type pass picked for a type, or, where
` that case is of the class asked for or of one it derives from, a case of a class below the
` class, whose object is one of it too, or a case of a class above it whose object is of it,
` and to `missed` where it holds none of them. Each such case holds its object where the picked
` case does, so it is read as one.
. field = tables.layouts.case-field(layout, row.case-index)
. lined = tables.is-class(row.to) && (field.type == row.to || derived-field)
    .. derived-field = tables.is-class(field.type) && descends(row.to, field.type)
if !lined
    branch(case-test(site, value, row.case-index), matched, missed)
    =
. cases = types.cases-of(row.from)
for index in 0 .. < cases.length
    . held = cases[index].type
    if held == no-type || !tables.is-class(held)
        continue
    . below = held == row.to || descends(held, row.to)
    if !below && !descends(row.to, held)
        continue
    . other = tables.layouts.case-field(layout, index as U32)
    if other.offset != field.offset || other.layout != field.layout
        refuse(.refused-conversion, site)
        continue
    . taken = ir.reserve-block()
    . passed = ir.reserve-block()
    branch(case-test(site, value, index as U32), taken, passed)
    ir.start-block(taken)
    if below
        jump(matched)
    else
        class-branch(site, take(value, other, site), row.to, matched, passed)
    ir.start-block(passed)
jump(missed)

────────────────────
_ do descends Bool
    - type TypeId
    - ancestor TypeId

` Whether a class is below another, the classes it is of followed up from it.
. current = types.base-of(type) ?? no-type
while current != no-type
    if current == ancestor
        = true
    current = types.base-of(current) ?? no-type
= false

────────────────────
_ do unwrap-case Typed
    - site SyntaxId
    - row ConversionFact
    - value Operand

` What a union holds as the case the type pass picked, where any other case is a panic: of
` a declaration, which is a pattern, that the pattern did not match. Inside a pattern a case
` that is an optional of the type asked for matches where it holds a value, and gives that.
` A case of a number or pointer type is converted to the one asked for. A case of any other
` type than the one asked for, or than a class it derives from, has no shape here.
. layout = layout-of(row.from, site)
if !tables.layouts.is-union(layout) || row.case-index >= tables.layouts.rows[layout].cases.count
    refuse(.refused-conversion, site)
    = Typed(value, no-type)
. field = tables.layouts.case-field(layout, row.case-index)
if matching.failing != no-block && field.type != row.to && holds(field.type, row.to)
    pass-or-fail(case-test(site, value, row.case-index), matching.failing)
    = unwrap(site, Typed(take(value, field, site), field.type))
. lined = field.type == row.to || (both-classes && descends(row.to, field.type))
    .. both-classes = tables.is-class(row.to) && tables.is-class(field.type)
. converts = !lined && converts-scalar(field.type, row.to)
if (!lined && !converts) || (!function.may-panic && matching.failing == no-block)
    refuse(.refused-conversion, site)
    = Typed(value, no-type)
if matching.failing != no-block
    . passed = ir.reserve-block()
    holding-branch(site, value, layout, row, passed, matching.failing)
    fail-jumps += 1
    ir.start-block(passed)
    = held-case(site, value, field, row.to)
. matched = ir.reserve-block()
. missed = ir.reserve-block()
holding-branch(site, value, layout, row, matched, missed)
ir.start-block(missed)
if row.reason == .reason-declaration
    raise-text(site, "Pattern match failed")
else
    raise-union-error(site)
ir.start-block(matched)
= held-case(site, value, field, row.to)

────────────────────
_ converts-scalar Bool
    - from TypeId
    - to TypeId

|? !intrinsic-is-numeric(intrinsic(from)) || !intrinsic-is-numeric(intrinsic(to))
    false
??
    !types.completions[from].has-equalities || !types.completions[to].has-equalities

────────────────────
_ do held-case Typed
    - site SyntaxId
    - value Operand
    - field LayoutField
    - target TypeId

. held = take(value, field, site)
if field.type == target || tables.is-class(target)
    = Typed(held, target)
= cast(site, Typed(held, field.type), target)

────────────────────
_ do union-text Typed
    - site SyntaxId
    - row ConversionFact
    - value Operand

` A union as text: the name of a case that holds no value of its own, and of any other what
` it holds made text as the part for the case says. The cases are tested in their order.
. nothing = make-operand(.operand-void, 0)
. layout = layout-of(row.from, site)
if !tables.layouts.is-union(layout)
    refuse(.refused-conversion, site)
    = Typed(value, no-type)
. joined = ir.reserve-block()
. mark = joins.length
. part = row.parts
. index U32
for fact in types.cases-of(row.from)
    if part == no-fact
        break
    . taken = ir.reserve-block()
    . passed = ir.reserve-block()
    branch(case-test(site, value, index), taken, passed)
    ir.start-block(taken)
    . text = nothing
    if fact.is-default
        . name = fact.name
        text = make-operand(.operand-constant, ir.add-string(if name then name.text else ""))
    else
        . field = tables.layouts.case-field(layout, index)
        . converted = convert-one(site, facts.conversion-parts[part], Typed(take(value, field, site), field.type))
        text = converted.operand
        if converted.type != types.string-type
            refuse(.refused-conversion, site)
    arrive(site, text, joined, nothing)
    ir.start-block(passed)
    part = facts.conversion-parts[part].next
    index += 1
if part != no-fact || index != tables.layouts.rows[layout].cases.count
    refuse(.refused-conversion, site)
arrive(site, make-operand(.operand-constant, ir.add-string("")), joined, nothing)
= Typed(close-joins(joined, mark, managed-layout, nothing), row.to)

────────────────────
_ do rewrap Typed
    - site SyntaxId
    - row ConversionFact
    - value Operand

` A union as another union: what it holds is made the case of the other that the part for
` its own case says. The cases are tested in their order, and the last is what is left.
. target = layout-of(row.to, site)
. layout = layout-of(row.from, site)
if !tables.layouts.is-union(layout) || !tables.layouts.is-union(target)
    refuse(.refused-conversion, site)
    = Typed(value, no-type)
. count = tables.layouts.rows[layout].cases.count
. joined = ir.reserve-block()
. slot = join-slot(target)
. mark = joins.length
. part = row.parts
. index U32
while index < count && part != no-fact
    . tests = index + 1 != count
    . passed IRBlockId = 0
    if tests
        . taken = ir.reserve-block()
        passed = ir.reserve-block()
        branch(case-test(site, value, index), taken, passed)
        ir.start-block(taken)
    . field = tables.layouts.case-field(layout, index)
    . made = convert-one(site, facts.conversion-parts[part], Typed(take(value, field, site), field.type))
    if made.type != row.to
        refuse(.refused-conversion, site)
    arrive(site, made.operand, joined, slot)
    if tests
        ir.start-block(passed)
    part = facts.conversion-parts[part].next
    index += 1
if part != no-fact || index != count
    refuse(.refused-conversion, site)
= Typed(close-joins(joined, mark, target, slot), row.to)

────────────────────
_ do emit-case-number Typed
    - id SyntaxId
    - object SyntaxId

` `case` of a union: the number of the case it holds, which is the byte it starts with.
. held = emit-whole(object)
. layout = layout-of(held.type, id)
. type = facts.node-type(unit.reading, id)
. counted = layout-of(type, id)
if !tables.layouts.is-union(layout) || counted != u8-layout
    refuse(.refused-expression, id)
    = held
= Typed(load(held.operand, 0, u8-layout, id), type)

────────────────────
_ do emit-case-text Typed
    - id SyntaxId
    - object SyntaxId
    - plan OperatorPlan

` `name` or `type` of a union: the name of the case it holds, or the key of that case's
` type. The number of the case is compared with each case's in turn, and the text is the
` empty one where it is none of them, as TypeScript's chain ends. A case with no name has
` the empty text for its name, and a case that holds no value has the type of its number.
. nothing = make-operand(.operand-void, 0)
. held = emit-whole(object)
. union = held.type
. layout = layout-of(union, id)
. text-layout = layout-of(types.string-type, id)
if !tables.layouts.is-union(layout) || facts.node-type(unit.reading, id) != types.string-type
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. cases = types.cases-of(union)
. count = tables.layouts.rows[layout].cases.count
if cases.length != count
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. number = load(held.operand, 0, u8-layout, id)
. joined = ir.reserve-block()
. mark = joins.length
for index in 0 .. < count
    . matched = ir.reserve-block()
    . next = ir.reserve-block()
    branch(compare(id, .compare-equal, number, integer(.machine-u8, index)), matched, next)
    ir.start-block(matched)
    . text = ""
    if plan == .plan-case-type
        text = type-runtime-key(types, tables.layouts.case-field(layout, index).type)
    else if cases[index].name
        text = cases[index].name!.text
    arrive(id, make-operand(.operand-constant, ir.add-string(text)), joined, nothing)
    ir.start-block(next)
arrive(id, make-operand(.operand-constant, ir.add-string("")), joined, nothing)
= Typed(close-joins(joined, mark, text-layout, nothing), types.string-type)

────────────────────
_ do emit-case-value Typed
    - id SyntaxId
    - object SyntaxId

` A union read by the name of one of its cases, whose number the type pass recorded: what
` the union holds where it holds that case, and where it holds another the value a local of
` the case's type has with nothing written for it, as TypeScript gives: for one made by a
` constructor, the construction the type pass recorded at the node.
. nothing = make-operand(.operand-void, 0)
. type = facts.node-type(unit.reading, id)
. constant = facts.constant-of(unit.reading, id)
. held = emit-whole(object)
. layout = layout-of(held.type, id)
. given = layout-of(type, id)
if constant == no-fact || !tables.layouts.is-union(layout)
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. index = facts.constants[constant].bits as U32
if index >= tables.layouts.rows[layout].cases.count
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. field = tables.layouts.case-field(layout, index)
if field.type != type || field.layout == void-layout
    refuse(.refused-conversion, id)
    = Typed(nothing, no-type)
. matched = ir.reserve-block()
. other = ir.reserve-block()
. joined = ir.reserve-block()
. slot = join-slot(given)
. mark = joins.length
branch(case-test(id, held.operand, index), matched, other)
ir.start-block(matched)
arrive(id, take(held.operand, field, id), joined, slot)
ir.start-block(other)
. first = default-value(id, type, given, id)
arrive(id, first.operand, joined, slot)
= Typed(close-joins(joined, mark, given, slot), type)

────────────────────
_ do emit-whole Typed
    - object SyntaxId

` The receiver of a member a union answers: its value, or for a local read as the one case
` the flow knows it to hold, the union the local holds, whose member it is.
if facts.plan-of(unit.reading, object) != .plan-case-read || is-pinned(object)
    = emit-expression(object)
. binding = instances.rows[unit.reading].binding
if binding != no-binding && unit.reading == unit.instance
    do match? tree.nodes[object]
        | .node-identifier
            . resolution = bindings.resolution-of(binding, object)
            if resolution.kind == .resolve-slot && names-local
                . offset = slot-offset(resolution.slot, object)
                . held = facts.slot-type(unit.instance, offset)
                . whole = read-local(resolution.slot, object, held)
                = Typed(whole.operand, held)
            .. names-local = bindings.slots[resolution.slot].kind == .slot-local
refuse(.refused-expression, object)
= Typed(make-operand(.operand-void, 0), no-type)

────────────────────
_ do answer-count U32
    - id SyntaxId

` How many of the calls recorded at a node answer for its value.
. count U32
. fact = facts.first-call(unit.reading, id)
while fact != no-fact
    if answers-node(facts.calls[fact].form)
        count += 1
    fact = facts.calls[fact].next
= count

────────────────────
_ do nth-answer FactId
    - id SyntaxId
    - position U32

` The call recorded at a node that answers for its value, by its place among those that do.
. left = position
. fact = facts.first-call(unit.reading, id)
while fact != no-fact
    if answers-node(facts.calls[fact].form)
        if left == 0
            = fact
        left -= 1
    fact = facts.calls[fact].next
= no-fact

────────────────────
_ do emit-forward Typed
    - id SyntaxId
    - object SyntaxId
    - operands RowRange'SyntaxId
    - name Atom? = null

` A member of a union that each case answers with its own, as the type pass planned it.
` 1. The union is evaluated, and then the arguments written, once each, in their order. A
`    row of a table of unions is gathered as the case it holds where the member is made in
`    place: TypeScript reads the case's cells where the member is stable, and gathers them
`    where it is not.
` 2. Where a case may panic or let errors out, the function made for the member, TypeScript's
`    `union-dispatch-N`, is called with them. Errors it answers with leave the function the
`    call is in. Such a member with no function made for it has no shape. Any other is made
`    in place, as `dispatch-cases` makes it.
. nothing = make-operand(.operand-void, 0)
. type = facts.node-type(unit.reading, id)
if tables.forward-unbuilt(unit.reading, id)
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. held = emit-whole(object)
. whole = held.type
. dispatch = tables.forward-function(unit.reading, id)
if dispatch == no-function && holds-row(whole)
    held = table-row-item(id, held.operand, whole)
    whole = held.type
. union = if holds-row(whole) then table-row-type(whole) else whole
. layout = layout-of(union, id)
if !tables.layouts.is-union(layout) || type == no-type || type == invalid-type
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. disturbed = false
for argument in tree.children[operands]
    if !is-inert(argument)
        disturbed = true
held = Typed(apart(Typed(held.operand, whole), object, disturbed), whole)
. pin-mark = pins.length
for argument in tree.children[operands]
    . expression = argument-value(argument)
    . made = emit-expression(expression)
    . value = apart(made, expression, true)
    if made.type != facts.node-type(unit.reading, expression)
        refuse(.refused-conversion, expression)
    pin(expression, value, made.type)
. answer = Typed(nothing, no-type)
if dispatch != no-function
    answer = call-forward(id, dispatch, held.operand, pin-mark, type)
else
    answer = dispatch-cases(id, object, operands, held.operand, layout, type, name)
unpin(pin-mark)
= answer

────────────────────
_ do call-forward Typed
    - id SyntaxId
    - dispatch FunctionId
    - held Operand
    - pin-mark Size
    - type TypeId

` A call of the function made for a member a union forwards, with the union and the
` arguments pinned from `pin-mark` on. It answers the member's value, or with the errors the
` cases let out, which leave the function the call is in. Where the collector never looks the
` call leaves that zone, as a call of each case's member would.
. nothing = make-operand(.operand-void, 0)
. forward = tables.forward-of(dispatch)
. target = tables.functions[dispatch]
. raising = forward.result != no-type
. returned = if raising then forward.result else type
. returns = layout-of(returned, id)
if in-zone && raising
    refuse(.refused-expression, id)
. mark = pending.length
pending += held
for position in pin-mark .. < pins.length
    pending += pins[position].value
ir.depend(.callee-function, dispatch, if target.may-panic then may-panic-dependency else 0u32)
. checked = target.may-panic && !in-landing
. crosses = in-zone
if crosses
    cross-zone(id, false)
. result = call
    - make-operand(.operand-symbol, target.symbol)
    - id
    - mark
    - .callee-function
    - returns
    - checked
if crosses
    cross-zone(id, true)
if raising
    = propagate-held(id, forward.result, result)
= Typed(result, returned)

────────────────────
_ holds-row Bool
    - type TypeId

` Whether a value is a row of a table, as a receiver a union's member is forwarded from.
intrinsic(type) == .table-row || intrinsic(type) == .immutable-table-row

────────────────────
_ do dispatch-cases Typed
    - id SyntaxId
    - object SyntaxId
    - operands RowRange'SyntaxId
    - held Operand
    - layout LayoutId
    - type TypeId
    - name Atom? = null

` A member of a union as each case answers it, with the union held and the arguments
` pinned.
` 1. The number of the case the union holds is read once and compared with each case's in
`    turn. The last case is the one left.
` 2. The member is made of what the union holds as that case: the call the type pass
`    recorded for the case, which it records in the order of the cases, or with no call
`    recorded the property the case stores, read by name.
` What a case gives in another type than the node's takes the conversion recorded at the
` node for that type, as one side of a join does.
. nothing = make-operand(.operand-void, 0)
. count = tables.layouts.rows[layout].cases.count
. answered = answer-count(id)
if count == 0 || (answered != 0 && answered != count) || unnamed-call
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
.. unnamed-call = answered == 0 && (!name || operands.count != 0)
. gives = type != types.void-type
. given = if gives then layout-of(type, id) else void-layout
. joined = ir.reserve-block()
. slot = if gives then join-slot(given) else nothing
. mark = joins.length
. tag = if count > 1 then load(held, 0, u8-layout, id) else nothing
for index in 0 .. < count
    . next = no-block
    if index + 1 < count
        . matched = ir.reserve-block()
        next = ir.reserve-block()
        branch(compare(id, .compare-equal, tag, integer(.machine-u8, index)), matched, next)
        ir.start-block(matched)
    . field = tables.layouts.case-field(layout, index)
    . inside = take(held, field, id)
    . case-mark = pins.length
    pin(object, inside, field.type)
    . answer = Typed(nothing, no-type)
    if answered == 0
        answer = load-property(id, inside, field.type, name!, true)
    else
        . fact = facts.calls[nth-answer(id, index)]
        answer = emit-fact-call(id, fact, object, operands, 0, 0, case-answer(fact))
    unpin(case-mark)
    if answer.type != type
        answer = join(id, answer)
    if answer.type != type
        refuse(.refused-conversion, id)
    if gives
        arrive(id, answer.operand, joined, slot)
    else
        jump(joined)
    if index + 1 < count
        ir.start-block(next)
if !gives
    ir.start-block(joined)
    = Typed(nothing, type)
= Typed(close-joins(joined, mark, given, slot), type)

────────────────────
_ case-answer TypeId
    - fact CallFact

` What the call of a case answers: the value, or what holds it or an error where the call
` raises errors that do not leave with it.
|? fact.callee == no-instance
    no-type
|? signature.errors.count != 0 && !fact.propagates
    signature.result
??
    signature.returns

.. signature = instances.signatures[fact.callee]

────────────────────
_ runs-on-row Bool
    - callee InstanceId
    - row TypeId

` Whether a member runs on a row: one of a case on the case's cells, or one of a base every
` case shares on the row itself.
instances.rows[callee].row-receiver == row || instances.rows[callee].self-type == row

────────────────────
_ do emit-forward-set
    - id SyntaxId
    - op Operator
    - lhs SyntaxId
    - object SyntaxId
    - rhs SyntaxId

` An assignment to a member of a union that each case answers with its own setter, as the
` type pass planned it. The value is evaluated, and then the union, once each. Both are given
` to the function made for the member where a case may panic, and else each case is set in
` place.
. count-answered = answer-count(lhs)
if op != .eq-op || object == 0 || count-answered == 0 || tables.forward-unbuilt(unit.reading, lhs)
    refuse(.refused-statement, id)
    =
. made = emit-expression(rhs)
. value = apart(made, rhs, !is-inert(object))
. given = made.type
. held = emit-whole(object)
. layout = layout-of(held.type, id)
if !tables.layouts.is-union(layout) || tables.layouts.rows[layout].cases.count != count-answered
    refuse(.refused-statement, id)
    =
. pin-mark = pins.length
pin(rhs, value, given)
. dispatch = tables.forward-function(unit.reading, lhs)
if dispatch != no-function
    call-forward(lhs, dispatch, held.operand, pin-mark, types.void-type)
else
    set-cases(id, lhs, object, rhs, held.operand, layout)
unpin(pin-mark)

────────────────────
_ do set-cases
    - id SyntaxId
    - lhs SyntaxId
    - object SyntaxId
    - rhs SyntaxId
    - held Operand
    - layout LayoutId

` A setter of a union as each case answers it, with the union held and the value pinned: the
` setter the type pass recorded for the case the union holds, which it records in the order
` of the cases, is called on what the union holds with the value.
. count-answered = answer-count(lhs)
. joined = ir.reserve-block()
for index in 0 .. < count-answered
    . fact = facts.calls[nth-answer(lhs, index)]
    if fact.form != .call-setter
        refuse(.refused-statement, id)
        break
    . next = no-block
    if index + 1 < count-answered
        . matched = ir.reserve-block()
        next = ir.reserve-block()
        branch(case-test(id, held, index), matched, next)
        ir.start-block(matched)
    . field = tables.layouts.case-field(layout, index)
    . inside = take(held, field, id)
    . case-mark = pins.length
    pin(object, inside, field.type)
    emit-setter(lhs, object, rhs, fact)
    unpin(case-mark)
    jump(joined)
    if index + 1 < count-answered
        ir.start-block(next)
ir.start-block(joined)

────────────────────
_ do emit-case Typed
    - id SyntaxId
    - operands RowRange'SyntaxId
    - fields Bool

` A case of a union named at a node, as the type pass planned it: with the value it is
` called with, with a tuple or struct made of the fields it is called with, or named alone
` with the number a case with no value of its own holds. One called with a value or fields is
` made in place, where TypeScript calls the constructor it generates for the case, as the IR
` notes.
. nothing = make-operand(.operand-void, 0)
. type = facts.node-type(unit.reading, id)
. constant = facts.constant-of(unit.reading, id)
. layout = layout-of(type, id)
if constant == no-fact || !tables.layouts.is-union(layout)
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. index = facts.constants[constant].bits as U32
if index >= tables.layouts.rows[layout].cases.count
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. field = tables.layouts.case-field(layout, index)
. held = Typed(nothing, no-type)
if fields
    held = emit-case-fields(id, field, operands)
else if operands.count == 1
    . given = tree.children[operands.start]
    held = convert(given, .reason-argument, emit-expression(argument-value(given)))
else if operands.count == 0 && types.cases-of(type)[index].is-default
    held = Typed(integer(.machine-u8, index), field.type)
else
    refuse(.refused-expression, id)
. made = make-union(id, type, index, held)
if fields || operands.count != 0
    ir.note-made-call()
= made

────────────────────
_ do run-case-owner
    - callable SyntaxId

` What is run before a case called after its type is made: the type, when it is more than a
` name. A case called by its symbol alone runs nothing.
do match? tree.nodes[callable]
    | .node-get-expression(get)
        run-type-operand(get.object)

────────────────────
_ do emit-case-fields Typed
    - id SyntaxId
    - field LayoutField
    - operands RowRange'SyntaxId

` The tuple or struct a case holds, made of the arguments the case is called with: each is
` converted as recorded at it and stored to the next field written with a value.
. nothing = make-operand(.operand-void, 0)
if !tables.layouts.is-struct(field.layout) || !is-aggregate(field.type)
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. made = frame(field.layout)
zero(made, field.layout)
. range = types.completions[field.type].properties
. position U32
for offset in 0 .. < range.count
    . property = types.properties[range.start + offset]
    if property.storage-kind != .storage-eager
        continue
    if position >= operands.count
        refuse(.refused-expression, id)
        = Typed(nothing, no-type)
    . given = tree.children[operands.start + position]
    . value = convert(given, .reason-argument, emit-expression(argument-value(given)))
    . target = tables.layouts.field(field.layout, property.slot)
    if value.type != target.type
        refuse(.refused-conversion, given)
        = Typed(nothing, no-type)
    put(made, target, value.operand, given)
    position += 1
if position != operands.count
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
= Typed(made, field.type)

────────────────────
_ do adopt Typed
    - site SyntaxId
    - value Operand
    - target TypeId

` Text copied from the C chars a pointer leads to. The runtime function that copies polls, so
` it is called between two polls, and the panic signal is read again after it. A function
` the collector never sees has no shape for it.
. returns = layout-of(target, site)
. mark = pending.length
pending += value
. text = call-polling(.runtime-string-adopt, site, mark, returns)
= Typed(text, target)

────────────────────
_ do call-polling Operand
    - callee RuntimeFunction
    - site SyntaxId
    - mark Size
    - returns LayoutId

` A call of a runtime function that polls, with the pending arguments from `mark` on. It is
` called between two polls, and the panic signal is read again after it. A function the
` collector never sees has no shape for it.
if in-zone || !ir.signals
    refuse(.refused-blocking-call, site)
    drop-pending(mark)
    = make-operand(.operand-void, 0)
poll(site)
. result = call-runtime(callee, site, mark, returns)
poll(site)
append(.op-load-panic-signal, site, Span(), 0)
. resumed = ir.reserve-block()
branch(make-operand(.operand-panic-signal, 0), landing-block(site), resumed)
ir.start-block(resumed)
= result

────────────────────
_ do tuple-text Typed
    - site SyntaxId
    - row ConversionFact
    - value Operand

` A tuple or struct as text: `(`, each field made text as its part says with `, ` between,
` and `)`, joined by the runtime.
. layout = layout-of(row.from, site)
if !tables.layouts.is-struct(layout)
    refuse(.refused-conversion, site)
    = Typed(value, no-type)
. count = tables.layouts.rows[layout].fields.count
. text = make-operand(.operand-constant, ir.add-string("("))
. position U32
. part = row.parts
while part != no-fact && position < count
    . fact = facts.conversion-parts[part]
    . field = tables.layouts.field(layout, position)
    . piece = convert-one(site, fact, Typed(take(value, field, site), field.type))
    if position != 0
        text = concat(site, text, make-operand(.operand-constant, ir.add-string(", ")))
    text = concat(site, text, piece.operand)
    position += 1
    part = fact.next
if part != no-fact || position != count
    refuse(.refused-conversion, site)
text = concat(site, text, make-operand(.operand-constant, ir.add-string(")")))
= Typed(text, row.to)

────────────────────
_ do concat Operand
    - site SyntaxId
    - left Operand
    - right Operand

` Two texts joined by the runtime.
. mark = pending.length
pending += left
pending += right
= call-polling(.runtime-string-concat, site, mark, managed-layout)

────────────────────
_ do recast Typed
    - site SyntaxId
    - row ConversionFact
    - value Operand

` A tuple or struct cast to another: memory in the frame, with each field converted as its
` part says and stored to the field in the same place.
. held = layout-of(row.from, site)
. layout = layout-of(row.to, site)
if !tables.layouts.is-struct(held) || !tables.layouts.is-struct(layout)
    refuse(.refused-conversion, site)
    = Typed(value, no-type)
check-item-size(site, row.from, row.to)
. count = tables.layouts.rows[layout].fields.count
if tables.layouts.rows[held].fields.count != count
    refuse(.refused-conversion, site)
    = Typed(value, no-type)
. made = frame(layout)
. position U32
. part = row.parts
while part != no-fact && position < count
    . fact = facts.conversion-parts[part]
    . field = tables.layouts.field(layout, position)
    . source = tables.layouts.field(held, position)
    . converted = convert-one(site, fact, Typed(take(value, source, site), source.type))
    if converted.type != field.type
        refuse(.refused-conversion, site)
    put(made, field, converted.operand, site)
    position += 1
    part = fact.next
if part != no-fact || position != count
    refuse(.refused-conversion, site)
= Typed(made, row.to)

────────────────────
_ do check-item-size
    - site SyntaxId
    - from TypeId
    - to TypeId

=? if !holds-items(from) || !holds-items(to)
. from-item = viewed-item(from)
. to-item = viewed-item(to)
=? if from-item == to-item
. from-size = tables.layouts.rows[layout-of(from-item, site)].size
. to-size = tables.layouts.rows[layout-of(to-item, site)].size
=? if from-size == to-size
if !function.may-panic && !in-landing
    refuse(.refused-conversion, site)
    =
raise-text(site, "An array of ${from-size}-byte items cannot be cast to one of ${to-size}-byte items")
ir.start-block(ir.reserve-block())

────────────────────
_ holds-items Bool
    - type TypeId

same-ref(ref, types.array-decl) || same-ref(ref, types.immutable-array-decl)

.. ref = class-ref(types, type)

────────────────────
_ do is-leading Bool
    - base LayoutId
    - whole LayoutId

` Whether a struct starts with the fields of another, each in the same place: the address of
` the one is then the address of the other.
if !tables.layouts.is-struct(base) || !tables.layouts.is-struct(whole)
    = false
. count = tables.layouts.rows[base].fields.count
if count > tables.layouts.rows[whole].fields.count
    = false
for position in 0 .. < count
    . mine = tables.layouts.field(base, position)
    . theirs = tables.layouts.field(whole, position)
    if mine.offset != theirs.offset || mine.layout != theirs.layout
        = false
= true

────────────────────
_ do wrap Typed
    - site SyntaxId
    - value Typed
    - target TypeId

` A value as an optional that holds it: the value, and the flag that says there is one. The
` value is already what the optional holds: a conversion converts it first as its part says.
` A value with no bits leaves only the flag.
. layout = layout-of(target, site)
if is-null-form(target) && value.type == types.optional-inner(target)
    = Typed(value.operand, target)
if !types.is-optional(target) || !tables.layouts.is-struct(layout)
    refuse(.refused-conversion, site)
    = value
. inner = tables.layouts.field(layout, 0)
. flag = tables.layouts.field(layout, 1)
. held = types.optional-inner(target)
. given = value
if held != given.type || inner.layout != layout-of(given.type, site)
    refuse(.refused-conversion, site)
    = value
. wrapped = frame(layout)
zero(wrapped, layout)
if tables.layouts.is-struct(inner.layout)
    copy(address(wrapped, inner.offset, inner.layout, site), given.operand, inner.layout, false, site)
else if inner.layout != void-layout
    store(wrapped, inner.offset, given.operand, false, site)
store(wrapped, flag.offset, integer(.machine-i8, 1), false, site)
= Typed(wrapped, target)

────────────────────
_ do empty-optional Typed
    - type TypeId
    - layout LayoutId

` An optional that holds nothing: the flag is clear, and what it would hold is the value its
` type has with nothing written. One held as a pointer is the pointer that points at nothing.
if is-null-form(type)
    = Typed(integer(layout as MachineKind, 0), type)
= null-value(type, layout, 0)

────────────────────
_ do null-value Typed
    - type TypeId
    - layout LayoutId
    - site SyntaxId

` The value a type has with nothing written, in memory of the frame: no bits set, but for
` the empty text wherever a text is held, in a field of a tuple or struct or in an optional,
` however deep.
. empty = frame(layout)
zero(empty, layout)
empty-texts(empty, 0, type, layout, site)
= Typed(empty, type)

────────────────────
_ do empty-texts ?! Refused
    - memory Operand
    - offset U32
    - type TypeId
    - layout LayoutId
    - site SyntaxId

` Stores the empty text at each place of zeroed memory that holds a text.
if type == no-type || type == invalid-type
    =
if type == types.string-type
    store(memory, offset, make-operand(.operand-constant, ir.add-string("")), false, site)
    =
if !tables.layouts.is-struct(layout) || !tables.layouts.rows[layout].is-managed
    =
if types.is-optional(type)
    . inner = tables.layouts.field(layout, 0)
    empty-texts(memory, offset + inner.offset, types.optional-inner(type), inner.layout, site)
    =
if !is-aggregate(type)
    =
. range = types.completions[type].properties
for position in 0 .. < range.count
    . property = types.properties[range.start + position]
    if property.slot == U32.max
        continue
    . field = tables.layouts.field(layout, property.slot)
    empty-texts(memory, offset + field.offset, property.type, field.layout, site)

────────────────────
_ do rehouse Typed
    - site SyntaxId
    - row ConversionFact
    - value Typed

` An optional made an optional of another type: where it holds a value, that value converted
` as the conversion's one part says and held, and else the optional that holds nothing.
. source = value.type
. target = row.to
. layout = layout-of(target, site)
if is-null-form(target)
    = rehouse-pointer(site, row, value, layout)
if !tables.layouts.is-struct(layout)
    refuse(.refused-conversion, site)
    = value
. made = frame(layout)
zero(made, layout)
. holds = present(site, value)
. held = ir.reserve-block()
. done = ir.reserve-block()
branch(holds.operand, held, done)
ir.start-block(held)
. given = convert-one(site, facts.conversion-parts[row.parts], payload(site, Typed(value.operand, source)))
. housed = wrap(site, given, target)
copy(made, housed.operand, layout, false, site)
jump(done)
ir.start-block(done)
= Typed(made, target)

────────────────────
_ do rehouse-pointer Typed
    - site SyntaxId
    - row ConversionFact
    - value Typed
    - layout LayoutId

. source = value.type
. target = row.to
. holds = present(site, value)
. slot = join-slot(layout)
. mark = joins.length
. held = ir.reserve-block()
. other = ir.reserve-block()
. joined = ir.reserve-block()
branch(holds.operand, held, other)
ir.start-block(held)
. given = convert-one(site, facts.conversion-parts[row.parts], payload(site, Typed(value.operand, source)))
. housed = wrap(site, given, target)
arrive(site, housed.operand, joined, slot)
ir.start-block(other)
arrive(site, empty-optional(target, layout).operand, joined, slot)
= Typed(close-joins(joined, mark, layout, slot), target)

────────────────────
_ do present Typed
    - site SyntaxId
    - value Typed

` Whether an optional holds a value, which its flag says, or for one held as a pointer that
` the pointer points at something.
. layout = layout-of(value.type, site)
if is-null-form(value.type)
    = Typed(compare(site, .compare-not-equal, value.operand, integer(layout as MachineKind, 0)), types.bool-type)
if !types.is-optional(value.type) || !tables.layouts.is-struct(layout)
    refuse(.refused-type, site)
    = value
. flag = tables.layouts.field(layout, 1)
. compared = compare
    - site
    - .compare-not-equal
    - load(value.operand, flag.offset, flag.layout, site)
    - integer(.machine-i8, 0)
= Typed(compared, types.bool-type)

────────────────────
_ do payload Typed
    - site SyntaxId
    - value Typed

` What an optional holds, read where it lies. Whether it holds anything is tested by what
` reads it, or was settled by the type pass. One held as a pointer is what it holds.
. layout = layout-of(value.type, site)
if is-null-form(value.type)
    = Typed(value.operand, types.optional-inner(value.type))
if !types.is-optional(value.type) || !tables.layouts.is-struct(layout)
    refuse(.refused-type, site)
    = value
= Typed(take(value.operand, tables.layouts.field(layout, 0), site), types.optional-inner(value.type))

────────────────────
_ do unwrap Typed
    - site SyntaxId
    - value Typed

` What an optional holds, where one that holds nothing is a panic, or inside a pattern a
` value that does not match.
. held = value.type
if !function.may-panic && matching.failing == no-block
    refuse(.refused-conversion, site)
    = value
. tested = present(site, value)
if matching.failing != no-block
    pass-or-fail(tested.operand, matching.failing)
    = payload(site, Typed(value.operand, held))
. filled = ir.reserve-block()
. missing = ir.reserve-block()
branch(tested.operand, filled, missing)
ir.start-block(missing)
raise-text(site, "Optional'${type-display(types, types.optional-inner(held))} is null")
ir.start-block(filled)
= payload(site, Typed(value.operand, held))

────────────────────
_ do emit-force Typed
    - id SyntaxId
    - operand SyntaxId

` `a!`: what an optional holds, or a panic where it holds nothing. An operand the type pass
` had narrowed already is what it holds, and nothing is tested: the force fact says so where
` the operand is read as the optional it is stored as. One the fact does not call narrowed,
` though the operand was typed narrowed where a lazy local's value was first typed, is read as
` stored (`stored-read`) and tested, as the reference does at a read that types the value again.
. fact = facts.first-force(unit.reading, id)
. outer = stored-read
stored-read = if fact != no-fact && !facts.forces[fact].is-narrowed then operand else 0
. value = emit-expression(operand)
stored-read = outer
if !types.is-optional(value.type)
    = value
if fact != no-fact && facts.forces[fact].is-narrowed
    if shared-depth != 0 && !facts.is-inside-read(unit.reading, operand)
        refuse(.refused-expression, id)
        = value
    = payload(id, value)
= unwrap(id, value)

────────────────────
_ holds Bool
    - held TypeId
    - type TypeId

` Whether a type is an optional of another: what a name narrowed to the other is stored as.
typed-held && types.is-optional(held) && types.optional-inner(held) == type
.. typed-held = held != no-type && held != invalid-type

────────────────────
_ do cast Typed
    - site SyntaxId
    - value Typed
    - target TypeId

` A cast between two numbers or between two pointers, of an integer to a pointer, or of a
` pointer that is no object to an integer. A number becomes a Bool by a test
` against zero, and a one-bit integer by its lowest bit. Any other number keeps its value as
` far as the target can hold it, and a pointer keeps its bits. An integer becomes the address
` it counts, with no sign, and a pointer the integer its address is, as far as the target can
` hold it. A pointer that becomes text is adopted by the runtime, which has no shape yet.
. source = layout-of(value.type, site)
. layout = layout-of(target, site)
. from-kind = intrinsic(value.type)
. to-kind = intrinsic(target)
. numbers = is-number(source) && is-number(layout)
. pointers = is-pointer(source) && is-pointer(layout)
. address = is-integer(source) && is-pointer(layout) && !is-text(target)
. points = from-kind == .cpointer || from-kind == .atom
. counted = pointer-to-integer && to-kind != .bool && to-kind != .int1
    .. pointer-to-integer = points && is-pointer(source) && is-integer(layout)
if !numbers && !pointers && !address && !counted
    refuse(.refused-conversion, site)
    = value
if pointers && is-text(target) && !is-text(value.type)
    refuse(.refused-conversion, site)
    = value
if numbers && to-kind == .bool && from-kind != .bool
    . tested = compare-zero(site, value, .compare-not-equal)
    = Typed(tested.operand, target)
if numbers && to-kind == .int1 && from-kind != .int1
    if !is-integer(source)
        refuse(.refused-conversion, site)
        = value
    . start U32 = ir.operands.length
    ir.add-operand(value.operand)
    ir.add-operand(integer(tables.layouts.kind-of(source), 1))
    . lowest = append(.op-bitwise, site, Span(start, 2), BitwiseOp.bitwise-and, source)
    = Typed(num-cast(site, make-operand(.operand-value, lowest), source, layout), target)
= Typed(num-cast(site, value.operand, source, layout), target)

────────────────────
_ do held-object Typed
    - site SyntaxId
    - value Operand
    - target TypeId

` The object a value of an interface holds, as a pointer: the first word of the value.
. layout = layout-of(target, site)
. first = tables.layouts.field(tables.layouts.interface-layout, 0)
if !is-pointer(first.layout) || !is-pointer(layout)
    refuse(.refused-conversion, site)
    = Typed(value, no-type)
. object = load(value, first.offset, first.layout, site)
= Typed(num-cast(site, object, first.layout, layout), target)

────────────────────
_ do union-object Typed
    - site SyntaxId
    - value Typed
    - target TypeId

. union = layout-of(value.type, site)
. layout = layout-of(target, site)
if !tables.layouts.is-union(union) || !is-pointer(layout)
    refuse(.refused-conversion, site)
    = value
. held = tables.layouts.case-field(union, 0)
if !is-pointer(held.layout)
    refuse(.refused-conversion, site)
    = value
. object = load(value.operand, held.offset, held.layout, site)
= Typed(num-cast(site, object, held.layout, layout), target)

────────────────────
_ do reinterpret Typed
    - site SyntaxId
    - value Typed
    - target TypeId

` A value with its bits as they are, as another type: an atom as the text it points at, or a
` text as an atom. Both are pointers.
. source = layout-of(value.type, site)
. layout = layout-of(target, site)
. atoms = intrinsic(value.type) == .atom && is-text(target)
. texts = is-text(value.type) && intrinsic(target) == .atom
if (!atoms && !texts) || !is-pointer(source) || !is-pointer(layout)
    refuse(.refused-conversion, site)
    = value
= Typed(num-cast(site, value.operand, source, layout), target)

────────────────────
_ is-null-form Bool
    - type TypeId

` Whether an optional is held as the pointer it holds, which points at nothing where there
` is none: an optional of an atom, or of a class other than `Null`, whose value is that
` pointer.
optional-type && (atom-inner || (class-inner && types.optional-inner(type) != types.null-type))
.. optional-type = type != no-type && type != invalid-type && types.is-optional(type)
.. atom-inner = intrinsic(types.optional-inner(type)) == .atom
.. class-inner = intrinsic(types.optional-inner(type)) == .class

────────────────────
_ holds-atom Bool
    - type TypeId

types.is-optional(type) && intrinsic(types.optional-inner(type)) == .atom

────────────────────
_ do num-cast Operand
    - site SyntaxId
    - value Operand
    - source LayoutId
    - layout LayoutId

` A number or a pointer of one layout as one of another.
if source == layout
    = value
if operand-kind(value) == .operand-number && whole-layouts && source-number
    = integer
        - layout as MachineKind
        - cast-bits(ir.numbers[operand-payload(value)].bits, source, layout)
.. whole-layouts = is-whole-layout(source) && is-whole-layout(layout)
.. source-number = ir.numbers[operand-payload(value)].kind == source as MachineKind
. start U32 = ir.operands.length
ir.add-operand(value)
= make-operand(.operand-value, append(.op-num-cast, site, Span(start, 1), 0, layout))

────────────────────
_ is-whole-layout Bool
    - layout LayoutId

layout >= u8-layout && layout <= i64-layout

────────────────────
_ cast-bits U64
    - bits U64
    - source LayoutId
    - layout LayoutId

widened(held, width, is-signed(layout))

.. source-width = tables.layouts.rows[source].size * 8
.. width = tables.layouts.rows[layout].size * 8
.. held = widened(bits, source-width, is-signed(source))

────────────────────
_ widened U64
    - bits U64
    - width U32
    - signed Bool

|? width >= 64
    bits
|? signed && (low /and/ (1u64 /lshift/ (width - 1))) != 0
    low /or/ (0 - (1u64 /lshift/ width))
??
    low

.. low = bits /and/ ((1u64 /lshift/ width) - 1)

────────────────────
_ do equalize Typed
    - site SyntaxId
    - value Typed
    - target TypeId
    - ratio UnitRatio

` A number as a number of another unit: taken to the widest float, multiplied by the ratio's
` multiplier and divided by its divisor, each only when it is not one, and taken to the
` target.
. source = layout-of(value.type, site)
. layout = layout-of(target, site)
if !is-number(source) || !is-number(layout)
    refuse(.refused-conversion, site)
    = value
. scaled = num-cast(site, value.operand, source, f64-layout)
if ratio.multiplier != 1.0
    scaled = scale(site, scaled, .arithmetic-multiply, ratio.multiplier)
if ratio.divisor != 1.0
    scaled = scale(site, scaled, .arithmetic-divide, ratio.divisor)
= Typed(num-cast(site, scaled, f64-layout, layout), target)

────────────────────
_ do scale Operand
    - site SyntaxId
    - value Operand
    - op ArithmeticOp
    - amount F64

. start U32 = ir.operands.length
ir.add-operand(value)
ir.add-operand(float-number(f64-layout, amount))
= make-operand(.operand-value, append(.op-arithmetic, site, Span(start, 2), op, f64-layout))

────────────────────
_ do compare Operand
    - site SyntaxId
    - predicate ComparePredicate
    - left Operand
    - right Operand

. start U32 = ir.operands.length
ir.add-operand(left)
ir.add-operand(right)
= make-operand(.operand-value, append(.op-compare, site, Span(start, 2), predicate, u8-layout))

────────────────────
_ do compare-zero Typed
    - site SyntaxId
    - value Typed
    - predicate ComparePredicate

` Compares a number or a C pointer with the zero of its layout, and leaves a Bool.
. layout = layout-of(value.type, site)
if !is-number(layout) && (!is-pointer(layout) || intrinsic(value.type) != .cpointer)
    refuse(.refused-type, site)
    = value
. origin = integer(tables.layouts.kind-of(layout), 0)
if is-float(layout)
    origin = float-number(layout, 0.0)
= Typed(compare(site, predicate, value.operand, origin), types.bool-type)

────────────────────
_ do truth Typed
    - site SyntaxId
    - value Typed

` Whether a value tests as true, by its layout: a Bool is its own answer, an optional is true
` when it holds a value, and any other number is true when it is not zero. A value a function
` tests has no shape here.
if value.type == types.bool-type
    = value
if value.type != no-type && value.type != invalid-type && types.is-optional(value.type)
    = present(site, value)
= compare-zero(site, value, .compare-not-equal)

────────────────────
_ do emit-identifier Typed ?! Refused
    - id SyntaxId
    - name Atom
    - given TypeId = no-type

` A name: a constant the type pass worked out, one of the two truths, `null`, which is the
` pointer that points at nothing, a global, a type as a value, or in a body written in
` source the receiver, an argument, a local, the item of a loop, a property of the receiver
` or what a getter of it answers, or the name the receiver is written with as a number. A
` field named alone in a member that runs on the case of a row is read from its cell, and a
` getter named so runs on the row. A name the binder found a member of a markup element
` being built is read from the innermost such element that has it. A read of the name of a
` markup element the type pass made there first makes it (`raise-element`). What
` is read has the type the type pass gave the name, or the name has no shape here. A name
` a call calls is typed by no node, and is `given` its type. In the function of a rule made
` for a pattern that may raise errors, the pattern is read only where it is called. In the
` function that evaluates a line of a style rule from the slots of a style sheet, a value the
` rule takes as a slot is read from where `bind-themed-givens` kept it.
. themed = facts.theme-read-of(unit.reading, id)
if themed
    = read-theme(id, themed)
. binding = instances.rows[unit.reading].binding
. type = if given != no-type then given else facts.node-type(unit.reading, id)
if function.kind == .style-themed-value && rule-names.length != 0 && binding != no-binding
    . taken = bindings.resolution-of(binding, id)
    if taken.kind == .resolve-slot && bindings.slots[taken.slot].kind == .slot-argument
        = read-rule-value(taken.slot, id, type)
if carried-given != no-type && !calling-pattern && is-pattern-func(type)
    refuse(.refused-expression, id)
    = Typed(make-operand(.operand-void, 0), no-type)
if facts.plan-of(unit.reading, id) == .plan-constant
    = Typed(emit-constant(id), type)
if given == no-type && facts.plan-of(unit.reading, id) == .plan-row-item
    = emit-row-item(id, name)
if given == no-type && facts.plan-of(unit.reading, id) == .plan-getter
    = emit-getter(id)
if facts.plan-of(unit.reading, id) == .plan-element-property
    = read-unmade(id, name)
if binding != no-binding && (resolution-flags /and/ ResolutionFlag.resolution-received) != 0
    = read-received(id, name)
.. resolution-flags = bindings.resolution-of(binding, id).flags
if binding != no-binding
    . global = bindings.resolution-of(binding, id)
    if global.kind == .resolve-global && types.is-literal-global(global.module, global.decl)
        if name == types.true-atom && type == types.bool-type
            = Typed(integer(.machine-u8, 1), type)
        if name == types.false-atom && type == types.bool-type
            = Typed(integer(.machine-u8, 0), type)
        if name == types.null-atom! && type == types.null-type
            . held = tables.layouts.values[type]
            if held == managed-layout || held == pointer-layout
                = Typed(integer(held as MachineKind, 0), type)
            = Typed(make-operand(.operand-void, 0), type)
    else if global.kind == .resolve-global
        = read-global(id, global.module, global.decl)
    . names-type = global.kind != .resolve-slot && global.kind != .resolve-member && not-function
        .. not-function = global.kind != .resolve-function
    if names-type && type != no-type && type != invalid-type && intrinsic(type) == .type-info
        = type-value(id, type)
    if global.kind == .resolve-function && reads-getter(id)
        = emit-fact-call(id, facts.calls[own-call(id)], 0, RowRange'SyntaxId())
    if global.kind == .resolve-function && is-binding(type)
        = name-binding(id, type, 0)
    if global.kind == .resolve-member && making.type != no-type && filling.root != 0
        = read-made(id, name)
if binding != no-binding && unit.reading == unit.lender && unit.lender != unit.instance
    . lent = bindings.resolution-of(binding, id)
    if lent.kind == .resolve-slot && is-captured(lent.slot)
        . kind = bindings.slots[lent.slot].kind
        if kind == .slot-local && facts.plan-of(unit.reading, id) == .plan-guarded-read
            = guard-element(id, read-captured(lent.slot, id, type), name)
        if kind == .slot-local || kind == .slot-argument || kind == .slot-pattern
            = read-captured(lent.slot, id, type)
        if kind == .slot-loop-item || kind == .slot-each || kind == .slot-it
            = read-captured(lent.slot, id, type)
        if kind == .slot-lazy
            = read-lazy-local(lent.slot, id, type)
        if kind == .slot-this && unit.has-self && type == unit.owner-type
            = Typed(unit.self, type)
    if lent.kind == .resolve-slot && bindings.slots[lent.slot].kind == .slot-lazy
        = read-lent-lazy(lent.slot, id, type)
    if lent.kind == .resolve-member && unit.has-self
        . escaped = escaped-event(id)
        if escaped
            = emit-escape(id, escaped)
        . getter = own-call(id)
        if getter != no-fact && facts.calls[getter].form == .call-getter
            = emit-fact-call(id, facts.calls[getter], 0, RowRange'SyntaxId())
        if facts.plan-of(unit.reading, id) == .plan-none || guarded-read
            = load-property(id, unit.self, unit.owner-type, name)
        .. guarded-read = facts.plan-of(unit.reading, id) == .plan-guarded-read
if binding != no-binding && unit.reading == unit.instance
    . resolution = bindings.resolution-of(binding, id)
    . owner = unit.owner-type
    . early = facts.raised-at(unit.reading, id)
    if early != 0 && built.find(early) == null
        raise-element(early)
    if resolution.kind == .resolve-slot
        . kind = bindings.slots[resolution.slot].kind
        . kept = local-or-argument || kind == .slot-machine || bare-pattern
            .. local-or-argument = kind == .slot-local || kind == .slot-argument
            .. bare-pattern = kind == .slot-pattern && !holds-capture(resolution.slot)
        if given-slots && kept && is-bound(resolution.slot)
            = read-bound(resolution.slot, id, type)
        if is-captured(resolution.slot) && kind == .slot-local && guarded
            = guard-element(id, read-captured(resolution.slot, id, type), name)
        .. guarded = facts.plan-of(unit.reading, id) == .plan-guarded-read
        if is-captured(resolution.slot) && kept
            = read-captured(resolution.slot, id, type)
        if is-turned(resolution.slot) && turned-kind
            = read-captured(resolution.slot, id, type)
        .. turned-kind = kind == .slot-loop-item || kind == .slot-each || kind == .slot-it
        if kind == .slot-this && unit.has-self && type == owner
            = Typed(unit.self, type)
        if kind == .slot-super && unit.has-self && tables.is-class(owner) && tables.is-class(type)
            = Typed(unit.self, type)
        if kind == .slot-super && unit.has-self && !tables.is-class(owner)
            = Typed(unit.self, owner)
        if kind == .slot-argument && is-own-slot(resolution.slot)
            . position = argument-position(resolution.slot)
            . given = instances.argument-type(unit.instance, position)
            if type != given && shared-depth != 0 && !facts.is-inside-read(unit.reading, id)
                refuse(.refused-expression, id)
                = Typed(make-operand(.operand-void, 0), no-type)
            . cased = type != given && facts.plan-of(unit.reading, id) == .plan-case-read
            if type == given || holds(given, type) || cased
                . cell = unit.cells[resolution.slot - unit.slot-start]
                . argument = make-operand
                    - .operand-argument
                    - if unit.takes-self then position + 1 else position
                if cell != no-local
                    argument = load-local(cell, id)
                if type == given
                    = Typed(argument, given)
                if cased
                    = read-case(id, argument, given, type)
                = payload(id, Typed(argument, given))
        if kind == .slot-local
            = read-local(resolution.slot, id, type)
        if kind == .slot-lazy && task-holds(resolution.slot)
            = read-captured(resolution.slot, id, type)
        if kind == .slot-lazy
            = read-lazy-local(resolution.slot, id, type)
        if kind == .slot-loop-item && copied-slot && is-captured(resolution.slot)
            = read-captured(resolution.slot, id, type)
        .. copied-slot = tables.slot-copied[resolution.slot] != 0
        if kind == .slot-loop-item
            . loop = bindings.scopes[bindings.slots[resolution.slot].scope].syntax
            if facts.loop-take(unit.reading, loop) == .take-whole
                = read-item(loop, id, type)
            if is-captured(resolution.slot)
                = read-captured(resolution.slot, id, type)
            = read-local(resolution.slot, id, type)
        if kind == .slot-pattern || is-bound(resolution.slot)
            = read-bound(resolution.slot, id, type)
        if kind == .slot-location && is-captured(resolution.slot)
            = read-captured(resolution.slot, id, type)
        if kind == .slot-it || kind == .slot-each
            . home = bindings.scopes[bindings.slots[resolution.slot].scope]
            . written = if home.kind == .scope-loop then home.syntax else slot-syntax
                .. slot-syntax = bindings.slots[resolution.slot].syntax
            if is-own-slot(resolution.slot) && unit.cells[resolution.slot - unit.slot-start] != no-local
                = read-local(resolution.slot, id, type)
            if written == piped && !is-captured(resolution.slot) && ir.arguments.length == 2
                . given = instances.argument-type(unit.instance, 0)
                . argument = make-operand(.operand-argument, 1)
                if given == type
                    = Typed(argument, given)
                if facts.plan-of(unit.reading, id) == .plan-case-read
                    = read-case(id, argument, given, type)
                if !holds(given, type)
                    refuse(.refused-expression, id)
                    = Typed(argument, no-type)
                = payload(id, Typed(argument, given))
            = read-item(written, id, type)
    if resolution.kind == .resolve-member && unit.has-self
        . escaped = escaped-event(id)
        if escaped
            = emit-escape(id, escaped)
        if reads-unmade(id, name)
            = read-filled(id, name)
        if facts.plan-of(unit.reading, id) == .plan-unit-name
            = Typed(unit-text(owner), type)
        if facts.plan-of(unit.reading, id) == .plan-table
            = table-get(id, unit.self, owner)
        if facts.plan-of(unit.reading, id) == .plan-field
            = placed-field(id, unit.self, owner, facts.constant-of(unit.reading, id))
        if facts.plan-of(unit.reading, id) == .plan-through
            . held = read-through(id, Typed(unit.self, owner), facts.through-of(unit.reading, id))
            = load-property(id, held.operand, held.type, name, false, given)
        . getter = own-call(id)
        if getter != no-fact && facts.calls[getter].form == .call-getter
            = emit-fact-call(id, facts.calls[getter], 0, RowRange'SyntaxId())
        . told = facts.plan-of(unit.reading, id)
        if told == .plan-type-name || told == .plan-type-key
            = type-text(id, named-type(owner), told)
        = load-property(id, unit.self, owner, name, false, given)
    if resolution.kind == .resolve-member && this-cursor != U32.max
        . cursor = this-cursor
        . field = case-field(cursor, name)
        if field
            = emit-case-field(id, cursor, field)
        . asked = own-call(id)
        if asked != no-fact && facts.calls[asked].form == .call-getter
            = emit-fact-call(id, facts.calls[asked], 0, RowRange'SyntaxId())
if binding != no-binding && unit.reading != unit.instance && unit.has-self
    . written = bindings.resolution-of(binding, id)
    if written.kind == .resolve-member && filling.count != 0
        = read-filled(id, name)
    if written.kind == .resolve-member && unit.deferred-type != no-type
        . getter = own-call(id)
        if getter != no-fact && facts.calls[getter].form == .call-getter
            = emit-fact-call(id, facts.calls[getter], 0, RowRange'SyntaxId())
        = load-property(id, unit.self, unit.deferred-type, name)
    if written.kind == .resolve-member && evaluates-value()
        . getter = own-call(id)
        if getter != no-fact && facts.calls[getter].form == .call-getter
            = emit-fact-call(id, facts.calls[getter], 0, RowRange'SyntaxId())
        = load-property(id, unit.self, unit.self-type, name)
    if written.kind == .resolve-slot && evaluates-value()
        if bindings.slots[written.slot].kind == .slot-this
            = Typed(unit.self, unit.self-type)
        if bindings.slots[written.slot].kind == .slot-argument && rule-names.length != 0
            = read-rule-value(written.slot, id, type)
if binding != no-binding && unit.reading != unit.instance && unit.reading != unit.lender
    . apart = bindings.resolution-of(binding, id)
    if apart.kind == .resolve-slot && bindings.slots[apart.slot].kind == .slot-lazy
        = read-apart(apart.slot, id, type)
refuse(.refused-expression, id)
= Typed(make-operand(.operand-void, 0), no-type)

────────────────────
_ do read-lent-lazy Typed
    - slot SlotId
    - id SyntaxId
    - type TypeId

` A lazy local of the function whose syntax is read for another, which no environment keeps:
` one each read evaluates is evaluated in place, and one evaluated once by the cells
` `open-lent-lazies` gave it, typed as the instance that declares it typed it. A read the type
` pass narrowed is of what the local holds. One whose value is being evaluated, one declared
` with others, and one with no cells, have no shape here.
. nothing = make-operand(.operand-void, 0)
for open in lazy-open
    if open == slot
        refuse(.refused-expression, id)
        = Typed(nothing, no-type)
. binding = instances.rows[unit.reading].binding
. held = facts.slot-type(unit.reading, slot - bindings.bindings[binding].slots.start)
. group = bindings.slots[slot].group
. policy = bindings.lazy-policy(slot)
. position = lent-lazies.length
. kept = false
while position != 0 && !kept
    position -= 1
    kept = lent-lazies[position].slot == slot
. narrowed = held != type && holds(held, type)
. typed = held == type || (narrowed && (shared-depth == 0 || facts.is-inside-read(unit.reading, id)))
if !typed || held == no-type || bindings.lazy-together(slot) || (policy != .lazy-inline && !kept)
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
do match? tree.nodes[group]
    | .node-declare(row)
        . name = row.left
        . annotation SyntaxId = 0
        do match? tree.nodes[row.left]
            | .node-type-capture(capture)
                name = capture.id
                annotation = capture.type
        if tree.nodes[name] is .node-identifier && row.right != 0
            . ready = if kept then ir.reserve-block() else no-block
            if kept
                . evaluate = ir.reserve-block()
                branch(load-local(lent-lazies[position].flag, id), ready, evaluate)
                ir.start-block(evaluate)
            lazy-open += slot
            . value = declared-value(name, annotation, row.right, held)
            lazy-open.pop()
            claim-lazy(group, value.operand, held)
            if kept
                if lent-lazies[position].cell != no-local
                    store-local(lent-lazies[position].cell, value.operand, id)
                store-local(lent-lazies[position].flag, integer(.machine-u8, 1), id)
                jump(ready)
                ir.start-block(ready)
                value = if lent-lazies[position].cell != no-local then Typed(load-local(cell, id), held) else Typed(nothing, held)
                    .. cell = lent-lazies[position].cell
            if narrowed
                = payload(id, Typed(value.operand, held))
            = Typed(value.operand, held)
refuse(.refused-expression, id)
= Typed(nothing, no-type)

────────────────────
_ do open-lent-lazies
    - value SyntaxId
    - site SyntaxId

` Gives each lazy local declared inside the value of a lazy local that a function written in the
` one declaring them evaluates, which no environment keeps and which is evaluated once, the
` flag that says whether it has its value and the cell that holds the value, both cleared here
` where the value starts: every read of it lies in the value. A function written in the value
` declares its own.
. binding = instances.rows[unit.reading].binding
if binding == no-binding
    =
. bound = bindings.bindings[binding].slots
. low = tree.subtree-start(value)
for offset in 0 .. < bound.count
    . slot = bound.start + offset
    . row = bindings.slots[slot]
    if row.kind != .slot-lazy || bindings.lazy-policy(slot) != .lazy-memo || is-captured(slot)
        continue
    if row.syntax < low || row.syntax > value || other-scope
        continue
    .. other-scope = tables.slot-functions[slot] != tables.instance-scopes[unit.reading]
    . layout = layout-of(facts.slot-type(unit.reading, offset), site)
    . flag = ir.add-local(u8-layout)
    store-local(flag, integer(.machine-u8, 0), site)
    . cell = if layout != void-layout then ir.add-local(layout, true) else no-local
    if cell != no-local
        zero
            - make-operand
                - .operand-value
                - append(.op-local-address, site, Span(), cell, pointer-layout)
            - layout
    lent-lazies += LentLazy(slot, flag, cell)

────────────────────
_ do close-lent-lazies
    - mark Size

` Drops the cells `open-lent-lazies` gave past a mark.
while lent-lazies.length > mark
    lent-lazies.pop()

────────────────────
_ do read-apart Typed
    - slot SlotId
    - id SyntaxId
    - type TypeId

` A lazy local declared under a value the type pass typed apart from the function that
` evaluates it, the value of a property or of a global: its one read evaluates in place the
` value it is declared with. One read in several places, or declared with others, has no
` shape there, and no local is read by its own value. A local the type pass kept no type
` for has the type of its read.
. nothing = make-operand(.operand-void, 0)
. bound = bindings.bindings[instances.rows[unit.reading].binding].slots
if slot < bound.start || slot >= bound.start + bound.count
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. kept = facts.slot-type(unit.reading, slot - bound.start)
. held = if kept == no-type then type else kept
. inline = bindings.lazy-reads-once(slot) && held == type && type != no-type
for open in lazy-open
    if open == slot
        inline = false
do match? tree.nodes[bindings.slots[slot].group]
    | .node-declare(row)
        . name = row.left
        . annotation SyntaxId = 0
        do match? tree.nodes[row.left]
            | .node-type-capture(capture)
                name = capture.id
                annotation = capture.type
        if inline && row.right != 0
            lazy-open += slot
            . value = declared-value(name, annotation, row.right, held)
            lazy-open.pop()
            = value
refuse(.refused-expression, id)
= Typed(nothing, no-type)

────────────────────
_ do reads-surely Bool
    - id SyntaxId

` Whether the value being evaluated reads a property of the object at a node whenever it is
` evaluated, as the type pass recorded the read.
. read = tables.first-read(unit.reading)
while read != no-fact
    if facts.value-reads[read].syntax == id
        = facts.value-reads[read].surely
    read = tables.next-read(read)
= false

────────────────────
_ do names-slot Bool
    - id SyntaxId
    - kind SlotKind

` Whether a node of the body being emitted is a name bound to a slot of one kind: the
` receiver, or its base's part.
if id == 0 || unit.instance == no-instance || unit.reading != unit.instance
    = false
. binding = instances.rows[unit.instance].binding
if binding == no-binding
    = false
do match? tree.nodes[id]
    | .node-identifier
        . resolution = bindings.resolution-of(binding, id)
        if resolution.kind == .resolve-slot
            = bindings.slots[resolution.slot].kind == kind
= false

────────────────────
_ do read-filled Typed
    - id SyntaxId
    - name Atom

` A property of the object being made, read by the value its class writes for another. A
` property with no value yet is given its own first, which is the order TypeScript evaluates
` them in. One read where its value may come on some paths alone, under a condition or in a
` value so given, is given it where its flag says it has none (`check-property`), as the
` reference gives it. A lazy property is evaluated by its function, which reads the object: it
` is read only when every property its value reads has its own.
. nothing = make-operand(.operand-void, 0)
. found = property-of(filling.type, name)
if !found
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. position = (found as U32) - filling.start
if filling.filled[position] != 3 && lazy-property && reads-unfilled(found as U32, 0)
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
.. lazy-property = types.properties[found].storage-kind == .storage-lazy
if facts.defers(unit.instance, found as U32)
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
if filling.filled[position] != 2
    . unsure = (instances.rows[unit.reading].branches && !reads-surely(id)) || checking != 0
    if (unsure || filling.filled[position] == 4) && filling.filled[position] == 3
        refuse(.refused-expression, id)
        = Typed(nothing, no-type)
    . own-unit = unit
    . own-filling = filling
    unit = unit.source-module = function.module
    unit = unit.reading = unit.instance
    if unsure || filling.filled[position] == 4
        check-property(position, 0)
        filling.filled[position] = if unsure then 4 else 2
    else if filling.filled[position] == 3
        store-stale(position, 0)
    else
        store-property(position, 0)
    unit = own-unit
    filling = own-filling
= load-property(id, unit.self, filling.type, name)

────────────────────
_ reads-unmade Bool
    - id SyntaxId
    - name Atom

` Whether a name the constructor reads while it gives the properties their first values, as
` in the value of a `..` it writes for one, is a stored property of the object being made,
` which gets its own value first where it has none (`read-filled`), as TypeScript reads it.
|? !filling.storing || filling.count == 0 || unit.reading != unit.instance || facts.plan-of(unit.reading, id) != .plan-none
    false
|? getter != no-fact && facts.calls[getter].form == .call-getter
    false
|? !found
    false
??
    kind == .storage-eager || kind == .storage-lazy

.. getter = own-call(id)
.. found = property-of(filling.type, name)
.. kind = types.properties[found].storage-kind

────────────────────
_ do reads-unfilled Bool
    - place U32
    - depth U32

` Whether the value a class writes for a lazy property may read, in the object being made,
` a stored property that has no value yet: by its name, through another lazy property, or
` in some way the type pass recorded no name for, as through the receiver itself or a
` function of its class. A value no instance typed may.
if tables.default-of(filling.type, place).value == 0
    = false
. unit-id = tables.value-unit(place)
if depth > 8 || unit-id == no-instance || instances.rows[unit-id].reads-self
    = true
. read = tables.first-read(unit-id)
while read != no-fact
    . found = property-read(filling.type, read)
    if !found
        = true
    . kind = types.properties[found].storage-kind
    if kind == .storage-eager && filling.filled[(found as U32) - filling.start] != 2
        = true
    if kind == .storage-getter
        = true
    if kind == .storage-lazy && (found as U32) != place && reads-unfilled(found as U32, depth + 1)
        = true
    read = tables.next-read(read)
= false

────────────────────
_ do emit-address-of Operand
    - id SyntaxId

` The address of a local or of an argument: of its cell, which stays in the frame, as the
` cell of a struct always does. A lazy local is first given its value as a read of it is. A
` struct argument has no cell: it is the address of memory the function owns. In a function
` that yields it is the address of where the function's own environment keeps the local, a
` struct there too, which is there from one step to the next.
. binding = instances.rows[unit.reading].binding
if binding != no-binding && unit.reading == unit.instance
    . resolution = bindings.resolution-of(binding, id)
    if resolution.kind == .resolve-slot
        . offset = slot-offset(resolution.slot, id)
        . layout = layout-of(facts.node-type(unit.reading, id), id)
        . kind = bindings.slots[resolution.slot].kind
        if is-pointer(layout) && kind == .slot-lazy
            read-lazy-local(resolution.slot, id, facts.slot-type(unit.instance, offset))
        . kept = stepping && (kind == .slot-local || kind == .slot-argument) && slot-captured
            .. slot-captured = is-captured(resolution.slot)
        if is-pointer(layout) && kept
            . field = find-captured(resolution.slot, id)
            if hops == no-hops
                = address(captured-base(id), field.offset, layout, id)
            refuse(.refused-expression, id)
            = make-operand(.operand-void, 0)
        if is-pointer(layout) && unit.cells[offset] != no-local
            . cell = ir.locals[unit.cells[offset]]
            if cell.address-taken || tables.layouts.is-struct(cell.layout)
                . made = make-operand
                    - .operand-value
                    - append(.op-local-address, id, Span(), unit.cells[offset], layout)
                = made
        if is-pointer(layout) && !stepping && own-argument
            . index = argument-position(resolution.slot) + (if unit.takes-self then 1 else 0)
            if unit.cells[offset] == no-local && index < ir.arguments.length && struct-argument
                = address(make-operand(.operand-argument, index), 0, layout, id)
            .. struct-argument = tables.layouts.is-struct(ir.arguments[index])
        .. own-argument = kind == .slot-argument && is-own-slot(resolution.slot)
refuse(.refused-expression, id)
= make-operand(.operand-void, 0)

────────────────────
_ do read-local Typed
    - slot SlotId
    - id SyntaxId
    - type TypeId

` The value of a local: what its cell holds, in the type the local was given. A local that
` holds nothing has no cell. Where the type pass narrowed an optional local to what it
` holds, the read is of that.
. nothing = make-operand(.operand-void, 0)
. offset = slot-offset(slot, id)
. held = facts.slot-type(unit.instance, offset)
. cased = held != type && facts.plan-of(unit.reading, id) == .plan-case-read
if held != type && !holds(held, type) && !cased
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
if unit.cells[offset] == no-local
    if layout-of(held, id) != void-layout
        refuse(.refused-expression, id)
    = Typed(nothing, type)
. value = load-local(unit.cells[offset], id)
if held == type
    = Typed(value, type)
if id == stored-read && !cased
    = Typed(value, held)
if shared-depth != 0 && !facts.is-inside-read(unit.reading, id)
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
if cased
    = read-case(id, value, held, type)
= payload(id, Typed(value, held))

────────────────────
_ do read-case Typed
    - id SyntaxId
    - value Operand
    - held TypeId
    - type TypeId

` A union read as the one case the type pass knows it to hold: what the case holds, where it
` lies. An optional that holds the union is known to hold a value, and is read with no test.
` An object a case holds is read as a class it derives from, or as one derived from its own
` that a test the flow passed found it to be of.
. nothing = make-operand(.operand-void, 0)
. constant = facts.constant-of(unit.reading, id)
. whole = value
. union = held
if types.is-optional(held)
    . inner = payload(id, Typed(value, held))
    whole = inner.operand
    union = inner.type
. layout = layout-of(union, id)
if constant == no-fact || !tables.layouts.is-union(layout)
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. index = facts.constants[constant].bits as U32
if index >= tables.layouts.rows[layout].cases.count
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. field = tables.layouts.case-field(layout, index)
. lined = tables.is-class(field.type) && tables.is-class(type) && related
    .. related = descends(field.type, type) || descends(type, field.type)
if field.type != type && !lined
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
= Typed(take(whole, field, id), type)

────────────────────
_ do read-lazy-local Typed
    - slot SlotId
    - id SyntaxId
    - type TypeId

` The value of a lazy local, evaluated where the binding's policy for it says: by this read
` each time it runs, by the first read emitted each time that one runs, or by whichever read
` runs first, which tests the local's flag and sets it. The value is evaluated in place, so
` one read in several places is evaluated in each. A local whose value is being evaluated
` is not read by that value. One whose value lets errors out, read where other transformers
` are declared than where it was typed, has no shape here. In a function that yields, whose
` environment keeps its locals from step to step, one evaluated once is kept there with its
` flag, as one nested functions capture is; one a loop declares, whose flag each turn clears,
` has no shape there. One held as an eager local is (`holds-lazy`) is read as `read-held` says,
` or where the function keeps it in a local, as one evaluated once.
. nothing = make-operand(.operand-void, 0)
if facts.lazy-unheld(unit.reading, slot)
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. held = tables.holds-lazy(slot)
. policy = if held then LazyPolicy.lazy-memo else bindings.lazy-policy(slot)
. is-open = false
for open in lazy-open
    if open == slot
        is-open = true
if held && !is-open && is-captured(slot)
    = read-held(slot, id, type)
if policy == .lazy-shared && !is-open
    = read-shared(slot, id, type)
. offset = slot-offset(slot, id)
if filling.storing && !is-open
    = read-filling(slot, offset, id, type)
if policy == .lazy-unsettled || is-open
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
if !held && evaluates-in-place(slot, policy, id, type)
    = evaluate-in-place(slot, type)
if policy == .lazy-memo && is-captured(slot) && outside-loop
    = read-shared(slot, id, type)
.. outside-loop = (bindings.lazy-use-of(slot).flags /and/ (LazyUseFlag.declared-in-loop)) == 0
if policy == .lazy-memo
    . flag = unit.lazy-flags[offset]
    if flag == no-local
        refuse(.refused-expression, id)
        = Typed(nothing, no-type)
    if evaluated-before(flag)
        = read-local(slot, id, type)
    . evaluate = ir.reserve-block()
    . ready = ir.reserve-block()
    branch(load-local(flag, id), ready, evaluate)
    ir.start-block(evaluate)
    . wavers = read-wavers(slot, id)
    if wavers
        shared-depth += 1
    evaluate-lazy(slot, offset, id)
    if wavers
        shared-depth -= 1
    store-local(flag, integer(.machine-u8, 1), id)
    jump(ready)
    ir.start-block(ready)
    ready-lazies += ReadyLazy(flag, ready)
else
    if policy == .lazy-first-read && unit.lazy-readers[offset] == 0
        unit.lazy-readers[offset] = id
    if policy == .lazy-inline || unit.lazy-readers[offset] == id
        evaluate-lazy(slot, offset, id)
= read-local(slot, id, type)

────────────────────
_ do evaluates-in-place Bool
    - slot SlotId
    - policy LazyPolicy
    - id SyntaxId
    - type TypeId

. once = policy == .lazy-inline || (policy == .lazy-memo && bindings.lazy-reads-once(slot))
if !once || !is-own-slot(slot) || is-captured(slot) || bindings.lazy-together(slot)
    = false
if read-wavers(slot, id) || facts.address-claim-of(unit.reading, bindings.slots[slot].group)
    = false
. kept = facts.slot-type(unit.instance, slot - unit.slot-start)
if kept != type || type == no-type || type == invalid-type
    = false
do match? tree.nodes[bindings.slots[slot].group]
    | .node-declare(row)
        . named = row.left
        do match? tree.nodes[row.left]
            | .node-type-capture(capture)
                named = capture.id
        = row.right != 0 && tree.nodes[named] is .node-identifier
= false

────────────────────
_ do evaluate-in-place Typed
    - slot SlotId
    - type TypeId

. nothing = make-operand(.operand-void, 0)
do match? tree.nodes[bindings.slots[slot].group]
    | .node-declare(row)
        . named = row.left
        . annotation SyntaxId = 0
        do match? tree.nodes[row.left]
            | .node-type-capture(capture)
                named = capture.id
                annotation = capture.type
        lazy-open += slot
        . value = declared-value(named, annotation, row.right, type)
        lazy-open.pop()
        = value
= Typed(nothing, type)

────────────────────
_ do evaluated-before Bool
    - flag LocalId

` Whether an evaluation of a lazy local kept behind a flag, emitted in the function, ended in a
` block every way here passes, so that the flag is set here and a read evaluates nothing, as the
` reference skips a read whose block one of its evaluations dominates.
for position in 0 .. < ready-lazies.length
    if ready-lazies[position].flag == flag && ir.dominates(ready-lazies[position].block, ir.current)
        = true
= false

────────────────────
_ do shared-evaluated-before Bool
    - slot SlotId

` Whether an evaluation of a lazy local nested functions capture, emitted in the function, ended
` in a block every way here passes (`evaluated-before`).
for position in 0 .. < shared-ready.length
    if shared-ready[position].slot == slot && ready-before
        = true
    .. ready-before = ir.dominates(shared-ready[position].block, ir.current)
= false

────────────────────
_ read-wavers Bool
    - slot SlotId
    - site SyntaxId

` Whether the value of a lazy local evaluated by a read is typed where what the flow knows of
` what it reads may not hold here: the type pass found a read that knows a local the value
` reads otherwise than the first, or found this read of the emitted function's own to evaluate
` nothing where it does.
facts.lazy-wavers(unit.reading, slot) || (unit.reading == unit.instance && facts.is-dominated-read(unit.instance, site))

────────────────────
_ do read-held Typed
    - slot SlotId
    - id SyntaxId
    - type TypeId

` The value of a lazy local held as an eager local is (`holds-lazy`), which the environment of
` the function that declares it holds with no flag. That function gives it its value at its
` first read, or where it makes a nested function that reads it (`force-held`), and keeps the
` flag that says it has one; any other function reads it as it reads a captured local, since
` the function that declares it made that one after the local had its value.
. nothing = make-operand(.operand-void, 0)
if owns(slot) && unit.reading == unit.instance
    force-held(slot, id)
= read-captured(slot, id, type)

────────────────────
_ do force-held
    - slot SlotId
    - site SyntaxId

` Gives a lazy local the emitted function declares and holds as an eager local is its value
` where it has none yet: tests the flag the function keeps for it, and evaluates the value
` where it is clear, stores it in the environment and sets the flag. What the flow knows in the
` value holds here as at a read, unless the type pass found a read where a local the value reads
` is known otherwise.
. offset = slot-offset(slot, site)
. flag = unit.lazy-flags[offset]
. field = find-captured(slot, site)
if flag == no-local || field.type == no-type || field.type == invalid-type
    refuse(.refused-expression, site)
    =
if evaluated-before(flag)
    =
. group = bindings.slots[slot].group
. evaluate = ir.reserve-block()
. ready = ir.reserve-block()
branch(load-local(flag, site), ready, evaluate)
ir.start-block(evaluate)
. wavers = read-wavers(slot, site)
if wavers
    shared-depth += 1
lazy-open += slot
. value = make-operand(.operand-void, 0)
do match tree.nodes[group]
    | .node-declare(declaration)
        . name = declaration.left
        . annotation SyntaxId = 0
        do match? tree.nodes[declaration.left]
            | .node-type-capture(capture)
                name = capture.id
                annotation = capture.type
        if declaration.right == 0
            refuse(.refused-expression, site)
        else
            value = declared-value(name, annotation, declaration.right, field.type).operand
            claim-lazy(group, value, field.type)
    ??
        refuse(.refused-expression, site)
lazy-open.pop()
if wavers
    shared-depth -= 1
keep-captured(slot, value, field.type, site)
store-local(flag, integer(.machine-u8, 1), site)
jump(ready)
ir.start-block(ready)
ready-lazies += ReadyLazy(flag, ready)

────────────────────
_ do force-captured
    - site SyntaxId

` Gives each lazy local held as an eager local is (`holds-lazy`) that the emitted function
` declares and the nested function written at a node reads its value before the nested function
` is made, as `read-held` requires.
if unit.instance == no-instance || unit.reading != unit.instance
    =
. binding = instances.rows[unit.instance].binding
if binding == no-binding
    =
. bound = bindings.bindings[binding]
for offset in 0 .. < bound.nested.count
    . nested = bindings.nested[bound.nested.start + offset]
    if nested.syntax != site
        continue
    for index in 0 .. < nested.captures.count
        . slot = bindings.captures[nested.captures.start + index].slot
        if bindings.slots[slot].kind != .slot-lazy || !tables.holds-lazy(slot) || uncaptured
            continue
        .. uncaptured = !owns(slot) || !is-captured(slot)
        . open = false
        for held in lazy-open
            open = open || held == slot
        if !open
            force-held(slot, site)

────────────────────
_ do read-shared Typed
    - slot SlotId
    - id SyntaxId
    - type TypeId

` The value of a lazy local that nested functions capture. Its environment holds it, and
` after it the byte that says whether it has its value, which arrives cleared with the
` environment. Whichever read runs first, in the function that declares the local or in one
` written in it, evaluates the value there and sets the byte. The value is typed by the
` instance that declares the local, so a nested function reads that instance's facts while
` it evaluates it; one that returns nothing is evaluated for what it does, and a closable one is
` claimed as `claim-lazy` says. What the flow knows
` in the value holds wherever it is evaluated, unless the type pass found a read where a local
` the value reads is known otherwise than at the first.
` TypeScript gives a constructor two of each lazy local, one read while the properties are
` given their values and one its body reads, where one environment here holds one. So a
` constructor whose properties read such a local, or make a nested function, has no shape
` where its body reads one too. The value of a live declaration is evaluated in a live action
` whose trackers note what it reads, and the action is then made with the function that runs
` the declaration again, as `own-declared` makes it; one evaluated by a
` function written in the one that declares it, or in a turn of a loop that keeps an
` environment, has no shape here. The function that runs a statement of that one again reads
` it as it is: each read there is plain, so the statement's first run gave it its value.
. nothing = make-operand(.operand-void, 0)
. field = find-captured(slot, id)
. owner = home-owner
. declared = tables.live-statement-of(owner, bindings.slots[slot].group)
if declared && declared.rerun != no-instance && owner != unit.instance && reruns-in(owner)
    = read-captured(slot, id, type)
if facts.lazy-unheld(owner, slot) || tables.capture-rows[owner] != no-place
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
if !filling.storing && owner == unit.instance && fills-share()
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
if shared-evaluated-before(slot)
    = read-captured(slot, id, type)
. flag = lazy-flag(slot, id)
. evaluate = ir.reserve-block()
. ready = ir.reserve-block()
branch(load(captured-base(id), flag.offset, flag.layout, id), ready, evaluate)
ir.start-block(evaluate)
. group = bindings.slots[slot].group
. row = tree.nodes[group]
. live = tables.live-statement-of(owner, group)
. trackers = no-local
if live
    if owner != unit.instance || open-turns.length != 0 || live.rerun == no-instance
        refuse(.refused-expression, id)
        = Typed(nothing, no-type)
    trackers = open-trackers(id)
    live-actions += LiveTrackers(trackers, trackers)
. own-unit = unit
if owner != unit.instance
    unit = unit.lender = owner
    unit = unit.reading = owner
. wavers = facts.lazy-wavers(owner, slot) || dominated-read
    .. dominated-read = own-unit.reading == unit.instance && facts.is-dominated-read(unit.instance, id)
if wavers
    shared-depth += 1
sharing += 1
lazy-open += slot
. initial = nothing
do match row
    | .node-declare(declaration)
        . name = declaration.left
        . annotation SyntaxId = 0
        do match? tree.nodes[declaration.left]
            | .node-type-capture(capture)
                name = capture.id
                annotation = capture.type
        if field.type == no-type || field.type == invalid-type
            refuse(.refused-expression, id)
        else if bindings.lazy-together(slot)
            share-together(declaration.left, declaration.right, id)
        else if declaration.right == 0
            initial = default-value(annotation, field.type, field.layout, id).operand
        else
            . opened = lent-lazies.length
            if owner != unit.instance
                open-lent-lazies(declaration.right, id)
            initial = declared-value(name, annotation, declaration.right, field.type).operand
            close-lent-lazies(opened)
            claim-lazy(group, initial, field.type)
    ??
        refuse(.refused-expression, id)
lazy-open.pop()
if wavers
    shared-depth -= 1
sharing -= 1
unit = own-unit
if live
    live-actions.pop()
if !bindings.lazy-together(slot)
    keep-captured(slot, initial, field.type, id)
    settle-shared(slot, id)
if live
    own-declared(id, live, trackers)
jump(ready)
ir.start-block(ready)
shared-ready += SharedReady(slot, ready)
= read-captured(slot, id, type)

────────────────────
_ do claim-lazy
    - group SyntaxId
    - value Operand
    - type TypeId

` A closable value a lazy declaration holds, given where it is evaluated to the innermost markup
` element being built, or else the object `self` names, as the type pass claimed it
` (`AddressClaim`): made a `Closable` at the declaration and given to the `ClosableTracker`
` recorded there, which is made a `Tracker` and added to the trackers of a live action of that
` object, whose callback does nothing. Where neither is in force, nothing owns it.
. claimed = facts.address-claim-of(unit.reading, group)
if !claimed || (content-hosts.length == 0 && !(unit.has-self && tables.is-class(unit.owner-type)))
    =
. closable = convert(group, .reason-argument, Typed(value, type))
. mark = pending.length
pending += closable.operand
. tracker = call-instance(claimed.closer, group, mark)
. given = convert(group, .reason-argument, tracker)
. trackers = open-trackers(group)
add-tracker(load-local(trackers, group), given.operand, group)
do own-callback(load-local(trackers, group), idle, integer(.machine-managed-pointer, 0), group)
    .. idle = tables.idle-action

────────────────────
_ do own-declared
    - id SyntaxId
    - live LiveStatement
    - trackers LocalId

` The live action of a lazy declaration whose value read something tracked, made once the value
` is kept, with the trackers the value noted and a callback that runs the declaration again
` with the environment in force here: it is owned by the innermost markup element being built,
` or else by the object `self` names, and made as the type pass chose for an owner of that type
` (`LiveStatement`). It is made at whichever read evaluates the value first; at a read where no
` object is in force, it is a plain one, owned by nothing.
. code = tables.live-adapter-of(tables.instance-functions[live.rerun])
. top = content-hosts.length
. owner = if top != 0 then content-hosts[top - 1].operand else unit.self
. holder = if top != 0 then content-hosts[top - 1].type else own-holder
    .. own-holder = if unit.has-self && tables.is-class(unit.owner-type) then unit.owner-type else no-type
if holder != live.holder && holder != no-type
    refuse(.refused-expression, id)
    =
if live.owned == no-instance || holder != live.holder
    . action = make-action(load-local(trackers, id), code, written-environment(id), id)
    if holder != no-type
        attach-action(owner, action.operand, id)
    =
. callback = make-callback(code, written-environment(id), id)
. given = convert
    - live.site
    - if live.rooted then .reason-markup-batch else .reason-markup-host
    - Typed(owner, holder)
. mark = pending.length
pending += load-local(trackers, id)
pending += callback
pending += given.operand
. action = raising-call(live.site, live.owned, mark)
attach-action(owner, action.operand, id)

────────────────────
_ do share-together
    - left SyntaxId
    - value SyntaxId
    - site SyntaxId

` Evaluates the value of lazy locals declared together that an environment holds, and stores
` each first field of it in the field of the local its name declares, with the byte after it
` set. A name written as `_` takes nothing. A field of another type than its local's, a name
` written as a tuple, and locals declared together with no value have no shape here.
. names = RowRange'SyntaxId()
do match? tree.nodes[left]
    | .node-tuple-syntax(row)
        names = row.items
    | .node-type-tuple(row)
        names = row.field-types
if value == 0 || names.count == 0
    refuse(.refused-expression, site)
    =
. source = emit-expression(value)
. owner = source.type
. layout = layout-of(owner, site)
if !tables.layouts.is-struct(layout) || tables.layouts.rows[layout].fields.count < names.count
    refuse(.refused-expression, site)
    =
. binding = instances.rows[unit.reading].binding
for position in 0 .. < names.count
    . name = tree.children[names.start + position]
    . skipped = false
    do match? tree.nodes[name]
        | .node-type-capture(row)
            name = row.id
        | .node-type-wildcard
            skipped = true
    if skipped
        continue
    . resolution = bindings.resolution-of(binding, name)
    if resolution.kind != .resolve-slot || bindings.slots[resolution.slot].kind != .slot-lazy
        refuse(.refused-expression, name)
        =
    . part = take(source.operand, tables.layouts.field(layout, position), site)
    keep-captured(resolution.slot, part, field-type(owner, position), site)
    settle-shared(resolution.slot, site)

────────────────────
_ do settle-shared
    - slot SlotId
    - site SyntaxId

` Says a lazy local an environment holds has its value: sets the byte after it.
find-captured(slot, site)
. flag = lazy-flag(slot, site)
. base = captured-base(site)
store(base, flag.offset, integer(.machine-u8, 1), false, site)

────────────────────
_ do lazy-flag LayoutField
    - slot SlotId
    - site SyntaxId

` The byte that says a lazy local `find-captured` has just found has its value: the field
` after the local's in the environment that holds it, the function's or that of a turn of
` a loop.
. place = 2 + tables.slot-fields[slot]
if home-layout == no-layout || place >= tables.layouts.rows[home-layout].fields.count
    refuse(.refused-expression, site)
    = LayoutField(0, void-layout)
= tables.layouts.field(home-layout, place)

────────────────────
_ do read-filling Typed
    - slot SlotId
    - offset U32
    - id SyntaxId
    - type TypeId

` The value of a lazy local read while a constructor gives the properties their first
` values: whichever such read runs first evaluates it, into a cell of its own, and sets its
` flag. The body's reads evaluate the value again, as the binding's policy says. A tracked
` read of one tracks nothing, since nothing stores to it. A local that a nested function reads
` has no shape here, nor has one declared together with others: TypeScript evaluates their
` value once for them all.
. nothing = make-operand(.operand-void, 0)
. flag = unit.fill-flags[offset]
if flag == no-local || (bindings.slots[slot].flags /and/ SlotFlag.slot-captured) != 0
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
if bindings.lazy-together(slot)
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. own = unit.cells[offset]
unit.cells[offset] = unit.fill-cells[offset]
. evaluate = ir.reserve-block()
. ready = ir.reserve-block()
branch(load-local(flag, id), ready, evaluate)
ir.start-block(evaluate)
shared-depth += 1
evaluate-lazy(slot, offset, id)
shared-depth -= 1
. value = nothing
store-local(flag, integer(.machine-u8, 1), id)
jump(ready)
ir.start-block(ready)
. localed = read-local(slot, id, type)
value = localed.operand
unit.fill-cells[offset] = unit.cells[offset]
unit.cells[offset] = own
= Typed(value, localed.type)

────────────────────
_ do evaluate-lazy
    - slot SlotId
    - offset U32
    - site SyntaxId

` Evaluates the value a lazy local is declared with and stores it in the local's cell, which
` it is given the first time. The value is converted to the type written for the local, and
` one with no value written is what its type has for one; a closable one is claimed as
` `claim-lazy` says. The locals a declaration names together are declared together, as where
` the declaration is not lazy.
. group = bindings.slots[slot].group
if bindings.lazy-together(slot)
    do match? tree.nodes[group]
        | .node-declare(row)
            . opened = lazy-open.length
            for position in 0 .. < unit.slot-count
                if bindings.slots[unit.slot-start + position].group == group
                    lazy-open += unit.slot-start + position
            emit-declare(group, row.left, machine-or-value(row.left, row.right))
            while lazy-open.length != opened
                lazy-open.pop()
            =
lazy-open += slot
do match tree.nodes[group]
    | .node-declare(row)
        . name = row.left
        . annotation SyntaxId = 0
        do match? tree.nodes[row.left]
            | .node-type-capture(capture)
                name = capture.id
                annotation = capture.type
        . type = facts.slot-type(unit.instance, offset)
        . plain = false
        do match? tree.nodes[name]
            | .node-identifier
                plain = true
        if !plain || type == no-type || type == invalid-type
            refuse(.refused-expression, site)
        . layout = layout-of(type, site)
        . initial = if row.right == 0 then default-value(annotation, type, layout, site) else declared-value(name, annotation, row.right, type)
        if row.right != 0
            claim-lazy(group, initial.operand, type)
        if layout != void-layout
            if unit.cells[offset] == no-local
                . taken = (bindings.slots[slot].flags /and/ SlotFlag.slot-address-taken) != 0
                unit.cells[offset] = ir.add-local(layout, taken)
            store-local(unit.cells[offset], initial.operand, site)
    ??
        refuse(.refused-expression, site)
lazy-open.pop()

────────────────────
_ do read-item Typed
    - loop SyntaxId
    - id SyntaxId
    - type TypeId

` The item of a loop whose body is being emitted, in the type the loop gives it. Where the
` type pass narrowed an optional item to what it holds, or a union to a case, the read is of
` that, as a local's is.
. nothing = make-operand(.operand-void, 0)
. position = loops.length
while position != 0
    position -= 1
    . row = loops[position]
    if row.syntax != loop
        continue
    if row.item-type == type
        if row.kept != no-slot
            = state(row.kept, id)
        = Typed(row.item, type)
    . cased = facts.plan-of(unit.reading, id) == .plan-case-read
    if row.kept == no-slot || shared-depth != 0 || (!cased && !holds(row.item-type, type))
        refuse(.refused-expression, id)
        = Typed(nothing, no-type)
    . value = state(row.kept, id)
    if cased
        = read-case(id, value.operand, row.item-type, type)
    = payload(id, value)
refuse(.refused-expression, id)
= Typed(nothing, no-type)

────────────────────
_ do unit-text Operand
    - type TypeId

` The name a number of a type is written with, as text.
. text = ""
. name = unit-name(types, type)
if name
    text = name.text
= make-operand(.operand-constant, ir.add-string(text))

────────────────────
_ argument-position U32
    - slot SlotId

` Which of the function's arguments a slot of its own binding is.
unit.positions[slot - unit.slot-start]

────────────────────
_ is-own-slot Bool
    - slot SlotId

slot >= unit.slot-start && slot - unit.slot-start < unit.slot-count

────────────────────
_ do load-property Typed
    - id SyntaxId
    - object Operand
    - owner TypeId
    - name Atom
    - own Bool = false
    - read TypeId = no-type

` Reads a stored property of an object, or a field of a struct: a scalar is loaded, and a
` struct is its address inside its owner. A property with no bits is read as nothing. A lazy
` property is read through its function, and under `catch` it may have the type of what that
` function answers where the value lets out errors. The read has the property's own type, or,
` where the type pass knows an optional property to hold a value, the type of what it holds:
` the read is then of that, with no test. A link of an optional chain has the property's own
` type, which the chain then holds in the optional its node has, and so has, as `own` says,
` the property a case of a union stores, read for a member the union forwards. A name a
` call calls is typed by no node, and is read as the type given. Where no table holds a
` function for a lazy property, as no object of a class that has it is ever made, the read never
` runs, and stands for the value its type has with nothing written (`unread-value`).
. nothing = make-operand(.operand-void, 0)
if types.is-optional(owner)
    = optional-member(id, object, owner, name)
. found = property-of(owner, name)
if !found
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. property = types.properties[found]
. typed = if read != no-type then read else facts.node-type(unit.reading, id)
. type = if own || is-link(id) then property.type else typed
. holds = property.type != type && types.is-optional(property.type)
. narrowed = holds && types.optional-inner(property.type) == type
. is-lazy = property.storage-kind == .storage-lazy && tables.is-class(owner)
if is-lazy && !tables.lazy-runs(found as U32)
    = unread-value(type, layout-of(type, id), id)
. caught = is-lazy && type != property.type && type == tables.lazy-result(found as U32)
. cased = property.type != type && !is-lazy && unit.reading != no-instance && case-read
    .. case-read = facts.plan-of(unit.reading, id) == .plan-case-read
if ((property.type != type && !narrowed && !cased) || (narrowed && is-lazy)) && !caught
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
if is-lazy
    = read-lazy(id, object, found as U32)
. field = held-field(id, owner, found)
if field.layout == void-layout
    = Typed(nothing, type)
settle-memo(id, object, owner, property)
if narrowed && id == stored-read
    = Typed(take(object, field, id), property.type)
if narrowed && shared-depth != 0 && !facts.is-inside-read(unit.reading, id)
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
if narrowed
    = payload(id, Typed(take(object, field, id), property.type))
if cased
    = read-case(id, take(object, field, id), property.type, type)
if tables.layouts.is-struct(field.layout)
    = Typed(address(object, field.offset, field.layout, id), type)
. loaded = load(object, field.offset, field.layout, id)
if unit.reading != no-instance && facts.plan-of(unit.reading, id) == .plan-guarded-read
    = guard-element(id, Typed(loaded, type), name)
= Typed(loaded, type)

────────────────────
_ do guard-element Typed
    - id SyntaxId
    - element Typed
    - name Atom

. held = element.type
if !function.may-panic && !in-landing
    refuse(.refused-expression, id)
    = element
. made = ir.reserve-block()
. missing = ir.reserve-block()
branch(compare(id, .compare-not-equal, element.operand, integer(.machine-pointer, 0)), made, missing)
ir.start-block(missing)
raise-text(id, "Named markup element \"${name.text}\" is read before its markup constructs it")
ir.start-block(made)
= Typed(element.operand, held)

────────────────────
_ do held-field LayoutField
    - site SyntaxId
    - owner TypeId
    - place Index

` Where an object or a struct holds a property it stores as declared, how, and its type.
. none = LayoutField(0, no-layout)
. property = types.properties[place]
if property.storage-kind != .storage-eager
    refuse(.refused-expression, site)
    = none
. holder = layout-of(owner, site)
. field = none
if tables.layouts.is-struct(holder)
    field = tables.layouts.field(holder, property.slot)
else if tables.is-class(owner) && tables.layouts.objects[owner] != no-layout
    . object-layout = tables.layouts.objects[owner]
    field = tables.layouts.field(object-layout, object-header-fields + property.slot)
if field.layout == no-layout
    refuse(.refused-type, site)
    = none
= LayoutField(field.offset, field.layout, property.type)

────────────────────
_ do optional-member Typed
    - id SyntaxId
    - object Operand
    - owner TypeId
    - name Atom

` What an optional answers by itself: `value`, what it holds, read with no test, and
` `has-value`, its flag.
if name == types.value-atom!
    = payload(id, Typed(object, owner))
if name == types.has-value-atom! && is-null-form(owner)
    = present(id, Typed(object, owner))
. layout = layout-of(owner, id)
if name != types.has-value-atom! || !tables.layouts.is-struct(layout)
    refuse(.refused-expression, id)
    = Typed(make-operand(.operand-void, 0), no-type)
. flag = tables.layouts.field(layout, 1)
= Typed(load(object, flag.offset, flag.layout, id), facts.node-type(unit.reading, id))

────────────────────
_ property-of Index?
    - owner TypeId
    - name Atom

` The property of a type by its name, among those the type pass completed it with, as the
` module whose code is emitted sees it.
types.property-seen(owner, name, unit.source-module)

────────────────────
_ property-read Index?
    - owner TypeId
    - read FactId

` The property a value written for another reads, as the module of the value sees it.
types.property-seen(owner, value.name, instances.rows[value.instance].module)

.. value = facts.value-reads[read]

────────────────────
_ do emit-binary Typed
    - id SyntaxId
    - op Operator
    - lhs SyntaxId
    - rhs SyntaxId

` A binary operator, in the way the type pass planned it. A pipe written on one line with
` what it reads is one.
if op == .coalesce-op
    = emit-coalesce(id, lhs, rhs)
if op == .else-op
    do match? tree.nodes[lhs]
        | .node-binary-expression(row)
            = emit-choice(id, row.lhs, row.rhs, rhs)
if forward-pipe || write-pipe || op == .stream-pattern-pipe-op || pipes-stream(op)
    = emit-pipe(id, op, lhs, rhs)
.. forward-pipe = op == .pipe-forward-op || op == .pipe-closure-op
.. write-pipe = op == .pipe-write-all-op || op == .pipe-write-each-op
if op == .concat-op || op == .concat-string-op
    = emit-concat(id, lhs, rhs, op == .concat-string-op)
if op == .and-op || op == .or-op
    = emit-logic(id, op == .and-op, lhs, rhs)
if op == .if-op
    = emit-conditional(id, lhs, rhs)
= emit-planned(id, op, lhs, rhs, facts.plan-of(unit.reading, id))

────────────────────
_ do emit-planned Typed
    - id SyntaxId
    - op Operator
    - lhs SyntaxId
    - rhs SyntaxId
    - plan OperatorPlan

` A binary operator answered by a plan: the one the type pass recorded at the node, or for
` operands compared as what they hold the plan of that comparison.
if plan == .plan-absent && (op == .equals-op || op == .not-equals-op)
    = emit-absent(id, lhs, rhs, op == .not-equals-op)
if plan == .plan-held && (op == .equals-op || op == .not-equals-op)
    = emit-held(id, lhs, rhs, op == .not-equals-op)
if plan == .plan-list-member
    = emit-list-member(id, op, lhs, rhs)
if plan == .plan-builtin
    = emit-builtin(id, op, lhs, rhs)
if plan == .plan-sign-checked-left || plan == .plan-sign-checked-right
    = emit-sign-checked(id, op, lhs, rhs, plan == .plan-sign-checked-left)
if plan == .plan-call && is-function-call(id)
    = emit-fact-call(id, facts.calls[own-call(id)], 0, RowRange'SyntaxId(), rhs, lhs)
if plan == .plan-call || plan == .plan-negated-call || plan == .plan-neither-call || not-or-plan
    = emit-operator-call(id, lhs, rhs, plan)
.. not-or-plan = plan == .plan-not-or-call
if plan == .plan-pointer-add && op == .add-op
    = emit-pointer-add(id, lhs, rhs)
if plan == .plan-table && op == .add-op && table-op(id) == TableOp.table-zip
    = emit-table-zip(id, lhs, rhs)
if plan == .plan-fields || plan == .plan-not-fields
    = emit-fields-compare(id, lhs, rhs, plan == .plan-not-fields)
if plan == .plan-class-test && (op == .is-op || op == .is-not-op)
    = emit-class-test(id, lhs, op == .is-not-op)
if plan == .plan-is
    = emit-is
        - id
        - lhs
        - rhs
        - op == .is-not-op || op == .is-not-exactly-op || op == .is-not-similar-op
if plan == .plan-identity && (op == .equals-op || op == .not-equals-op)
    = emit-identity(id, lhs, rhs, op == .not-equals-op)
if plan == .plan-address-compare && is-comparison(op)
    = emit-address-compare(id, op, lhs, rhs)
if plan == .plan-interface-equal && (op == .equals-op || op == .not-equals-op)
    = emit-interface-equal(id, lhs, rhs, op == .not-equals-op)
if plan == .plan-interface-unlike && (op == .equals-op || op == .not-equals-op)
    = emit-interface-unlike(id, lhs, rhs)
if (plan == .plan-unlike || plan == .plan-alike) && (op == .equals-op || op == .not-equals-op)
    emit-expression(lhs)
    emit-expression(rhs)
    = Typed(integer(.machine-u8, if (op == .not-equals-op) == (plan == .plan-unlike) then 1 else 0), types.bool-type)
refuse(.refused-expression, id)
= Typed(make-operand(.operand-void, 0), no-type)

────────────────────
_ do emit-list-member Typed
    - id SyntaxId
    - op Operator
    - lhs SyntaxId
    - rhs SyntaxId

` `has` or `has not` of a list written in place, or `is in` or `not in` of a value in one,
` answered as `List.has` answers it without making the list: the operands are evaluated in the
` order they are written, the items converted as the list's are and the value as the argument
` of `has` is, and each item in turn is compared with the value by the plan of `==` recorded at
` the list, up to the first that is equal.
. nothing = make-operand(.operand-void, 0)
. is-right = op == .is-in-op || op == .not-in-op
. negated = op == .has-not-op || op == .not-in-op
. written = if is-right then rhs else lhs
. tested = if is-right then lhs else rhs
. items = RowRange'SyntaxId()
do match? tree.nodes[written]
    | .node-list-syntax(row)
        items = row.items
. has = own-call(id)
. plan = facts.plan-of(unit.reading, written)
. equality = list-equality(written)
. machine = plan == .plan-builtin || plan == .plan-identity
if items.count == 0 || has == no-fact || (!machine && (plan != .plan-call || equality == no-fact))
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. item-type = instances.argument-type(facts.calls[has].callee, 0)
. value = Typed(nothing, no-type)
if is-right
    . emitted = emit-expression(tested)
    value = Typed(apart(emitted, tested, !is-inert(written)), emitted.type)
. start = given.length
. disturbed = items.count > 1 || (!is-right && !is-inert(tested))
for item in tree.children[items]
    . made = emit-expression(item)
    given += Typed(apart(made, item, disturbed), made.type)
for position in 0 .. < items.count
    . item = tree.children[items.start + position]
    given[start + position] = convert(item, .reason-element, given[start + position])
    if given[start + position].type != item-type
        refuse(.refused-conversion, item)
if !is-right
    value = emit-expression(tested)
value = convert(tested, .reason-argument, value)
if value.type != item-type
    refuse(.refused-conversion, tested)
. joined = ir.reserve-block()
. slot = make-operand(.operand-void, 0)
. arrivals = joins.length
. found = integer(.machine-u8, if negated then 0 else 1)
for position in 0 .. < items.count
    . item = tree.children[items.start + position]
    . element = given[start + position].operand
    . equal = nothing
    if machine
        equal = compare(item, .compare-equal, element, value.operand)
    else
        . answer = call-operator(written, equality, written, element, item-type, written, value.operand, item-type)
        if answer.type != types.bool-type
            refuse(.refused-expression, id)
        equal = answer.operand
    . matched = ir.reserve-block()
    . next = ir.reserve-block()
    branch(equal, matched, next)
    ir.start-block(matched)
    arrive(id, found, joined, slot)
    ir.start-block(next)
drop-given(start)
arrive(id, integer(.machine-u8, if negated then 1 else 0), joined, slot)
= Typed(close-joins(joined, arrivals, u8-layout, slot), types.bool-type)

────────────────────
_ do list-equality FactId
    - written SyntaxId

` The call of `==` recorded at a list written in place, after the calls that would make it, or
` no fact where none was.
. fact = facts.first-call(unit.reading, written)
while fact != no-fact
    if facts.calls[fact].form == .call-operator
        = fact
    fact = facts.calls[fact].next
= no-fact

────────────────────
_ do emit-held Typed ?! Refused
    - id SyntaxId
    - lhs SyntaxId
    - rhs SyntaxId
    - negated Bool

` `==` of operands compared as what they hold, or with `negated` `!=`: optionals, or a union
` on the left tested for one case, after what an optional holds is taken from it. Both operands
` are evaluated once, the left one first. An
` optional that holds nothing equals nothing that holds a value, and two that hold nothing
` are equal where the type pass says so. A union that holds another case equals no value.
` What both hold is compared by the plan of that `==`, with the operands in the order the
` type pass planned it in.
. nothing = make-operand(.operand-void, 0)
. held = facts.held-of(unit.reading, id)
. mark = pins.length
. emitted = emit-expression(lhs)
. left = apart(emitted, lhs, !is-inert(rhs))
. left-type = emitted.type
. right = emit-expression(rhs)
. right-type = right.type
if held.left != types.is-optional(left-type) || right-differs || held.plan == .plan-held
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
.. right-differs = held.right != types.is-optional(right-type)
. joined = ir.reserve-block()
. slot = make-operand(.operand-void, 0)
. arrivals = joins.length
. differs = integer(.machine-u8, if negated then 1 else 0)
if held.left
    . filled = ir.reserve-block()
    . empty = ir.reserve-block()
    branch(present(id, Typed(left, left-type)).operand, filled, empty)
    ir.start-block(empty)
    if held.alike
        . other = present(id, Typed(right.operand, right-type))
        arrive(id, (if negated then other else compare-zero(id, other, .compare-equal)).operand, joined, slot)
    else
        arrive(id, differs, joined, slot)
    ir.start-block(filled)
    . inner = payload(id, Typed(left, left-type))
    left = inner.operand
    left-type = inner.type
if held.case-index != U32.max
    . layout = layout-of(left-type, id)
    if !tables.layouts.is-union(layout) || past-cases
        refuse(.refused-expression, id)
    .. past-cases = held.case-index >= tables.layouts.rows[layout].cases.count
    . filled = ir.reserve-block()
    . empty = ir.reserve-block()
    branch(case-test(id, left, held.case-index), filled, empty)
    ir.start-block(empty)
    arrive(id, differs, joined, slot)
    ir.start-block(filled)
    . field = tables.layouts.case-field(layout, held.case-index)
    left = take(left, field, id)
    left-type = field.type
if held.right
    . filled = ir.reserve-block()
    . empty = ir.reserve-block()
    branch(present(id, Typed(right.operand, right-type)).operand, filled, empty)
    ir.start-block(empty)
    arrive(id, differs, joined, slot)
    ir.start-block(filled)
    right = payload(id, Typed(right.operand, right-type))
    right-type = right.type
pin(lhs, left, left-type)
pin(rhs, right.operand, right-type)
. equal = Typed(nothing, no-type)
if held.exchanged
    equal = emit-planned(id, .equals-op, rhs, lhs, held.plan)
else
    equal = emit-planned(id, .equals-op, lhs, rhs, held.plan)
unpin(mark)
if equal.type != types.bool-type
    refuse(.refused-expression, id)
if negated
    equal = compare-zero(id, equal, .compare-equal)
arrive(id, equal.operand, joined, slot)
. answer = close-joins(joined, arrivals, u8-layout, slot)
= Typed(answer, types.bool-type)

────────────────────
_ do emit-absent Typed
    - id SyntaxId
    - lhs SyntaxId
    - rhs SyntaxId
    - negated Bool

` Compares an optional with `null`, written on either side: they are equal when the optional
` holds nothing. An operand that is not an optional is a local known to hold a value.
. nothing = make-operand(.operand-void, 0)
. left = emit-expression(lhs)
. left-type = left.type
. right = emit-expression(rhs)
. subject = right
if left-type != types.null-type
    subject = left
if !types.is-optional(subject.type)
    = Typed(integer(.machine-u8, if negated then 1 else 0), types.bool-type)
. filled = present(id, subject)
if negated
    = filled
= Typed(compare(id, .compare-equal, filled.operand, integer(.machine-u8, 0)), filled.type)

────────────────────
_ do emit-conditional Typed
    - id SyntaxId
    - chosen SyntaxId
    - condition SyntaxId

` `value if condition`: an optional that holds the value where the condition tests as true,
` and nothing where it does not. The value is evaluated only then, and arrives as the
` optional by the conversion recorded for a side.
. nothing = make-operand(.operand-void, 0)
. type = facts.node-type(unit.reading, id)
. layout = layout-of(type, id)
. joinable = tables.layouts.is-struct(layout) || is-null-form(type)
if !types.is-optional(type) || !joinable
    refuse(.refused-type, id)
. tested = test(id, emit-expression(condition), true, true)
. taken = ir.reserve-block()
. passed = ir.reserve-block()
. joined = ir.reserve-block()
. slot = join-slot(layout)
. mark = joins.length
branch(tested.operand, taken, passed)
ir.start-block(taken)
emit-arm(id, chosen, type, joined, slot)
ir.start-block(passed)
arrive(id, empty-optional(type, layout).operand, joined, slot)
= Typed(close-joins(joined, mark, layout, slot), type)

────────────────────
_ do emit-class-test Typed
    - id SyntaxId
    - lhs SyntaxId
    - negated Bool

` Whether an object is of a class or of one derived from it, or with `negated` whether it
` is not. The class is the constant the type pass recorded at the node.
. nothing = make-operand(.operand-void, 0)
. fact = facts.constant-of(unit.reading, id)
. value = emit-expression(lhs)
if fact == no-fact || !tables.is-class(value.type)
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. target = facts.constants[fact].bits as TypeId
if !tables.is-class(target)
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. matched = ir.reserve-block()
. missed = ir.reserve-block()
. joined = ir.reserve-block()
class-branch(id, value.operand, target, matched, missed)
ir.start-block(matched)
jump(joined)
ir.start-block(missed)
jump(joined)
ir.start-block(joined)
. yes = integer(.machine-u8, 1)
. no = integer(.machine-u8, 0)
= Typed(phi(u8-layout, if negated then no else yes, matched, if negated then yes else no, missed), types.bool-type)

────────────────────
_ do class-branch
    - site SyntaxId
    - value Operand
    - type TypeId
    - matched IRBlockId
    - missed IRBlockId
    - witnessed Bool = false

` Leaves to `matched` when an object is of a class or of one derived from it, and to
` `missed` when it is not: the object's table, and then the table of each base in turn, is
` compared with the class's. A class the program constructs no object of, nor of any class
` derived from it, has no table, and no object is of it. With `witnessed` the value is one
` of an interface, and the first table is the one its witness table names, which is nothing
` where it holds no object.
. symbol = tables.table-symbols[type]
if symbol == no-string
    jump(missed)
    =
. cell = ir.add-local(pointer-layout)
if witnessed
    . second = tables.layouts.field(tables.layouts.interface-layout, 1).offset
    . witness = load(value, second, pointer-layout, site)
    store-local(cell, load(witness, 2 * table-slot-size, pointer-layout, site), site)
else
    store-local(cell, load(value, 0, pointer-layout, site), site)
. head = ir.reserve-block()
. held = ir.reserve-block()
. climb = ir.reserve-block()
jump(head)
ir.start-block(head)
. table = load-local(cell, site)
branch(table, held, missed)
ir.start-block(held)
if matching.exact-class
    branch
        - compare(site, .compare-equal, table, make-operand(.operand-symbol, symbol))
        - matched
        - missed
    ir.start-block(climb)
    jump(missed)
    =
branch(compare(site, .compare-equal, table, make-operand(.operand-symbol, symbol)), matched, climb)
ir.start-block(climb)
store-local(cell, load(table, 0, pointer-layout, site), site)
jump(head)

────────────────────
_ do down-cast Typed
    - site SyntaxId
    - value Operand
    - type TypeId
    - declared Bool = false

` An object as a class derived from the one it is known by: the object itself when it is of
` that class, and a panic when it is not, or inside a pattern a value that does not match.
` The panic of a cast names the class; where a declaration wrote the class for a local, it
` is that of a pattern that failed.
if matching.failing != no-block
    . passed = ir.reserve-block()
    class-branch(site, value, type, passed, matching.failing)
    fail-jumps += 1
    ir.start-block(passed)
    = Typed(value, type)
if !function.may-panic
    refuse(.refused-conversion, site)
    = Typed(value, no-type)
. matched = ir.reserve-block()
. missed = ir.reserve-block()
class-branch(site, value, type, matched, missed)
ir.start-block(missed)
raise-text
    - site
    - if declared then "Pattern match failed" else "Invalid cast to ${type-display(types, type)}"
ir.start-block(matched)
= Typed(value, type)

────────────────────
_ do held-as Typed
    - site SyntaxId
    - value Operand
    - type TypeId
    - declared Bool = false

` What a value of an interface holds, as the class or the tuple a cast or a pattern names.
` It holds an object of a class where the table its witness table names is the class's or
` that of one derived from it, and a value of any other type where the type its witness
` table describes is that one. A type nothing is converted to an interface from has no
` description named, and nothing holds it. A value that holds another panics, or inside a
` pattern does not match. The panic is that of a cast, or where a declaration wrote the type
` for a local, that of a pattern that failed.
. missed = matching.failing
if matching.failing == no-block
    if !function.may-panic
        refuse(.refused-conversion, site)
        = Typed(value, no-type)
    missed = ir.reserve-block()
else
    fail-jumps += 1
. passed = ir.reserve-block()
. named = tables.rtti-symbols[type]
if tables.is-class(type)
    class-branch(site, value, type, passed, missed, true)
else if named == no-string
    jump(missed)
else
    . second = tables.layouts.field(tables.layouts.interface-layout, 1).offset
    . described = load(load(value, second, pointer-layout, site), 0, pointer-layout, site)
    branch
        - compare(site, .compare-equal, described, make-operand(.operand-symbol, named))
        - passed
        - missed
if matching.failing == no-block
    ir.start-block(missed)
    raise-text(site, if declared then "Pattern match failed" else "Invalid cast to ${type-display(types, type)}")
ir.start-block(passed)
= unbox(site, type, value)

────────────────────
_ do subclass-interface Typed
    - site SyntaxId
    - value Operand
    - from TypeId
    - to TypeId
    - declared Bool = false

` An object as an interface that classes derived from the one it is known by declare: the
` slot the table of its class keeps for the interface holds the class's witness table, or
` nothing where the class declares none (`dynamic-slot`). One that holds nothing panics, or
` inside a pattern does not match, as a cast to a class does.
. nothing = make-operand(.operand-void, 0)
. layout = layout-of(to, site)
. slot = tables.dynamic-slot(from, to)
if layout != tables.layouts.interface-layout || slot == no-slot-index
    refuse(.refused-conversion, site)
    = Typed(nothing, no-type)
. missed = matching.failing
if matching.failing == no-block
    if !function.may-panic
        refuse(.refused-conversion, site)
        = Typed(nothing, no-type)
    missed = ir.reserve-block()
else
    fail-jumps += 1
. passed = ir.reserve-block()
. class-table = load(value, 0, pointer-layout, site)
. table = load(class-table, table-header-size + slot * table-slot-size, pointer-layout, site)
branch(compare(site, .compare-not-equal, table, integer(.machine-pointer, 0)), passed, missed)
if matching.failing == no-block
    ir.start-block(missed)
    raise-text
        - site
        - if declared then "Pattern match failed" else "Invalid cast to ${type-display(types, to)}"
ir.start-block(passed)
. made = frame(layout)
store(made, 0, value, false, site)
store(made, tables.layouts.field(layout, 1).offset, table, false, site)
= Typed(made, to)

────────────────────
_ do emit-identity Typed
    - id SyntaxId
    - lhs SyntaxId
    - rhs SyntaxId
    - negated Bool

` Two objects of one class compared, or of two classes one derived from the other, two atoms,
` or two values of one closure: equal when they are one object, one atom, or one closure's
` data, which is to say one pointer. Two values of one function type are equal when they run
` one code with one data.
. nothing = make-operand(.operand-void, 0)
. emitted = emit-expression(lhs)
. left = apart(emitted, lhs, !is-inert(rhs))
. type = emitted.type
. right = emit-expression(rhs)
if right.type == type && tables.layouts.values[type] == tables.layouts.function-layout
    . code = tables.layouts.field(tables.layouts.function-layout, 0).offset
    . data = tables.layouts.field(tables.layouts.function-layout, 1).offset
    . same-code = compare
        - id
        - .compare-equal
        - load(left, code, pointer-layout, id)
        - load(right.operand, code, pointer-layout, id)
    . same-data = compare
        - id
        - .compare-equal
        - load(left, data, managed-layout, id)
        - load(right.operand, data, managed-layout, id)
    . same = bitwise(id, .bitwise-and, same-code, same-data, u8-layout)
    = if negated then compare-zero(id, Typed(same, types.bool-type), .compare-equal) else Typed(same, types.bool-type)
. objects = tables.is-class(type) && tables.is-class(right.type)
if (right.type != type && !objects) || no-identity
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
.. no-identity = !tables.is-class(type) && intrinsic(type) != .atom && intrinsic(type) != .closure
= Typed(compare(id, if negated then .compare-not-equal else .compare-equal, left, right.operand), types.bool-type)

────────────────────
_ do emit-address-compare Typed
    - id SyntaxId
    - op Operator
    - lhs SyntaxId
    - rhs SyntaxId

` Two C pointers compared by the addresses they hold, as unsigned numbers, the left one
` evaluated first.
. nothing = make-operand(.operand-void, 0)
. emitted = emit-expression(lhs)
. left = apart(emitted, lhs, !is-inert(rhs))
. left-type = emitted.type
. right = emit-expression(rhs)
. right-type = right.type
if left-type == types.null-type && intrinsic(right-type) == .cpointer
    left = integer(tables.layouts.kind-of(layout-of(right-type, id)), 0)
    left-type = right-type
if right-type == types.null-type && intrinsic(left-type) == .cpointer
    right = Typed(integer(tables.layouts.kind-of(layout-of(left-type, id)), 0), right.type)
    right-type = left-type
if intrinsic(left-type) != .cpointer || intrinsic(right-type) != .cpointer
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
= Typed(compare(id, predicate-of(op), left, right.operand), types.bool-type)

────────────────────
_ do emit-fields-compare Typed
    - id SyntaxId
    - lhs SyntaxId
    - rhs SyntaxId
    - negated Bool

` Two tuples or structs compared field by field, in the order the fields are stored, up to
` the first that differs, or two unions of one type by the case they hold. The left one is
` copied first when evaluating the right one may change what it names.
. nothing = make-operand(.operand-void, 0)
. left = emit-expression(lhs)
. left-type = left.type
if !is-inert(rhs) && !is-answer(left.operand)
    left = Typed(snapshot(left.operand, layout-of(left-type, id), lhs), left.type)
. right = emit-expression(rhs)
. right-type = right.type
. differ = ir.reserve-block()
. joined = ir.reserve-block()
field-call = facts.first-call(unit.reading, id)
field-site = rhs
skip-truths()
compare-parts(id, left.operand, left-type, right.operand, right-type, differ)
if field-call != no-fact
    refuse(.refused-expression, id)
field-call = no-fact
field-site = 0
. same = ir.current
jump(joined)
ir.start-block(differ)
jump(joined)
ir.start-block(joined)
. yes = integer(.machine-u8, 1)
. no = integer(.machine-u8, 0)
= Typed(phi(u8-layout, if negated then no else yes, same, if negated then yes else no, differ), types.bool-type)

────────────────────
_ do emit-interface-equal Typed
    - id SyntaxId
    - lhs SyntaxId
    - rhs SyntaxId
    - negated Bool

` Two values of interfaces compared for equal, or with `negated` for not equal, as
` `compare-interfaces` compares them. The left one is copied first when evaluating the right
` one may change what it names.
. nothing = make-operand(.operand-void, 0)
. left = emit-expression(lhs)
. left-type = left.type
if !is-inert(rhs) && !is-answer(left.operand)
    left = Typed(snapshot(left.operand, layout-of(left-type, id), lhs), left.type)
. right = emit-expression(rhs)
field-call = facts.first-call(unit.reading, id)
skip-truths()
. equal = compare-interfaces(id, left.operand, right.operand)
if field-call != no-fact
    refuse(.refused-expression, id)
field-call = no-fact
= if negated then compare-zero(id, Typed(equal.operand, types.bool-type), .compare-equal) else Typed(equal.operand, types.bool-type)

────────────────────
_ do emit-interface-unlike Typed
    - id SyntaxId
    - lhs SyntaxId
    - rhs SyntaxId

` A value of an interface compared with one of a type that is none: both are evaluated, and
` it panics with the reference's text, which names the right one's type.
. nothing = make-operand(.operand-void, 0)
emit-expression(lhs)
. emitted = emit-expression(rhs)
. right-type = emitted.type
raise-text(id, "Unsupported interface equality with ${type-runtime-name(types, right-type)}")
ir.start-block(ir.reserve-block())
= Typed(integer(.machine-u8, 0), types.bool-type)

────────────────────
_ do compare-interfaces Typed
    - id SyntaxId
    - left Operand
    - right Operand

` Compares two values of interfaces as the reference does. Where the types their witness
` tables describe differ, the getter recorded next at the node says whether a tracker is
` comparing for a change: the answer is then false, and otherwise the panic `Unsupported
` interface equality: concrete types differ`. Where they agree, the function the left
` value's table holds for equality is given both, and answers; a panic it raises is the
` caller's.
. nothing = make-operand(.operand-void, 0)
if field-call == no-fact
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. getter = facts.calls[field-call].callee
field-call = facts.calls[field-call].next
skip-truths()
if getter == no-instance || tables.instance-functions[getter] == no-function
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. second = tables.layouts.field(tables.layouts.interface-layout, 1).offset
. mine = load(left, second, pointer-layout, id)
. theirs = load(right, second, pointer-layout, id)
. same = ir.reserve-block()
. differ = ir.reserve-block()
. joined = ir.reserve-block()
branch
    - compare
        - id
        - .compare-equal
        - load(mine, 0, pointer-layout, id)
        - load(theirs, 0, pointer-layout, id)
    - same
    - differ
ir.start-block(differ)
. comparing = call-instance(getter, id, pending.length)
. tolerated = ir.reserve-block()
. unsupported = ir.reserve-block()
branch(comparing.operand, tolerated, unsupported)
ir.start-block(unsupported)
raise-text(id, "Unsupported interface equality: concrete types differ")
ir.start-block(tolerated)
. unequal = integer(.machine-u8, 0)
. from-differ = ir.current
jump(joined)
ir.start-block(same)
. method = load(mine, table-slot-size, pointer-layout, id)
. mark = pending.length
pending += left
pending += right
. answer = call(method, id, mark, .callee-value, u8-layout, !in-landing)
. from-same = ir.current
jump(joined)
ir.start-block(joined)
= Typed(phi(u8-layout, unequal, from-differ, answer, from-same), types.bool-type)

────────────────────
_ takes-argument Bool
    - callee InstanceId
    - given TypeId

` Whether a field's `==` takes a value of a type: as it is, or by the conversion the type pass
` recorded for it at `field-site`.
taken == given || argument-conversion(given, taken) != no-fact

.. taken = instances.argument-type(callee, 0)

────────────────────
_ do argument-conversion FactId
    - from TypeId
    - to TypeId

` The conversion the type pass recorded at `field-site` for a value a field's `==` takes, from
` the field's type to the type the `==` takes. No fact where none was recorded.
. fact = if field-site != 0 then facts.first-conversion(unit.reading, field-site) else no-fact
while fact != no-fact
    . row = facts.conversions[fact]
    if row.reason == .reason-argument && row.from == from && row.to == to
        = fact
    fact = row.next
= no-fact

────────────────────
_ do skip-truths

` Moves on to the next call recorded for a field: the calls that test the node's own value
` as a condition are not for fields.
while field-call != no-fact
    if answers-node(facts.calls[field-call].form)
        =
    field-call = facts.calls[field-call].next

────────────────────
_ do compare-parts
    - id SyntaxId
    - left Operand
    - left-type TypeId
    - right Operand
    - right-type TypeId
    - differ IRBlockId

` Compares two values part by part, and leaves to `differ` at the first part that is not
` equal: two unions of one type by the case they hold, and two tuples or structs by their
` fields.
if left-type == right-type && intrinsic(left-type) == .union
    compare-cases(id, left, left-type, right, differ)
else
    compare-fields(id, left, left-type, right, right-type, differ)

────────────────────
_ do compare-cases
    - id SyntaxId
    - left Operand
    - type TypeId
    - right Operand
    - differ IRBlockId

` Compares two unions of one type, and leaves to `differ` where they hold different cases or
` what the case they hold is not equal. A case that holds a value of its own is a pair,
` compared as a field of a tuple is; one that holds none is equal to itself.
. layout = layout-of(type, id)
if !tables.layouts.is-union(layout)
    refuse(.refused-expression, id)
    =
. same = ir.reserve-block()
. tag = load(left, 0, u8-layout, id)
branch(compare(id, .compare-equal, tag, load(right, 0, u8-layout, id)), same, differ)
ir.start-block(same)
. done = ir.reserve-block()
. index U32
for fact in types.cases-of(type)
    if index >= tables.layouts.rows[layout].cases.count
        refuse(.refused-expression, id)
        =
    if !fact.is-default && fact.type != no-type
        . field = tables.layouts.case-field(layout, index)
        . taken = ir.reserve-block()
        . next = ir.reserve-block()
        branch(case-test(id, left, index), taken, next)
        ir.start-block(taken)
        compare-pair(id, take(left, field, id), field, take(right, field, id), field, differ)
        jump(done)
        ir.start-block(next)
    index += 1
jump(done)
ir.start-block(done)

────────────────────
_ do compare-fields
    - id SyntaxId
    - left Operand
    - left-type TypeId
    - right Operand
    - right-type TypeId
    - differ IRBlockId

` Compares the fields of two tuples or structs in turn, and leaves to `differ` at the first
` pair that is not equal.
. mine = layout-of(left-type, id)
. theirs = layout-of(right-type, id)
if !tables.layouts.is-struct(mine) || !tables.layouts.is-struct(theirs)
    refuse(.refused-expression, id)
    =
. count = tables.layouts.rows[mine].fields.count
if tables.layouts.rows[theirs].fields.count != count
    refuse(.refused-expression, id)
    =
for position in 0 .. < count
    . held = tables.layouts.field(mine, position)
    . given = tables.layouts.field(theirs, position)
    compare-pair(id, take(left, held, id), held, take(right, given, id), given, differ)

────────────────────
_ do compare-pair ?! Refused
    - id SyntaxId
    - a Operand
    - held LayoutField
    - b Operand
    - given LayoutField
    - differ IRBlockId

` Compares one pair of parts, and leaves to `differ` where they are not equal. A pair is
` answered by the next call the type pass recorded when that call takes the pair, the second
` part converted first where the type pass recorded converting it for the call. One that no
` call takes is compared by the machine where it is of one type the machine compares, is, of
` one class or of atoms, equal when it is one object or one atom, of one function type, equal
` when the data they hold is one, is of interfaces compared as `compare-interfaces` does, is
` two optionals of one type compared as `compare-optionals` does, and is otherwise two values
` compared part by part the same way.
. equal = make-operand(.operand-void, 0)
. takes = false
if field-call != no-fact
    . callee = facts.calls[field-call].callee
    . self = instances.rows[callee].self-type
    takes = self == held.type && takes-argument(callee, given.type)
if takes
    . callee = facts.calls[field-call].callee
    . taken = instances.argument-type(callee, 0)
    . given-value = b
    if taken != given.type
        given-value = convert-one(id, facts.conversions[argument-conversion(given.type, taken)], Typed(b, given.type)).operand
    . mark = pending.length
    pending += a
    pending += given-value
    . called = call-method(callee, id, mark)
    equal = called.operand
    if called.type != types.bool-type
        refuse(.refused-conversion, id)
    field-call = facts.calls[field-call].next
    skip-truths()
else if held.type == given.type && compares-by-machine(types, held.type)
    if held.layout == void-layout
        =
    equal = compare(id, .compare-equal, a, b)
else if held.type == given.type && (tables.is-class(held.type) || intrinsic(held.type) == .atom)
    equal = compare(id, .compare-equal, a, b)
else if held.type == given.type && held.layout == tables.layouts.function-layout
    . data = tables.layouts.field(tables.layouts.function-layout, 1).offset
    equal = compare
        - id
        - .compare-equal
        - load(a, data, managed-layout, id)
        - load(b, data, managed-layout, id)
else if intrinsic(held.type) == .interface && intrinsic(given.type) == .interface
    equal = compare-interfaces(id, a, b).operand
else if held.type == given.type && types.is-optional(held.type)
    compare-optionals(id, a, b, held.type, differ)
    =
else
    compare-parts(id, a, held.type, b, given.type, differ)
    =
. next = ir.reserve-block()
branch(equal, next, differ)
ir.start-block(next)

────────────────────
_ do compare-optionals ?! Refused
    - id SyntaxId
    - a Operand
    - b Operand
    - type TypeId
    - differ IRBlockId

` Compares two optionals of one type, as the reference does, and leaves to `differ` where one
` holds a value and the other none, or both hold values that are not equal, compared as a pair
` of parts is with the right one first, as the reference compares what two optionals hold.
. holds = present(id, Typed(a, type))
. other = present(id, Typed(b, type))
. same = ir.reserve-block()
branch(compare(id, .compare-equal, holds.operand, other.operand), same, differ)
ir.start-block(same)
. filled = ir.reserve-block()
. done = ir.reserve-block()
branch(holds.operand, filled, done)
ir.start-block(filled)
. left = payload(id, Typed(a, type))
. inner = left.type
. right = payload(id, Typed(b, type))
. layout = layout-of(inner, id)
. field = LayoutField(0, layout, inner)
compare-pair(id, right.operand, field, left.operand, field, differ)
jump(done)
ir.start-block(done)

────────────────────
_ do item-address Typed
    - id SyntaxId
    - object SyntaxId
    - index SyntaxId

` Where the item an index names lies: the pointer moved on by the index times the bytes an
` item is held in. The pointer is evaluated before the index, and an index narrower than the
` pointer is widened as its own type says. It has the type of the pointer.
. nothing = make-operand(.operand-void, 0)
. base = emit-expression(object)
. type = base.type
. layout = layout-of(type, id)
. count = emit-expression(index)
. counted = layout-of(count.type, index)
. held = layout-of(tables.layouts.pointee-type(type), id)
if !is-pointer(layout) || !is-integer(counted) || held == void-layout
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. step = integer(.machine-u64, tables.layouts.rows[held].size)
. widest = if is-signed(counted) then i64-layout else u64-layout
. wide = num-cast(id, num-cast(id, count.operand, counted, widest), widest, u64-layout)
. distance = arithmetic(id, .arithmetic-multiply, wide, step, u64-layout)
. moved = arithmetic
    - id
    - .arithmetic-add
    - num-cast(id, base.operand, layout, u64-layout)
    - distance
    - u64-layout
= Typed(num-cast(id, moved, u64-layout, layout), type)

────────────────────
_ do emit-item Typed
    - id SyntaxId
    - object SyntaxId
    - index SyntaxId

` The item an index names past a pointer, read where it lies with no check. A struct is
` copied as it is read, so nothing stored there afterwards changes the value, unless a name is
` read from it at once (`read-in-place`).
. nothing = make-operand(.operand-void, 0)
. place = item-address(id, object, index)
. type = tables.layouts.pointee-type(place.type)
if !gives(id, type)
    refuse(.refused-conversion, id)
    = Typed(nothing, no-type)
. layout = layout-of(type, id)
if layout == void-layout
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
if tables.layouts.is-struct(layout) && matching.read-in-place != id
    = Typed(snapshot(address(place.operand, 0, layout, id), layout, id), type)
if tables.layouts.is-struct(layout)
    = Typed(address(place.operand, 0, layout, id), type)
= Typed(load(place.operand, 0, layout, id), type)

────────────────────
_ do emit-item-assign Assignment
    - id SyntaxId
    - op Operator
    - lhs SyntaxId
    - object SyntaxId
    - index SyntaxId
    - rhs SyntaxId

` Stores a value at the item an index names past a pointer, with no check. The value is
` evaluated first, then the pointer and the index, as TypeScript does, and then it takes
` the conversion recorded for the store. A managed pointer is stored through the write
` barrier, and a struct by a copy. An assigning operator of the machine reads the item, then
` evaluates the value and combines the two, and the pointer and the index are evaluated again
` for the store, as TypeScript does; the assignment holds the operator's plan and conversion.
. given = Typed(make-operand(.operand-void, 0), no-type)
. increment = increment-base(op)
. site = lhs
if op == .eq-op
    . made = emit-expression(rhs)
    given = Typed(apart(made, rhs, !is-inert(object) || !is-inert(index)), made.type)
else if increment && facts.plan-of(unit.reading, id) == .plan-builtin
    . item = emit-item(lhs, object, index)
    given = combine-builtin(id, increment, lhs, item.operand, item.type, rhs, true)
    site = id
else
    refuse(.refused-statement, id)
    = Assignment()
. place = item-address(lhs, object, index)
. item-type = tables.layouts.pointee-type(place.type)
. converted = convert(site, .reason-assignment, given)
. value = converted.operand
if converted.type != item-type
    refuse(.refused-conversion, id)
    = Assignment()
. layout = layout-of(item-type, id)
. assignment = Assignment(converted, given)
if tables.layouts.is-struct(layout)
    store-struct(place.operand, LayoutField(0, layout), value, id)
else if layout != void-layout
    store(place.operand, 0, value, is-managed-pointer(layout), id)
= assignment

────────────────────
_ view-shape U32
    - type TypeId

` What a type is among the views of an array: 1 a range of its rows, 2 the items of one field,
` 3 its fields, 4 one row, and 0 any other.
|? type == no-type || type == invalid-type
    0
|? same-ref(ref, types.array-rows-decl) || same-ref(ref, types.array-row-range-decl)
    1
|? same-ref(ref, types.array-field-decl)
    2
|? same-ref(ref, types.array-fields-decl)
    3
|? same-ref(ref, types.array-row-decl)
    4
??
    0

.. ref = class-ref(types, type)

────────────────────
_ viewed-item TypeId
    - type TypeId

` The item a view or an array holds.
match types.rows[type]
    | .type-class(row)
        if row.args.count != 0 then types.child-type(row.args, 0) else no-type
    ??
        no-type

────────────────────
_ same-ref Bool
    - left DeclRef
    - right DeclRef

left.module == right.module && left.decl == right.decl

────────────────────
_ view-slot U32
    - id SyntaxId

` The place in the item's layout of the field the type pass planned a view to read at a node.
if constant != no-fact then facts.constants[constant].bits as U32 else U32.max

.. constant = facts.constant-of(unit.reading, id)

────────────────────
_ do item-field LayoutField
    - id SyntaxId
    - view TypeId
    - slot U32

` The field of a view's item at a place in its layout.
. layout = layout-of(viewed-item(view), id)
if !tables.layouts.is-struct(layout) || past-fields
    refuse(.refused-expression, id)
    = LayoutField(0, void-layout)
.. past-fields = slot >= tables.layouts.rows[layout].fields.count
= tables.layouts.field(layout, slot)

────────────────────
_ do emit-view-get Typed
    - id SyntaxId
    - object SyntaxId

` A name the compiler answers for a view: the rows or the fields of an array, a view of its
` storage, the items of one field of a view of fields, or a field read through a row.
. nothing = make-operand(.operand-void, 0)
if facts.plan-of(unit.reading, object) == .plan-proven-row
    . found = proven-read(innermost-loop(), view-slot(id))
    if found != U32.max
        = Typed(proven-reads[found].value, proven-reads[found].type)
    . cell = proven-row-cell(id, object)
    . viewed = cell.type
    . field = item-field(id, viewed, view-slot(id))
    . read = take(cell.operand, field, id)
    proven-reads += ProvenRead(innermost-loop(), view-slot(id), ir.current, read, field.type)
    = Typed(read, field.type)
. base = emit-expression(object)
. held = base.type
. shape = view-shape(held)
if shape == 0
    = make-view(id, base.operand, held, facts.node-type(unit.reading, id))
if shape == 3
    = project-view(id, base.operand, held, view-slot(id), facts.node-type(unit.reading, id))
if shape == 4
    = row-field(id, base.operand, held, view-slot(id))
refuse(.refused-expression, id)
= Typed(nothing, no-type)

────────────────────
_ do emit-view-index Typed
    - id SyntaxId
    - object SyntaxId
    - index SyntaxId

` An index the compiler answers for a view: a constant one names a field of a row or of the
` fields, a range a view of the rows or the items it spans, and any other the row or the item
` at that index. The view is evaluated before the key.
. nothing = make-operand(.operand-void, 0)
. emitted = emit-expression(object)
. base = apart(emitted, object, !is-inert(index))
. held = emitted.type
. shape = view-shape(held)
. type = facts.node-type(unit.reading, id)
if shape == 3
    = project-view(id, base, held, view-slot(id), type)
if shape == 4
    = row-field(id, base, held, view-slot(id))
if shape != 1 && shape != 2
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. layout = layout-of(held, id)
if view-shape(type) == shape && call-at(id, .call-view-range) != no-fact
    . range = emit-expression(index)
    . range-type = range.type
    = slice-view(id, base, held, range.operand, range-type, object, type)
. key = convert(index, .reason-argument, emit-expression(index))
if key.type != types.index-type
    refuse(.refused-conversion, index)
    = Typed(nothing, no-type)
. cell = make-operand(.operand-void, 0)
if facts.plan-of(unit.reading, id) == .plan-proven-row
    cell = proven-cell(id, base, layout, key.operand, held)
else
    cell = view-cell(id, base, layout, key.operand)
if shape == 2
    . item = viewed-item(held)
    . item-layout = layout-of(item, id)
    = Typed(take(cell, LayoutField(0, item-layout), id), item)
= view-value
    - id
    - type
    - cell
    - part(base, layout, 1, id).operand
    - integer(.machine-u64, 1)
    - part(base, layout, 3, id).operand

────────────────────
_ do make-view Typed
    - id SyntaxId
    - array Operand
    - held TypeId
    - type TypeId

` The rows or the fields of an array: its storage as bytes, the bytes of an item, its size,
` and the owner the runtime makes for the storage, which the runtime marks stale when the
` storage goes away or is replaced. The runtime's function is called as TypeScript calls it,
` with no poll around it and no panic read after it.
. nothing = make-operand(.operand-void, 0)
. layout = layout-of(held, id)
. item-layout = layout-of(viewed-item(type), id)
. data = part(array, layout, 0, id)
. data-layout = layout-of(data.type, id)
. size = part(array, layout, 1, id)
. size-layout = layout-of(size.type, id)
if !is-pointer(data-layout) || !is-integer(size-layout)
    refuse(.refused-type, id)
    = Typed(nothing, no-type)
. stride = integer(.machine-u64, tables.layouts.rows[item-layout].size)
. bytes = num-cast(id, data.operand, data-layout, pointer-layout)
. count = num-cast(id, size.operand, size-layout, u64-layout)
. mark = pending.length
pending += bytes
pending += arithmetic(id, .arithmetic-multiply, count, stride, u64-layout)
. owner = call-runtime(.runtime-array-view-create, id, mark, pointer-layout)
= view-value(id, type, bytes, stride, count, owner)

────────────────────
_ do view-value Typed
    - id SyntaxId
    - type TypeId
    - bytes Operand
    - stride Operand
    - size Operand
    - owner Operand

` A view made of its four words in memory of the frame.
. layout = layout-of(type, id)
if !tables.layouts.is-struct(layout) || tables.layouts.rows[layout].fields.count != 4
    refuse(.refused-type, id)
    = Typed(make-operand(.operand-void, 0), no-type)
. memory = frame(layout)
put(memory, tables.layouts.field(layout, 0), bytes, id)
put(memory, tables.layouts.field(layout, 1), stride, id)
put(memory, tables.layouts.field(layout, 2), size, id)
put(memory, tables.layouts.field(layout, 3), owner, id)
= Typed(memory, type)

────────────────────
_ do validate-view
    - id SyntaxId
    - view Operand
    - layout LayoutId

` A view whose owner the runtime marked stale raises a panic.
. mark = pending.length
pending += part(view, layout, 3, id).operand
. valid = call-runtime(.runtime-array-view-valid, id, mark, u8-layout)
fail-view(id, compare(id, .compare-equal, valid, integer(.machine-u8, 0)), "Stale array view")

────────────────────
_ do fail-view
    - id SyntaxId
    - failed Operand
    - text String

` Raises a panic of a view where a test holds.
. raising = ir.reserve-block()
. passed = ir.reserve-block()
branch(failed, raising, passed)
ir.start-block(raising)
raise-text(id, text)
ir.start-block(passed)

────────────────────
_ do view-cell Operand
    - id SyntaxId
    - view Operand
    - layout LayoutId
    - index Operand

` Where the item at an index of a view lies, once the view is known not to be stale and the
` index to lie within it.
validate-view(id, view, layout)
. size = part(view, layout, 2, id)
fail-view(id, compare(id, .compare-greater-equal, index, size.operand), "Array view index out of bounds")
. moved = moved-bytes
    - id
    - part(view, layout, 0, id).operand
    - arithmetic(id, .arithmetic-multiply, index, part(view, layout, 1, id).operand, u64-layout)
= moved

────────────────────
_ do proven-cell Operand
    - id SyntaxId
    - view Operand
    - layout LayoutId
    - index Operand
    - held TypeId

. item-layout = layout-of(viewed-item(held), id)
. stride = integer(.machine-u64, tables.layouts.rows[item-layout].size)
. moved = moved-bytes
    - id
    - part(view, layout, 0, id).operand
    - arithmetic(id, .arithmetic-multiply, index, stride, u64-layout)
= moved

────────────────────
_ do proven-row-cell Typed
    - id SyntaxId
    - object SyntaxId

. nothing = make-operand(.operand-void, 0)
do match? tree.nodes[object]
    | .node-index-expression(row)
        . view = emit-expression(row.object)
        . held = view.type
        . layout = layout-of(held, id)
        . key = convert(row.index, .reason-argument, emit-expression(row.index))
        if key.type != types.index-type
            refuse(.refused-conversion, row.index)
            = Typed(nothing, no-type)
        . cell = proven-cell(id, view.operand, layout, key.operand, held)
        = Typed(cell, held)
refuse(.refused-expression, id)
= Typed(nothing, no-type)

────────────────────
_ do row-cell Operand
    - id SyntaxId
    - row Operand
    - held TypeId
    - object SyntaxId

if facts.plan-of(unit.reading, object) == .plan-proven-row
    = part(row, layout-of(held, id), 0, id).operand
= view-cell(id, row, layout-of(held, id), integer(.machine-u64, 0))

────────────────────
_ do moved-bytes Operand
    - id SyntaxId
    - bytes Operand
    - distance Operand

` An address moved on by a count of bytes.
. moved = arithmetic
    - id
    - .arithmetic-add
    - num-cast(id, bytes, pointer-layout, u64-layout)
    - distance
    - u64-layout
= num-cast(id, moved, u64-layout, pointer-layout)

────────────────────
_ do row-field Typed
    - id SyntaxId
    - row Operand
    - held TypeId
    - slot U32

` A field read through a row, where the row's one item lies.
. layout = layout-of(held, id)
. field = item-field(id, held, slot)
. cell = view-cell(id, row, layout, integer(.machine-u64, 0))
= Typed(take(cell, field, id), field.type)

────────────────────
_ do row-item Typed
    - id SyntaxId
    - row Operand
    - held TypeId

` The item a row views, read as the item.
. layout = layout-of(held, id)
. item = viewed-item(held)
. item-layout = layout-of(item, id)
. cell = view-cell(id, row, layout, integer(.machine-u64, 0))
= Typed(take(cell, LayoutField(0, item-layout), id), item)

────────────────────
_ do project-view Typed
    - id SyntaxId
    - fields Operand
    - held TypeId
    - slot U32
    - type TypeId

` The items of one field of a view of fields: the view's bytes moved on to the field.
. layout = layout-of(held, id)
. field = item-field(id, held, slot)
validate-view(id, fields, layout)
. bytes = moved-bytes(id, part(fields, layout, 0, id).operand, integer(.machine-u64, field.offset))
= view-value
    - id
    - type
    - bytes
    - part(fields, layout, 1, id).operand
    - part(fields, layout, 2, id).operand
    - part(fields, layout, 3, id).operand

────────────────────
_ do slice-view Typed
    - id SyntaxId
    - view Operand
    - held TypeId
    - range Operand
    - range-type TypeId
    - object SyntaxId
    - type TypeId

` The rows or the items a range spans of a view: its bytes moved on to the range's start, and
` its size the range's. The range is made forward first, and must lie within the view and
` step by one.
. nothing = make-operand(.operand-void, 0)
. layout = layout-of(held, id)
validate-view(id, view, layout)
. forward = forward-range(id, range, range-type, view, held, object)
. forward-type = forward.type
. forward-layout = layout-of(forward-type, id)
. start = range-index(id, forward.operand, forward-type, forward-layout, "start")
. end = range-index(id, forward.operand, forward-type, forward-layout, "end")
. length = arithmetic(id, .arithmetic-subtract, end.operand, start.operand, u64-layout)
. size = part(view, layout, 2, id)
fail-view(id, compare(id, .compare-greater, start.operand, size.operand), "Array view range out of bounds")
. left = arithmetic(id, .arithmetic-subtract, size.operand, start.operand, u64-layout)
fail-view(id, compare(id, .compare-greater, length, left), "Array view range out of bounds")
. step = range-part(id, forward.operand, forward-type, forward-layout, "increment")
. step-layout = layout-of(step.type, id)
if !is-integer(step-layout)
    refuse(.refused-type, id)
    = Typed(nothing, no-type)
. one = integer(tables.layouts.kind-of(step-layout), 1)
fail-view
    - id
    - compare(id, .compare-not-equal, step.operand, one)
    - "Array views require a unit range increment"
. stride = part(view, layout, 1, id)
. bytes = moved-bytes
    - id
    - part(view, layout, 0, id).operand
    - arithmetic(id, .arithmetic-multiply, start.operand, stride.operand, u64-layout)
= view-value(id, type, bytes, stride.operand, length, part(view, layout, 3, id).operand)

────────────────────
_ do forward-range Typed
    - id SyntaxId
    - range Operand
    - range-type TypeId
    - view Operand
    - held TypeId
    - object SyntaxId

` A range made forward by the calls the type pass recorded at an index of a view: a range of
` positions is first made one of indexes by its `normalize`, given the view.
. nothing = make-operand(.operand-void, 0)
. fact = call-at(id, .call-view-range)
. current = Typed(range, range-type)
while fact != no-fact
    . row = facts.calls[fact]
    if row.form == .call-view-range
        . callee = row.callee
        if callee == no-instance || !is-callable(callee)
            refuse(.refused-expression, id)
            = Typed(nothing, no-type)
        . mark = pending.length
        pending += current.operand
        if instances.signatures[callee].args.count == 1
            . given = convert(object, .reason-argument, Typed(view, held))
            if given.type != instances.argument-type(callee, 0)
                refuse(.refused-conversion, object)
            pending += given.operand
        else if instances.signatures[callee].args.count != 0
            refuse(.refused-expression, id)
        current = call-method(callee, id, mark)
    fact = row.next
= current

────────────────────
_ do range-part Typed
    - id SyntaxId
    - range Operand
    - type TypeId
    - layout LayoutId
    - name String

` A field of a range, by its name.
. found = range-slot(type, name)
if found == U32.max
    refuse(.refused-expression, id)
    = Typed(make-operand(.operand-void, 0), no-type)
= part(range, layout, found, id)

────────────────────
_ do range-slot U32
    - type TypeId
    - name String

. properties = types.completions[type].properties
for offset in 0 .. < properties.count
    . property = types.properties[properties.start + offset]
    if property.name.text == name
        = property.slot
= U32.max

────────────────────
_ do range-index Typed
    - id SyntaxId
    - range Operand
    - type TypeId
    - layout LayoutId
    - name String

` A bound of a range, made an index.
. value = range-part(id, range, type, layout, name)
. held = layout-of(value.type, id)
if !is-integer(held)
    refuse(.refused-type, id)
    = value
= Typed(num-cast(id, value.operand, held, u64-layout), value.type)

────────────────────
_ do emit-view-field-assign Assignment
    - id SyntaxId
    - op Operator
    - lhs SyntaxId
    - object SyntaxId
    - rhs SyntaxId

` An assignment to a field through a row, stored where the row's one item lies. The value is
` evaluated before the row. An assigning operator reads the field through the row first, and
` the row is evaluated again for the store.
. written = Typed(make-operand(.operand-void, 0), no-type)
. increment = increment-base(op)
if op == .eq-op
    . made = emit-expression(rhs)
    written = Typed(apart(made, rhs, !is-inert(object)), made.type)
else if increment && facts.plan-of(unit.reading, id) == .plan-builtin
    written = emit-builtin(id, increment, lhs, rhs, true)
else
    refuse(.refused-statement, id)
. converted = convert(id, .reason-assignment, written)
. value = converted.operand
. given = converted.type
. row = emit-expression(object)
. held = row.type
if view-shape(held) != 4
    refuse(.refused-statement, id)
    = Assignment()
. field = item-field(id, held, view-slot(lhs))
if given != field.type
    refuse(.refused-conversion, id)
    = Assignment()
. assignment = Assignment(converted, written)
. cell = row-cell(id, row.operand, held, object)
store-viewed(cell, field, value, id)
if facts.plan-of(unit.reading, object) == .plan-proven-row
    forget-read(innermost-loop(), view-slot(lhs))
= assignment

────────────────────
_ do emit-view-index-assign Assignment
    - id SyntaxId
    - op Operator
    - lhs SyntaxId
    - object SyntaxId
    - index SyntaxId
    - rhs SyntaxId

` An assignment to an index the compiler answers for a view: a constant one stores a field of
` a row, a range copies a view of the same kind into the rows or the items it spans, and any
` other stores the row or the item at that index. The value is evaluated first, then the
` view, then the key.
if op != .eq-op
    refuse(.refused-statement, id)
    = Assignment()
. made = emit-expression(rhs)
. value = apart(made, rhs, !is-inert(object) || !is-inert(index))
. given = made.type
if call-at(lhs, .call-view-range) != no-fact
    copy-view-range(lhs, value, given, object, index)
    = Assignment()
. emitted = emit-expression(object)
. base = apart(emitted, object, !is-inert(index))
. held = emitted.type
. shape = view-shape(held)
. layout = layout-of(held, id)
. field = LayoutField(0, void-layout)
. key = integer(.machine-u64, 0)
if shape == 4
    field = item-field(lhs, held, view-slot(lhs))
else if shape == 1 || shape == 2
    . converted = convert(index, .reason-argument, emit-expression(index))
    key = converted.operand
    if converted.type != types.index-type
        refuse(.refused-conversion, index)
    . item = viewed-item(held)
    field = LayoutField(0, layout-of(item, id), item)
else
    refuse(.refused-statement, id)
. converted = convert(lhs, .reason-assignment, Typed(value, given))
if converted.type != field.type
    refuse(.refused-conversion, lhs)
store-viewed(view-cell(lhs, base, layout, key), field, converted.operand, lhs)
= Assignment(converted, Typed(value, given))

────────────────────
_ is-array-type Bool
    - type TypeId

` Whether a type is an array, whose storage views can see.
|? type == no-type || type == invalid-type || intrinsic(type) != .tuple
    false
??
    types.ancestor-of(type, types.array-decl) != no-type || types.ancestor-of(type, types.immutable-array-decl) != no-type

────────────────────
_ do replace-storage
    - id SyntaxId
    - old Operand
    - old-type TypeId
    - next Operand
    - next-type TypeId

` Tells the runtime that the storage of an array is replaced by another's, before the other
` is stored: the views of the old storage are marked stale where it is not the new storage, or
` where the new one is smaller. The runtime's function is called as TypeScript calls it, with
` no poll around it and no panic read after it.
. old-layout = layout-of(old-type, id)
. next-layout = layout-of(next-type, id)
. item-layout = layout-of(viewed-item(next-type), id)
. stride = integer(.machine-u64, tables.layouts.rows[item-layout].size)
. mark = pending.length
for side in 0 .. < 2
    . array = if side == 0 then old else next
    . layout = if side == 0 then old-layout else next-layout
    . data = part(array, layout, 0, id)
    . data-layout = layout-of(data.type, id)
    . size = part(array, layout, 1, id)
    . size-layout = layout-of(size.type, id)
    pending += num-cast(id, data.operand, data-layout, pointer-layout)
    pending += arithmetic
        - id
        - .arithmetic-multiply
        - num-cast(id, size.operand, size-layout, u64-layout)
        - stride
        - u64-layout
call-runtime(.runtime-array-views-replace, id, mark, void-layout)

────────────────────
_ do store-viewed
    - cell Operand
    - field LayoutField
    - value Operand
    - syntax SyntaxId

` Stores a value where a view's item lies: a struct by a copy, and a managed pointer through
` the write barrier.
if tables.layouts.is-struct(field.layout)
    store-struct(cell, field, value, syntax)
else if field.layout != void-layout
    store(cell, field.offset, value, is-managed-pointer(field.layout), syntax)

────────────────────
_ do copy-view-range
    - id SyntaxId
    - source Operand
    - source-type TypeId
    - object SyntaxId
    - index SyntaxId

` A view of the same kind copied into the rows or the items a range spans of a view: both
` views must not be stale, and the range the same size as the source. The source is copied to
` a buffer of its own first, so that the two may overlap, which the runtime allocates as
` TypeScript has it allocate one, with no poll around it.
. emitted = emit-expression(object)
. target = apart(emitted, object, !is-inert(index))
. held = emitted.type
. range = emit-expression(index)
. range-type = range.type
. layout = layout-of(held, id)
. source-layout = layout-of(source-type, id)
. item-layout = layout-of(viewed-item(held), id)
if tables.layouts.rows[item-layout].is-managed
    refuse(.refused-statement, id)
    =
validate-view(id, target, layout)
validate-view(id, source, source-layout)
. spanned = slice-view(id, target, held, range.operand, range-type, object, held)
. length = part(spanned.operand, layout, 2, id)
fail-view
    - id
    - compare(id, .compare-not-equal, length.operand, part(source, source-layout, 2, id).operand)
    - "Array view range sizes differ"
. stride = integer(.machine-u64, tables.layouts.rows[item-layout].size)
. mark = pending.length
pending += stride
pending += length.operand
. snapshot = call-runtime(.runtime-allocate-plain-buffer, id, mark, pointer-layout)
copy-items
    - id
    - item-layout
    - snapshot
    - stride
    - part(source, source-layout, 0, id).operand
    - part(source, source-layout, 1, id).operand
    - length.operand
copy-items
    - id
    - item-layout
    - part(spanned.operand, layout, 0, id).operand
    - part(spanned.operand, layout, 1, id).operand
    - snapshot
    - stride
    - length.operand

────────────────────
_ do copy-items
    - id SyntaxId
    - layout LayoutId
    - target Operand
    - target-stride Operand
    - source Operand
    - source-stride Operand
    - length Operand

` Copies items one by one from where one view's lie to where another's lie.
. counter = ir.add-local(u64-layout)
store-local(counter, integer(.machine-u64, 0), id)
. checking = ir.reserve-block()
. copying = ir.reserve-block()
. copied = ir.reserve-block()
jump(checking)
ir.start-block(checking)
branch(compare(id, .compare-less, load-local(counter, id), length), copying, copied)
ir.start-block(copying)
. place = load-local(counter, id)
. reading-cell = moved-bytes
    - id
    - source
    - arithmetic(id, .arithmetic-multiply, place, source-stride, u64-layout)
. writing-cell = moved-bytes
    - id
    - target
    - arithmetic(id, .arithmetic-multiply, place, target-stride, u64-layout)
if tables.layouts.is-struct(layout)
    copy(writing-cell, reading-cell, layout, false, id)
else
    store(writing-cell, 0, load(reading-cell, 0, layout, id), false, id)
store-local
    - counter
    - arithmetic(id, .arithmetic-add, place, integer(.machine-u64, 1), u64-layout)
    - id
jump(checking)
ir.start-block(copied)

────────────────────
_ do emit-pointer-add Typed
    - id SyntaxId
    - lhs SyntaxId
    - rhs SyntaxId

` A pointer moved on by a count of the items it points at. The answer has the pointer's type.
` A count narrower than the pointer is widened by its own sign.
. nothing = make-operand(.operand-void, 0)
. base = emit-expression(lhs)
. type = base.type
. layout = layout-of(type, id)
. count = emit-expression(rhs)
. counted = layout-of(count.type, rhs)
if !is-pointer(layout) || !is-integer(counted) || type != facts.node-type(unit.reading, id)
    refuse(.refused-conversion, id)
    = Typed(nothing, no-type)
. step = integer(.machine-u64, tables.layouts.pointee-size(type))
. widest = if is-signed(counted) then i64-layout else u64-layout
. wide = num-cast(id, num-cast(id, count.operand, counted, widest), widest, u64-layout)
. distance = arithmetic(id, .arithmetic-multiply, wide, step, u64-layout)
. moved = arithmetic
    - id
    - .arithmetic-add
    - num-cast(id, base.operand, layout, u64-layout)
    - distance
    - u64-layout
= Typed(num-cast(id, moved, u64-layout, layout), type)

────────────────────
_ do emit-unary Typed
    - id SyntaxId
    - op Operator
    - operand SyntaxId

` A prefix operator, in the way the type pass planned it: the function it recorded, or the
` machine operation on a number. `!` of an optional is true when it holds no value.
` `type-of` gives the type of its operand as a value: of an object the class it was
` constructed as, read from its table, of a value of an interface the type of what it
` holds, read from its witness table, and of anything else the type it is held as.
. nothing = make-operand(.operand-void, 0)
. plan = facts.plan-of(unit.reading, id)
if op == .type-of-op
    . subject = emit-expression(operand)
    . held = subject.type
    if held == no-type || held == invalid-type || !tables.is-class(held)
        if held != no-type && held != invalid-type && intrinsic(held) == .interface
            . second = tables.layouts.field(tables.layouts.interface-layout, 1).offset
            . witness = load(subject.operand, second, pointer-layout, id)
            = Typed(load(witness, 0, pointer-layout, id), facts.node-type(unit.reading, id))
        = type-value(id, facts.node-type(unit.reading, id))
    . table = load(subject.operand, 0, pointer-layout, id)
    = Typed(load(table, table-slot-size, pointer-layout, id), facts.node-type(unit.reading, id))
if op == .optional-force-op
    = emit-force(id, operand)
if op == .delete-op
    = emit-delete(id, operand)
if plan == .plan-call
    = emit-operator-call(id, operand, 0)
if plan != .plan-builtin
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
if op == .not-op
    . tested = emit-expression(operand)
    if tested.type != no-type && tested.type != invalid-type && types.is-optional(tested.type)
        tested = present(operand, tested)
    = compare-zero(operand, tested, .compare-equal)
if op != .negative-op && op != .bitwise-not-op
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. type = facts.node-type(unit.reading, id)
. given = convert(operand, .reason-operand, emit-expression(operand))
. layout = layout-of(type, id)
. fits = if op == .bitwise-not-op then is-integer(layout) else is-number(layout)
if given.type != type || !fits
    refuse(.refused-conversion, operand)
    = Typed(nothing, no-type)
. start U32 = ir.operands.length
ir.add-operand(given.operand)
. row = if op == .bitwise-not-op then IROp.op-bitwise-not else IROp.op-negate
= Typed(make-operand(.operand-value, append(row, id, Span(start, 1), 0, layout)), given.type)

────────────────────
_ do emit-builtin Typed
    - id SyntaxId
    - op Operator
    - lhs SyntaxId
    - rhs SyntaxId
    - assigns Bool = false

` The machine operation on two numbers. Each operand takes the conversions recorded at it,
` the right one also the conversion by a unit's ratio that the operator records as its own,
` and both arrive in one type. A conversion recorded for the result then gives it the node's
` type, but for an assigning operator, whose result the assignment converts as it stores it.
. left = emit-expression(lhs)
= combine-builtin(id, op, lhs, left.operand, left.type, rhs, assigns)

────────────────────
_ do combine-builtin Typed
    - id SyntaxId
    - op Operator
    - lhs SyntaxId
    - given Operand
    - given-type TypeId
    - rhs SyntaxId
    - assigns Bool

` The machine operation on two numbers, the left already evaluated as `lhs` gives it.
. nothing = make-operand(.operand-void, 0)
. left = convert(lhs, .reason-operand, Typed(given, given-type))
left = convert(lhs, .reason-promotion, left)
. machine = left.type
. right = convert(rhs, .reason-operand, emit-expression(rhs))
right = convert(id, .reason-operator, right)
right = convert(rhs, .reason-promotion, right)
if right.type != machine
    refuse(.refused-conversion, id)
    = Typed(nothing, no-type)
. layout = layout-of(machine, id)
. result = Typed(nothing, no-type)
if is-comparison(op)
    if !is-number(layout)
        refuse(.refused-type, id)
        = Typed(nothing, no-type)
    result = Typed(compare(id, predicate-of(op), left.operand, right.operand), types.bool-type)
else
    result = convert(id, .reason-result, Typed(operate(id, op, left.operand, right.operand, layout), right.type))
if !assigns && result.type != facts.node-type(unit.reading, id)
    refuse(.refused-conversion, id)
= result

────────────────────
_ do operate Operand
    - id SyntaxId
    - op Operator
    - left Operand
    - right Operand
    - layout LayoutId

` One row of arithmetic or of a bitwise operator on two numbers of a layout, with no check of
` any kind. The remainder of two floats is a call the collector never sees.
. nothing = make-operand(.operand-void, 0)
. bitwise = bitwise-of(op)
. arithmetic = arithmetic-of(op)
if bitwise != U32.max && is-integer(layout)
    . start U32 = ir.operands.length
    ir.add-operand(left)
    ir.add-operand(right)
    = make-operand(.operand-value, append(.op-bitwise, id, Span(start, 2), bitwise, layout))
if arithmetic == U32.max || !is-number(layout)
    refuse(.refused-type, id)
    = nothing
if op == .mod-op && is-float(layout)
    . remainder = RuntimeFunction.runtime-float-remainder
    if layout == f32-layout
        remainder = .runtime-float32-remainder
    . mark = pending.length
    pending += left
    pending += right
    = call-runtime(remainder, id, mark, layout)
. start U32 = ir.operands.length
ir.add-operand(left)
ir.add-operand(right)
= make-operand(.operand-value, append(.op-arithmetic, id, Span(start, 2), arithmetic, layout))

────────────────────
_ arithmetic-of U32
    - op Operator

match op
    |= .add-op
        ArithmeticOp.arithmetic-add
    |= .subtract-op
        ArithmeticOp.arithmetic-subtract
    |= .multiply-op
        ArithmeticOp.arithmetic-multiply
    |= .divide-op
        ArithmeticOp.arithmetic-divide
    |= .mod-op
        ArithmeticOp.arithmetic-remainder
    ??
        U32.max

────────────────────
_ bitwise-of U32
    - op Operator

match op
    |= .bitwise-and-op
        BitwiseOp.bitwise-and
    |= .bitwise-or-op
        BitwiseOp.bitwise-or
    |= .bitwise-xor-op
        BitwiseOp.bitwise-xor
    |= .bitwise-lshift-op
        BitwiseOp.bitwise-shift-left
    |= .bitwise-rshift-op
        BitwiseOp.bitwise-shift-right
    |= .bitwise-zrshift-op
        BitwiseOp.bitwise-shift-right-zero
    ??
        U32.max

────────────────────
_ is-comparison Bool
    - op Operator

|? op == .less-than-op || op == .greater-than-op
    true
|? op == .less-than-equals-op || op == .greater-than-equals-op
    true
??
    op == .equals-op || op == .not-equals-op

────────────────────
_ predicate-of ComparePredicate
    - op Operator

match op
    |= .not-equals-op
        .compare-not-equal
    |= .less-than-op
        .compare-less
    |= .less-than-equals-op
        .compare-less-equal
    |= .greater-than-op
        .compare-greater
    |= .greater-than-equals-op
        .compare-greater-equal
    ??
        .compare-equal

────────────────────
_ do emit-sign-checked Typed
    - id SyntaxId
    - op Operator
    - lhs SyntaxId
    - rhs SyntaxId
    - is-left Bool

` A comparison of a signed integer with an unsigned one at least as wide. The signed side is
` tested first. When it is negative the answer is known, and otherwise both are compared in
` the unsigned type the type pass converted them to.
. nothing = make-operand(.operand-void, 0)
. left-given = emit-expression(lhs)
. left-type = left-given.type
. left = convert(lhs, .reason-operand, left-given)
. common = left.type
. right-given = emit-expression(rhs)
. right-type = right-given.type
. right = convert(rhs, .reason-operand, right-given)
if right.type != common || !is-comparison(op)
    refuse(.refused-conversion, id)
    = Typed(nothing, no-type)
. signed-layout = layout-of(if is-left then left-type else right-type, id)
. layout = layout-of(common, id)
if !is-integer(signed-layout) || !is-integer(layout)
    refuse(.refused-type, id)
    = Typed(nothing, no-type)
. origin = integer(tables.layouts.kind-of(signed-layout), 0)
. negative = compare(id, .compare-less, (if is-left then left-given else right-given).operand, origin)
. compared = ir.reserve-block()
. joined = ir.reserve-block()
. tested = ir.current
branch(negative, joined, compared)
ir.start-block(compared)
. answer = compare(id, predicate-of(op), left.operand, right.operand)
. compared-end = ir.current
jump(joined)
ir.start-block(joined)
. known = integer(.machine-u8, known-answer(op, is-left))
= Typed(phi(u8-layout, known, tested, answer, compared-end), types.bool-type)

────────────────────
_ known-answer U64
    - op Operator
    - is-left Bool

` What a comparison answers when its signed side is negative, which the other side cannot be.
|? op == .not-equals-op
    1
|? op == .less-than-op || op == .less-than-equals-op
    if is-left then 1u64 else 0u64
|? op == .greater-than-op || op == .greater-than-equals-op
    if is-left then 0u64 else 1u64
??
    0

────────────────────
_ do emit-logic Typed
    - id SyntaxId
    - is-and Bool
    - lhs SyntaxId
    - rhs SyntaxId

` `&&` and `||` on two values tested as conditions. The right one is evaluated only when the
` left one does not decide the answer. A left one that holds the middle of a chain of
` orderings opens its slot to the right one. Where the type pass found that the left one
` always decides it, the left one is evaluated and the answer is the one it decides.
. nothing = make-operand(.operand-void, 0)
if facts.plan-of(unit.reading, id) == .plan-never
    emit-expression(lhs)
    = Typed(integer(.machine-u8, if is-and then 0u64 else 1u64), types.bool-type)
. left = test(id, emit-expression(lhs), true)
. held = held-by(lhs)
. further = ir.reserve-block()
. joined = ir.reserve-block()
. decided = ir.current
if is-and
    branch(left.operand, further, joined)
else
    branch(left.operand, joined, further)
ir.start-block(further)
. own-unit = unit
if held != no-place
    unit = unit.open-held = held
. right = test(id, emit-expression(rhs), true, true)
unit = own-unit
. further-end = ir.current
jump(joined)
ir.start-block(joined)
. short = integer(.machine-u8, if is-and then 0u64 else 1u64)
= Typed(phi(u8-layout, short, decided, right.operand, further-end), types.bool-type)

────────────────────
_ do branch-on ?! Refused
    - condition SyntaxId
    - when-true IRBlockId
    - when-false IRBlockId
    - site SyntaxId = 0
    - is-right Bool = false

` Goes on to one block where a condition tests as true and to the other where it does not. Each
` side of `&&` and `||` branches in turn, as `emit-logic` evaluates them, so the answer is not
` made as a value. The condition is tested as itself, or with `site` as that `&&` or `||`
` tests its left side, or with `is-right` its right one. The predicate an `if` tests is seen
` through where it holds `&&` or `||` and tests it as itself.
do match? tree.nodes[condition]
    | .node-type-predicate(row)
        . logic = is-logic(row.expr) || logic-lazy(row.expr, 0, false) != no-slot
        if site == 0 && !row.is-contextual && logic && passes-through(condition, row.expr)
            branch-on(row.expr, when-true, when-false)
            =
    | .node-identifier
        . slot = logic-lazy(condition, site, is-right)
        if slot != no-slot
            lazy-open += slot
            branch-on(lazy-value(slot), when-true, when-false)
            lazy-open.pop()
            =
    | .node-binary-expression(row)
        if (row.op == .and-op || row.op == .or-op) && branches-apart(condition, site, is-right)
            . further = ir.reserve-block()
            if row.op == .and-op
                branch-on(row.lhs, further, when-false, condition)
            else
                branch-on(row.lhs, when-true, further, condition)
            . held = held-by(row.lhs)
            ir.start-block(further)
            . own-unit = unit
            if held != no-place
                unit = unit.open-held = held
            branch-on(row.rhs, when-true, when-false, condition, true)
            unit = own-unit
            =
. tested = if site == 0 then test(condition, emit-expression(condition)) else test(site, emit-expression(condition), true, is-right)
branch(tested.operand, when-true, when-false)

────────────────────
_ do logic-lazy SlotId
    - name SyntaxId
    - site SyntaxId
    - is-right Bool

if name == 0 || unit.instance == no-instance || unit.reading != unit.instance || filling.storing
    = no-slot
. resolution = bindings.resolution-of(instances.rows[unit.instance].binding, name)
if resolution.kind != .resolve-slot
    = no-slot
. slot = resolution.slot
. policy = bindings.lazy-policy(slot)
. once = policy == .lazy-inline || (policy == .lazy-memo && bindings.lazy-reads-once(slot))
if bindings.slots[slot].kind != .slot-lazy || !once || !is-own-slot(slot) || is-captured(slot)
    = no-slot
if tables.holds-lazy(slot) || bindings.lazy-together(slot) || facts.lazy-unheld(unit.reading, slot)
    = no-slot
if read-wavers(slot, name)
    = no-slot
for open in lazy-open
    if open == slot
        = no-slot
. declared = lazy-value(slot)
if declared == 0 || !is-logic(declared)
    = no-slot
do match? tree.nodes[bindings.slots[slot].group]
    | .node-declare(row)
        . named = row.left
        . annotation SyntaxId = 0
        do match? tree.nodes[row.left]
            | .node-type-capture(capture)
                named = capture.id
                annotation = capture.type
        . plain = tree.nodes[named] is .node-identifier
        if plain && (annotation == 0 || facts.first-conversion(unit.reading, annotation) == no-fact)
            . kept = facts.slot-type(unit.instance, slot - unit.slot-start)
            if reads-plainly(name, declared, kept, site, is-right)
                = slot
= no-slot

────────────────────
_ do lazy-value SyntaxId
    - slot SlotId

do match? tree.nodes[bindings.slots[slot].group]
    | .node-declare(row)
        = row.right
= 0

────────────────────
_ do reads-plainly Bool
    - name SyntaxId
    - declared SyntaxId
    - kept TypeId
    - site SyntaxId
    - is-right Bool

if kept != types.bool-type || (pins.length != 0 && (pin-of(name) || pin-of(declared)))
    = false
if facts.first-conversion(unit.reading, name) != no-fact
    = false
if facts.first-conversion(unit.reading, declared) != no-fact
    = false
. truth = if site == 0 then truth-call(name, false, false) else truth-call(site, true, is-right)
if truth != no-fact || facts.answer-type(unit.reading, name) != kept
    = false
= facts.answer-type(unit.reading, declared) == kept

────────────────────
_ do is-logic Bool
    - id SyntaxId

` Whether an expression is `&&` or `||`.
do match? tree.nodes[id]
    | .node-binary-expression(row)
        = row.op == .and-op || row.op == .or-op
= false

────────────────────
_ passes-through Bool
    - predicate SyntaxId
    - expr SyntaxId

` Whether the predicate of an `if` is its expression as it is: the type pass recorded no test,
` conversion or other type for it.
|? !facts.node-slot(unit.reading, predicate) || !is-consumable(predicate) || truth-tested
    false
|? pins.length != 0 && pin-of(predicate)
    false
??
    facts.answer-type(unit.reading, predicate) == facts.answer-type(unit.reading, expr)

.. truth-tested = truth-call(predicate, false, false) != no-fact

────────────────────
_ branches-apart Bool
    - id SyntaxId
    - site SyntaxId
    - is-right Bool

` Whether an `&&` or `||` can branch on each side: the type pass left its answer to be found
` as it runs, nothing pinned it, and its answer is tested as the Bool it is.
|? facts.plan-of(unit.reading, id) == .plan-never || !facts.node-slot(unit.reading, id) || !is-consumable(id)
    false
|? pins.length != 0 && pin-of(id)
    false
??
    fact == no-fact

.. fact = if site == 0 then truth-call(id, false, false) else truth-call(site, true, is-right)

────────────────────
_ do emit-delete Typed
    - id SyntaxId
    - operand SyntaxId

` `-=` of an item: the function that answers `-=[]` is called on the object with the key, the
` object evaluated first and then the key, as TypeScript does, each with the conversion
` recorded for it. The value is what the function answers, or the object where it answers
` nothing. Where the type pass planned the answer to be stored, it is stored where the object
` was read from, which then only names storage.
. nothing = make-operand(.operand-void, 0)
. object SyntaxId = 0
. index SyntaxId = 0
do match? tree.nodes[operand]
    | .node-index-expression(row)
        if !chains-at(operand, row.is-optional)
            object = row.object
            index = row.index
. fact = if object != 0 then own-call(operand) else no-fact
if fact == no-fact
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. call = facts.calls[fact]
. callee = call.callee
if callee == no-instance || call.is-partial || !is-callable(callee)
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
if !fills-in-order(call, callee, 1) || names-slot(object, .slot-super)
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. owner = instances.rows[callee].self-type
. answers = instances.signatures[callee].returns
. stores-back = facts.plan-of(unit.reading, operand) == .plan-store-answer
. placed = answers == owner && is-place(object) && facts.node-type(unit.reading, object) == owner
if owner == no-type || (stores-back && !placed)
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. pin-mark = pins.length
if stores-back
    pin-holder(object)
. receiver = convert(object, .reason-receiver, emit-expression(object))
. receiver-type = receiver.type
. key = receiver
. key-type = no-type
key = convert(index, .reason-argument, emit-expression(index))
key-type = key.type
if receiver-type != owner
    refuse(.refused-conversion, object)
if key-type != instances.argument-type(callee, 0)
    refuse(.refused-conversion, index)
. answer = nothing
. mark = pending.length
pending += receiver.operand
pending += key.operand
answer = call-method(callee, operand, mark).operand
if stores-back && facts.is-replacing(unit.reading, operand)
    . old = emit-expression(object)
    replace-storage(operand, old.operand, old.type, answer, answers)
if stores-back
    store-place(object, answer, owner, operand)
unpin(pin-mark)
. result = if answers == types.void-type then receiver else Typed(answer, answers)
if result.type != facts.node-type(unit.reading, id)
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
= result

────────────────────
_ do emit-operator-call Typed
    - id SyntaxId
    - lhs SyntaxId
    - rhs SyntaxId
    - plan OperatorPlan = OperatorPlan.plan-call
    - assigns Bool = false

` An operator that functions answer: the calls the type pass recorded at the node, each made
` on the operand it chose as receiver with the other as its argument. A prefix operator has
` no other. The operands are evaluated once. One call answers by itself, or negated by its
` opposite. Two answer together, both always asked: that neither holds, or that the first
` does not or the second does. The answer has the node's type. A struct or a tuple on the left
` is a copy of what its place held before the right is evaluated, but where the operator
` `assigns` to that place: there the function is given the place itself.
. nothing = make-operand(.operand-void, 0)
. pair = plan == .plan-neither-call || plan == .plan-not-or-call
. fact = answering(facts.first-call(unit.reading, id))
. second = no-fact
if fact != no-fact
    second = answering(facts.calls[fact].next)
if fact == no-fact || (second != no-fact) != pair
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. given = emit-expression(lhs)
. left = apart(given, lhs, !assigns && rhs != 0 && !is-inert(rhs))
. left-type = given.type
. right = nothing
. right-type = no-type
if rhs != 0
    . emitted = emit-expression(rhs)
    right = emitted.operand
    right-type = emitted.type
. answer = call-operator(id, fact, lhs, left, left-type, rhs, right, right-type)
if plan != .plan-call && answer.type != types.bool-type
    refuse(.refused-expression, id)
if plan != .plan-call
    answer = compare-zero(id, answer, .compare-equal)
if pair
    . equal = call-operator(id, second, lhs, left, left-type, rhs, right, right-type)
    if equal.type != types.bool-type
        refuse(.refused-expression, id)
    if plan == .plan-neither-call
        . combined = bitwise
            - id
            - .bitwise-and
            - answer.operand
            - compare-zero(id, equal, .compare-equal).operand
            - u8-layout
        answer = Typed(combined, types.bool-type)
    else
        answer = Typed(bitwise(id, .bitwise-or, answer.operand, equal.operand, u8-layout), equal.type)
if answer.type != facts.node-type(unit.reading, id)
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
= answer

────────────────────
_ do answering FactId
    - fact FactId

` The first call from one on that answers for a node's value: the calls that test a value as
` a condition are passed over.
. found = fact
while found != no-fact
    if answers-node(facts.calls[found].form)
        = found
    found = facts.calls[found].next
= no-fact

────────────────────
_ do call-operator Typed
    - id SyntaxId
    - fact FactId
    - lhs SyntaxId
    - left Operand
    - left-type TypeId
    - rhs SyntaxId
    - right Operand
    - right-type TypeId

` One call recorded for an operator, on operands already evaluated: the receiver is the left
` one, or the right one when the type pass exchanged them, and the other is the argument, in
` the type the function takes by the conversions recorded at it. An object of a class below
` the one that declares the function is given as it is. A function that raises answers with
` its value or an error, which leaves the function where the type pass says the call's errors
` do, as any call's.
. nothing = make-operand(.operand-void, 0)
. row = facts.calls[fact]
. callee = row.callee
if callee == no-instance || row.is-partial || !is-callable(callee)
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
if instances.signatures[callee].args.count != (if rhs == 0 then 0 else 1) || swapped-unary
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
.. swapped-unary = row.is-swapped && rhs == 0
. receiver = if row.is-swapped then right else left
. receiver-type = if row.is-swapped then right-type else left-type
if row.through.count != 0
    . reached = read-through(id, Typed(receiver, receiver-type), row.through)
    receiver = reached.operand
    receiver-type = reached.type
. self = instances.rows[callee].self-type
if receiver-type != self && !(tables.is-class(receiver-type) && descends(receiver-type, self))
    refuse(.refused-conversion, id)
    = Typed(nothing, no-type)
. mark = pending.length
pending += receiver
if rhs != 0
    . site = if row.is-swapped then lhs else rhs
    . argument = convert(site, .reason-argument, if row.is-swapped then Typed(left, left-type) else Typed(right, right-type))
    if argument.type != instances.argument-type(callee, 0)
        refuse(.refused-conversion, site)
    pending += argument.operand
. raising = instances.signatures[callee].errors.count != 0
takes-result = raising
. answer = call-method(callee, id, mark)
takes-result = false
if raising && row.propagates
    answer = propagate(id, callee, answer.operand)
= answer

────────────────────
_ do emit-match-statement Bool
    - body SyntaxId

` Emits `do match` of a subject, whose arms are run for what they do, and says whether the
` body of a `do` was one.
do match? tree.nodes[body]
    | .node-match-expression(row)
        if row.subject != 0 && helper-runs(row.helper)
            emit-subject-match(body, row.subject, row.body, row.is-optional, row.helper, true)
            = true
= false

────────────────────
_ helper-runs Bool
    - helper SyntaxId

` Whether a match runs as its subject's: one with no helper, or with one the type pass planned.
helper == 0 || plan == .plan-pattern-helper

.. plan = if helper != 0 then facts.plan-of(unit.reading, helper) else OperatorPlan.plan-none

────────────────────
_ do emit-subject-match Typed
    - id SyntaxId
    - subject SyntaxId
    - body SyntaxId
    - is-optional Bool
    - helper SyntaxId
    - is-statement Bool

` A match with a subject. The subject is evaluated once, and the arms are tried in the order
` written: each tests the subject against its pattern, and the first
` that matches gives the match its value, converted as the arms record for a side of its type. A
` struct is copied first, so nothing an arm runs changes what is matched. The arms may stand in a
` block with the lazy locals they read, which emit nothing there. Where no arm matches, `match`
` panics, `match?` and a match written on one line give an optional that holds nothing, and `do
` match?` goes on. The match `if` or `while` tests a pattern with gives false there. The arms after
` one that always matches are not emitted. With `is-statement` the arms are run for what they do and
` give no value. A stream pattern is run as `emit-stream-match` runs it, whose optional is that of
` `match?` too.
. nothing = make-operand(.operand-void, 0)
. pattern SyntaxId = 0
. inner = body
do match? tree.nodes[body]
    | .node-block(block)
        inner = 0
        for statement in tree.children[block.body]
            if !is-lazy-local(statement)
                inner = if inner == 0 then statement else body
do match? tree.nodes[inner]
    | .node-structure-match(arms)
        pattern = arms.pattern
    | .node-stream-match
        = emit-stream-match(id, subject, inner, helper, is-statement)
if pattern == 0
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. type = if is-statement then no-type else facts.node-type(unit.reading, id)
. given = if is-statement then no-type else facts.node-type(unit.reading, inner)
. layout = void-layout
if !is-statement
    if type == no-type || type == invalid-type || given == no-type || given == invalid-type
        refuse(.refused-expression, id)
        = Typed(nothing, no-type)
    layout = layout-of(type, id)
. value = emit-expression(subject)
. held = value.type
value = Typed(apart(value, subject, true), value.type)
. joined = ir.reserve-block()
. slot = if is-statement then nothing else join-slot(layout)
. mark = joins.length
. named = bound.length
. own-matching = matching
matching = matching.checks-row = facts.is-checked-row(unit.reading, subject)
matching = matching.checked-row = value.operand
matching = matching.checked-made = if matching.checks-row then made-row(value.operand) else U32.max
. proven = proven-item(subject)
if proven != U32.max && intrinsic(held) == .table-row
    made-rows += MadeRow
        - value.operand
        - TableCursor
            - proven-items[proven].columns
            - part(value.operand, layout-of(held, subject), 1, subject).operand
            - no-meta()
    matching = matching.checks-row = true
    matching = matching.checked-made = (made-rows.length - 1) as U32
matching = matching.case-subject = subject
. is-closed = match-arms(inner, pattern, value.operand, held, given, type, joined, slot)
matching = own-matching
drop-bound(named)
. absent = is-optional || facts.plan-of(unit.reading, inner) == .plan-unmatched-absent
if !is-closed
    if absent && is-statement
        jump(joined)
    else if absent
        arrive(id, empty-optional(type, layout).operand, joined, slot)
    else if facts.plan-of(unit.reading, inner) == .plan-open && !is-statement && type == types.bool-type
        arrive(id, integer(.machine-u8, 0), joined, slot)
    else if !function.may-panic || facts.plan-of(unit.reading, inner) != .plan-unmatched
        refuse(.refused-expression, id)
    else
        raise-text(first-arm(pattern), "Pattern match failed")
if is-statement
    ir.start-block(joined)
    = Typed(nothing, type)
if joins.length == mark && layout == void-layout
    ir.start-block(joined)
    = Typed(nothing, type)
. result = close-joins(joined, mark, layout, slot)
= Typed(result, type)

────────────────────
_ do emit-is Typed
    - id SyntaxId
    - lhs SyntaxId
    - rhs SyntaxId
    - negated Bool

` `is` or `is not` between a value and a pattern: whether the value matches the pattern, as
` an arm of a match tests it. Nothing is converted and no name is bound, and a pattern of
` items or of texts reads no rest. A pattern the type
` pass found can not match is never matched, and the value is evaluated all the same. A case
` of a state machine a property of a class holds is tested by the object's flag of the case,
` but where the tag is compared (`tests-tag`); one of a machine a module's property is, written
` on the property's name, by the flag alone, which the machine sets before its cases run. A value
` of a machine's union read from elsewhere is tested as `within-case` tests it.
. nothing = make-operand(.operand-void, 0)
. member = machine-of-union(facts.node-type(unit.reading, lhs)) if tree.nodes[rhs] is .node-symbol
if member && member.store == .store-member && !tests-tag() && reads-machine(lhs, member)
    . flag = member-flag(lhs, rhs, member)
    = Typed(if negated then compare(id, .compare-equal, flag.operand, integer(.machine-u8, 0)) else flag.operand, types.bool-type)
. value = Typed(nothing, no-type)
if member && member.store == .store-global && names-global(lhs, member)
    value = Typed(nothing, facts.node-type(unit.reading, lhs))
else
    value = emit-expression(lhs)
. yes = integer(.machine-u8, 1)
. no = integer(.machine-u8, 0)
. is-case = false
do match? tree.nodes[rhs]
    | .node-symbol
        is-case = true
    | .node-type-case
        is-case = true
if !is-case && facts.plan-of(unit.reading, rhs) == .plan-never
    = if negated then Typed(yes, types.bool-type) else Typed(no, types.bool-type)
. failed = ir.reserve-block()
. joined = ir.reserve-block()
. own-matching = matching
. named = bound.length
matching = matching.testing = true
matching = matching.tested = lhs
do match tree.nodes[rhs]
    | .node-symbol
        match-case(rhs, 0, value, failed)
    | .node-type-case(row)
        match-case(rhs, row.value, value, failed)
    | .node-type-list
        emit-pattern(rhs, value, failed)
    | .node-type-map
        emit-pattern(rhs, value, failed)
    | .node-type-and { facts.plan-of(unit.reading, rhs) == .plan-text-pattern }
        emit-pattern(rhs, value, failed)
    ??
        match-type(rhs, value, failed)
matching = own-matching
drop-bound(named)
. same = ir.current
jump(joined)
ir.start-block(failed)
jump(joined)
ir.start-block(joined)
= Typed(phi(u8-layout, if negated then no else yes, same, if negated then yes else no, failed), types.bool-type)

────────────────────
_ do reads-machine Bool
    - id SyntaxId
    - machine MachineFact

` Whether an expression reads a state machine itself, whose flags say which of its cases are
` active, rather than a value of its union read from elsewhere, which holds the one case the
` machine was in when it was read: the name alone of the module's property it is, the name of
` the local it is kept in or that a named machine written in a case of another declares, or
` the class's property it is, written after an object or alone.
if id == 0
    = false
if machine.store == .store-global
    = names-global(id, machine)
if machine.store == .store-member
    . property = decl-name(machine.module, machine.decl)
    do match? tree.nodes[id]
        | .node-get-expression(row)
            = property && row.name == property && !is-link(id)
        | .node-identifier(row)
            = property && row.name == property && resolves-member(id)
    = false
if machine.store != .store-local && machine.store != .store-nested
    = false
. row = bindings.machine-slots(machine.module, machine.syntax)
. binding = instances.rows[unit.reading].binding
if !row || row.bound == no-slot || binding == no-binding || !(tree.nodes[id] is .node-identifier)
    = false
. resolution = bindings.resolution-of(binding, id)
= resolution.kind == .resolve-slot && resolution.slot == row.bound

────────────────────
_ do within-cases [U32]
    - machine MachineFact
    - index U32

` The numbers of a state machine's case and of each case written in it, at any depth.
. machine-tree = program.modules[machine.module].tree
. items = machine-tree.state-items(machine-tree.state-body(machine.syntax))
. cases = machine-tree.machine-cases(items)
. found [U32]
if index >= cases.length as U32
    found += index
    = found
for position in 0 .. < cases.length
    if machine-tree.path-to(items, cases[position]).find(cases[index]) != null
        found += position as U32
= found

────────────────────
_ do pass-within
    - site SyntaxId
    - machine MachineFact
    - value Operand
    - index U32
    - failed IRBlockId

` Goes on where a value of a state machine's union read from elsewhere than the machine holds a
` case or a case written in it, as a case test of the machine finds the case active then, and
` leaves to `failed` where it holds another: the value holds the innermost case the machine was
` in when it was read.
. tag = load(value, 0, u8-layout, site)
. passed = ir.reserve-block()
for position in within-cases(machine, index)
    . next = ir.reserve-block()
    branch(compare(site, .compare-equal, tag, integer(.machine-u8, position)), passed, next)
    ir.start-block(next)
jump(failed)
fail-jumps += 1
ir.start-block(passed)

────────────────────
_ names-global Bool
    - id SyntaxId
    - machine MachineFact

` Whether a node is the name alone of the module's property a machine is.
|? !(tree.nodes[id] is .node-identifier) || machine.module != unit.source-module
    false
??
    resolution.kind == .resolve-global && resolution.decl == machine.decl

.. binding = instances.rows[unit.reading].binding
.. resolution = if binding != no-binding then bindings.resolution-of(binding, id) else Resolution(.resolve-none, 0)

────────────────────
_ do first-arm SyntaxId
    - pattern SyntaxId

` The arm written first of the arms of a match, where a match no arm matches panics.
do match? tree.nodes[pattern]
    | .node-type-or(row)
        = first-arm(row.left)
= pattern

────────────────────
_ do match-arms Bool ?! Refused
    - site SyntaxId
    - pattern SyntaxId
    - subject Operand
    - held TypeId
    - given TypeId
    - type TypeId
    - joined IRBlockId
    - slot Operand
    - raises SyntaxId = 0
    - alternative SyntaxId = 0

` Emits the arms of a match on a subject of type `held`, and says whether one that always
` matches ended them. An arm the type pass found can not match is passed over, as is one whose
` pattern names a case a refinement adds that no object reaches (`unreached-refined`), and an arm
` that raises a panic for whatever is left ends them. The arms of a loop's header declare
` the names their patterns write, as the header does; the body of an arm declares none.
` `given` is the
` type the arms join as and `type` the type of the match, an optional of it for `match?`;
` `given` is no type where the arms are run for what they do. An arm written with
` alternatives is an arm for each in turn, with the one body: `alternative` is the one
` tested. An arm that raises where its pattern matches is given the node that says so as
` `raises`. Whether an arm always matches is settled by its pattern, before its body, which
` may hold tests of its own, is emitted.
if alternative == 0 && raises == 0 && facts.plan-of(unit.reading, pattern) == .plan-switch
    = switch-arms(site, pattern, subject, held, given, type, joined, slot)
do match? tree.nodes[pattern]
    | .node-type-or(row)
        if match-arms(site, row.left, subject, held, given, type, joined, slot)
            = true
        if facts.plan-of(unit.reading, pattern) != .plan-present-after
            = match-arms(site, row.right, subject, held, given, type, joined, slot)
        . present = payload(site, Typed(subject, held))
        = match-arms
            - site
            - row.right
            - present.operand
            - types.optional-inner(held)
            - given
            - type
            - joined
            - slot
    | .node-type-transform(row)
        if facts.plan-of(unit.reading, pattern) == .plan-never
            = false
        . tested = if alternative != 0 then alternative else row.pattern
        if tested != 0
            do match? tree.nodes[tested]
                | .node-type-or(both)
                    if match-arms(site, pattern, subject, held, given, type, joined, slot, raises, both.left)
                        = true
                    = match-arms
                        - site
                        - pattern
                        - subject
                        - held
                        - given
                        - type
                        - joined
                        - slot
                        - raises
                        - both.right
        if alternative != 0 && facts.plan-of(unit.reading, alternative) == .plan-never
            = false
        if tested != 0 && unreached-refined(matching.case-subject, tested)
            = false
        . next = ir.reserve-block()
        . jumps = fail-jumps
        . named = bound.length
        . own-matching = matching
        matching = matching.arm-it = arm-slot-of(pattern, .slot-it)
        . passed = Typed(subject, held)
        if tested != 0
            passed = emit-pattern(tested, Typed(subject, held), next)
        switching = false
        . closes = fail-jumps == jumps
        arm-body(site, pattern, row.expr, passed, raises, given, type, joined, slot)
        matching = own-matching
        drop-bound(named)
        if closes
            = true
        ir.start-block(next)
        = false
    | .node-type-panic(row)
        do match? tree.nodes[row.pattern]
            | .node-type-transform(arm)
                if arm.expr != 0
                    = match-arms
                        - site
                        - row.pattern
                        - subject
                        - held
                        - given
                        - type
                        - joined
                        - slot
                        - pattern
        refuse(.refused-expression, pattern)
        = false
if facts.plan-of(unit.reading, pattern) == .plan-never || unreached-refined(matching.case-subject, pattern)
    = false
. next = ir.reserve-block()
. jumps = fail-jumps
. named = bound.length
. passed = emit-pattern(pattern, Typed(subject, held), next)
if given == no-type
    jump(joined)
else
    if passed.type != given
        passed = join(site, passed)
    if passed.type != given
        refuse(.refused-conversion, pattern)
    give-arm(site, passed, given, type, joined, slot)
drop-bound(named)
if fail-jumps == jumps
    = true
ir.start-block(next)
= false

────────────────────
_ do switch-arms Bool
    - site SyntaxId
    - pattern SyntaxId
    - subject Operand
    - held TypeId
    - given TypeId
    - type TypeId
    - joined IRBlockId
    - slot Operand

. arms [SyntaxId]
gather-arms(pattern, arms)
. cases = facts.constants[facts.constant-of(unit.reading, pattern)].bits == 1
. values [U64]
. owners [U32]
. fallback-arm SyntaxId = 0
for arm in arms
    . tested = arm-test(arm)
    if tested == 0
        fallback-arm = arm
        owners += U32.max
        continue
    . value = if cases then switch-case(tested) else switch-number(equality-expr(tested))
    . found = U32.max
    for position in 0 .. < values.length
        if values[position] == value
            found = position as U32
    if found == U32.max
        found = values.length as U32
        values += value
    owners += found
. discriminant = switch-subject(arm-test(arms[0]), subject, held, cases)
. fallback = ir.reserve-block()
. blocks [IRBlockId]
for _ in values
    blocks += ir.reserve-block()
switch(discriminant, fallback, values, blocks)
for bucket in 0 .. < values.length
    ir.start-block(blocks[bucket])
    if cases && share-bucket(site, arms, owners, bucket as U32, values[bucket], subject, held, given, type, joined, slot, fallback)
        continue
    . closed = false
    for position in 0 .. < arms.length
        if closed || owners[position] != bucket as U32
            continue
        switching = true
        switched-subject = subject
        switched-value = values[bucket]
        closed = match-arms(site, arms[position], subject, held, given, type, joined, slot)
        switching = false
    if !closed
        jump(fallback)
ir.start-block(fallback)
if fallback-arm != 0
    = match-arms(site, fallback-arm, subject, held, given, type, joined, slot)
= false

────────────────────
_ do arm-body
    - site SyntaxId
    - pattern SyntaxId
    - body SyntaxId
    - passed Typed
    - raises SyntaxId
    - given TypeId
    - type TypeId
    - joined IRBlockId
    - slot Operand

. own-matching = matching
matching = matching.declaring = false
if matching.arm-it != no-slot
    bound += BoundValue(matching.arm-it, passed.type, passed.operand)
if raises != 0
    raise-given(raises, body, pattern)
else if !arm-leaves(pattern, body)
    if given == no-type
        emit-block(body)
        jump(joined)
    else if !arm-raises(body)
        give-arm
            - site
            - arm-value(site, body, given, true, type, U32.max, operand-kind(slot) != .operand-void)
            - given
            - type
            - joined
            - slot
matching = own-matching

────────────────────
_ do share-bucket Bool
    - site SyntaxId
    - arms [SyntaxId]
    - owners [U32]
    - bucket U32
    - index U64
    - subject Operand
    - held TypeId
    - given TypeId
    - type TypeId
    - joined IRBlockId
    - slot Operand
    - fallback IRBlockId

if intrinsic(held) != .union
    = false
. members [SyntaxId]
. has-inner = false
for position in 0 .. < arms.length
    if owners[position] != bucket
        continue
    . tested = arm-test(arms[position])
    if tested == 0 || facts.plan-of(unit.reading, tested) != .plan-case
        = false
    has-inner = has-inner || case-inner(tested) != 0
    members += arms[position]
if members.length < 2
    = false
. layout = layout-of(held, site)
. field = tables.layouts.case-field(layout, index as U32)
if has-inner && (field.type == no-type || field.type == invalid-type)
    = false
. nothing = make-operand(.operand-void, 0)
. payload = if has-inner then take(subject, field, site) else nothing
. mark = match-steps.length
. sharing [SharedArm]
for arm in members
    . start = match-steps.length as U32
    . inner = case-inner(arm-test(arm))
    if inner != 0
        match-steps += MatchStep
            - .step-held
            - payload-part(inner, field.type)
            - payload
            - field.type
            - nothing
            - true
    sharing += settled(arm, start, subject, held)
shared-arms(site, sharing, given, type, joined, slot, fallback)
while match-steps.length > mark
    match-steps.pop()
= true

────────────────────
_ case-inner SyntaxId
    - pattern SyntaxId

match tree.nodes[pattern]
    | .node-type-case(row)
        row.value
    ??
        0

────────────────────
_ do payload-part SyntaxId
    - inner SyntaxId
    - held TypeId

do match? tree.nodes[inner]
    | .node-type-tuple(row)
        if row.field-types.count == 1 && intrinsic(held) != .tuple
            = tree.children[row.field-types.start]
= inner

────────────────────
_ transform-body SyntaxId
    - arm SyntaxId

match tree.nodes[arm]
    | .node-type-transform(row)
        row.expr
    ??
        0

────────────────────
_ do settled SharedArm
    - arm SyntaxId
    - start U32
    - result Operand
    - result-type TypeId

. kept = start
. carried = result
. carried-type = result-type
. end = match-steps.length as U32
for position in start .. < end
    . step = match-steps[position]
    if tree.nodes[step.pattern] is .node-type-wildcard
        if step.carries
            carried = step.subject
            carried-type = step.type
        continue
    match-steps[kept] = step
    kept += 1
while match-steps.length > kept
    match-steps.pop()
= SharedArm(arm, start, kept - start, carried, carried-type)

────────────────────
_ do carry-steps
    - arm SharedArm
    - skipped U32

for position in arm.first + skipped .. < arm.first + arm.count
    match-steps += match-steps[position]

────────────────────
_ do shared-arms ?! Refused
    - site SyntaxId
    - arms [SharedArm]
    - given TypeId
    - type TypeId
    - joined IRBlockId
    - slot Operand
    - missed IRBlockId

. start Size = 0
while start < arms.length
    . next = ir.reserve-block()
    . head = step-head(arms[start])
    . end = start + 1
    if head != .head-none
        . shared = match-steps[arms[start].first].subject
        while end < arms.length && step-head(arms[end]) == head && match-steps[arms[end].first].subject == shared
            end += 1
    if end - start > 1
        . run [SharedArm]
        for position in start .. < end
            run += arms[position]
        if head == .head-case
            case-run(site, run, given, type, joined, slot, next)
        else if head == .head-tuple
            tuple-run(site, run, given, type, joined, slot, next)
        else
            list-run(site, run, given, type, joined, slot, next)
    else
        leaf-arm(site, arms[start], given, type, joined, slot, next)
    ir.start-block(next)
    start = end
jump(missed)

────────────────────
_ do step-head MatchHead
    - arm SharedArm

if arm.count == 0
    = .head-none
. step = match-steps[arm.first]
if step.kind != .step-held
    = .head-none
. kind = intrinsic(step.type)
do match? tree.nodes[step.pattern]
    | .node-type-case(row)
        . constant = facts.constant-of(unit.reading, step.pattern)
        if not-case-plan || kind != .union || constant == no-fact || machine-case
            = .head-none
        .. not-case-plan = facts.plan-of(unit.reading, step.pattern) != .plan-case
        .. machine-case = machine-of-union(step.type) != null
        . layout = layout-of(step.type, step.pattern)
        if !tables.layouts.is-union(layout)
            = .head-none
        . index = facts.constants[constant].bits
        if index >= tables.layouts.rows[layout].cases.count as U64
            = .head-none
        if row.value != 0
            . field = tables.layouts.case-field(layout, index as U32)
            if field.type == no-type || field.type == invalid-type
                = .head-none
        = .head-case
    | .node-type-tuple(row)
        if optional-step || kind == .union || is-row-source(kind) || !is-aggregate(step.type)
            = .head-none
        .. optional-step = types.is-optional(step.type)
        . layout = layout-of(step.type, step.pattern)
        if !tables.layouts.is-struct(layout) || too-few-fields
            = .head-none
        .. too-few-fields = tables.layouts.rows[layout].fields.count < row.field-types.count
        = .head-tuple
    | .node-type-list
        if not-list-plan || types.is-optional(step.type) || kind == .union || views-held
            = .head-none
        .. not-list-plan = facts.plan-of(unit.reading, step.pattern) != .plan-list-pattern
        .. views-held = reads-views(step.pattern, step.type)
        = .head-list
= .head-none

────────────────────
_ do case-run
    - site SyntaxId
    - arms [SharedArm]
    - given TypeId
    - type TypeId
    - joined IRBlockId
    - slot Operand
    - missed IRBlockId

. head = match-steps[arms[0].first]
. layout = layout-of(head.type, head.pattern)
. values [U64]
. owners [U32]
for arm in arms
    . index = facts.constants[facts.constant-of(unit.reading, match-steps[arm.first].pattern)].bits
    . found = U32.max
    for position in 0 .. < values.length
        if values[position] == index
            found = position as U32
    if found == U32.max
        found = values.length as U32
        values += index
    owners += found
. miss = ir.reserve-block()
. blocks [IRBlockId]
for _ in values
    blocks += ir.reserve-block()
switch(load(head.subject, 0, u8-layout, head.pattern), miss, values, blocks)
. nothing = make-operand(.operand-void, 0)
for bucket in 0 .. < values.length
    ir.start-block(blocks[bucket])
    . field = tables.layouts.case-field(layout, values[bucket] as U32)
    . payload = nothing
    for position in 0 .. < arms.length
        if owners[position] == bucket as U32 && inner-case
            payload = take(head.subject, field, head.pattern)
            break
        .. inner-case = case-inner(match-steps[arms[position].first].pattern) != 0
    . members [SharedArm]
    for position in 0 .. < arms.length
        if owners[position] != bucket as U32
            continue
        . arm = arms[position]
        . step = match-steps[arm.first]
        . inner = case-inner(step.pattern)
        . start = match-steps.length as U32
        . result = arm.result
        . result-type = arm.result-type
        if inner != 0
            match-steps += MatchStep
                - .step-held
                - payload-part(inner, field.type)
                - payload
                - field.type
                - nothing
                - step.carries
        else if step.carries
            result = head.subject
            result-type = head.type
        carry-steps(arm, 1)
        members += settled(arm.arm, start, result, result-type)
    shared-arms(site, members, given, type, joined, slot, missed)
ir.start-block(miss)
jump(missed)

────────────────────
_ do tuple-run
    - site SyntaxId
    - arms [SharedArm]
    - given TypeId
    - type TypeId
    - joined IRBlockId
    - slot Operand
    - missed IRBlockId

. head = match-steps[arms[0].first]
. layout = layout-of(head.type, head.pattern)
. nothing = make-operand(.operand-void, 0)
. fields [Operand]
. field-types [TypeId]
for _ in 0 .. < tables.layouts.rows[layout].fields.count
    fields += nothing
    field-types += no-type
. members [SharedArm]
for arm in arms
    . step = match-steps[arm.first]
    . start = match-steps.length as U32
    do match? tree.nodes[step.pattern]
        | .node-type-tuple(row)
            for position in 0 .. < row.field-types.count
                . part = tree.children[row.field-types.start + position]
                if tree.nodes[part] is .node-type-wildcard
                    continue
                if field-types[position] == no-type
                    fields[position] = take
                        - head.subject
                        - tables.layouts.field(layout, position)
                        - step.pattern
                    field-types[position] = field-type(head.type, position)
                match-steps += MatchStep
                    - .step-held
                    - part
                    - fields[position]
                    - field-types[position]
                    - nothing
    carry-steps(arm, 1)
    . result = if step.carries then head.subject else arm.result
    . result-type = if step.carries then head.type else arm.result-type
    members += settled(arm.arm, start, result, result-type)
shared-arms(site, members, given, type, joined, slot, missed)

────────────────────
_ do list-run
    - site SyntaxId
    - arms [SharedArm]
    - given TypeId
    - type TypeId
    - joined IRBlockId
    - slot Operand
    - missed IRBlockId

. head = match-steps[arms[0].first]
. length = list-length(head.pattern, head.subject, head.type, false, no-layout)
. nothing = make-operand(.operand-void, 0)
. start Size = 0
while start < arms.length
    . has-first = first-item(match-steps[arms[start].first].pattern) != 0
    . end = start + 1
    while end < arms.length && (first-item(match-steps[arms[end].first].pattern) != 0) == has-first
        end += 1
    . next = ir.reserve-block()
    . first = nothing
    . first-type = no-type
    . sharing = has-first && end - start > 1
    if sharing
        pass-or-fail
            - compare(head.pattern, .compare-greater-equal, length.operand, integer(.machine-u64, 1))
            - next
        . item = first-item(match-steps[arms[start].first].pattern)
        . read = read-part
            - item
            - call-at(item, .call-item-read)
            - head.subject
            - head.type
            - integer(.machine-u64, 0)
            - types.index-type
        first = read.operand
        first-type = read.type
    . members [SharedArm]
    for position in start .. < end
        . arm = arms[position]
        . step = match-steps[arm.first]
        . begin = match-steps.length as U32
        list-steps(step.pattern, head.subject, head.type, length.operand, first, first-type, sharing)
        carry-steps(arm, 1)
        . result = if step.carries then head.subject else arm.result
        . result-type = if step.carries then head.type else arm.result-type
        members += settled(arm.arm, begin, result, result-type)
    shared-arms(site, members, given, type, joined, slot, next)
    ir.start-block(next)
    start = end
jump(missed)

────────────────────
_ do first-item SyntaxId
    - pattern SyntaxId

do match? tree.nodes[pattern]
    | .node-type-list(row)
        if row.patterns.count != 0
            . item = tree.children[row.patterns.start]
            if !(tree.nodes[item] is .node-type-remainder)
                = item
= 0

────────────────────
_ do list-steps
    - pattern SyntaxId
    - list Operand
    - type TypeId
    - length Operand
    - first Operand
    - first-type TypeId
    - sharing Bool

do match? tree.nodes[pattern]
    | .node-type-list(row)
        . count = row.patterns.count
        . rest = count
        for position in 0 .. < count
            if tree.nodes[tree.children[row.patterns.start + position]] is .node-type-remainder
                rest = position
        . fixed = if rest == count then count else count - 1
        if sharing
            match-steps += MatchStep
                - .step-held
                - tree.children[row.patterns.start]
                - first
                - first-type
                - length
        if !sharing || rest == count || fixed > 1
            match-steps += MatchStep
                - .step-length
                - pattern
                - list
                - type
                - length
                - false
                - fixed
                - 0
                - rest == count
        . opening U32 = if sharing then 1 else 0
        if opening < rest
            for position in opening .. < rest
                match-steps += MatchStep
                    - .step-item
                    - tree.children[row.patterns.start + position]
                    - list
                    - type
                    - length
                    - false
                    - position
        if rest + 1 < count
            for position in rest + 1 .. < count
                match-steps += MatchStep
                    - .step-from-end
                    - tree.children[row.patterns.start + position]
                    - list
                    - type
                    - length
                    - false
                    - position
                    - count - position
        if rest != count && !matching.testing && has-name(tree.children[row.patterns.start + rest])
            match-steps += MatchStep
                - .step-rest
                - tree.children[row.patterns.start + rest]
                - list
                - type
                - length
                - false
                - rest
                - count - rest - 1

────────────────────
_ do leaf-arm
    - site SyntaxId
    - arm SharedArm
    - given TypeId
    - type TypeId
    - joined IRBlockId
    - slot Operand
    - missed IRBlockId

. named = bound.length
. own-matching = matching
matching = matching.arm-it = arm-slot-of(arm.arm, .slot-it)
. last = arm.first + arm.count
for position in arm.first .. < last
    . step = match-steps[position]
    if step.kind == .step-length
        . wanted = integer(.machine-u64, step.position)
        pass-or-fail
            - compare
                - step.pattern
                - if step.exact then .compare-equal else .compare-greater-equal
                - step.length
                - wanted
            - missed
. result = arm.result
. result-type = arm.result-type
for position in arm.first .. < last
    . step = match-steps[position]
    if step.kind == .step-length
        continue
    if step.kind == .step-rest
        . end = step.length
        if step.back != 0
            end = arithmetic
                - step.pattern
                - .arithmetic-subtract
                - step.length
                - integer(.machine-u64, step.back)
                - u64-layout
        match-rest
            - step.pattern
            - step.subject
            - step.type
            - integer(.machine-u64, step.position)
            - end
            - false
            - missed
        continue
    . value = Typed(step.subject, step.type)
    if step.kind != .step-held
        . index = integer(.machine-u64, step.position)
        if step.kind == .step-from-end
            index = arithmetic
                - step.pattern
                - .arithmetic-subtract
                - step.length
                - integer(.machine-u64, step.back)
                - u64-layout
        . read = read-part
            - step.pattern
            - call-at(step.pattern, .call-item-read)
            - step.subject
            - step.type
            - index
            - types.index-type
        value = read
    . passed = emit-pattern(step.pattern, value, missed)
    if step.carries
        result = passed.operand
        result-type = passed.type
arm-body(site, arm.arm, transform-body(arm.arm), Typed(result, result-type), 0, given, type, joined, slot)
matching = own-matching
drop-bound(named)

────────────────────
_ do gather-arms
    - pattern SyntaxId
    - arms [SyntaxId]

do match? tree.nodes[pattern]
    | .node-type-or(row)
        gather-arms(row.left, arms)
        gather-arms(row.right, arms)
        =
arms += pattern

────────────────────
_ arm-test SyntaxId
    - arm SyntaxId

match tree.nodes[arm]
    | .node-type-transform(row)
        if row.pattern == 0 || tree.nodes[row.pattern] is .node-type-wildcard then 0 else row.pattern
    ??
        0

────────────────────
_ switch-case U64
    - pattern SyntaxId

facts.constants[facts.constant-of(unit.reading, pattern)].bits

────────────────────
_ equality-expr SyntaxId
    - pattern SyntaxId

match tree.nodes[pattern]
    | .node-type-equality(row)
        row.expr
    ??
        0

────────────────────
_ switch-number U64
    - expr SyntaxId

match tree.nodes[expr]
    | .node-integer-syntax(row)
        parse-integer-literal(row.value).value
    ??
        U64.max

────────────────────
_ do switch-subject Operand
    - pattern SyntaxId
    - subject Operand
    - held TypeId
    - cases Bool

if !cases
    = subject
. kind = intrinsic(held)
if kind == .table-row || kind == .immutable-table-row
    . located = subject-place(pattern, subject, held)
    = load(table-cell(pattern, located.columns, located.index, 0, u8-layout), 0, u8-layout, pattern)
= load(subject, 0, u8-layout, pattern)

────────────────────
_ do arm-value Typed
    - site SyntaxId
    - body SyntaxId
    - type TypeId
    - guards Bool = false
    - whole TypeId = no-type
    - remade U32 = U32.max
    - in-place Bool = false

` The value of the body of an arm, converted as the arms record for a side of its type. With
` `guards` an error is a value where the type of the match holds it, and has no shape where
` that type carries errors. A side the arms record a conversion for straight to the type of the
` match, `whole`, arrives as that. A body written as a block is a block of its own: the
` cleanups opened in it run where it ends. A value a helper makes again, `remade`, is what
` `remake` makes of the body's. With `in-place` the value is copied where the arms join as soon
` as it is read, so a struct is read from where it lies.
. opens = is-block(body)
. mark = open-cleanups.length
. own-scoping = scoping
if opens
    scoping = scoping.block-base = mark
. expression = ending(body)
if expression == 0
    refuse(.refused-expression, body)
    scoping = own-scoping
    = Typed(make-operand(.operand-void, 0), no-type)
. own-matching = matching
if in-place
    matching = matching.read-in-place = expression
. value = emit-expression(expression)
matching = own-matching
if remade != U32.max
    value = remake(site, remade, value.operand, value.type)
if guards && extends(value.type, types.error-type) && carries-error(type)
    refuse(.refused-expression, expression)
if value.type != type
    value = join(site, value)
if value.type != type && value.type != whole
    refuse(.refused-conversion, expression)
= if opens then close-value(value, mark, own-scoping, body) else value

────────────────────
_ is-block Bool
    - body SyntaxId

match tree.nodes[body]
    | .node-block
        true
    ??
        false

────────────────────
_ do give-arm
    - site SyntaxId
    - value Typed
    - given TypeId
    - type TypeId
    - joined IRBlockId
    - slot Operand

` Leaves the value of an arm for its match: as it is, held by the optional `match?` gives, or
` converted to the type the match was asked for as the arms record for the type they join
` as. One that arrived in the type of the match already is left as it is.
. left = value
if type != given && left.type != type
    left = if types.optional-inner(type) == given then wrap(site, Typed(value.operand, given), type) else join(site, Typed(value.operand, given))
arrive(site, left.operand, joined, slot)

────────────────────
_ do emit-stream-match Typed
    - id SyntaxId
    - subject SyntaxId
    - matched SyntaxId
    - helper SyntaxId
    - is-statement Bool

` A stream pattern run on the value a match is on, as `run-stream-match` runs it, with the
` helper of an enclosing match set aside while it runs.
. own-streaming = streaming
streaming = streaming.pattern-helper-type = no-type
. answer = run-stream-match(id, subject, matched, helper, is-statement)
streaming = own-streaming
= answer

────────────────────
_ do run-stream-match Typed
    - id SyntaxId
    - subject SyntaxId
    - matched SyntaxId
    - helper SyntaxId
    - is-statement Bool

` A stream pattern run on the value a match is on, as the reference runs one. The value is read into
` the stream the type pass chose for it, whose `pattern-view` gives the buffer, where the pattern
` starts and how many items the buffer holds, through the calls the type pass recorded at the
` pattern, in order. The arms are tried in turn from the start, and the first that passes gives the
` match its value: no arm after it is tried. An arm passes only where its pattern read the whole
` input, but on a stream the match is given, which it reads only as far as an arm matches. Such a
` stream, and one made of the value that pulls its items as they are needed, may give more input as
` it is read: each part that reads past the end of its buffer asks it for more and goes on with what
` it gives. The stream then commits where the pattern ended, or where it started, and how far it
` read. A match whose last arm can fail is optional, and holds nothing where no arm passed. One
` whose last arm raises panics. The match `if` or `while` tests a pattern with gives what its arm
` gives, and false where no arm passed. Each name the pattern captures has its place while the arms
` are emitted. A helper the type pass planned is kept for the values it makes. A match on a String
` or an array makes its stream inside an allocation scope of the task's parse region, as
` TypeScript routes that stream, and gives the region back to where it stood once the match
` ends.
. nothing = make-operand(.operand-void, 0)
. type = facts.node-type(unit.reading, matched)
. pattern SyntaxId = 0
do match? tree.nodes[matched]
    | .node-stream-match(row)
        pattern = row.pattern
if pattern == 0 || type == no-type || type == invalid-type || mistyped
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
.. mistyped = !is-statement && facts.node-type(unit.reading, id) != type
. always = stream-always-passes(pattern)
. opens = facts.plan-of(unit.reading, matched) == .plan-open
. result = facts.node-type(unit.reading, pattern)
if result == no-type
    refuse(.refused-expression, matched)
    = Typed(nothing, no-type)
. layout = if is-statement then void-layout else layout-of(type, id)
. value = emit-expression(subject)
. subject-type = value.type
if helper != 0
    . kept = emit-expression(helper)
    if facts.plan-of(unit.reading, helper) == .plan-pattern-helper
        streaming = streaming.pattern-helper = kept.operand
        streaming = streaming.pattern-helper-type = kept.type
. first = facts.first-call(unit.reading, matched)
. made = stream-maker(matched)
. viewed = if made != no-fact then next-call(made) else first
. commits = next-call(viewed)
. extends = next-call(commits)
if commits == no-fact
    refuse(.refused-expression, matched)
    = Typed(nothing, no-type)
. named = bound.length
. subject-slot = arm-slot-of(id, .slot-it)
if subject-slot != no-slot
    bound += BoundValue(subject-slot, subject-type, value.operand)
. regional = subject-type == types.string-type || array-subject
    .. array-subject = same-ref(class-ref(types, subject-type), types.array-decl)
. region-mark = if regional then make-operand(.operand-value, append(.op-load-task-word, matched, Span(), parse-region-mark-offset, u64-layout)) else nothing
. run = open-stream(matched, value.operand, subject-type, made, viewed, extends, regional)
. done = ir.reserve-block()
. slot = if is-statement then nothing else join-slot(layout)
. mark = joins.length
. failed = ir.reserve-block()
. given = attempt-arms(matched, pattern, result, run, made != no-fact, commits, failed, false)
if is-statement
    jump(done)
else if always || opens
    arrive(matched, given.operand, done, slot)
else
    arrive(matched, wrap(matched, Typed(given.operand, result), type).operand, done, slot)
ir.start-block(failed)
if opens && !is-statement
    arrive(matched, integer(.machine-u8, 0), done, slot)
else if always
    raise-text(matched, "Stream pattern match failed")
else if is-statement
    jump(done)
else
    arrive(matched, empty-optional(type, layout).operand, done, slot)
drop-bound(named)
if is-statement
    ir.start-block(done)
    reset-region(regional, region-mark, matched)
    = Typed(nothing, types.void-type)
. answer = close-joins(done, mark, layout, slot)
reset-region(regional, region-mark, matched)
= Typed(answer, type)

────────────────────
_ do reset-region
    - regional Bool
    - mark Operand
    - site SyntaxId

` Gives the task's parse region back to where it stood at a mark, where a match made its stream
` there.
if !regional
    =
. start = pending.length
pending += mark
call-runtime(.runtime-parse-region-reset, site, start)

────────────────────
_ do emit-scoped-match Typed
    - id SyntaxId
    - pattern SyntaxId

` A stream pattern written in the code of a function declared over the items of a stream, run
` on the stream the function is given as `attempt-arms` runs one on a stream a match is
` given: from where the stream stands, only as far as an arm matches, asking the stream for
` more where a part reads past the end of its buffer. Where an arm passed it gives a
` `CaptureResult` of the items the pattern read, as an array that shares the buffer's, and of
` what the arm gave; where none did, nothing. In the code of a local rule, as `coded-call`
` runs it, the stream is the one the rule was called on. The helper of an enclosing match is
` set aside while it runs. A result it gives is counted where the type pass marked the pattern
` for the profile.
. nothing = make-operand(.operand-void, 0)
. type = facts.node-type(unit.reading, id)
. result = facts.node-type(unit.reading, pattern)
. given-slot = no-slot
for offset in 0 .. < unit.slot-count
    if bindings.slots[unit.slot-start + offset].kind == .slot-argument && unit.positions[offset] == 0
        given-slot = unit.slot-start + offset
. coded-in = streaming.given-stream-type != no-type
if subjectless || result == no-type || not-optional
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
.. subjectless = !coded-in && (unit.reading != unit.instance || given-slot == no-slot)
.. not-optional = type == no-type || type == invalid-type || !types.is-optional(type)
. captured = types.optional-inner(type)
. layout = layout-of(type, id)
. captured-layout = layout-of(captured, id)
. viewed = facts.first-call(unit.reading, id)
. commits = next-call(viewed)
. extends = next-call(commits)
. counted = next-call(extends)
. counts = counted != no-fact && probe-metric && next-call(counted) == no-fact
    .. probe-metric = facts.calls[counted].form == .call-probe-metric
if commits == no-fact || (counted != no-fact && !counts) || not-capture-result
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
.. not-capture-result = !same-ref(class-ref(types, captured), types.capture-result-decl)
if !tables.layouts.is-struct(captured-layout) || unpaired-capture
    refuse(.refused-type, id)
    = Typed(nothing, no-type)
.. unpaired-capture = tables.layouts.rows[captured-layout].fields.count != 2
. subject-type = if coded-in then streaming.given-stream-type else instances.argument-type(unit.instance, 0)
. subject = if coded-in then streaming.given-stream else slot-value(given-slot, id, subject-type).operand
. own-streaming = streaming
streaming = streaming.pattern-helper-type = no-type
streaming = streaming.given-stream-type = no-type
. run = open-stream(id, subject, subject-type, no-fact, viewed, extends)
. done = ir.reserve-block()
. slot = join-slot(layout)
. mark = joins.length
. failed = ir.reserve-block()
. given = attempt-arms(id, pattern, result, run, false, commits, failed, false)
streaming = own-streaming
. items-field = tables.layouts.field(captured-layout, 0)
. result-field = tables.layouts.field(captured-layout, 1)
if other-buffer || result-field.layout != layout-of(result, id)
    refuse(.refused-type, id)
.. other-buffer = items-field.layout != run.buffer-layout
. number = if counts then tables.probe-number(unit.reading, id) else 0
if number != 0
    . start = pending.length
    pending += integer(.machine-u16, number)
    pending += integer(.machine-u64, 1)
    call-runtime(.runtime-profile-counter-add, id, start)
. items = stream-slice(run, id, run.start, load-local(attempt-end, id))
. made = frame(captured-layout)
put(made, items-field, items.operand, id)
put(made, result-field, given.operand, id)
arrive(id, wrap(id, Typed(made, captured), type).operand, done, slot)
ir.start-block(failed)
arrive(id, empty-optional(type, layout).operand, done, slot)
. answer = close-joins(done, mark, layout, slot)
= Typed(answer, type)

────────────────────
_ do attempt-arms Typed
    - site SyntaxId
    - pattern SyntaxId
    - result TypeId
    - run StreamRun
    - whole Bool
    - commits FactId
    - failure IRBlockId
    - keeps Bool

` The arms of a stream pattern tried on the view of a stream, from where it starts, as the
` reference tries them: where the input must be read `whole`, an arm passes only where it
` read the whole of it. A stream that may give more input is asked for it where a part reads
` past the end of its buffer, and the part goes on from there. Where an arm passes, the stream
` commits where it ended and how far the pattern read, and what the arm gives is given, with
` `attempt-end` left the local that keeps where it ended; where none does, the stream commits
` where the pattern started, and goes on to `failure`. How far the pattern read is kept no
` farther than the end of the input, as `settle-extent` says. The names the pattern captures
` are bound while the arms are emitted, and after them where the pattern `keeps` them. A
` pattern the type pass found holds a rollback mark gives back the one it holds where it
` fails, as the reference does; the marks of a pattern it runs in are set aside while it is
` emitted.
. nothing = make-operand(.operand-void, 0)
. arm-layout = layout-of(result, site)
. own-streaming = streaming
open-marks(site)
streaming = streaming.storage-row = facts.storage-body-of(unit.reading, site)
streaming = streaming.observer-row = facts.observer-body-of(unit.reading, site)
. end = ir.add-local(run.index-layout)
. arms-joined = ir.reserve-block()
. failed = ir.reserve-block()
. arm-slot = join-slot(arm-layout)
. arms-mark = joins.length
. held = bound.length
. captured = stream-captures.length
. arrives = false
if adapting != no-function
    arrives = adapt-arms(run, site, result, end, arms-joined, arm-slot, failed)
else
    hold-captures(run, pattern)
    plan-choices(pattern)
    arrives = emit-stream-arms(run, pattern, result, run.start, whole, end, arms-joined, arm-slot, failed)
if !keeps || !arrives
    drop-bound(held)
    drop-captures(captured)
if !arrives
    refuse(.refused-expression, site)
    drop-joins(arms-mark)
    = Typed(nothing, no-type)
. given = close-joins(arms-joined, arms-mark, arm-layout, arm-slot)
settle-extent(run, site)
commit-stream(run, commits, load-local(end, site))
. passing = ir.reserve-block()
jump(passing)
ir.start-block(failed)
rewind-mark(site)
settle-extent(run, site)
commit-stream(run, commits, run.start)
jump(failure)
ir.start-block(passing)
streaming = own-streaming
attempt-end = end
= Typed(given, result)

────────────────────
_ next-call FactId
    - fact FactId

if fact != no-fact then facts.calls[fact].next else no-fact

────────────────────
_ do open-stream StreamRun
    - site SyntaxId
    - subject Operand
    - subject-type TypeId
    - made FactId
    - viewed FactId
    - extends FactId
    - regional Bool = false

` The stream a pattern reads the value a match is on through, and the view of it the pattern
` runs over. A value that is a stream, and a `ChunkedTokenStream` made of the value, may give
` more input as it is read. A `regional` stream is made inside an allocation scope of the task's
` parse region.
. nothing = make-operand(.operand-void, 0)
. closed = StreamRun
    - site
    - nothing
    - no-type
    - nothing
    - no-type
    - nothing
    - nothing
    - nothing
    - no-local
    - no-local
    - void-layout
    - void-layout
    - void-layout
if regional
    . begin = tree.nodes[site].loc.begin
    . start = pending.length
    pending += integer(.machine-u64, begin.line + 1)
    pending += integer(.machine-u64, begin.column + 1)
    call-runtime(.runtime-parse-region-enter-scope, site, start)
. stream = stream-of(site, subject, subject-type, made)
. stream-type = stream.type
if regional
    call-runtime(.runtime-parse-region-leave-scope, site, pending.length)
. refills = made == no-fact || chunked
    .. chunked = same-ref(class-ref(types, stream-type), types.chunked-token-stream-decl)
= view-stream(site, stream.operand, stream-type, refills, viewed, extends)

────────────────────
_ do stream-of Typed
    - site SyntaxId
    - subject Operand
    - subject-type TypeId
    - made FactId

` The stream a pattern reads a value through, by the calls the type pass recorded for it: a
` value that is a stream converted to the `TokenStream` it is, and any other value, a String
` among them, given to the stream the type pass chose.
. nothing = make-operand(.operand-void, 0)
if made == no-fact
    . stream = convert(site, .reason-argument, Typed(subject, subject-type))
    if types.intrinsic-of(stream.type) != .interface
        refuse(.refused-conversion, site)
        = Typed(nothing, no-type)
    = stream
= make-stream(site, made, subject, subject-type)

────────────────────
_ do view-stream StreamRun
    - site SyntaxId
    - stream Operand
    - stream-type TypeId
    - refills Bool
    - viewed FactId
    - extends FactId

` The view of a stream a pattern runs over, as its `pattern-view` gives it: the buffer, where
` the pattern starts and how many items the buffer holds, read as it lies, or as its
` `pattern-text-view` gives the UTF-8 bytes of a String's characters. How far the pattern
` reads, and the farthest cursor a part of it fails at, are kept from the start. A stream that
` `refills` may give more input as it is read: the buffer, where its items start and how many
` it holds are kept, to be read again where its `pattern-extend` gives more.
. nothing = make-operand(.operand-void, 0)
. closed = StreamRun
    - site
    - nothing
    - no-type
    - nothing
    - no-type
    - nothing
    - nothing
    - nothing
    - no-local
    - no-local
    - void-layout
    - void-layout
    - void-layout
. view = call-protocol(site, viewed, stream, stream-type, nothing)
if !types.is-optional(view.type)
    refuse(.refused-type, site)
    = closed
. held = payload(site, view)
. tuple-layout = layout-of(held.type, site)
. buffer = part(held.operand, tuple-layout, 0, site)
. buffer-type = buffer.type
. start = part(held.operand, tuple-layout, 1, site)
. start-type = start.type
. length = part(held.operand, tuple-layout, 2, site)
. length-type = length.type
. buffer-layout = layout-of(buffer-type, site)
. index-layout = layout-of(types.index-type, site)
. size-layout = layout-of(types.size-type, site)
. item-layout = layout-of(class-arg(types, buffer-type, 0), site)
if start-type != types.index-type || length-type != types.size-type
    refuse(.refused-type, site)
    = closed
if !tables.layouts.is-struct(buffer-layout) || unpaired-buffer || !is-integer(index-layout)
    refuse(.refused-type, site)
    = closed
.. unpaired-buffer = tables.layouts.rows[buffer-layout].fields.count != 2
. data = part(buffer.operand, buffer-layout, 0, site)
. data-layout = layout-of(data.type, site)
if !is-pointer(data-layout)
    refuse(.refused-type, site)
    = closed
. extent = ir.add-local(index-layout)
store-local(extent, start.operand, site)
. error = ir.add-local(index-layout)
store-local(error, start.operand, site)
. length-index = num-cast(site, length.operand, size-layout, index-layout)
. run = StreamRun
    - site
    - stream
    - stream-type
    - buffer.operand
    - buffer-type
    - num-cast(site, data.operand, data-layout, pointer-layout)
    - start.operand
    - length-index
    - extent
    - error
    - index-layout
    - item-layout
    - buffer-layout
    - viewed
    - extends
if !refills
    = run
if extends == no-fact
    refuse(.refused-type, site)
    = closed
. kept-buffer = ir.add-local(buffer-layout)
store-local(kept-buffer, buffer.operand, site)
. kept-data = ir.add-local(pointer-layout)
store-local(kept-data, run.data, site)
. kept-length = ir.add-local(index-layout)
store-local(kept-length, length-index, site)
= StreamRun
    - site
    - stream
    - stream-type
    - buffer.operand
    - buffer-type
    - run.data
    - start.operand
    - length-index
    - extent
    - error
    - index-layout
    - item-layout
    - buffer-layout
    - viewed
    - extends
    - kept-buffer
    - kept-data
    - kept-length

────────────────────
_ do make-stream Typed
    - site SyntaxId
    - made FactId
    - given Operand
    - given-type TypeId

` The stream the type pass chose to read a value through, made of it: given the value,
` converted as the type pass recorded, then the defaults its other parameters take.
. nothing = make-operand(.operand-void, 0)
if facts.calls[made].form != .call-constructor || !is-callable(facts.calls[made].callee)
    refuse(.refused-expression, site)
    = Typed(nothing, no-type)
. maker = facts.calls[made].callee
. signature = instances.signatures[maker]
. count = signature.args.count
if count == 0 || count > 2 || signature.errors.count != 0
    refuse(.refused-expression, site)
    = Typed(nothing, no-type)
. parameter = instances.argument-type(maker, 0)
. value = given
if given-type != parameter
    . converted = convert(site, .reason-argument, Typed(given, given-type))
    value = converted.operand
    if converted.type != parameter
        refuse(.refused-conversion, site)
        = Typed(nothing, no-type)
. mark = pending.length
pending += value
if count == 2
    . default = parameter-default(maker, 1)
    if default == 0
        refuse(.refused-expression, site)
        drop-pending(mark)
        = Typed(nothing, no-type)
    pending += default-argument(site, maker, default, instances.argument-type(maker, 1)).operand
= call-instance(maker, site, mark)

────────────────────
_ do run-buffer Operand
    - run StreamRun
    - site SyntaxId

` The buffer of the stream's view as the pattern last read it, or in a rule's function, which
` is given where the items start and their count, an array that shares them.
if run.kept-buffer != no-local
    = load-local(run.kept-buffer, site)
if operand-kind(run.buffer) == .operand-void
    . slice = stream-slice
        - run
        - site
        - integer(tables.layouts.rows[run.index-layout].kind, 0)
        - run-length(run, site)
    = slice.operand
= run.buffer

────────────────────
_ do run-data Operand
    - run StreamRun
    - site SyntaxId

` The address the items of the stream's buffer start at, as the pattern last read it.
= if run.kept-data != no-local then load-local(run.kept-data, site) else run.data

────────────────────
_ do run-length Operand
    - run StreamRun
    - site SyntaxId

` The count of items in the stream's buffer, as an index, as the pattern last read it.
= if run.kept-length != no-local then load-local(run.kept-length, site) else run.length

────────────────────
_ do branch-present
    - run StreamRun
    - site SyntaxId
    - cursor Operand
    - present IRBlockId
    - ended IRBlockId

` Goes on to `present` where an item lies at a cursor in the stream's buffer, and else to
` `ended`. A stream that may give more input is asked for more first, as often as it gives
` some, so that `ended` follows only once the input ends.
if run.kept-length == no-local
    branch(compare(site, .compare-less, cursor, run.length), present, ended)
    =
. test = ir.reserve-block()
. asks = ir.reserve-block()
jump(test)
ir.start-block(test)
branch(compare(site, .compare-less, cursor, run-length(run, site)), present, asks)
ir.start-block(asks)
. grew = call-protocol
    - site
    - run.extends
    - run.stream
    - run.stream-type
    - make-operand(.operand-void, 0)
if grew.type != types.bool-type
    refuse(.refused-type, site)
    =
reread-stream(run, site)
branch(compare(site, .compare-not-equal, grew.operand, integer(.machine-u8, 0)), test, ended)

────────────────────
_ do reread-stream
    - run StreamRun
    - site SyntaxId

` Reads the view of a stream that may give more input again, for the buffer it now holds,
` where its items start and how many it holds.
. view = call-protocol(site, run.views, run.stream, run.stream-type, make-operand(.operand-void, 0))
if !types.is-optional(view.type)
    refuse(.refused-type, site)
    =
. held = payload(site, view)
keep-view(run, site, held.operand, layout-of(held.type, site))

────────────────────
_ do keep-view
    - run StreamRun
    - site SyntaxId
    - held Operand
    - tuple-layout LayoutId

` Keeps of a view of the stream a pattern runs on, as `pattern-view` gives it, the buffer, where
` its items start and how many it holds, for the parts after to read.
. buffer = part(held, tuple-layout, 0, site)
. length = part(held, tuple-layout, 2, site)
. length-layout = layout-of(length.type, site)
. data = part(buffer.operand, run.buffer-layout, 0, site)
. data-layout = layout-of(data.type, site)
if run.kept-buffer != no-local
    store-local(run.kept-buffer, buffer.operand, site)
store-local(run.kept-data, num-cast(site, data.operand, data-layout, pointer-layout), site)
store-local(run.kept-length, num-cast(site, length.operand, length-layout, run.index-layout), site)

────────────────────
_ do record-call-extent
    - run StreamRun
    - id SyntaxId
    - reached Operand

` Keeps how far a function a pattern called read as how far the pattern read. Where it read past
` the end of the buffer of a stream that may give more input, the stream may have given it more,
` and its view is read again.
record-extent(run, id, reached)
if run.kept-length == no-local
    =
. again = ir.reserve-block()
. onward = ir.reserve-block()
branch(compare(id, .compare-greater, reached, run-length(run, id)), again, onward)
ir.start-block(again)
reread-stream(run, id)
jump(onward)
ir.start-block(onward)

────────────────────
_ do settle-extent
    - run StreamRun
    - site SyntaxId

` Keeps how far a pattern on a stream that may give more input read no farther than the end of
` the input, where it read past it, as the reference does once the stream gives no more.
if run.kept-length == no-local
    =
. length = run-length(run, site)
. beyond = ir.reserve-block()
. settled = ir.reserve-block()
branch(compare(site, .compare-greater, load-local(run.extent, site), length), beyond, settled)
ir.start-block(beyond)
store-local(run.extent, length, site)
jump(settled)
ir.start-block(settled)

────────────────────
_ may-grow Bool
    - stream-type TypeId

` Whether a stream of a type may give more input as a pattern reads it: any but an
` `ArrayTokenStream` or an `IndexableTokenStream`, whose buffer holds all of it.
!same-ref(ref, types.array-token-stream-decl) && !same-ref(ref, types.indexable-token-stream-decl)

.. ref = class-ref(types, stream-type)

────────────────────
_ do parameter-default SyntaxId
    - callee InstanceId
    - position U32

` The default a parameter of a function is written with, or none.
. row = instances.rows[callee]
do match? program.modules[row.module].decls[row.decl]
    | .decl-function(fn)
        if position < fn.args.count
            = program.modules[row.module].arg-pool[fn.args.start + position].default-syntax
= 0

────────────────────
_ do commit-stream
    - run StreamRun
    - fact FactId
    - cursor Operand

` Tells the stream where the pattern left it and how far it read.
. reached = load-local(run.extent, run.site)
call-protocol
    - run.site
    - fact
    - run.stream
    - run.stream-type
    - cursor
    - types.index-type
    - true
    - reached
    - types.index-type

────────────────────
_ do emit-stream-arms Bool
    - run StreamRun
    - id SyntaxId
    - result TypeId
    - from Operand
    - whole Bool
    - end LocalId
    - joined IRBlockId
    - slot Operand
    - failed IRBlockId
    - unread Bool = false

` The arms of a stream pattern, tried from a cursor as the alternatives of a choice are. An arm
` whose pattern passes, at the end of the input where the arms must read the whole of it,
` keeps where it ended and leaves its value, converted to the type the arms join as, for the
` join; one that fails, or leaves input unread that it must read, goes on to the next, and the
` last to `failed`. Whether any arm reaches the join. Where `unread`, nothing reads the value
` the arms join as.
. arms [SyntaxId]
choice-arms(tree, id, arms)
if arms.length == 1
    = emit-stream-arm(run, id, result, from, whole, end, joined, slot, failed, no-local, unread)
= try-alternatives
    - run
    - id
    - arms
    - from
    - observed-failure(id, from, failed)
    - ArmWay(id, result, whole, end, joined, slot, false, unread)

────────────────────
_ do emit-stream-arm Bool
    - run StreamRun
    - id SyntaxId
    - result TypeId
    - from Operand
    - whole Bool
    - end LocalId
    - joined IRBlockId
    - slot Operand
    - failed IRBlockId
    - entered LocalId = no-local
    - unread Bool = false

` One arm of a stream pattern, emitted as `emit-arm` says with the places of its own names
` in force, as `activate-captures` says. Whether the arm reaches the join.
. held = stream-captures.length
. named = bound.length
activate-captures(id)
. arrives = emit-arm(run, id, result, from, whole, end, joined, slot, failed, entered, unread)
-= stream-captures[held .. < stream-captures.length]
drop-bound(named)
= arrives

────────────────────
_ do emit-arm Bool ?! Refused
    - run StreamRun
    - id SyntaxId
    - result TypeId
    - from Operand
    - whole Bool
    - end LocalId
    - joined IRBlockId
    - slot Operand
    - failed IRBlockId
    - entered LocalId = no-local
    - unread Bool = false

` One arm of a stream pattern, tried from a cursor. An arm with no pattern reads nothing and
` always passes. An arm that runs an expression binds `it` to the text its pattern matched, or
` to what a rule its pattern calls gave, where the expression reads it, or to the span of what
` it matched where the type pass kept `it` as one, and `location` to where
` its pattern began and ended, or with no pattern to where it is tried; one that only matches
` gives that text or that value. An action the reference runs in a function of its own, where
` a call may panic, has no shape here. One the type pass found asks for a rollback mark asks
` for it before its expression runs. Where it passes, the arms hold the rollback mark they held
` before it, where `entered` kept one. Where functions the expression makes read `it` or a
` name the pattern captures, its value is kept in the environment too, as the arm begins
` (`keep-arm-captures`). Where the input must be read whole, an arm whose pattern leaves some
` unread fails as its pattern does. Whether the arm reaches the join.
do match? tree.nodes[id]
    | .node-stream-panic
        emit-stream-raise(run, id, failed)
        = false
    | .node-stream-transform(row)
        if row.pattern != 0 && tree.lazies-only(row.right)
            = emit-bare-arm
                - run
                - id
                - result
                - from
                - whole
                - end
                - joined
                - slot
                - failed
                - entered
                - unread
        . finish = from
        . given = make-operand(.operand-void, 0)
        . given-type = no-type
        if row.pattern != 0
            . part = lowered-part(row.pattern)
            . missed = observed-failure(part, from, observed-failure(id, from, failed))
            . reached = emit-stream-node(run, part, from, missed)
            finish = reached.ending
            given = reached.value.operand
            given-type = reached.value.type
            if whole
                stream-whole(run, id, finish, missed)
        if facts.is-marking-arm(unit.reading, id)
            ensure-mark(id)
        . named = bound.length
        . it-slot = arm-slot-of(id, .slot-it)
        . located = location-fact(id)
        . first = facts.first-call(unit.reading, id)
        . spans-it = facts.spanning-it(unit.reading, id)
        if spans-it != no-type
            . span = source-span(run, id, from, finish, spans-it)
            if it-slot == no-slot
                refuse(.refused-expression, id)
            bind-it(it-slot, span.operand, spans-it, id)
        else if row.pattern != 0 && gives-value(row.pattern)
            if given-type == no-type
                refuse(.refused-expression, id)
                = false
            if it-slot != no-slot
                bind-it(it-slot, given, given-type, id)
        else if (first != no-fact && first != located) || material-at(id, .material-text) != U32.max
            . text = stream-text(run, id, from, finish)
            . text-type = text.type
            if it-slot == no-slot
                refuse(.refused-expression, id)
            bind-it(it-slot, text.operand, text-type, id)
        if located != no-fact
            bind-location(run, id, located, from, finish, row.pattern != 0)
        bind-materials(run, id)
        if row.pattern != 0
            keep-arm-captures(row.pattern)
        . outlined = facts.plan-of(unit.reading, id) == .plan-outlined-panic
        . remade = material-at(id, .material-result)
        if outlined && remade != U32.max
            refuse(.refused-expression, id)
        . value = if outlined then action-call(id, result) else arm-value(id, row.right, result, false, no-type, remade)
        drop-bound(named)
        if facts.is-spanning-arm(unit.reading, id)
            value = source-span(run, id, from, finish, result)
        pass-marks(entered, id)
        store-local(end, finish, id)
        arrive(id, value.operand, joined, slot)
        = true
= emit-bare-arm(run, id, result, from, whole, end, joined, slot, failed, entered, unread)

────────────────────
_ do bind-it
    - slot SlotId
    - value Operand
    - type TypeId
    - site SyntaxId

` Binds `it` in an arm of a stream pattern to what the arm gives its expression, which is kept
` in the environment too where functions the expression makes read it.
if is-captured(slot)
    keep-captured(slot, value, type, site)
bound += BoundValue(slot, type, value)

────────────────────
_ do keep-arm-captures
    - pattern SyntaxId

` Keeps in the environment, as an arm begins, what each name its pattern captures holds,
` where functions the arm's expression makes read the name.
. kept [SlotId]
for node in tree.subtree-start(pattern) .. < pattern + 1
    do match? tree.nodes[node]
        | .node-stream-capture(row)
            . slot = captured-slot(row.name)
            if slot == no-slot || !is-captured(slot) || kept has slot
                continue
            kept += slot
            . held = captured-at(slot)
            if held == U32.max
                refuse(.refused-expression, node)
                =
            . field = find-captured(slot, row.name)
            . value = read-capture(row.name, held, field.type)
            keep-captured(slot, value.operand, value.type, row.name)

────────────────────
_ do emit-bare-arm Bool
    - run StreamRun
    - id SyntaxId
    - result TypeId
    - from Operand
    - whole Bool
    - end LocalId
    - joined IRBlockId
    - slot Operand
    - failed IRBlockId
    - entered LocalId = no-local
    - unread Bool = false

` An arm that runs no expression: it gives the text its pattern matched, or what a rule its
` pattern calls gave, converted to the type the arms join as. Where it passes, the arms hold
` the rollback mark they held before it, where `entered` kept one. Where `unread`, nothing
` reads what the arm gives, and text `slices-text` says is only cut from the buffer is not
` made: the arm gives the empty text. Where the input must be read whole, an arm that leaves
` some unread fails as its pattern does.
. part = lowered-part(id)
. missed = observed-failure(part, from, failed)
. reached = emit-stream-node(run, part, from, missed)
. finish = reached.ending
. given = reached.value.operand
. given-type = reached.value.type
if whole
    stream-whole(run, id, finish, missed)
if facts.is-spanning-arm(unit.reading, id)
    . span = source-span(run, id, from, finish, result)
    pass-marks(entered, id)
    store-local(end, finish, id)
    arrive(id, span.operand, joined, slot)
    = true
. text = Typed(given, given-type)
if gives-value(id)
    if given-type == no-type
        refuse(.refused-expression, id)
        = false
else if unread && slices-text(id)
    text = Typed(make-operand(.operand-constant, ir.add-string("")), types.string-type)
else
    text = stream-text(run, id, from, finish)
if text.type != result
    text = join(id, text)
pass-marks(entered, id)
store-local(end, finish, id)
arrive(id, text.operand, joined, slot)
= true

────────────────────
_ do slices-text Bool
    - site SyntaxId

` Whether the text a part of a pattern matched is a `String` cut from the stream's buffer, by
` the call `stream-text` makes, rather than what a helper makes of it.
if material-at(site, .material-text) != U32.max
    = false
. fact = facts.first-call(unit.reading, site)
if tree.nodes[site] is .node-stream-equality
    fact = next-call(next-call(fact))
if fact == no-fact || facts.calls[fact].callee == no-instance
    = false
= instances.signatures[facts.calls[fact].callee].returns == types.string-type

────────────────────
_ do source-span Typed
    - run StreamRun
    - site SyntaxId
    - begun Operand
    - ending Operand
    - type TypeId

` The `CaptureSpan` an arm of a rule that states one gives: the stream's buffer and the two
` cursors its pattern matched between. A rule's function, given where the items start and
` their count, gives it an array that shares them.
. nothing = make-operand(.operand-void, 0)
. layout = layout-of(type, site)
if !tables.layouts.is-struct(layout) || tables.layouts.rows[layout].fields.count != 3
    refuse(.refused-type, site)
    = Typed(nothing, no-type)
. source-field = tables.layouts.field(layout, 0)
. start-field = tables.layouts.field(layout, 1)
. end-field = tables.layouts.field(layout, 2)
if source-field.layout != run.buffer-layout || unindexed-bounds
    refuse(.refused-type, site)
    = Typed(nothing, no-type)
.. unindexed-bounds = start-field.layout != run.index-layout || end-field.layout != run.index-layout
. buffer = run-buffer(run, site)
. span = frame(layout)
put(span, source-field, buffer, site)
put(span, start-field, begun, site)
put(span, end-field, ending, site)
= Typed(span, type)

────────────────────
_ gives-value Bool
    - id SyntaxId

` Whether a part of a stream pattern gives what a rule or a pattern it calls gives rather than
` the text it matched: so do a test of an item for a case of a union, which gives the item, and
` a call planned to give its text that the type pass recorded the helper to make another type of.
plan == .plan-stream-value || plan == .plan-pattern-call || plan == .plan-case || (plan == .plan-span-call && stated != types.string-type && stated != no-type && material-at(id, .material-text) != U32.max)

.. plan = facts.plan-of(unit.reading, id)
.. stated = facts.node-type(unit.reading, id)

────────────────────
_ do stream-whole
    - run StreamRun
    - id SyntaxId
    - finish Operand
    - failed IRBlockId

` Goes on where an arm's pattern ended at the end of the input, and else keeps where it ended
` as a cursor a part failed at and goes to `failed`.
. whole = ir.reserve-block()
. short = ir.reserve-block()
branch-present(run, id, finish, short, whole)
ir.start-block(short)
record-error(run, id, finish)
jump(failed)
ir.start-block(whole)

────────────────────
_ do emit-stream-raise
    - run StreamRun
    - id SyntaxId
    - failed IRBlockId

` An arm that raises what it gives where no arm before it passed, as an assertion raises its
` exception, which reads as `location` the farthest cursor a part of the pattern failed at.
. exception SyntaxId = 0
. located SyntaxId = 0
do match? tree.nodes[id]
    | .node-stream-panic(row)
        do match? tree.nodes[row.pattern]
            | .node-stream-transform(arm)
                if arm.pattern == 0
                    exception = arm.right
                    located = row.pattern
if exception == 0
    refuse(.refused-expression, id)
    =
. named = bound.length
. fact = location-fact(located)
if fact != no-fact
    . farthest = load-local(run.error, id)
    bind-location(run, located, fact, farthest, farthest, false)
raise-given(id, exception)
drop-bound(named)

────────────────────
_ do emit-stream-part StreamPart ?! Refused
    - run StreamRun
    - id SyntaxId
    - cursor Operand
    - failed IRBlockId

` A part of a stream pattern that runs nothing, tried from a cursor: where it passes, what is
` emitted next goes on from the cursor where it ended; where it fails it goes to `failed`.
` Alternatives are tried in turn from the cursor, and the first that passes is kept. A
` repeat takes its part as often as it passes, up to its most, and passes where it took it at
` least its least; one with no most stops where its part passed without moving on. An
` optional part passes either way. A lookahead passes or fails as its part does, or the other
` way, and leaves the cursor where it was. A name captured holds what its part matched. A
` call of a rule gives what the rule gave, which a sequence it ends, a name captured over it
` and an optional part around it give too, and a test of one item gives the item, as does a
` `.` the type pass typed as the item; no other part gives a value. A part that fails
` keeps where it began as a cursor a part failed at, as the reference's do, a choice too,
` since it may skip every alternative; sequences keep none of their own, as what fails in
` them began past where they did. Under a helper that observes literal words, a part that fails
` tells it so, as `observed-failure` says.
= emit-stream-node(run, id, cursor, observed-failure(id, cursor, failed))

────────────────────
_ bare-part StreamPart
    - ending Operand

` A part of a stream pattern that ends at a cursor and gives no value.
StreamPart(ending, Typed(make-operand(.operand-void, 0), no-type))

────────────────────
_ do emit-stream-node StreamPart
    - run StreamRun
    - id SyntaxId
    - cursor Operand
    - failed IRBlockId

` A part of a stream pattern tried from a cursor, as `emit-stream-part` says, which goes to
` `failed` where it fails with nothing more told to the helper. A sequence in a sequence is
` one with it, as the reference takes it.
do match? tree.nodes[id]
    | .node-stream-string(row)
        = bare-part(stream-literal(run, id, row.text, cursor, failed))
    | .node-stream-call
        = stream-call(run, id, cursor, failed)
    | .node-stream-any
        . passed = stream-class(run, id, 0, 0, true, cursor, failed)
        . item = facts.node-type(unit.reading, id)
        if item != no-type
            = StreamPart(passed, Typed(char-at(run, id, cursor), item))
        = bare-part(passed)
    | .node-stream-char-range(row)
        . ranged = stream-class
            - run
            - id
            - stream-bound(tree, row.first)
            - stream-bound(tree, row.last)
            - false
            - cursor
            - failed
        . item = facts.node-type(unit.reading, id)
        if item != no-type && item != types.string-type
            = StreamPart(ranged, Typed(stream-item(run, id, cursor), item))
        = bare-part(ranged)
    | .node-stream-predicate(row)
        = stream-predicate(run, id, row.predicate, cursor, failed)
    | .node-stream-equality(row)
        if facts.plan-of(unit.reading, id) == .plan-pattern-call
            = pattern-call(run, id, row.value, cursor, failed)
        if facts.plan-of(unit.reading, id) == .plan-case
            = stream-case-item(run, id, cursor, failed)
        if facts.node-type(unit.reading, id) != types.string-type
            = stream-dynamic-item(run, id, row.value, cursor, failed)
        = bare-part(stream-dynamic-text(run, id, row.value, cursor, failed))
    | .node-stream-type(row)
        = stream-type-part(run, id, row.type, cursor, failed)
    | .node-stream-and
        = stream-sequence(run, id, cursor, failed)
    | .node-stream-or
        = stream-choice(run, id, cursor, failure-of(run, id, cursor, failed))
    | .node-stream-capture(row)
        = stream-capture(run, id, row.name, row.pattern, cursor, failed)
    | .node-stream-transform(row)
        if row.pattern != 0 && tree.lazies-only(row.right)
            = emit-stream-part(run, row.pattern, cursor, failed)
    | .node-stream-unary(row)
        if row.op == .zero-or-one-op
            = stream-optional(run, id, row.operand, cursor)
        if row.op == .zero-or-more-op
            = stream-repeat
                - run
                - id
                - row.operand
                - 0
                - U64.max
                - cursor
                - failed
                - is-scanned(tree, row.operand)
        if row.op == .one-or-more-op
            = stream-repeat
                - run
                - id
                - row.operand
                - 1
                - U64.max
                - cursor
                - failure-of(run, id, cursor, failed)
                - is-scanned(tree, row.operand)
        if facts.plan-of(unit.reading, id) == .plan-stream-guard
            . missed = failure-of(run, id, cursor, failed)
            = bare-part(stream-guard(id, row.operand, row.op == .positive-lookahead-op, cursor, missed))
        if row.op == .positive-lookahead-op || row.op == .negative-lookahead-op
            . looked = stream-lookahead
                - run
                - id
                - row.operand
                - row.op == .positive-lookahead-op
                - cursor
                - failure-of(run, id, cursor, failed)
            = bare-part(looked)
    | .node-stream-length(row)
        . most-at = if row.max != 0 then row.max else row.min
        . least-at = if literal-bound(tree, row.min) then 0 else row.min
        . limit-at = if literal-bound(tree, most-at) then 0 else most-at
        . short = if least-at != 0 || stream-bound(tree, row.min) != 0 then failure-of(run, id, cursor, failed) else failed
        = stream-repeat
            - run
            - id
            - row.operand
            - stream-bound(tree, row.min)
            - stream-bound(tree, most-at)
            - cursor
            - short
            - false
            - least-at
            - limit-at
refuse(.refused-expression, id)
= bare-part(cursor)

────────────────────
_ do observed-failure IRBlockId
    - id SyntaxId
    - cursor Operand
    - failed IRBlockId

` Where a part tried from a cursor goes where it fails, under a helper that observes the literal
` words a pattern matches: a block that tells the helper to forget the words it was told of
` that end past the cursor, then goes to `failed`, as the reference does where any part of its
` own fails but an arm that raises. The items a repeat scans, and alternatives the reference
` tests as one item, are no parts of their own there. What is emitted next goes on past it.
if streaming.observer-row == U32.max || scanning || streaming.classing || !observes(id)
    = failed
. missed = ir.reserve-block()
. onward = ir.reserve-block()
jump(onward)
ir.start-block(missed)
rewind-literals(id, cursor)
jump(failed)
ir.start-block(onward)
= missed

────────────────────
_ do observes Bool
    - id SyntaxId

` Whether the reference takes a part of a pattern as one of its own: not a part that only
` declares lazy locals around another, nor an arm that raises.
do match? tree.nodes[id]
    | .node-stream-transform(row)
        = row.pattern == 0 || !tree.lazies-only(row.right)
    | .node-stream-panic
        = false
= true

────────────────────
_ do lowered-part SyntaxId
    - id SyntaxId

` The part the reference takes for a part of a pattern: the one that a part that only declares
` lazy locals is around.
do match? tree.nodes[id]
    | .node-stream-transform(row)
        if row.pattern != 0 && tree.lazies-only(row.right)
            = lowered-part(row.pattern)
= id

────────────────────
_ do rewind-literals
    - site SyntaxId
    - cursor Operand

` Tells the helper that observes literal words to forget those it was told of that end past a
` cursor.
. row = facts.observer-bodies[streaming.observer-row]
call-protocol(site, row.rewind, streaming.pattern-helper, streaming.pattern-helper-type, cursor, types.index-type)

────────────────────
_ do record-literals
    - run StreamRun
    - site SyntaxId
    - text String
    - cursor Operand

` Tells the helper that observes literal words of each word of lowercase letters in a text the
` pattern matched from a cursor, by where it starts and ends in the input, as the reference finds
` them: a letter, then letters and hyphens, where no letter is uppercase. The items a repeat
` scans, and alternatives the reference tests as one item, are no literals there. Where the
` buffer is UTF-8, where a word lies counts the bytes of the characters before it.
if streaming.observer-row == U32.max || scanning || streaming.classing
    =
. row = facts.observer-bodies[streaming.observer-row]
. points = text.codepoints
. offsets [U64]
. offset U64
for point in points
    offsets += offset
    offset += if encodes(run) then utf8-width(point) else 1
offsets += offset
. index Size = 0
while index < points.size
    if !is-word-letter(points[index])
        index += 1
        continue
    . lowercase = is-lowercase-letter(points[index])
    . end = index + 1
    while end < points.size && (is-word-letter(points[end]) || points[end] == '-')
        if is-word-letter(points[end]) && !is-lowercase-letter(points[end])
            lowercase = false
        end += 1
    if lowercase
        . start-at = stream-advance(run, site, cursor, offsets[index])
        . end-at = stream-advance(run, site, cursor, offsets[end])
        call-protocol
            - site
            - row.record
            - streaming.pattern-helper
            - streaming.pattern-helper-type
            - start-at
            - types.index-type
            - true
            - end-at
            - types.index-type
    index = end

────────────────────
_ utf8-width U64
    - point Char

` The count of bytes UTF-8 writes a character in.
|? (point as U32) < 0x80: 1
|? (point as U32) < 0x800: 2
|? (point as U32) < 0x10000: 3
??: 4

────────────────────
_ is-word-letter Bool
    - point Char

(point >= 'A' && point <= 'Z') || is-lowercase-letter(point)

────────────────────
_ is-lowercase-letter Bool
    - point Char

point >= 'a' && point <= 'z'

────────────────────
_ do stream-call StreamPart ?! Refused
    - run StreamRun
    - id SyntaxId
    - cursor Operand
    - failed IRBlockId

` A call of a local rule, run where it is called, as the reference runs one: its arms are
` tried in turn from the cursor, as the arms of a match are but with no need to read the
` whole input, and the first that passes gives the call what it gave and where it ended.
` Where none passes, the call fails. The names the rule captures have their places while its
` arms are emitted. It keeps the farthest cursor a part of it failed at from the cursor it is
` called at, as the reference's call of it does, and the pattern then counts that as its own.
` A rule a module declares is called, but for one `inlined-rule` finds, which runs where it is
` called as `inline-rule-call` says; so is a function given the stream that is no rule,
` as `boundary-call` says, and a local rule the tables made a function of; one whose body is
` code runs it as `coded-call` says; one beside a match that calls itself runs where it is
` called, and a call of it from its own arms is as `adapter-call` says;
` one that calls itself and has none is refused. A call given collectors gives no value: one
` that runs the rule where it is called runs it with the lists the caller keeps for its names
` in place of the rule's own, cut back to what they held where the rule fails, and one of a
` function calls the function made for those collectors. Nor does one the type pass planned to
` give the text it matched. One run where it is called begins holding no rollback mark, as
` `enter-marks` says, and gives back the one it holds where it fails. Under a helper that
` observes literal words, it tells it of them only where `observes-literals` says its pattern
` holds any.
. pattern = rule-pattern(id)
. result = facts.node-type(unit.reading, id)
if result == no-type || result == invalid-type
    refuse(.refused-expression, id)
    = bare-part(cursor)
if facts.plan-of(unit.reading, id) == .plan-pattern-call
    = pattern-call(run, id, id, cursor, failed)
. mappings = RowRange'SyntaxId()
do match? tree.nodes[id]
    | .node-stream-call(row)
        mappings = row.collector-mappings
. mapped = mappings.count != 0
. spanned = facts.plan-of(unit.reading, id) == .plan-span-call
. coded = coded-rule(id)
if coded != 0
    if mapped || spanned
        refuse(.refused-expression, id)
        = bare-part(cursor)
    = coded-call(run, id, coded, result, cursor, failed)
if pattern == 0 && !mapped && next-call(facts.first-call(unit.reading, id)) != no-fact
    = boundary-call(run, id, result, cursor, failed)
if pattern == 0 && !mapped
    . inlined = inlined-rule(run, id, result, spanned)
    if inlined.pattern != 0
        = inline-rule-call(run, id, inlined, cursor, failed, spanned)
if pattern == 0
    = rule-call(run, id, result, cursor, failed, mappings, spanned)
. declaration = rule-declaration(id)
. adapter = tables.rule-adapter-of(unit.reading, declaration)
if adapter != no-function && inlining.find(declaration) != null
    if mapped || spanned
        refuse(.refused-expression, id)
        = bare-part(cursor)
    = adapter-call(run, id, adapter, declaration, result, cursor, failed)
. helper = if adapter == no-function then tables.lazy-rule-of(unit.reading, declaration) else no-function
if helper != no-function && mapped
    . variant = tables.mapped-rule-of(unit.reading, declaration, tables.mapping-names(tree, mappings))
    if variant == no-function
        refuse(.refused-expression, id)
        = bare-part(cursor)
    = lazy-rule-call(run, id, variant, facts.node-type(unit.reading, pattern), cursor, failed, mappings)
if helper != no-function
    = lazy-rule-call(run, id, helper, result, cursor, failed, mappings, spanned)
if facts.is-recursive-rule(unit.reading, declaration) && adapter == no-function
    refuse(.refused-expression, id)
    = bare-part(cursor)
if mapped || spanned
    result = facts.node-type(unit.reading, pattern)
. layout = layout-of(result, id)
. end = ir.add-local(run.index-layout)
. joined = ir.reserve-block()
. slot = join-slot(layout)
. mark = joins.length
. held = bound.length
. captured = stream-captures.length
. outer = load-local(run.error, id)
store-local(run.error, cursor, id)
. missed = ir.reserve-block()
. marks = borrow-levels(id, mappings)
. entered = enter-marks(id)
. own-streaming = streaming
streaming = streaming.capture-floor = captured as U32
hold-captures(run, pattern)
streaming = own-streaming
borrows.clear()
plan-choices(pattern)
inlining += declaration
if !observes-literals(tree, facts, unit.reading, pattern)
    streaming = streaming.observer-row = U32.max
. arrives = emit-stream-arms(run, pattern, result, cursor, false, end, joined, slot, missed, mapped || spanned)
streaming = own-streaming
stop-inlining(declaration)
drop-bound(held)
drop-captures(captured)
if !arrives
    drop-joins(mark)
    refuse(.refused-expression, id)
    = bare-part(cursor)
ir.start-block(missed)
rewind-levels(marks, id)
fail-marks(entered, id)
record-error(run, id, outer)
jump(failed)
. value = close-joins(joined, mark, layout, slot)
pass-marks(entered, id)
record-error(run, id, outer)
. ending = load-local(end, id)
if mapped || spanned
    = StreamPart(ending, spanned-value(run, id, spanned, cursor, ending))
= StreamPart(ending, Typed(value, result))

────────────────────
_ inlined-rule RuleTarget
    - run StreamRun
    - id SyntaxId
    - result TypeId
    - spanned Bool

` The rule a module declares that a call runs where it is called, with the module that declares
` it and the instance that reads it: one given only the stream, read through a view of items of
` the type the pattern reads, that raises no errors, takes no helper and holds no rollback mark,
` whose pattern is plain as `plain-part` says, and whose arms join as the type the call gives
` where the call gives what they give. No pattern for any other call.
|? fact == no-fact || callee == no-instance || row.is-partial || row.fills.count != 1
    none
|? signature.args.count != 1 || signature.errors.count != 0 || instances.rows[callee].helper != no-type || instances.rows[callee].carries-mark || !types.is-optional(signature.returns)
    none
|? !spanned && types.optional-inner(signature.returns) != result
    none
|? target.pattern == 0 || target.owner != callee || !plain-part(program.modules[target.module].tree, target.pattern)
    none
|? buffer == no-type || class-arg(types, buffer, 0) != class-arg(types, run.buffer-type, 0)
    none
??
    target

.. none = RuleTarget(unit.source-module, unit.reading, 0)
.. fact = own-call(id)
.. row = facts.calls[fact]
.. callee = row.callee
.. signature = instances.signatures[callee]
.. target = rule-target(unit.source-module, unit.reading, id)
.. buffer = rule-buffer(callee)

────────────────────
_ do rule-buffer TypeId
    - rule InstanceId

` The buffer of the view a rule a module declares reads its stream through, as the type pass
` recorded it at the rule's declaration.
do match? program.modules[instances.rows[rule].module].decls[instances.rows[rule].decl]
    | .decl-function(fn)
        = facts.node-type(rule, fn.syntax)
= no-type

────────────────────
_ do plain-part Bool
    - syntax AST
    - id SyntaxId

` Whether a part of a pattern reads only the items it matches and gives only the text it
` matched: text, ranges and any item, and sequences, choices, optionals, repeats with written
` bounds and lookaheads of those.
do match? syntax.nodes[id]
    | .node-stream-string
        = true
    | .node-stream-any
        = true
    | .node-stream-char-range
        = true
    | .node-stream-and(row)
        = plain-part(syntax, row.left) && plain-part(syntax, row.right)
    | .node-stream-or(row)
        = plain-part(syntax, row.left) && plain-part(syntax, row.right)
    | .node-stream-unary(row)
        . plain-op = may-skip || row.op == .one-or-more-op || positive-look || negative-look
            .. may-skip = row.op == .zero-or-one-op || row.op == .zero-or-more-op
            .. positive-look = row.op == .positive-lookahead-op
            .. negative-look = row.op == .negative-lookahead-op
        = plain-op && plain-part(syntax, row.operand)
    | .node-stream-length(row)
        = literal-bound(syntax, row.min) && literal-max && plain-part(syntax, row.operand)
            .. literal-max = row.max == 0 || literal-bound(syntax, row.max)
= false

────────────────────
_ do inline-rule-call StreamPart
    - run StreamRun
    - id SyntaxId
    - target RuleTarget
    - cursor Operand
    - failed IRBlockId
    - spanned Bool

` A call of a rule a module declares that `inlined-rule` found, run where it is called as a
` local rule is: its arms are tried in turn from the cursor, read with the syntax of the module
` that declares it and the facts of the instance that reads it, under no helper and holding no
` rollback mark, as its function tries them. The first that passes gives the call what it gave
` and where it ended; where none passes, the call fails. It keeps the farthest cursor a part of
` it failed at from the cursor it is called at, as its function does, and the pattern counts
` that and how far it read as its own. A call `spanned` gives the text it matched, as
` `spanned-value` says.
. result = types.optional-inner(instances.signatures[target.owner].returns)
. layout = layout-of(result, id)
. end = ir.add-local(run.index-layout)
. joined = ir.reserve-block()
. slot = join-slot(layout)
. mark = joins.length
. outer = load-local(run.error, id)
store-local(run.error, cursor, id)
. missed = ir.reserve-block()
. own-unit = unit
. own-streaming = streaming
unit = unit.source-module = target.module
unit = unit.reading = target.owner
streaming = streaming.observer-row = U32.max
streaming = streaming.rollback-mark = no-local
streaming = streaming.rollback-row = U32.max
plan-choices(target.pattern)
. arrives = emit-stream-arms(run, target.pattern, result, cursor, false, end, joined, slot, missed, spanned)
unit = own-unit
streaming = own-streaming
if !arrives
    drop-joins(mark)
    refuse(.refused-expression, id)
    = bare-part(cursor)
ir.start-block(missed)
record-error(run, id, outer)
jump(failed)
. value = close-joins(joined, mark, layout, slot)
record-error(run, id, outer)
. ending = load-local(end, id)
if spanned
    = StreamPart(ending, spanned-value(run, id, true, cursor, ending))
= StreamPart(ending, Typed(value, result))

────────────────────
_ do spanned-value Typed
    - run StreamRun
    - id SyntaxId
    - spanned Bool
    - begun Operand
    - ending Operand

` The value of a call that gives no value of its own: none, or for one the type pass planned to
` give its text that its arm gives as another type, what the helper makes of that text, held
` in an optional where the call is typed as one. A call that gives text leaves its text to
` what holds it, which may be its arm, at the same node.
. stated = facts.node-type(unit.reading, id)
. made = if spanned && stated != types.string-type then material-at(id, .material-text) else U32.max
if made == U32.max
    = Typed(make-operand(.operand-void, 0), no-type)
. captured = material-capture(run, id, made, begun, ending)
if stated != captured.type
    = wrap(id, captured, stated)
= captured

────────────────────
_ do accumulator-level U32
    - name String

` The list the pattern being emitted keeps for a name it accumulates, or none.
. level = U32.max
for capture in stream-captures
    if capture.accumulates && identifier-name(tree, capture.site)!.text == name
        level = capture.levels
= level

────────────────────
_ do borrow-levels [LevelMark]
    - id SyntaxId
    - mappings RowRange'SyntaxId

` Lends a rule a call runs the lists of the caller's names its collectors map, each to the
` rule's name it is given for, and keeps how many items each holds as the rule begins.
. marks [LevelMark]
for mapping in tree.children[mappings]
    do match? tree.nodes[mapping]
        | .node-stream-collector-mapping(row)
            . callee = if row.callee then row.callee.text else row.caller.text
            . level = accumulator-level(row.caller.text)
            if level == U32.max
                refuse(.refused-expression, mapping)
                = marks
            borrows += Borrow(callee, level)
            . mark = ir.add-local(u64-layout)
            store-local(mark, load-local(capture-levels[level].size, id), id)
            marks += LevelMark(level, mark)
= marks

────────────────────
_ do rule-call StreamPart
    - run StreamRun
    - id SyntaxId
    - result TypeId
    - cursor Operand
    - failed IRBlockId
    - mappings RowRange'SyntaxId = RowRange'SyntaxId()
    - spanned Bool = false

` A call of a rule a module declares: its function is given the stream, converted to a
` `TokenStream` of its items, the arguments written, each converted as the type pass recorded,
` the address the stream's items start at, the cursor and the count of items, and where to
` keep where it ended, how far it read and the farthest cursor a part of it failed at, which
` the pattern then counts as its own. Where the rule passed, the call gives what it gave and
` goes on where it ended; where not, the call fails. An error the rule raises leaves the
` function with the call. A rule made into several functions, whose names a panic or an error
` would show, is called only where it can do neither. A call that gives the rule a pattern
` whose function may raise errors calls the function made for such a pattern, as
` `emit-raising-rule` says, and an error it answers with leaves the function with the call.
` A call given collectors calls the
` function made for them, lending it the caller's lists, and gives no value, as does one
` `spanned`, which gives the text it matched, but as `spanned-value` says, and calls the function
` made for calls that give no collectors where the tables made one. A rule typed for
` the helper the pattern runs under is given it, and one whose pattern holds a rollback mark
` gives it, which the pattern holds where it held none. The names its arguments read that the
` helper makes are made first, as the type pass recorded them at the call.
. nothing = make-operand(.operand-void, 0)
. fact = own-call(id)
. written = RowRange'SyntaxId()
do match? tree.nodes[id]
    | .node-stream-call(row)
        written = row.args
if fact == no-fact
    refuse(.refused-expression, id)
    = bare-part(cursor)
. row = facts.calls[fact]
. callee = row.callee
if callee == no-instance || row.is-partial || row.fills.count != written.count + 1 || other-arity
    refuse(.refused-expression, id)
    = bare-part(cursor)
.. other-arity = instances.signatures[callee].args.count != row.fills.count
. mapped = mappings.count != 0
. target = tables.instance-functions[callee]
. varied = mapped
if mapped
    target = tables.mapped-rule-of(callee, 0, tables.mapping-names(tree, mappings))
    if !lends-alike(callee, mappings)
        refuse(.refused-expression, id)
        = bare-part(cursor)
else if spanned && tables.mapped-rule-of(callee, 0, no-string) != no-function
    target = tables.mapped-rule-of(callee, 0, no-string)
    varied = true
. carried = no-type
for position in 0 .. < written.count
    . argument = tree.children[written.start + position]
    . expression = argument
    do match? tree.nodes[argument]
        | .node-argument(named)
            expression = named.expr
    if tree.nodes[expression] is .node-stream-match
        . raised = tables.pattern-raises(unit.reading, expression)
        if raised != no-type && carried != no-type
            refuse(.refused-expression, id)
            = bare-part(cursor)
        if raised != no-type
            carried = raised
if carried != no-type
    target = tables.raising-rule-of(callee, 0, carried)
    if mapped || instances.signatures[callee].errors.count != 0
        refuse(.refused-expression, id)
        = bare-part(cursor)
if target == no-function
    refuse(.refused-expression, id)
    = bare-part(cursor)
for position in 0 .. < row.fills.count
    if facts.call-fills[row.fills.start + position] as U32 != position
        refuse(.refused-expression, id)
        = bare-part(cursor)
. named = bound.length
bind-materials(run, id)
. stream = convert(id, .reason-argument, Typed(run.stream, run.stream-type))
if stream.type != instances.argument-type(callee, 0)
    refuse(.refused-conversion, id)
. mark = pending.length
pending += stream.operand
for position in 0 .. < written.count
    . argument = tree.children[written.start + position]
    . expression = argument
    do match? tree.nodes[argument]
        | .node-argument(named)
            expression = named.expr
    . given = if tree.nodes[expression] is .node-stream-match then pattern-value(expression) else emit-expression(expression)
    . value = convert(argument, .reason-argument, given)
    if value.type != instances.argument-type(callee, position + 1)
        refuse(.refused-conversion, argument)
    pending += value.operand
drop-bound(named)
. ended = ir.add-local(run.index-layout, true, true)
. reached = ir.add-local(run.index-layout, true, true)
. erred = ir.add-local(run.index-layout, true, true)
pending += run-data(run, id)
pending += cursor
pending += run-length(run, id)
pending += make-operand
    - .operand-value
    - append(.op-local-address, id, Span(), ended, pointer-layout)
pending += make-operand
    - .operand-value
    - append(.op-local-address, id, Span(), reached, pointer-layout)
pending += make-operand
    - .operand-value
    - append(.op-local-address, id, Span(), erred, pointer-layout)
. helped = instances.rows[callee].helper
if helped != no-type
    if helped != streaming.pattern-helper-type
        refuse(.refused-expression, id)
        drop-pending(mark)
        = bare-part(cursor)
    pending += streaming.pattern-helper
. given-mark = lend-mark(callee, id)
. lendings = lend-collectors(id, mappings)
. raising = instances.signatures[callee].errors.count != 0
if raising && !row.propagates
    refuse(.refused-expression, id)
    drop-pending(mark)
    = bare-part(cursor)
calls-rule = true
takes-result = raising
. carries = if carried != no-type then rule-result else no-type
    .. rule-result = facts.raising-rules[tables.functions[target].place].result
. answer = call-instance
    - callee
    - id
    - mark
    - false
    - false
    - if varied || carried != no-type then target else no-function
    - carries
takes-result = false
if raising
    answer = propagate(id, callee, answer.operand)
if carried != no-type
    answer = propagate-held(id, carries, answer.operand)
. answer-type = answer.type
reclaim-collectors(lendings, id)
record-call-extent(run, id, load-local(reached, id))
record-error(run, id, load-local(erred, id))
. flag = present(id, Typed(answer.operand, answer-type))
. passed = ir.reserve-block()
branch(flag.operand, passed, failed)
ir.start-block(passed)
take-mark(given-mark, id)
if mapped || spanned
    . ending = load-local(ended, id)
    = StreamPart(ending, spanned-value(run, id, spanned, cursor, ending))
. value = payload(id, Typed(answer.operand, answer-type))
if value.type != result
    refuse(.refused-type, id)
    = bare-part(cursor)
= StreamPart(load-local(ended, id), Typed(value.operand, result))

────────────────────
_ do adapter-call StreamPart
    - run StreamRun
    - id SyntaxId
    - adapter FunctionId
    - rule SyntaxId
    - result TypeId
    - cursor Operand
    - failed IRBlockId

` A call of a local rule beside a match from the rule's own arms, as the reference makes it:
` of the function it makes of the rule, as it calls a function given the stream. The stream
` is told the pattern stands at the cursor, the function is given the stream, and the pattern
` takes what it answered as `boundary-answer` says; an error it raises leaves the function
` with the call. The reference makes the function at the
` first such call, inside the run of the rule the call is in, and with it forgets that the
` rule is being run: a later call from the arms of that run runs the rule where it is called
` once more. So the first call here, outside the rule's own function, ends that run's hold on
` the rule; one made while another rule is being run, or in a function made of a rule or an
` action, is refused, since what the reference forgets there is not followed.
. commit = facts.first-call(unit.reading, id)
. viewed = next-call(commit)
. place = facts.local-rule-of(unit.reading, rule)
. answered = if place != U32.max then facts.local-rules[place].adapted else no-type
. target = tables.functions[adapter]
if unviewed || answered == no-type || unit.reading != unit.instance || other-rule-stream
    refuse(.refused-expression, id)
    = bare-part(cursor)
.. unviewed = commit == no-fact || viewed == no-fact || next-call(viewed) != no-fact
.. other-rule-stream = run.stream-type != facts.local-rules[place].stream
. own = function.kind == .lazy-rule && function.place == rule
if !own && adapted.find(rule) == null
    for position in 0 .. < inlining.length
        if inlining[position] != rule
            refuse(.refused-expression, id)
            = bare-part(cursor)
    if lazy-or-mapped || raising-or-helper || cast-or-action
        refuse(.refused-expression, id)
        = bare-part(cursor)
    .. lazy-or-mapped = function.kind == .lazy-rule || function.kind == .mapped-rule
    .. raising-or-helper = function.kind == .raising-rule || function.kind == .pattern-helper
    .. cast-or-action = function.kind == .pattern-cast || function.kind == .stream-action
    adapted += rule
    stop-inlining(rule)
call-protocol
    - id
    - commit
    - run.stream
    - run.stream-type
    - cursor
    - types.index-type
    - true
    - cursor
    - types.index-type
. raising = instances.signatures[unit.instance].errors.count != 0
. returned = if raising then facts.local-rules[place].relayed else answered
if returned == no-type || (raising && in-zone)
    refuse(.refused-expression, id)
. returns = layout-of(returned, id)
. mark = pending.length
pending += run.stream
ir.depend(.callee-function, adapter, if target.may-panic then may-panic-dependency else 0u32)
. enters = is-free(unit.instance)
. crosses = enters != in-zone
. checked = target.may-panic && !in-landing
. closing = closing-pad(checked && crosses && enters)
if crosses
    cross-zone(id, enters)
. answer = call
    - make-operand(.operand-symbol, target.symbol)
    - id
    - mark
    - .callee-function
    - returns
    - checked
    - false
    - closing
cross-back(id, enters, raising)
land-closed(closing, id)
if raising
    answer = propagate-held(id, returned, answer).operand
= boundary-answer(run, id, viewed, Typed(answer, answered), result, cursor, failed)

────────────────────
_ do emit-rule-adapter
    - rule SyntaxId

` The function a call of a local rule beside a match from the rule's own arms calls, as the
` reference makes one of the rule: given the stream, it runs the rule's own function on the
` stream's view as `attempt-arms` runs a pattern on a stream a match is given, and answers an
` optional `CaptureResult` of the items the rule read and what it gave, which holds nothing
` where the rule failed. Its call of the rule's function is written where the rule is named.
` In an instance that raises errors it answers that or one of them, as the rule's function
` does.
. nothing = make-operand(.operand-void, 0)
. matched SyntaxId = 0
. named SyntaxId = 0
do match? tree.nodes[rule]
    | .node-declare(declaration)
        matched = declaration.right
        named = declaration.left
. pattern SyntaxId = 0
do match? tree.nodes[matched]
    | .node-stream-match(row)
        pattern = row.pattern
. place = facts.local-rule-of(unit.instance, rule)
. direct = tables.lazy-rule-of(unit.instance, rule)
if pattern == 0 || place == U32.max || direct == no-function
    refuse(.refused-function, rule)
    =
. local = facts.local-rules[place]
. result = facts.node-type(unit.reading, matched)
. type = local.adapted
if result == no-type || type == no-type || local.stream == no-type || !types.is-optional(type)
    refuse(.refused-function, rule)
    =
. captured = types.optional-inner(type)
. layout = layout-of(type, rule)
. captured-layout = layout-of(captured, rule)
ir.add-argument(layout-of(local.stream, rule))
returns-type = type
ir.returns = layout-of(type, rule)
if instances.signatures[unit.instance].errors.count != 0
    return-results(local.relayed, rule)
. viewed = facts.first-call(unit.reading, matched)
. commits = next-call(viewed)
. extends = next-call(commits)
if commits == no-fact || next-call(extends) != no-fact
    refuse(.refused-function, rule)
    =
if !tables.layouts.is-struct(captured-layout) || unpaired-capture
    refuse(.refused-type, rule)
    =
.. unpaired-capture = tables.layouts.rows[captured-layout].fields.count != 2
. run = view-stream
    - matched
    - make-operand(.operand-argument, 0)
    - local.stream
    - true
    - viewed
    - extends
. failed = ir.reserve-block()
adapting = direct
. given = attempt-arms(named, pattern, result, run, false, commits, failed, false)
adapting = no-function
. items-field = tables.layouts.field(captured-layout, 0)
. result-field = tables.layouts.field(captured-layout, 1)
if other-buffer || result-field.layout != layout-of(result, rule)
    refuse(.refused-type, rule)
.. other-buffer = items-field.layout != run.buffer-layout
. items = stream-slice(run, rule, run.start, load-local(attempt-end, rule))
. made = frame(captured-layout)
put(made, items-field, items.operand, rule)
put(made, result-field, given.operand, rule)
. wrapped = wrap(rule, Typed(made, captured), type)
return-value(wrapped.operand, rule)
ir.start-block(failed)
return-value(empty-optional(type, layout).operand, rule)

────────────────────
_ do adapt-arms Bool
    - run StreamRun
    - site SyntaxId
    - result TypeId
    - end LocalId
    - joined IRBlockId
    - slot Operand
    - failed IRBlockId

` In place of the arms of a pattern, one call of the function a local rule's arms run in, from
` where the pattern starts: where it passed it gives what it gave and ends where it ended,
` and where not the pattern fails.
. called = lazy-rule-call(run, site, adapting, result, run.start, failed)
store-local(end, called.ending, site)
arrive(site, called.value.operand, joined, slot)
= true

────────────────────
_ do coded-rule SyntaxId
    - call SyntaxId

` The code of the local rule a call names whose body is code that runs patterns rather than a
` pattern, as the binder resolved the call, or none.
do match? tree.nodes[rule-declaration(call)]
    | .node-declare(declaration)
        if declaration.is-pattern && declaration.right != 0 && !right-matches
            = declaration.right
        .. right-matches = tree.nodes[declaration.right] is .node-stream-match
= 0

────────────────────
_ do coded-call StreamPart
    - run StreamRun
    - id SyntaxId
    - code SyntaxId
    - result TypeId
    - cursor Operand
    - failed IRBlockId

` A call of a local rule whose body is code, as the reference calls the function it makes of
` it between the parts of a pattern: the stream is told the pattern stands at the cursor, then
` the code runs, each pattern in it on the stream from where the stream stands, and the
` pattern takes what it gave as `boundary-answer` says. The reference's function holds the
` names the code reads; here the code runs where it is called, where they are. A rule whose
` code calls it is refused.
. commit = facts.first-call(unit.reading, id)
. viewed = next-call(commit)
if commit == no-fact || viewed == no-fact || next-call(viewed) != no-fact || coded-already
    refuse(.refused-expression, id)
    = bare-part(cursor)
.. coded-already = coded.find(code) != null
call-protocol
    - id
    - commit
    - run.stream
    - run.stream-type
    - cursor
    - types.index-type
    - true
    - cursor
    - types.index-type
. own-streaming = streaming
streaming = streaming.given-stream = run.stream
streaming = streaming.given-stream-type = run.stream-type
coded += code
. answer = emit-expression(code)
coded.pop()
streaming = own-streaming
= boundary-answer(run, id, viewed, answer, result, cursor, failed)

────────────────────
_ do boundary-call StreamPart
    - run StreamRun
    - id SyntaxId
    - result TypeId
    - cursor Operand
    - failed IRBlockId

` A call of a function given the stream that is no rule, as the reference makes one between
` the parts of a pattern: the stream is told the pattern stands at the cursor, then the
` function is given the stream, converted as the type pass recorded, and the arguments
` written, and reads from the stream itself. The stream's view, asked for after, says where
` the function left it and how far it read, which the pattern counts as its own. Where the
` function gave a value the call gives it, as `boundary-answer` says, and goes on where the
` stream stands; where it gave none, the call fails. The rest of the attempt reads the buffer
` it read before, as the reference's does.
. nothing = make-operand(.operand-void, 0)
. fact = facts.first-call(unit.reading, id)
. commit = next-call(fact)
. viewed = next-call(commit)
. written = RowRange'SyntaxId()
do match? tree.nodes[id]
    | .node-stream-call(row)
        written = row.args
if fact == no-fact || commit == no-fact || viewed == no-fact || next-call(viewed) != no-fact
    refuse(.refused-expression, id)
    = bare-part(cursor)
. row = facts.calls[fact]
. callee = row.callee
if callee == no-instance || !is-callable(callee) || misfilled || other-arity || callee-raises
    refuse(.refused-expression, id)
    = bare-part(cursor)
.. misfilled = row.is-partial || row.fills.count != written.count + 1
.. other-arity = instances.signatures[callee].args.count != row.fills.count
.. callee-raises = instances.signatures[callee].errors.count != 0
for position in 0 .. < row.fills.count
    if facts.call-fills[row.fills.start + position] as U32 != position
        refuse(.refused-expression, id)
        = bare-part(cursor)
call-protocol
    - id
    - commit
    - run.stream
    - run.stream-type
    - cursor
    - types.index-type
    - true
    - cursor
    - types.index-type
. stream = convert(id, .reason-argument, Typed(run.stream, run.stream-type))
if stream.type != instances.argument-type(callee, 0)
    refuse(.refused-conversion, id)
. mark = pending.length
pending += stream.operand
for position in 0 .. < written.count
    . argument = tree.children[written.start + position]
    . expression = argument
    do match? tree.nodes[argument]
        | .node-argument(named)
            expression = named.expr
    . value = convert(argument, .reason-argument, emit-expression(expression))
    if value.type != instances.argument-type(callee, position + 1)
        refuse(.refused-conversion, argument)
    pending += value.operand
. answer = call-instance(callee, id, mark)
= boundary-answer(run, id, viewed, answer, result, cursor, failed)

────────────────────
_ do boundary-answer StreamPart
    - run StreamRun
    - id SyntaxId
    - viewed FactId
    - answer Typed
    - result TypeId
    - cursor Operand
    - failed IRBlockId

` What a pattern takes from code that read the stream itself, after it ran: the stream's view
` says where the code left it and how far it read, which the pattern counts as its own. Where
` the code gave a value the call gives it, or the result of a `CaptureResult` it gave, and
` goes on where the stream stands; where it gave none, the call fails.
. nothing = make-operand(.operand-void, 0)
. view = call-protocol(id, viewed, run.stream, run.stream-type, nothing)
if !types.is-optional(view.type)
    refuse(.refused-type, id)
    = bare-part(cursor)
. held = payload(id, view)
. tuple-layout = layout-of(held.type, id)
. reached = part(held.operand, tuple-layout, 1, id)
. probed = part(held.operand, tuple-layout, 3, id)
if run.kept-length != no-local
    keep-view(run, id, held.operand, tuple-layout)
record-extent(run, id, probed.operand)
record-error(run, id, reached.operand)
. value = answer
if types.is-optional(answer.type)
    . flag = present(id, value)
    . passed = ir.reserve-block()
    branch(flag.operand, passed, failed)
    ir.start-block(passed)
    value = payload(id, value)
if same-ref(class-ref(types, value.type), types.capture-result-decl)
    value = part(value.operand, layout-of(value.type, id), 1, id)
if value.type != result
    refuse(.refused-type, id)
    = bare-part(cursor)
= StreamPart(reached.operand, Typed(value.operand, result))

────────────────────
_ do rule-pattern SyntaxId
    - call SyntaxId

` The pattern of the local rule a call names, as the binder resolved the call.
do match? tree.nodes[rule-declaration(call)]
    | .node-declare(declaration)
        do match? tree.nodes[declaration.right]
            | .node-stream-match(rule)
                = rule.pattern
= 0

────────────────────
_ rule-declaration SyntaxId
    - call SyntaxId

` The declaration of the local rule a call names, as the binder resolved the call, or none.
|? resolution.kind != .resolve-slot
    0
|? row.kind != .slot-lazy
    0
??
    row.group

.. resolution = bindings.resolution-of(instances.rows[unit.reading].binding, call)
.. row = bindings.slots[resolution.slot]

────────────────────
_ do lazy-rule-call StreamPart
    - run StreamRun
    - id SyntaxId
    - helper FunctionId
    - result TypeId
    - cursor Operand
    - failed IRBlockId
    - mappings RowRange'SyntaxId = RowRange'SyntaxId()
    - spanned Bool = false

` A call of a local rule of a rule that runs as a function of its own: it is given the rule's
` stream and the arguments the rule was given, from the rule's function or another such, then
` the address the stream's items start at, the cursor and the count of items, and where to keep
` where it ended, how far it read and the farthest cursor a part of it failed at, which the
` pattern counts as its own. Where it passed, the call gives what it gave and goes on where it
` ended; where not, the call fails. An error it raises leaves the function with the call. A
` call given collectors lends the function the caller's lists, and gives no value, as does one
` `spanned`, which gives the text it matched, but as `spanned-value` says. One of a rule whose
` pattern holds a rollback mark gives it as a call of the rule does. In the function of a rule
` made for a pattern that may raise errors, the call is of the local rule's function made for
` it, whose errors leave the function with the call. The function of a local rule beside a
` match, which the function `emit-rule-adapter` makes calls, is given the stream alone before
` the address.
. called = helper
. target = tables.functions[called]
. place = facts.local-rule-of(unit.instance, tables.lazy-rule-decl(target))
. answer-type = if place != U32.max then facts.local-rules[place].answer else no-type
. signature = instances.signatures[unit.instance]
. raising = signature.errors.count != 0
. returned = if raising && place != U32.max then facts.local-rules[place].result else answer-type
if carried-given != no-type
    called = tables.raising-rule-of(unit.instance, tables.lazy-rule-decl(target), carried-given)
    if called == no-function || raising || mappings.count != 0 || target.kind != .lazy-rule
        refuse(.refused-expression, id)
        = bare-part(cursor)
    target = tables.functions[called]
    returned = facts.raising-rules[target.place].result
    raising = true
. helped = instances.rows[unit.instance].helper
. bare = tables.rule-adapter-of(unit.instance, tables.lazy-rule-decl(target)) != no-function
if bare
    if unanswerable || helped != no-type || mappings.count != 0 || spanned || other-rule-stream
        refuse(.refused-expression, id)
        = bare-part(cursor)
    .. unanswerable = answer-type == no-type || returned == no-type || (raising && in-zone)
    .. other-rule-stream = run.stream-type != facts.local-rules[place].stream
else if !rule-arguments || answerless || other-stream || (raising && in-zone) || other-helper
    refuse(.refused-expression, id)
    = bare-part(cursor)
.. answerless = answer-type == no-type || returned == no-type || signature.args.count == 0
.. other-stream = run.stream-type != instances.argument-type(unit.instance, 0)
.. other-helper = helped != no-type && streaming.pattern-helper-type != helped
. returns = layout-of(returned, id)
. ended = ir.add-local(run.index-layout, true, true)
. reached = ir.add-local(run.index-layout, true, true)
. erred = ir.add-local(run.index-layout, true, true)
. mark = pending.length
pending += run.stream
if !bare
    for position in 1 .. < signature.args.count
        pending += rule-argument(position, id)
pending += run-data(run, id)
pending += cursor
pending += run-length(run, id)
pending += make-operand
    - .operand-value
    - append(.op-local-address, id, Span(), ended, pointer-layout)
pending += make-operand
    - .operand-value
    - append(.op-local-address, id, Span(), reached, pointer-layout)
pending += make-operand
    - .operand-value
    - append(.op-local-address, id, Span(), erred, pointer-layout)
if helped != no-type
    pending += streaming.pattern-helper
. given-mark = lend-mark(unit.instance, id)
. lendings = lend-collectors(id, mappings)
ir.depend(.callee-function, called, if target.may-panic then may-panic-dependency else 0u32)
. enters = is-free(unit.instance)
. crosses = enters != in-zone
. checked = target.may-panic && !in-landing
. closing = closing-pad(checked && crosses && enters)
if crosses
    cross-zone(id, enters)
. answer = call
    - make-operand(.operand-symbol, target.symbol)
    - id
    - mark
    - .callee-function
    - returns
    - checked
    - false
    - closing
cross-back(id, enters, raising)
land-closed(closing, id)
if raising
    answer = propagate-held(id, returned, answer).operand
reclaim-collectors(lendings, id)
record-call-extent(run, id, load-local(reached, id))
record-error(run, id, load-local(erred, id))
. flag = present(id, Typed(answer, answer-type))
. passed = ir.reserve-block()
branch(flag.operand, passed, failed)
ir.start-block(passed)
take-mark(given-mark, id)
if mappings.count != 0 || spanned
    . ending = load-local(ended, id)
    = StreamPart(ending, spanned-value(run, id, spanned, cursor, ending))
. value = payload(id, Typed(answer, answer-type))
if value.type != result
    refuse(.refused-type, id)
    = bare-part(cursor)
= StreamPart(load-local(ended, id), Typed(value.operand, result))

────────────────────
_ do lend-collectors [Lending]
    - id SyntaxId
    - mappings RowRange'SyntaxId

` Lends a function a call runs the lists of the caller's names its collectors map, in the
` order written: each as a collector in memory of the frame, whose pointer is the next
` argument, holding the list's items and count, and the context its backing keeps them with.
. lendings [Lending]
for mapping in tree.children[mappings]
    do match? tree.nodes[mapping]
        | .node-stream-collector-mapping(row)
            . level = accumulator-level(row.caller.text)
            if level == U32.max
                refuse(.refused-expression, mapping)
                = lendings
            . held = capture-levels[level]
            . layout = layout-of(held.collector, id)
            . memory = frame(layout)
            zero(memory, layout)
            put(memory, tables.layouts.field(layout, 0), load-local(held.items, id), id)
            put(memory, tables.layouts.field(layout, 1), load-local(held.size, id), id)
            if held.context != no-local
                put(memory, tables.layouts.field(layout, 2), load-local(held.context, id), id)
            pending += address(memory, 0, pointer-layout, id)
            lendings += Lending(memory, level)
= lendings

────────────────────
_ do reclaim-collectors
    - lendings [Lending]
    - id SyntaxId

` Takes back into each list the caller keeps what the function a call ran left in the
` collector it was lent.
for lending in lendings
    . held = capture-levels[lending.level]
    . layout = layout-of(held.collector, id)
    store-local(held.items, take(lending.memory, tables.layouts.field(layout, 0), id), id)
    store-local(held.size, take(lending.memory, tables.layouts.field(layout, 1), id), id)

────────────────────
_ do lends-alike Bool
    - callee InstanceId
    - mappings RowRange'SyntaxId

` Whether each list of the caller's a call of a rule a module declares lends it is a list of
` what the rule's name it is given for accumulates, kept in a collector of the same type, as
` the type pass typed the rule.
. row = instances.rows[callee]
. source = program.modules[row.module].tree
. pattern SyntaxId = 0
do match? source.nodes[rule-match(program, row.module, row.decl)]
    | .node-stream-match(matched)
        pattern = matched.pattern
for mapping in tree.children[mappings]
    do match? tree.nodes[mapping]
        | .node-stream-collector-mapping(written)
            . name = if written.callee then written.callee.text else written.caller.text
            . level = accumulator-level(written.caller.text)
            . site = if pattern != 0 then accumulated-site(source, pattern, name) else 0
            if site == 0 || level == U32.max || list-differs || mismatched
                = false
            .. list-differs = facts.node-type(callee, site) != capture-levels[level].list
            .. mismatched = accumulated-collector(callee, site) != capture-levels[level].collector
= true

────────────────────
_ do accumulated-site SyntaxId
    - source AST
    - id SyntaxId
    - name String

` Where a pattern captures a name it accumulates in a part of its own, or none.
do match? source.nodes[id]
    | .node-stream-capture(row)
        . named = identifier-name(source, row.name)
        if row.accumulating && named && named.text == name
            = row.name
        = accumulated-site(source, row.pattern, name)
    | .node-stream-and(row)
        . left = accumulated-site(source, row.left, name)
        = if left != 0 then left else accumulated-site(source, row.right, name)
    | .node-stream-or(row)
        . left = accumulated-site(source, row.left, name)
        = if left != 0 then left else accumulated-site(source, row.right, name)
    | .node-stream-transform(row)
        if row.pattern != 0
            = accumulated-site(source, row.pattern, name)
    | .node-stream-panic(row)
        = accumulated-site(source, row.pattern, name)
    | .node-stream-unary(row)
        = accumulated-site(source, row.operand, name)
    | .node-stream-length(row)
        = accumulated-site(source, row.operand, name)
= 0

────────────────────
_ do accumulated-collector TypeId
    - owner InstanceId
    - site SyntaxId

` The collector an instance keeps the list of a name it accumulates in, by the call the type
` pass recorded at the name that grows it, after the one that makes its text where it has one.
. fact = facts.first-call(owner, site)
if fact != no-fact && facts.plan-of(owner, site) != .plan-stream-value
    fact = facts.calls[fact].next
if fact == no-fact || facts.calls[fact].callee == no-instance
    = no-type
= instances.rows[facts.calls[fact].callee].self-type

────────────────────
_ do hold-captures ?! Refused
    - run StreamRun
    - id SyntaxId
    - repeats U32 = 0

` Keeps a place for each name a stream pattern captures: the cursors its text begins and ends
` at, and for an optional name whether it holds any, which starts as none; or for a name that
` holds what a rule gave or an item a test passed, a local of its type, which for an optional
` name starts as nothing, or in repeats of what one pass captured; and for a name captured in
` repeats, the list each keeps. Each name is bound to its place
` while the arms are emitted. A name a rule's arms capture with different types has a place
` for each type, and one captured as text in one arm and as what a rule gave in another has a
` place for each. A rule run where it is called keeps places of its own, apart from those a
` run of it that this one is inside keeps.
do match? tree.nodes[id]
    | .node-stream-capture(row)
        . slot = captured-slot(row.name)
        if slot == no-slot
            refuse(.refused-expression, id)
            =
        if row.accumulating
            if !held-here(captured-at(slot))
                hold-accumulator(run, id, slot, row.name)
            hold-captures(run, row.pattern, repeats)
            =
        . valued = facts.plan-of(unit.reading, row.name) == .plan-stream-value
        if !held-here(captured-as(slot, facts.node-type(unit.reading, row.name), valued))
            . type = facts.node-type(unit.reading, row.name)
            . begin = ir.add-local(run.index-layout)
            . end = ir.add-local(run.index-layout)
            store-local(begin, run.start, id)
            store-local(end, run.start, id)
            . present = no-local
            . value = no-local
            if valued && repeats == 0
                . layout = layout-of(type, id)
                value = ir.add-local(layout)
                if types.is-optional(type)
                    store-local(value, empty-optional(type, layout).operand, id)
            else if !valued && types.is-optional(type) && repeats == 0
                present = ir.add-local(u8-layout)
                store-local(present, integer(.machine-u8, 0), id)
            . levels = capture-levels.length as U32
            bound += BoundValue
                - slot
                - type
                - make-operand(.operand-void, 0)
                - U32.max
                - stream-captures.length as U32
            stream-captures += StreamCapture
                - slot
                - row.name
                - begin
                - end
                - present
                - value
                - type
                - run
                - repeats
                - levels
            . held = (stream-captures.length - 1) as U32
            hold-levels(held, id)
            if valued && repeats != 0
                stream-captures[held] = stream-captures[held].value = ir.add-local(layout-of(capture-levels[levels].item, id))
        hold-captures(run, row.pattern, repeats)
    | .node-stream-and(row)
        hold-captures(run, row.left, repeats)
        hold-captures(run, row.right, repeats)
    | .node-stream-or(row)
        hold-captures(run, row.left, repeats)
        hold-captures(run, row.right, repeats)
    | .node-stream-transform(row)
        hold-captures(run, row.pattern, repeats)
    | .node-stream-panic(row)
        hold-captures(run, row.pattern, repeats)
    | .node-stream-unary(row)
        . repeat = row.op == .zero-or-more-op || row.op == .one-or-more-op
        hold-captures(run, row.operand, if repeat then repeats + 1 else repeats)
    | .node-stream-length(row)
        hold-captures(run, row.operand, repeats + 1)

────────────────────
_ held-here Bool
    - position U32

` Whether a place a name is kept in is one of the rule being run where it is called, and not
` one of a run this one is inside.
position != U32.max && position >= streaming.capture-floor

────────────────────
_ do stop-inlining
    - rule SyntaxId

` Ends the running of a local rule where it is called, as the reference ends it: the rule is
` no longer one being run, however many runs of it this one is inside.
. kept = 0
for position in 0 .. < inlining.length
    if inlining[position] != rule
        inlining[kept] = inlining[position]
        kept += 1
while inlining.length != kept
    inlining.pop()

────────────────────
_ do hold-accumulator
    - run StreamRun
    - id SyntaxId
    - slot SlotId
    - name SyntaxId

` Keeps the list a name that accumulates adds to, empty as the pattern starts, as the
` reference's collector starts, or the list of the caller's a call given a collector for the
` name `borrows`.
. type = facts.node-type(unit.reading, name)
. text = identifier-name(tree, name)!.text
for borrow in borrows
    if borrow.name == text
        if capture-levels[borrow.level].list != type
            refuse(.refused-expression, id)
            =
        bound += BoundValue
            - slot
            - type
            - make-operand(.operand-void, 0)
            - U32.max
            - stream-captures.length as U32
        stream-captures += StreamCapture
            - slot
            - name
            - no-local
            - no-local
            - no-local
            - no-local
            - type
            - run
            - 1
            - borrow.level
            - true
            - true
        =
. levels = capture-levels.length as U32
bound += BoundValue
    - slot
    - type
    - make-operand(.operand-void, 0)
    - U32.max
    - stream-captures.length as U32
stream-captures += StreamCapture
    - slot
    - name
    - no-local
    - no-local
    - no-local
    - no-local
    - type
    - run
    - 1
    - levels
    - true
hold-levels((stream-captures.length - 1) as U32, id)
. level = capture-levels[levels]
if lent-first != U32.max
    for position in 0 .. < collector-args.length
        if collector-args[position] == text
            . pointer = make-operand(.operand-argument, lent-first + (position as U32))
            . layout = layout-of(level.collector, id)
            store-local(level.items, take(pointer, tables.layouts.field(layout, 0), id), id)
            store-local(level.size, take(pointer, tables.layouts.field(layout, 1), id), id)
            if level.context != no-local
                store-local(level.context, take(pointer, tables.layouts.field(layout, 2), id), id)
            . mark = ir.add-local(u64-layout)
            store-local(mark, load-local(level.size, id), id)
            lent += LentCollector(lent-first + (position as U32), level, mark)
            =
start-level(level, id)

────────────────────
_ do hold-levels
    - held U32
    - site SyntaxId

` Keeps the list each repeat around a name keeps, from the innermost out, as the calls the type pass
` recorded at the name after the one that makes its text, if it has one, say: a collector of the
` text or of the item, then of the lists the repeat inside it made. Each list is the type of an item
` of the next, and the outermost is the name's type.
. capture = stream-captures[held]
if capture.listed == 0
    =
. growers [FactId]
. fact = facts.first-call(unit.reading, capture.site)
. valued = facts.plan-of(unit.reading, capture.site) == .plan-stream-value
for level in 0 .. < capture.listed
    if level != 0 || !valued
        fact = if fact != no-fact then facts.calls[fact].next else no-fact
    if fact == no-fact || facts.calls[fact].callee == no-instance
        refuse(.refused-expression, site)
        =
    growers += fact
for level in 0 .. < growers.length
    . callee = facts.calls[growers[level]].callee
    . collector = instances.rows[callee].self-type
    . outer = if level + 1 < growers.length then outer-collector else no-type
        .. outer-collector = instances.rows[facts.calls[growers[level + 1]].callee].self-type
    . ranged = material-at(capture.site, .material-ranges)
    . last = if ranged != U32.max then facts.materials[ranged].type else capture.type
    . list = if outer != no-type then class-arg(types, outer, 0) else last
    . items = ir.add-local(layout-of(instances.signatures[callee].returns, site))
    . size = ir.add-local(u64-layout)
    . context = context-local(collector, site)
    capture-levels += CaptureLevel
        - held
        - items
        - size
        - growers[level]
        - collector
        - class-arg(types, collector, 0)
        - list
        - context

────────────────────
_ do drop-captures
    - captured Size

` Drops the places of the names captured since a count of them, with their lists, but for
` the lists of callers they borrowed.
for position in captured .. < stream-captures.length
    if !stream-captures[position].borrowed
        . kept = stream-captures[position].levels as Size
        -= capture-levels[kept .. < capture-levels.length]
        break
-= stream-captures[captured .. < stream-captures.length]

────────────────────
_ captured-slot SlotId
    - name SyntaxId

if resolution.kind == .resolve-slot then resolution.slot else no-slot

.. resolution = bindings.resolution-of(instances.rows[unit.reading].binding, name)

────────────────────
_ do captured-as U32
    - slot SlotId
    - type TypeId
    - valued Bool

` The place the pattern keeps a name captured with a type in, as what a rule gave where
` `valued` and else as the text it matched, or `U32.max`.
. position = stream-captures.length
while position != 0
    position -= 1
    . place = stream-captures[position]
    if place.slot == slot && place.type == type && (place.value != no-local) == valued
        = position as U32
= U32.max

────────────────────
_ do activate-captures
    - arm SyntaxId

` Makes the places an arm keeps its names in the ones their slots read while the arm is
` emitted: where another arm of the rule captures a name with another type, or as what a
` rule gave where this one captures its text, or the other way, whose place the slot would
` read, the arm's own is put after it for as long as the arm is emitted. An arm whose
` alternatives capture one name both ways reads the place that keeps what a rule gave, as
` `stream-capture` says.
activate-kind(arm, false)
activate-kind(arm, true)

────────────────────
_ do activate-kind
    - arm SyntaxId
    - valued Bool

` Puts the places of the names an arm captures as what a rule gave, where `valued`, or as the
` text they matched, after the ones their slots would read.
for node in tree.subtree-start(arm) .. < arm + 1
    do match? tree.nodes[node]
        | .node-stream-capture(row)
            . slot = captured-slot(row.name)
            . type = facts.node-type(unit.reading, row.name)
            . held = if slot != no-slot then captured-at(slot) else U32.max
            if plan-matches && open-capture && (stream-captures[held].type != type || value-differs)
                . place = captured-as(slot, type, valued)
                if place == U32.max
                    refuse(.refused-expression, node)
                    =
                . kept = stream-captures[place]
                bound += BoundValue
                    - slot
                    - type
                    - make-operand(.operand-void, 0)
                    - U32.max
                    - stream-captures.length as U32
                stream-captures += StreamCapture
                    - kept.slot
                    - kept.site
                    - kept.begin
                    - kept.end
                    - kept.present
                    - kept.value
                    - kept.type
                    - kept.run
                    - kept.listed
                    - kept.levels
                    - kept.accumulates
                    - true
            .. plan-matches = (facts.plan-of(unit.reading, row.name) == .plan-stream-value) == valued
            .. open-capture = held != U32.max && !stream-captures[held].accumulates
            .. value-differs = (stream-captures[held].value != no-local) != valued

────────────────────
_ do captured-at U32
    - slot SlotId

. position = stream-captures.length
while position != 0
    position -= 1
    if stream-captures[position].slot == slot
        = position as U32
= U32.max

────────────────────
_ do stream-capture StreamPart
    - run StreamRun
    - id SyntaxId
    - name SyntaxId
    - pattern SyntaxId
    - cursor Operand
    - failed IRBlockId

` A part a name captures: where it passes, the name holds the text from the cursor to where
` it ended, or what a rule the part calls gave, held as an optional where the name is one. A
` name that captures an optional part holds nothing where the part's operand fails. A part
` the type pass recorded to make its text through the helper makes it where it passes, as
` `make-eager` says. A name another alternative of the arm captures as what a rule gave keeps
` its text in the same place, made where the part passes, as the reference makes it where the
` alternatives join; under a helper, or where the two are not one type, it is refused.
. held = captured-at(captured-slot(name))
if held == U32.max
    refuse(.refused-expression, id)
    = bare-part(cursor)
. capture = stream-captures[held]
if capture.accumulates
    = accumulate(run, id, name, pattern, capture, cursor, failed)
if capture.value != no-local && facts.plan-of(unit.reading, name) != .plan-stream-value
    if listed-or-helped || types.is-optional(capture.type) || retyped-or-partial
        refuse(.refused-expression, id)
        = bare-part(cursor)
    .. listed-or-helped = capture.listed != 0 || streaming.pattern-helper-type != no-type
    .. retyped-or-partial = facts.node-type(unit.reading, name) != capture.type || optional-part(pattern)
    . part = emit-stream-part(run, pattern, cursor, failed)
    . text = stream-text(run, name, cursor, part.ending)
    store-local(capture.value, text.operand, id)
    = part
if capture.value != no-local
    . part = emit-stream-part(run, pattern, cursor, failed)
    . given = part.value.operand
    . given-type = part.value.type
    if given-type == no-type
        refuse(.refused-expression, id)
        = bare-part(cursor)
    . kept = given
    . kept-type = if capture.listed != 0 then capture-levels[capture.levels].item else capture.type
    if given-type != kept-type
        if !types.is-optional(kept-type) || types.optional-inner(kept-type) != given-type
            refuse(.refused-expression, id)
            = bare-part(cursor)
        kept = wrap(id, Typed(given, given-type), kept-type).operand
    store-local(capture.value, kept, id)
    = part
do match? tree.nodes[pattern]
    | .node-stream-unary(row)
        if row.op == .zero-or-one-op && capture.present != no-local
            . joined = ir.reserve-block()
            . missed = ir.reserve-block()
            . mark = joins.length
            . marks = mark-levels(row.operand)
            . tried = emit-stream-part(run, row.operand, cursor, missed)
            . passed = tried.ending
            hold-text(capture, cursor, passed, id)
            make-eager(run, pattern, cursor, passed)
            arrive(id, passed, joined, make-operand(.operand-void, 0))
            ir.start-block(missed)
            rewind-levels(marks, id)
            clear-captures(row.operand, id)
            store-local(capture.present, integer(.machine-u8, 0), id)
            arrive(id, cursor, joined, make-operand(.operand-void, 0))
            = StreamPart(close-joins(joined, mark, run.index-layout, make-operand(.operand-void, 0)), tried.value)
. part = emit-stream-part(run, pattern, cursor, failed)
if optional-part(pattern) && material-at(pattern, .material-eager) != U32.max
    refuse(.refused-expression, id)
    = bare-part(cursor)
hold-text(capture, cursor, part.ending, id)
make-eager(run, pattern, cursor, part.ending)
= part

────────────────────
_ do optional-part Bool
    - id SyntaxId

` Whether a part of a stream pattern is an optional part.
do match? tree.nodes[id]
    | .node-stream-unary(row)
        = row.op == .zero-or-one-op
= false

────────────────────
_ do make-eager
    - run StreamRun
    - part SyntaxId
    - begun Operand
    - ending Operand

` Makes what the type pass recorded a part a name captures makes of the text it matched
` where it passes, by a capture materializer of the helper, as the reference makes it there.
` Nothing reads what it makes.
. eager = material-at(part, .material-eager)
if eager != U32.max
    material-capture(run, part, eager, begun, ending)

────────────────────
_ do accumulate StreamPart
    - run StreamRun
    - id SyntaxId
    - name SyntaxId
    - pattern SyntaxId
    - capture StreamCapture
    - cursor Operand
    - failed IRBlockId

` A part whose name accumulates: where it passes, its list gains the text it matched, made
` then, or what a rule it calls gave. The part gives what its own part gives. One the type
` pass recorded to make its text through the helper makes it too, as `make-eager` says.
. part = emit-stream-part(run, pattern, cursor, failed)
make-eager(run, pattern, cursor, part.ending)
. element = part.value
if facts.plan-of(unit.reading, name) != .plan-stream-value
    element = stream-text(run, name, cursor, part.ending)
else if part.value.type == no-type
    refuse(.refused-expression, id)
append-level(capture-levels[capture.levels], element, name)
= part

────────────────────
_ do mark-levels [LevelMark]
    - id SyntaxId

` Keeps how many items each list of a name that accumulates in a part of a pattern holds
` where the part begins, and each list of the caller's a call in it is given a collector for.
. marks [LevelMark]
mark-levels-in(id, marks)
for position in 0 .. < marks.length
    . level = capture-levels[marks[position].level]
    . mark = ir.add-local(u64-layout)
    store-local(mark, load-local(level.size, id), id)
    marks[position] = marks[position].mark = mark
= marks

────────────────────
_ do mark-levels-in
    - id SyntaxId
    - marks [LevelMark]

do match? tree.nodes[id]
    | .node-stream-capture(row)
        . held = captured-at(captured-slot(row.name))
        if held != U32.max && stream-captures[held].accumulates
            . level = stream-captures[held].levels
            . found = false
            for mark in marks
                found = found || mark.level == level
            if !found
                marks += LevelMark(level, no-local)
        mark-levels-in(row.pattern, marks)
    | .node-stream-call(row)
        for mapping in tree.children[row.collector-mappings]
            do match? tree.nodes[mapping]
                | .node-stream-collector-mapping(written)
                    . level = accumulator-level(written.caller.text)
                    . found = false
                    for mark in marks
                        found = found || mark.level == level
                    if level != U32.max && !found
                        marks += LevelMark(level, no-local)
    | .node-stream-and(row)
        mark-levels-in(row.left, marks)
        mark-levels-in(row.right, marks)
    | .node-stream-or(row)
        mark-levels-in(row.left, marks)
        mark-levels-in(row.right, marks)
    | .node-stream-transform(row)
        if row.pattern != 0
            mark-levels-in(row.pattern, marks)
    | .node-stream-panic(row)
        mark-levels-in(row.pattern, marks)
    | .node-stream-unary(row)
        mark-levels-in(row.operand, marks)
    | .node-stream-length(row)
        mark-levels-in(row.operand, marks)

────────────────────
_ do rewind-levels
    - marks [LevelMark]
    - site SyntaxId

` Cuts each list back to the count it held where a part began, as the reference's collector
` is rewound: an item past it that holds what the collector traces is first set to what its
` type holds with nothing written.
for held in marks
    rewind-level(capture-levels[held.level], held.mark, site)

────────────────────
_ do rewind-level
    - level CaptureLevel
    - mark LocalId
    - site SyntaxId

` Cuts a list back to the count a local holds, setting each item past it that holds what the
` collector traces to what its type holds with nothing written first.
. item-layout = layout-of(level.item, site)
if tables.layouts.rows[item-layout].is-managed
    . index = ir.add-local(u64-layout)
    store-local(index, load-local(mark, site), site)
    . test = ir.reserve-block()
    . body = ir.reserve-block()
    . done = ir.reserve-block()
    jump(test)
    ir.start-block(test)
    branch
        - compare(site, .compare-less, load-local(index, site), load-local(level.size, site))
        - body
        - done
    ir.start-block(body)
    . blank = blank-item(level, item-layout, site)
    put-item(level, load-local(index, site), blank.operand, item-layout, site)
    store-local
        - index
        - arithmetic
            - site
            - .arithmetic-add
            - load-local(index, site)
            - integer(.machine-u64, 1)
            - u64-layout
        - site
    jump(test)
    ir.start-block(done)
store-local(level.size, load-local(mark, site), site)

────────────────────
_ do blank-item Typed
    - level CaptureLevel
    - layout LayoutId
    - site SyntaxId

` What an item of a list holds with nothing written, as the reference's default value of its
` type: the empty text for a text, and no bits set but for the texts in a struct.
if tables.layouts.is-struct(layout)
    = null-value(level.item, layout, site)
if level.item == types.string-type
    = Typed(make-operand(.operand-constant, ir.add-string("")), level.item)
= Typed(integer(.machine-pointer, 0), level.item)

────────────────────
_ do open-marks
    - body SyntaxId

` Gives a body of a stream pattern that the type pass found holds a rollback mark the local
` that holds it, which holds none as the body begins. A body that holds none has no such local,
` nor has one whose marks no arm of the program asks a helper for: it would never hold one.
` What emits a body inside another sets the other's aside.
. row = facts.rollback-body-of(unit.reading, body)
streaming = streaming.rollback-row = row
streaming = streaming.rollback-mark = no-local
if row == U32.max || !facts.asks-mark(facts.rollback-bodies[row].held)
    =
. layout = layout-of(facts.rollback-bodies[row].kept, body)
streaming = streaming.rollback-mark = ir.add-local(layout)
store-local(streaming.rollback-mark, no-mark(body).operand, body)

────────────────────
_ do no-mark Typed
    - site SyntaxId

` A rollback mark that holds none: zero for one held as an integer, as the reference keeps one,
` and else the optional that holds nothing.
. row = facts.rollback-bodies[streaming.rollback-row]
. layout = layout-of(row.kept, site)
if row.kept == row.held
    = Typed(integer(tables.layouts.kind-of(layout), 0), row.held)
= empty-optional(row.kept, layout)

────────────────────
_ do holds-mark Operand
    - mark Operand
    - site SyntaxId

` Whether a rollback mark holds one.
. row = facts.rollback-bodies[streaming.rollback-row]
if row.kept == row.held
    . compared = compare
        - site
        - .compare-not-equal
        - mark
        - integer(tables.layouts.kind-of(layout-of(row.held, site)), 0)
    = compared
= present(site, Typed(mark, row.kept)).operand

────────────────────
_ do ensure-mark
    - site SyntaxId

` Asks the helper for a rollback mark before an action runs, where the part being emitted holds
` none yet, as the reference asks for one: the earliest it holds is kept.
if streaming.rollback-mark == no-local
    refuse(.refused-expression, site)
    =
. row = facts.rollback-bodies[streaming.rollback-row]
. asked = ir.reserve-block()
. done = ir.reserve-block()
branch(holds-mark(load-local(streaming.rollback-mark, site), site), done, asked)
ir.start-block(asked)
. made = call-protocol
    - site
    - row.mark
    - streaming.pattern-helper
    - streaming.pattern-helper-type
    - make-operand(.operand-void, 0)
if row.kept != row.held
    made = wrap(site, Typed(made.operand, row.held), row.kept)
store-local(streaming.rollback-mark, made.operand, site)
jump(done)
ir.start-block(done)

────────────────────
_ do rewind-mark
    - site SyntaxId

` Gives the helper back the rollback mark the part being emitted holds, where it holds one, which
` undoes what the actions since it was asked for did.
if streaming.rollback-mark == no-local
    =
. row = facts.rollback-bodies[streaming.rollback-row]
. held = ir.reserve-block()
. done = ir.reserve-block()
. mark = load-local(streaming.rollback-mark, site)
branch(holds-mark(mark, site), held, done)
ir.start-block(held)
. given = mark
if row.kept != row.held
    given = payload(site, Typed(mark, row.kept)).operand
call-protocol(site, row.rewind, streaming.pattern-helper, streaming.pattern-helper-type, given, row.held)
jump(done)
ir.start-block(done)

────────────────────
_ do clear-mark
    - site SyntaxId

` Leaves the part being emitted holding no rollback mark.
if streaming.rollback-mark != no-local
    store-local(streaming.rollback-mark, no-mark(site).operand, site)

────────────────────
_ do enter-marks LocalId
    - site SyntaxId

` Sets aside the rollback mark a part holds as a part of it begins, which begins with none, as the
` reference begins each arm of a choice, an optional's operand, each pass of a repeat, a
` lookahead's operand and a local rule run where it is called. None where the pattern holds no
` mark.
if streaming.rollback-mark == no-local
    = no-local
. saved = ir.add-local(ir.locals[streaming.rollback-mark].layout)
store-local(saved, load-local(streaming.rollback-mark, site), site)
clear-mark(site)
= saved

────────────────────
_ do pass-marks
    - saved LocalId
    - site SyntaxId

` Where a part of a part passed, the part holds the rollback mark it held before, where it held
` one, and else what the part of it holds.
if saved == no-local
    =
. kept = ir.reserve-block()
. done = ir.reserve-block()
branch(holds-mark(load-local(saved, site), site), kept, done)
ir.start-block(kept)
store-local(streaming.rollback-mark, load-local(saved, site), site)
jump(done)
ir.start-block(done)

────────────────────
_ do fail-marks
    - saved LocalId
    - site SyntaxId

` Where a part of a part failed, the rollback mark that part holds is given back, and the part
` holds what it held before.
if saved == no-local
    =
rewind-mark(site)
store-local(streaming.rollback-mark, load-local(saved, site), site)

────────────────────
_ do next-arm
    - saved LocalId
    - site SyntaxId

` Where an arm of a choice failed, the rollback mark it holds is given back, and the next begins
` with none.
if saved == no-local
    =
rewind-mark(site)
clear-mark(site)

────────────────────
_ do gather-mark
    - gathered LocalId
    - site SyntaxId

` Where a pass of a repeat passed, the repeat keeps the rollback mark it holds, where it kept none
` yet.
if gathered == no-local
    =
. taken = ir.reserve-block()
. done = ir.reserve-block()
branch(holds-mark(load-local(gathered, site), site), done, taken)
ir.start-block(taken)
store-local(gathered, load-local(streaming.rollback-mark, site), site)
jump(done)
ir.start-block(done)

────────────────────
_ do settle-repeat
    - saved LocalId
    - gathered LocalId
    - site SyntaxId

` Where a repeat passed, the part holds the rollback mark it held before it, where it held one,
` and else the earliest its passes held.
if saved == no-local
    =
store-local(streaming.rollback-mark, load-local(gathered, site), site)
pass-marks(saved, site)

────────────────────
_ do lend-mark LocalId
    - callee InstanceId
    - site SyntaxId

` Where a rule a pattern calls gives the rollback mark its pattern holds as it passes, a local of
` the caller's frame the rule keeps it in, whose address is the next argument. The caller must
` hold marks of the same type.
if !carries(callee)
    = no-local
. body = facts.rollback-body-of
    - callee
    - rule-match(program, instances.rows[callee].module, instances.rows[callee].decl)
if streaming.rollback-mark == no-local || body == U32.max || kept-differs
    refuse(.refused-expression, site)
    = no-local
.. kept-differs = facts.rollback-bodies[body].kept != facts.rollback-bodies[streaming.rollback-row].kept
. given = ir.add-local(ir.locals[streaming.rollback-mark].layout, true, true)
pending += make-operand
    - .operand-value
    - append(.op-local-address, site, Span(), given, pointer-layout)
= given

────────────────────
_ do take-mark
    - given LocalId
    - site SyntaxId

` Where a rule a part called passed, the part holds the rollback mark the rule gave, where it held
` none.
if given == no-local
    =
. taken = ir.reserve-block()
. done = ir.reserve-block()
branch(holds-mark(load-local(streaming.rollback-mark, site), site), done, taken)
ir.start-block(taken)
store-local(streaming.rollback-mark, load-local(given, site), site)
jump(done)
ir.start-block(done)

────────────────────
_ helper-marks Bool
    - helper TypeId

` Whether the functions of patterns given to a rule under a helper give the rollback mark they
` hold: where the helper can roll back, and some arm of the program asks a helper for a mark
` of its type.
helper != no-type && held != no-type && facts.asks-mark(held)

.. held = helper-mark-type(types, helper)

────────────────────
_ carries Bool
    - rule InstanceId

` Whether a rule's function gives the rollback mark its pattern holds as it passes: where the
` type pass found the pattern holds one, and some arm of the program asks a helper for a mark
` of that type.
|? !instances.rows[rule].carries-mark
    false
??
    body == U32.max || facts.asks-mark(facts.rollback-bodies[body].held)

.. body = facts.rollback-body-of
    - rule
    - rule-match(program, instances.rows[rule].module, instances.rows[rule].decl)

────────────────────
_ do give-mark
    - site SyntaxId

` Keeps the rollback mark a rule's pattern holds as it passed where its caller said to.
. layout = ir.locals[streaming.rollback-mark].layout
if tables.layouts.is-struct(layout)
    copy(streaming.marked-argument, load-local(streaming.rollback-mark, site), layout, false, site)
else
    store(streaming.marked-argument, 0, load-local(streaming.rollback-mark, site), false, site)

────────────────────
_ do hold-text
    - capture StreamCapture
    - begun Operand
    - ending Operand
    - site SyntaxId

store-local(capture.begin, begun, site)
store-local(capture.end, ending, site)
if capture.present != no-local
    store-local(capture.present, integer(.machine-u8, 1), site)

────────────────────
_ do clear-captures ?! Refused
    - id SyntaxId
    - site SyntaxId

` Leaves each optional name a part of a pattern captures holding nothing.
do match? tree.nodes[id]
    | .node-stream-capture(row)
        . held = captured-at(captured-slot(row.name))
        if held != U32.max && stream-captures[held].present != no-local
            store-local(stream-captures[held].present, integer(.machine-u8, 0), site)
        if held != U32.max && stream-captures[held].value != no-local && optional-held
            . type = stream-captures[held].type
            store-local
                - stream-captures[held].value
                - empty-optional(type, layout-of(type, site)).operand
                - site
        .. optional-held = types.is-optional(stream-captures[held].type)
        clear-captures(row.pattern, site)
    | .node-stream-and(row)
        clear-captures(row.left, site)
        clear-captures(row.right, site)
    | .node-stream-or(row)
        clear-captures(row.left, site)
        clear-captures(row.right, site)
    | .node-stream-unary(row)
        clear-captures(row.operand, site)

────────────────────
_ do stream-optional StreamPart
    - run StreamRun
    - id SyntaxId
    - operand SyntaxId
    - cursor Operand

` An optional part: its operand where it passes, and else nothing, from the cursor. Where the
` operand fails, the names captured in it hold nothing, and the lists names accumulate in it
` are cut back. Where the operand gives what a rule
` gave, the part gives it as an optional, which holds nothing where the operand failed; so
` does one the type pass planned to give the text it matched, made where the operand passes.
` The operand begins holding no rollback mark, as `enter-marks` says, and gives back the one
` it holds where it fails.
. joined = ir.reserve-block()
. missed = ir.reserve-block()
. mark = joins.length
. marks = mark-levels(operand)
. entered = enter-marks(id)
. tried = emit-stream-part(run, operand, cursor, missed)
. passed = tried.ending
. given = tried.value.operand
. given-type = tried.value.type
if given-type == no-type && gives-value(id)
    . texted = stream-text(run, id, cursor, passed)
    given = texted.operand
    given-type = texted.type
. type = if given-type != no-type then facts.node-type(unit.reading, id) else no-type
if given-type != no-type && (!types.is-optional(type) || types.optional-inner(type) != given-type)
    refuse(.refused-expression, id)
    = bare-part(cursor)
. kept = no-local
if type != no-type
    . layout = layout-of(type, id)
    kept = ir.add-local(layout)
    store-local(kept, wrap(id, Typed(given, given-type), type).operand, id)
pass-marks(entered, id)
arrive(id, passed, joined, make-operand(.operand-void, 0))
ir.start-block(missed)
rewind-levels(marks, id)
fail-marks(entered, id)
clear-captures(operand, id)
if kept != no-local
    store-local(kept, empty-optional(type, layout-of(type, id)).operand, id)
arrive(id, cursor, joined, make-operand(.operand-void, 0))
. ending = close-joins(joined, mark, run.index-layout, make-operand(.operand-void, 0))
if kept != no-local
    = StreamPart(ending, Typed(load-local(kept, id), type))
= bare-part(ending)

────────────────────
_ do read-capture Typed
    - id SyntaxId
    - held U32
    - type TypeId

` What a name a stream pattern captured holds where an action reads it: the text between the
` cursors its part began and ended at, made where it is read, or for an optional name nothing
` where its part did not pass; or in a stream that holds no characters, the part of the
` buffer between them; or what a rule gave, or the item a test passed, as it was kept; or for
` a name captured in repeats, the list the outermost made. Where the type pass narrowed an
` optional name kept as a value to what it holds, the read is of that, as a local's is. A name
` captured over text that the type pass kept as a span is read as the span between its cursors,
` and for an optional name, as such a span where its part passed.
. nothing = make-operand(.operand-void, 0)
. capture = stream-captures[held]
if type != capture.type && capture.type == types.string-type && bare-capture
    = text-span(capture, id, type)
.. bare-capture = capture.value == no-local && capture.listed == 0 && capture.present == no-local
. spans = flag-only && capture.listed == 0 && types.is-optional(type) && optional-string
    .. flag-only = type != capture.type && capture.present != no-local && capture.value == no-local
    .. optional-string = types.optional-inner(capture.type) == types.string-type
if type != capture.type && !spans
    if capture.listed != 0 || capture.value == no-local || shared-depth != 0 || unheld-type
        refuse(.refused-expression, id)
        = Typed(nothing, no-type)
    .. unheld-type = !holds(capture.type, type)
    = payload(id, Typed(load-local(capture.value, id), capture.type))
if capture.listed != 0
    = level-list(capture-levels[capture.levels + capture.listed - 1], id)
if capture.value != no-local
    = Typed(load-local(capture.value, id), type)
if capture.present == no-local && facts.plan-of(unit.reading, capture.site) == .plan-stream-slice
    = stream-slice
        - capture.run
        - capture.site
        - load-local(capture.begin, id)
        - load-local(capture.end, id)
if capture.present == no-local
    = stream-text
        - capture.run
        - capture.site
        - load-local(capture.begin, id)
        - load-local(capture.end, id)
. layout = layout-of(type, id)
. slot = join-slot(layout)
. joined = ir.reserve-block()
. holds = ir.reserve-block()
. empty = ir.reserve-block()
. mark = joins.length
branch
    - compare(id, .compare-not-equal, load-local(capture.present, id), integer(.machine-u8, 0))
    - holds
    - empty
ir.start-block(holds)
. text = if spans then text-span(capture, id, types.optional-inner(type)) else stream-text(capture.run, capture.site, load-local(capture.begin, id), load-local(capture.end, id))
arrive(id, wrap(id, text, type).operand, joined, slot)
ir.start-block(empty)
arrive(id, empty-optional(type, layout).operand, joined, slot)
. result = close-joins(joined, mark, layout, slot)
= Typed(result, type)

────────────────────
_ do stream-literal Operand
    - run StreamRun
    - id SyntaxId
    - text String
    - cursor Operand
    - failed IRBlockId

` Text a pattern matches item by item, or byte by byte of its UTF-8 where the buffer holds a
` String's (`encodes`). Where the input ends first, the pattern read as far as the whole text,
` which in UTF-8 lies as many characters past the end as the text has left; where an item
` differs, as far as that item; either way the text failed where it began. Where it passes it
` read as far as the end of the text.
. encoded = encodes(run)
. points = text.codepoints
. units = if encoded then List'U64((each as U64) in Array'Byte(text)) else point-units
    .. point-units = List'U64((each as U64) in points)
if units.length == 0
    = cursor
. missed = failure-of(run, id, cursor, failed)
. end = stream-advance(run, id, cursor, units.length as U64)
. kind = tables.layouts.rows[run.item-layout].kind
. reached Size = 0
for offset in 0 .. < units.length
    . spot = stream-advance(run, id, cursor, offset as U64)
    . present = ir.reserve-block()
    . short = ir.reserve-block()
    branch-present(run, id, spot, present, short)
    ir.start-block(short)
    record-extent
        - run
        - id
        - if encoded then stream-advance(run, id, spot, (points.size - reached) as U64) else end
    jump(missed)
    ir.start-block(present)
    . same = ir.reserve-block()
    . differs = ir.reserve-block()
    branch
        - compare(id, .compare-equal, stream-item(run, id, spot), integer(kind, units[offset]))
        - same
        - differs
    ir.start-block(differs)
    record-extent(run, id, stream-advance(run, id, spot, 1))
    jump(missed)
    ir.start-block(same)
    if (units[offset] /and/ 0xC0) != 0x80
        reached += 1
record-extent(run, id, end)
record-literals(run, id, text, cursor)
= end

────────────────────
_ do stream-class Operand
    - run StreamRun
    - id SyntaxId
    - first U64
    - last U64
    - any Bool
    - cursor Operand
    - failed IRBlockId

` One item a pattern matches where it lies in a range, or any item with `any`. The pattern
` reads as far as the item, there or not; a `deferred-part` keeps that only where it fails.
` Where the buffer is UTF-8, a range of ASCII is tested on the byte at the cursor, and any other
` on the character there, decoded; the part passes past the character's bytes.
. missed = failure-of(run, id, cursor, failed)
. next = stream-advance(run, id, cursor, 1)
. defers = deferred-part == plan-key(unit.source-module, id)
. lost = if defers then extent-failure(run, id, next, missed) else missed
. present = ir.reserve-block()
. ended = ir.reserve-block()
branch-present(run, id, cursor, present, ended)
ir.start-block(ended)
record-extent(run, id, next)
jump(missed)
ir.start-block(present)
if !defers
    record-extent(run, id, next)
if any
    = char-next(run, id, cursor)
. wide = encodes(run) && last >= 0x80
. kind = tables.layouts.rows[if wide then read-layout(run, id) else run.item-layout].kind
. item = if wide then char-at(run, id, cursor) else stream-item(run, id, cursor)
. above = ir.reserve-block()
. inside = ir.reserve-block()
branch(compare(id, .compare-greater-equal, item, integer(kind, first)), above, lost)
ir.start-block(above)
branch(compare(id, .compare-less-equal, item, integer(kind, last)), inside, lost)
ir.start-block(inside)
= if wide then char-next(run, id, cursor) else next

────────────────────
_ do extent-failure IRBlockId
    - run StreamRun
    - id SyntaxId
    - probe Operand
    - missed IRBlockId

` A block that keeps a cursor a part read up to as how far the pattern read, then goes on to
` where the part fails. What is emitted next goes on past it.
. lost = ir.reserve-block()
. onward = ir.reserve-block()
jump(onward)
ir.start-block(lost)
record-extent(run, id, probe)
jump(missed)
ir.start-block(onward)
= lost

────────────────────
_ do stream-sequence StreamPart
    - run StreamRun
    - id SyntaxId
    - cursor Operand
    - failed IRBlockId

` A sequence tried from a cursor, its parts in turn, each from where the one before it ended,
` where a sequence in it is one with it. Lookaheads that each test one item, with the part after
` them that reads one, are tried as one test, as `stream-fused` says, which defers what it keeps
` where it is the whole of a `deferred-part`.
. parts [SyntaxId]
sequence-parts(id, parts)
. whole = deferred-part == plan-key(unit.source-module, id)
. at = bare-part(cursor)
. position Size = 0
while position < parts.length
    . fused = fused-length(run, parts, position)
    if fused != 0
        at = stream-fused(run, parts, position, fused, at.ending, failed, whole && fused == parts.length)
        position += fused
    else
        at = emit-stream-part(run, parts[position], at.ending, failed)
        position += 1
= at

────────────────────
_ do sequence-parts
    - id SyntaxId
    - parts [SyntaxId]

` The parts of a sequence in order, where a sequence in it is one with it.
do match? tree.nodes[id]
    | .node-stream-and(row)
        sequence-parts(row.left, parts)
        sequence-parts(row.right, parts)
        =
parts += id

────────────────────
_ do item-ranges [ItemRange]?
    - id SyntaxId

` The items a part that tests one item passes on: a text of one character, or a range. None
` for any other part.
do match? tree.nodes[id]
    | .node-stream-string(row)
        . points = row.text.codepoints
        if points.size == 1
            = single-range(points[0] as U64, points[0] as U64)
    | .node-stream-char-range(row)
        = single-range(stream-bound(tree, row.first), stream-bound(tree, row.last))
= null

────────────────────
_ do looked-ranges [ItemRange]?
    - id SyntaxId

` The items a lookahead of a part that tests one item looks for, as `item-ranges` gives them.
` None for any other part.
do match? tree.nodes[id]
    | .node-stream-unary(row)
        if row.op == .positive-lookahead-op || row.op == .negative-lookahead-op
            = item-ranges(row.operand)
= null

────────────────────
_ do fused-length Size
    - run StreamRun
    - parts [SyntaxId]
    - start Size

` How many parts of a sequence from `start` `stream-fused` tries as one test: lookaheads of a
` part that tests one item, then a part that reads one, `.` or one `item-ranges` gives. None
` where the helper observes literal words, or the items are no numbers, or where the buffer
` is UTF-8 and a range is one the byte a character starts with does not test (`wide-ranges`).
if streaming.observer-row != U32.max || !is-integer(run.item-layout)
    = 0
. count Size = 0
while start + count < parts.length && looked-ranges(parts[start + count]) != null && !wide-ranges(run, looked-ranges(parts[start + count])!)
    count += 1
if count == 0 || start + count >= parts.length
    = 0
. last = parts[start + count]
if !(tree.nodes[last] is .node-stream-any) && unbounded-ranges
    = 0
.. unbounded-ranges = item-ranges(last) == null || wide-ranges(run, item-ranges(last)!)
= count + 1

────────────────────
_ do stream-fused StreamPart
    - run StreamRun
    - parts [SyntaxId]
    - start Size
    - count Size
    - cursor Operand
    - failed IRBlockId
    - defers Bool = false

` Lookaheads that each test one item and the part after them that reads one, tried from a
` cursor as one test of the item there. Each reads as far as the item, there or not, as the
` reference's do, and keeps the cursor as one a part failed at where it fails. A negative
` lookahead keeps it where it passes too, since its part failed. The test passes where an item
` lies at the cursor that each positive lookahead's part passes on, no negative one's does, and
` the last part passes on, and gives the item where the last is a `.` the type pass typed as it.
` One that `defers`, as a `deferred-part` does, keeps how far it read only where it fails, and
` the cursor a negative lookahead's part failed at not where it passes. Where the buffer is
` UTF-8 the tests are of the byte a character starts with, the item a `.` gives is the
` character, decoded, and the test passes past its bytes.
. last = parts[start + count - 1]
. next = stream-advance(run, last, cursor, 1)
if !defers
    record-extent(run, last, next)
. failure = failure-of(run, last, cursor, failed)
. missed = if defers then extent-failure(run, last, next, failure) else failure
. present = ir.reserve-block()
branch-present(run, last, cursor, present, missed)
ir.start-block(present)
. item = stream-item(run, last, cursor)
. negated = false
for position in start .. < start + count - 1
    . part = parts[position]
    do match? tree.nodes[part]
        | .node-stream-unary(row)
            . onward = ir.reserve-block()
            if row.op == .negative-lookahead-op
                negated = true
                branch-ranges(run, part, item, item-ranges(row.operand)!, missed, onward)
            else
                branch-ranges(run, part, item, item-ranges(row.operand)!, onward, missed)
            ir.start-block(onward)
. ranges = item-ranges(last)
if ranges
    . passed = ir.reserve-block()
    branch-ranges(run, last, item, ranges, passed, missed)
    ir.start-block(passed)
if negated && !defers
    record-error(run, last, cursor)
if tree.nodes[last] is .node-stream-any
    . typed = facts.node-type(unit.reading, last)
    if typed != no-type
        . item-at = char-at(run, last, cursor)
        = StreamPart(char-next(run, last, cursor), Typed(item-at, typed))
    = bare-part(char-next(run, last, cursor))
= bare-part(next)

────────────────────
_ do stream-dynamic-text Operand
    - run StreamRun
    - id SyntaxId
    - value SyntaxId
    - cursor Operand
    - failed IRBlockId

` Text a pattern matches item by item that a value gives as the pattern runs. Its length is
` read, checked, by the first call the type pass recorded at the part, and where the input
` ends first the pattern read as far as the whole text. Its characters are then read in turn by
` the second, from where the last ended, and compared with the items from the cursor: where
` one differs the pattern read as far as that item. Either way the text failed where it began.
` Where it passes it read as far as the end of the text. Where the buffer is UTF-8 the text is
` matched by its bytes, as `stream-dynamic-bytes` says.
if encodes(run)
    = stream-dynamic-bytes(run, id, value, cursor, failed)
. nothing = make-operand(.operand-void, 0)
. measures = facts.first-call(unit.reading, id)
. reads = next-call(measures)
if reads == no-fact
    refuse(.refused-expression, id)
    = cursor
. missed = failure-of(run, id, cursor, failed)
. text = emit-expression(value)
if text.type != types.string-type
    refuse(.refused-type, id)
    = cursor
. size-layout = layout-of(types.size-type, id)
. measured = call-protocol(id, measures, text.operand, types.string-type, nothing)
. count = num-cast(id, measured.operand, size-layout, run.index-layout)
. end = arithmetic(id, .arithmetic-add, cursor, count, run.index-layout)
. compare-block = ir.reserve-block()
. short = ir.reserve-block()
if run.kept-length == no-local
    branch(compare(id, .compare-less-equal, end, run.length), compare-block, short)
else
    jump(compare-block)
ir.start-block(short)
record-extent(run, id, end)
jump(missed)
ir.start-block(compare-block)
. offset = ir.add-local(run.index-layout)
store-local(offset, integer(tables.layouts.rows[run.index-layout].kind, 0), id)
. byte = ir.add-local(size-layout)
store-local(byte, integer(tables.layouts.rows[size-layout].kind, 0), id)
. test = ir.reserve-block()
. read = ir.reserve-block()
. matched = ir.reserve-block()
. mismatch = ir.reserve-block()
. next = ir.reserve-block()
jump(test)
ir.start-block(test)
branch(compare(id, .compare-less, load-local(offset, id), count), read, matched)
ir.start-block(read)
. decoded = call-protocol(id, reads, text.operand, types.string-type, load-local(byte, id), types.size-type)
. decoded-type = decoded.type
. decoded-layout = layout-of(decoded-type, id)
. onward = part(decoded.operand, decoded-layout, 0, id)
. held = part(decoded.operand, decoded-layout, 1, id)
if !types.is-optional(held.type)
    refuse(.refused-type, id)
    = cursor
. expected = payload(id, held)
. spot = arithmetic(id, .arithmetic-add, cursor, load-local(offset, id), run.index-layout)
if run.kept-length != no-local
    . lies = ir.reserve-block()
    branch-present(run, id, spot, lies, short)
    ir.start-block(lies)
. item = stream-item(run, id, spot)
if layout-of(expected.type, id) != run.item-layout
    refuse(.refused-type, id)
    = cursor
branch(compare(id, .compare-equal, item, expected.operand), next, mismatch)
ir.start-block(next)
store-local(offset, stream-advance(run, id, load-local(offset, id), 1), id)
store-local(byte, onward.operand, id)
jump(test)
ir.start-block(mismatch)
. reached = arithmetic(id, .arithmetic-add, cursor, load-local(offset, id), run.index-layout)
record-extent(run, id, stream-advance(run, id, reached, 1))
jump(missed)
ir.start-block(matched)
record-extent(run, id, end)
= end

────────────────────
_ do stream-dynamic-bytes Operand
    - run StreamRun
    - id SyntaxId
    - value SyntaxId
    - cursor Operand
    - failed IRBlockId

` Text a value gives as the pattern runs, matched byte by byte of its UTF-8 where the buffer
` holds a String's: it is read checked by the first call the type pass recorded at the part,
` and its count of bytes by the second. Where the input ends first, the pattern read as far as
` the whole text; where a byte differs, as far as that byte. Either way the text failed where
` it began. Where it passes it read as far as the end of the text.
. nothing = make-operand(.operand-void, 0)
. checks = facts.first-call(unit.reading, id)
. measures = next-call(checks)
if measures == no-fact
    refuse(.refused-expression, id)
    = cursor
. missed = failure-of(run, id, cursor, failed)
. text = emit-expression(value)
if text.type != types.string-type
    refuse(.refused-type, id)
    = cursor
. text-layout = layout-of(types.string-type, id)
call-protocol(id, checks, text.operand, types.string-type, nothing)
. measured = call-protocol(id, measures, text.operand, types.string-type, nothing)
. measured-layout = layout-of(measured.type, id)
if !is-integer(measured-layout)
    refuse(.refused-type, id)
    = cursor
. kind = tables.layouts.rows[run.index-layout].kind
. count = num-cast(id, measured.operand, measured-layout, run.index-layout)
. end = arithmetic(id, .arithmetic-add, cursor, count, run.index-layout)
. compare-block = ir.reserve-block()
. short = ir.reserve-block()
if run.kept-length == no-local
    branch(compare(id, .compare-less-equal, end, run.length), compare-block, short)
else
    jump(compare-block)
ir.start-block(short)
record-extent(run, id, end)
jump(missed)
ir.start-block(compare-block)
. bytes = num-cast(id, text.operand, text-layout, pointer-layout)
. offset = ir.add-local(run.index-layout)
store-local(offset, integer(kind, 0), id)
. test = ir.reserve-block()
. read = ir.reserve-block()
. matched = ir.reserve-block()
. mismatch = ir.reserve-block()
. next = ir.reserve-block()
jump(test)
ir.start-block(test)
branch(compare(id, .compare-less, load-local(offset, id), count), read, matched)
ir.start-block(read)
. spot = arithmetic(id, .arithmetic-add, cursor, load-local(offset, id), run.index-layout)
if run.kept-length != no-local
    . lies = ir.reserve-block()
    branch-present(run, id, spot, lies, short)
    ir.start-block(lies)
. expected = load
    - moved-bytes(id, bytes, num-cast(id, load-local(offset, id), run.index-layout, u64-layout))
    - 0
    - run.item-layout
    - id
branch(compare(id, .compare-equal, stream-item(run, id, spot), expected), next, mismatch)
ir.start-block(next)
store-local(offset, stream-advance(run, id, load-local(offset, id), 1), id)
jump(test)
ir.start-block(mismatch)
record-extent
    - run
    - id
    - stream-advance
        - run
        - id
        - arithmetic(id, .arithmetic-add, cursor, load-local(offset, id), run.index-layout)
        - 1
jump(missed)
ir.start-block(matched)
record-extent(run, id, end)
= end

────────────────────
_ do stream-dynamic-item StreamPart
    - run StreamRun
    - id SyntaxId
    - value SyntaxId
    - cursor Operand
    - failed IRBlockId

` One item a pattern compares with a value of a type like the items' that it evaluates as it
` runs, first, as the reference does: the part gives the value where they are equal, and reads
` as far as the item, there or not. Where the buffer is UTF-8 the item is the character there,
` decoded, and the part passes past its bytes.
. missed = failure-of(run, id, cursor, failed)
. expected = emit-expression(value)
. type = expected.type
if type != facts.node-type(unit.reading, id) || layout-of(type, id) != read-layout(run, id)
    refuse(.refused-type, id)
    = bare-part(cursor)
. next = stream-advance(run, id, cursor, 1)
. present = ir.reserve-block()
. ended = ir.reserve-block()
branch-present(run, id, cursor, present, ended)
ir.start-block(ended)
record-extent(run, id, next)
jump(missed)
ir.start-block(present)
. item = char-at(run, id, cursor)
record-extent(run, id, next)
. passed = ir.reserve-block()
branch(compare(id, .compare-equal, item, expected.operand), passed, missed)
ir.start-block(passed)
= StreamPart(char-next(run, id, cursor), Typed(expected.operand, type))

────────────────────
_ do stream-case-item StreamPart
    - run StreamRun
    - id SyntaxId
    - cursor Operand
    - failed IRBlockId

` One item of a union a pattern tests for a case named by its symbol, by the number the type
` pass recorded: where the item holds the case, the part gives what the case holds, or the item
` where the type pass typed the part as the items. It reads as far as the item, there or not.
. type = facts.node-type(unit.reading, id)
. constant = facts.constant-of(unit.reading, id)
. layout = read-layout(run, id)
if constant == no-fact || encodes(run) || !tables.layouts.is-union(layout)
    refuse(.refused-type, id)
    = bare-part(cursor)
. index = facts.constants[constant].bits as U32
if index >= tables.layouts.rows[layout].cases.count
    refuse(.refused-type, id)
    = bare-part(cursor)
. field = tables.layouts.case-field(layout, index)
. whole = type == class-arg(types, run.buffer-type, 0)
if !whole && field.type != type
    refuse(.refused-type, id)
    = bare-part(cursor)
. missed = failure-of(run, id, cursor, failed)
. next = stream-advance(run, id, cursor, 1)
. present = ir.reserve-block()
. ended = ir.reserve-block()
branch-present(run, id, cursor, present, ended)
ir.start-block(ended)
record-extent(run, id, next)
jump(missed)
ir.start-block(present)
. item = char-at(run, id, cursor)
record-extent(run, id, next)
. passed = ir.reserve-block()
branch(case-test(id, item, index), passed, missed)
ir.start-block(passed)
. given = if whole then item else take(item, field, id)
= StreamPart(char-next(run, id, cursor), Typed(given, type))

────────────────────
_ do stream-type-part StreamPart
    - run StreamRun
    - id SyntaxId
    - written SyntaxId
    - cursor Operand
    - failed IRBlockId

` A type named as a part of a pattern: a call of the rule the type pass recorded at it, which is
` the type's constructor that takes the stream or the rule that reads a number of the type, or
` of a function that reads the number and is no rule, as `boundary-call` says; or else a test
` of one item for the type, which gives the item: an item of a class the type derives from, or
` of a union that has the type as a case, is read as the items are, tested as the type named as
` a pattern tests a value, and given as the type. An item that is
` a number of another type is never of it, and fails once it is there. Before the test the
` stream is told the pattern stands at the item, as the reference tells it before it looks for
` such a function. The test reads as far as the item, there or not. Where the buffer is UTF-8
` the item is the character there, decoded, and the test passes past its bytes.
. type = facts.node-type(unit.reading, id)
if type == no-type || type == invalid-type
    refuse(.refused-type, id)
    = bare-part(cursor)
. first = facts.first-call(unit.reading, id)
. commits = first != no-fact && facts.calls[first].form == .call-method
if first != no-fact && !commits
    if next-call(first) != no-fact
        = boundary-call(run, id, type, cursor, failed)
    = rule-call(run, id, type, cursor, failed)
. item-type = if encodes(run) then types.type-row(.char) else class-arg(types, run.buffer-type, 0)
. never = item-type != type && intrinsic-is-numeric(types.intrinsic-of(item-type))
if !commits || calls-next || (!never && layout-of(item-type, id) != read-layout(run, id))
    refuse(.refused-type, id)
    = bare-part(cursor)
.. calls-next = next-call(first) != no-fact
call-protocol
    - id
    - first
    - run.stream
    - run.stream-type
    - cursor
    - types.index-type
    - true
    - cursor
    - types.index-type
. missed = failure-of(run, id, cursor, failed)
. next = stream-advance(run, id, cursor, 1)
. present = ir.reserve-block()
. ended = ir.reserve-block()
branch-present(run, id, cursor, present, ended)
ir.start-block(ended)
record-extent(run, id, next)
jump(missed)
ir.start-block(present)
if never
    record-extent(run, id, next)
    jump(missed)
    ir.start-block(ir.reserve-block())
    . layout = layout-of(type, id)
    . held = ir.add-local(layout)
    clear-local(held, layout, id)
    = StreamPart(next, Typed(load-local(held, id), type))
. item = char-at(run, id, cursor)
record-extent(run, id, next)
if item-type != type
    . typeed = match-type(written, Typed(item, item-type), missed)
    item = typeed.operand
    if typeed.type != type
        refuse(.refused-type, id)
        = bare-part(cursor)
= StreamPart(char-next(run, id, cursor), Typed(item, type))

────────────────────
_ do stream-predicate StreamPart
    - run StreamRun
    - id SyntaxId
    - predicate SyntaxId
    - cursor Operand
    - failed IRBlockId

` One item a pattern tests, which gives the item where the test passes: the test's expression
` sees the item as `it`, and is tested as a condition. The pattern reads as far as the item,
` there or not. Where the buffer is UTF-8 the item is the character there, decoded, and the
` test passes past its bytes.
. missed = failure-of(run, id, cursor, failed)
. next = stream-advance(run, id, cursor, 1)
. present = ir.reserve-block()
. ended = ir.reserve-block()
branch-present(run, id, cursor, present, ended)
ir.start-block(ended)
record-extent(run, id, next)
jump(missed)
ir.start-block(present)
. item = char-at(run, id, cursor)
record-extent(run, id, next)
. type = facts.node-type(unit.reading, id)
if type == no-type || layout-of(type, id) != read-layout(run, id)
    refuse(.refused-type, id)
    = bare-part(cursor)
. named = bound.length
. slot = arm-slot-of(id, .slot-it)
if slot != no-slot
    bound += BoundValue(slot, type, item)
. tested = emit-expression(predicate)
. holds = test(predicate, tested).operand
drop-bound(named)
. passed = ir.reserve-block()
branch(holds, passed, missed)
ir.start-block(passed)
= StreamPart(char-next(run, id, cursor), Typed(item, type))

────────────────────
_ do stream-choice StreamPart
    - run StreamRun
    - id SyntaxId
    - cursor Operand
    - failed IRBlockId

` Alternatives tried from a cursor as the reference tries them: the first that passes is
` kept, and where all fail the choice does. A choice gives no value, but one the type pass
` planned to give what its alternatives give, which gives what the one that passed gave.
. nothing = make-operand(.operand-void, 0)
. arms [SyntaxId]
choice-arms(tree, id, arms)
. type = if gives-value(id) then facts.node-type(unit.reading, id) else no-type
if type == invalid-type
    refuse(.refused-expression, id)
    = bare-part(cursor)
. kept = if type != no-type then ir.add-local(layout-of(type, id)) else no-local
. joined = ir.reserve-block()
. mark = joins.length
try-alternatives
    - run
    - id
    - arms
    - cursor
    - failed
    - ArmWay(id, type, false, kept, joined, nothing, true, false)
. ending = close-joins(joined, mark, run.index-layout, nothing)
if kept != no-local
    = StreamPart(ending, Typed(load-local(kept, id), type))
= bare-part(ending)

────────────────────
_ do try-alternatives Bool
    - run StreamRun
    - id SyntaxId
    - arms [SyntaxId]
    - cursor Operand
    - failed IRBlockId
    - way ArmWay

` The alternatives of a choice, tried from a cursor as the reference tries them. Alternatives
` that are each one item it tests as one, each in turn. Otherwise, where every one must read
` an item and it knows which each may start with, it sorts them into groups by those items
` and, where there is more than one, tries only the group the item at the cursor starts;
` where no group does, or no item lies there, the choice fails. Else each is tried in turn,
` but one that must read an item and starts with items it knows is skipped where none of those
` lies at the cursor. Whether any reaches the join. The lists names accumulate in the
` alternatives are cut back before each alternative tried after the first, and where all fail.
` Each alternative begins holding no rollback mark, and gives back the one it holds where it
` fails; the choice holds the one it held before where it held one, and else the one the
` alternative that passed holds.
. marks = mark-levels(id)
. entered = enter-marks(id)
. lost = if entered == no-local then failed else ir.reserve-block()
. arrives = false
if is-scanned(tree, id)
    . own-streaming = streaming
    streaming = streaming.classing = true
    arrives = try-guarded(run, id, arms, U32.max, cursor, lost, way, marks, entered)
    streaming = own-streaming
else
    . start = plan-start(id)
    if start == U32.max
        refuse(.refused-expression, id)
        = false
    . groups = dispatch-groups(start, arms.length as U32)
    if groups.length > 1
        arrives = try-dispatched(run, id, arms, start, groups, cursor, lost, way, marks, entered)
    else
        arrives = try-guarded(run, id, arms, start, cursor, lost, way, marks, entered)
if entered != no-local
    ir.start-block(lost)
    store-local(streaming.rollback-mark, load-local(entered, id), id)
    jump(failed)
= arrives

────────────────────
_ do try-alternative Bool
    - run StreamRun
    - way ArmWay
    - arm SyntaxId
    - cursor Operand
    - failed IRBlockId
    - entered LocalId

` One alternative of a choice, tried from a cursor, which goes on to `failed` where it fails.
` Where it passes, the choice holds the rollback mark it held before the alternative where it
` held one, and where the choice gives a value the alternative leaves its own. Whether it
` reaches the join.
if !way.parts
    = emit-stream-arm
        - run
        - arm
        - way.result
        - cursor
        - way.whole
        - way.end
        - way.joined
        - way.slot
        - failed
        - entered
        - way.unread
. passed = emit-stream-part(run, arm, cursor, failed)
if way.end != no-local
    if passed.value.type != way.result
        refuse(.refused-expression, arm)
        = false
    store-local(way.end, passed.value.operand, arm)
pass-marks(entered, arm)
arrive(way.site, passed.ending, way.joined, make-operand(.operand-void, 0))
= true

────────────────────
_ do try-guarded Bool
    - run StreamRun
    - id SyntaxId
    - arms [SyntaxId]
    - start U32
    - cursor Operand
    - failed IRBlockId
    - way ArmWay
    - marks [LevelMark]
    - entered LocalId

` Alternatives tried in turn from a cursor, those the reference guards skipped where no item
` lies at the cursor or the one there is not one they may start with. What the alternatives
` may start with is kept from `start`, or not at all with `U32.max`. Whether any reaches the
` join.
. guarded = false
if start != U32.max
    for position in 0 .. < arms.length
        guarded = guarded || guards(plan-firsts[start + (position as U32)])
. present = make-operand(.operand-void, 0)
if guarded && run.kept-length == no-local
    present = compare(id, .compare-less, cursor, run.length)
. arrives = false
for position in 0 .. < arms.length
    . last = position + 1 == arms.length
    . next = if last && marks.length == 0 && entered == no-local then failed else ir.reserve-block()
    if guarded && guards(plan-firsts[start + (position as U32)])
        . looked = ir.reserve-block()
        . skipped = ir.reserve-block()
        . tried = ir.reserve-block()
        if run.kept-length == no-local
            branch(present, looked, skipped)
        else
            branch-present(run, id, cursor, looked, skipped)
        ir.start-block(looked)
        . ranges = plan-firsts[start + (position as U32)].ranges
        . decodes = wide-ranges(run, ranges)
        branch-ranges(run, id, item-at(run, id, cursor, decodes), ranges, tried, skipped, decodes)
        ir.start-block(skipped)
        skip-extent(run, id, start, position as U32, (position as U32) + 1, cursor)
        jump(next)
        ir.start-block(tried)
    arrives = try-alternative(run, way, arms[position], cursor, next, entered) || arrives
    if !last || marks.length != 0 || entered != no-local
        ir.start-block(next)
        rewind-levels(marks, id)
        next-arm(entered, id)
    if last && (marks.length != 0 || entered != no-local)
        jump(failed)
= arrives

────────────────────
_ do try-dispatched Bool
    - run StreamRun
    - id SyntaxId
    - arms [SyntaxId]
    - start U32
    - groups [ArmGroup]
    - cursor Operand
    - failed IRBlockId
    - way ArmWay
    - marks [LevelMark]
    - entered LocalId

` Alternatives sorted into groups by the items they may start with, of which only the group
` the item at the cursor starts is tried, its alternatives in turn: those before each one tried
` and after the last count as skipped. Where no group is started, or no item lies at the
` cursor, all count as skipped and the choice fails. Whether any reaches the join. Where the
` buffer is UTF-8, the item is the byte a character starts with, or the character, decoded,
` where a group's ranges need it (`wide-ranges`).
. count = arms.length as U32
. present = ir.reserve-block()
. ended = ir.reserve-block()
branch-present(run, id, cursor, present, ended)
ir.start-block(ended)
skip-extent(run, id, start, 0, count, cursor)
jump(failed)
ir.start-block(present)
. decodes = false
for group in groups
    decodes = decodes || wide-ranges(run, group.ranges)
. item = item-at(run, id, cursor, decodes)
. arrives = false
for group in groups
    . chosen = ir.reserve-block()
    . other = ir.reserve-block()
    branch-ranges(run, id, item, group.ranges, chosen, other, decodes)
    ir.start-block(chosen)
    . unskipped U32
    for index in group.arms
        skip-extent(run, id, start, unskipped, index, cursor)
        . next = ir.reserve-block()
        arrives = try-alternative(run, way, arms[index], cursor, next, entered) || arrives
        ir.start-block(next)
        rewind-levels(marks, id)
        next-arm(entered, id)
        unskipped = index + 1
    skip-extent(run, id, start, unskipped, count, cursor)
    jump(failed)
    ir.start-block(other)
skip-extent(run, id, start, 0, count, cursor)
jump(failed)
= arrives

────────────────────
_ guards Bool
    - first FirstItems

` Whether the reference skips an alternative that starts so where the item at the cursor is
` not one it may start with: where it knows them, there are some, and it must read one.
first.known && !first.nullable && first.ranges.length != 0

────────────────────
_ do item-at Operand
    - run StreamRun
    - id SyntaxId
    - cursor Operand
    - decodes Bool = false

` The item at a cursor the pattern knows is inside the input, to test against ranges; nothing
` for items that are no numbers, which are not read. Where the buffer is UTF-8 it is the byte
` the character there starts with, or where it `decodes`, the character, decoded.
if !is-integer(run.item-layout)
    = make-operand(.operand-void, 0)
= if decodes then char-at(run, id, cursor) else stream-item(run, id, cursor)

────────────────────
_ do branch-ranges
    - run StreamRun
    - id SyntaxId
    - item Operand
    - ranges [ItemRange]
    - inside IRBlockId
    - outside IRBlockId
    - decodes Bool = false

` Goes on to `inside` where an item lies in one of some ranges, tested in turn, and else to
` `outside`. An item that is no number lies in a range only where the range holds every item,
` as the reference tests it; any other range has no shape for it. Where the buffer is UTF-8 and
` the item is the byte a character starts with, not the character it `decodes`, a range that
` holds every character past ASCII holds every such byte past it.
if !is-integer(run.item-layout)
    if ranges.length == 1 && ranges[0].first == 0 && ranges[0].last == any-item
        jump(inside)
        =
    refuse(.refused-type, id)
    =
if ranges.length == 0
    jump(outside)
    =
. kind = tables.layouts.rows[if decodes then read-layout(run, id) else run.item-layout].kind
. bytes = encodes(run) && !decodes
for position in 0 .. < ranges.length
    . range = ranges[position]
    . upper = if bytes && range.last >= 0x80 then 0xFF as U64 else range.last
    . last = position + 1 == ranges.length
    . next = if last then outside else ir.reserve-block()
    if range.first == upper
        branch(compare(id, .compare-equal, item, integer(kind, range.first)), inside, next)
    else
        . above = ir.reserve-block()
        branch(compare(id, .compare-greater-equal, item, integer(kind, range.first)), above, next)
        ir.start-block(above)
        branch(compare(id, .compare-less-equal, item, integer(kind, upper)), inside, next)
    if !last
        ir.start-block(next)

────────────────────
_ do skip-extent
    - run StreamRun
    - id SyntaxId
    - start U32
    - from U32
    - to U32
    - cursor Operand

` Counts the alternatives of a choice from `from` up to `to` as skipped, as the reference
` does: as read from the cursor at least one item on, and as far as the farthest of them
` probes where that lies inside the input, or else to its end. Where the buffer is UTF-8 the
` probe counts characters, as `advance-chars` reads them.
if from >= to
    =
. probe U64 = 1
for position in from .. < to
    . own = plan-firsts[start + position].probe
    if own != no-probe && own > probe
        probe = own
record-extent(run, id, stream-advance(run, id, cursor, 1))
if probe == 1
    =
if encodes(run)
    record-extent(run, id, advance-chars(run, id, cursor, probe))
    =
. end = stream-advance(run, id, cursor, probe)
. short = ir.reserve-block()
. beyond = ir.reserve-block()
. done = ir.reserve-block()
. length = run-length(run, id)
branch(compare(id, .compare-less-equal, end, length), short, beyond)
ir.start-block(short)
record-extent(run, id, end)
jump(done)
ir.start-block(beyond)
record-extent(run, id, length)
jump(done)
ir.start-block(done)

────────────────────
_ do dispatch-groups [ArmGroup]
    - start U32
    - count U32

` The groups the reference sorts the alternatives of a choice into by the items they may start
` with, where every one must read an item and it knows which: two that may start with the same
` item share a group, and the groups are in the order of their first alternatives. None where
` it sorts them into fewer than two.
. groups [ArmGroup]
for position in 0 .. < count
    . first = plan-firsts[start + position]
    if !first.known || first.nullable
        = groups
. parents [U32]
for position in 0 .. < count
    parents += position
for left in 0 .. < count
    for right in left + 1 .. < count
        if ranges-meet(plan-firsts[start + left].ranges, plan-firsts[start + right].ranges)
            . root = group-root(parents, left)
            . other = group-root(parents, right)
            if root != other
                parents[other] = root
. placed [U32]
for position in 0 .. < count
    placed += U32.max
for position in 0 .. < count
    . root = group-root(parents, position)
    if placed[root] == U32.max
        placed[root] = groups.length as U32
        . members [U32]
        . none [ItemRange]
        groups += ArmGroup(members, none)
    . place = placed[root]
    . members = groups[place].arms
    members += position
    groups[place] = ArmGroup
        - members
        - merged-ranges(groups[place].ranges, plan-firsts[start + position].ranges)
if groups.length < 2
    . none [ArmGroup]
    = none
= groups

────────────────────
_ do group-root U32
    - parents [U32]
    - position U32

` The alternative that stands for the group of another, as groups are joined.
. found = position
while parents[found] != found
    found = parents[found]
= found

────────────────────
_ do ranges-meet Bool
    - left [ItemRange]
    - right [ItemRange]

` Whether two lists of ranges, each in order and apart, share an item.
. at-left Size = 0
. at-right Size = 0
while at-left < left.length && at-right < right.length
    if left[at-left].last < right[at-right].first
        at-left += 1
    else if right[at-right].last < left[at-left].first
        at-right += 1
    else
        = true
= false

────────────────────
_ do merged-ranges [ItemRange]
    - left [ItemRange]
    - right [ItemRange]

` The ranges of two lists, each in order and apart, in order and apart: those that overlap or
` touch are joined. Where one list is empty, the other is the result.
=? right if left.length == 0
=? left if right.length == 0
. merged [ItemRange]
. at-left Size = 0
. at-right Size = 0
while at-left < left.length || at-right < right.length
    . from-left = at-right >= right.length || (at-left < left.length && left-before)
        .. left-before = !range-after(left[at-left], right[at-right])
    . range = if from-left then left[at-left] else right[at-right]
    if from-left
        at-left += 1
    else
        at-right += 1
    if merged.length != 0 && range.first <= merged[merged.length - 1].last + 1
        if range.last > merged[merged.length - 1].last
            merged[merged.length - 1] = ItemRange(merged[merged.length - 1].first, range.last)
        continue
    merged += range
= merged

────────────────────
_ range-after Bool
    - range ItemRange
    - other ItemRange

` Whether a range sorts after another: it starts later, or as early and ends later.
range.first > other.first || (range.first == other.first && range.last > other.last)

────────────────────
_ do single-range [ItemRange]
    - first U64
    - last U64

` A list of one range.
. ranges [ItemRange]
ranges += ItemRange(first, last)
= ranges

────────────────────
_ do plan-choices
    - root SyntaxId

` Judges, as the reference does before it emits a pattern, which items each part of the
` pattern rooted at `root` may start with, reading the patterns of the rules it calls as far as
` they reach, and keeps for each choice of the pattern what each of its alternatives may start
` with.
if found-firsts.length != 0
    found-firsts.clear()
first-items(unit.source-module, unit.reading, root, true)

────────────────────
_ plan-start U32
    - id SyntaxId

` Where what the alternatives of a choice may start with is kept, or `U32.max` where it is not.
choice-plans[plan-key(unit.source-module, id)] ?? U32.max

────────────────────
_ plan-key U64
    - module ModuleId
    - id SyntaxId

` A node of the syntax of a module, as one number.
((module as U64) /lshift/ 32) /or/ (id as U64)

────────────────────
_ do first-items FirstItems
    - module ModuleId
    - owner InstanceId
    - id SyntaxId
    - planning Bool

` What the reference knows of the items a part of a stream pattern may start with, as it
` lowers the part and judges it. Text starts with its first character and probes its length;
` a range, any item, or a repeat that scans for one, starts with what it matches and probes
` one item. A sequence starts as its parts do up to the first that must read an item, and
` probes as that one does. Alternatives start as any of theirs does and probe the farthest,
` where each probe is known. A repeat or an optional part starts and probes as its part does,
` and may read none where it may pass none; a lookahead may read none, starts with what is not
` known, and probes as its part does. A call starts and probes as the pattern of the rule it
` calls does. A test of an item, of its type, or of a value matched, starts with what is not
` known and probes what is not known. With `planning`, keeps what the alternatives of each
` choice met may start with.
. syntax = program.modules[module].tree
. none = no-ranges
do match? syntax.nodes[id]
    | .node-stream-string(row)
        . count = row.text.length
        if count == 0
            = FirstItems(true, true, none, 0)
        . point = row.text[0] as U64
        = FirstItems(true, false, single-range(point, point), count as U64)
    | .node-stream-any
        = FirstItems(true, false, single-range(0, any-item), 1)
    | .node-stream-char-range(row)
        = FirstItems
            - true
            - false
            - single-range(stream-bound(syntax, row.first), stream-bound(syntax, row.last))
            - 1
    | .node-stream-transform(row)
        if row.pattern == 0
            = FirstItems(true, true, none, 0)
        = first-items(module, owner, row.pattern, planning)
    | .node-stream-panic(row)
        = first-items(module, owner, row.pattern, planning)
    | .node-stream-capture(row)
        = first-items(module, owner, row.pattern, planning)
    | .node-stream-and(row)
        . left = first-items(module, owner, row.left, planning)
        . right = first-items(module, owner, row.right, planning)
        if !left.nullable
            = left
        = FirstItems
            - left.known && right.known
            - right.nullable
            - merged-ranges(left.ranges, right.ranges)
            - right.probe
    | .node-stream-or
        = first-choice(module, owner, id, planning)
    | .node-stream-unary(row)
        . optional = row.op != .one-or-more-op
        if repeats && is-scanned(syntax, row.operand)
            = FirstItems(true, optional, scanned-ranges(syntax, row.operand), 1)
        .. repeats = row.op == .zero-or-more-op || row.op == .one-or-more-op
        . inner = first-items(module, owner, row.operand, planning)
        if row.op == .positive-lookahead-op || row.op == .negative-lookahead-op
            = FirstItems(false, true, none, inner.probe)
        = FirstItems(inner.known, optional, inner.ranges, inner.probe)
    | .node-stream-length(row)
        . inner = first-items(module, owner, row.operand, planning)
        . least = if literal-bound(syntax, row.min) then stream-bound(syntax, row.min) else 0
        = FirstItems(inner.known, least == 0, inner.ranges, inner.probe)
    | .node-stream-call
        = call-first-items(module, owner, id)
= FirstItems(false, false, none, no-probe)

────────────────────
_ do first-choice FirstItems
    - module ModuleId
    - owner InstanceId
    - id SyntaxId
    - planning Bool

` What the reference knows of the items a choice may start with, from what each of its
` alternatives may; with `planning`, keeps that of each. The alternatives, what each starts
` with, and the ranges they start with joined so far are kept on stacks that the choices among
` them grow and give back as they are judged.
. arms = choice-arm-stack.length
choice-arms(program.modules[module].tree, id, choice-arm-stack)
. end = choice-arm-stack.length
. firsts = choice-first-stack.length
. joined = choice-range-stack.length
. known = true
. nullable = false
. probe U64
for position in arms .. < end
    . found = first-items(module, owner, choice-arm-stack[position], planning)
    if planning
        choice-first-stack += found
    known = known && found.known
    nullable = nullable || found.nullable
    join-ranges(joined, found.ranges)
    if probe == no-probe || found.probe == no-probe
        probe = no-probe
    else if found.probe > probe
        probe = found.probe
if planning
    choice-plans[plan-key(module, id)] = plan-firsts.length as U32
    for position in firsts .. < choice-first-stack.length
        plan-firsts += choice-first-stack[position]
    choice-first-stack.remove(firsts, choice-first-stack.length - firsts)
choice-arm-stack.remove(arms, end - arms)
. ranges = no-ranges
if choice-range-stack.length > joined
    . taken [ItemRange]
    for position in joined .. < choice-range-stack.length
        taken += choice-range-stack[position]
    choice-range-stack.remove(joined, choice-range-stack.length - joined)
    ranges = taken
= FirstItems(known, nullable, ranges, probe)

────────────────────
_ do join-ranges
    - base Size
    - ranges [ItemRange]

` Joins ranges, in order and apart, into those a choice has joined so far on the range stack
` from `base`, as `merged-ranges` does: they stay in order and apart.
=? if ranges.length == 0
. top = choice-range-stack.length
. at-left = base
. at-right Size = 0
while at-left < top || at-right < ranges.length
    . from-left = at-right >= ranges.length || (at-left < top && left-before)
        .. left-before = !range-after(choice-range-stack[at-left], ranges[at-right])
    . range = if from-left then choice-range-stack[at-left] else ranges[at-right]
    if from-left
        at-left += 1
    else
        at-right += 1
    if choice-range-stack.length != top
        . last = choice-range-stack.length - 1
        if range.first <= choice-range-stack[last].last + 1
            if range.last > choice-range-stack[last].last
                choice-range-stack[last] = ItemRange(choice-range-stack[last].first, range.last)
            continue
    choice-range-stack += range
. count = choice-range-stack.length - top
for offset in 0 .. < count
    choice-range-stack[base + offset] = choice-range-stack[top + offset]
choice-range-stack.remove(base + count, top - base)

────────────────────
_ do scanned-ranges [ItemRange]
    - syntax AST
    - id SyntaxId

` The ranges of the items a part the reference scans for may match, in order and apart.
. none = no-ranges
do match? syntax.nodes[id]
    | .node-stream-string(row)
        . point = row.text[0] as U64
        = single-range(point, point)
    | .node-stream-any
        = single-range(0, any-item)
    | .node-stream-char-range(row)
        = single-range(stream-bound(syntax, row.first), stream-bound(syntax, row.last))
    | .node-stream-or(row)
        = merged-ranges(scanned-ranges(syntax, row.left), scanned-ranges(syntax, row.right))
    | .node-stream-transform(row)
        = scanned-ranges(syntax, row.pattern)
= none

────────────────────
_ do choice-arms
    - syntax AST
    - id SyntaxId
    - arms [SyntaxId]

` The alternatives of a choice, in the order written, those of a choice among them included.
do match? syntax.nodes[id]
    | .node-stream-or(row)
        choice-arms(syntax, row.left, arms)
        choice-arms(syntax, row.right, arms)
        =
arms += id

────────────────────
_ do call-first-items FirstItems
    - module ModuleId
    - owner InstanceId
    - id SyntaxId

` What the reference knows of the items a call of a rule may start with: what the pattern of
` the rule does, judged once for each call met from where the pattern is emitted. A call met
` again while its rule is being judged starts with what is not known, as one whose rule is not
` found does, and cuts the judging of the calls around it. A rule judged with no cut is judged
` once for all patterns, as the reference shares it.
. key = plan-key(module, id)
. kept = first-calls[key] ?? U32.max
if (kept as Size) < found-firsts.length && found-firsts[kept].key == key
    if found-firsts[kept].contextual
        first-cuts += 1
    = found-firsts[kept].items
. none = no-ranges
if first-resolving.find(key) != null
    first-cuts += 1
    = FirstItems(false, false, none, no-probe)
. found = FirstItems(false, false, none, no-probe)
. contextual = false
. target = rule-target(module, owner, id)
if target.pattern != 0
    . shared = shared-first(target)
    if shared
        found = shared
    else
        . prior-cuts = first-cuts
        first-resolving += key
        found = first-items(target.module, target.owner, target.pattern, false)
        first-resolving.pop()
        contextual = first-cuts != prior-cuts
        if !contextual
            share-first(target, found)
first-calls[key] = found-firsts.length as U32
found-firsts += FoundFirst(found, key, contextual)
= found

────────────────────
_ do shared-first FirstItems?
    - target RuleTarget

` What the pattern of a rule was judged to start with for the instance that reads it, where it
` was judged with no cut.
. place = shared-first-heads[plan-key(target.module, target.pattern)] ?? U32.max
while place != U32.max
    . shared = shared-firsts[place]
    if shared.owner == target.owner
        = shared.found
    place = shared.next
= null

────────────────────
_ do share-first
    - target RuleTarget
    - found FirstItems

` Keeps what the pattern of a rule starts with for the instance that reads it, for every
` pattern emitted after.
. key = plan-key(target.module, target.pattern)
shared-firsts += SharedFirst(target.owner, found, shared-first-heads[key] ?? U32.max)
shared-first-heads[key] = (shared-firsts.length - 1) as U32

────────────────────
_ do rule-target RuleTarget
    - module ModuleId
    - owner InstanceId
    - id SyntaxId

` The pattern of the rule a call names, as the reference finds it, with the module that
` declares it and the instance that reads it: a local rule's, as the binder resolved the call,
` or that of a rule a module declares, as the type pass resolved it. No pattern where neither
` is found.
. syntax = program.modules[module].tree
if owner == no-instance
    = RuleTarget(module, owner, 0)
. binding = instances.rows[owner].binding
if binding != no-binding
    . resolution = bindings.resolution-of(binding, id)
    if resolution.kind == .resolve-slot
        . row = bindings.slots[resolution.slot]
        if row.kind == .slot-lazy
            do match? syntax.nodes[row.group]
                | .node-declare(declaration)
                    do match? syntax.nodes[declaration.right]
                        | .node-stream-match(rule)
                            = RuleTarget(module, owner, rule.pattern)
. fact = call-in(owner, id)
if fact != no-fact
    . callee = facts.calls[fact].callee
    if callee != no-instance
        . home = instances.rows[callee].module
        . matched = rule-match(program, home, instances.rows[callee].decl)
        if matched != 0
            do match? program.modules[home].tree.nodes[matched]
                | .node-stream-match(rule)
                    = RuleTarget(home, callee, rule.pattern)
= RuleTarget(module, owner, 0)

────────────────────
_ do stream-repeat StreamPart
    - run StreamRun
    - id SyntaxId
    - operand SyntaxId
    - least U64
    - most U64
    - cursor Operand
    - failed IRBlockId
    - scans Bool
    - least-at SyntaxId = 0
    - most-at SyntaxId = 0

` A part taken as often as it passes from a cursor, at most `most` times, which has no bound
` at `U64.max`. Unbounded, it stops where the part passed without moving on, which one that
` `advances` never does: it stops only where a try of it fails, which reads farther and fails
` farther than any try before it, so that the part is its `deferred-part`. It passes where
` it took the part at least `least` times, with the cursor where the last one ended. A bound
` computed as the match runs is read as a Size: `most-at` before the part is first taken,
` and `least-at` after it is taken for the last time, as the reference reads them. Each name
` the part captures has a list, empty as the repeat starts, which each pass that passes adds
` what it captured to. A repeat the type pass planned to give the values of its part keeps
` them in a list the same way, which it gives where it passes. One the reference `scans` tests
` each item, and keeps no cursor its part failed at. The lists names accumulate in the part
` are cut back where a pass fails to what they held as it began, and where the repeat fails
` to what they held as it began. Each pass begins holding no rollback mark, and gives back the
` one it holds where it fails; the repeat keeps the earliest its passes that passed held, which
` it gives back where it fails, and holds where it passes where it held none before.
. entered = mark-levels(operand)
. saved = enter-marks(id)
. gathered = no-local
if saved != no-local
    gathered = ir.add-local(ir.locals[streaming.rollback-mark].layout)
    store-local(gathered, no-mark(id).operand, id)
. spot = ir.add-local(run.index-layout)
. counts = most != U64.max || most-at != 0 || least != 0 || least-at != 0
. taken = if counts then ir.add-local(u64-layout) else no-local
store-local(spot, cursor, id)
if counts
    store-local(taken, integer(.machine-u64, 0), id)
. values = value-level(id)
if values
    start-level(values, id)
. listing [U32]
. depths [U32]
repeat-levels(operand, 1, listing, depths)
for position in listing
    start-level(capture-levels[position], id)
. limit = no-local
if most-at != 0
    . most-value = count-of(most-at)
    limit = ir.add-local(u64-layout)
    store-local(limit, most-value.operand, id)
. test = ir.reserve-block()
. body = ir.reserve-block()
. done = ir.reserve-block()
jump(test)
ir.start-block(test)
if limit != no-local
    branch(compare(id, .compare-less, load-local(taken, id), load-local(limit, id)), body, done)
else if most == U64.max
    jump(body)
else
    branch
        - compare(id, .compare-less, load-local(taken, id), integer(.machine-u64, most))
        - body
        - done
ir.start-block(body)
clear-mark(id)
. begun = load-local(spot, id)
. passing = mark-levels(operand)
. missed = if passing.length == 0 && saved == no-local then done else ir.reserve-block()
. onward = most == U64.max && most-at == 0 && advances(operand)
scanning = scans
deferred-part = if onward then plan-key(unit.source-module, lowered-part(operand)) else U64.max
. took = emit-stream-part(run, operand, begun, missed)
. next = took.ending
deferred-part = U64.max
scanning = false
gather-mark(gathered, id)
if values
    if took.value.type == no-type
        refuse(.refused-expression, id)
        = bare-part(cursor)
    append-level(values, took.value, id)
for index in 0 .. < listing.length
    . position = listing[index]
    . capture = stream-captures[capture-levels[position].capture]
    . element = if depths[index] > 1 then level-list(capture-levels[position - 1], id) else captured-element(capture, position, id)
    append-level(capture-levels[position], element, capture.site)
store-local(spot, next, id)
if counts
    store-local
        - taken
        - arithmetic
            - id
            - .arithmetic-add
            - load-local(taken, id)
            - integer(.machine-u64, 1)
            - u64-layout
        - id
if most == U64.max && !onward
    branch(compare(id, .compare-greater, next, begun), test, done)
else
    jump(test)
if passing.length != 0 || saved != no-local
    ir.start-block(missed)
    rewind-levels(passing, id)
    rewind-mark(id)
    jump(done)
ir.start-block(done)
. finish = load-local(spot, id)
. short = failed
if entered.length != 0 || saved != no-local
    short = ir.reserve-block()
. given = Typed(make-operand(.operand-void, 0), no-type)
if values
    given = Typed(level-list(values, id).operand, values.list)
if least-at != 0
    . least-value = count-of(least-at)
    . counted = ir.reserve-block()
    branch(compare(id, .compare-greater-equal, load-local(taken, id), least-value.operand), counted, short)
    cut-repeat(entered, saved, gathered, short, failed, id)
    ir.start-block(counted)
    settle-repeat(saved, gathered, id)
    = StreamPart(finish, given)
if least == 0
    settle-repeat(saved, gathered, id)
    = StreamPart(finish, given)
. enough = ir.reserve-block()
branch
    - compare(id, .compare-greater-equal, load-local(taken, id), integer(.machine-u64, least))
    - enough
    - short
cut-repeat(entered, saved, gathered, short, failed, id)
ir.start-block(enough)
settle-repeat(saved, gathered, id)
= StreamPart(finish, given)

────────────────────
_ do advances Bool
    - id SyntaxId

` Whether a part of a pattern moves on by at least one item wherever it passes: text that
` holds some, a range or any item, a sequence with such a part, a choice whose alternatives
` all are, and one or more of such a part, or a count of one at least.
do match? tree.nodes[id]
    | .node-stream-string(row)
        = row.text.length != 0
    | .node-stream-any
        = true
    | .node-stream-char-range
        = true
    | .node-stream-and(row)
        = advances(row.left) || advances(row.right)
    | .node-stream-or(row)
        = advances(row.left) && advances(row.right)
    | .node-stream-capture(row)
        = advances(row.pattern)
    | .node-stream-transform(row)
        = row.pattern != 0 && tree.lazies-only(row.right) && advances(row.pattern)
    | .node-stream-unary(row)
        = row.op == .one-or-more-op && advances(row.operand)
    | .node-stream-length(row)
        = literal-bound(tree, row.min) && stream-bound(tree, row.min) != 0 && advances(row.operand)
= false

────────────────────
_ do cut-repeat
    - marks [LevelMark]
    - saved LocalId
    - gathered LocalId
    - block IRBlockId
    - failed IRBlockId
    - site SyntaxId

` Emits the block a repeat that passed too few times goes to, where any lists were marked or
` the pattern holds rollback marks: it cuts the lists back to what they held where the repeat
` began, gives back the rollback mark its passes held, and holds the one it held before; then
` it goes on to `failed`.
if marks.length == 0 && saved == no-local
    =
ir.start-block(block)
rewind-levels(marks, site)
if saved != no-local
    store-local(streaming.rollback-mark, load-local(gathered, site), site)
    fail-marks(saved, site)
jump(failed)

────────────────────
_ do captured-element Typed
    - capture StreamCapture
    - position U32
    - id SyntaxId

` What a name a pass of a repeat captured, which the repeat adds to its list: the item a test
` passed, as it was kept, the text between the cursors its part began and ended at, or, for a
` name a helper makes, the range of those cursors.
if capture.value != no-local
    = Typed(load-local(capture.value, id), capture-levels[position].item)
if material-at(capture.site, .material-ranges) != U32.max
    . item = capture-levels[position].item
    . layout = layout-of(item, id)
    . range = frame(layout)
    put(range, tables.layouts.field(layout, 0), load-local(capture.begin, id), id)
    put(range, tables.layouts.field(layout, 1), load-local(capture.end, id), id)
    = Typed(range, item)
= stream-text(capture.run, capture.site, load-local(capture.begin, id), load-local(capture.end, id))

────────────────────
_ do value-level CaptureLevel?
    - id SyntaxId

` The list a repeat keeps of what its part gives on each pass, where the type pass planned
` the repeat to give them: its collector, by the call recorded at the repeat that grows it.
if facts.plan-of(unit.reading, id) != .plan-stream-value
    = null
. list = facts.node-type(unit.reading, id)
. fact = facts.first-call(unit.reading, id)
. callee = if fact != no-fact then facts.calls[fact].callee else no-instance
if callee == no-instance
    refuse(.refused-expression, id)
    = null
. collector = instances.rows[callee].self-type
. items = ir.add-local(layout-of(instances.signatures[callee].returns, id))
. size = ir.add-local(u64-layout)
. context = context-local(collector, id)
= CaptureLevel(U32.max, items, size, fact, collector, class-arg(types, collector, 0), list, context)

────────────────────
_ do repeat-levels
    - id SyntaxId
    - depth U32
    - listing [U32]
    - depths [U32]

` The lists a repeat keeps for the names its part captures, with how many repeats deep in
` it each name lies, counting the repeat itself.
do match? tree.nodes[id]
    | .node-stream-capture(row)
        . held = captured-at(captured-slot(row.name))
        if held != U32.max && !stream-captures[held].accumulates && deep-enough
            . position = stream-captures[held].levels + depth - 1
            if listing.find(position) == null
                listing += position
                depths += depth
        .. deep-enough = stream-captures[held].listed >= depth
        repeat-levels(row.pattern, depth, listing, depths)
    | .node-stream-and(row)
        repeat-levels(row.left, depth, listing, depths)
        repeat-levels(row.right, depth, listing, depths)
    | .node-stream-or(row)
        repeat-levels(row.left, depth, listing, depths)
        repeat-levels(row.right, depth, listing, depths)
    | .node-stream-transform(row)
        repeat-levels(row.pattern, depth, listing, depths)
    | .node-stream-panic(row)
        repeat-levels(row.pattern, depth, listing, depths)
    | .node-stream-unary(row)
        . repeat = row.op == .zero-or-more-op || row.op == .one-or-more-op
        repeat-levels(row.operand, if repeat then depth + 1 else depth, listing, depths)
    | .node-stream-length(row)
        repeat-levels(row.operand, depth + 1, listing, depths)

────────────────────
_ do level-list Typed
    - level CaptureLevel
    - site SyntaxId

` The list a repeat made of what a name captured, or of what its part gave, on each of its
` passes: an `ImmutableArray` over the collector's items, as many as it holds.
. layout = layout-of(level.list, site)
. items-layout = ir.locals[level.items].layout
. list = frame(layout)
put
    - list
    - tables.layouts.field(layout, 0)
    - take(load-local(level.items, site), tables.layouts.field(items-layout, 0), site)
    - site
put(list, tables.layouts.field(layout, 1), load-local(level.size, site), site)
= Typed(list, level.list)

────────────────────
_ do append-level
    - level CaptureLevel
    - element Typed
    - site SyntaxId

` Adds an item to a list, as the reference's collector adds one: where its items
` are full, they grow, in the arena of the context of a collector backed by one as the
` reference grows an arena's builder, and else by the call the type pass recorded; the item is
` stored after the last, through the write barrier where it is managed, and the size counts it.
if element.type != level.item
    refuse(.refused-expression, site)
    =
. item-layout = layout-of(level.item, site)
. collector-layout = layout-of(level.collector, site)
. items-layout = ir.locals[level.items].layout
. count-field = tables.layouts.field(items-layout, 1)
. size = load-local(level.size, site)
if class-arg(types, level.collector, 1) == types.arena-backing-type
    grow-in-arena(level, item-layout, size, site)
    put-item(level, size, element.operand, item-layout, site)
    store-local
        - level.size
        - arithmetic(site, .arithmetic-add, size, integer(.machine-u64, 1), u64-layout)
        - site
    =
. capacity = num-cast
    - site
    - take(load-local(level.items, site), count-field, site)
    - count-field.layout
    - u64-layout
. growing = ir.reserve-block()
. joined = ir.reserve-block()
branch(compare(site, .compare-equal, size, capacity), growing, joined)
ir.start-block(growing)
. collector = frame(collector-layout)
put(collector, tables.layouts.field(collector-layout, 0), load-local(level.items, site), site)
put(collector, tables.layouts.field(collector-layout, 1), size, site)
if level.context != no-local
    put(collector, tables.layouts.field(collector-layout, 2), load-local(level.context, site), site)
. grown = call-protocol
    - site
    - level.grow
    - collector
    - level.collector
    - make-operand(.operand-void, 0)
store-local(level.items, grown.operand, site)
jump(joined)
ir.start-block(joined)
put-item(level, size, element.operand, item-layout, site)
store-local
    - level.size
    - arithmetic(site, .arithmetic-add, size, integer(.machine-u64, 1), u64-layout)
    - site

────────────────────
_ do grow-in-arena
    - level CaptureLevel
    - item-layout LayoutId
    - size Operand
    - site SyntaxId

` Makes room for one more item after the `size` a list holds in the arena its context names,
` as the reference grows an arena's builder: the items are described to the arena where they
` hold pointers the collector follows.
. items-layout = ir.locals[level.items].layout
. context-layout = if level.context != no-local then local-layout else void-layout
    .. local-layout = ir.locals[level.context].layout
if level.context == no-local || !tables.layouts.is-struct(context-layout) || unpaired-context
    refuse(.refused-expression, site)
    =
.. unpaired-context = tables.layouts.rows[context-layout].fields.count != 2
. data-field = tables.layouts.field(items-layout, 0)
. count-field = tables.layouts.field(items-layout, 1)
. held = load-local(level.items, site)
. current = BuilderItems
    - num-cast(site, take(held, data-field, site), data-field.layout, u64-layout)
    - num-cast(site, take(held, count-field, site), count-field.layout, u64-layout)
. context = load-local(level.context, site)
. needed = arithmetic(site, .arithmetic-add, size, integer(.machine-u64, 1), u64-layout)
. traced = tables.layouts.rows[item-layout].is-managed
. grown = reserve-items
    - site
    - item-layout
    - traced
    - word-at(site, context, context-layout, 0)
    - word-at(site, context, context-layout, 1)
    - current
    - needed
. items = frame(items-layout)
put(items, data-field, num-cast(site, grown.storage, u64-layout, data-field.layout), site)
put(items, count-field, num-cast(site, grown.capacity, u64-layout, count-field.layout), site)
store-local(level.items, items, site)

────────────────────
_ do context-local LocalId
    - collector TypeId
    - site SyntaxId

` The local a list kept in a collector of a type holds the context of its backing in, where
` the backing is not the collector's, or none.
if class-arg(types, collector, 1) == types.gc-backing-type
    = no-local
. layout = layout-of(collector, site)
= ir.add-local(tables.layouts.field(layout, 2).layout)

────────────────────
_ do start-level
    - level CaptureLevel
    - site SyntaxId

` Empties a list as the reference makes a collector: no items, none counted, and, where its
` backing is not the collector's, the context the helper gives for it, read each time.
zero(load-local(level.items, site), ir.locals[level.items].layout)
store-local(level.size, integer(.machine-u64, 0), site)
if level.context == no-local
    =
if streaming.storage-row == U32.max || streaming.pattern-helper-type == no-type
    refuse(.refused-expression, site)
    =
. row = facts.storage-bodies[streaming.storage-row]
. context = read-through(site, Typed(streaming.pattern-helper, streaming.pattern-helper-type), row.through)
if layout-of(context.type, site) != ir.locals[level.context].layout
    refuse(.refused-expression, site)
    =
store-local(level.context, context.operand, site)

────────────────────
_ do put-item
    - level CaptureLevel
    - index Operand
    - element Operand
    - item-layout LayoutId
    - site SyntaxId

` Stores an item of a list at an index its items hold, through the write barrier where it is
` managed.
. items-layout = ir.locals[level.items].layout
. width = tables.layouts.rows[item-layout].size as U64
. storage-field = tables.layouts.field(items-layout, 0)
. storage = take(load-local(level.items, site), storage-field, site)
. distance = arithmetic(site, .arithmetic-multiply, index, integer(.machine-u64, width), u64-layout)
. place = num-cast
    - site
    - arithmetic
        - site
        - .arithmetic-add
        - num-cast(site, storage, storage-field.layout, u64-layout)
        - distance
        - u64-layout
    - u64-layout
    - pointer-layout
. managed = tables.layouts.rows[item-layout].is-managed
if tables.layouts.is-struct(item-layout)
    copy(address(place, 0, item-layout, site), element, item-layout, managed, site)
else
    store(place, 0, element, managed && is-managed-pointer(item-layout), site)

────────────────────
_ do count-of Typed
    - bound SyntaxId

` A bound of a count computed as the match runs, as a Size.
. value = emit-expression(bound)
. layout = layout-of(value.type, bound)
if !is-integer(layout)
    refuse(.refused-type, bound)
    = value
= Typed(num-cast(bound, value.operand, layout, u64-layout), value.type)

────────────────────
_ literal-bound Bool
    - syntax AST
    - id SyntaxId

` Whether a bound of a count is a number written.
match syntax.nodes[id]
    | .node-integer-syntax(row)
        !row.unit
    ??
        false

────────────────────
_ do stream-lookahead Operand
    - run StreamRun
    - id SyntaxId
    - operand SyntaxId
    - positive Bool
    - cursor Operand
    - failed IRBlockId

` A part tried from a cursor for whether it passes, which leaves the cursor where it was: a
` positive lookahead passes where the part does, and a negative one where it fails. Either way
` the lists names accumulate in the part are cut back to what they held before it, and the
` rollback mark the part holds is given back.
. passed = ir.reserve-block()
. missed = ir.reserve-block()
. marks = mark-levels(operand)
. entered = enter-marks(id)
emit-stream-part(run, operand, cursor, missed)
if streaming.observer-row != U32.max && !scanning && !streaming.classing
    rewind-literals(id, cursor)
rewind-levels(marks, id)
fail-marks(entered, id)
jump(if positive then passed else failed)
ir.start-block(missed)
rewind-levels(marks, id)
fail-marks(entered, id)
jump(if positive then failed else passed)
ir.start-block(passed)
= cursor

────────────────────
_ do stream-guard Operand
    - id SyntaxId
    - operand SyntaxId
    - positive Bool
    - cursor Operand
    - failed IRBlockId

` A lookahead of a test that does not read the item, which the type pass planned as a guard: its
` condition is tested alone, reading no item, and a positive one passes where it holds and a
` negative one where it does not. Either way the cursor stays where it was.
. predicate SyntaxId = match tree.nodes[operand]
    | .node-stream-predicate(row)
        row.predicate
    ??
        0
if predicate == 0
    refuse(.refused-expression, id)
    = cursor
. holds = test(predicate, emit-expression(predicate)).operand
. passed = ir.reserve-block()
branch(holds, if positive then passed else failed, if positive then failed else passed)
ir.start-block(passed)
= cursor

────────────────────
_ do stream-advance Operand
    - run StreamRun
    - id SyntaxId
    - cursor Operand
    - count U64

` A cursor moved on by a count of items.
if count == 0
    = cursor
= arithmetic
    - id
    - .arithmetic-add
    - cursor
    - integer(tables.layouts.rows[run.index-layout].kind, count)
    - run.index-layout

────────────────────
_ do stream-item Operand
    - run StreamRun
    - id SyntaxId
    - spot Operand

` The item of the stream's buffer at a cursor the pattern knows is inside it: a struct as its
` address there, and anything else loaded.
. stride = integer(.machine-u64, tables.layouts.rows[run.item-layout].size)
. offset = arithmetic
    - id
    - .arithmetic-multiply
    - num-cast(id, spot, run.index-layout, u64-layout)
    - stride
    - u64-layout
. cell = moved-bytes(id, run-data(run, id), offset)
if tables.layouts.is-struct(run.item-layout)
    = address(cell, 0, run.item-layout, id)
= load(cell, 0, run.item-layout, id)

────────────────────
_ encodes Bool
    - run StreamRun

` Whether the buffer of the stream a pattern runs on holds the UTF-8 bytes of the characters the
` stream gives, as a `TextTokenStream`'s text view does, rather than the characters: its cursors
` count bytes, and a character is read from the byte it starts at.
item == char && class-arg(types, run.buffer-type, 0) == types.type-row(.uint8)

.. char = types.type-row(.char)
.. item = if same-ref(class-ref(types, run.stream-type), types.text-token-stream-decl) then char else class-arg(types, run.stream-type, 0)

────────────────────
_ do read-layout LayoutId
    - run StreamRun
    - id SyntaxId

` The layout of an item a part of a pattern reads as a value: a character where the buffer is
` UTF-8, and else the buffer's item.
= if encodes(run) then layout-of(types.type-row(.char), id) else run.item-layout

────────────────────
_ do wide-ranges Bool
    - run StreamRun
    - ranges [ItemRange]

` Whether ranges of characters are not tested on the byte a character starts with where the
` buffer is UTF-8: where one holds characters past ASCII, but not every one.
if !encodes(run)
    = false
for range in ranges
    if range.last >= 0x80 && (range.first > 0x80 || range.last < any-item)
        = true
= false

────────────────────
_ do char-width Operand
    - run StreamRun
    - id SyntaxId
    - lead Operand

` The count of bytes of the character whose UTF-8 starts with a byte, as an index: one, and one
` more for each of 0xC0, 0xE0 and 0xF0 the byte reaches.
. width = arithmetic
    - id
    - .arithmetic-add
    - integer(tables.layouts.rows[run.index-layout].kind, 1)
    - reaches(run, id, lead, 0xC0)
    - run.index-layout
width = arithmetic(id, .arithmetic-add, width, reaches(run, id, lead, 0xE0), run.index-layout)
= arithmetic(id, .arithmetic-add, width, reaches(run, id, lead, 0xF0), run.index-layout)

────────────────────
_ do reaches Operand
    - run StreamRun
    - id SyntaxId
    - lead Operand
    - bound U64

` One, as an index, where a byte is at least a bound, and else none.
= num-cast
    - id
    - compare
        - id
        - .compare-greater-equal
        - lead
        - integer(tables.layouts.rows[run.item-layout].kind, bound)
    - u8-layout
    - run.index-layout

────────────────────
_ do char-next Operand
    - run StreamRun
    - id SyntaxId
    - cursor Operand

` The cursor past the item at a cursor the pattern knows is inside the buffer: past the bytes of
` the character there where the buffer is UTF-8, and else the next.
if !encodes(run)
    = stream-advance(run, id, cursor, 1)
= arithmetic
    - id
    - .arithmetic-add
    - cursor
    - char-width(run, id, stream-item(run, id, cursor))
    - run.index-layout

────────────────────
_ do advance-chars Operand
    - run StreamRun
    - id SyntaxId
    - cursor Operand
    - count U64

` The cursor a count of characters past a cursor in a UTF-8 buffer, or the end of the input
` where it ends first.
. kind = tables.layouts.rows[run.index-layout].kind
. at = ir.add-local(run.index-layout)
store-local(at, cursor, id)
. left = ir.add-local(run.index-layout)
store-local(left, integer(kind, count), id)
. test = ir.reserve-block()
. inside = ir.reserve-block()
. step = ir.reserve-block()
. done = ir.reserve-block()
jump(test)
ir.start-block(test)
branch(compare(id, .compare-greater, load-local(left, id), integer(kind, 0)), inside, done)
ir.start-block(inside)
branch(compare(id, .compare-less, load-local(at, id), run-length(run, id)), step, done)
ir.start-block(step)
store-local(at, char-next(run, id, load-local(at, id)), id)
store-local
    - left
    - arithmetic(id, .arithmetic-subtract, load-local(left, id), integer(kind, 1), run.index-layout)
    - id
jump(test)
ir.start-block(done)
= load-local(at, id)

────────────────────
_ do char-at Operand
    - run StreamRun
    - id SyntaxId
    - spot Operand

` The item at a cursor the pattern knows is inside the buffer, as `stream-item` reads it, but
` where the buffer is UTF-8, the character whose bytes start there, decoded: a byte below 0x80
` is the character, and else the bits a lead byte keeps for it are followed by six of each
` byte after it.
if !encodes(run)
    = stream-item(run, id, spot)
. layout = layout-of(types.type-row(.char), id)
. value = ir.add-local(layout)
. lead = stream-item(run, id, spot)
. wide = num-cast(id, lead, run.item-layout, layout)
. single = ir.reserve-block()
. multiple = ir.reserve-block()
. two = ir.reserve-block()
. longer = ir.reserve-block()
. three = ir.reserve-block()
. four = ir.reserve-block()
. done = ir.reserve-block()
. byte-kind = tables.layouts.rows[run.item-layout].kind
branch(compare(id, .compare-less, lead, integer(byte-kind, 0x80)), single, multiple)
ir.start-block(single)
store-local(value, wide, id)
jump(done)
ir.start-block(multiple)
. second = continuation(run, id, spot, 1, layout)
branch(compare(id, .compare-less, lead, integer(byte-kind, 0xE0)), two, longer)
ir.start-block(two)
store-local
    - value
    - merged(id, shifted(id, masked(id, wide, 0x1F, layout), 6, layout), second, layout)
    - id
jump(done)
ir.start-block(longer)
. third = continuation(run, id, spot, 2, layout)
branch(compare(id, .compare-less, lead, integer(byte-kind, 0xF0)), three, four)
ir.start-block(three)
. upper = merged
    - id
    - shifted(id, masked(id, wide, 0x0F, layout), 12, layout)
    - shifted(id, second, 6, layout)
    - layout
store-local(value, merged(id, upper, third, layout), id)
jump(done)
ir.start-block(four)
. fourth = continuation(run, id, spot, 3, layout)
. high = merged
    - id
    - shifted(id, masked(id, wide, 0x07, layout), 18, layout)
    - shifted(id, second, 12, layout)
    - layout
store-local
    - value
    - merged(id, merged(id, high, shifted(id, third, 6, layout), layout), fourth, layout)
    - id
jump(done)
ir.start-block(done)
= load-local(value, id)

────────────────────
_ do continuation Operand
    - run StreamRun
    - id SyntaxId
    - spot Operand
    - offset U64
    - layout LayoutId

` The six bits a continuation byte of a character in a UTF-8 buffer keeps, some bytes past the
` cursor its character starts at, as a number of a layout.
. byte = stream-item(run, id, stream-advance(run, id, spot, offset))
= masked(id, num-cast(id, byte, run.item-layout, layout), 0x3F, layout)

────────────────────
_ do masked Operand
    - id SyntaxId
    - value Operand
    - mask U64
    - layout LayoutId

= bitwise(id, .bitwise-and, value, integer(tables.layouts.rows[layout].kind, mask), layout)

────────────────────
_ do shifted Operand
    - id SyntaxId
    - value Operand
    - shift U64
    - layout LayoutId

= bitwise(id, .bitwise-shift-left, value, integer(tables.layouts.rows[layout].kind, shift), layout)

────────────────────
_ do merged Operand
    - id SyntaxId
    - left Operand
    - right Operand
    - layout LayoutId

= bitwise(id, .bitwise-or, left, right, layout)

────────────────────
_ do text-span Typed
    - capture StreamCapture
    - id SyntaxId
    - type TypeId

. nothing = make-operand(.operand-void, 0)
. run = capture.run
. layout = layout-of(type, id)
if !tables.layouts.is-struct(layout) || tables.layouts.rows[layout].fields.count != 3
    refuse(.refused-type, id)
    = Typed(nothing, no-type)
. source-field = tables.layouts.field(layout, 0)
. start-field = tables.layouts.field(layout, 1)
. end-field = tables.layouts.field(layout, 2)
if source-field.layout != run.buffer-layout || unindexed-bounds
    refuse(.refused-type, id)
    = Typed(nothing, no-type)
.. unindexed-bounds = start-field.layout != run.index-layout || end-field.layout != run.index-layout
. buffer = run-buffer(run, id)
. span = frame(layout)
put(span, source-field, buffer, id)
put(span, start-field, load-local(capture.begin, id), id)
put(span, end-field, load-local(capture.end, id), id)
= Typed(span, type)

────────────────────
_ do stream-text Typed
    - run StreamRun
    - site SyntaxId
    - begun Operand
    - ending Operand

` The text a part of a pattern matched: the part of the stream's buffer between two cursors,
` as an array that shares the buffer's items, made text by the call the type pass recorded
` where the text is given, after the two that read text a value gives where the part is one;
` or where a helper makes it, what its materializer makes of the buffer and the cursors.
. nothing = make-operand(.operand-void, 0)
. made = material-at(site, .material-text)
if made != U32.max
    = material-capture(run, site, made, begun, ending)
. fact = facts.first-call(unit.reading, site)
if tree.nodes[site] is .node-stream-equality
    fact = next-call(next-call(fact))
if fact == no-fact
    refuse(.refused-expression, site)
    = Typed(nothing, no-type)
= call-protocol(site, fact, stream-slice(run, site, begun, ending).operand, run.buffer-type, nothing)

────────────────────
_ do material-at U32
    - site SyntaxId
    - kind MaterialKind

` The first value of a kind the helper makes at a place, as the type pass recorded it, or
` `U32.max`.
. row = facts.first-material(unit.reading, site)
while row != U32.max
    if facts.materials[row].kind == kind
        = row
    row = facts.materials[row].next
= U32.max

────────────────────
_ do material-receiver Typed
    - site SyntaxId

` The helper the match keeps, which a materializer is called for: by the properties the type
` pass kept at the materializer's call, read from it in turn, as `call-protocol` reads them.
if streaming.pattern-helper-type == no-type
    refuse(.refused-expression, site)
= Typed(streaming.pattern-helper, streaming.pattern-helper-type)

────────────────────
_ do material-capture Typed
    - run StreamRun
    - site SyntaxId
    - row U32
    - begun Operand
    - ending Operand

` What a capture materializer makes of the stream's buffer and two cursors, by the call the
` type pass recorded. A rule's function, given where the items start and their count, gives it
` an array that shares them.
. fact = facts.materials[row]
. receiver = material-receiver(site)
. receiver-type = receiver.type
. buffer = run-buffer(run, site)
. answer = call-protocol
    - site
    - fact.call
    - receiver.operand
    - receiver-type
    - buffer
    - run.buffer-type
    - true
    - begun
    - types.index-type
    - ending
    - types.index-type
= answer

────────────────────
_ do span-text Typed
    - site SyntaxId
    - span Operand
    - type TypeId
    - call FactId

` The text of the items a `CaptureSpan` spans, as an action reads a name that holds one: the
` part of its source between its cursors, as an array that shares the source's items, made
` text by the call the type pass recorded.
. nothing = make-operand(.operand-void, 0)
. layout = layout-of(type, site)
if !tables.layouts.is-struct(layout) || tables.layouts.rows[layout].fields.count != 3
    refuse(.refused-type, site)
    = Typed(nothing, no-type)
. source-field = tables.layouts.field(layout, 0)
. start-field = tables.layouts.field(layout, 1)
. end-field = tables.layouts.field(layout, 2)
. item-layout = layout-of(class-arg(types, type, 0), site)
if !tables.layouts.is-struct(source-field.layout) || unpaired-source || uneven-bounds
    refuse(.refused-type, site)
    = Typed(nothing, no-type)
.. unpaired-source = tables.layouts.rows[source-field.layout].fields.count != 2
.. uneven-bounds = start-field.layout != end-field.layout || !is-integer(start-field.layout)
. data-field = tables.layouts.field(source-field.layout, 0)
. size-field = tables.layouts.field(source-field.layout, 1)
. source = take(span, source-field, site)
. begun = take(span, start-field, site)
. ending = take(span, end-field, site)
. stride = integer(.machine-u64, tables.layouts.rows[item-layout].size)
. offset = arithmetic
    - site
    - .arithmetic-multiply
    - num-cast(site, begun, start-field.layout, u64-layout)
    - stride
    - u64-layout
. data = num-cast(site, take(source, data-field, site), data-field.layout, pointer-layout)
. slice = frame(source-field.layout)
put
    - slice
    - data-field
    - num-cast(site, moved-bytes(site, data, offset), pointer-layout, data-field.layout)
    - site
. count = arithmetic(site, .arithmetic-subtract, ending, begun, start-field.layout)
put(slice, size-field, num-cast(site, count, start-field.layout, size-field.layout), site)
= call-protocol(site, call, slice, source-field.type, nothing)

────────────────────
_ do material-value Typed
    - site SyntaxId
    - row U32
    - value Operand
    - given TypeId

` What a value materializer makes of a value, by the call the type pass recorded.
. fact = facts.materials[row]
. receiver = material-receiver(site)
. receiver-type = receiver.type
. answer = call-protocol(site, fact.call, receiver.operand, receiver-type, value, given)
= answer

────────────────────
_ do remake Typed
    - site SyntaxId
    - row U32
    - value Operand
    - given TypeId

` What a helper makes again of what an action gave, by the value materializer the type pass
` recorded: of the value; of what an optional one holds; or, where the call that grows a list
` is recorded after the materializer's, of each item of a list.
. fact = facts.materials[row]
if fact.next != U32.max && facts.materials[fact.next].kind == .material-grow
    = material-items(site, row, fact.next, value, given, class-arg(types, given, 0))
if types.is-optional(given)
    = material-optional(site, row, value, given)
= material-value(site, row, value, given)

────────────────────
_ do material-optional Typed
    - site SyntaxId
    - row U32
    - held Operand
    - given TypeId

` What a value materializer makes of an optional value: of what it holds, only where it holds
` a value, as the optional the type pass recorded; null where it holds none.
. fact = facts.materials[row]
. layout = layout-of(fact.type, site)
. slot = join-slot(layout)
. joined = ir.reserve-block()
. holds = ir.reserve-block()
. empty = ir.reserve-block()
. mark = joins.length
branch(present(site, Typed(held, given)).operand, holds, empty)
ir.start-block(holds)
. inner = payload(site, Typed(held, given))
. made = material-value(site, row, inner.operand, types.optional-inner(given))
arrive(site, wrap(site, made, fact.type).operand, joined, slot)
ir.start-block(empty)
arrive(site, empty-optional(fact.type, layout).operand, joined, slot)
. kept = close-joins(joined, mark, layout, slot)
= Typed(kept, fact.type)

────────────────────
_ do bind-materials
    - run StreamRun
    - action SyntaxId

` Binds each name an action reads that the helper makes to what it makes, in the order the
` type pass recorded them: from the cursors of a name captured over text, only where an
` optional one holds text, or from what a name holds, item by item where it holds a list a
` rule gave.
. row = facts.first-material(unit.reading, action)
while row != U32.max
    . fact = facts.materials[row]
    . current = row
    row = fact.next
    if fact.kind != .material-capture && fact.kind != .material-value && not-span-text
        continue
    .. not-span-text = fact.kind != .material-span-text
    . held = captured-at(fact.slot)
    if held == U32.max
        refuse(.refused-expression, action)
        =
    . capture = stream-captures[held]
    if fact.kind == .material-span-text
        if capture.listed != 0 || capture.value == no-local
            refuse(.refused-expression, action)
            =
        . text = span-text(action, load-local(capture.value, action), capture.type, fact.call)
        bound += BoundValue(fact.slot, fact.type, text.operand)
        continue
    if capture.listed != 0
        if fact.next == U32.max || facts.materials[fact.next].kind != .material-grow
            refuse(.refused-expression, action)
            =
        . made = material-list(run, action, current, capture, fact.next)
        bound += BoundValue(fact.slot, fact.type, made.operand)
        continue
    if fact.kind == .material-value
        if capture.value == no-local
            refuse(.refused-expression, action)
            =
        . held-value = load-local(capture.value, action)
        if fact.next != U32.max && facts.materials[fact.next].kind == .material-grow
            . items = material-items
                - action
                - current
                - fact.next
                - held-value
                - capture.type
                - class-arg(types, capture.type, 0)
            bound += BoundValue(fact.slot, fact.type, items.operand)
            continue
        if !types.is-optional(capture.type)
            . made = material-value(action, current, held-value, capture.type)
            bound += BoundValue(fact.slot, fact.type, made.operand)
            continue
        . kept = material-optional(action, current, held-value, capture.type)
        bound += BoundValue(fact.slot, fact.type, kept.operand)
        continue
    if capture.present == no-local
        . made = material-capture
            - run
            - action
            - current
            - load-local(capture.begin, action)
            - load-local(capture.end, action)
        bound += BoundValue(fact.slot, fact.type, made.operand)
        continue
    . layout = layout-of(fact.type, action)
    . slot = join-slot(layout)
    . joined = ir.reserve-block()
    . holds = ir.reserve-block()
    . empty = ir.reserve-block()
    . mark = joins.length
    branch
        - compare
            - action
            - .compare-not-equal
            - load-local(capture.present, action)
            - integer(.machine-u8, 0)
        - holds
        - empty
    ir.start-block(holds)
    . made = material-capture
        - run
        - action
        - current
        - load-local(capture.begin, action)
        - load-local(capture.end, action)
    arrive(action, wrap(action, made, fact.type).operand, joined, slot)
    ir.start-block(empty)
    arrive(action, empty-optional(fact.type, layout).operand, joined, slot)
    . result = close-joins(joined, mark, layout, slot)
    bound += BoundValue(fact.slot, fact.type, result)

────────────────────
_ do material-list Typed
    - run StreamRun
    - action SyntaxId
    - row U32
    - capture StreamCapture
    - grower U32

` The list a helper makes of a name captured in a repeat, as `material-items` makes it of the
` list its passes kept.
. source = capture-levels[capture.levels + capture.listed - 1]
= material-items(action, row, grower, level-list(source, action).operand, source.list, source.item, run)

────────────────────
_ do material-items Typed
    - action SyntaxId
    - row U32
    - grower U32
    - ranges Operand
    - list TypeId
    - item TypeId
    - run StreamRun? = null

` The list a helper makes of a list, in order: what the capture materializer makes of each
` range kept over the text of `run`, or the value materializer of each value, added to a
` collector of its own, grown by the call the type pass recorded, which the list then reads.
. nothing = make-operand(.operand-void, 0)
. ranges-layout = layout-of(list, action)
. item-layout = layout-of(item, action)
. grow = facts.materials[grower]
. callee = facts.calls[grow.call].callee
if callee == no-instance
    refuse(.refused-expression, action)
    = Typed(nothing, no-type)
. level = CaptureLevel
    - U32.max
    - ir.add-local(layout-of(instances.signatures[callee].returns, action))
    - ir.add-local(u64-layout)
    - grow.call
    - grow.type
    - class-arg(types, grow.type, 0)
    - facts.materials[row].type
    - context-local(grow.type, action)
start-level(level, action)
. data-field = tables.layouts.field(ranges-layout, 0)
. count-field = tables.layouts.field(ranges-layout, 1)
. data = num-cast(action, take(ranges, data-field, action), data-field.layout, u64-layout)
. count = num-cast(action, take(ranges, count-field, action), count-field.layout, u64-layout)
. index = ir.add-local(u64-layout)
store-local(index, integer(.machine-u64, 0), action)
. test = ir.reserve-block()
. body = ir.reserve-block()
. done = ir.reserve-block()
jump(test)
ir.start-block(test)
. current = load-local(index, action)
branch(compare(action, .compare-less, current, count), body, done)
ir.start-block(body)
. stride = integer(.machine-u64, tables.layouts.rows[item-layout].size)
. offset = arithmetic(action, .arithmetic-multiply, current, stride, u64-layout)
. place = num-cast
    - action
    - arithmetic(action, .arithmetic-add, data, offset, u64-layout)
    - u64-layout
    - pointer-layout
. element = Typed(make-operand(.operand-void, 0), no-type)
if facts.materials[row].kind == .material-capture
    if run == null
        refuse(.refused-expression, action)
        = Typed(nothing, no-type)
    . range = address(place, 0, item-layout, action)
    . begun = take(range, tables.layouts.field(item-layout, 0), action)
    . ending = take(range, tables.layouts.field(item-layout, 1), action)
    element = material-capture(run, action, row, begun, ending)
else
    . given = if tables.layouts.is-struct(item-layout) then address(place, 0, item-layout, action) else load(place, 0, item-layout, action)
    element = material-value(action, row, given, item)
append-level(level, element, action)
store-local
    - index
    - arithmetic(action, .arithmetic-add, current, integer(.machine-u64, 1), u64-layout)
    - action
jump(test)
ir.start-block(done)
= level-list(level, action)

────────────────────
_ do stream-slice Typed
    - run StreamRun
    - site SyntaxId
    - begun Operand
    - ending Operand

` The part of the stream's buffer between two cursors, as an array that shares the buffer's
` items.
. slice = frame(run.buffer-layout)
. data-field = tables.layouts.field(run.buffer-layout, 0)
. size-field = tables.layouts.field(run.buffer-layout, 1)
. stride = integer(.machine-u64, tables.layouts.rows[run.item-layout].size)
. offset = arithmetic
    - site
    - .arithmetic-multiply
    - num-cast(site, begun, run.index-layout, u64-layout)
    - stride
    - u64-layout
put
    - slice
    - data-field
    - num-cast
        - site
        - moved-bytes(site, run-data(run, site), offset)
        - pointer-layout
        - data-field.layout
    - site
. count = arithmetic(site, .arithmetic-subtract, ending, begun, run.index-layout)
put(slice, size-field, num-cast(site, count, run.index-layout, size-field.layout), site)
= Typed(slice, run.buffer-type)

────────────────────
_ do record-extent
    - run StreamRun
    - id SyntaxId
    - probe Operand

` Keeps how far the pattern read: the farthest of what it had read and a cursor it read up to.
. farther = ir.reserve-block()
. kept = ir.reserve-block()
branch(compare(id, .compare-greater, probe, load-local(run.extent, id)), farther, kept)
ir.start-block(farther)
store-local(run.extent, probe, id)
jump(kept)
ir.start-block(kept)

────────────────────
_ do record-error
    - run StreamRun
    - id SyntaxId
    - cursor Operand

` Keeps the farthest cursor a part of the pattern failed at: the cursor where a part that
` failed began, or where an arm that had to read the whole input ended. The test of an item a
` repeat scans keeps none.
if scanning
    =
. farther = ir.reserve-block()
. kept = ir.reserve-block()
branch(compare(id, .compare-greater, cursor, load-local(run.error, id)), farther, kept)
ir.start-block(farther)
store-local(run.error, cursor, id)
jump(kept)
ir.start-block(kept)

────────────────────
_ do failure-of IRBlockId
    - run StreamRun
    - id SyntaxId
    - cursor Operand
    - failed IRBlockId

` Where a part tried from a cursor goes where it fails: a block that keeps the cursor as one a
` part failed at, then goes to `failed`. What is emitted next goes on past it.
if scanning
    = failed
. missed = ir.reserve-block()
. onward = ir.reserve-block()
jump(onward)
ir.start-block(missed)
record-error(run, id, cursor)
jump(failed)
ir.start-block(onward)
= missed

────────────────────
_ do last-item Operand
    - run StreamRun
    - id SyntaxId
    - cursor Operand

` The cursor of the item before a cursor, or the cursor itself where no item lies before it.
. kind = tables.layouts.rows[run.index-layout].kind
. kept = ir.add-local(run.index-layout)
store-local(kept, cursor, id)
. back = ir.reserve-block()
. done = ir.reserve-block()
branch(compare(id, .compare-greater, cursor, integer(kind, 0)), back, done)
ir.start-block(back)
store-local
    - kept
    - arithmetic(id, .arithmetic-subtract, cursor, integer(kind, 1), run.index-layout)
    - id
jump(done)
ir.start-block(done)
= load-local(kept, id)

────────────────────
_ do location-fact FactId
    - arm SyntaxId

` The call the type pass recorded at an arm of a stream pattern whose expression reads
` `location`, after any other there: the one that answers where in the input a cursor lies.
. fact = facts.first-call(unit.reading, arm)
while fact != no-fact
    . callee = facts.calls[fact].callee
    if facts.calls[fact].next == no-fact && callee != no-instance && gives-location
        = fact
    .. gives-location = instances.signatures[callee].returns == types.token-location-type
    fact = facts.calls[fact].next
= no-fact

────────────────────
_ do bind-location
    - run StreamRun
    - arm SyntaxId
    - fact FactId
    - begin Operand
    - end Operand
    - spans Bool

` Binds the `location` an arm of a stream pattern declares, made where the arm runs of the
` stream's locations of cursors, by a call the type pass recorded at the arm: where it
` `spans` a pattern, a `MatchLocation` of where the pattern began and of the last item it
` matched, or of where it began where it matched none; else the `TokenLocation` of its one
` cursor. Where functions the expression makes read it, it is kept in the environment too.
. slot = arm-slot-of(arm, .slot-location)
if slot == no-slot
    refuse(.refused-expression, arm)
    =
. begun = call-protocol(arm, fact, run.stream, run.stream-type, begin, types.index-type)
if begun.type != types.token-location-type
    refuse(.refused-type, arm)
    =
if !spans
    if is-captured(slot)
        keep-captured(slot, begun.operand, begun.type, arm)
    bound += BoundValue(slot, begun.type, begun.operand)
    =
. layout = layout-of(types.match-location-type, arm)
. made = frame(layout)
put(made, tables.layouts.field(layout, 0), begun.operand, arm)
. ended = call-protocol
    - arm
    - fact
    - run.stream
    - run.stream-type
    - last-item(run, arm, end)
    - types.index-type
put(made, tables.layouts.field(layout, 1), ended.operand, arm)
if is-captured(slot)
    keep-captured(slot, made, types.match-location-type, arm)
bound += BoundValue(slot, types.match-location-type, made)

────────────────────
_ stream-bound U64
    - syntax AST
    - id SyntaxId

` The number a bound of a pattern's range or count is written as.
match syntax.nodes[id]
    | .node-integer-syntax(row)
        parse-integer-literal(row.value).value
    ??
        0

────────────────────
_ stream-always-passes Bool
    - id SyntaxId

` Whether the last arm of a stream pattern always passes or raises: one with no pattern, or one
` that raises.
match tree.nodes[id]
    | .node-stream-or(row)
        stream-always-passes(row.right)
    | .node-stream-transform(row)
        row.pattern == 0 || stream-always-passes(row.pattern)
    | .node-stream-panic
        true
    ??
        false

────────────────────
_ do arm-slot-of SlotId
    - arm SyntaxId
    - kind SlotKind

` The slot of a kind, `it` or `location`, that an arm of a match or a pattern that is a
` condition declares, or none.
. binding = instances.rows[unit.reading].binding
if binding == no-binding || unit.reading != unit.instance
    = no-slot
. slots = bindings.bindings[binding].slots
for offset in 0 .. < slots.count
    . slot = slots.start + offset
    . row = bindings.slots[slot]
    if row.kind == kind && row.syntax == arm
        = slot
= no-slot

────────────────────
_ do drop-bound
    - mark Size

while bound.length > mark
    bound.pop()

────────────────────
_ do is-bound Bool
    - slot SlotId

for row in bound
    if row.slot == slot
        = true
= false

────────────────────
_ do holds-capture Bool
    - slot SlotId

` Whether a name is bound to what a stream pattern captured, which it reads from the places
` the pattern keeps, never from an environment.
for row in bound
    if row.slot == slot && (row.capture != U32.max || row.cursor != U32.max)
        = true
= false

────────────────────
_ do read-bound Typed
    - slot SlotId
    - id SyntaxId
    - type TypeId

` What a name a pattern bound holds where it is read: the value captured, or for `it` what
` the pattern was given or passed. Where the type pass narrowed the name, the read is of
` what it holds, as a local's is.
. nothing = make-operand(.operand-void, 0)
. position = bound.length
while position != 0
    position -= 1
    . row = bound[position]
    if row.slot != slot
        continue
    if row.capture != U32.max
        = read-capture(id, row.capture, type)
    if row.cursor != U32.max
        = gather-cursor(id, row.cursor, type)
    if row.type == type
        = Typed(row.value, type)
    if shared-depth != 0
        refuse(.refused-expression, id)
        = Typed(nothing, no-type)
    if facts.plan-of(unit.reading, id) == .plan-case-read
        = read-case(id, row.value, row.type, type)
    if holds(row.type, type)
        = payload(id, Typed(row.value, row.type))
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
refuse(.refused-expression, id)
= Typed(nothing, no-type)

────────────────────
_ do bind-name
    - name SyntaxId
    - value Typed

` Gives a name a pattern declares the value it captured. The name holds that value and no
` cell, since nothing assigns it, or, where nested functions capture it, the place the
` environment that holds it has for it. One the program tracks has no shape here. A pattern
` that only tests binds nothing. The name of a pattern a declaration
` is written with is a local: it gets its cell here, and the value is stored there, or in
` the environment of a function that yields, which keeps its locals from step to step.
if matching.testing
    =
. binding = instances.rows[unit.reading].binding
if binding == no-binding || unit.reading != unit.instance
    refuse(.refused-expression, name)
    =
. resolution = bindings.resolution-of(binding, name)
if resolution.kind != .resolve-slot
    refuse(.refused-expression, name)
    =
. row = bindings.slots[resolution.slot]
. unkept = SlotFlag.slot-captured /or/ SlotFlag.slot-tracked
if matching.declaring
    . type = value.type
    . place = slot-offset(resolution.slot, name)
    . layout = layout-of(type, name)
    . item = row.kind == .slot-loop-item
    if (row.kind != .slot-local && !item) || (!item && (row.flags /and/ unkept) != 0)
        refuse(.refused-statement, name)
        =
    if facts.slot-type(unit.instance, place) != type
        refuse(.refused-conversion, name)
        =
    if is-captured(resolution.slot)
        keep-captured(resolution.slot, value.operand, type, name)
    else if layout != void-layout
        unit.cells[place] = ir.add-local(layout, (row.flags /and/ SlotFlag.slot-address-taken) != 0)
        store-local(unit.cells[place], value.operand, name)
    =
if row.kind != .slot-pattern
    refuse(.refused-expression, name)
    =
. offset = slot-offset(resolution.slot, name)
if facts.slot-type(unit.instance, offset) != value.type
    refuse(.refused-conversion, name)
    =
if is-captured(resolution.slot)
    keep-captured(resolution.slot, value.operand, value.type, name)
    =
bound += BoundValue(resolution.slot, value.type, value.operand)

────────────────────
_ do bind-case-cursor
    - name SyntaxId
    - row Operand
    - type TypeId
    - place U32
    - case-index U32
    - located TableCursor

` Gives a name a pattern declares the case of a row of a table of unions it matched: the name
` stands for the row's cells. A name that nested functions capture, or a declaration's, has
` no shape here.
if matching.testing
    =
. binding = instances.rows[unit.reading].binding
if binding == no-binding || unit.reading != unit.instance || matching.declaring
    refuse(.refused-expression, name)
    =
. resolution = bindings.resolution-of(binding, name)
if resolution.kind != .resolve-slot
    refuse(.refused-expression, name)
    =
. held = bindings.slots[resolution.slot]
if held.kind != .slot-pattern || is-captured(resolution.slot)
    refuse(.refused-expression, name)
    =
. case-type = tables.unions.cases[tables.unions.layouts[place].cases.start + case-index].type
. offset = slot-offset(resolution.slot, name)
if facts.slot-type(unit.instance, offset) != case-type
    refuse(.refused-conversion, name)
    =
bound += BoundValue(resolution.slot, case-type, row, case-cursors.length as U32)
. checked = matching.checks-row && row == matching.checked-row
case-cursors += CaseCursor(row, type, place, case-index, checked, located.columns, located.index)

────────────────────
_ do case-cursor-of U32
    - object SyntaxId

` The case of a row a name read as an object stands for, or `U32.max` where it stands for none.
do match? tree.nodes[object]
    | .node-identifier
        . binding = instances.rows[unit.reading].binding
        if binding == no-binding || unit.reading != unit.instance
            = U32.max
        . resolution = bindings.resolution-of(binding, object)
        if resolution.kind != .resolve-slot
            = U32.max
        . position = bound.length
        while position != 0
            position -= 1
            if bound[position].slot == resolution.slot
                = bound[position].cursor
= U32.max

────────────────────
_ do gather-cursor Typed
    - id SyntaxId
    - cursor U32
    - type TypeId

` The case a name stands for, gathered from its row's cells where the name is used as a value.
. nothing = make-operand(.operand-void, 0)
. held = case-cursors[cursor]
. case-type = tables.unions.cases[case-base + held.case-index].type
    .. case-base = tables.unions.layouts[held.place].cases.start
if type != case-type
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. found = gathered-at(cursor)
if found != U32.max
    = Typed(case-gathers[found].value, case-type)
. located = case-place(id, held)
. made = gather-union-case(id, held.place, held.case-index, located.columns, located.index)
case-gathers += CaseGather(cursor, made.operand, ir.current)
= Typed(made.operand, case-type)

────────────────────
_ do gathered-at U32
    - cursor U32

` Where among `case-gathers` the newest gather of the case a name stands for that dominates
` the block being emitted is, or `U32.max` where none does. In the body of a loop with a
` header only one made in the same block does, as TypeScript, which joins the blocks of such a
` loop to the function only once its body is emitted, finds no other to dominate there.
. headed = in-headed-loop()
. position = case-gathers.length
while position != 0
    position -= 1
    . kept = case-gathers[position]
    if kept.cursor == cursor && (kept.block == ir.current || dominated)
        = position as U32
    .. dominated = !headed && ir.dominates(kept.block, ir.current)
= U32.max

────────────────────
_ do in-headed-loop Bool

` Whether the body of a loop with a header is being emitted: any loop but a `while`.
for loop in loops
    do match? tree.nodes[loop.syntax]
        | .node-while-block
            continue
    = true
= false

────────────────────
_ do case-field UnionField?
    - cursor U32
    - name Atom

` The field of the case a name stands for that a name reads, where the case stores one.
. held = case-cursors[cursor]
. union = tables.unions.layouts[held.place]
. kept = tables.unions.cases[union.cases.start + held.case-index]
. found = types.property-named(kept.type, name)
if !found
    = null
. slot = types.properties[found].slot
for position in 0 .. < kept.fields.count
    . field = tables.unions.fields[kept.fields.start + position]
    if field.slot == slot
        = field
= null

────────────────────
_ do case-row TableCursor
    - id SyntaxId
    - cursor U32

` The row of the case a name stands for, its table checked again where it grows.
= case-place(id, case-cursors[cursor])

────────────────────
_ do case-place TableCursor
    - id SyntaxId
    - held CaseCursor

` Where the row of a case is read: the columns its subject `t[i]` found, with no metadata, or
` else those of the row's value, its table checked again where it grows.
if held.checked
    = TableCursor(held.columns, held.index, no-meta())
= value-cursor(id, held.row, held.type)

────────────────────
_ do subject-place TableCursor
    - id SyntaxId
    - row Operand
    - type TypeId

` Where the row a pattern tests is read: the columns and the index the subject `t[i]` of the
` match found and checked, as TypeScript reads its cursor, and else those of the row's value,
` its table checked again where it grows.
if matching.checks-row && row == matching.checked-row && matching.checked-made != U32.max
    . cursor = made-rows[matching.checked-made].cursor
    = TableCursor(cursor.columns, cursor.index, no-meta())
= value-cursor(id, row, type)

────────────────────
_ do case-cell Operand
    - id SyntaxId
    - cursor U32
    - located TableCursor
    - field UnionField
    - stored LayoutField

` Where the row of the case a name stands for keeps a field.
. held = case-cursors[cursor]
. handle = integer(.machine-u32, 0)
if field.region == .region-external
    handle = union-handle(id, held.place, located.columns, located.index)
= union-cell(id, held.place, located.columns, located.index, field, stored.layout, handle)

────────────────────
_ do case-stored LayoutField
    - id SyntaxId
    - cursor U32
    - field UnionField

` How the case a name stands for holds a field it keeps in its row.
. held = case-cursors[cursor]
. case-type = tables.unions.cases[case-base + held.case-index].type
    .. case-base = tables.unions.layouts[held.place].cases.start
. case-layout = layout-of(case-type, id)
= tables.layouts.field(case-layout, field.slot)

────────────────────
_ do emit-case-field Typed
    - id SyntaxId
    - cursor U32
    - field UnionField

` A field of the case of a row a name stands for, read from its cell, or from what was gathered
` of the case where that dominates. Where the type pass knows an optional field to hold a
` value, the read is of what it holds, with no test, as a property's is.
. stored = case-stored(id, cursor, field)
. narrowed = !is-link(id) && holds(stored.type, facts.node-type(unit.reading, id))
. read = make-operand(.operand-void, 0)
. found = gathered-at(cursor)
if found != U32.max
    read = take(case-gathers[found].value, stored, id)
else
    . located = case-row(id, cursor)
    . cell = case-cell(id, cursor, located, field, stored)
    read = take(cell, LayoutField(0, stored.layout, stored.type), id)
if narrowed
    = payload(id, Typed(read, stored.type))
= Typed(read, stored.type)

────────────────────
_ do emit-case-field-assign Assignment
    - id SyntaxId
    - op Operator
    - lhs SyntaxId
    - cursor U32
    - field UnionField
    - rhs SyntaxId

` A field of the case of a row a name stands for written in its cell, as TypeScript writes it:
` the value is read, converted to the field's type and stored; where the table grows the
` table is checked first and its mutation generation counted on after, unless the row's
` storage was checked where the case was read. An assigning operator reads the field through
` the row first. A row of a finished table is not written.
if intrinsic(case-cursors[cursor].type) != .table-row
    refuse(.refused-statement, id)
    = Assignment()
. given = Typed(make-operand(.operand-void, 0), no-type)
. increment = increment-base(op)
if op == .eq-op
    given = emit-expression(rhs)
else if increment && facts.plan-of(unit.reading, id) == .plan-builtin
    given = emit-builtin(id, increment, lhs, rhs, true)
else
    refuse(.refused-statement, id)
. stored = case-stored(lhs, cursor, field)
. value = convert(id, .reason-assignment, given)
if value.type != stored.type
    refuse(.refused-conversion, rhs)
. located = case-row(lhs, cursor)
. cell = case-cell(lhs, cursor, located, field, stored)
store-row-cell(lhs, cell, stored.layout, value.operand, located.meta)
if !case-cursors[cursor].checked
    invalidate-marks(lhs, located.meta)
= Assignment(Typed(value.operand, stored.type), given)

────────────────────
_ do pass-or-fail
    - tested Operand
    - failed IRBlockId

` Goes on where a test of a pattern holds, and leaves to `failed` where it does not.
. passed = ir.reserve-block()
branch(tested, passed, failed)
fail-jumps += 1
ir.start-block(passed)

────────────────────
_ names-type Bool
    - pattern SyntaxId

` Whether a pattern is a type named and no more.
match tree.nodes[pattern]
    | .node-type-identifier
        true
    | .node-type-arguments
        true
    | .node-type-optional
        true
    ??
        false

────────────────────
_ do emit-pattern Typed ?! Refused
    - pattern SyntaxId
    - value Typed
    - failed IRBlockId

` Tests a value against a pattern, and gives what the pattern passes on where it matches, with its
` type. Where it does not match nothing panics: `failed` is where it leaves to. A name the pattern
` declares is bound to what it captured. A pattern the type pass planned nothing for has no shape
` here.
. nothing = make-operand(.operand-void, 0)
if pattern == 0
    = value
do match? tree.nodes[pattern]
    | .node-type-wildcard
        = value
    | .node-type-identifier
        = match-type(pattern, value, failed)
    | .node-type-arguments
        = match-type(pattern, value, failed)
    | .node-type-optional
        = match-type(pattern, value, failed)
    | .node-type-match(row)
        if names-type(row.type)
            = match-type(row.type, value, failed)
        = emit-pattern(row.type, value, failed)
    | .node-type-capture(row)
        . passed = value
        if row.type != 0 && names-type(row.type)
            passed = match-type(row.type, value, failed)
        else if row.type != 0
            passed = emit-pattern(row.type, value, failed)
        bind-name(row.id, passed)
        = passed
    | .node-type-and(row)
        if facts.plan-of(unit.reading, pattern) == .plan-text-pattern
            = match-text(pattern, value, failed)
        . left = emit-pattern(row.left, value, failed)
        = emit-pattern(row.right, left, failed)
    | .node-type-equality(row)
        = match-equal(pattern, row.expr, value, failed)
    | .node-type-predicate(row)
        = match-predicate(pattern, row.expr, value, failed)
    | .node-type-case(row)
        = match-case(pattern, row.value, value, failed)
    | .node-type-tuple(row)
        = match-fields(pattern, row.field-types, value, failed)
    | .node-type-property(row)
        = match-property(pattern, row.name, value)
    | .node-type-list(row)
        if facts.plan-of(unit.reading, pattern) == .plan-list-pattern
            = match-items(pattern, row.patterns, value, failed)
        = match-type(pattern, value, failed)
    | .node-type-map(row)
        if facts.plan-of(unit.reading, pattern) == .plan-map-pattern
            = match-keys(pattern, row.patterns, value, failed)
        = match-type(pattern, value, failed)
    | .node-identifier
        bind-name(pattern, value)
        = value
refuse(.refused-expression, pattern)
= Typed(nothing, no-type)

────────────────────
_ do match-property Typed
    - pattern SyntaxId
    - name Atom
    - value Typed

` A pattern that reads a name from what it is given, as the type pass recorded the read at
` the pattern: it always matches, passes what the name gives, and binds the name to that
` where the pattern declares one.
. mark = pins.length
pin(pattern, value.operand, value.type)
. read = emit-get(pattern, pattern, name)
unpin(mark)
. binding = instances.rows[unit.reading].binding
if binding != no-binding && bindings.resolution-of(binding, pattern).kind == .resolve-slot
    bind-name(pattern, read)
= read

────────────────────
_ do pattern-row FactId
    - pattern SyntaxId
    - source TypeId

` The conversion the type pass recorded at a type named as a pattern for a value of a type
` given to it whole, or none.
. fact = facts.first-conversion(unit.reading, pattern)
while fact != no-fact
    . row = facts.conversions[fact]
    if row.reason == .reason-pattern && row.guard == U32.max && row.from == source
        = fact
    fact = row.next
= no-fact

────────────────────
_ do match-type Typed
    - pattern SyntaxId
    - value Typed
    - failed IRBlockId

` A type named as a pattern, as the type pass planned it. A value the pattern has a
` conversion for is tested where the conversion can fail, and converted. An optional it has
` none for is tested for a value, and matched as what it holds. A union it has none for is
` matched by its cases.
. nothing = make-operand(.operand-void, 0)
. held = value
if pattern-row(pattern, held.type) == no-fact && types.is-optional(held.type)
    . type = held.type
    . tested = present(pattern, held)
    pass-or-fail(tested.operand, failed)
    held = payload(pattern, Typed(held.operand, type))
. whole = pattern-row(pattern, held.type)
if whole != no-fact
    = pass-leaf(pattern, facts.conversions[whole], held, failed)
if intrinsic(held.type) != .union
    refuse(.refused-conversion, pattern)
    = Typed(nothing, no-type)
= match-cases(pattern, held, failed)

────────────────────
_ do match-cases Typed
    - pattern SyntaxId
    - value Typed
    - failed IRBlockId

` A union matched by its cases: each case the type pass recorded a conversion for is tested
` in turn, and what it holds is converted. An optional a case holds is tested for a value
` first. A union that holds any other case does not match. A pattern that only tests passes
` the union itself.
. nothing = make-operand(.operand-void, 0)
. union = value.type
. layout = layout-of(value.type, pattern)
. target = no-type
. fact = facts.first-conversion(unit.reading, pattern)
while fact != no-fact
    . row = facts.conversions[fact]
    if row.reason == .reason-pattern && row.guard != U32.max && target == no-type
        target = row.to
    fact = row.next
if target == no-type || !tables.layouts.is-union(layout)
    refuse(.refused-conversion, pattern)
    = Typed(nothing, no-type)
. result = layout-of(target, pattern)
. joined = ir.reserve-block()
. slot = join-slot(result)
. mark = joins.length
fact = facts.first-conversion(unit.reading, pattern)
while fact != no-fact
    . row = facts.conversions[fact]
    fact = row.next
    if row.reason != .reason-pattern || row.guard == U32.max
        continue
    if row.guard >= tables.layouts.rows[layout].cases.count || row.to != target
        refuse(.refused-conversion, pattern)
        continue
    . matched = ir.reserve-block()
    . missed = ir.reserve-block()
    branch(case-test(pattern, value.operand, row.guard), matched, missed)
    ir.start-block(matched)
    . field = tables.layouts.case-field(layout, row.guard)
    . inner = Typed(take(value.operand, field, pattern), field.type)
    if types.is-optional(field.type) && row.from != field.type
        . tested = present(pattern, inner)
        pass-or-fail(tested.operand, failed)
        inner = payload(pattern, inner)
    . passed = pass-leaf(pattern, row, inner, failed)
    if matching.testing
        jump(joined)
    else
        arrive(pattern, passed.operand, joined, slot)
    ir.start-block(missed)
jump(failed)
fail-jumps += 1
if matching.testing
    ir.start-block(joined)
    = Typed(value.operand, union)
. passed = close-joins(joined, mark, result, slot)
= Typed(passed, target)

────────────────────
_ do pass-leaf Typed
    - pattern SyntaxId
    - row ConversionFact
    - value Typed
    - failed IRBlockId

` Converts a value as a type named as a pattern records, where the value passes the test the
` conversion's kind makes: a union holds the case, an object is of the class. A value that
` fails it does not match. A union matches text only where it holds the case the type pass
` picked for text, though cast to text it gives the text of any case. A case that holds text
` gives its text as it is, and any other case is cast to text. A value of an
` interface is of the type it holds. TypeScript never matches a value that is no object cast
` up. A value already of the type asked for passes as it is, but an object tested for its
` class alone, which may be of a class derived from the one it is known by.
if row.from != value.type
    refuse(.refused-conversion, pattern)
    = value
. kind = row.kind
. exact = facts.plan-of(unit.reading, pattern) == .plan-exact-class
if kind == .relation-same && row.from == row.to
    if exact && tables.is-class(row.to)
        = exact-class-pass(pattern, value, failed)
    = value
. objects = tables.is-class(row.from) && tables.is-class(row.to)
if kind == .relation-illegal || (kind == .relation-up-cast && !objects)
    refuse(.refused-conversion, pattern)
    = value
if kind == .relation-unwrap-cast && intrinsic(row.from) == .union && row.to == types.string-type
    if row.case-index == U32.max
        refuse(.refused-conversion, pattern)
        = value
    pass-or-fail(case-test(pattern, value.operand, row.case-index), failed)
    if matching.testing
        = Typed(value.operand, row.from)
    . layout = layout-of(row.from, pattern)
    . field = tables.layouts.case-field(layout, row.case-index)
    if field.type == types.string-type
        = Typed(take(value.operand, field, pattern), field.type)
. tests = kind == .relation-unwrap-cast || kind == .relation-down-cast || interface-cast
    .. interface-cast = kind == .relation-interface-down-cast
if matching.testing && !tests
    = value
. own-matching = matching
matching = matching.failing = failed
matching = matching.exact-class = exact
. passed = convert-one(pattern, row, value)
matching = own-matching
= passed

────────────────────
_ do exact-class-pass Typed
    - pattern SyntaxId
    - value Typed
    - failed IRBlockId

` An object tested for the class it is known by alone: it passes as it is where it is of that
` class, and does not match where it is of one derived from it.
. own-matching = matching
matching = matching.exact-class = true
. passed = ir.reserve-block()
class-branch(pattern, value.operand, value.type, passed, failed)
fail-jumps += 1
matching = own-matching
ir.start-block(passed)
= value

────────────────────
_ do match-equal Typed
    - pattern SyntaxId
    - expr SyntaxId
    - value Typed
    - failed IRBlockId

` An equality pattern: its subject is compared with a value by the plan of `==` the type pass
` recorded at the pattern, whose node stands for the subject. The pattern passes its subject.
. nothing = make-operand(.operand-void, 0)
. type = value.type
if switching && value.operand == switched-subject && switch-number(expr) == switched-value
    switching = false
    = value
. pin-mark = pins.length
pin(pattern, value.operand, type)
. tested = emit-binary(pattern, .equals-op, pattern, expr)
unpin(pin-mark)
pass-or-fail(tested.operand, failed)
= Typed(value.operand, type)

────────────────────
_ do match-predicate Typed
    - pattern SyntaxId
    - expr SyntaxId
    - value Typed
    - failed IRBlockId

` A pattern that is a condition: `it` is what the pattern is given while the condition is
` evaluated, and the pattern passes that where the condition tests as true.
. nothing = make-operand(.operand-void, 0)
. type = value.type
. slot = arm-slot-of(pattern, .slot-it)
if slot == no-slot
    slot = matching.arm-it
if slot == no-slot
    slot = it-read(expr)
. named = bound.length
if slot != no-slot
    bound += BoundValue(slot, type, value.operand)
. tested = test(expr, emit-expression(expr))
drop-bound(named)
pass-or-fail(tested.operand, failed)
= Typed(value.operand, type)

────────────────────
_ do it-read SlotId
    - expr SyntaxId

` The slot a condition reads `it` through where its pattern declares none and no arm has
` one: that of an earlier pattern of the same block.
. binding = instances.rows[unit.reading].binding
if binding == no-binding || unit.reading != unit.instance
    = no-slot
for id in tree.subtree-start(expr) .. expr
    do match? tree.nodes[id]
        | .node-identifier
            . resolution = bindings.resolution-of(binding, id)
            if resolution.kind == .resolve-slot && bindings.slots[resolution.slot].kind == .slot-it
                = resolution.slot
= no-slot

────────────────────
_ do match-case Typed
    - pattern SyntaxId
    - inner SyntaxId
    - value Typed
    - failed IRBlockId

` A pattern that names a case of a union, by the number the type pass recorded. An optional
` is tested for a value first. With a pattern written for what the case holds, that is
` matched and what it passes is passed; with none, the union is, but where `is` tests a state
` machine it is the case's flag that is tested, as the reference tests it, unless the tag is
` (`tests-tag`), and where it tests a value of a machine's union read from elsewhere, the tag of
` the case or of one written in it (`pass-within`). One pattern in parentheses for a case that holds no tuple is the pattern
` of what the case holds. A case its subject is no union of matches nothing. A case a refinement
` of the machine adds is tested as `refined-case` reads it, and matches nothing where no object
` reaches the test (`unreached-refined`).
. nothing = make-operand(.operand-void, 0)
if facts.plan-of(unit.reading, pattern) == .plan-never || unreached-refined(matching.case-subject, pattern)
    jump(failed)
    fail-jumps += 1
    ir.start-block(ir.reserve-block())
    = value
if facts.plan-of(unit.reading, pattern) == .plan-refined-case
    . union = value.type
    . held = refined-case(matching.case-subject, pattern, inner != 0)
    pass-or-fail(load-local(refined-flag, pattern), failed)
    if inner == 0
        = Typed(value.operand, union)
    = emit-pattern(payload-part(inner, held), Typed(load-local(refined-payload, pattern), held), failed)
. held = value
if types.is-optional(held.type)
    . type = held.type
    . tested = present(pattern, held)
    pass-or-fail(tested.operand, failed)
    held = payload(pattern, Typed(held.operand, type))
. union = held.type
if intrinsic(union) == .table-row || intrinsic(union) == .immutable-table-row
    = match-row-case(pattern, inner, held, failed)
. constant = facts.constant-of(unit.reading, pattern)
. layout = layout-of(union, pattern)
if facts.plan-of(unit.reading, pattern) != .plan-case || constant == no-fact || not-union
    refuse(.refused-expression, pattern)
    = Typed(nothing, no-type)
.. not-union = !tables.layouts.is-union(layout)
. index = facts.constants[constant].bits as U32
if index >= tables.layouts.rows[layout].cases.count
    refuse(.refused-expression, pattern)
    = Typed(nothing, no-type)
. machine = machine-of-union(union)
if switching && value.operand == switched-subject && switched-value == index as U64
    switching = false
else if machine && inner == 0 && matching.testing && !reads-machine(matching.tested, machine)
    pass-within(pattern, machine, held.operand, index, failed)
else if machine && inner == 0 && matching.testing && (machine.store != .store-member || !tests-tag())
    pass-or-fail(machine-flag(pattern, machine, index, failed).operand, failed)
else
    pass-or-fail(case-test(pattern, held.operand, index), failed)
if inner == 0
    = Typed(held.operand, union)
. field = tables.layouts.case-field(layout, index)
if field.type == no-type || field.type == invalid-type
    refuse(.refused-expression, pattern)
    = Typed(nothing, no-type)
= emit-pattern(payload-part(inner, field.type), Typed(take(held.operand, field, pattern), field.type), failed)

────────────────────
_ do machine-of-union MachineFact?
    - union TypeId

` The state machine whose union a type is, or none.
for machine in facts.machines
    if machine.union == union
        = machine
= null

────────────────────
_ do unit-machine MachineFact?
    - unit-id InstanceId

` The state machine of a property that the instance typing its value starts, or none.
for machine in facts.machines
    . member = machine.store == .store-member && machine.outer == 0
    if member && instances.rows[machine.instance].enclosing == unit-id
        = machine
= null

────────────────────
_ do start-refined
    - machine MachineFact

` Starts a machine that refines another, as the reference starts the two merged: each machine
` that refines another, from the one of the object's class up, keeps what it keeps for the
` object, and then the machine none refines starts, through the facts of the instance that types
` its value for the class that declares it.
. current MachineFact? = machine
while current
    . own-unit = unit
    . own-filling = filling
    unit = unit.source-module = current.module
    unit = unit.reading = instances.rows[current.instance].enclosing
    filling = filling.root = current.syntax
    do emit-expression(current.syntax)
    unit = own-unit
    filling = own-filling
    current = facts.machine-of(current.refined) if current.refined != no-instance

────────────────────
_ do member-machine MachineFact?
    - module ModuleId
    - value SyntaxId

` The state machine a property of a class holds, by the property's value, or none.
for machine in facts.machines
    if machine.store == .store-member && machine.module == module && machine.syntax == value
        = machine
= null

────────────────────
_ do member-flag Typed
    - lhs SyntaxId
    - pattern SyntaxId
    - machine MachineFact

` Whether the case a pattern names of a state machine a property of a class holds is active,
` as the reference tests it: the object's flag of the case, read from the object written before
` the property's name, which is evaluated once, or from the object a name alone is read from
` (`self-owner`), where a name written tracked is tracked as it is read. Any other value of the
` machine's union has no shape here. A case a refinement of the machine adds is tested as
` `refined-case` reads it, and is not active where no object reaches the test
` (`unreached-refined`).
. nothing = make-operand(.operand-void, 0)
if facts.plan-of(unit.reading, pattern) == .plan-refined-case
    if unreached-refined(lhs, pattern)
        = Typed(integer(.machine-u8, 0), types.bool-type)
    do refined-case(lhs, pattern, false)
    = Typed(load-local(refined-flag, pattern), types.bool-type)
. constant = facts.constant-of(unit.reading, pattern)
. property = decl-name(machine.module, machine.decl)
. machine-tree = program.modules[machine.module].tree
. cases = machine-tree.machine-cases
    - machine-tree.state-items(machine-tree.state-body(machine.syntax))
if facts.plan-of(unit.reading, pattern) != .plan-case || constant == no-fact || !property || past-cases
    refuse(.refused-expression, pattern)
    = Typed(nothing, no-type)
.. past-cases = facts.constants[constant].bits >= cases.length as U64
. name = program.store-atom("(${property.text}-${state-text}-active)")
    .. state-text = machine-tree.state-name(cases[facts.constants[constant].bits as U32])!.text
. base = nothing
. owner = no-type
do match? tree.nodes[lhs]
    | .node-get-expression(row)
        if row.name == property && !is-link(lhs)
            owner = held-type(row.object)
            base = emit-expression(row.object).operand
    | .node-identifier(row)
        . binding = instances.rows[unit.reading].binding
        . resolution = if binding != no-binding then resolved else Resolution(.resolve-none, 0)
            .. resolved = bindings.resolution-of(binding, lhs)
        if row.name == property && resolution.kind == .resolve-member
            owner = self-owner()
            base = unit.self
            if owner != no-type && row.is-tracked && live-actions.length != 0
                track-name(lhs, row.name)
if owner == no-type || owner == invalid-type || !tables.is-class(owner)
    refuse(.refused-expression, lhs)
    = Typed(nothing, no-type)
. found = property-of(owner, name)
if !found
    refuse(.refused-expression, lhs)
    = Typed(nothing, no-type)
. field = held-field(lhs, owner, found)
= Typed(load(base, field.offset, field.layout, lhs), types.bool-type)

────────────────────
_ do refined-case TypeId
    - subject SyntaxId
    - pattern SyntaxId
    - reads Bool

` Reads, for a pattern that names a case a refinement of the machine of a property of a class
` adds, whether the case is active, into `refined-flag`, and what it holds, into
` `refined-payload`, and answers its type, as the reference reads them: from the object the
` property is read from, a local or the one a name alone is read from, by the composite of the
` object's class, the object's flag of the case and what the object keeps for the piece that
` writes it, where it holds anything and that `reads` it, else `Void`. An object of a class whose
` composite has none of it is not in the case. A class the object is written as that no
` composite with the case is of, nor any class below it, has no shape here.
refined-flag = no-local
refined-payload = no-local
. name = pattern-case-name(pattern)
. union = if subject != 0 then facts.node-type(unit.reading, subject) else no-type
. root = machine-of-union(union)
. property = decl-name(root.module, root.decl) if root
. owner = refined-owner(subject, pattern)
. object = make-operand(.operand-void, 0)
if owner != no-type
    do match? tree.nodes[subject]
        | .node-get-expression(row)
            object = emit-expression(row.object).operand
        | .node-identifier
            object = unit.self
if owner == no-type || owner == invalid-type || !tables.is-class(owner)
    refuse(.refused-expression, pattern)
    = no-type
. held = no-type
. found = false
refined-flag = ir.add-local(u8-layout)
store-local(refined-flag, integer(.machine-u8, 0), pattern)
. joined = ir.reserve-block()
for position in tables.machine-order
    . fact = facts.machines[position]
    . classes = composite-classes(fact, root!, owner)
    . level = tables.machine-receiver(fact)
    . composite = compose-machine(program, facts, fact) if classes.length != 0
    . case = if composite then composite.case-named(name!) else U32.max
    if case == U32.max || composite!.owners[case] == 0
        continue
    . fragment = composite!.pieces[composite!.owners[case]]
    . node = composite!.node(case, composite!.owners[case])
    found = true
    . missed = ir.reserve-block()
    . matched = ir.reserve-block()
    classes-branch(pattern, object, classes, matched, missed)
    ir.start-block(matched)
    . flagged = property-of(level, flag-name(property!, name!))
    if !flagged
        refuse(.refused-expression, pattern)
        = no-type
    . flag = held-field(pattern, level, flagged)
    store-local(refined-flag, load(object, flag.offset, flag.layout, pattern), pattern)
    if !reads || !union-case-holds(fragment.union, name!)
        if held != no-type && held != types.void-type
            refuse(.refused-expression, pattern)
            = no-type
        held = types.void-type
        jump(joined)
        ir.start-block(missed)
        continue
    . kept = refinement-payload(fragment, node, level, object, pattern)
    if held == no-type
        held = kept.type
        refined-payload = ir.add-local(layout-of(held, pattern))
    if held != kept.type
        refuse(.refused-expression, pattern)
        = no-type
    store-local(refined-payload, kept.operand, pattern)
    jump(joined)
    ir.start-block(missed)
if !found
    refuse(.refused-expression, pattern)
    = no-type
jump(joined)
ir.start-block(joined)
= held

────────────────────
_ do refined-owner TypeId
    - subject SyntaxId
    - pattern SyntaxId

` The class of the object `refined-case` reads a case a refinement adds from: that of the local
` written before the property's name, or of the object a name alone is read from, or no type.
. name = pattern-case-name(pattern)
. union = if subject != 0 then facts.node-type(unit.reading, subject) else no-type
. root = machine-of-union(union)
. property = decl-name(root.module, root.decl) if root
. owner = no-type
if property && name
    do match? tree.nodes[subject]
        | .node-get-expression(row)
            . named = tree.nodes[row.object] is .node-identifier
            if row.name == property && !is-link(subject) && named
                owner = held-type(row.object)
        | .node-identifier(row)
            if row.name == property && resolves-member(subject)
                owner = self-owner()
= owner

────────────────────
_ unreached-refined Bool
    - subject SyntaxId
    - pattern SyntaxId

` Whether a pattern names a case a refinement of a machine adds that no object reaches: the
` program constructs no class the object `refined-case` reads it from is written as, nor any
` class below it.
|? facts.plan-of(unit.reading, pattern) != .plan-refined-case
    false
??
    owner != no-type && owner != invalid-type && tables.is-class(owner) && !tables.constructs-from(owner)

.. owner = refined-owner(subject, pattern)

────────────────────
_ resolves-member Bool
    - id SyntaxId

` Whether a name alone resolves to a member of the object the function is emitted for.
|? binding == no-binding
    false
??
    bindings.resolution-of(binding, id).kind == .resolve-member

.. binding = instances.rows[unit.reading].binding

────────────────────
_ do flag-name Atom
    - property Atom
    - name Atom

` The name of the object's flag of a case of the machine a property of its class holds.
= program.store-atom("(${property.text}-${name.text}-active)")

────────────────────
_ do refinement-payload Typed
    - fragment MachineFact
    - node SyntaxId
    - level TypeId
    - object Operand
    - site SyntaxId

` What a case a refinement adds holds, read from what an object of a class keeps for the
` refinement: the environment of the refinement's function, which the property that holds its
` part holds (`part-name`). One that holds a tuple or a struct has no shape here.
. nothing = make-operand(.operand-void, 0)
. holder = part-name(fragment)
. found = property-of(level, holder) if holder
. row = bindings.machine-slots(fragment.module, fragment.syntax)
. slot = if row then bindings.machine-slot(row, node, program.store-atom("(payload)")) else no-slot
. layout = tables.environments[fragment.instance]
if !found || slot == no-slot || layout == no-layout || layout == unbuilt-environment
    refuse(.refused-expression, site)
    = Typed(nothing, no-type)
. field = held-field(site, level, found)
. data = tables.layouts.field(tables.layouts.function-layout, 1).offset
. environment = load(object, field.offset + data, managed-layout, site)
. kept = tables.layouts.field(layout, 1 + tables.slot-fields[slot])
if tables.layouts.is-struct(kept.layout)
    refuse(.refused-expression, site)
    = Typed(nothing, no-type)
= Typed(load(environment, kept.offset, kept.layout, site), kept.type)

────────────────────
_ do union-case-holds Bool
    - union TypeId
    - name Atom

` Whether the case of a name of a state machine's union holds a value.
. position = 0u32
for fact in types.cases[types.completion-of(union).cases]
    if fact.name && fact.name! == name
        do match? types.rows[union]
            | .type-named-union(row)
                = types.child-type(row.cases, position) != types.void-type
        = false
    position += 1
= false

────────────────────
_ do composite-classes [TypeId]
    - fact MachineFact
    - root MachineFact
    - owner TypeId

` The classes whose objects start a machine a property of a class holds (`leaf-classes`), where
` it is, or refines, the machine of a union, that are or derive from a class, or none.
. found [TypeId]
if fact.outer != 0
    = found
. top MachineFact? = fact
while top && top.refined != no-instance
    top = facts.machine-of(top.refined)
if !top || top.module != root.module || top.syntax != root.syntax
    = found
for type in tables.leaf-classes(fact)
    if derives(type, owner)
        found += type
= found

────────────────────
_ do classes-branch
    - site SyntaxId
    - value Operand
    - classes [TypeId]
    - matched IRBlockId
    - missed IRBlockId

` Leaves to `matched` when an object is of one of some classes itself, and to `missed` when it is
` of another.
. table = load(value, 0, pointer-layout, site)
for position in 0 .. < classes.length
    . next = if position + 1 == classes.length then missed else ir.reserve-block()
    . symbol = tables.table-symbols[classes[position]]
    if symbol == no-string
        jump(next)
    else
        branch
            - compare(site, .compare-equal, table, make-operand(.operand-symbol, symbol))
            - matched
            - next
    if position + 1 < classes.length
        ir.start-block(next)
if classes.length == 0
    jump(missed)

────────────────────
_ do derives Bool
    - type TypeId
    - base TypeId

` Whether a class is another or derives from it.
. level TypeId? = type
while level
    if level == base
        = true
    level = types.base-of(level)
= false

────────────────────
_ pattern-case-name Atom?
    - pattern SyntaxId

` The name of the case a pattern names.
match? tree.nodes[pattern]
    | .node-type-case(row)
        row.name
    | .node-symbol(row)
        row.name

────────────────────
_ do emit-machine-path Typed
    - id SyntaxId
    - object SyntaxId

` `path` read from a value of a state machine's union, as the reference makes it: an empty list,
` given the name of each active case of the machine in turn, its cases written outermost first,
` each before those written in it, then those only a continuation enters. The flags are read
` where a case test reads them: those of a machine a property of a class holds from the object
` written before the property's name, evaluated once, or the one a name alone is read from; any
` other's as `machine-flag` reads them. Where the object is of a class whose composite merges the
` machine with refinements, the composite's cases are listed (`append-composite`). A value of the
` union read from elsewhere than the machine lists the case it holds after those it is written in,
` outermost first (`append-held`).
. nothing = make-operand(.operand-void, 0)
. list-type = facts.node-type(unit.reading, id)
. union = facts.node-type(unit.reading, object)
. machine = machine-of-union(union)
. makes = no-fact
. append = no-instance
. fact = facts.first-call(unit.reading, id)
while fact != no-fact
    . row = facts.calls[fact]
    if row.form == .call-list-make
        makes = fact
    else if row.form == .call-method
        append = row.callee
    fact = row.next
if !machine || makes == no-fact || append == no-instance
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. member = machine.store == .store-member
. live = reads-machine(object, machine)
. base = nothing
. owner = no-type
. property = decl-name(machine.module, machine.decl)
if !live
    base = emit-expression(object).operand
else if member && property
    do match? tree.nodes[object]
        | .node-get-expression(row)
            if row.name == property && !is-link(object)
                owner = held-type(row.object)
                base = emit-expression(row.object).operand
        | .node-identifier(row)
            if row.name == property && resolves-member(object)
                owner = self-owner()
                base = unit.self
    if owner == no-type || owner == invalid-type || !tables.is-class(owner)
        refuse(.refused-expression, object)
else if member || !(tree.nodes[object] is .node-identifier)
    refuse(.refused-expression, object)
. list = emit-fact-call(id, facts.calls[makes], 0, RowRange'SyntaxId(), 0, 0, list-type)
if list.type != list-type
    refuse(.refused-conversion, id)
. machine-tree = program.modules[machine.module].tree
. items = machine-tree.state-items(machine-tree.state-body(machine.syntax))
. cases = machine-tree.machine-cases(items)
. order [SyntaxId]
for node in machine-tree.explicit-cases(items)
    order += node
for node in cases
    if order.find(node) == null
        order += node
. done = ir.reserve-block()
if !live
    append-held(id, list.operand, append, base, machine, done)
    ir.start-block(done)
    = Typed(list.operand, list-type)
if member
    for position in tables.machine-order
        . fact = facts.machines[position]
        . classes = composite-classes(fact, machine, owner)
        . composite = compose-machine(program, facts, fact) if classes.length != 0
        if composite
            append-composite
                - id
                - list.operand
                - append
                - base
                - composite
                - property!
                - classes
                - tables.machine-receiver(fact)
                - done
for node in order
    . name = machine-tree.state-name(node)!
    . index = machine-tree.case-position(cases, name)!
    . flag = nothing
    if member
        . flagged = property-of(owner, flag-name(property, name)) if property
        if !flagged
            refuse(.refused-expression, id)
            = Typed(nothing, no-type)
        . field = held-field(id, owner, flagged)
        flag = load(base, field.offset, field.layout, id)
    else
        flag = machine-flag(id, machine, index, done).operand
    append-active(id, list.operand, append, flag, name)
jump(done)
ir.start-block(done)
= Typed(list.operand, list-type)

────────────────────
_ do append-active
    - id SyntaxId
    - list Operand
    - append InstanceId
    - flag Operand
    - name Atom

` Appends the name of a case to a machine's path where its flag says it is active.
. adding = ir.reserve-block()
. next = ir.reserve-block()
branch(compare(id, .compare-not-equal, flag, integer(.machine-u8, 0)), adding, next)
ir.start-block(adding)
append-name(id, list, append, name)
jump(next)
ir.start-block(next)

────────────────────
_ do append-name
    - id SyntaxId
    - list Operand
    - append InstanceId
    - name Atom

` Appends the name of a case to a machine's path.
. mark = pending.length
pending += list
pending += make-operand(.operand-constant, ir.add-string(name.text))
do call-instance(append, id, mark)

────────────────────
_ do append-held
    - id SyntaxId
    - list Operand
    - append InstanceId
    - value Operand
    - machine MachineFact
    - done IRBlockId

` Appends to a path read from a value of a state machine's union, read from elsewhere than the
` machine, the names of the case it holds, the innermost the machine was in when it was read, and
` of the cases that case is written in, outermost first, and leaves to `done`.
. machine-tree = program.modules[machine.module].tree
. items = machine-tree.state-items(machine-tree.state-body(machine.syntax))
. cases = machine-tree.machine-cases(items)
. tag = load(value, 0, u8-layout, id)
for position in 0 .. < cases.length
    . adding = ir.reserve-block()
    . next = ir.reserve-block()
    branch(compare(id, .compare-equal, tag, integer(.machine-u8, position as U64)), adding, next)
    ir.start-block(adding)
    for node in machine-tree.path-to(items, cases[position])
        append-name(id, list, append, machine-tree.state-name(node)!)
    jump(done)
    ir.start-block(next)
jump(done)

────────────────────
_ do append-composite
    - id SyntaxId
    - list Operand
    - append InstanceId
    - object Operand
    - composite MachineComposite
    - property Atom
    - classes [TypeId]
    - level TypeId
    - done IRBlockId

` Appends to a path, where an object is of one of the classes that run a composite typed for a
` class itself, the name of each active case of the composite, each before those written in it,
` then those only a continuation enters, and leaves to `done`.
. missed = ir.reserve-block()
. matched = ir.reserve-block()
classes-branch(id, object, classes, matched, missed)
ir.start-block(matched)
. names [Atom]
for name in composite.names
    names += name
for fact in composite.pieces
    . owner = program.modules[fact.module].tree
    for node in owner.machine-cases(owner.state-items(owner.state-body(fact.syntax)))
        if names.find(owner.state-name(node)!) == null
            names += owner.state-name(node)!
for name in names
    . flagged = property-of(level, flag-name(property, name))
    if !flagged
        refuse(.refused-expression, id)
        =
    . field = held-field(id, level, flagged)
    append-active(id, list, append, load(object, field.offset, field.layout, id), name)
jump(done)
ir.start-block(missed)

────────────────────
_ tests-tag Bool

` Whether a case test of a state machine a property of a class holds compares the tag of its
` union, as the reference compiles it before it declares the machine's flags: in the first
` value of a property, and in the function that evaluates it again.
function.kind == .property-updater || (filling.count != 0 && unit.reading != unit.instance)

────────────────────
_ self-owner TypeId

` The class of the object a member's name alone is read from in the function being emitted, as
` `emit-identifier` reads it, or no type where it is read otherwise.
|? !unit.has-self
    no-type
|? unit.reading == unit.instance || unit.reading == unit.lender
    unit.owner-type
|? filling.count != 0
    no-type
|? unit.deferred-type != no-type
    unit.deferred-type
|? evaluates-value()
    unit.self-type
??
    no-type

────────────────────
_ do machine-default Typed
    - machine MachineFact
    - site SyntaxId

` What a property that holds a state machine holds until the machine starts: the first case of
` its union, as the reference gives a union no value is written for, holding what a local of its
` type holds with nothing written (`first-case`).
. layout = layout-of(machine.union, site)
if tables.layouts.is-union(layout)
    = first-case(machine.union, layout, site)
refuse(.refused-expression, site)
= Typed(make-operand(.operand-void, 0), no-type)

────────────────────
_ do machine-flag Typed
    - site SyntaxId
    - machine MachineFact
    - index U32
    - failed IRBlockId

` Whether a machine's case is active, where a case test is in reach of its flag: in the module
` of a machine a module's property is, from the global that holds its environment, which fails
` the test before the machine starts, in reach of the local a machine is kept in, beside it,
` and in the machine around a named machine written in a case of another. Elsewhere the case
` test is refused, as the reference tests the tag there.
. nothing = make-operand(.operand-void, 0)
. row = bindings.machine-slots(machine.module, machine.syntax)
. cases = program.modules[machine.module].tree.machine-cases
    - program.modules[machine.module].tree.state-items
        - program.modules[machine.module].tree.state-body(machine.syntax)
if !row || index >= cases.length as U32
    refuse(.refused-expression, site)
    = Typed(nothing, no-type)
. slot = bindings.machine-slot(row, cases[index], program.store-atom("(active)"))
if slot == no-slot
    refuse(.refused-expression, site)
    = Typed(nothing, no-type)
if machine.store == .store-local || (machine.store == .store-nested && machine.instance == unit.reading)
    = read-captured(slot, site, types.bool-type)
. storage = tables.storage-of(machine.module, instances.rows[machine.instance].decl)
. layout = tables.environments[machine.instance]
if machine.store != .store-global || storage == no-storage || foreign-machine || unbuilt-layout
    refuse(.refused-expression, site)
    = Typed(nothing, no-type)
.. foreign-machine = machine.module != instances.rows[unit.reading].module
.. unbuilt-layout = layout == no-layout || layout == unbuilt-environment
. field = tables.layouts.field(layout, 1 + tables.slot-fields[slot])
. base = load-global(tables.storage[storage], site)
pass-or-fail
    - compare(site, .compare-not-equal, base.operand, integer(managed-layout as MachineKind, 0))
    - failed
= Typed(load(base.operand, field.offset, field.layout, site), types.bool-type)

────────────────────
_ do match-row-case Typed
    - pattern SyntaxId
    - inner SyntaxId
    - value Typed
    - failed IRBlockId

` A pattern that names a case of a row of a table of unions: the row's tag is tested, and a
` name the pattern declares for what the case holds stands for the row's cells. Any other
` pattern for what the case holds is matched against the case gathered from them.
. nothing = make-operand(.operand-void, 0)
. type = value.type
. place = tables.unions.of(table-row-type(type))
. constant = facts.constant-of(unit.reading, pattern)
if place == U32.max || facts.plan-of(unit.reading, pattern) != .plan-case || constant == no-fact
    refuse(.refused-expression, pattern)
    = Typed(nothing, no-type)
. union = tables.unions.layouts[place]
. index = facts.constants[constant].bits as U32
if index >= union.cases.count
    refuse(.refused-expression, pattern)
    = Typed(nothing, no-type)
. located = subject-place(pattern, value.operand, type)
if switching && value.operand == switched-subject && switched-value == index as U64
    switching = false
else
    . tag = load
        - table-cell(pattern, located.columns, located.index, 0, u8-layout)
        - 0
        - u8-layout
        - pattern
    pass-or-fail(compare(pattern, .compare-equal, tag, integer(.machine-u8, index)), failed)
if inner == 0
    = Typed(value.operand, type)
. case-type = tables.unions.cases[union.cases.start + index].type
. part = inner
do match? tree.nodes[inner]
    | .node-type-tuple(row)
        if row.field-types.count == 1 && intrinsic(case-type) != .tuple
            part = tree.children[row.field-types.start]
do match? tree.nodes[part]
    | .node-identifier
        bind-case-cursor(part, value.operand, type, place, index, located)
        = Typed(value.operand, type)
    | .node-type-capture(row)
        if row.type == 0
            bind-case-cursor(row.id, value.operand, type, place, index, located)
            = Typed(value.operand, type)
. gathered = gather-union-case(pattern, place, index, located.columns, located.index)
= emit-pattern(part, gathered, failed)

────────────────────
_ do match-fields Typed ?! Refused
    - pattern SyntaxId
    - fields RowRange'SyntaxId
    - value Typed
    - failed IRBlockId

` A pattern of several in parentheses: each is matched against the field of a tuple or a
` struct in its place, and the pattern passes the whole. An optional is tested for a value
` first, and matched as what it holds; a union of tuples has no shape here. A table or a span
` of one is taken apart into its columns.
. nothing = make-operand(.operand-void, 0)
if types.is-optional(value.type)
    . type = value.type
    . tested = present(pattern, value)
    pass-or-fail(tested.operand, failed)
    . held = payload(pattern, Typed(value.operand, type))
    = match-fields(pattern, fields, held, failed)
. owner = value.type
. layout = layout-of(owner, pattern)
if is-row-source(intrinsic(owner))
    = match-columns(fields, value, layout)
if !is-aggregate(owner) || !tables.layouts.is-struct(layout)
    refuse(.refused-expression, pattern)
    = Typed(nothing, no-type)
if tables.layouts.rows[layout].fields.count < fields.count
    refuse(.refused-expression, pattern)
    = Typed(nothing, no-type)
for position in 0 .. < fields.count
    . field = tables.layouts.field(layout, position)
    emit-pattern(tree.children[fields.start + position], Typed(take(value.operand, field, pattern), field-type(owner, position)), failed)
= Typed(value.operand, owner)

────────────────────
_ do match-columns Typed
    - fields RowRange'SyntaxId
    - value Typed
    - layout LayoutId

` A pattern of several in parentheses matched against a table or a span of one, which it
` takes apart as TypeScript does: each field is a view of its column, of the type the name
` written for it holds, and the name is bound to it. One written as `_` still has the table
` checked. Any other pattern of a column has no shape here. The pattern passes the table.
. owner = value.type
. binding = instances.rows[unit.reading].binding
for position in 0 .. < fields.count
    . field = tree.children[fields.start + position]
    . name SyntaxId = 0
    do match? tree.nodes[field]
        | .node-type-wildcard
            table-source(field, value.operand, owner, layout)
            continue
        | .node-identifier
            name = field
        | .node-type-capture(row)
            if row.type == 0
                name = row.id
    if name == 0 || binding == no-binding || unit.reading != unit.instance
        refuse(.refused-expression, field)
        break
    . resolution = bindings.resolution-of(binding, name)
    if resolution.kind != .resolve-slot
        refuse(.refused-expression, field)
        break
    . held = facts.slot-type(unit.instance, slot-offset(resolution.slot, name))
    . view = table-view(field, value.operand, owner, layout, position, held)
    bind-name(name, Typed(view.operand, held))
= Typed(value.operand, owner)

────────────────────
_ do call-at FactId
    - site SyntaxId
    - form CallForm

` The first call of a form that the type pass recorded at a node, or none.
. fact = facts.first-call(unit.reading, site)
while fact != no-fact && facts.calls[fact].form != form
    fact = facts.calls[fact].next
= fact

────────────────────
_ do read-part Typed
    - site SyntaxId
    - fact FactId
    - subject Operand
    - type TypeId
    - argument Operand
    - given TypeId = no-type

` A call a pattern of a list makes on its subject, which the type pass recorded at the
` pattern or at the pattern of an item. One whose function raises an error has no shape.
if fact != no-fact && facts.calls[fact].callee != no-instance
    if instances.signatures[facts.calls[fact].callee].errors.count != 0
        refuse(.refused-expression, site)
        = Typed(make-operand(.operand-void, 0), no-type)
= call-protocol(site, fact, subject, type, argument, given, false)

────────────────────
_ do match-text Typed
    - pattern SyntaxId
    - value Typed
    - failed IRBlockId

` A pattern of texts, as the type pass planned it for a `String`. Its length is read and is
` to be no less than that of the texts written; then the texts before the rest are to start
` it and those after to end it, by the calls recorded at the pattern. Unless the pattern only
` tests, a name given a text is bound to that text, and a rest with a name to what lies
` between, read by its range from the length read again. The pattern passes the subject.
. nothing = make-operand(.operand-void, 0)
. type = value.type
. parts [SyntaxId]
tree.text-parts(pattern, parts)
. prefix = ""
. suffix = ""
. rest SyntaxId = 0
for part in parts
    . text = tree.text-of(part)
    if !text
        rest = part
    else if rest == 0
        prefix = "$prefix${text}"
    else
        suffix = "$suffix${text}"
. measured = call-at(pattern, .call-getter)
if rest == 0 || measured == no-fact
    refuse(.refused-expression, pattern)
    = Typed(nothing, no-type)
. length = read-part(pattern, measured, value.operand, type, nothing)
if length.type != types.size-type
    refuse(.refused-expression, pattern)
    = Typed(nothing, no-type)
. least = integer(.machine-u64, (prefix.length + suffix.length) as U64)
pass-or-fail(compare(pattern, .compare-greater-equal, length.operand, least), failed)
. fact = call-at(pattern, .call-method)
for text in [prefix, suffix]
    if text.length == 0
        continue
    . tested = read-part
        - pattern
        - fact
        - value.operand
        - type
        - make-operand(.operand-constant, ir.add-string(text))
        - types.string-type
    if tested.type != types.bool-type
        refuse(.refused-expression, pattern)
        = Typed(nothing, no-type)
    pass-or-fail(tested.operand, failed)
    fact = next-call(fact)
if !matching.testing
    for part in parts
        do match? tree.nodes[part]
            | .node-type-capture(row)
                bind-name
                    - row.id
                    - Typed(make-operand(.operand-constant, ir.add-string(tree.text-of(part)!)), types.string-type)
if !matching.testing && has-name(rest)
    . again = read-part(pattern, measured, value.operand, type, nothing)
    . end = again.operand
    if suffix.length != 0
        end = arithmetic
            - pattern
            - .arithmetic-subtract
            - again.operand
            - integer(.machine-u64, suffix.length as U64)
            - u64-layout
    match-rest(rest, value.operand, type, integer(.machine-u64, prefix.length as U64), end, false, failed)
= Typed(value.operand, type)

────────────────────
_ do match-items Typed
    - pattern SyntaxId
    - items RowRange'SyntaxId
    - value Typed
    - failed IRBlockId

` A pattern of a list, as the type pass planned it. The subject is first what an optional
` holds, or the case of a union the pattern has conversions for. Its length is read once
` and tested: as many items as the pattern writes, or no fewer where it writes a rest. Each
` item before the rest is then read at its place and matched, each after the rest at its
` place from the end, and last a rest with a name is read by the range of what lies
` between, unless the pattern only tests. The rows of a table or a span of one, and the items
` of a view of a field's column, are counted and read as TypeScript answers `t.length` and
` `t[i]`, and a rest of them with a name is the span or the view `t[a .. < b]` gives. The
` pattern passes the subject.
. nothing = make-operand(.operand-void, 0)
. subject = value
if types.is-optional(subject.type) || intrinsic(subject.type) == .union
    subject = match-type(pattern, Typed(value.operand, subject.type), failed)
. type = subject.type
. views = reads-views(pattern, type)
. layout = if views then layout-of(type, pattern) else no-layout
. count = items.count
. rest = count
for position in 0 .. < count
    do match? tree.nodes[tree.children[items.start + position]]
        | .node-type-remainder
            rest = position
. fixed = if rest == count then count else count - 1
. length = list-length(pattern, subject.operand, type, views, layout)
. wanted = integer(.machine-u64, fixed)
pass-or-fail
    - compare
        - pattern
        - if rest == count then .compare-equal else .compare-greater-equal
        - length.operand
        - wanted
    - failed
for position in 0 .. < count
    if position == rest
        continue
    . item = tree.children[items.start + position]
    . index = integer(.machine-u64, position)
    if position > rest
        index = arithmetic
            - item
            - .arithmetic-subtract
            - length.operand
            - integer(.machine-u64, count - position)
            - u64-layout
    . reading-call = call-at(item, .call-item-read)
    . read = Typed(nothing, no-type)
    if views
        read = view-item(item, reading-call, subject.operand, type, layout, index)
    else
        read = read-part(item, reading-call, subject.operand, type, index, types.index-type)
    emit-pattern(item, read, failed)
if rest != count && !matching.testing
    . end = length
    if rest + 1 != count
        . arithmeticd = arithmetic
            - pattern
            - .arithmetic-subtract
            - length.operand
            - integer(.machine-u64, count - rest - 1)
            - u64-layout
        end = Typed(arithmeticd, end.type)
    match-rest
        - tree.children[items.start + rest]
        - subject.operand
        - type
        - integer(.machine-u64, rest)
        - end.operand
        - views
        - failed
= Typed(subject.operand, type)

────────────────────
_ do list-length Typed
    - pattern SyntaxId
    - subject Operand
    - type TypeId
    - views Bool
    - layout LayoutId

. nothing = make-operand(.operand-void, 0)
. measured = call-at(pattern, .call-getter)
. length = Typed(nothing, no-type)
if views
    length = view-length(pattern, subject, type, layout)
else if measured != no-fact
    length = read-part(pattern, measured, subject, type, nothing)
else
    length = array-length(pattern, subject, type)
if length.type != types.size-type
    refuse(.refused-expression, pattern)
    = Typed(nothing, no-type)
= length

────────────────────
_ reads-views Bool
    - pattern SyntaxId
    - type TypeId

` Whether the type pass planned a pattern of a list to read the rows of a table or a span of
` one, or the items of a view of a field's column, as TypeScript answers them.
constant != no-fact && facts.constants[constant].bits == 2 && viewed

.. constant = facts.constant-of(unit.reading, pattern)
.. kind = intrinsic(type)
.. viewed = is-row-source(kind) || kind == .table-column || kind == .immutable-table-column

────────────────────
_ do view-length Typed
    - id SyntaxId
    - held Operand
    - type TypeId
    - layout LayoutId

` How many rows a table or a span of one holds, or how many items a view of a field's column
` does, as TypeScript counts them.
if is-row-source(intrinsic(type))
    = rows-length(id, held, type, layout)
. counted = column-length(id, held, layout)
= Typed(counted.operand, types.size-type)

────────────────────
_ do view-item Typed
    - site SyntaxId
    - fact FactId
    - subject Operand
    - type TypeId
    - layout LayoutId
    - index Operand

` The row at an index of a table or a span of one, or the item at an index of a view of a
` field's column, that a pattern of an item is matched against, as `t[i]` reads it.
if is-row-source(intrinsic(type))
    = row-at(site, fact, subject, type, layout, index)
= column-item(site, subject, type, index)

────────────────────
_ do row-at Typed
    - site SyntaxId
    - fact FactId
    - subject Operand
    - type TypeId
    - layout LayoutId
    - index Operand

` The row at an index of a table or a span of one that a pattern of an item is matched
` against, as `t[i]` reads it: of the type the read recorded at the item gives.
if fact == no-fact || facts.calls[fact].callee == no-instance
    refuse(.refused-expression, site)
    = Typed(make-operand(.operand-void, 0), no-type)
. cursor = row-place(site, subject, type, layout, index)
= row-value(site, cursor, instances.signatures[facts.calls[fact].callee].returns)

────────────────────
_ has-name Bool
    - remainder SyntaxId

` Whether the rest of a pattern of a list has a name.
match tree.nodes[remainder]
    | .node-type-remainder(row)
        row.name != 0
    ??
        false

────────────────────
_ do match-rest
    - remainder SyntaxId
    - subject Operand
    - type TypeId
    - start Operand
    - end Operand
    - views Bool
    - failed IRBlockId

` The rest of a pattern of a list, where it has a name: the range from `start` to `end` is
` made by the construction the type pass recorded at the rest, with a step of one, and the
` subject is read by it with the call recorded after, or of the rows of a table, a span of one or
` a view of a field's column, made their span or view as `t[a .. < b]` makes it. What it gives is
` matched by the name.
. name SyntaxId = 0
do match? tree.nodes[remainder]
    | .node-type-remainder(row)
        name = row.name
if name == 0
    =
. made = call-at(remainder, .call-constructor)
. sliced = if made == no-fact then no-fact else facts.calls[made].next
if sliced == no-fact || facts.calls[sliced].callee == no-instance
    refuse(.refused-expression, remainder)
    =
. range = instances.argument-type(facts.calls[sliced].callee, 0)
. layout = layout-of(range, remainder)
. mark = given.length
given += Typed(start, types.index-type)
given += Typed(end, types.index-type)
given += Typed(integer(.machine-u64, 1), types.index-type)
. span = make-fields(range, layout, facts.calls[made].fills, mark, 3, remainder)
drop-given(mark)
. sliced-type = instances.signatures[facts.calls[sliced].callee].returns
. read = if views then span-of(remainder, subject, type, span, range, 0, sliced-type) else read-part(remainder, sliced, subject, type, span, range)
emit-pattern(name, read, failed)

────────────────────
_ do match-keys Typed
    - pattern SyntaxId
    - items RowRange'SyntaxId
    - value Typed
    - failed IRBlockId

` A pattern of a map, as the type pass planned it. The subject is first what an optional
` holds, or the case of a union the pattern has conversions for. Each key written is
` evaluated, converted as recorded at the key, and read by the call recorded at its item: a
` key the map lacks does not match, and what a key holds is matched by the pattern written
` for it. Last a rest with a name is the subject without the keys matched, unless the
` pattern only tests. The pattern passes the subject.
. nothing = make-operand(.operand-void, 0)
. subject = value
if types.is-optional(subject.type) || intrinsic(subject.type) == .union
    subject = match-type(pattern, Typed(value.operand, subject.type), failed)
. type = subject.type
. mark = given.length
. rest SyntaxId = 0
for item in tree.children[items]
    do match tree.nodes[item]
        | .node-type-map-item(row)
            . key = convert(row.key, .reason-argument, emit-expression(key-of(row.key)))
            . keyed = key.type
            . read = read-part(item, call-at(item, .call-item-read), subject.operand, type, key.operand, keyed)
            if types.is-optional(read.type)
                . maybe = read.type
                pass-or-fail(present(item, read).operand, failed)
                read = payload(item, Typed(read.operand, maybe))
            given += Typed(key.operand, keyed)
            given += read
            emit-pattern(row.value, read, failed)
        | .node-type-remainder(row)
            if row.name != 0
                rest = item
        ??
            refuse(.refused-expression, item)
            = Typed(nothing, no-type)
if rest != 0 && !matching.testing
    match-unmatched(rest, subject.operand, type, mark, failed)
drop-given(mark)
= Typed(subject.operand, type)

────────────────────
_ key-of SyntaxId
    - key SyntaxId

` The expression a key of a map pattern is compared to: what is written, or the name read.
match tree.nodes[key]
    | .node-type-equality(row)
        row.expr
    ??
        key

────────────────────
_ do match-unmatched
    - remainder SyntaxId
    - subject Operand
    - type TypeId
    - mark Size
    - failed IRBlockId

` The rest of a pattern of a map, where it has a name: an empty map of the subject's type is
` made by the construction the type pass recorded at the rest, each key matched, held with
` what it holds from `mark` on, is stored in it by the call recorded next, and the rest is
` what the last call recorded gives of the subject and that map. The name matches it.
. name SyntaxId = 0
do match? tree.nodes[remainder]
    | .node-type-remainder(row)
        name = row.name
. made = call-at(remainder, .call-constructor)
. stored = if made == no-fact then no-fact else facts.calls[made].next
. taken = if stored == no-fact then no-fact else facts.calls[stored].next
if taken == no-fact
    refuse(.refused-expression, remainder)
    =
. matched = emit-fact-call(remainder, facts.calls[made], 0, RowRange'SyntaxId(), 0, 0, type)
if matched.type != type
    refuse(.refused-expression, remainder)
    =
. end = given.length
. position = mark
while position < end
    call-made(remainder, stored, matched.operand, type, position, 2)
    position += 2
given += Typed(matched.operand, type)
. left = call-made(remainder, taken, subject, type, end, 1)
drop-given(end)
emit-pattern(name, left, failed)

────────────────────
_ do call-made Typed
    - site SyntaxId
    - fact FactId
    - receiver Operand
    - type TypeId
    - start Size
    - count U32

` A call a pattern makes that no call in the source writes, which the type pass recorded at
` the pattern: of a function declared for the receiver's type that raises no error, with the
` receiver as it is and the arguments held from `start` on, each of the type the function
` takes. A function some class declares again is chosen by the class of the object. Any
` other has no shape here.
. nothing = make-operand(.operand-void, 0)
if fact == no-fact || facts.calls[fact].callee == no-instance || uncallable
    refuse(.refused-expression, site)
    = Typed(nothing, no-type)
.. uncallable = !is-callable(facts.calls[fact].callee)
. callee = facts.calls[fact].callee
. signature = instances.signatures[callee]
if instances.rows[callee].self-type != type || signature.args.count != count || signature-raises
    refuse(.refused-expression, site)
    = Typed(nothing, no-type)
.. signature-raises = signature.errors.count != 0
for offset in 0 .. < count
    if instances.argument-type(callee, offset) != given[start + offset].type
        refuse(.refused-expression, site)
        = Typed(nothing, no-type)
. pended = pending.length
pending += receiver
for offset in 0 .. < count
    pending += given[start + offset].operand
if tables.is-class(type) && tables.is-overridden(callee)
    = call-method(callee, site, pended)
= call-instance(callee, site, pended)

────────────────────
_ do emit-match Typed
    - id SyntaxId
    - pattern SyntaxId

` A match with no subject, whose arms are conditions tested in order. The value of the arm
` taken is the value of the match. Where the arms end in no else and none is taken, the
` match is an optional that holds nothing, as the type pass typed it.
. nothing = make-operand(.operand-void, 0)
if pattern == 0
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. type = facts.node-type(unit.reading, id)
. layout = layout-of(type, id)
. joined = ir.reserve-block()
. slot = join-slot(layout)
. mark = joins.length
. is-closed = emit-arms(id, pattern, type, joined, slot)
if !is-closed
    if types.is-optional(type)
        arrive(id, empty-optional(type, layout).operand, joined, slot)
    else
        refuse(.refused-expression, id)
. result = close-joins(joined, mark, layout, slot)
= Typed(result, type)

────────────────────
_ do run-arms
    - id SyntaxId
    - pattern SyntaxId

` A match with no subject whose arms give no value: the conditions are tested in order, and
` the arm taken is run for what it does. Where none is taken nothing is run.
if pattern == 0
    refuse(.refused-statement, id)
    =
. joined = ir.reserve-block()
. is-closed = emit-arms(id, pattern, no-type, joined, make-operand(.operand-void, 0))
if !is-closed
    jump(joined)
ir.start-block(joined)

────────────────────
_ do close-joins Operand
    - joined IRBlockId
    - mark Size
    - layout LayoutId
    - slot Operand

` Starts the block the sides of a join arrive in, and gives the value they left: one of them
` by the block each ended in, or for a struct the memory each copied its own into.
ir.start-block(joined)
if operand-kind(slot) != .operand-void
    drop-joins(mark)
    = slot
. start U32 = ir.operands.length
for position in mark .. < joins.length
    ir.add-operand(joins[position])
drop-joins(mark)
. count U32 = ir.operands.length - start
= make-operand(.operand-value, append(.op-phi, 0, Span(start, count), 0, layout))

────────────────────
_ do join-slot Operand
    - layout LayoutId

` Where the sides of a join leave a struct: memory in the frame that each copies its value
` into. Any other value needs none, and is joined by the block each side ends in.
if tables.layouts.is-struct(layout)
    = frame(layout)
= make-operand(.operand-void, 0)

────────────────────
_ do arrive
    - site SyntaxId
    - value Operand
    - joined IRBlockId
    - slot Operand

` Leaves the value of one side for its join, and goes there.
if operand-kind(slot) != .operand-void
    copy(slot, value, ir.operand-layout(slot), false, site)
else
    joins += value
    joins += make-operand(.operand-block, ir.current)
jump(joined)

────────────────────
_ do emit-choice Typed
    - id SyntaxId
    - chosen SyntaxId
    - condition SyntaxId
    - other SyntaxId

` `if condition then chosen else other`: the condition is tested, and only the side it picks is
` evaluated. Each side arrives in the type of the whole by the conversion recorded for a side
` of its type.
. nothing = make-operand(.operand-void, 0)
. type = facts.node-type(unit.reading, id)
. layout = layout-of(type, id)
. tested = test(id, emit-expression(condition), true, false)
. taken = ir.reserve-block()
. passed = ir.reserve-block()
. joined = ir.reserve-block()
. slot = join-slot(layout)
. mark = joins.length
branch(tested.operand, taken, passed)
ir.start-block(taken)
emit-arm(id, chosen, type, joined, slot)
ir.start-block(passed)
emit-arm(id, other, type, joined, slot)
= Typed(close-joins(joined, mark, layout, slot), type)

────────────────────
_ do emit-arms Bool ?! Refused
    - site SyntaxId
    - pattern SyntaxId
    - type TypeId
    - joined IRBlockId
    - slot Operand

` Emits the arms of a match in order, and says whether an else ended them. Each arm leaves
` its value and the block it ends in for the match to join. An arm that is a test and no
` more gives what it tested where that tests as true: of an optional, what it holds. The body
` of an arm that tests a condition reads what the condition gave as its `it`. An arm that
` raises for whatever is left ends them as an else does.
do match? tree.nodes[pattern]
    | .node-type-or(row)
        if emit-arms(site, row.left, type, joined, slot)
            = true
        = emit-arms(site, row.right, type, joined, slot)
    | .node-type-transform(row)
        . condition SyntaxId = 0
        . is-else = row.pattern == 0
        if !is-else
            do match? tree.nodes[row.pattern]
                | .node-type-wildcard
                    is-else = true
                | .node-type-predicate(predicate)
                    condition = predicate.expr
        if is-else
            if !arm-leaves(pattern, row.expr) && !arm-raises(row.expr)
                emit-arm(site, row.expr, type, joined, slot, true)
            = true
        if condition == 0
            refuse(.refused-expression, pattern)
            = false
        . given = emit-expression(condition)
        . given-type = given.type
        . tested = test(condition, given)
        . taken = ir.reserve-block()
        . passed = ir.reserve-block()
        branch(tested.operand, taken, passed)
        ir.start-block(taken)
        . named = bound.length
        . it-slot = arm-slot-of(pattern, .slot-it)
        if it-slot != no-slot
            bound += BoundValue(it-slot, given-type, given.operand)
        if !arm-leaves(pattern, row.expr) && !arm-raises(row.expr)
            emit-arm(site, row.expr, type, joined, slot, true)
        drop-bound(named)
        ir.start-block(passed)
        = false
    | .node-type-predicate(row)
        . subject = emit-expression(row.expr)
        . held = subject.type
        . tested = test(row.expr, Typed(subject.operand, held))
        . taken = ir.reserve-block()
        . passed = ir.reserve-block()
        branch(tested.operand, taken, passed)
        ir.start-block(taken)
        . value = Typed(subject.operand, held)
        if held != type && holds(held, type)
            value = payload(row.expr, value)
        if value.type != type
            value = join(site, value)
        if value.type != type
            refuse(.refused-conversion, pattern)
        arrive(site, value.operand, joined, slot)
        ir.start-block(passed)
        = false
    | .node-type-panic(row)
        do match? tree.nodes[row.pattern]
            | .node-type-transform(arm)
                if arm.pattern == 0 && arm.expr != 0
                    raise-given(pattern, arm.expr, row.pattern)
                    = true
                if arm.expr != 0
                    do match? tree.nodes[arm.pattern]
                        | .node-type-predicate(predicate)
                            . given = emit-expression(predicate.expr)
                            . tested = test(predicate.expr, given)
                            . taken = ir.reserve-block()
                            . passed = ir.reserve-block()
                            branch(tested.operand, taken, passed)
                            ir.start-block(taken)
                            raise-given(pattern, arm.expr, row.pattern)
                            ir.start-block(passed)
                            = false
refuse(.refused-expression, pattern)
= false

────────────────────
_ do emit-arm ?! Refused
    - site SyntaxId
    - body SyntaxId
    - type TypeId
    - joined IRBlockId
    - slot Operand
    - guards Bool = false

` The value of one arm, converted as the match records for a side of its type, left for the
` match with the block the arm ends in. With `guards` an error is a value where the type of the
` match holds it, and has no shape where that type carries errors. With no type the arm is run
` for what it does.
if type == no-type
    emit-block(body)
    jump(joined)
    =
. value = arm-value(site, body, type, guards, type, U32.max, operand-kind(slot) != .operand-void)
arrive(site, value.operand, joined, slot)

────────────────────
_ do ending SyntaxId
    - body SyntaxId

` The expression a body ends in, which gives the body its value, once the statements a block
` holds before it have run in order. None where a block holds no statement.
clear-turn-lazies(body)
raise-elements(body)
. last = body
do match? tree.nodes[body]
    | .node-block(block)
        last = 0
        for statement in tree.children[block.body]
            if !runs-in-body(statement) || is-lazy-local(statement)
                continue
            if last != 0
                emit-statement(last)
            last = statement
= last

────────────────────
_ do emit-block-value Typed
    - id SyntaxId
    - type TypeId

` A block written as a value: the assertions under it run, then its expression gives the
` value. It is a block of its own: the cleanups opened while its value is evaluated run where
` it ends, after a struct is copied out of what they may change.
. mark = open-cleanups.length
. own-scoping = scoping
scoping = scoping.block-base = mark
clear-turn-lazies(id)
raise-elements(id)
. only = checked-expression(id)
if only == 0
    refuse(.refused-expression, id)
. emitted = emit-expression(only)
if type != no-type && emitted.type != type
    refuse(.refused-conversion, id)
= close-value(emitted, mark, own-scoping, id)

────────────────────
_ do close-value Typed
    - value Typed
    - mark Size
    - outer Scoping
    - id SyntaxId

` Ends a block written as a value, which began with the cleanups up to `mark` open, in a block
` whose cleanups begin where `outer` says. The cleanups it opened run here, after a struct is copied
` out of what they may change.
. kept = value
. given = kept.type
if open-cleanups.length != mark
    if given != no-type && given != types.void-type
        . layout = layout-of(given, id)
        if tables.layouts.is-struct(layout)
            kept = Typed(snapshot(value.operand, layout, id), kept.type)
    close-cleanups(mark)
scoping = outer
= kept

────────────────────
_ do emit-leading SyntaxId
    - body SyntaxId

` Runs in order the statements of a block written as a value but its last, and gives the
` last, whose value is the block's. A lazy local, which emits nothing where it is declared, is
` none of them. None where the block runs no statement.
. last SyntaxId = 0
do match? tree.nodes[body]
    | .node-block(block)
        for statement in tree.children[block.body]
            if !runs-in-body(statement) || is-lazy-local(statement)
                continue
            if last != 0
                emit-statement(last)
            last = statement
= last

────────────────────
_ do only-expression SyntaxId
    - body SyntaxId

` The expression a body stands for: itself, or the one statement of a block that holds
` nothing else but lazy locals, which emit nothing where they are declared. A block of more
` has none.
do match? tree.nodes[body]
    | .node-block(block)
        . found SyntaxId = 0
        for statement in tree.children[block.body]
            if is-lazy-local(statement)
                continue
            if found != 0
                = 0
            found = statement
        = found
= body

────────────────────
_ do checked-expression SyntaxId
    - body SyntaxId

` The expression a block gives its value by, once the assertions and the declarations written
` under it have run, which they do here in their order: the last statement of a block that
` holds nothing else but those and lazy locals, which emit nothing where they are declared. A
` block of anything else has none.
. last SyntaxId = 0
do match? tree.nodes[body]
    | .node-block(block)
        for statement in tree.children[block.body]
            if is-lazy-local(statement)
                continue
            if last != 0
                if !is-assertion(last) && !(tree.nodes[last] is .node-declare)
                    = 0
                emit-statement(last)
            last = statement
= if last == 0 || is-assertion(last) || tree.nodes[last] is .node-declare then 0 else last

────────────────────
_ is-assertion Bool
    - statement SyntaxId

match tree.nodes[statement]
    | .node-assertion-syntax
        true
    ??
        false

────────────────────
_ do is-lazy-local Bool
    - statement SyntaxId

` Whether a statement declares a lazy local, or a local of a row of a markup loop region read
` as a getter, which emits nothing where it stands.
do match? tree.nodes[statement]
    | .node-declare(row)
        = row.is-lazy || declares-getter(row.left)
= false

────────────────────
_ do declares-getter Bool
    - left SyntaxId

` Whether a declaration declares a local of a row of a markup loop region that is read as a
` getter: its value is made where it is read.
. binding = instances.rows[unit.reading].binding
if binding == no-binding
    = false
do match? tree.nodes[left]
    | .node-type-capture(capture)
        . resolution = bindings.resolution-of(binding, capture.id)
        = resolution.kind == .resolve-slot && bindings.slots[resolution.slot].getter != 0
= false

────────────────────
_ do emit-getter Typed
    - id SyntaxId

` A read of a local of a row of a markup loop region read as a getter: the value its
` declaration writes, made here.
. resolution = bindings.resolution-of(instances.rows[unit.reading].binding, id)
do match? tree.nodes[bindings.slots[resolution.slot].getter]
    | .node-declare(row)
        = emit-expression(row.right)
refuse(.refused-expression, id)
= Typed(make-operand(.operand-void, 0), no-type)

────────────────────
_ do join Typed
    - site SyntaxId
    - value Typed

` One side of a join in the type of the join: the conversion recorded at the join that
` starts at the side's type. Sides of one type convert alike, so the first such is taken. A
` lambda becomes its function first, and the conversions after that one take the function on.
. fact = facts.first-conversion(unit.reading, site)
. result = value
. found = false
while fact != no-fact
    . row = facts.conversions[fact]
    if row.reason == .reason-join && row.from == result.type
        . lambda = intrinsic(result.type) == .closure
        result = convert-one(site, row, result)
        found = true
        if !lambda
            = result
    fact = row.next
if !found
    refuse(.refused-conversion, site)
= result

────────────────────
_ do drop-joins
    - mark Size

while joins.length > mark
    joins.pop()

────────────────────
_ do emit-concat Typed
    - id SyntaxId
    - lhs SyntaxId
    - rhs SyntaxId
    - interpolated Bool

` Joins two values as text: the function the type pass chose for the left one's type, called
` with the right one. An interpolation makes its left piece text before it evaluates the
` right one. `++` evaluates both first.
. left = emit-expression(lhs)
= join-text(id, lhs, left.operand, left.type, rhs, interpolated)

────────────────────
_ do join-text Typed
    - id SyntaxId
    - lhs SyntaxId
    - given Operand
    - given-type TypeId
    - rhs SyntaxId
    - interpolated Bool

` Joins text to a left value already evaluated as `lhs` gives it.
. nothing = make-operand(.operand-void, 0)
. fact = own-call(id)
if fact == no-fact
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. callee = facts.calls[fact].callee
. first = if interpolated then convert(id, .reason-operator, Typed(given, given-type)) else Typed(apart(Typed(given, given-type), lhs, disturbed), given-type)
    .. disturbed = !is-inert(rhs)
. left = first.operand
. left-type = first.type
. right = emit-expression(rhs)
. right-type = right.type
if !interpolated
    . converted = convert(id, .reason-operator, Typed(left, left-type))
    left = converted.operand
    left-type = converted.type
if callee == no-instance || left-type != instances.rows[callee].self-type
    refuse(.refused-conversion, lhs)
    = Typed(nothing, no-type)
right = convert(rhs, .reason-argument, Typed(right.operand, right-type))
if right.type != instances.argument-type(callee, 0)
    refuse(.refused-conversion, rhs)
    = Typed(nothing, no-type)
. mark = pending.length
pending += left
pending += right.operand
= call-method(callee, id, mark)

────────────────────
_ do emit-markup-read Typed
    - id SyntaxId
    - object SyntaxId

` A read of a markup link: the subject, given to the markup runtime's function as a
` `MarkupElement`, and the host it answers, taken where it is one as the class the read gives,
` unchecked, as the reference takes it.
. nothing = make-operand(.operand-void, 0)
. read = facts.markup-read-of(unit.reading, id)
if !read || (object == 0 && !unit.has-self)
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. subject = Typed(unit.self, if unit.reading != unit.instance then instances.rows[unit.reading].self-type else unit.owner-type)
if object != 0
    subject = emit-expression(object)
. host = convert(id, .reason-argument, subject)
. mark = pending.length
pending += host.operand
. linked = call-instance(read.reader, id, mark)
if read.target == no-type
    = linked
. type = facts.node-type(unit.reading, id)
. layout = layout-of(type, id)
. host-type = types.optional-inner(instances.signatures[read.reader].returns)
. host-layout = layout-of(host-type, id)
. holding = ir.reserve-block()
. empty = ir.reserve-block()
. joined = ir.reserve-block()
. slot = join-slot(layout)
. sides = joins.length
branch(present(id, Typed(linked.operand, instances.signatures[read.reader].returns)).operand, holding, empty)
ir.start-block(holding)
. given = payload(id, Typed(linked.operand, instances.signatures[read.reader].returns))
. made = take(given.operand, tables.layouts.field(host-layout, 0), id)
arrive(id, wrap(id, Typed(made, read.target), type).operand, joined, slot)
ir.start-block(empty)
arrive(id, empty-optional(type, layout).operand, joined, slot)
= Typed(close-joins(joined, sides, layout, slot), type)

────────────────────
_ do emit-style-property Typed
    - id SyntaxId

. found = facts.style-read-of(unit.reading, id)
if !found || !found.is-reference
    refuse(.refused-expression, id)
    = Typed(make-operand(.operand-void, 0), no-type)
. read = found
. number = style-number(id, read.style)
. mark = pending.length
pending += integer(.machine-u64, number)
pending += integer(.machine-u64, read.property - tables.style-uses[number].first)
if read.component != U32.max
    pending += integer(.machine-u64, read.component)
= call-instance(read.reader, id, mark)

────────────────────
_ do emit-style-read Typed
    - id SyntaxId
    - object SyntaxId

` A read of a style property, `$name`: the subject, `this` where none is written, cast to the
` runtime's `Pointer`, given with the number of the property's style and the property's place
` in it to the runtime's reader, and the bits it answers taken as the property's type
` (`decode-style`). An optional's reader answers its bits with whether it holds nothing, and
` what it holds is taken from them where it holds something, or for a number or an object
` whatever it holds. A read of the flag of a domain gives the subject and the domain's number
` to the runtime's reader of the flag.
. nothing = make-operand(.operand-void, 0)
. read = facts.style-read-of(unit.reading, id)
. flag = facts.style-flag-of(unit.reading, id)
if (!read && !flag) || (object == 0 && !unit.has-self)
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. subject = Typed(unit.self, if unit.reading != unit.instance then instances.rows[unit.reading].self-type else unit.owner-type)
if object != 0
    subject = emit-expression(object)
. pointer = if read && read.hosted then subject.operand else style-subject(id, subject.operand, subject.type)
if flag
    . flagged = pending.length
    pending += pointer
    pending += integer(.machine-u64, tables.domain-number(flag.domain))
    = call-instance(flag.call, id, flagged)
. read-type = if read!.sheet != U32.max then read!.type else property-type
    .. property-type = facts.style-properties[read!.property].type
. tracked = read!.sheet != U32.max && live-actions.length != 0 && tracks-collection
    .. tracks-collection = instances.live.track-collection != no-instance
if tracked
    . watched = pointer
    if read!.hosted
        . held = if intrinsic(subject.type) == .interface then load(subject.operand, 0, managed-layout, id) else subject.operand
        watched = num-cast(id, held, managed-layout, pointer-layout)
    . tracking = pending.length
    pending += load-local(live-actions[live-actions.length - 1].previous, id)
    pending += load-local(live-actions[live-actions.length - 1].next, id)
    pending += watched
    do call-instance(instances.live.track-collection, id, tracking)
. mark = pending.length
pending += pointer
if read!.sheet != U32.max
    pending += integer(.machine-u64, tables.sheet-number(read!.sheet))
    pending += integer(.machine-u64, read!.offset)
    pending += integer(.machine-u8, if tracked then 1 else 0)
else
    . number = style-number(id, read!.style)
    pending += integer(.machine-u64, number)
    pending += integer(.machine-u64, read!.property - tables.style-uses[number].first)
. answer = call-instance(read!.reader, id, mark)
if !types.is-optional(read-type)
    = decode-style(id, answer.operand, read-type)
. pair = layout-of(instances.signatures[read!.reader].returns, id)
. bits = load(answer.operand, tables.layouts.field(pair, 0).offset, i64-layout, id)
. none = load(answer.operand, tables.layouts.field(pair, 1).offset, u8-layout, id)
. there = compare(id, .compare-equal, none, integer(.machine-u8, 0))
. inner = types.optional-inner(read-type)
. kind = intrinsic(inner)
. layout = layout-of(read-type, id)
. cell = ir.add-local(layout)
. holding = ir.reserve-block()
. empty = ir.reserve-block()
. joined = ir.reserve-block()
if kind == .union || boxed-style(kind)
    branch(there, holding, empty)
    ir.start-block(holding)
    . held = decode-style(id, bits, inner)
    store-local(cell, wrap(id, held, read-type).operand, id)
    jump(joined)
else
    . held = decode-style(id, bits, inner)
    branch(there, holding, empty)
    ir.start-block(holding)
    store-local(cell, wrap(id, Typed(held.operand, inner), read-type).operand, id)
    jump(joined)
ir.start-block(empty)
store-local(cell, empty-optional(read-type, layout).operand, id)
jump(joined)
ir.start-block(joined)
= Typed(load-local(cell, id), read-type)

────────────────────
_ do decode-style Typed
    - site SyntaxId
    - bits Operand
    - type TypeId

` A value of a style property's type that is no optional taken from the bits of its slot, as the
` reference's `decodeStyleScalar` takes it: a number's own, a float's by the `F64` they are, an
` object as the runtime resolves its handle, a union as `decode-style-union` says, and any other
` value from the box the runtime resolves its handle to.
. kind = intrinsic(type)
if kind == .class
    . pointer = object-pointer(site, bits)
    = Typed(num-cast(site, pointer.operand, pointer-layout, managed-layout), type)
if kind == .union
    = decode-style-union(site, bits, type)
if boxed-style(kind)
    = unbox-style(site, bits, type)
. layout = layout-of(type, site)
if layout == f32-layout || layout == f64-layout
    . cell = frame(i64-layout)
    store(cell, 0, bits, false, site)
    = Typed(num-cast(site, load(cell, 0, f64-layout, site), f64-layout, layout), type)
if !is-number(layout)
    refuse(.refused-type, site)
    = Typed(bits, no-type)
= Typed(num-cast(site, bits, i64-layout, layout), type)

────────────────────
_ do object-pointer Typed
    - site SyntaxId
    - bits Operand

` The pointer the style runtime resolves the bits of a handle to.
. mark = pending.length
pending += bits
= call-instance(facts.style-runtime.object-pointer, site, mark)

────────────────────
_ do unbox-style Typed
    - site SyntaxId
    - bits Operand
    - type TypeId

` A value from the box the bits of its handle resolve to, as the reference's
` `decodeStyleWideValue` reads it.
for coding in facts.style-codings
    if coding.type == type && coding.holder != no-instance
        . box = instances.rows[coding.holder].self-type
        . object = num-cast(site, object-pointer(site, bits).operand, pointer-layout, managed-layout)
        . value = load-property(site, object, box, program.store-atom("value"), true)
        = Typed(value.operand, type)
refuse(.refused-type, site)
= Typed(bits, no-type)

────────────────────
_ do decode-style-union Typed
    - site SyntaxId
    - bits Operand
    - type TypeId

` A union taken from the bits of its slot, as the reference's `decodeStyleUnion` takes it: the
` number of its case below, and above, what the case holds, a whole number of at most 32 bits
` its own, an object or a box by its handle. Bits of no case it has give the union with nothing
` written.
. layout = layout-of(type, site)
. result = null-value(type, layout, site)
. tag = num-cast
    - site
    - bitwise(site, .bitwise-and, bits, integer(.machine-i64, 255), i64-layout)
    - i64-layout
    - u8-layout
. above = bitwise(site, .bitwise-shift-right, bits, integer(.machine-i64, 8), i64-layout)
. cases = types.cases-of(type)
. joined = ir.reserve-block()
for index in 0 .. < cases.length
    . case-type = cases[index].type
    . holding = ir.reserve-block()
    . next = ir.reserve-block()
    branch(compare(site, .compare-equal, tag, integer(.machine-u8, index as U64)), holding, next)
    ir.start-block(holding)
    . field = tables.layouts.case-field(layout, index as U32)
    . held = above
    if inline-style-case(case-type)
        held = num-cast(site, above, i64-layout, field.layout)
    else if intrinsic(case-type) == .class
        held = num-cast(site, object-pointer(site, above).operand, pointer-layout, managed-layout)
    else
        held = unbox-style(site, above, case-type).operand
    store(result.operand, 0, integer(.machine-u8, index as U64), false, site)
    put(result.operand, field, held, site)
    jump(joined)
    ir.start-block(next)
jump(joined)
ir.start-block(joined)
= Typed(result.operand, type)

────────────────────
_ do emit-style-write
    - id SyntaxId
    - object SyntaxId
    - rhs SyntaxId

` A write of the flag of a domain, as the reference writes it: the value, then the subject,
` `this` where none is written, cast to the runtime's `Pointer`, given with the domain's
` number and the value to the runtime's writer of the flag.
. flag = facts.style-flag-of(unit.reading, id)
if !flag || (object == 0 && !unit.has-self)
    refuse(.refused-statement, id)
    =
. value = emit-expression(rhs)
. subject = Typed(unit.self, if unit.reading != unit.instance then instances.rows[unit.reading].self-type else unit.owner-type)
if object != 0
    subject = emit-expression(object)
. pointer = style-subject(id, subject.operand, subject.type)
. mark = pending.length
pending += pointer
pending += integer(.machine-u64, tables.domain-number(flag.domain))
pending += value.operand
call-instance(flag.call, id, mark)

────────────────────
_ do emit-coalesce Typed
    - id SyntaxId
    - lhs SyntaxId
    - rhs SyntaxId

` The left value is kept unless it tests as empty, and then the right one is taken: a number
` is empty when it is zero, a C pointer when it points at nothing, and any other value when
` the function recorded as its test says so. The sides join as `close-joins` says, a struct in
` memory each copies its own into.
. nothing = make-operand(.operand-void, 0)
. type = facts.node-type(unit.reading, id)
. test = truth-call(id, true, false)
. left = emit-expression(lhs)
if types.is-optional(left.type)
    = emit-fallback(id, left, rhs, type)
if left.type == types.null-type
    . right = emit-expression(rhs)
    if right.type != type
        right = join(id, right)
    if right.type != type
        refuse(.refused-conversion, rhs)
    = right
. layout = layout-of(type, id)
. held = left.type
. held-layout = layout-of(held, id)
. counts = test == no-fact && is-number(layout) && (held == type || is-number(held-layout))
. points = test == no-fact && held != type && is-pointer(held-layout) && c-pointer
    .. c-pointer = intrinsic(held) == .cpointer
if !counts && !points && (test == no-fact || held != type)
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. take-right = ir.reserve-block()
. keep-left = ir.reserve-block()
. joined = ir.reserve-block()
. slot = join-slot(layout)
. sides = joins.length
if counts || points
    branch(truth(lhs, Typed(left.operand, held)).operand, keep-left, take-right)
else
    . callee = facts.calls[test].callee
    if callee == no-instance || instances.rows[callee].self-type != type
        refuse(.refused-expression, id)
        = Typed(nothing, no-type)
    . mark = pending.length
    pending += left.operand
    . is-empty = call-method(callee, id, mark)
    branch(is-empty.operand, take-right, keep-left)
ir.start-block(keep-left)
. kept = left
if held != type
    kept = join(id, Typed(left.operand, held))
    if kept.type != type
        refuse(.refused-conversion, lhs)
arrive(id, kept.operand, joined, slot)
ir.start-block(take-right)
. right = emit-expression(rhs)
if right.type != type
    right = join(id, right)
if right.type != type
    refuse(.refused-conversion, rhs)
arrive(id, right.operand, joined, slot)
= Typed(close-joins(joined, sides, layout, slot), right.type)

────────────────────
_ do emit-fallback Typed
    - id SyntaxId
    - left Typed
    - rhs SyntaxId
    - type TypeId

` `a ?? b` where `a` is an optional: what it holds when it holds a value, and otherwise `b`,
` which is evaluated only then. Where `b` may hold nothing too, `a` is kept as the optional
` it is. Each side arrives in the type of the whole, by the conversion recorded for a side.
. nothing = make-operand(.operand-void, 0)
. held = left.type
. layout = layout-of(type, id)
. tested = present(id, left)
. keep = ir.reserve-block()
. other = ir.reserve-block()
. joined = ir.reserve-block()
. slot = join-slot(layout)
. mark = joins.length
branch(tested.operand, keep, other)
ir.start-block(keep)
. kept = left
if held != type
    kept = payload(id, Typed(left.operand, held))
    if kept.type != type
        kept = join(id, kept)
if kept.type != type
    refuse(.refused-conversion, id)
arrive(id, kept.operand, joined, slot)
ir.start-block(other)
emit-arm(id, rhs, type, joined, slot)
= Typed(close-joins(joined, mark, layout, slot), type)

────────────────────
_ do emit-call-at Typed
    - id SyntaxId
    - callable SyntaxId
    - operands RowRange'SyntaxId
    - piped SyntaxId = 0

. pulled = facts.pulls(unit.reading, id)
=? emit-call(id, callable, operands, piped) if facts.plan-of(unit.reading, id) != .plan-live-call && !pulled
. live = instances.live
if live.enter == no-instance || live.leave == no-instance || live-actions.length == 0
    refuse(.refused-expression, id)
    = Typed(make-operand(.operand-void, 0), no-type)
. mark = pending.length
pending += load-local(live-actions[live-actions.length - 1].previous, id)
pending += load-local(live-actions[live-actions.length - 1].next, id)
do call-instance(live.enter, id, mark)
. opened = open-cleanups.length
. own-scoping = scoping
scoping = scoping.block-base = opened
open-cleanup(id, UseCell(no-local, no-local, no-type, true))
= close-value(emit-call(id, callable, operands, piped), opened, own-scoping, id)

────────────────────
_ do emit-call Typed
    - id SyntaxId
    - callable SyntaxId
    - operands RowRange'SyntaxId
    - piped SyntaxId = 0

` A call written with its arguments: of a C function, or the one call the type pass recorded
` at the node, of a function, a static, a constructor, or a method of the value written
` before its name. A value piped into the call is its last argument. A write to an event
` publishes to it.
if facts.plan-of(unit.reading, id) == .plan-built-bullets
    = emit-listed-bullets(id, tree.listed-bullets(id))
do match? tree.nodes[callable]
    | .node-c-identifier
        if piped == 0 && own-call(id) == no-fact && is-binding(facts.node-type(unit.reading, id))
            = emit-bind(id, callable, operands)
        if piped == 0
            = emit-c-call(id, operands)
if facts.event-uses.length != 0 && piped == 0
    . used = tables.event-use-of(unit.reading, id)
    if used && used.kind == .event-publish
        = emit-publish(id, used, operands)
    if used && used.kind == .event-route
        = emit-route(id, used, operands)
    if used && (used.kind == .event-rekey || used.kind == .event-release)
        = emit-readdress(id, used, operands)
. plan = facts.plan-of(unit.reading, id)
if plan == .plan-relation || plan == .plan-relation-cast
    do match? tree.nodes[callable]
        | .node-get-expression(get)
            if piped == 0
                = emit-relation(id, plan, get.object, operands)
    refuse(.refused-expression, id)
    = Typed(make-operand(.operand-void, 0), no-type)
if (plan == .plan-case || plan == .plan-case-fields) && piped == 0
    run-case-owner(callable)
    = emit-case(id, operands, plan == .plan-case-fields)
if plan == .plan-forward
    do match? tree.nodes[callable]
        | .node-get-expression(get)
            if piped == 0
                = emit-forward(id, get.object, operands)
    refuse(.refused-expression, id)
    = Typed(make-operand(.operand-void, 0), no-type)
if plan == .plan-table
    do match? tree.nodes[callable]
        | .node-get-expression(get)
            if piped == 0
                = emit-table-method(id, get.object, operands)
    refuse(.refused-expression, id)
    = Typed(make-operand(.operand-void, 0), no-type)
if plan == .plan-builder-append || plan == .plan-builder-reserve
    do match? tree.nodes[callable]
        | .node-get-expression(get)
            if piped == 0
                = emit-builder-method(id, get.object, operands, plan == .plan-builder-append)
        | .node-identifier
            if piped == 0
                = emit-builder-method(id, 0, operands, plan == .plan-builder-append)
    refuse(.refused-expression, id)
    = Typed(make-operand(.operand-void, 0), no-type)
. fact = own-call(id)
if fact != no-fact && facts.plan-of(unit.reading, id) == .plan-count-leading-zeros
    if piped == 0 && operands.count == 1
        = emit-leading-zeros(id, facts.calls[fact].callee, tree.children[operands.start])
. side = facts.plan-of(unit.reading, id)
if fact != no-fact && piped == 0 && is-float-math(side)
    = emit-float-math(id, facts.calls[fact], operands, side)
if fact != no-fact && piped == 0 && side-payload
    = emit-side-payload(id, facts.calls[fact].callee, operands, side)
.. side-payload = side == .plan-side-payload || side == .plan-publish-side-payload
if fact != no-fact && piped == 0 && side == .plan-object-from-pointer
    = emit-object-from-pointer(id, facts.calls[fact].callee, operands)
if fact != no-fact && piped == 0 && side == .plan-invoke-lowered
    = emit-invoke-lowered(id, facts.calls[fact].callee, operands)
if fact != no-fact && piped == 0 && side == .plan-witness-pointer
    = emit-witness-pointer(id, facts.calls[fact].callee, operands)
if fact != no-fact && piped == 0 && side == .plan-interface-from-pointer
    = emit-interface-from-pointer(id, facts.calls[fact].callee, operands)
if fact != no-fact && facts.plan-of(unit.reading, id) == .plan-store-untraced
    do match? tree.nodes[callable]
        | .node-get-expression(get)
            if piped == 0
                = emit-store-untraced(id, facts.calls[fact], get.object, operands)
    refuse(.refused-expression, id)
    = Typed(make-operand(.operand-void, 0), no-type)
if fact == no-fact && piped == 0 && facts.plan-of(unit.reading, id) == .plan-tuple
    = emit-tuple(id, operands)
if fact == no-fact && piped == 0 && is-binding(facts.node-type(unit.reading, id))
    = emit-bind(id, callable, operands)
if fact != no-fact && piped == 0 && partial-closure
    = emit-bind(id, callable, operands)
.. partial-closure = facts.calls[fact].is-partial && facts.calls[fact].form == .call-closure
if fact != no-fact && piped == 0 && is-binding(callee-type(callable))
    . row = facts.calls[fact]
    if row.form == .call-function && row.callee != no-instance && has-symbol
        = emit-c-call(id, operands, callable)
    .. has-symbol = tables.c-symbols[row.callee] != no-string
    if row.form == .call-function || row.form == .call-constructor || row.form == .call-method
        = emit-fact-call(id, row, 0, operands, 0, 0, no-type, callable)
    if row.form == .call-closure && row.callee == no-instance
        = emit-value-call(id, callable, operands)
    if row.form == .call-closure
        = emit-closure-call(id, row, callable, operands)
    refuse(.refused-expression, id)
    = Typed(make-operand(.operand-void, 0), no-type)
if fact != no-fact
    . row = facts.calls[fact]
    if row.form == .call-closure && piped == 0 && row.callee == no-instance
        = emit-value-call(id, callable, operands)
    if row.form == .call-closure && piped == 0
        = emit-closure-call(id, row, callable, operands)
    if row.form == .call-function || row.form == .call-static || row.form == .call-constructor
        = emit-fact-call(id, row, 0, operands, piped)
    if row.form == .call-this-constructor
        = emit-fact-call
            - id
            - row
            - if names-slot(callable, .slot-super) then callable else 0
            - operands
            - piped
    if row.form == .call-method && calls-value(row.callee)
        = emit-fact-call(id, row, callable, operands, piped)
    if row.form == .call-method
        do match? tree.nodes[callable]
            | .node-get-expression(get)
                = emit-fact-call(id, row, get.object, operands, piped)
. array = if fact == no-fact && piped == 0 then tables.const-array-row(unit.reading, id) else U32.max
if array != U32.max
    = Typed(make-operand(.operand-symbol, tables.const-array-symbol(array)), facts.const-arrays[array].type)
refuse(.refused-expression, id)
= Typed(make-operand(.operand-void, 0), no-type)

────────────────────
_ do calls-value Bool
    - callee InstanceId

` Whether an instance is of the function a type declares for a call of a value of it, whose
` receiver is what the call names.
if callee == no-instance
    = false
. row = instances.rows[callee]
do match? program.modules[row.module].decls[row.decl]
    | .decl-function(fn)
        = fn.name != null && fn.name == types.call-atom
= false

────────────────────
_ do emit-stream-pipe Typed
    - id SyntaxId
    - left SyntaxId

` A stream piped through a function over each of its items: the call the type pass
` recorded at the pipe, of the function of `core/stream` that maps, filters or taps a
` stream, given the stream on the left and the function generated for the right side as a
` value of the function type it takes.
` 1. The stream is evaluated, and converted as the type pass recorded where its facts are
`    kept: at the left side, or for a list of bullets at the bullet after the first, or at
`    the pipe where there is none, for a reason of its own apart from the pipe's value.
` 2. The function is the environment its body is given (`nested-environment`), converted as
`    recorded at the pipe.
` A stack trace through the function on the right is the one TypeScript prints with no
` inlining. The answer has the type the function called returns: the type pass keeps the
` type of a list of one bullet at the pipe that reads it.
. nothing = make-operand(.operand-void, 0)
. fact = own-call(id)
. site = left
do match? tree.nodes[left]
    | .node-bullet-expression(row)
        site = if row.next != 0 then row.next else id
. outside = unit.reading != unit.instance
if fact == no-fact || (holds-environment && shared-slot() == no-slot) || receiving
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
.. holds-environment = outside && tables.environments[unit.reading] != no-layout
.. receiving = filling.storing && !outside && shares-receiver()
. call = facts.calls[fact]
. callee = call.callee
if call.form != .call-function || callee == no-instance || call.is-partial || call.fills.count != 2
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. first = facts.call-fills[call.fills.start] as U32
. second = facts.call-fills[call.fills.start + 1] as U32
if first != 0 || second != 1 || tables.instance-functions[callee] == no-function
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. reason ConversionReason = if site == id then .reason-piped else .reason-argument
. source = convert-matched(site, reason, emit-expression(left), instances.argument-type(callee, 0))
if source.type != instances.argument-type(callee, 0)
    refuse(.refused-conversion, left)
    = Typed(nothing, no-type)
. function = Typed(nothing, no-type)
. wanted = instances.argument-type(callee, 1)
. shape = facts.first-conversion(unit.reading, id)
while shape != no-fact && function.type != wanted
    . row = facts.conversions[shape]
    if row.reason == .reason-argument && is-closure(row.from) && row.runs != no-instance
        if outside && instances.rows[row.runs].enclosing != unit.reading
            refuse(.refused-expression, id)
            = Typed(nothing, no-type)
        function = convert-one(id, row, Typed(nested-environment(id), row.from))
    shape = row.next
if function.type != wanted
    refuse(.refused-conversion, id)
    = Typed(nothing, no-type)
. mark = pending.length
pending += source.operand
pending += function.operand
= call-instance(callee, id, mark)

────────────────────
_ do emit-write-all Typed
    - id SyntaxId
    - left SyntaxId
    - right SyntaxId

` A value written whole to what is on the right of the pipe: the one call the type pass
` recorded at the pipe, of the function the type on the right declares for a write, given
` the value. The value is evaluated first, as it is written first, and the pipe gives what
` it wrote to.
. nothing = make-operand(.operand-void, 0)
. fact = facts.first-call(unit.reading, id)
if fact == no-fact || facts.calls[fact].next != no-fact || facts.calls[fact].is-swapped
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. made = emit-expression(left)
. value = apart(made, left, !is-inert(right))
. given = made.type
. sink = emit-expression(right)
. sink-type = sink.type
call-operator(id, fact, right, sink.operand, sink-type, left, value, given)
= Typed(sink.operand, sink-type)

────────────────────
_ do writes-each Bool
    - pipe SyntaxId

` Whether a pipe's loop, which writes each item it reads, is being emitted.
for write in writes
    if write.pipe == pipe
        = true
= false

────────────────────
_ do emit-write-each Typed
    - id SyntaxId
    - left SyntaxId
    - right SyntaxId

` Each item of what the pipe reads written to what is on the right, as the reference lowers
` it: what is on the right is evaluated first and kept, and the loop the type pass planned
` at the pipe reads the left, each turn giving the item to the write recorded at the pipe
` after the calls of the loop's protocol. A range of integers written there is counted
` through. The pipe gives what it wrote to.
. nothing = make-operand(.operand-void, 0)
. fact = facts.first-call(unit.reading, id)
while fact != no-fact && facts.calls[fact].next != no-fact
    fact = facts.calls[fact].next
if fact == no-fact || facts.calls[fact].is-swapped
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. sink = emit-expression(right)
. sink-type = sink.type
. layout = layout-of(sink-type, id)
. kept = ir.add-local(layout)
store-local(kept, sink.operand, id)
writes += WriteEach(id, fact, left, right, kept, sink-type)
. plan = facts.plan-of(unit.reading, id)
. counted = false
do match? tree.nodes[left]
    | .node-range-expression(range)
        if plan == .plan-range-loop && range.left != 0 && range.right != 0
            emit-range-loop(id, range.op, range.left, range.right, 0, 0)
            counted = true
if !counted && (plan == .plan-index-loop || plan == .plan-cursor-loop || plan == .plan-stream-loop)
    emit-headed(id, left, 0, 0)
else if !counted
    refuse(.refused-expression, id)
writes.pop()
. written = load-local(kept, id)
= Typed(written, sink-type)

────────────────────
_ pipes-stream Bool
    - op Operator

` Whether a pipe gives each item of a stream to the function written on its right.
op == .map-op || op == .filter-op || op == .map-filter-op || op == .pipe-repeat-op

────────────────────
_ do emit-piped Typed
    - id SyntaxId
    - left SyntaxId

` A value given whole to the function generated for the right side of the pipe, which reads
` it as `it`: a call of that function, given the value.
. answer = call-generated(id, left)
if answer.type != facts.node-type(unit.reading, id)
    refuse(.refused-conversion, id)
= answer

────────────────────
_ do convert-matched Typed
    - site SyntaxId
    - reason ConversionReason
    - value Typed
    - wanted TypeId

` Applies the conversions recorded at a site for one reason that take a value of the type
` this one has, in order, until it has the type wanted. A site that keeps the conversions
` of several values is read so.
. result = value
. fact = facts.first-conversion(unit.reading, site)
while fact != no-fact && result.type != wanted
    . row = facts.conversions[fact]
    . fits = row.reason == reason || literal-return
        .. literal-return = reason == .reason-return && row.reason == .reason-literal-return
    if fits && row.from == result.type
        result = convert-one(site, row, result)
    fact = row.next
= result

────────────────────
_ do emit-relation Typed
    - id SyntaxId
    - plan OperatorPlan
    - object SyntaxId
    - operands RowRange'SyntaxId

` A call the compiler answers itself, of the relation of two types:
` - `compare` of a type with another gives the relation. It is held as the text the type
`   pass recorded for it, which is all that can be asked of one when the program runs. The
`   two types are run first, as a type read for a constant is.
` - `cast` and `unify` of a relation give their argument, converted as the type pass
`   recorded at it. The relation is run first, for what its types do. A panic the
`   conversion raises is raised at the call.
. nothing = make-operand(.operand-void, 0)
. type = facts.node-type(unit.reading, id)
if plan == .plan-relation
    . constant = facts.constant-of(unit.reading, id)
    if constant == no-fact || !facts.constants[constant].text
        refuse(.refused-expression, id)
        = Typed(nothing, no-type)
    run-type-operand(object)
    for operand in tree.children[operands]
        run-type-operand(argument-value(operand))
    = Typed(make-operand(.operand-constant, ir.add-string(facts.constants[constant].text!.text)), type)
if operands.count != 1 || facts.plan-of(unit.reading, object) != .plan-relation
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
emit-expression(object)
. given = tree.children[operands.start]
. raw = convert(given, .reason-argument, emit-expression(argument-value(given)))
. value = convert(given, .reason-relation, raw, id)
if value.type != type
    refuse(.refused-conversion, id)
= value

────────────────────
_ do emit-store-untraced Typed
    - id SyntaxId
    - fact CallFact
    - object SyntaxId
    - operands RowRange'SyntaxId

` A call the compiler answers itself: an item stored past a pointer into memory the
` collector does not own, with no check. The pointer is evaluated, then the item, then the
` index, and each takes the conversion recorded for it. An item that holds an object or a
` function, which the type pass says an arena traces, is stored through the write barrier.
. nothing = make-operand(.operand-void, 0)
. callee = fact.callee
. constant = facts.constant-of(unit.reading, id)
if callee == no-instance || constant == no-fact || out-of-order || operands.count != 2
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
.. out-of-order = !fills-in-order(fact, callee, 2)
. traced = facts.constants[constant].bits != 0
. written = tree.children[operands]
. first = argument-value(written[0])
. second = argument-value(written[1])
. pointer = convert(object, .reason-receiver, emit-expression(object))
. pointer-type = pointer.type
. emitted = emit-expression(first)
. item = apart(emitted, first, !is-inert(second))
. given = emitted.type
. index = convert(written[1], .reason-argument, emit-expression(second))
. index-type = index.type
. converted = convert(written[0], .reason-argument, Typed(item, given))
item = converted.operand
. item-type = tables.layouts.pointee-type(pointer-type)
if pointer-type != instances.rows[callee].self-type || converted.type != item-type
    refuse(.refused-conversion, id)
    = Typed(nothing, no-type)
if converted.type != instances.argument-type(callee, 0) || index-differs
    refuse(.refused-conversion, id)
    = Typed(nothing, no-type)
.. index-differs = index-type != instances.argument-type(callee, 1)
. layout = layout-of(item-type, id)
. counted = layout-of(index-type, id)
. held = layout-of(pointer-type, id)
if !is-pointer(held) || !is-integer(counted) || layout == void-layout
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. step = integer(.machine-u64, tables.layouts.rows[layout].size)
. distance = arithmetic
    - id
    - .arithmetic-multiply
    - num-cast(id, index.operand, counted, u64-layout)
    - step
    - u64-layout
. moved = arithmetic
    - id
    - .arithmetic-add
    - num-cast(id, pointer.operand, held, u64-layout)
    - distance
    - u64-layout
. place = num-cast(id, moved, u64-layout, held)
if tables.layouts.is-struct(layout)
    copy
        - address(place, 0, layout, id)
        - item
        - layout
        - traced && tables.layouts.rows[layout].is-managed
        - id
else
    store(place, 0, item, traced && is-managed-pointer(layout), id)
= Typed(nothing, types.void-type)

────────────────────
_ argument-value SyntaxId
    - argument SyntaxId

` The expression of an argument written: what follows its name, when it has one.
match tree.nodes[argument]
    | .node-argument(named)
        named.expr
    ??
        argument

────────────────────
_ is-named Bool
    - argument SyntaxId

` Whether an argument is written with the name of the parameter it is for.
match tree.nodes[argument]
    | .node-argument(named)
        named.name != null
    ??
        false

────────────────────
_ do emit-side-payload Typed
    - id SyntaxId
    - callee InstanceId
    - operands RowRange'SyntaxId
    - plan OperatorPlan

` A call the compiler answers itself through the collector: the payload an object holds in a
` lane, an object of the payload's class or nothing where the lane holds none, or a payload
` published in the lane, which answers the payload the lane then holds. The allocation buffer
` is published first. Each argument takes the conversion recorded for it. An optional that
` holds its flag apart holds a value where the address the collector gives is not null. The
` collector's function is called as TypeScript calls it, with no poll around it and no panic
` read after it.
. nothing = make-operand(.operand-void, 0)
. count U32 = if plan == .plan-side-payload then 2 else 3
if callee == no-instance || operands.count != count || other-arity
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
.. other-arity = instances.signatures[callee].args.count != count
. mark = pending.length
for position in 0 .. < count
    . argument = tree.children[operands.start + position]
    . expression = argument
    do match? tree.nodes[argument]
        | .node-argument(named)
            expression = named.expr
    . value = convert(argument, .reason-argument, emit-expression(expression))
    if value.type != instances.argument-type(callee, position)
        refuse(.refused-conversion, argument)
    pending += value.operand
. type = facts.node-type(unit.reading, id)
. layout = layout-of(type, id)
if plan == .plan-publish-side-payload
    . published = call-runtime(.runtime-publish-side-payload, id, mark, layout)
    = Typed(published, type)
. raw = call-runtime(.runtime-object-side-payload, id, mark, managed-layout)
if !tables.layouts.is-struct(layout)
    = Typed(raw, type)
. held = frame(layout)
put(held, tables.layouts.field(layout, 0), raw, id)
. address = num-cast(id, raw, managed-layout, u64-layout)
put
    - held
    - tables.layouts.field(layout, 1)
    - compare(id, .compare-not-equal, address, integer(.machine-u64, 0))
    - id
= Typed(held, type)

────────────────────
_ do emit-invoke-lowered Typed
    - id SyntaxId
    - callee InstanceId
    - operands RowRange'SyntaxId

` A call the compiler answers itself: the function at the address the first argument holds,
` called with the other two, the address of an object and a payload, and checked for a panic
` as a call of a function's value is.
. nothing = make-operand(.operand-void, 0)
if callee == no-instance || operands.count != 3 || instances.signatures[callee].args.count != 3
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. given [Operand]
for position in 0 .. < 3
    . argument = tree.children[operands.start + position]
    . converted = convert(argument, .reason-argument, emit-expression(argument-value(argument)))
    given += converted.operand
    if converted.type != instances.argument-type(callee, position as U32)
        refuse(.refused-conversion, argument)
. mark = pending.length
pending += given[1]
pending += given[2]
do call(given[0], id, mark, .callee-value, void-layout, !in-landing)
= Typed(nothing, types.void-type)

────────────────────
_ do intrinsic-arguments Bool
    - id SyntaxId
    - callee InstanceId
    - operands RowRange'SyntaxId

` Evaluates the arguments of a call the compiler answers itself onto the pending arguments,
` each with the conversion recorded for it and of the type its parameter takes. False where
` one is refused.
if callee == no-instance || operands.count != instances.signatures[callee].args.count
    refuse(.refused-expression, id)
    = false
for position in 0 .. < operands.count
    . argument = tree.children[operands.start + position]
    . expression = argument
    do match? tree.nodes[argument]
        | .node-argument(named)
            expression = named.expr
    . value = convert(argument, .reason-argument, emit-expression(expression))
    if value.type != instances.argument-type(callee, position)
        refuse(.refused-conversion, argument)
    pending += value.operand
= true

────────────────────
_ do emit-witness-pointer Typed
    - id SyntaxId
    - callee InstanceId
    - operands RowRange'SyntaxId

` A call the compiler answers itself: the address of the witness table a value of an
` interface holds.
. mark = pending.length
if !intrinsic-arguments(id, callee, operands)
    drop-pending(mark)
    = Typed(make-operand(.operand-void, 0), facts.node-type(unit.reading, id))
. value = pending[mark]
drop-pending(mark)
. second = tables.layouts.field(tables.layouts.interface-layout, 1).offset
= Typed(load(value, second, pointer-layout, id), facts.node-type(unit.reading, id))

────────────────────
_ do emit-interface-from-pointer Typed
    - id SyntaxId
    - callee InstanceId
    - operands RowRange'SyntaxId

` A call the compiler answers itself: a value of an interface that holds the object at one
` address and the witness table at the other, the two as the caller vouches they belong.
. mark = pending.length
if !intrinsic-arguments(id, callee, operands)
    drop-pending(mark)
    = Typed(make-operand(.operand-void, 0), facts.node-type(unit.reading, id))
. object = pending[mark]
. table = pending[mark + 1]
drop-pending(mark)
. type = facts.node-type(unit.reading, id)
. layout = layout-of(type, id)
if layout != tables.layouts.interface-layout
    refuse(.refused-conversion, id)
    = Typed(make-operand(.operand-void, 0), no-type)
. made = frame(layout)
store(made, 0, object, false, id)
store(made, tables.layouts.field(layout, 1).offset, table, false, id)
= Typed(made, type)

────────────────────
_ do emit-object-from-pointer Typed
    - id SyntaxId
    - callee InstanceId
    - operands RowRange'SyntaxId

` A call the compiler answers itself: the object of a class at the address a pointer holds,
` its bits as they are. The argument takes the conversion recorded for it.
. nothing = make-operand(.operand-void, 0)
if callee == no-instance || operands.count != 1 || instances.signatures[callee].args.count != 1
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. argument = tree.children[operands.start]
. expression = argument
do match? tree.nodes[argument]
    | .node-argument(named)
        expression = named.expr
. value = convert(argument, .reason-argument, emit-expression(expression))
if value.type != instances.argument-type(callee, 0)
    refuse(.refused-conversion, argument)
. type = facts.node-type(unit.reading, id)
. source = layout-of(value.type, id)
. layout = layout-of(type, id)
if !is-pointer(source) || !is-pointer(layout)
    refuse(.refused-conversion, id)
    = Typed(nothing, no-type)
= Typed(num-cast(id, value.operand, source, layout), type)

────────────────────
_ do emit-leading-zeros Typed
    - id SyntaxId
    - callee InstanceId
    - argument SyntaxId

` A call the compiler answers itself: how many of an integer's highest bits are zero. The
` argument takes the conversion recorded for it, and the count has the node's type.
. nothing = make-operand(.operand-void, 0)
. expression = argument
do match? tree.nodes[argument]
    | .node-argument(named)
        expression = named.expr
. value = convert(argument, .reason-argument, emit-expression(expression))
if callee == no-instance || value.type != instances.argument-type(callee, 0)
    refuse(.refused-conversion, argument)
    = Typed(nothing, no-type)
. given = layout-of(value.type, argument)
. type = facts.node-type(unit.reading, id)
. layout = layout-of(type, id)
if !is-integer(given) || !is-integer(layout) || tables.layouts.rows[layout].size < 4
    refuse(.refused-type, id)
    = Typed(nothing, no-type)
. bits = types.completions[value.type].bit-size
. start U32 = ir.operands.length
ir.add-operand(value.operand)
= Typed(make-operand(.operand-value, append(.op-count-leading-zeros, id, Span(start, 1), bits, layout)), type)

────────────────────
_ is-float-math Bool
    - plan OperatorPlan

plan == .plan-f64-sqrt || plan == .plan-f64-abs || plan == .plan-f64-min || plan == .plan-f64-max

────────────────────
_ do emit-float-math Typed
    - id SyntaxId
    - call CallFact
    - operands RowRange'SyntaxId
    - plan OperatorPlan

` A call the compiler answers itself: the square root or absolute value of a float, or the
` lesser or greater of two. Each argument is written in its parameter's place and takes the
` conversion recorded for it.
. nothing = make-operand(.operand-void, 0)
. callee = call.callee
if callee == no-instance || call.is-partial || call.fills.count != operands.count
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
if instances.signatures[callee].args.count != operands.count
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
for position in 0 .. < call.fills.count
    if facts.call-fills[call.fills.start + position] as U32 != position
        refuse(.refused-expression, id)
        = Typed(nothing, no-type)
. mark = pending.length
for position in 0 .. < operands.count
    . argument = tree.children[operands.start + position]
    . expression = argument
    do match? tree.nodes[argument]
        | .node-argument(named)
            expression = named.expr
    . value = convert(argument, .reason-argument, emit-expression(expression))
    if value.type != instances.argument-type(callee, position)
        refuse(.refused-conversion, argument)
    pending += value.operand
. type = facts.node-type(unit.reading, id)
. layout = layout-of(type, id)
if layout != f64-layout
    refuse(.refused-type, id)
. start U32 = ir.operands.length
for position in mark .. < pending.length
    ir.add-operand(pending[position])
drop-pending(mark)
. count U32 = ir.operands.length - start
. op = FloatMath.float-sqrt
if plan == .plan-f64-abs
    op = .float-abs
else if plan == .plan-f64-min
    op = .float-min
else if plan == .plan-f64-max
    op = .float-max
= Typed(make-operand(.operand-value, append(.op-float-math, id, Span(start, count), op, layout)), type)

────────────────────
_ do emit-pipe Typed
    - id SyntaxId
    - op Operator
    - left SyntaxId
    - right SyntaxId

` A value piped forward into the function written on the right, as the last argument of the
` call the type pass recorded at the pipe; a stream piped through the function written on
` the right, which maps, filters or taps its items, or through a pattern, as a comprehension
` is called, given what is piped as the type pass cast it, but for a bullet that function
` evaluates; a value given whole to the function
` generated for the right side; or a value written whole, or each of its items, to what is
` on the right. Any other pipe has no shape yet. A list of bullets piped
` forward has what converts it kept at the bullet after the first, beside what converts
` the yields of bullets, and a list of one bullet at the pipe, apart from what converts the
` pipe's value.
if pipes-stream(op)
    = emit-stream-pipe(id, left)
if op == .stream-pattern-pipe-op
    = emit-comprehension-call(id, if tree.piped-bullet(id) == 0 then left else 0, true)
if op == .pipe-closure-op
    = emit-piped(id, left)
if op == .pipe-write-all-op
    = emit-write-all(id, left, right)
if op == .pipe-write-each-op
    = emit-write-each(id, left, right)
if op != .pipe-forward-op
    refuse(.refused-expression, id)
    = Typed(make-operand(.operand-void, 0), no-type)
=? emit-listed-bullets(id, tree.listed-bullets(id)) if facts.plan-of(unit.reading, id) == .plan-built-bullets
do match? tree.nodes[left]
    | .node-bullet-expression(row)
        piped-site = if row.next != 0 then row.next else id
    | .node-pipeline-expression(row)
        if pipes-stream(row.op)
            piped-site = left
    | .node-binary-expression(row)
        if pipes-stream(row.op)
            piped-site = left
. answer = Typed(make-operand(.operand-void, 0), no-type)
do match tree.nodes[right]
    | .node-call-expression(call)
        answer = emit-call-at(id, call.callable, call.args, left)
    ??
        answer = emit-call-at(id, right, RowRange'SyntaxId(), left)
piped-site = 0
= answer

────────────────────
_ do emit-get Typed
    - id SyntaxId
    - object SyntaxId
    - name Atom

` A name read from a value: a constant the type pass worked out, the address a pointer
` holds, a stored field the type pass named by its place, what the getter it recorded at the
` node answers, a field of a tuple or struct, or a stored property of an object. A union
` answers some names by itself, and others with the member each of its cases has. A field
` of the case of a row a name stands for is read from its cell, and a field of numbers of an
` item of an array an index reads as TypeScript reads one, which has no shape in a link of an
` optional chain. An event named on a value is made a `Broadcastable`. The flag of a domain a
` `MarkupBatchFlush` reports is its bit of the domains the flush left pending. `path` of a
` value of a state machine's union lists its active cases (`emit-machine-path`), and `unit` of
` a number is the name its type is written with, read after the number is.
if facts.plan-of(unit.reading, id) == .plan-machine-path
    = emit-machine-path(id, object)
. escaped = escaped-event(id)
if escaped
    = emit-escape(id, escaped)
. flag = facts.style-flag-of(unit.reading, id)
if flag && flag.call == no-instance
    = flush-flag(id, object, tables.domain-number(flag.domain))
if object != 0 && case-cursor-of(object) != U32.max
    . cursor = case-cursor-of(object)
    . field = case-field(cursor, name)
    if field
        = emit-case-field(id, cursor, field)
if plans-array-item && types.intrinsic-of(facts.node-type(unit.reading, object)) == .struct
    if is-link(id)
        refuse(.refused-expression, id)
        = Typed(make-operand(.operand-void, 0), no-type)
    do match? tree.nodes[object]
        | .node-index-expression(row)
            = emit-array-item(object, row.object, row.index, id, name)
.. plans-array-item = object != 0 && facts.plan-of(unit.reading, object) == .plan-array-item
. planned = facts.plan-of(unit.reading, id)
if planned == .plan-view
    = emit-view-get(id, object)
if planned == .plan-table && table-op(id) == TableOp.table-field
    = emit-table-field(id, object)
if planned == .plan-table
    . held = emit-expression(object)
    . type = held.type
    = table-get(id, held.operand, type)
if planned == .plan-none && is-binding(facts.node-type(unit.reading, id))
    = name-binding(id, facts.node-type(unit.reading, id), object)
if planned == .plan-case-number
    = emit-case-number(id, object)
if planned == .plan-case-name || planned == .plan-case-type
    = emit-case-text(id, object, planned)
if planned == .plan-case-value
    = emit-case-value(id, object)
if planned == .plan-forward
    = emit-forward(id, object, RowRange'SyntaxId(), name)
if planned == .plan-unit-name
    . held = emit-expression(object)
    = Typed(unit-text(held.type), facts.node-type(unit.reading, id))
if planned == .plan-object-uid || planned == .plan-property-subscribers
    = emit-object-member(id, object, planned)
if facts.plan-of(unit.reading, id) == .plan-constant
    run-type-operand(object)
    = Typed(emit-constant(id), facts.node-type(unit.reading, id))
if facts.plan-of(unit.reading, id) == .plan-case
    run-type-operand(object)
    = emit-case(id, RowRange'SyntaxId(), false)
if facts.plan-of(unit.reading, id) == .plan-enum-value
    run-type-operand(object)
    = read-enum(id)
if facts.plan-of(unit.reading, id) == .plan-address
    . pointer = emit-expression(object)
    = cast(id, pointer, unlinked(id))
if facts.plan-of(unit.reading, id) == .plan-reinterpret
    = reinterpret(id, emit-expression(object), unlinked(id))
if facts.plan-of(unit.reading, id) == .plan-field
    . held = emit-object(object)
    = placed-field(id, held.operand, held.type, facts.constant-of(unit.reading, id))
if planned == .plan-through
    . whole = emit-expression(object)
    . held = read-through(id, Typed(whole.operand, held-type(object)), facts.through-of(unit.reading, id))
    = load-property(id, held.operand, held.type, name)
. fact = own-call(id)
if fact != no-fact && facts.calls[fact].form == .call-getter
    = emit-fact-call(id, facts.calls[fact], object, RowRange'SyntaxId())
. owner = held-type(object)
if owner != no-type && owner != invalid-type && intrinsic(owner) == .type-info
    = emit-type-get(id, object)
if owner != no-type && owner != invalid-type && property-owner
    . base = emit-object(object)
    = load-property(id, base.operand, owner, name)
.. property-owner = is-aggregate(owner) || tables.is-class(owner) || types.is-optional(owner)
refuse(.refused-expression, id)
= Typed(make-operand(.operand-void, 0), no-type)

────────────────────
_ do emit-object Typed
    - object SyntaxId

` The value a name is read from at once, before anything else is evaluated: a struct an index
` names past a pointer is read from where it lies, not copied.
. own-matching = matching
matching = matching.read-in-place = object
. value = emit-expression(object)
matching = own-matching
= value

────────────────────
_ do flush-flag Typed
    - id SyntaxId
    - object SyntaxId
    - domain U32

. held = emit-expression(object)
. owner = held.type
. mask = load-property(id, held.operand, owner, program.store-atom("pending-domain-mask"), true)
. layout = layout-of(mask.type, id)
. bit = bitwise(id, .bitwise-and, mask.operand, integer(.machine-u32, 1u64 /lshift/ domain), layout)
. set = compare-zero(id, Typed(bit, types.type-row(.uint32)), .compare-not-equal)
= Typed(set.operand, types.bool-type)

────────────────────
_ do emit-object-member Typed
    - id SyntaxId
    - object SyntaxId
    - plan OperatorPlan

` A member every object has: the `uid` its header holds, or the list of the subscribers of its
` properties, made and published in lane 0 where it has none yet.
. held = emit-expression(object)
. owner = held.type
if plan == .plan-property-subscribers
    if instances.live.subscribers == no-instance
        refuse(.refused-expression, id)
        = held
    = side-list(id, held.operand, 0, instances.live.subscribers)
if !tables.is-class(owner) || tables.layouts.objects[owner] == no-layout
    refuse(.refused-expression, id)
    = held
= Typed(load(held.operand, tables.layouts.field(tables.layouts.objects[owner], 1).offset, u32-layout, id), facts.node-type(unit.reading, id))

────────────────────
_ do emit-type-get Typed
    - id SyntaxId
    - object SyntaxId

` What a type given as a value answers that the type pass worked out no constant for, as it
` planned the node: the name or the key of the class an object was constructed as, read from
` the value, the base of the type, which is the base of the type the value is held as, the
` size of the type, which is the bytes its layout holds a value in, the name or the key of
` the type the value is held as, or the name inlining knows of the type of a value of an
` interface, which the inliner settles from the type's descriptor and the interface's name.
. nothing = make-operand(.operand-void, 0)
. plan = facts.plan-of(unit.reading, id)
if plan == .plan-type-base
    run-type-operand(object)
    = type-value(id, facts.node-type(unit.reading, id))
if plan == .plan-type-name || plan == .plan-type-key
    run-type-operand(object)
    = type-text(id, named-type(facts.node-type(unit.reading, object)), plan)
if plan == .plan-type-size
    run-type-operand(object)
    . counted = facts.node-type(unit.reading, id)
    . held = layout-of(named-type(facts.node-type(unit.reading, object)), id)
    . counts = layout-of(counted, id)
    if !is-integer(counts)
        refuse(.refused-expression, id)
        = Typed(nothing, no-type)
    = Typed(integer(tables.layouts.kind-of(counts), tables.layouts.rows[held].size), counted)
if plan == .plan-inlined-name
    . descriptor = emit-expression(object)
    . fallback = type-text(id, named-type(facts.node-type(unit.reading, object)), .plan-type-name)
    . start U32 = ir.operands.length
    ir.add-operand(descriptor.operand)
    ir.add-operand(fallback.operand)
    = Typed(make-operand(.operand-value, append(.op-inlined-name, id, Span(start, 2), 0, managed-layout)), fallback.type)
if plan == .plan-type-properties
    = type-properties(id, object)
if plan != .plan-concrete-name && plan != .plan-concrete-key
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. subject = emit-expression(object)
= Typed(load(subject.operand, if plan == .plan-concrete-name then 0 else table-slot-size, managed-layout, id), types.string-type)

────────────────────
_ do type-properties Typed
    - id SyntaxId
    - object SyntaxId

. nothing = make-operand(.operand-void, 0)
. listed = facts.node-type(unit.reading, id)
. layout = layout-of(listed, id)
if !tables.layouts.is-struct(layout) || tables.layouts.rows[layout].fields.count != 1
    refuse(.refused-type, id)
    = Typed(nothing, no-type)
. subject = emit-expression(object)
. field = tables.layouts.field(layout, 0)
. table = load(subject.operand, 2 * table-slot-size, field.layout, id)
. memory = frame(layout)
put(memory, field, table, id)
= Typed(memory, listed)

────────────────────
_ do type-value Typed
    - id SyntaxId
    - info TypeId

` A type as a value: the address of the constant that holds the type's name and its key.
` `info` is the type the type pass gave the node, which says what type the value is.
. named = named-type(info)
. symbol = if named != no-type && named != invalid-type then rtti-symbol else no-string
    .. rtti-symbol = tables.rtti-symbols[named]
if symbol == no-string
    refuse(.refused-expression, id)
    = Typed(make-operand(.operand-void, 0), no-type)
type-values += named
= Typed(make-operand(.operand-symbol, symbol), info)

────────────────────
_ do type-text Typed
    - id SyntaxId
    - named TypeId
    - plan OperatorPlan

` The name or the key of a type, as the text the constant of the type holds.
if named == no-type || named == invalid-type
    refuse(.refused-expression, id)
    = Typed(make-operand(.operand-void, 0), no-type)
. text = if plan == .plan-type-name then type-runtime-name(types, named) else runtime-key
    .. runtime-key = type-runtime-key(types, named)
= Typed(make-operand(.operand-constant, ir.add-string(text)), types.string-type)

────────────────────
_ do named-type TypeId
    - info TypeId

` The type that a type given as a value is, which the type of the value says.
if info != no-type && info != invalid-type && intrinsic(info) == .type-info
    do match? types.rows[info]
        | .type-class(row)
            if row.args.count == 1
                = types.child-type(row.args, 0)
= no-type

────────────────────
_ do emit-index Typed
    - id SyntaxId
    - object SyntaxId

` A field read by a constant index, which the type pass recorded.
. nothing = make-operand(.operand-void, 0)
. place = indexed-field(id)
if place == no-fact
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. base = emit-expression(object)
= placed-field(id, base.operand, base.type, place)

────────────────────
_ do emit-index-call Typed
    - id SyntaxId
    - fact CallFact
    - object SyntaxId
    - index SyntaxId

` An index that a function answers. A type indexed makes what its constructor makes of the
` key. Any other object is the receiver of the function: it is evaluated before the key, and
` a struct that lies in storage is read where the function is called, as the receiver of any
` call is, so it is what evaluating the key left there. Each takes the conversion recorded
` for it. A function that raises answers its value or an error, which leaves the function
` with the call where the type pass says so, as any call's does.
. nothing = make-operand(.operand-void, 0)
if fact.form == .call-constructor || fact.form == .call-this-constructor
    = emit-fact-call(id, fact, 0, RowRange'SyntaxId(), 0, index)
. callee = fact.callee
if callee == no-instance || fact.is-partial || !is-callable(callee)
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
if !fills-in-order(fact, callee, 1) || names-slot(object, .slot-super)
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. receiver = convert(object, .reason-receiver, emit-expression(object))
. receiver-type = receiver.type
. key = convert(index, .reason-argument, emit-expression(index))
if receiver-type != instances.rows[callee].self-type
    refuse(.refused-conversion, object)
    = Typed(nothing, no-type)
if key.type != instances.argument-type(callee, 0)
    refuse(.refused-conversion, index)
    = Typed(nothing, no-type)
. raising = instances.signatures[callee].errors.count != 0
. key-layout = layout-of(key.type, index)
if receiver-type == types.string-type && is-integer(key-layout) && handles-errors
    = emit-string-index(id, fact, callee, receiver.operand, key.operand, key-layout)
.. handles-errors = !raising || fact.propagates
= index-call(id, fact, callee, receiver.operand, key.operand)

────────────────────
_ do index-call Typed
    - id SyntaxId
    - fact CallFact
    - callee InstanceId
    - receiver Operand
    - key Operand

. mark = pending.length
pending += receiver
pending += key
. raising = instances.signatures[callee].errors.count != 0
takes-result = raising
. answer = call-method(callee, id, mark)
takes-result = false
if raising && fact.propagates
    answer = propagate(id, callee, answer.operand)
if !gives(id, answer.type)
    refuse(.refused-conversion, id)
= answer

────────────────────
_ do emit-string-index Typed
    - id SyntaxId
    - fact CallFact
    - callee InstanceId
    - receiver Operand
    - key Operand
    - key-layout LayoutId

` A character of a string read by an integer index, as TypeScript reads one: an ASCII string's
` byte where the index is inside it, and what the function gives anywhere else.
. returned = instances.signatures[callee].returns
. layout = layout-of(returned, id)
if !is-integer(layout)
    = index-call(id, fact, callee, receiver, key)
. held = ir.add-local(layout)
. address = num-cast(id, receiver, managed-layout, u64-layout)
. packed = load
    - arithmetic(id, .arithmetic-subtract, address, integer(.machine-u64, 8), u64-layout)
    - 0
    - u64-layout
    - id
. ascii = bitwise(id, .bitwise-and, packed, integer(.machine-u64, 0x100000000), u64-layout)
. count = bitwise(id, .bitwise-and, packed, integer(.machine-u64, 0xffffffff), u64-layout)
. extended = if tables.layouts.rows[key-layout].size == 8 then key else num-cast(id, key, key-layout, if is-signed(key-layout) then i64-layout else u64-layout)
. wide = if is-signed(key-layout) then num-cast(id, extended, i64-layout, u64-layout) else extended
. checking = ir.reserve-block()
. fast = ir.reserve-block()
. slow = ir.reserve-block()
. joined = ir.reserve-block()
branch(ascii, checking, slow)
ir.start-block(checking)
branch(compare(id, .compare-less, wide, count), fast, slow)
ir.start-block(fast)
. byte = load(arithmetic(id, .arithmetic-add, address, wide, u64-layout), 0, u8-layout, id)
store-local(held, num-cast(id, byte, u8-layout, layout), id)
jump(joined)
ir.start-block(slow)
store-local(held, index-call(id, fact, callee, receiver, key).operand, id)
jump(joined)
ir.start-block(joined)
= Typed(load-local(held, id), returned)

────────────────────
_ do emit-array-item Typed
    - id SyntaxId
    - object SyntaxId
    - index SyntaxId
    - reader SyntaxId = 0
    - name Atom? = null

` An item of an array of numbers read by an index, or the field `name` of numbers that the node
` `reader` reads of an item of an array of structs, as TypeScript reads one: where the index is
` less than the array's size, from where the array's storage holds the item, and anywhere else
` from what the function recorded at the index gives, which answers for an index the array
` does not hold. The array is evaluated before the index, and each takes the conversion
` recorded for it.
. nothing = make-operand(.operand-void, 0)
. fact = own-call(id)
if fact == no-fact || (reader != 0 && !name)
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. receiver = convert(object, .reason-receiver, emit-expression(object))
. receiver-type = receiver.type
. key = convert(index, .reason-argument, emit-expression(index))
. key-type = key.type
= array-item(id, facts.calls[fact].callee, receiver.operand, receiver-type, key.operand, key-type, reader, name)

────────────────────
_ do array-item Typed
    - id SyntaxId
    - callee InstanceId
    - receiver Operand
    - receiver-type TypeId
    - key Operand
    - key-type TypeId
    - reader SyntaxId = 0
    - name Atom? = null

` An item of an array an index reads as TypeScript reads it, once the array and the index are
` evaluated: from the array's storage where the index is less than its size, and anywhere else
` from what `callee` answers for them.
. nothing = make-operand(.operand-void, 0)
if receiver-type != instances.rows[callee].self-type || key-differs
    refuse(.refused-conversion, id)
    = Typed(nothing, no-type)
.. key-differs = key-type != instances.argument-type(callee, 0)
. item = instances.signatures[callee].returns
. layout = layout-of(receiver-type, id)
. key-layout = layout-of(key-type, id)
. item-layout = layout-of(item, id)
. data = part(receiver, layout, 0, id)
. data-layout = layout-of(data.type, id)
. proven = facts.constant-of(unit.reading, id) != no-fact
. size = if proven then Typed(integer(.machine-u64, 0), types.size-type) else part(receiver, layout, 1, id)
. size-layout = if proven then u64-layout else layout-of(size.type, id)
. structured = tables.layouts.is-struct(item-layout)
if !is-pointer(data-layout) || !is-integer(size-layout) || !is-integer(key-layout) || wrong-reader
    refuse(.refused-type, id)
    = Typed(nothing, no-type)
.. wrong-reader = structured != (reader != 0)
. wide = num-cast(id, key, key-layout, u64-layout)
. inside = ir.reserve-block()
. outside = ir.reserve-block()
. joined = ir.reserve-block()
if proven
    jump(inside)
else
    branch
        - compare(id, .compare-less, wide, num-cast(id, size.operand, size-layout, u64-layout))
        - inside
        - outside
ir.start-block(inside)
. stride = integer(.machine-u64, tables.layouts.rows[item-layout].size)
. cell = moved-bytes
    - id
    - num-cast(id, data.operand, data-layout, pointer-layout)
    - arithmetic(id, .arithmetic-multiply, wide, stride, u64-layout)
. held = nothing
. read = item
if structured
    . propertyed = load-property(reader, address(cell, 0, item-layout, id), item, name!)
    held = propertyed.operand
    read = propertyed.type
else
    held = load(cell, 0, item-layout, id)
if proven
    if !gives(if structured then reader else id, read)
        refuse(.refused-conversion, id)
        = Typed(nothing, no-type)
    = Typed(held, read)
. from-inside = ir.current
jump(joined)
ir.start-block(outside)
. mark = pending.length
pending += receiver
pending += key
. answer = call-method(callee, id, mark)
if structured
    answer = load-property(reader, answer.operand, item, name!)
if answer.type != read
    refuse(.refused-conversion, id)
    = Typed(nothing, no-type)
. from-outside = ir.current
jump(joined)
ir.start-block(joined)
. read-layout = layout-of(read, id)
if !gives(if structured then reader else id, read)
    refuse(.refused-conversion, id)
    = Typed(nothing, no-type)
= Typed(phi(read-layout, held, from-inside, answer.operand, from-outside), read)

────────────────────
_ do emit-array-store Assignment
    - site SyntaxId
    - callee InstanceId
    - object SyntaxId
    - index SyntaxId
    - rhs SyntaxId

. emitted = emit-expression(rhs)
. value = apart(emitted, rhs, !is-inert(object) || !is-inert(index))
. given = emitted.type
. receiver = convert(object, .reason-receiver, emit-expression(object))
. receiver-type = receiver.type
. key = convert(index, .reason-argument, emit-expression(index))
. key-type = key.type
. stored = convert(rhs, .reason-argument, Typed(value, given))
if receiver-type != instances.rows[callee].self-type || key-differs || value-differs
    refuse(.refused-conversion, site)
    = Assignment()
.. key-differs = key-type != instances.argument-type(callee, 0)
.. value-differs = stored.type != instances.argument-type(callee, 1)
. layout = layout-of(receiver-type, site)
. key-layout = layout-of(key-type, site)
. item-layout = layout-of(stored.type, site)
. data = part(receiver.operand, layout, 0, site)
. data-layout = layout-of(data.type, site)
. proven = facts.constant-of(unit.reading, site) != no-fact
. size = if proven then Typed(integer(.machine-u64, 0), types.size-type) else part(receiver.operand, layout, 1, site)
. size-layout = if proven then u64-layout else layout-of(size.type, site)
if !is-pointer(data-layout) || !is-integer(size-layout) || !is-integer(key-layout) || struct-item
    refuse(.refused-type, site)
    = Assignment()
.. struct-item = tables.layouts.is-struct(item-layout)
. wide = num-cast(site, key.operand, key-layout, u64-layout)
. stride = integer(.machine-u64, tables.layouts.rows[item-layout].size)
. assignment = Assignment(Typed(stored.operand, instances.argument-type(callee, 1)), Typed(value, given))
if proven
    . moved = moved-bytes
        - site
        - num-cast(site, data.operand, data-layout, pointer-layout)
        - arithmetic(site, .arithmetic-multiply, wide, stride, u64-layout)
    store(moved, 0, stored.operand, false, site)
    = assignment
. inside = ir.reserve-block()
. outside = ir.reserve-block()
. joined = ir.reserve-block()
branch
    - compare(site, .compare-less, wide, num-cast(site, size.operand, size-layout, u64-layout))
    - inside
    - outside
ir.start-block(inside)
store
    - moved-bytes
        - site
        - num-cast(site, data.operand, data-layout, pointer-layout)
        - arithmetic(site, .arithmetic-multiply, wide, stride, u64-layout)
    - 0
    - stored.operand
    - false
    - site
jump(joined)
ir.start-block(outside)
. mark = pending.length
pending += receiver.operand
pending += key.operand
pending += stored.operand
do call-method(callee, site, mark)
jump(joined)
ir.start-block(joined)
= assignment

────────────────────
_ do fills-in-order Bool
    - fact CallFact
    - callee InstanceId
    - count U32

` Whether a call gives its callee exactly `count` arguments, each parameter the one written
` in its place.
if instances.signatures[callee].args.count != count || fact.fills.count != count
    = false
for position in 0 .. < count
    if facts.call-fills[fact.fills.start + position] as U32 != position
        = false
= true

────────────────────
_ do emit-index-store Assignment
    - site SyntaxId
    - fact CallFact
    - object SyntaxId
    - index SyntaxId
    - rhs SyntaxId

` An index assigned through the function that answers `[]=`, which stores the value: the
` function is called on the object with the key and the value. The value is evaluated
` first, then the object, then the key, as TypeScript does, and each takes the conversion
` recorded for it. The value of the assignment is what the function answers, or when it answers
` nothing, the value written, as given or as stored. Where the type pass planned the answer to be stored, it
` is stored where the object was read from, which then only names storage; an object that is
` itself an index has it stored through that index.
. callee = fact.callee
if callee == no-instance || fact.is-partial || !is-callable(callee)
    refuse(.refused-statement, site)
    = Assignment()
. owner = instances.rows[callee].self-type
. answers = instances.signatures[callee].returns
if !fills-in-order(fact, callee, 2) || names-slot(object, .slot-super)
    refuse(.refused-statement, site)
    = Assignment()
. stores-back = facts.plan-of(unit.reading, site) == .plan-store-answer
if owner == no-type || (is-numeric-type(owner) && !stores-back)
    refuse(.refused-statement, site)
    = Assignment()
if !stores-back && answers == owner && !tables.is-class(owner)
    refuse(.refused-statement, site)
    = Assignment()
do match? tree.nodes[object]
    | .node-index-expression(row)
        if !tables.is-class(owner)
            . outer = stored-through(object)
            if !stores-back || answers != owner || outer == no-fact || chained
                refuse(.refused-statement, site)
                = Assignment()
            .. chained = chains-at(object, row.is-optional)
            = emit-store-through(site, fact, facts.calls[outer], object, index, rhs)
if stores-back && (answers != owner || !is-place(object) || retyped)
    refuse(.refused-statement, site)
    = Assignment()
.. retyped = facts.node-type(unit.reading, object) != owner
. emitted = emit-expression(rhs)
. value = apart(emitted, rhs, !is-inert(object) || !is-inert(index))
. given = emitted.type
. pin-mark = pins.length
if stores-back
    pin-holder(object)
. receiver = convert(object, .reason-receiver, emit-expression(object))
. receiver-type = receiver.type
. key = receiver
. key-type = no-type
key = convert(index, .reason-argument, emit-expression(index))
key-type = key.type
. stored = convert(rhs, .reason-argument, Typed(value, given))
if receiver-type != owner
    refuse(.refused-conversion, object)
if key-type != instances.argument-type(callee, 0)
    refuse(.refused-conversion, index)
if stored.type != instances.argument-type(callee, 1)
    refuse(.refused-conversion, rhs)
. answer = stored
. replaced = call-at(site, .call-replaced)
if replaced != no-fact
    . read-mark = pending.length
    pending += receiver.operand
    pending += key.operand
    . old = call-method(facts.calls[replaced].callee, site, read-mark)
    . old-type = old.type
    if is-array-type(old-type)
        replace-storage(site, old.operand, old-type, value, given)
. mark = pending.length
pending += receiver.operand
pending += key.operand
pending += stored.operand
answer = call-method(callee, site, mark)
if stores-back
    store-place(object, answer.operand, owner, site)
unpin(pin-mark)
if answers != types.void-type
    . answered = Typed(answer.operand, answers)
    = Assignment(answered, answered)
= Assignment(Typed(stored.operand, instances.argument-type(callee, 1)), Typed(value, given))

────────────────────
_ do emit-index-update Assignment
    - site SyntaxId
    - op Operator
    - object SyntaxId
    - index SyntaxId
    - rhs SyntaxId

` An index given a value an assigning operator makes from the one it holds: the function that
` answers `[]` reads the item, the machine operation of numbers, or the function that answers
` the operator the assignment applies, makes the new value of it and the value written, and the
` function that answers `[]=` stores that, as the reference does.
` The reference evaluates the object and the key for the read and again for the store, so only
` an object that names storage has a shape here, read once, and only where `[]=` stores in
` place: on an object, or on a value it does not answer anew. A key that changes nothing is read
` once too; another is evaluated again for the store where it can be.
. read = call-at(site, .call-operator)
. store = next-operator(read)
. plan = facts.plan-of(unit.reading, site)
. combined = no-fact
if plan == .plan-call
    combined = store
    store = next-operator(combined)
. increment = increment-base(op)
. inert = is-inert(index)
if store == no-fact || !increment || increment == .concat-op || other-plan || unrepeatable
    refuse(.refused-statement, site)
    = Assignment()
.. other-plan = plan != .plan-builtin && plan != .plan-call
.. unrepeatable = !is-place(object) || (!inert && !is-repeatable(index))
. getter = facts.calls[read].callee
. setter = facts.calls[store].callee
if getter == no-instance || setter == no-instance || partial-call || uncallable
    refuse(.refused-statement, site)
    = Assignment()
.. partial-call = facts.calls[read].is-partial || facts.calls[store].is-partial
.. uncallable = !is-callable(getter) || !is-callable(setter)
. owner = instances.rows[setter].self-type
if owner == no-type || returns-owner || !getter-fills || !setter-fills
    refuse(.refused-statement, site)
    = Assignment()
.. returns-owner = !tables.is-class(owner) && instances.signatures[setter].returns == owner
.. getter-fills = fills-in-order(facts.calls[read], getter, 1)
.. setter-fills = fills-in-order(facts.calls[store], setter, 2)
. receiver = convert(object, .reason-receiver, emit-expression(object))
. receiver-type = receiver.type
. key = receiver
. key-type = no-type
key = convert(index, .reason-argument, emit-expression(index), 0, true)
key-type = key.type
if receiver-type != owner || instances.rows[getter].self-type != owner
    refuse(.refused-conversion, object)
    = Assignment()
if key-type != instances.argument-type(getter, 0) || key-type != instances.argument-type(setter, 0)
    refuse(.refused-conversion, index)
    = Assignment()
. read-mark = pending.length
pending += receiver.operand
pending += key.operand
. current = call-method(getter, site, read-mark)
. current-type = current.type
. value = current
if combined == no-fact
    value = combine-builtin(site, increment, site, current.operand, current-type, rhs, true)
else
    . given = emit-expression(rhs)
    . given-type = given.type
    value = call-operator(site, combined, site, current.operand, current-type, rhs, given.operand, given-type)
. computed = value
value = convert(site, .reason-assignment, value)
if value.type != instances.argument-type(setter, 1)
    refuse(.refused-conversion, site)
    = Assignment()
. assignment = Assignment(value, computed)
if !inert
    key = convert(index, .reason-argument, emit-expression(index), 0, true)
    if key.type != key-type
        refuse(.refused-conversion, index)
        = Assignment()
. mark = pending.length
pending += receiver.operand
pending += key.operand
pending += value.operand
call-method(setter, site, mark)
= assignment

────────────────────
_ do next-operator FactId
    - fact FactId

` The call of an operator recorded at a node after the one given, or none.
. next = if fact != no-fact then facts.calls[fact].next else no-fact
while next != no-fact && facts.calls[next].form != .call-operator
    next = facts.calls[next].next
= next

────────────────────
_ do emit-item-answer
    - site SyntaxId
    - object SyntaxId
    - index SyntaxId
    - rhs SyntaxId

` An assigning operator on an item that a function of its own name answers, where the item holds
` no struct or tuple: the item is read by the function that answers `[]`, the value is evaluated,
` and the function is called on the item with it, as the reference compiles it for an object.
` Nothing is stored.
. read = call-at(site, .call-operator)
. answer = next-operator(read)
if answer == no-fact
    refuse(.refused-statement, site)
    =
. item = emit-index-call(site, facts.calls[read], object, index)
. item-type = item.type
. given = emit-expression(rhs)
. given-type = given.type
call-operator(site, answer, site, item.operand, item-type, rhs, given.operand, given-type)

────────────────────
_ do is-repeatable Bool
    - id SyntaxId

` Whether an operand can be emitted again where the reference evaluates it again: a literal, a
` name, or a read, a call, a cast or an operation of such operands, none of which makes a function.
do match? tree.nodes[id]
    | .node-argument(named)
        = is-repeatable(named.expr)
    | .node-cast-expression(row)
        = is-repeatable(row.lhs)
    | .node-binary-expression(row)
        = is-repeatable(row.lhs) && is-repeatable(row.rhs)
    | .node-unary-expression(row)
        = is-repeatable(row.operand)
    | .node-get-expression(row)
        = row.object == 0 || is-repeatable(row.object)
    | .node-index-expression(row)
        = is-repeatable(row.object) && is-repeatable(row.index)
    | .node-call-expression(row)
        for argument in tree.children[row.args]
            if !is-repeatable(argument)
                = false
        = is-repeatable(row.callable)
    | .node-integer-syntax
        = true
    | .node-float-syntax
        = true
    | .node-string-syntax
        = true
    | .node-identifier
        = true
= false

────────────────────
_ do pin-holder
    - place SyntaxId

` Evaluates, once, the object a place is a property or a field of, and keeps its value for
` every later reading of that object: what is stored in the place after other code has run
` goes where the place was read from, though that code may have changed what the object's
` expression names.
do match? tree.nodes[place]
    | .node-get-expression(row)
        if row.object == 0 || is-pinned(row.object)
            =
        . held = emit-expression(row.object)
        pin(row.object, held.operand, held.type)

────────────────────
_ do stored-through FactId
    - id SyntaxId

` The call recorded at an inner index of the function that stores what `[]=` answered for
` the item the index gave. No fact where the type pass recorded none.
. fact = facts.first-call(unit.reading, id)
while fact != no-fact
    if facts.calls[fact].form == .call-store-through
        = fact
    fact = facts.calls[fact].next
= no-fact

────────────────────
_ do emit-store-through Assignment
    - site SyntaxId
    - fact CallFact
    - outer CallFact
    - held SyntaxId
    - index SyntaxId
    - rhs SyntaxId

` An index of an index assigned, where the inner index gives a struct or a number and the
` type pass planned what `[]=` answers for it to be stored. In TypeScript's order:
` 1. The value is evaluated, and then the object the inner index reads from and its key,
`    once each. A struct among them is copied, since the calls that follow may change the
`    storage it was read from.
` 2. The item is read with the inner index's own function, or as TypeScript reads an item of
`    an array of numbers, where the type pass planned it so.
` 3. The key is evaluated, and `[]=` is called on the item.
` 4. What it answers is stored with the `[]=` of the object, under the same key.
` The value of the assignment is the value written. An object held by value whose `[]=`
` answers one of its own type would have that stored in turn, which has no shape yet.
. callee = fact.callee
. owner = instances.rows[callee].self-type
. reads = own-call(held)
. stores = outer.callee
. object = 0u32
. key-syntax = 0u32
do match? tree.nodes[held]
    | .node-index-expression(row)
        object = row.object
        key-syntax = row.index
if reads == no-fact || stores == no-instance || object == 0 || names-slot(object, .slot-super)
    refuse(.refused-statement, site)
    = Assignment()
. read = facts.calls[reads]
. reader = read.callee
if read.form != .call-operator || read.is-partial || outer.is-partial || reader == no-instance
    refuse(.refused-statement, site)
    = Assignment()
if tables.instance-functions[reader] == no-function || no-stores-function
    refuse(.refused-statement, site)
    = Assignment()
.. no-stores-function = tables.instance-functions[stores] == no-function
if !fills-in-order(read, reader, 1) || !fills-in-order(outer, stores, 2)
    refuse(.refused-statement, site)
    = Assignment()
. holder = instances.rows[stores].self-type
. keyed = instances.argument-type(reader, 0)
if instances.rows[reader].self-type != holder
    refuse(.refused-statement, site)
    = Assignment()
if instances.argument-type(stores, 0) != keyed || instances.argument-type(stores, 1) != owner
    refuse(.refused-statement, site)
    = Assignment()
if instances.signatures[stores].returns == holder && !tables.is-class(holder)
    refuse(.refused-statement, site)
    = Assignment()
. emitted = emit-expression(rhs)
. value = apart(emitted, rhs, true)
. given = emitted.type
. container = convert(object, .reason-receiver, emit-expression(object))
if container.type != holder
    refuse(.refused-conversion, object)
    = Assignment()
container = Typed(apart(container, object, true), container.type)
. key = convert(key-syntax, .reason-argument, emit-expression(key-syntax))
if key.type != keyed
    refuse(.refused-conversion, key-syntax)
    = Assignment()
key = Typed(apart(key, key-syntax, true), key.type)
. read-item = Typed(make-operand(.operand-void, 0), no-type)
if facts.plan-of(unit.reading, held) == .plan-array-item
    read-item = array-item(held, reader, container.operand, holder, key.operand, keyed)
else
    . mark = pending.length
    pending += container.operand
    pending += key.operand
    read-item = call-method(reader, held, mark)
. item = convert(held, .reason-receiver, read-item)
if item.type != owner
    refuse(.refused-conversion, held)
    = Assignment()
item = Typed(apart(item, held, !is-inert(index)), item.type)
. place = convert(index, .reason-argument, emit-expression(index))
. place-type = place.type
. stored = convert(rhs, .reason-argument, Typed(value, given))
if place-type != instances.argument-type(callee, 0)
    refuse(.refused-conversion, index)
    = Assignment()
if stored.type != instances.argument-type(callee, 1)
    refuse(.refused-conversion, rhs)
    = Assignment()
. store-mark = pending.length
pending += item.operand
pending += place.operand
pending += stored.operand
. answer = call-method(callee, site, store-mark)
if answer.type != owner
    refuse(.refused-conversion, site)
    = Assignment()
. back-mark = pending.length
pending += container.operand
pending += key.operand
pending += answer.operand
call-method(stores, held, back-mark)
= Assignment(Typed(stored.operand, instances.argument-type(callee, 1)), Typed(value, given))

────────────────────
_ do emit-list Typed
    - id SyntaxId
    - written RowRange'SyntaxId

` A list written, made as TypeScript makes one: the items are evaluated in the order they are
` written, a struct among several copied, since what follows may change the storage it was
` read from, and the list is made of them.
. nothing = make-operand(.operand-void, 0)
. list-type = facts.node-type(unit.reading, id)
. count U32 = written.count
. start = given.length
for item in tree.children[written]
    . made = emit-expression(item)
    given += Typed(apart(made, item, count > 1), made.type)
. list = nothing
list = build-list(id, written, list-type, start, true).operand
drop-given(start)
= Typed(list, list-type)

────────────────────
_ do build-list Typed
    - id SyntaxId
    - written RowRange'SyntaxId
    - list-type TypeId
    - start Size
    - converts Bool
    - chain SyntaxId = 0
    - room U32 = 0

` A list of the items written at `written`, which `given` holds from `start` on, made with the
` functions the type pass recorded at the node:
` 1. The empty list is made, and room for the items is reserved in it.
` 2. Each item takes the conversion recorded for it, where it `converts`.
` 3. Each is stored where the array the list keeps its items in holds them, and the list's
`    size is set.
. nothing = make-operand(.operand-void, 0)
. makes = no-fact
. reserves = no-instance
. reads = no-instance
. fact = facts.first-call(unit.reading, id)
while fact != no-fact
    . row = facts.calls[fact]
    if row.form == .call-list-make
        makes = fact
    else if row.form == .call-list-reserve
        reserves = row.callee
    else if row.form == .call-list-data
        reads = row.callee
    fact = row.next
. count U32 = written.count
. kept = property-of(list-type, types.items-atom!)
. sized = property-of(list-type, types.size-atom!)
if makes == no-fact || reserves == no-instance || reads == no-instance || !kept || !sized
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
if tables.instance-functions[reserves] == no-function || no-reads-function
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
.. no-reads-function = tables.instance-functions[reads] == no-function
. list = emit-fact-call(id, facts.calls[makes], 0, RowRange'SyntaxId(), 0, 0, list-type)
if list.type != list-type
    refuse(.refused-conversion, id)
if count != 0 || room != 0
    fill-list(id, written, list.operand, list-type, start, reserves, reads, kept, converts, chain, room)
if count != 0
    . field = held-field(id, list-type, sized)
    if is-integer(field.layout)
        store(list.operand, field.offset, integer(field.layout as MachineKind, count), false, id)
    else
        refuse(.refused-expression, id)
= Typed(list.operand, list-type)

────────────────────
_ do emit-tail Typed
    - id SyntaxId
    - written RowRange'SyntaxId
    - lead U32
    - start Size
    - first U32
    - count U32
    - list-type TypeId
    - piped SyntaxId

` The variadic tail of a call: the arguments written from `first` on, which `given` holds from
` `start + first` on, each converted to the item of the list the call is given, as TypeScript
` converts them once every other argument is, and then a list made of them as a list written
` is made. An argument with a name is first made the tuple of its name and its value. A
` tail with a bullet `•?` is made by appending. A tail that takes a value piped into the call
` has no shape yet.
. nothing = make-operand(.operand-void, 0)
if first < lead || (piped != 0 && first < count)
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. tail = RowRange'SyntaxId(written.start + first - lead, count - first)
for item in tree.children[tail]
    do match? tree.nodes[item]
        | .node-argument(named)
            if named.is-optional
                = append-tail(id, tail, start + first, list-type)
for position in 0 .. < tail.count
    . item = tree.children[tail.start + position]
    . held = start + first + position
    do match? tree.nodes[item]
        | .node-argument(named)
            if named.name
                . paired = name-pair(item, named.name, given[held].operand, given[held].type)
                given[held] = paired
    . converted-2 = convert(item, .reason-element, given[held])
    given[held] = converted-2
= build-list(id, tail, list-type, start + first, false)

────────────────────
_ do append-tail Typed
    - id SyntaxId
    - tail RowRange'SyntaxId
    - start Size
    - list-type TypeId

` A variadic tail with a bullet `•?`, made as TypeScript makes it: the empty list is made, and
` each argument of the tail, which `given` holds from `start` on, is converted to the list's
` item and appended to it by the call recorded at the argument. One with the bullet is
` appended only where it is present, as what it holds: an optional where it holds a value,
` and the tuple of a key and an optional value where the value holds one. Any other with
` the bullet has no shape yet.
. nothing = make-operand(.operand-void, 0)
. makes = no-fact
. fact = facts.first-call(unit.reading, id)
while fact != no-fact
    if facts.calls[fact].form == .call-list-make
        makes = fact
    fact = facts.calls[fact].next
if makes == no-fact
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. list = emit-fact-call(id, facts.calls[makes], 0, RowRange'SyntaxId(), 0, 0, list-type)
if list.type != list-type
    refuse(.refused-conversion, id)
for position in 0 .. < tail.count
    . item = tree.children[tail.start + position]
    . value = given[start + position].operand
    . given-type = given[start + position].type
    . named Atom? = null
    . optional = false
    do match? tree.nodes[item]
        | .node-argument(row)
            named = row.name
            optional = row.is-optional
    if !optional
        . appended = Typed(value, given-type)
        if named
            appended = name-pair(item, named, value, given-type)
        append-item(item, list.operand, list-type, appended)
        continue
    . whole = facts.node-type(unit.reading, item)
    . optional-type = given-type
    . tested = value
    . key = nothing
    . key-type = no-type
    if !named
        . layout = layout-of(given-type, item)
        if !tables.layouts.is-struct(layout) || tables.layouts.rows[layout].fields.count != 2
            refuse(.refused-expression, item)
            = Typed(nothing, no-type)
        . piece = part(value, layout, 0, item)
        key = piece.operand
        key-type = piece.type
        piece = part(value, layout, 1, item)
        tested = piece.operand
        optional-type = piece.type
    if !types.is-optional(optional-type)
        refuse(.refused-expression, item)
        = Typed(nothing, no-type)
    . holds = present(item, Typed(tested, optional-type))
    . taken = ir.reserve-block()
    . passed = ir.reserve-block()
    branch(holds.operand, taken, passed)
    ir.start-block(taken)
    . held = payload(item, Typed(tested, optional-type))
    . inner = held.type
    if named
        held = name-pair(item, named, held.operand, inner)
    else
        held = key-pair(item, whole, key, key-type, held.operand, inner)
    append-item(item, list.operand, list-type, held)
    jump(passed)
    ir.start-block(passed)
= Typed(list.operand, list-type)

────────────────────
_ do append-item
    - item SyntaxId
    - list Operand
    - list-type TypeId
    - value Typed

` Converts an argument of a variadic tail to the list's item, and appends it by the call
` recorded at the argument.
. appended = own-call(item)
if appended == no-fact
    refuse(.refused-expression, item)
    =
. callee = facts.calls[appended].callee
if callee == no-instance || instances.rows[callee].self-type != list-type
    refuse(.refused-expression, item)
    =
. converted = convert(item, .reason-element, value)
if converted.type != instances.argument-type(callee, 0)
    refuse(.refused-conversion, item)
    =
. mark = pending.length
pending += list
pending += converted.operand
call-method(callee, item, mark)

────────────────────
_ do key-pair Typed
    - item SyntaxId
    - pair TypeId
    - key Operand
    - key-type TypeId
    - value Operand
    - given TypeId

` The tuple of a key and what the value written after it holds, of the type the type pass
` kept at the argument.
. layout = layout-of(pair, item)
if !tables.layouts.is-struct(layout) || tables.layouts.rows[layout].fields.count != 2
    refuse(.refused-expression, item)
    = Typed(value, no-type)
if field-type(pair, 0) != key-type || field-type(pair, 1) != given
    refuse(.refused-conversion, item)
    = Typed(value, no-type)
. made = frame(layout)
put(made, tables.layouts.field(layout, 0), key, item)
put(made, tables.layouts.field(layout, 1), value, item)
= Typed(made, pair)

────────────────────
_ do name-pair Typed
    - item SyntaxId
    - name Atom
    - value Operand
    - given TypeId
    - made TypeId = no-type

` The tuple of a name and a value, which an argument of a variadic tail with a name stands
` for, of the type the type pass kept at the argument, or of the type `made`.
. pair = if made != no-type then made else facts.node-type(unit.reading, item)
. layout = layout-of(pair, item)
. row = tables.layouts.rows[layout]
if !tables.layouts.is-struct(layout) || row.fields.count != 2
    refuse(.refused-expression, item)
    = Typed(value, no-type)
if field-type(pair, 0) != types.string-type || field-type(pair, 1) != given
    refuse(.refused-conversion, item)
    = Typed(value, no-type)
. made = frame(layout)
put
    - made
    - tables.layouts.field(layout, 0)
    - make-operand(.operand-constant, ir.add-string(name.text))
    - item
put(made, tables.layouts.field(layout, 1), value, item)
= Typed(made, pair)

────────────────────
_ do emit-argument-value Operand
    - id SyntaxId
    - row ASTArgument

` An argument written where a value is wanted, as the reference compiles one: the tuple of its
` name and its value where it has a name, and with a bullet `•?` that tuple as an optional where
` the value tests as true and nothing where it does not; its value where it has no name.
. nothing = make-operand(.operand-void, 0)
. value = emit-expression(row.expr)
if !row.name
    = value.operand
. argument-name = row.name
. held = value.type
. type = facts.node-type(unit.reading, id)
if !row.is-optional
    = name-pair(id, argument-name, value.operand, held).operand
. layout = layout-of(type, id)
if !types.is-optional(type) || !tables.layouts.is-struct(layout)
    refuse(.refused-type, id)
. tested = test(id, value, true, false)
. taken = ir.reserve-block()
. passed = ir.reserve-block()
. joined = ir.reserve-block()
. slot = join-slot(layout)
. mark = joins.length
branch(tested.operand, taken, passed)
ir.start-block(taken)
. pair = name-pair(id, argument-name, value.operand, held, types.optional-inner(type))
arrive(id, wrap(id, pair, type).operand, joined, slot)
ir.start-block(passed)
arrive(id, empty-optional(type, layout).operand, joined, slot)
= close-joins(joined, mark, layout, slot)

────────────────────
_ do fill-list
    - id SyntaxId
    - written RowRange'SyntaxId
    - list Operand
    - list-type TypeId
    - start Size
    - reserves InstanceId
    - reads InstanceId
    - kept Index
    - converts Bool
    - chain SyntaxId = 0
    - room U32 = 0

` Reserves room in a list just made for the items evaluated, which `given` holds from
` `start` on, converts each where it `converts`, and stores them where the list's array holds
` its items.
. count U32 = written.count
. counted = layout-of(types.size-type, id)
. takes-size = instances.signatures[reserves].args.count == 1 && is-integer(counted)
if !takes-size || instances.argument-type(reserves, 0) != types.size-type
    refuse(.refused-expression, id)
    =
if instances.rows[reserves].self-type != list-type
    refuse(.refused-conversion, id)
    =
. mark = pending.length
pending += list
pending += integer(counted as MachineKind, count + room)
call-method(reserves, id, mark)
for position in 0 .. < count
    if !converts
        break
    . item = item-site(written, chain, position)
    . converted = convert(item, .reason-element, given[start + position])
    given[start + position] = converted
. array = held-field(id, list-type, kept)
if !tables.layouts.is-struct(array.layout) || array.type != instances.rows[reads].self-type
    refuse(.refused-expression, id)
    =
. reading-mark = pending.length
pending += address(list, array.offset, array.layout, id)
. data = call-method(reads, id, reading-mark)
. pointer = layout-of(data.type, id)
. item-type = tables.layouts.pointee-type(data.type)
if !is-pointer(pointer) || item-type == no-type
    refuse(.refused-expression, id)
    =
. layout = layout-of(item-type, id)
. size = tables.layouts.rows[layout].size
for position in 0 .. < count
    . item = item-site(written, chain, position)
    if given[start + position].type != item-type
        refuse(.refused-conversion, item)
        =
    . value = given[start + position].operand
    if tables.layouts.is-struct(layout)
        store-struct(data.operand, LayoutField(position * size, layout), value, item)
    else if layout != void-layout
        store(data.operand, position * size, value, is-managed-pointer(layout), item)

────────────────────
_ do item-site SyntaxId
    - written RowRange'SyntaxId
    - chain SyntaxId
    - position U32

=? tree.children[written.start + position] if chain == 0
. bullet = chain
for _ in 0 .. < position
    bullet = next-bullet(bullet)
= match tree.nodes[bullet]
    | .node-bullet-expression(row)
        row.item
    ??
        bullet

────────────────────
_ next-bullet SyntaxId
    - bullet SyntaxId

match tree.nodes[bullet]
    | .node-bullet-expression(row)
        row.next
    ??
        0

────────────────────
_ do store-place
    - place SyntaxId
    - value Operand
    - type TypeId
    - site SyntaxId

` Stores a value in the storage an expression names, which holds the value's type: a local,
` an argument that is a struct, a local or an argument nested functions capture, in the
` environment that holds it, a global, a field or a property of the receiver named alone, or a
` stored field or property of what such an expression names. The object of a property is the
` one kept when the place was read, where one was kept.
. layout = layout-of(type, site)
do match? tree.nodes[place]
    | .node-identifier(row)
        if is-own-field(place)
            . owner = unit.owner-type
            . found = property-of(owner, row.name)
            if !found || reads-getter(place)
                refuse(.refused-statement, site)
                =
            store-held(unit.self, 0, owner, found, value, type, site)
            =
        . kept = assigned-global(place, site)
        if kept != no-storage
            . global = tables.storage[kept]
            if global.type != type || tables.global-kind(global.module, global.decl) == .global-lazy
                refuse(.refused-statement, site)
                =
            store-global(global, value, site)
            =
        . slot = local-slot(place, site, true)
        if is-captured(slot)
            if bindings.slots[slot].kind == .slot-lazy
                refuse(.refused-statement, site)
                =
            keep-captured(slot, value, type, site)
            =
        . offset = slot-offset(slot, site)
        if facts.slot-type(unit.instance, offset) != type
            refuse(.refused-statement, site)
            =
        if unit.cells[offset] != no-local
            store-local(unit.cells[offset], value, site)
            =
        . memory = argument-memory(slot, type, site)
        copy(memory, value, layout, false, site)
        =
    | .node-get-expression(row)
        . owner = facts.node-type(unit.reading, row.object)
        . known = owner != no-type && owner != invalid-type
        . found = property-of(owner, row.name) if known
        if !found || reads-getter(place)
            refuse(.refused-statement, site)
            =
        . base = emit-expression(row.object)
        store-held(base.operand, row.object, owner, found, value, type, site)
        =
refuse(.refused-statement, site)

────────────────────
_ do store-held
    - base Operand
    - object SyntaxId
    - owner TypeId
    - place Index
    - value Operand
    - type TypeId
    - site SyntaxId

` Stores a value in a property an object stores, or in a field of a struct that lies where
` `object` names, which is the receiver when it is no syntax. A managed pointer written
` into an object goes through the write barrier. A struct that an object holds has no shape
` for a store that writes a managed pointer into it.
. field = held-field(site, owner, place)
if field.type != type
    refuse(.refused-statement, site)
    =
. in-object = tables.is-class(owner)
. managed = field.layout != void-layout && tables.layouts.rows[field.layout].is-managed
if !in-object && managed && !is-framed(object)
    refuse(.refused-statement, site)
    =
if tables.layouts.is-struct(field.layout)
    if in-object
        store-struct(base, field, value, site)
    else
        put(base, field, value, site)
else if field.layout != void-layout
    store(base, field.offset, value, in-object && is-managed-pointer(field.layout), site)

────────────────────
_ do placed-field Typed
    - id SyntaxId
    - base Operand
    - owner TypeId
    - place FactId

` The stored field of a tuple or struct that a constant of the type pass names by its place.
` The read has the field's own type, which is the node's.
. nothing = make-operand(.operand-void, 0)
. layout = layout-of(owner, id)
. position = facts.constants[place].bits as U32
if !tables.layouts.is-struct(layout) || position >= tables.layouts.rows[layout].fields.count
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. type = field-type(owner, position)
if !gives(id, type)
    refuse(.refused-conversion, id)
    = Typed(nothing, no-type)
= Typed(take(base, tables.layouts.field(layout, position), id), type)

────────────────────
_ indexed-field FactId
    - id SyntaxId

` The constant that says which stored field an index names, or none. The node of an index
` assigned with an operator keeps the constant under the operator's own plan.
if plan != .plan-field && plan != .plan-builtin then no-fact else facts.constant-of(unit.reading, id)

.. plan = facts.plan-of(unit.reading, id)

────────────────────
_ do emit-header Operand
    - id SyntaxId
    - expr SyntaxId
    - items RowRange'SyntaxId

` A header gives each item below it to the `with` of what the one before gave. The calls are
` those the type pass recorded at the header, in order: the first on the value written, each
` after on the answer of the one before, held as the header's own value. Only the last answers
` with the header's type. A call that leaves out a parameter or has a variadic tail has no
` shape where there are several, since what it records for them is kept at the header.
if items.count == 0
    = emit-expression(expr).operand
. nothing = make-operand(.operand-void, 0)
. fact = facts.first-call(unit.reading, id)
. value = nothing
. object = expr
. mark = pins.length
for position in 0 .. < items.count
    if fact == no-fact
        refuse(.refused-expression, id)
    . row = facts.calls[fact]
    if items.count > 1 && (row.fills.count != 1 || facts.call-fills[row.fills.start] as U32 != 0)
        refuse(.refused-expression, id)
        break
    . answers = if position + 1 == items.count then no-type else callee-returns
        .. callee-returns = instances.signatures[row.callee].returns
    . called = emit-fact-call
        - id
        - row
        - object
        - RowRange'SyntaxId(items.start + position, 1)
        - 0
        - 0
        - answers
    value = called.operand
    unpin(mark)
    pin(id, value, called.type)
    object = id
    fact = next-call(fact)
unpin(mark)
= value

────────────────────
_ do emit-tuple Typed
    - id SyntaxId
    - items RowRange'SyntaxId

` A tuple written: memory in the frame, with each item stored to its field in turn. An item
` is copied where it is stored, so nothing a later item does changes it.
. nothing = make-operand(.operand-void, 0)
. type = facts.node-type(unit.reading, id)
. layout = layout-of(type, id)
if !tables.layouts.is-struct(layout) || tables.layouts.rows[layout].fields.count != items.count
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. made = frame(layout)
for position in 0 .. < items.count
    . item = tree.children[items.start + position]
    do match? tree.nodes[item]
        | .node-argument(named)
            item = named.expr
    . value = emit-expression(item)
    if value.type != field-type(type, position)
        refuse(.refused-conversion, item)
        = Typed(nothing, no-type)
    put(made, tables.layouts.field(layout, position), value.operand, item)
= Typed(made, type)

────────────────────
_ do run-type-operand
    - id SyntaxId

` What is run before a constant is read from a type or a value: `type-of` runs its operand, a
` name runs nothing, and any other expression is evaluated for what it does.
match? tree.nodes[id]
    | .node-unary-expression(row) { row.op == .type-of-op }
        emit-expression(row.operand)
        =
    | .node-identifier
        =
    | .node-type-identifier
        =
    | .node-core-type-identifier
        =
    | .node-type-arguments
        =
    | .node-type-associated
        =
    | .node-type-optional
        =
    | .node-type-numeric
        =
emit-expression(id)

────────────────────
_ do emit-constant Operand
    - id SyntaxId

` A constant the type pass worked out: the number or the text its fact holds, as a value of
` the node's type.
. nothing = make-operand(.operand-void, 0)
. fact = facts.constant-of(unit.reading, id)
. type = facts.node-type(unit.reading, id)
if fact == no-fact
    refuse(.refused-expression, id)
    = nothing
. row = facts.constants[fact]
if row.text
    if type != types.string-type
        refuse(.refused-type, id)
        = nothing
    = make-operand(.operand-constant, ir.add-string(row.text!.text))
. layout = layout-of(type, id)
if row.is-float && is-float(layout)
    = float-number(layout, row.float)
if !row.is-float && is-integer(layout)
    = integer(tables.layouts.kind-of(layout), row.bits)
refuse(.refused-type, id)
= nothing

────────────────────
_ do emit-fact-call Typed ?! Refused
    - id SyntaxId
    - fact CallFact
    - object SyntaxId
    - written RowRange'SyntaxId
    - piped SyntaxId = 0
    - leading SyntaxId = 0
    - answers TypeId = no-type
    - bound SyntaxId = 0

` A call the type pass recorded, of a function declared with arguments.
` 1. The receiver is evaluated, when the callee has one: the value written before its name, or
`    else the receiver of the function the call is in. It takes the conversion recorded for it.
` 2. The arguments are evaluated in the order they are written, and then each takes the
`    conversion recorded for it. A value piped into the call is evaluated before them, and is
`    the last of them; `piped-site` says where its conversion is kept, where that is not
`    where it is written. The left operand of an operator that makes the call is evaluated
`    before either, and is the first of them.
` A call a value is piped into evaluates its receiver after its arguments.
` 3. Each parameter takes the argument the type pass matched to it, or its default when the
`    call leaves it out. The arguments of a variadic tail are made into the list its
`    parameter takes, once every other argument is converted.
` The answer has the node's type, or `answers` for a call that no node writes.
` `super(…)` gives its object as `object`: it runs the base's constructor on the receiver,
` as an initializer, and answers nothing. A constructor the compiler generated runs nothing
` then. A method called on the receiver by a constructor, or on the base's part of the
` receiver, is the one named, whatever the object's class declares in its place.
` A call that answers nothing and has the type of its receiver gives the receiver: the one
` written, where a property it delegates to answered the call.
` A call of a binding gives `bound`, the binding: it is evaluated first, the value it calls
` on is the receiver, or what a property that value delegates to holds where that answers
` the call, and the arguments it holds come before those written, each converted
` as the type pass recorded at the call for its type and that of the place it fills.
. nothing = make-operand(.operand-void, 0)
. callee = fact.callee
. shifted = piped-site
piped-site = 0
. restores = fact.form == .call-this-constructor && names-slot(object, .slot-super)
if restores
    if callee == no-instance || !(builds || initializes) || piped != 0 || leading != 0
        refuse(.refused-expression, id)
        = Typed(nothing, no-type)
    if !tables.has-initializer(callee)
        if written.count != 0 || !tables.is-class(instances.rows[callee].self-type)
            refuse(.refused-expression, id)
        = Typed(nothing, types.void-type)
if callee != no-instance && !fact.is-partial && piped == 0 && unled-or-unbound && !restores
    if tables.builds-in-frame(callee)
        = emit-construct(id, fact, written, answers, bound, leading)
.. unled-or-unbound = leading == 0 || bound == 0
if callee == no-instance || fact.is-partial
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. target = if restores then tables.initializer-functions[callee] else instance-function
    .. instance-function = tables.instance-functions[callee]
if target == no-function && !tables.is-prototype(callee)
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. row = instances.rows[callee]
. owner = program.modules[row.module]
. first Index = 0
. receives = false
. is-declared = false
do match? owner.decls[row.decl]
    | .decl-fromverter
        if written.count != 1 || piped != 0 || leading != 0 || restores
            refuse(.refused-expression, id)
            = Typed(nothing, no-type)
        = emit-converting(id, callee, tree.children[written.start], fact.propagates)
    | .decl-function(fn)
        if is-table-constructor-kind(fn.kind)
            if piped != 0 || leading != 0 || bound != 0 || restores
                refuse(.refused-expression, id)
                = Typed(nothing, no-type)
            = emit-generated-call(id, fact, written)
        first = fn.args.start
        . is-member = function-or-getter || fn.kind == .setter-decl
            .. function-or-getter = fn.kind == .function-decl || fn.kind == .getter-decl
        receives = fn.owner != 0 && !fn.is-static && is-member
        is-declared = fn.args.count == fact.fills.count
        . makes-nothing = row.self-type != no-type && void-self
            .. void-self = tables.layouts.values[row.self-type] == void-layout
        . makes-zero = fn.kind == .default-constructor-decl && is-zeroed(row.self-type)
        . makes-object = fn.kind == .default-constructor-decl && tables.is-class(row.self-type)
        . makes-absent = fn.kind == .default-constructor-decl && types.is-optional(row.self-type)
        . is-made = makes-nothing || makes-zero || makes-object || makes-absent
        . is-called = fn.kind == .cast-constructor-decl || fn.kind == .function-decl
        if fn.is-generated && !is-called && !is-made
            is-declared = false
if !is-declared
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. mark = pending.length
. receiver = nothing
. written-receiver = nothing
. written-type = no-type
. row-taken = nothing
. start = given.length
. lead U32 = if leading != 0 then 1 else 0
. lead-site = leading
if bound != 0
    if restores || leading != 0 || piped != 0
        refuse(.refused-expression, id)
        = Typed(nothing, no-type)
    . source = emit-callee(bound)
    . shape = source.type
    . held = layout-of(shape, bound)
    . place U32
    if binds-object(shape)
        . reached = read-through(id, part(source.operand, held, 0, bound), fact.through)
        receiver = reached.operand
        place = 1
        . lent = fact.through.count != 0 && is-derived(reached.type, row.self-type)
        if !receives || (reached.type != row.self-type && !lent)
            refuse(.refused-conversion, id)
            = Typed(nothing, no-type)
    else if receives
        refuse(.refused-expression, id)
        = Typed(nothing, no-type)
    lead = bound-count(shape)
    lead-site = id
    for offset in 0 .. < lead
        . piece = part(source.operand, held, place + offset, bound)
        given += piece
else if restores
    receives = true
    receiver = unit.self
else if receives && piped == 0 && dispatch-type != no-type && runs-on-row(callee, dispatch-type)
    receiver = dispatch-row
    row-taken = dispatch-row
else if receives && piped == 0 && takes-row(callee, object)
    receiver = case-receiver(id, object, callee).operand
    row-taken = case-cursors[cursor-at(object)].row
else if receives && piped == 0
    . received-2 = emit-receiver(id, object)
    written-receiver = received-2.operand
    written-type = received-2.type
    . reached = read-through(id, Typed(written-receiver, received-2.type), fact.through)
    receiver = reached.operand
    if reached.type != row.self-type && !derived-through
        refuse(.refused-conversion, id)
    .. derived-through = fact.through.count != 0 && is-derived(reached.type, row.self-type)
. count U32 = written.count + lead
. last = nothing
. last-type = no-type
if leading != 0
    . follows = piped != 0 && !is-inert(piped)
    . lead-value = emit-expression(leading)
    given += Typed(apart(Typed(settled(lead-value, leading, written, 0), lead-value.type), leading, follows), lead-value.type)
if piped != 0
    count += 1
    . pipe-value = emit-expression(piped)
    last = settled(pipe-value, piped, written, 0)
    last-type = pipe-value.type
. evaluated U32
for argument in tree.children[written]
    . expression = argument
    do match? tree.nodes[argument]
        | .node-argument(named)
            expression = named.expr
    evaluated += 1
    . live = tables.live-statement-of(unit.reading, expression) if styling.element != 0 && id == styling.element && expression == argument
    . trackers = if live then open-trackers(expression) else no-local
    if live
        live-actions += LiveTrackers(trackers, trackers)
    . emitted = emit-expression(expression)
    . value = settled(emitted, expression, written, evaluated)
    if live
        live-actions.pop()
        argument-trackers += LiveMember(expression, trackers)
    given += Typed(value, emitted.type)
    if styling.element != 0 && id == styling.element
        element-given += Typed(apart(Typed(value, emitted.type), expression, true), emitted.type)
. attributes = element-given.length
. filled-mark = element-filled.length
if styling.element != 0 && id == styling.element
    emit-attributes(id, callee, fact, count)
if styling.valued != 0 && id == styling.valued
    emit-rule-values(id)
if piped != 0
    given += Typed(last, last-type)
if receives && piped != 0 && !restores
    . reached = read-through(id, emit-receiver(id, object), fact.through)
    receiver = reached.operand
    if reached.type != row.self-type
        refuse(.refused-conversion, id)
if receives
    pending += receiver
. tail-first = count
. tail-type = no-type
for position in 0 .. < fact.fills.count
    if facts.call-fills[fact.fills.start + position] as U32 == ArgumentFill.fill-variadic
        tail-first = lead
        tail-type = instances.argument-type(callee, position)
for position in 0 .. < fact.fills.count
    . fill = facts.call-fills[fact.fills.start + position] as U32
    . fixed = fill != ArgumentFill.fill-empty && fill != ArgumentFill.fill-variadic
    if tail-type != no-type && fixed && fill < count && fill >= tail-first
        tail-first = fill + 1
for position in 0 .. < count
    if position >= tail-first
        break
    . site = lead-site
    if position >= lead
        . index = position - lead
        site = if index == written.count then piped else tree.children[written.start + index]
    . passed = given[start + position]
    if !takes-default(fact, owner, first, position, passed.type)
        if position < lead && bound != 0
            . wanted = filled-type(fact, callee, position)
            if wanted != no-type && passed.type != wanted
                passed = convert-held(id, passed, wanted)
        else if piped != 0 && site == piped && shifted != 0
            . reason ConversionReason = if shifted == id then .reason-piped else .reason-argument
            passed = convert-matched
                - shifted
                - reason
                - passed
                - no-type
        else
            passed = convert(site, .reason-argument, passed)
    else
        . parameter = filled-parameter(fact, position)
        . expected = instances.argument-type(callee, parameter)
        passed = optional-argument
            - id
            - site
            - passed
            - callee
            - owner.arg-pool[first + parameter].default-syntax
            - expected
    given[start + position] = passed
. tail = nothing
if tail-type != no-type
    . tailed = emit-tail(id, written, lead, start, tail-first, count, tail-type, piped)
    tail = tailed.operand
    if tailed.type != tail-type
        refuse(.refused-conversion, id)
. placed U32
for position in 0 .. < fact.fills.count
    . fill = facts.call-fills[fact.fills.start + position] as U32
    . expected = instances.argument-type(callee, position)
    . default = owner.arg-pool[first + position].default-syntax
    if fill == ArgumentFill.fill-empty
        pending += default-argument(id, callee, default, expected).operand
    else if fill == ArgumentFill.fill-variadic
        pending += tail
        placed += count - tail-first
    else if fill >= count
        . held = attributes + ((fill - count) as Size)
        if styling.element == 0 || id != styling.element || held >= element-given.length
            refuse(.refused-expression, id)
        else if element-given[held].type != expected
            refuse(.refused-conversion, id)
        else
            pending += element-given[held].operand
    else if given[start + fill].type != expected
        refuse(.refused-conversion, id)
    else
        pending += given[start + fill].operand
        placed += 1
drop-given(start)
if placed != count
    refuse(.refused-expression, id)
. filled = row.fills.count
if filled != 0
    if styling.element == 0 || id != styling.element || element-filled.length != filled-mark + filled
        refuse(.refused-expression, id)
    else
        for offset in 0 .. < filled
            . held = element-filled[filled-mark + offset] as Size
            if element-given[held].type != instances.argument-type(callee, fact.fills.count + offset)
                refuse(.refused-conversion, id)
            else
                pending += element-given[held].operand
if row.carried != 0
    give-cells(id, row.carried)
if row.slots.count != 0
    give-slots(id, callee)
if row-taken != nothing && row.row-validated
    pending += if dispatch-type != no-type then dispatch-columns else case-columns(id, at-cursor)
        .. at-cursor = cursor-at(object)
if restores
    . called-2 = call-instance(callee, id, mark, true)
    = Typed(nothing, called-2.type)
. exact = names-slot(object, .slot-super)
if (builds || initializes) && fact.form != .call-getter && on-this
    exact = true
if receives && bound == 0 && fact.through.count == 0
    . known = if object == 0 then unit.owner-type else facts.answer-type(unit.reading, object)
    if tables.is-class(known) && is-derived(known, row.self-type) && !types.has-subclasses(known)
        exact = true
.. on-this = object == 0 || names-slot(object, .slot-this)
. raising = instances.signatures[callee].errors.count != 0
takes-result = raising
. answer = if receives then call-method(callee, id, mark, exact) else call-instance(callee, id, mark)
takes-result = false
if raising && fact.propagates
    answer = propagate(id, callee, answer.operand)
. expected = if answers != no-type then answers else facts.answer-type(unit.reading, id)
if receives && answer.type == types.void-type && answers-self
    = Typed(receiver, expected)
.. answers-self = expected == row.self-type && row-taken == nothing
if answer.type == types.void-type && reads-through
    = Typed(written-receiver, expected)
.. reads-through = fact.through.count != 0 && expected == written-type
if answer.type != expected && !links-into(id, answer.type, expected)
    refuse(.refused-conversion, id)
= answer

────────────────────
_ takes-row Bool
    - callee InstanceId
    - object SyntaxId

` Whether a call written on a name that stands for the case of a row, or on the receiver
` named by no name in a member that runs on the case, passes the row: to a member of the case
` that runs on the row, or to one of a base every case shares.
|? cursor-at(object) == U32.max
    false
??
    row.row-receiver != no-type || holds-row(row.self-type)

.. row = instances.rows[callee]

────────────────────
_ do case-receiver Typed
    - id SyntaxId
    - object SyntaxId
    - callee InstanceId

` The row a call passes where it is written on a name that stands for the case of a row, as
` TypeScript passes the cursor's row: a member of the case takes the row of its own type, and
` one of a shared base the row it runs on.
. held = case-cursors[cursor-at(object)]
. row = instances.rows[callee]
. wanted = if row.row-receiver != no-type then row.row-receiver else row.self-type
if held.type != wanted || (row.row-receiver != no-type && held.case-index != row.row-case)
    refuse(.refused-expression, id)
    = Typed(make-operand(.operand-void, 0), no-type)
= Typed(held.row, held.type)

────────────────────
_ cursor-at U32
    - object SyntaxId

` The case of a row a call's object stands for: that of a name, or with no object written
` that of the receiver in a member that runs on the case.
if object != 0 then case-cursor-of(object) else this-cursor

────────────────────
_ do case-columns Operand
    - id SyntaxId
    - cursor U32

` The columns a call passes after its arguments to a member of a case that runs on a row whose
` storage TypeScript checked where the case was read.
= case-place(id, case-cursors[cursor]).columns

────────────────────
_ do callee-type TypeId
    - callable SyntaxId

` The type of the value a call calls. The type pass types a name there only where it is
` read for its value, so a local, a lazy local, an argument, the item of a loop or a name a
` pattern binds has the type its function gives it, the receiver its own, and a
` property of the receiver the type it is declared with, and a global the type it is kept
` with. One that is an optional the type pass planned to be called as what it holds is read
` as that.
. type = facts.node-type(unit.reading, callable)
. binding = instances.rows[unit.reading].binding
if type != no-type || binding == no-binding
    = type
. global = bindings.resolution-of(binding, callable)
if global.kind == .resolve-global
    . row = tables.storage-of(global.module, global.decl)
    = if row != no-storage then tables.storage[row].type else no-type
if unit.reading != unit.instance
    = type
do match? tree.nodes[callable]
    | .node-identifier(named)
        . resolution = bindings.resolution-of(binding, callable)
        if resolution.kind == .resolve-member && unit.has-self
            . found = property-of(unit.owner-type, named.name)
            . declared = if found then types.properties[found].type else no-type
            if declared == no-type || facts.plan-of(unit.reading, callable) != .plan-callee
                = declared
            = if types.is-optional(declared) then types.optional-inner(declared) else no-type
        if resolution.kind != .resolve-slot
            = no-type
        if bindings.slots[resolution.slot].kind == .slot-this && unit.has-self
            = unit.owner-type
        . held = slot-held-type(callable, resolution.slot)
        if held != no-type && facts.plan-of(unit.reading, callable) == .plan-callee
            = types.optional-inner(held)
        = held
= no-type

────────────────────
_ do slot-held-type TypeId
    - site SyntaxId
    - slot SlotId

` The type a local, a lazy local, an argument, the item of a loop or a name a pattern binds
` holds where a site names it, as its function gives it or the environment that holds it; none
` for any other.
. kind = bindings.slots[slot].kind
. named = local-or-argument || kind == .slot-loop-item || kind == .slot-pattern
    .. local-or-argument = kind == .slot-local || kind == .slot-argument
if !named && kind != .slot-lazy
    = no-type
if is-captured(slot)
    = find-captured(slot, site).type
if !owns(slot)
    = no-type
if kind == .slot-argument
    = instances.argument-type(unit.instance, argument-position(slot))
= facts.slot-type(unit.instance, slot - unit.slot-start)

────────────────────
_ do emit-callee Typed
    - callable SyntaxId

` The value a call calls, in the type `callee-type` gives it.
. type = callee-type(callable)
if type == no-type || facts.node-type(unit.reading, callable) != no-type
    = emit-expression(callable)
. value = make-operand(.operand-void, 0)
do match? tree.nodes[callable]
    | .node-identifier(row)
        value = emit-identifier(callable, row.name, type).operand
= Typed(value, type)

────────────────────
_ do emit-closure Typed
    - id SyntaxId
    - given TypeId = no-type

` A nested function written as a value: the environment in force where it is written,
` which its body reads the locals it captures from. That is the function's own
` environment, or else the one the function was given, or nothing where it has neither.
` One written in the body of a constructor whose properties read a captured lazy local, or
` made a nested function, has no shape where the constructor declares such a local: see
` `read-shared`. Nor has one made while a constructor gives the properties their values,
` where a nested function reads the receiver: TypeScript gives it a copy of what each
` property was given, which a later change of the property does not reach. One that is the
` value of a lazy local nested functions capture, made by a function written in the one that
` declares the local, as `read-shared` evaluates it there, is the environment that holds
` the local, which is the one in force where it is written; any other made by a function it
` is not written in has no shape, but where the one it is written in keeps no environment, as
` the value of a property is: it is given none. One written in a line of a root `<This` is given
` the environment made for the line (`hold-unit`). One the type pass made of no written function
` is `given` its type.
. type = if given != no-type then given else facts.node-type(unit.reading, id)
. outside = unit.reading != unit.instance
. held = outside && unit.reading == filling.held-unit
. bare = outside && !held && tables.environments[unit.reading] == no-layout
. shared = if outside && !bare && !held then shared-written(id) else no-slot
if unsharable || !is-closure(type) || (!filling.storing && fills-share() && shares-lazy())
    refuse(.refused-expression, id)
    = Typed(make-operand(.operand-void, 0), no-type)
.. unsharable = outside && !bare && !held && shared == no-slot
if filling.storing && !held && shares-receiver()
    refuse(.refused-expression, id)
    = Typed(make-operand(.operand-void, 0), no-type)
if shared != no-slot
    find-captured(shared, id)
    . held = captured-base(id)
    = Typed(held, type)
. written = if bare then integer(.machine-managed-pointer, 0) else if held then load-local(filling.held-environment, id) else written-environment(id)
do match? types.rows[type]
    | .type-closure(row)
        hold-stacks(id, row.decl, written)
. given = kept-cells(id, type, written)
= Typed(given, type)

────────────────────
_ do shared-slot SlotId

` The lazy local whose value is being evaluated by a function written in the one that declares
` it (`read-shared`), where that one has an environment, which holds the local; or none. One
` declared inside that value and evaluated with it, which no environment keeps, is passed over.
if unit.reading == unit.instance || sharing == 0 || lazy-open.length == 0 || no-environment
    = no-slot
.. no-environment = tables.environments[unit.reading] == no-layout
. position = lazy-open.length
while position != 0
    position -= 1
    if is-captured(lazy-open[position])
        = lazy-open[position]
= no-slot

────────────────────
_ do nested-environment Operand
    - id SyntaxId

` The environment a nested function of the instance whose facts are read is given where it is
` written: the one in force, or where a function written in that instance evaluates the value
` of a lazy local it declares, the one that holds the local, which is in force where the value
` is written (`shared-slot`). One made there by an instance with no environment is given none.
if unit.reading == unit.instance
    = written-environment(id)
. shared = shared-slot()
if shared == no-slot
    = integer(.machine-managed-pointer, 0)
find-captured(shared, id)
= captured-base(id)

────────────────────
_ do shared-written SlotId
    - id SyntaxId

` The lazy local a nested function is written as the value of, while a function written in
` the one that declares the local evaluates it, as `read-shared` does; or none. One whose
` function keeps the state of a global `do with` binds has no shape there.
if (shared-depth == 0 && sharing == 0) || lazy-open.length == 0 || tables.holds-stacks(unit.reading)
    = no-slot
. slot = lazy-open[lazy-open.length - 1]
do match? tree.nodes[bindings.slots[slot].group]
    | .node-declare(declaration)
        if declaration.right == id && is-captured(slot)
            = slot
= no-slot

────────────────────
_ do hold-stacks
    - id SyntaxId
    - decl DeclId
    - written Operand

` Where a lambda or a comprehension is made, the function writes into its own environment the
` state of each global `do with` binds that it holds, which one made again in the same run
` writes over, as TypeScript keeps it. One made in a loop whose turn has an environment,
` where TypeScript keeps the state, has no shape for it.
if !tables.holds-stacks(unit.instance)
    =
for position in 0 .. < tables.place-owners.length
    if tables.place-owners[position] == unit.instance && tables.place-decls[position] == decl
        . held = tables.environments[unit.instance]
        if open-turns.length != 0 || unit.environment == no-local || unbuilt-held
            refuse(.refused-expression, id)
            =
        .. unbuilt-held = held == no-layout || held == unbuilt-environment
        . field = tables.layouts.field(held, tables.place-children[position])
        capture-stack(written, field, tables.place-rows[position], id)

────────────────────
_ do is-closure-body Bool

` Whether the function emitted is the body of a lambda or a comprehension, or the steps of one
` that yields.
if unit.instance == no-instance || (function.kind != .instance-body && function.kind != .generator-body)
    = false
. row = instances.rows[unit.instance]
do match? program.modules[row.module].decls[row.decl]
    | .decl-function(fn)
        if fn.kind == .iterator-decl
            do match? program.modules[row.module].tree.nodes[fn.syntax]
                | .node-iterator-expression
                    = true
        = fn.kind == .closure-decl
= false

────────────────────
_ fills-share Bool

` Whether the function is a constructor whose properties, as it gives them their first values,
` read a lazy local nested functions capture or make a nested function, as the type pass
` found.
unit.instance != no-instance && instances.rows[unit.instance].fills-share

────────────────────
_ do shares-lazy Bool

` Whether the function declares a lazy local that nested functions capture.
for offset in 0 .. < unit.slot-count
    . slot = unit.slot-start + offset
    if bindings.slots[slot].kind == .slot-lazy && is-captured(slot)
        = true
= false

────────────────────
_ is-closure Bool
    - type TypeId

type != no-type && type != invalid-type && intrinsic(type) == .closure

────────────────────
_ do shares-receiver Bool

` Whether nested functions capture the receiver of the function.
for offset in 0 .. < unit.slot-count
    . slot = unit.slot-start + offset
    if bindings.slots[slot].kind == .slot-this && is-captured(slot)
        = true
= false

────────────────────
_ do emit-generated-call Typed
    - id SyntaxId
    - fact CallFact
    - written RowRange'SyntaxId

` A call of a function the compiler generates with no arguments declared, whose instance
` takes them as its kind says: a table's constructors, whose filler is named `with`. The
` arguments are evaluated in the order written, each converted as recorded for it, and each
` fills the place the type pass matched it to, which is its own.
. nothing = make-operand(.operand-void, 0)
. callee = fact.callee
. wanted = instances.signatures[callee].args.count
if written.count != wanted || fact.fills.count != wanted
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
for position in 0 .. < fact.fills.count
    if facts.call-fills[fact.fills.start + position] as U32 != position
        refuse(.refused-expression, id)
        = Typed(nothing, no-type)
. mark = pending.length
. start = given.length
. evaluated U32
for argument in tree.children[written]
    . expression = argument-value(argument)
    evaluated += 1
    . made = emit-expression(expression)
    given += Typed(settled(made, expression, written, evaluated), made.type)
for position in 0 .. < written.count
    . site = tree.children[written.start + position]
    . value = convert(site, .reason-argument, given[start + position])
    if value.type != instances.argument-type(callee, position)
        refuse(.refused-conversion, site)
    pending += value.operand
drop-given(start)
. raising = instances.signatures[callee].errors.count != 0
takes-result = raising
. answer = call-instance(callee, id, mark)
takes-result = false
if raising && fact.propagates
    answer = propagate(id, callee, answer.operand)
. expected = facts.node-type(unit.reading, id)
if answer.type != expected && !links-into(id, answer.type, expected)
    refuse(.refused-conversion, id)
= answer

────────────────────
_ do emit-closure-call Typed
    - id SyntaxId
    - fact CallFact
    - callable SyntaxId
    - written RowRange'SyntaxId

` A call of a nested function: of the instance the type pass typed for the arguments
` written. The value called is evaluated first, and is the environment the body is given.
` The arguments follow in the order written, each converted as recorded for it. A binding
` of a nested function is called so too: it holds the function and then the arguments it
` was given, which come before those written. A variadic tail the type pass packed is made
` a list as a function's tail is, once the arguments before it are converted.
. nothing = make-operand(.operand-void, 0)
. callee = fact.callee
if callee == no-instance || fact.is-partial || tables.instance-functions[callee] == no-function
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. tail-first = written.count
. packed = fact.fills.count != 0 && tail-fill == ArgumentFill.fill-variadic
    .. tail-fill = facts.call-fills[fact.fills.start + fact.fills.count - 1] as U32
if packed
    tail-first = fact.fills.count - 1
. closure = emit-callee(callable)
. tuple = closure
. held = void-layout
. bound U32
if is-binding(tuple.type)
    bound = bound-count(tuple.type)
    held = layout-of(tuple.type, callable)
    closure = part(tuple.operand, held, 0, callable)
. wanted = instances.signatures[callee].args.count
. passed = if packed then tail-first + 1 else written.count
if !is-closure(closure.type) || bound + passed != wanted || misfilled
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
.. misfilled = packed && (bound != 0 || tail-first > written.count)
. mark = pending.length
. start = given.length
. evaluated U32
for argument in tree.children[written]
    . expression = argument-value(argument)
    if is-named(argument)
        refuse(.refused-expression, argument)
        break
    evaluated += 1
    . emitted = emit-expression(expression)
    given += Typed(settled(emitted, expression, written, evaluated), emitted.type)
pending += closure.operand
for offset in 0 .. < bound
    . piece = part(tuple.operand, held, 1 + offset, callable)
    pending += piece.operand
    if piece.type != instances.argument-type(callee, offset)
        refuse(.refused-conversion, id)
for position in 0 .. < written.count
    if position >= tail-first
        break
    . site = tree.children[written.start + position]
    . value = convert(site, .reason-argument, given[start + position])
    if value.type != instances.argument-type(callee, bound + position)
        refuse(.refused-conversion, site)
    pending += value.operand
if packed
    . listed = instances.argument-type(callee, tail-first)
    . tail = emit-tail(id, written, 0, start, tail-first, written.count, listed, 0)
    if tail.type != listed
        refuse(.refused-conversion, id)
    pending += tail.operand
drop-given(start)
. raising = instances.signatures[callee].errors.count != 0
takes-result = raising
. answer = call-instance(callee, id, mark)
takes-result = false
if raising && fact.propagates
    answer = propagate(id, callee, answer.operand)
. expected = facts.node-type(unit.reading, id)
if answer.type != expected && !links-into(id, answer.type, expected)
    refuse(.refused-conversion, id)
= answer

────────────────────
_ do runs-as Bool
    - callee InstanceId
    - held U32
    - target TypeId

` Whether an instance takes, after the arguments a binding holds, those of a function type,
` and returns what the type returns: each as it is, or by a conversion the type pass
` recorded for it. A type that returns nothing takes any answer that needs no memory of the
` caller. A type that carries errors returns its value or one of them, which the type pass
` kept for the type.
. fn = function-row(types, target)
if fn == no-type || (carries(fn) && facts.carried-result(fn) == no-type)
    = false
do match? types.rows[fn]
    | .type-function(row)
        . signature = instances.signatures[callee]
        if signature.args.count != held + row.args.count
            = false
        for offset in 0 .. < row.args.count
            . given = types.child-type(row.args, offset)
            . taken = instances.argument-type(callee, held + offset)
            if taken != given && given-conversion == no-fact
                = false
            .. given-conversion = facts.passed-conversion(callee, .reason-argument, given, taken)
        . returns = value-returned(row.return-type)
        if signature.returns == returns || converted != no-fact
            = true
        .. converted = facts.passed-conversion(callee, .reason-return, signature.returns, returns)
        . answered = tables.layouts.values[signature.returns]
        = returns == types.void-type && answered != no-layout && !tables.layouts.is-large(answered)
= false

────────────────────
_ do raises-errors Bool

` Whether an error can leave the function, or what it runs where it is one made for a
` value of a function type: an error raised under it names it in its stack trace, as a
` panic does. One can leave the function of a rule made for a pattern that may raise.
. runs = unit.instance
if function.kind == .adapter
    runs = tables.adapters[function.place].runs
if function.kind == .raising-rule
    = true
= runs != no-instance && instances.signatures[runs].errors.count != 0

────────────────────
_ do carries Bool
    - function TypeId

` Whether a function type carries errors: it declares some, or what it returns is already
` a value or an error.
do match? types.rows[function]
    | .type-function(row)
        if row.errors.count != 0
            = true
        if row.return-type == no-type
            = false
        do match? types.rows[row.return-type]
            | .type-result
                = true
= false

────────────────────
_ do value-returned TypeId
    - returns TypeId

` The value a function type returns: what it returns, the value of that where it is
` already a value or an error, or nothing.
if returns == no-type
    = types.void-type
do match? types.rows[returns]
    | .type-result(held)
        = held.value
= returns

────────────────────
_ do recorded FactId
    - callee InstanceId
    - place SyntaxId
    - reason ConversionReason
    - from TypeId
    - to TypeId

` The conversion the type pass recorded for a function at a place, for a value that a
` function made with no syntax of its own takes from it. No fact where it recorded none.
` One recorded before the function's own nodes were typed is kept apart from them.
. fact = facts.first-conversion(callee, place)
while fact != no-fact
    . row = facts.conversions[fact]
    if row.reason == reason && row.from == from && row.to == to
        = fact
    fact = row.next
. apart = tables.loose-conversion(callee, place, from, reason)
if apart != no-fact && facts.conversions[apart].to == to
    = apart
= no-fact

────────────────────
_ do make-function Typed
    - site SyntaxId
    - row ConversionFact
    - value Operand

` A closure, a binding or a value of another function type made a value of a function
` type: memory in the frame that holds the code the value runs and the data that code is
` given first. The code is the function made for the two types. A closure, which is its
` environment, is the data. A binding's is a copy of the binding that the collector owns,
` or nothing where the binding holds nothing, and a value's is such a copy of the value.
. nothing = make-operand(.operand-void, 0)
. layout = layout-of(row.to, site)
. bare = is-c-function(types, row.to) && is-binding(row.from)
if layout != tables.layouts.function-layout && !bare
    refuse(.refused-conversion, site)
    = Typed(nothing, no-type)
. code = tables.adapter-of(row.from, row.to)
. data = value
if is-binding(row.from) || row.casts
    . held = layout-of(row.from, site)
    data = integer(.machine-managed-pointer, 0)
    if bare && held != void-layout
        code = no-function
    if held != void-layout && code != no-function
        . shape = tables.layouts.rows[held]
        . mark = pending.length
        pending += integer(.machine-u64, shape.size)
        if shape.is-managed
            pending += make-operand(.operand-descriptor, held)
        else
            pending += integer(.machine-pointer, 0)
        data = call-runtime(.runtime-allocate-object, site, mark, managed-layout)
        copy(data, value, held, shape.is-managed, site)
else if !is-closure(row.from)
    code = no-function
if code == no-function
    refuse(.refused-conversion, site)
    = Typed(nothing, no-type)
. target = tables.functions[code]
ir.depend(.callee-function, code, 0)
if bare
    = Typed(make-operand(.operand-symbol, target.symbol), row.to)
. made = frame(layout)
store(made, 0, make-operand(.operand-symbol, target.symbol), false, site)
store(made, tables.layouts.field(layout, 1).offset, data, false, site)
= Typed(made, row.to)

────────────────────
_ do emit-adapter

` The function a closure or a binding runs as a value of a function type. Its first argument is
` the data the value holds and the rest are the type's arguments. A closure's data is its
` environment, which its body is given first. A binding's is a copy of the binding, and what the
` type pass found the binding to call is called on the value the binding calls on, where it
` holds one, an object of the class the function is typed for or one derived from it, with the
` arguments it holds and then the adapter's own; a binding of a nested function holds the
` function, which its body is given first, and a binding of a class's name runs the constructor
` written for the class, as the type pass says the binding calls it. An argument a binding holds
` is given as it is, and one of the adapter's own and the answer are converted as the type pass
` recorded for the function called. The call is made where the value was first made, the place
` a stack trace names, or the line below it where the type pass noted that for a closure; for
` one made in several places a stack trace names no place.
` A binding's runs as a callback, which code the collector does not see may call: it enters
` managed code first and leaves it after the call, and where the call panics. A C function a
` binding names is called as it is, with no marks around the call. A C function type's takes
` no data, so its binding holds nothing, and TypeScript places its call where the type is
` declared.
` A type that carries errors returns its value or one of them: an error what runs gives
` leaves the function made as one raised at the call would, and is one the type carries,
` as the type pass requires.
. row = tables.adapters[function.place]
if row.runs == no-instance
    emit-cast(row)
    =
. callee = row.runs
. closes = is-closure(row.from)
line-shift = if row.below then 1 else 0
. count = if closes then 0 else bound-count(row.from)
. receives = !closes && binds-object(row.from)
. fits = closes
. nests = false
. foreign = false
. constructs = false
do match? types.rows[row.from]
    | .type-binding(shape)
        nests = shape.form == .bound-closure
        foreign = shape.form == .bound-c-function
        constructs = shape.form == .bound-constructor
        fits = nests || foreign || constructs || function-bound || shape.form == .bound-method
            .. function-bound = shape.form == .bound-function
. owner = instances.rows[callee]
. written = constructs && owner.bound-call == .bound-call-constructor
. named = !constructs && matches
    .. matches = owner.bound-call == (if receives then .bound-call-method else .bound-call-function)
fits = fits && (closes || nests || foreign || written || named)
. held = tables.layouts.values[row.from]
. symbol = if foreign then tables.c-symbols[callee] else no-string
. emitted = tables.instance-functions[callee] != no-function || tables.is-prototype(callee)
if foreign
    emitted = symbol != no-string && tables.c-suspends[callee] == 0 && undescribed
        .. undescribed = tables.c-described[callee] == no-runtime-function
if !fits || held == no-layout || !runs-as(callee, count, row.to) || !emitted
    refuse-own()
    =
. bare = is-c-function(types, row.to)
if bare && (closes || held != void-layout)
    refuse-own()
    =
if !bare
    ir.add-argument(managed-layout)
. site = row.site
if bare
    ir.signals = false
    site = c-type-site(row.to)
    if site == 0
        refuse-own()
        =
do match? types.rows[function-row(types, row.to)]
    | .type-function(shape)
        for offset in 0 .. < shape.args.count
            ir.add-argument(layout-of(types.child-type(shape.args, offset), 0))
        returns-type = value-returned(shape.return-type)
ir.returns = layout-of(returns-type, 0)
. target = function-row(types, row.to)
. carried = if carries(target) then facts.carried-result(target) else no-type
if carried != no-type
    return-results(carried, 0)
. raising = !foreign && instances.signatures[callee].errors.count != 0
. answers = void-layout
if foreign
    answers = layout-of(instances.signatures[callee].returns, 0)
. data = make-operand(.operand-argument, 0)
. first U32 = if bare then 0 else 1
. mark = pending.length
. place U32
if !closes
    in-callback = true
    foreign-callback = bare
    call-runtime(callback-entry(), 0, pending.length)
if closes
    pending += data
if receives
    . piece = part(data, held, 0, 0)
    pending += piece.operand
    place = 1
    . derived = tables.is-class(piece.type) && tables.derives(piece.type, owner.self-type)
    if piece.type != owner.self-type && !nests && !derived
        refuse-own()
for offset in 0 .. < count
    . kept = part(data, held, place + offset, 0)
    . taken = instances.argument-type(callee, offset)
    if kept.type != taken
        kept = convert-passed(callee, .reason-argument, site, kept, taken)
    pending += kept.operand
for position in count .. < instances.signatures[callee].args.count
    . own = Typed(make-operand(.operand-argument, first + position - count), own-type(row.to, position - count))
    . taken = instances.argument-type(callee, position)
    if own.type != taken
        own = convert-passed(callee, .reason-argument, site, own, taken)
    pending += own.operand
. answer = make-operand(.operand-void, 0)
if foreign
    ir.depend(.callee-c, symbol, 0)
    answer = call(make-operand(.operand-symbol, symbol), site, mark, .callee-c, answers)
else if receives && !nests
    takes-result = raising
    answer = call-method(callee, site, mark).operand
    takes-result = false
else
    takes-result = raising
    answer = call-instance(callee, site, mark).operand
    takes-result = false
if raising
    answer = propagate(site, callee, answer).operand
if !closes
    call-runtime(callback-exit(), 0, pending.length)
if returns-type == types.void-type
    return-value(make-operand(.operand-void, 0), 0)
    =
if instances.signatures[callee].returns != returns-type
    answer = convert-passed(callee, .reason-return, site, Typed(answer, instances.signatures[callee].returns), returns-type).operand
return-value(answer, 0)

────────────────────
_ callback-entry RuntimeFunction

if foreign-callback then .runtime-enter-foreign-callback else .runtime-enter-callback

────────────────────
_ callback-exit RuntimeFunction

if foreign-callback then .runtime-leave-foreign-callback else .runtime-leave-callback

────────────────────
_ do c-type-site SyntaxId
    - type TypeId

` Where a C function type is declared, which is where the reference places the call of a
` function made a value of it: the syntax of the class first declared as the type, with the
` module that holds it the one read. None where the type is written where it is used.
. declared = types.c-function-decl(type)
if !declared
    = 0
do match? program.modules[declared.module].decls[declared.decl]
    | .decl-class(class)
        unit = unit.source-module = declared.module
        = class.syntax
= 0

────────────────────
_ do emit-cast
    - row Adapter

` The function a value of one function type runs as a value of another. Its first argument
` is the data the value holds, a copy of the first value, and the rest are the second
` type's arguments. It calls the code the copy holds with the data that holds and each
` argument as the first type takes it, and answers as the second type does, each converted
` as the type pass recorded for the two types. What runs is not known here, so the call is
` checked for a panic. It is made where the value is first made, the place a stack trace
` names, or where the type pass kept a place for the two types. Where the first type
` carries errors the second does, and an error the code gives leaves the function made as
` the second type's value or error holds it.
. taken = RowRange'TypeId()
. given = RowRange'TypeId()
. answered = types.void-type
. plain = false
. source = function-row(types, row.from)
. target = function-row(types, row.to)
do match? types.rows[source]
    | .type-function(shape)
        taken = shape.args
        plain = !shape.is-c
        answered = value-returned(shape.return-type)
do match? types.rows[target]
    | .type-function(shape)
        given = shape.args
        plain = plain && !shape.is-c
        returns-type = value-returned(shape.return-type)
. gives = if plain && carries(source) then facts.carried-result(source) else no-type
. makes = if plain && carries(target) then facts.carried-result(target) else no-type
if plain && ((carries(source) && gives == no-type) || (carries(target) && makes == no-type))
    plain = false
if !plain || taken.count != given.count || (gives != no-type && makes == no-type)
    refuse-own()
    =
ir.add-argument(managed-layout)
for offset in 0 .. < given.count
    ir.add-argument(layout-of(types.child-type(given, offset), 0))
ir.returns = layout-of(returns-type, 0)
if makes != no-type
    return-results(makes, 0)
. answers = layout-of(given-type, 0)
    .. given-type = if gives == no-type then answered else gives
. held = make-operand(.operand-argument, 0)
. code = load(held, 0, pointer-layout, row.site)
. mark = pending.length
pending += load
    - held
    - tables.layouts.field(tables.layouts.function-layout, 1).offset
    - managed-layout
    - row.site
for offset in 0 .. < given.count
    . own = make-operand(.operand-argument, 1 + offset)
    . wanted = types.child-type(taken, offset)
    if types.child-type(given, offset) != wanted
        own = convert-cast(row, .reason-argument, Typed(own, types.child-type(given, offset)), wanted).operand
    pending += own
. answer = call(code, row.site, mark, .callee-value, answers, true)
if gives != no-type
    answer = propagate-held(row.site, gives, answer).operand
if returns-type == types.void-type
    return-value(make-operand(.operand-void, 0), 0)
    =
if answered != returns-type
    answer = convert-cast(row, .reason-return, Typed(answer, answered), returns-type).operand
return-value(answer, 0)

────────────────────
_ do convert-cast Typed
    - row Adapter
    - reason ConversionReason
    - value Typed
    - to TypeId

` A value the function made for two function types gives the code it runs, or what that
` code answered, converted by the conversion the type pass recorded for the two types. One
` it recorded none for has no shape.
. fact = facts.cast-conversion(row.from, row.to, reason, value.type, to)
if fact == no-fact
    refuse-own()
    = value
= convert-one(row.site, facts.conversions[fact], value)

────────────────────
_ do own-type TypeId
    - target TypeId
    - offset U32

` The type of an argument of a function type.
do match? types.rows[function-row(types, target)]
    | .type-function(shape)
        = types.child-type(shape.args, offset)
= no-type

────────────────────
_ do emit-value-call Typed
    - id SyntaxId
    - callable SyntaxId
    - written RowRange'SyntaxId

` A call of a value of a function type: of the code it holds, given the data it holds and
` then an argument for each place the type declares, each converted to what the type
` declares for the place. The value is read first, and the arguments are evaluated in the
` order written; the type pass recorded which of them fills each place. A binding of such a
` value holds the value and then the arguments it was given, each in its place, and those
` fill the places nothing written does. What runs is not known here, so the call is checked
` for a panic, which the type pass has said of the caller. A type that carries errors
` answers with its value or one of them, as the type pass kept for the type: under `catch`
` that is the call's value, and elsewhere an error leaves the function at the call. A C
` function's has no shape yet. A generator called for its next item answers the type the
` type pass gave the call, an optional of an item, or that or an error, as the type pass
` kept for the generator's type where it carries errors.
. nothing = make-operand(.operand-void, 0)
. shape = callee-type(callable)
. binding = if is-binding(shape) then shape else no-type
if binding != no-type
    shape = bound-object(binding)
. args = RowRange'TypeId()
. returns = types.void-type
. plain = false
. c = false
. fn = if shape == no-type || shape == invalid-type then no-type else function-row(types, shape)
if fn != no-type
    do match? types.rows[fn]
        | .type-function(row)
            args = row.args
            plain = !row.is-c
            c = row.is-c
            returns = value-returned(row.return-type)
if c && binding == no-type
    = emit-c-value-call(id, callable, written, args, returns)
. steps = facts.plan-of(unit.reading, id) == .plan-step
. carried = no-type
if plain && carries(fn)
    carried = if steps then facts.carried-result(shape) else facts.carried-result(fn)
    plain = carried != no-type
if steps
    returns = facts.node-type(unit.reading, id)
. fact = own-call(id)
. fills = RowRange'ArgumentFill()
if fact != no-fact
    fills = facts.calls[fact].fills
if !plain || fills.count != args.count || in-zone || (!function.may-panic && !in-landing)
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. source = emit-callee(callable)
. tuple = source
. held = void-layout
if binding != no-type
    held = layout-of(binding, callable)
    source = part(tuple.operand, held, 0, callable)
. layout = layout-of(source.type, callable)
if layout != tables.layouts.function-layout
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. code = load(source.operand, 0, pointer-layout, id)
. data = load(source.operand, tables.layouts.field(layout, 1).offset, managed-layout, id)
. mark = pending.length
. start = given.length
. evaluated U32
for argument in tree.children[written]
    . expression = argument-value(argument)
    evaluated += 1
    . emitted = emit-expression(expression)
    given += Typed(settled(emitted, expression, written, evaluated), emitted.type)
pending += data
. empty U32 = ArgumentFill.fill-empty
for place in 0 .. < args.count
    . fill = facts.call-fills[fills.start + place] as U32
    . declared = types.child-type(args, place)
    . value = Typed(nothing, no-type)
    . site = id
    if fill != empty && fill < written.count
        site = tree.children[written.start + fill]
        value = convert(site, .reason-argument, given[start + fill])
    else if fill == empty && binding != no-type
        value = part(tuple.operand, held, 1 + place, id)
        if value.type != declared
            value = convert-held(id, value, declared)
    else
        refuse(.refused-expression, id)
    if value.type != declared
        refuse(.refused-conversion, site)
    pending += value.operand
drop-given(start)
. answered = if carried == no-type then returns else carried
. result = Typed(call(code, id, mark, .callee-value, layout-of(answered, id), !in-landing), answered)
if carried != no-type && fact != no-fact && facts.calls[fact].propagates
    result = propagate-held(id, carried, result.operand)
if result.type != facts.node-type(unit.reading, id) && !links-into(id, result.type, facts.node-type(unit.reading, id))
    refuse(.refused-conversion, id)
= result

────────────────────
_ do emit-c-value-call Typed
    - id SyntaxId
    - callable SyntaxId
    - written RowRange'SyntaxId
    - args RowRange'TypeId
    - returns TypeId

` A call of a value of a C function's type: of the address it holds, given an argument for
` each place the type declares, converted to what the type declares for it, evaluated in the
` order written. What runs is not known here, so the call is checked for a panic as the
` reference checks a call of any value, and the function there gives the signal.
. nothing = make-operand(.operand-void, 0)
. fact = own-call(id)
. fills = if fact != no-fact then facts.calls[fact].fills else RowRange'ArgumentFill()
if fills.count != args.count || in-zone || (!function.may-panic && !in-landing)
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. source = emit-callee(callable)
if !is-pointer(layout-of(source.type, callable))
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. start = given.length
. evaluated U32
for argument in tree.children[written]
    . expression = argument-value(argument)
    evaluated += 1
    . emitted = emit-expression(expression)
    given += Typed(settled(emitted, expression, written, evaluated), emitted.type)
. mark = pending.length
. empty U32 = ArgumentFill.fill-empty
for place in 0 .. < args.count
    . fill = facts.call-fills[fills.start + place] as U32
    . declared = types.child-type(args, place)
    if fill == empty || fill >= written.count
        refuse(.refused-expression, id)
        break
    . site = tree.children[written.start + fill]
    . value = convert(site, .reason-argument, given[start + fill])
    if value.type != declared
        refuse(.refused-conversion, site)
    pending += value.operand
drop-given(start)
. result = call(source.operand, id, mark, .callee-value, layout-of(returns, id), !in-landing)
if returns != facts.node-type(unit.reading, id)
    refuse(.refused-conversion, id)
= Typed(result, returns)

────────────────────
_ do filled-type TypeId
    - fact CallFact
    - callee InstanceId
    - given U32

` The type the callee takes for the place one of the arguments given fills, or no type
` where it fills none.
for position in 0 .. < fact.fills.count
    if (facts.call-fills[fact.fills.start + position] as U32) == given
        = instances.argument-type(callee, position)
= no-type

────────────────────
_ do convert-held Typed
    - site SyntaxId
    - value Typed
    - declared TypeId

` An argument a binding of a value held, converted to what the value's type declares for its
` place: by the conversion the type pass recorded at the call for the two types.
. fact = facts.first-conversion(unit.reading, site)
while fact != no-fact
    . row = facts.conversions[fact]
    if row.reason == .reason-argument && row.from == value.type && row.to == declared
        = convert-one(site, row, value)
    fact = row.next
refuse(.refused-conversion, site)
= value

────────────────────
_ do bound-object TypeId
    - type TypeId

` The type of the value a binding of a value of a function type holds and calls, or no type
` for any other binding.
do match? types.rows[type]
    | .type-binding(row)
        if row.form == .bound-value
            = row.object
= no-type

────────────────────
_ do holds-callee Bool
    - type TypeId

` Whether a binding holds what it calls: a nested function, or a value of a function type.
do match? types.rows[type]
    | .type-binding(row)
        = row.form == .bound-closure || row.form == .bound-value
= false

────────────────────
_ is-binding Bool
    - type TypeId

` Whether a type is a binding: a function, a method or a constructor named, with the
` arguments given it so far.
type != no-type && type != invalid-type && intrinsic(type) == .binding

────────────────────
_ do binds-object Bool
    - type TypeId

` Whether a binding holds a value it calls on, or calls: the receiver of a method, a
` closure, or a value of a function type. A constructor's binding names its class and holds
` nothing for it.
do match? types.rows[type]
    | .type-binding(row)
        = row.object != no-type && row.form != .bound-constructor
= false

────────────────────
_ do bound-count U32
    - type TypeId

` How many arguments a binding holds.
do match? types.rows[type]
    | .type-binding(row)
        = row.items.count - row.param-count
= 0

────────────────────
_ do part Typed
    - source Operand
    - layout LayoutId
    - position U32
    - syntax SyntaxId

` What a binding holds at a place: a field of the tuple it is, read with the field's type.
` One with no size holds only values of no size.
if layout == void-layout
    = Typed(make-operand(.operand-void, 0), types.void-type)
. field = tables.layouts.field(layout, position)
. value = take(source, field, syntax)
= Typed(value, field.type)

────────────────────
_ do name-binding Typed
    - id SyntaxId
    - type TypeId
    - object SyntaxId

` A function or a method read as a value: a binding that holds no argument yet, but for a
` method the defaults the type pass bound, as `put-defaults` gives them. A method's holds the
` value it is read from, or with none written the receiver of the function the name is read
` in, which for a value written for the receiver's class is the object it is evaluated for. A
` function's holds nothing, and has no size.
. nothing = make-operand(.operand-void, 0)
. layout = layout-of(type, id)
. defaults = bound-count(type)
if defaults != 0 && !binds-object(type)
    refuse(.refused-expression, id)
if !binds-object(type)
    if object != 0
        emit-expression(object)
    = Typed(nothing, type)
. value = Typed(unit.self, unit.owner-type)
if object != 0
    value = emit-expression(object)
else if unit.has-self && unit.reading != unit.instance && evaluates-value() && filling.count == 0
    value = Typed(unit.self, unit.self-type)
else if !unit.has-self || unit.reading != unit.instance
    refuse(.refused-expression, id)
if layout == void-layout
    = Typed(nothing, type)
. field = tables.layouts.field(layout, 0)
if tables.layouts.rows[layout].fields.count != 1 + defaults || value.type != field.type
    refuse(.refused-conversion, id)
    = Typed(nothing, no-type)
. made = frame(layout)
put(made, field, value.operand, id)
put-defaults(id, made, layout, defaults)
= Typed(made, type)

────────────────────
_ do put-defaults
    - id SyntaxId
    - made Operand
    - layout LayoutId
    - defaults U32

` Stores in a binding of a method read as a value the defaults the type pass bound, from the
` second field on: each evaluated here in order, as a call that leaves it out evaluates it, of
` the method the type pass recorded at the read as called so.
if defaults == 0
    =
. fact = own-call(id)
if fact == no-fact || facts.calls[fact].form != .call-method
    refuse(.refused-expression, id)
    =
. callee = facts.calls[fact].callee
for position in 0 .. < defaults
    . taken = tables.layouts.field(layout, position + 1)
    . given = default-argument
        - id
        - callee
        - parameter-default(callee, position)
        - instances.argument-type(callee, position)
    if given.type != taken.type
        refuse(.refused-conversion, id)
        =
    put(made, taken, given.operand, id)

────────────────────
_ do emit-bind Typed
    - id SyntaxId
    - callable SyntaxId
    - written RowRange'SyntaxId

` A call given too few arguments, which gives a binding: a tuple in the frame of what it
` holds. A binding called so is copied first, field by field. Else the value the new one
` calls on is evaluated: the object a method is read from, or the receiver of the function
` the call is in where none is written, or the nested function or the value of a function
` type that is called. Then the arguments written are evaluated in order and stored as they
` are: one after another, or for a value of a function type each in the place the type pass
` recorded for it, where a place nothing fills holds nothing.
. nothing = make-operand(.operand-void, 0)
. type = facts.node-type(unit.reading, id)
. layout = layout-of(type, id)
. sized = layout != void-layout
. count U32 = if sized then tables.layouts.rows[layout].fields.count else 0
. made = if sized then frame(layout) else nothing
. place U32
. extended = callee-type(callable)
if is-binding(extended)
    . source = emit-callee(callable)
    . held = layout-of(extended, callable)
    . copied U32 = bound-count(extended) + (if binds-object(extended) then 1 else 0)
    for offset in 0 .. < copied
        . value = part(source.operand, held, offset, callable)
        if sized && value.type != types.void-type
            if place >= count || value.type != tables.layouts.field(layout, place).type
                refuse(.refused-conversion, id)
                = Typed(nothing, no-type)
            put(made, tables.layouts.field(layout, place), value.operand, id)
        place += 1
else if binds-object(type)
    . value = Typed(nothing, no-type)
    if holds-callee(type)
        value = emit-callee(callable)
    else
        do match tree.nodes[callable]
            | .node-get-expression(get)
                value = emit-expression(get.object)
            | .node-identifier
                if unit.has-self && unit.reading == unit.instance
                    value = Typed(unit.self, unit.owner-type)
                else
                    refuse(.refused-expression, id)
            ??
                refuse(.refused-expression, id)
    if !sized || value.type != tables.layouts.field(layout, 0).type
        refuse(.refused-conversion, id)
        = Typed(nothing, no-type)
    put(made, tables.layouts.field(layout, 0), value.operand, id)
    place = 1
. fills = RowRange'ArgumentFill()
. placed = bound-object(type) != no-type
if placed
    . binds = own-call(id)
    if binds == no-fact || !facts.calls[binds].is-partial || !sized
        refuse(.refused-expression, id)
        = Typed(nothing, no-type)
    fills = facts.calls[binds].fills
. position U32
for argument in tree.children[written]
    . expression = argument
    do match? tree.nodes[argument]
        | .node-argument(named)
            if named.name && !placed
                refuse(.refused-expression, argument)
            expression = named.expr
    if placed
        place = count
        for index in 0 .. < fills.count
            if (facts.call-fills[fills.start + index] as U32) == position
                place = 1 + index
    position += 1
    . value = emit-expression(expression)
    if sized
        if place >= count || value.type != tables.layouts.field(layout, place).type
            refuse(.refused-conversion, expression)
            = Typed(nothing, no-type)
        put(made, tables.layouts.field(layout, place), value.operand, expression)
    else if value.type != types.void-type
        refuse(.refused-conversion, expression)
        = Typed(nothing, no-type)
    place += 1
if sized && place != count && !placed
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
= Typed(made, type)

────────────────────
_ do emit-converting Typed
    - id SyntaxId
    - callee InstanceId
    - argument SyntaxId
    - propagates Bool

` A call of a type with one value that a function the type declares converts from. The value
` takes the conversion recorded for it, and the function answers. Where the function raises
` errors, they leave the function with the call where the type pass said so, and are panics
` where the value is a text written in source. Under `catch` the call gives what the function
` returned, its value or its error.
. nothing = make-operand(.operand-void, 0)
. expression = argument
do match? tree.nodes[argument]
    | .node-argument(named)
        expression = named.expr
. value = convert(argument, .reason-argument, emit-expression(expression))
if value.type != instances.argument-type(callee, 0)
    refuse(.refused-conversion, argument)
    = Typed(nothing, no-type)
. raising = instances.signatures[callee].errors.count != 0
. mark = pending.length
pending += value.operand
takes-result = raising
. made = call-method(callee, id, mark)
takes-result = false
if raising && propagates
    made = propagate(id, callee, made.operand)
else if raising && facts.plan-of(unit.reading, id) == .plan-literal-conversion
    made = panic-on-error(id, callee, made.operand)
if made.type != facts.node-type(unit.reading, id)
    refuse(.refused-conversion, id)
= made

────────────────────
_ do emit-construct Typed
    - id SyntaxId
    - fact CallFact
    - written RowRange'SyntaxId
    - answers TypeId
    - bound SyntaxId = 0
    - leading SyntaxId = 0

` A tuple or struct made by its fields. A call of a binding evaluates the binding first, and
` its arguments come before those written, as does the `leading` value a call is given before
` them. The arguments are evaluated in the order they are written, and then each takes the
` conversion recorded for it: one the binding holds, that recorded at the call for its type and
` that of the field it fills. Each field is given the argument the type pass matched to it, or
` its first value when the call leaves it out.
` What is made has the node's type, or `answers` for a call that no node writes. It is made in
` place, where TypeScript calls the constructor it generates, as the IR notes.
. nothing = make-operand(.operand-void, 0)
. type = instances.rows[fact.callee].self-type
. layout = layout-of(type, id)
. start = given.length
. lead U32
if bound != 0
    . source = emit-callee(bound)
    . shape = source.type
    . held = layout-of(shape, bound)
    if binds-object(shape)
        refuse(.refused-expression, id)
    lead = bound-count(shape)
    for offset in 0 .. < lead
        . piece = part(source.operand, held, offset, bound)
        given += piece
if leading != 0
    lead = 1
    . emitted = emit-expression(leading)
    given += Typed(settled(emitted, leading, written, 0), emitted.type)
. evaluated U32
for argument in tree.children[written]
    . expression = argument
    do match? tree.nodes[argument]
        | .node-argument(named)
            expression = named.expr
    evaluated += 1
    . emitted = emit-expression(expression)
    given += Typed(settled(emitted, expression, written, evaluated), emitted.type)
for position in 0 .. < lead
    if leading != 0
        . converted = convert(leading, .reason-argument, given[start + position])
        given[start + position] = converted
        continue
    . wanted = filled-field-type(type, fact.fills, position)
    if wanted != no-type && given[start + position].type != wanted
        . converted = convert-held(id, given[start + position], wanted)
        given[start + position] = converted
for position in 0 .. < written.count
    . site = tree.children[written.start + position]
    . converted = convert(site, .reason-argument, given[start + lead + position])
    given[start + lead + position] = converted
. own-making = making
making = making.callee = fact.callee
. made = make-fields(type, layout, fact.fills, start, lead + written.count, id)
making = own-making
ir.note-made-call()
drop-given(start)
. expected = if answers != no-type then answers else facts.node-type(unit.reading, id)
if type != expected
    refuse(.refused-conversion, id)
= Typed(made, type)

────────────────────
_ do filled-field-type TypeId
    - type TypeId
    - fills RowRange'ArgumentFill
    - given U32

` The type of the field of a tuple or struct one of the arguments given fills, or no type
` where it fills none.
. range = types.completions[type].properties
. position U32
for offset in 0 .. < range.count
    . property = types.properties[range.start + offset]
    if property.slot == U32.max
        continue
    if position < fills.count && (facts.call-fills[fills.start + position] as U32) == given
        = property.type
    position += 1
= no-type

────────────────────
_ do make-fields Operand
    - type TypeId
    - layout LayoutId
    - fills RowRange'ArgumentFill
    - start Size
    - count U32
    - syntax SyntaxId

` Memory in the frame for a tuple or struct, with each field stored in turn: the argument
` held from `start` on that fills it, or its first value. Every argument fills one field.
. nothing = make-operand(.operand-void, 0)
if !tables.layouts.is-struct(layout)
    refuse(.refused-type, syntax)
    = nothing
. memory = frame(layout)
. range = types.completions[type].properties
. outer = making
making = Making(memory, type, layout, syntax, made.length, false, making.callee, making.default-holder)
for _ in 0 .. < range.count
    made += 0
. position U32
. placed U32
for offset in 0 .. < range.count
    . property = types.properties[range.start + offset]
    if property.slot == U32.max
        continue
    if property.storage-kind != .storage-eager
        refuse(.refused-type, syntax)
        break
    . fill U32 = ArgumentFill.fill-empty
    if position < fills.count
        fill = facts.call-fills[fills.start + position]
    position += 1
    if fill == ArgumentFill.fill-empty
        continue
    if fill >= count || given[start + fill].type != property.type
        refuse(.refused-conversion, syntax)
    else
        put(memory, tables.layouts.field(layout, property.slot), given[start + fill].operand, syntax)
        made[making.mark + offset] = 2
        placed += 1
for offset in 0 .. < range.count
    make-field(offset)
while made.length > making.mark
    made.pop()
making = outer
if placed != count
    refuse(.refused-expression, syntax)
= memory

────────────────────
_ do emit-range Typed
    - id SyntaxId
    - range ASTRangeExpression

` A range written as a value: the tuple of its start, its end, the step written or else
` one, and whether it runs through its end, made by its fields as the construction the type
` pass recorded says. The step of one and the truth of `..` are the literal's own, as
` TypeScript gives them, not the defaults `Range` declares. Each number is converted to the
` range's item as recorded, and so is the step of one where the item is no number. A range
` with a side left open, or of a type that declares a constructor, has no shape here.
. nothing = make-operand(.operand-void, 0)
. fact = own-call(id)
. type = facts.node-type(unit.reading, id)
if fact == no-fact || range.left == 0 || range.right == 0 || type == no-type || type == invalid-type
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. layout = layout-of(type, id)
if !tables.layouts.is-struct(layout) || tables.writes-constructor(type)
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. item = tables.layouts.field(layout, 0).type
. counted = layout-of(item, id)
. start = given.length
. edge = convert(range.left, .reason-element, emit-expression(range.left))
given += edge
edge = convert(range.right, .reason-element, emit-expression(range.right))
given += edge
if range.increment != 0
    edge = convert(range.increment, .reason-element, emit-expression(range.increment))
    given += edge
else if is-integer(counted)
    given += Typed(integer(tables.layouts.kind-of(counted), 1), item)
else if is-float(counted)
    given += Typed(float-number(counted, 1.0), item)
else
    edge = convert(id, .reason-step, Typed(integer(.machine-i64, 1), types.type-row(.int64)))
    given += edge
    if edge.type != item
        refuse(.refused-expression, id)
. count U32 = 3
if range.op == .range-through-op
    given += Typed(integer(.machine-u8, 1), types.bool-type)
    count = 4
. made = nothing
made = make-fields(type, layout, facts.calls[fact].fills, start, count, id)
drop-given(start)
= Typed(made, type)

────────────────────
_ do make-field
    - offset U32

` Gives one field of the tuple or struct being made its first value, unless it has it: in
` the constructor of what is made the argument of the field's name, or the lazy local of its
` name, converted as the type pass recorded where it is written, or else the value its type
` writes for it, or the zero of its type. A field whose value is being evaluated has no value
` to read.
. state = made[making.mark + offset]
. place = types.completions[making.type].properties.start + offset
. property = types.properties[place]
if state == 2 || property.slot == U32.max
    =
if state == 1 || property.storage-kind != .storage-eager
    refuse(.refused-type, making.site)
    =
made[making.mark + offset] = 1
. site = making.site
. memory = making.memory
. field = tables.layouts.field(making.layout, property.slot)
. fill = if making.own then tables.fill-of(unit.instance, property.name) else no-fact
if fill == no-fact
    . value = first-value(property, place, making.type, field.layout, site)
    put(memory, field, value.operand, site)
else
    . fact = facts.fills[fill]
    . kind = if is-own-slot(fact.slot) then bindings.slots[fact.slot].kind else SlotKind.slot-local
    if kind != .slot-argument && kind != .slot-lazy
        refuse(.refused-function, site)
        =
    . given = Typed(make-operand(.operand-void, 0), no-type)
    if kind == .slot-lazy
        . held = facts.slot-type(unit.instance, slot-offset(fact.slot, site))
        given = Typed(read-lazy-local(fact.slot, site, held).operand, held)
    else
        . position = argument-position(fact.slot)
        given = Typed(make-operand(.operand-argument, position), instances.argument-type(unit.instance, position))
    . given-value = convert-fill(fact.site, given)
    if given-value.type != property.type
        refuse(.refused-conversion, site)
    put(memory, field, given-value.operand, site)
made[making.mark + offset] = 2

────────────────────
_ do read-made Typed
    - id SyntaxId
    - name Atom

` A field of the tuple or struct being made, read by the value its type writes for another.
` A field with no value yet is given its own first, which is the order TypeScript evaluates
` them in. One first read under a condition would have its value on one path alone, so only
` a value the type pass found to evaluate every part of itself may read one.
. nothing = make-operand(.operand-void, 0)
. found = property-of(making.type, name)
. range = types.completions[making.type].properties
if !found || (found as U32) < range.start || (found as U32) >= range.start + range.count
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. offset = (found as U32) - range.start
. property = types.properties[found]
if property.slot == U32.max || property.storage-kind != .storage-eager
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
if made[making.mark + offset] != 2
    if instances.rows[unit.reading].branches
        refuse(.refused-expression, id)
        = Typed(nothing, no-type)
    make-field(offset)
= Typed(take(making.memory, tables.layouts.field(making.layout, property.slot), id), property.type)

────────────────────
_ do first-value Typed ?! Refused
    - property TypeProperty
    - place U32
    - owner TypeId
    - layout LayoutId
    - syntax SyntaxId

` A property's first value: the one its class writes, read through the facts of the
` instance that types it for the type that holds the property, or else the zero of its
` type: no bits set, the empty text, or a named tuple or struct whose own fields have their
` first values. A tuple with no name and an optional have no bits set, whatever they hold,
` but for the empty text wherever they hold a text. A value the type pass typed for no such
` type has no shape. A property that holds an object and has no value written is given the
` object the type pass constructs for it: the call it recorded at the property for the
` constructor being emitted, or for the generated constructor of the tuple or struct being
` built where it is called. So is one that holds a named tuple or struct, where that call is
` of a constructor written in source; where the type declares one and no call is recorded
` here, the value has no shape. Where the call is of a generated constructor, the fields are
` made here with the first values that constructor gives them. A state machine a property
` holds is started later (see `start-member-machine`), and the property holds the first case of
` its union until then. One that holds an object and that a markup element's name or a line of the
` class's markup declares (`content-property`) holds none until the markup gives it one.
. default = tables.default-of(owner, place)
if default.value != 0
    . unit-id = tables.value-unit(place)
    if unit-id == no-instance
        refuse(.refused-expression, syntax)
        = Typed(make-operand(.operand-void, 0), no-type)
    . machine = member-machine(default.module, default.value)
    if machine
        = machine-default(facts.root-machine(machine), syntax)
    . own-unit = unit
    . own-filling = filling
    unit = unit.source-module = default.module
    . holds = holds-locals(unit-id, default.value, default.site)
    if holds
        fill-value-reads(unit-id)
    . run = enter-unit(unit-id) if holds
    if run
        filling = filling.storing = false
        make-subscribers(default.value)
    unit = unit.reading = unit-id
    filling = filling.root = default.value
    if tables.environments[unit-id] != no-layout
        hold-unit(unit-id, default.site, syntax)
    . value = emit-expression(default.value)
    filling = own-filling
    . fact = facts.first-conversion(unit.reading, default.site)
    while fact != no-fact && value.type != property.type
        . row = facts.conversions[fact]
        if row.reason == .reason-declaration && row.from == value.type
            value = convert-one(default.site, row, value)
        fact = row.next
    if run
        leave-unit(run)
    unit = own-unit
    if value.type != property.type
        refuse(.refused-conversion, syntax)
    = value
if default.decl != 0
    do match? program.modules[default.module].decls[default.decl]
        | .decl-property(written)
            if written.element != 0 || (written.line != 0 && intrinsic(property.type) == .class)
                = Typed(integer(tables.layouts.kind-of(layout), 0), property.type)
if property.type == types.string-type
    = Typed(make-operand(.operand-constant, ir.add-string("")), property.type)
if intrinsic(property.type) == .class
    . fact = default-construction(owner, default)
    if fact == no-fact
        refuse(.refused-type, syntax)
        = Typed(make-operand(.operand-void, 0), no-type)
    = construct-default(default, fact, property.type)
if tables.layouts.is-struct(layout)
    if is-aggregate(property.type) && !is-plain-tuple(property.type)
        . fact = default-construction(owner, default)
        . constructs = fact != no-fact
        if constructs && !tables.builds-in-frame(facts.calls[fact].callee)
            = construct-default(default, fact, property.type)
        if !constructs && tables.writes-constructor(property.type)
            refuse(.refused-type, syntax)
            = Typed(make-operand(.operand-void, 0), no-type)
        . own-making = making
        if constructs
            making = making.callee = facts.calls[fact].callee
        . made = make-fields
            - property.type
            - layout
            - RowRange'ArgumentFill()
            - given.length
            - 0
            - syntax
        making = own-making
        = Typed(made, property.type)
    = null-value(property.type, layout, syntax)
. kind = tables.layouts.kind-of(layout)
if kind == .machine-void
    = Typed(make-operand(.operand-void, 0), property.type)
= Typed(integer(kind, 0), property.type)

────────────────────
_ do fill-value-reads
    - unit-id InstanceId

` Gives each stored property of the object being made that a value with locals of its own reads
` its first value before the value runs, as a read gives it one (`read-filled`). The value runs as
` an instance of its own (`enter-unit`), where a read cannot give the constructor's properties
` their values.
=? if !filling.storing || filling.count == 0
. read = tables.first-read(unit-id)
while read != no-fact
    . found = property-read(filling.type, read)
    if found
        . position = (found as U32) - filling.start
        . eager = types.properties[found].storage-kind == .storage-eager
        if eager && position < filling.count && filling.filled[position] == 0 && !facts.defers(unit.instance, found as U32)
            . own-unit = unit
            . own-filling = filling
            unit = unit.source-module = function.module
            unit = unit.reading = unit.instance
            store-property(position, 0)
            unit = own-unit
            filling = own-filling
    read = tables.next-read(read)

────────────────────
_ do hold-unit
    - unit-id InstanceId
    - property SyntaxId
    - syntax SyntaxId

` Makes the environment of a line of a root `<This` whose closures read the object, as those
` the class's markup writes read it: no link, then the object being made, which the closures
` written in the value are given while it is evaluated. One that keeps anything else has no
` shape here.
. layout = tables.environments[unit-id]
. binding = instances.rows[unit-id].binding
if layout == unbuilt-environment || binding == no-binding || !unit.has-self || unpaired
    refuse(.refused-function, syntax)
    =
.. unpaired = tables.layouts.rows[layout].fields.count != 2
. bound = bindings.window-of(binding, property)
. home = tables.instance-scopes[unit-id]
for slot in bound.start .. < bound.start + bound.count
    if bindings.slots[slot].kind != .slot-this || tables.slot-homes[slot] != home
        continue
    . mark = pending.length
    pending += integer(.machine-u64, tables.layouts.rows[layout].size)
    pending += make-operand(.operand-descriptor, layout)
    filling = filling.held-environment = ir.add-local(managed-layout)
    store-local
        - filling.held-environment
        - call-runtime(.runtime-allocate-object, syntax, mark, managed-layout)
        - syntax
    store
        - load-local(filling.held-environment, syntax)
        - tables.layouts.field(layout, 1 + tables.slot-fields[slot]).offset
        - unit.self
        - true
        - syntax
    filling = filling.held-unit = unit-id
    =
refuse(.refused-function, syntax)

────────────────────
_ do holds-locals Bool
    - unit-id InstanceId
    - value SyntaxId
    - property SyntaxId

` Whether a value an instance types, written at `value`, declares locals in a scope of its own,
` or a lazy local some read tracks, which its one read does not evaluate in place (see
` `read-apart`), which the function that evaluates the value where it is written holds as its
` own for the run (see `enter-unit`), where no nested function reads them. Only the slots the
` binder declared for the value of the property declared at `property` are looked at
` (`window-of`), not every slot of its module's main.
if tables.environments[unit-id] != no-layout
    = false
. binding = instances.rows[unit-id].binding
if binding == no-binding
    = false
. bound = bindings.window-of(binding, property)
. start = tree.subtree-start(value)
for slot in bound.start .. < bound.start + bound.count
    . row = bindings.slots[slot]
    . scoped = bindings.scopes[row.scope].syntax
    . tracked = row.kind == .slot-lazy && (row.flags /and/ SlotFlag.slot-tracked) != 0
    if (row.kind == .slot-local || tracked) && start <= scoped && scoped <= value
        = true
    if row.kind == .slot-loop-state && start <= row.syntax && row.syntax <= value
        = true
= false

────────────────────
_ do default-construction FactId
    - owner TypeId
    - default PropertyDefault

` The construction the type pass recorded at a property with no value written: for the
` constructor being emitted, or for the generated constructor of the tuple or struct being
` built where it is called. A property of another module's class has it recorded by the
` instance that typed it there for the class being made, and a field of another module's
` tuple or struct by that generated constructor, which is typed there.
if default.site == 0
    = no-fact
. builder = making.callee
if unit.instance != no-instance && default.module != instances.rows[unit.instance].module
    . built = no-fact
    if builder != no-instance && instances.rows[builder].self-type == owner && same-module
        built = tables.loose-call(builder, default.site)
    .. same-module = instances.rows[builder].module == default.module
    if built != no-fact && facts.calls[built].form == .call-this-constructor
        = built
    . unit-id = instances.find-initializer(default.module, default.decl, owner)
    if unit-id == no-instance
        = no-fact
    . made = facts.first-call(unit-id, default.site)
    while made != no-fact && facts.calls[made].form != .call-this-constructor
        made = facts.calls[made].next
    = made
. fact = if unit.reading == unit.instance && unit.instance != no-instance then instance-call else no-fact
    .. instance-call = tables.loose-call(unit.instance, default.site)
if fact == no-fact && builder != no-instance && instances.rows[builder].self-type == owner
    fact = tables.loose-call(builder, default.site)
if fact == no-fact || facts.calls[fact].form != .call-this-constructor
    = no-fact
= fact

────────────────────
_ do construct-default Typed
    - default PropertyDefault
    - fact FactId
    - type TypeId

` A property's construction with no value written. The defaults of the arguments it leaves
` out are converted as the instance that recorded the construction says, which is read with
` the source of its module where that is another module's.
. own-making = making
making = making.default-holder = if tables.loose-call(unit.instance, default.site) == fact then unit.instance else making.callee
. own-unit = unit
. holder = facts.calls[fact].instance
if holder != unit.instance && instances.rows[holder].module != instances.rows[unit.instance].module
    unit = unit.source-module = default.module
    unit = unit.reading = holder
. made = emit-fact-call(default.site, facts.calls[fact], 0, RowRange'SyntaxId(), 0, 0, type)
unit = own-unit
making = own-making
= made

────────────────────
_ do settled Operand
    - value Typed
    - expression SyntaxId
    - later RowRange'SyntaxId
    - next U32

` An operand that is the address of storage, copied before an operand after it that may
` change what is stored: any but a literal or a plain name. `later` are the operands of the
` call and `next` is the first that is evaluated after this one.
. disturbed = false
for position in next .. < later.count
    if !is-inert(tree.children[later.start + position])
        disturbed = true
= apart(value, expression, disturbed)

────────────────────
_ do apart Operand
    - value Typed
    - expression SyntaxId
    - disturbed Bool

` An operand that is the address of storage, copied when what is evaluated after it may
` change what is stored. A row `t[i]` made a value lies where nothing changes it.
if !disturbed || expression == 0
    = value.operand
if value.type == no-type || value.type == invalid-type
    = value.operand
. layout = tables.layouts.values[value.type]
if layout == no-layout || !tables.layouts.is-struct(layout) || is-answer(value.operand) || already-made
    = value.operand
.. already-made = made-row(value.operand) != U32.max
= snapshot(value.operand, layout, expression)

────────────────────
_ is-answer Bool
    - value Operand

` Whether a struct is the answer of a call, in memory that nothing names. Any other struct
` is taken to lie in storage that code run later may change.
operand-kind(value) == .operand-value && ir.instructions[operand-payload(value)].op == .op-call

────────────────────
_ do snapshot Operand
    - value Operand
    - layout LayoutId
    - syntax SyntaxId

` A copy of a struct in memory of the frame, which nothing else names.
. held = frame(layout)
copy(held, value, layout, false, syntax)
= held

────────────────────
_ do is-inert Bool
    - id SyntaxId

` Whether evaluating an operand can change nothing: a literal, a name that calls nothing and
` that the type pass said evaluates nothing where it is read, a stored member it said the same
` of read from such an operand, or an operation of the machine on two such operands.
do match? tree.nodes[id]
    | .node-argument(named)
        = is-inert(named.expr)
    | .node-get-expression(row)
        = unplanned && get-uncalled && facts.is-plain(unit.reading, id) && is-inert(row.object)
            .. unplanned = facts.plan-of(unit.reading, id) == .plan-none
            .. get-uncalled = facts.first-call(unit.reading, id) == no-fact
    | .node-binary-expression(row)
        = builtin-plan && binary-uncalled && is-inert(row.lhs) && is-inert(row.rhs)
            .. builtin-plan = facts.plan-of(unit.reading, id) == .plan-builtin
            .. binary-uncalled = facts.first-call(unit.reading, id) == no-fact
    | .node-integer-syntax
        = true
    | .node-float-syntax
        = true
    | .node-string-syntax
        = true
    | .node-identifier
        = facts.first-call(unit.reading, id) == no-fact && facts.is-plain(unit.reading, id)
= false

────────────────────
_ do read-through Typed
    - site SyntaxId
    - value Typed
    - through RowRange'U32

` What a function takes that a property answers for its receiver: each property the type
` pass named is read from what the one before it gave, the first from the receiver `value`.
` One a getter answers is read by a call of the getter the type pass kept for it, each time.
` A property that holds an optional has no shape here.
. held = value
for offset in 0 .. < through.count
    . place = facts.steps[through.start + offset]
    . property = types.properties[place]
    . owner = held.type
    if property.storage-kind == .storage-getter
        . getter = facts.step-callees[through.start + offset]
        if getter == no-instance || !is-callable(getter) || getter-raises
            refuse(.refused-expression, site)
            break
        .. getter-raises = instances.signatures[getter].errors.count != 0
        . mark = pending.length
        pending += held.operand
        held = call-method(getter, site, mark)
        continue
    if property.type == no-type || types.is-optional(property.type)
        refuse(.refused-expression, site)
        break
    held = load-property(site, held.operand, owner, property.name, true, property.type)
= held

────────────────────
_ do emit-receiver Typed
    - id SyntaxId
    - object SyntaxId
    - shared Bool = false

` The receiver of a call: the value written before the callee's name, or with none written
` the receiver of the function the call is in. It takes the conversion recorded for a
` receiver where its value is written, or else the one recorded at the call for the receiver
` of the function it is in, kept apart since the call may be the receiver written for another.
` A name a call calls, which is the receiver of the function its type declares for a call, is
` read as `emit-callee` reads it. A receiver `shared` by calls that each recorded its conversion
` takes those of its type.
. nothing = make-operand(.operand-void, 0)
if object != 0
    = convert(object, .reason-receiver, emit-callee(object), 0, shared)
if unit.has-self && unit.reading != unit.instance && evaluates-value() && filling.count == 0
    = convert(id, .reason-own-receiver, Typed(unit.self, unit.self-type), 0, shared)
if !unit.has-self || (unit.reading != unit.instance && unit.reading != unit.lender)
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
= convert(id, .reason-own-receiver, Typed(unit.self, unit.owner-type), 0, shared)

────────────────────
_ do default-argument Typed
    - id SyntaxId
    - callee InstanceId
    - syntax SyntaxId
    - expected TypeId

` The value of a parameter a call leaves out. With no default written it is an optional with
` no value. A default that runs no code is a constant, read through the facts of the
` callee, which typed it. A default that runs code and is no constant is answered by its own
` function, called here; any other is read from where its module stored it as it started.
` Each is then converted as the call records for a default, at its node or, for a call that
` no node of the body writes, among those recorded outside its body by the instance, or by
` the generated constructor that recorded the construction of a property being made, or as
` the callee recorded where the default is written.
. nothing = make-operand(.operand-void, 0)
if syntax == 0
    = absent-argument(id, expected)
. callee-module = instances.rows[callee].module
. value = Typed(nothing, no-type)
if !tables.default-runs-code(callee, syntax)
    . own-unit = unit
    unit = unit.source-module = callee-module
    unit = unit.reading = callee
    value = emit-expression(syntax)
    unit = own-unit
else
    . row = tables.default-storage(callee, syntax)
    if row == no-storage
        refuse(.refused-expression, id)
        = Typed(nothing, no-type)
    . kept = tables.storage[row]
    if kept.function == no-function
        value = load-global(kept, id)
    else
        value = call-default(id, kept)
if value.type == expected
    = value
. fact = facts.first-conversion(unit.reading, id)
while fact != no-fact
    . row = facts.conversions[fact]
    if row.reason == .reason-default && row.from == value.type && row.to == expected
        = convert-one(id, row, value)
    fact = row.next
fact = facts.first-conversion(callee, syntax)
while fact != no-fact
    . row = facts.conversions[fact]
    if row.reason == .reason-default && row.from == value.type && row.to == expected
        = convert-one(id, row, value)
    fact = row.next
. holder = if making.default-holder != no-instance then making.default-holder else unit.instance
if holder != no-instance && (unit.reading == unit.instance || unit.reading == holder)
    . loose = tables.loose-conversion(holder, id, value.type, .reason-default, expected)
    if loose != no-fact
        = convert-one(id, facts.conversions[loose], value)
refuse(.refused-conversion, id)
= Typed(nothing, no-type)

────────────────────
_ do call-default Typed
    - id SyntaxId
    - kept GlobalStorage

` A call of the function that evaluates a default, made where the call that leaves its
` argument out is. It is checked where the default may panic, which the type pass must have
` said of the caller too.
. target = tables.functions[kept.function]
if target.may-panic && !function.may-panic && !in-landing
    refuse(.refused-expression, id)
    = Typed(make-operand(.operand-void, 0), no-type)
. returns = layout-of(kept.type, id)
ir.depend(.callee-function, kept.function, if target.may-panic then may-panic-dependency else 0u32)
if in-zone
    cross-zone(id, false)
. result = call
    - make-operand(.operand-symbol, target.symbol)
    - id
    - pending.length
    - .callee-function
    - returns
    - target.may-panic && !in-landing
if in-zone
    cross-zone(id, true)
= Typed(result, kept.type)

────────────────────
_ takes-default Bool
    - fact CallFact
    - owner Module
    - first Index
    - given U32
    - type TypeId

` Whether an argument a call gives is an optional that fills a parameter with a default. Such
` a parameter takes its default where the argument holds nothing.
|? type == no-type || type == invalid-type || !types.is-optional(type)
    false
??
    parameter != U32.max && owner.arg-pool[first + parameter].default-syntax != 0

.. parameter = filled-parameter(fact, given)

────────────────────
_ do filled-parameter U32
    - fact CallFact
    - given U32

` The parameter an argument a call gives fills, or none.
for position in 0 .. < fact.fills.count
    if (facts.call-fills[fact.fills.start + position] as U32) == given
        = position
= U32.max

────────────────────
_ do optional-argument Typed
    - id SyntaxId
    - site SyntaxId
    - value Typed
    - callee InstanceId
    - default SyntaxId
    - expected TypeId

` An optional given to a parameter with a default: what it holds, converted as the call
` records for the argument, or the default where it holds nothing, converted as the argument
` records for a default.
. nothing = make-operand(.operand-void, 0)
. held = value.type
. layout = layout-of(expected, id)
. tested = present(site, value)
. given-block = ir.reserve-block()
. absent = ir.reserve-block()
. joined = ir.reserve-block()
. slot = join-slot(layout)
. mark = joins.length
branch(tested.operand, given-block, absent)
ir.start-block(given-block)
. passed = convert(site, .reason-argument, Typed(value.operand, held))
if passed.type != expected
    refuse(.refused-conversion, site)
arrive(id, passed.operand, joined, slot)
ir.start-block(absent)
. other = default-argument(site, callee, default, expected)
if other.type != expected
    refuse(.refused-conversion, id)
arrive(id, other.operand, joined, slot)
= Typed(close-joins(joined, mark, layout, slot), expected)

────────────────────
_ do absent-argument Typed
    - id SyntaxId
    - expected TypeId

` The value of an argument a call leaves out that has no default: an optional with no value.
. nothing = make-operand(.operand-void, 0)
if !types.is-optional(expected)
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. layout = layout-of(expected, id)
if !tables.layouts.is-struct(layout) && !is-null-form(expected)
    refuse(.refused-type, id)
    = Typed(nothing, no-type)
= empty-optional(expected, layout)

────────────────────
_ do drop-given
    - mark Size

while given.length > mark
    given.pop()

────────────────────
_ do emit-c-call Typed
    - id SyntaxId
    - operands RowRange'SyntaxId
    - bound SyntaxId = 0

` A call of a C function, by the policy its declaration has:
` - one that cannot reach the collector is called as it is;
` - one that polls is called between two polls;
` - any other may block, and is called between two checks that the task is not being
`   terminated, where the function `raises-termination`, as foreign code the collector does
`   not wait for.
` After a call of the last two kinds the panic signal is read again. In a function the
` collector never sees, a call of those two kinds leaves that zone before its first check
` and enters it again after its last. One that suspends the task is called as it is, and
` then, where the function `raises-termination`, the task is checked for being terminated,
` which raises the termination panic; elsewhere the task runs on until a check finds it, as
` after a poll, for no caller checks the panic signal of a function that may not panic. One that
` leaves a termination to what follows, a lock taken or an answer the caller checks, is not
` followed by the check (`checks-termination`). It has no shape where the collector never looks.
` A call the type pass planned to describe the storage it makes is called by the policy of the
` runtime's function that describes it, which polls.
` A call of a binding gives `bound`, the binding: it is evaluated first, and the arguments it
` holds come before those written, each converted as the type pass recorded at the call.
. nothing = make-operand(.operand-void, 0)
if facts.plan-of(unit.reading, id) == .plan-elided
    = Typed(nothing, facts.node-type(unit.reading, id))
. fact = answering(facts.first-call(unit.reading, id))
if fact == no-fact
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. callee = facts.calls[fact].callee
. symbol = tables.c-symbols[callee]
?! Panic("A called C function has no symbol")
    if symbol == no-string
. polls = false
. leaf = false
. row = instances.rows[callee]
do match? program.modules[row.module].decls[row.decl]
    | .decl-function(fn)
        polls = (fn.effects /and/ CompilationEffect.gc-polling) != 0
        leaf = (fn.effects /and/ CompilationEffect.gc-leaf) != 0
if facts.plan-of(unit.reading, id) == .plan-described
    polls = true
    leaf = false
. suspends = tables.c-suspends[callee] != 0
if suspends && in-zone
    refuse(.refused-suspending-call, id)
    = Typed(nothing, no-type)
. leaves = !leaf && !suspends && in-zone
. mark = pending.length
. position U32
if bound != 0
    . source = emit-callee(bound)
    . shape = source.type
    . held = layout-of(shape, bound)
    . count = bound-count(shape)
    for offset in 0 .. < count
        . expected = instances.argument-type(callee, position)
        . value = part(source.operand, held, offset, bound)
        if value.type != expected
            value = convert-held(id, value, expected)
        if value.type != expected
            refuse(.refused-conversion, id)
        pending += value.operand
        position += 1
for argument in tree.children[operands]
    . expression = argument
    do match? tree.nodes[argument]
        | .node-argument(given)
            expression = given.expr
    . value = convert(argument, .reason-argument, emit-expression(expression))
    if value.type != instances.argument-type(callee, position)
        refuse(.refused-conversion, argument)
    pending += value.operand
    position += 1
. returns = layout-of(facts.node-type(unit.reading, id), id)
. described = no-layout
if facts.plan-of(unit.reading, id) == .plan-described
    described = described-items(id, callee)
if described != no-layout
    pending += make-operand(.operand-buffer-descriptor, described)
else
    ir.depend(.callee-c, symbol, 0)
if leaves
    cross-zone(id, false)
    in-zone = false
if suspends
    leaf = true
    call-probe-thunk(tables.probe-flush, id)
else if polls
    poll(id)
else if !leaf
    check-interrupt(id)
    call-runtime(.runtime-enter-ffi, id, pending.length, void-layout, true)
. result = nothing
if described != no-layout
    result = call-runtime(tables.c-described[callee] as RuntimeFunction, id, mark, returns)
else
    result = call(make-operand(.operand-symbol, symbol), id, mark, .callee-c, returns)
if suspends
    if !is-unprobed()
        call-probe-thunk(tables.probe-safepoint, id)
    if raises-termination() && tables.checks-termination(callee)
        . resumed = ir.reserve-block()
        . raised = call-instance(instances.report.termination, id, pending.length)
        branch(raised.operand, landing-block(id), resumed)
        ir.start-block(resumed)
if leaf
    = Typed(result, facts.node-type(unit.reading, id))
if polls
    poll(id)
else
    call-runtime(.runtime-leave-ffi, id, pending.length)
    check-interrupt(id)
append(.op-load-panic-signal, id, Span(), 0)
. resumed = ir.reserve-block()
branch(make-operand(.operand-panic-signal, 0), landing-block(id), resumed)
ir.start-block(resumed)
if leaves
    cross-zone(id, true)
    in-zone = true
= Typed(result, facts.node-type(unit.reading, id))

────────────────────
_ do described-items LayoutId
    - id SyntaxId
    - callee InstanceId

` The layout of the items of the storage a C call allocates, resizes or copies for an array
` the collector owns, where an item holds pointers the collector follows: the call is then
` of the function that also takes what describes the storage. No layout for any other item.
. constant = facts.constant-of(unit.reading, id)
if constant == no-fact || tables.c-described[callee] == no-runtime-function
    refuse(.refused-expression, id)
    = no-layout
. layout = layout-of(facts.constants[constant].bits as TypeId, id)
if layout == void-layout || !tables.layouts.rows[layout].is-managed
    = no-layout
if tables.layouts.rows[layout].buffer == no-string
    refuse(.refused-type, id)
    = no-layout
= layout

────────────────────
_ do poll
    - syntax SyntaxId

` A safepoint the collector can stop the task at, taken when the collector has asked for one,
` and the check that the task is not being terminated. The collector's control word says when
` either may be needed, so the poll reads that one word on its way through.
. control-address = make-operand(.operand-symbol, tables.bundle.gc-public-control-word-symbol)
. control = load(control-address, 0, u8-layout, syntax)
. watched = handshake-requested-control /or/ termination-requested-control
. asked = bitwise(syntax, .bitwise-and, control, integer(.machine-u8, watched), u8-layout)
. slow = ir.reserve-block()
. stop = ir.reserve-block()
. checking = ir.reserve-block()
. polled = ir.reserve-block()
branch(asked, slow, polled)
ir.start-block(slow)
. collecting = bitwise
    - syntax
    - .bitwise-and
    - control
    - integer(.machine-u8, handshake-requested-control)
    - u8-layout
branch(collecting, stop, checking)
ir.start-block(stop)
call-runtime(.runtime-safepoint, syntax, pending.length)
jump(checking)
ir.start-block(checking)
check-interrupt(syntax)
jump(polled)
ir.start-block(polled)

────────────────────
_ do check-interrupt
    - syntax SyntaxId

` The check that the task is not being terminated, in a function that `raises-termination`. A
` terminating task leaves through the landing pad with the termination panic.
if !raises-termination()
    =
. flags-address = make-operand(.operand-symbol, tables.runtime-symbol(.runtime-interrupt-flags))
. resume = ir.reserve-block()
check-termination(load(flags-address, 0, u8-layout, syntax), syntax, resume)
ir.start-block(resume)

────────────────────
_ raises-termination Bool

` Whether a poll or a C call that finds the task being terminated leaves with the termination
` panic: in a function that may panic already, or whose callers check the panic signal, or that
` no function calls, a module's main or a task's body. Elsewhere the task runs on until one of
` those finds it, so that no function may panic only because it polls.
signals-panic || function.kind == .module-main || function.kind == .task-body
.. signals-panic = function.may-panic || function.carries

────────────────────
_ is-unpolled Bool

` Whether the code emitted runs where no safepoint is allowed, by what its function declares or a
` `do` block around it is kept from, or because the collector never sees it: its loops poll
` nothing.
(effects-here() /and/ CompilationEffect.no-safepoint) != 0

────────────────────
_ do read-instance
    - read InstanceId

` Makes the function emitted that of an instance, whose facts it reads: what depends on the
` instance alone follows it.
unit = unit.instance = read
unit = unit.reading = read
unit = unit.owner-type = if read == no-instance then no-type else instances.rows[read].self-type
in-zone = is-free(read)

────────────────────
_ is-free Bool
    - function InstanceId

` Whether a function runs where the collector never sees it.
function != no-instance && (instances.rows[function].effects /and/ CompilationEffect.gc-free) != 0

────────────────────
_ do cross-zone
    - syntax SyntaxId
    - enters Bool

` Enters or leaves the zone the collector never sees. Either way the collector reads the
` caller's stack at the call. A function that runs in the zone steps out of it and back as a
` callback does, and the zone stays the one its caller entered: the collector reads the stack
` from where that caller entered it, as the function's own frame is gone once it returns.
. boundary =
    |? is-free(unit.instance)
        if enters then leave-callback else RuntimeFunction.runtime-enter-callback
        .. leave-callback = RuntimeFunction.runtime-leave-callback
    ??
        if enters then RuntimeFunction.runtime-enter-zone else RuntimeFunction.runtime-leave-zone
call-runtime(boundary, syntax, pending.length, void-layout, true)

────────────────────
_ closes-zone Bool
    - answer U8

` Whether the path of an error of a call ends the zone the caller entered for it: the callee
` runs in the zone and the caller does not, and the error came back with the callee stepped
` out of it.
answer == 3 && !is-free(unit.instance)

────────────────────
_ do close-zone
    - syntax SyntaxId

` Ends the zone entered for a call where an error or a panic came back with the callee stepped
` out of it: the step out is ended, then the zone.
call-runtime(.runtime-leave-callback, syntax, pending.length, void-layout, true)
call-runtime(.runtime-leave-zone, syntax, pending.length, void-layout, true)

────────────────────
_ do closing-pad IRBlockId
    - entering Bool

` The pad a checked call that `entering` the zone for it lands on, where the caller runs outside
` the zone, to end that zone before the landing pad; none for any other call.
=? no-block if !entering || is-free(unit.instance)
= ir.reserve-block()

────────────────────
_ do land-closed
    - pad IRBlockId
    - syntax SyntaxId

` Emits a pad `closing-pad` made: it ends the zone and takes the landing pad.
if pad == no-block
    =
. onward = ir.reserve-block()
jump(onward)
ir.start-block(pad)
close-zone(syntax)
jump(landing-block(syntax))
ir.start-block(onward)

────────────────────
_ do landing-block IRBlockId
    - site SyntaxId

` The landing pad of the checks made where the function is: one for each set of cleanups
` open. It keeps the node of the first check that lands there, a panic raised being none.
landings += 1
if landing == no-block
    landing = ir.reserve-block()
    pads += LandingPad(landing, open-cleanups.length, opening-site(site), unit.source-module)
else if site != 0
    . position = pads.length
    while position != 0
        position -= 1
        if pads[position].block == landing
            if pads[position].site == 0
                pads[position] = LandingPad(landing, pads[position].cleanups, site, unit.source-module)
            break
= landing

────────────────────
_ opening-site SyntaxId
    - site SyntaxId

` The first check of a landing pad made for the cleanups open now. In a spawned task's body
` that of the pad of none is where the body starts, at no node.
if function.kind == .task-body && open-cleanups.length == 0 then unsourced else site

────────────────────
_ do finish-landing

` The landing pads the checks of the function branch to once every cleanup has run, each
` left as `leave-pad` says, and then the handlers of a task body, with the pads their checks make.
. position Size = 0
while true
    while position < pads.length
        ir.start-block(pads[position].block)
        leave-pad(pads[position])
        position += 1
    if task-failing == no-block || handling-failure
        =
    handle-failure()

────────────────────
_ do leave-pad
    - pad LandingPad

` Where a panic leaves the function once every cleanup has run. A module's main reports the
` panic nobody handled at the first check of the pad, in the module of its node, unless the pad
` is unsourced (`report-at`); a task's main reports it and ends the task, after forking the end
` of its case in a batch. A spawned task's body reports it as a module's main does, and ends the
` task, unless the task has handlers: it then gives the panic the source of the pad and goes to
` them (`task-failing`). `threadinit` reports it and ends the process. The task that closes the record of probes
` reports it and ends, and the functions that flush and look in on probes report it and return,
` as no caller handles it. Any other panic is then returned to the caller.
abandon-lazy(0)
if function.kind == .probe-flush || function.kind == .probe-safepoint
    emit-report(false, 0)
    return-nothing()
    =
if function.kind == .module-main
    report-at(pad)
else if function.kind == .thread-init
    emit-report(false, 0, true)
else if function.kind == .probe-closer
    emit-report(false, 0)
    call-runtime(.runtime-terminate-active-task, 0, pending.length)
else if function.kind == .task-body
    if task-failing != no-block && !handling-failure
        attach-pad-source(pad)
        jump(task-failing)
        =
    report-at(pad)
    call-runtime(.runtime-terminate-active-task, 0, pending.length)
else if function.kind == .task-main
    emit-report(false, 0)
    if program.is-batch
        fork-batch(tables.batch-finishes[function.place])
    call-runtime(.runtime-terminate-active-task, 0, pending.length)
if in-callback
    call-runtime(callback-exit(), 0, pending.length)
return-panic()

────────────────────
_ do attach-pad-source
    - pad LandingPad

` Gives the active panic, where it has no source, that of the first check of a pad, as
` `report-at` would, where the pad is not unsourced.
=? if pad.site == unsourced || pad.site == 0
. own-unit = unit
unit = unit.source-module = pad.module
. attaching = ir.reserve-block()
. done = ir.reserve-block()
. active = make-operand(.operand-value, append(.op-load-task-panic, 0, Span(), 0, managed-layout))
branch(active, attaching, done)
ir.start-block(attaching)
. begin = tree.nodes[pad.site].loc.begin
attach-source(active, begin.line + 1, begin.column + 1, pad.site)
jump(done)
ir.start-block(done)
unit = own-unit

────────────────────
_ do handle-failure

` Where a panic ends a task whose spawn site has handlers, once every cleanup has run: the
` handlers are tried in order. A terminating task and one canceled try none. The panic is
` taken from the task, and the first handler whose pattern it matches binds it and
` runs; the task then ends as where its body ends. Where none matches, the panic is set again
` and reported as where there are no handlers. A panic raised in a handler lands on a pad of
` its own, which reports it.
handling-failure = true
ir.start-block(task-failing)
landing = no-block
. reporting = ir.reserve-block()
. live = ir.reserve-block()
. open = ir.reserve-block()
. taking = ir.reserve-block()
. active = make-operand(.operand-value, append(.op-load-task-panic, 0, Span(), 0, managed-layout))
branch(active, live, reporting)
ir.start-block(live)
. terminating = call-runtime(.runtime-task-is-terminating, 0, pending.length, u8-layout)
branch(terminating, reporting, open)
ir.start-block(open)
. cancelation = types.cancelation-type
if cancelation != invalid-type && tables.is-class(cancelation)
    . raised = make-operand(.operand-value, append(.op-load-task-panic, 0, Span(), 0, managed-layout))
    class-branch(0, raised, cancelation, reporting, taking)
else
    jump(taking)
ir.start-block(taking)
. taken = call-runtime(.runtime-take-panic, 0, pending.length, managed-layout)
set-task-end(task-end-panicked)
for handler in tree.children[task-handlers]
    do match? tree.nodes[handler]
        | .node-catcher(row)
            . next = ir.reserve-block()
            . named = bound.length
            emit-pattern(row.type, Typed(taken, types.panic-type), next)
            emit-block(row.body)
            drop-bound(named)
            jump(task-leaving)
            ir.start-block(next)
. mark = pending.length
pending += taken
call-runtime(.runtime-panic-set, 0, mark)
jump(reporting)
ir.start-block(reporting)
emit-report(false, 0)
call-runtime(.runtime-terminate-active-task, 0, pending.length)
return-nothing()

────────────────────
_ do report-at
    - pad LandingPad

` Reports the active panic at the first check of a pad, as a module's main does, where the pad
` is not unsourced, read in the module of its node.
. own-unit = unit
unit = unit.source-module = pad.module
emit-report(pad.site != unsourced, pad.site)
unit = own-unit

────────────────────
_ do abandon-lazy
    - site SyntaxId

` Gives up the claim a lazy property's function took on its object (`emit-lazy`) where the
` value panics or lets out an error, so that a task the runtime holds on the property, or the
` next read, evaluates it again. The runtime does nothing where the property is not claimed.
=? if lazy-claim.layout == no-layout
. mark = pending.length
pending += address(unit.self, lazy-claim.offset, lazy-claim.layout, site)
call-runtime(.runtime-abandon-lazy-global, site, mark)

────────────────────
_ do emit-report
    - attaches Bool
    - site SyntaxId
    - fatal = false

` Reports the active panic when no caller is left to handle it:
` 1. Nothing is reported when no panic is active, and the panic of a terminating task, or one
`    that cancels a task, is cleared. A `fatal` report runs where no task is, and the runtime
`    ends the process once it is made.
` 2. A module's main gives a panic that has no source its own path, at the first check that
`    reached this landing pad. A pad no check with a node reached, as a cleanup's that
`    panicked where its block ended, gives it none.
` 3. The panic is set aside while its text is made, through its class table, with the text
`    of its source, and then given to the runtime with its stack trace.
. report = instances.report
. object = tables.layouts.objects[types.panic-type]
. slot = tables.slots[report.message]
?! Panic("The report of an unhandled panic is missing from the program tables")
    if object == no-layout || slot == no-slot-index
?! Panic("The panic class has no source or no stack trace")
    if report.source-slot == U32.max || report.trace-slot == U32.max
in-landing = true
. layouts = tables.layouts
. managed = managed-layout
. source-field = layouts.field(object, object-header-fields + report.source-slot)
. trace-field = layouts.field(object, object-header-fields + report.trace-slot)
?! Panic("The source of a panic is not an optional struct")
    if !layouts.is-struct(source-field.layout)
. done = ir.reserve-block()
. reporting = ir.reserve-block()
. active = make-operand(.operand-value, append(.op-load-task-panic, 0, Span(), 0, managed))
branch(active, reporting, done)

ir.start-block(reporting)
. unhandled = ir.reserve-block()
if fatal
    jump(unhandled)
else
    . suppress = ir.reserve-block()
    . canceling = ir.reserve-block()
    . terminating = call-runtime(.runtime-task-is-terminating, 0, pending.length, u8-layout)
    branch(terminating, suppress, canceling)

    ir.start-block(canceling)
    . cancelation = types.cancelation-type
    if cancelation != invalid-type && tables.is-class(cancelation)
        . raised = make-operand(.operand-value, append(.op-load-task-panic, 0, Span(), 0, managed))
        class-branch(0, raised, cancelation, suppress, unhandled)
    else
        jump(unhandled)

    ir.start-block(suppress)
    call-runtime(.runtime-panic-clear, 0, pending.length)
    jump(done)

ir.start-block(unhandled)
. panic = make-operand(.operand-value, append(.op-load-task-panic, 0, Span(), 0, managed))
if attaches && site != 0
    . begin = tree.nodes[site].loc.begin
    attach-source(panic, begin.line + 1, begin.column + 1, site)
. mark = pending.length
pending += address(panic, trace-field.offset, managed, 0)
call-runtime(.runtime-ensure-stack-trace, 0, mark)
. suspended = call-runtime(.runtime-panic-suspend, 0, pending.length, managed)
. message = raised-text(panic, slot, false)
. placed-text = raised-place(panic)
. trace = load(panic, trace-field.offset, trace-field.layout, 0)
pending += suspended
call-runtime(.runtime-panic-resume, 0, mark)
pending += panic
pending += message
pending += placed-text.operand
pending += trace
call-runtime
    - if fatal then .runtime-report-fatal-panic else .runtime-report-unhandled-panic
    - 0
    - mark
jump(done)
ir.start-block(done)
in-landing = false

────────────────────
_ do raised-text Operand
    - raised Operand
    - slot U32
    - raises Bool

` The text of a panic or an error, made by the converter its class has in a slot of its
` table. The call is checked where a converter some class has there may panic, unless a
` panic is being handled already.
. table = load(raised, 0, pointer-layout, 0)
. method = load(table, table-header-size + slot * table-slot-size, pointer-layout, 0)
. mark = pending.length
pending += raised
= call(method, 0, mark, .callee-value, managed-layout, raises && !in-landing)

────────────────────
_ do raised-place Typed
    - raised Operand

` The text of the source of a panic or an error, or the empty text for one that has none.
. report = instances.report
. layouts = tables.layouts
. object = layouts.objects[types.panic-type]
. field = layouts.field(object, object-header-fields + report.source-slot)
. inner = layouts.field(field.layout, 0)
. flag = layouts.field(field.layout, 1)
. source = address(raised, field.offset, field.layout, 0)
. with-source = ir.reserve-block()
. unplaced = ir.reserve-block()
. joined = ir.reserve-block()
branch(load(source, flag.offset, flag.layout, 0), with-source, unplaced)
ir.start-block(unplaced)
jump(joined)
ir.start-block(with-source)
. mark = pending.length
pending += address(source, inner.offset, inner.layout, 0)
. place = call-instance(report.source-text, 0, mark)
. placed = ir.current
jump(joined)
ir.start-block(joined)
. nowhere = make-operand(.operand-constant, ir.add-string(""))
= Typed(phi(managed-layout, place.operand, placed, nowhere, unplaced), place.type)

────────────────────
_ do report-error
    - error Operand
    - id SyntaxId
    - prints Bool = false

` Reports an error that left the main of a module or the body of a spawned task, which no
` caller is left to handle: its text, made through its class table, the text of its source
` and its stack trace are given to the runtime, which ends the process, or with `prints` only
` prints them. A panic raised while a text is made leaves the function as any other does, which
` the type pass said of every one that lets an error out.
. report = instances.report
. made = report.error-text
if made == no-instance || tables.instance-functions[made] == no-function || !function.may-panic
    refuse(.refused-statement, id)
    =
. slot = tables.slots[made]
if slot == no-slot-index || tables.instance-functions[report.source-text] == no-function
    refuse(.refused-statement, id)
    =
. object = tables.layouts.objects[types.panic-type]
. trace = tables.layouts.field(object, object-header-fields + report.trace-slot)
. message = raised-text(error, slot, tables.raises-through(made))
. placed = raised-place(error)
. mark = pending.length
if !prints
    pending += error
pending += message
pending += placed.operand
pending += load(error, trace.offset, trace.layout, 0)
call-runtime
    - if prints then .runtime-print-unhandled-error else .runtime-report-unhandled-error
    - 0
    - mark

────────────────────
_ do call-instance Typed
    - callee InstanceId
    - syntax SyntaxId
    - mark Size
    - restores Bool = false
    - watched Bool = false
    - variant FunctionId = no-function
    - held TypeId = no-type

` A call of an emitted instance with the pending arguments from `mark` on, or with
` `restores` of the initializer of a constructor, which returns nothing. One that may panic
` is checked, unless the call is made while a panic is already being handled, or the type
` pass says no call of the instance is checked and the call is not `watched`. A call between
` code the collector never sees and a function it does, or the other way, crosses the zone
` before the call and crosses back after it, unless the callee is one that reaches no safepoint
` there, which runs where it is called. A callee that returns a panic has stepped out
` of the zone, so the landing pad is always outside it, and a caller outside the zone ends
` the zone it entered before it lands. The slots of globals `do with` binds set
` for the call are put back on both ways out of it. Only a stream pattern calls a rule a
` module declares, which `calls-rule` says, and its function for a set of collectors is the
` `variant` where one is given, as is its function for a pattern that may raise errors, which
` answers with `held`.
if !restores && tables.is-prototype(callee)
    = call-slot(callee, syntax, mark, watched)
. rules = calls-rule
calls-rule = false
. ruled = rule-match(program, instances.rows[callee].module, instances.rows[callee].decl)
if !restores && rules != (ruled != 0)
    refuse(.refused-expression, syntax)
    drop-pending(mark)
    = Typed(make-operand(.operand-void, 0), no-type)
if !restores && function.kind != .witness && answers-itself(callee)
    refuse(.refused-expression, syntax)
    drop-pending(mark)
    = Typed(make-operand(.operand-void, 0), no-type)
. target-id = if restores then tables.initializer-functions[callee] else called-target
    .. called-target = if variant != no-function then variant else tables.instance-functions[callee]
?! Panic("A called instance is not in the emitted set")
    if target-id == no-function
. target = tables.functions[target-id]
. signature = instances.signatures[callee]
. raising = signature.errors.count != 0
. raw = takes-result
takes-result = false
if raising && (restores || !raw || zone-answer != 0)
    refuse(.refused-expression, syntax)
if held != no-type && (raising || restores || is-free(callee) || in-zone)
    refuse(.refused-expression, syntax)
. returned = if held != no-type then held else if restores then types.void-type else promised
    .. promised = if raising then signature.result else signature.returns
. returns = layout-of(returned, syntax)
. flags U32 = if instances.rows[callee].is-generator then generator-dependency else 0
if target.may-panic
    flags = flags /or/ may-panic-dependency
ir.depend(.callee-function, target-id, flags)
. checked = target.may-panic && !in-landing && (watched || !instances.rows[callee].quiet)
. symbol = make-operand(.operand-symbol, target.symbol)
. saved = prepare-stacks(callee, syntax)
. enters = is-free(callee) && (in-zone || !tables.is-bounded(callee))
. crosses = enters != in-zone
. closing = checked && crosses && enters && !is-free(unit.instance)
. restoring = no-block
if checked
    for local in saved
        if local != no-local
            restoring = ir.reserve-block()
            break
if closing && restoring == no-block
    restoring = ir.reserve-block()
if crosses
    cross-zone(syntax, enters)
. result = call(symbol, syntax, mark, .callee-function, returns, checked, false, restoring)
cross-back(syntax, enters, raising)
restore-stacks(callee, saved, syntax)
if restoring != no-block
    . onward = ir.reserve-block()
    jump(onward)
    ir.start-block(restoring)
    if closing
        close-zone(syntax)
    restore-stacks(callee, saved, syntax)
    jump(landing-block(syntax))
    ir.start-block(onward)
= Typed(result, returned)

────────────────────
_ do prepare-stacks [LocalId]
    - callee InstanceId
    - site SyntaxId

` Before the body of a spawned task, a lambda or a comprehension calls a function that reads
` globals `do with` binds outside its bindings of them, each slot no binding around the call
` holds is kept, and set to the state the body holds, as TypeScript does. The local each is
` kept in, or none. As a read of one, a call in a cleanup a landing pad runs is refused where a
` `do with` after the cleanup binds it. A nested function called holds what it captured, and is
` given nothing, as TypeScript gives a closure nothing.
. saved [LocalId]
if function.kind != .task-body && !is-closure-body()
    = saved
. called = instances.rows[callee]
do match? program.modules[called.module].decls[called.decl]
    | .decl-function(fn)
        if is-nested-kind(fn.kind)
            = saved
for row in tables.stack-needs(callee)
    . local = no-local
    if row != no-storage && scoping.unwinding-from != 0 && binds-after(row, scoping.unwinding-from)
        refuse(.refused-expression, site)
    if row != no-storage && !stack-bound(row)
        . kept = tables.storage[row]
        local = ir.add-local(kept.layout)
        . slot = stack-slot(kept, site)
        store-local(local, slot, site)
        copy
            - slot
            - stack-state(row, site)
            - kept.layout
            - tables.layouts.rows[kept.layout].is-managed
            - site
    saved += local
= saved

────────────────────
_ do restore-stacks
    - callee InstanceId
    - saved [LocalId]
    - site SyntaxId

` After such a call each slot set before it is put back as it was.
if saved.length == 0
    =
. rows = tables.stack-needs(callee)
for index in 0 .. < saved.length
    if saved[index] != no-local
        . kept = tables.storage[rows[index]]
        copy
            - stack-slot(kept, site)
            - load-local(saved[index], site)
            - kept.layout
            - tables.layouts.rows[kept.layout].is-managed
            - site

────────────────────
_ is-callable Bool
    - callee InstanceId

` Whether a call of an instance has something to call: the function emitted for it, or the
` slot it has in a witness table.
tables.instance-functions[callee] != no-function || tables.is-prototype(callee)

────────────────────
_ do call-slot Typed
    - callee InstanceId
    - syntax SyntaxId
    - mark Size
    - watched Bool = false

` A call of a function of an interface through a value of it, the first of the pending
` arguments from `mark` on: of what the value's witness table holds in the function's slot
` of the interface's section, given the value and the arguments. What runs is not known
` here, so the call is checked for a panic, which the type pass must have said of the
` caller too. A function that raises errors answers with its value or one of them, to a
` caller that takes that. A call of a function the type pass says no call checks is not
` checked: a panic raised under it stays the task's, and what follows the call runs, as
` in the reference. A `watched` call is checked all the same. A call in the zone the
` collector never sees stays in it, as TypeScript's does, since what runs is not known.
. nothing = make-operand(.operand-void, 0)
. signature = instances.signatures[callee]
. raising = signature.errors.count != 0
. raw = takes-result
. checked = watched || !instances.rows[callee].quiet
takes-result = false
if mark >= pending.length || (raising && (!raw || in-zone)) || uncaught-panic
    refuse(.refused-expression, syntax)
.. uncaught-panic = checked && !function.may-panic && !in-landing
. returned = if raising then signature.result else signature.returns
. returns = layout-of(returned, syntax)
. layout = tables.layouts.interface-layout
. table = load(pending[mark], tables.layouts.field(layout, 1).offset, pointer-layout, syntax)
. place = (witness-header-slots + tables.slots[callee]) * table-slot-size
. method = load(table, place, pointer-layout, syntax)
. result = call(method, syntax, mark, .callee-value, returns, checked && !in-landing)
= Typed(result, returned)

────────────────────
_ do emit-view

` A function of an interface as a value of a type that is none runs it: it sees the value
` as the interface, and calls the function that holds the body with that and its
` arguments. It is a frame of its own in a stack trace, placed where the function is
` declared, as TypeScript's is. One that raises errors returns what the function that holds
` the body gave it, the value or one of the errors, which is held the same.
. row = instances.rows[unit.instance]
. signature = instances.signatures[unit.instance]
. declared = row.subtree.start + row.subtree.count - 1
. target-id = tables.body-functions[unit.instance]
. target = tables.functions[target-id]
. forwards = signature.errors.count != 0
if in-zone || (forwards && target.instance == no-instance)
    refuse(.refused-function, declared)
    =
if forwards && instances.signatures[target.instance].result != signature.result
    refuse(.refused-function, declared)
    =
ir.add-argument(layout-of(row.self-type, declared))
for position in 0 .. < signature.args.count
    ir.add-argument(layout-of(instances.argument-type(unit.instance, position), declared))
returns-type = signature.returns
ir.returns = layout-of(signature.returns, declared)
if forwards
    return-results(signature.result, declared)
. mark = pending.length
. view = tables.receiver-view(unit.instance)
pending += make-interface(declared, row.self-type, view, make-operand(.operand-argument, 0)).operand
for position in 0 .. < signature.args.count
    pending += make-operand(.operand-argument, position + 1)
ir.depend(.callee-function, target-id, if target.may-panic then may-panic-dependency else 0u32)
. symbol = make-operand(.operand-symbol, target.symbol)
. answer = call(symbol, declared, mark, .callee-function, ir.returns, target.may-panic)
if forwards
    return-held(answer)
else if returns-type == types.void-type
