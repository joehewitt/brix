────────────────────
_ do emit-function
    - id FunctionId

ir.reset(id)
function = tables.functions[id]
read-instance(function.instance)
unit = unit.source-module = function.module
returns-type = types.void-type
stepping = function.kind == .generator-body
bind-slots()
ir.signals = function.may-panic || function.carries || function.polls
ir.start-block(ir.reserve-block())
if function.polls
    open-polls()
clear-lazies()
open-uses()
if function.unplaced && (function.may-panic || raises-errors())
    refuse-own()
else if unit.instance != no-instance && tables.holds-unmade(unit.instance)
    . written = instances.rows[unit.instance].subtree
    refuse(.refused-function, if written.count != 0 then written.start + written.count - 1 else 0)
else if function.kind == .module-main
    open-environment(0)
    make-subscribers(0)
    emit-statements()
    end-main()
    close-cleanups(0)
    return-nothing()
else if function.kind == .instance-body && tables.is-region(unit.instance)
    emit-region-body()
else if function.kind == .instance-body && tables.body-functions[unit.instance] != no-function
    if tables.functions[tables.body-functions[unit.instance]].kind == .constructor-body
        emit-filling()
    else
        emit-view()
else if instance-or-init || function.kind == .viewed-body || function.kind == .constructor-body
    emit-body()
else if function.kind == .generator-body
    emit-body()
    check-steps()
else if function.kind == .lazy-property
    emit-lazy()
else if function.kind == .property-updater
    emit-updater()
else if function.kind == .class-rule-updater
    emit-class-rule-updater()
else if function.kind == .style-gate
    emit-style-gate()
else if function.kind == .style-scope-state
    emit-scope-cell()
else if function.kind == .slot-forward
    emit-slot-forward()
else if function.kind == .style-author
    emit-style-author()
else if function.kind == .style-given-author
    emit-given-author()
else if function.kind == .style-rule
    emit-style-rule()
else if function.kind == .style-static-value
    emit-static-value()
else if function.kind == .style-themed-value
    emit-themed-value()
else if function.kind == .markup-query
    emit-ancestor-query()
else if function.kind == .markup-query-add || function.kind == .markup-query-remove
    emit-descendant-query(function.kind == .markup-query-remove)
else if function.kind == .markup-trigger-add || function.kind == .markup-trigger-remove
    emit-trigger-change(function.kind == .markup-trigger-remove)
else if function.kind == .markup-trigger-ancestor
    emit-trigger-ancestor()
else if function.kind == .live-adapter
    emit-live-adapter()
else if function.kind == .idle-action
    emit-idle-action()
else if function.kind == .module-constants
    emit-globals(.global-constant)
else if function.kind == .module-globals
    emit-globals(.global-eager)
else if function.kind == .lazy-global
    emit-lazy-global()
else if function.kind == .task-local-init || function.kind == .thread-local-init || stack-init
    emit-local-global()
else if function.kind == .task-body
    emit-task-body()
else if function.kind == .module-statics
    emit-statics()
else if function.kind == .argument-default
    emit-argument-default()
else if function.kind == .stream-action
    emit-stream-action()
else if function.kind == .machine-handler
    emit-machine-handler()
else if function.kind == .machine-cast
    emit-machine-cast()
else if function.kind == .machine-activation
    emit-machine-activation()
else if function.kind == .machine-descriptor
    emit-machine-descriptor()
else if function.kind == .machine-deferral
    emit-machine-deferral()
else if function.kind == .machine-part
    emit-machine-part()
else if function.kind == .machine-stop
    emit-machine-stop()
else if function.kind == .pattern-helper
    emit-pattern-helper()
else if function.kind == .pattern-cast
    emit-pattern-cast()
else if function.kind == .lazy-rule
    emit-lazy-rule(function.place)
else if function.kind == .rule-adapter
    emit-rule-adapter(function.place)
else if function.kind == .mapped-rule
    emit-mapped-rule()
else if function.kind == .raising-rule
    emit-raising-rule()
else if function.kind == .adapter
    emit-adapter()
else if function.kind == .witness
    emit-witness()
else if function.kind == .class-adapter
    emit-class-adapter()
else if function.kind == .union-dispatch
    emit-union-dispatch()
else if function.kind == .interface-equality
    emit-interface-equality()
else if function.kind == .storage-growth
    emit-storage-growth()
else if function.kind == .source-attach
    emit-source-attach()
else if function.kind == .raise-panic
    emit-raise-panic()
else if function.kind == .raise-message
    emit-raise-message()
else if function.kind == .event-handler
    emit-event-handler()
else if function.kind == .event-matcher
    emit-event-matcher()
else if function.kind == .event-registrations
    emit-event-registrations()
else if function.kind == .style-registration
    emit-style-registration()
else if function.kind == .style-sheet-registration
    emit-sheet-registration()
else if function.kind == .batch-main
    emit-batch-main()
else if function.kind == .batch-finish
    emit-batch-finish()
else if function.kind == .probe-setup
    emit-probe-setup()
else if function.kind == .probe-teardown
    emit-probe-teardown()
else if function.kind == .probe-flush
    call-probe-function(instances.probe-runtime.task-flush, 0, pending.length)
    return-nothing()
else if function.kind == .probe-safepoint
    call-probe-function(instances.probe-runtime.safepoint, 0, pending.length)
    return-nothing()
else
    . placed = if function.kind == .module-init then init-site() else 0
    if function.kind == .module-init
        placed = register-styles(placed)
        if function.module == program.entry-module && tables.erased-publishes != 0
            count-event(.publish-sites-erased, 0, tables.erased-publishes)
    . starts-case = function.kind == .task-main && program.is-batch
    if starts-case
        start-case()
    for position in function.calls.start .. < function.calls.end
        if starts-case && tables.calls[position] == tables.probe-setup
            set-up-batch-probes()
        else
            call-function(tables.calls[position], placed)
    placing = false
    if starts-case
        fork-batch(tables.batch-finishes[function.place])
    if function.kind == .task-main || function.kind == .probe-closer
        call-runtime(.runtime-terminate-active-task, 0, pending.length)
    return-nothing()
.. instance-or-init = function.kind == .instance-body || function.kind == .instance-initializer
.. stack-init = function.kind == .stack-local-init
. ruled = function.kind == .pattern-helper || function.kind == .pattern-cast || function.kind == .lazy-rule || function.kind == .mapped-rule || function.kind == .stream-action || function.kind == .raising-rule || function.kind == .rule-adapter
. machined = handler-or-cast || activates || describes || function.kind == .machine-deferral
    .. handler-or-cast = function.kind == .machine-handler || function.kind == .machine-cast
    .. activates = function.kind == .machine-activation
    .. describes = function.kind == .machine-descriptor
machined = machined || function.kind == .machine-part || function.kind == .machine-stop
if !machined && no-result && not-entry && not-handler && !ruled
    if instances.signatures[unit.instance].errors.count != 0
        refuse-own()
.. no-result = unit.instance != no-instance && result-type == no-type
.. not-entry = function.kind != .module-main && function.kind != .task-body
.. not-handler = function.kind != .event-handler && function.kind != .class-rule-updater
if zone-answer != 0
    refuse-own()
close-uses()
finish-landing()

────────────────────
_ get tree AST

program.modules[unit.source-module].tree

────────────────────
_ do refuse ?! Refused
    - construct RefusedConstruct
    - syntax SyntaxId

refusal = Refusal(construct, unit.source-module, syntax)
?! Refused("Refused")

────────────────────
_ do refuse-function-at ?! Refused
    - module ModuleId
    - syntax SyntaxId

refusal = Refusal(.refused-function, module, syntax)
?! Refused("Refused")

────────────────────
_ do refuse-instance
    - refused InstanceId

. row = instances.rows[refused]
refuse-function-at
    - row.module
    - if row.subtree.count != 0 then row.subtree.start + row.subtree.count - 1 else 0

────────────────────
_ do refuse-class
    - type TypeId

match? types.rows[type]
    | .type-class(row)
        refuse-function-at(row.module, class-site(type))
        =
refuse(.refused-function, 0)

────────────────────
_ do refuse-own

if function.kind == .adapter
    refuse-function-at(function.module, tables.adapters[function.place].site)
else if function.kind == .stream-action
    refuse-function-at(function.module, facts.outlined[function.place].arm)
else if unit.instance != no-instance
    refuse-instance(unit.instance)
else
    refuse(.refused-function, 0)

────────────────────
_ do bind-slots

` Makes the columns that find what a slot of the function's binding is kept in, and which
` argument a slot that is one is. They live in the function's arena.
unit = unit.slot-start = 0
unit = unit.slot-count = 0
unit = unit.own-scope = no-scope
if unit.instance != no-instance
    unit = unit.own-scope = tables.instance-scopes[unit.instance]
    . binding = instances.rows[unit.instance].binding
    if binding != no-binding
        . bound = bindings.bindings[binding].slots
        unit = unit.slot-start = bound.start
        unit = unit.slot-count = bound.count
unit = unit.cells = storage.allocate'U32(unit.slot-count + 1)
unit = unit.lazy-flags = storage.allocate'U32(unit.slot-count + 1)
unit = unit.lazy-readers = storage.allocate'U32(unit.slot-count + 1)
unit = unit.fill-flags = storage.allocate'U32(unit.slot-count + 1)
unit = unit.fill-cells = storage.allocate'U32(unit.slot-count + 1)
unit = unit.kept = storage.allocate'U32(unit.slot-count + 1)
unit = unit.kept-types = storage.allocate'U32(unit.slot-count + 1)
unit = unit.positions = storage.allocate'U32(unit.slot-count + 1)
unit = unit.open-held = no-place
. seen U32
for offset in 0 .. < unit.slot-count
    unit.cells[offset] = no-local
    unit.lazy-flags[offset] = no-local
    unit.lazy-readers[offset] = 0
    unit.fill-flags[offset] = no-local
    unit.fill-cells[offset] = no-local
    unit.kept[offset] = make-operand(.operand-void, 0)
    unit.kept-types[offset] = no-type
    unit.positions[offset] = seen
    if bindings.slots[unit.slot-start + offset].kind == .slot-argument && owns(unit.slot-start + offset)
        seen += 1

────────────────────
_ owns Bool
    - slot SlotId

` Whether a slot is one the emitted function declares, and no nested function written in
` it or function it is written in.
unit.own-scope == no-scope || tables.slot-functions[slot] == unit.own-scope

────────────────────
_ do sees Bool
    - slot SlotId

` Whether a slot is declared by the function's own scope or by one it is written in. The
` outermost scope of a binding has no parent before it.
. scope = unit.own-scope
if scope == no-scope
    = true
while tables.slot-functions[slot] != scope
    . parent = bindings.scopes[scope].parent
    if parent >= scope
        = false
    scope = parent
= true

────────────────────
_ is-captured Bool
    - slot SlotId

` Whether a slot is kept in an environment: one that nested functions capture, or any slot
` of a function that yields, whose environment keeps them from one step to the next. A
` function built with no environment keeps as locals those its own scope's would hold. A
` slot that only tasks spawned in its own function copy is a local there, and kept in the
` capture of each task's body.
homed || copied
    .. homed = tables.slot-homes[slot] != no-scope && !(unshared && tables.slot-homes[slot] == unit.own-scope)
    .. copied = tables.slot-copied[slot] != 0 && tables.slot-functions[slot] != unit.own-scope && spawned
    .. spawned = unit.instance != no-instance && tables.capture-rows[unit.instance] != no-place

────────────────────
_ do open-environment
    - site SyntaxId

` Makes the environment of the function's own scope, where nested functions capture
` locals it declares: an object the collector owns, which arrives zeroed, with the link to
` the environment the function was given. It is made once in a run of the function, before
` the arguments are bound. A function built with no environment makes none.
if unit.instance == no-instance || unit.own-scope == no-scope || unshared
    =
. layout = tables.environments[unit.instance]
if layout == no-layout
    =
if layout == unbuilt-environment
    refuse(.refused-function, site)
    =
. mark = pending.length
pending += integer(.machine-u64, tables.layouts.rows[layout].size)
pending += make-operand(.operand-descriptor, layout)
. made = call-runtime(.runtime-allocate-object, site, mark, managed-layout)
unit = unit.environment = ir.add-local(managed-layout)
store-local(unit.environment, made, site)
if unit.received
    store(made, 0, given-environment(site), true, site)

────────────────────
_ runs-in-body Bool
    - statement SyntaxId

` Whether a statement of a body is one that runs: one that declares nothing, or a nested
` function written there for its value, which the type pass typed as one.
tables.runs-statement(unit.source-module, probe-decl(), tree, statement) || closure-statement
.. closure-statement = is-closure(facts.node-type(unit.reading, statement))

────────────────────
_ do share-self
    - site SyntaxId

` The receiver of a member whose nested functions read it: the member copies it into its
` environment, and a nested function reads it from there once and has it as its own. An
` object is shared so, a value of an interface, a value of a function type, a value that
` is one number, and a tuple no constructor is making, which nothing changes in place; a
` struct, which a member changes where it is kept, has no shape here. A member that yields
` keeps its receiver the same way: where it is called it copies it, and each step of its
` body reads it from there. The body of a spawned task or of a `do without gc` block that does not
` copy it has none, nor has a function that captures a struct only for the tasks spawned in it,
` which no value owns.
. binding = instances.rows[unit.instance].binding
if binding == no-binding
    =
for offset in 0 .. < unit.slot-count
    . slot = unit.slot-start + offset
    if bindings.slots[slot].kind != .slot-this || !is-captured(slot) || !sees(slot)
        continue
    if tables.capture-rows[unit.instance] != U32.max && tables.capture-field(unit.instance, slot) == U32.max
        continue
    . held = find-captured(slot, site).type
    . whole = tables.is-class(held) || intrinsic(held) == .interface
    whole = whole || !tables.layouts.is-struct(layout-of(held, site))
    whole = whole || layout-of(held, site) == tables.layouts.function-layout
    whole = whole || (intrinsic(held) == .tuple && !builds)
    if !whole && (bindings.slots[slot].flags /and/ SlotFlag.slot-self-used) == 0
        continue
    if !whole
        refuse(.refused-function, site)
    else if unit.received || stepping
        unit = unit.self = read-captured(slot, site, held).operand
        unit = unit.owner-type = held
        unit = unit.has-self = true
    else if unit.has-self
        keep-captured(slot, unit.self, held, site)

────────────────────
_ do find-captured LayoutField
    - slot SlotId
    - site SyntaxId

` Where a slot that nested functions capture is kept: its field in the environment of the
` scope that declares it. That scope is the emitted function's own, or that of a function
` it is written in, whose instance types the field, or a loop of either, a turn of which
` has an environment of its own. `hops` is left as how many environments lie between the
` one the function was given and that one, or as none for its own. `turn` is left as the
` local that holds the environment of a turn of the function's own loop, which must be
` the turn being emitted. A spawned task's body keeps what it copies in the capture it was
` given, which is the link of its environment, and that capture's own link leads on to the
` environments where what it shares is kept. A slot only tasks capture has no home: it is
` found in the capture of the task that copied it.
. nothing = LayoutField(0, void-layout)
hops = no-hops
turn = no-local
turn-place = no-place
through = no-place
home-owner = no-instance
home-layout = no-layout
. home = tables.slot-homes[slot]
. follows = unit.reading == unit.instance || unit.reading == unit.lender
. copied = tables.slot-copied[slot] != 0
if !follows || unit.own-scope == no-scope || (home == no-scope && !copied)
    refuse(.refused-expression, site)
    = nothing
. owner = unit.instance
. scope = unit.own-scope
if tables.slot-functions[slot] == unit.own-scope && home != unit.own-scope
    . position = open-turns.length
    while position != 0 && open-turns[position - 1].scope != home
        position -= 1
    . held = tables.turn-environment(unit.instance, home)
    if position == 0 || held == no-layout || held == unbuilt-environment
        refuse(.refused-expression, site)
        = nothing
    turn = open-turns[position - 1].local
    turn-place = open-turns[position - 1].place
    home-owner = unit.instance
    home-layout = held
    = tables.layouts.field(held, 1 + tables.slot-fields[slot])
if scope != home
    hops = 0
while scope != home
    if tables.capture-rows[owner] != no-place
        if tables.copies(owner, slot)
            = task-captured(slot, owner, site)
        if !tables.links-capture(owner)
            refuse(.refused-expression, site)
            = nothing
        hops += 1
    if bindings.scopes[scope].kind != .scope-nested
        refuse(.refused-expression, site)
        = nothing
    owner = facts-owner(instances.rows[owner].enclosing)
    scope = bindings.scopes[scope].parent
    while scope != home && bindings.scopes[scope].kind != .scope-function && bindings.scopes[scope].kind != .scope-nested
        if tables.is-turn-scope(scope) && tables.scope-captures[scope] != 0
            hops += 1
        scope = bindings.scopes[scope].parent
    if owner == no-instance
        refuse(.refused-expression, site)
        = nothing
    if scope != home && (tables.holds-environment(scope) || tables.holds-stacks(owner))
        hops += 1
. layout = tables.environments[owner]
if tables.is-turn-scope(home)
    layout = tables.turn-environment(owner, home)
if layout == no-layout || layout == unbuilt-environment
    refuse(.refused-expression, site)
    = nothing
home-owner = owner
home-layout = layout
= tables.layouts.field(layout, 1 + tables.slot-fields[slot])

────────────────────
_ facts-owner InstanceId
    - owner InstanceId

` The instance whose facts and environment are an instance's: the main of its module for the
` value of a global, whose facts the type pass moves there, and the instance itself otherwise.
|? owner == no-instance || instances.rows[owner].initializer == 0 || instances.keeps-facts(owner)
    owner
??
    tables.main-instances[instances.rows[owner].module]

────────────────────
_ do task-captured LayoutField
    - slot SlotId
    - owner InstanceId
    - site SyntaxId

` The field of the capture of a spawned task's body that holds a local it copies. Where the
` capture holds its address (`refers`), the local is at the start of what that address leads to.
. nothing = LayoutField(0, void-layout)
. layout = tables.captures[owner]
. field = tables.capture-field(owner, slot)
if layout == no-layout || layout == unbuilt-environment || field == U32.max
    refuse(.refused-expression, site)
    = nothing
home-owner = owner
home-layout = layout
. found = tables.layouts.field(layout, field)
if !tables.refers(owner, slot)
    = found
through = found.offset
= LayoutField(0, tables.layouts.values[found.type], found.type)

────────────────────
_ do captured-base Operand
    - site SyntaxId

` The environment `find-captured` found a slot in: that of the turn of a loop, the
` function's own, or the one it was given, or one as many links out from that as there
` are environments between. A slot the capture of a `do without gc` block refers to is found
` where the address it holds leads.
. nothing = make-operand(.operand-void, 0)
if turn != no-local || turn-place != no-place
    = turn-held(turn, turn-place, site)
if hops == no-hops
    if unit.environment == no-local
        refuse(.refused-expression, site)
        = nothing
    = load-local(unit.environment, site)
if !unit.received
    refuse(.refused-expression, site)
    = nothing
. base = given-environment(site)
if stepping
    base = load(base, 0, managed-layout, site)
for _ in 0 .. < hops
    base = load(base, 0, managed-layout, site)
if through != no-place
    = load(base, through, pointer-layout, site)
= base

────────────────────
_ do given-environment Operand
    - site SyntaxId

` The environment the function was given: its first argument, or for the function the event
` runtime calls for a section of a class, the one it made for the object it was given.
if made-environment != no-local
    = load-local(made-environment, site)
= make-operand(.operand-argument, 0)

────────────────────
_ do read-captured Typed
    - slot SlotId
    - id SyntaxId
    - type TypeId

` The value of a local or an argument that nested functions capture, read from the
` environment that holds it. Where the type pass narrowed an optional one to what it
` holds, or a union to a case, the read is of that, as a local's is.
. nothing = make-operand(.operand-void, 0)
. field = find-captured(slot, id)
. held = field.type
. cased = held != type && facts.plan-of(unit.reading, id) == .plan-case-read
if held != type && !holds(held, type) && !cased
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. value = take(captured-base(id), field, id)
if held == type
    = Typed(value, held)
if shared-depth != 0
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
if cased
    = read-case(id, value, held, type)
= payload(id, Typed(value, held))

────────────────────
_ do keep-captured
    - slot SlotId
    - value Operand
    - type TypeId
    - site SyntaxId

` Stores a value in a local or an argument that nested functions capture: in the
` environment that holds it, through the write barrier where it is a managed pointer.
. field = find-captured(slot, site)
if field.type != type
    refuse(.refused-statement, site)
    =
. base = captured-base(site)
if tables.layouts.is-struct(field.layout)
    store-struct(base, field, value, site)
else if field.layout != void-layout
    store(base, field.offset, value, is-managed-pointer(field.layout), site)

────────────────────
_ do check-property ?! Refused
    - position U32
    - syntax SyntaxId

` Gives a property of the object being made its first value where its flag says it has none,
` and sets the flag, as the reference evaluates a property a read on some paths alone gives its
` value. A value run in a live action of its own notes what it reads in the trackers made for it
` where the constructor began; one with none has no shape here.
. flag = filling.checks[position]
. unit-id = tables.value-unit(filling.start + position)
. live = unit-id != no-instance && instances.rows[unit-id].is-live
if flag == no-local || filling.filled[position] == 1 || (live && filling.trackers[position] == no-local)
    refuse(.refused-expression, syntax)
    =
. given = ir.reserve-block()
. done = ir.reserve-block()
branch(load-local(flag, syntax), done, given)
ir.start-block(given)
filling.filled[position] = 0
checking += 1
store-property(position, syntax)
checking -= 1
store-local(flag, integer(.machine-u8, 1), syntax)
jump(done)
ir.start-block(done)

────────────────────
_ do slot-offset U32
    - slot SlotId
    - id SyntaxId

` The place of a slot in the columns, or a refusal for a slot of another binding.
if unit.reading != unit.instance || slot < unit.slot-start || slot - unit.slot-start >= unit.slot-count
    refuse(.refused-expression, id)
    = 0
= slot - unit.slot-start

────────────────────
_ do emit-statements

match? tree.nodes[tree.root]
    | .node-top-level-syntax(row)
        for statement in tree.children[row.statements]
            if tables.runs-statement(unit.source-module, probe-decl(), tree, statement)
                emit-statement(statement)

────────────────────
_ do end-main

` Where the statements of the program's main end, before its cleanups run: the call of `end-main`
` of core that the type pass recorded at the main's node.
=? if !program.runs-main(function.module)
. fact = facts.first-call(unit.reading, tree.root)
if fact != no-fact
    call-instance(facts.calls[fact].callee, tree.root, pending.length)

────────────────────
_ do emit-block
    - body SyntaxId
    - ruled Bool = false

` The statements of a body in order: those of a block, or the one statement the body is, but
` the lines that are the rule's own where the body is a class's `• This` that writes its markup
` (`ruled`), and with the lines of a class's markup that declare properties it gives values
` (`content-property`). The cleanups the body opens run where it ends. Nothing after a
` statement that leaves is emitted, as the type pass checked none of it.
. mark = open-cleanups.length
. own-scoping = scoping
scoping = scoping.block-base = mark
clear-turn-lazies(body)
raise-elements(body)
match? tree.nodes[body]
    | .node-block(row)
        for statement in tree.children[row.body]
            . runs = tables.runs-statement(unit.source-module, probe-decl(), tree, statement) || (tree.nodes[statement] is .node-property-syntax && tree.content-property(statement))
            if runs && !(ruled && tree.rule-part(statement))
                emit-statement(statement)
            if facts.is-leaving(unit.reading, statement)
                break
        close-cleanups(mark)
        scoping = own-scoping
        =
emit-statement(body)
close-cleanups(mark)
scoping = own-scoping

────────────────────
_ do emit-do-body
    - id SyntaxId
    - body SyntaxId
    - effects CompilationEffect

` The body of a `do` block. One kept from the collector, written outside the zone, is a region
` of its own; any other runs in place, kept from what the block names as well.
if (effects /and/ CompilationEffect.gc-free) != 0 && !in-zone
    emit-region(id)
    =
. outer = block-effects
block-effects = block-effects /or/ restrictions-of(dispatch-effects(effects))
emit-block(body)
block-effects = outer

────────────────────
_ do emit-cancel-held
    - id SyntaxId
    - body SyntaxId
    - effects CompilationEffect

` `do without cancel`: the task holds off its cancellation from where the block begins to where
` it is left, by any way out, as a cleanup the block opens lets go. In a cleanup being run, the
` hold is let go where the block ends, by a pad of its own that a check made in it lands on
` before the cleanup's landing, and where an error or a `break` leaves it (`leave-held`).
. caught = landing
if scoping.cleaning && caught == no-block
    refuse(.refused-statement, id)
    =
call-runtime(.runtime-enter-cancel-shield, id, pending.length)
. mark = open-cleanups.length
. own-scoping = scoping
scoping = scoping.block-base = mark
open-cleanup(id, UseCell(no-local, no-local, no-type))
if !scoping.cleaning
    emit-do-body(id, body, effects)
    close-cleanups(mark)
    scoping = own-scoping
    =
. pad = ir.reserve-block()
. checks = landings
landing = pad
emit-do-body(id, body, effects)
. landed = landings != checks
end-in-cleanup(mark, caught)
if landed
    . onward = ir.reserve-block()
    jump(onward)
    ir.start-block(pad)
    call-runtime(.runtime-leave-cancel-shield, id, pending.length)
    jump(caught)
    ir.start-block(onward)
scoping = own-scoping

────────────────────
_ do leave-held Bool
    - from Size
    - site SyntaxId

` Where a way out of a cleanup being run leaves what was opened in it from `from` on: each
` `do without cancel` block's hold is let go, newest first. Anything else opened there has no
` shape on such a way out, and then nothing is let go.
for position in from .. < open-cleanups.length
    . opened = open-cleanups[position]
    =? false if opened.cell.is-live-call || !(tree.nodes[opened.body] is .node-do-block)
. position = open-cleanups.length
while position > from
    position -= 1
    call-runtime(.runtime-leave-cancel-shield, site, pending.length)
= true

────────────────────
_ do open-uses

` Where the function's binding has a `use`, the entry goes on to a head emitted once the body
` is, which clears the flag of each cell a `use` keeps its object in, and the body starts in a
` block of its own.
use-head = no-block
while use-flags.length != 0
    use-flags.pop()
if unit.instance == no-instance || stepping || instances.rows[unit.instance].binding == no-binding
    =
. range = bindings.bindings[instances.rows[unit.instance].binding].scans
. found = false
for scan in range.start .. < range.start + range.count
    if bindings.scans[scan].use-expressions != 0
        found = true
if !found
    =
use-head = ir.reserve-block()
use-body = ir.reserve-block()
jump(use-head)
ir.start-block(use-body)

────────────────────
_ do close-uses

` The head the entry goes on to in a function that has a `use`: each flag cleared, then the
` body.
if use-head == no-block
    =
ir.start-block(use-head)
for flag in use-flags
    store-local(flag, integer(.machine-u8, 0), 0)
jump(use-body)

────────────────────
_ can-use Bool
    - kept Bool

` Whether a `use` has a shape here: reading its own facts, and wherever `do finally` has one.
` One that keeps its object in a cell needs a function whose head clears the flags of its
` cells. In a generator, only one that keeps its object has a shape, which its slot keeps,
` and not in the loop of a comprehension or a list of feeds.
allowed && !is-free(unit.instance) && (stepping || !kept || use-head != no-block)
.. allowed = unit.reading == unit.instance && !scoping.cleaning && !builds && !initializes && (!stepping || generates)
.. generates = kept && given-loop == 0 && feeds == 0

────────────────────
_ do use-cell UseCell
    - id SyntaxId
    - type TypeId

` The cell a `use` keeps its object in, in the block being emitted: the one the cleanup the
` block opened for the node reads, or else a new one and the cleanup that reads it. A
` generator has none: its slot keeps the object.
for position in scoping.block-base .. < open-cleanups.length
    if open-cleanups[position].body == id
        = open-cleanups[position].cell
. layout = layout-of(type, id)
. cell = if stepping then UseCell(no-local, no-local, type) else UseCell(ir.add-local(u8-layout), ir.add-local(layout), type)
if !stepping
    use-flags += cell.flag
open-cleanup(id, cell)
= cell

────────────────────
_ do keep-used
    - id SyntaxId
    - cell UseCell
    - object Operand

` Keeps the object of a `use` where its end reads it: in its cell, with its flag set, or in
` the slot the binder declared for it, as an optional that holds it.
if cell.held != no-local
    store-local(cell.held, object, id)
    store-local(cell.flag, integer(.machine-u8, 1), id)
    =
. slot = using-slot(id)
. kept = facts.slot-type(unit.instance, slot-offset(slot, id))
if types.optional-inner(kept) != cell.type
    refuse(.refused-expression, id)
    =
. wrapped = wrap(id, Typed(object, cell.type), kept)
keep-state(slot, wrapped.operand, kept, id)

────────────────────
_ do using-slot SlotId
    - id SyntaxId

` The slot the binder declared for a `use`, in the function emitted.
. binding = instances.rows[unit.reading].binding
. slot = no-slot
if binding != no-binding && unit.reading == unit.instance
    slot = bindings.using-slot(binding, id)
if slot == no-slot
    refuse(.refused-expression, id)
= slot

────────────────────
_ do emit-use Typed
    - id SyntaxId
    - expr SyntaxId

` `use`: the subject is evaluated, and its `begin-using`, the first call the type pass recorded
` at the node, gives the value, or the subject itself where it only closes (`only-closes`). The
` object is then kept in the node's cell of the block being emitted, whose cleanup ends it where
` the block is left, by any way out. A subject written `use?` that holds nothing is used by
` nothing, and gives the optional that holds nothing; one that holds a value, or that the flow
` knows does, gives what `begin-using` gives, or itself, as an optional.
. nothing = make-operand(.operand-void, 0)
. type = facts.node-type(unit.reading, id)
. begins = facts.first-call(unit.reading, id)
if !can-use(true) || begins == no-fact
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. chain = tree.chained-subject(expr)
. subject = emit-expression(if chain != 0 then chain else expr)
. joined = no-block
. made = void-layout
. slot = nothing
. mark = joins.length
. tests = chain != 0 && types.is-optional(subject.type)
if tests
    . held = subject.type
    made = layout-of(type, id)
    . empty = ir.reserve-block()
    . filled = ir.reserve-block()
    joined = ir.reserve-block()
    slot = join-slot(made)
    branch(present(id, subject).operand, filled, empty)
    ir.start-block(empty)
    arrive(id, empty-optional(type, made).operand, joined, slot)
    ir.start-block(filled)
    subject = payload(id, Typed(subject.operand, held))
. object-type = subject.type
. cell = use-cell(id, object-type)
. used = subject
if !only-closes(begins)
    . called = call-protocol(id, begins, subject.operand, object-type, nothing)
    used = Typed(called.operand, instances.signatures[facts.calls[begins].callee].returns)
keep-used(id, cell, subject.operand)
if chain != 0 && used.type != type
    used = wrap(id, used, type)
if !tests
    = used
arrive(id, used.operand, joined, slot)
= Typed(close-joins(joined, mark, made, slot), type)

────────────────────
_ do emit-use-block
    - id SyntaxId
    - subject SyntaxId
    - body SyntaxId

` `do use`: the subject is evaluated, and its `begin-using`, where it has one, called and what
` it gives dropped. The body runs in a block of its own, which ends the use of the subject where
` it is left, by any way out. A subject written `use?` that holds nothing runs nothing.
. begins = facts.first-call(unit.reading, id)
if !can-use(false) || begins == no-fact
    refuse(.refused-statement, id)
    =
. chain = tree.chained-subject(subject)
. object = emit-expression(if chain != 0 then chain else subject)
. done = no-block
if chain != 0 && types.is-optional(object.type)
    . held = object.type
    . filled = ir.reserve-block()
    done = ir.reserve-block()
    branch(present(id, object).operand, filled, done)
    ir.start-block(filled)
    object = payload(id, Typed(object.operand, held))
. type = object.type
. cell = UseCell(no-local, ir.add-local(layout-of(type, id)), type)
if !only-closes(begins)
    call-protocol(id, begins, object.operand, type, make-operand(.operand-void, 0))
store-local(cell.held, object.operand, id)
. mark = open-cleanups.length
. own-scoping = scoping
scoping = scoping.block-base = mark
open-cleanup(id, cell)
emit-block(body)
close-cleanups(mark)
scoping = own-scoping
if done != no-block
    jump(done)
    ir.start-block(done)

────────────────────
_ only-closes Bool
    - begins FactId

` Whether a `use` closes what it uses, which has no `begin-using`: the type pass recorded only
` its `close` at the node.
facts.calls[begins].next == no-fact

────────────────────
_ do emit-forwarder
    - forward SwapForward

` A door a fake answers under a `do with`: it reads the fake from its effect's slot, where the
` `do with` or what holds its state put it, and calls the fake's method with it and the door's
` arguments, giving what that gives. Typed only under the binding, it finds the slot bound. Where
` the fake's class has no method that answers it, which only a door a function value reaches
` lets through, it panics.
. row = instances.rows[unit.instance]
. declared = match program.modules[row.module].decls[row.decl]
    | .decl-function(fn)
        fn.syntax
    ??
        0u32
. own = instances.signatures[unit.instance]
for position in 0 .. < own.args.count
    ir.add-argument(layout-of(instances.argument-type(unit.instance, position), declared))
returns-type = own.returns
ir.returns = layout-of(own.returns, declared)
if own.errors.count != 0
    return-results(own.result, declared)
if forward.callee == no-instance
    . name = program.effects.names[forward.effect].text
    raise-text(declared, "The fake bound to '$name' has no method '${paths-name(row)}' to answer its door")
    =
. slot = tables.storage-of(forward.module, forward.decl)
if slot == no-storage || tables.instance-functions[forward.callee] == no-function
    refuse(.refused-function, declared)
    =
. theirs = instances.signatures[forward.callee]
. kept = tables.storage[slot]
. state = stack-state(slot, declared)
. fake = take(state, tables.layouts.field(kept.layout, 1), declared)
. mark = pending.length
pending += fake
for position in 0 .. < own.args.count
    pending += make-operand(.operand-argument, position)
. forwards = theirs.errors.count != 0
takes-result = forwards
. answer = call-method(forward.callee, declared, mark, true)
if forwards && theirs.result != own.result
    return-recased(answer.operand, theirs.result, declared, no-instance, declared)
else if forwards
    return-held(answer.operand)
else if own.returns == types.void-type
    return-nothing()
else
    return-value(answer.operand, 0)

────────────────────
_ do emit-dispatch
    - declared SyntaxId
    - signature InstanceSignature

` A door reached where no `do with` binds a fake to its effect, in a program that binds one
` somewhere, as code a function value runs is: where the effect's slot holds a fake, it calls the
` door typed under a binding of that fake's class with its arguments and gives what that gives,
` which panics where that class has no method that answers it. It runs its body where the slot
` holds none.
. kind = make-operand(.operand-void, 0)
. read = false
for dispatch in facts.swap-dispatches
    if dispatch.instance == unit.instance
        . slot = tables.storage-of(dispatch.module, dispatch.decl)
        if slot == no-storage
            refuse(.refused-function, declared)
            =
        if !read
            . kept = tables.storage[slot]
            . flag = tables.layouts.field(kept.layout, 0)
            kind = load(stack-state(slot, declared), flag.offset, flag.layout, declared)
            read = true
        . chosen = ir.reserve-block()
        . next = ir.reserve-block()
        branch(compare(declared, .compare-equal, kind, integer(.machine-u8, dispatch.kind as U64)), chosen, next)
        ir.start-block(chosen)
        . mark = pending.length
        for position in 0 .. < signature.args.count
            pending += make-operand(.operand-argument, position)
        takes-result = signature.errors.count != 0
        . answer = call-instance(dispatch.forwarder, declared, mark)
        if signature.errors.count != 0
            return-held(answer.operand)
        else if signature.returns == types.void-type
            return-nothing()
        else
            return-value(answer.operand, 0)
        ir.start-block(next)

────────────────────
_ do paths-name String
    - row Instance

= match program.modules[row.module].decls[row.decl]
    | .decl-function(fn)
        if fn.name then fn.name.text else ""
    ??
        ""

────────────────────
_ do emit-stack-binding
    - id SyntaxId
    - value SyntaxId
    - body SyntaxId

` `do with`: the global is bound to the value, converted to its type, for the body. The slot's
` state is kept and the slot bound, and the body runs in a block of its own, whose reads of
` the global read the value, and which puts the slot back as it was where it is left, by any
` way out. One written where `do finally` has no shape has none. An effect is bound to a fake,
` an object of any class, as it is.
if scoping.cleaning || builds || initializes || is-free(unit.instance) || unit.reading != unit.instance
    refuse(.refused-statement, id)
    =
. row = stack-row(id)
if row == no-storage
    refuse(.refused-statement, id)
    =
. kept = tables.storage[row]
. fakes = program.modules[kept.module].decls[kept.decl] is .decl-effect
. bound = if fakes then emit-expression(value) else convert(id, .reason-assignment, emit-expression(value))
if bound.type != kept.type && !fakes
    refuse(.refused-conversion, id)
    =
. held = ir.add-local(if fakes then managed-layout else layout-of(kept.type, id))
store-local(held, bound.operand, id)
. previous = ir.add-local(kept.layout)
. slot = stack-slot(kept, id)
store-local(previous, slot, id)
. flag = if fakes then fake-kind(kept, bound.type) else 1u32
if flag == 0 || flag > 255
    refuse(.refused-statement, id)
    =
fill-stack(slot, kept, load-local(held, id), id, flag)
. mark = open-cleanups.length
. own-scoping = scoping
scoping = scoping.block-base = mark
open-cleanup(id, UseCell(no-local, previous, no-type))
stack-bindings += StackBinding(row, held, flag)
emit-block(body)
stack-bindings.pop()
close-cleanups(mark)
scoping = own-scoping

────────────────────
_ do fake-kind U32
    - kept GlobalStorage
    - fake TypeId

. effect = program.effects.index-of(kept.module, kept.decl)
= if effect then instances.fake-kind(effect, fake) else 0u32

────────────────────
_ stack-row U32
    - id SyntaxId

` The storage of the global a `do with` binds.
|? global.kind != .resolve-global || tables.global-kind(global.module, global.decl) != .global-stack
    no-storage
??
    tables.storage-of(global.module, global.decl)

.. global = bindings.resolution-of(instances.rows[unit.reading].binding, id)

────────────────────
_ do stack-bound Bool
    - row U32

` Whether a binding of a global `do with` binds is open around what is being emitted.
for bound in stack-bindings
    if bound.bind == row
        = true
= false

────────────────────
_ do stack-slot Operand
    - kept GlobalStorage
    - site SyntaxId

` The slot of a global `do with` binds, in the memory of the task running.
= address(task-locals(site), kept.offset, kept.layout, site)

────────────────────
_ do fill-stack
    - target Operand
    - kept GlobalStorage
    - value Operand
    - site SyntaxId
    - bound U32 = 1

` Binds the state of a global `do with` binds, where it is kept, to a value: the flag is set,
` for an effect to the number of the fake's class, and the value stored, through the write barrier
` where it is a managed pointer.
. flag = tables.layouts.field(kept.layout, 0)
. held = tables.layouts.field(kept.layout, 1)
store(target, flag.offset, integer(.machine-u8, bound as U64), false, site)
if tables.layouts.is-struct(held.layout)
    copy
        - address(target, held.offset, held.layout, site)
        - value
        - held.layout
        - tables.layouts.rows[held.layout].is-managed
        - site
else if held.layout != void-layout
    store(target, held.offset, value, is-managed-pointer(held.layout), site)

────────────────────
_ do read-stack Typed
    - id SyntaxId
    - row U32

` A read of a global `do with` binds: the value of a binding of it open around the read in
` the function, or else the value its state holds, which raises a panic where it is not
` bound. That state is what a spawned task's body captured, or else the slot of the task
` running. A cleanup a landing pad runs is emitted once for all the checks that land there,
` where TypeScript reads what is bound where the panic was made, so a read in one is refused
` where a `do with` after the cleanup binds the global.
. nothing = make-operand(.operand-void, 0)
. kept = tables.storage[row]
if unit.reading != unit.instance || (scoping.unwinding-from != 0 && binds-after(row, scoping.unwinding-from))
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. position = stack-bindings.length
while position != 0
    position -= 1
    if stack-bindings[position].bind == row
        = Typed(load-local(stack-bindings[position].value, id), kept.type)
if !function.may-panic && !in-landing
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. state = stack-state(row, id)
. flag = tables.layouts.field(kept.layout, 0)
. unbound = ir.reserve-block()
. ready = ir.reserve-block()
. current = load(state, flag.offset, flag.layout, id)
branch(compare(id, .compare-equal, current, integer(.machine-u8, 1)), ready, unbound)
ir.start-block(unbound)
raise-text(id, "Stack-local variable '${tables.global-name(kept)}' is not bound")
ir.start-block(ready)
= Typed(take(state, tables.layouts.field(kept.layout, 1), id), kept.type)

────────────────────
_ do binds-after Bool
    - row U32
    - site SyntaxId

` Whether a `do with` of the function that begins after a node binds a global.
for scope in facts.stack-scopes
    if scope.instance == unit.reading && scope.first > site && same-storage
        = true
    .. same-storage = tables.storage-of(scope.module, scope.decl) == row
= false

────────────────────
_ do stack-state Operand
    - row U32
    - site SyntaxId

` Where the state of a global `do with` binds is read: in a spawned task's body, the capture
` it was given; in a lambda or a comprehension, the place that holds it in the environment it
` was given, as it was where it was made, which the steps of one that yields reach through the
` link of their own; and anywhere else the slot of the task running.
. kept = tables.storage[row]
if is-closure-body()
    . owner = instances.rows[unit.instance].enclosing
    . place = tables.stack-place(owner, instances.rows[unit.instance].decl, row)
    . held = if owner != no-instance then tables.environments[owner] else no-layout
    if place != no-place && held != no-layout && held != unbuilt-environment
        . field = tables.layouts.field(held, place)
        . held-environment = given-environment(site)
        if stepping
            held-environment = load(held-environment, 0, managed-layout, site)
        = address(held-environment, field.offset, field.layout, site)
    refuse(.refused-expression, site)
    = make-operand(.operand-void, 0)
if function.kind != .task-body
    = stack-slot(kept, site)
. layout = tables.captures[unit.instance]
. stacks = tables.stack-holds(unit.instance)
if layout != no-layout && layout != unbuilt-environment && tables.capture-rows[unit.instance] != no-place
    for index in 0 .. < stacks.length
        if stacks[index] == row
            . held = tables.capture-stacks(unit.instance) + index
            . field = tables.layouts.field(layout, held as U32)
            = address(make-operand(.operand-argument, 0), field.offset, field.layout, site)
refuse(.refused-expression, site)
= make-operand(.operand-void, 0)

────────────────────
_ do capture-stack
    - capture Operand
    - field LayoutField
    - row U32
    - site SyntaxId

` Stores in the capture of a spawned task, or in the environment a lambda is made with, the
` state of a global `do with` binds as it is where the task is spawned or the lambda made:
` bound to the value of a binding of it open there, or else as the function reads it.
if row == no-storage
    refuse(.refused-statement, site)
    =
. kept = tables.storage[row]
. target = address(capture, field.offset, field.layout, site)
. position = stack-bindings.length
while position != 0
    position -= 1
    if stack-bindings[position].bind == row
        fill-stack(target, kept, load-local(stack-bindings[position].value, site), site, stack-bindings[position].flag)
        =
copy(target, stack-state(row, site), kept.layout, tables.layouts.rows[kept.layout].is-managed, site)

────────────────────
_ do emit-statement ?! Refused
    - id SyntaxId

` One statement. An expression written as a statement is evaluated, and its value dropped: one that
` is no call and whose value is an error has no shape here. A probe is compiled only where probes
` are asked for (`emit-probe-statement`): elsewhere it emits nothing, and nothing of it is
` evaluated. A lazy
` local emits nothing where it is declared: its value is evaluated where it is read. Nor does a
` local of a row of a markup loop region read as a getter. A block written for a feature of the
` compiler the program does not use emits nothing: the type pass typed none of it. Nor does the body
` of a branch written with a pattern, whose statements run in the arm of its condition. A match of a
` subject is run for what its arms do, as the reference compiles one written as a statement. A line
` of a markup element's body that the element takes is given to it. A statement that follows one
` that left a call crossing the zone the collector never sees unsettled has no shape. A line of a
` class's markup that declares a property stores its value there as an assignment does
` (`content-property`).
if zone-answer != 0
    refuse(.refused-statement, id)
    =
if tree.is-probe(id)
    if compiles-probe(id)
        emit-probe-statement(id)
    =
. link = facts.content-link-of(unit.reading, id)
if link != U32.max
    if facts.content-links[link].call != no-fact
        emit-content(id, facts.content-links[link])
    =
. named = facts.named-store-of(unit.reading, id)
if named != U32.max
    . made = emit-expression(id)
    store-named(id, named, made)
    =
match tree.nodes[id]
    | .node-noop
        =
    | .node-slot-outlet(row)
        do emit-outlet(id, row.name, row.body)
    | .node-print(row)
        emit-print(id, row.body)
    | .node-assertion-syntax(row)
        emit-raise(id, row.exception, row.condition)
    | .node-probe-snapshot
        refuse(.refused-probe, id)
    | .node-probe-preview
        refuse(.refused-probe, id)
    | .node-declare(row)
        if row.rollback && !row.is-lazy
            refuse(.refused-statement, id)
        else if !row.is-lazy && !declares-getter(row.left)
            emit-declare(id, row.left, tree.machine-or-value(row.left, row.right))
    | .node-assign(row)
        . live = tables.live-statement-of(unit.instance, id)
        if live && unit.reading == unit.instance
            emit-live-statement(id, live, row.lhs, row.rhs)
        else
            emit-assign(id, row.op, row.lhs, row.rhs)
    | .node-property-syntax(row)
        . live = tables.live-statement-of(unit.instance, id)
        if live && unit.reading == unit.instance
            emit-live-statement(id, live, tree.content-property-name(id), row.value)
        else
            emit-assign(id, .eq-op, tree.content-property-name(id), row.value)
    | .node-if-block(row)
        if row.is-optional
            refuse(.refused-statement, id)
        else
            emit-if(id, row.condition, row.body, row.next)
    | .node-while-block(row)
        if row.is-optional
            refuse(.refused-statement, id)
        else
            emit-while(id, row.condition, row.body)
    | .node-for-block(row)
        if row.next != 0
            refuse(.refused-statement, id)
        else
            emit-for(id, row.loop, row.body)
    | .node-iterator-expression(row) { facts.plan-of(unit.reading, id) == .plan-content-loop }
        if row.next != 0
            refuse(.refused-statement, id)
        else
            emit-for(id, row.loop, row.body)
    | .node-iterator-expression(row) { subscribing == id }
        match? tree.nodes[row.loop]
            | .node-loop-syntax(loop)
                emit-subscriber(row.loop, tested(row.loop, loop.clause), row.body, id)
    | .node-do-block(row)
        . is-off = !tables.compiles-features(row.feature-gate-features)
        if row.holds-cancel && !is-off
            emit-cancel-held(id, row.body, row.compilation-effects)
        else if !is-off
            emit-do-body(id, row.body, row.compilation-effects)
    | .node-block
        emit-block(id)
    | .node-do-finally-block(row)
        emit-finally(id, row.body)
    | .node-use-block(row)
        emit-use-block(id, row.subject, row.body)
    | .node-stack-local-binding-block(row)
        emit-stack-binding(id, row.value, row.body)
    | .node-do-task-block(row)
        . worker = if row.is-parallel then 0 else row.worker
        do emit-spawn(id, worker, row.is-parallel, row.scheduling == .task-scheduling-priority, row.large-stack)
    | .node-break
        if breaks-subscription()
            unsubscribe(id)
            emit-leave(id, false)
        else
            emit-leave(id, true)
    | .node-continue
        emit-leave(id, false)
    | .node-yield(row)
        emit-yield(id, row.expr, row.does-yield-all)
    | .node-return(row)
        emit-return(id, row.expr)
    | .node-return-if-true(row)
        emit-return-if(id, row.condition, row.expr)
    | .node-match-expression(row)
        if row.subject != 0 && helper-runs(row.helper)
            emit-subject-match(id, row.subject, row.body, row.is-optional, row.helper, true)
        else
            emit-expression(id)
    | .node-structure-match(row)
        . type = facts.node-type(unit.reading, id)
        if type == no-type || type == invalid-type || type == types.void-type
            run-arms(id, row.pattern)
        else
            emit-expression(id)
    | .node-catch-expression(row)
        . handled = row.catchers.count != 0 && is-caught(row.body)
        if tree.transformer-exception(row.body, row.catchers) != 0
            if row.catchers.count > 1 && tree.catchers-bind(row.catchers)
                refuse(.refused-statement, id)
        else if handled && !carries-error(facts.node-type(unit.reading, id))
            emit-handled(id, row.body, row.catchers, true)
        else
            . emitted = emit-expression(id)
            if emitted.type != no-type && extends(emitted.type, types.error-type)
                refuse(.refused-statement, id)
    ??
        . emitted = emit-expression(id)
        if emitted.type != no-type && uncaught-error
            refuse(.refused-statement, id)
        .. uncaught-error = extends(emitted.type, types.error-type) && !is-caught(id)

────────────────────
_ do emit-arm-index Typed
    - id SyntaxId
    - selected TypeId
    - keeps LocalId = no-local

` The index of the arm of a markup branch region to select, as the reference's
` `markupIfConditionArm` chooses it: that of the first arm whose condition holds, the
` conditions tested in turn, or else that of the first arm with no condition, or none. An arm
` written with a pattern holds where its subject matches it, tested binding nothing, as the
` reference's `markupIfActiveArm` tests it; an arm so chosen is selected again whatever arm the
` region holds, which `keeps` says where it is given: false for such an arm, else true. That of
` a match region is `emit-pattern-index`'s. That of a slot outlet that is a region is its one
` arm's, once the name its parameter gives is read, as the reference's `selectArm` reads it.
. nothing = make-operand(.operand-void, 0)
. layout = layout-of(selected, id)
if is-null-form(selected) || !tables.layouts.is-struct(layout)
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. inner = tables.layouts.field(layout, 0)
. flag = tables.layouts.field(layout, 1)
if !is-integer(inner.layout)
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. held = frame(layout)
zero(held, layout)
if tree.nodes[id] is .node-match-expression
    emit-pattern-index(id, held, inner, flag)
    = Typed(held, selected)
match? tree.nodes[id]
    | .node-markup-slot-parameter(row)
        do emit-expression(row.name)
        store(held, inner.offset, integer(inner.layout as MachineKind, 0), false, id)
        store(held, flag.offset, integer(.machine-i8, 1), false, id)
        = Typed(held, selected)
. done = ir.reserve-block()
if keeps != no-local
    store-local(keeps, integer(.machine-u8, 1), id)
. fallback U32 = U32.max
. index U32
. arm = id
while arm != 0
    . next SyntaxId = 0
    match? tree.nodes[arm]
        | .node-if-block(row)
            . pattern = tree.pattern-arm(arm)
            if pattern != 0
                if !test-arm(pattern, tree.matched-subject(row.condition), held, inner, flag, index, done, keeps)
                    ir.start-block(done)
                    = Typed(held, selected)
            else if row.condition == 0
                if fallback == U32.max
                    fallback = index
            else
                . tested = test(row.condition, emit-expression(row.condition))
                . chosen = ir.reserve-block()
                . later = ir.reserve-block()
                branch(tested.operand, chosen, later)
                ir.start-block(chosen)
                store
                    - held
                    - inner.offset
                    - integer(inner.layout as MachineKind, index)
                    - false
                    - arm
                store(held, flag.offset, integer(.machine-i8, 1), false, arm)
                jump(done)
                ir.start-block(later)
            next = row.next
    index += 1
    arm = next
if fallback != U32.max
    store(held, inner.offset, integer(inner.layout as MachineKind, fallback), false, id)
    store(held, flag.offset, integer(.machine-i8, 1), false, id)
jump(done)
ir.start-block(done)
= Typed(held, selected)

────────────────────
_ do test-arm Bool
    - arm SyntaxId
    - subject SyntaxId
    - held Operand
    - inner LayoutField
    - flag LayoutField
    - index U32
    - done IRBlockId
    - keeps LocalId

` Tests an arm of a markup branch region written with a pattern: its subject read, a struct
` copied, and matched against the pattern binding nothing; where it matches, `held` gets the
` arm's index, `keeps` false, and the test goes to `done`, and else on. False where the pattern
` always matches, so no arm after it is tested, or once refused.
if facts.plan-of(unit.reading, arm) == .plan-never
    = true
. value = emit-expression(subject)
. type = value.type
value = Typed(apart(value, subject, true), value.type)
. later = ir.reserve-block()
. jumps = fail-jumps
. own-matching = matching
matching = matching.testing = true
matching = matching.tested = subject
match? tree.nodes[arm]
    | .node-type-transform(row)
        if row.pattern != 0
            emit-pattern(row.pattern, Typed(value.operand, type), later)
matching = own-matching
store(held, inner.offset, integer(inner.layout as MachineKind, index), false, arm)
store(held, flag.offset, integer(.machine-i8, 1), false, arm)
if keeps != no-local
    store-local(keeps, integer(.machine-u8, 0), arm)
jump(done)
if fail-jumps == jumps
    = false
ir.start-block(later)
= true

────────────────────
_ do emit-pattern-index
    - id SyntaxId
    - held Operand
    - inner LayoutField
    - flag LayoutField

` Stores in `held` the index of the arm of a markup match region to select, as the reference's
` `markupMatchActiveArm` chooses it: the subject is read once, a struct copied, and each arm's
` pattern tested against it in turn, binding nothing; that of the first that matches, or none.
` The arms after one that always matches are not tested.
. subject SyntaxId = 0
match? tree.nodes[id]
    | .node-match-expression(row)
        subject = row.subject
. value = emit-expression(subject)
. type = value.type
value = Typed(apart(value, subject, true), value.type)
. done = ir.reserve-block()
. index U32
for arm in tree.region-arms(id)
    if facts.plan-of(unit.reading, arm) != .plan-never
        . later = ir.reserve-block()
        . jumps = fail-jumps
        . own-matching = matching
        matching = matching.testing = true
        matching = matching.tested = subject
        match? tree.nodes[arm]
            | .node-type-transform(row)
                if row.pattern != 0
                    emit-pattern(row.pattern, Typed(value.operand, type), later)
        matching = own-matching
        store(held, inner.offset, integer(inner.layout as MachineKind, index), false, arm)
        store(held, flag.offset, integer(.machine-i8, 1), false, arm)
        jump(done)
        if fail-jumps == jumps
            ir.start-block(done)
            =
        ir.start-block(later)
    index += 1
jump(done)
ir.start-block(done)

────────────────────
_ do emit-resource
    - declared SyntaxId
    - id SyntaxId

` The function the action of a markup loop region runs, given the environment the region was
` made in: the container is read again with the trackers of the action noting what it reads,
` the members of the region's host read by their names alone, and given to the region, read
` from where it was kept, by the markup runtime's replacer the type pass recorded at the `for`,
` as the reference's `collection-source` function does.
. live = instances.live
. region = facts.loop-region-of(instances.rows[unit.instance].enclosing, id)
. slot = channel-slot(id)
. container = tree.region-container(id)
if !region || slot == no-slot || region.replace == no-instance || unanchored
    refuse(.refused-function, declared)
    =
.. unanchored = container == 0 || live.previous == no-instance || live.next == no-instance
. previous = ir.add-local(managed-layout)
store-local(previous, call-instance(live.previous, id, pending.length).operand, id)
. next = ir.add-local(managed-layout)
store-local(next, call-instance(live.next, id, pending.length).operand, id)
. made-type = instances.signatures[region.create].returns
. host = read-captured(slot, id, region.host)
. made = read-captured(slot + 1, id, made-type)
live-actions += LiveTrackers(previous, next)
content-hosts += Typed(host.operand, region.host)
content-roots += make-operand(.operand-void, 0)
. source = emit-expression(container)
content-hosts.pop()
content-roots.pop()
live-actions.pop()
if source.type != region.source
    source = convert(container, .reason-argument, source)
if source.type != region.source
    refuse(.refused-conversion, container)
    =
. mark = pending.length
pending += made.operand
pending += source.operand
do raising-call(id, region.replace, mark)
emit-end(declared)

────────────────────
_ do emit-row-item Typed
    - id SyntaxId
    - name Atom

` A name the row of a keyed markup loop region gives its item by: the row's argument, the
` `MarkupRowItem` that holds the item, is read, the read of its `item` noted in the trackers of
` the live action open where one is, and its `item` read, as the reference's
` `readMarkupRowItem` does.
. held = facts.row-item-of(unit.reading, id)
if !tables.is-class(held)
    refuse(.refused-expression, id)
    = Typed(make-operand(.operand-void, 0), no-type)
. base = emit-identifier(id, name, held)
. item = program.store-atom("item")
if live-actions.length != 0 || facts.pulls(unit.reading, id)
    track(id, base.operand, item)
= load-property(id, base.operand, held, item)

────────────────────
_ do emit-reselect
    - declared SyntaxId
    - id SyntaxId

` The function the action of a markup branch region runs, given the environment the region was
` made in: the index of the arm to select is read again with the trackers of the action noting
` what the conditions read, the members of the region's host read by their names alone, and
` where the region does not keep that arm, the actions the region owns are closed and the
` markup runtime selects it, as the reference's `markup-branch` function does. That of a match
` region selects the arm whatever arm the region holds, as does that of a branch region for an
` arm written with a pattern (`emit-arm-index`).
. live = instances.live
. region = facts.branch-region-of(instances.rows[unit.instance].enclosing, id)
. slot = channel-slot(id)
if !region || slot == no-slot || live.previous == no-instance || live.next == no-instance
    refuse(.refused-function, declared)
    =
. previous = ir.add-local(managed-layout)
store-local(previous, call-instance(live.previous, id, pending.length).operand, id)
. next = ir.add-local(managed-layout)
store-local(next, call-instance(live.next, id, pending.length).operand, id)
live-actions += LiveTrackers(previous, next)
. host = read-captured(slot, id, region.host)
content-hosts += Typed(host.operand, region.host)
content-roots += make-operand(.operand-void, 0)
. patterned = tree.has-pattern-arm(id)
. kept = if patterned then ir.add-local(u8-layout) else no-local
. selected = emit-arm-index(id, region.selected, kept)
content-hosts.pop()
content-roots.pop()
live-actions.pop()
. made-type = instances.signatures[region.create].returns
. made = read-captured(slot + 1, id, made-type)
. given = convert(id, .reason-argument, Typed(made.operand, made-type))
. selecting = ir.reserve-block()
. done = ir.reserve-block()
if region.keeps == no-instance
    jump(selecting)
else
    if patterned
        . asking-block = ir.reserve-block()
        branch(load-local(kept, id), asking-block, selecting)
        ir.start-block(asking-block)
    . asking = pending.length
    pending += given.operand
    pending += selected.operand
    . keeps = raising-call(id, region.keeps, asking)
    branch(keeps.operand, done, selecting)
ir.start-block(selecting)
close-actions(id, made.operand)
. choosing = pending.length
pending += given.operand
pending += selected.operand
do raising-call(id, region.select, choosing)
jump(done)
ir.start-block(done)
emit-end(declared)

────────────────────
_ do emit-arm ?! Refused
    - declared SyntaxId
    - body SyntaxId

` The function that builds an arm of a markup branch region: the arm's body runs as content of
` the region it is given, under the batch in force where the region is written, where the type
` pass found one, read from where it was kept; the region is put under it first, twice, as the
` reference's builder and then its `compileContents` each do. That of an arm of a match region
` runs its body only where its pattern matches the subject (`match-subject`).
. parent = make-operand(.operand-argument, 1)
. type = instances.argument-type(unit.instance, 0)
. batch = make-operand(.operand-void, 0)
. root = facts.region-root-of(unit.reading, body)
if root
    batch = read-captured(root.slot, body, root.batch).operand
    if root.ensure != no-instance
        for pass in 0 .. < 2
            . host = convert(body, .reason-markup-host, Typed(parent, type))
            . given = convert-from(body, .reason-markup-root, batch)
            . mark = pending.length
            pending += host.operand
            pending += given.operand
            call-instance(root.ensure, body, mark)
. matched = tree.body-arm(body)
. failed = ir.reserve-block()
. jumps = fail-jumps
. named = bound.length
if matched != 0 && !match-subject(matched, failed)
    drop-bound(named)
    emit-end(declared)
    =
content-hosts += Typed(parent, type)
content-roots += batch
emit-block(body)
content-hosts.pop()
content-roots.pop()
drop-bound(named)
if fail-jumps != jumps
    . finished = ir.reserve-block()
    jump(finished)
    ir.start-block(failed)
    jump(finished)
    ir.start-block(finished)
emit-end(declared)

────────────────────
_ do match-subject Bool
    - arm SyntaxId
    - failed IRBlockId

` Reads the subject of the match an arm of a markup match region, or of a branch region written
` with a pattern, is one of again, where a member of the region's host read by its name alone is
` read from the host kept where the region was made, copies a struct, and matches the arm's
` pattern against it, going to `failed` where it does not match, binding `it` and the names the
` pattern declares, as the reference's `markupCompileMatchedArm` does. False where the arm can
` never match, or once refused.
if facts.plan-of(unit.reading, arm) == .plan-never
    = false
. subject = tree.matched-subject(tree.arm-match(arm))
. slot = channel-slot(tree.arm-site(arm))
. binding = instances.rows[unit.reading].binding
. site = if slot != no-slot && binding != no-binding then bindings.slots[slot].syntax else 0
. region = facts.branch-region-of(instances.rows[unit.instance].enclosing, site)
if !region || slot == no-slot || subject == 0
    refuse(.refused-function, arm)
    = false
. host = read-captured(slot, arm, region.host)
content-hosts += Typed(host.operand, region.host)
content-roots += make-operand(.operand-void, 0)
. value = emit-expression(subject)
. type = value.type
content-hosts.pop()
content-roots.pop()
value = Typed(apart(value, subject, true), value.type)
. passed = value
match? tree.nodes[arm]
    | .node-type-transform(row)
        if row.pattern != 0
            passed = emit-pattern(row.pattern, Typed(value.operand, type), failed)
. it = arm-slot-of(arm, .slot-it)
if it != no-slot
    bound += BoundValue(it, passed.type, passed.operand)
= true

────────────────────
_ do read-state Typed
    - id SyntaxId
    - object Operand
    - type TypeId
    - state Atom

` Reads the state a style `when` names on an object, as a `Bool`. No instance types the
` `when`, whose node is in the module that writes it, so the read consults no instance's facts.
. own-unit = unit
unit = unit.reading = no-instance
. value = load-property(id, object, type, state, true, types.bool-type)
unit = own-unit
= value

────────────────────
_ do cell-local LocalId
    - cell U32

` The local that keeps a state cell made where code is emitted, or none.
for kept in state-cells
    if kept.row == cell
        = kept.local
= no-local

────────────────────
_ do around-names [SyntaxId]
    - index U32

` The names the rule of the frame of values of a rule around rules written in it
` (`ScopeValues`) takes them by, in order.
. frame = instances.frames[facts.scope-values[index].frame]
. owner = program.modules[frame.module]
. names [SyntaxId]
match? owner.decls[frame.decl]
    | .decl-style-rule(rule)
        match? owner.tree.nodes[rule.syntax]
            | .node-rule-syntax(declared)
                for arg in owner.tree.children[declared.args]
                    match? owner.tree.nodes[arg]
                        | .node-argument-decl(shape)
                            match? owner.tree.nodes[shape.pattern]
                                | .node-type-capture(capture)
                                    names += capture.id
= names

────────────────────
_ around-count U32
    - index U32

` How many values the rule around rules written in it takes (`ScopeValues`).
around-names(index).length as U32

────────────────────
_ do around-local (LocalId, TypeId)
    - index U32
    - position U32

` The local that keeps a value of a rule around rules written in it (`ScopeValues`), by its place
` among them, where code is emitted, and its type: kept where the markup element that gave it
` applied the rule (`bind-rule-values`), or given this function (`take-values`); none where it is
` neither.
. held = facts.scope-values[index]
if held.instance != unit.instance
    = (no-local, no-type)
if held.argument != U32.max || held.kept != U32.max
    . found = taken-place(index)
    if !found
        = (no-local, no-type)
    . place = taken-values[found].first + position
    = (around-values[place].local, around-values[place].type)
. written = program.modules[held.module].tree
match? written.nodes[held.site]
    | .node-style-rule-application(applied)
        if position < applied.args.count
            . found = around-place(written.children[applied.args.start + position])
            if found
                = (around-values[found].local, around-values[found].type)
= (no-local, no-type)

────────────────────
_ do around-place Size?
    - written SyntaxId

` Where `around-values` keeps the value a style rule written on a markup element gave for a node.
for position in 0 .. < around-values.length
    if around-values[position].written == written
        = position
= null

────────────────────
_ do taken-place Size?
    - row U32

` Where `taken-values` keeps a row of `scope-values` the function was given.
for position in 0 .. < taken-values.length
    if taken-values[position].row == row
        = position
= null

────────────────────
_ do take-values
    - declared SyntaxId

` Keeps the values of the rules around rules written in rules that the function that fills an
` object with its class's markup is given, each in a local of its own (`taken-values`).
. held = instances.rows[unit.instance].context
if held == U32.max
    =
. context = instances.contexts[held]
for index in 0 .. < facts.scope-values.length
    . row = facts.scope-values[index]
    if row.instance != unit.reading || row.argument == U32.max || taken-place(index as U32) != null
        continue
    taken-values += TakenValues(index as U32, around-values.length as U32)
    for position in 0 .. < around-count(index as U32)
        . place = instances.value-argument(unit.instance, row.argument + position)
        . offset = row.argument + position - instances.context-cell-count(held)
        . type = instances.context-value-types[context.value-first + offset]
        . local = ir.add-local(layout-of(type, declared), false)
        store-local
            - local
            - make-operand(.operand-argument, if unit.takes-self then place + 1 else place)
            - declared
        around-values += AroundValue(0, local, type)

────────────────────
_ do builder-value Typed
    - line SyntaxId

` What a line that gives a slot content gives as the slot's builder: its function, made the
` builder the type pass recorded at the line, with the batch in force kept first where the type
` pass found one, in the local the function reads it from; or, where it forwards a slot, the
` builder of that name this function was given, or reaches through the local that holds it.
. nothing = make-operand(.operand-void, 0)
match? tree.nodes[line]
    | .node-markup-slot-forward(row)
        . fact = facts.slot-outlet-of(unit.reading, row.outlet)
        if fact && fact.argument != U32.max
            . position = fact.argument
            = forward-builder
                - line
                - Typed(make-operand(.operand-argument, if unit.takes-self then position + 1 else position), instances.argument-type(unit.instance, position))
        if fact && fact.held != no-slot
            . type = find-captured(fact.held, line).type
            = forward-builder(line, read-captured(fact.held, line, type))
        refuse(.refused-expression, line)
        = Typed(nothing, no-type)
. root = facts.region-root-of(unit.reading, line)
if root
    . batch = if content-roots.length != 0 then content-roots[content-roots.length - 1] else nothing
    if operand-kind(batch) == .operand-void
        refuse(.refused-expression, line)
        = Typed(nothing, no-type)
    . field = find-captured(root.slot, line)
    keep-captured(root.slot, batch, field.type, line)
= convert(line, .reason-markup-slot, emit-closure(line))

────────────────────
_ do emit-declare ?! Refused
    - id SyntaxId
    - pattern SyntaxId
    - value SyntaxId

` A declaration of one local, with or without a type, of several that take no value, or of
` those a pattern names. A tuple taken apart from an optional panics where it holds nothing.
match tree.nodes[pattern]
    | .node-type-capture(row)
        if row.type != 0 && reads-name(row.type)
            declare-shaped(id, pattern, value)
        else
            declare-local(id, row.id, row.type, value)
    | .node-type-property
        declare-shaped(id, pattern, value)
    | .node-type-and
        declare-shaped(id, pattern, value)
    | .node-type-list
        declare-shaped(id, pattern, value)
    | .node-identifier
        declare-local(id, pattern, 0, value)
    | .node-type-tuple(row)
        if value != 0
            . source = emit-expression(value)
            if types.is-optional(source.type)
                source = unwrap(pattern, source)
            destructure(id, row.field-types, source.operand, source.type, true)
        else
            for field in tree.children[row.field-types]
                emit-declare(id, field, 0)
    | .node-tuple-syntax(row)
        emit-destructure(id, row.items, value, true)
    ??
        refuse(.refused-statement, id)

────────────────────
_ do declare-shaped
    - id SyntaxId
    - pattern SyntaxId
    - value SyntaxId

` A declaration written with a pattern where a name or a type goes: the value is matched
` against the pattern, the names the pattern declares are locals that hold what it captured,
` and where it does not match the declaration panics. A pattern that the reference lets
` fail and go on from, its names unset, has no shape here.
if value == 0
    refuse(.refused-statement, id)
    =
. subject = emit-expression(value)
shape-declared(id, pattern, subject)

────────────────────
_ do shape-declared
    - id SyntaxId
    - pattern SyntaxId
    - subject Typed

` Matches a value a declaration, or the header of a loop, is given against the pattern
` written there, and panics where it does not fit.
if !fails-aloud(pattern)
    refuse(.refused-statement, id)
    =
. failed = ir.reserve-block()
. done = ir.reserve-block()
. own-matching = matching
. jumps = fail-jumps
matching = matching.declaring = true
emit-pattern(pattern, subject, failed)
matching = own-matching
jump(done)
ir.start-block(failed)
. plan = facts.plan-of(unit.reading, tested(pattern))
if fail-jumps == jumps
    jump(done)
else if !function.may-panic || other-plan
    refuse(.refused-statement, id)
else
    raise-text(pattern, "Pattern match failed")
.. other-plan = plan != .plan-unmatched && plan != .plan-list-pattern && plan != .plan-text-pattern
ir.start-block(done)

────────────────────
_ tested SyntaxId
    - pattern SyntaxId

` The pattern that tests what a declaration is given: the one written, or the one a name
` captures.
match tree.nodes[pattern]
    | .node-type-capture(row)
        row.type
    ??
        pattern

────────────────────
_ fails-aloud Bool
    - pattern SyntaxId

` Whether a pattern panics wherever it does not match as a declaration: one that reads a
` name or takes anything always matches, and whatever is joined after a pattern fails aloud,
` as a pattern of items or of texts does.
match tree.nodes[pattern]
    | .node-type-property
        true
    | .node-type-wildcard
        true
    | .node-type-list
        true
    | .node-type-capture(row)
        row.type == 0 || fails-aloud(row.type)
    | .node-type-and(row)
        facts.plan-of(unit.reading, pattern) == .plan-text-pattern || fails-aloud(row.left)
    ??
        false

────────────────────
_ reads-name Bool
    - pattern SyntaxId

` Whether a pattern passes on what a name read from its subject gives: one that reads a
` name, one joined after it, or a name that captures either.
match tree.nodes[pattern]
    | .node-type-property
        true
    | .node-type-and(row)
        reads-name(row.left)
    | .node-type-capture(row)
        row.type != 0 && reads-name(row.type)
    ??
        false

────────────────────
_ do emit-destructure
    - id SyntaxId
    - names RowRange'SyntaxId
    - value SyntaxId
    - declares Bool

` Takes a tuple written as a value apart, into the names written for its fields.
. source = emit-expression(value)
destructure(id, names, source.operand, source.type, declares)

────────────────────
_ do destructure ?! Refused
    - id SyntaxId
    - names RowRange'SyntaxId
    - source Operand
    - owner TypeId
    - declares Bool
    - item Bool = false

` Takes a tuple apart: each of its first fields into a local, a new one or one that exists,
` or into a global that exists. The local has the field's own type, or the type written for
` it where the type pass recorded the field's conversion there, or the type of a local that
` exists, which the type pass recorded the field's conversion to at its name; the global has
` the field's own type. A field written as `_` goes nowhere, and one written as a tuple of names is taken
` apart in turn. A lazy local,
` whose value is evaluated wherever a read comes first, keeps the cell it was first given.
` A local an environment holds is stored there. `item` says the tuple is the item of a
` loop, and the names those its pattern writes. A table or a span of one is taken apart, as
` TypeScript takes it, into a view of each field's column of the type of its local, one name
` after another; one written as `_` still has the table checked.
. layout = layout-of(owner, id)
. tabled = is-row-source(intrinsic(owner))
if !tabled && (!tables.layouts.is-struct(layout) || too-few-fields)
    refuse(.refused-statement, id)
    =
.. too-few-fields = tables.layouts.rows[layout].fields.count < names.count
for position in 0 .. < names.count
    . name = tree.children[names.start + position]
    . annotation SyntaxId = 0
    . skipped = false
    match? tree.nodes[name]
        | .node-type-capture(row)
            name = row.id
            annotation = row.type
        | .node-type-wildcard
            skipped = true
    if skipped
        if tabled
            table-source(id, source, owner, layout)
        continue
    . inner = tree.field-names(name)
    if tabled && inner.count != 0
        refuse(.refused-statement, name)
        =
    if inner.count != 0
        . nested = take(source, tables.layouts.field(layout, position), id)
        destructure(id, inner, nested, field-type(owner, position), declares, item)
        continue
    if !declares
        . kept = assigned-global(name, id)
        if kept != no-storage
            if tabled
                refuse(.refused-statement, name)
                =
            store-part-global
                - name
                - kept
                - take(source, tables.layouts.field(layout, position), id)
                - field-type(owner, position)
            continue
    . slot = local-slot(name, id, true, item)
    . offset = slot-offset(slot, id)
    . held = facts.slot-type(unit.instance, offset)
    if tabled
        . view = table-view(id, source, owner, layout, position, held)
        store-part(id, name, slot, offset, view.operand, held, layout-of(held, name), declares)
        continue
    . field = tables.layouts.field(layout, position)
    . kept = field.layout
    . part = take(source, field, id)
    if held != field-type(owner, position)
        if annotation == 0 && declares
            refuse(.refused-conversion, name)
            =
        . given = Typed(part, field-type(owner, position))
        . converted = if declares then convert(annotation, .reason-declaration, given, name) else convert(name, .reason-assignment, given)
        part = converted.operand
        if converted.type != held
            refuse(.refused-conversion, name)
        kept = layout-of(held, name)
    store-part(id, name, slot, offset, part, held, kept, declares)

────────────────────
_ do declare-local
    - id SyntaxId
    - name SyntaxId
    - annotation SyntaxId
    - value SyntaxId

` Gives a local its cell and stores its first value there: the value written, converted to
` the type written for the local, or the value its type has when none is written. A local
` that holds nothing has no cell, and its value is evaluated for what it does. A local that
` holds a struct holds a copy of the one it is given. A tuple written in parentheses where
` the type goes is a pattern to TypeScript, which converts nothing and names what the pattern
` names, so a value of any other type has no rule here. A local that nested functions
` capture is stored in the environment that holds it. One some read tracks tells no read of
` its first value.
. slot = local-slot(name, id, true, false, true)
. offset = slot-offset(slot, id)
. type = facts.slot-type(unit.instance, offset)
if type == no-type || type == invalid-type
    refuse(.refused-statement, id)
    =
. layout = layout-of(type, id)
. initial = make-operand(.operand-void, 0)
if value != 0
    initial = declared-value(name, annotation, value, type).operand
else if layout != void-layout
    . defaulted = default-value(annotation, type, layout, id)
    initial = defaulted.operand
    if defaulted.type != type
        refuse(.refused-conversion, id)
if layout == void-layout
    =
if is-captured(slot)
    keep-captured(slot, initial, type, id)
    =
. local = ir.add-local(layout, (bindings.slots[slot].flags /and/ SlotFlag.slot-address-taken) != 0)
unit.cells[offset] = local
store-local(local, initial, id)

────────────────────
_ do declared-value Typed
    - name SyntaxId
    - annotation SyntaxId
    - value SyntaxId
    - type TypeId

` The value a declaration writes for a local, converted to the type written for the local,
` which is the type the local holds.
. initial = emit-expression(value)
if annotation != 0
    initial = convert(annotation, .reason-declaration, initial, name)
if initial.type != type
    refuse(.refused-conversion, value)
= initial

────────────────────
_ do default-value Typed
    - annotation SyntaxId
    - type TypeId
    - layout LayoutId
    - id SyntaxId

` The value a local has when its declaration writes none: the zero of a number, the empty
` text, the null pointer, an optional that holds nothing, a tuple with no name as it is with
` nothing written, or what the constructor the type pass chose at the local's type makes, and
` for a union none was chosen for, its first case (`first-case`).
. nothing = make-operand(.operand-void, 0)
if types.is-optional(type) && (tables.layouts.is-struct(layout) || is-null-form(type))
    = empty-optional(type, layout)
if types.is-plain-tuple(type) && tables.layouts.is-struct(layout)
    = null-value(type, layout, id)
if intrinsic(type) == .cpointer && (layout == pointer-layout || layout == managed-layout)
    = Typed(integer(layout as MachineKind, 0), type)
if type == types.null-type
    =? Typed(integer(layout as MachineKind, 0), type) if layout == pointer-layout || layout == managed-layout
    = Typed(nothing, type)
if is-numeric-type(type) || type == types.bool-type
    if is-float(layout)
        = Typed(float-number(layout, 0.0), type)
    = Typed(integer(tables.layouts.kind-of(layout), 0), type)
if type == types.string-type
    = Typed(make-operand(.operand-constant, ir.add-string("")), type)
. fact = if annotation == 0 then no-fact else facts.first-call(unit.reading, annotation)
if fact == no-fact && tables.layouts.is-union(layout)
    = first-case(type, layout, id)
if fact == no-fact || facts.calls[fact].next != no-fact || other-form
    refuse(.refused-statement, id)
    = Typed(nothing, no-type)
.. other-form = facts.calls[fact].form != .call-this-constructor
= emit-fact-call(annotation, facts.calls[fact], 0, RowRange'SyntaxId(), 0, 0, type)

────────────────────
_ do first-case Typed ?! Refused
    - type TypeId
    - layout LayoutId
    - id SyntaxId

` The first case of a union, holding the value a local of the case's type has with nothing
` written, as the reference's `defaultValue` of a union gives it; a case that holds nothing
` has nothing set.
if tables.layouts.rows[layout].cases.count == 0
    refuse(.refused-statement, id)
    = Typed(make-operand(.operand-void, 0), no-type)
. field = tables.layouts.case-field(layout, 0)
if field.layout == void-layout
    . made = frame(layout)
    zero(made, layout)
    = Typed(made, type)
. held = default-value(0, field.type, field.layout, id)
= make-union(id, type, 0, held)

────────────────────
_ do local-slot SlotId
    - name SyntaxId
    - site SyntaxId
    - shared Bool = false
    - item Bool = false
    - tracked Bool = false

` The slot of a local a name declares or is assigned through, or of an argument it is assigned
` through, when it is one a cell holds: nothing captures it or tracks it. `shared` takes
` one that nested functions capture too, which an environment holds, and so a lazy local
` an environment holds. Any other lazy local is declared where its value is being evaluated.
` `item` takes instead a name the pattern of a loop writes for a field of its item, and
` `tracked` one some read tracks, for a declaration or an assignment, which tells the reads.
. binding = instances.rows[unit.reading].binding
. unkept = if shared then SlotFlag.slot-tracked else captured-tracked
    .. captured-tracked = SlotFlag.slot-captured /or/ SlotFlag.slot-tracked
if tracked
    unkept = unkept /and/ SlotFlag.slot-captured
if binding != no-binding && unit.reading == unit.instance
    match? tree.nodes[name]
        | .node-identifier
            . resolution = bindings.resolution-of(binding, name)
            if resolution.kind == .resolve-slot
                . row = bindings.slots[resolution.slot]
                . is-held = row.kind == .slot-local || row.kind == .slot-argument
                if item
                    is-held = row.kind == .slot-loop-item
                if row.kind == .slot-lazy
                    is-held = shared && bindings.lazy-policy(resolution.slot) == .lazy-shared
                    for open in lazy-open
                        if open == resolution.slot
                            is-held = true
                if is-held && (row.flags /and/ unkept) == 0
                    = resolution.slot
refuse(.refused-statement, site)
= unit.slot-start

────────────────────
_ do argument-memory Operand
    - slot SlotId
    - type TypeId
    - id SyntaxId

` The memory of an argument that is a struct, which the function owns and which has no cell:
` an assignment to the argument copies the value there.
. nothing = make-operand(.operand-void, 0)
if !is-own-slot(slot) || bindings.slots[slot].kind != .slot-argument
    refuse(.refused-statement, id)
    = nothing
. position = argument-position(slot)
. index = if unit.takes-self then position + 1 else position
. layout = layout-of(type, id)
. passed = instances.argument-type(unit.instance, position) == type && index < ir.arguments.length
if !passed || !tables.layouts.is-struct(layout) || (ir.arguments[index] as LayoutId) != layout
    refuse(.refused-statement, id)
    = nothing
= make-operand(.operand-argument, index)

────────────────────
_ do emit-setter
    - lhs SyntaxId
    - object SyntaxId
    - rhs SyntaxId
    - fact CallFact

` An assignment a setter answers: the setter is called on the object with the value, which
` takes the conversion recorded for an argument. The value is evaluated before the object.
. callee = fact.callee
if callee == no-instance || fact.is-partial || !is-callable(callee)
    refuse(.refused-statement, lhs)
    =
if instances.signatures[callee].args.count != 1
    refuse(.refused-statement, lhs)
    =
. made = emit-expression(rhs)
. converted = convert(rhs, .reason-argument, Typed(apart(made, rhs, object != 0 && !is-inert(object)), made.type))
. value = converted.operand
if converted.type != instances.argument-type(callee, 0)
    refuse(.refused-conversion, rhs)
    =
. receiver = emit-receiver(lhs, object)
if receiver.type != instances.rows[callee].self-type
    refuse(.refused-conversion, lhs)
. mark = pending.length
pending += receiver.operand
pending += value
call-method(callee, lhs, mark)

────────────────────
_ is-own-field Bool
    - name SyntaxId

` Whether a name is a field of the receiver, in a member of a struct or of a class, or in
` the constructor of a tuple, or in a rule of a class run on the object being made.
|? binding == no-binding || (unit.reading != unit.instance && !unit.running-rule) || !unit.has-self
    false
|? !is-stored(owner, 0) && !tables.is-class(owner)
    false
??
    bindings.resolution-of(binding, name).kind == .resolve-member

.. binding = instances.rows[unit.reading].binding
.. owner = unit.owner-type

────────────────────
_ is-mutable-value Bool
    - type TypeId

` Whether a value's fields are changed in place: a struct's.
intrinsic(type) == .struct

────────────────────
_ do is-framed Bool
    - id SyntaxId

` Whether an expression names memory of the frame: a local or an argument that holds a tuple
` or struct, the receiver that is one, or a field of any of them. No syntax is the receiver.
if id == 0
    = true
. type = facts.node-type(unit.reading, id)
if type == no-type || type == invalid-type || !is-aggregate(type)
    = false
. binding = instances.rows[unit.reading].binding
match? tree.nodes[id]
    | .node-identifier
        if binding == no-binding || unit.reading != unit.instance
            = false
        . resolution = bindings.resolution-of(binding, id)
        if resolution.kind == .resolve-slot
            . kind = bindings.slots[resolution.slot].kind
            = kind == .slot-local || kind == .slot-argument || kind == .slot-this
        = resolution.kind == .resolve-member && is-stored(unit.owner-type, 0) && is-own-field(id)
    | .node-get-expression(row)
        = is-framed(row.object)
    | .node-index-expression(row)
        = names-field(id) && is-framed(row.object)
= false

────────────────────
_ names-field Bool
    - id SyntaxId

` Whether an index names a stored field of its object, by the constant the type pass
` recorded. One a function answers gives a value of its own, which names no storage.
indexed-field(id) != no-fact && own-call(id) == no-fact && facts.plan-of(unit.reading, id) != .plan-item

────────────────────
_ do places-item Bool
    - id SyntaxId

` Whether a struct a store goes into is one that lies in storage, as TypeScript finds it once
` it has inlined what reads it: an item past a pointer, what an index answers by a function
` written `@inline` as an expression, or a struct stored in either.
match? tree.nodes[id]
    | .node-get-expression(row)
        . owner = facts.node-type(unit.reading, row.object)
        if owner == no-type || owner == invalid-type || !is-mutable-value(owner) || is-link(id)
            = false
        if facts.plan-of(unit.reading, id) != .plan-none || own-call(id) != no-fact
            = false
        = places-item(row.object)
    | .node-index-expression(row)
        if is-link(id)
            = false
        if facts.plan-of(unit.reading, id) == .plan-item
            = true
        . fact = own-call(id)
        if fact == no-fact || facts.plan-of(unit.reading, id) != .plan-none
            = false
        . callee = facts.calls[fact].callee
        = callee != no-instance && inlined-answer(callee) != 0
= false

────────────────────
_ do place-of Typed ?! Refused
    - id SyntaxId

` Where a struct that `places-item` finds in storage lies, for a store into a field of it.
match? tree.nodes[id]
    | .node-get-expression(row)
        . base = place-of(row.object)
        . owner = base.type
        = load-property(id, base.operand, owner, row.name)
    | .node-index-expression(row)
        if facts.plan-of(unit.reading, id) == .plan-item
            = item-place(id, row.object, row.index)
        = place-index-call(id, facts.calls[own-call(id)], row.object, row.index)
refuse(.refused-statement, id)
= Typed(make-operand(.operand-void, 0), no-type)

────────────────────
_ do item-place Typed
    - id SyntaxId
    - object SyntaxId
    - index SyntaxId

` The struct an index names past a pointer, where it lies: the pointer is evaluated before the
` index, as for a read, and nothing is copied.
. place = item-address(id, object, index)
. type = tables.layouts.pointee-type(place.type)
. layout = layout-of(type, id)
if !tables.layouts.is-struct(layout)
    refuse(.refused-expression, id)
    = place
= Typed(address(place.operand, 0, layout, id), type)

────────────────────
_ do inlined-answer SyntaxId
    - callee InstanceId

` The body of a member written `@inline` as an expression, which a store into what it answers
` runs where the store is, as TypeScript inlines it: 0 for any other function.
. row = instances.rows[callee]
match? program.modules[row.module].decls[row.decl]
    | .decl-function(fn)
        . is-member = fn.kind == .function-decl || fn.kind == .getter-decl
        if fn.is-generated || fn.is-static || fn.owner == 0 || !is-member
            = 0
        match? program.modules[row.module].tree.nodes[fn.syntax]
            | .node-function-syntax(syntax)
                if syntax.is-inline && !syntax.imperative
                    = syntax.body
= 0

────────────────────
_ do inlined-static-answer SyntaxId
    - callee InstanceId

` The body of a function with no receiver, a static one or one declared alone, written `@inline`
` as an expression, which a store into what it answers runs where the store is, as TypeScript
` inlines it: 0 for any other function.
if callee == no-instance
    = 0
. row = instances.rows[callee]
match? program.modules[row.module].decls[row.decl]
    | .decl-function(fn)
        if fn.is-generated || fn.kind != .function-decl || (!fn.is-static && fn.owner != 0)
            = 0
        match? program.modules[row.module].tree.nodes[fn.syntax]
            | .node-function-syntax(syntax)
                if syntax.is-inline && !syntax.imperative
                    = syntax.body
= 0

────────────────────
_ do is-inline Bool
    - callee InstanceId

` Whether a function is written `@inline`, which TypeScript runs where it is called.
. row = instances.rows[callee]
match? program.modules[row.module].decls[row.decl]
    | .decl-function(fn)
        match? program.modules[row.module].tree.nodes[fn.syntax]
            | .node-function-syntax(syntax)
                = syntax.is-inline
= false

────────────────────
_ answers-copy Bool
    - id SyntaxId

` Whether a call gives what a function answers in memory of the call's own, which nothing else
` names, as TypeScript's does where it calls the function: one it calls by itself, not through a
` witness table, that is not written `@inline`.
|? fact == no-fact
    false
|? !direct || row.is-partial || row.callee == no-instance || !is-callable(row.callee)
    false
??
    !is-inline(row.callee) && !tables.is-prototype(row.callee)

.. fact = own-call(id)
.. row = facts.calls[fact]
.. direct = row.form == .call-function || row.form == .call-method || row.form == .call-static

────────────────────
_ do place-index-call Typed
    - id SyntaxId
    - fact CallFact
    - object SyntaxId
    - index SyntaxId

` Where the struct an index answers lies, for a store into a field of it, where the function
` that answers it is a member written `@inline` as an expression. The receiver and
` the key are evaluated as for the call, each with its conversion, and then the function's body
` runs here as TypeScript inlines it, with its own locals for the run and the key in its
` argument's: its answer is where the storage it names lies. A function that raises, keeps an
` environment, takes a struct, or runs in another zone has no shape here, and nor has one run
` where a value is pinned, since its syntax is of its own module.
. nothing = make-operand(.operand-void, 0)
. callee = fact.callee
if callee == no-instance || fact.is-partial || !is-callable(callee) || out-of-order
    refuse(.refused-statement, id)
    = Typed(nothing, no-type)
.. out-of-order = !fills-in-order(fact, callee, 1)
. body = inlined-answer(callee)
. owner = instances.rows[callee].self-type
. answer = facts.node-type(unit.reading, id)
. closed = tables.environments[callee] != no-layout || is-free(callee) != in-zone || has-pins
    .. has-pins = pins.length != 0
if body == 0 || closed || instances.signatures[callee].errors.count != 0 || owner == no-type
    refuse(.refused-statement, id)
    = Typed(nothing, no-type)
if instances.signatures[callee].returns != answer || names-slot(object, .slot-super)
    refuse(.refused-statement, id)
    = Typed(nothing, no-type)
. receiver = convert(object, .reason-receiver, emit-expression(object))
. receiver-type = receiver.type
. key = convert(index, .reason-argument, emit-expression(index))
if receiver-type != owner
    refuse(.refused-conversion, object)
    = Typed(nothing, no-type)
if key.type != instances.argument-type(callee, 0)
    refuse(.refused-conversion, index)
    = Typed(nothing, no-type)
. key-layout = layout-of(key.type, index)
if tables.layouts.is-struct(key-layout)
    refuse(.refused-statement, id)
    = Typed(nothing, no-type)
= run-inlined-place(callee, body, answer, receiver.operand, true, [key.operand], [key-layout], id)

────────────────────
_ do place-static-call Typed
    - id SyntaxId
    - fact CallFact
    - written RowRange'SyntaxId

` Where the struct a call answers lies, in an inlined body, where the function is one with no
` receiver written `@inline` as an expression, as `GCBacking.load` is. The arguments are
` evaluated in the order written, each with its conversion, and then the function's body runs
` here as TypeScript inlines it. A function that raises, keeps an environment, takes a struct or
` runs in another zone has no shape here, and nor has one run where a value is pinned.
. nothing = make-operand(.operand-void, 0)
. callee = fact.callee
. count = written.count as U32
if callee == no-instance || fact.is-partial || !is-callable(callee) || out-of-order
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
.. out-of-order = !fills-in-order(fact, callee, count)
. body = inlined-static-answer(callee)
. answer = facts.node-type(unit.reading, id)
. closed = tables.environments[callee] != no-layout || is-free(callee) != in-zone || has-pins
    .. has-pins = pins.length != 0
if body == 0 || closed || instances.signatures[callee].errors.count != 0 || other-answer
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
.. other-answer = instances.signatures[callee].returns != answer
. given [Operand]
. layouts [LayoutId]
. evaluated U32
for argument in tree.children[written]
    . expression = argument
    match? tree.nodes[argument]
        | .node-argument(named)
            expression = named.expr
    evaluated += 1
    . made = emit-expression(expression)
    . value = convert
        - argument
        - .reason-argument
        - Typed(settled(made, expression, written, evaluated), made.type)
    if value.type != instances.argument-type(callee, evaluated - 1)
        refuse(.refused-conversion, argument)
        = Typed(nothing, no-type)
    . layout = layout-of(value.type, argument)
    if tables.layouts.is-struct(layout)
        refuse(.refused-expression, id)
        = Typed(nothing, no-type)
    given += value.operand
    layouts += layout
= run-inlined-place(callee, body, answer, nothing, false, given, layouts, id)

────────────────────
_ do run-inlined-place Typed
    - callee InstanceId
    - body SyntaxId
    - answer TypeId
    - receiver Operand
    - receives Bool
    - given [Operand]
    - layouts [LayoutId]
    - site SyntaxId

` Runs the body of a function written `@inline` as an expression where a store into what it
` answers is, as TypeScript inlines it, with its own locals for the run, the receiver where it
` `receives` one, and each argument in its parameter's cell, and answers where the storage its
` answer names lies. Its syntax is of its own module.
. own-unit = unit
. run = enter-unit(callee)
unit = unit.source-module = instances.rows[callee].module
if receives
    unit = unit.self = receiver
unit = unit.has-self = receives
unit = unit.takes-self = receives
bind-inlined-arguments(given, layouts, site)
. place = make-operand(.operand-void, 0)
. last = ending(body)
if last == 0
    refuse(.refused-expression, body)
. answered = place-answer(last)
place = answered.operand
if answered.type != answer
    refuse(.refused-conversion, last)
leave-unit(run)
unit = own-unit
= Typed(place, answer)

────────────────────
_ do bind-inlined-arguments
    - given [Operand]
    - layouts [LayoutId]
    - site SyntaxId

` Gives each argument of a function run where it is called the cell that holds the value it was
` given. One that nested functions capture, or some read tracks, has no shape here.
for offset in 0 .. < unit.slot-count
    . slot = bindings.slots[unit.slot-start + offset]
    if slot.kind != .slot-argument || !owns(unit.slot-start + offset)
        continue
    if is-captured(unit.slot-start + offset) || (slot.flags /and/ SlotFlag.slot-tracked) != 0
        refuse(.refused-statement, site)
        =
    . position = argument-position(unit.slot-start + offset) as Size
    if position >= given.length
        refuse(.refused-statement, site)
        =
    . layout = layouts[position]
    if layout == void-layout
        continue
    . local = ir.add-local(layout, (slot.flags /and/ SlotFlag.slot-address-taken) != 0)
    unit.cells[offset] = local
    store-local(local, given[position], site)

────────────────────
_ do place-answer Typed ?! Refused
    - id SyntaxId

` Where the struct the body of a function run where it is called answers lies: an item past a
` pointer, a stored field of the receiver, what an index answers by a function this runs where
` it is called in turn, what a function with no receiver this runs where it is called answers,
` or for a match with no subject, the place each arm's answer gives. What `answers-copy` says a
` call gives lies where the call left it, which nothing else names, as TypeScript's store
` through it goes nowhere else.
. nothing = make-operand(.operand-void, 0)
match? tree.nodes[id]
    | .node-index-expression(row)
        if !is-link(id) && facts.plan-of(unit.reading, id) == .plan-item
            = item-place(id, row.object, row.index)
        if !is-link(id) && places-item(id)
            = place-of(id)
    | .node-identifier(row)
        . found = property-of(unit.owner-type, row.name) if is-own-field(id)
        . eager = found && types.properties[found].storage-kind == .storage-eager
        if eager && own-call(id) == no-fact && facts.plan-of(unit.reading, id) == .plan-none
            = load-property(id, unit.self, unit.owner-type, row.name)
    | .node-call-expression(row)
        if answers-copy(id)
            = emit-expression(id)
        . fact = own-call(id)
        if fact != no-fact && facts.plan-of(unit.reading, id) == .plan-none && static-inline
            = place-static-call(id, facts.calls[fact], row.args)
        .. static-inline = inlined-static-answer(facts.calls[fact].callee) != 0
    | .node-structure-match(row)
        = place-match(id, row.pattern)
    | .node-match-expression(row)
        if row.subject == 0 && !row.is-optional && row.helper == 0
            match? tree.nodes[row.body]
                | .node-structure-match(arms)
                    = place-match(id, arms.pattern)
refuse(.refused-expression, id)
= Typed(nothing, no-type)

────────────────────
_ do is-place Bool
    - id SyntaxId

` Whether an expression only names storage: a local, or a field of one, at a place a key that
` calls nothing gives, or one of those forced or cast where that calls nothing. Reading it twice
` does nothing twice, so a name a getter answers is not one.
match? tree.nodes[id]
    | .node-identifier
        = !reads-getter(id)
    | .node-get-expression(row)
        = !reads-getter(id) && is-place(row.object)
    | .node-index-expression(row)
        = names-field(id) && is-place(row.object) && is-inert(row.index)
    | .node-unary-expression(row)
        . calls = facts.first-call(unit.reading, id) != no-fact
        = row.op == .optional-force-op && !calls && is-place(row.operand)
    | .node-cast-expression(row)
        = facts.first-call(unit.reading, id) == no-fact && is-place(row.lhs)
= false

────────────────────
_ do reads-getter Bool
    - id SyntaxId

` Whether the type pass recorded the call of a getter at a node, for the node's value.
. fact = facts.first-call(unit.reading, id)
while fact != no-fact
    if facts.calls[fact].form == .call-getter
        = true
    fact = facts.calls[fact].next
= false

────────────────────
_ do emit-if
    - id SyntaxId
    - condition SyntaxId
    - body SyntaxId
    - next SyntaxId

` A branch runs its body where its condition tests as true, and otherwise what follows it:
` another branch, or the body of an `else`, which is a branch with no condition. A branch the
` type pass found never taken evaluates its condition and goes on to what follows it.
if condition == 0
    if next != 0
        refuse(.refused-statement, next)
        =
    emit-block(body)
    =
if facts.plan-of(unit.reading, id) == .plan-never
    test(condition, emit-expression(condition))
    if next != 0
        emit-statement(next)
    =
. taken = ir.reserve-block()
. done = ir.reserve-block()
. other = if next == 0 then done else ir.reserve-block()
branch-on(condition, taken, other)
ir.start-block(taken)
emit-block(body)
jump(done)
if next != 0
    ir.start-block(other)
    emit-statement(next)
    jump(done)
ir.start-block(done)

────────────────────
_ do tested SyntaxId
    - loop SyntaxId
    - clause SyntaxId

` The clauses the subscriber of a loop on a stream tests: those after the first where it says
` which publications a loop on an event hears. A `whenever` among them says whether the loop
` is subscribed and is not tested.
if facts.event-clause-of(unit.source-module, loop)
    match? tree.nodes[clause]
        | .node-clause(row)
            = row.next
= clause

────────────────────
_ do emit-publish Typed
    - id SyntaxId
    - used EventUse
    - operands RowRange'SyntaxId

` A write to an event, as the reference publishes one: the object is evaluated, and where the
` event is live, the event runtime says whether anything listens to it on the object; only
` then is the payload made and published. A keyed event is asked at its address, the key the
` index gives, for the generation of the receiver there, which none is where nothing listens,
` and published at the address with it. One that bubbles is published with the object made
` the `EventNode` its parents are walked from.
. nothing = make-operand(.operand-void, 0)
. owner = event-owner(used.reference, used.owner)
. number = tables.event-number(used.owner, used.name)
if number == U32.max
    = Typed(nothing, types.void-type)
. pointer = num-cast(id, owner.operand, managed-layout, pointer-layout)
. keyed = used.address != 0
. key = if keyed then emit-key(used.address) else Typed(nothing, no-type)
count-event(.publish-attempts, id)
. asking = pending.length
pending += pointer
pending += integer(.machine-u64, number)
if keyed
    push-key(key.operand, key.type, id)
. answer = call-instance(used.first, id, asking)
. interested = if keyed then compare(id, .compare-not-equal, answer.operand, integer(.machine-u64, 0)) else answer.operand
. publishing = ir.reserve-block()
. done = ir.reserve-block()
. missing = done
if tables.event-counts[EventCount.publish-interest-misses as Size] != 0
    missing = ir.reserve-block()
branch(interested, publishing, missing)
ir.start-block(publishing)
count-event(.payload-builds, id)
. given = tree.children[operands.start]
. payload = convert(given, .reason-argument, emit-expression(tree.argument-value(given)))
. node = if used.bubbles then convert-from(used.reference, .reason-event-node, owner.operand).operand else nothing
. mark = pending.length
pending += pointer
pending += integer(.machine-u64, number)
if keyed
    push-key(key.operand, key.type, id)
    pending += answer.operand
if used.bubbles
    pending += node
pending += payload.operand
do call-instance(used.second, id, mark)
jump(done)
if missing != done
    ir.start-block(missing)
    count-event(.publish-interest-misses, id)
    jump(done)
ir.start-block(done)
= Typed(nothing, types.void-type)

────────────────────
_ do emit-readdress Typed
    - id SyntaxId
    - used EventUse
    - operands RowRange'SyntaxId

` `rekey` or `release` of the address of a keyed event, as the reference makes them: the
` object and the key are evaluated, then for `rekey` the new key, converted to the event's
` key type, and the event runtime gives the address the receiver claimed there the new key,
` whose errors leave the function with the call, or under `catch` are what the call gives, or
` gives it up.
. nothing = make-operand(.operand-void, 0)
. owner = event-owner(used.reference, used.owner)
. number = tables.event-number(used.owner, used.name)
if number == U32.max
    = Typed(nothing, types.void-type)
. key = emit-key(used.address)
. key-type = key.type
. rekeys = used.kind == .event-rekey
. next = nothing
if rekeys
    . given = tree.children[operands.start]
    . converted = convert(given, .reason-argument, emit-expression(tree.argument-value(given)))
    next = converted.operand
    if converted.type != key-type
        refuse(.refused-conversion, given)
. identity = receiver-identity(id)
. mark = pending.length
pending += num-cast(id, owner.operand, managed-layout, pointer-layout)
pending += integer(.machine-u64, number)
push-key(key.operand, key-type, id)
if rekeys
    push-key(next, key-type, id)
pending += identity
if carries-error(facts.node-type(unit.reading, id))
    takes-result = true
    . answer = call-instance(used.first, id, mark)
    takes-result = false
    = answer
do raising-call(id, used.first, mark)
= Typed(nothing, types.void-type)

────────────────────
_ do emit-route Typed
    - id SyntaxId
    - used EventUse
    - operands RowRange'SyntaxId

` A write of a `RoutedEvent`, as the reference publishes one: the object is evaluated, and
` where the event is live the payload is made and the event runtime publishes it along its
` route of owners, from the object on, whatever listens; one that bubbles is given the object
` made the `EventNode` its parents are walked from, where the payload has no route of its own.
. nothing = make-operand(.operand-void, 0)
. owner = event-owner(used.reference, used.owner)
. number = tables.event-number(used.owner, used.name)
if number == U32.max
    = Typed(nothing, types.void-type)
. pointer = num-cast(id, owner.operand, managed-layout, pointer-layout)
. given = tree.children[operands.start]
. payload = convert(given, .reason-argument, emit-expression(tree.argument-value(given)))
count-event(.payload-builds, id)
. node = if used.bubbles then convert-from(used.reference, .reason-event-node, owner.operand).operand else no-node
    .. no-node = make-operand(.operand-void, 0)
. mark = pending.length
pending += integer(.machine-u64, number)
pending += pointer
if used.bubbles
    pending += node
pending += payload.operand
do call-instance(used.first, id, mark)
= Typed(nothing, types.void-type)

────────────────────
_ arrives Bool
    - loop SyntaxId

` Whether a loop on an event hears only the publications its object is the target of.
if clause then clause.arrival else false

.. clause = facts.event-clause-of(unit.source-module, loop)

────────────────────
_ do emit-escape Typed
    - id SyntaxId
    - used EventUse

` An event made a `Broadcastable`: the endpoint the event runtime keeps for the object's event,
` or the one at the address of a keyed event, which the receiver claims.
. owner = event-owner(used.reference, used.owner)
. number = tables.event-number(used.owner, used.name)
if number == U32.max
    refuse(.refused-expression, id)
if used.address != 0
    . endpoint = keyed-endpoint(id, used, owner.operand, number)
    = convert(id, .reason-argument, endpoint)
= event-endpoint(id, used.first, owner.operand, number)

────────────────────
_ do keyed-endpoint Typed
    - site SyntaxId
    - used EventUse
    - owner Operand
    - number U32

` The endpoint at the address of a keyed event, as the reference claims it for the receiver:
` the event runtime's `first` gives it for the object, the event's number, the key and the
` receiver's identity, and its errors leave the function at `site`; then a live action of the
` receiver holds a `ClosableTracker` of it, made as `claim` says, which closes it with the
` receiver.
. nothing = make-operand(.operand-void, 0)
. key = emit-key(used.address)
. key-type = key.type
. identity = receiver-identity(site)
. mark = pending.length
pending += num-cast(site, owner, managed-layout, pointer-layout)
pending += integer(.machine-u64, number)
push-key(key.operand, key-type, site)
pending += identity
. endpoint = raising-call(site, used.first, mark)
. endpoint-type = endpoint.type
claim(used.address, endpoint.operand, endpoint-type)
= Typed(endpoint.operand, endpoint-type)

────────────────────
_ do claim
    - address SyntaxId
    - endpoint Operand
    - endpoint-type TypeId

` The endpoint at the address of a keyed event claimed for the receiver: made a `Closable` at
` the node that names the event, and given to the `ClosableTracker` the type pass recorded
` there, which is made a `Tracker` there and added to the trackers of a live action of the
` receiver, whose callback does nothing.
. named SyntaxId = 0
match? tree.nodes[address]
    | .node-index-expression(row)
        named = row.object
. claimed = facts.address-claim-of(unit.reading, named)
if !claimed
    refuse(.refused-statement, address)
    =
. closable = convert(named, .reason-argument, Typed(endpoint, endpoint-type))
. mark = pending.length
pending += closable.operand
. tracker = call-instance(claimed.closer, named, mark)
. given = convert(named, .reason-argument, tracker)
. trackers = open-trackers(named)
add-tracker(load-local(trackers, named), given.operand, named)
do own-callback(load-local(trackers, named), idle, integer(.machine-managed-pointer, 0), named)
    .. idle = tables.idle-action

────────────────────
_ do emit-key Typed
    - address SyntaxId

` The key an index addresses a keyed event with, converted to the event's key type as the type
` pass recorded at the key.
. nothing = make-operand(.operand-void, 0)
. key SyntaxId = 0
match? tree.nodes[address]
    | .node-index-expression(row)
        key = row.index
if key == 0
    refuse(.refused-expression, address)
    = Typed(nothing, no-type)
= convert(key, .reason-argument, emit-expression(key))

────────────────────
_ do push-key
    - key Operand
    - type TypeId
    - site SyntaxId

` Gives the event runtime a key of a keyed event as the address it names, two `U64`s: an
` integer and none, or the index and the generation of a handle.
. layout = layout-of(type, site)
if is-integer(layout)
    pending += num-cast(site, key, layout, u64-layout)
    pending += integer(.machine-u64, 0)
    =
if !tables.layouts.is-struct(layout) || tables.layouts.rows[layout].fields.count != 2
    refuse(.refused-conversion, site)
    =
for position in 0 .. < 2
    . field = tables.layouts.field(layout, position as U32)
    if !is-integer(field.layout)
        refuse(.refused-conversion, site)
        =
    pending += num-cast(site, take(key, field, site), field.layout, u64-layout)

────────────────────
_ do receiver-identity Operand
    - site SyntaxId

` The identity of the receiver that claims the address of a keyed event: the `uid` its header
` holds, as a `U64`. The receiver is the innermost markup element being built, or else the
` object `self` names.
. inside = content-hosts.length != 0
. receiver = if inside then content-hosts[content-hosts.length - 1].operand else unit.self
. type = if inside then content-hosts[content-hosts.length - 1].type else unit.owner-type
if (!inside && !unit.has-self) || !tables.is-class(type) || tables.layouts.objects[type] == no-layout
    refuse(.refused-expression, site)
    = make-operand(.operand-void, 0)
. uid = load
    - receiver
    - tables.layouts.field(tables.layouts.objects[type], 1).offset
    - u32-layout
    - site
= num-cast(site, uid, u32-layout, u64-layout)

────────────────────
_ do raising-call Typed
    - site SyntaxId
    - callee InstanceId
    - mark Size

` A call of a function of the event or markup runtime, given what is pending since `mark`,
` whose errors leave the function with the call, as the type pass noted.
. raising = instances.signatures[callee].errors.count != 0
takes-result = raising
. answer = call-instance(callee, site, mark)
takes-result = false
if raising
    = propagate(site, callee, answer.operand)
= answer

────────────────────
_ escaped-event EventUse?
    - id SyntaxId

` The event a node names that is made a `Broadcastable` there, or none.
used if facts.event-uses.length != 0 && used && used.kind == .event-escape

.. used = tables.event-use-of(unit.reading, id)

────────────────────
_ do event-owner Typed ?! Refused
    - reference SyntaxId
    - owner TypeId

` The object whose event of the class `owner` a node names: the value its name is read from,
` or where the name is written alone, the innermost markup element being built whose class has
` the event, where the name is read in the element's body, and else the receiver; or that of
` the event an index addresses. One read from the class that declares it is a loop's, which
` hears it as it bubbles to the loop's object (`bubbling-owner`).
match? tree.nodes[reference]
    | .node-index-expression(row)
        = event-owner(row.object, owner)
    | .node-get-expression(get)
        if types.intrinsic-of(facts.node-type(unit.reading, get.object)) == .type-info
            = bubbling-owner(reference)
        = emit-expression(get.object)
    | .node-identifier
        . binding = instances.rows[unit.reading].binding
        if binding != no-binding && (resolution-flags /and/ ResolutionFlag.resolution-received) != 0
            . position = received-event(owner)
            if position
                = content-hosts[position]
        else if unit.has-self
            = Typed(unit.self, unit.owner-type)
        .. resolution-flags = bindings.resolution-of(binding, reference).flags
refuse(.refused-expression, reference)
= Typed(make-operand(.operand-void, 0), no-type)

────────────────────
_ do bubbling-owner Typed
    - reference SyntaxId

` The object a loop that names an event by the class that declares it subscribes on: the
` innermost markup element being built, or else the receiver.
if content-hosts.length != 0
    = content-hosts[content-hosts.length - 1]
if unit.has-self
    = Typed(unit.self, unit.owner-type)
refuse(.refused-expression, reference)
= Typed(make-operand(.operand-void, 0), no-type)

────────────────────
_ do received-event Size?
    - owner TypeId

` Where the innermost markup element being built whose class declares or inherits an event of
` the class or interface `owner` is kept.
. position = content-hosts.length
while position != 0
    position -= 1
    . parent = content-hosts[position].type
    if intrinsic(parent) == .class && types.implements-type(parent, owner)
        = position
= null

────────────────────
_ do event-endpoint Typed
    - site SyntaxId
    - callee InstanceId
    - owner Operand
    - number U32

` The endpoint the event runtime keeps for an object's event, which `callee` gives for the
` object and the event's number, made the event's `Broadcastable` as the type pass recorded at
` the site.
. mark = pending.length
pending += num-cast(site, owner, managed-layout, pointer-layout)
pending += integer(.machine-u64, number)
. made = call-instance(callee, site, mark)
= convert(site, .reason-argument, made)

────────────────────
_ do emit-broadcastable Typed
    - loop SyntaxId
    - container SyntaxId

` The container of a loop or a comprehension on a stream made a `Broadcastable` as the type
` pass recorded at the header: given to `publisher`, or cast. It has the header's type.
. nothing = make-operand(.operand-void, 0)
. held = emit-expression(container)
. publisher = own-call(loop)
. stream = Typed(nothing, no-type)
if publisher != no-fact
    . mark = pending.length
    pending += convert(loop, .reason-argument, held).operand
    stream = call-instance(facts.calls[publisher].callee, loop, mark)
else
    stream = convert(loop, .reason-argument, held)
if stream.type != facts.node-type(unit.reading, loop)
    refuse(.refused-statement, loop)
= stream

────────────────────
_ do lone-environment LocalId
    - id SyntaxId
    - slot SlotId
    - count U32 = 1

` The environment of a subscriber that the function emitted here does not type, where no
` environment of the function that types it is in force: in the value of a global, or in a
` section of a class, which a constructor runs. It is one of the layout of the function that
` types it, made for this subscriber alone, which holds the channel `slot` names, if any, and
` the object being made, where the layout holds it, since every function written there reads
` it then, and nothing else; one that holds nothing is given none. The function that tests a
` `whenever` clause again is given one so too, which holds the `count` locals from `slot` on
` that the clause keeps. A function that captures anything else, or holds the state of a
` global `do with` binds, has no shape there.
. layout = tables.environments[unit.reading]
if layout == unbuilt-environment || tables.holds-stacks(unit.reading)
    refuse(.refused-expression, id)
    = no-local
. binding = instances.rows[unit.reading].binding
. row = bindings.bindings[binding]
. home = tables.instance-scopes[unit.reading]
. alone = false
. captures = 0u32
for offset in 0 .. < row.nested.count
    . nested = bindings.nested[row.nested.start + offset]
    if nested.syntax != id
        continue
    alone = true
    captures = nested.captures.count
    for index in 0 .. < nested.captures.count
        . captured = bindings.captures[nested.captures.start + index].slot
        if tables.slot-homes[captured] != home
            alone = false
        else if bindings.slots[captured].kind == .slot-this && unit.has-self
            continue
        else if slot == no-slot || captured < slot || captured >= slot + count
            alone = false
. selves [SlotId]
if unit.has-self
    for offset in 0 .. < row.slots.count
        . held = row.slots.start + offset
        . captured = (bindings.slots[held].flags /and/ SlotFlag.slot-captured) != 0
        if bindings.slots[held].kind == .slot-this && captured && tables.slot-homes[held] == home
            selves += held
. bare = captures == 0 && selves.length == 0
if !alone || (layout == no-layout && !bare)
    refuse(.refused-expression, id)
    = no-local
. local = ir.add-local(managed-layout)
if bare
    store-local(local, integer(.machine-managed-pointer, 0), id)
    = local
. mark = pending.length
pending += integer(.machine-u64, tables.layouts.rows[layout].size)
pending += make-operand(.operand-descriptor, layout)
. made = call-runtime(.runtime-allocate-object, id, mark, managed-layout)
store-local(local, made, id)
for held in selves
    . field = lone-field(held)
    if !tables.is-class(field.type)
        refuse(.refused-expression, id)
        = no-local
    store(load-local(local, id), field.offset, unit.self, true, id)
= local

────────────────────
_ lone-field LayoutField
    - slot SlotId

` The field of a local a subscriber captures in its own environment.
tables.layouts.field(tables.environments[unit.reading], 1 + tables.slot-fields[slot])

────────────────────
_ do keep-lone
    - lone LocalId
    - slot SlotId
    - value Operand
    - type TypeId
    - site SyntaxId

` Stores a local a nested function captures in the environment made for it alone: the
` channel of a comprehension on a stream, or what a `whenever` clause keeps.
. field = lone-field(slot)
if field.type != type
    refuse(.refused-statement, site)
    =
if tables.layouts.is-struct(field.layout)
    store-struct(load-local(lone, site), field, value, site)
else if field.layout != void-layout
    store(load-local(lone, site), field.offset, value, is-managed-pointer(field.layout), site)

────────────────────
_ channel-slot SlotId
    - id SyntaxId

` The local a node declares that no name reaches: the one a comprehension on a stream keeps
` its channel in, which its subscriber captures, or the first of those a `whenever` clause
` keeps what it gave, its subscription and its broadcaster in.
|? binding == no-binding
    no-slot
|? resolution.kind != .resolve-slot
    no-slot
??
    resolution.slot

.. binding = instances.rows[unit.reading].binding
.. resolution = bindings.resolution-of(binding, id)

────────────────────
_ do line-keeper SlotId
    - line SyntaxId

` The local no name reaches that keeps the object of the element a line given again is given
` to, declared at the line: an attribute or a line of content. It is found by its name, since a
` line of content may be a name its node resolves; the one after it keeps what the element took.
. binding = instances.rows[unit.reading].binding
if binding == no-binding
    = no-slot
= bindings.declared-at(bindings.bindings[binding].slots, line, program.store-atom("(element)"))

────────────────────
_ do given-value Operand
    - at Operand
    - type TypeId
    - site SyntaxId

` A value of a type that lies at an address another function gave: the address itself where the
` value is a struct.
. layout = layout-of(type, site)
= if tables.layouts.is-struct(layout) then at else load(at, 0, layout, site)

────────────────────
_ do read-kept Typed
    - node SyntaxId
    - name String
    - site SyntaxId

` What the machine keeps under a name, read from its environment.
. slot = kept-slot(node, name, site)
. held = find-captured(slot, site).type
= read-captured(slot, site, held)

────────────────────
_ do turn-link Operand
    - scope ScopeId
    - site SyntaxId

` The environment in force around a scope that has turns: that of the turn being emitted of the
` nearest scope around it in its function that has turns with an environment, or else the
` function's own. One whose turn is not being emitted there has no shape here.
. around = bindings.scopes[scope].parent
while !bindings.opens-function(around)
    if tables.is-turn-scope(around) && tables.scope-captures[around] != 0
        . position = open-turns.length
        while position != 0 && open-turns[position - 1].scope != around
            position -= 1
        if position == 0
            refuse(.refused-statement, site)
            = make-operand(.operand-void, 0)
        = turn-held(open-turns[position - 1].local, open-turns[position - 1].place, site)
    around = bindings.scopes[around].parent
= function-environment(site)

────────────────────
_ do start-case

` Begins the case a root's task main runs in a batch: the runtime is told the case starts, so
` that what it prints goes to the batch's files, from the case's own directory.
. mark = pending.length
pending += text-constant(tables.batch-control)
pending += text-constant(tables.batch-ids[function.place])
pending += text-constant(tables.batch-directories[function.place])
pending += text-constant(tables.batch-output)
pending += text-constant(tables.batch-errors)
call-runtime(.runtime-batch-test-start, 0, mark)

────────────────────
_ do emit-batch-main

` The task main of a batch: it forks the task main of the root the batch is run from, the one
` `BRIXTEST_BATCH_START_INDEX` names, and ends its own task.
. first = call-runtime(.runtime-batch-start-index, 0, pending.length, i32-layout)
for position in function.calls.start .. < function.calls.end
    . forking = ir.reserve-block()
    . passed = ir.reserve-block()
    . case = (position - function.calls.start) as U64
    branch(compare(0, .compare-equal, first, integer(.machine-i32, case)), forking, passed)
    ir.start-block(forking)
    fork-batch(tables.calls[position], true)
    jump(passed)
    ir.start-block(passed)
call-runtime(.runtime-terminate-active-task, 0, pending.length)
return-nothing()

────────────────────
_ do emit-batch-finish

` Ends the case of a batch once every task it started has ended: while another task is active it
` forks itself again and ends. Then the runtime is told the case finished, what its probes wrote
` is flushed, and what the case left is cleared, so the next case starts as a program of its own
` does: each global of the modules its root started has no value, and each constant is zero until
` the next case lays its value down again, and what it made is collected and cleaned up. Then the task main of the next root is forked where the batch runs it, and where
` it runs no other, the record of probes is closed.
. waiting = ir.reserve-block()
. finishing = ir.reserve-block()
. done = ir.reserve-block()
. activity = call-runtime(.runtime-task-queue-activity, 0, pending.length, i32-layout)
branch(compare(0, .compare-greater, activity, integer(.machine-i32, 1)), waiting, finishing)
ir.start-block(waiting)
fork-batch(tables.batch-finishes[function.place])
jump(done)
ir.start-block(finishing)
. mark = pending.length
pending += text-constant(tables.batch-control)
pending += text-constant(tables.batch-ids[function.place])
call-runtime(.runtime-batch-test-finish, 0, mark)
if tables.probe-flush != no-function
    call-function(tables.probe-flush, 0)
. first = program.batch-order-starts[function.place]
. last = program.batch-order-starts[function.place + 1]
for position in first .. < last
    . module = program.batch-order-modules[position] as ModuleId
    for decl in 0 .. < program.modules[module].decls.length
        . row = tables.storage-of(module, decl as DeclId)
        if row == no-storage
            continue
        . kept = tables.storage[row]
        if kept.state != no-string
            zero(make-operand(.operand-symbol, kept.symbol), kept.layout)
            store(make-operand(.operand-symbol, kept.state), 0, integer(.machine-u8, 0), false, 0)
        else if tables.global-kind(module, decl as DeclId) == .global-constant
            zero(make-operand(.operand-symbol, kept.symbol), kept.layout)
call-runtime(.runtime-collect, 0, pending.length, u64-layout, true)
call-runtime(.runtime-drain-cleanups, 0, pending.length, u64-layout, true)
. closing = ir.reserve-block()
if function.calls.count != 0
    . end = call-runtime(.runtime-batch-end-index, 0, pending.length, i32-layout)
    . forking = ir.reserve-block()
    . next = integer(.machine-i32, function.place + 1)
    branch(compare(0, .compare-less, next, end), forking, closing)
    ir.start-block(forking)
    fork-batch(tables.calls[function.calls.start], true)
    jump(done)
else
    jump(closing)
ir.start-block(closing)
if tables.probe-teardown != no-function
    call-function(tables.probe-teardown, 0)
jump(done)
ir.start-block(done)
call-runtime(.runtime-terminate-active-task, 0, pending.length)
return-nothing()

────────────────────
_ do set-up-batch-probes

` Declares the probes of a batch where the case the batch is run from starts, the one
` `BRIXTEST_BATCH_START_INDEX` names, as the reference does: every case after it writes to the
` record of probes that case opened.
. first = call-runtime(.runtime-batch-start-index, 0, pending.length, i32-layout)
. setting = ir.reserve-block()
. passed = ir.reserve-block()
branch(compare(0, .compare-equal, first, integer(.machine-i32, function.place)), setting, passed)
ir.start-block(setting)
call-function(tables.probe-setup, 0)
jump(passed)
ir.start-block(passed)

────────────────────
_ do fork-batch
    - task FunctionId
    - main Bool = false

` Forks a task that runs a function of a batch, which is given nothing. The task is forked as
` native code forks one, so that a panic it reports names no task that spawned it; the `main` task
` of a case has the stack the first task of a program has.
ir.depend(.callee-function, task, 0)
. mark = pending.length
pending += make-operand(.operand-symbol, tables.functions[task].symbol)
pending += integer(.machine-u64, 0)
pending += integer(.machine-u64, tables.task-local-size as U64)
call-runtime
    - if main then .runtime-fork-main-task else .runtime-fork-plain-task
    - 0
    - mark
    - void-layout

────────────────────
_ do text-constant Operand
    - text String

` A literal of text, whose address is that of its bytes, which a zero byte follows.
= make-operand(.operand-constant, ir.add-string(text))

────────────────────
_ do keep-state
    - slot SlotId
    - value Operand
    - type TypeId
    - site SyntaxId

` Stores what a loop keeps from one pass to the next in a slot the binder declared for its
` header, which the type pass typed: in a cell made where the loop first stores it, or in
` the environment of a function that yields.
. offset = slot-offset(slot, site)
if slot == no-slot || facts.slot-type(unit.instance, offset) != type || type == no-type
    refuse(.refused-statement, site)
    =
. layout = layout-of(type, site)
if layout == void-layout
    =
if is-captured(slot)
    keep-captured(slot, value, type, site)
    =
if unit.cells[offset] == no-local
    unit.cells[offset] = ir.add-local(layout)
store-local(unit.cells[offset], value, site)

────────────────────
_ do state Typed
    - slot SlotId
    - site SyntaxId

` What a loop keeps in one of its slots, of the type the type pass gave the slot. One that
` holds nothing has no cell.
. nothing = make-operand(.operand-void, 0)
. offset = slot-offset(slot, site)
. type = facts.slot-type(unit.instance, offset)
if is-captured(slot)
    . held = read-captured(slot, site, type)
    = Typed(held.operand, type)
if unit.cells[offset] == no-local
    if layout-of(type, site) != void-layout
        refuse(.refused-expression, site)
    = Typed(nothing, type)
= Typed(load-local(unit.cells[offset], site), type)

────────────────────
_ do keep-given
    - declared SyntaxId

` What the function generated for a comprehension does with the container it is given,
` its one argument after the environment it was written in: it keeps it in the first slot
` of the loop, converted as the type pass recorded for the loop's container, where the
` body of the generator finds it, or, for a loop over the rows of a table, in the slot after
` its item, where the loop finds its rows when it begins. That of a stream piped through a
` pattern keeps the value piped so, but for a feed the pipe reads alone, which it is given
` nothing for.
if given-pipe != 0
    if tree.piped-feed(given-pipe) != 0
        if instances.signatures[unit.instance].args.count != 0
            refuse(.refused-function, declared)
        =
    . slot = loop-slots(given-pipe)
    if instances.signatures[unit.instance].args.count != 1 || ir.arguments.length != 2
        refuse(.refused-function, declared)
        =
    keep-state
        - slot
        - make-operand(.operand-argument, 1)
        - instances.argument-type(unit.instance, 0)
        - given-pipe
    =
match? tree.nodes[given-loop]
    | .node-loop-syntax(row)
        . slot = loop-slots(given-loop)
        if instances.signatures[unit.instance].args.count != 1 || ir.arguments.length != 2
            refuse(.refused-function, declared)
            =
        . held = convert(row.container, .reason-operand, Typed(make-operand(.operand-argument, 1), instances.argument-type(unit.instance, 0)))
        . kept = if facts.plan-of(unit.reading, given-loop) == .plan-table-loop then slot + loop-state-count else slot
        keep-state(kept, held.operand, held.type, given-loop)
        =
refuse(.refused-function, declared)

────────────────────
_ do built-value Typed
    - site SyntaxId
    - value Typed

. converted = value
if built-reason == .reason-element
    converted = convert-matched(site, .reason-explicit, converted, built-item)
= convert-matched(site, built-reason, converted, built-item)

────────────────────
_ do append-built
    - site SyntaxId
    - given-value Typed
    - optional Bool

. staying = no-block
. value = given-value
if optional && types.is-optional(value.type)
    . held = value.type
    . tested = present(site, value)
    . given-block = ir.reserve-block()
    staying = ir.reserve-block()
    branch(tested.operand, given-block, staying)
    ir.start-block(given-block)
    value = payload(site, Typed(value.operand, held))
value = built-value(site, value)
if value.type != built-item
    refuse(.refused-conversion, site)
    =
. mark = pending.length
pending += built-list
pending += value.operand
call-method(built-append, site, mark)
if staying != no-block
    jump(staying)
    ir.start-block(staying)

────────────────────
_ do turn-held Operand
    - local LocalId
    - place U32
    - site SyntaxId

` The environment of a turn of a loop being emitted: what the local for it holds, or in a
` function that yields what the field for it of the function's own environment holds.
if local != no-local
    = load-local(local, site)
. field = tables.layouts.field(tables.environments[unit.instance], place)
= load(load-local(unit.environment, site), field.offset, managed-layout, site)

────────────────────
_ is-turned Bool
    - slot SlotId

` Whether a slot is kept in the environment of a turn of a loop or of an activation.
tables.slot-homes[slot] != no-scope && tables.is-turn-scope(tables.slot-homes[slot])

────────────────────
_ do written-environment Operand
    - id SyntaxId

` The environment in force where a nested function is written, which its body reads the
` locals it captures from: that of the innermost turn being emitted, where an activation with
` none of its own has the one around it (`turn-link`), or else the function's own, or else the
` one the function was given, or nothing where it has none. A nested function written at the
` node is made here, so the lazy locals it reads that are held as eager locals are given their
` values first (`force-captured`).
force-captured(id)
. top = open-turns.length
if top != 0 && open-turns[top - 1].local == no-local && open-turns[top - 1].place == no-place
    = turn-link(open-turns[top - 1].scope, id)
if top != 0
    = turn-held(open-turns[top - 1].local, open-turns[top - 1].place, id)
= function-environment(id)

────────────────────
_ do function-environment Operand
    - id SyntaxId

` The environment of the function being emitted where a nested function is written outside any
` turn: its own, or else the one it was given, or nothing where it has none.
if unit.environment != no-local
    = load-local(unit.environment, id)
if unit.own-scope != no-scope && tables.environments[unit.instance] != no-layout
    refuse(.refused-expression, id)
if unit.received
    = given-environment(id)
= integer(.machine-managed-pointer, 0)

────────────────────
_ do call-protocol Typed
    - site SyntaxId
    - fact FactId
    - receiver Operand
    - type TypeId
    - argument Operand
    - given TypeId = no-type
    - watched Bool = true
    - second Operand? = null
    - second-given TypeId = no-type
    - third Operand? = null
    - third-given TypeId = no-type

` A call the type pass recorded at a loop for its container, at a pattern for its subject, or for a
` helper a pattern is given, which no call in the source writes: of a function declared for the
` container's type or for a class it is derived from, with the container as it is and up to three
` arguments, each of the type the function takes or of another that is held the same. A call that
` would convert any has no shape here. A function some class declares again is chosen by the class
` of the object, as a call written in source is. An error the function raises is a panic at the
` loop, with the error's text as its message, but where the type pass says the call's errors leave
` the function with it, as a loop's read of a generator that raises does. A loop's call is
` `watched`, checked for a panic even where no other call of the function is: the reference notices
` a panic raised under a loop's read as the loop ends. A function a property the container
` delegates to answers is called with what the property holds.
. nothing = make-operand(.operand-void, 0)
if fact == no-fact || facts.calls[fact].callee == no-instance || uncallable
    refuse(.refused-statement, site)
    = Typed(nothing, no-type)
.. uncallable = !is-callable(facts.calls[fact].callee)
. callee = facts.calls[fact].callee
. declared = instances.rows[callee].self-type
. signature = instances.signatures[callee]
. object = receiver
. holder = type
if facts.calls[fact].through.count != 0
    . reached = read-through(site, Typed(receiver, type), facts.calls[fact].through)
    object = reached.operand
    holder = reached.type
. derived = tables.is-class(holder) && tables.is-class(declared) && tables.derives(holder, declared)
. count U32 = if given == no-type then 0 else if second-given == no-type then 1 else if third-given == no-type then 2 else 3
if (declared != holder && !derived) || signature.args.count != count
    refuse(.refused-statement, site)
    = Typed(nothing, no-type)
if given != no-type && layout-of(instances.argument-type(callee, 0), site) != layout-of(given, site)
    refuse(.refused-statement, site)
if second-given != no-type && layout-of(second-type, site) != layout-of(second-given, site)
    refuse(.refused-statement, site)
.. second-type = instances.argument-type(callee, 1)
if third-given != no-type && layout-of(third-type, site) != layout-of(third-given, site)
    refuse(.refused-statement, site)
.. third-type = instances.argument-type(callee, 2)
. raising = signature.errors.count != 0
. mark = pending.length
pending += object
if given != no-type
    pending += argument
if second-given != no-type
    pending += second!
if third-given != no-type
    pending += third!
takes-result = raising
. answer = Typed(nothing, no-type)
. start ValueId = ir.instructions.length as ValueId
. called ValueId = U32.max
if tables.is-class(holder) && tables.is-overridden(callee)
    answer = call-method(callee, site, mark)
else
    answer = call-instance(callee, site, mark, false, watched)
    called = last-call(start)
if raising && facts.calls[fact].propagates
    answer = propagate(site, callee, answer.operand)
else if raising
    answer = panic-on-error(site, callee, answer.operand)
protocol-row = called
= answer

────────────────────
_ do last-call ValueId
    - start ValueId

. count = ir.instructions.length
for back in 0 .. < count - start
    . op = ir.instructions[count - 1 - back].op
    if op == .op-call || op == .op-call-void
        = (count - 1 - back) as ValueId
= U32.max

────────────────────
_ do proven-item U32
    - syntax SyntaxId

if proven-items.length == 0
    = U32.max
. binding = instances.rows[unit.reading].binding
if binding == no-binding || unit.reading != unit.instance
    = U32.max
match? tree.nodes[syntax]
    | .node-identifier
        . resolution = bindings.resolution-of(binding, syntax)
        if resolution.kind != .resolve-slot
            = U32.max
        . position = proven-items.length
        while position != 0
            position -= 1
            if proven-items[position].slot == resolution.slot
                = position as U32
= U32.max

────────────────────
_ do proven-loop U32
    - loop SyntaxId

. position = proven-tables.length
while position != 0
    position -= 1
    if proven-tables[position].loop == loop
        = position as U32
= U32.max

────────────────────
_ do proven-read U32
    - loop SyntaxId
    - column U32

for position in 0 .. < proven-reads.length
    . held = proven-reads[position]
    if held.loop == loop && held.column == column && held.block == ir.current
        = position as U32
= U32.max

────────────────────
_ do emit-leave
    - site SyntaxId
    - is-break Bool

` Leaves the innermost loop, or goes on to its next pass, after the cleanups opened in the
` loop run. What follows is never run. In a cleanup being run, only the holds on cancellation
` taken in the loop are let go (`leave-held`), and leaving anything else opened there has no
` shape.
if loops.length == 0
    refuse(.refused-statement, site)
    =
. loop = loops[loops.length - 1]
if scoping.cleaning && loop.cleanups != open-cleanups.length
    if !leave-held(loop.cleanups, site)
        refuse(.refused-statement, site)
        =
else
    run-cleanups(loop.cleanups, open-cleanups.length)
jump(if is-break then loop.done else loop.step)
ir.start-block(ir.reserve-block())

────────────────────
_ do open-polls

` The cells a function's loops poll with: the budget, which runs out on the first pass, and where
` the loops look in on the probes, the count down to the next look.
budget = ir.add-local(u64-layout)
store-local(budget, integer(.machine-u64, 1), 0)
if tables.probe-loops && !is-unprobed()
    probe-countdown = ir.add-local(u64-layout)
    store-local(probe-countdown, integer(.machine-u64, 0), 0)

────────────────────
_ do look-in-on-probes
    - syntax SyntaxId

` The look a loop's poll takes in on the probes, where the count down has run out: it is given its
` period again, and the probes flush what is due and answer the controller. A loop in a `do` block
` kept from looking in on them never does.
if probe-countdown == no-local || is-unprobed()
    =
. left = load-local(probe-countdown, syntax)
. looking = ir.reserve-block()
. looked = ir.reserve-block()
branch(left, looked, looking)
ir.start-block(looking)
store-local(probe-countdown, integer(.machine-u64, probe-look-period), syntax)
call-probe-thunk(tables.probe-safepoint, syntax)
jump(looked)
ir.start-block(looked)
. one = integer(.machine-u64, 1)
store-local
    - probe-countdown
    - arithmetic(syntax, .arithmetic-subtract, load-local(probe-countdown, syntax), one, u64-layout)
    - syntax

────────────────────
_ do call-probe-thunk
    - callee FunctionId
    - site SyntaxId

` A call of the function that flushes what a thread's probes wrote or of the one that looks in on
` them, where either is made. Neither returns a panic.
if callee == no-function
    =
ir.depend(.callee-function, callee, 0)
call
    - make-operand(.operand-symbol, tables.functions[callee].symbol)
    - site
    - pending.length
    - .callee-function
    - void-layout

────────────────────
_ is-unprobed Bool

` Whether the loops of the code emitted and the calls it makes that suspend the task never look in
` on the probes, by what its function declares or a `do` block around it is kept from.
(effects-here() /and/ CompilationEffect.no-probe-safepoint) != 0

────────────────────
_ effects-here U32

` What the code emitted may not do: what its function declares, and what the `do` blocks around
` it are kept from.
declared /or/ block-effects
.. declared = if unit.instance == no-instance then 0u32 else restrictions-of(dispatch-effects(instances.rows[unit.instance].effects))

────────────────────
_ do emit-poll
    - syntax SyntaxId

` The poll a loop makes on each pass. The budget counts the passes down. Where it runs out it is
` given a period again, the loop looks in on the probes (`look-in-on-probes`), and the task is
` looked at. When the collector or the scheduler has asked something of it, it leaves through the
` landing pad with the termination panic when it is being terminated in a function that
` `raises-termination`, and otherwise stops at the task's safepoint, or at the collector's in a
` function that may not suspend. A loop where no safepoint is allowed polls nothing. A loop in any
` other function the type pass did not mark as one that polls has no shape.
if is-unpolled() && unit.lender == no-instance
    =
if budget == no-local || unit.lender != no-instance
    refuse(.refused-statement, syntax)
    =
. one = integer(.machine-u64, 1)
. left = arithmetic(syntax, .arithmetic-subtract, load-local(budget, syntax), one, u64-layout)
store-local(budget, left, syntax)
. polling = ir.reserve-block()
. dispatch = ir.reserve-block()
. stop = ir.reserve-block()
. resume = ir.reserve-block()
branch(left, resume, polling)

ir.start-block(polling)
store-local(budget, integer(.machine-u64, poll-period), syntax)
look-in-on-probes(syntax)
. flags-address = make-operand(.operand-symbol, tables.runtime-symbol(.runtime-interrupt-flags))
. control-address = make-operand(.operand-symbol, tables.bundle.gc-public-control-word-symbol)
. flags = load(flags-address, 0, u8-layout, syntax)
. control = load(control-address, 0, u8-layout, syntax)
. asked = integer(.machine-u8, handshake-requested-control)
. collecting = bitwise(syntax, .bitwise-and, control, asked, u8-layout)
branch(bitwise(syntax, .bitwise-or, flags, collecting, u8-layout), dispatch, resume)

ir.start-block(dispatch)
if raises-termination()
    check-termination(load(flags-address, 0, u8-layout, syntax), syntax, stop)
else
    jump(stop)

ir.start-block(stop)
. suspends = (effects-here() /and/ CompilationEffect.no-suspend) == 0
call-runtime
    - if suspends then .runtime-task-safepoint else .runtime-safepoint
    - syntax
    - pending.length
jump(resume)
ir.start-block(resume)

────────────────────
_ do check-termination
    - flags Operand
    - syntax SyntaxId
    - resume IRBlockId

` Leaves through the landing pad with the termination panic when the interrupt flags say the
` task is being terminated, and goes on at `resume` when they do not.
. requested = bitwise
    - syntax
    - .bitwise-and
    - flags
    - integer(.machine-u8, terminate-interrupt)
    - u8-layout
. check = ir.reserve-block()
branch(requested, check, resume)
ir.start-block(check)
. raised = call-instance(instances.report.termination, syntax, pending.length)
poll-landings += 1
branch(raised.operand, landing-block(syntax), resume)

────────────────────
_ do test Typed
    - site SyntaxId
    - value Typed
    - is-operand Bool = false
    - is-right Bool = false

` Whether a value tests as true as a condition. One of a class or a text is asked whether it
` is empty, by the call the type pass recorded at the site as the test, and is true when it
` is not. Any other is tested by its layout. The value is the site's own, or with
` `is-operand` an operand of the site: the left one, or with `is-right` the right one.
. nothing = make-operand(.operand-void, 0)
. fact = truth-call(site, is-operand, is-right)
if fact == no-fact
    = truth(site, value)
. row = facts.calls[fact]
if row.is-partial
    refuse(.refused-expression, site)
    = Typed(nothing, no-type)
= ask-empty(site, value, row.callee)

────────────────────
_ do ask-empty Typed
    - site SyntaxId
    - value Typed
    - callee InstanceId

` Whether a value of a class or a text is not empty, by the function that says it is.
. nothing = make-operand(.operand-void, 0)
if callee == no-instance || !is-callable(callee)
    refuse(.refused-expression, site)
    = Typed(nothing, no-type)
if instances.signatures[callee].args.count != 0 || value.type != instances.rows[callee].self-type
    refuse(.refused-conversion, site)
    = Typed(nothing, no-type)
. mark = pending.length
pending += value.operand
. empty = call-method(callee, site, mark)
if empty.type != types.bool-type
    refuse(.refused-expression, site)
    = Typed(nothing, no-type)
= compare-zero(site, empty, .compare-equal)

────────────────────
_ do truth-call FactId
    - site SyntaxId
    - is-operand Bool
    - is-right Bool

` The call the type pass recorded at a site as the test of a value as a condition: of the
` site's own value, or of its left or right operand. No fact when the value has no such test.
. form = if is-operand then CallForm.call-operand-truth else CallForm.call-truth
. fact = facts.first-call(unit.reading, site)
while fact != no-fact
    . row = facts.calls[fact]
    if row.form == form && row.is-swapped == is-right
        = fact
    fact = row.next
= no-fact

────────────────────
_ is-function-call Bool
    - id SyntaxId

` Whether the call a node makes for its own value is of a function by its name: an operator
` that a function of its name answers, with both operands as its arguments.
fact != no-fact && facts.calls[fact].form == .call-function

.. fact = own-call(id)

────────────────────
_ own-call FactId
    - id SyntaxId

` The call a node makes for its own value, as the instance being read records it.
call-in(unit.reading, id)

────────────────────
_ do call-in FactId
    - owner InstanceId
    - id SyntaxId

` The call a node makes for its own value, as an instance records it: the one recorded at it
` that is not the test of a value as a condition. No fact when there is none, or more than one.
. found = no-fact
. fact = facts.first-call(owner, id)
while fact != no-fact
    . row = facts.calls[fact]
    if answers-node(row.form)
        if found != no-fact
            = no-fact
        found = fact
    fact = row.next
= found

────────────────────
_ do emit-print
    - id SyntaxId
    - body SyntaxId

` Prints a value as text, by the conversion the print records. The items of a tuple written
` are all evaluated first, and then made text one by one and joined as a tuple is. `--? value`
` prints only where the optional written holds a value.
. value = Typed(make-operand(.operand-void, 0), no-type)
. skipped = ir.reserve-block()
. is-written = false
match? tree.nodes[body]
    | .node-tuple-syntax
        is-written = true
if is-written
    . start = given.length
    gather-printed(body)
    print-fact = facts.first-conversion(unit.reading, id)
    print-next = start
    value = Typed(printed-text(id, body), types.string-type)
    drop-given(start)
else
    held-chain = body
    . emitted = emit-expression(body)
    held-chain = 0
    if tree.is-chained(body) && types.is-optional(emitted.type)
        . tested = present(body, emitted)
        . printing = ir.reserve-block()
        branch(tested.operand, printing, skipped)
        ir.start-block(printing)
    value = convert(id, .reason-print, emitted)
if value.type != types.string-type
    refuse(.refused-print-conversion, id)
    =
. mark = pending.length
pending += value.operand
call-runtime(.runtime-print, id, mark)
jump(skipped)
ir.start-block(skipped)

────────────────────
_ do gather-printed ?! Refused
    - body SyntaxId

` Evaluates the items of a tuple written to be printed, and those of the tuples written
` inside it, in order. A struct that an item names is copied, so no later item changes it.
match? tree.nodes[body]
    | .node-tuple-syntax(row)
        for item in tree.children[row.items]
            gather-printed(item)
        =
. value = emit-expression(body)
. layout = layout-of(value.type, body)
if tables.layouts.is-struct(layout) && !is-answer(value.operand)
    value = Typed(snapshot(value.operand, layout, body), value.type)
given += value

────────────────────
_ do printed-text Operand ?! Refused
    - id SyntaxId
    - body SyntaxId

` The text of what `gather-printed` evaluated. An item that is not text takes the next
` conversion the print records.
match? tree.nodes[body]
    | .node-tuple-syntax(row)
        . text = make-operand(.operand-constant, ir.add-string("("))
        . position U32
        for item in tree.children[row.items]
            . piece = printed-text(id, item)
            if position != 0
                text = concat(id, text, make-operand(.operand-constant, ir.add-string(", ")))
            text = concat(id, text, piece)
            position += 1
        = concat(id, text, make-operand(.operand-constant, ir.add-string(")")))
. value = given[print-next]
print-next += 1
if value.type == types.string-type
    = value.operand
while print-fact != no-fact && facts.conversions[print-fact].reason != .reason-print
    print-fact = facts.conversions[print-fact].next
if print-fact == no-fact
    refuse(.refused-print-conversion, id)
    = value.operand
. row = facts.conversions[print-fact]
print-fact = row.next
= convert-one(id, row, value).operand

────────────────────
_ compiles-probe Bool
    - id SyntaxId

program.compiles-probe(unit.source-module, probe-decl(), id)

────────────────────
_ probe-decl DeclId

` The function whose probes compile as its own (see `Program.compiles-probe`): that of the
` instance read, where it is written in the module whose syntax is emitted.
if unit.reading != no-instance && instances.rows[unit.reading].module == unit.source-module then instances.rows[unit.reading].decl else 0

────────────────────
_ do emit-probe-statement
    - id SyntaxId

` A probe that compiles: a log or an event (`emit-probe`), the assignment of a property, a counter,
` a group, the lazy locals a probe reads with it, which are evaluated where it reads them, or the
` statement a probe runs.
match? tree.nodes[id]
    | .node-probe(row)
        . skip = open-probe-gate(id)
        emit-probe(id, row)
        close-probe-gate(skip)
        =
    | .node-probe-assign(row)
        . skip = open-probe-gate(id)
        emit-probe-assign(id, row)
        close-probe-gate(skip)
        =
    | .node-probe-counter(row)
        . skip = open-probe-gate(id)
        emit-probe-counter(id, row)
        close-probe-gate(skip)
        =
    | .node-probe-group(row)
        emit-probe-group(id, row)
        =
    | .node-probe-scope(row)
        . mark = open-cleanups.length
        for statement in tree.children[row.body]
            emit-statement(statement)
        close-cleanups(mark)
        =
    | .node-probe-statement(row)
        emit-block(row.body)
        =
refuse(.refused-probe, id)

────────────────────
_ do open-probe-gate IRBlockId
    - site SyntaxId

. tracing = load
    - make-operand(.operand-symbol, tables.runtime-symbol(.runtime-probe-tracing))
    - 0
    - u8-layout
    - site
. records = ir.reserve-block()
. skip = ir.reserve-block()
branch(tracing, records, skip)
ir.start-block(records)
= skip

────────────────────
_ do close-probe-gate
    - skip IRBlockId

jump(skip)
ir.start-block(skip)

────────────────────
_ do emit-probe
    - id SyntaxId
    - row ASTProbe

` A log or an event whose probe compiles writes its record through the calls of the probes module
` the type pass recorded at it (`emit-probe-record`). The object it is written of, where it has one,
` and each value written in it are evaluated first, in order, then each value is cast, so that a
` probe a value runs writes its own record before this one starts, as the reference compiles them.
. number = tables.probe-number(unit.reading, id)
if number == 0
    refuse(.refused-probe, id)
    =
. made = probe-calls(id)
. logs = row.name == null
. start = given.length
. snapshots [Bool]
gather-probe-object(row.object)
. values = given.length
gather-probe-values(row.content, logs, snapshots)
cast-probe-values(row.content, logs, values)
. head = pending.length
pending += integer(.machine-u16, number)
push-probe-object(row.object, start)
emit-probe-record(id, made, 0, head, values, snapshots)
drop-given(start)

────────────────────
_ do emit-probe-counter
    - id SyntaxId
    - row ASTProbeCounter

` A counter adds to the count the probes module keeps under its number, of the object it is written
` of where it has one: by one, or by what it is given, converted as the type pass recorded. One
` that compiles only as a metric of the profile adds to the metric of its number instead.
. number = tables.probe-number(unit.reading, id)
. made = probe-calls(id)
if number == 0 || made.length != 1
    refuse(.refused-probe, id)
    =
. start = given.length
gather-probe-object(row.object)
. delta = integer(.machine-u64, 1)
if row.delta != 0
    . emitted = emit-expression(row.delta)
    delta = emitted.operand
    delta = convert(row.delta, .reason-argument, Typed(delta, emitted.type)).operand
. mark = pending.length
pending += integer(.machine-u16, number)
push-probe-object(row.object, start)
pending += delta
if facts.calls[made[0]].form == .call-probe-metric
    call-runtime(.runtime-profile-counter-add, id, mark)
else
    call-probe-function(facts.calls[made[0]].callee, id, mark)
drop-given(start)

────────────────────
_ do emit-probe-group
    - id SyntaxId
    - row ASTProbeGroup

` A group writes the record that opens it, with its values, and the one that closes it, each through
` the calls the type pass recorded at it, in order. One that begins and ends closes where the block
` it is written in is left, by any way out, as a cleanup (`emit-probe-group-end`), which has no shape
` where `do finally` has none. One written as a log that only ends writes its values in a log of
` their own before it closes. A group of data is of the object it is written of where it has one.
` One that compiles only as a timer of the profile begins or ends the timer of its number instead,
` and one that begins and ends ends it where the block is left.
. number = tables.probe-number(unit.reading, id)
if number == 0
    refuse(.refused-probe, id)
    =
. made = probe-calls(id)
if made.length != 0 && facts.calls[made[0]].form == .call-probe-metric
    . timing = open-probe-gate(id)
    time-profile
        - if row.is-begin then .runtime-profile-timer-begin else .runtime-profile-timer-end
        - number
        - id
    close-probe-gate(timing)
    if row.is-begin && row.is-end
        if scoping.cleaning || builds || initializes
            refuse(.refused-probe, id)
            =
        open-cleanup(id, UseCell(no-local, no-local, no-type))
    =
. logs = !row.is-data
. object = if row.is-data then row.object else 0
. skip = open-probe-gate(id)
. start = given.length
. snapshots [Bool]
gather-probe-object(object)
. values = given.length
gather-probe-values(row.content, logs, snapshots)
cast-probe-values(row.content, logs, values)
. head = pending.length
pending += integer(.machine-u16, number)
if row.is-begin || !logs
    if object != 0
        pending += integer(.machine-u8, 7)
    push-probe-object(object, start)
emit-probe-record(id, made, 0, head, values, snapshots)
drop-given(start)
close-probe-gate(skip)
if row.is-begin && row.is-end
    if scoping.cleaning || builds || initializes
        refuse(.refused-probe, id)
        =
    open-cleanup(id, UseCell(no-local, no-local, no-type))
else if logs && row.is-end
    emit-probe-group-end(id, 1)

────────────────────
_ do emit-probe-group-end
    - id SyntaxId
    - part U32

` The record that closes a group, which writes no values: the second a group that begins and ends
` writes, where the block it is written in is left, or the one after the log of a group that only
` ends. A timer of the profile that begins and ends ends there instead.
. made = probe-calls(id)
. skip = open-probe-gate(id)
if made.length != 0 && facts.calls[made[0]].form == .call-probe-metric
    time-profile(.runtime-profile-timer-end, tables.probe-number(unit.reading, id), id)
else
    . head = pending.length
    pending += integer(.machine-u16, tables.probe-number(unit.reading, id) + part)
    . snapshots [Bool]
    emit-probe-record(id, made, part, head, given.length, snapshots)
close-probe-gate(skip)

────────────────────
_ do emit-probe-record
    - id SyntaxId
    - made [FactId]
    - part U32
    - head Size
    - values Size
    - snapshots [Bool]

` Writes one record of a probe through the calls the type pass recorded for it, the `part`-th
` among those recorded at the probe: its head, given what is pending from `head`, then each value
` given from `values`, with the class of an object or an array and whether its snapshot is
` written, then the flush. Calls that do not fit the values have no shape.
. first = probe-part-start(made, part)
. count = given.length - values
. flush = first + count + 1
if flush >= made.length || facts.calls[made[flush]].form != .call-probe || headless
    refuse(.refused-probe, id)
    drop-pending(head)
    =
.. headless = flush + 1 < made.length && facts.calls[made[flush + 1]].form != .call-probe-head
call-probe-function(facts.calls[made[first]].callee, id, head)
for offset in 0 .. < count
    . callee = facts.calls[made[first + offset + 1]].callee
    . mark = pending.length
    pending += given[values + offset].operand
    if instances.signatures[callee].args.count == 3
        . snapshot = offset < snapshots.length && snapshots[offset]
        pending += integer(.machine-u16, tables.probe-class-id(given[values + offset].type))
        pending += integer(.machine-u8, if snapshot then 1 else 0)
    call-probe-function(callee, id, mark)
call-probe-function(facts.calls[made[flush]].callee, id, pending.length)

────────────────────
_ do time-profile
    - callee RuntimeFunction
    - number U32
    - site SyntaxId

` Begins or ends the timer of the profile of a number.
. mark = pending.length
pending += integer(.machine-u16, number)
call-runtime(callee, site, mark)

────────────────────
_ do count-event
    - count EventCount
    - site SyntaxId
    - amount U64 = 1

` Adds to a count the compiler keeps of what events do, where it compiles.
. number = tables.event-counts[count as Size]
if number == 0
    =
. mark = pending.length
pending += integer(.machine-u16, number)
pending += integer(.machine-u64, amount)
call-probe-function(instances.probe-runtime.counter-add, site, mark)

────────────────────
_ do probe-calls [FactId]
    - id SyntaxId

` The calls of the probes module the type pass recorded at a probe, in order, or the mark of one
` that compiles only as a metric of the profile.
. made [FactId]
. fact = facts.first-call(unit.reading, id)
while fact != no-fact
    . form = facts.calls[fact].form
    if form == .call-probe || form == .call-probe-head || form == .call-probe-metric
        made += fact
    fact = facts.calls[fact].next
= made

────────────────────
_ do probe-part-start Size
    - made [FactId]
    - part U32

` Where the calls of a record a probe writes start among those recorded at it: at the head of the
` `part`-th record.
. seen U32
for position in 0 .. < made.length
    if facts.calls[made[position]].form == .call-probe-head
        if seen == part
            = position
        seen += 1
= made.length

────────────────────
_ do gather-probe-object
    - object SyntaxId

` Evaluates the object a probe is written of, where it has one, into what is given.
if object == 0
    =
. emitted = emit-expression(object)
given += emitted

────────────────────
_ do push-probe-object
    - object SyntaxId
    - start Size

` Passes the object a probe is written of, given at `start`, where it has one, with the id of its
` class.
if object == 0
    =
pending += given[start].operand
pending += integer(.machine-u16, tables.probe-class-id(given[start].type))

────────────────────
_ do gather-probe-values
    - content RowRange'SyntaxId
    - logs Bool
    - snapshots [Bool]

` Evaluates each value written in a probe, in order, into what is given, noting which are
` snapshots. The texts written in a log are its template, and no values.
for item in tree.children[content]
    if logs && tree.nodes[item] is .node-string-syntax
        continue
    snapshots += tree.nodes[item] is .node-probe-snapshot
    . emitted = emit-expression(tree.probe-value(item))
    given += emitted

────────────────────
_ do cast-probe-values
    - content RowRange'SyntaxId
    - logs Bool
    - values Size

` Casts each value of a probe given from `values` as the type pass recorded: one written as its
` text is converted, and a preview written as the name of its type is that name.
. position = values
for item in tree.children[content]
    if logs && tree.nodes[item] is .node-string-syntax
        continue
    . value = tree.probe-value(item)
    . type = facts.node-type(unit.reading, value)
    if tree.nodes[item] is .node-probe-preview && probe-cast(types, type) == .probe-converted
        . preview = make-operand(.operand-constant, ir.add-string(probe-preview-text(types, type)))
        given[position] = Typed(preview, types.string-type)
    else
        . converted = convert(value, .reason-print, given[position])
        given[position] = converted
    position += 1

────────────────────
_ do emit-probe-setup

` The function the task main runs once the probes module has started, as the reference's
` `probesetup`: it opens the record of probes, makes room for the counters, numbered up to the last,
` and for the metrics of the profile, declares the key of each log and group and each class a value
` of a probe has, numbered after the probe data types, then each metric of the profile, then each
` probe the program compiles with the probe data type of each value it writes, and says the
` declarations are done.
. runtime = instances.probe-runtime
call-probe-function(runtime.begin, 0, pending.length)
. mark = pending.length
pending += integer(.machine-u64, tables.last-counter)
call-probe-function(runtime.counter-setup, 0, mark)
mark = pending.length
pending += integer(.machine-u64, tables.profile-metrics.length as U64)
call-probe-function(runtime.profile-setup, 0, mark)
for key in tables.probe-keys
    mark = pending.length
    pending += make-operand(.operand-constant, ir.add-string(key))
    call-probe-function(runtime.declare-key, 0, mark)
for position in 0 .. < tables.probe-classes.length
    mark = pending.length
    pending += integer(.machine-u16, (probe-data-type-count + position + 1) as U64)
    pending += make-operand(.operand-constant, ir.add-string(tables.probe-classes[position]))
    call-probe-function(runtime.declare-type, 0, mark)
for position in 0 .. < tables.profile-metrics.length
    declare-profile-metric(position, tables.profile-metrics[position])
for position in 0 .. < tables.probes.length
    declare-probe(position, tables.probes[position])
call-probe-function(runtime.ready, 0, pending.length)
return-nothing()

────────────────────
_ do emit-probe-teardown

` The function that closes the record of probes, as the reference's `probeteardown`: it counts what
` the collector did under the counters that compile for it, then closes the record.
. runtime = instances.probe-runtime
. counts = tables.collector-counts
if counts[0] != 0 || counts[1] != 0 || counts[2] != 0
    . mark = pending.length
    for count in counts
        pending += integer(.machine-u16, count)
    call-probe-function(runtime.collector-counts, 0, mark)
call-probe-function(runtime.end, 0, pending.length)
return-nothing()

────────────────────
_ do declare-probe
    - position Size
    - probe ProbeRow

` Declares a probe the program compiles by its number: a log with its key, its name, its template,
` which holds `%%` for each value, its module, file and line; an event with its key and name; or a
` counter with its key, module, file and line. A record of a group is named for whether it opens or
` closes it; one that closes it has no template. Then the probe data type of each value it writes,
` with its class.
. runtime = instances.probe-runtime
. number = integer(.machine-u16, (position + 1) as U64)
. count = integer(.machine-u32, probe.types.count)
. found = tables.probe-site(probe)
if !found
    refuse(.refused-probe, probe.syntax)
    =
. site = found
match site.kind
    |= .log
        declare-probe-log
            - number
            - site.key
            - site.name
            - site.template
            - site.module-name
            - site.path
            - site.line
            - count
    |= .event
        declare-probe-event(number, site.key, site.name, site.module-name, count)
    ??
        declare-probe-counter(number, site.key, site.module-name, site.path, site.line)
        =
for offset in 0 .. < probe.types.count
    . mark = pending.length
    pending += integer(.machine-u8, tables.probe-types[probe.types.start + offset])
    pending += integer(.machine-u16, tables.probe-type-classes[probe.types.start + offset])
    call-probe-function(runtime.declare-argument, 0, mark)

────────────────────
_ do declare-profile-metric
    - position Size
    - metric ProbeRow

` Declares a metric of the profile by its number: its key, whether it counts or times, its module,
` file and line, and no class.
. owner = program.modules[instances.rows[metric.instance].module]
. mark = pending.length
pending += integer(.machine-u16, (position + 1) as U64)
pending += make-operand
    - .operand-constant
    - ir.add-string(tables.metric-key(metric.instance, metric.syntax))
pending += integer(.machine-u8, metric.part)
pending += make-operand(.operand-constant, ir.add-string(owner.name))
pending += make-operand(.operand-constant, ir.add-string(owner.path))
pending += integer(.machine-u32, owner.tree.nodes.loc[metric.syntax].begin.line + 1)
pending += integer(.machine-u16, 0)
call-probe-function(instances.probe-runtime.declare-profile-metric, 0, mark)

────────────────────
_ do declare-probe-log
    - number Operand
    - key String
    - name String
    - template String
    - module-name String
    - path String
    - line U32
    - count Operand

. mark = pending.length
pending += number
pending += make-operand(.operand-constant, ir.add-string(key))
pending += make-operand(.operand-constant, ir.add-string(name))
pending += make-operand(.operand-constant, ir.add-string(template))
pending += make-operand(.operand-constant, ir.add-string(module-name))
pending += make-operand(.operand-constant, ir.add-string(path))
pending += integer(.machine-u32, line)
pending += count
call-probe-function(instances.probe-runtime.declare-log, 0, mark)

────────────────────
_ do declare-probe-event
    - number Operand
    - key String
    - name String
    - module-name String
    - count Operand

. mark = pending.length
pending += number
pending += make-operand(.operand-constant, ir.add-string(key))
pending += make-operand(.operand-constant, ir.add-string(name))
pending += make-operand(.operand-constant, ir.add-string(module-name))
pending += count
call-probe-function(instances.probe-runtime.declare-event, 0, mark)

────────────────────
_ do declare-probe-counter
    - number Operand
    - key String
    - module-name String
    - path String
    - line U32

. mark = pending.length
pending += number
pending += make-operand(.operand-constant, ir.add-string(key))
pending += make-operand(.operand-constant, ir.add-string(module-name))
pending += make-operand(.operand-constant, ir.add-string(path))
pending += integer(.machine-u32, line)
call-probe-function(instances.probe-runtime.declare-counter, 0, mark)

────────────────────
_ do call-probe-function
    - callee InstanceId
    - site SyntaxId
    - mark Size

` A call of a function of the probes module that compiled probes make, or the functions that
` declare, flush and close them: an error that leaves it is reported as one no caller handles,
` and what follows runs, as the reference hands it off.
if callee == no-instance
    refuse(.refused-probe, site)
    drop-pending(mark)
    =
. raising = instances.signatures[callee].errors.count != 0
takes-result = raising
. answer = call-instance(callee, site, mark)
takes-result = false
if raising
    do report-result(site, instances.signatures[callee].result, answer.operand, false, true)

────────────────────
_ do emit-raise
    - id SyntaxId
    - exception SyntaxId
    - condition SyntaxId

` Raises a panic no handler of the function takes. The panic is given the place it is raised
` at when it has no source of its own, then its stack trace, and becomes the task's active
` panic. The function leaves through its landing pad, and what follows is never run. Under a
` condition the panic is raised only where the condition tests as true, and what follows runs
` where it does not. A function the collector never sees leaves that zone before it makes
` the panic, once, and everything up to the landing pad is outside it.
. resumed = no-block
if condition != 0
    . tested = test(condition, emit-expression(condition))
    . raising = ir.reserve-block()
    resumed = ir.reserve-block()
    branch(tested.operand, raising, resumed)
    ir.start-block(raising)
raise-given(id, exception)
ir.start-block(if resumed == no-block then ir.reserve-block() else resumed)

────────────────────
_ do raise-given
    - id SyntaxId
    - exception SyntaxId
    - planned SyntaxId = 0

` Evaluates a panic or an error and raises it at a node, which ends the block. An error is
` one the type pass said leaves the function there, at the node or at `planned` for an arm
` of a match that raises. Any other value has no shape here.
. report = instances.report
. object = tables.layouts.objects[types.panic-type]
. is-ready = object != no-layout && report.source-slot != U32.max && report.trace-slot != U32.max
if !is-ready || tables.instance-functions[report.source] == no-function
    refuse(.refused-statement, id)
    =
if in-zone
    cross-zone(id, false)
    in-zone = false
. raised = emit-expression(exception)
if extends(raised.type, types.panic-type)
    raise(raised.operand, id)
else if extends(raised.type, types.error-type) && planned-raise
    leave-with(raised.operand, raised.type, id)
else
    refuse(.refused-statement, id)
.. planned-raise = facts.plan-of(unit.reading, if planned != 0 then planned else id) == .plan-raise
in-zone = is-free(unit.instance)

────────────────────
_ do leave-with
    - error Operand
    - type TypeId
    - id SyntaxId

` Leaves the function with an error in place of its value. The error is given the place of
` the node where it has no source of its own, then its stack trace. Where the type pass
` planned transformers for it there, each is tried in turn, and the first whose chain of
` earlier errors matches raises its exception in the error's place. An error raised in a
` cleanup leaves as TypeScript's does: in place of what was leaving, a value, another error or
` a panic, which stays set aside. One raised by a lazy local's value that a nested function
` evaluates leaves the nested function, whose writer lets it out with the call. One raised in
` a constructor run on an object made elsewhere, or in the zone the collector never looks in,
` which an error leaves before it is raised, has no shape here, and neither has one a lazy
` local's value raises toward transformers, nor one a transformer the type pass marked may take.
. report = instances.report
. object = tables.layouts.objects[types.panic-type]
. is-ready = object != no-layout && report.source-slot != U32.max && report.trace-slot != U32.max
if !is-ready || tables.instance-functions[report.source] == no-function
    refuse(.refused-statement, id)
    =
if initializes || in-zone || (builds && result-type == no-type)
    refuse(.refused-statement, id)
    =
. leave = facts.leave-of(unit.reading, id, type)
if unit.lender != no-instance && leave != no-fact
    refuse(.refused-statement, id)
    =
trace-error(error, id)
if leave == no-fact
    leave-as(error, type, id)
    =
. tried = facts.leaves[leave].tried
for offset in 0 .. < tried.count
    if facts.transform-unheld(facts.leave-tried[tried.start + offset])
        refuse(.refused-statement, id)
        =
for offset in 0 .. < tried.count
    . transform = facts.transforms[facts.leave-tried[tried.start + offset]]
    . missed = no-block
    if transform.chain.count != 0
        missed = ir.reserve-block()
    . named = bound.length
    transform-error(error, transform, missed)
    drop-bound(named)
    if missed == no-block
        =
    ir.start-block(missed)
leave-as(error, type, id)

────────────────────
_ do trace-error
    - error Operand
    - site SyntaxId

` Gives an error the place of a node where it has no source of its own, then its stack trace.
. object = tables.layouts.objects[types.panic-type]
. begin = tree.nodes[site].loc.begin
attach-source(error, begin.line + 1, begin.column + 1, site)
. trace = tables.layouts.field(object, object-header-fields + instances.report.trace-slot)
. mark = pending.length
pending += address(error, trace.offset, managed-layout, site)
call-runtime(.runtime-ensure-stack-trace, site, mark)

────────────────────
_ do transform-error
    - error Operand
    - transform TransformFact
    - missed IRBlockId

` Raises a transformer's exception in place of an error leaving the function. Where the
` error's chain of `previous` holds the errors the transformer names, class by class, the
` names its catcher declares are bound, and its exception is evaluated, given the
` transformer's place and a trace, given the error as its `previous`, and leaves the
` function. Where the chain does not match it goes on to `missed`.
match? tree.nodes[transform.catcher]
    | .node-catcher(row)
        bind-caught(row.type, Typed(error, transform.source))
        . current = error
        . position U32
        for pattern in tree.children[row.previous]
            if position == transform.chain.count
                break
            . link = facts.transform-chains[transform.chain.start + position]
            current = previous-of(current, link, missed, pattern)
            bind-caught(pattern, Typed(current, link))
            position += 1
        . raised = emit-expression(transform.exception)
        if raised.type != transform.raised || instances.report.previous-slot == U32.max
            refuse(.refused-statement, transform.site)
            =
        trace-error(raised.operand, transform.site)
        set-previous(raised.operand, error, transform.site)
        leave-as(raised.operand, transform.raised, transform.site)
        =
refuse(.refused-statement, transform.site)

────────────────────
_ do bind-caught
    - pattern SyntaxId
    - value Typed

` Binds the name a catcher's pattern declares, if any, to the error it names.
match? tree.nodes[pattern]
    | .node-type-capture(capture)
        bind-name(capture.id, value)

────────────────────
_ do previous-of Operand
    - error Operand
    - link TypeId
    - missed IRBlockId
    - site SyntaxId

` The error an error was raised in place of, where it is of a class: its `previous`, going
` on to `missed` where it holds none or one of another class.
. layouts = tables.layouts
. object = layouts.objects[types.panic-type]
if instances.report.previous-slot == U32.max || !tables.is-class(link)
    refuse(.refused-statement, site)
    = error
. field = layouts.field(object, object-header-fields + instances.report.previous-slot)
if layouts.is-struct(field.layout)
    refuse(.refused-statement, site)
    = error
. previous = load(error, field.offset, field.layout, site)
. present = ir.reserve-block()
branch
    - compare(site, .compare-not-equal, previous, integer(field.layout as MachineKind, 0))
    - present
    - missed
ir.start-block(present)
. matched = ir.reserve-block()
class-branch(site, previous, link, matched, missed)
ir.start-block(matched)
= previous

────────────────────
_ do set-previous
    - error Operand
    - previous Operand
    - site SyntaxId

` Gives an error raised in place of another that one as its `previous`.
. layouts = tables.layouts
. object = layouts.objects[types.panic-type]
. field = layouts.field(object, object-header-fields + instances.report.previous-slot)
if layouts.is-struct(field.layout)
    refuse(.refused-statement, site)
    =
store(error, field.offset, previous, true, site)

────────────────────
_ do leave-as
    - error Operand
    - type TypeId
    - id SyntaxId

` Leaves the function with an error that has its place and its trace. The cleanups open
` run, and the function returns the error as a case of what it returns. The main of a module
` has no caller to return it to, and reports it, as the body of a spawned task does, which
` then terminates as TypeScript's does, and so does the function that gives a module's
` globals their values: TypeScript runs nothing after it. The function that evaluates a lazy
` global reports it and returns, leaving the global being evaluated, as TypeScript leaves it
` where a program goes on after an unhandled error. What follows is never run. A
` constructor that raises leaves what it was making behind. A function the event runtime
` calls for a section of a class, and the function that fills an object with the markup of
` its class, the handler of a state machine's group of event transitions, the function that
` stops a machine as its object closes, and the function a
` live action runs a rule of a class, a live statement or the value of a property again with,
` give the error to the global `unhandled-error` and return nothing, as the reference's live
` action does with the error such a function gives it. An error of a class above every error
` the function raises leaves, once the cleanups open have run, as the case of the most derived
` class below it that it is of (`leave-narrowed`). An error a cleanup raises runs only the
` cleanups open around that one, after the holds on cancellation the cleanup took, and one
` raised in a stream loop of a cleanup has no shape.
. open = if scoping.cleaning then scoping.cleaning-open else open-cleanups.length
if scoping.cleaning && open-cleanups.length != scoping.cleaning-top
    if !leave-held(scoping.cleaning-top, id)
        refuse(.refused-statement, id)
        =
if fusing
    leave-fused(error, type, id, open as U32)
    =
. stops = function.kind == .task-body || function.kind == .module-globals
. reports = function.kind == .module-main || function.kind == .lazy-global || stops
. hands = function.kind == .event-handler || machine-hands || function.kind == .class-rule-updater || function.kind == .property-updater || function.kind == .style-author || function.kind == .style-given-author || fills-content || reruns-statement
    .. machine-hands = function.kind == .machine-handler || function.kind == .machine-stop
. index = if reports || hands then U32.max else error-case(type)
. casts = !reports && !hands && index == U32.max
if casts && (narrower-error-case(type, 0) == U32.max || !function.may-panic)
    refuse(.refused-statement, id)
    =
. around = landing
if open != 0
    run-cleanups(0, open)
    landing = pad-at(0)
abandon-lazy(id)
if reports
    report-error(error, id)
    if stops
        call-runtime(.runtime-terminate, 0, pending.length)
    return-nothing()
else if hands
    hand-off(error, type, id)
    return-nothing()
else if casts
    leave-narrowed(error, type, id)
else
    leave-case(index, error, id)
landing = around

────────────────────
_ do leave-case
    - index U32
    - error Operand
    - id SyntaxId

` Returns an error as a case of what the function returns, leaving a callback the runtime
` called, and keeping a step of a function that yields as the last.
if in-callback
    call-runtime(callback-exit(), 0, pending.length)
if stepping
    keep-step(finished-step, id)
return-case(index, error, id)

────────────────────
_ do leave-narrowed
    - error Operand
    - type TypeId
    - id SyntaxId

` Leaves with an error of a class above every error the function raises as the case of the
` most derived class below it that it is of, as the reference converts it: the cases of
` classes below it are tested in turn, those of the classes derived furthest first, so that
` one of a class derived from another's is tested before it. An error of none of them is a
` panic, as the cast to the class of the last tested is.
. deepest = 0u32
. last = U32.max
for index in 1 .. < tables.layouts.rows[ir.returns].cases.count
    . below = narrower-depth(index, type)
    if below > deepest
        deepest = below
. depth = deepest
while depth > 0
    . index = narrower-error-case(type, depth)
    while index != U32.max
        . held = tables.layouts.case-field(ir.returns, index).type
        . matched = ir.reserve-block()
        . missed = ir.reserve-block()
        class-branch(id, error, held, matched, missed)
        ir.start-block(matched)
        leave-case(index, error, id)
        ir.start-block(missed)
        last = index
        index = narrower-error-case(type, depth, index + 1)
    depth -= 1
if last == U32.max
    refuse(.refused-statement, id)
    =
. held = tables.layouts.case-field(ir.returns, last).type
raise-text(id, "Invalid cast to ${type-display(types, held)}")

────────────────────
_ do leave-fused
    - error Operand
    - type TypeId
    - id SyntaxId
    - open U32

. index = if reads-errors then error-case-of(fused-read, type) else U32.max
if scoping.cleaning || index == U32.max
    refuse(.refused-statement, id)
    =
. around = landing
if open != 0
    run-cleanups(0, open)
    landing = pad-at(0)
. start U32 = ir.operands.length
ir.add-operand(read-case(index, error, id))
append(.op-return, id, Span(start, 1), ReturnKind.return-error)
landing = around

────────────────────
_ get reads-errors Bool

tables.layouts.is-struct(fused-read) && tables.layouts.rows[fused-read].cases.count > 1

────────────────────
_ do read-case Operand
    - index U32
    - held Operand
    - syntax SyntaxId

. made = frame(fused-read)
zero(made, fused-read)
store(made, 0, integer(.machine-u8, index), false, syntax)
put(made, tables.layouts.case-field(fused-read, index), held, syntax)
= made

────────────────────
_ do narrower-error-case U32
    - type TypeId
    - depth U32
    - from U32 = 1

` The first case of what the function returns, from a number on, that holds an error of a
` class below a class, as many classes below it as `depth` says, or with no depth at any, or
` none.
if result-type == no-type
    = U32.max
for index in from .. < tables.layouts.rows[ir.returns].cases.count
    . below = narrower-depth(index, type)
    if below != 0 && (depth == 0 || below == depth)
        = index
= U32.max

────────────────────
_ do narrower-depth U32
    - index U32
    - type TypeId

` How many classes below a class is the class of the error a case of what the function
` returns holds, or none where it is not below it.
. depth = 0u32
. current = tables.layouts.case-field(ir.returns, index).type
while current != no-type && current != invalid-type && current != type
    current = types.completions[current].base
    depth += 1
= if current == type then depth else 0

────────────────────
_ do hand-off
    - error Operand
    - type TypeId
    - id SyntaxId

` Gives an error to the global `unhandled-error` of core, as the reference hands off one that
` leaves a function it calls for a section of a class, or one that fills an object with the
` markup of its class: the global is read, evaluated first
` where it has no value yet, and the function it holds is called with the error as an
` `Error`, which it is held as already, and checked for a panic as the call of any function
` value is.
. global = facts.unhandled-error
. derived = tables.is-class(type) && is-error
    .. is-error = type == types.error-type || tables.derives(type, types.error-type)
if !global || !derived || in-zone || (!function.may-panic && !in-landing)
    refuse(.refused-statement, id)
    =
. held = read-global(id, global.module, global.decl)
. layout = layout-of(held.type, id)
if layout != tables.layouts.function-layout
    refuse(.refused-statement, id)
    =
. code = load(held.operand, 0, pointer-layout, id)
. data = load(held.operand, tables.layouts.field(layout, 1).offset, managed-layout, id)
. mark = pending.length
pending += data
pending += error
do call(code, id, mark, .callee-value, void-layout, !in-landing)

────────────────────
_ error-case U32
    - type TypeId

` Which case of what the function returns holds an error of a class: the case of that
` class, or of the nearest class above it that has one. The type pass settles the errors of a
` function after it has typed the body, so no node of the body records the case.
if result-type == no-type then U32.max else error-case-of(ir.returns, type)

────────────────────
_ do error-case-of U32
    - layout LayoutId
    - type TypeId

` Which case of a value that may be an error holds an error of a class: the case of that
` class, or of the nearest class above it that has one.
. current = type
while current != no-type && current != invalid-type
    for index in 1 .. < tables.layouts.rows[layout].cases.count
        if tables.layouts.case-field(layout, index).type == current
            = index
    current = types.completions[current].base
= U32.max

────────────────────
_ do propagate Typed
    - id SyntaxId
    - callee InstanceId
    - result Operand

` The value of a call whose errors leave the function with it. What the callee returned
` holds its value or one of its errors. An error leaves the function as one raised at the
` call would, and what follows runs with the value.
= propagate-held(id, instances.signatures[callee].result, result)

────────────────────
_ do propagate-held Typed
    - id SyntaxId
    - held TypeId
    - result Operand

` The value of what a call answered with, of a type that holds a value or one of several
` errors, where the errors leave the function with the call. An error that came back outside
` the zone the collector never sees leaves from there.
. nothing = make-operand(.operand-void, 0)
. answer = take-zone-answer()
. layout = layout-of(held, id)
if !tables.layouts.is-union(layout)
    refuse(.refused-expression, id)
    = Typed(nothing, no-type)
. count = tables.layouts.rows[layout].cases.count
. given = ir.reserve-block()
. raised = ir.reserve-block()
. zoned = in-zone
branch(case-test(id, result, 0), given, raised)
ir.start-block(raised)
if closes-zone(answer)
    close-zone(id)
if answer != 0
    in-zone = false
for index in 1 .. < count
    . field = tables.layouts.case-field(layout, index)
    . next = no-block
    if index + 1 != count
        . held = ir.reserve-block()
        next = ir.reserve-block()
        branch(case-test(id, result, index), held, next)
        ir.start-block(held)
    leave-with(take(result, field, id), field.type, id)
    if next != no-block
        ir.start-block(next)
in-zone = zoned
ir.start-block(given)
settle-zone-answer(id, answer)
. field = tables.layouts.case-field(layout, 0)
= Typed(take(result, field, id), field.type)

────────────────────
_ do report-result Operand
    - id SyntaxId
    - type TypeId
    - result Operand
    - hands Bool = false
    - prints Bool = false

` The value of a call that returned a `type` that holds its value or one of its errors, whose
` error the reference reports, as one no caller handles, or with `hands` gives to the global
` `unhandled-error` (`hand-off`), and then goes on. One reported that `prints` goes on too.
. nothing = make-operand(.operand-void, 0)
. layout = layout-of(type, id)
if !tables.layouts.is-union(layout)
    refuse(.refused-expression, id)
    = nothing
. count = tables.layouts.rows[layout].cases.count
. joined = ir.reserve-block()
. raised = ir.reserve-block()
branch(case-test(id, result, 0), joined, raised)
ir.start-block(raised)
for index in 1 .. < count
    . field = tables.layouts.case-field(layout, index)
    . next = joined
    if index + 1 != count
        . held = ir.reserve-block()
        next = ir.reserve-block()
        branch(case-test(id, result, index), held, next)
        ir.start-block(held)
    if hands
        hand-off(take(result, field, id), field.type, id)
    else
        report-error(take(result, field, id), id, prints)
    jump(joined)
    if next != joined
        ir.start-block(next)
ir.start-block(joined)
= nothing

────────────────────
_ do raise
    - panic Operand
    - id SyntaxId

` Makes a panic the task's active one, by the function each place that raises one calls
` (`emit-raise-panic`), and leaves through the landing pad. A function the collector never sees
` leaves that zone for the call.
. crosses = in-zone
if crosses
    cross-zone(id, false)
call-raiser(tables.panic-raiser, panic, id)
if crosses
    cross-zone(id, true)
jump(landing-block(0))

────────────────────
_ do call-raiser
    - raiser FunctionId
    - value Operand
    - id SyntaxId

` Calls a function that raises a panic, given the panic or its message, the path of the module,
` and the line and the column of the node it is raised at. One raised at no node, in a function
` the compiler makes, is given no place.
?! Panic("A panic is raised where no function raises it")
    if raiser == no-function
. path = program.modules[unit.source-module].relative-path
. line U64 = 0
. column U64 = 0
if id != 0
    . begin = tree.nodes[id].loc.begin
    line = begin.line + 1
    column = begin.column + 1
. mark = pending.length
pending += value
pending += make-operand(.operand-constant, ir.add-string(if path.length != 0 then path else "no file"))
pending += integer(.machine-u64, line)
pending += integer(.machine-u64, column)
ir.depend(.callee-function, raiser, 0)
call(make-operand(.operand-symbol, tables.functions[raiser].symbol), id, mark, .callee-function, void-layout)

────────────────────
_ do raise-text
    - id SyntaxId
    - text String

` Raises a panic the compiler writes, with its message, at a node.
raise-message(id, make-operand(.operand-constant, ir.add-string(text)))

────────────────────
_ do raise-union-error
    - id SyntaxId

` Raises what a union that holds another case than the one asked for raises: its error is
` constructed and made text, and a panic is raised with that text as its message.
. report = instances.report
. made = report.union-error
. text = report.union-text
if made == no-instance || text == no-instance
    refuse(.refused-conversion, id)
    =
if tables.instance-functions[made] == no-function || tables.instance-functions[text] == no-function
    refuse(.refused-conversion, id)
    =
. was-free = in-zone
if in-zone
    cross-zone(id, false)
    in-zone = false
. mark = pending.length
for position in 0 .. < instances.signatures[made].args.count
    pending += absent-argument(id, instances.argument-type(made, position)).operand
pending += call-instance(made, id, mark).operand
. message = call-method(text, id, mark)
raise-message(id, message.operand)
in-zone = was-free

────────────────────
_ do raise-message
    - id SyntaxId
    - message Operand

` Raises a panic with a message, at a node, by the function each place that raises one calls
` (`emit-raise-message`). Nothing after it in its block is run. A function the collector never
` sees leaves that zone to make the panic.
. was-free = in-zone
if tables.message-raiser == no-function
    . panic = compiler-panic(id, message)
    =? if panic == make-operand(.operand-void, 0)
    raise(panic, id)
    in-zone = was-free
    =
if in-zone
    cross-zone(id, false)
    in-zone = false
call-raiser(tables.message-raiser, message, id)
jump(landing-block(0))
in-zone = was-free

────────────────────
_ do extends Bool
    - type TypeId
    - base TypeId

` Whether a class is another or is derived from it.
. current = type
while current != no-type && current != invalid-type
    if current == base
        = true
    current = types.completions[current].base
= false

────────────────────
_ do attach-source
    - panic Operand
    - line U64
    - column U64
    - syntax SyntaxId

` Gives a panic that has no source the place it is at: the module's path, a line and a
` column, by the function the tables declared for it (`emit-source-attach`). A function the
` collector never sees leaves that zone for the call.
. helper = tables.source-attacher
?! Panic("A panic is raised where no function gives it its source")
    if helper == no-function
. path = program.modules[unit.source-module].relative-path
. mark = pending.length
pending += panic
pending += make-operand
    - .operand-constant
    - ir.add-string(if path.length != 0 then path else "no file")
pending += integer(.machine-u64, line)
pending += integer(.machine-u64, column)
ir.depend(.callee-function, helper, 0)
. crosses = in-zone
if crosses
    cross-zone(syntax, false)
call
    - make-operand(.operand-symbol, tables.functions[helper].symbol)
    - syntax
    - mark
    - .callee-function
    - void-layout
if crosses
    cross-zone(syntax, true)

────────────────────
_ do emit-raise-message

` The function each place that raises a panic the compiler writes calls, given its message, the
` path of the module, a line and a column. It makes the panic (`compiler-panic`) and raises it
` there (`raise-at`).
add-raiser-arguments()
. panic = compiler-panic(0, make-operand(.operand-argument, 0))
if panic == make-operand(.operand-void, 0)
    return-nothing()
    =
raise-at(panic)

────────────────────
_ do add-raiser-arguments

ir.add-argument(managed-layout)
ir.add-argument(managed-layout)
ir.add-argument(u64-layout)
ir.add-argument(u64-layout)

────────────────────
_ do raise-at
    - panic Operand

` Makes a panic the task's active one where a function that raises one was called with a path, a
` line and a column. A panic with no source of its own is given that place where the line is not
` 0 (`emit-source-attach`). Its stack trace starts at the caller, as the runtime takes it
` (`brixRaisePanic`).
. line = make-operand(.operand-argument, 2)
. attach = ir.reserve-block()
. raising = ir.reserve-block()
branch(line, attach, raising)
ir.start-block(attach)
. helper = tables.source-attacher
. given = pending.length
pending += panic
pending += make-operand(.operand-argument, 1)
pending += line
pending += make-operand(.operand-argument, 3)
ir.depend(.callee-function, helper, 0)
call(make-operand(.operand-symbol, tables.functions[helper].symbol), 0, given, .callee-function, void-layout)
jump(raising)
ir.start-block(raising)
. report = instances.report
. object = tables.layouts.objects[types.panic-type]
. trace = tables.layouts.field(object, object-header-fields + report.trace-slot)
. mark = pending.length
pending += panic
pending += address(panic, trace.offset, managed-layout, 0)
call-runtime(.runtime-raise-panic, 0, mark)
return-nothing()

────────────────────
_ do emit-source-attach

` The function that gives a panic that has no source the place it is raised at, given the
` panic, the path of the module, a line and a column, which each place that raises one calls
` (`attach-source`).
ir.add-argument(managed-layout)
ir.add-argument(managed-layout)
ir.add-argument(u64-layout)
ir.add-argument(u64-layout)
. panic = make-operand(.operand-argument, 0)
. report = instances.report
. layouts = tables.layouts
. object = layouts.objects[types.panic-type]
. field = layouts.field(object, object-header-fields + report.source-slot)
?! Panic("The source of a panic is not an optional struct")
    if !layouts.is-struct(field.layout)
. inner = layouts.field(field.layout, 0)
. flag = layouts.field(field.layout, 1)
. source = address(panic, field.offset, field.layout, 0)
. attach = ir.reserve-block()
. attached = ir.reserve-block()
. given = pending.length
pending += make-operand(.operand-argument, 1)
pending += make-operand(.operand-argument, 2)
pending += make-operand(.operand-argument, 3)
. made = call-instance(report.source, 0, given)
branch(load(source, flag.offset, flag.layout, 0), attached, attach)
ir.start-block(attach)
. wrapped = frame(field.layout)
zero(wrapped, field.layout)
copy(address(wrapped, inner.offset, inner.layout, 0), made.operand, inner.layout, false, 0)
store(wrapped, flag.offset, integer(.machine-i8, 1), false, 0)
copy(source, wrapped, field.layout, true, 0)
jump(attached)
ir.start-block(attached)
return-nothing()

────────────────────
_ do emit-body

` The body of an instance: one the compiler generates, or one written in source. That of a
` function of an interface run for a value of a type that is none is given its receiver as
` the interface, as the type pass typed it. The function generated for a comprehension is
` a nested function whose body is the comprehension's loop; the one for a list of feeds
` yields what the feeds give; and the one for the right side of a pipe gives the value
` written there, or runs it for nothing where the pipe only taps. A function written
` with no body gives what the type it returns makes with nothing written. A class's `close`
` closes the live actions the object owns where its body ends; one that returns early, or is
` written as a value, has no shape where the program makes live actions. The function that
` runs a live statement again is given the environment it was written in, as a closure is.
` A method that yields and is typed again for a class's table with the errors a base's
` generator carries has no shape where it is called as first typed too: the reference's method
` carries the errors of whichever it compiles first. A door a fake answers under a `do with`
` calls the fake's method (`emit-forwarder`).
. row = instances.rows[unit.instance]
for forward in facts.swap-forwards
    if forward.instance == unit.instance
        emit-forwarder(forward)
        =
. body SyntaxId = 0
. declared SyntaxId = 0
. unwritten SyntaxId = 0
. owned = false
. imperative = false
. fills = false
. rerun = false
. retest = false
. tests-gate = false
. reselects = false
. selects = false
. builds-arm = false
. sources = false
. builds-row = false
. builds-slot = false
. binds = false
. wraps = false
. starts = false
match? program.modules[row.module].decls[row.decl]
    | .decl-function(fn)
        declared = fn.syntax
        if row.retyped != no-instance && tables.instance-functions[row.retyped] != no-function
            refuse(.refused-function, declared)
            =
        if row.gives-unwritten
            unwritten = fn.return-type
        if fn.kind == .termination-panic-decl
            emit-termination-check()
            =
        if fn.is-generated && fn.kind == .default-constructor-decl
            emit-default-constructor(declared)
            =
        if fn.is-generated && fn.kind == .tuple-constructor-decl
            emit-tuple-constructor(declared)
            =
        if fn.is-generated && fn.kind == .cast-constructor-decl
            emit-cast-constructor(declared)
            =
        if fn.is-generated && is-table-constructor-kind(fn.kind)
            emit-table-constructor(class-site(row.module, fn.owner), fn.kind)
            =
        if !fn.is-generated && fn.kind == .constructor-decl
            if rule-match(program, row.module, row.decl) != 0
                emit-rule(declared, fn.body)
                =
            if function.kind == .instance-initializer
                emit-initializer(declared, fn.body)
            else
                emit-constructor(declared, fn.body)
            =
        owned = fn.owner != 0 && !fn.is-static
        . is-written = function-or-getter || fn.kind == .setter-decl
            .. function-or-getter = fn.kind == .function-decl || fn.kind == .getter-decl
        if fn.kind == .closure-decl
            owned = false
            unit = unit.received = true
            is-written = true
        if fn.kind == .subscriber-decl
            owned = false
            unit = unit.received = true
            body = fn.syntax
            imperative = true
            subscribing = fn.syntax
        if fn.kind == .iterator-decl
            owned = false
            unit = unit.received = true
            match? tree.nodes[fn.syntax]
                | .node-iterator-expression(syntax)
                    if syntax.next == 0 && takes-item(syntax.loop)
                        body = fn.syntax
                        imperative = true
                        given-loop = syntax.loop
                | .node-pipeline-expression
                    body = fn.syntax
                    imperative = true
                    given-pipe = fn.syntax
                | .node-binary-expression
                    body = fn.syntax
                    imperative = true
                    given-pipe = fn.syntax
        if fn.kind == .feed-decl
            owned = false
            unit = unit.received = true
            body = fn.syntax
            imperative = true
            feeds = fn.syntax
        if fn.kind == .live-decl
            owned = false
            unit = unit.received = true
            body = fn.syntax
            imperative = true
            rerun = true
        if fn.kind == .whenever-decl
            owned = false
            unit = unit.received = true
            body = fn.syntax
            imperative = true
            retest = true
        if fn.kind == .gate-decl
            owned = false
            unit = unit.received = true
            body = fn.syntax
            tests-gate = true
        if fn.kind == .branch-decl
            owned = false
            unit = unit.received = true
            body = fn.syntax
            imperative = true
            reselects = true
        if fn.kind == .selector-decl
            owned = false
            unit = unit.received = true
            body = fn.syntax
            selects = true
        if fn.kind == .branch-arm-decl
            owned = false
            unit = unit.received = true
            body = fn.syntax
            imperative = true
            builds-arm = true
        if fn.kind == .row-decl
            owned = false
            unit = unit.received = true
            body = fn.syntax
            builds-row = true
        if fn.kind == .slot-decl
            owned = false
            unit = unit.received = true
            body = fn.syntax
            wraps = tree.nodes[fn.syntax] is .node-block
            builds-slot = !wraps
        if fn.kind == .binder-decl
            owned = false
            unit = unit.received = true
            body = fn.syntax
            binds = true
        if fn.kind == .source-decl
            owned = false
            unit = unit.received = true
            body = fn.syntax
            imperative = true
            sources = true
        if fn.kind == .key-decl
            owned = false
            unit = unit.received = true
            body = fn.body
        if fn.kind == .machine-decl
            owned = false
            unit = unit.received = true
            body = fn.syntax
            starts = true
        if fn.kind == .pipeline-decl
            owned = false
            unit = unit.received = true
            match? tree.nodes[fn.syntax]
                | .node-pipeline-expression(syntax)
                    body = syntax.right
                    piped = fn.syntax
                | .node-binary-expression(syntax)
                    body = syntax.rhs
                    piped = fn.syntax
            imperative = instances.signatures[unit.instance].returns == types.void-type
        if !fn.is-generated && is-written
            match? tree.nodes[fn.syntax]
                | .node-function-syntax(syntax)
                    body = syntax.body
                    imperative = syntax.imperative
        if fn.is-content
            fills = true
            body = fn.body
            imperative = true
            if declared == 0
                declared = class-site(row.module, fn.owner)
    | .decl-converter(converter)
        declared = converter.syntax
        owned = true
        match? tree.nodes[converter.syntax]
            | .node-converter-syntax(syntax)
                body = syntax.body
                imperative = syntax.imperative
    | .decl-fromverter(fromverter)
        declared = fromverter.syntax
        match? tree.nodes[fromverter.syntax]
            | .node-fromverter-syntax(syntax)
                body = syntax.body
                imperative = syntax.imperative
if rule-match(program, row.module, row.decl) != 0
    emit-rule(declared, body)
    =
if body == 0 && !fills && (unwritten == 0 || stepping || returns-void)
    refuse(.refused-function, declared)
    =
.. returns-void = instances.signatures[unit.instance].returns == types.void-type
. signature = instances.signatures[unit.instance]
if stepping
    emit-steps(declared, body, imperative && signature.errors.count == 0)
    =
unit = unit.takes-self = owned
unit = unit.has-self = owned
. adapted = instances.rows[unit.instance].row-receiver
if unit.takes-self
    unit = unit.self = make-operand(.operand-argument, 0)
    if function.kind == .viewed-body
        unit = unit.owner-type = tables.receiver-view(unit.instance)
    if adapted != no-type
