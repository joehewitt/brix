            refuse(.refused-function, declared)
            =
        this-cursor = case-cursors.length as U32
        bound += BoundValue(slot, case-type, unit.self, this-cursor)
        case-cursors += CaseCursor
            - unit.self
            - held.row-receiver
            - union
            - held.row-case
            - held.row-validated
            - columns
            - index.operand
