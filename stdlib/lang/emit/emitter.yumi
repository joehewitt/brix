. union = tables.unions.of(table-row-type(held.row-receiver))
. layout = layout-of(held.row-receiver, declared)
. signature = instances.signatures[unit.instance]
if union == U32.max || unbridged || unit.received || signature.errors.count != 0
    refuse(.refused-function, declared)
    =
.. unbridged = held.row-case == U32.max || held.materialized == no-instance
. columns = make-operand(.operand-argument, columns-at)
. index = part(unit.self, layout, 1, declared)
. gathered = gather-union-case(declared, union, held.row-case, columns, index.operand)
