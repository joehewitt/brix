if layout != tables.layouts.function-layout
    refuse(.refused-statement, declared)
    =
. source = make-operand(.operand-argument, if unit.takes-self then position + 1 else position)
. code = load(source, 0, pointer-layout, declared)
. data = load(source, tables.layouts.field(layout, 1).offset, managed-layout, declared)
. mark = pending.length
pending += data
pending += made
call(code, declared, mark, .callee-value, void-layout)

────────────────────
_ do emit-deferred
    - type TypeId
    - declared SyntaxId

` Gives the properties a constructor put off their first values, once the markup of the
` class has run, in the order the type pass placed them. Each value reads the object as it
