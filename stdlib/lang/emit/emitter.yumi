. none = make-operand(.operand-void, 0)
. columns = if held.row-validated then make-operand(.operand-argument, columns-at) else none
. index = part(unit.self, layout, 1, declared)
. case-type = tables.unions.cases[tables.unions.layouts[union].cases.start + held.row-case].type
